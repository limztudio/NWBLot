// Stable keys of widget parts; builder, paint, and input code must derive the same ids.
const StringView s_WidgetPartPopup = "popup";
const StringView s_WidgetPartRows = "rows";
const StringView s_WidgetPartQuery = "query";
const StringView s_WidgetPartChoices = "choices";
const StringView s_WidgetPartScrollbar = "scrollbar";
const StringView s_WidgetPartTrack = "track";
const StringView s_WidgetPartThumb = "thumb";
const StringView s_WidgetPartScrollHorizontalThumb = "scroll.x.thumb";
const StringView s_WidgetPartScrollVerticalThumb = "scroll.y.thumb";
const StringView s_WidgetPartScrollHorizontalBefore = "scroll.x.before";
const StringView s_WidgetPartScrollVerticalBefore = "scroll.y.before";
const StringView s_WidgetPartScrollHorizontalAfter = "scroll.x.after";
const StringView s_WidgetPartScrollVerticalAfter = "scroll.y.after";
const StringView s_WidgetPartScrollCorner = "scroll.corner";
const StringView s_WindowChromeTitleKey = "@window.title";
const StringView s_WindowChromeCollapseKey = "@window.collapse";
const StringView s_WindowChromeResizeKey = "@window.resize";
const u64 s_WidgetMaxStates = 4096u;
const usize s_WidgetStateRetainedCapacity = 8192u;
const usize s_WidgetFrameReserve = 16u;
const usize s_ContextMaxScopeDepth = 64u;
const usize s_SmallStateClaims = 32u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> WidgetKind{
    Panel,
    Container,
    Label,
    Button,
    Checkbox,
    Window,
    Separator,
    EditBox,
    Popup,
    Selectable,
    VirtualList,
    ComboBox,
    SearchComboBox,
    Tooltip,
    ContextMenu,
    TextArea,
    RadioGroup,
    Slider,
    Progress,
    Image,
}

class WidgetId{
    public b8 operator==(in WidgetId rhs)const{
        return this.value == rhs.value;
    }

    public b8 operator!=(in WidgetId rhs)const{
        return this.value != rhs.value;
    }

    public b8 valid()const{
        return this.value != 0u;
    }

    public u64 value = 0u;
}

// Root identity comes from the host; include its lifetime generation rather than iteration order or an address.
class WidgetRoot{
    public b8 operator==(in WidgetRoot rhs)const{
        return this.value == rhs.value && this.generation == rhs.generation;
    }

    public b8 operator!=(in WidgetRoot rhs)const{
        return this.value != rhs.value || this.generation != rhs.generation;
    }

    public usize hash()const{
        return hashCombineValue(hashValue(this.value), this.generation);
    }

    public u64 value = 0u;
    public u64 generation = 1u;
}

class WidgetState{
    public WidgetState(){
        this.id = WidgetId();
        this.root = WidgetRoot();
        this.declarationGeneration = 0u;
        this.lastSeenFrame = 0u;
        this.kind = WidgetKind::Panel;
    }

    public WidgetState(in WidgetId id, in WidgetRoot root, in u64 declarationGeneration, in u64 lastSeenFrame, in WidgetKind kind){
        this.id = id;
        this.root = root;
        this.declarationGeneration = declarationGeneration;
        this.lastSeenFrame = lastSeenFrame;
        this.kind = kind;
    }

    public WidgetId id;
    public WidgetRoot root;
    public u64 declarationGeneration;
    public u64 lastSeenFrame;
    public WidgetKind kind;
}

class ContextStateClaim{
    public b8 operator==(in ContextStateClaim rhs)const{
        return this.instanceGeneration == rhs.instanceGeneration && this.kind == rhs.kind;
    }

    public b8 operator!=(in ContextStateClaim rhs)const{
        return this.instanceGeneration != rhs.instanceGeneration || this.kind != rhs.kind;
    }

    public usize hash()const{
        return hashCombineValue(hashValue(this.instanceGeneration), cast<u8>(this.kind));
    }

    public u64 instanceGeneration = 0u;
    public WidgetKind kind = WidgetKind::Panel;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


usize ContextStateClaimHash(in ContextStateClaim claim){
    const usize seed = hashValue(claim.instanceGeneration);
    return hashCombineValue(seed, cast<u8>(claim.kind));
}

Expected<WidgetId> TryMakeRootId(in WidgetRoot root){
    if(root.generation == 0u)
        return makeUnexpected(Failure());
    u64 hash = updateFnv64U64(s_Fnv64OffsetBasis, root.value);
    hash = updateFnv64U64(hash, root.generation);
    WidgetId outId;
    if(hash == 0u)
        outId.value = 1u;
    else
        outId.value = hash;
    return outId;
}

Expected<WidgetId> TryMakeWidgetPartId(in WidgetId parent, in u64 stableKey){
    if(!parent.valid() || stableKey == 0u)
        return makeUnexpected(Failure());
    u64 hash = updateFnv64U64(s_Fnv64OffsetBasis, parent.value);
    hash = updateFnv64U64(hash, 0u);
    hash = updateFnv64U64(hash, stableKey);
    WidgetId outId;
    if(hash == 0u)
        outId.value = 1u;
    else
        outId.value = hash;
    return outId;
}

Expected<WidgetId> TryMakeWidgetId(in WidgetId parent, in StringView stableKey){
    if(!parent.valid() || stableKey.empty())
        return makeUnexpected(Failure());
    u64 hash = updateFnv64U64(s_Fnv64OffsetBasis, parent.value);
    hash = updateFnv64U64(hash, cast<u64>(stableKey.size()));
    for(usize i = 0u; i < stableKey.size(); ++i)
        hash = updateFnv64Byte(hash, cast<u8>(stableKey[i]));
    WidgetId outId;
    if(hash == 0u)
        outId.value = 1u;
    else
        outId.value = hash;
    return outId;
}

b8 ValidateWidgetStateTouchRequest(in WidgetId id, in WidgetRoot root, in WidgetKind kind, in u64 frameGeneration){
    return id.valid() && root.generation != 0u && frameGeneration != 0u && cast<u8>(kind) <= cast<u8>(WidgetKind::Image);
}

b8 CanTouchExistingWidgetState(in WidgetState entry, in WidgetRoot root, in u64 frameGeneration){
    return entry.root == root && entry.lastSeenFrame != frameGeneration;
}

b8 IsMatchingWidgetStateDeclaration(
    in b8 rootActive,
    in WidgetRoot activeRoot,
    in u64 frameGeneration,
    in WidgetState state,
    in WidgetState current
){
    return
        rootActive
        && state.root == activeRoot
        && state.lastSeenFrame == frameGeneration
        && current.root == state.root
        && current.declarationGeneration == state.declarationGeneration
        && current.lastSeenFrame == state.lastSeenFrame
        && current.kind == state.kind
    ;
}

b8 RebuildWidgetStateIndexInto(in Span<WidgetState> entries, mut HashMap<u64, usize> outIndex){
    outIndex.clear();
    for(usize index = 0u; index < entries.size(); ++index){
        const u64 idValue = entries[index].id.value;
        if(outIndex.contains(idValue))
            return false;
        outIndex.try_emplace(idValue, index);
    }
    return true;
}

Expected<usize> FindWidgetStateEntryIndex(
    in Span<WidgetState> entries,
    in WidgetId id,
    mut HashMap<u64, usize> inOutIndex,
    mut b8 inOutIndexDirty,
    mut b8 outInvariantFailed
){
    outInvariantFailed = false;
    if(inOutIndexDirty){
        if(!RebuildWidgetStateIndexInto(entries, inOutIndex)){
            outInvariantFailed = true;
            return makeUnexpected(Failure());
        }
        inOutIndexDirty = false;
    }
    if(!inOutIndex.contains(id.value))
        return makeUnexpected(Failure());
    const usize index = inOutIndex[id.value];
    assert(index < entries.size() && entries[index].id == id);
    return index;
}

void EraseWidgetStateEntryAt(
    in usize index,
    mut Vector<WidgetState> inOutEntries,
    mut b8 outIndexDirty
){
    if(index >= inOutEntries.size())
        return;
    for(usize i = index; i + 1u < inOutEntries.size(); ++i)
        inOutEntries[i] = inOutEntries[i + 1u];
    inOutEntries.pop_back();
    outIndexDirty = true;
}

Expected<usize> TryTouchWidgetStateEntry(
    in WidgetId id,
    in WidgetRoot root,
    in WidgetKind kind,
    in u64 frameGeneration,
    mut Vector<WidgetState> inOutEntries,
    mut HashMap<u64, usize> inOutIndex,
    mut u64 inOutNextDeclarationGeneration,
    mut b8 inOutIndexDirty,
    mut b8 outInvariantFailed
){
    outInvariantFailed = false;
    if(!ValidateWidgetStateTouchRequest(id, root, kind, frameGeneration))
        return makeUnexpected(Failure());
    const Expected<usize> foundIndex = FindWidgetStateEntryIndex(inOutEntries, id, inOutIndex, inOutIndexDirty, outInvariantFailed);
    if(outInvariantFailed)
        return makeUnexpected(Failure());
    if(foundIndex.has_value()){
        const usize index = foundIndex.value();
        WidgetState entry = inOutEntries[index];
        if(!CanTouchExistingWidgetState(entry, root, frameGeneration))
            return makeUnexpected(Failure());
        if(entry.kind != kind){
            if(inOutNextDeclarationGeneration == u64.max){
                outInvariantFailed = true;
                return makeUnexpected(Failure());
            }
            entry.declarationGeneration = inOutNextDeclarationGeneration;
            ++inOutNextDeclarationGeneration;
            entry.kind = kind;
        }
        entry.lastSeenFrame = frameGeneration;
        inOutEntries[index] = entry;
        return index;
    }
    if(inOutEntries.size() >= s_WidgetStateRetainedCapacity)
        return makeUnexpected(Failure());
    if(inOutNextDeclarationGeneration == u64.max){
        outInvariantFailed = true;
        return makeUnexpected(Failure());
    }
    const usize newIndex = inOutEntries.size();
    inOutEntries.push_back(WidgetState(id, root, inOutNextDeclarationGeneration, frameGeneration, kind));
    if(inOutIndex.contains(id.value)){
        inOutEntries.pop_back();
        outInvariantFailed = true;
        return makeUnexpected(Failure());
    }
    inOutIndex.try_emplace(id.value, newIndex);
    ++inOutNextDeclarationGeneration;
    return newIndex;
}


