void VerifyAdhdPreprocessor_BorrowedExpansionPreservesAliasingAndFailures(){
    AdhdTestArena arena = AdhdTestArena();
    AdhdTestArena other = AdhdTestArena();
    {
        CompilerMacroMap macros(arena.arena);
        HeapStorageVector<MetascriptParseError> errors(arena.arena);
        const auto addObject = lambda[mut arena, mut macros](in StringView name, in StringView value) -> void{
            MetascriptPreprocessorMacro macro(arena.arena);
            macro.name.assign(name);
            macro.body.assign(value);
            GlobalString key(name, arena.arena);
            macros.store(key, macro);
        };
        const auto addUnary = lambda[mut arena, mut macros](in StringView name, in StringView value) -> void{
            MetascriptPreprocessorMacro macro(arena.arena);
            macro.name.assign(name);
            macro.parameters.emplace_back("x", arena.arena);
            macro.body.assign(value);
            macro.isFunctionLike = true;
            GlobalString key(name, arena.arena);
            macros.store(key, macro);
        };
        addObject("A", "answer");
        addObject("EMPTY", "");
        addUnary("F", "x+x");
        addUnary("BAD", "x");
        MetascriptPreprocessorMacroExpander expander(arena.arena, macros, errors);

        const MStringView unchanged = "defined (A) native { A; } F and a long unchanged line";
        GlobalString storage("keep", other.arena);
        StringView view = StringView();
        ASSERT_TRUE(expander.expandToView(unchanged, 1u, storage, view));
        EXPECT_EQ(view, unchanged);
        EXPECT_EQ(TestDataAddress(view), TestDataAddress(unchanged));
        EXPECT_EQ(MStringView(storage), "keep");
        ASSERT_TRUE(expander.expandToView(StringView(), 1u, storage, view));
        EXPECT_TRUE(view.empty());
        EXPECT_EQ(TestDataAddress(view), 0u);
        EXPECT_EQ(MStringView(storage), "keep");

        GlobalString output("old", other.arena);
        ASSERT_TRUE(expander.expand(unchanged, 1u, output));
        EXPECT_EQ(MStringView(output), unchanged);
        EXPECT_TRUE(TestUsesStorage(output, arena.arena));
        output.assign("prefix A suffix");
        ASSERT_TRUE(expander.expand(MStringView(output).substr(7u, 1u), 1u, output));
        EXPECT_EQ(MStringView(output), "answer");
        ASSERT_TRUE(expander.expand("A F(A) EMPTY tail", 1u, output));
        EXPECT_EQ(MStringView(output), "answer answer+answer  tail");
        ASSERT_TRUE(expander.expand("A 1e+A \"A\" /* A */ native { A; } A // A", 1u, output));
        EXPECT_EQ(MStringView(output), "answer 1e+A \"A\" /* A */ native { A; } answer // A");

        ASSERT_TRUE(expander.expand("A R\"tag(A)tag\" A /* A", 1u, output));
        EXPECT_EQ(MStringView(output), "answer R\"tag(A)tag\" answer /* A");
        ASSERT_TRUE(expander.expand(" { A; } A", 1u, output, true, 0u));
        EXPECT_EQ(MStringView(output), " { A; } answer");
        MetascriptPreprocessorMacro variadic(arena.arena);
        variadic.name = "V";
        variadic.parameters.emplace_back("x", arena.arena);
        variadic.body = "x|__VA_ARGS__|...";
        variadic.isFunctionLike = true;
        variadic.isVariadic = true;
        GlobalString variadicKey("V", arena.arena);
        macros.store(variadicKey, variadic);
        ASSERT_TRUE(expander.expand("V(A, two, (3,4))", 1u, output));
        EXPECT_EQ(MStringView(output), "answer|two, (3,4)|two, (3,4)");
        ASSERT_TRUE(expander.expand("V(A)", 1u, output));
        EXPECT_EQ(MStringView(output), "answer||");

        output.assign("unchanged on failure");
        ASSERT_FALSE(expander.expand("A F(BAD(1, 2))", 42u, output));
        EXPECT_EQ(MStringView(output), "unchanged on failure");
        ASSERT_FALSE(errors.empty());
        EXPECT_EQ(errors.back().line, 42u);
        errors.clear();
        ASSERT_FALSE(expander.expand("A F(", 43u, output));
        EXPECT_EQ(MStringView(output), "unchanged on failure");
        ASSERT_FALSE(errors.empty());
        EXPECT_EQ(errors.back().line, 43u);
        errors.clear();

        addObject("B", "VALUE");
        addObject("A", "B");
        auto a = macros.borrow(MStringView("A"));
        ASSERT_TRUE(a.has_value());
        ASSERT_TRUE(expander.expand("A", 1u, a.value().body));
        EXPECT_EQ(MStringView(a.value().body), "VALUE");
        for(u32 i = 0u; i < 17u; ++i){
            String name = String("M");
            AppendUnsignedU64Text(name, cast<u64>(i));
            String next = String("M");
            AppendUnsignedU64Text(next, cast<u64>(i + 1u));
            addObject(name, next);
        }
        ASSERT_TRUE(expander.expand("M0", 1u, output));
        EXPECT_EQ(MStringView(output), "M16");
    }
}

void VerifyAdhdCompiler_SubstitutedConstantTextSurvivesFurtherAllocations(){
    AdhdTestArena arena = AdhdTestArena();
    {
        CompileResult result(arena.arena);
        CompilerTypeRef original(arena.arena);
        original.name = "Array";
        original.templateArgs.push_back(MakeTypeArgument("N + 1"));
        original.templateArgs.push_back(MakeTypeArgument("N + 222222222222222222222222222222"));
        original.templateArgs.push_back(MakeTypeArgument("Namespace::N"));
        original.templateArgs.push_back(MakeTypeArgument("N + Namespace::N + N"));
        CompilerTypeRef constantType(arena.arena);
        CompilerTemplateParam parameter(arena.arena);
        parameter.name = "N";
        SetConstantType(parameter, constantType);
        const CompilerTypeArg argument = MakeTypeArgument("7");
        const auto substituted = BorrowSubstitutedType(result.symbols, original, parameter, argument);
        ASSERT_TRUE(substituted.has_value());
        CompilerTypeRef copied(arena.arena);
        copied = substituted.value();
        for(usize index = 0u; index < 64u; ++index)
            ASSERT_TRUE(BorrowSubstitutedType(result.symbols, original, parameter, argument).has_value());
        ASSERT_EQ(substituted.value().templateArgs.size(), 4u);
        EXPECT_EQ(substituted.value().templateArgs[0u].constantText, "7 + 1");
        EXPECT_EQ(substituted.value().templateArgs[1u].constantText, "7 + 222222222222222222222222222222");
        EXPECT_EQ(substituted.value().templateArgs[2u].constantText, "Namespace::N");
        EXPECT_EQ(substituted.value().templateArgs[3u].constantText, "7 + Namespace::N + 7");
        EXPECT_EQ(copied.templateArgs[0u].constantText, "7 + 1");
        EXPECT_EQ(copied.templateArgs[1u].constantText, "7 + 222222222222222222222222222222");
    }
}

void VerifyAdhdCompiler_CustomNamespaceMayBorrowPreviousOutput(){
    AdhdTestArena arena = AdhdTestArena();
    {
        const StringView source = "void Run(){ }\r\n";
        const StringView name = "NWB::AReallyLongNamespaceForBorrowedOutput";
        CompileResult headerResult(arena.arena);
        headerResult.generatedHeader.assign(name);
        ASSERT_TRUE(CompileNamed(source, "custom.adhd", StringView(headerResult.generatedHeader), arena.arena, headerResult));
        EXPECT_NE(MStringView(headerResult.generatedHeader).find(name), usize.max);
        EXPECT_NE(MStringView(headerResult.generatedSource).find(name), usize.max);
        CompileResult sourceResult(arena.arena);
        sourceResult.generatedSource.assign(name);
        ASSERT_TRUE(CompileNamed(source, "custom.adhd", StringView(sourceResult.generatedSource), arena.arena, sourceResult));
        EXPECT_NE(MStringView(sourceResult.generatedHeader).find(name), usize.max);
        EXPECT_NE(MStringView(sourceResult.generatedSource).find(name), usize.max);
    }
}

