class UiProgressSmokeScene{
    private PopupState m_parent = PopupState();
    private PopupState m_child = PopupState();
    private UiProgressSnapshot m_declared = UiProgressSnapshot();
    private UiProgressSnapshot m_snapshot = UiProgressSnapshot();
    private u32 m_beforeClicks = 0u;
    private u32 m_afterClicks = 0u;
    private b8 m_phase = false;

    public b8 paint(mut UiPaintContext context);
    public b8 keyboardUpdate(in i32 key, in i32 scancode, in i32 action, in i32 mods);

    private b8 paintMain(mut Builder ui, in Rect bounds);
    private b8 paintFrozen(mut Builder ui, in Rect bounds);
    private b8 paintExternal(mut UiPaintContext context, in Rect bounds);
    private b8 paintPopups(mut Builder ui, in f32 right);
    private void observeState(mut UiPaintContext context);
    private void paintMarkers(mut UiPaintContext context)const;
}


