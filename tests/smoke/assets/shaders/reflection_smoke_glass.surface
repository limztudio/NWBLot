////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// This stress fixture uses IOR 3.8 and its matching dielectric F0 supplied by the project.
static const half NWB_SMOKE_REFLECTION_GLASS_IOR = 3.8h;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NwbMeshSurface nwbMaterialSurface(){
    const NwbMeshInstanceData instance = nwbMeshLoadInstance();
    const NwbSmokeRuntimeMaterial runtime = nwbMaterialBindLoadRuntime(instance);
    NwbMeshSurface result = nwbMakeGlassSurface(half3(0.0h), inNormal, NWB_SMOKE_REFLECTION_GLASS_IOR, NWB_SURFACE_ABSORPTION_NONE, half(0.0h));
    nwbSetMeshSurfaceReflection(result, runtime.specular_f0, runtime.perceptual_roughness);
    return result;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

