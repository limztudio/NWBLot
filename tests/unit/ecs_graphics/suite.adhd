[ordered]
class CoincidentSelectionContext{
    public HeapStorage arena = HeapStorage(s_EcsCaseTestsCoincidentOpticalVolumesSelection);
    public ScratchStorage scratch = ScratchStorage(s_EcsCaseTestsCoincidentOpticalVolumesScratch);
    public TestValueSlot<RendererOpticalVolumeSelection> selectionStorage;
    public mut RendererOpticalVolumeSelection selection;
    public CoincidentSelectionContext(){ this.selection = this.selectionStorage.constructIn(this.arena); }
    public void select(in Span<CoincidentOpticalVolumeCandidate> candidates){ this.selection.select(candidates); }
    public void selectEmpty(){ this.selection.select(Span<CoincidentOpticalVolumeCandidate>()); }
    public void selectSingle(in CoincidentOpticalVolumeCandidate candidate){ this.selection.select(SpanOf<CoincidentOpticalVolumeCandidate>(candidate)); }
}

[ordered]
class ComputeOutputContext{
    public HeapStorage testArena;
    public GpuTaskGraph graph;
    public TestValueSlot<OpaqueRegularComputeEmulationGraphPlan> planStorage;
    public mut OpaqueRegularComputeEmulationGraphPlan plan;
    public ComputeOutputContext(){
        this.testArena = HeapStorage();
        this.graph = GpuTaskGraph(this.testArena);
        this.plan = this.planStorage.constructIn(this.testArena);
    }
}

