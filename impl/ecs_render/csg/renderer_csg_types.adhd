////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


native{
#include <impl/ecs_render/csg/clip_bounds.adhd.h>
#include <impl/assets/graphics/csg/constants.h>
#include <impl/ecs_csg/frame_state.adhd.h>
#include <impl/ecs_csg/shape_registry.adhd.h>

#include <core/alloc/scratch.h>
#include <core/graphics/api.h>

#include <global/containers.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static_assert(s_CsgBoundsValidFlag == NWB_CSG_BOUNDS_VALID_FLAG, "s_CsgBoundsValidFlag must match NWB_CSG_BOUNDS_VALID_FLAG");
static_assert(s_CsgBoundsFiniteFlag == NWB_CSG_BOUNDS_FINITE_FLAG, "s_CsgBoundsFiniteFlag must match NWB_CSG_BOUNDS_FINITE_FLAG");


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static_assert(sizeof(CsgReceiverRangeGpuData) == sizeof(u32) * 12u + sizeof(Float34) + sizeof(CsgBoundsGpuData), "CsgReceiverRangeGpuData layout must match the CSG shader");
static_assert(sizeof(CsgCutterGpuData) == sizeof(Float4) + sizeof(Float34) + sizeof(Float4) * 2u, "CsgCutterGpuData layout must match the CSG shader");
static_assert(sizeof(CsgClipContextSlots) == sizeof(u32) * 8u, "CSG clip context slots must stay two uint4 lanes");
static_assert(sizeof(CsgIntervalSampleStateGpuData) == sizeof(u32) * 8u, "CSG interval sample state must match shader layout");
static_assert(sizeof(CsgIntervalDispatchPushConstants) == NWB_CSG_INTERVAL_DISPATCH_PUSH_CONSTANT_BYTE_SIZE, "CSG interval dispatch push constants must match shader layout");
static_assert(alignof(CsgReceiverRangeGpuData) >= alignof(Float4), "CsgReceiverRangeGpuData must stay SIMD-aligned");
static_assert(alignof(CsgCutterGpuData) >= alignof(Float4), "CsgCutterGpuData must stay SIMD-aligned");
static_assert(alignof(CsgReceiverCpuBounds) >= alignof(Float4), "CsgReceiverCpuBounds must stay SIMD-friendly");
static_assert(IsStandardLayout_V<CsgReceiverCpuBounds>, "CsgReceiverCpuBounds must stay cache-friendly");
static_assert(IsTriviallyCopyable_V<CsgReceiverCpuBounds>, "CsgReceiverCpuBounds must stay cheap to pass by value");
static_assert(IsStandardLayout_V<CsgReceiverRangeGpuData>, "CsgReceiverRangeGpuData must stay GPU-uploadable");
static_assert(IsTriviallyCopyable_V<CsgReceiverRangeGpuData>, "CsgReceiverRangeGpuData must stay GPU-uploadable");
static_assert(IsStandardLayout_V<CsgCutterGpuData>, "CsgCutterGpuData must stay GPU-uploadable");
static_assert(IsTriviallyCopyable_V<CsgCutterGpuData>, "CsgCutterGpuData must stay GPU-uploadable");

using CsgReceiverRangeGpuDataVector = Vector<CsgReceiverRangeGpuData, Core::Alloc::ScratchArena>;
using CsgCutterGpuDataVector = Vector<CsgCutterGpuData, Core::Alloc::ScratchArena>;

namespace ECSRenderDetail{
    using ReceiverRangeVector = Vector<CsgReceiverRangeGpuData, Core::Alloc::GlobalArena>;
    using CutterVector = Vector<CsgCutterGpuData, Core::Alloc::GlobalArena>;
};

[[nodiscard]] inline Core::Rect ToCoreRect(const CsgWorkRect& rect)noexcept{
    return Core::Rect(rect.minX, rect.maxX, rect.minY, rect.maxY);
}

class MeshSystem;

namespace CsgFrameCacheDetail{
    [[nodiscard]] Expected<CsgFrameStateCacheSignature> BuildSignature(Core::ECS::World& world, const CsgShapeRegistry& shapeRegistry, const MeshSystem& meshSystem);
};

// False rejects the cutter; accepted bounds with valid=false require full screen coverage.
[[nodiscard]] b8 ResolveCsgClipWorkBounds(const CsgShapeRegistry& shapeRegistry, const CsgShapeTypeInfo& shapeType, const SIMDMatrix& shapeToWorld, Span<const u8> parameterBytes, const CsgClipWorkBounds& receiverBounds, CsgClipWorkBounds& outWorkBounds);

struct CsgFrameGpuData{
    CsgReceiverRangeGpuDataVector receiverRanges;
    CsgCutterGpuDataVector cutters;
    CsgFrameWorkRegion workRegion;


public:
    explicit CsgFrameGpuData(Core::Alloc::ScratchArena& arena)noexcept
        : receiverRanges(arena)
        , cutters(arena)
    {}


public:
    [[nodiscard]] b8 hasWork()const noexcept{ return !receiverRanges.empty() && !cutters.empty(); }
    void reserve(usize receiverCapacity, usize cutterCapacity);
};

struct CsgFrameGpuDataView{
    Span<const CsgReceiverRangeGpuData> receiverRanges;
    Span<const CsgCutterGpuData> cutters;
    CsgFrameWorkRegion workRegion;


public:
    constexpr CsgFrameGpuDataView()noexcept = default;
    constexpr CsgFrameGpuDataView(const Span<const CsgReceiverRangeGpuData> inReceiverRanges, const Span<const CsgCutterGpuData> inCutters, const CsgFrameWorkRegion& inWorkRegion)noexcept
        : receiverRanges(inReceiverRanges)
        , cutters(inCutters)
        , workRegion(inWorkRegion)
    {}
    CsgFrameGpuDataView(const CsgFrameGpuData& frameData)noexcept
        : receiverRanges(frameData.receiverRanges)
        , cutters(frameData.cutters)
        , workRegion(frameData.workRegion)
    {}


public:
    [[nodiscard]] constexpr b8 hasWork()const noexcept{ return !receiverRanges.empty() && !cutters.empty(); }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ImplEcsRenderCsgRendererCsgTypesAdhdModule(in u64 value){
    return value != 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

