    private ScrollPlacement m_lastPlacement = ScrollPlacement();
    private DisplayMetrics m_lastDisplay = DisplayMetrics();
    private Array<u64, 12u> m_lastValues;
    private u32 m_sequence = 0u;
    private u32 m_commits = 0u;
    private u32 m_underlying = 0u;
