void VerifyLoggerProducerContracts_MessagePayloadRejectsInvalidTypeWithoutPublishingStaleBytes(mut LoggerProducerContracts self){
    LoggerTestArena testArena = LoggerTestArena();
    LogBytes payload = LogBytes(testArena.arena);
    payload.push_back(42u);
    native(mut testArena, mut payload){
        const Log::MessageType source = MakeTuple(Timer{}, static_cast<Core::Common::LogType::Enum>(255u), Log::LogString(FOUNDATION_TEXT("invalid"), testArena.arena));
        const auto built = Log::MessagePayloadCodec::Build(source, payload);
        ASSERT_FALSE(built);
        EXPECT_EQ(built.error(), Log::MessagePayloadError::InvalidType);
    }
    EXPECT_TRUE(payload.empty());
}

void VerifyLoggerProducerContracts_SimultaneousProcessedFilesKeepIndependentRecords(mut LoggerProducerContracts self){
    LoggerTestArena testArena = LoggerTestArena();
    ProcessedMessageFile first = ProcessedMessageFile(testArena.arena);
    ProcessedMessageFile second = ProcessedMessageFile(testArena.arena);
    native(mut first, mut second){
        ASSERT_TRUE(first.open(FOUNDATION_TEXT("processed_file_isolation")));
        ASSERT_TRUE(second.open(FOUNDATION_TEXT("processed_file_isolation")));
        ASSERT_TRUE(first.writeLine(FOUNDATION_TEXT("first record")));
        ASSERT_TRUE(second.writeLine(FOUNDATION_TEXT("second record")));
    }
    EXPECT_NE(first.path(), second.path());
    first.close();
    second.close();
    String firstText = "";
    String secondText = "";
    ASSERT_TRUE(ReadTextFile(first.path(), firstText).has_value());
    ASSERT_TRUE(ReadTextFile(second.path(), secondText).has_value());
    EXPECT_TRUE(Contains(StringView(firstText), "first record"));
    EXPECT_FALSE(Contains(StringView(firstText), "second record"));
    EXPECT_TRUE(Contains(StringView(secondText), "second record"));
    EXPECT_FALSE(Contains(StringView(secondText), "first record"));
}

void VerifyLoggerProducerContracts_MissingArchiveRetainsNativeReadFailureInOwningRejection(mut LoggerProducerContracts self){
    LoggerTestArena testArena = LoggerTestArena();
    const StringView group = "logger_server_missing_archive_native_error_test";
    const StringView stem = "missing_archive_001";
    RemoveTestArtifacts(group);
    const CrashIngestConfig config = MakeIngestConfig(testArena.arena, group);
    const Path path = ArchivePath(group, stem);
    const Expected<u64, ErrorCode> missing = FileSize(path);
    ASSERT_FALSE(missing.has_value());
    const CrashIngestResult result = ProcessCrashUpload(testArena.arena, path, config);
    EXPECT_FALSE(result.accepted);
    EXPECT_TRUE(CrashIngestMessageContains(result, "failed to read crash archive"));
    const String nativeText = StringFormat("native_category='{}'; native_code={}", ErrorCodeCategoryName(missing.error()), missing.error().value());
    EXPECT_TRUE(CrashIngestMessageContains(result, StringView(nativeText)));
    RemoveTestArtifacts(group);
}


