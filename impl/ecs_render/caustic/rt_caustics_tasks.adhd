class CausticAccumulatorDecayGraphTask{
    private mut RendererRayTracingSystem m_raytracingSystem;
    private mut GraphicsRuntime m_graphics;
    private mut DeferredFrameTargets m_targets;
    private MeshViewBufferSnapshot m_meshView;
    private in b8 m_shadowVisibilityPrepared;
    private mut GpuTimingSubmissionTicket m_timingTicket;
    private mut Optional<GpuTimingMeasure> m_causticPhotonTiming;
    private b8 m_hardwareCaustics;

    public CausticAccumulatorDecayGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        mut GraphicsRuntime graphics,
        mut DeferredFrameTargets targets,
        in MeshViewBufferSnapshot meshView,
        in borrow b8 shadowVisibilityPrepared,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> causticPhotonTiming,
        in b8 hardwareCaustics
    ){
        this.m_raytracingSystem = raytracingSystem;
        this.m_graphics = graphics;
        this.m_targets = targets;
        this.m_meshView = meshView;
        this.m_shadowVisibilityPrepared = shadowVisibilityPrepared;
        this.m_timingTicket = timingTicket;
        this.m_causticPhotonTiming = causticPhotonTiming;
        this.m_hardwareCaustics = hardwareCaustics;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }
    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.m_shadowVisibilityPrepared)
            return true;
        b8 hasWork = false;
        if(this.m_hardwareCaustics)
            hasWork = this.m_raytracingSystem.hasHwCausticWork(this.m_meshView);
        else
            hasWork = this.m_raytracingSystem.hasCausticWork(this.m_meshView);
        if(!hasWork)
            return true;

        DiscardGpuTimingMeasure(this.m_causticPhotonTiming);
        GpuTimingTicketRecordingScope timingRecording(this.m_timingTicket);
        this.m_causticPhotonTiming.emplace(this.m_graphics.gpuTiming(), s_TimingScopeCausticPhotons, this.m_graphics.getDevice(), commandList);
        if(!FinishSplitGpuTimingMarker(this.m_causticPhotonTiming))
            return false;
        const b8 dispatched = this.m_raytracingSystem.dispatchCausticAccumulatorDecay(commandList, this.m_targets);
        if(!dispatched){
            DiscardGpuTimingMeasure(this.m_causticPhotonTiming);
            warning("RendererSystem: graph-owned caustic accumulator decay pass failed");
        }
        return true;
    }

    public void discarded(){
        DiscardGpuTimingMeasure(this.m_causticPhotonTiming);
    }
}

class CausticProducerGraphTask{
    private mut RendererRayTracingSystem m_raytracingSystem;
    private mut DeferredFrameTargets m_targets;
    private DeferredLightingGraphResources m_deferredLightingResources;
    private MeshViewBufferSnapshot m_meshView;
    private mut GpuTimingSubmissionTicket m_timingTicket;
    private in b8 m_shadowVisibilityPrepared;
    private mut Optional<GpuTimingMeasure> m_causticPhotonTiming;
    private b8 m_graphOwnsAccumulatorBootstrapClear;
    private mut b8 m_causticProducerDispatched;
    private b8 m_hardware;

    public CausticProducerGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        mut DeferredFrameTargets targets,
        in DeferredLightingGraphResources deferredLightingResources,
        in MeshViewBufferSnapshot meshView,
        mut GpuTimingSubmissionTicket timingTicket,
        in borrow b8 shadowVisibilityPrepared,
        mut Optional<GpuTimingMeasure> causticPhotonTiming,
        in b8 graphOwnsAccumulatorBootstrapClear,
        mut b8 causticProducerDispatched,
        in b8 hardware
    ){
        this.m_raytracingSystem = raytracingSystem;
        this.m_targets = targets;
        this.m_deferredLightingResources = deferredLightingResources;
        this.m_meshView = meshView;
        this.m_timingTicket = timingTicket;
        this.m_shadowVisibilityPrepared = shadowVisibilityPrepared;
        this.m_causticPhotonTiming = causticPhotonTiming;
        this.m_graphOwnsAccumulatorBootstrapClear = graphOwnsAccumulatorBootstrapClear;
        this.m_causticProducerDispatched = causticProducerDispatched;
        this.m_hardware = hardware;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute | GpuQueueCapability::Transfer); }
    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        this.m_causticProducerDispatched = false;
        if(!this.m_deferredLightingResources.valid())
            return false;

        GpuTimingTicketRecordingScope timingRecording(this.m_timingTicket);
        if(this.m_shadowVisibilityPrepared){
            b8 causticsDispatched = false;
            if(this.m_hardware)
                causticsDispatched = this.m_raytracingSystem.renderHwCaustics(commandList, this.m_meshView, this.m_targets, Optional<mut Optional<GpuTimingMeasure>>(this.m_causticPhotonTiming));
            else
                causticsDispatched = this.m_raytracingSystem.renderGpuBvhCaustics(commandList, this.m_meshView, this.m_targets, Optional<mut Optional<GpuTimingMeasure>>(this.m_causticPhotonTiming));
            if(!causticsDispatched)
                DiscardGpuTimingMeasure(this.m_causticPhotonTiming);
            this.m_causticProducerDispatched = causticsDispatched;
            if(!causticsDispatched){
                if(this.m_hardware){
                    if(this.m_raytracingSystem.hasHwCausticWork(this.m_meshView))
                        warning("RendererSystem: hardware caustic render pass failed");
                }
                else if(this.m_raytracingSystem.hasCausticWork(this.m_meshView))
                    warning("RendererSystem: software caustic render pass failed");
            }
        }
        return true;
    }

    public void accepted(in QueueSubmissionToken token){
        if(ShouldConfirmCausticAccumulatorBootstrapClear(this.m_graphOwnsAccumulatorBootstrapClear, this.m_causticProducerDispatched))
            this.m_raytracingSystem.confirmCausticAccumulatorBootstrapClear();
        if(this.m_causticProducerDispatched)
            this.m_raytracingSystem.confirmRayTraceContextReadSubmission(token);
    }

    public void discarded(){
        this.m_causticProducerDispatched = false;
        DiscardGpuTimingMeasure(this.m_causticPhotonTiming);
    }
}

class CausticGeometryDownsampleGraphTask{
    private mut RendererRayTracingSystem m_raytracingSystem;
    private mut GraphicsRuntime m_graphics;
    private mut DeferredFrameTargets m_targets;
    private mut GpuTimingSubmissionTicket m_timingTicket;
    private in b8 m_causticProducerDispatched;
    private mut Optional<GpuTimingMeasure> m_causticResolveTiming;

    public CausticGeometryDownsampleGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        mut GraphicsRuntime graphics,
        mut DeferredFrameTargets targets,
        mut GpuTimingSubmissionTicket timingTicket,
        in borrow b8 causticProducerDispatched,
        mut Optional<GpuTimingMeasure> causticResolveTiming
    ){
        this.m_raytracingSystem = raytracingSystem;
        this.m_graphics = graphics;
        this.m_targets = targets;
        this.m_timingTicket = timingTicket;
        this.m_causticProducerDispatched = causticProducerDispatched;
        this.m_causticResolveTiming = causticResolveTiming;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }
    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        DiscardGpuTimingMeasure(this.m_causticResolveTiming);
        if(!this.m_causticProducerDispatched)
            return true;

        GpuTimingTicketRecordingScope timingRecording(this.m_timingTicket);
        this.m_causticResolveTiming.emplace(this.m_graphics.gpuTiming(), s_TimingScopeCausticResolve, this.m_graphics.getDevice(), commandList);
        this.m_raytracingSystem.dispatchCausticGeometryDownsample(commandList, this.m_targets);
        return FinishSplitGpuTimingMarker(this.m_causticResolveTiming);
    }

    public void discarded(){
        DiscardGpuTimingMeasure(this.m_causticResolveTiming);
    }
}

class CausticResolvePhaseGraphTask{
    private mut RendererRayTracingSystem m_raytracingSystem;
    private mut DeferredFrameTargets m_targets;
    private in b8 m_causticProducerDispatched;
    private CausticResolveActivitySnapshot m_activity;
    private CausticResolveStage m_phase;
    private u32 m_passIndex;

    public CausticResolvePhaseGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        mut DeferredFrameTargets targets,
        in borrow b8 causticProducerDispatched,
        in CausticResolveActivitySnapshot activity,
        in CausticResolveStage phase,
        in u32 passIndex
    ){
        this.m_raytracingSystem = raytracingSystem;
        this.m_targets = targets;
        this.m_causticProducerDispatched = causticProducerDispatched;
        this.m_activity = activity;
        this.m_phase = phase;
        this.m_passIndex = passIndex;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }
    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.m_activity.matches(this.m_raytracingSystem.causticResolveActivitySnapshot(this.m_targets)))
            return false;
        if(this.m_causticProducerDispatched){
            if(this.m_phase == CausticResolveStage::PrepareDownsample)
                this.m_raytracingSystem.dispatchCausticResolvePrepare(commandList, this.m_targets);
            else if(this.m_phase == CausticResolveStage::Wavelet)
                this.m_raytracingSystem.dispatchCausticResolveWaveletPass(commandList, this.m_targets, this.m_passIndex);
            else
                this.m_raytracingSystem.dispatchCausticResolveUpsample(commandList, this.m_targets);
        }
        return true;
    }
}

class CausticResolveGraphTask{
    private mut GpuTimingSubmissionTicket m_timingTicket;
    private in b8 m_causticProducerDispatched;
    private mut Optional<GpuTimingMeasure> m_causticResolveTiming;

    public CausticResolveGraphTask(
        mut GpuTimingSubmissionTicket timingTicket,
        in borrow b8 causticProducerDispatched,
        mut Optional<GpuTimingMeasure> causticResolveTiming
    ){
        this.m_timingTicket = timingTicket;
        this.m_causticProducerDispatched = causticProducerDispatched;
        this.m_causticResolveTiming = causticResolveTiming;
    }

    public GpuTaskCommandRequirements commandRequirements()const{
        return GpuTaskCommandRequirements();
    }
    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.m_causticProducerDispatched){
            DiscardGpuTimingMeasure(this.m_causticResolveTiming);
            return true;
        }
        if(!this.m_causticResolveTiming.has_value())
            return false;

        GpuTimingTicketRecordingScope timingRecording(this.m_timingTicket);
        this.m_causticResolveTiming.value().finishTiming(commandList);
        this.m_causticResolveTiming.reset();
        return true;
    }

    public void discarded(){
        DiscardGpuTimingMeasure(this.m_causticResolveTiming);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ShouldConfirmCausticAccumulatorBootstrapClear(in b8 graphOwnsAccumulatorBootstrapClear, in b8 causticProducerDispatched){
    return graphOwnsAccumulatorBootstrapClear && causticProducerDispatched;
}

Expected<HardwareCausticsStageResult> HardwareCausticsStageBuilder::declare(in HardwareCausticsStageInputs inputs){
    HardwareCausticsStageResult result;
    if(!inputs.declaresHardwareCaustics)
        return result;
    if(
        !inputs.worldPosition.valid()
        || !inputs.depth.valid()
        || !inputs.currentCausticIrradiance.valid()
        || !inputs.currentBindlessSlots.valid()
        || !inputs.sceneShading.valid()
        || !inputs.lights.valid()
        || !inputs.graphicsPrefixTask.valid()
    )
        return MakeUnexpected(Failure());
    if(this.m_raytracingSystem.hasHwCausticWork(inputs.meshViewSnapshot) && !inputs.opticalScene.valid())
        return MakeUnexpected(Failure());

    CausticsResolveChainBuilder resolveChainBuilder(this.m_graph, this.m_raytracingSystem);
    const auto stageTargetsResult = resolveChainBuilder.importStageTargets(inputs.targets, true);
    if(!stageTargetsResult.has_value())
        return MakeUnexpected(Failure());
    const CausticsStageTargets stageTargets = stageTargetsResult.value();

    Vector<GpuTaskResourceUse> hardwarePhotonResourceUses;
    const b8 hardwareTraceGeometryStatesGraphOwned = inputs.hardwareTraceGeometrySet.valid();
    const TraceResourceSetUses hardwarePhotonResourceSetUses = MakeTraceResourceSetUses(inputs.hardwareTraceGeometrySet, inputs.traceMaterialSampledTextureSet);
    hardwarePhotonResourceUses.reserve(ComputePhotonResourceUseCapacity(
        s_HardwarePhotonResourceUseCapacity,
        inputs.rayTracingResources.csgTraceContextBuffer.valid(),
        inputs.rayTracingResources.csgTraceBoundsBuffers.size(),
        hardwareTraceGeometryStatesGraphOwned,
        inputs.hardwareTraceGeometryResources.size()
    ));
    hardwarePhotonResourceUses.push_back(ReadTextureUse(inputs.worldPosition, s_FramebufferSubresources, ResourceStates::ShaderResource));
    hardwarePhotonResourceUses.push_back(ReadTextureUse(inputs.depth, s_FramebufferSubresources, ResourceStates::ShaderResource));
    hardwarePhotonResourceUses.push_back(ReadUse(inputs.currentBindlessSlots, ResourceStates::ConstantBuffer));
    hardwarePhotonResourceUses.push_back(ReadUse(inputs.sceneShading, ResourceStates::ConstantBuffer));
    hardwarePhotonResourceUses.push_back(ReadUse(inputs.lights, ResourceStates::ShaderResource));
    if(inputs.opticalScene.valid())
        hardwarePhotonResourceUses.push_back(ReadUse(inputs.opticalScene));
    hardwarePhotonResourceUses.push_back(ReadUse(stageTargets.sceneGeometryDomain));
    hardwarePhotonResourceUses.push_back(ReadWriteTextureUse(stageTargets.causticAccumulator, s_CausticAccumulatorSubresources, ResourceStates::UnorderedAccess));

    b8 optionalResourcesImported =
        AppendCausticReadBuffer(this.m_graph, hardwarePhotonResourceUses, inputs.meshViewSnapshot.buffer, Name(s_MeshViewName), s_MeshViewLabel, ResourceStates::ConstantBuffer)
        && AppendCausticReadBuffer(this.m_graph, hardwarePhotonResourceUses,
            inputs.rayTracingResources.shadowInstanceMaterialBuffer,
            Name(s_SceneShadowInstanceMaterialName),
            s_SceneShadowInstanceMaterialLabel,
            ResourceStates::ShaderResource
        )
        && AppendCausticReadBuffer(this.m_graph, hardwarePhotonResourceUses, inputs.rayTracingResources.shadowMaterialTypedBuffer, Name(s_SceneShadowMaterialTypedName), s_SceneShadowMaterialTypedLabel, ResourceStates::ShaderResource)
        && AppendCausticReadBuffer(this.m_graph, hardwarePhotonResourceUses, inputs.rayTracingResources.shadowInstanceBuffer, Name(s_SceneShadowInstancesName), s_SceneShadowInstancesLabel, ResourceStates::ShaderResource)
        && AppendCausticReadBuffer(this.m_graph, hardwarePhotonResourceUses, inputs.rayTracingResources.causticEmissionTargetBuffer, Name(s_HardwareCausticEmissionTargetsName), s_CausticEmissionTargetsLabel, ResourceStates::ShaderResource)
    ;
    if(inputs.materialContextSlots.valid())
        hardwarePhotonResourceUses.push_back(ReadUse(inputs.materialContextSlots, ResourceStates::ConstantBuffer));
    for(in GpuGraphResourceId resource : inputs.hardwareTraceGeometryResources){
        if(!resource.valid()){
            warning("RendererSystem: invalid prepared hardware-caustics geometry resource");
            return MakeUnexpected(Failure());
        }
        if(!hardwareTraceGeometryStatesGraphOwned)
            hardwarePhotonResourceUses.push_back(ReadUse(resource, ResourceStates::ShaderResource));
    }
    if(inputs.rayTracingResources.sceneTlas.valid()){
        GpuGraphResourceDesc tlasDesc = AccelStructResourceDesc(Name(s_SceneTlasResourceName), s_SceneTlasResourceLabel);
        tlasDesc.setInitialState(this.m_raytracingSystem.sceneTlasBackingInitialState());
        const auto tlas = this.m_graph.importAccelStruct(inputs.rayTracingResources.sceneTlas, tlasDesc);
        optionalResourcesImported = optionalResourcesImported && tlas.has_value();
        if(tlas.has_value())
            hardwarePhotonResourceUses.push_back(ReadUse(tlas.value(), ResourceStates::AccelStructRead));
    }
    optionalResourcesImported = optionalResourcesImported && AppendCurrentCsgRayGeometry(
        inputs.rayTracingResources.csgTraceContextBuffer,
        inputs.rayTracingResources.csgTraceBoundsBuffers,
        this.m_graph,
        hardwarePhotonResourceUses
    );
    if(!optionalResourcesImported){
        warning("RendererSystem: could not import a hardware-caustics dynamic resource");
        return MakeUnexpected(Failure());
    }

    const Array<GpuTaskId, 1u> hardwareDependencies(inputs.graphicsPrefixTask);
    const Array<GpuExternalCompletionId, 1u> externalCompletions(inputs.historyWriterDrainCompletion);
    const Span<GpuExternalCompletionId> hardwareExternalDependencies = Span<GpuExternalCompletionId>(externalCompletions).first(cast<usize>(inputs.features.laggedLightingHistoryWriterWaitPending));
    const Array<GpuTaskExternalStateSource, 1u> accumulatorStateSources(ExternalStateSourceFromCache(inputs.accumulatorPersistentState));
    const Span<GpuTaskExternalStateSource> accumulatorStateSourceSpan = Span<GpuTaskExternalStateSource>(accumulatorStateSources).first(cast<usize>(inputs.accumulatorPersistentState.valid()));

    CausticsStagePrefixInputs prefixInputs(inputs.targets, inputs.meshViewSnapshot, inputs.shadowPreparationReady, inputs.timingTicket, inputs.photonTiming);
    prefixInputs.initialDependencies = Span<GpuTaskId>(hardwareDependencies);
    prefixInputs.externalDependencies = hardwareExternalDependencies;
    prefixInputs.accumulatorStateSources = accumulatorStateSourceSpan;
    prefixInputs.causticIrradiance = inputs.currentCausticIrradiance;
    prefixInputs.causticAccumulator = stageTargets.causticAccumulator;
    prefixInputs.causticAccumulatorInitialized = inputs.rayTracingResources.causticAccumulatorInitialized;
    prefixInputs.hardwareCaustics = true;
    const auto prefixTasksResult = resolveChainBuilder.declarePrefixTasks(prefixInputs);
    if(!prefixTasksResult.has_value())
        return MakeUnexpected(Failure());
    result.causticIrradianceClearTask = prefixTasksResult.value().causticIrradianceClearTask;
    result.causticAccumulatorBootstrapClearTask = prefixTasksResult.value().causticAccumulatorBootstrapClearTask;
    result.causticAccumulatorDecayTask = prefixTasksResult.value().causticAccumulatorDecayTask;

    GpuTaskSchedulingHint hardwareCausticsScheduling;
    hardwareCausticsScheduling.cost = GpuTaskCostHint::Large;
    hardwareCausticsScheduling.forceSubmissionBoundary = false;
    hardwareCausticsScheduling.allowPacketMerge = true;
    hardwareCausticsScheduling.mergeWithPrevious = true;
    hardwareCausticsScheduling.allowMergeAcrossConsumerFrontier = true;
    ConfigureComputeEffectRoutingHint(true, hardwareCausticsScheduling);

    GpuTaskDesc hardwarePhotonDesc;
    hardwarePhotonDesc
        .setIdentity(Name(s_RenderNameRenderHardwareCausticsPhotons))
        .setMarkerLabel("Hardware Caustic Photons")
        .setScheduling(hardwareCausticsScheduling)
        .setDependency(prefixTasksResult.value().photonDependencyTask)
        .setResourceUses(hardwarePhotonResourceUses)
        .setResourceSetUses(Span<GpuTaskResourceSetUse>(hardwarePhotonResourceSetUses.uses).first(hardwarePhotonResourceSetUses.useCount))
    ;
    const auto causticPhotonTaskResult = this.m_raytracingSystem.declareHardwareCausticsTask(
        this.m_graph,
        hardwarePhotonDesc,
        inputs.lightingResources,
        inputs.meshViewSnapshot,
        inputs.shadowPreparationReady,
        prefixTasksResult.value().graphOwnsAccumulatorBootstrapClear,
        inputs.targets,
        inputs.timingTicket,
        inputs.photonTiming,
        inputs.producerDispatched
    );
    if(!causticPhotonTaskResult.has_value()){
        warning("RendererSystem: could not declare hardware-caustics photon graph task");
        return MakeUnexpected(Failure());
    }
    result.causticPhotonTask = causticPhotonTaskResult.value();

    CausticsGeometryAndResolveInputs geometryInputs(inputs.targets, inputs.producerDispatched, inputs.timingTicket, inputs.resolveTiming);
    geometryInputs.stageTargets = stageTargets;
    geometryInputs.worldPosition = inputs.worldPosition;
    geometryInputs.depth = inputs.depth;
    geometryInputs.causticIrradiance = inputs.currentCausticIrradiance;
    geometryInputs.photonTask = result.causticPhotonTask;
    geometryInputs.baseScheduling = hardwareCausticsScheduling;
    geometryInputs.hardwareCaustics = true;
    const auto geometryAndResolveResult = resolveChainBuilder.declareGeometryAndResolve(geometryInputs);
    if(!geometryAndResolveResult.has_value())
        return MakeUnexpected(Failure());
    result.causticGeometryTask = geometryAndResolveResult.value().causticGeometryTask;
    result.causticResolvePrepareTask = geometryAndResolveResult.value().causticResolvePrepareTask;
    result.causticResolveWaveletTasks = geometryAndResolveResult.value().causticResolveWaveletTasks;
    result.causticResolveUpsampleTask = geometryAndResolveResult.value().causticResolveUpsampleTask;
    result.hardwareCausticsTask = geometryAndResolveResult.value().causticsTask;
    return result;
}

[cpp_unwind]
Expected<GpuTaskId> RendererRayTracingSystem::declareCausticAccumulatorDecayTask(
    mut GpuTaskGraph graph,
    in GpuTaskDesc desc,
    in MeshViewBufferSnapshot meshView,
    in borrow b8 shadowVisibilityPrepared,
    in b8 hardwareCaustics,
    mut DeferredFrameTargets targets,
    mut GpuTimingSubmissionTicket timingTicket,
    mut Optional<GpuTimingMeasure> causticPhotonTiming
){
    return graph.addPayloadTask(desc, CausticAccumulatorDecayGraphTask(this, this.m_graphics, targets, meshView, shadowVisibilityPrepared, timingTicket, causticPhotonTiming, hardwareCaustics));
}

[cpp_unwind]
Expected<GpuTaskId> RendererRayTracingSystem::declareSoftwareCausticsTask(
    mut GpuTaskGraph graph,
    in GpuTaskDesc desc,
    in DeferredLightingGraphResources deferredLightingResources,
    in MeshViewBufferSnapshot meshView,
    in borrow b8 shadowVisibilityPrepared,
    in b8 graphOwnsAccumulatorBootstrapClear,
    mut DeferredFrameTargets targets,
    mut GpuTimingSubmissionTicket timingTicket,
    mut Optional<GpuTimingMeasure> causticPhotonTiming,
    mut b8 causticProducerDispatched
){
    return graph.addPayloadTask(desc, CausticProducerGraphTask(this, targets, deferredLightingResources, meshView, timingTicket, shadowVisibilityPrepared, causticPhotonTiming, graphOwnsAccumulatorBootstrapClear, causticProducerDispatched, false));
}

