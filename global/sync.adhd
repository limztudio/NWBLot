[cpp_name("::AtomicBackOff"), cpp_flags(self_defaulted, binary_serializable, brace_init, no_copy, no_assign)]
extern class AtomicBackOff{
    b8 boundedPause(...);
    void pause(...);
    void reset(...);
};

[cpp_name("::ConditionVariableAny"), cpp_flags(self_defaulted, brace_init, no_copy, no_assign)]
