const u32 s_UiTextScrollPosInfF32Bits = 0x7f800000u;
const u32 s_UiTextScrollQuietNaNF32Bits = 0x7fc00000u;
const AStringView s_UiTextScrollPanelKey = "panel";
const AStringView s_UiTextScrollAreaKey = "area";
const AStringView s_UiTextScrollParentPopupKey = "parent";
const AStringView s_UiTextScrollChildPopupKey = "child";
const AStringView s_UiTextBakedSampleGlyphText = "A";


class UiTextAreaModelSnapshot{
    public String text;
    public u64 instance;
    public u64 revision;
    public u64 external;
    public u64 selection;
    public u64 composition;
    public usize anchor;
    public usize caret;
    public b8 composing;
    public b8 undo;
    public b8 redo;

    public UiTextAreaModelSnapshot(in EditModel model){
        const StringView view = model.text();
        if(!view.empty())
            this.text.assign(view.data(), view.size());
        this.instance = model.instanceGeneration();
        this.revision = model.revision();
        this.external = model.externalRevision();
        this.selection = model.selectionGeneration();
        this.composition = model.compositionGeneration();
        this.anchor = model.anchor();
        this.caret = model.caret();
        this.composing = model.composition().active;
        this.undo = model.canUndo();
        this.redo = model.canRedo();
    }
}

void ExpectUiTextAreaScrollLifetimeModel(in UiTextAreaScrollLifetimeTests self, in EditModel model, in UiTextAreaModelSnapshot before){
    EXPECT_EQ(model.text(), StringView(before.text.data(), before.text.size()));
    EXPECT_EQ(model.instanceGeneration(), before.instance);
    EXPECT_EQ(model.revision(), before.revision);
    EXPECT_EQ(model.externalRevision(), before.external);
    EXPECT_EQ(model.selectionGeneration(), before.selection);
    EXPECT_EQ(model.compositionGeneration(), before.composition);
    EXPECT_EQ(model.anchor(), before.anchor);
    EXPECT_EQ(model.caret(), before.caret);
    EXPECT_EQ(model.composition().active, before.composing);
    EXPECT_EQ(model.canUndo(), before.undo);
    EXPECT_EQ(model.canRedo(), before.redo);
    EXPECT_EQ(self.m_host.loans, 0u);
    EXPECT_EQ(self.m_host.publishes, 0u);
}

InputEvent MakeUiTextScrollPointerEvent(in Point position, in InputEventTypeEnum eventType){
    InputEvent event = InputEvent();
    event.position = position;
    event.type = eventType;
    return event;
}

InputEvent MakeUiTextScrollWheelEvent(in Point position, in f64 scrollX, in f64 scrollY){
    InputEvent event = InputEvent();
    event.position = position;
    event.scrollX = scrollX;
    event.scrollY = scrollY;
    event.type = InputEventType::PointerWheel;
    return event;
}

DisplayMetrics MakeUiTextScrollDisplayMetrics(in f32 width, in f32 height, in f32 scaleX, in f32 scaleY){
    DisplayMetrics display = DisplayMetrics();
    display.logicalWidth = width;
    display.logicalHeight = height;
    display.pixelScaleX = scaleX;
    display.pixelScaleY = scaleY;
    return display;
}

ShapeRequest MakeUiTextScrollShapeRequest(in StringView text, in f32 fontSize){
    ShapeRequest request = ShapeRequest();
    request.text = text;
    request.fontSize = fontSize;
    return request;
}

TextAreaOptions UiTextAreaScrollLifetimeSmallOptions(){
    TextAreaOptions options = TextAreaOptions();
    options.width = LayoutSize(LayoutSizePolicy::Fixed, 180.0f);
    options.height = LayoutSize(LayoutSizePolicy::Fixed, 100.0f);
    return options;
}

TextAreaOptions UiTextAreaScrollSmallOptions(){
    TextAreaOptions options = TextAreaOptions();
    options.width = LayoutSize(LayoutSizePolicy::Fixed, 90.0f);
    options.height = LayoutSize(LayoutSizePolicy::Fixed, 42.0f);
    return options;
}

AStringView UiTextAreaScrollDenseText(){
    return "aaaaaaaaaaaaaaaaaaaa\naaaaaaaaaaaaaaaaaaaa\naaaaaaaaaaaaaaaaaaaa\naaaaaaaaaaaaaaaaaaaa\naaaaaaaaaaaaaaaaaaaa\naaaaaaaaaaaaaaaaaaaa";
}

PopupOptions UiTextScrollLargeLoanParentOptions(){
    return MakeLargeLoanParentPopupOptions();
}

PopupOptions UiTextScrollLargeLoanChildOptions(){
    return MakeLargeLoanChildPopupOptions();
}

b8 SeedUiTextAreaScrollLifetimeModel(mut UiTextAreaScrollLifetimeTests self){
    return self.m_model.setText(self.denseView()) && self.m_model.setSelection(0u, 0u) && self.m_state.scrollTo(Point());
}

b8 PrepareUiTextAreaScrollOverflow(mut UiTextAreaScrollLifetimeTests self, in u64 generation, in TextAreaOptions options, in Rect bounds){
    return self.seedModel() && self.frameArea(generation, options, bounds) && self.m_state.scrollbars().horizontal.visible && self.m_state.scrollbars().vertical.visible;
}

WidgetId GetUiTextAreaScrollPopupArea(in UiTextAreaScrollLifetimeTests self){
    const WidgetId parent = RequireUiWidgetId(RequireUiRootId(self.m_root), s_UiTextScrollParentPopupKey);
    return RequireUiWidgetId(RequireUiWidgetId(parent, s_UiTextScrollChildPopupKey), s_UiTextScrollAreaKey);
}

b8 RunUiTextAreaScrollPopupFrame(mut UiTextAreaScrollLifetimeTests self, in u64 generation){
    if(!self.begin(generation) || !self.m_builder.beginPopup(s_UiTextScrollParentPopupKey, self.m_parent, UiTextScrollLargeLoanParentOptions()) || !self.m_builder.beginPopup(s_UiTextScrollChildPopupKey, self.m_child, UiTextScrollLargeLoanChildOptions()))
        return false;
    self.m_result = self.m_builder.textArea(s_UiTextScrollAreaKey, self.m_model, self.m_state, UiTextAreaScrollLifetimeSmallOptions());
    return self.m_result.valid && self.m_builder.endPopup() && self.m_builder.endPopup() && self.m_context.endRoot() && self.m_context.finishFrame() && self.m_context.commitFrame(generation);
}

b8 SendUiTextAreaScrollWheel(mut UiTextAreaScrollLifetimeTests self, in f64 delta){
    InputEvent event = InputEvent();
    event.type = InputEventType::PointerWheel;
    event.position = CenterUiRect(self.m_state.scrollbars().viewport);
    event.scrollY = delta;
    return self.send(event).pointerConsumed;
}

b8 StartUiTextAreaScrollThumb(mut UiTextAreaScrollLifetimeTests self, in WidgetId area){
    const WidgetId thumbId = RequireUiWidgetId(area, "scroll.y.thumb");
    const auto thumb = self.tryTarget(thumbId);
    if(!thumb.has_value())
        return false;
    const Point origin = CenterUiRect(thumb.value().rectangle);
    const Point destination = Point(origin.x, origin.y + 24.0f);
    return self.send(MakeUiTextScrollPointerEvent(origin, InputEventType::PrimaryDown)).pointerConsumed
        && self.send(MakeUiTextScrollPointerEvent(destination, InputEventType::PointerMove)).pointerConsumed
        && self.m_context.input().capture() == thumbId;
}

b8 PrepareUiTextAreaViewDense(mut UiTextAreaViewTests self){
    return self.m_model.setText("abcdef\nabcdef\nabcdef") && self.shapeView();
}

b8 ArrangeUiTextAreaViewManual(mut UiTextAreaViewTests self, in Point scroll, in f32 width, in f32 height){
    const auto placement = self.m_view.arrange(Rect(10.0f, 20.0f, width, height), Insets(), Rect(0.0f, 0.0f, 500.0f, 500.0f), scroll, 1.0f, false);
    if(!placement.has_value())
        return false;
    self.m_placement = placement.value();
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyUiTextAreaScrollLifetimeTests_IdenticalExternalScrollIntentRetiresAnAcceptedTrackPage(mut UiTextAreaScrollLifetimeTests self){
    ASSERT_TRUE(self.prepareOverflow());
    const UiTextAreaModelSnapshot model = UiTextAreaModelSnapshot(self.m_model);
    const WidgetId afterId = RequireUiWidgetId(self.id(s_UiTextScrollAreaKey, s_UiTextScrollPanelKey), "scroll.y.after");
    const auto firstAfter = self.tryTarget(afterId);
    ASSERT_TRUE(firstAfter.has_value());
    Rect afterRect = firstAfter.value().rectangle;
    self.click(CenterUiRect(afterRect));
    const Point scroll = self.m_state.scroll();
    const u64 revision = self.m_state.revision();
    ASSERT_TRUE(self.m_state.scrollTo(scroll));
    EXPECT_GT(self.m_state.revision(), revision);
    ASSERT_TRUE(self.frameArea(2u, UiTextAreaScrollLifetimeSmallOptions()));
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, scroll.x);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, scroll.y);
    ExpectUiTextAreaScrollLifetimeModel(self, self.m_model, model);
    const auto secondAfter = self.tryTarget(afterId);
    ASSERT_TRUE(secondAfter.has_value());
    afterRect = secondAfter.value().rectangle;
    self.click(CenterUiRect(afterRect));
    ASSERT_TRUE(self.frameArea(3u, UiTextAreaScrollLifetimeSmallOptions()));
    EXPECT_GT(self.m_state.scroll().y, scroll.y);
    ExpectUiTextAreaScrollLifetimeModel(self, self.m_model, model);
}

void VerifyUiTextAreaScrollLifetimeTests_IdenticalAndAwayBackSelectionIntentsRetireAcceptedWheel(mut UiTextAreaScrollLifetimeTests self){
    ASSERT_TRUE(self.prepareOverflow());
    u64 generation = 2u;
    Array<b8, 2u> modes;
    modes[0u] = false;
    modes[1u] = true;
    for(in b8 awayBack : modes){
        ASSERT_TRUE(self.wheel());
        const u64 revision = self.m_model.revision();
        const u64 selection = self.m_model.selectionGeneration();
        if(awayBack){
            ASSERT_TRUE(self.m_model.setSelection(1u, 1u));
            ASSERT_TRUE(self.m_model.setSelection(0u, 0u));
        }
        else
            ASSERT_TRUE(self.m_model.setSelection(0u, 0u));
        const UiTextAreaModelSnapshot model = UiTextAreaModelSnapshot(self.m_model);
        EXPECT_EQ(self.m_model.revision(), revision);
        EXPECT_GT(self.m_model.selectionGeneration(), selection);
        ASSERT_TRUE(self.frameArea(generation, UiTextAreaScrollLifetimeSmallOptions()));
        ++generation;
        EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
        ExpectUiTextAreaScrollLifetimeModel(self, self.m_model, model);
        ASSERT_TRUE(self.wheel());
        ASSERT_TRUE(self.frameArea(generation, UiTextAreaScrollLifetimeSmallOptions()));
        ++generation;
        EXPECT_GT(self.m_state.scroll().y, 0.0f);
        ExpectUiTextAreaScrollLifetimeModel(self, self.m_model, model);
        ASSERT_TRUE(self.m_state.scrollTo(Point()));
        ASSERT_TRUE(self.frameArea(generation, UiTextAreaScrollLifetimeSmallOptions()));
        ++generation;
        EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
    }
}

void VerifyUiTextAreaScrollLifetimeTests_SameTextReplacementAndModelRebindingRetireCopiedWheel(mut UiTextAreaScrollLifetimeTests self){
    ASSERT_TRUE(self.prepareOverflow());
    ASSERT_TRUE(self.m_model.setSelection(self.m_model.text().size(), self.m_model.text().size()));
    ASSERT_TRUE(self.frameArea(2u, UiTextAreaScrollLifetimeSmallOptions()));
    ASSERT_GT(self.m_state.scroll().y, 0.0f);
    ASSERT_TRUE(self.wheel(1.0));
    const u64 revision = self.m_model.revision();
    const u64 external = self.m_model.externalRevision();
    ASSERT_TRUE(self.m_model.setText(self.denseView()));
    const UiTextAreaModelSnapshot replaced = UiTextAreaModelSnapshot(self.m_model);
    EXPECT_EQ(self.m_model.revision(), revision);
    EXPECT_GT(self.m_model.externalRevision(), external);
    ASSERT_TRUE(self.frameArea(3u, UiTextAreaScrollLifetimeSmallOptions()));
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().y), self.m_state.scrollbars().vertical.maximum, 0.001);
    ExpectUiTextAreaScrollLifetimeModel(self, self.m_model, replaced);
    const f32 maximum = self.m_state.scroll().y;
    ASSERT_TRUE(self.wheel(1.0));
    ASSERT_TRUE(self.frameArea(4u, UiTextAreaScrollLifetimeSmallOptions()));
    EXPECT_LT(self.m_state.scroll().y, maximum);
    ExpectUiTextAreaScrollLifetimeModel(self, self.m_model, replaced);

    ASSERT_TRUE(self.m_model.setSelection(0u, 0u));
    ASSERT_TRUE(self.m_state.scrollTo(Point()));
    ASSERT_TRUE(self.frameArea(5u, UiTextAreaScrollLifetimeSmallOptions()));
    ASSERT_TRUE(self.wheel());
    const UiTextAreaModelSnapshot original = UiTextAreaModelSnapshot(self.m_model);
    EditModel replacement = EditModel(self.m_arena, EditLimits(), EditTextMode::Multiline);
    ASSERT_TRUE(replacement.setText(self.denseView()));
    ASSERT_TRUE(replacement.setSelection(0u, 0u));
    const UiTextAreaModelSnapshot rebound = UiTextAreaModelSnapshot(replacement);
    ASSERT_TRUE(self.beginArea(6u));
    ASSERT_TRUE(self.m_builder.textArea(s_UiTextScrollAreaKey, replacement, self.m_state, UiTextAreaScrollLifetimeSmallOptions()).valid);
    ASSERT_TRUE(self.acceptArea());
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
    ExpectUiTextAreaScrollLifetimeModel(self, self.m_model, original);
    ExpectUiTextAreaScrollLifetimeModel(self, replacement, rebound);
    ASSERT_TRUE(self.wheel());
    ASSERT_TRUE(self.beginArea(7u));
    ASSERT_TRUE(self.m_builder.textArea(s_UiTextScrollAreaKey, replacement, self.m_state, UiTextAreaScrollLifetimeSmallOptions()).valid);
    ASSERT_TRUE(self.acceptArea());
    EXPECT_GT(self.m_state.scroll().y, 0.0f);
    ExpectUiTextAreaScrollLifetimeModel(self, self.m_model, original);
    ExpectUiTextAreaScrollLifetimeModel(self, replacement, rebound);
}

void VerifyUiTextAreaScrollLifetimeTests_ActualViewportResizeRetiresWheelWithUnchangedOptions(mut UiTextAreaScrollLifetimeTests self){
    TextAreaOptions options = UiTextAreaScrollLifetimeSmallOptions();
    options.width = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
    const Rect narrow = Rect(20.0f, 20.0f, 240.0f, 160.0f);
    const Rect wider = Rect(20.0f, 20.0f, 320.0f, 160.0f);
    ASSERT_TRUE(self.prepareOverflow(1u, options, narrow));
    const UiTextAreaModelSnapshot model = UiTextAreaModelSnapshot(self.m_model);
    const Rect accepted = self.m_state.scrollbars().viewport;
    const u64 revision = self.m_state.revision();
    ASSERT_TRUE(self.wheel());
    ASSERT_TRUE(self.beginArea(2u, wider));
    ASSERT_TRUE(self.m_builder.textArea(s_UiTextScrollAreaKey, self.m_model, self.m_state, options).valid);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
    ASSERT_TRUE(self.acceptArea());
    EXPECT_GT(self.m_state.scrollbars().viewport.width, accepted.width);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
    EXPECT_EQ(self.m_state.revision(), revision);
    ExpectUiTextAreaScrollLifetimeModel(self, self.m_model, model);
    ASSERT_TRUE(self.wheel());
    ASSERT_TRUE(self.frameArea(3u, options, wider));
    EXPECT_GT(self.m_state.scroll().y, 0.0f);
    ExpectUiTextAreaScrollLifetimeModel(self, self.m_model, model);
}

void VerifyUiTextAreaScrollLifetimeTests_ChangedWheelLinesRetiresTheCopiedStepAndAcceptsItsNewPolicy(mut UiTextAreaScrollLifetimeTests self){
    ASSERT_TRUE(self.prepareOverflow());
    const UiTextAreaModelSnapshot model = UiTextAreaModelSnapshot(self.m_model);
    const auto oldHost = self.tryTarget(self.id("area", "panel"));
    ASSERT_TRUE(oldHost.has_value());
    const f64 oldStep = oldHost.value().scrollStep;
    ASSERT_GT(oldStep, 0.0);
    ASSERT_TRUE(self.wheel());
    TextAreaOptions options = UiTextAreaScrollLifetimeSmallOptions();
    options.wheelLines = 7.0f;
    ASSERT_TRUE(self.frameArea(2u, options));
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
    ExpectUiTextAreaScrollLifetimeModel(self, self.m_model, model);
    const auto newHost = self.tryTarget(self.id("area", "panel"));
    ASSERT_TRUE(newHost.has_value());
    const f64 newStep = newHost.value().scrollStep;
    EXPECT_GT(newStep, oldStep);
    ASSERT_TRUE(self.wheel());
    ASSERT_TRUE(self.frameArea(3u, options));
    EXPECT_GT(self.m_state.scroll().y, cast<f32>(oldStep));
    ExpectUiTextAreaScrollLifetimeModel(self, self.m_model, model);
}

void VerifyUiTextAreaScrollLifetimeTests_ClosingAnAncestorRetiresWheelAndCaptureBeforeFreshPopupReuse(mut UiTextAreaScrollLifetimeTests self){
    ASSERT_TRUE(self.seedModel());
    self.m_parent.open();
    self.m_child.open();
    ASSERT_TRUE(self.popupFrame(1u));
    const UiTextAreaModelSnapshot model = UiTextAreaModelSnapshot(self.m_model);
    ASSERT_TRUE(self.wheel());
    ASSERT_TRUE(self.startThumb(self.popupArea()));
    const Point release = CenterUiRect(self.m_state.scrollbars().vertical.thumb);
    ASSERT_TRUE(self.begin(2u));
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiTextScrollParentPopupKey, self.m_parent, UiTextScrollLargeLoanParentOptions()));
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiTextScrollChildPopupKey, self.m_child, UiTextScrollLargeLoanChildOptions()));
    ASSERT_TRUE(self.m_builder.textArea(s_UiTextScrollAreaKey, self.m_model, self.m_state, UiTextAreaScrollLifetimeSmallOptions()).valid);
    ASSERT_TRUE(self.m_builder.endPopup());
    self.m_parent.close();
    ASSERT_TRUE(self.m_builder.endPopup());
    ASSERT_TRUE(self.m_context.endRoot());
    ASSERT_TRUE(self.m_context.finishFrame());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_FALSE(self.m_context.input().capture().valid());
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
    EXPECT_TRUE(self.send(MakeUiTextScrollPointerEvent(release, InputEventType::PrimaryUp)).pointerConsumed);
    ExpectUiTextAreaScrollLifetimeModel(self, self.m_model, model);
    self.m_parent.open();
    ASSERT_TRUE(self.begin(3u));
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiTextScrollParentPopupKey, self.m_parent, UiTextScrollLargeLoanParentOptions()));
    EXPECT_FALSE(self.m_builder.beginPopup(s_UiTextScrollChildPopupKey, self.m_child, UiTextScrollLargeLoanChildOptions()));
    EXPECT_FALSE(self.m_child.isOpen());
    ASSERT_TRUE(self.m_builder.endPopup());
    ASSERT_TRUE(self.m_context.endRoot());
    ASSERT_TRUE(self.m_context.finishFrame());
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    self.m_child.open();
    ASSERT_TRUE(self.popupFrame(4u));
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
    ASSERT_TRUE(self.wheel());
    ASSERT_TRUE(self.popupFrame(5u));
    EXPECT_GT(self.m_state.scroll().y, 0.0f);
    ExpectUiTextAreaScrollLifetimeModel(self, self.m_model, model);
}

void VerifyUiTextAreaScrollLifetimeTests_CaptureLossCancelsTheUnfinishedThumbAndPreservesCompletedWheel(mut UiTextAreaScrollLifetimeTests self){
    ASSERT_TRUE(self.prepareOverflow());
    const UiTextAreaModelSnapshot model = UiTextAreaModelSnapshot(self.m_model);
    ASSERT_TRUE(self.wheel());
    ASSERT_TRUE(self.startThumb(self.id(s_UiTextScrollAreaKey, s_UiTextScrollPanelKey)));
    EXPECT_FALSE(self.send(MakeUiTextScrollPointerEvent(Point(), InputEventType::PointerCaptureLost)).capture.valid());
    ASSERT_TRUE(self.frameArea(2u, UiTextAreaScrollLifetimeSmallOptions()));
    ASSERT_GT(self.m_state.scroll().y, 0.0f);
    const f32 wheelOnly = self.m_state.scroll().y;
    ExpectUiTextAreaScrollLifetimeModel(self, self.m_model, model);
    ASSERT_TRUE(self.m_state.scrollTo(Point()));
    ASSERT_TRUE(self.frameArea(3u, UiTextAreaScrollLifetimeSmallOptions()));
    ASSERT_TRUE(self.wheel());
    ASSERT_TRUE(self.frameArea(4u, UiTextAreaScrollLifetimeSmallOptions()));
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, wheelOnly);
    ExpectUiTextAreaScrollLifetimeModel(self, self.m_model, model);
}

void VerifyUiTextAreaScrollLifetimeTests_NativeFocusLossCancelsCopiedWheelAndAnActiveThumb(mut UiTextAreaScrollLifetimeTests self){
    ASSERT_TRUE(self.prepareOverflow());
    const UiTextAreaModelSnapshot model = UiTextAreaModelSnapshot(self.m_model);
    ASSERT_TRUE(self.wheel());
    ASSERT_TRUE(self.startThumb(self.id(s_UiTextScrollAreaKey, s_UiTextScrollPanelKey)));
    EXPECT_FALSE(self.send(MakeUiTextScrollPointerEvent(Point(), InputEventType::FocusLost)).wantsCommands);
    ASSERT_TRUE(self.frameArea(2u, UiTextAreaScrollLifetimeSmallOptions()));
    EXPECT_FALSE(self.m_context.input().capture().valid());
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
    ExpectUiTextAreaScrollLifetimeModel(self, self.m_model, model);
    EXPECT_FALSE(self.send(MakeUiTextScrollPointerEvent(Point(), InputEventType::FocusGained)).wantsCommands);
    ASSERT_TRUE(self.wheel());
    ASSERT_TRUE(self.frameArea(3u, UiTextAreaScrollLifetimeSmallOptions()));
    EXPECT_GT(self.m_state.scroll().y, 0.0f);
    ExpectUiTextAreaScrollLifetimeModel(self, self.m_model, model);
}

void VerifyUiTextAreaScrollLifetimeTests_DisablingRetiresPendingWheelAndThumbWithoutReplayingOnEnable(mut UiTextAreaScrollLifetimeTests self){
    ASSERT_TRUE(self.prepareOverflow());
    const UiTextAreaModelSnapshot model = UiTextAreaModelSnapshot(self.m_model);
    ASSERT_TRUE(self.wheel());
    ASSERT_TRUE(self.startThumb(self.id(s_UiTextScrollAreaKey, s_UiTextScrollPanelKey)));
    const Point release = CenterUiRect(self.m_state.scrollbars().vertical.thumb);
    TextAreaOptions disabled = UiTextAreaScrollLifetimeSmallOptions();
    disabled.enabled = false;
    ASSERT_TRUE(self.frameArea(2u, disabled));
    EXPECT_FALSE(self.m_context.input().capture().valid());
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
    EXPECT_TRUE(self.send(MakeUiTextScrollPointerEvent(release, InputEventType::PrimaryUp)).pointerConsumed);
    ExpectUiTextAreaScrollLifetimeModel(self, self.m_model, model);
    ASSERT_TRUE(self.frameArea(3u, UiTextAreaScrollLifetimeSmallOptions()));
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
    ASSERT_TRUE(self.wheel());
    ASSERT_TRUE(self.frameArea(4u, UiTextAreaScrollLifetimeSmallOptions()));
    EXPECT_GT(self.m_state.scroll().y, 0.0f);
    ExpectUiTextAreaScrollLifetimeModel(self, self.m_model, model);
}


