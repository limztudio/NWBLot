void VerifyTelemetry_RegistryOwnsLabelsFromContributorCallbacks(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryCaptureSession session = TelemetryCaptureSession(testArena.arena);
    session.setCaptureOptions(CaptureFrameGraphOnly());
    FrameGraphRegistry registry = FrameGraphRegistry(testArena.arena);
    LocalLabelContributor contributor = LocalLabelContributor();
    RegisterTestContributor(registry, contributor);
    ASSERT_TRUE(RecordRegistryFrameGraph(registry, session));
    const Expected<FrameGraphPayload> parsed = ParseFrameGraphEventAt(testArena.arena, testArena.scratchArena, session.view(), 0u);
    ASSERT_TRUE(parsed.has_value());
    ASSERT_EQ(parsed.value().nodes.size(), 1u);
    EXPECT_EQ(parsed.value().nodes[0u].label, "local label");
}

void VerifyTelemetry_RegistryDefersAddedContributorsAndSkipsRemovedOnes(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryCaptureSession session = TelemetryCaptureSession(testArena.arena);
    session.setCaptureOptions(CaptureFrameGraphOnly());
    FrameGraphRegistry registry = FrameGraphRegistry(testArena.arena);
    MutatingContributor first = MutatingContributor(registry);
    MutatingContributor removed = MutatingContributor(registry);
    MutatingContributor last = MutatingContributor(registry);
    MutatingContributor added = MutatingContributor(registry);
    first.removeSelf = true;
    first.setRemoveOther(removed);
    first.setAddOther(added);
    RegisterTestContributor(registry, first);
    RegisterTestContributor(registry, removed);
    RegisterTestContributor(registry, last);

    ASSERT_TRUE(RecordRegistryFrameGraph(registry, session));
    EXPECT_EQ(first.calls, 1u);
    EXPECT_EQ(removed.calls, 0u);
    EXPECT_EQ(last.calls, 1u);
    EXPECT_EQ(added.calls, 0u);
    ASSERT_TRUE(RecordRegistryFrameGraph(registry, session));
    EXPECT_EQ(first.calls, 1u);
    EXPECT_EQ(removed.calls, 0u);
    EXPECT_EQ(last.calls, 2u);
    EXPECT_EQ(added.calls, 1u);
}

void VerifyTelemetry_RegistryKeepsLabelsAfterRemovedContributorIsDestroyed(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryCaptureSession session = TelemetryCaptureSession(testArena.arena);
    session.setCaptureOptions(CaptureFrameGraphOnly());
    FrameGraphRegistry registry = FrameGraphRegistry(testArena.arena);
    b8 firstDestroyed = false;
    native(mut testArena, mut session, mut registry, mut firstDestroyed){
        Optional<OwnedLabelContributor> first;
        first.emplace(registry, testArena.arena);
        DestroyContributor destroyer(first);
        registry.registerContributor(first.value());
        registry.registerContributor(destroyer);
        ASSERT_TRUE(registry.record(session));
        firstDestroyed = !first.has_value();
    }
    EXPECT_TRUE(firstDestroyed);
    const Expected<FrameGraphPayload> parsed = ParseFrameGraphEventAt(testArena.arena, testArena.scratchArena, session.view(), 0u);
    ASSERT_TRUE(parsed.has_value());
    ASSERT_EQ(parsed.value().nodes.size(), 2u);
    EXPECT_EQ(parsed.value().nodes[0u].label, "label retained after contributor destruction");
}

void VerifyTelemetry_RegistryClearDuringCallbackSkipsRemainingContributors(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryCaptureSession session = TelemetryCaptureSession(testArena.arena);
    session.setCaptureOptions(CaptureFrameGraphOnly());
    FrameGraphRegistry registry = FrameGraphRegistry(testArena.arena);
    MutatingContributor first = MutatingContributor(registry);
    MutatingContributor skipped = MutatingContributor(registry);
    MutatingContributor added = MutatingContributor(registry);
    first.clearRegistry = true;
    first.setAddOther(added);
    RegisterTestContributor(registry, first);
    RegisterTestContributor(registry, skipped);

    ASSERT_TRUE(RecordRegistryFrameGraph(registry, session));
    EXPECT_EQ(first.calls, 1u);
    EXPECT_EQ(skipped.calls, 0u);
    EXPECT_EQ(added.calls, 0u);
    ASSERT_TRUE(RecordRegistryFrameGraph(registry, session));
    EXPECT_EQ(first.calls, 1u);
    EXPECT_EQ(skipped.calls, 0u);
    EXPECT_EQ(added.calls, 1u);
}

void VerifyTelemetry_RegistryCanRemoveAndReregisterTheCurrentContributor(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryCaptureSession session = TelemetryCaptureSession(testArena.arena);
    session.setCaptureOptions(CaptureFrameGraphOnly());
    FrameGraphRegistry registry = FrameGraphRegistry(testArena.arena);
    MutatingContributor contributor = MutatingContributor(registry);
    contributor.removeSelf = true;
    contributor.setAddOther(contributor);
    RegisterTestContributor(registry, contributor);
    ASSERT_TRUE(RecordRegistryFrameGraph(registry, session));
    EXPECT_EQ(contributor.calls, 1u);
    ASSERT_TRUE(RecordRegistryFrameGraph(registry, session));
    EXPECT_EQ(contributor.calls, 2u);
}

void VerifyTelemetry_RegistryAppliesCallbackMutationsAfterUnwind(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryCaptureSession session = TelemetryCaptureSession(testArena.arena);
    session.setCaptureOptions(CaptureFrameGraphOnly());
    FrameGraphRegistry registry = FrameGraphRegistry(testArena.arena);
    MutatingContributor first = MutatingContributor(registry);
    MutatingContributor skipped = MutatingContributor(registry);
    MutatingContributor added = MutatingContributor(registry);
    first.removeSelf = true;
    first.setRemoveOther(skipped);
    first.setAddOther(added);
    first.throwAfterMutation = true;
    RegisterTestContributor(registry, first);
    RegisterTestContributor(registry, skipped);
    native(mut registry, mut session){
        EXPECT_THROW(EXPECT_TRUE(registry.record(session)), ContributionFailure);
    }
    EXPECT_EQ(session.eventCount(), 0u);
    ASSERT_TRUE(RecordRegistryFrameGraph(registry, session));
    EXPECT_EQ(first.calls, 1u);
    EXPECT_EQ(skipped.calls, 0u);
    EXPECT_EQ(added.calls, 1u);
}

void VerifyTelemetry_RegistryClearsBorrowedDescriptorsAfterUnwindAndReusesGraphCapacity(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryCaptureSession session = TelemetryCaptureSession(testArena.arena);
    session.setCaptureOptions(CaptureFrameGraphOnly());
    FrameGraphRegistry registry = FrameGraphRegistry(testArena.arena);
    const StringView replacementLabel = "replacement label after unwind";
    b8 reentryRejected = false;
    native(mut testArena, mut session, mut registry, in replacementLabel, mut reentryRejected){
        AString<Core::Telemetry::TelemetryArena> label("first borrowed label", testArena.arena);
        CacheLifetimeContributor contributor(registry, session, label);
        registry.registerContributor(contributor);
        EXPECT_THROW(EXPECT_TRUE(registry.record(session)), ContributionFailure);
        EXPECT_EQ(session.eventCount(), 0u);

        label.assign(replacementLabel.data(), replacementLabel.size());
        ASSERT_TRUE(registry.record(session));
        reentryRejected = contributor.m_reentryRejected;
    }
    EXPECT_TRUE(reentryRejected);
    const Expected<FrameGraphPayload> parsed = ParseFrameGraphEventAt(testArena.arena, testArena.scratchArena, session.view(), 0u);
    ASSERT_TRUE(parsed.has_value());
    ASSERT_EQ(parsed.value().nodes.size(), 1u);
    EXPECT_EQ(parsed.value().nodes[0u].label, replacementLabel);
}

void VerifyTelemetry_PendingNameEdgesChooseFirstDuplicateAndOmitMissingTargets(){
