////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const i32 s_CsgBoundsValidFlag = 1;
const i32 s_CsgBoundsFiniteFlag = 2;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class CsgBoundsGpuData{
    public f32x3_i32 minBounds(0.0f, 0.0f, 0.0f, 0);
    public f32x3_i32 maxBounds(0.0f, 0.0f, 0.0f, 0);

    public bool valid()const{
        return (this.minBounds.w & s_CsgBoundsValidFlag) != 0;
    }

    public bool finite()const{
        return (this.minBounds.w & s_CsgBoundsFiniteFlag) != 0;
    }
}

type CsgReceiverCpuBounds = CsgBoundsGpuData;

bool CsgReceiverBoundsCanCull(in CsgReceiverCpuBounds bounds){
    return bounds.valid() && bounds.finite();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// CSG context is one global UniformBuffer entry; no pass binds it locally.
class CsgClipContextSlots{
    public u32 receiverRanges = 0u;
    public u32 cutters = 0u;
    public u32 materialTyped = 0u;
    public u32 meshInstances = 0u;
    public u32 deferredBindlessResources = 0u;
    public u32 intervalSampleState = 0u;
    public u32 padding0 = 0u;
    public u32 padding1 = 0u;
}

// Interval-sampling payload via CsgClipContextSlots; immutable frame blob when active.
class CsgIntervalSampleStateGpuData{
    public u32 workMinX = 0u;
    public u32 workMinY = 0u;
    public u32 workMaxX = 0u;
    public u32 workMaxY = 0u;
    public u32 meshViewHeapSlot = 0u;
    public u32 resourceSlotPadding0 = 0u;
    public u32 resourceSlotPadding1 = 0u;
    public u32 resourceSlotPadding2 = 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class CsgReceiverClipDrawInfo{
    public Name evaluatorVariant;
    public u32 cutterCount = 0u;
}


