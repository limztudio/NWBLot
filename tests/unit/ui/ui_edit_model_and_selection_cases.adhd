    ASSERT_TRUE(self.m_model.selectAll());
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("x", 0u, 1u));
    ASSERT_TRUE(self.m_model.setText("reset"));
    EXPECT_EQ(self.m_model.text(), "reset");
    EXPECT_EQ(self.m_model.caret(), 5u);
    EXPECT_FALSE(self.m_model.hasSelection());
    EXPECT_FALSE(self.m_model.composition().active);
    EXPECT_FALSE(self.m_model.canUndo());
}


