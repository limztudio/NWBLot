NWB_ADHD_GTEST(CooperativeVectorFeatureQuery, EmptyDriverPropertyListDoesNotReadOrPublishFormats, VerifyCooperativeVectorFeatureQuery_EmptyDriverPropertyListDoesNotReadOrPublishFormats)
NWB_ADHD_GTEST(CooperativeVectorMatrixPolicy, RejectsTightMisalignedAndOverflowingStrides, VerifyCooperativeVectorMatrixPolicy_RejectsTightMisalignedAndOverflowingStrides)
NWB_ADHD_GTEST(CooperativeVectorMatrixStride, FailsClosedForInvalidOrDriverOptimalInputs, VerifyCooperativeVectorMatrixStride_FailsClosedForInvalidOrDriverOptimalInputs)
NWB_ADHD_GTEST(CooperativeVectorMatrixStride, DoesNotWrapLargestPublicDimension, VerifyCooperativeVectorMatrixStride_DoesNotWrapLargestPublicDimension)
NWB_ADHD_GTEST(DeviceCreationPolicy, SurfacePolicyKeepsFallbackOrderAndRejectsMissingAlpha, VerifyDeviceCreationPolicy_SurfacePolicyKeepsFallbackOrderAndRejectsMissingAlpha)
NWB_ADHD_GTEST(DeviceCreationPolicy, QueueRegistrationRejectsBoundaryAndDuplicateIdentity, VerifyDeviceCreationPolicy_QueueRegistrationRejectsBoundaryAndDuplicateIdentity)
NWB_ADHD_GTEST(DeviceCreationPolicy, QueueSharingUsesFirstDistinctFamilyAndHandlesMissingPrimary, VerifyDeviceCreationPolicy_QueueSharingUsesFirstDistinctFamilyAndHandlesMissingPrimary)
NWB_ADHD_GTEST(DeviceCreationPolicy, CanonicalQueuesRejectAliasedHandlesAndOutOfRangeIndices, VerifyDeviceCreationPolicy_CanonicalQueuesRejectAliasedHandlesAndOutOfRangeIndices)
NWB_ADHD_GTEST(DeviceCreationPolicy, QueuePlanKeepsCrossFamilyOrderAndStablePriorities, VerifyDeviceCreationPolicy_QueuePlanKeepsCrossFamilyOrderAndStablePriorities)
NWB_ADHD_GTEST(DeviceCreationPolicy, RejectsUnknownHardwareRayTracingPolicy, VerifyDeviceCreationPolicy_RejectsUnknownHardwareRayTracingPolicy)
NWB_ADHD_GTEST(PresentationReceipt, RejectedAttemptCannotBeQualifiedByALaterDifferentSuccessfulFrame, VerifyPresentationReceipt_RejectedAttemptCannotBeQualifiedByALaterDifferentSuccessfulFrame)
NWB_ADHD_GTEST(PresentationReceipt, ImageReuseRequiresItsNewAcquisitionTimelineIdentity, VerifyPresentationReceipt_ImageReuseRequiresItsNewAcquisitionTimelineIdentity)
NWB_ADHD_GTEST(PresentationReceipt, EqualTimelineValuesOnDifferentQueuesDevicesOrImagesDoNotMatch, VerifyPresentationReceipt_EqualTimelineValuesOnDifferentQueuesDevicesOrImagesDoNotMatch)
NWB_ADHD_GTEST(PresentationReceipt, InvalidTokensAndImageStatesNeverPublishEvidence, VerifyPresentationReceipt_InvalidTokensAndImageStatesNeverPublishEvidence)
NWB_ADHD_GTEST(PresentationReceipt, UnknownInitialStateIsAValidDistinctAcquisitionState, VerifyPresentationReceipt_UnknownInitialStateIsAValidDistinctAcquisitionState)
NWB_ADHD_GTEST(PresentationReceipt, ResetAtLifetimeBoundaryRemovesEarlierAcquisitionEvidence, VerifyPresentationReceipt_ResetAtLifetimeBoundaryRemovesEarlierAcquisitionEvidence)


