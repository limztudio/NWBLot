#include <@entry_header@>
#include <core/common/application_entry.h>
#include <core/common/cli/tool_cli.h>
#include <logger/client/module.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace{

i32 Run(const i32 argc, char** argv){
    try{
        return @entry_function@(::NWB::Core::Common::ConsoleArguments{ argc, argv });
    }
    catch(...){
        return @entry_failure@;
    }
}

}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_DEFINE_CONSOLE_TOOL_ENTRY_POINT(NWB::Log::ClientStandalone, FOUNDATION_TEXT("@entry_label@"), @entry_failure@, Run)


