[cpp_name("::NWB::Impl::RendererMaterialSystem")]
extern class RendererMaterialSystem;
[cpp_name("::NWB::Impl::RendererCsgSystem")]
extern class RendererCsgSystem;
[cpp_name("::NWB::Impl::RendererAvboitSystem")]
extern class RendererAvboitSystem;
[cpp_name("::NWB::Impl::TransparentCsgIntervalProducerInputs")]
extern class TransparentCsgIntervalProducerInputs;
[cpp_name("::NWB::Impl::RendererTaskGraphDetail::AvboitPreGraphTask::Payload")]
extern class AvboitPreGraphTaskPayload;
[cpp_name("::NWB::Impl::ECSRenderDetail::AvboitCsgReceiverSpanGraphTask::Payload")]
extern class AvboitCsgReceiverSpanGraphTaskPayload;
[cpp_name("::NWB::Impl::ECSRenderDetail::AvboitCsgIntervalCombineGraphTask::Payload")]
extern class AvboitCsgIntervalCombineGraphTaskPayload;
[cpp_name("::NWB::Impl::GraphClearTimingRecordState")]
extern class GraphClearTimingRecordState;

[modular]
class TransparentCsgIntervalBuilder : NoCopy{
    private mut GpuTaskGraph m_graph;
    private mut RendererMaterialSystem m_materialSystem;
    private mut RendererCsgSystem m_csgSystem;
    private mut RendererAvboitSystem m_avboitSystem;

    public TransparentCsgIntervalBuilder(
        mut GpuTaskGraph graph,
        mut RendererMaterialSystem materialSystem,
        mut RendererCsgSystem csgSystem,
        mut RendererAvboitSystem avboitSystem
    ){
        this.m_graph = graph;
        this.m_materialSystem = materialSystem;
        this.m_csgSystem = csgSystem;
        this.m_avboitSystem = avboitSystem;
    }

    public Expected<TransparentCsgIntervalProducerResult> declare(
        mut ScratchArena scratchArena,
        in TransparentCsgIntervalProducerInputs inputs,
        mut AvboitPreGraphTaskPayload avboitPrePayload,
        mut AvboitCsgReceiverSpanGraphTaskPayload receiverSpanPayload,
        mut AvboitCsgIntervalCombineGraphTaskPayload intervalCombinePayload,
        mut GraphClearTimingRecordState intervalClearTimingState
    );
}


