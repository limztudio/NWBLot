////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_mesh/payload_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const usize s_ManifoldEdgeTriangleCount = 2u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TriangleEdge{
    public u64 positions = 0u;
    public u32 triangle = 0u;
    public b8 forward = false;
}

class SolidTopologyCache{
    public usize vertexCount = 0u;
    public usize triangleCount = 0u;
    public Vector<u32> parents;
    public Vector<u8> staticInvalidComponents;
    public b8 hasAnyPotentiallySolidComponent = false;
    public b8 valid = false;
}

class SolidTopologyScratch{
    public Vector<u8> invalidComponents;
    public Vector<f64> componentVolumes;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


TriangleEdge MakeTriangleEdge(in u32 first, in u32 second, in u32 triangle){
    TriangleEdge edge;
    edge.positions = PackUnorderedU32Pair(first, second);
    edge.triangle = triangle;
    edge.forward = first < second;
    return edge;
}

b8 EqualDoubleLaneProducts(in VectorDouble lhs, in VectorDouble rhs){
    const VectorDouble products = lhs * rhs;
    return products.x == products.y;
}

b8 DegenerateTriangle(in VectorDouble a, in VectorDouble b, in VectorDouble c){
    const VectorDouble ab = b - a;
    const VectorDouble ac = c - a;
    return
        EqualDoubleLaneProducts(ab.yzww, ac.zyww)
        && EqualDoubleLaneProducts(ab.zxww, ac.xzww)
        && EqualDoubleLaneProducts(ab.xyww, ac.yxww)
    ;
}

f64 RelativeTriangleVolume(in VectorDouble a, in VectorDouble b, in VectorDouble c, in VectorDouble origin){
    return Dot((a - origin).xyz, Cross((b - origin).xyz, (c - origin).xyz));
}

b8 AreAllMeshPositionsFinite(in Span<f32x3u> positions){
    for(in f32x3u position : positions){
        if(!IsFinite(VectorSingle(position)))
            return false;
    }
    return true;
}

u32 FindMeshTopologyComponent(in u32 triangle, mut Vector<u32> inOutParents){
    u32 current = triangle;
    while(inOutParents[cast<usize>(current)] != current){
        const u32 parent = inOutParents[cast<usize>(current)];
        inOutParents[cast<usize>(current)] = inOutParents[cast<usize>(parent)];
        current = inOutParents[cast<usize>(current)];
    }
    return current;
}

void JoinMeshTopologyComponents(
    in u32 first,
    in u32 second,
    mut Vector<u32> inOutParents,
    mut Vector<u8> inOutRanks
){
    u32 firstRoot = FindMeshTopologyComponent(first, inOutParents);
    u32 secondRoot = FindMeshTopologyComponent(second, inOutParents);
    if(firstRoot == secondRoot)
        return;
    if(inOutRanks[cast<usize>(firstRoot)] < inOutRanks[cast<usize>(secondRoot)]){
        const u32 temp = firstRoot;
        firstRoot = secondRoot;
        secondRoot = temp;
    }
    inOutParents[cast<usize>(secondRoot)] = firstRoot;
    if(inOutRanks[cast<usize>(firstRoot)] == inOutRanks[cast<usize>(secondRoot)])
        ++inOutRanks[cast<usize>(firstRoot)];
}

void CompressMeshTopologyParents(mut Vector<u32> inOutParents){
    for(u32 triangle = 0u; triangle < cast<u32>(inOutParents.size()); ++triangle){
        u32 root = triangle;
        while(inOutParents[cast<usize>(root)] != root)
            root = inOutParents[cast<usize>(root)];
        u32 current = triangle;
        while(current != root){
            const u32 next = inOutParents[cast<usize>(current)];
            inOutParents[cast<usize>(current)] = root;
            current = next;
        }
    }
}

void RadixSortTriangleEdges(mut Vector<TriangleEdge> inOutEdges, in u64 xorDiff){
    const usize count = inOutEdges.size();
    Vector<TriangleEdge> scratch;
    scratch.resize(count);
    Array<usize, 256u> counts;
    b8 inScratch = false;
    for(u32 pass = 0u; pass < 8u; ++pass){
        const u32 shift = pass * 8u;
        if(((xorDiff >> shift) & 0xffu) == 0u)
            continue;
        for(usize bucket = 0u; bucket < 256u; ++bucket)
            counts[bucket] = 0u;
        if(!inScratch){
            for(in TriangleEdge edge : inOutEdges)
                ++counts[cast<usize>((edge.positions >> shift) & 0xffu)];
        }
        else{
            for(in TriangleEdge edge : scratch)
                ++counts[cast<usize>((edge.positions >> shift) & 0xffu)];
        }
        usize runningOffset = 0u;
        for(usize bucket = 0u; bucket < 256u; ++bucket){
            const usize c = counts[bucket];
            counts[bucket] = runningOffset;
            runningOffset += c;
        }
        if(!inScratch){
            for(in TriangleEdge edge : inOutEdges){
                const usize bucket = cast<usize>((edge.positions >> shift) & 0xffu);
                scratch[counts[bucket]++] = edge;
            }
        }
        else{
            for(in TriangleEdge edge : scratch){
                const usize bucket = cast<usize>((edge.positions >> shift) & 0xffu);
                inOutEdges[counts[bucket]++] = edge;
            }
        }
        inScratch = !inScratch;
    }
    if(inScratch)
        AssignTriviallyCopyableVector(inOutEdges, Span<TriangleEdge>(scratch));
}

void SortTriangleEdgesByPositions(mut Vector<TriangleEdge> inOutEdges){
    const usize count = inOutEdges.size();
    if(count < 256u){
        SortSequence<TriangleEdge>(inOutEdges, lambda[](in TriangleEdge lhs, in TriangleEdge rhs) -> b8{
            return lhs.positions < rhs.positions;
        });
        return;
    }

    u64 xorDiff = 0u;
    const u64 firstKey = inOutEdges[0u].positions;
    for(in TriangleEdge edge : inOutEdges)
        xorDiff |= edge.positions ^ firstKey;
    if(xorDiff == 0u)
        return;

    RadixSortTriangleEdges(inOutEdges, xorDiff);
}

b8 PrepareSolidTopologyCache(
    in usize vertexCount,
    in Span<u32> triangleIndices,
    mut SolidTopologyCache outCache
){
    outCache.valid = false;
    outCache.hasAnyPotentiallySolidComponent = false;
    if(triangleIndices.empty() || (triangleIndices.size() % cast<usize>(s_MeshletTriangleIndexCount)) != 0u)
        return false;
    const usize triangleCount = triangleIndices.size() / cast<usize>(s_MeshletTriangleIndexCount);
    if(triangleCount > cast<usize>(u32.max))
        return false;

    outCache.parents.resize(triangleCount);
    Vector<u8> ranks;
    ranks.assign(triangleCount, 0u);
    Vector<u8> invalidTriangles;
    invalidTriangles.assign(triangleCount, 0u);
    Vector<TriangleEdge> edges;
    edges.clear();
    edges.reserve(triangleIndices.size());

    for(u32 triangle = 0u; triangle < cast<u32>(triangleCount); ++triangle){
        outCache.parents[cast<usize>(triangle)] = triangle;
        const usize base = cast<usize>(triangle) * cast<usize>(s_MeshletTriangleIndexCount);
        const u32 a = triangleIndices[base];
        const u32 b = triangleIndices[base + 1u];
        const u32 c = triangleIndices[base + 2u];
        if(
            cast<usize>(a) >= vertexCount
            || cast<usize>(b) >= vertexCount
            || cast<usize>(c) >= vertexCount
        )
            return false;
        if(a == b || b == c || c == a)
            invalidTriangles[cast<usize>(triangle)] = 1u;
        for(u32 corner = 0u; corner < s_MeshletTriangleIndexCount; ++corner){
            const u32 first = triangleIndices[base + cast<usize>(corner)];
            const u32 second = triangleIndices[base + cast<usize>((corner + 1u) % s_MeshletTriangleIndexCount)];
            edges.push_back(MakeTriangleEdge(first, second, triangle));
        }
    }

    SortTriangleEdgesByPositions(edges);

    usize first = 0u;
    while(first < edges.size()){
        usize end = first + 1u;
        while(end < edges.size() && edges[end].positions == edges[first].positions)
            ++end;
        const b8 validEdge = (end - first) == s_ManifoldEdgeTriangleCount && edges[first].forward != edges[first + 1u].forward;
        for(usize index = first; index < end; ++index){
            JoinMeshTopologyComponents(edges[first].triangle, edges[index].triangle, outCache.parents, ranks);
            if(!validEdge)
                invalidTriangles[cast<usize>(edges[index].triangle)] = 1u;
        }
        first = end;
    }

    CompressMeshTopologyParents(outCache.parents);

    outCache.staticInvalidComponents.assign(triangleCount, 0u);
    for(u32 triangle = 0u; triangle < cast<u32>(triangleCount); ++triangle){
        if(invalidTriangles[cast<usize>(triangle)] != 0u)
            outCache.staticInvalidComponents[cast<usize>(outCache.parents[cast<usize>(triangle)])] = 1u;
    }
    for(u32 triangle = 0u; triangle < cast<u32>(triangleCount); ++triangle){
        const u32 root = outCache.parents[cast<usize>(triangle)];
        if(outCache.staticInvalidComponents[cast<usize>(root)] == 0u){
            outCache.hasAnyPotentiallySolidComponent = true;
            break;
        }
    }

    outCache.vertexCount = vertexCount;
    outCache.triangleCount = triangleCount;
    outCache.valid = true;
    return true;
}

b8 FinalizeMeshSolidTriangleWordsWithCache(
    in Span<f32x3u> positions,
    in Span<u32> triangleIndices,
    in SolidTopologyCache cache,
    mut SolidTopologyScratch scratch,
    mut Vector<u32> outWords
){
    const usize triangleCount = cache.triangleCount;
    if(
        !cache.valid
        || positions.size() != cache.vertexCount
        || triangleIndices.size() != triangleCount * cast<usize>(s_MeshletTriangleIndexCount)
        || cache.parents.size() != triangleCount
        || cache.staticInvalidComponents.size() != triangleCount
        || !AreAllMeshPositionsFinite(positions)
    )
        return false;

    if(!cache.hasAnyPotentiallySolidComponent){
        outWords.assign(DivideUp(triangleCount, cast<usize>(s_MeshletSolidTriangleWordBits)), 0u);
        return true;
    }

    AssignTriviallyCopyableVector(scratch.invalidComponents, Span<u8>(cache.staticInvalidComponents));
    scratch.componentVolumes.assign(triangleCount, 0.0);

    u32 originComponent = u32.max;
    VectorDouble origin(0.0, 0.0, 0.0, 0.0);
    for(u32 triangle = 0u; triangle < cast<u32>(triangleCount); ++triangle){
        const u32 component = cache.parents[cast<usize>(triangle)];
        if(scratch.invalidComponents[cast<usize>(component)] != 0u)
            continue;
        const usize base = cast<usize>(triangle) * cast<usize>(s_MeshletTriangleIndexCount);
        const VectorDouble va(VectorSingle(positions[cast<usize>(triangleIndices[base])]));
        const VectorDouble vb(VectorSingle(positions[cast<usize>(triangleIndices[base + 1u])]));
        const VectorDouble vc(VectorSingle(positions[cast<usize>(triangleIndices[base + 2u])]));
        if(DegenerateTriangle(va, vb, vc)){
            scratch.invalidComponents[cast<usize>(component)] = 1u;
            continue;
        }
        if(component != originComponent){
            const usize originBase = cast<usize>(component) * cast<usize>(s_MeshletTriangleIndexCount);
            origin = VectorDouble(VectorSingle(positions[cast<usize>(triangleIndices[originBase])]));
            originComponent = component;
        }
        const VectorDouble triangleVolume(RelativeTriangleVolume(va, vb, vc, origin));
        const VectorDouble componentVolume = VectorDouble(scratch.componentVolumes[cast<usize>(component)]) + triangleVolume;
        scratch.componentVolumes[cast<usize>(component)] = componentVolume.x;
    }

    outWords.assign(DivideUp(triangleCount, cast<usize>(s_MeshletSolidTriangleWordBits)), 0u);
    for(u32 triangle = 0u; triangle < cast<u32>(triangleCount); ++triangle){
        const u32 component = cache.parents[cast<usize>(triangle)];
        if(scratch.invalidComponents[cast<usize>(component)] == 0u && scratch.componentVolumes[cast<usize>(component)] != 0.0)
            outWords[cast<usize>(triangle / s_MeshletSolidTriangleWordBits)] |= (1u << (triangle % s_MeshletSolidTriangleWordBits));
    }
    return true;
}

b8 BuildSolidTriangleWordsInto(
    in Span<f32x3u> positions,
    in Span<u32> triangleIndices,
    mut Vector<u32> outWords
){
    SolidTopologyCache cache;
    if(!PrepareSolidTopologyCache(positions.size(), triangleIndices, cache))
        return false;
    SolidTopologyScratch scratch;
    return FinalizeMeshSolidTriangleWordsWithCache(positions, triangleIndices, cache, scratch, outWords);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

