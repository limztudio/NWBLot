const StringView s_CsgShapeOwnerKindLabel = "CSG shape";
const StringView s_CsgShapeEvalFieldLabel = "eval";
const StringView s_MaterialOwnerKindLabel = "material";
const StringView s_MeshSubsystemNonStandaloneKindLabel = "mesh_subsystem";
const StringView s_IncludeNonStandaloneKindLabel = "include";
const StringView s_ShaderNonStandaloneKindLabel = "shader";
const StringView s_ShaderFirstTokenSuffixLabel = "_shader";

b8 ValidateCanonicalPreparedShaderIdentity(
    in Name shaderName,
    in Name stageName,
    in StringView entryName,
    in StringView archiveStage,
    in StringView entryPoint
){
    if(shaderName != s_NameNone && stageName != s_NameNone && !entryPoint.empty())
        return true;

    error("Shader cook failed to canonicalize shader identity for '{}' stage '{}' entry point '{}'", entryName, archiveStage, entryPoint);
    return false;
}

b8 IsBeforeShaderMacroDefinitionName(in StringView lhsName, in StringView rhsName){
    return lhsName < rhsName;
}

b8 ShouldSkipGraphicsVolumePreparation(in b8 hasSelectedGraphicsMetadata, in usize materialEntryCount){
    return !hasSelectedGraphicsMetadata && materialEntryCount == 0u;
}

b8 ValidateMaterialCookRequiresShaderEntries(in usize shaderEntryCount, in usize materialEntryCount){
    if(shaderEntryCount > 0u || materialEntryCount == 0u)
        return true;

    error("GraphicsCook: material assets require at least one shader entry");
    return false;
}

Path BuildShaderVariantBytecodeCachePath(in Path cacheDirectory, in StringView configurationSafeName, in StringView sourceChecksumHex){
    String bytecodeFileName(sourceChecksumHex);
    bytecodeFileName += s_ShaderVariantBytecodeExtension;
    return cacheDirectory / configurationSafeName / bytecodeFileName;
}

ShaderVariantCacheReadStatus ReadCachedShaderVariantBytecode(
    in StringView entryName,
    in StringView entryStage,
    in StringView entryPoint,
    in Path bytecodePath,
    mut Vector<u8> outBytecode
){
    const Expected<void, ErrorCode> read = ReadBinaryFile(bytecodePath, outBytecode);
    if(read.has_value()){
        const Expected<Optional<Name>, NameTextError> stageName = ToName(entryStage);
        if(!stageName.has_value()){
            error("GraphicsCook: shader stage contains an embedded null for entry '{}'", entryName);
            return ShaderVariantCacheReadStatus::Error;
        }
        Name resolvedStage = s_NameNone;
        if(stageName.value().has_value())
            resolvedStage = stageName.value().value();
        const ShaderType shaderType = ShaderTypeFromArchiveStageName(resolvedStage);
        if(ResolveSpirvEntryPointName(outBytecode, entryPoint, ToMask(shaderType)).has_value())
            return ShaderVariantCacheReadStatus::Hit;

        outBytecode.clear();
        return ShaderVariantCacheReadStatus::Miss;
    }

    if(!IsMissingPathError(read.error())){
        error("GraphicsCook: failed to read bytecode cache '{}' for entry '{}' (error {})", bytecodePath, entryName, read.error().value());
        return ShaderVariantCacheReadStatus::Error;
    }

    outBytecode.clear();
    return ShaderVariantCacheReadStatus::Miss;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class GraphicsVolumeMetadata{
    public IncludeMetadataMap includeMetadata;
    public ShaderEntryVector shaderEntries;
    public Vector<MaterialBindEntry> materialBindEntries;
    public Vector<CsgShapeCookEntry> csgShapeEntries;
    public PreparedShaderPlan preparedPlan;
    public HashSet<ShaderStageKey> seenShaderIdentityKeys;

    [owner_result]
    private Expected<PreparedShaderPlan> buildPlan(in CookResolvedPaths paths, in Path bindRoot, in Path csgRoot, in Path bxdfRoot, in Path shadowRoot, in Span<MaterialCookEntry> materials){
        return PrepareShaderEntriesForCook(paths, bindRoot, csgRoot, bxdfRoot, shadowRoot, this.includeMetadata, this.materialBindEntries, materials, this.shaderEntries);
    }

    public b8 prepareShaders(in CookResolvedPaths paths, in Path bindRoot, in Path csgRoot, in Path bxdfRoot, in Path shadowRoot, in Span<MaterialCookEntry> materials){
        Expected<PreparedShaderPlan> plan = this.buildPlan(paths, bindRoot, csgRoot, bxdfRoot, shadowRoot, materials);
        if(!plan.has_value())
            return false;
        this.preparedPlan.preparedEntries.swap(plan.value().preparedEntries);
        this.preparedPlan.plannedFileCount = plan.value().plannedFileCount;
        this.shaderEntries.clear();
        return true;
    }
}

b8 AppendUniqueShaderEntry(in Path file, mut ShaderCookEntry entry, mut GraphicsVolumeMetadata metadata){
    if(entry.name.empty())
        return true;
    const Expected<Optional<Name>, NameTextError> shader = ToName(entry.name);
    const Expected<Optional<Name>, NameTextError> stage = ToName(entry.archiveStage);
    if(!shader.has_value() || !stage.has_value()){
        u32 code = 0u;
        StringView field = "identity";
        if(!shader.has_value())
            code = cast<u32>(shader.error());
        else{
            code = cast<u32>(stage.error());
            field = "stage";
        }
        if(!file.empty())
            error("GraphicsCook: invalid shader {} in meta '{}' (failure {})", field, file, code);
        else
            error("GraphicsCook: generated shader {} has invalid text (failure {})", field, code);
        return false;
    }
    if(!TryInsertUniqueShaderIdentityKey(shader.value().value_or(s_NameNone), stage.value().value_or(s_NameNone), metadata.seenShaderIdentityKeys)){
        String path;
        if(!file.empty())
            path.assign(StringView(PathToString(file)));
        ReportDuplicateShaderIdentity(entry.name, entry.archiveStage, !file.empty(), path);
        return false;
    }
    AppendOwned<ShaderCookEntry>(metadata.shaderEntries, entry);
    return true;
}

[cook_document]
AssetMetadataParseResult ParseGraphicsDocumentMetadata(mut AssetDocumentMetadataParseContext context){
    if(ShaderTypeFromAssetType(context.assetType) != ShaderType::Invalid){
        mut GraphicsVolumeMetadata metadata = GetCookMetadata<GraphicsVolumeMetadata>(s_GraphicsVolumeMetadataExtensionName, context.parsedMetadata);
        Expected<ShaderCookEntry> parsed = ReadShaderMetadata(context.discoveredNwbFile.filePath, context.doc);
        if(!parsed.has_value())
            return AssetMetadataParseResult::Error;
        const Expected<String> name = DeriveAssetVirtualPathText(context.discoveredNwbFile.assetRoot, context.discoveredNwbFile.virtualRoot.view(), Path(StringView(parsed.value().source)));
        if(!name.has_value())
            return AssetMetadataParseResult::Error;
        parsed.value().name.assign(StringView(name.value()));
        const Path file(context.discoveredNwbFile.filePath);
        if(!AppendUniqueShaderEntry(file, parsed.value(), metadata))
            return AssetMetadataParseResult::Error;
        return AssetMetadataParseResult::Parsed;
    }
    if(context.assetType == s_IncludeAssetTypeName){
        mut GraphicsVolumeMetadata metadata = GetCookMetadata<GraphicsVolumeMetadata>(s_GraphicsVolumeMetadataExtensionName, context.parsedMetadata);
        const Expected<ShaderIncludeEntry> parsed = ReadShaderIncludeMetadata(context.discoveredNwbFile.filePath, context.doc);
        if(!parsed.has_value())
            return AssetMetadataParseResult::Error;
        if(!parsed.value().source.empty()){
            const Expected<Path, ErrorCode> absolute = AbsolutePath(Path(StringView(parsed.value().source)));
            if(!absolute.has_value()){
                error("GraphicsCook: failed to resolve include source '{}' from meta '{}': {}", parsed.value().source, context.discoveredNwbFile.filePath, ErrorCodeMessage(absolute.error()));
                return AssetMetadataParseResult::Error;
            }
            const Path path = absolute.value().lexicallyNormal();
            const String key = NativePathComparisonKey(path);
            if(metadata.includeMetadata.contains(key)){
                error("GraphicsCook: duplicate include metadata for source '{}'", path);
                return AssetMetadataParseResult::Error;
            }
            mut ShaderIncludeEntry target = GetOrCreateTextRecord<ShaderIncludeEntry>(metadata.includeMetadata, key);
            target = parsed.value();
        }
        return AssetMetadataParseResult::Parsed;
    }
    if(context.assetType == CsgShape::AssetTypeName()){
        mut GraphicsVolumeMetadata metadata = GetCookMetadata<GraphicsVolumeMetadata>(s_GraphicsVolumeMetadataExtensionName, context.parsedMetadata);
        if(!AppendParsedValue<CsgShapeCookEntry>(metadata.csgShapeEntries, ParseCsgShapeCookMetadata(context.discoveredNwbFile.filePath, context.doc)))
            return AssetMetadataParseResult::Error;
        return AssetMetadataParseResult::Parsed;
    }
    return AssetMetadataParseResult::Unsupported;
}

b8 ReadOrCompileShaderVariant(in PreparedShaderEntry prepared, in StringView variant, in ShaderDefineCombo defines, in Path cachePath, mut Vector<u8> bytecode){
    in ShaderCookEntry entry = prepared.entry;
    bytecode.clear();
    const ShaderVariantCacheReadStatus status = ReadCachedShaderVariantBytecode(entry.name, entry.stage, entry.entryPoint, cachePath, bytecode);
    if(status == ShaderVariantCacheReadStatus::Error)
        return false;
    if(status == ShaderVariantCacheReadStatus::Hit){
        info("GraphicsCook: shader '{}' variant '{}' is already cached at '{}'", entry.name, variant, cachePath);
        return true;
    }
    ShaderDefineCombo merged;
    merged.reserve(defines.size() + entry.implicitDefines.size());
    for(in auto define : defines)
        merged.insert_or_assign(define.first, define.second);
    for(in auto define : entry.implicitDefines)
        merged.insert_or_assign(StringView(define.first), StringView(define.second));
    if(!ValidateShaderMergedDefineCount(entry.name, merged.size()))
        return false;
    Vector<ShaderMacroDefinition> arguments;
    arguments.reserve(merged.size());
    for(in auto define : merged){
        ShaderMacroDefinition macro;
        macro.name = define.first;
        macro.value = define.second;
        arguments.push_back(macro);
    }
    SortSequence<ShaderMacroDefinition>(arguments, lambda[](in ShaderMacroDefinition lhs, in ShaderMacroDefinition rhs) -> b8{ return IsBeforeShaderMacroDefinitionName(lhs.name, rhs.name); });
    const Path parent = cachePath.parentPath();
    const Expected<void, ErrorCode> ensured = EnsureDirectories(parent);
    if(!ensured.has_value()){
        error("GraphicsCook: failed to create cache directory '{}': {}", parent, ErrorCodeMessage(ensured.error()));
        return false;
    }
    ShaderCompilerRequest request;
    request.shaderName = entry.name;
    request.stage = entry.stage;
    request.entryPoint = entry.entryPoint;
    request.variantName = variant;
    request.defines = arguments;
    request.externallyPlannedMacroIncludes = s_ExternallyPlannedMacroIncludes;
    request.sourcePath = prepared.sourcePath;
    request.outputPath = cachePath;
    request.optimizationLevel = entry.optimizationLevel;
    request.rayQuery = entry.rayQuery;
    request.compilerInputsHaveBom = prepared.compilerInputsHaveBom;
    request.includeDirectories = prepared.includeDirectories;
    request.dependencies = prepared.dependencies;
    return CompileSlangShaderVariant(request, bytecode);
}

class GraphicsVolumeWriter{
    private Vector<u8> bytecode;
    private Vector<u8> payload;
    private Vector<Record> records;

    private b8 appendVariant(in PreparedShaderEntry prepared, in Name shader, in Name stage, in ShaderDefineCombo defines, in u64 fingerprint, mut CookVolumeWriteContext context){
        in ShaderCookEntry entry = prepared.entry;
        const String variant = BuildCanonicalShaderVariantName(defines);
        const u64 sourceChecksum = ComputeShaderSourceChecksum(entry, variant, prepared.dependencyChecksum, fingerprint);
        String hex;
        AppendHexU64(sourceChecksum, hex);
        const Path cache = BuildShaderVariantBytecodeCachePath(context.preparation.resolvedPaths.cacheDirectory, context.preparation.configurationSafeName, hex);
        if(!ReadOrCompileShaderVariant(prepared, variant, defines, cache, this.bytecode))
            return false;
        const Expected<Name> path = BuildVirtualPathName(shader, variant, stage);
        if(!path.has_value()){
            error("Shader cook failed to build virtual path for '{}' stage '{}' variant '{}'", entry.name, entry.archiveStage, variant);
            return false;
        }
        if(!context.claim(path.value())){
            error("Shader cook produced duplicate virtual path '{}' (entry='{}', variant='{}')", path.value().resolvedText(), entry.name, variant);
            return false;
        }
        const u64 bytecodeChecksum = UpdateFnv64(s_Fnv64OffsetBasis, Span<u8>(this.bytecode));
        const u64 cookKey = BuildShaderVariantCookKeyHash(path.value().hash(), sourceChecksum, bytecodeChecksum);
        const AssetPayloadEncodeFailure failure = EncodeAssetPayload(entry.entryPoint, this.bytecode, this.payload);
        if(failure != AssetPayloadEncodeFailure::None){
            error("Failed to package shader payload '{}' (failure {})", path.value().resolvedText(), cast<u32>(failure));
            return false;
        }
        if(!context.appendPayload(path.value(), this.payload, cookKey)){
            error("Failed to append shader payload '{}' to manifest", path.value().resolvedText());
            return false;
        }
        mut Record record = AppendCookRecord<Record>(context, this.records);
        record.shaderName = shader;
        record.variantName.assign(StringView(variant));
        record.stage = stage;
        record.sourceChecksum = sourceChecksum;
        record.bytecodeChecksum = bytecodeChecksum;
        record.virtualPathHash = path.value().hash();
        return true;
    }

    public b8 write(in GraphicsVolumeMetadata metadata, mut CookVolumeWriteContext context){
        u64 count = 0u;
        for(in PreparedShaderEntry prepared : metadata.preparedPlan.preparedEntries){
            if(!TryAccumulatePreparedShaderRecordCount(prepared.variantCount, count))
                return false;
        }
        usize capacity = 0u;
        if(!ValidatePreparedShaderRecordCountFitsCapacity(count, capacity))
            return false;
        this.records.reserve(capacity);
        u64 fingerprint = 0u;
        if(!metadata.preparedPlan.preparedEntries.empty()){
            const Expected<u64> result = ComputeSlangCompilerFingerprint(context.preparation.resolvedPaths.cacheDirectory);
            if(!result.has_value())
                return false;
            fingerprint = result.value();
        }
        for(in PreparedShaderEntry prepared : metadata.preparedPlan.preparedEntries){
            const Expected<Optional<Name>, NameTextError> shader = ToName(prepared.entry.name);
            const Expected<Optional<Name>, NameTextError> stage = ToName(prepared.entry.archiveStage);
            Name shaderName = s_NameNone;
            Name stageName = s_NameNone;
            if(shader.has_value())
                shaderName = shader.value().value_or(s_NameNone);
            if(stage.has_value())
                stageName = stage.value().value_or(s_NameNone);
            if(!ValidateCanonicalPreparedShaderIdentity(shaderName, stageName, prepared.entry.name, prepared.entry.archiveStage, prepared.entry.entryPoint))
                return false;
            Expected<Vector<ShaderDefineCombo>> variants = ExpandShaderDefineCombinations(prepared.entry.defineValues);
            if(!variants.has_value()){
                error("GraphicsCook: variant combination count exceeds runtime limits for entry '{}'", prepared.entry.name);
                return false;
            }
            if(variants.value().empty())
                AppendArenaElement<ShaderDefineCombo>(variants.value());
            for(in ShaderDefineCombo combo : variants.value()){
                if(!this.appendVariant(prepared, shaderName, stageName, combo, fingerprint, context))
                    return false;
                if(prepared.supportsCsgClipVariant || prepared.supportsAvboitCsgClipVariant){
                    const Expected<ShaderDefineCombo> clip = BuildClipDefineCombo(prepared.entry.name, combo);
                    if(!clip.has_value() || !this.appendVariant(prepared, shaderName, stageName, clip.value(), fingerprint, context))
                        return false;
                }
            }
        }
        assert(this.records.size() == capacity);
        if(!context.claim(s_IndexVirtualPathName)){
            error("GraphicsCook: duplicate shader archive index virtual path '{}'", s_IndexVirtualPathName.resolvedText());
            return false;
        }
        in Vector<Record> records = this.records;
        if(!context.appendEncodedPayload(s_IndexVirtualPathName, lambda[in records](mut BinaryUpdateContext binary) -> b8{
            if(WriteShaderArchiveIndex(binary, Span<Record>(records)))
                return true;
            error("GraphicsCook: failed to serialize shader index");
            return false;
        })){
            error("GraphicsCook: failed to append shader index to manifest");
            return false;
        }
        return true;
    }
}

b8 ResolveGraphicsIncludeSource(in CookResolvedPaths paths, in StringView ownerKind, in StringView owner, in StringView label, mut String source){
    if(source.empty())
        return true;
    const Expected<Path> path = ResolveCookVirtualAssetPath(paths, source);
    if(!path.has_value()){
        error("GraphicsCook: {} '{}' {} '{}' does not resolve against any asset root", ownerKind, owner, label, source);
        return false;
    }
    source.assign(StringView(PathToString(path.value())));
    for(usize i = 0u; i < source.size(); ++i){
        if(source[i] == '\\')
            source[i] = '/';
    }
    return true;
}

b8 AppendGeneratedShaderEntries(in Vector<GeneratedMaterialPixelShader> list, mut GraphicsVolumeMetadata metadata){
    for(in GeneratedMaterialPixelShader shader : list){
        ShaderCookEntry entry;
        entry.name.assign(StringView(shader.name));
        entry.source.assign(StringView(shader.source));
        entry.stage = ArchiveStageTextFromShaderType(ShaderType::PixelStage);
        entry.archiveStage = entry.stage;
        AppendArenaElement<String>(entry.includeRoots);
        entry.includeRoots[0u].assign(s_EngineGraphicsIncludeRoot);
        entry.emitMeshComputeShadow = false;
        if(!AppendUniqueShaderEntry(Path(), entry, metadata))
            return false;
    }
    return true;
}

b8 PrepareGraphicsMaterials(mut CookVolumePrepareContext context, mut GraphicsVolumeMetadata metadata, mut Span<MaterialCookEntry> materials){
    if(!ValidateMaterialCookRequiresShaderEntries(metadata.shaderEntries.size(), materials.size()) || !ValidateMaterialCookInterfaces(metadata.materialBindEntries, materials))
        return false;
    const Expected<Path> bindRoot = EmitMaterialBindIncludes(context.resolvedPaths.cacheDirectory, context.configurationSafeName, metadata.materialBindEntries);
    if(!bindRoot.has_value())
        return false;
    for(mut CsgShapeCookEntry shape : metadata.csgShapeEntries){
        if(!ResolveGraphicsIncludeSource(context.resolvedPaths, s_CsgShapeOwnerKindLabel, shape.shapeName.resolvedText(), s_CsgShapeEvalFieldLabel, shape.evalInclude))
            return false;
    }
    const Expected<Path> csgRoot = CsgShapeModuleWriter().emit(context.resolvedPaths.cacheDirectory, context.configurationSafeName, metadata.csgShapeEntries);
    if(!csgRoot.has_value())
        return false;
    for(mut MaterialCookEntry material : materials){
        if(!ResolveGraphicsIncludeSource(context.resolvedPaths, s_MaterialOwnerKindLabel, material.virtualPath, s_MaterialBxdfSourceLabel, material.bxdfSource) || !ResolveGraphicsIncludeSource(context.resolvedPaths,
            s_MaterialOwnerKindLabel, material.virtualPath, s_MaterialSurfaceSourceLabel, material.surfaceSource))
            return false;
    }
    if(!AssignMaterialShadingModelIds(materials))
        return false;
    const Expected<Path> bxdfRoot = EmitDeferredBxdfDispatchModule(context.resolvedPaths.cacheDirectory, context.configurationSafeName, materials);
    if(!bxdfRoot.has_value())
        return false;
    const Expected<Path> shadowRoot = EmitShadowSurfaceDispatch(context.resolvedPaths.cacheDirectory, context.configurationSafeName, metadata.materialBindEntries, materials);
    if(!shadowRoot.has_value())
        return false;
    Name sharedMesh = s_NameNone;
    if(CookBucketSize(context.parsedMetadata, MeshSubsystem::AssetTypeName()) > 0u && !VisitCookEntries<SubsystemCookEntry<MeshSubsystem>>(context.parsedMetadata, MeshSubsystem::AssetTypeName(),
        lambda[mut sharedMesh](mut Span<SubsystemCookEntry<MeshSubsystem>> entries) -> b8{
        sharedMesh = entries[0u].asset.sharedMs.name();
        return true;
    }))
        return false;
    const Expected<Vector<GeneratedMaterialPixelShader>> surface = EmitMaterialPassPixelShaders(context.resolvedPaths.cacheDirectory, context.configurationSafeName, sharedMesh, MaterialPixelPass::Surface, materials);
    if(!surface.has_value())
        return false;
    const Expected<Vector<GeneratedMaterialPixelShader>> accumulate = EmitMaterialPassPixelShaders(context.resolvedPaths.cacheDirectory, context.configurationSafeName, s_NameNone, MaterialPixelPass::Accumulate, materials);
    if(!accumulate.has_value())
        return false;
    const Expected<Vector<GeneratedMaterialPixelShader>> occupancy = EmitMaterialPassPixelShaders(context.resolvedPaths.cacheDirectory, context.configurationSafeName, s_NameNone, MaterialPixelPass::Occupancy, materials);
    if(!occupancy.has_value())
        return false;
    const Expected<Vector<GeneratedMaterialPixelShader>> extinction = EmitMaterialPassPixelShaders(context.resolvedPaths.cacheDirectory, context.configurationSafeName, s_NameNone, MaterialPixelPass::Extinction, materials);
    if(!extinction.has_value())
        return false;
    usize count = 0u;
    if(!TryAccumulateGeneratedShaderEntryCapacity(metadata.shaderEntries.size(), surface.value().size(), accumulate.value().size(), occupancy.value().size(), extinction.value().size(), count))
        return false;
    metadata.shaderEntries.reserve(count);
    metadata.seenShaderIdentityKeys.reserve(count);
    if(!AppendGeneratedShaderEntries(surface.value(), metadata) || !AppendGeneratedShaderEntries(accumulate.value(), metadata) || !AppendGeneratedShaderEntries(occupancy.value(), metadata) || !AppendGeneratedShaderEntries(extinction.value(), metadata))
        return false;
    if(!metadata.prepareShaders(context.resolvedPaths, bindRoot.value(), csgRoot.value(), bxdfRoot.value(), shadowRoot.value(), materials))
        return false;
    if(!ValidateMaterials(metadata.preparedPlan.preparedEntries, materials) || !AddPlannedFileCount(metadata.preparedPlan.plannedFileCount, context.plannedFileCount))
        return false;
    AddCookManifestWriter<GraphicsVolumeWriter>(context, s_GraphicsVolumeMetadataExtensionName, metadata);
    return true;
}

[volume_prepare]
b8 PrepareGraphicsVolumeAssets(mut CookVolumePrepareContext context){
    if(ShouldSkipGraphicsVolumePreparation(HasCookMetadata<GraphicsVolumeMetadata>(s_GraphicsVolumeMetadataExtensionName, context.parsedMetadata), CookBucketSize(context.parsedMetadata, Material::AssetTypeName())))
        return true;
    mut GraphicsVolumeMetadata metadata = GetCookMetadata<GraphicsVolumeMetadata>(s_GraphicsVolumeMetadataExtensionName, context.parsedMetadata);
    if(!VisitCookFiles(context, s_MaterialBindSourceExtensionText, lambda[mut metadata](in DiscoveredNwbFile file) -> b8{
        Expected<MaterialBindEntry> parsed = ParseMaterialBindSource(file.filePath);
        if(!parsed.has_value())
            return false;
        const Expected<String> name = DeriveAssetVirtualPathText(file.assetRoot, file.virtualRoot.view(), file.filePath);
        if(!name.has_value())
            return false;
        parsed.value().virtualPath.assign(StringView(name.value()));
        return AppendParsedValue<MaterialBindEntry>(metadata.materialBindEntries, parsed);
    }) || !AssignCsgShapeCookIds(metadata.csgShapeEntries))
        return false;
    return VisitCookEntries<MaterialCookEntry>(context.parsedMetadata, Material::AssetTypeName(), lambda[mut context, mut metadata](mut Span<MaterialCookEntry> entries) -> b8{
        return PrepareGraphicsMaterials(context, metadata, entries);
    });
}

[cook_setup]
void RegisterGraphicsCookKinds(){
    RegisterNonStandaloneAssetType(MeshSubsystem::AssetTypeName(), s_MeshSubsystemNonStandaloneKindLabel);
    RegisterNonStandaloneAssetType(s_IncludeAssetTypeName, s_IncludeNonStandaloneKindLabel);
    RegisterNonStandaloneAssetType(s_ShaderNonStandaloneAssetTypeName, s_ShaderNonStandaloneKindLabel);
    RegisterNonStandaloneFirstTokenSuffix(s_ShaderFirstTokenSuffixLabel);
}


