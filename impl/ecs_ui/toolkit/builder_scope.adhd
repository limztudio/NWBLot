native{
#include <impl/ecs_ui/toolkit/context.adhd.h>
#include <impl/ecs_ui/toolkit/layout/tree.adhd.h>
#include <impl/ecs_ui/toolkit/text/service.adhd.h>
#include <impl/ecs_ui/toolkit/widgets/style.adhd.h>
#include <impl/ecs_ui/toolkit/widgets/window_style.adhd.h>
#include <impl/ecs_ui/toolkit/widgets/edit_box_state.adhd.h>
#include <impl/ecs_ui/toolkit/widgets/text_area.adhd.h>
#include <impl/ecs_ui/toolkit/widgets/scrollbar_style.adhd.h>
#include <impl/ecs_ui/toolkit/edit/integer_model.adhd.h>
#include <impl/ecs_ui/toolkit/edit/float_model.adhd.h>
#include <impl/ecs_ui/toolkit/widgets/popup.adhd.h>
#include <impl/ecs_ui/toolkit/widgets/list.adhd.h>
#include <impl/ecs_ui/toolkit/widgets/radio_group_frame.adhd.h>
#include <impl/ecs_ui/toolkit/widgets/slider_frame.adhd.h>
#include <impl/ecs_ui/toolkit/widgets/progress_style.adhd.h>
#include <impl/ecs_ui/toolkit/widgets/image_style.adhd.h>
#include <impl/ecs_ui/toolkit/widgets/combo.adhd.h>
#include <impl/ecs_ui/toolkit/widgets/combo_style.adhd.h>
#include <impl/ecs_ui/toolkit/widgets/control_visual_paint.adhd.h>
#include <impl/ecs_ui/toolkit/widgets/search_combo.adhd.h>
#include <impl/ecs_ui/toolkit/widgets/tooltip.adhd.h>
#include <impl/ecs_ui/toolkit/widgets/context_menu.adhd.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_UI_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Each declaration scope owns its transient layout and control loans in the caller's UI arena.
class BuilderScopeFrame final : NoCopy{
    friend class Builder;
    friend class ComboCoordinator;
    friend class EditBoxCoordinator;
    friend class TextAreaCoordinator;
    friend class NumericEditCoordinator;
    friend class ListCoordinator;
    friend class ContextMenuCoordinator;
    friend class ListLayoutPreparer;
    friend class TooltipCoordinator;


private:
    struct Item{
        WidgetState state;
        WidgetStyle style;
        SelectableStyle selectableStyle;
        EditBoxStyle editStyle;
        ScrollbarStyle scrollbarStyle;
        TextLayout text;
        Rect textBounds;
        EditBoxView editView;
        EditBoxState* editState = nullptr;
        EditBoxOptions editOptions;
        EditBoxPaintFlags editFlags;
        Insets padding;
        f32 checkboxExtent = 0.0f;
        u32 node = 0u;
        u32 list = s_LayoutNoParent;
        u32 radioGroup = s_LayoutNoParent;
        u32 slider = s_LayoutNoParent;
        u32 progress = s_LayoutNoParent;
        u32 image = s_LayoutNoParent;
        u32 combo = s_LayoutNoParent;
        u32 textArea = s_LayoutNoParent;
        u32 integerEdit = s_LayoutNoParent;
        u32 floatEdit = s_LayoutNoParent;
        b8 enabled = true;
        b8 checked = false;
        b8 contextMenu = false;
        b8 annotated = false;


    public:
        explicit Item(Core::Alloc::GlobalArena& arena)noexcept
            : text(arena)
            , editView(arena)
        {}
        Item(Item&&)noexcept = default;
        Item(const Item&) = delete;


    public:
        Item& operator=(Item&&)noexcept = default;

        Item& operator=(const Item&) = delete;
    };

    struct WindowFrame{
        WindowState* state = nullptr;
        WidgetStyle style;
        WindowOptions options;
        WindowMetrics metrics;
        b8 firstUse = false;
        WidgetState titleState;
        WidgetState collapseState;
        WidgetState resizeState;
        TextLayout title;
        Rect titleBounds;


    public:
        explicit WindowFrame(Core::Alloc::GlobalArena& arena)noexcept
            : title(arena)
        {}
    };

    struct TextAreaFrame{
        f32 wheelLines = s_StyleScrollWheelStep;
        const EditModel* model = nullptr;
        TextAreaState* state = nullptr;
        EditNavigationSnapshot navigation;
        TextAreaModelStamp modelStamp;
        u64 stateRevision = 0u;
        u32 item = s_LayoutNoParent;
        b8 focused = false;
    };

    struct NumericEditFrame{
        EditBoxState* state = nullptr;
        TextAreaModelStamp draftStamp;
        u64 revision = 0u;
        u32 item = s_LayoutNoParent;
        b8 focused = false;
    };

    struct IntegerEditFrame : NumericEditFrame{
        const IntegerEditModel* model = nullptr;
    };

    struct FloatEditFrame : NumericEditFrame{
        const FloatEditModel* model = nullptr;
    };

    struct ListRow{
        TextLayout text;
        Rect textBounds;
        u64 index = 0u;
        u64 key = 0u;
        b8 enabled = false;


    public:
        explicit ListRow(Core::Alloc::GlobalArena& arena)noexcept : text(arena){}
    };

    struct ListFrame{
        PaintVector<ListRow> rows;
        const IListDataSource* source = nullptr;
        ListState* state = nullptr;
        WidgetStyle widgetStyle;
        ListStyle style;
        ListOptions options;
        ListMeasureKey measureKey;
        f64 scrollOffset = 0.0;
        u64 cursorKey = 0u;
        f32 rowHeight = 0.0f;
        b8 revealCursor = false;
        b8 focusOnCommit = false;
        ControlToken token;
        Insets padding;
        u64 rowCount = 0u;
        WidgetId commandFocus;


    public:
        explicit ListFrame(Core::Alloc::GlobalArena& arena)noexcept : rows(arena){}
    };

    struct ComboFrame{
        const IListDataSource* source = nullptr;
        const IListDataSource* results = nullptr;
        ISearchableListDataSource* searchSource = nullptr;
        SearchComboState* search = nullptr;
        ComboState* state = nullptr;
        ComboStyle style;
        PopupStyle popupStyle;
        ComboOptions options;
        WidgetState popup;
        WidgetState rows;
        PopupToken popupToken;
        PopupToken parentToken;
        ControlToken token;
        ControlToken listToken;
        Rect visibleField;
        TextAreaModelStamp queryStamp;
        u64 rowCount = 0u;
        u64 resultCount = 0u;
        u32 editor = s_LayoutNoParent;
        u32 list = s_LayoutNoParent;
        f32 arrowExtent = 0.0f;
        f32 queryHeight = 0.0f;
        f32 queryGap = 0.0f;
        b8 open = false;
        b8 focusOnCommit = false;
        b8 listFocusOnCommit = false;
        b8 editorSubmitted = false;
        b8 queryChanged = false;
    };

    struct TooltipFrame{
        WidgetState widget;
        WidgetState anchor;
        TooltipState* state = nullptr;
        TooltipStyle style;
        TooltipOptions options;
        TextLayout text;
        u64 revision = 0u;
        u32 anchorIndex = 0u;
        u32 layer = 1u;


    public:
        explicit TooltipFrame(Core::Alloc::GlobalArena& arena)noexcept
            : text(arena)
        {}
        TooltipFrame(TooltipFrame&&)noexcept = default;
        TooltipFrame(const TooltipFrame&) = delete;


    public:
        TooltipFrame& operator=(TooltipFrame&&)noexcept = default;

        TooltipFrame& operator=(const TooltipFrame&) = delete;
    };

    struct ContextMenuFrame{
        WidgetState widget;
        WidgetState anchor;
        WidgetState popup;
        WidgetState rows;
        const IListDataSource* source = nullptr;
        ContextMenuState* state = nullptr;
        PopupStyle popupStyle;
        ContextMenuOptions options;
        PopupToken popupToken;
        PopupToken parentToken;
        ControlToken listToken;
        u64 rowCount = 0u;
        u64 revision = 0u;
        u32 anchorIndex = 0u;
        u32 list = s_LayoutNoParent;
        b8 open = false;
    };


public:
    explicit BuilderScopeFrame(Core::Alloc::GlobalArena& arena)
        : m_layout(arena)
        , m_items(arena)
        , m_textAreas(arena)
        , m_integerEdits(arena)
        , m_floatEdits(arena)
        , m_lists(arena)
        , m_radioGroups(arena)
        , m_sliders(arena)
        , m_progress(arena)
        , m_images(arena)
        , m_combos(arena)
        , m_comboEditors(arena)
        , m_tooltips(arena)
        , m_contextMenus(arena)
        , m_stack(arena)
        , m_window(arena)
    {
        m_items.reserve(s_LayoutMaxNodes);
        m_radioGroups.reserve(s_WidgetFrameReserve);
        m_sliders.reserve(s_WidgetFrameReserve);
        m_stack.reserve(s_ContextMaxScopeDepth);
    }
    BuilderScopeFrame(BuilderScopeFrame&&) = delete;


public:
    BuilderScopeFrame& operator=(BuilderScopeFrame&&) = delete;


private:
    void reset()noexcept{
        m_panelActive = false;
        m_windowActive = false;
        m_window.state = nullptr;
        m_parent = nullptr;
        m_popupState = nullptr;
        m_popupToken = {};
        m_popupVisible = false;
        m_items.clear();
        m_textAreas.clear();
        m_integerEdits.clear();
        m_floatEdits.clear();
        m_lists.clear();
        m_radioGroups.clear();
        m_sliders.clear();
        m_progress.clear();
        m_images.clear();
        m_combos.clear();
        m_comboEditors.clear();
        m_tooltips.clear();
        m_contextMenus.clear();
        m_stack.clear();
        m_layout.reset();
    }


private:
    BuilderScopeFrame* m_parent = nullptr;
    PopupState* m_popupState = nullptr;
    PopupToken m_popupToken;
    PopupOptions m_popupOptions;
    PopupPlacement m_popupPlacement;
    WidgetStyle m_panelStyle;
    PopupStyle m_popupPaintStyle;
    LayoutTree m_layout;
    PaintVector<Item> m_items;
    PaintVector<TextAreaFrame> m_textAreas;
    PaintVector<IntegerEditFrame> m_integerEdits;
    PaintVector<FloatEditFrame> m_floatEdits;
    PaintVector<ListFrame> m_lists;
    PaintVector<RadioGroupFrame> m_radioGroups;
    PaintVector<SliderFrame> m_sliders;
    PaintVector<ProgressFrame> m_progress;
    PaintVector<ImageFrame> m_images;
    PaintVector<ComboFrame> m_combos;
    PaintVector<Item> m_comboEditors;
    PaintVector<TooltipFrame> m_tooltips;
    PaintVector<ContextMenuFrame> m_contextMenus;
    PaintVector<u32> m_stack;
    WindowFrame m_window;
    WidgetState m_panelState;
    Rect m_bounds;
    b8 m_popupVisible = false;
    b8 m_panelActive = false;
    b8 m_windowActive = false;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_UI_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ImplEcsUiToolkitBuilderScopeAdhdModule(in u64 value){
    return value != 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

