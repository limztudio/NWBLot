////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_CAUSTIC_HW_COMMON_SLANGI
#define NWB_GRAPHICS_CAUSTIC_HW_COMMON_SLANGI


#include "hw_binding_slots.h"
#include "photon_push_constants.slangi"
#include "photon_types.slangi"
#include "../mesh/runtime_constants.h"
#include "../deferred/bindless_resources.slangi"
#include "../raytrace/material_context_slots.slangi"
#include "../bindless/bindless_heap_rt.slangi"

[[vk::push_constant]]
ConstantBuffer<NwbCausticPhotonPushConstants> g_NwbCausticHwPushConstants;

// The shared scene-shading CB + light list are selected by the frame selector payload in the UniformBuffer heap. The
// per-hit surface dispatch reads the same shadow-owned material buffers as the SW path through the heap selector below.
#pragma warning(push)
#pragma warning(disable: 39001) // Deliberate typed alias of the global UniformBuffer descriptor table.
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_UNIFORM_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
ConstantBuffer<NwbRayTraceMaterialContextSlots, Std140DataLayout> g_NwbHeapCausticHwMaterialContextSlots[];
#pragma warning(pop)
#define g_NwbCausticHwBindlessResources g_NwbHeapDeferredBindlessResources[g_NwbCausticHwPushConstants.deferredResourcesHeapSlot]
#define g_NwbCausticHwMaterialContextSlots g_NwbHeapCausticHwMaterialContextSlots[g_NwbCausticHwPushConstants.materialContextSlotsHeapSlot]
#define NWB_SCENE_SHADING_HEAP_SLOT g_NwbCausticHwBindlessResources.avboitSlots.z
#define NWB_SCENE_LIGHT_LIST_HEAP_SLOT g_NwbCausticHwBindlessResources.avboitSlots.w

// Route the per-hit surface dispatch through the heap-selected typed-word and mesh-instance buffers. The caustic
// push block selects its own mesh-view heap slot.
uint nwbMeshFrameMaterialTypedHeapSlot(){
    return g_NwbCausticHwMaterialContextSlots.sceneSlots.w;
}
uint nwbMeshFrameInstanceHeapSlot(){
    return g_NwbCausticHwMaterialContextSlots.materialSlots.x;
}
uint nwbMeshFrameViewHeapSlot(){
    return 0u; // The caustic surface path does not consume the mesh-view alias.
}
#include "../bindless/bindless_heap_mesh.slangi"

#include "../scene/buffer.slangi"
#include "../common/math.slangi"
#include "../bvh/ray_vertex_attrib.slangi"

// The shadow trace's material-constants context (NwbShadowHit + the surface contract + the engine shadow physics
// helpers) + the cook-generated per-hit surface dispatch (nwbShadowDispatchSurface), routed by
// shadowTransmittanceModelId -- the SAME dispatch the SW caustic kernel + the shadow trace evaluate, so a glass's
// optical params (ior / transmission) agree across all three.
#include "../shadow/shadow_surface.slangi"
#include "shadow/generated/transmittance_dispatch.slangi"

// The fixed-point splat conversion (nwbCausticFluxToFixedPoint) the deposit shares with the SW path. NOT the full
// transport (caustic_trace.slangi) -- only the raygen needs the bounce loop, so the closest-hit/miss stay free of
// the backend hook + TraceRay.
#include "splat_constants.slangi"
#include "light_pick.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// The closest-hit payload carries the NwbCausticHit fields (caustic_trace.slangi) the shared bounce loop consumes; the
// transmission tint stays float3 here for stable ray-payload packing and is narrowed when the raygen builds NwbCausticHit.
// The two bool fields ride as uint for stable HLSL payload packing. The closest-hit fills every field, the miss clears
// `hit`, and the raygen hook converts it back to NwbCausticHit. 52 bytes -> declare MaxPayloadSize 64.
struct NwbCausticHwPayload{
    float3 worldPos;
    float3 shadingNormal;
    float3 transmission;
    float t;
    float ior;
    uint hit;
    uint isRefractive;
};

// The caustic-specific producer inputs share the global heap's StorageBuffer / UniformBuffer tables with the trace
// material context and mesh-frame view. Their slots are uniform for one ray dispatch and ride the photon push block,
// so no NonUniformResourceIndex decoration is needed here.
#pragma warning(push)
#pragma warning(disable: 39001) // Deliberate typed aliases of the global heap descriptor tables.
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
StructuredBuffer<NwbCausticEmissionTarget, Std430DataLayout> g_NwbHeapCausticHwEmissionTargets[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_UNIFORM_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
ConstantBuffer<NwbCausticPhotonView, Std140DataLayout> g_NwbHeapCausticHwViews[];
#pragma warning(pop)

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// The fixed-function intersector supplies triangle/barycentric data; its InstanceID selects the heap-backed material
// record through the UniformBuffer heap payload. Per-corner attributes remain separately addressed by that record's
// heap slot.
StructuredBuffer<NwbRtInstanceMaterial, Std430DataLayout> nwbCausticHwInstanceMaterials(){
    return NwbHeapRtInstanceMaterials(g_NwbCausticHwMaterialContextSlots.sceneSlots.z);
}

// The closest-hit reads corner attributes through the material record's global heap slot. The shared backing buffers
// remain transitioned for those heap reads; the world hit point comes from WorldRayOrigin()+RayTCurrent()*WorldRayDirection().

Texture2D<float4> nwbCausticHwGbufferDepth(){
    return NwbHeapSampledImage2D(g_NwbCausticHwPushConstants.depthSlot);
}

Texture2D<float4> nwbCausticHwGbufferWorldPosition(){
    return NwbHeapSampledImage2D(g_NwbCausticHwPushConstants.worldPositionSlot);
}

StructuredBuffer<NwbCausticEmissionTarget, Std430DataLayout> nwbCausticHwEmissionTargets(){
    return g_NwbHeapCausticHwEmissionTargets[g_NwbCausticHwPushConstants.emissionTargetSlot];
}

ConstantBuffer<NwbCausticPhotonView, Std140DataLayout> nwbCausticHwView(){
    return g_NwbHeapCausticHwViews[g_NwbCausticHwPushConstants.viewSlot];
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Per-triangle-corner attribute load -- identical layout to the SW kernel's nwbCausticSwLoadVertexAttrib + the
// shadow trace's nwbShadowRtLoadVertexAttrib (Half4U normal @ +0, Float2U uv0 @ +8, 16B stride), so the closest-hit
// interpolates the SAME inputs into the per-hit surface dispatch.
NwbRayTraceVertexAttrib nwbCausticHwLoadVertexAttrib(const uint attributeSlot, const uint attributeIndex){
    // attributeSlot is this mesh's per-corner attribute buffer's GLOBAL HEAP slot (carried on the instance material
    // record, populated lockstep with the mesh by the HW shadow builder in rt_swbvh.cpp). It is
    // non-uniform across the ray wave -- each hit is on a different instance/mesh -- so the heap subscript MUST be
    // NonUniformResourceIndex-tagged; NwbHeapRawBuffer() applies that internally and is re-invoked at each Load so the
    // decoration is applied fresh at every descriptor access.
    // One Load4 for the whole 16-byte attribute record (packed normal in .xy, uv0 in .zw) -- one request instead of two
    // dependent Load2s (bit-identical; mirrors the SW producer).
    return nwbRayTraceDecodeVertexAttrib(NwbHeapRawBuffer(attributeSlot).Load4(attributeIndex * 16u));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#define NWB_CAUSTIC_SPLAT_VIEW nwbCausticHwView()
#define NWB_CAUSTIC_SPLAT_PUSH g_NwbCausticHwPushConstants
#define NWB_CAUSTIC_SPLAT_GBUFFER_DEPTH nwbCausticHwGbufferDepth()
#define NWB_CAUSTIC_SPLAT_GBUFFER_WORLD_POSITION nwbCausticHwGbufferWorldPosition()
#define NWB_CAUSTIC_SPLAT_ACCUMULATOR NwbHeapStorageImage2DArrayUint(g_NwbCausticHwPushConstants.accumulatorStorageSlot)
#include "splat.slangi"
#undef NWB_CAUSTIC_SPLAT_ACCUMULATOR
#undef NWB_CAUSTIC_SPLAT_GBUFFER_WORLD_POSITION
#undef NWB_CAUSTIC_SPLAT_GBUFFER_DEPTH
#undef NWB_CAUSTIC_SPLAT_PUSH
#undef NWB_CAUSTIC_SPLAT_VIEW


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


