enum<u8> GpuTelemetryScenario{
    Explicit = 0,
    Inferred = 1,
    Mixed = 2,
    kCount
}

enum<u8> GpuTelemetryTerminalScenario{
    ReadPairs = 0,
    RootedStar = 1,
    Chain = 2,
    kCount
}

void GpuTelemetryCheckEdges(in usize taskCount, in GpuTelemetryScenario scenario){
    ScratchArena scratchArena = ScratchArena(s_TaskGraphScratchArena);

    const ScopedTestTrace countTrace = ScopedTestTrace(taskCount);
    const ScopedTestTrace scenarioTrace = ScopedTestTrace(cast<u32>(scenario));
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuGraphResourceId resource = GpuGraphResourceId();
    if(scenario != GpuTelemetryScenario::Explicit){
        const Expected<GpuGraphResourceId> resourceTaskAdmission = AddBufferMetadata(graph, s_GpuCaseTelemetryScalingResource, "Telemetry Buffer");
        ASSERT_TRUE(resourceTaskAdmission.has_value());
        resource = resourceTaskAdmission.value();
        ASSERT_TRUE(resource.valid());
    }
    Array<GpuTaskResourceUse, 1> resourceUses = Array<GpuTaskResourceUse, 1>();
    resourceUses[0u].resource = resource;
    resourceUses[0u].requiredState = ResourceStates::UnorderedAccess;
    resourceUses[0u].access = GpuTaskResourceAccess::Write;

    GpuTaskId preceding = GpuTaskId();
    for(usize taskIndex = 0u; taskIndex < taskCount; ++taskIndex){
        const Expected<Name> identityNameResult = IndexedName(s_GpuCaseTelemetryScalingTask, taskIndex);
        ASSERT_TRUE(identityNameResult.has_value());
        const Name identity = identityNameResult.value();
        const b8 explicitDependency = preceding.valid() && (scenario == GpuTelemetryScenario::Explicit || (scenario == GpuTelemetryScenario::Mixed && taskIndex % 2u != 0u));

        Array<GpuTaskId, 1> deps = Array<GpuTaskId, 1>();
        deps[0u] = preceding;

        Expected<GpuTaskId> precedingTaskAdmission = MakeUnexpected(Failure());
        if(explicitDependency && resource.valid()){
            precedingTaskAdmission = AddTask(
                identity,
                "Telemetry Task",
                deps,
                resourceUses,
                Span<GpuTaskResourceSetUse>(),
                Span<GpuTaskResourceVersionUse>(),
                Span<GpuExternalCompletionId>(),
                graph
            );
        }
        else if(explicitDependency){
            precedingTaskAdmission = AddTask(
                identity,
                "Telemetry Task",
                deps,
                Span<GpuTaskResourceUse>(),
                Span<GpuTaskResourceSetUse>(),
                Span<GpuTaskResourceVersionUse>(),
                Span<GpuExternalCompletionId>(),
                graph
            );
        }
        else if(resource.valid()){
            precedingTaskAdmission = AddTask(
                identity,
                "Telemetry Task",
                Span<GpuTaskId>(),
                resourceUses,
                Span<GpuTaskResourceSetUse>(),
                Span<GpuTaskResourceVersionUse>(),
                Span<GpuExternalCompletionId>(),
                graph
            );
        }
        else{
            precedingTaskAdmission = AddTask(
                identity,
                "Telemetry Task",
                Span<GpuTaskId>(),
                Span<GpuTaskResourceUse>(),
                Span<GpuTaskResourceSetUse>(),
                Span<GpuTaskResourceVersionUse>(),
                Span<GpuExternalCompletionId>(),
                graph
            );
        }
        ASSERT_TRUE(precedingTaskAdmission.has_value());
        preceding = precedingTaskAdmission.value();
        ASSERT_TRUE(preceding.valid());
    }

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, scratchArena, analysis));
    ASSERT_EQ(analysis.edges().size(), taskCount - 1u);
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
    ASSERT_TRUE(declarations.valid());

    GpuTelemetryFrameGraphScope telemetry = GpuTelemetryFrameGraphScope(
        scratchArena,
        testArena.arena,
        taskCount + declarations.resourceCount(),
        taskCount + analysis.edges().size()
    );
    ASSERT_TRUE(declarations.appendFrameGraphTelemetry(analysis, scratchArena, telemetry.builder));
    ASSERT_EQ(telemetry.nodes.size(), taskCount + declarations.resourceCount());
    usize expectedResourceEdges = 0u;
    if(resource.valid())
        expectedResourceEdges = taskCount;
    ASSERT_EQ(telemetry.edges.size(), analysis.edges().size() + expectedResourceEdges);

    const u32 nodeOffset = cast<u32>(declarations.resourceCount());
    const b8 isExplicitScenario = scenario == GpuTelemetryScenario::Explicit;
    const b8 isMixedScenario = scenario == GpuTelemetryScenario::Mixed;
    const b8 hasResource = resource.valid();
    usize dependencyIndex = 0u;
    native(in telemetry, in analysis, in nodeOffset, in isExplicitScenario, in isMixedScenario, in hasResource, mut dependencyIndex){
        for(const Telemetry::FrameGraphEdgeDesc& edge : telemetry.edges){
            if(edge.kind != Telemetry::FrameGraphEdgeKind::DependsOn){
                EXPECT_EQ(edge.kind, Telemetry::FrameGraphEdgeKind::Writes);
                EXPECT_EQ(edge.toNodeIndex, 0u);
                EXPECT_EQ(edge.flags, 0u);
                continue;
            }
            ASSERT_LT(dependencyIndex, analysis.edges().size());
            const auto& dependency = analysis.edges()[dependencyIndex];
            ++dependencyIndex;
            EXPECT_EQ(edge.fromNodeIndex, nodeOffset + dependency.producer.index);
            EXPECT_EQ(edge.toNodeIndex, nodeOffset + dependency.consumer.index);
            EXPECT_EQ(dependency.producer.index + 1u, dependency.consumer.index);
            u8 expectedFlags = hasResource ? Core::GpuTaskGraphTelemetryEdgeFlag::InferredDependency : 0u;
            if(isExplicitScenario || (isMixedScenario && dependency.consumer.index % 2u != 0u))
                expectedFlags |= Core::GpuTaskGraphTelemetryEdgeFlag::ExplicitDependency;
            EXPECT_EQ(edge.flags, expectedFlags);
        }
    }
    EXPECT_EQ(dependencyIndex, analysis.edges().size());
}

void VerifyGpuTelemetry_PreservesExplicitInferredAndOverlappingEdgeFlags(){
    native{
        ASSERT_NO_FATAL_FAILURE(GpuTelemetryCheckEdges(3u, GpuTelemetryScenario::Explicit));
        ASSERT_NO_FATAL_FAILURE(GpuTelemetryCheckEdges(3u, GpuTelemetryScenario::Inferred));
        ASSERT_NO_FATAL_FAILURE(GpuTelemetryCheckEdges(3u, GpuTelemetryScenario::Mixed));
    }
}

GpuTaskResourceUse GpuTelemetryTerminalResourceUse(in GpuGraphResourceId resource){
    GpuTaskResourceUse use = GpuTaskResourceUse();
    use.resource = resource;
    use.range.bufferRange = BufferRange(0u, 64u);
    use.requiredState = ResourceStates::ShaderResource;
    use.access = GpuTaskResourceAccess::Read;
    use.hasIndependentStateSource = true;
    return use;
}

void GpuTelemetryCheckTerminalDependencies(
    in usize readerCount,
    in GpuTelemetryTerminalScenario scenario,
    in b8 lateFallback
){
    ASSERT_GT(readerCount, 0u);
    if(lateFallback){
        ASSERT_EQ(scenario, GpuTelemetryTerminalScenario::ReadPairs);
        ASSERT_GE(readerCount, 3u);
    }
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    Vector<GpuGraphResourceId> resources = Vector<GpuGraphResourceId>();
    Vector<GpuTaskId> readers = Vector<GpuTaskId>();
    Vector<GpuTaskId> finalizers = Vector<GpuTaskId>();
    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();

    usize pairCount = 1u;
    if(scenario == GpuTelemetryTerminalScenario::ReadPairs)
        pairCount = readerCount;
    resources.reserve(pairCount * 2u);
    readers.reserve(readerCount);
    finalizers.reserve(pairCount);

    for(usize resourceIndex = 0u; resourceIndex < pairCount * 2u; ++resourceIndex){
        const Expected<Name> identityNameResult = IndexedName(s_GpuCaseTerminalDependencyResource, resourceIndex);
        ASSERT_TRUE(identityNameResult.has_value());
        const Name identity = identityNameResult.value();
        GpuGraphResourceDesc resourceDesc = GpuGraphResourceDesc();
        resourceDesc.setIdentity(identity);
        resourceDesc.setMarkerLabel("Terminal Dependency Buffer");
        resourceDesc.setType(GpuGraphResourceType::Buffer);
        resourceDesc.setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute);
        resourceDesc.setInitialState(ResourceStates::ShaderResource);
        resourceDesc.setExternalFinalState(ResourceStates::CopySource);
        const Expected<GpuGraphResourceId> resourceResult = graph.importResource(resourceDesc);
        ASSERT_TRUE(resourceResult.has_value());
        const GpuGraphResourceId resource = resourceResult.value();
        ASSERT_TRUE(resource.valid());
        resources.push_back(resource);
    }

    GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
    scheduling.forceSubmissionBoundary = true;
    scheduling.overlapPreferred = false;
    scheduling.avoidQueueCrossing = true;

    for(usize readerIndex = 0u; readerIndex < readerCount; ++readerIndex){
        usize pairIndex = 0u;
        if(scenario == GpuTelemetryTerminalScenario::ReadPairs)
            pairIndex = readerIndex;
        Array<GpuTaskResourceUse, 4> uses = Array<GpuTaskResourceUse, 4>();
        uses[0u] = GpuTelemetryTerminalResourceUse(resources[pairIndex * 2u]);
        uses[1u] = GpuTelemetryTerminalResourceUse(resources[pairIndex * 2u + 1u]);
        usize useCount = 2u;
        if(lateFallback && readerIndex == 1u){
            uses[2u] = GpuTelemetryTerminalResourceUse(resources[(pairCount - 1u) * 2u]);
            uses[3u] = GpuTelemetryTerminalResourceUse(resources[(pairCount - 1u) * 2u + 1u]);
            useCount = uses.size();
        }

        const Expected<Name> readerNameResult = IndexedName(s_GpuCaseTerminalDependencyReader, readerIndex);
        ASSERT_TRUE(readerNameResult.has_value());

        GpuTaskDesc desc = GpuTaskDesc();
        desc.setIdentity(readerNameResult.value());
        desc.setMarkerLabel("Independent Terminal Reader");
        desc.setScheduling(scheduling);
        desc.setResourceUses(MakeGpuTelemetryUsePrefixSpan(uses, useCount));

        usize queueIndex = readerIndex % 2u;
        if(scenario == GpuTelemetryTerminalScenario::ReadPairs && !lateFallback)
            queueIndex = 0u;
        GpuTaskCommandRequirements commands = ComputeCommands();
        if(queueIndex == 0u)
            commands = GraphicsCommands();

        Expected<GpuTaskId> readerResult = MakeUnexpected(Failure());
        if(scenario == GpuTelemetryTerminalScenario::Chain && !readers.empty()){
            Array<GpuTaskId, 1> dep = Array<GpuTaskId, 1>();
            dep[0u] = readers[readers.size() - 1u];
            desc.setDependencies(dep);
            readerResult = graph.addTask(desc, commands);
        }
        else
            readerResult = graph.addTask(desc, commands);

        ASSERT_TRUE(readerResult.has_value());
        const GpuTaskId reader = readerResult.value();
        ASSERT_TRUE(reader.valid());
        readers.push_back(reader);
    }

    for(usize pairIndex = 0u; pairIndex < pairCount; ++pairIndex){
        Array<GpuTaskResourceUse, 2> uses = Array<GpuTaskResourceUse, 2>();
        uses[0u] = GpuTelemetryTerminalResourceUse(resources[pairIndex * 2u]);
        uses[1u] = GpuTelemetryTerminalResourceUse(resources[pairIndex * 2u + 1u]);
        const Expected<Name> secondReaderNameResult = IndexedName(s_GpuCaseTerminalDependencyFinalizer, pairIndex);
        ASSERT_TRUE(secondReaderNameResult.has_value());

        GpuTaskDesc desc = GpuTaskDesc();
        desc.setIdentity(secondReaderNameResult.value());
        desc.setMarkerLabel("Terminal Finalizing Reader");
        desc.setScheduling(scheduling);
        desc.setResourceUses(uses);

        usize queueIndex = readerCount % 2u;
        if(scenario == GpuTelemetryTerminalScenario::ReadPairs){
            if(lateFallback)
                queueIndex = (pairIndex + 1u) % 2u;
            else
                queueIndex = 1u;
        }
        GpuTaskCommandRequirements commands = ComputeCommands();
        if(queueIndex == 0u)
            commands = GraphicsCommands();

        Expected<GpuTaskId> finalizerResult = MakeUnexpected(Failure());
        if(scenario == GpuTelemetryTerminalScenario::Chain){
            Array<GpuTaskId, 1> dep = Array<GpuTaskId, 1>();
            dep[0u] = readers[readers.size() - 1u];
            desc.setDependencies(dep);
            finalizerResult = graph.addTask(desc, commands);
        }
        else if(lateFallback && pairIndex + 1u == pairCount){
            Array<GpuTaskId, 1> dep = Array<GpuTaskId, 1>();
            dep[0u] = finalizers[1u];
            desc.setDependencies(dep);
            finalizerResult = graph.addTask(desc, commands);
        }
        else
            finalizerResult = graph.addTask(desc, commands);

        ASSERT_TRUE(finalizerResult.has_value());
        const GpuTaskId finalizer = finalizerResult.value();
        ASSERT_TRUE(finalizer.valid());
        finalizers.push_back(finalizer);
    }

    const GpuPhysicalQueueTopology topology = MakeGpuTelemetryTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ScratchArena scratchArena = ScratchArena(s_GpuCaseTerminalDependencyCompilation);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, scratchArena, graph, topology));

    const GpuTelemetryCompiledGraphReadView plan = GpuTelemetryCompiledGraphReadView(compiledGraph);
    ASSERT_EQ(plan.taskCount(), readers.size() + finalizers.size());
    ASSERT_EQ(plan.packetCount(), readers.size() + finalizers.size());
    const GpuTaskGraphCompileStatistics statistics = plan.compileStatistics();
    EXPECT_EQ(statistics.prologueStateSeedCount, 0u);
    EXPECT_EQ(statistics.epilogueBarrierCount, resources.size());
    EXPECT_EQ(statistics.logicalOwnershipTransferCount, 0u);
    usize expectedPacketDeps = readerCount;
    if(lateFallback)
        expectedPacketDeps = readerCount + 1u;
    EXPECT_EQ(statistics.packetDependencyCount, expectedPacketDeps);

    for(usize readerIndex = 0u; readerIndex < readers.size(); ++readerIndex){
        const GpuSubmissionPacketId packet = plan.packetForTask(readers[readerIndex]);
        ASSERT_TRUE(packet.valid());
        EXPECT_EQ(packet.index, readerIndex);
        const GpuCompiledPacketView view = plan.packet(packet);
        ASSERT_TRUE(view.valid());
        const b8 chained = scenario == GpuTelemetryTerminalScenario::Chain && readerIndex != 0u;
        u32 expectedDepCount = 0u;
        if(chained)
            expectedDepCount = 1u;
        native(in view, in expectedDepCount){
            ASSERT_EQ(view.plan->dependencyCount, expectedDepCount);
        }
        if(chained){
            const GpuSubmissionPacketId expectedProducer = plan.packetForTask(readers[readerIndex - 1u]);
            native(in view, in expectedProducer){
                EXPECT_EQ(view.dependencies[0u].producer, expectedProducer);
            }
        }
    }

    const b8 isRootedStar = scenario == GpuTelemetryTerminalScenario::RootedStar;
    const b8 isReadPairs = scenario == GpuTelemetryTerminalScenario::ReadPairs;
    for(usize pairIndex = 0u; pairIndex < finalizers.size(); ++pairIndex){
        const GpuSubmissionPacketId packet = plan.packetForTask(finalizers[pairIndex]);
        ASSERT_TRUE(packet.valid());
        EXPECT_EQ(packet.index, readers.size() + pairIndex);
        const GpuCompiledPacketView view = plan.packet(packet);
        ASSERT_TRUE(view.valid());
        const b8 delayedFallback = lateFallback && pairIndex + 1u == pairCount;
        usize dependencyCount = 1u;
        if(isRootedStar)
            dependencyCount = readerCount;
        if(delayedFallback)
            dependencyCount = 2u;

        const GpuCompiledTaskView task = plan.findTask(finalizers[pairIndex]);
        ASSERT_TRUE(task.valid());
        native(
            in plan,
            in view,
            in task,
            in packet,
            in readers,
            in finalizers,
            in resources,
            in pairIndex,
            in readerCount,
            in dependencyCount,
            in delayedFallback,
            in isReadPairs
        ){
            EXPECT_EQ(view.plan->recordingFrontier, 0u);
            ASSERT_EQ(view.plan->dependencyCount, dependencyCount);
            if(delayedFallback){
                EXPECT_EQ(view.dependencies[0u].producer, plan.packetForTask(finalizers[1u]));
                EXPECT_EQ(view.dependencies[1u].producer, plan.packetForTask(readers[pairIndex]));
            }
            else if(isReadPairs)
                EXPECT_EQ(view.dependencies[0u].producer, plan.packetForTask(readers[pairIndex]));
            else{
                for(usize dependencyIndex = 0u; dependencyIndex < dependencyCount; ++dependencyIndex){
                    const Core::GpuSubmissionPacketId producer = plan.packetForTask(readers[readerCount - dependencyIndex - 1u]);
                    EXPECT_EQ(view.dependencies[dependencyIndex].producer, producer);
                }
            }
            for(usize dependencyIndex = 0u; dependencyIndex < dependencyCount; ++dependencyIndex)
                EXPECT_EQ(view.dependencies[dependencyIndex].consumer, packet);
            ASSERT_EQ(task.plan->epilogueBarrierCount, 2u);
            for(usize barrierIndex = 0u; barrierIndex < 2u; ++barrierIndex){
                EXPECT_EQ(task.epilogueBarriers[barrierIndex].type, Core::GpuCompiledBarrierType::BufferStateExport);
                EXPECT_EQ(task.epilogueBarriers[barrierIndex].resource, resources[pairIndex * 2u + barrierIndex]);
            }
        }
    }
}

void VerifyGpuTelemetry_PreservesDuplicatePairOrderAndLateIndirectReachability(){
    Array<usize, 2> readerCounts = Array<usize, 2>();
    readerCounts[0u] = 3u;
    readerCounts[1u] = 17u;
    for(in usize readerCount : readerCounts){
        native(in readerCount){
            ASSERT_NO_FATAL_FAILURE(GpuTelemetryCheckTerminalDependencies(readerCount, GpuTelemetryTerminalScenario::ReadPairs, true));
            ASSERT_NO_FATAL_FAILURE(GpuTelemetryCheckTerminalDependencies(readerCount, GpuTelemetryTerminalScenario::RootedStar, false));
            ASSERT_NO_FATAL_FAILURE(GpuTelemetryCheckTerminalDependencies(readerCount, GpuTelemetryTerminalScenario::Chain, false));
        }
    }
}

void VerifyGpuTelemetry_OrdersIndependentTerminalFinalizationDependenciesNearestFirst(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuGraphResourceDesc resourceDesc = GpuGraphResourceDesc();
    resourceDesc.setIdentity(s_GpuCaseTaskGraphOrderedTerminalFinalizationResource);
    resourceDesc.setMarkerLabel("Ordered Terminal Finalization Resource");
    resourceDesc.setType(GpuGraphResourceType::Texture);
    resourceDesc.setInitialState(ResourceStates::ShaderResource);
    resourceDesc.setExternalFinalState(ResourceStates::CopySource);
    resourceDesc.setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute);
    const Expected<GpuGraphResourceId> resourceResult = graph.importResource(resourceDesc);
    ASSERT_TRUE(resourceResult.has_value());
    const GpuGraphResourceId resource = resourceResult.value();
    ASSERT_TRUE(resource.valid());

    GpuTaskResourceRange range = GpuTaskResourceRange();
    range.textureSubresources = TextureSubresourceSet(0u, 1u, 0u, 1u);
    Array<GpuTaskResourceUse, 1> readerUses = Array<GpuTaskResourceUse, 1>();
    readerUses[0u].resource = resource;
    readerUses[0u].range = range;
    readerUses[0u].requiredState = ResourceStates::ShaderResource;
    readerUses[0u].access = GpuTaskResourceAccess::Read;
    readerUses[0u].hasIndependentStateSource = true;

    GpuTaskSchedulingHint readerScheduling = GpuTaskSchedulingHint();
    readerScheduling.forceSubmissionBoundary = true;
    readerScheduling.allowPacketMerge = false;
    Array<GpuTaskCommandRequirements, 4> readerCommands = Array<GpuTaskCommandRequirements, 4>();
    readerCommands[0u] = GraphicsCommands();
    readerCommands[1u] = ComputeCommands();
    readerCommands[2u] = GraphicsCommands();
    readerCommands[3u] = ComputeCommands();

    Array<GpuTaskId, 4> readers = Array<GpuTaskId, 4>();
    for(usize readerIndex = 0u; readerIndex < readers.size(); ++readerIndex){
        const Expected<Name> readerNameResult = IndexedName(s_TaskGraphOrderedTerminalFinalizationReader, readerIndex);
        ASSERT_TRUE(readerNameResult.has_value());
        GpuTaskDesc readerDesc = GpuTaskDesc();
        readerDesc.setIdentity(readerNameResult.value());
        readerDesc.setMarkerLabel("Ordered Terminal Finalization Reader");
        readerDesc.setScheduling(readerScheduling);
        readerDesc.setResourceUses(readerUses);
        Expected<GpuTaskId> readerTaskAdmission = MakeUnexpected(Failure());
        if(readerIndex == 1u){
            Array<GpuTaskId, 1> dep = Array<GpuTaskId, 1>();
            dep[0u] = readers[0u];
            readerDesc.setDependencies(dep);
            readerTaskAdmission = graph.addTask(readerDesc, readerCommands[readerIndex]);
        }
        else{
            readerDesc.setDependencies(Span<GpuTaskId>());
            readerTaskAdmission = graph.addTask(readerDesc, readerCommands[readerIndex]);
        }
        ASSERT_TRUE(readerTaskAdmission.has_value());
        readers[readerIndex] = readerTaskAdmission.value();
        ASSERT_TRUE(readers[readerIndex].valid());
    }

    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    const GpuPhysicalQueueTopology topology = MakeGpuTelemetryTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    const GpuTelemetryCompiledGraphReadView compiledPlan = GpuTelemetryCompiledGraphReadView(compiledGraph);

    native(in analysis, in compiledPlan, in readers, in queues){
        EXPECT_NE(FindEdge(analysis, readers[0u], readers[1u]), nullptr);
        EXPECT_EQ(FindEdge(analysis, readers[0u], readers[3u]), nullptr);
        EXPECT_EQ(FindEdge(analysis, readers[2u], readers[3u]), nullptr);
        ASSERT_EQ(compiledPlan.packetCount(), readers.size());

        Array<Core::GpuSubmissionPacketId, 4u> packets = {};
        for(usize readerIndex = 0u; readerIndex < readers.size(); ++readerIndex){
            packets[readerIndex] = compiledPlan.packetForTask(readers[readerIndex]);
            ASSERT_TRUE(packets[readerIndex].valid());
            EXPECT_EQ(packets[readerIndex].index, readerIndex);
            EXPECT_EQ(compiledPlan.packet(packets[readerIndex]).plan->queue, queues[readerIndex % 2u].id);
        }

        ASSERT_EQ(compiledPlan.packet(packets[0u]).plan->dependencyCount, 0u);
        ASSERT_EQ(compiledPlan.packet(packets[1u]).plan->dependencyCount, 1u);
        ASSERT_EQ(compiledPlan.packet(packets[2u]).plan->dependencyCount, 0u);
        ASSERT_EQ(compiledPlan.packet(packets[3u]).plan->dependencyCount, 2u);
        const Core::GpuPacketDependency* const secondDependencies = compiledPlan.packet(packets[1u]).dependencies;
        const Core::GpuPacketDependency* const terminalDependencies = compiledPlan.packet(packets[3u]).dependencies;
        ASSERT_NE(secondDependencies, nullptr);
        ASSERT_NE(terminalDependencies, nullptr);
        EXPECT_EQ(secondDependencies[0u].producer, packets[0u]);
        EXPECT_EQ(secondDependencies[0u].consumer, packets[1u]);
        EXPECT_EQ(terminalDependencies[0u].producer, packets[2u]);
        EXPECT_EQ(terminalDependencies[0u].consumer, packets[3u]);
        EXPECT_EQ(terminalDependencies[1u].producer, packets[1u]);
        EXPECT_EQ(terminalDependencies[1u].consumer, packets[3u]);

        for(usize readerIndex = 1u; readerIndex < readers.size(); ++readerIndex){
            const Core::GpuCompiledTask* const compiledReader = compiledPlan.findTask(readers[readerIndex]).plan;
            ASSERT_NE(compiledReader, nullptr);
            EXPECT_EQ(compiledReader->prologueStateSeedCount, 0u);
        }
        const Core::GpuCompiledTask* const terminalReader = compiledPlan.findTask(readers[3u]).plan;
        ASSERT_NE(terminalReader, nullptr);
        ASSERT_EQ(terminalReader->epilogueBarrierCount, 1u);
        const Core::GpuCompiledBarrier* const terminalBarriers = compiledPlan.findTask(readers[3u]).epilogueBarriers;
        ASSERT_NE(terminalBarriers, nullptr);
        EXPECT_EQ(terminalBarriers[0u].type, Core::GpuCompiledBarrierType::TextureStateExport);
        EXPECT_EQ(terminalBarriers[0u].before, Core::ResourceStates::ShaderResource);
        EXPECT_EQ(terminalBarriers[0u].after, Core::ResourceStates::CopySource);
    }
}

void VerifyGpuTelemetry_TerminalFinalizationReachabilityCrossesPackedWordBoundaries(){
    Array<usize, 4> prefixPacketCounts = Array<usize, 4>();
    prefixPacketCounts[0u] = 63u;
    prefixPacketCounts[1u] = 64u;
    prefixPacketCounts[2u] = 127u;
    prefixPacketCounts[3u] = 128u;
    GpuTaskResourceRange range = GpuTaskResourceRange();
    range.textureSubresources = TextureSubresourceSet(0u, 1u, 0u, 1u);

    for(in usize prefixPacketCount : prefixPacketCounts){
        TestArena testArena = TestArena();
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        const GpuTaskCommandRequirements prefixCommands = GraphicsCommands();
        GpuTaskSchedulingHint prefixScheduling = GpuTaskSchedulingHint();
        prefixScheduling.forceSubmissionBoundary = true;
        prefixScheduling.allowPacketMerge = false;
        for(usize taskIndex = 0u; taskIndex < prefixPacketCount; ++taskIndex){
            const Expected<Name> prefixNameResult = IndexedName(s_TaskGraphTerminalPackedReachabilityPrefix, taskIndex);
            ASSERT_TRUE(prefixNameResult.has_value());
            const Expected<GpuTaskId> prefixTaskResult = AddTaskWithCommands(
                prefixNameResult.value(),
                "Terminal Packed Reachability Prefix",
                prefixCommands,
                prefixScheduling,
                GpuTaskTimingMetadata(),
                Span<GpuTaskId>(),
                graph
            );
            ASSERT_TRUE(prefixTaskResult.has_value());
            const GpuTaskId prefixTask = prefixTaskResult.value();
            ASSERT_TRUE(prefixTask.valid());
        }

        const Expected<ExternalFinalReadPair> pairResult = AddExternalFinalReadPair(
            graph,
            GpuGraphResourceType::Texture,
            range,
            range,
            ResourceStates::ShaderResource,
            ResourceStates::CopySource,
            ResourceQueueSharing::GraphicsAndAsyncCompute,
            false,
            true,
            GpuPhysicalQueueId()
        );
        ASSERT_TRUE(pairResult.has_value());
        const ExternalFinalReadPair pair = pairResult.value();
        ASSERT_TRUE(pair.resource.valid());
        ASSERT_TRUE(pair.earlierReader.valid());
        ASSERT_TRUE(pair.finalizingReader.valid());

        Array<GpuTaskResourceUse, 1> terminalUses = Array<GpuTaskResourceUse, 1>();
        terminalUses[0u].resource = pair.resource;
        terminalUses[0u].range = range;
        terminalUses[0u].requiredState = ResourceStates::ShaderResource;
        terminalUses[0u].access = GpuTaskResourceAccess::Read;
        terminalUses[0u].hasIndependentStateSource = true;

        Array<GpuTaskId, 1> terminalDeps = Array<GpuTaskId, 1>();
        terminalDeps[0u] = pair.finalizingReader;

        GpuTaskSchedulingHint terminalScheduling = GpuTaskSchedulingHint();
        terminalScheduling.forceSubmissionBoundary = true;
        terminalScheduling.allowPacketMerge = false;
        GpuTaskDesc terminalDesc = GpuTaskDesc();
        terminalDesc.setIdentity(s_GpuCaseTaskGraphTerminalPackedReachabilityReader);
        terminalDesc.setMarkerLabel("Terminal Packed Reachability Reader");
        terminalDesc.setScheduling(terminalScheduling);
        terminalDesc.setDependencies(terminalDeps);
        terminalDesc.setResourceUses(terminalUses);
        const Expected<GpuTaskId> terminalReaderResult = graph.addTask(terminalDesc, GraphicsCommands());
        ASSERT_TRUE(terminalReaderResult.has_value());
        const GpuTaskId terminalReader = terminalReaderResult.value();
        ASSERT_TRUE(terminalReader.valid());

        native(mut testArena, in graph, in prefixPacketCount, in pair, in terminalReader){
            TwoQueueCompile twoQueueCompile(testArena);
            ASSERT_TRUE(twoQueueCompile.compile(graph));
            const Core::GpuCompiledGraph::ReadView compiledPlan(twoQueueCompile.compiledGraph);

            EXPECT_EQ(compiledPlan.packetCount(), prefixPacketCount + 3u);

            const Core::GpuSubmissionPacketId earlierPacket = compiledPlan.packetForTask(pair.earlierReader);
            const Core::GpuSubmissionPacketId middlePacket = compiledPlan.packetForTask(pair.finalizingReader);
            const Core::GpuSubmissionPacketId terminalPacket = compiledPlan.packetForTask(terminalReader);
            ASSERT_TRUE(earlierPacket.valid());
            ASSERT_TRUE(middlePacket.valid());
            ASSERT_TRUE(terminalPacket.valid());
            EXPECT_EQ(earlierPacket.index, prefixPacketCount);
            EXPECT_EQ(middlePacket.index, prefixPacketCount + 1u);
            EXPECT_EQ(terminalPacket.index, prefixPacketCount + 2u);
            ASSERT_EQ(compiledPlan.packet(middlePacket).plan->dependencyCount, 1u);
            ASSERT_EQ(compiledPlan.packet(terminalPacket).plan->dependencyCount, 1u);
            const Core::GpuPacketDependency* const middleDependencies = compiledPlan.packet(middlePacket).dependencies;
            const Core::GpuPacketDependency* const terminalDependencies = compiledPlan.packet(terminalPacket).dependencies;
            ASSERT_NE(middleDependencies, nullptr);
            ASSERT_NE(terminalDependencies, nullptr);
            EXPECT_EQ(middleDependencies[0u].producer, earlierPacket);
            EXPECT_EQ(terminalDependencies[0u].producer, middlePacket);
        }
    }
}

b8 GpuTelemetryHasStateExport(
    in GpuTelemetryCompiledGraphReadView compiledPlan,
    in GpuGraphResourceId texture,
    in GpuTaskId task,
    in TextureSubresourceSet range,
    in GpuTelemetryResourceStateMask before,
    in GpuPhysicalQueueId queue
){
    b8 found = false;
    native(in compiledPlan, in texture, in task, in range, in before, in queue, mut found){
        const Core::GpuCompiledTask* const compiledTask = compiledPlan.findTask(task).plan;
        const Core::GpuCompiledBarrier* const barriers = compiledPlan.findTask(task).epilogueBarriers;
        if(compiledTask && barriers){
            for(u32 barrierIndex = 0u; barrierIndex < compiledTask->epilogueBarrierCount; ++barrierIndex){
                const Core::GpuCompiledBarrier& barrier = barriers[barrierIndex];
                if(
                    barrier.type == Core::GpuCompiledBarrierType::TextureStateExport
                    && barrier.resource == texture
                    && barrier.range.textureSubresources == range
                    && barrier.before == before
                    && barrier.after == Core::ResourceStates::ShaderResource
                    && barrier.sourceQueue == queue
                    && barrier.destinationQueue == queue
                ){
                    found = true;
                    break;
                }
            }
        }
    }
    return found;
}

b8 GpuTelemetryHasExternalRelease(
    in GpuTelemetryCompiledGraphReadView compiledPlan,
    in GpuGraphResourceId texture,
    in GpuTaskId task,
    in TextureSubresourceSet range,
    in GpuPhysicalQueueId sourceQueue,
    in GpuPhysicalQueueId destinationQueue
){
    b8 found = false;
    native(in compiledPlan, in texture, in task, in range, in sourceQueue, in destinationQueue, mut found){
        const Core::GpuCompiledTask* const compiledTask = compiledPlan.findTask(task).plan;
        const Core::GpuCompiledBarrier* const barriers = compiledPlan.findTask(task).epilogueBarriers;
        if(compiledTask && barriers){
            for(u32 barrierIndex = 0u; barrierIndex < compiledTask->epilogueBarrierCount; ++barrierIndex){
                const Core::GpuCompiledBarrier& barrier = barriers[barrierIndex];
                if(
                    barrier.type == Core::GpuCompiledBarrierType::TextureOwnershipRelease
                    && barrier.resource == texture
                    && barrier.range.textureSubresources == range
                    && barrier.before == Core::ResourceStates::ShaderResource
                    && barrier.after == Core::ResourceStates::ShaderResource
                    && barrier.sourceQueue == sourceQueue
                    && barrier.destinationQueue == destinationQueue
                ){
                    found = true;
                    break;
                }
            }
        }
    }
    return found;
}

void VerifyGpuTelemetry_ExportsTextureTerminalFragmentsAfterPartialWholeResourceOverwrite(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    Array<GpuPhysicalQueueInfo, 3> queues = Array<GpuPhysicalQueueInfo, 3>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    queues[2u] = DedicatedTransferQueue();
    const GpuPhysicalQueueTopology topology = MakeGpuTelemetryTopology(queues);

    GpuGraphResourceDesc textureDesc = GpuGraphResourceDesc();
    textureDesc.setIdentity(s_GpuCaseTaskGraphExternalFinalFragmentedTexture);
    textureDesc.setMarkerLabel("External Final Fragmented Texture");
    textureDesc.setType(GpuGraphResourceType::Texture);
    textureDesc.setInitialState(ResourceStates::Common);
    textureDesc.setExternalFinalState(ResourceStates::ShaderResource);
    textureDesc.setExternalFinalReleaseDestinationQueue(queues[2u].id);
    const Expected<GpuGraphResourceId> textureResult = graph.importResource(textureDesc);
    ASSERT_TRUE(textureResult.has_value());
    const GpuGraphResourceId texture = textureResult.value();
    ASSERT_TRUE(texture.valid());

    GpuTaskResourceRange wholeRange = GpuTaskResourceRange();
    wholeRange.textureSubresources = s_GpuTelemetryAllSubresources;
    GpuTaskResourceRange overwrittenRange = GpuTaskResourceRange();
    overwrittenRange.textureSubresources = TextureSubresourceSet(0u, 1u, 0u, s_GpuTelemetryAllArraySlices);
    GpuTaskResourceRange terminalTailRange = GpuTaskResourceRange();
    terminalTailRange.textureSubresources = TextureSubresourceSet(1u, s_GpuTelemetryAllMipLevels, 0u, s_GpuTelemetryAllArraySlices);

    Array<GpuTaskResourceUse, 1> wholeWriterUses = Array<GpuTaskResourceUse, 1>();
    wholeWriterUses[0u].resource = texture;
    wholeWriterUses[0u].range = wholeRange;
    wholeWriterUses[0u].requiredState = ResourceStates::CopyDest;
    wholeWriterUses[0u].access = GpuTaskResourceAccess::Write;

    Array<GpuTaskResourceUse, 1> partialWriterUses = Array<GpuTaskResourceUse, 1>();
    partialWriterUses[0u].resource = texture;
    partialWriterUses[0u].range = overwrittenRange;
    partialWriterUses[0u].requiredState = ResourceStates::UnorderedAccess;
    partialWriterUses[0u].access = GpuTaskResourceAccess::Write;

    const GpuTaskCommandRequirements graphicsCommands = GraphicsCommands();
    const GpuTaskCommandRequirements computeCommands = ComputeCommands();
    GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
    scheduling.forceSubmissionBoundary = true;
    scheduling.allowPacketMerge = false;

    GpuTaskDesc wholeWriterDesc = GpuTaskDesc();
    wholeWriterDesc.setIdentity(s_GpuCaseTaskGraphExternalFinalFragmentedWholeWriter);
    wholeWriterDesc.setMarkerLabel("External Final Fragmented Whole Writer");
    wholeWriterDesc.setScheduling(scheduling);
    wholeWriterDesc.setResourceUses(wholeWriterUses);

    GpuTaskDesc partialWriterDesc = GpuTaskDesc();
    partialWriterDesc.setIdentity(s_GpuCaseTaskGraphExternalFinalFragmentedPartialWriter);
    partialWriterDesc.setMarkerLabel("External Final Fragmented Partial Writer");
    partialWriterDesc.setScheduling(scheduling);
    partialWriterDesc.setResourceUses(partialWriterUses);

    const Expected<GpuTaskId> wholeWriterResult = graph.addTask(wholeWriterDesc, graphicsCommands);
    ASSERT_TRUE(wholeWriterResult.has_value());
    const GpuTaskId wholeWriter = wholeWriterResult.value();
    const Expected<GpuTaskId> partialWriterResult = graph.addTask(partialWriterDesc, computeCommands);
    ASSERT_TRUE(partialWriterResult.has_value());
    const GpuTaskId partialWriter = partialWriterResult.value();
    ASSERT_TRUE(wholeWriter.valid());
    ASSERT_TRUE(partialWriter.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    const GpuTelemetryCompiledGraphReadView compiledPlan = GpuTelemetryCompiledGraphReadView(compiledGraph);

    native(in compiledPlan, in wholeWriter, in partialWriter, in texture, in queues, in terminalTailRange, in overwrittenRange){
        const Core::GpuCompiledTask* const compiledWholeWriter = compiledPlan.findTask(wholeWriter).plan;
        const Core::GpuCompiledTask* const compiledPartialWriter = compiledPlan.findTask(partialWriter).plan;
        ASSERT_NE(compiledWholeWriter, nullptr);
        ASSERT_NE(compiledPartialWriter, nullptr);
        EXPECT_EQ(compiledWholeWriter->queue, queues[0u].id);
        EXPECT_EQ(compiledPartialWriter->queue, queues[1u].id);

        const Core::GpuCompiledExternalResourceExportView exportView = compiledPlan.externalResourceExport(texture);
        const Core::GpuCompiledExternalResourceExport* const exportInfo = exportView.plan;
        ASSERT_NE(exportInfo, nullptr);
        EXPECT_EQ(exportInfo->resource, texture);
        EXPECT_EQ(exportInfo->destinationQueue, queues[2u].id);
        EXPECT_EQ(exportInfo->finalState, Core::ResourceStates::ShaderResource);
        EXPECT_FALSE(exportInfo->producerTask.valid());
        EXPECT_FALSE(exportInfo->sourceQueue.valid());
        ASSERT_EQ(exportInfo->sourceCount, 2u);
        const Core::GpuCompiledExternalResourceExportSource* const sources = exportView.sources;
        ASSERT_NE(sources, nullptr);
        b8 hasWholeWriterTail = false;
        b8 hasPartialWriterMipZero = false;
        for(u32 sourceIndex = 0u; sourceIndex < exportInfo->sourceCount; ++sourceIndex){
            const Core::GpuCompiledExternalResourceExportSource& source = sources[sourceIndex];
            hasWholeWriterTail = hasWholeWriterTail || (source.producerTask == wholeWriter && source.sourceQueue == queues[0u].id && source.range.textureSubresources == terminalTailRange.textureSubresources);
            hasPartialWriterMipZero = hasPartialWriterMipZero || (source.producerTask == partialWriter && source.sourceQueue == queues[1u].id && source.range.textureSubresources == overwrittenRange.textureSubresources);
        }
        EXPECT_TRUE(hasWholeWriterTail);
        EXPECT_TRUE(hasPartialWriterMipZero);
    }

    EXPECT_TRUE(GpuTelemetryHasStateExport(compiledPlan, texture, wholeWriter, terminalTailRange.textureSubresources, ResourceStates::CopyDest, queues[0u].id));
    EXPECT_TRUE(GpuTelemetryHasStateExport(compiledPlan, texture, partialWriter, overwrittenRange.textureSubresources, ResourceStates::UnorderedAccess, queues[1u].id));
    EXPECT_TRUE(GpuTelemetryHasExternalRelease(compiledPlan, texture, wholeWriter, terminalTailRange.textureSubresources, queues[0u].id, queues[2u].id));
    EXPECT_TRUE(GpuTelemetryHasExternalRelease(compiledPlan, texture, partialWriter, overwrittenRange.textureSubresources, queues[1u].id, queues[2u].id));
}

void GpuTelemetryTakeSnapshot(in GpuTaskTimingHistoryStore store, mut GpuTaskTimingHistorySnapshot snapshot){
    native(in store, mut snapshot){
        store.snapshot(snapshot);
    }
}

void VerifyGpuTelemetry_RanksEqualDurationsAfterShorterCandidateAppears(){
    ScratchArena scratch = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuTelemetryAssignmentVector assignments = GpuTelemetryAssignmentVector(testArena.arena);
    GpuTelemetryU32Vector assignmentIndices = GpuTelemetryU32Vector(testArena.arena);
    assignments.reserve(4u);
    assignmentIndices.reserve(4u);

    Array<GpuPhysicalQueueInfo, 5> queues = Array<GpuPhysicalQueueInfo, 5>();
    queues[0u] = GraphicsQueue();
    queues[1u] = GraphicsQueue(1u);
    queues[2u] = GraphicsQueue(2u);
    queues[3u] = GraphicsQueue(3u);
    queues[4u] = GraphicsQueue(4u);
    for(usize queueIndex = 1u; queueIndex < queues.size(); ++queueIndex)
        queues[queueIndex].queueIndex = cast<u32>(queueIndex);

    Array<GpuTelemetryCostHintEnum, 4> costs = Array<GpuTelemetryCostHintEnum, 4>();
    costs[0u] = GpuTaskCostHint::Large;
    costs[1u] = GpuTaskCostHint::Large;
    costs[2u] = GpuTaskCostHint::Medium;
    costs[3u] = GpuTaskCostHint::Medium;

    Array<usize, 4> assignedQueues = Array<usize, 4>();
    assignedQueues[0u] = 2u;
    assignedQueues[1u] = 3u;
    assignedQueues[2u] = 4u;
    assignedQueues[3u] = 0u;

    GpuTaskId target = GpuTaskId();
    for(usize taskIndex = 0u; taskIndex < costs.size(); ++taskIndex){
        const Expected<Name> identityNameResult = IndexedName(s_GpuCaseTimingScalingTied, taskIndex);
        ASSERT_TRUE(identityNameResult.has_value());
        const Name identity = identityNameResult.value();
        GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
        scheduling.cost = costs[taskIndex];
        scheduling.allowSameClassQueueRouting = true;
        scheduling.allowTimingFeedbackRouting = true;
        const Expected<GpuTaskId> targetTaskAdmission = AddTaskWithCommands(
            identity,
            "Tied Duration Timing Task",
            GraphicsCommands(),
            scheduling,
            GpuTaskTimingMetadata(),
            Span<GpuTaskId>(),
            graph
        );
        ASSERT_TRUE(targetTaskAdmission.has_value());
        target = targetTaskAdmission.value();
        ASSERT_TRUE(target.valid());
        const GpuPhysicalQueueId queue = queues[assignedQueues[taskIndex]].id;
        GpuTaskQueueAssignment item = GpuTaskQueueAssignment();
        item.task = target;
        item.initialQueue = queue;
        item.queue = queue;
        assignments.push_back(item);
        assignmentIndices.push_back(cast<u32>(taskIndex));
    }

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, scratch, analysis));
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
    const GpuTaskGraphTaskView task = declarations.taskAt(target.index);

    GpuTaskTimingKey historyKey = GpuTaskTimingKey();
    historyKey.task = task.identity;
    historyKey.queue = CommandQueue::Graphics;
    GpuTaskTimingAssignmentKey assignmentKey = GpuTaskTimingAssignmentKey();
    assignmentKey.task = task.identity;

    Array<f64, 5> durations = Array<f64, 5>();
    durations[0u] = 0.010;
    durations[1u] = 0.004;
    durations[2u] = 0.004;
    durations[3u] = 0.002;
    durations[4u] = 0.002;

    GpuTaskTimingHistoryStore history = GpuTaskTimingHistoryStore(testArena.arena, 1u);
    for(usize queueIndex = 0u; queueIndex < queues.size(); ++queueIndex)
        ASSERT_TRUE(history.recordNonCommittingSample(historyKey, queues[queueIndex].id, durations[queueIndex]));
    ASSERT_TRUE(history.noteAcceptedAssignment(historyKey, queues[0u].id, 1u));
    GpuTaskTimingHistorySnapshot snapshot = GpuTaskTimingHistorySnapshot(testArena.arena);
    GpuTelemetryTakeSnapshot(history, snapshot);
    ASSERT_TRUE(snapshot.valid());

    GpuTaskTimingFeedbackPolicy timingPolicy = GpuTaskTimingFeedbackPolicy();
    timingPolicy.minimumAbsoluteBenefitSeconds = 0.0;
    timingPolicy.minimumRelativeBenefit = 0.1;
    timingPolicy.minimumFramesBetweenSwitches = 0u;
    timingPolicy.minimumSampleCount = 1u;
    timingPolicy.calibrationIntervalFrames = 0u;
    timingPolicy.enabled = true;

    Array<Array<usize, 4>, 5> candidateOrders = Array<Array<usize, 4>, 5>();
    candidateOrders[0u][0u] = 1u;
    candidateOrders[0u][1u] = 2u;
    candidateOrders[0u][2u] = 3u;
    candidateOrders[0u][3u] = 4u;

    candidateOrders[1u][0u] = 2u;
    candidateOrders[1u][1u] = 1u;
    candidateOrders[1u][2u] = 3u;
    candidateOrders[1u][3u] = 4u;

    candidateOrders[2u][0u] = 4u;
    candidateOrders[2u][1u] = 3u;
    candidateOrders[2u][2u] = 2u;
    candidateOrders[2u][3u] = 1u;

    candidateOrders[3u][0u] = 3u;
    candidateOrders[3u][1u] = 4u;
    candidateOrders[3u][2u] = 1u;
    candidateOrders[3u][3u] = 2u;

    candidateOrders[4u][0u] = 1u;
    candidateOrders[4u][1u] = 3u;
    candidateOrders[4u][2u] = 2u;
    candidateOrders[4u][3u] = 4u;

    native(
        mut scratch,
        in declarations,
        in analysis,
        in assignments,
        in assignmentIndices,
        in queues,
        in task,
        in assignmentKey,
        in snapshot,
        in timingPolicy,
        in candidateOrders
    ){
        GpuTelemetrySchedulingReachability reachability(scratch);
        ASSERT_TRUE(Core::GpuTaskGraphCompilerDetail::BuildGpuTaskSchedulingReachability(declarations, analysis, reachability));
        GpuTelemetryScoringData scoringData(declarations, analysis, reachability, {}, scratch);
        for(const auto& candidateOrder : candidateOrders){
            SCOPED_TRACE(candidateOrder[0u]);
            Array<Core::GpuPhysicalQueueInfo, 5u> reorderedQueues = {};
            reorderedQueues[0u] = queues[0u];
            for(usize queueIndex = 0u; queueIndex < candidateOrder.size(); ++queueIndex)
                reorderedQueues[queueIndex + 1u] = queues[candidateOrder[queueIndex]];
            const Core::GpuPhysicalQueueTopology topology{ .queues = reorderedQueues.data(), .queueCount = reorderedQueues.size() };
            ASSERT_TRUE(Core::GpuTaskGraphCompilerDetail::IsValidQueueTopology(topology));
            scoringData.rebuildAssignmentLoads(assignments, topology);
            const Core::GpuPhysicalQueueInfo* const selected = Core::GpuTaskGraphCompilerDetail::FindTimingFeedbackQueue(
                declarations,
                analysis,
                assignments,
                assignmentIndices,
                topology,
                reachability,
                scoringData,
                task,
                reorderedQueues[0u],
                assignmentKey,
                snapshot,
                timingPolicy,
                100u
            );
            ASSERT_NE(selected, nullptr);
            // Queue one wins the slow tie while queue two wins the fast tie by lower load.
            EXPECT_EQ(selected->id, queues[4u].id);
        }
    }
}

void VerifyGpuTelemetry_PreservesEveryRouteKeyFieldAndFullNameIdentity(){
    GpuTelemetryHistoryScope scope = GpuTelemetryHistoryScope(s_GpuCaseTimingHistoryFullIdentity);
    for(u32 index = 100u; index < 164u; ++index){
        const GpuTelemetryTimingInput input = MakeGpuTelemetryTimingInput(index);
        ASSERT_TRUE(scope.store.recordNonCommittingSample(input.key, input.queue, 1.0));
    }
    const GpuTelemetryTimingInput base = MakeGpuTelemetryTimingInput(0u);
    Array<GpuTelemetryTimingInput, 13> inputs = Array<GpuTelemetryTimingInput, 13>();
    for(usize index = 0u; index < inputs.size(); ++index)
        inputs[index] = base;
    inputs[1u].key.variant = 1u;
    inputs[2u].key.resolutionClass = 1u;
    inputs[3u].key.queue = CommandQueue::Compute;
    inputs[4u].queue.index = 1u;
    for(u32 lane = 0u; lane < s_GpuTelemetryNameHashLaneCount; ++lane)
        inputs[5u + cast<usize>(lane)].key.task = MakeGpuTelemetryFlippedHashName(base.key.task, lane);

    for(usize index = 0u; index < inputs.size(); ++index)
        ASSERT_TRUE(scope.store.recordNonCommittingSample(inputs[index].key, inputs[index].queue, cast<f64>(index + 1u)));
    EXPECT_EQ(scope.store.historyCount(), inputs.size() + 64u);
    GpuTelemetryTakeSnapshot(scope.store, scope.snapshot);
    ASSERT_TRUE(scope.snapshot.valid());

    native(in scope, in inputs){
        for(usize index = 0u; index < inputs.size(); ++index){
            const Core::GpuTaskTimingHistory* const history = scope.store.find(inputs[index].key, inputs[index].queue);
            const Core::GpuTaskTimingHistory* const frozen = scope.snapshot.find(inputs[index].key, inputs[index].queue);
            ASSERT_NE(history, nullptr);
            ASSERT_NE(frozen, nullptr);
            EXPECT_DOUBLE_EQ(history->averageSeconds, static_cast<f64>(index + 1u));
            EXPECT_DOUBLE_EQ(frozen->averageSeconds, history->averageSeconds);
            EXPECT_EQ(history->sampleCount, 1u);
            EXPECT_EQ(scope.snapshot.findAssignment(Core::GpuTaskTimingAssignmentKeyFromHistoryKey(inputs[index].key)), nullptr);
        }
    }

    GpuPhysicalQueueId foreignQueue = base.queue;
    ++foreignQueue.deviceGeneration;
    EXPECT_FALSE(scope.store.recordSample(base.key, foreignQueue, 1.0, 1u));
    native(in scope, in base, in foreignQueue){
        EXPECT_EQ(scope.store.find(base.key, foreignQueue), nullptr);
        EXPECT_EQ(scope.snapshot.find(base.key, foreignQueue), nullptr);
        EXPECT_EQ(scope.snapshot.find({}, base.queue), nullptr);
        EXPECT_EQ(scope.snapshot.find(base.key, {}), nullptr);
    }
    EXPECT_EQ(scope.store.historyCount(), inputs.size() + 64u);
}

void VerifyGpuTelemetry_KeepsSemanticAssignmentsAcrossQueueClassChangesAndLateSamples(){
    GpuTelemetryHistoryScope scope = GpuTelemetryHistoryScope(s_GpuCaseTimingHistoryAssignmentOrder, 2u);
    for(u32 index = 1u; index < 80u; ++index){
        const GpuTelemetryTimingInput input = MakeGpuTelemetryTimingInput(index);
        ASSERT_TRUE(scope.store.recordSample(input.key, input.queue, 1.0, 1u));
    }
    const GpuTelemetryTimingInput graphics = MakeGpuTelemetryTimingInput(0u);
    GpuTelemetryTimingInput compute = graphics;
    compute.key.queue = CommandQueue::Compute;
    compute.queue.index = 8u;
    const GpuTaskTimingAssignmentKey assignmentKey = GpuTaskTimingAssignmentKeyFromHistoryKey(graphics.key);
    ASSERT_TRUE(scope.store.recordSample(graphics.key, graphics.queue, 2.0, 10u));
    ASSERT_TRUE(scope.store.recordSample(compute.key, compute.queue, 4.0, 20u));
    ASSERT_TRUE(scope.store.recordSample(graphics.key, graphics.queue, 6.0, 5u));
    ASSERT_TRUE(scope.store.recordSample(graphics.key, graphics.queue, 10.0, 6u));
    ASSERT_FALSE(scope.store.recordSample(graphics.key, graphics.queue, 99.0, 20u));
    ASSERT_TRUE(scope.store.noteAcceptedAssignment(compute.key, compute.queue, 20u));
    native(in scope, in assignmentKey, in compute, in graphics){
        const Core::GpuTaskTimingAssignmentState* const state = scope.store.findAssignment(assignmentKey);
        ASSERT_NE(state, nullptr);
        EXPECT_EQ(state->lastAcceptedQueue, compute.queue);
        EXPECT_EQ(state->lastAcceptedFrameIndex, 20u);
        EXPECT_EQ(state->lastSwitchFrameIndex, 20u);
        const Core::GpuTaskTimingHistory* const history = scope.store.find(graphics.key, graphics.queue);
        ASSERT_NE(history, nullptr);
        EXPECT_DOUBLE_EQ(history->averageSeconds, 8.0);
        EXPECT_DOUBLE_EQ(history->minimumSeconds, 6.0);
        EXPECT_DOUBLE_EQ(history->maximumSeconds, 10.0);
        EXPECT_EQ(history->sampleCount, 2u);
    }
    ASSERT_TRUE(scope.store.recordNonCommittingSample(graphics.key, graphics.queue, 14.0));
    native(in scope, in assignmentKey, in compute){
        ASSERT_NE(scope.store.findAssignment(assignmentKey), nullptr);
        EXPECT_EQ(scope.store.findAssignment(assignmentKey)->lastAcceptedQueue, compute.queue);
    }
    ASSERT_TRUE(scope.store.noteAcceptedAssignment(graphics.key, graphics.queue, 30u));
    native(in scope, in assignmentKey, in graphics){
        const Core::GpuTaskTimingAssignmentState* const state = scope.store.findAssignment(assignmentKey);
        ASSERT_NE(state, nullptr);
        EXPECT_EQ(state->lastAcceptedQueue, graphics.queue);
        EXPECT_EQ(state->lastSwitchFrameIndex, 30u);
    }
    EXPECT_EQ(scope.store.historyCount(), 81u);
}

void VerifyGpuTelemetry_PreservesOrderedAverageAndExtremaAcrossRollingWindows(){
    const u32 capacity = 4u;
    GpuTelemetryHistoryScope scope = GpuTelemetryHistoryScope(s_GpuCaseTimingHistoryOrderedReduction, capacity);
    const GpuTelemetryTimingInput input = MakeGpuTelemetryTimingInput(0u);
    Array<f64, 9> samples = Array<f64, 9>();
    samples[0u] = 1.0e100;
    samples[1u] = 1.0;
    samples[2u] = 3.0e99;
    samples[3u] = 2.0;
    samples[4u] = 5.0e99;
    samples[5u] = 3.0;
    samples[6u] = 7.0e99;
    samples[7u] = 7.0e99;
    samples[8u] = 4.0;

    for(usize index = 0u; index < samples.size(); ++index){
        ASSERT_TRUE(scope.store.recordNonCommittingSample(input.key, input.queue, samples[index]));
        usize begin = 0u;
        if(index >= cast<usize>(capacity))
            begin = index + 1u - cast<usize>(capacity);
        f64 expectedAverage = 0.0;
        f64 expectedMinimum = samples[begin];
        f64 expectedMaximum = samples[begin];
        u32 expectedCount = 0u;
        // Independent scalar oracle fixes the original reduction order and exact rounding.
        for(usize sampleIndex = begin; sampleIndex <= index; ++sampleIndex){
            ++expectedCount;
            expectedAverage += (samples[sampleIndex] - expectedAverage) / cast<f64>(expectedCount);
            if(samples[sampleIndex] < expectedMinimum)
                expectedMinimum = samples[sampleIndex];
            if(samples[sampleIndex] > expectedMaximum)
                expectedMaximum = samples[sampleIndex];
        }
        const u64 expectedAverageBits = bit_cast<u64>(expectedAverage);
        const u64 expectedMinBits = bit_cast<u64>(expectedMinimum);
        const u64 expectedMaxBits = bit_cast<u64>(expectedMaximum);
        native(in scope, in input, in expectedAverageBits, in expectedMinBits, in expectedMaxBits, in expectedCount){
            const Core::GpuTaskTimingHistory* const history = scope.store.find(input.key, input.queue);
            ASSERT_NE(history, nullptr);
            EXPECT_EQ(BitCast<u64>(history->averageSeconds), expectedAverageBits);
            EXPECT_EQ(BitCast<u64>(history->minimumSeconds), expectedMinBits);
            EXPECT_EQ(BitCast<u64>(history->maximumSeconds), expectedMaxBits);
            EXPECT_EQ(history->sampleCount, expectedCount);
            EXPECT_TRUE(history->valid());
        }
    }
}

void VerifyGpuTelemetry_PreservesAbsoluteAndRelativeHysteresisThresholds(){
    GpuTaskTimingHistory incumbent = GpuTaskTimingHistory();
    incumbent.averageSeconds = 8.0;
    incumbent.minimumSeconds = 8.0;
    incumbent.maximumSeconds = 8.0;
    incumbent.sampleCount = 1u;

    GpuTaskTimingHistory candidate = GpuTaskTimingHistory();
    candidate.averageSeconds = 6.0;
    candidate.minimumSeconds = 6.0;
    candidate.maximumSeconds = 6.0;
    candidate.sampleCount = 1u;

    GpuTaskTimingFeedbackPolicy policy = GpuTaskTimingFeedbackPolicy();
    policy.minimumAbsoluteBenefitSeconds = 2.0;
    policy.minimumRelativeBenefit = 0.25;
    EXPECT_TRUE(BenefitExceedsGpuTelemetryHysteresis(incumbent, candidate, policy));
    policy.minimumAbsoluteBenefitSeconds = 2.0000000000000004;
    EXPECT_FALSE(BenefitExceedsGpuTelemetryHysteresis(incumbent, candidate, policy));
    policy.minimumAbsoluteBenefitSeconds = 2.0;
    policy.minimumRelativeBenefit = 0.25000000000000006;
    EXPECT_FALSE(BenefitExceedsGpuTelemetryHysteresis(incumbent, candidate, policy));
    EXPECT_FALSE(BenefitExceedsGpuTelemetryHysteresis(candidate, incumbent, policy));
    EXPECT_FALSE(BenefitExceedsGpuTelemetryHysteresis(incumbent, incumbent, policy));
}

void VerifyGpuTelemetry_SnapshotSurvivesStoreGrowthResetAndReplacementInAnotherArena(){
    GpuTelemetryGraphicsArena storeArena = GpuTelemetryGraphicsArena(s_GpuCaseTimingHistoryStoreOwner);
    GpuTelemetryHistoryScope snapshotOwner = GpuTelemetryHistoryScope(s_GpuCaseTimingHistorySnapshotOwner);
    const GpuTelemetryTimingInput first = MakeGpuTelemetryTimingInput(0u);
    native(mut storeArena, mut snapshotOwner, in first){
        {
            Core::GpuTaskTimingHistoryStore store(storeArena, 3u);
            for(u32 index = 0u; index < 512u; ++index){
                const GpuTelemetryTimingInput input = MakeGpuTelemetryTimingInput((index * 73u) % 512u);
                ASSERT_TRUE(store.recordSample(input.key, input.queue, static_cast<f64>(input.key.variant + 1u), 10u));
            }
            store.snapshot(snapshotOwner.snapshot);
            ASSERT_TRUE(snapshotOwner.snapshot.valid());
            const GpuTelemetryTimingInput absent = MakeGpuTelemetryTimingInput(4096u);
            EXPECT_EQ(store.find(absent.key, absent.queue), nullptr);
            EXPECT_EQ(store.findAssignment(Core::GpuTaskTimingAssignmentKeyFromHistoryKey(absent.key)), nullptr);
            EXPECT_EQ(snapshotOwner.snapshot.find(absent.key, absent.queue), nullptr);
            EXPECT_EQ(snapshotOwner.snapshot.findAssignment(Core::GpuTaskTimingAssignmentKeyFromHistoryKey(absent.key)), nullptr);
            store.resetForDeviceGeneration(1u);
            EXPECT_EQ(store.historyCount(), 512u);
            for(u32 index = 0u; index < 512u; ++index){
                const GpuTelemetryTimingInput input = MakeGpuTelemetryTimingInput(index);
                const Core::GpuTaskTimingHistory* const history = snapshotOwner.snapshot.find(input.key, input.queue);
                ASSERT_NE(history, nullptr);
                EXPECT_DOUBLE_EQ(history->averageSeconds, static_cast<f64>(index + 1u));
                const Core::GpuTaskTimingAssignmentState* const state = snapshotOwner.snapshot.findAssignment(Core::GpuTaskTimingAssignmentKeyFromHistoryKey(input.key));
                ASSERT_NE(state, nullptr);
                EXPECT_EQ(state->lastAcceptedFrameIndex, 10u);
            }
            ASSERT_TRUE(store.recordSample(first.key, first.queue, 9.0, 20u));
            for(u32 index = 512u; index < 1024u; ++index){
                const GpuTelemetryTimingInput input = MakeGpuTelemetryTimingInput(index);
                ASSERT_TRUE(store.recordSample(input.key, input.queue, 1.0, 20u));
            }
            EXPECT_DOUBLE_EQ(snapshotOwner.snapshot.find(first.key, first.queue)->averageSeconds, 1.0);
            EXPECT_EQ(snapshotOwner.snapshot.findAssignment(Core::GpuTaskTimingAssignmentKeyFromHistoryKey(first.key))->lastAcceptedFrameIndex, 10u);
            const GpuTelemetryTimingInput newer = MakeGpuTelemetryTimingInput(600u);
            EXPECT_EQ(snapshotOwner.snapshot.find(newer.key, newer.queue), nullptr);
            store.resetForDeviceGeneration(2u);
            EXPECT_EQ(store.historyCount(), 0u);
            EXPECT_EQ(store.find(first.key, first.queue), nullptr);
            EXPECT_EQ(store.findAssignment(Core::GpuTaskTimingAssignmentKeyFromHistoryKey(first.key)), nullptr);
        }
        EXPECT_EQ(storeArena.memoryStats().usedBytes, 0u);
        ASSERT_NE(snapshotOwner.snapshot.find(first.key, first.queue), nullptr);
        EXPECT_DOUBLE_EQ(snapshotOwner.snapshot.find(first.key, first.queue)->averageSeconds, 1.0);

        Core::GpuTaskTimingHistoryStore replacement(storeArena);
        ASSERT_TRUE(replacement.recordSample(first.key, first.queue, 3.0, 30u));
        replacement.reset(snapshotOwner.snapshot);
        EXPECT_EQ(snapshotOwner.snapshot.deviceGeneration(), 0u);
        EXPECT_EQ(replacement.deviceGeneration(), 0u);
        EXPECT_EQ(replacement.historyCount(), 0u);
        EXPECT_FALSE(snapshotOwner.snapshot.valid());
        EXPECT_EQ(snapshotOwner.snapshot.find(first.key, first.queue), nullptr);

        replacement.resetForDeviceGeneration(2u);
        const GpuTelemetryTimingInput newGeneration = MakeGpuTelemetryTimingInput(0u, 2u);
        ASSERT_TRUE(replacement.recordSample(newGeneration.key, newGeneration.queue, 7.0, 1u));
        replacement.snapshot(snapshotOwner.snapshot);
        EXPECT_EQ(snapshotOwner.snapshot.deviceGeneration(), 2u);
        EXPECT_EQ(snapshotOwner.snapshot.find(first.key, first.queue), nullptr);
        ASSERT_NE(snapshotOwner.snapshot.find(newGeneration.key, newGeneration.queue), nullptr);
        EXPECT_DOUBLE_EQ(snapshotOwner.snapshot.find(newGeneration.key, newGeneration.queue)->averageSeconds, 7.0);
        replacement.resetForDeviceGeneration(0u);
        replacement.snapshot(snapshotOwner.snapshot);
        EXPECT_FALSE(snapshotOwner.snapshot.valid());
        EXPECT_EQ(snapshotOwner.snapshot.findAssignment(Core::GpuTaskTimingAssignmentKeyFromHistoryKey(first.key)), nullptr);
    }
}

void VerifyGpuTelemetry_RejectedInputDoesNotCreateHistoryOrAssignmentState(){
    GpuTelemetryHistoryScope scope = GpuTelemetryHistoryScope(s_GpuCaseTimingHistoryRejections);
    const GpuTelemetryTimingInput input = MakeGpuTelemetryTimingInput(0u);
    EXPECT_FALSE(scope.store.recordSample(GpuTaskTimingKey(), input.queue, 1.0, 1u));
    EXPECT_FALSE(scope.store.recordSample(input.key, GpuPhysicalQueueId(), 1.0, 1u));
    Array<f64, 3> invalidDurations = Array<f64, 3>();
    invalidDurations[0u] = 0.0;
    invalidDurations[1u] = -1.0;
    invalidDurations[2u] = f64.max;
    for(in f64 duration : invalidDurations){
        EXPECT_FALSE(scope.store.recordSample(input.key, input.queue, duration, 1u));
        EXPECT_FALSE(scope.store.recordNonCommittingSample(input.key, input.queue, duration));
    }
    EXPECT_EQ(scope.store.deviceGeneration(), 0u);
    EXPECT_EQ(scope.store.historyCount(), 0u);
    native(in scope, in input){
        EXPECT_EQ(scope.store.findAssignment(Core::GpuTaskTimingAssignmentKeyFromHistoryKey(input.key)), nullptr);
    }
    GpuTelemetryTakeSnapshot(scope.store, scope.snapshot);
    EXPECT_FALSE(scope.snapshot.valid());
    scope.store.resetForDeviceGeneration(1u);
    GpuTelemetryTakeSnapshot(scope.store, scope.snapshot);
    EXPECT_TRUE(scope.snapshot.valid());
    native(in scope, in input){
        EXPECT_EQ(scope.snapshot.find(input.key, input.queue), nullptr);
    }
}

void VerifyGpuTelemetry_PromotesHistoryAndAssignmentCollectionsIndependentlyAndReusesResetStorage(){
    GpuTelemetryDualStoreScope scope = GpuTelemetryDualStoreScope(s_GpuCaseTimingHistoryIndependentCollections);
    for(u32 index = 0u; index < 80u; ++index){
        const GpuTelemetryTimingInput input = MakeGpuTelemetryTimingInput(index);
        ASSERT_TRUE(scope.historyStore.recordNonCommittingSample(input.key, input.queue, 1.0));
        ASSERT_TRUE(scope.assignmentStore.noteAcceptedAssignment(input.key, input.queue, 10u));
    }
    const GpuTelemetryTimingInput first = MakeGpuTelemetryTimingInput(0u);
    const GpuTaskTimingAssignmentKey assignmentKey = GpuTaskTimingAssignmentKeyFromHistoryKey(first.key);
    GpuTelemetryTakeSnapshot(scope.historyStore, scope.snapshot);
    native(in scope, in first, in assignmentKey){
        ASSERT_NE(scope.snapshot.find(first.key, first.queue), nullptr);
        EXPECT_EQ(scope.snapshot.findAssignment(assignmentKey), nullptr);
    }
    GpuTelemetryTakeSnapshot(scope.assignmentStore, scope.snapshot);
    native(in scope, in first, in assignmentKey){
        EXPECT_EQ(scope.snapshot.find(first.key, first.queue), nullptr);
        ASSERT_NE(scope.snapshot.findAssignment(assignmentKey), nullptr);
    }
    EXPECT_EQ(scope.assignmentStore.historyCount(), 0u);
    ASSERT_TRUE(scope.assignmentStore.recordNonCommittingSample(first.key, first.queue, 3.0));
    GpuTelemetryTakeSnapshot(scope.assignmentStore, scope.snapshot);
    native(in scope, in first, in assignmentKey){
        ASSERT_NE(scope.snapshot.find(first.key, first.queue), nullptr);
        EXPECT_DOUBLE_EQ(scope.snapshot.find(first.key, first.queue)->averageSeconds, 3.0);
        EXPECT_EQ(scope.snapshot.findAssignment(assignmentKey)->lastAcceptedFrameIndex, 10u);
    }
    scope.historyStore.reset();
    ASSERT_TRUE(scope.historyStore.recordSample(first.key, first.queue, 7.0, 30u));
    GpuTelemetryTakeSnapshot(scope.historyStore, scope.snapshot);
    const GpuTelemetryTimingInput stale = MakeGpuTelemetryTimingInput(79u);
    native(in scope, in first, in assignmentKey, in stale){
        ASSERT_NE(scope.snapshot.find(first.key, first.queue), nullptr);
        EXPECT_DOUBLE_EQ(scope.snapshot.find(first.key, first.queue)->averageSeconds, 7.0);
        EXPECT_EQ(scope.snapshot.findAssignment(assignmentKey)->lastAcceptedFrameIndex, 30u);
        EXPECT_EQ(scope.snapshot.find(stale.key, stale.queue), nullptr);
        EXPECT_EQ(scope.snapshot.findAssignment(Core::GpuTaskTimingAssignmentKeyFromHistoryKey(stale.key)), nullptr);
    }
}

Expected<GpuTaskId> GpuTelemetryAddTimingTaskFull(
    mut GpuTaskGraph graph,
    in Name identity,
    in GpuTaskId dependency,
    in GpuTaskSchedulingHint scheduling,
    in GpuTaskTimingMetadata timing
){
    GpuTaskDesc desc = GpuTaskDesc();
    desc.setIdentity(identity);
    desc.setMarkerLabel("Task Graph Timing Test");
    desc.setScheduling(scheduling);
    desc.setTiming(timing);
    if(dependency.valid()){
        Array<GpuTaskId, 1> deps = Array<GpuTaskId, 1>();
        deps[0u] = dependency;
        desc.setDependencies(deps);
        return graph.addTask(desc);
    }
    return graph.addTask(desc);
}

Expected<GpuTaskId> GpuTelemetryAddTimingTask(mut GpuTaskGraph graph, in Name identity){
    return GpuTelemetryAddTimingTaskFull(graph, identity, GpuTaskId(), GpuTaskSchedulingHint(), GpuTaskTimingMetadata());
}

Expected<GpuTaskId> GpuTelemetryAddTimingTaskDep(mut GpuTaskGraph graph, in Name identity, in GpuTaskId dependency){
    return GpuTelemetryAddTimingTaskFull(graph, identity, dependency, GpuTaskSchedulingHint(), GpuTaskTimingMetadata());
}

Expected<GpuTaskId> GpuTelemetryAddTimingTaskSched(
    mut GpuTaskGraph graph,
    in Name identity,
    in GpuTaskId dependency,
    in GpuTaskSchedulingHint scheduling
){
    return GpuTelemetryAddTimingTaskFull(graph, identity, dependency, scheduling, GpuTaskTimingMetadata());
}

b8 GpuTelemetryCompileWithOptions(
    mut GpuTaskGraphAnalysis analysis,
    mut GpuTaskGraphQueueAssignments assignments,
    mut GpuCompiledGraph compiledGraph,
    mut ScratchArena scratchArena,
    in GpuTaskGraph graph,
    in GpuTaskGraphCompileOptions options
){
    Array<GpuPhysicalQueueInfo, 1> queues = Array<GpuPhysicalQueueInfo, 1>();
    queues[0u] = GraphicsQueue();
    const GpuPhysicalQueueTopology topology = MakeGpuTelemetryTopology(queues);
    return Compile(analysis, assignments, compiledGraph, scratchArena, graph, topology, options);
}

b8 GpuTelemetryCompileDefault(
    mut GpuTaskGraphAnalysis analysis,
    mut GpuTaskGraphQueueAssignments assignments,
    mut GpuCompiledGraph compiledGraph,
    mut ScratchArena scratchArena,
    in GpuTaskGraph graph
){
    return GpuTelemetryCompileWithOptions(analysis, assignments, compiledGraph, scratchArena, graph, GpuTaskGraphCompileOptions());
}

void VerifyGpuTelemetry_CompilesInclusivePacketEnvelopeWithoutChangingTaskPolicies(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    GpuTelemetryTimingTestArena testArena = GpuTelemetryTimingTestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuTaskId> prefixResult = GpuTelemetryAddTimingTask(graph, s_GpuCaseTaskGraphTimingEnvelopePrefix);
    ASSERT_TRUE(prefixResult.has_value());
    const GpuTaskId prefix = prefixResult.value();
    ASSERT_TRUE(prefix.valid());

    const Expected<GpuTaskId> firstPacketPrefixResult = GpuTelemetryAddTimingTaskDep(graph, s_GpuCaseTaskGraphTimingEnvelopeFirstPacketPrefix, prefix);
    ASSERT_TRUE(firstPacketPrefixResult.has_value());
    const GpuTaskId firstPacketPrefix = firstPacketPrefixResult.value();
    ASSERT_TRUE(firstPacketPrefix.valid());

    GpuTaskSchedulingHint mergedScheduling = GpuTaskSchedulingHint();
    mergedScheduling.mergeWithPrevious = true;
    const Expected<GpuTaskId> firstEndpointResult = GpuTelemetryAddTimingTaskSched(graph, s_GpuCaseTaskGraphTimingEnvelopeFirstEndpoint, firstPacketPrefix, mergedScheduling);
    ASSERT_TRUE(firstEndpointResult.has_value());
    const GpuTaskId firstEndpoint = firstEndpointResult.value();
    ASSERT_TRUE(firstEndpoint.valid());

    const Expected<GpuTaskId> middleResult = GpuTelemetryAddTimingTaskDep(graph, s_GpuCaseTaskGraphTimingEnvelopeMiddle, firstEndpoint);
    ASSERT_TRUE(middleResult.has_value());
    const GpuTaskId middle = middleResult.value();
    ASSERT_TRUE(middle.valid());

    const Expected<GpuTaskId> lastEndpointResult = GpuTelemetryAddTimingTaskDep(graph, s_GpuCaseTaskGraphTimingEnvelopeLastEndpoint, middle);
    ASSERT_TRUE(lastEndpointResult.has_value());
    const GpuTaskId lastEndpoint = lastEndpointResult.value();
    ASSERT_TRUE(lastEndpoint.valid());

    const Expected<GpuTaskId> lastPacketSuffixResult = GpuTelemetryAddTimingTaskSched(graph, s_GpuCaseTaskGraphTimingEnvelopeLastPacketSuffix, lastEndpoint, mergedScheduling);
    ASSERT_TRUE(lastPacketSuffixResult.has_value());
    const GpuTaskId lastPacketSuffix = lastPacketSuffixResult.value();
    ASSERT_TRUE(lastPacketSuffix.valid());

    GpuTaskTimingMetadata packetOnlyTiming = GpuTaskTimingMetadata();
    packetOnlyTiming.policy = GpuTaskTimingPolicy::PacketOnly;
    const Expected<GpuTaskId> timedTailResult = GpuTelemetryAddTimingTaskFull(
        graph,
        s_GpuCaseTaskGraphTimingEnvelopeTimedTail,
        lastPacketSuffix,
        GpuTaskSchedulingHint(),
        packetOnlyTiming
    );
    ASSERT_TRUE(timedTailResult.has_value());
    const GpuTaskId timedTail = timedTailResult.value();
    ASSERT_TRUE(timedTail.valid());

    GpuTaskGraphCompileOptions options = GpuTaskGraphCompileOptions();
    options.packetTimingEnvelope.firstTask = firstEndpoint;
    options.packetTimingEnvelope.lastTask = lastEndpoint;
    ASSERT_TRUE(options.packetTimingEnvelope.enabled());
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(GpuTelemetryCompileWithOptions(analysis, assignments, compiledGraph, operationScratchArena, graph, options));

    GpuSubmissionPacketRange expectedRange = GpuSubmissionPacketRange();
    GpuSubmissionPacketRange oldRange = GpuSubmissionPacketRange();
    u64 oldPlanGeneration = 0u;
    {
        const GpuTelemetryReadViews views = GpuTelemetryReadViews(graph, compiledGraph);
        ASSERT_TRUE(views.valid());
        ASSERT_EQ(views.compiled.packetCount(), 5u);

        const GpuSubmissionPacketId prefixPacket = views.compiled.packetForTask(prefix);
        const GpuSubmissionPacketId firstPacket = views.compiled.packetForTask(firstEndpoint);
        const GpuSubmissionPacketId middlePacket = views.compiled.packetForTask(middle);
        const GpuSubmissionPacketId lastPacket = views.compiled.packetForTask(lastEndpoint);
        const GpuSubmissionPacketId tailPacket = views.compiled.packetForTask(timedTail);
        EXPECT_EQ(views.compiled.packetForTask(firstPacketPrefix), firstPacket);
        EXPECT_EQ(views.compiled.packetForTask(lastPacketSuffix), lastPacket);
        expectedRange = views.compiled.packetRange(firstPacket, lastPacket);
        ASSERT_TRUE(expectedRange.valid());
        ASSERT_EQ(expectedRange.packetCount, 3u);
        const GpuSubmissionPacketRange compiledRange = views.compiled.packetTimingEnvelopeRange();
        EXPECT_EQ(compiledRange.first, expectedRange.first);
        EXPECT_EQ(compiledRange.packetCount, expectedRange.packetCount);

        const GpuCompiledPacketView prefixPacketView = views.compiled.packet(prefixPacket);
        const GpuCompiledPacketView firstPacketView = views.compiled.packet(firstPacket);
        const GpuCompiledPacketView middlePacketView = views.compiled.packet(middlePacket);
        const GpuCompiledPacketView lastPacketView = views.compiled.packet(lastPacket);
        const GpuCompiledPacketView tailPacketView = views.compiled.packet(tailPacket);
        ASSERT_TRUE(prefixPacketView.valid());
        ASSERT_TRUE(firstPacketView.valid());
        ASSERT_TRUE(middlePacketView.valid());
        ASSERT_TRUE(lastPacketView.valid());
        ASSERT_TRUE(tailPacketView.valid());

        const GpuCompiledTaskView firstEndpointView = views.compiled.findTask(firstEndpoint);
        const GpuCompiledTaskView timedTailView = views.compiled.findTask(timedTail);
        ASSERT_TRUE(firstEndpointView.valid());
        ASSERT_TRUE(timedTailView.valid());
        native(
            in prefixPacketView,
            in firstPacketView,
            in middlePacketView,
            in lastPacketView,
            in tailPacketView,
            in firstEndpointView,
            in timedTailView
        ){
            EXPECT_FALSE(prefixPacketView.plan->recordsPacketEnvelopeTiming);
            EXPECT_FALSE(prefixPacketView.plan->recordsTiming);
            EXPECT_TRUE(firstPacketView.plan->recordsPacketEnvelopeTiming);
            EXPECT_TRUE(firstPacketView.plan->recordsTiming);
            EXPECT_TRUE(middlePacketView.plan->recordsPacketEnvelopeTiming);
            EXPECT_TRUE(middlePacketView.plan->recordsTiming);
            EXPECT_TRUE(lastPacketView.plan->recordsPacketEnvelopeTiming);
            EXPECT_TRUE(lastPacketView.plan->recordsTiming);
            EXPECT_FALSE(tailPacketView.plan->recordsPacketEnvelopeTiming);
            EXPECT_TRUE(tailPacketView.plan->recordsTiming);
            EXPECT_EQ(firstEndpointView.plan->timingPolicy, Core::GpuTaskTimingPolicy::None);
            EXPECT_EQ(timedTailView.plan->timingPolicy, Core::GpuTaskTimingPolicy::PacketOnly);
        }

        oldRange = compiledRange;
        oldPlanGeneration = views.compiled.planGeneration();
    }

    ASSERT_TRUE(GpuTelemetryCompileWithOptions(analysis, assignments, compiledGraph, operationScratchArena, graph, options));
    u64 recompiledPlanGeneration = 0u;
    {
        const GpuTelemetryReadViews views = GpuTelemetryReadViews(graph, compiledGraph);
        ASSERT_TRUE(views.valid());
        EXPECT_NE(views.compiled.planGeneration(), oldPlanGeneration);
        const GpuSubmissionPacketRange recompiledRange = views.compiled.packetTimingEnvelopeRange();
        ASSERT_TRUE(recompiledRange.valid());
        EXPECT_EQ(recompiledRange.packetCount, expectedRange.packetCount);
        EXPECT_FALSE(views.compiled.validPacketRange(oldRange));
        recompiledPlanGeneration = views.compiled.planGeneration();
    }

    ASSERT_TRUE(GpuTelemetryCompileDefault(analysis, assignments, compiledGraph, operationScratchArena, graph));
    {
        const GpuTelemetryReadViews views = GpuTelemetryReadViews(graph, compiledGraph);
        ASSERT_TRUE(views.valid());
        EXPECT_NE(views.compiled.planGeneration(), recompiledPlanGeneration);
        EXPECT_FALSE(views.compiled.packetTimingEnvelopeRange().valid());
        EXPECT_FALSE(views.compiled.validPacketRange(oldRange));
        for(usize packetIndex = 0u; packetIndex < views.compiled.packetCount(); ++packetIndex){
            const GpuCompiledPacketView packet = views.compiled.packet(views.compiled.packetIdAt(packetIndex));
            ASSERT_TRUE(packet.valid());
            native(in packet){
                EXPECT_FALSE(packet.plan->recordsPacketEnvelopeTiming);
            }
        }
        const GpuCompiledPacketView tailPacket = views.compiled.packet(views.compiled.packetForTask(timedTail));
        ASSERT_TRUE(tailPacket.valid());
        native(in tailPacket){
            EXPECT_TRUE(tailPacket.plan->recordsTiming);
        }
    }

    compiledGraph.reset();
    {
        const GpuTelemetryReadViews views = GpuTelemetryReadViews(graph, compiledGraph);
        EXPECT_FALSE(views.compiled.packetTimingEnvelopeRange().valid());
    }
}

void VerifyGpuTelemetry_RejectsIncompleteForeignAndReversedEnvelopeEndpoints(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    GpuTelemetryTimingTestArena testArena = GpuTelemetryTimingTestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuTaskId> firstResult = GpuTelemetryAddTimingTask(graph, s_GpuCaseTaskGraphTimingInvalidFirst);
    ASSERT_TRUE(firstResult.has_value());
    const GpuTaskId first = firstResult.value();
    const Expected<GpuTaskId> secondResult = GpuTelemetryAddTimingTaskDep(graph, s_GpuCaseTaskGraphTimingInvalidSecond, first);
    ASSERT_TRUE(secondResult.has_value());
    const GpuTaskId second = secondResult.value();
    const Expected<GpuTaskId> thirdResult = GpuTelemetryAddTimingTaskDep(graph, s_GpuCaseTaskGraphTimingInvalidThird, second);
    ASSERT_TRUE(thirdResult.has_value());
    const GpuTaskId third = thirdResult.value();
    ASSERT_TRUE(first.valid());
    ASSERT_TRUE(second.valid());
    ASSERT_TRUE(third.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    GpuTaskGraphCompileOptions options = GpuTaskGraphCompileOptions();

    options.packetTimingEnvelope.firstTask = first;
    EXPECT_FALSE(options.packetTimingEnvelope.enabled());
    EXPECT_FALSE(GpuTelemetryCompileWithOptions(analysis, assignments, compiledGraph, operationScratchArena, graph, options));
    {
        const GpuTelemetryReadViews views = GpuTelemetryReadViews(graph, compiledGraph);
        EXPECT_FALSE(views.compiled.valid());
    }

    options.packetTimingEnvelope = GpuTaskGraphPacketTimingEnvelopeOptions();
    options.packetTimingEnvelope.lastTask = third;
    EXPECT_FALSE(options.packetTimingEnvelope.enabled());
    EXPECT_FALSE(GpuTelemetryCompileWithOptions(analysis, assignments, compiledGraph, operationScratchArena, graph, options));
    {
        const GpuTelemetryReadViews views = GpuTelemetryReadViews(graph, compiledGraph);
        EXPECT_FALSE(views.compiled.valid());
    }

    GpuTaskGraph foreignGraph = GpuTaskGraph(testArena.arena);
    const Expected<GpuTaskId> foreignResult = GpuTelemetryAddTimingTask(foreignGraph, s_GpuCaseTaskGraphTimingInvalidForeign);
    ASSERT_TRUE(foreignResult.has_value());
    const GpuTaskId foreign = foreignResult.value();
    ASSERT_TRUE(foreign.valid());
    options.packetTimingEnvelope.firstTask = first;
    options.packetTimingEnvelope.lastTask = foreign;
    ASSERT_TRUE(options.packetTimingEnvelope.enabled());
    EXPECT_FALSE(GpuTelemetryCompileWithOptions(analysis, assignments, compiledGraph, operationScratchArena, graph, options));
    {
        const GpuTelemetryReadViews views = GpuTelemetryReadViews(graph, compiledGraph);
        EXPECT_FALSE(views.compiled.valid());
    }

    options.packetTimingEnvelope.firstTask = third;
    options.packetTimingEnvelope.lastTask = first;
    EXPECT_FALSE(GpuTelemetryCompileWithOptions(analysis, assignments, compiledGraph, operationScratchArena, graph, options));
    {
        const GpuTelemetryReadViews views = GpuTelemetryReadViews(graph, compiledGraph);
        EXPECT_FALSE(views.compiled.valid());
    }

    options.packetTimingEnvelope.firstTask = second;
    options.packetTimingEnvelope.lastTask = second;
    ASSERT_TRUE(GpuTelemetryCompileWithOptions(analysis, assignments, compiledGraph, operationScratchArena, graph, options));
    {
        const GpuTelemetryReadViews views = GpuTelemetryReadViews(graph, compiledGraph);
        ASSERT_TRUE(views.valid());
        const GpuSubmissionPacketRange range = views.compiled.packetTimingEnvelopeRange();
        ASSERT_TRUE(range.valid());
        EXPECT_EQ(range.packetCount, 1u);
    }

    GpuTaskGraph mergedGraph = GpuTaskGraph(testArena.arena);
    const Expected<GpuTaskId> mergedFirstResult = GpuTelemetryAddTimingTask(mergedGraph, s_GpuCaseTaskGraphTimingInvalidMergedFirst);
    ASSERT_TRUE(mergedFirstResult.has_value());
    const GpuTaskId mergedFirst = mergedFirstResult.value();
    GpuTaskSchedulingHint mergedScheduling = GpuTaskSchedulingHint();
    mergedScheduling.mergeWithPrevious = true;
    const Expected<GpuTaskId> mergedLastResult = GpuTelemetryAddTimingTaskSched(mergedGraph, s_GpuCaseTaskGraphTimingInvalidMergedLast, mergedFirst, mergedScheduling);
    ASSERT_TRUE(mergedLastResult.has_value());
    const GpuTaskId mergedLast = mergedLastResult.value();
    ASSERT_TRUE(mergedFirst.valid());
    ASSERT_TRUE(mergedLast.valid());
    options.packetTimingEnvelope.firstTask = mergedLast;
    options.packetTimingEnvelope.lastTask = mergedFirst;
    EXPECT_FALSE(GpuTelemetryCompileWithOptions(analysis, assignments, compiledGraph, operationScratchArena, mergedGraph, options));
    {
        const GpuTelemetryReadViews views = GpuTelemetryReadViews(mergedGraph, compiledGraph);
        EXPECT_FALSE(views.compiled.valid());
    }

    GpuTaskGraph staleGraph = GpuTaskGraph(testArena.arena);
    const Expected<GpuTaskId> staleEndpointResult = GpuTelemetryAddTimingTask(staleGraph, s_GpuCaseTaskGraphTimingInvalidStale);
    ASSERT_TRUE(staleEndpointResult.has_value());
    const GpuTaskId staleEndpoint = staleEndpointResult.value();
    ASSERT_TRUE(staleEndpoint.valid());
    options.packetTimingEnvelope.firstTask = staleEndpoint;
    options.packetTimingEnvelope.lastTask = staleEndpoint;
    staleGraph.reset();
    EXPECT_FALSE(GpuTelemetryCompileWithOptions(analysis, assignments, compiledGraph, operationScratchArena, staleGraph, options));
    {
        const GpuTelemetryReadViews views = GpuTelemetryReadViews(staleGraph, compiledGraph);
        EXPECT_FALSE(views.compiled.valid());
    }
}

void VerifyGpuTelemetry_ResolvesEnvelopeByTopologicalPositionInsteadOfTaskIndex(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    GpuTelemetryTimingTestArena testArena = GpuTelemetryTimingTestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
    scheduling.forceSubmissionBoundary = true;
    scheduling.allowPacketMerge = false;

    u64 graphGeneration = 0u;
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        ASSERT_TRUE(declarations.valid());
        graphGeneration = declarations.generation();
    }
    GpuTaskId futureEarly = GpuTaskId();
    futureEarly.generation = graphGeneration;
    futureEarly.index = 2u;

    const Expected<GpuTaskId> lateResult = GpuTelemetryAddTimingTaskSched(graph, s_GpuCaseTaskGraphTimingTopologicalLate, futureEarly, scheduling);
    ASSERT_TRUE(lateResult.has_value());
    const GpuTaskId late = lateResult.value();
    const Expected<GpuTaskId> prefixResult = GpuTelemetryAddTimingTaskSched(graph, s_GpuCaseTaskGraphTimingTopologicalPrefix, GpuTaskId(), scheduling);
    ASSERT_TRUE(prefixResult.has_value());
    const GpuTaskId prefix = prefixResult.value();
    const Expected<GpuTaskId> earlyResult = GpuTelemetryAddTimingTaskSched(graph, s_GpuCaseTaskGraphTimingTopologicalEarly, prefix, scheduling);
    ASSERT_TRUE(earlyResult.has_value());
    const GpuTaskId early = earlyResult.value();
    ASSERT_TRUE(late.valid());
    ASSERT_TRUE(prefix.valid());
    ASSERT_TRUE(early.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    GpuTaskGraphCompileOptions options = GpuTaskGraphCompileOptions();
    options.packetTimingEnvelope.firstTask = early;
    options.packetTimingEnvelope.lastTask = late;
    ASSERT_TRUE(GpuTelemetryCompileWithOptions(analysis, assignments, compiledGraph, operationScratchArena, graph, options));
    ASSERT_EQ(analysis.topologicalOrder().size(), 3u);
    EXPECT_EQ(analysis.topologicalOrder()[0u], prefix);
    EXPECT_EQ(analysis.topologicalOrder()[1u], early);
    EXPECT_EQ(analysis.topologicalOrder()[2u], late);
    {
        const GpuTelemetryReadViews views = GpuTelemetryReadViews(graph, compiledGraph);
        ASSERT_TRUE(views.valid());
        EXPECT_LT(views.compiled.packetForTask(early).index, views.compiled.packetForTask(late).index);
        const GpuSubmissionPacketRange range = views.compiled.packetTimingEnvelopeRange();
        ASSERT_TRUE(range.valid());
        EXPECT_EQ(range.packetCount, 2u);
    }

    options.packetTimingEnvelope.firstTask = late;
    options.packetTimingEnvelope.lastTask = early;
    EXPECT_FALSE(GpuTelemetryCompileWithOptions(analysis, assignments, compiledGraph, operationScratchArena, graph, options));
    {
        const GpuTelemetryReadViews views = GpuTelemetryReadViews(graph, compiledGraph);
        EXPECT_FALSE(views.compiled.valid());
    }
}

void VerifyGpuTelemetry_RejectsEnvelopeRangesAtOrAfterAcceptedQueueFrontierPackets(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    GpuTelemetryTimingTestArena testArena = GpuTelemetryTimingTestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuTaskId> firstResult = GpuTelemetryAddTimingTask(graph, s_GpuCaseTaskGraphTimingFrontierFirst);
    ASSERT_TRUE(firstResult.has_value());
    const GpuTaskId first = firstResult.value();
    ASSERT_TRUE(first.valid());

    GpuTaskSchedulingHint frontierScheduling = GpuTaskSchedulingHint();
    frontierScheduling.forceSubmissionBoundary = true;
    frontierScheduling.allowPacketMerge = false;
    frontierScheduling.joinsAcceptedQueueFrontier = true;
    const Expected<GpuTaskId> recoveryResult = GpuTelemetryAddTimingTaskSched(graph, s_GpuCaseTaskGraphTimingFrontierRecovery, GpuTaskId(), frontierScheduling);
    ASSERT_TRUE(recoveryResult.has_value());
    const GpuTaskId recovery = recoveryResult.value();
    ASSERT_TRUE(recovery.valid());
    const Expected<GpuTaskId> lastResult = GpuTelemetryAddTimingTaskDep(graph, s_GpuCaseTaskGraphTimingFrontierLast, recovery);
    ASSERT_TRUE(lastResult.has_value());
    const GpuTaskId last = lastResult.value();
    ASSERT_TRUE(last.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    GpuTaskGraphCompileOptions options = GpuTaskGraphCompileOptions();
    options.packetTimingEnvelope.firstTask = first;
    options.packetTimingEnvelope.lastTask = first;
    ASSERT_TRUE(GpuTelemetryCompileWithOptions(analysis, assignments, compiledGraph, operationScratchArena, graph, options));
    {
        const GpuTelemetryReadViews views = GpuTelemetryReadViews(graph, compiledGraph);
        ASSERT_TRUE(views.valid());
        ASSERT_TRUE(views.compiled.packetTimingEnvelopeRange().valid());
    }

    options.packetTimingEnvelope.firstTask = first;
    options.packetTimingEnvelope.lastTask = last;
    EXPECT_FALSE(GpuTelemetryCompileWithOptions(analysis, assignments, compiledGraph, operationScratchArena, graph, options));
    {
        const GpuTelemetryReadViews views = GpuTelemetryReadViews(graph, compiledGraph);
        EXPECT_FALSE(views.compiled.valid());
    }

    options.packetTimingEnvelope.firstTask = recovery;
    options.packetTimingEnvelope.lastTask = recovery;
    EXPECT_FALSE(GpuTelemetryCompileWithOptions(analysis, assignments, compiledGraph, operationScratchArena, graph, options));
    {
        const GpuTelemetryReadViews views = GpuTelemetryReadViews(graph, compiledGraph);
        EXPECT_FALSE(views.compiled.valid());
    }

    options.packetTimingEnvelope.firstTask = last;
    options.packetTimingEnvelope.lastTask = last;
    EXPECT_FALSE(GpuTelemetryCompileWithOptions(analysis, assignments, compiledGraph, operationScratchArena, graph, options));
    {
        const GpuTelemetryReadViews views = GpuTelemetryReadViews(graph, compiledGraph);
        EXPECT_FALSE(views.compiled.valid());
    }
}


