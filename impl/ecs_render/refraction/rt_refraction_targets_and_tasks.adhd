#include <impl/ecs_render/refraction/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_RefractionResolveClearLabel = "AVBOIT Refraction Resolve Clear";
const StringView s_RefractionTileListLabel = "Refraction Tile List";
const StringView s_RefractionTileArgumentsLabel = "Refraction Tile Arguments";
const StringView s_RefractionTileArgumentsClearLabel = "Refraction Tile Arguments Clear";
const StringView s_RefractionClassifyTilesLabel = "Refraction Classify Tiles";
const StringView s_RefractionDiagnosticsCountersLabel = "Refraction Diagnostic Counters";
const StringView s_RefractionDiagnosticsClearLabel = "Refraction Diagnostics Clear";
const StringView s_RefractionResolveLabel = "AVBOIT Refraction Resolve";
const StringView s_RefractionStatisticsReadbackLabel = "Refraction Statistics Readback";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CanRecordRefractionStatisticsReadback(in b8 hasSource, in b8 hasDestination, in b8 reservationValid){
    return hasSource && hasDestination && reservationValid;
}

b8 RequiresRefractionSceneReadsImport(in b8 sceneReadsValid, in b8 usesHardwareTrace){
    return !sceneReadsValid && usesHardwareTrace;
}


