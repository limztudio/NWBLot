const StringView s_RendererOpticalVolumeCoincidenceChoices = "'independent', 'identical_material', or 'shared_group'";
const StringView s_RendererOpticalBoundaryModeChoices = "'unspecified', 'closed_nested', or 'closed_priority'";

type ModelComponentCookEntry = TypedComponentCookEntry<ModelComponent>;
type MeshComponentCookEntry = TypedComponentCookEntry<MeshComponent>;
type RendererComponentCookEntry = TypedComponentCookEntry<RendererComponent>;
type MaterialInstanceComponentCookEntry = TypedComponentCookEntry<MaterialInstanceComponent>;
type SkeletonJointPaletteComponentCookEntry = TypedComponentCookEntry<SkeletonJointPaletteComponent>;
type SkeletonPoseComponentCookEntry = TypedComponentCookEntry<SkeletonPoseComponent>;
type SkinnedMeshBindingComponentCookEntry = TypedComponentCookEntry<SkinnedMeshBindingComponent>;
type CsgReceiverComponentCookEntry = TypedComponentCookEntry<CsgReceiverComponent>;
type StaticCsgMeshComponentCookEntry = TypedComponentCookEntry<StaticCsgMeshComponent>;
type SkinnedCsgMeshComponentCookEntry = TypedComponentCookEntry<SkinnedCsgMeshComponent>;
type CsgCutterComponentCookEntry = TypedComponentCookEntry<CsgCutterComponent>;

type ModelComponentCodec = TypedComponentAssetCodec<ModelComponentAsset>;
type MeshComponentCodec = TypedComponentAssetCodec<MeshComponentAsset>;
type RendererComponentCodec = TypedComponentAssetCodec<RendererComponentAsset>;
type MaterialInstanceComponentCodec = TypedComponentAssetCodec<MaterialInstanceComponentAsset>;
type SkeletonJointPaletteComponentCodec = TypedComponentAssetCodec<SkeletonJointPaletteComponentAsset>;
type SkeletonPoseComponentCodec = TypedComponentAssetCodec<SkeletonPoseComponentAsset>;
type SkinnedMeshBindingComponentCodec = TypedComponentAssetCodec<SkinnedMeshBindingComponentAsset>;
type CsgReceiverComponentCodec = TypedComponentAssetCodec<CsgReceiverComponentAsset>;
type StaticCsgMeshComponentCodec = TypedComponentAssetCodec<StaticCsgMeshComponentAsset>;
type SkinnedCsgMeshComponentCodec = TypedComponentAssetCodec<SkinnedCsgMeshComponentAsset>;
type CsgCutterComponentCodec = TypedComponentAssetCodec<CsgCutterComponentAsset>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateRendererOpticalVolumeGroupUnpadded(in StringView prefix, in Path nwbFilePath, in StringView fieldName, in b8 unpadded){
    if(unpadded)
        return true;

    error("{} '{}': field '{}' must not be empty or padded", prefix, nwbFilePath, fieldName);
    return false;
}

b8 ValidateRendererOpticalVolumeGroupParsedName(in StringView prefix, in Path nwbFilePath, in StringView fieldName, in b8 validName){
    if(validName)
        return true;

    error("{} '{}': field '{}' contains an embedded null", prefix, nwbFilePath, fieldName);
    return false;
}

b8 IsValidRendererOpticalVolumeGroupName(in b8 parsedOk, in Name groupName){
    return parsedOk && groupName != s_NameNone;
}

b8 ReadOptionalRendererVisibleField(in Path nwbFilePath, in MetascriptValue asset, mut b8 inOutVisible){
    return ReadOptionalMetadataBoolField(nwbFilePath, asset, s_RendererComponentDiagnosticPrefix, s_RendererComponentVisibleField, inOutVisible);
}

Expected<Name> ReadOptionalRendererOpticalVolumeGroupField(in Path nwbFilePath, in MetascriptValue asset){
    if(!asset.hasField(s_RendererComponentOpticalVolumeGroupField))
        return s_NameNone;

    const Expected<MetadataStringField> groupField = ReadMetadataStringField(nwbFilePath, asset, s_RendererComponentDiagnosticPrefix, s_RendererComponentOpticalVolumeGroupField, true);
    if(!groupField.has_value())
        return MakeUnexpected(Failure());
    if(!ValidateRendererOpticalVolumeGroupUnpadded(s_RendererComponentDiagnosticPrefix, nwbFilePath, s_RendererComponentOpticalVolumeGroupField, IsUnpaddedRendererOpticalVolumeGroup(groupField.value().text)))
        return MakeUnexpected(Failure());

    const Expected<Optional<Name>, NameTextError> groupName = ToName(groupField.value().text);
    Name resolvedGroup = s_NameNone;
    if(groupName.has_value() && groupName.value().has_value())
        resolvedGroup = groupName.value().value();
    if(!ValidateRendererOpticalVolumeGroupParsedName(s_RendererComponentDiagnosticPrefix, nwbFilePath, s_RendererComponentOpticalVolumeGroupField, IsValidRendererOpticalVolumeGroupName(groupName.has_value(), resolvedGroup)))
        return MakeUnexpected(Failure());

    return resolvedGroup;
}

b8 ReadOptionalRendererPriorityFields(in Path nwbFilePath, in MetascriptValue asset, mut i32 inOutVolumePriority, mut i32 inOutMediumPriority){
    if(!ReadOptionalI32Field(nwbFilePath, asset, s_RendererComponentDiagnosticPrefix, s_RendererComponentOpticalVolumePriorityField, inOutVolumePriority))
        return false;
    return ReadOptionalI32Field(nwbFilePath, asset, s_RendererComponentDiagnosticPrefix, s_RendererComponentOpticalMediumPriorityField, inOutMediumPriority);
}


