#include <impl/ecs_render/kernel/task_timing_feedback_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class PendingRendererTimingSubscription : NoCopy{
    private mut GpuTimingRecorder m_recorder;
    private GpuTimingSampleSubscription m_subscription;
    private b8 m_pending = true;

    public PendingRendererTimingSubscription(mut GpuTimingRecorder recorder, in GpuTimingSampleSubscription subscription){
        this.m_recorder = recorder;
        this.m_subscription = subscription;
    }
    public void commit(){ this.m_pending = false; }
    public ~PendingRendererTimingSubscription(){
        if(this.m_pending)
            this.m_recorder.unsubscribeSampleListener(this.m_subscription);
    }
}

class RendererTaskTimingFeedback : NoCopy{
    private mut GraphicsRuntime m_graphics;
    private RendererTaskTimingFeedbackState m_state;
    private GpuTaskTimingHistoryStore m_history = GpuTaskTimingHistoryStore();
    private GpuTaskTimingHistorySnapshot m_snapshot = GpuTaskTimingHistorySnapshot();
    private Vector<Name> m_feedbackCollectionScopes;
    private Futex m_lifecycleMutex;
    private Futex m_mutex;
    private GpuTaskTimingFeedbackPolicy m_policy;
    private GpuTimingSampleSubscription m_subscription;
    private b8 m_active = false;

    public RendererTaskTimingFeedback(mut GraphicsRuntime graphics, in Span<Name> feedbackCollectionScopes){
        this.m_graphics = graphics;
        assert(!feedbackCollectionScopes.empty());
        this.m_feedbackCollectionScopes.reserve(feedbackCollectionScopes.size());
        for(in Name scope : feedbackCollectionScopes)
            this.m_feedbackCollectionScopes.push_back(scope);
    }
    public ~RendererTaskTimingFeedback(){ this.deactivate(); }

    public void activate(){
        const FutexGuard lifecycleLock = AcquireFutex(this.m_lifecycleMutex);
        b8 feedbackCollectionEnabled = false;
        {
            const FutexGuard lock = AcquireFutex(this.m_mutex);
            if(this.m_active)
                return;
            feedbackCollectionEnabled = this.m_policy.enabled;
        }

        mut GpuTimingRecorder timing = this.m_graphics.gpuTiming();
        const auto subscription = timing.subscribeSampleObserver(this);
        if(!subscription.has_value()){
            LogRendererTaskTimingFeedbackSubscriptionFailure();
            return;
        }
        PendingRendererTimingSubscription pending(timing, subscription.value());
        if(feedbackCollectionEnabled && !timing.setFeedbackCollectionScopes(subscription.value(), this.m_feedbackCollectionScopes)){
            LogRendererTaskTimingFeedbackScopeCollectionFailure();
            return;
        }

        const FutexGuard lock = AcquireFutex(this.m_mutex);
        this.m_subscription = subscription.value();
        this.m_active = true;
        pending.commit();
    }

    public void deactivate(){
        const FutexGuard lifecycleLock = AcquireFutex(this.m_lifecycleMutex);
        GpuTimingSampleSubscription subscription = GpuTimingSampleSubscription();
        {
            const FutexGuard lock = AcquireFutex(this.m_mutex);
            if(!this.m_active)
                return;
            this.m_active = false;
            subscription = this.m_subscription;
            this.m_subscription = GpuTimingSampleSubscription();
        }
        this.m_graphics.gpuTiming().unsubscribeSampleListener(subscription);
        this.reset();
    }

    public Expected<GpuTimingSampleAttribution> beginSample(
        in Name scopeName,
        in GpuTaskTimingKey key,
        in GpuPhysicalQueueId expectedQueue,
        in b8 recordsNonCommittingTimingSample
    ){
        if(!CanBeginRendererTaskTimingFeedbackSample(scopeName, this.m_feedbackCollectionScopes, key.valid(), expectedQueue.valid()))
            return s_NoGpuTimingSampleAttribution;
        const FutexGuard lock = AcquireFutex(this.m_mutex);
        if(!CanPublishRendererTaskTimingFeedbackSnapshot(this.m_active, this.m_subscription.valid(), this.m_policy.enabled))
            return s_NoGpuTimingSampleAttribution;
        const auto attribution = this.m_graphics.gpuTiming().allocateSampleAttribution();
        if(!attribution.has_value())
            return MakeUnexpected(attribution.error());
        if(!this.m_state.trackSample(attribution.value(), scopeName, key, expectedQueue, this.m_graphics.getFrameIndex(), recordsNonCommittingTimingSample))
            return MakeUnexpected(Failure());
        return attribution.value();
    }

    public void acceptSubmission(in GpuTimingSampleAttribution attribution, in QueueSubmissionToken token){
        if(attribution == s_NoGpuTimingSampleAttribution)
            return;
        const FutexGuard lock = AcquireFutex(this.m_mutex);
        this.m_state.acceptSubmission(attribution, token, this.m_active);
    }
    public void discardRecording(in GpuTimingSampleAttribution attribution){
        if(attribution == s_NoGpuTimingSampleAttribution)
            return;
        const FutexGuard lock = AcquireFutex(this.m_mutex);
        this.m_state.discardRecording(attribution);
    }

    public void configureCompileOptions(mut GpuTaskGraphCompileOptions options, in u64 frameIndex){
        options.queueAssignmentOptions.clearTimingHistory();
        options.queueAssignmentOptions.timingFeedbackPolicy = GpuTaskTimingFeedbackPolicy();
        options.queueAssignmentOptions.timingFrameIndex = 0u;
        RendererTaskTimingFeedbackDrainResult drained = RendererTaskTimingFeedbackDrainResult();
        {
            const FutexGuard lock = AcquireFutex(this.m_mutex);
            const u16 generation = this.m_graphics.getDevice().getDeviceGeneration();
            this.m_history.resetForDeviceGeneration(generation);
            drained = this.m_state.drain(this.m_history, generation);
            if(CanPublishRendererTaskTimingFeedbackSnapshot(this.m_active, this.m_subscription.valid(), this.m_policy.enabled)){
                this.m_history.snapshot(this.m_snapshot);
                if(this.m_snapshot.valid()){
                    options.queueAssignmentOptions.setTimingHistory(this.m_snapshot);
                    options.queueAssignmentOptions.timingFeedbackPolicy = this.m_policy;
                    options.queueAssignmentOptions.timingFrameIndex = frameIndex;
                }
            }
        }
        LogRendererTaskTimingFeedbackRejections(drained.rejectedAssignmentCount, drained.rejectedSampleCount);
    }
    public void reset(){
        const FutexGuard lock = AcquireFutex(this.m_mutex);
        this.m_state.reset();
        this.m_history.reset(this.m_snapshot);
    }
    public void onGpuTimingSample(in GpuTimingSample sample){
        if(sample.attribution == s_NoGpuTimingSampleAttribution)
            return;
        const FutexGuard lock = AcquireFutex(this.m_mutex);
        this.m_state.completeSample(sample, this.m_active);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<GpuTimingSampleAttribution> BeginTaskTimingSample(
    mut RendererTaskTimingFeedback feedback,
    in GpuTimingScopeDefinition scope,
    in GpuTaskRecordContext context
){
    const auto queueInfo = context.compiledPlan.findQueueInfo(context.queue);
    const auto compiledTask = context.compiledPlan.findTask(context.task);
    if(!queueInfo.has_value() || !compiledTask.valid())
        return s_NoGpuTimingSampleAttribution;
    const GpuTaskGraphTaskView task = context.declarations.taskAt(context.task.index);
    GpuTaskTimingKey key = GpuTaskTimingKey();
    key.task = task.identity;
    key.variant = task.timing.variant;
    key.resolutionClass = task.timing.resolutionClass;
    key.queue = queueInfo.value().queueClass;
    return feedback.beginSample(scope.identity, key, context.queue, compiledTask.recordsNonCommittingTimingSample());
}


