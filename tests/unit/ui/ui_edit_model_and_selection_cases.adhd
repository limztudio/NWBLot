void VerifyUiEditCommandTests_ShortcutTranslationPreservesWordSelectionAndLeavesAltGrWithOs(mut UiEditCommandTests self){
    ASSERT_TRUE(self.m_model.setText("one two"));
    const EditCommandRequest left = self.translate(CoreKey::Left, true, true, false, true);
    EXPECT_TRUE(ApplyEditCommand(self.m_model, left).selectionChanged);
    EXPECT_EQ(self.m_model.selectedText(), "two");
    const u64 revision = self.m_model.revision();
    const u64 selection = self.m_model.selectionGeneration();
    Array<EditCommandRequest, 4u> rejectedList = Array<EditCommandRequest, 4u>();
    rejectedList[0u] = self.translate(CoreKey::V);
    rejectedList[1u] = self.translate(CoreKey::V, true, false, true);
    rejectedList[2u] = self.translate(CoreKey::Left, true, true, true);
    rejectedList[3u] = self.translate(MakeUiEditOutOfBoundsKeyCode());
    for(in EditCommandRequest rejected : rejectedList){
        EXPECT_FALSE(ApplyEditCommand(self.m_model, rejected).handled);
        EXPECT_EQ(self.m_model.text(), "one two");
        EXPECT_EQ(self.m_model.selectedText(), "two");
        EXPECT_EQ(self.m_model.revision(), revision);
        EXPECT_EQ(self.m_model.selectionGeneration(), selection);
    }
}

void VerifyUiEditCommandTests_AlternateClipboardChordsRejectAmbiguousModifiersRepeatsAndPreedit(mut UiEditCommandTests self){
    ASSERT_TRUE(self.m_model.setText("selected"));
    ASSERT_TRUE(self.m_model.selectAll());
    const EditCommandRequest copy = self.translate(CoreKey::Insert, true);
    const EditCommandRequest paste = self.translate(CoreKey::Insert, false, true);
    const EditCommandRequest cut = self.translate(CoreKey::Delete, false, true);
    EXPECT_EQ(self.translate(CoreKey::Insert, true, true).command, EditCommand::None);
    EXPECT_EQ(self.translate(CoreKey::Insert, true, false, true).command, EditCommand::None);
    EXPECT_EQ(self.translate(CoreKey::Delete, false, true, true).command, EditCommand::None);
    EXPECT_EQ(ApplyEditCommand(self.m_model, copy, true).clipboard, EditClipboardAction::Copy);
    EXPECT_EQ(ApplyEditCommand(self.m_model, paste, true).clipboard, EditClipboardAction::None);
    EXPECT_EQ(ApplyEditCommand(self.m_model, cut, true).clipboard, EditClipboardAction::None);
    EXPECT_EQ(ApplyEditCommand(self.m_model, self.translate(CoreKey::Insert, true, false, false, true)).clipboard, EditClipboardAction::None);
    EXPECT_EQ(ApplyEditCommand(self.m_model, self.translate(CoreKey::Insert, false, true, false, true)).clipboard, EditClipboardAction::None);
    EXPECT_EQ(ApplyEditCommand(self.m_model, self.translate(CoreKey::Delete, false, true, false, true)).clipboard, EditClipboardAction::None);
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("draft", 0u, 5u));
    Array<EditCommandRequest, 3u> requests = Array<EditCommandRequest, 3u>();
    requests[0u] = copy;
    requests[1u] = paste;
    requests[2u] = cut;
    for(in EditCommandRequest request : requests)
        EXPECT_EQ(ApplyEditCommand(self.m_model, request).clipboard, EditClipboardAction::None);
    EXPECT_EQ(self.m_model.text(), "selected");
}

void VerifyUiEditCommandTests_NonEditingMalformedAndUnrelatedIntentsCannotMutateOrMoveTheModel(mut UiEditCommandTests self){
    ASSERT_TRUE(self.m_model.setText("one two"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 5u));
    const u64 revision = self.m_model.revision();
    const u64 selection = self.m_model.selectionGeneration();
    Array<InputCommandIntent, 8u> rejected = Array<InputCommandIntent, 8u>();
    rejected[0u] = MakeUiEditCommandIntent(InputCommand::Backspace, true, false);
    rejected[1u] = MakeUiEditCommandIntent(InputCommand::Copy, true, false);
    rejected[2u] = MakeUiEditCommandIntent(InputCommand::Accept, true, false);
    rejected[3u] = MakeUiEditCommandIntent(InputCommand::WordLeft, true, false);
    rejected[4u] = MakeUiEditCommandIntent(InputCommand::None, false, true);
    rejected[5u] = MakeUiEditCommandIntent(InputCommand::Activate, false, true);
    rejected[6u] = MakeUiEditCommandIntent(InputCommand::ContextMenu, false, true);
    rejected[7u] = MakeUiEditCommandIntent(MakeUiEditInvalidInputCommand(), true, true);
    for(in InputCommandIntent intent : rejected){
        const EditCommandResult result = ApplyEditCommand(self.m_model, TranslateEditCommand(intent, false, EditTextMode::SingleLine));
        EXPECT_FALSE(result.handled);
        EXPECT_EQ(result.clipboard, EditClipboardAction::None);
        EXPECT_FALSE(result.submitted);
        EXPECT_FALSE(result.cancelled);
        EXPECT_EQ(self.m_model.text(), "one two");
        EXPECT_EQ(self.m_model.anchor(), 1u);
        EXPECT_EQ(self.m_model.caret(), 5u);
        EXPECT_EQ(self.m_model.revision(), revision);
        EXPECT_EQ(self.m_model.selectionGeneration(), selection);
    }
    EXPECT_FALSE(ApplyEditCommand(self.m_model, TranslateEditCommand(MakeUiEditCommandIntent(InputCommand::Backspace, false, true), false, MakeUiEditInvalidTextMode())).handled);
    EXPECT_EQ(self.m_model.revision(), revision);
    EXPECT_EQ(self.m_model.selectionGeneration(), selection);
}

void VerifyUiEditCommandTests_ShiftMovementSelectsWholeGraphemesAndArrowsCollapseAtSelectionEdges(mut UiEditCommandTests self){
    ASSERT_TRUE(self.m_model.setText("a\xCC\x81z"));
    EXPECT_TRUE(ApplyEditCommand(self.m_model, MakeUiEditCommandRequest(EditCommand::Home, false, false)).selectionChanged);
    const EditCommandResult selected = ApplyEditCommand(self.m_model, MakeUiEditCommandRequest(EditCommand::Right, true, false));
    EXPECT_TRUE(selected.handled);
    EXPECT_TRUE(selected.selectionChanged);
    EXPECT_FALSE(selected.textChanged);
    EXPECT_EQ(self.m_model.selectedText(), "a\xCC\x81");
    EXPECT_TRUE(ApplyEditCommand(self.m_model, MakeUiEditCommandRequest(EditCommand::Left, false, false)).selectionChanged);
    EXPECT_EQ(self.m_model.caret(), 0u);
    ASSERT_TRUE(self.m_model.selectAll());
    EXPECT_TRUE(ApplyEditCommand(self.m_model, MakeUiEditCommandRequest(EditCommand::Right, false, false)).selectionChanged);
    EXPECT_EQ(self.m_model.caret(), 4u);
    EXPECT_FALSE(self.m_model.hasSelection());
}

void VerifyUiEditCommandTests_ReadOnlyConsumesMutationsAndAllowsSelectionAndCopy(mut UiEditCommandTests self){
    ASSERT_TRUE(self.m_model.setText("abcd"));
    Array<EditCommandEnum, 8u> mutations = Array<EditCommandEnum, 8u>();
    mutations[0u] = EditCommand::Backspace;
    mutations[1u] = EditCommand::Delete;
    mutations[2u] = EditCommand::WordBackspace;
    mutations[3u] = EditCommand::WordDelete;
    mutations[4u] = EditCommand::Cut;
    mutations[5u] = EditCommand::Paste;
    mutations[6u] = EditCommand::Undo;
    mutations[7u] = EditCommand::Redo;
    for(in EditCommandEnum command : mutations){
        const EditCommandResult result = ApplyEditCommand(self.m_model, MakeUiEditCommandRequest(command, false, false), true);
        EXPECT_TRUE(result.handled);
        EXPECT_FALSE(result.textChanged);
        EXPECT_EQ(result.clipboard, EditClipboardAction::None);
        EXPECT_EQ(self.m_model.text(), "abcd");
    }
    EXPECT_TRUE(ApplyEditCommand(self.m_model, MakeUiEditCommandRequest(EditCommand::SelectAll, false, false), true).selectionChanged);
    EXPECT_EQ(ApplyEditCommand(self.m_model, MakeUiEditCommandRequest(EditCommand::Copy, false, false), true).clipboard, EditClipboardAction::Copy);
}

void VerifyUiEditCommandTests_RepeatsEditTextButNeverDuplicateClipboardSubmitOrCancelRequests(mut UiEditCommandTests self){
    ASSERT_TRUE(self.m_model.setText("abcd"));
    EXPECT_TRUE(ApplyEditCommand(self.m_model, MakeUiEditCommandRequest(EditCommand::Backspace, false, true)).textChanged);
    EXPECT_EQ(self.m_model.text(), "abc");
    Array<EditCommandEnum, 6u> oneShot = Array<EditCommandEnum, 6u>();
    oneShot[0u] = EditCommand::Copy;
    oneShot[1u] = EditCommand::Cut;
    oneShot[2u] = EditCommand::Paste;
    oneShot[3u] = EditCommand::SelectAll;
    oneShot[4u] = EditCommand::Submit;
    oneShot[5u] = EditCommand::Cancel;
    for(in EditCommandEnum command : oneShot){
        const EditCommandResult result = ApplyEditCommand(self.m_model, MakeUiEditCommandRequest(command, false, true));
        EXPECT_TRUE(result.handled);
        EXPECT_FALSE(result.submitted);
        EXPECT_FALSE(result.cancelled);
        EXPECT_FALSE(result.selectionChanged);
        EXPECT_EQ(result.clipboard, EditClipboardAction::None);
    }
}

void VerifyUiEditCommandTests_PreeditOwnsCommandsAndEnterWhileEscapeFirstCancelsOnlyPreedit(mut UiEditCommandTests self){
    ASSERT_TRUE(self.m_model.setText("base"));
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("draft", 0u, 5u));
    Array<EditCommandEnum, 8u> nativeOwned = Array<EditCommandEnum, 8u>();
    nativeOwned[0u] = EditCommand::Backspace;
    nativeOwned[1u] = EditCommand::Right;
    nativeOwned[2u] = EditCommand::SelectAll;
    nativeOwned[3u] = EditCommand::Copy;
    nativeOwned[4u] = EditCommand::Cut;
    nativeOwned[5u] = EditCommand::Paste;
    nativeOwned[6u] = EditCommand::Undo;
    nativeOwned[7u] = EditCommand::Submit;
    for(in EditCommandEnum command : nativeOwned){
        const EditCommandResult result = ApplyEditCommand(self.m_model, MakeUiEditCommandRequest(command, false, false));
        EXPECT_TRUE(result.handled);
        EXPECT_FALSE(result.textChanged);
        EXPECT_FALSE(result.submitted);
        EXPECT_EQ(result.clipboard, EditClipboardAction::None);
        EXPECT_EQ(self.m_model.composition().text, "draft");
    }
    const EditCommandResult cancelled = ApplyEditCommand(self.m_model, MakeUiEditCommandRequest(EditCommand::Cancel, false, false));
    EXPECT_TRUE(cancelled.compositionChanged);
    EXPECT_FALSE(cancelled.cancelled);
    EXPECT_FALSE(self.m_model.composition().active);
    EXPECT_EQ(self.m_model.text(), "base");
    EXPECT_TRUE(ApplyEditCommand(self.m_model, MakeUiEditCommandRequest(EditCommand::Cancel, false, false)).cancelled);
}

void VerifyUiEditCommandTests_EmptyAndUnknownCommandsPreserveTextAndSelection(mut UiEditCommandTests self){
    ASSERT_TRUE(self.m_model.setText("abcd"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 3u));
    EXPECT_FALSE(ApplyEditCommand(self.m_model, EditCommandRequest()).handled);
    EXPECT_FALSE(ApplyEditCommand(self.m_model, MakeUiEditCommandRequest(MakeUiEditInvalidEditCommand(), false, false)).handled);
    EXPECT_EQ(self.m_model.text(), "abcd");
    EXPECT_EQ(self.m_model.selectedText(), "bc");
}


