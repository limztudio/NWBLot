////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_BVH_TRIANGLE_INPUT_SLANGI
#define NWB_GRAPHICS_BVH_TRIANGLE_INPUT_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Shared build-kernel triangle input. Morton generation and bottom-up fitting both consume the exact same sorted triangle stream, so keep the binding declarations and byte-address decoding together.


#include "binding_slots.h"
#include "constants.h"
#include "bvh_common.slangi"
#include "../bindless/bindless_heap.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[vk::push_constant]]
ConstantBuffer<NwbBvhBuildPushConstants> g_NwbBvhBuildPushConstants;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void nwbBvhLoadTrianglePositions(
    const uint triangle,
    out float3 outP0,
    out float3 outP1,
    out float3 outP2
){
    const uint indexBase = triangle * NWB_RAYTRACE_TRIANGLE_CORNER_COUNT;
    const uint indexHeapSlot = g_NwbBvhBuildPushConstants.triangleIndexHeapSlot;
    const uint positionHeapSlot = g_NwbBvhBuildPushConstants.positionHeapSlot;
    const uint i0 = nwbHeapRawBuffer(indexHeapSlot).Load(indexBase * NWB_RAYTRACE_INDEX_STRIDE_BYTES);
    const uint i1 = nwbHeapRawBuffer(indexHeapSlot).Load((indexBase + 1u) * NWB_RAYTRACE_INDEX_STRIDE_BYTES);
    const uint i2 = nwbHeapRawBuffer(indexHeapSlot).Load((indexBase + 2u) * NWB_RAYTRACE_INDEX_STRIDE_BYTES);
    outP0 = asfloat(nwbHeapRawBuffer(positionHeapSlot).Load3(i0 * NWB_RAYTRACE_POSITION_STRIDE_BYTES));
    outP1 = asfloat(nwbHeapRawBuffer(positionHeapSlot).Load3(i1 * NWB_RAYTRACE_POSITION_STRIDE_BYTES));
    outP2 = asfloat(nwbHeapRawBuffer(positionHeapSlot).Load3(i2 * NWB_RAYTRACE_POSITION_STRIDE_BYTES));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

