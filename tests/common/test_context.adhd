const f32 s_DefaultNearlyEqualEpsilon = 0.00001f;

b8 NearlyEqual(in f32 lhs, in f32 rhs, in f32 epsilon){
    return Abs(lhs - rhs) <= epsilon;
}

b8 NearlyEqual(in f32 lhs, in f32 rhs){
    return NearlyEqual(lhs, rhs, s_DefaultNearlyEqualEpsilon);
}

b8 NearlyEqual3(in VectorSingle value, in f32 x, in f32 y, in f32 z, in f32 epsilon){
    const VectorSingle diff = Abs(value - VectorSingle(x, y, z, 0.0f));
    return diff.x <= epsilon && diff.y <= epsilon && diff.z <= epsilon;
}

b8 NearlyEqual3(in VectorSingle value, in f32 x, in f32 y, in f32 z){
    return NearlyEqual3(value, x, y, z, s_DefaultNearlyEqualEpsilon);
}

b8 NearlyEqual3(in f32x4u value, in f32 x, in f32 y, in f32 z, in f32 epsilon){
    return NearlyEqual(value.x, x, epsilon) && NearlyEqual(value.y, y, epsilon) && NearlyEqual(value.z, z, epsilon);
}

b8 NearlyEqual3(in f32x4u value, in f32 x, in f32 y, in f32 z){
    return NearlyEqual3(value, x, y, z, s_DefaultNearlyEqualEpsilon);
}

b8 NearlyEqual4(in VectorSingle value, in f32 x, in f32 y, in f32 z, in f32 w, in f32 epsilon){
    const VectorSingle diff = Abs(value - VectorSingle(x, y, z, w));
    return diff.x <= epsilon && diff.y <= epsilon && diff.z <= epsilon && diff.w <= epsilon;
}

b8 NearlyEqual4(in VectorSingle value, in f32 x, in f32 y, in f32 z, in f32 w){
    return NearlyEqual4(value, x, y, z, w, s_DefaultNearlyEqualEpsilon);
}

usize CountText(in StringView text, in StringView expected){
    if(expected.empty())
        return 0u;

    usize count = 0u;
    usize offset = 0u;
    while(offset < text.size()){
        const usize found = text.find(expected, offset);
        if(found >= text.size())
            break;
        ++count;
        offset = found + expected.size();
    }
    return count;
}

void RecordUnsignedTestProperty(in StringView key, in u64 value){
    native(in key, in value){
        Array<char, s_TestPropertyNumberBufferBytes> text{};
        const AStringView formatted = FormatDecimal(value, text);
        text[formatted.size()] = '\0';
        testing::Test::RecordProperty(AInteropString(key), text.data());
    }
}

