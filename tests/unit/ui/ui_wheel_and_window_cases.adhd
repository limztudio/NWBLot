    EXPECT_FLOAT_EQ(state.bounds.height, 160.0f);
    ASSERT_TRUE(self.finishWindow());
    ASSERT_TRUE(self.m_context.commitFrame(3u));
}

void VerifyUiWindowTests_CollapseKeepsHostSizeAndRequiresBalancedEnd(mut UiWindowTests self){
    WindowState state = WindowState();
    WindowOptions options = WindowOptions();
    options.initialBounds = Rect(30.0f, 40.0f, 240.0f, 150.0f);
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginWindow("window", "Collapse", state, options));
    EXPECT_FALSE(self.m_builder.button("apply", "Apply"));
    ASSERT_TRUE(self.finishWindow());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    self.click(Point(42.0f, 57.0f));
    ASSERT_TRUE(self.begin(2u));
    EXPECT_FALSE(self.m_builder.beginWindow("window", "Collapse", state, options));
    EXPECT_FALSE(self.m_context.failed());
    EXPECT_FALSE(self.m_builder.balanced());
    EXPECT_TRUE(state.collapsed);
    EXPECT_FLOAT_EQ(state.bounds.height, 150.0f);
    ASSERT_TRUE(self.finishWindow());
    EXPECT_TRUE(self.m_builder.balanced());
    const DrawSnapshot collapsed = self.m_paint.freeze();
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_FALSE(self.hasTarget(self.id("apply")));
    EXPECT_FALSE(self.hasTarget(self.id("@window.resize")));
    const auto skin = self.skinQuad(collapsed, 0u);
    ASSERT_TRUE(skin.has_value());
    EXPECT_FLOAT_EQ(skin.value().height, 34.0f);
    EXPECT_FALSE(self.send(MakeUiWindowPointerEvent(Point(100.0f, 120.0f), InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_FALSE(self.send(MakeUiWindowPointerEvent(Point(100.0f, 120.0f), InputEventType::PrimaryUp)).pointerConsumed);
}

void VerifyUiWindowTests_KeyboardCollapseUsesTabFocusAndSuppressesRepeat(mut UiWindowTests self){
    WindowState state = WindowState();
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginWindow("window", "Keyboard", state));
    EXPECT_FALSE(self.m_builder.button("apply", "Apply"));
    ASSERT_TRUE(self.finishWindow());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    EXPECT_TRUE(self.send(MakeUiWindowKeyEvent(UiWindowKey::Tab, InputEventType::KeyDown, false)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiWindowKeyEvent(UiWindowKey::Tab, InputEventType::KeyUp, false)).commandConsumed);
    EXPECT_EQ(self.m_context.input().focus(), self.id("@window.collapse"));
    EXPECT_TRUE(self.send(MakeUiWindowKeyEvent(UiWindowKey::Enter, InputEventType::KeyDown, false)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiWindowKeyEvent(UiWindowKey::Enter, InputEventType::KeyDown, true)).commandConsumed);
    ASSERT_TRUE(self.begin(2u));
    EXPECT_TRUE(self.m_builder.beginWindow("window", "Keyboard", state));
    EXPECT_FALSE(state.collapsed);
    EXPECT_FALSE(self.m_builder.button("apply", "Apply"));
    ASSERT_TRUE(self.finishWindow());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_TRUE(self.send(MakeUiWindowKeyEvent(UiWindowKey::Enter, InputEventType::KeyUp, false)).commandConsumed);
    ASSERT_TRUE(self.begin(3u));
    EXPECT_FALSE(self.m_builder.beginWindow("window", "Keyboard", state));
    ASSERT_TRUE(self.finishWindow());
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    EXPECT_TRUE(state.collapsed);
    EXPECT_TRUE(self.send(MakeUiWindowKeyEvent(UiWindowKey::Space, InputEventType::KeyDown, false)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiWindowKeyEvent(UiWindowKey::Space, InputEventType::KeyUp, false)).commandConsumed);
    ASSERT_TRUE(self.begin(4u));
    EXPECT_TRUE(self.m_builder.beginWindow("window", "Keyboard", state));
    EXPECT_FALSE(state.collapsed);
    ASSERT_TRUE(self.finishWindow());
    ASSERT_TRUE(self.m_context.commitFrame(4u));
}

void VerifyUiWindowTests_DisablingChromeCancelsPendingGesturesAndRestoresContent(mut UiWindowTests self){
    WindowState state = WindowState();
    WindowOptions options = WindowOptions();
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginWindow("window", "Disabled", state, options));
    ASSERT_TRUE(self.finishWindow());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    self.drag(Point(130.0f, 35.0f), Point(165.0f, 61.0f));
    state.collapsed = true;
    options.movable = false;
    options.resizable = false;
    options.collapsible = false;
    ASSERT_TRUE(self.begin(2u));
    EXPECT_TRUE(self.m_builder.beginWindow("window", "Disabled", state, options));
    EXPECT_FALSE(state.collapsed);
    EXPECT_FLOAT_EQ(state.bounds.x, 20.0f);
    EXPECT_FLOAT_EQ(state.bounds.y, 20.0f);
    ASSERT_TRUE(self.finishWindow());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_FALSE(self.hasTarget(self.id("@window.collapse")));
    EXPECT_FALSE(self.hasTarget(self.id("@window.resize")));
    const auto foundTitle = self.tryTarget(self.id("@window.title"));
    ASSERT_TRUE(foundTitle.has_value());
    const HitTarget title = foundTitle.value();
    EXPECT_FALSE(title.pointerGesture);
}

void VerifyUiWindowTests_FocusLossCancelsUnconsumedWindowDrag(mut UiWindowTests self){
