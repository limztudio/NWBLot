#include "style.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Color s_PopupBackdropColor = Color(0.0f, 0.0f, 0.0f, 0.4f);

class PopupStyle{
    public Name background = Name("popup.normal");
    public Name fallback = Name("panel.normal");
    public Insets padding = Insets(s_StyleSpacingMedium, s_StyleSpacingMedium, s_StyleSpacingMedium, s_StyleSpacingMedium);
    public Color backdrop = s_PopupBackdropColor;
}

enum<u8> PopupPlacementSide{
    Below,
    Above,
    Right,
    Left,
    Center,
}

const Point s_PopupDefaultSize = Point(220.0f, 160.0f);

class PopupOptions{
    public Rect anchor;
    public Point size = s_PopupDefaultSize;
    public PopupPlacementSide side = PopupPlacementSide::Below;
    public f32 gap = s_StyleSpacingSmall;
    public b8 modal = false;
    public b8 dismissOutside = true;
    public b8 dismissCancel = true;
    public b8 autofocus = true;
}

class PopupPlacement{
    public Rect bounds;
    public Rect viewport;
    public PopupPlacementSide side = PopupPlacementSide::Below;
}

class ContextMenuOptions{
    public Point size = s_PopupDefaultSize;
    public f32 wheelRows = s_StyleScrollWheelStep;
    public b8 enabled = true;
}

class ContextMenuResult{
    public b8 valid = false;
    public b8 opened = false;
    public b8 closed = false;
    public b8 activated = false;
    public u64 key = 0u;
}

b8 IsValidPopupOptions(in PopupOptions options, in DisplayMetrics display){
    return IsValidUiRect(options.anchor)
        && isFinite(options.size.x)
        && isFinite(options.size.y)
        && options.size.x > 0.0f
        && options.size.y > 0.0f
        && options.side <= PopupPlacementSide::Center
        && isFinite(options.gap)
        && options.gap >= 0.0f
        && isFinite(display.logicalWidth)
        && display.logicalWidth > 0.0f
        && isFinite(display.logicalHeight)
        && display.logicalHeight > 0.0f
        && isFinite(display.pixelScaleX)
        && display.pixelScaleX > 0.0f
        && isFinite(display.pixelScaleY)
        && display.pixelScaleY > 0.0f;
}

PopupPlacementSide OppositePopupPlacementSide(in PopupPlacementSide side){
    switch(side){
    case PopupPlacementSide::Below:
        return PopupPlacementSide::Above;
    case PopupPlacementSide::Above:
        return PopupPlacementSide::Below;
    case PopupPlacementSide::Right:
        return PopupPlacementSide::Left;
    case PopupPlacementSide::Left:
        return PopupPlacementSide::Right;
    default:
        return PopupPlacementSide::Center;
    }
}

void ApplySkinPaletteToPopupStyle(in UiSkinPalette palette, mut PopupStyle style){
    style.backdrop = ResolveUiSkinColor(palette, UiSkinColorRole::PopupBackdrop);
}

Expected<PopupPlacement> TryPlacePopup(in PopupOptions options, in DisplayMetrics display){
    PopupPlacement outPlacement;
    if(!IsValidPopupOptions(options, display))
        return makeUnexpected(Failure());
    const f32 width = min(options.size.x, display.logicalWidth);
    const f32 height = min(options.size.y, display.logicalHeight);
    PopupPlacementSide side = options.side;
    if(side != PopupPlacementSide::Center){
        const b8 vertical = side == PopupPlacementSide::Below || side == PopupPlacementSide::Above;
        f64 required = cast<f64>(width);
        f64 anchorOrigin = cast<f64>(options.anchor.x);
        f64 anchorExtent = cast<f64>(options.anchor.width);
        f64 displayExtent = cast<f64>(display.logicalWidth);
        if(vertical){
            required = cast<f64>(height);
            anchorOrigin = cast<f64>(options.anchor.y);
            anchorExtent = cast<f64>(options.anchor.height);
            displayExtent = cast<f64>(display.logicalHeight);
        }
        const f64 forwardDist = (displayExtent - anchorOrigin - anchorExtent) - cast<f64>(options.gap);
        const f64 backwardDist = anchorOrigin - cast<f64>(options.gap);
        const f64 forwardRoom = clamp(forwardDist, 0.0, displayExtent);
        const f64 backwardRoom = clamp(backwardDist, 0.0, displayExtent);
        const b8 forward = side == PopupPlacementSide::Below || side == PopupPlacementSide::Right;
        f64 preferredRoom = backwardRoom;
        f64 oppositeRoom = forwardRoom;
        if(forward){
            preferredRoom = forwardRoom;
            oppositeRoom = backwardRoom;
        }
        if(preferredRoom < required){
            const PopupPlacementSide opposite = OppositePopupPlacementSide(side);
            if(oppositeRoom >= required || oppositeRoom > preferredRoom)
                side = opposite;
        }
    }
    f64 originX = cast<f64>(options.anchor.x);
    f64 originY = cast<f64>(options.anchor.y);
    switch(side){
    case PopupPlacementSide::Below:
        originY = originY + (cast<f64>(options.anchor.height) + cast<f64>(options.gap));
        break;
    case PopupPlacementSide::Above:
        originY = originY - (cast<f64>(options.gap) + cast<f64>(height));
        break;
    case PopupPlacementSide::Right:
        originX = originX + (cast<f64>(options.anchor.width) + cast<f64>(options.gap));
        break;
    case PopupPlacementSide::Left:
        originX = originX - (cast<f64>(options.gap) + cast<f64>(width));
        break;
    case PopupPlacementSide::Center:
        originX = (cast<f64>(display.logicalWidth) - cast<f64>(width)) * 0.5;
        originY = (cast<f64>(display.logicalHeight) - cast<f64>(height)) * 0.5;
        break;
    }
    const f64 maxX = cast<f64>(display.logicalWidth) - cast<f64>(width);
    const f64 maxY = cast<f64>(display.logicalHeight) - cast<f64>(height);
    const f32 x = cast<f32>(clamp(originX, 0.0, maxX));
    const f32 y = cast<f32>(clamp(originY, 0.0, maxY));
    if(!isFinite(x + width) || !isFinite(y + height))
        return makeUnexpected(Failure());
    outPlacement.bounds = Rect(x, y, width, height);
    outPlacement.viewport = Rect(0.0f, 0.0f, display.logicalWidth, display.logicalHeight);
    outPlacement.side = side;
    return outPlacement;
}

// Anchored placement flips on its requested axis; oversized content shrinks to the logical viewport.
Expected<PopupPlacement> PlacePopup(in PopupOptions options, in DisplayMetrics display){
    return TryPlacePopup(options, display);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

