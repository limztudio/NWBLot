namespace __hidden_suite{

b8 WriteMaterialBindDiscoveryMetadata(const Path& assetRoot){
    if(!WriteTextFile(assetRoot / s_MaterialInterfacesDirectory / "bind_discovery.nwb", "include asset;\r\n\r\nasset.defines = { \"NWB_TEST_MATERIAL_BIND_DISCOVERY\": [\"1\"] };\r\n"))
        return false;
    return WriteTextFile(
        assetRoot / s_MaterialInterfacesDirectory / "bind_discovery.slangi",
        "// limztudio@gmail.com\r\n"
        "////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////\r\n\r\n\r\n"
        "#ifndef NWB_TEST_MATERIAL_BIND_DISCOVERY_SLANGI\r\n"
        "#define NWB_TEST_MATERIAL_BIND_DISCOVERY_SLANGI\r\n\r\n\r\n"
        "////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////\r\n\r\n\r\n"
        "#endif\r\n\r\n\r\n"
        "////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////\r\n\r\n"
    );
}

};

b8 MaterialBindFixture::CookMinimalMeshWithMaterialBind(const AStringView bindText, const CookCase& cookCase, TestArena& testArena){
    const Path assetRoot = cookCase.root / s_AssetsDirectory;
    if(!__hidden_suite::WriteMaterialBindDiscoveryMetadata(assetRoot))
        return false;
    if(!WriteTextFile(assetRoot / s_MeshesDirectory / "minimal_mesh.nwb", s_MinimalMeshMeta))
        return false;
    if(!WriteTextFile(assetRoot / s_MaterialInterfacesDirectory / s_SurfaceBindFilename, bindText))
        return false;

    return CookPreparedGraphicsAssetRoots(testArena, cookCase.root, cookCase.outputDirectory, { assetRoot });
}

Expected<NWB::Impl::MaterialBindEntry> MaterialBindFixture::ParseMaterialBindFromText(const AStringView bindText, const Path& root, TestArena& testArena, NWB::Core::Alloc::ScratchArena& scratchArena){
    const Path bindPath = root / s_AssetsDirectory / s_MaterialInterfacesDirectory / s_SurfaceBindFilename;
    if(!WriteTextFile(bindPath, bindText))
        return MakeUnexpected(Failure{});

    return NWB::Impl::ParseMaterialBindSource(bindPath, testArena.arena, scratchArena);
}

Expected<Path> MaterialBindFixture::EmitDuplicateGeneratedMaterialBindIncludePath(TestArena& testArena, const CookCase& cookCase){
    const Path firstAssetRoot = cookCase.root / "first" / s_AssetsDirectory;
    const Path secondAssetRoot = cookCase.root / "second" / s_AssetsDirectory;
    NWB::Core::Alloc::ScratchArena scratchArena(s_MaterialScratchArena);
    NWB::Impl::MaterialCookVector<NWB::Impl::MaterialBindEntry> bindEntries(testArena.arena);
    for(const Path& assetRoot : InitializerList<Path>{ firstAssetRoot, secondAssetRoot }){
        const Path bindPath = assetRoot / s_MaterialInterfacesDirectory / s_SurfaceBindFilename;
        if(!WriteTextFile(bindPath, s_MinimalMaterialBindSource))
            return MakeUnexpected(Failure{});

        auto bindEntry = NWB::Impl::ParseMaterialBindSource(bindPath, testArena.arena, scratchArena);
        if(!bindEntry)
            return MakeUnexpected(bindEntry.error());
        auto virtualPath = NWB::Core::Assets::AssetPathsDetail::BuildDerivedAssetVirtualPathText(assetRoot, NWB::Core::Assets::s_ProjectVirtualRoot, bindPath, testArena.arena, scratchArena);
        if(!virtualPath)
            return MakeUnexpected(virtualPath.error());
        bindEntry->virtualPath = Move(*virtualPath);
        bindEntries.push_back(Move(*bindEntry));
    }

    return NWB::Impl::EmitMaterialBindIncludes(cookCase.root / s_CacheDirectory, s_TestsConfiguration, bindEntries, testArena.arena, scratchArena);
}

b8 MaterialBindFixture::WriteMaterialBindShaderProbeSource(
    TestArena& testArena,
    const Path& assetRoot,
    const AStringView shaderAssetType,
    const AStringView metaFilename,
    const AStringView sourceFilename,
    const AStringView sourceText
){
    const Path engineGraphicsIncludeRoot = AssetsGraphicsTestRepoRoot(testArena) / s_EngineDirectory / s_AssetsDirectory / s_GraphicsDirectory;
    NWB::Impl::ShaderCook::CookString shaderMeta(testArena.arena);
    shaderMeta += shaderAssetType;
    shaderMeta += " asset;\n\n" "asset.entry_point = \"main\";\n" "asset.include_roots = [\"";
#if defined(FOUNDATION_UNICODE)
    auto out = BackInserter(shaderMeta);
    WriteConvertedText<char>(out, engineGraphicsIncludeRoot.native());
#else
    shaderMeta.append(engineGraphicsIncludeRoot.native());
#endif
    shaderMeta += "\"];\n";

    if(!WriteTextFile(assetRoot / s_ShadersDirectory / metaFilename, AStringView(shaderMeta.data(), shaderMeta.size())))
        return false;
    return WriteTextFile(assetRoot / s_ShadersDirectory / sourceFilename, sourceText);
}

b8 MaterialBindFixture::WriteMaterialBindMaterialIntegrationAssetsWithPixelSource(
    TestArena& testArena,
    const Path& assetRoot,
    const AStringView bindText,
    const AStringView materialText,
    const AStringView pixelSourceText
){
    if(!WriteTextFile(assetRoot / s_MaterialInterfacesDirectory / s_SurfaceBindFilename, bindText))
        return false;
    if(!WriteMaterialBindShaderProbeSource(testArena, assetRoot, "mesh_shader", "material_mesh.nwb", "material_mesh.slang", s_MaterialBindMeshSource))
        return false;
    if(!WriteMaterialBindShaderProbeSource(testArena, assetRoot, "pixel_shader", "material_ps.nwb", "material_ps.slang", pixelSourceText))
        return false;
    if(!WriteTextFile(assetRoot / s_ShadersDirectory / "material_bxdf.bxdf", s_MaterialBindBxdfSource))
        return false;
    return WriteTextFile(assetRoot / "materials" / "test_material.nwb", materialText);
}

b8 MaterialBindFixture::CookMaterialBindMaterialIntegrationWithPixelSource(
    const AStringView bindText,
    const AStringView materialText,
    const AStringView pixelSourceText,
    const CookCase& cookCase,
    TestArena& testArena
){
    const Path assetRoot = cookCase.root / s_AssetsDirectory;
    if(!WriteMaterialBindMaterialIntegrationAssetsWithPixelSource(testArena, assetRoot, bindText, materialText, pixelSourceText))
        return false;

    return CookPreparedGraphicsAssetRoots(testArena, cookCase.root, cookCase.outputDirectory, { assetRoot });
}

Expected<NWB::Core::GraphicsVector<NWB::Core::ShaderArchive::Record>> ShaderArchiveFixture::LoadCookedShaderArchiveRecords(TestArena& testArena, const Path& outputDirectory){
    NWB::Core::Filesystem::VolumeMountDesc mountDesc(testArena.arena);
    mountDesc.volumeName = "graphics";
    mountDesc.mountDirectory = outputDirectory;
    auto filesystemResult = NWB::Core::Filesystem::CreateFilesystem(testArena.arena, mountDesc);
    const b8 loadedVolume = static_cast<b8>(filesystemResult);
    EXPECT_TRUE(loadedVolume);
    if(!loadedVolume)
        return MakeUnexpected(filesystemResult.error());
    UniquePtr<NWB::Core::Filesystem::IFilesystem> filesystem = Move(*filesystemResult);

    NWB::Core::GraphicsBytes indexBinary(testArena.arena);
    const b8 loadedIndex = filesystem->readFile(NWB::Core::ShaderArchive::s_IndexVirtualPathName, indexBinary);
    EXPECT_TRUE(loadedIndex);
    EXPECT_FALSE(indexBinary.empty());
    if(!loadedIndex || indexBinary.empty())
        return MakeUnexpected(Failure{});

    auto deserialized = NWB::Core::ShaderArchive::DeserializeIndex(testArena.arena, { indexBinary.data(), indexBinary.size() });
    EXPECT_TRUE(deserialized);
    return deserialized;
}

Expected<u64> ShaderArchiveFixture::FindShaderArchiveSourceChecksum(const Span<const NWB::Core::ShaderArchive::Record> records, const Name shaderName, const Name stageName)noexcept{
    for(const NWB::Core::ShaderArchive::Record& record : records){
        const AStringView variantName(record.variantName.data(), record.variantName.size());
        if(record.shaderName == shaderName && record.stage == stageName && variantName == NWB::Core::ShaderArchive::s_DefaultVariant){
            if(record.sourceChecksum == 0u)
                return MakeUnexpected(Failure{});
            return record.sourceChecksum;
        }
    }

    return MakeUnexpected(Failure{});
}


