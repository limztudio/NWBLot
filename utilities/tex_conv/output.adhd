#include <utilities/tex_conv/global.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TexConvOutputPaths{
    public Path metadata;
    public Path data;
}

b8 IsValidTexConvDescriptorText(in StringView format, in StringView dimension, in StringView alphaMode){
    return !format.empty() && !dimension.empty() && !alphaMode.empty();
}

b8 IsCompleteTexConvMipCount(in b8 hasMipCount, in u32 completeMipCount, in u32 payloadMipCount){
    return hasMipCount && completeMipCount == payloadMipCount;
}

Expected<TexConvOutputPaths> ResolveTexConvOutputPaths(in Path inputPath, in StringView outputArgument){
    TexConvOutputPaths paths;
    if(outputArgument.empty()){
        paths.metadata = inputPath;
        paths.metadata.replaceExtension(s_NwbOutputExtension);
    }
    else{
        const Path outputBase(outputArgument);
        if(outputBase.extension().empty() || IsNwbTexConvOutputPath(outputBase))
            paths.metadata = outputBase;
        else{
            error("tex_conv: --output must be an output base name or a .nwb filename.");
            return MakeUnexpected(Failure());
        }
        paths.metadata.replaceExtension(s_NwbOutputExtension);
    }

    paths.data = paths.metadata;
    paths.data.replaceExtension(s_TexOutputExtension);
    return paths;
}

String BuildTexConvMetadataText(
    in StringView format,
    in StringView dimension,
    in u32 width,
    in u32 height,
    in u32 depth,
    in b8 is3d,
    in StringView alphaMode,
    in b8 isConstantUnorm8,
    in u8 alphaConstantUnorm8
){
    String out;
    out.reserve(s_MetadataTextReserveBytes);
    out.append("// Generated by tex_conv. The same-stem .tex file contains raw linear UASTC blocks.");
    out.append(s_NewLine);
    out.append("texture asset;");
    out.append(s_NewLine);
    out.append(s_NewLine);
    out.append("asset.format = \"");
    out.append(format);
    out.append("\";");
    out.append(s_NewLine);
    out.append("asset.dimension = \"");
    out.append(dimension);
    out.append("\";");
    out.append(s_NewLine);
    out.append("asset.resolution = [");
    AppendUnsignedU64Text(out, cast<u64>(width));
    out.append(", ");
    AppendUnsignedU64Text(out, cast<u64>(height));
    if(is3d){
        out.append(", ");
        AppendUnsignedU64Text(out, cast<u64>(depth));
    }
    out.append("];");
    out.append(s_NewLine);
    out.append("asset.alpha_mode = \"");
    out.append(alphaMode);
    out.append("\";");
    out.append(s_NewLine);
    if(isConstantUnorm8){
        out.append("asset.alpha_constant_unorm8 = ");
        AppendUnsignedU64Text(out, cast<u64>(alphaConstantUnorm8));
        out.append(";");
        out.append(s_NewLine);
    }
    return out;
}

void LogTexConvStagedValidationFailure(in u8 failureStage, in Path path, in StringView errorMessage){
    const String pathText = PathToString(path);
    if(failureStage == 1u || failureStage == 6u)
        error("tex_conv: failed to query output path '{}': {}", pathText, errorMessage);
    else if(failureStage == 2u)
        error("tex_conv: failed to inspect output path '{}': {}", pathText, errorMessage);
    else if(failureStage == 3u)
        error("tex_conv: output path is not a regular file: '{}'", pathText);
    else if(failureStage == 7u)
        error("tex_conv: publication work path already exists: '{}'", pathText);
    else if(failureStage == 5u)
        error("tex_conv: Output already exists: '{}'. Pass --force to replace both output files.", pathText);
}


