native{
#include <impl/ecs_render/deferred/deferred_frame_targets.adhd.h>
#include <impl/ecs_render/raytrace/raytracing_system.adhd.h>
#include <impl/ecs_render/raytrace/task_graph_scene_resources.adhd.h>
#include <impl/ecs_render/kernel/timing_names.adhd.h>

#include <core/common/log.h>
#include <core/graphics/runtime/runtime.h>
#include <core/task/gpu/task_graph.h>
#include <core/task/gpu/capture/command_ir.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace RendererTaskGraphDetail{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct RefractionClearTileArgumentsGraphTask{
    static constexpr Core::GpuTaskCommandRequirements s_CommandRequirements = { Core::GpuQueueCapability::Transfer };


public:
    struct Payload{
        Core::GraphicsRuntime& graphics;
        Core::BufferHandle destination;
        Core::GpuGraphResourceId resource;
    };


public:
    static b8 Record(const Payload& payload, Core::CommandList& commandList, const Core::GpuTaskRecordContext& context);
};


// Diagnostic work stays on the resolve's primary Graphics queue.
// Shared counter writes and the bounded copy serialize there; accepted readbacks never introduce a renderer wait.
struct RefractionClearStatisticsGraphTask{
    static constexpr Core::GpuTaskCommandRequirements s_CommandRequirements = { Core::GpuQueueCapability::Transfer, true };


public:
    struct Payload{
        Core::BufferHandle destination;
        Core::GpuGraphResourceId resource;
    };


public:
    static b8 Record(const Payload& payload, Core::CommandList& commandList, const Core::GpuTaskRecordContext& context);
};

struct RefractionStatisticsReadbackGraphTask{
    static constexpr Core::GpuTaskCommandRequirements s_CommandRequirements = { Core::GpuQueueCapability::Transfer, true };


public:
    struct Payload{
        Core::BufferHandle source;
        Core::BufferHandle destination;
        Core::GpuGraphResourceId sourceResource;
        Core::GpuGraphResourceId destinationResource;
        RefractionStatisticsReservation reservation;
        const b8* hardwarePreparationReady = nullptr;
        b8 hardwareEnabled = false;
    };


public:
    static b8 Record(const Payload& payload, Core::CommandList& commandList, const Core::GpuTaskRecordContext& context);
    static void Accepted(Payload& payload, const Core::QueueSubmissionToken& token)noexcept;

    static void Discarded(Payload& payload)noexcept{
        payload.reservation.discard();
    }
};


struct RefractionClassifyTilesGraphTask{
    static constexpr Core::GpuTaskCommandRequirements s_CommandRequirements = { Core::GpuQueueCapability::Compute };


public:
    struct Payload{
        RendererRayTracingSystem& system;
        const DeferredFrameTargets& targets;
        RayTracingRefractionGraphResources resources;
    };


public:
    static b8 Record(const Payload& payload, Core::CommandList& commandList, const Core::GpuTaskRecordContext&){
        return payload.system.refraction().recordRefractionTileClassification(commandList, payload.targets, payload.resources);
    }
};


struct RefractionResolveGraphTask{
    static constexpr Core::GpuTaskCommandRequirements s_CommandRequirements = { Core::GpuQueueCapability::Compute };


public:
    // The raytracing system and the frame targets are required: the resolve always records against this frame's targets.
    // Readiness and latches stay optional: screen fallback declares no HW prep; only the traced route publishes diagnostics.
    struct Payload{
        RendererRayTracingSystem& system;
        const DeferredFrameTargets& targets;
        RayTracingRefractionGraphResources resources;
        const b8* hardwarePreparationReady = nullptr;
        b8* dispatchLogged = nullptr;
        b8* screenFallbackDispatchLogged = nullptr;
    };


public:
    static b8 Record(const Payload& payload, Core::CommandList& commandList, const Core::GpuTaskRecordContext&);
    static void Accepted(Payload& payload, const Core::QueueSubmissionToken& token);
};

// Diagnostic counter reuse has an explicit physical-queue contract across frame rejection.
// Keep ordinary resolve scheduling unchanged when diagnostics are disabled.
struct RefractionDiagnosticResolveGraphTask : RefractionResolveGraphTask{
    static constexpr Core::GpuTaskCommandRequirements s_CommandRequirements = { Core::GpuQueueCapability::Compute, true };
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct FrameGraphRefractionResolveInputs{
    DeferredFrameTargets& targets;
    const RayTracingSceneGraphResources& sceneResources;
    const RayTracingRefractionGraphResources& refractionResources;
    b8 refractionActive = false;
    Core::GpuGraphResourceId depth;
    Core::GpuGraphResourceId worldPosition;
    Core::GpuGraphResourceId refractionDepth;
    Core::GpuGraphResourceId refractionNormalIor;
    Core::GpuGraphResourceId refractionTintCoverage;
    Core::GpuGraphResourceId refractionInstance;
    Core::GpuGraphResourceId refractionResolve;
    Core::GpuGraphResourceId opaqueColor;
    Core::GpuGraphResourceId opaqueReflectionRadiance;
    Core::GpuGraphResourceId meshView;
    Core::GpuGraphResourceId currentBindlessSlots;
    Core::GpuGraphResourceId sceneShading;
    Core::GpuGraphResourceId lights;
    Core::GpuGraphResourceId avboitAccumColor;
    Core::GpuGraphResourceId avboitAccumExtinction;
    Core::GpuGraphResourceId avboitForegroundColor;
    Core::GpuGraphResourceId avboitForegroundExtinction;
    Core::GpuGraphResourceSetId hardwareTraceGeometrySet;
    Core::GpuGraphResourceSetId traceMaterialSampledTextureSet;
    Core::GpuTaskId traceContextUploadTask;
    Core::GpuTaskId reflectionCompletionTask;
    Core::GpuTaskId avboitFinalTask;
    Core::GpuTaskId surfelGiTask;
    const b8& hardwarePreparationReady;
    b8& refractionHardwareLogged;
    b8& refractionScreenLogged;
};

class FrameGraphRefractionResolve final : NoCopy{
public:
    FrameGraphRefractionResolve(Core::GpuTaskGraph& graph, Core::GraphicsRuntime& graphics, RendererRayTracingSystem& raytracingSystem)noexcept
        : m_graph(graph)
        , m_graphics(graphics)
        , m_raytracingSystem(raytracingSystem)
    {}


public:
    [[nodiscard]] Expected<Core::GpuTaskId> declare(const FrameGraphRefractionResolveInputs& inputs, Core::Alloc::ScratchArena& scratchArena, RayTracingSceneGraphReads& sceneReads);


private:
    Core::GpuTaskGraph& m_graph;
    Core::GraphicsRuntime& m_graphics;
    RendererRayTracingSystem& m_raytracingSystem;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ImplEcsRenderRefractionTaskGraphRefractionResolveAdhdModule(in u64 value){
    return value != 0u;
}


