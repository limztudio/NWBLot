b8 DrawSkinGallery(mut PaintBuilder paint, in f32 originX, in f32 originY, in f32 captionHeight){
    const f32 leftColumnX = originX + s_LeftColumnX;
    const f32 rightColumnX = originX + s_RightColumnX;
    const f32 buttonTopY = originY + s_ButtonTopY;
    const f32 buttonBottomY = originY + s_ButtonBottomY;
    return
        paint.drawRegion(s_Panel, Rect(originX, originY, s_OrdinaryGalleryWidth, s_PanelBaseHeight + captionHeight))
        && paint.drawRegion(s_ButtonNormal, Rect(leftColumnX, buttonTopY, s_ButtonWidth, s_ButtonHeight))
        && paint.drawRegion(s_ButtonHover, Rect(rightColumnX, buttonTopY, s_ButtonWidth, s_ButtonHeight))
        && paint.drawRegion(s_ButtonPressed, Rect(leftColumnX, buttonBottomY, s_ButtonWidth, s_ButtonHeight))
        && paint.drawRegion(s_ButtonDisabled, Rect(rightColumnX, buttonBottomY, s_ButtonWidth, s_ButtonHeight))
        && paint.drawRegion(s_EditFocused, Rect(leftColumnX, originY + s_EditFocusedY, s_EditFocusedWidth, s_EditFocusedHeight))
        && paint.drawRegion(s_ComboArrow, Rect(originX + s_ComboArrowX, originY + s_ComboArrowY, s_ComboArrowSize, s_ComboArrowSize))
        && paint.drawRegion(s_Checkbox, Rect(originX + s_CheckboxX, originY + s_CheckboxY, s_CheckboxSize, s_CheckboxSize))
        && paint.drawRegion(s_CheckboxMark, Rect(originX + s_CheckboxMarkX, originY + s_CheckboxMarkY, s_CheckboxMarkSize, s_CheckboxMarkSize))
        && paint.drawRegion(s_ProgressTrack, Rect(leftColumnX, originY + s_ProgressTrackY, s_ProgressTrackWidth, s_ProgressTrackHeight))
        && paint.drawRegion(s_ProgressFill, Rect(originX + s_ProgressFillX, originY + s_ProgressFillY, s_ProgressFillWidth, s_ProgressFillHeight))
        && paint.drawRegion(s_EditNormal, Rect(leftColumnX, originY + s_EditNormalY, s_EditNormalWidth, captionHeight))
    ;
}

b8 ConfigureLabelWithSize(in StringView text, in f32 size, mut Label outLabel){
    ShapeRequest request = ShapeRequest();
    request.text = text;
    request.fontSize = size;
    return outLabel.setText(request) == TextLayoutStatus::Success;
}

b8 ConfigureLabel(in StringView text, mut Label outLabel){
    return ConfigureLabelWithSize(text, s_LabelFontSize, outLabel);
}

b8 ConfigureKoreanLabel(mut Label outLabel){
    ShapeRequest request = ShapeRequest();
    request.text = s_KoreanText;
    request.language = "ko";
    request.fontSize = s_LabelFontSize;
    request.scriptTag = PackFourCharTag(72u, 97u, 110u, 103u);
    return outLabel.setText(request) == TextLayoutStatus::Success;
}


