[cpp_header("<core/graphics/rhi/pipeline_state.h>"), cpp_name("::NWB::Core::BlendFactor::Enum")]
extern enum BlendFactor : u8{
    Zero,
    One,
    SrcColor,
    InvSrcColor,
    SrcAlpha,
    InvSrcAlpha,
    DstAlpha,
    InvDstAlpha,
    DstColor,
    InvDstColor,
    SrcAlphaSaturate,
    ConstantColor,
    InvConstantColor,
    Src1Color,
    InvSrc1Color,
    Src1Alpha,
    InvSrc1Alpha
};

[cpp_header("<core/graphics/rhi/pipeline_state.h>"), cpp_name("::NWB::Core::BlendOp::Enum")]
extern enum BlendOp : u8{
    Add,
    Subtract,
    ReverseSubtract,
    Min,
    Max
};

[cpp_header("<core/graphics/rhi/pipeline_state.h>"), cpp_name("::NWB::Core::ColorMask::Mask")]
extern flag ColorMask : u8{
    None,
    Red,
    Green,
    Blue,
    Alpha,
    All
};

[cpp_header("<core/graphics/rhi/pipeline_state.h>"), cpp_name("::NWB::Core::ComparisonFunc::Enum")]
extern enum ComparisonFunc : u8{
    Never,
    Less,
    Equal,
    LessOrEqual,
    Greater,
    NotEqual,
    GreaterOrEqual,
    Always
};

[cpp_header("<core/graphics/rhi/pipeline_state.h>"), cpp_name("::NWB::Core::RasterCullMode::Enum")]
extern enum RasterCullMode : u8{
    Back,
    Front,
    None
};

[cpp_header("<core/graphics/rhi/pipeline_state.h>"), cpp_name("::NWB::Core::RasterFillMode::Enum")]
extern enum RasterFillMode : u8{
    Solid,
    Wireframe
};

[cpp_header("<core/graphics/rhi/pipeline_state.h>"), cpp_name("::NWB::Core::SamplerAddressMode::Enum")]
extern enum SamplerAddressMode : u8{
    Clamp,
    Wrap,
    Border,
    Mirror,
    MirrorOnce
};

[cpp_header("<core/graphics/rhi/pipeline_state.h>"), cpp_name("::NWB::Core::SamplerReductionType::Enum")]
extern enum SamplerReductionType : u8{
    Standard,
    Comparison,
    Minimum,
    Maximum
};

[cpp_header("<core/graphics/rhi/pipeline_state.h>"), cpp_name("::NWB::Core::StencilOp::Enum")]
extern enum StencilOp : u8{
    Keep,
    Zero,
    Replace,
    IncrementAndClamp,
    DecrementAndClamp,
    Invert,
    IncrementAndWrap,
    DecrementAndWrap
};


