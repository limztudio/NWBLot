////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<impl/assets/graphics/gi/surfel/surfel_binding_slots.h>"), cpp_name("NWB_SURFEL_CONSTANTS_FLOAT4_COUNT")]
extern const u32 s_ShaderSurfelConstantsFloat4Count;

[cpp_header("<impl/assets/graphics/gi/surfel/surfel_binding_slots.h>"), cpp_name("NWB_SURFEL_UPDATE_DIVISOR")]
extern const u32 s_ShaderSurfelUpdateDivisor;


[cpp_header("<impl/assets/graphics/gi/surfel/surfel_binding_slots.h>"), cpp_name("NWB_SURFEL_MAX_AGE")]
extern const u32 s_ShaderSurfelMaxAge;


[cpp_header("<impl/assets/graphics/gi/surfel/surfel_binding_slots.h>"), cpp_name("NWB_SURFEL_SPAWN_TILE")]
extern const u32 s_ShaderSurfelSpawnTile;
static_assert(size_of<NwbSurfelConstantsGpu>() == size_of<f32x4>() * s_ShaderSurfelConstantsFloat4Count, "NwbSurfelConstantsGpu must match the shader NwbSurfelConstants layout");
static_assert(s_SurfelUpdateDivisor == s_ShaderSurfelUpdateDivisor, "s_SurfelUpdateDivisor must match NWB_SURFEL_UPDATE_DIVISOR");
static_assert(s_SurfelCellSize == s_ShaderSurfelCellSize, "s_SurfelCellSize must match NWB_SURFEL_CELL_SIZE");
static_assert(s_SurfelDefaultRadius == s_ShaderSurfelDefaultRadius, "s_SurfelDefaultRadius must match NWB_SURFEL_DEFAULT_RADIUS");
static_assert(s_SurfelMaxAccum == s_ShaderSurfelMaxAccum, "s_SurfelMaxAccum must match NWB_SURFEL_MAX_ACCUM");
static_assert(s_SurfelMaxAge == s_ShaderSurfelMaxAge, "s_SurfelMaxAge must match NWB_SURFEL_MAX_AGE");
static_assert(s_SurfelRaysPerSurfel == s_ShaderSurfelRaysPerSurfel, "s_SurfelRaysPerSurfel must match NWB_SURFEL_RAYS_PER_SURFEL");
static_assert(s_SurfelSpawnTile == s_ShaderSurfelSpawnTile, "s_SurfelSpawnTile must match NWB_SURFEL_SPAWN_TILE");


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> SurfelGraphPhase{
    AgeFree,
    HashBuild,
    Spawn,
    TraceBuildArgs,
    Trace,
    Resolve,
    Upsample,
    kCount
}

b8 RequiresActiveSurfelAsyncTiming(in b8 isComputeQueue, in b8 hasAsyncTimingValue){
    return isComputeQueue && !hasAsyncTimingValue;
}

class SurfelGiPhaseTask{
    private mut RendererRayTracingSystem m_system;
    private mut DeferredFrameTargets m_targets;
    private DeferredLightingGraphResources m_lighting;
    private mut GpuTimingSubmissionTicket m_ticket;
    private Optional<mut Optional<GpuTimingMeasure>> m_timing;
    private SurfelGraphPhase m_phase;

    public SurfelGiPhaseTask(
        mut RendererRayTracingSystem system,
        mut DeferredFrameTargets targets,
        in DeferredLightingGraphResources lighting,
        mut GpuTimingSubmissionTicket ticket,
        in Optional<mut Optional<GpuTimingMeasure>> timing,
        in SurfelGraphPhase phase
    ){
        this.m_system = system;
        this.m_targets = targets;
        this.m_lighting = lighting;
        this.m_ticket = ticket;
        this.m_timing = timing;
        this.m_phase = phase;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.m_lighting.valid())
            return false;
        const auto queue = context.compiledPlan.findQueueInfo(context.queue);
        if(!queue.has_value())
            return false;
        const b8 compute = queue.value().queueClass == CommandQueue::Compute;
        const b8 timed = this.m_timing.has_value() && this.m_timing.value().has_value();
        if(this.m_phase == SurfelGraphPhase::AgeFree && (!this.m_timing.has_value() || timed))
            return false;
        if(this.m_phase != SurfelGraphPhase::AgeFree && this.m_phase != SurfelGraphPhase::Upsample && RequiresActiveSurfelAsyncTiming(compute, timed))
            return false;
        GpuTimingTicketRecordingScope recording(this.m_ticket);
        if(this.m_phase == SurfelGraphPhase::Upsample && this.m_system.hasSurfelWork() && RequiresActiveSurfelAsyncTiming(compute, timed))
            return false;
        if(this.m_phase == SurfelGraphPhase::AgeFree && compute){
            mut GraphicsRuntime graphics = this.m_system.graphics();
            this.m_timing.value().emplace(graphics.gpuTiming(), s_TimingScopeAsyncSurfelGi, graphics.getDevice(), commandList);
        }
        if(!this.m_system.renderSurfelGiPhases(
            commandList, this.m_targets, this.m_lighting, this.m_phase == SurfelGraphPhase::AgeFree,
            this.m_phase == SurfelGraphPhase::HashBuild, this.m_phase == SurfelGraphPhase::Spawn,
            this.m_phase == SurfelGraphPhase::TraceBuildArgs, this.m_phase == SurfelGraphPhase::Trace,
            this.m_phase == SurfelGraphPhase::Resolve, this.m_phase == SurfelGraphPhase::Upsample
        )){
            if(this.m_timing.has_value())
                DiscardGpuTimingMeasure(this.m_timing.value());
            return false;
        }
        if(this.m_timing.has_value() && this.m_timing.value().has_value()){
            if(this.m_phase == SurfelGraphPhase::AgeFree)
                return FinishSplitGpuTimingMarker(this.m_timing.value());
            if(this.m_phase == SurfelGraphPhase::Upsample){
                this.m_timing.value().value().finishTiming(commandList);
                this.m_timing.value().reset();
            }
        }
        return true;
    }

    public void accepted(in QueueSubmissionToken token){
        if(this.m_phase == SurfelGraphPhase::Trace)
            this.m_system.confirmRayTraceContextReadSubmission(token);
    }

    public void discarded(){
        if(this.m_timing.has_value())
            DiscardGpuTimingMeasure(this.m_timing.value());
    }
}

class SurfelGiInitializationTask{
    private mut RendererRayTracingSystem m_system;

    public SurfelGiInitializationTask(mut RendererRayTracingSystem system){
        this.m_system = system;
    }
    public GpuTaskCommandRequirements commandRequirements()const{
        return GpuTaskCommandRequirements();
    }
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        return this.m_system.recordSurfelResourceInitializationLifecycle();
    }
    public void accepted(in QueueSubmissionToken token){
        this.m_system.finalizeSurfelResourceInitialization();
    }
    public void discarded(){
        this.m_system.discardSurfelResourceInitialization();
    }
}

[cpp_unwind]
Expected<GpuTaskId> DeclareSurfelInitializationTask(mut RendererRayTracingSystem system, mut GpuTaskGraph graph, in GpuTaskDesc desc){
    return graph.addPayloadTask(desc, SurfelGiInitializationTask(system));
}

Expected<GpuTaskId> SurfelGiTaskBuilder::declareAgeFreeTask(
    in GpuTaskDesc desc,
    in DeferredLightingGraphResources deferredLightingResources,
    mut DeferredFrameTargets targets,
    mut GpuTimingSubmissionTicket timingTicket,
    mut Optional<GpuTimingMeasure> asyncTiming
){
    return this.m_graph.addPayloadTask(desc, SurfelGiPhaseTask(this.m_system, targets, deferredLightingResources, timingTicket, Optional<mut Optional<GpuTimingMeasure>>(asyncTiming), SurfelGraphPhase::AgeFree));
}

