[reflect]
enum<u8> ReflectionTraceMode{
    Disabled,
    ScreenSpace,
    Hardware,
    Hybrid
}

[reflect]
enum<u8> ReflectionDebugView{
    None,
    TraceSource,
    Confidence
}

// Root wiring retains textures and declares reads; compositing sees only this contract.
class ReflectionCompositeInputs{
    public u32 opaqueRadianceSlot = 0xffffffffu;
    public u32 glassRadianceSlot = 0xffffffffu;
    public ReflectionDebugView debugView = ReflectionDebugView::None;
}

ReflectionCompositeInputs MakeReflectionCompositeInputs(in u32 opaqueRadianceSlot, in u32 glassRadianceSlot, in ReflectionDebugView debugView){
    ReflectionCompositeInputs inputs;
    inputs.opaqueRadianceSlot = opaqueRadianceSlot;
    inputs.glassRadianceSlot = glassRadianceSlot;
    inputs.debugView = debugView;
    return inputs;
}

