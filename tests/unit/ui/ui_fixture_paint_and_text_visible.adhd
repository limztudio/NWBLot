using namespace Impl;
using namespace Impl::Ui;
using UiWidgetTests::s_TestSkinPath;

inline constexpr AStringView s_DefaultImagePath = "tests/ui/image";

void ExpectSameImagePaint(const DrawSnapshot& actual, const DrawSnapshot& expected);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class PaintImageFixture : public testing::Test{
public:
    PaintImageFixture()
        : m_arena(Name(NWB::Tests::UiCases::s_UiCaseTestsUiPaintImage))
        , m_skin(m_arena, Name(s_TestSkinPath))
        , m_builder(m_arena)
    {
        UiSkin::RegionVector regions(m_arena);
        regions.push_back({ Name(NWB::Tests::UiCases::s_UiCaseSprite), { 0u, 0u, 8u, 8u }, {}, {}, 0.0f, 0.0f, UiSkinDrawMode::Sprite });
        m_skin.setAtlas(Core::Assets::AssetRef<Texture>("tests/ui/skin_texture"), 16u, 16u, 1.0f, Move(regions));
        beginPaint(m_builder);
    }


public:
    void beginPaint(PaintBuilder& builder, u64 generation = 1u);
    [[nodiscard]] Expected<SharedGlyphPage> makeGlyph(const u64 atlasIdentity = 11u, const u64 generation = 1u){
        return UiPaintTextTests::MakeTestGlyphPage(m_arena, atlasIdentity, generation);
    }
    [[nodiscard]] Expected<SharedSdfAtlasPage> makeSdf(const u64 atlasIdentity = 22u){
        return UiPaintTextTests::MakeTestSdfAtlasPage(m_arena, atlasIdentity);
    }
    [[nodiscard]] Expected<SharedImageSource> makeImage(const StringView path = s_DefaultImagePath, const u8 seed = 37u, const u32 width = 8u, const u32 height = 4u){
        if(path.empty() || width == 0u || height == 0u)
            return MakeUnexpected(Failure{});
        return UiFixtureSupport::MakeSeededImage(path, seed, width, height, m_arena);
    }


public:
    Core::Alloc::GlobalArena m_arena;
    UiSkin m_skin;
    PaintBuilder m_builder;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


