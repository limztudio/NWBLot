[cpp_name("::BoundingDoubleSphere"), cpp_flags(binary_serializable, brace_init)]
extern class BoundingDoubleSphere{
    f64x4 centerRadius;

    ContainmentType containedBy(...)const;
    ContainmentType contains(...)const;
    ContainmentType containsBoxValues(...)const;
    ContainmentType containsFrustumValues(...)const;
    ContainmentType containsOrientedBoxValues(...)const;
    ContainmentType containsSphereValue(...)const;
    b8 intersects(...)const;
    b8 intersectsBoxValues(...)const;
    b8 intersectsOrientedBoxValues(...)const;
    b8 intersectsSphereValue(...)const;
    void transform(...)const;
};

[cpp_name("::BoundingSphere"), cpp_flags(small_value, binary_serializable, brace_init)]
extern class BoundingSphere{
    f32x4 centerRadius;

    ContainmentType containedBy(...)const;
    ContainmentType contains(...)const;
    ContainmentType containsBoxValues(...)const;
    ContainmentType containsFrustumValues(...)const;
    ContainmentType containsOrientedBoxValues(...)const;
    ContainmentType containsSphereValue(...)const;
    b8 intersects(...)const;
    b8 intersectsBoxValues(...)const;
    b8 intersectsOrientedBoxValues(...)const;
    b8 intersectsSphereValue(...)const;
    void transform(...)const;
};


