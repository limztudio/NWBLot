////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_BVH_SW_INSTANCE_SLANGI
#define NWB_GRAPHICS_BVH_SW_INSTANCE_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "../bindless/bindless_heap.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Shared software-BVH scene-instance ABI. The three affine rows plus four trailing words match the 64-byte C++ SceneSwBvhInstanceGpu record.
struct NwbSwBvhInstance{
    float4 worldToObjectRow0;
    float4 worldToObjectRow1;
    float4 worldToObjectRow2;
    uint reservedMeshIndex;
    uint primitiveCount;
    uint pad0;
    uint pad1;
};

#pragma warning(push)
#pragma warning(disable: 39001) // Deliberate typed view of the StorageBuffer descriptor table in bindless_heap.
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] StructuredBuffer<NwbSwBvhInstance, Std430DataLayout> g_NwbHeapSwBvhInstanceBuffers[];
#pragma warning(pop)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


StructuredBuffer<NwbSwBvhInstance, Std430DataLayout> nwbHeapSwBvhInstances(const uint slot){
    return g_NwbHeapSwBvhInstanceBuffers[slot];
}

float3 nwbSwBvhTransformPoint(const NwbSwBvhInstance instance, const float3 point){
    return float3(dot(instance.worldToObjectRow0.xyz, point) + instance.worldToObjectRow0.w, dot(instance.worldToObjectRow1.xyz, point) + instance.worldToObjectRow1.w, dot(instance.worldToObjectRow2.xyz, point) + instance.worldToObjectRow2.w);
}

// Leave ray directions un-normalized so object-space and world-space ray parameters stay identical.
float3 nwbSwBvhTransformVector(const NwbSwBvhInstance instance, const float3 vector){
    return float3(dot(instance.worldToObjectRow0.xyz, vector), dot(instance.worldToObjectRow1.xyz, vector), dot(instance.worldToObjectRow2.xyz, vector));
}

// Inverse-transpose of object->world, as the transpose of the stored world->object 3x3. Callers choose their own normalization/fallback policy.
float3 nwbSwBvhTransformNormal(const NwbSwBvhInstance instance, const float3 objectNormal){
    return float3(
        dot(float3(instance.worldToObjectRow0.x, instance.worldToObjectRow1.x, instance.worldToObjectRow2.x), objectNormal),
        dot(float3(instance.worldToObjectRow0.y, instance.worldToObjectRow1.y, instance.worldToObjectRow2.y), objectNormal),
        dot(float3(instance.worldToObjectRow0.z, instance.worldToObjectRow1.z, instance.worldToObjectRow2.z), objectNormal)
    );
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

