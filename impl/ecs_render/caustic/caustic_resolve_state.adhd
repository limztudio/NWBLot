#include <impl/ecs_render/caustic/push_constants.adhd>
#include <impl/ecs_render/caustic/pipeline_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const usize s_CausticResolvePassCount = 5u;
const TextureSubresourceSet s_CausticAccumulatorSubresources = TextureSubresourceSet(0u, 1u, 0u, s_CausticAccumulatorChannelCount);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Name CausticResolveActivityBufferName(in u32 index){
    if(index == 0u)
        return s_CausticResolveActivityBufferAName;
    return s_CausticResolveActivityBufferBName;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class CausticResolveActivitySnapshot{
    public Array<BufferHandle, s_CausticResolveActivityBufferCount> buffers;
    public Array<GpuDescriptorHandle, s_CausticResolveActivityBufferCount> descriptors;
    public u32 halfWidth = 0u;
    public u32 halfHeight = 0u;

    public CausticResolveActivitySnapshot(){}

    public b8 valid()const{
        if(this.halfWidth == 0u || this.halfHeight == 0u)
            return false;
        for(u32 index = 0u; index < s_CausticResolveActivityBufferCount; ++index){
            if(!this.buffers[index].valid() || !this.descriptors[index].valid() || this.descriptors[index].descriptorClass() != GpuDescriptorClass::StorageBuffer)
                return false;
        }
        return true;
    }

    public b8 matches(in CausticResolveActivitySnapshot other)const{
        if(this.halfWidth != other.halfWidth || this.halfHeight != other.halfHeight)
            return false;
        for(u32 index = 0u; index < s_CausticResolveActivityBufferCount; ++index){
            if(this.buffers[index] != other.buffers[index] || this.descriptors[index] != other.descriptors[index])
                return false;
        }
        return true;
    }
}

class CausticResolveState{
    public BindingLayoutHandle m_bindingLayout;
    public CausticResolveActivitySnapshot m_activity;
    public CausticResolveStageState m_prepare;
    public CausticResolveStageState m_wavelet;
    public CausticResolveStageState m_waveletStepOne;
    public CausticResolveStageState m_waveletStepTwo;
    public CausticResolveStageState m_waveletDirect;
    public CausticResolveStageState m_upsample;
    public b8 m_failed = false;

    public CausticResolveState(){}
}


