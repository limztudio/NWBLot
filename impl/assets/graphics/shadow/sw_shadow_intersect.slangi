////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_SHADOW_SW_SHADOW_INTERSECT_SLANGI
#define NWB_GRAPHICS_SHADOW_SW_SHADOW_INTERSECT_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#define NWB_SW_SHADOW_AABB_PADDING 1e-4
#define NWB_SW_SHADOW_AABB_MISS 1.0e30

#include "../bvh/ray_intersect.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


bool nwbSwShadowRayAabbFma(const float3 invDir, const float3 minBias, const float3 maxBias, const float tMin, const float tMax, const float3 boxMin, const float3 boxMax){
    float unusedTEntry;
    return nwbBvhRayAabbIntervalPaddedFma(invDir, minBias, maxBias, tMin, tMax, boxMin, boxMax, unusedTEntry);
}

float nwbSwShadowRayAabbEntryTFma(const float3 invDir, const float3 minBias, const float3 maxBias, const float tMin, const float tMax, const float3 boxMin, const float3 boxMax){
    float tEntry;
    return nwbBvhRayAabbIntervalPaddedFma(invDir, minBias, maxBias, tMin, tMax, boxMin, boxMax, tEntry) ? tEntry : NWB_SW_SHADOW_AABB_MISS;
}

float3 nwbSwShadowSafeInvDir(const float3 direction){
    return nwbBvhSafeInvDir(direction);
}

struct NwbSwShadowWoopRay{
    float3 origin;
    int kx;
    int ky;
    int kz;
    float shearX;
    float shearY;
    float shearZ;
};

struct NwbSwShadowTriangleHit{
    bool hit;
    float t;
    float u;
    float v;
    float w;
};

NwbSwShadowWoopRay nwbSwShadowMakeWoopRay(const float3 origin, const float3 direction){
    NwbSwShadowWoopRay ray;
    ray.origin = origin;
    const float3 absDir = abs(direction);
    const int kz = (absDir.x >= absDir.y) ? ((absDir.x >= absDir.z) ? 0 : 2) : ((absDir.y >= absDir.z) ? 1 : 2);
    int kx = (kz + 1 == 3) ? 0 : (kz + 1);
    int ky = (kx + 1 == 3) ? 0 : (kx + 1);
    const float dirKz = direction[kz];
    if(dirKz < 0.0){
        const int swap = kx;
        kx = ky;
        ky = swap;
    }
    ray.kx = kx;
    ray.ky = ky;
    ray.kz = kz;
    ray.shearX = direction[kx] / dirKz;
    ray.shearY = direction[ky] / dirKz;
    ray.shearZ = 1.0 / dirKz;
    return ray;
}

NwbSwShadowTriangleHit nwbSwShadowRayTriangleWoop(const NwbSwShadowWoopRay ray, const float tMin, const float tMax, const float3 v0, const float3 v1, const float3 v2){
    NwbSwShadowTriangleHit result;
    result.hit = false;
    result.t = 0.0;
    result.u = 0.0;
    result.v = 0.0;
    result.w = 0.0;

    const float3 relA = v0 - ray.origin;
    const float3 relB = v1 - ray.origin;
    const float3 relC = v2 - ray.origin;
    const int kx = ray.kx;
    const int ky = ray.ky;
    const int kz = ray.kz;
    const float ax = fma(-ray.shearX, relA[kz], relA[kx]);
    const float ay = fma(-ray.shearY, relA[kz], relA[ky]);
    const float bx = fma(-ray.shearX, relB[kz], relB[kx]);
    const float by = fma(-ray.shearY, relB[kz], relB[ky]);
    const float cx = fma(-ray.shearX, relC[kz], relC[kx]);
    const float cy = fma(-ray.shearY, relC[kz], relC[ky]);

    float u = cx * by - cy * bx;
    float v = ax * cy - ay * cx;
    float w = bx * ay - by * ax;

    if((u < 0.0 || v < 0.0 || w < 0.0) && (u > 0.0 || v > 0.0 || w > 0.0))
        return result;

    const float det = u + v + w;
    if(det == 0.0)
        return result;

    const float az = ray.shearZ * relA[kz];
    const float bz = ray.shearZ * relB[kz];
    const float cz = ray.shearZ * relC[kz];
    const float tScaled = u * az + v * bz + w * cz;
    const float detSign = (det < 0.0) ? -1.0 : 1.0;
    const float absDet = det * detSign;
    const float tSigned = tScaled * detSign;
    if(tSigned <= tMin * absDet || tSigned >= tMax * absDet)
        return result;

    const float invDet = 1.0 / det;
    result.hit = true;
    result.t = tScaled * invDet;
    result.u = v * invDet;
    result.v = w * invDet;
    result.w = u * invDet;
    return result;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

