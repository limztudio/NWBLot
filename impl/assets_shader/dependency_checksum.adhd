////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_shader/shader_source_fingerprint.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsBetterDependencyRootAliasMatch(in b8 hasCurrentBest, in usize candidateDepth, in usize currentBestDepth){
    return !hasCurrentBest || candidateDepth > currentBestDepth;
}

Expected<usize> TryComputeCanonicalAliasedDependencyPathCapacity(
    in usize prefixBytes,
    in usize rootKeyBytes,
    in usize relativePathBytes
){
    usize relativeSegmentBytes = 0u;
    if(relativePathBytes > 0u){
        if(relativePathBytes == usize.max)
            return MakeUnexpected(Failure());
        relativeSegmentBytes = 1u + relativePathBytes;
    }
    if(rootKeyBytes > usize.max - prefixBytes)
        return MakeUnexpected(Failure());
    const usize headerBytes = prefixBytes + rootKeyBytes;
    if(relativeSegmentBytes > usize.max - headerBytes)
        return MakeUnexpected(Failure());
    return headerBytes + relativeSegmentBytes;
}

b8 ValidateNonEmptyDependencyRootAliasList(in usize aliasCount){
    if(aliasCount > 0u)
        return true;

    error("Dependency checksum requires at least one dependency root alias");
    return false;
}

b8 ValidateDependencyRootAliasInputs(in b8 rootEmpty, in StringView key){
    if(!rootEmpty && !key.empty())
        return true;

    error("Dependency checksum requires non-empty dependency root aliases");
    return false;
}

b8 ValidateCanonicalDependencyRootAliasKey(in StringView canonicalKey){
    if(!canonicalKey.empty())
        return true;

    error("Dependency checksum requires non-empty dependency root alias keys");
    return false;
}

Path NormalizeDependencyRootAliasPath(in Path source){
    Path path = source.lexicallyNormal();
    while(!path.empty() && !path.hasFilename()){
        const Path parentPath = path.parentPath();
        if(parentPath.empty() || parentPath == path)
            break;
        path = parentPath;
    }
    return path;
}


class ShaderDependencyRoot{
    public Path root;
    public String key;
    public usize depth = 0u;
}

class ShaderChecksumRoots{
    public Vector<ShaderDependencyRoot> aliases;

    public b8 append(in Path root, in StringView key){
        if(!ValidateDependencyRootAliasInputs(root.empty(), key))
            return false;
        const Expected<Path, ErrorCode> absolute = AbsolutePath(root);
        if(!absolute.has_value()){
            error("Failed to resolve dependency root alias '{}' : {}", root, ErrorCodeMessage(absolute.error()));
            return false;
        }
        AppendArenaElement<ShaderDependencyRoot>(this.aliases);
        mut ShaderDependencyRoot alias = this.aliases[this.aliases.size() - 1u];
        alias.root = NormalizeDependencyRootAliasPath(absolute.value());
        alias.key.assign(key);
        CanonicalizeTextInPlace(alias.key);
        if(!ValidateCanonicalDependencyRootAliasKey(alias.key)){
            this.aliases.pop_back();
            return false;
        }
        alias.depth = PathDepth(alias.root);
        return true;
    }

    public Expected<String> canonicalPath(in Path path, in b8 allowUnaliased)const{
        const Expected<Path, ErrorCode> absolute = AbsolutePath(path);
        if(!absolute.has_value()){
            error("Failed to resolve dependency path '{}' : {}", path, ErrorCodeMessage(absolute.error()));
            return MakeUnexpected(Failure());
        }
        const Path normalized = absolute.value().lexicallyNormal();
        usize best = this.aliases.size();
        usize depth = 0u;
        for(usize index = 0u; index < this.aliases.size(); ++index){
            in ShaderDependencyRoot alias = this.aliases[index];
            if(normalized != alias.root && !PathHasDirectoryAncestor(normalized, alias.root))
                continue;
            if(IsBetterDependencyRootAliasMatch(best < this.aliases.size(), alias.depth, depth)){
                best = index;
                depth = alias.depth;
            }
        }
        String result;
        if(best == this.aliases.size()){
            if(!allowUnaliased){
                error("Dependency checksum path '{}' is outside the declared dependency root aliases", path);
                return MakeUnexpected(Failure());
            }
            const String text = PathToString(normalized);
            result.reserve(AddSize(s_ShaderChecksumAbsolutePrefix.size(), text.size()));
            result.append(s_ShaderChecksumAbsolutePrefix);
            result.append(text);
            return result;
        }
        in ShaderDependencyRoot alias = this.aliases[best];
        const Path relative = normalized.lexicallyRelative(alias.root);
        const String text = PathToString(relative);
        StringView prefix = "";
        if(allowUnaliased)
            prefix = s_ShaderChecksumAliasPrefix;
        const Expected<usize> capacity = TryComputeCanonicalAliasedDependencyPathCapacity(prefix.size(), alias.key.size(), text.size());
        if(!capacity.has_value())
            return MakeUnexpected(Failure());
        result.reserve(capacity.value());
        result.append(prefix);
        result.append(alias.key);
        if(!text.empty()){
            result.push_back('/');
            result.append(text);
        }
        return result;
    }
}

class ShaderChecksumItem{
    public String canonicalPath;
    public Path source;
}

Expected<DependencyChecksum> ComputeShaderDependencyChecksum<Dependencies, Includes>(in Dependencies dependencies, in Includes includes, in ShaderChecksumRoots roots){
    if(!ValidateNonEmptyDependencyRootAliasList(roots.aliases.size()))
        return MakeUnexpected(Failure());
    DependencyChecksum result;
    result.checksum = s_Fnv64OffsetBasis;
    Fnv64AppendValue(result.checksum, s_ShaderDependencyChecksumVersion);
    Fnv64AppendValue(result.checksum, SequenceSize(includes));
    for(in auto includePath : includes){
        const Expected<String> path = roots.canonicalPath(includePath, true);
        if(!path.has_value())
            return MakeUnexpected(Failure());
        result.checksum = UpdateFnv64TextExact(result.checksum, path.value());
    }
    const usize count = SequenceSize(dependencies);
    Fnv64AppendValue(result.checksum, count);
    Vector<ShaderChecksumItem> sorted;
    sorted.reserve(count);
    for(in auto dependency : dependencies){
        const Expected<String> path = roots.canonicalPath(dependency, false);
        if(!path.has_value())
            return MakeUnexpected(Failure());
        AppendArenaElement<ShaderChecksumItem>(sorted);
        mut ShaderChecksumItem item = sorted[sorted.size() - 1u];
        item.source = dependency;
        item.canonicalPath = path.value();
    }
    SortSequence<ShaderChecksumItem>(sorted, lambda[](in ShaderChecksumItem lhs, in ShaderChecksumItem rhs) -> b8{
        return lhs.canonicalPath < rhs.canonicalPath;
    });
    Vector<u8> bytes;
    ShaderSourceFingerprint fingerprint;
    for(in ShaderChecksumItem item : sorted){
        bytes.clear();
        const Expected<void, ErrorCode> read = ReadBinaryFile(item.source, bytes);
        if(!read.has_value()){
            if(read.error().value() != 0)
                error("Failed to read dependency file '{}' : {}", item.source, ErrorCodeMessage(read.error()));
            else
                error("Failed to read dependency file '{}'", item.source);
            return MakeUnexpected(Failure());
        }
        fingerprint.appendDependencyChecksum(item.canonicalPath, bytes, result.checksum, result.compilerInputsHaveBom);
    }
    return result;
}


