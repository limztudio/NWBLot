struct DiscoveredPathCollisionProbe{
    ScratchArena& arena;
    Core::Assets::CookMetadataDetail::DiscoveredPathSet seen;
    ScratchString first;
    ScratchString second;


public:
    explicit DiscoveredPathCollisionProbe(ScratchArena& scratchArena)
        : arena(scratchArena)
        , seen(0, Hasher<AStringView>(), EqualTo<>(), scratchArena)
        , first("a/first.asset.nwb", scratchArena)
        , second(scratchArena)
    {
        seen.reserve(2u);
        const usize bucket = Hasher<AStringView>{}(AStringView(first)) % seen.bucket_count();
        for(u32 i = 0u; i < 1024u; ++i){
            ScratchString candidate = StringFormat(scratchArena, "b/second_{}.asset.nwb", i);
            if(Hasher<AStringView>{}(AStringView(candidate)) % seen.bucket_count() == bucket){
                second = Move(candidate);
                break;
            }
        }
    }

    [[nodiscard]] b8 hasSecond()const noexcept{ return !second.empty(); }
    [[nodiscard]] b8 insertFirst(){ return seen.insert(first).second; }
    [[nodiscard]] b8 insertSecond(){ return seen.insert(second).second; }
    void overwriteFirst(){ first.assign("overwritten"); }
    [[nodiscard]] b8 insertLiteral(const AStringView value){
        ScratchString text(value, arena);
        return seen.insert(text).second;
    }
    [[nodiscard]] usize size()const noexcept{ return seen.size(); }
};

[[nodiscard]] FOUNDATION_INLINE ScratchString MakeScratchStringImpl(const AStringView text, ScratchArena& scratchArena){
    return ScratchString(text, scratchArena);
}

[[nodiscard]] FOUNDATION_INLINE DiscoveredPathCollisionProbe MakeDiscoveredPathCollisionProbeImpl(ScratchArena& scratchArena){
    return DiscoveredPathCollisionProbe(scratchArena);
}

