#include <impl/ecs_render/kernel/graphics_prefix_timing_ticket.adhd>

#include <impl/ecs_render/deferred/deferred_system.adhd>
#include <impl/ecs_render/shadow/light_space_settings.adhd>
#include <impl/ecs_render/shared/frame_push_constants.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SceneShadingSetupGraphTask{
    private mut RendererDeferredSystem m_deferredSystem;
    private in GraphicsPrefixTimingTicket m_timingTicket;
    private mut b8 m_ready;
    private Array<SceneLightGpuData, s_SceneMaxLights> m_lightData;
    private SceneShadingGpuData m_sceneShadingState;
    private u32 m_lightCount;
    private b8 m_lightUploadRequired;
    private b8 m_sceneShadingUploadRequired;

    public SceneShadingSetupGraphTask(mut RendererDeferredSystem deferredSystem, in GraphicsPrefixTimingTicket timingTicket, mut b8 ready, in SceneShadingBufferUploads uploads){
        this.m_deferredSystem = deferredSystem;
        this.m_timingTicket = timingTicket;
        this.m_ready = ready;
        this.m_lightData = uploads.lightData;
        this.m_sceneShadingState = uploads.sceneShadingState;
        this.m_lightCount = uploads.lightCount;
        this.m_lightUploadRequired = uploads.lightUploadRequired;
        this.m_sceneShadingUploadRequired = uploads.sceneShadingUploadRequired;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(); }
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        GpuTimingTicketRecordingScope recording(this.m_timingTicket.value());
        this.m_ready = true;
        return true;
    }
    public void accepted(in QueueSubmissionToken token){
        const Span<SceneLightGpuData> lights = this.m_lightData;
        this.m_deferredSystem.confirmSceneShadingBufferUploads(lights.subspan(0u, this.m_lightCount), this.m_lightUploadRequired, this.m_sceneShadingState, this.m_sceneShadingUploadRequired);
    }
    public void discarded(){ this.m_ready = false; }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

