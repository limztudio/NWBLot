void VerifyUiContextTests_OnlyTheExactPreparedGenerationCanReplaceTheCommittedHitLayout(mut UiContextTests self){
    const Expected<WidgetState> originalResult = self.prepare(7u, MakeUiContextRoot(51u, 1u));
    ASSERT_TRUE(originalResult.has_value());
    const WidgetState original = originalResult.value();
    ASSERT_TRUE(self.m_context.ready());
    EXPECT_EQ(self.m_context.readyGeneration(), 7u);
    EXPECT_FALSE(self.m_context.commitFrame(6u));
    EXPECT_FALSE(self.m_context.commitFrame(8u));
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 0u);
    ASSERT_TRUE(self.m_context.commitFrame(7u));
    EXPECT_FALSE(self.m_context.ready());
    EXPECT_EQ(self.m_context.input().hitTest(MakeUiContextPoint(15.0f, 25.0f)), original.id);
    ASSERT_TRUE(self.m_context.beginFrame(9u));
    ASSERT_TRUE(self.m_context.beginRoot(original.root));
    const Expected<WidgetState> state = self.declareState(s_UiContextActionKey, WidgetKind::Button);
    ASSERT_TRUE(state.has_value());
    ASSERT_TRUE(self.m_context.addTarget(state.value(), MakeUiContextButtonTargetAt(MakeUiContextRect(80.0f, 20.0f, 30.0f, 20.0f))));
    ASSERT_TRUE(self.m_context.endRoot());
    ASSERT_TRUE(self.m_context.finishFrame());
    EXPECT_FALSE(self.m_context.commitFrame(7u));
    EXPECT_FALSE(self.m_context.commitFrame(10u));
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 7u);
    EXPECT_EQ(self.m_context.input().hitTest(MakeUiContextPoint(15.0f, 25.0f)), original.id);
    EXPECT_FALSE(self.m_context.input().hitTest(MakeUiContextPoint(85.0f, 25.0f)).valid());
    ASSERT_TRUE(self.m_context.commitFrame(9u));
    EXPECT_FALSE(self.m_context.input().hitTest(MakeUiContextPoint(15.0f, 25.0f)).valid());
    EXPECT_EQ(self.m_context.input().hitTest(MakeUiContextPoint(85.0f, 25.0f)), original.id);
    EXPECT_FALSE(self.m_context.commitFrame(9u));
    EXPECT_FALSE(self.m_context.beginFrame(9u));
}

void VerifyUiContextTests_PendingPresentationCannotReplayConsumedActionsAndRetainsNewInputExactlyOnce(mut UiContextTests self){
    const Expected<WidgetState> originalResult = self.prepare(1u, MakeUiContextRoot(61u, 1u));
    ASSERT_TRUE(originalResult.has_value());
    const WidgetState original = originalResult.value();
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    EXPECT_TRUE(self.click().pointerConsumed);
    ASSERT_EQ(self.m_context.input().actions().size(), 1u);
    const InputActionId firstAction = self.m_context.input().actions()[0u].id;
    ASSERT_TRUE(firstAction.valid());
    ASSERT_TRUE(self.m_context.beginFrame(2u));
    ASSERT_TRUE(self.m_context.beginRoot(original.root));
    Expected<WidgetState> state = self.declareState(s_UiContextActionKey, WidgetKind::Button);
    ASSERT_TRUE(state.has_value());
    EXPECT_TRUE(self.m_context.takeActivation(state.value(), true));
    EXPECT_FALSE(self.m_context.takeActivation(state.value(), true));
    ASSERT_TRUE(self.m_context.addTarget(state.value(), MakeUiContextButtonTarget()));
    ASSERT_TRUE(self.m_context.endRoot());
    ASSERT_TRUE(self.m_context.finishFrame());
    EXPECT_FALSE(self.m_context.beginFrame(3u));
    EXPECT_FALSE(self.m_context.beginFrame(2u));
    EXPECT_TRUE(self.m_context.input().actions().empty());
    EXPECT_FALSE(self.m_context.input().process().pointerConsumed);
    EXPECT_TRUE(self.click().pointerConsumed);
    ASSERT_EQ(self.m_context.input().actions().size(), 1u);
    EXPECT_GT(self.m_context.input().actions()[0u].id.sequence, firstAction.sequence);
    EXPECT_EQ(self.m_context.input().actions()[0u].id.layoutGeneration, 1u);
    EXPECT_FALSE(self.m_context.input().process().pointerConsumed);
    EXPECT_EQ(self.m_context.input().actions().size(), 1u);
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    ASSERT_TRUE(self.m_context.beginFrame(3u));
    ASSERT_TRUE(self.m_context.beginRoot(original.root));
    state = self.declareState(s_UiContextActionKey, WidgetKind::Button);
    ASSERT_TRUE(state.has_value());
    EXPECT_TRUE(self.m_context.takeActivation(state.value(), true));
    EXPECT_FALSE(self.m_context.takeActivation(state.value(), true));
    ASSERT_TRUE(self.m_context.addTarget(state.value(), MakeUiContextButtonTarget()));
    ASSERT_TRUE(self.m_context.endRoot());
    ASSERT_TRUE(self.m_context.finishFrame());
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    EXPECT_TRUE(self.m_context.input().actions().empty());
}

void VerifyUiContextTests_HiddenRootsRetireCaptureWhileTheHeldPointerSequenceStillOwnsItsRelease(mut UiContextTests self){
    const Expected<WidgetState> originalResult = self.prepare(1u, MakeUiContextRoot(71u, 1u));
    ASSERT_TRUE(originalResult.has_value());
    const WidgetState original = originalResult.value();
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    ASSERT_TRUE(self.queuePointer(InputEventType::PrimaryDown));
    EXPECT_TRUE(self.m_context.input().process().pointerConsumed);
    EXPECT_EQ(self.m_context.input().capture(), original.id);
    EXPECT_TRUE(self.m_context.input().primaryDown());
    ASSERT_TRUE(self.prepare(2u, original.root).has_value());
    ASSERT_TRUE(self.m_context.ready());
    const Vector<WidgetRoot> noRoots = Vector<WidgetRoot>();
    self.m_context.retainRoots(noRoots);
    EXPECT_TRUE(self.m_context.states().entries().empty());
    EXPECT_FALSE(self.m_context.input().capture().valid());
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_TRUE(self.m_context.input().primaryDown());
    EXPECT_TRUE(self.m_context.input().wouldConsumePointer(MakeUiContextPoint(150.0f, 80.0f)));
    EXPECT_FALSE(self.m_context.input().hitTest(MakeUiContextPoint(15.0f, 25.0f)).valid());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_TRUE(self.m_context.input().targets().empty());
    ASSERT_TRUE(self.queuePointer(InputEventType::PrimaryUp));
    EXPECT_TRUE(self.m_context.input().process().pointerConsumed);
    EXPECT_FALSE(self.m_context.input().primaryDown());
    EXPECT_TRUE(self.m_context.input().actions().empty());
    const Expected<WidgetState> recreatedResult = self.prepare(3u, original.root);
    ASSERT_TRUE(recreatedResult.has_value());
    const WidgetState recreated = recreatedResult.value();
    EXPECT_EQ(recreated.id, original.id);
    EXPECT_GT(recreated.declarationGeneration, original.declarationGeneration);
}

void VerifyUiContextTests_ChangingWidgetKindInvalidatesQueuedActivationAndItsTypedLifetime(mut UiContextTests self){
    const Expected<WidgetState> originalResult = self.prepare(1u, MakeUiContextRoot(81u, 1u));
    ASSERT_TRUE(originalResult.has_value());
    const WidgetState original = originalResult.value();
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    EXPECT_TRUE(self.click().pointerConsumed);
    ASSERT_EQ(self.m_context.input().actions().size(), 1u);
    const Expected<WidgetState> changedResult = self.prepare(2u, original.root, WidgetKind::Checkbox);
    ASSERT_TRUE(changedResult.has_value());
    const WidgetState changed = changedResult.value();
    EXPECT_EQ(changed.id, original.id);
    EXPECT_GT(changed.declarationGeneration, original.declarationGeneration);
    EXPECT_EQ(changed.kind, WidgetKind::Checkbox);
    EXPECT_TRUE(self.m_context.input().actions().empty());
    EXPECT_FALSE(self.m_context.input().capture().valid());
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_FALSE(self.m_context.input().hitTest(MakeUiContextPoint(15.0f, 25.0f)).valid());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_TRUE(self.click().pointerConsumed);
    ASSERT_EQ(self.m_context.input().actions().size(), 1u);
    EXPECT_EQ(self.m_context.input().actions()[0u].id.declarationGeneration, changed.declarationGeneration);
    ASSERT_TRUE(self.m_context.beginFrame(3u));
    ASSERT_TRUE(self.m_context.beginRoot(original.root));
    const Expected<WidgetState> current = self.declareState(s_UiContextActionKey, WidgetKind::Checkbox);
    ASSERT_TRUE(current.has_value());
    EXPECT_EQ(current.value().declarationGeneration, changed.declarationGeneration);
    EXPECT_TRUE(self.m_context.takeActivation(current.value(), true));
    EXPECT_FALSE(self.m_context.takeActivation(current.value(), true));
}

void VerifyUiContextTests_RemovedDeclarationsRecreateWithFreshLifetimeEvenWhenTheirStableIdReturns(mut UiContextTests self){
