class AdhdTestArena{ public HeapStorage arena; }

b8 CompileWithResolver(in StringView source, in StringView path, mut MetascriptIIncludeResolver resolver, mut HeapStorage arena, mut CompileResult result){
    CompilerOptions options;
    options.source = source;
    options.virtualFilePath = path;
    SetCompilerResolver(options, resolver);
    return CompileOptionsResult(options, arena, result);
}

StringView GeneratedHeaderView(in CompileResult result){ return StringView(result.generatedHeader); }
StringView GeneratedSourceView(in CompileResult result){ return StringView(result.generatedSource); }
StringView FirstErrorMessage(in CompileResult result){ return StringView(result.errors[0u].message); }
StringView MStringAsView(in GlobalString text){ return StringView(text); }

class MockIncludeResolver : MetascriptIIncludeResolver{
    public u32 resolveCallCount = 0u;
    public b8 resolveInclude(in StringView includePath, in b8 isSystem, mut GlobalAllocator arena, mut GlobalString outResolvedKey, mut GlobalString outContent)override{
        ++this.resolveCallCount;
        outResolvedKey = GlobalString(includePath, arena);
        if(includePath == "shared_service.adhd"){
            const StringView s_ServiceHeader =
                "interface IStore<T> {\r\n    void put(in T value);\r\n}\r\n[reflect]\r\nclass SharedService {\r\n    private i32 m_total = 0;\r\n    public i32 accumulate(in i32 delta);\r\n}\r\n";
            outContent = GlobalString(s_ServiceHeader, arena);
            return true;
        }
        if(includePath == "foreign_bridge.adhd"){
            const StringView s_ForeignBridge =
                "#include \"foreign_defs.adhd\"\r\nconst u32 kSameBridgeConst = 3u;\r\n";
            outContent = GlobalString(s_ForeignBridge, arena);
            return true;
        }
        if(includePath == "foreign_defs.adhd"){
            const StringView s_ForeignDefs =
                "const u32 kForeignCap = 4;\r\nconst u32 kForeignConst = 7u;\r\nconst u32 kForeignOther = 11u;\r\nenum<u8> ForeignMode { Alpha = 1, Beta = 2, kCount }\r\n[serialize]\r\nclass ForeignItem {\r\n    public u32 tag = 1u;\r\n}\r\n[arena, asset(\"mock_foreign\")]\r\nclass ForeignAsset {\r\n    public u32 dummy = 0u;\r\n}\r\nu32 ForeignFn(in u32 x) {\r\n    return x + kForeignOther;\r\n}\r\n";
            outContent = GlobalString(s_ForeignDefs, arena);
            return true;
        }
        if(includePath == "impl/modular_box.adhd"){
            const StringView s_ModularBoxHeader =
                "class RefTarget {\r\n    public u32 value = 0u;\r\n}\r\n[modular]\r\nclass ModularBox : NoCopy {\r\n    private mut RefTarget m_target;\r\n    private Vector<u32> m_items;\r\n    public ModularBox(mut RefTarget target, in u32 seed);\r\n    public u32 read()const;\r\n    public void append(in u32 val);\r\n}\r\n";
            outContent = GlobalString(s_ModularBoxHeader, arena);
            return true;
        }
        const StringView s_HeaderCode = "const u32 kSharedLimit = 16;\r\n";
        outContent = GlobalString(s_HeaderCode, arena);
        return true;
    }
    public StringView resolveIncludeNamespace(in StringView resolvedKey)const override{
        if(resolvedKey == "foreign_defs.adhd")
            return "NWB::MockForeign";
        return StringView();
    }
}

usize UnitClassCount(in CompileResult result){ return result.unit.classes.size(); }
b8 UnitClassIsSerialize(in CompileResult result, in usize classIdx){ return BorrowAstNode(result.unit.classes, classIdx).value().isSerialize; }
usize UnitClassTotalAlign(in CompileResult result, in usize classIdx){ return BorrowAstNode(result.unit.classes, classIdx).value().totalAlign; }
usize UnitClassTotalSize(in CompileResult result, in usize classIdx){ return BorrowAstNode(result.unit.classes, classIdx).value().totalSize; }
StringView UnitClassName(in CompileResult result, in usize classIdx){ return StringView(BorrowAstNode(result.unit.classes, classIdx).value().name); }
usize UnitClassOrderedFieldCount(in CompileResult result, in usize classIdx){ return BorrowAstNode(result.unit.classes, classIdx).value().orderedFields.size(); }
StringView UnitClassOrderedFieldName(in CompileResult result, in usize classIdx, in usize fieldIdx){ return StringView(BorrowAstNode(BorrowAstNode(result.unit.classes, classIdx).value().orderedFields, fieldIdx).value().name); }
usize UnitClassOrderedFieldAlign(in CompileResult result, in usize classIdx, in usize fieldIdx){ return BorrowAstNode(BorrowAstNode(result.unit.classes, classIdx).value().orderedFields, fieldIdx).value().resolvedAlign; }
usize UnitClassOrderedFieldOffset(in CompileResult result, in usize classIdx, in usize fieldIdx){ return BorrowAstNode(BorrowAstNode(result.unit.classes, classIdx).value().orderedFields, fieldIdx).value().resolvedOffset; }
usize UnitTemplateInstCount(in CompileResult result){ return result.unit.templateInstantiations.size(); }
usize UnitTemplateInstOrderedFieldCount(in CompileResult result, in usize instIdx){ return BorrowAstNode(result.unit.templateInstantiations, instIdx).value().orderedFields.size(); }
StringView UnitTemplateInstOrderedFieldName(in CompileResult result, in usize instIdx, in usize fieldIdx){ return StringView(BorrowAstNode(BorrowAstNode(result.unit.templateInstantiations, instIdx).value().orderedFields, fieldIdx).value().name); }
usize UnitIncludedAdhdFileCount(in CompileResult result){ return result.unit.includedAdhdFiles.size(); }
StringView UnitIncludedAdhdFileView(in CompileResult result, in usize idx){ return StringView(result.unit.includedAdhdFiles[idx]); }
usize UnitResolvedIncludedFileCount(in CompileResult result){ return result.unit.resolvedIncludedFiles.size(); }
StringView UnitResolvedIncludedFileView(in CompileResult result, in usize idx){ return StringView(result.unit.resolvedIncludedFiles[idx]); }

