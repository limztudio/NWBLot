void VerifyNoexceptFailureTests_OwnerObservationUsesImplicitCopyAndPreservesBorrowedTargetsOnFailure(){
    native{
        using namespace __hidden_pointer_failure_tests;
        static_assert(noexcept(ObservationPointer(DeclVal<const ObservationPointer&>())));
        static_assert(!noexcept(DeclVal<void(*)(ObservationPointer)noexcept>()(DeclVal<const ObservationPointer&>())));
        RefCountTarget target;
        UniquePtr<RefCountTarget, ObservationDeleter> unique(ObservationPointer{ &target });
        RefCountPtr<RefCountTarget, ObservationDeleter> shared(ObservationPointer{ &target }, s_AdoptRef);
        ScopeExit disarm([]()noexcept{ ObservationPointer::s_FailCopy = false; });
        static_assert(!noexcept(unique.get()));
        static_assert(!noexcept(unique.operator->()));
        static_assert(!noexcept(shared.get()));
        static_assert(!noexcept(shared.operator->()));
        ObservationPointer::s_FailCopy = true;
        EXPECT_THROW(EXPECT_EQ(unique.get().target, &target), u32);
        EXPECT_THROW(EXPECT_EQ(unique.operator->().target, &target), u32);
        EXPECT_THROW(EXPECT_EQ(shared.get().target, &target), u32);
        EXPECT_THROW(EXPECT_EQ(shared.operator->().target, &target), u32);
        ObservationPointer::s_FailCopy = false;
        EXPECT_EQ(unique.get().target, &target);
        EXPECT_EQ(shared.get().target, &target);
    }
}

void VerifyNoexceptFailureTests_HexAppendCapacityAndOutputFailuresPreservePublishedCharacters(){
    CompactString fixed = CompactString();
    AppendHexU32(0u, fixed);
    fixed.clear();
    native{
        using namespace __hidden_hex_failure_tests;
        ACompactString compactFixed;
        static_assert(noexcept(AppendHexU32(u32{}, compactFixed)));
        static_assert(noexcept(AppendHexU64(u64{}, compactFixed)));
        static_assert(noexcept(AppendHexU32UnsignedLiteral(u32{}, compactFixed)));

        ThrowingHexCapacityString capacity;
        static_assert(!noexcept(AppendHexU64(u64{}, capacity)));
        EXPECT_THROW(AppendHexU64(1u, capacity), u32);
        EXPECT_TRUE(capacity.text.empty());

        ThrowingHexAppendString output;
        static_assert(!noexcept(AppendHexU64(u64{}, output)));
        EXPECT_THROW(AppendHexU64(0xabcdef0123456789u, output), u32);
        EXPECT_EQ(output.text.view(), AStringView("ab"));
        output.text.clear();
        static_assert(!noexcept(AppendHexU32UnsignedLiteral(u32{}, output)));
        EXPECT_THROW(AppendHexU32UnsignedLiteral(0x89abcdefu, output), u32);
        EXPECT_EQ(output.text.view(), AStringView("0x"));
    }
}

void VerifyNoexceptFailureTests_FixedVectorRemovalSupportsCopyOnlyAndEmptyZeroCapacity(){
    u32 live = 0u;
    native(mut live){
        using namespace __hidden_fixed_vector_failure_tests;
        FixedVector<FixedVectorCopyOnly, 2u> stored;
        FixedVectorCopyOnly value(live);
        stored.push_back(value);
        EXPECT_EQ(live, 2u);
        stored.pop_back();
        EXPECT_EQ(live, 1u);
        stored.push_back(value);
        stored.clear();
        EXPECT_TRUE(stored.empty());
        EXPECT_EQ(live, 1u);
        FixedVector<FixedVectorNoDefault, 0u> empty;
        static_assert(noexcept(empty.clear()));
        empty.clear();
        EXPECT_TRUE(empty.empty());
        FixedVector<FixedVectorNonAssignable, 1u> nonAssignable;
        static_assert(noexcept(nonAssignable.clear()));
        nonAssignable.clear();
        EXPECT_TRUE(nonAssignable.empty());
    }
    EXPECT_EQ(live, 0u);
}

void VerifyNoexceptFailureTests_FixedVectorRemovalReleasesResourcesAndRetainsSizeOnResetFailure(){
    u32 live = 0u;
    b8 firstFails = false;
    b8 secondFails = false;
    native(mut live, mut firstFails, mut secondFails){
        using namespace __hidden_fixed_vector_failure_tests;
        FixedVector<FixedVectorResource, 3u> stored;
        static_assert(!noexcept(stored.clear()));
        stored.emplace_back(live, firstFails);
        stored.emplace_back(live, secondFails);
        ASSERT_EQ(live, 2u);
        stored.pop_back();
        EXPECT_EQ(live, 1u);
        stored.emplace_back(live, secondFails);
        secondFails = true;
        EXPECT_THROW(stored.pop_back(), u32);
        EXPECT_EQ(stored.size(), 2u);
        EXPECT_EQ(live, 2u);
        secondFails = false;
        firstFails = true;
        EXPECT_THROW(stored.clear(), u32);
        EXPECT_EQ(stored.size(), 1u);
        EXPECT_EQ(live, 1u);
        firstFails = false;
        stored.clear();
        EXPECT_TRUE(stored.empty());
    }
    EXPECT_EQ(live, 0u);
}

void VerifyNoexceptFailureTests_FixedVectorElementAssignmentFailurePropagatesWithoutPublishingFullSize(){
    native{
        using namespace __hidden_fixed_vector_failure_tests;
        FixedVector<ThrowingFixedVectorAssignment, 4u> stored;
        stored.resize(1u);
        stored[0u].value = 17u;
        ThrowingFixedVectorAssignment replacement;
        replacement.value = 29u;
        static_assert(!noexcept(stored.fill(replacement)));
        EXPECT_THROW(stored.fill(replacement), u32);
        EXPECT_EQ(stored.size(), 1u);
        EXPECT_EQ(stored[0u].value, 17u);
    }
}

void VerifyNoexceptFailureTests_FixedVectorElementSwapFailurePropagatesWithoutSwappingSizes(){
    native{
        using namespace __hidden_fixed_vector_failure_tests;
        FixedVector<ThrowingFixedVectorSwap, 4u> first;
        FixedVector<ThrowingFixedVectorSwap, 4u> second;
        first.resize(1u);
        second.resize(2u);
        first[0u].value = 17u;
        second[0u].value = 29u;
        static_assert(!noexcept(first.swap(second)));
        EXPECT_THROW(first.swap(second), u32);
        EXPECT_EQ(first.size(), 1u);
        EXPECT_EQ(second.size(), 2u);
        EXPECT_EQ(first[0u].value, 17u);
        EXPECT_EQ(second[0u].value, 29u);
    }
}

