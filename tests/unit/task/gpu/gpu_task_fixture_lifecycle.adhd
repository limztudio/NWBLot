const GpuTaskId s_CommandIrTask = GpuTaskId(17u, 4u);
const GpuSubmissionPacketId s_CommandIrPacket = GpuSubmissionPacketId(19u, 2u);
[cpp_header("<tests/unit/task/gpu/fixture_callback_access.h>"), cpp_name("::NWB::Tests::TaskGraphTestUtils::ClearCallbackInvocation")]
extern void ClearCallbackInvocation<T>(mut T callback);

const GpuPhysicalQueueId s_CommandIrQueue = GpuPhysicalQueueId(1u, 3u);
const GpuGraphResourceId s_CommandIrSource = GpuGraphResourceId(17u, 5u);
const GpuGraphResourceId s_CommandIrDestination = GpuGraphResourceId(17u, 6u);

const usize s_CommandIrCopyBufferOffset = size_of<GpuCommandIrStreamHeader>();
const usize s_CommandIrCopyTextureOffset = s_CommandIrCopyBufferOffset + size_of<GpuCommandIrCopyBufferRecord>();
const usize s_CommandIrClearBufferOffset = s_CommandIrCopyTextureOffset + size_of<GpuCommandIrCopyTextureRecord>();
const usize s_CommandIrClearTextureOffset = s_CommandIrClearBufferOffset + size_of<GpuCommandIrClearBufferRecord>();

BinaryByteView MakeBinaryByteView(in Span<u8> bytes){ return BinaryViewFromBytes(bytes); }
BinaryByteView MakeGraphicsByteView(in GraphicsBytes bytes){ return BinaryViewFromBytes(Span<u8>(bytes)); }
BinaryByteView MakeNullBinaryByteView(in usize size){
    BinaryByteView missing;
    missing.byteCount = size;
    return missing;
}

BinaryByteView SubBinaryByteView(in BinaryByteView source, in usize offset, in usize count){
    return BinaryViewFromBytes(source.span().subspan(offset, count));
}

Span<u8> ByteViewSpan(in BinaryByteView source){
    if(source.hasData())
        return source.span();
    return Span<u8>();
}

Optional<PodT> ReadCommandIrPodAt<PodT>(in BinaryByteView bytes, in usize offset){
    usize cursor = offset;
    const auto parsed = ReadPOD<PodT>(bytes, cursor);
    if(parsed.has_value())
        return parsed.value();
    return Optional<PodT>();
}

void WriteCommandIrWord<T>(in usize offset, in T value, mut Span<u8> bytes){
    if(!OverwritePOD<T>(offset, value, bytes))
        assert(false, "Command IR word exceeds the test buffer");
}

class RecordProbeTask{
    private mut u32 m_records;
    public RecordProbeTask(mut u32 records){ this.m_records = records; }
    public GpuTaskCommandRequirements commandRequirements()const{
        GpuTaskCommandRequirements requirements;
        requirements.requiredCapabilities = GpuQueueCapability::Graphics;
        return requirements;
    }
    public b8 record(mut CommandList commands, in GpuTaskRecordContext context)const{
        ++this.m_records;
        return true;
    }
}

class PacketLifecycleTask{
    public GpuQueueCapability requiredCapabilities = GpuQueueCapability::None;
    public Optional<mut u32> acceptedCount;
    public Optional<mut u32> discardedCount;

    public GpuTaskCommandRequirements commandRequirements()const{
        GpuTaskCommandRequirements requirements;
        requirements.requiredCapabilities = this.requiredCapabilities;
        return requirements;
    }
    public void accepted(in QueueSubmissionToken token){
        if(this.acceptedCount.has_value()){
            mut u32 count = this.acceptedCount.value();
            ++count;
        }
    }
    public void discarded(){
        if(this.discardedCount.has_value()){
            mut u32 count = this.discardedCount.value();
            ++count;
        }
    }
}

class MalformedLifecycleTask{
    private mut u32 m_records;
    private mut u32 m_accepts;
    private mut u32 m_discards;
    public MalformedLifecycleTask(mut u32 records, mut u32 accepts, mut u32 discards){
        this.m_records = records;
        this.m_accepts = accepts;
        this.m_discards = discards;
    }
    public i32 record(mut CommandList commands, in GpuTaskRecordContext context)const{
        ++this.m_records;
        return 1;
    }
    public b8 accepted(in QueueSubmissionToken token){
        ++this.m_accepts;
        return true;
    }
    public void discarded()const{ ++this.m_discards; }
}

Expected<GpuTaskId> AddNativeRecordProbeTask(mut GpuTaskGraph graph, in GpuTaskDesc desc, mut u32 records){
    RecordProbeTask payload(records);
    return graph.addPayloadTask(desc, payload);
}
Expected<GpuTaskId> AddPacketLifecycleTask(mut GpuTaskGraph graph, in GpuTaskDesc desc, in GpuQueueCapability requiredCapabilities){
    PacketLifecycleTask payload;
    payload.requiredCapabilities = requiredCapabilities;
    return graph.addPayloadTask(desc, payload);
}
Expected<GpuTaskId> AddPacketLifecycleTask(mut GpuTaskGraph graph, in GpuTaskDesc desc, mut u32 accepts, mut u32 discards){
    PacketLifecycleTask payload;
    payload.acceptedCount = Optional<mut u32>(accepts);
    payload.discardedCount = Optional<mut u32>(discards);
    return graph.addPayloadTask(desc, payload);
}
Expected<GpuTaskId> AddMalformedLifecycleTask(mut GpuTaskGraph graph, in GpuTaskDesc desc, mut u32 records, mut u32 accepts, mut u32 discards){
    MalformedLifecycleTask payload(records, accepts, discards);
    return graph.addPayloadTask(desc, payload);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void CopyCommandIrBytes(in BinaryByteView source, mut GraphicsBytes outBytes){
    const Span<u8> bytes = ByteViewSpan(source);
    outBytes.resize(bytes.size());
    for(usize i = 0u; i < bytes.size(); ++i)
        outBytes[i] = bytes[i];
}

b8 BinaryByteViewsEqual(in BinaryByteView lhs, in BinaryByteView rhs){
    if(lhs.size() != rhs.size())
        return false;
    return BytesMatch(ByteViewSpan(lhs), ByteViewSpan(rhs));
}

b8 CaptureAllBuiltinCommandIrRecords(mut GpuCommandIrCapture capture, in GpuTaskId task, in GpuSubmissionPacketId packet, in GpuPhysicalQueueId queue, in GpuGraphResourceId source, in GpuGraphResourceId destination){
    TextureSlice sourceSlice = TextureSlice();
    sourceSlice.setOrigin(1u, 2u, 3u);
    sourceSlice.setSize(4u, 5u, 6u);
    sourceSlice.setMipLevel(7u);
    sourceSlice.setArraySlice(8u);
    TextureSlice destinationSlice = TextureSlice();
    destinationSlice.setOrigin(9u, 10u, 11u);
    destinationSlice.setSize(12u, 13u, 14u);
    destinationSlice.setMipLevel(15u);
    destinationSlice.setArraySlice(16u);
    GpuClearTextureTaskDesc clearTexture = GpuClearTextureTaskDesc();
    clearTexture.destination = destination;
    clearTexture.subresources = TextureSubresourceSet(2u, 3u, 4u, 5u);
    clearTexture.valueType = GpuClearTextureTaskValueType::DepthStencil;
    clearTexture.floatValue = Color(0.25f, 0.5f, 0.75f, 1.0f);
    clearTexture.uintValue = UIntColor(2u, 3u, 5u, 7u);
    clearTexture.intValue = IntColor(-2, -3, -5, -7);
    clearTexture.depthValue = 0.125f;
    clearTexture.stencilValue = 19u;
    clearTexture.clearDepth = true;
    clearTexture.clearStencil = true;

    return capture.captureCopyBuffer(task, packet, queue, source, 16u, destination, 32u, 64u)
        && capture.captureCopyTexture(task, packet, queue, source, sourceSlice, destination, destinationSlice)
        && capture.captureClearBuffer(task, packet, queue, destination, 0xdecafbadu)
        && capture.captureClearTexture(task, packet, queue, destination, clearTexture);
}

b8 CaptureAllBuiltinCommandIrRecords(mut GpuCommandIrCapture capture){
    return CaptureAllBuiltinCommandIrRecords(capture, s_CommandIrTask, s_CommandIrPacket, s_CommandIrQueue, s_CommandIrSource, s_CommandIrDestination);
}


