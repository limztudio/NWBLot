////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_PHYSICS_BROADPHASE_HELPERS_SLANGI
#define NWB_PHYSICS_BROADPHASE_HELPERS_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "physics_common.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


bool nwbPhysicsShouldCollideFields(const uint4 metaA, const uint4 filterA, const uint4 metaB, const uint4 filterB){
    const uint bodyIdxA = metaA.x;
    const uint bodyIdxB = metaB.x;
    if(bodyIdxA == bodyIdxB)
        return false;

    const uint flagsUnion = metaA.w | metaB.w;
    const bool anyAwake = (flagsUnion & NWB_PHYSICS_SHAPE_FLAG_AWAKE_BODY) != 0u;
    if(!anyAwake)
        return false;

    const bool anyDynamic = (flagsUnion & NWB_PHYSICS_SHAPE_FLAG_DYNAMIC_BODY) != 0u;
    const bool anySensor = (flagsUnion & NWB_PHYSICS_SHAPE_FLAG_SENSOR) != 0u;
    const bool anyKinematic = (flagsUnion & NWB_PHYSICS_SHAPE_FLAG_KINEMATIC_BODY) != 0u;
    if(!anyDynamic && !(anySensor && anyKinematic))
        return false;

    const int groupA = asint(filterA.z);
    const int groupB = asint(filterB.z);
    if(groupA == groupB && groupA != 0)
        return groupA > 0;

    return ((filterA.x & filterB.y) != 0u) && ((filterB.x & filterA.y) != 0u);
}

uint nwbPhysicsBroadphasePairBucket(const uint4 metaA, const uint4 metaB){
    const uint typeA = metaA.y;
    const uint typeB = metaB.y;
    const bool hasH = (typeA == NWB_PHYSICS_SHAPE_TYPE_HEIGHTFIELD || typeB == NWB_PHYSICS_SHAPE_TYPE_HEIGHTFIELD);
    const bool hasM = (typeA == NWB_PHYSICS_SHAPE_TYPE_MESH || typeB == NWB_PHYSICS_SHAPE_TYPE_MESH);
    const bool bothM = (typeA == NWB_PHYSICS_SHAPE_TYPE_MESH && typeB == NWB_PHYSICS_SHAPE_TYPE_MESH);
    if(hasH || bothM)
        return 3u;
    if(hasM)
        return 2u;
    const bool isBoxA = (typeA == NWB_PHYSICS_SHAPE_TYPE_HULL) && ((metaA.w & NWB_PHYSICS_SHAPE_FLAG_IS_BOX) != 0u);
    const bool isBoxB = (typeB == NWB_PHYSICS_SHAPE_TYPE_HULL) && ((metaB.w & NWB_PHYSICS_SHAPE_FLAG_IS_BOX) != 0u);
    const bool isCpx = (typeA >= NWB_PHYSICS_SHAPE_TYPE_CYLINDER)
        || (typeB >= NWB_PHYSICS_SHAPE_TYPE_CYLINDER)
        || (typeA == NWB_PHYSICS_SHAPE_TYPE_HULL && !isBoxA)
        || (typeB == NWB_PHYSICS_SHAPE_TYPE_HULL && !isBoxB);
    return isCpx ? 1u : 0u;
}

void nwbPhysicsEmitBroadphasePair(
    const uint pairSlot,
    const uint surfacePairSlot,
    const uint counterSlot,
    const uint maxPairs,
    const uint idxA,
    const uint idxB,
    const uint bodyA,
    const uint bodyB,
    const uint bucket
){
    const uint off0 = WavePrefixCountBits(bucket == 0u);
    const uint cnt0 = WaveActiveCountBits(bucket == 0u);
    const uint off1 = WavePrefixCountBits(bucket == 1u);
    const uint cnt1 = WaveActiveCountBits(bucket == 1u);
    const uint off2 = WavePrefixCountBits(bucket == 2u);
    const uint cnt2 = WaveActiveCountBits(bucket == 2u);
    const uint off3 = WavePrefixCountBits(bucket == 3u);
    const uint cnt3 = WaveActiveCountBits(bucket == 3u);
    uint base0 = 0u;
    uint base1 = 0u;
    uint base2 = 0u;
    uint base3 = 0u;
    if(WaveIsFirstLane()){
        if(cnt0 > 0u)
            InterlockedAdd(g_NwbPhysicsUintBuffers[counterSlot][0u], cnt0, base0);
        if(cnt1 > 0u)
            InterlockedAdd(g_NwbPhysicsUintBuffers[counterSlot][1u], cnt1, base1);
        if(cnt2 > 0u)
            InterlockedAdd(g_NwbPhysicsUintBuffers[counterSlot][5u], cnt2, base2);
        if(cnt3 > 0u)
            InterlockedAdd(g_NwbPhysicsUintBuffers[counterSlot][6u], cnt3, base3);
    }
    base0 = WaveReadLaneFirst(base0);
    base1 = WaveReadLaneFirst(base1);
    base2 = WaveReadLaneFirst(base2);
    base3 = WaveReadLaneFirst(base3);
    const uint writeIndex = (bucket == 0u)
        ? (base0 + off0)
        : ((bucket == 1u) ? (base1 + off1) : ((bucket == 2u) ? (base2 + off2) : (base3 + off3)));
    if(writeIndex < maxPairs){
        NwbPhysicsGpuBroadphasePair pairOut;
        pairOut.indices = uint4(idxA, idxB, bodyA, bodyB);
        const bool isBackward = (bucket == 1u) || (bucket == 3u);
        const uint dstSlot = (bucket >= 2u && surfacePairSlot != NWB_PHYSICS_INVALID_INDEX) ? surfacePairSlot : pairSlot;
        const uint dstIdx = isBackward ? (maxPairs - 1u - writeIndex) : writeIndex;
        g_NwbPhysicsBroadphasePairBuffers[dstSlot][dstIdx] = pairOut;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////



#endif


