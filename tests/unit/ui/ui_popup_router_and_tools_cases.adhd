    for(const DrawCommand& command : snapshot.commands())
        EXPECT_EQ(command.layer, 0u);
}

TEST_F(UiPopupToolsBuilderTests, TooltipInsideAPlainPopupPaintsAfterItsOverlayWithoutAddingAnInputScope){
