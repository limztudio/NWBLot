#include <utilities/fbx_to_nwb/text_write.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
String FormatMeshRefreshList<Value>(in Span<Value> values, in usize bytesPerRow){
    String out;
    out.reserve(16u + values.size() * bytesPerRow);
    out.append(s_ListOpenText);
    AppendMeshRows<Value>(values, "", out);
    out.append(s_ListCloseText);
    return out;
}

[cpp_unwind]
String FormatMeshRefreshIndexList(in Span<u32> indices){
    String out;
    out.reserve(16u + indices.size() * 10u);
    out.append(s_ListOpenText);
    AppendMeshTriangleRows(indices, "", out);
    out.append(s_ListCloseText);
    return out;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

