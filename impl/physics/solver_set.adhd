////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ShouldCollideFilters(in Filter filterA, in Filter filterB){
    if(filterA.groupIndex == filterB.groupIndex && filterA.groupIndex != 0)
        return filterA.groupIndex > 0;
    return ((filterA.categoryBits & filterB.maskBits) != 0u) && ((filterB.categoryBits & filterA.maskBits) != 0u);
}

void ComputeShapeLocalAabbValues(
    in Shape shape,
    in Vector<HullShape> hullShapes,
    in Vector<MeshShape> meshShapes,
    mut VectorSingle outMin,
    mut VectorSingle outMax
){
    if(shape.type == ShapeType::Sphere){
        ComputeSphereAabbValues(shape.sphereShape(), VectorSingle(0.0f), QuaternionIdentity(), outMin, outMax);
        return;
    }
    if(shape.type == ShapeType::Capsule){
        ComputeCapsuleAabbValues(shape.capsuleShape(), VectorSingle(0.0f), QuaternionIdentity(), outMin, outMax);
        return;
    }
    if(shape.type == ShapeType::Mesh){
        if(shape.geometryIndex < meshShapes.size()){
            in MeshShape mesh = meshShapes[shape.geometryIndex];
            outMin = VectorSingle(mesh.localAabbMinRadius, 0.0f);
            outMax = VectorSingle(mesh.localAabbMaxMeta, 0.0f);
            return;
        }
        outMin = VectorSingle(0.0f);
        outMax = VectorSingle(0.0f);
        return;
    }
    if(shape.geometryIndex < hullShapes.size()){
        ComputeHullAabbValues(hullShapes[shape.geometryIndex], VectorSingle(0.0f), QuaternionIdentity(), outMin, outMax);
        return;
    }
    outMin = VectorSingle(0.0f);
    outMax = VectorSingle(0.0f);
}

void ComputeShapeLocalAabbCachedValues(
    in Shape shape,
    in Vector<HullShape> hullShapes,
    in Vector<Aabb3D> hullLocalAabbs,
    in Vector<MeshShape> meshShapes,
    mut VectorSingle outMin,
    mut VectorSingle outMax
){
    if(shape.type == ShapeType::Hull && shape.geometryIndex < hullLocalAabbs.size()){
        in Aabb3D cached = hullLocalAabbs[shape.geometryIndex];
        outMin = VectorSingle(cached.lowerBound);
        outMax = VectorSingle(cached.upperBound);
        return;
    }
    ComputeShapeLocalAabbValues(shape, hullShapes, meshShapes, outMin, outMax);
}

void ComputeShapeWorldAabbValues(
    in Shape shape,
    in VectorSingle xfPos,
    in VectorSingle xfRot,
    in Vector<HullShape> hullShapes,
    in Vector<MeshShape> meshShapes,
    mut VectorSingle outMin,
    mut VectorSingle outMax
){
    if(shape.type == ShapeType::Sphere){
        ComputeSphereAabbValues(shape.sphereShape(), xfPos, xfRot, outMin, outMax);
        return;
    }
    if(shape.type == ShapeType::Capsule){
        ComputeCapsuleAabbValues(shape.capsuleShape(), xfPos, xfRot, outMin, outMax);
        return;
    }
    if(shape.type == ShapeType::Mesh){
        if(shape.geometryIndex < meshShapes.size()){
            ComputeMeshAabbValues(meshShapes[shape.geometryIndex], xfPos, xfRot, outMin, outMax);
            return;
        }
        outMin = VectorSingle(0.0f);
        outMax = VectorSingle(0.0f);
        return;
    }
    if(shape.geometryIndex < hullShapes.size()){
        ComputeHullAabbValues(hullShapes[shape.geometryIndex], xfPos, xfRot, outMin, outMax);
        return;
    }
    outMin = VectorSingle(0.0f);
    outMax = VectorSingle(0.0f);
}

ShapeProxy MakeShapeProxyFromShape(in Shape shape, in Vector<HullShape> hullShapes, in Vector<MeshShape> meshShapes){
    if(shape.type == ShapeType::Sphere)
        return MakeSphereProxy(shape.sphereShape());
    if(shape.type == ShapeType::Capsule)
        return MakeCapsuleProxy(shape.capsuleShape());
    if(shape.type == ShapeType::Mesh){
        if(shape.geometryIndex < meshShapes.size())
            return ShapeProxy();
        return ShapeProxy();
    }
    if(shape.geometryIndex < hullShapes.size())
        return MakeHullProxy(hullShapes[shape.geometryIndex]);
    return ShapeProxy();
}

Manifold CollideShapePair(
    in Shape shapeA,
    in VectorSingle posA,
    in VectorSingle rotA,
    in Shape shapeB,
    in VectorSingle posB,
    in VectorSingle rotB,
    in f32 maxDistance,
    in Vector<HullShape> hullShapes,
    in Vector<MeshShape> meshShapes
){
    if(shapeA.type == ShapeType::Sphere){
        const SphereShape sphA = shapeA.sphereShape();
        if(shapeB.type == ShapeType::Sphere)
            return CollideSpheres(sphA, posA, rotA, shapeB.sphereShape(), posB, rotB, maxDistance);
        if(shapeB.type == ShapeType::Capsule)
            return CollideSphereAndCapsule(sphA, posA, rotA, shapeB.capsuleShape(), posB, rotB, maxDistance);
        if(shapeB.type == ShapeType::Mesh){
            if(shapeB.geometryIndex < meshShapes.size())
                return CollideSphereAndMesh(sphA, posA, rotA, meshShapes[shapeB.geometryIndex], posB, rotB, maxDistance);
            return Manifold();
        }
        if(shapeB.geometryIndex < hullShapes.size())
            return CollideSphereAndHull(sphA, posA, rotA, hullShapes[shapeB.geometryIndex], posB, rotB, maxDistance);
        return Manifold();
    }
    if(shapeA.type == ShapeType::Capsule){
        const CapsuleShape capA = shapeA.capsuleShape();
        if(shapeB.type == ShapeType::Sphere)
            return FlipManifoldNormalAndAnchors(CollideSphereAndCapsule(shapeB.sphereShape(), posB, rotB, capA, posA, rotA, maxDistance));
        if(shapeB.type == ShapeType::Capsule)
            return CollideCapsules(capA, posA, rotA, shapeB.capsuleShape(), posB, rotB, maxDistance);
        if(shapeB.type == ShapeType::Mesh){
            if(shapeB.geometryIndex < meshShapes.size())
                return CollideCapsuleAndMesh(capA, posA, rotA, meshShapes[shapeB.geometryIndex], posB, rotB, maxDistance);
            return Manifold();
        }
        if(shapeB.geometryIndex < hullShapes.size())
            return CollideCapsuleAndHull(capA, posA, rotA, hullShapes[shapeB.geometryIndex], posB, rotB, maxDistance);
        return Manifold();
    }
    if(shapeA.type == ShapeType::Mesh){
        if(shapeA.geometryIndex >= meshShapes.size())
            return Manifold();
        in MeshShape meshA = meshShapes[shapeA.geometryIndex];
        if(shapeB.type == ShapeType::Sphere)
            return FlipManifoldNormalAndAnchors(CollideSphereAndMesh(shapeB.sphereShape(), posB, rotB, meshA, posA, rotA, maxDistance));
        if(shapeB.type == ShapeType::Capsule)
            return FlipManifoldNormalAndAnchors(CollideCapsuleAndMesh(shapeB.capsuleShape(), posB, rotB, meshA, posA, rotA, maxDistance));
        if(shapeB.type == ShapeType::Hull){
            if(shapeB.geometryIndex < hullShapes.size())
                return FlipManifoldNormalAndAnchors(CollideHullAndMesh(hullShapes[shapeB.geometryIndex], posB, rotB, meshA, posA, rotA, maxDistance));
            return Manifold();
        }
        if(shapeB.geometryIndex < meshShapes.size())
            return CollideMeshes(meshA, posA, rotA, meshShapes[shapeB.geometryIndex], posB, rotB, maxDistance);
        return Manifold();
    }
    if(shapeA.geometryIndex >= hullShapes.size())
        return Manifold();
    in HullShape hullA = hullShapes[shapeA.geometryIndex];
    if(shapeB.type == ShapeType::Sphere)
        return FlipManifoldNormalAndAnchors(CollideSphereAndHull(shapeB.sphereShape(), posB, rotB, hullA, posA, rotA, maxDistance));
    if(shapeB.type == ShapeType::Capsule)
        return FlipManifoldNormalAndAnchors(CollideCapsuleAndHull(shapeB.capsuleShape(), posB, rotB, hullA, posA, rotA, maxDistance));
    if(shapeB.type == ShapeType::Mesh){
        if(shapeB.geometryIndex < meshShapes.size())
            return CollideHullAndMesh(hullA, posA, rotA, meshShapes[shapeB.geometryIndex], posB, rotB, maxDistance);
        return Manifold();
    }
    if(shapeB.geometryIndex < hullShapes.size())
        return CollideHulls(hullA, posA, rotA, hullShapes[shapeB.geometryIndex], posB, rotB, maxDistance);
    return Manifold();
}

f32 CombineMaterialFriction(in f32 a, in f32 b){
    const VectorSingle pair(a, b, 0.0f, 0.0f);
    const VectorSingle clamped = VectorSelect(VectorZero(), pair, VectorGreater(pair, VectorZero()));
    return Sqrt(VectorSingle(clamped.x * clamped.y)).x;
}

f32 CombineMaterialRestitution(in f32 a, in f32 b){
    return SimdMax(a, b);
}

f32 CombineMaterialRollingResistance(in f32 a, in f32 b){
    return SimdMax(a, b);
}

u32 EncodeContactKey(in u32 contactId, in u32 edgeIndex){
    return (contactId << 1u) | (edgeIndex & 1u);
}

u32 DecodeContactKeyId(in u32 key){
    return key >> 1u;
}

u32 DecodeContactKeyEdge(in u32 key){
    return key & 1u;
}

u32 EncodeJointKey(in u32 jointId, in u32 edgeIndex){
    return (jointId << 1u) | (edgeIndex & 1u);
}

u32 DecodeJointKeyId(in u32 key){
    return key >> 1u;
}

u32 DecodeJointKeyEdge(in u32 key){
    return key & 1u;
}

void AddBodyToSolverSet(mut Vector<Body> bodies, mut SolverSet set, in BodySim sim, in BodyState state){
    const u32 localIdx = cast<u32>(set.sims.size());
    set.sims.push_back(sim);
    set.states.push_back(state);
    bodies[sim.bodyId].setIndex = set.setIndex;
    bodies[sim.bodyId].localIndex = localIdx;
    ++set.membershipVersion;
}

void RemoveBodyFromSolverSet(mut Vector<Body> bodies, mut SolverSet set, in u32 localIndex){
    if(localIndex >= set.sims.size())
        return;

    const u32 lastIdx = cast<u32>(set.sims.size() - 1u);
    const u32 removedBodyId = set.sims[localIndex].bodyId;
    if(localIndex != lastIdx){
        set.sims[localIndex] = set.sims[lastIdx];
        set.states[localIndex] = set.states[lastIdx];
        const u32 movedBodyId = set.sims[localIndex].bodyId;
        bodies[movedBodyId].localIndex = localIndex;
    }
    set.sims.pop_back();
    set.states.pop_back();
    bodies[removedBodyId].setIndex = s_NullIndex;
    bodies[removedBodyId].localIndex = s_NullIndex;
    ++set.membershipVersion;
}


