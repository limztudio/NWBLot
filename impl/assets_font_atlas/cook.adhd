#include <impl/assets_font_atlas/cook_entry.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const b8 s_FontAtlasCookIncludePreparedPixels = true;

b8 HasPositiveFontAtlasGlyphBitmapDimensions(in u32 width, in u32 height){
    return width > 0u && height > 0u;
}

b8 IsMatchingFontAtlasSourceGlyphListCount(in u32 sourceGlyphCount, in u32 maxGlyphCount, in usize metadataGlyphCount){
    return sourceGlyphCount > 0u && sourceGlyphCount <= maxGlyphCount && metadataGlyphCount == cast<usize>(sourceGlyphCount);
}

Expected<u32> TryConvertFontAtlasMetadataInteger(in i64 rawValue, in u32 minimum, in u32 maximum){
    if(rawValue < cast<i64>(minimum) || cast<u64>(rawValue) > cast<u64>(maximum))
        return MakeUnexpected(Failure());
    return cast<u32>(rawValue);
}

b8 ValidateFontAtlasPositiveGlyphBitmapDimensions(in Path path, in u32 width, in u32 height){
    if(HasPositiveFontAtlasGlyphBitmapDimensions(width, height))
        return true;

    error("Font atlas glyph meta '{}': bitmap dimensions must be positive; empty glyphs declare only advance_units", path);
    return false;
}

b8 ValidateFontAtlasSourceGlyphListCount(in Path path, in u32 sourceGlyphCount, in u32 maxGlyphCount, in usize metadataGlyphCount){
    if(IsMatchingFontAtlasSourceGlyphListCount(sourceGlyphCount, maxGlyphCount, metadataGlyphCount))
        return true;

    error("Font atlas glyph meta '{}': exactly one record per source glyph is required", path);
    return false;
}

Expected<u32> ValidateFontAtlasMetadataU32Field(
    in Path path,
    in StringView diagnosticPrefix,
    in StringView field,
    in b8 hasInteger,
    in i64 rawValue,
    in u32 minimum,
    in u32 maximum
){
    if(hasInteger){
        const Expected<u32> converted = TryConvertFontAtlasMetadataInteger(rawValue, minimum, maximum);
        if(converted.has_value())
            return converted.value();
    }
    error("{} '{}': field '{}' must be an integer in {}..{}", diagnosticPrefix, path, field, minimum, maximum);
    return MakeUnexpected(Failure());
}

b8 ValidateParsedFontAtlasRasterMode(in Path path, in b8 valid){
    if(valid)
        return true;

    error("Font atlas meta '{}': unsupported raster_mode", path);
    return false;
}

b8 ValidatePairedFontSourceMetrics(in Path path, in b8 valid){
    if(valid)
        return true;

    error("Font atlas meta '{}': paired font source has invalid face metrics", path);
    return false;
}

[cpp_unwind]
void MoveSourceGroups(mut PreparedFontSource source, mut FontAtlasPayload payload){
    payload.groups.reserve(source.groups.size());
    for(usize index = 0u; index < source.groups.size(); ++index){
        mut PreparedFontImageGroup prepared = source.groups[index];
        payload.groups.emplace_back();
        mut FontAtlasGroup group = payload.groups.back();
        group.width = prepared.width;
        group.height = prepared.height;
        group.channelCount = prepared.channelCount;
        group.sha256 = prepared.sha256;
        group.pixels.swap(prepared.pixels);
    }
}

Expected<u32> ReadFontAtlasMetadataU32(
    in Path path,
    in MetascriptValue map,
    in StringView diagnosticPrefix,
    in StringView field,
    in u32 minimum,
    in u32 maximum
){
    b8 hasInteger = false;
    i64 rawValue = 0;
    map.visitField(field, lambda[mut hasInteger, mut rawValue](in MetascriptValue value) -> void{
        if(value.isInteger()){
            hasInteger = true;
            rawValue = value.asInteger();
        }
    });
    return ValidateFontAtlasMetadataU32Field(path, diagnosticPrefix, field, hasInteger, rawValue, minimum, maximum);
}

Expected<FontAtlasGlyph> ReadFontAtlasGlyphMetadata(in Path path, in MetascriptValue map, in u32 glyphId, in f32 unitsPerPixel){
    if(!CheckMetadataAssetMap(path, map, s_FontAtlasGlyphMetaDiagnosticPrefix))
        return MakeUnexpected(Failure());

    const b8 hasBitmap = map.hasField(s_FontAtlasGlyphWidthField);
    if(!ValidateMetadataAssetFields(
        path,
        map,
        s_FontAtlasGlyphMetaDiagnosticPrefix,
        lambda[in hasBitmap](in StringView field) -> b8{
            return IsAllowedFontAtlasGlyphField(field, hasBitmap);
        }
    ))
        return MakeUnexpected(Failure());

    FontAtlasGlyph glyph;
    glyph.glyphId = glyphId;
    const Expected<f32> advanceUnits = ReadMetadataFiniteF32Field(path, map, s_FontAtlasGlyphMetaDiagnosticPrefix, s_FontAtlasGlyphAdvanceUnitsField, true);
    if(!advanceUnits.has_value())
        return MakeUnexpected(advanceUnits.error());
    glyph.advanceUnits = advanceUnits.value();
    if(!hasBitmap)
        return glyph;

    const Expected<u32> group = ReadFontAtlasMetadataU32(path, map, s_FontAtlasGlyphMetaDiagnosticPrefix, s_FontAtlasGlyphGroupField, 0u, s_FontAtlasMaxGroupCount - 1u);
    if(!group.has_value())
        return MakeUnexpected(group.error());
    glyph.group = group.value();
    const Expected<u32> channel = ReadFontAtlasMetadataU32(path, map, s_FontAtlasGlyphMetaDiagnosticPrefix, s_FontAtlasGlyphChannelField, 0u, s_FontAtlasMaxChannelCount - 1u);
    if(!channel.has_value())
        return MakeUnexpected(channel.error());
    glyph.channel = channel.value();
    const Expected<u32> x = ReadFontAtlasMetadataU32(path, map, s_FontAtlasGlyphMetaDiagnosticPrefix, s_FontAtlasGlyphXField, 0u, s_FontAtlasMaxExtent);
    if(!x.has_value())
        return MakeUnexpected(x.error());
    glyph.x = x.value();
    const Expected<u32> y = ReadFontAtlasMetadataU32(path, map, s_FontAtlasGlyphMetaDiagnosticPrefix, s_FontAtlasGlyphYField, 0u, s_FontAtlasMaxExtent);
    if(!y.has_value())
        return MakeUnexpected(y.error());
    glyph.y = y.value();
    const Expected<u32> width = ReadFontAtlasMetadataU32(path, map, s_FontAtlasGlyphMetaDiagnosticPrefix, s_FontAtlasGlyphWidthField, 0u, s_FontAtlasMaxExtent);
    if(!width.has_value())
        return MakeUnexpected(width.error());
    glyph.width = width.value();
    const Expected<u32> height = ReadFontAtlasMetadataU32(path, map, s_FontAtlasGlyphMetaDiagnosticPrefix, s_FontAtlasGlyphHeightField, 0u, s_FontAtlasMaxExtent);
    if(!height.has_value())
        return MakeUnexpected(height.error());
    glyph.height = height.value();
    const Expected<f32> planeLeft = ReadMetadataFiniteF32Field(path, map, s_FontAtlasGlyphMetaDiagnosticPrefix, s_FontAtlasGlyphPlaneLeftField, true);
    if(!planeLeft.has_value())
        return MakeUnexpected(planeLeft.error());
    glyph.planeLeft = planeLeft.value();
    const Expected<f32> planeTop = ReadMetadataFiniteF32Field(path, map, s_FontAtlasGlyphMetaDiagnosticPrefix, s_FontAtlasGlyphPlaneTopField, true);
    if(!planeTop.has_value())
        return MakeUnexpected(planeTop.error());
    glyph.planeTop = planeTop.value();
    if(!ValidateFontAtlasPositiveGlyphBitmapDimensions(path, glyph.width, glyph.height))
        return MakeUnexpected(Failure());
    ComputeFontAtlasGlyphPlaneBounds(unitsPerPixel, glyph);
    return glyph;
}

[cpp_unwind]
Expected<Vector<FontAtlasGlyph>> ParseFontAtlasGlyphMetadata(in Path nwbFilePath, in MetascriptValue asset, in FontAtlasPayload payload){
    const Expected<Span<MetascriptValue>> glyphsResult = ReadMetadataListField(nwbFilePath, asset, s_FontAtlasGlyphMetaDiagnosticPrefix, s_FontAtlasGlyphsField);
    if(!glyphsResult.has_value())
        return MakeUnexpected(Failure());
    in Span<MetascriptValue> glyphs = glyphsResult.value();
    if(!ValidateFontAtlasSourceGlyphListCount(nwbFilePath, payload.sourceGlyphCount, s_FontAtlasMaxGlyphCount, glyphs.size()))
        return MakeUnexpected(Failure());

    Vector<FontAtlasGlyph> candidate;
    candidate.reserve(cast<usize>(payload.sourceGlyphCount));
    const f32 unitsPerPixel = ComputeFontAtlasUnitsPerPixel(payload.unitsPerEm, payload.bakePpem);
    for(u32 index = 0u; index < payload.sourceGlyphCount; ++index){
        const Expected<FontAtlasGlyph> glyphResult = ReadFontAtlasGlyphMetadata(nwbFilePath, glyphs[cast<usize>(index)], index, unitsPerPixel);
        if(!glyphResult.has_value())
            return MakeUnexpected(Failure());
        candidate.push_back(glyphResult.value());
    }
    return candidate;
}

b8 ReadFontAtlasSettings(in Path path, in MetascriptValue asset, mut FontAtlasPayload payload){
    const Expected<u32> bakePpem = ReadFontAtlasMetadataU32(path, asset, s_FontAtlasMetaDiagnosticPrefix, s_FontAtlasBakePpemField, s_FontAtlasMinBakePpem, s_FontAtlasMaxBakePpem);
    if(!bakePpem.has_value())
        return false;
    payload.bakePpem = bakePpem.value();
    const Expected<u32> spreadPixels = ReadFontAtlasMetadataU32(path, asset, s_FontAtlasMetaDiagnosticPrefix, s_FontAtlasSpreadPixelsField, s_FontAtlasMinSpreadPixels, s_FontAtlasMaxSpreadPixels);
    if(!spreadPixels.has_value())
        return false;
    payload.spreadPixels = spreadPixels.value();
    const Expected<f32> ascenderUnits = ReadMetadataFiniteF32Field(path, asset, s_FontAtlasMetaDiagnosticPrefix, s_FontAtlasAscenderUnitsField, true);
    if(!ascenderUnits.has_value())
        return false;
    payload.ascenderUnits = ascenderUnits.value();
    const Expected<f32> descenderUnits = ReadMetadataFiniteF32Field(path, asset, s_FontAtlasMetaDiagnosticPrefix, s_FontAtlasDescenderUnitsField, true);
    if(!descenderUnits.has_value())
        return false;
    payload.descenderUnits = descenderUnits.value();
    const Expected<f32> lineGapUnits = ReadMetadataFiniteF32Field(path, asset, s_FontAtlasMetaDiagnosticPrefix, s_FontAtlasLineGapUnitsField, true);
    if(!lineGapUnits.has_value())
        return false;
    payload.lineGapUnits = lineGapUnits.value();

    const Expected<MetadataStringField> rasterModeResult = ReadMetadataStringField(path, asset, s_FontAtlasMetaDiagnosticPrefix, s_FontAtlasRasterModeField, true);
    if(!rasterModeResult.has_value())
        return false;
    const Expected<FontAtlasRasterMode> parsedRasterMode = TryParseFontAtlasRasterMode(rasterModeResult.value().text);
    if(!ValidateParsedFontAtlasRasterMode(path, parsedRasterMode.has_value()))
        return false;
    payload.rasterMode = parsedRasterMode.value();
    return true;
}

[cpp_unwind, asset_writer]
b8 SerializeFontAtlasAsset(in FontAtlas atlas, mut Vector<u8> outBinary){
    if(!atlas.checkVirtualPath("FontAtlas::validatePayload"))
        return false;
    if(atlas.isPayloadValidated())
        return SerializeFontAtlasPayloadValidatedInto(atlas.payload(), outBinary);
    return SerializeFontAtlasPayloadInto(atlas.payload(), outBinary);
}

[cpp_unwind]
Expected<FontAtlas> BuildFontAtlasAssetFromPayloadWithValidation(in Name virtualPath, in FontAtlasPayload payload, in b8 validatePayloadFlag){
    FontAtlas candidate(virtualPath);
    candidate.setPayload(payload);
    if(validatePayloadFlag){
        if(!candidate.validatePayload())
            return MakeUnexpected(Failure());
    }
    else if(!candidate.checkVirtualPath("FontAtlas::validatePayload")){
        return MakeUnexpected(Failure());
    }
    candidate.markPayloadValidated();
    return candidate;
}

[cpp_unwind]
b8 FinalizeFontAtlasPayloadFromPreparedSource(
    in Path nwbFilePath,
    in MetascriptValue asset,
    in PreparedFontSource source,
    in Font font,
    in b8 verifyPixelDigests,
    mut FontAtlasPayload inOutPayload
){
    inOutPayload.fontSha256 = source.fontSha256;
    inOutPayload.faceIndex = font.faceIndex();

    const Expected<FontFaceSfntMetrics> sfntMetrics = TryReadFontFaceMetricsFromSfnt(font.fontBytes());
    if(!ValidatePairedFontSourceMetrics(nwbFilePath, sfntMetrics.has_value()))
        return false;
    inOutPayload.unitsPerEm = sfntMetrics.value().unitsPerEm;
    inOutPayload.sourceGlyphCount = sfntMetrics.value().sourceGlyphCount;
    if(!font.validatePayload())
        return false;

    const Expected<Vector<FontAtlasPositioningTable>> positioningTablesResult = CopyFontAtlasPositioningTables(font.fontBytes(), font.faceIndex(), inOutPayload.sourceGlyphCount);
    if(!positioningTablesResult.has_value())
        return false;
    inOutPayload.positioningTables = positioningTablesResult.value();
    if(!ValidateFontAtlasSourceMatch(inOutPayload, font))
        return false;

    const Expected<Vector<FontAtlasGlyph>> glyphsResult = ParseFontAtlasGlyphMetadata(nwbFilePath, asset, inOutPayload);
    if(!glyphsResult.has_value())
        return false;
    inOutPayload.glyphs = glyphsResult.value();
    return ValidateFontAtlasPayloadWithOptions(inOutPayload, verifyPixelDigests);
}

[cpp_unwind]
b8 PopulateFontAtlasPayloadFromPreparedSourceConsuming(
    in Path nwbFilePath,
    in MetascriptValue asset,
    mut PreparedFontSource source,
    in Font font,
    in b8 verifyPixelDigests,
    mut FontAtlasPayload inOutPayload
){
    MoveSourceGroups(source, inOutPayload);
    return FinalizeFontAtlasPayloadFromPreparedSource(nwbFilePath, asset, source, font, verifyPixelDigests, inOutPayload);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind, cook_sidecar(s_PreparedFontExtension)]
Expected<FontAtlasCookEntry> ParseFontAtlasCookMetadataValue(in Name virtualPath, in Path path, in MetascriptValue asset){
    if(virtualPath == s_NameNone || !CheckMetadataAssetMap(path, asset, s_FontAtlasMetaDiagnosticPrefix))
        return MakeUnexpected(Failure());
    if(!ValidateMetadataAssetFields(path, asset, s_FontAtlasMetaDiagnosticPrefix, lambda[](in StringView fieldName) -> b8{
        return IsAllowedFontAtlasMetadataField(fieldName);
    }))
        return MakeUnexpected(Failure());

    FontAtlasCookEntry candidate;
    const Expected<AssetRef<Font>> fontRef = ReadMetadataAssetRefField<Font>(path, asset, s_FontAtlasMetaDiagnosticPrefix, s_FontAtlasMetaFontField, true);
    if(!fontRef.has_value())
        return MakeUnexpected(Failure());
    candidate.payload.font = fontRef.value();
    if(!ReadFontAtlasSettings(path, asset, candidate.payload))
        return MakeUnexpected(Failure());

    Path sourcePath = path;
    sourcePath.replaceExtension(s_PreparedFontExtension);
    Expected<PreparedFontSource, StringView> source = ReadPreparedFontSource(sourcePath, s_FontAtlasCookIncludePreparedPixels);
    if(!source.has_value())
        return MakeUnexpected(Failure());
    Font font(candidate.payload.font.name());
    font.setFontBytes(source.value().fontBytes, source.value().faceIndex);
    if(!PopulateFontAtlasPayloadFromPreparedSourceConsuming(path, asset, source.value(), font, false, candidate.payload))
        return MakeUnexpected(Failure());
    candidate.virtualPath = virtualPath;
    candidate.payloadValidated = true;
    return candidate;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
Expected<FontAtlas> BuildFontAtlasAsset(in FontAtlasCookEntry entry){
    return BuildFontAtlasAssetFromPayloadWithValidation(entry.virtualPath, entry.payload, !entry.payloadValidated);
}


