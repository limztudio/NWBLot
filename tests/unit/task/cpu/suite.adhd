void VerifyCpuTaskCancellationTests_OldGenerationsKeepDistinctResultsAcrossRepeatedReuse(){
    const usize count = 1024u;
    u32 originalCallbacks = 0u;
    u32 laterCallbacks = 0u;
    u64 canceledTasks = 0u;
    usize outstandingTasks = 0u;
    native(in count, mut originalCallbacks, mut laterCallbacks, mut canceledTasks, mut outstandingTasks){
        Alloc::ScratchArena arena("tests/task/cpu/cancellation_generations");
        Vector<CpuTaskHandle, Alloc::ScratchArena> history(count, CpuTaskHandle{}, arena);
        CpuTaskScheduler scheduler(0u);
        for(usize index = 0u; index < count; ++index){
            CpuTaskScope scope(scheduler);
            const auto historyTaskAdmission = scope.submit([&]()noexcept { ++originalCallbacks; });
            ASSERT_TRUE(historyTaskAdmission);
            history[index] = *historyTaskAdmission;
            ASSERT_TRUE(history[index].valid());
            EXPECT_EQ(history[index].index, history[0u].index);
            if(index % 2u == 0u)
                scope.cancel();
            scope.wait();
        }
        EXPECT_EQ(originalCallbacks, count / 2u);
        for(usize index = 0u; index < count; ++index){
            const u32 before = laterCallbacks;
            const auto taskAdmission = scheduler.submit([&]()noexcept { ++laterCallbacks; }, history[index]);
            ASSERT_TRUE(taskAdmission);
            const auto task = *taskAdmission;
            ASSERT_TRUE(task.valid());
            scheduler.wait(task);
            EXPECT_EQ(laterCallbacks - before, index % 2u);
        }
        canceledTasks = scheduler.statistics().canceledTasks;
        outstandingTasks = scheduler.statistics().outstandingTasks;
    }
    EXPECT_EQ(laterCallbacks, cast<u32>(count / 2u));
    EXPECT_EQ(canceledTasks, cast<u64>(count));
    EXPECT_EQ(outstandingTasks, 0u);
}

void VerifyCpuTaskCancellationTests_CancellationIsIndexedBySlotAsWellAsGeneration(){
    const usize count = 256u;
    u32 canceledCallbacks = 0u;
    u32 completedCallbacks = 0u;
    u64 canceledTasks = 0u;
    native(in count, mut canceledCallbacks, mut completedCallbacks, mut canceledTasks){
        Alloc::ScratchArena arena("tests/task/cpu/cancellation_slots");
        Vector<CpuTaskHandle, Alloc::ScratchArena> rejected(count, CpuTaskHandle{}, arena);
        Vector<CpuTaskHandle, Alloc::ScratchArena> accepted(count, CpuTaskHandle{}, arena);
        CpuTaskScheduler scheduler(0u);
        CpuTaskScope canceled(scheduler);
        CpuTaskScope completed(scheduler);
        for(usize index = 0u; index < count; ++index){
            const auto rejectedTaskAdmission = canceled.submit([&]()noexcept { ++canceledCallbacks; });
            ASSERT_TRUE(rejectedTaskAdmission);
            rejected[index] = *rejectedTaskAdmission;
            const auto acceptedTaskAdmission = completed.submit([&]()noexcept { ++completedCallbacks; });
            ASSERT_TRUE(acceptedTaskAdmission);
            accepted[index] = *acceptedTaskAdmission;
            ASSERT_TRUE(rejected[index].valid());
            ASSERT_TRUE(accepted[index].valid());
            EXPECT_EQ(rejected[index].generation, accepted[index].generation);
            EXPECT_NE(rejected[index].index, accepted[index].index);
        }
        canceled.cancel();
        canceled.wait();
        completed.wait();
        for(usize index = 0u; index < count; ++index){
            const auto cpuTaskAdmission = scheduler.submit([&]()noexcept { ++canceledCallbacks; }, rejected[index]);
            ASSERT_TRUE(cpuTaskAdmission);
            if(cpuTaskAdmission)
                ASSERT_TRUE(cpuTaskAdmission->valid());
            const auto secondCpuTaskAdmission = scheduler.submit([&]()noexcept { ++completedCallbacks; }, accepted[index]);
            ASSERT_TRUE(secondCpuTaskAdmission);
            if(secondCpuTaskAdmission)
                ASSERT_TRUE(secondCpuTaskAdmission->valid());
        }
        scheduler.wait();
        canceledTasks = scheduler.statistics().canceledTasks;
    }
    EXPECT_EQ(canceledCallbacks, 0u);
    EXPECT_EQ(completedCallbacks, cast<u32>(count * 2u));
    EXPECT_EQ(canceledTasks, cast<u64>(count * 2u));
}

void VerifyCpuTaskCancellationTests_ParallelRangesPreserveHistoryInRecycledSlots(){
    const usize count = 64u;
    u32 canceledCallbacks = 0u;
    u32 rangeCallbacks = 0u;
    u32 interruptedCallbacks = 0u;
    u64 canceledBeforeDependents = 0u;
    u64 canceledAfterDependents = 0u;
    usize outstandingTasks = 0u;
    native(in count, mut canceledCallbacks, mut rangeCallbacks, mut interruptedCallbacks, mut canceledBeforeDependents, mut canceledAfterDependents, mut outstandingTasks){
        Alloc::ScratchArena arena("tests/task/cpu/cancellation_ranges");
        Vector<CpuTaskHandle, Alloc::ScratchArena> history(count, CpuTaskHandle{}, arena);
        CpuTaskScheduler scheduler(0u);
        CpuTaskScope canceled(scheduler);
        for(usize index = 0u; index < count; ++index){
            const auto historyTaskAdmission = canceled.submit([&]()noexcept { ++canceledCallbacks; });
            ASSERT_TRUE(historyTaskAdmission);
            history[index] = *historyTaskAdmission;
            ASSERT_TRUE(history[index].valid());
        }
        canceled.cancel();
        canceled.wait();
        EXPECT_TRUE((scheduler.parallelFor(0u, 1u, 1u, [&](usize)noexcept { ++rangeCallbacks; })));
        EXPECT_TRUE((scheduler.parallelFor(0u, 128u, 1u, [&](usize)noexcept { ++rangeCallbacks; })));
        CpuTaskScope interrupted(scheduler);
        EXPECT_TRUE((interrupted.parallelFor(0u, 64u, 1u, [&](usize index)noexcept {
            ++interruptedCallbacks;
            if(index == 0u)
                interrupted.cancel();
        })));
        interrupted.wait();
        canceledBeforeDependents = scheduler.statistics().canceledTasks;
        for(const auto handle : history){
            const auto cpuTaskAdmission = scheduler.submit([&]()noexcept { ++canceledCallbacks; }, handle);
            ASSERT_TRUE(cpuTaskAdmission);
            if(cpuTaskAdmission)
                ASSERT_TRUE(cpuTaskAdmission->valid());
        }
        scheduler.wait();
        canceledAfterDependents = scheduler.statistics().canceledTasks;
        outstandingTasks = scheduler.statistics().outstandingTasks;
    }
    EXPECT_GT(interruptedCallbacks, 0u);
    EXPECT_LT(interruptedCallbacks, 64u);
    EXPECT_EQ(rangeCallbacks, 129u);
    EXPECT_EQ(canceledCallbacks, 0u);
    EXPECT_EQ(canceledAfterDependents, canceledBeforeDependents + cast<u64>(count));
    EXPECT_EQ(outstandingTasks, 0u);
}


