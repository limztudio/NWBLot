void VerifyUiNumericEditBuilderTests_DisabledAbandonRestoresBeforeIgnoredInput(mut UiNumericEditBuilderTests self){
    self.useHost();
    ASSERT_TRUE(self.m_integer.setValue(12));
    ASSERT_TRUE(self.m_integer.setDraft("42"));
    self.m_host.action(EditAction::Abandon);
    self.m_host.text("7");
    IntegerEditOptions options = IntegerEditOptions();
    options.edit.enabled = false;
    ASSERT_TRUE(self.beginNumeric(1u));
    const auto result = self.m_builder.integerEdit(s_UiNumericEditIntegerKey, self.m_integer, self.m_integerState, options);
    ASSERT_TRUE(result.edit.valid && result.numeric.valid);
    EXPECT_TRUE(result.edit.abandoned && result.numeric.restored);
    EXPECT_FALSE(result.edit.focused || result.numeric.committed || result.numeric.cancelled);
    EXPECT_EQ(self.m_integer.draft().text(), "12");
    ASSERT_TRUE(self.acceptNumeric());
    const Optional<HitTarget> field = self.findTarget(self.id(s_UiNumericEditIntegerKey, s_UiNumericEditPanelKey));
    ASSERT_TRUE(field.has_value());
    EXPECT_FALSE(field.value().enabled || field.value().focusable);
}

void VerifyUiNumericEditBuilderTests_PreeditOwnsEnterAndTheFirstEscape(mut UiNumericEditBuilderTests self){
    self.useHost();
    ASSERT_TRUE(self.m_integer.setValue(12));
    ASSERT_TRUE(self.m_integer.setDraft("42"));
    self.m_host.preedit("7");
    self.m_host.key(CoreKey::Enter);
    self.m_host.key(CoreKey::Escape);
    ASSERT_TRUE(self.beginNumeric(1u));
    const auto first = self.m_builder.integerEdit(s_UiNumericEditIntegerKey, self.m_integer, self.m_integerState);
    ASSERT_TRUE(first.edit.valid && first.numeric.valid);
    EXPECT_FALSE(first.edit.submitted || first.edit.cancelled);
    EXPECT_FALSE(first.numeric.committed || first.numeric.cancelled);
    EXPECT_FALSE(self.m_integer.draft().composition().active);
    EXPECT_EQ(self.m_integer.value(), 12);
    EXPECT_EQ(self.m_integer.draft().text(), "42");
    ASSERT_TRUE(self.acceptNumeric());
    self.m_host.key(CoreKey::Escape);
    ASSERT_TRUE(self.beginNumeric(2u));
    const auto second = self.m_builder.integerEdit(s_UiNumericEditIntegerKey, self.m_integer, self.m_integerState);
    ASSERT_TRUE(second.edit.valid && second.numeric.valid);
    EXPECT_TRUE(second.edit.cancelled && second.numeric.cancelled && second.numeric.restored);
    EXPECT_EQ(self.m_integer.draft().text(), "12");
    ASSERT_TRUE(self.acceptNumeric());
}

