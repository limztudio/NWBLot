class ScrollOffset{
    public f64 x = 0.0;
    public f64 y = 0.0;
}


class X11WindowState{
    public u32 width = 0u;
    public u32 height = 0u;
    public b8 windowVisible = false;
    public b8 windowIsInFocus = false;
}


