////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_SHADOW_LIGHT_SPACE_RECEIVER_SLANGI
#define NWB_GRAPHICS_SHADOW_LIGHT_SPACE_RECEIVER_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "../common/math.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Smallest binary16 normal exponent and the binary16 mantissa width, used to size one binary16 step.
#define NWB_LIGHT_SPACE_QUANTIZATION_MIN_EXPONENT 113u
#define NWB_LIGHT_SPACE_QUANTIZATION_MANTISSA_BITS 10u
// Cap position reconstruction roundoff, in float epsilons.
#define NWB_LIGHT_SPACE_RECEIVER_ROUNDOFF_EPSILONS 64.0


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#if NWB_LIGHT_SPACE_CSG_ENABLED
#define NWB_MESH_VIEW_BUFFER_HEAP_SLOT g_NwbLightSpacePush.receiverViewSlot
#include "../mesh/view_ray.slangi"
#include "../csg/interval_sample_state.slangi"
#include "../csg/removed_cap_sample.slangi"
#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Image stores may truncate; preserve a full binary16 spacing for ordinary receivers.
float3 nwbLightSpacePositionQuantization(const float3 position){
    const uint3 exponent = (asuint(abs(position)) >> NWB_FLOAT_MANTISSA_BIT_COUNT) & NWB_FLOAT_EXPONENT_MASK;
    return asfloat((max(exponent, uint3(NWB_LIGHT_SPACE_QUANTIZATION_MIN_EXPONENT)) - NWB_LIGHT_SPACE_QUANTIZATION_MANTISSA_BITS) << NWB_FLOAT_MANTISSA_BIT_COUNT);
}

#if NWB_LIGHT_SPACE_CSG_ENABLED
bool nwbLightSpaceReceiverPosition(const uint2 pixel, const float depth, out float3 position, out float3 positionError){
    position = nwbHeapSampledImage2D(NWB_LIGHT_SPACE_DEFERRED.gbufferSlots.z).Load(int3(pixel, 0)).xyz;
    positionError = nwbLightSpacePositionQuantization(position);
    if((g_NwbLightSpacePush.csgFlags & NWB_CSG_SHADOW_FLAG_CURRENT_RECEIVER_CAPS) != 0u){
        const uint4 workRect = nwbHeapCsgIntervalSampleState(g_NwbLightSpacePush.receiverCsgSampleStateSlot).workRect;
        const uint3 slots = uint3(NWB_LIGHT_SPACE_DEFERRED.csgSpanSlots.w, NWB_LIGHT_SPACE_DEFERRED.csgRemovedSlots.yz);
        const NwbCsgRemovedCapSample cap = nwbCsgSampleNearestRemovedCap(pixel, workRect, slots, NWB_CSG_INVALID_RECEIVER_INDEX);
        // Cap fill draws last with LessOrEqual. Exact stored-depth equality excludes ordinary foreground occlusion.
        if(cap.visible && cap.depth == depth){
            if(!isfinite(cap.linearDepth) || cap.linearDepth <= 0.0)
                return false;
            const uint2 extent = uint2(g_NwbLightSpacePush.width, g_NwbLightSpacePush.height);
            position = nwbMeshViewRadialPosition(pixel, cap.pixel, extent, cap.linearDepth);
            // FP32 ray construction, radial storage and reconstruction stay bounded before the unchanged plane proof.
            const float roundoff = NWB_LIGHT_SPACE_RECEIVER_ROUNDOFF_EPSILONS * NWB_FLOAT_EPSILON;
            positionError = (abs(g_NwbMeshCameraPosition.xyz) + abs(position - g_NwbMeshCameraPosition.xyz) + cap.linearDepth) * roundoff;
        }
    }
    return all(isfinite(position)) && all(isfinite(positionError));
}
#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

