[cpp_header("<core/metascript/parser.h>"), cpp_name("::NWB::Core::Metascript::Document")]
extern class MetascriptDocument{
    Span<MetascriptParseError> errors(...)const;
    Optional<StringView> declarationType(in StringView name)const;
    usize structCount()const;
    usize declarationCount()const;
    b8 forEachStruct(in Func<64u, b8(in StringView, in MetascriptValue)> visitor)const;
    b8 forEachDeclaration(in Func<64u, b8(in StringView, in StringView)> visitor)const;
    b8 hasErrors(...)const;
    b8 hasVariable(...)const;
    Optional<in MetascriptValue> borrowVariable(in StringView name)const;
    b8 parse(...);
    b8 visitVariable(in StringView a0, in Func<b8(mut MetascriptValue)> a1)const;
};

[cpp_header("<core/metascript/parser.h>"), cpp_name("::NWB::Core::Metascript::ParseError"), cpp_flags(brace_init)]
extern class MetascriptParseError{
    u32 line;
    u32 column;
    String message;
};

[cpp_header("<core/metascript/parser.h>"), cpp_name("::NWB::Core::Metascript::DocumentWorkspace")]
extern class MetascriptDocumentWorkspace{
    MetascriptDocument document;
};


