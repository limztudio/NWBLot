[cpp_header("<impl/assets/graphics/caustic/resolve_binding_slots.h>"), cpp_name("NWB_CAUSTIC_RESOLVE_PASS_COUNT")]
extern const u32 s_ShaderCausticResolvePassCount;
[cpp_header("<impl/assets/graphics/caustic/resolve_binding_slots.h>"), cpp_name("NWB_CAUSTIC_RESOLVE_GROUP_SIZE")]
extern const u32 s_ShaderCausticResolveGroupSize;

static_assert(s_CausticResolvePassCount == s_ShaderCausticResolvePassCount);
static_assert(s_CausticResolveGroupThreadCount == s_ShaderCausticResolveGroupSize);
static_assert(s_CausticResolveGroupThreadCount * s_CausticResolveGroupThreadCount == s_CausticResolveGroupLaneCount);

[cpp_unwind]
void RendererRayTracingSystem::releaseCausticEmissionTargetHeapHandle(){
    this.m_rayTracingState.caustics.m_causticEmissionTargets.releaseDescriptor(this.m_graphics);
    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
    RetireDescriptor(heap, this.m_rayTracingState.caustics.m_hwCausticDeferredQueueHeapHandle);
    RetireDescriptor(heap, this.m_rayTracingState.caustics.m_hwCausticDeferredArgsHeapHandle);
}

[cpp_unwind]
b8 RendererRayTracingSystem::createCausticTargets(mut DeferredFrameTargets targets){
    targets.causticIrradianceFormat = Format::RGBA16_FLOAT;
    targets.causticAccumulatorFormat = Format::R32_UINT;
    targets.causticHistoryFormat = Format::RGBA16_FLOAT;

    this.m_rayTracingState.caustics.m_causticAccumulatorInitialized = false;

    const u32 halfWidth = ComputeCausticHalfTargetExtent(targets.width);
    const u32 halfHeight = ComputeCausticHalfTargetExtent(targets.height);

    TextureDesc irradianceDesc = TextureDesc();
    irradianceDesc.setWidth(targets.width).setHeight(targets.height).setFormat(targets.causticIrradianceFormat).setIsUAV(true).setQueueSharing(ResourceQueueSharing::GraphicsAsyncComputeAndTransfer).setName(Name("engine/caustic/irradiance"));
    auto causticIrradianceResult = this.m_graphics.createTexture(irradianceDesc);
    if(causticIrradianceResult.has_value())
        targets.causticIrradiance = causticIrradianceResult.value();
    else
        targets.causticIrradiance.reset();
    if(!causticIrradianceResult.has_value()){
        error("RendererSystem: failed to create caustic irradiance target");
        return false;
    }

    TextureDesc accumulatorDesc = TextureDesc();
    accumulatorDesc.setWidth(targets.width).setHeight(targets.height).setArraySize(s_CausticAccumulatorChannelCount).setDimension(TextureDimension::Texture2DArray).setFormat(targets.causticAccumulatorFormat).setIsUAV(true).setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute).setName(Name("engine/caustic/accumulator"));
    auto causticAccumulatorResult = this.m_graphics.createTexture(accumulatorDesc);
    if(causticAccumulatorResult.has_value())
        targets.causticAccumulator = causticAccumulatorResult.value();
    else
        targets.causticAccumulator.reset();
    if(!causticAccumulatorResult.has_value()){
        error("RendererSystem: failed to create caustic accumulator target");
        return false;
    }

    TextureDesc historyDesc = TextureDesc();
    historyDesc.setWidth(halfWidth).setHeight(halfHeight).setFormat(targets.causticHistoryFormat).setIsUAV(true).setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute).setName(Name("engine/caustic/atrous_half_a"));
    auto causticHistoryResult = this.m_graphics.createTexture(historyDesc);
    if(causticHistoryResult.has_value())
        targets.causticHistory = causticHistoryResult.value();
    else
        targets.causticHistory.reset();
    if(!causticHistoryResult.has_value()){
        error("RendererSystem: failed to create caustic a-trous half-A target");
        return false;
    }

    TextureDesc halfBDesc = TextureDesc();
    halfBDesc.setWidth(halfWidth).setHeight(halfHeight).setFormat(targets.causticHistoryFormat).setIsUAV(true).setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute).setName(Name("engine/caustic/atrous_half_b"));
    auto causticResolveHalfResult = this.m_graphics.createTexture(halfBDesc);
    if(causticResolveHalfResult.has_value())
        targets.causticResolveHalf = causticResolveHalfResult.value();
    else
        targets.causticResolveHalf.reset();
    if(!causticResolveHalfResult.has_value()){
        error("RendererSystem: failed to create caustic a-trous half-B target");
        return false;
    }

    TextureDesc geometryDesc = TextureDesc();
    geometryDesc.setWidth(halfWidth).setHeight(halfHeight).setFormat(targets.causticHistoryFormat).setIsUAV(true).setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute).setName(Name("engine/caustic/resolve_geometry"));
    auto causticResolveGeometryResult = this.m_graphics.createTexture(geometryDesc);
    if(causticResolveGeometryResult.has_value())
        targets.causticResolveGeometry = causticResolveGeometryResult.value();
    else
        targets.causticResolveGeometry.reset();
    if(!causticResolveGeometryResult.has_value()){
        error("RendererSystem: failed to create caustic resolve geometry cache target");
        return false;
    }
    CausticActivityResources activity(this.m_graphics, this.m_rayTracingState.caustics.m_causticResolve.m_activity);
    if(!activity.prepareCausticResolveActivity(halfWidth, halfHeight))
        warning("RendererSystem: caustic activity buffers unavailable; retaining full wavelet filtering");
    return true;
}

[cpp_unwind]
b8 RendererRayTracingSystem::prepareGpuBvhCausticResources(mut DeferredFrameTargets targets){
    if(this.m_graphics.queryFeatureSupport(Feature::RayTracingAccelStruct) && this.m_graphics.queryFeatureSupport(Feature::RayQuery))
        return true;
    if(this.m_rayTracingState.caustics.m_causticRefractiveInstanceCount == 0u || this.m_rayTracingState.sceneBvh.m_sceneBvhInstanceCount == 0u || this.m_rayTracingState.shadow.m_swShadowMeshCount == 0u
        || !this.m_rayTracingState.caustics.m_causticEmissionTargets.buffer.valid())
        return true;
    const MeshViewBufferSnapshot meshView = this.m_meshSystem.meshViewBufferSnapshot();
    return this.prepareCausticResources(meshView, false, targets);
}

[cpp_unwind]
b8 RendererRayTracingSystem::prepareHwCausticResources(mut DeferredFrameTargets targets){
    if(!this.m_graphics.queryFeatureSupport(Feature::RayTracingAccelStruct) || !this.m_graphics.queryFeatureSupport(Feature::RayQuery))
        return true;
    if(this.m_rayTracingState.caustics.m_causticRefractiveInstanceCount == 0u || !this.m_rayTracingState.sceneBvh.m_tlas.valid() || this.m_rayTracingState.shadow.m_shadowMeshCount == 0u
        || !this.m_rayTracingState.caustics.m_causticEmissionTargets.buffer.valid())
        return true;
    const MeshViewBufferSnapshot meshView = this.m_meshSystem.meshViewBufferSnapshot();
    return this.prepareCausticResources(meshView, true, targets);
}

CausticResolveActivitySnapshot RendererRayTracingSystem::causticResolveActivitySnapshot(in DeferredFrameTargets targets)const{
    in CausticResolveActivitySnapshot activity = this.m_rayTracingState.caustics.m_causticResolve.m_activity;
    if(!activity.valid() || !MatchesCausticResolveActivityExtent(activity.halfWidth, activity.halfHeight, targets.width, targets.height))
        return CausticResolveActivitySnapshot();
    return activity;
}

b8 RendererRayTracingSystem::hasHwCausticWork()const{
    const MeshViewBufferSnapshot meshView = this.m_meshSystem.meshViewBufferSnapshot();
    return this.hasHwCausticWork(meshView);
}

b8 RendererRayTracingSystem::hasHwCausticWork(in MeshViewBufferSnapshot meshView)const{
    in RtCausticState caustics = this.m_rayTracingState.caustics;
    b8 pipelineReady = caustics.m_hwCausticPipeline.valid();
    if(this.m_lightSpaceShadow.m_csg.snapshot.hasCsg)
        pipelineReady = caustics.m_hwCausticCsgPipeline.valid();
    return
        this.m_graphics.queryFeatureSupport(Feature::RayTracingAccelStruct)
        && this.m_graphics.queryFeatureSupport(Feature::RayQuery)
        && pipelineReady
        && this.m_rayTracingState.sceneBvh.m_tlas.valid()
        && this.m_rayTracingState.shadow.m_shadowMeshCount > 0u
        && this.hasCommonCausticWork(meshView)
    ;
}

[cpp_unwind]
b8 RendererRayTracingSystem::prepareCausticResources(in MeshViewBufferSnapshot meshView, in b8 hardware, mut DeferredFrameTargets targets){
    if(!targets.causticAccumulator.valid() || !targets.causticIrradiance.valid() || !meshView.buffer.valid() || !meshView.heapHandle.valid() || !this.m_rayTracingState.caustics.m_causticEmissionTargets.heapHandle.valid())
        return true;
    if(meshView.heapHandle.descriptorClass() != GpuDescriptorClass::UniformBuffer || this.m_rayTracingState.caustics.m_causticEmissionTargets.heapHandle.descriptorClass() != GpuDescriptorClass::StorageBuffer){
        error("RendererSystem: caustic photon heap input has an unexpected descriptor class");
        return false;
    }
    if(!targets.bindless.valid()){
        if(hardware)
            error("RendererSystem: hardware caustics require complete deferred bindless frame resources");
        else
            error("RendererSystem: software caustics require complete deferred bindless frame resources");
        return false;
    }

    CausticPipelineSet pipelines(this.m_graphics, this.m_shaderSystem, this.m_rayTracingState.caustics, this.m_lightSpaceShadow.m_csg.snapshot.hasCsg);
    RayTraceMaterialResources materialResources(this.m_graphics, this.m_rayTracingState.sceneBvh, this.m_rayTracingState.shadow);
    b8 producerReady = materialResources.ensureRayTraceMaterialContextSlotsHeapHandle();
    if(producerReady){
        if(hardware){
            producerReady = pipelines.ensureHwCausticPipeline();
            if(producerReady && !this.m_lightSpaceShadow.m_csg.snapshot.hasCsg){
                const CausticPhotonBudget budget = MakeCausticPhotonBudget(this.m_causticQualitySettings, s_CausticHwPhotonGridSide, s_CausticTemporalPhaseCount);
                EnsureHwCausticDeferredScratch(this.m_graphics, this.m_rayTracingState.caustics, budget.photonsPerFrame);
            }
        }
        else
            producerReady = pipelines.ensureSwCausticPipeline();
    }
    const b8 resolveReady = pipelines.ensureCausticGeometryDownsamplePipeline() && pipelines.ensureCausticResolvePipeline();
    const b8 temporalReady = pipelines.ensureCausticAccumulatorDecayPipeline();
    return producerReady && resolveReady && temporalReady;
}

b8 RendererRayTracingSystem::causticResolveResourcesReady(in DeferredFrameTargets targets)const{
    return
        AreAllCausticResolveStagePipelinesReady(
            this.m_rayTracingState.caustics.m_causticResolve.m_prepare.m_pipeline.valid(),
            this.m_rayTracingState.caustics.m_causticResolve.m_wavelet.m_pipeline.valid(),
            this.m_rayTracingState.caustics.m_causticResolve.m_waveletStepOne.m_pipeline.valid(),
            this.m_rayTracingState.caustics.m_causticResolve.m_waveletStepTwo.m_pipeline.valid(),
            this.m_rayTracingState.caustics.m_causticResolve.m_waveletDirect.m_pipeline.valid(),
            this.m_rayTracingState.caustics.m_causticResolve.m_upsample.m_pipeline.valid()
        )
        && this.m_rayTracingState.caustics.m_causticGeometryDownsamplePipeline.valid()
        && this.m_rayTracingState.caustics.m_causticAccumulatorDecayPipeline.valid()
        && targets.causticAccumulator.valid()
        && targets.causticIrradiance.valid()
        && targets.causticHistory.valid()
        && targets.causticResolveHalf.valid()
        && targets.causticResolveGeometry.valid()
        && targets.bindless.valid()
        && targets.bindless.causticIrradianceStorage.valid()
        && targets.bindless.causticAccumulatorStorage.valid()
        && targets.bindless.causticHistoryStorage.valid()
        && targets.bindless.causticResolveHalfStorage.valid()
        && targets.bindless.causticResolveGeometryStorage.valid()
    ;
}

b8 RendererRayTracingSystem::hasCommonCausticWork(in MeshViewBufferSnapshot meshView)const{
    return
        this.m_shadowVisibilityTraceResourcesPreflighted
        && this.m_shadowVisibilityPreparedTargets.has_value()
        && this.causticResolveResourcesReady(this.m_shadowVisibilityPreparedTargets.value())
        && this.m_rayTracingState.caustics.m_causticLightCount > 0u
        && this.m_unsupportedCausticVolumeCount == 0u
        && this.m_rayTracingState.caustics.m_causticRefractiveInstanceCount > 0u
        && this.m_rayTracingState.caustics.m_causticEmissionTargets.buffer.valid()
        && this.m_rayTracingState.caustics.m_causticEmissionTargets.heapHandle.valid()
        && this.m_rayTracingState.caustics.m_causticEmissionTargets.heapHandle.descriptorClass() == GpuDescriptorClass::StorageBuffer
        && this.m_rayTracingState.sceneBvh.m_rayTraceMaterialContextSlotsBuffer.valid()
        && this.m_rayTracingState.sceneBvh.m_rayTraceMaterialContextSlotsHeapHandle.valid()
        && this.m_rayTracingState.sceneBvh.m_rayTraceMaterialContextSlotsHeapHandle.descriptorClass() == GpuDescriptorClass::UniformBuffer
        && meshView.bindingValid()
    ;
}


