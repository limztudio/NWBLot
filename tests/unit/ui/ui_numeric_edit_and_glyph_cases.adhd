class UiNumericFormatBuffer{
    public Array<u8, s_NumericEditMaxBytes> storage;
    public Expected<usize, ErrorCode> result = MakeUnexpected(ErrorCode());
    public b8 hasValue()const{ return this.result.has_value(); }
    public StringView text()const{
        if(this.result.has_value())
            return ReadBinaryTextSlice(this.storage, 0u, cast<isize>(this.result.value())).value();
        return "";
    }
    public ErrorCode error()const{
        if(!this.result.has_value())
            return this.result.error();
        return ErrorCode();
    }
}

[ordered]
class UiNumericFormatGuardedOneByteBuffer{
    public u8 first = 'a';
    public Array<u8, 1u> buffer = Array<u8, 1u>('x');
    public u8 last = 'z';
    public Expected<usize, ErrorCode> formatInteger(in i64 value){ return FormatI64Bytes(value, this.buffer); }
    public Expected<usize, ErrorCode> formatFloat(in f64 value){ return FormatF64Bytes(value, this.buffer); }
    public b8 firstIntact()const{ return this.first == 'a'; }
    public b8 lastIntact()const{ return this.last == 'z'; }
}

class UiNumericEditBuilderPlainHost : IEditBoxHost{
    public usize edits = 0u;

    public EditBoxResult edit(in WidgetState arg0, in EditBoxOptions arg1, mut EditModel arg2)override{
        ++this.edits;
        EditBoxResult result;
        result.valid = true;
        return result;
    }
    public EditBoxResult editInPopup(in WidgetState arg0, in EditBoxOptions arg1, in PopupToken arg2, mut EditModel arg3)override{ return EditBoxResult(); }
    public EditBoxResult editActions(in WidgetState arg0, in EditBoxOptions arg1, in PopupToken arg2, mut EditModel arg3, mut IEditActionSink arg4)override{ return EditBoxResult(); }
    public EditBoxResult editNavigated(in WidgetState arg0, in EditBoxOptions arg1, in PopupToken arg2, mut EditModel arg3, mut EditNavigationState arg4, mut IEditNavigationResolver arg5, mut IEditActionSink arg6)override{ return EditBoxResult(); }
    public b8 publish(in WidgetState arg0, in EditBoxView arg1, in EditBoxPlacement arg2, in EditBoxOptions arg3)override{ return true; }
}

