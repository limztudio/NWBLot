#include <impl/ecs_mesh/skinning/skinning_internal.adhd>
#include <impl/ecs_mesh/skinning/skin_payload.adhd>
#include <impl/ecs_mesh/skinning/runtime_instance.adhd>
#include <impl/ecs_mesh/skinning/submission_state.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SkinningFramePlanFlags{
    public b8 hasActiveSkin = false;
    public b8 copiesRestStreams = false;
    public b8 updatesMeshletBounds = false;
    public b8 repacksNormals = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


EntityID ResolveSkinningSkeletonEntity(in EntityID fallbackEntity, in EntityID skeletonEntity){
    if(skeletonEntity.valid())
        return skeletonEntity;
    return fallbackEntity;
}

b8 ShouldRepackSkinnedMeshNormals(in b8 hasActiveSkin, in b8 copiesRestStreams, in b8 hasAttributeBuffer){
    return (hasActiveSkin || copiesRestStreams) && hasAttributeBuffer;
}

SkinningFramePlanFlags BuildSkinningFramePlanFlags(in b8 hasActiveSkin, in u64 deformationContentRevision, in b8 hasAttributeBuffer){
    SkinningFramePlanFlags out;
    out.updatesMeshletBounds = deformationContentRevision == 0u;
    if(!out.updatesMeshletBounds)
        return out;
    out.hasActiveSkin = hasActiveSkin;
    out.copiesRestStreams = !hasActiveSkin;
    out.repacksNormals = ShouldRepackSkinnedMeshNormals(hasActiveSkin, out.copiesRestStreams, hasAttributeBuffer);
    return out;
}

b8 CanConfirmGraphOwnedSkinningDispatch(
    in b8 updatesMeshletBounds,
    in b8 hasLocalBoundsResource,
    in b8 hasMeshletLocalBoundsResource,
    in u32 resourcesEditRevision,
    in u32 commitEditRevision,
    in b8 buffersMatch,
    in b8 slotsBufferMatch,
    in b8 slotsDescriptorMatch,
    in b8 slotsPayloadMatch
){
    return
        updatesMeshletBounds
        && hasLocalBoundsResource
        && hasMeshletLocalBoundsResource
        && resourcesEditRevision == commitEditRevision
        && buffersMatch
        && slotsBufferMatch
        && slotsDescriptorMatch
        && slotsPayloadMatch
    ;
}

b8 ValidateFramePlanDispatchState(
    in u64 handleValue,
    in b8 hasBindlessResourceSlotsBuffer,
    in b8 hasValidResourceSlotsDescriptor,
    in b8 hasBoundsPipelines,
    in b8 hasActiveSkin,
    in b8 hasActiveSkinResourcesAndPipeline,
    in b8 repacksNormals,
    in b8 hasRepackPipeline
){
    if(!hasBindlessResourceSlotsBuffer || !hasValidResourceSlotsDescriptor || !hasBoundsPipelines){
        error("MeshSkinningSystem: runtime mesh '{}' has incomplete graph-owned dispatch state", handleValue);
        return false;
    }
    if(hasActiveSkin && !hasActiveSkinResourcesAndPipeline){
        error("MeshSkinningSystem: active runtime mesh '{}' has no graph-owned skinning pipeline or payload", handleValue);
        return false;
    }
    if(repacksNormals && !hasRepackPipeline){
        error("MeshSkinningSystem: runtime mesh '{}' requires a missing normal-repack pipeline", handleValue);
        return false;
    }
    return true;
}

void LogSkinningFramePlanError(in StringView actionLabel, in StringView detailLabel, in u64 handleValue){
    error("MeshSkinningSystem: failed to {} {} for runtime mesh '{}'", actionLabel, detailLabel, handleValue);
}

void ConfirmMeshSkinningInstanceDispatch(
    in MeshSkinningGraphDispatchPlan plan,
    mut MeshSkinningRuntimeInstance instance,
    mut MeshSkinningRuntimeResources resources
){
    if(instance.editRevision != plan.submissionCommit.editRevision)
        return;
    if(!CanConfirmGraphOwnedSkinningDispatch(
        plan.updatesMeshletBounds,
        plan.localBoundsResource.valid(),
        plan.meshletLocalBoundsResource.valid(),
        resources.editRevision,
        plan.submissionCommit.editRevision,
        resources.buffers == CaptureMeshSkinningResourceBuffers(instance),
        resources.bindlessResourceSlotsBuffer == plan.bindlessResourceSlotsBuffer,
        resources.bindlessHeapHandles.resourceSlots == plan.bindlessResourceSlotsDescriptor,
        resources.bindlessResourceSlots == plan.bindlessResourceSlotsPayload
    ))
        return;

    if(!instance.deformationState.accept(plan.deformationCandidate))
        return;

    ApplyMeshSkinningSubmissionCommit(true, instance.editRevision, plan.submissionCommit, instance.dirtyFlags, resources.bindlessResourceSlotsUploaded);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 PopulateFrameRuntimeSkinPayload(
    mut MeshSkinningSystem system,
    in EntityID skeletonEntity,
    in MeshSkinningRuntimeInstance instance,
    in Optional<SkinningComponentView<SkeletonJointPaletteComponent>> jointPalette,
    in Optional<SkinningComponentView<SkeletonPoseComponent>> skeletonPose,
    mut RuntimeSkinPayloadScratch payload
){
    if(skeletonPose.has_value() && HasSkeletonPoseData(skeletonPose.value().component)){
        const auto cachedIt = system.m_frameCachedPoses.find(skeletonEntity);
        if(cachedIt != system.m_frameCachedPoses.end()){
            const CachedSkinningSkeletonPoseEntry cached = cachedIt.value();
            if(!cached.valid){
                payload.reset(cast<u32>(SkeletonSkinningMode::LinearBlend));
                LogInvalidMeshSkinningSkeletonPose(instance.handle.value);
                return false;
            }
            const Span<SkeletonJointMatrix> cachedSpan = Span<SkeletonJointMatrix>(system.m_frameCachedPoseJoints).subspan(cached.offset, cached.count);
            return PopulateRuntimeSkinPayloadFromCachedPose(instance, cachedSpan, cached.skinningMode, payload);
        }

        payload.reset(cast<u32>(SkeletonSkinningMode::LinearBlend));
        const Expected<u32> skinningMode = TryBuildStoredJointPaletteVectorFromSkeletonPose(skeletonPose.value().component, payload.poseJoints);
        CachedSkinningSkeletonPoseEntry entry;
        if(!skinningMode.has_value()){
            system.m_frameCachedPoses.try_emplace(skeletonEntity, entry);
            payload.poseJoints.clear();
            LogInvalidMeshSkinningSkeletonPose(instance.handle.value);
            return false;
        }
        entry.offset = system.m_frameCachedPoseJoints.size();
        entry.count = payload.poseJoints.size();
        entry.skinningMode = skinningMode.value();
        entry.valid = true;
        system.m_frameCachedPoseJoints.reserve(system.m_frameCachedPoseJoints.size() + payload.poseJoints.size());
        for(in SkeletonJointMatrix joint : payload.poseJoints)
            system.m_frameCachedPoseJoints.push_back(joint);
        system.m_frameCachedPoses.try_emplace(skeletonEntity, entry);
        return PopulateRuntimeSkinPayloadFromCachedPose(instance, payload.poseJoints, entry.skinningMode, payload);
    }
    return BuildRuntimeSkinPayload(instance, jointPalette, Optional<SkinningComponentView<SkeletonPoseComponent>>(), payload);
}

b8 MeshSkinningFramePlanBuilder::declare(in EntityID entity, in SkinnedMeshBindingComponent binding){
    if(!binding.runtimeMesh.valid())
        return true;

    const auto entry = this.m_system.m_runtimeMeshCache.editInstance(binding.runtimeMesh);
    if(!entry.has_value())
        return true;
    mut MeshSkinningRuntimeInstance instance = entry.value();
    assert(instance.valid());
    const EntityID skeletonEntity = ResolveSkinningSkeletonEntity(entity, binding.skeletonEntity);
    const auto jointPalette = FindSkinningComponent<SkeletonJointPaletteComponent>(this.m_system.m_world, skeletonEntity);
    const auto skeletonPose = FindSkinningComponent<SkeletonPoseComponent>(this.m_system.m_world, skeletonEntity);
    mut RuntimeSkinPayloadScratch payload = this.m_system.m_framePayloadScratch;
    if(!PopulateFrameRuntimeSkinPayload(this.m_system, skeletonEntity, instance, jointPalette, skeletonPose, payload)){
        instance.deformationState.invalidateCurrent();
        return true;
    }

    const b8 hasActiveSkin = payload.hasActiveSkin();
    Span<SkeletonJointMatrix> jointPaletteUpload;
    if(hasActiveSkin){
        const auto upload = ResolveMeshSkinningGpuJointPalette(instance, payload);
        if(!upload.has_value()){
            error("MeshSkinningSystem: current joint palette does not match Skin upload bounds for runtime mesh '{}'", instance.handle.value);
            return false;
        }
        jointPaletteUpload = upload.value();
    }
    const b8 skinningInputDirty = (instance.dirtyFlags & RuntimeMeshDirtyFlag::SkinningInputDirty) != RuntimeMeshDirtyFlag::None;
    const b8 meshletBoundsDirty = (instance.dirtyFlags & RuntimeMeshDirtyFlag::MeshletBoundsDirty) != RuntimeMeshDirtyFlag::None;
    if(instance.meshlets.empty())
        return true;

    const auto foundResources = this.m_system.m_runtimeResources.find(instance.handle.value);
    if(foundResources == this.m_system.m_runtimeResources.end()){
        error("MeshSkinningSystem: runtime mesh '{}' has no prepared graph resources", instance.handle.value);
        return false;
    }
    const MeshSkinningDeformationInputs deformationInputs(foundResources.value().bindlessResourceSlotsBuffer, instance.editRevision, payload.resolvedSkinningMode);
    instance.deformationState.refreshCurrent(deformationInputs, payload.jointMatrices, skinningInputDirty || meshletBoundsDirty);
    const SkinningFramePlanFlags planFlags = BuildSkinningFramePlanFlags(hasActiveSkin, instance.deformationState.contentRevision(), instance.attributeBuffer.valid());
    if(!planFlags.updatesMeshletBounds)
        return true;
    const b8 validResourceSlotsDescriptor = foundResources.value().bindlessHeapHandles.resourceSlots.valid() && foundResources.value().bindlessHeapHandles.resourceSlots.descriptorClass() == GpuDescriptorClass::UniformBuffer;
    if(!ValidateFramePlanDispatchState(
        instance.handle.value,
        foundResources.value().bindlessResourceSlotsBuffer.valid(),
        validResourceSlotsDescriptor,
        this.m_system.m_boundsComputePipeline.valid() && this.m_system.m_localBoundsComputePipeline.valid(),
        planFlags.hasActiveSkin,
        foundResources.value().skinBuffer.valid() && foundResources.value().jointPaletteBuffer.valid() && this.m_system.m_skinningComputePipeline.valid(),
        planFlags.repacksNormals,
        this.m_system.m_repackComputePipeline.valid()
    ))
        return false;

    MeshSkinningGraphDispatchPlan plan;
    plan.handle = instance.handle;
    plan.submissionCommit.editRevision = instance.editRevision;
    plan.submissionCommit.handledDirtyFlags = ResolveHandledSkinningDirtyFlags(skinningInputDirty, meshletBoundsDirty);
    plan.hasActiveSkin = planFlags.hasActiveSkin;
    plan.copiedRestStreams = planFlags.copiesRestStreams;
    plan.updatesMeshletBounds = planFlags.updatesMeshletBounds;
    plan.repacksNormals = planFlags.repacksNormals;
    plan.meshletCount = cast<u32>(instance.meshlets.size());
    plan.skinCount = cast<u32>(payload.skinInfluenceCount);
    plan.jointCount = cast<u32>(jointPaletteUpload.size());
    plan.skinningMode = payload.resolvedSkinningMode;
    plan.bindlessResourceSlots = foundResources.value().bindlessHeapHandles.resourceSlots.slot();
    plan.bindlessResourceSlotsBuffer = foundResources.value().bindlessResourceSlotsBuffer;
    plan.bindlessResourceSlotsDescriptor = foundResources.value().bindlessHeapHandles.resourceSlots;
    plan.bindlessResourceSlotsPayload = foundResources.value().bindlessResourceSlots;

    MeshSkinningFrameResourceImports imports(this.m_system, this.m_graph);
    if(!imports.import(instance, foundResources.value(), plan))
        return false;
    if(!foundResources.value().bindlessResourceSlotsUploaded && !this.declareBindlessSlotsUpload(instance, foundResources.value(), plan))
        return false;
    if(planFlags.copiesRestStreams && !this.declareRestToSkinnedCopy(instance, plan))
        return false;
    if(planFlags.hasActiveSkin && !this.declareJointPaletteUpload(instance, jointPaletteUpload, plan))
        return false;

    const auto deformationCandidate = instance.deformationState.stage(deformationInputs, payload.jointMatrices);
    if(!deformationCandidate.has_value())
        return false;
    plan.deformationCandidate = deformationCandidate.value();
    this.m_plans.push_back(plan);
    return true;
}

b8 MeshSkinningFramePlanBuilder::declareUploadTask(
    in MeshSkinningRuntimeInstance instance,
    in StringView identitySuffix,
    in StringView markerLabel,
    in Expected<GpuUploadBlobId> uploadSource,
    in GpuGraphResourceId destination,
    in ResourceStates finalState,
    in StringView retainErrorLabel,
    in StringView declareErrorLabel
){
    const Name identity = DeriveRuntimeResourceName(instance.sourceName, instance.handle.value, instance.editRevision, identitySuffix);
    if(identity == s_NameNone || !uploadSource.has_value()){
        LogSkinningFramePlanError("retain", retainErrorLabel, instance.handle.value);
        return false;
    }
    GpuTaskDesc desc;
    desc.setIdentity(identity).setMarkerLabel(markerLabel).setScheduling(MakeJointPaletteUploadScheduling());
    GpuUploadBufferTaskDesc upload;
    upload.source = uploadSource.value();
    upload.destination = destination;
    upload.finalState = finalState;
    const auto task = this.m_graph.addUploadBufferTask(desc, upload);
    if(!task.has_value()){
        LogSkinningFramePlanError("declare", declareErrorLabel, instance.handle.value);
        return false;
    }
    this.m_uploadTasks.push_back(task.value());
    return true;
}

b8 MeshSkinningFramePlanBuilder::declareBindlessSlotsUpload(in MeshSkinningRuntimeInstance instance, in MeshSkinningRuntimeResources resources, mut MeshSkinningGraphDispatchPlan plan){
    if(!this.declareUploadTask(
        instance, s_BindlessSlotsUploadSuffix, s_BindlessSlotsUploadLabel, this.m_graph.copyUploadValue(resources.bindlessResourceSlots),
        plan.bindlessResourceSlotsResource, ResourceStates::Common, "graph-owned bindless slots", "graph-owned bindless slots"
    ))
        return false;
    plan.submissionCommit.bindlessResourceSlotsUploadRecorded = true;
    return true;
}

GpuCopyBufferTaskRegion MakeSkinningCopyRegion(in GpuGraphResourceId source, in GpuGraphResourceId destination, in u64 size){
    GpuCopyBufferTaskRegion region;
    region.source = source;
    region.destination = destination;
    region.dataSizeBytes = size;
    return region;
}

b8 MeshSkinningFramePlanBuilder::declareRestToSkinnedCopy(in MeshSkinningRuntimeInstance instance, in MeshSkinningGraphDispatchPlan plan){
    const auto sizes = TryResolveMeshSkinningRestToSkinnedCopyByteCounts(instance.restPositions.size(), instance.restNormals.size(), instance.restTangents.size());
    if(!sizes.has_value()){
        error("MeshSkinningSystem: failed to resolve rest-to-skinned copy sizes for runtime mesh '{}'", instance.handle.value);
        return false;
    }
    Array<GpuCopyBufferTaskRegion, 3u> regions;
    regions[0] = MakeSkinningCopyRegion(plan.restPositionResource, plan.skinnedPositionResource, sizes.value().positionBytes);
    regions[1] = MakeSkinningCopyRegion(plan.restNormalResource, plan.skinnedNormalResource, sizes.value().normalBytes);
    regions[2] = MakeSkinningCopyRegion(plan.restTangentResource, plan.skinnedTangentResource, sizes.value().tangentBytes);
    const Name identity = DeriveRuntimeResourceName(instance.sourceName, instance.handle.value, instance.editRevision, s_RestToSkinnedCopySuffix);
    if(identity == s_NameNone){
        error("MeshSkinningSystem: failed to derive graph identity for rest-to-skinned copy");
        return false;
    }
    GpuTaskDesc desc;
    desc.setIdentity(identity).setMarkerLabel(s_RestToSkinnedCopyLabel).setScheduling(MakeJointPaletteUploadScheduling());
    const auto task = this.m_graph.addCopyBufferRegions(desc, Span<GpuCopyBufferTaskRegion>(regions));
    if(!task.has_value()){
        error("MeshSkinningSystem: failed to declare graph-owned rest-to-skinned copy for runtime mesh '{}'", instance.handle.value);
        return false;
    }
    this.m_uploadTasks.push_back(task.value());
    return true;
}

b8 MeshSkinningFramePlanBuilder::declareJointPaletteUpload(in MeshSkinningRuntimeInstance instance, in Span<SkeletonJointMatrix> jointPaletteUpload, in MeshSkinningGraphDispatchPlan plan){
    const auto bytes = TryComputeRuntimeMeshBufferByteCount(jointPaletteUpload.size(), size_of<SkeletonJointMatrix>());
    if(!bytes.has_value() || bytes.value() == 0u){
        error("MeshSkinningSystem: joint palette payload byte size overflows");
        return false;
    }
    return this.declareUploadTask(
        instance, s_JointPaletteUploadSuffix, s_JointPaletteUploadLabel, this.m_graph.copyUploadElements<SkeletonJointMatrix>(jointPaletteUpload),
        plan.jointPaletteResource, ResourceStates::ShaderResource, "graph-owned joint palette data", "graph-owned joint palette upload"
    );
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void BindSkinningComputePipeline(
    in GpuGraphPipelineId pipelineId,
    mut ComputePipeline pipeline,
    mut GpuDescriptorHeap heap,
    mut CommandList commandList,
    mut GpuGraphPipelineId inOutBoundPipeline
){
    if(inOutBoundPipeline == pipelineId)
        return;
    ComputeState computeState;
    computeState.setPipeline(pipeline);
    commandList.setComputeState(computeState);
    heap.bindCompute(commandList, pipeline);
    inOutBoundPipeline = pipelineId;
}

b8 DispatchSkinningDeformationPlan(
    in MeshSkinningGraphDispatchPlan plan,
    in GpuTaskRecordContext context,
    mut GpuDescriptorHeap heap,
    mut CommandList commandList,
    mut GpuGraphPipelineId inOutBoundPipeline
){
    if(!plan.hasActiveSkin)
        return false;

    const b8 bindlessResourceSlots = context.declarations.borrowBuffer(plan.bindlessResourceSlotsResource).has_value();
    const b8 skinnedPosition = context.declarations.borrowBuffer(plan.skinnedPositionResource).has_value();
    const b8 restPosition = context.declarations.borrowBuffer(plan.restPositionResource).has_value();
    const b8 restNormal = context.declarations.borrowBuffer(plan.restNormalResource).has_value();
    const b8 restTangent = context.declarations.borrowBuffer(plan.restTangentResource).has_value();
    const b8 skinnedNormal = context.declarations.borrowBuffer(plan.skinnedNormalResource).has_value();
    const b8 skinnedTangent = context.declarations.borrowBuffer(plan.skinnedTangentResource).has_value();
    const b8 meshletDesc = context.declarations.borrowBuffer(plan.meshletDescResource).has_value();
    const b8 meshletPositionRefDeltas = context.declarations.borrowBuffer(plan.meshletPositionRefDeltaResource).has_value();
    const b8 meshletAttributeRefDeltas = context.declarations.borrowBuffer(plan.meshletAttributeRefDeltaResource).has_value();
    const b8 attributeSkins = context.declarations.borrowBuffer(plan.attributeSkinResource).has_value();
    const b8 skinInfluences = context.declarations.borrowBuffer(plan.skinResource).has_value();
    const b8 jointPalette = context.declarations.borrowBuffer(plan.jointPaletteResource).has_value();
    const Optional<mut ComputePipeline> skinningPipeline = context.declarations.borrowComputePipeline(plan.skinningPipeline);
    if(!bindlessResourceSlots || !skinnedPosition || !restPosition || !restNormal || !restTangent || !skinnedNormal || !skinnedTangent || !meshletDesc || !meshletPositionRefDeltas || !meshletAttributeRefDeltas
        || !attributeSkins || !skinInfluences || !jointPalette || !skinningPipeline.has_value())
        return false;

    BindSkinningComputePipeline(plan.skinningPipeline, skinningPipeline.value(), heap, commandList, inOutBoundPipeline);

    const MeshSkinningPushConstants pushConstants = MakeMeshSkinningPushConstants(plan.meshletCount, plan.skinCount, plan.jointCount, plan.skinningMode, plan.bindlessResourceSlots);
    commandList.setPushConstants(pushConstants);
    commandList.dispatch(pushConstants.meshletCount, 1u, 1u);

    return true;
}

b8 DispatchSkinningBoundsPlan(
    in MeshSkinningGraphDispatchPlan plan,
    in GpuTaskRecordContext context,
    mut GpuDescriptorHeap heap,
    mut CommandList commandList,
    mut GpuGraphPipelineId inOutBoundPipeline
){
    if(!plan.updatesMeshletBounds)
        return false;

    const b8 bindlessResourceSlots = context.declarations.borrowBuffer(plan.bindlessResourceSlotsResource).has_value();
    const b8 skinnedPosition = context.declarations.borrowBuffer(plan.skinnedPositionResource).has_value();
    const b8 meshletDesc = context.declarations.borrowBuffer(plan.meshletDescResource).has_value();
    const b8 meshletPositionRefDeltas = context.declarations.borrowBuffer(plan.meshletPositionRefDeltaResource).has_value();
    const b8 meshletLocalVertexRefs = context.declarations.borrowBuffer(plan.meshletLocalVertexRefResource).has_value();
    const b8 meshletPrimitiveIndices = context.declarations.borrowBuffer(plan.meshletPrimitiveIndexResource).has_value();
    const b8 meshletBounds = context.declarations.borrowBuffer(plan.meshletBoundsResource).has_value();
    const b8 meshletLocalBounds = context.declarations.borrowBuffer(plan.meshletLocalBoundsResource).has_value();
    const Optional<mut ComputePipeline> boundsPipeline = context.declarations.borrowComputePipeline(plan.boundsPipeline);
    if(!bindlessResourceSlots || !skinnedPosition || !meshletDesc || !meshletPositionRefDeltas || !meshletLocalVertexRefs || !meshletPrimitiveIndices || !meshletBounds || !meshletLocalBounds || !boundsPipeline.has_value())
        return false;

    BindSkinningComputePipeline(plan.boundsPipeline, boundsPipeline.value(), heap, commandList, inOutBoundPipeline);

    const MeshletBoundsPushConstants boundsPushConstants = MakeMeshletBoundsPushConstants(plan.meshletCount, plan.bindlessResourceSlots);
    commandList.setPushConstants(boundsPushConstants);
    commandList.dispatch(boundsPushConstants.meshletCount, 1u, 1u);
    return true;
}

b8 DispatchSkinningRepackPlan(
    in MeshSkinningGraphDispatchPlan plan,
    in GpuTaskRecordContext context,
    mut GpuDescriptorHeap heap,
    mut CommandList commandList,
    mut GpuGraphPipelineId inOutBoundPipeline
){
    const b8 skinnedNormal = context.declarations.borrowBuffer(plan.skinnedNormalResource).has_value();
    const b8 meshletAttributeRefDeltas = context.declarations.borrowBuffer(plan.meshletAttributeRefDeltaResource).has_value();
    const b8 attributeBuffer = context.declarations.borrowBuffer(plan.attributeResource).has_value();
    const Optional<mut ComputePipeline> repackPipeline = context.declarations.borrowComputePipeline(plan.repackPipeline);
    if(!skinnedNormal || !meshletAttributeRefDeltas || !attributeBuffer || !repackPipeline.has_value())
        return false;

    BindSkinningComputePipeline(plan.repackPipeline, repackPipeline.value(), heap, commandList, inOutBoundPipeline);

    const MeshletBoundsPushConstants boundsPushConstants = MakeMeshletBoundsPushConstants(plan.meshletCount, plan.bindlessResourceSlots);
    commandList.setPushConstants(boundsPushConstants);
    commandList.dispatch(boundsPushConstants.meshletCount, 1u, 1u);
    return true;
}

b8 MeshSkinningSystem::recordGraphOwnedSkinningDeformationBatch(in Span<MeshSkinningGraphDispatchPlan> plans, in GpuTaskRecordContext context, mut CommandList commandList){
    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized())
        return false;
    GpuGraphPipelineId boundPipeline;
    GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeMeshSkinning, device, commandList);
    for(in MeshSkinningGraphDispatchPlan plan : plans){
        if(!DispatchSkinningDeformationPlan(plan, context, heap, commandList, boundPipeline))
            return false;
    }
    return true;
}

b8 MeshSkinningSystem::recordGraphOwnedSkinningPostDispatchBatch(in Span<MeshSkinningGraphDispatchPlan> plans, in GpuTaskRecordContext context, mut CommandList commandList){
    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized())
        return false;
    mut GpuTimingRecorder gpuTiming = this.m_graphics.gpuTiming();
    GpuGraphPipelineId boundPipeline;
    b8 anyRepacksNormals = false;
    {
        GpuTimingMeasure timing(gpuTiming, s_TimingScopeMeshSkinningMeshletBounds, device, commandList);
        for(in MeshSkinningGraphDispatchPlan plan : plans){
            if(!DispatchSkinningBoundsPlan(plan, context, heap, commandList, boundPipeline))
                return false;
            if(plan.repacksNormals)
                anyRepacksNormals = true;
        }
    }
    if(anyRepacksNormals){
        GpuTimingMeasure timing(gpuTiming, s_TimingScopeMeshSkinningRepackNormals, device, commandList);
        for(in MeshSkinningGraphDispatchPlan plan : plans){
            if(plan.repacksNormals && !DispatchSkinningRepackPlan(plan, context, heap, commandList, boundPipeline))
                return false;
        }
    }
    return true;
}

void MeshSkinningSystem::confirmGraphOwnedSkinningDispatch(in MeshSkinningGraphDispatchPlan plan){
    const auto instance = this.m_runtimeMeshCache.editInstance(plan.handle);
    if(!instance.has_value())
        return;
    const auto foundResources = this.m_runtimeResources.find(plan.handle.value);
    if(foundResources == this.m_runtimeResources.end())
        return;
    ConfirmMeshSkinningInstanceDispatch(plan, instance.value(), foundResources.value());
}


