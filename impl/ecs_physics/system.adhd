    public EntityID entityForBody(in BodyId bodyId)const{
        if(!bodyId.valid() || !this.m_physicsWorld.isValidBody(bodyId))
            return s_InvalidEntityId;
        if(bodyId.index >= cast<u32>(this.m_bodyIndexToEntity.size()))
            return s_InvalidEntityId;
        in EcsSlotOwner owner = this.m_bodyIndexToEntity[bodyId.index];
        if(!owner.entity.valid() || owner.generation != bodyId.generation)
            return s_InvalidEntityId;
        return owner.entity;
    }

    public EntityID entityForShape(in ShapeId shapeId)const{
        if(!shapeId.valid() || !this.m_physicsWorld.isValidShape(shapeId))
            return s_InvalidEntityId;
        if(shapeId.index >= cast<u32>(this.m_shapeIndexToEntity.size()))
            return s_InvalidEntityId;
        in EcsSlotOwner owner = this.m_shapeIndexToEntity[shapeId.index];
        if(!owner.entity.valid() || owner.generation != shapeId.generation)
            return s_InvalidEntityId;
        return owner.entity;
    }

    public EntityID entityForJoint(in JointId jointId)const{
        if(!jointId.valid())
            return s_InvalidEntityId;
        if(jointId.index >= cast<u32>(this.m_jointIndexToEntity.size()))
            return s_InvalidEntityId;
        in EcsSlotOwner owner = this.m_jointIndexToEntity[jointId.index];
        if(!owner.entity.valid() || owner.generation != jointId.generation)
            return s_InvalidEntityId;
        return owner.entity;
    }

    public EntityID entityForBodyIncludingDestroyed(in BodyId bodyId)const{
        const EntityID alive = this.entityForBody(bodyId);
        if(alive.valid())
            return alive;
        if(!bodyId.valid() || this.m_syncScratch.destroyedBodyOwners.empty())
            return s_InvalidEntityId;
        const auto found = this.m_syncScratch.destroyedBodyOwners.find(PackEcsSlotKey(bodyId.index, bodyId.generation));
        if(found == this.m_syncScratch.destroyedBodyOwners.end())
            return s_InvalidEntityId;
        return found.value();
    }

    public EntityID entityForShapeIncludingDestroyed(in ShapeId shapeId)const{
        const EntityID alive = this.entityForShape(shapeId);
        if(alive.valid())
            return alive;
        if(!shapeId.valid() || this.m_syncScratch.destroyedShapeOwners.empty())
            return s_InvalidEntityId;
        const auto found = this.m_syncScratch.destroyedShapeOwners.find(PackEcsSlotKey(shapeId.index, shapeId.generation));
        if(found == this.m_syncScratch.destroyedShapeOwners.end())
            return s_InvalidEntityId;
        return found.value();
    }

    public EntityID entityForJointIncludingDestroyed(in JointId jointId)const{
        const EntityID alive = this.entityForJoint(jointId);
        if(alive.valid())
            return alive;
        if(!jointId.valid() || this.m_syncScratch.destroyedJointOwners.empty())
            return s_InvalidEntityId;
        const auto found = this.m_syncScratch.destroyedJointOwners.find(PackEcsSlotKey(jointId.index, jointId.generation));
        if(found == this.m_syncScratch.destroyedJointOwners.end())
            return s_InvalidEntityId;
        return found.value();
    }

    public BodyId bodyForEntity(in EntityID entity)const{
        if(!entity.valid())
            return BodyId();
        const auto found = this.m_entityRecords.find(entity);
        if(found == this.m_entityRecords.end())
            return BodyId();
        const BodyId bodyId = found.value().bodyId;
        if(!bodyId.valid() || !this.m_physicsWorld.isValidBody(bodyId))
            return BodyId();
        return bodyId;
    }

    public void shapesForEntity(in EntityID entity, mut Vector<ShapeId> outShapes)const{
        outShapes.clear();
        if(!entity.valid())
            return;
        const auto found = this.m_entityRecords.find(entity);
        if(found == this.m_entityRecords.end())
            return;
        const ShapeId primaryId = found.value().primaryShapeId;
        if(primaryId.valid() && this.m_physicsWorld.isValidShape(primaryId))
            outShapes.push_back(primaryId);
        for(usize i = 0u; i < found.value().extraShapeIds.size(); ++i){
            const ShapeId extraId = found.value().extraShapeIds[i];
            if(extraId.valid() && this.m_physicsWorld.isValidShape(extraId))
                outShapes.push_back(extraId);
        }
    }

    public JointId jointForEntity(in EntityID entity)const{
        if(!entity.valid())
            return JointId();
        const auto found = this.m_entityJoints.find(entity);
        if(found == this.m_entityJoints.end())
            return JointId();
        const JointId jId = found.value().jointId;
        if(!jId.valid() || !this.m_physicsWorld.isValidJoint(jId))
            return JointId();
        return jId;
    }

    public void jointsForEntity(in EntityID entity, mut Vector<JointId> outJoints)const{
        outJoints.clear();
        if(!entity.valid())
            return;
        const auto found = this.m_entityJoints.find(entity);
        if(found == this.m_entityJoints.end())
            return;
        const EcsJointSyncRecord jRec = found.value();
        if(jRec.jointId.valid() && this.m_physicsWorld.isValidJoint(jRec.jointId))
            outJoints.push_back(jRec.jointId);
        for(usize i = 0u; i < jRec.extraJointIds.size(); ++i){
            const JointId extraId = jRec.extraJointIds[i];
            if(extraId.valid() && this.m_physicsWorld.isValidJoint(extraId))
                outJoints.push_back(extraId);
        }
    }

    public Expected<Transform3D> tryGetInterpolatedTransform(in EntityID entity)const{
        if(!entity.valid())
            return MakeUnexpected(Failure());
        const auto found = this.m_entityRecords.find(entity);
        if(found == this.m_entityRecords.end())
            return MakeUnexpected(Failure());
        const BodyId bodyId = found.value().bodyId;
        if(!bodyId.valid())
            return MakeUnexpected(Failure());
        if(bodyId.index < cast<u32>(this.m_bodyTransformSnapshots.size()) && bodyId.index < cast<u32>(this.m_bodyTransformSnapshotMeta.size())){
            if(EcsSnapshotMetaMatches(this.m_bodyTransformSnapshotMeta[bodyId.index], bodyId.generation)){
                in EcsBodyTransformSnapshot snap = this.m_bodyTransformSnapshots[bodyId.index];
                const f32 alpha = Clamp(this.m_interpolationAlpha, 0.0f, 1.0f);
                VectorSingle q0 = SafeNormalizeQuat(VectorSingle(snap.prevTransform.rotation));
                VectorSingle q1 = SafeNormalizeQuat(VectorSingle(snap.currTransform.rotation));
                if(Vector4Dot(q0, q1).x < 0.0f)
                    q1 = -q1;
                const VectorSingle tVec(alpha);
                const VectorSingle pos = Lerp(VectorSingle(snap.prevTransform.position), VectorSingle(snap.currTransform.position), tVec);
                const VectorSingle rot = SafeNormalizeQuat(Lerp(q0, q1, tVec));
                return Transform3D(pos, rot);
            }
        }
        return this.m_physicsWorld.tryGetBodyTransform(bodyId);
    }

    public Transform3D tryGetInterpolatedBodyTransform(in u32 bodyIdx, in u16 bodyGen)const{
        if(cast<usize>(bodyIdx) >= this.m_physicsWorld.m_bodies.size())
            return Transform3D();
        in Body body = this.m_physicsWorld.m_bodies[bodyIdx];
        if(
            !body.alive
            || body.generation != bodyGen
            || body.setIndex >= this.m_physicsWorld.m_solverSets.size()
            || body.localIndex >= this.m_physicsWorld.m_solverSets[body.setIndex].sims.size()
        )
            return Transform3D();
        in Transform3D physicsXf = this.m_physicsWorld.m_solverSets[body.setIndex].sims[body.localIndex].transform;
        if(
            this.m_interpolationAlpha < 1.0f - 1.0e-6f
            && bodyIdx < cast<u32>(this.m_bodyTransformSnapshots.size())
            && bodyIdx < cast<u32>(this.m_bodyTransformSnapshotMeta.size())
            && EcsSnapshotMetaMatches(this.m_bodyTransformSnapshotMeta[bodyIdx], bodyGen)
        ){
            in EcsBodyTransformSnapshot snap = this.m_bodyTransformSnapshots[bodyIdx];
            const f32 alpha = Clamp(this.m_interpolationAlpha, 0.0f, 1.0f);
            VectorSingle q0 = SafeNormalizeQuat(VectorSingle(snap.prevTransform.rotation));
            VectorSingle q1 = SafeNormalizeQuat(VectorSingle(snap.currTransform.rotation));
            if(Vector4Dot(q0, q1).x < 0.0f)
                q1 = -q1;
            const VectorSingle tVec(alpha);
            const VectorSingle pos = Lerp(VectorSingle(snap.prevTransform.position), VectorSingle(snap.currTransform.position), tVec);
            const VectorSingle rot = SafeNormalizeQuat(Lerp(q0, q1, tVec));
            return Transform3D(pos, rot);
        }
        return physicsXf;
    }

    public Expected<Transform3D> tryGetInterpolatedCharacterTransform(in EntityID entity)const{
        if(!entity.valid())
            return MakeUnexpected(Failure());
        const auto found = this.m_syncScratch.characterSyncStates.find(entity);
        if(found == this.m_syncScratch.characterSyncStates.end())
            return MakeUnexpected(Failure());
        const EcsCharacterControllerSyncState st = found.value();
        if(!st.hasPrevSnapshot)
            return MakeUnexpected(Failure());
        const Transform3D prevXf(VectorSingle(st.prevPosition), VectorSingle(st.prevRotation));
        const Transform3D currXf(VectorSingle(st.currPosition), VectorSingle(st.currRotation));
        return InterpolatePhysicsTransform(prevXf, currXf, this.m_interpolationAlpha);
    }

    public Expected<Transform3D> tryGetInterpolatedArticulationBaseTransform(in EntityID entity)const{
        if(!entity.valid())
            return MakeUnexpected(Failure());
        const auto found = this.m_syncScratch.articulationLiveStates.find(entity);
        if(found == this.m_syncScratch.articulationLiveStates.end())
            return MakeUnexpected(Failure());
        const EcsArticulationLiveState st = found.value();
        if(!st.hasPrevPoseSnapshot)
            return MakeUnexpected(Failure());
        return InterpolatePhysicsTransform(st.prevBaseTransform, st.currBaseTransform, this.m_interpolationAlpha);
    }

    public Expected<Transform3D> tryGetInterpolatedArticulationLinkTransform(in EntityID entity, in usize linkIndex)const{
        if(!entity.valid())
            return MakeUnexpected(Failure());
        const auto found = this.m_syncScratch.articulationLiveStates.find(entity);
        if(found == this.m_syncScratch.articulationLiveStates.end())
            return MakeUnexpected(Failure());
        const EcsArticulationLiveState st = found.value();
        if(!st.hasPrevPoseSnapshot || linkIndex >= st.prevLinkWorldTransforms.size() || linkIndex >= st.currLinkWorldTransforms.size())
            return MakeUnexpected(Failure());
        return InterpolatePhysicsTransform(st.prevLinkWorldTransforms[linkIndex], st.currLinkWorldTransforms[linkIndex], this.m_interpolationAlpha);
    }

    public void registerNamedEntity(in Name tag, in EntityID entity){
        if(tag != s_NameNone && entity.valid()){
            this.m_scopedNames.globalNames.insert_or_assign(tag, entity);
            const auto scopeIt = this.m_scopedNames.entityToScope.find(entity);
            if(scopeIt != this.m_scopedNames.entityToScope.end() && scopeIt.value() < cast<u32>(this.m_scopedNames.scopes.size()))
                this.m_scopedNames.scopes[scopeIt.value()].insert_or_assign(tag, entity);
            this.m_syncScratch.manualNamedEntities.insert_or_assign(tag, entity);
            this.m_syncScratch.manualNamedEntitiesDirty = true;
            ++this.m_syncScratch.namedEntitiesVersion;
        }
    }

    public void unregisterNamedEntity(in Name tag){
        if(tag != s_NameNone){
            this.m_scopedNames.globalNames.erase(tag);
            const auto manualIt = this.m_syncScratch.manualNamedEntities.find(tag);
            if(manualIt != this.m_syncScratch.manualNamedEntities.end()){
                const auto scopeIt = this.m_scopedNames.entityToScope.find(manualIt.value());
                if(scopeIt != this.m_scopedNames.entityToScope.end() && scopeIt.value() < cast<u32>(this.m_scopedNames.scopes.size())){
                    mut HashMap<Name, EntityID> scopeMap = this.m_scopedNames.scopes[scopeIt.value()];
                    const auto sIt = scopeMap.find(tag);
                    if(sIt != scopeMap.end() && sIt.value() == manualIt.value())
                        scopeMap.erase(tag);
                }
            }
            this.m_syncScratch.manualNamedEntities.erase(tag);
            this.m_syncScratch.manualNamedEntitiesDirty = true;
            ++this.m_syncScratch.namedEntitiesVersion;
        }
    }

    public EntityID findNamedEntity(in Name tag)const{
        if(tag == s_NameNone)
            return s_InvalidEntityId;
        const auto found = this.m_scopedNames.globalNames.find(tag);
        if(found == this.m_scopedNames.globalNames.end())
            return s_InvalidEntityId;
        return found.value();
    }

    public EntityID findNamedEntity(in EntityID requester, in Name tag)const{
        return ResolveEcsScopedEntityName(this.m_scopedNames, requester, tag);
    }

    public u32 allocateEntityNameScope(){
        const u32 scopeId = cast<u32>(this.m_scopedNames.scopes.size());
        this.m_scopedNames.scopes.push_back(HashMap<Name, EntityID>());
        return scopeId;
    }

    public void assignEntityToNameScope(in EntityID entity, in u32 scopeId){
        if(!entity.valid() || scopeId >= cast<u32>(this.m_scopedNames.scopes.size()))
            return;
        this.m_scopedNames.entityToScope.insert_or_assign(entity, scopeId);
        this.m_syncScratch.manualNamedEntitiesDirty = true;
        ++this.m_syncScratch.namedEntitiesVersion;
    }

    public void registerScopedNamedEntity(in u32 scopeId, in Name tag, in EntityID entity){
        if(scopeId >= cast<u32>(this.m_scopedNames.scopes.size()) || tag == s_NameNone || !entity.valid())
            return;
        this.m_scopedNames.scopes[scopeId].insert_or_assign(tag, entity);
        this.m_scopedNames.entityToScope.insert_or_assign(entity, scopeId);
        this.m_syncScratch.manualNamedEntitiesDirty = true;
        ++this.m_syncScratch.namedEntitiesVersion;
    }

    public void registerNamedSceneEntities(in InstantiatedSceneEntities sceneEntities){
        const u32 scopeId = this.allocateEntityNameScope();
        mut HashMap<Name, EntityID> scopeMap = this.m_scopedNames.scopes[scopeId];
        for(usize i = 0u; i < sceneEntities.entities.size(); ++i){
            const EntityID ent = sceneEntities.entities[i];
            if(ent.valid())
                this.m_scopedNames.entityToScope.insert_or_assign(ent, scopeId);
        }
        for(in auto kv : sceneEntities.namedEntities){
            if(kv.first != s_NameNone && kv.second.valid()){
                scopeMap.insert_or_assign(kv.first, kv.second);
                this.m_scopedNames.entityToScope.insert_or_assign(kv.second, scopeId);
                this.m_scopedNames.globalNames.insert_or_assign(kv.first, kv.second);
                this.m_syncScratch.manualNamedEntities.insert_or_assign(kv.first, kv.second);
            }
        }
        this.m_syncScratch.manualNamedEntitiesDirty = true;
        ++this.m_syncScratch.namedEntitiesVersion;
    }

    private void resolveIgnoreEntityTarget(in EntityID ignoreEntity, mut BodyId outBodyId, mut ShapeId outShapeId)const{
        outBodyId = BodyId();
        outShapeId = ShapeId();
        if(!ignoreEntity.valid())
            return;
        const auto recIt = this.m_entityRecords.find(ignoreEntity);
        if(recIt == this.m_entityRecords.end())
            return;
        const EcsEntityPhysicsRecord rec = recIt.value();
        if(!rec.attachedToParentBody){
            if(rec.bodyId.valid() && this.m_physicsWorld.isValidBody(rec.bodyId))
                outBodyId = rec.bodyId;
            return;
        }
        if(rec.primaryShapeId.valid() && this.m_physicsWorld.isValidShape(rec.primaryShapeId))
            outShapeId = rec.primaryShapeId;
    }

    private void collectEcsRayHits(in Vector<RayCastHit> rawHits, mut Vector<EcsRayCastHit> outHits)const{
        outHits.clear();
        outHits.reserve(rawHits.size());
        for(usize i = 0u; i < rawHits.size(); ++i){
            EcsRayCastHit entry;
            entry.hit = rawHits[i];
            if(rawHits[i].hit)
                entry.entity = this.entityForShape(rawHits[i].shapeId);
            outHits.push_back(entry);
        }
    }

    private void collectEcsOverlapHits(in Vector<ShapeOverlapHit> rawHits, mut Vector<EcsShapeOverlapHit> outHits)const{
        outHits.clear();
        outHits.reserve(rawHits.size());
        for(usize i = 0u; i < rawHits.size(); ++i){
            EcsShapeOverlapHit entry;
            entry.hit = rawHits[i];
            entry.entity = this.entityForShape(rawHits[i].shapeId);
            outHits.push_back(entry);
        }
    }

    private void collectEcsShapeCastHits(in Vector<ShapeCastHit> rawHits, mut Vector<EcsShapeCastHit> outHits)const{
        outHits.clear();
