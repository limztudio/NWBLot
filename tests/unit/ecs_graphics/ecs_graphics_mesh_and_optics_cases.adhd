#define EXPECT_FALSE(...) native{ EXPECT_FALSE(...) }
#define EXPECT_EQ(...) native{ EXPECT_EQ(...) }

b8 EcsGraphicsMeshAndOpticsCasesReady(in u64 value){
    return value != 0u;
}

native{
#include <tests/unit/ecs_graphics/suite.adhd.h>


#include <impl/ecs_render/mesh/mesh_system.adhd.h>
