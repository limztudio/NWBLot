#include <tests/common/gtest_macros.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <global/floating_point_environment.h>
#include <global/simdmath.h>
#include <tests/common/floating_point_environment_guard.adhd.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace Tests::MathCases{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


TEST(MathInteger, WideningProductsRetainHighBitsWithoutEvaluatingNanEncodings){
#pragma STDC FENV_ACCESS ON
    const auto environment = HoldFloatingPointExceptions();
    ASSERT_TRUE(environment);
    ::NWB::Tests::FloatingPointEnvironmentGuard restore(*environment);
    Array<volatile u32, 4> first = { 0xffffffffu, 0x7f800123u, 0x80000000u, 0x00010001u };
    Array<volatile u32, 4> second = { 0xffffffffu, 0xffffffffu, 0x80000000u, 0x00010001u };
    const SIMDVectorSingle a = VectorSetInt(first[0], first[1], first[2], first[3]);
    const SIMDVectorSingle b = VectorSetInt(second[0], second[1], second[2], second[3]);
    ASSERT_TRUE(ClearFloatingPointExceptions(FE_ALL_EXCEPT));
    ASSERT_TRUE(RaiseFloatingPointExceptions(FE_DIVBYZERO));
    const i32 before = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    const SIMDVectorDouble products = VectorMultiplyUInt32Wide(a, b);
    EXPECT_EQ(TestFloatingPointExceptions(FE_ALL_EXCEPT), before);
    for(usize lane = 0u; lane < 4u; ++lane)
        EXPECT_EQ(VectorDoubleGetIntByIndex(products, lane), static_cast<u64>(first[lane]) * static_cast<u64>(second[lane]));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

