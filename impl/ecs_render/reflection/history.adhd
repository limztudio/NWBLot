#include <impl/ecs_render/reflection/feedback_planning.adhd>
#include <impl/ecs_render/reflection/history_planning.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ReflectionHistoryState : NoCopy{
    private ReflectionSceneContentStamp m_stamp;
    private ReflectionSettings m_settings;
    private u64 m_generation = 1u;
    private u64 m_nextSequence = 1u;
    private u64 m_acceptedSequence = 0u;
    private u64 m_reservedSequence = 0u;
    private u64 m_epoch = 0u;
    private u64 m_historyStartGraphicsFrame = 0u;
    private u32 m_nextSampleIndex = 0u;
    private u32 m_sampleCount = 0u;
    private u32 m_acceptedBank = 0u;
    private Futex m_mutex;
    private u16 m_deviceGeneration;
    private b8 m_eligible = false;
    private b8 m_hardwareReady = false;
    private b8 m_resourcesChanged = false;

    public ReflectionHistoryState(in u16 deviceGeneration){ this.m_deviceGeneration = deviceGeneration; }

    public void reset(in u16 deviceGeneration){
        const FutexGuard guard = AcquireFutex(this.m_mutex);

        ++this.m_generation;
        this.m_deviceGeneration = deviceGeneration;
        this.m_acceptedSequence = 0u;
        this.m_reservedSequence = 0u;
        this.m_nextSampleIndex = 0u;
        this.m_sampleCount = 0u;
        this.m_acceptedBank = 0u;
        this.m_eligible = false;
        this.m_hardwareReady = false;
        this.m_resourcesChanged = true;
    }
    public ReflectionHistoryPlan plan(in ReflectionSceneContentStamp stamp, in ReflectionSettings settings, in u64 graphicsFrameIndex){
        const FutexGuard guard = AcquireFutex(this.m_mutex);

        const u64 sequence = this.m_nextSequence;
        ++this.m_nextSequence;
        return ResolveReflectionHistoryPlan(
            stamp,
            settings,
            graphicsFrameIndex,
            this.m_stamp,
            this.m_settings,
            this.m_generation,
            sequence,
            this.m_acceptedSequence,
            this.m_epoch,
            this.m_historyStartGraphicsFrame,
            this.m_nextSampleIndex,
            this.m_sampleCount,
            this.m_acceptedBank,
            this.m_eligible,
            this.m_hardwareReady,
            this.m_resourcesChanged
        );
    }
    public b8 reserve(in ReflectionHistoryPlan plan){
        const FutexGuard guard = AcquireFutex(this.m_mutex);

        if(!CanReserveReflectionHistoryPlan(this.m_deviceGeneration, this.m_reservedSequence, this.m_generation, this.m_acceptedSequence, plan))
            return false;
        this.m_reservedSequence = plan.sequence;
        return true;
    }
    public void discard(in ReflectionHistoryPlan plan){
        const FutexGuard guard = AcquireFutex(this.m_mutex);

        if(plan.generation == this.m_generation && plan.sequence == this.m_reservedSequence)
            this.m_reservedSequence = 0u;
    }
    public void accept(in ReflectionHistoryPlan plan, in QueueSubmissionToken token, in b8 hardwareReady){
        const FutexGuard guard = AcquireFutex(this.m_mutex);

        if(plan.generation != this.m_generation || plan.sequence != this.m_reservedSequence)
            return;
        if(!IsValidAcceptedReflectionHistoryToken(token, this.m_deviceGeneration))
            return;
        ApplyAcceptedReflectionHistoryPlan(
            plan,
            hardwareReady,
            this.m_stamp,
            this.m_settings,
            this.m_acceptedSequence,
            this.m_reservedSequence,
            this.m_epoch,
            this.m_historyStartGraphicsFrame,
            this.m_nextSampleIndex,
            this.m_sampleCount,
            this.m_acceptedBank,
            this.m_eligible,
            this.m_hardwareReady,
            this.m_resourcesChanged
        );
    }
}

type ReflectionHistoryControlHandle = Shared<ReflectionHistoryState>;

class ReflectionHistoryReservation : MoveOnly{
    private PlanReservation<ReflectionHistoryControlHandle, ReflectionHistoryPlan> m_lease;

    public ReflectionHistoryReservation(in ReflectionHistoryControlHandle control, in ReflectionHistoryPlan plan){
        this.m_lease = PlanReservation<ReflectionHistoryControlHandle, ReflectionHistoryPlan>(control, plan);
    }

    public b8 valid()const{ return this.m_lease.valid(); }
    public void discard(){ this.m_lease.discard(); }

    public void accept(in QueueSubmissionToken token, in b8 hardwareReady){
        if(!this.m_lease.valid())
            return;
        const ReflectionHistoryControlHandle control = this.m_lease.control();
        control.deref().accept(this.m_lease.plan(), token, hardwareReady);
        this.m_lease.release();
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

