    Array<CrashChar, s_CrashMaxShortText> protectedPendingPackageName;
};

[cpp_header("<core/crash/internal.h>"), cpp_name("::NWB::Core::Crash::CrashDetail::CrashState")]
extern class CrashRuntimeState{
    Futex mutex;
    Array<CrashMetadata, s_CrashMaxMetadata> metadata;
    TestAtomic<u64> crashSequence;
    TestAtomic<u32> suppressedPlatformCrashCaptures;
    TestAtomic<u32> transportInFlight;
    b8 installed;
    b8 handlerStarted;
    b8 platformRestorePending;
};

