void VerifyTextInputText_ValidatesStrictUtf8AndEmbeddedNul(){
    EXPECT_EQ(ValidateTextInputUtf8(StringView(), 100u), TextInputAdmission::Accepted);
    EXPECT_EQ(ValidateTextInputUtf8("\xC0\x80", 100u), TextInputAdmission::InvalidText);
    EXPECT_EQ(ValidateTextInputUtf8("\xE0\x80\x80", 100u), TextInputAdmission::InvalidText);
    EXPECT_EQ(ValidateTextInputUtf8("\xED\xA0\x80", 100u), TextInputAdmission::InvalidText);
    EXPECT_EQ(ValidateTextInputUtf8("\xF4\x90\x80\x80", 100u), TextInputAdmission::InvalidText);
    EXPECT_EQ(ValidateTextInputUtf8("\xF0\x9F", 100u), TextInputAdmission::InvalidText);
    EXPECT_EQ(ValidateTextInputUtf8("\x80", 100u), TextInputAdmission::InvalidText);
    EXPECT_EQ(ValidateTextInputUtf8(StringView("a\0b", 3u), 100u), TextInputAdmission::InvalidText);
    EXPECT_EQ(ValidateTextInputUtf8("four", 3u), TextInputAdmission::TooLarge);
}

void VerifyTextInputText_BoundariesUseBytesForBmpAndSupplementaryScalars(){
    const StringView text = "A\xED\x95\x9C\xF0\x9F\x98\x80";
    FixedVector<usize, 4> validIndices = FixedVector<usize, 4>();
    validIndices.push_back(0u);
    validIndices.push_back(1u);
    validIndices.push_back(4u);
    validIndices.push_back(8u);
    for(in usize index : validIndices){
        EXPECT_TRUE(IsUtf8ScalarBoundary(text, index));
    }

    FixedVector<usize, 6> invalidIndices = FixedVector<usize, 6>();
    invalidIndices.push_back(2u);
    invalidIndices.push_back(3u);
    invalidIndices.push_back(5u);
    invalidIndices.push_back(6u);
    invalidIndices.push_back(7u);
    invalidIndices.push_back(9u);
    for(in usize index : invalidIndices){
        EXPECT_FALSE(IsUtf8ScalarBoundary(text, index));
    }
}

void VerifyTextInputText_CaretBoundsRejectEmptyAndOverflowWhileAllowingClippedOrigins(){
    EXPECT_TRUE(IsTextInputCaretRectValid(MakeTextInputRect(-20, -10, 2, 20)));
    EXPECT_TRUE(IsTextInputCaretRectValid(MakeTextInputRect(i32.max - 1, i32.max - 1, 1, 1)));
    EXPECT_FALSE(IsTextInputCaretRectValid(MakeTextInputRect(0, 0, 0, 1)));
    EXPECT_FALSE(IsTextInputCaretRectValid(MakeTextInputRect(0, 0, 1, -1)));
    EXPECT_FALSE(IsTextInputCaretRectValid(MakeTextInputRect(i32.max, 0, 1, 1)));
    EXPECT_FALSE(IsTextInputCaretRectValid(MakeTextInputRect(0, i32.max - 10, 1, 11)));
}

void VerifyTextInputText_RejectsInvalidScalarsWithoutPublishingAnEncodedLength(){
    EncodedCodePointBuffer buffer = EncodedCodePointBuffer();
    const Expected<usize, TextInputAdmissionEnum> length = buffer.encode(0x1f600u);
    ASSERT_TRUE(length.has_value());
    EXPECT_EQ(buffer.view(length.value()), "\xF0\x9F\x98\x80");
    const Expected<usize, TextInputAdmissionEnum> invalid0 = buffer.encode(0u);
    ASSERT_FALSE(invalid0.has_value());
    EXPECT_EQ(invalid0.error(), TextInputAdmission::InvalidText);
    const Expected<usize, TextInputAdmissionEnum> invalidd800 = buffer.encode(0xd800u);
    ASSERT_FALSE(invalidd800.has_value());
    EXPECT_EQ(invalidd800.error(), TextInputAdmission::InvalidText);
    const Expected<usize, TextInputAdmissionEnum> invalid110000 = buffer.encode(0x110000u);
    ASSERT_FALSE(invalid110000.has_value());
    EXPECT_EQ(invalid110000.error(), TextInputAdmission::InvalidText);
}


