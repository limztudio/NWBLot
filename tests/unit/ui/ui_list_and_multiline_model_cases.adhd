const StringView s_UiListCasePanelKey = "panel";
const StringView s_UiListCaseListKey = "list";
const StringView s_UiListCaseRowsKey = "rows";
const StringView s_UiListCaseFirstRowText = "Ax";
const StringView s_UiMultilineLineSeparator = "\xE2\x80\xA8";
const StringView s_UiMultilineParagraphSeparator = "\xE2\x80\xA9";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> ListMutationKind{ None, TextSelect, KeySelect, EnabledScroll, RevisionScroll }
type MultilineCommandTests = MultilineFixture;
type MultilineCompositionTests = MultilineFixture;
type MultilineModelTests = MultilineFixture;

class ListLoanCallbackSource : IListDataSource{
    public mut ListState m_state;
    public TestObserved<ListMutationKind> m_kind = TestObserved<ListMutationKind>(ListMutationKind::None);
    public u64 m_key = 8u;
    public TestObserved<u64> m_mutations;

    public ListLoanCallbackSource(mut ListState state){ this.m_state = state; }
    public u64 instanceGeneration()const override{ return 91u; }
    public u64 revision()const override{ this.mutate(ListMutationKind::RevisionScroll); return 1u; }
    public u64 rowCount()const override{ return 50u; }
    public u64 key(in u64 index)const override{
        this.mutate(ListMutationKind::KeySelect);
        if(index < 50u)
            return index + 1u;
        return 0u;
    }
    public Expected<u64> indexOf(in u64 keyValue)const override{
        u64 index = 0u;
        if(keyValue == 0u || keyValue > 50u)
            return MakeUnexpected(Failure());
        index = keyValue - 1u;
        return index;
    }
    public Expected<u64> findEnabled(in u64 start, in b8 arg1)const override{
        u64 index = 0u;
        if(start >= 50u)
            return MakeUnexpected(Failure());
        index = start;
        return index;
    }
    public StringView text(in u64 arg0)const override{
        this.mutate(ListMutationKind::TextSelect);
        return "row";
    }
    public b8 enabled(in u64 index)const override{
        this.mutate(ListMutationKind::EnabledScroll);
        return index < 50u;
    }
    public void arm(in ListMutationKind kind){ this.arm(kind, 8u); }
    public void arm(in ListMutationKind kind, in u64 keyValue){
        this.m_kind.value() = kind;
        this.m_key = keyValue;
    }
    public u64 mutations()const{ return this.m_mutations.value(); }
    public void mutate(in ListMutationKind kind)const{
        if(this.m_kind.value() != kind)
            return;
        this.m_kind.value() = ListMutationKind::None;
        ++this.m_mutations.value();
        if(kind == ListMutationKind::EnabledScroll || kind == ListMutationKind::RevisionScroll){
            EXPECT_TRUE(this.m_state.scrollTo(64.0));
        }
        else
            this.m_state.select(this.m_key);
    }
}


class UiListLoanTests : WidgetFixture{
    public ListState m_state;
    public ListLoanCallbackSource m_source;

    public UiListLoanTests(){ this.m_source = ListLoanCallbackSource(this.m_state); }
    public b8 declareList(in u64 generation){
        if(!this.begin(generation) || !this.m_builder.beginPanel("panel", Rect(10.0f, 10.0f, 320.0f, 240.0f)))
            return false;
        ListOptions options;
        options.width = LayoutSize(LayoutSizePolicy::Fixed, 280.0f);
        options.height = LayoutSize(LayoutSizePolicy::Fixed, 120.0f);
        return this.m_builder.virtualList("list", this.m_source, this.m_state, options).valid;
    }
    public b8 acceptFirst(){
        return this.declareList(1u) && this.finishPanel() && this.m_context.commitFrame(1u);
    }
    public WidgetId firstRow()const{
        return RequireUiWidgetPartId(RequireUiWidgetId(this.id("list", "panel"), "rows"), 1u);
    }
    public UiFixtureAcceptedInputState<16u> accepted()const{ return CaptureAcceptedInput<16u>(this.m_context.input()); }
}

void CopyUiListBuilderStyles(mut Builder source, mut Builder destination){
    destination.style() = source.style();
    destination.listStyle() = source.listStyle();
}
void SetUiListBuilderRowStyle(mut Builder builder, in SelectableStyle row){ builder.listStyle().row = row; }
StringView MakeUiMultilineByteView(in Span<u8> bytes){
    return ReadBinaryTextSlice(bytes, 0u, cast<isize>(bytes.size())).value();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


ShapeRequest MakeUiListLanguageShapeRequest(in StringView text, in StringView language, in f32 fontSize){
    ShapeRequest request = ShapeRequest();
    request.text = text;
    request.language = language;
    request.fontSize = fontSize;
    return request;
}

EditCommandRequest MakeUiMultilineCommand(in EditCommand command){
    EditCommandRequest request = EditCommandRequest();
    request.command = command;
    return request;
}


