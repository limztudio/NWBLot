const Name s_MeshEmulationVsDebugName = "ECSRender_MeshEmulationVS";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsCsgReceiverSurfacePassActive(in b8 csgClipActive, in MaterialPipelinePass pass){
    return csgClipActive && (pass == MaterialPipelinePass::Opaque || pass == MaterialPipelinePass::CsgReceiverSurface);
}

MaterialPipelineKey BuildMaterialPassPipelineKey(
    in Name materialName,
    in MaterialFramebufferInfo framebufferInfo,
    in MaterialPipelinePass pass,
    in b8 materialTwoSided,
    in b8 csgClipActive,
    in Name csgEvaluatorVariant,
    in u64 csgShapeRegistryRevision
){
    MaterialPipelineKey key;
    key.material = materialName;
    key.framebufferInfo = framebufferInfo;
    key.pass = pass;
    key.twoSided = materialTwoSided;
    if(csgClipActive){
        key.csgMode = MaterialPipelineCsgMode::ClipOnly;
        key.csgEvaluatorVariant = csgEvaluatorVariant;
        key.csgShapeRegistryRevision = csgShapeRegistryRevision;
        key.twoSided = true;
    }
    return key;
}

b8 ValidateInstanceBufferAddressableCapacity(in usize capacity, in usize instanceStrideBytes){
    if(capacity <= usize.max / instanceStrideBytes)
        return true;

    error("RendererSystem: instance buffer capacity overflows addressable memory");
    return false;
}

Expected<usize> ValidateAndAlignMaterialTypedByteRequest(in usize byteCount, in usize wordByteSize){
    usize requiredByteCount = Max(byteCount, wordByteSize);
    auto alignedByteCount = AlignUpChecked(requiredByteCount, wordByteSize);
    if(!alignedByteCount.has_value()){
        error("RendererSystem: material typed buffer request overflows alignment");
        return MakeUnexpected(Failure());
    }
    if(alignedByteCount.value() > cast<usize>(u32.max)){
        error("RendererSystem: material typed buffer request exceeds u32 byte-offset limits");
        return MakeUnexpected(Failure());
    }
    return alignedByteCount.value();
}

void LogMeshSystemNotRegisteredForMaterialPass(){
    error("RendererSystem: MeshSystem is not registered; material pass cannot resolve meshes");
}

MaterialPassPipelineResourceSnapshot CaptureMaterialPassPipelineResourceSnapshot(in MaterialPipelineResources pipelineResources){
    MaterialPassPipelineResourceSnapshot snapshot;
    snapshot.indexedPipeline = pipelineResources.indexedPipeline;
    snapshot.emulationPipeline = pipelineResources.emulationPipeline;
    snapshot.meshletPipeline = pipelineResources.meshletPipeline;
    snapshot.computePipeline = pipelineResources.computePipeline;
    snapshot.objectGeometryDecodePipeline = pipelineResources.objectGeometryDecodePipeline;
    snapshot.sharedGeometryComputeProgram = pipelineResources.sharedGeometryComputeProgram;
    snapshot.indexedGeometryOutput = pipelineResources.indexedGeometryOutput;
    return snapshot;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


MaterialPassMeshResourceSnapshot CaptureMaterialMeshResourceSnapshot(in MeshResources mesh){
    MaterialPassMeshResourceSnapshot snapshot;
    snapshot.sourceBuffers = mesh.buffers;
    snapshot.geometryHeapHandles = mesh.geometryHeapHandles;
    snapshot.emulationVertexBuffer = mesh.emulationVertexBuffer;
    snapshot.objectGeometryCache = CaptureObjectGeometryCache(mesh);
    snapshot.emulationVertexHeapHandle = mesh.emulationVertexHeapHandle;
    snapshot.emulationIndexByteOffset = mesh.emulationIndexByteOffset;
    snapshot.meshletCount = mesh.meshletCount;
    snapshot.meshletPrimitiveIndexCount = mesh.meshletPrimitiveIndexCount;
    snapshot.runtimeMesh = mesh.runtimeMesh;
    snapshot.dynamicMeshletBoundsFresh = mesh.dynamicMeshletBoundsFresh;
    snapshot.dynamicMeshletConesFresh = mesh.dynamicMeshletConesFresh;
    return snapshot;
}

b8 PrepareMaterialPassGeometry(mut RendererMeshSystem meshes, in RendererResourceLookupMode lookupMode, mut MeshResources mesh, in MaterialPipelineResources resources){
    switch(resources.renderPath){
    case RenderPath::MeshShader:
        return true;
    case RenderPath::VertexIndexed:{
        if(lookupMode == RendererResourceLookupMode::CreateMissing && !meshes.prepareObjectGeometryCache(mesh, resources.objectGeometryDecodePipeline))
            return false;
        const auto cache = CaptureObjectGeometryCache(mesh);
        return cache.valid() && cache.decoderPipeline == resources.objectGeometryDecodePipeline;
    }
    case RenderPath::ComputeEmulation:
        if(lookupMode == RendererResourceLookupMode::CreateMissing && !meshes.prepareComputeEmulationResources(mesh))
            return false;
        return mesh.emulationVertexBuffer.valid() && mesh.emulationVertexHeapHandle.valid()
            && mesh.emulationVertexHeapHandle.descriptorClass() == GpuDescriptorClass::StorageBuffer
            && IsValidIndexedEmulationByteOffset(resources.indexedGeometryOutput, mesh.emulationIndexByteOffset);
    default:
        return false;
    }
}

Expected<MaterialInstanceAppend> AppendMaterialPassInstance(
    mut MaterialTypedStager stager,
    mut RendererMeshSystem meshes,
    in EntityID entity,
    in MaterialSurfaceInfo material,
    in MeshResources mesh,
    in Optional<in TransformComponent> transform,
    mut InstanceGpuDataVector instanceData,
    mut MaterialTypedInstanceRangeVector materialTypedRanges
){
    assert(instanceData.size() < cast<usize>(u32.max));
    const auto constantRange = stager.constant(material);
    if(!constantRange.has_value())
        return MakeUnexpected(Failure());
    const auto mutableRange = stager.mutableInstance(entity, material);
    if(!mutableRange.has_value())
        return MakeUnexpected(Failure());
    MaterialTypedInstanceRanges ranges;
    ranges.constantRange = constantRange.value();
    ranges.mutableRange = mutableRange.value();
    assert(MaterialTypedByteRangeEmptyOffsetValid(ranges.constantRange));
    assert(MaterialTypedByteRangeEmptyOffsetValid(ranges.mutableRange));
    const u32 index = cast<u32>(instanceData.size());
    TransformComponent resolved;
    if(transform.has_value())
        resolved = transform.value();
    InstanceGpuData instance = BuildInstanceGpuData(entity, transform.has_value(), LoadFloat(resolved.position), LoadFloat(resolved.rotation), LoadFloat(resolved.scale), ranges.mutableRange.byteOffset);
    meshes.populateMeshGeometryHeapSlots(mesh, instance);
    instanceData.push_back(instance);
    if(s_RuntimeAssertionsEnabled)
        materialTypedRanges.push_back(ranges);
    return MaterialInstanceAppend(index, ranges);
}

b8 EqualCsgFrameState(in CsgFrameState lhs, in CsgFrameState rhs){
    return lhs.receiverCount == rhs.receiverCount
        && lhs.cutterCount == rhs.cutterCount
        && lhs.hasAnyWork == rhs.hasAnyWork
        && lhs.hasOpaqueStaticWork == rhs.hasOpaqueStaticWork
        && lhs.hasOpaqueSkinnedWork == rhs.hasOpaqueSkinnedWork
        && lhs.hasTransparentStaticWork == rhs.hasTransparentStaticWork
        && lhs.hasTransparentSkinnedWork == rhs.hasTransparentSkinnedWork;
}

[cpp_unwind]
void CopyPreparedDrawItems(in MaterialPassDrawItems source, mut MaterialPassDrawItems destination){
    AssignVector(destination.meshDrawItems, source.meshDrawItems);
    AssignVector(destination.indexedDrawItems, source.indexedDrawItems);
    AssignVector(destination.computeDrawItems, source.computeDrawItems);
}

[cpp_unwind]
void CopyPreparedDrawItemPartitions(in MaterialPassDrawItemPartitions source, mut MaterialPassDrawItemPartitions destination){
    CopyPreparedDrawItems(source.regular, destination.regular);
    CopyPreparedDrawItems(source.csg, destination.csg);
    CopyPreparedDrawItems(source.csgReceiverSurface, destination.csgReceiverSurface);
}

[cpp_unwind]
void CopyPreparedCsgFrameData(in CsgFrameGpuData source, mut CsgFrameGpuData destination){
    AssignVector(destination.receiverRanges, source.receiverRanges);
    AssignVector(destination.cutters, source.cutters);
    destination.workRegion = source.workRegion;
}

b8 MatchesPreparedPassCacheSlot(
    in PreparedMaterialPassCacheSlot slot,
    in Framebuffer framebuffer,
    in b8 transparent,
    in CsgFrameState csgFrameState,
    in b8 csgActiveForPass,
    in Optional<in MeshViewGpuData> meshViewState
){
    if(!slot.valid || slot.transparent != transparent)
        return false;
    in FramebufferInfoEx fbInfo = framebuffer.getFramebufferInfo();
    if(slot.framebufferInfo != FramebufferInfo(fbInfo) || slot.framebufferWidth != fbInfo.width || slot.framebufferHeight != fbInfo.height)
        return false;
    if(!EqualCsgFrameState(slot.csgFrameState, csgFrameState))
        return false;
    if(!csgActiveForPass)
        return true;
    if(slot.hasMeshView != meshViewState.has_value())
        return false;
    return !slot.hasMeshView || slot.meshViewBytes == bit_cast<Array<u8, s_MeshViewGpuDataBytes>>(meshViewState.value());
}

void StampPreparedPassCacheSlot(
    mut PreparedMaterialPassCacheSlot slot,
    in Framebuffer framebuffer,
    in b8 transparent,
    in CsgFrameState csgFrameState,
    in Optional<in MeshViewGpuData> meshViewState,
    in b8 usesSharedTransparentStreams
){
    in FramebufferInfoEx fbInfo = framebuffer.getFramebufferInfo();
    slot.framebufferInfo = FramebufferInfo(fbInfo);
    slot.framebufferWidth = fbInfo.width;
    slot.framebufferHeight = fbInfo.height;
    slot.csgFrameState = csgFrameState;
    slot.hasMeshView = meshViewState.has_value();
    if(meshViewState.has_value())
        slot.meshViewBytes = bit_cast<Array<u8, s_MeshViewGpuDataBytes>>(meshViewState.value());
    slot.transparent = transparent;
    slot.usesSharedTransparentStreams = usesSharedTransparentStreams;
    slot.valid = true;
}

[cpp_unwind]
void AssignPreparedPassCacheOutputs(in PreparedMaterialPassCacheSlot slot, in PreparedMaterialStreamCache streams, in MaterialPassGatherOutputs outputs){
    CopyPreparedDrawItemPartitions(slot.drawItems, outputs.drawItems);
    CopyPreparedCsgFrameData(slot.csgFrameData, outputs.csgFrameData);
    AssignVector(outputs.instanceData, streams.instanceData);
    AssignVector(outputs.materialTypedBytes, streams.materialTypedBytes);
    if(s_RuntimeAssertionsEnabled)
        AssignVector(outputs.materialTypedRanges, streams.materialTypedRanges);
}

void AppendMaterialDrawItem(in RenderPath path, mut MaterialPassDrawItem item, mut MaterialPassDrawItems draws){
    switch(path){
    case RenderPath::MeshShader:
        AppendOwned<MaterialPassDrawItem>(draws.meshDrawItems, item);
        break;
    case RenderPath::VertexIndexed:
        AppendOwned<MaterialPassDrawItem>(draws.indexedDrawItems, item);
        break;
    case RenderPath::ComputeEmulation:
        AppendOwned<MaterialPassDrawItem>(draws.computeDrawItems, item);
        break;
    default:
        assert(false);
        break;
    }
}


class MaterialDrawGather{
    private mut RendererMaterialSystem system;
    private mut World world;
    private mut RendererMeshSystem meshes;
    private mut RendererCsgSystem csg;
    private in CsgShapeRegistry registry;
    private in RendererOpticalVolumeSelection opticalVolumes;
    private mut Framebuffer framebuffer;
    private MaterialPipelinePass pass;
    private b8 transparent;
    private RendererResourceLookupMode lookupMode;
    private in Optional<in MeshViewGpuData> meshView;
    private in MaterialPassGatherOutputs outputs;
    private mut MaterialTypedStager typedStager;

    public MaterialDrawGather(
        mut RendererMaterialSystem system,
        mut World world,
        mut RendererMeshSystem meshes,
        mut RendererCsgSystem csg,
        in CsgShapeRegistry registry,
        in RendererOpticalVolumeSelection opticalVolumes,
        mut Framebuffer framebuffer,
        in MaterialPipelinePass pass,
        in b8 transparent,
        in RendererResourceLookupMode lookupMode,
        in Optional<in MeshViewGpuData> meshView,
        in MaterialPassGatherOutputs outputs,
        mut MaterialTypedStager typedStager
    ){
        this.system = system;
        this.world = world;
        this.meshes = meshes;
        this.csg = csg;
        this.registry = registry;
        this.opticalVolumes = opticalVolumes;
        this.framebuffer = framebuffer;
        this.pass = pass;
        this.transparent = transparent;
        this.lookupMode = lookupMode;
        this.meshView = meshView;
        this.outputs = outputs;
        this.typedStager = typedStager;
    }

    [cpp_unwind]
    private Expected<MaterialInstanceAppend> appendInstance(in EntityID entity, in MaterialSurfaceInfo material, in MeshResources mesh, in Optional<in TransformComponent> transform, in b8 hasReceiverLookup){
        const auto appended = AppendMaterialPassInstance(
            this.typedStager,
            this.meshes,
            entity,
            material,
            mesh,
            transform,
            this.outputs.instanceData,
            this.outputs.materialTypedRanges
        );
        if(!appended.has_value())
            return MakeUnexpected(Failure());
        if(hasReceiverLookup)
            this.outputs.csgFrameData.receiverRanges.push_back(CsgReceiverRangeGpuData());
        return appended;
    }

    [cpp_unwind]
    private b8 prepareGeometry(mut MeshResources mesh, in MaterialPipelineResources resources){
        return PrepareMaterialPassGeometry(this.meshes, this.lookupMode, mesh, resources);
    }

    [cpp_unwind]
    private Expected<mut MaterialPipelineResources> pipeline(in MaterialSurfaceInfo material, in MaterialPipelineKey key){
        if(this.lookupMode == RendererResourceLookupMode::CreateMissing)
            return this.system.createRendererPipeline(material, key, this.framebuffer);
        return this.system.findRendererPipeline(key);
    }

    [cpp_unwind]
    private b8 appendDraw(in EntityID entity, mut MaterialSurfaceInfo material, mut MeshResources mesh, in CsgReceiverDrawState receiver, in Optional<in CsgFrameReceiverLookup> lookup){
        assert(mesh.valid() && GeometryHeapHandlesReady(mesh.geometryHeapHandles));
        assert(material.transparent == this.transparent);
        Optional<in TransformComponent> transform;
        const Optional<mut TransformComponent> borrowedTransform = this.world.borrowComponent<TransformComponent>(entity);
        if(borrowedTransform.has_value())
            transform.emplace(borrowedTransform.value());

        const b8 clipRequested = lookup.has_value() && receiver.active && MaterialPipelinePassUsesRendererCsgClip(this.pass, this.transparent);
        LogCsgCapSurfaceDispatchUnavailableIfNeeded(clipRequested, material.csgCapSurfaceDispatchAvailable, material.materialName, material.csgCapSurfaceDispatchUnavailableLogged);
        Expected<CsgReceiverClipDrawInfo> clip = MakeUnexpected(Failure());
        if(clipRequested && material.csgCapSurfaceDispatchAvailable){
            if(transform.has_value())
                clip = this.csg.resolveCsgReceiverClipDrawInfo(lookup.value(), receiver, mesh.csgLocalBounds, transform.value());
            else
                clip = this.csg.resolveCsgReceiverClipDrawInfo(lookup.value(), receiver, mesh.csgLocalBounds);
        }
        const b8 clipActive = clip.has_value() && clip.value().cutterCount > 0u;
        if(this.pass == MaterialPipelinePass::CsgReceiverSurface && !clipActive)
            return lookup.has_value() && this.appendInstance(entity, material, mesh, transform, true).has_value();

        Name evaluator = s_NameNone;
        u64 revision = 0u;
        if(clipActive){
            evaluator = clip.value().evaluatorVariant;
            revision = this.registry.revision();
        }
        in FramebufferInfoEx framebufferInfo = this.framebuffer.getFramebufferInfo();
        const MaterialPipelineKey key = BuildMaterialPassPipelineKey(material.materialName, FramebufferInfo(framebufferInfo), this.pass, material.twoSided, clipActive, evaluator, revision);
        const auto primary = this.pipeline(material, key);
        if(!primary.has_value() || !this.prepareGeometry(mesh, primary.value()))
            return false;
        const RenderPath path = primary.value().renderPath;
        const MaterialPassPipelineResourceSnapshot primarySnapshot = CaptureMaterialPassPipelineResourceSnapshot(primary.value());
        const b8 surfaceActive = IsCsgReceiverSurfacePassActive(clipActive, this.pass);
        MaterialPipelineKey surfaceKey = key;
        MaterialPassPipelineResourceSnapshot surfaceSnapshot;
        RenderPath surfacePath = RenderPath::MeshShader;
        if(surfaceActive){
            surfaceKey.pass = MaterialPipelinePass::CsgReceiverSurface;
            Expected<mut MaterialPipelineResources> surface = primary;
            if(this.pass != MaterialPipelinePass::CsgReceiverSurface)
                surface = this.pipeline(material, surfaceKey);
            if(!surface.has_value() || !this.prepareGeometry(mesh, surface.value()))
                return false;
            surfacePath = surface.value().renderPath;
            surfaceSnapshot = CaptureMaterialPassPipelineResourceSnapshot(surface.value());
        }

        const auto appended = this.appendInstance(entity, material, mesh, transform, lookup.has_value());
        if(!appended.has_value())
            return false;
        const u32 index = appended.value().instanceIndex;
        const u32 constantOffset = appended.value().typedRanges.constantRange.byteOffset;
        if(clipActive){
            Expected<CsgReceiverRangeGpuData> range = MakeUnexpected(Failure());
            if(transform.has_value() && this.meshView.has_value())
                range = this.csg.appendCsgReceiverClipData(lookup.value(), receiver, mesh.csgLocalBounds, transform.value(), framebufferInfo.width, framebufferInfo.height, this.meshView.value(), this.outputs.csgFrameData);
            else if(transform.has_value())
                range = this.csg.appendCsgReceiverClipData(lookup.value(), receiver, mesh.csgLocalBounds, transform.value(), framebufferInfo.width, framebufferInfo.height, this.outputs.csgFrameData);
            else if(this.meshView.has_value())
                range = this.csg.appendCsgReceiverClipData(lookup.value(), receiver, mesh.csgLocalBounds, framebufferInfo.width, framebufferInfo.height, this.meshView.value(), this.outputs.csgFrameData);
            else
                range = this.csg.appendCsgReceiverClipData(lookup.value(), receiver, mesh.csgLocalBounds, framebufferInfo.width, framebufferInfo.height, this.outputs.csgFrameData);
            if(!range.has_value())
                return false;
            range.value().shadingModelId = material.shadingModelId;
            range.value().surfaceDispatchId = material.surfaceDispatchId;
            range.value().materialConstantByteOffset = constantOffset;
            range.value().meshInstanceIndex = index;
            assert(index < this.outputs.csgFrameData.receiverRanges.size());
            this.outputs.csgFrameData.receiverRanges[index] = range.value();
        }
        MaterialPassDrawItem item;
        item.meshKey = mesh.meshName;
        item.pipelineKey = key;
        item.meshResources = CaptureMaterialMeshResourceSnapshot(mesh);
        item.pipelineResources = primarySnapshot;
        item.instanceIndex = index;
        item.materialConstantByteOffset = constantOffset;
        item.shadingModelId = material.shadingModelId;
        item.meshletConeCullScaleSafe = true;
        if(transform.has_value())
            item.meshletConeCullScaleSafe = MeshletConeCullScaleSafe(LoadFloat(transform.value().scale));

        if(this.pass != MaterialPipelinePass::CsgReceiverSurface){
            if(surfaceActive){
                MaterialPassDrawItem primaryItem = item;
                AppendMaterialDrawItem(path, primaryItem, this.outputs.drawItems.csg);
            }
            else if(clipActive)
                AppendMaterialDrawItem(path, item, this.outputs.drawItems.csg);
            else
                AppendMaterialDrawItem(path, item, this.outputs.drawItems.regular);
        }
        if(surfaceActive){
            item.pipelineKey = surfaceKey;
            item.pipelineResources = surfaceSnapshot;
            AppendMaterialDrawItem(surfacePath, item, this.outputs.drawItems.csgReceiverSurface);
        }
        return true;
    }

    [cpp_unwind]
    private void gatherRow(in MeshSystem ecsMeshes, in CsgReceiverPass receiverPass, in Optional<in CsgFrameReceiverLookup> lookup, in EntityID entity, in RendererComponent renderer){
        if(!renderer.visible || this.opticalVolumes.isSuppressed(entity))
            return;
        Expected<mut MaterialSurfaceInfo> material = MakeUnexpected(Failure());
        if(this.lookupMode == RendererResourceLookupMode::PreparedOnly){
            material = this.system.findMaterialSurfaceInfo(renderer.material);
            if(!material.has_value() || material.value().transparent != this.transparent)
                return;
        }
        const auto resolved = ecsMeshes.resolveRenderableMeshStatus(entity);
        if(!resolved.has_value())
            return;
        Expected<mut MeshResources> mesh = MakeUnexpected(Failure());
        if(resolved.value().runtime){
            if(this.lookupMode == RendererResourceLookupMode::CreateMissing)
                mesh = this.meshes.createRuntimeMeshResources(resolved.value().runtimeMesh);
            else
                mesh = this.meshes.findRuntimeMeshResources(resolved.value().runtimeMesh);
        }
        else if(this.lookupMode == RendererResourceLookupMode::CreateMissing)
            mesh = this.meshes.createMeshResources(resolved.value().mesh);
        else
            mesh = this.meshes.findMeshResources(resolved.value().mesh.name());
        if(!mesh.has_value())
            return;
        if(!material.has_value()){
            material = this.system.createMaterialSurfaceInfo(renderer.material);
            if(!material.has_value() || material.value().transparent != this.transparent)
                return;
        }
        CsgReceiverDrawState receiver;
        if(lookup.has_value()){
            const auto state = lookup.value().resolveReceiverDrawState(entity, receiverPass);
            if(state.has_value())
                receiver = state.value();
        }
        if(!this.appendDraw(entity, material.value(), mesh.value(), receiver, lookup))
            return;
    }

    [cpp_unwind]
    public void gather(in MeshSystem ecsMeshes, in CsgReceiverPass receiverPass, in Optional<in CsgFrameReceiverLookup> lookup){
        for(in auto row : this.world.view<RendererComponent>())
            this.gatherRow(ecsMeshes, receiverPass, lookup, Get<0>(row), Get<1>(row));
    }
}

class TransparentBatchGatherState : NoCopy{
    public mut RendererMaterialSystem system;
    public mut World world;
    public mut RendererMeshSystem meshes;
    public mut RendererCsgSystem csg;
    public in CsgShapeRegistry registry;
    public in RendererOpticalVolumeSelection opticalVolumes;
    public in MeshSystem ecsMeshes;
    public Span<TransparentPassPrepareDesc> passes;
    public Optional<in MeshViewGpuData> meshView;
    public mut MaterialTypedStager typedStager;
    public mut PreparedMaterialStreamCache streams;
    public mut Array<PreparedMaterialPassCacheSlot, s_MaterialPipelinePassCount> passSlots;
    public mut Array<CsgFrameGpuData, s_MaterialPipelinePassCount> dimFrames;
    public in Array<u32, s_MaterialPipelinePassCount> dimWidths;
    public in Array<u32, s_MaterialPipelinePassCount> dimHeights;
    public in Array<usize, s_MaterialPipelinePassCount> dimIndexPerPass;
    public usize dimCount;
    public mut Array<b8, s_MaterialPipelinePassCount> fallbackPass;

    public TransparentBatchGatherState(
        mut RendererMaterialSystem system,
        mut World world,
        mut RendererMeshSystem meshes,
        mut RendererCsgSystem csg,
        in CsgShapeRegistry registry,
        in RendererOpticalVolumeSelection opticalVolumes,
        in borrow MeshSystem ecsMeshes,
        in Span<TransparentPassPrepareDesc> passes,
        in Optional<in MeshViewGpuData> meshView,
        mut MaterialTypedStager typedStager,
        mut PreparedMaterialStreamCache streams,
        mut Array<PreparedMaterialPassCacheSlot, s_MaterialPipelinePassCount> passSlots,
        mut Array<CsgFrameGpuData, s_MaterialPipelinePassCount> dimFrames,
        in Array<u32, s_MaterialPipelinePassCount> dimWidths,
        in Array<u32, s_MaterialPipelinePassCount> dimHeights,
        in Array<usize, s_MaterialPipelinePassCount> dimIndexPerPass,
        in usize dimCount,
        mut Array<b8, s_MaterialPipelinePassCount> fallbackPass
    ){
        this.system = system;
        this.world = world;
        this.meshes = meshes;
        this.csg = csg;
        this.registry = registry;
        this.opticalVolumes = opticalVolumes;
        this.ecsMeshes = ecsMeshes;
        this.passes = passes;
        this.meshView = meshView;
        this.typedStager = typedStager;
        this.streams = streams;
        this.passSlots = passSlots;
        this.dimFrames = dimFrames;
        this.dimWidths = dimWidths;
        this.dimHeights = dimHeights;
        this.dimIndexPerPass = dimIndexPerPass;
        this.dimCount = dimCount;
        this.fallbackPass = fallbackPass;
    }

    [cpp_unwind]
    public void gatherRow(in EntityID entity, in RendererComponent renderer, in Optional<in CsgFrameReceiverLookup> lookup){
        if(!renderer.visible || this.opticalVolumes.isSuppressed(entity))
            return;
        auto materialResult = this.system.createMaterialSurfaceInfo(renderer.material);
        if(!materialResult.has_value() || !materialResult.value().transparent)
            return;
        mut MaterialSurfaceInfo material = materialResult.value();

        const auto resolved = this.ecsMeshes.resolveRenderableMeshStatus(entity);
        if(!resolved.has_value())
            return;
        Expected<mut MeshResources> meshResult = MakeUnexpected(Failure());
        if(resolved.value().runtime)
            meshResult = this.meshes.createRuntimeMeshResources(resolved.value().runtimeMesh);
        else
            meshResult = this.meshes.createMeshResources(resolved.value().mesh);
        if(!meshResult.has_value())
            return;
        mut MeshResources mesh = meshResult.value();
        assert(mesh.valid() && GeometryHeapHandlesReady(mesh.geometryHeapHandles));

        Optional<in TransformComponent> transform;
        const Optional<mut TransformComponent> borrowedTransform = this.world.borrowComponent<TransformComponent>(entity);
        if(borrowedTransform.has_value())
            transform.emplace(borrowedTransform.value());

        CsgReceiverDrawState receiver;
        if(lookup.has_value()){
            const auto state = lookup.value().resolveReceiverDrawState(entity, CsgReceiverPass::Transparent);
            if(state.has_value())
                receiver = state.value();
        }
        const b8 clipRequested = lookup.has_value() && receiver.active;
        LogCsgCapSurfaceDispatchUnavailableIfNeeded(clipRequested, material.csgCapSurfaceDispatchAvailable, material.materialName, material.csgCapSurfaceDispatchUnavailableLogged);
        Expected<CsgReceiverClipDrawInfo> clip = MakeUnexpected(Failure());
        if(clipRequested && material.csgCapSurfaceDispatchAvailable){
            if(transform.has_value())
                clip = this.csg.resolveCsgReceiverClipDrawInfo(lookup.value(), receiver, mesh.csgLocalBounds, transform.value());
            else
                clip = this.csg.resolveCsgReceiverClipDrawInfo(lookup.value(), receiver, mesh.csgLocalBounds);
        }
        const b8 clipActive = clip.has_value() && clip.value().cutterCount > 0u;

        Name evaluator = s_NameNone;
        u64 revision = 0u;
        if(clipActive){
            evaluator = clip.value().evaluatorVariant;
            revision = this.registry.revision();
        }

        const usize passCount = this.passes.size();
        Array<MaterialPipelineKey, s_MaterialPipelinePassCount> keys;
        Array<MaterialPassPipelineResourceSnapshot, s_MaterialPipelinePassCount> pipelineSnapshots;
        Array<RenderPath, s_MaterialPipelinePassCount> paths;
        Array<b8, s_MaterialPipelinePassCount> emitDraw;
        Array<b8, s_MaterialPipelinePassCount> dimNeedsClip;
        b8 anySuccess = false;
        b8 needsReceiverInstanceOnly = false;
        for(usize d = 0u; d < this.dimCount; ++d)
            dimNeedsClip[d] = false;

        for(usize p = 0u; p < passCount; ++p){
            emitDraw[p] = false;
            if(this.fallbackPass[p])
                continue;
            const MaterialPipelinePass pass = this.passes[p].pass;
            if(pass == MaterialPipelinePass::CsgReceiverSurface && !clipActive){
                if(lookup.has_value())
                    needsReceiverInstanceOnly = true;
                continue;
            }
            in FramebufferInfoEx fbInfo = this.passes[p].framebuffer.deref().getFramebufferInfo();
            const MaterialPipelineKey key = BuildMaterialPassPipelineKey(material.materialName, FramebufferInfo(fbInfo), pass, material.twoSided, clipActive, evaluator, revision);
            const auto primary = this.system.createRendererPipeline(material, key, this.passes[p].framebuffer.deref());
            if(!primary.has_value() || !PrepareMaterialPassGeometry(this.meshes, RendererResourceLookupMode::CreateMissing, mesh, primary.value())){
                this.fallbackPass[p] = true;
                continue;
            }
            keys[p] = key;
            pipelineSnapshots[p] = CaptureMaterialPassPipelineResourceSnapshot(primary.value());
            paths[p] = primary.value().renderPath;
            emitDraw[p] = true;
            anySuccess = true;
            if(clipActive)
                dimNeedsClip[this.dimIndexPerPass[p]] = true;
        }
        if(!anySuccess && !needsReceiverInstanceOnly)
            return;

        const auto appended = AppendMaterialPassInstance(
            this.typedStager,
            this.meshes,
            entity,
            material,
            mesh,
            transform,
            this.streams.instanceData,
            this.streams.materialTypedRanges
        );
        if(!appended.has_value())
            return;
        const u32 index = appended.value().instanceIndex;
        const u32 constantOffset = appended.value().typedRanges.constantRange.byteOffset;

        if(lookup.has_value()){
            for(usize d = 0u; d < this.dimCount; ++d)
                this.dimFrames[d].receiverRanges.push_back(CsgReceiverRangeGpuData());
        }
        if(clipActive){
            for(usize d = 0u; d < this.dimCount; ++d){
                if(!dimNeedsClip[d])
                    continue;
                Expected<CsgReceiverRangeGpuData> range = MakeUnexpected(Failure());
                if(transform.has_value() && this.meshView.has_value())
                    range = this.csg.appendCsgReceiverClipData(lookup.value(), receiver, mesh.csgLocalBounds, transform.value(), this.dimWidths[d], this.dimHeights[d], this.meshView.value(), this.dimFrames[d]);
                else if(transform.has_value())
                    range = this.csg.appendCsgReceiverClipData(lookup.value(), receiver, mesh.csgLocalBounds, transform.value(), this.dimWidths[d], this.dimHeights[d], this.dimFrames[d]);
                else if(this.meshView.has_value())
                    range = this.csg.appendCsgReceiverClipData(lookup.value(), receiver, mesh.csgLocalBounds, this.dimWidths[d], this.dimHeights[d], this.meshView.value(), this.dimFrames[d]);
                else
                    range = this.csg.appendCsgReceiverClipData(lookup.value(), receiver, mesh.csgLocalBounds, this.dimWidths[d], this.dimHeights[d], this.dimFrames[d]);
                if(!range.has_value()){
                    for(usize p = 0u; p < passCount; ++p){
                        if(this.dimIndexPerPass[p] == d && emitDraw[p]){
                            this.fallbackPass[p] = true;
                            emitDraw[p] = false;
                        }
                    }
                    continue;
                }
                range.value().shadingModelId = material.shadingModelId;
                range.value().surfaceDispatchId = material.surfaceDispatchId;
                range.value().materialConstantByteOffset = constantOffset;
                range.value().meshInstanceIndex = index;
                assert(index < this.dimFrames[d].receiverRanges.size());
                this.dimFrames[d].receiverRanges[index] = range.value();
            }
        }

        const MaterialPassMeshResourceSnapshot meshSnapshot = CaptureMaterialMeshResourceSnapshot(mesh);
        b8 meshletConeCullScaleSafe = true;
        if(transform.has_value())
            meshletConeCullScaleSafe = MeshletConeCullScaleSafe(LoadFloat(transform.value().scale));

        MaterialPassDrawItem baseItem;
        baseItem.meshKey = mesh.meshName;
        baseItem.meshResources = meshSnapshot;
        baseItem.instanceIndex = index;
        baseItem.materialConstantByteOffset = constantOffset;
        baseItem.shadingModelId = material.shadingModelId;
        baseItem.meshletConeCullScaleSafe = meshletConeCullScaleSafe;

        for(usize p = 0u; p < passCount; ++p){
            if(!emitDraw[p] || this.fallbackPass[p])
                continue;
            MaterialPassDrawItem item = baseItem;
            item.pipelineKey = keys[p];
            item.pipelineResources = pipelineSnapshots[p];
            mut MaterialPassDrawItemPartitions partitions = this.passSlots[cast<usize>(this.passes[p].pass)].drawItems;
            if(this.passes[p].pass == MaterialPipelinePass::CsgReceiverSurface)
                AppendMaterialDrawItem(paths[p], item, partitions.csgReceiverSurface);
            else if(clipActive)
                AppendMaterialDrawItem(paths[p], item, partitions.csg);
            else
                AppendMaterialDrawItem(paths[p], item, partitions.regular);
        }
    }
}

[cpp_unwind]
void RendererMaterialSystem::gatherDraws(
    in FramebufferHandle framebuffer,
    in MaterialPipelinePass pass,
    in b8 transparent,
    in CsgFrameState csgFrameState,
    in RendererResourceLookupMode lookupMode,
    in Optional<in MeshViewGpuData> csgWorkRegionMeshViewState,
    in MaterialPassGatherOutputs outputs
){
    this.m_materialState.m_lastGatheredStreamToken = 0u;
    if(!framebuffer.valid())
        return;

    CsgReceiverPass receiverPass = CsgReceiverPass::Opaque;
    if(transparent)
        receiverPass = CsgReceiverPass::Transparent;
    const b8 csgActiveForPass = MaterialPipelinePassUsesRendererCsgClip(pass, transparent) && CsgFrameHasReceiverPassWork(csgFrameState, receiverPass);

    if(lookupMode == RendererResourceLookupMode::PreparedOnly){
        in PreparedMaterialPassCacheSlot slot = this.m_materialState.m_preparedPassCache[cast<usize>(pass)];
        if(MatchesPreparedPassCacheSlot(slot, framebuffer.deref(), transparent, csgFrameState, csgActiveForPass, csgWorkRegionMeshViewState)){
            if(slot.usesSharedTransparentStreams){
                in PreparedMaterialStreamCache streams = this.m_materialState.m_preparedTransparentStreams;
                AssignPreparedPassCacheOutputs(slot, streams, outputs);
                this.m_materialState.m_lastGatheredStreamToken = streams.streamToken;
                return;
            }
            in PreparedMaterialStreamCache streams = slot.ownedStreams;
            AssignPreparedPassCacheOutputs(slot, streams, outputs);
            this.m_materialState.m_lastGatheredStreamToken = streams.streamToken;
            return;
        }
    }

    const Optional<mut MeshSystem> meshes = this.m_world.borrowSystem<MeshSystem>();
    if(!meshes.has_value()){
        LogMeshSystemNotRegisteredForMaterialPass();
        return;
    }
    const usize capacity = this.m_world.view<RendererComponent>().candidateCount();
    const b8 meshSupported = this.m_graphics.queryFeatureSupport(Feature::Meshlets);
    usize regularCapacity = capacity;
    if(pass == MaterialPipelinePass::CsgReceiverSurface)
        regularCapacity = 0u;
    usize csgCapacity = 0u;
    usize receiverCapacity = 0u;
    outputs.instanceData.reserve(capacity);
    if(s_RuntimeAssertionsEnabled)
        outputs.materialTypedRanges.reserve(capacity);
    outputs.materialTypedBytes.reserve(ResolveMaterialTypedReserve(capacity));
    MaterialTypedStager stager(this, this.m_world, lookupMode, outputs.materialTypedBytes, capacity);
    MaterialDrawGather gather(this, this.m_world, this.m_meshSystem, this.m_csgSystem, this.m_csgShapeRegistry, this.m_opticalVolumes,
        framebuffer.deref(), pass, transparent, lookupMode, csgWorkRegionMeshViewState, outputs, stager);
    if(csgActiveForPass){
        CsgFrameReceiverLookup lookup(this.m_world);
        if(!lookup.empty()){
            if(pass != MaterialPipelinePass::CsgReceiverSurface)
                csgCapacity = capacity;
            if(pass == MaterialPipelinePass::Opaque || pass == MaterialPipelinePass::CsgReceiverSurface)
                receiverCapacity = capacity;
            outputs.drawItems.reserveForPath(meshSupported, regularCapacity, csgCapacity, receiverCapacity);
            outputs.csgFrameData.reserve(capacity, lookup.cutterCount());
            gather.gather(meshes.value(), receiverPass, Optional<in CsgFrameReceiverLookup>(lookup));
            SortMaterialPassDrawItemPartitions(outputs.drawItems);
            return;
        }
    }
    outputs.drawItems.reserveForPath(meshSupported, regularCapacity, 0u, 0u);
    gather.gather(meshes.value(), receiverPass, Optional<in CsgFrameReceiverLookup>());
    SortMaterialPassDrawItemPartitions(outputs.drawItems);
}

[cpp_unwind]
b8 RendererMaterialSystem::prepareMaterialPassResources(in FramebufferHandle framebuffer, in MaterialPipelinePass pass, in b8 transparent, in CsgFrameState csgFrameState){
    return this.prepareMaterialPassResourcesImpl(framebuffer, pass, transparent, csgFrameState, false, Optional<in MeshViewGpuData>());
}

[cpp_unwind]
b8 RendererMaterialSystem::prepareMaterialPassResources(in FramebufferHandle framebuffer, in MaterialPipelinePass pass, in b8 transparent, in CsgFrameState csgFrameState, in Optional<in MeshViewGpuData> csgWorkRegionMeshViewState){
    return this.prepareMaterialPassResourcesImpl(framebuffer, pass, transparent, csgFrameState, false, csgWorkRegionMeshViewState);
}

[cpp_unwind]
b8 RendererMaterialSystem::prepareMaterialPassResources(in FramebufferHandle framebuffer, in MaterialPipelinePass pass, in b8 transparent, in CsgFrameState csgFrameState, in AvboitFrameTargets avboitTargets){
    return this.prepareMaterialPassResourcesImpl(framebuffer, pass, transparent, csgFrameState, avboitTargets.valid(), Optional<in MeshViewGpuData>());
}

[cpp_unwind]
b8 RendererMaterialSystem::prepareMaterialPassResources(in FramebufferHandle framebuffer, in MaterialPipelinePass pass, in b8 transparent, in CsgFrameState csgFrameState, in AvboitFrameTargets avboitTargets, in Optional<in MeshViewGpuData> csgWorkRegionMeshViewState){
    return this.prepareMaterialPassResourcesImpl(framebuffer, pass, transparent, csgFrameState, avboitTargets.valid(), csgWorkRegionMeshViewState);
}

[cpp_unwind]
b8 RendererMaterialSystem::prepareMaterialPassResourcesImpl(
    in FramebufferHandle framebuffer,
    in MaterialPipelinePass pass,
    in b8 transparent,
    in CsgFrameState csgFrameState,
    in b8 avboitTargetsValid,
    in Optional<in MeshViewGpuData> csgWorkRegionMeshViewState
){
    if(!CanPrepareMaterialPassTargets(framebuffer.valid(), pass, avboitTargetsValid))
        return false;

    mut PreparedMaterialPassCacheSlot slot = this.m_materialState.m_preparedPassCache[cast<usize>(pass)];
    slot.clear();

    this.gatherMaterialPassDrawItems(
        framebuffer,
        pass,
        transparent,
        csgFrameState,
        RendererResourceLookupMode::CreateMissing,
        csgWorkRegionMeshViewState,
        slot.drawItems,
        slot.ownedStreams.instanceData,
        slot.csgFrameData,
        slot.ownedStreams.materialTypedRanges,
        slot.ownedStreams.materialTypedBytes
    );
    ++this.m_materialState.m_preparedStreamGeneration;
    slot.ownedStreams.streamToken = this.m_materialState.m_preparedStreamGeneration;
    StampPreparedPassCacheSlot(slot, framebuffer.deref(), transparent, csgFrameState, csgWorkRegionMeshViewState, false);

    if(slot.drawItems.empty())
        return true;

    const b8 drawBuffersReady = this.prepareMaterialPassDrawBuffers(slot.ownedStreams.instanceData, slot.ownedStreams.materialTypedBytes);
    const b8 regularDrawResourcesReady = this.m_drawRecorder.prepareMaterialPassResourceBindings(slot.drawItems.regular);
    const b8 csgDrawResourcesReady = slot.drawItems.csg.empty() || this.m_drawRecorder.prepareMaterialPassResourceBindings(slot.drawItems.csg);
    const b8 csgReceiverSurfaceDrawResourcesReady = slot.drawItems.csgReceiverSurface.empty() || this.m_drawRecorder.prepareMaterialPassResourceBindings(slot.drawItems.csgReceiverSurface);

    return drawBuffersReady && regularDrawResourcesReady && csgDrawResourcesReady && csgReceiverSurfaceDrawResourcesReady;
}

[cpp_unwind]
b8 RendererMaterialSystem::prepareTransparentMaterialPasses(
    in Span<TransparentPassPrepareDesc> passes,
    in CsgFrameState csgFrameState,
    in b8 avboitTargetsValid,
    in Optional<in MeshViewGpuData> csgWorkRegionMeshViewState
){
    if(passes.empty())
        return true;
    if(passes.size() > s_MaterialPipelinePassCount)
        return false;
    for(usize p = 0u; p < passes.size(); ++p){
        if(!CanPrepareMaterialPassTargets(passes[p].framebuffer.valid(), passes[p].pass, avboitTargetsValid))
            return false;
    }

    this.m_materialState.m_preparedTransparentStreams.clear();
    for(usize p = 0u; p < passes.size(); ++p)
        this.m_materialState.m_preparedPassCache[cast<usize>(passes[p].pass)].clear();

    const Optional<mut MeshSystem> meshes = this.m_world.borrowSystem<MeshSystem>();
    if(!meshes.has_value()){
        LogMeshSystemNotRegisteredForMaterialPass();
        ++this.m_materialState.m_preparedStreamGeneration;
        this.m_materialState.m_preparedTransparentStreams.streamToken = this.m_materialState.m_preparedStreamGeneration;
        for(usize p = 0u; p < passes.size(); ++p){
            mut PreparedMaterialPassCacheSlot slot = this.m_materialState.m_preparedPassCache[cast<usize>(passes[p].pass)];
            StampPreparedPassCacheSlot(slot, passes[p].framebuffer.deref(), true, csgFrameState, csgWorkRegionMeshViewState, true);
        }
        return true;
    }

    if(CsgFrameHasReceiverPassWork(csgFrameState, CsgReceiverPass::Transparent)){
        CsgFrameReceiverLookup lookup(this.m_world);
        if(!lookup.empty())
            return this.prepareTransparentMaterialPassesImpl(this.m_world, meshes.value(), passes, csgFrameState, csgWorkRegionMeshViewState, Optional<in CsgFrameReceiverLookup>(lookup));
    }
    return this.prepareTransparentMaterialPassesImpl(this.m_world, meshes.value(), passes, csgFrameState, csgWorkRegionMeshViewState, Optional<in CsgFrameReceiverLookup>());
}

[cpp_unwind]
b8 RendererMaterialSystem::prepareTransparentMaterialPassesImpl(
    mut World world,
    in borrow MeshSystem ecsMeshes,
    in Span<TransparentPassPrepareDesc> passes,
    in CsgFrameState csgFrameState,
    in Optional<in MeshViewGpuData> csgWorkRegionMeshViewState,
    in Optional<in CsgFrameReceiverLookup> lookup
){
    const usize passCount = passes.size();
    const usize capacity = world.view<RendererComponent>().candidateCount();
    const b8 meshSupported = this.m_graphics.queryFeatureSupport(Feature::Meshlets);
    mut PreparedMaterialStreamCache streams = this.m_materialState.m_preparedTransparentStreams;
    streams.instanceData.reserve(capacity);
    if(s_RuntimeAssertionsEnabled)
        streams.materialTypedRanges.reserve(capacity);
    streams.materialTypedBytes.reserve(ResolveMaterialTypedReserve(capacity));

    Array<CsgFrameGpuData, s_MaterialPipelinePassCount> dimFrames;
    Array<u32, s_MaterialPipelinePassCount> dimWidths;
    Array<u32, s_MaterialPipelinePassCount> dimHeights;
    Array<usize, s_MaterialPipelinePassCount> dimIndexPerPass;
    Array<b8, s_MaterialPipelinePassCount> fallbackPass;
    usize dimCount = 0u;

    for(usize p = 0u; p < passCount; ++p){
        in FramebufferInfoEx fbInfo = passes[p].framebuffer.deref().getFramebufferInfo();
        usize foundDim = dimCount;
        for(usize d = 0u; d < dimCount; ++d){
            if(dimWidths[d] == fbInfo.width && dimHeights[d] == fbInfo.height){
                foundDim = d;
                break;
            }
        }
        if(foundDim == dimCount){
            dimWidths[dimCount] = fbInfo.width;
            dimHeights[dimCount] = fbInfo.height;
            if(lookup.has_value())
                dimFrames[dimCount].reserve(capacity, lookup.value().cutterCount());
            ++dimCount;
        }
        dimIndexPerPass[p] = foundDim;
        fallbackPass[p] = false;

        mut PreparedMaterialPassCacheSlot slot = this.m_materialState.m_preparedPassCache[cast<usize>(passes[p].pass)];
        usize regularCap = capacity;
        usize csgCap = 0u;
        usize receiverCap = 0u;
        if(passes[p].pass == MaterialPipelinePass::CsgReceiverSurface){
            regularCap = 0u;
            if(lookup.has_value())
                receiverCap = capacity;
        }
        else if(lookup.has_value())
            csgCap = capacity;
        slot.drawItems.reserveForPath(meshSupported, regularCap, csgCap, receiverCap);
    }

    MaterialTypedStager stager(this, world, RendererResourceLookupMode::CreateMissing, streams.materialTypedBytes, capacity);
    {
        TransparentBatchGatherState batchState(
            this,
            world,
            this.m_meshSystem,
            this.m_csgSystem,
            this.m_csgShapeRegistry,
            this.m_opticalVolumes,
            ecsMeshes,
            passes,
            csgWorkRegionMeshViewState,
            stager,
            streams,
            this.m_materialState.m_preparedPassCache,
            dimFrames,
            dimWidths,
            dimHeights,
            dimIndexPerPass,
            dimCount,
            fallbackPass
        );
        for(in auto row : world.view<RendererComponent>())
            batchState.gatherRow(Get<0>(row), Get<1>(row), lookup);
    }

    ++this.m_materialState.m_preparedStreamGeneration;
    streams.streamToken = this.m_materialState.m_preparedStreamGeneration;

    b8 anyNonFallbackDraws = false;
    b8 allReady = true;
    for(usize p = 0u; p < passCount; ++p){
        if(fallbackPass[p])
            continue;
        mut PreparedMaterialPassCacheSlot slot = this.m_materialState.m_preparedPassCache[cast<usize>(passes[p].pass)];
        if(lookup.has_value())
            CopyPreparedCsgFrameData(dimFrames[dimIndexPerPass[p]], slot.csgFrameData);
        SortMaterialPassDrawItemPartitions(slot.drawItems);
        StampPreparedPassCacheSlot(slot, passes[p].framebuffer.deref(), true, csgFrameState, csgWorkRegionMeshViewState, true);
        if(!slot.drawItems.empty())
            anyNonFallbackDraws = true;
    }

    if(anyNonFallbackDraws && !streams.instanceData.empty())
        allReady = this.prepareMaterialPassDrawBuffers(streams.instanceData, streams.materialTypedBytes) && allReady;

    for(usize p = 0u; p < passCount; ++p){
        if(fallbackPass[p])
            continue;
        in PreparedMaterialPassCacheSlot slot = this.m_materialState.m_preparedPassCache[cast<usize>(passes[p].pass)];
        if(slot.drawItems.empty())
            continue;
        const b8 regularReady = this.m_drawRecorder.prepareMaterialPassResourceBindings(slot.drawItems.regular);
        const b8 csgReady = slot.drawItems.csg.empty() || this.m_drawRecorder.prepareMaterialPassResourceBindings(slot.drawItems.csg);
        const b8 receiverReady = slot.drawItems.csgReceiverSurface.empty() || this.m_drawRecorder.prepareMaterialPassResourceBindings(slot.drawItems.csgReceiverSurface);
        if(!regularReady || !csgReady || !receiverReady)
            allReady = false;
    }

    for(usize p = 0u; p < passCount; ++p){
        if(!fallbackPass[p])
            continue;
        if(!this.prepareMaterialPassResourcesImpl(passes[p].framebuffer, passes[p].pass, true, csgFrameState, true, csgWorkRegionMeshViewState))
            allReady = false;
    }

    return allReady;
}


[cpp_header("<impl/assets/graphics/mesh/runtime_constants.h>"), cpp_name("NWB_MESH_EMULATION_VERTEX_POSITION_LOCATION")]
extern const u32 s_EmulationVertexPositionLocation;
[cpp_header("<impl/assets/graphics/mesh/runtime_constants.h>"), cpp_name("NWB_MESH_EMULATION_VERTEX_NORMAL_LOCATION")]
extern const u32 s_EmulationVertexNormalLocation;
[cpp_header("<impl/assets/graphics/mesh/runtime_constants.h>"), cpp_name("NWB_MESH_EMULATION_VERTEX_TANGENT_LOCATION")]
extern const u32 s_EmulationVertexTangentLocation;
[cpp_header("<impl/assets/graphics/mesh/runtime_constants.h>"), cpp_name("NWB_MESH_EMULATION_VERTEX_UV0_LOCATION")]
extern const u32 s_EmulationVertexUv0Location;
[cpp_header("<impl/assets/graphics/mesh/runtime_constants.h>"), cpp_name("NWB_MESH_EMULATION_VERTEX_COLOR_LOCATION")]
extern const u32 s_EmulationVertexColorLocation;
[cpp_header("<impl/assets/graphics/mesh/runtime_constants.h>"), cpp_name("NWB_MESH_EMULATION_VERTEX_WORLD_POSITION_LOCATION")]
extern const u32 s_EmulationVertexWorldPositionLocation;

[cpp_unwind]
Expected<BindingLayoutHandle> RendererMaterialSystem::prepareMaterialPassBindingLayout(){
    if(!EnsurePushConstantBindingLayout(this.m_graphics.getDevice(), sizeof(TransparentDrawPushConstants), ShaderTypeMask::All, this.m_materialState.m_materialPassBindingLayout)){
        error("RendererSystem: failed to create the shared material-pass push-constant layout");
        return MakeUnexpected(Failure());
    }
    return this.m_materialState.m_materialPassBindingLayout;
}

[cpp_unwind]
b8 RendererMaterialSystem::prepareMeshComputeBindingLayout(){
    if(!EnsurePushConstantBindingLayout(this.m_graphics.getDevice(), sizeof(MeshComputePushConstants), ShaderTypeMask::Compute, this.m_materialState.m_computeBindingLayout)){
        error("RendererSystem: failed to create compute-emulation binding layout");
        return false;
    }

    return true;
}

[cpp_unwind]
b8 RendererMaterialSystem::createComputeEmulationResources(){
    if(!this.prepareMeshComputeBindingLayout())
        return false;

    if(!this.m_materialState.m_emulationVertexShader.valid()){
        if(!this.m_shaderSystem.loadShader<VertexShader, MeshSubsystem>(lambda[](in MeshSubsystem s) -> AssetRef<VertexShader>{ return s.emulationVs; }, s_ShaderArchiveDefaultVariant, s_MeshEmulationVsDebugName, this.m_materialState.m_emulationVertexShader))
            return false;
    }

    if(!this.m_materialState.m_emulationInputLayout.valid()){
        Array<VertexAttributeDesc, 6u> attributes;
        SetEmulatedVertexAttribute(Format::RGBA32_FLOAT, s_ShaderMeshEmulationVertexPositionByteOffset, "POSITION", attributes[s_EmulationVertexPositionLocation]);
        SetEmulatedVertexAttribute(Format::RGBA16_FLOAT, s_ShaderMeshEmulationVertexNormalByteOffset, "NORMAL", attributes[s_EmulationVertexNormalLocation]);
        SetEmulatedVertexAttribute(Format::RGBA16_FLOAT, s_ShaderMeshEmulationVertexTangentByteOffset, "TANGENT", attributes[s_EmulationVertexTangentLocation]);
        SetEmulatedVertexAttribute(Format::RG32_FLOAT, s_ShaderMeshEmulationVertexUv0ByteOffset, "TEXCOORD", attributes[s_EmulationVertexUv0Location]);
        SetEmulatedVertexAttribute(Format::RGBA16_FLOAT, s_ShaderMeshEmulationVertexColorByteOffset, "COLOR", attributes[s_EmulationVertexColorLocation]);
        SetEmulatedVertexAttribute(Format::RGBA32_FLOAT, s_ShaderMeshEmulationVertexWorldPositionByteOffset, "POSITION1", attributes[s_EmulationVertexWorldPositionLocation]);

        mut Device device = this.m_graphics.getDevice();
        auto emulationInputLayoutResult = device.createInputLayout(attributes, this.m_materialState.m_emulationVertexShader.deref());
        if(emulationInputLayoutResult.has_value())
            this.m_materialState.m_emulationInputLayout = emulationInputLayoutResult.value();
        else
            this.m_materialState.m_emulationInputLayout.reset();
        if(!emulationInputLayoutResult.has_value()){
            error("RendererSystem: failed to create compute-emulation input layout");
            return false;
        }
    }

    return true;
}

[cpp_unwind]
b8 RendererMaterialSystem::reserveInstanceBufferCapacity(in usize instanceCount){
    if(instanceCount == 0)
        return true;
    assert(instanceCount <= cast<usize>(u32.max));
    if(this.m_materialState.m_instanceBuffer.valid() && this.m_materialState.m_instanceBufferCapacity >= instanceCount)
        return true;

    const usize capacity = NextGrowingCapacity(this.m_materialState.m_instanceBufferCapacity, instanceCount);
    if(s_RuntimeAssertionsEnabled && !ValidateInstanceBufferAddressableCapacity(capacity, sizeof(InstanceGpuData)))
        return false;

    BufferDesc instanceBufferDesc;
    instanceBufferDesc
        .setByteSize(cast<u64>(capacity * sizeof(InstanceGpuData)))
        .setStructStride(sizeof(InstanceGpuData))
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
        .setDebugName(s_InstanceBufferName)
        .enableAutomaticStateTracking(ResourceStates::Common)
    ;
    auto instanceBufferResult = this.m_graphics.createBuffer(instanceBufferDesc);
    if(!instanceBufferResult.has_value()){
        error("RendererSystem: failed to create instance data buffer");
        return false;
    }
    BufferHandle instanceBuffer = instanceBufferResult.value();

    this.m_materialState.m_instanceBuffer = instanceBuffer;
    this.m_materialState.m_instanceBufferCapacity = capacity;
    return true;
}

[cpp_unwind]
b8 RendererMaterialSystem::reserveMaterialTypedBufferCapacity(in usize byteCount){
    usize requiredByteCount = 0u;
    if(s_RuntimeAssertionsEnabled){
        const auto validated = ValidateAndAlignMaterialTypedByteRequest(byteCount, sizeof(u32));
        if(!validated.has_value())
            return false;
        requiredByteCount = validated.value();
    }
    else
        requiredByteCount = ResolveMaterialTypedBufferByteCount(byteCount, sizeof(u32));
    if(this.m_materialState.m_materialTypedBuffer.valid() && this.m_materialState.m_materialTypedBufferCapacity >= requiredByteCount)
        return true;

    const usize capacity = NextGrowingCapacity(this.m_materialState.m_materialTypedBufferCapacity, requiredByteCount);
    BufferDesc materialTypedBufferDesc;
    materialTypedBufferDesc
        .setByteSize(cast<u64>(capacity))
        .setStructStride(sizeof(u32))
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
        .setDebugName(s_MaterialTypedBufferName)
        .enableAutomaticStateTracking(ResourceStates::Common)
    ;
    auto materialTypedBufferResult = this.m_graphics.createBuffer(materialTypedBufferDesc);
    if(!materialTypedBufferResult.has_value()){
        error("RendererSystem: failed to create material typed buffer");
        return false;
    }
    BufferHandle materialTypedBuffer = materialTypedBufferResult.value();

    this.m_materialState.m_materialTypedBuffer = materialTypedBuffer;
    this.m_materialState.m_materialTypedBufferCapacity = capacity;
    return true;
}

[cpp_unwind]
b8 RendererMaterialSystem::prepareMaterialPassDrawBuffers(in Span<InstanceGpuData> instanceData, in Span<u8> materialTypedBytes){
    const usize uploadBytes = ResolveMaterialTypedUploadByteCount(materialTypedBytes);

    return this.reserveInstanceBufferCapacity(instanceData.size()) && this.reserveMaterialTypedBufferCapacity(uploadBytes);
}

b8 RendererMaterialSystem::materialPassDrawBuffersReady(in Span<InstanceGpuData> instanceData, in Span<u8> materialTypedBytes)const{
    const usize uploadBytes = ResolveMaterialTypedUploadByteCount(materialTypedBytes);

    return this.materialPassDrawBuffersReady(instanceData.size(), uploadBytes);
}

b8 RendererMaterialSystem::materialPassDrawBuffersReady(in usize instanceCount, in usize materialTypedByteCount)const{
    return IsMaterialPassDrawBuffersReady(
        instanceCount,
        materialTypedByteCount,
        this.m_materialState.m_instanceBuffer.valid(),
        this.m_materialState.m_instanceBufferCapacity,
        this.m_materialState.m_materialTypedBuffer.valid(),
        this.m_materialState.m_materialTypedBufferCapacity
    );
}

MaterialPassBufferSnapshot RendererMaterialSystem::materialPassBufferSnapshot()const{
    return MaterialPassBufferSnapshot(
        this.m_materialState.m_instanceBuffer,
        this.m_materialState.m_materialTypedBuffer,
        this.m_materialState.m_instanceBufferCapacity,
        this.m_materialState.m_materialTypedBufferCapacity
    );
}


