const SmokeMaterialRef s_RefractionSceneClearMaterial = "project/smoke/refraction/materials/clear";
const SmokeMaterialRef s_RefractionSceneOpaqueMaterial = "project/smoke/refraction/materials/opaque";
const SmokeMaterialRef s_RefractionSceneTransparentMaterial = "project/smoke/refraction/materials/transparent";
const SmokeMeshRef s_RefractionScenePlaneMesh = "project/meshes/shadow_plane";
const SmokeMeshRef s_RefractionSceneCubeMesh = "project/meshes/cube_hard_edges";
const SmokeMeshRef s_RefractionSceneSphereMesh = "project/meshes/caustic_sphere";
const usize s_RefractionLifecyclePhaseCount = 7u;
const u32 s_RefractionDefaultCaptureFrameCount = 16u;
const u64 s_RefractionFrameGraphRequiredFrames = 360u;
const u64 s_RefractionMaxU32Value = 4294967295u;

RefractionLifecyclePhase RefractionLifecyclePhaseAt(in usize phase){
    switch(phase){
    case 0u: return RefractionLifecyclePhase("baseline", 0.0f, false);
    case 1u: return RefractionLifecyclePhase("active", 0.0f, true);
    case 2u: return RefractionLifecyclePhase("moved", 1.9f, true);
    case 3u: return RefractionLifecyclePhase("edge", 4.2f, true);
    case 4u: return RefractionLifecyclePhase("empty", 100.0f, true);
    case 5u: return RefractionLifecyclePhase("disabled", 0.0f, false);
    }
    return RefractionLifecyclePhase("reenabled", 0.0f, true);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RefractionQueryDiagnostics{
    public RefractionQueryDiagnostics(mut ProjectRuntimeContext context){
        this.m_context = context;
    }

    public b8 configure(in b8 densityEnabled, in b8 lifecycleEnabled, in b8 timingEnabled, mut World world){
        b8 invalidDiagEnv = false;
        b8 diagEnabled = false;
        b8 invalidPrereqs = false;
        native(
            in densityEnabled,
            in lifecycleEnabled,
            in timingEnabled,
            mut world,
            mut invalidDiagEnv,
            mut diagEnabled,
            mut invalidPrereqs
        ){
            Core::Alloc::ScratchArena arena(s_SmokeEnvironmentArena);
            const auto configured = ReadEnvironmentVariable(arena, "NWB_REFRACTION_SMOKE_DIAGNOSTICS");
            if(!configured || (*configured && **configured != "0" && **configured != "1")){
                invalidDiagEnv = true;
            }
            else{
                diagEnabled = *configured && **configured == "1";
                if(diagEnabled){
                    const auto freeze = ReadEnvironmentVariable(arena, "NWB_RENDERER_BASELINE_CAPTURE_FREEZE_FRAME");
                    const auto readback = ReadSmokeEnvironmentText(arena, "NWB_SMOKE_FRAMEBUFFER_CAPTURE_PATH");
                    const auto hardware = ReadEnvironmentVariable(arena, "NWB_REFRACTION_SMOKE_HARDWARE");
                    if(!freeze || !hardware || *freeze || !readback || !densityEnabled || lifecycleEnabled || timingEnabled || (*hardware && **hardware != "1")){
                        invalidPrereqs = true;
                    }
                    else{
                        auto& renderer = *MakeNotNull(world.getSystem<Impl::RendererSystem>());
                        renderer.setRefractionDiagnosticsEnabled(true);
                    }
                }
            }
        }
        if(invalidDiagEnv){
            error("RefractionSmokeProjectImpl: diagnostics must be absent, 0, or 1");
            return false;
        }
        this.m_enabled = diagEnabled;
        if(!this.m_enabled)
            return true;
        if(invalidPrereqs){
            error("RefractionSmokeProjectImpl: query diagnostics require a hardware density framebuffer capture with timing, lifecycle, and frame freeze disabled");
            return false;
        }
        return true;
    }

    public void update(mut World world){
        if(!this.m_enabled || this.m_reported)
            return;
        i32 width = 0;
        i32 height = 0;
        u32 targetWidth = 0u;
        u32 targetHeight = 0u;
        u64 currentFrame = 0u;
        native(in ctx = this.m_context, mut width, mut height, mut targetWidth, mut targetHeight, mut currentFrame){
            ctx.graphics.getWindowDimensions(width, height);
            const auto target = NWB::QueryProjectFrameClientSize();
            targetWidth = target.width;
            targetHeight = target.height;
            currentFrame = ctx.graphics.getFrameIndex();
        }
        if(
            width != cast<i32>(targetWidth)
            || height != cast<i32>(targetHeight)
            || (this.m_targetStart.has_value() && currentFrame < this.m_targetStart.value())
        ){
            this.m_targetStart.reset();
            return;
        }
        if(!this.m_targetStart.has_value()){
            this.m_targetStart = currentFrame;
            return;
        }
        const u64 targetStart = this.m_targetStart.value();
        if(currentFrame - targetStart < s_RefractionDiagnosticsRequiredTargetFrames)
            return;

        b8 reported = false;
        u64 sourceFrame = 0u;
        native(in targetWidth, in targetHeight, in currentFrame, in targetStart, mut world, mut reported, mut sourceFrame){
            const auto& renderer = *MakeNotNull(world.getSystem<Impl::RendererSystem>());
            const auto result = renderer.tryGetLatestRefractionStatistics();
            if(result){
                const auto& statistics = *result;
                if(
                    statistics.width == targetWidth
                    && statistics.height == targetHeight
                    && statistics.graphicsFrameIndex >= targetStart
                    && statistics.graphicsFrameIndex - targetStart >= s_RefractionDiagnosticsRequiredTargetFrames
                    && statistics.graphicsFrameIndex <= currentFrame
                ){
                    LogRefractionQueryDiagnosticsCounters(statistics, currentFrame, targetStart);
                    sourceFrame = statistics.graphicsFrameIndex;
                    reported = true;
                }
            }
        }
        if(reported){
            this.m_sourceFrame = sourceFrame;
            this.m_reported = true;
        }
    }

    public b8 enabled()const{
        return this.m_enabled;
    }

    public b8 shouldCapture(in u64 graphicsFrame)const{
        return ShouldCaptureRefractionQueryDiagnostics(this.m_reported, graphicsFrame, this.m_sourceFrame);
    }

    private mut ProjectRuntimeContext m_context;
    private Optional<u64> m_targetStart;
    private u64 m_sourceFrame = 0u;
    private b8 m_enabled = false;
    private b8 m_reported = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


EntityID CreateRefractionScenePanel(
    in SmokeMaterialRef material,
    in VectorSingle tint,
    in VectorSingle position,
    in VectorSingle scale,
    mut World world
){
    const EntityID entity = CreateTintedStaticMeshEntity(
        s_RefractionScenePlaneMesh,
        material,
        NameTextAscii(s_SmokeSurfaceMaterialInterface),
        tint,
        position,
        scale,
        world
    );
    [essential] assert(entity.valid(), "RefractionSmokeProject: panel creation failed");
    // Rotate the XZ plane to face the camera along -Z.
    const f32x4 rotation = f32x4(QuaternionRotationRollPitchYawFromVector(VectorSingle(-s_RefractionHalfPi, 0.0f, 0.0f, 0.0f)));
    native(in entity, in rotation, mut world){
        auto& transform = *MakeNotNull(world.tryGetComponent<Impl::Scene::TransformComponent>(entity));
        transform.rotation = rotation;
    }
    return entity;
}

Expected<EntityID> CreateRefractionDensityScene(in u32 percent, mut World world, mut ProjectRuntimeContext context){
    const Expected<String> configuredExtent = ReadSmokeEnvironmentString("NWB_REFRACTION_SMOKE_EXTENT");
    if(!configuredExtent.has_value()){
        error("RefractionSmokeProject: density requires explicit extent 960x720, 1600x900, or 1920x1080");
        return MakeUnexpected(Failure());
    }
    const StringView extentText = StringView(configuredExtent.value());
    if(extentText != "960x720" && extentText != "1600x900" && extentText != "1920x1080"){
        error("RefractionSmokeProject: density requires explicit extent 960x720, 1600x900, or 1920x1080");
        return MakeUnexpected(Failure());
    }

    b8 validHardwareEnv = true;
    b8 hardwareRequested = true;
    u32 frameWidth = 0u;
    u32 frameHeight = 0u;
    native(mut validHardwareEnv, mut hardwareRequested, mut frameWidth, mut frameHeight){
        Core::Alloc::ScratchArena arena(s_SmokeEnvironmentArena);
        const auto enabled = ReadEnvironmentVariable(arena, "NWB_REFRACTION_SMOKE_ENABLED");
        const auto hardware = ReadEnvironmentVariable(arena, "NWB_REFRACTION_SMOKE_HARDWARE");
        if(!enabled || !hardware || (*enabled && **enabled != "1") || (*hardware && **hardware != "0" && **hardware != "1")){
            validHardwareEnv = false;
        }
        else{
            hardwareRequested = !*hardware || **hardware == "1";
            const auto extent = NWB::QueryProjectFrameClientSize();
            frameWidth = extent.width;
            frameHeight = extent.height;
        }
    }
    if(!validHardwareEnv){
        error("RefractionSmokeProject: density requires refraction enabled and hardware selection absent, 0, or 1");
        return MakeUnexpected(Failure());
    }

    const f32 frameWidthFloat = cast<f32>(frameWidth);
    const f32 frameHeightFloat = cast<f32>(frameHeight);
    const f32 aspect = frameWidthFloat / frameHeightFloat;
    const f32 tangent = Tan(s_RefractionPi / 6.0f);
    const f32 fractionEdge = Sqrt(cast<f32>(percent) * 0.01f);
    const u32 coveredWidth = Min(frameWidth, 2u * cast<u32>(frameWidthFloat * fractionEdge * 0.5f + 0.5f));
    const u32 coveredHeight = Min(frameHeight, 2u * cast<u32>(frameHeightFloat * fractionEdge * 0.5f + 0.5f));
    u32 left = 0u;
    u32 top = 0u;
    if(percent != 0u){
        left = (frameWidth - coveredWidth) / 2u;
        top = (frameHeight - coveredHeight) / 2u;
    }
    const u32 right = left + coveredWidth;
    const u32 bottom = top + coveredHeight;
    const u64 admittedPixels = cast<u64>(coveredWidth) * cast<u64>(coveredHeight);
    const u64 totalPixels = cast<u64>(frameWidth) * cast<u64>(frameHeight);
    const u32 tileEdge = s_RefractionDensityTileEdge;
    u32 activeTiles = 0u;
    if(percent != 0u){
        const u32 tilesRight = (right + tileEdge - 1u) / tileEdge;
        const u32 tilesBottom = (bottom + tileEdge - 1u) / tileEdge;
        activeTiles = (tilesRight - left / tileEdge) * (tilesBottom - top / tileEdge);
    }
    const u32 totalTiles = ((frameWidth + tileEdge - 1u) / tileEdge) * ((frameHeight + tileEdge - 1u) / tileEdge);

    const EntityID camera = CreateSmokeCamera(1.4f, 6.0f, 0.0f, world);
    if(!camera.valid())
        return MakeUnexpected(Failure());
    const f32 verticalFov = s_RefractionPi / 3.0f;
    EntityID light = s_InvalidEntityId;
    native(in camera, in verticalFov, in aspect, mut world, mut light){
        auto& cameraComponent = world.entity(camera).getComponent<Impl::Scene::CameraComponent>();
        cameraComponent.setVerticalFovRadians(verticalFov);
        cameraComponent.setAspectRatio(aspect);
        light = Impl::Scene::CreateDirectionalLightEntity(world, 0.0f, 0.0f, 0.0f, Float4(1.0f, 1.0f, 1.0f, 1.0f), 1.0f);
        if(light.valid())
            world.entity(light).getComponent<Impl::Scene::LightComponent>().enableCaustics = false;
    }
    if(!light.valid())
        return MakeUnexpected(Failure());

    // Shared opaque backdrop that occludes the behind-wall slab.
    const f32 backdropDepth = s_RefractionDensityBackdropDepth;
    const f32 backdropHalfHeight = tangent * (6.0f + backdropDepth);
    const f32 backdropHalfWidth = backdropHalfHeight * aspect;
    const f32 backdropPanelHalfWidth = backdropHalfWidth * 1.05f;
    const f32 backdropPanelHalfHeight = backdropHalfHeight * 1.05f;
    CreateRefractionScenePanel(
        s_RefractionSceneOpaqueMaterial,
        VectorSingle(0.04f, 0.04f, 0.04f, 1.0f),
        VectorSingle(0.0f, 1.4f, backdropDepth, 0.0f),
        VectorSingle(backdropPanelHalfWidth, 1.0f, backdropPanelHalfHeight, 0.0f),
        world
    );
    const u32 stripeCount = s_RefractionDensityStripeCount;
    const f32 stripeHalfWidth = backdropHalfWidth / cast<f32>(stripeCount);
    const f32 stripeStart = -backdropHalfWidth;
    for(u32 stripe = 1u; stripe < stripeCount; stripe += 2u){
        const f32 stripeSlot = 2.0f * cast<f32>(stripe) + 1.0f;
        const f32 x = stripeSlot * stripeHalfWidth + stripeStart;
        CreateRefractionScenePanel(
            s_RefractionSceneOpaqueMaterial,
            VectorSingle(0.92f, 0.92f, 0.92f, 1.0f),
            VectorSingle(x, 1.4f, backdropDepth - 0.01f, 0.0f),
            VectorSingle(stripeHalfWidth, 1.0f, backdropPanelHalfHeight, 0.0f),
            world
        );
    }

    // Full coverage extends past the viewport while empty coverage hides the refractor behind the wall.
    f32 frontDepthValue = 0.0f;
    if(percent == 0u)
        frontDepthValue = 4.0f;
    f32 projectedWidth = cast<f32>(coveredWidth);
    f32 projectedHeight = cast<f32>(coveredHeight);
    if(percent == 0u || percent == 100u){
        projectedWidth = frameWidthFloat + 2.0f;
        projectedHeight = frameHeightFloat + 2.0f;
    }
    const f32 halfHeight = (6.0f + frontDepthValue) * tangent;
    const VectorSingle scale = VectorSingle(
        (halfHeight * 2.0f * aspect * projectedWidth) / frameWidthFloat,
        (halfHeight * 2.0f * projectedHeight) / frameHeightFloat,
        0.2f,
        0.0f
    );
    const EntityID glass = CreateTintedStaticMeshEntity(
        s_RefractionSceneCubeMesh,
        s_RefractionSceneClearMaterial,
        NameTextAscii(s_SmokeSurfaceMaterialInterface),
        VectorSingle(1.0f, 1.0f, 1.0f, 0.0f),
        VectorSingle(0.0f, 1.4f, frontDepthValue + 0.1f, 0.0f),
        scale,
        world
    );
    if(!glass.valid())
        return MakeUnexpected(Failure());

    StringView captureMode = "visible";
    if(percent == 0u)
        captureMode = "occluded";
    StringView tracingMode = "screen-space";
    if(hardwareRequested)
        tracingMode = "hardware";
    u32 rayQuerySupported = 0u;
    native(in ctx = context, mut rayQuerySupported){
        rayQuerySupported = ctx.graphics.queryFeatureSupport(Core::Feature::RayQuery) ? 1u : 0u;
    }
    [essential] info(
        "RefractionDensity: extent {}x{} requested_percent {} admitted_pixels {} total_pixels {} active_tiles {} total_tiles {} glass_instances 1 capture_mode {}"
        , frameWidth
        , frameHeight
        , percent
        , admittedPixels
        , totalPixels
        , activeTiles
        , totalTiles
        , captureMode
    );
    [essential] info("RefractionDensity: pixel_bounds {} {} {} {}", left, top, right, bottom);
    [essential] info(
        "RefractionDensity: tracing requested {} ray_query_supported {} refraction_enabled 1"
        , tracingMode
        , rayQuerySupported
    );
    return glass;
}

Expected<Optional<u32>> ReadRefractionDensityPercent(){
    b8 readFailed = false;
    b8 hasValue = false;
    String text;
    native(mut readFailed, mut hasValue, mut text){
        Core::Alloc::ScratchArena arena(s_SmokeEnvironmentArena);
        const auto configured = ReadEnvironmentVariable(arena, "NWB_REFRACTION_SMOKE_DENSITY");
        if(!configured){
            readFailed = true;
        }
        else if(*configured){
            hasValue = true;
            text.assign((*configured)->data(), (*configured)->size());
        }
    }
    if(readFailed){
        error("RefractionSmokeProject: failed to read density fixture selection");
        return MakeUnexpected(Failure());
    }
    if(!hasValue)
        return Optional<u32>();
    const StringView view = StringView(text);
    if(view == "0")
        return Optional<u32>(0u);
    if(view == "1")
        return Optional<u32>(1u);
    if(view == "10")
        return Optional<u32>(10u);
    if(view == "50")
        return Optional<u32>(50u);
    if(view == "100")
        return Optional<u32>(100u);
    error("RefractionSmokeProject: density must be exactly 0, 1, 10, 50, or 100");
    return MakeUnexpected(Failure());
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RefractionSmokeProjectImpl : IProjectEntryCallbacks{
    public RefractionSmokeProjectImpl(mut ProjectRuntimeContext context){
        this.m_context = context;
        this.m_world = CreateRefractionSmokeWorldOrDie(context);
        this.m_queryDiagnostics = RefractionQueryDiagnostics(context);
        this.m_timingRenderPass = AvboitTimingRenderPass(context.graphics);
        this.m_fpsProbe = FpsProbe(RefractionSmokeProjectName());
        this.m_gpuPassTimingProbe = GpuPassTimingProbe(RefractionSmokeProjectName());
    }

    public ~RefractionSmokeProjectImpl(){
        this.m_timingRenderPass.stop();
        DestroyCapturedSmokeRenderWorld(this.m_context, this.m_world, this.m_framebufferCapture);
    }

    public b8 onStartup()override{
        this.m_lifecycleEnabled = ReadSmokeEnvironmentFlag("NWB_REFRACTION_SMOKE_LIFECYCLE");
        this.m_timingEnabled = ReadSmokeEnvironmentFlag("NWB_REFRACTION_SMOKE_TIMING");
        const Expected<Optional<u32>> density = ReadRefractionDensityPercent();
        if(!density.has_value())
            return false;
        const Optional<u32> densityValue = density.value();
        this.m_densityEnabled = densityValue.has_value();

        b8 diagOk = false;
        native(
            in densityEnabled = this.m_densityEnabled,
            in lifecycleEnabled = this.m_lifecycleEnabled,
            in timingEnabled = this.m_timingEnabled,
            mut diag = this.m_queryDiagnostics,
            mut world = this.m_world,
            mut diagOk
        ){
            diagOk = diag.configure(densityEnabled, lifecycleEnabled, timingEnabled, *world);
        }
        if(!diagOk)
            return false;
        if(!this.configureFrameGraphSnapshot())
            return false;
        if(this.m_timingEnabled){
            native(mut ctx = this.m_context){
                ctx.setPerfCapture(Core::Perf::CaptureOptions::GpuTimingOnly());
            }
            if(!this.m_timingRenderPass.start())
                return false;
        }
        if(!this.configureFramebufferCapture())
            return false;

        const Expected<String> galleryCase = ReadSmokeEnvironmentString("NWB_REFRACTION_SMOKE_CASE");
        const b8 hasGalleryCase = galleryCase.has_value();
        if((hasGalleryCase && this.m_lifecycleEnabled) || (this.m_densityEnabled && (hasGalleryCase || this.m_lifecycleEnabled))){
            error("RefractionSmokeProject: lifecycle, gallery, and density cases are mutually exclusive");
            return false;
        }
        if(this.m_densityEnabled){
            const u32 percent = densityValue.value();
            b8 createdDensity = false;
            EntityID densityGlass = s_InvalidEntityId;
            native(in percent, mut world = this.m_world, mut ctx = this.m_context, mut createdDensity, mut densityGlass){
                const Expected<EntityID> glassResult = CreateRefractionDensityScene(percent, *world, ctx);
                if(glassResult.has_value()){
                    densityGlass = glassResult.value();
                    createdDensity = true;
                }
            }
            if(!createdDensity)
                return false;
            this.m_glass = densityGlass;
            return true;
        }
        if(hasGalleryCase){
            const StringView caseView = StringView(galleryCase.value());
            const b8 geometryPreview = ReadSmokeEnvironmentFlag("NWB_REFRACTION_SMOKE_GEOMETRY");
            b8 galleryOk = false;
            native(in caseView, in geometryPreview, mut world = this.m_world, mut galleryOk){
                galleryOk = CreateRefractionGalleryScene(caseView, geometryPreview, *world);
            }
            return galleryOk;
        }

        b8 defaultSceneOk = false;
        EntityID glassEntity = s_InvalidEntityId;
        const b8 lifecycleEnabled = this.m_lifecycleEnabled;
        native(in lifecycleEnabled, mut world = this.m_world, mut defaultSceneOk, mut glassEntity){
            const auto camera = CreateSmokeCamera(1.4f, 6.0f, 0.0f, *world);
            // Include a light so shared shadow and TLAS preparation runs.
            const auto light = Impl::Scene::CreateDirectionalLightEntity(*world, 0.6f, 0.4f, 0.0f, Float4(1.0f, 1.0f, 1.0f, 1.0f), 1.0f);
            glassEntity = CreateTintedStaticMeshEntity(
                s_RefractionSceneSphereMesh,
                s_RefractionSceneClearMaterial,
                NameTextAscii(s_SmokeSurfaceMaterialInterface),
                VectorSet(1.0f, 1.0f, 1.0f, 1.0f),
                VectorSet(0.0f, 1.4f, 0.0f, 0.0f),
                VectorSet(1.15f, 1.15f, 1.15f, 0.0f),
                *world
            );
            defaultSceneOk = camera.valid() && glassEntity.valid() && light.valid();
            if(defaultSceneOk){
                world->entity(light).getComponent<Impl::Scene::LightComponent>().enableCaustics = false;
                // Unlit opaque stripes provide a static background for measuring refraction displacement.
                const u32 stripeCount = lifecycleEnabled ? 48u : 20u;
                const f32 stripeStart = lifecycleEnabled ? -7.05f : -2.85f;
                for(u32 stripe = 0u; stripe < stripeCount; ++stripe){
                    const f32 value = (stripe & 1u) != 0u ? 0.92f : 0.04f;
                    const f32 x = static_cast<f32>(stripe) * 0.3f + stripeStart;
                    CreateRefractionScenePanel(
                        s_RefractionSceneOpaqueMaterial,
                        VectorSet(value, value, value, 1.0f),
                        VectorSet(x, 1.4f, 2.8f, 0.0f),
                        VectorSet(0.15f, 1.0f, 2.0f, 0.0f),
                        *world
                    );
                }
                // Place the red strip in front of the glass and the blue strip behind it.
                CreateRefractionScenePanel(
                    s_RefractionSceneTransparentMaterial,
                    VectorSet(1.0f, 0.025f, 0.025f, 0.75f),
                    VectorSet(0.0f, 0.85f, -1.7f, 0.0f),
                    VectorSet(1.6f, 1.0f, 0.08f, 0.0f),
                    *world
                );
                CreateRefractionScenePanel(
                    s_RefractionSceneTransparentMaterial,
                    VectorSet(0.025f, 0.1f, 1.0f, 0.70f),
                    VectorSet(0.0f, 1.9f, 1.6f, 0.0f),
                    VectorSet(2.0f, 1.0f, 0.12f, 0.0f),
                    *world
                );
            }
        }
        [essential] assert(defaultSceneOk, "RefractionSmokeProject: camera/glass/light creation failed");
        this.m_glass = glassEntity;
        [essential] info("RefractionSmokeProject: zero-coverage clear sphere + opaque stripes + foreground/background AVBOIT panels created");
        if(this.m_lifecycleEnabled)
            this.applyLifecyclePhase();
        return true;
    }

    public void onShutdown()override{
        this.m_timingRenderPass.stop();
        DestroyCapturedSmokeRenderWorld(this.m_context, this.m_world, this.m_framebufferCapture);
        [essential] info("RefractionSmokeProject: shutdown");
    }

    public b8 onUpdate(in f32 delta)override{
        native(mut diag = this.m_queryDiagnostics, mut world = this.m_world, mut capture = this.m_framebufferCapture){
            diag.update(*world);
            if(capture)
                capture->update();
        }
        if(!this.advanceLifecycleCapture())
            return false;
        if(!this.updateFrameGraphSnapshot())
            return false;
        if(this.m_frameGraphSnapshotCompleted)
            return true;
        if(this.m_timingEnabled){
            this.m_fpsProbe.recordFrame(delta);
            this.m_gpuPassTimingProbe.recordFrame(delta, this.m_context.gpuTimingView());
        }
        f32 fixedDelta = RendererBaselineFixedDelta();
        if(this.m_densityEnabled)
            fixedDelta = 1.0f / 60.0f;
        f32 tickDelta = delta;
        if(fixedDelta > 0.0f)
            tickDelta = fixedDelta;
        b8 ticked = false;
        native(in tickDelta, mut world = this.m_world, mut ticked){
            ticked = TickSmokeWorld(tickDelta, *world);
        }
        return ticked;
    }

    private b8 configureFrameGraphSnapshot(){
        const b8 diagEnabled = this.m_queryDiagnostics.enabled();
        b8 readFailed = false;
        b8 hasPath = false;
        b8 invalidPrereqs = false;
        String snapshotPath;
        native(
            in timingEnabled = this.m_timingEnabled,
            in lifecycleEnabled = this.m_lifecycleEnabled,
            in diagEnabled,
            mut readFailed,
            mut hasPath,
            mut invalidPrereqs,
            mut snapshotPath
        ){
            Core::Alloc::ScratchArena arena(s_SmokeEnvironmentArena);
            const auto path = ReadEnvironmentVariable(arena, "NWB_REFRACTION_FRAME_GRAPH_SNAPSHOT_PATH");
            if(!path){
                readFailed = true;
            }
            else if(*path){
                hasPath = true;
                const auto readback = ReadEnvironmentVariable(arena, "NWB_SMOKE_FRAMEBUFFER_CAPTURE_PATH");
                const auto freeze = ReadEnvironmentVariable(arena, "NWB_RENDERER_BASELINE_CAPTURE_FREEZE_FRAME");
                if(!readback || !freeze || (**path).empty() || timingEnabled || lifecycleEnabled || diagEnabled || *readback || *freeze){
                    invalidPrereqs = true;
                }
                else{
                    snapshotPath.assign((**path).data(), (**path).size());
                }
            }
        }
        if(readFailed){
            error("RefractionSmokeProject: failed to read frame-graph snapshot path");
            return false;
        }
        if(!hasPath)
            return true;
        if(invalidPrereqs){
            error("RefractionSmokeProject: a nonempty frame-graph snapshot path requires timing, lifecycle, framebuffer readback, and frame freeze disabled");
            return false;
        }
        this.m_frameGraphSnapshotPath = snapshotPath;
        return true;
    }

    private b8 updateFrameGraphSnapshot(){
        if(this.m_frameGraphSnapshotPath.empty() || this.m_frameGraphSnapshotCompleted)
            return true;
        i32 width = 0;
        i32 height = 0;
        u32 targetWidth = 0u;
        u32 targetHeight = 0u;
        u64 currentFrame = 0u;
        native(in ctx = this.m_context, mut width, mut height, mut targetWidth, mut targetHeight, mut currentFrame){
            ctx.graphics.getWindowDimensions(width, height);
            const auto target = NWB::QueryProjectFrameClientSize();
            targetWidth = target.width;
            targetHeight = target.height;
            currentFrame = ctx.graphics.getFrameIndex();
        }
        if(
            width != cast<i32>(targetWidth)
            || height != cast<i32>(targetHeight)
            || (this.m_frameGraphTargetStart.has_value() && currentFrame < this.m_frameGraphTargetStart.value())
        ){
            this.m_frameGraphTargetStart.reset();
            return true;
        }
        if(!this.m_frameGraphTargetStart.has_value()){
            this.m_frameGraphTargetStart = currentFrame;
            return true;
        }
        const u64 completedFrames = currentFrame - this.m_frameGraphTargetStart.value();
        if(completedFrames < s_RefractionFrameGraphRequiredFrames || currentFrame == 0u)
            return true;
        if(!CaptureStressFrameGraphSnapshot(StringView(this.m_frameGraphSnapshotPath), completedFrames, this.m_context))
            return false;
        this.m_frameGraphSnapshotCompleted = true;
        [essential] info("RefractionFrameGraphSnapshot: target_extent {}x{} completed_target_frames {}", targetWidth, targetHeight, completedFrames);
        native(mut ctx = this.m_context){
            ctx.requestQuit();
        }
        return true;
    }

    private b8 configureFramebufferCapture(){
        if(this.m_lifecycleEnabled){
            const Expected<String> output = ReadSmokeEnvironmentString("NWB_SMOKE_FRAMEBUFFER_CAPTURE_PATH");
            if(!output.has_value()){
                error("RefractionSmokeProject: lifecycle requires application framebuffer capture");
                return false;
            }
            const StringView outputView = StringView(output.value());
            u32 captureFrames = s_RefractionDefaultCaptureFrameCount;
            const Expected<String> framesText = ReadSmokeEnvironmentString("NWB_SMOKE_FRAMEBUFFER_CAPTURE_FRAME_COUNT");
            if(framesText.has_value()){
                const Expected<u64> parsed = ParseU64(StringView(framesText.value()));
                if(!parsed.has_value() || parsed.value() == 0u || parsed.value() > s_RefractionMaxU32Value){
                    error("RefractionSmokeProject: lifecycle frame count must be a positive u32");
                    return false;
                }
                captureFrames = cast<u32>(parsed.value());
            }
            this.m_lifecyclePaths.reserve(s_RefractionLifecyclePhaseCount);
            for(usize phase = 0u; phase < s_RefractionLifecyclePhaseCount; ++phase){
                String phasePath;
                if(phase + 1u == s_RefractionLifecyclePhaseCount){
                    phasePath = String(outputView);
                }
                else{
                    const StringView phaseName = RefractionLifecyclePhaseAt(phase).name;
                    native(in outputView, in phaseName, mut phasePath){
                        Core::Alloc::ScratchArena scratchArena(s_SmokeEnvironmentArena);
                        const auto formatted = StringFormat(scratchArena, "{}.{}.bmp", outputView, phaseName);
                        phasePath.assign(formatted.data(), formatted.size());
                    }
                }
                this.m_lifecyclePaths.push_back(phasePath);
            }
            const StringView firstPath = StringView(this.m_lifecyclePaths[0u]);
            b8 started = false;
            native(in firstPath, in captureFrames, mut ctx = this.m_context, mut capture = this.m_framebufferCapture, mut started){
                const auto extent = NWB::QueryProjectFrameClientSize();
                const FramebufferCaptureOptions options{
                    .requiredWidth = extent.width,
                    .requiredHeight = extent.height,
                    .quitWhenReady = false,
                };
                capture = MakeUnique<FramebufferCapture>(firstPath, captureFrames, ctx, options);
                started = capture && capture->start();
            }
            return started;
        }

        FramebufferCaptureOptions options = FramebufferCaptureOptions();
        if(this.m_densityEnabled){
            native(mut options){
                const auto extent = NWB::QueryProjectFrameClientSize();
                options.requiredWidth = extent.width;
                options.requiredHeight = extent.height;
                // The density harness confirms the exact client/framebuffer extent and readback, then closes normally.
                options.quitWhenReady = false;
            }
        }
        if(this.m_queryDiagnostics.enabled()){
            native(mut options, mut diag = this.m_queryDiagnostics){
                options.predicateContext = &diag;
                options.shouldCapture = +[](void* const owner, const u64 graphicsFrame)noexcept -> b8{
                    const auto& diagnostics = *MakeNotNull(static_cast<RefractionQueryDiagnostics*>(owner));
                    return diagnostics.shouldCapture(graphicsFrame);
                };
            }
        }
        SmokeCaptureFactory captureFactory = SmokeCaptureFactory(this.m_context);
        Expected<UniquePtr<FramebufferCapture>> capture = captureFactory.configure(
            RefractionSmokeProjectName(),
            s_RefractionDefaultCaptureFrameCount,
            options
        );
        if(!capture.has_value())
            return false;
        native(mut dst = this.m_framebufferCapture, mut capture){
            dst = Move(*capture);
        }
        return true;
    }

    private void applyLifecyclePhase(){
        const RefractionLifecyclePhase phase = RefractionLifecyclePhaseAt(this.m_lifecyclePhase);
        const f32 glassX = phase.glassX;
        const b8 phaseEnabled = phase.enabled;
        native(in glass = this.m_glass, in glassX, in phaseEnabled, mut world = this.m_world){
            auto& transform = *MakeNotNull(world->tryGetComponent<Impl::Scene::TransformComponent>(glass));
            auto& renderer = *MakeNotNull(world->getSystem<Impl::RendererSystem>());
            transform.position = Float4(glassX, 1.4f, 0.0f, 0.0f);
            renderer.setRefractionEnabled(phaseEnabled);
        }
        [essential] info("RefractionLifecycle: phase {} applied", phase.name);
    }

    private b8 advanceLifecycleCapture(){
        if(!this.m_lifecycleEnabled || this.m_lifecyclePhase == s_RefractionLifecyclePhaseCount)
            return true;
        b8 ready = false;
        u64 capturedFrame = 0u;
        native(in capture = this.m_framebufferCapture, mut ready, mut capturedFrame){
            if(capture && capture->captureReady()){
                ready = true;
                capturedFrame = capture->capturedGraphicsFrameIndex();
            }
        }
        if(!ready)
            return true;
        [essential] info("RefractionLifecycle: captured {} graphics frame {}", RefractionLifecyclePhaseAt(this.m_lifecyclePhase).name, capturedFrame);
        ++this.m_lifecyclePhase;
        if(this.m_lifecyclePhase == s_RefractionLifecyclePhaseCount){
            [essential] info("RefractionLifecycle: complete samples=7");
            native(mut capture = this.m_framebufferCapture){
                capture->finish();
            }
            return true;
        }
        this.applyLifecyclePhase();
        const StringView nextPath = StringView(this.m_lifecyclePaths[this.m_lifecyclePhase]);
        b8 rearmed = false;
        native(in nextPath, mut capture = this.m_framebufferCapture, mut rearmed){
            rearmed = capture->rearm(nextPath);
        }
        if(!rearmed){
            error("RefractionSmokeProject: failed to advance lifecycle capture");
            return false;
        }
        return true;
    }

    private mut ProjectRuntimeContext m_context;
    private NotNullUniquePtr<World> m_world;
    private RefractionQueryDiagnostics m_queryDiagnostics;
    private UniquePtr<FramebufferCapture> m_framebufferCapture = UniquePtr<FramebufferCapture>();
    private AvboitTimingRenderPass m_timingRenderPass;
    private FpsProbe m_fpsProbe;
    private GpuPassTimingProbe m_gpuPassTimingProbe;
    private Vector<String> m_lifecyclePaths;
    private String m_frameGraphSnapshotPath;
    private Optional<u64> m_frameGraphTargetStart;
    private usize m_lifecyclePhase = 0u;
    private EntityID m_glass = s_InvalidEntityId;
    private b8 m_lifecycleEnabled = false;
    private b8 m_timingEnabled = false;
    private b8 m_densityEnabled = false;
    private b8 m_frameGraphSnapshotCompleted = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB::ProjectFrameClientSize NWB::QueryProjectFrameClientSize(){
    NWB::Core::Alloc::ScratchArena arena(Tests::Smoke::s_SmokeEnvironmentArena);
    const auto extent = ReadEnvironmentVariable(arena, "NWB_REFRACTION_SMOKE_EXTENT");
    NWB_FATAL_ASSERT_MSG(extent.has_value(), NWB_TEXT("RefractionSmokeProject: failed to read extent"));
    if(!*extent || **extent == "native" || **extent == "960x720")
        return { 960, 720 };
    if(**extent == "1600x900")
        return { 1600, 900 };
    if(**extent == "1920x1080")
        return { 1920, 1080 };
    NWB_FATAL_ASSERT_MSG(**extent == "npot", NWB_TEXT("RefractionSmokeProject: extent must be native, npot, 960x720, 1600x900, or 1920x1080"));
    return { 967, 727 };
}

TStringView NWB::QueryProjectWindowTitle()noexcept{ return NWB_TEXT("NWB Refraction Smoke"); }

UniquePtr<NWB::IProjectEntryCallbacks> NWB::CreateProjectEntryCallbacks(NWB::ProjectRuntimeContext& context){
    return MakeUnique<NWB::Tests::Smoke::RefractionSmokeProjectImpl>(context);
}


