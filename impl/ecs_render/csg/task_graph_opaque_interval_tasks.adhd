#include <impl/ecs_render/csg/csg_system.adhd>
#include <impl/ecs_render/deferred/deferred_frame_targets.adhd>
#include <impl/ecs_render/kernel/graphics_prefix_timing_ticket.adhd>
#include <impl/ecs_render/kernel/task_graph_scheduling.adhd>
#include <impl/ecs_render/material/material_system.adhd>
#include <impl/ecs_render/shared/task_graph_draw_snapshots.adhd>

class OpaqueCsgIntervalRecordInputs{
    public mut RendererMaterialSystem materialSystem;
    public mut RendererCsgSystem csgSystem;
    public mut DeferredFrameTargets targets;
    public in GraphicsPrefixTimingTicket timingTicket;
    public in b8 meshViewSetupReady;
    public in b8 sceneShadingSetupReady;
    public MeshFrameBindingSnapshot frameBindings;
    public CsgGraphResourceSnapshot csgResources;
    public OpaqueMaterialPassGraphSnapshot opaqueDrawSnapshot;
    public b8 materialDrawBuffersUploaded = false;
    public b8 csgFrameBuffersUploaded = false;

    public OpaqueCsgIntervalRecordInputs(mut RendererMaterialSystem materialSystem, mut RendererCsgSystem csgSystem, mut DeferredFrameTargets targets,
        in GraphicsPrefixTimingTicket ticket, in b8 meshReady, in b8 shadingReady){
        this.materialSystem = materialSystem;
        this.csgSystem = csgSystem;
        this.targets = targets;
        this.timingTicket = ticket;
        this.meshViewSetupReady = meshReady;
        this.sceneShadingSetupReady = shadingReady;
    }
}

enum<u8> OpaqueCsgComputeIntervalPass{ ReceiverSpan, Combine }

[modular]
class OpaqueCsgComputeIntervalGraphTask{
    public OpaqueCsgIntervalRecordInputs inputs;
    public OpaqueCsgComputeIntervalPass pass;
    public OpaqueCsgComputeIntervalGraphTask(mut RendererMaterialSystem materials, mut RendererCsgSystem csg, mut DeferredFrameTargets targets,
        in borrow GraphicsPrefixTimingTicket ticket, in borrow b8 meshReady, in borrow b8 shadingReady, in OpaqueCsgComputeIntervalPass pass){
        this.inputs = OpaqueCsgIntervalRecordInputs(materials, csg, targets, ticket, meshReady, shadingReady);
        this.pass = pass;
    }
    public GpuTaskCommandRequirements commandRequirements()const{ return SharedComputeEmulationCommandRequirements(true); }
    [cpp_unwind]
    public b8 record(mut CommandList commands, in GpuTaskRecordContext context)const;
}

[modular]
class OpaqueCsgIntervalSampleGraphTask{
    public OpaqueCsgIntervalRecordInputs inputs;
    public mut GraphicsRuntime graphics;
    public b8 materialFrameStatesGraphOwned = false;
    public b8 materialGeometryStatesGraphOwned = false;
    public b8 csgComputeEmulationOutputStatesGraphOwned = false;
    public Optional<mut Optional<GpuTimingMeasure>> opaqueCsgComputeEmulationTiming;

    public OpaqueCsgIntervalSampleGraphTask(mut GraphicsRuntime graphics, mut RendererMaterialSystem materials, mut RendererCsgSystem csg, mut DeferredFrameTargets targets,
        in borrow GraphicsPrefixTimingTicket ticket, in borrow b8 meshReady, in borrow b8 shadingReady){
        this.inputs = OpaqueCsgIntervalRecordInputs(materials, csg, targets, ticket, meshReady, shadingReady);
        this.graphics = graphics;
    }
    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Graphics | GpuQueueCapability::Compute); }
    [cpp_unwind]
    public b8 record(mut CommandList commands, in GpuTaskRecordContext context)const;
    public void discarded(){
        if(this.opaqueCsgComputeEmulationTiming.has_value())
            DiscardGpuTimingMeasure(this.opaqueCsgComputeEmulationTiming.value());
    }
}


