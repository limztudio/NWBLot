////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_font/asset.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Path BundledFontFixtureDirectory(in StringView repositoryRoot){
    return Path(repositoryRoot) / "impl" / "assets" / "ui" / "fonts" / "default";
}

Vector<u8> CopyFontFixtureBytes(in Span<u8> source){
    Vector<u8> bytes;
    AssignTriviallyCopyableVector(bytes, source);
    return bytes;
}

Expected<Vector<u8>, StringView> ReadBundledFontBytes(in Path fontPath){
    const auto prepared = ReadPreparedFontSource(fontPath, false);
    if(!prepared.has_value())
        return MakeUnexpected(prepared.error());
    return prepared.value().fontBytes;
}

b8 LoadBundledFont(mut Font font, in Path directory, in StringView filename){
    const auto bytes = ReadBundledFontBytes(directory / filename);
    if(!bytes.has_value())
        return false;
    font.setFontBytes(bytes.value(), 0u);
    return font.validatePayload();
}


void WriteLittleU32At(mut Vector<u8> bytes, in usize offset, in u32 value){
    bytes[offset] = cast<u8>(value & 0xffu);
    bytes[offset + 1u] = cast<u8>((value >> 8u) & 0xffu);
    bytes[offset + 2u] = cast<u8>((value >> 16u) & 0xffu);
    bytes[offset + 3u] = cast<u8>((value >> 24u) & 0xffu);
}


