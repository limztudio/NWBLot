#ifndef NWB_GRAPHICS_GI_SURFEL_RUNTIME_SLANGI
#define NWB_GRAPHICS_GI_SURFEL_RUNTIME_SLANGI


// Bindings shared by every pass that reads or updates the live surfel field. Snapshot resources remain trace-specific
// so the trace's read-only previous-frame contract stays explicit at its use site.


#include "surfel_heap_resources.slangi"


// The live field is selected by the common push block rather than a pass-local descriptor set. These aliases keep the
// maintenance and trace kernels readable while expanding to global heap accesses.
#define g_NwbSurfelConstants g_NwbHeapSurfelConstantBuffers[g_NwbSurfelHeapPushConstants.constantsHeapSlot]
#define g_NwbSurfelPool g_NwbHeapSurfelWritablePools[g_NwbSurfelHeapPushConstants.poolHeapSlot]


#endif


