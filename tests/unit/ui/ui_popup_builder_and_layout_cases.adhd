void VerifyUiPopupLayoutTests_OffscreenAnchorAndLargeGapStillProduceBoundedGeometry(){
    PopupOptions options = PopupOptions();
    options.anchor = MakeUiPopupRect(600.0f, -80.0f, 20.0f, 20.0f);
    options.size.x = 100.0f;
    options.size.y = 100.0f;
    options.side = PopupPlacementSide::Right;
    const DisplayMetrics display = MakeUiPopupDisplay(320.0f, 240.0f, 1.0f, 1.0f);
    const auto placementResult1 = PlacePopup(options, display);
    ASSERT_TRUE(placementResult1.has_value());
    PopupPlacement placement = placementResult1.value();
    ExpectUiRect(placement.bounds, MakeUiPopupRect(220.0f, 0.0f, 100.0f, 100.0f));
    EXPECT_EQ(placement.side, PopupPlacementSide::Left);
    options.gap = f32.max;
    const auto placementResult2 = PlacePopup(options, display);
    ASSERT_TRUE(placementResult2.has_value());
    placement = placementResult2.value();
    ExpectUiRect(placement.bounds, MakeUiPopupRect(220.0f, 0.0f, 100.0f, 100.0f));
    EXPECT_EQ(placement.side, PopupPlacementSide::Right);
}

void VerifyUiPopupLayoutTests_EmptyAnchorCanRepresentPointPlacement(){
    PopupOptions options = PopupOptions();
    options.anchor = MakeUiPopupRect(124.0f, 30.0f, 0.0f, 0.0f);
    options.size.x = 80.0f;
    options.size.y = 60.0f;
    const auto placementResult = PlacePopup(options, MakeUiPopupDisplay(320.0f, 240.0f, 1.0f, 1.0f));
    ASSERT_TRUE(placementResult.has_value());
    const PopupPlacement placement = placementResult.value();
    ExpectUiRect(placement.bounds, MakeUiPopupRect(124.0f, 34.0f, 80.0f, 60.0f));
    EXPECT_EQ(placement.side, PopupPlacementSide::Below);
}

void VerifyUiPopupLayoutTests_AsymmetricDpiChangesDoNotRescaleLogicalPlacement(){
    PopupOptions options = PopupOptions();
    options.anchor = MakeUiPopupRect(610.0f, 410.0f, 50.0f, 30.0f);
    const auto firstResult = PlacePopup(options, MakeUiPopupDisplay(680.0f, 480.0f, 1.0f, 1.0f));
    ASSERT_TRUE(firstResult.has_value());
    const PopupPlacement first = firstResult.value();
    const auto secondResult = PlacePopup(options, MakeUiPopupDisplay(680.0f, 480.0f, 2.5f, 1.25f));
    ASSERT_TRUE(secondResult.has_value());
    const PopupPlacement second = secondResult.value();
    ExpectUiRect(second.bounds, first.bounds);
    ExpectUiRect(second.viewport, first.viewport);
    EXPECT_EQ(second.side, first.side);
}

void VerifyUiPopupLayoutTests_InvalidInputsRejectPlacement(){
    const PopupOptions validOptions = PopupOptions();
    const DisplayMetrics validDisplay = MakeUiPopupDisplay(320.0f, 240.0f, 1.0f, 1.0f);
    PopupOptions options = validOptions;
    options.anchor.x = bit_cast<f32>(0x7fc00000u);
    ExpectUiPopupLayoutPlacementRejected(options, validDisplay);
    options = validOptions;
    options.anchor.height = -1.0f;
    ExpectUiPopupLayoutPlacementRejected(options, validDisplay);
    options = validOptions;
    options.anchor = MakeUiPopupRect(f32.max, 0.0f, f32.max, 0.0f);
    ExpectUiPopupLayoutPlacementRejected(options, validDisplay);
    options = validOptions;
    options.size.x = 0.0f;
    ExpectUiPopupLayoutPlacementRejected(options, validDisplay);
    options = validOptions;
    options.size.y = bit_cast<f32>(0x7f800000u);
    ExpectUiPopupLayoutPlacementRejected(options, validDisplay);
    options = validOptions;
    native(mut options){
        options.side = static_cast<PopupPlacementSide::Enum>(255u);
    }
    ExpectUiPopupLayoutPlacementRejected(options, validDisplay);
    options = validOptions;
    options.gap = -1.0f;
    ExpectUiPopupLayoutPlacementRejected(options, validDisplay);
    options = validOptions;
    options.gap = bit_cast<f32>(0x7fc00000u);
    ExpectUiPopupLayoutPlacementRejected(options, validDisplay);
    DisplayMetrics display = validDisplay;
    display.logicalWidth = 0.0f;
    ExpectUiPopupLayoutPlacementRejected(validOptions, display);
    display = validDisplay;
    display.logicalHeight = bit_cast<f32>(0x7f800000u);
    ExpectUiPopupLayoutPlacementRejected(validOptions, display);
    display = validDisplay;
    display.pixelScaleX = -1.0f;
    ExpectUiPopupLayoutPlacementRejected(validOptions, display);
    display = validDisplay;
    display.pixelScaleY = bit_cast<f32>(0x7fc00000u);
    ExpectUiPopupLayoutPlacementRejected(validOptions, display);
}

void VerifyUiPopupStateTests_OpenEpochAdvancesOnlyOnClosedToOpenTransitions(){
    PopupState state = PopupState();
    state.open();
    EXPECT_EQ(state.openGeneration(), 1u);
    state.open();
    EXPECT_EQ(state.openGeneration(), 1u);
    state.close();
    state.close();
    EXPECT_EQ(state.openGeneration(), 1u);
    state.open();
    EXPECT_EQ(state.openGeneration(), 2u);
}

void VerifyUiPopupStateTests_IndependentAndRecreatedStatesNeverShareInstanceIdentity(){
    u64 retiredIdentity = 0u;
    {
        PopupState retired = PopupState();
        retiredIdentity = retired.instanceGeneration();
        retired.open();
    }
    PopupState first = PopupState();
    PopupState second = PopupState();
    EXPECT_NE(first.instanceGeneration(), retiredIdentity);
    EXPECT_NE(second.instanceGeneration(), retiredIdentity);
    EXPECT_NE(first.instanceGeneration(), second.instanceGeneration());
}


