#include <impl/ecs_ui/toolkit/gpu/resource_versions.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 SameCachedGpuGlyph(in GpuVersion<GpuGlyphVersion> cached, in SharedGlyphPage page){
    return SameGlyphPageKey(cached.deref().m_page.deref().binding(), page.deref().binding());
}
b8 SameCachedGpuSdf(in GpuVersion<GpuSdfAtlasVersion> cached, in SharedSdfAtlasPage page){
    return SameSdfAtlasPageKey(cached.deref().m_page.deref().binding(), page.deref().binding());
}
b8 SameCachedGpuTexture(in GpuVersion<GpuTextureImageVersion> cached, in SharedImageSource source){
    return SameTextureImageKey(cached.deref().m_source.deref(), source.deref());
}

class GpuImageCache : NoCopy{
    private Vector<GpuVersion<GpuGlyphVersion>> m_glyphCache;
    private Vector<GpuVersion<GpuSdfAtlasVersion>> m_sdfCache;
    private Vector<GpuVersion<GpuTextureImageVersion>> m_textureCache;
    private u64 m_useTick = 0u;

    public mut Vector<GpuVersion<GpuGlyphVersion>> glyphs(){ return this.m_glyphCache; }
    public mut Vector<GpuVersion<GpuSdfAtlasVersion>> sdfs(){ return this.m_sdfCache; }
    public mut Vector<GpuVersion<GpuTextureImageVersion>> textures(){ return this.m_textureCache; }

    public u64 nextTick(){
        ++this.m_useTick;
        return this.m_useTick;
    }

    [cpp_unwind]
    public void reserve(){
        this.m_glyphCache.reserve(s_PaintMaxImages);
        this.m_sdfCache.reserve(s_PaintMaxImages);
        this.m_textureCache.reserve(s_PaintMaxImages);
    }
    public void clear(){
        this.m_glyphCache.clear();
        this.m_sdfCache.clear();
        this.m_textureCache.clear();
        this.m_useTick = 0u;
    }
    [cpp_unwind]
    public void trim(in DrawSnapshot snapshot){
        const usize missing = CountMissingCacheEntries(this.m_glyphCache, snapshot.glyphPages(), SameCachedGpuGlyph)
            + CountMissingCacheEntries(this.m_sdfCache, snapshot.sdfPages(), SameCachedGpuSdf)
            + CountMissingCacheEntries(this.m_textureCache, snapshot.textureImages(), SameCachedGpuTexture);
        if(!ShouldTrimGpuImageCache(this.m_glyphCache.size(), this.m_sdfCache.size(), this.m_textureCache.size(), missing))
            return;
        RetainReferencedCacheEntries(snapshot.glyphPages(), SameCachedGpuGlyph, this.m_glyphCache);
        RetainReferencedCacheEntries(snapshot.sdfPages(), SameCachedGpuSdf, this.m_sdfCache);
        RetainReferencedCacheEntries(snapshot.textureImages(), SameCachedGpuTexture, this.m_textureCache);
    }
    public void evict(){
        if(!this.m_glyphCache.empty()){
            usize oldest = 0u;
            u64 oldestTick = this.m_glyphCache[0u].deref().m_lastUsedTick;
            for(usize index = 1u; index < this.m_glyphCache.size(); ++index){
                const u64 tick = this.m_glyphCache[index].deref().m_lastUsedTick;
                if(tick < oldestTick){
                    oldestTick = tick;
                    oldest = index;
                }
            }
            const usize last = this.m_glyphCache.size() - 1u;
            if(oldest != last)
                this.m_glyphCache[oldest] = this.m_glyphCache[last];
            this.m_glyphCache.pop_back();
        }
        else if(!this.m_sdfCache.empty()){
            usize oldest = 0u;
            u64 oldestTick = this.m_sdfCache[0u].deref().m_lastUsedTick;
            for(usize index = 1u; index < this.m_sdfCache.size(); ++index){
                const u64 tick = this.m_sdfCache[index].deref().m_lastUsedTick;
                if(tick < oldestTick){
                    oldestTick = tick;
                    oldest = index;
                }
            }
            const usize last = this.m_sdfCache.size() - 1u;
            if(oldest != last)
                this.m_sdfCache[oldest] = this.m_sdfCache[last];
            this.m_sdfCache.pop_back();
        }
        else if(!this.m_textureCache.empty()){
            usize oldest = 0u;
            u64 oldestTick = this.m_textureCache[0u].deref().m_lastUsedTick;
            for(usize index = 1u; index < this.m_textureCache.size(); ++index){
                const u64 tick = this.m_textureCache[index].deref().m_lastUsedTick;
                if(tick < oldestTick){
                    oldestTick = tick;
                    oldest = index;
                }
            }
            const usize last = this.m_textureCache.size() - 1u;
            if(oldest != last)
                this.m_textureCache[oldest] = this.m_textureCache[last];
            this.m_textureCache.pop_back();
        }
    }
}


