const u32 s_MaterialBinaryMagic = 0x4D544C41u; // MTLA
const usize s_MaterialShaderEntryBytes = 65u;
const usize s_MaterialTypedLayoutBlockBytes = 80u;
const usize s_MaterialTypedLayoutFieldBytes = 88u;
const usize s_MaterialResourceReferenceBytes = 200u;

const u32 s_MaterialTypedWordBytes = 4u;
const u32 s_MaterialTypedValueComponentCount = 4u;
const u32 s_MaterialTypedValueRecordWordCount = 8u;

const StringView s_MaterialAvboitAccumulatePassLabel = "accumulate";
const StringView s_MaterialAvboitOccupancyPassLabel = "occupancy";
const StringView s_MaterialAvboitExtinctionPassLabel = "extinction";

const StringView s_MeshComputeArchiveStageText = "mesh_compute";
const StringView s_MeshComputeImplicitDefineText = "NWB_MESH_SHADER_EMULATION_COMPUTE";
const Name s_MeshComputeArchiveStageName = "mesh_compute";

const StringView s_MaterialEngineVirtualRoot = "engine";
const StringView s_MaterialProjectVirtualRoot = "project";

const u32 s_NoSurfaceDispatchId = 0xFFFFFFFFu;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[reflect]
flag<u32> MaterialFlag{
    None = 0u,
    Transparent,
    TwoSided,
    Refractive,
    All = Transparent | TwoSided | Refractive
}

[reflect]
enum<u32> MaterialParameterValueType{
    None = 0u,
    b8,
    i8,
    u8,
    i16,
    u16,
    i32,
    u32,
    f16,
    f32
}

[reflect]
enum<u32> MaterialBlockClass{
    None = 0u,
    MaterialConstant,
    MaterialMutable
}

b8 IsValidMaterialBlockClass(in MaterialBlockClass blockClass){
    return blockClass == MaterialBlockClass::MaterialConstant || blockClass == MaterialBlockClass::MaterialMutable;
}

[reflect]
enum<u32> MaterialResourceKind{
    None = 0u,
    SampledImage2D,
    Sampler
}

b8 IsValidMaterialResourceKind(in MaterialResourceKind resourceKind){
    return resourceKind == MaterialResourceKind::SampledImage2D || resourceKind == MaterialResourceKind::Sampler;
}

b8 IsValidSerializedMaterialResourceReference(in MaterialResourceKind resourceKind, in Name resourceName){
    return resourceName != s_NameNone && IsValidMaterialResourceKind(resourceKind);
}

// Resource fields name an engine/project asset resolved to a heap slot at runtime.
b8 IsMaterialAssetReference(in StringView resourceName){
    usize rootEnd = resourceName.size();
    for(usize i = 0u; i < resourceName.size(); ++i){
        if(resourceName[i] == '/'){
            rootEnd = i;
            break;
        }
    }
    if(rootEnd == 0u || rootEnd + 1u >= resourceName.size())
        return false;

    const StringView virtualRoot = resourceName.substr(0u, rootEnd);
    if(virtualRoot != s_MaterialEngineVirtualRoot && virtualRoot != s_MaterialProjectVirtualRoot)
        return false;

    usize componentBegin = rootEnd + 1u;
    for(usize index = componentBegin; index <= resourceName.size(); ++index){
        if(index != resourceName.size() && resourceName[index] != '/')
            continue;

        const StringView component = resourceName.substr(componentBegin, index - componentBegin);
        if(component.empty() || component == "." || component == "..")
            return false;
        for(usize charIndex = 0u; charIndex < component.size(); ++charIndex){
            if(component[charIndex] == '\\')
                return false;
        }
        componentBegin = index + 1u;
    }
    return true;
}

b8 IsSupportedMaterialResourceReference(in MaterialResourceKind resourceKind, in StringView resourceName){
    return IsValidMaterialResourceKind(resourceKind) && IsMaterialAssetReference(resourceName);
}

[reflect]
enum<u32> MaterialLayoutFieldType{
    None = 0u,
    b8,
    b8x2,
    b8x3,
    b8x4,
    i8,
    i8x2,
    i8x3,
    i8x4,
    u8,
    u8x2,
    u8x3,
    u8x4,
    i16,
    i16x2,
    i16x3,
    i16x4,
    u16,
    u16x2,
    u16x3,
    u16x4,
    i32,
    i32x2,
    i32x3,
    i32x4,
    u32,
    u32x2,
    u32x3,
    u32x4,
    f16,
    f16x2,
    f16x3,
    f16x4,
    f32,
    f32x2,
    f32x3,
    f32x4,
    // Resource fields occupy one patched uint heap slot in the typed-byte payload.
    // They intentionally live after the contiguous numeric range so a resource can never be mistaken for an authored uint parameter.
    SampledImage2D = 37u,
    Sampler
}

const u32 s_MaterialLayoutFieldComponentsPerValueType = 4u;
const u32 s_MaterialLayoutFieldFirstTypeId = cast<u32>(MaterialLayoutFieldType::b8);
const u32 s_MaterialParameterFirstValueTypeId = cast<u32>(MaterialParameterValueType::b8);

b8 IsValidMaterialLayoutFieldType(in MaterialLayoutFieldType fieldType){
    return cast<u32>(fieldType) >= cast<u32>(MaterialLayoutFieldType::b8) && cast<u32>(fieldType) <= cast<u32>(MaterialLayoutFieldType::Sampler);
}

b8 IsMaterialLayoutNumericFieldType(in MaterialLayoutFieldType fieldType){
    return cast<u32>(fieldType) >= cast<u32>(MaterialLayoutFieldType::b8) && cast<u32>(fieldType) <= cast<u32>(MaterialLayoutFieldType::f32x4);
}

b8 IsMaterialLayoutResourceFieldType(in MaterialLayoutFieldType fieldType){
    return fieldType == MaterialLayoutFieldType::SampledImage2D || fieldType == MaterialLayoutFieldType::Sampler;
}

MaterialResourceKind MaterialLayoutFieldResourceKind(in MaterialLayoutFieldType fieldType){
    switch(fieldType){
        case MaterialLayoutFieldType::SampledImage2D:
            return MaterialResourceKind::SampledImage2D;
        case MaterialLayoutFieldType::Sampler:
            return MaterialResourceKind::Sampler;
        default:
            return MaterialResourceKind::None;
    }
}

u32 MaterialLayoutFieldComponentCount(in MaterialLayoutFieldType fieldType){
    if(!IsMaterialLayoutNumericFieldType(fieldType))
        return 0u;

    return ((cast<u32>(fieldType) - s_MaterialLayoutFieldFirstTypeId) % s_MaterialLayoutFieldComponentsPerValueType) + 1u;
}

MaterialParameterValueType MaterialLayoutFieldValueType(in MaterialLayoutFieldType fieldType){
    if(!IsMaterialLayoutNumericFieldType(fieldType))
        return MaterialParameterValueType::None;

    const u32 valueTypeOffset = (cast<u32>(fieldType) - s_MaterialLayoutFieldFirstTypeId) / s_MaterialLayoutFieldComponentsPerValueType;
    return cast<MaterialParameterValueType>(s_MaterialParameterFirstValueTypeId + valueTypeOffset);
}

MaterialLayoutFieldType MaterialLayoutFieldTypeFromParameterType(in MaterialParameterValueType valueType, in u32 componentCount){
    if(componentCount == 0u || componentCount > s_MaterialLayoutFieldComponentsPerValueType)
        return MaterialLayoutFieldType::None;

    u32 firstFieldType = 0u;
    switch(valueType){
        case MaterialParameterValueType::b8: firstFieldType = cast<u32>(MaterialLayoutFieldType::b8); break;
        case MaterialParameterValueType::i8: firstFieldType = cast<u32>(MaterialLayoutFieldType::i8); break;
        case MaterialParameterValueType::u8: firstFieldType = cast<u32>(MaterialLayoutFieldType::u8); break;
        case MaterialParameterValueType::i16: firstFieldType = cast<u32>(MaterialLayoutFieldType::i16); break;
        case MaterialParameterValueType::u16: firstFieldType = cast<u32>(MaterialLayoutFieldType::u16); break;
        case MaterialParameterValueType::i32: firstFieldType = cast<u32>(MaterialLayoutFieldType::i32); break;
        case MaterialParameterValueType::u32: firstFieldType = cast<u32>(MaterialLayoutFieldType::u32); break;
        case MaterialParameterValueType::f16: firstFieldType = cast<u32>(MaterialLayoutFieldType::f16); break;
        case MaterialParameterValueType::f32: firstFieldType = cast<u32>(MaterialLayoutFieldType::f32); break;
        default: return MaterialLayoutFieldType::None;
    }

    return cast<MaterialLayoutFieldType>(firstFieldType + componentCount - 1u);
}

u32 MaterialParameterValueTypeByteSize(in MaterialParameterValueType valueType){
    switch(valueType){
        case MaterialParameterValueType::b8:
        case MaterialParameterValueType::i8:
        case MaterialParameterValueType::u8:
            return 1u;
        case MaterialParameterValueType::i16:
        case MaterialParameterValueType::u16:
        case MaterialParameterValueType::f16:
            return 2u;
        case MaterialParameterValueType::i32:
        case MaterialParameterValueType::u32:
        case MaterialParameterValueType::f32:
            return 4u;
        default:
            return 0u;
    }
}

u32 MaterialLayoutFieldByteSize(in MaterialLayoutFieldType fieldType){
    if(IsMaterialLayoutResourceFieldType(fieldType))
        return 4u;

    return MaterialLayoutFieldComponentCount(fieldType) * MaterialParameterValueTypeByteSize(MaterialLayoutFieldValueType(fieldType));
}

u32 MaterialLayoutFieldAlignment(in MaterialLayoutFieldType fieldType){
    if(IsMaterialLayoutResourceFieldType(fieldType))
        return 4u;

    return MaterialParameterValueTypeByteSize(MaterialLayoutFieldValueType(fieldType));
}

b8 TryAlignMaterialLayoutFieldOffset(in u32 byteOffset, in MaterialLayoutFieldType fieldType, mut u32 outOffset){
    const u32 alignment = MaterialLayoutFieldAlignment(fieldType);
    if(alignment == 0u || (alignment & (alignment - 1u)) != 0u){
        outOffset = 0u;
        return false;
    }
    const u32 mask = alignment - 1u;
    if(byteOffset > 0xFFFFFFFFu - mask){
        outOffset = 0u;
        return false;
    }
    outOffset = (byteOffset + mask) & ~mask;
    return true;
}

b8 TryAlignMaterialLayoutBlockByteSize(in u32 byteSize, mut u32 outAlignedSize){
    const u32 mask = s_MaterialTypedWordBytes - 1u;
    if(byteSize > 0xFFFFFFFFu - mask){
        outAlignedSize = 0u;
        return false;
    }
    outAlignedSize = (byteSize + mask) & ~mask;
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[reflect]
class MaterialTypedLayoutBlock{
    public Name blockName = s_NameNone;
    public MaterialBlockClass blockClass = MaterialBlockClass::None;
    public u32 fieldBegin = 0u;
    public u32 fieldCount = 0u;
    public u32 byteSize = 0u;
}

[reflect]
class MaterialTypedLayoutField{
    public Name fieldName = s_NameNone;
    public MaterialLayoutFieldType fieldType = MaterialLayoutFieldType::None;
    public u32 offset = 0u;
    public u32x4u defaultValue;
}

// A cooked material separates resource identity from its numeric/default payload.
// `constantByteOffset` is the slot word the renderer patches after resolving the descriptor handle.
// Exactly one typed reference is valid.
[reflect]
class MaterialResourceReference{
    public Name blockName = s_NameNone;
    public Name fieldName = s_NameNone;
    public AssetRef<Texture> textureAsset;
    public AssetRef<Sampler> samplerAsset;
    public MaterialResourceKind resourceKind = MaterialResourceKind::None;
    public u32 constantByteOffset = 0u;
}

[serialize]
class MaterialTypedLayoutBlockBinary{
    public NameHash blockNameHash;
    public u32 blockClass = 0u;
    public u32 fieldBegin = 0u;
    public u32 fieldCount = 0u;
    public u32 byteSize = 0u;
}

[serialize]
class MaterialTypedLayoutFieldBinary{
    public NameHash fieldNameHash;
    public u32 fieldType = 0u;
    public u32 offset = 0u;
    public u32x4u defaultValue;
}

// Deserialization initializes the typed asset reference; runtime patches its resolved heap slot at constantByteOffset.
[serialize]
class MaterialResourceReferenceBinary{
    public NameHash blockNameHash;
    public NameHash fieldNameHash;
    public NameHash resourceNameHash;
    public u32 resourceKind = 0u;
    public u32 constantByteOffset = 0u;
}

MaterialTypedLayoutBlockBinary PackMaterialTypedLayoutBlockBinary(in MaterialTypedLayoutBlock block){
    MaterialTypedLayoutBlockBinary blockBinary;
    blockBinary.blockNameHash = block.blockName.hash();
    blockBinary.blockClass = cast<u32>(block.blockClass);
    blockBinary.fieldBegin = block.fieldBegin;
    blockBinary.fieldCount = block.fieldCount;
    blockBinary.byteSize = block.byteSize;
    return blockBinary;
}

MaterialTypedLayoutBlock UnpackMaterialTypedLayoutBlockBinary(in MaterialTypedLayoutBlockBinary blockBinary){
    MaterialTypedLayoutBlock block;
    block.blockName = Name(blockBinary.blockNameHash);
    block.blockClass = cast<MaterialBlockClass>(blockBinary.blockClass);
    block.fieldBegin = blockBinary.fieldBegin;
    block.fieldCount = blockBinary.fieldCount;
    block.byteSize = blockBinary.byteSize;
    return block;
}

MaterialTypedLayoutFieldBinary PackMaterialTypedLayoutFieldBinary(in MaterialTypedLayoutField field){
    MaterialTypedLayoutFieldBinary fieldBinary;
    fieldBinary.fieldNameHash = field.fieldName.hash();
    fieldBinary.fieldType = cast<u32>(field.fieldType);
    fieldBinary.offset = field.offset;
    fieldBinary.defaultValue = field.defaultValue;
    return fieldBinary;
}

MaterialTypedLayoutField UnpackMaterialTypedLayoutFieldBinary(in MaterialTypedLayoutFieldBinary fieldBinary){
    MaterialTypedLayoutField field;
    field.fieldName = Name(fieldBinary.fieldNameHash);
    field.fieldType = cast<MaterialLayoutFieldType>(fieldBinary.fieldType);
    field.offset = fieldBinary.offset;
    field.defaultValue = fieldBinary.defaultValue;
    return field;
}

MaterialResourceReferenceBinary PackMaterialResourceReferenceBinary(in MaterialResourceReference resourceReference){
    MaterialResourceReferenceBinary resourceReferenceBinary;
    resourceReferenceBinary.blockNameHash = resourceReference.blockName.hash();
    resourceReferenceBinary.fieldNameHash = resourceReference.fieldName.hash();
    if(resourceReference.resourceKind == MaterialResourceKind::SampledImage2D)
        resourceReferenceBinary.resourceNameHash = resourceReference.textureAsset.name().hash();
    else
        resourceReferenceBinary.resourceNameHash = resourceReference.samplerAsset.name().hash();
    resourceReferenceBinary.resourceKind = cast<u32>(resourceReference.resourceKind);
    resourceReferenceBinary.constantByteOffset = resourceReference.constantByteOffset;
    return resourceReferenceBinary;
}

b8 TryAssignMaterialResourceReferenceAsset(in MaterialResourceKind resourceKind, in Name resourceName, mut MaterialResourceReference reference){
    switch(resourceKind){
        case MaterialResourceKind::SampledImage2D:
            reference.textureAsset.virtualPath = resourceName;
            return true;
        case MaterialResourceKind::Sampler:
            reference.samplerAsset.virtualPath = resourceName;
            return true;
        default:
            return false;
    }
}

b8 TryUnpackMaterialResourceReferenceBinary(in MaterialResourceReferenceBinary resourceReferenceBinary, mut MaterialResourceReference outReference){
    outReference = MaterialResourceReference();
    const MaterialResourceKind resourceKind = cast<MaterialResourceKind>(resourceReferenceBinary.resourceKind);
    const Name resourceName = Name(resourceReferenceBinary.resourceNameHash);
    if(!IsValidSerializedMaterialResourceReference(resourceKind, resourceName))
        return false;

    outReference.blockName = Name(resourceReferenceBinary.blockNameHash);
    outReference.fieldName = Name(resourceReferenceBinary.fieldNameHash);
    outReference.resourceKind = resourceKind;
    outReference.constantByteOffset = resourceReferenceBinary.constantByteOffset;
    return TryAssignMaterialResourceReferenceAsset(resourceKind, resourceName, outReference);
}

u32 PackMaterialFlags(in b8 transparent, in b8 twoSided, in b8 refractive){
    u32 materialFlags = 0u;
    if(transparent)
        materialFlags |= cast<u32>(MaterialFlag::Transparent);
    if(twoSided)
        materialFlags |= cast<u32>(MaterialFlag::TwoSided);
    if(refractive)
        materialFlags |= cast<u32>(MaterialFlag::Refractive);
    return materialFlags;
}

b8 TryUnpackMaterialFlags(in u32 materialFlags, mut b8 outTransparent, mut b8 outTwoSided, mut b8 outRefractive){
    if((materialFlags & ~cast<u32>(MaterialFlag::All)) != 0u)
        return false;
    outTransparent = (materialFlags & cast<u32>(MaterialFlag::Transparent)) != 0u;
    outTwoSided = (materialFlags & cast<u32>(MaterialFlag::TwoSided)) != 0u;
    outRefractive = (materialFlags & cast<u32>(MaterialFlag::Refractive)) != 0u;
    return true;
}

b8 ComputeMaterialTypedBlockByteSize(in Span<MaterialTypedLayoutBlock> blocks, mut usize outByteSize){
    usize byteSize = 0u;
    for(usize b = 0u; b < blocks.size(); ++b){
        const usize blockBytes = cast<usize>(blocks[b].byteSize);
        if(blockBytes > 0xFFFFFFFFFFFFFFFFul - byteSize){
            outByteSize = 0u;
            return false;
        }
        byteSize += blockBytes;
    }
    outByteSize = byteSize;
    return true;
}

b8 ValidateMaterialResourceReferences(in Span<MaterialTypedLayoutBlock> blocks, in Span<MaterialTypedLayoutField> fields, in Span<MaterialResourceReference> resourceReferences){
    usize resourceFieldCount = 0u;
    u32 constantByteBegin = 0u;
    for(usize b = 0u; b < blocks.size(); ++b){
        const MaterialTypedLayoutBlock block = blocks[b];
        if(!IsValidMaterialBlockClass(block.blockClass))
            return false;
        if(cast<usize>(block.fieldBegin) > fields.size() || cast<usize>(block.fieldCount) > fields.size() - cast<usize>(block.fieldBegin))
            return false;

        for(u32 fieldOffset = 0u; fieldOffset < block.fieldCount; ++fieldOffset){
            const MaterialTypedLayoutField field = fields[cast<usize>(block.fieldBegin) + cast<usize>(fieldOffset)];
            if(!IsMaterialLayoutResourceFieldType(field.fieldType))
                continue;

            // Descriptor slots are resolved during material preparation; instance overrides cannot replace them.
            if(block.blockClass != MaterialBlockClass::MaterialConstant)
                return false;
            if(field.offset > 0xFFFFFFFFu - constantByteBegin)
                return false;

            ++resourceFieldCount;
            const MaterialResourceKind expectedKind = MaterialLayoutFieldResourceKind(field.fieldType);
            const u32 expectedByteOffset = constantByteBegin + field.offset;
            b8 foundReference = false;
            for(usize r = 0u; r < resourceReferences.size(); ++r){
                const MaterialResourceReference resourceReference = resourceReferences[r];
                if(resourceReference.blockName != block.blockName || resourceReference.fieldName != field.fieldName)
                    continue;
                if(foundReference)
                    return false;
                if(resourceReference.resourceKind != expectedKind || resourceReference.constantByteOffset != expectedByteOffset)
                    return false;

                switch(expectedKind){
                    case MaterialResourceKind::SampledImage2D:
                        if(!resourceReference.textureAsset.valid() || resourceReference.samplerAsset.valid())
                            return false;
                        break;
                    case MaterialResourceKind::Sampler:
                        if(!resourceReference.samplerAsset.valid() || resourceReference.textureAsset.valid())
                            return false;
                        break;
                    default:
                        return false;
                }

                foundReference = true;
            }
            if(!foundReference)
                return false;
        }

        if(block.blockClass == MaterialBlockClass::MaterialConstant){
            if(block.byteSize > 0xFFFFFFFFu - constantByteBegin)
                return false;
            constantByteBegin += block.byteSize;
        }
    }

    // Each record maps to one resource field. Dup rejects above also block stray numeric/mutable refs.
    return resourceFieldCount == resourceReferences.size();
}

// Transparent materials need all three pass shaders; opaque materials carry none.
b8 HasValidMaterialAvboitPixelShaderContract(
    in b8 transparent,
    in AssetRef<PixelShader> accumulatePixelShader,
    in AssetRef<PixelShader> occupancyPixelShader,
    in AssetRef<PixelShader> extinctionPixelShader
){
    if(transparent)
        return accumulatePixelShader.valid() && occupancyPixelShader.valid() && extinctionPixelShader.valid();

    return !accumulatePixelShader.valid() && !occupancyPixelShader.valid() && !extinctionPixelShader.valid();
}

const u64 s_MaterialFnv64OffsetBasis = 14695981039346656037ull;
const u64 s_MaterialFnv64Prime = 1099511628211ull;
const StringView s_MaterialTypedLayoutHashHeader = "NWB_MATERIAL_TYPED_LAYOUT_V1";

u64 UpdateMaterialFnv64Byte(in u64 hash, in u8 byteValue){
    return (hash ^ cast<u64>(byteValue)) * s_MaterialFnv64Prime;
}

u64 UpdateMaterialFnv64U32(in u64 hash, in u32 value){
    u64 result = hash;
    for(u32 byteIndex = 0u; byteIndex < 4u; ++byteIndex){
        const u8 byteValue = cast<u8>((value >> (byteIndex * 8u)) & 0xffu);
        result = UpdateMaterialFnv64Byte(result, byteValue);
    }
    return result;
}

u64 UpdateMaterialFnv64U64(in u64 hash, in u64 value){
    u64 result = hash;
    for(u32 byteIndex = 0u; byteIndex < 8u; ++byteIndex){
        const u8 byteValue = cast<u8>((value >> (byteIndex * 8u)) & 0xffull);
        result = UpdateMaterialFnv64Byte(result, byteValue);
    }
    return result;
}

u64 UpdateMaterialFnv64NameHash(in u64 hash, in NameHash nameHash){
    u64 result = hash;
    for(usize lane = 0u; lane < nameHash.qwords.size(); ++lane)
        result = UpdateMaterialFnv64U64(result, nameHash.qwords[lane]);
    return result;
}

u64 ComputeMaterialTypedLayoutHash(in Span<MaterialTypedLayoutBlock> blocks, in Span<MaterialTypedLayoutField> fields){
    if(blocks.empty() && fields.empty())
        return 0u;

    u64 hash = s_MaterialFnv64OffsetBasis;
    for(usize i = 0u; i < s_MaterialTypedLayoutHashHeader.size(); ++i)
        hash = UpdateMaterialFnv64Byte(hash, cast<u8>(s_MaterialTypedLayoutHashHeader[i]));
    hash = UpdateMaterialFnv64U32(hash, cast<u32>(blocks.size()));
    hash = UpdateMaterialFnv64U32(hash, cast<u32>(fields.size()));
    for(usize i = 0u; i < blocks.size(); ++i){
        const MaterialTypedLayoutBlock block = blocks[i];
        hash = UpdateMaterialFnv64NameHash(hash, block.blockName.hash());
        hash = UpdateMaterialFnv64U32(hash, cast<u32>(block.blockClass));
        hash = UpdateMaterialFnv64U32(hash, block.fieldBegin);
        hash = UpdateMaterialFnv64U32(hash, block.fieldCount);
        hash = UpdateMaterialFnv64U32(hash, block.byteSize);
    }
    for(usize i = 0u; i < fields.size(); ++i){
        const MaterialTypedLayoutField field = fields[i];
        hash = UpdateMaterialFnv64NameHash(hash, field.fieldName.hash());
        hash = UpdateMaterialFnv64U32(hash, cast<u32>(field.fieldType));
        hash = UpdateMaterialFnv64U32(hash, field.offset);
        hash = UpdateMaterialFnv64U32(hash, field.defaultValue.x);
        hash = UpdateMaterialFnv64U32(hash, field.defaultValue.y);
        hash = UpdateMaterialFnv64U32(hash, field.defaultValue.z);
        hash = UpdateMaterialFnv64U32(hash, field.defaultValue.w);
    }
    return hash;
}

[reflect]
enum<u8> MaterialTypedLayoutValidationStatus{
    Valid = 0u,
    EmptyLayout,
    ZeroHash,
    MissingBlocksOrFields,
    EmptyBlockName,
    InvalidBlockClass,
    NonContiguousFieldRange,
    FieldRangeExceedsCount,
    EmptyFieldName,
    InvalidFieldType,
    FieldAlignmentOverflow,
    MisalignedFieldOffset,
    FieldByteSizeOverflow,
    BlockByteSizeOverflow,
    BlockByteSizeMismatch,
    UnownedFields,
    LayoutHashMismatch,
    TotalBlockByteSizeOverflow,
    TotalBlockByteCountMismatch
}

MaterialTypedLayoutValidationStatus ValidateMaterialTypedLayout(
    in u64 layoutHash,
    in Span<MaterialTypedLayoutBlock> blocks,
    in Span<MaterialTypedLayoutField> fields,
    in usize blockByteCount,
    mut usize outFailureIndex
){
    outFailureIndex = 0u;
    if(blocks.empty() && fields.empty())
        return MaterialTypedLayoutValidationStatus::EmptyLayout;
    if(layoutHash == 0u)
        return MaterialTypedLayoutValidationStatus::ZeroHash;
    if(blocks.empty() || fields.empty())
        return MaterialTypedLayoutValidationStatus::MissingBlocksOrFields;

    u32 nextFieldBegin = 0u;
    for(usize blockIndex = 0u; blockIndex < blocks.size(); ++blockIndex){
        const MaterialTypedLayoutBlock block = blocks[blockIndex];
        if(block.blockName == s_NameNone){
            outFailureIndex = blockIndex;
            return MaterialTypedLayoutValidationStatus::EmptyBlockName;
        }
        if(!IsValidMaterialBlockClass(block.blockClass)){
            outFailureIndex = blockIndex;
            return MaterialTypedLayoutValidationStatus::InvalidBlockClass;
        }
        if(block.fieldBegin != nextFieldBegin){
            outFailureIndex = blockIndex;
            return MaterialTypedLayoutValidationStatus::NonContiguousFieldRange;
        }
        if(block.fieldCount == 0u || cast<usize>(block.fieldCount) > fields.size() - cast<usize>(block.fieldBegin)){
            outFailureIndex = blockIndex;
            return MaterialTypedLayoutValidationStatus::FieldRangeExceedsCount;
        }

        u32 expectedOffset = 0u;
        for(u32 fieldOffset = 0u; fieldOffset < block.fieldCount; ++fieldOffset){
            const usize fieldIndex = cast<usize>(block.fieldBegin) + cast<usize>(fieldOffset);
            const MaterialTypedLayoutField field = fields[fieldIndex];
            if(field.fieldName == s_NameNone){
                outFailureIndex = fieldIndex;
                return MaterialTypedLayoutValidationStatus::EmptyFieldName;
            }
            if(!IsValidMaterialLayoutFieldType(field.fieldType)){
                outFailureIndex = fieldIndex;
                return MaterialTypedLayoutValidationStatus::InvalidFieldType;
            }

            u32 expectedFieldOffset = 0u;
            if(!TryAlignMaterialLayoutFieldOffset(expectedOffset, field.fieldType, expectedFieldOffset)){
                outFailureIndex = fieldIndex;
                return MaterialTypedLayoutValidationStatus::FieldAlignmentOverflow;
            }
            if(field.offset != expectedFieldOffset){
                outFailureIndex = fieldIndex;
                return MaterialTypedLayoutValidationStatus::MisalignedFieldOffset;
            }

            const u32 fieldByteSize = MaterialLayoutFieldByteSize(field.fieldType);
            if(fieldByteSize == 0u || expectedFieldOffset > 0xFFFFFFFFu - fieldByteSize){
                outFailureIndex = fieldIndex;
                return MaterialTypedLayoutValidationStatus::FieldByteSizeOverflow;
            }
            expectedOffset = expectedFieldOffset + fieldByteSize;
        }

        u32 expectedBlockByteSize = 0u;
        if(!TryAlignMaterialLayoutBlockByteSize(expectedOffset, expectedBlockByteSize)){
            outFailureIndex = blockIndex;
            return MaterialTypedLayoutValidationStatus::BlockByteSizeOverflow;
        }
        if(expectedBlockByteSize != block.byteSize){
            outFailureIndex = blockIndex;
            return MaterialTypedLayoutValidationStatus::BlockByteSizeMismatch;
        }

        nextFieldBegin += block.fieldCount;
    }

    if(cast<usize>(nextFieldBegin) != fields.size())
        return MaterialTypedLayoutValidationStatus::UnownedFields;

    const u64 computedHash = ComputeMaterialTypedLayoutHash(blocks, fields);
    if(computedHash != layoutHash)
        return MaterialTypedLayoutValidationStatus::LayoutHashMismatch;

    usize expectedBlockByteSize = 0u;
    if(!ComputeMaterialTypedBlockByteSize(blocks, expectedBlockByteSize))
        return MaterialTypedLayoutValidationStatus::TotalBlockByteSizeOverflow;
    if(blockByteCount != expectedBlockByteSize)
        return MaterialTypedLayoutValidationStatus::TotalBlockByteCountMismatch;

    return MaterialTypedLayoutValidationStatus::Valid;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

