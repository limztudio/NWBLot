void VerifyNumericLifetimeTests_CapacityAndInvalidUtf8FailuresPreserveEveryDraftField(mut NumericLifetimeIntegerFixture self){
    String maximum = "";
    maximum.reserve(s_NumericEditMaxBytes);
    for(usize index = 0u; index + 1u < s_NumericEditMaxBytes; ++index)
        maximum += "0";
    maximum += "7";
    ASSERT_TRUE(self.m_model.setDraft(StringView(maximum.data(), maximum.size())));
    ASSERT_TRUE(self.m_model.submit().committed);
    EXPECT_EQ(self.m_model.value(), 7);
    EXPECT_FALSE(self.m_model.dirty());
    ASSERT_TRUE(self.m_model.lendDraft().setSelection(0u, 1u));
    ASSERT_TRUE(self.m_model.lendDraft().beginComposition());
    ASSERT_TRUE(self.m_model.lendDraft().updateComposition("9", 0u, 1u));
    const UiNumericLifetimeDraftSnapshot before = UiNumericLifetimeDraftSnapshot(self.m_arena, self.m_model.draft());
    const u64 epoch = self.m_model.revision();
    String excessive = "";
    excessive.reserve(s_NumericEditMaxBytes + 1u);
    for(usize index = 0u; index < s_NumericEditMaxBytes + 1u; ++index)
        excessive += "0";
    const StringView excessiveView = StringView(excessive.data(), excessive.size());
    EXPECT_FALSE(self.m_model.setDraft(excessiveView));
    EXPECT_FALSE(self.m_model.setDraft("\xC0\xAF"));
    EXPECT_FALSE(self.m_model.setDraft("1\n2"));
    EXPECT_FALSE(self.m_model.lendDraft().replaceSelection(excessiveView));
    EXPECT_EQ(self.m_model.revision(), epoch);
    EXPECT_EQ(self.m_model.value(), 7);
    EXPECT_FALSE(self.m_model.dirty());
    before.expectUnchanged(self.m_model.draft());
}

