#include <impl/ecs_render/raytrace/ray_trace_material_resources.adhd>
#include <impl/ecs_render/raytrace/raytracing_system.adhd>
#include <impl/ecs_render/shadow/rt_shadow_state.adhd>
#include <impl/ecs_render/shadow/prepared_shadow_material_context.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CanCapturePreparedShadowMaterialContext(
    in PreparedShadowMaterialContextRoute route,
    in usize instanceMaterialCount,
    in usize instanceCount,
    in usize materialTypedByteCount,
    in b8 validStorage
){
    return route != PreparedShadowMaterialContextRoute::None
        && instanceMaterialCount != 0u
        && instanceCount != 0u
        && materialTypedByteCount != 0u
        && validStorage;
}

b8 CanCapturePreparedShadowMaterialContextCacheReuse(
    in PreparedShadowMaterialContextRoute route,
    in usize instanceMaterialCount,
    in usize instanceCount,
    in usize materialTypedByteCount,
    in b8 hwHashValid,
    in u64 hwHash,
    in b8 swHashValid,
    in u64 swHash,
    in u64 expectedHash,
    in b8 validStorage
){
    if(instanceMaterialCount == 0u || instanceCount == 0u || materialTypedByteCount == 0u || !validStorage)
        return false;
    if(route == PreparedShadowMaterialContextRoute::Hardware)
        return hwHashValid && hwHash == expectedHash;
    if(route == PreparedShadowMaterialContextRoute::Software)
        return swHashValid && swHash == expectedHash;
    return false;
}

b8 PreparedShadowMaterialContext::capture(
    in RendererRayTracingState state,
    in PreparedShadowMaterialContextRoute route,
    in b8 staticScene,
    in u64 hash,
    in Span<NwbRtInstanceMaterialGpu> instanceMaterials,
    in Span<InstanceGpuData> instances,
    in Span<u8> materialTypedBytes
){
    const usize instanceMaterialCount = instanceMaterials.size();
    const usize instanceCount = instances.size();
    const usize materialTypedByteCount = materialTypedBytes.size();
    const b8 validStorage = IsPreparedShadowMaterialStorageReady(state, instanceMaterialCount, instanceCount, materialTypedByteCount);
    if(!CanCapturePreparedShadowMaterialContext(route, instanceMaterialCount, instanceCount, materialTypedByteCount, validStorage))
        return false;

    this.clear();
    ShadowMaterialContextPolicy().captureBytes(
        instanceMaterials,
        instances,
        materialTypedBytes,
        this.m_instanceMaterialBytes,
        this.m_instanceBytes,
        this.m_materialTypedBytes
    );
    this.captureStorage(state, hash, instanceMaterialCount, instanceCount, materialTypedByteCount);
    this.m_route = route;
    this.m_static = staticScene;
    this.m_ready = true;
    this.m_uploadRequired = true;
    return true;
}

b8 PreparedShadowMaterialContext::captureCacheReuse(
    in RendererRayTracingState state,
    in PreparedShadowMaterialContextRoute route,
    in u64 hash,
    in usize instanceMaterialCount,
    in usize instanceCount,
    in usize materialTypedByteCount
){
    this.clear();
    const b8 validStorage = IsPreparedShadowMaterialStorageReady(state, instanceMaterialCount, instanceCount, materialTypedByteCount);
    if(!CanCapturePreparedShadowMaterialContextCacheReuse(
        route,
        instanceMaterialCount,
        instanceCount,
        materialTypedByteCount,
        state.shadow.m_hwShadowMaterialContextHashValid,
        state.shadow.m_hwShadowMaterialContextHash,
        state.shadow.m_swShadowMaterialContextHashValid,
        state.shadow.m_swShadowMaterialContextHash,
        hash,
        validStorage
    ))
        return false;

    this.captureStorage(state, hash, instanceMaterialCount, instanceCount, materialTypedByteCount);
    this.m_route = route;
    this.m_static = true;
    this.m_ready = true;
    this.m_uploadRequired = false;
    return true;
}


Expected<PreparedShadowMaterialContextUploads> PreparedShadowMaterialContext::retainUploads(in RendererRayTracingState state, mut GpuTaskGraph graph)const{
    PreparedShadowMaterialContextUploads result;
    if(!this.m_ready)
        return result;

    if(!ShadowMaterialContextPolicy().validateRetainStateForRoute(
        this.m_route,
        this.m_instanceMaterialCount,
        this.m_instanceCount,
        this.m_materialTypedUploadBytes,
        this.storageMatches(state),
        state.shadow.m_shadowInstanceMaterialCapacity,
        this.m_instanceMaterialCapacity,
        state.shadow.m_shadowInstanceCapacity,
        this.m_instanceCapacity,
        state.shadow.m_shadowMaterialTypedCapacity,
        this.m_materialTypedCapacity,
        IsPreparedShadowMaterialStorageReady(state, this.m_instanceMaterialCount, this.m_instanceCount, this.m_materialTypedUploadBytes),
        this.m_uploadRequired,
        this.m_static,
        state.shadow.m_hwShadowMaterialContextHashValid,
        state.shadow.m_hwShadowMaterialContextHash,
        state.shadow.m_swShadowMaterialContextHashValid,
        state.shadow.m_swShadowMaterialContextHash,
        this.m_hash,
        state.sceneBvh.m_sceneBvhInstanceCount,
        this.m_instanceMaterialBytes.size(),
        this.m_instanceBytes.size(),
        this.m_materialTypedBytes.size()
    ))
        return MakeUnexpected(Failure());
    if(!this.m_uploadRequired)
        return result;

    const Expected<GpuUploadBlobId> instanceMaterialResult = graph.copyUploadBytes<NwbRtInstanceMaterialGpu>(Span<u8>(this.m_instanceMaterialBytes));
    const Expected<GpuUploadBlobId> instanceResult = graph.copyUploadBytes<InstanceGpuData>(Span<u8>(this.m_instanceBytes));
    const Expected<GpuUploadBlobId> materialTypedResult = graph.copyUploadBytes<u32>(Span<u8>(this.m_materialTypedBytes));
    if(!(instanceMaterialResult.has_value() && instanceResult.has_value() && materialTypedResult.has_value()))
        return MakeUnexpected(Failure());
    result.instanceMaterial = instanceMaterialResult.value();
    result.instance = instanceResult.value();
    result.materialTyped = materialTypedResult.value();
    return result;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 RayTraceMaterialResources::ensureShadowInstanceMaterialBuffer(in usize instanceCount){
    if(this.m_shadow.m_shadowInstanceMaterialBuffer.valid() && this.m_shadow.m_shadowInstanceMaterialCapacity >= instanceCount)
        return this.ensureRayTraceMaterialContextHeapHandle(this.m_shadow.m_shadowInstanceMaterialBuffer.deref(), this.m_shadow.m_shadowInstanceMaterialHeapHandle);

    const usize capacity = NextGrowingCapacity(this.m_shadow.m_shadowInstanceMaterialCapacity, instanceCount, s_ShadowInstanceMaterialInitialCapacity);

    BufferDesc materialBufferDesc;
    materialBufferDesc
        .setByteSize(cast<u64>(sizeof(NwbRtInstanceMaterialGpu) * capacity))
        .setStructStride(sizeof(NwbRtInstanceMaterialGpu))
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
        .setDebugName(s_ShadowResourceInstanceMaterial)
        .enableAutomaticStateTracking(ResourceStates::Common)
    ;
    const Expected<BufferHandle> materialBufferResult = this.m_graphics.createBuffer(materialBufferDesc);
    if(!materialBufferResult.has_value()){
        error("RendererSystem: failed to create shadow instance material buffer");
        return false;
    }
    BufferHandle materialBuffer = materialBufferResult.value();
    if(!this.replaceRayTraceMaterialContextHeapHandle(materialBuffer.deref(), this.m_shadow.m_shadowInstanceMaterialHeapHandle))
        return false;
    this.m_shadow.m_shadowInstanceMaterialBuffer = materialBuffer;
    this.m_shadow.m_shadowInstanceMaterialCapacity = capacity;
    return true;
}

b8 RayTraceMaterialResources::ensureShadowInstanceContextBuffer(in usize instanceCount){
    if(instanceCount == 0u){
        if(!this.m_shadow.m_shadowInstanceBuffer.valid())
            return true;
        return this.ensureRayTraceMaterialContextHeapHandle(this.m_shadow.m_shadowInstanceBuffer.deref(), this.m_shadow.m_shadowInstanceHeapHandle)
            && this.ensureWritableRayTraceMaterialContextHeapHandle(this.m_shadow.m_shadowInstanceBuffer.deref(), this.m_shadow.m_shadowInstanceUavHeapHandle);
    }
    if(this.m_shadow.m_shadowInstanceBuffer.valid() && this.m_shadow.m_shadowInstanceCapacity >= instanceCount){
        return this.ensureRayTraceMaterialContextHeapHandle(this.m_shadow.m_shadowInstanceBuffer.deref(), this.m_shadow.m_shadowInstanceHeapHandle)
            && this.ensureWritableRayTraceMaterialContextHeapHandle(this.m_shadow.m_shadowInstanceBuffer.deref(), this.m_shadow.m_shadowInstanceUavHeapHandle);
    }

    const usize capacity = NextGrowingCapacity(this.m_shadow.m_shadowInstanceCapacity, instanceCount);
    BufferDesc instanceBufferDesc;
    instanceBufferDesc
        .setByteSize(cast<u64>(capacity * sizeof(InstanceGpuData)))
        .setStructStride(sizeof(InstanceGpuData))
        .setCanHaveUAVs(true)
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
        .setDebugName(s_ShadowResourceInstanceContext)
        .enableAutomaticStateTracking(ResourceStates::Common)
    ;
    const Expected<BufferHandle> instanceBufferResult = this.m_graphics.createBuffer(instanceBufferDesc);
    if(!instanceBufferResult.has_value()){
        error("RendererSystem: failed to create shadow instance context buffer");
        return false;
    }
    BufferHandle instanceBuffer = instanceBufferResult.value();
    if(
        !this.replaceRayTraceMaterialContextHeapHandle(instanceBuffer.deref(), this.m_shadow.m_shadowInstanceHeapHandle)
        || !this.replaceWritableRayTraceMaterialContextHeapHandle(instanceBuffer.deref(), this.m_shadow.m_shadowInstanceUavHeapHandle)
    )
        return false;
    this.m_shadow.m_shadowInstanceBuffer = instanceBuffer;
    this.m_shadow.m_shadowInstanceCapacity = capacity;
    return true;
}

b8 RayTraceMaterialResources::ensureShadowMaterialTypedBuffer(in usize byteCount){
    const usize requiredByteCount = ResolveMaterialTypedBufferByteCount(byteCount, sizeof(u32));
    if(this.m_shadow.m_shadowMaterialTypedBuffer.valid() && this.m_shadow.m_shadowMaterialTypedCapacity >= requiredByteCount)
        return this.ensureRayTraceMaterialContextHeapHandle(this.m_shadow.m_shadowMaterialTypedBuffer.deref(), this.m_shadow.m_shadowMaterialTypedHeapHandle);

    const usize capacity = NextGrowingCapacity(this.m_shadow.m_shadowMaterialTypedCapacity, requiredByteCount);
    BufferDesc materialTypedBufferDesc;
    materialTypedBufferDesc
        .setByteSize(cast<u64>(capacity))
        .setStructStride(sizeof(u32))
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
        .setDebugName(s_ShadowResourceMaterialTyped)
        .enableAutomaticStateTracking(ResourceStates::Common)
    ;
    const Expected<BufferHandle> materialTypedBufferResult = this.m_graphics.createBuffer(materialTypedBufferDesc);
    if(!materialTypedBufferResult.has_value()){
        error("RendererSystem: failed to create shadow material typed buffer");
        return false;
    }
    BufferHandle materialTypedBuffer = materialTypedBufferResult.value();
    if(!this.replaceRayTraceMaterialContextHeapHandle(materialTypedBuffer.deref(), this.m_shadow.m_shadowMaterialTypedHeapHandle))
        return false;
    this.m_shadow.m_shadowMaterialTypedBuffer = materialTypedBuffer;
    this.m_shadow.m_shadowMaterialTypedCapacity = capacity;
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void RendererRayTracingSystem::confirmPreparedShadowMaterialContextUploads(){
    if(this.m_preparedShadowMaterialContext.publishAcceptedUpload(this.m_rayTracingState))
        this.clearPreparedShadowMaterialContext();
}

b8 RendererRayTracingSystem::capturePreparedShadowMaterialContext(
    in PreparedShadowMaterialContextRoute route,
    in b8 staticScene,
    in u64 hash,
    in Span<NwbRtInstanceMaterialGpu> instanceMaterials,
    in Span<InstanceGpuData> instances,
    in Span<u8> materialTypedBytes
){
    if(!this.m_preparedShadowMaterialContext.capture(this.m_rayTracingState, route, staticScene, hash, instanceMaterials, instances, materialTypedBytes))
        return false;
    this.m_preparedSceneSwBvhTraversal.clear();
    return true;
}

b8 RendererRayTracingSystem::capturePreparedShadowMaterialContextCacheReuse(in PreparedShadowMaterialContextRoute route, in u64 hash, in usize instanceMaterialCount, in usize instanceCount, in usize materialTypedByteCount){
    this.m_preparedSceneSwBvhTraversal.clear();
    return this.m_preparedShadowMaterialContext.captureCacheReuse(this.m_rayTracingState, route, hash, instanceMaterialCount, instanceCount, materialTypedByteCount);
}

void RendererRayTracingSystem::clearPreparedShadowMaterialContext(){
    this.m_preparedShadowMaterialContext.clear();
    this.m_preparedSceneSwBvhTraversal.clear();
    this.m_preparedShadowInstanceEntityIds.clear();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static_assert(size_of<InstanceGpuData>() == s_InstanceGpuDataByteSize);


