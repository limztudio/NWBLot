void VerifyUiBuilderTextShapingTests_InvalidPolicyPreservesPreviousShapingAndOpenScopeMutationFails(mut UiBuilderTextShapingTests self){
    ASSERT_TRUE(self.installKoreanFallback());
    self.addEditRegion();
    ASSERT_TRUE(self.m_skin.validatePayload());
    ASSERT_TRUE(self.m_builder.setTextShaping(PackFourCharTag('H', 'a', 'n', 'g'), "ko", TextDirection::LeftToRight));
    EXPECT_FALSE(self.m_builder.setTextShaping(0u, "ko", TextDirection::LeftToRight));
    EXPECT_FALSE(self.m_builder.setTextShaping(PackFourCharTag('L', 'a', 't', 'n'), "ko!", TextDirection::LeftToRight));
    ASSERT_FALSE(self.m_builder.failed());
    EditModel model = EditModel();
    ASSERT_TRUE(model.setText(s_UiBuilderTextShapingJamo));
    EditBoxState state = EditBoxState();

    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginPanel("panel", Rect(0.0f, 0.0f, 400.0f, 180.0f)));
    ASSERT_TRUE(self.m_builder.label("label", s_UiBuilderTextShapingJamo));
    ASSERT_TRUE(self.m_builder.editBox("edit", model, state).valid);
    ASSERT_TRUE(self.finishPanel());
    const DrawSnapshot snapshot = self.m_paint.freeze();
    EXPECT_EQ(CountUiBuilderTextShapingGlyphQuads(snapshot), 2u);
    ASSERT_TRUE(self.m_context.commitFrame(1u));

    ASSERT_TRUE(self.begin(2u));
    ASSERT_TRUE(self.m_builder.beginPanel("panel", Rect(0.0f, 0.0f, 400.0f, 100.0f)));
    EXPECT_FALSE(self.m_builder.setTextShaping(PackFourCharTag('L', 'a', 't', 'n'), "en", TextDirection::LeftToRight));
    EXPECT_TRUE(self.m_builder.failed());
    EXPECT_FALSE(self.m_builder.endPanel());
}

void VerifyUiBuilderTextShapingTests_TextDirectionUpdatesLabelListEditBoxAndRejectsInvalidDirection(mut UiBuilderTextShapingTests self){
    ASSERT_TRUE(self.installKoreanFallback());
    self.addEditRegion();
    ASSERT_TRUE(self.m_skin.validatePayload());
    EXPECT_EQ(self.m_builder.textDirection(), TextDirection::LeftToRight);
    EXPECT_FALSE(self.m_builder.setTextDirection(cast<TextDirection>(99u)));
    EXPECT_FALSE(self.m_builder.failed());
    EXPECT_EQ(self.m_builder.textDirection(), TextDirection::LeftToRight);

    ASSERT_TRUE(self.m_builder.setTextShaping(PackFourCharTag('A', 'r', 'a', 'b'), "ar", TextDirection::RightToLeft));
    EXPECT_EQ(self.m_builder.textDirection(), TextDirection::RightToLeft);

    EditModel model = EditModel();
    ASSERT_TRUE(model.setText("abc"));
    EditBoxState editState = EditBoxState();
    ArithmeticSource listSource = ArithmeticSource();
    ListState listState = ListState();
    ListOptions listOpts = ListOptions();
    listOpts.width.policy = LayoutSizePolicy::Fixed;
    listOpts.width.value = 160.0f;
    listOpts.height.policy = LayoutSizePolicy::Fixed;
    listOpts.height.value = 80.0f;

    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginPanel("panel", Rect(0.0f, 0.0f, 400.0f, 220.0f)));
    ASSERT_TRUE(self.m_builder.label("lbl", "abc"));
    ASSERT_TRUE(self.m_builder.virtualList("list", listSource, listState, listOpts).valid);
    ASSERT_TRUE(self.m_builder.editBox("edit", model, editState).valid);
    ASSERT_TRUE(self.finishPanel());
    EXPECT_EQ(listState.m_measureKey.direction, TextDirection::RightToLeft);
    ASSERT_TRUE(self.m_context.commitFrame(1u));

    ASSERT_TRUE(self.m_builder.setTextDirection(TextDirection::LeftToRight));
    ASSERT_TRUE(self.begin(2u));
    ASSERT_TRUE(self.m_builder.beginPanel("panel", Rect(0.0f, 0.0f, 400.0f, 220.0f)));
    ASSERT_TRUE(self.m_builder.virtualList("list", listSource, listState, listOpts).valid);
    ASSERT_TRUE(self.m_builder.editBox("edit", model, editState).valid);
    ASSERT_TRUE(self.finishPanel());
    EXPECT_EQ(listState.m_measureKey.direction, TextDirection::LeftToRight);
    ASSERT_TRUE(self.m_context.commitFrame(2u));

    ASSERT_TRUE(self.begin(3u));
    ASSERT_TRUE(self.m_builder.beginPanel("panel", Rect(0.0f, 0.0f, 400.0f, 100.0f)));
    EXPECT_FALSE(self.m_builder.setTextDirection(TextDirection::RightToLeft));
    EXPECT_TRUE(self.m_builder.failed());
    EXPECT_FALSE(self.m_builder.endPanel());
}

void VerifyUiBuilderTextShapingTests_EditBoxPlaceholderPasswordAndInvalidOptionsWork(mut UiBuilderTextShapingTests self){
    self.addEditRegion();
    ASSERT_TRUE(self.m_skin.validatePayload());
    EditModel model = EditModel();
    EditBoxState editState = EditBoxState();
    EditBoxOptions options = EditBoxOptions();
    options.placeholder = "Password";
    options.password = true;
    options.maskCodePoint = 0x2au;

    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginPanel("panel", Rect(0.0f, 0.0f, 400.0f, 180.0f)));
    ASSERT_TRUE(self.m_builder.editBox("edit", model, editState, options).valid);
    ASSERT_TRUE(self.finishPanel());
    Vector<Vertex> emptyVerts;
    CopyGlyphVertices(self.m_paint.freeze(), emptyVerts);
    EXPECT_FALSE(emptyVerts.empty());
    ASSERT_TRUE(self.m_context.commitFrame(1u));

    ASSERT_TRUE(model.setText("secret"));
    ASSERT_TRUE(self.begin(2u));
    ASSERT_TRUE(self.m_builder.beginPanel("panel", Rect(0.0f, 0.0f, 400.0f, 180.0f)));
    ASSERT_TRUE(self.m_builder.editBox("edit", model, editState, options).valid);
    ASSERT_TRUE(self.finishPanel());
    Vector<Vertex> maskedVerts;
    CopyGlyphVertices(self.m_paint.freeze(), maskedVerts);
    ASSERT_FALSE(maskedVerts.empty());
    ASSERT_TRUE(self.m_context.commitFrame(2u));

    options.password = false;
    ASSERT_TRUE(self.begin(3u));
    ASSERT_TRUE(self.m_builder.beginPanel("panel", Rect(0.0f, 0.0f, 400.0f, 180.0f)));
    ASSERT_TRUE(self.m_builder.editBox("edit", model, editState, options).valid);
    ASSERT_TRUE(self.finishPanel());
    Vector<Vertex> plainVerts;
    CopyGlyphVertices(self.m_paint.freeze(), plainVerts);
    ASSERT_FALSE(plainVerts.empty());
    EXPECT_NE(maskedVerts[0u].texCoord.x, plainVerts[0u].texCoord.x);
    ASSERT_TRUE(self.m_context.commitFrame(3u));

    EditBoxOptions badMask = EditBoxOptions();
    badMask.password = true;
    badMask.maskCodePoint = 0x0au;
    ASSERT_TRUE(self.begin(4u));
    ASSERT_TRUE(self.m_builder.beginPanel("panel", Rect(0.0f, 0.0f, 400.0f, 180.0f)));
    EXPECT_FALSE(self.m_builder.editBox("edit", model, editState, badMask).valid);
    EXPECT_FALSE(self.m_builder.endPanel());
    self.m_context.abandonFrame();
    self.m_builder.reset();
    self.m_context.abandonFrame();

    EditBoxOptions badPlaceholder = EditBoxOptions();
    badPlaceholder.placeholder = "bad\nline";
    ASSERT_TRUE(self.begin(5u));
    ASSERT_TRUE(self.m_builder.beginPanel("panel", Rect(0.0f, 0.0f, 400.0f, 180.0f)));
    EXPECT_FALSE(self.m_builder.editBox("edit", model, editState, badPlaceholder).valid);
    EXPECT_FALSE(self.m_builder.endPanel());
}


