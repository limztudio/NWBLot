Insets ResolveSkinRegionsMaxPadding(in UiSkin skin, in Insets initial, in Span<Name> names, in Name fallback){
    Insets result = initial;
    for(in Name name : names){
        const Expected<UiSkinRegion> found = TryResolveSelectableStateRegion(skin, name, fallback);
        if(found.has_value()){
            const Insets regionPadding(
                found.value().padding.left,
                found.value().padding.top,
                found.value().padding.right,
                found.value().padding.bottom
            );
            result = MaxUiPadding(result, regionPadding);
        }
    }
    return result;
}

void LoadButtonStyleMetrics(in UiSkin skin, in WidgetStyle style, mut Point outSize, mut Insets outPadding){
    Array<Name, 4> names;
    names[0u] = style.button;
    names[1u] = style.buttonHover;
    names[2u] = style.buttonPressed;
    names[3u] = style.buttonDisabled;
    for(in Name name : names){
        const Expected<UiSkinRegion> found = TryResolveSelectableStateRegion(skin, name, style.button);
        if(!found.has_value())
            continue;
        AccumulateButtonRegionMetrics(found.value(), outSize, outPadding);
    }
}

Expected<f32> ResolveCheckboxStyleExtent(in UiSkin skin, in WidgetStyle style){
    if(!skin.hasRegion(style.checkbox))
        return makeUnexpected(Failure());
    Array<Name, 4> names;
    names[0u] = style.checkbox;
    names[1u] = style.checkboxHover;
    names[2u] = style.checkboxChecked;
    names[3u] = style.checkboxDisabled;
    f32 checkboxExtent = style.checkboxExtent;
    for(in Name name : names){
        const Expected<UiSkinRegion> found = TryResolveSelectableStateRegion(skin, name, style.checkbox);
        if(!found.has_value())
            return makeUnexpected(Failure());
        checkboxExtent = ResolveUiSkinSquareExtent(checkboxExtent, found.value());
    }
    return checkboxExtent;
}

b8 PaintBasicControlItemVisual(
    mut PaintBuilder paint,
    mut TextService text,
    in UiSkin skin,
    in WidgetKind kind,
    in WidgetStyle style,
    in TextLayout layout,
    in Rect textBounds,
    in Insets padding,
    in f32 checkboxExtent,
    in Rect rectangle,
    in Rect clip,
    in b8 enabled,
    in b8 checked,
    in b8 hover,
    in b8 pressed,
    in b8 focused,
    in b8 interactive
){
    paint.pushClip(clip);
    b8 painted = true;
    Point origin = Point(rectangle.x, rectangle.y);
    Rect textClip = rectangle;
    const Point measured = Point(textBounds.width, textBounds.height);
    if(kind == WidgetKind::Separator){
        painted = paint.drawRegion(style.separator, rectangle);
        const b8 sepPopped = paint.popClip();
        return painted && sepPopped;
    }
    if(kind == WidgetKind::Button){
        const Name preferred = ResolveButtonPreferredName(style, enabled, pressed, hover);
        const Expected<UiSkinRegion> skinRegion = TryResolveSelectableStateRegion(skin, preferred, style.button);
        painted = skinRegion.has_value() && paint.drawRegion(skinRegion.value().name, rectangle);
        ResolveButtonTextPlacement(rectangle, padding, measured, textClip, origin);
    }
    else if(kind == WidgetKind::Checkbox){
        const Name preferred = ResolveCheckboxPreferredName(style, enabled, checked, hover);
        const Expected<UiSkinRegion> skinRegion = TryResolveSelectableStateRegion(skin, preferred, style.checkbox);
        Rect square;
        Rect mark;
        ResolveCheckboxPlacement(rectangle, checkboxExtent, style.gap, measured, square, mark, textClip, origin);
        painted = skinRegion.has_value() && paint.drawRegion(skinRegion.value().name, square);
        if(painted && checked && skin.hasRegion(style.checkboxMark)){
            Color tint;
            if(!enabled)
                tint = Color(1.0f, 1.0f, 1.0f, s_StyleDisabledIconAlpha);
            painted = paint.drawRegion(style.checkboxMark, mark, tint);
        }
    }
    if(painted && focused && enabled && interactive && skin.hasRegion(style.focus))
        painted = paint.drawRegion(style.focus, rectangle);
    origin = ResolveLabelPaintOrigin(Rect(origin.x, origin.y, 0.0f, 0.0f), textBounds);
    paint.pushClip(textClip);
    if(painted){
        Color activeColor = style.disabledText;
        if(enabled)
            activeColor = style.text;
        painted = text.paint(paint, layout, origin, activeColor);
    }
    const b8 textPopped = paint.popClip();
    const b8 popped = paint.popClip();
    return painted && textPopped && popped;
}

b8 PaintComboFieldVisual(
    mut PaintBuilder paint,
    mut TextService text,
    in UiSkin skin,
    in ComboStyle comboStyle,
    in WidgetStyle widgetStyle,
    in TextLayout layout,
    in Rect textBounds,
    in Insets padding,
    in f32 arrowExtent,
    in Rect rectangle,
    in Rect clip,
    in b8 enabled,
    in b8 open,
    in b8 focused,
    in b8 hovered
){
    const Name name = ResolveComboFieldRegionName(comboStyle, enabled, open, focused, hovered);
    const Expected<UiSkinRegion> field = TryResolveSelectableStateRegion(skin, name, comboStyle.fallback);
    const Expected<UiSkinRegion> arrow = TryResolveSelectableStateRegion(skin, comboStyle.arrow, comboStyle.arrowFallback);
    if(!field.has_value() || !arrow.has_value())
        return false;
    paint.pushClip(clip);
    const b8 fieldPainted = paint.drawRegion(field.value().name, rectangle);
    Rect icon;
    Rect textClip;
    ResolveComboFieldLayout(rectangle, padding, arrowExtent, comboStyle.arrowGap, icon, textClip);
    Color arrowTint;
    if(!enabled)
        arrowTint = Color(1.0f, 1.0f, 1.0f, s_StyleDisabledIconAlpha);
    const b8 arrowPainted = fieldPainted && paint.drawRegion(arrow.value().name, icon, arrowTint);
    paint.pushClip(textClip);
    const Point origin = ResolveCenteredTextOrigin(textClip, 0.0f, textBounds);
    Color activeTextColor = widgetStyle.disabledText;
    if(enabled)
        activeTextColor = widgetStyle.text;
    const b8 textPainted = arrowPainted && text.paint(paint, layout, origin, activeTextColor);
    const b8 textPopped = paint.popClip();
    const b8 focusPainted = textPainted && (!focused || !enabled || !skin.hasRegion(widgetStyle.focus) || paint.drawRegion(widgetStyle.focus, rectangle));
    const b8 popped = paint.popClip();
    return focusPainted && textPopped && popped;
}

b8 PaintSliderVisual(
    mut PaintBuilder paint,
    in UiSkin skin,
    in SliderStyle style,
    in SliderPlacement placement,
    in b8 interactive,
    in b8 pressed,
    in b8 hover,
    in b8 focused
){
    const Expected<UiSkinRegion> track = TryResolveSelectableStateRegion(skin, style.track, style.trackFallback);
    const Name preferredThumb = ResolveSliderThumbPreferredName(style, interactive, pressed, hover);
    Expected<UiSkinRegion> thumb = TryResolveSelectableStateRegion(skin, preferredThumb, style.normal);
    if(!thumb.has_value())
        thumb = TryResolveSelectableStateRegion(skin, style.normal, style.thumbFallback);
    if(!track.has_value() || !thumb.has_value())
        return false;
    const Color tint = ResolveSliderThumbTint(style, interactive, pressed, hover);
    paint.pushClip(placement.clip);
    Color trackTint = style.disabledTint;
    if(interactive)
        trackTint = Color();
    b8 painted = paint.drawRegion(track.value().name, placement.track, trackTint);
    if(painted)
        painted = paint.drawRegion(thumb.value().name, placement.thumb, tint);
    if(painted && interactive && focused && skin.hasRegion(style.focus))
        painted = paint.drawRegion(style.focus, placement.bounds);
    const b8 popped = paint.popClip();
    return painted && popped;
}

b8 PaintRadioGroupChoiceRow(
    mut PaintBuilder paint,
    mut TextService text,
    in UiSkin skin,
    in RadioGroupStyle style,
    in WidgetStyle widgetStyle,
    in RadioGroupMetrics metrics,
    in RadioGroupChoicePlacement row,
    in TextLayout label,
    in Rect textBounds,
    in Name markRegionName,
    in b8 enabled,
    in b8 checked,
    in b8 pressed,
    in b8 hover,
    in b8 focused
){
    Name preferred;
    Name fallback;
    ResolveRadioGroupIndicatorNames(style, checked, enabled, pressed, hover, preferred, fallback);
    Expected<UiSkinRegion> indicator = TryResolveSelectableStateRegion(skin, preferred, fallback);
    if(!indicator.has_value())
        indicator = TryResolveSelectableStateRegion(skin, style.normal, style.fallback);
    if(!indicator.has_value())
        return false;
    const Color tint = ResolveRadioGroupChoiceTint(style, enabled, pressed, hover);
    paint.pushClip(row.clip);
    b8 painted = paint.drawRegion(indicator.value().name, row.indicator, tint);
    if(painted && checked)
        painted = paint.drawRegion(markRegionName, row.mark, tint);
    if(painted && focused && skin.hasRegion(style.focus))
        painted = paint.drawRegion(style.focus, row.rectangle);
    const f32 horizontalOffset = min(row.rectangle.width, row.indicator.width + metrics.gap);
    const Point origin = ResolveCenteredTextOrigin(row.rectangle, horizontalOffset, textBounds);
    paint.pushClip(row.textClip);
    if(painted){
        Color activeTextColor = widgetStyle.disabledText;
        if(enabled)
            activeTextColor = widgetStyle.text;
        painted = text.paint(paint, label, origin, activeTextColor);
    }
    const b8 textPopped = paint.popClip();
    const b8 rowPopped = paint.popClip();
    return painted && textPopped && rowPopped;
}

b8 PaintWindowTitleHeader(
    mut PaintBuilder paint,
    mut TextService text,
    in UiSkin skin,
    in WindowState state,
    in WidgetStyle style,
    in WindowMetrics metrics,
    in b8 collapsible,
    in b8 collapseHovered,
    in b8 collapsePressed,
    in b8 collapseFocused,
    in TextLayout titleLayout,
    in Rect titleBounds,
    in Rect header,
    in Rect clip
){
    paint.pushClip(clip);
    b8 painted = paint.drawRegion(style.windowTitle, header);
    if(collapsible){
        const Rect collapse = ResolveWindowCollapseBounds(state, metrics);
        if(painted && (collapseHovered || collapsePressed)){
            Name preferredHover = style.buttonHover;
            if(collapsePressed)
                preferredHover = style.buttonPressed;
            const Expected<UiSkinRegion> hover = TryResolveSelectableStateRegion(skin, preferredHover, style.windowTitle);
            painted = hover.has_value() && paint.drawRegion(hover.value().name, collapse);
        }
        if(painted){
            Color collapseTint = style.text;
            if(state.collapsed)
                collapseTint = style.disabledText;
            painted = paint.drawRegion(style.windowCollapse, collapse, collapseTint);
        }
        if(painted && collapseFocused && skin.hasRegion(style.focus))
            painted = paint.drawRegion(style.focus, collapse);
    }
    const Rect content = ResolveWindowTitleContentBounds(header, metrics, collapsible, style.gap);
    const Point origin = ResolveCenteredTextOrigin(content, 0.0f, titleBounds);
    paint.pushClip(content);
    if(painted)
        painted = text.paint(paint, titleLayout, origin, style.text);
    const b8 textPopped = paint.popClip();
    const b8 popped = paint.popClip();
    return painted && textPopped && popped;
}

b8 PaintWindowResizeCorner(
    mut PaintBuilder paint,
    in UiSkin skin,
    in WidgetStyle style,
    in Rect corner,
    in Rect clip
){
    paint.pushClip(clip);
    const Expected<UiSkinRegion> resize = TryResolveSelectableStateRegion(skin, style.windowResize, style.windowResize);
    b8 painted = true;
    if(resize.has_value())
        painted = paint.drawRegion(resize.value().name, corner, style.text);
    else{
        // Skins may supply a resize sprite. The default atlas uses its white sprite for a logical corner grip.
        Rect horizontal;
        Rect vertical;
        ResolveWindowResizeGripBars(corner, horizontal, vertical);
        painted = paint.drawRegion(style.white, horizontal, style.text) && paint.drawRegion(style.white, vertical, style.text);
    }
    const b8 popped = paint.popClip();
    return painted && popped;
}

Point LoadEditStyleMinimumSize(in UiSkin skin, in EditBoxStyle editStyle){
    Point minimum = Point(s_StyleMinimumFieldWidth, 0.0f);
    Array<Name, 4> names;
    names[0u] = editStyle.normal;
    names[1u] = editStyle.hover;
    names[2u] = editStyle.focused;
    names[3u] = editStyle.disabled;
    for(in Name name : names){
        const Expected<UiSkinRegion> found = TryResolveSelectableStateRegion(skin, name, editStyle.fallback);
        if(found.has_value())
            AccumulateEditRegionMinimumSize(found.value(), minimum);
    }
    return minimum;
}

Insets ResolveEditStylePadding(in UiSkin skin, in EditBoxStyle editStyle){
    Array<Name, 4> names;
    names[0u] = editStyle.normal;
    names[1u] = editStyle.hover;
    names[2u] = editStyle.focused;
    names[3u] = editStyle.disabled;
    Name fallback = editStyle.fallback;
    if(skin.hasRegion(editStyle.normal))
        fallback = editStyle.normal;
    return ResolveSkinRegionsMaxPadding(skin, editStyle.padding, names, fallback);
}

b8 PaintProgressBarRegions(mut PaintBuilder paint, in ProgressStyle style, in ProgressPlacement placement){
    paint.pushClip(placement.clip);
    b8 painted = paint.drawRegion(style.track, placement.bounds, style.trackTint);
    if(painted && placement.fillReveal.width > 0.0f && placement.fillReveal.height > 0.0f){
        paint.pushClip(placement.fillReveal);
        painted = paint.drawRegion(style.fill, placement.fillCanvas, style.fillTint);
        const b8 popped = paint.popClip();
        painted = painted && popped;
    }
    return painted;
}

b8 PaintTooltipOverlay(
    mut PaintBuilder paint,
    mut TextService text,
    in u32 layer,
    in Name backgroundName,
    in Rect bounds,
    in Insets padding,
    in TextLayout layout,
    in Rect textBounds,
    in Color textColor
){
    if(!paint.beginOverlay(layer))
        return false;
    paint.pushClip(bounds);
    const b8 backgroundPainted = paint.drawRegion(backgroundName, bounds);
    const Rect content = InsetUiRectBounds(bounds, padding);
    paint.pushClip(content);
    b8 painted = false;
    if(backgroundPainted)
        painted = text.paint(paint, layout, Point(content.x - textBounds.x, content.y - textBounds.y), textColor);
    const b8 contentPopped = paint.popClip();
    const b8 popped = paint.popClip();
    const b8 ended = paint.endOverlay();
    return painted && contentPopped && popped && ended;
}

b8 PaintListScrollbarVisual(
    mut PaintBuilder paint,
    in UiSkin skin,
    in ListStyle style,
    in ScrollPlacement placement,
    in Rect clip,
    in b8 hover
){
    Name preferredThumb = style.thumb;
    if(hover)
        preferredThumb = style.thumbHover;
    const Expected<UiSkinRegion> track = TryResolveSelectableStateRegion(skin, style.track, style.trackFallback);
    const Expected<UiSkinRegion> thumb = TryResolveSelectableStateRegion(skin, preferredThumb, style.thumbFallback);
    if(!track.has_value() || !thumb.has_value())
        return false;
    paint.pushClip(clip);
    const b8 trackPainted = paint.drawRegion(track.value().name, placement.track);
    const b8 thumbPainted = trackPainted && paint.drawRegion(thumb.value().name, placement.thumb);
    const b8 trackPopped = paint.popClip();
    return thumbPainted && trackPopped;
}

b8 PaintTextAreaScrollbarAxisVisual(
    mut PaintBuilder paint,
    in UiSkin skin,
    in ScrollbarStyle scrollbarStyle,
    in ScrollbarPlacement bar,
    in b8 enabled,
    in b8 hovered,
    in b8 pressed
){
    if(!bar.visible)
        return true;
    const Name thumbName = ResolveScrollbarThumbRegionName(scrollbarStyle, enabled, pressed, hovered);
    const Expected<UiSkinRegion> track = TryResolveSelectableStateRegion(skin, scrollbarStyle.track, scrollbarStyle.trackFallback);
    const Expected<UiSkinRegion> thumb = TryResolveSelectableStateRegion(skin, thumbName, scrollbarStyle.thumbFallback);
    b8 painted = true;
    if(track.has_value())
        painted = paint.drawRegion(track.value().name, bar.track);
    else
        paint.fillRect(bar.track, scrollbarStyle.trackColor);
    if(painted && thumb.has_value())
        painted = paint.drawRegion(thumb.value().name, bar.thumb);
    else if(painted){
        Color thumbColor = scrollbarStyle.disabledColor;
        if(enabled)
            thumbColor = scrollbarStyle.thumbColor;
        paint.fillRect(bar.thumb, thumbColor);
    }
    return painted;
}

b8 PaintTextAreaScrollbarsVisual(
    mut PaintBuilder paint,
    in UiSkin skin,
    in ScrollbarStyle scrollbarStyle,
    in ScrollViewportPlacement placement,
    in Rect clip,
    in b8 enabled,
    in b8 horizontalHovered,
    in b8 horizontalPressed,
    in b8 verticalHovered,
    in b8 verticalPressed
){
    paint.pushClip(clip);
    b8 painted = PaintTextAreaScrollbarAxisVisual(paint, skin, scrollbarStyle, placement.horizontal, enabled, horizontalHovered, horizontalPressed)
        && PaintTextAreaScrollbarAxisVisual(paint, skin, scrollbarStyle, placement.vertical, enabled, verticalHovered, verticalPressed);
    if(painted && placement.corner.width > 0.0f && placement.corner.height > 0.0f){
        const Expected<UiSkinRegion> track = TryResolveSelectableStateRegion(skin, scrollbarStyle.track, scrollbarStyle.trackFallback);
        if(track.has_value())
            painted = paint.drawRegion(track.value().name, placement.corner);
        else
            paint.fillRect(placement.corner, scrollbarStyle.trackColor);
    }
    const b8 popped = paint.popClip();
    return painted && popped;
}

b8 TryResolveComboStyleFieldMetrics(
    in UiSkin skin,
    in ComboStyle style,
    mut Point outMinimumSize,
    mut Insets outPadding,
    mut f32 outArrowExtent
){
    Point minimumSize;
    Array<Name, 5> names;
    names[0u] = style.normal;
    names[1u] = style.hover;
    names[2u] = style.open;
    names[3u] = style.focused;
    names[4u] = style.disabled;
    for(in Name name : names){
        const Expected<UiSkinRegion> skinRegion = TryResolveSelectableStateRegion(skin, name, style.fallback);
        if(!skinRegion.has_value())
            return false;
        minimumSize = Point(max(minimumSize.x, skinRegion.value().minimumWidth), max(minimumSize.y, skinRegion.value().minimumHeight));
    }
    const Expected<UiSkinRegion> arrow = TryResolveSelectableStateRegion(skin, style.arrow, style.arrowFallback);
    if(!arrow.has_value())
        return false;
    outMinimumSize = minimumSize;
    outPadding = ResolveSkinRegionsMaxPadding(skin, style.padding, names, style.fallback);
    outArrowExtent = ResolveUiSkinSquareExtent(style.arrowExtent, arrow.value());
    return true;
}

b8 AccumulateOptionalRadioIndicatorMinimum(
    in UiSkin skin,
    in Name regionName,
    in f32 referenceDensity,
    mut f32 inOutIndicatorExtent
){
    UiSkinRegion skinRegion;
    if(!skin.tryFindRegion(regionName, skinRegion))
        return true;
    const Expected<Point> minimum = TryResolveSkinRegionMinimumSize(skinRegion, referenceDensity);
    if(!minimum.has_value())
        return false;
    inOutIndicatorExtent = max(inOutIndicatorExtent, max(minimum.value().x, minimum.value().y));
    return true;
}

b8 TryResolveRadioGroupStyleMetrics(
    in UiSkin skin,
    in u32 choiceCount,
    in Point maximumLabel,
    in RadioGroupOptions options,
    mut RadioGroupStyle inOutStyle,
    mut RadioGroupMetrics outMetrics
){
    const Expected<UiSkinRegion> normal = TryResolveSelectableStateRegion(skin, inOutStyle.normal, inOutStyle.fallback);
    const Expected<UiSkinRegion> checked = TryResolveSelectableStateRegion(skin, inOutStyle.checked, inOutStyle.checkedFallback);
    const Expected<UiSkinRegion> mark = TryResolveSelectableStateRegion(skin, inOutStyle.mark, inOutStyle.markFallback);
    const f32 referenceDensity = skin.referenceDensity();
    if(!normal.has_value() || !checked.has_value() || !mark.has_value() || !isFinite(referenceDensity) || referenceDensity <= 0.0f)
        return false;
    const Expected<Point> normalMinimum = TryResolveSkinRegionMinimumSize(normal.value(), referenceDensity);
    const Expected<Point> checkedMinimum = TryResolveSkinRegionMinimumSize(checked.value(), referenceDensity);
    if(!normalMinimum.has_value() || !checkedMinimum.has_value())
        return false;
    f32 indicatorExtent = inOutStyle.indicatorExtent;
    indicatorExtent = max(indicatorExtent, max(normalMinimum.value().x, normalMinimum.value().y));
    indicatorExtent = max(indicatorExtent, max(checkedMinimum.value().x, checkedMinimum.value().y));
    if(
        !AccumulateOptionalRadioIndicatorMinimum(skin, inOutStyle.hover, referenceDensity, indicatorExtent)
        || !AccumulateOptionalRadioIndicatorMinimum(skin, inOutStyle.pressed, referenceDensity, indicatorExtent)
        || !AccumulateOptionalRadioIndicatorMinimum(skin, inOutStyle.disabled, referenceDensity, indicatorExtent)
    )
        return false;
    inOutStyle.indicatorExtent = indicatorExtent;
    const Expected<RadioGroupMetrics> metrics = MeasureRadioGroup(choiceCount, maximumLabel, options, inOutStyle);
    if(!metrics.has_value())
        return false;
    outMetrics = metrics.value();
    return true;
}

b8 AccumulateOptionalSliderThumbMinimum(
    in UiSkin skin,
    in Name regionName,
    in f32 referenceDensity,
    mut Point inOutThumbExtent
){
    UiSkinRegion thumb;
    if(!skin.tryFindRegion(regionName, thumb))
        return true;
    const Expected<Point> minimum = TryResolveSkinRegionMinimumSize(thumb, referenceDensity);
    if(!minimum.has_value())
        return false;
    inOutThumbExtent = Point(max(inOutThumbExtent.x, minimum.value().x), max(inOutThumbExtent.y, minimum.value().y));
    return true;
}

b8 TryResolveSliderStyleMetrics(
    in UiSkin skin,
    in SliderOptions options,
    mut SliderStyle inOutStyle,
    mut SliderMetrics outMetrics
){
    const f32 referenceDensity = skin.referenceDensity();
    if(!isFinite(referenceDensity) || referenceDensity <= 0.0f)
        return false;
    const Expected<UiSkinRegion> track = TryResolveSelectableStateRegion(skin, inOutStyle.track, inOutStyle.trackFallback);
    const Expected<UiSkinRegion> normal = TryResolveSelectableStateRegion(skin, inOutStyle.normal, inOutStyle.thumbFallback);
    if(!track.has_value() || !normal.has_value())
        return false;
    const Expected<Point> trackMinimum = TryResolveSkinRegionMinimumSize(track.value(), referenceDensity);
    const Expected<Point> normalMinimum = TryResolveSkinRegionMinimumSize(normal.value(), referenceDensity);
    if(!trackMinimum.has_value() || !normalMinimum.has_value())
        return false;
    inOutStyle.trackHeight = max(inOutStyle.trackHeight, trackMinimum.value().y);
    Point thumbExtent = Point(max(inOutStyle.thumbExtent.x, normalMinimum.value().x), max(inOutStyle.thumbExtent.y, normalMinimum.value().y));
    if(
        !AccumulateOptionalSliderThumbMinimum(skin, inOutStyle.hover, referenceDensity, thumbExtent)
        || !AccumulateOptionalSliderThumbMinimum(skin, inOutStyle.pressed, referenceDensity, thumbExtent)
        || !AccumulateOptionalSliderThumbMinimum(skin, inOutStyle.disabled, referenceDensity, thumbExtent)
    )
        return false;
    inOutStyle.thumbExtent = thumbExtent;
    const Expected<SliderMetrics> metrics = MeasureSlider(options, inOutStyle);
    if(!metrics.has_value())
        return false;
    SliderMetrics resolvedMetrics = metrics.value();
    const Expected<f32> contentWidth = TryResolveSliderTrackContentWidth(resolvedMetrics, trackMinimum.value().x);
    if(!contentWidth.has_value())
        return false;
    resolvedMetrics.contentSize.x = contentWidth.value();
    outMetrics = resolvedMetrics;
    return true;
}

Expected<SliderResult> TryFinalizeSliderFrameResult(
    in SliderResult frameResult,
    in WidgetId widgetId,
    in b8 interactive,
    in WidgetId focusedId,
    in b8 primaryDown,
    in WidgetId captureId
){
    SliderResult result = frameResult;
    result.focused = interactive && focusedId == widgetId;
    result.dragging = false;
    if(interactive && primaryDown){
        const Expected<WidgetId> track = TryMakeWidgetId(widgetId, s_WidgetPartTrack);
        const Expected<WidgetId> thumb = TryMakeWidgetId(widgetId, s_WidgetPartThumb);
        if(!track.has_value() || !thumb.has_value())
            return makeUnexpected(Failure());
        result.dragging = captureId == track.value() || captureId == thumb.value();
    }
    return result;
}

void ApplyBuilderSkinStyles(
    in UiSkinPalette palette,
    in f32 nextDefaultFontSize,
    mut f32 inOutSkinDefaultFontSize,
    mut WidgetStyle inOutStyle,
    mut TooltipStyle inOutTooltipStyle,
    mut EditBoxStyle inOutEditStyle,
    mut ScrollbarStyle inOutScrollbarStyle,
    mut PopupStyle inOutPopupStyle,
    mut RadioGroupStyle inOutRadioGroupStyle,
    mut SliderStyle inOutSliderStyle,
    mut ProgressStyle inOutProgressStyle
){
    if(inOutStyle.fontSize == inOutSkinDefaultFontSize)
        inOutStyle.fontSize = nextDefaultFontSize;
    inOutSkinDefaultFontSize = nextDefaultFontSize;

    ApplySkinPaletteToWidgetStyle(palette, inOutStyle);
    ApplySkinPaletteToTooltipStyle(palette, inOutTooltipStyle);
    ApplySkinPaletteToEditBoxStyle(palette, inOutEditStyle);
    ApplySkinPaletteToScrollbarStyle(palette, inOutScrollbarStyle);
    ApplySkinPaletteToPopupStyle(palette, inOutPopupStyle);
    ApplySkinPaletteToRadioGroupStyle(palette, inOutRadioGroupStyle);
    ApplySkinPaletteToSliderStyle(palette, inOutSliderStyle);
    ApplySkinPaletteToProgressStyle(palette, inOutProgressStyle);
}

b8 TryResolveProgressStyleMetrics(
    in UiSkin skin,
    in f64 fraction,
    in ProgressOptions options,
    mut ProgressStyle inOutStyle,
    mut ProgressMetrics outMetrics
){
    if(!isFinite(fraction))
        return false;
    const Expected<UiSkinRegion> track = TryResolveSelectableStateRegion(skin, inOutStyle.track, inOutStyle.trackFallback);
    const Expected<UiSkinRegion> fill = TryResolveSelectableStateRegion(skin, inOutStyle.fill, inOutStyle.fillFallback);
    if(!track.has_value() || !fill.has_value())
        return false;
    const Expected<ProgressMetrics> metrics = MeasureProgress(options, inOutStyle, track.value(), fill.value(), skin.referenceDensity());
    if(!metrics.has_value())
        return false;
    inOutStyle.track = track.value().name;
    inOutStyle.fill = fill.value().name;
    outMetrics = metrics.value();
    return true;
}

b8 TryResolveImageRegionMetrics(
    in UiSkin skin,
    in Name regionName,
    in ImageOptions options,
    mut ImageMetrics outMetrics,
    mut Name outRegion
){
    UiSkinRegion skinRegion;
    if(!skin.tryFindRegion(regionName, skinRegion))
        return false;
    const Expected<ImageMetrics> metrics = MeasureImage(options, skinRegion, skin.referenceDensity());
    if(!metrics.has_value())
        return false;
    outMetrics = metrics.value();
    outRegion = skinRegion.name;
    return true;
}

b8 TryResolveWindowChromeMetrics(
    in UiSkin skin,
    in WidgetStyle style,
    in WindowOptions options,
    in Point titleExtent,
    mut WindowMetrics outMetrics
){
    UiSkinRegion frame;
    UiSkinRegion header;
    if(!skin.tryFindRegion(style.window, frame) || !skin.tryFindRegion(style.windowTitle, header))
        return false;
    UiSkinRegion collapse;
    const b8 hasCollapse = skin.tryFindRegion(style.windowCollapse, collapse);
    if(options.collapsible && !hasCollapse)
        return false;
    UiSkinRegion resize;
    const b8 hasResize = skin.tryFindRegion(style.windowResize, resize);
    if(options.resizable && !hasResize && !skin.hasRegion(style.white))
        return false;
    const Expected<WindowMetrics> metrics = MeasureWindow(frame, header, collapse, resize, style, options, titleExtent, skin.referenceDensity());
    if(!metrics.has_value())
        return false;
    outMetrics = metrics.value();
    return true;
}

b8 TryFinalizeWindowFirstUseArrangement(
    in WindowOptions options,
    in WindowMetrics metrics,
    in Rect rootRectangle,
    in b8 firstUse,
    in DisplayMetrics display,
    mut WindowState inOutState,
    mut Rect outBounds
){
    ApplyWindowFirstUseContentBounds(options, metrics, rootRectangle, firstUse, inOutState);
    const b8 constrained = TryConstrainWindow(display, metrics.titleHeight, inOutState);
    outBounds = ResolveWindowContentBounds(inOutState, metrics);
    return constrained;
}

HitTarget MakeBarrierHitTarget(in Rect rectangle, in Rect clip){
    HitTarget target;
    target.rectangle = rectangle;
    target.clip = clip;
    return target;
}

HitTarget MakeAnnotatedClipHitTarget(in Rect bounds, in Rect clip, in b8 contextMenu){
    HitTarget target;
    target.rectangle = bounds;
    target.clip = clip;
    target.focusable = false;
    target.activatable = false;
    target.contextMenu = contextMenu;
    return target;
}

HitTarget MakeBasicControlHitTarget(in Rect rectangle, in Rect clip, in b8 enabled, in b8 interactive, in b8 contextMenu){
    HitTarget target;
    target.rectangle = rectangle;
    target.clip = clip;
    target.enabled = enabled;
    target.focusable = enabled && interactive;
    target.activatable = enabled && interactive;
    target.contextMenu = contextMenu;
    return target;
}

HitTarget MakeEditBoxHitTarget(in HitTarget baseTarget, in Rect rectangle, in Rect clip, in b8 enabled, in b8 contextMenu){
    HitTarget target = baseTarget;
    target.rectangle = rectangle;
    target.clip = clip;
    target.enabled = enabled;
    target.focusable = enabled;
    target.textEditable = enabled;
    target.contextMenu = contextMenu;
    return target;
}

HitTarget MakeTextAreaHitTarget(
    in Rect rectangle,
    in Rect clip,
    in b8 enabled,
    in b8 contextMenu,
    in ControlToken token,
    in Point step,
    in ScrollViewportPlacement scrollbars
){
    HitTarget target;
    target.rectangle = rectangle;
    target.clip = clip;
    target.enabled = enabled;
    target.focusable = enabled;
    target.textEditable = enabled;
    target.contextMenu = contextMenu;
    target.control = token;
    target.scrollable = enabled;
    target.scrollStep = cast<f64>(step.y);
    target.scrollStepX = cast<f64>(step.x);
    target.gestureMaximum = scrollbars.vertical.maximum;
    target.gestureMaximumX = scrollbars.horizontal.maximum;
    return target;
}

HitTarget MakeComboFieldHitTarget(
    in Rect rectangle,
    in Rect clip,
    in b8 enabled,
    in b8 contextMenu,
    in ControlToken token,
    in b8 focusOnCommit
){
    HitTarget target;
    target.rectangle = rectangle;
    target.clip = clip;
    target.enabled = enabled;
    target.focusable = enabled;
    target.activatable = enabled;
    target.contextMenu = contextMenu;
    target.navigable = enabled;
    target.control = token;
    target.focusOnCommit = focusOnCommit;
    return target;
}

PopupScope MakeComboPopupScope(
    in PopupToken token,
    in PopupToken parent,
    in PopupPlacement placement,
    in WidgetId focusAnchor,
    in u64 focusAnchorDeclarationGeneration
){
    PopupScope scope;
    scope.token = token;
    scope.parent = parent;
    scope.bounds = placement.bounds;
    scope.viewport = placement.viewport;
    scope.dismissFocusTraversal = true;
    scope.focusAnchor = focusAnchor;
    scope.focusAnchorDeclarationGeneration = focusAnchorDeclarationGeneration;
    return scope;
}

PopupScope MakePopupFrameScope(
    in PopupToken token,
    in PopupToken parent,
    in PopupPlacement placement,
    in PopupOptions options
){
    PopupScope scope;
    scope.token = token;
    scope.parent = parent;
    scope.bounds = placement.bounds;
    scope.viewport = placement.viewport;
    scope.dismissOutside = options.dismissOutside;
    scope.dismissCancel = options.dismissCancel;
    scope.autofocus = options.autofocus;
    return scope;
}

LayoutNodeDesc MakePopupRootLayoutNodeDesc(
    in Rect bounds,
    in Insets popupPadding,
    in UiSkinInsets backgroundPadding,
    in f32 gap
){
    LayoutNodeDesc description;
    description.direction = LayoutDirection::Column;
    description.width = LayoutSize(LayoutSizePolicy::Fixed, bounds.width);
    description.height = LayoutSize(LayoutSizePolicy::Fixed, bounds.height);
    description.padding = MaxUiPadding(popupPadding, backgroundPadding);
    description.gap = gap;
    return description;
}

HitTarget MakeListHostHitTarget(
    in Rect rectangle,
    in Rect clip,
    in b8 enabled,
    in b8 contextMenu,
    in ControlToken token,
    in f32 rowHeight,
    in f32 wheelRows,
    in ScrollPlacement placement,
    in u64 rowCount,
    in b8 focusOnCommit
){
    HitTarget host;
    host.rectangle = rectangle;
    host.clip = clip;
    host.enabled = enabled;
    host.focusable = enabled;
    host.contextMenu = contextMenu;
    host.control = token;
    host.navigable = enabled;
    host.scrollable = enabled;
    host.scrollStep = cast<f64>(rowHeight) * cast<f64>(wheelRows);
    host.pageRows = ComputeListHostPageRows(placement.viewport.height, rowHeight, rowCount);
    host.gestureMaximum = placement.maxOffset;
    host.focusOnCommit = focusOnCommit;
    return host;
}

HitTarget MakeListRowHitTarget(in Rect rectangle, in Rect clip, in b8 enabled, in ControlToken token, in u64 key){
    HitTarget target;
    target.rectangle = rectangle;
    target.clip = clip;
    target.enabled = enabled;
    target.activatable = enabled;
    target.control = token;
    target.value = key;
    return target;
}

HitTarget MakeRadioGroupHostHitTarget(
    in RadioGroupPlacement placement,
    in b8 enabled,
    in b8 contextMenu,
    in ControlToken token,
    in b8 focusOnCommit
){
    HitTarget host;
    host.rectangle = placement.bounds;
    host.clip = placement.clip;
    host.enabled = enabled;
    host.focusable = enabled;
    host.navigable = enabled;
    host.horizontalNavigation = enabled;
    host.contextMenu = contextMenu;
    host.control = token;
    host.focusOnCommit = focusOnCommit;
    return host;
}

HitTarget MakeRadioGroupChoiceHitTarget(in RadioGroupChoicePlacement row, in b8 enabled, in ControlToken token){
    HitTarget target;
    target.rectangle = row.rectangle;
    target.clip = row.clip;
    target.enabled = enabled;
    target.activatable = enabled;
    target.control = token;
    target.value = row.key;
    return target;
}

HitTarget MakeSliderHostHitTarget(
    in SliderPlacement placement,
    in b8 interactive,
    in b8 contextMenu,
    in ControlToken token,
    in b8 focusOnCommit
){
    HitTarget host;
    host.rectangle = placement.bounds;
    host.clip = placement.clip;
    host.enabled = interactive;
    host.focusable = interactive;
    host.navigable = interactive;
    host.horizontalNavigation = interactive;
    host.contextMenu = contextMenu;
    host.control = token;
    host.focusOnCommit = focusOnCommit;
    return host;
}

HitTarget MakeSliderTrackHitTarget(in SliderPlacement placement, in ControlToken token){
    HitTarget trackTarget;
    trackTarget.rectangle = placement.track;
    trackTarget.clip = placement.clip;
    trackTarget.pointerGesture = true;
    trackTarget.gestureReference = placement.centerTravel;
    trackTarget.control = token;
    return trackTarget;
}

HitTarget MakeSliderThumbHitTarget(in SliderPlacement placement, in ControlToken token, in f64 value){
    HitTarget thumbTarget;
    thumbTarget.rectangle = placement.thumb;
    thumbTarget.clip = placement.clip;
    thumbTarget.pointerGesture = true;
    thumbTarget.gestureReference = placement.travelBounds;
    thumbTarget.control = token;
    thumbTarget.value = BitCast<u64>(value);
    return thumbTarget;
}

HitTarget MakeWindowTitleHitTarget(in Rect header, in Rect clip, in Rect windowBounds, in b8 movable){
    HitTarget title;
    title.rectangle = header;
    title.clip = clip;
    title.gestureReference = windowBounds;
    title.pointerGesture = movable;
    return title;
}

HitTarget MakeWindowCollapseHitTarget(in WindowState state, in WindowMetrics metrics, in Rect clip){
    HitTarget collapse;
    collapse.rectangle = ResolveWindowCollapseBounds(state, metrics);
    collapse.clip = clip;
    collapse.focusable = true;
    collapse.activatable = true;
    return collapse;
}

HitTarget MakeWindowResizeHitTarget(in Rect corner, in Rect clip, in Rect windowBounds){
    HitTarget target;
    target.rectangle = corner;
    target.clip = clip;
    target.gestureReference = windowBounds;
    target.pointerGesture = true;
    return target;
}

HitTarget MakeScrollbarTrackActionHitTarget(
    in Rect rectangle,
    in Rect clip,
    in ControlToken token,
    in u32 actionValue
){
    HitTarget target;
    target.rectangle = rectangle;
    target.clip = clip;
    target.control = token;
    target.activatable = true;
    target.value = cast<u64>(actionValue);
    return target;
}

HitTarget MakeScrollbarThumbHitTarget(
    in ScrollbarPlacement bar,
    in Rect clip,
    in ControlToken token,
    in b8 horizontal
){
    f32 trackExtent = bar.track.height;
    f32 thumbExtent = bar.thumb.height;
    if(horizontal){
        trackExtent = bar.track.width;
        thumbExtent = bar.thumb.width;
    }
    HitTarget target;
    target.rectangle = bar.thumb;
    target.clip = clip;
    target.control = token;
    target.activatable = false;
    target.value = 0u;
    target.pointerGesture = trackExtent > thumbExtent;
    target.gestureReference = bar.track;
    target.gestureMaximum = bar.maximum;
    return target;
}

HitTarget MakeScrollbarCornerHitTarget(
    in Rect corner,
    in Rect clip,
    in ControlToken token
){
    HitTarget target;
    target.rectangle = corner;
    target.clip = clip;
    target.control = token;
    return target;
}

HitTarget MakeListScrollbarTrackHitTarget(
    in ScrollPlacement placement,
    in Rect clip,
    in ControlToken token
){
    HitTarget target;
    target.rectangle = placement.track;
    target.clip = clip;
    target.control = token;
    return target;
}

HitTarget MakeListScrollbarThumbHitTarget(
    in ScrollPlacement placement,
    in Rect clip,
    in ControlToken token
){
    HitTarget target;
    target.rectangle = placement.thumb;
    target.clip = clip;
    target.control = token;
    target.pointerGesture = placement.track.height > placement.thumb.height;
    target.gestureReference = placement.track;
    target.gestureMaximum = placement.maxOffset;
    return target;
}

PopupScope MakeBasicPopupScope(
    in PopupToken token,
    in PopupToken parent,
    in PopupPlacement placement
){
    PopupScope scope;
    scope.token = token;
    scope.parent = parent;
    scope.bounds = placement.bounds;
    scope.viewport = placement.viewport;
    return scope;
}

HitTarget MakeComboQueryNavigationTarget(
    in b8 enabled,
    in b8 composing,
    in WidgetId commandOwner,
    in u64 commandOwnerDeclarationGeneration,
    in ControlToken commandControl
){
    HitTarget navigation;
    if(enabled && !composing){
        navigation.commandOwner = commandOwner;
        navigation.commandOwnerDeclarationGeneration = commandOwnerDeclarationGeneration;
        navigation.commandControl = commandControl;
    }
    return navigation;
}

LayoutNodeDesc MakePanelRootLayoutNodeDesc(
    in Rect bounds,
    in LayoutDirection direction,
    in UiSkinInsets panelPadding,
    in f32 gap
){
    LayoutNodeDesc description;
    description.direction = direction;
    description.width = LayoutSize(LayoutSizePolicy::Fixed, bounds.width);
    description.height = LayoutSize(LayoutSizePolicy::Fixed, bounds.height);
    description.padding = Insets(panelPadding.left, panelPadding.top, panelPadding.right, panelPadding.bottom);
    description.gap = gap;
    return description;
}

LayoutNodeDesc MakeContainerLayoutNodeDesc(
    in LayoutDirection direction,
    in ContainerOptions options
){
    LayoutNodeDesc description;
    description.direction = direction;
    description.width = options.width;
    description.height = options.height;
    description.padding = options.padding;
    description.gap = options.gap;
    return description;
}

b8 DidContextMenuBindingChange(
    in WidgetId widgetId,
    in u64 widgetDeclarationGeneration,
    in WidgetId anchorId,
    in u64 anchorDeclarationGeneration,
    in WidgetId stateOwner,
    in u64 stateOwnerDeclaration,
    in WidgetId stateAnchorWidget,
    in u64 stateAnchorDeclaration
){
    return stateOwner != widgetId
        || stateOwnerDeclaration != widgetDeclarationGeneration
        || stateAnchorWidget != anchorId
        || stateAnchorDeclaration != anchorDeclarationGeneration;
}


