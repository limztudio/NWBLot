void VerifyIntegerLifetimeTests_ReversedAndUnknownIntegerBoundsAreAtomic(mut IntegerLifetimeTests self){
    ExpectUiNumericAtomicBadIntegerBounds(MakeUiNumericIntegerBounds(10, 1, NumericBoundsPolicy::Reject), self.m_arena, self.m_model);
    const NumericBoundsPolicyEnum unknown = cast<NumericBoundsPolicyEnum>(3u);
    ExpectUiNumericAtomicBadIntegerBounds(MakeUiNumericIntegerBounds(-10, 10, unknown), self.m_arena, self.m_model);
}

void VerifyFloatLifetimeTests_ReversedNonfiniteAndUnknownFloatBoundsAreAtomic(mut FloatLifetimeTests self){
    ExpectUiNumericAtomicBadFloatBounds(MakeUiNumericFloatBounds(10.0, 1.0, NumericBoundsPolicy::Reject), self.m_arena, self.m_model);
    ExpectUiNumericAtomicBadFloatBounds(MakeUiNumericFloatBounds(UiNumericQuietNaNF64(), 10.0, NumericBoundsPolicy::Reject), self.m_arena, self.m_model);
    ExpectUiNumericAtomicBadFloatBounds(MakeUiNumericFloatBounds(-10.0, UiNumericInfinityF64(), NumericBoundsPolicy::Reject), self.m_arena, self.m_model);
    const NumericBoundsPolicyEnum unknown = cast<NumericBoundsPolicyEnum>(3u);
    ExpectUiNumericAtomicBadFloatBounds(MakeUiNumericFloatBounds(-10.0, 10.0, unknown), self.m_arena, self.m_model);
}


