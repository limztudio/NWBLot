const u32 s_FontMaxSourceBytes = 32u * 1024u * 1024u;
const u32 s_FontMaxTableCount = 256u;
const usize s_FontSfntHeaderBytes = 12u;
const usize s_FontSfntTableRecordBytes = 16u;
const usize s_FontSfntHeaderTableCountFieldOffset = 4u;
const usize s_FontSfntRecordOffsetFieldOffset = 8u;
const usize s_FontSfntRecordLengthFieldOffset = 12u;
const u32 s_FontSfntBitsPerByte = 8u;
const u32 s_FontSfntU16Bits = 16u;
const usize s_FontSfntU16Bytes = 2u;
const u32 s_FontSfntHeadTag = 0x68656164u;
const u32 s_FontSfntMaxpTag = 0x6d617870u;
const usize s_FontSfntHeadUnitsPerEmOffset = 18u;
const usize s_FontSfntMaxpGlyphCountOffset = 4u;
const u32 s_TrueTypeSignature = 0x00010000u;
const u32 s_CffSignature = 0x4f54544fu; // OTTO
const u32 s_FvarTag = 0x66766172u; // fvar
const u32 s_Cff2Tag = 0x43464632u; // CFF2
const u32 s_CmapTag = 0x636d6170u; // cmap
const u32 s_HheaTag = 0x68686561u; // hhea
const u32 s_HmtxTag = 0x686d7478u; // hmtx
const u32 s_GlyfTag = 0x676c7966u; // glyf
const u32 s_LocaTag = 0x6c6f6361u; // loca
const u32 s_CffTableTag = 0x43464620u; // "CFF " with a trailing space
const usize s_HeadMinBytes = 54u;
const usize s_CmapMinBytes = 4u;
const usize s_MaxpMinBytes = 6u;
const usize s_HheaMinBytes = 36u;
const usize s_HmtxMinBytes = 4u;
const StringView s_WarningEventName = "warning";
const StringView s_NativeValidationCategory = "font_native_validation";
const StringView s_NativeCleanupFailedFormat = "Font native cleanup failed: native_domain=FreeType native_code={}";
const StringView s_FontOpFtDoneFace = "FT_Done_Face";
const StringView s_FontOpFtDoneLibrary = "FT_Done_Library";
const StringView s_FontOpFtNewLibrary = "FT_New_Library";
const StringView s_FontOpFtNewMemoryFace = "FT_New_Memory_Face";
const StringView s_FontOpAdmitStaticScalableFace = "admit_static_scalable_face";
const StringView s_FontOpFtSelectCharmap = "FT_Select_Charmap";
const StringView s_FontMetaDiagnosticPrefix = "Font meta";
const StringView s_PreparedFontExtension = ".font";
const StringView s_PreparedFontInvalidSerializeInputReason = "invalid font bytes, face index, or image group count";
const StringView s_PreparedFontInvalidSerializeGroupReason = "image dimensions, channels, or pixel bytes are invalid";
const StringView s_PreparedFontOpenFailedReason = "could not open paired .font source";
const StringView s_PreparedFontLengthOutOfBoundsReason = "file length is outside prepared-source limits";
const StringView s_PreparedFontSeekFailedReason = "could not seek prepared-source header";
const StringView s_PreparedFontHeaderTruncatedReason = "prepared-source header is truncated";
const StringView s_PreparedFontUnsupportedHeaderReason = "unsupported prepared-source magic, version, face index, or flags; rebuild required";
const StringView s_PreparedFontCountsOutOfBoundsReason = "font size or image group count is outside prepared-source limits";
const StringView s_PreparedFontImageDirectoryTruncatedReason = "image directory is truncated";
const StringView s_PreparedFontInvalidImageGroupReason = "image dimensions, channels, or byte count are invalid";
const StringView s_PreparedFontLayoutMismatchReason = "prepared-source layout is truncated or has trailing bytes";
const StringView s_PreparedFontSfntBytesTruncatedReason = "prepared SFNT bytes are truncated";
const StringView s_PreparedFontSfntHashMismatchReason = "prepared SFNT content hash differs from its directory";
const StringView s_PreparedFontImageBytesTruncatedReason = "prepared image bytes are truncated";
const StringView s_PreparedFontImageHashMismatchReason = "prepared image content hash differs from its directory";
const StringView s_PreparedFontLengthChangedReason = "prepared source changed length during read";
const StringView s_PreparedFontChangedDuringReadReason = "prepared source changed during read";
const u32 s_PreparedFontMagic = 0x324e4f46u; // FON2 in little-endian wire order.
const u32 s_PreparedFontVersion = 1u;
const usize s_PreparedFontHeaderBytes = 56u;
const usize s_PreparedFontGroupHeaderBytes = 48u;
const u32 s_PreparedFontMaxGroupCount = 8u;
const u32 s_PreparedFontMaxSide = 2048u;
const u32 s_PreparedFontMaxChannelCount = 4u;
const usize s_PreparedFontHeaderVersionOffset = 4u;
const usize s_PreparedFontHeaderFaceIndexOffset = 8u;
const usize s_PreparedFontHeaderFontByteCountOffset = 12u;
const usize s_PreparedFontHeaderGroupCountOffset = 16u;
const usize s_PreparedFontHeaderFlagsOffset = 20u;
const usize s_PreparedFontHeaderFontSha256Offset = 24u;
const usize s_PreparedFontGroupHeightOffset = 4u;
const usize s_PreparedFontGroupChannelCountOffset = 8u;
const usize s_PreparedFontGroupByteCountOffset = 12u;
const usize s_PreparedFontGroupSha256Offset = 16u;
const u64 s_PreparedFontMaxPixelBytes = 128ul * 1024ul * 1024ul;
const u64 s_PreparedFontMaxFileBytes = cast<u64>(s_PreparedFontHeaderBytes) + cast<u64>(s_PreparedFontMaxGroupCount) * cast<u64>(s_PreparedFontGroupHeaderBytes) + cast<u64>(s_FontMaxSourceBytes) + s_PreparedFontMaxPixelBytes;
const u32 s_FontBinaryMagic = 0x464f4e31u; // FON1
const u32 s_FontBinaryVersion = 1u;
const usize s_FontBinaryHeaderBytes = 24u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[serialize]
class FontBinaryHeader{
    public u32 magic = s_FontBinaryMagic;
    public u32 version = s_FontBinaryVersion;
    public u32 faceIndex = 0u;
    public u32 reserved = 0u;
    public u64 byteCount = 0u;
}

class PreparedFontImageView{
    public u32 width;
    public u32 height;
    public u32 channelCount;
    public Span<u8> pixels;

    public PreparedFontImageView(){
        this.width = 0u;
        this.height = 0u;
        this.channelCount = 0u;
        this.pixels = Span<u8>();
    }

    public PreparedFontImageView(in u32 w, in u32 h, in u32 c, in Span<u8> p){
        this.width = w;
        this.height = h;
        this.channelCount = c;
        this.pixels = p;
    }
}

class FontSfntTable{
    public u32 tag = 0u;
    public u32 offset = 0u;
    public Span<u8> bytes;
}

class NativeFontFailure{
    public StringView operation = "";
    public i32 nativeError = 0;
    public b8 hasNativeError = false;
}

u16 ReadFontSfntU16BigEndian(in Span<u8> bytes, in usize offset){
    const u16 hi = cast<u16>(bytes[offset]) << s_FontSfntBitsPerByte;
    const u16 lo = cast<u16>(bytes[offset + 1u]);
    return hi | lo;
}

u32 ReadFontSfntU32BigEndian(in Span<u8> bytes, in usize offset){
    const u32 hi = cast<u32>(ReadFontSfntU16BigEndian(bytes, offset)) << s_FontSfntU16Bits;
    const u32 lo = cast<u32>(ReadFontSfntU16BigEndian(bytes, offset + s_FontSfntU16Bytes));
    return hi | lo;
}

u32 RotateFontSha256Word(in u32 value, in u32 count){
    return (value >> count) | (value << (32u - count));
}

void SetFontSha256Words8(
    mut Array<u32, 64> outWords,
    in usize baseIndex,
    in u32 w0,
    in u32 w1,
    in u32 w2,
    in u32 w3,
    in u32 w4,
    in u32 w5,
    in u32 w6,
    in u32 w7
){
    outWords[baseIndex] = w0;
    outWords[baseIndex + 1u] = w1;
    outWords[baseIndex + 2u] = w2;
    outWords[baseIndex + 3u] = w3;
    outWords[baseIndex + 4u] = w4;
    outWords[baseIndex + 5u] = w5;
    outWords[baseIndex + 6u] = w6;
    outWords[baseIndex + 7u] = w7;
}

void CompressFontSha256Block(in Array<u8, 64> block, mut Array<u32, 8> state){
    Array<u32, 64> roundConstants;
    SetFontSha256Words8(roundConstants, 0u, 0x428a2f98u, 0x71374491u, 0xb5c0fbcfu, 0xe9b5dba5u, 0x3956c25bu, 0x59f111f1u, 0x923f82a4u, 0xab1c5ed5u);
    SetFontSha256Words8(roundConstants, 8u, 0xd807aa98u, 0x12835b01u, 0x243185beu, 0x550c7dc3u, 0x72be5d74u, 0x80deb1feu, 0x9bdc06a7u, 0xc19bf174u);
    SetFontSha256Words8(roundConstants, 16u, 0xe49b69c1u, 0xefbe4786u, 0x0fc19dc6u, 0x240ca1ccu, 0x2de92c6fu, 0x4a7484aau, 0x5cb0a9dcu, 0x76f988dau);
    SetFontSha256Words8(roundConstants, 24u, 0x983e5152u, 0xa831c66du, 0xb00327c8u, 0xbf597fc7u, 0xc6e00bf3u, 0xd5a79147u, 0x06ca6351u, 0x14292967u);
    SetFontSha256Words8(roundConstants, 32u, 0x27b70a85u, 0x2e1b2138u, 0x4d2c6dfcu, 0x53380d13u, 0x650a7354u, 0x766a0abbu, 0x81c2c92eu, 0x92722c85u);
    SetFontSha256Words8(roundConstants, 40u, 0xa2bfe8a1u, 0xa81a664bu, 0xc24b8b70u, 0xc76c51a3u, 0xd192e819u, 0xd6990624u, 0xf40e3585u, 0x106aa070u);
    SetFontSha256Words8(roundConstants, 48u, 0x19a4c116u, 0x1e376c08u, 0x2748774cu, 0x34b0bcb5u, 0x391c0cb3u, 0x4ed8aa4au, 0x5b9cca4fu, 0x682e6ff3u);
    SetFontSha256Words8(roundConstants, 56u, 0x748f82eeu, 0x78a5636fu, 0x84c87814u, 0x8cc70208u, 0x90befffau, 0xa4506cebu, 0xbef9a3f7u, 0xc67178f2u);
    Array<u32, 64> words;
    for(usize index = 0u; index < 16u; ++index){
        const usize byteOffset = index * 4u;
        words[index] = (cast<u32>(block[byteOffset]) << 24u)
            | (cast<u32>(block[byteOffset + 1u]) << 16u)
            | (cast<u32>(block[byteOffset + 2u]) << 8u)
            | cast<u32>(block[byteOffset + 3u]);
    }
    for(usize index = 16u; index < 64u; ++index){
        const u32 w0 = words[index - 15u];
        const u32 w1 = words[index - 2u];
        const u32 sigma0 = RotateFontSha256Word(w0, 7u) ^ RotateFontSha256Word(w0, 18u) ^ (w0 >> 3u);
        const u32 sigma1 = RotateFontSha256Word(w1, 17u) ^ RotateFontSha256Word(w1, 19u) ^ (w1 >> 10u);
        words[index] = words[index - 16u] + sigma0 + words[index - 7u] + sigma1;
    }
    u32 a = state[0u];
    u32 b = state[1u];
    u32 c = state[2u];
    u32 d = state[3u];
    u32 e = state[4u];
    u32 f = state[5u];
    u32 g = state[6u];
    u32 h = state[7u];
    for(usize index = 0u; index < 64u; ++index){
        const u32 first = h
            + (RotateFontSha256Word(e, 6u) ^ RotateFontSha256Word(e, 11u) ^ RotateFontSha256Word(e, 25u))
            + ((e & f) ^ (~e & g))
            + roundConstants[index]
            + words[index];
        const u32 second = (RotateFontSha256Word(a, 2u) ^ RotateFontSha256Word(a, 13u) ^ RotateFontSha256Word(a, 22u))
            + ((a & b) ^ (a & c) ^ (b & c));
        h = g;
        g = f;
        f = e;
        e = d + first;
        d = c;
        c = b;
        b = a;
        a = first + second;
    }
    state[0u] += a;
    state[1u] += b;
    state[2u] += c;
    state[3u] += d;
    state[4u] += e;
    state[5u] += f;
    state[6u] += g;
    state[7u] += h;
}

Array<u8, 32> ComputeFontSha256Bytes(in Span<u8> input){
    Array<u32, 8> state;
    state[0u] = 0x6a09e667u;
    state[1u] = 0xbb67ae85u;
    state[2u] = 0x3c6ef372u;
    state[3u] = 0xa54ff53au;
    state[4u] = 0x510e527fu;
    state[5u] = 0x9b05688cu;
    state[6u] = 0x1f83d9abu;
    state[7u] = 0x5be0cd19u;
    Array<u8, 64> block;
    usize offset = 0u;
    while(input.size() - offset >= 64u){
        for(usize index = 0u; index < 64u; ++index)
            block[index] = input[offset + index];
        CompressFontSha256Block(block, state);
        offset += 64u;
    }
    const usize remainder = input.size() - offset;
    for(usize index = 0u; index < 64u; ++index)
        block[index] = 0u;
    for(usize index = 0u; index < remainder; ++index)
        block[index] = input[offset + index];
    block[remainder] = 0x80u;
    if(remainder >= 56u){
        CompressFontSha256Block(block, state);
        for(usize index = 0u; index < 64u; ++index)
            block[index] = 0u;
    }
    const u64 bitCount = cast<u64>(input.size()) * 8ul;
    for(usize index = 0u; index < 8u; ++index){
        const u32 shift = cast<u32>(index) * 8u;
        block[63u - index] = cast<u8>(bitCount >> shift);
    }
    CompressFontSha256Block(block, state);
    Array<u8, 32> digest;
    for(usize index = 0u; index < 32u; ++index){
        const usize wordIndex = index / 4u;
        const u32 shift = cast<u32>(3u - (index % 4u)) * 8u;
        digest[index] = cast<u8>(state[wordIndex] >> shift);
    }
    return digest;
}

// Borrows the source buffer; the caller keeps it alive and unchanged while reading the directory or its tables.
class FontSfntDirectory{
    public void assign(in Span<u8> bytes, in u16 tableCount){
        this.m_bytes = bytes;
        this.m_tableCount = tableCount;
    }

    public u32 signature()const{
        return ReadFontSfntU32BigEndian(this.m_bytes, 0u);
    }

    public usize directoryBytes()const{
        return s_FontSfntHeaderBytes + cast<usize>(this.m_tableCount) * s_FontSfntTableRecordBytes;
    }

    public u16 tableCount()const{
        return this.m_tableCount;
    }

    public Expected<FontSfntTable> table(in usize index)const{
        const Expected<Span<u8>> rec = this.record(index);
        if(!rec.has_value())
            return MakeUnexpected(Failure());
        const u32 offset = ReadFontSfntU32BigEndian(rec.value(), s_FontSfntRecordOffsetFieldOffset);
        const u32 length = ReadFontSfntU32BigEndian(rec.value(), s_FontSfntRecordLengthFieldOffset);
        if(cast<usize>(offset) > this.m_bytes.size() || cast<usize>(length) > this.m_bytes.size() - cast<usize>(offset))
            return MakeUnexpected(Failure());
        FontSfntTable outTable;
        outTable.tag = ReadFontSfntU32BigEndian(rec.value(), 0u);
        outTable.offset = offset;
        outTable.bytes = this.m_bytes.subspan(cast<usize>(offset), cast<usize>(length));
        return outTable;
    }

    public Expected<u32> tableTag(in usize index)const{
        const Expected<Span<u8>> rec = this.record(index);
        if(!rec.has_value())
            return MakeUnexpected(Failure());
        return ReadFontSfntU32BigEndian(rec.value(), 0u);
    }

    private Span<u8> m_bytes;
    private u16 m_tableCount = 0u;

    private Expected<Span<u8>> record(in usize index)const{
        if(index >= cast<usize>(this.m_tableCount))
            return MakeUnexpected(Failure());
        return this.m_bytes.subspan(s_FontSfntHeaderBytes + index * s_FontSfntTableRecordBytes, s_FontSfntTableRecordBytes);
    }
}


