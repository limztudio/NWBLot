void VerifyUiComboBehaviorTests_ReconcileCannotOverwriteAnExplicitSelectionFromAnySourceLoan(){
    Array<UiComboBehaviorCallbackStageEnum, 6u> stages = Array<UiComboBehaviorCallbackStageEnum, 6u>();
    stages[0u] = UiComboBehaviorCallbackStage::Generation;
    stages[1u] = UiComboBehaviorCallbackStage::Revision;
    stages[2u] = UiComboBehaviorCallbackStage::Count;
    stages[3u] = UiComboBehaviorCallbackStage::Lookup;
    stages[4u] = UiComboBehaviorCallbackStage::Key;
    stages[5u] = UiComboBehaviorCallbackStage::Enabled;
    for(in UiComboBehaviorCallbackStageEnum stage : stages){
        ComboState state = ComboState();
        UiComboBehaviorSource source = UiComboBehaviorSource(state);
        state.select(4u);
        ASSERT_TRUE(UiComboBehaviorReconcile(state, source));
        UiComboBehaviorOpen(state);
        source.arm(stage, UiComboBehaviorCallbackMutation::Select, 8u);
        EXPECT_FALSE(UiComboBehaviorReconcile(state, source));
        EXPECT_EQ(state.selectedKey(), 8u);
        EXPECT_EQ(state.listState().cursorKey(), 8u);
        EXPECT_FALSE(state.isOpen());
    }
}

void VerifyUiComboBehaviorTests_CommitCannotOverwriteAnExplicitSelectionFromAnySourceLoan(){
    Array<UiComboBehaviorCallbackStageEnum, 6u> stages = Array<UiComboBehaviorCallbackStageEnum, 6u>();
    stages[0u] = UiComboBehaviorCallbackStage::Generation;
