#include <impl/ecs_ui/toolkit/input/default_key_bindings.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class InputBindings : NoCopy{
    private Vector<InputKeyBinding> m_bindings;

    public InputBindings(){
        this.m_bindings.reserve(s_InputMaxBindings);
        this.restoreDefaults();
    }

    public b8 set(in Span<InputKeyBinding> bindings){
        Vector<InputKeyBinding> candidate;
        if(!TryBuildInputKeyBindingProfile(bindings, candidate))
            return false;
        this.m_bindings = candidate;
        return true;
    }

    public void restoreDefaults(){
        Vector<InputKeyBinding> candidate;
        if(!BuildDefaultInputKeyBindingProfile(candidate))
            TerminateInvariant();
        this.m_bindings = candidate;
    }

    public InputCommandIntent resolve(in i32 key, in i32 modifiers)const{
        return ResolveInputKeyBinding(this.m_bindings, key, modifiers, IsValidInputKeyCode(key), s_InputBindingModifierMask, s_InputLockModifierMask, s_InputModifierShift);
    }

    public Span<InputKeyBinding> bindings()const{
        return this.m_bindings;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

