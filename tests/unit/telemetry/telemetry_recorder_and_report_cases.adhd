const StringView s_RendererFrame = "renderer/frame";
const StringView s_RendererFrameText = "Renderer Frame";
const StringView s_GBuffer = "gbuffer";
const StringView s_RuntimeStatisticsNone = "runtime_statistics=\"none\"";
const StringView s_RuntimeStatisticsNullJson = "\"runtimeStatistics\": null";
const StringView s_ResourceWithNullStatisticsJson = "\"kind\": \"resource\", \"flags\": 0, \"queueAssignment\": null, \"compiledTask\": null, \"runtimeStatistics\": null";


