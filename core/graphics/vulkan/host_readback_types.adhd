native{
#include <core/graphics/vulkan/global.h>
namespace NWB::Core::GraphicsBackend::VulkanDetail{
using BreadcrumbDeviceSize = VkDeviceSize;
};
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class AmdBreadcrumbRingLayout{
    public usize physicalQueueCount = 0u;
    public usize slotsPerQueue = 0u;
    public usize totalSlotCount = 0u;
    public BreadcrumbDeviceSize totalByteSize = 0u;
    public u16 deviceGeneration = 0u;
}


class AmdBreadcrumbRingSlot{
    public usize flatSlot = 0u;
    public BreadcrumbDeviceSize byteOffset = 0u;
}


class AmdBreadcrumbReservation{
    public u64 serial = 0u;
    public usize localSlot = 0u;
    public u32 marker = 0u;
}


