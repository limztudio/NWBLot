////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_name("::NWB::Impl::RendererRayTracingState")]
extern class RendererRayTracingState;
[cpp_name("::NWB::Impl::DeferredFrameTargets")]
extern class DeferredFrameTargets;


[modular]
class ShadowVisibilityTargetBuilder : NoCopy{
    private mut GraphicsRuntime m_graphics;
    private mut RendererRayTracingState m_rayTracingState;

    public ShadowVisibilityTargetBuilder(mut GraphicsRuntime graphics, mut RendererRayTracingState rayTracingState){
        this.m_graphics = graphics;
        this.m_rayTracingState = rayTracingState;
    }

    public b8 build(mut DeferredFrameTargets targets);
}


