void VerifyMultilineCommandTests_InvalidTextModeAndNonEditingAcceptAreRejected(in MultilineCommandTests self){
    EXPECT_EQ(TranslateEditCommand(MakeUiMultilineIntent(InputCommand::Accept, false, false), false, EditTextMode::Multiline).command, EditCommand::None);
    EXPECT_EQ(TranslateEditCommand(MakeUiMultilineIntent(InputCommand::Accept, false, true), false, bit_cast<EditTextModeEnum>(u8(255u))).command, EditCommand::None);
}

void VerifyMultilineCommandTests_RepeatedAcceptInsertsExactlyOneLfWithoutSubmitting(mut MultilineCommandTests self){
    ASSERT_TRUE(self.m_model.setText("ab"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 1u));
    const EditCommandResult inserted = ApplyEditCommand(self.m_model, TranslateEditCommand(MakeUiMultilineIntent(InputCommand::Accept, false, true), false, self.m_model.textMode()));
    EXPECT_TRUE(inserted.handled);
    EXPECT_TRUE(inserted.textChanged);
    EXPECT_TRUE(inserted.selectionChanged);
    EXPECT_FALSE(inserted.submitted);
    EXPECT_EQ(self.m_model.text(), "a\nb");
    const EditCommandResult repeated = ApplyEditCommand(self.m_model, TranslateEditCommand(MakeUiMultilineIntent(InputCommand::Accept, false, true), true, self.m_model.textMode()));
    EXPECT_TRUE(repeated.textChanged);
    EXPECT_FALSE(repeated.submitted);
    EXPECT_EQ(self.m_model.text(), "a\n\nb");
}

void VerifyMultilineCommandTests_SubmitIntentReportsWithoutEditingAndSuppressesRepeats(mut MultilineCommandTests self){
    ASSERT_TRUE(self.m_model.setText("a\nb"));
    const MultilineSnapshot before = MultilineSnapshot(self.m_arena, self.m_model);
    const EditCommandResult submitted = ApplyEditCommand(self.m_model, TranslateEditCommand(MakeUiMultilineIntent(InputCommand::Submit, false, true), false, self.m_model.textMode()));
    EXPECT_TRUE(submitted.handled);
    EXPECT_TRUE(submitted.submitted);
    EXPECT_FALSE(submitted.textChanged);
    EXPECT_FALSE(submitted.selectionChanged);
    before.expectUnchanged(self.m_model);
    const EditCommandResult repeated = ApplyEditCommand(self.m_model, TranslateEditCommand(MakeUiMultilineIntent(InputCommand::Submit, false, true), true, self.m_model.textMode()));
    EXPECT_TRUE(repeated.handled);
    EXPECT_FALSE(repeated.submitted);
    before.expectUnchanged(self.m_model);
}

void VerifyMultilineCommandTests_ReadOnlyRejectsNewlineAndMutationsWhileAllowingCopy(mut MultilineCommandTests self){
    ASSERT_TRUE(self.m_model.setText("ab\ncd"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 4u));
    const MultilineSnapshot before = MultilineSnapshot(self.m_arena, self.m_model);
    Array<EditCommandEnum, 9u> mutations = Array<EditCommandEnum, 9u>();
    mutations[0u] = EditCommand::Newline;
    mutations[1u] = EditCommand::Backspace;
    mutations[2u] = EditCommand::Delete;
    mutations[3u] = EditCommand::WordBackspace;
    mutations[4u] = EditCommand::WordDelete;
    mutations[5u] = EditCommand::Cut;
    mutations[6u] = EditCommand::Paste;
    mutations[7u] = EditCommand::Undo;
    mutations[8u] = EditCommand::Redo;
    for(in EditCommandEnum command : mutations){
        const EditCommandResult result = ApplyEditCommand(self.m_model, MakeUiMultilineCommand(command), true);
        EXPECT_TRUE(result.handled);
        EXPECT_FALSE(result.textChanged);
        EXPECT_FALSE(result.selectionChanged);
        EXPECT_EQ(result.clipboard, EditClipboardAction::None);
        before.expectUnchanged(self.m_model);
    }
    EXPECT_EQ(ApplyEditCommand(self.m_model, MakeUiMultilineCommand(EditCommand::Copy), true).clipboard, EditClipboardAction::Copy);
}

void VerifyMultilineCommandTests_PreeditOwnsNewlineDocumentMovementAndSubmitUntilFirstEscape(mut MultilineCommandTests self){
    ASSERT_TRUE(self.m_model.setText("ab\ncd"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 4u));
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("q\nr", 1u, 3u));
    const MultilineSnapshot before = MultilineSnapshot(self.m_arena, self.m_model);
    Array<EditCommandEnum, 8u> nativeOwned = Array<EditCommandEnum, 8u>();
    nativeOwned[0u] = EditCommand::Newline;
    nativeOwned[1u] = EditCommand::Home;
    nativeOwned[2u] = EditCommand::End;
    nativeOwned[3u] = EditCommand::DocumentHome;
    nativeOwned[4u] = EditCommand::DocumentEnd;
    nativeOwned[5u] = EditCommand::Submit;
    nativeOwned[6u] = EditCommand::Backspace;
    nativeOwned[7u] = EditCommand::Copy;
    for(in EditCommandEnum command : nativeOwned){
        const EditCommandResult result = ApplyEditCommand(self.m_model, MakeUiMultilineCommand(command));
        EXPECT_TRUE(result.handled);
        EXPECT_FALSE(result.textChanged);
        EXPECT_FALSE(result.selectionChanged);
        EXPECT_FALSE(result.submitted);
        EXPECT_EQ(result.clipboard, EditClipboardAction::None);
        before.expectUnchanged(self.m_model);
    }
    const u64 selection = self.m_model.selectionGeneration();
    const EditCommandResult firstEscape = ApplyEditCommand(self.m_model, MakeUiMultilineCommand(EditCommand::Cancel));
    EXPECT_TRUE(firstEscape.compositionChanged);
    EXPECT_FALSE(firstEscape.cancelled);
    EXPECT_FALSE(self.m_model.composition().active);
    EXPECT_EQ(self.m_model.text(), "ab\ncd");
    EXPECT_EQ(self.m_model.selectionGeneration(), selection);
    EXPECT_TRUE(ApplyEditCommand(self.m_model, MakeUiMultilineCommand(EditCommand::Cancel)).cancelled);
    EXPECT_TRUE(ApplyEditCommand(self.m_model, MakeUiMultilineCommand(EditCommand::Newline)).textChanged);
    EXPECT_EQ(self.m_model.text(), "a\nd");
}

void VerifyMultilineCommandTests_NewlineCapacityAndSingleLineRejectionPreserveAllState(mut MultilineCommandTests self){
    EditModel limited = EditModel(self.m_arena, MakeUiMultilineLimits(3u, 8u, 128u), EditTextMode::Multiline);
    ASSERT_TRUE(limited.setText("a\nb"));
    const MultilineSnapshot before = MultilineSnapshot(self.m_arena, limited);
    const EditCommandResult rejected = ApplyEditCommand(limited, MakeUiMultilineCommand(EditCommand::Newline));
    EXPECT_TRUE(rejected.handled);
    EXPECT_FALSE(rejected.textChanged);
    EXPECT_FALSE(rejected.selectionChanged);
    before.expectUnchanged(limited);
    EditModel single = EditModel(self.m_arena);
    ASSERT_TRUE(single.setText("abc"));
    const MultilineSnapshot singleBefore = MultilineSnapshot(self.m_arena, single);
    EXPECT_FALSE(ApplyEditCommand(single, MakeUiMultilineCommand(EditCommand::Newline)).textChanged);
    singleBefore.expectUnchanged(single);
}

void VerifyMultilineCommandTests_WordDeletionAcrossNewlineRestoresEachOriginalSelectionOnUndo(mut MultilineCommandTests self){
    ASSERT_TRUE(self.m_model.setText("one\ntwo"));
    EXPECT_TRUE(ApplyEditCommand(self.m_model, MakeUiMultilineCommand(EditCommand::WordBackspace)).textChanged);
    EXPECT_EQ(self.m_model.text(), "one\n");
    EXPECT_TRUE(ApplyEditCommand(self.m_model, MakeUiMultilineCommand(EditCommand::WordBackspace)).textChanged);
    EXPECT_TRUE(self.m_model.text().empty());
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "one\n");
    EXPECT_EQ(self.m_model.anchor(), 4u);
    EXPECT_EQ(self.m_model.caret(), 4u);
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "one\ntwo");
    EXPECT_EQ(self.m_model.anchor(), 7u);
    EXPECT_EQ(self.m_model.caret(), 7u);
}


