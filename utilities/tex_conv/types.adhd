const Name s_UtilityArena = "utilities/tex_conv/utility";
const Name s_ConversionScratchArena = "utilities/tex_conv/conversion";

const StringView s_AlphaWhiteKeyword = "white";
const StringView s_AlphaBlackKeyword = "black";
const f32 s_AlphaWhiteConstant = 1.0f;
const f32 s_AlphaBlackConstant = 0.0f;
const StringView s_PngExtension = ".png";
const StringView s_JpgExtension = ".jpg";
const StringView s_JpegExtension = ".jpeg";
const StringView s_JfifExtension = ".jfif";
const StringView s_TgaExtension = ".tga";
const StringView s_QoiExtension = ".qoi";
const StringView s_ExrExtension = ".exr";
const StringView s_HdrExtension = ".hdr";

const u32 s_ColorChannelCount = 4u;
const f32 s_UastcHdrMaximum = 65216.0f;
const f32 s_SrgbLinearSegmentScale = 12.92f;
const f32 s_SrgbOffset = 0.055f;
const f32 s_SrgbOffsetScale = 1.055f;
const f32 s_SrgbDecodeExponent = 2.4f;
const f32 s_SrgbLinearThreshold = 0.04045f;

const u32 s_EncoderWorkerCount = 1u;
const f32 s_UnormScale = 255.0f;
const f32 s_UnormRoundingBias = 0.5f;
const u32 s_SeparateAlphaPayloadMultiplier = 2u;
const StringView s_MipFilter = "box";
const usize s_InvalidSlice = ~cast<usize>(0u);

const StringView s_NewLine = "\r\n";
const StringView s_PublicationDiagnosticTag = "tex_conv_publication";

const StringView s_InputOptionName = "input";
const StringView s_CubeOptionName = "--cube";
const StringView s_VolumeOptionName = "--volume";
const StringView s_OutputOptionName = "-o,--output";
const StringView s_AlphaOptionName = "--alpha";
const StringView s_LinearFlagName = "--linear";
const StringView s_ForceFlagName = "--force";
const i32 s_MinVolumeSliceCount = 1;
const i32 s_UnboundedOptionCount = -1;
const u32 s_SingleTextureInputModeCount = 1u;
const i32 s_AlphaOptionPresentCount = 0;
const i32 s_TexConvExitSuccess = 0;
const i32 s_TexConvExitFailure = 1;
const i32 s_TexConvExitFatal = -1;
const usize s_CompletionReportReserveSlack = 128u;

f32 ResolveMaxTexConvRgb(in b8 hdr){
    if(hdr)
        return s_UastcHdrMaximum;
    return 1.0f;
}

f32x4 QuantizeUnorm(in f32x4 value){
    return saturate(value) * s_UnormScale + s_UnormRoundingBias;
}

class VolumeMipZSlabRange{
    public u64 intervalBegin = 0u;
    public u64 intervalEnd = 0u;
    public u32 first = 0u;
    public u32 end = 0u;
}

b8 ValidateTexConvRgbPixel(in f32x4 rgb, in f32 maxRgb){
    if(
        !isFinite(rgb.x)
        || !isFinite(rgb.y)
        || !isFinite(rgb.z)
        || rgb.x < 0.0f
        || rgb.y < 0.0f
        || rgb.z < 0.0f
        || rgb.x > maxRgb
        || rgb.y > maxRgb
        || rgb.z > maxRgb
    ){
        error("tex_conv: RGB input must contain finite values in [0, {}].", maxRgb);
        return false;
    }
    return true;
}

Expected<f32> TryResolveTexConvPixelAlpha(
    in AlphaSourceMode mode,
    in f32 sourceAlpha,
    in f32 constantAlpha,
    in f32 maskAlpha
){
    f32 alpha = sourceAlpha;
    if(mode == AlphaSourceMode::Constant)
        alpha = constantAlpha;
    else if(mode == AlphaSourceMode::Image)
        alpha = maskAlpha;
    if(!isFinite(alpha)){
        error("tex_conv: alpha input contains a non-finite value.");
        return makeUnexpected(Failure());
    }
    if(mode != AlphaSourceMode::Original)
        return clamp(alpha, 0.0f, 1.0f);
    if(alpha < 0.0f || alpha > 1.0f){
        error("tex_conv: original alpha input must be in [0, 1].");
        return makeUnexpected(Failure());
    }
    return alpha;
}

VolumeMipZSlabRange ComputeVolumeMipZSlabRange(in u32 z, in u32 sourceDepth, in u32 targetDepth){
    VolumeMipZSlabRange range;
    range.intervalBegin = cast<u64>(z) * cast<u64>(sourceDepth);
    range.intervalEnd = cast<u64>(z + 1u) * cast<u64>(sourceDepth);
    range.first = cast<u32>(range.intervalBegin / cast<u64>(targetDepth));
    range.end = cast<u32>(divideUp(range.intervalEnd, cast<u64>(targetDepth)));
    return range;
}

f32 ComputeVolumeMipZSlabOverlap(in VolumeMipZSlabRange range, in u32 sourceZ, in u32 targetDepth){
    const u64 slabBegin = cast<u64>(sourceZ) * cast<u64>(targetDepth);
    const u64 slabEnd = cast<u64>(sourceZ + 1u) * cast<u64>(targetDepth);
    return cast<f32>(min(range.intervalEnd, slabEnd) - max(range.intervalBegin, slabBegin));
}

b8 ValidateTexConvPlaneResolution(
    in b8 isFirstPlane,
    in b8 isCube,
    in b8 hasAlphaMask,
    in u32 planeWidth,
    in u32 planeHeight,
    in u32 alphaWidth,
    in u32 alphaHeight,
    mut u32 inOutWidth,
    mut u32 inOutHeight
){
    if(isFirstPlane){
        inOutWidth = planeWidth;
        inOutHeight = planeHeight;
        if(isCube && inOutWidth != inOutHeight){
            error("tex_conv: cubemap faces must be square.");
            return false;
        }
        if(hasAlphaMask && (alphaWidth != inOutWidth || alphaHeight != inOutHeight)){
            error("tex_conv: alpha image resolution must match the texture input resolution.");
            return false;
        }
        return true;
    }
    if(planeWidth != inOutWidth || planeHeight != inOutHeight){
        error("tex_conv: texture inputs must have the same resolution.");
        return false;
    }
    return true;
}


