        const Expected<GpuTaskId> gpuTaskAdmission = context.addLeaseTask<ReflectionStatsDestructorLeaseTask, ReflectionStatistics>(MakeReflectionStatisticsTaskDesc(), MakeReflectionStatisticsMetadata());
