const usize s_GlobalArenaIterations = 32768u;
const usize s_GlobalArenaAllocationBytes = 128u;
const usize s_PersistentHandoffThreads = 4u;
const usize s_PersistentHandoffIterations = 4096u;
const usize s_PersistentHandoffAlignment = 256u;
const usize s_PersistentHandoffBytes = 256u;
const usize s_PersistentResizeIterations = 4096u;
const usize s_PersistentResizeInitialBytes = 113u;
const usize s_PersistentResizeBytes = 389u;
const usize s_PersistentResizeAlignment = 256u;
const usize s_VerifyAlignedReallocationGrownBytes = s_AllocCaseVerifyAlignedReallocationAlignment * 4u;

class SharedArenaPayload{
    public Vector<u32> values;
}

void VerifyAlignedReallocation<Arena>(mut Arena testArena){
    {
        EXPECT_EQ(ResizeBytes(testArena, RawAllocation(), s_AllocCaseVerifyAlignedReallocationAlignment, 0u), RawAllocation());
        RawAllocation initial = ResizeBytes(testArena, RawAllocation(), s_AllocCaseVerifyAlignedReallocationAlignment, s_AllocCaseVerifyAlignedReallocationAlignment);
        ASSERT_NE(initial, RawAllocation());
        EXPECT_EQ(initial.address() % s_AllocCaseVerifyAlignedReallocationAlignment, 0u);
        for(usize i = 0u; i < s_AllocCaseVerifyAlignedReallocationAlignment; ++i)
            initial[i] = cast<u8>(i);

        RawAllocation blocker = AllocateBytes(testArena, 1u, s_AllocCaseVerifyAlignedReallocationAlignment);
        ASSERT_NE(blocker, RawAllocation());

        RawAllocation resized = ResizeBytes(testArena, initial, s_AllocCaseVerifyAlignedReallocationAlignment, s_VerifyAlignedReallocationGrownBytes);
        ASSERT_NE(resized, RawAllocation());
        EXPECT_EQ(resized.address() % s_AllocCaseVerifyAlignedReallocationAlignment, 0u);
        for(usize i = 0u; i < s_AllocCaseVerifyAlignedReallocationAlignment; ++i)
            EXPECT_EQ(resized[i], cast<u8>(i));

        FreeBytes(testArena, blocker, 1u, s_AllocCaseVerifyAlignedReallocationAlignment);
        EXPECT_EQ(ResizeBytes(testArena, resized, s_AllocCaseVerifyAlignedReallocationAlignment, 0u), RawAllocation());
    }
}

b8 RunAllocationBatch<const usize Count>(in Array<AllocationRequest, Count> requests, mut ScratchStorage testArena){
    b8 valid = true;
    {
        Array<RawAllocation, Count> allocations;
        usize prepared = 0u;
        while(prepared < Count){
            in AllocationRequest request = requests[prepared];
            RawAllocation allocation = AllocateBytes(testArena, request.alignment, request.bytes);
            if(allocation.address() == 0u){
                valid = false;
                break;
            }
            allocations[prepared] = allocation;
            valid &= allocation.address() % request.alignment == 0u;
            allocation[0u] = cast<u8>(prepared + 1u);
            allocation[request.bytes - 1u] = cast<u8>(prepared + s_AllocCaseScratchReuseTailTagOffset);
            ++prepared;
        }
        while(prepared != 0u){
            --prepared;
            const usize index = prepared;
            in AllocationRequest request = requests[index];
            RawAllocation allocation = allocations[index];
            valid &= allocation[0u] == cast<u8>(index + 1u);
            valid &= allocation[request.bytes - 1u] == cast<u8>(index + s_AllocCaseScratchReuseTailTagOffset);
            FreeBytes(testArena, allocation, request.alignment, request.bytes);
        }
    }
    return valid;
}

b8 RunScopedCollection(in usize count, mut ScratchStorage testArena){
    b8 valid = true;
    {
        TestValueSlot<Vector<u64>> keysSlot;
        mut Vector<u64> keys = keysSlot.constructIn(testArena);
        keys.resize(count);
        for(usize index = 0u; index < count; ++index)
            keys[index] = cast<u64>(count - index - 1u);
        TestValueSlot<Vector<u64>> payloadSlot;
        mut Vector<u64> payload = payloadSlot.constructIn(testArena);
        payload.resize(count * 3u);
        for(usize index = 0u; index < payload.size(); ++index)
            payload[index] = cast<u64>(index * 7u + 3u);
        {
            TestValueSlot<Vector<usize>> ordinalsSlot;
            mut Vector<usize> ordinals = ordinalsSlot.constructIn(testArena);
            ordinals.resize(count);
            for(usize index = 0u; index < count; ++index)
                ordinals[index] = index;
            SortAllocationKeys(keys);
            TestValueSlot<String> pathSlot;
            mut String path = pathSlot.constructIn(testArena);
            path.reserve(s_AllocCaseScratchReusePathReserveBytes);
            path += "project/fixtures/transient_collection/";
            path += "resolved_asset_name_with_a_nontrivial_path_length";
            if(path.size() <= 32u)
                valid = false;
            else{
                for(usize index = 0u; index < count; ++index){
                    if(keys[index] != ordinals[index] || payload[index * 3u] != cast<u64>(index * 21u + 3u)){
                        valid = false;
                        break;
                    }
                }
            }
        }
    }
    return valid;
}

void VerifyArenaAlignedReallocation_GlobalArenaReallocationPreservesAlignment(){
    HeapStorage testArena(s_TestArena);
    VerifyAlignedReallocation(testArena);
}

void VerifyArenaAlignedReallocation_PersistentArenaReallocationPreservesAlignment(){
    PersistentStorage testArena(s_TestArena, PersistentArenaStructureAlignedSize(16u * 1024u));
    VerifyAlignedReallocation(testArena);
}

void VerifyGlobalArenaTests_SharedOwnerAllocationChurnPreservesPayloadAndAccounting(){
    const usize threadCount = 4u;
    Array<AllocatorWorkerResult, 4> results = Array<AllocatorWorkerResult, 4>();

    {
        Array<Optional<JoiningThread>, 4u> workers;
        Latch workersReady(threadCount);
        Latch start(1u);

        for(usize threadIndex = 0u; threadIndex < threadCount; ++threadIndex){
            workers[threadIndex].emplace(lambda[mut results, mut workersReady, mut start, in threadIndex]() -> void{
                HeapStorage workerStorage(s_GlobalSharedOwnerAllocationChurn);
                b8 allocationFailed = false;
                b8 contentsPreserved = true;
                workersReady.count_down();
                start.wait();

                for(usize iteration = 0u; iteration < s_GlobalArenaIterations; ++iteration){
                    RawAllocation allocation = AllocateBytes(workerStorage, 1u, s_GlobalArenaAllocationBytes);
                    if(allocation.address() == 0u){
                        allocationFailed = true;
                        break;
                    }
                    const u8 firstByte = cast<u8>(threadIndex);
                    const u8 lastByte = cast<u8>(iteration);
                    allocation.writeVolatile(0u, firstByte);
                    allocation.writeVolatile(s_GlobalArenaAllocationBytes - 1u, lastByte);
                    contentsPreserved &= allocation.readVolatile(0u) == firstByte;
                    contentsPreserved &= allocation.readVolatile(s_GlobalArenaAllocationBytes - 1u) == lastByte;
                    FreeBytes(workerStorage, allocation, 1u, s_GlobalArenaAllocationBytes);
                }

                AllocatorWorkerResult out;
                out.stats = workerStorage.memoryStats();
                out.allocationFailed = allocationFailed;
                out.contentsPreserved = contentsPreserved;
                results[threadIndex] = out;
            });
        }

        workersReady.wait();
        start.count_down();
        for(mut Optional<JoiningThread> worker : workers)
            worker.value().join();
    }

    for(in AllocatorWorkerResult result : results){
        EXPECT_FALSE(result.allocationFailed);
        EXPECT_TRUE(result.contentsPreserved);
        EXPECT_EQ(result.stats.allocationCount, s_GlobalArenaIterations);
        EXPECT_EQ(result.stats.deallocationCount, s_GlobalArenaIterations);
        EXPECT_EQ(result.stats.reallocationCount, 0u);
        EXPECT_EQ(result.stats.usedBytes, 0u);
        EXPECT_EQ(result.stats.reservedBytes, 0u);
        EXPECT_GE(result.stats.peakUsedBytes, s_GlobalArenaAllocationBytes);
    }
}

void VerifyPersistentArenaTests_SharedArenaConcurrentAllocationCrossThreadFreeAndAccounting(){
    const usize poolBytes = PersistentArenaStructureAlignedSize(512u * 1024u);
    PersistentStorage testArena(s_PersistentArenaSharedCrossThreadChurn, poolBytes);
    Array<PersistentArenaWorkerResult, 4> results = Array<PersistentArenaWorkerResult, 4>();
    ArenaMemoryStats live = ArenaMemoryStats();

    {
        Array<RawAllocation, 4> handoffs;
        Array<Optional<JoiningThread>, 4u> workers;
        Latch workersReady(s_PersistentHandoffThreads);
        Latch start(1u);
        Latch handoffsReady(s_PersistentHandoffThreads);
        Latch releaseHandoffs(1u);

        for(usize threadIndex = 0u; threadIndex < s_PersistentHandoffThreads; ++threadIndex){
            workers[threadIndex].emplace(lambda[mut testArena, mut handoffs, mut results, mut workersReady, mut start, mut handoffsReady, mut releaseHandoffs, in threadIndex]() -> void{
                b8 allocationFailed = false;
                b8 contentsPreserved = true;
                b8 alignmentPreserved = true;
                workersReady.count_down();
                start.wait();

                RawAllocation handoff = AllocateBytes(testArena, s_PersistentHandoffAlignment, s_PersistentHandoffBytes);
                if(handoff.address() == 0u)
                    allocationFailed = true;
                else{
                    handoff.writeVolatile(0u, cast<u8>(threadIndex));
                    handoff.writeVolatile(s_PersistentHandoffBytes - 1u, cast<u8>(threadIndex + 1u));
                    alignmentPreserved &= handoff.address() % s_PersistentHandoffAlignment == 0u;
                }
                handoffs[threadIndex] = handoff;
                handoffsReady.count_down();
                releaseHandoffs.wait();

                RawAllocation handedOff = handoffs[(threadIndex + 1u) % s_PersistentHandoffThreads];
                if(handedOff.address() == 0u)
                    allocationFailed = true;
                else{
                    contentsPreserved &= handedOff.readVolatile(0u) == cast<u8>((threadIndex + 1u) % s_PersistentHandoffThreads);
                    contentsPreserved &= handedOff.readVolatile(s_PersistentHandoffBytes - 1u) == cast<u8>((threadIndex + 1u) % s_PersistentHandoffThreads + 1u);
                    FreeBytes(testArena, handedOff, s_PersistentHandoffAlignment, s_PersistentHandoffBytes);
                }

                for(usize iteration = 0u; iteration < s_PersistentHandoffIterations; ++iteration){
                    usize alignment = s_PersistentHandoffAlignment;
                    if((iteration + threadIndex) % 2u == 0u)
                        alignment = 1u;
                    RawAllocation allocation = AllocateBytes(testArena, alignment, 113u);
                    if(allocation.address() == 0u){
                        allocationFailed = true;
                        break;
                    }
                    const u8 firstByte = cast<u8>(threadIndex + iteration);
                    const u8 lastByte = cast<u8>(threadIndex + iteration + 1u);
                    allocation.writeVolatile(0u, firstByte);
                    allocation.writeVolatile(112u, lastByte);
                    alignmentPreserved &= allocation.address() % alignment == 0u;
                    YieldThread();
                    contentsPreserved &= allocation.readVolatile(0u) == firstByte;
                    contentsPreserved &= allocation.readVolatile(112u) == lastByte;
                    FreeBytes(testArena, allocation, alignment, 113u);
                }

                PersistentArenaWorkerResult out;
                out.allocationFailed = allocationFailed;
                out.contentsPreserved = contentsPreserved;
                out.alignmentPreserved = alignmentPreserved;
                results[threadIndex] = out;
            });
        }

        workersReady.wait();
        start.count_down();
        handoffsReady.wait();
        live = testArena.memoryStats();
        releaseHandoffs.count_down();
        for(mut Optional<JoiningThread> worker : workers)
            worker.value().join();
    }

    const ArenaMemoryStats settled = testArena.memoryStats();
    const u64 expectedOperations = cast<u64>(s_PersistentHandoffThreads * (s_PersistentHandoffIterations + 1u));
    for(in PersistentArenaWorkerResult result : results){
        EXPECT_FALSE(result.allocationFailed);
        EXPECT_TRUE(result.contentsPreserved);
        EXPECT_TRUE(result.alignmentPreserved);
    }
    EXPECT_EQ(live.reservedBytes, poolBytes);
    EXPECT_EQ(live.allocationCount, s_PersistentHandoffThreads);
    EXPECT_EQ(live.reallocationCount, 0u);
    EXPECT_EQ(live.deallocationCount, 0u);
    EXPECT_GT(live.usedBytes, 0u);
    EXPECT_EQ(live.peakUsedBytes, live.usedBytes);
    EXPECT_EQ(settled.reservedBytes, poolBytes);
    EXPECT_EQ(settled.usedBytes, 0u);
    EXPECT_EQ(settled.allocationCount, expectedOperations);
    EXPECT_EQ(settled.reallocationCount, 0u);
    EXPECT_EQ(settled.deallocationCount, expectedOperations);
    EXPECT_GE(settled.peakUsedBytes, live.usedBytes);
    EXPECT_LE(settled.peakUsedBytes, poolBytes);
}

void VerifyPersistentArenaTests_SharedArenaConcurrentReallocationPreservesPayloadAndAccounting(){
    const usize threadCount = 4u;
    const usize poolBytes = PersistentArenaStructureAlignedSize(512u * 1024u);
    PersistentStorage testArena(s_PersistentArenaSharedReallocationChurn, poolBytes);
    Array<PersistentArenaWorkerResult, 4> results = Array<PersistentArenaWorkerResult, 4>();

    {
        Array<Optional<JoiningThread>, 4u> workers;
        Latch workersReady(threadCount);
        Latch start(1u);

        for(usize threadIndex = 0u; threadIndex < threadCount; ++threadIndex){
            workers[threadIndex].emplace(lambda[mut testArena, mut results, mut workersReady, mut start, in threadIndex]() -> void{
                b8 allocationFailed = false;
                b8 contentsPreserved = true;
                b8 alignmentPreserved = true;
                workersReady.count_down();
                start.wait();

                for(usize iteration = 0u; iteration < s_PersistentResizeIterations; ++iteration){
                    RawAllocation allocation = AllocateBytes(testArena, 1u, s_PersistentResizeInitialBytes);
                    if(allocation.address() == 0u){
                        allocationFailed = true;
                        break;
                    }
                    const u8 firstByte = cast<u8>(threadIndex + iteration);
                    const u8 lastByte = cast<u8>(threadIndex + iteration + 1u);
                    allocation.writeVolatile(0u, firstByte);
                    allocation.writeVolatile(s_PersistentResizeInitialBytes - 1u, lastByte);
                    YieldThread();

                    RawAllocation replacement = ResizeBytes(testArena, allocation, s_PersistentResizeAlignment, s_PersistentResizeBytes);
                    if(replacement.address() == 0u){
                        allocationFailed = true;
                        FreeBytes(testArena, allocation, 1u, s_PersistentResizeInitialBytes);
                        break;
                    }
                    allocation = replacement;
                    contentsPreserved &= allocation.readVolatile(0u) == firstByte;
                    contentsPreserved &= allocation.readVolatile(s_PersistentResizeInitialBytes - 1u) == lastByte;
                    alignmentPreserved &= allocation.address() % s_PersistentResizeAlignment == 0u;
                    FreeBytes(testArena, allocation, s_PersistentResizeAlignment, s_PersistentResizeBytes);
                }

                PersistentArenaWorkerResult out;
                out.allocationFailed = allocationFailed;
                out.contentsPreserved = contentsPreserved;
                out.alignmentPreserved = alignmentPreserved;
                results[threadIndex] = out;
            });
        }

        workersReady.wait();
        start.count_down();
        for(mut Optional<JoiningThread> worker : workers)
            worker.value().join();
    }

    const ArenaMemoryStats settled = testArena.memoryStats();
    const u64 expectedOperations = cast<u64>(threadCount * s_PersistentResizeIterations);
    for(in PersistentArenaWorkerResult result : results){
        EXPECT_FALSE(result.allocationFailed);
        EXPECT_TRUE(result.contentsPreserved);
        EXPECT_TRUE(result.alignmentPreserved);
    }
    EXPECT_EQ(settled.reservedBytes, poolBytes);
    EXPECT_EQ(settled.usedBytes, 0u);
    EXPECT_EQ(settled.allocationCount, expectedOperations);
    EXPECT_EQ(settled.reallocationCount, expectedOperations);
    EXPECT_EQ(settled.deallocationCount, expectedOperations);
    EXPECT_LE(settled.peakUsedBytes, poolBytes);
}

void VerifyPersistentArenaTests_StructureAlignedSizeFitsExactPayloadAndReusesTheFixedPool(){
    PersistentStorage testArena(s_AllocCasePersistentArenaExactPayload, PersistentArenaStructureAlignedSize(s_AllocCasePersistentArenaHighAlignment));
    const ArenaMemoryStats initial = testArena.memoryStats();

    {
        RawAllocation first = AllocateBytes(testArena, 1u, s_AllocCasePersistentArenaHighAlignment);
        ASSERT_NE(first, RawAllocation());
        FillPattern(first, s_AllocCasePersistentArenaHighAlignment);
        const ArenaMemoryStats allocated = testArena.memoryStats();
        EXPECT_EQ(allocated.reservedBytes, initial.reservedBytes);
        EXPECT_GT(allocated.usedBytes, 0u);
        EXPECT_EQ(allocated.allocationCount, initial.allocationCount + 1u);

        EXPECT_EQ(AllocateBytes(testArena, 1u, 1u), RawAllocation());
        ExpectMemoryStatsEqual(allocated, testArena.memoryStats());

        FreeBytes(testArena, first, 1u, s_AllocCasePersistentArenaHighAlignment);
        EXPECT_EQ(testArena.memoryStats().usedBytes, 0u);
        RawAllocation reused = AllocateBytes(testArena, 1u, s_AllocCasePersistentArenaHighAlignment);
        ASSERT_NE(reused, RawAllocation());
        FillPattern(reused, s_AllocCasePersistentArenaHighAlignment);
        ExpectPattern(reused, s_AllocCasePersistentArenaHighAlignment);
        FreeBytes(testArena, reused, 1u, s_AllocCasePersistentArenaHighAlignment);
    }

    EXPECT_EQ(testArena.memoryStats().usedBytes, 0u);
}

void VerifyPersistentArenaTests_StructureAlignedSizeFitsAnExactOverAlignedPayload(){
    PersistentStorage testArena(s_AllocCasePersistentArenaExactOveralignedPayload, PersistentArenaStructureAlignedSize(1u, s_AllocCasePersistentArenaHighAlignment));

    {
        RawAllocation allocation = AllocateBytes(testArena, s_AllocCasePersistentArenaHighAlignment, 1u);
        ASSERT_NE(allocation, RawAllocation());
        EXPECT_EQ(allocation.address() % s_AllocCasePersistentArenaHighAlignment, 0u);
        FreeBytes(testArena, allocation, s_AllocCasePersistentArenaHighAlignment, 1u);
    }

    EXPECT_EQ(testArena.memoryStats().usedBytes, 0u);
}

void VerifyPersistentArenaTests_StructureAlignedSizeFitsMultipleExactTypedArrayBackings(){
    const usize queueCount = 9u;
    const usize slotsPerQueue = 256u;
    const usize slotCount = queueCount * slotsPerQueue;
    usize poolBytes = 0u;
    {
        const usize slotRecordBytes = slotCount * size_of<PersistentArenaSlotRecord>();
        const usize nextSerialBytes = queueCount * size_of<u64>();
        poolBytes = PersistentArenaStructureAlignedSize(slotRecordBytes, align_of<PersistentArenaSlotRecord>())
            + PersistentArenaStructureAlignedSize(nextSerialBytes, align_of<u64>());
    }

    PersistentStorage testArena(s_AllocCasePersistentArenaFixedArrayBackings, poolBytes);
    {
        auto slotRecords = MakePersistentTestArray<PersistentArenaSlotRecord>(testArena, slotCount);
        auto nextSerials = MakePersistentTestArray<u64>(testArena, queueCount);

        ASSERT_TRUE(slotRecords);
        ASSERT_TRUE(nextSerials);
    }

    EXPECT_EQ(testArena.memoryStats().usedBytes, 0u);
}

void VerifyPersistentArenaTests_ReusesAdjacentFreeBlocksForGrowthAndCoalescing(){
    const usize growthBytes = 512u;
    const usize blockBytes = 1024u;
    const usize grownBytes = 1024u;
    const usize combinedBytes = 1536u;
    PersistentStorage testArena(s_AllocCasePersistentArenaCoalescing, PersistentArenaStructureAlignedSize(s_AllocCasePersistentArenaHighAlignment));

    {
        RawAllocation growth = AllocateBytes(testArena, 1u, growthBytes);
        RawAllocation neighbor = AllocateBytes(testArena, 1u, blockBytes);
        ASSERT_NE(growth, RawAllocation());
        ASSERT_NE(neighbor, RawAllocation());
        FillPattern(growth, growthBytes);
        FreeBytes(testArena, neighbor, 1u, blockBytes);

        RawAllocation grown = ResizeBytes(testArena, growth, 1u, grownBytes);
        ASSERT_EQ(grown, growth);
        ExpectPattern(grown, growthBytes);
        FreeBytes(testArena, grown, 1u, grownBytes);

        RawAllocation first = AllocateBytes(testArena, 1u, blockBytes);
        RawAllocation second = AllocateBytes(testArena, 1u, blockBytes);
        RawAllocation blocker = AllocateBytes(testArena, 1u, blockBytes);
        ASSERT_NE(first, RawAllocation());
        ASSERT_NE(second, RawAllocation());
        ASSERT_NE(blocker, RawAllocation());
        EXPECT_EQ(AllocateBytes(testArena, 1u, combinedBytes), RawAllocation());

        FreeBytes(testArena, first, 1u, blockBytes);
        FreeBytes(testArena, second, 1u, blockBytes);
        RawAllocation combined = AllocateBytes(testArena, 1u, combinedBytes);
        ASSERT_NE(combined, RawAllocation());
        FreeBytes(testArena, combined, 1u, combinedBytes);
        FreeBytes(testArena, blocker, 1u, blockBytes);
    }

    EXPECT_EQ(testArena.memoryStats().usedBytes, 0u);
}

void VerifyPersistentArenaTests_ReallocationGrowsAcrossMultipleDeferredAdjacentBlocks(){
    const usize blockBytes = 512u;
    const usize grownBytes = 1600u;
    PersistentStorage testArena(s_AllocCasePersistentArenaDeferredReallocationGrowth, 3u * PersistentArenaStructureAlignedSize(blockBytes));

    {
        RawAllocation first = AllocateBytes(testArena, 1u, blockBytes);
        RawAllocation second = AllocateBytes(testArena, 1u, blockBytes);
        RawAllocation third = AllocateBytes(testArena, 1u, blockBytes);
        ASSERT_NE(first, RawAllocation());
        ASSERT_NE(second, RawAllocation());
        ASSERT_NE(third, RawAllocation());
        FillPattern(first, blockBytes);

        FreeBytes(testArena, second, 1u, blockBytes);
        const ArenaMemoryStats beforeFailedGrowth = testArena.memoryStats();
        EXPECT_EQ(ResizeBytes(testArena, first, 1u, grownBytes), RawAllocation());
        ExpectPattern(first, blockBytes);
        ExpectMemoryStatsEqual(beforeFailedGrowth, testArena.memoryStats());

        FreeBytes(testArena, third, 1u, blockBytes);

        RawAllocation grown = ResizeBytes(testArena, first, 1u, grownBytes);
        ASSERT_EQ(grown, first);
        ExpectPattern(grown, blockBytes);
        FreeBytes(testArena, grown, 1u, grownBytes);
    }

    EXPECT_EQ(testArena.memoryStats().usedBytes, 0u);
}

void VerifyPersistentArenaTests_FailedAlignedReallocationRetainsPayloadAndStats(){
    const usize initialBytes = 1024u;
    PersistentStorage testArena(s_AllocCasePersistentArenaFailedReallocation, PersistentArenaStructureAlignedSize(2048u));

    {
        RawAllocation initial = AllocateBytes(testArena, 1u, initialBytes);
        RawAllocation blocker = AllocateBytes(testArena, 1u, 800u);
        ASSERT_NE(initial, RawAllocation());
        ASSERT_NE(blocker, RawAllocation());
        FillPattern(initial, initialBytes);
        const ArenaMemoryStats beforeFailure = testArena.memoryStats();

        EXPECT_EQ(ResizeBytes(testArena, initial, 256u, 1536u), RawAllocation());
        ExpectPattern(initial, initialBytes);
        ExpectMemoryStatsEqual(beforeFailure, testArena.memoryStats());

        FreeBytes(testArena, initial, 1u, initialBytes);
        FreeBytes(testArena, blocker, 1u, 800u);
    }

    EXPECT_EQ(testArena.memoryStats().usedBytes, 0u);
}

void VerifyPersistentArenaTests_ReallocationMaintainsRequestedAlignmentAcrossShrinkAndGrowth(){
    const usize initialBytes = 512u;
    const usize grownBytes = 1024u;
    PersistentStorage testArena(s_AllocCasePersistentArenaReallocationAlignment, PersistentArenaStructureAlignedSize(4096u, s_AllocCasePersistentArenaHighAlignment));

    {
        RawAllocation initial = AllocateBytes(testArena, 1u, initialBytes);
        ASSERT_NE(initial, RawAllocation());
        FillPattern(initial, initialBytes);

        RawAllocation shrunk = ResizeBytes(testArena, initial, 256u, 256u);
        ASSERT_NE(shrunk, RawAllocation());
        EXPECT_EQ(shrunk.address() % 256u, 0u);
        ExpectPattern(shrunk, 256u);

        RawAllocation grown = ResizeBytes(testArena, shrunk, s_AllocCasePersistentArenaHighAlignment, grownBytes);
        ASSERT_NE(grown, RawAllocation());
        EXPECT_EQ(grown.address() % s_AllocCasePersistentArenaHighAlignment, 0u);
        ExpectPattern(grown, 256u);
        FreeBytes(testArena, grown, s_AllocCasePersistentArenaHighAlignment, grownBytes);
    }

    EXPECT_EQ(testArena.memoryStats().usedBytes, 0u);
}

void VerifyPersistentArenaTests_ReallocationRetainsAHighAlignedBlockForLowerAlignment(){
    PersistentStorage testArena(s_AllocCasePersistentArenaReallocationLowerAlignment, PersistentArenaStructureAlignedSize(1u, s_AllocCasePersistentArenaHighAlignment));

    {
        RawAllocation allocation = AllocateBytes(testArena, s_AllocCasePersistentArenaHighAlignment, 1u);
        ASSERT_NE(allocation, RawAllocation());
        allocation[0u] = 93u;

        RawAllocation shrunk = ResizeBytes(testArena, allocation, 1u, 1u);
        ASSERT_EQ(shrunk, allocation);
        EXPECT_EQ(shrunk[0u], 93u);
        FreeBytes(testArena, shrunk, 1u, 1u);
    }

    EXPECT_EQ(testArena.memoryStats().usedBytes, 0u);
}

void VerifyPersistentArenaTests_NullAndZeroReallocationFollowAllocationAccounting(){
    PersistentStorage testArena(s_AllocCasePersistentArenaNullZeroReallocation, PersistentArenaStructureAlignedSize(s_AllocCaseSmallArenaPayloadBytes));
    const ArenaMemoryStats before = testArena.memoryStats();
    ArenaMemoryStats allocated = ArenaMemoryStats();

    {
        EXPECT_EQ(ResizeBytes(testArena, RawAllocation(), 64u, 0u), RawAllocation());
        ExpectMemoryStatsEqual(before, testArena.memoryStats());

        RawAllocation allocation = ResizeBytes(testArena, RawAllocation(), 64u, 33u);
        ASSERT_NE(allocation, RawAllocation());
        allocated = testArena.memoryStats();
        EXPECT_EQ(allocated.allocationCount, before.allocationCount + 1u);
        EXPECT_EQ(allocated.reallocationCount, before.reallocationCount);
        EXPECT_EQ(allocated.deallocationCount, before.deallocationCount);

        EXPECT_EQ(ResizeBytes(testArena, allocation, 64u, 0u), RawAllocation());
    }

    const ArenaMemoryStats released = testArena.memoryStats();
    EXPECT_EQ(released.reservedBytes, before.reservedBytes);
    EXPECT_EQ(released.usedBytes, 0u);
    EXPECT_EQ(released.allocationCount, allocated.allocationCount);
    EXPECT_EQ(released.reallocationCount, allocated.reallocationCount);
    EXPECT_EQ(released.deallocationCount, allocated.deallocationCount + 1u);
}

void VerifyPersistentArenaTests_CAllocatorAdapterRetainsMaxAlignmentAndPrefix(){
    PersistentStorage testArena(s_AllocCasePersistentArenaCAllocator, PersistentArenaStructureAlignedSize(s_AllocCaseSmallArenaPayloadBytes));

    {
        RawAllocation zeroAllocation = AllocateCBytes(testArena, 0u);
