#include <impl/ecs_render/shadow/shadow_visibility_target_builder.adhd>
#include <impl/ecs_render/raytrace/rt_private.adhd>
#include <impl/ecs_render/shadow/quality_settings.adhd>
#include <impl/ecs_render/kernel/descriptor_register_utils.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Name s_ShadowVisibilityTargetName = "engine/shadow/visibility";
const Name s_ShadowCoarseTransmittanceTargetName = "engine/shadow/coarse_transmittance";
const Name s_ShadowSoftHalfATargetName = "engine/shadow/soft_half_a";
const Name s_ShadowSoftHalfBTargetName = "engine/shadow/soft_half_b";
const Name s_ShadowSoftGeometryTargetName = "engine/shadow/soft_geometry";
const Name s_ShadowHistATargetName = "engine/shadow/hist_a";
const Name s_ShadowHistBTargetName = "engine/shadow/hist_b";
const Name s_ShadowMomentsATargetName = "engine/shadow/moments_a";
const Name s_ShadowMomentsBTargetName = "engine/shadow/moments_b";
const Name s_ShadowSoftGeometryPrevTargetName = "engine/shadow/soft_geometry_prev";
const Name s_TransparentSoftHalfTargetName = "engine/shadow/transparent_soft_half";
const Name s_TransparentHistATargetName = "engine/shadow/transparent_hist_a";
const Name s_TransparentHistBTargetName = "engine/shadow/transparent_hist_b";
const Name s_TransparentMomentsATargetName = "engine/shadow/transparent_moments_a";
const Name s_TransparentMomentsBTargetName = "engine/shadow/transparent_moments_b";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ShadowTargetGridExtents{
    public u32 coarseWidth = 0u;
    public u32 coarseHeight = 0u;
    public u32 softHalfWidth = 0u;
    public u32 softHalfHeight = 0u;
}

class SoftwareAdaptiveShadowGrid{
    public u32 fullGroupsX = 0u;
    public u32 fullGroupsY = 0u;
    public u32 coarseWidth = 0u;
    public u32 coarseHeight = 0u;
    public u32 coarseGroupsX = 0u;
    public u32 coarseGroupsY = 0u;
}


b8 IsSupportedShadowReceiverFactor(in u32 receiverFactor){
    return receiverFactor == s_ShadowReceiverFactorHalf || receiverFactor == s_ShadowReceiverFactorQuarter;
}

ShadowTargetGridExtents ResolveShadowTargetGridExtents(in u32 width, in u32 height, in u32 coarseFactor, in u32 receiverFactor){
    ShadowTargetGridExtents extents;
    extents.coarseWidth = DivideUpWrappingU32(width, coarseFactor);
    extents.coarseHeight = DivideUpWrappingU32(height, coarseFactor);
    extents.softHalfWidth = DivideUpWrappingU32(width, receiverFactor);
    extents.softHalfHeight = DivideUpWrappingU32(height, receiverFactor);
    return extents;
}

SoftwareAdaptiveShadowGrid ResolveSoftwareAdaptiveShadowGrid(in u32 width, in u32 height, in u32 coarseFactor, in u32 groupSize){
    SoftwareAdaptiveShadowGrid grid;
    grid.fullGroupsX = DivideUp(width, groupSize);
    grid.fullGroupsY = DivideUp(height, groupSize);
    grid.coarseWidth = DivideUpWrappingU32(width, coarseFactor);
    grid.coarseHeight = DivideUpWrappingU32(height, coarseFactor);
    grid.coarseGroupsX = DivideUp(grid.coarseWidth, groupSize);
    grid.coarseGroupsY = DivideUp(grid.coarseHeight, groupSize);
    return grid;
}


void PopulateSwShadowViewportPush(
    in u32 width,
    in u32 height,
    in u32 coarseWidth,
    in u32 coarseHeight,
    mut SwShadowHeapPushConstants outPush
){
    outPush.width = width;
    outPush.height = height;
    outPush.coarseWidth = coarseWidth;
    outPush.coarseHeight = coarseHeight;
}

void PopulateSwShadowClassifyPush(
    in u32 width,
    in u32 height,
    in u32 coarseWidth,
    in u32 coarseHeight,
    in u32 edgeCapacity,
    mut SwShadowHeapPushConstants outPush
){
    PopulateSwShadowViewportPush(width, height, coarseWidth, coarseHeight, outPush);
    outPush.edgeCapacity = edgeCapacity;
}

void PopulateSwShadowBuildArgsPush(in u32 traceGroupSize, in u32 edgeCapacity, mut SwShadowHeapPushConstants outPush){
    outPush.traceGroupSize = traceGroupSize;
    outPush.edgeCapacity = edgeCapacity;
}

void PopulateSwShadowIndirectTracePush(in u32 width, in u32 height, in u32 traceGroupSize, mut SwShadowHeapPushConstants outPush){
    outPush.width = width;
    outPush.height = height;
    outPush.traceGroupSize = traceGroupSize;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<impl/assets/graphics/shadow/sw_binding_slots.h>"), cpp_name("NWB_SW_SHADOW_GROUP_SIZE")]
extern const u32 s_ShaderSwShadowGroupSize;

[cpp_header("<impl/assets/graphics/shadow/sw_binding_slots.h>"), cpp_name("NWB_SW_SHADOW_TRACE_GROUP")]
extern const u32 s_ShaderSwShadowTraceGroup;

[cpp_header("<impl/assets/graphics/shadow/sw_binding_slots.h>"), cpp_name("NWB_SW_SHADOW_COARSE_FACTOR")]
extern const u32 s_ShaderSwShadowCoarseFactor;

[cpp_header("<impl/assets/graphics/shadow/sw_binding_slots.h>"), cpp_name("NWB_SW_SHADOW_EDGE_RECORD_WORDS")]
extern const u32 s_ShaderSwShadowEdgeRecordWords;

u32 EncodeShadowHistoryValidFlag(in b8 historyReadable){
    if(historyReadable)
        return 1u;
    return 0u;
}

b8 CanUseSoftwareTransparentSamplingHistory(
    in SoftwareTransparentShadowTraceInputs inputs,
    in b8 softTransparentTemporalReady,
    in b8 samplingHistoryUsable
){
    return inputs.temporalHistoryReadable && softTransparentTemporalReady && samplingHistoryUsable;
}

usize SelectSoftwareTransparentSamplingPipelineIndex(in b8 samplingHistoryUsable){
    if(samplingHistoryUsable)
        return 1u;
    return 0u;
}

b8 CreateShadowVisibilityTarget(mut GraphicsRuntime graphics, in TextureDesc sourceDesc, in Name name, in StringView message, mut TextureHandle texture){
    TextureDesc desc = sourceDesc;
    desc.setName(name);
    const Expected<TextureHandle> result = graphics.createTexture(desc);
    if(!result.has_value()){
        texture.reset();
        error("{}", message);
        return false;
    }
    texture = result.value();
    return true;
}

SwShadowHeapPushConstants MakeSoftwareShadowFramePush(in RendererRayTracingState state, in DeferredFrameTargets targets){
    return MakeSwShadowHeapPushConstants(
        state.sceneBvh.m_sceneBvhInstanceCount,
        targets.bindless.slotsBufferDescriptor.slot(),
        state.sceneBvh.m_rayTraceMaterialContextSlotsHeapHandle.slot(),
        targets.bindless.shadowVisibilityStorage.slot(),
        targets.bindless.shadowCoarseTransmittanceStorage.slot(),
        targets.bindless.shadowSoftHalfAStorage.slot(),
        targets.bindless.transparentSoftHalfStorage.slot(),
        state.shadow.m_swShadowEdgeCounterHeapHandle.slot(),
        state.shadow.m_swShadowEdgeListHeapHandle.slot(),
        state.shadow.m_swShadowIndirectArgsHeapHandle.slot(),
        targets.shadowReceiverFactor
    );
}

class ShadowReprojectMergeHeapResources{
    public TexturePtr softTrace;
    public TexturePtr historyIn;
    public TexturePtr momentsIn;
    public TexturePtr historyOut;
    public TexturePtr momentsOut;
    public u32 softTraceSlot;
    public u32 historyInSlot;
    public u32 momentsInSlot;
    public u32 historyOutStorageSlot;
    public u32 momentsOutStorageSlot;

    public ShadowReprojectMergeHeapResources(
        in TexturePtr softTrace,
        in TexturePtr historyIn,
        in TexturePtr momentsIn,
        in TexturePtr historyOut,
        in TexturePtr momentsOut,
        in u32 softTraceSlot,
        in u32 historyInSlot,
        in u32 momentsInSlot,
        in u32 historyOutStorageSlot,
        in u32 momentsOutStorageSlot
    ){
        this.softTrace = softTrace;
        this.historyIn = historyIn;
        this.momentsIn = momentsIn;
        this.historyOut = historyOut;
        this.momentsOut = momentsOut;
        this.softTraceSlot = softTraceSlot;
        this.historyInSlot = historyInSlot;
        this.momentsInSlot = momentsInSlot;
        this.historyOutStorageSlot = historyOutStorageSlot;
        this.momentsOutStorageSlot = momentsOutStorageSlot;
    }
}

[modular]
class SoftShadowTemporalMergeRecorder : NoCopy{
    private in RendererRayTracingState m_state;
    private u32 m_slotRangeCount;
    private u32 m_halfWidth;
    private u32 m_halfHeight;
    private u32 m_groupsX;
    private u32 m_groupsY;
    private b8 m_historyReadable;
    private mut CommandList m_commandList;
    private mut DeferredFrameTargets m_targets;
    private mut GpuDescriptorHeap m_heap;

    public SoftShadowTemporalMergeRecorder(
        in RendererRayTracingState state,
        in u32 slotRangeCount,
        in u32 halfWidth,
        in u32 halfHeight,
        in u32 groupsX,
        in u32 groupsY,
        in b8 historyReadable,
        mut CommandList commandList,
        mut DeferredFrameTargets targets,
        mut GpuDescriptorHeap heap
    ){
        this.m_state = state;
        this.m_slotRangeCount = slotRangeCount;
        this.m_halfWidth = halfWidth;
        this.m_halfHeight = halfHeight;
        this.m_groupsX = groupsX;
        this.m_groupsY = groupsY;
        this.m_historyReadable = historyReadable;
        this.m_commandList = commandList;
        this.m_targets = targets;
        this.m_heap = heap;
    }

    public void record(in ShadowReprojectMergeHeapResources resources, in b8 graphOwnsSoftTraceInputState, in b8 graphOwnsMergeCurrentGeometryEntryState, in b8 graphOwnsMergeStaticReadEntryStates, in b8 graphOwnsMergeTemporalEntryStates)const;
}

b8 ShadowVisibilityTargetBuilder::build(mut DeferredFrameTargets targets){
    if(!IsSupportedShadowReceiverFactor(targets.shadowReceiverFactor))
        return false;
    // Deferred lighting always samples this per-slot transmittance target.
    targets.shadowVisibilityFormat = Format::RGBA16_FLOAT;


    TextureDesc visibilityDesc;
    visibilityDesc
        .setWidth(targets.width)
        .setHeight(targets.height)
        .setArraySize(s_SceneShadowSlotCount)
        .setDimension(TextureDimension::Texture2DArray)
        .setFormat(targets.shadowVisibilityFormat)
        .setIsUAV(true)
        // The lagged-history copy may run on Transfer after producers finish. Keep all three transports shareable.
        .setQueueSharing(ResourceQueueSharing::GraphicsAsyncComputeAndTransfer)
    ;
    if(!CreateShadowVisibilityTarget(this.m_graphics, visibilityDesc, s_ShadowVisibilityTargetName, "RendererSystem: failed to create shadow visibility target", targets.shadowVisibility))
        return false;

    const ShadowTargetGridExtents targetGridExtents = ResolveShadowTargetGridExtents(
        targets.width,
        targets.height,
        s_ShaderSwShadowCoarseFactor,
        targets.shadowReceiverFactor
    );

    // Round up half-resolution scratch so odd extents retain coverage.
    targets.shadowCoarseTransmittanceFormat = Format::RGBA16_FLOAT;
    TextureDesc coarseDesc;
    coarseDesc
        .setWidth(targetGridExtents.coarseWidth)
        .setHeight(targetGridExtents.coarseHeight)
        .setArraySize(s_SceneShadowSlotCount)
        .setDimension(TextureDimension::Texture2DArray)
        .setFormat(targets.shadowCoarseTransmittanceFormat)
        .setIsUAV(true)
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
    ;
    if(!CreateShadowVisibilityTarget(this.m_graphics, coarseDesc, s_ShadowCoarseTransmittanceTargetName, "RendererSystem: failed to create shadow coarse transmittance target", targets.shadowCoarseTransmittance))
        return false;

    // Ping-pong half-resolution soft visibility and geometry cache.
    targets.shadowSoftFormat = Format::RGBA16_FLOAT;
    targets.shadowSoftGeometryFormat = Format::RGBA16_FLOAT;
    const u32 softHalfWidth = targetGridExtents.softHalfWidth;
    const u32 softHalfHeight = targetGridExtents.softHalfHeight;

    TextureDesc softHalfDesc;
    softHalfDesc
        .setWidth(softHalfWidth)
        .setHeight(softHalfHeight)
        .setArraySize(s_SceneShadowSlotCount)
        .setDimension(TextureDimension::Texture2DArray)
        .setFormat(targets.shadowSoftFormat)
        .setIsUAV(true)
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
    ;
    TextureDesc softGeometryDesc;
    softGeometryDesc
        .setWidth(softHalfWidth)
        .setHeight(softHalfHeight)
        .setFormat(targets.shadowSoftGeometryFormat)
        .setIsUAV(true)
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
    ;

    // Recreated history must not reproject through the previous target's matrix.
    if(
        !CreateShadowVisibilityTarget(this.m_graphics, softHalfDesc, s_ShadowSoftHalfATargetName, "RendererSystem: failed to create soft shadow half-A target", targets.shadowSoftHalfA)
        || !CreateShadowVisibilityTarget(this.m_graphics, softHalfDesc, s_ShadowSoftHalfBTargetName, "RendererSystem: failed to create soft shadow half-B target", targets.shadowSoftHalfB)
        || !CreateShadowVisibilityTarget(this.m_graphics, softGeometryDesc, s_ShadowSoftGeometryTargetName, "RendererSystem: failed to create soft shadow geometry cache target", targets.shadowSoftGeometry)
        || !CreateShadowVisibilityTarget(this.m_graphics, softHalfDesc, s_ShadowHistATargetName, "RendererSystem: failed to create soft shadow temporal history-A target", targets.shadowHistA)
        || !CreateShadowVisibilityTarget(this.m_graphics, softHalfDesc, s_ShadowHistBTargetName, "RendererSystem: failed to create soft shadow temporal history-B target", targets.shadowHistB)
        || !CreateShadowVisibilityTarget(this.m_graphics, softHalfDesc, s_ShadowMomentsATargetName, "RendererSystem: failed to create soft shadow temporal moments-A target", targets.shadowMomentsA)
        || !CreateShadowVisibilityTarget(this.m_graphics, softHalfDesc, s_ShadowMomentsBTargetName, "RendererSystem: failed to create soft shadow temporal moments-B target", targets.shadowMomentsB)
        || !CreateShadowVisibilityTarget(this.m_graphics, softGeometryDesc, s_ShadowSoftGeometryPrevTargetName, "RendererSystem: failed to create soft shadow previous-frame geometry cache target", targets.shadowSoftGeometryPrev)
    )
        return false;

    this.m_rayTracingState.shadow.m_softwareTransparentSampling.m_history.discard();
    this.m_rayTracingState.softShadow.m_transparentShadowSamplingHistory.reset();
    ResetSoftShadowTemporalHistoryState(
        this.m_rayTracingState.softShadow.m_softShadowTemporalSeeded,
        this.m_rayTracingState.softShadow.m_softShadowTemporalHistoryAdvancePending,
        this.m_rayTracingState.softShadow.m_prevWorldToClipValid,
        this.m_rayTracingState.softShadow.m_softShadowHistoryFrontIsA
    );

    // Transparent temporal history shares geometry and the opaque history selector.
    if(
        !CreateShadowVisibilityTarget(this.m_graphics, softHalfDesc, s_TransparentSoftHalfTargetName, "RendererSystem: failed to create soft transparent shadow half target", targets.transparentSoftHalf)
        || !CreateShadowVisibilityTarget(this.m_graphics, softHalfDesc, s_TransparentHistATargetName, "RendererSystem: failed to create soft transparent shadow history-A target", targets.transparentHistA)
        || !CreateShadowVisibilityTarget(this.m_graphics, softHalfDesc, s_TransparentHistBTargetName, "RendererSystem: failed to create soft transparent shadow history-B target", targets.transparentHistB)
        || !CreateShadowVisibilityTarget(this.m_graphics, softHalfDesc, s_TransparentMomentsATargetName, "RendererSystem: failed to create soft transparent shadow moments-A target", targets.transparentMomentsA)
        || !CreateShadowVisibilityTarget(this.m_graphics, softHalfDesc, s_TransparentMomentsBTargetName, "RendererSystem: failed to create soft transparent shadow moments-B target", targets.transparentMomentsB)
    )
        return false;

    // All resolve allocations belong to this target generation. Verify both history selectors once, before publication.
    for(u32 selector = 0u; selector < s_ShadowHistorySelectorCount; ++selector){
        const b8 frontIsA = selector != 0u;
        SoftShadowCombinedWaveletInputs waveletInputs;
        waveletInputs.opaqueHistory = targets.shadowHistA.get();
        waveletInputs.opaqueMoments = targets.shadowMomentsA.get();
        waveletInputs.transparentHistory = targets.transparentHistA.get();
        waveletInputs.transparentMoments = targets.transparentMomentsA.get();
        waveletInputs.geometry = targets.shadowSoftGeometry.get();
        waveletInputs.opaqueOutput = targets.shadowSoftHalfB.get();
        waveletInputs.transparentOutput = targets.shadowSoftHalfA.get();
        if(frontIsA){
            waveletInputs.opaqueHistory = targets.shadowHistB.get();
            waveletInputs.opaqueMoments = targets.shadowMomentsB.get();
            waveletInputs.transparentHistory = targets.transparentHistB.get();
            waveletInputs.transparentMoments = targets.transparentMomentsB.get();
        }
        if(!waveletInputs.valid()){
            error("RendererSystem: soft-shadow target allocation produced aliased resolve resources");
            return false;
        }
    }

    // Edge records are capped at one per pixel; overflow falls back to interpolation.
    const Expected<u32> edgeListCapacityResult = TryResolveShadowEdgeListCapacityRecords(targets.width, targets.height);
    if(!edgeListCapacityResult.has_value())
        return false;
    const u32 edgeListCapacityRecords = edgeListCapacityResult.value();
    BufferDesc edgeListDesc;
    edgeListDesc
        .setByteSize(cast<u64>(sizeof(u32)) * cast<u64>(s_ShaderSwShadowEdgeRecordWords) * cast<u64>(edgeListCapacityRecords))
        .setStructStride(sizeof(u32))
        .setCanHaveUAVs(true)
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
        .setDebugName(s_SoftwareShadowEdgeList)
        .enableAutomaticStateTracking(ResourceStates::Common)
    ;
    const Expected<BufferHandle> edgeListBufferResult = this.m_graphics.createBuffer(edgeListDesc);
    if(!edgeListBufferResult.has_value()){
        error("RendererSystem: failed to create SW shadow edge-list buffer");
        this.m_rayTracingState.shadow.m_swShadowEdgeListCapacity = 0u;
        return false;
    }
    BufferHandle edgeListBuffer = edgeListBufferResult.value();
    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized() || !ReplaceHeapBuffer(GpuDescriptorClass::StorageBuffer, true, heap, edgeListBuffer.deref(), this.m_rayTracingState.shadow.m_swShadowEdgeListHeapHandle)){
        error("RendererSystem: failed to register SW shadow edge-list buffer in the descriptor heap");
        this.m_rayTracingState.shadow.m_swShadowEdgeListCapacity = 0u;
        return false;
    }
    this.m_rayTracingState.shadow.m_swShadowEdgeListBuffer = edgeListBuffer;
    this.m_rayTracingState.shadow.m_swShadowEdgeListCapacity = edgeListCapacityRecords;

    LogCreatedShadowReceiverGrid(targets.shadowReceiverFactor, targets.width, targets.height, softHalfWidth, softHalfHeight);

    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void SoftShadowTemporalMergeRecorder::record(
    in ShadowReprojectMergeHeapResources resources,
    in b8 graphOwnsSoftTraceInputState,
    in b8 graphOwnsMergeCurrentGeometryEntryState,
    in b8 graphOwnsMergeStaticReadEntryStates,
    in b8 graphOwnsMergeTemporalEntryStates
)const{
    const u32 historyValid = EncodeShadowHistoryValidFlag(this.m_historyReadable);
    assert(IsValidTexturePtr(resources.softTrace) && IsValidTexturePtr(resources.historyIn) && IsValidTexturePtr(resources.momentsIn) && IsValidTexturePtr(resources.historyOut) && IsValidTexturePtr(resources.momentsOut));
    if(!graphOwnsSoftTraceInputState)
        this.m_commandList.setTextureState(resources.softTrace, s_ShadowVisibilitySubresources, ResourceStates::ShaderResource);
    if(!graphOwnsMergeTemporalEntryStates){
        if(this.m_historyReadable){
            this.m_commandList.setTextureState(resources.historyIn, s_ShadowVisibilitySubresources, ResourceStates::ShaderResource);
            this.m_commandList.setTextureState(resources.momentsIn, s_ShadowVisibilitySubresources, ResourceStates::ShaderResource);
        }
        this.m_commandList.setTextureState(resources.historyOut, s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess);
        this.m_commandList.setTextureState(resources.momentsOut, s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess);
    }
    if(!graphOwnsMergeCurrentGeometryEntryState)
        this.m_commandList.setTextureState(this.m_targets.shadowSoftGeometry.get(), s_FramebufferSubresources, ResourceStates::ShaderResource);
    if(!graphOwnsMergeStaticReadEntryStates){
        if(this.m_historyReadable)
            this.m_commandList.setTextureState(this.m_targets.shadowSoftGeometryPrev.get(), s_FramebufferSubresources, ResourceStates::ShaderResource);
        this.m_commandList.setTextureState(this.m_targets.worldPosition.get(), s_FramebufferSubresources, ResourceStates::ShaderResource);
    }
    this.m_commandList.setEnableUavBarriersForTexture(resources.historyOut, true);
    this.m_commandList.setEnableUavBarriersForTexture(resources.momentsOut, true);
    this.m_commandList.commitBarriers();

    const ShadowReprojectMergePushConstants push = MakeShadowReprojectMergePushConstants(
        Span<f32>(this.m_state.softShadow.m_prevWorldToClip.raw),
        this.m_targets.width,
        this.m_targets.height,
        this.m_halfWidth,
        this.m_halfHeight,
        this.m_slotRangeCount,
        historyValid,
        resources.softTraceSlot,
        resources.historyInSlot,
        resources.momentsInSlot,
        this.m_targets.bindless.shadowSoftGeometry.slot(),
        this.m_targets.bindless.shadowSoftGeometryPrev.slot(),
        this.m_targets.bindless.gbufferWorldPosition.slot(),
        resources.historyOutStorageSlot,
        resources.momentsOutStorageSlot,
        this.m_targets.shadowReceiverFactor
    );

    this.m_commandList.setComputeState(MakeComputePassState(this.m_state.softShadow.m_shadowReprojectMergePipeline));
    this.m_heap.bindCompute(this.m_commandList, this.m_state.softShadow.m_shadowReprojectMergePipeline.deref());
    this.m_commandList.setPushConstants(push);
    this.m_commandList.dispatch(this.m_groupsX, this.m_groupsY, 1u);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void RecordSoftwareAdaptiveShadow(in Optional<in GraphOwnedAdaptiveShadowPlan> plan, in RendererRayTracingState state, mut CommandList commandList, mut DeferredFrameTargets targets, mut GpuDescriptorHeap heap){

    const SoftwareAdaptiveShadowGrid adaptiveGrid = ResolveSoftwareAdaptiveShadowGrid(
        targets.width,
        targets.height,
        s_ShaderSwShadowCoarseFactor,
        cast<u32>(s_ShaderSwShadowGroupSize)
    );
    const u32 fullGroupsX = adaptiveGrid.fullGroupsX;
    const u32 fullGroupsY = adaptiveGrid.fullGroupsY;
    const u32 coarseWidth = adaptiveGrid.coarseWidth;
    const u32 coarseHeight = adaptiveGrid.coarseHeight;
    const u32 coarseGroupsX = adaptiveGrid.coarseGroupsX;
    const u32 coarseGroupsY = adaptiveGrid.coarseGroupsY;

    // Compacted mode traces only classified edge records.
    const b8 graphOwnsAdaptivePlan = plan.has_value() && plan.value().enabled;
    const b8 compact = graphOwnsAdaptivePlan && plan.value().compact;

    // Coarse transmittance feeds both adaptive resolve modes.
    commandList.setEnableUavBarriersForTexture(targets.shadowCoarseTransmittance.get(), true);
    commandList.setTextureState(targets.shadowCoarseTransmittance.get(), s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess);
    commandList.setTextureState(targets.shadowVisibility.get(), s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess);
    commandList.commitBarriers();
    SwShadowHeapPushConstants coarsePush = MakeSoftwareShadowFramePush(state, targets);
    PopulateSwShadowViewportPush(targets.width, targets.height, coarseWidth, coarseHeight, coarsePush);
    commandList.setComputeState(MakeComputePassState(state.shadow.m_swShadowTransparentCoarsePipeline));
    heap.bindCompute(commandList, state.shadow.m_swShadowTransparentCoarsePipeline.deref());
    commandList.setPushConstants(coarsePush);
    commandList.dispatch(coarseGroupsX, coarseGroupsY, 1u);

    // Synchronize the coarse write before resolve.
    commandList.setTextureState(targets.shadowCoarseTransmittance.get(), s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess);
    commandList.commitBarriers();

    if(compact){
        // The append list is bounded by this frame's reset counter.
        commandList.setEnableUavBarriersForBuffer(state.shadow.m_swShadowEdgeCounterBuffer.get(), true);
        commandList.setEnableUavBarriersForBuffer(state.shadow.m_swShadowEdgeListBuffer.get(), true);
        commandList.setBufferState(state.shadow.m_swShadowEdgeCounterBuffer.get(), ResourceStates::UnorderedAccess);
        commandList.setBufferState(state.shadow.m_swShadowEdgeListBuffer.get(), ResourceStates::UnorderedAccess);
        commandList.setBufferState(state.shadow.m_swShadowIndirectArgsBuffer.get(), ResourceStates::UnorderedAccess);
        commandList.commitBarriers();

        // Classify interpolated interiors and append traceable edges.
        commandList.setTextureState(targets.shadowCoarseTransmittance.get(), s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess);
        commandList.setTextureState(targets.shadowVisibility.get(), s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess);
        commandList.commitBarriers();
        SwShadowHeapPushConstants classifyPush = MakeSoftwareShadowFramePush(state, targets);
        PopulateSwShadowClassifyPush(targets.width, targets.height, coarseWidth, coarseHeight, state.shadow.m_swShadowEdgeListCapacity, classifyPush);
        commandList.setComputeState(MakeComputePassState(state.shadow.m_swShadowTransparentClassifyPipeline));
        heap.bindCompute(commandList, state.shadow.m_swShadowTransparentClassifyPipeline.deref());
        commandList.setPushConstants(classifyPush);
        commandList.dispatch(fullGroupsX, fullGroupsY, 1u);

        // Classify produces the list and in-place visibility writes.
        commandList.setBufferState(state.shadow.m_swShadowEdgeCounterBuffer.get(), ResourceStates::UnorderedAccess);
        commandList.setBufferState(state.shadow.m_swShadowEdgeListBuffer.get(), ResourceStates::UnorderedAccess);
        commandList.setTextureState(targets.shadowVisibility.get(), s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess);
        commandList.commitBarriers();

        // Build indirect dispatch arguments from the clamped list count.
        commandList.setBufferState(state.shadow.m_swShadowIndirectArgsBuffer.get(), ResourceStates::UnorderedAccess);
        commandList.commitBarriers();
        SwShadowHeapPushConstants argsPush = MakeSoftwareShadowFramePush(state, targets);
        PopulateSwShadowBuildArgsPush(cast<u32>(s_ShaderSwShadowTraceGroup), state.shadow.m_swShadowEdgeListCapacity, argsPush);
        commandList.setComputeState(MakeComputePassState(state.shadow.m_swShadowTransparentBuildArgsPipeline));
        heap.bindCompute(commandList, state.shadow.m_swShadowTransparentBuildArgsPipeline.deref());
        commandList.setPushConstants(argsPush);
        commandList.dispatch(1u, 1u, 1u);

        // Indirect dispatch consumes the generated arguments and list.
        commandList.setBufferState(state.shadow.m_swShadowEdgeCounterBuffer.get(), ResourceStates::UnorderedAccess);
        commandList.setBufferState(state.shadow.m_swShadowEdgeListBuffer.get(), ResourceStates::UnorderedAccess);
        commandList.commitBarriers();

        SwShadowHeapPushConstants tracePush = MakeSoftwareShadowFramePush(state, targets);
        PopulateSwShadowIndirectTracePush(targets.width, targets.height, cast<u32>(s_ShaderSwShadowTraceGroup), tracePush);
        commandList.setTextureState(targets.shadowVisibility.get(), s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess);
        commandList.setBufferState(state.shadow.m_swShadowIndirectArgsBuffer.get(), ResourceStates::IndirectArgument);
        commandList.commitBarriers();
        ComputeState computeStateIndirect = MakeComputePassState(state.shadow.m_swShadowTransparentIndirectPipeline);
        computeStateIndirect.setIndirectParams(state.shadow.m_swShadowIndirectArgsBuffer.get());
        commandList.setComputeState(computeStateIndirect);
        heap.bindCompute(commandList, state.shadow.m_swShadowTransparentIndirectPipeline.deref());
        commandList.setPushConstants(tracePush);
        commandList.dispatchIndirect(0u);
    }
    else{
        // Full-resolution adaptive fallback.
        commandList.setTextureState(targets.shadowCoarseTransmittance.get(), s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess);
        commandList.setTextureState(targets.shadowVisibility.get(), s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess);
        commandList.commitBarriers();
        SwShadowHeapPushConstants resolvePush = MakeSoftwareShadowFramePush(state, targets);
        PopulateSwShadowViewportPush(targets.width, targets.height, coarseWidth, coarseHeight, resolvePush);
        commandList.setComputeState(MakeComputePassState(state.shadow.m_swShadowTransparentResolvePipeline));
        heap.bindCompute(commandList, state.shadow.m_swShadowTransparentResolvePipeline.deref());
        commandList.setPushConstants(resolvePush);
        commandList.dispatch(fullGroupsX, fullGroupsY, 1u);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void RecordSoftwareTransparentShadowTrace(in SoftwareTransparentShadowTraceInputs inputs, in RendererRayTracingState state, mut CommandList commandList, mut DeferredFrameTargets targets, mut GpuDescriptorHeap heap){
    // The software route is retained for devices without hardware ray queries.
    if(!inputs.graphOwnsOpaqueToTransparentBoundary){
        commandList.setTextureState(targets.transparentSoftHalf.get(), s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess);
        commandList.setTextureState(targets.shadowVisibility.get(), s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess);
    }
    commandList.setEnableUavBarriersForTexture(targets.transparentSoftHalf.get(), true);
    if(!inputs.graphOwnsOpaqueToTransparentBoundary)
        commandList.commitBarriers();

    const b8 samplingHistoryUsable = CanUseSoftwareTransparentSamplingHistory(inputs, state.softShadow.m_softTransparentTemporalReady, state.shadow.m_softwareTransparentSampling.m_history.usable());
    if(samplingHistoryUsable && !inputs.graphOwnsOpaqueToTransparentBoundary){
        // These reads also belong to the split trace task; unsplit phases retain local transitions.
        commandList.setTextureState(targets.shadowSoftGeometry.get(), s_FramebufferSubresources, ResourceStates::ShaderResource);
        commandList.setTextureState(targets.shadowSoftGeometryPrev.get(), s_FramebufferSubresources, ResourceStates::ShaderResource);
        TexturePtr moments = targets.transparentMomentsB.get();
        if(inputs.historyFrontIsA)
            moments = targets.transparentMomentsA.get();
        commandList.setTextureState(moments, s_ShadowVisibilitySubresources, ResourceStates::ShaderResource);
        commandList.commitBarriers();
    }
    const SoftwareTransparentSamplingPush tracePush = MakeSoftwareTransparentSamplingPush(
        Span<f32>(state.softShadow.m_prevWorldToClip.raw),
        targets.width,
        targets.height,
        state.sceneBvh.m_sceneBvhInstanceCount,
        inputs.frameIndex,
        inputs.sampleCount,
        targets.bindless.slotsBufferDescriptor.slot(),
        state.sceneBvh.m_rayTraceMaterialContextSlotsHeapHandle.slot(),
        targets.bindless.transparentSoftHalfStorage.slot(),
        samplingHistoryUsable,
        targets.bindless.shadowSoftGeometry.slot(),
        targets.bindless.shadowSoftGeometryPrev.slot(),
        SelectSoftShadowHistorySlot(inputs.historyFrontIsA, targets.bindless.transparentMomentsA.slot(), targets.bindless.transparentMomentsB.slot()),
        targets.shadowReceiverFactor
    );
    in ComputePipelineHandle pipeline = state.shadow.m_softwareTransparentSampling.m_pipelines[SelectSoftwareTransparentSamplingPipelineIndex(samplingHistoryUsable)];
    commandList.setComputeState(MakeComputePassState(pipeline));
    heap.bindCompute(commandList, pipeline.deref());
    commandList.setPushConstants(tracePush);
    commandList.dispatch(inputs.groupsX, inputs.groupsY, 1u);
}


