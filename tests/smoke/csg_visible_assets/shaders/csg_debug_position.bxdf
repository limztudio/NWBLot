half3 NWB_DEFERRED_BXDF_FUNCTION(NwbBxdfSurface surface, int2 pixel){
    return half3(clamp(surface.worldPosition * float3(1.0 / 6.0, 1.0 / 6.0, 0.5) + 0.5, 0.0, 1.0));
}


