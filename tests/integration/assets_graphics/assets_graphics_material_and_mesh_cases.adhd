class MaterialPolicyRejectionCase{
    public StringView m_metaText;
    public StringView m_diagnostic;

    public MaterialPolicyRejectionCase(in StringView metaText, in StringView diagnostic){
        this.m_metaText = metaText;
        this.m_diagnostic = diagnostic;
    }
}

class MeshIndexDiagnosticCase{
    public StringView m_indices;
    public StringView m_diagnostic;

    public MeshIndexDiagnosticCase(in StringView indices, in StringView diagnostic){
        this.m_indices = indices;
        this.m_diagnostic = diagnostic;
    }
}

b8 CanParseMaterialMeta(in StringView metaText, mut TestArena testArena, mut ScratchArena scratchArena){
    b8 accepted = false;
    native(in metaText, mut testArena, mut scratchArena, mut accepted){
        accepted = ParseMaterialEntryFromMetaText(metaText, testArena, scratchArena).has_value();
    }
    return accepted;
}

b8 CookAndLoadSmokeMeshInto(in StringView assetFilename, in Name assetName, in CookCase cookCase, mut TestArena testArena, mut MeshAsset outMesh){
    b8 loaded = false;
    native(in assetFilename, in assetName, in cookCase, mut testArena, mut outMesh, mut loaded){
        auto loadedAssetResult = CookAndLoadSmokeMesh(assetFilename, assetName, cookCase, testArena);
        if(loadedAssetResult){
            outMesh = Move(static_cast<NWB::Impl::Mesh&>(**loadedAssetResult));
            loaded = true;
        }
    }
    return loaded;
}

void VerifyAssetsGraphics_ResourceParameterCandidateRejectsExpressionsButPreservesBytes(){
    EXPECT_FALSE(IsMaterialResourceParameterCandidate(""));
    EXPECT_FALSE(IsMaterialResourceParameterCandidate("project/value("));
    EXPECT_FALSE(IsMaterialResourceParameterCandidate("project/value)"));
    EXPECT_TRUE(IsMaterialResourceParameterCandidate("project/value"));
    b8 embeddedNulAccepted = false;
    native(mut embeddedNulAccepted){
        embeddedNulAccepted = NWB::Impl::IsMaterialResourceParameterCandidate(AStringView("project/\0value", 14u));
    }
    EXPECT_TRUE(embeddedNulAccepted);
}

void VerifyAssetsGraphics_MaterialCookAdmissionRejectsMissingInputsAndCountOverflow(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_ReportOnly);
    native(in logger){
        EXPECT_FALSE(Impl::ValidateMaterialBindIncludePath("", "source.bind"));
        EXPECT_TRUE(logger.sawErrorContaining(NWB_TEXT("virtual path is empty for 'source.bind'")));
        EXPECT_FALSE(Impl::ValidateDeferredBxdfSource("project/material", ""));
        EXPECT_TRUE(Impl::ValidateDeferredBxdfCount(static_cast<usize>(Limit<u32>::s_Max)));
        EXPECT_TRUE(Impl::ValidateMaterialSurfaceCount(static_cast<usize>(Limit<u32>::s_Max)));
        u32 expectedErrors = 4u;
        if constexpr(sizeof(usize) > sizeof(u32)){
            EXPECT_FALSE(Impl::ValidateDeferredBxdfCount(static_cast<usize>(Limit<u32>::s_Max) + 1u));
            EXPECT_FALSE(Impl::ValidateMaterialSurfaceCount(static_cast<usize>(Limit<u32>::s_Max) + 1u));
            expectedErrors += 2u;
        }
        EXPECT_TRUE(Impl::ValidateGeneratedMaterialMeshShader(0u, s_NameNone));
        EXPECT_FALSE(Impl::ValidateGeneratedMaterialMeshShader(1u, s_NameNone));
        EXPECT_FALSE(Impl::ValidateTransparentMaterialInterface("project/material", "", "occupancy"));
        EXPECT_FALSE(Impl::IsMaterialOpticalStageCombinationValid(true, false, true, false));
        EXPECT_FALSE(Impl::IsMaterialOpticalStageCombinationValid(true, false, false, true));
        EXPECT_TRUE(Impl::IsMaterialOpticalStageCombinationValid(true, false, false, false));
        EXPECT_TRUE(Impl::IsMaterialOpticalStageCombinationValid(false, false, true, true));
        EXPECT_EQ(logger.errorCount(), expectedErrors);
    }
}

void VerifyAssetsGraphics_MaterialKeyHashPreservesHighBytesAndPathSeparators(){
    const StringView backslashKey = "Ab\\C/\xC3\xA9";
    const StringView slashKey = "Ab/C/\xC3\xA9";
    EXPECT_EQ(ComputeFnv64AsciiLowerText(backslashKey), 0xff4be59fee952354ull);
    EXPECT_EQ(ComputeFnv64AsciiLowerText(slashKey), 0x6c9a1f221edbde7dull);
    u32x4 packed = u32x4(0u, 0u, 0u, 0u);
    u32 expectedValueType = 0u;
    native(in backslashKey, mut packed, mut expectedValueType){
        NWB::Impl::MaterialParameterType type{};
        type.valueType = NWB::Impl::MaterialParameterValueType::f32;
        type.componentCount = 3u;
        packed = NWB::Impl::PackMaterialTypedValueMeta(backslashKey, type);
        expectedValueType = static_cast<u32>(type.valueType);
    }
    EXPECT_EQ(packed.x, 0xee952354u);
    EXPECT_EQ(packed.y, 0xff4be59fu);
    EXPECT_EQ(packed.z, expectedValueType);
    EXPECT_EQ(packed.w, 3u);
}

void VerifyAssetsGraphics_DuplicateMaterialBindIdentityIsRejectedBeforeMaterialMutation(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_ReportOnly);
    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_MaterialScratchArena);
    native(in logger, mut testArena, mut scratchArena){
        NWB::Impl::ShaderCook::CookVector<NWB::Impl::MaterialBindEntry> bindEntries(testArena.arena);
        for(usize index = 0u; index < 2u; ++index){
            auto& bind = bindEntries.emplace_back(testArena.arena);
            bind.virtualPath = s_ProjectMaterialInterfacesTestSurface;
        }
        NWB::Impl::ShaderCook::CookVector<NWB::Impl::MaterialCookEntry> materialEntries(testArena.arena);
        auto& material = materialEntries.emplace_back(testArena.arena);
        material.materialInterface = s_ProjectMaterialInterfacesTestSurface;
        material.typedLayoutHash = 0xF091u;
        material.typedBlockBytes.push_back(0x2Au);

        EXPECT_FALSE(NWB::Impl::ValidateMaterialCookInterfaces(bindEntries, materialEntries, scratchArena));
        EXPECT_TRUE(logger.sawErrorContaining(NWB_TEXT("Material bind interface 'project/material_interfaces/test_surface' is duplicated")));
        EXPECT_EQ(material.typedLayoutHash, 0xF091u);
        ASSERT_EQ(material.typedBlockBytes.size(), 1u);
        EXPECT_EQ(material.typedBlockBytes[0u], 0x2Au);
    }
}

void VerifyAssetsGraphics_MaterialBindSchemaValidation(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_MaterialScratchArena);
    native(in logger, mut testArena, mut scratchArena){
        auto expectParseFailure = [&](const AStringView bindText, const AStringView caseName, const TStringView expectedError){
            SCOPED_TRACE(caseName.data());

            auto invalidRootResult = PrepareAssetsGraphicsCaseRoot(testArena, caseName);
            ASSERT_TRUE(invalidRootResult);
            Path invalidRoot = Move(*invalidRootResult);
            {
                CapturingLogger failureLogger;
                NWB::Core::Common::LoggerRegistrationGuard failureLoggerRegistrationGuard(failureLogger, NWB::Core::Common::LoggerBreakPolicy::ReportOnly);

                EXPECT_FALSE(MaterialBindFixture::ParseMaterialBindFromText(bindText, invalidRoot, testArena, scratchArena));
                EXPECT_TRUE(failureLogger.sawErrorContaining(expectedError));
            }

            EXPECT_TRUE(RemoveAllIfExists(invalidRoot));
        };

        expectParseFailure(s_UnknownBlockClassMaterialBindSource, "material_bind_unknown_block_class", NWB_TEXT("unsupported attribute 'material_project'"));
        expectParseFailure(s_UnsupportedFieldTypeMaterialBindSource, "material_bind_unsupported_field_type", NWB_TEXT("unsupported type 'double'"));
        expectParseFailure(s_InvalidDefaultMaterialBindSource, "material_bind_invalid_default", NWB_TEXT("attribute 'default' requires one non-empty string argument"));
        expectParseFailure(s_MissingDefaultMaterialBindSource, "material_bind_missing_default", NWB_TEXT("must declare a default attribute"));
        expectParseFailure(s_ResourceAttributeMaterialBindSource, "material_bind_resource_attribute", NWB_TEXT("has unsupported attribute 'texture_asset'"));
        for(const AStringView resourceType : { AStringView("texture2d"), AStringView("sampler") }){
            const auto retiredFixtureBind = StringFormat(testArena.arena, "[material_constant] struct NwbResourceMaterial{{ [fixture(\"builtin/material_fixture/checker_rgba8\")] {} resource; }}; NwbResourceMaterial surface;", resourceType);
            expectParseFailure(retiredFixtureBind, resourceType, NWB_TEXT("has unsupported attribute 'fixture'"));
        }
        expectParseFailure(s_DuplicateInstanceMaterialBindSource, "material_bind_duplicate_instance", NWB_TEXT("duplicate variable declaration"));
        expectParseFailure(s_InitializedInstanceMaterialBindSource, "material_bind_initialized_instance", NWB_TEXT("instance 'surface' must not have an initializer or assignments"));
        constexpr AStringView s_ValidStruct = "[material_constant] struct Surface { [default(\"float(0.5)\")] float roughness; };\n";
        expectParseFailure(s_ValidStruct, "material_bind_missing_instance", NWB_TEXT("instance declarations must not be empty"));
        const auto unknownInstance = StringFormat(testArena.arena, "{}Unknown surface;", s_ValidStruct);
        expectParseFailure(unknownInstance, "material_bind_unknown_instance_type", NWB_TEXT("instance 'surface' references unknown struct type 'Unknown'"));
        const auto assignedInstance = StringFormat(testArena.arena, "{}Surface surface; surface.roughness = 0.5;", s_ValidStruct);
        expectParseFailure(assignedInstance, "material_bind_assigned_instance", NWB_TEXT("instance 'surface' must not have an initializer or assignments"));

        auto float1DefaultRootResult = PrepareAssetsGraphicsCaseRoot(testArena, "material_bind_float1_default");
        ASSERT_TRUE(float1DefaultRootResult);
        Path float1DefaultRoot = Move(*float1DefaultRootResult);
        auto float1DefaultEntryResult = MaterialBindFixture::ParseMaterialBindFromText(s_Float1DefaultMaterialBindSource, float1DefaultRoot, testArena, scratchArena);
        ASSERT_TRUE(float1DefaultEntryResult);
        NWB::Impl::MaterialBindEntry& float1DefaultEntry = *float1DefaultEntryResult;
        float1DefaultEntry.virtualPath = s_ProjectMaterialInterfacesTestSurface;
        {
            SCOPED_TRACE("material_bind_float1_default_include");

            CapturingLogger failureLogger;
            NWB::Core::Common::LoggerRegistrationGuard failureLoggerRegistrationGuard(failureLogger, NWB::Core::Common::LoggerBreakPolicy::ReportOnly);

            EXPECT_FALSE(NWB::Impl::BuildMaterialBindIncludeSource(float1DefaultEntry, testArena.arena, scratchArena));
            EXPECT_TRUE(failureLogger.sawErrorContaining(NWB_TEXT("default 'float1(1.0)'")));
        }

        const Name cacheInterface(s_ProjectMaterialInterfacesTestSurface);
        NWB::Impl::MaterialBindTypedLayoutCache layoutCache(testArena.arena);
        {
            SCOPED_TRACE("material_bind_float1_default_cache");

            CapturingLogger failureLogger;
            NWB::Core::Common::LoggerRegistrationGuard failureLoggerRegistrationGuard(failureLogger, NWB::Core::Common::LoggerBreakPolicy::ReportOnly);

            EXPECT_FALSE(NWB::Impl::FindOrBuildMaterialBindTypedLayout(cacheInterface, float1DefaultEntry, scratchArena, layoutCache));
            EXPECT_TRUE(failureLogger.sawErrorContaining(NWB_TEXT("default 'float1(1.0)'")));
        }
        EXPECT_TRUE(layoutCache.entries.empty());
        EXPECT_TRUE(layoutCache.lookup.empty());

        auto validCacheRootResult = PrepareAssetsGraphicsCaseRoot(testArena, "material_bind_cache_valid_after_failed_layout");
        ASSERT_TRUE(validCacheRootResult);
        Path validCacheRoot = Move(*validCacheRootResult);
        auto validCacheEntryResult = MaterialBindFixture::ParseMaterialBindFromText(s_MinimalMaterialBindSource, validCacheRoot, testArena, scratchArena);
        ASSERT_TRUE(validCacheEntryResult);
        NWB::Impl::MaterialBindEntry& validCacheEntry = *validCacheEntryResult;
        validCacheEntry.virtualPath = s_ProjectMaterialInterfacesTestSurface;
        const auto cachedLayout = NWB::Impl::FindOrBuildMaterialBindTypedLayout(cacheInterface, validCacheEntry, scratchArena, layoutCache);
        ASSERT_TRUE(cachedLayout);
        EXPECT_EQ(layoutCache.entries.size(), 1u);
        EXPECT_EQ(layoutCache.lookup.size(), 1u);
        EXPECT_EQ(logger.errorCount(), 0u);

        EXPECT_TRUE(RemoveAllIfExists(float1DefaultRoot));
        EXPECT_TRUE(RemoveAllIfExists(validCacheRoot));
    }
}

void VerifyAssetsGraphics_MaterialBindEngineAndProjectResourceValidation(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_BreakOnFatal);
    native(in logger){
        EXPECT_FALSE(NWB::Impl::IsSupportedMaterialResourceReference(NWB::Impl::MaterialResourceKind::SampledImage2D, "builtin/textures/checker"));
        EXPECT_FALSE(NWB::Impl::IsSupportedMaterialResourceReference(NWB::Impl::MaterialResourceKind::Sampler, "project/samplers/../linear_clamp"));
        EXPECT_FALSE(NWB::Impl::IsSupportedMaterialResourceReference(NWB::Impl::MaterialResourceKind::Sampler, "engine/samplers/../linear_clamp"));
        EXPECT_TRUE(NWB::Impl::IsSupportedMaterialResourceReference(NWB::Impl::MaterialResourceKind::Sampler, "project/samplers/linear_clamp"));
        EXPECT_TRUE(NWB::Impl::IsSupportedMaterialResourceReference(NWB::Impl::MaterialResourceKind::Sampler, s_EngineSamplersLinearClampPath));

        EXPECT_EQ(logger.errorCount(), 0u);
    }
}

void VerifyAssetsGraphics_MaterialBindCookRejectsMalformedParametersAndInterfaceMismatch(){
    if(AssetsGraphicsTestConfigurationName() != "fin")
        return;

    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_ReportOnly);
    TestArena testArena = TestArena();

    Vector<StringView> integrationCaseNames = Vector<StringView>();
    integrationCaseNames.reserve(6u);
    integrationCaseNames.push_back("material_bind_unknown_interface_parameter");
    integrationCaseNames.push_back("material_bind_flat_interface_parameter");
    integrationCaseNames.push_back("material_bind_untyped_material_parameter");
    integrationCaseNames.push_back("material_bind_vector_alias_material_parameter");
    integrationCaseNames.push_back("material_bind_unsupported_material_field");
    integrationCaseNames.push_back("material_bind_incomplete_block_scoped");

    Vector<StringView> integrationDiagnostics = Vector<StringView>();
    integrationDiagnostics.reserve(6u);
    integrationDiagnostics.push_back("parameter 'surface.missing' is not declared by interface");
    integrationDiagnostics.push_back("interface parameter 'runtime.fade_alpha' must be declared inside a block map");
    integrationDiagnostics.push_back("has invalid value '0.25, 0.5, 0.75, 1.0'");
    integrationDiagnostics.push_back("has invalid value 'vec4(0.25, 0.5, 0.75, 1.0)'");
    integrationDiagnostics.push_back("unsupported asset field 'compiler'");
    integrationDiagnostics.push_back("typed parameter 'runtime.fade_alpha' is not declared by interface");

    for(usize caseIndex = 0u; caseIndex < integrationCaseNames.size(); ++caseIndex){
        const Expected<CookCase> cookCase = PrepareAssetsGraphicsCookCase(testArena, integrationCaseNames[caseIndex]);
        ASSERT_TRUE(cookCase.has_value());
        const CookCase prepared = cookCase.value();
        b8 cooked = true;
        native(in caseIndex, in prepared, mut testArena, mut cooked){
#if defined(NWB_FINAL)
            AStringView bindSource = s_MinimalMaterialBindSource;
            AStringView materialMeta = s_UnknownInterfaceParameterMaterialMeta;
            switch(caseIndex){
            case 0u: materialMeta = s_UnknownInterfaceParameterMaterialMeta; break;
            case 1u: materialMeta = s_FlatInterfaceParameterMaterialMeta; break;
            case 2u: materialMeta = s_UntypedMaterialParameterMeta; break;
            case 3u: materialMeta = s_VectorAliasMaterialParameterMeta; break;
            case 4u: materialMeta = s_UnsupportedMaterialFieldMeta; break;
            case 5u:
                bindSource = s_SurfaceOnlyMaterialBindSource;
                materialMeta = s_BlockScopedMaterialMeta;
                break;
            default: break;
            }
            cooked = MaterialBindFixture::CookMaterialBindMaterialIntegration(bindSource, materialMeta, prepared, testArena);
#endif
        }
        EXPECT_FALSE(cooked);
        EXPECT_TRUE(SawCapturedError(logger, integrationDiagnostics[caseIndex]));
        EXPECT_TRUE(RemoveAllIfExists(prepared.root));
    }

    const Expected<CookCase> interfaceShaderMismatchCookCase = PrepareAssetsGraphicsCookCase(testArena, "material_bind_interface_without_bind_shader");
    ASSERT_TRUE(interfaceShaderMismatchCookCase.has_value());
    const CookCase shaderMismatchCase = interfaceShaderMismatchCookCase.value();
    b8 wroteUnboundAssets = false;
    b8 cookedUnbound = true;
    native(in shaderMismatchCase, mut testArena, mut wroteUnboundAssets, mut cookedUnbound){
#if defined(NWB_FINAL)
        const Path assetRoot = shaderMismatchCase.root / s_AssetsDirectory;
        wroteUnboundAssets = MaterialBindFixture::WriteMaterialBindMaterialIntegrationAssetsWithPixelSource(
            testArena,
            assetRoot,
            s_MinimalMaterialBindSource,
            s_BlockScopedMaterialMeta,
            s_UnboundMaterialShaderProbeSource
        );
        cookedUnbound = CookPreparedGraphicsAssetRoots(testArena, shaderMismatchCase.root, shaderMismatchCase.outputDirectory, { assetRoot });
#endif
    }
    EXPECT_TRUE(wroteUnboundAssets);
    EXPECT_FALSE(cookedUnbound);
    EXPECT_TRUE(SawCapturedError(logger, "does not include a generated material bind"));
    EXPECT_TRUE(RemoveAllIfExists(shaderMismatchCase.root));

    const Expected<CookCase> interfaceIdentityMismatchCookCase = PrepareAssetsGraphicsCookCase(testArena, "material_bind_interface_identity_mismatch");
    ASSERT_TRUE(interfaceIdentityMismatchCookCase.has_value());
    const CookCase identityMismatchCase = interfaceIdentityMismatchCookCase.value();
    b8 wroteIdentityAssets = false;
    b8 wroteOtherBind = false;
    b8 cookedIdentity = true;
    native(in identityMismatchCase, mut testArena, mut wroteIdentityAssets, mut wroteOtherBind, mut cookedIdentity){
#if defined(NWB_FINAL)
        const Path assetRoot = identityMismatchCase.root / s_AssetsDirectory;
        wroteIdentityAssets = MaterialBindFixture::WriteMaterialBindMaterialIntegrationAssetsWithPixelSource(
            testArena,
            assetRoot,
            s_MinimalMaterialBindSource,
            s_BlockScopedMaterialMeta,
            s_OtherMaterialBindShaderProbeSource
        );
        wroteOtherBind = WriteTextFile(assetRoot / s_MaterialInterfacesDirectory / "other_surface.bind", s_MinimalMaterialBindSource);
        cookedIdentity = CookPreparedGraphicsAssetRoots(testArena, identityMismatchCase.root, identityMismatchCase.outputDirectory, { assetRoot });
#endif
    }
    EXPECT_TRUE(wroteIdentityAssets);
    EXPECT_TRUE(wroteOtherBind);
    EXPECT_FALSE(cookedIdentity);
    EXPECT_TRUE(SawCapturedError(logger, "includes generated material bind interface 'project/material_interfaces/other_surface'"));
    EXPECT_TRUE(RemoveAllIfExists(identityMismatchCase.root));
}

void VerifyAssetsGraphics_ShadowSurfaceDispatchIsolatesOverlappingBindApis(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    native(in logger, mut testArena){
        auto cookCase = PrepareAssetsGraphicsCookCase(testArena, "shadow_transmittance_dispatch_overlapping_bind_apis");
        ASSERT_TRUE(cookCase);
        Path& root = cookCase->root;
        Path& outputDirectory = cookCase->outputDirectory;

        const Path assetRoot = root / s_AssetsDirectory;
        const b8 assetsWritten =
            WriteTextFile(assetRoot / s_MaterialInterfacesDirectory / "shadow_dispatch_first.bind", s_ShadowDispatchFirstMaterialBindSource)
            && WriteTextFile(assetRoot / s_MaterialInterfacesDirectory / "shadow_dispatch_second.bind", s_ShadowDispatchSecondMaterialBindSource)
            && WriteTextFile(assetRoot / s_ShadersDirectory / "shadow_dispatch_shared_surface_helper.slangi", s_ShadowDispatchSharedSurfaceHelperSource)
            && WriteTextFile(assetRoot / s_ShadersDirectory / "shadow_dispatch_first.surface", s_ShadowDispatchFirstMaterialSurfaceSource)
            && WriteTextFile(assetRoot / s_ShadersDirectory / "shadow_dispatch_second.surface", s_ShadowDispatchSecondMaterialSurfaceSource)
            && WriteTextFile(assetRoot / s_ShadersDirectory / "shadow_dispatch.bxdf", s_MaterialBindBxdfSource)
            && WriteTextFile(assetRoot / s_MaterialsDirectory / "shadow_dispatch_first.nwb", s_ShadowDispatchFirstMaterialMeta)
            && WriteTextFile(assetRoot / s_MaterialsDirectory / "shadow_dispatch_second.nwb", s_ShadowDispatchSecondMaterialMeta)
        ;
        ASSERT_TRUE(assetsWritten);

        const Path engineAssetRoot = AssetsGraphicsTestRepoRoot(testArena) / "impl" / s_AssetsDirectory;
        const b8 cooked = CookPreparedGraphicsAssetRoots(testArena, root, outputDirectory, { engineAssetRoot, assetRoot });
        EXPECT_TRUE(cooked);
        EXPECT_EQ(logger.errorCount(), 0u);

        EXPECT_TRUE(RemoveAllIfExists(root));
    }
}

