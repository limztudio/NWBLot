#include <impl/ecs_mesh/runtime/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> ExistingRuntimeMeshDisposition{
    CreateNew = 0,
    ReuseClean = 1,
    ReuploadDirty = 2,
    ReplaceStaleSource = 3,
    kCount
}

ExistingRuntimeMeshDisposition ClassifyExistingRuntimeMesh(
    in b8 hasExistingInstance,
    in Name existingSourceName,
    in Name requestedSourceName,
    in RuntimeMeshDirtyFlag dirtyFlags
){
    if(!hasExistingInstance)
        return ExistingRuntimeMeshDisposition::CreateNew;
    if(existingSourceName != requestedSourceName)
        return ExistingRuntimeMeshDisposition::ReplaceStaleSource;
    if((dirtyFlags & RuntimeMeshDirtyFlag::GpuUploadDirty) != RuntimeMeshDirtyFlag::None)
        return ExistingRuntimeMeshDisposition::ReuploadDirty;
    return ExistingRuntimeMeshDisposition::ReuseClean;
}

b8 ReleaseSkinningSourceReference(mut u32 inOutReferenceCount){
    if(inOutReferenceCount > 0u)
        --inOutReferenceCount;
    return inOutReferenceCount == 0u;
}

u64 ComputeMeshletLocalBoundsByteSize(in usize meshletCount, in u64 boundsRecordByteSize){
    return cast<u64>(meshletCount) * boundsRecordByteSize;
}


