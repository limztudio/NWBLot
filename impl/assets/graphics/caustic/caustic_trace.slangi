////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_CAUSTIC_TRACE_SLANGI
#define NWB_GRAPHICS_CAUSTIC_TRACE_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "../common/math.slangi"
#include "../mesh/surface.slangi"
#include "photon_push_constants.h"
#include "refract.slangi"
#include "splat_constants.slangi"

#ifndef NWB_RT_CSG_ENABLED
#define NWB_RT_CSG_ENABLED 0
#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Shared transport keeps HW and SW photon physics and deposition arithmetic identical; only closest-hit differs.


// Several ordinary refractors or CSG retained spans require more than four interfaces before deposition.
#define NWB_CAUSTIC_MAX_BOUNCES 16u

#define NWB_CAUSTIC_FLUX_EPSILON 1e-6
#define NWB_CAUSTIC_MIN_IOR 1e-4
#define NWB_CAUSTIC_REFRACTED_MIN_LENGTH_SQUARED 1e-12
#define NWB_CAUSTIC_MIN_EMISSION_AREA 1e-6
#define NWB_CAUSTIC_LIGHT_COLOR_MAX 1.5
#define NWB_CAUSTIC_LIGHT_INTENSITY_MAX 2.0

// lowbias32 integer hash.
#define NWB_CAUSTIC_HASH_OUTER_SHIFT 16
#define NWB_CAUSTIC_HASH_MIDDLE_SHIFT 15
#define NWB_CAUSTIC_HASH_FIRST_MULTIPLIER 0x7feb352du
#define NWB_CAUSTIC_HASH_SECOND_MULTIPLIER 0x846ca68bu

// Emission jitter keeps the top 24 hash bits and maps them to [0, 1).
#define NWB_CAUSTIC_JITTER_GOLDEN_RATIO 0x9E3779B9u
#define NWB_CAUSTIC_JITTER_SEED_OFFSET 0x85EBCA6Bu
#define NWB_CAUSTIC_JITTER_SECOND_SEED_SALT 0x68E31DA4u
#define NWB_CAUSTIC_JITTER_DROPPED_BITS 8
#define NWB_CAUSTIC_JITTER_UNIT_SCALE (1.0 / 16777216.0)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// hit == false denotes a miss; with normalized rays, t is world distance.
// Refractive hits provide world-space shading normal, IOR, and transmission.
// instance is the material-record index shared by HW and SW; it names the medium that a refractive hit bounds.
struct NwbCausticHit{
    bool hit;
#if NWB_RT_CSG_ENABLED
    uint failure;
#endif
    bool isRefractive;
    uint instance;
    float t;
    float ior;
    float3 worldPos;
    float3 shadingNormal;
    half3 transmission;
};

NwbCausticHit nwbCausticTraceClosest(float3 origin, float3 direction, float tMin, float tMax);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct NwbCausticPhoton{
    float3 origin;
    float3 direction;
    half3 flux;
};

struct NwbCausticSplat{
    bool valid;
    float3 worldPos;
    half3 flux;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Normalize and orient the normal against the incident ray.
float3 nwbCausticOrientNormal(float3 incident, float3 surfaceNormal, out float outCosI){
    const float3 n = nwbSafeNormalize(surfaceNormal, float3(0.0, 0.0, 1.0));
    const float ndotd = dot(incident, n);
    outCosI = saturate(abs(ndotd));
    return (ndotd <= 0.0) ? n : -n;
}

NwbCausticSplat nwbCausticTracePhoton(NwbCausticPhoton photon){
    NwbCausticSplat splat;
    splat.valid = false;
    splat.worldPos = float3(0.0, 0.0, 0.0);
    splat.flux = half3(0.0h, 0.0h, 0.0h);

    float3 origin = photon.origin;
    float3 direction = photon.direction;
    half3 flux = photon.flux;
    // Photons start in air and are inside at most one refractor. Its entry hit gives the medium IOR and absorption until the photon leaves through the same instance.
    bool inside = false;
    uint mediumInstance = 0u;
    float mediumIor = 1.0;
    half3 mediumAbsorption = half3(0.0h, 0.0h, 0.0h);
    // Ignore direct photons that never crossed a refractor.
    uint refractiveCrossings = 0u;

    const float tMin = 1e-3; // Avoid self-intersection.
    const float tMax = 1e7;

    for(uint bounce = 0u; bounce < NWB_CAUSTIC_MAX_BOUNCES; ++bounce){
        if(max(max(flux.x, flux.y), flux.z) < NWB_CAUSTIC_FLUX_EPSILON)
            return splat;

        const NwbCausticHit hit = nwbCausticTraceClosest(origin, direction, tMin, tMax);
#if NWB_RT_CSG_ENABLED
        if(hit.failure != 0u)
            return splat;
#endif
        if(!hit.hit)
            return splat;

        if(!hit.isRefractive){
            if(refractiveCrossings == 0u)
                return splat;
            // An unresolved exit has no valid attenuation path.
            if(inside)
                return splat;
            splat.valid = true;
            splat.worldPos = hit.worldPos;
            splat.flux = flux;
            return splat;
        }

        // Another refractor before the exit means nested or overlapping media. Drop the photon rather than charge one medium's optics to another.
        if(inside && hit.instance != mediumInstance)
            return splat;

        // Refraction uses smooth shading normals.
        float cosI;
        const float3 normal = nwbCausticOrientNormal(direction, hit.shadingNormal, cosI);

        // Entry bends air-to-medium with the hit IOR; exit bends medium-to-air with the IOR of the medium being left.
        const float ior = inside ? mediumIor : hit.ior;
        const float eta = inside ? ior : (1.0 / max(ior, NWB_CAUSTIC_MIN_IOR));

        const float3 refracted = nwbCausticRefract(direction, normal, eta);
        if(dot(refracted, refracted) < NWB_CAUSTIC_REFRACTED_MIN_LENGTH_SQUARED)
            return splat;

        ++refractiveCrossings;

        // Schlick requires the air-side cosine on both entry and exit. The Fresnel cosine is a (0, 1) bounded factor input, so half arithmetic is sufficient here.
        const half fresnelCosI = inside ? half(abs(dot(nwbSafeNormalize(refracted, direction), normal))) : half(cosI);
        flux *= nwbShadowFresnelTransmittedFraction(ior, fresnelCosI);

        if(inside){
            // Beer-Lambert over the entry-to-exit segment. The exponent stays FP32 because t can exceed the half range; only the bounded (0, 1] transmittance narrows to half.
            flux *= half3(exp(-float3(mediumAbsorption) * hit.t));
        }
        else{
            mediumInstance = hit.instance;
            mediumIor = hit.ior;
            mediumAbsorption = nwbShadowAbsorptionCoefficient(hit.transmission);
        }

        origin = hit.worldPos;
        direction = nwbSafeNormalize(refracted, direction);
        inside = !inside;
    }

    return splat;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct NwbCausticEmission{
    bool valid;
    float3 origin;
    float3 direction;
    float domainArea;
};

void nwbCausticEmissionBasis(float3 axis, out float3 right, out float3 up){
    const float3 reference = abs(axis.z) < NWB_FRAME_FALLBACK_AXIS_Z_MAX ? float3(0.0, 0.0, 1.0) : float3(0.0, 1.0, 0.0);
    right = nwbSafeNormalize(cross(reference, axis), float3(1.0, 0.0, 0.0));
    up = nwbSafeNormalize(cross(axis, right), float3(0.0, 1.0, 0.0));
}

float2 nwbCausticProjectAabbExtent(float3 aabbMin, float3 aabbMax, float3 right, float3 up){
    const float3 halfExtent = (aabbMax - aabbMin) * 0.5;
    return float2(abs(right.x) * halfExtent.x + abs(right.y) * halfExtent.y + abs(right.z) * halfExtent.z, abs(up.x) * halfExtent.x + abs(up.y) * halfExtent.y + abs(up.z) * halfExtent.z);
}

uint nwbCausticHashU32(uint x){
    x ^= x >> NWB_CAUSTIC_HASH_OUTER_SHIFT;
    x *= NWB_CAUSTIC_HASH_FIRST_MULTIPLIER;
    x ^= x >> NWB_CAUSTIC_HASH_MIDDLE_SHIFT;
    x *= NWB_CAUSTIC_HASH_SECOND_MULTIPLIER;
    x ^= x >> NWB_CAUSTIC_HASH_OUTER_SHIFT;
    return x;
}

// Deterministic stratified emission jitter shared by both backends.
float2 nwbCausticEmissionJitter(uint photonIndex){
    const uint h0 = nwbCausticHashU32(photonIndex * NWB_CAUSTIC_JITTER_GOLDEN_RATIO + NWB_CAUSTIC_JITTER_SEED_OFFSET);
    const uint h1 = nwbCausticHashU32(h0 ^ NWB_CAUSTIC_JITTER_SECOND_SEED_SALT);
    return float2((float)(h0 >> NWB_CAUSTIC_JITTER_DROPPED_BITS) * NWB_CAUSTIC_JITTER_UNIT_SCALE, (float)(h1 >> NWB_CAUSTIC_JITTER_DROPPED_BITS) * NWB_CAUSTIC_JITTER_UNIT_SCALE);
}

// Frame-parity checkerboards cover the full grid in two frames and retain jitter keyed to the physical full-grid cell.
// Phase count1 is the non-temporal full-grid path.
float2 nwbCausticJitteredTemporalCell(const uint photonIndex, const uint gridSide, const uint frameIndex, const uint temporalPhaseCount){
    const uint fullGridSide = max(gridSide, 1u);
    const uint phaseCount = temporalPhaseCount == NWB_CAUSTIC_TEMPORAL_PHASE_COUNT ? NWB_CAUSTIC_TEMPORAL_PHASE_COUNT : NWB_CAUSTIC_TEMPORAL_DISABLED_PHASE_COUNT;
    const uint phase = frameIndex % phaseCount;
    uint row = 0u;
    uint column = 0u;

    if(phaseCount == NWB_CAUSTIC_TEMPORAL_PHASE_COUNT){
        const uint halfWidth = max(fullGridSide >> 1u, 1u);
        row = photonIndex / halfWidth;
        const uint pair = photonIndex % halfWidth;
        const uint parityColBase = ((row & 1u) != 0u) ? (phase ^ 1u) : phase;
        column = parityColBase + NWB_CAUSTIC_TEMPORAL_PHASE_COUNT * pair;
    }
    else{
        row = photonIndex / fullGridSide;
        column = photonIndex % fullGridSide;
    }
    const float2 jitter = nwbCausticEmissionJitter(column + row * fullGridSide);
    return (float2(column, row) + jitter) / (float)fullGridSide;
}

// Aim each photon at one refractive target's projected AABB.
NwbCausticEmission nwbCausticEmitPhotonAtTarget(float3 lightDir, float3 aabbMin, float3 aabbMax, float2 cell){
    NwbCausticEmission emission;
    emission.valid = false;
    emission.origin = float3(0.0, 0.0, 0.0);
    emission.direction = lightDir;
    emission.domainArea = 0.0;

    const float3 axis = nwbSafeNormalize(lightDir, float3(0.0, 0.0, -1.0));
    float3 right;
    float3 up;
    nwbCausticEmissionBasis(axis, right, up);

    const float3 center = (aabbMin + aabbMax) * 0.5;
    const float2 extent = nwbCausticProjectAabbExtent(aabbMin, aabbMax, right, up);
    emission.domainArea = max(4.0 * extent.x * extent.y, NWB_CAUSTIC_MIN_EMISSION_AREA);

    const float2 offset = (cell * 2.0 - 1.0) * extent;
    const float3 target = center + right * offset.x + up * offset.y;

    const float backoff = length(aabbMax - aabbMin) + 1.0;
    emission.origin = target - axis * backoff;
    emission.direction = axis;
    emission.valid = true;
    return emission;
}

half3 nwbCausticLightColor(const float4 colorIntensity){
    return half3(clamp(colorIntensity.xyz, float3(0.0), float3(NWB_CAUSTIC_LIGHT_COLOR_MAX))) * half(min(max(colorIntensity.w, 0.0), NWB_CAUSTIC_LIGHT_INTENSITY_MAX));
}

NwbCausticPhoton nwbCausticCreatePhoton(const NwbCausticEmission emission, const half3 lightColor, const uint emissionTargetCount, const uint photonCount){
    // Photon budgets exceed the finite half range; normalize energy in float before quantizing the final flux.
    const float perPhoton = emission.domainArea * float(emissionTargetCount) / float(max(photonCount, 1u));

    NwbCausticPhoton photon;
    photon.origin = emission.origin;
    photon.direction = emission.direction;
    photon.flux = half3(float3(lightColor) * perPhoton);
    return photon;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

