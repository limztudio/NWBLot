void VerifyFilesystemVolumeTest_ReplacesRemovesAndReadsEmptyFiles(mut FilesystemVolumeTest self){
    CreatedFilesystem filesystem(self.m_arena, self.m_desc);
    ASSERT_TRUE(filesystem.valid());

    Array<u8, 3> payload = Array<u8, 3>();
    payload[0u] = 4u;
    payload[1u] = 5u;
    payload[2u] = 6u;
    ASSERT_TRUE(filesystem.get().writeFile(s_FilesystemNameProjectTestsPayload, payload));

    b8 wroteEmpty = false;
    native(mut filesystem, mut wroteEmpty){
        wroteEmpty = filesystem.get().writeFile(s_FilesystemNameProjectTestsPayload, nullptr, 0u);
    }
    ASSERT_TRUE(wroteEmpty);

    Vector<u8> loaded;
    ASSERT_TRUE(filesystem.get().readFile(s_FilesystemNameProjectTestsPayload, loaded));
    EXPECT_TRUE(loaded.empty());
    EXPECT_EQ(filesystem.get().fileCount(), 1u);

    b8 wroteNullNonzero = true;
    b8 readPastEmpty = true;
    native(mut filesystem, mut wroteNullNonzero, mut readPastEmpty){
        wroteNullNonzero = filesystem.get().writeFile(s_FilesystemNameProjectTestsPayload, nullptr, 1u);
        readPastEmpty = filesystem.get().readFile(s_FilesystemNameProjectTestsPayload, 1u, nullptr, 0u).has_value();
    }
    EXPECT_FALSE(wroteNullNonzero);
    EXPECT_FALSE(filesystem.get().writeFile(s_NameNone, payload));
    EXPECT_FALSE(readPastEmpty);

    ASSERT_TRUE(filesystem.get().removeFile(s_FilesystemNameProjectTestsPayload));
    EXPECT_EQ(filesystem.get().fileCount(), 0u);
    EXPECT_FALSE(filesystem.get().readFile(s_FilesystemNameProjectTestsPayload, loaded));
    EXPECT_TRUE(loaded.empty());
    ASSERT_TRUE(filesystem.get().unmount());
}

StagedDirectoryPaths BuildStagedVolumePathsForTest(in Path outputDirectory, in StringView volumeName, mut ScratchArena scratchArena){
    return FilesystemVolumeStagingDetail::BuildStagedVolumePaths(outputDirectory, volumeName, scratchArena);
}

void VerifyFilesystemVolumeTest_CompactionPreservesExistingRecoveryDirectories(mut FilesystemVolumeTest self){
    VolumeFileSystem filesystem(self.m_arena);
    ASSERT_TRUE(filesystem.mount(self.m_desc));
    ScratchArena scratchArena(s_FilesystemNameTestsFilesystem);

    Array<u8, 4> payload = Array<u8, 4>();
    payload[0u] = 1u;
    payload[1u] = 2u;
    payload[2u] = 3u;
    payload[3u] = 4u;
    ASSERT_TRUE(filesystem.writeFile(s_FilesystemNameProjectTestsRecoveryGap, payload));
    ASSERT_TRUE(filesystem.writeFile(s_FilesystemNameProjectTestsPayload, payload));
    ASSERT_TRUE(filesystem.removeFile(s_FilesystemNameProjectTestsRecoveryGap));

    const StagedDirectoryPaths paths = BuildStagedVolumePathsForTest(self.m_directory, self.m_desc.volumeName.view(), scratchArena);
    const Path backupDirectory = paths.backupDirectory;
    const Path stageDirectory = paths.stageDirectory;
    ASSERT_TRUE(EnsureDirectories(backupDirectory).has_value());
    ASSERT_TRUE(EnsureDirectories(stageDirectory).has_value());

    const Path backupEvidence = backupDirectory / "recovery";
    const Path stageEvidence = stageDirectory / "recovery";
    ASSERT_TRUE(WriteBinaryFile(backupEvidence, payload));
    ASSERT_TRUE(WriteBinaryFile(stageEvidence, payload));
    EXPECT_FALSE(filesystem.compact(false));

    Vector<u8> loaded;
    ASSERT_TRUE(ReadBinaryFile(backupEvidence, loaded).has_value());
    ASSERT_EQ(loaded.size(), payload.size());
    for(usize i = 0u; i < payload.size(); ++i)
        EXPECT_EQ(loaded[i], payload[i]);

    ASSERT_TRUE(ReadBinaryFile(stageEvidence, loaded).has_value());
    ASSERT_EQ(loaded.size(), payload.size());
    for(usize i = 0u; i < payload.size(); ++i)
        EXPECT_EQ(loaded[i], payload[i]);

    ASSERT_TRUE(filesystem.unmount());
}

void VerifyFilesystemVolumeTest_IncompleteCompactionRollbackUnmountsTheVolume(mut FilesystemVolumeTest self){
    b8 windowsSupported = false;
    native(mut windowsSupported){
#if defined(NWB_PLATFORM_WINDOWS)
        windowsSupported = true;
#endif
    }
    if(!windowsSupported){
        EXPECT_TRUE(self.m_desc.createIfMissing);
        return;
    }

    VolumeFileSystem filesystem(self.m_arena);
    ASSERT_TRUE(filesystem.mount(self.m_desc));
    ScratchArena scratchArena(s_FilesystemNameTestsFilesystem);

    Vector<u8> abandoned;
    abandoned.resize(5000u);
    for(usize i = 0u; i < abandoned.size(); ++i)
        abandoned[i] = 19u;
    Array<u8, 3> payload = Array<u8, 3>();
    payload[0u] = 4u;
    payload[1u] = 5u;
    payload[2u] = 6u;
    ASSERT_TRUE(filesystem.writeFile(s_FilesystemNameProjectTestsPayload, abandoned));
    ASSERT_TRUE(filesystem.writeFile(s_FilesystemNameProjectTestsPayload, payload));
    ASSERT_GE(filesystem.segmentCount(), 2u);

    b8 handleOpened = false;
    b8 compactSucceeded = true;
    b8 loggerBlocked = false;
    b8 backupMatchedOriginal = false;
    native(mut self, mut filesystem, mut scratchArena, mut handleOpened, mut compactSucceeded, mut loggerBlocked, mut backupMatchedOriginal){
#if defined(NWB_PLATFORM_WINDOWS)
        const auto first = MakeVolumeSegmentPath(self.m_directory, self.m_desc.volumeName.view(), 0u);
        const auto second = MakeVolumeSegmentPath(self.m_directory, self.m_desc.volumeName.view(), 1u);
        Vector<u8, ScratchArena> original(scratchArena);
        ASSERT_TRUE(ReadBinaryFile(first, original));
        const auto paths = FilesystemVolumeStagingDetail::BuildStagedVolumePaths(self.m_directory, self.m_desc.volumeName.view(), scratchArena);
        const auto backup = MakeVolumeSegmentPath(paths.backupDirectory, self.m_desc.volumeName.view(), 0u);
        const HANDLE held = CreateFile(second.c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
        handleOpened = held != INVALID_HANDLE_VALUE;
        if(handleOpened){
            ScopeExit closeHeld([held]()noexcept{ CloseHandle(held); });
            BlockingRestoreLogger logger(self.m_logger.arena(), first);
            {
                LoggerRegistrationGuard loggerGuard(logger, LoggerBreakPolicy::ReportOnly);
                compactSucceeded = filesystem.compact(false);
            }
            loggerBlocked = logger.blocked();
            Vector<u8, ScratchArena> loaded(scratchArena);
            if(ReadBinaryFile(backup, loaded) && loaded.size() == original.size())
                backupMatchedOriginal = NWB_MEMCMP(loaded.data(), original.data(), original.size()) == 0;
        }
#else
        static_cast<void>(self);
        static_cast<void>(filesystem);
        static_cast<void>(scratchArena);
        static_cast<void>(handleOpened);
        static_cast<void>(compactSucceeded);
        static_cast<void>(loggerBlocked);
        static_cast<void>(backupMatchedOriginal);
#endif
    }

    ASSERT_TRUE(handleOpened);
    EXPECT_FALSE(compactSucceeded);
    EXPECT_TRUE(loggerBlocked);
    EXPECT_FALSE(filesystem.mounted());
    EXPECT_FALSE(filesystem.fileExists(s_FilesystemNameProjectTestsPayload));
    EXPECT_TRUE(backupMatchedOriginal);
    Vector<u8> loadedAfterFailure;
    EXPECT_FALSE(filesystem.readFile(s_FilesystemNameProjectTestsPayload, loadedAfterFailure));
    EXPECT_TRUE(filesystem.unmount());
}

void VerifyFilesystemVolumeTest_FailedCompactionPreservesOverlappingSourcePayloadBytes(mut FilesystemVolumeTest self){
    VolumeFileSystem filesystem(self.m_arena);
    ASSERT_TRUE(filesystem.mount(self.m_desc));
    ScratchArena scratchArena(s_FilesystemNameTestsFilesystem);

    native(mut self, mut filesystem, mut scratchArena){
        Vector<u8, ScratchArena> first(static_cast<usize>(self.m_desc.segmentSize - self.m_desc.metadataSize), 31u, scratchArena);
        const Array<u8, 128u> gap{};
        Array<u8, 256u> payload{};
        for(usize index = 0u; index < payload.size(); ++index)
            payload[index] = static_cast<u8>(index);
        ASSERT_TRUE(filesystem.writeFile(s_FilesystemNameProjectTestsCompactFirst, first));
        ASSERT_TRUE(filesystem.writeFile(s_FilesystemNameProjectTestsCompactGap, gap));
        ASSERT_TRUE(filesystem.writeFile(s_FilesystemNameProjectTestsCompactTarget, payload));
        ASSERT_TRUE(filesystem.removeFile(s_FilesystemNameProjectTestsCompactGap));
        const ::Path<ScratchArena> directory(scratchArena, self.m_directory);
        const auto metadataSegment = MakeVolumeSegmentPath(directory, self.m_desc.volumeName.view(), 0u);
        auto backupSegment = metadataSegment;
        backupSegment += s_HeldFileSuffix;
        b8 restored = false;
        {
            ASSERT_TRUE(RenamePath(metadataSegment, backupSegment));
            ScopeExit restore([&]()noexcept{
                const auto removed = RemoveAllForCleanup(metadataSegment);
                if(removed)
                    restored = static_cast<b8>(RenamePath(backupSegment, metadataSegment));
            });
            ASSERT_TRUE(EnsureDirectories(metadataSegment));
            EXPECT_FALSE(filesystem.compact(false));
        }
        ASSERT_TRUE(restored);
        Vector<u8, ScratchArena> loaded(scratchArena);
        ASSERT_TRUE(filesystem.readFile(s_FilesystemNameProjectTestsCompactTarget, loaded));
        ASSERT_EQ(loaded.size(), payload.size());
        EXPECT_EQ(NWB_MEMCMP(loaded.data(), payload.data(), payload.size()), 0);
    }

    ASSERT_TRUE(filesystem.unmount());
}

void VerifyFilesystemVolumeTest_ImmediateMutationUnwindPreservesIndexedPayloadsAndMembership(mut FilesystemVolumeTest self){
    b8 warningsEnabled = false;
    native(mut warningsEnabled){
#if NWB_OCCUR_WARNING
        warningsEnabled = true;
#endif
    }
    if(!warningsEnabled){
        EXPECT_TRUE(self.m_desc.createIfMissing);
        return;
    }

    VolumeFileSystem filesystem(self.m_arena);
    ASSERT_TRUE(filesystem.mount(self.m_desc));
    ScratchArena scratchArena(s_FilesystemNameTestsFilesystem);

    const usize firstSize = cast<usize>(self.m_desc.segmentSize - self.m_desc.metadataSize);
    Vector<u8> first;
    first.resize(firstSize);
    for(usize i = 0u; i < firstSize; ++i)
        first[i] = 31u;

    Array<u8, 4> payload = Array<u8, 4>();
    payload[0u] = 1u;
    payload[1u] = 2u;
    payload[2u] = 3u;
    payload[3u] = 4u;

    Array<u8, 4> replacement = Array<u8, 4>();
    replacement[0u] = 8u;
    replacement[1u] = 7u;
    replacement[2u] = 6u;
    replacement[3u] = 5u;

    ASSERT_TRUE(filesystem.writeFile(s_FilesystemNameProjectTestsMutationFirst, first));
    ASSERT_TRUE(filesystem.writeFile(s_FilesystemNameProjectTestsPayload, payload));

    Vector<u8> loaded;
    for(u32 operation = 0u; operation < 3u; ++operation){
        b8 restored = false;
        native(in operation, in replacement, mut self, mut filesystem, mut scratchArena, mut restored){
#if NWB_OCCUR_WARNING
            const ::Path<ScratchArena> directory(scratchArena, self.m_directory);
            const auto metadataSegment = MakeVolumeSegmentPath(directory, self.m_desc.volumeName.view(), 0u);
            auto backupSegment = metadataSegment;
            backupSegment += s_HeldFileSuffix;
            ASSERT_TRUE(RenamePath(metadataSegment, backupSegment));
            ScopeExit restore([&]()noexcept{
                const auto removed = RemoveAllForCleanup(metadataSegment);
                if(removed)
                    restored = static_cast<b8>(RenamePath(backupSegment, metadataSegment));
            });
            ASSERT_TRUE(EnsureDirectories(metadataSegment));
            ThrowingPublishLogger throwingLogger(self.m_logger.arena());
            LoggerRegistrationGuard throwingLoggerGuard(throwingLogger, LoggerBreakPolicy::ReportOnly);
            if(operation == 0u)
                EXPECT_THROW({ const b8 written = filesystem.writeFile(s_FilesystemNameProjectTestsPayload, replacement); EXPECT_FALSE(written); }, i32);
            else if(operation == 1u)
                EXPECT_THROW({ const b8 written = filesystem.writeFile(s_FilesystemNameProjectTestsMutationNew, replacement); EXPECT_FALSE(written); }, i32);
            else
                EXPECT_THROW({ const b8 removed = filesystem.removeFile(s_FilesystemNameProjectTestsPayload); EXPECT_FALSE(removed); }, i32);
#else
            static_cast<void>(operation);
            static_cast<void>(replacement);
            static_cast<void>(self);
            static_cast<void>(filesystem);
            static_cast<void>(scratchArena);
            static_cast<void>(restored);
#endif
        }
        ASSERT_TRUE(restored);
        EXPECT_EQ(filesystem.fileCount(), 2u);
        EXPECT_TRUE(filesystem.fileExists(s_FilesystemNameProjectTestsPayload));
        EXPECT_FALSE(filesystem.fileExists(s_FilesystemNameProjectTestsMutationNew));
        ASSERT_TRUE(filesystem.readFile(s_FilesystemNameProjectTestsPayload, loaded));
        ASSERT_EQ(loaded.size(), payload.size());
        for(usize i = 0u; i < payload.size(); ++i)
            EXPECT_EQ(loaded[i], payload[i]);
    }

    ASSERT_TRUE(filesystem.unmount());
}

void VerifyFilesystemVolumeTest_CompactionPreservesCapacityUntilRequestedTrimAndRetainsCursorIdentity(mut FilesystemVolumeTest self){
    VolumeFileSystem filesystem(self.m_arena);
    ASSERT_TRUE(filesystem.mount(self.m_desc));

    Vector<u8> abandoned;
    abandoned.resize(5000u);
    for(usize i = 0u; i < abandoned.size(); ++i)
        abandoned[i] = 19u;

    Array<u8, 3> payload = Array<u8, 3>();
    payload[0u] = 4u;
    payload[1u] = 5u;
    payload[2u] = 6u;
    ASSERT_TRUE(filesystem.writeFile(s_FilesystemNameProjectTestsPayload, abandoned));
    ASSERT_TRUE(filesystem.writeFile(s_FilesystemNameProjectTestsPayload, payload));

    const usize originalSegments = filesystem.segmentCount();
    ASSERT_GT(originalSegments, 1u);
    const Expected<FileCursor> opened = filesystem.openFile(s_FilesystemNameProjectTestsPayload);
    ASSERT_TRUE(opened.has_value());
    FileCursor cursor = opened.value();

    ASSERT_TRUE(filesystem.compact(false));
    EXPECT_EQ(filesystem.segmentCount(), originalSegments);
    const Expected<u64> wasted = filesystem.wastedBytes();
    ASSERT_TRUE(wasted.has_value());
    EXPECT_EQ(wasted.value(), 0u);

    Array<u8, 3> loaded = Array<u8, 3>();
    Expected<usize> read = MakeUnexpected(Failure());
    native(mut filesystem, mut cursor, mut loaded, mut read){
        read = filesystem.readFile(cursor, loaded.data(), loaded.size());
    }
    ASSERT_TRUE(read.has_value());
    EXPECT_EQ(read.value(), payload.size());
    for(usize i = 0u; i < payload.size(); ++i)
        EXPECT_EQ(loaded[i], payload[i]);

    ASSERT_TRUE(filesystem.compact(true));
    EXPECT_EQ(filesystem.segmentCount(), 1u);
    const auto firstSegment = MakeVolumeSegmentPath(self.m_directory, self.m_desc.volumeName.view(), 0u);
    const Expected<u64, ErrorCode> lastSegmentBytes = FileSize(firstSegment);
    ASSERT_TRUE(lastSegmentBytes.has_value());
    EXPECT_EQ(lastSegmentBytes.value(), self.m_desc.metadataSize + payload.size());

    ASSERT_TRUE(filesystem.unmount());
}

void VerifyFilesystemVolumeTest_RejectsInvalidPathHashFromMetadataIndex(mut FilesystemVolumeTest self){
    ScratchArena scratchArena(s_FilesystemNameTestsFilesystem);
    native(mut self, mut scratchArena){
        using FilesystemVolumeDetail::VolumeHeaderDisk;
        using FilesystemVolumeDetail::VolumeIndexEntryDisk;
        auto filesystemResult = CreateFilesystem(self.m_arena, self.m_desc);
        ASSERT_TRUE(filesystemResult);
        auto filesystem = Move(*filesystemResult);
        const Array<u8, 3u> payload{ 4u, 5u, 6u };
        ASSERT_TRUE(filesystem->writeFile(s_FilesystemNameProjectTestsPayload, payload));
        ASSERT_EQ(filesystem->fileCount(), 1u);
        ASSERT_TRUE(filesystem->unmount());

        const ::Path<ScratchArena> directory(scratchArena, self.m_directory);
        const auto segmentPath = MakeVolumeSegmentPath(directory, self.m_desc.volumeName.view(), 0u);
        Vector<u8, ScratchArena> bytes(scratchArena);
        ASSERT_TRUE(ReadBinaryFile(segmentPath, bytes));
        ASSERT_GE(bytes.size(), sizeof(VolumeHeaderDisk) + sizeof(VolumeIndexEntryDisk));
        VolumeIndexEntryDisk entry{};
        NWB_MEMCPY(&entry, sizeof(entry), bytes.data() + sizeof(VolumeHeaderDisk), sizeof(entry));
        ASSERT_TRUE(Name(entry.hash));
        entry.hash = NameHash{};
        NWB_MEMCPY(bytes.data() + sizeof(VolumeHeaderDisk), sizeof(entry), &entry, sizeof(entry));
        ASSERT_TRUE(WriteBinaryFile(segmentPath, bytes));
    }

    self.m_desc.createIfMissing = false;
    self.m_desc.usage = VolumeUsage::RuntimeReadOnly;
    EXPECT_FALSE(CreateFilesystem(self.m_arena, self.m_desc).has_value());
}

void VerifyFilesystemVolumeTest_MetadataImagePreservesCompleteHashesAndClearsRemovedRecords(mut FilesystemVolumeTest self){
    ScratchArena scratchArena(s_FilesystemNameTestsFilesystem);
    CreatedFilesystem filesystem(self.m_arena, self.m_desc);
    ASSERT_TRUE(filesystem.valid());

    native(mut self, mut scratchArena, mut filesystem){
        using FilesystemVolumeDetail::VolumeHeaderDisk;
        using FilesystemVolumeDetail::VolumeIndexEntryDisk;
        Array<NameHash, 3u> hashes{};
        for(NameHash& hash : hashes)
            hash.qwords[0u] = 7u;
        hashes[0u].qwords[s_NameHashLaneCount - 1u] = 30u;
        hashes[1u].qwords[s_NameHashLaneCount - 1u] = 10u;
        hashes[2u].qwords[s_NameHashLaneCount - 1u] = 20u;
        const Array<u8, 3u> payload{ 4u, 5u, 6u };
        ASSERT_TRUE(filesystem.get().writeFileDeferred(Name(hashes[0u]), payload));
        ASSERT_TRUE(filesystem.get().writeFileDeferred(Name(hashes[2u]), payload));
        ASSERT_TRUE(filesystem.get().writeFileDeferred(Name(hashes[1u]), nullptr, 0u));
        ASSERT_TRUE(filesystem.get().flush());

        Vector<u8, ScratchArena> expected(scratchArena);
        Vector<u8, ScratchArena> actual(scratchArena);
        expected.reserve(static_cast<usize>(self.m_desc.segmentSize));
        actual.reserve(static_cast<usize>(self.m_desc.segmentSize));
        const Array<VolumeIndexEntryDisk, 3u> records{
            VolumeIndexEntryDisk{ hashes[1u], 518u, 0u },
            VolumeIndexEntryDisk{ hashes[2u], 515u, 3u },
            VolumeIndexEntryDisk{ hashes[0u], 512u, 3u }
        };
        const auto segmentPath = MakeVolumeSegmentPath(self.m_directory, self.m_desc.volumeName.view(), 0u);
        const auto verifyImage = [&](const usize firstRecord){
            VolumeHeaderDisk header{};
            header.magic = FilesystemVolumeDetail::s_VolumeMagic;
            header.segmentSize = self.m_desc.segmentSize;
            header.metadataBytes = self.m_desc.metadataSize;
            header.fileCount = records.size() - firstRecord;
            header.indexBytes = header.fileCount * sizeof(VolumeIndexEntryDisk);
            header.nextFreeOffset = 518u;
            expected.clear();
            AppendPOD(expected, header);
            for(usize index = firstRecord; index < records.size(); ++index)
                AppendPOD(expected, records[index]);
            expected.resize(static_cast<usize>(self.m_desc.metadataSize), 0u);
            expected.insert(expected.end(), payload.begin(), payload.end());
            expected.insert(expected.end(), payload.begin(), payload.end());
            ASSERT_TRUE(ReadBinaryFile(segmentPath, actual));
            ASSERT_EQ(actual.size(), expected.size());
            EXPECT_EQ(NWB_MEMCMP(actual.data(), expected.data(), expected.size()), 0);
        };
        verifyImage(0u);
        ASSERT_TRUE(filesystem.get().unmount());
        self.m_desc.createIfMissing = false;
        self.m_desc.usage = VolumeUsage::RuntimeReadOnly;
        ASSERT_TRUE(filesystem.get().mount(self.m_desc));
        for(usize index = 0u; index < hashes.size(); ++index){
            VolumeBytes loaded(self.m_arena);
            ASSERT_TRUE(filesystem.get().readFile(Name(hashes[index]), loaded));
            if(index == 1u)
                EXPECT_TRUE(loaded.empty());
            else{
                ASSERT_EQ(loaded.size(), payload.size());
                EXPECT_EQ(NWB_MEMCMP(loaded.data(), payload.data(), payload.size()), 0);
            }
        }
        ASSERT_TRUE(filesystem.get().unmount());
        self.m_desc.usage = VolumeUsage::CookWrite;
        ASSERT_TRUE(filesystem.get().mount(self.m_desc));
        for(usize index = 0u; index < records.size(); ++index){
            ASSERT_TRUE(filesystem.get().removeFile(Name(records[index].hash)));
            verifyImage(index + 1u);
        }
    }

    EXPECT_EQ(filesystem.get().fileCount(), 0u);
    ASSERT_TRUE(filesystem.get().unmount());
}

void VerifyFilesystemFactory_PropagatesFactoryAndMountFailures(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, LoggerBreakPolicy::ReportOnly);
    GlobalArena arena(s_FilesystemNameTestsFilesystem);
    VolumeMountDesc desc(arena);

    native(in desc, mut arena){
        const FilesystemFactory emptyFactory = []([[maybe_unused]] GlobalArena& objectArena, [[maybe_unused]] const VolumeMountDesc& mount)noexcept{
            return Expected<UniquePtr<IFilesystem>>(UniquePtr<IFilesystem>());
        };
        EXPECT_FALSE(CreateFilesystem(arena, desc, emptyFactory));
        const FilesystemFactory failedFactory = []([[maybe_unused]] GlobalArena& objectArena, [[maybe_unused]] const VolumeMountDesc& mount)noexcept -> Expected<UniquePtr<IFilesystem>>{
            return MakeUnexpected(Failure{});
        };
        EXPECT_FALSE(CreateFilesystem(arena, desc, failedFactory));
    }

    EXPECT_FALSE(CreateFilesystem(arena, desc).has_value());
}

void VerifyFilesystem_VolumeNamesRejectEmptySeparatorsAndWhitespace(){
    EXPECT_FALSE(ValidVolumeName(""));
    EXPECT_FALSE(ValidVolumeName("graphics/cache"));
    EXPECT_FALSE(ValidVolumeName("graphics cache"));
}

void VerifyFilesystemVolumeTest_EarlyPublicationFailureCleansOwnedWorkDirectories(mut FilesystemVolumeTest self){
    ScratchArena scratchArena(s_FilesystemNameTestsFilesystem);
    const Path baseDirectory = self.m_directory;
    StagedDirectoryPaths paths = StagedDirectoryPaths();
    paths.stageDirectory = baseDirectory / s_FilesystemStageDirectory;
    paths.backupDirectory = baseDirectory / s_FilesystemBackupDirectory;
    ASSERT_TRUE(EnsureDirectories(paths.stageDirectory).has_value());
    ASSERT_TRUE(EnsureDirectories(paths.backupDirectory).has_value());

    b8 published = true;
    native(in paths, mut self, mut scratchArena, mut published){
        StagedDirectoryCleanupGuard stageCleanup(paths.stageDirectory, "test");
        StagedDirectoryCleanupGuard backupCleanup(paths.backupDirectory, "test", s_BackupDirectoryLabel);
        published = PublishStagedVolume(paths, self.m_directory, self.m_desc.volumeName.view(), 0u, scratchArena, {}, &stageCleanup, &backupCleanup);
    }

    EXPECT_FALSE(published);
    const Expected<b8, ErrorCode> stageExists = FileExists(paths.stageDirectory);
    const Expected<b8, ErrorCode> backupExists = FileExists(paths.backupDirectory);
    ASSERT_TRUE(stageExists.has_value());
    ASSERT_TRUE(backupExists.has_value());
    EXPECT_FALSE(stageExists.value());
    EXPECT_FALSE(backupExists.value());
}

void VerifyFilesystemVolumeTest_IncompletePublicationRollbackPreservesRecoveryFiles(mut FilesystemVolumeTest self){
    ScratchArena scratchArena(s_FilesystemNameTestsFilesystem);
    StagedDirectoryPaths paths = StagedDirectoryPaths();
    b8 rollbackFailed = false;

    native(mut self, mut scratchArena, mut paths, mut rollbackFailed){
        paths.stageDirectory = self.m_directory / s_FilesystemStageDirectory;
        paths.backupDirectory = self.m_directory / s_FilesystemBackupDirectory;
        ASSERT_TRUE(EnsureDirectories(paths.stageDirectory));
        ASSERT_TRUE(EnsureDirectories(paths.backupDirectory));
        const auto output = MakeVolumeSegmentPath(self.m_directory, self.m_desc.volumeName.view(), 0u);
        const auto backup = MakeVolumeSegmentPath(paths.backupDirectory, self.m_desc.volumeName.view(), 0u);
        const Array<u8, 3u> oldBytes{ 1u, 2u, 3u };
        ASSERT_TRUE(WriteBinaryFile(output, oldBytes));
        const VolumePublicationObserver observer{
            .context = &rollbackFailed,
            .rollbackFailed = [](void* context)noexcept{ *static_cast<b8*>(context) = true; },
        };
        {
            StagedDirectoryCleanupGuard stageCleanup(paths.stageDirectory, "test");
            StagedDirectoryCleanupGuard backupCleanup(paths.backupDirectory, "test", s_BackupDirectoryLabel);
            BlockingRestoreLogger logger(self.m_logger.arena(), output);
            LoggerRegistrationGuard loggerGuard(logger, LoggerBreakPolicy::ReportOnly);
            EXPECT_FALSE(PublishStagedVolume(paths, self.m_directory, self.m_desc.volumeName.view(), 1u, scratchArena, observer, &stageCleanup, &backupCleanup));
            EXPECT_TRUE(logger.blocked());
        }
        Vector<u8, ScratchArena> loaded(scratchArena);
        ASSERT_TRUE(ReadBinaryFile(backup, loaded));
        ASSERT_EQ(loaded.size(), oldBytes.size());
        EXPECT_EQ(NWB_MEMCMP(loaded.data(), oldBytes.data(), oldBytes.size()), 0);
        const auto stageExists = IsDirectory(paths.stageDirectory);
        ASSERT_TRUE(stageExists);
        EXPECT_TRUE(*stageExists);
    }

    EXPECT_TRUE(rollbackFailed);
}

