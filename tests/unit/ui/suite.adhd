    EXPECT_TRUE(m_context.input().targets().empty());
    EXPECT_FALSE(m_context.input().hasPopup());
}

TEST_F(UiNestedPopupLoanTests, ReopeningTheParentBeforeOuterEndSuppressesItsOldDescendantLoans){
