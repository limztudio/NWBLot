void VerifyNumericLifetimeTests_RestorationDropsPreeditAndUndoWhileUsingCanonicalCommittedValue(mut NumericLifetimeIntegerFixture self){
    for(u32 action = 0u; action < 3u; ++action){
        ASSERT_TRUE(self.m_model.setDraft("  +0007 "));
        ASSERT_TRUE(self.m_model.submit().committed);
        ASSERT_TRUE(self.m_model.lendDraft().selectAll());
        ASSERT_TRUE(self.m_model.lendDraft().replaceSelection("-"));
        ASSERT_TRUE(self.m_model.lendDraft().beginComposition());
        ASSERT_TRUE(self.m_model.lendDraft().updateComposition("9", 0u, 1u));
        const u64 external = self.m_model.draft().externalRevision();
        NumericEditResult result = NumericEditResult();
        if(action == 0u)
            result = self.m_model.cancel();
        else if(action == 1u)
            result = self.m_model.abandon();
        else
            result = self.m_model.blur();
        ASSERT_TRUE(result.valid);
        EXPECT_EQ(result.cancelled, action == 0u);
        EXPECT_EQ(result.rejected, action == 2u);
        EXPECT_TRUE(result.restored);
        EXPECT_FALSE(result.committed);
        EXPECT_FALSE(result.valueChanged);
        EXPECT_EQ(self.m_model.value(), 7);
        EXPECT_EQ(self.m_model.draft().text(), "7");
        EXPECT_FALSE(self.m_model.dirty());
        EXPECT_FALSE(self.m_model.draft().composition().active);
        EXPECT_FALSE(self.m_model.draft().canUndo());
        EXPECT_FALSE(self.m_model.draft().canRedo());
        EXPECT_EQ(self.m_model.draft().anchor(), 1u);
        EXPECT_EQ(self.m_model.draft().caret(), 1u);
        EXPECT_GT(self.m_model.draft().externalRevision(), external);
    }
}

