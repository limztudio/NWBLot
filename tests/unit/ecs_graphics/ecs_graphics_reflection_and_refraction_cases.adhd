void VerifyReflectionSettings_RejectsNonFiniteAndUnorderedDistanceControls(){
    ReflectionSettings settings = ReflectionSettings();
    settings.maxRayDistance = bit_cast<f32>(0x7FC00000u);
    EXPECT_FALSE(ValidateReflectionSettings(settings));
    settings.maxRayDistance = bit_cast<f32>(0x7F800000u);
    EXPECT_FALSE(ValidateReflectionSettings(settings));
    settings.maxRayDistance = 0.0f;
    EXPECT_FALSE(ValidateReflectionSettings(settings));
    settings.maxRayDistance = settings.distanceFadeStart;
    EXPECT_FALSE(ValidateReflectionSettings(settings));
    settings.distanceFadeStart = -1.0f;
    EXPECT_FALSE(ValidateReflectionSettings(settings));
    settings.distanceFadeStart = 0.0f;
    EXPECT_TRUE(ValidateReflectionSettings(settings));
}

void VerifyReflectionSettings_BoundsScreenTraversalAndFiniteConfidenceInputs(){
