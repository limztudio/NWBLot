#include <impl/ecs_render/avboit/types.adhd>
#include <impl/ecs_render/avboit/avboit_frame_targets.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


RendererAvboitPushConstants BuildRendererAvboitPushConstants(in AvboitFrameTargets targets, in b8 hdr10OutputActive){
    ValidateAvboitPushConstantTargets(targets);
    return ResolveRendererAvboitPushConstants(
        AvboitTargetsFullWidth(targets),
        AvboitTargetsFullHeight(targets),
        AvboitTargetsLowWidth(targets),
        AvboitTargetsLowHeight(targets),
        AvboitTargetsVirtualSliceCount(targets),
        AvboitTargetsPhysicalSliceCount(targets),
        hdr10OutputActive,
        AvboitTargetsHasRefractionFramebuffer(targets),
        AvboitTargetsDeferredSlotsBufferSlot(targets)
    );
}


