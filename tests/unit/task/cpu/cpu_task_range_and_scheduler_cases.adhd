void VerifyCpuTaskSubmissionTests_CallableConstructionFailurePublishesNoSchedulerOrScopeWork(){
    CpuTaskScheduler scheduler(0u);
    CpuTaskScope scope(scheduler);
    i32 schedulerResult = 0;
    i32 scopeResult = 0;
    u32 handled = 0u;
    native(mut scheduler, mut scope, mut schedulerResult, mut scopeResult, mut handled){
        using namespace __hidden_cpu_task_submission_tests;
        ThrowingCopyTask callable;
        const auto handleError = [&handled](const u32 err)noexcept {
            ++handled;
            return static_cast<int>(err);
        };
        schedulerResult = InvokeTerminalEntry<u32>([&]()->int {
            const auto task = scheduler.submit(callable);
            EXPECT_FALSE(task);
            return -1;
        }, handleError, []()noexcept { return -2; });
        EXPECT_EQ(scheduler.statistics().outstandingTasks, 0u);

        scopeResult = InvokeTerminalEntry<u32>([&]()->int {
            const auto task = scope.submit(callable);
            EXPECT_FALSE(task);
            return -1;
        }, handleError, []()noexcept { return -2; });
    }
    const auto stats = scheduler.statistics();
    scope.wait();
    scheduler.wait();
    EXPECT_EQ(schedulerResult, cast<i32>(0xE101u));
    EXPECT_EQ(scopeResult, cast<i32>(0xE101u));
    EXPECT_EQ(handled, 2u);
    EXPECT_EQ(stats.outstandingTasks, 0u);
    EXPECT_EQ(stats.completedTasks, 0u);
    EXPECT_EQ(stats.canceledTasks, 0u);
}

void VerifyCpuTaskSubmissionTests_ExpectedAdmissionErrorsPreservePublicationAndCancellationBoundaries(){
    u32 callbacks = 0u;
    CpuTaskScheduler scheduler(0u);
    CpuTaskScope canceled(scheduler);
    Expected<CpuTaskHandle, CpuTaskAdmissionErrorEnum> invalidDependencies = MakeUnexpected(CpuTaskAdmissionError::Aborting);
    native(mut scheduler, mut callbacks, mut invalidDependencies){
        invalidDependencies = scheduler.submit([&]()noexcept { ++callbacks; }, {}, nullptr, 1u);
    }
    ASSERT_FALSE(invalidDependencies.has_value());
    EXPECT_EQ(invalidDependencies.error(), CpuTaskAdmissionError::InvalidDependencies);
    CpuTaskOptions options = CpuTaskOptions();
    options.target = cast<CpuTaskTargetEnum>(cast<u8>(CpuTaskTarget::MainThread) + 1u);
    const auto invalidOptions = scheduler.submit(lambda[mut callbacks]() -> void{
        ++callbacks;
    }, options);
    ASSERT_FALSE(invalidOptions.has_value());
    EXPECT_EQ(invalidOptions.error(), CpuTaskAdmissionError::InvalidOptions);
    canceled.cancel();
    const auto scopeRejected = canceled.submit(lambda[mut callbacks]() -> void{
        ++callbacks;
    });
    ASSERT_FALSE(scopeRejected.has_value());
    EXPECT_EQ(scopeRejected.error(), CpuTaskAdmissionError::ScopeCanceled);
    EXPECT_EQ(scheduler.statistics().outstandingTasks, 0u);
    EXPECT_EQ(callbacks, 0u);
    const auto accepted = scheduler.submit(lambda[mut callbacks]() -> void{
        ++callbacks;
    });
    ASSERT_TRUE(accepted.has_value());
    EXPECT_TRUE(accepted.value().valid());
    scheduler.wait(accepted.value());
    EXPECT_EQ(callbacks, 1u);
    scheduler.drain();
    const auto shutdownRejected = scheduler.submit(lambda[mut callbacks]() -> void{
        ++callbacks;
    });
    ASSERT_FALSE(shutdownRejected.has_value());
    EXPECT_EQ(shutdownRejected.error(), CpuTaskAdmissionError::Aborting);
    EXPECT_EQ(callbacks, 1u);
    EXPECT_EQ(scheduler.statistics().outstandingTasks, 0u);
}

void ExecuteWorkerCallbackFailureDeath(in u32 workerCount, in u32 exceptionCode){
    DeadlineGuard deadline(true, s_TestTimeoutMS);
    i32 result = 0;
    native(in workerCount, in exceptionCode, mut result){
        result = InvokeTerminalEntry<u32>([&]()->int {
            CpuTaskScheduler scheduler(workerCount);
            const auto cpuTaskAdmission = scheduler.submit([&]() {
                if(scheduler.currentWorkerIndex() == 0u)
                    ExitTestProcess(0u);
                throw exceptionCode;
            });
            if(!cpuTaskAdmission)
                ExitTestProcess(0u);
            const auto task = *cpuTaskAdmission;
            if(!task.valid())
                return 0;
            scheduler.wait(task);
            return 0;
        }, [](const u32)noexcept { return 0; }, []()noexcept { return 0; });
    }
    ExitTestProcess(cast<u32>(result));
}

void VerifyCpuTaskSubmissionTests_WorkerCallbackFailureTerminatesWithoutDeferredCallerDelivery(){
    const u32 workerCount = 1u;
    const u32 exceptionCode = s_SubmissionWorkerException;
    EXPECT_DEATH(ExecuteWorkerCallbackFailureDeath(workerCount, exceptionCode), "");
}

void ExecuteParallelRangeWorkerFailureDeath(in u32 workerCount, in usize itemCount, in u32 exceptionCode){
    DeadlineGuard deadline(true, s_TestTimeoutMS);
    i32 result = 0;
    native(in workerCount, in itemCount, in exceptionCode, mut result){
        result = InvokeTerminalEntry<u32>([&]()->int {
            CpuTaskScheduler scheduler(workerCount);
            AtomicFlag workerEntered;
            EXPECT_TRUE((scheduler.parallelFor(0u, itemCount, [&](const usize) {
                if(scheduler.currentWorkerIndex() == 0u){
                    while(!workerEntered.test(MemoryOrder::acquire))
                        workerEntered.wait(false, MemoryOrder::acquire);
                    return;
                }
                workerEntered.testAndSet(MemoryOrder::release);
                workerEntered.notifyAll();
                throw exceptionCode;
            })));
            return 0;
        }, [](const u32)noexcept { return 0; }, []()noexcept { return 0; });
    }
    ExitTestProcess(cast<u32>(result));
}

void VerifyCpuTaskSubmissionTests_ParallelRangeWorkerFailureTerminatesWithoutDeferredCallerDelivery(){
    const u32 workerCount = 1u;
    const usize itemCount = 64u;
    const u32 exceptionCode = s_SubmissionWorkerException;
    EXPECT_DEATH(ExecuteParallelRangeWorkerFailureDeath(workerCount, itemCount, exceptionCode), "");
}


