const Name s_UiEditBoxSkinAssetName = "tests/ui/edit_box/skin";
const Name s_UiEditBoxFontAssetName = "tests/ui/edit_box/font";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Rect MakeUiControlCaretRect(in f32 x, in f32 y, in f32 width, in f32 height){
    Rect rect = Rect();
    rect.x = x;
    rect.y = y;
    rect.width = width;
    rect.height = height;
    return rect;
}

Point MakeUiControlCaretPoint(in f32 x, in f32 y){
    Point point = Point();
    point.x = x;
    point.y = y;
    return point;
}

Insets MakeUiControlCaretInsets(in f32 left, in f32 top, in f32 right, in f32 bottom){
    Insets insets = Insets();
    insets.left = left;
    insets.top = top;
    insets.right = right;
    insets.bottom = bottom;
    return insets;
}

EditBoxRange MakeUiEditCaretRange(in usize begin, in usize end){
    EditBoxRange range = EditBoxRange();
    range.begin = begin;
    range.end = end;
    return range;
}

EditCaretMapping MakeUiEditCaretMapping(in usize committedByte, in usize displayByte){
    EditCaretMapping mapping = EditCaretMapping();
    mapping.committedByte = committedByte;
    mapping.displayByte = displayByte;
    return mapping;
}

HitTarget MakeUiControlInputHost(in u64 id, in f32 x){
    HitTarget target = HitTarget();
    target.id.value = id;
    target.declarationGeneration = 7u;
    target.rectangle = MakeUiControlCaretRect(x, 0.0f, 100.0f, 100.0f);
    target.clip = MakeUiControlCaretRect(0.0f, 0.0f, 300.0f, 200.0f);
    target.focusable = true;
    target.control.instanceGeneration = 11u;
    target.control.contentGeneration = 21u;
    target.control.contentRevision = 31u;
    target.navigable = true;
    target.scrollable = true;
    target.scrollStep = 72.0;
    target.pageRows = 4u;
    target.gestureMaximum = 2399900.0;
    return target;
}

Array<HitTarget, 1u> MakeUiControlSingleTarget(in HitTarget target){
    Array<HitTarget, 1u> targets = Array<HitTarget, 1u>();
    targets[0u] = target;
    return targets;
}

Array<PopupScope, 1u> MakeUiControlSingleScope(in PopupScope scope){
    Array<PopupScope, 1u> scopes = Array<PopupScope, 1u>();
    scopes[0u] = scope;
    return scopes;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyUiControlInputTests_AcceptedWheelOwnsItsStepAfterCallerTargetMutation(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 5u));
    EXPECT_TRUE(self.wheel(-0.25).pointerConsumed);
    EXPECT_FALSE(self.m_router.focus().valid());
    self.m_targets[0u].scrollStep = 120.0;
    const Expected<ControlAction> actionResult = self.take();
    ASSERT_TRUE(actionResult.has_value());
    const ControlAction action = actionResult.value();
    EXPECT_DOUBLE_EQ(action.delta, -0.25);
    EXPECT_DOUBLE_EQ(action.step, 72.0);
    EXPECT_TRUE(self.m_router.actions().empty());
}

void VerifyUiControlInputTests_OverlappingUnrelatedControlBlocksUnderlyingWheelRouting(mut UiControlInputTests self){
    HitTarget cover = MakeUiControlInputHost(4u, 0.0f);
    cover.paintOrder = 10u;
    cover.control = ControlToken();
    cover.navigable = false;
    cover.scrollable = false;
    Array<HitTarget, 4u> targets = Array<HitTarget, 4u>();
    targets[0u] = self.m_targets[0u];
    targets[1u] = self.m_targets[1u];
    targets[2u] = self.m_targets[2u];
    targets[3u] = cover;
    ASSERT_TRUE(self.m_router.commitTargets(targets, 1u));
    EXPECT_TRUE(self.wheel().pointerConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
}

void VerifyUiControlInputTests_HorizontalOnlyWheelIsConsumedWithoutVerticalMutation(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    InputEvent event = MakeUiControlInputPointer(InputEventType::PointerWheel);
    event.scrollX = 2.0;
    EXPECT_TRUE(self.send(event).pointerConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    event.position = MakeUiControlCaretPoint(200.0f, 180.0f);
    EXPECT_FALSE(self.send(event).pointerConsumed);
}

void VerifyUiControlInputTests_SceneHeldPrimarySequenceCannotStartScrollingWhenPointerCrossesList(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    EXPECT_FALSE(self.send(MakeUiControlInputPointer(InputEventType::PrimaryDown, MakeUiControlCaretPoint(200.0f, 180.0f))).pointerConsumed);
    EXPECT_FALSE(self.wheel().pointerConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_FALSE(self.send(MakeUiControlInputPointer(InputEventType::PrimaryUp)).pointerConsumed);
    EXPECT_TRUE(self.wheel().pointerConsumed);
}

void VerifyUiControlInputTests_NavigationCopiesAcceptedPageSizeAndSubmissionDoesNotRepeat(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    self.focus();
    self.m_targets[0u].pageRows = 30u;
    EXPECT_TRUE(self.send(MakeUiControlInputKey(InputEventType::KeyDown, CoreKey::PageDown)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiControlInputKey(InputEventType::KeyDown, CoreKey::PageDown, true)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiControlInputKey(InputEventType::KeyUp, CoreKey::PageDown)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiControlInputKey(InputEventType::KeyDown, CoreKey::Enter)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiControlInputKey(InputEventType::KeyDown, CoreKey::Enter, true)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiControlInputKey(InputEventType::KeyUp, CoreKey::Enter)).commandConsumed);
    const Expected<ControlAction> actionResult1 = self.take();
    ASSERT_TRUE(actionResult1.has_value());
    EXPECT_EQ(actionResult1.value().kind, ControlActionKind::PageDown);
    EXPECT_EQ(actionResult1.value().pageRows, 4u);
    const Expected<ControlAction> actionResult2 = self.take();
    ASSERT_TRUE(actionResult2.has_value());
    EXPECT_EQ(actionResult2.value().kind, ControlActionKind::PageDown);
    const Expected<ControlAction> actionResult3 = self.take();
    ASSERT_TRUE(actionResult3.has_value());
    EXPECT_EQ(actionResult3.value().kind, ControlActionKind::Submit);
    EXPECT_FALSE(self.take().has_value());
}

void VerifyUiControlInputTests_HeldNavigationCannotRetargetAnotherFocusedList(mut UiControlInputTests self){
    const HitTarget second = MakeUiControlInputHost(4u, 140.0f);
    Array<HitTarget, 2u> targets = Array<HitTarget, 2u>();
    targets[0u] = self.m_targets[0u];
    targets[1u] = second;
    ASSERT_TRUE(self.m_router.commitTargets(targets, 1u));
    self.focus();
    EXPECT_TRUE(self.send(MakeUiControlInputKey(InputEventType::KeyDown, CoreKey::Down)).commandConsumed);
    ASSERT_TRUE(self.take().has_value());
    self.focus();
    EXPECT_EQ(self.m_router.focus(), second.id);
    EXPECT_TRUE(self.send(MakeUiControlInputKey(InputEventType::KeyDown, CoreKey::Down, true)).commandConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.send(MakeUiControlInputKey(InputEventType::KeyUp, CoreKey::Down)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiControlInputKey(InputEventType::KeyDown, CoreKey::Down)).commandConsumed);
    const Expected<ControlAction> actionResult2 = self.m_router.consumeControlAction(second.id, second.declarationGeneration, second.control);
    ASSERT_TRUE(actionResult2.has_value());
    EXPECT_EQ(actionResult2.value().kind, ControlActionKind::Down);
}

void VerifyUiControlInputTests_ReplacedContentFencesCaptureActionsAndFocusUntilAcceptance(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    self.click();
    EXPECT_TRUE(self.wheel().pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiControlInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    const usize pending = self.m_router.controlActions().size();
    ASSERT_GT(pending, 0u);
    ASSERT_EQ(self.m_router.capture(), self.m_targets[1u].id);
    self.m_router.fenceControl(self.m_targets[0u].id, self.m_targets[0u].declarationGeneration, self.m_targets[0u].control);
    EXPECT_EQ(self.m_router.capture(), self.m_targets[1u].id);
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    EXPECT_EQ(self.m_router.controlActions().size(), pending);
    self.revise();
    self.m_router.fenceControl(self.m_targets[0u].id, self.m_targets[0u].declarationGeneration, self.m_targets[0u].control);
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.send(MakeUiControlInputPointer(InputEventType::PrimaryUp)).pointerConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u));
    self.click();
    const Expected<ControlAction> actionResult = self.take();
    ASSERT_TRUE(actionResult.has_value());
    EXPECT_EQ(actionResult.value().control.contentRevision, 32u);
}

void VerifyUiControlInputTests_CommitOfNewEpochRejectsOldPressWithoutLeakingItsRelease(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    EXPECT_TRUE(self.send(MakeUiControlInputPointer(InputEventType::PrimaryDown)).pointerConsumed);
    self.revise();
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u));
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_TRUE(self.send(MakeUiControlInputPointer(InputEventType::PrimaryUp)).pointerConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
}

void VerifyUiControlInputTests_ReplacedRowDeclarationRejectsItsQueuedClickWhileHostWheelSurvives(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    self.click();
    EXPECT_TRUE(self.wheel().pointerConsumed);
    ++self.m_targets[1u].declarationGeneration;
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u));
    const Expected<ControlAction> actionResult1 = self.take();
    ASSERT_TRUE(actionResult1.has_value());
    EXPECT_EQ(actionResult1.value().kind, ControlActionKind::Wheel);
    EXPECT_FALSE(self.take().has_value());
    self.click();
    const Expected<ControlAction> actionResult2 = self.take();
    ASSERT_TRUE(actionResult2.has_value());
    EXPECT_EQ(actionResult2.value().kind, ControlActionKind::Activate);
    EXPECT_EQ(actionResult2.value().sourceDeclarationGeneration, self.m_targets[1u].declarationGeneration);
    EXPECT_FALSE(self.take().has_value());
}

void VerifyUiControlInputTests_RemovedRowRejectsItsQueuedStableValueWhileHostWheelSurvives(mut UiControlInputTests self){
