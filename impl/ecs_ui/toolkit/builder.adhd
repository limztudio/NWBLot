        this.checkStyleAccess();
        this.m_customPaletteStyleDirty = true;
        return this.m_popupStyle;
    }

    public mut ListStyle listStyle(){
        this.checkStyleAccess();
        this.m_selectableStyleDirty = true;
        this.m_selectableMetricsCached = false;
        return this.m_listStyle;
    }

