    public mut WidgetStyle style(){
        this.checkStyleAccess();
        this.m_customPaletteStyleDirty = true;
        this.m_widgetStyleDirty = true;
        this.m_buttonMetricsCached = false;
        this.m_checkboxExtentCached = false;
        return this.m_style;
    }

    public mut ScrollbarStyle scrollbarStyle(){
        this.checkStyleAccess();
        this.m_customPaletteStyleDirty = true;
        return this.m_scrollbarStyle;
    }

    public mut EditBoxStyle editStyle(){
        this.checkStyleAccess();
        this.m_customPaletteStyleDirty = true;
        this.m_editMinSizeCached = false;
        this.m_editPaddingCached = false;
        return this.m_editStyle;
    }

