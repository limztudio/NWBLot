#include "style.adhd"
#include <impl/ecs_ui/toolkit/edit/types.adhd>
#include <impl/ecs_ui/toolkit/paint_types.adhd>
#include <impl/ecs_ui/toolkit/text/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Color s_EditBoxSelectionColor = Color(0.20f, 0.40f, 0.78f, 0.75f);
const Color s_EditBoxInactiveSelectionColor = Color(0.28f, 0.31f, 0.38f, 0.55f);
const Color s_EditBoxCaretColor = Color(0.95f, 0.97f, 1.0f, 1.0f);
const Color s_EditBoxPreeditColor = Color(0.50f, 0.72f, 1.0f, 1.0f);

const f32 s_TextAreaDefaultHeight = 160.0f;
const u32 s_UiEditMinInterpolatedStops = 2u;
// One stop per byte boundary 0..committedBytes, plus one extra at the preedit seam.
const usize s_EditCaretMaxExtraMappingStops = 2u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class EditBoxCaretStop{
    public usize committedByte = 0u;
    public usize displayByte = 0u;
    public f32 x = 0.0f;
    public u32 lineIndex = 0u;
}

class EditBoxRange{
    public usize begin = 0u;
    public usize end = 0u;
}

class EditCaretMapping{
    public usize committedByte = 0u;
    public usize displayByte = 0u;
}

class EditCaretLine{
    public usize byteBegin = 0u;
    public usize byteEnd = 0u;
    public usize breakEnd = 0u;
    public u32 firstStop = 0u;
    public u32 stopCount = 0u;
    public f32 top = 0.0f;
    public f32 height = 0.0f;
    public f32 advance = 0.0f;
}

class EditBoxPlacement{
    public Rect bounds;
    public Rect frameClip;
    public Rect content;
    public Rect clip;
    public Point textOrigin;
    public Rect caret;
    public f32 scroll = 0.0f;
    public f32 scrollY = 0.0f;
}

class EditBoxStyle{
    public Name normal = Name("edit.normal");
    public Name hover = Name("edit.hover");
    public Name focused = Name("edit.focused");
    public Name disabled = Name("edit.disabled");
    public Name fallback = Name("button.normal");
    public Name focus = Name("focus.overlay");
    public Color background = s_StyleInsetColor;
    public Color text = s_StyleTextColor;
    public Color disabledText = s_StyleDisabledTextColor;
    public Color selection = s_EditBoxSelectionColor;
    public Color inactiveSelection = s_EditBoxInactiveSelectionColor;
    public Color caret = s_EditBoxCaretColor;
    public Color preedit = s_EditBoxPreeditColor;
    public Insets padding = Insets(s_StyleSpacingMedium, s_StyleSpacingSmall, s_StyleSpacingMedium, s_StyleSpacingSmall);
}

class EditBoxPaintFlags{
    public b8 enabled = true;
    public b8 hovered = false;
    public b8 focused = false;
    public b8 readOnly = false;
    public b8 caretVisible = true;
    public b8 preeditCaretVisible = true;
}

class EditBoxOptions{
    public LayoutSize width = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
    public LayoutSize height;
    public b8 enabled = true;
    public b8 readOnly = false;
}

// The host keeps this value alive through the matching endPanel/endWindow; paint and GPU snapshots own their text.
class EditBoxState{
    public b8 matchesStamp(in TextAreaModelStamp stamp, in b8 expectedFocused)const{
        return this.modelGeneration == stamp.instanceGeneration
            && this.revision == stamp.revision
            && this.selectionGeneration == stamp.selectionGeneration
            && this.anchor == stamp.anchor
            && this.caret == stamp.caret
            && this.focused == expectedFocused;
    }

    public f64 caretElapsed = 0.0;
    public u64 modelGeneration = 0u;
    public u64 revision = 0u;
    public u64 selectionGeneration = 0u;
    public usize anchor = 0u;
    public usize caret = 0u;
    public EditBoxPlacement placement;
    public f32 scroll = 0.0f;
    public b8 focused = false;
}

class EditBoxResult{
    public b8 valid = false;
    public b8 textChanged = false;
    public b8 selectionChanged = false;
    public b8 submitted = false;
    public b8 cancelled = false;
    public b8 focused = false;
    public b8 preeditCaretVisible = true;
    public b8 blurred = false;
    public b8 abandoned = false;
}

class IntegerEditOptions{
    public EditBoxOptions edit;
    public IntegerBounds bounds;
}

class FloatEditOptions{
    public EditBoxOptions edit;
    public FloatBounds bounds;
}

class NumericEditBoxResult{
    public EditBoxResult edit;
    public NumericEditResult numeric;
}

class TextAreaOptions{
    public LayoutSize width = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
    public LayoutSize height = LayoutSize(LayoutSizePolicy::Fixed, s_TextAreaDefaultHeight);
    public b8 enabled = true;
    public b8 readOnly = false;
    public f32 wheelLines = s_StyleScrollWheelStep;
}

class TextAreaScrollSnapshot{
    public TextAreaScrollSnapshot(){
        this.declarationGeneration = 0u;
        this.stateRevision = 0u;
        this.enabled = false;
        this.readOnly = false;
    }

    public TextAreaScrollSnapshot(
        in WidgetId inOwner,
        in PopupToken inPopup,
        in u64 inDeclarationGeneration,
        in u64 inStateRevision,
        in TextAreaModelStamp inModel,
        in b8 inEnabled,
        in b8 inReadOnly
    ){
        this.owner = inOwner;
        this.popup = inPopup;
        this.declarationGeneration = inDeclarationGeneration;
        this.stateRevision = inStateRevision;
        this.model = inModel;
        this.enabled = inEnabled;
        this.readOnly = inReadOnly;
    }

    public b8 operator==(in TextAreaScrollSnapshot rhs)const{
        return this.owner == rhs.owner
            && this.popup == rhs.popup
            && this.declarationGeneration == rhs.declarationGeneration
            && this.stateRevision == rhs.stateRevision
            && this.model == rhs.model
            && this.enabled == rhs.enabled
            && this.readOnly == rhs.readOnly;
    }

    public b8 operator!=(in TextAreaScrollSnapshot rhs)const{
        return this.owner != rhs.owner
            || this.popup != rhs.popup
            || this.declarationGeneration != rhs.declarationGeneration
            || this.stateRevision != rhs.stateRevision
            || this.model != rhs.model
            || this.enabled != rhs.enabled
            || this.readOnly != rhs.readOnly;
    }

    public WidgetId owner;
    public PopupToken popup;
    public u64 declarationGeneration;
    public u64 stateRevision;
    public TextAreaModelStamp model;
    public b8 enabled;
    public b8 readOnly;
}

void ApplySkinPaletteToEditBoxStyle(in UiSkinPalette palette, mut EditBoxStyle style){
    style.background = ResolveUiSkinColor(palette, UiSkinColorRole::EditBackground);
    style.text = ResolveUiSkinColor(palette, UiSkinColorRole::TextNormal);
    style.disabledText = ResolveUiSkinColor(palette, UiSkinColorRole::TextDisabled);
    style.selection = ResolveUiSkinColor(palette, UiSkinColorRole::EditSelection);
    style.inactiveSelection = ResolveUiSkinColor(palette, UiSkinColorRole::EditInactiveSelection);
    style.caret = ResolveUiSkinColor(palette, UiSkinColorRole::EditCaret);
    style.preedit = ResolveUiSkinColor(palette, UiSkinColorRole::EditPreedit);
}

f32 ComputeEditScalarFraction(in StringView text, in usize begin, in usize end, in usize position){
    usize total = 0u;
    usize before = 0u;
    for(usize index = begin; index < end; ++index){
        if(!IsUtf8Continuation(cast<u8>(text[index]))){
            ++total;
            if(index < position)
                ++before;
        }
    }
    if(total == 0u)
        return 0.0f;
    return cast<f32>(before) / cast<f32>(total);
}

Expected<usize> TryFindNearestEditCaretStop(in Span<EditCaretLine> lines, in Span<EditBoxCaretStop> stops, in u32 lineIndex, in Point point){
    if(stops.empty() || cast<usize>(lineIndex) >= lines.size() || !isFinite(point.x) || !isFinite(point.y))
        return makeUnexpected(Failure());
    const EditCaretLine line = lines[lineIndex];
    if(cast<usize>(line.firstStop) > stops.size() || cast<usize>(line.stopCount) > stops.size() - cast<usize>(line.firstStop))
        return makeUnexpected(Failure());
    if(line.stopCount == 0u && (line.firstStop == 0u || cast<usize>(line.firstStop) >= stops.size()))
        return makeUnexpected(Failure());
    usize first = cast<usize>(line.firstStop);
    usize end = first + cast<usize>(line.stopCount);
    if(line.stopCount == 0u){
        first = cast<usize>(line.firstStop) - 1u;
        end = cast<usize>(line.firstStop) + 1u;
    }
    f32 minimumX = stops[first].x;
    if(!isFinite(minimumX) || minimumX < 0.0f)
        return makeUnexpected(Failure());
    f32 maximumX = minimumX;
    for(usize index = first + 1u; index < end; ++index){
        if(!isFinite(stops[index].x) || stops[index].x < 0.0f)
            return makeUnexpected(Failure());
        minimumX = min(minimumX, stops[index].x);
        maximumX = max(maximumX, stops[index].x);
    }
    const f32 queryX = clamp(point.x, minimumX, maximumX);
    f64 nearestY = 0.0;
    f32 nearestX = 0.0f;
    b8 haveBest = false;
    usize result = 0u;
    for(usize index = first; index < end; ++index){
        const EditBoxCaretStop stop = stops[index];
        if(cast<usize>(stop.lineIndex) >= lines.size() || (line.stopCount != 0u && stop.lineIndex != lineIndex))
            return makeUnexpected(Failure());
        const EditCaretLine stopLine = lines[stop.lineIndex];
        if(!isFinite(stopLine.top) || !isFinite(stopLine.height) || stopLine.height <= 0.0f || !isFinite(stopLine.top + stopLine.height))
            return makeUnexpected(Failure());
        const f64 lineCenter = cast<f64>(stopLine.top) + (cast<f64>(stopLine.height) * 0.5);
        f64 distanceY = 0.0;
        if(line.stopCount == 0u)
            distanceY = abs(cast<f64>(point.y) - lineCenter);
        const f32 distanceX = abs(queryX - stop.x);
        if(!haveBest || distanceY < nearestY || (distanceY == nearestY && distanceX < nearestX)){
            nearestY = distanceY;
            nearestX = distanceX;
            result = stop.committedByte;
            haveBest = true;
        }
    }
    if(!haveBest)
        return makeUnexpected(Failure());
    return result;
}

b8 TryHitEditCaretLineAndStop(in Span<EditCaretLine> lines, in Span<EditBoxCaretStop> stops, in Point localPoint, mut u32 outLineIndex, mut usize outCommittedByte){
    outLineIndex = 0u;
    outCommittedByte = 0u;
    if(lines.empty() || lines.size() > cast<usize>(0xffffffffu) || stops.empty() || !isFinite(localPoint.x) || !isFinite(localPoint.y))
        return false;
    u32 lineIndex = cast<u32>(lines.size() - 1u);
    for(u32 index = 0u; cast<usize>(index) < lines.size(); ++index){
        const EditCaretLine line = lines[index];
        if(!isFinite(line.top) || !isFinite(line.height) || line.height <= 0.0f)
            return false;
        const f32 bottom = line.top + line.height;
        if(!isFinite(bottom))
            return false;
        if(localPoint.y < bottom){
            lineIndex = index;
            break;
        }
    }
    const Expected<usize> committedByte = TryFindNearestEditCaretStop(lines, stops, lineIndex, localPoint);
    if(!committedByte.has_value())
        return false;
    outCommittedByte = committedByte.value();
    outLineIndex = lineIndex;
    return true;
}

Expected<usize> TryHitEditCaretGeometry(in Span<EditCaretLine> lines, in Span<EditBoxCaretStop> stops, in Point localPoint){
    u32 lineIndex = 0u;
    usize committedByte = 0u;
    if(!TryHitEditCaretLineAndStop(lines, stops, localPoint, lineIndex, committedByte))
        return makeUnexpected(Failure());
    return committedByte;
}

Expected<usize> TryHitEditWordCaretGeometry(in Span<EditCaretLine> lines, in Span<EditBoxCaretStop> stops, in Point localPoint){
    u32 lineIndex = 0u;
    usize byte = 0u;
    if(!TryHitEditCaretLineAndStop(lines, stops, localPoint, lineIndex, byte))
        return makeUnexpected(Failure());
    const EditCaretLine line = lines[lineIndex];
    if(line.stopCount < s_UiEditMinInterpolatedStops)
        return byte;
    const usize first = cast<usize>(line.firstStop);
    const usize end = first + cast<usize>(line.stopCount);
    usize selected = first;
    for(usize index = first + 1u; index < end; ++index){
        if(stops[index].lineIndex != lineIndex || stops[index].x < stops[index - 1u].x)
            return makeUnexpected(Failure());
        if(localPoint.x < stops[index].x)
            break;
        selected = index;
    }
    if(selected + 1u == end)
        --selected;
    return stops[selected].committedByte;
}

void PlaceEditPreeditUnderline(in Point textOrigin, in f32 caretWidth, mut Rect segment){
    if(segment.width > 0.0f){
        const f32 thickness = min(caretWidth, segment.height);
        const f32 verticalOffset = textOrigin.y + max(0.0f, segment.height - thickness);
        segment.x += textOrigin.x;
        segment.y += verticalOffset;
        segment.height = thickness;
    }
}

// Queries owned projections of validated caret geometry; copied hosts share line, midpoint and preedit endpoint behavior.
Expected<usize> HitEditCaretGeometry(in Span<EditCaretLine> lines, in Span<EditBoxCaretStop> stops, in Point localPoint){
    return TryHitEditCaretGeometry(lines, stops, localPoint);
}

Expected<EditBoxCaretStop> TryFindEditCaretStopByCommittedByte(in Span<EditBoxCaretStop> stops, in usize committedByte){
    for(usize i = 0u; i < stops.size(); ++i){
        if(stops[i].committedByte == committedByte)
            return stops[i];
    }
    return makeUnexpected(Failure());
}

Expected<usize> ResolveEditCaretPageTarget(
    in Span<EditCaretLine> lines,
    in Span<EditBoxCaretStop> stops,
    in usize activeCaret,
    in Rect caret,
    in b8 down,
    in f32 preferredX,
    in f32 viewportHeight
){
    const Expected<EditBoxCaretStop> current = TryFindEditCaretStopByCommittedByte(stops, activeCaret);
    if(lines.empty() || !current.has_value() || cast<usize>(current.value().lineIndex) >= lines.size())
        return makeUnexpected(Failure());
    const f64 center = cast<f64>(caret.y) + (cast<f64>(caret.height) * s_RectCenterFractionF64);
    const f64 pageStep = cast<f64>(viewportHeight);
    f64 target = center - pageStep;
    if(down)
        target = center + pageStep;
    const EditCaretLine first = lines[0u];
    const EditCaretLine last = lines[lines.size() - 1u];
    const f64 minimum = cast<f64>(first.top) + (cast<f64>(first.height) * s_RectCenterFractionF64);
    const f64 maximum = cast<f64>(last.top) + (cast<f64>(last.height) * s_RectCenterFractionF64);
    if(!isFinite(target) || !isFinite(minimum) || !isFinite(maximum) || minimum > maximum)
        return makeUnexpected(Failure());
    const Point point(preferredX, cast<f32>(clamp(target, minimum, maximum)));
    if(!isFinite(point.y))
        return makeUnexpected(Failure());
    const Expected<usize> result = HitEditCaretGeometry(lines, stops, point);
    if(!result.has_value())
        return makeUnexpected(Failure());
    const Expected<EditBoxCaretStop> resolved = TryFindEditCaretStopByCommittedByte(stops, result.value());
    if(!resolved.has_value() || cast<usize>(resolved.value().lineIndex) >= lines.size())
        return makeUnexpected(Failure());
    // A page that cannot reach another row preserves the active caret, including a short document boundary.
    if(resolved.value().lineIndex == current.value().lineIndex)
        return activeCaret;
    return result.value();
}

usize LowerBoundEditClusterByEnd(in Span<TextCluster> clusters, in usize beginIndex, in usize endIndex, in usize byte){
    usize first = beginIndex;
    usize count = endIndex - beginIndex;
    while(count > 0u){
        const usize step = count / 2u;
        const usize mid = first + step;
        if(cast<usize>(clusters[mid].byteEnd) < byte){
            first = mid + 1u;
            count -= step + 1u;
        }
        else{
            count = step;
        }
    }
    return first;
}

u32 LineForEditCaretByte(in Span<TextLine> lines, in usize byte){
    usize first = 0u;
    usize count = lines.size();
    while(count > 0u){
        const usize step = count / 2u;
        const usize mid = first + step;
        if(cast<usize>(lines[mid].byteBegin) <= byte){
            first = mid + 1u;
            count -= step + 1u;
        }
        else{
            count = step;
        }
    }
    return cast<u32>(first - 1u);
}

b8 ValidateEditCaretLayout(
    in StringView text,
    in Span<TextLine> lines,
    in Span<TextCluster> clusters,
    in usize glyphCount,
    in Point measure,
    in Rect ink,
    in EditTextMode mode
){
    if(
        lines.empty() || lines.size() > s_TextMaxBytes + 1u || clusters.size() > s_TextMaxBytes
        || glyphCount > s_TextMaxBytes || (mode == EditTextMode::SingleLine && lines.size() != 1u)
        || !isFinite(measure.x) || !isFinite(measure.y) || measure.x < 0.0f || measure.y <= 0.0f
        || !isFinite(ink.x) || !isFinite(ink.y) || !isFinite(ink.width) || !isFinite(ink.height)
        || ink.width < 0.0f || ink.height < 0.0f
    )
        return false;
    usize previousBreak = 0u;
    usize nextCluster = 0u;
    usize nextGlyph = 0u;
    f32 previousBottom = 0.0f;
    f32 maximumAdvance = 0.0f;
    for(usize lineIndex = 0u; lineIndex < lines.size(); ++lineIndex){
        const TextLine line = lines[lineIndex];
        const usize lineByteBegin = cast<usize>(line.byteBegin);
        const usize lineByteEnd = cast<usize>(line.byteEnd);
        const usize lineBreakEnd = cast<usize>(line.breakEnd);
        const usize lineFirstCluster = cast<usize>(line.firstCluster);
        const usize lineFirstGlyph = cast<usize>(line.firstGlyph);
        const usize lineClusterCount = cast<usize>(line.clusterCount);
        const usize lineGlyphCount = cast<usize>(line.glyphCount);
        if(
            lineByteBegin != previousBreak || lineByteEnd < lineByteBegin || lineBreakEnd < lineByteEnd
            || lineBreakEnd > text.size() || lineFirstCluster != nextCluster || lineFirstGlyph != nextGlyph
            || lineClusterCount > clusters.size() - nextCluster || lineGlyphCount > glyphCount - nextGlyph
            || !isFinite(line.top) || !isFinite(line.height) || !isFinite(line.advance) || !isFinite(line.baseline)
            || line.top != previousBottom || line.height <= 0.0f || line.advance < 0.0f
        )
            return false;
        const f32 bottom = line.top + line.height;
        if(!isFinite(bottom) || line.baseline < line.top || line.baseline > bottom)
            return false;
        for(usize byte = lineByteBegin; byte < lineByteEnd; ++byte){
            if(text[byte] == '\n')
                return false;
        }
        const b8 lastLine = lineIndex + 1u == lines.size();
        if(lastLine){
            if(lineByteEnd != text.size() || lineBreakEnd != lineByteEnd)
                return false;
        }
        else if(lineByteEnd == text.size() || text[lineByteEnd] != '\n' || lineBreakEnd != lineByteEnd + 1u)
            return false;
        usize coveredByte = lineByteBegin;
        const usize glyphEnd = nextGlyph + lineGlyphCount;
        const usize clusterEnd = nextCluster + lineClusterCount;
        f32 previousX = 0.0f;
        while(nextCluster < clusterEnd){
            const TextCluster cluster = clusters[nextCluster];
            const usize clusterByteBegin = cast<usize>(cluster.byteBegin);
            const usize clusterByteEnd = cast<usize>(cluster.byteEnd);
            const usize clusterFirstGlyph = cast<usize>(cluster.firstGlyph);
            const usize clusterGlyphCount = cast<usize>(cluster.glyphCount);
            if(
                cast<usize>(cluster.lineIndex) != lineIndex || clusterByteBegin != coveredByte
                || clusterByteEnd <= clusterByteBegin || clusterByteEnd > lineByteEnd
                || !IsUtf8ScalarBoundary(text, clusterByteBegin)
                || !IsUtf8ScalarBoundary(text, clusterByteEnd)
                || clusterFirstGlyph != nextGlyph || clusterGlyphCount == 0u || clusterGlyphCount > glyphEnd - nextGlyph
                || !isFinite(cluster.leadingX) || !isFinite(cluster.trailingX)
                || cluster.leadingX != previousX || cluster.trailingX < cluster.leadingX || cluster.trailingX > line.advance
            )
                return false;
            nextGlyph += clusterGlyphCount;
            coveredByte = clusterByteEnd;
            previousX = cluster.trailingX;
            ++nextCluster;
        }
        if(coveredByte != lineByteEnd || nextGlyph != glyphEnd || previousX != line.advance)
            return false;
        previousBreak = lineBreakEnd;
        previousBottom = bottom;
        maximumAdvance = max(maximumAdvance, line.advance);
    }
    return nextCluster == clusters.size() && nextGlyph == glyphCount && measure.x == maximumAdvance && measure.y == previousBottom;
}

b8 IsValidEditCaretClusterGlyph(in u32 glyphByteBegin, in u32 glyphByteEnd, in Point glyphPosition, in TextCluster cluster){
    return glyphByteBegin == cluster.byteBegin && glyphByteEnd == cluster.byteEnd && isFinite(glyphPosition.x) && isFinite(glyphPosition.y);
}

b8 ValidateEditCaretAdoptionRequest(
    in StringView layoutText,
    in f32 layoutFontSize,
    in Span<TextLine> lines,
    in Span<TextCluster> clusters,
    in usize glyphCount,
    in Point measure,
    in Rect ink,
    in StringView expectedText,
    in Span<EditCaretMapping> mapping,
    in usize committedBytes,
    in EditTextMode mode
){
    if(
        layoutText != expectedText || (mode != EditTextMode::SingleLine && mode != EditTextMode::Multiline)
        || expectedText.size() > s_TextMaxBytes || committedBytes > s_TextMaxBytes
        || mapping.empty() || mapping.size() > committedBytes + s_EditCaretMaxExtraMappingStops
        || mapping[0u].committedByte != 0u || mapping[0u].displayByte != 0u
        || mapping[mapping.size() - 1u].committedByte != committedBytes || mapping[mapping.size() - 1u].displayByte != expectedText.size()
    )
        return false;
    if(mode == EditTextMode::Multiline && !ValidateMultilineText(expectedText))
        return false;
    ShapeRequest request;
    request.text = expectedText;
    request.fontSize = layoutFontSize;
    return ValidateTextRequest(request, mode == EditTextMode::Multiline) == TextLayoutStatus::Success
        && ValidateEditCaretLayout(layoutText, lines, clusters, glyphCount, measure, ink, mode);
}

Expected<Rect> ResolveEditCaretRect(
    in StringView text,
    in Span<TextLine> lines,
    in Span<TextCluster> clusters,
    in Span<usize> boundaries,
    in usize byte
){
    if(lines.empty() || !IsUtf8ScalarBoundary(text, byte))
        return makeUnexpected(Failure());
    const TextLine line = lines[cast<usize>(LineForEditCaretByte(lines, byte))];
    if(byte < cast<usize>(line.byteBegin) || byte > cast<usize>(line.byteEnd))
        return makeUnexpected(Failure());
    f32 x = 0.0f;
    if(line.clusterCount != 0u){
        const usize firstCluster = cast<usize>(line.firstCluster);
        const usize lastCluster = firstCluster + cast<usize>(line.clusterCount);
        const usize clusterIndex = LowerBoundEditClusterByEnd(clusters, firstCluster, lastCluster, byte);
        if(clusterIndex == lastCluster || byte < cast<usize>(clusters[clusterIndex].byteBegin))
            return makeUnexpected(Failure());
        const TextCluster cluster = clusters[clusterIndex];
        const usize clusterBegin = cast<usize>(cluster.byteBegin);
        const usize clusterEnd = cast<usize>(cluster.byteEnd);
        if(byte == clusterBegin || byte == clusterEnd){
            if(byte == clusterBegin)
                x = cluster.leadingX;
            else
                x = cluster.trailingX;
        }
        else{
            usize first = lowerBoundIndex(boundaries, clusterBegin);
            if(first != boundaries.size() && boundaries[first] == clusterBegin)
                ++first;
            const usize last = first + lowerBoundIndex(boundaries.subspan(first, boundaries.size() - first), clusterEnd);
            const usize next = first + lowerBoundIndex(boundaries.subspan(first, last - first), byte);
            const usize intervals = (last - first) + 1u;
            f32 ordinal = cast<f32>(next - first);
            if(next != last && boundaries[next] == byte)
                ordinal += 1.0f;
            else{
                usize begin = clusterBegin;
                if(next != first)
                    begin = boundaries[next - 1u];
                usize end = clusterEnd;
                if(next != last)
                    end = boundaries[next];
                ordinal += ComputeEditScalarFraction(text, begin, end, byte);
            }
            const f32 span = cluster.trailingX - cluster.leadingX;
            x = cluster.leadingX + ((span * ordinal) / cast<f32>(intervals));
        }
    }
    if(!isFinite(x))
        return makeUnexpected(Failure());
    return Rect(x, line.top, 0.0f, line.height);
}

EditCaretLine MakeEditCaretLine(in TextLine line){
    EditCaretLine caretLine;
    caretLine.byteBegin = cast<usize>(line.byteBegin);
    caretLine.byteEnd = cast<usize>(line.byteEnd);
    caretLine.breakEnd = cast<usize>(line.breakEnd);
    caretLine.firstStop = 0u;
    caretLine.stopCount = 0u;
    caretLine.top = line.top;
    caretLine.height = line.height;
    caretLine.advance = line.advance;
    return caretLine;
}

Expected<EditBoxCaretStop> TryMakeEditCaretStop(
    in StringView expectedText,
    in Span<TextLine> textLines,
    in Span<TextCluster> clusters,
    in Span<usize> boundaries,
    in usize committedBytes,
    in EditCaretMapping item,
    mut usize inOutPreviousCommitted,
    mut usize inOutPreviousDisplay
){
    if(item.committedByte < inOutPreviousCommitted || item.committedByte > committedBytes || item.displayByte < inOutPreviousDisplay || item.displayByte > expectedText.size())
        return makeUnexpected(Failure());
    const Expected<Rect> caret = ResolveEditCaretRect(expectedText, textLines, clusters, boundaries, item.displayByte);
    if(!caret.has_value())
        return makeUnexpected(Failure());
    const u32 lineIndex = LineForEditCaretByte(textLines, item.displayByte);
    EditBoxCaretStop stop;
    stop.committedByte = item.committedByte;
    stop.displayByte = item.displayByte;
    stop.x = caret.value().x;
    stop.lineIndex = lineIndex;
    inOutPreviousCommitted = item.committedByte;
    inOutPreviousDisplay = item.displayByte;
    return stop;
}

Expected<usize> ResolveEditCaretVerticalTarget(
    in StringView text,
    in Span<TextLine> textLines,
    in Span<TextCluster> clusters,
    in Span<usize> boundaries,
    in Span<EditCaretLine> caretLines,
    in Span<EditBoxCaretStop> stops,
    in usize displayCaret,
    in b8 down,
    in f32 preferredX
){
    if(!isFinite(preferredX))
        return makeUnexpected(Failure());
    const Expected<Rect> caret = ResolveEditCaretRect(text, textLines, clusters, boundaries, displayCaret);
    if(!caret.has_value())
        return makeUnexpected(Failure());
    const u32 current = LineForEditCaretByte(textLines, displayCaret);
    u32 target = 0u;
    if(down)
        target = min(current + 1u, cast<u32>(caretLines.size() - 1u));
    else if(current != 0u)
        target = current - 1u;
    if(target == current){
        for(usize i = 0u; i < stops.size(); ++i){
            if(stops[i].displayByte == displayCaret)
                return stops[i].committedByte;
        }
        const f32 center = caret.value().y + (caret.value().height * s_RectCenterFraction);
        return TryFindNearestEditCaretStop(caretLines, stops, current, Point(caret.value().x, center));
    }
    const EditCaretLine line = caretLines[cast<usize>(target)];
    const f32 center = line.top + (line.height * s_RectCenterFraction);
    return TryFindNearestEditCaretStop(caretLines, stops, target, Point(preferredX, center));
}

Expected<Rect> ResolveEditCaretRangeOnLine(
    in StringView text,
    in Span<TextLine> textLines,
    in Span<TextCluster> clusters,
    in Span<usize> boundaries,
    in Span<EditCaretLine> caretLines,
    in EditBoxRange range,
    in u32 lineIndex,
    in f32 breakWidth
){
    if(
        cast<usize>(lineIndex) >= caretLines.size() || range.begin > range.end || range.end > text.size()
        || !isFinite(breakWidth) || breakWidth < 0.0f
        || !IsUtf8ScalarBoundary(text, range.begin)
        || !IsUtf8ScalarBoundary(text, range.end)
    )
        return makeUnexpected(Failure());
    if(range.begin == range.end)
        return Rect();
    const EditCaretLine line = caretLines[cast<usize>(lineIndex)];
    const usize begin = max(range.begin, line.byteBegin);
    const usize end = min(range.end, line.byteEnd);
    const b8 selectedBreak = line.breakEnd != line.byteEnd && range.begin <= line.byteEnd && range.end > line.byteEnd;
    if(begin >= end && !selectedBreak)
        return Rect();
    const Expected<Rect> first = ResolveEditCaretRect(text, textLines, clusters, boundaries, begin);
    if(!first.has_value())
        return makeUnexpected(Failure());
    const Expected<Rect> last = ResolveEditCaretRect(text, textLines, clusters, boundaries, end);
    if(!last.has_value())
        return makeUnexpected(Failure());
    const f32 firstX = first.value().x;
    f32 breakCap = 0.0f;
    if(selectedBreak)
        breakCap = breakWidth;
    const f32 width = max(0.0f, last.value().x - firstX) + breakCap;
    if(!isFinite(width) || !isFinite(firstX + width))
        return makeUnexpected(Failure());
    return Rect(firstX, line.top, width, line.height);
}

Expected<Rect> TryComputeEditBoxViewport(in Rect bounds, in Insets padding, in Rect clip, in Point previousScroll, in f32 caretWidth){
    if(!IsValidUiRect(bounds) || !IsValidUiRect(clip) || !IsValidUiPadding(padding) || !IsValidUiExtent(previousScroll) || !isFinite(caretWidth) || caretWidth <= 0.0f)
        return makeUnexpected(Failure());
    const f32 firstX = bounds.x + min(padding.left, bounds.width);
    const f32 firstY = bounds.y + min(padding.top, bounds.height);
    const f32 lastX = (bounds.x + bounds.width) - min(padding.right, bounds.width);
    const f32 lastY = (bounds.y + bounds.height) - min(padding.bottom, bounds.height);
    return Rect(firstX, firstY, max(lastX, firstX) - firstX, max(lastY, firstY) - firstY);
}

b8 ValidateEditBoxViewportArrangeInputs(in Rect bounds, in Rect viewport, in Rect clip, in Point previousScroll, in f32 caretWidth){
    if(!IsValidUiRect(bounds) || !IsValidUiRect(viewport) || !IsValidUiRect(clip) || viewport.x < bounds.x || viewport.y < bounds.y)
        return false;
    const f32x4 end = f32x4(viewport.x, viewport.y, bounds.x, bounds.y) + f32x4(viewport.width, viewport.height, bounds.width, bounds.height);
    return end.x <= end.z && end.y <= end.w && IsValidUiExtent(previousScroll) && isFinite(caretWidth) && caretWidth > 0.0f;
}

Expected<EditBoxPlacement> TryComputeEditBoxViewportPlacement(
    in Rect bounds,
    in Rect viewport,
    in Rect clip,
    in Point previousScroll,
    in f32 caretWidth,
    in b8 revealCaret,
    in EditTextMode textMode,
    in Rect visualBounds,
    in Point logicalSize,
    in Rect caretRect
){
    EditBoxPlacement placement;
    placement.bounds = bounds;
    placement.frameClip = IntersectUiRectsBounds(bounds, clip);
    placement.content = viewport;
    placement.clip = IntersectUiRectsBounds(viewport, clip);
    const f32 left = viewport.x;
    const f32 top = viewport.y;
    const f32 overhangX = max(0.0f, (visualBounds.x + visualBounds.width) - logicalSize.x);
    const f32 maximumScroll = max(0.0f, (visualBounds.width + caretWidth) - placement.content.width);
    // Scroll offsets start at the visual envelope; reveal its overhang with the logical caret at either text edge.
    const f32 caretEndX = ((caretRect.x - visualBounds.x) + caretWidth) + overhangX;
    if(!isFinite(maximumScroll) || !isFinite(caretEndX))
        return makeUnexpected(Failure());
    f32 scrollX = 0.0f;
    if(previousScroll.x > 0.0f)
        scrollX = min(maximumScroll, previousScroll.x);
    if(revealCaret && caretRect.x < scrollX)
        scrollX = caretRect.x;
    if(revealCaret && caretEndX > scrollX + placement.content.width)
        scrollX = caretEndX - placement.content.width;
    if(scrollX > 0.0f)
        scrollX = min(maximumScroll, scrollX);
    else
        scrollX = 0.0f;
    placement.scroll = scrollX;
    if(textMode == EditTextMode::Multiline){
        const f32 overhangY = max(0.0f, (visualBounds.y + visualBounds.height) - logicalSize.y);
        const f32 maximumScrollY = max(0.0f, visualBounds.height - placement.content.height);
        const f32 caretEndY = ((caretRect.y - visualBounds.y) + caretRect.height) + overhangY;
        if(!isFinite(maximumScrollY) || !isFinite(caretEndY))
            return makeUnexpected(Failure());
        f32 scrollY = 0.0f;
        if(previousScroll.y > 0.0f)
            scrollY = min(maximumScrollY, previousScroll.y);
        if(revealCaret && caretRect.y < scrollY)
            scrollY = caretRect.y;
        if(revealCaret && caretEndY > scrollY + placement.content.height)
            scrollY = caretEndY - placement.content.height;
        if(scrollY > 0.0f)
            scrollY = min(maximumScrollY, scrollY);
        else
            scrollY = 0.0f;
        placement.scrollY = scrollY;
        placement.textOrigin = Point((left - visualBounds.x) - scrollX, (top - visualBounds.y) - scrollY);
    }
    else{
        const f32 verticalOffset = max(0.0f, (placement.content.height - visualBounds.height) * s_RectCenterFraction);
        placement.textOrigin = Point((left - visualBounds.x) - placement.scroll, (top - visualBounds.y) + verticalOffset);
    }
    placement.caret = Rect(placement.textOrigin.x + caretRect.x, placement.textOrigin.y + caretRect.y, caretWidth, caretRect.height);
    return placement;
}

b8 ValidateEditBoxArrangedSegments(in EditBoxPlacement placement, in f32 caretWidth, in Rect selectionIn, in Rect preeditUnderlineIn, in b8 composing){
    Rect selection = selectionIn;
    Rect preeditUnderline = preeditUnderlineIn;
    if(selection.width > 0.0f){
        selection.x += placement.textOrigin.x;
        selection.y += placement.textOrigin.y;
    }
    if(composing)
        PlaceEditPreeditUnderline(placement.textOrigin, caretWidth, preeditUnderline);
    return IsValidUiRect(placement.caret) && IsValidUiRect(selection) && IsValidUiRect(preeditUnderline) && isFinite(placement.textOrigin.x) && isFinite(placement.textOrigin.y);
}

b8 IsValidEditBoxPaintStyle(in EditBoxStyle style){
    return IsValidPaintColor(style.background)
        && IsValidPaintColor(style.text)
        && IsValidPaintColor(style.disabledText)
        && IsValidPaintColor(style.selection)
        && IsValidPaintColor(style.inactiveSelection)
        && IsValidPaintColor(style.caret)
        && IsValidPaintColor(style.preedit);
}

Name ResolvePreferredEditBoxBackgroundName(in EditBoxStyle style, in EditBoxPaintFlags flags){
    if(!flags.enabled)
        return style.disabled;
    if(flags.focused)
        return style.focused;
    if(flags.hovered)
        return style.hover;
    return style.normal;
}

Expected<b8> ValidateTextAreaNavigationInputs(
    in EditTextMode textMode,
    in b8 compositionActive,
    in EditNavigationDirection direction,
    in f32 fontSize,
    in f32 viewportHeight,
    in EditNavigationSnapshot preferred
){
    const b8 page = direction == EditNavigationDirection::PageUp || direction == EditNavigationDirection::PageDown;
    if(
        textMode != EditTextMode::Multiline
        || compositionActive
        || cast<u8>(direction) > cast<u8>(EditNavigationDirection::PageDown)
        || !isFinite(fontSize)
        || fontSize <= 0.0f
        || !isFinite(viewportHeight)
        || viewportHeight < 0.0f
        || (page && viewportHeight == 0.0f)
        || !isFinite(preferred.preferredX)
    )
        return makeUnexpected(Failure());
    return page;
}

Expected<f32> TryResolveTextAreaPreferredX(in EditNavigationSnapshot preferred, in Rect caret){
    f32 outPreferredX = caret.x;
    if(preferred.valid)
        outPreferredX = preferred.preferredX;
    if(!isFinite(outPreferredX))
        return makeUnexpected(Failure());
    return outPreferredX;
}

b8 TryResolveEditBoxSnapshotSizes(
    in usize committedBytes,
    in EditCompositionView composition,
    mut usize outReplaced,
    mut usize outPreeditBytes,
    mut usize outDisplayBytes
){
    outReplaced = 0u;
    outPreeditBytes = 0u;
    outDisplayBytes = 0u;
    if(composition.active){
        outReplaced = composition.replacementEnd - composition.replacementStart;
        outPreeditBytes = composition.text.size();
    }
    if(committedBytes > s_TextMaxBytes || outPreeditBytes > s_TextMaxBytes - (committedBytes - outReplaced))
        return false;
    outDisplayBytes = (committedBytes - outReplaced) + outPreeditBytes;
    return true;
}

b8 ValidateEditBoxDisplayText(in StringView candidateText, in EditTextMode textMode){
    return ValidateEditTextForMode(candidateText, textMode);
}

EditCaretMapping MakeEditCaretMapping(in usize committedByte, in usize displayByte){
    EditCaretMapping item;
    item.committedByte = committedByte;
    item.displayByte = displayByte;
    return item;
}

b8 BuildEditBoxSnapshotInto(
    in StringView committed,
    in Span<usize> graphemeBoundaries,
    in EditCompositionView composition,
    in EditTextMode textMode,
    mut String outDisplay,
    mut Vector<EditCaretMapping> outStops,
    mut usize outPreeditBytes
){
    usize replaced = 0u;
    usize preeditBytes = 0u;
    usize displayBytes = 0u;
    if(!TryResolveEditBoxSnapshotSizes(committed.size(), composition, replaced, preeditBytes, displayBytes))
        return false;
    outDisplay.clear();
    outDisplay.reserve(displayBytes);
    if(composition.active){
        outDisplay.append(committed.substr(0u, composition.replacementStart));
        if(preeditBytes != 0u)
            outDisplay.append(composition.text.substr(0u, preeditBytes));
        outDisplay.append(committed.substr(composition.replacementEnd, committed.size() - composition.replacementEnd));
    }
    else if(!committed.empty())
        outDisplay.assign(committed);
    if(!ValidateEditBoxDisplayText(outDisplay, textMode))
        return false;
    outStops.clear();
    outStops.reserve(graphemeBoundaries.size() + 1u);
    for(in usize boundary : graphemeBoundaries){
        if(!composition.active || boundary <= composition.replacementStart)
            outStops.push_back(MakeEditCaretMapping(boundary, boundary));
        if(composition.active && boundary >= composition.replacementEnd)
            outStops.push_back(MakeEditCaretMapping(boundary, boundary - replaced + preeditBytes));
    }
    outPreeditBytes = preeditBytes;
    return true;
}

b8 BuildEditCaretStopsAndLinesInto(
    in StringView expectedText,
    in Span<TextLine> textLines,
    in Span<TextCluster> clusters,
    in Span<usize> boundaries,
    in usize committedBytes,
    in Span<EditCaretMapping> mapping,
    mut Vector<EditBoxCaretStop> outStops,
    mut Vector<EditCaretLine> outLines
){
    outStops.clear();
    outLines.clear();
    outStops.reserve(mapping.size());
    outLines.reserve(textLines.size());
    for(in TextLine line : textLines)
        outLines.push_back(MakeEditCaretLine(line));
    usize previousCommitted = 0u;
    usize previousDisplay = 0u;
    for(in EditCaretMapping item : mapping){
        const Expected<EditBoxCaretStop> stop = TryMakeEditCaretStop(expectedText, textLines, clusters, boundaries, committedBytes, item, previousCommitted, previousDisplay);
        if(!stop.has_value())
            return false;
        outStops.push_back(stop.value());
        ++outLines[cast<usize>(stop.value().lineIndex)].stopCount;
    }
    u32 firstStop = 0u;
    for(mut EditCaretLine line : outLines){
        line.firstStop = firstStop;
        firstStop += line.stopCount;
    }
    return true;
}

void ResolveEditBoxSnapshotRanges(
    in EditCompositionView composition,
    in usize preeditBytes,
    in usize modelSelectionStart,
    in usize modelSelectionEnd,
    in usize modelCaret,
    mut EditBoxRange outPreedit,
    mut EditBoxRange outReplacement,
    mut EditBoxRange outSelection,
    mut usize outCaret
){
    outPreedit = EditBoxRange();
    outReplacement = EditBoxRange();
    outSelection = EditBoxRange();
    outCaret = modelCaret;
    if(composition.active){
        outPreedit.begin = composition.replacementStart;
        outPreedit.end = composition.replacementStart + preeditBytes;
        outReplacement.begin = composition.replacementStart;
        outReplacement.end = composition.replacementEnd;
        outSelection.begin = outPreedit.begin + min(composition.anchor, composition.caret);
        outSelection.end = outPreedit.begin + max(composition.anchor, composition.caret);
        outCaret = outPreedit.begin + composition.caret;
    }
    else{
        outSelection.begin = modelSelectionStart;
        outSelection.end = modelSelectionEnd;
    }
}

b8 ShouldPaintEditBoxCaret(in EditBoxPaintFlags flags, in b8 composing){
    if(!flags.focused || !flags.enabled || flags.readOnly)
        return false;
    if(composing)
        return flags.preeditCaretVisible;
    return flags.caretVisible;
}

void OffsetEditBoxSegmentOrigin(in Point textOrigin, mut Rect inOutSegment){
    inOutSegment.x += textOrigin.x;
    inOutSegment.y += textOrigin.y;
}


