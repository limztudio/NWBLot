////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<b8> MeshSkinningSystem::ensureRuntimeResources(MeshSkinningRuntimeInstance& instance, Core::Alloc::ScratchArena& scratchArena){
    const b8 hasSkinPayload = !instance.skin.empty();
    if(!ValidateMeshSkinningRuntimeResourceCounts(instance.handle.value, instance.skin.size(), instance.skeletonJointCount))
        return MakeUnexpected(Failure{});

    MeshSkinningResourceBuffers buffers = CaptureMeshSkinningResourceBuffers(instance);
    auto [it, inserted] = m_runtimeResources.try_emplace(instance.handle.value);
    RuntimeResources& resources = it.value();
    const u32 positionCount = instance.meshletPositionRefCount;
    const u32 attributeCount = instance.meshletAttributeRefCount;
    const u32 meshletCount = static_cast<u32>(instance.meshlets.size());
    const u32 skinCount = static_cast<u32>(instance.skin.size());
    const u32 jointCount = hasSkinPayload ? instance.skeletonJointCount : 0u;
    const b8 rebuild = NeedsMeshSkinningRuntimeResourcesRebuild(
        inserted,
        resources.buffers == buffers,
        resources.editRevision,
        instance.editRevision,
        resources.positionCount,
        positionCount,
        resources.attributeCount,
        attributeCount,
        resources.meshletCount,
        meshletCount,
        resources.skinCount,
        skinCount,
        resources.jointCount,
        jointCount,
        resources.hasPersistentHeapDescriptors(hasSkinPayload, instance.attributeBuffer != nullptr),
        hasSkinPayload,
        resources.skinBuffer != nullptr && resources.jointPaletteBuffer != nullptr
    );
    if(!rebuild)
        return false;

    class UnpublishedRuntimeDescriptors final : NoCopy{
    public:
        UnpublishedRuntimeDescriptors(MeshSkinningSystem& system, RuntimeResources& resources)noexcept
            : m_system(system)
            , m_resources(resources)
        {}
        ~UnpublishedRuntimeDescriptors()noexcept(noexcept(DeclVal<MeshSkinningSystem&>().releaseRuntimeResourceBindlessHeapHandles(DeclVal<RuntimeResources&>()))){
            if(m_active)
                m_system.releaseRuntimeResourceBindlessHeapHandles(m_resources);
        }


    public:
        void release()noexcept{ m_active = false; }


    private:
        MeshSkinningSystem& m_system;
        RuntimeResources& m_resources;
        b8 m_active = true;
    };

    RuntimeResources rebuilt;
    UnpublishedRuntimeDescriptors retireRebuilt(*this, rebuilt);
    rebuilt.handle = instance.handle;
    rebuilt.buffers = Move(buffers);
    rebuilt.editRevision = instance.editRevision;
    rebuilt.positionCount = positionCount;
    rebuilt.attributeCount = attributeCount;
    rebuilt.meshletCount = meshletCount;
    rebuilt.skinCount = skinCount;
    rebuilt.jointCount = jointCount;

    if(hasSkinPayload){
        const auto skinInfluences = MeshSkinningPayload::BuildSkinInfluences(instance, scratchArena);
        if(!skinInfluences)
            return MakeUnexpected(Failure{});

        const auto skinBufferName = DeriveRuntimeResourceName(instance.sourceName, instance.handle.value, instance.editRevision, s_SkinBufferSuffix);
        const auto jointPaletteBufferName = DeriveRuntimeResourceName(instance.sourceName, instance.handle.value, instance.editRevision, s_JointPaletteBufferSuffix);
        if(!skinBufferName || !jointPaletteBufferName){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningSystem: failed to derive skinning buffer names for runtime mesh '{}'"), instance.handle.value);
            return MakeUnexpected(Failure{});
        }

        auto skinBufferResult = __hidden_resources::SetupStructuredBuffer<MeshSkinningInfluenceGpu>(m_graphics, skinBufferName, *skinInfluences, FOUNDATION_TEXT("skin influence"));
        if(!skinBufferResult){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningSystem: failed to create skin buffer for runtime mesh '{}'"), instance.handle.value);
            return MakeUnexpected(Failure{});
        }
        rebuilt.skinBuffer = Move(*skinBufferResult);

        // Live pose data arrives from the graph after ECS updates; setup owns only the Skin-sized storage.
        Core::BufferDesc jointPaletteBufferDesc;
        jointPaletteBufferDesc
            .setByteSize(static_cast<u64>(jointCount) * sizeof(SkeletonJointMatrix))
            .setStructStride(sizeof(SkeletonJointMatrix))
            .setQueueSharing(Core::ResourceQueueSharing::GraphicsAndAsyncCompute)
            .setDebugName(jointPaletteBufferName)
            .setInitialState(Core::ResourceStates::Common)
        ;
        auto jointPaletteBufferResult = m_graphics.createBuffer(jointPaletteBufferDesc);
        if(!jointPaletteBufferResult){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningSystem: failed to create joint palette buffer for runtime mesh '{}'"), instance.handle.value);
            return MakeUnexpected(Failure{});
        }
        rebuilt.jointPaletteBuffer = Move(*jointPaletteBufferResult);
    }

    const auto bindlessSlotsBufferName = DeriveRuntimeResourceName(instance.sourceName, instance.handle.value, instance.editRevision, s_BindlessSlotsBufferSuffix);
    if(!bindlessSlotsBufferName){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningSystem: failed to derive bindless slot buffer name for runtime mesh '{}'"), instance.handle.value);
        return MakeUnexpected(Failure{});
    }
    Core::BufferDesc bindlessSlotsBufferDesc;
    bindlessSlotsBufferDesc
        .setByteSize(sizeof(MeshSkinningBindlessResourceSlots))
        .setIsConstantBuffer(true)
        .setQueueSharing(Core::ResourceQueueSharing::GraphicsAndAsyncCompute)
        .setDebugName(bindlessSlotsBufferName)
        .enableAutomaticStateTracking(Core::ResourceStates::Common)
    ;
    auto bindlessResourceSlotsBufferResult = m_graphics.createBuffer(bindlessSlotsBufferDesc);
    if(bindlessResourceSlotsBufferResult)
        rebuilt.bindlessResourceSlotsBuffer = Move(*bindlessResourceSlotsBufferResult);
    else
        rebuilt.bindlessResourceSlotsBuffer.reset();
    if(!bindlessResourceSlotsBufferResult){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningSystem: failed to create bindless slot buffer for runtime mesh '{}'"), instance.handle.value);
        return MakeUnexpected(Failure{});
    }

    if(!createRuntimeResourceBindlessHeapHandles(instance, rebuilt))
        return MakeUnexpected(Failure{});

    // Rebuilds allocate fresh slots; free the replaced generation before dropping its handles.
    releaseRuntimeResourceBindlessHeapHandles(resources);
    resources = Move(rebuilt);
    retireRebuilt.release();
    return true;
}

b8 MeshSkinningSystem::createRuntimeResourceBindlessHeapHandles(MeshSkinningRuntimeInstance& instance, RuntimeResources& resources){
    auto& device = m_graphics.getDevice();
    Core::GpuDescriptorHeap& heap = device.getDescriptorHeap();
    if(!heap.isInitialized()){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningSystem: runtime mesh '{}' requires the initialized global descriptor heap"), instance.handle.value);
        return false;
    }
    const auto fail = [&](){
        releaseRuntimeResourceBindlessHeapHandles(resources);
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningSystem: failed to register persistent compute buffers for runtime mesh '{}' in the descriptor heap"), instance.handle.value);
        return false;
    };
    if(!resources.bindlessResourceSlotsBuffer || !instance.hasPersistentComputeBuffers()){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningSystem: runtime mesh '{}' has incomplete persistent compute buffers"), instance.handle.value);
        return false;
    }

    const auto registerStorageSlot = [&](const RuntimeStorageDescriptorSlot::Enum slot, const Core::DescriptorWriteItem& item, u32& outSlot){
        const auto handle = __hidden_resources::RegisterStorageBuffer(heap, item);
        if(!handle)
            return false;
        resources.bindlessHeapHandles.storageBuffers[static_cast<usize>(slot)] = *handle;
        outSlot = handle->slot();
        return true;
    };

    struct StorageDescriptorBinding{
        RuntimeStorageDescriptorSlot::Enum slot;
        Core::DescriptorWriteItem item;
        u32* outSlot;
    };
    MeshSkinningBindlessResourceSlots& slots = resources.bindlessResourceSlots;
    const Array<StorageDescriptorBinding, s_RuntimeRequiredStorageDescriptorCount> requiredBindings = {{
        { RuntimeStorageDescriptorSlot::RestPosition, Core::DescriptorWriteItem::StructuredBufferSrv(0u, instance.restPositionBuffer.get()), &slots.restPosition },
        { RuntimeStorageDescriptorSlot::SkinnedPosition, Core::DescriptorWriteItem::StructuredBufferUav(0u, instance.skinnedPositionBuffer.get()), &slots.skinnedPosition },
        { RuntimeStorageDescriptorSlot::RestNormal, Core::DescriptorWriteItem::StructuredBufferSrv(0u, instance.restNormalBuffer.get()), &slots.restNormal },
        { RuntimeStorageDescriptorSlot::SkinnedNormal, Core::DescriptorWriteItem::StructuredBufferUav(0u, instance.skinnedNormalBuffer.get()), &slots.skinnedNormal },
        { RuntimeStorageDescriptorSlot::RestTangent, Core::DescriptorWriteItem::StructuredBufferSrv(0u, instance.restTangentBuffer.get()), &slots.restTangent },
        { RuntimeStorageDescriptorSlot::SkinnedTangent, Core::DescriptorWriteItem::StructuredBufferUav(0u, instance.skinnedTangentBuffer.get()), &slots.skinnedTangent },
        { RuntimeStorageDescriptorSlot::MeshletDesc, Core::DescriptorWriteItem::StructuredBufferSrv(0u, instance.meshletDescBuffer.get()), &slots.meshletDesc },
        { RuntimeStorageDescriptorSlot::PositionRefDeltas, Core::DescriptorWriteItem::RawBufferSrv(0u, instance.meshletPositionRefDeltaBuffer.get()), &slots.positionRefDeltas },
        { RuntimeStorageDescriptorSlot::AttributeRefDeltas, Core::DescriptorWriteItem::RawBufferSrv(0u, instance.meshletAttributeRefDeltaBuffer.get()), &slots.attributeRefDeltas },
        { RuntimeStorageDescriptorSlot::AttributeSkins, Core::DescriptorWriteItem::StructuredBufferSrv(0u, instance.attributeSkinBuffer.get()), &slots.attributeSkins },
        { RuntimeStorageDescriptorSlot::LocalVertexRefs, Core::DescriptorWriteItem::StructuredBufferSrv(0u, instance.meshletLocalVertexRefBuffer.get()), &slots.localVertexRefs },
        { RuntimeStorageDescriptorSlot::PrimitiveIndices, Core::DescriptorWriteItem::RawBufferSrv(0u, instance.meshletPrimitiveIndexBuffer.get()), &slots.primitiveIndices },
        { RuntimeStorageDescriptorSlot::MeshletBounds, Core::DescriptorWriteItem::RawBufferUav(0u, instance.meshletBoundsBuffer.get()), &slots.meshletBounds },
        { RuntimeStorageDescriptorSlot::MeshletLocalBounds, Core::DescriptorWriteItem::RawBufferUav(0u, instance.meshletLocalBoundsBuffer.get()), &slots.meshletLocalBounds },
        { RuntimeStorageDescriptorSlot::LocalBounds, Core::DescriptorWriteItem::RawBufferUav(0u, instance.localBoundsBuffer.get()), &slots.localBounds },
    }};
    for(const StorageDescriptorBinding& binding : requiredBindings)
        if(!registerStorageSlot(binding.slot, binding.item, *binding.outSlot))
            return fail();

    if(resources.skinCount != 0u){
        if(!resources.skinBuffer || !resources.jointPaletteBuffer){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningSystem: runtime mesh '{}' has incomplete persistent skinning payload buffers"), instance.handle.value);
            return fail();
        }
        if(
            !registerStorageSlot(RuntimeStorageDescriptorSlot::SkinInfluences, Core::DescriptorWriteItem::StructuredBufferSrv(0u, resources.skinBuffer.get()), slots.skinInfluences)
            || !registerStorageSlot(RuntimeStorageDescriptorSlot::JointPalette, Core::DescriptorWriteItem::StructuredBufferSrv(0u, resources.jointPaletteBuffer.get()), slots.jointPalette)
        )
            return fail();
    }

    if(instance.attributeBuffer && !registerStorageSlot(RuntimeStorageDescriptorSlot::AttributeBuffer, Core::DescriptorWriteItem::RawBufferUav(0u, instance.attributeBuffer.get()), slots.attributeBuffer))
        return fail();

    const auto resourceSlots = __hidden_resources::RegisterUniformBuffer(heap, *resources.bindlessResourceSlotsBuffer.get());
    if(!resourceSlots)
        return fail();
    resources.bindlessHeapHandles.resourceSlots = *resourceSlots;
    return true;
}

void MeshSkinningSystem::releaseRuntimeResourceBindlessHeapHandles(RuntimeResources& resources){
    Core::GpuDescriptorHeap& heap = m_graphics.getDevice().getDescriptorHeap();
    if(heap.isInitialized()){
        const auto release = [&](Core::GpuDescriptorHandle& handle){
            if(handle.valid())
                heap.free(handle);
            handle = Core::GpuDescriptorHandle::Invalid();
        };
        release(resources.bindlessHeapHandles.resourceSlots);
        for(Core::GpuDescriptorHandle& handle : resources.bindlessHeapHandles.storageBuffers)
            release(handle);
    }
    resources.bindlessHeapHandles = RuntimeBindlessHeapHandles{};
    resources.bindlessResourceSlots = MeshSkinningBindlessResourceSlots{};
    resources.bindlessResourceSlotsUploaded = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_runtime_cache_source{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static constexpr TStringView s_AssetLoadContext = FOUNDATION_TEXT("MeshSkinningRuntimeCache");


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] b8 BuildRuntimeZippedPayload(const Mesh& mesh, const Span<const SkinInfluence4> skinStream, Core::Alloc::ScratchArena& scratchArena, MeshSkinningRuntimeInstance& instance){
    Vector<MeshletPositionStreamRef, Core::Alloc::ScratchArena> runtimePositionRefs{scratchArena};
    Vector<MeshletAttributeStreamRef, Core::Alloc::ScratchArena> runtimeAttributeRefs{scratchArena};
    instance.meshletPositionRefDeltas.clear();
    instance.meshletAttributeRefDeltas.clear();
    instance.attributeSkins.clear();
    if(!TryDecodeRuntimeZippedMeshletStreams(
        mesh.meshlets(),
        mesh.meshletPositionRefDeltas(),
        mesh.meshletAttributeRefDeltas(),
        mesh.positionStream(),
        mesh.normalStream(),
        mesh.tangentStream(),
        mesh.uv0Stream().size(),
        mesh.colorStream().size(),
        skinStream.size(),
        instance.restPositions,
        instance.restNormals,
        instance.restTangents,
        instance.meshlets,
        runtimePositionRefs,
        runtimeAttributeRefs
    ))
        return false;

    if(!ResolveRuntimeZippedAttributeSkins(
        instance.meshlets,
        runtimePositionRefs,
        instance.meshletLocalVertexRefs,
        runtimeAttributeRefs.size(),
        instance.attributeSkins
    ))
        return false;

    if(!EncodeMeshletRefDeltas(runtimePositionRefs, runtimeAttributeRefs, true, [&](const usize meshletIndex, const TStringView reason){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningRuntimeCache: runtime meshlet {} {}"), meshletIndex, reason);
        return false;
    }, instance.meshlets, instance.meshletPositionRefDeltas, instance.meshletAttributeRefDeltas
    ))
        return false;

    instance.meshletPositionRefCount = static_cast<u32>(runtimePositionRefs.size());
    instance.meshletAttributeRefCount = static_cast<u32>(runtimeAttributeRefs.size());
    return BuildRuntimeMeshLocalBounds(instance.sourceName, instance.restPositions, instance.localBounds);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Mesh& MeshSkinningRuntimeCache::MeshSkinningSource::mesh()const noexcept{
    const auto asset = MakeNotNull(Core::Assets::CastAsset<Mesh>(meshAsset.get()));
    return *asset;
}

const Skin& MeshSkinningRuntimeCache::MeshSkinningSource::skin()const noexcept{
    const auto asset = MakeNotNull(Core::Assets::CastAsset<Skin>(skinAsset.get()));
    return *asset;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void MeshSkinningRuntimeCache::prepareResources(Core::ECS::World& world, Core::Alloc::ScratchArena& scratchArena){
    auto skinningBindingView = world.view<SkinnedMeshBindingComponent>();
    const usize rendererCandidateCount = skinningBindingView.candidateCount();
    if(rendererCandidateCount == 0u){
        clear();
        return;
    }

    m_instances.reserve(rendererCandidateCount);
    m_handleToEntity.reserve(rendererCandidateCount);
    m_sources.reserve(rendererCandidateCount);

    const b8 pruneStaleInstances = !m_instances.empty();
    skinningBindingView.each([&](Core::ECS::EntityID entity, SkinnedMeshBindingComponent& component){
        if(!ensureRuntimeMesh(entity, scratchArena, component))
            component.runtimeMesh.reset();
    });

    if(!pruneStaleInstances)
        return;

    for(auto it = m_instances.begin(); it != m_instances.end();){
        const Core::ECS::EntityID entity = it->first;
        if(world.tryGetComponent<SkinnedMeshBindingComponent>(entity)){
            ++it;
            continue;
        }

        it = eraseInstance(it);
    }
}

void MeshSkinningRuntimeCache::clear()noexcept{
    m_handleToEntity.clear();
    m_instances.clear();
    m_sources.clear();
}

const MeshSkinningRuntimeInstance* MeshSkinningRuntimeCache::findInstance(const RuntimeMeshHandle handle)const noexcept{
    const Expected<Core::ECS::EntityID> foundEntity = TryFindRuntimeMeshEntityByHandle(m_handleToEntity, handle.value);
    if(!foundEntity)
        return nullptr;

    const auto foundInstance = m_instances.find(*foundEntity);
    if(foundInstance == m_instances.end())
        return nullptr;
    return &foundInstance.value();
}

Expected<RuntimeMeshHandle> MeshSkinningRuntimeCache::allocateHandle(){
    const Expected<u64> handleValue = TryAllocateRuntimeMeshHandleValue(m_handleToEntity, m_nextHandleValue);
    if(!handleValue)
        return MakeUnexpected(Failure{});

    RuntimeMeshHandle handle;
    handle.value = *handleValue;
    return handle;
}

void MeshSkinningRuntimeCache::releaseRuntimeMesh(const Core::ECS::EntityID entity)noexcept{
    const auto foundInstance = m_instances.find(entity);
    if(foundInstance == m_instances.end())
        return;

    eraseInstance(foundInstance);
}

MeshSkinningRuntimeCache::InstanceMap::iterator MeshSkinningRuntimeCache::eraseInstance(const InstanceMap::iterator it)noexcept{
    const MeshSkinningRuntimeInstance& instance = it.value();
    m_handleToEntity.erase(instance.handle.value);
    releaseSource(instance.sourceName);
    return m_instances.erase(it);
}

void MeshSkinningRuntimeCache::releaseSource(const Name& sourceName)noexcept{
    const auto foundSource = m_sources.find(sourceName);
    if(foundSource == m_sources.end())
        return;

    MeshSkinningSource& source = foundSource.value();
    if(source.referenceCount > 0u)
        --source.referenceCount;
    if(source.referenceCount == 0u)
        m_sources.erase(foundSource);
}

void MeshSkinningRuntimeCache::eraseUnusedSource(const Name& sourceName)noexcept{
    const auto foundSource = m_sources.find(sourceName);
    if(foundSource != m_sources.end() && foundSource.value().referenceCount == 0u)
        m_sources.erase(foundSource);
}

b8 MeshSkinningRuntimeCache::ensureRuntimeMesh(Core::ECS::EntityID entity, Core::Alloc::ScratchArena& scratchArena, SkinnedMeshBindingComponent& component){
    const Name& sourceName = component.skin.name();
    if(!component.skin.valid()){
        releaseRuntimeMesh(entity);
        component.runtimeMesh.reset();
        return false;
    }

    const auto foundInstance = m_instances.find(entity);
    if(foundInstance != m_instances.end()){
        MeshSkinningRuntimeInstance& instance = foundInstance.value();
        if(instance.sourceName == sourceName){
            component.runtimeMesh = instance.handle;
            if((instance.dirtyFlags & RuntimeMeshDirtyFlag::GpuUploadDirty) != 0u){
                if(!uploadRuntimeMeshBuffers(instance, scratchArena)){
                    releaseRuntimeMesh(entity);
                    component.runtimeMesh.reset();
                    return false;
                }
                instance.dirtyFlags &= ~RuntimeMeshDirtyFlag::All;
            }
            return instance.valid();
        }

        releaseRuntimeMesh(entity);
        component.runtimeMesh.reset();
    }

    const auto sourceResult = ensureSourceLoaded(component.skin);
    if(!sourceResult)
        return false;
    MeshSkinningSource& source = **sourceResult;
    const Mesh& mesh = source.mesh();
    const Skin& skin = source.skin();

    MeshSkinningRuntimeInstance instance(m_arena);
    instance.entity = entity;
    const Expected<RuntimeMeshHandle> handleResult = allocateHandle();
    if(!handleResult){
        eraseUnusedSource(sourceName);
        return false;
    }
    instance.handle = *handleResult;
    instance.sourceName = sourceName;
    instance.uv0 = mesh.uv0Stream();
    instance.colors = mesh.colorStream();
    instance.skin = skin.influences();
    instance.skeletonJointCount = static_cast<u32>(skin.inverseBindMatrices().size());
    instance.inverseBindMatrices = skin.inverseBindMatrices();
    instance.meshletBounds = mesh.meshletBounds();
    instance.meshletLocalVertexRefs = mesh.meshletLocalVertexRefs();
    instance.meshletPrimitiveIndices = mesh.meshletPrimitiveIndices();
    instance.solidTriangleWords = mesh.solidTriangleWords();
    instance.dirtyFlags = RuntimeMeshDirtyFlag::All;
    if(!__hidden_runtime_cache_source::BuildRuntimeZippedPayload(mesh, skin.influences(), scratchArena, instance)){
        eraseUnusedSource(sourceName);
        return false;
    }

    if(!uploadRuntimeMeshBuffers(instance, scratchArena)){
        eraseUnusedSource(sourceName);
        return false;
    }
    instance.dirtyFlags &= ~RuntimeMeshDirtyFlag::All;

    if(!instance.valid()){
        eraseUnusedSource(sourceName);
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningRuntimeCache: prepared runtime mesh is incomplete"));
        return false;
    }

    const RuntimeMeshHandle handle = instance.handle;
    auto [storedInstance, instanceInserted] = m_instances.try_emplace(entity, Move(instance));
    if(!instanceInserted){
        eraseUnusedSource(sourceName);
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningRuntimeCache: runtime instance identity was already registered"));
        return false;
    }
    ScopeExit discardInstance([&]()noexcept{ m_instances.erase(storedInstance); });
    const auto [storedEntity, handleInserted] = m_handleToEntity.emplace(handle.value, entity);
    if(!handleInserted){
        m_instances.erase(storedInstance);
        discardInstance.release();
        eraseUnusedSource(sourceName);
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningRuntimeCache: runtime mesh handle was already registered"));
        return false;
    }

    ++source.referenceCount;
    component.runtimeMesh = handle;
    discardInstance.release();
    return true;
}

Expected<NotNull<MeshSkinningRuntimeCache::MeshSkinningSource*>> MeshSkinningRuntimeCache::ensureSourceLoaded(const Core::Assets::AssetRef<Skin>& skinAsset){
    FOUNDATION_ASSERT(skinAsset.valid());

    const Name& sourceName = skinAsset.name();
    const auto foundSource = m_sources.find(sourceName);
    if(foundSource != m_sources.end()){
        MeshSkinningSource& cachedSource = foundSource.value();
        return MakeNotNull(&cachedSource);
    }

    auto loadedSkinAsset = m_assetManager.loadTypedSync<Skin>(skinAsset.name(), __hidden_runtime_cache_source::s_AssetLoadContext);
    if(!loadedSkinAsset)
        return MakeUnexpected(Failure{});

    auto loadedMeshAsset = m_assetManager.loadTypedSync<Mesh>((*loadedSkinAsset)->mesh().name(), __hidden_runtime_cache_source::s_AssetLoadContext);
    if(!loadedMeshAsset)
        return MakeUnexpected(Failure{});

    MeshSkinningSource source;
    source.meshAsset = Move(*loadedMeshAsset);
    source.skinAsset = Move(*loadedSkinAsset);

    auto [stored, inserted] = m_sources.try_emplace(sourceName, Move(source));
    if(!inserted){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningRuntimeCache: source identity was already registered"));
        return MakeUnexpected(Failure{});
    }
    MeshSkinningSource& storedSource = stored.value();
    return MakeNotNull(&storedSource);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_runtime_cache_resources{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] b8 ValidateRuntimeMeshUploadPayload(const MeshSkinningRuntimeInstance& instance){
    if(!ValidateRuntimeMeshUploadPayloadStreams(
        instance.sourceName,
        instance.hasCompleteSplitMeshPayload(),
        instance.restPositions.size(),
        instance.restNormals.size(),
        instance.restTangents.size(),
        instance.uv0.size(),
        instance.colors.size(),
        instance.skin.size(),
        instance.meshlets,
        instance.meshletPositionRefDeltas,
        instance.meshletAttributeRefDeltas,
        instance.meshletLocalVertexRefs.size(),
        instance.meshletPrimitiveIndices.size(),
        instance.attributeSkins
    ))
        return false;
    // Skin::loadBinary already admitted the copied skin and inverse bind data.
    FOUNDATION_ASSERT(instance.skeletonJointCount > 0u && instance.skeletonJointCount <= static_cast<u32>(Limit<u16>::s_Max) + 1u);
    FOUNDATION_ASSERT(ValidInverseBindMatrixCount(instance.inverseBindMatrices.size(), instance.skeletonJointCount));
#if defined(NWB_DEBUG)
    for(const SkeletonJointMatrix& storedInverseBind : instance.inverseBindMatrices)
        FOUNDATION_ASSERT(MatrixIsInvertibleAffine(LoadFloat(storedInverseBind), s_SkinValidationEpsilon, s_SkinValidationEpsilon));
    for(const SkinInfluence4& skin : instance.skin)
        FOUNDATION_ASSERT(ValidSkinInfluenceWeights(LoadFloat(skin.weight)) && SkinInfluenceFitsSkeleton(skin, instance.skeletonJointCount));
#endif
    return true;
}

[[nodiscard]] b8 FinalizeRuntimeBufferUpload(
    Expected<Core::BufferHandle, BufferSetupFailure::Enum>&& buffer,
    const MeshSkinningRuntimeInstance& instance,
    const AStringView label,
    Core::BufferHandle& outBuffer
){
    if(buffer){
        outBuffer = Move(*buffer);
        return true;
    }
    outBuffer.reset();
    ReportRuntimeBufferUploadFailure(buffer.error(), label, instance.handle.value);
    return false;
}

template<typename PayloadT>
[[nodiscard]] b8 AssignRuntimeBuffer(
    const MeshSkinningRuntimeInstance& instance,
    const AStringView suffix,
    const Span<const PayloadT> payload,
    const b8 canHaveUavs,
    const AStringView label,
    Core::GraphicsRuntime& graphics,
    const b8 canHaveRawViews,
    const b8 accelStructBuildInput,
    const Core::ResourceQueueSharing::Mask queueSharing,
    const b8 isIndexBuffer,
    Core::BufferHandle& outBuffer
){
    const Name bufferName = DeriveNamedRuntimeBufferName(instance.sourceName, instance.handle.value, instance.editRevision, suffix, label);
    if(!bufferName){
        outBuffer.reset();
        return false;
    }

    auto buffer = RuntimeMeshBufferUpload::SetupRequiredBuffer<PayloadT>(graphics, bufferName, payload, { canHaveUavs, canHaveRawViews, accelStructBuildInput, queueSharing, isIndexBuffer });
    return FinalizeRuntimeBufferUpload(Move(buffer), instance, label, outBuffer);
}

[[nodiscard]] b8 AssignPaddedRawRuntimeBuffer(
    const MeshSkinningRuntimeInstance& instance,
    const AStringView suffix,
    const Span<const u8> payload,
    const b8 canHaveUavs,
    const AStringView label,
    Core::GraphicsRuntime& graphics,
    Core::Alloc::ScratchArena& scratchArena,
    Core::BufferHandle& outBuffer
){
    const Name bufferName = DeriveNamedRuntimeBufferName(instance.sourceName, instance.handle.value, instance.editRevision, suffix, label);
    if(!bufferName){
        outBuffer = nullptr;
        return false;
    }

    auto buffer = RuntimeMeshBufferUpload::SetupRequiredPaddedRawByteBuffer(graphics, scratchArena, bufferName, payload, { canHaveUavs, true, false, Core::ResourceQueueSharing::GraphicsAndAsyncCompute });
    return FinalizeRuntimeBufferUpload(Move(buffer), instance, label, outBuffer);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 MeshSkinningRuntimeCache::uploadRuntimeMeshBuffers(MeshSkinningRuntimeInstance& instance, Core::Alloc::ScratchArena& scratchArena){
    if(!__hidden_runtime_cache_resources::ValidateRuntimeMeshUploadPayload(instance))
        return false;

    const b8 rtSupported = m_graphics.queryFeatureSupport(Core::Feature::RayTracingAccelStruct);
    // Software and hybrid tails read raw position/index buffers; keep views even with HWRT.

    b8 uploaded = CreateMeshSkinningLocalBoundsBuffers(m_graphics, instance);
    uploaded = __hidden_runtime_cache_resources::AssignRuntimeBuffer<Float3U>(
        instance,
        s_RestPositionsSuffix,
        instance.restPositions,
        false,
        s_RuntimeCacheRestPositionLabel,
        m_graphics,
        false,
        false,
        Core::ResourceQueueSharing::GraphicsAndAsyncCompute,
        false,
        instance.restPositionBuffer
    ) && uploaded;
    uploaded = __hidden_runtime_cache_resources::AssignRuntimeBuffer<Half4U>(
        instance,
        s_RestNormalsSuffix,
        instance.restNormals,
        false,
        s_RuntimeCacheRestNormalLabel,
        m_graphics,
        false,
        false,
        Core::ResourceQueueSharing::GraphicsAndAsyncCompute,
        false,
        instance.restNormalBuffer
    ) && uploaded;
    uploaded = __hidden_runtime_cache_resources::AssignRuntimeBuffer<Half4U>(
        instance,
        s_RestTangentsSuffix,
        instance.restTangents,
        false,
        s_RuntimeCacheRestTangentLabel,
        m_graphics,
        false,
        false,
        Core::ResourceQueueSharing::GraphicsAndAsyncCompute,
        false,
        instance.restTangentBuffer
    ) && uploaded;
    uploaded = __hidden_runtime_cache_resources::AssignRuntimeBuffer<Float3U>(
        instance,
        s_SkinnedPositionsSuffix,
        instance.restPositions,
        true,
        s_RuntimeCacheSkinnedPositionLabel,
        m_graphics,
        true,
        rtSupported,
        Core::ResourceQueueSharing::GraphicsAndAsyncCompute,
        false,
        instance.skinnedPositionBuffer
    ) && uploaded;
    uploaded = __hidden_runtime_cache_resources::AssignRuntimeBuffer<Half4U>(
        instance,
        s_SkinnedNormalsSuffix,
        instance.restNormals,
        true,
        s_RuntimeCacheSkinnedNormalLabel,
        m_graphics,
        false,
        false,
        Core::ResourceQueueSharing::GraphicsAndAsyncCompute,
        false,
        instance.skinnedNormalBuffer
    ) && uploaded;
    uploaded = __hidden_runtime_cache_resources::AssignRuntimeBuffer<Half4U>(
        instance,
        s_SkinnedTangentsSuffix,
        instance.restTangents,
        true,
        s_RuntimeCacheSkinnedTangentLabel,
        m_graphics,
        false,
        false,
        Core::ResourceQueueSharing::GraphicsAndAsyncCompute,
        false,
        instance.skinnedTangentBuffer
    ) && uploaded;
    uploaded = __hidden_runtime_cache_resources::AssignRuntimeBuffer<Float2U>(
        instance,
        s_Uv0Suffix,
        instance.uv0,
        false,
        s_RuntimeCacheUv0Label,
        m_graphics,
        false,
        false,
        Core::ResourceQueueSharing::GraphicsAndAsyncCompute,
        false,
        instance.uv0Buffer
    ) && uploaded;
    uploaded = __hidden_runtime_cache_resources::AssignRuntimeBuffer<Half4U>(
        instance,
        s_ColorsSuffix,
        instance.colors,
        false,
        s_RuntimeCacheColorLabel,
        m_graphics,
        false,
        false,
        Core::ResourceQueueSharing::GraphicsAndAsyncCompute,
        false,
        instance.colorBuffer
    ) && uploaded;
    uploaded = __hidden_runtime_cache_resources::AssignRuntimeBuffer<MeshletDesc>(
        instance,
        s_MeshletsSuffix,
        instance.meshlets,
        false,
        s_RuntimeCacheMeshletDescriptorLabel,
        m_graphics,
        false,
        false,
        Core::ResourceQueueSharing::GraphicsAndAsyncCompute,
        false,
        instance.meshletDescBuffer
    ) && uploaded;
    uploaded = __hidden_runtime_cache_resources::AssignRuntimeBuffer<MeshletBounds>(
        instance,
        s_MeshletBoundsSuffix,
        instance.meshletBounds,
        true,
        s_RuntimeCacheMeshletBoundsLabel,
        m_graphics,
        true,
        false,
        Core::ResourceQueueSharing::GraphicsAndAsyncCompute,
        false,
        instance.meshletBoundsBuffer
    ) && uploaded;
    uploaded = __hidden_runtime_cache_resources::AssignPaddedRawRuntimeBuffer(
        instance,
        s_MeshletPositionRefDeltasSuffix,
        instance.meshletPositionRefDeltas,
        false,
        s_RuntimeCacheMeshletPositionRefDeltaLabel,
        m_graphics,
        scratchArena,
        instance.meshletPositionRefDeltaBuffer
    ) && uploaded;
    uploaded = __hidden_runtime_cache_resources::AssignPaddedRawRuntimeBuffer(
        instance,
        s_MeshletAttributeRefDeltasSuffix,
        instance.meshletAttributeRefDeltas,
        false,
        s_RuntimeCacheMeshletAttributeRefDeltaLabel,
        m_graphics,
        scratchArena,
        instance.meshletAttributeRefDeltaBuffer
    ) && uploaded;
    uploaded = __hidden_runtime_cache_resources::AssignRuntimeBuffer<MeshletLocalVertexRef>(
        instance,
        s_MeshletLocalVertexRefsSuffix,
        instance.meshletLocalVertexRefs,
        false,
        s_RuntimeCacheMeshletLocalVertexRefLabel,
        m_graphics,
        false,
        false,
        Core::ResourceQueueSharing::GraphicsAndAsyncCompute,
        false,
        instance.meshletLocalVertexRefBuffer
    ) && uploaded;
    uploaded = __hidden_runtime_cache_resources::AssignPaddedRawRuntimeBuffer(
        instance,
        s_MeshletPrimitiveIndicesSuffix,
        instance.meshletPrimitiveIndices,
        false,
        s_RuntimeCacheMeshletPrimitiveIndexLabel,
        m_graphics,
        scratchArena,
        instance.meshletPrimitiveIndexBuffer
    ) && uploaded;
    uploaded = __hidden_runtime_cache_resources::AssignRuntimeBuffer<u32>(
        instance,
        s_AttributeSkinsSuffix,
        instance.attributeSkins,
        false,
        s_RuntimeCacheAttributeSkinLabel,
        m_graphics,
        false,
        false,
        Core::ResourceQueueSharing::GraphicsAndAsyncCompute,
        false,
        instance.attributeSkinBuffer
    ) && uploaded;

    // Both shadow backends trace triangles; always build the reconstructed index buffer.
    if(uploaded){
        const auto triangleIndices = MeshSkinningTraceGeometry::BuildIndices(instance, scratchArena);
        if(!triangleIndices)
            return false;

        uploaded = __hidden_runtime_cache_resources::AssignRuntimeBuffer<u32>(
            instance,
            s_RtTriangleIndicesBufferName,
            *triangleIndices,
            false,
            s_RuntimeCacheRtTriangleIndexLabel,
            m_graphics,
            true,
            rtSupported,
            Core::ResourceQueueSharing::GraphicsAndAsyncCompute,
            true,
            instance.triangleIndexBuffer
        ) && uploaded;
    }

    // Per-corner trace attributes seeded from bind-pose; repack overwrites normals per frame.
    if(uploaded){
        const auto triangleAttributes = MeshSkinningTraceGeometry::BuildAttributes(instance, scratchArena);
        if(!triangleAttributes)
            return false;

        uploaded = __hidden_runtime_cache_resources::AssignRuntimeBuffer<AttribGpu>(
            instance,
            s_RtTriangleAttributesBufferName,
            *triangleAttributes,
            true, // canHaveUavs: the per-frame skinned-normal repack pass writes this buffer as a raw UAV in place
            s_RuntimeCacheRtTriangleAttributeLabel,
            m_graphics,
            true,
            false,
            Core::ResourceQueueSharing::GraphicsAndAsyncCompute,
            false,
            instance.attributeBuffer
        ) && uploaded;
    }

    return uploaded;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CreateMeshSkinningLocalBoundsBuffers(Core::GraphicsRuntime& graphics, MeshSkinningRuntimeInstance& instance){
    instance.deformationState.invalidateCurrent();
    if(!ValidateMeshSkinningLocalBoundsMeshletCount(instance.meshlets.size(), NWB_RUNTIME_MESH_BOUNDS_BYTE_SIZE))
        return false;
    const auto partialName = DeriveRuntimeResourceName(instance.sourceName, instance.handle.value, instance.editRevision, s_MeshletLocalBoundsSuffix);
    const auto outputName = DeriveRuntimeResourceName(instance.sourceName, instance.handle.value, instance.editRevision, s_LocalBoundsSuffix);
    if(!partialName || !outputName){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningSystem: failed to derive runtime local bounds buffer names"));
        return false;
    }
    Core::BufferDesc desc;
    desc.setByteSize(static_cast<u64>(instance.meshlets.size()) * NWB_RUNTIME_MESH_BOUNDS_BYTE_SIZE).setCanHaveUAVs(true).setCanHaveRawViews(true).setQueueSharing(Core::ResourceQueueSharing::GraphicsAndAsyncCompute).setDebugName(partialName);
    auto partialsResult = graphics.createBuffer(desc);
    if(!partialsResult){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningSystem: failed to create runtime local bounds partials"));
        return false;
    }
    Core::BufferHandle partials = Move(*partialsResult);
    desc.setByteSize(NWB_RUNTIME_MESH_BOUNDS_BYTE_SIZE).setDebugName(outputName);
    auto outputResult = graphics.createBuffer(desc);
    if(!outputResult){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningSystem: failed to create runtime local bounds output"));
        return false;
    }
    Core::BufferHandle output = Move(*outputResult);
    instance.meshletLocalBoundsBuffer = Move(partials);
    instance.localBoundsBuffer = Move(output);
    return true;
}

b8 MeshSkinningLocalBoundsTask::Record(const Payload& payload, Core::CommandList& commandList, const Core::GpuTaskRecordContext& context){
    if(payload.dispatches.empty())
        return false;
    auto& device = payload.graphics.getDevice();
    Core::GpuDescriptorHeap& heap = device.getDescriptorHeap();
    if(!heap.isInitialized())
        return false;
    Core::GpuTimingSubmissionTicket::RecordingScope recording(payload.timingTicket);
    for(const MeshSkinningLocalBoundsDispatch& plan : payload.dispatches){
        Core::ComputePipeline* const pipeline = context.declarations.computePipelineFor(plan.localBoundsPipeline);
        if(!pipeline || !context.declarations.bufferForResource(plan.bindlessResourceSlotsResource) || !context.declarations.bufferForResource(plan.meshletLocalBoundsResource) || !context.declarations.bufferForResource(plan.localBoundsResource))
            return false;
        Core::ComputeState state;
        state.setPipeline(pipeline);
        commandList.setComputeState(state);
        heap.bindCompute(commandList, *pipeline);
        const MeshletBoundsPushConstants push = MakeMeshletBoundsPushConstants(plan.meshletCount, plan.bindlessResourceSlots);
        commandList.setPushConstants(&push, sizeof(push));
        Core::GpuTimingMeasure timing(payload.graphics.gpuTiming(), MeshSkinningGpuTimingScope::s_LocalBounds, device, commandList);

        commandList.dispatch(1u, 1u, 1u);
    }
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Core::GpuTaskSchedulingHint MeshSkinningGraphDetail::MakeSerialMergeScheduling(const Core::GpuTaskCostHint::Enum cost)noexcept{
    Core::GpuTaskSchedulingHint scheduling;
    scheduling.cost = cost;
    scheduling.overlapPreferred = false;
    scheduling.avoidQueueCrossing = true;
    scheduling.forceSubmissionBoundary = false;
    scheduling.allowPacketMerge = true;
    // The external renderer consumes one accepted skinning state on this serial timeline.
    scheduling.mergeWithPrevious = true;
    scheduling.frontierScoredMergeDomain = s_SerialMergeDomain;
    return scheduling;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 MeshSkinningSystem::TaskGraphSkinningFinalizerTask::Record(const Payload& payload, Core::CommandList& commandList, const Core::GpuTaskRecordContext& context)noexcept{
    if(payload.plans.empty())
        return false;

    for(const MeshSkinningGraphDispatchPlan& plan : payload.plans){
        if(plan.hasActiveSkin || plan.copiedRestStreams){
            Core::Buffer* const skinnedPosition = context.declarations.bufferForResource(plan.skinnedPositionResource);
            Core::Buffer* const skinnedNormal = context.declarations.bufferForResource(plan.skinnedNormalResource);
            Core::Buffer* const skinnedTangent = context.declarations.bufferForResource(plan.skinnedTangentResource);
            if(
                !skinnedPosition
                || !skinnedNormal
                || !skinnedTangent
                || commandList.getBufferState(skinnedPosition) != Core::ResourceStates::ShaderResource
                || commandList.getBufferState(skinnedNormal) != Core::ResourceStates::ShaderResource
                || commandList.getBufferState(skinnedTangent) != Core::ResourceStates::ShaderResource
            )
                return false;
        }
        if(plan.updatesMeshletBounds){
            Core::Buffer* const meshletBounds = context.declarations.bufferForResource(plan.meshletBoundsResource);
            Core::Buffer* const localBounds = context.declarations.bufferForResource(plan.localBoundsResource);
            if(!meshletBounds || !localBounds || commandList.getBufferState(meshletBounds) != Core::ResourceStates::ShaderResource || commandList.getBufferState(localBounds) != Core::ResourceStates::ShaderResource)
                return false;
        }
        if(plan.repacksNormals){
            Core::Buffer* const attributes = context.declarations.bufferForResource(plan.attributeResource);
            if(!attributes || commandList.getBufferState(attributes) != Core::ResourceStates::ShaderResource)
                return false;
        }
    }
    return true;
}

void MeshSkinningSystem::TaskGraphSkinningFinalizerTask::Accepted(Payload& payload, const Core::QueueSubmissionToken& token)noexcept{
    if(!token.valid())
        return;
    for(const MeshSkinningGraphDispatchPlan& plan : payload.plans)
        payload.system.confirmGraphOwnedSkinningDispatch(plan);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 MeshSkinningSystem::submitFrameSkinningGraph(){
    auto& device = m_graphics.getDevice();
    const Core::GpuPhysicalQueueTopology topology = device.getPhysicalQueueTopology();
    if(!topology.queues || topology.queueCount == 0u){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningSystem: cannot declare graph-owned skinning without a physical queue topology"));
        return false;
    }

    // Compiler artifacts are reused member storage reset per submission; render() never constructs graph objects.
    resetFrameTaskGraph();
    Core::GpuTaskGraph& graph = m_frameTaskGraph;
    Core::Alloc::ScratchArena scratchArena(s_FrameUploadArena);
    // Dispatch plans are reused member storage; only capacity growth may allocate, never per-frame creation.
    Vector<MeshSkinningGraphDispatchPlan, Core::Alloc::GlobalArena>& dispatchPlans = m_frameDispatchPlans;
    dispatchPlans.clear();
    auto skinningBindings = m_world.view<SkinnedMeshBindingComponent>();
    dispatchPlans.reserve(skinningBindings.candidateCount());
    b8 declarationFailed = false;

    FramePlanBuilder planBuilder(*this, graph, scratchArena, dispatchPlans);
    skinningBindings.each([&](Core::ECS::EntityID entity, SkinnedMeshBindingComponent& binding){
        if(!declarationFailed && !planBuilder.declare(entity, binding))
            declarationFailed = true;
    });
    Core::GpuTaskId terminalTask = planBuilder.terminalTask();

    if(declarationFailed)
        return false;
    if(dispatchPlans.empty())
        return true;

    const auto resourceUses = BuildMeshSkinningGraphResourceUses(dispatchPlans, scratchArena);
    if(!resourceUses)
        return false;

    // Retain prior-frame state with its consuming task; source stays serial by contract.
    const Array<Core::GpuTaskExternalStateSource, 1> previousFrameStateSources = { Core::GpuTaskExternalStateSource{ .states = m_acceptedSkinningState.source(), }, };
    const usize previousFrameStateSourceCount = m_acceptedSkinningState.valid() ? previousFrameStateSources.size() : 0u;

    Core::GpuTimingSubmissionTicket timingTicket(m_graphics.gpuTiming());
    // Dispatch payload slices reference reused member storage that outlives m_frameTaskGraph.
    Vector<MeshSkinningLocalBoundsDispatch, Core::Alloc::GlobalArena>& localBoundsDispatches = m_frameLocalBoundsDispatches;
    localBoundsDispatches.clear();
    localBoundsDispatches.reserve(dispatchPlans.size());
    for(const MeshSkinningGraphDispatchPlan& plan : dispatchPlans){
        if(plan.updatesMeshletBounds){
            localBoundsDispatches.push_back({
                .bindlessResourceSlotsResource = plan.bindlessResourceSlotsResource,
                .meshletLocalBoundsResource = plan.meshletLocalBoundsResource,
                .localBoundsResource = plan.localBoundsResource,
                .localBoundsPipeline = plan.localBoundsPipeline,
                .meshletCount = plan.meshletCount,
                .bindlessResourceSlots = plan.bindlessResourceSlots,
            });
        }
    }
    const Span<const MeshSkinningGraphDispatchPlan> allDispatchPlans(dispatchPlans);
    TaskGraphSkinningFinalizerTask::Payload finalizerPayload(*this, allDispatchPlans);
    MeshSkinningLocalBoundsTask::Payload localBoundsPayload(m_graphics, timingTicket, localBoundsDispatches);
    Core::GpuTaskId postDispatchDependency = terminalTask;
    if(!resourceUses->deformation.empty()){
        Vector<MeshSkinningGraphDispatchPlan, Core::Alloc::GlobalArena>& deformationPlans = m_frameDeformationPlans;
        deformationPlans.clear();
        deformationPlans.reserve(dispatchPlans.size());
        for(const MeshSkinningGraphDispatchPlan& plan : dispatchPlans){
            if(plan.hasActiveSkin)
                deformationPlans.push_back(plan);
        }
        TaskGraphSkinningDeformationTask::Payload deformationPayload(*this, timingTicket, deformationPlans);

        Core::GpuTaskDesc deformationDesc;
        deformationDesc
            .setIdentity(s_FrameDeformationTaskName)
            .setMarkerLabel(s_FrameDeformationTaskLabel)
            .setScheduling(MeshSkinningGraphDetail::SkinningDispatchScheduling())
            .setResourceUses(resourceUses->deformation)
        ;
        if(previousFrameStateSourceCount != 0u)
            deformationDesc.setExternalStateSources({ previousFrameStateSources.data(), previousFrameStateSourceCount });
        if(terminalTask.valid())
            deformationDesc.setDependencies({ &terminalTask, 1u });
        const auto deformationTaskResult = graph.addTask<TaskGraphSkinningDeformationTask>(deformationDesc, Move(deformationPayload));
        if(!deformationTaskResult){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningSystem: failed to declare graph-owned skinning deformation"));
            return false;
        }
        const Core::GpuTaskId deformationTask = *deformationTaskResult;
        postDispatchDependency = deformationTask;
    }

    TaskGraphSkinningPostDispatchTask::Payload postDispatchPayload(*this, timingTicket, allDispatchPlans);
    Core::GpuTaskDesc postDispatchDesc;
    postDispatchDesc
        .setIdentity(s_FrameBoundsRepackTaskName)
        .setMarkerLabel(s_FrameBoundsRepackTaskLabel)
        .setScheduling(MeshSkinningGraphDetail::SkinningDispatchScheduling())
        .setResourceUses(resourceUses->postDispatch)
    ;
    if(previousFrameStateSourceCount != 0u)
        postDispatchDesc.setExternalStateSources({ previousFrameStateSources.data(), previousFrameStateSourceCount });
    if(postDispatchDependency.valid())
        postDispatchDesc.setDependencies({ &postDispatchDependency, 1u });
    const auto postDispatchTaskResult = graph.addTask<TaskGraphSkinningPostDispatchTask>(postDispatchDesc, Move(postDispatchPayload));
    if(!postDispatchTaskResult){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningSystem: failed to declare graph-owned skinning bounds/repack"));
        return false;
    }
    const Core::GpuTaskId postDispatchTask = *postDispatchTaskResult;

    Core::GpuTaskDesc localBoundsDesc;
    localBoundsDesc
        .setIdentity(s_FrameLocalBoundsTaskName)
        .setMarkerLabel(s_FrameLocalBoundsTaskLabel)
        .setScheduling(MeshSkinningGraphDetail::SkinningDispatchScheduling())
        .setDependencies({ &postDispatchTask, 1u })
        .setResourceUses(resourceUses->localBounds)
    ;
    if(previousFrameStateSourceCount != 0u)
        localBoundsDesc.setExternalStateSources({ previousFrameStateSources.data(), previousFrameStateSourceCount });
    const auto localBoundsTaskResult = graph.addTask<MeshSkinningLocalBoundsTask>(localBoundsDesc, Move(localBoundsPayload));
    if(!localBoundsTaskResult){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningSystem: failed to declare graph-owned local bounds reduction"));
        return false;
    }
    const Core::GpuTaskId localBoundsTask = *localBoundsTaskResult;

    const Core::GpuTaskDesc finalizerDesc = Core::GpuTaskDesc{}
        .setIdentity(s_FrameFinalizeStatesTaskName)
        .setMarkerLabel(s_FrameFinalizeStatesTaskLabel)
        .setScheduling(MeshSkinningGraphDetail::SkinningDispatchScheduling())
        .setDependencies({ &localBoundsTask, 1u })
        .setResourceUses(resourceUses->finalizer)
    ;
    const auto finalizerTaskResult = graph.addTask<TaskGraphSkinningFinalizerTask>(finalizerDesc, Move(finalizerPayload));
    if(!finalizerTaskResult){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningSystem: failed to declare graph-owned skinning final-state handoff"));
        return false;
    }
    const Core::GpuTaskId finalizerTask = *finalizerTaskResult;
    terminalTask = finalizerTask;

    Core::GpuTaskGraphAnalysis& analysis = m_frameTaskGraphAnalysis;
    Core::GpuTaskGraphQueueAssignments& assignments = m_frameTaskGraphQueueAssignments;
    Core::GpuCompiledGraph& compiledGraph = m_frameCompiledGraph;
    Core::GpuRecordedGraph& recordedGraph = m_frameRecordedGraph;
    Core::GpuGraphSubmissionTransaction& transaction = m_frameSubmissionTransaction;
    Core::GpuTaskGraphCompileOptions compileOptions;
    compileOptions.packetizationPolicy = Core::GpuTaskGraphPacketizationPolicy::FrontierScored;
    const Core::GpuTaskScheduler& scheduler = m_graphics.gpuTasks();
    if(!scheduler.scheduleGraph(graph, compileOptions, scratchArena, analysis, assignments, compiledGraph, recordedGraph, transaction)){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningSystem: failed to prepare graph-owned skinning work"));
        return false;
    }

    const Core::GpuTaskGraph::DeclarationReadView declarations(graph);
    const Core::GpuCompiledGraph::ReadView compiledPlan(compiledGraph);
    if(!compiledPlan.validFor(declarations)){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningSystem: failed to retain graph-owned skinning compiler inputs"));
        return false;
    }

    if(compiledPlan.packetCount() != 1u){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningSystem: graph-owned skinning work did not merge into one primary Graphics packet"));
        return false;
    }

    const Core::GpuPhysicalQueueInfo* const terminalQueue = compiledPlan.queueInfoForTask(terminalTask);
    const Core::GpuPhysicalQueueId graphicsQueue = device.getPrimaryPhysicalQueue(Core::CommandQueue::Graphics);
    if(!terminalQueue || terminalQueue->id != graphicsQueue){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningSystem: graph-owned skinning work did not retain the primary Graphics queue"));
        return false;
    }

    // Live-buffer list is reused member storage; only capacity growth may allocate, never per-frame creation.
    Vector<Core::BufferHandle, Core::Alloc::GlobalArena>& liveBuffers = m_frameLiveBuffers;
    liveBuffers.clear();
    collectLiveSkinningStateBuffers(scratchArena, liveBuffers);
    SkinningStateHandoff skinningState(m_acceptedSkinningState, scratchArena, liveBuffers);
    const Core::GpuTaskGraphTaskRecordedCallback recordedCallback{ .task = terminalTask, .context = &skinningState, .invoke = &SkinningStateHandoff::Prepare, };
    const Core::GpuTaskGraphTaskAcceptedCallback acceptedCallback{ .task = terminalTask, .context = &skinningState, .invoke = &SkinningStateHandoff::Accept, };

    const Array<Core::GpuTaskGraphTaskTimingTicket, 1> timingTickets = { Core::GpuTaskGraphTaskTimingTicket{ .task = terminalTask, .timingTicket = &timingTicket, }, };
    Core::GpuTaskGraphNormalExecutionDesc normalExecution;
    normalExecution.taskRecordedCallbacks = &recordedCallback;
    normalExecution.taskRecordedCallbackCount = 1u;
    normalExecution.taskTimingTickets = timingTickets.data();
    normalExecution.taskTimingTicketCount = timingTickets.size();
    normalExecution.taskAcceptedCallbacks = &acceptedCallback;
    normalExecution.taskAcceptedCallbackCount = 1u;
    const b8 skinningGraphAccepted = scheduler.executeGraph(normalExecution, scratchArena, graph, compiledGraph, recordedGraph, transaction, nullptr);
    const Core::QueueSubmissionToken skinningToken = transaction.taskToken(compiledPlan, terminalTask);
    if(!skinningToken.valid()){
        if(!transaction.discardUnaccepted(graph, compiledGraph, recordedGraph.recordingAttemptGeneration()))
            m_graphics.requestDeviceRecreation();
        if(!skinningState.preparationInvoked())
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningSystem: failed to record graph-owned skinning work"));
        else if(!skinningState.statePrepared())
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningSystem: failed to prepare graph-owned skinning frame state"));
        else
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningSystem: graph-owned skinning submission was rejected"));
        return false;
    }
    if(!skinningGraphAccepted || !skinningState.stateAccepted()){
        m_graphics.requestDeviceRecreation();
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningSystem: accepted graph-owned skinning submission lost its retained state"));
        return false;
    }
    if(!skinningToken.matchesPhysicalQueue(graphicsQueue.index, graphicsQueue.deviceGeneration)){
        m_graphics.requestDeviceRecreation();
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningSystem: graph-owned skinning submission lost its Graphics queue identity"));
        return false;
    }
    return true;
}

void MeshSkinningSystem::resolveFrameTaskGraphAttempt(const Core::GpuCompiledGraph::ReadView& planAccess)noexcept{
    // This graph owns only skinning tasks and built-in copies/uploads; their discard hooks are absent or clear a token without callbacks or allocation.
    if(!planAccess.valid())
        return;
    const u64 recordingAttemptGeneration = m_frameRecordedGraph.recordingAttemptGeneration();
    if(recordingAttemptGeneration != 0u && !m_frameSubmissionTransaction.discardUnaccepted(m_frameTaskGraph, m_frameCompiledGraph, recordingAttemptGeneration))
        FOUNDATION_FATAL_ASSERT_MSG(false, "skinning task-graph reset must resolve every unaccepted packet");
}

void MeshSkinningSystem::resetFrameTaskGraph(){
    {
        const Core::GpuCompiledGraph::ReadView planAccess(m_frameCompiledGraph);
        resolveFrameTaskGraphAttempt(planAccess);
        if(planAccess.valid()){
            m_frameSubmissionTransaction.reset(m_frameCompiledGraph);
            m_frameRecordedGraph.reset(m_frameCompiledGraph);
        }
    }

    m_frameTaskGraph.reset();
    m_frameTaskGraphAnalysis.reset();
    m_frameTaskGraphQueueAssignments.reset();
    m_frameCompiledGraph.reset();
}


