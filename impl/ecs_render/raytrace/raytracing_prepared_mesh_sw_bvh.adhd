////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class MeshSwBvhBuildPlanDecision{
    public u32 primitiveCount = 0u;
    public u32 refitsBeforeBuild = 0u;
    public u32 refitsAfterBuild = 0u;
    public b8 firstBuild = false;
    public b8 performRefit = false;
}

class PreparedMeshSwBvhPlanPolicy{
    public b8 matchesMesh(in MeshRayTracingResourceSnapshot mesh, in PreparedMeshSwBvhBuild build)const{
        return this.matchesCoreRevisionState(
            mesh.meshName,
            build.meshName,
            mesh.runtimeMesh,
            build.runtimeMesh,
            mesh.runtimeMeshVersion,
            build.runtimeMeshVersion,
            mesh.runtimeGeometryContentRevision,
            build.geometryContentRevision,
            mesh.swBvhGeometryContentRevision,
            build.acceptedGeometryContentRevision,
            mesh.swBvhRefitsSinceRebuild,
            build.refitsBeforeBuild,
            mesh.swBvhBuildPending,
            build.buildPending
        )
            && build.positionBuffer == mesh.positionBuffer
            && build.triangleIndexBuffer == mesh.triangleIndexBuffer
            && build.nodeBuffer == mesh.swBvhNodeBuffer
            && build.parentBuffer == mesh.swBvhParentBuffer;
    }

    public b8 matchesCoreRevisionState(
        in Name meshName,
        in Name buildMeshName,
        in b8 runtimeMesh,
        in b8 buildRuntimeMesh,
        in u64 runtimeMeshVersion,
        in u64 buildRuntimeMeshVersion,
        in u64 geometryContentRevision,
        in u64 buildGeometryContentRevision,
        in u64 acceptedGeometryContentRevision,
        in u64 buildAcceptedGeometryContentRevision,
        in u32 refitsSinceRebuild,
        in u32 buildRefitsBeforeBuild,
        in b8 buildPending,
        in b8 expectedBuildPending
    )const{
        return meshName == buildMeshName
            && runtimeMesh == buildRuntimeMesh
            && runtimeMeshVersion == buildRuntimeMeshVersion
            && geometryContentRevision == buildGeometryContentRevision
            && acceptedGeometryContentRevision == buildAcceptedGeometryContentRevision
            && refitsSinceRebuild == buildRefitsBeforeBuild
            && buildPending == expectedBuildPending;
    }

    public b8 matchesFirstBuildFlag(in b8 swBvhTopologyBuilt, in b8 swBvhBuildAccepted, in b8 expectedFirstBuild)const{
        const b8 currentFirstBuild = !swBvhTopologyBuilt || !swBvhBuildAccepted;
        return currentFirstBuild == expectedFirstBuild;
    }

    public b8 matchesBackingByteSizes(
        in usize positionBytes,
        in usize expectedPositionBytes,
        in usize indexBytes,
        in usize expectedIndexBytes,
        in usize nodeBytes,
        in usize expectedNodeBytes,
        in usize parentBytes,
        in usize expectedParentBytes,
        in usize sortKeysBytes,
        in usize expectedSortKeysBytes,
        in usize sortPayloadBytes,
        in usize expectedSortPayloadBytes,
        in usize visitCounterBytes,
        in usize expectedVisitCounterBytes
    )const{
        return positionBytes == expectedPositionBytes
            && indexBytes == expectedIndexBytes
            && nodeBytes == expectedNodeBytes
            && parentBytes == expectedParentBytes
            && sortKeysBytes == expectedSortKeysBytes
            && sortPayloadBytes == expectedSortPayloadBytes
            && visitCounterBytes == expectedVisitCounterBytes;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


MeshSwBvhBuildPlanDecision ResolveMeshSwBvhBuildPlanDecision(in u32 primitiveIndexCount, in b8 runtimeMesh, in b8 swBvhTopologyBuilt, in b8 swBvhBuildAccepted, in u32 swBvhRefitsSinceRebuild){
    MeshSwBvhBuildPlanDecision decision;
    decision.primitiveCount = ComputeMeshTrianglePrimitiveCount(primitiveIndexCount);
    decision.firstBuild = !swBvhTopologyBuilt || !swBvhBuildAccepted;
    decision.performRefit = ShouldRefitRuntimeMeshAcceleration(runtimeMesh, decision.firstBuild, swBvhRefitsSinceRebuild, decision.primitiveCount);
    decision.refitsBeforeBuild = swBvhRefitsSinceRebuild;
    decision.refitsAfterBuild = AdvanceAccelerationRefitCount(decision.performRefit, swBvhRefitsSinceRebuild);
    return decision;
}


b8 MatchesPreparedMeshSwBvhBuild(in MeshRayTracingResourceSnapshot mesh, in PreparedMeshSwBvhBuild build, in RtSceneBvhState state){
    PreparedMeshSwBvhPlanPolicy planPolicy;
    if(
        !planPolicy.matchesMesh(mesh, build)
        || !planPolicy.matchesFirstBuildFlag(mesh.swBvhTopologyBuilt, mesh.swBvhBuildAccepted, build.firstBuild)
        || mesh.swBvhPositionHeapHandle != build.positionHeapHandle
        || mesh.swBvhTriangleIndexHeapHandle != build.triangleIndexHeapHandle
        || mesh.swBvhNodeHeapHandle != build.nodeHeapHandle
        || mesh.swBvhParentHeapHandle != build.parentHeapHandle
        || state.m_bvhSortKeysBuffer != build.sortKeysBuffer
        || state.m_bvhSortPayloadBuffer != build.sortPayloadBuffer
        || state.m_bvhVisitCounterBuffer != build.visitCounterBuffer
        || state.m_bvhSortKeysHeapHandle != build.sortKeysHeapHandle
        || state.m_bvhSortPayloadHeapHandle != build.sortPayloadHeapHandle
        || state.m_bvhVisitCounterHeapHandle != build.visitCounterHeapHandle
        || mesh.meshletPrimitiveIndexCount != build.primitiveCount * s_RayTracingTriangleIndexCount
        || mesh.csgLocalBounds.minBounds != build.aabbMin
        || mesh.csgLocalBounds.maxBounds != build.aabbMax
        || !MeshSwBvhResourcesReady(state, mesh.swBvhNodeBuffer, mesh.swBvhParentBuffer, mesh.swBvhNodeHeapHandle, mesh.swBvhParentHeapHandle)
    )
        return false;
    return planPolicy.matchesBackingByteSizes(
        mesh.positionBuffer.deref().getCreationDescription().byteSize,
        build.positionByteSize,
        mesh.triangleIndexBuffer.deref().getCreationDescription().byteSize,
        build.indexByteSize,
        mesh.swBvhNodeBuffer.deref().getCreationDescription().byteSize,
        build.nodeByteSize,
        mesh.swBvhParentBuffer.deref().getCreationDescription().byteSize,
        build.parentByteSize,
        build.sortKeysBuffer.deref().getCreationDescription().byteSize,
        build.sortKeysByteSize,
        build.sortPayloadBuffer.deref().getCreationDescription().byteSize,
        build.sortPayloadByteSize,
        build.visitCounterBuffer.deref().getCreationDescription().byteSize,
        build.visitCounterByteSize
    );
}

PreparedMeshSwBvhBuild CapturePreparedMeshSwBvhBuild(in MeshRayTracingResourceSnapshot mesh, in RtSceneBvhState state){
    const MeshSwBvhBuildPlanDecision decision = ResolveMeshSwBvhBuildPlanDecision(
        mesh.meshletPrimitiveIndexCount,
        mesh.runtimeMesh,
        mesh.swBvhTopologyBuilt,
        mesh.swBvhBuildAccepted,
        mesh.swBvhRefitsSinceRebuild
    );
    in BufferDesc positionDesc = mesh.positionBuffer.deref().getCreationDescription();
    in BufferDesc indexDesc = mesh.triangleIndexBuffer.deref().getCreationDescription();
    in BufferDesc nodeDesc = mesh.swBvhNodeBuffer.deref().getCreationDescription();
    in BufferDesc parentDesc = mesh.swBvhParentBuffer.deref().getCreationDescription();
    PreparedMeshSwBvhBuild preparedBuild;
    preparedBuild.meshName = mesh.meshName;
    preparedBuild.positionBuffer = mesh.positionBuffer;
    preparedBuild.triangleIndexBuffer = mesh.triangleIndexBuffer;
    preparedBuild.nodeBuffer = mesh.swBvhNodeBuffer;
    preparedBuild.parentBuffer = mesh.swBvhParentBuffer;
    preparedBuild.sortKeysBuffer = state.m_bvhSortKeysBuffer;
    preparedBuild.sortPayloadBuffer = state.m_bvhSortPayloadBuffer;
    preparedBuild.visitCounterBuffer = state.m_bvhVisitCounterBuffer;
    preparedBuild.positionHeapHandle = mesh.swBvhPositionHeapHandle;
    preparedBuild.triangleIndexHeapHandle = mesh.swBvhTriangleIndexHeapHandle;
    preparedBuild.nodeHeapHandle = mesh.swBvhNodeHeapHandle;
    preparedBuild.parentHeapHandle = mesh.swBvhParentHeapHandle;
    preparedBuild.sortKeysHeapHandle = state.m_bvhSortKeysHeapHandle;
    preparedBuild.sortPayloadHeapHandle = state.m_bvhSortPayloadHeapHandle;
    preparedBuild.visitCounterHeapHandle = state.m_bvhVisitCounterHeapHandle;
    preparedBuild.aabbMin = mesh.csgLocalBounds.minBounds;
    preparedBuild.aabbMax = mesh.csgLocalBounds.maxBounds;
    preparedBuild.runtimeMeshVersion = mesh.runtimeMeshVersion;
    preparedBuild.geometryContentRevision = mesh.runtimeGeometryContentRevision;
    preparedBuild.acceptedGeometryContentRevision = mesh.swBvhGeometryContentRevision;
    preparedBuild.positionByteSize = positionDesc.byteSize;
    preparedBuild.indexByteSize = indexDesc.byteSize;
    preparedBuild.nodeByteSize = nodeDesc.byteSize;
    preparedBuild.parentByteSize = parentDesc.byteSize;
    preparedBuild.sortKeysByteSize = preparedBuild.sortKeysBuffer.deref().getCreationDescription().byteSize;
    preparedBuild.sortPayloadByteSize = preparedBuild.sortPayloadBuffer.deref().getCreationDescription().byteSize;
    preparedBuild.visitCounterByteSize = preparedBuild.visitCounterBuffer.deref().getCreationDescription().byteSize;
    preparedBuild.primitiveCount = decision.primitiveCount;
    preparedBuild.refitsBeforeBuild = decision.refitsBeforeBuild;
    preparedBuild.refitsAfterBuild = decision.refitsAfterBuild;
    preparedBuild.runtimeMesh = mesh.runtimeMesh;
    preparedBuild.buildPending = mesh.swBvhBuildPending;
    preparedBuild.firstBuild = decision.firstBuild;
    preparedBuild.performRefit = decision.performRefit;
    return preparedBuild;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
b8 RendererRayTracingSystem::recordPreparedMeshSwBvhBuildAfterGraphClears(mut CommandList commandList, in PreparedMeshSwBvhBuild build){
    SoftwareBvhBuilder bvh(this.m_graphics, this.m_shaderSystem, this.m_rayTracingState.sceneBvh);
    if(!this.preparedMeshSwBvhBuildMatchesCurrent(build)){
        warning("RendererSystem: frozen software BVH build no longer matches mesh '{}'", build.meshName.resolvedText());
        return false;
    }

    BufferHandle nodeBuffer = build.nodeBuffer;
    BufferHandle parentBuffer = build.parentBuffer;
    b8 recorded = false;
    if(build.performRefit)
        recorded = bvh.refitMeshSwBvhPrepared(build.positionHeapHandle.slot(), build.triangleIndexHeapHandle.slot(), build.primitiveCount, build.nodeHeapHandle, build.parentHeapHandle, commandList, nodeBuffer, parentBuffer);
    else
        recorded = bvh.buildMeshSwBvhPrepared(build.positionHeapHandle.slot(), build.triangleIndexHeapHandle.slot(), build.primitiveCount, VectorSingle(build.aabbMin), VectorSingle(build.aabbMax), build.nodeHeapHandle,
            build.parentHeapHandle, commandList, nodeBuffer, parentBuffer);
    if(!recorded)
        warning("RendererSystem: failed to record frozen software BVH build for mesh '{}'", build.meshName.resolvedText());
    return recorded;
}

[cpp_unwind]
void RendererRayTracingSystem::confirmPreparedMeshSwBvhBuilds(){
    if(!this.m_preparedMeshSwBvhBuildsReady)
        return;

    const PreparedMeshSwBvhPlanPolicy planPolicy();
    b8 allPlansCurrent = true;
    for(in PreparedMeshSwBvhBuild build : this.m_preparedMeshSwBvhBuilds){
        auto meshResult = this.m_meshSystem.findRayTracingResourceSnapshot(build.meshName);
        if(
            !meshResult.has_value()
            || !planPolicy.matchesMesh(meshResult.value(), build)
            || !planPolicy.matchesFirstBuildFlag(meshResult.value().swBvhTopologyBuilt, meshResult.value().swBvhBuildAccepted, build.firstBuild)
        ){
            allPlansCurrent = false;
            continue;
        }

        const MeshRayTracingResourceSnapshot expected = meshResult.value();
        RayTracingBuildPolicy().applyConfirmedMeshSwBvhBuild(
            build.performRefit,
            build.refitsAfterBuild,
            build.geometryContentRevision,
            meshResult.value().swBvhBuildPending,
            meshResult.value().swBvhBuildAccepted,
            meshResult.value().swBvhGeometryContentRevision,
            meshResult.value().swBvhTopologyBuilt,
            meshResult.value().swBvhRefitsSinceRebuild
        );
        if(!this.m_meshSystem.commitRayTracingResourceSnapshot(expected, meshResult.value())){
            allPlansCurrent = false;
            continue;
        }
        RayTracingDiagnostics().meshSwBvhFirstBuild(build.firstBuild, build.meshName, build.runtimeMesh, build.primitiveCount);
    }
    if(!allPlansCurrent)
        this.m_rayTracingState.sceneBvh.m_sceneSwBvhStaticSceneHashValid = false;
    this.clearPreparedMeshSwBvhBuilds();
}

[cpp_unwind]
b8 RendererRayTracingSystem::capturePreparedMeshSwBvhBuilds(){
    SoftwareBvhBuilder bvh(this.m_graphics, this.m_shaderSystem, this.m_rayTracingState.sceneBvh);
    this.clearPreparedMeshSwBvhBuilds();
    mut RtSceneBvhState state = this.m_rayTracingState.sceneBvh;
    MeshRayTracingResourceSnapshotVector meshes;
    this.m_meshSystem.collectRayTracingResourceSnapshots(meshes);
    b8 hasCandidate = false;
    for(in MeshRayTracingResourceSnapshot mesh : meshes){
        if(MeshAccelerationStatePolicy().requiresSoftwareBvhUpdate(mesh.swBvhBuildPending, mesh.swBvhTopologyBuilt, mesh.swBvhBuildAccepted, mesh.runtimeMesh, mesh.runtimeGeometryContentRevision, mesh.swBvhGeometryContentRevision)){
            hasCandidate = true;
            break;
        }
    }
    if(!hasCandidate){
        this.m_preparedMeshSwBvhBuildPlanFrozen = true;
        return true;
    }
    const b8 sharedResourcesReady =
            state.m_bvhSortKeysBuffer.valid()
            && state.m_bvhSortPayloadBuffer.valid()
            && state.m_bvhVisitCounterBuffer.valid()
            && IsDescriptorClass(state.m_bvhSortKeysHeapHandle, GpuDescriptorClass::StorageBuffer)
            && IsDescriptorClass(state.m_bvhSortPayloadHeapHandle, GpuDescriptorClass::StorageBuffer)
            && IsDescriptorClass(state.m_bvhVisitCounterHeapHandle, GpuDescriptorClass::StorageBuffer)
    ;
    if(!sharedResourcesReady)
        return false;

    for(in MeshRayTracingResourceSnapshot mesh : meshes){
        if(!MeshAccelerationStatePolicy().requiresSoftwareBvhUpdate(mesh.swBvhBuildPending, mesh.swBvhTopologyBuilt, mesh.swBvhBuildAccepted, mesh.runtimeMesh, mesh.runtimeGeometryContentRevision, mesh.swBvhGeometryContentRevision))
            continue;
        if(
            mesh.meshName == Name()
            || !mesh.positionBuffer.valid()
            || !mesh.triangleIndexBuffer.valid()
            || !HasValidMeshTriangleIndexCount(mesh.meshletPrimitiveIndexCount)
            || !bvh.meshSwBvhResourcesReady(mesh.swBvhNodeBuffer, mesh.swBvhParentBuffer, mesh.swBvhNodeHeapHandle, mesh.swBvhParentHeapHandle)
            || !IsDescriptorClass(mesh.swBvhPositionHeapHandle, GpuDescriptorClass::StorageBuffer)
            || !IsDescriptorClass(mesh.swBvhTriangleIndexHeapHandle, GpuDescriptorClass::StorageBuffer)
        ){
            warning("RendererSystem: could not freeze software BVH build for mesh '{}'", mesh.meshName.resolvedText());
            this.clearPreparedMeshSwBvhBuilds();
            return false;
        }

        PreparedMeshSwBvhBuild preparedBuild = CapturePreparedMeshSwBvhBuild(mesh, state);
        this.m_preparedMeshSwBvhBuilds.push_back(preparedBuild);
    }
    this.m_preparedMeshSwBvhBuildsReady = !this.m_preparedMeshSwBvhBuilds.empty();
    this.m_preparedMeshSwBvhBuildPlanFrozen = true;
    return true;
}

b8 RendererRayTracingSystem::preparedMeshSwBvhBuildMatchesCurrent(in PreparedMeshSwBvhBuild build){
    const auto mesh = this.m_meshSystem.findRayTracingResourceSnapshot(build.meshName);
    return mesh.has_value() && MatchesPreparedMeshSwBvhBuild(mesh.value(), build, this.m_rayTracingState.sceneBvh);
}

b8 RendererRayTracingSystem::preparedMeshSwBvhBuildProducesTopology(in MeshRayTracingResourceSnapshot mesh)const{
    if(!this.m_preparedMeshSwBvhBuildsReady)
        return false;

    const PreparedMeshSwBvhPlanPolicy planPolicy();
    for(in PreparedMeshSwBvhBuild build : this.m_preparedMeshSwBvhBuilds){
        if(planPolicy.matchesMesh(mesh, build))
            return !build.performRefit;
    }
    return false;
}

void RendererRayTracingSystem::clearPreparedMeshSwBvhBuilds(){
    this.m_preparedMeshSwBvhBuilds.clear();
    this.m_preparedMeshSwBvhBuildsReady = false;
    this.m_preparedMeshSwBvhBuildPlanFrozen = false;
}

[cpp_unwind]
b8 RendererRayTracingSystem::preparePendingMeshSwBvhResources(){
    SoftwareBvhBuilder bvh(this.m_graphics, this.m_shaderSystem, this.m_rayTracingState.sceneBvh);
    b8 allResourcesReady = true;
    MeshRayTracingResourceSnapshotVector meshes;
    this.m_meshSystem.collectRayTracingResourceSnapshots(meshes);
    for(in MeshRayTracingResourceSnapshot meshResources : meshes){
        if(!MeshAccelerationStatePolicy().requiresSoftwareBvhUpdate(meshResources.swBvhBuildPending, meshResources.swBvhTopologyBuilt, meshResources.swBvhBuildAccepted, meshResources.runtimeMesh, meshResources.runtimeGeometryContentRevision, meshResources.swBvhGeometryContentRevision))
            continue;

        if(!meshResources.positionBuffer.valid() || !meshResources.triangleIndexBuffer.valid()){
            allResourcesReady = false;
            continue;
        }
        if(!HasValidMeshTriangleIndexCount(meshResources.meshletPrimitiveIndexCount)){
            allResourcesReady = false;
            continue;
        }

        const u32 primitiveCount = ComputeMeshTrianglePrimitiveCount(meshResources.meshletPrimitiveIndexCount);
        const auto boundResources = this.m_meshSystem.ensureRayTracingInputHeapHandles(meshResources);
        if(!boundResources.has_value()){
            warning("RendererSystem: software BVH input heap registration failed for mesh '{}'", meshResources.meshName.resolvedText());
            allResourcesReady = false;
            continue;
        }
        MeshRayTracingResourceSnapshot preparedResources = boundResources.value();
        if(!bvh.ensureMeshSwBvhResources(primitiveCount, preparedResources.swBvhNodeBuffer, preparedResources.swBvhParentBuffer, preparedResources.swBvhNodeHeapHandle, preparedResources.swBvhParentHeapHandle)){
            warning("RendererSystem: software BVH resource preparation failed for mesh '{}'", meshResources.meshName.resolvedText());
            allResourcesReady = false;
        }
        else if(!this.m_meshSystem.commitRayTracingResourceSnapshot(boundResources.value(), preparedResources)){
            warning("RendererSystem: software BVH resource preflight lost mesh '{}'", meshResources.meshName.resolvedText());
            allResourcesReady = false;
        }
    }
    return allResourcesReady;
}


