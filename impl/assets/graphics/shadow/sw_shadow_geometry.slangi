#ifndef NWB_GRAPHICS_SHADOW_SW_SHADOW_GEOMETRY_SLANGI
#define NWB_GRAPHICS_SHADOW_SW_SHADOW_GEOMETRY_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "sw_binding_slots.h"

#include "../bvh/bvh_common.slangi"
#include "../bvh/ray_vertex_attrib.slangi"
#include "../bvh/sw_instance.slangi"
#include "../common/math.slangi"
#include "instance_material.slangi"

// Global descriptor-heap accessors for per-mesh geometry. The material record carries the slots; this include provides
// NwbHeapBvhNodes() for nodes and NwbHeapRawBuffer() for positions, indices, and attributes.
#include "../bindless/bindless_heap_bvh.slangi"
#include "../bindless/bindless_heap_rt.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// The software-shadow scene geometry: the scene/instance BVH node buffer, the per-instance record, world->object
// helpers, and vertex-attribute unpack. Per-mesh nodes, positions, indices, and attributes are read through descriptor
// heap slots carried by the material record; shared backing buffers remain transitioned for those reads. This concern
// declares typed heap aliases for the scene-node, instance, and instance-material buffers used by every BVH-walking
// pass. Their uniform slots come from g_NwbSwShadowMaterialContextSlots (declared by sw_shadow_gbuffer.slangi before
// this concern is included), so no local SRV remains in the SW shadow layout.

// The scene-instance table has a distinct 64-byte record stride but shares the global StorageBuffer descriptor class
// with the BVH and material buffers. This view supplies its shader-side stride without a new descriptor class.
#pragma warning(push)
#pragma warning(disable: 39001) // Deliberate typed view of the StorageBuffer descriptor table in bindless_heap.
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
StructuredBuffer<NwbSwBvhInstance, Std430DataLayout> g_NwbHeapSwShadowSceneInstanceBuffers[];
#pragma warning(pop)

StructuredBuffer<NwbSwBvhInstance, Std430DataLayout> NwbHeapSwShadowSceneInstances(const uint slot){
    return g_NwbHeapSwShadowSceneInstanceBuffers[slot];
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Transforms an object-space normal to world space for the surface hook (NwbMeshSurface.normal is world space).
// The normal transform is the inverse-transpose of object->world -- the transpose of the world->object 3x3 carried
// in the instance rows; that transpose's i-th component is the dot of the object normal with the i-th COLUMN of the
// world->object 3x3 (the i-th components of the three rows). This is the geometrically-correct transform; it equals
// the rasterizer's world-space normal under uniform instance scale (the
// common case) and diverges in direction only under NON-uniform scale (where the rasterizer applies the forward
// map instead) -- latent for transmittance hooks that don't read the normal. nwbSafeNormalize guards the
// degenerate (near-zero / non-finite, e.g. a singular instance transform) result, matching the engine pattern.
float3 nwbSwShadowTransformNormal(const NwbSwBvhInstance instance, const float3 objectNormal){
    const float3 worldNormal = nwbSwBvhTransformNormal(instance, objectNormal);
    return nwbSafeNormalize(worldNormal, float3(0.0, 0.0, 1.0));
}

// Unpacks a per-triangle-corner shadow-trace attribute (AttribGpu) from a per-mesh attribute byte buffer: Half4U
// normal (two packed-half uints) at +0, Float2U uv0 (two floats) at +8. Returns object-space normal in .xyz, uv0.
NwbRayTraceVertexAttrib nwbSwShadowLoadVertexAttrib(const uint attributeSlot, const uint attributeIndex){
    // attributeSlot is a non-uniform global heap slot; NwbHeapRawBuffer() applies the required decoration per load.
    const uint base = attributeIndex * 16u;
    const uint2 packedNormal = NwbHeapRawBuffer(attributeSlot).Load2(base);
    const uint2 packedUv0 = NwbHeapRawBuffer(attributeSlot).Load2(base + 8u);
    return nwbRayTraceDecodeVertexAttrib(uint4(packedNormal.x, packedNormal.y, packedUv0.x, packedUv0.y));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


