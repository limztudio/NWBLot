// limztudio@gmail.com
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_mesh/skinning/runtime_instance.adhd>
#include <impl/ecs_mesh/skinning/system.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u32 ResolveRuntimeSkinningJointCount(in b8 hasSkinPayload, in u32 skeletonJointCount){
    if(hasSkinPayload)
        return skeletonJointCount;
    return 0u;
}

u64 ComputeJointPaletteBufferByteSize(in u32 jointCount, in usize jointMatrixByteSize){
    return cast<u64>(jointCount) * cast<u64>(jointMatrixByteSize);
}

usize ResolvePreviousFrameStateSourceCount(in b8 hasAcceptedState, in usize sourceCapacity){
    if(hasAcceptedState)
        return sourceCapacity;
    return 0u;
}

b8 ValidateFinalizedSkinningPlanStates(
    in b8 hasActiveSkin,
    in b8 copiedRestStreams,
    in b8 skinnedStreamsReady,
    in b8 updatesMeshletBounds,
    in b8 boundsStreamsReady,
    in b8 repacksNormals,
    in b8 attributeStreamReady
){
    if((hasActiveSkin || copiedRestStreams) && !skinnedStreamsReady)
        return false;
    if(updatesMeshletBounds && !boundsStreamsReady)
        return false;
    if(repacksNormals && !attributeStreamReady)
        return false;
    return true;
}

b8 ValidateCompiledSkinningGraphPlan(
    in b8 planValidForDeclarations,
    in usize packetCount,
    in b8 terminalMatchesGraphicsQueue
){
    if(!planValidForDeclarations){
        error("MeshSkinningSystem: failed to retain graph-owned skinning compiler inputs");
        return false;
    }
    if(packetCount != 1u){
        error("MeshSkinningSystem: graph-owned skinning work did not merge into one primary Graphics packet");
        return false;
    }
    if(!terminalMatchesGraphicsQueue){
        error("MeshSkinningSystem: graph-owned skinning work did not retain the primary Graphics queue");
        return false;
    }
    return true;
}

void ReportUnacceptedSkinningGraphExecution(in b8 preparationInvoked, in b8 statePrepared){
    if(!preparationInvoked)
        error("MeshSkinningSystem: failed to record graph-owned skinning work");
    else if(!statePrepared)
        error("MeshSkinningSystem: failed to prepare graph-owned skinning frame state");
    else
        error("MeshSkinningSystem: graph-owned skinning submission was rejected");
}

b8 ValidateAcceptedSkinningGraphExecution(
    in b8 graphAccepted,
    in b8 stateAccepted,
    in b8 matchesGraphicsQueue
){
    if(!graphAccepted || !stateAccepted){
        error("MeshSkinningSystem: accepted graph-owned skinning submission lost its retained state");
        return false;
    }
    if(!matchesGraphicsQueue){
        error("MeshSkinningSystem: graph-owned skinning submission lost its Graphics queue identity");
        return false;
    }
    return true;
}

Expected<GpuDescriptorHandle> RegisterSkinningStorageBufferDescriptor(mut GpuDescriptorHeap heap, in DescriptorWriteItem item){
    const Expected<GpuDescriptorHandle> handle = heap.allocate(GpuDescriptorClass::StorageBuffer);
    if(!handle.has_value())
        return MakeUnexpected(Failure());
    GpuDescriptorRetirementGuard retireHandle(heap, handle.value());
    if(!heap.write(handle.value(), item))
        return MakeUnexpected(Failure());
    retireHandle.release();
    return handle.value();
}

Expected<GpuDescriptorHandle> RegisterSkinningUniformBufferDescriptor(mut GpuDescriptorHeap heap, mut Buffer buffer){
    const Expected<GpuDescriptorHandle> handle = heap.allocate(GpuDescriptorClass::UniformBuffer);
    if(!handle.has_value())
        return MakeUnexpected(Failure());
    GpuDescriptorRetirementGuard retireHandle(heap, handle.value());
    if(!heap.write(handle.value(), DescriptorWriteItemConstantBuffer(0, buffer)))
        return MakeUnexpected(Failure());
    retireHandle.release();
    return handle.value();
}

b8 RegisterSkinningStorageSlot(
    mut GpuDescriptorHeap heap,
    in RuntimeStorageDescriptorSlot slot,
    in DescriptorWriteItem item,
    mut MeshSkinningRuntimeResources resources,
    mut u32 outSlot
){
    const Expected<GpuDescriptorHandle> handle = RegisterSkinningStorageBufferDescriptor(heap, item);
    if(!handle.has_value())
        return false;
    resources.bindlessHeapHandles.storageBuffers[cast<usize>(slot)] = handle.value();
    outSlot = handle.value().slot();
    return true;
}

Expected<BufferHandle> CreateSkinningJointPaletteBuffer(
    mut GraphicsRuntime graphics,
    in Name debugName,
    in u32 jointCount,
    in usize jointMatrixByteSize,
    in u64 handleValue
){
    BufferDesc jointPaletteBufferDesc = BufferDesc();
    jointPaletteBufferDesc
        .setByteSize(ComputeJointPaletteBufferByteSize(jointCount, jointMatrixByteSize))
        .setStructStride(cast<u32>(jointMatrixByteSize))
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
        .setDebugName(debugName)
        .setInitialState(ResourceStates::Common)
    ;
    const Expected<BufferHandle> jointPaletteBufferResult = graphics.createBuffer(jointPaletteBufferDesc);
    if(!jointPaletteBufferResult.has_value()){
        error("MeshSkinningSystem: failed to create joint palette buffer for runtime mesh '{}'", handleValue);
        return MakeUnexpected(Failure());
    }
    return jointPaletteBufferResult.value();
}

Expected<BufferHandle> CreateSkinningBindlessSlotsBuffer(
    mut GraphicsRuntime graphics,
    in Name debugName,
    in usize slotsByteSize,
    in u64 handleValue
){
    BufferDesc bindlessSlotsBufferDesc = BufferDesc();
    bindlessSlotsBufferDesc
        .setByteSize(cast<u64>(slotsByteSize))
        .setIsConstantBuffer(true)
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
        .setDebugName(debugName)
        .enableAutomaticStateTracking(ResourceStates::Common)
    ;
    const Expected<BufferHandle> bindlessResourceSlotsBufferResult = graphics.createBuffer(bindlessSlotsBufferDesc);
    if(!bindlessResourceSlotsBufferResult.has_value()){
        error("MeshSkinningSystem: failed to create bindless slot buffer for runtime mesh '{}'", handleValue);
        return MakeUnexpected(Failure());
    }
    return bindlessResourceSlotsBufferResult.value();
}

b8 MeshSkinningSystem::createRuntimeResourceBindlessHeapHandles(
    mut MeshSkinningRuntimeInstance instance,
    mut MeshSkinningRuntimeResources resources
){
    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized()){
        error("MeshSkinningSystem: runtime mesh '{}' requires the initialized global descriptor heap", instance.handle.value);
        return false;
    }
    if(!resources.bindlessResourceSlotsBuffer.valid() || !instance.hasPersistentComputeBuffers()){
        error("MeshSkinningSystem: runtime mesh '{}' has incomplete persistent compute buffers", instance.handle.value);
        return false;
    }

    const b8 requiredRegistered =
        RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::RestPosition, DescriptorWriteItemStructuredBufferSrv(0, instance.restPositionBuffer.deref()), resources, resources.bindlessResourceSlots.restPosition)
        && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::SkinnedPosition, DescriptorWriteItemStructuredBufferUav(0, instance.skinnedPositionBuffer.deref()), resources, resources.bindlessResourceSlots.skinnedPosition)
        && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::RestNormal, DescriptorWriteItemStructuredBufferSrv(0, instance.restNormalBuffer.deref()), resources, resources.bindlessResourceSlots.restNormal)
        && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::SkinnedNormal, DescriptorWriteItemStructuredBufferUav(0, instance.skinnedNormalBuffer.deref()), resources, resources.bindlessResourceSlots.skinnedNormal)
        && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::RestTangent, DescriptorWriteItemStructuredBufferSrv(0, instance.restTangentBuffer.deref()), resources, resources.bindlessResourceSlots.restTangent)
        && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::SkinnedTangent, DescriptorWriteItemStructuredBufferUav(0, instance.skinnedTangentBuffer.deref()), resources, resources.bindlessResourceSlots.skinnedTangent)
        && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::MeshletDesc, DescriptorWriteItemStructuredBufferSrv(0, instance.meshletDescBuffer.deref()), resources, resources.bindlessResourceSlots.meshletDesc)
        && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::PositionRefDeltas, DescriptorWriteItemRawBufferSrv(0, instance.meshletPositionRefDeltaBuffer.deref()), resources, resources.bindlessResourceSlots.positionRefDeltas)
        && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::AttributeRefDeltas, DescriptorWriteItemRawBufferSrv(0, instance.meshletAttributeRefDeltaBuffer.deref()), resources, resources.bindlessResourceSlots.attributeRefDeltas)
        && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::AttributeSkins, DescriptorWriteItemStructuredBufferSrv(0, instance.attributeSkinBuffer.deref()), resources, resources.bindlessResourceSlots.attributeSkins)
        && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::LocalVertexRefs, DescriptorWriteItemStructuredBufferSrv(0, instance.meshletLocalVertexRefBuffer.deref()), resources, resources.bindlessResourceSlots.localVertexRefs)
        && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::PrimitiveIndices, DescriptorWriteItemRawBufferSrv(0, instance.meshletPrimitiveIndexBuffer.deref()), resources, resources.bindlessResourceSlots.primitiveIndices)
        && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::MeshletBounds, DescriptorWriteItemRawBufferUav(0, instance.meshletBoundsBuffer.deref()), resources, resources.bindlessResourceSlots.meshletBounds)
        && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::MeshletLocalBounds, DescriptorWriteItemRawBufferUav(0, instance.meshletLocalBoundsBuffer.deref()), resources, resources.bindlessResourceSlots.meshletLocalBounds)
        && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::LocalBounds, DescriptorWriteItemRawBufferUav(0, instance.localBoundsBuffer.deref()), resources, resources.bindlessResourceSlots.localBounds)
    ;
    if(!requiredRegistered){
        this.releaseRuntimeResourceBindlessHeapHandles(resources);
        error("MeshSkinningSystem: failed to register persistent compute buffers for runtime mesh '{}' in the descriptor heap", instance.handle.value);
        return false;
    }

    if(resources.skinCount != 0u){
        if(!resources.skinBuffer.valid() || !resources.jointPaletteBuffer.valid()){
            this.releaseRuntimeResourceBindlessHeapHandles(resources);
            error("MeshSkinningSystem: runtime mesh '{}' has incomplete persistent skinning payload buffers", instance.handle.value);
            return false;
        }
        const b8 skinRegistered =
            RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::SkinInfluences, DescriptorWriteItemStructuredBufferSrv(0, resources.skinBuffer.deref()), resources, resources.bindlessResourceSlots.skinInfluences)
            && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::JointPalette, DescriptorWriteItemStructuredBufferSrv(0, resources.jointPaletteBuffer.deref()), resources, resources.bindlessResourceSlots.jointPalette)
        ;
        if(!skinRegistered){
            this.releaseRuntimeResourceBindlessHeapHandles(resources);
            error("MeshSkinningSystem: failed to register persistent compute buffers for runtime mesh '{}' in the descriptor heap", instance.handle.value);
            return false;
        }
    }

    if(instance.attributeBuffer.valid()){
        if(!RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::AttributeBuffer, DescriptorWriteItemRawBufferUav(0, instance.attributeBuffer.deref()), resources, resources.bindlessResourceSlots.attributeBuffer)){
            this.releaseRuntimeResourceBindlessHeapHandles(resources);
            error("MeshSkinningSystem: failed to register persistent compute buffers for runtime mesh '{}' in the descriptor heap", instance.handle.value);
            return false;
        }
    }

    const Expected<GpuDescriptorHandle> resourceSlots = RegisterSkinningUniformBufferDescriptor(heap, resources.bindlessResourceSlotsBuffer.deref());
    if(!resourceSlots.has_value()){
        this.releaseRuntimeResourceBindlessHeapHandles(resources);
        error("MeshSkinningSystem: failed to register persistent compute buffers for runtime mesh '{}' in the descriptor heap", instance.handle.value);
        return false;
    }
    resources.bindlessHeapHandles.resourceSlots = resourceSlots.value();
    return true;
}


