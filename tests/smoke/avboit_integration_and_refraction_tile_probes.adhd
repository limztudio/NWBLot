[cpp_header("<impl/assets/graphics/avboit/constants.h>"), cpp_name("NWB_AVBOIT_CONTROL_ACTIVE_PHYSICAL_SLICES")]
extern const u32 s_IntegrationProbeActiveSlicesIndex;
[cpp_header("<impl/assets/graphics/avboit/constants.h>"), cpp_name("NWB_AVBOIT_PUSH_PARAMS_EXTINCTION_FIXED_SCALE")]
extern const u32 s_IntegrationProbeExtinctionScaleIndex;
[cpp_header("<impl/assets/graphics/refraction/push_constants.h>"), cpp_name("NWB_REFRACTION_TILE_COUNTER_OFFSET")]
extern const u32 s_RefractionProbeShaderCounterOffset;
[cpp_header("<tests/smoke/assets/shaders/refraction_tile_probe_layout.h>"), cpp_name("NWB_SMOKE_REFRACTION_PROBE_GUARD_WORDS")]
extern const u32 s_RefractionProbeShaderGuardWords;
[cpp_header("<tests/smoke/assets/shaders/refraction_tile_probe_layout.h>"), cpp_name("NWB_SMOKE_REFRACTION_PROBE_HEADER_WORDS")]
extern const u32 s_RefractionProbeShaderHeaderWords;

const u32 s_AvboitIntegrationProbeWidth = 7u;
const u32 s_AvboitIntegrationProbeHeight = 3u;
const u32 s_AvboitIntegrationProbePixelCount = s_AvboitIntegrationProbeWidth * s_AvboitIntegrationProbeHeight;
const u32 s_AvboitIntegrationProbeSliceCount = 17u;
const u32 s_AvboitIntegrationSlicesPerWord = 4u;
const u32 s_AvboitIntegrationByteBits = 8u;
const u32 s_AvboitIntegrationProbeWordCount = 5u * s_AvboitIntegrationProbePixelCount;
const u32 s_AvboitIntegrationProbePhaseCount = 5u;
const u32 s_AvboitIntegrationProbeFixedScale = 16u;
const u32 s_AvboitOverflowInvalid = 0xffffffffu;
const u32 s_RefractionTileProbeSentinel = 0xa573d91bu;
const u32 s_RefractionTileProbePhaseCount = 6u;
const u32 s_RefractionTileProbeGuardWords = 16u;
const u32 s_RefractionTileProbeHeaderWords = 6u;
const u32 s_RefractionTileProbeArgumentBytes = 32u;
const u32 s_RefractionTileProbeArgumentWords = 8u + s_RefractionTileProbeGuardWords;
const u32 s_RefractionTileProbePixelCount = s_RefractionTileProbeWidth * s_RefractionTileProbeHeight;
const u32 s_RefractionTileProbeQueueWords = s_RefractionTileProbeTileCount + s_RefractionTileProbeGuardWords;
const u32 s_RefractionTileProbeVisitWords = s_RefractionTileProbeHeaderWords + s_RefractionTileProbeTileCount + s_RefractionTileProbePixelCount + s_RefractionTileProbeGuardWords;
const u32 s_RefractionTileProbeReadbackWords = s_RefractionTileProbeArgumentWords + s_RefractionTileProbeQueueWords + s_RefractionTileProbeVisitWords;
type IntegrationProbeExtinctionWords = Array<u32, s_AvboitIntegrationProbeWordCount>;
type IntegrationProbePixelWords = Array<u32, s_AvboitIntegrationProbePixelCount>;
type IntegrationProbeControlWords = Array<u32, s_AvboitProbeControlWordCount>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class AvboitIntegrationPhaseState{
    public Array<u32, s_AvboitIntegrationProbeWordCount> words;
    public Array<u32, s_AvboitIntegrationProbePixelCount> overflowSlices;
    public u32 activeSlices = s_AvboitIntegrationProbeSliceCount;

    public void setExtinction(in u32 pixel, in u32 slice, in u32 value){
        const u32 wordIndex = (slice / s_AvboitIntegrationSlicesPerWord) * s_AvboitIntegrationProbePixelCount + pixel;
        const u32 shift = (slice % s_AvboitIntegrationSlicesPerWord) * s_AvboitIntegrationByteBits;
        this.words[wordIndex] |= value << shift;
    }

    public void prepare(in u32 phase){
        for(u32 i = 0u; i < s_AvboitIntegrationProbeWordCount; ++i)
            this.words[i] = 0u;
        for(u32 i = 0u; i < s_AvboitIntegrationProbePixelCount; ++i)
            this.overflowSlices[i] = s_AvboitOverflowInvalid;

        u32 active = s_AvboitIntegrationProbeSliceCount;
        if(phase == 3u)
            active = 5u;
        else if(phase == 4u)
            active = 1u;
        this.activeSlices = active;

        for(u32 pixel = 0u; pixel < s_AvboitIntegrationProbePixelCount; ++pixel){
            if(phase == 0u){
                this.setExtinction(pixel, 0u, 255u);
                this.setExtinction(pixel, 1u, 255u);
                continue;
            }
            if(phase == 1u)
                continue;

            const u32 bucket = pixel % 7u;
            if(bucket == 1u){
                u32 targetSlice = active - 1u;
                if(active > 12u)
                    targetSlice = 12u;
                this.setExtinction(pixel, targetSlice, 16u);
            }
            else if(bucket == 2u){
                this.setExtinction(pixel, 0u, 255u);
                this.setExtinction(pixel, 1u, 255u);
            }
            else if(bucket == 3u){
                this.overflowSlices[pixel] = 0u;
            }
            else if(bucket == 4u){
                this.overflowSlices[pixel] = active - 1u;
            }
            else if(bucket == 5u){
                const u32 rounded = ((active + 3u) / 4u) * 4u - 1u;
                this.setExtinction(pixel, Min(rounded, s_AvboitIntegrationProbeSliceCount - 1u), 255u);
            }
            else if(bucket == 6u){
                this.setExtinction(pixel, active - 1u, 16u);
            }
        }
    }
}

class GpuProbeProgress{
    public StringView stage = "probe initialization";
}

class AvboitIntegrationProbeTask{
    public BufferHandle extinction = BufferHandle();
    public BufferHandle overflow = BufferHandle();
    public BufferHandle control = BufferHandle();
    public BufferHandle slots = BufferHandle();
    public TextureHandle volume = TextureHandle();
    public StagingTextureHandle readback = StagingTextureHandle();
    public ComputePipelineHandle pipeline = ComputePipelineHandle();
    public ResourceStates volumeInitialState = ResourceStates::Unknown;
    public Array<u32, s_AvboitIntegrationProbeWordCount> words = IntegrationProbeExtinctionWords();
    public Array<u32, s_AvboitIntegrationProbePixelCount> overflowSlices = IntegrationProbePixelWords();
    public Array<u32, s_AvboitProbeControlWordCount> controlWords = IntegrationProbeControlWords();
    public RendererAvboitPushConstants push = RendererAvboitPushConstants();
    public mut GpuDescriptorHeap heap;
    public mut GpuProbeProgress progress;

    public AvboitIntegrationProbeTask(mut GpuDescriptorHeap heap, mut GpuProbeProgress progress){
        this.heap = heap;
        this.progress = progress;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return ComputeTransferProbeCommands(); }

    public b8 record(mut CommandList commands, in GpuTaskRecordContext context)const{
        this.progress.stage = "recording entry";
        if(context.hasCommandIrCapture())
            return false;
        this.progress.stage = "buffer uploads";
        if(
            !commands.tryWriteBuffer(this.extinction.deref(), this.words)
            || !commands.tryWriteBuffer(this.overflow.deref(), this.overflowSlices)
            || !commands.tryWriteBuffer(this.control.deref(), this.controlWords)
        )
            return false;
        this.progress.stage = "volume clear and integration dispatch";
        commands.clearTextureFloat(this.volume.deref(), TextureSubresourceSet(), Color(1.0f, 1.0f, 1.0f, 1.0f));
        commands.setBufferState(this.extinction.deref(), ResourceStates::ShaderResource);
        commands.setBufferState(this.overflow.deref(), ResourceStates::ShaderResource);
        commands.setBufferState(this.control.deref(), ResourceStates::ShaderResource);
        commands.setTextureState(this.volume.deref(), TextureSubresourceSet(), ResourceStates::UnorderedAccess);
        commands.commitBarriers();
        ComputeState state;
        state.setPipeline(this.pipeline.deref());
        commands.setComputeState(state);
        this.heap.bindCompute(commands, this.pipeline.deref());
        commands.setPushConstants(this.push);
        commands.dispatch(DivideUp(s_AvboitIntegrationProbePixelCount, cast<u32>(s_AvboitIntegrateGroupSizeX)), 1u, 1u);
        this.progress.stage = "volume copy and state restoration";
        commands.setTextureState(this.volume.deref(), TextureSubresourceSet(), ResourceStates::CopySource);
        commands.commitBarriers();
        commands.copyTexture(this.readback.deref(), TextureSlice(), this.volume.deref(), TextureSlice());
        commands.setBufferState(this.extinction.deref(), ResourceStates::CopyDest);
        commands.setBufferState(this.overflow.deref(), ResourceStates::CopyDest);
        commands.setBufferState(this.control.deref(), ResourceStates::CopyDest);
        commands.setTextureState(this.volume.deref(), TextureSubresourceSet(), ResourceStates::CopyDest);
        commands.commitBarriers();
        if(commands.commandRecordingFailed())
            return false;
        this.progress.stage = "native close and submission";
        return true;
    }
}

class RefractionTileProbeTask{
    public TextureHandle depth = TextureHandle();
    public BufferHandle queue = BufferHandle();
    public BufferHandle reversedQueue = BufferHandle();
    public BufferHandle arguments = BufferHandle();
    public BufferHandle visits = BufferHandle();
    public BufferHandle slots = BufferHandle();
    public BufferHandle readback = BufferHandle();
    public ComputePipelineHandle classify = ComputePipelineHandle();
    public ComputePipelineHandle finalize = ComputePipelineHandle();
    public ComputePipelineHandle verifyCompact = ComputePipelineHandle();
    public ComputePipelineHandle verifyDense = ComputePipelineHandle();
    public RefractionPushConstants push = RefractionPushConstants();
    public u32 denseTileListSlot = 0u;
    public u32 phase = 0u;
    public mut GpuDescriptorHeap heap;
    public mut GpuProbeProgress progress;

    public RefractionTileProbeTask(mut GpuDescriptorHeap heap, mut GpuProbeProgress progress){
        this.heap = heap;
        this.progress = progress;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return ComputeTransferProbeCommands(); }

    public b8 record(mut CommandList commands, in GpuTaskRecordContext context)const{
        this.progress.stage = "resource initialization";
        if(context.hasCommandIrCapture())
            return false;
        f32 depth = 1.0f;
        if(this.phase == 0u || this.phase == 5u)
            depth = 0.5f;
        commands.clearTextureFloat(this.depth.deref(), TextureSubresourceSet(), Color(depth));
        commands.setTextureState(this.depth.deref(), TextureSubresourceSet(), ResourceStates::CopyDest, true);
        commands.commitBarriers();
        if(this.phase == 2u){
            const Array<u32, 6u> sparseTiles(0u, s_RefractionTileProbeTilesX - 1u, (s_RefractionTileProbeTilesY - 1u) * s_RefractionTileProbeTilesX, s_RefractionTileProbeTileCount - 1u, 65534u, 65535u);
            for(in u32 tile : sparseTiles){
                const i32 x = cast<i32>((tile % s_RefractionTileProbeTilesX) * s_RefractionTileProbeGroupSize);
                const i32 y = cast<i32>((tile / s_RefractionTileProbeTilesX) * s_RefractionTileProbeGroupSize);
                commands.clearTextureRectFloat(this.depth.deref(), TextureSubresourceSet(), Rect(x, x + 1, y, y + 1), Color(0.5f));
            }
        }
        else if(this.phase == 3u || this.phase == 4u){
            const u32 count = ExpectedRefractionProbeTileCount(this.phase);
            const u32 fullRows = count / s_RefractionTileProbeTilesX;
            commands.clearTextureRectFloat(this.depth.deref(), TextureSubresourceSet(), Rect(0, cast<i32>(s_RefractionTileProbeWidth), 0, cast<i32>(fullRows * s_RefractionTileProbeGroupSize)), Color(0.5f));
            const u32 remainder = count % s_RefractionTileProbeTilesX;
            if(remainder != 0u){
                const i32 y = cast<i32>(fullRows * s_RefractionTileProbeGroupSize);
                commands.clearTextureRectFloat(this.depth.deref(), TextureSubresourceSet(), Rect(0, cast<i32>(remainder * s_RefractionTileProbeGroupSize), y, y + s_RefractionTileProbeGroupSize), Color(0.5f));
            }
        }
        else if(this.phase == 5u){
            const i32 x = cast<i32>((s_RefractionTileProbeMissingTile % s_RefractionTileProbeTilesX) * s_RefractionTileProbeGroupSize);
            const i32 y = cast<i32>((s_RefractionTileProbeMissingTile / s_RefractionTileProbeTilesX) * s_RefractionTileProbeGroupSize);
            commands.clearTextureRectFloat(this.depth.deref(), TextureSubresourceSet(), Rect(x, x + s_RefractionTileProbeGroupSize, y, y + s_RefractionTileProbeGroupSize), Color(1.0f));
        }
        Array<u32, s_RefractionTileProbeArgumentWords> arguments;
        arguments.fill(s_RefractionTileProbeSentinel);
        for(u32 word = 0u; word < s_RefractionTileProbeArgumentBytes / size_of<u32>(); ++word)
            arguments[word] = 0u;
        Array<u32, s_RefractionTileProbeGuardWords> guards;
        guards.fill(s_RefractionTileProbeSentinel);
        commands.clearBufferUInt(this.queue.deref(), s_RefractionTileProbeSentinel);
        commands.clearBufferUInt(this.visits.deref(), 0u);
        commands.setBufferState(this.visits.deref(), ResourceStates::CopyDest, true);
        commands.commitBarriers();
        if(!commands.tryWriteBuffer(this.arguments.deref(), arguments) || !commands.tryWriteBuffer(this.visits.deref(), guards, cast<u64>(s_RefractionTileProbeVisitWords - s_RefractionTileProbeGuardWords) * size_of<u32>()))
            return false;

        this.progress.stage = "production tile classification";
        commands.setTextureState(this.depth.deref(), TextureSubresourceSet(), ResourceStates::ShaderResource);
        commands.setBufferState(this.queue.deref(), ResourceStates::UnorderedAccess);
        commands.setBufferState(this.arguments.deref(), ResourceStates::UnorderedAccess);
        commands.setBufferState(this.visits.deref(), ResourceStates::UnorderedAccess);
        commands.commitBarriers();
        ComputeState classify;
        classify.setPipeline(this.classify.deref());
        commands.setComputeState(classify);
        this.heap.bindCompute(commands, this.classify.deref());
        commands.setPushConstants(this.push);
        commands.dispatch(s_RefractionTileProbeTilesX, s_RefractionTileProbeTilesY, 1u);

        this.progress.stage = "production indirect route finalization";
        commands.setBufferState(this.arguments.deref(), ResourceStates::UnorderedAccess, true);
        commands.commitBarriers();
        ComputeState finalize;
        finalize.setPipeline(this.finalize.deref());
        commands.setComputeState(finalize);
        this.heap.bindCompute(commands, this.finalize.deref());
        commands.setPushConstants(this.push);
        commands.dispatch(1u, 1u, 1u);

        this.progress.stage = "compact indirect mapping verification";
        commands.setBufferState(this.queue.deref(), ResourceStates::ShaderResource);
        commands.setBufferState(this.arguments.deref(), ResourceStates::ShaderResource | ResourceStates::IndirectArgument);
        commands.commitBarriers();
        ComputeState verifyCompact;
        verifyCompact.setPipeline(this.verifyCompact.deref()).setIndirectParams(this.arguments.deref());
        commands.setComputeState(verifyCompact);
        this.heap.bindCompute(commands, this.verifyCompact.deref());
        commands.setPushConstants(this.push);
        commands.dispatchIndirect(0u);

        this.progress.stage = "dense indirect mapping verification";
        commands.setBufferState(this.visits.deref(), ResourceStates::UnorderedAccess, true);
        commands.commitBarriers();
        ComputeState verifyDense;
        verifyDense.setPipeline(this.verifyDense.deref()).setIndirectParams(this.arguments.deref());
        commands.setComputeState(verifyDense);
        this.heap.bindCompute(commands, this.verifyDense.deref());
        RefractionPushConstants verifyPush = this.push;
        verifyPush.tileListSlot = this.denseTileListSlot;
        commands.setPushConstants(verifyPush);
        commands.dispatchIndirect(s_RefractionDenseArgumentOffset);

        this.progress.stage = "counter and queue readback";
        const Array<BufferHandle, 3u> buffers(this.arguments, this.queue, this.visits);
        for(in BufferHandle buffer : buffers)
            commands.setBufferState(buffer.deref(), ResourceStates::CopySource);
        commands.commitBarriers();
        u64 offset = 0u;
        for(in BufferHandle buffer : buffers){
            const u64 bytes = buffer.deref().getCreationDescription().byteSize;
            commands.copyBuffer(this.readback.deref(), offset, buffer.deref(), 0u, bytes);
            offset += bytes;
            commands.setBufferState(buffer.deref(), ResourceStates::CopyDest);
        }
        commands.setTextureState(this.depth.deref(), TextureSubresourceSet(), ResourceStates::CopyDest);
        commands.commitBarriers();
        if(commands.commandRecordingFailed())
            return false;
        this.progress.stage = "native close and submission";
        return true;
    }
}

static_assert(size_of<RefractionPushConstants>() == 11u * size_of<u32>());
static_assert(s_RefractionTileProbeTileCount == 66049u && s_RefractionTileProbeTileCount > s_RefractionTileProbeMaxGroupCountX);
static_assert(s_RefractionShaderTileArgumentBytes == 32u && s_RefractionProbeShaderCounterOffset == 12u && s_RefractionShaderDenseArgumentOffset == 16u);
static_assert(s_RefractionProbeShaderGuardWords == s_RefractionTileProbeGuardWords && s_RefractionProbeShaderHeaderWords == s_RefractionTileProbeHeaderWords);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 VerifyAvboitIntegrationSliceValues(
    in AvboitIntegrationPhaseState state,
    in u32 phase,
    in u32 slice,
    in Span<f32> observedPixels,
    in Span<f32> expectedPixels,
    mut Array<u32, s_AvboitIntegrationProbePixelCount> extinctionFixed
){
    for(u32 pixel = 0u; pixel < s_AvboitIntegrationProbePixelCount; ++pixel){
        const f32 expected = expectedPixels[pixel];
        const f32 actual = observedPixels[pixel];
        b8 mismatch = !IsFinite(VectorSingle(actual));
        if(!mismatch){
            if(extinctionFixed[pixel] == 0u)
                mismatch = actual != 1.0f;
            else{
                const VectorSingle minTol(0.0000002f);
                const VectorSingle relTol(expected * 0.002f);
                const f32 tolerance = VectorSelect(relTol, minTol, VectorGreater(minTol, relTol)).x;
                mismatch = VectorAbs(VectorSingle(actual - expected)).x > tolerance;
            }
        }
        if(mismatch){
            error(
                "AvboitIntegrationProbe: mismatch phase {} pixel {} slice {} expected {} observed {}"
                , phase
                , pixel
                , slice
                , expected
                , actual
            );
            return false;
        }
        if(slice < state.activeSlices){
            if(slice >= state.overflowSlices[pixel]){
                extinctionFixed[pixel] = 16u * s_AvboitIntegrationProbeFixedScale;
            }
            else{
                const u32 packed = state.words[(slice / 4u) * s_AvboitIntegrationProbePixelCount + pixel];
                const u32 byteVal = (packed >> ((slice % 4u) * 8u)) & 255u;
                extinctionFixed[pixel] = Min(extinctionFixed[pixel] + byteVal, 16u * s_AvboitIntegrationProbeFixedScale);
            }
        }
    }
    return true;
}

Expected<GpuTaskId> DeclareTrackedProbeTask<TaskT>(
    mut GpuTaskGraph graph,
    in Name probeName,
    in StringView label,
    in Span<GpuTaskResourceUse> uses,
    in TaskT payload,
    mut GpuProbeProgress progress
){
    progress.stage = "task declaration";
    GpuTaskDesc desc;
    desc.setIdentity(probeName).setMarkerLabel(label).setResourceUses(uses);
    TaskT recorded = payload;
    const auto task = graph.addPayloadTask(desc, recorded);
    if(task.has_value())
        progress.stage = "scheduling or initial-state recording admission";
    return task;
}

Expected<GpuTaskId> DeclareAvboitIntegrationProbe(in AvboitIntegrationProbeTask payload, mut GpuTaskGraph graph){
    const Name probeName = s_SmokeNameAvboitIntegrationProbe;
    payload.progress.stage = "buffer imports";
    const Array<ProbeBufferImport, 4u> buffers(
        ProbeBufferImport(payload.extinction, "Integration probe extinction", ResourceStates::CopyDest, GpuTaskResourceAccess::ReadWrite),
        ProbeBufferImport(payload.overflow, "Integration probe overflow", ResourceStates::CopyDest, GpuTaskResourceAccess::ReadWrite),
        ProbeBufferImport(payload.control, "Integration probe control", ResourceStates::CopyDest, GpuTaskResourceAccess::ReadWrite),
        ProbeBufferImport(payload.slots, "Integration probe heap slots", ResourceStates::ConstantBuffer, GpuTaskResourceAccess::Read)
    );
    Array<GpuTaskResourceUse, 6u> uses;
    if(!ImportProbeBufferUses(graph, buffers, uses))
        return MakeUnexpected(Failure());
    payload.progress.stage = "volume and staging imports";
    const ResourceStates initial = payload.volumeInitialState;
    GpuGraphResourceDesc textureDesc;
    textureDesc.setIdentity(probeName).setMarkerLabel("Integration probe transmittance volume").setType(GpuGraphResourceType::Texture).setInitialState(initial).setExternalFinalState(ResourceStates::CopyDest);
    const auto volume = graph.importTexture(payload.volume, textureDesc);
    GpuGraphResourceDesc stagingDesc;
    stagingDesc.setIdentity(s_SmokeNameAvboitIntegrationReadback).setMarkerLabel("Integration probe staging writes").setType(GpuGraphResourceType::HazardDomain);
    const auto readback = graph.importHazardDomain(stagingDesc);
    if(!volume.has_value())
        return MakeUnexpected(Failure());
    uses[4u].resource = volume.value();
    uses[4u].requiredState = ResourceStates::CopyDest;
    uses[4u].access = GpuTaskResourceAccess::Write;
    if(!readback.has_value())
        return MakeUnexpected(Failure());
    uses[5u].resource = readback.value();
    uses[5u].requiredState = ResourceStates::Unknown;
    uses[5u].access = GpuTaskResourceAccess::Write;
    return DeclareTrackedProbeTask(graph, probeName, "AVBOIT sparse integration boundary probe", uses, payload, payload.progress);
}

Expected<GpuTaskId> DeclareRefractionTileProbe(in RefractionTileProbeTask payload, mut GpuTaskGraph graph){
    const Name probeName = s_SmokeNameRefractionTileProbe;
    payload.progress.stage = "graph imports";
    const Array<ProbeBufferImport, 6u> buffers(
        ProbeBufferImport(payload.queue, "Refraction probe tile queue", ResourceStates::CopyDest, GpuTaskResourceAccess::Write),
        ProbeBufferImport(payload.arguments, "Refraction probe indirect arguments", ResourceStates::CopyDest, GpuTaskResourceAccess::Write),
        ProbeBufferImport(payload.visits, "Refraction probe visit counters", ResourceStates::CopyDest, GpuTaskResourceAccess::Write),
        ProbeBufferImport(payload.slots, "Refraction probe heap selectors", ResourceStates::ConstantBuffer, GpuTaskResourceAccess::Read),
        ProbeBufferImport(payload.readback, "Refraction probe readback", ResourceStates::CopyDest, GpuTaskResourceAccess::Write),
        ProbeBufferImport(payload.reversedQueue, "Refraction probe reversed dense tile list", ResourceStates::ShaderResource, GpuTaskResourceAccess::Read)
    );
    Array<GpuTaskResourceUse, 7u> uses;
    if(!ImportProbeBufferUses(graph, buffers, uses))
        return MakeUnexpected(Failure());
    ResourceStates initial = ResourceStates::Unknown;
    if(payload.phase != 0u)
        initial = ResourceStates::CopyDest;
    GpuGraphResourceDesc textureDesc;
    textureDesc.setIdentity(probeName).setMarkerLabel("Refraction probe capture depth").setType(GpuGraphResourceType::Texture).setInitialState(initial).setExternalFinalState(ResourceStates::CopyDest);
    const auto depth = graph.importTexture(payload.depth, textureDesc);
    if(!depth.has_value())
        return MakeUnexpected(Failure());
    uses[6u].resource = depth.value();
    uses[6u].requiredState = ResourceStates::CopyDest;
    uses[6u].access = GpuTaskResourceAccess::Write;
    return DeclareTrackedProbeTask(graph, probeName, "Refraction tile queue boundary probe", uses, payload, payload.progress);
}

Expected<BufferHandle> CreateProbeSlots(mut GraphicsRuntime graphics, in Name name, in DeferredBindlessResourceSlots slots, mut GpuDescriptorHandle descriptor){
    const Array<DeferredBindlessResourceSlots, 1u> data(slots);
    StandaloneBufferSetupDesc setup;
    setup.bufferDesc.setDebugName(name).setByteSize(size_of<DeferredBindlessResourceSlots>()).setIsConstantBuffer(true).enableAutomaticStateTracking(ResourceStates::ConstantBuffer);
    setup.queue = CommandQueue::Graphics;
    setup.setData<DeferredBindlessResourceSlots>(Span<DeferredBindlessResourceSlots>(data));
    const auto buffer = graphics.standaloneGraph().setupBuffer(setup);
    if(!buffer.has_value())
        return MakeUnexpected(Failure());
    mut GpuDescriptorHeap heap = graphics.getDevice().getDescriptorHeap();
    const auto uniform = heap.allocate(GpuDescriptorClass::UniformBuffer);
    if(!uniform.has_value())
        return MakeUnexpected(Failure());
    descriptor = uniform.value();
    if(!heap.write(descriptor, DescriptorWriteItemConstantBuffer(0u, buffer.value().deref())))
        return MakeUnexpected(Failure());
    return buffer;
}

b8 CompareIntegrationSlice(in StagingTextureMapping mapping, in AvboitIntegrationPhaseState phaseState, in u32 phase, in u32 slice, mut Array<u32, s_AvboitIntegrationProbePixelCount> extinctionFixed){
    const Span<u8> bytes = mapping.readBytes();
    const usize rowBytes = s_AvboitIntegrationProbeWidth * size_of<u16>();
    if(!ContainsSmokeImageRows(bytes.size(), mapping.rowPitch, rowBytes, s_AvboitIntegrationProbeHeight))
        return false;
    Array<f32, s_AvboitIntegrationProbePixelCount> observedPixels;
    Array<f32, s_AvboitIntegrationProbePixelCount> expectedPixels;
    for(u32 pixel = 0u; pixel < s_AvboitIntegrationProbePixelCount; ++pixel){
        const usize offset = (pixel / s_AvboitIntegrationProbeWidth) * mapping.rowPitch + (pixel % s_AvboitIntegrationProbeWidth) * size_of<u16>();
        const u16 halfBits = cast<u16>(cast<u32>(bytes[offset]) | (cast<u32>(bytes[offset + 1u]) << 8u));
        const f32 exponent = -cast<f32>(extinctionFixed[pixel]) / cast<f32>(s_AvboitIntegrationProbeFixedScale);
        expectedPixels[pixel] = ConvertHalfToFloat(ConvertFloatToHalf(VectorExp(VectorSingle(exponent)).x));
        observedPixels[pixel] = ConvertHalfToFloat(halfBits);
    }
    return VerifyAvboitIntegrationSliceValues(phaseState, phase, slice, Span<f32>(observedPixels), Span<f32>(expectedPixels), extinctionFixed);
}

b8 RunAvboitIntegrationProbe(in ActiveSceneSubsystems sceneSubsystems, mut ProjectRuntimeContext context){
    AvboitIntegrationPhaseState phaseState = AvboitIntegrationPhaseState();
    mut GraphicsRuntime graphics = context.graphics;
    mut Device device = graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    const Name probeName = s_SmokeNameAvboitIntegrationProbe;
    const auto transparent = sceneSubsystems.findSubsystem<TransparentSubsystem>();
    if(!transparent.has_value() || !transparent.value().avboitIntegrateCs.valid())
        return false;
    const Expected<ComputePipelineHandle> pipelineResult = LoadGpuProbePipeline(context, transparent.value().avboitIntegrateCs.name(), s_DefaultVariant, probeName, "AvboitIntegrationProbe", size_of<RendererAvboitPushConstants>());
    if(!pipelineResult.has_value())
        return false;
    const ComputePipelineHandle pipeline = pipelineResult.value();
    const auto extinction = CreateGpuProbeWordBuffer(graphics, s_SmokeNameAvboitIntegrationExtinction, s_AvboitIntegrationProbeWordCount, false, false, false);
    const auto overflow = CreateGpuProbeWordBuffer(graphics, s_SmokeNameAvboitIntegrationOverflow, s_AvboitIntegrationProbePixelCount, false, false, false);
    const auto control = CreateGpuProbeWordBuffer(graphics, s_SmokeNameAvboitIntegrationControl, s_AvboitProbeControlWordCount, false, false, false);
    TextureDesc textureDesc;
    textureDesc.setWidth(s_AvboitIntegrationProbeWidth)
        .setHeight(s_AvboitIntegrationProbeHeight)
        .setDepth(s_AvboitIntegrationProbeSliceCount)
        .setDimension(TextureDimension::Texture3D)
        .setFormat(s_ShaderAvboitTransmittanceCoreFormat)
        .setIsUAV(true)
        .setName(probeName)
        .setInitialState(ResourceStates::CopyDest)
        .setKeepInitialState(true)
    ;
    const auto volume = graphics.createTexture(textureDesc);
    const auto readback = device.createStagingTexture(textureDesc, CpuAccessMode::Read);
    if(!extinction.has_value() || !overflow.has_value() || !control.has_value() || !volume.has_value() || !readback.has_value())
        return false;
    Array<GpuDescriptorHandle, 5u> descriptors;
    GpuDescriptorRetirementGuard retire(heap, Span<GpuDescriptorHandle>(descriptors));
    const Array<BufferHandle, 3u> buffers(extinction.value(), overflow.value(), control.value());
    for(u32 index = 0u; index < buffers.size(); ++index){
        const auto descriptor = heap.allocate(GpuDescriptorClass::StorageBuffer);
        if(!descriptor.has_value())
            return false;
        descriptors[index] = descriptor.value();
        if(!heap.write(descriptor.value(), DescriptorWriteItemStructuredBufferUav(0u, buffers[index].deref())))
            return false;
    }
    const auto storage = heap.allocate(GpuDescriptorClass::StorageImage);
    if(!storage.has_value())
        return false;
    descriptors[3] = storage.value();
    if(!heap.write(storage.value(), DescriptorWriteItemTextureUav(0u, volume.value().deref(), textureDesc.format, TextureSubresourceSet(), TextureDimension::Texture3D)))
        return false;
    DeferredBindlessResourceSlots slots;
    slots.avboitExtinction = descriptors[0].slot();
    slots.avboitExtinctionOverflow = descriptors[1].slot();
    slots.avboitControl = descriptors[2].slot();
    slots.avboitTransmittanceStorage = descriptors[3].slot();
    const auto slotBuffer = CreateProbeSlots(graphics, s_SmokeNameAvboitIntegrationSlots, slots, descriptors[4u]);
    if(!slotBuffer.has_value())
        return false;
    GpuProbeProgress progress;
    AvboitIntegrationProbeTask payload(heap, progress);
    payload.extinction = extinction.value();
    payload.overflow = overflow.value();
    payload.control = control.value();
    payload.slots = slotBuffer.value();
    payload.volume = volume.value();
    payload.readback = readback.value();
    payload.pipeline = pipeline;
    payload.push.frame[0] = s_AvboitIntegrationProbeWidth * 4u;
    payload.push.frame[1] = s_AvboitIntegrationProbeHeight * 4u;
    payload.push.frame[2] = s_AvboitIntegrationProbeWidth;
    payload.push.frame[3] = s_AvboitIntegrationProbeHeight;
    payload.push.volume[1] = s_AvboitIntegrationProbeSliceCount;
    payload.push.volume[2] = s_AvboitIntegrationProbeWordCount;
    payload.push.params = f32x4(VectorSetByIndex(VectorZero(), cast<f32>(s_AvboitIntegrationProbeFixedScale), s_IntegrationProbeExtinctionScaleIndex));
    payload.push.heapSlots[0] = descriptors[4u].slot();
    for(u32 phase = 0u; phase < s_AvboitIntegrationProbePhaseCount; ++phase){
        phaseState.prepare(phase);
        payload.volumeInitialState = ResourceStates::Unknown;
        if(phase != 0u)
            payload.volumeInitialState = ResourceStates::CopyDest;
        payload.words = phaseState.words;
        payload.overflowSlices = phaseState.overflowSlices;
        payload.controlWords.fill(0u);
        payload.controlWords[s_IntegrationProbeActiveSlicesIndex] = phaseState.activeSlices;
        const auto token = graphics.standaloneGraph().submitStandaloneTaskGraph(
            lambda[in payload](mut GpuTaskGraph graph) -> Expected<GpuTaskId>{ return DeclareAvboitIntegrationProbe(payload, graph); }, GpuPhysicalQueueId());
        if(!token.has_value()){
            error("AvboitIntegrationProbe: phase {} standalone graph rejected at {}", phase, progress.stage);
            return false;
        }
        if(!device.waitForSubmissionToken(token.value())){
            error("AvboitIntegrationProbe: phase {} submission completion wait failed", phase);
            return false;
        }
        Array<u32, s_AvboitIntegrationProbePixelCount> extinctionFixed;
        for(u32 slice = 0u; slice < s_AvboitIntegrationProbeSliceCount; ++slice){
            TextureSlice region;
            region.setOrigin(0u, 0u, slice).setSize(s_AvboitIntegrationProbeWidth, s_AvboitIntegrationProbeHeight, 1u);
            const auto mapping = device.mapStagingTexture(payload.readback.deref(), region, CpuAccessMode::Read);
            if(!mapping.has_value()){
                error("AvboitIntegrationProbe: phase {} volume readback comparison failed", phase);
                return false;
            }
            const b8 matched = CompareIntegrationSlice(mapping.value(), phaseState, phase, slice, extinctionFixed);
            device.unmapStagingTexture(payload.readback.deref());
            if(!matched){
                error("AvboitIntegrationProbe: phase {} volume readback comparison failed", phase);
                return false;
            }
        }
    }
    [essential] info("AvboitIntegrationProbe: passed 5 phases with empty, late, partial, saturation, wrapped overflow and active-to-empty clear checks");
    return true;
}

void BuildRefractionProbeReversedTiles(mut Vector<u32> outTiles){
    outTiles.resize(s_RefractionTileProbeQueueWords, s_RefractionTileProbeSentinel);
    for(u32 tile = 0u; tile < s_RefractionTileProbeTileCount; ++tile)
        outTiles[tile] = s_RefractionTileProbeTileCount - 1u - tile;
}

b8 VerifyRefractionTileProbeReadback(
    in u32 phase,
    in Span<u32> words,
    in u64 argBytes,
    in u64 queueBytes,
    in u64 visitBytes,
    in u64 readbackBytes
){
    const u32 count = ExpectedRefractionProbeTileCount(phase);
    const b8 dense = count == s_RefractionTileProbeTileCount;
    u32 compactX = Min(count, s_RefractionTileProbeMaxGroupCountX);
    u32 compactY = Max(1u, (count + s_RefractionTileProbeMaxGroupCountX - 1u) / s_RefractionTileProbeMaxGroupCountX);
    u32 denseX = 0u;
    u32 denseY = 1u;
    if(dense){
        compactX = 0u;
        compactY = 1u;
        denseX = s_RefractionTileProbeTilesX;
        denseY = s_RefractionTileProbeTilesY;
    }

    Array<u32, 8u> expectedArguments;
    expectedArguments[0u] = compactX;
    expectedArguments[1u] = compactY;
    expectedArguments[2u] = 1u;
    expectedArguments[3u] = count;
    expectedArguments[4u] = denseX;
    expectedArguments[5u] = denseY;
    expectedArguments[6u] = 1u;
    expectedArguments[7u] = 0u;

    for(u32 word = 0u; word < s_RefractionTileProbeArgumentWords; ++word){
        u32 expected = s_RefractionTileProbeSentinel;
        if(word < 8u)
            expected = expectedArguments[word];
        if(words[word] != expected){
            error(
                "RefractionTileProbe: phase {} argument word {} expected {} observed {}"
                , phase
                , word
                , expected
                , words[word]
            );
            return false;
        }
    }

    Vector<u8> seen;
    seen.resize(s_RefractionTileProbeTileCount, 0u);
    const u32 queueBase = s_RefractionTileProbeArgumentWords;
    for(u32 index = 0u; index < count; ++index){
        const u32 tile = words[queueBase + index];
        if(tile >= s_RefractionTileProbeTileCount || !IsRefractionProbeTileActive(phase, tile) || seen[tile] != 0u){
            error(
                "RefractionTileProbe: phase {} invalid or duplicate queue tile {} at {}"
                , phase
                , tile
                , index
            );
            return false;
        }
        seen[tile] = 1u;
    }

    const u32 visitBase = queueBase + s_RefractionTileProbeQueueWords;
    for(u32 index = count; index < s_RefractionTileProbeQueueWords; ++index){
        const u32 tile = words[queueBase + index];
        if(tile != s_RefractionTileProbeSentinel){
            [essential] info(
                "RefractionTileProbe: readback layout argument_bytes={} queue_bytes={} visit_bytes={} readback_bytes={} expected_queue_words={} queue_offset={} visit_offset={}"
                , argBytes
                , queueBytes
                , visitBytes
                , readbackBytes
                , s_RefractionTileProbeQueueWords
                , cast<u64>(s_RefractionTileProbeArgumentWords) * 4u
                , cast<u64>(visitBase) * 4u
            );
            u32 neighborStart = 0u;
            if(count > 4u)
                neighborStart = count - 4u;
            const u32 neighborEnd = Min(count + s_RefractionTileProbeGuardWords, s_RefractionTileProbeQueueWords);
            for(u32 neighbor = neighborStart; neighbor < neighborEnd; ++neighbor)
                [essential] info("RefractionTileProbe: queue[{}]=0x{:08x}", neighbor, words[queueBase + neighbor]);
            [essential] info(
                "RefractionTileProbe: counters groups={} tails={} errors={} edge_lanes={}"
                , words[visitBase + 0u]
                , words[visitBase + 1u]
                , words[visitBase + 2u]
                , words[visitBase + 3u]
            );
            error(
                "RefractionTileProbe: phase {} queue tail overwritten at {} expected 0x{:08x} observed 0x{:08x}"
                , phase
                , index
                , s_RefractionTileProbeSentinel
                , tile
            );
            return false;
        }
    }

    u32 pixelCount = 0u;
    for(u32 tile = 0u; tile < s_RefractionTileProbeTileCount; ++tile){
        u32 expected = 0u;
        if(IsRefractionProbeTileActive(phase, tile))
            expected = 1u;
        const u32 visitVal = words[visitBase + s_RefractionTileProbeHeaderWords + tile];
        if(cast<u32>(seen[tile]) != expected || visitVal != expected){
            error(
                "RefractionTileProbe: phase {} queue/resolve tile {} expected {} queue {} visits {}"
                , phase
                , tile
                , expected
                , seen[tile]
                , visitVal
            );
            return false;
        }
        const u32 width = Min(s_RefractionTileProbeGroupSize, s_RefractionTileProbeWidth - (tile % s_RefractionTileProbeTilesX) * s_RefractionTileProbeGroupSize);
        const u32 height = Min(s_RefractionTileProbeGroupSize, s_RefractionTileProbeHeight - (tile / s_RefractionTileProbeTilesX) * s_RefractionTileProbeGroupSize);
        pixelCount += width * height * expected;
    }

    const u32 compactGroups = compactX * compactY;
    const u32 denseGroups = denseX * denseY;
    const u32 groups = compactGroups + denseGroups;
    Array<u32, s_RefractionTileProbeHeaderWords> expectedHeader;
    expectedHeader[0u] = groups;
    expectedHeader[1u] = groups - count;
    expectedHeader[2u] = 0u;
    expectedHeader[3u] = count * s_RefractionTileProbeGroupSize * s_RefractionTileProbeGroupSize - pixelCount;
    expectedHeader[4u] = compactGroups;
    expectedHeader[5u] = denseGroups;

    for(u32 word = 0u; word < s_RefractionTileProbeHeaderWords; ++word){
        if(words[visitBase + word] != expectedHeader[word]){
            error(
                "RefractionTileProbe: phase {} counter {} expected {} observed {}"
                , phase
                , word
                , expectedHeader[word]
                , words[visitBase + word]
            );
            return false;
        }
    }

    const u32 pixelVisitBase = visitBase + s_RefractionTileProbeHeaderWords + s_RefractionTileProbeTileCount;
    for(u32 pixel = 0u; pixel < s_RefractionTileProbePixelCount; ++pixel){
        const u32 tile = ((pixel / s_RefractionTileProbeWidth) / s_RefractionTileProbeGroupSize) * s_RefractionTileProbeTilesX + (pixel % s_RefractionTileProbeWidth) / s_RefractionTileProbeGroupSize;
        const u32 actual = words[pixelVisitBase + pixel];
        if(actual != cast<u32>(seen[tile])){
            error(
                "RefractionTileProbe: phase {} pixel {} expected {} observed {}"
                , phase
                , pixel
                , seen[tile]
                , actual
            );
            return false;
        }
    }

    for(u32 word = s_RefractionTileProbeVisitWords - s_RefractionTileProbeGuardWords; word < s_RefractionTileProbeVisitWords; ++word){
        if(words[visitBase + word] != s_RefractionTileProbeSentinel){
            error("RefractionTileProbe: phase {} visit guard overwritten at {}", phase, word);
            return false;
        }
    }

    [essential] info(
        "RefractionTileProbe: phase {} active_tiles={} compact={}x{} dense={}x{} pixels={} tail_groups={} edge_lanes={} argument_bytes={}"
        , phase
        , count
        , compactX
        , compactY
        , denseX
        , denseY
        , pixelCount
        , expectedHeader[1u]
        , expectedHeader[3u]
        , s_RefractionTileProbeArgumentBytes
    );
    return true;
}

b8 RunRefractionTileProbe(in ActiveSceneSubsystems sceneSubsystems, mut ProjectRuntimeContext context){
    Vector<u32> reversedTiles;
    BuildRefractionProbeReversedTiles(reversedTiles);

    mut GraphicsRuntime graphics = context.graphics;
    mut Device device = graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    const Name probeName = s_SmokeNameRefractionTileProbe;
    const auto subsystem = sceneSubsystems.findSubsystem<RefractiveSubsystem>();
    const auto verify = sceneSubsystems.findSceneAsset<ComputeShader>(s_SmokeNameRefractionTileProbeCs);
    if(!subsystem.has_value() || !subsystem.value().refractionClassifyTilesCs.valid() || !subsystem.value().refractionFinalizeTilesCs.valid() || !verify.valid())
        return false;
    const u32 pushBytes = size_of<RefractionPushConstants>();
    const Expected<ComputePipelineHandle> classifyResult = LoadGpuProbePipeline(context, subsystem.value().refractionClassifyTilesCs.name(), s_DefaultVariant, probeName, "RefractionTileProbe", pushBytes);
    const Expected<ComputePipelineHandle> finalizeResult = LoadGpuProbePipeline(context, subsystem.value().refractionFinalizeTilesCs.name(), s_DefaultVariant, probeName, "RefractionTileProbe", pushBytes);
    const Expected<ComputePipelineHandle> verifyCompactResult = LoadGpuProbePipeline(context, verify.name(), "NWB_REFRACTION_DENSE_GRID=0", probeName, "RefractionTileProbe", pushBytes);
    const Expected<ComputePipelineHandle> verifyDenseResult = LoadGpuProbePipeline(context, verify.name(), "NWB_REFRACTION_DENSE_GRID=1", probeName, "RefractionTileProbe", pushBytes);
    if(!classifyResult.has_value() || !finalizeResult.has_value() || !verifyCompactResult.has_value() || !verifyDenseResult.has_value())
        return false;
    const ComputePipelineHandle classify = classifyResult.value();
    const ComputePipelineHandle finalize = finalizeResult.value();
    const ComputePipelineHandle verifyCompact = verifyCompactResult.value();
    const ComputePipelineHandle verifyDense = verifyDenseResult.value();
    StandaloneBufferSetupDesc reversedSetup;
    reversedSetup.bufferDesc.setDebugName(Name(s_SmokeNameRefractionTileProbeReversedQueue)).setByteSize(cast<u64>(s_RefractionTileProbeQueueWords) * size_of<u32>()).setStructStride(size_of<u32>());
    reversedSetup.bufferDesc.setCanHaveUAVs(true).setCanHaveRawViews(true).enableAutomaticStateTracking(ResourceStates::ShaderResource);
    reversedSetup.setData<u32>(Span<u32>(reversedTiles));
    reversedSetup.queue = CommandQueue::Graphics;
    const auto reversedQueue = graphics.standaloneGraph().setupBuffer(reversedSetup);
    const auto queue = CreateGpuProbeWordBuffer(graphics, s_SmokeNameRefractionTileProbeQueue, s_RefractionTileProbeQueueWords, true, false, false);
    const auto arguments = CreateGpuProbeWordBuffer(graphics, s_SmokeNameRefractionTileProbeArguments, s_RefractionTileProbeArgumentWords, true, true, false);
    const auto visits = CreateGpuProbeWordBuffer(graphics, s_SmokeNameRefractionTileProbeVisits, s_RefractionTileProbeVisitWords, true, false, false);
    const auto readback = CreateGpuProbeWordBuffer(graphics, s_SmokeNameRefractionTileProbeReadback, s_RefractionTileProbeReadbackWords, true, false, true);
    TextureDesc depthDesc;
    depthDesc.setWidth(s_RefractionTileProbeWidth).setHeight(s_RefractionTileProbeHeight).setFormat(Format::R32_FLOAT).setName(probeName).setInitialState(ResourceStates::CopyDest).setKeepInitialState(true);
    const auto depth = graphics.createTexture(depthDesc);
    if(!queue.has_value() || !reversedQueue.has_value() || !arguments.has_value() || !visits.has_value() || !readback.has_value() || !depth.has_value())
        return false;
    Array<GpuDescriptorHandle, 6u> descriptors;
    GpuDescriptorRetirementGuard retire(heap, Span<GpuDescriptorHandle>(descriptors));
    const Array<BufferHandle, 4u> storageBuffers(queue.value(), arguments.value(), visits.value(), reversedQueue.value());
    for(u32 index = 0u; index < storageBuffers.size(); ++index){
        const auto descriptor = heap.allocate(GpuDescriptorClass::StorageBuffer);
        if(!descriptor.has_value())
            return false;
        descriptors[index] = descriptor.value();
        if(!heap.write(descriptor.value(), DescriptorWriteItemRawBufferUav(0u, storageBuffers[index].deref())))
            return false;
    }
    const auto sampled = heap.allocate(GpuDescriptorClass::SampledImage);
    if(!sampled.has_value())
        return false;
    descriptors[4] = sampled.value();
    if(!heap.write(sampled.value(), DescriptorWriteItemTextureSrv(0u, depth.value().deref(), depthDesc.format, TextureSubresourceSet(), TextureDimension::Texture2D)))
        return false;
    DeferredBindlessResourceSlots slots;
    slots.refractionDepth = sampled.value().slot();
    const auto slotBuffer = CreateProbeSlots(graphics, s_SmokeNameRefractionTileProbeSlots, slots, descriptors[5u]);
    if(!slotBuffer.has_value())
        return false;
    GpuProbeProgress progress;
    RefractionTileProbeTask payload(heap, progress);
    payload.depth = depth.value();
    payload.queue = queue.value();
    payload.reversedQueue = reversedQueue.value();
    payload.arguments = arguments.value();
    payload.visits = visits.value();
    payload.slots = slotBuffer.value();
    payload.readback = readback.value();
    payload.classify = classify;
    payload.finalize = finalize;
    payload.verifyCompact = verifyCompact;
    payload.verifyDense = verifyDense;
    payload.denseTileListSlot = descriptors[3].slot();
    payload.push.width = s_RefractionTileProbeWidth;
    payload.push.height = s_RefractionTileProbeHeight;
    payload.push.deferredResourcesHeapSlot = descriptors[5u].slot();
    payload.push.tileListSlot = descriptors[0].slot();
    payload.push.tileArgumentsSlot = descriptors[1].slot();
    payload.push.materialContextSlotsHeapSlot = descriptors[2].slot();
    const u64 argBytes = payload.arguments.deref().getCreationDescription().byteSize;
    const u64 queueBytes = payload.queue.deref().getCreationDescription().byteSize;
    const u64 visitBytes = payload.visits.deref().getCreationDescription().byteSize;
    const u64 readbackBytes = payload.readback.deref().getCreationDescription().byteSize;
    for(u32 phase = 0u; phase < s_RefractionTileProbePhaseCount; ++phase){
        payload.phase = phase;
        const auto token = graphics.standaloneGraph().submitStandaloneTaskGraph(
            lambda[in payload](mut GpuTaskGraph graph) -> Expected<GpuTaskId>{ return DeclareRefractionTileProbe(payload, graph); }, GpuPhysicalQueueId());
        if(!token.has_value()){
            error("RefractionTileProbe: phase {} standalone graph rejected at {}", phase, progress.stage);
            return false;
        }
        if(!device.waitForSubmissionToken(token.value())){
            error("RefractionTileProbe: phase {} completion wait failed", phase);
            return false;
        }
        Vector<u32> words;
        words.resize(s_RefractionTileProbeReadbackWords);
        if(!device.readMappedBuffer(payload.readback.deref(), words)
            || !VerifyRefractionTileProbeReadback(phase, Span<u32>(words), argBytes, queueBytes, visitBytes, readbackBytes))
            return false;
    }
    [essential] info(
            "RefractionTileProbe: passed 6 phases at 2049x2049 with 66049 tiles, production finalizer, specialized dense/compact mapping, all 32 argument bytes, all-but-one sparse boundary, queue uniqueness, 65535/65536 boundary, indirect Y tail, 25190406 pixel checks and guards"
        );
    return true;
}


