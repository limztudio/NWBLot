////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <utilities/fbx_to_nwb/text_write.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void AppendMeshField<Value>(in StringView variableName, in StringView fieldName, in Span<Value> values, in StringView indent, mut String out){
    out.append(variableName);
    out.append(s_FieldAccessText);
    out.append(fieldName);
    out.append(s_ListAssignOpenText);
    AppendMeshRows<Value>(values, indent, out);
    out.append(indent);
    out.append(s_ListCloseSectionText);
}

void AppendMeshAssetBodyText(
    in Span<Vec3> positions,
    in Span<Vec3> normals,
    in Span<Vec4> tangents,
    in Span<Vec2> uv0,
    in Span<Vec4> colors,
    in Span<SourceVertexRef> vertexRefs,
    in Span<u32> indices,
    in StringView variableName,
    in StringView indent,
    mut String out
){
    AppendMeshField<Vec3>(variableName, s_MeshPositionsFieldNameView, positions, indent, out);
    AppendMeshField<Vec3>(variableName, s_MeshNormalsFieldNameView, normals, indent, out);
    AppendMeshField<Vec4>(variableName, s_MeshTangentsFieldNameView, tangents, indent, out);
    AppendMeshField<Vec2>(variableName, s_MeshUv0FieldNameView, uv0, indent, out);
    AppendMeshField<Vec4>(variableName, s_MeshColorsFieldNameView, colors, indent, out);
    AppendMeshField<SourceVertexRef>(variableName, s_MeshVertexRefsFieldNameView, vertexRefs, indent, out);

    out.append(variableName);
    out.append(s_FieldAccessText);
    out.append(s_MeshIndicesFieldNameView);
    out.append(s_ListAssignOpenText);
    AppendMeshTriangleRows(indices, indent, out);
    out.append(indent);
    out.append(s_FormatListCloseText);
}


