void VerifyUiSelectionDeletionTests_RejectedCommitPreservesStandaloneDeletionPrefixAndDropsFollowingEvents(mut UiSelectionDeletionTests self){
    UiEditLimits limits = UiEditLimits();
    limits.maxBytes = 10u;
    UiEditModel model = UiEditModel(self.m_arena, limits);
    UiTextEditSession session = UiTextEditSession(self.m_arena, self.m_textInput);
    const UiTextEditOwner owner = MakeSelectionDeletionOwner(model.instanceGeneration());
    ASSERT_TRUE(model.setText("abcDEFghi"));
    ASSERT_TRUE(model.setSelection(6u, 3u));
    ASSERT_EQ(session.begin(owner, s_SelectionDeletionCaret, model), TextInputAdmission::Accepted);
    const TextInputSessionToken token = session.token();
    ASSERT_EQ(self.m_textInput.preedit("IME", 0u, 3u), TextInputAdmission::Accepted);
    ASSERT_EQ(session.drain(owner, model).status, UiTextEditStatus::Applied);
    ASSERT_EQ(self.m_textInput.preedit(StringView(), 0u, 0u), TextInputAdmission::Accepted);
    ASSERT_EQ(self.m_textInput.erase(1u, 1u, self.m_textInput.surroundingRevision(self.m_textInput.activeSession()), TextInputDeletionBasis::Selection), TextInputAdmission::Accepted);
    ASSERT_EQ(self.m_textInput.commit("abcdefg"), TextInputAdmission::Accepted);
    ASSERT_EQ(self.m_textInput.commit("Z"), TextInputAdmission::Accepted);
    const UiTextEditResult result = session.drain(owner, model);
    EXPECT_EQ(result.status, UiTextEditStatus::ModelRejected);
    EXPECT_EQ(result.eventsApplied, 2u);
    EXPECT_TRUE(result.textChanged);
    EXPECT_EQ(model.text(), "abDEFhi");
    EXPECT_EQ(model.anchor(), 5u);
    EXPECT_EQ(model.caret(), 2u);
    EXPECT_FALSE(model.composition().active);
    EXPECT_FALSE(session.token().valid());
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    EXPECT_EQ(self.m_textInput.emitCommit(token, "later"), TextInputAdmission::InvalidSession);
    EXPECT_EQ(session.drain(owner, model).status, UiTextEditStatus::Idle);
    ASSERT_TRUE(model.undo());
    EXPECT_EQ(model.text(), "abcDEFghi");
    EXPECT_EQ(model.anchor(), 6u);
    EXPECT_EQ(model.caret(), 3u);
    EXPECT_FALSE(model.canUndo());
}

void VerifyUiSelectionDeletionTests_RejectedCommitPreservesHostDeletionPrefixAndRetiresTheCopiedNativeToken(mut UiSelectionDeletionTests self){
    ASSERT_TRUE(SeedSelectionDeletion(self, true));
    ASSERT_TRUE(self.activate());
    const TextInputSessionToken token = self.m_textInput.activeSession();
    ASSERT_EQ(self.m_textInput.preedit("IME", 0u, 3u), TextInputAdmission::Accepted);
    self.m_host.collectNative();
    ASSERT_TRUE(self.frame(self.m_model));
    String oversized = String();
    oversized.assign(self.m_model.limits().maxBytes + 1u, 'x');
    ASSERT_EQ(self.m_textInput.preedit(StringView(), 0u, 0u), TextInputAdmission::Accepted);
    ASSERT_EQ(self.m_textInput.erase(1u, 1u, self.m_textInput.surroundingRevision(self.m_textInput.activeSession()), TextInputDeletionBasis::Selection), TextInputAdmission::Accepted);
    ASSERT_EQ(self.m_textInput.commit(StringView(oversized)), TextInputAdmission::Accepted);
    ASSERT_EQ(self.m_textInput.commit("Z"), TextInputAdmission::Accepted);
    self.m_host.collectNative();
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_TRUE(self.m_result.textChanged);
    EXPECT_TRUE(self.m_result.selectionChanged);
    EXPECT_EQ(self.m_model.text(), "abDEFhi");
    EXPECT_EQ(self.m_model.anchor(), 5u);
    EXPECT_EQ(self.m_model.caret(), 2u);
    EXPECT_FALSE(self.m_model.composition().active);
    EXPECT_NE(self.m_textInput.activeSession(), token);
    EXPECT_EQ(self.m_textInput.emitCommit(token, "later"), TextInputAdmission::InvalidSession);
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.text(), "abDEFhi");
    EXPECT_FALSE(self.m_result.textChanged);
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "abcDEFghi");
    EXPECT_EQ(self.m_model.anchor(), 6u);
    EXPECT_EQ(self.m_model.caret(), 3u);
    EXPECT_FALSE(self.m_model.canUndo());
}

