[ordered, modular, friend(DeferredFrameTopologyValidator, OpaqueEmulationMergeValidator, ShadowPrepareStateLifecycleContext, ShadowVisibilityStateLifecycleContext, SoftwareCausticsStateLifecycleContext,
    SurfelGiStateLifecycleContext, HardwareCausticsStateLifecycleContext, DeferredLightingStateLifecycleContext, FrameExecutePresentTails, FrameExecuteRecovery, FrameExecuteStateLifecycleSet, FrameExecuteTimingState,
    ShadowPreparePacketValidator, SurfelCausticsMergeValidator, GraphicsPrefixTimingResolver, ShadowVisibilityMergeValidator)]
class RendererFramePipeline : NoCopy{
    private mut World m_world;
    private mut GraphicsRuntime m_graphics;
    private mut AssetManager m_assetManager;
    private RendererShaderPathResolveCallback m_shaderPathResolver;
    private CsgShapeRegistry m_csgShapeRegistry;
    private u64 m_frameGraphSourceFrameIndex = u64.max;
    private String m_frameGraphRendererLabel;
    private ShadowPrepareGraphCoordinator m_shadowPrepareGraph;
    private GpuTaskId m_deferredLaggedLightingHistorySlotsUploadTask;
    private GpuTaskId m_deferredFrameTimingBeginTask;
    private GraphicsPrefixGraphCoordinator m_graphicsPrefixGraph;
    private ShadowVisibilityGraphCoordinator m_shadowVisibilityGraph;
    private CausticsGraphCoordinator m_causticsGraph;
    private SurfelGiGraphCoordinator m_surfelGiGraph;
    private GpuTaskId m_deferredLightingTask;
    private GpuTaskId m_deferredCompositeTask;
    private GpuTaskId m_deferredPresentationOverlayTask;
    private GpuTaskId m_deferredPresentTask;
    private GpuTaskId m_deferredFrameTimingEndTask;
    private GpuTaskId m_deferredLaggedLightingHistoryTask;
    private GpuTaskId m_deferredFrameRecoveryTask;
    private GpuExternalCompletionId m_deferredSurfelGiCounterReadbackCompletion;
    private GpuExternalCompletionId m_deferredLightingHistoryReadReadyCompletion;
    private GpuExternalCompletionId m_deferredLightingHistoryWriterDrainCompletion;
    private b8 m_frameRenderRecoveryFailed = false;
    private b8 m_deferredFrameRecoveryArmed = false;
    private b8 m_deferredFrameRecoveryRetiresTiming = false;
    private b8 m_deferredLightingTaskGraphDeclared = false;
    private b8 m_deferredLightingTaskGraphScheduled = false;
    private b8 m_deferredPresentationOverlayRequired = false;
    private u32 m_reflectionFrameIndex = 0u;
    private f64 m_deferredLightingTaskGraphDeclarationSeconds = 0.0;
    private Optional<mut IGpuTaskGraphPresentationContributor> m_preparedTaskGraphPresentationContributor;
    private Optional<mut IGpuTaskGraphOutputLayerContributor> m_preparedTaskGraphOutputLayerContributor;
    private Optional<mut IGpuTaskGraphInstanceTransformPatchContributor> m_instanceTransformPatchContributor;
    private ActiveSceneSubsystems m_defaultSceneSubsystems;
    private ActiveSceneSubsystemsRef m_activeSceneSubsystems;

    private RendererMeshState m_meshState;
    private RendererMaterialState m_materialState;
    private RendererOpticalVolumeSelection m_opticalVolumes;
    private RendererCsgState m_csgState;
    private RendererDeferredState m_deferredState;
    private RendererAvboitState m_avboitState;
    private u64 m_laggedLightingReportGeneration = 0u;
    private RendererRayTracingState m_rayTracingState;
    private CsgFrameState m_preparedCsgFrameState;
    private GpuPersistentResourceStateCache m_shadowComputePersistentState;
    private GpuPersistentResourceStateCache m_shadowVisibilityReturnState;
    private GpuPersistentResourceStateCache m_shadowPreparePersistentState;
    private GpuPersistentResourceStateCache m_causticsComputePersistentState;
    private GpuPersistentResourceStateCache m_hardwareCausticAccumulatorPersistentState;
    private GpuPersistentResourceStateCache m_causticIrradianceReturnState;
    private GpuPersistentResourceStateCache m_surfelGiComputePersistentState;
    private GpuPersistentResourceStateCache m_surfelGiCounterPersistentState;
    private GpuPersistentResourceStateCache m_surfelIrradianceReturnState;
    private b8 m_laggedLightingCurrentFrameAcceptancePending = false;
    private b8 m_preparedRefractionActive = false;
    private b8 m_refractionHardwareLogged = false;
    private b8 m_refractionScreenLogged = false;
    private b8 m_preparedReflectionSceneAvailable = false;
    private b8 m_reflectionHardwareLogged = false;
    private b8 m_reflectionFallbackLogged = false;
    private b8 m_refractionEnabled = true;
    private LaggedLightingReport m_laggedLightingReport = LaggedLightingReport::Unreported;
    private b8 m_preparedCsgFrameStateValid = false;
    private b8 m_preparedHasTransparentRenderers = false;
    private b8 m_frameLaggedAsyncLightingEnabled = false;
    private SurfelGiQualitySettings m_surfelGiQualitySettings;
    private ReflectionSettings m_reflectionSettings;
    private RayTracingRefractionGraphResources m_preparedRefractionResources;
    private QueueSubmissionToken m_laggedLightingHistorySubmissionToken;
    private QueueSubmissionToken m_laggedLightingHistoryWriterDrainToken;
    private u64 m_laggedLightingHistoryGeneration = 0u;
    private u64 m_laggedLightingHistoryWriterDrainGeneration = 0u;
    private DeferredFrameTargets m_frameTargets;

    private RendererShaderSystem m_shaderSystem;
    private RendererMeshSystem m_meshSystem;
    private RendererCsgSystem m_csgSystem;
    private RendererMaterialSystem m_materialSystem;
    private RendererDeferredSystem m_deferredSystem;
    private RendererReflectionSystem m_reflectionSystem;
    private RendererAvboitSystem m_avboitSystem;
    private RendererRayTracingSystem m_raytracingSystem;

    private RendererTaskTimingFeedback m_deferredTaskTimingFeedback;
    private GpuTaskGraph m_deferredLightingTaskGraph;
    private GpuTaskGraphAnalysis m_deferredLightingTaskGraphAnalysis;
    private GpuTaskGraphQueueAssignments m_deferredLightingTaskGraphQueueAssignments;
    private GpuTaskGraphQueueAssignmentTelemetryTracker m_deferredLightingTaskGraphQueueAssignmentTelemetry;
    private GpuCompiledGraph m_deferredLightingCompiledGraph;
    private GpuRecordedGraph m_deferredLightingRecordedGraph;
    private GpuGraphSubmissionTransaction m_deferredLightingSubmissionTransaction;

    [cpp_unwind]
    public RendererFramePipeline(mut World world, mut GraphicsRuntime graphics, mut AssetManager assetManager, in RendererShaderPathResolveCallback shaderPathResolver){
        this.m_world = world;
        this.m_graphics = graphics;
        this.m_assetManager = assetManager;
        this.m_shaderPathResolver = shaderPathResolver;
        this.m_shadowComputePersistentState = world.makeSystemResource<GpuPersistentResourceStateCache>();
        this.m_shadowVisibilityReturnState = world.makeSystemResource<GpuPersistentResourceStateCache>();
        this.m_shadowPreparePersistentState = world.makeSystemResource<GpuPersistentResourceStateCache>();
        this.m_causticsComputePersistentState = world.makeSystemResource<GpuPersistentResourceStateCache>();
        this.m_hardwareCausticAccumulatorPersistentState = world.makeSystemResource<GpuPersistentResourceStateCache>();
        this.m_causticIrradianceReturnState = world.makeSystemResource<GpuPersistentResourceStateCache>();
        this.m_surfelGiComputePersistentState = world.makeSystemResource<GpuPersistentResourceStateCache>();
        this.m_surfelGiCounterPersistentState = world.makeSystemResource<GpuPersistentResourceStateCache>();
        this.m_surfelIrradianceReturnState = world.makeSystemResource<GpuPersistentResourceStateCache>();
        this.m_shaderSystem = RendererShaderSystem(graphics, assetManager, this.m_shaderPathResolver);
        this.m_meshSystem = RendererMeshSystem(world, graphics, assetManager, this.m_meshState);
        this.m_csgSystem = RendererCsgSystem(world, graphics, this.m_csgShapeRegistry, this.m_csgState, this.m_shaderSystem, this.m_meshSystem);
        this.m_materialSystem = RendererMaterialSystem(world, graphics, assetManager, this.m_csgShapeRegistry, this.m_materialState, this.m_shaderSystem, this.m_meshSystem, this.m_csgSystem, this.m_opticalVolumes);
        this.m_deferredSystem = RendererDeferredSystem(world, graphics, this.m_deferredState, this.m_shaderSystem);
        this.m_reflectionSystem = RendererReflectionSystem(graphics, this.m_shaderSystem);
        this.m_avboitSystem = RendererAvboitSystem(graphics, this.m_avboitState, this.m_shaderSystem, this.m_materialSystem, this.m_csgSystem);
        this.m_raytracingSystem = RendererRayTracingSystem(world, graphics, this.m_shaderSystem, this.m_meshSystem, this.m_materialSystem, this.m_rayTracingState, this.m_opticalVolumes, this.m_csgShapeRegistry);
        this.m_deferredTaskTimingFeedback = RendererTaskTimingFeedback(graphics, Span<Name>(s_FrameTaskTimingFeedbackScopes));
        this.m_deferredLightingTaskGraph = world.makeSystemResource<GpuTaskGraph>();
        this.m_deferredLightingTaskGraphAnalysis = world.makeSystemResource<GpuTaskGraphAnalysis>();
        this.m_deferredLightingTaskGraphQueueAssignments = world.makeSystemResource<GpuTaskGraphQueueAssignments>();
        this.m_deferredLightingTaskGraphQueueAssignmentTelemetry = world.makeSystemResource<GpuTaskGraphQueueAssignmentTelemetryTracker>();
        this.m_deferredLightingCompiledGraph = world.makeSystemResource<GpuCompiledGraph>();
        this.m_deferredLightingRecordedGraph = world.makeSystemResource<GpuRecordedGraph>();
        this.m_deferredLightingSubmissionTransaction = world.makeSystemResource<GpuGraphSubmissionTransaction>();
        if(!RegisterBuiltInCsgShapeTypes(this.m_csgShapeRegistry))
            error("RendererSystem: failed to register built-in CSG shape types");
        this.m_deferredTaskTimingFeedback.activate();
    }

    public ~RendererFramePipeline(){
        this.m_deferredLightingTaskGraph.reset();
        this.m_deferredTaskTimingFeedback.deactivate();
    }

    [cpp_unwind]
    public b8 validateResources(in u32 width, in u32 height, in u32 sampleCount);

    [cpp_unwind]
    public void invalidateResources();

    public void update(mut World world, in f32 delta);

    [cpp_unwind]
    public b8 prepareResources(in FramebufferPtr framebuffer);

    [cpp_unwind]
    public void render(in FramebufferPtr framebuffer);

    [cpp_unwind]
    public b8 appendFrameGraph(mut FrameGraphBuilder builder);

    public void setActiveSceneSubsystems(in ActiveSceneSubsystemsRef subsystems);
    public void setInstanceTransformPatchContributor(in Optional<mut IGpuTaskGraphInstanceTransformPatchContributor> contributor);

    public b8 isTransparentFeatureEnabled()const{
        return this.m_activeSceneSubsystems.has_value() && this.m_activeSceneSubsystems.value().hasSubsystem<TransparentSubsystem>();
    }

    public b8 isCsgFeatureEnabled()const{
        return this.m_activeSceneSubsystems.has_value() && this.m_activeSceneSubsystems.value().hasSubsystem<CsgSubsystem>();
    }

    public void setRefractionEnabled(in b8 enabled){ this.m_refractionEnabled = enabled; }

    public void setRefractionDiagnosticsEnabled(in b8 enabled){ this.m_raytracingSystem.refraction().setRefractionDiagnosticsEnabled(enabled); }

    public Expected<RefractionStatistics> tryGetLatestRefractionStatistics()const{ return this.m_raytracingSystem.refraction().tryGetLatestRefractionStatistics(); }

    public void setRefractionHardwareTracingEnabled(in b8 enabled){
        this.m_raytracingSystem.setRefractionHardwareTracingEnabled(enabled);
    }

    public b8 setCausticQualitySettings(in CausticQualitySettings settings){
        return this.m_raytracingSystem.setCausticQualitySettings(settings);
    }

    public b8 setSurfelGiQualitySettings(in SurfelGiQualitySettings settings);

    public b8 setSoftwareShadowSettings(in SoftwareShadowSettings settings){
        return this.m_raytracingSystem.setSoftwareShadowSettings(settings);
    }

    public b8 setShadowQualitySettings(in ShadowQualitySettings settings){
        return this.m_raytracingSystem.setShadowQualitySettings(settings);
    }

    public b8 setReflectionSettings(in ReflectionSettings settings);

    public Expected<ReflectionStatistics> tryGetLatestReflectionStatistics()const{ return this.m_reflectionSystem.tryGetLatestStatistics(); }

    public b8 setPresentationSettings(in PresentationSettings settings){ return this.m_deferredSystem.setPresentationSettings(settings); }

    public void setFrameLaggedAsyncLightingEnabled(in b8 enabled);

    public GpuTaskGraphRuntimeStatistics deferredTaskGraphRuntimeStatistics()const;

    [cpp_unwind]
    private b8 prepareDeferredGraphPacketEnvelopeMetrics(in GpuTaskGraphDeclarationReadView graph, in GpuCompiledGraphReadView compiledGraph);

    [cpp_unwind]
    private b8 declareFrameTimingBeginTask(mut GpuTimingFrameTransaction frameTimingTransaction);

    [cpp_unwind]
    private b8 scheduleDeferredLightingTaskGraphForExecution();

    [cpp_unwind]
    private void commitFrameTargets(mut DeferredFrameTargets targets);

    [cpp_unwind]
    private void resetFrameTargets();

    [cpp_unwind]
    private void resetDeferredTaskGraphRuntime();

    [cpp_unwind]
    private void resetFrameTaskState();

    private void resetDeferredFrameTaskIdsAndFlags();

    private void resetSharedDeferredFrameTaskState();

    private void resetTargetGenerationStateHandoffs();

    private void resetInvalidatedResourceStateHandoffs();

    private void invalidateLaggedLightingHistorySubmission(){ this.m_laggedLightingHistorySubmissionToken = QueueSubmissionToken(); }

    private void invalidateLaggedLightingHistoryWriterDrain();

    private void resetLaggedLightingHistoryReadTracking();

    private void resetLaggedLightingHistoryTracking();

    [cpp_unwind]
    private void buildDeferredLightingTaskGraph(
        in RendererFrameGraphFeatures features,
        in CsgFrameState csgFrameState,
        in b8 clearAvboitTargets,
        in b8 hasTransparentRenderers,
        in b8 hasOpaqueCsgFrameWork,
        in f32 meshViewAspectRatio,
        in AcquiredPresentationFrame presentationFrame,
        in borrow b8 asyncPrefixTimingSpansOnePacket,
        in QueueSubmissionToken surfelCounterReadbackCompletionToken,
        in QueueSubmissionToken laggedLightingHistoryReadReadyToken,
        in QueueSubmissionToken laggedLightingHistoryWriterDrainToken,
        in b8 includeLaggedLightingHistoryCapture,
        mut DeferredFrameTargets deferredTargets,
        mut GpuTimingFrameTransaction frameTimingTransaction,
        mut Optional<GpuTimingMeasure> asyncPrefixTiming,
        mut Optional<GpuTimingMeasure> deferredClearTiming,
        mut GraphClearTimingRecordState deferredClearTimingState,
        mut GraphClearTimingRecordState opaqueCsgIntervalClearTimingState,
        mut Optional<GpuTimingMeasure> opaqueRegularSharedComputeEmulationTiming,
        mut Optional<GpuTimingMeasure> opaqueCsgIntervalSampleComputeEmulationTiming,
        mut GpuTimingSubmissionTicket shadowPrepareTimingTicket,
        mut Span<GraphicsPrefixTimingTicket> graphicsPrefixTimingTickets,
        mut Optional<GpuTimingMeasure> asyncFinalTiming,
        mut GpuTimingSubmissionTicket avboitPreTimingTicket,
        mut GraphClearTimingRecordState avboitClearTimingState,
        mut GraphClearTimingRecordState transparentCsgIntervalClearTimingState,
        mut Optional<GpuTimingMeasure> transparentCsgIntervalsTiming,
        mut Optional<GpuTimingMeasure> avboitOccupancyComputeEmulationTiming,
        mut Optional<GpuTimingMeasure> avboitExtinctionComputeEmulationTiming,
        mut Optional<GpuTimingMeasure> avboitAccumulationComputeEmulationTiming,
        mut GpuTimingSubmissionTicket avboitDepthWarpTimingTicket,
        mut GpuTimingSubmissionTicket avboitExtinctionTimingTicket,
        mut GpuTimingSubmissionTicket avboitIntegrationTimingTicket,
        mut GpuTimingSubmissionTicket avboitAccumulationTimingTicket,
        mut GpuTimingSubmissionTicket shadowVisibilityTimingTicket,
        mut Optional<GpuTimingMeasure> shadowVisibilityAsyncTiming,
        mut Optional<GpuTimingMeasure> shadowVisibilityTiming,
        mut Optional<GpuTimingMeasure> opaqueSoftResolveTiming,
        mut Optional<GpuTimingMeasure> transparentSoftResolveTiming,
        mut b8 shadowVisibilityOpaqueProduced,
        mut b8 shadowVisibilityTransparentTraceProduced,
        mut u32 shadowVisibilityOpaqueFrameIndex,
        mut GpuTimingSubmissionTicket softwareCausticsTimingTicket,
        mut GpuTimingSubmissionTicket surfelGiTimingTicket,
        mut Optional<GpuTimingMeasure> surfelGiAsyncTiming,
        mut GpuTimingSubmissionTicket hardwareCausticsTimingTicket,
        mut Optional<GpuTimingMeasure> causticPhotonTiming,
        mut Optional<GpuTimingMeasure> causticResolveTiming,
        mut GpuTimingSubmissionTicket lightingTimingTicket,
        mut GpuTimingSubmissionTicket compositeTimingTicket,
        mut GpuTimingSubmissionTicket presentTimingTicket
    );

    [cpp_unwind]
    private void reportLaggedLightingTransition(in LaggedLightingReport report, in u64 targetGeneration);
}


