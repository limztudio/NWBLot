void VerifyX11ClipboardFixture_PropertyAbsenceAndRetiredWindowPreserveDifferentNativeResults(mut X11ClipboardFixture self){
    native(mut self){
#if defined(NWB_PLATFORM_LINUX)
        Window retired = 0u;
        {
            X11CheckedOperation created(*self.m_displays[0]);
            retired = XCreateSimpleWindow(self.m_displays[0], DefaultRootWindow(self.m_displays[0]), 0, 0, 1, 1, 0, 0, 0);
            ASSERT_TRUE(created.succeeded());
            ASSERT_NE(retired, 0u);
        }
        {
            const auto absent = ReadX11Property(*self.m_displays[0], retired, XA_STRING, false, 16u);
            ASSERT_TRUE(absent);
            EXPECT_EQ(absent->type, 0u);
            EXPECT_EQ(absent->count, 0u);
        }
        {
            X11CheckedOperation destroyed(*self.m_displays[0]);
            XDestroyWindow(self.m_displays[0], retired);
            ASSERT_TRUE(destroyed.succeeded());
        }
        const auto failed = ReadX11Property(*self.m_displays[0], retired, XA_STRING, false, 16u);
        ASSERT_FALSE(failed);
        EXPECT_EQ(failed.error().errorCode, static_cast<u8>(BadWindow));
#else
        (void)self;
#endif
    }
}

void VerifyX11ClipboardFixture_WritingPrimarySelectionDoesNotOverwriteClipboardUtf8(mut X11ClipboardFixture self){
    native(mut self){
#if defined(NWB_PLATFORM_LINUX)
        const AStringView clipboard = "clipboard \xec\x95\x88\xeb\x85\x95 \xf0\x9f\x99\x82";
        const AStringView primary = "primary caf\xc3\xa9";
        ASSERT_TRUE(self.m_services[0]->capabilities(ClipboardChannel::PrimarySelection).readText);
        ASSERT_TRUE(self.writeText(0u, ClipboardChannel::Clipboard, clipboard));
        ASSERT_TRUE(self.writeText(0u, ClipboardChannel::PrimarySelection, primary));
        ClipboardCompletion completion(self.m_arena.arena);
        const auto clipTokenAdmission = self.m_services[1]->requestReadText(ClipboardChannel::Clipboard);
        ASSERT_TRUE(clipTokenAdmission);
        const ClipboardRequestToken clipToken = *clipTokenAdmission;
        ASSERT_TRUE(self.awaitCompletion(clipToken, *self.m_services[1], completion));
        ASSERT_EQ(completion.status, ClipboardStatus::Success);
        EXPECT_EQ(completion.text, clipboard);
        const auto primaryTokenAdmission = self.m_services[1]->requestReadText(ClipboardChannel::PrimarySelection);
        ASSERT_TRUE(primaryTokenAdmission);
        const ClipboardRequestToken primaryToken = *primaryTokenAdmission;
        ASSERT_TRUE(self.awaitCompletion(primaryToken, *self.m_services[1], completion));
        ASSERT_EQ(completion.status, ClipboardStatus::Success);
        EXPECT_EQ(completion.text, primary);
#else
        (void)self;
#endif
    }
}

void VerifyX11ClipboardFixture_IncrementalReadRetainsSnapshotAfterOwnerLosesSelection(mut X11ClipboardFixture self){
    native(mut self){
#if defined(NWB_PLATFORM_LINUX)
        using namespace __hidden_os_platform_cases_support;
        GlobalString original(200000u, 'x', self.m_arena.arena);
        original.replace(65534u, 1u, "\xf0\x9f\x99\x82");
        ASSERT_TRUE(self.writeText(0u, ClipboardChannel::Clipboard, original));
        self.m_sawSelectionRequest = false;
        ClipboardCompletion completion(self.m_arena.arena);
        const auto tokenAdmission = self.m_services[1]->requestReadText(ClipboardChannel::Clipboard);
        ASSERT_TRUE(tokenAdmission);
        const ClipboardRequestToken token = *tokenAdmission;
        const Timer deadline = TimerAddMS(TimerNow(), s_SelectionChangeTimeoutMS);
        while(!self.m_sawSelectionRequest && TimerNow() < deadline){
            ASSERT_TRUE(self.pumpAll());
            SleepMS(s_PollIntervalMS);
        }
        ASSERT_TRUE(self.m_sawSelectionRequest);
        const Window replacement = XCreateSimpleWindow(self.m_displays[1], DefaultRootWindow(self.m_displays[1]), 0, 0, 1, 1, 0, 0, 0);
        ASSERT_NE(replacement, 0u);
        const Atom clipboard = XInternAtom(self.m_displays[1], s_ClipboardAtomName.data(), False);
        XSetSelectionOwner(self.m_displays[1], clipboard, replacement, CurrentTime);
        XSync(self.m_displays[1], False);
        ASSERT_EQ(XGetSelectionOwner(self.m_displays[1], clipboard), replacement);
        ASSERT_TRUE(self.awaitCompletion(token, *self.m_services[1], completion));
        EXPECT_EQ(completion.status, ClipboardStatus::Success);
        EXPECT_EQ(completion.text, original);
        XDestroyWindow(self.m_displays[1], replacement);
        XSync(self.m_displays[1], False);
#else
        (void)self;
#endif
    }
}

void VerifyX11ClipboardFixture_CancelledRequestWindowCannotCompleteFreshRequest(mut X11ClipboardFixture self){
    native(mut self){
#if defined(NWB_PLATFORM_LINUX)
        ASSERT_TRUE(self.writeText(0u, ClipboardChannel::Clipboard, "first"));
        const auto cancelledAdmission = self.m_services[1]->requestReadText(ClipboardChannel::Clipboard);
        ASSERT_TRUE(cancelledAdmission);
        const ClipboardRequestToken cancelled = *cancelledAdmission;
        ASSERT_TRUE(self.m_services[1]->pump());
        ASSERT_TRUE(self.m_services[1]->cancel(cancelled));
        ASSERT_TRUE(self.writeText(0u, ClipboardChannel::Clipboard, "after cancellation"));
        ClipboardCompletion completion(self.m_arena.arena);
        const auto freshAdmission = self.m_services[1]->requestReadText(ClipboardChannel::Clipboard);
        ASSERT_TRUE(freshAdmission);
        const ClipboardRequestToken fresh = *freshAdmission;
        ASSERT_TRUE(self.awaitCompletion(fresh, *self.m_services[1], completion));
        EXPECT_EQ(completion.status, ClipboardStatus::Success);
        EXPECT_EQ(completion.text, "after cancellation");
        EXPECT_EQ(self.m_services[1]->poll(cancelled, completion), ClipboardPollResult::InvalidRequest);
#else
        (void)self;
#endif
    }
}

void VerifyX11ClipboardFixture_QueuedOwnershipLossCannotClearNewlyReacquiredText(mut X11ClipboardFixture self){
    native(mut self){
#if defined(NWB_PLATFORM_LINUX)
        using namespace __hidden_os_platform_cases_support;
        ASSERT_TRUE(self.writeText(0u, ClipboardChannel::Clipboard, "before ownership loss"));
        const Atom clipboard = XInternAtom(self.m_displays[1], s_ClipboardAtomName.data(), False);
        const Window temporaryOwner = XCreateSimpleWindow(self.m_displays[1], DefaultRootWindow(self.m_displays[1]), 0, 0, 1, 1, 0, 0, 0);
        ASSERT_NE(temporaryOwner, 0u);
        XSetSelectionOwner(self.m_displays[1], clipboard, temporaryOwner, CurrentTime);
        XSync(self.m_displays[1], False);
        ASSERT_EQ(XGetSelectionOwner(self.m_displays[1], clipboard), temporaryOwner);

        // Retain the genuine loss event until the new ownership is established.
        XEvent ownershipLoss{};
        b8 queuedLoss = false;
        const Timer lossDeadline = TimerAddMS(TimerNow(), s_SelectionChangeTimeoutMS);
        while(!queuedLoss && TimerNow() < lossDeadline){
            queuedLoss = XCheckTypedEvent(self.m_displays[0], SelectionClear, &ownershipLoss) != False;
            if(!queuedLoss)
                SleepMS(s_PollIntervalMS);
        }
        ASSERT_TRUE(queuedLoss);
        ASSERT_EQ(ownershipLoss.xselectionclear.selection, clipboard);

        ClipboardCompletion completion(self.m_arena.arena);
        const auto writeAdmission = self.m_services[0]->requestWriteText(ClipboardChannel::Clipboard, "after reacquisition");
        ASSERT_TRUE(writeAdmission);
        const ClipboardRequestToken write = *writeAdmission;
        ASSERT_TRUE(write.valid());
        ASSERT_TRUE(self.awaitCompletion(write, *self.m_services[0], completion));
        ASSERT_EQ(completion.status, ClipboardStatus::Success);
        ASSERT_NE(XGetSelectionOwner(self.m_displays[1], clipboard), temporaryOwner);
        ASSERT_TRUE(DispatchX11ClipboardEvent(*self.m_services[0], ownershipLoss));
        ASSERT_TRUE(self.pumpAll());
        const auto readAdmission = self.m_services[1]->requestReadText(ClipboardChannel::Clipboard);
        ASSERT_TRUE(readAdmission);
        const ClipboardRequestToken read = *readAdmission;
        ASSERT_TRUE(self.awaitCompletion(read, *self.m_services[1], completion));
        EXPECT_EQ(completion.status, ClipboardStatus::Success);
        EXPECT_EQ(completion.text, "after reacquisition");
        XDestroyWindow(self.m_displays[1], temporaryOwner);
        XSync(self.m_displays[1], False);
#else
        (void)self;
#endif
    }
}

