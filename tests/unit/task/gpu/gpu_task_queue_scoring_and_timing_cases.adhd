FOUNDATION_INLINE void SetGpuScoringTimingHistory(Core::GpuTaskGraphQueueAssignmentOptions& options, const Core::GpuTaskTimingHistorySnapshot& snapshot)noexcept{
    options.timingHistory = &snapshot;
}

[[nodiscard]] FOUNDATION_INLINE Optional<Core::GpuTaskTimingAssignmentState> FindTimingAssignmentStateValue(
    const Core::GpuTaskTimingHistoryStore& store,
    const Core::GpuTaskTimingAssignmentKey& key
)noexcept{
    if(const Core::GpuTaskTimingAssignmentState* const found = store.findAssignment(key))
        return *found;
    return {};
}

[[nodiscard]] FOUNDATION_INLINE b8 CollectGpuScoringLatestFragments(
    const ScratchTrackedStates& states,
    const TrackedResourceStateHistory& history,
    const Core::GpuTaskGraphResourceView& resource,
    const ScratchResourceRanges& requested,
    Core::Alloc::ScratchArena& scratchArena,
    ScratchStateFragments& fragments
){
    return Core::GpuTaskGraphCompilerDetail::CollectLatestResourceStateFragments(states, history, resource, requested, scratchArena, fragments);
}

[[nodiscard]] FOUNDATION_INLINE b8 CollectGpuScoringTerminalFragments(
    const ScratchTrackedStates& states,
    const TrackedResourceStateHistory& history,
    const Core::GpuTaskGraphResourceView& resource,
    Core::Alloc::ScratchArena& scratchArena,
    ScratchStateFragments& fragments
){
    return Core::GpuTaskGraphCompilerDetail::CollectTerminalResourceStateFragments(states, history, resource, scratchArena, fragments);
}

[[nodiscard]] FOUNDATION_INLINE b8 FragmentHasNullState(const TrackedResourceStateFragment& fragment)noexcept{
    return fragment.state == nullptr;
}

[[nodiscard]] FOUNDATION_INLINE b8 FragmentMatchesTrackedState(
    const TrackedResourceStateFragment& fragment,
    const ScratchTrackedStates& states,
    const usize index
)noexcept{
    return index < states.size() && fragment.state == &states[index];
}

FOUNDATION_INLINE void SeedFragmentWithFirstState(const ScratchTrackedStates& states, ScratchStateFragments& fragments){
    TrackedResourceStateFragment seed{};
    seed.state = &states[0u];
    seed.stateIndex = 0u;
    fragments.push_back(seed);
    fragments.push_back(seed);
}


