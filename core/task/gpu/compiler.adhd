[cpp_header("<core/task/gpu/compiler.h>"), cpp_name("::NWB::Core::GpuTaskGraphAnalysisStatus::Enum")]
extern enum GpuTaskGraphAnalysisStatus : u8{
    NotAnalyzed,
    Success,
    OutputPlanInUse,
    InputGraphInUse,
    InvalidTask,
    MissingTaskRecordPayload,
    InvalidTaskDependency,
    InvalidExternalCompletionDependency,
    InvalidResourceUse,
    InvalidResourceVersion,
    InvalidResourceVersionUse,
    MissingResourceVersionProducer,
    DuplicateResourceVersionProducer,
    InvalidAcceptedQueueFrontierTask,
    Cycle,
    InvalidPresentationEndpoint
};

[cpp_header("<core/task/gpu/compiler.h>"), cpp_name("::NWB::Core::GpuTaskGraphPacketizationPolicy::Enum")]
extern enum GpuTaskGraphPacketizationPolicy : u8{
    ExplicitMerge,
    FrontierSafe,
    FrontierScored,
    kCount
};

[cpp_header("<core/task/gpu/compiler.h>"), cpp_name("::NWB::Core::GpuTaskGraphQueueAssignmentStatus::Enum")]
extern enum GpuTaskGraphQueueAssignmentStatus : u8{
    NotAssigned,
    Success,
    InvalidGraphAnalysis,
    InvalidQueueTopology,
    InvalidQueueLoad,
    InvalidTimingFeedback,
    NoCompatibleQueue
};

[cpp_header("<core/task/gpu/compiler.h>"), cpp_name("::NWB::Core::GpuTaskQueueAssignmentModifier::Mask")]
extern flag GpuTaskQueueAssignmentModifier : u8{
    None,
    DirectDependencyAffinity,
    SameClassLoadBalance,
    NonPrimaryRouting,
    TimingCalibration,
    TimingFeedback
};

[cpp_header("<core/task/gpu/compiler.h>"), cpp_name("::NWB::Core::GpuTaskQueueAssignmentReason::Enum")]
extern enum GpuTaskQueueAssignmentReason : u8{
    Unknown,
    RequiredGraphics,
    Conservative,
    Scored,
    kCount
};


