#include <utilities/fbx_to_nwb/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ShouldTransformBakedDirection(in b8 bakeTransforms, in b8 wantsSkinning, in b8 skinnedIsLocal){
    return bakeTransforms && (wantsSkinning || skinnedIsLocal);
}

b8 ShouldImportMeshTangents(in NormalMode normalMode, in b8 hasVertexTangent){
    return normalMode == NormalMode::Imported && hasVertexTangent;
}


