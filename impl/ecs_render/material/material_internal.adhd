class MaterialTypedStager : NoCopy{
    private mut RendererMaterialSystem m_system;
    private mut World m_world;
    private RendererResourceLookupMode m_lookupMode;
    private mut MaterialTypedByteDataVector m_bytes;
    private HashMap<MaterialTypedByteRangeKey, MaterialTypedByteRangeCache> m_ranges;
    private MaterialTypedByteContentRangeMap m_mutableRanges;

    public MaterialTypedStager(
        mut RendererMaterialSystem system,
        mut World world,
        in RendererResourceLookupMode lookupMode,
        mut MaterialTypedByteDataVector bytes,
        in usize capacity
    ){
        this.m_system = system;
        this.m_world = world;
        this.m_lookupMode = lookupMode;
        this.m_bytes = bytes;
        this.m_ranges.reserve(capacity);
        this.m_mutableRanges.reserve(capacity);
    }

    [cpp_unwind]
    public Expected<MaterialTypedByteRange> constant(in MaterialSurfaceInfo material){
        MaterialTypedByteRangeKey key;
        key.materialName = material.materialName;
        key.typedLayoutHash = material.typedLayoutHash;
        auto entry = this.m_ranges.try_emplace(key);
        mut MaterialTypedByteRangeCache cache = entry.first.value();
        if(!cache.constantRangeCached){
            const auto range = AppendMaterialTypedByteRange(material.constantTypedBytes, this.m_bytes);
            if(!range.has_value())
                return MakeUnexpected(Failure());
            cache.constantRange = range.value();
            cache.constantRangeCached = true;
        }
        return cache.constantRange;
    }

    [cpp_unwind]
    private Expected<MaterialTypedByteRange> defaultMutable(in MaterialSurfaceInfo material){
        MaterialTypedByteRangeKey key;
        key.materialName = material.materialName;
        key.typedLayoutHash = material.typedLayoutHash;
        auto entry = this.m_ranges.try_emplace(key);
        mut MaterialTypedByteRangeCache cache = entry.first.value();
        if(!cache.defaultMutableRangeCached){
            const auto range = this.m_mutableRanges.findOrAppend(material.mutableDefaultTypedBytes, this.m_bytes);
            if(!range.has_value())
                return MakeUnexpected(Failure());
            cache.defaultMutableRange = range.value();
            cache.defaultMutableRangeCached = true;
        }
        return cache.defaultMutableRange;
    }

    [cpp_unwind]
    public Expected<MaterialTypedByteRange> mutableInstance(in EntityID entity, in MaterialSurfaceInfo material){
        const Optional<mut MaterialInstanceComponent> borrowedInstance = this.m_world.borrowComponent<MaterialInstanceComponent>(entity);
        if(!borrowedInstance.has_value() || borrowedInstance.value().overrides.empty())
            return this.defaultMutable(material);
        Optional<in MaterialInstanceComponent> borrowInstance;
        borrowInstance.emplace(borrowedInstance.value());
        Expected<Span<u8>> bytes = MakeUnexpected(Failure());
        if(this.m_lookupMode == RendererResourceLookupMode::CreateMissing)
            bytes = this.m_system.prepareMaterialInstanceMutableTypedBytes(entity, material, borrowInstance);
        else
            bytes = this.m_system.findPreparedMaterialInstanceMutableTypedBytes(entity, material, borrowInstance);
        if(!bytes.has_value())
            return MakeUnexpected(Failure());
        return this.m_mutableRanges.findOrAppend(bytes.value(), this.m_bytes);
    }
}


class MaterialPipelineBuildInputs{
    public mut RendererMaterialSystem system;
    public mut RendererShaderSystem shaderSystem;
    public mut RendererMaterialState materialState;
    public mut MaterialPipelineResources resources;
    public in MaterialSurfaceInfo materialInfo;
    public in MaterialPipelineKey pipelineKey;
    public mut Framebuffer framebuffer;
    public mut Device device;
    public mut GpuDescriptorHeap heap;
    public in RenderState renderState;
    public in BindingLayoutHandle materialPassBindingLayout;
    public Name materialKey;
    public Name sharedMeshShaderAssetName;
    public Name passPixelShaderName;
    public Name passPixelShaderDebugName;
    public StringView pixelShaderVariant;
    public StringView meshShaderVariant;
    public StringView avboitCsgShaderVariant;
    public MaterialPipelinePass pass;
    public b8 avboitCsgClipPipeline;

    public MaterialPipelineBuildInputs(
        mut RendererMaterialSystem system,
        mut RendererShaderSystem shaderSystem,
        mut RendererMaterialState materialState,
        mut MaterialPipelineResources resources,
        in MaterialSurfaceInfo materialInfo,
        in MaterialPipelineKey pipelineKey,
        mut Framebuffer framebuffer,
        mut Device device,
        mut GpuDescriptorHeap heap,
        in RenderState renderState,
        in BindingLayoutHandle materialPassBindingLayout,
        in Name materialKey,
        in Name sharedMeshShaderAssetName,
        in Name passPixelShaderName,
        in Name passPixelShaderDebugName,
        in StringView pixelShaderVariant,
        in StringView meshShaderVariant,
        in StringView avboitCsgShaderVariant,
        in MaterialPipelinePass pass,
        in b8 avboitCsgClipPipeline
    ){
        this.system = system;
        this.shaderSystem = shaderSystem;
        this.materialState = materialState;
        this.resources = resources;
        this.materialInfo = materialInfo;
        this.pipelineKey = pipelineKey;
        this.framebuffer = framebuffer;
        this.device = device;
        this.heap = heap;
        this.renderState = renderState;
        this.materialPassBindingLayout = materialPassBindingLayout;
        this.materialKey = materialKey;
        this.sharedMeshShaderAssetName = sharedMeshShaderAssetName;
        this.passPixelShaderName = passPixelShaderName;
        this.passPixelShaderDebugName = passPixelShaderDebugName;
        this.pixelShaderVariant = pixelShaderVariant;
        this.meshShaderVariant = meshShaderVariant;
        this.avboitCsgShaderVariant = avboitCsgShaderVariant;
        this.pass = pass;
        this.avboitCsgClipPipeline = avboitCsgClipPipeline;
    }
}


class MaterialPipelineBuilder : NoCopy{
    private in MaterialPipelineBuildInputs m_inputs;

    public MaterialPipelineBuilder(in MaterialPipelineBuildInputs inputs){
        this.m_inputs = inputs;
    }

    public b8 buildMesh();
    public b8 buildIndexed();
    public b8 buildCompute();

    private b8 loadPassPixelShader();
}

b8 IsValidIndexedEmulationByteOffset(in b8 indexedGeometryOutput, in u32 emulationIndexByteOffset){
    return !indexedGeometryOutput || emulationIndexByteOffset != 0u;
}


