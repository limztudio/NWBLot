void VerifyUiImageBuilderTests_CallerMutationCannotChangeDeferredImageNameSizeOrStraightTint(mut UiImageBuilderTests self){
    ASSERT_TRUE(self.panel(1u));
    Name name = s_UiImageBuilderSpriteRegionName;
    ImageOptions options = MakeUiImageBuilderFixedOptions(80.0f, 32.0f);
    options.tint = MakeUiHorizImageColor(0.8f, 1.0f, 0.6f, 0.5f);
    ASSERT_TRUE(self.m_builder.image("image", name, options));
    name = s_UiFixtureNameWhite;
    options = MakeUiImageBuilderFixedOptions(20.0f, 20.0f);
    ASSERT_TRUE(self.finishPanel());
    const DrawSnapshot snapshot = self.m_paint.freeze();
    const Expected<SkinPaintSample> sprite = self.sampleSkinPaint(snapshot, s_UiImageBuilderSpriteRegionName);
    ASSERT_TRUE(sprite.has_value());
    EXPECT_FLOAT_EQ(sprite.value().bounds.width, 80.0f);
    EXPECT_FLOAT_EQ(sprite.value().bounds.height, 32.0f);
    EXPECT_FLOAT_EQ(sprite.value().color.r, 0.4f);
    EXPECT_FLOAT_EQ(sprite.value().color.g, 0.5f);
    EXPECT_FLOAT_EQ(sprite.value().color.b, 0.3f);
    EXPECT_FLOAT_EQ(sprite.value().color.a, 0.5f);
}

void VerifyUiImageBuilderTests_ExternalClipUpdatesSpriteUvsAndRestoresThePaintStack(mut UiImageBuilderTests self){
    ASSERT_TRUE(self.panel(1u));
    ASSERT_TRUE(self.m_builder.image("image", s_UiImageBuilderSpriteRegionName, MakeUiImageBuilderFixedOptions()));
    self.m_paint.pushClip(MakeUiHorizImageRect(20.0f, 0.0f, 20.0f, 600.0f));
    ASSERT_TRUE(self.finishPanel());
    ASSERT_TRUE(self.m_paint.popClip());
    self.m_paint.fillRect(MakeUiHorizImageRect(60.0f, 80.0f, 8.0f, 8.0f), MakeUiHorizImageColor(1.0f, 0.0f, 0.0f, 1.0f));
    const DrawSnapshot snapshot = self.m_paint.freeze();
    const Expected<SkinPaintSample> sprite = self.sampleSkinPaint(snapshot, s_UiImageBuilderSpriteRegionName);
    ASSERT_TRUE(sprite.has_value());
    EXPECT_FLOAT_EQ(sprite.value().bounds.x, 20.0f);
    EXPECT_FLOAT_EQ(sprite.value().bounds.width, 20.0f);
    EXPECT_NEAR(sprite.value().maximumU, (27.0f / 96.0f) * (20.0f / 128.0f), 0.000001f);
    b8 sentinel = false;
    for(usize index = 0u; index < snapshot.commands().size(); ++index){
        const DrawCommand command = snapshot.commands()[index];
        if(command.material != PaintMaterial::Solid)
            continue;
        const Vertex vertex = snapshot.vertices()[snapshot.indices()[command.firstIndex]];
        sentinel = sentinel || (vertex.position.x == 60.0f && vertex.position.y == 80.0f);
    }
    EXPECT_TRUE(sentinel);
}

void VerifyUiImageBuilderTests_FullyTransparentAndEmptyImagesRemainValidWithoutQuads(mut UiImageBuilderTests self){
    ASSERT_TRUE(self.panel(1u));
    ImageOptions transparent = MakeUiImageBuilderFixedOptions();
    transparent.tint.a = 0.0f;
    ASSERT_TRUE(self.m_builder.image("transparent", s_UiImageBuilderSpriteRegionName, transparent));
    ASSERT_TRUE(self.m_builder.image("empty", s_UiImageBuilderSpriteRegionName, MakeUiImageBuilderFixedOptions(0.0f, 20.0f)));
    ASSERT_TRUE(self.finishPanel());
    const DrawSnapshot snapshot = self.m_paint.freeze();
    EXPECT_FALSE(self.sampleSkinPaint(snapshot, s_UiImageBuilderSpriteRegionName).has_value());
}

void VerifyUiImageBuilderTests_UnknownRegionRejectsWithoutReplacingAcceptedTargets(mut UiImageBuilderTests self){
    ASSERT_TRUE(self.panel(1u));
    EXPECT_FALSE(self.m_builder.button(s_UiImageBuilderBeforeKey, "Before"));
    ASSERT_TRUE(self.m_builder.image("image", s_UiImageBuilderSpriteRegionName));
    ASSERT_TRUE(self.finishPanel());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const WidgetId before = self.id(s_UiImageBuilderBeforeKey, s_UiImageBuilderPanelKey);
    const Optional<HitTarget> accepted = self.findTarget(before);
    ASSERT_TRUE(accepted.has_value());
    ASSERT_TRUE(self.panel(2u));
    EXPECT_FALSE(self.m_builder.image("image", s_UiInputNameUnknownRegion));
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    const Optional<HitTarget> retained = self.findTarget(before);
    ASSERT_TRUE(retained.has_value());
    EXPECT_EQ(retained.value().declarationGeneration, accepted.value().declarationGeneration);
}

void VerifyUiImageBuilderTests_NonfiniteTintRejectsWithoutReplacingAcceptedTargets(mut UiImageBuilderTests self){
    ASSERT_TRUE(self.panel(1u));
    EXPECT_FALSE(self.m_builder.button(s_UiImageBuilderBeforeKey, "Before"));
    ASSERT_TRUE(self.m_builder.image("image", s_UiImageBuilderSpriteRegionName));
    ASSERT_TRUE(self.finishPanel());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const WidgetId before = self.id(s_UiImageBuilderBeforeKey, s_UiImageBuilderPanelKey);
    const Optional<HitTarget> accepted = self.findTarget(before);
    ASSERT_TRUE(accepted.has_value());
    ASSERT_TRUE(self.panel(2u));
    ImageOptions options = ImageOptions();
    options.tint.r = bit_cast<f32>(0x7fc00001u);
    EXPECT_FALSE(self.m_builder.image("image", s_UiImageBuilderSpriteRegionName, options));
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    const Optional<HitTarget> retained = self.findTarget(before);
    ASSERT_TRUE(retained.has_value());
    EXPECT_EQ(retained.value().declarationGeneration, accepted.value().declarationGeneration);
}


