////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_RAYTRACE_OPTICAL_TRANSPORT_SLANGI
#define NWB_GRAPHICS_RAYTRACE_OPTICAL_TRANSPORT_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "optical_bootstrap.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// The consuming effect supplies terminal illumination. This walker owns neither project BXDF selection nor environment assets, reflection outputs, screen-space caches, or feature statistics buffers.
half3 nwbOpticalSurfaceRadiance(const NwbRayTraceSurfaceHit hit, const float3 observerDirection);
half3 nwbOpticalEnvironmentRadiance(const float3 direction);

// Reserve one query budget unit before each retained-receiver collection; topology validation or complete cutter coverage may reject before issuing a hardware query. Ordinary scenes compile out both the list and CSG geometry arrays.
bool nwbOpticalClosestSurfaceHit(
    const NwbOpticalTraceConfig config,
    const float3 origin,
    const float3 direction,
    const float minimum,
    const float maximum,
    out NwbRayTraceSurfaceHit hit,
#if NWB_CSG_RAY_OPTICAL_REUSE
    out NwbRayTraceCsgBoundaryCertificate certificate,
#endif
    inout NwbOpticalTraceResult result
){
    hit = (NwbRayTraceSurfaceHit)0;
#if NWB_CSG_RAY_OPTICAL_REUSE
    certificate = (NwbRayTraceCsgBoundaryCertificate)0;
#endif
    NwbRayTraceGeometryHit closest = nwbRayTraceClosestOrdinaryGeometryHit(origin, direction, minimum, maximum);
#if NWB_RT_CSG_ENABLED
    result.physicalQueries += closest.physicalQueries;
#endif
#if NWB_RT_CSG_ENABLED
    const uint contextSlot = NWB_RT_CSG_CONTEXT_SLOT;
    const uint activeOffset = nwbHeapRawBuffer(contextSlot).Load(20u);
    const uint activeCount = nwbHeapRawBuffer(contextSlot).Load(24u);
    for(uint index = 0u; index < activeCount; ++index){
        const uint instance = nwbHeapRawBuffer(contextSlot).Load(activeOffset + index * 4u);
        const NwbSwBvhInstance receiver = nwbCsgRayLoadInstance(contextSlot, instance);
        const NwbBvhNode root = nwbCsgRayReceiverRoot(contextSlot, instance, receiver);
        if(!nwbCsgRayBoundsIntersect(receiver, root, origin, direction, minimum, closest.distance))
            continue;
        if(!nwbOpticalConsumeQuery(config, result))
            return false;
        const NwbRayTraceGeometryHit geometry = nwbRayTraceCsgGeometryHit(
            contextSlot, config.instanceMaterialHeapSlot, instance, origin, direction, minimum, closest.distance
#if NWB_CSG_RAY_OPTICAL_REUSE
            , true
#endif
        );
        result.physicalQueries += geometry.physicalQueries;
        if(geometry.hit){
            closest = geometry;
#if NWB_CSG_RAY_OPTICAL_REUSE
            certificate = geometry.certificate;
#endif
        }
        if(closest.failure != 0u)
            break;
    }
#endif
    hit = nwbRayTraceReconstructSurfaceHit(config.instanceMaterialHeapSlot, origin, direction, closest);
    return true;
}

// Resolve numerical ties around the true nearest transparent boundary before changing membership. A second bounded candidate query is necessary because a committed nearest hit alone cannot reveal coincident independent volumes. The authored coincidence selector has already removed explicitly shared boundaries from the scene.
bool nwbOpticalCheckBoundary(
    const NwbOpticalTraceConfig config,
    const float3 origin,
    const float3 direction,
    const NwbRayTraceSurfaceHit hit,
#if NWB_CSG_RAY_OPTICAL_REUSE
    __constref NwbRayTraceCsgBoundaryCertificate certificate,
#endif
    inout NwbOpticalTraceResult result
){
    if(!nwbOpticalConsumeQuery(config, result))
        return false;
    const float tolerance = 4.0 * max(nwbOpticsPositionUncertainty(origin), nwbOpticsPositionUncertainty(hit.position));
    RayDesc ray;
    ray.Origin = origin;
    ray.Direction = direction;
    ray.TMin = max(0.0, hit.distance - tolerance);
    ray.TMax = hit.distance + tolerance;
    RayQuery<RAY_FLAG_FORCE_NON_OPAQUE> query;
#if NWB_RT_CSG_ENABLED
    bool csgFound = false;
    const uint contextSlot = NWB_RT_CSG_CONTEXT_SLOT;
    const uint activeOffset = nwbHeapRawBuffer(contextSlot).Load(20u);
    const uint activeCount = nwbHeapRawBuffer(contextSlot).Load(24u);
    for(uint index = 0u; index < activeCount; ++index){
        const uint instance = nwbHeapRawBuffer(contextSlot).Load(activeOffset + index * 4u);
        const NwbRtInstanceMaterial material = nwbHeapRtInstanceMaterials(config.instanceMaterialHeapSlot)[instance];
        if((material.flags & NWB_RT_INSTANCE_MATERIAL_FLAG_TRANSPARENT) == 0u)
            continue;
        const NwbSwBvhInstance receiver = nwbCsgRayLoadInstance(contextSlot, instance);
        const NwbBvhNode root = nwbCsgRayReceiverRoot(contextSlot, instance, receiver);
        if(!nwbCsgRayBoundsIntersect(receiver, root, origin, direction, ray.TMin, ray.TMax))
            continue;
        if(!nwbOpticalConsumeQuery(config, result))
            return false;
#if NWB_CSG_RAY_OPTICAL_REUSE
        const bool reuse = certificate.reusable && instance == hit.instance;
        NwbRayTraceCsgBoundaryCheck geometry;
        if(reuse)
            geometry = certificate.window;
        else{
            const NwbRayTraceGeometryHit collected = nwbRayTraceCsgGeometryHit(
                contextSlot, config.instanceMaterialHeapSlot, instance, origin, direction, ray.TMin, ray.TMax, false
            );
            result.physicalQueries += collected.physicalQueries;
            geometry = nwbRayTraceCsgCheckedBoundary(collected);
        }
#else
        const NwbRayTraceGeometryHit geometry = nwbRayTraceCsgGeometryHit(
            contextSlot, config.instanceMaterialHeapSlot, instance, origin, direction, ray.TMin, ray.TMax
        );
        result.physicalQueries += geometry.physicalQueries;
#endif
        if(geometry.failure != 0u || (geometry.hit && (instance != hit.instance || geometry.primitive != hit.primitive || geometry.cutter != hit.cutter))){
            result.termination = NWB_OPTICAL_TERMINATION_AMBIGUOUS;
            return false;
        }
        if(geometry.hit){
            csgFound = true;
            if(!nwbOpticalConsumeQuery(config, result))
                return false;
#if NWB_CSG_RAY_OPTICAL_REUSE
            NwbRayTraceCsgBoundaryCheck next;
            if(reuse)
                next = certificate.next;
            else{
                const NwbRayTraceGeometryHit collected = nwbRayTraceCsgGeometryHit(
                    contextSlot, config.instanceMaterialHeapSlot, instance, origin, direction, geometry.distance, ray.TMax, false
                );
                result.physicalQueries += collected.physicalQueries;
                next = nwbRayTraceCsgCheckedBoundary(collected);
            }
#else
            const NwbRayTraceGeometryHit next = nwbRayTraceCsgGeometryHit(
                contextSlot, config.instanceMaterialHeapSlot, instance, origin, direction, geometry.distance, ray.TMax
            );
            result.physicalQueries += next.physicalQueries;
#endif
            if(next.failure != 0u || next.hit){
                result.termination = NWB_OPTICAL_TERMINATION_AMBIGUOUS;
                return false;
            }
        }
    }
    query.TraceRayInline(nwbHeapAccelStruct(), RAY_FLAG_FORCE_NON_OPAQUE, NWB_RT_SHADOW_TRANSPARENT_INSTANCE_MASK, ray);
    ++result.physicalQueries;
    bool found = csgFound;
#else
    query.TraceRayInline(nwbHeapAccelStruct(), RAY_FLAG_FORCE_NON_OPAQUE, NWB_RT_OPTICAL_TRANSPARENT_INSTANCE_MASK, ray);
    bool found = false;
#endif
    [loop]
    for(uint candidate = 0u; candidate < NWB_OPTICAL_MAX_CANDIDATE_EVENTS; ++candidate){
        if(!query.Proceed()){
            if(!found)
                result.termination = NWB_OPTICAL_TERMINATION_AMBIGUOUS;
            return found;
        }
        if(query.CandidateType() != CANDIDATE_NON_OPAQUE_TRIANGLE || query.CandidateInstanceID() != hit.instance){
            query.Abort();
            result.termination = NWB_OPTICAL_TERMINATION_AMBIGUOUS;
            return false;
        }
#if NWB_RT_CSG_ENABLED
        if(csgFound){
            query.Abort();
            result.termination = NWB_OPTICAL_TERMINATION_AMBIGUOUS;
            return false;
        }
#endif
        if(query.CandidatePrimitiveIndex() == hit.primitive){
            // The already reconstructed primitive is the common case; only another triangle needs seam geometry.
            found = true;
            continue;
        }
        const NwbRtInstanceMaterial material = nwbHeapRtInstanceMaterials(config.instanceMaterialHeapSlot)[hit.instance];
        const float3 normal = nwbRayTraceTriangleGeometricNormal(
            material, query.CandidatePrimitiveIndex(), query.CandidateWorldToObject3x4()
        );
        const float facing = dot(direction, normal);
        if(!isfinite(facing) || abs(facing) <= 1e-6 || facing * dot(direction, hit.geometricNormal) <= 0.0 || !nwbRayTraceCoplanarSeam(config.instanceMaterialHeapSlot, hit.instance, hit.primitive, query.CandidatePrimitiveIndex())){
            query.Abort();
            result.termination = NWB_OPTICAL_TERMINATION_AMBIGUOUS;
            return false;
        }
        found = true;
    }
    query.Abort();
    result.termination = NWB_OPTICAL_TERMINATION_EVENT_LIMIT;
    return false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// One dominant transmitted path; radiance preserved on every termination. Secondary Fresnel is an omitted branch (not an env approximation); TIR keeps membership. No path tree escapes the query budget; in-medium miss adds no env.
NwbOpticalTraceResult nwbOpticalTrace(
    const NwbOpticalTraceConfig config,
    const float3 initialOrigin,
    const float3 initialDirection
){
    NwbOpticalTraceResult result = (NwbOpticalTraceResult)0;
    result.termination = NWB_OPTICAL_TERMINATION_UNSUPPORTED;
    if(!all(isfinite(initialOrigin)) || !all(isfinite(initialDirection)) || dot(initialDirection, initialDirection) <= 0.0 || !isfinite(config.minDistance) || !isfinite(config.maxDistance) || config.minDistance < 0.0 || config.maxDistance <= config.minDistance || config.opticalSceneHeapSlot == 0xffffffffu)
        return result;
    float3 direction = normalize(initialDirection);
    float3 origin = initialOrigin;
    NwbOpticalMedia media;
    if(!nwbOpticalBootstrap(config, origin, direction, media, result))
        return result;

    half3 throughput = half3(1.0h, 1.0h, 1.0h);
    float minDistance = config.minDistance;
    float continuationUncertainty = 0.0;
    [loop]
    for(uint step = 0u; step < NWB_OPTICAL_MAX_QUERIES; ++step){
        const float remaining = config.maxDistance - result.distance;
        if(remaining <= minDistance){
            result.termination = NWB_OPTICAL_TERMINATION_RANGE;
            return result;
        }
        if(!nwbOpticalConsumeQuery(config, result))
            return result;
        NwbRayTraceSurfaceHit hit;
#if NWB_CSG_RAY_OPTICAL_REUSE
        NwbRayTraceCsgBoundaryCertificate certificate;
#endif
        if(!nwbOpticalClosestSurfaceHit(
            config, origin, direction, minDistance, remaining, hit,
#if NWB_CSG_RAY_OPTICAL_REUSE
            certificate,
#endif
            result
        ))
            return result;
        if(!hit.hit){
            if(media.count != 0u){
                result.termination = NWB_OPTICAL_TERMINATION_RANGE;
                return result;
            }
            result.radiance += throughput * nwbOpticalEnvironmentRadiance(direction);
            result.termination = NWB_OPTICAL_TERMINATION_MISS_OUTSIDE;
            return result;
        }
#if NWB_RT_CSG_ENABLED
        if(hit.failure != 0u){
            result.surfaceHit = true;
            result.transparentPath = (hit.flags & NWB_RT_INSTANCE_MATERIAL_FLAG_TRANSPARENT) != 0u;
            result.termination = (hit.failure & NWB_CSG_RAY_FAILURE_AMBIGUOUS_NORMAL) != 0u
                ? NWB_OPTICAL_TERMINATION_AMBIGUOUS : NWB_OPTICAL_TERMINATION_UNSUPPORTED
            ;
            return result;
        }
#endif
        result.surfaceHit = true;
        if(!isfinite(hit.distance) || !all(isfinite(hit.position)) || !all(isfinite(hit.geometricNormal)) || dot(hit.geometricNormal, hit.geometricNormal) == 0.0 || hit.distance <= continuationUncertainty){
            result.termination = NWB_OPTICAL_TERMINATION_AMBIGUOUS;
            return result;
        }
        result.distance += hit.distance;
        const NwbOpticalMedium incidentMedium = nwbOpticalDominantMedium(media);
        throughput *= nwbDielectricBeerTransmission(incidentMedium.absorption, hit.distance);
        NwbOpticalInstance optical;
        if(!nwbOpticalReadInstance(config, hit.instance, optical, result))
            return result;
        if((optical.flags & NWB_RT_OPTICAL_INSTANCE_FLAG_TRANSPARENT) == 0u){
            result.radiance += throughput * nwbOpticalSurfaceRadiance(hit, -direction);
            result.termination = NWB_OPTICAL_TERMINATION_OPAQUE;
            return result;
        }
        result.transparentPath = true;
        NwbOpticalMedium boundaryMedium = (NwbOpticalMedium)0;
        boundaryMedium.instance = hit.instance;
        boundaryMedium.entityId = optical.entityId;
        boundaryMedium.mode = optical.mode;
        boundaryMedium.priority = optical.priority;
        if(!nwbOpticalSetMediumProperties(hit.surface, boundaryMedium, result))
            return result;
        if(optical.mode == NWB_RT_OPTICAL_BOUNDARY_UNSPECIFIED && boundaryMedium.ior != 1.0){
            result.termination = NWB_OPTICAL_TERMINATION_UNSUPPORTED;
            return result;
        }
        if(!nwbOpticalCheckBoundary(
            config, origin, direction, hit,
#if NWB_CSG_RAY_OPTICAL_REUSE
            certificate,
#endif
            result
        ))
            return result;

        if(optical.mode == NWB_RT_OPTICAL_BOUNDARY_UNSPECIFIED){
            // Backdrop coverage is a (0, 1) bounded factor, so half math is sufficient here.
            const half coverage = hit.surface.renderCoverage;
            if(!isfinite(coverage)){
                result.termination = NWB_OPTICAL_TERMINATION_UNSUPPORTED;
                return result;
            }
            // The backdrop alpha is a (0, 1) bounded factor, so half arithmetic is sufficient here.
            const half alpha = half(saturate(coverage));
            if(alpha > half(0.0h))
                result.radiance += throughput * alpha * nwbOpticalSurfaceRadiance(hit, -direction);
            throughput *= half(1.0h) - alpha;
            if(alpha == half(1.0h)){
                result.termination = NWB_OPTICAL_TERMINATION_OPAQUE;
                return result;
            }
        }
        else{
#if NWB_OPTICAL_CLOSED_MEDIA
            if(optical.mode != NWB_RT_OPTICAL_BOUNDARY_CLOSED_NESTED && optical.mode != NWB_RT_OPTICAL_BOUNDARY_CLOSED_PRIORITY){
                result.termination = NWB_OPTICAL_TERMINATION_UNSUPPORTED;
                return result;
            }
            const float facing = dot(direction, hit.geometricNormal);
            if(abs(facing) <= 1e-6){
                result.termination = NWB_OPTICAL_TERMINATION_AMBIGUOUS;
                return result;
            }
            const bool entering = facing < 0.0;
            NwbOpticalMedia transmittedMedia = media;
            if(!nwbOpticalApplyBoundary(transmittedMedia, boundaryMedium, entering, result))
                return result;
            const NwbOpticalMedium transmittedMedium = nwbOpticalDominantMedium(transmittedMedia);
            const NwbDielectricInterface boundary = nwbDielectricTransmit(
                direction, entering ? hit.geometricNormal : -hit.geometricNormal,
                incidentMedium.ior, transmittedMedium.ior
            );
            direction = boundary.direction;
            if(boundary.totalInternalReflection)
                ++result.tirCount;
            else{
                throughput *= half(boundary.radianceTransmission);
                media = transmittedMedia;
            }
#else
            result.termination = NWB_OPTICAL_TERMINATION_UNSUPPORTED;
            return result;
#endif
        }
        // Reconstructed hits have FP32 world-position uncertainty, independent of the receiver's FP16 G-buffer bias.
        // Offset to the next geometric half-space and require progress on the next query. Near-coincident crossings within the same uncertainty band were checked before changing direction; no instance is ignored.
        continuationUncertainty = nwbOpticsPositionUncertainty(hit.position);
        const float3 offsetNormal = dot(direction, hit.geometricNormal) >= 0.0 ? hit.geometricNormal : -hit.geometricNormal;
        origin = hit.position + offsetNormal * continuationUncertainty;
        minDistance = 0.0;
    }
    result.termination = NWB_OPTICAL_TERMINATION_QUERY_LIMIT;
    return result;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


