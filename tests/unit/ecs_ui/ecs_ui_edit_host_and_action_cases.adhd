#define EXPECT_TRUE(...) native{ EXPECT_TRUE(...) }
#define EXPECT_FALSE(...) native{ EXPECT_FALSE(...) }
#define EXPECT_EQ(...) native{ EXPECT_EQ(...) }

b8 EcsUiEditHostAndActionCasesReady(in u64 value){
    return value != 0u;
}

native{
#include <tests/unit/ecs_ui/suite.adhd.h>


#include <impl/ecs_ui/clipboard_publications.adhd.h>

#include <tests/common/test_context.adhd.h>

#include <gtest/gtest.h>


