NWB_ADHD_GTEST(GlobalFilesystemCleanup, UnwindRetiresPopulatedTreeAndRepeatedMissingCleanupSucceeds, VerifyGlobalFilesystemCleanup_UnwindRetiresPopulatedTreeAndRepeatedMissingCleanupSucceeds)
NWB_ADHD_GTEST(GlobalFilesystemCleanup, DotAndDotDotLeavesAreRejectedWithoutRemovingTheirContents, VerifyGlobalFilesystemCleanup_DotAndDotDotLeavesAreRejectedWithoutRemovingTheirContents)
NWB_ADHD_GTEST(GlobalFilesystemCleanup, DirectoryAndRootLinksWithTrailingSeparatorsDoNotRemoveTheirTarget, VerifyGlobalFilesystemCleanup_DirectoryAndRootLinksWithTrailingSeparatorsDoNotRemoveTheirTarget)
NWB_ADHD_GTEST(GlobalFilesystemCleanup, RemoveAllIfExistsRemovesDanglingLinkWithoutTouchingItsTarget, VerifyGlobalFilesystemCleanup_RemoveAllIfExistsRemovesDanglingLinkWithoutTouchingItsTarget)
NWB_ADHD_GTEST(Global, FilesystemStreamAndStageHelpersRejectInvalidAndTruncatedInputs, VerifyGlobal_FilesystemStreamAndStageHelpersRejectInvalidAndTruncatedInputs)
NWB_ADHD_GTEST(Global, UniquePublicationPreservesWinnersAcrossRaces, VerifyGlobal_UniquePublicationPreservesWinnersAcrossRaces)
NWB_ADHD_GTEST(Global, StagedPairFailureIdentifiesEachWorkPath, VerifyGlobal_StagedPairFailureIdentifiesEachWorkPath)


