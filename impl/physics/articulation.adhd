    public void shiftOrigin(in VectorSingle negDelta){
        const VectorSingle d(negDelta, 0.0f);
        this.baseTransform.position = f32x4(VectorSingle(this.baseTransform.position) + d, 0.0f);
        this.m_syncedBaseTransform.position = this.baseTransform.position;
        for(usize i = 0u; i < this.linkStates.size(); ++i)
            this.linkStates[i].worldTransform.position = f32x4(VectorSingle(this.linkStates[i].worldTransform.position) + d, 0.0f);
        for(usize i = 0u; i < this.m_cachedLinkPosScratch.size(); ++i)
            this.m_cachedLinkPosScratch[i] = f32x4(VectorSingle(this.m_cachedLinkPosScratch[i]) + d, 0.0f);
        for(usize i = 0u; i < this.m_selfColLinkAabbsScratch.size(); ++i){
            this.m_selfColLinkAabbsScratch[i].lowerBound = f32x4(VectorSingle(this.m_selfColLinkAabbsScratch[i].lowerBound) + d, 0.0f);
            this.m_selfColLinkAabbsScratch[i].upperBound = f32x4(VectorSingle(this.m_selfColLinkAabbsScratch[i].upperBound) + d, 0.0f);
        }
        for(usize i = 0u; i < this.m_selfColShapeAabbsScratch.size(); ++i){
            this.m_selfColShapeAabbsScratch[i].lowerBound = f32x4(VectorSingle(this.m_selfColShapeAabbsScratch[i].lowerBound) + d, 0.0f);
            this.m_selfColShapeAabbsScratch[i].upperBound = f32x4(VectorSingle(this.m_selfColShapeAabbsScratch[i].upperBound) + d, 0.0f);
        }
        if(this.m_aggregateAabbValid){
            this.m_aggregateAabb.lowerBound = f32x4(VectorSingle(this.m_aggregateAabb.lowerBound) + d, 0.0f);
            this.m_aggregateAabb.upperBound = f32x4(VectorSingle(this.m_aggregateAabb.upperBound) + d, 0.0f);
        }
        if(this.m_aggregateEnvAabbValid){
            this.m_aggregateEnvAabb.lowerBound = f32x4(VectorSingle(this.m_aggregateEnvAabb.lowerBound) + d, 0.0f);
            this.m_aggregateEnvAabb.upperBound = f32x4(VectorSingle(this.m_aggregateEnvAabb.upperBound) + d, 0.0f);
        }
        if(this.m_sleepAggregateAabbValid){
            this.m_sleepAggregateAabb.lowerBound = f32x4(VectorSingle(this.m_sleepAggregateAabb.lowerBound) + d, 0.0f);
            this.m_sleepAggregateAabb.upperBound = f32x4(VectorSingle(this.m_sleepAggregateAabb.upperBound) + d, 0.0f);
        }
    }

    public void reset(){
        this.linkDefs.clear();
        this.linkStates.clear();
        this.baseTransform = Transform3D();
        this.baseVelocity = SpatialVec();
        this.mimicConstraints.clear();
        this.tendonConstraints.clear();
        this.spatialTendons.clear();
        this.loopConstraints.clear();
        this.rigidBodyConstraints.clear();
        this.stepBreakEvents.clear();
        this.enableBreakEvents = false;
        this.m_linkSpatialInertia.clear();
        this.m_linkSubspaces.clear();
        this.m_linkCacheKeys.clear();
        this.m_linkBasisAxis0.clear();
        this.m_linkBasisAxis1.clear();
        this.m_linkBasisAxis2.clear();
        this.m_linkDofOffsets.clear();
        this.m_totalDofCount = 0u;
        this.m_cachedFixedBase = true;
        this.m_hasPoseDependentSubspace = false;
        this.m_cachesDirty = true;
        this.m_syncedBaseTransform = Transform3D();
        this.m_fkDirty = true;
        this.m_fkValid = false;
        this.m_linkShapeCacheValid = false;
        this.m_aggregateAabb = Aabb3D();
        this.m_aggregateAabbValid = false;
        this.m_aggregateEnvAabb = Aabb3D();
        this.m_aggregateEnvAabbValid = false;
        this.m_sleepAggregateAabb = Aabb3D();
        this.m_sleepAggregateAabbValid = false;
        this.m_recordReactionForcesThisSubstep = true;
        this.m_relP2C.clear();
        this.m_biasC.clear();
        this.m_zeroAccelBiasForce.clear();
        this.m_iaList.clear();
        this.m_pAList.clear();
        this.m_abcData.clear();
        this.m_accel.clear();
        this.m_reactionForceScratch.clear();
        this.m_impU3.clear();
        this.m_impDv.clear();
        this.m_syncedQ3.clear();
        this.m_syncedJointRot.clear();
        this.m_proxyShapesScratch.clear();
        this.m_broadphaseShapeScratch.clear();
        this.m_broadphaseStampScratch.clear();
        this.m_broadphaseQueryStamp = 1u;
        this.m_sweepPAccumScratch.clear();
        this.m_sweepUValScratch.clear();
        this.m_sweepExtImpScratch.clear();
        this.m_constraintJointImpScratch.clear();
        this.m_selfColLinkAabbsScratch.clear();
        this.m_selfColLinkHasShapesScratch.clear();
        this.m_selfColShapeOffsetsScratch.clear();
        this.m_selfColShapeCountsScratch.clear();
        this.m_selfColAllShapesScratch.clear();
        this.m_selfColShapeAabbsScratch.clear();
        this.m_selfColShapeFilterOkScratch.clear();
        this.m_cachedLinkPosScratch.clear();
        this.m_cachedLinkRotScratch.clear();
        this.m_sleepCandShapesScratch.clear();
        this.m_sleepActiveCandsScratch.clear();
        this.m_cachedProxyBodies.clear();
        this.m_ownBodyLookup.clear();
        this.m_ownBodyIdxMin = 0u;
        this.m_ownBodyFallbackMap.clear();
        this.m_ownBodyUseMap = false;
        this.m_sparseChainStampScratch.clear();
        this.m_sparseChainStampVal = 1u;
        this.m_sparseChainActiveStampScratch.clear();
        this.m_impActiveLinksScratch.clear();
        this.m_pgsUnitDqdScratch.clear();
        this.m_pgsUnitDvScratch.clear();
        this.m_mimicUnitMetaScratch.clear();
        this.m_tendonUnitMetaScratch.clear();
        this.m_spTendonUnitMetaScratch.clear();
        this.m_loopUnitMetaScratch.clear();
        this.m_rbConstraintUnitMetaScratch.clear();
        this.m_contactConstraintsScratch.clear();
        this.m_pairContactsScratch.clear();
        this.m_warmContactLambdaN.clear();
        this.m_warmContactLambdaT.clear();
        this.m_tendonLambdaScratch.clear();
        this.m_spatialTendonLambdaScratch.clear();
        this.m_prevLinkTransformsScratch.clear();
        this.m_linkDetachedMask.clear();
        this.m_envGravSubtractedScratch.clear();
        this.m_ikJacScratch.clear();
