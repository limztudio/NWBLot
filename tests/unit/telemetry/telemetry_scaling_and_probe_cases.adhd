    }),
    MakeNotNull<FrameGraphRuntimeStatisticsMutation>([](Telemetry::FrameGraphRuntimeStatistics& statistics)noexcept{
        statistics.submission.acceptedTaskCount = statistics.compile.taskCount + 1u;
    }),
