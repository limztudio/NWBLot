#include <impl/ecs_ui/toolkit/builder.adhd>
#include <impl/ecs_ui/toolkit/widgets/control_style_metrics.adhd>
#include <impl/ecs_ui/toolkit/widgets/control_visual_painter.adhd>
#include <impl/ecs_ui/toolkit/widgets/hit_target_factory.adhd>
#include <impl/ecs_ui/toolkit/widgets/list_input.adhd>
#include <impl/ecs_ui/toolkit/widgets/ui_scope_descriptor_factory.adhd>
#include <impl/ecs_ui/toolkit/widgets/popup_style.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Rect ResolveWindowFirstUseViewport(in Rect bounds, in DisplayMetrics display){
    return Rect(bounds.x, bounds.y, Max(display.logicalWidth, bounds.width), Max(display.logicalHeight, bounds.height));
}

Rect ResolveWindowHeaderBounds(in Rect windowBounds, in f32 titleHeight){
    return Rect(windowBounds.x, windowBounds.y, windowBounds.width, titleHeight);
}

b8 ShouldFocusComboFieldOnCommit(in b8 enabled, in b8 previouslyFocused, in WidgetId currentFocus, in WidgetId fieldId, in b8 open){
    return enabled && previouslyFocused && currentFocus != fieldId && !open;
}

b8 ShouldFocusComboRowsOnCommit(in b8 enabled, in b8 previouslyListFocused, in WidgetId currentFocus, in WidgetId rowsId){
    return enabled && previouslyListFocused && currentFocus != rowsId;
}

b8 IsComboVisibleFieldNonEmpty(in Rect visibleField){
    return visibleField.width > 0.0f && visibleField.height > 0.0f;
}

b8 IsComboResultFocused(in b8 enabled, in WidgetId focusId, in WidgetId fieldId, in WidgetId rowsId, in b8 hasEditor, in WidgetId editorId){
    if(!enabled)
        return false;
    return focusId == fieldId || focusId == rowsId || (hasEditor && focusId == editorId);
}

PopupOptions BuildComboPopupOptions(in Rect anchor, in f32 popupHeight){
    PopupOptions options;
    options.anchor = anchor;
    options.size = Point(anchor.width, popupHeight);
    return options;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 Builder::beginWindow(in StringView stableKey, in StringView title, mut WindowState state, in WindowOptions options){
    if(this.declarationBlocked() || this.m_scope.value().m_panelActive || this.m_scope.value().m_windowActive || !this.m_skin.has_value() || this.m_context.failed()){
        this.m_context.fail();
        return false;
    }
    this.reset();
    this.m_scope.value().m_window.style = this.m_style;
    const auto window = this.m_context.declare(stableKey, WidgetKind::Window);
    const ShapeRequest request = this.textShapeRequest(title, this.m_style.fontSize);
    if(!window.has_value()){
        this.m_context.fail();
        return false;
    }
    auto titleLayout = this.m_text.layout(request);
    if(!titleLayout.has_value()){
        this.m_context.fail();
        return false;
    }
    MoveInto<TextLayout>(this.m_scope.value().m_window.title, titleLayout.value());
    const auto titleBounds = this.m_text.measure(this.m_scope.value().m_window.title, this.m_paint.displayMetrics());
    if(!titleBounds.has_value() || !ControlStyleMetrics().windowMetrics(this.m_skin.value(), this.m_style, options, Point(titleBounds.value().width, titleBounds.value().height), this.m_scope.value().m_window.metrics)){
        this.m_context.fail();
        return false;
    }
    this.m_scope.value().m_window.titleBounds = titleBounds.value();
    this.m_scope.value().m_panelState = window.value();
    this.m_scope.value().m_window.state = Optional<mut WindowState>(state);
    this.m_scope.value().m_window.options = options;
    this.m_scope.value().m_window.firstUse = !state.initialized;
    WindowState candidate = state;
    if(!TryInitializeWindow(options, this.m_scope.value().m_window.metrics, candidate) || !this.m_context.pushScope(stableKey)){
        this.m_context.fail();
        return false;
    }
    const auto titleState = this.m_context.declare(s_WindowChromeTitleKey, WidgetKind::Window);
    const auto collapseState = this.m_context.declare(s_WindowChromeCollapseKey, WidgetKind::Button);
    const auto resizeState = this.m_context.declare(s_WindowChromeResizeKey, WidgetKind::Window);
    if(!titleState.has_value() || !collapseState.has_value() || !resizeState.has_value()){
        this.m_context.fail();
        return false;
    }
    this.m_scope.value().m_window.titleState = titleState.value();
    this.m_scope.value().m_window.collapseState = collapseState.value();
    this.m_scope.value().m_window.resizeState = resizeState.value();
    if(!options.collapsible)
        candidate.collapsed = false;
    if(this.m_context.takeActivation(this.m_scope.value().m_window.collapseState, options.collapsible))
        candidate.collapsed = !candidate.collapsed;
    while(true){
        auto gesture = this.m_context.takePointerGesture(this.m_scope.value().m_window.titleState, options.movable);
        if(!gesture.has_value())
            break;
        if(!TryApplyWindowMove(gesture.value(), candidate)){
            this.m_context.fail();
            return false;
        }
    }
    while(true){
        auto gesture = this.m_context.takePointerGesture(this.m_scope.value().m_window.resizeState, options.resizable && !candidate.collapsed);
        if(!gesture.has_value())
            break;
        if(!TryApplyWindowResize(gesture.value(), this.m_scope.value().m_window.metrics.minimumSize, candidate)){
            this.m_context.fail();
            return false;
        }
    }
    if(!TryConstrainWindow(this.m_paint.displayMetrics(), this.m_scope.value().m_window.metrics.titleHeight, candidate)){
        this.m_context.fail();
        return false;
    }
    this.m_scope.value().m_bounds = ResolveWindowContentBounds(candidate, this.m_scope.value().m_window.metrics);
    const LayoutNodeDesc description = BuildWindowRootLayoutNodeDesc(options, this.m_scope.value().m_window.metrics, this.m_scope.value().m_bounds, this.m_scope.value().m_window.firstUse, this.m_style.gap);
    u32 node = 0u;
    const auto admittedNode = this.m_scope.value().m_layout.addNode(s_LayoutNoParent, description);
    if(!admittedNode.has_value()){
        this.m_context.fail();
        return false;
    }
    node = admittedNode.value();
    this.m_scope.value().m_stack.push_back(node);
    this.m_scope.value().m_panelActive = true;
    this.m_scope.value().m_windowActive = true;
    state = candidate;
    return !state.collapsed;
}

b8 Builder::endWindow(){
    if(this.declarationBlocked() || !this.m_scope.value().m_windowActive || !this.m_scope.value().m_panelActive || !this.m_scope.value().m_window.state.has_value() || this.m_scope.value().m_stack.size() != 1u || this.m_context.failed()){
        this.m_context.fail();
        return false;
    }
    this.m_finalizing = true;
    BuilderOperationEnd finish(this.m_finalizing);
    mut WindowState state = this.m_scope.value().m_window.state.value();
    b8 arranged = true;
    if(!state.collapsed){
        in DisplayMetrics display = this.m_paint.displayMetrics();
        const Rect viewport = ResolveWindowFirstUseViewport(this.m_scope.value().m_bounds, display);
        arranged = this.m_scope.value().m_layout.arrange(viewport);
        const Optional<LayoutBox> root = this.m_scope.value().m_layout.box(0u);
        if(arranged && root.has_value()){
            arranged = TryFinalizeWindowFirstUseArrangement(
                this.m_scope.value().m_window.options,
                this.m_scope.value().m_window.metrics,
                root.value().rectangle,
                this.m_scope.value().m_window.firstUse,
                display,
                state,
                this.m_scope.value().m_bounds
            );
            if(arranged)
                arranged = this.m_scope.value().m_layout.arrange(this.m_scope.value().m_bounds);
        }
        else
            arranged = false;
    }
    const b8 painted = arranged && this.paintWindow();
    const b8 popped = this.m_context.popScope();
    this.m_scope.value().m_panelActive = false;
    this.m_scope.value().m_windowActive = false;
    this.m_scope.value().m_window.state.reset();
    this.m_scope.value().m_stack.clear();
    const b8 combosPainted = painted && popped && this.paintDeferred();
    this.publishSliderResults(combosPainted);
    this.releaseDeferredLoans();
    if(!combosPainted)
        this.m_context.fail();
    return combosPainted;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 Builder::paintWindow(){
    HitTargetFactory targets;
    in WindowState state = this.m_scope.value().m_window.state.value();
    in WidgetStyle style = this.m_scope.value().m_window.style;
    const Rect bounds = ResolveVisibleWindowBounds(state, this.m_scope.value().m_window.metrics);
    const Rect clip = this.visibleClip(bounds);
    this.m_paint.pushClip(clip);
    const b8 painted = this.m_paint.drawRegion(style.window, bounds);
    const b8 popped = this.m_paint.popClip();
    const HitTarget barrier = targets.makeBarrierHitTarget(bounds, clip);
    if(!painted || !popped || !this.m_context.addTarget(this.m_scope.value().m_panelState, barrier) || !this.paintWindowTitle())
        return false;
    if(state.collapsed)
        return true;
    return this.paintItems() && this.paintWindowResize();
}

b8 Builder::paintWindowTitle(){
    ControlVisualPainter painter;
    HitTargetFactory targets;
    in WindowState state = this.m_scope.value().m_window.state.value();
    in WidgetStyle style = this.m_scope.value().m_window.style;
    in WindowMetrics metrics = this.m_scope.value().m_window.metrics;
    const Rect header = ResolveWindowHeaderBounds(state.bounds, metrics.titleHeight);
    const Rect clip = this.visibleClip(header);
    in InputRouter input = this.m_context.input();
    const b8 collapseHovered = input.hover() == this.m_scope.value().m_window.collapseState.id;
    const b8 collapsePressed = input.pressed(this.m_scope.value().m_window.collapseState.id);
    const b8 collapseFocused = input.focus() == this.m_scope.value().m_window.collapseState.id;
    const b8 painted = painter.paintWindowTitleHeader(
        this.m_paint,
        this.m_text,
        this.m_skin.value(),
        state,
        style,
        metrics,
        this.m_scope.value().m_window.options.collapsible,
        collapseHovered,
        collapsePressed,
        collapseFocused,
        this.m_scope.value().m_window.title,
        this.m_scope.value().m_window.titleBounds,
        header,
        clip
    );
    const HitTarget title = targets.makeWindowTitleHitTarget(header, clip, state.bounds, this.m_scope.value().m_window.options.movable);
    if(!painted || !this.m_context.addTarget(this.m_scope.value().m_window.titleState, title))
        return false;
    if(this.m_scope.value().m_window.options.collapsible){
        const HitTarget collapse = targets.makeWindowCollapseHitTarget(state, metrics, clip);
        return this.m_context.addTarget(this.m_scope.value().m_window.collapseState, collapse);
    }
    return true;
}

b8 Builder::paintWindowResize(){
    ControlVisualPainter painter;
    HitTargetFactory targets;
    if(!this.m_scope.value().m_window.options.resizable)
        return true;
    in WindowState state = this.m_scope.value().m_window.state.value();
    in WidgetStyle style = this.m_scope.value().m_window.style;
    const Rect corner = ResolveWindowResizeBounds(state, this.m_scope.value().m_window.metrics);
    const Rect clip = this.visibleClip(ResolveVisibleWindowBounds(state, this.m_scope.value().m_window.metrics));
    const b8 painted = painter.paintWindowResizeCorner(this.m_paint, this.m_skin.value(), style, corner, clip);
    const HitTarget target = targets.makeWindowResizeHitTarget(corner, clip, state.bounds);
    return painted && this.m_context.addTarget(this.m_scope.value().m_window.resizeState, target);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


ComboResult Builder::declareCombo(
    in StringView stableKey,
    in borrow IListDataSource source,
    in ComboOptions options,
    in Optional<in SearchComboOptions> searchOptions,
    mut ComboState state,
    in Optional<mut SearchComboState> search,
    in Optional<mut ISearchableListDataSource> searchSource
){
    ComboResult result;
    if(this.itemDeclarationBlocked() || !IsValidComboDeclarationOptions(options, this.m_comboStyle)){
        this.m_context.fail();
        return result;
    }
    if(!this.synchronizePopup()){
        result.valid = true;
        return result;
    }
    this.m_declaring = true;
    BuilderOperationEnd finish(this.m_declaring);
    WidgetKind kind = WidgetKind::ComboBox;
    if(search.has_value())
        kind = WidgetKind::SearchComboBox;
    const auto widget = this.m_context.declare(stableKey, kind);
    if(!widget.has_value())
        return result;
    const WidgetState field = widget.value();
    const u64 previousSelection = state.selectedKey();
    const b8 previouslyOpen = state.isOpen();
    const b8 previouslyFocused = this.m_context.input().focus() == field.id;
    if(!this.m_context.claimState(field, state.m_popup.instanceGeneration()) || !BindComboState(state, field.id, field.declarationGeneration))
        return result;
    state.m_popup.bindParent(this.m_context.popupToken());
    if(previouslyOpen && !state.isOpen())
        CloseComboState(state);
    TextAreaModelStamp queryStamp;
    if(search.has_value())
        queryStamp = search.value().query().stamp();
    if(!ReconcileComboState(state, source) || (search.has_value() && !search.value().query().matchesStamp(queryStamp))){
        this.m_context.fail();
        return result;
    }
    if(search.has_value() && (!FilterSearchCombo(search.value(), searchSource.value()) || !search.value().query().matchesStamp(queryStamp))){
        this.m_context.fail();
        return result;
    }
    Optional<in IListDataSource> resultsLoan(source);
    if(search.has_value())
        resultsLoan = Optional<in IListDataSource>(searchSource.value().filtered());
    in IListDataSource results = resultsLoan.value();
    if(!ReconcileListState(state.m_list, results) || (search.has_value() && !search.value().query().matchesStamp(queryStamp))){
        this.m_context.fail();
        return result;
    }
    BuilderComboFrame frame;
    frame.parentToken = this.m_context.popupToken();
    frame.source = Optional<in IListDataSource>(source);
    frame.results = resultsLoan;
    frame.searchSource = searchSource;
    frame.search = search;
    frame.style = this.m_comboStyle;
    frame.popupStyle = this.m_popupStyle;
    if(searchOptions.has_value()){
        frame.queryHeight = searchOptions.value().queryHeight;
        frame.queryGap = searchOptions.value().queryGap;
    }
    this.snapshotComboQuery(frame);
    frame.state = Optional<mut ComboState>(state);
    frame.options = options;
    frame.token.instanceGeneration = state.inputGeneration();
    frame.token.contentGeneration = source.instanceGeneration();
    frame.token.contentRevision = source.revision();
    frame.rowCount = source.rowCount();
    frame.resultCount = results.rowCount();
    const auto popup = this.m_context.declarePart(field, s_WidgetPartPopup, WidgetKind::Popup);
    if(!popup.has_value())
        return result;
    frame.popup = popup.value();
    const auto rows = this.m_context.declarePart(field, s_WidgetPartRows, WidgetKind::VirtualList);
    if(!rows.has_value())
        return result;
    frame.rows = rows.value();
    frame.popupToken.widget = frame.popup.id;
    frame.popupToken.declarationGeneration = frame.popup.declarationGeneration;
    frame.popupToken.instanceGeneration = state.m_popup.instanceGeneration();
    frame.popupToken.openGeneration = state.m_popup.openGeneration();
    frame.listToken.instanceGeneration = state.m_list.inputGeneration();
    frame.listToken.contentGeneration = results.instanceGeneration();
    frame.listToken.contentRevision = results.revision();
    frame.open = state.isOpen();
    const b8 previouslyListFocused = this.m_context.input().focus() == frame.rows.id;
    if(!this.comboMatches(frame) || !this.applyComboInput(field, frame, result)){
        this.m_context.fail();
        return ComboResult();
    }
    frame.open = state.isOpen();
    state.m_popup.bindParent(frame.parentToken);
    if(search.has_value() && !frame.open)
        search.value().m_editor.focused = false;
    frame.popupToken.openGeneration = state.m_popup.openGeneration();
    frame.listToken.instanceGeneration = state.m_list.inputGeneration();
    const WidgetId currentFocus = this.m_context.input().focus();
    frame.focusOnCommit = ShouldFocusComboFieldOnCommit(options.enabled, previouslyFocused, currentFocus, field.id, frame.open);
    frame.listFocusOnCommit = ShouldFocusComboRowsOnCommit(options.enabled, previouslyListFocused, currentFocus, frame.rows.id);
    auto item = this.makeItem();
    item.state = field;
    item.style = this.m_style;
    item.enabled = options.enabled;
    item.combo = cast<u32>(this.m_scope.value().m_combos.size());
    Point minimumSize;
    if(!this.m_skin.has_value() || !ControlStyleMetrics().comboMetrics(this.m_skin.value(), frame.style, minimumSize, item.padding, frame.arrowExtent)){
        this.m_context.fail();
        return ComboResult();
    }
    const b8 selected = state.selectedKey() != 0u;
    Expected<u64> index(0u);
    if(selected)
        index = source.indexOf(state.selectedKey());
    if(selected && (!index.has_value() || index.value() >= frame.rowCount || source.key(index.value()) != state.selectedKey() || !source.enabled(index.value()))){
        this.m_context.fail();
        return ComboResult();
    }
    StringView label = options.placeholder;
    if(selected)
        label = source.text(index.value());
    const ShapeRequest request = this.textShapeRequest(label, item.style.fontSize);
    auto layout = this.m_text.layout(request);
    if(!layout.has_value()){
        this.m_context.fail();
        return ComboResult();
    }
    MoveInto<TextLayout>(item.text, layout.value());
    if(!this.comboMatches(frame)){
        this.m_context.fail();
        return ComboResult();
    }
    frame.options.placeholder = "";
    ListOptions listOptions;
    listOptions.wheelRows = options.wheelRows;
    listOptions.enabled = options.enabled;
    listOptions.selectOnNavigate = false;
    WidgetId commandFocus;
    if(frame.editor != s_LayoutNoParent)
        commandFocus = this.m_scope.value().m_comboEditors[frame.editor].state.id;
    auto list = this.makeListFrame();
    if(!this.prepareListFrame(frame.results.value(), state.m_list, listOptions, frame.listToken, frame.resultCount, frame.listFocusOnCommit, commandFocus, list).has_value() || !this.comboMatches(frame)){
        this.m_context.fail();
        return ComboResult();
    }
    const auto textBounds = this.m_text.measure(item.text, this.m_paint.displayMetrics());
    if(!textBounds.has_value()){
        this.m_context.fail();
        return ComboResult();
    }
    item.textBounds = textBounds.value();
    const Point measured = Point(textBounds.value().width, textBounds.value().height);
    LayoutNodeDesc description;
    description.width = options.width;
    description.height = options.height;
    description.intrinsicSize = ComputeComboFieldIntrinsicSize(minimumSize, measured, frame.arrowExtent, frame.style.arrowGap, item.padding);
    if(!this.addItemNode(description, item))
        return ComboResult();
    frame.list = cast<u32>(this.m_scope.value().m_lists.size());
    if(frame.open && !this.reserveCompoundPopup(frame.popup, frame.popupToken)){
        this.m_context.fail();
        return ComboResult();
    }
    AppendOwned<BuilderListFrame>(this.m_scope.value().m_lists, list);
    this.m_scope.value().m_combos.push_back(frame);
    AppendOwned<BuilderItem>(this.m_scope.value().m_items, item);
    result.valid = true;
    result.selectionChanged = previousSelection != state.selectedKey();
    result.opened = !previouslyOpen && state.isOpen();
    result.closed = previouslyOpen && !state.isOpen();
    WidgetId editorId;
    if(frame.editor != s_LayoutNoParent)
        editorId = this.m_scope.value().m_comboEditors[frame.editor].state.id;
    result.focused = IsComboResultFocused(options.enabled, this.m_context.input().focus(), field.id, frame.rows.id, frame.editor != s_LayoutNoParent, editorId);
    return result;
}

SearchComboResult Builder::searchComboBox(in StringView stableKey, mut ISearchableListDataSource source, mut SearchComboState state, in SearchComboOptions options){
    if(this.declarationBlocked() || !IsValidSearchComboDeclarationOptions(options)){
        this.m_context.fail();
        return SearchComboResult();
    }
    const usize previousCount = this.m_scope.value().m_combos.size();
    SearchComboResult result;
    result.combo = this.declareCombo(stableKey, source, options.combo, Optional<in SearchComboOptions>(options), state.combo(), Optional<mut SearchComboState>(state), Optional<mut ISearchableListDataSource>(source));
    if(result.combo.valid && this.m_scope.value().m_combos.size() > previousCount)
        result.queryChanged = this.m_scope.value().m_combos.back().queryChanged;
    return result;
}

b8 Builder::prepareComboSearch(in WidgetState field, mut BuilderComboFrame frame){
    mut SearchComboState state = frame.search.value();
    mut EditModel query = state.query();
    if(!frame.open){
        query.cancelComposition();
        this.snapshotComboQuery(frame);
        return this.comboMatches(frame);
    }
    const auto declared = this.m_context.declarePart(field, s_WidgetPartQuery, WidgetKind::EditBox);
    if(!declared.has_value())
        return false;
    const WidgetState editor = declared.value();
    if(!this.m_context.claimState(editor, query.instanceGeneration()))
        return false;
    auto item = this.makeItem();
    item.state = editor;
    item.style = this.m_style;
    item.editStyle = this.m_editStyle;
    item.editOptions.enabled = frame.options.enabled;
    EditBoxResult result;
    result.valid = true;
    result.focused = this.m_context.input().focus() == editor.id;
    if(this.m_editHost.has_value())
        result = this.m_editHost.value().editInPopup(editor, item.editOptions, frame.popupToken, query);
    if(!result.valid)
        return false;
    frame.queryChanged = result.textChanged;
    frame.editorSubmitted = result.submitted;
    if(result.cancelled){
        CloseComboState(frame.state.value());
        this.m_context.input().closePopup(frame.popupToken);
        frame.open = false;
    }
    this.snapshotComboQuery(frame);
    if(!FilterSearchCombo(state, frame.searchSource.value()))
        return false;
    frame.results = Optional<in IListDataSource>(frame.searchSource.value().filtered());
    if(!ReconcileListState(frame.state.value().m_list, frame.results.value()))
        return false;
    frame.listToken.instanceGeneration = frame.state.value().m_list.inputGeneration();
    frame.listToken.contentGeneration = frame.results.value().instanceGeneration();
    frame.listToken.contentRevision = frame.results.value().revision();
    frame.resultCount = frame.results.value().rowCount();
    this.m_context.input().fenceControl(frame.rows.id, frame.rows.declarationGeneration, frame.listToken);
    if(!this.comboMatches(frame))
        return false;
    if(!frame.open)
        return true;
    if(!this.prepareEditBox(result, query, state.m_editor, item))
        return false;
    frame.editor = cast<u32>(this.m_scope.value().m_comboEditors.size());
    AppendOwned<BuilderItem>(this.m_scope.value().m_comboEditors, item);
    return this.comboMatches(frame);
}

void Builder::snapshotComboQuery(mut BuilderComboFrame frame){
    if(!frame.search.has_value())
        return;
    frame.queryStamp = frame.search.value().query().stamp();
}

b8 Builder::paintComboQuery(mut BuilderComboFrame frame, mut LayoutBox content){
    HitTargetFactory targets;
    if(frame.editor >= this.m_scope.value().m_comboEditors.size() || !this.comboMatches(frame))
        return false;
    in BuilderItem item = this.m_scope.value().m_comboEditors[frame.editor];
    const f32 measuredHeight = item.editView.visualBounds().height + item.padding.top + item.padding.bottom;
    Rect nextContentRect = content.rectangle;
    LayoutBox box = content;
    box.rectangle = ResolveComboQueryBoxAndAdvanceContent(measuredHeight, frame.queryHeight, frame.queryGap, nextContentRect);
    const HitTarget navigation = targets.makeComboQueryNavigationTarget(frame.options.enabled, item.editView.composing(), frame.rows.id, frame.rows.declarationGeneration, frame.listToken);
    if(!this.paintEditBox(item, box, Optional<in HitTarget>(navigation)))
        return false;
    content.rectangle = nextContentRect;
    return this.comboMatches(frame);
}

b8 Builder::comboStateMatches(in BuilderComboFrame frame)const{
    if(!frame.state.has_value())
        return false;
    return MatchesComboFrameStateValues(
        this.popupAncestorsVisible(),
        frame.state.value().inputGeneration(),
        frame.token.instanceGeneration,
        frame.state.value().m_list.inputGeneration(),
        frame.listToken.instanceGeneration,
        frame.state.value().isOpen(),
        frame.open,
        frame.state.value().m_popup.instanceGeneration(),
        frame.popupToken.instanceGeneration,
        frame.state.value().m_popup.openGeneration(),
        frame.popupToken.openGeneration,
        frame.state.value().m_popup.m_parent,
        frame.parentToken,
        !frame.search.has_value() || frame.search.value().query().matchesStamp(frame.queryStamp)
    );
}

b8 Builder::comboMatches(in BuilderComboFrame frame)const{
    return
        frame.source.has_value() && this.comboStateMatches(frame) && (!frame.searchSource.has_value() || (frame.results.has_value() && SameAddress(frame.searchSource.value().filtered(), frame.results.value()))) && this.comboStateMatches(frame)
        && frame.source.value().instanceGeneration() == frame.token.contentGeneration && this.comboStateMatches(frame)
        && frame.source.value().revision() == frame.token.contentRevision && this.comboStateMatches(frame)
        && frame.source.value().rowCount() == frame.rowCount && this.comboStateMatches(frame)
        && frame.results.has_value() && frame.results.value().instanceGeneration() == frame.listToken.contentGeneration && this.comboStateMatches(frame)
        && frame.results.value().revision() == frame.listToken.contentRevision && this.comboStateMatches(frame)
        && frame.results.value().rowCount() == frame.resultCount && this.comboStateMatches(frame)
    ;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 Builder::applyComboInput(in WidgetState field, mut BuilderComboFrame frame, mut ComboResult result){
    mut InputRouter input = this.m_context.input();
    mut ComboState state = frame.state.value();
    input.fenceControl(field.id, field.declarationGeneration, frame.token);
    input.fencePopup(frame.popupToken);
    if(!frame.options.enabled){
        input.invalidateTarget(field.id);
        CloseComboState(state);
        input.closePopup(frame.popupToken);
        if(frame.search.has_value()){
            frame.search.value().query().cancelComposition();
            this.snapshotComboQuery(frame);
        }
        return true;
    }
    if(input.consumePopupDismissal(frame.popupToken))
        CloseComboState(state);
    if(!state.isOpen())
        input.closePopup(frame.popupToken);
    if(this.m_context.takeActivation(field, true))
        OpenComboState(state);
    while(true){
        auto action = this.m_context.takeControlAction(field, true, frame.token);
        if(!action.has_value())
            break;
        if(state.isOpen())
            continue;
        if(!IsComboActionEligibleToOpen(action.value().kind))
            continue;
        OpenComboState(state);
        if(!ReconcileListState(state.m_list, frame.results.value()))
            return false;
        if(action.value().kind != ControlActionKind::Submit){
            action.value().control.instanceGeneration = state.m_list.inputGeneration();
            action.value().control.contentGeneration = frame.results.value().instanceGeneration();
            action.value().control.contentRevision = frame.results.value().revision();
            ListOptions options;
            options.wheelRows = frame.options.wheelRows;
            options.selectOnNavigate = false;
            ListResult preview;
            if(!ApplyListControlAction(frame.results.value(), options, action.value(), state.m_list, preview))
                return false;
        }
    }
    if(!ReconcileListState(state.m_list, frame.results.value()))
        return false;
    frame.popupToken.openGeneration = state.m_popup.openGeneration();
    frame.listToken.instanceGeneration = state.m_list.inputGeneration();
    frame.open = state.isOpen();
    input.fencePopup(frame.popupToken);
    input.fenceControl(frame.rows.id, frame.rows.declarationGeneration, frame.listToken);
    if(!this.comboMatches(frame))
        return false;
    if(frame.search.has_value() && !this.prepareComboSearch(field, frame))
        return false;
    return !state.isOpen() || this.applyComboListInput(frame, result);
}

b8 Builder::applyComboListInput(mut BuilderComboFrame frame, mut ComboResult result){
    mut ComboState state = frame.state.value();
    ListOptions options;
    options.wheelRows = frame.options.wheelRows;
    options.selectOnNavigate = false;
    ListInput inputs(this.m_context);
    const ListInputMatches matches = lambda[in this, mut frame]() -> b8{ return this.comboMatches(frame); };
    const ListInputApplyAction apply = lambda[mut this, mut frame, in options, mut state, mut result](in ControlAction action) -> ListActionOutcome{
        const b8 fromEditor = frame.editor != s_LayoutNoParent && action.source == this.m_scope.value().m_comboEditors[frame.editor].state.id;
        const b8 composing = frame.search.has_value() && frame.search.value().query().composition().active;
        if(ShouldIgnoreComboEditorAction(fromEditor, composing, action.kind, frame.editorSubmitted))
            return ListActionOutcome::Continue;
        ListResult preview;
        if(!ApplyListControlAction(frame.results.value(), options, action, state.m_list, preview) || !this.comboMatches(frame))
            return ListActionOutcome::Failed;
        if(!preview.activated)
            return ListActionOutcome::Continue;
        if(!CommitComboSelection(state, frame.source.value(), state.m_list.selectedKey()))
            return ListActionOutcome::Failed;
        result.committed = true;
        this.m_context.input().closePopup(frame.popupToken);
        return ListActionOutcome::Stop;
    };
    return inputs.consume(
        frame.rows,
        frame.listToken,
        true,
        frame.popupToken,
        state.m_list,
        matches,
        apply
    );
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 Builder::paintCombo(in BuilderItem item, in LayoutBox box){
    ControlVisualPainter painter;
    HitTargetFactory targets;
    if(item.combo >= this.m_scope.value().m_combos.size())
        return false;
    mut BuilderComboFrame frame = this.m_scope.value().m_combos[item.combo];
    if(!this.comboMatches(frame))
        return false;
    in InputRouter input = this.m_context.input();
    const b8 focused = input.focus() == item.state.id;
    const b8 hovered = input.hover() == item.state.id;
    const Rect clip = this.visibleClip(box.clip);
    if(!painter.paintComboFieldVisual(
        this.m_paint,
        this.m_text,
        this.m_skin.value(),
        frame.style,
        item.style,
        item.text,
        item.textBounds,
        item.padding,
        frame.arrowExtent,
        box.rectangle,
        clip,
        item.enabled,
        frame.open,
        focused,
        hovered
    ) || !this.comboMatches(frame))
        return false;
    const HitTarget target = targets.makeComboFieldHitTarget(box.rectangle, clip, item.enabled, item.contextMenu, frame.token, frame.focusOnCommit);
    if(!this.m_context.addTarget(item.state, target))
        return false;
    frame.state.value().m_bounds = box.rectangle;
    frame.visibleField = IntersectUiRectsBounds(box.rectangle, clip);
    return true;
}

b8 Builder::paintCombos(){
    for(mut auto frame : this.m_scope.value().m_combos){
        if(!this.comboMatches(frame) || frame.list >= this.m_scope.value().m_lists.size())
            return false;
        if(frame.open && frame.options.enabled && !this.paintComboPopup(frame))
            return false;
    }
    return true;
}

b8 Builder::paintComboPopup(mut BuilderComboFrame frame){
    HitTargetFactory targets;
    const auto background = this.region(frame.popupStyle.background, frame.popupStyle.fallback);
    if(!background.has_value() || !this.comboMatches(frame))
        return false;
    in Rect anchor = frame.state.value().bounds();
    if(!IsComboVisibleFieldNonEmpty(frame.visibleField)){
        this.m_context.discardPopupScope(frame.popupToken);
        CloseComboState(frame.state.value());
        frame.open = false;
        if(frame.search.has_value()){
            frame.search.value().m_editor.focused = false;
            frame.search.value().query().cancelComposition();
            this.snapshotComboQuery(frame);
        }
        frame.listToken.instanceGeneration = frame.state.value().m_list.inputGeneration();
        this.m_scope.value().m_lists[frame.list].token = frame.listToken;
        return true;
    }
    const PopupOptions options = BuildComboPopupOptions(anchor, frame.options.popupHeight);
    const auto placement = PlacePopup(options, this.m_paint.displayMetrics());
    if(!placement.has_value())
        return false;
    const Insets padding = MaxUiPadding(frame.popupStyle.padding, background.value().padding);
    const PopupScope scope = UiScopeDescriptorFactory().comboPopup(frame.popupToken, frame.parentToken, placement.value(), frame.state.value().m_owner, frame.state.value().m_ownerDeclaration);
    if(!this.m_context.updatePopupScope(frame.popupToken, scope) || !this.m_context.activatePopupScope(frame.popupToken))
        return false;
    if(!this.m_paint.beginOverlay(this.m_context.popupLayer())){
        const b8 ended = this.m_context.endPopupScope(false);
        if(!ended)
            this.m_context.fail();
        return false;
    }
    this.m_paint.pushClip(placement.value().viewport);
    const b8 backgroundPainted = this.m_paint.drawRegion(background.value().name, placement.value().bounds);
    const b8 clipPopped = this.m_paint.popClip();
    const HitTarget barrier = targets.makeBarrierHitTarget(placement.value().bounds, placement.value().viewport);
    b8 painted = backgroundPainted && clipPopped && this.m_context.addTarget(frame.popup, barrier);
    if(painted){
        auto listItem = this.makeItem();
        listItem.state = frame.rows;
        listItem.list = frame.list;
        LayoutBox box;
        box.rectangle = InsetUiRectBounds(placement.value().bounds, padding);
        box.clip = placement.value().bounds;
        painted = (!frame.search.has_value() || this.paintComboQuery(frame, box)) && this.paintList(listItem, box) && this.comboMatches(frame);
    }
    const b8 overlayEnded = this.m_paint.endOverlay();
    const b8 scopeEnded = this.m_context.endPopupScope(painted);
    if(painted)
        frame.state.value().m_popup.m_placement = placement.value();
    return painted && overlayEnded && scopeEnded;
}


