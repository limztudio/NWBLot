////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_GI_TRACE_COMMON_SLANGI
#define NWB_GRAPHICS_GI_TRACE_COMMON_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Backend-agnostic GI trace body shared by the SW-BVH walk (gi_sw_trace.slangi) and the HW inline-RayQuery (gi_hw_trace.slangi): the NwbGiTraceHit closest-hit result + the Lambert shade nwbGiShadeHit. The TRAVERSAL is the SEAM -- each backend defines nwbGiTraceClosest,
// and the shade re-enters it for the dominant-light occlusion ray, so the same shade runs on both paths. The including backend MUST provide global scene-shading/light-list heap-slot expressions plus NWB_GI_HIT_SHADOW_RAYS before this include.


#include "constants.h"
#include "../scene/buffer.slangi"
#include "../scene/lighting.slangi"
#include "../common/math.slangi"
#include "../shadow/instance_material.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Neutral albedo for an unconsumed miss result. A hit without an authored material surface gets the same fixed mid-grey only through the generated dispatch's explicit no-surface fallback, never by probing a named .bind field.
#ifndef NWB_GI_SW_TRACE_DEFAULT_ALBEDO
#define NWB_GI_SW_TRACE_DEFAULT_ALBEDO 0.5h, 0.5h, 0.5h
#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Closest-hit result: the world-space hit point, the geometric face normal (Lambert uses it), and the authored material-surface baseColor for the bounce.
struct NwbGiTraceHit{
    bool hit;
    float t;
    float3 worldPos;
    float3 normal;
    half3 albedo;
};

// The traversal SEAM: each backend (SW BVH walk / HW inline RayQuery) defines this to return the nearest hit. Declared here so the shared shade can re-enter it for the occlusion ray before the backend supplies the definition.
NwbGiTraceHit nwbGiTraceClosest(float3 origin, float3 direction, float tMin, float tMax);

// P8.2 boolean occlusion seam: same geometric-blocking acceptance as the legacy GI contract (ANY surface blocks, including transparent-classified geometry), but returns only whether a valid blocker exists. No normal/UV/material reconstruction: the SW walk returns on the first valid blocker, and the HW route uses first-accepted-hit behavior.
// Named for geometric blocking under the legacy GI contract, not opaque-material-only blocking.
bool nwbGiTraceOccluded(float3 origin, float3 direction, float tMin, float tMax);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Lambert hit shade: direct light (<=8 lights, unshadowed base + optional dominant-light shadow ray) * the authored material-surface base colour. The caller adds any surfel-to-surfel multi-bounce term. The occlusion ray re-enters the traversal seam (nwbGiTraceClosest), so it uses whichever backend the producer selected.
half3 nwbGiShadeHit(const NwbGiTraceHit hit, const float3 rayDir){
    half3 irradiance = half3(0.0h, 0.0h, 0.0h);

    const float3 normal = hit.normal;
    // Face-forward the normal against the ray (the ray could hit a back face -- use the face the ray sees).
    const float3 facingNormal = dot(normal, rayDir) < 0.0 ? normal : -normal;

    const uint lightCount = min(nwbSceneLightCount(), NWB_SCENE_MAX_LIGHTS);
    for(uint i = 0u; i < lightCount; ++i){
        const NwbSceneLight light = g_NwbSceneLights[i];
        float3 lightVector;
        half3 lightRadiance;
        nwbSceneResolveLight(light, hit.worldPos, lightVector, lightRadiance);
        if(all(lightRadiance <= half3(0.0h)))
            continue;
        const half ndotl = half(max(dot(facingNormal, lightVector), 0.0));
        irradiance += lightRadiance * ndotl;
    }

#if NWB_GI_HIT_SHADOW_RAYS
    // One occlusion ray toward the DOMINANT light (the highest-NdotL lit light): miss -> lit, hit -> shadowed.
    {
        float bestNdotl = 0.0;
        float3 dominantLightDir = float3(0.0, 1.0, 0.0);
        uint dominantLightIndex = NWB_GI_INVALID_LIGHT_INDEX;
        for(uint i = 0u; i < lightCount; ++i){
            const NwbSceneLight light = g_NwbSceneLights[i];
            float3 lv;
            half3 lr;
            nwbSceneResolveLight(light, hit.worldPos, lv, lr);
            if(all(lr <= half3(0.0h)))
                continue;
            const float ndotl = max(dot(facingNormal, lv), 0.0);
            if(ndotl > bestNdotl){
                bestNdotl = ndotl;
                dominantLightDir = lv;
                dominantLightIndex = i;
            }
        }
        if(dominantLightIndex != NWB_GI_INVALID_LIGHT_INDEX && bestNdotl > 0.0){
            // Boolean occlusion only: the shadow ray needs blocker existence, not reconstructed attributes.
            const bool occluded = nwbGiTraceOccluded(
                hit.worldPos + facingNormal * NWB_GI_TRACE_RAY_MIN_DISTANCE,
                dominantLightDir,
                NWB_GI_TRACE_RAY_MIN_DISTANCE,
                NWB_GI_TRACE_RAY_MAX_DISTANCE
            );
            if(occluded)
                irradiance *= 0.0h; // fully shadowed by the dominant-light occlusion ray
        }
    }
#endif

    // Apply the authored material-surface base colour (the bounce's diffuse reflectance).
    irradiance *= hit.albedo;
    return irradiance;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

