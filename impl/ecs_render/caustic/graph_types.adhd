    public CausticGraphTaskId causticAccumulatorBootstrapClearTask = CausticGraphTaskId();
    public CausticGraphTaskId causticAccumulatorDecayTask = CausticGraphTaskId();
    public CausticGraphTaskId photonDependencyTask = CausticGraphTaskId();
