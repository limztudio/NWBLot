[material_constant]
struct NwbFrostSurfaceMaterial{
    [default("half4(0.2h, 0.4h, 0.9h, 1.0h)")]
    half4 frost_albedo;
    [default("half(0.5h)")]
    half roughness_value;
};

[material_mutable]
struct NwbFrostRuntimeMaterial{
    [default("half3(1.0h, 1.0h, 1.0h)")]
    half3 sparkle_tint;
};

NwbFrostSurfaceMaterial frost;
NwbFrostRuntimeMaterial sparkle;


