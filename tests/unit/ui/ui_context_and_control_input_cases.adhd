const StringView s_UiContextActionKey = "action";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Rect MakeUiContextRect(in f32 x, in f32 y, in f32 width, in f32 height){
    Rect rect = Rect();
    rect.x = x;
    rect.y = y;
    rect.width = width;
    rect.height = height;
    return rect;
}

Point MakeUiContextPoint(in f32 x, in f32 y){
    Point point = Point();
    point.x = x;
    point.y = y;
    return point;
}

WidgetRoot MakeUiContextRoot(in u64 value, in u64 generation){
    WidgetRoot root = WidgetRoot();
    root.value = value;
    root.generation = generation;
    return root;
}

HitTarget MakeUiContextMenuTargetAt(in u64 id, in Rect rectangle){
    HitTarget target = HitTarget();
    target.id.value = id;
    target.declarationGeneration = 3u;
    target.rectangle = rectangle;
    target.clip = MakeUiContextRect(0.0f, 0.0f, 200.0f, 200.0f);
    target.focusable = true;
    target.activatable = true;
    target.control.instanceGeneration = 7u;
    target.control.contentGeneration = 8u;
    target.control.contentRevision = 9u;
    target.contextMenu = true;
    return target;
}

HitTarget MakeUiContextMenuTarget(in u64 id){
    return MakeUiContextMenuTargetAt(id, MakeUiContextRect(10.0f, 10.0f, 40.0f, 20.0f));
}

PopupScope MakeUiContextMenuScope(in u64 openGeneration){
    PopupScope scope = PopupScope();
    scope.token.widget.value = 100u;
    scope.token.declarationGeneration = 11u;
    scope.token.instanceGeneration = 12u;
    scope.token.openGeneration = openGeneration;
    scope.bounds = MakeUiContextRect(40.0f, 40.0f, 100.0f, 100.0f);
    scope.viewport = MakeUiContextRect(0.0f, 0.0f, 200.0f, 200.0f);
    scope.layer = 1u;
    return scope;
}

Array<HitTarget, 3u> MakeUiContextMenuPopupTargets(in PopupScope scope){
    HitTarget barrier = HitTarget();
    barrier.id = scope.token.widget;
    barrier.declarationGeneration = scope.token.declarationGeneration;
    barrier.rectangle = scope.bounds;
    barrier.clip = scope.viewport;
    barrier.popup = scope.token;
    barrier.layer = scope.layer;
    HitTarget child = MakeUiContextMenuTargetAt(101u, MakeUiContextRect(50.0f, 50.0f, 40.0f, 20.0f));
    child.clip = scope.bounds;
    child.paintOrder = 1u;
    child.popup = scope.token;
    child.layer = scope.layer;
    Array<HitTarget, 3u> targets = Array<HitTarget, 3u>();
    targets[0u] = MakeUiContextMenuTarget(1u);
    targets[1u] = barrier;
    targets[2u] = child;
    return targets;
}

HitTarget MakeUiContextButtonTargetAt(in Rect rectangle){
    HitTarget target = HitTarget();
    target.rectangle = rectangle;
    target.clip = MakeUiContextRect(0.0f, 0.0f, 200.0f, 100.0f);
    target.focusable = true;
    target.activatable = true;
    return target;
}

HitTarget MakeUiContextButtonTarget(){
    return MakeUiContextButtonTargetAt(MakeUiContextRect(10.0f, 20.0f, 30.0f, 20.0f));
}

Array<HitTarget, 1u> MakeUiContextSingleTarget(in HitTarget target){
    Array<HitTarget, 1u> targets = Array<HitTarget, 1u>();
    targets[0u] = target;
    return targets;
}

Array<PopupScope, 1u> MakeUiContextSingleScope(in PopupScope scope){
    Array<PopupScope, 1u> scopes = Array<PopupScope, 1u>();
    scopes[0u] = scope;
    return scopes;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyUiContextMenuInputTests_SecondaryReleaseTriggersOnceWithoutActivatingOrSelectingEditor(mut UiContextMenuInputTests self){
    HitTarget target = MakeUiContextMenuTarget(1u);
    target.textEditable = true;
    target.pointerGesture = true;
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiContextSingleTarget(target), 42u));
    self.focus();
    const InputRoutingResult down = self.send(MakeUiContextMenuPointer(InputEventType::SecondaryDown, MakeUiContextPoint(16.0f, 18.0f)));
    EXPECT_TRUE(down.pointerConsumed);
    EXPECT_TRUE(self.m_router.secondaryDown());
    EXPECT_FALSE(self.m_router.primaryDown());
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_EQ(self.m_router.focus(), target.id);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_FALSE(self.m_router.consumePointerGesture(target.id, target.declarationGeneration).has_value());
    EXPECT_FALSE(self.take().has_value());
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryUp)).pointerConsumed);
    const Expected<ContextMenuAction> actionResult = self.take();
    ASSERT_TRUE(actionResult.has_value());
    const ContextMenuAction action = actionResult.value();
    EXPECT_FLOAT_EQ(action.position.x, 16.0f);
    EXPECT_FLOAT_EQ(action.position.y, 18.0f);
    EXPECT_FALSE(self.take().has_value());
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
}

void VerifyUiContextMenuInputTests_SecondaryMenuOnAnotherParentAnchorPreservesAndRestoresPriorFocus(mut UiContextMenuInputTests self){
    const PopupScope parent = MakeUiContextMenuScope(1u);
    const Array<HitTarget, 3u> parentTargets = MakeUiContextMenuPopupTargets(parent);
    HitTarget anchor = MakeUiContextMenuTargetAt(102u, MakeUiContextRect(100.0f, 55.0f, 25.0f, 20.0f));
    anchor.popup = parent.token;
    anchor.layer = parent.layer;
    anchor.clip = parent.bounds;
    anchor.paintOrder = 2u;
    Array<HitTarget, 4u> closed = Array<HitTarget, 4u>();
    closed[0u] = parentTargets[0u];
    closed[1u] = parentTargets[1u];
    closed[2u] = parentTargets[2u];
    closed[3u] = anchor;
    ASSERT_TRUE(self.m_router.commitTargets(closed, 1u, MakeUiContextSingleScope(parent)));
    const WidgetId previousFocus = parentTargets[2u].id;
    ASSERT_EQ(self.m_router.focus(), previousFocus);
    ASSERT_NE(previousFocus, anchor.id);
    const Point position = MakeUiContextPoint(110.0f, 60.0f);
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryDown, position)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryUp, position)).pointerConsumed);
    EXPECT_EQ(self.m_router.focus(), previousFocus);
    const Expected<ContextMenuAction> actionResult = self.take(anchor.id.value, anchor.declarationGeneration);
    ASSERT_TRUE(actionResult.has_value());
    const ContextMenuAction action = actionResult.value();
    EXPECT_EQ(action.popup, parent.token);
    EXPECT_EQ(action.origin, InputActionSource::Pointer);
    EXPECT_TRUE(self.m_router.actions().empty());

    PopupScope menu = PopupScope();
    menu.token.widget.value = 200u;
    menu.token.declarationGeneration = 21u;
    menu.token.instanceGeneration = 31u;
    menu.token.openGeneration = 1u;
    menu.parent = parent.token;
    menu.bounds = MakeUiContextRect(145.0f, 110.0f, 50.0f, 60.0f);
    menu.viewport = parent.viewport;
    menu.layer = 2u;
    HitTarget barrier = HitTarget();
    barrier.id = menu.token.widget;
    barrier.declarationGeneration = menu.token.declarationGeneration;
    barrier.rectangle = menu.bounds;
    barrier.clip = menu.viewport;
    barrier.popup = menu.token;
    barrier.layer = menu.layer;
    barrier.paintOrder = 3u;
    HitTarget command = MakeUiContextMenuTargetAt(201u, MakeUiContextRect(150.0f, 115.0f, 40.0f, 20.0f));
    command.popup = menu.token;
    command.layer = menu.layer;
    command.clip = menu.bounds;
    command.paintOrder = 4u;
    Array<HitTarget, 6u> opened = Array<HitTarget, 6u>();
    opened[0u] = closed[0u];
    opened[1u] = closed[1u];
    opened[2u] = closed[2u];
    opened[3u] = closed[3u];
    opened[4u] = barrier;
    opened[5u] = command;
    Array<PopupScope, 2u> scopes = Array<PopupScope, 2u>();
    scopes[0u] = parent;
    scopes[1u] = menu;
    ASSERT_TRUE(self.m_router.commitTargets(opened, 2u, scopes));
    EXPECT_EQ(self.m_router.focus(), command.id);
    EXPECT_TRUE(self.send(MakeUiContextMenuKey(CoreKey::Escape)).commandConsumed);
    EXPECT_TRUE(self.release(CoreKey::Escape).commandConsumed);
    const Expected<PopupDismissReasonEnum> reasonResult = self.m_router.consumePopupDismissal(menu.token);
    ASSERT_TRUE(reasonResult.has_value());
    EXPECT_EQ(reasonResult.value(), PopupDismissReason::Cancel);
    EXPECT_FALSE(self.m_router.consumePopupDismissal(parent.token).has_value());
    ASSERT_TRUE(self.m_router.commitTargets(closed, 3u, MakeUiContextSingleScope(parent)));
    EXPECT_EQ(self.m_router.focus(), previousFocus);
    EXPECT_NE(self.m_router.focus(), anchor.id);
    EXPECT_FALSE(self.m_router.consumeActivation(anchor.id));
}

void VerifyUiContextMenuInputTests_HeldSecondaryConsumesMovementLeaveAndReleaseOutsideTheTarget(mut UiContextMenuInputTests self){
    const HitTarget target = MakeUiContextMenuTarget(1u);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiContextSingleTarget(target), 1u));
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryDown)).pointerConsumed);
    EXPECT_TRUE(self.m_router.pointerKnown());
    EXPECT_FLOAT_EQ(self.m_router.pointerPosition().x, 15.0f);
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::PointerLeave)).pointerConsumed);
    EXPECT_FALSE(self.m_router.pointerKnown());
    EXPECT_TRUE(self.m_router.secondaryDown());
    EXPECT_TRUE(self.m_router.wantsPointer());
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::PointerMove, MakeUiContextPoint(180.0f, 180.0f))).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryUp, MakeUiContextPoint(180.0f, 180.0f))).pointerConsumed);
    EXPECT_FALSE(self.m_router.secondaryDown());
    EXPECT_FALSE(self.m_router.wantsPointer());
    EXPECT_FALSE(self.take().has_value());
}

void VerifyUiContextMenuInputTests_DuplicateSecondaryDownCannotTriggerAnotherTargetDuringTheSamePress(mut UiContextMenuInputTests self){
    Array<HitTarget, 2u> targets = Array<HitTarget, 2u>();
    targets[0u] = MakeUiContextMenuTarget(1u);
    targets[1u] = MakeUiContextMenuTargetAt(2u, MakeUiContextRect(70.0f, 10.0f, 40.0f, 20.0f));
    ASSERT_TRUE(self.m_router.commitTargets(targets, 1u));
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryDown)).pointerConsumed);
    EXPECT_FALSE(self.take().has_value());
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryDown, MakeUiContextPoint(75.0f, 15.0f))).pointerConsumed);
    EXPECT_FALSE(self.take().has_value());
    EXPECT_FALSE(self.take(2u).has_value());
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryUp, MakeUiContextPoint(75.0f, 15.0f))).pointerConsumed);
    EXPECT_FALSE(self.take().has_value());
    EXPECT_FALSE(self.take(2u).has_value());
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryDown, MakeUiContextPoint(75.0f, 15.0f))).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryUp, MakeUiContextPoint(75.0f, 15.0f))).pointerConsumed);
    const Expected<ContextMenuAction> actionResult2 = self.take(2u);
    ASSERT_TRUE(actionResult2.has_value());
    EXPECT_EQ(actionResult2.value().id.target, targets[1u].id);
}

void VerifyUiContextMenuInputTests_OrdinaryAcceptedSurfaceConsumesSecondaryWithoutAContextTrigger(mut UiContextMenuInputTests self){
    HitTarget target = MakeUiContextMenuTarget(1u);
    target.contextMenu = false;
    target.pointerGesture = true;
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiContextSingleTarget(target), 1u));
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryDown)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryUp)).pointerConsumed);
    EXPECT_FALSE(self.take().has_value());
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
    EXPECT_FALSE(self.m_router.consumePointerGesture(target.id, target.declarationGeneration).has_value());
}

void VerifyUiContextMenuInputTests_MenuAndShiftF10UseTheAcceptedKeyboardAnchorOncePerRelease(mut UiContextMenuInputTests self){
    const HitTarget target = MakeUiContextMenuTarget(1u);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiContextSingleTarget(target), 5u));
    self.focus();
    EXPECT_FALSE(self.m_router.pointerKnown());
    Array<CoreKeyEnum, 2u> keys = Array<CoreKeyEnum, 2u>();
    keys[0u] = CoreKey::Menu;
    keys[1u] = CoreKey::F10;
    for(in CoreKeyEnum key : keys){
        const b8 shift = key == CoreKey::F10;
        EXPECT_TRUE(self.send(MakeUiContextMenuKey(key, shift)).commandConsumed);
        EXPECT_TRUE(self.m_router.ownsKey(key));
        EXPECT_FALSE(self.take().has_value());
        EXPECT_TRUE(self.send(MakeUiContextMenuKey(key, shift, false, false, true)).commandConsumed);
        EXPECT_TRUE(self.send(MakeUiContextMenuKey(key, shift)).commandConsumed);
        EXPECT_FALSE(self.take().has_value());
        EXPECT_TRUE(self.release(key).commandConsumed);
        const Expected<ContextMenuAction> actionResult = self.take();
        ASSERT_TRUE(actionResult.has_value());
        const ContextMenuAction action = actionResult.value();
        EXPECT_EQ(action.origin, InputActionSource::Command);
        EXPECT_FLOAT_EQ(action.position.x, target.rectangle.x);
        EXPECT_FLOAT_EQ(action.position.y, target.rectangle.y + target.rectangle.height);
        EXPECT_EQ(action.control, target.control);
        EXPECT_EQ(action.id.layoutGeneration, 5u);
        EXPECT_FALSE(self.take().has_value());
        EXPECT_FALSE(self.m_router.ownsKey(key));
    }
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_TRUE(self.m_router.controlActions().empty());
}

void VerifyUiContextMenuInputTests_OtherF10ModifierCombinationsStayWithTheNormalFocusedOwner(mut UiContextMenuInputTests self){
    const HitTarget target = MakeUiContextMenuTarget(1u);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiContextSingleTarget(target), 1u));
    self.focus();
    Array<InputEvent, 5u> events = Array<InputEvent, 5u>();
    events[0u] = MakeUiContextMenuKey(CoreKey::F10);
    events[1u] = MakeUiContextMenuKey(CoreKey::F10, false, true);
    events[2u] = MakeUiContextMenuKey(CoreKey::F10, false, false, true);
    events[3u] = MakeUiContextMenuKey(CoreKey::F10, true, true);
    events[4u] = MakeUiContextMenuKey(CoreKey::F10, true, false, true);
    for(in InputEvent event : events){
        EXPECT_TRUE(self.send(event).commandConsumed);
        EXPECT_FALSE(self.take().has_value());
        EXPECT_TRUE(self.release(CoreKey::F10).commandConsumed);
    }
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_TRUE(self.m_router.controlActions().empty());
}

void VerifyUiContextMenuInputTests_UnfocusedOrUnboundContextKeysDoNotCreateTriggers(mut UiContextMenuInputTests self){
    HitTarget target = MakeUiContextMenuTarget(1u);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiContextSingleTarget(target), 1u));
    EXPECT_FALSE(self.send(MakeUiContextMenuKey(CoreKey::Menu)).commandConsumed);
    EXPECT_FALSE(self.release(CoreKey::Menu).commandConsumed);
    EXPECT_FALSE(self.send(MakeUiContextMenuKey(CoreKey::F10, true)).commandConsumed);
    EXPECT_FALSE(self.release(CoreKey::F10).commandConsumed);
    target.contextMenu = false;
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiContextSingleTarget(target), 2u));
    self.focus();
    EXPECT_TRUE(self.send(MakeUiContextMenuKey(CoreKey::Menu)).commandConsumed);
    EXPECT_TRUE(self.release(CoreKey::Menu).commandConsumed);
    EXPECT_FALSE(self.take().has_value());
}

void VerifyUiContextMenuInputTests_RepeatWithoutAnInitialPressCannotOpenAMenu(mut UiContextMenuInputTests self){
    const HitTarget target = MakeUiContextMenuTarget(1u);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiContextSingleTarget(target), 1u));
    self.focus();
    EXPECT_FALSE(self.send(MakeUiContextMenuKey(CoreKey::Menu, false, false, false, true)).commandConsumed);
    EXPECT_FALSE(self.release(CoreKey::Menu).commandConsumed);
    EXPECT_FALSE(self.send(MakeUiContextMenuKey(CoreKey::F10, true, false, false, true)).commandConsumed);
    EXPECT_FALSE(self.release(CoreKey::F10).commandConsumed);
    EXPECT_FALSE(self.take().has_value());
}

void VerifyUiContextMenuInputTests_SceneOwnedContextKeysCannotTransferToAnEditorThatReceivesFocusDuringTheHold(mut UiContextMenuInputTests self){
    HitTarget target = MakeUiContextMenuTarget(1u);
    target.textEditable = true;
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiContextSingleTarget(target), 1u));
    EXPECT_FALSE(self.send(MakeUiContextMenuKey(CoreKey::Menu)).commandConsumed);
    target.focusOnCommit = true;
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiContextSingleTarget(target), 2u));
    EXPECT_FALSE(self.send(MakeUiContextMenuKey(CoreKey::Menu, false, false, false, true)).commandConsumed);
    EXPECT_FALSE(self.release(CoreKey::Menu).commandConsumed);
    EXPECT_FALSE(self.take().has_value());
    EXPECT_TRUE(self.send(MakeUiContextMenuKey(CoreKey::Menu)).commandConsumed);
    EXPECT_TRUE(self.release(CoreKey::Menu).commandConsumed);
    ASSERT_TRUE(self.take().has_value());
    self.m_router.clearFocus();
    EXPECT_FALSE(self.send(MakeUiContextMenuKey(CoreKey::F10)).commandConsumed);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiContextSingleTarget(target), 3u));
    EXPECT_FALSE(self.send(MakeUiContextMenuKey(CoreKey::F10, true, false, false, true)).commandConsumed);
    EXPECT_FALSE(self.release(CoreKey::F10).commandConsumed);
    EXPECT_FALSE(self.take().has_value());
    EXPECT_TRUE(self.send(MakeUiContextMenuKey(CoreKey::F10, true)).commandConsumed);
    EXPECT_TRUE(self.release(CoreKey::F10).commandConsumed);
    ASSERT_TRUE(self.take().has_value());
}

void VerifyUiContextMenuInputTests_OnlyTheTopAcceptedHitMaySupplyAContextMenu(mut UiContextMenuInputTests self){
