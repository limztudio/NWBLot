#include <utilities/tex_conv/output.adhd>
#include <utilities/tex_conv/texture_encoder.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
b8 ValidateOutputPaths(in TexConvOutputPaths outputPaths, in b8 force){
    StagedFilePairPaths paths(outputPaths.data, outputPaths.metadata);
    const auto validation = ValidateStagedFilePairPaths(paths, force, false);
    if(!validation.succeeded()){
        ReportStagedFilePairValidationFailure("tex_conv", paths, validation, "--force", "both output files");
        return false;
    }
    return true;
}

Expected<String> BuildMetadata(in PreparedTexture payload){
    const auto mipCount = ComputeCompleteMipCount(payload.dimension, payload.width, payload.height, payload.depth);
    if(!IsCompleteTexConvMipCount(mipCount.has_value(), mipCount.value_or(0u), payload.mipCount)
        || !IsValidTextureDescriptor(payload.format, payload.dimension, payload.width, payload.height, payload.depth, payload.alphaMode, payload.alphaConstantUnorm8))
        return MakeUnexpected(Failure());

    const StringView format = PayloadFormatText(payload.format);
    const StringView dimension = DimensionText(payload.dimension);
    const StringView alphaMode = AlphaModeText(payload.alphaMode);
    if(!IsValidTexConvDescriptorText(format, dimension, alphaMode))
        return MakeUnexpected(Failure());
    return BuildTexConvMetadataText(
        format, dimension, payload.width, payload.height, payload.depth,
        payload.dimension == TexturePayloadDimension::Texture3D, alphaMode,
        payload.alphaMode == TextureAlphaMode::ConstantUnorm8, payload.alphaConstantUnorm8
    );
}

[cpp_unwind]
b8 WriteOutputs(in TexConvOutputPaths outputPaths, in PreparedTexture payload, in b8 force){
    if(payload.bytes.empty()){
        error("tex_conv: cannot write an empty prepared texture.");
        return false;
    }
    const auto metadata = BuildMetadata(payload);
    if(!metadata.has_value()){
        error("tex_conv: cannot describe an invalid prepared texture.");
        return false;
    }
    StagedFilePairPaths paths(outputPaths.data, outputPaths.metadata);
    const auto published = StageAndPublishFilePair(paths, payload.bytes, metadata.value(), force, false, false, s_PublicationDiagnosticTag);
    ReportStagedFilePairEntries("tex_conv", paths, published);
    if(!published.succeeded()){
        ReportStagedFilePairPublishFailure("tex_conv", paths, published, "output data file", "output metadata file", "--force", "both output files");
        return false;
    }
    return true;
}


