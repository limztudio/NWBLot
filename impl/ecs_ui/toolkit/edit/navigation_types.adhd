#include <impl/ecs_ui/toolkit/input/commands.adhd>
#include <impl/ecs_ui/toolkit/text/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const usize s_EditUtf8MaxSequenceBytes = 4u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> EditTextMode{
    SingleLine,
    Multiline,
}

enum<u8> EditMove{
    Left,
    Right,
    Home,
    End,
    WordLeft,
    WordRight,
    DocumentHome,
    DocumentEnd,
}

enum<u8> EditNavigationDirection{
    Up,
    Down,
    PageUp,
    PageDown,
}

enum<u8> EditNavigationRunClass{
    Whitespace,
    Punctuation,
    Text,
    LineBreak,
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class EditWordRange{
    public usize begin = 0u;
    public usize end = 0u;
}

class EditNavigationSnapshot{
    public EditNavigationSnapshot(){
        this.instanceGeneration = 0u;
        this.generation = 0u;
        this.preferredX = 0.0f;
        this.valid = false;
    }

    public EditNavigationSnapshot(in u64 inInstanceGeneration, in u64 inGeneration, in f32 inPreferredX, in b8 inValid){
        this.instanceGeneration = inInstanceGeneration;
        this.generation = inGeneration;
        this.preferredX = inPreferredX;
        this.valid = inValid;
    }

    public b8 operator==(in EditNavigationSnapshot rhs)const{
        return this.instanceGeneration == rhs.instanceGeneration && this.generation == rhs.generation && this.preferredX == rhs.preferredX && this.valid == rhs.valid;
    }

    public b8 operator!=(in EditNavigationSnapshot rhs)const{
        return this.instanceGeneration != rhs.instanceGeneration || this.generation != rhs.generation || this.preferredX != rhs.preferredX || this.valid != rhs.valid;
    }

    public u64 instanceGeneration;
    public u64 generation;
    public f32 preferredX;
    public b8 valid;
}

class EditNavigationResult{
    public usize committedByte = 0u;
    public f32 preferredX = 0.0f;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<EditNavigationDirection> TryTranslateEditNavigation(in InputCommandIntent intent){
    if(!intent.edit)
        return MakeUnexpected(Failure());
    switch(intent.command){
    case InputCommand::Up: return EditNavigationDirection::Up;
    case InputCommand::Down: return EditNavigationDirection::Down;
    case InputCommand::PageUp: return EditNavigationDirection::PageUp;
    case InputCommand::PageDown: return EditNavigationDirection::PageDown;
    default: return MakeUnexpected(Failure());
    }
}

EditNavigationRunClass ClassifyEditNavigationScalar(in u32 scalar){
    if(IsUnicodeWhitespace(scalar))
        return EditNavigationRunClass::Whitespace;
    if(IsAsciiPunctuation(scalar))
        return EditNavigationRunClass::Punctuation;
    return EditNavigationRunClass::Text;
}

b8 IsEditBoundary(in Span<usize> boundaries, in usize position){
    const usize index = LowerBoundIndex(boundaries, position);
    return index < boundaries.size() && boundaries[index] == position;
}

usize PreviousEditBoundary(in Span<usize> boundaries, in usize position){
    const usize index = LowerBoundIndex(boundaries, position);
    if(index == 0u)
        return 0u;
    return boundaries[index - 1u];
}

usize NextEditBoundary(in Span<usize> boundaries, in usize textSize, in usize position){
    usize index = LowerBoundIndex(boundaries, position);
    if(index < boundaries.size() && boundaries[index] == position)
        ++index;
    if(index >= boundaries.size())
        return textSize;
    return boundaries[index];
}

EditWordRange ResolveEditBackspaceRange(in Span<usize> boundaries, in usize anchor, in usize caret){
    EditWordRange range;
    if(anchor != caret){
        range.begin = Min(anchor, caret);
        range.end = Max(anchor, caret);
    }
    else{
        range.begin = PreviousEditBoundary(boundaries, caret);
        range.end = caret;
    }
    return range;
}

EditWordRange ResolveEditEraseForwardRange(in Span<usize> boundaries, in usize textSize, in usize anchor, in usize caret){
    EditWordRange range;
    if(anchor != caret){
        range.begin = Min(anchor, caret);
        range.end = Max(anchor, caret);
    }
    else{
        range.begin = caret;
        range.end = NextEditBoundary(boundaries, textSize, caret);
    }
    return range;
}


