void VerifyUiComboBehaviorTests_FirstBindingPreservesAnExplicitlyOpenStateAndSameBindingIsStable(){
    ComboState state = ComboState();
    state.select(4u);
    state.open();
    const u64 inputGeneration = state.inputGeneration();
    const u64 previewGeneration = state.listState().inputGeneration();
    ASSERT_TRUE(UiComboBehaviorBind(state, MakeUiBuilderWidgetId(201u), 17u));
    EXPECT_TRUE(state.isOpen());
    EXPECT_EQ(state.selectedKey(), 4u);
    EXPECT_EQ(state.inputGeneration(), inputGeneration);
    EXPECT_EQ(state.listState().inputGeneration(), previewGeneration);
    ASSERT_TRUE(UiComboBehaviorBind(state, MakeUiBuilderWidgetId(201u), 17u));
    EXPECT_TRUE(state.isOpen());
    EXPECT_EQ(state.listState().inputGeneration(), previewGeneration);
}

void VerifyUiComboBehaviorTests_ARecreatedDeclarationCancelsPreviewAndPreservesTheCommittedSelection(){
    UiComboBehaviorSource source = UiComboBehaviorSource();
    ComboState state = ComboState();
    state.select(4u);
    ASSERT_TRUE(UiComboBehaviorBind(state, MakeUiBuilderWidgetId(201u), 17u));
    ASSERT_TRUE(UiComboBehaviorReconcile(state, source));
    UiComboBehaviorOpen(state);
    ASSERT_TRUE(UiComboBehaviorNavigate(source, ControlActionKind::Down, state));
    const u64 inputGeneration = state.inputGeneration();
    const u64 previewGeneration = state.listState().inputGeneration();
    ASSERT_TRUE(UiComboBehaviorBind(state, MakeUiBuilderWidgetId(201u), 18u));
    EXPECT_FALSE(state.isOpen());
    EXPECT_EQ(state.selectedKey(), 4u);
    EXPECT_EQ(state.listState().cursorKey(), 4u);
    EXPECT_NE(state.listState().inputGeneration(), previewGeneration);
    EXPECT_EQ(state.inputGeneration(), inputGeneration);
}

void VerifyUiComboBehaviorTests_MovingStateToAnotherOwnerClosesAndEachOwnerSwitchRetiresThePreviewLifetime(){
    ComboState state = ComboState();
    state.select(4u);
    ASSERT_TRUE(UiComboBehaviorBind(state, MakeUiBuilderWidgetId(201u), 17u));
    state.open();
    const u64 previewGeneration = state.listState().inputGeneration();
    ASSERT_TRUE(UiComboBehaviorBind(state, MakeUiBuilderWidgetId(202u), 17u));
    EXPECT_FALSE(state.isOpen());
    EXPECT_EQ(state.selectedKey(), 4u);
    EXPECT_NE(state.listState().inputGeneration(), previewGeneration);
    state.open();
    const u64 returnedPreview = state.listState().inputGeneration();
    ASSERT_TRUE(UiComboBehaviorBind(state, MakeUiBuilderWidgetId(201u), 17u));
    EXPECT_FALSE(state.isOpen());
    EXPECT_EQ(state.selectedKey(), 4u);
    EXPECT_NE(state.listState().inputGeneration(), returnedPreview);
}

void VerifyUiComboBehaviorTests_InvalidBindingFailsAtomicallyAndDoesNotReplaceTheExistingOwner(){
    ComboState state = ComboState();
    state.select(4u);
    ASSERT_TRUE(UiComboBehaviorBind(state, MakeUiBuilderWidgetId(201u), 17u));
    state.open();
    const u64 previewGeneration = state.listState().inputGeneration();
    EXPECT_FALSE(UiComboBehaviorBind(state, WidgetId(), 18u));
    EXPECT_FALSE(UiComboBehaviorBind(state, MakeUiBuilderWidgetId(202u), 0u));
    ASSERT_TRUE(UiComboBehaviorBind(state, MakeUiBuilderWidgetId(201u), 17u));
    EXPECT_TRUE(state.isOpen());
    EXPECT_EQ(state.selectedKey(), 4u);
    EXPECT_EQ(state.listState().inputGeneration(), previewGeneration);
}

void VerifyUiComboBehaviorTests_MissingAndDisabledInitialSelectionClearWithoutChoosingAnotherRow(){
