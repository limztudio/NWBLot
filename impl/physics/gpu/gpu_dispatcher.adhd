class PhysicsCollisionTask{
    public mut GpuDescriptorHeap heap;
    public PhysicsGpuBufferGroup buffers;
    public ComputePipelineHandle broadphasePipeline;
    public ComputePipelineHandle narrowphasePrimPipeline;
    public ComputePipelineHandle narrowphaseComplexPipeline;
    public Span<GpuPhysicsBodySim> bodySims;
    public Span<GpuPhysicsShapeProxy> shapes;
    public Span<f32x4> hullVertices;
    public Span<f32x4> meshNodes;
    public Span<f32x4> meshTris;
    public u32 shapeCount;
    public u32 maxPairs;
    public f32 invCellSize;
    public b8 uploadStaticGeom;
    public b8 hasComplexShapes;

    public PhysicsCollisionTask(
        mut GpuDescriptorHeap descriptorHeap,
        in PhysicsGpuBufferGroup bufGroup,
        in ComputePipelineHandle bpPipe,
        in ComputePipelineHandle npPrimPipe,
        in ComputePipelineHandle npComplexPipe,
        in Span<GpuPhysicsBodySim> sims,
        in Span<GpuPhysicsShapeProxy> shapeProxies,
        in Span<f32x4> vertices,
        in Span<f32x4> nodes,
        in Span<f32x4> tris,
        in u32 numShapes,
        in u32 pairLimit,
        in f32 invCell,
        in b8 uploadStatic,
        in b8 hasComplex
    ){
        this.heap = descriptorHeap;
        this.buffers = bufGroup;
        this.broadphasePipeline = bpPipe;
        this.narrowphasePrimPipeline = npPrimPipe;
        this.narrowphaseComplexPipeline = npComplexPipe;
        this.bodySims = sims;
        this.shapes = shapeProxies;
        this.hullVertices = vertices;
        this.meshNodes = nodes;
        this.meshTris = tris;
        this.shapeCount = numShapes;
        this.maxPairs = pairLimit;
        this.invCellSize = invCell;
        this.uploadStaticGeom = uploadStatic;
        this.hasComplexShapes = hasComplex;
    }

    public GpuTaskCommandRequirements commandRequirements()const{
        return GpuTaskCommandRequirements(GpuQueueCapability::Compute | GpuQueueCapability::Transfer);
    }

    [cpp_unwind]
    public b8 record(mut CommandList commands, in GpuTaskRecordContext context)const{
        if(this.shapeCount == 0u || this.maxPairs == 0u || !this.broadphasePipeline.valid() || !this.narrowphasePrimPipeline.valid())
            return false;
        if(this.hasComplexShapes && !this.narrowphaseComplexPipeline.valid())
            return false;

        const b8 useSpatialHash = (this.shapeCount > 64u);
        const b8 uploadHulls = this.uploadStaticGeom && !this.hullVertices.empty();
        const b8 uploadNodes = this.uploadStaticGeom && !this.meshNodes.empty();
        const b8 uploadTris = this.uploadStaticGeom && !this.meshTris.empty();

        commands.setEnableUavBarriersForBuffer(this.buffers.bodySimBuffer.deref(), false);
        commands.setEnableUavBarriersForBuffer(this.buffers.shapeBuffer.deref(), true);
        commands.setEnableUavBarriersForBuffer(this.buffers.pairBuffer.deref(), true);
        commands.setEnableUavBarriersForBuffer(this.buffers.counterBuffer.deref(), true);
        commands.setEnableUavBarriersForBuffer(this.buffers.indirectArgsBuffer.deref(), true);
        commands.setEnableUavBarriersForBuffer(this.buffers.hullVertexBuffer.deref(), false);
        commands.setEnableUavBarriersForBuffer(this.buffers.meshNodeBuffer.deref(), false);
        commands.setEnableUavBarriersForBuffer(this.buffers.meshTriBuffer.deref(), false);
        commands.setEnableUavBarriersForBuffer(this.buffers.manifoldBuffer.deref(), this.hasComplexShapes);
        if(useSpatialHash){
            commands.setEnableUavBarriersForBuffer(this.buffers.gridBuffer.deref(), true);
            commands.setEnableUavBarriersForBuffer(this.buffers.largeListBuffer.deref(), true);
        }

        if(!this.bodySims.empty())
            commands.setBufferState(this.buffers.bodySimBuffer.deref(), ResourceStates::CopyDest);
        if(!this.shapes.empty())
            commands.setBufferState(this.buffers.shapeBuffer.deref(), ResourceStates::CopyDest);
        commands.setBufferState(this.buffers.counterBuffer.deref(), ResourceStates::CopyDest);
        if(uploadHulls)
            commands.setBufferState(this.buffers.hullVertexBuffer.deref(), ResourceStates::CopyDest);
        if(uploadNodes)
            commands.setBufferState(this.buffers.meshNodeBuffer.deref(), ResourceStates::CopyDest);
        if(uploadTris)
            commands.setBufferState(this.buffers.meshTriBuffer.deref(), ResourceStates::CopyDest);
        commands.commitBarriers();

        if(!this.bodySims.empty()){
            if(!commands.tryWriteBuffer(this.buffers.bodySimBuffer.deref(), this.bodySims, 0u))
                return false;
        }
        if(!this.shapes.empty()){
            if(!commands.tryWriteBuffer(this.buffers.shapeBuffer.deref(), this.shapes, 0u))
                return false;
        }
        commands.clearBufferUInt(this.buffers.counterBuffer.deref(), 0u);
        if(uploadHulls){
            if(!commands.tryWriteBuffer(this.buffers.hullVertexBuffer.deref(), this.hullVertices, 0u))
                return false;
        }
        if(uploadNodes){
            if(!commands.tryWriteBuffer(this.buffers.meshNodeBuffer.deref(), this.meshNodes, 0u))
                return false;
        }
        if(uploadTris){
            if(!commands.tryWriteBuffer(this.buffers.meshTriBuffer.deref(), this.meshTris, 0u))
                return false;
        }

        commands.setBufferState(this.buffers.bodySimBuffer.deref(), ResourceStates::UnorderedAccess);
        commands.setBufferState(this.buffers.shapeBuffer.deref(), ResourceStates::UnorderedAccess);
        commands.setBufferState(this.buffers.pairBuffer.deref(), ResourceStates::UnorderedAccess);
        commands.setBufferState(this.buffers.counterBuffer.deref(), ResourceStates::UnorderedAccess);
        commands.setBufferState(this.buffers.indirectArgsBuffer.deref(), ResourceStates::UnorderedAccess);
        commands.setBufferState(this.buffers.hullVertexBuffer.deref(), ResourceStates::UnorderedAccess);
        commands.setBufferState(this.buffers.meshNodeBuffer.deref(), ResourceStates::UnorderedAccess);
        commands.setBufferState(this.buffers.meshTriBuffer.deref(), ResourceStates::UnorderedAccess);
        commands.setBufferState(this.buffers.manifoldBuffer.deref(), ResourceStates::UnorderedAccess);
        if(useSpatialHash){
            commands.setBufferState(this.buffers.gridBuffer.deref(), ResourceStates::UnorderedAccess);
            commands.setBufferState(this.buffers.largeListBuffer.deref(), ResourceStates::UnorderedAccess);
        }
        commands.commitBarriers();

        ComputeState bpState;
        bpState.setPipeline(this.broadphasePipeline.deref());
        commands.setComputeState(bpState);
        this.heap.bindCompute(commands, this.broadphasePipeline.deref());

        const u32 groups = ComputeDispatchGroups(this.shapeCount);

        GpuPhysicsPushConstants pushAabb;
        pushAabb.itemCount = this.shapeCount;
        pushAabb.modeOrSecondaryCount = s_GpuBroadphaseModeUpdateAabbs;
        pushAabb.slots0 = this.buffers.slots0;
        pushAabb.slots1 = this.buffers.slots1;
        commands.setPushConstants(pushAabb);
        commands.dispatch(groups, 1u, 1u);

        if(useSpatialHash){
            GpuPhysicsPushConstants pushClear;
            pushClear.itemCount = s_GpuGridTableSize;
            pushClear.modeOrSecondaryCount = s_GpuBroadphaseModeGridClear;
            pushClear.slots0 = this.buffers.slots0;
            pushClear.slots1 = this.buffers.slots1;
            commands.setPushConstants(pushClear);
            commands.dispatch(ComputeDispatchGroups(s_GpuGridTableSize), 1u, 1u);

            commands.setBufferState(this.buffers.shapeBuffer.deref(), ResourceStates::UnorderedAccess);
            commands.setBufferState(this.buffers.gridBuffer.deref(), ResourceStates::UnorderedAccess);
            commands.setBufferState(this.buffers.largeListBuffer.deref(), ResourceStates::UnorderedAccess);
            commands.commitBarriers();

            GpuPhysicsPushConstants pushInsert;
            pushInsert.itemCount = this.shapeCount;
            pushInsert.modeOrSecondaryCount = s_GpuBroadphaseModeGridInsert;
            pushInsert.deltaTime = this.invCellSize;
            pushInsert.slots0 = this.buffers.slots0;
            pushInsert.slots1 = this.buffers.slots1;
            commands.setPushConstants(pushInsert);
            commands.dispatch(groups, 1u, 1u);

            commands.setBufferState(this.buffers.gridBuffer.deref(), ResourceStates::UnorderedAccess);
            commands.setBufferState(this.buffers.largeListBuffer.deref(), ResourceStates::UnorderedAccess);
            commands.setBufferState(this.buffers.shapeBuffer.deref(), ResourceStates::UnorderedAccess);
            commands.commitBarriers();

            GpuPhysicsPushConstants pushGridPairs;
            pushGridPairs.itemCount = this.shapeCount;
            pushGridPairs.modeOrSecondaryCount = s_GpuBroadphaseModeGridEmitPairs;
            pushGridPairs.flags = this.maxPairs;
            pushGridPairs.deltaTime = this.invCellSize;
            pushGridPairs.slots0 = this.buffers.slots0;
            pushGridPairs.slots1 = this.buffers.slots1;
            commands.setPushConstants(pushGridPairs);
            commands.dispatch(groups, 1u, 1u);
        }
        else{
            commands.setBufferState(this.buffers.shapeBuffer.deref(), ResourceStates::UnorderedAccess);
            commands.commitBarriers();

            GpuPhysicsPushConstants pushPairs;
            pushPairs.itemCount = this.shapeCount;
            pushPairs.modeOrSecondaryCount = s_GpuBroadphaseModeEmitPairs;
            pushPairs.flags = this.maxPairs;
            pushPairs.slots0 = this.buffers.slots0;
            pushPairs.slots1 = this.buffers.slots1;
            commands.setPushConstants(pushPairs);
            commands.dispatch(groups, 1u, 1u);
        }

        commands.setBufferState(this.buffers.counterBuffer.deref(), ResourceStates::UnorderedAccess);
        commands.commitBarriers();

        GpuPhysicsPushConstants pushInd;
        pushInd.itemCount = this.shapeCount;
        pushInd.modeOrSecondaryCount = s_GpuBroadphaseModeFinalizeIndirect;
        pushInd.flags = this.maxPairs;
        pushInd.slots0 = this.buffers.slots0;
        pushInd.slots1 = u32x4(this.buffers.slots1.x, this.buffers.slots1.y, this.buffers.slots2.x, s_GpuInvalidIndex);
        commands.setPushConstants(pushInd);
        commands.dispatch(1u, 1u, 1u);

        commands.setBufferState(this.buffers.indirectArgsBuffer.deref(), ResourceStates::IndirectArgument);
        commands.setBufferState(this.buffers.pairBuffer.deref(), ResourceStates::UnorderedAccess);
        commands.setBufferState(this.buffers.counterBuffer.deref(), ResourceStates::UnorderedAccess);
        commands.commitBarriers();

        ComputeState npState;
        npState.setPipeline(this.narrowphasePrimPipeline.deref()).setIndirectParams(this.buffers.indirectArgsBuffer.deref());
        commands.setComputeState(npState);

        GpuPhysicsPushConstants pushNp;
        pushNp.itemCount = this.maxPairs;
        pushNp.modeOrSecondaryCount = s_GpuNarrowphaseModeContacts;
        pushNp.gravitySpeculative = f32x4(0.0f, 0.0f, 0.0f, s_SpeculativeDistance);
        pushNp.slots0 = this.buffers.slots0;
        pushNp.slots1 = u32x4(this.buffers.slots1.x, this.buffers.slots2.y, this.buffers.slots2.z, this.buffers.slots1.y);
        commands.setPushConstants(pushNp);
        commands.dispatchIndirect(0u);

        if(this.hasComplexShapes){
            commands.setBufferState(this.buffers.counterBuffer.deref(), ResourceStates::UnorderedAccess);
            commands.setBufferState(this.buffers.manifoldBuffer.deref(), ResourceStates::UnorderedAccess);
            commands.commitBarriers();

            ComputeState npComplexState;
            npComplexState.setPipeline(this.narrowphaseComplexPipeline.deref()).setIndirectParams(this.buffers.indirectArgsBuffer.deref());
            commands.setComputeState(npComplexState);
            commands.setPushConstants(pushNp);
            commands.dispatchIndirect(0u);
        }

        commands.setBufferState(this.buffers.counterBuffer.deref(), ResourceStates::CopySource);
        commands.setBufferState(this.buffers.counterReadback.deref(), ResourceStates::CopyDest);
        commands.commitBarriers();

        commands.copyBuffer(this.buffers.counterReadback.deref(), 0u, this.buffers.counterBuffer.deref(), 0u, cast<u64>(3u) * cast<u64>(size_of<u32>()));

        commands.setBufferState(this.buffers.bodySimBuffer.deref(), ResourceStates::Common);
        commands.setBufferState(this.buffers.shapeBuffer.deref(), ResourceStates::Common);
        commands.setBufferState(this.buffers.pairBuffer.deref(), ResourceStates::Common);
        commands.setBufferState(this.buffers.counterBuffer.deref(), ResourceStates::Common);
        commands.setBufferState(this.buffers.indirectArgsBuffer.deref(), ResourceStates::Common);
        commands.setBufferState(this.buffers.hullVertexBuffer.deref(), ResourceStates::Common);
        commands.setBufferState(this.buffers.meshNodeBuffer.deref(), ResourceStates::Common);
        commands.setBufferState(this.buffers.meshTriBuffer.deref(), ResourceStates::Common);
        commands.setBufferState(this.buffers.manifoldBuffer.deref(), ResourceStates::Common);
        if(useSpatialHash){
            commands.setBufferState(this.buffers.gridBuffer.deref(), ResourceStates::Common);
            commands.setBufferState(this.buffers.largeListBuffer.deref(), ResourceStates::Common);
        }
        commands.commitBarriers();
        return !commands.commandRecordingFailed();
    }
}

class PhysicsBulletToiTask{
    public mut GpuDescriptorHeap heap;
    public PhysicsGpuBufferGroup buffers;
    public ComputePipelineHandle narrowphasePipeline;
    public Span<GpuPhysicsBodySim> bodySims;
    public Span<GpuPhysicsShapeProxy> shapes;
    public Span<GpuPhysicsBroadphasePair> pairs;
    public u32 pairCount;

    public PhysicsBulletToiTask(
        mut GpuDescriptorHeap descriptorHeap,
        in PhysicsGpuBufferGroup bufGroup,
        in ComputePipelineHandle npPipe,
        in Span<GpuPhysicsBodySim> sims,
        in Span<GpuPhysicsShapeProxy> shapeProxies,
        in Span<GpuPhysicsBroadphasePair> pairSpan,
        in u32 numPairs
    ){
        this.heap = descriptorHeap;
        this.buffers = bufGroup;
        this.narrowphasePipeline = npPipe;
        this.bodySims = sims;
        this.shapes = shapeProxies;
        this.pairs = pairSpan;
        this.pairCount = numPairs;
    }

    public GpuTaskCommandRequirements commandRequirements()const{
        return GpuTaskCommandRequirements(GpuQueueCapability::Compute | GpuQueueCapability::Transfer);
    }

    [cpp_unwind]
    public b8 record(mut CommandList commands, in GpuTaskRecordContext context)const{
        if(this.pairCount == 0u || !this.narrowphasePipeline.valid())
            return false;

        commands.setEnableUavBarriersForBuffer(this.buffers.bodySimBuffer.deref(), false);
        commands.setEnableUavBarriersForBuffer(this.buffers.shapeBuffer.deref(), false);
        commands.setEnableUavBarriersForBuffer(this.buffers.pairBuffer.deref(), false);
        commands.setEnableUavBarriersForBuffer(this.buffers.hullVertexBuffer.deref(), false);
        commands.setEnableUavBarriersForBuffer(this.buffers.meshNodeBuffer.deref(), false);
        commands.setEnableUavBarriersForBuffer(this.buffers.meshTriBuffer.deref(), false);
        commands.setEnableUavBarriersForBuffer(this.buffers.manifoldBuffer.deref(), true);

        commands.setBufferState(this.buffers.bodySimBuffer.deref(), ResourceStates::CopyDest);
        commands.setBufferState(this.buffers.shapeBuffer.deref(), ResourceStates::CopyDest);
        commands.setBufferState(this.buffers.pairBuffer.deref(), ResourceStates::CopyDest);
        commands.commitBarriers();

        if(!commands.tryWriteBuffer(this.buffers.bodySimBuffer.deref(), this.bodySims, 0u))
            return false;
        if(!commands.tryWriteBuffer(this.buffers.shapeBuffer.deref(), this.shapes, 0u))
            return false;
        if(!commands.tryWriteBuffer(this.buffers.pairBuffer.deref(), this.pairs, 0u))
            return false;

        commands.setBufferState(this.buffers.bodySimBuffer.deref(), ResourceStates::UnorderedAccess);
        commands.setBufferState(this.buffers.shapeBuffer.deref(), ResourceStates::UnorderedAccess);
        commands.setBufferState(this.buffers.pairBuffer.deref(), ResourceStates::UnorderedAccess);
        commands.setBufferState(this.buffers.hullVertexBuffer.deref(), ResourceStates::UnorderedAccess);
        commands.setBufferState(this.buffers.meshNodeBuffer.deref(), ResourceStates::UnorderedAccess);
        commands.setBufferState(this.buffers.meshTriBuffer.deref(), ResourceStates::UnorderedAccess);
        commands.setBufferState(this.buffers.manifoldBuffer.deref(), ResourceStates::UnorderedAccess);
        commands.commitBarriers();

        ComputeState npState;
        npState.setPipeline(this.narrowphasePipeline.deref());
        commands.setComputeState(npState);
        this.heap.bindCompute(commands, this.narrowphasePipeline.deref());

        GpuPhysicsPushConstants push;
        push.itemCount = this.pairCount;
        push.modeOrSecondaryCount = s_GpuNarrowphaseModeBulletToi;
        push.linearSlop = s_LinearSlop;
        push.slots0 = this.buffers.slots0;
        push.slots1 = u32x4(this.buffers.slots1.x, this.buffers.slots2.y, this.buffers.slots2.z, s_GpuInvalidIndex);
        commands.setPushConstants(push);
        commands.dispatch(ComputeDispatchGroups(this.pairCount), 1u, 1u);

        commands.setBufferState(this.buffers.bodySimBuffer.deref(), ResourceStates::Common);
        commands.setBufferState(this.buffers.shapeBuffer.deref(), ResourceStates::Common);
        commands.setBufferState(this.buffers.pairBuffer.deref(), ResourceStates::Common);
        commands.setBufferState(this.buffers.hullVertexBuffer.deref(), ResourceStates::Common);
        commands.setBufferState(this.buffers.meshNodeBuffer.deref(), ResourceStates::Common);
        commands.setBufferState(this.buffers.meshTriBuffer.deref(), ResourceStates::Common);
        commands.setBufferState(this.buffers.manifoldBuffer.deref(), ResourceStates::Common);
        commands.commitBarriers();
        return !commands.commandRecordingFailed();
    }
}

class PhysicsSolverTask{
    public mut GpuDescriptorHeap heap;
    public PhysicsGpuBufferGroup buffers;
    public ComputePipelineHandle pipeIntegrateVel;
    public ComputePipelineHandle pipeContacts;
    public ComputePipelineHandle pipeJoints;
    public ComputePipelineHandle pipeIntegratePos;
    public ComputePipelineHandle pipeFinalize;
    public ComputePipelineHandle pipeIslands;
    public ComputePipelineHandle pipeJointIslands;
    public Span<GpuPhysicsBodySim> bodySims;
    public Span<GpuPhysicsBodyState> bodyStates;
    public Span<GpuPhysicsContactConstraint> constraints;
    public Array<PhysicsGpuColorSlice, s_GraphColorCount> colorSlices;
    public Array<u8, s_GraphColorCount> colorHasRestitution;
    public Span<GpuPhysicsJointConstraint> jointConstraints;
    public Array<PhysicsGpuColorSlice, s_GpuJointColorCount> jointColorSlices;
    public Span<GpuPhysicsIslandSlice> islandSlices;
    public f32x4 gravity;
    public u32 awakeCount;
    public u32 totalConstraintCount;
    public u32 totalJointCount;
    public u32 freeBodyCount;
    public u32 contactIslandCount;
    public u32 jointIslandCount;
    public u32 colorBodyOffset;
    public u32 colorContactOffset;
    public u32 colorJointOffset;
    public u32 subStepCount;
    public f32 dt;
    public f32 maxLinearVelocity;
    public f32 restitutionThreshold;
    public b8 enableWarmStarting;

    public PhysicsSolverTask(
        mut GpuDescriptorHeap descriptorHeap,
        in PhysicsGpuBufferGroup bufGroup,
        in ComputePipelineHandle pVel,
        in ComputePipelineHandle pCon,
        in ComputePipelineHandle pJoint,
        in ComputePipelineHandle pPos,
        in ComputePipelineHandle pFin,
        in ComputePipelineHandle pIsl,
        in ComputePipelineHandle pJointIsl,
        in Span<GpuPhysicsBodySim> sims,
        in Span<GpuPhysicsBodyState> states,
        in Span<GpuPhysicsContactConstraint> cons,
        in Array<PhysicsGpuColorSlice, s_GraphColorCount> slices,
        in Array<u8, s_GraphColorCount> restFlags,
        in Span<GpuPhysicsJointConstraint> joints,
        in Array<PhysicsGpuColorSlice, s_GpuJointColorCount> jSlices,
        in Span<GpuPhysicsIslandSlice> islSlices,
        in VectorSingle g,
        in u32 awake,
        in u32 totalCons,
        in u32 totalJoints,
        in u32 freeBodies,
        in u32 conIslCount,
        in u32 jointIslCount,
        in u32 colBodyOff,
        in u32 colConOff,
        in u32 colJointOff,
        in u32 subSteps,
        in f32 stepDt,
        in f32 maxVel,
        in f32 restThreshold,
        in b8 warmStart
    ){
        this.heap = descriptorHeap;
        this.buffers = bufGroup;
        this.pipeIntegrateVel = pVel;
        this.pipeContacts = pCon;
        this.pipeJoints = pJoint;
        this.pipeIntegratePos = pPos;
        this.pipeFinalize = pFin;
        this.pipeIslands = pIsl;
        this.pipeJointIslands = pJointIsl;
        this.bodySims = sims;
        this.bodyStates = states;
        this.constraints = cons;
        this.colorSlices = slices;
        this.colorHasRestitution = restFlags;
        this.jointConstraints = joints;
        this.jointColorSlices = jSlices;
        this.islandSlices = islSlices;
        this.gravity = f32x4(g, 0.0f);
        this.awakeCount = awake;
        this.totalConstraintCount = totalCons;
        this.totalJointCount = totalJoints;
        this.freeBodyCount = freeBodies;
        this.contactIslandCount = conIslCount;
        this.jointIslandCount = jointIslCount;
        this.colorBodyOffset = colBodyOff;
        this.colorContactOffset = colConOff;
        this.colorJointOffset = colJointOff;
        this.subStepCount = subSteps;
        this.dt = stepDt;
        this.maxLinearVelocity = maxVel;
        this.restitutionThreshold = restThreshold;
        this.enableWarmStarting = warmStart;
    }

    public GpuTaskCommandRequirements commandRequirements()const{
        return GpuTaskCommandRequirements(GpuQueueCapability::Compute | GpuQueueCapability::Transfer);
    }

    private void dispatchContactPass(mut CommandList commands, in u32 mode, in f32 invH, in u32 flags, mut b8 heapBound)const{
        if(this.totalConstraintCount <= this.colorContactOffset)
            return;
        const u32 colorConstraintCount = this.totalConstraintCount - this.colorContactOffset;
        ComputeState state;
        state.setPipeline(this.pipeContacts.deref());
        commands.setComputeState(state);
        if(!heapBound){
            this.heap.bindCompute(commands, this.pipeContacts.deref());
            heapBound = true;
        }

        if(mode == s_GpuSolverModeExportImpulses){
            GpuPhysicsPushConstants push;
            push.itemCount = colorConstraintCount;
            push.itemOffset = this.colorContactOffset;
            push.modeOrSecondaryCount = s_GpuSolverModeExportImpulses;
            push.flags = flags;
            push.invDeltaTime = invH;
            push.linearSlop = this.restitutionThreshold;
            push.slots0 = this.buffers.slots0;
            push.slots1 = this.buffers.slots1;
            commands.setPushConstants(push);
            commands.dispatch(ComputeDispatchGroups(colorConstraintCount), 1u, 1u);
            return;
        }

        if(mode == s_GpuSolverModeWarmStart && (flags & s_GpuSolverFlagWarmStart) == 0u){
            GpuPhysicsPushConstants push;
            push.itemCount = colorConstraintCount;
            push.itemOffset = this.colorContactOffset;
            push.modeOrSecondaryCount = s_GpuSolverModeWarmStart;
            push.flags = flags;
            push.invDeltaTime = invH;
            push.linearSlop = this.restitutionThreshold;
            push.slots0 = this.buffers.slots0;
            push.slots1 = this.buffers.slots1;
            commands.setPushConstants(push);
            commands.dispatch(ComputeDispatchGroups(colorConstraintCount), 1u, 1u);

            commands.setBufferState(this.buffers.constraintBuffer.deref(), ResourceStates::UnorderedAccess);
            commands.commitBarriers();
            return;
        }

        const u32 overflowCount = this.colorSlices[s_OverflowColorIndex].count;
        const u32 overflowOffset = this.colorSlices[s_OverflowColorIndex].offset;
        const b8 hasOverflow = overflowCount > 0u && !(mode == s_GpuSolverModeRestitution && this.colorHasRestitution[s_OverflowColorIndex] == 0u);
        usize lastColor = s_GraphColorCount;
        if(hasOverflow){
            lastColor = s_OverflowColorIndex;
        }
        else{
            for(usize c = s_OverflowColorIndex; c > 0u; --c){
                const usize ci = c - 1u;
                if(mode == s_GpuSolverModeRestitution && this.colorHasRestitution[ci] == 0u)
                    continue;
                if(this.colorSlices[ci].count > 0u){
                    lastColor = ci;
                    break;
                }
            }
        }

        for(usize c = 0u; c < s_OverflowColorIndex; ++c){
            if(mode == s_GpuSolverModeRestitution && this.colorHasRestitution[c] == 0u)
                continue;
            const u32 count = this.colorSlices[c].count;
            if(count == 0u)
                continue;

            GpuPhysicsPushConstants push;
            push.itemCount = count;
            push.itemOffset = this.colorSlices[c].offset;
            push.modeOrSecondaryCount = mode;
            push.flags = flags;
            push.invDeltaTime = invH;
            push.linearSlop = this.restitutionThreshold;
            push.slots0 = this.buffers.slots0;
            push.slots1 = this.buffers.slots1;
            commands.setPushConstants(push);
            commands.dispatch(ComputeDispatchGroups(count), 1u, 1u);

            commands.setBufferState(this.buffers.bodyStateBuffer.deref(), ResourceStates::UnorderedAccess);
            if(mode != s_GpuSolverModeWarmStart && c == lastColor)
                commands.setBufferState(this.buffers.constraintBuffer.deref(), ResourceStates::UnorderedAccess);
            commands.commitBarriers();
        }

        if(hasOverflow){
            GpuPhysicsPushConstants push;
            push.itemCount = overflowCount;
            push.itemOffset = overflowOffset;
            push.modeOrSecondaryCount = mode;
            push.flags = flags | s_GpuSolverFlagSerialLoop;
            push.invDeltaTime = invH;
            push.linearSlop = this.restitutionThreshold;
            push.slots0 = this.buffers.slots0;
            push.slots1 = this.buffers.slots1;
            commands.setPushConstants(push);
            commands.dispatch(1u, 1u, 1u);

            commands.setBufferState(this.buffers.bodyStateBuffer.deref(), ResourceStates::UnorderedAccess);
            if(mode != s_GpuSolverModeWarmStart)
                commands.setBufferState(this.buffers.constraintBuffer.deref(), ResourceStates::UnorderedAccess);
            commands.commitBarriers();
        }
    }

    private void dispatchJointPass(mut CommandList commands, in u32 mode, in f32 h, in u32 flags, mut b8 heapBound)const{
        if(this.totalJointCount <= this.colorJointOffset || !this.pipeJoints.valid())
            return;
        const u32 colorJointCount = this.totalJointCount - this.colorJointOffset;
        ComputeState state;
        state.setPipeline(this.pipeJoints.deref());
        commands.setComputeState(state);
        if(!heapBound){
            this.heap.bindCompute(commands, this.pipeJoints.deref());
            heapBound = true;
        }

        if(mode == s_GpuSolverModeExportImpulses){
            GpuPhysicsPushConstants push;
            push.itemCount = colorJointCount;
            push.itemOffset = this.colorJointOffset;
            push.modeOrSecondaryCount = s_GpuSolverModeExportImpulses;
            push.flags = flags;
            push.deltaTime = h;
            push.invDeltaTime = 1.0f / h;
            push.slots0 = this.buffers.slots0;
            push.slots1 = this.buffers.slots1;
            commands.setPushConstants(push);
            commands.dispatch(ComputeDispatchGroups(colorJointCount), 1u, 1u);
            return;
        }

        if(mode == s_GpuSolverModeWarmStart && (flags & s_GpuSolverFlagWarmStart) == 0u){
            GpuPhysicsPushConstants push;
            push.itemCount = colorJointCount;
            push.itemOffset = this.colorJointOffset;
            push.modeOrSecondaryCount = s_GpuSolverModeWarmStart;
            push.flags = flags;
            push.deltaTime = h;
            push.invDeltaTime = 1.0f / h;
            push.slots0 = this.buffers.slots0;
            push.slots1 = this.buffers.slots1;
            commands.setPushConstants(push);
            commands.dispatch(ComputeDispatchGroups(colorJointCount), 1u, 1u);

            commands.setBufferState(this.buffers.jointConstraintBuffer.deref(), ResourceStates::UnorderedAccess);
            commands.commitBarriers();
            return;
        }

        const u32 overflowCount = this.jointColorSlices[s_GpuJointOverflowColorIndex].count;
        const u32 overflowOffset = this.jointColorSlices[s_GpuJointOverflowColorIndex].offset;
        const b8 hasOverflow = overflowCount > 0u;
        usize lastColor = s_GpuJointColorCount;
        if(hasOverflow){
            lastColor = s_GpuJointOverflowColorIndex;
        }
        else{
            for(usize c = s_GpuJointOverflowColorIndex; c > 0u; --c){
                const usize ci = c - 1u;
                if(this.jointColorSlices[ci].count > 0u){
                    lastColor = ci;
                    break;
                }
            }
        }

        for(usize c = 0u; c < s_GpuJointOverflowColorIndex; ++c){
            const u32 count = this.jointColorSlices[c].count;
            if(count == 0u)
                continue;

            GpuPhysicsPushConstants push;
            push.itemCount = count;
            push.itemOffset = this.jointColorSlices[c].offset;
            push.modeOrSecondaryCount = mode;
            push.flags = flags;
            push.deltaTime = h;
            push.invDeltaTime = 1.0f / h;
            push.slots0 = this.buffers.slots0;
            push.slots1 = this.buffers.slots1;
            commands.setPushConstants(push);
            commands.dispatch(ComputeDispatchGroups(count), 1u, 1u);

            commands.setBufferState(this.buffers.bodyStateBuffer.deref(), ResourceStates::UnorderedAccess);
            if(mode != s_GpuSolverModeWarmStart && c == lastColor)
                commands.setBufferState(this.buffers.jointConstraintBuffer.deref(), ResourceStates::UnorderedAccess);
            commands.commitBarriers();
        }

        if(hasOverflow){
            GpuPhysicsPushConstants push;
            push.itemCount = overflowCount;
            push.itemOffset = overflowOffset;
            push.modeOrSecondaryCount = mode;
            push.flags = flags | s_GpuSolverFlagSerialLoop;
            push.deltaTime = h;
            push.invDeltaTime = 1.0f / h;
            push.slots0 = this.buffers.slots0;
            push.slots1 = this.buffers.slots1;
            commands.setPushConstants(push);
            commands.dispatch(1u, 1u, 1u);

            commands.setBufferState(this.buffers.bodyStateBuffer.deref(), ResourceStates::UnorderedAccess);
            if(mode != s_GpuSolverModeWarmStart)
                commands.setBufferState(this.buffers.jointConstraintBuffer.deref(), ResourceStates::UnorderedAccess);
            commands.commitBarriers();
        }
    }

    [cpp_unwind]
    public b8 record(mut CommandList commands, in GpuTaskRecordContext context)const{
        if(this.awakeCount == 0u || this.subStepCount == 0u || this.dt <= 0.0f)
            return false;

        const u32 totalIslandCount = this.contactIslandCount + this.jointIslandCount;
        const u32 colorBodyCount = this.awakeCount - this.colorBodyOffset;

        commands.setEnableUavBarriersForBuffer(this.buffers.bodySimBuffer.deref(), false);
        commands.setEnableUavBarriersForBuffer(this.buffers.bodyStateBuffer.deref(), true);
        commands.setEnableUavBarriersForBuffer(this.buffers.bodyOutBuffer.deref(), true);
        if(totalIslandCount > 0u)
            commands.setEnableUavBarriersForBuffer(this.buffers.islandSliceBuffer.deref(), false);
        if(this.totalConstraintCount > 0u){
            commands.setEnableUavBarriersForBuffer(this.buffers.constraintBuffer.deref(), true);
            commands.setEnableUavBarriersForBuffer(this.buffers.contactImpulseOutBuffer.deref(), true);
        }
        if(this.totalJointCount > 0u){
            commands.setEnableUavBarriersForBuffer(this.buffers.jointConstraintBuffer.deref(), true);
            commands.setEnableUavBarriersForBuffer(this.buffers.jointImpulseOutBuffer.deref(), true);
        }

        commands.setBufferState(this.buffers.bodySimBuffer.deref(), ResourceStates::CopyDest);
        commands.setBufferState(this.buffers.bodyStateBuffer.deref(), ResourceStates::CopyDest);
        if(totalIslandCount > 0u)
            commands.setBufferState(this.buffers.islandSliceBuffer.deref(), ResourceStates::CopyDest);
        if(this.totalConstraintCount > 0u)
            commands.setBufferState(this.buffers.constraintBuffer.deref(), ResourceStates::CopyDest);
        if(this.totalJointCount > 0u)
            commands.setBufferState(this.buffers.jointConstraintBuffer.deref(), ResourceStates::CopyDest);
        commands.commitBarriers();

        if(!commands.tryWriteBuffer(this.buffers.bodySimBuffer.deref(), this.bodySims, 0u))
            return false;
        if(!commands.tryWriteBuffer(this.buffers.bodyStateBuffer.deref(), this.bodyStates, 0u))
            return false;
        if(totalIslandCount > 0u){
            if(!commands.tryWriteBuffer(this.buffers.islandSliceBuffer.deref(), this.islandSlices, 0u))
                return false;
        }
        if(this.totalConstraintCount > 0u){
            if(!commands.tryWriteBuffer(this.buffers.constraintBuffer.deref(), this.constraints, 0u))
                return false;
        }
        if(this.totalJointCount > 0u){
            if(!commands.tryWriteBuffer(this.buffers.jointConstraintBuffer.deref(), this.jointConstraints, 0u))
                return false;
        }

        commands.setBufferState(this.buffers.bodySimBuffer.deref(), ResourceStates::UnorderedAccess);
        commands.setBufferState(this.buffers.bodyStateBuffer.deref(), ResourceStates::UnorderedAccess);
        commands.setBufferState(this.buffers.bodyOutBuffer.deref(), ResourceStates::UnorderedAccess);
        if(totalIslandCount > 0u)
            commands.setBufferState(this.buffers.islandSliceBuffer.deref(), ResourceStates::UnorderedAccess);
        if(this.totalConstraintCount > 0u){
            commands.setBufferState(this.buffers.constraintBuffer.deref(), ResourceStates::UnorderedAccess);
            commands.setBufferState(this.buffers.contactImpulseOutBuffer.deref(), ResourceStates::UnorderedAccess);
        }
        if(this.totalJointCount > 0u){
            commands.setBufferState(this.buffers.jointConstraintBuffer.deref(), ResourceStates::UnorderedAccess);
            commands.setBufferState(this.buffers.jointImpulseOutBuffer.deref(), ResourceStates::UnorderedAccess);
        }
        commands.commitBarriers();

        const f32 h = this.dt / cast<f32>(this.subStepCount);
        const f32 invH = 1.0f / h;
        u32 warmFlag = 0u;
        if(this.enableWarmStarting)
            warmFlag = s_GpuSolverFlagWarmStart;
        b8 heapBound = false;

        if(this.freeBodyCount > 0u){
            ComputeState freeState;
            freeState.setPipeline(this.pipeFinalize.deref());
            commands.setComputeState(freeState);
            this.heap.bindCompute(commands, this.pipeFinalize.deref());
            heapBound = true;

            GpuPhysicsPushConstants push;
            push.itemCount = this.freeBodyCount;
            push.itemOffset = 0u;
            push.modeOrSecondaryCount = this.subStepCount;
            push.deltaTime = this.dt;
            push.maxLinearVelocity = this.maxLinearVelocity;
            push.gravitySpeculative = this.gravity;
            push.slots0 = this.buffers.slots0;
            push.slots1 = this.buffers.slots1;
            commands.setPushConstants(push);
            commands.dispatch(ComputeDispatchGroups(this.freeBodyCount), 1u, 1u);
        }

        if(this.contactIslandCount > 0u){
            ComputeState islState;
            islState.setPipeline(this.pipeIslands.deref());
            commands.setComputeState(islState);
            if(!heapBound){
                this.heap.bindCompute(commands, this.pipeIslands.deref());
                heapBound = true;
            }

            GpuPhysicsPushConstants push;
            push.itemCount = this.contactIslandCount;
            push.itemOffset = 0u;
            push.modeOrSecondaryCount = this.subStepCount;
            push.flags = warmFlag;
            push.deltaTime = this.dt;
            push.invDeltaTime = invH;
            push.maxLinearVelocity = this.maxLinearVelocity;
            push.linearSlop = this.restitutionThreshold;
            push.gravitySpeculative = this.gravity;
            push.slots0 = this.buffers.slots0;
            push.slots1 = this.buffers.slots1;
            commands.setPushConstants(push);
            commands.dispatch((this.contactIslandCount + s_GpuIslandWorkgroupSize - 1u) / s_GpuIslandWorkgroupSize, 1u, 1u);
        }

        if(this.jointIslandCount > 0u){
            ComputeState jIslState;
            jIslState.setPipeline(this.pipeJointIslands.deref());
            commands.setComputeState(jIslState);
            if(!heapBound){
                this.heap.bindCompute(commands, this.pipeJointIslands.deref());
                heapBound = true;
            }

            GpuPhysicsPushConstants push;
            push.itemCount = this.jointIslandCount;
            push.itemOffset = this.contactIslandCount;
            push.modeOrSecondaryCount = this.subStepCount;
            push.flags = warmFlag;
            push.deltaTime = this.dt;
            push.invDeltaTime = invH;
            push.maxLinearVelocity = this.maxLinearVelocity;
            push.linearSlop = this.restitutionThreshold;
            push.gravitySpeculative = this.gravity;
            push.slots0 = this.buffers.slots0;
            push.slots1 = this.buffers.slots1;
            commands.setPushConstants(push);
            commands.dispatch((this.jointIslandCount + s_GpuIslandWorkgroupSize - 1u) / s_GpuIslandWorkgroupSize, 1u, 1u);
        }

        if(colorBodyCount > 0u){
            if(this.totalConstraintCount == this.colorContactOffset && this.totalJointCount == this.colorJointOffset){
                ComputeState freeColorState;
                freeColorState.setPipeline(this.pipeFinalize.deref());
                commands.setComputeState(freeColorState);
                if(!heapBound){
                    this.heap.bindCompute(commands, this.pipeFinalize.deref());
                    heapBound = true;
                }

                GpuPhysicsPushConstants push;
                push.itemCount = colorBodyCount;
                push.itemOffset = this.colorBodyOffset;
                push.modeOrSecondaryCount = this.subStepCount;
                push.deltaTime = this.dt;
                push.maxLinearVelocity = this.maxLinearVelocity;
                push.gravitySpeculative = this.gravity;
                push.slots0 = this.buffers.slots0;
                push.slots1 = this.buffers.slots1;
                commands.setPushConstants(push);
                commands.dispatch(ComputeDispatchGroups(colorBodyCount), 1u, 1u);
            }
            else{
                const u32 bodyGroups = ComputeDispatchGroups(colorBodyCount);
                for(u32 subStep = 0u; subStep < this.subStepCount; ++subStep){
                    {
                        ComputeState velState;
                        velState.setPipeline(this.pipeIntegrateVel.deref());
                        commands.setComputeState(velState);
                        if(!heapBound){
                            this.heap.bindCompute(commands, this.pipeIntegrateVel.deref());
                            heapBound = true;
                        }

                        GpuPhysicsPushConstants push;
                        push.itemCount = colorBodyCount;
                        push.itemOffset = this.colorBodyOffset;
                        push.deltaTime = h;
                        push.maxLinearVelocity = this.maxLinearVelocity;
                        push.gravitySpeculative = this.gravity;
                        push.slots0 = this.buffers.slots0;
                        push.slots1 = this.buffers.slots1;
                        commands.setPushConstants(push);
                        commands.dispatch(bodyGroups, 1u, 1u);

                        commands.setBufferState(this.buffers.bodyStateBuffer.deref(), ResourceStates::UnorderedAccess);
                        commands.commitBarriers();
                    }

                    if(this.enableWarmStarting){
                        this.dispatchContactPass(commands, s_GpuSolverModeWarmStart, invH, s_GpuSolverFlagWarmStart, heapBound);
                        this.dispatchJointPass(commands, s_GpuSolverModeWarmStart, h, s_GpuSolverFlagWarmStart, heapBound);
                    }
                    else if(subStep > 0u){
                        this.dispatchContactPass(commands, s_GpuSolverModeWarmStart, invH, 0u, heapBound);
                        this.dispatchJointPass(commands, s_GpuSolverModeWarmStart, h, 0u, heapBound);
                    }

                    this.dispatchContactPass(commands, s_GpuSolverModeSolveBias, invH, 0u, heapBound);
                    this.dispatchJointPass(commands, s_GpuSolverModeSolveBias, h, 0u, heapBound);

                    {
                        ComputeState posState;
                        posState.setPipeline(this.pipeIntegratePos.deref());
                        commands.setComputeState(posState);

                        GpuPhysicsPushConstants push;
                        push.itemCount = colorBodyCount;
                        push.itemOffset = this.colorBodyOffset;
                        push.deltaTime = h;
                        push.slots0 = this.buffers.slots0;
                        push.slots1 = this.buffers.slots1;
                        commands.setPushConstants(push);
                        commands.dispatch(bodyGroups, 1u, 1u);

                        commands.setBufferState(this.buffers.bodyStateBuffer.deref(), ResourceStates::UnorderedAccess);
                        commands.commitBarriers();
                    }

                    this.dispatchContactPass(commands, s_GpuSolverModeRelax, invH, 0u, heapBound);
                    this.dispatchJointPass(commands, s_GpuSolverModeRelax, h, 0u, heapBound);
                }

                this.dispatchContactPass(commands, s_GpuSolverModeRestitution, invH, 0u, heapBound);

                if(this.totalConstraintCount > this.colorContactOffset)
                    this.dispatchContactPass(commands, s_GpuSolverModeExportImpulses, invH, 0u, heapBound);
                if(this.totalJointCount > this.colorJointOffset)
                    this.dispatchJointPass(commands, s_GpuSolverModeExportImpulses, h, 0u, heapBound);

                {
                    ComputeState finState;
                    finState.setPipeline(this.pipeFinalize.deref());
                    commands.setComputeState(finState);

                    GpuPhysicsPushConstants push;
                    push.itemCount = colorBodyCount;
                    push.itemOffset = this.colorBodyOffset;
                    push.modeOrSecondaryCount = 0u;
                    push.deltaTime = this.dt;
                    push.slots0 = this.buffers.slots0;
                    push.slots1 = this.buffers.slots1;
                    commands.setPushConstants(push);
                    commands.dispatch(bodyGroups, 1u, 1u);
                }
            }
        }

        commands.setBufferState(this.buffers.bodySimBuffer.deref(), ResourceStates::Common);
        commands.setBufferState(this.buffers.bodyStateBuffer.deref(), ResourceStates::Common);
        commands.setBufferState(this.buffers.bodyOutBuffer.deref(), ResourceStates::Common);
        if(totalIslandCount > 0u)
            commands.setBufferState(this.buffers.islandSliceBuffer.deref(), ResourceStates::Common);
        if(this.totalConstraintCount > 0u){
            commands.setBufferState(this.buffers.constraintBuffer.deref(), ResourceStates::Common);
            commands.setBufferState(this.buffers.contactImpulseOutBuffer.deref(), ResourceStates::Common);
        }
        if(this.totalJointCount > 0u){
            commands.setBufferState(this.buffers.jointConstraintBuffer.deref(), ResourceStates::Common);
            commands.setBufferState(this.buffers.jointImpulseOutBuffer.deref(), ResourceStates::Common);
        }
        commands.commitBarriers();
        return !commands.commandRecordingFailed();
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void ResolveGpuManifoldEntry(
    in Vector<Shape> shapes,
    in Vector<Body> bodies,
    in Vector<SolverSet> solverSets,
    in Vector<HullShape> hullShapes,
    in Vector<MeshShape> meshShapes,
    in GpuPhysicsNarrowphaseManifold gm,
    in Contact c,
    in VectorSingle gravVec,
    in f32 dt,
    in b8 enableContinuous,
    in b8 isSensor,
    in b8 swapped,
    mut Manifold outManifold
){
    in Body bA = bodies[c.edges[0u].bodyId];
    in Body bB = bodies[c.edges[1u].bodyId];
    in BodySim simA = solverSets[bA.setIndex].sims[bA.localIndex];
    in BodySim simB = solverSets[bB.setIndex].sims[bB.localIndex];
    b8 needFallback = (gm.pairInfo.w != 0u);
    if(!needFallback){
        ConvertGpuManifoldToCpu(gm, simA, simB, swapped, outManifold);
        const b8 fastOrBullet = ((bA.flags | bB.flags) & (cast<u32>(BodyFlags::IsFast) | cast<u32>(BodyFlags::IsBullet))) != 0u;
        if(!isSensor && enableContinuous && fastOrBullet && dt > 0.0f && outManifold.pointCount() == 0u){
            const VectorSingle dispA = ComputePredictedBodyDisplacement(bA, solverSets, gravVec, dt);
            const VectorSingle dispB = ComputePredictedBodyDisplacement(bB, solverSets, gravVec, dt);
            if(Vector3LengthSq(dispB - dispA).x > s_SpeculativeDistance * s_SpeculativeDistance)
                needFallback = true;
        }
    }
    if(needFallback){
        const VectorSingle dispA = ComputePredictedBodyDisplacement(bA, solverSets, gravVec, dt);
        const VectorSingle dispB = ComputePredictedBodyDisplacement(bB, solverSets, gravVec, dt);
        const b8 isBulletPair = ((bA.flags | bB.flags) & cast<u32>(BodyFlags::IsBullet)) != 0u;
        in Shape sA = shapes[c.shapeIdA];
        in Shape sB = shapes[c.shapeIdB];
        outManifold = CollideContactPairWithSweep(sA, simA.transform, dispA, sB, simB.transform, dispB, isSensor, enableContinuous && dt > 0.0f, isBulletPair, hullShapes, meshShapes);
    }
}

void ApplyGpuManifoldInPlaceAt(
    in Vector<Shape> shapes,
    in Vector<Body> bodies,
    in Vector<SolverSet> solverSets,
    in Vector<HullShape> hullShapes,
    in Vector<MeshShape> meshShapes,
    in Span<GpuPhysicsNarrowphaseManifold> gpuManifolds,
    in Span<u32> manifoldContactIds,
    in Span<u8> manifoldSwapped,
    in VectorSingle gravVec,
    in f32 dt,
    in b8 enableContinuous,
    in b8 enableWarmStarting,
    in usize mi,
    mut Vector<Contact> contacts,
    mut Vector<u8> transitionFlags
){
    const u32 cId = manifoldContactIds[mi];
    if(cId == s_NullIndex)
        return;

    mut Contact c = contacts[cId];
    const b8 isSensor = (c.flags & cast<u32>(ContactFlags::Sensor)) != 0u;
    const b8 swapped = (manifoldSwapped[mi] != 0u);
    Manifold newM;
    ResolveGpuManifoldEntry(shapes, bodies, solverSets, hullShapes, meshShapes, gpuManifolds[mi], c, gravVec, dt, enableContinuous, isSensor, swapped, newM);

    MatchManifoldImpulses(c.manifold, newM, enableWarmStarting);
    in Shape sA = shapes[c.shapeIdA];
    in Shape sB = shapes[c.shapeIdB];
    if(!isSensor){
        c.friction = CombineMaterialFriction(sA.material.friction, sB.material.friction);
        c.restitution = CombineMaterialRestitution(sA.material.restitution, sB.material.restitution);
        c.rollingResistance = CombineMaterialRollingResistance(sA.material.rollingResistance, sB.material.rollingResistance);
        c.tangentSpeed = sA.material.tangentSpeed + sB.material.tangentSpeed;
    }
    c.manifold = newM;

    const b8 wasTouching = (c.flags & cast<u32>(ContactFlags::Touching)) != 0u;
    b8 isTouching = false;
    const u32 ptCount = newM.pointCount();
    if(ptCount > 0u){
        f32 minSep = newM.points[0u].separation();
        for(u32 p = 1u; p < ptCount; ++p){
            const f32 pSep = newM.points[p].separation();
            if(pSep < minSep)
                minSep = pSep;
        }
        f32 touchThreshold = s_LinearSlop;
        if(isSensor)
            touchThreshold = 0.0f;
        if(minSep <= touchThreshold)
            isTouching = true;
    }

    if(isTouching)
        c.flags |= cast<u32>(ContactFlags::Touching);
    else
        c.flags &= ~cast<u32>(ContactFlags::Touching);

    u8 txFlags = 0u;
    if(!isSensor){
        in Body bA = bodies[c.edges[0u].bodyId];
        in Body bB = bodies[c.edges[1u].bodyId];
        if(ptCount > 0u){
            if((c.islandId == s_NullIndex && isTouching) || bA.setIndex >= 3u || bB.setIndex >= 3u || c.colorIndex == s_NullIndex)
                txFlags |= 1u;
        }
        else if(c.colorIndex != s_NullIndex || c.islandId != s_NullIndex){
            txFlags |= 1u;
        }
        if((c.flags & cast<u32>(ContactFlags::EnableContactEvents)) != 0u && wasTouching != isTouching)
            txFlags |= 2u;
    }
    else if((c.flags & cast<u32>(ContactFlags::EnableSensorEvents)) != 0u && wasTouching != isTouching){
        txFlags |= 2u;
    }
    transitionFlags[mi] = txFlags;
}


