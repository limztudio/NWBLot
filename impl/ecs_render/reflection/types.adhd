////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[reflect]
enum<u32> ReflectionDescriptorIndex{
    OpaqueSampled,
    OpaqueStorage,
    GlassSampled,
    GlassStorage,
    Queue,
    Counters,
    Args,
    Parameters
}

[reflect]
enum<u8> ReflectionDispatchStage{
    Classify,
    BuildArgs,
    Hardware
}

class ReflectionSampleBase{
    public u32 x = 0u;
    public u32 y = 0u;
}

// Root wiring retains textures and declares reads; compositing sees only this contract.
class ReflectionCompositeInputs{
    public u32 opaqueRadianceSlot = 0xffffffffu;
    public u32 glassRadianceSlot = 0xffffffffu;
    public ReflectionDebugView debugView = ReflectionDebugView::None;
}

class ReflectionFeedbackExtent{
    public ReflectionFeedbackExtent(){
        this.width = 0u;
        this.height = 0u;
        this.tilesX = 0u;
        this.tilesY = 0u;
        this.entryCount = 0u;
        this.byteCount = 0u;
    }

    public ReflectionFeedbackExtent(in u32 inWidth, in u32 inHeight, in u32 inTilesX, in u32 inTilesY, in u32 inEntryCount, in u32 inByteCount){
        this.width = inWidth;
        this.height = inHeight;
        this.tilesX = inTilesX;
        this.tilesY = inTilesY;
        this.entryCount = inEntryCount;
        this.byteCount = inByteCount;
    }

    public b8 valid()const{
        return this.byteCount != 0u;
    }

    public u32 width;
    public u32 height;
    public u32 tilesX;
    public u32 tilesY;
    public u32 entryCount;
    public u32 byteCount;
}

class ReflectionDepthPyramidMip{
    public Name taskIdentity = s_NameNone;
    public u32 sampledSlot = 0u;
    public u32 storageSlot = 0u;
    public u32 width = 0u;
    public u32 height = 0u;
}


