class SurfelGiLifecycleInputs{
    public Optional<mut DeferredFrameTargets> targets;
    public GpuTaskId dependency;
    public GpuGraphResourceId surfelPool;
    public GpuGraphResourceId surfelCellHead;
    public GpuGraphResourceId surfelCounter;
    public GpuGraphResourceId surfelFreeList;
    public GpuGraphResourceId surfelPoolSnapshot;
    public GpuGraphResourceId surfelCellHeadSnapshot;
    public u64 poolSnapshotByteSize = 0u;
    public u64 cellHeadSnapshotByteSize = 0u;
    public GpuTaskSchedulingHint scheduling;
    public Span<GpuExternalCompletionId> externalDependencies;
    public GpuTaskExternalStateSource computeStateSource;
    public GpuTaskExternalStateSource counterStateSource;
    public b8 hasWork = false;
}

class SurfelGiResourceInputs{
    public in DeferredFrameTargets deferredTargets;
    public in RayTracingDeferredGraphResourceSnapshot rayTracingResources;
    public in RayTracingSurfelPersistentResourceSnapshot rayTracingSurfelResources;
    public GpuGraphResourceId worldPosition;
    public GpuGraphResourceId normal;
    public GpuGraphResourceId surfelIrradiance;
    public GpuGraphResourceId currentBindlessSlots;
    public GpuGraphResourceId sceneShading;
    public GpuGraphResourceId lights;
    public GpuGraphResourceId materialContextSlots;
    public Span<GpuGraphResourceId> traceGeometryResources;
    public b8 traceGeometryStatesGraphOwned;
    public b8 useHwTrace;
    public b8 hasSurfelWork;

    public SurfelGiResourceInputs(
        in DeferredFrameTargets deferredTargetsIn,
        in RayTracingDeferredGraphResourceSnapshot rayTracingResourcesIn,
        in RayTracingSurfelPersistentResourceSnapshot rayTracingSurfelResourcesIn,
        in GpuGraphResourceId worldPositionIn,
        in GpuGraphResourceId normalIn,
        in GpuGraphResourceId surfelIrradianceIn,
        in GpuGraphResourceId currentBindlessSlotsIn,
        in GpuGraphResourceId sceneShadingIn,
        in GpuGraphResourceId lightsIn,
        in GpuGraphResourceId materialContextSlotsIn,
        in Span<GpuGraphResourceId> traceGeometryResourcesIn,
        in b8 traceGeometryStatesGraphOwnedIn,
        in b8 useHwTraceIn,
        in b8 hasSurfelWorkIn
    ){
        this.deferredTargets = deferredTargetsIn;
        this.rayTracingResources = rayTracingResourcesIn;
        this.rayTracingSurfelResources = rayTracingSurfelResourcesIn;
        this.worldPosition = worldPositionIn;
        this.normal = normalIn;
        this.surfelIrradiance = surfelIrradianceIn;
        this.currentBindlessSlots = currentBindlessSlotsIn;
        this.sceneShading = sceneShadingIn;
        this.lights = lightsIn;
        this.materialContextSlots = materialContextSlotsIn;
        this.traceGeometryResources = traceGeometryResourcesIn;
        this.traceGeometryStatesGraphOwned = traceGeometryStatesGraphOwnedIn;
        this.useHwTrace = useHwTraceIn;
        this.hasSurfelWork = hasSurfelWorkIn;
    }
}

class SurfelGiResourcePlan{
    public GpuGraphResourceId surfelIrradianceHalf;
    public GpuGraphResourceId sceneGeometryDomain;
    public GpuGraphResourceId shadowInstanceMaterials;
    public GpuGraphResourceId shadowMaterialTyped;
    public GpuGraphResourceId shadowInstances;
    public GpuGraphResourceId csgTraceContext;
    public GpuGraphResourceId surfelConstants;
    public GpuGraphResourceId surfelPool;
    public GpuGraphResourceId surfelGuidePool;
    public GpuGraphResourceId surfelCellHead;
    public GpuGraphResourceId surfelCounter;
    public GpuGraphResourceId surfelTraceIndirectArgs;
    public GpuGraphResourceId surfelFreeList;
    public GpuGraphResourceId surfelPoolSnapshot;
    public GpuGraphResourceId surfelCellHeadSnapshot;
    public GpuGraphResourceId sceneBvhNodes;
    public GpuGraphResourceId sceneInstances;
    public GpuGraphResourceId tlas;
    public Vector<GpuTaskResourceUse> resourceUses;
    public Vector<GpuTaskResourceUse> traceResourceUses;
    public b8 graphOwnsSurfelGiResolve = false;

    public SurfelGiResourcePlan(){}
}


