#include "types.adhd"
#include <impl/ecs_model/system.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void ApplyModelObjectRenderer(in EntityID owner, in AssetRef<Material> material, mut World world, mut Entity entity){
    const Optional<mut RendererComponent> ownerRendererOpt = world.borrowComponent<RendererComponent>(owner);
    const RendererComponent defaultOwnerRenderer = RendererComponent();
    Expected<RendererComponent> resolvedRenderer = MakeUnexpected(Failure());
    if(ownerRendererOpt.has_value())
        resolvedRenderer = TryResolveModelObjectRendererComponent(material, true, ownerRendererOpt.value());
    else
        resolvedRenderer = TryResolveModelObjectRendererComponent(material, false, defaultOwnerRenderer);
    if(!resolvedRenderer.has_value())
        return;

    mut RendererComponent renderer = entity.addComponent<RendererComponent>();
    renderer = resolvedRenderer.value();

    if(world.hasComponent<MaterialInstanceComponent>(owner)){
        mut MaterialInstanceComponent materialInstance = entity.addComponent<MaterialInstanceComponent>();
        const Optional<mut MaterialInstanceComponent> freshOwnerMatOpt = world.borrowComponent<MaterialInstanceComponent>(owner);
        if(freshOwnerMatOpt.has_value())
            CopyModelObjectMaterialInstance(freshOwnerMatOpt.value(), materialInstance);
    }
}

void SyncModelObjectRenderers(mut World world){
    if(world.view<ModelObjectComponent>().candidateCount() == 0u)
        return;

    mut World worldMut = world;
    const RendererComponent defaultOwnerRenderer = RendererComponent();
    EntityID lastOwner = s_InvalidEntityId;
    b8 lastOwnerAlive = false;
    Optional<mut RendererComponent> lastOwnerRenderer;
    Optional<mut MaterialInstanceComponent> lastOwnerMat;

    world.view<ModelObjectComponent>().each(lambda[mut worldMut, in defaultOwnerRenderer, mut lastOwner, mut lastOwnerAlive, mut lastOwnerRenderer, mut lastOwnerMat](in EntityID entity, in ModelObjectComponent object) -> void{
        if(object.kind == ModelObjectKind::Skeleton || !object.owner.valid())
            return;
        if(object.owner != lastOwner){
            lastOwner = object.owner;
            lastOwnerAlive = worldMut.alive(object.owner);
            if(lastOwnerAlive){
                lastOwnerRenderer = worldMut.borrowComponent<RendererComponent>(object.owner);
                lastOwnerMat = worldMut.borrowComponent<MaterialInstanceComponent>(object.owner);
            }
            else{
                lastOwnerRenderer = Optional<mut RendererComponent>();
                lastOwnerMat = Optional<mut MaterialInstanceComponent>();
            }
        }
        if(!lastOwnerAlive)
            return;

        Expected<RendererComponent> resolvedRenderer = MakeUnexpected(Failure());
        if(lastOwnerRenderer.has_value())
            resolvedRenderer = TryResolveModelObjectRendererComponent(AssetRef<Material>(object.defaultMaterial), true, lastOwnerRenderer.value());
        else
            resolvedRenderer = TryResolveModelObjectRendererComponent(AssetRef<Material>(object.defaultMaterial), false, defaultOwnerRenderer);
        if(!resolvedRenderer.has_value()){
            b8 invalidated = false;
            if(worldMut.hasComponent<RendererComponent>(entity)){
                worldMut.removeComponent<RendererComponent>(entity);
                invalidated = true;
            }
            if(worldMut.hasComponent<MaterialInstanceComponent>(entity)){
                worldMut.removeComponent<MaterialInstanceComponent>(entity);
                invalidated = true;
            }
            if(invalidated)
                lastOwner = s_InvalidEntityId;
            return;
        }

        const Optional<mut RendererComponent> childRendererOpt = worldMut.borrowComponent<RendererComponent>(entity);
        if(childRendererOpt.has_value()){
            if(!ModelObjectRendererComponentsEqual(childRendererOpt.value(), resolvedRenderer.value()))
                childRendererOpt.value() = resolvedRenderer.value();
        }
        else{
            worldMut.entity(entity).addComponent<RendererComponent>() = resolvedRenderer.value();
            lastOwner = s_InvalidEntityId;
        }

        if(lastOwnerMat.has_value()){
            const Optional<mut MaterialInstanceComponent> childMatOpt = worldMut.borrowComponent<MaterialInstanceComponent>(entity);
            if(!childMatOpt.has_value()){
                mut MaterialInstanceComponent childMat = worldMut.entity(entity).addComponent<MaterialInstanceComponent>();
                const Optional<mut MaterialInstanceComponent> freshOwnerMatOpt = worldMut.borrowComponent<MaterialInstanceComponent>(object.owner);
                if(freshOwnerMatOpt.has_value())
                    CopyModelObjectMaterialInstance(freshOwnerMatOpt.value(), childMat);
                lastOwner = s_InvalidEntityId;
            }
            else{
                in MaterialInstanceComponent ownerMat = lastOwnerMat.value();
                mut MaterialInstanceComponent childMat = childMatOpt.value();
                if(!ModelObjectMaterialInstancesEqual(ownerMat, childMat))
                    CopyModelObjectMaterialInstance(ownerMat, childMat);
            }
        }
        else if(worldMut.hasComponent<MaterialInstanceComponent>(entity)){
            worldMut.removeComponent<MaterialInstanceComponent>(entity);
            lastOwner = s_InvalidEntityId;
        }
    });
}

ComponentAccess MakeWriteComponentAccess(in usize typeId){
    ComponentAccess access = ComponentAccess();
    access.typeId = typeId;
    access.mode = AccessMode::Write;
    return access;
}

ModelObjectRendererHooks CreateModelObjectRendererHooks(){
    Array<ComponentAccess, 2u> accesses = Array<ComponentAccess, 2u>();
    accesses[0u] = MakeWriteComponentAccess(ComponentType<RendererComponent>());
    accesses[1u] = MakeWriteComponentAccess(ComponentType<MaterialInstanceComponent>());
    const ModelObjectRendererApplyFn applyFn = ApplyModelObjectRenderer;
    const ModelObjectRendererSyncFn syncFn = SyncModelObjectRenderers;
    return ModelObjectRendererHooks(ModelObjectRendererCallback(applyFn), ModelObjectRendererSyncCallback(syncFn), accesses);
}


