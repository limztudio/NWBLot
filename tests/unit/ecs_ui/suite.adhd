#include <tests/common/gtest_macros.adhd>
#include <tests/unit/ecs_ui/ecs_ui_test_fixtures.adhd>
#include <tests/unit/ecs_ui/ecs_ui_system_and_bridge_cases.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type NavigationHook = Func<128u, void()>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class NavigationCall{
    public String text;
    public EditNavigationSnapshot navigation;
    public Expected<EditNavigationResult> result = MakeUnexpected(Failure());
    public u64 selectionGeneration = 0u;
    public usize caret = 0u;
    public f32 viewportHeight = 0.0f;
}

class RecordingNavigationResolver : IEditNavigationResolver{
    public Vector<NavigationCall> records;
    public NavigationHook hook;
    public Expected<EditNavigationResult> forcedResult = MakeUnexpected(Failure());
    public b8 forceResult = false;
    private mut TextLayoutBuilder m_layoutBuilder;

    public RecordingNavigationResolver(mut TextLayoutBuilder builder){ this.m_layoutBuilder = builder; }
    public mut TextLayoutBuilder layoutBuilder(){ return this.m_layoutBuilder; }
    public Expected<EditNavigationResult> resolve(in EditModel model, in EditNavigationDirection direction, in EditNavigationSnapshot navigation, in f32 viewportHeight)override{
        return ResolveEcsUiEditViewNavigation(this, model, direction, navigation, viewportHeight);
    }
    public void invokeHookIfPresent(){
        if(this.hook){
            NavigationHook callback = this.hook;
            this.hook = NavigationHook();
            callback();
        }
    }
}

class NavigationAction{
    public String text;
    public EditAction action = EditAction::Abandon;
}

class AcceptingNavigationActions : IEditActionSink{
    public Vector<NavigationAction> records;
    public b8 apply(mut EditModel model, in EditAction action, in b8 readOnly)override{ return ApplyEcsUiAcceptingNavigationAction(this, model, action); }
    public usize count(in EditAction action)const{ return CountEcsUiNavigationActions(this, action); }
}

class UiEditNavigationHostTests{
    public UiEditBoxHostTests core;
    public EditModel m_navigationModel = EditModel(EditLimits(), EditTextMode::Multiline);
    public EditNavigationState m_navigation;
    public RecordingNavigationResolver m_resolver;
    public AcceptingNavigationActions m_actions;

    public UiEditNavigationHostTests(){ this.m_resolver = RecordingNavigationResolver(this.core.m_layoutBuilder); }
    public void setup(){ this.core.setup(); this.core.m_includeButton = true; }
    public b8 prepareNavigationModel(mut EditModel model, mut EditNavigationState nav, in EditBoxOptions options, in Rect bounds, in Point scroll){
        return PrepareEcsUiNavigationModel(this, model, nav, options, bounds, scroll);
    }
    public b8 prepareNavigation(in EditBoxOptions options, in Rect bounds, in Point scroll){ return this.prepareNavigationModel(this.m_navigationModel, this.m_navigation, options, bounds, scroll); }
    public b8 navigationFrame(in EditBoxOptions options, in Rect bounds, in Point scroll){ return this.prepareNavigation(options, bounds, scroll) && this.core.commit(); }
    public b8 activateNavigation(in EditBoxOptions options, in Rect bounds){
        return this.navigationFrame(options, bounds) && this.core.key(Key::Tab) && this.navigationFrame(options, bounds) && this.core.m_context.input().focus() == this.core.m_widget.id;
    }
    public b8 commitNative(in StringView text){ return CommitEcsUiNavigationText(this, text); }
    public b8 click(in Point position){ return this.click(position, false); }
    public b8 click(in Point position, in b8 shift){
        return this.core.dispatchPoint(position, InputEventType::PrimaryDown, shift) && this.core.dispatchPoint(position, InputEventType::PrimaryUp, shift);
    }
    public b8 focusOther(){ return this.core.key(Key::Tab) && this.core.m_context.input().focus() == this.core.m_otherWidget.id; }
    public b8 focusNavigation(){ return this.core.key(Key::Tab) && this.core.m_context.input().focus() == this.core.m_widget.id; }
    public b8 prepareNavigationModel(mut EditModel model, mut EditNavigationState nav){ return this.prepareNavigationModel(model, nav, EditBoxOptions()); }
    public b8 prepareNavigationModel(mut EditModel model, mut EditNavigationState nav, in EditBoxOptions options){ return this.prepareNavigationModel(model, nav, options, DefaultNavigationBounds()); }
    public b8 prepareNavigationModel(mut EditModel model, mut EditNavigationState nav, in EditBoxOptions options, in Rect bounds){ return this.prepareNavigationModel(model, nav, options, bounds, Point()); }
    public b8 prepareNavigation(){ return this.prepareNavigation(EditBoxOptions()); }
    public b8 prepareNavigation(in EditBoxOptions options){ return this.prepareNavigation(options, DefaultNavigationBounds()); }
    public b8 prepareNavigation(in EditBoxOptions options, in Rect bounds){ return this.prepareNavigation(options, bounds, Point()); }
    public b8 navigationFrame(){ return this.navigationFrame(EditBoxOptions()); }
    public b8 navigationFrame(in EditBoxOptions options){ return this.navigationFrame(options, DefaultNavigationBounds()); }
    public b8 navigationFrame(in EditBoxOptions options, in Rect bounds){ return this.navigationFrame(options, bounds, Point()); }
    public b8 activateNavigation(){ return this.activateNavigation(EditBoxOptions()); }
    public b8 activateNavigation(in EditBoxOptions options){ return this.activateNavigation(options, DefaultNavigationBounds()); }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Rect DefaultNavigationBounds(){ return Rect(10.0f, 20.0f, 180.0f, 48.0f); }

Expected<EditNavigationResult> ResolveEcsUiEditViewNavigation(mut RecordingNavigationResolver self, in EditModel model, in EditNavigationDirection direction, in EditNavigationSnapshot navigation, in f32 viewportHeight){
    NavigationCall record = NavigationCall();
    record.text.assign(model.text().data(), model.text().size());
    record.navigation = navigation;
    record.selectionGeneration = model.selectionGeneration();
    record.caret = model.caret();
    record.viewportHeight = viewportHeight;

    Expected<EditNavigationResult> result = MakeUnexpected(Failure());
    EditBoxView view = EditBoxView();
    if(PrepareEcsUiEditView(model, self.layoutBuilder(), view)){
        const auto caret = view.caretGeometry().caretRect(view.displayCaret());
        if(caret){
            f32 preferredX = caret.value().x;
            if(navigation.valid){
                preferredX = navigation.preferredX;
            }
            Expected<usize> target = MakeUnexpected(Failure());
            if(direction == EditNavigationDirection::Up || direction == EditNavigationDirection::Down){
                target = view.caretGeometry().verticalTarget(view.displayCaret(), direction == EditNavigationDirection::Down, preferredX);
            }
            else{
                f32 distance = -viewportHeight;
                if(direction == EditNavigationDirection::PageDown){
                    distance = viewportHeight;
                }
                target = view.caretGeometry().hitTest(Point(preferredX, caret.value().y + caret.value().height * 0.5f + distance));
            }
            if(target){
                EditNavigationResult resolved = EditNavigationResult();
                resolved.committedByte = target.value();
                resolved.preferredX = preferredX;
                result = resolved;
            }
        }
    }
    if(self.forceResult){
        result = self.forcedResult;
    }
    record.result = result;
    self.records.push_back(record);
    self.invokeHookIfPresent();
    return result;
}

b8 ApplyEcsUiAcceptingNavigationAction(mut AcceptingNavigationActions self, mut EditModel model, in EditAction action){
    NavigationAction record = NavigationAction();
    record.text.assign(model.text().data(), model.text().size());
    record.action = action;
    self.records.push_back(record);
    return true;
}

usize CountEcsUiNavigationActions(in AcceptingNavigationActions self, in EditAction action){
    usize result = 0u;
    for(usize i = 0u; i < self.records.size(); ++i){
        if(self.records[i].action == action){
            ++result;
        }
    }
    return result;
}

b8 PrepareEcsUiNavigationModel(mut UiEditNavigationHostTests self, mut EditModel model, mut EditNavigationState navigation, in EditBoxOptions options, in Rect bounds, in Point previousScroll){
    if(!BeginEcsUiEditFrame(self.core)){
        return false;
    }
    self.core.m_result = self.core.m_host.editNavigated(self.core.m_widget, options, PopupToken(), model, navigation, self.m_resolver, self.m_actions);
    if(!self.core.m_result.valid || !PublishEcsUiEditBox(self.core, model, options, bounds, previousScroll)){
        return false;
    }
    const auto declaredOther = self.core.m_context.declare("other", WidgetKind::Button);
    if(!declaredOther.has_value()){
        return false;
    }
    self.core.m_otherWidget = declaredOther.value();
    HitTarget other = HitTarget();
    other.rectangle = Rect(230.0f, 20.0f, 100.0f, 30.0f);
    other.clip = Rect(0.0f, 0.0f, s_EcsUiViewportWidth, s_EcsUiViewportHeight);
    other.focusable = true;
    other.activatable = true;
    if(!self.core.m_context.addTarget(self.core.m_otherWidget, other) || !self.core.m_context.endRoot() || !self.core.m_context.finishFrame()){
        return false;
    }
    self.core.m_host.finishFrame();
    return true;
}

b8 CommitEcsUiNavigationText(mut UiEditNavigationHostTests self, in StringView text){
    if(self.core.m_textInput.commit(text) != TextInputAdmission::Accepted){
        return false;
    }
    self.core.m_host.collectNative();
    return true;
}

void VerifyUiTextEditSession_TrailingPreeditClearPreservesCommittedSelectedReplacementAndSingleUndo(){
    HeapStorage arena = HeapStorage();
    FakeTextInput service = FakeTextInput(arena);
    EditModel model = EditModel();
    UiTextEditSession session = UiTextEditSession(service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_TRUE(model.setText("abcd"));
    ASSERT_TRUE(model.setSelection(1u, 3u));
    ASSERT_EQ(session.begin(MakeSessionTestOwner(17u, 1u, 1u), s_SessionTestCaret, model), TextInputAdmission::Accepted);
    ASSERT_EQ(service.preedit("xy", 0u, 2u), TextInputAdmission::Accepted);
    EXPECT_EQ(session.drain(MakeSessionTestOwner(17u, 1u, 1u), model).status, UiTextEditStatus::Applied);
    EXPECT_EQ(model.text(), "abcd");
    EXPECT_FALSE(model.canUndo());
    ASSERT_EQ(service.preedit("xyz", 1u, 3u), TextInputAdmission::Accepted);
    ASSERT_EQ(service.commit("Z"), TextInputAdmission::Accepted);
    ASSERT_EQ(service.preedit(StringView(), 0u, 0u), TextInputAdmission::Accepted);
    const UiTextEditResult result = session.drain(MakeSessionTestOwner(17u, 1u, 1u), model);
    EXPECT_EQ(result.eventsApplied, 3u);
    EXPECT_EQ(model.text(), "aZd");
    EXPECT_FALSE(model.composition().active);
    ASSERT_TRUE(session.end(MakeSessionTestOwner(17u, 1u, 1u), model));
    ASSERT_TRUE(model.undo());
    EXPECT_EQ(model.text(), "abcd");
    EXPECT_EQ(model.anchor(), 1u);
    EXPECT_EQ(model.caret(), 3u);
    EXPECT_FALSE(model.canUndo());
}

void VerifyUiTextEditSession_EmptyPreeditCancelsWithoutChangingCommittedText(){
    HeapStorage arena = HeapStorage();
    FakeTextInput service = FakeTextInput(arena);
    EditModel model = EditModel();
    UiTextEditSession session = UiTextEditSession(service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_TRUE(model.setText("base"));
    ASSERT_EQ(session.begin(MakeSessionTestOwner(17u, 1u, 1u), s_SessionTestCaret, model), TextInputAdmission::Accepted);
    ASSERT_EQ(service.preedit("transient", 0u, 9u), TextInputAdmission::Accepted);
    ASSERT_EQ(service.preedit(StringView(), 0u, 0u), TextInputAdmission::Accepted);
    EXPECT_EQ(session.drain(MakeSessionTestOwner(17u, 1u, 1u), model).status, UiTextEditStatus::Applied);
    EXPECT_EQ(model.text(), "base");
    EXPECT_FALSE(model.composition().active);
    EXPECT_FALSE(model.canUndo());
}

void VerifyUiTextEditSession_FocusLossDiscardsQueuedCommitAndClearsOnlyTransientPreedit(){
    HeapStorage arena = HeapStorage();
    FakeTextInput service = FakeTextInput(arena);
    EditModel model = EditModel();
    UiTextEditSession session = UiTextEditSession(service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_TRUE(model.setText("base"));
    ASSERT_EQ(session.begin(MakeSessionTestOwner(17u, 1u, 1u), s_SessionTestCaret, model), TextInputAdmission::Accepted);
    ASSERT_EQ(service.preedit("new", 0u, 3u), TextInputAdmission::Accepted);
    EXPECT_EQ(session.drain(MakeSessionTestOwner(17u, 1u, 1u), model).status, UiTextEditStatus::Applied);
    ASSERT_EQ(service.commit("lost"), TextInputAdmission::Accepted);
    ASSERT_TRUE(service.setFocused(false));
    EXPECT_EQ(session.drain(MakeSessionTestOwner(17u, 1u, 1u), model).status, UiTextEditStatus::Cancelled);
    EXPECT_EQ(model.text(), "base");
    EXPECT_FALSE(model.composition().active);
    EXPECT_FALSE(session.token().valid());
}

void VerifyUiTextEditSession_ReplacedOwnerCannotReceiveOldQueuedCommit(){
    HeapStorage arena = HeapStorage();
    FakeTextInput service = FakeTextInput(arena);
    EditModel oldModel = EditModel();
    EditModel newModel = EditModel();
    UiTextEditSession session = UiTextEditSession(service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_TRUE(newModel.setText("replacement"));
    ASSERT_EQ(session.begin(MakeSessionTestOwner(17u, 1u, 1u), s_SessionTestCaret, oldModel), TextInputAdmission::Accepted);
    ASSERT_EQ(service.commit("old"), TextInputAdmission::Accepted);
    const UiTextEditOwner replacement = MakeReplacedSessionOwner(2u);
    EXPECT_EQ(session.drain(replacement, newModel).status, UiTextEditStatus::StaleOwner);
    EXPECT_EQ(newModel.text(), "replacement");
    EXPECT_FALSE(service.activeSession().valid());
    EXPECT_FALSE(session.token().valid());
}

void VerifyUiTextEditSession_ExternalTextAndSelectionChangesFenceOldNativeEvents(){
    HeapStorage arena = HeapStorage();
    FakeTextInput service = FakeTextInput(arena);
    EditModel model = EditModel();
    UiTextEditSession session = UiTextEditSession(service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_TRUE(model.setText("abcd"));
    ASSERT_EQ(session.begin(MakeSessionTestOwner(17u, 1u, 1u), s_SessionTestCaret, model), TextInputAdmission::Accepted);
    ASSERT_EQ(service.commit("late"), TextInputAdmission::Accepted);
    ASSERT_TRUE(model.setSelection(0u, 2u));
    EXPECT_EQ(session.refresh(MakeSessionTestOwner(17u, 1u, 1u), model, s_SessionTestCaret), TextInputAdmission::InvalidSession);
    EXPECT_EQ(session.drain(MakeSessionTestOwner(17u, 1u, 1u), model).status, UiTextEditStatus::StaleModel);
    EXPECT_EQ(model.text(), "abcd");
    EXPECT_EQ(model.anchor(), 0u);
    EXPECT_EQ(model.caret(), 2u);
    ASSERT_EQ(session.begin(MakeSessionTestOwner(17u, 1u, 1u), s_SessionTestCaret, model), TextInputAdmission::Accepted);
    ASSERT_EQ(service.commit("late"), TextInputAdmission::Accepted);
    ASSERT_TRUE(model.setText("host value"));
    EXPECT_EQ(session.drain(MakeSessionTestOwner(17u, 1u, 1u), model).status, UiTextEditStatus::StaleModel);
    EXPECT_EQ(model.text(), "host value");
}

void VerifyUiTextEditSession_DeleteAddressesPublishedUtf8BytesThenCommitUsesUpdatedSelection(){
    HeapStorage arena = HeapStorage();
    FakeTextInput service = FakeTextInput(arena);
    EditModel model = EditModel();
    UiTextEditSession session = UiTextEditSession(service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_TRUE(model.setText("abCde"));
    ASSERT_TRUE(model.setSelection(3u, 3u));
    ASSERT_EQ(session.begin(MakeSessionTestOwner(17u, 1u, 1u), s_SessionTestCaret, model), TextInputAdmission::Accepted);
    ASSERT_EQ(service.erase(1u, 1u, service.surroundingRevision(service.activeSession()), TextInputDeletionBasis::Caret), TextInputAdmission::Accepted);
    ASSERT_EQ(service.commit("X"), TextInputAdmission::Accepted);
    const UiTextEditResult result = session.drain(MakeSessionTestOwner(17u, 1u, 1u), model);
    EXPECT_EQ(result.status, UiTextEditStatus::Applied);
    EXPECT_EQ(result.eventsApplied, 2u);
    EXPECT_EQ(model.text(), "abXe");
}

void VerifyUiTextEditSession_PreeditClearBeforeCommitPreservesTheOriginalReplacementSelection(){
    HeapStorage arena = HeapStorage();
    FakeTextInput service = FakeTextInput(arena);
    EditModel model = EditModel();
    UiTextEditSession session = UiTextEditSession(service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_TRUE(model.setText("abcd"));
    ASSERT_TRUE(model.setSelection(3u, 1u));
    ASSERT_EQ(session.begin(MakeSessionTestOwner(17u, 1u, 1u), s_SessionTestCaret, model), TextInputAdmission::Accepted);
    ASSERT_EQ(service.preedit("pending", 0u, 7u), TextInputAdmission::Accepted);
    EXPECT_EQ(session.drain(MakeSessionTestOwner(17u, 1u, 1u), model).status, UiTextEditStatus::Applied);
    ASSERT_EQ(service.preedit(StringView(), 0u, 0u), TextInputAdmission::Accepted);
    ASSERT_EQ(service.commit("X"), TextInputAdmission::Accepted);
    EXPECT_EQ(session.drain(MakeSessionTestOwner(17u, 1u, 1u), model).status, UiTextEditStatus::Applied);
    EXPECT_EQ(model.text(), "aXd");
    ASSERT_TRUE(session.end(MakeSessionTestOwner(17u, 1u, 1u), model));
    ASSERT_TRUE(model.undo());
    EXPECT_EQ(model.anchor(), 3u);
    EXPECT_EQ(model.caret(), 1u);
}

void VerifyUiTextEditSession_DeleteAfterUnpublishedCommitCannotDeleteDifferentText(){
    HeapStorage arena = HeapStorage();
    FakeTextInput service = FakeTextInput(arena);
    EditModel model = EditModel();
    UiTextEditSession session = UiTextEditSession(service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_TRUE(model.setText("ab"));
    ASSERT_EQ(session.begin(MakeSessionTestOwner(17u, 1u, 1u), s_SessionTestCaret, model), TextInputAdmission::Accepted);
    ASSERT_EQ(service.commit("X"), TextInputAdmission::Accepted);
    ASSERT_EQ(service.erase(1u, 0u, service.surroundingRevision(service.activeSession()), TextInputDeletionBasis::Caret), TextInputAdmission::Accepted);
    EXPECT_EQ(session.drain(MakeSessionTestOwner(17u, 1u, 1u), model).status, UiTextEditStatus::StaleSurrounding);
    EXPECT_EQ(model.text(), "abX");
    EXPECT_FALSE(session.token().valid());
}

void VerifyUiTextEditSession_NativeByteDeleteCannotSplitAGrapheme(){
    HeapStorage arena = HeapStorage();
    FakeTextInput service = FakeTextInput(arena);
    EditModel model = EditModel();
    UiTextEditSession session = UiTextEditSession(service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_TRUE(model.setText("e\xCC\x81"));
    ASSERT_EQ(session.begin(MakeSessionTestOwner(17u, 1u, 1u), s_SessionTestCaret, model), TextInputAdmission::Accepted);
    ASSERT_EQ(service.erase(2u, 0u, service.surroundingRevision(service.activeSession()), TextInputDeletionBasis::Caret), TextInputAdmission::Accepted);
    EXPECT_EQ(session.drain(MakeSessionTestOwner(17u, 1u, 1u), model).status, UiTextEditStatus::ModelRejected);
    EXPECT_EQ(model.text(), "e\xCC\x81");
    EXPECT_FALSE(model.canUndo());
}

void VerifyUiTextEditSession_RejectedCommitPreservesCommittedTextAndCancelsNativeSession(){
    HeapStorage arena = HeapStorage();
    FakeTextInput service = FakeTextInput(arena);
    EditLimits limits = EditLimits();
    limits.maxBytes = 2u;
    limits.maxHistoryRecords = 4u;
    limits.maxHistoryBytes = 128u;
    EditModel model = EditModel(limits);
    UiTextEditSession session = UiTextEditSession(service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_TRUE(model.setText("ab"));
    ASSERT_EQ(session.begin(MakeSessionTestOwner(17u, 1u, 1u), s_SessionTestCaret, model), TextInputAdmission::Accepted);
    ASSERT_EQ(service.commit("too large"), TextInputAdmission::Accepted);
    EXPECT_EQ(session.drain(MakeSessionTestOwner(17u, 1u, 1u), model).status, UiTextEditStatus::ModelRejected);
    EXPECT_EQ(model.text(), "ab");
    EXPECT_FALSE(model.canUndo());
    EXPECT_FALSE(service.activeSession().valid());
}

void VerifyUiTextEditSession_ExplicitEndClearsCompositionAndInvalidatesOldToken(){
    HeapStorage arena = HeapStorage();
    FakeTextInput service = FakeTextInput(arena);
    EditModel model = EditModel();
    UiTextEditSession session = UiTextEditSession(service);
    ASSERT_TRUE(service.setFocused(true));
    ASSERT_EQ(session.begin(MakeSessionTestOwner(17u, 1u, 1u), s_SessionTestCaret, model), TextInputAdmission::Accepted);
    const TextInputSessionToken first = session.token();
    EXPECT_EQ(session.begin(MakeSessionTestOwner(17u, 1u, 1u), s_SessionTestCaret, model), TextInputAdmission::Busy);
    ASSERT_EQ(service.preedit("pending", 0u, 7u), TextInputAdmission::Accepted);
    EXPECT_EQ(session.drain(MakeSessionTestOwner(17u, 1u, 1u), model).status, UiTextEditStatus::Applied);
    ASSERT_TRUE(session.end(MakeSessionTestOwner(17u, 1u, 1u), model));
    EXPECT_FALSE(model.composition().active);
    ASSERT_EQ(session.begin(MakeSessionTestOwner(17u, 1u, 1u), s_SessionTestCaret, model), TextInputAdmission::Accepted);
    EXPECT_NE(session.token(), first);
    TextInputEvent event = TextInputEvent();
    EXPECT_EQ(service.poll(first, event), TextInputPollResult::InvalidSession);
}

void VerifyUiTextEditSession_DestructionReleasesServiceWithoutBorrowingTheDestroyedModel(){
    HeapStorage arena = HeapStorage();
    FakeTextInput service = FakeTextInput(arena);
    ASSERT_TRUE(service.setFocused(true));
    if(true){
        UiTextEditSession session = UiTextEditSession(service);
        if(true){
            EditModel model = EditModel();
            ASSERT_EQ(session.begin(MakeSessionTestOwner(17u, 1u, 1u), s_SessionTestCaret, model), TextInputAdmission::Accepted);
        }
        EXPECT_TRUE(service.activeSession().valid());
    }
    EXPECT_FALSE(service.activeSession().valid());
}

