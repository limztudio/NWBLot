#include <impl/ecs_render/components.adhd>
#include <impl/ecs_render/material/instance_override_fields.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 SetMaterialMutableParameter(
    mut World world,
    in EntityID entity,
    in Name materialInterface,
    in StringView parameterName,
    in MaterialLayoutFieldType fieldType,
    in u32x4u value
){
    if(!world.hasComponent<MaterialInstanceComponent>(entity)){
        LogMissingMaterialInstanceComponent(entity);
        return false;
    }

    mut MaterialInstanceComponent component = world.getComponent<MaterialInstanceComponent>(entity);
    return SetMaterialMutableParameter(component, materialInterface, parameterName, fieldType, value);
}

b8 SetMaterialMutableHalf4(
    mut World world,
    in EntityID entity,
    in Name materialInterface,
    in StringView parameterName,
    in VectorSingle value
){
    const f16x4u packedValue = ConvertMaterialInstanceHalf4(value);
    return SetMaterialMutableParameter(
        world,
        entity,
        materialInterface,
        parameterName,
        MaterialLayoutFieldType::f16x4,
        PackMaterialInstanceHalf4U(packedValue)
    );
}


