AssetBytes BuildPartialBlockTextureBytes(mut TestArena testArena){
    AssetBytes binary = MakeAssetBytes(testArena);
    binary.reserve(s_TestTextureHeaderBytes + s_TextureMipTableBytes + s_TexturePrimaryPayloadBytes);
    TexturePayloadHeaderBinary header;
    header.dimension = cast<u32>(TexturePayloadDimension::Texture2D);
    header.width = 7u;
    header.height = 5u;
    header.depth = 1u;
    header.mipCount = s_TextureMipCount;
    header.alphaInfo = cast<u32>(TextureAlphaMode::Opaque) | (s_OpaqueAlphaUnorm8 << s_AlphaInfoConstantShift);
    header.payloadFormat = cast<u32>(TexturePayloadFormat::UastcLdr4x4);
    header.payloadByteCount = s_TexturePrimaryPayloadBytes;
    AppendPOD(binary, header);
    const MipLevelVector mips = TestTextureMips();
    for(in TextureMipLevel mip : mips)
        AppendPOD(binary, TestBinaryMip(mip));
    for(usize byte = 0u; byte < s_TexturePrimaryPayloadBytes; ++byte)
        binary.push_back(cast<u8>(byte));
    return binary;
}

AssetBytes MakeTestTextureUastcPayload(mut TestArena testArena){
    AssetBytes bytes = MakeAssetBytes(testArena);
    bytes.resize(s_TexturePrimaryPayloadBytes);
    for(usize index = 0u; index < bytes.size(); ++index)
        bytes[index] = cast<u8>(index);
    return bytes;
}

Expected<AssetBytes> MakeTestTextureRuntimeBinary(mut TestArena testArena){
    Texture texture(s_AssetCaseProjectTexturesPrepared);
    SetStandardTestTexturePayload(testArena, TextureAlphaMode::EmbeddedLdr, cast<u8>(s_OpaqueAlphaUnorm8), texture);
    TextureAssetCodec codec = TextureAssetCodec();
    AssetBytes bytes = MakeAssetBytes(testArena);
    if(!codec.serialize(texture, GraphicsCodecBytes(bytes)))
        return MakeUnexpected(Failure());
    return bytes;
}

void SetStandardTestTexturePayload(mut TestArena testArena, in TextureAlphaModeEnum alphaMode, in u8 alphaConstant, mut TextureAsset outTexture){
    outTexture.setPayload(7u, 5u, TestTextureMips(), MakeTestTextureUastcPayload(testArena), TexturePayloadDimension::Texture2D, 1u, TexturePayloadFormat::UastcLdr4x4, alphaMode, alphaConstant);
}

