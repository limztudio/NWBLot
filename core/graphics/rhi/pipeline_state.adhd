[cpp_header("<core/graphics/rhi/pipeline_state.h>"), cpp_name("::NWB::Core::BlendState"), cpp_flags(self_defaulted, binary_serializable, brace_init, equality_switch, map_key)]
extern class BlendState{
    b8 alphaToCoverageEnable;
    Array<BlendStateRenderTarget, 8> targets;
    BlendState setRenderTarget(in isize a0, in BlendStateRenderTarget a1);
    b8 usesConstantColor(...)const;
};

[cpp_header("<core/graphics/rhi/pipeline_state.h>"), cpp_name("::NWB::Core::BlendState::RenderTarget"), cpp_flags(self_defaulted, small_value, binary_serializable, brace_init)]
extern class BlendStateRenderTarget{
    BlendFactor srcBlend;
    BlendFactor destBlend;
    BlendOp blendOp;
    BlendFactor srcBlendAlpha;
    BlendFactor destBlendAlpha;
    BlendOp blendOpAlpha;
    ColorMask colorWriteMask;
    b8 blendEnable;
    BlendStateRenderTarget enableBlend();
    BlendStateRenderTarget setSrcBlend(in BlendFactor a0);
    BlendStateRenderTarget setDestBlend(in BlendFactor a0);
    BlendStateRenderTarget setBlendOp(in BlendOp a0);
    BlendStateRenderTarget setSrcBlendAlpha(in BlendFactor a0);
    BlendStateRenderTarget setDestBlendAlpha(in BlendFactor a0);
    BlendStateRenderTarget setBlendOpAlpha(in BlendOp a0);
    BlendStateRenderTarget setColorWriteMask(in ColorMask a0);
    b8 usesConstantColor()const;
};

[cpp_header("<core/graphics/rhi/pipeline_state.h>"), cpp_name("::NWB::Core::DepthStencilState"), cpp_flags(self_defaulted, small_value, binary_serializable, brace_init)]
extern class DepthStencilState{
    b8 depthTestEnable;
    b8 depthWriteEnable;
    ComparisonFunc depthFunc;
    b8 stencilEnable;
    u8 stencilReadMask;
    u8 stencilWriteMask;
    u8 stencilRefValue;
    b8 dynamicStencilRef;
    DepthStencilState disableDepthTest(...);
    DepthStencilState disableDepthWrite(...);
    DepthStencilState enableDepthTest(...);
    DepthStencilState enableDepthWrite(...);
    DepthStencilState setDepthFunc(...);
    DepthStencilState setDepthTestEnable(...);
    DepthStencilState setDepthWriteEnable(...);
};

[cpp_header("<core/graphics/rhi/pipeline_state.h>"), cpp_name("::NWB::Core::RasterState"), cpp_flags(self_defaulted, small_value, binary_serializable, brace_init)]
extern class RasterState{
    RasterFillMode fillMode;
    RasterCullMode cullMode;
    b8 frontCounterClockwise;
    b8 depthClipEnable;
    i32 depthBias;
    f32 depthBiasClamp;
    f32 slopeScaledDepthBias;
    RasterState enableDepthClip(...);
    RasterState setCullBack(...);
    RasterState setCullMode(...);
    RasterState setCullNone(...);
};

[cpp_header("<core/graphics/rhi/pipeline_state.h>"), cpp_name("::NWB::Core::SamplerDesc"), cpp_flags(self_defaulted, binary_serializable, brace_init)]
extern class SamplerDesc{
    Color borderColor;
    f32 maxAnisotropy;
    f32 mipBias;
    b8 minFilter;
    b8 magFilter;
    b8 mipFilter;
    SamplerAddressMode addressU;
    SamplerAddressMode addressV;
    SamplerAddressMode addressW;
    SamplerReductionType reductionType;
    SamplerDesc setAllAddressModes(...);
    SamplerDesc setAllFilters(...);
};

[cpp_header("<core/graphics/rhi/pipeline_state.h>"), cpp_name("::NWB::Core::SamplerHandle"), cpp_flags(self_defaulted, brace_init, equality_switch, map_key)]
extern class SamplerHandle{
    b8 valid(...)const;
    u32 reset(...);
    mut RhiSampler deref(...)const;
};

[cpp_header("<core/graphics/rhi/pipeline_state.h>"), cpp_name("::NWB::Core::ViewportState"), cpp_flags(self_defaulted, binary_serializable, brace_init)]
extern class ViewportState{
    FixedVector<Viewport, 16> viewports;
    FixedVector<Rect, 16> scissorRects;
    ViewportState addScissorRect(...);
    ViewportState addViewport(...);
    ViewportState addViewportAndScissorRect(...);
};


