[cpp_header("<impl/assets/graphics/refraction/push_constants.h>"), cpp_name("NWB_REFRACTION_DENSE_ARGUMENT_OFFSET")]
extern const usize s_RefractionShaderDenseArgumentOffset;
[cpp_header("<impl/assets/graphics/refraction/push_constants.h>"), cpp_name("NWB_REFRACTION_TILE_ARGUMENT_BYTES")]
extern const usize s_RefractionShaderTileArgumentBytes;
[cpp_header("<impl/assets/graphics/refraction/push_constants.h>"), cpp_name("NWB_REFRACTION_GROUP_SIZE")]
extern const u32 s_RefractionShaderGroupSize;

static_assert(size_of<RefractionPushConstants>() == s_RefractionPushConstantsByteSize, "Refraction push constants must match the shader");
static_assert(s_RefractionShaderDenseArgumentOffset == s_RefractionDenseArgumentOffset, "Dense refraction argument offset must match the shader");
static_assert(s_RefractionShaderTileArgumentBytes == s_RefractionTileArgumentBytes, "Refraction tile argument bytes must match the shader");


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CanEnableRefractionHardwareTracing(
    in b8 hardwareTracingEnabled,
    in b8 shadowVisibilityHardwareSupported,
    in b8 traceResourcesPreflighted,
    in b8 backendPipelinePreflighted,
    in b8 rayQuerySupported,
    in b8 hasAccelStructLayout,
    in b8 hasTlas,
    in b8 tlasHandleValid,
    in b8 hasMaterialContextSlotsBuffer
){
    return hardwareTracingEnabled
        && shadowVisibilityHardwareSupported
        && traceResourcesPreflighted
        && backendPipelinePreflighted
        && rayQuerySupported
        && hasAccelStructLayout
        && hasTlas
        && tlasHandleValid
        && hasMaterialContextSlotsBuffer;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
b8 EnsureRefractionProgram(mut RendererShaderSystem shaders, mut Device device, in BindingLayoutHandle layout, in b8 hardware, in b8 diagnostics, in b8 csg, in b8 dense, mut RefractionResolveProgram program){
    if(program.pipeline.valid())
        return true;
    if(program.failed)
        return false;
    const StringView variant = ResolveRefractionVariant(hardware, diagnostics, csg, dense);
    const Name debugName = ResolveRefractionPipelineDebugName(hardware, dense);
    b8 loaded = false;
    if(hardware)
        loaded = shaders.loadShader<ComputeShader, RefractiveSubsystem>(lambda[](in RefractiveSubsystem subsystem) -> AssetRef<ComputeShader>{ return subsystem.refractionResolveHwCs; }, variant, debugName, program.shader);
    else
        loaded = shaders.loadShader<ComputeShader, RefractiveSubsystem>(lambda[](in RefractiveSubsystem subsystem) -> AssetRef<ComputeShader>{ return subsystem.refractionResolveScreenCs; }, variant, debugName, program.shader);
    if(!loaded){
        program.failed = true;
        return false;
    }
    const Expected<ComputePipelineHandle> pipeline = CreateHeapComputePipeline(device, program.shader, layout, hardware);
    if(!pipeline.has_value()){
        program.pipeline.reset();
        program.failed = true;
        return false;
    }
    program.pipeline = pipeline.value();
    LogCreatedRefractionResolvePipeline(hardware, dense);
    return true;
}

[cpp_unwind]
b8 RefractionRenderer::prepareRefractionResources(){
    mut Device device = this.m_system.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    this.m_system.m_rayTracingState.m_refraction.m_refractionUseHardwareTrace = false;
    if(!heap.isInitialized())
        return false;

    if(
        !EnsurePushConstantComputePipeline<RefractiveSubsystem>(
            device,
            this.m_system.m_shaderSystem,
            lambda[](in RefractiveSubsystem s) -> AssetRef<ComputeShader>{ return s.refractionClassifyTilesCs; },
            s_ShaderArchiveDefaultVariant,
            s_RefractionClassifyTilesDebugName,
            sizeof(RefractionPushConstants),
            false,
            this.m_system.m_rayTracingState.m_refraction.m_refractionBindingLayout,
            this.m_system.m_rayTracingState.m_refraction.m_refractionClassifyTilesShader,
            this.m_system.m_rayTracingState.m_refraction.m_refractionClassifyTilesPipeline
        )
        || !EnsurePushConstantComputePipeline<RefractiveSubsystem>(
            device,
            this.m_system.m_shaderSystem,
            lambda[](in RefractiveSubsystem s) -> AssetRef<ComputeShader>{ return s.refractionFinalizeTilesCs; },
            s_ShaderArchiveDefaultVariant,
            s_RefractionFinalizeTilesDebugName,
            sizeof(RefractionPushConstants),
            false,
            this.m_system.m_rayTracingState.m_refraction.m_refractionBindingLayout,
            this.m_system.m_rayTracingState.m_refraction.m_refractionFinalizeTilesShader,
            this.m_system.m_rayTracingState.m_refraction.m_refractionFinalizeTilesPipeline
        )
    )
        return false;

    if(this.m_diagnosticsEnabled && !this.m_statistics.prepareResources())
        return false;
    const b8 csg = this.m_system.m_lightSpaceShadow.m_csg.snapshot.hasCsg;
    mut RtRefractionState state = this.m_system.m_rayTracingState.m_refraction;
    const usize csgIndex = SelectRefractionVariantIndex(csg);
    for(usize dense = 0u; dense < s_RefractionDiagnosticDensityVariantCount; ++dense){
        if(!EnsureRefractionProgram(this.m_system.m_shaderSystem, device, state.m_refractionBindingLayout, false, this.m_diagnosticsEnabled, csg, dense != 0u, state.screenPrograms[dense]))
            return false;
    }
    const b8 hardwareReady = CanEnableRefractionHardwareTracing(
        this.m_system.m_rayTracingState.m_refraction.m_refractionHardwareTracingEnabled,
        this.m_system.shadowVisibilityHardwareSupported(),
        this.m_system.m_shadowVisibilityTraceResourcesPreflighted,
        this.m_system.m_shadowVisibilityBackendPipelinePreflighted,
        this.m_system.m_graphics.queryFeatureSupport(Feature::RayQuery),
        heap.hasAccelStructLayout(),
        this.m_system.m_rayTracingState.sceneBvh.m_tlas.valid(),
        this.m_system.m_rayTracingState.sceneBvh.m_tlasHeapHandle.valid(),
        this.m_system.m_rayTracingState.sceneBvh.m_rayTraceMaterialContextSlotsBuffer.valid()
    );
    if(hardwareReady){
        RayTraceMaterialResources materials(this.m_system.m_graphics, this.m_system.m_rayTracingState.sceneBvh, this.m_system.m_rayTracingState.shadow);
        if(materials.ensureRayTraceMaterialContextSlotsHeapHandle()){
            b8 prepared = true;
            for(usize dense = 0u; dense < s_RefractionDiagnosticDensityVariantCount; ++dense){
                if(this.m_diagnosticsEnabled)
                    prepared = EnsureRefractionProgram(this.m_system.m_shaderSystem, device, state.m_refractionBindingLayout, true, true, csg, dense != 0u, state.diagnosticPrograms[csgIndex][dense]);
                else
                    prepared = EnsureRefractionProgram(this.m_system.m_shaderSystem, device, state.m_refractionBindingLayout, true, false, csg, dense != 0u, state.hardwarePrograms[csgIndex][dense]);
                if(!prepared)
                    break;
            }
            state.m_refractionUseHardwareTrace = prepared;
        }
    }
    return true;
}

RayTracingRefractionGraphResources RefractionRenderer::snapshotRefractionGraphResources(in u32 width, in u32 height, in u32 frameIndex)const{
    RayTracingRefractionGraphResources resources;
    const MeshViewBufferSnapshot view = this.m_system.m_meshSystem.meshViewBufferSnapshot();
    if(!view.bindingValid())
        return resources;
    in RtRefractionState refractionState = this.m_system.m_rayTracingState.m_refraction;
    resources.viewBuffer = view.buffer;
    resources.screenFallbackPipeline = refractionState.screenPrograms[0u].pipeline;
    resources.denseScreenFallbackPipeline = refractionState.screenPrograms[1u].pipeline;
    resources.classifyTilesPipeline = refractionState.m_refractionClassifyTilesPipeline;
    resources.finalizeTilesPipeline = refractionState.m_refractionFinalizeTilesPipeline;
    resources.viewHeapSlot = view.heapHandle.slot();
    resources.usesHardwareTrace = refractionState.m_refractionUseHardwareTrace;
    const b8 csg = this.m_system.m_lightSpaceShadow.m_csg.snapshot.hasCsg;
    const usize csgVariantIndex = SelectRefractionVariantIndex(csg);
    if(!resources.usesHardwareTrace){
        resources.pipeline = resources.screenFallbackPipeline;
        resources.densePipeline = resources.denseScreenFallbackPipeline;
    }
    else if(this.m_diagnosticsEnabled){
        resources.pipeline = refractionState.diagnosticPrograms[csgVariantIndex][0u].pipeline;
        resources.densePipeline = refractionState.diagnosticPrograms[csgVariantIndex][1u].pipeline;
    }
    else{
        resources.pipeline = refractionState.hardwarePrograms[csgVariantIndex][0u].pipeline;
        resources.densePipeline = refractionState.hardwarePrograms[csgVariantIndex][1u].pipeline;
    }
    if(this.m_diagnosticsEnabled){
        const RefractionStatistics metadata = MakeRefractionSnapshotMetadata(
            frameIndex,
            this.m_system.m_graphics.getFrameIndex(),
            width,
            height,
            refractionState.m_refractionHardwareTracingEnabled,
            resources.usesHardwareTrace,
            csg
        );
        resources.statistics = this.m_statistics.snapshot(metadata);
    }
    if(resources.usesHardwareTrace){
        resources.sceneTlas = this.m_system.m_rayTracingState.sceneBvh.m_tlas;
        resources.tlasHeapHandle = this.m_system.m_rayTracingState.sceneBvh.m_tlasHeapHandle;
        resources.materialContextSlotsBuffer = this.m_system.m_rayTracingState.sceneBvh.m_rayTraceMaterialContextSlotsBuffer;
        resources.materialContextSlotsHeapSlot = this.m_system.m_rayTracingState.sceneBvh.m_rayTraceMaterialContextSlotsHeapHandle.slot();
        resources.certifiedInstanceIndex = SelectRefractionCertifiedInstanceIndex(csg, refractionState.m_refractionCertifiedInstanceIndex);
    }
    return resources;
}

RefractionPushConstants MakeRefractionPassPushConstants(in DeferredFrameTargets targets, in RayTracingRefractionGraphResources resources){
    return ResolveRefractionPushConstants(
        targets.width,
        targets.height,
        targets.bindless.slotsBufferDescriptor.slot(),
        resources.materialContextSlotsHeapSlot,
        resources.viewHeapSlot,
        resources.opaqueReflectionSlot,
        resources.refractionEnabled,
        targets.avboit.refractionTileListDescriptor.slot(),
        targets.avboit.refractionTileArgumentsDescriptor.slot(),
        resources.statistics.counterDescriptor.slot(),
        resources.certifiedInstanceIndex
    );
}

[cpp_unwind]
b8 RefractionRenderer::recordRefractionTileClassification(mut CommandList commandList, in DeferredFrameTargets targets, in RayTracingRefractionGraphResources resources)const{
    if(!CanRecordRefractionPass(resources.valid(), targets.bindless.valid(), targets.width, targets.height) || !targets.avboit.refractionTileListDescriptor.valid() || !targets.avboit.refractionTileArgumentsDescriptor.valid())
        return false;
    const auto push = MakeRefractionPassPushConstants(targets, resources);
    ComputeState state;
    state.setPipeline(resources.classifyTilesPipeline.deref());
    commandList.setComputeState(state);
    this.m_system.m_graphics.getDevice().getDescriptorHeap().bindCompute(commandList, resources.classifyTilesPipeline.deref());
    commandList.setPushConstants(push);
    GpuTimingMeasure timing(this.m_system.m_graphics.gpuTiming(), s_TimingScopeRefractionClassifyTiles, this.m_system.m_graphics.getDevice(), commandList);

    commandList.dispatch(ComputeRefractionTileDispatchGroups(targets.width, s_RefractionShaderGroupSize), ComputeRefractionTileDispatchGroups(targets.height, s_RefractionShaderGroupSize), 1u);
    commandList.setBufferState(targets.avboit.refractionTileArguments.deref(), ResourceStates::UnorderedAccess, true);
    commandList.commitBarriers();
    state.setPipeline(resources.finalizeTilesPipeline.deref());
    commandList.setComputeState(state);
    this.m_system.m_graphics.getDevice().getDescriptorHeap().bindCompute(commandList, resources.finalizeTilesPipeline.deref());
    commandList.setPushConstants(push);
    commandList.dispatch(1u, 1u, 1u);
    return true;
}

[cpp_unwind]
b8 RefractionRenderer::recordRefractionResolve(mut CommandList commandList, in DeferredFrameTargets targets, in RayTracingRefractionGraphResources resources)const{
    if(!CanRecordRefractionPass(resources.valid(), targets.bindless.valid(), targets.width, targets.height))
        return false;

    const auto push = MakeRefractionPassPushConstants(targets, resources);
    ComputeState state;
    state.setPipeline(resources.pipeline.deref()).setIndirectParams(targets.avboit.refractionTileArguments.deref());
    commandList.setComputeState(state);
    this.m_system.m_graphics.getDevice().getDescriptorHeap().bindCompute(commandList, resources.pipeline.deref(), resources.tlasHeapHandle);
    commandList.setPushConstants(push);
    {
        GpuTimingMeasure timing(this.m_system.m_graphics.gpuTiming(), s_TimingScopeRefractionResolve, this.m_system.m_graphics.getDevice(), commandList);

        commandList.dispatchIndirect(0u);
        commandList.setTextureState(targets.avboit.refractionResolve.deref(), TextureSubresourceSet(), ResourceStates::UnorderedAccess, true);
        commandList.commitBarriers();
        state.setPipeline(resources.densePipeline.deref());
        commandList.setComputeState(state);
        this.m_system.m_graphics.getDevice().getDescriptorHeap().bindCompute(commandList, resources.densePipeline.deref(), resources.tlasHeapHandle);
        commandList.setPushConstants(push);
        commandList.dispatchIndirect(s_RefractionDenseArgumentOffset);
    }
    return true;
}


