////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/avboit/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<impl/assets/graphics/avboit/constants.h>"), cpp_name("NWB_AVBOIT_PUSH_CONSTANT_BYTE_SIZE")]
extern const u32 s_ShaderAvboitPushConstantByteSize;

[cpp_header("<impl/assets/graphics/avboit/constants.h>"), cpp_name("NWB_AVBOIT_PUSH_FRAME_WORD_OFFSET")]
extern const u32 s_ShaderAvboitPushFrameWordOffset;

[cpp_header("<impl/assets/graphics/avboit/constants.h>"), cpp_name("NWB_AVBOIT_PUSH_VOLUME_WORD_OFFSET")]
extern const u32 s_ShaderAvboitPushVolumeWordOffset;

[cpp_header("<impl/assets/graphics/avboit/constants.h>"), cpp_name("NWB_AVBOIT_PUSH_PARAMS_WORD_OFFSET")]
extern const u32 s_ShaderAvboitPushParamsWordOffset;

[cpp_header("<impl/assets/graphics/avboit/constants.h>"), cpp_name("NWB_AVBOIT_PUSH_HEAP_SLOTS_WORD_OFFSET")]
extern const u32 s_ShaderAvboitPushHeapSlotsWordOffset;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static_assert(size_of<RendererAvboitPushConstants>() == s_ShaderAvboitPushConstantByteSize, "RendererAvboitPushConstants layout must stay stable");
static_assert(offset_of<RendererAvboitPushConstants>(frame) == size_of<u32>() * s_ShaderAvboitPushFrameWordOffset, "RendererAvboit frame push offset drifted");
static_assert(offset_of<RendererAvboitPushConstants>(volume) == size_of<u32>() * s_ShaderAvboitPushVolumeWordOffset, "RendererAvboit volume push offset drifted");
static_assert(offset_of<RendererAvboitPushConstants>(params) == size_of<u32>() * s_ShaderAvboitPushParamsWordOffset, "RendererAvboit params push offset drifted");
static_assert(offset_of<RendererAvboitPushConstants>(heapSlots) == size_of<u32>() * s_ShaderAvboitPushHeapSlotsWordOffset, "RendererAvboit heap-slot push offset drifted");


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[modular]
class AvboitFrameTargets{
    public u32 fullWidth = 0u;
    public u32 fullHeight = 0u;
    public u32 lowWidth = 0u;
    public u32 lowHeight = 0u;
    public u32 virtualSliceCount = 0u;
    public u32 physicalSliceCount = 0u;
    public Format lowRasterFormat = Format::UNKNOWN;
    public Format accumColorFormat = Format::UNKNOWN;
    public Format accumExtinctionFormat = Format::UNKNOWN;
    public Format transmittanceFormat = Format::UNKNOWN;
    public GpuDescriptorHandle coverageBufferDescriptor = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle depthWarpBufferDescriptor = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle controlBufferDescriptor = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle extinctionBufferDescriptor = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle extinctionOverflowBufferDescriptor = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle transmittanceTextureStorageDescriptor = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle refractionTileListDescriptor = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle refractionTileArgumentsDescriptor = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle deferredSlotsBufferDescriptor = GpuDescriptorHandleInvalid();
    public TextureHandle lowRasterTarget;
    public TextureHandle accumColor;
    public TextureHandle accumExtinction;
    public TextureHandle transmittanceTexture;
    public FramebufferHandle lowFramebuffer;
    public FramebufferHandle accumulationFramebuffer;
    public TextureHandle refractionDepth;
    public TextureHandle refractionNormalIor;
    public TextureHandle refractionTintCoverage;
    public TextureHandle refractionInstance;
    public TextureHandle refractionSpecularRoughness;
    public TextureHandle refractionResolve;
    public TextureHandle foregroundAccumColor;
    public TextureHandle foregroundAccumExtinction;
    public FramebufferHandle refractionFramebuffer;
    public BufferHandle coverageBuffer;
    public BufferHandle depthWarpBuffer;
    public BufferHandle controlBuffer;
    public BufferHandle extinctionBuffer;
    public BufferHandle extinctionOverflowBuffer;
    public BufferHandle refractionTileList;
    public BufferHandle refractionTileArguments;

    public b8 valid()const;
}

void ValidateAvboitPushConstantTargets(in AvboitFrameTargets targets){
    if(!targets.deferredSlotsBufferDescriptor.valid() || targets.deferredSlotsBufferDescriptor.descriptorClass() != GpuDescriptorClass::UniformBuffer)
        assert(false);
}

u32 AvboitTargetsFullWidth(in AvboitFrameTargets targets){
    return targets.fullWidth;
}

u32 AvboitTargetsFullHeight(in AvboitFrameTargets targets){
    return targets.fullHeight;
}

u32 AvboitTargetsLowWidth(in AvboitFrameTargets targets){
    return targets.lowWidth;
}

u32 AvboitTargetsLowHeight(in AvboitFrameTargets targets){
    return targets.lowHeight;
}

u32 AvboitTargetsVirtualSliceCount(in AvboitFrameTargets targets){
    return targets.virtualSliceCount;
}

u32 AvboitTargetsPhysicalSliceCount(in AvboitFrameTargets targets){
    return targets.physicalSliceCount;
}

b8 AvboitTargetsHasRefractionFramebuffer(in AvboitFrameTargets targets){
    return targets.refractionFramebuffer.valid();
}

u32 AvboitTargetsDeferredSlotsBufferSlot(in AvboitFrameTargets targets){
    return targets.deferredSlotsBufferDescriptor.slot();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 AreAvboitTargetDimensionsValid(
    in u32 fullWidth,
    in u32 fullHeight,
    in u32 lowWidth,
    in u32 lowHeight,
    in u32 virtualSliceCount,
    in u32 physicalSliceCount
){
    return fullWidth > 0u
        && fullHeight > 0u
        && lowWidth > 0u
        && lowHeight > 0u
        && virtualSliceCount > 0u
        && physicalSliceCount > 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

