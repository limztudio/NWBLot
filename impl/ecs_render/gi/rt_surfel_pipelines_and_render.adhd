    );
}

b8 SurfelGiPipelineSet::ensureSurfelTraceBuildArgsPipeline(){
    return EnsureSurfelComputePipeline(
        lambda[](in GiSubsystem s) -> AssetRef<ComputeShader>{ return s.surfelTraceBuildArgsCs; },
