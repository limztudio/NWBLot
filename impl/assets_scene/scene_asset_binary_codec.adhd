////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_scene/scene_assets.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SceneAssetBinaryCodec{
    private ProjectHeaderBinary makeProjectHeader(in NameHash startSceneHash)const{
        ProjectHeaderBinary header;
        header.startSceneHash = startSceneHash;
        return header;
    }

    private EntityHeaderBinary makeEntityHeader(in u64 componentCount, in NameHash entityNameHash)const{
        EntityHeaderBinary header;
        header.componentCount = componentCount;
        header.entityNameHash = entityNameHash;
        return header;
    }

    private SceneHeaderBinary makeSceneHeader(in u64 subsystemCount, in u64 entityCount, in u64 assetCount)const{
        SceneHeaderBinary header;
        header.subsystemCount = subsystemCount;
        header.entityCount = entityCount;
        header.assetCount = assetCount;
        return header;
    }

    private b8 validateEntityHeader(in EntityHeaderBinary header)const{
        if(header.version == s_EntityVersion)
            return true;

        error("EntityAsset::loadBinary failed: unsupported version {}", header.version);
        return false;
    }

    private b8 validateProjectHeader(in ProjectHeaderBinary header)const{
        if(header.version == s_ProjectVersion)
            return true;

        error("ProjectAsset::loadBinary failed: unsupported version {}", header.version);
        return false;
    }

    private b8 validateSceneHeader(in SceneHeaderBinary header)const{
        if(header.version == s_SceneVersion)
            return true;

        error("SceneAsset::loadBinary failed: unsupported version {}", header.version);
        return false;
    }

    private void collectSortedAssetEntries<TAsset>(
        in HashMap<Name, AssetRef<TAsset>> assets,
        mut Vector<SceneAssetEntryBinary> outEntries
    )const{
        outEntries.clear();
        outEntries.reserve(assets.size());
        for(in auto entry : assets)
            outEntries.push_back(SceneAssetEntryBinary(entry.first.hash(), entry.second.name().hash()));
        SortSequence<SceneAssetEntryBinary>(outEntries, lambda[](in SceneAssetEntryBinary lhs, in SceneAssetEntryBinary rhs) -> b8{
            return LessSceneAssetEntryBinary(lhs, rhs);
        });
    }

    public b8 serializeEntity<TComponent>(in Span<AssetRef<TComponent>> components, in NameHash entityNameHash, mut Vector<u8> outBinary)const{
        static_assert(size_of<EntityHeaderBinary>() == s_EntityHeaderBinaryBytes);
        usize reserveBytes = s_EntityHeaderBinaryBytes;
        if(!AddBinaryRepeatedReserveBytes(reserveBytes, components.size(), s_NameHashBinaryBytes) || !CanStoreValueCount(outBinary, reserveBytes)){
            error("EntityAssetCodec::serialize failed: 'components' payload byte size overflows");
            return false;
        }
        outBinary.clear();
        outBinary.reserve(reserveBytes);
        AppendPOD(outBinary, this.makeEntityHeader(cast<u64>(components.size()), entityNameHash));
        for(in AssetRef<TComponent> component : components)
            AppendPOD(outBinary, component.name().hash());
        return true;
    }

    public b8 serializeProject(in NameHash startSceneHash, mut Vector<u8> outBinary)const{
        const ProjectHeaderBinary header = this.makeProjectHeader(startSceneHash);
        outBinary.clear();
        outBinary.reserve(s_ProjectHeaderBinaryBytes);
        AppendPOD(outBinary, header);
        return true;
    }

    public b8 serializeScene<TSubsystem, TEntity, TAsset>(
        in Span<AssetRef<TSubsystem>> subsystems,
        in Span<AssetRef<TEntity>> entities,
        in HashMap<Name, AssetRef<TAsset>> assets,
        mut Vector<u8> outBinary
    )const{
        Vector<SceneAssetEntryBinary> scratchAssetEntries;
        this.collectSortedAssetEntries(assets, scratchAssetEntries);
        usize reserveBytes = s_SceneHeaderBinaryBytes;
        const b8 canReserve =
            AddBinaryRepeatedReserveBytes(reserveBytes, subsystems.size(), s_NameHashBinaryBytes)
            && AddBinaryRepeatedReserveBytes(reserveBytes, entities.size(), s_NameHashBinaryBytes)
            && AddBinaryRepeatedReserveBytes(reserveBytes, scratchAssetEntries.size(), s_SceneAssetEntryBinaryBytes)
            && CanStoreValueCount(outBinary, reserveBytes)
        ;
        if(!canReserve){
            error("SceneAssetCodec::serialize failed: scene payload byte size overflows");
            return false;
        }
        static_assert(size_of<NameHash>() == s_NameHashBinaryBytes);
        static_assert(size_of<SceneAssetEntryBinary>() == s_SceneAssetEntryBinaryBytes && offset_of<SceneAssetEntryBinary>(nicknameHash) == 0u && offset_of<SceneAssetEntryBinary>(assetHash) == 64u);
        outBinary.clear();
        outBinary.reserve(reserveBytes);
        AppendPOD(outBinary, this.makeSceneHeader(cast<u64>(subsystems.size()), cast<u64>(entities.size()), cast<u64>(scratchAssetEntries.size())));
        for(in AssetRef<TSubsystem> subsystem : subsystems)
            AppendPOD(outBinary, subsystem.name().hash());
        for(in AssetRef<TEntity> entity : entities)
            AppendPOD(outBinary, entity.name().hash());
        return AppendBinaryVectorPayload(outBinary, scratchAssetEntries).has_value();
    }

    public Expected<NameHash> deserializeProject(in Span<u8> binary)const{
        usize cursor = 0u;
        const Expected<ProjectHeaderBinary> headerResult = ReadPOD<ProjectHeaderBinary>(binary, cursor);
        if(!headerResult.has_value()){
            error("ProjectAsset::loadBinary failed: malformed header");
            return MakeUnexpected(Failure());
        }
        const ProjectHeaderBinary header = headerResult.value();
        if(header.magic != s_ProjectMagic){
            error("ProjectAsset::loadBinary failed: invalid project asset format; recook required");
            return MakeUnexpected(Failure());
        }
        if(!this.validateProjectHeader(header))
            return MakeUnexpected(Failure());
        if(cursor != binary.size()){
            error("ProjectAsset::loadBinary failed: trailing bytes detected");
            return MakeUnexpected(Failure());
        }
        return header.startSceneHash;
    }

    public b8 deserializeEntity<TComponent>(
        in Span<u8> binary,
        mut Vector<AssetRef<TComponent>> outComponents,
        mut Name outEntityName
    )const{
        static_assert(size_of<NameHash>() == s_NameHashBinaryBytes);
        usize cursor = 0u;
        const Expected<EntityHeaderBinary> headerResult = ReadPOD<EntityHeaderBinary>(binary, cursor);
        if(!headerResult.has_value()){
            error("EntityAsset::loadBinary failed: malformed header");
            return false;
        }
        const EntityHeaderBinary header = headerResult.value();
        if(header.magic != s_EntityMagic){
            error("EntityAsset::loadBinary failed: invalid entity asset format; recook required");
            return false;
        }
        if(!this.validateEntityHeader(header))
            return false;
        if(header.componentCount > cast<u64>(usize.max / s_NameHashBinaryBytes)){
            error("EntityAsset::loadBinary failed: 'components' payload byte size overflows");
            return false;
        }
        const usize componentCount = cast<usize>(header.componentCount);
        const usize componentBytes = componentCount * s_NameHashBinaryBytes;
        if(!CanReadBytes(binary, cursor, componentBytes) || !CanStoreValueCount(outComponents, componentCount)){
            error("EntityAsset::loadBinary failed: malformed 'components' payload");
            return false;
        }
        if(cursor + componentBytes != binary.size()){
            error("EntityAsset::loadBinary failed: trailing bytes detected");
            return false;
        }
        outComponents.clear();
        outComponents.reserve(componentCount);
        for(usize i = 0u; i < componentCount; ++i){
            const Expected<NameHash> itemResult = ReadPOD<NameHash>(binary, cursor);
            if(!itemResult.has_value()){
                error("EntityAsset::loadBinary failed: malformed 'components' payload");
                return false;
            }
            AssetRef<TComponent> ref;
            ref.virtualPath = Name(itemResult.value());
            outComponents.push_back(ref);
        }
        if(header.entityNameHash == s_NameNone.hash())
            outEntityName = s_NameNone;
        else
            outEntityName = Name(header.entityNameHash);
        return true;
    }

    public b8 deserializeScene<TSubsystem, TEntity, TAsset>(
        in Span<u8> binary,
        mut Vector<AssetRef<TSubsystem>> outSubsystems,
        mut Vector<AssetRef<TEntity>> outEntities,
        mut HashMap<Name, AssetRef<TAsset>> outAssets
    )const{
        static_assert(size_of<NameHash>() == s_NameHashBinaryBytes);
        static_assert(size_of<SceneAssetEntryBinary>() == s_SceneAssetEntryBinaryBytes && offset_of<SceneAssetEntryBinary>(nicknameHash) == 0u && offset_of<SceneAssetEntryBinary>(assetHash) == 64u);
        usize cursor = 0u;
        const Expected<SceneHeaderBinary> headerResult = ReadPOD<SceneHeaderBinary>(binary, cursor);
        if(!headerResult.has_value()){
            error("SceneAsset::loadBinary failed: malformed header");
            return false;
        }
        const SceneHeaderBinary header = headerResult.value();
        if(header.magic != s_SceneMagic){
            error("SceneAsset::loadBinary failed: invalid scene asset format; recook required");
            return false;
        }
        if(!this.validateSceneHeader(header))
            return false;
        if(header.subsystemCount > cast<u64>(usize.max / s_NameHashBinaryBytes)){
            error("SceneAsset::loadBinary failed: 'subsystems' payload byte size overflows");
            return false;
        }
        const usize subsystemCount = cast<usize>(header.subsystemCount);
        const usize subsystemBytes = subsystemCount * s_NameHashBinaryBytes;
        if(!CanReadBytes(binary, cursor, subsystemBytes) || !CanStoreValueCount(outSubsystems, subsystemCount)){
            error("SceneAsset::loadBinary failed: malformed 'subsystems' payload");
            return false;
        }
        if(header.entityCount > cast<u64>(usize.max / s_NameHashBinaryBytes)){
            error("SceneAsset::loadBinary failed: 'entities' payload byte size overflows");
            return false;
        }
        const usize entityCount = cast<usize>(header.entityCount);
        const usize entityBytes = entityCount * s_NameHashBinaryBytes;
        if(!CanReadBytes(binary, cursor + subsystemBytes, entityBytes) || !CanStoreValueCount(outEntities, entityCount)){
            error("SceneAsset::loadBinary failed: malformed 'entities' payload");
            return false;
        }
        if(header.assetCount > cast<u64>(usize.max / s_SceneAssetEntryBinaryBytes)){
            error("SceneAsset::loadBinary failed: 'assets' payload byte size overflows");
            return false;
        }
        const usize assetCount = cast<usize>(header.assetCount);
        const usize assetBytes = assetCount * s_SceneAssetEntryBinaryBytes;
        if(!CanReadBytes(binary, cursor + subsystemBytes + entityBytes, assetBytes)){
            error("SceneAsset::loadBinary failed: malformed 'assets' payload");
            return false;
        }
        if(cursor + subsystemBytes + entityBytes + assetBytes != binary.size()){
            error("SceneAsset::loadBinary failed: trailing bytes detected");
            return false;
        }

        outSubsystems.clear();
        outSubsystems.reserve(subsystemCount);
        for(usize i = 0u; i < subsystemCount; ++i){
            const Expected<NameHash> itemResult = ReadPOD<NameHash>(binary, cursor);
            if(!itemResult.has_value()){
                error("SceneAsset::loadBinary failed: malformed 'subsystems' payload");
                return false;
            }
            AssetRef<TSubsystem> ref;
            ref.virtualPath = Name(itemResult.value());
            outSubsystems.push_back(ref);
        }

        outEntities.clear();
        outEntities.reserve(entityCount);
        for(usize i = 0u; i < entityCount; ++i){
            const Expected<NameHash> itemResult = ReadPOD<NameHash>(binary, cursor);
            if(!itemResult.has_value()){
                error("SceneAsset::loadBinary failed: malformed 'entities' payload");
                return false;
            }
            AssetRef<TEntity> ref;
            ref.virtualPath = Name(itemResult.value());
            outEntities.push_back(ref);
        }

        outAssets.clear();
        outAssets.reserve(assetCount);
        for(usize i = 0u; i < assetCount; ++i){
            const Expected<SceneAssetEntryBinary> entryResult = ReadPOD<SceneAssetEntryBinary>(binary, cursor);
            if(!entryResult.has_value()){
                error("SceneAsset::loadBinary failed: malformed 'assets' payload");
                return false;
            }
            const SceneAssetEntryBinary entry = entryResult.value();
            const Name nickname(entry.nicknameHash);
            AssetRef<TAsset> ref;
            ref.virtualPath = Name(entry.assetHash);
            if(!ValidateSceneAssetBinaryEntry(nickname, ref.valid(), i))
                return false;
            if(!outAssets.try_emplace(nickname, ref).second){
                error("SceneAsset::loadBinary failed: duplicate asset nickname at index {}", i);
                return false;
            }
        }
        return true;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

