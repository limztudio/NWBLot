#include <impl/assets_mesh/asset.adhd>
#include <impl/assets_mesh/meshlet_ref_decoding.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Flat positionStream-space triangle index buffer from meshlet streams.
Expected<Vector<u32>> BuildMeshletTriangleIndices(
    in Span<MeshletDesc> meshlets,
    in Span<MeshletLocalVertexRef> localVertexRefs,
    in Span<u8> positionRefDeltas,
    in Span<u8> primitiveIndices,
    in usize positionCount
){
    Vector<u32> outIndices;
    outIndices.resize(primitiveIndices.size());
    if(!DecodeMeshletTriangleIndicesInto(meshlets, localVertexRefs, positionRefDeltas, primitiveIndices, positionCount, outIndices))
        return MakeUnexpected(Failure());
    return outIndices;
}

Expected<Vector<u32>> BuildMeshletTriangleIndices(in Mesh payload){
    return BuildMeshletTriangleIndices(
        payload.meshlets(),
        payload.meshletLocalVertexRefs(),
        payload.meshletPositionRefDeltas(),
        payload.meshletPrimitiveIndices(),
        payload.positionStream().size()
    );
}


