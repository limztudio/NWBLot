[cpp_header("<core/metascript/attribute_parser.h>"), cpp_name("::NWB::Core::Metascript::AttributeParser"), cpp_flags(small_value, binary_serializable)]
extern class MetascriptAttributeParser;

[cpp_header("<core/metascript/attribute_parser.h>"), cpp_name("::NWB::Core::Metascript::ParsedAttribute")]
extern class MetascriptParsedAttribute{
    StringView name;
    u32 line;
    u32 column;
};

[cpp_header("<core/metascript/attribute_parser.h>"), cpp_name("::NWB::Core::Metascript::ParsedAttributeArg"), cpp_flags(binary_serializable, brace_init)]
extern class MetascriptParsedAttributeArg{
    StringView text;
    MetascriptTokenType kind;
};


