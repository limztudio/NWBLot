#ifndef NWB_GRAPHICS_SHADOW_OCCLUSION_SLANGI
#define NWB_GRAPHICS_SHADOW_OCCLUSION_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "binding_slots.h"

// The G-buffer reads and (on Backend C) the shared TLAS come from the global descriptor heap. Backend A retains the
// local set-0 TLAS descriptor below, while both backends select the target-generation G-buffer images by push slot.
#include "../bindless/bindless_heap.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#if !(defined(NWB_BINDLESS_TLAS) && NWB_BINDLESS_TLAS)
[[vk::binding(NWB_SHADOW_RT_BINDING_TLAS, NWB_SHADOW_RT_SET)]]
RaytracingAccelerationStructure g_NwbShadowTlas;
#endif

[[vk::binding(NWB_SHADOW_RT_BINDING_VISIBILITY_OUTPUT, NWB_SHADOW_RT_SET)]]
RWTexture2DArray<float4> g_NwbShadowVisibility;

// (binding 7, the per-instance occluder material table, is intentionally absent here: the hardware opaque fast
// path commits the first FORCE_OPAQUE hit and loads no per-instance material -- see binding_slots.h.)

// The hardware opaque path commits its first FORCE_OPAQUE hit for a binary blocked/lit result and reads no geometry.
// Colored software shadows fetch transparent-occluder geometry through the global descriptor heap.


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


