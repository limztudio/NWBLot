#include <impl/assets_shader/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[asset("shader")]
interface IShader{
    StringView entryPoint()const;
    in Vector<u8> bytecode()const;
    b8 loadBinary(in Span<u8> binary);
}

[arena, asset("vertex_shader")]
class VertexShader : IShader{
    private usize m_entryPointOffset = 0u;
    private usize m_entryPointLength = 0u;
    private Vector<u8> m_bytecode;

    public StringView entryPoint()const override{ return ShaderEntryPointView(Span<u8>(this.m_bytecode), this.m_entryPointOffset, this.m_entryPointLength); }
    public in Vector<u8> bytecode()const override{ return this.m_bytecode; }
    public b8 loadBinary(in Span<u8> binary)override;
}

