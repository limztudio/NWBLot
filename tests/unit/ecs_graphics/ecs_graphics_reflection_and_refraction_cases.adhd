void VerifyReflectionSettings_ReflectionHardwareWorkRequiresAnEnabledRouteAndPositiveRayBudget(){
    ReflectionFrameSnapshot snapshot = ReflectionFrameSnapshot();
    snapshot.parameters.hardwareEnabled = 1u;
    snapshot.parameters.maxHardwareRays = 0u;
    EXPECT_FALSE(snapshot.hasHardwareWork());
    snapshot.parameters.maxHardwareRays = 1u;
    EXPECT_TRUE(snapshot.hasHardwareWork());
    snapshot.parameters.hardwareEnabled = 0u;
    EXPECT_FALSE(snapshot.hasHardwareWork());
}

void VerifyReflectionStatistics_RingSkipsWhenThreeReservationsAreOutstanding(){
    ReflectionStatsContext context = ReflectionStatsContext();
    ASSERT_TRUE(context.valid());
    const StatisticsReservationKey first = context.reserve(MakeReflectionStatisticsMetadata());
    const StatisticsReservationKey second = context.reserve(MakeReflectionStatisticsMetadata());
    const StatisticsReservationKey third = context.reserve(MakeReflectionStatisticsMetadata());
    ASSERT_TRUE(first.valid());
    ASSERT_TRUE(second.valid());
    ASSERT_TRUE(third.valid());
    EXPECT_NE(first.slot, second.slot);
    EXPECT_NE(second.slot, third.slot);
    EXPECT_FALSE(context.reserve(MakeReflectionStatisticsMetadata()).valid());
}

void VerifyReflectionStatistics_DiscardedReservationCanBeReusedWithoutStaleCallbackMutation(){
    ReflectionStatsContext context = ReflectionStatsContext();
    ASSERT_TRUE(context.valid());
    const StatisticsReservationKey previous = context.reserve(MakeReflectionStatisticsMetadata());
    context.discard(previous);
    const StatisticsReservationKey current = context.reserve(MakeReflectionStatisticsMetadataAt(10u));
    ASSERT_EQ(previous.slot, current.slot);
    ASSERT_GT(current.sequence, previous.sequence);
    context.discard(previous);
    context.accept(previous, Token(), true);
    context.accept(current, Token(21u), false);
    const ReflectionPendingEntry pending = context.pending(current.slot);
    ASSERT_TRUE(pending.has_value());
    EXPECT_EQ(pending.value().key.sequence, current.sequence);
    EXPECT_EQ(pending.value().token.value, 21u);
}

void VerifyReflectionStatistics_PublishesFrozenMetadataAndNonzeroCountersOnlyAtCompletion(){
    Array<b8, 2> variants = Array<b8, 2>();
    variants[0u] = false;
    variants[1u] = true;
    const ReflectionCounterArray counters = MakeSampleReflectionCounters();
    for(in b8 csgHardwareEnabled : variants){
        ReflectionStatsContext context = ReflectionStatsContext();
        ASSERT_TRUE(context.valid());
        ReflectionStatistics metadata = MakeReflectionStatisticsMetadata();
        metadata.csgHardwareEnabled = csgHardwareEnabled;
        const StatisticsReservationKey key = context.reserve(metadata);
        metadata.frameIndex = 500u;
        metadata.width = 1u;
        metadata.csgHardwareEnabled = !csgHardwareEnabled;
        context.accept(key, Token(), true);
        context.discard(key);
        EXPECT_FALSE(context.tryGetLatestStatistics().has_value());
        context.complete(key, Token(), counters);
        const Expected<ReflectionStatistics> statistics = context.tryGetLatestStatistics();
        ASSERT_TRUE(statistics.has_value());

        EXPECT_EQ(statistics.value().frameIndex, 9u);
        EXPECT_EQ(statistics.value().width, 320u);
        EXPECT_EQ(statistics.value().csgHardwareEnabled, csgHardwareEnabled);
        EXPECT_EQ(statistics.value().queryBudgetUnits, 98u);
        u32 expectedQueries = 98u;
        if(csgHardwareEnabled)
            expectedQueries = 31u;
        EXPECT_EQ(statistics.value().physicalQueries, expectedQueries);
        EXPECT_EQ(statistics.value().candidates, 100u);
    }
}

void VerifyReflectionStatistics_FeedbackEpochSurvivesAcceptedInputMutation(){
    ReflectionStatsContext context = ReflectionStatsContext();
    ASSERT_TRUE(context.valid());
    ReflectionStatistics metadata = MakeReflectionStatisticsMetadata();
    metadata.feedbackRequested = true;
    metadata.feedbackSequence = 12u;
    metadata.schedulingCounterValid = true;
    const StatisticsReservationKey key = context.reserve(metadata);
    ReflectionFeedbackOutcome feedback = ReflectionFeedbackOutcome();
    feedback.epoch = 4u;
    feedback.startGraphicsFrame = 90u;
    feedback.probeIndex = 7u;
    feedback.eligible = true;
    feedback.reused = true;
    context.acceptWithFeedback(key, Token(), true, feedback);
    feedback.epoch = 999u;
    const ReflectionCounterArray counters = ReflectionCounterArray();
    context.complete(key, Token(), counters);
    const Expected<ReflectionStatistics> statistics = context.tryGetLatestStatistics();
    ASSERT_TRUE(statistics.has_value());
    EXPECT_EQ(statistics.value().feedbackEpoch, 4u);
}

void VerifyReflectionStatistics_OlderCompletionsCannotReplaceNewerPublishedWork(){
    ReflectionStatsContext context = ReflectionStatsContext();
    ASSERT_TRUE(context.valid());
    const StatisticsReservationKey older = context.reserve(MakeReflectionStatisticsMetadataAt(10u));
    const StatisticsReservationKey newer = context.reserve(MakeReflectionStatisticsMetadataAt(11u));
    context.accept(older, Token(20u), true);
    context.accept(newer, Token(21u), false);
    const ReflectionCounterArray counters = ReflectionCounterArray();
    context.complete(newer, Token(21u), counters);
    context.complete(older, Token(20u), counters);
    const Expected<ReflectionStatistics> statistics = context.tryGetLatestStatistics();
    ASSERT_TRUE(statistics.has_value());
    EXPECT_EQ(statistics.value().sequence, newer.sequence);
    EXPECT_EQ(statistics.value().frameIndex, 11u);
    EXPECT_FALSE(statistics.value().hardwareReady);
    EXPECT_EQ(context.reserve(MakeReflectionStatisticsMetadata()).slot, older.slot);
}

void VerifyReflectionStatistics_CompletionRequiresExactAcceptedPhysicalToken(){
    ReflectionStatsContext context = ReflectionStatsContext();
    ASSERT_TRUE(context.valid());
    const StatisticsReservationKey key = context.reserve(MakeReflectionStatisticsMetadata());
    context.accept(key, Token(), true);
    const ReflectionCounterArray counters = ReflectionCounterArray();
    QueueSubmissionToken wrong = Token();
    wrong.physicalQueueIndex = 1u;
    context.complete(key, wrong, counters);
    wrong = Token();
    wrong.deviceGeneration = 8u;
    context.complete(key, wrong, counters);
    context.complete(key, Token(19u), counters);
    EXPECT_FALSE(context.tryGetLatestStatistics().has_value());
    context.complete(key, Token(), counters);
    const Expected<ReflectionStatistics> statistics = context.tryGetLatestStatistics();
    ASSERT_TRUE(statistics.has_value());
}

void VerifyReflectionStatistics_ResetRejectsOldCallbacksAndClearsPublication(){
    ReflectionStatsContext context = ReflectionStatsContext();
    ASSERT_TRUE(context.valid());
    const StatisticsReservationKey previous = context.reserve(MakeReflectionStatisticsMetadata());
    context.accept(previous, Token(), true);
    const ReflectionCounterArray counters = ReflectionCounterArray();
    context.complete(previous, Token(), counters);
    context.reset(8u);
    EXPECT_FALSE(context.tryGetLatestStatistics().has_value());
    const StatisticsReservationKey current = context.reserve(MakeReflectionStatisticsMetadataAt(12u));
    EXPECT_GT(current.generation, previous.generation);
    context.accept(previous, Token(), true);
    context.discard(previous);
    context.complete(previous, Token(), counters);
    QueueSubmissionToken next = Token(1u);
    next.deviceGeneration = 8u;
    context.accept(current, next, false);
    context.complete(current, next, counters);
    const Expected<ReflectionStatistics> statistics = context.tryGetLatestStatistics();
    ASSERT_TRUE(statistics.has_value());
    EXPECT_EQ(statistics.value().frameIndex, 12u);
    EXPECT_EQ(statistics.value().acceptedToken.deviceGeneration, 8u);
}

void VerifyReflectionStatistics_FailedMappingRetiresSlotWithoutPublishingZeros(){
    ReflectionStatsContext context = ReflectionStatsContext();
    ASSERT_TRUE(context.valid());
    const StatisticsReservationKey key = context.reserve(MakeReflectionStatisticsMetadata());
    context.accept(key, Token(), true);
    context.completeEmpty(key, Token());
    EXPECT_FALSE(context.tryGetLatestStatistics().has_value());
    EXPECT_EQ(context.reserve(MakeReflectionStatisticsMetadata()).slot, key.slot);
}

void VerifyReflectionStatistics_InvalidAcceptedTokenQuarantinesSlotUntilReset(){
    ReflectionStatsContext context = ReflectionStatsContext();
    ASSERT_TRUE(context.valid());
    const StatisticsReservationKey key = context.reserve(MakeReflectionStatisticsMetadata());
    context.accept(key, QueueSubmissionToken(), true);
    context.discard(key);
    EXPECT_FALSE(context.pending(key.slot).has_value());
    EXPECT_FALSE(context.pending(s_StatisticsReadbackSlotCount).has_value());
    EXPECT_FALSE(context.pending(u32.max).has_value());
    EXPECT_NE(context.reserve(MakeReflectionStatisticsMetadata()).slot, key.slot);
    context.reset(7u);
    EXPECT_EQ(context.reserve(MakeReflectionStatisticsMetadata()).slot, key.slot);
}

void VerifyReflectionStatistics_MovingLeaseTransfersOwnershipAndReclaimsAssignmentDestination(){
    ReflectionStatsContext context = ReflectionStatsContext();
    ASSERT_TRUE(context.valid());
    native(mut context){
        Impl::ReflectionStatisticsReservation first(context.inner.control, MakeReflectionStatisticsMetadata());
        const u32 firstSlot = first.slotIndex();
        Impl::ReflectionStatisticsReservation second(Move(first));
        EXPECT_FALSE(first.valid());
        EXPECT_EQ(second.slotIndex(), firstSlot);
        Impl::ReflectionStatisticsReservation third(context.inner.control, MakeReflectionStatisticsMetadata());
        const u32 replacedSlot = third.slotIndex();
        third = Move(second);
        EXPECT_FALSE(second.valid());
        EXPECT_EQ(third.slotIndex(), firstSlot);
        EXPECT_EQ(context.reserve(MakeReflectionStatisticsMetadata()).slot, replacedSlot);
    }
}

void VerifyReflectionStatistics_AcceptedLeaseRemainsInFlightAfterPayloadDestruction(){
    ReflectionStatsContext context = ReflectionStatsContext();
    ASSERT_TRUE(context.valid());
    u32 index = 0u;
    native(mut context, mut index){
        Impl::ReflectionStatisticsReservation lease(context.inner.control, MakeReflectionStatisticsMetadata());
        index = lease.slotIndex();
        lease.acceptReservation(Token(), true);
    }
    EXPECT_NE(context.reserve(MakeReflectionStatisticsMetadata()).slot, index);
    const ReflectionPendingEntry pending = context.pending(index);
    ASSERT_TRUE(pending.has_value());
    const ReflectionCounterArray counters = ReflectionCounterArray();
    context.complete(pending.value().key, pending.value().token, counters);
    EXPECT_EQ(context.reserve(MakeReflectionStatisticsMetadata()).slot, index);
}

void VerifyReflectionStatistics_RejectedGraphRegistrationAndGraphResetReleaseUnacceptedLeases(){
    ReflectionStatsContext context = ReflectionStatsContext();
    ASSERT_TRUE(context.valid());
    native(mut context){
        using LeaseTask = ReflectionStatisticsTestHelpers::ReservationLeaseTask<Impl::ReflectionStatisticsReservation>;
        Core::GpuTaskGraph graph(context.inner.arena);
        EXPECT_FALSE(graph.addTask<LeaseTask>(Core::GpuTaskDesc{}, LeaseTask::Payload{ Impl::ReflectionStatisticsReservation(context.inner.control, MakeReflectionStatisticsMetadata()) }).has_value());
        EXPECT_EQ(context.reserve(MakeReflectionStatisticsMetadata()).slot, 0u);
        context.reset(1u);
        {
            const auto gpuTaskAdmission = graph.addTask<LeaseTask>(MakeReflectionStatisticsTaskDesc(), LeaseTask::Payload{ Impl::ReflectionStatisticsReservation(context.inner.control, MakeReflectionStatisticsMetadata()) });
            ASSERT_TRUE(gpuTaskAdmission);
            ASSERT_TRUE(gpuTaskAdmission->valid());
        }
        graph.reset();
        EXPECT_EQ(context.reserve(MakeReflectionStatisticsMetadata()).slot, 0u);
    }
}

void VerifyReflectionStatistics_PayloadDestructionReclaimsLeaseWithoutDiscardCallback(){
