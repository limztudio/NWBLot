[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/raytrace/graph_snapshots.adhd.h>
#include <impl/ecs_render/refraction/statistics_readback.adhd.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererRayTracingSystem;
struct DeferredFrameTargets;


class RefractionRenderer final : NoCopy{
public:
    RefractionRenderer(RendererRayTracingSystem& system, Core::Alloc::GlobalArena& arena, Core::GraphicsRuntime& graphics)noexcept
        : m_system(system)
        , m_statistics(arena, graphics)
    {}


public:
    void setRefractionDiagnosticsEnabled(const b8 enabled)noexcept{ m_diagnosticsEnabled = enabled; }
    void pollRefractionStatistics(){ m_statistics.pollCompleted(); }
    [[nodiscard]] Expected<RefractionStatistics> tryGetLatestRefractionStatistics()const noexcept{ return m_statistics.latestStatistics(); }
    void invalidateResources()noexcept{ m_statistics.invalidateResources(); }
    [[nodiscard]] b8 prepareRefractionResources();
    [[nodiscard]] RayTracingRefractionGraphResources snapshotRefractionGraphResources(u32 width, u32 height, u32 frameIndex)const noexcept;
    [[nodiscard]] b8 recordRefractionTileClassification(Core::CommandList& commandList, const DeferredFrameTargets& targets, const RayTracingRefractionGraphResources& resources)const;
    [[nodiscard]] b8 recordRefractionResolve(Core::CommandList& commandList, const DeferredFrameTargets& targets, const RayTracingRefractionGraphResources& resources)const;


private:
    RendererRayTracingSystem& m_system;
    RefractionStatisticsReadback m_statistics;
    b8 m_diagnosticsEnabled = false;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CanRecordRefractionPass(in b8 resourcesValid, in b8 bindlessValid, in u32 width, in u32 height){
    return resourcesValid && bindlessValid && width != 0u && height != 0u;
}

u32 ComputeRefractionTileDispatchGroups(in u32 dimension, in u32 groupSize){
    return DivideUpWrappingU32(dimension, groupSize);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

