using FontBuilderUtility::ComputeBakePixelCapacity;
using FontBuilderUtility::PackGlyphs;
inline constexpr auto s_BreakOnFatal = Core::Common::LoggerBreakPolicy::BreakOnFatal;
inline constexpr auto s_ReportOnly = Core::Common::LoggerBreakPolicy::ReportOnly;


