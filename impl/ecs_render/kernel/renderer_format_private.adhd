[[nodiscard]] FOUNDATION_INLINE Core::Format::Enum SelectSupportedFormat(Core::Device& device, const Span<const Core::Format::Enum> candidates, const Core::FormatSupport::Mask requiredSupport)noexcept{
    for(const Core::Format::Enum format : candidates){
        if((device.queryFormatSupport(format) & requiredSupport) == requiredSupport)
            return format;
    }

    return Core::Format::UNKNOWN;
}

[[nodiscard]] FOUNDATION_INLINE b8 CreateClampSampler(Core::Device& device, const b8 linearFiltering, Core::SamplerHandle& sampler){
    if(sampler)
        return true;

    Core::SamplerDesc samplerDesc;
    samplerDesc.setAllFilters(linearFiltering).setAllAddressModes(Core::SamplerAddressMode::Clamp);
    auto samplerResult = device.createSampler(samplerDesc);
    if(samplerResult){
        sampler = Move(*samplerResult);
        return true;
    }
    sampler.reset();
    return false;
}


