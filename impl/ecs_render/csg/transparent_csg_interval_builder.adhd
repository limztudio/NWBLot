#include <impl/ecs_render/csg/transparent_interval_payloads.adhd>
#include <impl/ecs_render/csg/task_graph_transparent_interval_tasks.adhd>
#include <impl/ecs_render/avboit/task_graph_occupancy_tasks.adhd>
#include <impl/ecs_render/avboit/avboit_system.adhd>
#include <impl/ecs_render/csg/csg_system.adhd>
#include <impl/ecs_render/kernel/task_graph_clear_timing.adhd>
#include <impl/ecs_render/material/material_system.adhd>
#include <impl/ecs_render/csg/graph_types.adhd>
#include <impl/ecs_render/deferred/import_types.adhd>
#include <impl/ecs_render/kernel/graphics_prefix_timing_ticket.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TransparentCsgIntervalProducerInputs{
    public mut DeferredFrameTargets targets;
    public in CsgFrameState csgFrameState;
    public in MeshFrameBindingSnapshot frameBindings;
    public in CsgGraphResourceSnapshot csgResources;
    public in MeshViewGpuData meshViewState;
    public in DeferredGraphResourceImportResult resources;
    public GpuTaskId prefixTask;
    public b8 hasTransparentRenderers;

    public TransparentCsgIntervalProducerInputs(
        mut DeferredFrameTargets targets,
        in CsgFrameState csgFrameState,
        in MeshFrameBindingSnapshot frameBindings,
        in CsgGraphResourceSnapshot csgResources,
        in MeshViewGpuData meshViewState,
        in DeferredGraphResourceImportResult resources,
        in GpuTaskId prefixTask,
        in b8 hasTransparentRenderers
    ){
        this.targets = targets;
        this.csgFrameState = csgFrameState;
        this.frameBindings = frameBindings;
        this.csgResources = csgResources;
        this.meshViewState = meshViewState;
        this.resources = resources;
        this.prefixTask = prefixTask;
        this.hasTransparentRenderers = hasTransparentRenderers;
    }
}


[modular]
class TransparentCsgIntervalBuilder : NoCopy{
    private mut GpuTaskGraph m_graph;
    private mut RendererMaterialSystem m_materialSystem;
    private mut RendererCsgSystem m_csgSystem;
    private mut RendererAvboitSystem m_avboitSystem;

    public TransparentCsgIntervalBuilder(
        mut GpuTaskGraph graph,
        mut RendererMaterialSystem materialSystem,
        mut RendererCsgSystem csgSystem,
        mut RendererAvboitSystem avboitSystem
    ){
        this.m_graph = graph;
        this.m_materialSystem = materialSystem;
        this.m_csgSystem = csgSystem;
        this.m_avboitSystem = avboitSystem;
    }

    public Expected<TransparentCsgIntervalProducerResult> declare(
        in TransparentCsgIntervalProducerInputs inputs,
        mut AvboitPreGraphTaskPayload avboitPrePayload,
        mut TransparentCsgIntervalRecordInputs receiverSpanPayload,
        mut TransparentCsgIntervalRecordInputs intervalCombinePayload,
        mut GraphClearTimingRecordState intervalClearTimingState
    );
}


