    public b8 isHullGeometryValid(in HullGeometryId id)const{
        return id.valid()
            && id.worldIndex == this.m_worldIndex
            && id.index < this.m_hullShapes.size()
            && id.index < this.m_hullGenerations.size()
            && id.index < this.m_hullOwnedByUser.size()
            && this.m_hullGenerations[id.index] == id.generation
            && this.m_hullOwnedByUser[id.index] != 0u
        ;
    }

    public Expected<HullGeometryId> createHullGeometry(in HullShape hull){
        if(!this.validateHullShape(hull))
            return MakeUnexpected(Failure());
        const u32 slot = this.allocateHullShapeWithOwnership(hull, true);
        HullGeometryId id;
        id.index = slot;
        id.generation = this.m_hullGenerations[slot];
        id.worldIndex = this.m_worldIndex;
        return id;
    }

    public b8 destroyHullGeometry(in HullGeometryId id){
        if(!this.isHullGeometryValid(id))
            return false;
        this.m_hullOwnedByUser[id.index] = 0u;
        ++this.m_hullPoolVersion;
        if(this.m_hullRefCounts[id.index] == 0u)
            this.recycleHullSlot(id.index);
        return true;
    }

    public Expected<HullShape> getHullGeometry(in HullGeometryId id)const{
        if(!this.isHullGeometryValid(id))
            return MakeUnexpected(Failure());
        return this.m_hullShapes[id.index];
    }

    public b8 isMeshGeometryValid(in MeshGeometryId id)const{
        return id.valid()
            && id.worldIndex == this.m_worldIndex
            && id.index < this.m_meshShapes.size()
            && id.index < this.m_meshGenerations.size()
            && id.index < this.m_meshOwnedByUser.size()
            && this.m_meshGenerations[id.index] == id.generation
            && this.m_meshOwnedByUser[id.index] != 0u
        ;
    }

    public Expected<MeshGeometryId> createMeshGeometry(in MeshShape mesh){
        if(mesh.triangles.empty() || mesh.nodes.empty() || !IsFinite(VectorSingle(mesh.radius())) || mesh.radius() < 0.0f)
            return MakeUnexpected(Failure());
        const u32 slot = this.allocateMeshShapeWithOwnership(mesh, true);
        MeshGeometryId id;
        id.index = slot;
        id.generation = this.m_meshGenerations[slot];
        id.worldIndex = this.m_worldIndex;
        return id;
    }

    public b8 destroyMeshGeometry(in MeshGeometryId id){
        if(!this.isMeshGeometryValid(id))
            return false;
        this.m_meshOwnedByUser[id.index] = 0u;
        ++this.m_meshPoolVersion;
        if(this.m_meshRefCounts[id.index] == 0u)
            this.recycleMeshSlot(id.index);
        return true;
    }

    public Expected<MeshShape> getMeshGeometry(in MeshGeometryId id)const{
        if(!this.isMeshGeometryValid(id))
            return MakeUnexpected(Failure());
        return this.m_meshShapes[id.index];
    }

