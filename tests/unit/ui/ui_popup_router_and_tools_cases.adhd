    ASSERT_TRUE(self.m_router.commitTargets(base, 3u));
    EXPECT_FALSE(self.m_router.hasPopup());
    EXPECT_FALSE(self.m_router.focus().valid());
}

void VerifyUiPopupRouterTests_InvalidatingPopupOwnerRetiresItsScopeActionsAndHeldCaptureImmediately(mut UiPopupRouterTests self){
    const PopupScope scope = MakeUiPopupRouterScope();
    ASSERT_TRUE(self.install(scope, 7u));
    self.click(MakeUiPopupRouterPoint(55.0f, 55.0f));
    EXPECT_TRUE(self.send(MakeUiPopupRouterPointerEvent(InputEventType::PrimaryDown, 55.0f, 55.0f)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiPopupRouterKeyEvent(InputEventType::KeyDown, Key::Space, false)).commandConsumed);
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    self.m_router.invalidateTarget(scope.token.widget);
    EXPECT_FALSE(self.m_router.hasPopup());
    EXPECT_EQ(self.m_router.layoutGeneration(), 7u);
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_FALSE(self.m_router.hitTest(MakeUiPopupRouterPoint(55.0f, 55.0f)).valid());
    EXPECT_TRUE(self.send(MakeUiPopupRouterPointerEvent(InputEventType::PrimaryUp, 55.0f, 55.0f)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiPopupRouterKeyEvent(InputEventType::KeyUp, Key::Space, false)).commandConsumed);
    EXPECT_FALSE(self.m_router.consumeActivation(MakeUiPopupRouterWidgetId(101u)));
}

void VerifyUiPopupRouterTests_InvalidScopeDescriptionsRejectAtomicallyWithoutChangingAcceptedInteraction(mut UiPopupRouterTests self){
    const PopupScope scope = MakeUiPopupRouterScope();
    const Array<HitTarget, 5u> targets = MakeUiPopupRouterTargets(scope);
    ASSERT_TRUE(self.install(scope, 1u));
    self.key(Key::Enter);
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_TRUE(self.send(MakeUiPopupRouterPointerEvent(InputEventType::PrimaryDown, 55.0f, 55.0f)).pointerConsumed);
    Array<PopupScope, 10u> invalid = Array<PopupScope, 10u>();
    for(mut PopupScope candidate : invalid)
        candidate = scope;
    invalid[0u].token.widget = WidgetId();
    invalid[1u].token.declarationGeneration = 0u;
    invalid[2u].token.instanceGeneration = 0u;
    invalid[3u].token.openGeneration = 0u;
    invalid[4u].layer = 0u;
    invalid[5u].bounds.width = 0.0f;
    invalid[6u].viewport.height = 0.0f;
    invalid[7u].bounds.x = bit_cast<f32>(0x7fc00000u);
    invalid[8u].bounds.x = -1.0f;
    invalid[9u].bounds.height = -1.0f;
    for(in PopupScope candidate : invalid){
        EXPECT_FALSE(self.commitWithScope(targets, 2u, candidate));
        EXPECT_EQ(self.m_router.layoutGeneration(), 1u);
        EXPECT_TRUE(self.m_router.hasPopup());
        EXPECT_EQ(self.m_router.focus().value, 101u);
        EXPECT_EQ(self.m_router.capture().value, 101u);
        EXPECT_EQ(self.m_router.hitTest(MakeUiPopupRouterPoint(55.0f, 55.0f)).value, 101u);
        EXPECT_EQ(self.m_router.actions().size(), 1u);
    }
    EXPECT_TRUE(self.send(MakeUiPopupRouterPointerEvent(InputEventType::PrimaryUp, 55.0f, 55.0f)).pointerConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(MakeUiPopupRouterWidgetId(101u)));
}

void VerifyUiPopupRouterTests_MissingOwnersDuplicateScopesAndMismatchedScopedTargetsRejectAtomically(mut UiPopupRouterTests self){
    const PopupScope scope = MakeUiPopupRouterScope();
    const Array<HitTarget, 5u> accepted = MakeUiPopupRouterTargets(scope);
    ASSERT_TRUE(self.install(scope, 1u));
    Array<PopupScope, 2u> duplicate = Array<PopupScope, 2u>();
    duplicate[0u] = scope;
    duplicate[1u] = scope;
    EXPECT_FALSE(self.m_router.commitTargets(accepted, 2u, duplicate));
    EXPECT_FALSE(self.m_router.commitTargets(accepted, 2u));
    for(usize mismatch = 0u; mismatch < 7u; ++mismatch){
        Array<HitTarget, 5u> invalid = accepted;
        switch(mismatch){
        case 0u:
            ++invalid[3u].popup.openGeneration;
            break;
        case 1u:
            ++invalid[3u].layer;
            break;
        case 2u:
            invalid[0u].layer = 1u;
            break;
        case 3u:
            invalid[0u].popup.widget = scope.token.widget;
            break;
        case 4u:
            invalid[2u].id = MakeUiPopupRouterWidgetId(150u);
            break;
        case 5u:
            ++invalid[2u].declarationGeneration;
            break;
        default:
            invalid[2u].popup = PopupToken();
            break;
        }
        EXPECT_FALSE(self.commitWithScope(invalid, 2u, scope));
        EXPECT_EQ(self.m_router.layoutGeneration(), 1u);
        EXPECT_EQ(self.m_router.focus().value, 101u);
        EXPECT_EQ(self.m_router.hitTest(MakeUiPopupRouterPoint(55.0f, 55.0f)).value, 101u);
    }
    Array<HitTarget, 5u> invalid = accepted;
    invalid[4u] = invalid[2u];
    EXPECT_FALSE(self.commitWithScope(invalid, 2u, scope));
    EXPECT_TRUE(self.install(scope, 2u));
}

void VerifyUiPopupRouterTests_PopupCountBoundRejectsWithoutReplacingTheAcceptedScope(mut UiPopupRouterTests self){
    const PopupScope scope = MakeUiPopupRouterScope();
    ASSERT_TRUE(self.install(scope, 1u));
    Array<PopupScope, 9u> overflow = Array<PopupScope, 9u>();
    ASSERT_EQ(overflow.size(), s_InputMaxPopups + 1u);
    for(usize index = 0u; index < overflow.size(); ++index)
        overflow[index] = MakeUiPopupRouterScopeLayer(200u + index, cast<u32>(index + 1u));
    const Array<HitTarget, 5u> targets = MakeUiPopupRouterTargets(scope);
    EXPECT_FALSE(self.m_router.commitTargets(targets, 2u, overflow));
    EXPECT_EQ(self.m_router.layoutGeneration(), 1u);
    EXPECT_EQ(self.m_router.focus().value, 101u);
    EXPECT_TRUE(self.m_router.hasPopup());
}

void VerifyUiPopupRouterTests_ResetDropsOwnedScopesDismissalsAndInteractionBeforeLayoutReuse(mut UiPopupRouterTests self){
    const PopupScope scope = MakeUiPopupRouterScope();
    ASSERT_TRUE(self.install(scope, 7u));
    self.key(Key::Escape);
    self.m_router.reset();
    EXPECT_FALSE(self.m_router.hasPopup());
    EXPECT_FALSE(self.m_router.wantsCommands());
    EXPECT_FALSE(self.m_router.wantsPointer());
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_FALSE(self.m_router.capture().valid());
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_EQ(self.m_router.layoutGeneration(), 0u);
    EXPECT_FALSE(self.m_router.consumePopupDismissal(scope.token).has_value());
    const Array<HitTarget, 2u> base = MakeUiPopupRouterBaseTargets();
    ASSERT_TRUE(self.m_router.commitTargets(base, 1u));
    EXPECT_EQ(self.m_router.hitTest(MakeUiPopupRouterPoint(15.0f, 15.0f)).value, 1u);
}


