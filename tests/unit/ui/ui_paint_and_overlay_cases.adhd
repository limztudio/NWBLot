void VerifyUiPaintOverlayTests_OverlayRendersAboveLaterBasePaintWithoutMergingItsBatch(mut UiPaintOverlayTests self){
    const Rect rectangle = MakeUiPaintOverlayRect(1.0f, 1.0f, 4.0f, 4.0f);
    self.m_builder.fillRect(rectangle, MakeUiPaintOverlayColor(1.0f, 0.0f, 0.0f, 1.0f));
    ASSERT_TRUE(self.m_builder.beginOverlay(3u));
    self.m_builder.fillRect(rectangle, MakeUiPaintOverlayColor(0.0f, 1.0f, 0.0f, 1.0f));
    self.m_builder.fillRect(rectangle, MakeUiPaintOverlayColor(0.0f, 1.0f, 0.0f, 0.5f));
    ASSERT_TRUE(self.m_builder.endOverlay());
    self.m_builder.fillRect(rectangle, MakeUiPaintOverlayColor(0.0f, 0.0f, 1.0f, 1.0f));
    const DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.commands().size(), 3u);
    EXPECT_EQ(snapshot.commands()[0u].layer, 0u);
    EXPECT_EQ(snapshot.commands()[0u].firstIndex, 0u);
    EXPECT_EQ(snapshot.commands()[1u].layer, 0u);
    EXPECT_EQ(snapshot.commands()[1u].firstIndex, 18u);
    EXPECT_EQ(snapshot.commands()[2u].layer, 3u);
    EXPECT_EQ(snapshot.commands()[2u].firstIndex, 6u);
    EXPECT_EQ(snapshot.commands()[2u].indexCount, 12u);
    ASSERT_EQ(snapshot.indices().size(), 24u);
    for(u32 quad = 0u; quad < 4u; ++quad){
        EXPECT_EQ(snapshot.indices()[quad * 6u], quad * 4u);
        EXPECT_EQ(snapshot.indices()[quad * 6u + 5u], quad * 4u + 3u);
    }
}

void VerifyUiPaintOverlayTests_LayerOrderPrecedesDeclarationOrderAndEqualLayersKeepTheirIndexOrder(mut UiPaintOverlayTests self){
    const Rect rectangle = MakeUiPaintOverlayRect(1.0f, 1.0f, 4.0f, 4.0f);
    ASSERT_TRUE(self.m_builder.beginOverlay(7u));
    self.m_builder.fillRect(rectangle, MakeUiPaintOverlayColor(1.0f, 0.0f, 0.0f, 1.0f));
    ASSERT_TRUE(self.m_builder.endOverlay());
    ASSERT_TRUE(self.m_builder.beginOverlay(2u));
    self.m_builder.fillRect(rectangle, MakeUiPaintOverlayColor(0.0f, 1.0f, 0.0f, 1.0f));
    ASSERT_TRUE(self.m_builder.endOverlay());
    ASSERT_TRUE(self.m_builder.beginOverlay(7u));
    self.m_builder.fillRect(rectangle, MakeUiPaintOverlayColor(0.0f, 0.0f, 1.0f, 1.0f));
    ASSERT_TRUE(self.m_builder.endOverlay());
    self.m_builder.fillRect(rectangle);
    const DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.commands().size(), 4u);
    EXPECT_EQ(snapshot.commands()[0u].layer, 0u);
    EXPECT_EQ(snapshot.commands()[0u].firstIndex, 18u);
    EXPECT_EQ(snapshot.commands()[1u].layer, 2u);
    EXPECT_EQ(snapshot.commands()[1u].firstIndex, 6u);
    EXPECT_EQ(snapshot.commands()[2u].layer, 7u);
    EXPECT_EQ(snapshot.commands()[2u].firstIndex, 0u);
    EXPECT_EQ(snapshot.commands()[3u].layer, 7u);
    EXPECT_EQ(snapshot.commands()[3u].firstIndex, 12u);
}

void VerifyUiPaintOverlayTests_OverlayEscapesParentClipAndRestoresItsExactPriorClip(mut UiPaintOverlayTests self){
    const Rect rectangle = MakeUiPaintOverlayRect(0.0f, 0.0f, 100.0f, 80.0f);
    self.m_builder.pushClip(MakeUiPaintOverlayRect(10.0f, 10.0f, 20.0f, 20.0f));
    self.m_builder.fillRect(rectangle);
    ASSERT_TRUE(self.m_builder.beginOverlay(4u));
    self.m_builder.pushClip(MakeUiPaintOverlayRect(25.0f, 5.0f, 40.0f, 20.0f));
    self.m_builder.fillRect(rectangle);
    ASSERT_TRUE(self.m_builder.popClip());
    EXPECT_FALSE(self.m_builder.popClip());
    ASSERT_TRUE(self.m_builder.endOverlay());
    self.m_builder.fillRect(rectangle);
    ASSERT_TRUE(self.m_builder.popClip());
    self.m_builder.fillRect(rectangle);
    const DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.vertices().size(), 16u);
    EXPECT_FLOAT_EQ(snapshot.vertices()[0u].position.x, 10.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[0u].position.y, 10.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[2u].position.x, 30.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[2u].position.y, 30.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[4u].position.x, 25.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[4u].position.y, 5.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[6u].position.x, 65.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[6u].position.y, 25.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[8u].position.x, 10.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[10u].position.y, 30.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[12u].position.x, 0.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[14u].position.y, 80.0f);
    ASSERT_EQ(snapshot.commands().size(), 4u);
    EXPECT_EQ(snapshot.commands()[3u].layer, 4u);
    EXPECT_FLOAT_EQ(snapshot.commands()[3u].clip.x, 25.0f);
    EXPECT_FLOAT_EQ(snapshot.commands()[3u].clip.y, 5.0f);
    EXPECT_FLOAT_EQ(snapshot.commands()[3u].clip.width, 40.0f);
    EXPECT_FLOAT_EQ(snapshot.commands()[3u].clip.height, 20.0f);
}

void VerifyUiPaintOverlayTests_EscapingTheParentStillClipsOverlayGeometryAndUvsToTheLogicalViewport(mut UiPaintOverlayTests self){
    self.m_builder.pushClip(MakeUiPaintOverlayRect(50.0f, 50.0f, 5.0f, 5.0f));
    ASSERT_TRUE(self.m_builder.beginOverlay(2u));
    ASSERT_TRUE(self.m_builder.drawRegion(s_UiInputNameSprite, MakeUiPaintOverlayRect(-20.0f, -10.0f, 160.0f, 100.0f)));
    ASSERT_TRUE(self.m_builder.endOverlay());
    ASSERT_TRUE(self.m_builder.popClip());
    const DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.commands().size(), 1u);
    ASSERT_EQ(snapshot.vertices().size(), 4u);
    EXPECT_EQ(snapshot.commands()[0u].layer, 2u);
    EXPECT_FLOAT_EQ(snapshot.commands()[0u].clip.width, 100.0f);
    EXPECT_FLOAT_EQ(snapshot.commands()[0u].clip.height, 80.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[0u].position.x, 0.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[0u].position.y, 0.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[2u].position.x, 100.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[2u].position.y, 80.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[0u].texCoord.x, 0.0625f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[0u].texCoord.y, 0.05f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[2u].texCoord.x, 0.375f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[2u].texCoord.y, 0.45f);
}

void VerifyUiPaintOverlayTests_RejectedAdmissionAndUnbalancedClosurePreserveTheActiveLayerAndClips(mut UiPaintOverlayTests self){
    const Rect rectangle = MakeUiPaintOverlayRect(0.0f, 0.0f, 100.0f, 80.0f);
    self.m_builder.pushClip(MakeUiPaintOverlayRect(5.0f, 5.0f, 10.0f, 10.0f));
    EXPECT_FALSE(self.m_builder.beginOverlay(0u));
    EXPECT_FALSE(self.m_builder.endOverlay());
    self.m_builder.fillRect(rectangle);
    ASSERT_TRUE(self.m_builder.beginOverlay(8u));
    ASSERT_TRUE(self.m_builder.beginOverlay(9u));
    ASSERT_TRUE(self.m_builder.endOverlay());
    EXPECT_FALSE(self.m_builder.beginOverlay(0u));
    self.m_builder.pushClip(MakeUiPaintOverlayRect(10.0f, 10.0f, 20.0f, 20.0f));
    EXPECT_FALSE(self.m_builder.endOverlay());
    self.m_builder.fillRect(rectangle);
    ASSERT_TRUE(self.m_builder.popClip());
    EXPECT_FALSE(self.m_builder.popClip());
    ASSERT_TRUE(self.m_builder.endOverlay());
    EXPECT_FALSE(self.m_builder.endOverlay());
    self.m_builder.fillRect(rectangle);
    ASSERT_TRUE(self.m_builder.popClip());
    const DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.commands().size(), 3u);
    EXPECT_EQ(snapshot.commands()[0u].layer, 0u);
    EXPECT_EQ(snapshot.commands()[1u].layer, 0u);
    EXPECT_EQ(snapshot.commands()[2u].layer, 8u);
    EXPECT_FLOAT_EQ(snapshot.vertices()[0u].position.x, 5.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[2u].position.x, 15.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[4u].position.x, 10.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[6u].position.x, 30.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[8u].position.x, 5.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[10u].position.x, 15.0f);
}

void VerifyUiPaintOverlayTests_NestedOverlayRestoresParentLayerAndItsClipAfterEscapingBoth(mut UiPaintOverlayTests self){
    const Rect rectangle = MakeUiPaintOverlayRect(0.0f, 0.0f, 100.0f, 80.0f);
    ASSERT_TRUE(self.m_builder.beginOverlay(2u));
    self.m_builder.pushClip(MakeUiPaintOverlayRect(5.0f, 5.0f, 10.0f, 10.0f));
    self.m_builder.fillRect(rectangle);
    ASSERT_TRUE(self.m_builder.beginOverlay(3u));
    self.m_builder.fillRect(rectangle);
    EXPECT_FALSE(self.m_builder.popClip());
    ASSERT_TRUE(self.m_builder.endOverlay());
    self.m_builder.fillRect(rectangle);
    ASSERT_TRUE(self.m_builder.popClip());
    ASSERT_TRUE(self.m_builder.endOverlay());
    self.m_builder.fillRect(rectangle);
    const DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.commands().size(), 4u);
    EXPECT_EQ(snapshot.commands()[0u].layer, 0u);
    EXPECT_EQ(snapshot.commands()[1u].layer, 2u);
    EXPECT_EQ(snapshot.commands()[2u].layer, 2u);
    EXPECT_EQ(snapshot.commands()[3u].layer, 3u);
    EXPECT_FLOAT_EQ(snapshot.vertices()[0u].position.x, 5.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[4u].position.x, 0.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[6u].position.x, 100.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[8u].position.x, 5.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[10u].position.x, 15.0f);
}

void VerifyUiPaintOverlayTests_BoundedOverlayDepthRejectsWithoutChangingTheLastAcceptedScope(mut UiPaintOverlayTests self){
    for(u32 layer = 1u; layer <= cast<u32>(s_PaintMaxOverlayDepth); ++layer)
        ASSERT_TRUE(self.m_builder.beginOverlay(layer));
    EXPECT_FALSE(self.m_builder.beginOverlay(99u));
    self.m_builder.fillRect(MakeUiPaintOverlayRect(0.0f, 0.0f, 100.0f, 80.0f));
    for(usize depth = 0u; depth < s_PaintMaxOverlayDepth; ++depth)
        ASSERT_TRUE(self.m_builder.endOverlay());
    EXPECT_FALSE(self.m_builder.endOverlay());
    const DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.commands().size(), 1u);
    EXPECT_EQ(snapshot.commands()[0u].layer, cast<u32>(s_PaintMaxOverlayDepth));
}

void VerifyUiPaintOverlayTests_UnrecordedScopesAreRejectedAndBeginResetsAbandonedOverlayState(mut UiPaintOverlayTests self){
    PaintBuilder idle = PaintBuilder(self.m_arena);
    EXPECT_FALSE(idle.beginOverlay(1u));
    EXPECT_FALSE(idle.endOverlay());
    ASSERT_TRUE(self.m_builder.beginOverlay(5u));
    self.m_builder.pushClip(MakeUiPaintOverlayRect(10.0f, 10.0f, 20.0f, 20.0f));
    self.m_builder.fillRect(MakeUiPaintOverlayRect(10.0f, 10.0f, 10.0f, 10.0f));
    self.begin(8u);
    EXPECT_FALSE(self.m_builder.endOverlay());
    self.m_builder.fillRect(MakeUiPaintOverlayRect(0.0f, 0.0f, 100.0f, 80.0f));
    const DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.commands().size(), 1u);
    EXPECT_EQ(snapshot.commands()[0u].layer, 0u);
    EXPECT_EQ(snapshot.commands()[0u].firstIndex, 0u);
    EXPECT_FLOAT_EQ(snapshot.vertices()[0u].position.x, 0.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[2u].position.y, 80.0f);
    EXPECT_FALSE(self.m_builder.beginOverlay(1u));
    EXPECT_FALSE(self.m_builder.endOverlay());
}

void VerifyUiPaintOverlayTests_LayerDescentAfterMergedOverlayPaintOrdersTheCompleteBatches(mut UiPaintOverlayTests self){
    const Rect rectangle = MakeUiPaintOverlayRect(1.0f, 1.0f, 4.0f, 4.0f);
    ASSERT_TRUE(self.m_builder.beginOverlay(4u));
    self.m_builder.fillRect(rectangle);
    self.m_builder.fillRect(rectangle);
    ASSERT_TRUE(self.m_builder.endOverlay());
    self.m_builder.fillRect(rectangle);
    self.m_builder.fillRect(rectangle);
    const DrawSnapshot first = self.m_builder.freeze();
    ASSERT_EQ(first.commands().size(), 2u);
    EXPECT_EQ(first.commands()[0u].layer, 0u);
    EXPECT_EQ(first.commands()[0u].firstIndex, 12u);
    EXPECT_EQ(first.commands()[0u].indexCount, 12u);
    EXPECT_EQ(first.commands()[1u].layer, 4u);
    EXPECT_EQ(first.commands()[1u].firstIndex, 0u);
    EXPECT_EQ(first.commands()[1u].indexCount, 12u);

    self.begin(8u);
    self.m_builder.fillRect(rectangle);
    ASSERT_TRUE(self.m_builder.beginOverlay(4u));
    self.m_builder.fillRect(rectangle);
    ASSERT_TRUE(self.m_builder.endOverlay());
    const DrawSnapshot second = self.m_builder.freeze();
    ASSERT_EQ(second.commands().size(), 2u);
    EXPECT_EQ(second.commands()[0u].layer, 0u);
    EXPECT_EQ(second.commands()[0u].firstIndex, 0u);
    EXPECT_EQ(second.commands()[1u].layer, 4u);
    EXPECT_EQ(second.commands()[1u].firstIndex, 6u);
    EXPECT_EQ(first.commands()[0u].firstIndex, 12u);
}

void VerifyUiPaintOverlayTests_SortingCommandsRetainsSkinCoverageDistanceBindingsAndUnchangedIndexRanges(mut UiPaintOverlayTests self){
    auto coverageCreationResult = self.makeCoverage();
    ASSERT_TRUE(coverageCreationResult.has_value());
    SharedGlyphPage coverage = SharedGlyphPage();
    TakeUiPaintOverlayGlyphPage(coverage, coverageCreationResult);
    auto distanceCreationResult = self.makeDistance();
    ASSERT_TRUE(distanceCreationResult.has_value());
    SharedSdfAtlasPage distance = SharedSdfAtlasPage();
    TakeUiPaintOverlaySdfPage(distance, distanceCreationResult);
    ASSERT_TRUE(UiPaintOverlayHasGlyphPage(coverage) && UiPaintOverlayHasSdfPage(distance));
    const Rect rectangle = MakeUiPaintOverlayRect(1.0f, 1.0f, 4.0f, 4.0f);
    const Rect uv = MakeUiPaintOverlayRect(0.0f, 0.0f, 0.5f, 0.5f);
    ASSERT_TRUE(self.m_builder.beginOverlay(4u));
    ASSERT_TRUE(self.m_builder.drawSdfGlyph(distance, 3u, rectangle, uv));
    ASSERT_TRUE(self.m_builder.drawGlyph(coverage, rectangle, uv));
    ASSERT_TRUE(self.m_builder.endOverlay());
    ASSERT_TRUE(self.m_builder.drawRegion(s_UiInputNameSprite, rectangle));
    ASSERT_TRUE(self.m_builder.drawSdfGlyph(distance, 1u, rectangle, uv));
    ASSERT_TRUE(self.m_builder.drawGlyph(coverage, rectangle, uv));
    const DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.commands().size(), 5u);
    ASSERT_EQ(snapshot.sdfPages().size(), 1u);
    ASSERT_EQ(snapshot.glyphPages().size(), 1u);
    EXPECT_EQ(snapshot.skinBinding().texture.name(), s_UiPaintOverlayTextureName);
    EXPECT_EQ(UiPaintOverlaySdfPageAddress(snapshot.sdfPages()[0u]), UiPaintOverlaySdfPageAddress(distance));
    EXPECT_EQ(UiPaintOverlayGlyphPageAddress(snapshot.glyphPages()[0u]), UiPaintOverlayGlyphPageAddress(coverage));
    EXPECT_EQ(snapshot.commands()[0u].material, PaintMaterial::Skin);
    EXPECT_EQ(snapshot.commands()[0u].firstIndex, 12u);
    EXPECT_EQ(snapshot.commands()[1u].material, PaintMaterial::SdfGlyph);
    EXPECT_EQ(snapshot.commands()[1u].sdfPageIndex, 0u);
    EXPECT_EQ(snapshot.commands()[1u].sdfChannel, 1u);
    EXPECT_EQ(snapshot.commands()[1u].firstIndex, 18u);
    EXPECT_EQ(snapshot.commands()[2u].material, PaintMaterial::Glyph);
    EXPECT_EQ(snapshot.commands()[2u].glyphPageIndex, 0u);
    EXPECT_EQ(snapshot.commands()[2u].firstIndex, 24u);
    EXPECT_EQ(snapshot.commands()[3u].layer, 4u);
    EXPECT_EQ(snapshot.commands()[3u].material, PaintMaterial::SdfGlyph);
    EXPECT_EQ(snapshot.commands()[3u].sdfPageIndex, 0u);
    EXPECT_EQ(snapshot.commands()[3u].sdfChannel, 3u);
    EXPECT_EQ(snapshot.commands()[3u].firstIndex, 0u);
    EXPECT_EQ(snapshot.commands()[4u].layer, 4u);
    EXPECT_EQ(snapshot.commands()[4u].material, PaintMaterial::Glyph);
    EXPECT_EQ(snapshot.commands()[4u].glyphPageIndex, 0u);
    EXPECT_EQ(snapshot.commands()[4u].firstIndex, 6u);
    ASSERT_EQ(snapshot.indices().size(), 30u);
    for(u32 quad = 0u; quad < 5u; ++quad){
        EXPECT_EQ(snapshot.indices()[quad * 6u], quad * 4u);
        EXPECT_EQ(snapshot.indices()[quad * 6u + 2u], quad * 4u + 2u);
        EXPECT_EQ(snapshot.indices()[quad * 6u + 5u], quad * 4u + 3u);
    }
    for(in DrawCommand command : snapshot.commands()){
        EXPECT_EQ(command.indexCount, 6u);
        EXPECT_LT(cast<usize>(command.firstIndex + command.indexCount - 1u), snapshot.indices().size());
    }
}


