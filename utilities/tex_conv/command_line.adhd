b8 IsTexConvAlphaOptionPresent(in i32 optionCount){
    return optionCount > s_AlphaOptionPresentCount;
}

b8 ValidateTexConvInputImagePath(in Path path, in b8 alphaMask){
    const Expected<b8, ErrorCode> isRegularFile = IsRegularFile(path);
    if(!isRegularFile.has_value() && !IsMissingPathError(isRegularFile.error())){
        native(in path, in isRegularFile, in alphaMask){
            const auto errorText = isRegularFile.error().message();
            const AStringView errorView(errorText.data(), errorText.size());
            if(alphaMask)
                NWB_LOGGER_ERROR(FOUNDATION_TEXT("tex_conv: failed to inspect alpha image '{}': {}"), PathToString<tchar>(path), ConvertString(errorView));
            else
                NWB_LOGGER_ERROR(FOUNDATION_TEXT("tex_conv: failed to inspect input '{}': {}"), PathToString<tchar>(path), ConvertString(errorView));
        }
        return false;
    }
    if(!isRegularFile.has_value() || !isRegularFile.value()){
        if(alphaMask)
            error("tex_conv: alpha image was not found or is not a regular file: '{}'", path);
        else
            error("tex_conv: input image was not found or is not a regular file: '{}'", path);
        return false;
    }
    if(!IsSupportedTexConvInputPath(path)){
        if(alphaMask)
            error("tex_conv: unsupported alpha image format; accepted: PNG, JPEG/JFIF, TGA, QOI, OpenEXR, and Radiance HDR.");
        else
            error("tex_conv: unsupported input format; accepted: PNG, JPEG/JFIF, TGA, QOI, OpenEXR, and Radiance HDR.");
        return false;
    }
    return true;
}

String FormatTexConvCompletionReport(
    in Path metadataPath,
    in Path dataPath,
    in u32 width,
    in u32 height,
    in u32 depth,
    in b8 isCube,
    in b8 is3d,
    in u32 mipCount,
    in usize byteCount
){
    String metadataPathStorage = "";
    String dataPathStorage = "";
    StringView metadataPathText = "";
    StringView dataPathText = "";
    native(in metadataPath, in dataPath, mut metadataPathStorage, mut dataPathStorage, mut metadataPathText, mut dataPathText){
        metadataPathText = GenericNativeTextView(metadataPath.native(), metadataPathStorage);
        dataPathText = GenericNativeTextView(dataPath.native(), dataPathStorage);
    }
    String report;
    report.reserve(AddSaturating<usize>(AddSaturating<usize>(metadataPathText.size(), dataPathText.size()), s_CompletionReportReserveSlack));
    StringAppendFormat(report, "Wrote {}\nWrote {}\n  {}x{}", metadataPathText, dataPathText, width, height);
    if(isCube)
        report.append(" cube");
    else if(is3d)
        StringAppendFormat(report, "x{}", depth);
    StringAppendFormat(report, ", {} linear UASTC mips, {} raw bytes\n", mipCount, byteCount);
    return report;
}


