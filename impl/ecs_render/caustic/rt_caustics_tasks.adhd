#include <impl/ecs_render/caustic/rt_caustics_resolve_chain.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ShouldConfirmCausticAccumulatorBootstrapClear(in b8 graphOwnsAccumulatorBootstrapClear, in b8 causticProducerDispatched){
    return graphOwnsAccumulatorBootstrapClear && causticProducerDispatched;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/global.adhd.h>
#include <impl/ecs_render/caustic/caustic_activity_resources.adhd.h>
#include <impl/ecs_render/caustic/graph_types.adhd.h>
#include <impl/ecs_render/caustic/hardware_caustics_stage_builder.adhd.h>
#include <impl/ecs_render/caustic/rt_caustics_internal.adhd.h>
#include <impl/ecs_render/kernel/renderer_constants_private.adhd.h>
#include <impl/ecs_render/kernel/task_graph_resource_utils.adhd.h>
#include <impl/ecs_render/kernel/task_graph_scheduling.adhd.h>
#include <impl/ecs_render/kernel/timing_names.adhd.h>
#include <impl/ecs_render/raytrace/graph_snapshots.adhd.h>
#include <impl/ecs_render/raytrace/raytracing_system.adhd.h>
#include <impl/ecs_render/raytrace/rt_private.adhd.h>
#include <impl/ecs_render/raytrace/task_graph_scene_resources.adhd.h>
#include <impl/ecs_render/shared/frame_types.adhd.h>
#include <impl/ecs_render/shared/renderer_frame_bindings.adhd.h>

#include <core/common/log.h>
#include <core/graphics/gpu_timing.h>
#include <core/graphics/runtime/runtime.h>
#include <core/task/gpu/task_graph.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<HardwareCausticsStageResult> HardwareCausticsStageBuilder::declare(const HardwareCausticsStageInputs& inputs, Core::Alloc::ScratchArena& scratchArena){
    using namespace RendererTaskGraphDetail;
    HardwareCausticsStageResult result{};
    if(!inputs.declaresHardwareCaustics)
        return result;
    if(
        !inputs.worldPosition.valid()
        || !inputs.depth.valid()
        || !inputs.currentCausticIrradiance.valid()
        || !inputs.currentBindlessSlots.valid()
        || !inputs.sceneShading.valid()
        || !inputs.lights.valid()
        || !inputs.graphicsPrefixTask.valid()
    )
        return MakeUnexpected(Failure{});
    if(m_raytracingSystem.hasHwCausticWork(inputs.meshViewSnapshot) && !inputs.opticalScene.valid())
        return MakeUnexpected(Failure{});

    CausticsResolveChainBuilder resolveChainBuilder(m_graph, m_raytracingSystem);
    const auto stageTargetsResult = resolveChainBuilder.importStageTargets(inputs.targets, true);
    if(!stageTargetsResult)
        return MakeUnexpected(Failure{});
    const CausticsStageTargets stageTargets = *stageTargetsResult;

    Vector<Core::GpuTaskResourceUse, Core::Alloc::ScratchArena> hardwarePhotonResourceUses{ scratchArena };
    const b8 hardwareTraceGeometryStatesGraphOwned = inputs.hardwareTraceGeometrySet.valid();
    const RendererFramePipelineDetail::TraceResourceSetUses hardwarePhotonResourceSetUses = RendererFramePipelineDetail::MakeTraceResourceSetUses(inputs.hardwareTraceGeometrySet, inputs.traceMaterialSampledTextureSet);
    hardwarePhotonResourceUses.reserve(ComputePhotonResourceUseCapacity(
        s_HardwarePhotonResourceUseCapacity,
        inputs.rayTracingResources.csgTraceContextBuffer != nullptr,
        inputs.rayTracingResources.csgTraceBoundsBuffers.size(),
        hardwareTraceGeometryStatesGraphOwned,
        inputs.hardwareTraceGeometryResources.size()
    ));
    hardwarePhotonResourceUses.push_back(ReadTextureUse(inputs.worldPosition, ECSRenderDetail::s_FramebufferSubresources, Core::ResourceStates::ShaderResource));
    hardwarePhotonResourceUses.push_back(ReadTextureUse(inputs.depth, ECSRenderDetail::s_FramebufferSubresources, Core::ResourceStates::ShaderResource));
    hardwarePhotonResourceUses.push_back(ReadUse(inputs.currentBindlessSlots, Core::ResourceStates::ConstantBuffer));
    hardwarePhotonResourceUses.push_back(ReadUse(inputs.sceneShading, Core::ResourceStates::ConstantBuffer));
    hardwarePhotonResourceUses.push_back(ReadUse(inputs.lights, Core::ResourceStates::ShaderResource));
    if(inputs.opticalScene.valid())
        hardwarePhotonResourceUses.push_back(ReadUse(inputs.opticalScene));
    hardwarePhotonResourceUses.push_back(ReadUse(stageTargets.sceneGeometryDomain));
    hardwarePhotonResourceUses.push_back(ReadWriteTextureUse(stageTargets.causticAccumulator, ECSRenderDetail::s_CausticAccumulatorSubresources, Core::ResourceStates::UnorderedAccess));

    const auto appendOptionalReadBuffer = [&](const Core::BufferHandle& buffer, const Name& identity, const AStringView label, const Core::ResourceStates::Mask state){
        if(!buffer)
            return true;
        const auto resourceResult = ImportExternalBuffer(m_graph, buffer, identity, label);
        if(!resourceResult)
            return false;
        hardwarePhotonResourceUses.push_back(ReadUse(*resourceResult, state));
        return true;
    };
    b8 optionalResourcesImported =
        appendOptionalReadBuffer(inputs.meshViewSnapshot.buffer, Name(s_MeshViewName), s_MeshViewLabel, Core::ResourceStates::ConstantBuffer)
        && appendOptionalReadBuffer(
            inputs.rayTracingResources.shadowInstanceMaterialBuffer,
            Name(s_SceneShadowInstanceMaterialName),
            s_SceneShadowInstanceMaterialLabel,
            Core::ResourceStates::ShaderResource
        )
        && appendOptionalReadBuffer(inputs.rayTracingResources.shadowMaterialTypedBuffer, Name(s_SceneShadowMaterialTypedName), s_SceneShadowMaterialTypedLabel, Core::ResourceStates::ShaderResource)
        && appendOptionalReadBuffer(inputs.rayTracingResources.shadowInstanceBuffer, Name(s_SceneShadowInstancesName), s_SceneShadowInstancesLabel, Core::ResourceStates::ShaderResource)
        && appendOptionalReadBuffer(inputs.rayTracingResources.causticEmissionTargetBuffer, Name(s_HardwareCausticEmissionTargetsName), s_CausticEmissionTargetsLabel, Core::ResourceStates::ShaderResource)
    ;
    if(inputs.materialContextSlots.valid())
        hardwarePhotonResourceUses.push_back(ReadUse(inputs.materialContextSlots, Core::ResourceStates::ConstantBuffer));
    // Candidate normal and seam checks read the frozen position and index streams.
    for(const Core::GpuGraphResourceId resource : inputs.hardwareTraceGeometryResources){
        if(!resource.valid()){
            NWB_LOGGER_WARNING(FOUNDATION_TEXT("RendererSystem: invalid prepared hardware-caustics geometry resource"));
            return MakeUnexpected(Failure{});
        }
        if(!hardwareTraceGeometryStatesGraphOwned)
            hardwarePhotonResourceUses.push_back(ReadUse(resource, Core::ResourceStates::ShaderResource));
    }
    if(inputs.rayTracingResources.sceneTlas){
        const auto tlas = m_graph.importAccelStruct(
            inputs.rayTracingResources.sceneTlas,
            AccelStructResourceDesc(Name(s_SceneTlasResourceName), s_SceneTlasResourceLabel)
                .setInitialState(m_raytracingSystem.sceneTlasBackingInitialState())
        );
        optionalResourcesImported = optionalResourcesImported && tlas.has_value();
        if(tlas.has_value())
            hardwarePhotonResourceUses.push_back(ReadUse(*tlas, Core::ResourceStates::AccelStructRead));
    }
    optionalResourcesImported = optionalResourcesImported && RendererFramePipelineDetail::AppendCurrentCsgRayGeometry(
        inputs.rayTracingResources.csgTraceContextBuffer,
        inputs.rayTracingResources.csgTraceBoundsBuffers,
        m_graph,
        hardwarePhotonResourceUses
    );
    if(!optionalResourcesImported){
        NWB_LOGGER_WARNING(FOUNDATION_TEXT("RendererSystem: could not import a hardware-caustics dynamic resource"));
        return MakeUnexpected(Failure{});
    }

    const Array<Core::GpuTaskId, 1u> hardwareDependencies = { inputs.graphicsPrefixTask };
    const Span<const Core::GpuExternalCompletionId> hardwareExternalDependencies = inputs.features.laggedLightingHistoryWriterWaitPending
        ? Span<const Core::GpuExternalCompletionId>(&inputs.historyWriterDrainCompletion, 1u)
        : Span<const Core::GpuExternalCompletionId>{};
    const Array<Core::GpuTaskExternalStateSource, 1u> accumulatorStateSources = {
        Core::GpuTaskExternalStateSource{ .states = inputs.accumulatorPersistentState.source(), },
    };
    const Span<const Core::GpuTaskExternalStateSource> accumulatorStateSourceSpan = inputs.accumulatorPersistentState.valid()
        ? Span<const Core::GpuTaskExternalStateSource>(accumulatorStateSources)
        : Span<const Core::GpuTaskExternalStateSource>{};

    const auto prefixTasksResult = resolveChainBuilder.declarePrefixTasks(CausticsStagePrefixInputs{
        .targets = inputs.targets,
        .meshViewSnapshot = inputs.meshViewSnapshot,
        .shadowPreparationReady = inputs.shadowPreparationReady,
        .timingTicket = inputs.timingTicket,
        .photonTiming = inputs.photonTiming,
        .initialDependencies = hardwareDependencies,
        .externalDependencies = hardwareExternalDependencies,
        .irradianceClearStateSources = {},
        .accumulatorStateSources = accumulatorStateSourceSpan,
        .causticIrradiance = inputs.currentCausticIrradiance,
        .causticAccumulator = stageTargets.causticAccumulator,
        .causticAccumulatorInitialized = inputs.rayTracingResources.causticAccumulatorInitialized,
        .hardwareCaustics = true,
    });
    if(!prefixTasksResult)
        return MakeUnexpected(Failure{});
    result.causticIrradianceClearTask = prefixTasksResult->causticIrradianceClearTask;
    result.causticAccumulatorBootstrapClearTask = prefixTasksResult->causticAccumulatorBootstrapClearTask;
    result.causticAccumulatorDecayTask = prefixTasksResult->causticAccumulatorDecayTask;

    Core::GpuTaskSchedulingHint hardwareCausticsScheduling;
    hardwareCausticsScheduling.cost = Core::GpuTaskCostHint::Large;
    hardwareCausticsScheduling.forceSubmissionBoundary = false;
    hardwareCausticsScheduling.allowPacketMerge = true;
    hardwareCausticsScheduling.mergeWithPrevious = true;
    // Keep photon/geometry/resolve stages in one Hardware Caustics timing chain.
    hardwareCausticsScheduling.allowMergeAcrossConsumerFrontier = true;
    EnableSameFamilyComputeEffectRouting(hardwareCausticsScheduling);
    EnableCrossFamilyComputeEffectRouting(hardwareCausticsScheduling);

    Core::GpuTaskDesc hardwarePhotonDesc;
    hardwarePhotonDesc
        .setIdentity(Name(s_RenderNameRenderHardwareCausticsPhotons))
        .setMarkerLabel("Hardware Caustic Photons")
        .setScheduling(hardwareCausticsScheduling)
        .setDependencies({ &prefixTasksResult->photonDependencyTask, 1u })
        .setResourceUses(hardwarePhotonResourceUses)
        .setResourceSetUses({ hardwarePhotonResourceSetUses.useCount != 0u ? hardwarePhotonResourceSetUses.uses.data() : nullptr, hardwarePhotonResourceSetUses.useCount })
    ;
    const auto causticPhotonTaskResult = m_raytracingSystem.declareHardwareCausticsTask(
        m_graph,
        hardwarePhotonDesc,
        inputs.lightingResources,
        inputs.meshViewSnapshot,
        inputs.shadowPreparationReady,
        prefixTasksResult->graphOwnsAccumulatorBootstrapClear,
        inputs.targets,
        inputs.timingTicket,
        inputs.photonTiming,
        inputs.producerDispatched
    );
    if(!causticPhotonTaskResult){
        NWB_LOGGER_WARNING(FOUNDATION_TEXT("RendererSystem: could not declare hardware-caustics photon graph task"));
        return MakeUnexpected(Failure{});
    }
    result.causticPhotonTask = *causticPhotonTaskResult;

    const auto geometryAndResolveResult = resolveChainBuilder.declareGeometryAndResolve(CausticsGeometryAndResolveInputs{
        .targets = inputs.targets,
        .producerDispatched = inputs.producerDispatched,
        .timingTicket = inputs.timingTicket,
        .resolveTiming = inputs.resolveTiming,
        .stageTargets = stageTargets,
        .worldPosition = inputs.worldPosition,
        .depth = inputs.depth,
        .causticIrradiance = inputs.currentCausticIrradiance,
        .photonTask = result.causticPhotonTask,
        .baseScheduling = hardwareCausticsScheduling,
        .geometryStateSources = {},
        .resolveStateSources = {},
        .hardwareCaustics = true,
    });
    if(!geometryAndResolveResult)
        return MakeUnexpected(Failure{});
    result.causticGeometryTask = geometryAndResolveResult->causticGeometryTask;
    result.causticResolvePrepareTask = geometryAndResolveResult->causticResolvePrepareTask;
    result.causticResolveWaveletTasks = geometryAndResolveResult->causticResolveWaveletTasks;
    result.causticResolveUpsampleTask = geometryAndResolveResult->causticResolveUpsampleTask;
    result.hardwareCausticsTask = geometryAndResolveResult->causticsTask;
    return result;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_rt_caustics_tasks{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


template<typename Payload>
static void ConfirmCausticAccumulatorClears(Payload& payload)noexcept(noexcept(ShouldConfirmCausticAccumulatorBootstrapClear(payload.graphOwnsAccumulatorBootstrapClear, payload.causticProducerDispatched)) && noexcept(payload.raytracingSystem.confirmCausticAccumulatorBootstrapClear())){
    if(ShouldConfirmCausticAccumulatorBootstrapClear(payload.graphOwnsAccumulatorBootstrapClear, payload.causticProducerDispatched))
        payload.raytracingSystem.confirmCausticAccumulatorBootstrapClear();
}

// A warm accumulator decays before either photon route writes splats. Separate task so the compiler lowers the UAV dep into the producer.
struct CausticAccumulatorDecayGraphTask{
    static constexpr Core::GpuTaskCommandRequirements s_CommandRequirements = { Core::GpuQueueCapability::Compute };


public:
    // All bindings are required: decay always brackets the caustic-photon timing against this frame's ticket.
    struct Payload{
        RendererRayTracingSystem& raytracingSystem;
        Core::GraphicsRuntime& graphics;
        DeferredFrameTargets& targets;
        ECSRenderDetail::MeshViewBufferSnapshot meshView;
        const b8& shadowVisibilityPrepared;
        Core::GpuTimingSubmissionTicket& timingTicket;
        Optional<Core::GpuTimingMeasure>& causticPhotonTiming;
        b8 hardwareCaustics = false;
    };


public:
    [[nodiscard]] static b8 Record(const Payload& payload, Core::CommandList& commandList, [[maybe_unused]] const Core::GpuTaskRecordContext& context){
        // Match the producer's no-work behavior: keep the dep, but skip dispatch unless the producer would run.
        if(!payload.shadowVisibilityPrepared)
            return true;
        const b8 hasWork = payload.hardwareCaustics ? payload.raytracingSystem.hasHwCausticWork(payload.meshView) : payload.raytracingSystem.hasCausticWork(payload.meshView);
        if(!hasWork)
            return true;

        // A rejected record may retry before discard. Release the incomplete reservation before the retry's interval.
        Core::DiscardGpuTimingMeasure(&payload.causticPhotonTiming);
        Core::GpuTimingSubmissionTicket::RecordingScope timingRecording(payload.timingTicket);
        payload.causticPhotonTiming.emplace(payload.graphics.gpuTiming(), RendererGpuTimingScope::s_CausticPhotons, payload.graphics.getDevice(), commandList);
        if(!Core::FinishSplitGpuTimingMarker(&payload.causticPhotonTiming))
            return false;
        const b8 dispatched = payload.raytracingSystem.dispatchCausticAccumulatorDecay(commandList, payload.targets);
        if(!dispatched){
            Core::DiscardGpuTimingMeasure(&payload.causticPhotonTiming);
            NWB_LOGGER_WARNING(FOUNDATION_TEXT("RendererSystem: graph-owned caustic accumulator decay pass failed"));
        }
        return true;
    }

    static void Discarded(Payload& payload)noexcept{
        Core::DiscardGpuTimingMeasure(&payload.causticPhotonTiming);
    }
};

// Caustic producers own typed graph-task payloads; RendererFramePipeline composes their packet chain.
// The renderer still supplies declaration-filtered external state until the graph has every producer in the same frame transaction.
template<b8 Hardware>
struct CausticProducerGraphTask{
    static constexpr Core::GpuTaskCommandRequirements s_CommandRequirements = { Core::GpuQueueCapability::Compute };


public:
    // All bindings are required: photons always record against this frame's ticket and publish dispatch.
    struct Payload{
        RendererRayTracingSystem& raytracingSystem;
        DeferredFrameTargets& targets;
        DeferredLightingGraphResources deferredLightingResources;
        ECSRenderDetail::MeshViewBufferSnapshot meshView;
        Core::GpuTimingSubmissionTicket& timingTicket;
        const b8& shadowVisibilityPrepared;
        Optional<Core::GpuTimingMeasure>& causticPhotonTiming;
        b8 graphOwnsAccumulatorBootstrapClear = false;
        b8& causticProducerDispatched;
    };


public:
    [[nodiscard]] static b8 Record(const Payload& payload, Core::CommandList& commandList, [[maybe_unused]] const Core::GpuTaskRecordContext& context){
        payload.causticProducerDispatched = false;
        if(!payload.deferredLightingResources.valid())
            return false;

        Core::GpuTimingSubmissionTicket::RecordingScope timingRecording(payload.timingTicket);
        // Typed clears and warm decay precede photons; acceptance publishes their CPU lifecycle.
        if(payload.shadowVisibilityPrepared){
            b8 causticsDispatched;
            if constexpr(Hardware)
                causticsDispatched = payload.raytracingSystem.renderHwCaustics(commandList, payload.meshView, payload.targets, &payload.causticPhotonTiming);
            else
                causticsDispatched = payload.raytracingSystem.renderGpuBvhCaustics(commandList, payload.meshView, payload.targets, &payload.causticPhotonTiming);
            if(!causticsDispatched)
                Core::DiscardGpuTimingMeasure(&payload.causticPhotonTiming);
            payload.causticProducerDispatched = causticsDispatched;
            if(!causticsDispatched){
                if constexpr(Hardware){
                    if(payload.raytracingSystem.hasHwCausticWork(payload.meshView))
                        NWB_LOGGER_WARNING(FOUNDATION_TEXT("RendererSystem: hardware caustic render pass failed"));
                }
                else if(payload.raytracingSystem.hasCausticWork(payload.meshView))
                    NWB_LOGGER_WARNING(FOUNDATION_TEXT("RendererSystem: software caustic render pass failed"));
            }
        }
        return true;
    }

    static void Accepted(Payload& payload, const Core::QueueSubmissionToken& token)noexcept{
        ConfirmCausticAccumulatorClears(payload);
        if(payload.causticProducerDispatched)
            payload.raytracingSystem.confirmRayTraceContextReadSubmission(token);
    }

    static void Discarded(Payload& payload)noexcept{
        payload.causticProducerDispatched = false;
        Core::DiscardGpuTimingMeasure(&payload.causticPhotonTiming);
    }
};

template<b8 Hardware>
[[nodiscard]] static Expected<Core::GpuTaskId> DeclareCausticProducerTask(
    RendererRayTracingSystem& raytracingSystem,
    const Core::GpuTaskDesc& desc,
    const DeferredLightingGraphResources& deferredLightingResources,
    const ECSRenderDetail::MeshViewBufferSnapshot& meshView,
    const b8& shadowVisibilityPrepared,
    const b8 graphOwnsAccumulatorBootstrapClear,
    Core::GpuTaskGraph& graph,
    DeferredFrameTargets& targets,
    Core::GpuTimingSubmissionTicket& timingTicket,
    Optional<Core::GpuTimingMeasure>& causticPhotonTiming,
    b8& causticProducerDispatched
){
    using Task = CausticProducerGraphTask<Hardware>;
    return graph.addTask<Task>(
        desc,
        typename Task::Payload{
            .raytracingSystem = raytracingSystem,
            .targets = targets,
            .deferredLightingResources = deferredLightingResources,
            .meshView = meshView,
            .timingTicket = timingTicket,
            .shadowVisibilityPrepared = shadowVisibilityPrepared,
            .causticPhotonTiming = causticPhotonTiming,
            .graphOwnsAccumulatorBootstrapClear = graphOwnsAccumulatorBootstrapClear,
            .causticProducerDispatched = causticProducerDispatched,
        });
}

// Geometry downsample follows the selected photon producer in the same graph packet.
// Its timing begin is retained until wavelet resolve records the endpoint, preserving the established full-resolve interval across callbacks.
struct CausticGeometryDownsampleGraphTask{
    static constexpr Core::GpuTaskCommandRequirements s_CommandRequirements = { Core::GpuQueueCapability::Compute };


public:
    // All bindings are required: geometry downsample always brackets the caustic-resolve timing against this frame's ticket.
    struct Payload{
        RendererRayTracingSystem& raytracingSystem;
        Core::GraphicsRuntime& graphics;
        DeferredFrameTargets& targets;
        Core::GpuTimingSubmissionTicket& timingTicket;
        const b8& causticProducerDispatched;
        Optional<Core::GpuTimingMeasure>& causticResolveTiming;
    };


public:
    [[nodiscard]] static b8 Record(const Payload& payload, Core::CommandList& commandList, [[maybe_unused]] const Core::GpuTaskRecordContext& context){
        Core::DiscardGpuTimingMeasure(&payload.causticResolveTiming);
        if(!payload.causticProducerDispatched)
            return true;

        Core::GpuTimingSubmissionTicket::RecordingScope timingRecording(payload.timingTicket);
        payload.causticResolveTiming.emplace(payload.graphics.gpuTiming(), RendererGpuTimingScope::s_CausticResolve, payload.graphics.getDevice(), commandList);
        payload.raytracingSystem.dispatchCausticGeometryDownsample(commandList, payload.targets);
        // The next callback ends timestamps on this same list. Close this nested marker before the recorder advances.
        return Core::FinishSplitGpuTimingMarker(&payload.causticResolveTiming);
    }

    static void Discarded(Payload& payload)noexcept{
        Core::DiscardGpuTimingMeasure(&payload.causticResolveTiming);
    }
};

// All resolve phases retain the same activity and producer bindings.
// Specializations remain separate graph tasks, preserving each ping-pong resource handoff.
struct CausticResolveRecordInputs{
    RendererRayTracingSystem& raytracingSystem;
    DeferredFrameTargets& targets;
    const b8& causticProducerDispatched;
    CausticResolveActivitySnapshot activity;
};

template<auto Dispatch>
struct CausticResolvePhaseGraphTask{
    using Payload = CausticResolveRecordInputs;


public:
    static constexpr Core::GpuTaskCommandRequirements s_CommandRequirements = { Core::GpuQueueCapability::Compute };


public:
    [[nodiscard]] static b8 Record(const Payload& payload, Core::CommandList& commandList, [[maybe_unused]] const Core::GpuTaskRecordContext& context)noexcept(noexcept((payload.raytracingSystem.*Dispatch)(commandList, payload.targets))){
        if(!payload.activity.matches(payload.raytracingSystem.causticResolveActivitySnapshot(payload.targets)))
            return false;
        if(payload.causticProducerDispatched)
            (payload.raytracingSystem.*Dispatch)(commandList, payload.targets);
        return true;
    }
};

struct CausticResolveWaveletGraphTask{
    static constexpr Core::GpuTaskCommandRequirements s_CommandRequirements = { Core::GpuQueueCapability::Compute };


public:
    struct Payload{
        RendererRayTracingSystem& raytracingSystem;
        DeferredFrameTargets& targets;
        const b8& causticProducerDispatched;
        CausticResolveActivitySnapshot activity;
        u32 passIndex = 0u;
    };


public:
    [[nodiscard]] static b8 Record(const Payload& payload, Core::CommandList& commandList, [[maybe_unused]] const Core::GpuTaskRecordContext& context){
        if(!payload.activity.matches(payload.raytracingSystem.causticResolveActivitySnapshot(payload.targets)))
            return false;
        if(payload.causticProducerDispatched)
            payload.raytracingSystem.dispatchCausticResolveWaveletPass(commandList, payload.targets, payload.passIndex);
        return true;
    }
};

using CausticResolvePrepareGraphTask = CausticResolvePhaseGraphTask<&RendererRayTracingSystem::dispatchCausticResolvePrepare>;
using CausticResolveUpsampleGraphTask = CausticResolvePhaseGraphTask<&RendererRayTracingSystem::dispatchCausticResolveUpsample>;

// The empty timing-close callback follows graph-owned upsample and finishes the retained full-resolve interval.
struct CausticResolveGraphTask{
    static constexpr Core::GpuTaskCommandRequirements s_CommandRequirements = {};


public:
    // All bindings are required: resolve always closes the caustic-resolve timing against this frame's ticket.
    struct Payload{
        Core::GpuTimingSubmissionTicket& timingTicket;
        const b8& causticProducerDispatched;
        Optional<Core::GpuTimingMeasure>& causticResolveTiming;
    };


public:
    [[nodiscard]] static b8 Record(const Payload& payload, Core::CommandList& commandList, [[maybe_unused]] const Core::GpuTaskRecordContext& context){
        // No-producer contract: the graph-owned irradiance clear wins, no resolve dispatch when the producer never recorded.
        if(!payload.causticProducerDispatched){
            Core::DiscardGpuTimingMeasure(&payload.causticResolveTiming);
            return true;
        }
        if(!payload.causticResolveTiming.has_value())
            return false;

        Core::GpuTimingSubmissionTicket::RecordingScope timingRecording(payload.timingTicket);
        payload.causticResolveTiming.value().finishTiming(commandList);
        payload.causticResolveTiming.reset();
        return true;
    }

    static void Discarded(Payload& payload)noexcept{
        Core::DiscardGpuTimingMeasure(&payload.causticResolveTiming);
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<Core::GpuTaskId> RendererRayTracingSystem::declareCausticAccumulatorDecayTask(
    Core::GpuTaskGraph& graph,
    const Core::GpuTaskDesc& desc,
    const ECSRenderDetail::MeshViewBufferSnapshot& meshView,
    const b8& shadowVisibilityPrepared,
    const b8 hardwareCaustics,
    DeferredFrameTargets& targets,
    Core::GpuTimingSubmissionTicket& timingTicket,
    Optional<Core::GpuTimingMeasure>& causticPhotonTiming
){
    return graph.addTask<__hidden_rt_caustics_tasks::CausticAccumulatorDecayGraphTask>(
        desc,
        __hidden_rt_caustics_tasks::CausticAccumulatorDecayGraphTask::Payload{
            .raytracingSystem = *this,
            .graphics = m_graphics,
            .targets = targets,
            .meshView = meshView,
            .shadowVisibilityPrepared = shadowVisibilityPrepared,
            .timingTicket = timingTicket,
            .causticPhotonTiming = causticPhotonTiming,
            .hardwareCaustics = hardwareCaustics,
        });
}

Expected<Core::GpuTaskId> RendererRayTracingSystem::declareSoftwareCausticsTask(
    Core::GpuTaskGraph& graph,
    const Core::GpuTaskDesc& desc,
    const DeferredLightingGraphResources& deferredLightingResources,
    const ECSRenderDetail::MeshViewBufferSnapshot& meshView,
    const b8& shadowVisibilityPrepared,
    const b8 graphOwnsAccumulatorBootstrapClear,
    DeferredFrameTargets& targets,
    Core::GpuTimingSubmissionTicket& timingTicket,
    Optional<Core::GpuTimingMeasure>& causticPhotonTiming,
    b8& causticProducerDispatched
){
    return __hidden_rt_caustics_tasks::DeclareCausticProducerTask<false>(
        *this,
        desc,
        deferredLightingResources,
        meshView,
        shadowVisibilityPrepared,
        graphOwnsAccumulatorBootstrapClear,
        graph,
        targets,
        timingTicket,
        causticPhotonTiming,
        causticProducerDispatched
    );
}

Expected<Core::GpuTaskId> RendererRayTracingSystem::declareHardwareCausticsTask(
    Core::GpuTaskGraph& graph,
    const Core::GpuTaskDesc& desc,
    const DeferredLightingGraphResources& deferredLightingResources,
    const ECSRenderDetail::MeshViewBufferSnapshot& meshView,
    const b8& shadowVisibilityPrepared,
    const b8 graphOwnsAccumulatorBootstrapClear,
    DeferredFrameTargets& targets,
    Core::GpuTimingSubmissionTicket& timingTicket,
    Optional<Core::GpuTimingMeasure>& causticPhotonTiming,
    b8& causticProducerDispatched
){
    return __hidden_rt_caustics_tasks::DeclareCausticProducerTask<true>(
        *this,
        desc,
        deferredLightingResources,
        meshView,
        shadowVisibilityPrepared,
        graphOwnsAccumulatorBootstrapClear,
        graph,
        targets,
        timingTicket,
        causticPhotonTiming,
        causticProducerDispatched
    );
}

Expected<Core::GpuTaskId> RendererRayTracingSystem::declareCausticGeometryDownsampleTask(
    Core::GpuTaskGraph& graph,
    const Core::GpuTaskDesc& desc,
    const b8& causticProducerDispatched,
    DeferredFrameTargets& targets,
    Core::GpuTimingSubmissionTicket& timingTicket,
    Optional<Core::GpuTimingMeasure>& causticResolveTiming
){
    return graph.addTask<__hidden_rt_caustics_tasks::CausticGeometryDownsampleGraphTask>(
        desc,
        __hidden_rt_caustics_tasks::CausticGeometryDownsampleGraphTask::Payload{
            .raytracingSystem = *this,
            .graphics = m_graphics,
            .targets = targets,
            .timingTicket = timingTicket,
            .causticProducerDispatched = causticProducerDispatched,
            .causticResolveTiming = causticResolveTiming,
        });
}

