enum<u8> UiComboBehaviorCallbackStage{ None, Generation, Revision, RowCount, Lookup, Key, Enabled }
enum<u8> UiComboBehaviorCallbackMutation{ Select, Open, Close, Generation, Revision, RowCount }
type UiComboBuilderTests = ComboFixture;

class UiBuilderSkinPaletteTests : WidgetFixture{


    public void configureReplacementSkin(mut UiSkin replacement, in UiSkinPalette palette, in f32 defaultFontSize){
        Vector<UiSkinRegion> regions;
        for(in UiSkinRegion region : this.m_skin.regions())
            regions.push_back(region);
        replacement.setAtlas(this.m_skin.texture(), this.m_skin.atlasWidth(), this.m_skin.atlasHeight(), this.m_skin.referenceDensity(), regions);
        replacement.setPalette(palette);
        replacement.setTypography(UiSkinTypography(defaultFontSize));
    }
}


class UiBuilderTests : ContextTestFixture{
    public WidgetRoot m_root;
    public Font m_font = Font(Name("tests/ui/fonts/latin"));
    public TextService m_text;
    public UiSkin m_skin = UiSkin(Name("tests/ui/skin"));
    public PaintBuilder m_paint;
    public Builder m_builder;

    public UiBuilderTests(){
        this.m_builder = Builder(this.m_context, this.m_paint, this.m_text);
        this.m_root = WidgetRoot(55u, 3u);
    }
    public void setup(){
        ASSERT_TRUE(InstallLatinFixtureFont( this.m_font, this.m_text));
        this.configureSkin();
        ASSERT_TRUE(this.m_skin.validatePayload());
        this.m_builder.setSkin(this.m_skin);
    }
    public void configureSkin(){ this.configureSkin(true); }
    public void configureSkin(in b8 includePanel){ this.configureSkin(includePanel, true); }
    public void configureSkin(in b8 includePanel, in b8 includeButton){
        Vector<UiSkinRegion> regions;
        if(includePanel)
            regions.push_back(UiSkinRegion(Name(s_UiCasePanelNormal), UiSkinRect(0u, 0u, 8u, 8u), UiSkinSliceInsets(), UiSkinInsets(4.0f, 6.0f, 8.0f, 10.0f), 0.0f, 0.0f, UiSkinDrawMode::Sprite));
        if(includeButton)
            regions.push_back(UiSkinRegion(Name(s_UiCaseNameButtonNormal), UiSkinRect(8u, 0u, 8u, 8u), UiSkinSliceInsets(), UiSkinInsets(1.0f, 2.0f, 3.0f, 4.0f), 20.0f, 20.0f, UiSkinDrawMode::Sprite));
        regions.push_back(UiSkinRegion(Name(s_UiCaseButtonHover), UiSkinRect(16u, 0u, 8u, 8u), UiSkinSliceInsets(), UiSkinInsets(7.0f, 1.0f, 2.0f, 3.0f), 40.0f, 30.0f, UiSkinDrawMode::Sprite));
        regions.push_back(UiSkinRegion(Name(s_UiCaseButtonPressed), UiSkinRect(24u, 0u, 8u, 8u), UiSkinSliceInsets(), UiSkinInsets(2.0f, 9.0f, 5.0f, 1.0f), 30.0f, 35.0f, UiSkinDrawMode::Sprite));
        regions.push_back(UiSkinRegion(Name(s_UiCaseButtonDisabled), UiSkinRect(32u, 0u, 8u, 8u), UiSkinSliceInsets(), UiSkinInsets(3.0f, 4.0f, 11.0f, 12.0f), 70.0f, 50.0f, UiSkinDrawMode::Sprite));
        regions.push_back(UiSkinRegion(Name(s_UiCaseCheckboxNormal), UiSkinRect(40u, 0u, 8u, 8u), UiSkinSliceInsets(), UiSkinInsets(), 10.0f, 10.0f, UiSkinDrawMode::Sprite));
        regions.push_back(UiSkinRegion(Name(s_UiCaseCheckboxHover), UiSkinRect(48u, 0u, 8u, 8u), UiSkinSliceInsets(), UiSkinInsets(), 20.0f, 24.0f, UiSkinDrawMode::Sprite));
        regions.push_back(UiSkinRegion(Name(s_UiCaseCheckboxChecked), UiSkinRect(56u, 0u, 8u, 8u), UiSkinSliceInsets(), UiSkinInsets(), 28.0f, 30.0f, UiSkinDrawMode::Sprite));
        regions.push_back(UiSkinRegion(Name(s_UiCaseCheckboxDisabled), UiSkinRect(64u, 0u, 8u, 8u), UiSkinSliceInsets(), UiSkinInsets(), 34.0f, 32.0f, UiSkinDrawMode::Sprite));
        regions.push_back(UiSkinRegion(Name(s_UiCaseCheckboxMark), UiSkinRect(72u, 0u, 8u, 8u), UiSkinSliceInsets(), UiSkinInsets(), 0.0f, 0.0f, UiSkinDrawMode::Sprite));
        regions.push_back(UiSkinRegion(Name(s_UiCaseFocusOverlay), UiSkinRect(80u, 0u, 8u, 8u), UiSkinSliceInsets(), UiSkinInsets(), 0.0f, 0.0f, UiSkinDrawMode::Sprite));
        this.m_skin.setAtlas(AssetRef<Texture>("tests/ui/texture"), 128u, 16u, 1.0f, regions);
    }
    public b8 begin(in u64 generation){ return this.begin(generation, Rect(0.0f, 0.0f, 300.0f, 200.0f)); }
    public b8 begin(in u64 generation, in Rect bounds){
        if(!this.m_context.beginFrame(generation))
            return false;
        this.m_paint.begin(DisplayMetrics(300.0f, 200.0f, 1.0f, 1.0f), generation, 1u, AssetRef<UiSkin>(s_TestSkinPath), this.m_skin);
        return this.m_context.beginRoot(this.m_root) && this.m_builder.beginPanel(s_UiBuilderPanelKey, bounds);
    }
    public void beginPaintFrame(in u64 generation){
        this.m_paint.begin(DisplayMetrics(300.0f, 200.0f, 1.0f, 1.0f), generation, 1u, AssetRef<UiSkin>(s_TestSkinPath), this.m_skin);
    }
    public b8 finish(){
        return this.m_builder.endPanel() && this.m_context.endRoot() && this.m_context.finishFrame();
    }
    public WidgetId id(in StringView stableKey)const{
        return RequireUiWidgetId(RequireUiWidgetId(RequireUiRootId(this.m_root), s_UiBuilderPanelKey), stableKey);
    }
    public Expected<Rect> regionQuad(in DrawSnapshot snapshot, in u32 slot)const{
        const f32 firstU = cast<f32>(slot) / 16.0f;
        const f32 lastU = cast<f32>(slot + 1u) / 16.0f;
        for(in DrawCommand command : snapshot.commands()){
            if(command.material != PaintMaterial::Skin)
                continue;
            for(u32 index = command.firstIndex; index < command.firstIndex + command.indexCount; index += 6u){
                in Vertex first = snapshot.vertices()[snapshot.indices()[index]];
                in Vertex last = snapshot.vertices()[snapshot.indices()[index + 2u]];
                const VectorSingle texDelta = VectorAbs(VectorSingle(first.texCoord.x, last.texCoord.x, first.texCoord.y, last.texCoord.y) - VectorSingle(firstU, lastU, 0.0f, 0.5f));
                if(Vector4Less(texDelta, VectorSingle(1e-6f))){
                    const VectorSingle size = VectorSingle(last.position.x, last.position.y, 0.0f, 0.0f) - VectorSingle(first.position.x, first.position.y, 0.0f, 0.0f);
                    return Rect(first.position.x, first.position.y, size.x, size.y);
                }
            }
        }
        return MakeUnexpected(Failure());
    }
}


