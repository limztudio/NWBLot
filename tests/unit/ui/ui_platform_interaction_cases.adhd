NWB_ADHD_GTEST_F(UiPlatformInteractionFixture, CursorResolutionCaptureGrabAndFrameOverride, VerifyUiPlatformInteraction_CursorResolutionCaptureGrabAndFrameOverride)
NWB_ADHD_GTEST_F(UiPlatformInteractionFixture, SpatialFocusGridNeighborsTrapSliderAndClipCulling, VerifyUiPlatformInteraction_SpatialFocusGridNeighborsTrapSliderAndClipCulling)
NWB_ADHD_GTEST_F(UiPlatformInteractionFixture, GamepadDeadzoneHysteresisRepeatScrollAndDisconnect, VerifyUiPlatformInteraction_GamepadDeadzoneHysteresisRepeatScrollAndDisconnect)
NWB_ADHD_GTEST_F(UiPlatformInteractionFixture, AccessibilityHierarchyPasswordToastAndActions, VerifyUiPlatformInteraction_AccessibilityHierarchyPasswordToastAndActions)


