#include <impl/ecs_ui/toolkit/text/service.adhd>
#include <impl/ecs_ui/toolkit/text/layout_measurement.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// The layout retains its exact font versions until a replacement is shaped successfully.
class Label : NoCopy{
    private String m_text;
    private String m_language;
    private Expected<TextLayout, TextLayoutStatus> m_layout = MakeUnexpected(TextLayoutStatus::InvalidParameters);
    private u64 m_serviceIdentity = 0u;
    private u64 m_fontGeneration = 0u;
    private f32 m_fontSize = s_TextDefaultFontSize;
    private u32 m_scriptTag = s_TextDefaultScriptTag;
    private TextDirection m_direction = TextDirection::LeftToRight;
    private b8 m_dirty = true;

    public Label(){
        this.m_language.assign(s_TextDefaultLanguage);
    }

    public TextLayoutStatus setText(in ShapeRequest request){
        return SetLabelTextRequest(request, this.m_text, this.m_language, this.m_fontSize, this.m_scriptTag, this.m_direction, this.m_dirty);
    }

    public Expected<Rect> measure(mut TextService text, in DisplayMetrics display){
        if(!this.m_layout.has_value() || this.m_dirty || this.m_serviceIdentity != text.identity() || this.m_fontGeneration != text.generation()){
            ShapeRequest request;
            request.text = this.m_text;
            request.language = this.m_language;
            request.fontSize = this.m_fontSize;
            request.scriptTag = this.m_scriptTag;
            request.direction = this.m_direction;
            Expected<TextLayout, TextLayoutStatus> layout = text.layout(request);
            if(!layout.has_value())
                return MakeUnexpected(Failure());
            this.m_layout = layout;
            this.m_serviceIdentity = text.identity();
            this.m_fontGeneration = text.generation();
            this.m_dirty = false;
        }
        return text.measure(this.m_layout.value(), display);
    }

    public b8 paint(mut TextService text, mut PaintBuilder paint, in Rect bounds, in Color color){
        const Expected<Rect> measured = this.measure(text, paint.displayMetrics());
        if(!measured.has_value())
            return false;
        paint.pushClip(bounds);
        const b8 painted = text.paint(paint, this.m_layout.value(), ResolveLabelPaintOrigin(bounds, measured.value()), color);
        const b8 restored = paint.popClip();
        return painted && restored;
    }

    public b8 paint(mut TextService text, mut PaintBuilder paint, in Rect bounds){
        return this.paint(text, paint, bounds, Color());
    }

    public in TextLayout layout()const{
        assert(this.m_layout.has_value(), "Label::layout() requires a successful measure() first");
        return this.m_layout.value();
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

