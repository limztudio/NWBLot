[cpp_header("<core/graphics/gpu_timing_metrics.h>"), cpp_name("::NWB::Core::GpuComparableTimestampRange"), cpp_flags(binary_serializable, brace_init)]
extern class GpuComparableTimestampRange{
    u64 beginTicks;
    u64 endTicks;
    f64 secondsPerTick;
    GpuPhysicalQueueId physicalQueue;
    b8 valid(...)const;
};

[cpp_header("<core/graphics/gpu_timing_metrics.h>"), cpp_name("::NWB::Core::GpuPacketEnvelopeMetrics"), cpp_flags(small_value, binary_serializable, brace_init)]
extern class GpuPacketEnvelopeMetrics{
    f64 secondsPerTick;
    u64 queueOverlapTicks;
};

[cpp_header("<core/graphics/gpu_timing_metrics.h>"), cpp_name("::NWB::Core::GpuQueuePacketEnvelopeMetrics"), cpp_flags(small_value, binary_serializable, brace_init)]
extern class GpuQueuePacketEnvelopeMetrics{
    GpuPhysicalQueueId physicalQueue;
    u64 internalIdleTicks;
};


