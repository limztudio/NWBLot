////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_SHADOW_RAY_SETUP_SLANGI
#define NWB_GRAPHICS_SHADOW_RAY_SETUP_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "constants.h"
#include "../scene/binding_slots.h"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


bool nwbShadowBuildLightRay(const float3 worldPosition, const float3 normal, const NwbSceneLight light, const float2 jitter, out float3 outDirection, out float outTMin, out float outTEnd){
    outDirection = float3(0.0, 1.0, 0.0);
    outTMin = NWB_SHADOW_RAY_MIN_DISTANCE;
    outTEnd = 0.0;

    float tMax;
    if(light.params.y < NWB_SCENE_LIGHT_TYPE_DIRECTIONAL_MAX){
        outDirection = nwbShadowJitterCone(normalize(light.direction.xyz), light.params2.x, jitter);
        tMax = NWB_SHADOW_DIRECTIONAL_RAY_MAX_DISTANCE;
    }
    else{
        const float3 delta = light.position.xyz - worldPosition;
        tMax = length(delta);
        const float3 centerDir = (tMax > NWB_SHADOW_LIGHT_DIRECTION_EPSILON) ? (delta / tMax) : float3(0.0, 1.0, 0.0);
        const float sinHalf = (tMax > NWB_SHADOW_LIGHT_DIRECTION_EPSILON) ? min(light.params2.y / tMax, NWB_SHADOW_POINT_LIGHT_SINE_HALF_ANGLE_MAX) : 0.0;
        const float cosHalf = sqrt(max(1.0 - sinHalf * sinHalf, 0.0));
        outDirection = (sinHalf > 0.0) ? nwbShadowJitterConeCos(centerDir, cosHalf, jitter) : centerDir;
    }

    if(dot(normal, outDirection) <= 0.0)
        return false;

    outTEnd = tMax - NWB_SHADOW_RAY_END_DISTANCE_BIAS;
    return outTEnd > outTMin;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

