#include <impl/global.adhd>
#include <impl/assets_font/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Stores one static, scalable SFNT face from a prepared font source; shaping and glyph atlases stay outside this asset.
[asset("font")]
class Font{
    private Vector<u8> m_fontBytes;
    private u32 m_faceIndex = 0u;

    public b8 loadBinary(in Span<u8> binary);
    public b8 validatePayload()const;

    public void setFontBytes(in Vector<u8> bytes, in u32 faceIndex){
        this.m_fontBytes = bytes;
        this.m_faceIndex = faceIndex;
    }

    public void setFontBytes(in Vector<u8> bytes){
        this.m_fontBytes = bytes;
        this.m_faceIndex = 0u;
    }

    public in Vector<u8> fontBytes()const{ return this.m_fontBytes; }

    public u32 faceIndex()const{ return this.m_faceIndex; }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <global/filesystem.h>
#include <global/sha256.h>
#include <global/span.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace FontBinaryPayload{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


inline constexpr TStringView s_FontAssetKindLabel = FOUNDATION_TEXT("font");

static_assert(sizeof(FontBinaryHeader) == 24u && alignof(FontBinaryHeader) == 1u, "Font payload header layout drifted");


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct PreparedFontImageGroup{
    Sha256Digest sha256;
    Core::Assets::AssetBytes pixels;
    u32 width = 0u;
    u32 height = 0u;
    u32 channelCount = 0u;


public:
    explicit PreparedFontImageGroup(Core::Assets::AssetArena& arena)noexcept
        : pixels(arena)
    {}
};

struct PreparedFontSource{
    Core::Assets::AssetBytes fontBytes;
    Core::Assets::AssetVector<PreparedFontImageGroup> groups;
    u32 faceIndex = 0u;
    Sha256Digest fontSha256;


public:
    explicit PreparedFontSource(Core::Assets::AssetArena& arena)noexcept
        : fontBytes(arena)
        , groups(arena)
    {}
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// FON2 stores the exact prepared SFNT and compact images; readable atlas mappings remain in paired .nwb metadata.
[[nodiscard]] Expected<Core::Assets::AssetBytes, AStringView> SerializePreparedFontSource(BinaryByteView sfnt, u32 faceIndex, Span<const PreparedFontImageView> groups, Core::Assets::AssetArena& arena);

// Font-only reads retain image directory metadata, with empty pixel arrays, and validate the complete file layout.
[[nodiscard]] Expected<PreparedFontSource, AStringView> ReadPreparedFontSource(const Path& path, b8 includePixels, Core::Assets::AssetArena& arena);
[[nodiscard]] Expected<PreparedFontSource, AStringView> ReadPreparedFontSource(const ::Path<::ArenaBase>& path, b8 includePixels, Core::Assets::AssetArena& arena);

// Uses the source buffer's caller-owned arena for native validation allocations.
[[nodiscard]] b8 ValidateFontSource(const Core::Assets::AssetBytes& bytes, u32 faceIndex = 0u);
[[nodiscard]] b8 ValidateFontSource(const Vector<u8, ::ArenaBase>& bytes, u32 faceIndex = 0u);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

