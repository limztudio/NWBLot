[cpp_header("<core/crash/protocol.h>"), cpp_name("::NWB::Core::Crash::CrashDetail::FixedMetadata")]
extern class CrashMetadata{
    Array<CrashChar, s_CrashMaxShortText> key;
    Array<CrashChar, s_CrashMaxMediumText> value;
    u8 used;
};

[cpp_header("<core/crash/protocol.h>"), cpp_name("::NWB::Core::Crash::CrashDetail::FixedBreadcrumb")]
extern class CrashBreadcrumb{
    Array<CrashChar, s_CrashMaxShortText> category;
    Array<CrashChar, s_CrashMaxMediumText> message;
};

[cpp_header("<core/crash/protocol.h>"), cpp_name("::NWB::Core::Crash::CrashDetail::CrashRequest")]
extern class CrashRequest{
    u32 version;
    u32 platform;
    u32 reasonKind;
    u32 processId;
    u32 threadId;
    u32 callstackFrameCount;
    u32 metadataCount;
    u32 breadcrumbCount;
    Array<CrashChar, s_CrashMaxShortText> crashId;
    Array<CrashChar, s_CrashMaxShortText> applicationName;
    Array<CrashChar, s_CrashMaxShortText> versionText;
    Array<CrashChar, s_CrashMaxShortText> abi;
    Array<CrashChar, s_CrashMaxShortText> event;
    Array<CrashChar, s_CrashMaxShortText> triggerCategory;
    Array<CrashChar, s_CrashMaxMediumText> buildId;
    Array<CrashChar, s_CrashMaxMediumText> crashUploadToken;
    Array<CrashChar, s_CrashMaxMediumText> triggerExpression;
    Array<CrashChar, s_CrashMaxMediumText> triggerMessage;
    Array<CrashChar, s_CrashMaxPathText> spoolDirectory;
    Array<CrashChar, s_CrashMaxPathText> triggerFile;
    Array<CrashChar, s_CrashMaxUrlText> logServerUrl;
    Array<CrashMetadata, s_CrashMaxMetadata> metadata;
    Array<CrashBreadcrumb, s_CrashMaxBreadcrumbs> breadcrumbs;
    u64 exceptionPointers;
    u32 manualContextArchitecture;
    u32 manualContextSize;
};

[cpp_header("<core/crash/protocol.h>"), cpp_name("::NWB::Core::Crash::CrashDetail::CrashAck")]
extern class CrashAck{
    u8 packageWritten;
    Array<CrashChar, s_CrashMaxShortText> crashId;
};

[cpp_header("<core/crash/package_internal.h>"), cpp_name("::NWB::Core::Crash::CrashDetail::CrashUploadSnapshot")]
extern class CrashUploadSnapshot{
    Array<CrashChar, s_CrashMaxPathText> spoolDirectory;
