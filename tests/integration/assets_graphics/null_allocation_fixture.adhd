[cpp_header("<tests/integration/assets_graphics/cook_tool_sdk.h>"), cpp_name("::NWB::Tests::GraphicsCookToolSdk::NullAllocation"), cpp_flags(polymorphic_base)]
extern class NullAllocation;

class NullAllocationState{
    public u32 constructors = 0u;
    public b8 loaded = false;
}

class ConstructorMarker{
    public ConstructorMarker(){
        mut NullAllocationState state = TestProcessValue<NullAllocationState>();
        ++state.constructors;
    }
}

[arena, asset("tests/metadata_registry/null_allocation")]
class NullAllocatedAsset : NullAllocation{
    private ConstructorMarker marker;
    public b8 loadBinary(in Span<u8> bytes){
        TestProcessValue<NullAllocationState>().loaded = true;
        return true;
    }
}

[asset_writer]
b8 SerializeNullAllocatedAsset(in NullAllocatedAsset asset, mut Vector<u8> bytes){ return false; }

type NullAllocatedCodec = NameProbeCodec<NullAllocatedAsset>;

[cpp_header("<core/assets/cook_entry_registry.h>"), cpp_name("::NWB::Core::Assets::ICookEntryBucket"), cpp_flags(no_copy, no_assign, abstract, polymorphic_base)]
extern class TestCookBucket{
    usize size()const;
    b8 parseDocument(in GraphicsOwnedPath root, in StringView virtualRoot, in GraphicsOwnedPath path, in MetascriptDocument document, mut CookEntryParseContext context);
    b8 parseValue(in Name path, in GraphicsOwnedPath file, in MetascriptValue value, mut CookEntryParseContext context);
    b8 appendCachedEntry(in cpp_ref CookEntrySourceLocation source, in cpp_ref Name path, in Span<u8> bytes, mut CookEntryParseContext context);
    b8 writeCookedAssets(mut CookEntryWriteContext context);
};

class NullAllocatedBucket : TestCookBucket, NullAllocation{
    public NullAllocatedBucket(mut AssetCodecFixtureStorage storage){}
    public usize size()const override{ return 0u; }
    public b8 parseDocument(in GraphicsOwnedPath root, in StringView virtualRoot, in GraphicsOwnedPath path, in MetascriptDocument document, mut CookEntryParseContext context)override{ return false; }
    public b8 parseValue(in Name path, in GraphicsOwnedPath file, in MetascriptValue value, mut CookEntryParseContext context)override{ return false; }
    public b8 appendCachedEntry(in CookEntrySourceLocation source, in Name path, in Span<u8> bytes, mut CookEntryParseContext context)override{ return false; }
    public b8 writeCookedAssets(mut CookEntryWriteContext context)override{ return false; }
}

[cpp_header("<tests/integration/assets_graphics/cook_tool_sdk.h>"), cpp_name("::NWB::Tests::GraphicsCookToolSdk::RegisterBucket")]
extern b8 RegisterTestCookBucket<Bucket>(mut CookEntryRegistry registry, in Name type);


