#include <impl/ecs_render/execute/deferred_frame_topology_validator.adhd>
#include <impl/ecs_render/execute/frame_diagnostics.adhd>
#include <impl/ecs_render/execute/frame_execute_lifecycle.adhd>
#include <impl/ecs_render/execute/frame_execute_present_tails.adhd>
#include <impl/ecs_render/execute/frame_execute_recovery.adhd>
#include <impl/ecs_render/execute/frame_execute_recovery_and_tails.adhd>
#include <impl/ecs_render/execute/frame_execute_state_lifecycles.adhd>
#include <impl/ecs_render/execute/frame_execute_timing_state.adhd>
#include <impl/ecs_render/execute/types.adhd>
#include <impl/ecs_render/shared/frame_types.adhd>
#include <impl/ecs_scene/components.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


f32 ResolveMeshViewFramebufferAspectRatio(in u32 width, in u32 height, in f32 fallbackAspectRatio){
    if(width != 0u && height != 0u)
        return cast<f32>(width) / cast<f32>(height);
    return fallbackAspectRatio;
}

b8 HasOpaqueCsgFrameWork(in b8 hasOpaqueStaticWork, in b8 hasOpaqueSkinnedWork){
    return hasOpaqueStaticWork || hasOpaqueSkinnedWork;
}

b8 ShouldRequestLaggedAsyncLighting(in b8 frameLaggedAsyncLightingEnabled, in b8 dedicatedAsyncCompute){
    return frameLaggedAsyncLightingEnabled && dedicatedAsyncCompute;
}

b8 ShouldScheduleLaggedAsyncLighting(in b8 laggedAsyncLightingRequested, in b8 laggedLightingHistoryResourcesReady, in b8 readReadyTokenValid){
    return laggedAsyncLightingRequested && laggedLightingHistoryResourcesReady && readReadyTokenValid;
}

b8 AreNormalExecutionSemanticTokensReady(
    in b8 frameTimingBeginValid,
    in b8 frameTimingBeginOnPrimary,
    in b8 shadowPrepareValid,
    in b8 graphicsPrefixValid,
    in b8 shadowVisibilityValid,
    in b8 selectedCausticsValid,
    in b8 surfelGiValid,
    in b8 avboitPreValid,
    in b8 avboitCompletionValid,
    in b8 deferredLightingValid,
    in b8 deferredCompositeValid,
    in b8 deferredPresentValid,
    in b8 finalPresentationValid
){
    return
        frameTimingBeginValid
        && frameTimingBeginOnPrimary
        && shadowPrepareValid
        && graphicsPrefixValid
        && shadowVisibilityValid
        && selectedCausticsValid
        && surfelGiValid
        && avboitPreValid
        && avboitCompletionValid
        && deferredLightingValid
        && deferredCompositeValid
        && deferredPresentValid
        && finalPresentationValid
    ;
}

b8 AreNormalExecutionLifecycleStatesReady(in b8 shadowPrepareReady, in b8 shadowVisibilityReady, in b8 selectedCausticsReady, in b8 surfelGiReady, in b8 deferredLightingReady){
    return shadowPrepareReady && shadowVisibilityReady && selectedCausticsReady && surfelGiReady && deferredLightingReady;
}

b8 HasLostAcceptedNormalLifecycleState(
    in b8 shadowPrepareAccepted,
    in b8 shadowPrepareReady,
    in b8 shadowVisibilityAccepted,
    in b8 shadowVisibilityReady,
    in b8 causticsAccepted,
    in b8 causticsReady,
    in b8 surfelGiAccepted,
    in b8 surfelGiReady,
    in b8 deferredLightingAccepted,
    in b8 deferredLightingReady
){
    return
        (shadowPrepareAccepted && !shadowPrepareReady)
        || (shadowVisibilityAccepted && !shadowVisibilityReady)
        || (causticsAccepted && !causticsReady)
        || (surfelGiAccepted && !surfelGiReady)
        || (deferredLightingAccepted && !deferredLightingReady)
    ;
}

b8 ShouldFailFrameRenderRecoveryOnRejection(in b8 recovered, in b8 acceptedStateLost, in b8 presentationSignalReady, in b8 finalPresentationValid){
    return !recovered || acceptedStateLost || (!presentationSignalReady && finalPresentationValid);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 LaggedLightingHistoryTokenPending(mut Device device, in u64 historyGeneration, in QueueSubmissionToken token, in u64 tokenGeneration){
    if(!token.valid() || tokenGeneration != historyGeneration || !device.matchesPhysicalQueueIdentity(token.queue, token.physicalQueueIndex, token.deviceGeneration))
        return false;
    GpuPhysicalQueueId queue;
    queue.index = token.physicalQueueIndex;
    queue.deviceGeneration = token.deviceGeneration;
    const auto completed = device.queueGetCompletedInstance(queue);
    return !completed.has_value() || completed.value() < token.value;
}

void DiscardRendererFramePackets(
    mut FrameExecuteTimingState timing,
    mut FrameExecuteRecovery recovery,
    in GpuCompiledGraphReadView plan,
    mut GpuGraphSubmissionTransaction transaction,
    in GpuTaskId shadowPrepareTask,
    in FrameExecuteCpuSnapshot snapshot,
    mut GraphicsRuntime graphics,
    mut RendererMeshSystem mesh,
    mut RendererDeferredSystem deferred,
    mut RendererRayTracingState rayTracingState,
    mut RendererAvboitSystem avboit,
    mut RendererRayTracingSystem rayTracing,
    mut DeferredFrameTargets targets
){
    timing.discardAll();
    if(!recovery.discardUnacceptedGraphPackets()){
        [essential] warning("RendererSystem: deferred graph cancellation overlapped active native work; requesting device recreation");
        graphics.requestDeviceRecreation();
    }
    const b8 shadowPrepareAccepted = plan.findTask(shadowPrepareTask).valid() && transaction.taskToken(plan, shadowPrepareTask).valid();
    RestorePostGbufferPacketCpuState(snapshot, !shadowPrepareAccepted, mesh, deferred, rayTracingState, avboit, targets);
    rayTracing.discardSoftShadowTemporalHistory();
}

void RendererFramePipeline::render(in FramebufferPtr framebuffer){
    this.m_frameGraphSourceFrameIndex = this.m_graphics.getFrameIndex();

    if(this.m_deferredLightingTaskGraphScheduled){
        const GpuTaskGraphDeclarationReadView declarations(this.m_deferredLightingTaskGraph);
        const GpuCompiledGraphReadView compiledPlan(this.m_deferredLightingCompiledGraph);
        if(!this.m_deferredLightingTaskGraphQueueAssignmentTelemetry.update(declarations, this.m_deferredLightingTaskGraphQueueAssignments, compiledPlan, this.m_deferredLightingSubmissionTransaction, s_TaskGraphArena))
            warning("RendererSystem: deferred queue-assignment history refresh failed before graph reset");
    }

    this.resetFrameTaskState();

    if(!IsValidFramebufferPtr(framebuffer))
        return;

    const AcquiredPresentationFrame presentationFrame = this.m_graphics.acquiredPresentationFrame();
    in FramebufferDesc presentationFramebufferDesc = DerefFramebufferPtr(framebuffer).getDescription();
    if(!presentationFrame.valid() || presentationFrame.framebuffer.get() != framebuffer || presentationFramebufferDesc.colorAttachments.size() != 1u || !presentationFramebufferDesc.colorAttachments[0u].hasTexture(presentationFrame.backBuffer.texture.deref())){
        [essential] warning("RendererSystem: render target did not match the acquired presentation frame; requesting recreation");
        this.m_graphics.requestDeviceRecreation();
        return;
    }

    if(!this.m_frameTargets.valid())
        return;
    mut DeferredFrameTargets deferredTargets = this.m_frameTargets;

    assert(this.m_preparedCsgFrameStateValid);
    if(!this.m_shadowPrepareGraph.m_shadowPreparationOutcome.resourcesValid){
        error("RendererSystem: shadow-visibility resource preflight was unavailable");
        return;
    }

    const CsgFrameState csgFrameState = this.m_preparedCsgFrameState;
    const b8 hasOpaqueCsgFrameWork = HasOpaqueCsgFrameWork(csgFrameState.hasOpaqueStaticWork, csgFrameState.hasOpaqueSkinnedWork);
    const b8 hasTransparentRenderers = this.m_preparedHasTransparentRenderers;
    assert(csgFrameState.empty() || deferredTargets.csgIntervalTargetsValid());
    mut Device device = this.m_graphics.getDevice();
    if(this.m_graphics.isDeviceRecreationRequested() || device.requiresRecreation()){
        if(device.requiresRecreation())
            this.m_graphics.requestDeviceRecreation();
        return;
    }
    if(this.m_frameRenderRecoveryFailed){
        [essential] warning("RendererSystem: frame render recovery failed; rendering is suspended until resources are recreated");
        return;
    }
    PendingRecordingLease descriptorHeapPendingRecordingLease = device.getDescriptorHeap().acquirePendingRecordingLease();
    if(!descriptorHeapPendingRecordingLease.valid()){
        [essential] warning("RendererSystem: descriptor heap pending-recording lease was unavailable; requesting recreation");
        this.m_graphics.requestDeviceRecreation();
        return;
    }
    const GpuPhysicalQueueId primaryGraphicsQueue = device.getPrimaryPhysicalQueue(CommandQueue::Graphics);
    const u32 graphicsFamilyIndex = device.getQueueFamilyIndex(CommandQueue::Graphics);
    const u32 computeFamilyIndex = device.getQueueFamilyIndex(CommandQueue::Compute);
    const b8 dedicatedAsyncCompute = computeFamilyIndex != u32.max && computeFamilyIndex != graphicsFamilyIndex;
    const b8 laggedAsyncLightingRequested = ShouldRequestLaggedAsyncLighting(this.m_frameLaggedAsyncLightingEnabled, dedicatedAsyncCompute);
    const b8 laggedLightingHistoryResourcesReady = deferredTargets.laggedLightingHistory.valid();
    if(laggedAsyncLightingRequested && !laggedLightingHistoryResourcesReady){
        assert(laggedLightingHistoryResourcesReady);
        error("RendererSystem: lagged async lighting requires validated history targets");
        return;
    }

    const u64 laggedLightingHistoryTargetGeneration = deferredTargets.laggedLightingHistory.generation;
    const QueueSubmissionToken laggedLightingHistorySubmissionToken = this.m_laggedLightingHistorySubmissionToken;
    const b8 laggedLightingHistorySubmissionPending = LaggedLightingHistoryTokenPending(device, laggedLightingHistoryTargetGeneration, laggedLightingHistorySubmissionToken, this.m_laggedLightingHistoryGeneration);

    if(laggedLightingHistorySubmissionPending){
        this.m_laggedLightingHistoryWriterDrainToken = laggedLightingHistorySubmissionToken;
        this.m_laggedLightingHistoryWriterDrainGeneration = this.m_laggedLightingHistoryGeneration;
    }
    else if(this.m_laggedLightingHistoryWriterDrainToken.valid() && !LaggedLightingHistoryTokenPending(device, laggedLightingHistoryTargetGeneration, this.m_laggedLightingHistoryWriterDrainToken, this.m_laggedLightingHistoryWriterDrainGeneration))
        this.invalidateLaggedLightingHistoryWriterDrain();

    if(laggedAsyncLightingRequested){
        if(this.m_laggedLightingHistoryGeneration != laggedLightingHistoryTargetGeneration){
            this.invalidateLaggedLightingHistorySubmission();
            this.m_laggedLightingHistoryGeneration = laggedLightingHistoryTargetGeneration;
        }
    }
    else
        this.resetLaggedLightingHistoryReadTracking();
    const QueueSubmissionToken priorLaggedLightingHistoryReadReadyToken = this.m_laggedLightingHistorySubmissionToken;
    const QueueSubmissionToken priorLaggedLightingHistoryWriterDrainToken = this.m_laggedLightingHistoryWriterDrainToken;
    const b8 laggedLightingHistoryWriterWaitPending = priorLaggedLightingHistoryWriterDrainToken.valid();
    const b8 hardwareShadowSupported = this.m_graphics.queryFeatureSupport(Feature::RayTracingAccelStruct) && this.m_graphics.queryFeatureSupport(Feature::RayQuery);
    const b8 laggedAsyncLightingSchedule = ShouldScheduleLaggedAsyncLighting(laggedAsyncLightingRequested, laggedLightingHistoryResourcesReady, priorLaggedLightingHistoryReadReadyToken.valid());
    const b8 requestsLaggedLightingHistoryCapture = laggedAsyncLightingRequested;
    this.m_shadowPrepareGraph.m_shadowPreparationOutcome.ready = false;
    RendererFrameGraphFeatures frameGraphFeatures;
    frameGraphFeatures.frameLaggedAsyncLightingEnabled = this.m_frameLaggedAsyncLightingEnabled;
    frameGraphFeatures.laggedLightingHistoryReady = laggedLightingHistoryResourcesReady;
    frameGraphFeatures.laggedLightingHistoryReadReady = priorLaggedLightingHistoryReadReadyToken.valid();
    frameGraphFeatures.laggedLightingHistoryWriterWaitPending = laggedLightingHistoryWriterWaitPending;
    frameGraphFeatures.hasTransparentRenderers = hasTransparentRenderers;
    frameGraphFeatures.hardwareCaustics = hardwareShadowSupported;
    this.m_raytracingSystem.discardSoftShadowTemporalHistory();

    const RayTracingFrameCpuStateSnapshot rayTracingCpuState = this.m_rayTracingState.captureFrameCpuState();
    const b8 avboitTargetsNeedClear = this.m_avboitSystem.captureTargetClearState();
    const b8 deferredBindlessSlotsUploaded = deferredTargets.bindless.slotsUploaded;
    const RayTracingShadowPreparationResourceSnapshot rayTracingShadowResources = this.m_raytracingSystem.snapshotShadowPreparationResources();
    const RayTracingDeferredGraphResourceSnapshot rayTracingGraphResources = this.m_raytracingSystem.snapshotDeferredGraphResources();
    const RayTracingSurfelPersistentResourceSnapshot rayTracingSurfelResources = this.m_raytracingSystem.snapshotSurfelPersistentResources();
    FrameExecuteCpuSnapshot executeCpuRestoreSnapshot = FrameExecuteCpuSnapshot();
    executeCpuRestoreSnapshot.rayTracing = rayTracingCpuState;
    executeCpuRestoreSnapshot.avboitTargetsNeedClear = avboitTargetsNeedClear;
    executeCpuRestoreSnapshot.deferredBindlessSlotsUploaded = deferredBindlessSlotsUploaded;
    const QueueSubmissionToken surfelCounterReadbackCompletionToken = rayTracingCpuState.surfelCountReadbackSubmissionToken;

    FrameExecuteTimingState timing(this.m_graphics);
    b8 shadowVisibilityOpaqueProduced = false;
    b8 shadowVisibilityTransparentTraceProduced = false;
    u32 shadowVisibilityOpaqueFrameIndex = 0u;
    const b8 clearAvboitTargets = this.m_avboitSystem.shouldClearTargets(hasTransparentRenderers);
    in FramebufferInfoEx meshViewFramebufferInfo = deferredTargets.framebuffer.deref().getFramebufferInfo();
    const f32 meshViewAspectRatio = ResolveMeshViewFramebufferAspectRatio(meshViewFramebufferInfo.width, meshViewFramebufferInfo.height, s_CameraFallbackAspectRatio);
    GpuGraphPayloadLifetimeScope graphPayloadLifetime(this.m_deferredLightingSubmissionTransaction, this.m_deferredLightingTaskGraph, this.m_deferredLightingCompiledGraph);
    b8 captureLightingHistory = requestsLaggedLightingHistoryCapture;
    while(true){
        this.buildDeferredLightingTaskGraph(
            frameGraphFeatures,
            csgFrameState,
            clearAvboitTargets,
            hasTransparentRenderers,
            hasOpaqueCsgFrameWork,
            meshViewAspectRatio,
            presentationFrame,
            timing.asyncPrefixTimingSpansOnePacket,
            surfelCounterReadbackCompletionToken,
            priorLaggedLightingHistoryReadReadyToken,
            priorLaggedLightingHistoryWriterDrainToken,
            captureLightingHistory,
            deferredTargets,
            timing.frameTimingTransaction,
            timing.asyncPrefixTiming,
            timing.deferredClearTiming,
            timing.deferredClearTimingState,
            timing.opaqueCsgIntervalClearTimingState,
            timing.opaqueRegularSharedComputeEmulationTiming,
            timing.opaqueCsgIntervalSampleComputeEmulationTiming,
            timing.shadowPrepareTimingTicket,
            timing.graphicsPrefixTimingTickets,
            timing.asyncFinalTiming,
            timing.avboitPreTimingTicket,
            timing.avboitClearTimingState,
            timing.transparentCsgIntervalClearTimingState,
            timing.transparentCsgIntervalsTiming,
            timing.avboitOccupancyComputeEmulationTiming,
            timing.avboitExtinctionComputeEmulationTiming,
            timing.avboitAccumulationComputeEmulationTiming,
            timing.avboitDepthWarpTimingTicket,
            timing.avboitExtinctionTimingTicket,
            timing.avboitIntegrationTimingTicket,
            timing.avboitAccumulationTimingTicket,
            timing.shadowVisibilityTimingTicket,
            timing.shadowVisibilityAsyncTiming,
            timing.shadowVisibilityTiming,
            timing.opaqueSoftResolveTiming,
            timing.transparentSoftResolveTiming,
            shadowVisibilityOpaqueProduced,
            shadowVisibilityTransparentTraceProduced,
            shadowVisibilityOpaqueFrameIndex,
            timing.softwareCausticsTimingTicket,
            timing.surfelGiTimingTicket,
            timing.surfelGiAsyncTiming,
            timing.hardwareCausticsTimingTicket,
            timing.causticPhotonTiming,
            timing.causticResolveTiming,
            timing.deferredLightingTimingTicket,
            timing.deferredCompositeTimingTicket,
            timing.deferredPresentTimingTicket
        );

        if(!captureLightingHistory || this.m_deferredLightingTaskGraphDeclared)
            break;
        warning("RendererSystem: deferred graph build with optional lagged lighting-history capture failed; retrying without the tail");
        captureLightingHistory = false;
        this.resetFrameTaskState();
    }
    this.m_materialSystem.clearPreparedFrameCache();
    const b8 deferredGraphScheduled = this.scheduleDeferredLightingTaskGraphForExecution();
    const GpuTaskGraphDeclarationReadView deferredTaskGraphView(this.m_deferredLightingTaskGraph);
    const GpuCompiledGraphReadView deferredCompiledPlan(this.m_deferredLightingCompiledGraph);
    const b8 captureLaggedLightingHistory = this.m_deferredLaggedLightingHistoryTask.valid();
    DeferredFrameTopologyValidator topologyValidator(this);
    const Expected<DeferredFrameTopologyResult> topologyResult = topologyValidator.validate(
        deferredCompiledPlan,
        deferredTaskGraphView,
        timing,
        primaryGraphicsQueue,
        deferredGraphScheduled,
        captureLaggedLightingHistory,
        hardwareShadowSupported,
        hasOpaqueCsgFrameWork,
        hasTransparentRenderers,
        clearAvboitTargets,
        laggedAsyncLightingSchedule,
        laggedLightingHistoryWriterWaitPending,
        surfelCounterReadbackCompletionToken.valid()
    );
    if(!topologyResult.has_value()){
        timing.discardTickets();
        this.m_rayTracingState.restorePreparedLightingCpuState(rayTracingCpuState);
        return;
    }
    in DeferredFrameTopologyResult topology = topologyResult.value();

    const usize graphicsPrefixUniquePacketCount = topology.graphicsPrefixUniquePacketCount;
    in RendererAvboitTaskGraphValidation avboitValidation = topology.avboitValidation;
    const GpuTaskId terminalPresentationTask = topology.terminalPresentationTask;
    const Optional<GpuPhysicalQueueInfo> surfelGiCounterReadbackQueue = topology.surfelGiCounterReadbackQueue;
    const Optional<GpuPhysicalQueueInfo> deferredLaggedLightingHistoryQueue = topology.laggedLightingHistoryQueue;
    FrameExecuteRecovery recovery(this, timing.frameTimingTransaction, deferredCompiledPlan);

    FrameExecuteStateLifecycleSet lifecycles(this, deferredTargets, rayTracingShadowResources, rayTracingGraphResources, rayTracingSurfelResources, hardwareShadowSupported, laggedAsyncLightingSchedule);
    this.m_avboitSystem.markFrameTargetUsage(hasTransparentRenderers);

    Array<GpuTaskGraphTaskTimingTicket, s_DeferredTimingTicketCapacity> normalTimingTickets;
    const auto normalTimingTicketCount = timing.bindNormalTimingTickets(this, deferredCompiledPlan, topology.graphicsPrefixTimingTasks, graphicsPrefixUniquePacketCount, avboitValidation, hardwareShadowSupported, normalTimingTickets);
    if(!normalTimingTicketCount.has_value()){
        error("RendererSystem: failed to bind normal deferred graph timing");
        DiscardRendererFramePackets(
            timing, recovery, deferredCompiledPlan, this.m_deferredLightingSubmissionTransaction, this.m_shadowPrepareGraph.m_deferredShadowPrepareTask,
            executeCpuRestoreSnapshot, this.m_graphics, this.m_meshSystem, this.m_deferredSystem, this.m_rayTracingState, this.m_avboitSystem, this.m_raytracingSystem, deferredTargets
        );
        return;
    }

    const QueueSubmissionPreSubmitHook framePresentationSignal = this.m_graphics.claimFramePresentationSignal();
    GpuTaskGraphTaskSubmissionHook terminalHook;
    terminalHook.task = terminalPresentationTask;
    terminalHook.hook = framePresentationSignal;
    const Array<GpuTaskGraphTaskSubmissionHook, 1u> terminalHooks(terminalHook);
    GpuTaskGraphNormalExecutionDesc normalExecution;
    normalExecution.terminalTask = terminalPresentationTask;
    const Span<GpuTaskGraphTaskRecordedCallback> recordedCallbacks = Span<GpuTaskGraphTaskRecordedCallback>(lifecycles.recordedCallbacks).first(lifecycles.recordedCallbackCount);
    normalExecution.setRecordedCallbacks(recordedCallbacks);
    normalExecution.setReadyFrontierScheduler(this.m_world.taskScheduler());
    const Span<GpuTaskGraphTaskTimingTicket> timingTickets = Span<GpuTaskGraphTaskTimingTicket>(normalTimingTickets).first(normalTimingTicketCount.value());
    normalExecution.setTimingTickets(timingTickets);
    const Span<GpuTaskGraphTaskAcceptedCallback> acceptedCallbacks = Span<GpuTaskGraphTaskAcceptedCallback>(lifecycles.acceptedCallbacks).first(lifecycles.acceptedCallbackCount);
    normalExecution.setAcceptedCallbacks(acceptedCallbacks);
    if(framePresentationSignal.valid())
        normalExecution.setSubmissionHooks(Span<GpuTaskGraphTaskSubmissionHook>(terminalHooks));

    in GpuTaskScheduler normalScheduler = this.m_graphics.gpuTasks();
    const b8 normalGraphAccepted = normalScheduler.executeGraphWithTiming(
        normalExecution,
        this.m_deferredLightingTaskGraph,
        this.m_deferredLightingCompiledGraph,
        this.m_deferredLightingRecordedGraph,
        this.m_deferredLightingSubmissionTransaction,
        this.m_graphics.gpuTiming()
    );

    const QueueSubmissionToken frameTimingBeginSubmissionToken = this.m_deferredLightingSubmissionTransaction.taskToken(deferredCompiledPlan, this.m_deferredFrameTimingBeginTask);
    const QueueSubmissionToken shadowPrepareSubmissionToken = this.m_deferredLightingSubmissionTransaction.taskToken(deferredCompiledPlan, this.m_shadowPrepareGraph.m_deferredShadowPrepareTask);
    const QueueSubmissionToken graphicsPrefixSubmissionToken = this.m_deferredLightingSubmissionTransaction.taskToken(deferredCompiledPlan, this.m_graphicsPrefixGraph.m_graphicsPrefixTask);
    const QueueSubmissionToken shadowVisibilitySubmissionToken = this.m_deferredLightingSubmissionTransaction.taskToken(deferredCompiledPlan, this.m_shadowVisibilityGraph.m_deferredShadowVisibilityTask);
    GpuTaskId selectedCausticsTask = this.m_causticsGraph.m_deferredSoftwareCausticsTask;
    if(hardwareShadowSupported)
        selectedCausticsTask = this.m_causticsGraph.m_deferredHardwareCausticsTask;
    const QueueSubmissionToken selectedCausticsSubmissionToken = this.m_deferredLightingSubmissionTransaction.taskToken(deferredCompiledPlan, selectedCausticsTask);
    const QueueSubmissionToken surfelGiSubmissionToken = this.m_deferredLightingSubmissionTransaction.taskToken(deferredCompiledPlan, this.m_surfelGiGraph.m_deferredSurfelGiTask);
    const QueueSubmissionToken avboitPreSubmissionToken = this.m_deferredLightingSubmissionTransaction.taskToken(deferredCompiledPlan, avboitValidation.stage().firstTask);
    const QueueSubmissionToken avboitCompletionSubmissionToken = this.m_deferredLightingSubmissionTransaction.taskToken(deferredCompiledPlan, avboitValidation.stage().completionTask);
    const QueueSubmissionToken deferredLightingSubmissionToken = this.m_deferredLightingSubmissionTransaction.taskToken(deferredCompiledPlan, this.m_deferredLightingTask);
    const QueueSubmissionToken deferredCompositeSubmissionToken = this.m_deferredLightingSubmissionTransaction.taskToken(deferredCompiledPlan, this.m_deferredCompositeTask);
    const QueueSubmissionToken deferredPresentSubmissionToken = this.m_deferredLightingSubmissionTransaction.taskToken(deferredCompiledPlan, this.m_deferredPresentTask);
    const QueueSubmissionToken finalPresentationSubmissionToken = this.m_deferredLightingSubmissionTransaction.taskToken(deferredCompiledPlan, terminalPresentationTask);

    b8 presentationSignalReady = true;
    if(framePresentationSignal.valid()){
        if(finalPresentationSubmissionToken.valid()){
            presentationSignalReady = this.m_graphics.confirmFramePresentationSignal(framePresentationSignal, finalPresentationSubmissionToken);
            if(!presentationSignalReady && !this.m_graphics.cancelFramePresentationSignal(framePresentationSignal))
                this.m_graphics.requestDeviceRecreation();
        }
        else{
            presentationSignalReady = false;
            if(!this.m_graphics.cancelFramePresentationSignal(framePresentationSignal))
                this.m_graphics.requestDeviceRecreation();
        }
    }

    const b8 selectedCausticsStateReady = lifecycles.selectedCausticsStateReady(hardwareShadowSupported);
    const b8 normalSemanticTokensReady = AreNormalExecutionSemanticTokensReady(
        frameTimingBeginSubmissionToken.valid(),
        frameTimingBeginSubmissionToken.matchesPhysicalQueue(primaryGraphicsQueue.index, primaryGraphicsQueue.deviceGeneration),
        shadowPrepareSubmissionToken.valid(),
        graphicsPrefixSubmissionToken.valid(),
        shadowVisibilitySubmissionToken.valid(),
        selectedCausticsSubmissionToken.valid(),
        surfelGiSubmissionToken.valid(),
        avboitPreSubmissionToken.valid(),
        avboitCompletionSubmissionToken.valid(),
        deferredLightingSubmissionToken.valid(),
        deferredCompositeSubmissionToken.valid(),
        deferredPresentSubmissionToken.valid(),
        finalPresentationSubmissionToken.valid()
    );
    const b8 normalStateReady = AreNormalExecutionLifecycleStatesReady(
        lifecycles.shadowPrepareStateLifecycle.stateReady,
        lifecycles.shadowVisibilityStateLifecycle.stateReady,
        selectedCausticsStateReady,
        lifecycles.surfelGiStateLifecycle.stateReady,
        lifecycles.deferredLightingStateLifecycle.stateReady
    );
    const b8 acceptedStateLost = HasLostAcceptedNormalLifecycleState(
        shadowPrepareSubmissionToken.valid(),
        lifecycles.shadowPrepareStateLifecycle.stateReady,
        shadowVisibilitySubmissionToken.valid(),
        lifecycles.shadowVisibilityStateLifecycle.stateReady,
        selectedCausticsSubmissionToken.valid(),
        selectedCausticsStateReady,
        surfelGiSubmissionToken.valid(),
        lifecycles.surfelGiStateLifecycle.stateReady,
        deferredLightingSubmissionToken.valid(),
        lifecycles.deferredLightingStateLifecycle.stateReady
    );

    b8 frameTimingEndReady = true;
    if(finalPresentationSubmissionToken.valid()){
        frameTimingEndReady = timing.frameTimingTransaction.confirmEndSubmission(finalPresentationSubmissionToken, true);
        if(!frameTimingEndReady){
            warning("RendererSystem: failed to confirm frame critical-path timing");
            timing.frameTimingTransaction.discard();
        }
    }
    if(!normalGraphAccepted || !normalSemanticTokensReady || !normalStateReady || !presentationSignalReady){
        const b8 hadAcceptedPackets = this.m_deferredLightingSubmissionTransaction.hasAcceptedPackets();
        b8 recovered = true;
        if(!hadAcceptedPackets)
            DiscardRendererFramePackets(
            timing, recovery, deferredCompiledPlan, this.m_deferredLightingSubmissionTransaction, this.m_shadowPrepareGraph.m_deferredShadowPrepareTask,
            executeCpuRestoreSnapshot, this.m_graphics, this.m_meshSystem, this.m_deferredSystem, this.m_rayTracingState, this.m_avboitSystem, this.m_raytracingSystem, deferredTargets
        );
        else{
            recovered = recovery.recoverPendingFrameThenDiscardUnaccepted();
            timing.discardTickets();

            if(!shadowPrepareSubmissionToken.valid())
                RestorePostGbufferPacketCpuState(executeCpuRestoreSnapshot, true, this.m_meshSystem, this.m_deferredSystem, this.m_rayTracingState, this.m_avboitSystem, deferredTargets);
            else{
                if(!graphicsPrefixSubmissionToken.valid())
                    RestorePrefixCpuState(this.m_meshSystem, this.m_deferredSystem);
                if(!shadowVisibilitySubmissionToken.valid()){
                    this.m_rayTracingState.restoreShadowPacketCpuState(rayTracingCpuState);
                    this.m_raytracingSystem.discardSoftShadowTemporalHistory();
                }
                if(!selectedCausticsSubmissionToken.valid())
                    this.m_rayTracingState.restoreCausticPacketCpuState(rayTracingCpuState);
                if(!surfelGiSubmissionToken.valid())
                    this.m_rayTracingState.restoreSurfelGiPacketCpuState(rayTracingCpuState);
                if(!avboitPreSubmissionToken.valid())
                    this.m_avboitSystem.restoreTargetClearState(avboitTargetsNeedClear);
            }
        }

        if(deferredPresentSubmissionToken.valid() && !finalPresentationSubmissionToken.valid()){
            [essential] warning("RendererSystem: acquired back buffer was written before presentation suffix rejection; requesting recreation");
            this.m_graphics.requestDeviceRecreation();
        }
        if(!presentationSignalReady && finalPresentationSubmissionToken.valid())
            [essential] warning("RendererSystem: terminal graph presentation signal confirmation failed");
        else
            error("RendererSystem: graph-owned normal deferred execution was rejected");
        if(ShouldFailFrameRenderRecoveryOnRejection(recovered, acceptedStateLost, presentationSignalReady, finalPresentationSubmissionToken.valid()))
            recovery.failFrameRenderRecovery();
        return;
    }

    if(!dedicatedAsyncCompute && this.m_frameLaggedAsyncLightingEnabled)
        this.reportLaggedLightingTransition(LaggedLightingReport::NoDedicatedAsyncCompute, deferredTargets.laggedLightingHistory.generation);
    else if(this.m_laggedLightingCurrentFrameAcceptancePending){
        this.reportLaggedLightingTransition(LaggedLightingReport::CurrentFrameAccepted, deferredTargets.laggedLightingHistory.generation);
        this.m_laggedLightingCurrentFrameAcceptancePending = false;
    }

    FrameExecutePresentTails presentTails(this, recovery, deferredCompiledPlan, finalPresentationSubmissionToken);
    if(!presentTails.executeSurfelCounterReadback(surfelGiCounterReadbackQueue, lifecycles.surfelGiCounterBuffers))
        return;
    presentTails.executeLaggedLightingHistoryCapture(deferredTargets, deferredLaggedLightingHistoryQueue, requestsLaggedLightingHistoryCapture, captureLaggedLightingHistory, laggedAsyncLightingSchedule);
}


