////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static_assert(size_of<Vertex>() == s_ShaderUiVertexByteSize, "UI shader ABI requires NWB_UI_VERTEX_BYTE_SIZE");
static_assert(offset_of<Vertex>(position) == s_ShaderUiVertexPositionByteOffset, "UI shader ABI requires NWB_UI_VERTEX_POSITION_BYTE_OFFSET");
static_assert(offset_of<Vertex>(texCoord) == s_ShaderUiVertexUvByteOffset, "UI shader ABI requires NWB_UI_VERTEX_UV_BYTE_OFFSET");
static_assert(offset_of<Vertex>(color) == s_ShaderUiVertexColorByteOffset, "UI shader ABI requires NWB_UI_VERTEX_COLOR_BYTE_OFFSET");
static_assert(size_of<GpuPaintPushConstants>() == s_ShaderUiPushConstantsByteSize, "UI shader ABI requires NWB_UI_PUSH_CONSTANTS_BYTE_SIZE");
static_assert(offset_of<GpuPaintPushConstants>(scale) == s_ShaderUiPushConstantsScaleByteOffset, "UI shader ABI requires NWB_UI_PUSH_CONSTANTS_SCALE_BYTE_OFFSET");
static_assert(offset_of<GpuPaintPushConstants>(translate) == s_ShaderUiPushConstantsTranslateByteOffset, "UI shader ABI requires NWB_UI_PUSH_CONSTANTS_TRANSLATE_BYTE_OFFSET");
static_assert(offset_of<GpuPaintPushConstants>(textureSlot) == s_ShaderUiPushConstantsTextureSlotByteOffset, "UI shader ABI requires NWB_UI_PUSH_CONSTANTS_TEXTURE_SLOT_BYTE_OFFSET");
static_assert(offset_of<GpuPaintPushConstants>(samplerSlot) == s_ShaderUiPushConstantsSamplerSlotByteOffset, "UI shader ABI requires NWB_UI_PUSH_CONSTANTS_SAMPLER_SLOT_BYTE_OFFSET");
static_assert(offset_of<GpuPaintPushConstants>(material) == s_ShaderUiPushConstantsMaterialByteOffset, "UI shader ABI requires NWB_UI_PUSH_CONSTANTS_MATERIAL_BYTE_OFFSET");
static_assert(offset_of<GpuPaintPushConstants>(sdfChannel) == s_ShaderUiPushConstantsSdfChannelByteOffset, "UI shader ABI requires NWB_UI_PUSH_CONSTANTS_SDF_CHANNEL_BYTE_OFFSET");
static_assert(offset_of<GpuPaintPushConstants>(sdfSpreadPixels) == s_ShaderUiPushConstantsSdfSpreadByteOffset, "UI shader ABI requires NWB_UI_PUSH_CONSTANTS_SDF_SPREAD_BYTE_OFFSET");
static_assert(offset_of<GpuPaintPushConstants>(sdfDistanceEncoding) == s_ShaderUiPushConstantsSdfEncodingByteOffset, "UI shader ABI requires NWB_UI_PUSH_CONSTANTS_SDF_ENCODING_BYTE_OFFSET");
static_assert(size_of<GpuOutputPushConstants>() == s_ShaderUiOutputPushConstantsByteSize, "UI shader ABI requires NWB_UI_OUTPUT_PUSH_CONSTANTS_BYTE_SIZE");
static_assert(offset_of<GpuOutputPushConstants>(textureSlot) == s_ShaderUiOutputPushConstantsTextureSlotByteOffset, "UI shader ABI requires NWB_UI_OUTPUT_PUSH_CONSTANTS_TEXTURE_SLOT_BYTE_OFFSET");
static_assert(offset_of<GpuOutputPushConstants>(samplerSlot) == s_ShaderUiOutputPushConstantsSamplerSlotByteOffset, "UI shader ABI requires NWB_UI_OUTPUT_PUSH_CONSTANTS_SAMPLER_SLOT_BYTE_OFFSET");
static_assert(offset_of<GpuOutputPushConstants>(presentationMode) == s_ShaderUiOutputPushConstantsPresentationModeByteOffset, "UI shader ABI requires NWB_UI_OUTPUT_PUSH_CONSTANTS_PRESENTATION_MODE_BYTE_OFFSET");
static_assert(cast<u32>(PaintMaterial::Solid) == s_ShaderUiMaterialSolid, "UI shader ABI requires NWB_UI_MATERIAL_SOLID");
static_assert(cast<u32>(PaintMaterial::Skin) == s_ShaderUiMaterialSkin, "UI shader ABI requires NWB_UI_MATERIAL_SKIN");
static_assert(cast<u32>(PaintMaterial::Glyph) == s_ShaderUiMaterialGlyph, "UI shader ABI requires NWB_UI_MATERIAL_GLYPH");
static_assert(cast<u32>(PaintMaterial::SdfGlyph) == s_ShaderUiMaterialSdfGlyph, "UI shader ABI requires NWB_UI_MATERIAL_SDF_GLYPH");
static_assert(cast<u32>(PaintMaterial::Image) == s_ShaderUiMaterialImage, "UI shader ABI requires NWB_UI_MATERIAL_IMAGE");
static_assert(s_FontAtlasDistanceEncoding == s_ShaderUiSdfDistanceEncodingFreetypeU8, "UI shader ABI requires NWB_UI_SDF_DISTANCE_ENCODING_FREETYPE_U8");


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

