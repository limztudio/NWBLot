////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_font/asset.adhd>
#include <impl/assets_font_atlas/cook.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ExtractFontAtlasDependencies(in CookDependencyItemContext context, mut ICookDependencyCollector collector){
    const Expected<AssetRef<Font>> fontRef = ReadMetadataAssetRefField<Font>(context.nwbFilePath, context.asset, s_FontAtlasMetaDiagnosticPrefix, s_FontAtlasMetaFontField, true);
    if(!fontRef.has_value())
        return false;
    return collector.addAssetDependency(fontRef.value().name(), Font::AssetTypeName());
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<FontAtlas> CookFontAtlasVolumeEntry(in FontAtlasCookEntry entry){
    return BuildFontAtlasAsset(entry);
}

b8 RegisterFontAtlasCookDependency(mut CookDependencyRegistry registry){
    return registry.registerType(FontAtlas::AssetTypeName(), ExtractFontAtlasDependencies);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

