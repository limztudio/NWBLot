////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_DEPENDENCY_COMPUTER_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using MetascriptDocument = Core::Metascript::Document;
using MetascriptValue = Core::Metascript::Value;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_DEPENDENCY_COMPUTER_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class DependencyPathHints{
    private HashMap<Name, String> m_texts;

    public void reserve(in usize count){
        this.m_texts.reserve(count);
    }

    public void record(in StringView rawText){
        const Expected<StringView> trimmed = TryTrimVirtualPathText(rawText);
        if(!trimmed.has_value())
            return;

        const StringView trimmedText = trimmed.value();
        const Expected<Name> parsedName = ParseName(trimmedText);
        if(!parsedName.has_value())
            return;

        const Name key = parsedName.value();
        if(!this.m_texts.contains(key))
            this.m_texts.try_emplace(key, String(trimmedText));
    }

    public void collectValue(in MetascriptValue value){
        native(mut texts = this.m_texts, in value){
            (void)texts;
            if(value.isString()){
                const Core::Metascript::MStringView str = value.asString();
                this->record(AStringView(str.data(), str.size()));
                return;
            }
            if(value.isList()){
                for(const Core::Metascript::Value& item : value.asList())
                    this->collectValue(item);
                return;
            }
            if(value.isMap()){
                for(const auto& [key, fieldValue] : value.asMap()){
                    this->record(AStringView(key.data(), key.size()));
                    this->collectValue(fieldValue);
                }
            }
        }
    }

    public void collectDocument(in MetascriptDocument doc){
        native(mut texts = this.m_texts, in doc){
            (void)texts;
            for(const Core::Metascript::Document::Declaration& declaration : doc.declarations()){
                const Core::Metascript::MStringView varView(declaration.variable.data(), declaration.variable.size());
                if(const Core::Metascript::Value* value = doc.findVariable(varView))
                    this->collectValue(*value);
            }
        }
    }

    public StringView lookup(in Name virtualPath)const{
        if(this.m_texts.contains(virtualPath))
            return StringView(this.m_texts.at(virtualPath));
        return virtualPath.resolvedText();
    }
}


