const u32 s_CleanupWaitIntervalMS = 20u;
const u32 s_CleanupTaskTimeoutMS = 4000u;


void VerifyCpuTaskCancellationTests_OldGenerationsKeepDistinctResultsAcrossRepeatedReuse(){
    const usize count = 1024u;
    u32 originalCallbacks = 0u;
    u32 laterCallbacks = 0u;
    Vector<CpuTaskHandle> history = Vector<CpuTaskHandle>();
    history.resize(count, CpuTaskHandle());
    CpuTaskScheduler scheduler(0u);
    for(usize index = 0u; index < count; ++index){
        CpuTaskScope scope(scheduler);
        const auto historyTaskAdmission = scope.submit(lambda[mut originalCallbacks]() -> void{
            ++originalCallbacks;
        });
        ASSERT_TRUE(historyTaskAdmission.has_value());
        history[index] = historyTaskAdmission.value();
        ASSERT_TRUE(history[index].valid());
        EXPECT_EQ(history[index].index, history[0u].index);
        if(index % 2u == 0u){
            scope.cancel();
        }
        scope.wait();
    }
    EXPECT_EQ(originalCallbacks, cast<u32>(count / 2u));
    for(usize index = 0u; index < count; ++index){
        const u32 before = laterCallbacks;
        const auto taskAdmission = scheduler.submit(lambda[mut laterCallbacks]() -> void{
            ++laterCallbacks;
        }, history[index]);
        ASSERT_TRUE(taskAdmission.has_value());
        const CpuTaskHandle task = taskAdmission.value();
        ASSERT_TRUE(task.valid());
        scheduler.wait(task);
        EXPECT_EQ(laterCallbacks - before, cast<u32>(index % 2u));
    }
    const auto stats = scheduler.statistics();
    EXPECT_EQ(laterCallbacks, cast<u32>(count / 2u));
    EXPECT_EQ(stats.canceledTasks, cast<u64>(count));
    EXPECT_EQ(stats.outstandingTasks, 0u);
}

void VerifyCpuTaskCancellationTests_CancellationIsIndexedBySlotAsWellAsGeneration(){
    const usize count = 256u;
    u32 canceledCallbacks = 0u;
    u32 completedCallbacks = 0u;
    Vector<CpuTaskHandle> rejected = Vector<CpuTaskHandle>();
    Vector<CpuTaskHandle> accepted = Vector<CpuTaskHandle>();
    rejected.resize(count, CpuTaskHandle());
    accepted.resize(count, CpuTaskHandle());
    CpuTaskScheduler scheduler(0u);
    CpuTaskScope canceled(scheduler);
    CpuTaskScope completed(scheduler);
    for(usize index = 0u; index < count; ++index){
        const auto rejectedTaskAdmission = canceled.submit(lambda[mut canceledCallbacks]() -> void{
            ++canceledCallbacks;
        });
        ASSERT_TRUE(rejectedTaskAdmission.has_value());
        rejected[index] = rejectedTaskAdmission.value();
        const auto acceptedTaskAdmission = completed.submit(lambda[mut completedCallbacks]() -> void{
            ++completedCallbacks;
        });
        ASSERT_TRUE(acceptedTaskAdmission.has_value());
        accepted[index] = acceptedTaskAdmission.value();
        ASSERT_TRUE(rejected[index].valid());
        ASSERT_TRUE(accepted[index].valid());
        EXPECT_EQ(rejected[index].generation, accepted[index].generation);
        EXPECT_NE(rejected[index].index, accepted[index].index);
    }
    canceled.cancel();
    canceled.wait();
    completed.wait();
    for(usize index = 0u; index < count; ++index){
        const auto cpuTaskAdmission = scheduler.submit(lambda[mut canceledCallbacks]() -> void{
            ++canceledCallbacks;
        }, rejected[index]);
        ASSERT_TRUE(cpuTaskAdmission.has_value());
        ASSERT_TRUE(cpuTaskAdmission.value().valid());
        const auto secondCpuTaskAdmission = scheduler.submit(lambda[mut completedCallbacks]() -> void{
            ++completedCallbacks;
        }, accepted[index]);
        ASSERT_TRUE(secondCpuTaskAdmission.has_value());
        ASSERT_TRUE(secondCpuTaskAdmission.value().valid());
    }
    scheduler.wait();
    EXPECT_EQ(canceledCallbacks, 0u);
    EXPECT_EQ(completedCallbacks, cast<u32>(count * 2u));
    EXPECT_EQ(scheduler.statistics().canceledTasks, cast<u64>(count * 2u));
}

void VerifyCpuTaskCancellationTests_ParallelRangesPreserveHistoryInRecycledSlots(){
    const usize count = 64u;
    u32 canceledCallbacks = 0u;
    u32 rangeCallbacks = 0u;
    u32 interruptedCallbacks = 0u;
    Vector<CpuTaskHandle> history = Vector<CpuTaskHandle>();
    history.resize(count, CpuTaskHandle());
    CpuTaskScheduler scheduler(0u);
    CpuTaskScope canceled(scheduler);
    for(usize index = 0u; index < count; ++index){
        const auto historyTaskAdmission = canceled.submit(lambda[mut canceledCallbacks]() -> void{
            ++canceledCallbacks;
        });
        ASSERT_TRUE(historyTaskAdmission.has_value());
        history[index] = historyTaskAdmission.value();
        ASSERT_TRUE(history[index].valid());
    }
    canceled.cancel();
    canceled.wait();
    const auto firstRange = scheduler.parallelFor(0u, 1u, 1u, lambda[mut rangeCallbacks](in usize index) -> void{
        ++rangeCallbacks;
    });
    EXPECT_TRUE(firstRange.has_value());
    const auto secondRange = scheduler.parallelFor(0u, 128u, 1u, lambda[mut rangeCallbacks](in usize index) -> void{
        ++rangeCallbacks;
    });
    EXPECT_TRUE(secondRange.has_value());
    CpuTaskScope interrupted(scheduler);
    const auto interruptedRange = interrupted.parallelFor(0u, 64u, 1u, lambda[mut interrupted, mut interruptedCallbacks](in usize index) -> void{
        ++interruptedCallbacks;
        if(index == 0u){
            interrupted.cancel();
        }
    });
    EXPECT_TRUE(interruptedRange.has_value());
    interrupted.wait();
    const u64 canceledBeforeDependents = scheduler.statistics().canceledTasks;
    for(in CpuTaskHandle handle : history){
        const auto cpuTaskAdmission = scheduler.submit(lambda[mut canceledCallbacks]() -> void{
            ++canceledCallbacks;
        }, handle);
        ASSERT_TRUE(cpuTaskAdmission.has_value());
        ASSERT_TRUE(cpuTaskAdmission.value().valid());
    }
    scheduler.wait();
    const auto stats = scheduler.statistics();
    EXPECT_GT(interruptedCallbacks, 0u);
    EXPECT_LT(interruptedCallbacks, 64u);
    EXPECT_EQ(rangeCallbacks, 129u);
    EXPECT_EQ(canceledCallbacks, 0u);
    EXPECT_EQ(stats.canceledTasks, canceledBeforeDependents + cast<u64>(count));
    EXPECT_EQ(stats.outstandingTasks, 0u);
}


