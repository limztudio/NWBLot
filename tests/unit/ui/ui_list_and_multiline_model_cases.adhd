InputEvent MakeUiListPointerAt(in InputEventTypeEnum type, in Point position){
    InputEvent event = InputEvent();
    event.type = type;
    event.position = position;
    return event;
}

InputEvent MakeUiListKeyEvent(in InputEventTypeEnum type, in CoreKeyEnum key){
    InputEvent event = InputEvent();
    event.type = type;
    event.key = key;
    return event;
}

ShapeRequest MakeUiListShapeRequest(in StringView text, in f32 fontSize){
    ShapeRequest request = ShapeRequest();
    request.text = text;
    request.fontSize = fontSize;
    return request;
}

ShapeRequest MakeUiListLanguageShapeRequest(in StringView text, in StringView language, in f32 fontSize){
    ShapeRequest request = ShapeRequest();
    request.text = text;
    request.language = language;
    request.fontSize = fontSize;
    return request;
}

InputCommandIntent MakeUiMultilineIntent(in InputCommandEnum command, in b8 extend, in b8 edit){
    InputCommandIntent intent = InputCommandIntent();
    intent.command = command;
    intent.extend = extend;
    intent.edit = edit;
    return intent;
}

EditCommandRequest MakeUiMultilineCommand(in EditCommandEnum command){
    EditCommandRequest request = EditCommandRequest();
    request.command = command;
    return request;
}

EditLimits MakeUiMultilineLimits(in usize maxBytes, in usize maxHistoryRecords, in usize maxHistoryBytes){
    EditLimits limits = EditLimits();
    limits.maxBytes = maxBytes;
    limits.maxHistoryRecords = maxHistoryRecords;
    limits.maxHistoryBytes = maxHistoryBytes;
    return limits;
}


