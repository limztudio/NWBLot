    public f32x4 anisotropicFriction(1.0f, 1.0f, 1.0f, 0.0f);
    public f32x4 frictionDirection(1.0f, 0.0f, 0.0f, 0.0f);
    public u32 contactId = s_NullIndex;
    public u32 shapeIdA = s_NullIndex;
    public u32 shapeIdB = s_NullIndex;
    public u32 colorIndex = s_NullIndex;
    public u32 localIndex = s_NullIndex;
    public u32 islandId = s_NullIndex;
    public u32 islandIndex = s_NullIndex;
    public f32 friction = 0.6f;
    public f32 staticFriction = 0.6f;
    public f32 restitution = 0.0f;
    public f32 rollingResistance = 0.0f;
    public f32 tangentSpeed = 0.0f;
    public f32 invMassScaleA = 1.0f;
    public f32 invMassScaleB = 1.0f;
    public f32 invInertiaScaleA = 1.0f;
    public f32 invInertiaScaleB = 1.0f;
    public f32 maxNormalImpulse = s_MaxF32;
    public u32 flags = 0u;
}

class ContactLink{
    public u32 contactId = s_NullIndex;
