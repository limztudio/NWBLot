    EXPECT_TRUE(SawCapturedError(logger, s_ErrDuplicateRegion));
}

void VerifyAssetsUiSkin_TextureValidationRejectsIdentityDimensionAndExtentMismatch(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, LoggerBreakPolicy::BreakOnFatal);
    UiSkin skin(Name(s_AtlasPath));
    ASSERT_TRUE(skin.loadBinary(MakeBinary(ValidHeader(), ValidRegion())));
    for(u32 variant = 0u; variant < 4u; ++variant){
        const ScopedTestTrace trace(variant);
        Name texName = Name(s_TexturePath);
        if(variant == 0u)
            texName = s_UiTestProjectOther;
        u32 width = 64u;
        if(variant == 1u)
            width = 63u;
        u32 height = 32u;
        if(variant == 2u)
            height = 31u;
        TextureDimensionEnum dimension = TexturePayloadDimension::Texture2D;
        if(variant == 3u)
            dimension = TexturePayloadDimension::TextureCube;
        Texture texture(texName);
        MipLevelVector mips;
        Vector<u8> payload;
        texture.setPayload(
            width,
            height,
            mips,
            payload,
            dimension,
            1u,
            TexturePayloadFormat::UastcLdr4x4,
            TextureAlphaMode::EmbeddedLdr,
            s_TextureOpaqueAlphaUnorm8
        );
        EXPECT_FALSE(skin.validateTexture(texture));
    }
}

