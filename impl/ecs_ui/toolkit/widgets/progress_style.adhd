////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "style.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ProgressOptions{
    public LayoutSize width = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
    public f32 height = s_StyleControlHeight;
}

class ProgressStyle{
    public Name track = Name("progress.track");
    public Name fill = Name("progress.fill");
    public Name trackFallback = Name("scrollbar.track");
    public Name fillFallback = Name("scrollbar.thumb.normal");
    public Insets padding;
    public Color trackTint;
    public Color fillTint;
}

class ProgressMetrics{
    public Insets padding;
    public Point fillMinimum;
    public Point contentSize;
}

class ProgressPlacement{
    public Rect bounds;
    public Rect clip;
    public Rect content;
    public Rect fillReveal;
    public Rect fillCanvas;
}

// Each declaration owns its value, policy, resolved semantic names and skin metrics.
class ProgressFrame{
    public f64 fraction = 0.0;
    public ProgressOptions options;
    public ProgressStyle style;
    public ProgressMetrics metrics;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

