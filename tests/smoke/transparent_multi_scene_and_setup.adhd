const f32 s_TransparentCameraStartDepth = 2.2f;
const f32 s_TransparentMaxAnimationDelta = 1.0f / 30.0f;
const f32 s_TransparentManualYawSpeed = 0.6f;

const f32x4 s_TransparentLeftShapeBasePosition = f32x4(-0.68f, s_TransparentMultiCameraTargetY, 0.02f, 0.0f);
const f32x4 s_TransparentCenterShapeBasePosition = f32x4(0.0f, s_TransparentMultiCameraTargetY, 0.0f, 0.0f);
const f32x4 s_TransparentRightShapeBasePosition = f32x4(0.68f, s_TransparentMultiCameraTargetY, 0.04f, 0.0f);
const f32x4 s_TransparentOpaqueLeftShapeBasePosition = f32x4(-0.34f, s_TransparentMultiCameraTargetY, 0.30f, 0.0f);
const f32x4 s_TransparentOpaqueRightShapeBasePosition = f32x4(0.34f, s_TransparentMultiCameraTargetY, 0.30f, 0.0f);

const SmokeMeshRef s_TransparentCausticSphereMesh = "project/meshes/caustic_sphere";
const SmokeMeshRef s_TransparentLeftMesh = "project/meshes/cylinder";
const SmokeMeshRef s_TransparentCenterMesh = "project/meshes/octahedron";
const SmokeMeshRef s_TransparentRightMesh = "project/meshes/cone";
const SmokeMeshRef s_TransparentShadowPlaneMesh = "project/meshes/shadow_plane";
const SmokeMaterialRef s_TransparentSharedMaterial = "project/smoke/transparent_multi/materials/shared";
const SmokeMaterialRef s_TransparentGroundMaterial = "project/smoke/transparent_multi/materials/ground";
const SmokeMaterialRef s_TransparentCsgMaterial = "project/smoke/transparent_multi/materials/csg_center";
const SmokeMaterialRef s_TransparentCausticBackdropMaterial = "project/smoke/refraction/materials/opaque";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void ApplyTransparentEntityTransform(
    in EntityID entity,
    in VectorSingle basePosition,
    in VectorSingle sceneRotation,
    in VectorSingle localRotation,
    mut World world
){
    VectorSingle position = VectorSingle(0.0f);
    VectorSingle rotation = VectorSingle(0.0f);
    ComputeTransparentSceneTransform(basePosition, sceneRotation, localRotation, position, rotation);
    const f32x4 storedPosition = f32x4(position);
    const f32x4 storedRotation = f32x4(rotation);
    native(in entity, in storedPosition, in storedRotation, mut world){
        if(auto* transform = world.tryGetComponent<Impl::Scene::TransformComponent>(entity)){
            transform->position = storedPosition;
            transform->rotation = storedRotation;
        }
    }
}

class TransparentMultiSceneTransforms{
    public EntityID leftShape = s_InvalidEntityId;
    public EntityID centerShape = s_InvalidEntityId;
    public EntityID rightShape = s_InvalidEntityId;
    public EntityID opaqueLeftShape = s_InvalidEntityId;
    public EntityID opaqueRightShape = s_InvalidEntityId;
    public EntityID csgReceiver = s_InvalidEntityId;
    public EntityID csgCutter = s_InvalidEntityId;

    public void update(in f32 yaw, mut World world)const{
        const VectorSingle sceneRotation = BuildTransparentSceneRotation(yaw);
        const VectorSingle identityRot = QuaternionIdentity();
        ApplyTransparentEntityTransform(this.leftShape, VectorSingle(s_TransparentLeftShapeBasePosition), sceneRotation, identityRot, world);
        if(s_TransparentMultiEnableCsg){
            const VectorSingle csgLocalRotation = BuildTransparentCsgRotation(yaw);
            VectorSingle receiverPosition = VectorSingle(0.0f);
            VectorSingle receiverRotation = VectorSingle(0.0f);
            ComputeTransparentSceneTransform(
                VectorSingle(s_TransparentCenterShapeBasePosition),
                sceneRotation,
                csgLocalRotation,
                receiverPosition,
                receiverRotation
            );
            const f32x4 storedPos = f32x4(receiverPosition);
            const f32x4 storedRot = f32x4(receiverRotation);
            native(
                in receiverEntity = this.csgReceiver,
                in cutterEntity = this.csgCutter,
                in receiverPosition,
                in receiverRotation,
                in storedPos,
                in storedRot,
                mut world
            ){
                if(auto* transform = world.tryGetComponent<Impl::Scene::TransformComponent>(receiverEntity)){
                    transform->position = storedPos;
                    transform->rotation = storedRot;
                }
#if defined(NWB_TRANSPARENT_MULTI_ENABLE_CSG)
                if(auto* cutter = world.tryGetComponent<Impl::CsgCutterComponent>(cutterEntity))
                    AssignCsgCutterTransform(receiverPosition, receiverRotation, *cutter);
#else
                (void)cutterEntity;
                (void)receiverPosition;
                (void)receiverRotation;
#endif
            }
        }
        else{
            ApplyTransparentEntityTransform(this.centerShape, VectorSingle(s_TransparentCenterShapeBasePosition), sceneRotation, identityRot, world);
        }
        ApplyTransparentEntityTransform(this.rightShape, VectorSingle(s_TransparentRightShapeBasePosition), sceneRotation, identityRot, world);
        ApplyTransparentEntityTransform(this.opaqueLeftShape, VectorSingle(s_TransparentOpaqueLeftShapeBasePosition), sceneRotation, identityRot, world);
        ApplyTransparentEntityTransform(this.opaqueRightShape, VectorSingle(s_TransparentOpaqueRightShapeBasePosition), sceneRotation, identityRot, world);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CreateCausticRefractionBackdrop(mut World world){
    const f32x4 rotation = f32x4(QuaternionRotationRollPitchYawFromVector(VectorSingle(-s_TransparentMultiHalfPi, 0.0f, 0.0f, 0.0f)));
    for(u32 stripe = 0u; stripe < 24u; ++stripe){
        f32 value = 0.04f;
        if((stripe & 1u) != 0u)
            value = 0.92f;
        const f32 x = cast<f32>(stripe) * 0.2f - 2.3f;
        const EntityID entity = CreateTintedStaticMeshEntity(
            s_TransparentShadowPlaneMesh,
            s_TransparentCausticBackdropMaterial,
            NameTextAscii(s_SmokeSurfaceMaterialInterface),
            VectorSingle(value, value, value, 1.0f),
            VectorSingle(x, s_TransparentMultiCameraTargetY, 2.2f, 0.0f),
            VectorSingle(0.1f, 1.0f, 1.3f, 0.0f),
            world
        );
        if(!entity.valid()){
            error("CausticSphereSmokeProject: failed to create screen refraction backdrop");
            return false;
        }
        native(in entity, in rotation, mut world){
            auto& transform = world.entity(entity).getComponent<Impl::Scene::TransformComponent>();
            transform.rotation = rotation;
        }
    }
    [essential] info("CausticSphereSmokeProject: screen refraction striped backdrop created (24 opaque strips)");
    return true;
}

EntityID CreateTransparentStaticMeshEntity(
    in SmokeMeshRef mesh,
    in SmokeMaterialRef material,
    in VectorSingle colorTint,
    in VectorSingle position,
    in VectorSingle scale,
    in Name csgReceiverGroup,
    mut World world
){
    const EntityID entity = CreateTintedStaticMeshEntity(
        mesh,
        material,
        NameTextAscii(s_SmokeSurfaceMaterialInterface),
        colorTint,
        position,
        scale,
        world
    );
    if(!entity.valid())
        return s_InvalidEntityId;
    if(s_TransparentMultiEnableCsg){
        native(in entity, in csgReceiverGroup, mut world){
#if defined(NWB_TRANSPARENT_MULTI_ENABLE_CSG)
            if(csgReceiverGroup)
                AddStaticCsgMeshReceiver(entity, csgReceiverGroup, false, true, world);
#else
            (void)entity;
            (void)csgReceiverGroup;
            (void)world;
#endif
        }
    }
    return entity;
}

b8 PopulateTransparentMultiScene(
    in f32 cameraDistance,
    in b8 causticTiming,
    in f32 yaw,
    mut World world,
    mut TransparentMultiSceneTransforms transforms
){
    const EntityID activeCamera = CreateSmokeCamera(s_TransparentMultiCameraTargetY, cameraDistance, 0.0f, world);
    b8 causticsEnabled = false;
    if(s_TransparentMultiCausticSphere){
        const Expected<f32> causticSetting = ReadSmokeEnvironmentF32("NWB_CAUSTIC_SMOKE_ENABLED");
        causticsEnabled = !causticSetting.has_value() || causticSetting.value() != 0.0f;
        StringView causticsLabel = "disabled";
        if(causticsEnabled)
            causticsLabel = "enabled";
        [essential] info("CausticSphereSmokeProject: caustics {}", causticsLabel);
    }

    EntityID lightEntity = s_InvalidEntityId;
    native(in causticsEnabled, mut world, mut lightEntity){
        lightEntity = Impl::Scene::CreateDirectionalLightEntity(
            world,
            s_TransparentMultiDefaultDirectionalLightPitch,
            s_TransparentMultiDefaultDirectionalLightYaw,
            0.0f,
            Float4(1.0f, 0.96f, 0.88f),
            s_TransparentMultiDefaultDirectionalLightIntensity
        );
        world.entity(lightEntity).getComponent<Impl::Scene::LightComponent>().enableCaustics = causticsEnabled;
    }

    b8 shapesValid = false;
    if(s_TransparentMultiCausticSphere){
        const EntityID centerShapeEntity = CreateTransparentStaticMeshEntity(
            s_TransparentCausticSphereMesh,
            s_TransparentSharedMaterial,
            VectorSingle(0.55f, 0.78f, 1.0f, 0.30f),
            VectorSingle(s_TransparentCenterShapeBasePosition),
            VectorSingle(s_TransparentMultiCausticSphereScale, s_TransparentMultiCausticSphereScale, s_TransparentMultiCausticSphereScale, 0.0f),
            s_NameNone,
            world
        );
        transforms.centerShape = centerShapeEntity;
        shapesValid = centerShapeEntity.valid();
        if(shapesValid){
            native(in centerShapeEntity, mut world){
                world.entity(centerShapeEntity).getComponent<Impl::RendererComponent>().opticalBoundaryMode = Impl::OpticalBoundaryMode::ClosedNested;
            }
        }
    }
    else{
        const EntityID leftEntity = CreateTransparentStaticMeshEntity(
            s_TransparentLeftMesh,
            s_TransparentSharedMaterial,
            VectorSingle(1.0f, 0.42f, 0.20f, 0.42f),
            VectorSingle(s_TransparentLeftShapeBasePosition),
            VectorSingle(0.62f, 0.62f, 0.62f, 0.0f),
            s_NameNone,
            world
        );
        SmokeMaterialRef centerMaterial = s_TransparentSharedMaterial;
        VectorSingle centerTint = VectorSingle(0.10f, 1.0f, 0.45f, 0.42f);
        Name centerReceiverGroup = s_NameNone;
        if(s_TransparentMultiEnableCsg){
            centerMaterial = s_TransparentCsgMaterial;
            centerTint = VectorSingle(0.02f, 1.0f, 0.05f, 0.60f);
            centerReceiverGroup = s_SmokeNameProjectSmokeTransparentMultiCenterReceiver;
        }
        const EntityID centerShapeEntity = CreateTransparentStaticMeshEntity(
            s_TransparentCenterMesh,
            centerMaterial,
            centerTint,
            VectorSingle(s_TransparentCenterShapeBasePosition),
            VectorSingle(0.78f, 0.78f, 0.78f, 0.0f),
            centerReceiverGroup,
            world
        );
        const EntityID rightShapeEntity = CreateTransparentStaticMeshEntity(
            s_TransparentRightMesh,
            s_TransparentSharedMaterial,
            VectorSingle(0.12f, 0.44f, 1.0f, 0.42f),
            VectorSingle(s_TransparentRightShapeBasePosition),
            VectorSingle(0.68f, 0.68f, 0.68f, 0.0f),
            s_NameNone,
            world
        );
        transforms.leftShape = leftEntity;
        transforms.centerShape = centerShapeEntity;
        transforms.rightShape = rightShapeEntity;

        const EntityID opaqueLeftEntity = CreateTintedStaticMeshEntity(
            s_TransparentCenterMesh,
            s_TransparentGroundMaterial,
            NameTextAscii(s_SmokeSurfaceMaterialInterface),
            VectorSingle(0.66f, 0.66f, 0.70f, 1.0f),
            VectorSingle(s_TransparentOpaqueLeftShapeBasePosition),
            VectorSingle(0.26f, 0.26f, 0.26f, 0.0f),
            world
        );
        const EntityID opaqueRightEntity = CreateTintedStaticMeshEntity(
            s_TransparentRightMesh,
            s_TransparentGroundMaterial,
            NameTextAscii(s_SmokeSurfaceMaterialInterface),
            VectorSingle(0.72f, 0.68f, 0.62f, 1.0f),
            VectorSingle(s_TransparentOpaqueRightShapeBasePosition),
            VectorSingle(0.26f, 0.26f, 0.26f, 0.0f),
            world
        );
        transforms.opaqueLeftShape = opaqueLeftEntity;
        transforms.opaqueRightShape = opaqueRightEntity;
        shapesValid = leftEntity.valid() && centerShapeEntity.valid() && rightShapeEntity.valid() && opaqueLeftEntity.valid() && opaqueRightEntity.valid();
    }

    VectorSingle groundTint = VectorSingle(0.08f, 0.08f, 0.08f, 1.0f);
    if(s_TransparentMultiCausticSphere)
        groundTint = VectorSingle(1.0f, 1.0f, 1.0f, 1.0f);
    const EntityID shadowPlaneEntity = CreateTintedStaticMeshEntity(
        s_TransparentShadowPlaneMesh,
        s_TransparentGroundMaterial,
        NameTextAscii(s_SmokeSurfaceMaterialInterface),
        groundTint,
        VectorSingle(0.0f, -0.08f, 0.08f, 0.0f),
        VectorSingle(1.75f, 1.0f, 1.55f, 0.0f),
        world
    );

    if(s_TransparentMultiCausticSphere){
        if(ReadSmokeEnvironmentFlag("NWB_CAUSTIC_SMOKE_SCREEN_REFRACTION_BACKDROP") && !CreateCausticRefractionBackdrop(world))
            return false;
    }

    b8 csgEntitiesValid = true;
    if(s_TransparentMultiEnableCsg){
        const b8 cutterActive = !ReadSmokeEnvironmentFlag("NWB_TRANSPARENT_CSG_DISABLE_CUTTER");
        EntityID cutterEntity = s_InvalidEntityId;
        native(in cutterActive, mut world, mut cutterEntity){
#if defined(NWB_TRANSPARENT_MULTI_ENABLE_CSG)
            auto createdCutter = world.createEntity();
            auto& cutter = createdCutter.addComponent<Impl::CsgCutterComponent>();
            cutter.receiverGroup = s_SmokeNameProjectSmokeTransparentMultiCenterReceiver;
            cutter.shapeType = Name(Impl::s_CsgPlaneShapeName);
            cutter.active = cutterActive;
            Impl::CsgPlaneShapeParameters parameters{};
            parameters.normalDistance = Float4(0.0f, -1.0f, 0.0f, 0.0f);
            AssignCsgCutterParameters(parameters, cutter);
            AssignCsgCutterTransform(VectorSet(0.0f, s_TransparentMultiCameraTargetY, 0.0f, 0.0f), QuaternionIdentity(), cutter);
            cutterEntity = createdCutter.id();
#else
            (void)cutterActive;
            (void)world;
#endif
        }
        [essential] info("TransparentCsgSmokeProject: cutter active {}", cutterActive);
        csgEntitiesValid = cutterEntity.valid();
        transforms.csgReceiver = transforms.centerShape;
        transforms.csgCutter = cutterEntity;
    }

    transforms.update(yaw, world);
    [essential] assert(
        activeCamera.valid() && lightEntity.valid() && shapesValid && shadowPlaneEntity.valid() && csgEntitiesValid,
        "TransparentMultiSmokeProjectImpl failed to create all scene entities"
    );

    if(s_TransparentMultiCausticSphere && causticTiming){
        f32 verticalFov = 0.0f;
        native(in activeCamera, mut world, mut verticalFov){
            const auto& camera = world.entity(activeCamera).getComponent<Impl::Scene::CameraComponent>();
            verticalFov = camera.verticalFovRadians();
        }
        [essential] info("CausticTimingProbe: vertical FOV radians {}", verticalFov);
        [essential] info("CausticTimingProbe: scene single-static-sphere-ground-v1");
    }
    [essential] info("TransparentMultiSmokeProjectImpl: shared transparent material with three mutable instance overrides created");
    return true;
}

void ConfigureTransparentMultiRenderer(mut World world, mut ProjectRuntimeContext context){
    b8 rayQueryHardwareAvailable = false;
    native(in ctx = context, mut rayQueryHardwareAvailable){
        rayQueryHardwareAvailable = ctx.graphics.queryFeatureSupport(Core::Feature::RayTracingAccelStruct)
            && ctx.graphics.queryFeatureSupport(Core::Feature::RayQuery);
    }
    if(rayQueryHardwareAvailable)
        [essential] info("TransparentMultiSmokeProjectImpl: natural hardware shadow route selected on RayQuery-capable hardware");
    else
        [essential] info("TransparentMultiSmokeProjectImpl: natural software-only shadow route selected because RayQuery-capable hardware is unavailable");

    if(s_TransparentMultiFrameLaggedAsyncLighting){
        native(mut world, mut context){
            auto& rendererSystem = AddSmokeRenderSystems(world, context);
            rendererSystem.setFrameLaggedAsyncLightingEnabled(true);
        }
        [essential] info("FrameLaggedAsyncLightingSmoke: requested frame-lagged async lighting; F1 toggles the current-frame path");
        return;
    }

    if(s_TransparentMultiCausticSphere){
        const Expected<f32> refractionSetting = ReadSmokeEnvironmentF32("NWB_REFRACTION_SMOKE_ENABLED");
        const b8 refractionEnabled = !refractionSetting.has_value() || refractionSetting.value() != 0.0f;
        const Expected<f32> hardwareSetting = ReadSmokeEnvironmentF32("NWB_REFRACTION_SMOKE_HARDWARE");
        const b8 hardwareEnabled = !hardwareSetting.has_value() || hardwareSetting.value() != 0.0f;
        const Expected<String> reflectionModeText = ReadSmokeEnvironmentString("NWB_REFLECTION_SMOKE_MODE");
        const b8 hasReflectionMode = reflectionModeText.has_value();
        StringView modeView = "";
        if(hasReflectionMode)
            modeView = StringView(reflectionModeText.value());
        const b8 reflectionComparison = ReadSmokeEnvironmentFlag("NWB_CAUSTIC_SMOKE_REFLECTION_COMPARISON");
        const b8 causticTiming = ReadSmokeEnvironmentFlag(s_TransparentMultiCausticTimingEnvironment);

        b8 validMode = true;
        b8 appliedSettings = false;
        u32 traceModeValue = 0u;
        b8 diagEnabled = false;
        b8 temporalEnabled = false;
        b8 spatialEnabled = false;
        b8 feedbackEnabled = false;
        native(
            in refractionEnabled,
            in hardwareEnabled,
            in hasReflectionMode,
            in modeView,
            in reflectionComparison,
            in causticTiming,
            mut world,
            mut context,
            mut validMode,
            mut appliedSettings,
            mut traceModeValue,
            mut diagEnabled,
            mut temporalEnabled,
            mut spatialEnabled,
            mut feedbackEnabled
        ){
            auto& rendererSystem = AddSmokeRenderSystems(world, context);
            rendererSystem.setRefractionEnabled(refractionEnabled);
            rendererSystem.setRefractionHardwareTracingEnabled(hardwareEnabled);
            Impl::ReflectionSettings reflectionSettings;
            if(hasReflectionMode){
                if(modeView == "disabled")
                    reflectionSettings.traceMode = Impl::ReflectionTraceMode::Disabled;
                else if(modeView == "hardware")
                    reflectionSettings.traceMode = Impl::ReflectionTraceMode::Hardware;
                else if(modeView == "screen")
                    reflectionSettings.traceMode = Impl::ReflectionTraceMode::ScreenSpace;
                else if(modeView != "hybrid")
                    validMode = false;
            }
            if(reflectionComparison){
                reflectionSettings.environmentTop = Float3U(0.6f, 0.7f, 1.0f);
                reflectionSettings.environmentBottom = reflectionSettings.environmentTop;
                reflectionSettings.maxHardwareRaysPerFrame = 2u * 1280u * 900u;
                reflectionSettings.temporalEnabled = false;
                reflectionSettings.spatialFilterEnabled = false;
            }
            if(causticTiming){
                reflectionSettings.diagnosticsEnabled = false;
                reflectionSettings.temporalEnabled = false;
                reflectionSettings.spatialFilterEnabled = false;
                reflectionSettings.screenFeedbackEnabled = false;
                diagEnabled = reflectionSettings.diagnosticsEnabled;
                temporalEnabled = reflectionSettings.temporalEnabled;
                spatialEnabled = reflectionSettings.spatialFilterEnabled;
                feedbackEnabled = reflectionSettings.screenFeedbackEnabled;
            }
            traceModeValue = static_cast<u32>(reflectionSettings.traceMode);
            if(validMode)
                appliedSettings = rendererSystem.setReflectionSettings(reflectionSettings);
        }
        [essential] assert(validMode, "CausticSphereSmokeProject: invalid reflection mode");
        if(causticTiming){
            [essential] info(
                "CausticTimingProbe: reflection diagnostics {} temporal {} spatial {} feedback {}"
                , diagEnabled
                , temporalEnabled
                , spatialEnabled
                , feedbackEnabled
            );
        }
        [essential] assert(appliedSettings, "CausticSphereSmokeProject: invalid reflection settings");
        [essential] info("CausticSphereSmokeProject: reflection mode {}", traceModeValue);
        StringView refractionLabel = "disabled";
        if(refractionEnabled)
            refractionLabel = "enabled";
        [essential] info("CausticSphereSmokeProject: camera refraction {}", refractionLabel);
        return;
    }

    if(s_TransparentMultiEnableCsg){
        b8 appliedCsgSettings = false;
        native(mut world, mut context, mut appliedCsgSettings){
            auto& rendererSystem = AddSmokeRenderSystems(world, context);
            rendererSystem.setRefractionEnabled(false);
            Impl::ReflectionSettings reflectionSettings;
            reflectionSettings.traceMode = Impl::ReflectionTraceMode::Disabled;
            appliedCsgSettings = rendererSystem.setReflectionSettings(reflectionSettings);
        }
        [essential] assert(appliedCsgSettings, "TransparentCsgSmokeProject: invalid reflection settings");
        return;
    }

    SetupSmokeRenderSystems(world, context);
}


