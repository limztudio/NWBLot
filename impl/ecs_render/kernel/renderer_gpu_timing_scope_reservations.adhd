b8 ReserveGpuTimingScope(mut KernelGraphicsRuntime graphics, in Name scope, in u32 queryCount){
    if(PrepareKernelGpuTimingScopeQueries(graphics, scope, queryCount))
        return true;

    warning("RendererSystem: failed to prepare GPU timing scope '{}'", scope.resolvedText());
    return false;
}

class RendererGpuTimingScopeReservations{
    public b8 prepare(mut KernelGraphicsRuntime graphics)const{
        return
            ReserveGpuTimingScope(graphics, Name("render.mesh_dispatch"), s_GpuTimingHighFrequencyScopeQueryBudget)
            && ReserveGpuTimingScope(graphics, Name("render.raster"), s_GpuTimingHighFrequencyScopeQueryBudget)
            && ReserveGpuTimingScope(graphics, Name("render.frame"), s_GpuTimingQueriesPerRange)
            && ReserveGpuTimingScope(graphics, Name("render.async_prefix"), s_GpuTimingQueriesPerRange)
            && ReserveGpuTimingScope(graphics, Name("render.async_shadow"), s_GpuTimingQueriesPerRange)
            && ReserveGpuTimingScope(graphics, Name("render.async_surfel_gi"), s_GpuTimingQueriesPerRange)
            && ReserveGpuTimingScope(graphics, Name("render.async_final"), s_GpuTimingQueriesPerRange)
            && ReserveGpuTimingScope(graphics, Name("render.deferred_clear"), s_GpuTimingQueriesPerRange)
            && ReserveGpuTimingScope(graphics, Name("render.shadow_visibility"), s_GpuTimingQueriesPerRange)
            && ReserveGpuTimingScope(graphics, Name("render.shadow.light_space_views"), s_GpuTimingQueriesPerRange)
            && ReserveGpuTimingScope(graphics, Name("render.shadow.light_space_cull"), s_GpuTimingQueriesPerRange)
            && ReserveGpuTimingScope(graphics, Name("render.shadow.light_space_opaque_capture"), s_GpuTimingQueriesPerRange)
