void VerifyUiRadioGroupLoanTests_IdenticalSelectionInAKeyCallbackRejectsBeforeTheNextBorrowedCall(mut UiRadioGroupLoanTests self){
    ASSERT_TRUE(self.accept(1u));
    const UiRadioAcceptedInput128 displayed = self.accepted();
    const u64 token = self.m_state.inputGeneration();
    self.m_source.resetCounters();
    self.m_source.armSelection(self.m_state, UiRadioCallbackSite::Key, 10u);
    EXPECT_FALSE(self.declare(2u));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_EQ(self.m_state.selectedKey(), 10u);
    EXPECT_NE(self.m_state.inputGeneration(), token);
    EXPECT_EQ(self.m_source.m_mutations, 1u);
    EXPECT_EQ(self.m_source.m_callbacksAfterMutation, 0u);
    EXPECT_EQ(self.m_source.m_textCalls, 0u);
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    self.expectAccepted(displayed);
}

void VerifyUiRadioGroupLoanTests_SelectionAwayAndBackInEnabledCallbackCannotPassTheSnapshotFence(mut UiRadioGroupLoanTests self){
    ASSERT_TRUE(self.accept(1u));
    const UiRadioAcceptedInput128 displayed = self.accepted();
    const RadioGroupSnapshot saved = self.m_state.snapshot();
    self.m_source.resetCounters();
    self.m_source.armSelection(self.m_state, UiRadioCallbackSite::Enabled, 10u, true);
    EXPECT_FALSE(self.declare(2u));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_EQ(self.m_state.selectedKey(), 10u);
    EXPECT_EQ(self.m_state.cursorKey(), 10u);
    EXPECT_FALSE(self.m_state.matches(saved));
    EXPECT_EQ(self.m_source.m_mutations, 1u);
    EXPECT_EQ(self.m_source.m_callbacksAfterMutation, 0u);
    self.expectAccepted(displayed);
}

void VerifyUiRadioGroupLoanTests_SourceRevisionChangedMidReconcileIsPreservedWithoutPublishingPartialChoices(mut UiRadioGroupLoanTests self){
    ASSERT_TRUE(self.accept(1u));
    const UiRadioAcceptedInput128 displayed = self.accepted();
    const RadioGroupSnapshot saved = self.m_state.snapshot();
    const u64 revision = self.m_source.m_contentRevision;
    self.m_source.armSource(UiRadioCallbackSite::Key);
    EXPECT_FALSE(self.declare(2u));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_EQ(self.m_source.m_contentRevision, revision + 1u);
    EXPECT_TRUE(self.m_state.matches(saved));
    self.expectAccepted(displayed);
}

void VerifyUiRadioGroupLoanTests_SourceReplacementInsideALabelCallbackRetainsTheApplicationMutation(mut UiRadioGroupLoanTests self){
    ASSERT_TRUE(self.accept(1u));
    const UiRadioAcceptedInput128 displayed = self.accepted();
    const u64 generation = self.m_source.m_generation;
    self.m_source.armSource(UiRadioCallbackSite::Text, true);
    EXPECT_FALSE(self.declare(2u));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_EQ(self.m_source.m_generation, generation + 1u);
    EXPECT_EQ(self.m_state.selectedKey(), 10u);
    self.expectAccepted(displayed);
}

void VerifyUiRadioGroupLoanTests_FinalCountCallbackRevisionMutationRejectsEvenAfterEarlierMetadataMatched(mut UiRadioGroupLoanTests self){
    ASSERT_TRUE(self.accept(1u));
    const UiRadioAcceptedInput128 displayed = self.accepted();
    ASSERT_TRUE(self.declare(2u));
    const RadioGroupSnapshot prepared = self.m_state.snapshot();
    const u64 revision = self.m_source.m_contentRevision;
    self.m_source.armSource(UiRadioCallbackSite::Count);
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.ready());
    EXPECT_EQ(self.m_source.m_contentRevision, revision + 1u);
    EXPECT_TRUE(self.m_state.matches(prepared));
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    self.expectAccepted(displayed);
}

void VerifyUiRadioGroupLoanTests_ExplicitSameValueIntentAfterDeclarationRejectsBeforeAnyFurtherSourceCall(mut UiRadioGroupLoanTests self){
    ASSERT_TRUE(self.accept(1u));
    const UiRadioAcceptedInput128 displayed = self.accepted();
    ASSERT_TRUE(self.declare(2u));
    self.m_source.resetCounters();
    self.m_state.select(10u);
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_EQ(self.m_source.m_calls, 0u);
    EXPECT_EQ(self.m_state.selectedKey(), 10u);
    self.expectAccepted(displayed);
}

void VerifyUiRadioGroupLoanTests_SharingOneStateAcrossDeclarationsRejectsBeforeTheSecondSourceIsLent(mut UiRadioGroupLoanTests self){
    ASSERT_TRUE(self.accept(1u));
    const UiRadioAcceptedInput128 displayed = self.accepted();
    ASSERT_TRUE(self.declare(2u));
    UiRadioTestSource other = UiRadioTestSource();
    other.m_generation = 1901u;
    EXPECT_FALSE(self.m_builder.radioGroup("other", other, self.m_state).valid);
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_EQ(other.m_calls, 0u);
    EXPECT_EQ(self.m_state.selectedKey(), 10u);
    self.expectAccepted(displayed);
}

