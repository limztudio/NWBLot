void VerifyUiPopupInputTests_NestedAcceptanceCancelsTheParentSessionOnlyAfterGeometryPublication(mut UiPopupInputTests self){
    self.focusPopup();
    const TextInputSessionToken parentSession = self.m_textInput.activeSession();
    self.m_childState.open();
    ASSERT_TRUE(self.prepareNested());
    EXPECT_EQ(self.m_context.input().focus(), self.m_popupWidget.id);
    EXPECT_EQ(self.m_textInput.activeSession(), parentSession);
    ASSERT_TRUE(self.commit());
    ASSERT_EQ(self.m_context.input().popupCount(), 2u);
    EXPECT_EQ(self.m_context.input().focus(), self.m_childWidget.id);
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    EXPECT_EQ(self.m_textInput.emitCommit(parentSession, "late parent"), TextInputAdmission::InvalidSession);
    ASSERT_TRUE(self.nestedFrame());
    EXPECT_TRUE(self.m_childResult.focused);
    EXPECT_TRUE(self.m_textInput.activeSession().valid());
    EXPECT_EQ(self.m_textInput.surroundingText(), "child");
}

void VerifyUiPopupInputTests_NestedPreeditEscapeCancelsCompositionThenDismissesOnlyTheChild(mut UiPopupInputTests self){
    self.focusPopup();
    self.m_childState.open();
    ASSERT_TRUE(self.nestedFrame());
    ASSERT_TRUE(self.nestedFrame());
    const TextInputSessionToken childSession = self.m_textInput.activeSession();
    ASSERT_TRUE(childSession.valid());
    ASSERT_EQ(self.m_textInput.preedit("한"), TextInputAdmission::Accepted);
    ASSERT_TRUE(self.nestedFrame());
    ASSERT_TRUE(self.m_childModel.composition().active);
    self.key(Key::Escape);
    ASSERT_TRUE(self.nestedFrame());
    EXPECT_FALSE(self.m_childModel.composition().active);
    EXPECT_FALSE(self.m_childResult.cancelled);
    EXPECT_EQ(self.m_childModel.text(), "child");
    EXPECT_FALSE(self.m_childModel.canUndo());
    EXPECT_TRUE(self.m_childState.isOpen());
    EXPECT_TRUE(self.m_popupState.isOpen());
    self.key(Key::Escape);
    ASSERT_TRUE(self.nestedFrame());
    EXPECT_TRUE(self.m_childResult.cancelled);
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    ASSERT_TRUE(self.prepareNested());
    EXPECT_FALSE(self.m_childState.isOpen());
    EXPECT_TRUE(self.m_popupState.isOpen());
    ASSERT_TRUE(self.commit());
    ASSERT_EQ(self.m_context.input().popupCount(), 1u);
    EXPECT_EQ(self.m_context.input().focus(), self.m_popupWidget.id);
    ASSERT_TRUE(self.nestedFrame());
    EXPECT_EQ(self.m_textInput.surroundingText(), "popup");
    EXPECT_NE(self.m_textInput.activeSession(), childSession);
}

void VerifyUiPopupInputTests_AncestorReopeningFencesQueuedChildNativeAndClipboardIntentions(mut UiPopupInputTests self){
    self.focusPopup();
    self.m_childState.open();
    ASSERT_TRUE(self.nestedFrame());
    ASSERT_TRUE(self.nestedFrame());
    self.key(Key::V, true);
    ASSERT_TRUE(self.nestedFrame());
    const TextInputSessionToken childSession = self.m_textInput.activeSession();
    ASSERT_TRUE(childSession.valid());
    ASSERT_TRUE(self.m_clipboard.pump());
    const ClipboardRequestToken paste = self.m_clipboard.startedToken;
    ASSERT_TRUE(paste.valid());
    ASSERT_TRUE(self.m_clipboard.complete(paste, "late paste"));
    ASSERT_EQ(self.m_textInput.emitCommit(childSession, "late native"), TextInputAdmission::Accepted);
    self.m_popupState.close();
    self.m_popupState.open();
    ASSERT_TRUE(self.prepareNested());
    EXPECT_EQ(self.m_childModel.text(), "child");
    EXPECT_FALSE(self.m_childModel.canUndo());
    EXPECT_FALSE(self.m_childState.isOpen());
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    EXPECT_EQ(self.m_textInput.emitCommit(childSession, "later"), TextInputAdmission::InvalidSession);
    EXPECT_FALSE(self.m_clipboard.complete(paste, "later"));
    ASSERT_TRUE(self.commit());
    ASSERT_EQ(self.m_context.input().popupCount(), 1u);
    EXPECT_EQ(self.m_context.input().focus(), self.m_popupWidget.id);
    ASSERT_TRUE(self.nestedFrame());
    EXPECT_EQ(self.m_textInput.surroundingText(), "popup");
}

void VerifyUiPopupInputTests_NestedFocusLossCancelsTheWholeFamilyWithoutRestoringAnUnfocusedEditor(mut UiPopupInputTests self){
    self.focusPopup();
    self.m_childState.open();
    ASSERT_TRUE(self.nestedFrame());
    ASSERT_TRUE(self.nestedFrame());
    const TextInputSessionToken childSession = self.m_textInput.activeSession();
    ASSERT_TRUE(self.m_textInput.setFocused(false));
    EXPECT_TRUE(self.dispatch(MakeEcsUiFocusLostEvent()).commandConsumed);
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_EQ(self.m_textInput.emitCommit(childSession, "late"), TextInputAdmission::InvalidSession);
    ASSERT_TRUE(self.nestedFrame());
    EXPECT_FALSE(self.m_popupState.isOpen());
    EXPECT_FALSE(self.m_context.input().hasPopup());
    EXPECT_FALSE(self.m_context.input().focus().valid());
    ASSERT_TRUE(self.m_textInput.setFocused(true));
    ASSERT_TRUE(self.nestedFrame());
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    EXPECT_FALSE(self.m_context.input().focus().valid());
}

void VerifyPaintSlot_ClearAndRemoveReaddDoNotRestoreTheRunningCallback(){
    native{
        using namespace __hidden_paint_slot_tests;
        PaintSlotFixture fixture;
        auto& world = fixture.world;
        auto& context = fixture.context;
        auto entity = world.createEntity();
        const ECS::EntityID id = entity.id();
        auto& component = entity.addComponent<UiPaintComponent>();
        component.paint = [id](UiPaintContext& ctx){ ctx.world.entity(id).getComponent<UiPaintComponent>().paint.reset(); };
        component.paint.invoke(context);
        EXPECT_FALSE(static_cast<b8>(entity.getComponent<UiPaintComponent>().paint));

        entity.getComponent<UiPaintComponent>().paint = [id](UiPaintContext& ctx){
            auto current = ctx.world.entity(id);
            current.removeComponent<UiPaintComponent>();
            current.addComponent<UiPaintComponent>();
        };
        entity.getComponent<UiPaintComponent>().paint.invoke(context);
        EXPECT_FALSE(static_cast<b8>(entity.getComponent<UiPaintComponent>().paint));

        entity.getComponent<UiPaintComponent>().paint = [id](UiPaintContext& ctx){
            auto current = ctx.world.entity(id);
            current.removeComponent<UiPaintComponent>();
            current.addComponent<UiPaintComponent>();
            throw 42;
        };
        EXPECT_THROW(entity.getComponent<UiPaintComponent>().paint.invoke(context), i32);
        EXPECT_FALSE(static_cast<b8>(entity.getComponent<UiPaintComponent>().paint));
    }
}

void VerifyPaintSlot_ReplacementAndRelocationKeepTheCurrentOwner(){
    i32 observed = 0;
    native(mut observed){
        using namespace __hidden_paint_slot_tests;
        PaintSlotFixture fixture;
        auto& world = fixture.world;
        auto& context = fixture.context;
        auto first = world.createEntity();
        first.addComponent<UiPaintComponent>();
        auto second = world.createEntity();
        const ECS::EntityID firstId = first.id();
        const ECS::EntityID secondId = second.id();
        second.addComponent<UiPaintComponent>().paint = [firstId, &observed, count = 0](UiPaintContext& ctx)mutable{
            observed = ++count;
            if(count == 1)
                ctx.world.entity(firstId).removeComponent<UiPaintComponent>();
        };
        second.getComponent<UiPaintComponent>().paint.invoke(context);
        world.entity(secondId).getComponent<UiPaintComponent>().paint.invoke(context);
        EXPECT_EQ(observed, 2);

        world.entity(secondId).getComponent<UiPaintComponent>().paint = [secondId, &observed](UiPaintContext& ctx){
            ctx.world.entity(secondId).getComponent<UiPaintComponent>().paint = [&observed](UiPaintContext&){ observed = 17; };
        };
        world.entity(secondId).getComponent<UiPaintComponent>().paint.invoke(context);
        world.entity(secondId).getComponent<UiPaintComponent>().paint.invoke(context);
    }
    EXPECT_EQ(observed, 17);
}

void VerifyPaintSlot_VectorGrowthAndExplicitMovePreserveMutableCaptures(){
    i32 observed = 0;
    native(mut observed){
        using namespace __hidden_paint_slot_tests;
        PaintSlotFixture fixture;
        auto& world = fixture.world;
        auto& context = fixture.context;
        auto entity = world.createEntity();
        const ECS::EntityID id = entity.id();
        entity.addComponent<UiPaintComponent>().paint = [&observed, count = 0](UiPaintContext& ctx)mutable{
            observed = ++count;
            if(count == 1){
                for(u32 i = 0u; i < 128u; ++i)
                    ctx.world.createEntity().addComponent<UiPaintComponent>();
            }
        };
        entity.getComponent<UiPaintComponent>().paint.invoke(context);
        world.entity(id).getComponent<UiPaintComponent>().paint.invoke(context);
        EXPECT_EQ(observed, 2);

        UiPaintSlot first;
        UiPaintSlot second;
        first = [&first, &second, &observed, count = 0](UiPaintContext&)mutable{
            observed = ++count;
            if(count == 1)
                second = Move(first);
        };
        first.invoke(context);
        EXPECT_FALSE(static_cast<b8>(first));
        ASSERT_TRUE(static_cast<b8>(second));
        second.invoke(context);
    }
    EXPECT_EQ(observed, 2);
}

void VerifyPaintSlot_ExceptionRestoresCallbackWhenItStillHasAnOwner(){
    i32 calls = 0;
    native(mut calls){
        using namespace __hidden_paint_slot_tests;
        PaintSlotFixture fixture;
        auto& context = fixture.context;
        UiPaintSlot slot;
        slot = [&calls](UiPaintContext&){ ++calls; throw 42; };
        EXPECT_THROW(slot.invoke(context), i32);
        ASSERT_TRUE(static_cast<b8>(slot));
        EXPECT_THROW(slot.invoke(context), i32);
    }
    EXPECT_EQ(calls, 2);
}

void VerifyPaintSlot_NestedReplacementAndExceptionDoNotRestoreTheDisplacedCallback(){
    i32 calls = 0;
    b8 slotActive = true;
    native(mut calls, mut slotActive){
        using namespace __hidden_paint_slot_tests;
        PaintSlotFixture fixture;
        auto& context = fixture.context;
        UiPaintSlot slot;
        slot = [&slot, &calls](UiPaintContext& ctx){
            slot = [&calls](UiPaintContext&){ ++calls; };
            slot.invoke(ctx);
            throw 42;
        };
        EXPECT_THROW(slot.invoke(context), i32);
        ASSERT_TRUE(static_cast<b8>(slot));
        slot.invoke(context);
        EXPECT_EQ(calls, 2);

        slot = [&slot](UiPaintContext&){ slot.reset(); throw 42; };
        EXPECT_THROW(slot.invoke(context), i32);
        slotActive = static_cast<b8>(slot);
    }
    EXPECT_EQ(calls, 2);
    EXPECT_FALSE(slotActive);
}

void VerifyPaintSlot_RunningCallbackRemainsVisibleUntilCleared(){
    b8 visibleDuringCall = false;
    b8 visibleAfterClear = true;
    b8 callableDuringCall = true;
    b8 slotActive = true;
    native(mut visibleDuringCall, mut visibleAfterClear, mut callableDuringCall, mut slotActive){
        using namespace __hidden_paint_slot_tests;
        PaintSlotFixture fixture;
        UiPaintSlot slot;
        slot = [&slot, &visibleDuringCall, &visibleAfterClear, &callableDuringCall](UiPaintContext& ctx){
            visibleDuringCall = slot.present();
            callableDuringCall = static_cast<b8>(slot);
            if(slot)
                slot.invoke(ctx);
            slot.reset();
            visibleAfterClear = slot.present();
        };
        slot.invoke(fixture.context);
        slotActive = static_cast<b8>(slot);
    }
    EXPECT_TRUE(visibleDuringCall);
    EXPECT_FALSE(callableDuringCall);
    EXPECT_FALSE(visibleAfterClear);
    EXPECT_FALSE(slotActive);
}

void VerifyPaintSlot_MoveConstructionTransfersTheActiveLease(){
    i32 calls = 0;
    native(mut calls){
        using namespace __hidden_paint_slot_tests;
        PaintSlotFixture fixture;
        auto& context = fixture.context;
        UiPaintSlot first;
        Optional<UiPaintSlot> second;
        first = [&first, &second, &calls](UiPaintContext&){
            ++calls;
            if(calls == 1)
                second.emplace(Move(first));
        };
        first.invoke(context);
        EXPECT_FALSE(static_cast<b8>(first));
        ASSERT_TRUE(second.has_value());
        ASSERT_TRUE(static_cast<b8>(*second));
        second->invoke(context);
    }
    EXPECT_EQ(calls, 2);
}

void VerifyUiPopupInputTests_PreparedPopupPreservesBaseSessionAndAcceptedFocusCancelsIt(mut UiPopupInputTests self){
    self.focusBase();
    const TextInputSessionToken baseSession = self.m_textInput.activeSession();
    const u32 starts = self.m_textInput.starts;
    const u32 ends = self.m_textInput.ends;
    self.m_popupState.open();
    ASSERT_TRUE(self.prepare());
    EXPECT_EQ(self.m_context.input().focus(), self.m_baseWidget.id);
    EXPECT_EQ(self.m_textInput.activeSession(), baseSession);
    EXPECT_EQ(self.m_textInput.starts, starts);
    EXPECT_EQ(self.m_textInput.ends, ends);
    EXPECT_FALSE(self.m_context.input().hasPopup());
    ASSERT_TRUE(self.commit());
    EXPECT_TRUE(self.m_context.input().hasPopup());
    EXPECT_EQ(self.m_context.input().focus(), self.m_popupWidget.id);
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    EXPECT_EQ(self.m_textInput.starts, starts);
    EXPECT_EQ(self.m_textInput.ends, ends + 1u);
    EXPECT_EQ(self.m_textInput.emitCommit(baseSession, "late"), TextInputAdmission::InvalidSession);
    EXPECT_EQ(self.m_baseModel.text(), "base");
    EXPECT_EQ(self.m_popupModel.text(), "popup");
}

void VerifyUiPopupInputTests_PopupSessionBeginsOnlyAfterAcceptedGeometryAndANewModelDeclaration(mut UiPopupInputTests self){
    self.focusBase();
    const TextInputSessionToken baseSession = self.m_textInput.activeSession();
    const u32 starts = self.m_textInput.starts;
    self.m_popupState.open();
    ASSERT_TRUE(self.frame());
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    EXPECT_EQ(self.m_textInput.starts, starts);
    ASSERT_TRUE(self.prepare());
    EXPECT_TRUE(self.m_popupResult.focused);
    EXPECT_TRUE(self.m_textInput.activeSession().valid());
    EXPECT_NE(self.m_textInput.activeSession(), baseSession);
    EXPECT_EQ(self.m_textInput.starts, starts + 1u);
    EXPECT_EQ(self.m_textInput.surroundingText(), "popup");
    ASSERT_TRUE(self.commit());
}

void VerifyUiPopupInputTests_ReopenedSameModelFencesQueuedNativeAndLocalIntentionsBeforeItsCandidateIsAccepted(mut UiPopupInputTests self){
    self.focusPopup();
    const TextInputSessionToken oldSession = self.m_textInput.activeSession();
    const usize anchor = self.m_popupModel.anchor();
    const usize caret = self.m_popupModel.caret();
    ASSERT_EQ(self.m_textInput.emitCommit(oldSession, "late"), TextInputAdmission::Accepted);
    self.key(Key::Backspace);
    EXPECT_EQ(self.m_popupModel.text(), "popup");
    self.m_popupState.close();
    self.m_popupState.open();
    ASSERT_TRUE(self.prepare());
    EXPECT_EQ(self.m_popupModel.text(), "popup");
    EXPECT_EQ(self.m_popupModel.anchor(), anchor);
    EXPECT_EQ(self.m_popupModel.caret(), caret);
    EXPECT_FALSE(self.m_popupModel.canUndo());
    EXPECT_FALSE(self.m_popupResult.textChanged);
    EXPECT_FALSE(self.m_popupResult.focused);
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    EXPECT_EQ(self.m_textInput.emitCommit(oldSession, "later"), TextInputAdmission::InvalidSession);
    ASSERT_TRUE(self.commit());
    EXPECT_EQ(self.m_context.input().focus(), self.m_popupWidget.id);
    ASSERT_TRUE(self.frame());
    EXPECT_TRUE(self.m_textInput.activeSession().valid());
    EXPECT_NE(self.m_textInput.activeSession(), oldSession);
    EXPECT_EQ(self.m_textInput.surroundingText(), "popup");
}

void VerifyUiPopupInputTests_ReopenedSameModelRejectsAnAlreadyCompletedPasteFromThePriorPopupLifetime(mut UiPopupInputTests self){
    self.focusPopup();
    self.key(Key::V, true);
    ASSERT_TRUE(self.frame());
    ASSERT_TRUE(self.m_clipboard.pump());
    const ClipboardRequestToken oldRequest = self.m_clipboard.startedToken;
    ASSERT_TRUE(oldRequest.valid());
    ASSERT_TRUE(self.m_clipboard.complete(oldRequest, "late paste"));
    EXPECT_EQ(self.m_popupModel.text(), "popup");
    self.m_popupState.close();
    self.m_popupState.open();
    ASSERT_TRUE(self.prepare());
    EXPECT_EQ(self.m_popupModel.text(), "popup");
    EXPECT_FALSE(self.m_popupModel.canUndo());
    EXPECT_FALSE(self.m_popupResult.textChanged);
    EXPECT_FALSE(self.m_clipboard.complete(oldRequest, "later paste"));
    ASSERT_TRUE(self.commit());
    ASSERT_TRUE(self.frame());
    EXPECT_EQ(self.m_textInput.surroundingText(), "popup");
}

void VerifyUiPopupInputTests_FirstEscapeCancelsTransientPreeditAndSecondDismissesBeforeAcceptedRestoration(mut UiPopupInputTests self){
    self.focusPopup();
    ASSERT_EQ(self.m_textInput.preedit("한"), TextInputAdmission::Accepted);
    ASSERT_TRUE(self.frame());
    ASSERT_TRUE(self.m_popupModel.composition().active);
    EXPECT_EQ(self.m_popupModel.text(), "popup");
    EXPECT_FALSE(self.m_popupModel.canUndo());
    self.key(Key::Escape);
    EXPECT_EQ(self.m_context.input().focus(), self.m_popupWidget.id);
    ASSERT_TRUE(self.frame());
    EXPECT_FALSE(self.m_popupModel.composition().active);
    EXPECT_FALSE(self.m_popupResult.cancelled);
    EXPECT_EQ(self.m_popupModel.text(), "popup");
    EXPECT_FALSE(self.m_popupModel.canUndo());
    EXPECT_TRUE(self.m_popupState.isOpen());
    EXPECT_EQ(self.m_context.input().focus(), self.m_popupWidget.id);
    EXPECT_FALSE(self.m_context.input().consumePopupDismissal(self.m_token));
    self.key(Key::Escape);
    ASSERT_TRUE(self.frame());
    EXPECT_TRUE(self.m_popupResult.cancelled);
    EXPECT_TRUE(self.m_context.input().hasPopup());
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    ASSERT_TRUE(self.prepare());
    EXPECT_FALSE(self.m_popupState.isOpen());
    EXPECT_TRUE(self.m_context.input().hasPopup());
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    ASSERT_TRUE(self.commit());
    EXPECT_FALSE(self.m_context.input().hasPopup());
    EXPECT_EQ(self.m_context.input().focus(), self.m_baseWidget.id);
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    ASSERT_TRUE(self.frame());
    EXPECT_TRUE(self.m_textInput.activeSession().valid());
    EXPECT_EQ(self.m_textInput.surroundingText(), "base");
}

void VerifyUiPopupInputTests_NativeFocusLossCancelsSessionAndRemovalDoesNotRestoreAnUnfocusedEditor(mut UiPopupInputTests self){
    self.focusPopup();
    const TextInputSessionToken popupSession = self.m_textInput.activeSession();
    ASSERT_TRUE(self.m_textInput.setFocused(false));
    EXPECT_TRUE(self.dispatch(MakeEcsUiFocusLostEvent()).commandConsumed);
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_EQ(self.m_textInput.emitCommit(popupSession, "late"), TextInputAdmission::InvalidSession);
    ASSERT_TRUE(self.frame());
    EXPECT_FALSE(self.m_popupState.isOpen());
    EXPECT_FALSE(self.m_context.input().hasPopup());
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    EXPECT_EQ(self.m_baseModel.text(), "base");
    EXPECT_EQ(self.m_popupModel.text(), "popup");
    ASSERT_TRUE(self.m_textInput.setFocused(true));
    EXPECT_FALSE(self.dispatch(MakeEcsUiFocusGainedEvent()).focus.valid());
    ASSERT_TRUE(self.frame());
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    self.key(Key::Tab);
    ASSERT_TRUE(self.frame());
    EXPECT_EQ(self.m_context.input().focus(), self.m_baseWidget.id);
    EXPECT_TRUE(self.m_textInput.activeSession().valid());
    EXPECT_EQ(self.m_textInput.surroundingText(), "base");
}

void VerifyUiPopupInputTests_DeferredEditorStartsNativeSessionOnlyAfterPopupGeometryAcceptance(mut UiPopupInputTests self){
    self.m_popupState.open();
    ASSERT_TRUE(self.prepareDeferred());
    EXPECT_FALSE(self.m_context.popupToken().valid());
    EXPECT_FALSE(self.m_context.input().hasPopup());
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    ASSERT_TRUE(self.commit());
    EXPECT_EQ(self.m_context.input().focus(), self.m_popupWidget.id);
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    ASSERT_TRUE(self.prepareDeferred());
    EXPECT_TRUE(self.m_popupResult.focused);
    EXPECT_TRUE(self.m_textInput.activeSession().valid());
    EXPECT_EQ(self.m_textInput.surroundingText(), "popup");
    ASSERT_TRUE(self.commit());
}

void VerifyUiPopupInputTests_DeferredEditorRejectsQueuedNativeCommitWhenPopupLifetimeChanges(mut UiPopupInputTests self){
    self.m_popupState.open();
    ASSERT_TRUE(self.prepareDeferred() && self.commit());
    ASSERT_TRUE(self.prepareDeferred() && self.commit());
    const TextInputSessionToken old = self.m_textInput.activeSession();
    ASSERT_TRUE(old.valid());
    ASSERT_EQ(self.m_textInput.emitCommit(old, "late"), TextInputAdmission::Accepted);
    self.m_popupState.close();
    self.m_popupState.open();
    ASSERT_TRUE(self.prepareDeferred());
    EXPECT_EQ(self.m_popupModel.text(), "popup");
    EXPECT_FALSE(self.m_popupResult.textChanged);
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    EXPECT_EQ(self.m_textInput.emitCommit(old, "later"), TextInputAdmission::InvalidSession);
    ASSERT_TRUE(self.commit());
}

void VerifyUiPopupInputTests_DeferredEditorKeepsPreeditSeparateAndGatesEnterUntilCompositionEnds(mut UiPopupInputTests self){
    self.m_popupState.open();
    ASSERT_TRUE(self.prepareDeferred() && self.commit());
    ASSERT_TRUE(self.prepareDeferred() && self.commit());
    ASSERT_EQ(self.m_textInput.preedit("한"), TextInputAdmission::Accepted);
    self.key(Key::Enter);
    ASSERT_TRUE(self.prepareDeferred() && self.commit());
    EXPECT_TRUE(self.m_popupModel.composition().active);
    EXPECT_EQ(self.m_popupModel.text(), "popup");
    EXPECT_FALSE(self.m_popupResult.submitted);
    self.key(Key::Escape);
    ASSERT_TRUE(self.prepareDeferred() && self.commit());
    EXPECT_FALSE(self.m_popupModel.composition().active);
    EXPECT_FALSE(self.m_popupResult.cancelled);
    EXPECT_TRUE(self.m_context.input().hasPopup());
    self.key(Key::Enter);
    ASSERT_TRUE(self.prepareDeferred() && self.commit());
    EXPECT_TRUE(self.m_popupResult.submitted);
}

void VerifyUiPopupInputTests_DeferredEditorRejectsCompletedPasteFromPriorPopupLifetime(mut UiPopupInputTests self){
    self.m_popupState.open();
    ASSERT_TRUE(self.prepareDeferred() && self.commit());
    ASSERT_TRUE(self.prepareDeferred() && self.commit());
    self.key(Key::V, true);
    ASSERT_TRUE(self.prepareDeferred() && self.commit());
    ASSERT_TRUE(self.m_clipboard.pump());
    const ClipboardRequestToken old = self.m_clipboard.startedToken;
    ASSERT_TRUE(old.valid());
    ASSERT_TRUE(self.m_clipboard.complete(old, "late paste"));
    self.m_popupState.close();
    self.m_popupState.open();
    ASSERT_TRUE(self.prepareDeferred());
    EXPECT_EQ(self.m_popupModel.text(), "popup");
    EXPECT_FALSE(self.m_popupResult.textChanged);
    EXPECT_FALSE(self.m_popupModel.canUndo());
    EXPECT_FALSE(self.m_clipboard.complete(old, "later"));
    ASSERT_TRUE(self.commit());
}

void VerifyUiPopupInputTests_DeferredEditorRejectsNativeIntentionAfterCompositionReturnsToIdenticalState(mut UiPopupInputTests self){
    self.m_popupState.open();
    ASSERT_TRUE(self.prepareDeferred() && self.commit());
    ASSERT_TRUE(self.prepareDeferred() && self.commit());
    const TextInputSessionToken old = self.m_textInput.activeSession();
    ASSERT_TRUE(old.valid());
    ASSERT_EQ(self.m_textInput.emitCommit(old, "late"), TextInputAdmission::Accepted);
    const u64 revision = self.m_popupModel.revision();
    const u64 generation = self.m_popupModel.compositionGeneration();
    ASSERT_TRUE(self.m_popupModel.beginComposition());
    ASSERT_TRUE(self.m_popupModel.updateComposition("한", 0u, 3u));
    self.m_popupModel.cancelComposition();
    ASSERT_EQ(self.m_popupModel.revision(), revision);
    ASSERT_GT(self.m_popupModel.compositionGeneration(), generation);
    ASSERT_TRUE(self.prepareDeferred() && self.commit());
    EXPECT_EQ(self.m_popupModel.text(), "popup");
    EXPECT_FALSE(self.m_popupResult.textChanged);
    EXPECT_FALSE(self.m_popupModel.canUndo());
    EXPECT_NE(self.m_textInput.activeSession(), old);
    EXPECT_EQ(self.m_textInput.emitCommit(old, "later"), TextInputAdmission::InvalidSession);
}

