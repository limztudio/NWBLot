};

[cpp_header("<core/graphics/rhi/device.h>"), cpp_name("::NWB::Core::CommandListParameters"), cpp_flags(binary_serializable, brace_init)]
extern class CommandListParameters{
    CommandQueue queueType;
    GpuPhysicalQueueId physicalQueue;
    u64 recordingWorkerDomain;
    u32 recordingWorkerIndex;
    CommandListParameters setPhysicalQueue(...);
    CommandListParameters setQueueType(...);
    CommandListParameters setRecordingWorker(...);
};

[cpp_header("<core/graphics/rhi/device.h>"), cpp_name("::NWB::Core::DeviceCreationParameters")]
extern class DeviceCreationParameters{
    Vector<String> requiredBackendInstanceExtensions;
    Vector<String> requiredBackendLayers;
    Vector<String> optionalBackendInstanceExtensions;
    Vector<String> optionalBackendLayers;
    u32 swapChainBufferCount;
    u32 swapChainSampleCount;
    u32 maxFramesInFlight;
    i32 adapterIndex;
    Format swapChainFormat;
    HardwareRayTracingPolicy hardwareRayTracingPolicy;
    b8 enableDebugRuntime;
    b8 headlessDevice;
    b8 enableGpuCrashDiagnostics;
    b8 enableHDR10Output;
    b8 enableSwapChainReadback;
    b8 enableNativeMeshShaders;
    b8 enableAsyncComputeLane;
    b8 enableTransferQueue;
    b8 enableSameClassMultiQueue;
    b8 enableCrossFamilySameClassQueueRouting;
    Vector<String> requiredBackendDeviceExtensions;
    Vector<String> optionalBackendDeviceExtensions;
    Vector<i32> ignoredValidationMessageIds;
    GpuDescriptorHeapAbi bindlessHeapAbi;
    Path pipelineCacheDirectory;
};

