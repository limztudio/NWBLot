    }
}

class TestTableRowData{
    public u64 key = 0u;
    public String name;
    public i64 score = 0ll;
    public String scoreText;
    public String note;
    public b8 enabled = true;
}

class TestTableDataSource : ITableDataSource{
    public Vector<TestTableRowData> m_rows;
    public u64 m_generation = 4101u;
    public u64 m_revision = 1u;
    public TestObserved<u64> m_offscreenCol4Calls;

    public void addRow(in u64 key, in StringView name, in i64 score, in StringView note, in b8 enabled){
        TestTableRowData row;
        row.key = key;
        row.name.assign(name);
        row.score = score;
        CompactString scoreStr;
        if(FormatI64Into(score, scoreStr).has_value())
            row.scoreText.assign(scoreStr.view());
        row.note.assign(note);
        row.enabled = enabled;
        this.m_rows.push_back(row);
    }

    public u64 instanceGeneration()const override{ return this.m_generation; }
    public u64 revision()const override{ return this.m_revision; }
    public u64 rowCount()const override{ return cast<u64>(this.m_rows.size()); }

    public u64 rowKey(in u64 rowIndex)const override{
        if(rowIndex >= this.m_rows.size())
            return 0u;
        return this.m_rows[cast<usize>(rowIndex)].key;
    }

    public b8 rowEnabled(in u64 rowIndex)const override{
        return rowIndex < this.m_rows.size() && this.m_rows[cast<usize>(rowIndex)].enabled;
    }

    public StringView cellText(in u64 rowIndex, in u64 columnKey)const override{
        if(rowIndex >= this.m_rows.size())
            return "";
        in TestTableRowData row = this.m_rows[cast<usize>(rowIndex)];
        if(columnKey == 1u)
            return StringView(row.name);
        if(columnKey == 2u)
            return StringView(row.scoreText);
        if(columnKey == 3u)
            return StringView(row.note);
        if(columnKey == 4u){
            ++this.m_offscreenCol4Calls.value();
            return StringView(row.note);
        }
        return "";
    }

    public i32 compareRows(in u64 lhsRowIndex, in u64 rhsRowIndex, in u64 columnKey)const override{
        in TestTableRowData lhs = this.m_rows[cast<usize>(lhsRowIndex)];
        in TestTableRowData rhs = this.m_rows[cast<usize>(rhsRowIndex)];
        if(columnKey == 1u){
            if(StringView(lhs.name) < StringView(rhs.name))
                return -1;
            if(StringView(lhs.name) > StringView(rhs.name))
                return 1;
            return 0;
        }
        if(columnKey == 2u){
            if(lhs.score < rhs.score)
                return -1;
            if(lhs.score > rhs.score)
                return 1;
            return 0;
        }
        return 0;
    }
}

