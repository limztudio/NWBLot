#include <impl/ecs_render/material/material_system.adhd>
#include <impl/ecs_render/kernel/compute_pipeline_utils.adhd>
#include <impl/ecs_render/kernel/renderer_constants_private.adhd>
#include <impl/assets_graphics/mesh_subsystem.adhd>
#include <impl/ecs_render/shader/shader_system.adhd>

[cpp_header("<impl/assets/graphics/mesh/object_geometry_constants.h>"), cpp_name("NWB_MESH_OBJECT_VERTEX_POSITION_BYTE_OFFSET")]
extern const u32 s_ObjectVertexPositionOffset;
[cpp_header("<impl/assets/graphics/mesh/object_geometry_constants.h>"), cpp_name("NWB_MESH_OBJECT_VERTEX_NORMAL_BYTE_OFFSET")]
extern const u32 s_ObjectVertexNormalOffset;
[cpp_header("<impl/assets/graphics/mesh/object_geometry_constants.h>"), cpp_name("NWB_MESH_OBJECT_VERTEX_TANGENT_BYTE_OFFSET")]
extern const u32 s_ObjectVertexTangentOffset;
[cpp_header("<impl/assets/graphics/mesh/object_geometry_constants.h>"), cpp_name("NWB_MESH_OBJECT_VERTEX_UV0_BYTE_OFFSET")]
extern const u32 s_ObjectVertexUv0Offset;
[cpp_header("<impl/assets/graphics/mesh/object_geometry_constants.h>"), cpp_name("NWB_MESH_OBJECT_VERTEX_COLOR_BYTE_OFFSET")]
extern const u32 s_ObjectVertexColorOffset;

GpuTimingScopeDefinition MaterialPassGpuTimingScope(in MaterialPipelinePass pass){
    switch(pass){
    case MaterialPipelinePass::AvboitOccupancy: return s_TimingScopeAvboitOccupancy;
    case MaterialPipelinePass::AvboitExtinction: return s_TimingScopeAvboitExtinction;
    case MaterialPipelinePass::AvboitAccumulate: return s_TimingScopeAvboitAccumulate;
    default: return GpuTimingScopeDefinition();
    }
}

void RendererMaterialSystem::renderPreparedAvboitMaterialPass(mut CommandList commands, in FramebufferHandle framebuffer, in MaterialPipelinePass pass, in AvboitFrameTargets avboitTargets,
        in MaterialPassDrawItemPartitionsView drawItems, in CsgFrameGpuDataView csgFrameData, in CsgGraphResourceSnapshot csgResources,
        in MeshFrameBindingSnapshot frameBindings, in usize instanceCount, in usize materialTypedByteCount, in b8 materialFrameStatesGraphOwned,
        in b8 materialGeometryStatesGraphOwned, in b8 emulationOutputEntryStateGraphOwned, in b8 csgEmulationOutputEntryStateGraphOwned,
        in b8 emulationOutputReused, in Optional<mut Optional<GpuTimingMeasure>> emulationOutputTiming){
    auto discardEmulationOutputTiming = lambda[in emulationOutputTiming]() -> void{
        if(!emulationOutputTiming.has_value() || !emulationOutputTiming.value().has_value())
            return;
        emulationOutputTiming.value().value().discardTiming();
        emulationOutputTiming.value().reset();
    };
    const b8 avboitTargetsValid = avboitTargets.valid();
    if(!CanPrepareMaterialPassTargets(framebuffer.valid(), pass, avboitTargetsValid) || drawItems.empty()){
        discardEmulationOutputTiming();
        return;
    }

    commands.endRenderPass();

    // Fresh producers open split timing. Reused regular output has a separate, already-validated graph producer.
    if(IsRejectedReusedEmulationOutputHandoff(emulationOutputReused, emulationOutputEntryStateGraphOwned, csgEmulationOutputEntryStateGraphOwned))
        return;
    const b8 splitEmulationTiming = UsesSplitEmulationTiming(emulationOutputEntryStateGraphOwned, csgEmulationOutputEntryStateGraphOwned, emulationOutputReused);
    if(splitEmulationTiming && (!emulationOutputTiming.has_value() || !emulationOutputTiming.value().has_value()))
        return;

    // Declaration froze ordering and published bytes; keep this consumer side-effect free.
    if(!frameBindings.frameReady(instanceCount, materialTypedByteCount)){
        discardEmulationOutputTiming();
        return;
    }
    const b8 regularDrawResourcesReady = this.m_drawRecorder.materialPassDrawResourcesReady(drawItems.regular, frameBindings);
    // Active handoff covers every regular draw; reject on late resource disagreement.
    if(emulationOutputEntryStateGraphOwned && !regularDrawResourcesReady){
        discardEmulationOutputTiming();
        return;
    }
    const b8 csgResourcesReady = csgResources.frameReady(csgFrameData);
    const b8 csgDrawResourcesReady = csgResourcesReady && (drawItems.csg.empty() || this.m_drawRecorder.materialPassDrawResourcesReady(drawItems.csg, frameBindings));
    if(csgEmulationOutputEntryStateGraphOwned && !csgDrawResourcesReady){
        discardEmulationOutputTiming();
        return;
    }

    ViewportState viewportState;
    viewportState.addViewportAndScissorRect(framebuffer.deref().getFramebufferInfo().getViewport());
    MaterialPassDrawContext regularDrawContext(
        commands,
        viewportState,
        frameBindings,
        pass,
        materialFrameStatesGraphOwned,
        materialGeometryStatesGraphOwned,
        emulationOutputEntryStateGraphOwned
    );
    regularDrawContext.setFramebuffer(framebuffer);
    regularDrawContext.setAvboitTargets(avboitTargets);
    // CSG opts in only via its own frozen producer; keep it separate from the regular flag.
    MaterialPassDrawContext csgDrawContext(
        commands,
        viewportState,
        frameBindings,
        pass,
        materialFrameStatesGraphOwned,
        materialGeometryStatesGraphOwned,
        csgEmulationOutputEntryStateGraphOwned
    );
    csgDrawContext.setFramebuffer(framebuffer).setCsgResources(csgResources);
    csgDrawContext.setAvboitTargets(avboitTargets);
    auto recordPreparedDraws = lambda[mut this, in regularDrawResourcesReady, in csgDrawResourcesReady, mut regularDrawContext, mut csgDrawContext, in drawItems]() -> void{
        if(regularDrawResourcesReady)
            this.m_drawRecorder.renderMaterialPassDrawItems(regularDrawContext, drawItems.regular);
        if(csgDrawResourcesReady)
            this.m_drawRecorder.renderMaterialPassDrawItems(csgDrawContext, drawItems.csg);
    };
    if(splitEmulationTiming){
        recordPreparedDraws();
        emulationOutputTiming.value().value().finishTiming(commands);
        emulationOutputTiming.value().reset();
    }
    else{
        GpuTimingMeasure timing(this.m_graphics.gpuTiming(), MaterialPassGpuTimingScope(pass), this.m_graphics.getDevice(), commands);

        recordPreparedDraws();
    }
}

b8 RendererMaterialSystem::prepareMaterialPassResources(in FramebufferHandle framebuffer, in MaterialPipelinePass pass, in b8 transparent, in CsgFrameState csgFrameState){
    return this.prepareMaterialPassResourcesImpl(framebuffer, pass, transparent, csgFrameState, false);
}

b8 RendererMaterialSystem::prepareMaterialPassResources(in FramebufferHandle framebuffer, in MaterialPipelinePass pass, in b8 transparent, in CsgFrameState csgFrameState, in AvboitFrameTargets avboitTargets){
    return this.prepareMaterialPassResourcesImpl(framebuffer, pass, transparent, csgFrameState, avboitTargets.valid());
}

b8 RendererMaterialSystem::prepareMaterialPassResourcesImpl(in FramebufferHandle framebuffer, in MaterialPipelinePass pass, in b8 transparent, in CsgFrameState csgFrameState, in b8 avboitTargetsValid){
    if(!CanPrepareMaterialPassTargets(framebuffer.valid(), pass, avboitTargetsValid))
        return false;

    MaterialPassDrawItemPartitions drawItems;
    InstanceGpuDataVector instanceData;
    CsgFrameGpuData csgFrameData;
    MaterialTypedInstanceRangeVector materialTypedRanges;
    MaterialTypedByteDataVector materialTypedBytes;

    this.gatherMaterialPassDrawItems(
        framebuffer,
        pass,
        transparent,
        csgFrameState,
        RendererResourceLookupMode::CreateMissing,
        Optional<in MeshViewGpuData>(),
        drawItems,
        instanceData,
        csgFrameData,
        materialTypedRanges,
        materialTypedBytes
    );
    if(drawItems.empty())
        return true;

    const b8 drawBuffersReady = this.prepareMaterialPassDrawBuffers(instanceData, materialTypedBytes);
    const b8 regularDrawResourcesReady = this.m_drawRecorder.prepareMaterialPassResourceBindings(drawItems.regular);
    const b8 csgDrawResourcesReady = drawItems.csg.empty() || this.m_drawRecorder.prepareMaterialPassResourceBindings(drawItems.csg);
    const b8 csgReceiverSurfaceDrawResourcesReady = drawItems.csgReceiverSurface.empty() || this.m_drawRecorder.prepareMaterialPassResourceBindings(drawItems.csgReceiverSurface);

    return drawBuffersReady && regularDrawResourcesReady && csgDrawResourcesReady && csgReceiverSurfaceDrawResourcesReady;
}

void RendererMaterialSystem::prepareMaterialPassInstanceUploadData(in CsgGraphResourceSnapshot csgResources, mut Span<InstanceGpuData> instanceData){
    const auto slot = csgResources.findClipContextHeapSlot();
    for(mut InstanceGpuData instance : instanceData)
        instance.geometryHeapSlots[s_MeshInstanceCsgContextHeapSlot] = slot.value_or(0u);
}

void RendererMaterialSystem::invalidateResources(){
    this.releaseMaterialResourceReferences();
    this.m_materialState.invalidateResources();
}

b8 RendererMaterialSystem::createObjectGeometryPipelineResources(mut MaterialPipelineResources resources){
    if(!this.prepareMeshComputeBindingLayout())
        return false;
    mut Device device = this.m_graphics.getDevice();
    // A single fixed engine decoder defines cache contents independently of the selected material or raster pass.
    if(!this.m_materialState.m_objectGeometryDecodePipeline.valid()){
        if(!this.m_shaderSystem.loadShader<ComputeShader, MeshSubsystem>(lambda[](in MeshSubsystem s) -> AssetRef<ComputeShader>{ return s.objectDecodeCs; }, s_ShaderArchiveDefaultVariant,
            s_ObjectGeometryDecodeDebugName, this.m_materialState.m_objectGeometryDecodeShader))
            return false;
        if(!CreateHeapComputePipeline(device, this.m_materialState.m_objectGeometryDecodeShader, this.m_materialState.m_computeBindingLayout, false, this.m_materialState.m_objectGeometryDecodePipeline))
            return false;
    }
    if(!this.m_shaderSystem.loadShader<VertexShader, MeshSubsystem>(lambda[](in MeshSubsystem s) -> AssetRef<VertexShader>{ return s.objectVs; }, s_ShaderArchiveDefaultVariant, s_ObjectGeometryVsDebugName, resources.objectGeometryVertexShader))
        return false;
    if(!this.m_materialState.m_objectGeometryInputLayout.valid()){
        Array<VertexAttributeDesc, s_ObjectGeometryVertexAttributeCount> attributes;
        const Array<Format, 5u> formats(Format::RGBA32_FLOAT, Format::RGBA16_FLOAT, Format::RGBA16_FLOAT, Format::RG32_FLOAT, Format::RGBA16_FLOAT);
        const Array<u32, 5u> offsets(s_ObjectVertexPositionOffset, s_ObjectVertexNormalOffset, s_ObjectVertexTangentOffset, s_ObjectVertexUv0Offset, s_ObjectVertexColorOffset);
        const Array<Name, 5u> names(s_VertexAttributePositionName, s_VertexAttributeNormalName, s_VertexAttributeTangentName, s_VertexAttributeTexCoordName, s_VertexAttributeColorName);
        for(u32 index = 0u; index < LengthOf(attributes); ++index)
            attributes[index].setFormat(formats[index]).setBufferIndex(s_MeshEmulationVertexBufferIndex).setOffset(offsets[index]).setElementStride(cast<u32>(s_MeshObjectVertexByteSize)).setName(names[index]);
        auto objectGeometryInputLayoutResult = device.createInputLayout(attributes, resources.objectGeometryVertexShader.deref());
        if(objectGeometryInputLayoutResult.has_value())
            this.m_materialState.m_objectGeometryInputLayout = objectGeometryInputLayoutResult.value();
        else
            this.m_materialState.m_objectGeometryInputLayout.reset();
        if(!objectGeometryInputLayoutResult.has_value())
            return false;
    }
    resources.objectGeometryDecodePipeline = this.m_materialState.m_objectGeometryDecodePipeline;
    return true;
}

b8 RendererMaterialSystem::recordObjectGeometryDecode(in MaterialPassDrawContext context, in MaterialPassDrawItem drawItem){
    in MaterialPassMeshResourceSnapshot mesh = drawItem.meshResources;
    in ObjectGeometryCacheSnapshot cache = mesh.objectGeometryCache;
    in ComputePipelineHandle pipeline = drawItem.pipelineResources.objectGeometryDecodePipeline;
    if(!pipeline.valid() || pipeline != cache.decoderPipeline || !cache.valid() || !this.m_drawRecorder.materialPassDrawResourcesReady(mesh, context.frameBindings))
        return false;
    mut CommandList commandList = context.commandList;
    ComputeState state;
    state.setPipeline(pipeline.deref());
    commandList.setComputeState(state);
    this.m_graphics.getDevice().getDescriptorHeap().bindCompute(commandList, pipeline.deref());
    const MeshFrameHeapSlots slots = ResolveMeshFrameHeapSlots(context.frameBindings, cache.heapHandle.slot());
    const ShaderDrivenPushConstants meshPush = BuildShaderDrivenPushConstants(
        mesh.meshletCount,
        drawItem.instanceIndex,
        drawItem.materialConstantByteOffset,
        context.viewportState,
        slots,
        0u
    );
    MeshComputePushConstants push;
    push.mesh = meshPush;
    push.generatedIndexByteOffset = cache.indexByteOffset;
    commandList.setPushConstants(push);
    {
        GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeMeshDispatch, this.m_graphics.getDevice(), commandList);

        commandList.dispatch(ComputeObjectGeometryDecodeGroupCount(mesh.meshletCount));
    }
    return true;
}


