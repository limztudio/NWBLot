#include <impl/ecs_ui/toolkit/edit/grapheme.adhd>
#include <impl/ecs_ui/toolkit/edit/edit_history.adhd>
#include <impl/ecs_ui/toolkit/edit/edit_history_actions.adhd>
#include <impl/ecs_ui/toolkit/edit/edit_composition_rules.adhd>
#include <impl/ecs_ui/toolkit/edit/edit_selection_actions.adhd>
#include <impl/ecs_ui/toolkit/edit/model_validation.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class EditModel : NoCopy{
    private u64 m_instanceGeneration;
    private EditLimits m_limits;
    private String m_text;
    private Vector<usize> m_boundaries;
    private Vector<EditHistoryRecord> m_history;
    private String m_preedit;
    private Vector<EditPreeditClause> m_preeditClauses;
    private usize m_anchor = 0u;
    private usize m_caret = 0u;
    private usize m_historyCursor = 0u;
    private usize m_historyBytes = 0u;
    private usize m_compositionAnchor = 0u;
    private usize m_compositionCaret = 0u;
    private usize m_preeditAnchor = 0u;
    private usize m_preeditCaret = 0u;
    private u64 m_revision = 1u;
    private u64 m_externalRevision = 1u;
    private u64 m_compositionGeneration = 1u;
    private u64 m_selectionGeneration = 1u;
    private EditTextMode m_textMode;
    private b8 m_compositionActive = false;

    public EditModel(){
        this.m_instanceGeneration = AllocateServiceIdentity();
        this.m_limits = ClampEditLimits(EditLimits());
        this.m_textMode = EditTextMode::SingleLine;
        this.initializeModel();
    }

    public EditModel(in EditLimits limits){
        this.m_instanceGeneration = AllocateServiceIdentity();
        this.m_limits = ClampEditLimits(limits);
        this.m_textMode = EditTextMode::SingleLine;
        this.initializeModel();
    }

    public EditModel(in EditLimits limits, in EditTextMode mode){
        this.m_instanceGeneration = AllocateServiceIdentity();
        this.m_limits = ClampEditLimits(limits);
        this.m_textMode = mode;
        this.initializeModel();
    }

    public StringView text()const{
        return StringView(this.m_text);
    }

    public u64 instanceGeneration()const{
        return this.m_instanceGeneration;
    }

    public u64 externalRevision()const{
        return this.m_externalRevision;
    }

    public u64 revision()const{
        return this.m_revision;
    }

    public u64 compositionGeneration()const{
        return this.m_compositionGeneration;
    }

    public u64 selectionGeneration()const{
        return this.m_selectionGeneration;
    }

    public usize anchor()const{
        return this.m_anchor;
    }

    public usize caret()const{
        return this.m_caret;
    }

    public usize selectionStart()const{
        return Min(this.m_anchor, this.m_caret);
    }

    public usize selectionEnd()const{
        return Max(this.m_anchor, this.m_caret);
    }

    public b8 hasSelection()const{
        return this.m_anchor != this.m_caret;
    }

    public StringView selectedText()const{
        return this.text().substr(this.selectionStart(), this.selectionEnd() - this.selectionStart());
    }

    public Span<usize> graphemeBoundaries()const{
        return this.m_boundaries;
    }

    public in EditLimits limits()const{
        return this.m_limits;
    }

    public EditTextMode textMode()const{
        return this.m_textMode;
    }

    public TextAreaModelStamp stamp()const{
        return TextAreaModelStamp(
            this.m_instanceGeneration,
            this.m_revision,
            this.m_externalRevision,
            this.m_selectionGeneration,
            this.m_compositionGeneration,
            this.m_anchor,
            this.m_caret,
            this.m_textMode
        );
    }

    public b8 matchesStamp(in TextAreaModelStamp expected)const{
        return this.stamp() == expected;
    }

    public b8 setText(in StringView value){
        return ApplyEditModelSetText(
            value,
            this.m_limits.maxBytes,
            this.m_textMode,
            this.m_text,
            this.m_boundaries,
            this.m_anchor,
            this.m_caret,
            this.m_selectionGeneration,
            this.m_history,
            this.m_historyCursor,
            this.m_historyBytes,
            this.m_preedit,
            this.m_preeditAnchor,
            this.m_preeditCaret,
            this.m_compositionAnchor,
            this.m_compositionCaret,
            this.m_compositionActive,
            this.m_compositionGeneration,
            this.m_revision,
            this.m_externalRevision
        );
    }

    public b8 setSelection(in usize anchor, in usize caret){
        EditSelectionActions selectionActions;
        return selectionActions.setSelection(
            this.m_boundaries,
            anchor,
            caret,
            this.m_anchor,
            this.m_caret,
            this.m_selectionGeneration,
            this.m_preedit,
            this.m_preeditAnchor,
            this.m_preeditCaret,
            this.m_compositionAnchor,
            this.m_compositionCaret,
            this.m_compositionActive,
            this.m_compositionGeneration
        );
    }

    public b8 selectAll(){
        return this.setSelection(0u, this.m_text.size());
    }

    public b8 move(in EditMove movement, in b8 extend){
        EditSelectionActions selectionActions;
        return selectionActions.move(
            this.text(),
            this.m_boundaries,
            this.m_textMode,
            movement,
            extend,
            this.m_anchor,
            this.m_caret,
            this.m_selectionGeneration,
            this.m_preedit,
            this.m_preeditAnchor,
            this.m_preeditCaret,
            this.m_compositionAnchor,
            this.m_compositionCaret,
            this.m_compositionActive,
            this.m_compositionGeneration
        );
    }

    public b8 move(in EditMove movement){
        return this.move(movement, false);
    }

    public Expected<EditWordRange> wordRangeAt(in usize position)const{
        return ResolveEditWordRangeAt(this.text(), this.m_boundaries, position);
    }

    public Expected<EditWordRange> lineRangeAt(in usize position)const{
        return ResolveEditLineRangeAt(this.text(), this.m_boundaries, this.m_textMode, position);
    }

    public b8 replaceSelection(in StringView value){
        return this.replaceRange(this.selectionStart(), this.selectionEnd(), value);
    }

    public b8 backspace(){
        const EditWordRange range = ResolveEditBackspaceRange(this.m_boundaries, this.m_anchor, this.m_caret);
        return this.replaceRange(range.begin, range.end, "");
    }

    public b8 eraseForward(){
        const EditWordRange range = ResolveEditEraseForwardRange(this.m_boundaries, this.m_text.size(), this.m_anchor, this.m_caret);
        return this.replaceRange(range.begin, range.end, "");
    }

    public b8 eraseSurrounding(in usize beforeBytes, in usize afterBytes){
        if(!CanEraseEditSurrounding(beforeBytes, afterBytes, this.m_caret, this.m_text.size()))
            return false;
        if(beforeBytes == 0u && afterBytes == 0u)
            return true;
        return this.replaceRange(this.m_caret - beforeBytes, this.m_caret + afterBytes, "");
    }

    public b8 eraseAroundSelection(in usize beforeBytes, in usize afterBytes){
        EditHistoryRecord stagedRecord = this.createHistorySlot();
        return ApplyEditModelEraseAroundSelection(
            beforeBytes,
            afterBytes,
            this.m_textMode,
            this.m_limits.maxHistoryRecords,
            this.m_limits.maxHistoryBytes,
            stagedRecord,
            this.m_text,
            this.m_boundaries,
            this.m_anchor,
            this.m_caret,
            this.m_selectionGeneration,
            this.m_history,
            this.m_historyCursor,
            this.m_historyBytes,
            this.m_preedit,
            this.m_preeditAnchor,
            this.m_preeditCaret,
            this.m_compositionAnchor,
            this.m_compositionCaret,
            this.m_compositionActive,
            this.m_compositionGeneration,
            this.m_revision
        );
    }

    public b8 undo(){
        EditHistoryActions historyActions;
        return historyActions.undo(
            this.m_history,
            this.m_textMode,
            this.m_text,
            this.m_boundaries,
            this.m_anchor,
            this.m_caret,
            this.m_selectionGeneration,
            this.m_historyCursor,
            this.m_preedit,
            this.m_preeditAnchor,
            this.m_preeditCaret,
            this.m_compositionAnchor,
            this.m_compositionCaret,
            this.m_compositionActive,
            this.m_compositionGeneration,
            this.m_revision
        );
    }

    public b8 redo(){
        EditHistoryActions historyActions;
        return historyActions.redo(
            this.m_history,
            this.m_textMode,
            this.m_text,
            this.m_boundaries,
            this.m_anchor,
            this.m_caret,
            this.m_selectionGeneration,
            this.m_historyCursor,
            this.m_preedit,
            this.m_preeditAnchor,
            this.m_preeditCaret,
            this.m_compositionAnchor,
            this.m_compositionCaret,
            this.m_compositionActive,
            this.m_compositionGeneration,
            this.m_revision
        );
    }

    public b8 canUndo()const{
        return this.m_historyCursor != 0u;
    }

    public b8 canRedo()const{
        return this.m_historyCursor < this.m_history.size();
    }

    public b8 beginComposition(){
        EditCompositionRules rules;
        this.m_preeditClauses.clear();
        return rules.begin(
            this.m_anchor,
            this.m_caret,
            this.m_preedit,
            this.m_preeditAnchor,
            this.m_preeditCaret,
            this.m_compositionAnchor,
            this.m_compositionCaret,
            this.m_compositionActive,
            this.m_compositionGeneration
        );
    }

    public b8 updateComposition(in StringView value, in usize anchor, in usize caret, in Span<EditPreeditClause> clauses){
        usize prevEnd = 0u;
        for(in EditPreeditClause clause : clauses){
            if(clause.beginByte >= clause.endByte || clause.endByte > value.size() || clause.beginByte < prevEnd)
                return false;
            if(!IsUtf8ScalarBoundary(value, clause.beginByte) || !IsUtf8ScalarBoundary(value, clause.endByte))
                return false;
            if(cast<u8>(clause.style) > cast<u8>(EditPreeditClauseStyle::Selected))
                return false;
            prevEnd = clause.endByte;
        }
        EditCompositionRules rules;
        if(!rules.update(
            this.m_compositionActive,
            value,
            anchor,
            caret,
            this.m_text.size(),
            this.m_compositionAnchor,
            this.m_compositionCaret,
            this.m_limits.maxBytes,
            this.m_textMode,
            this.m_preedit,
            this.m_preeditAnchor,
            this.m_preeditCaret,
            this.m_compositionGeneration
        ))
            return false;
        this.m_preeditClauses.clear();
        this.m_preeditClauses.reserve(clauses.size());
        for(in EditPreeditClause clause : clauses)
            this.m_preeditClauses.push_back(clause);
        return true;
    }

    public b8 commitComposition(in StringView value){
        if(!this.m_compositionActive)
            return false;
        const EditWordRange range = ResolveEditCompositionRange(this.m_compositionAnchor, this.m_compositionCaret);
        const b8 committed = this.replaceRange(range.begin, range.end, value);
        if(committed)
            this.m_preeditClauses.clear();
        return committed;
    }

    public void cancelComposition(){
        EditCompositionRules rules;
        rules.cancel(
            this.m_preedit,
            this.m_preeditAnchor,
            this.m_preeditCaret,
            this.m_compositionAnchor,
            this.m_compositionCaret,
            this.m_compositionActive,
            this.m_compositionGeneration
        );
        this.m_preeditClauses.clear();
    }

    public EditCompositionView composition()const{
        EditCompositionRules rules;
        EditCompositionView result = rules.view(
            StringView(this.m_preedit),
            this.m_preeditAnchor,
            this.m_preeditCaret,
            this.m_compositionAnchor,
            this.m_compositionCaret,
            this.m_compositionActive
        );
        if(result.active && !this.m_preeditClauses.empty())
            result.clauses = Span<EditPreeditClause>(this.m_preeditClauses);
        return result;
    }

    [owner_result] private EditHistoryRecord createHistorySlot()const{
        EditHistoryRecord slot;
        return slot;
    }

    private void initializeModel(){
        if(!IsValidEditTextMode(this.m_textMode))
            TerminateInvariant();
        this.m_boundaries.push_back(0u);
    }

    private b8 replaceRange(in usize begin, in usize end, in StringView replacement){
        EditHistoryRecord stagedRecord = this.createHistorySlot();
        return ApplyEditModelReplaceRange(
            begin,
            end,
            replacement,
            this.m_limits.maxBytes,
            this.m_textMode,
            this.m_limits.maxHistoryRecords,
            this.m_limits.maxHistoryBytes,
            stagedRecord,
            this.m_text,
            this.m_boundaries,
            this.m_anchor,
            this.m_caret,
            this.m_selectionGeneration,
            this.m_history,
            this.m_historyCursor,
            this.m_historyBytes,
            this.m_preedit,
            this.m_preeditAnchor,
            this.m_preeditCaret,
            this.m_compositionAnchor,
            this.m_compositionCaret,
            this.m_compositionActive,
            this.m_compositionGeneration,
            this.m_revision
        );
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsValidEditTextMode(in EditTextMode mode){
    return mode == EditTextMode::SingleLine || mode == EditTextMode::Multiline;
}

b8 CanEraseEditSurrounding(in usize beforeBytes, in usize afterBytes, in usize caret, in usize textSize){
    return beforeBytes <= caret && afterBytes <= textSize - caret;
}

EditWordRange ResolveEditCompositionRange(in usize compositionAnchor, in usize compositionCaret){
    EditWordRange range;
    range.begin = Min(compositionAnchor, compositionCaret);
    range.end = Max(compositionAnchor, compositionCaret);
    return range;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

