[arena, component("mesh")]
class MeshComponent{
    public AssetRef<Mesh> mesh;
}

[arena, component("skinned_mesh_binding")]
class SkinnedMeshBindingComponent{
    public AssetRef<Skin> skin;
    public EntityID skeletonEntity = s_InvalidEntityId;
    [transient]
    public RuntimeMeshHandle runtimeMesh = s_InvalidRuntimeMeshHandle;
}


