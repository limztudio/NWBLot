////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "transparent_multi_runtime.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TransparentMultiSmokeProject : IProjectEntryCallbacks{
    public TransparentMultiSmokeProject(mut ProjectRuntimeContext context){
        this.m_impl = TransparentMultiSmokeProjectImpl(context);
    }

    public b8 onStartup()override{
        return this.m_impl.onStartup();
    }

    public void onShutdown()override{
        this.m_impl.onShutdown();
    }

    public b8 onUpdate(in f32 delta)override{
        return this.m_impl.onUpdate(delta);
    }

    private TransparentMultiSmokeProjectImpl m_impl;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

