#ifndef NWB_GRAPHICS_SHADOW_CSG_SHADOW_DIAGNOSTICS_SLANGI
#define NWB_GRAPHICS_SHADOW_CSG_SHADOW_DIAGNOSTICS_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "light_space_resources.slangi"
#include "../csg/ray_constants.h"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Preserve conservative occlusion while the retained context reports the exact traversal limitation asynchronously.
half3 nwbCsgShadowRayFailure(const uint failure){
    uint previous;
    g_NwbHeapStorageBuffers[g_NwbLightSpacePush.csgContextSlot].InterlockedOr(NWB_CSG_SHADOW_RAY_FAILURE_OFFSET, failure, previous);
    return half3(0.0h);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


