[cpp_name("::BoundingDoubleOrientedBox"), cpp_flags(self_defaulted, binary_serializable, brace_init)]
extern class BoundingDoubleOrientedBox{
    f64x4 center;
    f64x4 extents;
    f64x4 orientation;

    ContainmentType containedBy(...)const;
    ContainmentType contains(...)const;
    ContainmentType containsBoxValues(...)const;
    ContainmentType containsFrustumValues(...)const;
    ContainmentType containsOrientedBoxValues(...)const;
    ContainmentType containsSphereValues(...)const;
    b8 intersects(...)const;
    b8 intersectsBoxValues(...)const;
    b8 intersectsOrientedBoxValues(...)const;
    void transform(...)const;
};

[cpp_name("::BoundingOrientedBox"), cpp_flags(self_defaulted, binary_serializable, brace_init)]
extern class BoundingOrientedBox{
    f32x4 center;
    f32x4 extents;
    f32x4 orientation;

    ContainmentType containedBy(...)const;
    ContainmentType contains(...)const;
    ContainmentType containsBoxValues(...)const;
    ContainmentType containsFrustumValues(...)const;
    ContainmentType containsOrientedBoxValues(...)const;
    ContainmentType containsSphereValues(...)const;
    b8 intersects(...)const;
    b8 intersectsBoxValues(...)const;
    b8 intersectsOrientedBoxValues(...)const;
    void transform(...)const;
};


