#include <impl/ecs_render/shared/statistics_readback_detail.adhd>
#include <impl/ecs_render/refraction/types.adhd>
#include <impl/ecs_render/kernel/descriptor_register_utils.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<impl/assets/graphics/refraction/diagnostics_layout.h>"), cpp_name("NWB_REFRACTION_DIAGNOSTIC_COUNTER_SIZE")]
extern const usize s_RefractionReadbackCounterBytes;
const usize s_RefractionReadbackCounterCount = s_RefractionReadbackCounterBytes / size_of<u32>();

b8 IsRefractionStatisticsResourcesReady(in b8 hasCounters, in b8 counterDescriptorValid, in b8 hasBuffer0){
    return hasCounters && counterDescriptorValid && hasBuffer0;
}

b8 ResolveAcceptedRefractionCsgHardwareEnabled(in b8 csgHardwareEnabled, in b8 hardwareReady){
    return csgHardwareEnabled && hardwareReady;
}

b8 CanSnapshotRefractionStatisticsReadback(
    in b8 hasControl,
    in b8 hasCounters,
    in b8 counterDescriptorValid,
    in b8 hasPrimaryReadbackBuffer
){
    return hasControl && hasCounters && counterDescriptorValid && hasPrimaryReadbackBuffer;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RefractionStatisticsOutcome : IStatisticsOutcome<RefractionStatistics>{
    public usize counterCount()const override{ return s_RefractionReadbackCounterCount; }

    public void accept(mut RefractionStatistics metadata)const override{
        metadata.csgHardwareEnabled = ResolveAcceptedRefractionCsgHardwareEnabled(metadata.csgHardwareEnabled, metadata.hardwareReady);
    }

    public void copyCounters(in Span<u32> counters, in RefractionStatistics metadata, mut RefractionStatistics latest)const override{
        CopyRefractionDiagnosticCounters(counters, latest);
    }
}

type RefractionStatisticsState = StatisticsReadbackState<RefractionStatistics, RefractionStatisticsOutcome>;
type RefractionStatisticsControlHandle = Shared<RefractionStatisticsState>;
type RefractionStatisticsReservation = StatisticsReservation<RefractionStatistics, RefractionStatisticsOutcome>;

class RefractionStatisticsReadbackSnapshot{
    public RefractionStatisticsControlHandle control;
    public BufferHandle counters;
    public GpuDescriptorHandle counterDescriptor = GpuDescriptorHandleInvalid();
    public Array<BufferHandle, s_StatisticsReadbackSlotCount> buffers;
    public RefractionStatistics metadata;
}

class RefractionStatisticsReadback : NoCopy{
    private StatisticsReadbackBuffers<RefractionStatistics, RefractionStatisticsOutcome, s_RefractionReadbackCounterCount> m_readback;
    private BufferHandle m_counters;
    private GpuDescriptorHandle m_counterDescriptor = GpuDescriptorHandleInvalid();

    public RefractionStatisticsReadback(mut GraphicsRuntime graphics){
        this.m_readback = StatisticsReadbackBuffers<RefractionStatistics, RefractionStatisticsOutcome, s_RefractionReadbackCounterCount>(graphics);
    }

    public Expected<RefractionStatistics> latestStatistics()const{ return this.m_readback.latestStatistics(); }

    public void invalidateResources(){
        RetireDescriptor(this.m_readback.graphics.getDevice().getDescriptorHeap(), this.m_counterDescriptor);
        this.m_counters.reset();
        this.m_readback.resetReadbackBuffers();
    }

    [cpp_unwind]
    public b8 prepareResources(){
        if(IsRefractionStatisticsResourcesReady(this.m_counters.valid(), this.m_counterDescriptor.valid(), this.m_readback.buffers[0u].valid()))
            return true;
        BufferDesc counterDesc;
        counterDesc.setByteSize(s_RefractionReadbackCounterBytes).setCanHaveUAVs(true).setCanHaveRawViews(true).setDebugName(s_RefractionDiagnosticCountersName).enableAutomaticStateTracking(ResourceStates::UnorderedAccess);
        const auto counterResult = this.m_readback.graphics.createBuffer(counterDesc);
        if(!counterResult.has_value())
            return false;
        const BufferHandle counters = counterResult.value();
        mut GpuDescriptorHeap heap = this.m_readback.graphics.getDevice().getDescriptorHeap();
        const auto descriptor = RegisterDescriptor(heap, GpuDescriptorClass::StorageBuffer, DescriptorWriteItemRawBufferUav(0u, counters.deref()));
        if(!descriptor.has_value())
            return false;
        GpuDescriptorRetirementGuard retireDescriptor(heap, descriptor.value());
        Array<Name, s_StatisticsReadbackSlotCount> names;
        names[0u] = s_RefractionStatisticsReadback0Name;
        names[1u] = s_RefractionStatisticsReadback1Name;
        names[2u] = s_RefractionStatisticsReadback2Name;
        if(!this.m_readback.prepare(names, "Refraction statistics: failed to allocate readback control"))
            return false;
        this.m_counters = counters;
        this.m_counterDescriptor = descriptor.value();
        retireDescriptor.release();
        return true;
    }

    [cpp_unwind]
    public void pollCompleted(){
        this.m_readback.pollCompleted("Refraction statistics: failed to map a completed readback");
    }

    public RefractionStatisticsReadbackSnapshot snapshot(in RefractionStatistics metadata)const{
        RefractionStatisticsReadbackSnapshot result;
        if(!CanSnapshotRefractionStatisticsReadback(this.m_readback.control.valid(), this.m_counters.valid(), this.m_counterDescriptor.valid(), this.m_readback.buffers[0u].valid()))
            return result;
        this.m_readback.populateSnapshot<RefractionStatisticsReadbackSnapshot>(metadata, result);
        result.counters = this.m_counters;
        result.counterDescriptor = this.m_counterDescriptor;
        return result;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

