////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_shader/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type ShaderAssetCodec<T> = FamilyMemberAssetCodec<IShader, T, ShaderAssetPolicy>;
type PixelShaderAssetCodec = ShaderAssetCodec<PixelShader>;
type ComputeShaderAssetCodec = ShaderAssetCodec<ComputeShader>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[asset("shader")]
interface IShader{
    StringView entryPoint()const;
    in Vector<u8> bytecode()const;
    b8 loadBinary(in Span<u8> binary);
}

class ShaderEntryPointRange{
    public usize offset = 0u;
    public usize length = 0u;

    public StringView view(in Span<u8> bytecode)const{
        return ShaderEntryPointView(bytecode, this.offset, this.length);
    }
}

[arena, asset("vertex_shader")]
class VertexShader : IShader{
    private ShaderEntryPointRange m_entryPoint;
    private Vector<u8> m_bytecode;

    public StringView entryPoint()const override{ return this.m_entryPoint.view(Span<u8>(this.m_bytecode)); }
    public in Vector<u8> bytecode()const override{ return this.m_bytecode; }
    public b8 loadBinary(in Span<u8> binary)override{
        const Expected<ShaderEntryPointRange> entryPoint = LoadShaderBinaryForStage(this, binary, ShaderType::VertexStage, this.m_bytecode);
        if(!entryPoint.has_value())
            return false;
        this.m_entryPoint = entryPoint.value();
        return true;
    }
}

