////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_BVH_RAY_VERTEX_ATTRIB_SLANGI
#define NWB_GRAPHICS_BVH_RAY_VERTEX_ATTRIB_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "constants.h"
#include "../common/math.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Shared per-corner ABI: packed Half4 normal at NORMAL_BYTE_OFFSET, Float2 uv0 at UV0_BYTE_OFFSET.
// Offsets and stride use NWB_RAYTRACE_VERTEX_ATTRIBUTE_*; callers own heap loads.
struct NwbRayTraceVertexAttrib{
    half3 normal;
    float2 uv0;
};

float3 nwbRayTraceDecodeVertexNormal(const uint2 packed){
    return float3(nwbUnpackHalf2x16(packed.x), f16tof32(packed.y & NWB_HALF_BITS_MASK));
}

NwbRayTraceVertexAttrib nwbRayTraceDecodeVertexAttrib(const uint4 packed){
    NwbRayTraceVertexAttrib attrib;
    attrib.normal = half3(nwbRayTraceDecodeVertexNormal(packed.xy));
    attrib.uv0 = asfloat(packed.zw);
    return attrib;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

