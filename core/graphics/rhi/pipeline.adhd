[cpp_header("<core/graphics/rhi/pipeline.h>"), cpp_name("::NWB::Core::RayTracingPipelineDesc")]
extern class RayTracingPipelineDesc{
    Vector<RayTracingPipelineShaderDesc> shaders;
    Vector<RayTracingPipelineHitGroupDesc> hitGroups;
    FixedVector<BindingLayoutHandle, 8> globalBindingLayouts;
    u32 maxPayloadSize;
    u32 maxAttributeSize;
    u32 maxRecursionDepth;
    b8 allowOpacityMicromaps;
    b8 allowClusterAccelerationStructures;
    b8 allowSpheres;
    b8 allowLinearSweptSpheres;
    RayTracingPipelineDesc addBindingLayout(...);
    RayTracingPipelineDesc addHitGroup(...);
    RayTracingPipelineDesc addShader(...);
    RayTracingPipelineDesc setMaxPayloadSize(...);
    RayTracingPipelineDesc setMaxRecursionDepth(...);
};

