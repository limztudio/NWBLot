#include <utilities/tex_conv/global.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsTexConvAlphaOptionPresent(in i32 optionCount){
    return optionCount > s_AlphaOptionPresentCount;
}

b8 ValidateTexConvInputImagePath(in Path path, in b8 alphaMask){
    StringView roleLabel = "input";
    StringView missingLabel = "input image";
    if(alphaMask){
        roleLabel = "alpha image";
        missingLabel = "alpha image";
    }
    const Expected<b8, ErrorCode> isRegularFile = IsRegularFile(path);
    if(!isRegularFile.has_value() && !IsMissingPathError(isRegularFile.error())){
        error("tex_conv: failed to inspect {} '{}': {}", roleLabel, path, ErrorCodeMessage(isRegularFile.error()));
        return false;
    }
    if(!isRegularFile.has_value() || !isRegularFile.value()){
        error("tex_conv: {} was not found or is not a regular file: '{}'", missingLabel, path);
        return false;
    }
    if(!IsSupportedTexConvInputPath(path)){
        error("tex_conv: unsupported {} format; accepted: PNG, JPEG/JFIF, TGA, QOI, OpenEXR, and Radiance HDR.", roleLabel);
        return false;
    }
    return true;
}

String FormatTexConvCompletionReport(
    in Path metadataPath,
    in Path dataPath,
    in u32 width,
    in u32 height,
    in u32 depth,
    in b8 isCube,
    in b8 is3d,
    in u32 mipCount,
    in usize byteCount
){
    const String metadataPathText = PathToGenericString(metadataPath);
    const String dataPathText = PathToGenericString(dataPath);
    String report;
    report.reserve(AddSaturating<usize>(AddSaturating<usize>(metadataPathText.size(), dataPathText.size()), s_CompletionReportReserveSlack));
    StringAppendFormat(report, "Wrote {}\nWrote {}\n  {}x{}", metadataPathText, dataPathText, width, height);
    if(isCube)
        report.append(" cube");
    else if(is3d)
        StringAppendFormat(report, "x{}", depth);
    StringAppendFormat(report, ", {} linear UASTC mips, {} raw bytes\n", mipCount, byteCount);
    return report;
}


