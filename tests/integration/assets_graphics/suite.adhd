b8 CookSingleGraphicsMeta(in StringView metaText, in StringView assetDirectory, in StringView assetFilename, in CookCase cookCase, mut TestArena testArena){
    const GraphicsTestPath assetRoot = JoinGraphicsPath(cookCase.root, s_AssetsDirectory);
    const GraphicsTestPath metaPath = JoinGraphicsPath2(assetRoot, assetDirectory, assetFilename);
    if(!WriteTextFile(metaPath, metaText))
        return false;
    return CookSingleAssetRoot(testArena, cookCase.root, cookCase.outputDirectory, assetRoot);
}

b8 CookSingleMeshMeta(in StringView metaText, in CookCase cookCase, mut TestArena testArena){
    return CookSingleGraphicsMeta(metaText, "meshes", "minimal_mesh.nwb", cookCase, testArena);
}

b8 CookSmokeAssetMeta(in StringView assetDirectory, in StringView assetFilename, in CookCase cookCase, mut TestArena testArena){
    const Expected<TestAString> metaText = ReadSmokeMeta(testArena, assetDirectory, assetFilename);
    if(!metaText.has_value())
        return false;
    return CookSingleGraphicsMeta(ViewTestString(metaText.value()), assetDirectory, assetFilename, cookCase, testArena);
}


