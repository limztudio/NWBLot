void VerifyIntegerModelTests_SubmitCommitsExactLargeIntegerAndCancellationCannotRoundIt(mut IntegerModelTests self){
    ASSERT_TRUE(self.m_model.setDraft("9007199254740993"));
    const NumericEditResult committed = self.m_model.submit();
    ASSERT_TRUE(committed.valid);
    EXPECT_TRUE(committed.committed);
    EXPECT_TRUE(committed.valueChanged);
    EXPECT_EQ(self.m_model.value(), 9007199254740993ll);
    EXPECT_EQ(self.m_model.draft().text(), "9007199254740993");
    ASSERT_TRUE(self.m_model.setDraft("42"));
    const NumericEditResult cancelled = self.m_model.cancel();
    ASSERT_TRUE(cancelled.valid);
    EXPECT_TRUE(cancelled.cancelled);
    EXPECT_TRUE(cancelled.restored);
    EXPECT_FALSE(cancelled.committed);
    EXPECT_EQ(self.m_model.value(), 9007199254740993ll);
    EXPECT_EQ(self.m_model.draft().text(), "9007199254740993");
}

void VerifyIntegerModelTests_InvalidIncompleteAndOverflowSubmitPreserveThePendingDraft(mut IntegerModelTests self){
    ASSERT_TRUE(self.m_model.setValue(7));
    Array<StringView, 4u> drafts = Array<StringView, 4u>();
    drafts[0u] = "-";
    drafts[1u] = "x";
    drafts[2u] = "9223372036854775808";
    drafts[3u] = "-9223372036854775809";
    for(in StringView text : drafts){
        const ScopedTestTrace trace = ScopedTestTrace(text);
        ASSERT_TRUE(self.m_model.setDraft(text));
        ASSERT_TRUE(self.m_model.lendDraft().setSelection(0u, text.size()));
        const MultilineSnapshot before = MultilineSnapshot(self.m_arena, self.m_model.draft());
        const u64 epoch = self.m_model.revision();
        const NumericEditResult result = self.m_model.submit();
        ExpectUiIntegerModelRejected(result, false);
        EXPECT_EQ(self.m_model.value(), 7);
        EXPECT_TRUE(self.m_model.dirty());
        EXPECT_GT(self.m_model.revision(), epoch);
        before.expectUnchanged(self.m_model.draft());
    }
}

void VerifyIntegerModelTests_InvalidBlurRestoresCanonicalTypedValueInsteadOfNoncanonicalAcceptedBytes(mut IntegerModelTests self){
    ASSERT_TRUE(self.m_model.setDraft("+0007"));
    ASSERT_TRUE(self.m_model.submit().committed);
    ASSERT_TRUE(self.m_model.setDraft("-"));
    const NumericEditResult result = self.m_model.blur();
    ExpectUiIntegerModelRejected(result, true);
    EXPECT_EQ(self.m_model.value(), 7);
    EXPECT_EQ(self.m_model.draft().text(), "7");
    EXPECT_FALSE(self.m_model.dirty());
}

void VerifyIntegerModelTests_BoundsAreInclusiveAndRejectRepresentableValuesOutsideThem(mut IntegerModelTests self){
    const IntegerBounds bounds = MakeUiIntegerBounds(-10, 10, NumericBoundsPolicy::Reject);
    Array<i64, 2u> values = Array<i64, 2u>();
    values[0u] = -10ll;
    values[1u] = 10ll;
    for(in i64 value : values){
        ASSERT_TRUE(self.m_model.setValue(value));
        EXPECT_EQ(self.m_model.status(bounds), NumericParseStatus::Complete);
        EXPECT_TRUE(self.m_model.submit(bounds).committed);
    }
    ASSERT_TRUE(self.m_model.setDraft("11"));
    const MultilineSnapshot before = MultilineSnapshot(self.m_arena, self.m_model.draft());
    EXPECT_EQ(self.m_model.status(bounds), NumericParseStatus::OutOfRange);
    const NumericEditResult result = self.m_model.submit(bounds);
    ExpectUiIntegerModelRejected(result, false);
    EXPECT_EQ(self.m_model.value(), 10);
    before.expectUnchanged(self.m_model.draft());
}

void VerifyIntegerModelTests_ClampingCanonicalizesBothSidesButNeverRepresentationOverflow(mut IntegerModelTests self){
    const IntegerBounds bounds = MakeUiIntegerBounds(-10, 10, NumericBoundsPolicy::Clamp);
    Array<StringView, 2u> drafts = Array<StringView, 2u>();
    drafts[0u] = "-11";
    drafts[1u] = "+00011";
    Array<i64, 2u> expected = Array<i64, 2u>();
    expected[0u] = -10;
    expected[1u] = 10;
    for(usize index = 0u; index < 2u; ++index){
        ASSERT_TRUE(self.m_model.setDraft(drafts[index]));
        const u64 external = self.m_model.draft().externalRevision();
        const NumericEditResult result = self.m_model.submit(bounds);
        ASSERT_TRUE(result.valid);
        EXPECT_TRUE(result.committed);
        EXPECT_TRUE(result.clamped);
        EXPECT_FALSE(result.rejected);
        EXPECT_FALSE(result.restored);
        EXPECT_EQ(self.m_model.value(), expected[index]);
        if(index == 0u){
            EXPECT_EQ(self.m_model.draft().text(), "-10");
        }
        else{
            EXPECT_EQ(self.m_model.draft().text(), "10");
        }
        EXPECT_GT(self.m_model.draft().externalRevision(), external);
        EXPECT_FALSE(self.m_model.dirty());
    }
    ASSERT_TRUE(self.m_model.setDraft("9223372036854775808"));
    const NumericEditResult overflow = self.m_model.submit(bounds);
    ExpectUiIntegerModelRejected(overflow, false);
    EXPECT_EQ(self.m_model.value(), 10);
    EXPECT_EQ(self.m_model.draft().text(), "9223372036854775808");
}

void VerifyIntegerModelTests_ExternalValueRemainsAuthoritativeOutsideUserBounds(mut IntegerModelTests self){
    ASSERT_TRUE(self.m_model.setValue(100));
    const IntegerBounds bounds = MakeUiIntegerBounds(-10, 10, NumericBoundsPolicy::Reject);
    EXPECT_EQ(self.m_model.status(bounds), NumericParseStatus::OutOfRange);
    ExpectUiIntegerModelRejected(self.m_model.submit(bounds), false);
    const NumericEditResult blurred = self.m_model.blur(bounds);
    ExpectUiIntegerModelRejected(blurred, false);
    EXPECT_EQ(self.m_model.value(), 100);
    EXPECT_EQ(self.m_model.draft().text(), "100");
}

void VerifyIntegerModelTests_MalformedDraftAbandonRestoresTheAuthoritativeCommittedValue(mut IntegerModelTests self){
    ASSERT_TRUE(self.m_model.setValue(7));
    ASSERT_TRUE(self.m_model.setDraft("x"));
    const NumericEditResult abandoned = self.m_model.abandon();
    ASSERT_TRUE(abandoned.valid);
    EXPECT_TRUE(abandoned.restored);
    EXPECT_EQ(self.m_model.draft().text(), "7");
    EXPECT_EQ(self.m_model.value(), 7);
    EXPECT_FALSE(self.m_model.dirty());
}


