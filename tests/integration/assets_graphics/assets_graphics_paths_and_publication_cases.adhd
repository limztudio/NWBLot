b8 DeserializeNullAllocatedCodec(in Name virtualPath, in AssetBytes bytes, mut TestArena testArena){
    NullAllocatedCodec codec = NullAllocatedCodec();
    return DeserializeTestCodec(codec, virtualPath, bytes, testArena).has_value();
}

Expected<ScratchString> BuildDerivedScratchPath(in GraphicsTestPath assetRoot, in StringView virtualRoot, in GraphicsTestPath source, mut GraphicsScratchArena scratch){
    return DeriveGraphicsScratchPath(assetRoot, virtualRoot, source, scratch.arena, scratch.arena);
}

Expected<AssetString> BuildDerivedOwnedFromScratchSource(mut PathFixture fixture, in ScratchPath source, mut GraphicsScratchArena scratch){
    return DeriveOwnedPathText(fixture.assetRoot, s_ProjectVirtualRoot, source, fixture.storage, scratch.arena);
}

b8 CanBuildDerivedVirtualPath(in GraphicsTestPath assetRoot, in StringView virtualRoot, in GraphicsTestPath source, mut GraphicsScratchArena scratch){
    return DeriveTestAssetPath(assetRoot, virtualRoot, source, scratch.arena).has_value();
}

b8 VerifyDerivedFixturePath(in PathFixture fixture, mut GraphicsScratchArena scratch){
    const auto output = BuildDerivedScratchPath(fixture.assetRoot, s_ProjectVirtualRoot, fixture.sourcePath, scratch);
    return output.has_value() && StringView(output.value()) == fixture.expectedDerived;
}

b8 WriteBuiltManifestHelper(in GraphicsTestPath directory, in AssetVolumePackManifest manifest, mut GraphicsScratchArena scratch){
    return WriteGraphicsBuiltAssets(directory, manifest, scratch.arena);
}

b8 ReadManifestArtifactPaths(in GraphicsTestPath manifestPath, mut GraphicsScratchArena scratch, mut AssetTestVector<AssetString> outPaths){
    return ReadGraphicsInputList(manifestPath, scratch.arena, outPaths, true);
}

void VerifyAssetCodecAdmission_NullClassAllocationDoesNotCallAssetLoad(){
    TestArena testArena = TestArena(s_AssetCaseTestsAssetCodecNullAllocation);
    AssetBytes bytes(testArena.arena);
    mut NullAllocationState state = TestProcessValue<NullAllocationState>();
    state.constructors = 0u;
    state.loaded = false;
    EXPECT_FALSE(DeserializeNullAllocatedCodec(s_AssetCaseProjectTestsNullAsset, bytes, testArena));
    EXPECT_EQ(state.constructors, 0u);
    EXPECT_FALSE(state.loaded);
}

