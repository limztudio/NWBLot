const u64 s_F64InfinityBits = 0x7ff0000000000000u;
const u64 s_F64QuietNanBits = 0x7ff8000000000000u;

GpuPhysicalQueueId MakePhysicalQueue(in u16 index, in u16 deviceGeneration){
    GpuPhysicalQueueId queue = GpuPhysicalQueueId();
    queue.index = index;
    queue.deviceGeneration = deviceGeneration;
    return queue;
}

GpuComparableTimestampRange MakeComparableRange(in u64 beginTicks, in u64 endTicks, in f64 secondsPerTick, in GpuPhysicalQueueId queue){
    GpuComparableTimestampRange range = GpuComparableTimestampRange();
    range.beginTicks = beginTicks;
    range.endTicks = endTicks;
    range.secondsPerTick = secondsPerTick;
    range.physicalQueue = queue;
    return range;
}

GpuPacketEnvelopeMetricScope MakeEnvelopeScope(in Name scopeName, in GpuPhysicalQueueId queue){
    GpuPacketEnvelopeMetricScope scope = GpuPacketEnvelopeMetricScope();
    scope.scopeName = scopeName;
    scope.physicalQueue = queue;
    return scope;
}

GpuPacketEnvelopeMetricQueueOutput MakeEnvelopeOutput(in GpuPhysicalQueueId queue, in Name idleScopeName){
    GpuPacketEnvelopeMetricQueueOutput output = GpuPacketEnvelopeMetricQueueOutput();
    output.physicalQueue = queue;
    output.internalIdleScopeName = idleScopeName;
    return output;
}

TimerQueryResult MakeTimerQueryResult(in u64 beginTicks, in u64 endTicks, in f64 secondsPerTick, in GpuPhysicalQueueId queue, in u32 validBits, in b8 comparable){
    TimerQueryResult result = TimerQueryResult();
    result.beginTicks = beginTicks;
    result.endTicks = endTicks;
    result.secondsPerTick = secondsPerTick;
    result.physicalQueue = queue;
    result.timestampValidBits = validBits;
    result.comparableAcrossSubmissions = comparable;
    return result;
}

void RecordCorrelatorTimestampRange(mut GpuTimingMetricCorrelator correlator, in Name scopeName, in u64 frameIndex, in GpuComparableTimestampRange range, mut ScratchArena scratchArena, mut GpuTimingSinkSampleVector samples){
    native(mut correlator, in scopeName, in frameIndex, in range, mut scratchArena, mut samples){
        correlator.recordTimestampRange(scopeName, frameIndex, range, scratchArena, samples);
    }
}

Expected<GpuPacketEnvelopeMetrics> AggregateEnvelopeMetrics(in Span<GpuComparableTimestampRange> ranges, mut PacketMetricsScratchContext context){
    Expected<GpuPacketEnvelopeMetrics> result = MakeUnexpected(Failure());
    native(in ranges, mut context, mut result){
        result = Core::TryAggregateGpuPacketEnvelopeMetrics(ranges, context.scratchArena, context.queueMetrics);
    }
    return result;
}

void RecordAndPublishTimestampRange(in Name scopeName, in u64 frameIndex, in GpuComparableTimestampRange range, mut TimingMetricContext context){
    GpuTimingSinkSampleVector performanceSamples = GpuTimingSinkSampleVector(context.scratchArena);
    RecordCorrelatorTimestampRange(context.correlator, scopeName, frameIndex, range, context.scratchArena, performanceSamples);
    for(in GpuTimingSinkSample sample : performanceSamples)
        context.timing.recordSample(sample.scope, sample.durationSeconds, sample.sourceFrameIndex);
}

void ExpectEnvelopeMetricsRejected(in Span<GpuComparableTimestampRange> ranges, mut PacketMetricsScratchContext context){
    GpuQueuePacketEnvelopeMetrics stale = GpuQueuePacketEnvelopeMetrics();
    stale.physicalQueue = MakePhysicalQueue(4u, 8u);
    stale.internalIdleTicks = 13u;
    context.queueMetrics.push_back(stale);
    EXPECT_FALSE(AggregateEnvelopeMetrics(ranges, context).has_value());
    EXPECT_TRUE(context.queueMetrics.empty());
}

void VerifyGpuTimingPacketEnvelopeMetrics_CorrelatesLargeOutOfOrderFrame(){
    const usize scopeCount = 2048u;
    const usize pairCount = scopeCount / 2u;
    const u64 frameIndex = 91u;
    CorrelatorContext context = CorrelatorContext();
    context.timing.setEnabled(true);
    GpuPacketEnvelopeMetricScopeScratchVector scopes = GpuPacketEnvelopeMetricScopeScratchVector(context.scratchArena);
    scopes.reserve(scopeCount);
    for(usize scopeIndex = 0u; scopeIndex < scopeCount; ++scopeIndex){
        const Expected<Name> scopeNameResult = DeriveIndexedScopeName(s_GpuTimingCaseLargeEnvelope, scopeIndex);
        ASSERT_TRUE(scopeNameResult.has_value());
        scopes.push_back(MakeEnvelopeScope(scopeNameResult.value(), MakePhysicalQueue(cast<u16>(scopeIndex % 2u), 7u)));
    }
    const Name overlapScope = s_GpuTimingNameTestsTimingLargeEnvelopeOverlap;
    Array<GpuPacketEnvelopeMetricQueueOutput, 2> outputs = Array<GpuPacketEnvelopeMetricQueueOutput, 2>();
    outputs[0u] = MakeEnvelopeOutput(MakePhysicalQueue(0u, 7u), s_GpuTimingCaseLargeIdle0);
    outputs[1u] = MakeEnvelopeOutput(MakePhysicalQueue(1u, 7u), s_GpuTimingCaseLargeIdle1);
    const b8 prepared = context.correlator.preparePacketEnvelopeMetrics(frameIndex, scopes, overlapScope, outputs);
    ASSERT_TRUE(prepared);

    GpuTimingSinkSampleVector samples = GpuTimingSinkSampleVector(context.scratchArena);
    samples.reserve(1u + outputs.size());
    b8 completedEarly = false;
    for(usize arrivalIndex = 0u; arrivalIndex < scopeCount; ++arrivalIndex){
        // An odd stride permutes this power-of-two input count and separates arrival order from queue order.
        const usize scopeIndex = (arrivalIndex * 773u) % scopeCount;
        const GpuPacketEnvelopeMetricScope scope = scopes[scopeIndex];
        const u64 beginTicks = cast<u64>(scopeIndex / 2u) * 20u + cast<u64>(scopeIndex % 2u) * 5u;
        RecordCorrelatorTimestampRange(context.correlator, scope.scopeName, frameIndex, MakeComparableRange(beginTicks, beginTicks + 10u, 0.25, scope.physicalQueue), context.scratchArena, samples);
        if(arrivalIndex + 1u < scopeCount)
            completedEarly = completedEarly || !samples.empty();
    }

    EXPECT_FALSE(completedEarly);
    ASSERT_EQ(samples.size(), 1u + outputs.size());
    for(in GpuTimingSinkSample sample : samples)
        context.timing.recordSample(sample.scope, sample.durationSeconds, sample.sourceFrameIndex);
    context.timing.publishFrame(frameIndex + 1u);

    const TimingStats overlap = context.timing.stats(overlapScope);
    ASSERT_EQ(overlap.sampleCount, 1u);
    EXPECT_DOUBLE_EQ(overlap.seconds, cast<f64>(pairCount * 5u) * 0.25);
    EXPECT_EQ(overlap.firstSampleFrameIndex, frameIndex);
    for(in GpuPacketEnvelopeMetricQueueOutput output : outputs){
        const TimingStats idle = context.timing.stats(output.internalIdleScopeName);
        ASSERT_EQ(idle.sampleCount, 1u);
        EXPECT_DOUBLE_EQ(idle.seconds, cast<f64>((pairCount - 1u) * 10u) * 0.25);
        EXPECT_EQ(idle.firstSampleFrameIndex, frameIndex);
    }
}

void VerifyGpuTimingPacketEnvelopeMetrics_ReplacesDuplicateRangesWithoutCompletingMissingScopes(){
    CorrelatorContext context = CorrelatorContext();
    context.timing.setEnabled(true);
    const GpuPhysicalQueueId firstQueue = MakePhysicalQueue(0u, 9u);
    const GpuPhysicalQueueId secondQueue = MakePhysicalQueue(1u, 9u);
    const Name overlapScope = s_GpuTimingNameTestsTimingDuplicateEnvelopeOverlap;
    Array<GpuPacketEnvelopeMetricScope, 2> scopes = Array<GpuPacketEnvelopeMetricScope, 2>();
    scopes[0u] = MakeEnvelopeScope(s_GpuTimingCaseDuplicateEnvelopeFirst, firstQueue);
    scopes[1u] = MakeEnvelopeScope(s_GpuTimingCaseDuplicateEnvelopeSecond, secondQueue);
    Array<GpuPacketEnvelopeMetricQueueOutput, 2> outputs = Array<GpuPacketEnvelopeMetricQueueOutput, 2>();
    outputs[0u] = MakeEnvelopeOutput(secondQueue, s_GpuTimingCaseDuplicateIdle1);
    outputs[1u] = MakeEnvelopeOutput(firstQueue, s_GpuTimingCaseDuplicateIdle0);
    ASSERT_TRUE(context.correlator.preparePacketEnvelopeMetrics(73u, scopes, overlapScope, outputs));
    GpuTimingSinkSampleVector samples = GpuTimingSinkSampleVector(context.scratchArena);
    samples.reserve(1u + outputs.size());
    GpuComparableTimestampRange range = MakeComparableRange(0u, 100u, 0.5, firstQueue);
    RecordCorrelatorTimestampRange(context.correlator, scopes[0u].scopeName, 73u, range, context.scratchArena, samples);
    ASSERT_TRUE(samples.empty());
    ASSERT_TRUE(context.correlator.preparePacketEnvelopeMetrics(73u, scopes, overlapScope, outputs));
    range.beginTicks = 10u;
    range.endTicks = 20u;
    RecordCorrelatorTimestampRange(context.correlator, scopes[0u].scopeName, 73u, range, context.scratchArena, samples);
    ASSERT_TRUE(samples.empty());

    RecordCorrelatorTimestampRange(context.correlator, scopes[1u].scopeName, 73u, range, context.scratchArena, samples);
    RecordCorrelatorTimestampRange(context.correlator, s_GpuTimingCaseUnrelatedEnvelope, 73u, range, context.scratchArena, samples);
    ASSERT_TRUE(samples.empty());
    range.beginTicks = 15u;
    range.endTicks = 25u;
    range.physicalQueue = secondQueue;
    RecordCorrelatorTimestampRange(context.correlator, scopes[1u].scopeName, 73u, range, context.scratchArena, samples);
    ASSERT_EQ(samples.size(), 3u);
    for(in GpuTimingSinkSample sample : samples)
        context.timing.recordSample(sample.scope, sample.durationSeconds, sample.sourceFrameIndex);
    context.timing.publishFrame(74u);
    EXPECT_DOUBLE_EQ(context.timing.stats(overlapScope).seconds, 2.5);
    EXPECT_DOUBLE_EQ(context.timing.stats(outputs[0u].internalIdleScopeName).seconds, 0.0);
    EXPECT_DOUBLE_EQ(context.timing.stats(outputs[1u].internalIdleScopeName).seconds, 0.0);

    samples.clear();
    RecordCorrelatorTimestampRange(context.correlator, scopes[1u].scopeName, 73u, range, context.scratchArena, samples);
    EXPECT_TRUE(samples.empty());
}

void VerifyGpuTimingPacketEnvelopeMetrics_PreservesPartialFramesAcrossGrowthRejectedPreparesAndOutOfOrderRetirement(){
    const usize frameCount = 8u;
    CorrelatorContext context = CorrelatorContext();
    context.timing.setEnabled(true);
    const GpuPhysicalQueueId firstQueue = MakePhysicalQueue(0u, 9u);
    const GpuPhysicalQueueId secondQueue = MakePhysicalQueue(1u, 9u);
    const Name overlapScope = s_GpuTimingNameTestsTimingGrowingEnvelopeOverlap;
    Array<GpuPacketEnvelopeMetricScope, 2> scopes = Array<GpuPacketEnvelopeMetricScope, 2>();
    scopes[0u] = MakeEnvelopeScope(s_GpuTimingCaseGrowingEnvelopeFirst, firstQueue);
    scopes[1u] = MakeEnvelopeScope(s_GpuTimingCaseGrowingEnvelopeSecond, secondQueue);
    Array<GpuPacketEnvelopeMetricScope, 2> reversedScopes = Array<GpuPacketEnvelopeMetricScope, 2>();
    reversedScopes[0u] = scopes[1u];
    reversedScopes[1u] = scopes[0u];
    Array<GpuPacketEnvelopeMetricScope, 2> duplicateScopes = Array<GpuPacketEnvelopeMetricScope, 2>();
    duplicateScopes[0u] = scopes[0u];
    duplicateScopes[1u] = MakeEnvelopeScope(scopes[0u].scopeName, secondQueue);
    Array<GpuPacketEnvelopeMetricQueueOutput, 2> outputs = Array<GpuPacketEnvelopeMetricQueueOutput, 2>();
    outputs[0u] = MakeEnvelopeOutput(firstQueue, s_GpuTimingCaseGrowingIdle0);
    outputs[1u] = MakeEnvelopeOutput(secondQueue, s_GpuTimingCaseGrowingIdle1);
    EXPECT_FALSE(context.correlator.preparePacketEnvelopeMetrics(100u, duplicateScopes, overlapScope, outputs));
    EXPECT_FALSE(context.correlator.hasOutputRole(overlapScope));
    const GpuComparableTimestampRange firstRange = MakeComparableRange(0u, 10u, 0.5, firstQueue);
    const GpuComparableTimestampRange secondRange = MakeComparableRange(5u, 15u, 0.5, secondQueue);
    GpuTimingSinkSampleVector samples = GpuTimingSinkSampleVector(context.scratchArena);
    samples.reserve(3u);
    for(usize frameOffset = 0u; frameOffset < frameCount; ++frameOffset){
        const u64 frameIndex = 100u + frameOffset;
        const b8 reverseOrder = frameOffset % 2u != 0u;
        if(reverseOrder)
            ASSERT_TRUE(context.correlator.preparePacketEnvelopeMetrics(frameIndex, reversedScopes, overlapScope, outputs));
        else
            ASSERT_TRUE(context.correlator.preparePacketEnvelopeMetrics(frameIndex, scopes, overlapScope, outputs));
        RecordCorrelatorTimestampRange(context.correlator, scopes[0u].scopeName, frameIndex, firstRange, context.scratchArena, samples);
        ASSERT_TRUE(samples.empty());
        EXPECT_FALSE(context.correlator.preparePacketEnvelopeMetrics(frameIndex, duplicateScopes, overlapScope, outputs));
        if(reverseOrder){
            EXPECT_FALSE(context.correlator.preparePacketEnvelopeMetrics(frameIndex, scopes, overlapScope, outputs));
            ASSERT_TRUE(context.correlator.preparePacketEnvelopeMetrics(frameIndex, reversedScopes, overlapScope, outputs));
        }
        else{
            EXPECT_FALSE(context.correlator.preparePacketEnvelopeMetrics(frameIndex, reversedScopes, overlapScope, outputs));
            ASSERT_TRUE(context.correlator.preparePacketEnvelopeMetrics(frameIndex, scopes, overlapScope, outputs));
        }
    }
    for(usize arrivalIndex = 0u; arrivalIndex < frameCount; ++arrivalIndex){
        const u64 frameIndex = 100u + (arrivalIndex * 5u) % frameCount;
        RecordCorrelatorTimestampRange(context.correlator, scopes[0u].scopeName, frameIndex, firstRange, context.scratchArena, samples);
        ASSERT_TRUE(samples.empty());
        RecordCorrelatorTimestampRange(context.correlator, scopes[1u].scopeName, frameIndex, secondRange, context.scratchArena, samples);
        ASSERT_EQ(samples.size(), 3u);
        EXPECT_DOUBLE_EQ(samples[0u].durationSeconds, 2.5);
        EXPECT_DOUBLE_EQ(samples[1u].durationSeconds, 0.0);
        EXPECT_DOUBLE_EQ(samples[2u].durationSeconds, 0.0);
        for(in GpuTimingSinkSample sample : samples)
            EXPECT_EQ(sample.sourceFrameIndex, frameIndex);
        samples.clear();
    }
}

void VerifyGpuTimingPacketEnvelopeMetrics_PublishesNoPartialFrameWhenOutputRegistrationThrows(){
    ThrowOnceCorrelatorContext context = ThrowOnceCorrelatorContext();
    context.timing.setEnabled(true);
    const GpuPhysicalQueueId firstQueue = MakePhysicalQueue(0u, 13u);
    const GpuPhysicalQueueId secondQueue = MakePhysicalQueue(1u, 13u);
    const Name overlapScope = s_GpuTimingNameTestsTimingThrowingEnvelopeOverlap;
    Array<GpuPacketEnvelopeMetricScope, 2> scopes = Array<GpuPacketEnvelopeMetricScope, 2>();
    scopes[0u] = MakeEnvelopeScope(s_GpuTimingCaseThrowingEnvelopeFirst, firstQueue);
    scopes[1u] = MakeEnvelopeScope(s_GpuTimingCaseThrowingEnvelopeSecond, secondQueue);
    Array<GpuPacketEnvelopeMetricQueueOutput, 2> outputs = Array<GpuPacketEnvelopeMetricQueueOutput, 2>();
    outputs[0u] = MakeEnvelopeOutput(firstQueue, s_GpuTimingCaseThrowingIdle0);
    outputs[1u] = MakeEnvelopeOutput(secondQueue, s_GpuTimingCaseThrowingIdle1);
    native(mut context, in scopes, in overlapScope, in outputs){
        EXPECT_THROW(EXPECT_TRUE(context.correlator.preparePacketEnvelopeMetrics(73u, scopes, overlapScope, outputs)), RegistrationSentinel);
    }
    EXPECT_TRUE(context.correlator.hasOutputRole(overlapScope));
    EXPECT_TRUE(context.correlator.hasOutputRole(outputs[0u].internalIdleScopeName));
    EXPECT_FALSE(context.correlator.hasOutputRole(outputs[1u].internalIdleScopeName));
    native(mut context, in scopes, in overlapScope, in outputs){
        ASSERT_TRUE(context.correlator.preparePacketEnvelopeMetrics(73u, scopes, overlapScope, outputs));
    }

    GpuTimingSinkSampleVector samples = GpuTimingSinkSampleVector(context.scratchArena);
    samples.reserve(3u);
    const GpuComparableTimestampRange firstRange = MakeComparableRange(2u, 8u, 0.5, firstQueue);
    const GpuComparableTimestampRange secondRange = MakeComparableRange(4u, 10u, 0.5, secondQueue);
    RecordCorrelatorTimestampRange(context.correlator, scopes[0u].scopeName, 73u, firstRange, context.scratchArena, samples);
    EXPECT_TRUE(samples.empty());
    RecordCorrelatorTimestampRange(context.correlator, scopes[1u].scopeName, 73u, secondRange, context.scratchArena, samples);
    ASSERT_EQ(samples.size(), 3u);
    EXPECT_DOUBLE_EQ(samples[0u].durationSeconds, 2.0);
}

void VerifyGpuPacketEnvelopeMetrics_UnionsSameQueueRangesAndOrdersEveryQueue(){
    PacketMetricsScratchContext context = PacketMetricsScratchContext(s_GpuTimingCasePacketMetricsUnion);
    Array<GpuComparableTimestampRange, 8> ranges = Array<GpuComparableTimestampRange, 8>();
    ranges[0u] = MakeComparableRange(40u, 50u, 0.25, MakePhysicalQueue(2u, 7u));
    ranges[1u] = MakeComparableRange(100u, 100u, 0.25, MakePhysicalQueue(1u, 7u));
    ranges[2u] = MakeComparableRange(8u, 20u, 0.25, MakePhysicalQueue(2u, 7u));
    ranges[3u] = MakeComparableRange(5u, 15u, 0.25, MakePhysicalQueue(0u, 7u));
    ranges[4u] = MakeComparableRange(0u, 10u, 0.25, MakePhysicalQueue(2u, 7u));
    ranges[5u] = MakeComparableRange(20u, 30u, 0.25, MakePhysicalQueue(2u, 7u));
    ranges[6u] = MakeComparableRange(42u, 45u, 0.25, MakePhysicalQueue(2u, 7u));
    ranges[7u] = MakeComparableRange(0u, 10u, 0.25, MakePhysicalQueue(2u, 7u));
    const Expected<GpuPacketEnvelopeMetrics> metrics = AggregateEnvelopeMetrics(ranges, context);
    ASSERT_TRUE(metrics.has_value());
    EXPECT_DOUBLE_EQ(metrics.value().secondsPerTick, 0.25);
    EXPECT_EQ(metrics.value().queueOverlapTicks, 10u);
    ASSERT_EQ(context.queueMetrics.size(), 3u);
    EXPECT_EQ(context.queueMetrics[0u].physicalQueue.index, 0u);
    EXPECT_EQ(context.queueMetrics[0u].internalIdleTicks, 0u);
    EXPECT_EQ(context.queueMetrics[1u].physicalQueue.index, 1u);
    EXPECT_EQ(context.queueMetrics[1u].internalIdleTicks, 0u);
    EXPECT_EQ(context.queueMetrics[2u].physicalQueue.index, 2u);
    EXPECT_EQ(context.queueMetrics[2u].internalIdleTicks, 10u);
}

