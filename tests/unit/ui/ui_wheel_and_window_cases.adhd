const u32 s_UiWheelWindowQuietNaNF32Bits = 0x7fc00000u;
const u32 s_UiWheelWindowMaxF32Bits = 0x7f7fffffu;
const u64 s_UiWheelQuietNaNF64Bits = 0x7ff8000000000000u;
const u64 s_UiWheelPosInfF64Bits = 0x7ff0000000000000u;
const AStringView s_UiWindowSkinApplyKey = "apply";


InputEvent MakeUiWindowPointerEvent(in Point position, in InputEventTypeEnum eventType){
    InputEvent event = InputEvent();
    event.position = position;
    event.type = eventType;
    return event;
}

InputEvent MakeUiWindowKeyEvent(in UiWindowKeyEnum key, in InputEventTypeEnum eventType, in b8 repeat){
    InputEvent event = InputEvent();
    event.key = key;
    event.type = eventType;
    event.repeat = repeat;
    return event;
}

HitTarget MakeUiWheelHost(){
    HitTarget target = HitTarget();
    target.id.value = 1u;
    target.declarationGeneration = 7u;
    target.rectangle = Rect(0.0f, 0.0f, 100.0f, 100.0f);
    target.clip = Rect(0.0f, 0.0f, 300.0f, 200.0f);
    target.focusable = true;
    target.scrollable = true;
    target.control.instanceGeneration = 11u;
    target.control.contentGeneration = 21u;
    target.control.contentRevision = 31u;
    target.scrollStep = 48.0;
    target.gestureMaximum = 360.0;
    target.scrollStepX = 32.0;
    target.gestureMaximumX = 180.0;
    return target;
}

HitTarget MakeUiWheelPart(in HitTarget host){
    HitTarget part = HitTarget();
    part.id.value = 2u;
    part.declarationGeneration = host.declarationGeneration;
    part.rectangle = Rect(90.0f, 20.0f, 10.0f, 20.0f);
    part.clip = host.clip;
    part.paintOrder = 1u;
    part.owner = host.id;
    part.ownerDeclarationGeneration = host.declarationGeneration;
    part.control = host.control;
    part.pointerGesture = true;
    part.gestureReference = Rect(90.0f, 0.0f, 10.0f, 100.0f);
    part.gestureMaximum = host.gestureMaximum;
    return part;
}

InputRoutingResult SendUiWheelInput(mut UiWheelInputTests self, in f64 deltaX, in f64 deltaY, in Point position){
    InputEvent event = InputEvent();
    event.type = InputEventType::PointerWheel;
    event.position = position;
    event.scrollX = deltaX;
    event.scrollY = deltaY;
    EXPECT_TRUE(self.m_router.queue(NativeInput(event)).has_value());
    return self.m_router.process();
}

b8 QueueUiWheelPointer(mut UiWheelInputTests self, in Point position, in InputEventTypeEnum eventType){
    InputEvent event = InputEvent();
    event.position = position;
    event.type = eventType;
    return self.m_router.queue(NativeInput(event)).has_value();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyUiGlyphSdf_FreeTypeZeroIs128Over255AndExteriorInteriorClampToEndpoints(){
    EXPECT_NEAR(UiGlyphSdfDistance(128.0f / 255.0f, 8u), 0.0f, 0.000001f);
    EXPECT_NEAR(UiGlyphSdfCoverage(UiGlyphSdfDistance(128.0f / 255.0f, 8u), 1.0f), 0.5f, 0.000001f);
    EXPECT_FLOAT_EQ(UiGlyphSdfDistance(0.0f, 8u), -8.0f);
    EXPECT_FLOAT_EQ(UiGlyphSdfDistance(1.0f, 8u), 7.9375f);
    EXPECT_FLOAT_EQ(UiGlyphSdfCoverage(UiGlyphSdfDistance(0.0f, 8u), 1.0f), 0.0f);
    EXPECT_FLOAT_EQ(UiGlyphSdfCoverage(UiGlyphSdfDistance(1.0f, 8u), 1.0f), 1.0f);
    // A generic 0.5 threshold is incorrect for FreeType's asymmetric u8 encoding.
    EXPECT_FLOAT_EQ(UiGlyphSdfCoverage(UiGlyphSdfDistance(0.5f, 8u), 1.0f), 0.46875f);
}

void VerifyUiGlyphSdf_FlatFieldsRemainFiniteAcrossEveryAdmittedSpread(){
    EXPECT_FLOAT_EQ(UiGlyphSdfCoverage(0.0f, 0.0f), 0.5f);
    // The flat-field epsilon bounds FP32 decode residuals across all spreads.
    for(u32 spread = s_FontAtlasMinSpreadPixels; spread <= s_FontAtlasMaxSpreadPixels; ++spread)
        EXPECT_NEAR(UiGlyphSdfCoverage(UiGlyphSdfDistance(128.0f / 255.0f, spread), 0.0f), 0.5f, 0.01f);
    EXPECT_FLOAT_EQ(UiGlyphSdfCoverage(-1.0f, 0.0f), 0.0f);
    EXPECT_FLOAT_EQ(UiGlyphSdfCoverage(1.0f, 0.0f), 1.0f);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyUiWheelInputTests_DiagonalWheelCopiesBothAcceptedAxesIntoOneAction(mut UiWheelInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 5u));
    EXPECT_TRUE(self.wheel(0.25, -0.5, Point(95.0f, 25.0f)).pointerConsumed);
    ASSERT_EQ(self.m_router.controlActions().size(), 1u);
    EXPECT_FALSE(self.m_router.focus().valid());
    self.m_targets[0u].scrollStep = 99.0;
    self.m_targets[0u].scrollStepX = 101.0;
    self.m_targets[0u].gestureMaximum = 999.0;
    self.m_targets[0u].gestureMaximumX = 1001.0;
    const auto actionResult = self.m_router.consumeControlAction(self.m_targets[0u].id, 7u, self.m_targets[0u].control);
    ASSERT_TRUE(actionResult.has_value());
    const ControlAction action = actionResult.value();
    EXPECT_DOUBLE_EQ(action.delta, -0.5);
    EXPECT_DOUBLE_EQ(action.deltaX, 0.25);
    EXPECT_DOUBLE_EQ(action.step, 48.0);
    EXPECT_DOUBLE_EQ(action.stepX, 32.0);
    EXPECT_DOUBLE_EQ(action.maximum, 360.0);
    EXPECT_DOUBLE_EQ(action.maximumX, 180.0);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.m_router.actions().empty());
}

void VerifyUiWheelInputTests_VerticalOnlyListConsumesPureXWithoutDeliveringAControlAction(mut UiWheelInputTests self){
    self.m_targets[0u].scrollStepX = 0.0;
    self.m_targets[0u].gestureMaximumX = 0.0;
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    EXPECT_TRUE(self.wheel(2.0, 0.0).pointerConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_FALSE(self.wheel(2.0, 0.0, Point(250.0f, 180.0f)).pointerConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
}

void VerifyUiWheelInputTests_VerticalOnlyListDiagonalStillDeliversItsExactVerticalStep(mut UiWheelInputTests self){
    self.m_targets[0u].scrollStepX = 0.0;
    self.m_targets[0u].gestureMaximumX = 0.0;
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    EXPECT_TRUE(self.wheel(2.0, 0.5).pointerConsumed);
    const auto actionResult = self.m_router.consumeControlAction(self.m_targets[0u].id, 7u, self.m_targets[0u].control);
    ASSERT_TRUE(actionResult.has_value());
    const ControlAction action = actionResult.value();
    EXPECT_DOUBLE_EQ(action.delta, 0.5);
    EXPECT_DOUBLE_EQ(action.step, 48.0);
    EXPECT_DOUBLE_EQ(action.maximum, 360.0);
    EXPECT_DOUBLE_EQ(action.deltaX, 2.0);
    EXPECT_DOUBLE_EQ(action.stepX, 0.0);
    EXPECT_DOUBLE_EQ(action.maximumX, 0.0);
    EXPECT_TRUE(self.m_router.controlActions().empty());
}

void VerifyUiWheelInputTests_DiagonalWheelOccupiesOnePositionBetweenGestureUpdates(mut UiWheelInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    ASSERT_TRUE(self.queuePointer(Point(95.0f, 25.0f), InputEventType::PrimaryDown));
    EXPECT_TRUE(self.m_router.process().pointerConsumed);
    const auto firstResult = self.m_router.consumePointerGesture(self.m_targets[1u].id, 7u);
    ASSERT_TRUE(firstResult.has_value());
    const PointerGesture first = firstResult.value();
    EXPECT_TRUE(self.wheel(1.0, -1.0, Point(95.0f, 25.0f)).pointerConsumed);
    ASSERT_EQ(self.m_router.controlActions().size(), 1u);
    const auto actionResult = self.m_router.consumeControlAction(self.m_targets[0u].id, 7u, self.m_targets[0u].control);
    ASSERT_TRUE(actionResult.has_value());
    const ControlAction action = actionResult.value();
    EXPECT_EQ(action.id.sequence, first.updateSequence + 1u);
    ASSERT_TRUE(self.queuePointer(Point(95.0f, 60.0f), InputEventType::PointerMove));
    EXPECT_TRUE(self.m_router.process().pointerConsumed);
    const auto movedResult = self.m_router.consumePointerGesture(self.m_targets[1u].id, 7u);
    ASSERT_TRUE(movedResult.has_value());
    const PointerGesture moved = movedResult.value();
    EXPECT_EQ(moved.updateSequence, action.id.sequence + 1u);
    EXPECT_EQ(moved.id.sequence, first.id.sequence);
}

void VerifyUiWheelInputTests_InvalidHorizontalMetadataRejectsPublicationAndPreservesPendingAction(mut UiWheelInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    EXPECT_TRUE(self.wheel(1.0, -1.0).pointerConsumed);
    const HitTarget accepted = self.m_targets[0u];
    Array<f64, 3u> invalid;
    invalid[0u] = -1.0;
    invalid[1u] = bit_cast<f64>(s_UiWheelQuietNaNF64Bits);
    invalid[2u] = bit_cast<f64>(s_UiWheelPosInfF64Bits);
    for(usize index = 0u; index < invalid.size(); ++index){
        const f64 value = invalid[index];
        self.m_targets[0u] = accepted;
        self.m_targets[0u].scrollStepX = value;
        EXPECT_FALSE(self.m_router.commitTargets(self.m_targets, 2u));
        self.m_targets[0u] = accepted;
        self.m_targets[0u].gestureMaximumX = value;
        EXPECT_FALSE(self.m_router.commitTargets(self.m_targets, 2u));
    }
    EXPECT_EQ(self.m_router.layoutGeneration(), 1u);
    ASSERT_EQ(self.m_router.controlActions().size(), 1u);
    const auto actionResult = self.m_router.consumeControlAction(accepted.id, 7u, accepted.control);
    ASSERT_TRUE(actionResult.has_value());
    const ControlAction action = actionResult.value();
    EXPECT_DOUBLE_EQ(action.deltaX, 1.0);
    EXPECT_DOUBLE_EQ(action.maximumX, 180.0);
}

void VerifyUiWheelInputTests_SceneOwnedPressCannotAcquireEitherWheelAxisOverAHost(mut UiWheelInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    ASSERT_TRUE(self.queuePointer(Point(250.0f, 180.0f), InputEventType::PrimaryDown));
    EXPECT_FALSE(self.m_router.process().pointerConsumed);
    EXPECT_FALSE(self.wheel(1.0, -1.0).pointerConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    ASSERT_TRUE(self.queuePointer(Point(10.0f, 10.0f), InputEventType::PrimaryUp));
    EXPECT_FALSE(self.m_router.process().pointerConsumed);
    EXPECT_TRUE(self.wheel(1.0, -1.0).pointerConsumed);
    EXPECT_EQ(self.m_router.controlActions().size(), 1u);
}


