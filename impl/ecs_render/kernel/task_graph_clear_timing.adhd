#include <impl/ecs_render/kernel/task_timing_telemetry_labels.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/global.adhd.h>
#include <impl/ecs_render/kernel/task_timing_telemetry_labels.adhd.h>

#include <core/graphics/runtime/runtime.h>
#include <core/task/gpu/task_desc.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct GraphClearTimingRecordState{
    Core::GraphicsRuntime* graphics = nullptr;
    Optional<Core::GpuTimingMeasure>* timing = nullptr;
    Core::GpuTimingSubmissionTicket** rebindableTimingTicket = nullptr;
    Core::GpuTimingSubmissionTicket* timingTicket = nullptr;
    Core::GpuTimingScopeDefinition scope;
};


[[nodiscard]] FOUNDATION_INLINE Core::GpuTimingSubmissionTicket* ResolveGraphClearTimingTicket(const GraphClearTimingRecordState& state)noexcept{
    return state.rebindableTimingTicket ? *state.rebindableTimingTicket : state.timingTicket;
}

[[nodiscard]] FOUNDATION_INLINE b8 BeginGraphClearTiming(
    Core::GraphicsRuntime* const graphics,
    Optional<Core::GpuTimingMeasure>* const timing,
    Core::GpuTimingSubmissionTicket* const timingTicket,
    const Core::GpuTimingScopeDefinition& scope,
    Core::CommandList& commandList
){
    if(!CanBeginGraphClearTimingState(graphics != nullptr, timing != nullptr, timingTicket != nullptr, timing && timing->has_value()))
        return false;

    Core::GpuTimingSubmissionTicket::RecordingScope timingRecording(*timingTicket);
    timing->emplace(graphics->gpuTiming(), scope, graphics->getDevice(), commandList);
    return Core::FinishSplitGpuTimingMarker(timing);
}

[[nodiscard]] FOUNDATION_INLINE b8 EndGraphClearTiming(Optional<Core::GpuTimingMeasure>* const timing, Core::GpuTimingSubmissionTicket* const timingTicket, Core::CommandList& commandList){
    if(!CanEndGraphClearTimingState(timing != nullptr, timing && timing->has_value(), timingTicket != nullptr))
        return false;

    Core::GpuTimingSubmissionTicket::RecordingScope timingRecording(*timingTicket);
    timing->value().finishTiming(commandList);
    timing->reset();
    return true;
}

[[nodiscard]] FOUNDATION_INLINE b8 BeginGraphClearTimingRecord(void* const rawState, Core::CommandList& commandList, [[maybe_unused]] const Core::GpuTaskRecordContext& context){
    GraphClearTimingRecordState* const state = static_cast<GraphClearTimingRecordState*>(rawState);
    if(!state)
        return false;
    return BeginGraphClearTiming(state->graphics, state->timing, ResolveGraphClearTimingTicket(*state), state->scope, commandList);
}

[[nodiscard]] FOUNDATION_INLINE b8 EndGraphClearTimingRecord(void* const rawState, Core::CommandList& commandList, [[maybe_unused]] const Core::GpuTaskRecordContext& context){
    GraphClearTimingRecordState* const state = static_cast<GraphClearTimingRecordState*>(rawState);
    if(!state)
        return false;
    return EndGraphClearTiming(state->timing, ResolveGraphClearTimingTicket(*state), commandList);
}

FOUNDATION_INLINE void DiscardGraphClearTimingRecord(void* const rawState){
    GraphClearTimingRecordState* const state = static_cast<GraphClearTimingRecordState*>(rawState);
    if(!state)
        return;
    Core::DiscardGpuTimingMeasure(state->timing);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


