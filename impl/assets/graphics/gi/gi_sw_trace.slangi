////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_GI_SW_TRACE_SLANGI
#define NWB_GRAPHICS_GI_SW_TRACE_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// SW backend of the GI trace seam: walks the shared SW BVH; HW twin is gi_hw_trace.slangi (same hit + Lambert via gi_trace_common, so both bounce identically). Heap-selected context picks scene/material buffers; producer owns outputs.


#include "constants.h"
#include "../shadow/sw_binding_slots.h"
#include "../bvh/constants.h"
#include "../deferred/bindless_resources.slangi"
#include "../raytrace/material_context_slots.slangi"
#include "../bindless/bindless_heap_rt.slangi"
#include "surfel/surfel_heap_resources.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// The shared scene-shading CB + light list are target-generation heap entries. The surfel trace push block selects the deferred target-generation payload itself from the global UniformBuffer table, so this shader has no local CBV.
#define g_NwbGiSwBindlessResources g_NwbHeapDeferredBindlessResources[g_NwbSurfelHeapPushConstants.deferredResourcesHeapSlot]
#define NWB_SCENE_SHADING_HEAP_SLOT g_NwbGiSwBindlessResources.avboitSlots.z
#define NWB_SCENE_LIGHT_LIST_HEAP_SLOT g_NwbGiSwBindlessResources.avboitSlots.w

// Per-trace scene/material context. Its uniform heap slot is also pushed, selecting the five StorageBuffer aliases without a local selector CBV.
#define g_NwbGiSwMaterialContextSlots g_NwbHeapSurfelMaterialContextSlotBuffers[g_NwbSurfelHeapPushConstants.materialContextSlotsHeapSlot]

// The generated material-surface evaluator reaches its typed words and mutable mesh-instance records through the mesh bindless-frame route before material_typed_bindings.slangi is included by shadow_surface.slangi.
uint nwbMeshFrameMaterialTypedHeapSlot(){
    return g_NwbGiSwMaterialContextSlots.sceneSlots.w;
}
uint nwbMeshFrameInstanceHeapSlot(){
    return g_NwbGiSwMaterialContextSlots.materialSlots.x;
}
// The trace material surface never reads mesh view data; bindless view mode keeps bindless_heap_mesh.slangi from declaring a phantom local view cbuffer while retaining a valid helper for any incidental include-time reference.
uint nwbMeshFrameViewHeapSlot(){
    return 0u;
}
// Provides the typed material-word and mesh-instance views that material_typed_bindings.slangi aliases above.
#include "../bindless/bindless_heap_mesh.slangi"

// GI shades direct scene lights with an occlusion ray; it never samples the screen-space shadow/caustic textures.
// Omitting those declarations prevents their default set-0 bindings from aliasing GI's typed material buffers.
#define NWB_SCENE_SHADOW_CAUSTIC_SAMPLING_DISABLED 1

// The generated shadow dispatch is also the material-surface evaluator for GI. It reads the typed material constants and mutable instance storage through the heap-selected context above, so GI evaluates the authored NwbMeshSurface instead of guessing one project-interface field.
#include "../shadow/shadow_surface.slangi"
#include "shadow/generated/surface_dispatch.slangi"

// The shared trace body: NwbGiTraceHit + nwbGiShadeHit + the scene/light bindings + the nwbGiTraceClosest seam decl.
#if NWB_GI_CSG_ENABLED
#define NWB_CSG_RAY_HARDWARE 0
#define NWB_CSG_RAY_SW_STACK_SIZE NWB_GI_SW_MESH_STACK_SIZE
#endif
#include "gi_geometry.slangi"
// SW-only: the CPU-built scene/instance/per-mesh BVH node type.
#include "../bvh/bvh_common.slangi"
#include "../bvh/ray_iterator.slangi"
#include "../bvh/sw_instance.slangi"
#include "../bvh/ray_vertex_attrib.slangi"

// Global descriptor-heap accessors for per-mesh and scene BVH geometry. The material record carries per-mesh slots; the heap-selected trace context carries the scene-node slot. This include provides nwbHeapBvhNodes() and nwbHeapRawBuffer().
#include "../bindless/bindless_heap_bvh.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// The scene-instance table shares the StorageBuffer descriptor class with the per-mesh BVH, material, and typed buffers.
// This pass-local typed alias supplies its 64-byte record stride without introducing a second heap class.
#pragma warning(push)
#pragma warning(disable: 39001) // Deliberate typed view of the StorageBuffer descriptor table.
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
StructuredBuffer<NwbSwBvhInstance, Std430DataLayout> g_NwbHeapGiSwInstanceBuffers[];
#pragma warning(pop)

StructuredBuffer<NwbSwBvhInstance, Std430DataLayout> nwbHeapGiSwInstances(const uint slot){
    return g_NwbHeapGiSwInstanceBuffers[slot];
}

// Per-mesh nodes, positions, indices, and attributes are read through descriptor-heap slots carried by the material record.
// The shared C++ backing buffers, including the scene tables selected above, remain transitioned for heap reads.


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NwbRayTriangleHit nwbGiSwTriangleHit(
    const NwbRtInstanceMaterial material,
    const uint primitive,
    const float3 origin,
    const float3 direction,
    const float minimum,
    const float maximum
){
    const uint3 indices = nwbHeapRawBuffer(material.indexSlot).Load3(primitive * NWB_RAYTRACE_TRIANGLE_CORNER_COUNT * NWB_RAYTRACE_INDEX_STRIDE_BYTES);
    const float3 v0 = asfloat(nwbHeapRawBuffer(material.positionSlot).Load3(indices.x * NWB_RAYTRACE_POSITION_STRIDE_BYTES));
    const float3 v1 = asfloat(nwbHeapRawBuffer(material.positionSlot).Load3(indices.y * NWB_RAYTRACE_POSITION_STRIDE_BYTES));
    const float3 v2 = asfloat(nwbHeapRawBuffer(material.positionSlot).Load3(indices.z * NWB_RAYTRACE_POSITION_STRIDE_BYTES));
    return nwbRayTriangleMollerTrumbore(origin, direction, minimum, maximum, v0, v1, v2);
}

void nwbGiSwInstanceClosest(
    const uint instanceIndex,
    const float3 worldOrigin,
    const float3 worldDirection,
    const float minimum,
    inout NwbGiGeometryHit closest
){
    const NwbRtInstanceMaterial material = nwbHeapRtInstanceMaterials(g_NwbGiSwMaterialContextSlots.sceneSlots.z)[instanceIndex];
#if NWB_GI_CSG_ENABLED
    if((material.flags & NWB_RT_INSTANCE_MATERIAL_FLAG_CSG_SHADOW) != 0u){
        const NwbGiGeometryHit geometry = nwbGiCsgGeometryHit(
            g_NwbGiSwMaterialContextSlots.materialSlots.w, g_NwbGiSwMaterialContextSlots.sceneSlots.z,
            instanceIndex, worldOrigin, worldDirection, minimum, closest.distance
        );
        if(geometry.hit)
            closest = geometry;
        return;
    }
#endif
    const NwbSwBvhInstance instance = nwbHeapGiSwInstances(g_NwbGiSwMaterialContextSlots.sceneSlots.y)[instanceIndex];
    NwbBvhRayIterator<NWB_GI_SW_MESH_STACK_SIZE> iterator = nwbBvhRayBeginWalk<NWB_GI_SW_MESH_STACK_SIZE>(
        material.nodeSlot, nwbSwBvhTransformPoint(instance, worldOrigin), nwbSwBvhTransformVector(instance, worldDirection),
        minimum, closest.distance
    );
    uint primitive;
    while(nwbBvhRayNextLeaf(iterator, primitive)){
        const NwbRayTriangleHit triangle = nwbGiSwTriangleHit(material, primitive, iterator.origin, iterator.direction, iterator.minimum, iterator.maximum);
        if(!triangle.hit)
            continue;
        closest.hit = true;
        closest.instance = instanceIndex;
        closest.primitive = primitive;
        closest.distance = triangle.t;
        closest.barycentrics = float2(triangle.u, triangle.v);
        closest.normal = nwbSafeNormalize(nwbSwBvhTransformNormal(instance, triangle.normal), float3(0.0, 0.0, 1.0));
#if NWB_GI_CSG_ENABLED
        closest.cutter = NWB_CSG_RAY_INVALID_INDEX;
#endif
        iterator.maximum = triangle.t;
    }
#if NWB_GI_CSG_ENABLED
    if(iterator.overflow){
        nwbGiReportGeometryFailure(NWB_CSG_RAY_FAILURE_CAPACITY);
        closest.hit = true;
        closest.failure = NWB_CSG_RAY_FAILURE_CAPACITY;
        closest.distance = minimum;
    }
#endif
}

NwbGiTraceHit nwbGiTraceClosest(float3 origin, float3 direction, float tMin, float tMax){
    NwbGiGeometryHit closest = nwbGiEmptyGeometryHit(tMax);
    NwbBvhRayIterator<NWB_GI_SW_SCENE_STACK_SIZE> iterator = nwbBvhRayBeginWalk<NWB_GI_SW_SCENE_STACK_SIZE>(
        g_NwbGiSwMaterialContextSlots.sceneSlots.x, origin, direction, tMin, tMax
    );
    uint instanceIndex;
    while(nwbBvhRayNextLeaf(iterator, instanceIndex)){
        nwbGiSwInstanceClosest(instanceIndex, origin, direction, tMin, closest);
        iterator.maximum = closest.distance;
    }
#if NWB_GI_CSG_ENABLED
    if(iterator.overflow){
        nwbGiReportGeometryFailure(NWB_CSG_RAY_FAILURE_CAPACITY);
        closest.hit = true;
        closest.failure = NWB_CSG_RAY_FAILURE_CAPACITY;
        closest.distance = tMin;
    }
#endif
    float3x4 worldToObject = float3x4(0.0);
    if(closest.hit && closest.failure == 0u){
        const NwbSwBvhInstance instance = nwbHeapGiSwInstances(g_NwbGiSwMaterialContextSlots.sceneSlots.y)[closest.instance];
        worldToObject = float3x4(instance.worldToObjectRow0, instance.worldToObjectRow1, instance.worldToObjectRow2);
    }
    return nwbGiReconstructHit(closest, g_NwbGiSwMaterialContextSlots.sceneSlots.z, worldToObject, origin, direction);
}

bool nwbGiSwInstanceOccluded(
    const uint instanceIndex,
    const float3 worldOrigin,
    const float3 worldDirection,
    const float minimum,
    const float maximum
){
    const NwbRtInstanceMaterial material = nwbHeapRtInstanceMaterials(g_NwbGiSwMaterialContextSlots.sceneSlots.z)[instanceIndex];
#if NWB_GI_CSG_ENABLED
    if((material.flags & NWB_RT_INSTANCE_MATERIAL_FLAG_CSG_SHADOW) != 0u){
        const NwbGiGeometryHit geometry = nwbGiCsgGeometryHit(
            g_NwbGiSwMaterialContextSlots.materialSlots.w, g_NwbGiSwMaterialContextSlots.sceneSlots.z,
            instanceIndex, worldOrigin, worldDirection, minimum, maximum
        );
        return geometry.hit;
    }
#endif
    const NwbSwBvhInstance instance = nwbHeapGiSwInstances(g_NwbGiSwMaterialContextSlots.sceneSlots.y)[instanceIndex];
    NwbBvhRayIterator<NWB_GI_SW_MESH_STACK_SIZE> iterator = nwbBvhRayBeginWalk<NWB_GI_SW_MESH_STACK_SIZE>(
        material.nodeSlot, nwbSwBvhTransformPoint(instance, worldOrigin), nwbSwBvhTransformVector(instance, worldDirection),
        minimum, maximum
    );
    uint primitive;
    while(nwbBvhRayNextLeaf(iterator, primitive)){
        if(nwbGiSwTriangleHit(material, primitive, iterator.origin, iterator.direction, iterator.minimum, iterator.maximum).hit)
            return true;
    }
#if NWB_GI_CSG_ENABLED
    if(iterator.overflow)
        nwbGiReportGeometryFailure(NWB_CSG_RAY_FAILURE_CAPACITY);
#endif
    return iterator.overflow;
}

bool nwbGiTraceOccluded(float3 origin, float3 direction, float tMin, float tMax){
    NwbBvhRayIterator<NWB_GI_SW_SCENE_STACK_SIZE> iterator = nwbBvhRayBeginWalk<NWB_GI_SW_SCENE_STACK_SIZE>(
        g_NwbGiSwMaterialContextSlots.sceneSlots.x, origin, direction, tMin, tMax
    );
    uint instanceIndex;
    while(nwbBvhRayNextLeaf(iterator, instanceIndex)){
        if(nwbGiSwInstanceOccluded(instanceIndex, origin, direction, tMin, tMax))
            return true;
    }
#if NWB_GI_CSG_ENABLED
    if(iterator.overflow)
        nwbGiReportGeometryFailure(NWB_CSG_RAY_FAILURE_CAPACITY);
#endif
    return iterator.overflow;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

