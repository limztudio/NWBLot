////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_TESTS_HARDWARE_TRANSMISSION_TEST_RAY_SLANGI
#define NWB_TESTS_HARDWARE_TRANSMISSION_TEST_RAY_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct NwbHardwareTransmissionTestRay{
    float4 originTMin;
    float4 directionTMax;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#pragma warning(push)
#pragma warning(disable: 39001)
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_UNIFORM_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
ConstantBuffer<NwbHardwareTransmissionTestRay, Std140DataLayout> g_NwbHardwareTransmissionTestRays[];
#pragma warning(pop)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


RayDesc nwbHardwareTransmissionTestRay(){
    ConstantBuffer<NwbHardwareTransmissionTestRay, Std140DataLayout> input =
        g_NwbHardwareTransmissionTestRays[g_NwbHardwareTransparentPush.deferredResourcesHeapSlot]
    ;
    RayDesc ray;
    ray.Origin = input.originTMin.xyz;
    ray.TMin = input.originTMin.w;
    ray.Direction = input.directionTMax.xyz;
    ray.TMax = input.directionTMax.w;
    return ray;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

