const StringView s_ScopeDiagnosticCategory = "scope_diagnostic";
const StringView s_TelemetryGuardCategory = "telemetry_guard";
const StringView s_ErrorEvent = "error";
const usize s_EncodedPhysicalQueueMutationCount = 22u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


OwnerThreadTimingSink MakeOwnerThreadTimingSink(mut CpuTaskScheduler scheduler, mut TimingRecorder recorder, in b8 injectTasks){
    return OwnerThreadTimingSink(scheduler, recorder, injectTasks);
}

OwnerThreadTimingSink MakeOwnerThreadTimingSink(mut CpuTaskScheduler scheduler, mut TimingRecorder recorder){
    return OwnerThreadTimingSink(scheduler, recorder, false);
}

void CollectTestCpuTaskProfile(mut CpuTaskScheduler scheduler, mut TimingSink sink){
    CollectCpuTaskProfile(scheduler, sink);
}

void ApplyEncodedPhysicalQueueMutation(in usize mutationIndex, mut EncodedFrameGraphPhysicalQueueRuntimeStatistics statistics){
    switch(mutationIndex){
    case 0u:
        statistics.reserved[6u] = 1u;
        break;
    case 1u:
        statistics.ownerNodeIndex = 1u;
        break;
    case 2u:
        statistics.queue.deviceGeneration = 18u;
        break;
    case 3u:
        statistics.queueClass = FrameGraphQueueClass::Unknown;
        break;
    case 4u:
        statistics.recording.recordingSeconds = -1.0;
        break;
    case 5u:
        statistics.submission.submissionSeconds = bit_cast<f64>(0x7FF8000000000000uLL);
        break;
    case 6u:
        statistics.submission.inheritedTimelineWaitElisionCount = u64.max;
        break;
    case 7u:
        --statistics.submission.timelineWaitCount;
        ++statistics.submission.inheritedTimelineWaitElisionCount;
        break;
    case 8u:
        statistics.submission = EncodedFrameGraphPhysicalQueueSubmissionRuntimeStatistics();
        statistics.submission.plannedWaitTokenCount = 1u;
        statistics.submission.inheritedTimelineWaitElisionCount = 1u;
        break;
    case 9u:
        statistics.submission.recoverySubmissionCount = statistics.submission.acceptedFrontierSubmissionCount + 1u;
        break;
    case 10u:
        statistics.compile.taskCount = 79u;
        statistics.compile.packetCount = 78u;
        statistics.compile.mergedTaskCount = 1u;
        break;
    case 11u:
        statistics.compile.taskCount = 51u;
        statistics.compile.packetCount = 50u;
        statistics.compile.mergedTaskCount = 1u;
        break;
    case 12u:
        statistics.compile.prologueBarrierCount = 0u;
        break;
    case 13u:
        statistics.recording.barrierCount = 24u;
        break;
    case 14u:
        statistics.recording.taskCount = 22u;
        break;
    case 15u:
        statistics.submission.rejectedPacketCount = 23u;
        statistics.submission.rejectedTaskCount = 24u;
        statistics.submission.rejectedSubmissionCount = 23u;
        break;
    case 16u:
        statistics.compile.incomingLogicalOwnershipTransferSignatureCount = 0u;
        statistics.compile.outgoingLogicalOwnershipTransferSignatureCount = 0u;
        statistics.compile.incomingRepeatedOwnershipTransferSignatureCount = 0u;
        statistics.compile.outgoingRepeatedOwnershipTransferSignatureCount = 0u;
        break;
    case 17u:
        statistics.recording = EncodedFrameGraphPhysicalQueueRecordingRuntimeStatistics();
        statistics.recording.commandListCount = 1u;
        statistics.submission = EncodedFrameGraphPhysicalQueueSubmissionRuntimeStatistics();
        break;
    case 18u:
        statistics.submission.nativeSubmissionCount = 0u;
        statistics.submission.nativeCommandListCount = 0u;
        statistics.submission.plannedWaitTokenCount = 1u;
        statistics.submission.sameQueueWaitElisionCount = 0u;
        statistics.submission.timelineWaitCount = 1u;
        statistics.submission.mergedTimelineWaitCount = 0u;
        statistics.submission.acceptedFrontierSubmissionCount = 0u;
        statistics.submission.recoverySubmissionCount = 0u;
        statistics.submission.submissionSeconds = 0.0;
        break;
    case 19u:
        statistics.submission.acceptedPacketCount = 0u;
        statistics.submission.acceptedTaskCount = 1u;
        statistics.submission.nativeSubmissionCount = 0u;
        statistics.submission.nativeCommandListCount = 0u;
        statistics.submission.plannedWaitTokenCount = 0u;
        statistics.submission.sameQueueWaitElisionCount = 0u;
        statistics.submission.timelineWaitCount = 0u;
        statistics.submission.mergedTimelineWaitCount = 0u;
        statistics.submission.acceptedFrontierSubmissionCount = 0u;
        statistics.submission.recoverySubmissionCount = 0u;
        statistics.submission.submissionSeconds = 0.0;
        break;
    case 20u:
        statistics.submission.rejectedPacketCount = 0u;
        statistics.submission.rejectedTaskCount = 1u;
        statistics.submission.rejectedSubmissionCount = 0u;
        break;
    case 21u:
        statistics.compile.taskCount = 0u;
        statistics.compile.packetCount = 0u;
        statistics.compile.mergedTaskCount = 0u;
        statistics.compile.prologueBarrierCount = 1u;
        statistics.compile.epilogueBarrierCount = 0u;
        statistics.compile.ownershipReleaseBarrierCount = 0u;
        statistics.compile.ownershipAcquireBarrierCount = 0u;
        statistics.recording = EncodedFrameGraphPhysicalQueueRecordingRuntimeStatistics();
        statistics.submission = EncodedFrameGraphPhysicalQueueSubmissionRuntimeStatistics();
        break;
    default:
        break;
    }
}

void VerifyTelemetry_CaptureScopeRestoresLoggerAndStopsDiagnosticsAfterDestruction(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryCaptureSession session = TelemetryCaptureSession(testArena.arena);
    session.setCaptureOptions(CaptureAll());

    CapturingLogger previousLogger = CapturingLogger();
    {
        LoggerRegistrationGuard previousRegistration = LoggerRegistrationGuard(previousLogger);
        {
            CaptureSessionCaptureScope captureScope = CaptureSessionCaptureScope(session);
            [essential] info("scope text");
            CaptureDiagnosticEvent(MakeDiagnosticEvent(
                DiagnosticEventName::s_Error,
                s_ScopeDiagnosticCategory,
                "scope diagnostic",
                "scope.cpp",
                67u
            ));
        }
        [essential] info("after scope");
    }
    CaptureDiagnosticEvent(MakeDiagnosticEvent(
        DiagnosticEventName::s_Error,
        s_ScopeDiagnosticCategory,
        "ignored after scope",
        "",
        0u
    ));

    EXPECT_EQ(previousLogger.messageCount(), 2u);
    EXPECT_TRUE(SawCapturedMessage(previousLogger, "scope text"));
    EXPECT_TRUE(SawCapturedMessage(previousLogger, "after scope"));
    EXPECT_EQ(session.eventCount(), 2u);
}

void VerifyTelemetry_TextCaptureCountsRejectedPayloadsWithoutCountingFilteredEventsAndStillForwards(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    CapturingLogger forwardLogger = CapturingLogger();
    const LogTypeEnum invalidType = cast<LogTypeEnum>(0xffu);
    native(mut testArena, mut recorder, mut forwardLogger, in invalidType){
        TextLogCaptureLogger capture(recorder, &forwardLogger);
        Core::Common::LogString message(FOUNDATION_TEXT("capture admission"), testArena.arena);
        capture.enqueue(message, invalidType);
        EXPECT_EQ(capture.droppedTextLogCount(), 0u);
        EXPECT_EQ(recorder.eventCount(), 0u);

        recorder.setCaptureOptions(CaptureAll());
        capture.enqueue(message, invalidType);
        EXPECT_EQ(capture.droppedTextLogCount(), 1u);
        EXPECT_EQ(recorder.eventCount(), 0u);
        capture.enqueue(message, LogType::Info);
        EXPECT_EQ(capture.droppedTextLogCount(), 1u);
        EXPECT_EQ(recorder.eventCount(), 1u);

        recorder.setCaptureOptions(CaptureDisabled());
        capture.enqueue(message, invalidType);
        EXPECT_EQ(capture.droppedTextLogCount(), 1u);
        EXPECT_EQ(recorder.eventCount(), 0u);
    }
    EXPECT_EQ(forwardLogger.messageCount(), 4u);
    EXPECT_TRUE(SawCapturedMessage(forwardLogger, "capture admission"));
}

void VerifyTelemetry_DiagnosticPayloadPreservesBoundedTextAndRejectsCorruptedHeader(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    String embeddedMessage = String("d");
    embeddedMessage.resize(2u);
    embeddedMessage.append("m");
    DiagnosticEventRecord source = DiagnosticEventRecord();
    source.event = StringView("error.trailing").substr(0u, 5u);
    source.category = "unit_category";
    source.expression = "value != nullptr";
    source.file = "diagnostic_test.cpp";
    source.instructionPointer = 0x1234u;
    source.line = 77u;
    source.terminatesProcess = true;
    source.message = StringView(embeddedMessage);
    ASSERT_TRUE(BuildTestDiagnosticPayload(source, testArena.arena, payload));
    const Expected<DiagnosticPayload> parsed = ParseDiagnosticBytes(payload);
    ASSERT_TRUE(parsed.has_value());
    EXPECT_EQ(parsed.value().event, source.event);
    EXPECT_EQ(parsed.value().message, source.message);

    payload[0u] = 0u;
    EXPECT_FALSE(ParseDiagnosticBytes(payload).has_value());
}

void VerifyTelemetry_DiagnosticPayloadPreservesAliasedTextFields(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    DiagnosticEventRecord record = DiagnosticEventRecord();
    native(mut payload, mut record){
        constexpr AStringView s_Text = "event category expression message file";
        payload.reserve(512u);
        payload.resize(s_Text.size());
        FOUNDATION_MEMCPY(payload.data(), payload.size(), s_Text.data(), s_Text.size());
        const AStringView text(reinterpret_cast<const char*>(payload.data()), payload.size());
        record.event = text.substr(0u, 5u);
        record.category = text.substr(6u, 8u);
        record.expression = text.substr(15u, 10u);
        record.message = text.substr(26u, 7u);
        record.file = text.substr(34u, 4u);
    }
    ASSERT_TRUE(BuildTestDiagnosticPayload(record, testArena.arena, payload));
    const Expected<DiagnosticPayload> parsed = ParseDiagnosticBytes(payload);
    ASSERT_TRUE(parsed.has_value());
    EXPECT_EQ(parsed.value().event, "event");
    EXPECT_EQ(parsed.value().category, "category");
    EXPECT_EQ(parsed.value().expression, "expression");
    EXPECT_EQ(parsed.value().message, "message");
    EXPECT_EQ(parsed.value().file, "file");
    DiagnosticEventRecord roundtrip = DiagnosticEventRecord();
    roundtrip.event = parsed.value().event;
    roundtrip.category = parsed.value().category;
    roundtrip.expression = parsed.value().expression;
    roundtrip.message = parsed.value().message;
    roundtrip.file = parsed.value().file;
    ASSERT_TRUE(BuildTestDiagnosticPayload(roundtrip, testArena.arena, payload));
    const Expected<DiagnosticPayload> rebuilt = ParseDiagnosticBytes(payload);
    ASSERT_TRUE(rebuilt.has_value());
    EXPECT_EQ(rebuilt.value().message, "message");
    EXPECT_EQ(rebuilt.value().file, "file");
}

void VerifyTelemetry_DiagnosticCaptureGuardDoesNotReplaceExistingCallback(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureAll());
    u32 callbackCount = 0u;
    native(mut recorder, mut callbackCount){
        g_ExistingDiagnosticCallbackCount = 0u;
        SetDiagnosticEventCallback(ExistingDiagnosticCallback);
        {
            DiagnosticCaptureGuard guard(recorder);
            EXPECT_FALSE(guard.installed());
            CaptureDiagnosticEvent(DiagnosticEventRecord{
                .event = DiagnosticEventName::s_Error,
                .message = "existing callback should keep ownership",
            });
        }
        ClearDiagnosticEventCallback(ExistingDiagnosticCallback);
        callbackCount = g_ExistingDiagnosticCallbackCount;
    }
    EXPECT_EQ(callbackCount, 1u);
    EXPECT_EQ(recorder.eventCount(), 0u);
}

void VerifyTelemetry_DiagnosticObserverReusesPreparedStorageAndCountsPoolOverflow(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureAll());
    const ArenaMemoryStats prepared = testArena.arena.memoryStats();
    DiagnosticEventRecord source = DiagnosticEventRecord();
    source.event = s_ErrorEvent;
    source.message = "bounded observer";
    for(u32 iteration = 0u; iteration < 3u; ++iteration){
        recorder.setCaptureOptions(CaptureAll());
        DiagnosticCaptureGuard guard = DiagnosticCaptureGuard(recorder);
        ASSERT_TRUE(guard.installed());
        guard.setFrameIndex(iteration);
        guard.setStreamId(9u);
        for(usize eventIndex = 0u; eventIndex < s_DiagnosticCaptureEventCapacity; ++eventIndex)
            guard.capture(source);
        guard.capture(source);
        EXPECT_EQ(recorder.eventCount(), s_DiagnosticCaptureEventCapacity);
        EXPECT_EQ(recorder.droppedDiagnosticCount(), iteration + 1u);
        const Expected<EventHeader> firstHeader = ReadEventHeaderAt(recorder.view(), 0u);
        ASSERT_TRUE(firstHeader.has_value());
        EXPECT_EQ(firstHeader.value().frameIndex, iteration);
        EXPECT_EQ(firstHeader.value().streamId, 9u);
        recorder.clear();
    }
    const ArenaMemoryStats reused = testArena.arena.memoryStats();
    EXPECT_EQ(reused.allocationCount, prepared.allocationCount);
    EXPECT_EQ(reused.reallocationCount, prepared.reallocationCount);
    EXPECT_EQ(reused.deallocationCount, prepared.deallocationCount);
}

void VerifyTelemetry_DiagnosticObserverRejectsOversizeWithoutTruncatingDirectDiagnostics(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureAll());
    DiagnosticCaptureGuard guard = DiagnosticCaptureGuard(recorder);
    ASSERT_TRUE(guard.installed());
    const usize s_MessageCapacity = s_DiagnosticCapturePayloadCapacity - s_EncodedDiagnosticPayloadHeaderByteSize - 5u;
    String message = String();
    message.reserve(s_MessageCapacity + 1u);
    for(usize index = 0u; index <= s_MessageCapacity; ++index)
        message.append("x");
    DiagnosticEventRecord source = DiagnosticEventRecord();
    source.event = s_ErrorEvent;
    source.message = StringView(message).substr(0u, s_MessageCapacity);
    const ArenaMemoryStats prepared = testArena.arena.memoryStats();
    guard.capture(source);
    ASSERT_EQ(recorder.eventCount(), 1u);
    const Expected<usize> boundedPayloadSize = EventPayloadSizeAt(recorder.view(), 0u);
    ASSERT_TRUE(boundedPayloadSize.has_value());
    EXPECT_EQ(boundedPayloadSize.value(), s_DiagnosticCapturePayloadCapacity);
    source.message = StringView(message);
    guard.capture(source);
    EXPECT_EQ(recorder.droppedDiagnosticCount(), 1u);
    EXPECT_EQ(recorder.eventCount(), 1u);
    const ArenaMemoryStats captured = testArena.arena.memoryStats();
    EXPECT_EQ(captured.allocationCount, prepared.allocationCount);
    EXPECT_EQ(captured.reallocationCount, prepared.reallocationCount);

    ASSERT_TRUE(RecordTestDiagnostic(recorder, source));
    const Expected<DiagnosticPayload> parsed = ParseDiagnosticEventAt(recorder.view(), 1u);
    ASSERT_TRUE(parsed.has_value());
    EXPECT_EQ(parsed.value().message, StringView(message));
    const Expected<usize> retainedBoundedSize = EventPayloadSizeAt(recorder.view(), 0u);
    ASSERT_TRUE(retainedBoundedSize.has_value());
    EXPECT_EQ(retainedBoundedSize.value(), s_DiagnosticCapturePayloadCapacity);
    EXPECT_EQ(recorder.droppedDiagnosticCount(), 1u);
}

void VerifyTelemetry_DiagnosticObserverCapturesDuringUnwindWithoutAllocating(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureAll());
    DiagnosticCaptureGuard guard = DiagnosticCaptureGuard(recorder);
    ASSERT_TRUE(guard.installed());
    const ArenaMemoryStats prepared = testArena.arena.memoryStats();
    b8 caught = false;
    native(mut caught){
        struct UnwindMarker{};
        try{
            ScopeExit capture([]()noexcept{
                CaptureDiagnosticEvent(DiagnosticEventRecord{ .event = "warning", .category = "unwind", .message = "cleanup failed", });
            });
            throw UnwindMarker{};
        }
        catch(const UnwindMarker&){
            caught = true;
        }
    }
    const ArenaMemoryStats captured = testArena.arena.memoryStats();
    EXPECT_TRUE(caught);
    EXPECT_EQ(recorder.eventCount(), 1u);
    EXPECT_EQ(recorder.droppedDiagnosticCount(), 0u);
    EXPECT_EQ(captured.allocationCount, prepared.allocationCount);
    EXPECT_EQ(captured.reallocationCount, prepared.reallocationCount);
    const Expected<DiagnosticPayload> parsed = ParseDiagnosticEventAt(recorder.view(), 0u);
    ASSERT_TRUE(parsed.has_value());
    EXPECT_EQ(parsed.value().category, "unwind");
}

void VerifyTelemetry_DiagnosticObserverPreservesPublishedRecordsAcrossFlagTogglesAndFiltersDisabledCapture(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureAll());
    DiagnosticCaptureGuard guard = DiagnosticCaptureGuard(recorder);
    ASSERT_TRUE(guard.installed());
    DiagnosticEventRecord source = DiagnosticEventRecord();
    source.event = s_ErrorEvent;
    source.message = "retained";
    guard.capture(source);
    ASSERT_EQ(recorder.eventCount(), 1u);
    const usize retainedAddress = EventRecordAddressAt(recorder.view(), 0u);
    ASSERT_NE(retainedAddress, 0u);
    const ArenaMemoryStats prepared = testArena.arena.memoryStats();
    for(u32 iteration = 0u; iteration < 3u; ++iteration){
        recorder.setCaptureOptions(CapturePerfOnly());
        guard.capture(source);
        EXPECT_EQ(recorder.droppedDiagnosticCount(), 0u);
        EXPECT_EQ(EventRecordAddressAt(recorder.view(), 0u), retainedAddress);
        recorder.setCaptureOptions(CaptureAll());
        guard.capture(source);
        EXPECT_EQ(recorder.eventCount(), iteration + 2u);
    }
    const ArenaMemoryStats toggled = testArena.arena.memoryStats();
    EXPECT_EQ(toggled.allocationCount, prepared.allocationCount);
    EXPECT_EQ(toggled.reallocationCount, prepared.reallocationCount);
    EXPECT_EQ(toggled.deallocationCount, prepared.deallocationCount);
    recorder.setCaptureOptions(CaptureDisabled());
    guard.capture(source);
    EXPECT_EQ(recorder.eventCount(), 0u);
    EXPECT_EQ(recorder.droppedDiagnosticCount(), 0u);
    EXPECT_LT(testArena.arena.memoryStats().usedBytes, prepared.usedBytes);
    recorder.setCaptureOptions(CaptureAll());
    guard.capture(source);
    EXPECT_EQ(recorder.eventCount(), 1u);
}

void VerifyTelemetry_DiagnosticObserverDoesNotGrowPublicationStorageWhenOrdinaryEventsFillIt(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureAll());
    DiagnosticCaptureGuard guard = DiagnosticCaptureGuard(recorder);
    ASSERT_TRUE(guard.installed());
    for(usize eventIndex = 0u; eventIndex < s_DiagnosticCaptureEventCapacity; ++eventIndex)
        ASSERT_TRUE(RecordFilledPayload(recorder, EventKind::PerfFrame, 0u, 0u, 0u, 0u));
    const ArenaMemoryStats filled = testArena.arena.memoryStats();
    DiagnosticEventRecord source = DiagnosticEventRecord();
    source.event = s_ErrorEvent;
    source.message = "publication full";
    guard.capture(source);
    EXPECT_EQ(recorder.droppedDiagnosticCount(), 1u);
    EXPECT_EQ(testArena.arena.memoryStats().allocationCount, filled.allocationCount);
    EXPECT_EQ(testArena.arena.memoryStats().reallocationCount, filled.reallocationCount);
    recorder.clear();
    guard.capture(source);
    EXPECT_EQ(recorder.eventCount(), 1u);
}

void VerifyTelemetry_DiagnosticObserverPreservesOrderingAndPayloadLifetimeDuringBuilderReentry(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureAll());
    DiagnosticCaptureGuard guard = DiagnosticCaptureGuard(recorder);
    ASSERT_TRUE(guard.installed());
    b8 captureDidNotAllocate = false;
    b8 builtRecorded = false;
    native(mut testArena, mut recorder, mut captureDidNotAllocate, mut builtRecorded){
        builtRecorded = recorder.recordBuiltPayload(EventKind::PerfFrame, 7u, 3u, [&](TelemetryArena&, TelemetryBytes& payload){
            const auto before = testArena.arena.memoryStats();
            CaptureDiagnosticEvent(DiagnosticEventRecord{ .event = s_ErrorEvent, .message = "builder callback", });
            const auto after = testArena.arena.memoryStats();
            captureDidNotAllocate = before.allocationCount == after.allocationCount && before.reallocationCount == after.reallocationCount;
            payload.push_back(17u);
            return recorder.recordBinary(EventKind::MemoryFrame, 8u, nullptr, 0u);
        });
    }
    ASSERT_TRUE(builtRecorded);
    ASSERT_TRUE(captureDidNotAllocate);
    ASSERT_EQ(recorder.eventCount(), 3u);
    const EventView events = recorder.view();
    const Expected<EventHeader> headerZero = ReadEventHeaderAt(events, 0u);
    const Expected<EventHeader> headerOne = ReadEventHeaderAt(events, 1u);
    const Expected<EventHeader> headerTwo = ReadEventHeaderAt(events, 2u);
    ASSERT_TRUE(headerZero.has_value());
    ASSERT_TRUE(headerOne.has_value());
    ASSERT_TRUE(headerTwo.has_value());
    EXPECT_EQ(headerZero.value().kind, EventKind::Diagnostic);
    EXPECT_EQ(headerOne.value().kind, EventKind::MemoryFrame);
    EXPECT_EQ(headerTwo.value().kind, EventKind::PerfFrame);
    const usize diagnosticAddress = EventRecordAddressAt(events, 0u);
    ASSERT_NE(diagnosticAddress, 0u);
    ASSERT_TRUE(RecordFilledPayload(recorder, EventKind::PerfFrame, 9u, 0u, 0u, 0u));
    EXPECT_EQ(EventRecordAddressAt(events, 0u), diagnosticAddress);
    const Expected<DiagnosticPayload> parsed = ParseDiagnosticEventAt(events, 0u);
    ASSERT_TRUE(parsed.has_value());
    EXPECT_EQ(parsed.value().message, "builder callback");
}

void VerifyTelemetry_ConcurrentDiagnosticObserversAccountForEveryAdmittedAttempt(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureAll());
    DiagnosticCaptureGuard guard = DiagnosticCaptureGuard(recorder);
    ASSERT_TRUE(guard.installed());
    const usize s_AttemptsPerThread = 256u;
    const ArenaMemoryStats prepared = testArena.arena.memoryStats();
    DiagnosticEventRecord source = DiagnosticEventRecord();
    source.event = s_ErrorEvent;
    source.message = "concurrent bounded observer";
    native(in s_AttemptsPerThread, in source, mut guard){
        AtomicFlag start;
        const auto capture = [&]()noexcept{
            while(!start.test(MemoryOrder::acquire))
                start.wait(false, MemoryOrder::acquire);
            for(usize attempt = 0u; attempt < s_AttemptsPerThread; ++attempt)
                guard.capture(source);
        };
        Thread first(capture);
        Thread second(capture);
        start.testAndSet(MemoryOrder::release);
        start.notifyAll();
        first.join();
        second.join();
    }
    const ArenaMemoryStats captured = testArena.arena.memoryStats();
    EXPECT_GT(recorder.eventCount(), 0u);
    EXPECT_LE(recorder.eventCount(), s_DiagnosticCaptureEventCapacity);
    EXPECT_EQ(recorder.eventCount() + recorder.droppedDiagnosticCount(), s_AttemptsPerThread * 2u);
    EXPECT_EQ(captured.allocationCount, prepared.allocationCount);
    EXPECT_EQ(captured.reallocationCount, prepared.reallocationCount);
    const u64 dropped = recorder.droppedDiagnosticCount();
    recorder.setCaptureOptions(CaptureDisabled());
    guard.capture(source);
    EXPECT_EQ(recorder.droppedDiagnosticCount(), dropped);
    EXPECT_EQ(recorder.eventCount(), 0u);
}

void VerifyTelemetry_DiagnosticCaptureGuardConcurrentLifetimeStress(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureAll());
    const u32 s_IterationCount = 64u;
    b8 allGuardsInstalled = true;
    b8 allIterationsCaptured = true;
    b8 dropsMonotonic = true;
    usize observedEventCount = 0u;
    native(in s_IterationCount, mut recorder, mut allGuardsInstalled, mut allIterationsCaptured, mut dropsMonotonic, mut observedEventCount){
        AtomicFlag captureThreadStarted;
        AtomicFlag stopCaptureThread;
        Thread captureThread([&captureThreadStarted, &stopCaptureThread]()noexcept{
            captureThreadStarted.testAndSet(MemoryOrder::release);
            captureThreadStarted.notifyAll();
            while(!stopCaptureThread.test(MemoryOrder::acquire)){
                CaptureDiagnosticEvent(DiagnosticEventRecord{
                    .event = DiagnosticEventName::s_Error,
                    .category = s_TelemetryGuardCategory,
                    .message = "capture during destruction",
                });
                YieldThread();
            }
        });

        while(!captureThreadStarted.test(MemoryOrder::acquire))
            captureThreadStarted.wait(false, MemoryOrder::acquire);

        u64 previousDroppedCount = 0u;
        for(u32 iteration = 0u; iteration < s_IterationCount; ++iteration){
            recorder.clear();
            {
                DiagnosticCaptureGuard guard(recorder);
                if(!guard.installed()){
                    allGuardsInstalled = false;
                    break;
                }
                constexpr i32 s_CaptureDeadlineMS = 5000;
                const auto deadline = TimerAddMS(TimerNow(), s_CaptureDeadlineMS);
                while(recorder.eventCount() == 0u && TimerNow() < deadline)
                    YieldThread();
            }
            const usize captured = recorder.eventCount();
            if(captured == 0u){
                allIterationsCaptured = false;
                break;
            }
            observedEventCount += captured;
            const u64 dropped = recorder.droppedDiagnosticCount();
            dropsMonotonic = dropsMonotonic && dropped >= previousDroppedCount;
            previousDroppedCount = dropped;
        }

        stopCaptureThread.testAndSet(MemoryOrder::release);
        captureThread.join();
    }
    EXPECT_TRUE(allGuardsInstalled);
    EXPECT_TRUE(allIterationsCaptured);
    EXPECT_TRUE(dropsMonotonic);
    EXPECT_GE(observedEventCount, s_IterationCount);

    {
        DiagnosticCaptureGuard finalGuard = DiagnosticCaptureGuard(recorder);
        EXPECT_TRUE(finalGuard.installed());
    }

    const usize eventCountAfterFinalDestruction = recorder.eventCount();
    CaptureDiagnosticEvent(MakeDiagnosticEvent(
        DiagnosticEventName::s_Error,
        s_TelemetryGuardCategory,
        "ignored after destruction",
        "",
        0u
    ));
    EXPECT_EQ(recorder.eventCount(), eventCountAfterFinalDestruction);

    const EventView events = recorder.view();
    for(usize eventIndex = 0u; eventIndex < events.eventCount(); ++eventIndex){
        const Expected<DiagnosticPayload> parsed = ParseDiagnosticEventAt(events, eventIndex);
        ASSERT_TRUE(parsed.has_value());
        EXPECT_EQ(parsed.value().event, DiagnosticEventName::s_Error);
        EXPECT_EQ(parsed.value().category, "telemetry_guard");
        EXPECT_EQ(parsed.value().message, "capture during destruction");
    }
}

void VerifyTelemetry_CaptureScopePreservesForwardedLogsAndMetadataUnderConcurrentChurn(){
    const u32 s_WriterCount = 4u;
    const u32 s_MessagesPerWriter = 384u;
    const u32 s_ExpectedForwardCount = s_WriterCount * s_MessagesPerWriter;
    const u32 s_BaseStreamId = 70u;

    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryCaptureSession session = TelemetryCaptureSession(testArena.arena);
    session.setCaptureOptions(CaptureAll());
    session.setFrameIndex(1u);
    session.setStreamId(s_BaseStreamId + 1u);

    CapturingLogger forwardLogger = CapturingLogger();
    LoggerRegistrationGuard baseRegistration = LoggerRegistrationGuard(forwardLogger, LoggerBreakPolicy::ReportOnly);

    u64 nextFrameIndex = 1u;
    native(in s_BaseStreamId, in s_MessagesPerWriter, mut session, mut nextFrameIndex){
        constexpr u32 kWriters = 4u;
        Latch startGate(kWriters + 1u);
        Atomic<u32> activeWriters{ kWriters };
        Array<Thread, kWriters> writers;
        for(u32 writerIndex = 0u; writerIndex < kWriters; ++writerIndex){
            writers[writerIndex] = Thread([&](){
                startGate.arrive_and_wait();
                for(u32 messageIndex = 0u; messageIndex < s_MessagesPerWriter; ++messageIndex){
                    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("concurrent capture scope text {}"), messageIndex);
                    if((messageIndex & 7u) == 0u)
                        YieldThread();
                }
                activeWriters.fetch_sub(1u, MemoryOrder::release);
            });
        }

        startGate.arrive_and_wait();
        while(activeWriters.load(MemoryOrder::acquire) != 0u){
            session.setFrameIndex(nextFrameIndex);
            session.setStreamId(s_BaseStreamId + static_cast<u32>(nextFrameIndex & 7u));
            {
                CaptureSessionCaptureScope scope(session);
                ++nextFrameIndex;
                session.setFrameIndex(nextFrameIndex);
                session.setStreamId(s_BaseStreamId + static_cast<u32>(nextFrameIndex & 7u));
                YieldThread();
            }
            ++nextFrameIndex;
        }

        for(Thread& writer : writers)
            writer.join();
    }

    EXPECT_EQ(forwardLogger.messageCount(), s_ExpectedForwardCount);
    EXPECT_GT(session.eventCount(), 0u);

    const EventView events = session.view();
    for(usize eventIndex = 0u; eventIndex < events.eventCount(); ++eventIndex){
        const Expected<EventHeader> header = ReadEventHeaderAt(events, eventIndex);
        ASSERT_TRUE(header.has_value());
        EXPECT_EQ(header.value().kind, EventKind::TextLog);
        EXPECT_GE(header.value().frameIndex, 1u);
        EXPECT_LE(header.value().frameIndex, nextFrameIndex);
        EXPECT_GE(header.value().streamId, s_BaseStreamId);
        EXPECT_LE(header.value().streamId, s_BaseStreamId + 7u);

        const Expected<TextLogPayload> parsed = ParseTextLogEventAt(events, eventIndex);
        ASSERT_TRUE(parsed.has_value());
        EXPECT_EQ(parsed.value().type, LogType::EssentialInfo);
        EXPECT_NE(parsed.value().messageUtf8.find("concurrent capture scope text"), usize.max);
    }
}

void VerifyCpuTaskProfileIntegration_DelayedTaskTimingPreservesExecutionFrameAtLaterPublication(){
    CpuTaskProfileTestArena arena = CpuTaskProfileTestArena();
    PerfSession perf = PerfSession(arena.arena);
    PerfCaptureOptions perfOptions = PerfCaptureOptions();
    perfOptions.enabled = true;
    perfOptions.cpuTiming = true;
    perf.setCaptureOptions(perfOptions);
    perf.beginFrame(42u);
    CpuTaskScheduler scheduler = CpuTaskScheduler(0u);
    const Name taskName = s_CpuTaskTestsExplicit;
    const Name scopeName = s_CpuTaskTestsScope;
    const CpuTaskProfileLabel taskLabel = scheduler.registerProfileLabel(taskName);
    const CpuTaskProfileLabel scopeLabel = scheduler.registerProfileLabel(scopeName);
    ASSERT_TRUE(taskLabel.valid());
    ASSERT_TRUE(scopeLabel.valid());
    CpuTaskScope scope = CpuTaskScope(scheduler, scopeLabel);
    scheduler.setProfiling(true, 41u);

    native(in taskLabel, mut scope, mut scheduler){
        const auto taskAdmission = scope.submit([]()noexcept{}, { .profileLabel = taskLabel });
        ASSERT_TRUE(taskAdmission.has_value());
        const CpuTaskHandle task = taskAdmission.value();
        ASSERT_TRUE(task.valid());
        scheduler.wait(task);
    }
    scope.wait();
    ASSERT_GT(scheduler.statistics().profilePendingEvents, 0u);
    CollectTestCpuTaskProfile(scheduler, perf.cpuTimingSink());
    EXPECT_EQ(scheduler.statistics().profilePendingEvents, 0u);
    perf.publishFrame();

    const TimingView timing = perf.cpuTimingView();
    EXPECT_EQ(timing.stats(taskName).firstSampleFrameIndex, 41u);
    EXPECT_EQ(timing.stats(taskName).lastSampleFrameIndex, 41u);
    EXPECT_EQ(timing.stats(taskName).publishFrameIndex, 42u);

    TelemetryCaptureSession telemetry = TelemetryCaptureSession(arena.arena);
    telemetry.setCaptureOptions(CaptureAll());
    const PerfSessionRecordResult result = telemetry.recordPerfReport(perf.report());
    ASSERT_TRUE(result.ok());
    b8 foundNamedTask = false;
    const EventView events = telemetry.view();
    for(usize index = 0u; index < events.eventCount(); ++index){
        const Expected<PerfTimingPayload> payload = ParsePerfTimingEventAt(events, index);
        ASSERT_TRUE(payload.has_value());
        if(payload.value().scopeName == taskName){
            foundNamedTask = true;
            EXPECT_EQ(payload.value().stats.firstSampleFrameIndex, 41u);
            EXPECT_EQ(payload.value().stats.publishFrameIndex, 42u);
        }
    }
    EXPECT_TRUE(foundNamedTask);
}

