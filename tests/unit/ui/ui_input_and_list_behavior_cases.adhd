void VerifyUiListBehaviorTests_MissingDisabledOrMalformedActivationDoesNotModifyStateOrResult(){
    UiListBehaviorRangeSource source = UiListBehaviorRangeSource();
    source.disabledBegin = 3u;
    source.disabledEnd = 4u;
    ListState state = ListState();
    state.select(2u);
    ASSERT_TRUE(UiListBehaviorReconcile(state, source));
    const ListResult previous = MakeUiListBehaviorResult(true, true, false, true);
    ListResult result = previous;
    ControlAction action = MakeUiListBehaviorAction(state, source, ControlActionKind::Activate);
    action.value = 99u;
    EXPECT_FALSE(UiListBehaviorApply(source, ListOptions(), action, state, result));
    action.value = 4u;
    EXPECT_FALSE(UiListBehaviorApply(source, ListOptions(), action, state, result));
    action.value = 5u;
    source.badLookup = true;
    EXPECT_FALSE(UiListBehaviorApply(source, ListOptions(), action, state, result));
    EXPECT_EQ(state.selectedKey(), 2u);
    EXPECT_EQ(state.cursorKey(), 2u);
    ExpectUiListBehaviorResult(result, previous);
}

void VerifyUiListBehaviorTests_MalformedEnabledSearchFailsAtomically(){
    UiListBehaviorRangeSource source = UiListBehaviorRangeSource();
    ListState state = ListState();
    state.select(2u);
    ASSERT_TRUE(UiListBehaviorReconcile(state, source));
    source.badFind = true;
    ListResult result = ListResult();
    EXPECT_FALSE(UiListBehaviorApply(source, ListOptions(), MakeUiListBehaviorAction(state, source, ControlActionKind::Down), state, result));
    EXPECT_EQ(state.cursorKey(), 2u);
    EXPECT_EQ(state.selectedKey(), 2u);
    EXPECT_FALSE(result.valid);
}

void VerifyUiListBehaviorTests_HugeWheelDeltasClampWithoutMultiplicationOverflow(){
    UiListBehaviorRangeSource source = UiListBehaviorRangeSource();
    ListState state = ListState();
    ASSERT_TRUE(state.scrollTo(500.0));
    ASSERT_TRUE(UiListBehaviorReconcile(state, source));
    ControlAction action = MakeUiListBehaviorAction(state, source, ControlActionKind::Wheel);
    action.delta = f64.max;
    action.step = f64.max;
    action.maximum = 1000.0;
    ListResult result = ListResult();
    ASSERT_TRUE(UiListBehaviorApply(source, ListOptions(), action, state, result));
    EXPECT_DOUBLE_EQ(state.scrollOffset(), 0.0);
    action.delta = -f64.max;
    ASSERT_TRUE(UiListBehaviorApply(source, ListOptions(), action, state, result));
    EXPECT_DOUBLE_EQ(state.scrollOffset(), 1000.0);
    action.delta = 0.0;
    action.maximum = 20.0;
    ASSERT_TRUE(UiListBehaviorApply(source, ListOptions(), action, state, result));
    EXPECT_DOUBLE_EQ(state.scrollOffset(), 20.0);
}

void VerifyUiListBehaviorTests_InvalidWheelMetricsFailWithoutChangingOffsetOrResult(){
    UiListBehaviorRangeSource source = UiListBehaviorRangeSource();
    ListState state = ListState();
    ASSERT_TRUE(state.scrollTo(50.0));
    ASSERT_TRUE(UiListBehaviorReconcile(state, source));
    ControlAction valid = MakeUiListBehaviorAction(state, source, ControlActionKind::Wheel);
    valid.delta = -1.0;
    valid.step = 32.0;
    valid.maximum = 300.0;
    ListResult result = ListResult();
    ControlAction action = valid;
    action.delta = UiInputLayoutQuietNaNF64();
    EXPECT_FALSE(UiListBehaviorApply(source, ListOptions(), action, state, result));
    action = valid;
    action.step = 0.0;
    EXPECT_FALSE(UiListBehaviorApply(source, ListOptions(), action, state, result));
    action = valid;
    action.maximum = -1.0;
    EXPECT_FALSE(UiListBehaviorApply(source, ListOptions(), action, state, result));
    action = valid;
    action.maximum = UiInputLayoutInfinityF64();
    EXPECT_FALSE(UiListBehaviorApply(source, ListOptions(), action, state, result));
    EXPECT_DOUBLE_EQ(state.scrollOffset(), 50.0);
    EXPECT_FALSE(result.valid);
}

void VerifyUiListBehaviorTests_InvalidOptionsKindsAndZeroPageSizeRejectWithoutChangingCursor(){
    UiListBehaviorRangeSource source = UiListBehaviorRangeSource();
    ListState state = ListState();
    state.select(2u);
    ASSERT_TRUE(UiListBehaviorReconcile(state, source));
    const ControlAction valid = MakeUiListBehaviorAction(state, source, ControlActionKind::Down);
    ListOptions options = ListOptions();
    options.enabled = false;
    ListResult result = ListResult();
    EXPECT_FALSE(UiListBehaviorApply(source, options, valid, state, result));
    options = ListOptions();
    options.wheelRows = 0.0f;
    EXPECT_FALSE(UiListBehaviorApply(source, options, valid, state, result));
    options = ListOptions();
    options.wheelRows = UiInputLayoutQuietNaNF32();
    EXPECT_FALSE(UiListBehaviorApply(source, options, valid, state, result));
    ControlAction action = valid;
    action.kind = bit_cast<ControlActionKindEnum>(u8(255u));
    EXPECT_FALSE(UiListBehaviorApply(source, ListOptions(), action, state, result));
    action.kind = ControlActionKind::PageDown;
    action.pageRows = 0u;
    EXPECT_FALSE(UiListBehaviorApply(source, ListOptions(), action, state, result));
    EXPECT_EQ(state.cursorKey(), 2u);
    EXPECT_EQ(state.selectedKey(), 2u);
}

void VerifyUiListBehaviorTests_RepeatedHomeNoopPreservesEarlierSelectionChange(){
    UiListBehaviorRangeSource source = UiListBehaviorRangeSource();
    ListState state = ListState();
    ASSERT_TRUE(UiListBehaviorReconcile(state, source));
    ListResult result = ListResult();
    ASSERT_TRUE(UiListBehaviorApply(source, ListOptions(), MakeUiListBehaviorAction(state, source, ControlActionKind::Home), state, result));
    EXPECT_TRUE(result.selectionChanged);
    ASSERT_TRUE(UiListBehaviorApply(source, ListOptions(), MakeUiListBehaviorAction(state, source, ControlActionKind::Home), state, result));
    EXPECT_TRUE(result.selectionChanged);
    EXPECT_FALSE(result.activated);
}


