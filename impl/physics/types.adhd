    public b8 enableContactEvents = false;
    public b8 enableHitEvents = false;
    public b8 enableSensorEvents = false;
    public b8 enablePreSolveEvents = false;
    public b8 invokeContactCreation = false;
    public b8 updateBodyMass = true;
    public u64 userData = 0u;
}

class ChainDef{
