const StringView s_QualifyOption = "--qualify";
const StringView s_BenchCopyOption = "--bench-copy";
const StringView s_BenchEqualityOption = "--bench-equality";
const StringView s_BenchEqualityFirstWordOption = "--bench-equality-first-word";
const usize s_StreamingBytes = 67108864u;
const u8 s_PoisonByte = 0xA5u;
const usize s_QualifyLengthCount = 36u;
const usize s_BenchLengthCount = 15u;
const usize s_EqualityIterations = 4194304u;
const usize s_U64ByteSize = 8u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


usize QualifyLengthAt(in usize index){
    switch(index){
    case 0u: return 0u;
    case 1u: return 1u;
    case 2u: return 2u;
    case 3u: return 3u;
    case 4u: return 7u;
    case 5u: return 8u;
    case 6u: return 9u;
    case 7u: return 15u;
    case 8u: return 16u;
    case 9u: return 17u;
    case 10u: return 31u;
    case 11u: return 32u;
    case 12u: return 33u;
    case 13u: return 47u;
    case 14u: return 48u;
    case 15u: return 49u;
    case 16u: return 63u;
    case 17u: return 64u;
    case 18u: return 65u;
    case 19u: return 127u;
    case 20u: return 128u;
    case 21u: return 129u;
    case 22u: return 255u;
    case 23u: return 256u;
    case 24u: return 257u;
    case 25u: return 511u;
    case 26u: return 512u;
    case 27u: return 513u;
    case 28u: return 4095u;
    case 29u: return 4096u;
    case 30u: return 4097u;
    case 31u: return 5120u;
    case 32u: return 8191u;
    case 33u: return 8192u;
    case 34u: return 8193u;
    default: return 16384u;
    }
}

usize BenchLengthAt(in usize index){
    switch(index){
    case 0u: return 16u;
    case 1u: return 31u;
    case 2u: return 32u;
    case 3u: return 33u;
    case 4u: return 64u;
    case 5u: return 128u;
    case 6u: return 129u;
    case 7u: return 256u;
    case 8u: return 512u;
    case 9u: return 1024u;
    case 10u: return 2048u;
    case 11u: return 4096u;
    case 12u: return 5120u;
    case 13u: return 8191u;
    default: return 8192u;
    }
}

StringView ResolveEqualityCaseName(in b8 firstWord, in usize comparisonCase){
    if(firstWord){
        switch(comparisonCase){
        case 0u: return "equal";
        case 1u: return "word0_mismatch";
        case 2u: return "word1_mismatch";
        case 3u: return "word2_mismatch";
        default: return "word3_mismatch";
        }
    }
    if(comparisonCase == 0u)
        return "equal";
    if(comparisonCase == 1u)
        return "early_mismatch";
    return "late_mismatch";
}

u8 ComputeMemoryPatternByte(in usize index){
    return PatternByte(index);
}

b8 CheckCopiedRange(in Span<u8> bytes, in usize start, in usize count, in usize sourceStart){
    for(usize index = 0u; index < bytes.size(); ++index){
        u8 expected = s_PoisonByte;
        if(index >= start && index - start < count)
            expected = ComputeMemoryPatternByte(sourceStart + index - start);
        if(bytes[index] != expected)
            return false;
    }
    return true;
}

void FillQualifyLengths(mut Array<usize, s_QualifyLengthCount> lengths){
    for(usize index = 0u; index < s_QualifyLengthCount; ++index)
        lengths[index] = QualifyLengthAt(index);
}

b8 QualifyCopyBytes(){
    Array<usize, s_QualifyLengthCount> lengths;
    FillQualifyLengths(lengths);
    return QualifyCopyBytesKernel(lengths, s_PoisonByte);
}

b8 QualifyProtectedRanges(){
    Array<usize, s_QualifyLengthCount> lengths;
    FillQualifyLengths(lengths);
    return QualifyProtectedRangesKernel(lengths, s_PoisonByte);
}

b8 QualifyEquality(){
    return QualifyEqualityKernel();
}

void BenchMemoryCopy(in usize samples){
    WriteProbeStdout("kind,cache,bytes,source_offset,destination_offset,sample,baseline_ns,candidate_ns,candidate_over_baseline\n");
    Array<b8, 2> streamingModes;
    streamingModes[0] = false;
    streamingModes[1] = true;
    Array<usize, 2> offsets;
    offsets[0] = 16u;
    offsets[1] = 32u;
    for(usize modeIndex = 0u; modeIndex < streamingModes.size(); ++modeIndex){
        const b8 streaming = streamingModes[modeIndex];
        StringView cacheLabel = "warm";
        if(streaming)
            cacheLabel = "streaming";
        for(usize lenIndex = 0u; lenIndex < s_BenchLengthCount; ++lenIndex){
            const usize bytes = BenchLengthAt(lenIndex);
            const usize stride = (bytes + 127u) & ~cast<usize>(63u);
            usize slots = 1u;
            if(streaming)
                slots = s_StreamingBytes / stride;
            usize iterations = s_StreamingBytes / bytes;
            if(iterations < 65536u)
                iterations = 65536u;
            StringView kindLabel = "copy_dynamic";
            if(bytes == 5120u)
                kindLabel = "copy_fixed";
            MemoryCopyBenchmarkBuffers buffers = MemoryCopyBenchmarkBuffers(slots, stride, s_PoisonByte);
            for(usize srcIdx = 0u; srcIdx < offsets.size(); ++srcIdx){
                const usize sourceOffset = offsets[srcIdx];
                for(usize dstIdx = 0u; dstIdx < offsets.size(); ++dstIdx){
                    const usize destinationOffset = offsets[dstIdx];
                    buffers.warmup(bytes, sourceOffset, destinationOffset);
                    for(usize sample = 0u; sample < samples; ++sample){
                        f64 baselineNs = 0.0;
                        f64 candidateNs = 0.0;
                        if((sample & 1u) == 0u){
                            baselineNs = buffers.timeSample(false, bytes, sourceOffset, destinationOffset, iterations);
                            candidateNs = buffers.timeSample(true, bytes, sourceOffset, destinationOffset, iterations);
                        }
                        else{
                            candidateNs = buffers.timeSample(true, bytes, sourceOffset, destinationOffset, iterations);
                            baselineNs = buffers.timeSample(false, bytes, sourceOffset, destinationOffset, iterations);
                        }
                        const f64 candidateOverBaseline = candidateNs / baselineNs;
                        WriteProbeStdoutFlush(StringFormat(
                            "{},{},{},{},{},{},{},{},{}\n",
                            kindLabel,
                            cacheLabel,
                            bytes,
                            sourceOffset,
                            destinationOffset,
                            sample,
                            baselineNs,
                            candidateNs,
                            candidateOverBaseline
                        ));
                    }
                }
            }
        }
    }
}

void BenchMemoryEquality(in usize samples, in b8 firstWord){
    WriteProbeStdout("kind,cache,case,offset,sample,baseline_ns,candidate_ns,candidate_over_baseline\n");
    usize caseCount = 3u;
    if(firstWord)
        caseCount = 5u;
    Array<b8, 2> streamingModes;
    streamingModes[0] = false;
    streamingModes[1] = true;
    for(usize modeIndex = 0u; modeIndex < streamingModes.size(); ++modeIndex){
        const b8 streaming = streamingModes[modeIndex];
        usize slots = 1u;
        if(streaming)
            slots = s_StreamingBytes / 64u;
        StringView cacheLabel = "warm";
        if(streaming)
            cacheLabel = "streaming";
        MemoryEqualityBenchmarkBuffers buffers = MemoryEqualityBenchmarkBuffers(slots);
        for(usize comparisonCase = 0u; comparisonCase < caseCount; ++comparisonCase){
            const StringView caseName = ResolveEqualityCaseName(firstWord, comparisonCase);
            for(usize offset = 0u; offset < 4u; ++offset){
                buffers.prepareAndWarmup(firstWord, comparisonCase, offset);
                for(usize sample = 0u; sample < samples; ++sample){
                    f64 baselineNs = 0.0;
                    f64 candidateNs = 0.0;
                    if((sample & 1u) == 0u){
                        baselineNs = buffers.timeSample(false, firstWord, offset, s_EqualityIterations);
                        candidateNs = buffers.timeSample(true, firstWord, offset, s_EqualityIterations);
                    }
                    else{
                        candidateNs = buffers.timeSample(true, firstWord, offset, s_EqualityIterations);
                        baselineNs = buffers.timeSample(false, firstWord, offset, s_EqualityIterations);
                    }
                    const f64 candidateOverBaseline = candidateNs / baselineNs;
                    WriteProbeStdoutFlush(StringFormat(
                        "equality,{},{},{},{},{},{},{}\n",
                        cacheLabel,
                        caseName,
                        offset * s_U64ByteSize,
                        sample,
                        baselineNs,
                        candidateNs,
                        candidateOverBaseline
                    ));
                }
            }
        }
    }
}

i32 RunMemoryStorageProbeCli(in Span<StringView> args){
    StringView option = "";
    if(args.size() >= 2u)
        option = args[1];
    if(option != s_QualifyOption && option != s_BenchCopyOption && option != s_BenchEqualityOption && option != s_BenchEqualityFirstWordOption){
        WriteProbeStderr("usage: memory_storage_probe --qualify|--bench-copy|--bench-equality|--bench-equality-first-word [samples]\n");
        return 2;
    }
    if(!QualifyCopyBytes() || !QualifyEquality()){
        WriteProbeStderr("byte/equality qualification failed\n");
        return 1;
    }
    if(!QualifyProtectedRanges()){
        WriteProbeStderr("protected-range qualification failed\n");
        return 1;
    }
    if(option == s_QualifyOption){
        WriteProbeStdout("qualification passed: exact bytes/tails, adjacent ranges, page boundaries, admission, integer bits and FENV\n");
        return 0;
    }
    usize samples = 7u;
    if(args.size() >= 3u){
        const Expected<u64> parsedSamples = ParseU64(args[2]);
        if(!parsedSamples.has_value() || parsedSamples.value() == 0u || parsedSamples.value() > 100u)
            return 2;
        samples = cast<usize>(parsedSamples.value());
    }
    if(option == s_BenchCopyOption)
        BenchMemoryCopy(samples);
    else
        BenchMemoryEquality(samples, option == s_BenchEqualityFirstWordOption);
    return 0;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


int main(int argc, char** argv){
    if(argc <= 0)
        return 2;
    Array<StringView, 4> args{};
    const usize count = Min(static_cast<usize>(argc), args.size());
    for(usize index = 0u; index < count; ++index)
        args[index] = StringView(argv[index]);
    return SimdOptimizationBenchmark::RunMemoryStorageProbeCli(Span<const StringView>(args.data(), count));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


