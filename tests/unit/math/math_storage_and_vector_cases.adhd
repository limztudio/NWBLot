void CheckStorageHashMatchesEquality<T>(in T lhs, in T same, in T different){
    EXPECT_EQ(lhs, same);
    EXPECT_NE(lhs, different);
    EXPECT_EQ(HashValue(lhs), HashValue(same));
}

Array<f64x3u, 3> MakeTriangleVertices(in f64 x0, in f64 y0, in f64 z0, in f64 x1, in f64 y1, in f64 z1, in f64 x2, in f64 y2, in f64 z2){
    Array<f64x3u, 3> vertices = Array<f64x3u, 3>();
    vertices[0u] = f64x3u(x0, y0, z0);
    vertices[1u] = f64x3u(x1, y1, z1);
    vertices[2u] = f64x3u(x2, y2, z2);
    return vertices;
}

b8 EvalTriangleSingleIntersects(in VectorSingle a0, in VectorSingle a1, in VectorSingle a2, in VectorSingle b0, in VectorSingle b1, in VectorSingle b2){
    return TriangleTests::Intersects(a0, a1, a2, b0, b1, b2);
}

b8 EvalTriangleDoubleIntersects(in VectorDouble a0, in VectorDouble a1, in VectorDouble a2, in VectorDouble b0, in VectorDouble b1, in VectorDouble b2){
    return TriangleDoubleTests::Intersects(a0, a1, a2, b0, b1, b2);
}

Array<Array<usize, 3>, 6> MakeTrianglePermutations(){
    Array<Array<usize, 3>, 6> perms = Array<Array<usize, 3>, 6>();
    perms[0u][0u] = 0u; perms[0u][1u] = 1u; perms[0u][2u] = 2u;
    perms[1u][0u] = 0u; perms[1u][1u] = 2u; perms[1u][2u] = 1u;
    perms[2u][0u] = 1u; perms[2u][1u] = 0u; perms[2u][2u] = 2u;
    perms[3u][0u] = 1u; perms[3u][1u] = 2u; perms[3u][2u] = 0u;
    perms[4u][0u] = 2u; perms[4u][1u] = 0u; perms[4u][2u] = 1u;
    perms[5u][0u] = 2u; perms[5u][1u] = 1u; perms[5u][2u] = 0u;
    return perms;
}

void CheckTriangleDoubleWindingAndOrder(in Array<f64x3u, 3> first, in Array<f64x3u, 3> second, in b8 expected){
    const Array<Array<usize, 3>, 6> perms = MakeTrianglePermutations();
    for(in Array<usize, 3> firstOrder : perms){
        const VectorDouble f0 = VectorDouble(first[firstOrder[0u]], 0.0);
        const VectorDouble f1 = VectorDouble(first[firstOrder[1u]], 0.0);
        const VectorDouble f2 = VectorDouble(first[firstOrder[2u]], 0.0);
        for(in Array<usize, 3> secondOrder : perms){
            const VectorDouble s0 = VectorDouble(second[secondOrder[0u]], 0.0);
            const VectorDouble s1 = VectorDouble(second[secondOrder[1u]], 0.0);
            const VectorDouble s2 = VectorDouble(second[secondOrder[2u]], 0.0);
            EXPECT_EQ(EvalTriangleDoubleIntersects(f0, f1, f2, s0, s1, s2), expected);
            EXPECT_EQ(EvalTriangleDoubleIntersects(s0, s1, s2, f0, f1, f2), expected);
        }
    }
}

void CheckTriangleBothPrecisions(in Array<f64x3u, 3> first, in Array<f64x3u, 3> second, in b8 expected){
    Array<f32x3u, 3> firstSingle = Array<f32x3u, 3>();
    Array<f32x3u, 3> secondSingle = Array<f32x3u, 3>();
    for(usize idx = 0u; idx < 3u; ++idx){
        firstSingle[idx] = f32x3u(cast<f32>(first[idx].x), cast<f32>(first[idx].y), cast<f32>(first[idx].z));
        secondSingle[idx] = f32x3u(cast<f32>(second[idx].x), cast<f32>(second[idx].y), cast<f32>(second[idx].z));
    }
    const Array<Array<usize, 3>, 6> perms = MakeTrianglePermutations();
    for(in Array<usize, 3> firstOrder : perms){
        const VectorSingle f0 = VectorSingle(firstSingle[firstOrder[0u]], 0.0f);
        const VectorSingle f1 = VectorSingle(firstSingle[firstOrder[1u]], 0.0f);
        const VectorSingle f2 = VectorSingle(firstSingle[firstOrder[2u]], 0.0f);
        for(in Array<usize, 3> secondOrder : perms){
            const VectorSingle s0 = VectorSingle(secondSingle[secondOrder[0u]], 0.0f);
            const VectorSingle s1 = VectorSingle(secondSingle[secondOrder[1u]], 0.0f);
            const VectorSingle s2 = VectorSingle(secondSingle[secondOrder[2u]], 0.0f);
            EXPECT_EQ(EvalTriangleSingleIntersects(f0, f1, f2, s0, s1, s2), expected);
            EXPECT_EQ(EvalTriangleSingleIntersects(s0, s1, s2, f0, f1, f2), expected);
        }
    }
    CheckTriangleDoubleWindingAndOrder(first, second, expected);
}

