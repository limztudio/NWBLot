////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "list.adhd"
#include "radio_group_placement.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class AlwaysCurrentRadioGroupGuard : IRadioGroupReconcileGuard{
    public b8 current()const override{
        return true;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsRadioGroupStateCurrent(in RadioGroupState state, in RadioGroupSnapshot snapshot, in IRadioGroupReconcileGuard guard){
    if(state.m_reentryObserved || !state.matches(snapshot) || !guard.current())
        return false;
    return !state.m_reentryObserved && state.matches(snapshot);
}

b8 MatchesRadioGroupSource(in IListDataSource source, in RadioGroupState state, in RadioGroupSnapshot snapshot, in RadioGroupChoices choices, in IRadioGroupReconcileGuard guard){
    if(!IsRadioGroupStateCurrent(state, snapshot, guard))
        return false;
    const u64 generation = source.instanceGeneration();
    if(!IsRadioGroupStateCurrent(state, snapshot, guard) || generation != choices.sourceGeneration)
        return false;
    const u64 revision = source.revision();
    if(!IsRadioGroupStateCurrent(state, snapshot, guard) || revision != choices.sourceRevision)
        return false;
    const u64 count = source.rowCount();
    return IsRadioGroupStateCurrent(state, snapshot, guard) && count == choices.count;
}

Expected<RadioGroupChoices> CollectRadioGroupChoices(in IListDataSource source, in RadioGroupSnapshot snapshot, in IRadioGroupReconcileGuard guard, mut RadioGroupState state, mut RadioGroupResult result){
    RadioGroupChoices candidate;
    if(!IsRadioGroupStateCurrent(state, snapshot, guard))
        return MakeUnexpected(Failure());
    candidate.sourceGeneration = source.instanceGeneration();
    if(!IsRadioGroupStateCurrent(state, snapshot, guard) || candidate.sourceGeneration == 0u)
        return MakeUnexpected(Failure());
    candidate.sourceRevision = source.revision();
    if(!IsRadioGroupStateCurrent(state, snapshot, guard) || candidate.sourceRevision == 0u)
        return MakeUnexpected(Failure());
    const u64 count = source.rowCount();
    if(!IsRadioGroupStateCurrent(state, snapshot, guard) || count > cast<u64>(u32.max))
        return MakeUnexpected(Failure());
    candidate.count = cast<u32>(count);
    candidate.rows.resize(cast<usize>(candidate.count));
    HashSet<u64> seenKeys;
    if(candidate.count > 16u)
        seenKeys.reserve(cast<usize>(candidate.count));
    if(!MatchesRadioGroupSource(source, state, snapshot, candidate, guard))
        return MakeUnexpected(Failure());
    for(u32 index = 0u; index < candidate.count; ++index){
        if(!IsRadioGroupStateCurrent(state, snapshot, guard))
            return MakeUnexpected(Failure());
        const u64 key = source.key(index);
        b8 duplicateKey = key == 0u;
        if(!duplicateKey){
            if(candidate.count > 16u)
                duplicateKey = seenKeys.find(key) != seenKeys.end();
            else
                duplicateKey = !IsUniqueRadioGroupChoiceKey(candidate, index, key);
        }
        if(duplicateKey || !MatchesRadioGroupSource(source, state, snapshot, candidate, guard))
            return MakeUnexpected(Failure());
        if(candidate.count > 16u)
            seenKeys.insert(key);
        const Expected<u64> resolved = source.indexOf(key);
        if(!MatchesRadioGroupSource(source, state, snapshot, candidate, guard) || !resolved.has_value() || resolved.value() != index)
            return MakeUnexpected(Failure());
        const b8 enabled = source.enabled(index);
        if(!MatchesRadioGroupSource(source, state, snapshot, candidate, guard))
            return MakeUnexpected(Failure());
        candidate.rows[index].key = key;
        candidate.rows[index].enabled = enabled;
    }
    u64 selected = 0u;
    u64 cursor = 0u;
    ReconcileRadioGroupSelectionAndCursor(snapshot, candidate, selected, cursor);
    if(!MatchesRadioGroupSource(source, state, snapshot, candidate, guard) || !MatchesRadioGroupSource(source, state, snapshot, candidate, guard))
        return MakeUnexpected(Failure());
    AdvanceNonWrappingRevision(state.m_revision);
    CommitRadioGroupReconcileState(
        snapshot,
        candidate,
        selected,
        cursor,
        state.m_selected,
        state.m_cursor,
        state.m_sourceGeneration,
        state.m_sourceRevision,
        result
    );
    return candidate;
}

Expected<RadioGroupChoices> ReconcileRadioGroup(in IListDataSource source, in IRadioGroupReconcileGuard guard, mut RadioGroupState state, mut RadioGroupResult result){
    if(state.m_reconciling){
        state.m_reentryObserved = true;
        return MakeUnexpected(Failure());
    }
    const RadioGroupSnapshot snapshot = state.snapshot();
    state.m_reconciling = true;
    state.m_reentryObserved = false;
    const Expected<RadioGroupChoices> choices = CollectRadioGroupChoices(source, snapshot, guard, state, result);
    state.m_reconciling = false;
    state.m_reentryObserved = false;
    return choices;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

