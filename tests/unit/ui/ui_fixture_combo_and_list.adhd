ComboOptions MakeComboFixtureOptions(){
    ComboOptions options = ComboOptions();
    options.width.policy = LayoutSizePolicy::Fixed;
    options.width.value = 220.0f;
    options.height.policy = LayoutSizePolicy::Fixed;
    options.height.value = 32.0f;
    options.popupHeight = 144.0f;
    options.placeholder = "Choose";
    return options;
}

ListOptions MakeListFixtureOptions(){
    ListOptions options = ListOptions();
    options.width.policy = LayoutSizePolicy::Fixed;
    options.width.value = 280.0f;
    options.height.policy = LayoutSizePolicy::Fixed;
    options.height.value = 120.0f;
    return options;
}

ControlAction MakeUiListControlAction(in u64 instanceGeneration, in u64 contentGeneration, in u64 contentRevision, in ControlActionKindEnum kind){
    ControlAction action = ControlAction();
    action.control.instanceGeneration = instanceGeneration;
    action.control.contentGeneration = contentGeneration;
    action.control.contentRevision = contentRevision;
    action.kind = kind;
    return action;
}

void ExpectUiListResult(in ListResult actual, in ListResult expected){
    EXPECT_EQ(actual.valid, expected.valid);
    EXPECT_EQ(actual.selectionChanged, expected.selectionChanged);
    EXPECT_EQ(actual.activated, expected.activated);
    EXPECT_EQ(actual.focused, expected.focused);
}

void ResetComboSourceCounters(mut ComboSource self){
    self.keyCalls = 0u;
    self.lookupCalls = 0u;
    self.searchCalls = 0u;
    self.textCalls = 0u;
    self.enabledCalls = 0u;
}

b8 DeclareComboFixtureSource(mut ComboFixture self, in u64 generation, in IListDataSource source, mut ComboState state, in ComboOptions options, in Rect bounds){
    if(!self.begin(generation) || !self.m_builder.beginPanel(s_ComboPanelKey, bounds))
        return false;
    self.m_result = self.m_builder.comboBox(s_ComboKey, source, state, options);
    return self.m_result.valid;
}

b8 OpenComboFixtureByPointer(mut ComboFixture self, in u64 generation){
    const Expected<HitTarget> field = self.tryTarget(self.id(s_ComboKey, s_ComboPanelKey));
    if(!field.has_value())
        return false;
    self.click(CenterUiRect(field.value().rectangle));
    return self.accept(generation) && self.m_state.isOpen();
}

StringView FormatArithmeticSourceText(mut ArithmeticSource self, in u64 index){
    ++self.textCalls;
    if(index < self.textCallsByIndex.size())
        ++self.textCallsByIndex[cast<usize>(index)];
    if(index == self.specialIndex){
        for(usize byte = 0u; byte < self.specialText.size(); ++byte)
            self.temporary[byte] = self.specialText[byte];
        return StringView(self.temporary.data(), self.specialText.size());
    }
    const StringView letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    self.temporary[0u] = letters[cast<usize>(index % 26u)];
    self.temporary[1u] = 'x';
    return StringView(self.temporary.data(), 2u);
}

b8 PrepareUiListFixtureSource(mut UiListBuilderTests self, in u64 generation, in IListDataSource source, mut ListState state, in ListOptions options, in DisplayMetrics display){
    if(!self.begin(generation, display) || !self.m_builder.beginPanel("panel", Rect(10.0f, 10.0f, 320.0f, 260.0f)))
        return false;
    self.m_result = self.m_builder.virtualList("list", source, state, options);
    return self.m_result.valid && self.finishPanel();
}

b8 PrepareUiListFixtureLowerPopup(mut UiListBuilderTests self, in u64 generation, mut PopupState lowerPopup, mut ListState lowerState){
    const ListOptions listOptions = MakeListFixtureOptions();
    if(!self.begin(generation) || !self.m_builder.beginPanel("panel", Rect(10.0f, 10.0f, 320.0f, 260.0f)))
        return false;
    if(!self.m_builder.virtualList("list", self.m_source, self.m_state, listOptions).valid || !self.m_builder.endPanel())
        return false;
    PopupOptions popup = PopupOptions();
    popup.anchor = Rect(350.0f, 10.0f, 10.0f, 10.0f);
    popup.size = Point(320.0f, 180.0f);
    if(self.m_builder.beginPopup("popup", lowerPopup, popup)){
        if(!self.m_builder.virtualList("list", self.m_source, lowerState, listOptions).valid || !self.m_builder.endPopup())
            return false;
    }
    return self.m_context.endRoot() && self.m_context.finishFrame();
}

b8 PrepareUiListFixtureTwoPopups(mut UiListBuilderTests self, in u64 generation, mut PopupState lowerPopup, mut ListState lowerState, mut PopupState upperPopup, mut ListState upperState){
    const ListOptions listOptions = MakeListFixtureOptions();
    if(!self.begin(generation) || !self.m_builder.beginPanel("panel", Rect(10.0f, 10.0f, 320.0f, 260.0f)))
        return false;
    if(!self.m_builder.virtualList("list", self.m_source, self.m_state, listOptions).valid || !self.m_builder.endPanel())
        return false;
    PopupOptions popup = PopupOptions();
    popup.anchor = Rect(350.0f, 10.0f, 10.0f, 10.0f);
    popup.size = Point(320.0f, 180.0f);
    if(self.m_builder.beginPopup("popup", lowerPopup, popup)){
        if(!self.m_builder.virtualList("list", self.m_source, lowerState, listOptions).valid || !self.m_builder.endPopup())
            return false;
    }
    popup.anchor = Rect(400.0f, 220.0f, 10.0f, 10.0f);
    if(self.m_builder.beginPopup("upper", upperPopup, popup)){
        if(!self.m_builder.virtualList("list", self.m_source, upperState, listOptions).valid || !self.m_builder.endPopup())
            return false;
    }
    return self.m_context.endRoot() && self.m_context.finishFrame();
}

b8 SendUiListFixtureWheel(mut UiListBuilderTests self, in f64 delta){
    const Expected<HitTarget> accepted = self.tryTarget(self.id("list", "panel"));
    if(!accepted.has_value())
        return false;
    InputEvent event = InputEvent();
    event.type = InputEventType::PointerWheel;
    event.position = CenterUiRect(accepted.value().rectangle);
    event.scrollY = delta;
    return self.send(event).pointerConsumed;
}


