#include "stress_test_runtime.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class StressTestSmokeProject : IProjectEntryCallbacks{
    public StressTestSmokeProject(mut ProjectRuntimeContext context){
        this.m_impl = StressTestSmokeProjectImpl(context);
    }

    public b8 onStartup()override{
        return this.m_impl.onStartup();
    }

    public void onShutdown()override{
        this.m_impl.onShutdown();
    }

    public b8 onUpdate(in f32 delta)override{
        return this.m_impl.onUpdate(delta);
    }

    private StressTestSmokeProjectImpl m_impl;
}


