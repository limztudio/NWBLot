#ifndef NWB_GRAPHICS_SHADOW_SW_SHADOW_TRAVERSE_SLANGI
#define NWB_GRAPHICS_SHADOW_SW_SHADOW_TRAVERSE_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "sw_binding_slots.h"
#include "../bvh/constants.h"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_SW_SHADOW_OCCLUDER
#error "each software-shadow trace pass must #define NWB_SW_SHADOW_OCCLUDER before including sw_shadow_traverse.slangi"
#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


uint nwbMeshFrameMaterialTypedHeapSlot(){
    return g_NwbSwShadowMaterialContextSlots.sceneSlots.w;
}
uint nwbMeshFrameInstanceHeapSlot(){
    return g_NwbSwShadowMaterialContextSlots.materialSlots.x;
}
uint nwbMeshFrameViewHeapSlot(){
    return 0u;
}
#include "../mesh/bindless_heap_mesh.slangi"

#include "sw_shadow_intersect.slangi"
#include "sw_shadow_geometry.slangi"

#include "shadow_surface.slangi"
#include "shadow/generated/surface_dispatch.slangi"

#include "shadow_integrate.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#define NWB_SW_SHADOW_TRANSMITTANCE_EPSILON 1e-3h

uint nwbSwShadowInstanceCount(){
    return g_NwbSwShadowPush.instanceCount;
}

#if NWB_SW_SHADOW_OCCLUDER == NWB_SW_SHADOW_OCCLUDER_OPAQUE
bool nwbSwShadowInstanceBlockedOpaque(const uint instanceIndex, const float3 worldOrigin, const float3 worldDirection, const float tMin, const float tMax){
    const NwbSwBvhInstance instance = nwbHeapSwBvhInstances(g_NwbSwShadowMaterialContextSlots.sceneSlots.y)[instanceIndex];
    const NwbRtInstanceMaterial material = nwbHeapRtInstanceMaterials(g_NwbSwShadowMaterialContextSlots.sceneSlots.z)[instanceIndex];
#if defined(NWB_SW_SHADOW_SKIP_CSG)
#if NWB_SW_SHADOW_SKIP_CSG
    if((material.flags & NWB_RT_INSTANCE_MATERIAL_FLAG_CSG_SHADOW) != 0u)
        return false;
#endif
#endif
    if((material.flags & NWB_RT_INSTANCE_MATERIAL_FLAG_TRANSPARENT) != 0u)
        return false;
    const float3 origin = nwbSwBvhTransformPoint(instance, worldOrigin);
    const float3 direction = nwbSwBvhTransformVector(instance, worldDirection);
    const float3 invDir = nwbSwShadowSafeInvDir(direction);
    const float3 minBias = (-NWB_SW_SHADOW_AABB_PADDING - origin) * invDir;
    const float3 maxBias = (NWB_SW_SHADOW_AABB_PADDING - origin) * invDir;
    const NwbSwShadowWoopRay woopRay = nwbSwShadowMakeWoopRay(origin, direction);

    uint stack[NWB_SW_SHADOW_MESH_STACK_SIZE];
    stack[0u] = 0u;
    uint stackPointer = 0u;

    NwbBvhNode node = nwbHeapBvhNodes(material.nodeSlot)[0u];
    if(!nwbSwShadowRayAabbFma(invDir, minBias, maxBias, tMin, tMax, node.aabbMin, node.aabbMax))
        return false;

    while(true){
        if(nwbBvhNodeIsLeaf(node)){
            const uint triangle = nwbBvhLeafPrimitive(node);
            const uint indexBase = triangle * NWB_RAYTRACE_TRIANGLE_CORNER_COUNT;
            const uint3 indices = nwbHeapRawBuffer(material.indexSlot).Load3(indexBase * NWB_RAYTRACE_INDEX_STRIDE_BYTES);
            const float3 v0 = asfloat(nwbHeapRawBuffer(material.positionSlot).Load3(indices.x * NWB_RAYTRACE_POSITION_STRIDE_BYTES));
            const float3 v1 = asfloat(nwbHeapRawBuffer(material.positionSlot).Load3(indices.y * NWB_RAYTRACE_POSITION_STRIDE_BYTES));
            const float3 v2 = asfloat(nwbHeapRawBuffer(material.positionSlot).Load3(indices.z * NWB_RAYTRACE_POSITION_STRIDE_BYTES));
            if(nwbSwShadowRayTriangleWoop(woopRay, tMin, tMax, v0, v1, v2).hit)
                return true;
            if(stackPointer == 0u)
                return false;
            --stackPointer;
            node = nwbHeapBvhNodes(material.nodeSlot)[stack[stackPointer]];
        }
        else{
            const uint left = node.leftChild;
            const uint right = nwbBvhNodeRightChildIndex(node);
            const NwbBvhNode leftNode = nwbHeapBvhNodes(material.nodeSlot)[left];
            const NwbBvhNode rightNode = nwbHeapBvhNodes(material.nodeSlot)[right];
            const float tLeft = nwbSwShadowRayAabbEntryTFma(invDir, minBias, maxBias, tMin, tMax, leftNode.aabbMin, leftNode.aabbMax);
            const float tRight = nwbSwShadowRayAabbEntryTFma(invDir, minBias, maxBias, tMin, tMax, rightNode.aabbMin, rightNode.aabbMax);
            const bool leftMiss = (tLeft >= NWB_SW_SHADOW_AABB_MISS);
            const bool rightMiss = (tRight >= NWB_SW_SHADOW_AABB_MISS);

            if(leftMiss && rightMiss){
                if(stackPointer == 0u)
                    return false;
                --stackPointer;
                node = nwbHeapBvhNodes(material.nodeSlot)[stack[stackPointer]];
                continue;
            }
            const bool leftNear = (tLeft <= tRight);
            const uint farChild = leftNear ? right : left;
            const bool farMiss = leftNear ? rightMiss : leftMiss;
            node = leftNear ? leftNode : rightNode;

            if(farMiss)
                continue;

            if((stackPointer + 1u) >= NWB_SW_SHADOW_MESH_STACK_SIZE)
                return true;
            stack[stackPointer] = farChild;
            ++stackPointer;
        }
    }
}

bool nwbSwShadowOpaqueBlocked(const float3 origin, const float3 direction, const float tMin, const float tMax){
    if(nwbSwShadowInstanceCount() == 0u)
        return false;

    const float3 invDir = nwbSwShadowSafeInvDir(direction);
    const float3 minBias = (-NWB_SW_SHADOW_AABB_PADDING - origin) * invDir;
    const float3 maxBias = (NWB_SW_SHADOW_AABB_PADDING - origin) * invDir;

    uint stack[NWB_SW_SHADOW_SCENE_STACK_SIZE];
    stack[0u] = 0u;
    uint stackPointer = 0u;

    NwbBvhNode node = nwbHeapBvhNodes(g_NwbSwShadowMaterialContextSlots.sceneSlots.x)[0u];
    if(!nwbSwShadowRayAabbFma(invDir, minBias, maxBias, tMin, tMax, node.aabbMin, node.aabbMax))
        return false;

    while(true){
        if(nwbBvhNodeIsLeaf(node)){
            if(nwbSwShadowInstanceBlockedOpaque(nwbBvhLeafPrimitive(node), origin, direction, tMin, tMax))
                return true;
            if(stackPointer == 0u)
                return false;
            --stackPointer;
            node = nwbHeapBvhNodes(g_NwbSwShadowMaterialContextSlots.sceneSlots.x)[stack[stackPointer]];
        }
        else{
            const uint left = node.leftChild;
            const uint right = nwbBvhNodeRightChildIndex(node);
            const NwbBvhNode leftNode = nwbHeapBvhNodes(g_NwbSwShadowMaterialContextSlots.sceneSlots.x)[left];
            const NwbBvhNode rightNode = nwbHeapBvhNodes(g_NwbSwShadowMaterialContextSlots.sceneSlots.x)[right];
            const float tLeft = nwbSwShadowRayAabbEntryTFma(invDir, minBias, maxBias, tMin, tMax, leftNode.aabbMin, leftNode.aabbMax);
            const float tRight = nwbSwShadowRayAabbEntryTFma(invDir, minBias, maxBias, tMin, tMax, rightNode.aabbMin, rightNode.aabbMax);
            const bool leftMiss = (tLeft >= NWB_SW_SHADOW_AABB_MISS);
            const bool rightMiss = (tRight >= NWB_SW_SHADOW_AABB_MISS);

            if(leftMiss && rightMiss){
                if(stackPointer == 0u)
                    return false;
                --stackPointer;
                node = nwbHeapBvhNodes(g_NwbSwShadowMaterialContextSlots.sceneSlots.x)[stack[stackPointer]];
                continue;
            }
            const bool leftNear = (tLeft <= tRight);
            const uint farChild = leftNear ? right : left;
            const bool farMiss = leftNear ? rightMiss : leftMiss;
            node = leftNear ? leftNode : rightNode;

            if(farMiss)
                continue;

            if((stackPointer + 1u) >= NWB_SW_SHADOW_SCENE_STACK_SIZE)
                return true;
            stack[stackPointer] = farChild;
            ++stackPointer;
        }
    }
}

void nwbSwShadowOccluded(const float3 origin, const float3 direction, const float tMin, const float tMax, inout NwbShadowVisibilityAccumulator acc){
    if(nwbSwShadowOpaqueBlocked(origin, direction, tMin, tMax))
        acc.transmittance = half3(0.0h, 0.0h, 0.0h);
}
#else
NwbShadowInstanceStatus nwbSwShadowInstanceOptics(const uint instanceIndex, const float3 worldOrigin, const float3 worldDirection, const float tMin, const float tMax, __ref NwbShadowInstanceOptics optics){
    const NwbSwBvhInstance instance = nwbHeapSwBvhInstances(g_NwbSwShadowMaterialContextSlots.sceneSlots.y)[instanceIndex];
    const NwbRtInstanceMaterial material = nwbHeapRtInstanceMaterials(g_NwbSwShadowMaterialContextSlots.sceneSlots.z)[instanceIndex];
#if defined(NWB_SW_SHADOW_SKIP_CSG)
#if NWB_SW_SHADOW_SKIP_CSG
    if((material.flags & NWB_RT_INSTANCE_MATERIAL_FLAG_CSG_SHADOW) != 0u)
        return NwbShadowInstanceStatus::NoIntersection;
#endif
#endif
    const bool transparent = (material.flags & NWB_RT_INSTANCE_MATERIAL_FLAG_TRANSPARENT) != 0u;
#if NWB_SW_SHADOW_OCCLUDER == NWB_SW_SHADOW_OCCLUDER_OPAQUE
    if(transparent)
        return NwbShadowInstanceStatus::NoIntersection;
#elif NWB_SW_SHADOW_OCCLUDER == NWB_SW_SHADOW_OCCLUDER_TRANSPARENT
    if(!transparent)
        return NwbShadowInstanceStatus::NoIntersection;
#endif
    nwbShadowInstanceOpticsBegin(optics);
    bool hasAbsorption = false;
    const float3 origin = nwbSwBvhTransformPoint(instance, worldOrigin);
    const float3 direction = nwbSwBvhTransformVector(instance, worldDirection);
    const float3 invDir = nwbSwShadowSafeInvDir(direction);
    const float3 minBias = (-NWB_SW_SHADOW_AABB_PADDING - origin) * invDir;
    const float3 maxBias = (NWB_SW_SHADOW_AABB_PADDING - origin) * invDir;
    const NwbSwShadowWoopRay woopRay = nwbSwShadowMakeWoopRay(origin, direction);

    uint stack[NWB_SW_SHADOW_MESH_STACK_SIZE];
    stack[0u] = 0u;
    uint stackPointer = 0u;

    NwbBvhNode node = nwbHeapBvhNodes(material.nodeSlot)[0u];
    if(!nwbSwShadowRayAabbFma(invDir, minBias, maxBias, tMin, tMax, node.aabbMin, node.aabbMax))
        return NwbShadowInstanceStatus::NoIntersection;

    while(true){
        if(nwbBvhNodeIsLeaf(node)){
            const uint triangle = nwbBvhLeafPrimitive(node);
            const uint indexBase = triangle * NWB_RAYTRACE_TRIANGLE_CORNER_COUNT;
            const uint3 indices = nwbHeapRawBuffer(material.indexSlot).Load3(indexBase * NWB_RAYTRACE_INDEX_STRIDE_BYTES);
            const float3 v0 = asfloat(nwbHeapRawBuffer(material.positionSlot).Load3(indices.x * NWB_RAYTRACE_POSITION_STRIDE_BYTES));
            const float3 v1 = asfloat(nwbHeapRawBuffer(material.positionSlot).Load3(indices.y * NWB_RAYTRACE_POSITION_STRIDE_BYTES));
            const float3 v2 = asfloat(nwbHeapRawBuffer(material.positionSlot).Load3(indices.z * NWB_RAYTRACE_POSITION_STRIDE_BYTES));
            const NwbSwShadowTriangleHit triangleHit = nwbSwShadowRayTriangleWoop(woopRay, tMin, tMax, v0, v1, v2);
            if(triangleHit.hit){
                if(!transparent)
                    return NwbShadowInstanceStatus::OpaqueBlocked;
                const uint attributeBase = triangle * NWB_RAYTRACE_TRIANGLE_CORNER_COUNT;
                const NwbRayTraceVertexAttrib a0 = nwbSwShadowLoadVertexAttrib(material.attributeSlot, attributeBase);
                const NwbRayTraceVertexAttrib a1 = nwbSwShadowLoadVertexAttrib(material.attributeSlot, attributeBase + 1u);
                const NwbRayTraceVertexAttrib a2 = nwbSwShadowLoadVertexAttrib(material.attributeSlot, attributeBase + 2u);
                const half smoothNormalWeight = nwbShadowSmoothNormalWeight(float3(a0.normal), float3(a1.normal), float3(a2.normal));

                const float3 objectNormal = float3(a0.normal) * triangleHit.w + float3(a1.normal) * triangleHit.u + float3(a2.normal) * triangleHit.v;

                NwbShadowHit hit;
                hit.meshInstanceIndex = material.meshInstanceIndex;
                hit.surfaceDispatchId = material.surfaceDispatchId;
                hit.materialConstantByteOffset = material.materialConstantByteOffset;
                hit.uv0 = a0.uv0 * triangleHit.w + a1.uv0 * triangleHit.u + a2.uv0 * triangleHit.v;
                hit.worldNormal = nwbSwShadowTransformNormal(instance, objectNormal);
                hit.worldPosition = worldOrigin + worldDirection * triangleHit.t;
                hit.rayDirection = worldDirection;

                const NwbMeshSurface surface = nwbShadowDispatchSurface(material.surfaceDispatchId, hit);
                const float3 geometricNormal = cross(v1 - v0, v2 - v0);
                const half cosI = nwbShadowCosineToRay(nwbSwBvhTransformNormal(instance, geometricNormal), worldDirection);
                const half shadingCosI = nwbShadowCosineToRay(hit.worldNormal, worldDirection);
                const half fresnelCosI = lerp(cosI, shadingCosI, smoothNormalWeight);
                nwbShadowInstanceIntegrateCrossing(optics, hasAbsorption, surface.refractionIor, surface.shadowAbsorptionTint, fresnelCosI, triangleHit.t);
            }
            if(stackPointer == 0u){
                if(optics.crossingCount == 0u && optics.crossingOverflow == 0u)
                    return NwbShadowInstanceStatus::NoIntersection;
                return NwbShadowInstanceStatus::Completed;
            }
            --stackPointer;
            node = nwbHeapBvhNodes(material.nodeSlot)[stack[stackPointer]];
        }
        else{
            const uint left = node.leftChild;
            const uint right = nwbBvhNodeRightChildIndex(node);
            const NwbBvhNode leftNode = nwbHeapBvhNodes(material.nodeSlot)[left];
            const NwbBvhNode rightNode = nwbHeapBvhNodes(material.nodeSlot)[right];
            const float tLeft = nwbSwShadowRayAabbEntryTFma(invDir, minBias, maxBias, tMin, tMax, leftNode.aabbMin, leftNode.aabbMax);
            const float tRight = nwbSwShadowRayAabbEntryTFma(invDir, minBias, maxBias, tMin, tMax, rightNode.aabbMin, rightNode.aabbMax);
            const bool leftMiss = (tLeft >= NWB_SW_SHADOW_AABB_MISS);
            const bool rightMiss = (tRight >= NWB_SW_SHADOW_AABB_MISS);

            if(leftMiss && rightMiss){
                if(stackPointer == 0u){
                    if(optics.crossingCount == 0u && optics.crossingOverflow == 0u)
                        return NwbShadowInstanceStatus::NoIntersection;
                    return NwbShadowInstanceStatus::Completed;
                }
                --stackPointer;
                node = nwbHeapBvhNodes(material.nodeSlot)[stack[stackPointer]];
                continue;
            }
            const bool leftNear = (tLeft <= tRight);
            const uint farChild = leftNear ? right : left;
            const bool farMiss = leftNear ? rightMiss : leftMiss;
            node = leftNear ? leftNode : rightNode;

            if(farMiss)
                continue;

            if((stackPointer + 1u) >= NWB_SW_SHADOW_MESH_STACK_SIZE)
                return NwbShadowInstanceStatus::StackOverflow;
            stack[stackPointer] = farChild;
            ++stackPointer;
        }
    }
}

void nwbSwShadowInstanceOccluded(const uint instanceIndex, const float3 worldOrigin, const float3 worldDirection, const float tMin, const float tMax, inout NwbShadowVisibilityAccumulator acc){
    NwbShadowInstanceOptics optics;
    nwbShadowInstanceOpticsBegin(optics);
    const NwbShadowInstanceStatus status = nwbSwShadowInstanceOptics(instanceIndex, worldOrigin, worldDirection, tMin, tMax, optics);
    if(status == NwbShadowInstanceStatus::OpaqueBlocked || status == NwbShadowInstanceStatus::StackOverflow){
        acc.transmittance = half3(0.0h, 0.0h, 0.0h);
        return;
    }
    if(status != NwbShadowInstanceStatus::Completed)
        return;
    nwbShadowAccumulateInstance(acc, optics);
}

void nwbSwShadowOccluded(const float3 origin, const float3 direction, const float tMin, const float tMax, inout NwbShadowVisibilityAccumulator acc){
    if(nwbSwShadowInstanceCount() == 0u)
        return;

    const float3 invDir = nwbSwShadowSafeInvDir(direction);
    const float3 minBias = (-NWB_SW_SHADOW_AABB_PADDING - origin) * invDir;
    const float3 maxBias = (NWB_SW_SHADOW_AABB_PADDING - origin) * invDir;

    uint stack[NWB_SW_SHADOW_SCENE_STACK_SIZE];
    stack[0u] = 0u;
    uint stackPointer = 0u;

    NwbBvhNode node = nwbHeapBvhNodes(g_NwbSwShadowMaterialContextSlots.sceneSlots.x)[0u];
#if NWB_SW_SHADOW_OCCLUDER == NWB_SW_SHADOW_OCCLUDER_TRANSPARENT
    if(!nwbBvhNodeContainsTransparentOccluder(node))
        return;
#endif
    if(!nwbSwShadowRayAabbFma(invDir, minBias, maxBias, tMin, tMax, node.aabbMin, node.aabbMax))
        return;

    while(true){
        if(nwbBvhNodeIsLeaf(node)){
            nwbSwShadowInstanceOccluded(nwbBvhLeafPrimitive(node), origin, direction, tMin, tMax, acc);
            if(max(max(acc.transmittance.x, acc.transmittance.y), acc.transmittance.z) < NWB_SW_SHADOW_TRANSMITTANCE_EPSILON)
                return;
            if(stackPointer == 0u)
                return;
            --stackPointer;
            node = nwbHeapBvhNodes(g_NwbSwShadowMaterialContextSlots.sceneSlots.x)[stack[stackPointer]];
        }
        else{
            const uint left = node.leftChild;
            const uint right = nwbBvhNodeRightChildIndex(node);
            const NwbBvhNode leftNode = nwbHeapBvhNodes(g_NwbSwShadowMaterialContextSlots.sceneSlots.x)[left];
            const NwbBvhNode rightNode = nwbHeapBvhNodes(g_NwbSwShadowMaterialContextSlots.sceneSlots.x)[right];
#if NWB_SW_SHADOW_OCCLUDER == NWB_SW_SHADOW_OCCLUDER_TRANSPARENT
            const bool leftTransparent = nwbBvhNodeContainsTransparentOccluder(leftNode);
            const bool rightTransparent = nwbBvhNodeContainsTransparentOccluder(rightNode);
#endif
            const float tLeft =
#if NWB_SW_SHADOW_OCCLUDER == NWB_SW_SHADOW_OCCLUDER_TRANSPARENT
                leftTransparent
                    ? nwbSwShadowRayAabbEntryTFma(invDir, minBias, maxBias, tMin, tMax, leftNode.aabbMin, leftNode.aabbMax)
                    : NWB_SW_SHADOW_AABB_MISS
#else
                nwbSwShadowRayAabbEntryTFma(invDir, minBias, maxBias, tMin, tMax, leftNode.aabbMin, leftNode.aabbMax)
#endif
            ;
            const float tRight =
#if NWB_SW_SHADOW_OCCLUDER == NWB_SW_SHADOW_OCCLUDER_TRANSPARENT
                rightTransparent
                    ? nwbSwShadowRayAabbEntryTFma(invDir, minBias, maxBias, tMin, tMax, rightNode.aabbMin, rightNode.aabbMax)
                    : NWB_SW_SHADOW_AABB_MISS
#else
                nwbSwShadowRayAabbEntryTFma(invDir, minBias, maxBias, tMin, tMax, rightNode.aabbMin, rightNode.aabbMax)
#endif
            ;
            const bool leftMiss = (tLeft >= NWB_SW_SHADOW_AABB_MISS);
            const bool rightMiss = (tRight >= NWB_SW_SHADOW_AABB_MISS);

            if(leftMiss && rightMiss){
                if(stackPointer == 0u)
                    return;
                --stackPointer;
                node = nwbHeapBvhNodes(g_NwbSwShadowMaterialContextSlots.sceneSlots.x)[stack[stackPointer]];
                continue;
            }
            const bool leftNear = (tLeft <= tRight);
            const uint farChild = leftNear ? right : left;
            const bool farMiss = leftNear ? rightMiss : leftMiss;
            node = leftNear ? leftNode : rightNode;

            if(farMiss)
                continue;

            if((stackPointer + 1u) >= NWB_SW_SHADOW_SCENE_STACK_SIZE){
                acc.transmittance = half3(0.0h, 0.0h, 0.0h);
                return;
            }
            stack[stackPointer] = farChild;
            ++stackPointer;
        }
    }
}
#endif


