b8 TryRouteRouterContextMenuCommand(
    in InputEvent event,
    in HitTarget focused,
    in b8 alreadyPressed,
    mut CommandSource inOutSource
){
    if(event.command != InputCommand::ContextMenu || !focused.contextMenu)
        return false;
    if(!alreadyPressed && !event.repeat){
        inOutSource.contextArmed = true;
        inOutSource.contextPosition = Point(focused.rectangle.x, focused.rectangle.y + focused.rectangle.height);
    }
    return true;
}

void EraseRouterDeviceInputs(
    in u64 device,
    mut Vector<PointerSource> pointerSources,
    mut Vector<PointerBinding> pointerBindings,
    mut Vector<CommandSource> commandSources,
    mut Vector<BoundSource> boundSources,
    mut Vector<InputEvent> events
){
    usize keptPointerSources = 0u;
    for(usize index = 0u; index < pointerSources.size(); ++index){
        if(pointerSources[index].source.device != device){
            if(keptPointerSources != index)
                pointerSources[keptPointerSources] = pointerSources[index];
            ++keptPointerSources;
        }
    }
    pointerSources.resize(keptPointerSources);
    usize keptPointerBindings = 0u;
    for(usize index = 0u; index < pointerBindings.size(); ++index){
        if(pointerBindings[index].source.device != device){
            if(keptPointerBindings != index)
                pointerBindings[keptPointerBindings] = pointerBindings[index];
            ++keptPointerBindings;
        }
    }
    pointerBindings.resize(keptPointerBindings);
    usize keptCommandSources = 0u;
    for(usize index = 0u; index < commandSources.size(); ++index){
        if(commandSources[index].source.device != device){
            if(keptCommandSources != index)
                commandSources[keptCommandSources] = commandSources[index];
            ++keptCommandSources;
        }
    }
    commandSources.resize(keptCommandSources);
    usize keptBoundSources = 0u;
    for(usize index = 0u; index < boundSources.size(); ++index){
        if(boundSources[index].source.device != device){
            if(keptBoundSources != index)
                boundSources[keptBoundSources] = boundSources[index];
            ++keptBoundSources;
        }
    }
    boundSources.resize(keptBoundSources);
    usize keptEvents = 0u;
    for(usize index = 0u; index < events.size(); ++index){
        const InputEvent event = events[index];
        if(!event.source.valid() || event.source.device != device){
            if(keptEvents != index)
                events[keptEvents] = event;
            ++keptEvents;
        }
    }
    events.resize(keptEvents);
}

b8 IsCurrentRouterCommandFocus(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in b8 windowFocused,
    in WidgetId focus,
    in u64 focusDeclaration,
    in CommandSource source
){
    const TargetOwner owner = source.focusOwner;
    if(!windowFocused || !source.consumed || !owner.target.valid() || focus != owner.target || focusDeclaration != owner.declarationGeneration)
        return false;
    const Expected<usize> focusedIndex = FindTargetIndexInTable(targets, lookup, owner.target, owner.declarationGeneration);
    if(!focusedIndex.has_value())
        return false;
    const HitTarget focused = targets[focusedIndex.value()];
    return
        focused.focusable
        && IsRouterTargetInteractive(targets, lookup, popups, focused)
        && focused.popup == owner.popup
        && focused.control == owner.control
    ;
}

Expected<usize> FindRouterCommandSourceIndex(in Span<CommandSource> commandSources, in InputSource source){
    for(usize index = 0u; index < commandSources.size(); ++index){
        if(commandSources[index].source == source)
            return index;
    }
    return makeUnexpected(Failure());
}

b8 CanRouterEditCommand(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in Span<CommandSource> commandSources,
    in b8 windowFocused,
    in WidgetId focus,
    in u64 focusDeclaration,
    in InputEvent event
){
    if(event.type != InputEventType::CommandDown || !event.edit)
        return false;
    const Expected<usize> sourceIndex = FindRouterCommandSourceIndex(commandSources, event.source);
    if(!sourceIndex.has_value())
        return false;
    const CommandSource source = commandSources[sourceIndex.value()];
    if(!IsCurrentRouterCommandFocus(targets, lookup, popups, windowFocused, focus, focusDeclaration, source))
        return false;
    const Expected<usize> focusedIndex = FindTargetIndexInTable(targets, lookup, source.focusOwner.target, source.focusOwner.declarationGeneration);
    if(!focusedIndex.has_value() || !targets[focusedIndex.value()].textEditable)
        return false;
    return !source.delegated || ((event.command == InputCommand::Accept || event.command == InputCommand::Submit) && IsCurrentRouterControlCommandOwner(targets, lookup, popups, source));
}

b8 CanRouterSubmitCommand(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in Span<CommandSource> commandSources,
    in b8 windowFocused,
    in WidgetId focus,
    in u64 focusDeclaration,
    in InputEvent event
){
    if(event.type != InputEventType::CommandUp || !event.edit || (event.command != InputCommand::Accept && event.command != InputCommand::Submit))
        return false;
    const Expected<usize> sourceIndex = FindRouterCommandSourceIndex(commandSources, event.source);
    if(!sourceIndex.has_value())
        return false;
    const CommandSource source = commandSources[sourceIndex.value()];
    if(!source.submitArmed || !IsCurrentRouterCommandFocus(targets, lookup, popups, windowFocused, focus, focusDeclaration, source))
        return false;
    const Expected<usize> focusedIndex = FindTargetIndexInTable(targets, lookup, source.focusOwner.target, source.focusOwner.declarationGeneration);
    if(!focusedIndex.has_value() || !targets[focusedIndex.value()].textEditable)
        return false;
    return !source.delegated || IsCurrentRouterControlCommandOwner(targets, lookup, popups, source);
}

void CancelRouterSubmitCommands(in WidgetId id, mut Vector<CommandSource> commandSources){
    for(usize index = 0u; index < commandSources.size(); ++index){
        if(commandSources[index].focusOwner.target == id)
            commandSources[index].submitArmed = false;
    }
}

void CancelRouterCommandPresses(mut Vector<CommandSource> commandSources){
    for(usize index = 0u; index < commandSources.size(); ++index){
        CommandSource source = commandSources[index];
        source.submitArmed = false;
        source.contextArmed = false;
        commandSources[index] = source;
    }
}

void ReconcileRouterCommandPresses(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in b8 windowFocused,
    in WidgetId focus,
    in u64 focusDeclaration,
    mut Vector<CommandSource> commandSources
){
    for(usize index = 0u; index < commandSources.size(); ++index){
        CommandSource source = commandSources[index];
        if(!IsCurrentRouterCommandFocus(targets, lookup, popups, windowFocused, focus, focusDeclaration, source)){
            source.submitArmed = false;
            source.contextArmed = false;
            commandSources[index] = source;
        }
    }
}

b8 TryMoveRouterFocus(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in b8 reverse,
    mut Vector<CommandSource> commandSources,
    mut WidgetId inOutFocus,
    mut u64 inOutFocusDeclaration,
    mut ControlToken inOutFocusControl
){
    if(targets.empty())
        return false;
    usize current = targets.size();
    for(usize index = 0u; index < targets.size(); ++index){
        if(targets[index].id == inOutFocus){
            current = index;
            break;
        }
    }
    usize candidate = current;
    for(usize visited = 0u; visited < targets.size(); ++visited){
        if(reverse){
            if(candidate == 0u || candidate == targets.size())
                candidate = targets.size() - 1u;
            else
                candidate -= 1u;
        }
        else{
            if(candidate >= targets.size() - 1u)
                candidate = 0u;
            else
                candidate += 1u;
        }
        const HitTarget target = targets[candidate];
        if(target.focusable && IsRouterTargetInteractive(targets, lookup, popups, target)){
            AssignRouterFocus(target, commandSources, inOutFocus, inOutFocusDeclaration, inOutFocusControl);
            return true;
        }
    }
    return false;
}

b8 TryMoveRouterFocusForTraversal(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in b8 reverse,
    mut Vector<PopupRecord> popups,
    mut Vector<PopupDismissal> popupDismissals,
    mut Vector<CommandSource> commandSources,
    mut WidgetId inOutFocus,
    mut u64 inOutFocusDeclaration,
    mut ControlToken inOutFocusControl,
    mut b8 outDismissedPopup
){
    outDismissedPopup = false;
    if(popups.empty() || !popups.back().scope.dismissFocusTraversal)
        return TryMoveRouterFocus(targets, lookup, popups, reverse, commandSources, inOutFocus, inOutFocusDeclaration, inOutFocusControl);
    const PopupRecord top = popups.back();
    if(top.closing)
        return true;
    usize current = targets.size();
    for(usize index = 0u; index < targets.size(); ++index){
        if(targets[index].id == inOutFocus && targets[index].declarationGeneration == inOutFocusDeclaration){
            current = index;
            break;
        }
    }
    const PopupToken token = top.scope.token;
    if(reverse){
        for(usize index = current; index > 0u; --index){
            const HitTarget target = targets[index - 1u];
            if(target.popup != token || !target.focusable || !IsRouterTargetInteractive(targets, lookup, popups, target))
                continue;
            AssignRouterFocus(target, commandSources, inOutFocus, inOutFocusDeclaration, inOutFocusControl);
            return true;
        }
    }
    else{
        usize startIndex = 0u;
        if(current != targets.size())
            startIndex = current + 1u;
        for(usize index = startIndex; index < targets.size(); ++index){
            const HitTarget target = targets[index];
            if(target.popup != token || !target.focusable || !IsRouterTargetInteractive(targets, lookup, popups, target))
                continue;
            AssignRouterFocus(target, commandSources, inOutFocus, inOutFocusDeclaration, inOutFocusControl);
            return true;
        }
    }
    const PopupToken parent = top.scope.parent;
    usize anchor = targets.size();
    for(usize index = 0u; index < targets.size(); ++index){
        const HitTarget target = targets[index];
        if(target.id == top.scope.focusAnchor && target.declarationGeneration == top.scope.focusAnchorDeclarationGeneration && target.popup == parent){
            anchor = index;
            break;
        }
    }
    WidgetId nextFocus;
    u64 nextDeclaration = 0u;
    for(usize offset = 1u; offset <= targets.size(); ++offset){
        usize index = 0u;
        if(anchor == targets.size()){
            if(reverse)
                index = targets.size() - offset;
            else
                index = offset - 1u;
        }
        else{
            if(reverse)
                index = (anchor + targets.size() - offset) % targets.size();
            else
                index = (anchor + offset) % targets.size();
        }
        const HitTarget target = targets[index];
        if(target.popup != parent || !target.enabled || !target.focusable || target.owner.valid() || !HasVisibleUiRectIntersection(target.rectangle, target.clip))
            continue;
        nextFocus = target.id;
        nextDeclaration = target.declarationGeneration;
        break;
    }
    if(!TryDismissRouterPopup(PopupDismissReason::FocusTraversal, popups, popupDismissals))
        return true;
    PopupRecord closing = popups.back();
    closing.restoreFocus = nextFocus;
    closing.restoreDeclaration = nextDeclaration;
    closing.restorePopup = parent;
    popups[popups.size() - 1u] = closing;
    outDismissedPopup = true;
    return true;
}

Expected<InputEvent> TryResolveRouterSourceEvent(
    in Span<InputKeyBinding> keyBindings,
    in InputEvent event,
    mut Vector<BoundSource> boundSources
){
    InputEvent resolved = event;
    const b8 physical = event.type == InputEventType::KeyDown || event.type == InputEventType::KeyUp;
    const b8 command = event.type == InputEventType::CommandDown || event.type == InputEventType::CommandUp;
    if(!physical && !command)
        return resolved;
    if(physical){
        if(!IsValidInputKeyCode(event.key))
            return makeUnexpected(Failure());
        if(event.type == InputEventType::KeyDown)
            resolved.type = InputEventType::CommandDown;
        else
            resolved.type = InputEventType::CommandUp;
        resolved.source = InputSource(0u, cast<u64>(event.key) + 1u);
    }
    else if(!event.source.valid() || event.command > InputCommand::ContextMenu)
        return makeUnexpected(Failure());
    usize heldIndex = boundSources.size();
    for(usize index = 0u; index < boundSources.size(); ++index){
        if(boundSources[index].source == resolved.source){
            heldIndex = index;
            break;
        }
    }
    if(heldIndex != boundSources.size()){
        const InputCommandIntent heldIntent = boundSources[heldIndex].intent;
        resolved.command = heldIntent.command;
        resolved.extend = heldIntent.extend;
        resolved.edit = heldIntent.edit;
        resolved.allowText = heldIntent.allowText;
        if(resolved.type == InputEventType::CommandUp){
            for(usize moveIndex = heldIndex + 1u; moveIndex < boundSources.size(); ++moveIndex)
                boundSources[moveIndex - 1u] = boundSources[moveIndex];
            boundSources.pop_back();
        }
        else
            resolved.repeat = true;
    }
    else if(resolved.type == InputEventType::CommandDown){
        if(boundSources.size() == s_InputMaxSources)
            return makeUnexpected(Failure());
        if(physical){
            const i32 modifiers = BuildInputEventModifierMask(event);
            const InputCommandIntent intent = ResolveInputKeyBinding(
                keyBindings,
                event.key,
                modifiers,
                IsValidInputKeyCode(event.key),
                s_InputBindingModifierMask,
                s_InputLockModifierMask,
                s_InputModifierShift
            );
            resolved.command = intent.command;
            resolved.extend = intent.extend;
            resolved.edit = intent.edit;
            resolved.allowText = intent.allowText;
        }
        BoundSource bound;
        bound.source = resolved.source;
        bound.intent.command = resolved.command;
        bound.intent.extend = resolved.extend;
        bound.intent.edit = resolved.edit;
        bound.intent.allowText = resolved.allowText;
        boundSources.push_back(bound);
    }
    else{
        resolved.command = InputCommand::None;
        resolved.extend = false;
        resolved.edit = false;
        resolved.allowText = false;
    }
    if(resolved.type == InputEventType::CommandUp)
        resolved.repeat = false;
    return resolved;
}

b8 IsRouterTargetPressedByCommand(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in Span<CommandSource> commandSources,
    in b8 windowFocused,
    in WidgetId focus,
    in u64 focusDeclaration,
    in WidgetId id
){
    for(in CommandSource source : commandSources){
        if(source.submitArmed && source.focusOwner.target == id && IsCurrentRouterCommandFocus(targets, lookup, popups, windowFocused, focus, focusDeclaration, source))
            return true;
    }
    return false;
}

void ReleaseRouterCommand(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in b8 windowFocused,
    in WidgetId focus,
    in u64 focusDeclaration,
    in u64 layoutGeneration,
    in InputEvent event,
    in CommandSource source,
    mut Vector<InputAction> actions,
    mut Vector<ControlAction> controlActions,
    mut Vector<ContextMenuAction> contextMenuActions,
    mut u64 inOutNextActionSequence,
    mut InputRoutingResult inOutResult
){
    if(!IsCurrentRouterCommandFocus(targets, lookup, popups, windowFocused, focus, focusDeclaration, source))
        return;
    if(source.contextArmed && event.command == InputCommand::ContextMenu && IsCurrentRouterContextMenuOwner(targets, lookup, popups, windowFocused, source.focusOwner)){
        const Expected<usize> targetIndex = FindTargetIndexInTable(targets, lookup, source.focusOwner.target, source.focusOwner.declarationGeneration);
        if(targetIndex.has_value())
            AppendRouterContextMenu(targets[targetIndex.value()], layoutGeneration, source.contextPosition, InputActionSource::Command, event.source, contextMenuActions, inOutNextActionSequence, inOutResult);
        return;
    }
    if(!source.submitArmed || (event.command != InputCommand::Accept && event.command != InputCommand::Submit && event.command != InputCommand::Activate))
        return;
    const Expected<usize> focusedIndex = FindTargetIndexInTable(targets, lookup, source.focusOwner.target, source.focusOwner.declarationGeneration);
    if(!focusedIndex.has_value())
        return;
    const HitTarget focused = targets[focusedIndex.value()];
    if(source.controlOwner.host.valid()){
        if(IsCurrentRouterControlCommandOwner(targets, lookup, popups, source)){
            const Expected<usize> hostIndex = FindTargetIndexInTable(targets, lookup, source.controlOwner.host, source.controlOwner.declarationGeneration);
            if(hostIndex.has_value())
                AppendRouterControlAction(targets[hostIndex.value()], focused, layoutGeneration, ControlActionKind::Submit, 0.0, 0.0, controlActions, inOutNextActionSequence, inOutResult);
        }
    }
    else if(focused.activatable)
        AppendRouterActivation(focused, layoutGeneration, InputActionSource::Command, event.source, actions, inOutNextActionSequence, inOutResult);
}

void RouteRouterActiveCommandAction(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in InputEvent event,
    in b8 hasFocused,
    in HitTarget focused,
    in b8 alreadyPressed,
    in u64 layoutGeneration,
    mut CommandSource inOutSource,
    mut Vector<ControlAction> controlActions,
    mut u64 inOutNextActionSequence,
    mut InputRoutingResult inOutResult
){
    if(!hasFocused)
        return;
    const b8 delegatedCommand = event.command == InputCommand::Up || event.command == InputCommand::Down
        || event.command == InputCommand::PageUp || event.command == InputCommand::PageDown
        || event.command == InputCommand::Accept || event.command == InputCommand::Submit;
    b8 hasCommandOwner = false;
    HitTarget control = focused;
    if(delegatedCommand){
        const Expected<usize> commandOwnerIndex = TryResolveRouterCommandHostIndex(targets, lookup, popups, focused);
        if(commandOwnerIndex.has_value()){
            hasCommandOwner = true;
            control = targets[commandOwnerIndex.value()];
        }
    }
    const b8 submitCommand = event.command == InputCommand::Accept || event.command == InputCommand::Submit || event.command == InputCommand::Activate;
    b8 controlHandled = false;
    if(control.navigable){
        if(submitCommand){
            controlHandled = true;
            if(!event.repeat && !alreadyPressed)
                inOutSource.controlOwner = ControlCommandOwner(control.id, control.declarationGeneration, control.popup, control.control, false);
        }
        else
            controlHandled = TryRouteRouterControlNavigation(event, control, focused, alreadyPressed, layoutGeneration, inOutSource, controlActions, inOutNextActionSequence, inOutResult);
    }
    if(controlHandled && hasCommandOwner)
        inOutSource.delegated = true;
    if(submitCommand && !event.repeat && !alreadyPressed && (controlHandled || focused.activatable || focused.textEditable))
        inOutSource.submitArmed = true;
}

b8 OwnsRouterCommandSource(
    in Span<CommandSource> commandSources,
    in InputSource source
){
    const Expected<usize> found = FindRouterCommandSourceIndex(commandSources, source);
    return found.has_value() && commandSources[found.value()].consumed;
}

b8 WantsRouterCommands(in Span<PopupRecord> popups, in WidgetId focus, in Span<CommandSource> commandSources){
    if(!popups.empty() || focus.valid())
        return true;
    for(in CommandSource source : commandSources){
        if(source.consumed)
            return true;
    }
    return false;
}

void RouteRouterCommand(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in b8 windowFocused,
    in u64 layoutGeneration,
    in InputEvent event,
    in b8 pointerSequenceConsumed,
    in b8 secondarySequenceConsumed,
    in Span<PointerSource> pointerSources,
    mut Vector<PopupRecord> popups,
    mut Vector<PopupDismissal> popupDismissals,
    mut Vector<CommandSource> commandSources,
    mut Vector<InputAction> actions,
    mut Vector<ControlAction> controlActions,
    mut Vector<ContextMenuAction> contextMenuActions,
    mut Vector<PointerGestureRecord> pointerGestures,
    mut u64 inOutActiveGestureSequence,
    mut u64 inOutNextActionSequence,
    mut b8 inOutPointerSubmitArmed,
    mut TargetOwner inOutSecondaryOwner,
    mut WidgetId inOutHover,
    mut WidgetId inOutFocus,
    mut u64 inOutFocusDeclaration,
    mut ControlToken inOutFocusControl,
    mut WidgetId inOutCapture,
    mut PopupToken inOutCapturePopup,
    mut u64 inOutCaptureDeclaration,
    mut ControlToken inOutCaptureControl,
    mut InputRoutingResult inOutResult,
    mut b8 outDismissedPopup
){
    outDismissedPopup = false;
    const Expected<usize> existingSourceIndex = FindRouterCommandSourceIndex(commandSources, event.source);
    if(event.type == InputEventType::CommandUp){
        if(existingSourceIndex.has_value()){
            const usize foundIndex = existingSourceIndex.value();
            const CommandSource held = commandSources[foundIndex];
            inOutResult.commandConsumed = inOutResult.commandConsumed || held.consumed;
            ReleaseRouterCommand(
                targets,
                lookup,
                popups,
                windowFocused,
                inOutFocus,
                inOutFocusDeclaration,
                layoutGeneration,
                event,
                held,
                actions,
                controlActions,
                contextMenuActions,
                inOutNextActionSequence,
                inOutResult
            );
            for(usize moveIndex = foundIndex + 1u; moveIndex < commandSources.size(); ++moveIndex)
                commandSources[moveIndex - 1u] = commandSources[moveIndex];
            commandSources.pop_back();
        }
        return;
    }
    const b8 alreadyPressed = existingSourceIndex.has_value();
    usize sourceIndex = 0u;
    if(alreadyPressed)
        sourceIndex = existingSourceIndex.value();
    else{
        if(commandSources.size() == s_InputMaxSources){
            inOutResult.activationOverflow = true;
            return;
        }
        CommandSource admitted;
        admitted.source = event.source;
        const Expected<usize> focusedIndex = FindTargetIndexInTable(targets, lookup, inOutFocus, inOutFocusDeclaration);
        if(windowFocused && !event.repeat && focusedIndex.has_value()){
            const HitTarget focused = targets[focusedIndex.value()];
            if(IsRouterTargetInteractive(targets, lookup, popups, focused))
                admitted.focusOwner = TargetOwner(focused.id, focused.declarationGeneration, focused.popup, focused.control);
        }
        commandSources.push_back(admitted);
        sourceIndex = commandSources.size() - 1u;
    }
    CommandSource source = commandSources[sourceIndex];
    // Blurred and orphan repeat sequences remain inert until released and pressed again.
    inOutResult.commandConsumed = inOutResult.commandConsumed || source.consumed;
    if(!windowFocused || (!alreadyPressed && event.repeat))
        return;
    b8 consumed = source.consumed;
    if(alreadyPressed && !consumed)
        return;
    const Expected<usize> focusedIndex = FindTargetIndexInTable(targets, lookup, inOutFocus, inOutFocusDeclaration);
    b8 hasFocused = false;
    HitTarget focused;
    if(focusedIndex.has_value()){
        hasFocused = true;
        focused = targets[focusedIndex.value()];
    }
    if(hasFocused && windowFocused && IsRouterTargetInteractive(targets, lookup, popups, focused) && TryRouteRouterContextMenuCommand(event, focused, alreadyPressed, source)){
        commandSources[sourceIndex] = source;
        consumed = true;
    }
    else if(event.command == InputCommand::FocusNext || event.command == InputCommand::FocusPrevious){
        const b8 moved = TryMoveRouterFocusForTraversal(
            targets,
            lookup,
            event.command == InputCommand::FocusPrevious,
            popups,
            popupDismissals,
            commandSources,
            inOutFocus,
            inOutFocusDeclaration,
            inOutFocusControl,
            outDismissedPopup
        );
        source = commandSources[sourceIndex];
        consumed = consumed || moved || !popups.empty();
    }
    else if(event.command == InputCommand::Cancel){
        consumed = consumed
            || WantsRouterCommands(popups, inOutFocus, commandSources)
            || inOutCapture.valid()
            || pointerSequenceConsumed
            || secondarySequenceConsumed
            || (!pointerSources.empty() && WantsRouterPointer(pointerSources, !popups.empty(), inOutHover));
        if(!event.repeat && !alreadyPressed){
            CancelRouterCommandPresses(commandSources);
            CancelRouterPointerPress(
                pointerGestures,
                inOutActiveGestureSequence,
                inOutPointerSubmitArmed,
                inOutSecondaryOwner,
                inOutCapture,
                inOutCapturePopup,
                inOutCaptureDeclaration,
                inOutCaptureControl
            );
            source = commandSources[sourceIndex];
        }
        if(!popups.empty() && !(hasFocused && focused.textEditable)){
            outDismissedPopup = !event.repeat && !alreadyPressed && TryDismissRouterPopup(PopupDismissReason::Cancel, popups, popupDismissals);
            consumed = true;
        }
        else if(!event.repeat && !alreadyPressed && !(hasFocused && focused.textEditable)){
            RetireRouterCommandFocus(commandSources);
            inOutFocus = WidgetId();
            inOutFocusDeclaration = 0u;
            inOutFocusControl = ControlToken();
            source = commandSources[sourceIndex];
        }
    }
    else{
        consumed = consumed || !popups.empty() || hasFocused;
        RouteRouterActiveCommandAction(
            targets,
            lookup,
            popups,
            event,
            hasFocused,
            focused,
            alreadyPressed,
            layoutGeneration,
            source,
            controlActions,
            inOutNextActionSequence,
            inOutResult
        );
        commandSources[sourceIndex] = source;
    }
    if(consumed){
        source.consumed = true;
        commandSources[sourceIndex] = source;
        inOutResult.commandConsumed = true;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
