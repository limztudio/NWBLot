using namespace NWB;
using namespace NWB::Impl::Ui;
using namespace NWB::UiSearchComboTests;

constexpr AStringView s_ListKey = "list";
constexpr AStringView s_AnchorKey = "anchor";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class NestedMutationSource final : public ComboSource{
public:
    explicit NestedMutationSource(const u64 instance)noexcept{
        generation = instance;
        count = 5u;
    }


public:
    [[nodiscard]] virtual u64 instanceGeneration()const noexcept override{ ++metadataCalls; return generation; }

    [[nodiscard]] virtual u64 revision()const noexcept override{
        ++metadataCalls;
        if(selectListOnRevision){
            ListState& state = *MakeNotNull(Exchange(selectListOnRevision, nullptr));
            state.select(4u);
        }
        return contentRevision;
    }

    [[nodiscard]] virtual u64 rowCount()const noexcept override{ ++metadataCalls; return count; }

    [[nodiscard]] virtual StringView text(const u64 index)const override{
        const StringView value = ComboSource::text(index);
        if(closePopupOnText){
            PopupState& state = *MakeNotNull(Exchange(closePopupOnText, nullptr));
            state.close();
        }
        if(reopenPopupOnText){
            PopupState& state = *MakeNotNull(Exchange(reopenPopupOnText, nullptr));
            state.close();
            state.open();
        }
        if(selectListOnText){
            ListState& state = *MakeNotNull(Exchange(selectListOnText, nullptr));
            state.select(4u);
        }
        if(selectComboOnText){
            ComboState& state = *MakeNotNull(Exchange(selectComboOnText, nullptr));
            state.select(4u);
        }
        if(closeMenuOnText){
            ContextMenuState& state = *MakeNotNull(Exchange(closeMenuOnText, nullptr));
            state.close();
        }
        if(queryOnText){
            EditModel& query = *MakeNotNull(Exchange(queryOnText, nullptr));
            if(!query.setText(s_CallbackQuery))
                ADD_FAILURE() << "query callback failed";
        }
        if(armSourceOnText){
            NestedMutationSource& source = *MakeNotNull(Exchange(armSourceOnText, nullptr));
            source.selectListOnRevision = armList;
        }
        return value;
    }

    void resetAllCounters()const noexcept{ resetCounters(); metadataCalls = 0u; }


public:
    mutable u64 metadataCalls = 0u;
    mutable PopupState* closePopupOnText = nullptr;
    mutable PopupState* reopenPopupOnText = nullptr;
    mutable ListState* selectListOnText = nullptr;
    mutable ListState* selectListOnRevision = nullptr;
    mutable ComboState* selectComboOnText = nullptr;
    mutable ContextMenuState* closeMenuOnText = nullptr;
    mutable EditModel* queryOnText = nullptr;
    mutable NestedMutationSource* armSourceOnText = nullptr;
    ListState* armList = nullptr;
};

class NestedSearchSource final : public ISearchableListDataSource{
public:
    explicit NestedSearchSource(Core::Alloc::GlobalArena& arena)noexcept
        : m_query(arena)
    {}


public:
    [[nodiscard]] virtual u64 instanceGeneration()const noexcept override{ return full.instanceGeneration(); }

    [[nodiscard]] virtual u64 revision()const noexcept override{ return full.revision(); }

    [[nodiscard]] virtual u64 rowCount()const noexcept override{ return full.rowCount(); }

    [[nodiscard]] virtual u64 key(const u64 index)const noexcept override{ return full.key(index); }

    [[nodiscard]] virtual Expected<u64> indexOf(const u64 key)const noexcept override{ return full.indexOf(key); }

    [[nodiscard]] virtual Expected<u64> findEnabled(const u64 start, const b8 reverse)const noexcept override{
        return full.findEnabled(start, reverse);
    }

    [[nodiscard]] virtual StringView text(const u64 index)const override{ return full.text(index); }

    [[nodiscard]] virtual b8 enabled(const u64 index)const noexcept override{ return full.enabled(index); }

    [[nodiscard]] virtual b8 filter(const AStringView query)override{
        ++filterCalls;
        const AStringView previous{ m_query.data(), m_query.size() };
        if(previous != query){
            m_query.assign(query.data(), query.size());
            ++view.contentRevision;
        }
        view.count = query.empty() ? full.count : 0u;
        return true;
    }

    [[nodiscard]] virtual const IListDataSource& filtered()const noexcept override{ ++filteredCalls; return view; }


public:
    NestedMutationSource full{ 2201u };
    NestedMutationSource view{ 2202u };
    u64 filterCalls = 0u;
    mutable u64 filteredCalls = 0u;


private:
    AString<Core::Alloc::GlobalArena> m_query;
};


