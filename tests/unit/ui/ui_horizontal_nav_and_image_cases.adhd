void VerifyUiImageSourceTests_RejectsPayloadLengthAndAlphaTransportMismatches(mut UiImageSourceTests self){
    for(u32 variant = 0u; variant < 6u; ++variant){
        const ScopedTestTrace trace = ScopedTestTrace(variant);
        Texture texture = Texture(self.m_inputArena, s_UiCaseTestsUiImageInvalidTransport);
        ASSERT_TRUE(self.prepareDefault(self.m_inputArena, texture));
        self.installTransportVariant(texture, variant);
        EXPECT_FALSE(MakeImageSource(self.m_sourceArena, texture).has_value());
    }
}

void VerifyUiImageSourceTests_RejectedSamePathReplacementPreservesPreviouslyAcceptedOwnedVersion(mut UiImageSourceTests self){
    Texture texture = Texture(self.m_inputArena, s_UiCaseTestsUiImageReplace);
    ASSERT_TRUE(self.prepareDefault(self.m_inputArena, texture));
    const Expected<SharedImageSource> acceptedResult = MakeImageSource(self.m_sourceArena, texture);
    ASSERT_TRUE(acceptedResult.has_value());
    const SharedImageSource accepted = acceptedResult.value();
    ASSERT_TRUE(UiImageHandlePresent(accepted));
    const u64 generation = UiReadImageGeneration(accepted);
    self.installTransportVariant(texture, 0u);
    EXPECT_FALSE(MakeImageSource(self.m_sourceArena, texture).has_value());
    EXPECT_EQ(UiReadImageGeneration(accepted), generation);
    EXPECT_EQ(UiReadImageIdentity(accepted).name(), texture.virtualPath());
    ASSERT_EQ(UiReadImageTexture(accepted).payloadBytes().size(), 144u);
    EXPECT_EQ(UiReadImageTexture(accepted).payloadBytes()[143u], cast<u8>(37u + 143u * 17u));
    UiImageSourceTextureDescription replacement = UiImageSourceTextureDescription();
    replacement.seed = 73u;
    ASSERT_TRUE(self.prepareCustom(self.m_inputArena, texture, replacement));
    const Expected<SharedImageSource> nextResult = MakeImageSource(self.m_sourceArena, texture);
    ASSERT_TRUE(nextResult.has_value());
    const SharedImageSource next = nextResult.value();
    ASSERT_TRUE(UiImageHandlePresent(next));
    EXPECT_NE(UiReadImageGeneration(next), generation);
    EXPECT_EQ(UiReadImageTexture(next).payloadBytes()[0u], 73u);
    EXPECT_EQ(UiReadImageTexture(accepted).payloadBytes()[0u], 37u);
}


