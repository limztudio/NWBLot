    ASSERT_NO_FATAL_FAILURE(__hidden_task_graph_ownership_statistics_tests::CheckOwnershipStatistics(3u));
    ASSERT_NO_FATAL_FAILURE(__hidden_task_graph_ownership_statistics_tests::CheckOwnershipStatistics(17u));
}


