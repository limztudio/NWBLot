}

void VerifyUiEditModelTests_WordRangeRejectsInteriorGraphemeAndKeepsHardLinesSeparate(mut UiEditModelTests self){
    const Expected<EditWordRange> empty = self.m_model.wordRangeAt(0u);
    ASSERT_TRUE(empty.has_value());
    EXPECT_EQ(empty.value().begin, 0u);
    EXPECT_EQ(empty.value().end, 0u);
    ASSERT_TRUE(self.m_model.setText("a\314\201b,  z"));
    EXPECT_FALSE(self.m_model.wordRangeAt(1u).has_value());
    Expected<EditWordRange> range = self.m_model.wordRangeAt(3u);
    ASSERT_TRUE(range.has_value());
    EXPECT_EQ(range.value().begin, 0u);
    EXPECT_EQ(range.value().end, 4u);
    EditModel multiline = EditModel(self.m_arena, EditLimits(), EditTextMode::Multiline);
    ASSERT_TRUE(multiline.setText("ab\ncd"));
    range = multiline.wordRangeAt(2u);
    ASSERT_TRUE(range.has_value());
    EXPECT_EQ(range.value().begin, 2u);
    EXPECT_EQ(range.value().end, 3u);
    range = multiline.wordRangeAt(3u);
    ASSERT_TRUE(range.has_value());
    EXPECT_EQ(range.value().begin, 3u);
    EXPECT_EQ(range.value().end, 5u);
}

void VerifyUiEditModelTests_ExternalValueResetsSelectionHistoryAndComposition(mut UiEditModelTests self){
