////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_BVH_RAY_INTERSECT_SLANGI
#define NWB_GRAPHICS_BVH_RAY_INTERSECT_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "bvh_common.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static const float NWB_BVH_RAY_DIRECTION_EPSILON = 1e-8;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


bool nwbBvhRayConservativeAabb(const float3 origin, const float3 direction, const float minimum, const float maximum, const float3 boxMin, const float3 boxMax, out float entry){
    entry = minimum;
    float farDistance = maximum;
    if(!all(isfinite(origin)) || !all(isfinite(direction)) || !all(isfinite(boxMin)) || !all(isfinite(boxMax)) || any(boxMin > boxMax))
        return true;
    [unroll] for(uint axis = 0u; axis < 3u; ++axis){
        const float error = 0.00000095367431640625 * (max(abs(boxMin[axis]), abs(boxMax[axis])) + abs(origin[axis])) + asfloat(0x00800000u);
        if(direction[axis] == 0.0){
            if(origin[axis] < boxMin[axis] - error || origin[axis] > boxMax[axis] + error)
                return false;
        }
        else{
            const float first = (boxMin[axis] - origin[axis]) / direction[axis];
            const float second = (boxMax[axis] - origin[axis]) / direction[axis];
            const float uncertainty = error / abs(direction[axis]) + 0.00000095367431640625 * max(abs(first), abs(second));
            if(!isfinite(first) || !isfinite(second) || !isfinite(uncertainty))
                continue;
            entry = max(entry, min(first, second) - uncertainty);
            farDistance = min(farDistance, max(first, second) + uncertainty);
        }
    }
    return entry <= farDistance;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


float3 nwbBvhSafeInvDir(const float3 direction){
    const float epsilon = NWB_BVH_RAY_DIRECTION_EPSILON;
    const float3 safe = float3(
        abs(direction.x) > epsilon ? direction.x : (direction.x < 0.0 ? -epsilon : epsilon),
        abs(direction.y) > epsilon ? direction.y : (direction.y < 0.0 ? -epsilon : epsilon),
        abs(direction.z) > epsilon ? direction.z : (direction.z < 0.0 ? -epsilon : epsilon)
    );
    return 1.0 / safe;
}

bool nwbBvhRayAabbIntervalPaddedFma(const float3 invDir, const float3 minBias, const float3 maxBias, const float tMin, const float tMax, const float3 boxMin, const float3 boxMax, out float outTEntry){
    const float3 t0 = fma(boxMin, invDir, minBias);
    const float3 t1 = fma(boxMax, invDir, maxBias);
    const float3 tSmall = min(t0, t1);
    const float3 tLarge = max(t0, t1);
    const float tNear = max(max(tSmall.x, tSmall.y), max(tSmall.z, tMin));
    const float tFar = min(min(tLarge.x, tLarge.y), min(tLarge.z, tMax));
    outTEntry = tNear;
    return tNear <= tFar;
}

bool nwbBvhRayAabbIntervalFma(const float3 invDir, const float3 negOriginInvDir, const float tMin, const float tMax, const float3 boxMin, const float3 boxMax, out float outTEntry){
    return nwbBvhRayAabbIntervalPaddedFma(invDir, negOriginInvDir, negOriginInvDir, tMin, tMax, boxMin, boxMax, outTEntry);
}

bool nwbBvhRayAabbInterval(const float3 origin, const float3 invDir, const float tMin, const float tMax, const float3 boxMin, const float3 boxMax, const float padding, out float outTEntry){
    const float3 minBias = (-padding - origin) * invDir;
    const float3 maxBias = (padding - origin) * invDir;
    return nwbBvhRayAabbIntervalPaddedFma(invDir, minBias, maxBias, tMin, tMax, boxMin, boxMax, outTEntry);
}

bool nwbBvhRayAabb(const float3 origin, const float3 invDir, const float tMin, const float tMax, const float3 boxMin, const float3 boxMax, const float padding){
    float unusedTEntry;
    return nwbBvhRayAabbInterval(origin, invDir, tMin, tMax, boxMin, boxMax, padding, unusedTEntry);
}

bool nwbBvhRayAabbT(const float3 origin, const float3 invDir, const float tMin, const float tMax, const float3 boxMin, const float3 boxMax, const float padding, out float tEntry){
    return nwbBvhRayAabbInterval(origin, invDir, tMin, tMax, boxMin, boxMax, padding, tEntry);
}

bool nwbBvhPickNearChildFma(
    const float3 invDir,
    const float3 negOriginInvDir,
    const float tMin,
    const float tMax,
    const NwbBvhNode node,
    const NwbBvhNode leftNode,
    const uint rightChildIndex,
    const NwbBvhNode rightNode,
    out NwbBvhNode descendNode,
    out uint farChildIndex,
    out float farEntryT,
    out bool bothHit
){
    float tLeft;
    const bool hitLeft = nwbBvhRayAabbIntervalFma(invDir, negOriginInvDir, tMin, tMax, leftNode.aabbMin, leftNode.aabbMax, tLeft);
    float tRight;
    const bool hitRight = nwbBvhRayAabbIntervalFma(invDir, negOriginInvDir, tMin, tMax, rightNode.aabbMin, rightNode.aabbMax, tRight);
    bothHit = hitLeft && hitRight;
    farEntryT = 0.0;
    if(bothHit){
        if(tLeft <= tRight){
            descendNode = leftNode;
            farChildIndex = rightChildIndex;
            farEntryT = tRight;
        }
        else{
            descendNode = rightNode;
            farChildIndex = node.leftChild;
            farEntryT = tLeft;
        }
        return true;
    }
    if(hitLeft){
        descendNode = leftNode;
        farChildIndex = node.leftChild;
        return true;
    }
    if(hitRight){
        descendNode = rightNode;
        farChildIndex = rightChildIndex;
        return true;
    }
    descendNode = (NwbBvhNode)0;
    farChildIndex = 0u;
    return false;
}

bool nwbBvhPickNearChild(
    const float3 origin,
    const float3 invDir,
    const float tMin,
    const float tMax,
    const NwbBvhNode node,
    const NwbBvhNode leftNode,
    const uint rightChildIndex,
    const NwbBvhNode rightNode,
    out NwbBvhNode descendNode,
    out uint farChildIndex,
    out bool bothHit
){
    const float3 negOriginInvDir = -origin * invDir;
    float unusedFarEntryT;
    return nwbBvhPickNearChildFma(invDir, negOriginInvDir, tMin, tMax, node, leftNode, rightChildIndex, rightNode, descendNode, farChildIndex, unusedFarEntryT, bothHit);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


