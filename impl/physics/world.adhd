        this.m_joints[jointId.index].setLocalAnchorB(localAnchorB);
        this.resetJointWarmStartAndWake(jointId.index);
        return true;
    }

    public b8 setJointLocalAxisA(in JointId jointId, in VectorSingle localAxisA){
        if(!this.isValidJoint(jointId) || !IsFinite(localAxisA.xyz))
            return false;
        if(Vector3LengthSq(VectorSingle(localAxisA, 0.0f)).x <= s_NormalizeEpsilonSq)
            return false;
        this.m_joints[jointId.index].setLocalAxisA(SafeNormalizeVec3(localAxisA, VectorSingle(0.0f, 1.0f, 0.0f, 0.0f)));
        this.resetJointWarmStartAndWake(jointId.index);
        return true;
    }

    public b8 setJointLocalAxisB(in JointId jointId, in VectorSingle localAxisB){
        if(!this.isValidJoint(jointId) || !IsFinite(localAxisB.xyz))
            return false;
        if(Vector3LengthSq(VectorSingle(localAxisB, 0.0f)).x <= s_NormalizeEpsilonSq)
            return false;
        this.m_joints[jointId.index].setLocalAxisB(SafeNormalizeVec3(localAxisB, VectorSingle(0.0f, 1.0f, 0.0f, 0.0f)));
