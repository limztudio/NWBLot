inline void UiResetImageHandle(SharedImageSource&& image)noexcept{ image.reset(); }
[[nodiscard]] inline ::NWB::Core::Assets::AssetRef<Texture> UiReadImageIdentity(const SharedImageSource& image)noexcept{ return image->identity(); }
[[nodiscard]] inline u64 UiReadImageGeneration(const SharedImageSource& image)noexcept{ return image->generation(); }
[[nodiscard]] inline const Texture& UiReadImageTexture(const SharedImageSource& image)noexcept{ return image->texture(); }
[[nodiscard]] inline b8 UiSameImageHandlePtr(const SharedImageSource& lhs, const SharedImageSource& rhs)noexcept{ return lhs.get() == rhs.get(); }
[[nodiscard]] inline b8 UiSameTextureAddress(const SharedImageSource& lhs, const SharedImageSource& rhs)noexcept{ return &lhs->texture() == &rhs->texture(); }
[[nodiscard]] inline b8 UiDistinctLoadedTextureStorage(const SharedImageSource& lhs, const SharedImageSource& rhs)noexcept{
    return lhs->texture().payloadBytes().data() != rhs->texture().payloadBytes().data()
        && lhs->texture().mipLevels().data() != rhs->texture().mipLevels().data();
}
inline void UiImageLoaderExpectPayload(const SharedImageSource& image, const u8 initialValue){
    __hidden_ui_image_loader_tests::ExpectPayload(image->texture(), initialValue);
}
inline void UiImageSourceExpectCopy(const Texture& original, const SharedImageSource& copied){
    __hidden_ui_image_source_tests::UiImageSourceTests::ExpectCopy(original, copied->texture());
}

[[nodiscard]] inline HitTarget MakeUiHorizontalNavPart(const HitTarget& host)noexcept{
    return ::NWB::UiHorizontalNavigationTests::Part(host);
}
[[nodiscard]] inline PopupScope MakeUiHorizontalNavPopup(const HitTarget& owner, const u64 openGeneration = 7u)noexcept{
    return ::NWB::UiHorizontalNavigationTests::Popup(owner, openGeneration);
}
[[nodiscard]] inline ImageOptions MakeUiImageBuilderFixedOptions(const f32 width = 96.0f, const f32 height = 40.0f)noexcept{
    return ::NWB::UiWidgetTests::WidgetFixture::Fixed(width, height);
}
[[nodiscard]] inline f32 UiHorizImageInfinityF32()noexcept{ return ::Limit<f32>::s_Infinity; }
[[nodiscard]] inline f32 UiHorizImageQuietNaNF32()noexcept{ return ::Limit<f32>::s_QuietNaN; }
[[nodiscard]] inline ::NWB::Impl::Ui::LayoutSizePolicy::Enum MakeUiInvalidLayoutSizePolicy()noexcept{
    return static_cast<::NWB::Impl::Ui::LayoutSizePolicy::Enum>(3u);
}
[[nodiscard]] inline ::NWB::Impl::UiSkinDrawMode::Enum MakeUiInvalidSkinDrawMode()noexcept{
    return static_cast<::NWB::Impl::UiSkinDrawMode::Enum>(2u);
}
[[nodiscard]] inline ::NWB::Core::Assets::AssetRef<Texture> MakeUiMissingTextureAssetRef()noexcept{
    return ::NWB::Core::Assets::AssetRef<Texture>("tests/ui/image_loader/missing");
}
};
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_UiGpuVersionedImagePath = "tests/ui/versioned_gpu_image";
const StringView s_UiGpuOverflowImagePath = "tests/ui/overflow_gpu_image";
const Name s_UiImageBuilderSpriteRegionName = "image.sprite";
const StringView s_UiImageBuilderPanelKey = "panel";
const StringView s_UiImageBuilderBeforeKey = "before";
const Name s_UiImageSourceTempExpectedName = "tests/ui/image/temporary";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Rect MakeUiHorizImageRect(in f32 x, in f32 y, in f32 width, in f32 height){
    Rect rect = Rect();
    rect.x = x;
    rect.y = y;
    rect.width = width;
    rect.height = height;
    return rect;
}

Color MakeUiHorizImageColor(in f32 r, in f32 g, in f32 b, in f32 a){
    Color color = Color();
    color.r = r;
    color.g = g;
    color.b = b;
    color.a = a;
    return color;
}

Array<PopupScope, 1u> MakeUiHorizNavSinglePopup(in PopupScope popup){
    Array<PopupScope, 1u> popups = Array<PopupScope, 1u>();
    popups[0u] = popup;
    return popups;
}

UiSkinRegion MakeUiImageLayoutSprite(){
    UiSkinRegion region = UiSkinRegion();
    region.name = s_UiCaseImageTest;
    region.rectangle.x = 10u;
    region.rectangle.y = 20u;
    region.rectangle.width = 200u;
    region.rectangle.height = 100u;
    return region;
}

void ExpectUiImageLayoutMetrics(in ImageMetrics actual, in f32 expectedWidth, in f32 expectedHeight){
    EXPECT_EQ(bit_cast<u32>(actual.contentSize.x), bit_cast<u32>(expectedWidth));
    EXPECT_EQ(bit_cast<u32>(actual.contentSize.y), bit_cast<u32>(expectedHeight));
}


