void VerifyEcsGraphics_IndexedNamesPreserveMaximumIndices(){
    native{
        const usize index = Limit<usize>::s_Max;
        const auto draw = NWB::Impl::FormatRefractionCaptureDrawIdentity(index);
        const auto decode = NWB::Impl::FormatObjectGeometryDecodeIdentity(index);
        const auto ready = NWB::Impl::FormatObjectGeometryReadyIdentity(index);
        const auto queue = NWB::Impl::FormatCsgQueueReadCompleteIdentity(Limit<u32>::s_Max);
        const auto idle = NWB::Impl::ResolveDeferredGraphQueueInternalIdleScope(true, Limit<u32>::s_Max);
        ASSERT_TRUE(draw && decode && ready && queue && idle && *idle);
        const auto drawExpected = Name::FromText(AStringView(sizeof(usize) == 8u ? "render.refraction.capture.draw_18446744073709551615" : "render.refraction.capture.draw_4294967295"));
        const auto decodeExpected = Name::FromText(AStringView(sizeof(usize) == 8u ? "render.object_geometry.decode_18446744073709551615" : "render.object_geometry.decode_4294967295"));
        const auto readyExpected = Name::FromText(AStringView(sizeof(usize) == 8u ? "render.object_geometry.ready_18446744073709551615" : "render.object_geometry.ready_4294967295"));
        const auto queueExpected = Name::FromText(AStringView("render.raytrace.csg_queue_4294967295.read_complete"));
        const auto idleExpected = Name::FromText(AStringView("render.deferred_graph.queue_4294967295.internal_idle"));
        ASSERT_TRUE(drawExpected && decodeExpected && readyExpected && queueExpected && idleExpected);
        EXPECT_EQ(*draw, *drawExpected);
        EXPECT_EQ(*decode, *decodeExpected);
        EXPECT_EQ(*ready, *readyExpected);
        EXPECT_EQ(*queue, *queueExpected);
        EXPECT_EQ(**idle, *idleExpected);
    }
}


