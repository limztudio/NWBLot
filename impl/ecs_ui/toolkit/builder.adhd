    private void invalidateStyleMetricsCache(){
        this.m_metricsCacheSkinVersion = 0u;
        this.m_buttonMetricsCached = false;
        this.m_checkboxExtentCached = false;
        this.m_selectableMetricsCached = false;
        this.m_editMinSizeCached = false;
        this.m_editPaddingCached = false;
    }

    private void syncMetricsCacheSkinVersion(){
        if(!this.m_skin.has_value()){
            this.invalidateStyleMetricsCache();
            return;
        }
        const u64 version = this.m_skin.value().regionVersion();
        if(this.m_metricsCacheSkinVersion != version){
            this.invalidateStyleMetricsCache();
            this.m_metricsCacheSkinVersion = version;
        }
    }

