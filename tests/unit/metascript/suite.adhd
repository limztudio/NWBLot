void VerifyAdhdCompiler_CompilesModularClassEdgeCases(){
    AdhdTestArena arena = AdhdTestArena();
    ExpectCompileFails(arena, "class PlainMissing {\r\n    public void step();\r\n}\r\n", "impl/bad_plain_bodyless.adhd");
    ExpectCompileFails(arena, "[modular]\r\nclass BadTmpl<T> {\r\n    public T item;\r\n}\r\n", "impl/bad_modular_tmpl.adhd");
    ExpectCompileFails(arena, "[arena, modular, subsystem(\"bad\")]\r\nclass BadSub {\r\n}\r\n", "impl/bad_modular_sub.adhd");
    ExpectCompileFails(arena, "[modular]\r\nclass BadMethodTmpl {\r\n    public void act<T>(in T val);\r\n}\r\n", "impl/bad_modular_method_tmpl.adhd");
    RunModularClassEdgeCases();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Optional<in T> FindAstDeclaration<T>(in AstPointerList<T> declarations, in StringView name){
    for(usize index = 0u; index < declarations.size(); ++index){
        const auto entry = BorrowAstNode(declarations, index);
        if(entry.has_value() && entry.value().name == name)
            return entry;
    }
    return Optional<in T>();
}

void RunModularClassEdgeCases(){
    AdhdTestArena arena;
    MockIncludeResolver resolver;
    const StringView kModularDeclSource =
        "class RefTarget {\r\n    public u32 value = 0u;\r\n}\r\n[modular]\r\nclass ModularBox : NoCopy {\r\n    private mut RefTarget m_target;\r\n    private Vector<u32> m_items;\r\n    public ModularBox(mut RefTarget target, in u32 seed);\r\n    public u32 read()const;\r\n    public void append(in u32 val);\r\n}\r\n";
    CompileResult declRes(arena.arena);
    ASSERT_TRUE(CompileWithResolver(kModularDeclSource, "impl/modular_box.adhd", resolver, arena.arena, declRes));
    EXPECT_NE(declRes.generatedHeader.find("m_items{(*this->__adhd_arena)};"), usize.max);
    EXPECT_NE(declRes.generatedHeader.find("u32 read()const"), usize.max);
    EXPECT_EQ(declRes.generatedSource.find("ModularBox::read"), usize.max);

    const StringView kModularImplSource =
        "#include \"impl/modular_box.adhd\"\r\nModularBox::ModularBox(mut RefTarget target, in u32 seed){\r\n    this.m_target = target;\r\n    this.m_items.push_back(seed);\r\n}\r\nu32 ModularBox::read()const{\r\n    return this.m_target.value + u32(this.m_items.size());\r\n}\r\nvoid ModularBox::append(in u32 val){\r\n    this.m_items.push_back(val);\r\n}\r\n";
    CompileResult implRes(arena.arena);
    ASSERT_TRUE(CompileWithResolver(kModularImplSource, "impl/modular_box_impl.adhd", resolver, arena.arena, implRes));
    EXPECT_NE(implRes.generatedSource.find("__adhd_arena(::MakeNotNull(&__adhd_mother_arena)), m_target(::MakeNotNull(::AddressOf(target)))"), usize.max);
    EXPECT_NE(implRes.generatedSource.find("ModularBox::read()const"), usize.max);
    EXPECT_NE(implRes.generatedSource.find("ModularBox::append("), usize.max);

    const StringView kModularCallerSource =
        "#include \"impl/modular_box.adhd\"\r\nu32 UseModularBox(mut RefTarget target){\r\n    ModularBox box = ModularBox(target, 7u);\r\n    box.append(3u);\r\n    return box.read();\r\n}\r\n";
    CompileResult callerRes(arena.arena);
    ASSERT_TRUE(CompileWithResolver(kModularCallerSource, "impl/modular_box_user.adhd", resolver, arena.arena, callerRes));
    EXPECT_NE(callerRes.generatedSource.find("ModularBox box = ModularBox(__adhd_scratch, target, 7u);"), usize.max);

    const StringView kGenericFuncLambdaSource =
        "type PairMapper<InT, OutT> = Func<64u, OutT(in InT)>;\r\nclass Mapper {\r\n    public OutT apply<OutT, InT>(in Func<64u, OutT(in InT)> fn, in InT v){\r\n        return fn(v);\r\n    }\r\n    public OutT mapViaAlias<InT, OutT>(in PairMapper<InT, OutT> fn, in InT v){\r\n        return fn(v);\r\n    }\r\n}\r\ni32 Run(in i32 seed){\r\n    Mapper m;\r\n    const i32 bias = 2;\r\n    const i32 a = m.apply<i32, i32>(lambda[](in i32 x) -> i32{ return x + 1; }, seed);\r\n    const i32 b = m.mapViaAlias<i32, i32>(lambda[in bias](in i32 x) -> i32{ return x + bias; }, a);\r\n    return b;\r\n}\r\n";
    CompileResult genericLambdaRes(arena.arena);
    ASSERT_TRUE(CompileWithResolver(kGenericFuncLambdaSource, "impl/generic_func_lambda.adhd", resolver, arena.arena, genericLambdaRes));
    EXPECT_NE(genericLambdaRes.generatedSource.find("::InplaceFunction<64u, i32(i32)>"), usize.max);
    EXPECT_EQ(genericLambdaRes.generatedSource.find("OutT"), usize.max);
    EXPECT_EQ(genericLambdaRes.generatedSource.find("InT"), usize.max);
}

void RunExternHeaderAndDeclEdgeCases(){

    AdhdTestArena arena;

    const StringView kFullExternCompileSource = "\nextern \"<core/alloc/scratch.h>\";\nextern \"<core/metascript/parser.h>\";\nextern \"<core/graphics/rhi/gpu_descriptor_heap.h>\";\nextern \"<core/graphics/backend_selection/backend.h>\";\nextern \"<core/task/gpu/task_graph.h>\";\nextern \"<core/graphics/runtime/runtime.h>\";\n\nclass LocalIncludeResolver : MetascriptIIncludeResolver{\n    public b8 resolve(in StringView includePath, mut Arena arena, mut String outSource){\n        return false;\n    }\n}\n\nb8 InspectCoreExternApis(\n    in StringView src,\n    mut Document doc,\n    mut MetascriptDocument aliasDoc,\n    mut GraphicsRuntime runtime,\n    mut GpuTaskGraph graph\n){\n    const u32 invalidHandle = GpuDescriptorHandle::s_Invalid;\n    const b8 okDefault = doc.parse(src);\n    const b8 okAlias = aliasDoc.parse(src);\n    b8 visitedVar = false;\n    doc.visitVariable(\"flag\", lambda[mut visitedVar](in MetascriptValue val) -> void{\n        visitedVar = val.isNumeric();\n    });\n\n    const u64 frameIdx = runtime.getFrameIndex();\n    mut Device device = runtime.getDevice();\n    mut GpuDescriptorHeap heap = device.getDescriptorHeap();\n    const b8 heapReady = heap.isInitialized();\n    Expected<GpuDescriptorHandle> allocated = heap.allocate(GpuDescriptorClass::Sampler);\n    graph.reset();\n\n    return (invalidHandle != 0u) && okDefault && okAlias && visitedVar && (frameIdx >= 0u) && heapReady && allocated.hasValue();\n}\n";

    CompileResult fullRes(arena.arena);
    GlobalString emittedExterns(arena.arena);
    CompilerOptions fullOpts;
    fullOpts.source = kFullExternCompileSource;
    fullOpts.virtualFilePath = "impl/edge_cases/full_extern.adhd";
    SetExternOutput(fullOpts, emittedExterns);
    const b8 fullOk = CompileOptionsResult(fullOpts, arena.arena, fullRes);
    EXPECT_TRUE(fullOk);
    if(fullOk){
        const StringView hdr = GeneratedHeaderView(fullRes);
        const StringView cpp = GeneratedSourceView(fullRes);
        EXPECT_NE(hdr.find("#include <core/alloc/scratch.h>"), usize.max);
        EXPECT_NE(hdr.find("#include <core/metascript/parser.h>"), usize.max);
        EXPECT_NE(hdr.find("#include <core/graphics/rhi/gpu_descriptor_heap.h>"), usize.max);
        EXPECT_NE(hdr.find("#include <core/graphics/backend_selection/"), usize.max);
        EXPECT_NE(hdr.find("#include <core/task/gpu/task_graph.h>"), usize.max);
        EXPECT_NE(hdr.find("#include <core/graphics/runtime/runtime.h>"), usize.max);
        EXPECT_NE(cpp.find("::NWB::Core::GpuDescriptorHandle::s_Invalid"), usize.max);
        EXPECT_NE(cpp.find("doc.parse(src)"), usize.max);
        EXPECT_NE(cpp.find("aliasDoc.parse(src)"), usize.max);
        EXPECT_NE(cpp.find("runtime.getFrameIndex()"), usize.max);
        EXPECT_NE(cpp.find("runtime.getDevice()"), usize.max);
        EXPECT_NE(cpp.find("device->getDescriptorHeap()"), usize.max);
        EXPECT_NE(cpp.find("heap->allocate(::NWB::Core::GpuDescriptorClass::Sampler)"), usize.max);
        EXPECT_NE(cpp.find("graph.reset()"), usize.max);

        const StringView emittedView(emittedExterns);
        EXPECT_EQ(emittedView.find("findVariable"), usize.max);
        EXPECT_EQ(emittedView.find("(auto "), usize.max);
        EXPECT_EQ(emittedView.find(", auto "), usize.max);
        EXPECT_EQ(emittedView.find("void*"), usize.max);
        EXPECT_EQ(emittedView.find("char*"), usize.max);
        EXPECT_EQ(emittedView.find("NotNull<"), usize.max);
    }

    EXPECT_FALSE(emittedExterns.empty());
    if(!emittedExterns.empty()){
        const StringView kRoundTripConsumer = "\n[cpp_name(\"::MyNs::DirectMode\"), cpp_header(\"<my_ns/types.h>\")]\nextern enum DirectMode{\n    Fast = 0,\n    Accurate = 1\n};\n\n[cpp_name(\"::MyNs::AccessBits\"), cpp_header(\"<my_ns/types.h>\")]\nextern flag AccessBits{\n    None = 0,\n    Read = 1,\n    Write = 2\n};\n\n[cpp_name(\"::MyNs::Counter\"), cpp_header(\"<my_ns/types.h>\")]\nextern class Counter : NoCopy{\n    static u32 s_Count;\n    static u32 Next();\n    u32 addWithDefault(in u32 delta = {});\n};\n\n[cpp_name(\"::MyNs::ComputeScale\"), cpp_header(\"<my_ns/types.h>\")]\nextern f32 ComputeScale(in DirectMode mode = {});\n\n[cpp_name(\"::MyNs::kMaxItems\"), cpp_header(\"<my_ns/types.h>\")]\nextern const u32 kMaxItems;\n\nb8 ExerciseEmittedAndManualExterns(\n    in StringView src,\n    mut Document doc,\n    mut MetascriptDocument aliasDoc,\n    mut Counter counter\n){\n    const u32 invalidHandle = GpuDescriptorHandle::s_Invalid;\n    const u32 count = Counter::s_Count;\n    const u32 nextVal = Counter::Next();\n    const u32 updated = counter.addWithDefault();\n    const f32 scale = ComputeScale();\n    const DirectMode mode = DirectMode::Accurate;\n    const AccessBits bits = AccessBits::Read | AccessBits::Write;\n    return doc.parse(src)\n        && aliasDoc.parse(src)\n        && (invalidHandle != 0u)\n        && (count <= kMaxItems)\n        && (nextVal > 0u)\n        && (updated > 0u)\n        && (scale > 0.0f)\n        && (mode != DirectMode::Fast)\n        && (bits != AccessBits::None);\n}\n";
        GlobalString roundTripSrc(arena.arena);
        roundTripSrc.append(emittedExterns);
        roundTripSrc.push_back(cast<u8>(10u));
        roundTripSrc.append(kRoundTripConsumer);

        CompileResult roundTripRes(arena.arena);
        const b8 roundTripOk = Compile(
            MStringView(roundTripSrc),
            "impl/edge_cases/round_trip.adhd",
            arena.arena,
            roundTripRes
        );
        if(!roundTripOk){
            ASSERT_FALSE(roundTripRes.errors.empty());
            ScopedTestTrace diagnostic(FirstErrorMessage(roundTripRes));
            EXPECT_TRUE(roundTripOk);
        }
        if(roundTripOk){
            const StringView hdr = GeneratedHeaderView(roundTripRes);
            const StringView cpp = GeneratedSourceView(roundTripRes);
            EXPECT_NE(hdr.find("#include <my_ns/types.h>"), usize.max);
            EXPECT_NE(cpp.find("::MyNs::DirectMode mode"), usize.max);
            EXPECT_EQ(hdr.find("::MyNs::DirectMode::Enum"), usize.max);
            EXPECT_EQ(cpp.find("::MyNs::DirectMode::Enum"), usize.max);
            EXPECT_NE(cpp.find("::MyNs::Counter::s_Count"), usize.max);
            EXPECT_NE(cpp.find("::MyNs::Counter::Next()"), usize.max);
            EXPECT_NE(cpp.find("::MyNs::ComputeScale()"), usize.max);
            EXPECT_NE(cpp.find("::MyNs::kMaxItems"), usize.max);
            EXPECT_NE(cpp.find("::MyNs::DirectMode::Accurate"), usize.max);
        }
    }

    auto expectFails = lambda[mut arena](in StringView src, in StringView path, in StringView expectedSubstr) -> void{
        CompileResult badRes(arena.arena);
        const b8 ok = Compile(src, path, arena.arena, badRes);
        ScopedTestTrace trace(path);
        EXPECT_FALSE(ok);
        if(!ok && !expectedSubstr.empty())
            EXPECT_NE(FirstErrorMessage(badRes).find(expectedSubstr), usize.max);
    };

    expectFails("\n[cpp_name(\"::MyNs::ISurface\")]\nextern interface ISurface{\n    void ping();\n};\nvoid Bad(){\n    ISurface s = ISurface();\n}\n", "impl/edge_cases/bad_abstract_iface.adhd", "");

    expectFails("\nextern \"<core/task/gpu/task_graph.h>\";\nvoid BadCopy(in GpuTaskGraph src){\n    GpuTaskGraph copy = src;\n}\n", "impl/edge_cases/bad_nocopy_clang.adhd", "cannot copy a non-copyable type");

    expectFails("\n[cpp_name(\"::MyNs::NonCopyable\")]\nextern class NonCopyable : NoCopy{\n    NonCopyable();\n};\nvoid BadManualNoCopy(in NonCopyable src){\n    NonCopyable copy = src;\n}\n", "impl/edge_cases/bad_nocopy_manual.adhd", "cannot copy a non-copyable type");

    expectFails("\nextern \"<core/metascript/parser.h>\";\nb8 BadPtrParamNotExposed(mut Document doc, in StringView src, mut MetascriptIIncludeResolver resolver){\n    return doc.parse(src, resolver);\n}\n", "impl/edge_cases/bad_ptr_param_not_exposed.adhd", "");

    expectFails("\nextern \"<core/metascript/parser.h>\";\nvoid BadPtrReturnNotExposed(in Document doc){\n    doc.findVariable(\"flag\");\n}\n", "impl/edge_cases/bad_ptr_return_not_exposed.adhd", "");

    expectFails("\nextern \"<core/metascript/parser.h>\";\nb8 BadMissingArg(mut Document doc){\n    return doc.parse();\n}\n", "impl/edge_cases/bad_missing_arg.adhd", "");
}

void RunCoreCppHeaderImportVerification(){
    AdhdTestArena arena;

    HeapStorageVector<CompilerImportedCppHeader> headers(arena.arena);
    const Array<StringView, 6u> s_Headers(
        "core/alloc/scratch.h",
        "core/metascript/parser.h",
        "core/graphics/rhi/gpu_descriptor_heap.h",
        "core/graphics/backend_selection/backend.h",
        "core/task/gpu/task_graph.h",
        "core/graphics/runtime/runtime.h"
    );
    for(in MStringView hdrPath : s_Headers){
        CompilerImportedCppHeader entry;
        entry.headerPath = hdrPath;
        entry.isSystemHeader = true;
        entry.span = CompilerSourceSpan(1u, 1u);
        headers.push_back(entry);
    }

    CompilerCppHeaderImportOptions importOpts;
    importOpts.headers = headers;

    CompilerTranslationUnit unit(arena.arena);
    HeapStorageVector<MetascriptParseError> errors(arena.arena);
    const b8 imported = ImportCompilerHeaders(importOpts, arena.arena, unit, errors);
    if(!errors.empty()){
        for(in auto err : errors)
            EXPECT_EQ(StringView(err.message), StringView());
    }
    ASSERT_TRUE(imported);
    EXPECT_TRUE(errors.empty());
    EXPECT_FALSE(unit.resolvedIncludedFiles.empty());

    const auto scratch = FindAstDeclaration(unit.classes, "ScratchArena");
    EXPECT_FALSE(scratch.has_value());

    const auto document = FindAstDeclaration(unit.classes, "Document");
    ASSERT_TRUE(document.has_value());
    EXPECT_TRUE(document.value().isExtern);
    EXPECT_EQ(document.value().cppExportName, "::NWB::Core::Metascript::Document");
    EXPECT_EQ(document.value().totalSize, 264u);
    EXPECT_EQ(document.value().totalAlign, 8u);
    const auto docAlias = FindAstDeclaration(unit.typeAliases, "MetascriptDocument");
    ASSERT_TRUE(docAlias.has_value());
    b8 foundVisitVariable = false;
    for(usize methodIndex = 0u; methodIndex < document.value().methods.size(); ++methodIndex){
        const auto m = BorrowAstNode(document.value().methods, methodIndex);
        if(m.has_value() && m.value().name == "visitVariable" && !m.value().templateParams.empty())
            foundVisitVariable = true;
    }
    EXPECT_TRUE(foundVisitVariable);

    const auto descClass = FindAstDeclaration(unit.enums, "GpuDescriptorClass");
    ASSERT_TRUE(descClass.has_value());
    EXPECT_TRUE(descClass.value().isExtern);
    EXPECT_FALSE(descClass.value().isDirectCppEnum);
    EXPECT_EQ(descClass.value().cppExportName, "::NWB::Core::GpuDescriptorClass::Enum");

    const auto descHeap = FindAstDeclaration(unit.classes, "GpuDescriptorHeap");
    ASSERT_TRUE(descHeap.has_value());
    EXPECT_TRUE(descHeap.value().isExtern);
    EXPECT_FALSE(descHeap.value().isAbstract);
    EXPECT_FALSE(descHeap.value().isCopyConstructible);
    EXPECT_EQ(descHeap.value().totalSize, 1008u);
    EXPECT_EQ(descHeap.value().totalAlign, 8u);
    EXPECT_TRUE(FindAstDeclaration(unit.classes, "GpuDescriptorHeapPendingRecordingLease").has_value());

    const auto taskGraph = FindAstDeclaration(unit.classes, "GpuTaskGraph");
    ASSERT_TRUE(taskGraph.has_value());
    EXPECT_TRUE(taskGraph.value().isExtern);
    EXPECT_FALSE(taskGraph.value().isCopyConstructible);
    EXPECT_EQ(taskGraph.value().totalSize, 1744u);
    EXPECT_EQ(taskGraph.value().totalAlign, 8u);
    EXPECT_TRUE(FindAstDeclaration(unit.classes, "GpuTaskGraphPayloadLifetimeScope").has_value());
    b8 foundAddTask = false;
    b8 foundDefaultArgMethod = false;
    for(usize methodIndex = 0u; methodIndex < taskGraph.value().methods.size(); ++methodIndex){
        const auto m = BorrowAstNode(taskGraph.value().methods, methodIndex);
        if(!m.has_value())
            continue;
        if(m.value().name == "addTask" && !m.value().templateParams.empty())
            foundAddTask = true;
        if(m.value().hasDefaultArgs && m.value().minArgCount < m.value().params.size())
            foundDefaultArgMethod = true;
    }
    EXPECT_TRUE(foundAddTask);
    EXPECT_TRUE(foundDefaultArgMethod);

    const auto runtime = FindAstDeclaration(unit.classes, "GraphicsRuntime");
    ASSERT_TRUE(runtime.has_value());
    EXPECT_TRUE(runtime.value().isExtern);
    EXPECT_EQ(runtime.value().totalSize, 1520u);
    EXPECT_EQ(runtime.value().totalAlign, 8u);
    usize runtimeCtorCount = 0u;
    for(usize methodIndex = 0u; methodIndex < runtime.value().methods.size(); ++methodIndex){
        const auto m = BorrowAstNode(runtime.value().methods, methodIndex);
        if(m.has_value() && m.value().isConstructor)
            ++runtimeCtorCount;
    }
    EXPECT_EQ(runtimeCtorCount, 1u);

    b8 foundParseSingleArg = false;
    b8 foundFindVariable = false;
    for(usize methodIndex = 0u; methodIndex < document.value().methods.size(); ++methodIndex){
        const auto m = BorrowAstNode(document.value().methods, methodIndex);
        if(!m.has_value())
            continue;
        if(m.value().name == "parse"){
            EXPECT_EQ(m.value().params.size(), 1u);
            foundParseSingleArg = true;
        }
        if(m.value().name == "findVariable")
            foundFindVariable = true;
    }
    EXPECT_TRUE(foundParseSingleArg);
    EXPECT_FALSE(foundFindVariable);

    const GlobalString formattedExtern = FormatExternAdhd(unit, arena.arena);
    EXPECT_FALSE(formattedExtern.empty());
    EXPECT_NE(MStringView(formattedExtern).find("[cpp_header(\"core/"), usize.max);

    CompilerImportedCppHeader badHeader;
    badHeader.headerPath = "nonexistent_core_header_12345.h";
    badHeader.isSystemHeader = true;
    badHeader.span = CompilerSourceSpan(1u, 1u);
    CompilerCppHeaderImportOptions badOpts;
    const Array<CompilerImportedCppHeader, 1u> badHeaders(badHeader);
    badOpts.headers = badHeaders;
    CompilerTranslationUnit badUnit(arena.arena);
    HeapStorageVector<MetascriptParseError> badErrors(arena.arena);
    EXPECT_FALSE(ImportCompilerHeaders(badOpts, arena.arena, badUnit, badErrors));
    EXPECT_FALSE(badErrors.empty());

    const StringView kLayoutFlagsAndPreludeSource = "\n[cpp_name(\"::MyExt::Contract\"), cpp_header(\"<my_ext/types.h>\"), cpp_flags(no_copy, no_assign, abstract, polymorphic_base)]\nextern class ExtContract{\n    b8 probe(...)const;\n};\n\n[cpp_name(\"::MyExt::VariadicSink\"), cpp_header(\"<my_ext/types.h>\"), cpp_flags(self_defaulted, small_value, binary_serializable)]\nextern class VariadicSink{\n    u32 count;\n    b8 pushAny(...);\n};\n\nclass ImplContract : ExtContract{\n    public b8 validate(in ExtContract contract, mut VariadicSink sink)const{\n        const Path spoolDir = DefaultCrashSpoolDirectory();\n        const CrashDumpResult dump = CaptureCrashDump();\n        const usize compId = ComponentType<ImplContract>();\n        const BlendFactor bf = BlendFactor::SrcAlpha;\n        const ColorMask mask = ColorMask::Red | ColorMask::Green;\n        const Viewport vp = Viewport();\n        const b8 okSink = sink.pushAny(1u, \"ok\", vp.minX, s_BackBufferWidth, spoolDir, dump.packageWritten());\n        const b8 okValid = contract.probe() && contract.probe(bf, mask, compId);\n        return okSink && okValid;\n    }\n}\n";

    CompileResult extPreludeRes(arena.arena);
    const b8 extPreludeOk = Compile(
        kLayoutFlagsAndPreludeSource,
        "impl/edge_cases/extern_prelude_flags.adhd",
        arena.arena,
        extPreludeRes
    );
    EXPECT_TRUE(extPreludeOk);
    if(extPreludeOk){
        const StringView hdr = GeneratedHeaderView(extPreludeRes);
        const StringView cpp = GeneratedSourceView(extPreludeRes);
        EXPECT_NE(hdr.find("#include <my_ext/types.h>"), usize.max);
        EXPECT_NE(hdr.find("#include <core/crash/module.h>"), usize.max);
        EXPECT_NE(hdr.find("#include <core/ecs/type_id.h>"), usize.max);
        EXPECT_NE(hdr.find("#include <core/graphics/rhi/pipeline_state.h>"), usize.max);
        EXPECT_NE(cpp.find("::NWB::Core::Crash::DefaultCrashSpoolDirectory(__adhd_scratch)"), usize.max);
        EXPECT_NE(cpp.find("::NWB::Core::ECS::ComponentType<ImplContract>()"), usize.max);
        EXPECT_NE(cpp.find("::NWB::Core::BlendFactor::SrcAlpha"), usize.max);
        EXPECT_NE(cpp.find("::NWB::Core::ColorMask::Red"), usize.max);
        EXPECT_NE(cpp.find("::NWB::Core::s_BackBufferWidth"), usize.max);
    }

    auto expectExtFails = lambda[mut arena](in StringView src, in StringView path) -> void{
        CompileResult badRes(arena.arena);
        EXPECT_FALSE(Compile(src, path, arena.arena, badRes));
    };
    expectExtFails(
        "[cpp_name(\"::MyExt::NonExtern\")]\nclass NonExternName{\n    public u32 x = 0u;\n}\n",
        "impl/edge_cases/bad_non_extern_name.adhd"
    );
    expectExtFails(
        "[cpp_flags(small_value)]\nclass NonExternFlags{\n    public u32 x = 0u;\n}\n",
        "impl/edge_cases/bad_non_extern_flags.adhd"
    );
    expectExtFails(
        "class NonExternVariadic{\n    public void f(...){}\n}\n",
        "impl/edge_cases/bad_non_extern_variadic.adhd"
    );
    expectExtFails(
        "[cpp_name(\"::MyExt::Abs\"), cpp_header(\"<my_ext/abs.h>\"), cpp_flags(abstract)]\nextern class AbsType;\nvoid F(){ const AbsType a; }\n",
        "impl/edge_cases/bad_abstract_value.adhd"
    );
}


