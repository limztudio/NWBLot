StringView ResolveBakeFontAtlasRasterModeText(in FontAtlasRasterMode mode){
    if(mode == FontAtlasRasterMode::Bitmap)
        return s_FontAtlasRasterModeBitmap;
    return s_FontAtlasRasterModeOutline;
}

void CompactAtlasGroups(mut FontAtlasPayload payload){
    for(usize groupIndex = 0u; groupIndex < payload.groups.size(); ++groupIndex){
        mut FontAtlasGroup group = payload.groups[groupIndex];
        const FontAtlasGroupCompactBounds bounds = ComputeFontAtlasGroupCompactBounds(
            payload.glyphs,
            cast<u32>(groupIndex),
            group.width,
            group.height,
            group.channelCount,
            payload.guardTexels
        );
        if(bounds.unchanged)
            continue;

        FontAtlasPacker().compactGroupPixels(bounds, group.width, group.channelCount, group.pixels, group.pixels);
        group.pixels.shrink_to_fit();
        for(usize glyphIndex = 0u; glyphIndex < payload.glyphs.size(); ++glyphIndex)
            OffsetFontAtlasGroupGlyph(cast<u32>(groupIndex), bounds.firstX, bounds.firstY, payload.glyphs[glyphIndex]);
        group.width = bounds.width;
        group.height = bounds.height;
        group.channelCount = bounds.channelCount;
    }
}

void BuildFontMetadata(in FontAtlasPayload payload, mut String outText){
    outText.assign("font face;\r\n\r\nfont_atlas atlas;\r\natlas.font = face;\r\n");
    StringAppendFormat(outText, "atlas.bake_ppem = {};\r\n", payload.bakePpem);
    StringAppendFormat(outText, "atlas.spread_pixels = {};\r\n", payload.spreadPixels);
    StringAppendFormat(outText, "atlas.raster_mode = \"{}\";\r\n", ResolveBakeFontAtlasRasterModeText(payload.rasterMode));
    StringAppendFormat(outText, "atlas.ascender_units = {:#.9g};\r\n", payload.ascenderUnits);
    StringAppendFormat(outText, "atlas.descender_units = {:#.9g};\r\n", payload.descenderUnits);
    StringAppendFormat(outText, "atlas.line_gap_units = {:#.9g};\r\n", payload.lineGapUnits);
    outText.append("atlas.glyphs = [\r\n");
    for(in FontAtlasGlyph glyph : payload.glyphs){
        if(glyph.drawable == 0u){
            StringAppendFormat(outText, "    {{ \"advance_units\": {:#.9g} }},\r\n", glyph.advanceUnits);
            continue;
        }
        StringAppendFormat(
            outText,
            "    {{ \"group\": {}, \"channel\": {}, \"x\": {}, \"y\": {}, \"width\": {}, \"height\": {}, \"plane_left\": {:#.9g}, \"plane_top\": {:#.9g}, \"advance_units\": {:#.9g} }},\r\n",
            glyph.group,
            glyph.channel,
            glyph.x,
            glyph.y,
            glyph.width,
            glyph.height,
            glyph.planeLeft,
            glyph.planeTop,
            glyph.advanceUnits
        );
    }
    outText.append("];\r\n\r\nasset_bunch bunch = [face, atlas];\r\n");
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateOptions(in BakeOptions options){
    return ValidateBakeOptionsFields(options.ppem, options.spread, options.extent, options.maxGroups, options.source, options.output);
}

Expected<Vector<u8>, StringView> ReadFontSourceInput(in Path path){
    if(IsPreparedFontSourcePath(path)){
        auto prepared = ReadPreparedFontSource(path, false);
        if(!prepared.has_value())
            return MakeUnexpected(prepared.error());
        if(!IsValidPreparedFontFaceIndex(prepared.value().faceIndex)){
            error("font_builder: malformed prepared .font input");
            return MakeUnexpected(StringView("prepared font face index must be zero"));
        }
        Vector<u8> sourceBytes;
        TransferVector<u8>(sourceBytes, prepared.value().fontBytes);
        return sourceBytes;
    }
    BinaryInputStream stream(path);
    if(!stream.isOpen())
        return MakeUnexpected(StringView("failed to open font source"));
    const i64 size = stream.seekEnd();
    if(!IsValidFontSourceByteCount(size >= 0, size, s_FontMaxSourceBytes) || !CanRepresentStreamSize(size)){
        error("font_builder: source size is invalid or unreadable");
        return MakeUnexpected(StringView("source size is invalid or unreadable"));
    }
    if(!stream.seekBegin())
        return MakeUnexpected(StringView("failed to seek font source"));
    Vector<u8> bytes;
    bytes.resize(cast<usize>(size));
    if(!stream.readBytes(bytes))
        return MakeUnexpected(StringView("failed to read complete font source"));
    if(!stream.verifyEnd())
        return MakeUnexpected(StringView("font source changed while reading"));
    return bytes;
}

b8 PackGlyphs(in BakeOptions options, in Span<RasterGlyph> glyphs, mut FontAtlasPayload outPayload){
    outPayload.glyphs.reserve(glyphs.size());
    for(in RasterGlyph glyph : glyphs)
        outPayload.glyphs.push_back(glyph.record);
    const Vector<u32> order = BuildSortedDrawableGlyphOrder(outPayload.glyphs);
    Array<Shelf, s_MaxBakeShelfPages> shelves;
    FontAtlasPacker packer;
    u32 lastPage = 0u;
    for(in u32 index : order){
        in RasterGlyph glyph = glyphs[index];
        const u32 width = ComputeGuardedGlyphExtent(glyph.record.width);
        const u32 height = ComputeGuardedGlyphExtent(glyph.record.height);
        const Expected<ShelfPlacement> placed = packer.placeInShelves(width, height, options.extent, options.maxGroups, shelves);
        if(!placed.has_value()){
            LogAtlasPackCapacityExhausted(glyph.record.glyphId, width, height, options.extent, options.maxGroups);
            return false;
        }
        const u32 groupIndex = placed.value().group;
        while(outPayload.groups.size() <= groupIndex){
            AppendArenaElement<FontAtlasGroup>(outPayload.groups);
            mut FontAtlasGroup group = outPayload.groups.back();
            group.width = options.extent;
            group.height = options.extent;
            group.channelCount = s_FontAtlasMaxChannelCount;
            group.pixels.resize(ComputeGroupPixelCapacity(options.extent), 0u);
        }
        packer.copyGlyphToGroup(glyph.pixels, options.extent, placed.value(), outPayload.glyphs[index], outPayload.groups[groupIndex].pixels);
        lastPage = Max(lastPage, placed.value().page);
    }
    CompactAtlasGroups(outPayload);
    for(mut FontAtlasGroup group : outPayload.groups)
        group.sha256 = ComputeSha256(group.pixels);
    LogAtlasPackSummary(glyphs.size(), ComputePackedLogicalPageCount(order.empty(), lastPage), outPayload.groups.size());
    return true;
}

Expected<FontAtlasPayload> Bake(in BakeOptions options, mut Vector<u8> outSourceFontBytes){
    auto source = ReadFontSourceInput(options.source);
    if(!source.has_value()){
        error("font_builder: source admission failed: {}", source.error());
        return MakeUnexpected(Failure());
    }
    FontAtlasPayload candidate;
    BakeFontRasterizer rasterizer;
    if(!rasterizer.rasterize(options, source.value(), candidate) || !PackGlyphs(options, rasterizer.glyphs, candidate))
        return MakeUnexpected(Failure());
    auto tables = CopyFontAtlasPositioningTables(source.value(), candidate.faceIndex, candidate.sourceGlyphCount);
    if(!tables.has_value())
        return MakeUnexpected(Failure());
    TransferVector<FontAtlasPositioningTable>(candidate.positioningTables, tables.value());
    if(!ValidateFontAtlasPayload(candidate))
        return MakeUnexpected(Failure());
    TransferVector<u8>(outSourceFontBytes, source.value());
    return candidate;
}

Expected<Vector<u8>, StringView> BuildPreparedFont(in Span<u8> sourceFontBytes, in FontAtlasPayload atlas){
    if(ComputeSha256(sourceFontBytes) != atlas.fontSha256){
        error("font_builder: source changed during bake");
        return MakeUnexpected(StringView("source changed during bake"));
    }
    Vector<PreparedFontImageView> images;
    images.reserve(atlas.groups.size());
    for(in FontAtlasGroup group : atlas.groups)
        images.push_back(PreparedFontImageView(group.width, group.height, group.channelCount, group.pixels));
    Vector<u8> binary;
    const auto result = WritePreparedFontSource(BinaryByteView(sourceFontBytes.data(), sourceFontBytes.size()), atlas.faceIndex, images, binary);
    if(!result.has_value())
        return MakeUnexpected(result.error());
    return binary;
}

b8 WriteOutputs(in BakeOptions options, in Span<u8> sourceFontBytes, in FontAtlasPayload payload){
    const auto binary = BuildPreparedFont(sourceFontBytes, payload);
    if(!binary.has_value()){
        error("font_builder: prepared font failed: {}", binary.error());
        return false;
    }
    String metadata;
    BuildFontMetadata(payload, metadata);
    Path primary = options.output;
    primary.replaceExtension(s_PreparedFontExtension);
    StagedFilePairPaths paths(primary, options.output);
    const StagedFilePairResult validation = ValidateStagedFilePairPaths(paths, options.overwrite, true);
    if(!validation.succeeded()){
        ReportStagedFilePairValidationFailure("font_builder", paths, validation, "--overwrite", "complete regular .nwb and .font files");
        return false;
    }
    const Path directory = options.output.parentPath();
    if(!directory.empty()){
        const auto ensured = EnsureDirectories(directory);
        if(!ensured.has_value()){
            error("font_builder: failed to prepare output directory '{}': {}", PathToString(directory), ErrorCodeMessage(ensured.error()));
            return false;
        }
    }
    const auto published = StageAndPublishFilePair(paths, binary.value(), metadata, options.overwrite, true, true, s_PublicationDiagnosticTag);
    ReportStagedFilePairEntries("font_builder", paths, published);
    if(!published.succeeded()){
        ReportStagedFilePairPublishFailure("font_builder", paths, published, "font temporary", "metadata temporary", "--overwrite", "complete regular .nwb and .font files");
        return false;
    }
    return true;
}


