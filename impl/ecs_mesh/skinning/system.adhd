#include <impl/ecs_mesh/runtime/mesh.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_mesh/skinning/graph_dispatch_plan.adhd.h>
#include <impl/ecs_mesh/skinning/local_bounds.adhd.h>
#include <impl/ecs_mesh/skinning/runtime_cache.adhd.h>

#include <impl/ecs_mesh/skinning/submission_state.adhd.h>
#include <impl/assets/graphics/skinned_mesh/constants.h>
#include <impl/assets_mesh/skin_types.adhd.h>
#include <impl/assets_scene/asset.adhd.h>

#include <core/alloc/scratch.h>
#include <core/ecs/system.h>
#include <core/ecs/world.h>
#include <core/graphics/runtime/render_pass.h>
#include <core/graphics/rhi/gpu_descriptor_heap.h>
#include <core/task/gpu/compiler.h>
#include <core/task/gpu/packet_runtime.h>
#include <core/task/gpu/persistent_state.h>
#include <core/task/gpu/types.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_CORE_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct GpuTaskRecordContext;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_CORE_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static_assert(SkeletonSkinningMode::LinearBlend == NWB_SKINNED_MESH_SKINNING_MODE_LINEAR_BLEND && SkeletonSkinningMode::DualQuaternion == NWB_SKINNED_MESH_SKINNING_MODE_DUAL_QUATERNION, "Skeleton skinning mode values must match the shader ABI");
static_assert(s_RuntimeRequiredStorageDescriptorCount == static_cast<usize>(RuntimeStorageDescriptorSlot::SkinInfluences), "Runtime required storage descriptor count must match slot enum");
static_assert(s_RuntimeStorageDescriptorCount == static_cast<usize>(RuntimeStorageDescriptorSlot::kCount), "Runtime storage descriptor count must match slot enum");

static_assert(sizeof(MeshSkinningPushConstants) == NWB_SKINNED_MESH_PUSH_CONSTANT_BYTE_SIZE, "MeshSkinning push constants layout must match the shader ABI");
static_assert(offsetof(MeshSkinningPushConstants, meshletCount) == sizeof(u32) * NWB_SKINNED_MESH_PUSH_MESHLET_COUNT, "MeshSkinning meshlet-count push offset drifted");
static_assert(offsetof(MeshSkinningPushConstants, skinCount) == sizeof(u32) * NWB_SKINNED_MESH_PUSH_SKIN_COUNT, "MeshSkinning skin-count push offset drifted");
static_assert(offsetof(MeshSkinningPushConstants, jointCount) == sizeof(u32) * NWB_SKINNED_MESH_PUSH_JOINT_COUNT, "MeshSkinning joint-count push offset drifted");
static_assert(offsetof(MeshSkinningPushConstants, skinningMode) == sizeof(u32) * NWB_SKINNED_MESH_PUSH_SKINNING_MODE, "MeshSkinning skinning-mode push offset drifted");
static_assert(offsetof(MeshSkinningPushConstants, bindlessResourceSlots) == sizeof(u32) * NWB_SKINNED_MESH_PUSH_BINDLESS_RESOURCES_SLOT, "MeshSkinning bindless-resource slot push offset drifted");

static_assert(sizeof(MeshletBoundsPushConstants) == NWB_SKINNED_MESH_BOUNDS_PUSH_CONSTANT_BYTE_SIZE, "MeshSkinning bounds push constants layout must match the shader ABI");
static_assert(offsetof(MeshletBoundsPushConstants, meshletCount) == sizeof(u32) * NWB_SKINNED_MESH_BOUNDS_PUSH_MESHLET_COUNT, "MeshSkinning bounds meshlet-count push offset drifted");
static_assert(offsetof(MeshletBoundsPushConstants, bindlessResourceSlots) == sizeof(u32) * NWB_SKINNED_MESH_BOUNDS_PUSH_BINDLESS_RESOURCES_SLOT, "MeshSkinning bounds bindless-resource slot push offset drifted");

static_assert(sizeof(MeshletBoundsPushConstants) == NWB_SKINNED_MESH_REPACK_PUSH_CONSTANT_BYTE_SIZE, "MeshSkinning repack push constants layout must match the shader ABI");
static_assert(offsetof(MeshletBoundsPushConstants, meshletCount) == sizeof(u32) * NWB_SKINNED_MESH_REPACK_PUSH_MESHLET_COUNT, "MeshSkinning repack meshlet-count push offset drifted");
static_assert(offsetof(MeshletBoundsPushConstants, bindlessResourceSlots) == sizeof(u32) * NWB_SKINNED_MESH_REPACK_PUSH_BINDLESS_RESOURCES_SLOT, "MeshSkinning repack bindless-resource slot push offset drifted");


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using MeshSkinningShaderPathResolveCallback = Function< Expected<Name>(const Name& shaderName, AStringView variantName, const Name& stageName) >;

struct MeshSkinningRuntimeBindlessHeapHandles{
    Core::GpuDescriptorHandle resourceSlots = Core::GpuDescriptorHandle::Invalid();
    Array<Core::GpuDescriptorHandle, s_RuntimeStorageDescriptorCount> storageBuffers{};
};

struct MeshSkinningRuntimeResources{
    RuntimeMeshHandle handle;
    MeshSkinningResourceBuffers buffers;
    u32 editRevision = 0;
    u32 positionCount = 0;
    u32 attributeCount = 0;
    u32 meshletCount = 0;
    u32 skinCount = 0;
    u32 jointCount = 0;
    Core::BufferHandle skinBuffer;
    Core::BufferHandle jointPaletteBuffer;
    Core::BufferHandle bindlessResourceSlotsBuffer;
    MeshSkinningBindlessResourceSlots bindlessResourceSlots;
    MeshSkinningRuntimeBindlessHeapHandles bindlessHeapHandles;
    b8 bindlessResourceSlotsUploaded = false;


public:
    [[nodiscard]] b8 hasPersistentHeapDescriptors(b8 hasActiveSkin, b8 hasAttributeBuffer)const noexcept;
};

using MeshSkinningRuntimeResourceMap = HashMap<u64, MeshSkinningRuntimeResources, Core::Alloc::GlobalArena, Hasher<u64>, EqualTo<u64>>;
using MeshSkinningGraphDispatchPlanVector = Vector<MeshSkinningGraphDispatchPlan, Core::Alloc::GlobalArena>;
using MeshSkinningLocalBoundsDispatchVector = Vector<MeshSkinningLocalBoundsDispatch, Core::Alloc::GlobalArena>;
using MeshSkinningBufferVector = Vector<Core::BufferHandle, Core::Alloc::GlobalArena>;
using GpuCompiledGraphReadView = Core::GpuCompiledGraph::ReadView;
using CommandList = Core::CommandList;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[arena, system("mesh_skinning")]
class MeshSkinningSystem : IRenderPass, IRuntimeMeshProvider{
    // Compiler artifacts. Declared once, reset per submit; render() only redeclares into reused storage.
    private GpuTaskGraph m_frameTaskGraph;
    private GpuCompiledGraph m_frameCompiledGraph;
    private GpuTaskGraphAnalysis m_frameTaskGraphAnalysis;
    private GpuGraphSubmissionTransaction m_frameSubmissionTransaction;
    // The graph-runtime cache retains only accepted live skinning resources between graph generations.
    private GpuPersistentResourceStateCache m_acceptedSkinningState;
    private GpuTaskGraphQueueAssignments m_frameTaskGraphQueueAssignments;
    private GpuRecordedGraph m_frameRecordedGraph;
    public BindingLayoutHandle m_skinningBindingLayout;
    public ShaderHandle m_skinningComputeShader;
    public ComputePipelineHandle m_skinningComputePipeline;
    public BindingLayoutHandle m_boundsBindingLayout;
    public ShaderHandle m_boundsComputeShader;
    public ComputePipelineHandle m_boundsComputePipeline;
    public ShaderHandle m_localBoundsComputeShader;
    public ComputePipelineHandle m_localBoundsComputePipeline;
    public BindingLayoutHandle m_repackBindingLayout;
    public ShaderHandle m_repackComputeShader;
    public ComputePipelineHandle m_repackComputePipeline;
    private mut GlobalArena m_arena;
    public mut World m_world;
    private mut GraphicsRuntime m_graphics;
    private mut AssetManager m_assetManager;
    private mut IRuntimeMeshRegistry m_runtimeMeshRegistry;
    private MeshSkinningShaderPathResolveCallback m_shaderPathResolver;
    public MeshSkinningRuntimeCache m_runtimeMeshCache;
    private ActiveSceneSubsystems m_defaultSceneSubsystems;
    private ActiveSceneSubsystemsConstPtr m_activeSceneSubsystems;
    public MeshSkinningRuntimeResourceMap m_runtimeResources;
    // Reused across submitFrameSkinningGraph() calls so per-frame render performs no GlobalArena creation.
    private MeshSkinningGraphDispatchPlanVector m_frameDispatchPlans;
    private MeshSkinningGraphDispatchPlanVector m_frameDeformationPlans;
    private MeshSkinningLocalBoundsDispatchVector m_frameLocalBoundsDispatches;
    private MeshSkinningBufferVector m_frameLiveBuffers;
    private b8 m_runtimeSetupReady = false;

    public MeshSkinningSystem(
        mut World world,
        mut GraphicsRuntime graphics,
        mut AssetManager assetManager,
        mut IRuntimeMeshRegistry runtimeMeshRegistry,
        in MeshSkinningShaderPathResolveCallback shaderPathResolver
    );
    public ~MeshSkinningSystem();

    public void prepare(mut World world)override;
    public Expected<void, CpuTaskAdmissionError> update(mut World world, in f32 delta)override{
        return Expected<void, CpuTaskAdmissionError>();
    }
    public b8 validateResources(in u32 width, in u32 height, in u32 sampleCount)override;
    public b8 prepareResources(in FramebufferPtr framebuffer)override;
    public void render(in FramebufferPtr framebuffer)override;
    public void invalidateResources()override;

    public Expected<RuntimeMeshDesc> resolveRuntimeMesh(in EntityID entity)override;
    public b8 hasRuntimeMeshBinding(in EntityID entity)const override;
    public void markLiveRuntimeMeshes(mut RuntimeMeshRequestSet requests)override;

    public void setActiveSceneSubsystems(in ActiveSceneSubsystemsConstPtr subsystems);
    public b8 isSkinningFeatureEnabled()const;

    private b8 ensureActiveSceneSubsystems();
    private b8 ensureSkinningPipeline();
    private b8 ensureBoundsPipeline();
    private b8 ensureLocalBoundsPipeline();
    private b8 ensureRepackPipeline();
    // Consume-only pipeline checks for the per-frame prepare path; creation belongs to validateResources via the ensure* setup above.
    private b8 skinningPipelineReady()const;
    private b8 boundsPipelinesReady()const;
    private b8 repackPipelineReady()const;
    // Declares frame-local skinning as one Graphics packet; accepted task commits dirty state.
    private b8 submitFrameSkinningGraph();
    private b8 prepareRuntimeMeshResources(mut MeshSkinningRuntimeInstance instance, mut ScratchArena scratchArena);
    public b8 recordGraphOwnedSkinningDeformation(in MeshSkinningGraphDispatchPlan plan, in GpuTaskRecordContext context, mut CommandList commandList);
    public b8 recordGraphOwnedSkinningPostDispatch(in MeshSkinningGraphDispatchPlan plan, in GpuTaskRecordContext context, mut CommandList commandList);
    public void confirmGraphOwnedSkinningDispatch(in MeshSkinningGraphDispatchPlan plan);
    private void collectLiveSkinningStateBuffers(mut ScratchArena scratchArena, mut MeshSkinningBufferVector outBuffers)const;
    private b8 replaceAcceptedSkinningState(in CommandListResourceStateHandoff state, mut ScratchArena scratchArena);
    private Expected<b8> ensureRuntimeResources(mut MeshSkinningRuntimeInstance instance, mut ScratchArena scratchArena);
    private b8 createRuntimeResourceBindlessHeapHandles(mut MeshSkinningRuntimeInstance instance, mut MeshSkinningRuntimeResources resources);
    public void releaseRuntimeResourceBindlessHeapHandles(mut MeshSkinningRuntimeResources resources);
    private void pruneRuntimeResources();
    private void resolveFrameTaskGraphAttempt(in GpuCompiledGraphReadView planAccess);
    // Resets reused frame graph storage so the next render() redeclares into clean members.
    private void resetFrameTaskGraph();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

