}

void VerifyGpuRouting_RoutesCrossFamilySameClassConcurrentGraphicsResourceWithoutOwnershipHandoff(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuGraphResourceId> bufferResult = AddBufferMetadata(
        graph,
        s_GpuCaseTaskGraphCrossFamilySameClassConcurrentBuffer,
        "Cross Family Same Class Concurrent Buffer",
        ResourceStates::Common,
        ResourceQueueSharing::Graphics
    );
    ASSERT_TRUE(bufferResult.has_value());
    const GpuGraphResourceId buffer = bufferResult.value();
    ASSERT_TRUE(buffer.valid());

    GpuTaskCommandRequirements graphicsCommands = GpuTaskCommandRequirements();
    graphicsCommands.requiredCapabilities = GpuQueueCapability::Graphics;

    GpuTaskSchedulingHint producerScheduling = GpuTaskSchedulingHint();
    producerScheduling.cost = GpuTaskCostHint::Large;
    producerScheduling.allowSameClassQueueRouting = true;
    producerScheduling.allowCrossFamilySameClassQueueRouting = true;
    Array<GpuTaskResourceUse, 1> producerUses = Array<GpuTaskResourceUse, 1>();
    producerUses[0u].resource = buffer;
    producerUses[0u].requiredState = ResourceStates::CopyDest;
    producerUses[0u].access = GpuTaskResourceAccess::Write;
    GpuTaskDesc producerDesc = GpuTaskDesc();
    producerDesc.setIdentity(s_GpuCaseTaskGraphCrossFamilySameClassConcurrentProducer);
    producerDesc.setMarkerLabel("Cross Family Same Class Concurrent Producer");
    producerDesc.setScheduling(producerScheduling);
    producerDesc.setResourceUses(producerUses);
    const Expected<GpuTaskId> producerResult = graph.addTask(producerDesc, graphicsCommands);
    ASSERT_TRUE(producerResult.has_value());
    const GpuTaskId producer = producerResult.value();
    ASSERT_TRUE(producer.valid());

    GpuTaskSchedulingHint consumerScheduling = GpuTaskSchedulingHint();
    consumerScheduling.cost = GpuTaskCostHint::Medium;
    consumerScheduling.allowSameClassQueueRouting = true;
    consumerScheduling.allowCrossFamilySameClassQueueRouting = true;
    Array<GpuTaskId, 1> consumerDependencies = Array<GpuTaskId, 1>();
    consumerDependencies[0u] = producer;
    Array<GpuTaskResourceUse, 1> consumerUses = Array<GpuTaskResourceUse, 1>();
    consumerUses[0u].resource = buffer;
    consumerUses[0u].requiredState = ResourceStates::CopySource;
    consumerUses[0u].access = GpuTaskResourceAccess::Read;
    GpuTaskDesc consumerDesc = GpuTaskDesc();
    consumerDesc.setIdentity(s_GpuCaseTaskGraphCrossFamilySameClassConcurrentConsumer);
    consumerDesc.setMarkerLabel("Cross Family Same Class Concurrent Consumer");
    consumerDesc.setScheduling(consumerScheduling);
    consumerDesc.setDependencies(consumerDependencies);
    consumerDesc.setResourceUses(consumerUses);
    const Expected<GpuTaskId> consumerResult = graph.addTask(consumerDesc, graphicsCommands);
    ASSERT_TRUE(consumerResult.has_value());
    const GpuTaskId consumer = consumerResult.value();
    ASSERT_TRUE(consumer.valid());

    GpuPhysicalQueueInfo auxiliaryGraphicsQueue = GraphicsQueue(1u);
    auxiliaryGraphicsQueue.familyIndex = 3u;
    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = auxiliaryGraphicsQueue;
    const GpuPhysicalQueueTopology topology = MakeGpuRoutingTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(Compile(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

    native(in assignments, in compiledPlan, in producer, in consumer, in queues, in auxiliaryGraphicsQueue){
        const Core::GpuTaskQueueAssignment* const producerAssignment = assignments.find(producer);
        const Core::GpuTaskQueueAssignment* const consumerAssignment = assignments.find(consumer);
        const Core::GpuCompiledTask* const compiledProducer = compiledPlan.findTask(producer).plan;
        const Core::GpuCompiledTask* const compiledConsumer = compiledPlan.findTask(consumer).plan;
        ASSERT_NE(producerAssignment, nullptr);
        ASSERT_NE(consumerAssignment, nullptr);
        ASSERT_NE(compiledProducer, nullptr);
        ASSERT_NE(compiledConsumer, nullptr);
        EXPECT_EQ(producerAssignment->queue, queues[0u].id);
        EXPECT_EQ(consumerAssignment->queue, auxiliaryGraphicsQueue.id);
        EXPECT_EQ(compiledProducer->epilogueBarrierCount, 0u);
        ASSERT_EQ(compiledConsumer->prologueStateSeedCount, 1u);
        ASSERT_EQ(compiledConsumer->prologueBarrierCount, 1u);
        EXPECT_EQ(compiledPlan.findTask(consumer).prologueBarriers[0u].type, Core::GpuCompiledBarrierType::BufferTransition);
    }
}

void VerifyGpuRouting_RoutesCrossFamilySameClassComputeAndTransferWorkWithOwnershipHandoffs(){
    GpuPhysicalQueueInfo auxiliaryGraphics = GraphicsQueue(1u);
    auxiliaryGraphics.familyIndex = 3u;
    GpuRoutingRunCrossFamilySameClassCase(
        GpuQueueCapability::Graphics,
        GraphicsQueue(),
        auxiliaryGraphics,
        s_GpuCaseTaskGraphCrossFamilySameClassBuffer,
        s_GpuCaseTaskGraphCrossFamilySameClassProducer,
        s_GpuCaseTaskGraphCrossFamilySameClassConsumer
    );

    GpuPhysicalQueueInfo auxiliaryCompute = DedicatedComputeQueue(3u);
    auxiliaryCompute.familyIndex = 3u;
    GpuRoutingRunCrossFamilySameClassCase(
        GpuQueueCapability::Compute,
        DedicatedComputeQueue(),
        auxiliaryCompute,
        s_GpuCaseTaskGraphCrossFamilySameClassComputeBuffer,
        s_GpuCaseTaskGraphCrossFamilySameClassComputeProducer,
        s_GpuCaseTaskGraphCrossFamilySameClassComputeConsumer
    );

    GpuPhysicalQueueInfo auxiliaryTransfer = DedicatedTransferQueue(4u);
    auxiliaryTransfer.familyIndex = 4u;
    GpuRoutingRunCrossFamilySameClassCase(
        GpuQueueCapability::Transfer,
        DedicatedTransferQueue(),
        auxiliaryTransfer,
        s_GpuCaseTaskGraphCrossFamilySameClassTransferBuffer,
        s_GpuCaseTaskGraphCrossFamilySameClassTransferProducer,
        s_GpuCaseTaskGraphCrossFamilySameClassTransferConsumer
    );
}

void VerifyGpuRouting_SerialSchedulingReachabilityPreservesStrictQueriesAcrossReuse(){
    ScratchArena scratch = ScratchArena(s_TaskGraphScratchArena);

    const usize taskCount = 129u;
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    Array<GpuTaskId, 129> tasks = Array<GpuTaskId, 129>();
    for(usize taskIndex = 0u; taskIndex < taskCount; ++taskIndex){
        const Expected<Name> derivedNameResult = IndexedName(s_GpuCaseQueueScalingSerial, taskIndex);
        ASSERT_TRUE(derivedNameResult.has_value());
        Array<GpuTaskId, 1> singleDep = Array<GpuTaskId, 1>();
        Span<GpuTaskId> depSpan = Span<GpuTaskId>();
        if(taskIndex != 0u){
            singleDep[0u] = tasks[taskIndex - 1u];
            depSpan = singleDep;
        }
        const Expected<GpuTaskId> taskAdmission = AddTaskWithCommands(
            derivedNameResult.value(),
            "Serial Reachability Task",
            ComputeCommands(),
            GpuTaskSchedulingHint(),
            GpuTaskTimingMetadata(),
            depSpan,
            graph
        );
        ASSERT_TRUE(taskAdmission.has_value());
        tasks[taskIndex] = taskAdmission.value();
        ASSERT_TRUE(tasks[taskIndex].valid());
    }
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, scratch, analysis));
    GpuTaskSchedulingReachability reachability = GpuTaskSchedulingReachability(scratch);
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
    ASSERT_TRUE(BuildGpuTaskSchedulingReachability(declarations, analysis, reachability));
    for(usize sourceIndex = 0u; sourceIndex < taskCount; ++sourceIndex){
        for(usize destinationIndex = 0u; destinationIndex < taskCount; ++destinationIndex){
            EXPECT_EQ(reachability.reaches(tasks[sourceIndex], tasks[destinationIndex]), sourceIndex < destinationIndex);
            EXPECT_FALSE(reachability.transitivelyIndependent(tasks[sourceIndex], tasks[destinationIndex]));
        }
    }
    Array<GpuTaskId, 3> invalidTasks = Array<GpuTaskId, 3>();
    invalidTasks[0u] = GpuTaskId();
    invalidTasks[1u].generation = tasks[0u].generation + 1u;
    invalidTasks[1u].index = tasks[0u].index;
    invalidTasks[2u].generation = tasks[0u].generation;
    invalidTasks[2u].index = cast<u32>(taskCount);
    for(in GpuTaskId invalid : invalidTasks){
        EXPECT_FALSE(reachability.reaches(tasks[0u], invalid));
        EXPECT_FALSE(reachability.reaches(invalid, tasks[0u]));
        EXPECT_FALSE(reachability.transitivelyIndependent(tasks[0u], invalid));
        EXPECT_FALSE(reachability.transitivelyIndependent(invalid, tasks[0u]));
    }

    GpuTaskGraph partialGraph = GpuTaskGraph(testArena.arena);
    const Expected<GpuTaskId> producerResult = AddTask(
        s_GpuCaseQueueScalingPartialProducer,
        "Partial Producer",
        Span<GpuTaskId>(),
        Span<GpuTaskResourceUse>(),
        Span<GpuTaskResourceSetUse>(),
        Span<GpuTaskResourceVersionUse>(),
        Span<GpuExternalCompletionId>(),
        partialGraph
    );
    ASSERT_TRUE(producerResult.has_value());
    const GpuTaskId producer = producerResult.value();
    Array<GpuTaskId, 1> producerDeps = Array<GpuTaskId, 1>();
    producerDeps[0u] = producer;
    const Expected<GpuTaskId> consumerResult = AddTask(
        s_GpuCaseQueueScalingPartialConsumer,
        "Partial Consumer",
        producerDeps,
        Span<GpuTaskResourceUse>(),
        Span<GpuTaskResourceSetUse>(),
        Span<GpuTaskResourceVersionUse>(),
        Span<GpuExternalCompletionId>(),
        partialGraph
    );
    ASSERT_TRUE(consumerResult.has_value());
    const GpuTaskId consumer = consumerResult.value();
    const Expected<GpuTaskId> independentResult = AddTask(
        s_GpuCaseQueueScalingPartialIndependent,
        "Independent",
        Span<GpuTaskId>(),
        Span<GpuTaskResourceUse>(),
        Span<GpuTaskResourceSetUse>(),
        Span<GpuTaskResourceVersionUse>(),
        Span<GpuExternalCompletionId>(),
        partialGraph
    );
    ASSERT_TRUE(independentResult.has_value());
    const GpuTaskId independent = independentResult.value();
    ASSERT_TRUE(producer.valid());
    ASSERT_TRUE(consumer.valid());
    ASSERT_TRUE(independent.valid());
    GpuTaskGraphAnalysis partialAnalysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(partialGraph, scratch, partialAnalysis));
    const GpuTaskGraphDeclarationReadView partialDeclarations = GpuTaskGraphDeclarationReadView(partialGraph);
    ASSERT_TRUE(BuildGpuTaskSchedulingReachability(partialDeclarations, partialAnalysis, reachability));
    EXPECT_TRUE(reachability.reaches(producer, consumer));
    EXPECT_FALSE(reachability.reaches(consumer, producer));
    EXPECT_TRUE(reachability.transitivelyIndependent(producer, independent));
    EXPECT_FALSE(reachability.reaches(tasks[0u], tasks[taskCount - 1u]));

    ASSERT_TRUE(BuildGpuTaskSchedulingReachability(declarations, analysis, reachability));
    EXPECT_TRUE(reachability.reaches(tasks[0u], tasks[taskCount - 1u]));
    EXPECT_FALSE(reachability.transitivelyIndependent(tasks[0u], tasks[taskCount - 1u]));
    EXPECT_FALSE(BuildGpuTaskSchedulingReachability(declarations, partialAnalysis, reachability));
    EXPECT_FALSE(reachability.reaches(tasks[0u], tasks[taskCount - 1u]));
    EXPECT_FALSE(reachability.transitivelyIndependent(tasks[0u], tasks[taskCount - 1u]));
}

void VerifyGpuRouting_SameClassBalancingCountsMergedAndUnroutedPrefixCosts(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    Array<GpuTaskCostHintEnum, 8> costs = Array<GpuTaskCostHintEnum, 8>();
    costs[0u] = GpuTaskCostHint::Large;
    costs[1u] = GpuTaskCostHint::Small;
    costs[2u] = GpuTaskCostHint::Medium;
    costs[3u] = GpuTaskCostHint::Large;
    costs[4u] = GpuTaskCostHint::Tiny;
    costs[5u] = GpuTaskCostHint::Large;
    costs[6u] = GpuTaskCostHint::Small;
    costs[7u] = GpuTaskCostHint::Medium;
    Array<GpuTaskId, 8> tasks = Array<GpuTaskId, 8>();
    for(usize taskIndex = 0u; taskIndex < 8u; ++taskIndex){
        const Expected<Name> identityNameResult = IndexedName(s_GpuCaseQueueScalingPrefix, taskIndex);
        ASSERT_TRUE(identityNameResult.has_value());
        const Name identity = identityNameResult.value();
        GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
        scheduling.cost = costs[taskIndex];
        scheduling.overlapPreferred = taskIndex != 3u;
        scheduling.allowSameClassQueueRouting = taskIndex == 2u || taskIndex >= 4u;
        scheduling.mergeWithPrevious = taskIndex == 1u;
        scheduling.preserveSameClassQueueWithDirectDependency = taskIndex == 6u;
        GpuTaskId dependency = GpuTaskId();
        if(taskIndex == 1u)
            dependency = tasks[0u];
        else if(taskIndex == 6u)
            dependency = tasks[2u];
        Array<GpuTaskId, 1> depArr = Array<GpuTaskId, 1>();
        depArr[0u] = dependency;
        Span<GpuTaskId> depSpan = Span<GpuTaskId>();
        if(dependency.valid())
            depSpan = depArr;
        const Expected<GpuTaskId> taskAdmission = AddTaskWithCommands(
            identity,
            "Weighted Prefix Task",
            GraphicsCommands(),
            scheduling,
            GpuTaskTimingMetadata(),
            depSpan,
            graph
        );
        ASSERT_TRUE(taskAdmission.has_value());
        tasks[taskIndex] = taskAdmission.value();
        ASSERT_TRUE(tasks[taskIndex].valid());
    }
    GpuPhysicalQueueInfo firstAuxiliary = GraphicsQueue(7u);
    firstAuxiliary.queueIndex = 1u;
    GpuPhysicalQueueInfo secondAuxiliary = GraphicsQueue(11u);
    secondAuxiliary.queueIndex = 2u;
    Array<GpuPhysicalQueueInfo, 3> queues = Array<GpuPhysicalQueueInfo, 3>();
    queues[0u] = secondAuxiliary;
    queues[1u] = GraphicsQueue();
    queues[2u] = firstAuxiliary;
    const GpuPhysicalQueueTopology topology = MakeGpuRoutingTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology));

    // Keep merged work on queue zero and route task six to queue seven by affinity.
    Array<u16, 8> expectedQueueIndices = Array<u16, 8>();
    expectedQueueIndices[0u] = 0u;
    expectedQueueIndices[1u] = 0u;
    expectedQueueIndices[2u] = 7u;
    expectedQueueIndices[3u] = 0u;
    expectedQueueIndices[4u] = 11u;
    expectedQueueIndices[5u] = 11u;
    expectedQueueIndices[6u] = 7u;
    expectedQueueIndices[7u] = 7u;
    Array<i32, 8> expectedQueueLoads = Array<i32, 8>();
    expectedQueueLoads[0u] = 10;
    expectedQueueLoads[1u] = 16;
    expectedQueueLoads[2u] = 6;
    expectedQueueLoads[3u] = 10;
    expectedQueueLoads[4u] = 8;
    expectedQueueLoads[5u] = 1;
    expectedQueueLoads[6u] = 8;
    expectedQueueLoads[7u] = 6;
    for(usize taskIndex = 0u; taskIndex < 8u; ++taskIndex){
        const GpuTaskId taskId = tasks[taskIndex];
        const u16 expectedQueueIndex = expectedQueueIndices[taskIndex];
        const i32 expectedQueueLoad = expectedQueueLoads[taskIndex];
        native(in assignments, in taskId, in expectedQueueIndex, in expectedQueueLoad){
            const Core::GpuTaskQueueAssignment* const assignment = assignments.find(taskId);
            ASSERT_NE(assignment, nullptr);
            EXPECT_EQ(assignment->queue.index, expectedQueueIndex);
            EXPECT_EQ(assignment->score.queueLoad, expectedQueueLoad);
        }
    }
    const GpuTaskId sixthTask = tasks[6u];
    native(in assignments, in sixthTask){
        EXPECT_TRUE(assignments.find(sixthTask)->modifiers & Core::GpuTaskQueueAssignmentModifier::DirectDependencyAffinity);
    }
}


