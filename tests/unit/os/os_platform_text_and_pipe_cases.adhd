using namespace NWB::Core;
using GlobalString = AString<Alloc::GlobalArena>;

struct PreeditTestContext{
    NWB::Tests::TestArena<> arena;
    X11PreeditBuffer preedit;
    GlobalString scratch;

    PreeditTestContext()
        : preedit(arena.arena)
        , scratch(arena.arena)
    {}
};

struct WaylandStateContext{
    NWB::Tests::TestArena<> arena;
    GlobalString scratch;
    WaylandTextInputSurroundingState wire;
    WaylandTextInputSerialTracker tracker;
    WaylandTextInputDeferredState deferred;

    WaylandStateContext()
        : scratch(arena.arena)
