////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "commands.adhd"
#include "../paint_types.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> PointerPhase{
    enum Move,
    enum Press,
    enum Release,
    enum Cancel,
    enum Leave,
    enum Scroll,
}

enum<u8> PointerIntent{
    enum Activate,
    enum ContextMenu,
}

// Each contact keeps its identity through release or cancellation; hover is an explicit adapter capability.
class PointerInput{
    public InputSource source;
    public PointerPhase phase = PointerPhase::Enum::Move;
    public PointerIntent intent = PointerIntent::Enum::Activate;
    public b8 extend = false;
    public b8 hoverCapable = false;
    public Point position;
    public f64 scrollX = 0.0;
    public f64 scrollY = 0.0;
    public u64 timestampMs = 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

