void VerifyUiListBuilderScrollbarTests_ThumbUsesItsAcceptedTrackMaximumWhenCandidateHeightChanges(mut UiListBuilderTests self){
    ASSERT_TRUE(self.accept(1u));
    const WidgetId thumb = UiListScrollbarRequireWidgetId(self.id(s_UiListScrollbarListKey, s_UiListScrollbarPanelKey), s_UiListScrollbarKey);
    const Optional<HitTarget> acceptedOpt = FindUiListScrollbarTarget(self, thumb);
    ASSERT_TRUE(acceptedOpt.has_value());
    const HitTarget accepted = acceptedOpt.value();
    const Point origin = UiListScrollbarCenter(accepted.rectangle);
    const Point destination = Point(origin.x, origin.y + 10.0f);
    self.drag(origin, destination);
    ListOptions resized = MakeUiListScrollbarDefaultOptions();
    resized.height.value = 200.0f;
    ASSERT_TRUE(self.prepare(2u, resized));
    const f64 travel = cast<f64>(accepted.gestureReference.height) - cast<f64>(accepted.rectangle.height);
    EXPECT_DOUBLE_EQ(self.m_state.scrollOffset(), (10.0 / travel) * accepted.gestureMaximum);
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    const Optional<HitTarget> committedOpt = FindUiListScrollbarTarget(self, thumb);
    ASSERT_TRUE(committedOpt.has_value());
    EXPECT_FLOAT_EQ(committedOpt.value().gestureReference.height, 190.0f);
}

void VerifyUiListBuilderScrollbarTests_LatestThumbMotionFollowsAnInterveningWheelInNativeInputOrder(mut UiListBuilderTests self){
    ASSERT_TRUE(self.accept(1u));
    const WidgetId thumb = UiListScrollbarRequireWidgetId(self.id(s_UiListScrollbarListKey, s_UiListScrollbarPanelKey), s_UiListScrollbarKey);
    const Optional<HitTarget> acceptedOpt = FindUiListScrollbarTarget(self, thumb);
    ASSERT_TRUE(acceptedOpt.has_value());
    const HitTarget accepted = acceptedOpt.value();
    const Point origin = UiListScrollbarCenter(accepted.rectangle);
    const f32 trackEnd = accepted.gestureReference.y + accepted.gestureReference.height;
    const Point destination = Point(origin.x, trackEnd - accepted.rectangle.height * 0.5f);
    EXPECT_TRUE(self.send(MakeUiInputPointerAt(InputEventType::PrimaryDown, origin)).pointerConsumed);
    InputEvent event = InputEvent();
    event.type = InputEventType::PointerWheel;
    event.position = origin;
    event.scrollY = 1.0;
    EXPECT_TRUE(self.send(event).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiInputPointerAt(InputEventType::PointerMove, destination)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiInputPointerAt(InputEventType::PrimaryUp, destination)).pointerConsumed);
    ASSERT_TRUE(self.prepare(2u));
    EXPECT_DOUBLE_EQ(self.m_state.scrollOffset(), accepted.gestureMaximum);
    EXPECT_EQ(self.m_state.placement().endRow, 100000u);
}

void VerifyUiListBuilderScrollbarTests_EmptyDatasetKeepsABoundedPageCountWithoutReadingText(mut UiListBuilderTests self){
    self.m_source.count = 0u;
