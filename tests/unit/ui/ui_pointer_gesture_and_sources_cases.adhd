class UiPointerGestureTests : RouterTestFixture{
    public Context m_context;

    public b8 commitSingle(in HitTarget target, in u64 generation){
        return this.m_router.commitTargets(MakeUiSingleHitTargetArray(target), generation, Span<PopupScope>(), u64.max);
    }
    public InputRoutingResult sendToContext(in InputEvent event){ return SendUiPointerGestureToContext(this, event); }
    public void complete(){ this.complete(Point(45.0f, 55.0f)); }
    public void complete(in Point position){ CompleteUiPointerGesture(this, position); }
    public Expected<WidgetState> declarePanel(){
        const auto state = this.m_context.declare("title", WidgetKind::Panel);
        if(!state.has_value())
            return MakeUnexpected(state.error());
        return state.value();
    }
    public void clearRetainedRoots(){ this.m_context.retainRoots(Span<WidgetRoot>()); }
    public Expected<WidgetState> prepare(in u64 generation){
        WidgetRoot root;
        root.value = 91u;
        root.generation = 1u;
        return this.prepare(generation, root);
    }
    public Expected<WidgetState> prepare(in u64 generation, in WidgetRoot root){ return PrepareUiPointerGesture(this, generation, root); }
}

class UiPointerGestureValueTests : RouterTestFixture{
    public Array<HitTarget, 2u> m_targets;
    public u64 m_generation = 0u;

    public UiPointerGestureValueTests(){ InitUiPointerGestureValueTargets(this.m_targets); }
    public b8 publish(){ return this.publish(2u); }
    public b8 publish(in usize count){ return PublishUiPointerGestureValueTargets(this, count); }
    public Expected<PointerGesture> take(){ return TakeUiPointerGestureValue(this); }
    public Expected<ControlAction> takeControl(){ return TakeUiPointerGestureValueControl(this); }
    public void focusHost(){ FocusUiPointerGestureValueHost(this); }
}

class UiPointerHitTests : RouterTestFixture{}

class UiPointerHitPopupHarness{
    public InputRouter router;

    public b8 commitWithPopup(in Span<HitTarget> targets, in u64 generation, in PopupScope scope){
        return this.router.commitTargets(targets, generation, MakeUiSinglePopupScopeArray(scope), u64.max);
    }
    public b8 commitSingle(in HitTarget target, in u64 generation){
        return this.router.commitTargets(MakeUiSingleHitTargetArray(target), generation, Span<PopupScope>(), u64.max);
    }
}

class UiPointerSourceTests : RouterTestFixture{
    public Array<HitTarget, 2u> m_targets;

    public UiPointerSourceTests(){
        this.m_targets[0u] = MakeUiPointerSourceTarget(1u, 10.0f);
        this.m_targets[1u] = MakeUiPointerSourceTarget(2u, 110.0f);
    }
    public void setup(){ ASSERT_TRUE(this.m_router.commitTargets(this.m_targets, 1u, Span<PopupScope>(), u64.max)); }
    public void cancelCommand(){ CancelUiPointerSourceCommand(this); }
}


HitTarget MakeUiPointerGestureTarget(in u64 idValue){
    HitTarget target = HitTarget();
    target.id.value = idValue;
    target.rectangle = Rect(10.0f, 20.0f, 80.0f, 30.0f);
    target.clip = Rect(0.0f, 0.0f, 200.0f, 200.0f);
    target.pointerGesture = true;
    return target;
}

InputEvent MakeUiPointerGestureEvent(in InputEventType type){
    return MakeUiPointerEvent(type, Point(15.0f, 25.0f));
}

HitTarget MakeUiPointerHitTargetWithRect(in u64 idValue, in Rect rectangle){
    HitTarget target = HitTarget();
    target.id.value = idValue;
    target.declarationGeneration = 7u;
    target.rectangle = rectangle;
    target.clip = Rect(0.0f, 0.0f, 200.0f, 150.0f);
    target.focusable = true;
    target.activatable = true;
    target.pointerGesture = true;
    return target;
}

HitTarget MakeUiPointerHitTarget(in u64 idValue){
    return MakeUiPointerHitTargetWithRect(idValue, Rect(0.0f, 0.0f, 100.0f, 100.0f));
}

PointerInput MakeUiPointerContactFull(in PointerPhase phase, in InputSource source, in f32 x, in f32 y, in b8 hoverCapable, in PointerIntent intent){
    PointerInput input = PointerInput();
    input.source = source;
    input.phase = phase;
    input.intent = intent;
    input.position = Point(x, y);
    input.hoverCapable = hoverCapable;
    return input;
}

PointerInput MakeUiPointerContactHover(in PointerPhase phase, in InputSource source, in f32 x, in f32 y, in b8 hoverCapable){
    return MakeUiPointerContactFull(phase, source, x, y, hoverCapable, PointerIntent::Activate);
}

PointerInput MakeUiPointerContactAt(in PointerPhase phase, in InputSource source, in f32 x, in f32 y){
    return MakeUiPointerContactFull(phase, source, x, y, false, PointerIntent::Activate);
}

PointerInput MakeUiPointerContact(in PointerPhase phase, in InputSource source){
    return MakeUiPointerContactFull(phase, source, 20.0f, 20.0f, false, PointerIntent::Activate);
}


