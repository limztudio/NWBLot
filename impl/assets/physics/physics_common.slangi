struct NwbPhysicsGpuPushConstants{
    uint itemCount;
    uint itemOffset;
    uint modeOrSecondaryCount;
    uint flags;
    float deltaTime;
    float invDeltaTime;
    float maxLinearVelocity;
    float linearSlop;
    float4 gravitySpeculative;
    uint4 slots0;
    uint4 slots1;
};

struct NwbPhysicsGpuBodyState{
    float4 linearVelocityPad;
    float4 angularVelocityPad;
    float4 deltaPositionFlags;
    float4 deltaRotation;
};

struct NwbPhysicsGpuBodySim{
    float4 positionInvMass;
    float4 rotation;
    float4 forceLinearDamping;
    float4 torqueAngularDamping;
    float4 gravityScaleFlags;
    float4 invInertiaWorldRow0;
    float4 invInertiaWorldRow1;
    float4 invInertiaWorldRow2;
    float4 invInertiaLocalRow0;
    float4 invInertiaLocalRow1;
    float4 invInertiaLocalRow2;
};

struct NwbPhysicsGpuShapeProxy{
    float4 localCenterRadius;
    float4 localExtentOrP1;
    float4 localRotation;
    float4 aabbMinPad;
    float4 aabbMaxPad;
    uint4 bodyIndexTypeShape;
    uint4 filterData;
};

struct NwbPhysicsGpuBroadphasePair{
    uint4 indices;
};

struct NwbPhysicsGpuNarrowphaseManifold{
    uint4 pairInfo;
    float4 normalPad;
    float4 anchorA[NWB_PHYSICS_MAX_MANIFOLD_POINTS];
    float4 anchorBSeparation[NWB_PHYSICS_MAX_MANIFOLD_POINTS];
    uint4 featureIds;
};

struct NwbPhysicsGpuContactPoint{
    float4 rABaseSep;
    float4 rBRelVel;
    float4 impulsesMass;
    float4 anchorLever;
};

struct NwbPhysicsGpuContactConstraint{
    uint4 indicesCountFlags;
    float4 normalFriction;
    float4 tangent1Restitution;
    float4 tangent2Rolling;
    float4 centerATwistMass;
    float4 centerBTwistImpulse;
    float4 softnessTangent00;
    float4 tangentMassFriction;
    float4 invMassTangentVel;
    float4 invIA0;
    float4 invIA1;
    float4 invIA2;
    float4 invIB0;
    float4 invIB1;
    float4 invIB2;
    float4 rollingMass0;
    float4 rollingMass1;
    NwbPhysicsGpuContactPoint points[NWB_PHYSICS_MAX_MANIFOLD_POINTS];
};


