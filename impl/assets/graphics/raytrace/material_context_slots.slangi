////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Shared slot payload for ray-tracing material context buffers.
// Matches ECSRenderDetail::RayTraceMaterialContextSlots exactly.
// Buffers here are global-heap STORAGE_BUFFERs; each shader binds this cbuffer at a spare binding to select typed aliases.


#ifndef NWB_GRAPHICS_RAYTRACE_MATERIAL_CONTEXT_SLOTS_SLANGI
#define NWB_GRAPHICS_RAYTRACE_MATERIAL_CONTEXT_SLOTS_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "../bindless/bindless_heap.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct NwbRayTraceMaterialContextSlots{
    uint4 sceneSlots;    // scene BVH nodes, scene instances, instance-material records, typed material words
    uint4 materialSlots; // mesh-instance material storage, optical scene storage, optical instance count, current CSG context (0xffffffff when absent)
};

#pragma warning(push)
#pragma warning(disable: 39001) // Deliberate typed view of the global UniformBuffer descriptor table.
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_UNIFORM_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] ConstantBuffer<NwbRayTraceMaterialContextSlots, Std140DataLayout> g_NwbHeapMaterialContextSlotBuffers[];
#pragma warning(pop)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


ConstantBuffer<NwbRayTraceMaterialContextSlots, Std140DataLayout> nwbHeapMaterialContextSlots(const uint slot){
    return g_NwbHeapMaterialContextSlotBuffers[slot];
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

