#include <impl/assets_skeleton/joint_types.adhd>
#include <impl/ecs_mesh/skinning/submission_state.adhd>
#include <impl/ecs_skeleton/components.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type MeshSkinningResourceBuffers = Array<BufferHandle, s_MeshSkinningResourceBufferCount>;

class MeshSkinningDeformationInputs{
    public BufferHandle resourceSlotsBuffer;
    public u32 editRevision;
    public u32 skinningMode;

    public MeshSkinningDeformationInputs(){
        this.resourceSlotsBuffer = BufferHandle();
        this.editRevision = 0u;
        this.skinningMode = cast<u32>(SkeletonSkinningMode::LinearBlend);
    }

    public MeshSkinningDeformationInputs(in BufferHandle resourceSlotsBufferIn, in u32 editRevisionIn, in u32 skinningModeIn){
        this.resourceSlotsBuffer = resourceSlotsBufferIn;
        this.editRevision = editRevisionIn;
        this.skinningMode = skinningModeIn;
    }
}

class MeshSkinningDeformationState{
    private Vector<SkeletonJointMatrix> m_acceptedJoints;
    private Vector<SkeletonJointMatrix> m_pendingJoints;
    private MeshSkinningDeformationInputs m_acceptedInputs;
    private MeshSkinningDeformationInputs m_pendingInputs;
    private u64 m_acceptedRevision = 0u;
    private u64 m_candidateSerial = 0u;
    private u64 m_pendingCandidate = 0u;
    private b8 m_current = false;

    public void invalidateCurrent(){
        this.m_current = false;
        this.m_pendingCandidate = 0u;
    }

    public void refreshCurrent(in MeshSkinningDeformationInputs inputs, in Span<SkeletonJointMatrix> joints, in b8 inputDirty){
        this.invalidateCurrent();
        this.m_current = CanReuseMeshSkinningDeformationState(
            inputDirty,
            this.m_acceptedRevision,
            inputs.resourceSlotsBuffer.valid() && inputs.resourceSlotsBuffer == this.m_acceptedInputs.resourceSlotsBuffer,
            inputs.editRevision,
            this.m_acceptedInputs.editRevision,
            inputs.skinningMode,
            this.m_acceptedInputs.skinningMode,
            !joints.empty(),
            joints,
            this.m_acceptedJoints
        );
    }

    public Expected<u64> stage(in MeshSkinningDeformationInputs inputs, in Span<SkeletonJointMatrix> joints){
        this.invalidateCurrent();
        const Expected<u64> candidate = TryStageMeshSkinningDeformationCandidate(
            inputs.resourceSlotsBuffer.valid(),
            joints,
            !joints.empty(),
            this.m_acceptedRevision,
            this.m_candidateSerial,
            this.m_pendingJoints
        );
        if(!candidate.has_value())
            return MakeUnexpected(Failure());
        this.m_pendingInputs = inputs;
        this.m_pendingCandidate = candidate.value();
        return this.m_pendingCandidate;
    }

    public b8 accept(in u64 candidate){
        if(!TryAcceptMeshSkinningDeformationCandidate(candidate, this.m_pendingCandidate, this.m_acceptedRevision, this.m_current))
            return false;
        this.m_acceptedJoints.swap(this.m_pendingJoints);
        this.m_acceptedInputs = this.m_pendingInputs;
        return true;
    }

    public u64 contentRevision()const{
        if(this.m_current)
            return this.m_acceptedRevision;
        return 0u;
    }
}


