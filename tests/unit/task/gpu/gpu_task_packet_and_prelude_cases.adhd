void VerifyGpuPacket_DiscardsTypedPayloadLifecycleOnlyOnceWhenGraphIsAbandoned(){
    u32 acceptedCount = 0u;
    u32 discardedCount = 0u;

    {
        TestArena testArena = TestArena();
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        GpuTaskDesc desc = GpuTaskDesc();
        desc.setIdentity(s_GpuCaseTaskGraphLifecycleDiscarded);
        desc.setMarkerLabel("Discarded Lifecycle Task");
        const Expected<GpuTaskId> taskResult = AddPacketLifecycleTask(graph, desc, acceptedCount, discardedCount);
        ASSERT_TRUE(taskResult.has_value());
        const GpuTaskId task = taskResult.value();
        ASSERT_TRUE(task.valid());

        graph.reset();
        graph.reset();

        EXPECT_EQ(acceptedCount, 0u);
        EXPECT_EQ(discardedCount, 1u);
    }

    {
        TestArena testArena = TestArena();
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        GpuTaskDesc desc = GpuTaskDesc();
        desc.setIdentity(s_GpuCaseTaskGraphLifecycleUnresolved);
        desc.setMarkerLabel("Unresolved Lifecycle Task");
        const Expected<GpuTaskId> taskResult = AddPacketLifecycleTask(graph, desc, acceptedCount, discardedCount);
        ASSERT_TRUE(taskResult.has_value());
        const GpuTaskId task = taskResult.value();
        ASSERT_TRUE(task.valid());
        EXPECT_EQ(GpuTaskGraphDeclarationReadView(graph).taskCount(), 1u);
    }

    EXPECT_EQ(acceptedCount, 0u);
    EXPECT_EQ(discardedCount, 2u);
}

