using namespace NWB;
using namespace NWB::Impl::Ui;

[[nodiscard]] NWB_INLINE HitTarget MakeHost(const u64 id = 1u, const f32 x = 0.0f)noexcept{
    HitTarget target;
    target.id = { id };
    target.declarationGeneration = 7u;
    target.rectangle = { x, 0.0f, 100.0f, 100.0f };
    target.clip = { 0.0f, 0.0f, 300.0f, 200.0f };
    target.focusable = true;
    target.control = { 11u, 21u, 31u };
    target.navigable = true;
    target.scrollable = true;
    target.scrollStep = 72.0;
    target.pageRows = 4u;
    target.gestureMaximum = 2399900.0;
    return target;
}

[[nodiscard]] NWB_INLINE HitTarget MakePart(const HitTarget& host, const u64 id, const Rect& rectangle, const u64 value = 0u)noexcept{
    HitTarget target;
    target.id = { id };
    target.rectangle = rectangle;
    target.clip = host.clip;
    target.declarationGeneration = host.declarationGeneration;
    target.paintOrder = 1u;
    target.control = host.control;
    target.owner = host.id;
    target.ownerDeclarationGeneration = host.declarationGeneration;
    target.value = value;
    target.activatable = true;
    return target;
}

using UiTestSupport::Key;
using UiTestSupport::Pointer;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class UiControlInputTests : public UiTestSupport::RouterTestFixture{
public:
    UiControlInputTests()
        : RouterTestFixture(Name(NWB::Tests::UiCases::s_UiCaseTestsUiControlInput))
    {
        m_targets[0u] = MakeHost();
        m_targets[1u] = MakePart(m_targets[0u], 2u, { 0.0f, 0.0f, 80.0f, 20.0f }, 100000u);
        m_targets[2u] = MakePart(m_targets[0u], 3u, { 90.0f, 20.0f, 10.0f, 20.0f });
        m_targets[2u].activatable = false;
        m_targets[2u].pointerGesture = true;
        m_targets[2u].gestureReference = { 90.0f, 0.0f, 10.0f, 100.0f };
        m_targets[2u].gestureMaximum = m_targets[0u].gestureMaximum;
    }


public:
    [[nodiscard]] InputRoutingResult wheel(const f64 delta = -1.0, const Point& position = { 10.0f, 10.0f }){
        InputEvent event = Pointer(InputEventType::PointerWheel, position);
        event.scrollY = delta;
        return send(event);
    }

    void focus(){
        EXPECT_TRUE(send(Key(InputEventType::KeyDown, Core::Key::Tab)).commandConsumed);
        EXPECT_TRUE(send(Key(InputEventType::KeyUp, Core::Key::Tab)).commandConsumed);
    }

    void revise()noexcept{
        for(auto& target : m_targets)
            ++target.control.contentRevision;
    }

    [[nodiscard]] b8 queueNative(const InputEvent& event){
        return m_router.queue(UiTestSupport::NativeInput(event)).has_value();
    }

    [[nodiscard]] Expected<ControlAction> take()noexcept{
        return m_router.consumeControlAction(m_targets[0u].id, m_targets[0u].declarationGeneration, m_targets[0u].control);
    }


public:
    Array<HitTarget, 3u> m_targets;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


