const AStringView s_UiTextVisibleSampleGlyphText = "A";
const AStringView s_UiTextVisibleWideGlyphText = "W";


usize CountUiTextRegionGlyphIndices(in DrawSnapshot snapshot){
    usize count = 0u;
    const usize commandCount = snapshot.commands().size();
    for(usize cmdIndex = 0u; cmdIndex < commandCount; ++cmdIndex){
        const DrawCommand command = snapshot.commands()[cmdIndex];
        if(command.material == PaintMaterial::Glyph || command.material == PaintMaterial::SdfGlyph)
            count += command.indexCount;
    }
    return count;
}

void ExpectUiTextGlyphRegion(in DrawSnapshot snapshot, in Rect expected){
    const f32 expectedEndX = expected.x + expected.width;
    const f32 expectedEndY = expected.y + expected.height;
    usize count = 0u;
    const usize commandCount = snapshot.commands().size();
    for(usize cmdIndex = 0u; cmdIndex < commandCount; ++cmdIndex){
        const DrawCommand command = snapshot.commands()[cmdIndex];
        if(command.material != PaintMaterial::Glyph && command.material != PaintMaterial::SdfGlyph)
            continue;
        ExpectUiRect(command.clip, expected);
        ASSERT_LE(cast<usize>(command.firstIndex) + command.indexCount, snapshot.indices().size());
        for(u32 index = command.firstIndex; index < command.firstIndex + command.indexCount; ++index){
            ASSERT_LT(snapshot.indices()[index], snapshot.vertices().size());
            const Point position = snapshot.vertices()[snapshot.indices()[index]].position;
            EXPECT_GE(position.x, expected.x);
            EXPECT_LE(position.x, expectedEndX);
            EXPECT_GE(position.y, expected.y);
            EXPECT_LE(position.y, expectedEndY);
        }
        count += command.indexCount;
    }
    EXPECT_GT(count, 0u);
}

Rect UiTextVisibleBakedRect(in PlacedGlyph glyph, in Point origin){
    const FontAtlasGlyph record = FontFaceBakedGlyph(glyph.face, glyph.glyphId);
    const f32 scale = 32.0f / cast<f32>(FontFaceBakedUnitsPerEm(glyph.face));
    return Rect(
        origin.x + glyph.position.x + record.planeLeft * scale,
        origin.y + glyph.position.y + record.planeTop * scale,
        (record.planeRight - record.planeLeft) * scale,
        (record.planeBottom - record.planeTop) * scale
    );
}

b8 PaintUiTextVisibleClipped(mut TextVisibleCoverageTests self, in TextLayout layout, in Rect clip, in Point origin){
    self.m_paint.pushClip(clip);
    const b8 painted = self.m_text.paint(self.m_paint, layout, origin);
    const b8 popped = self.m_paint.popClip();
    return painted && popped;
}

Expected<Rect> ComputeUiTextVisibleRasterRect(mut TextVisibleCoverageTests self, in PlacedGlyph glyph, in f32 fontSize, in DisplayMetrics display, in Point origin){
    const f32 physicalSize = Ceil(fontSize * Max(display.pixelScaleX, display.pixelScaleY));
    if(!FontFaceRasterize(glyph.face, glyph.glyphId, cast<u32>(physicalSize), self.m_bitmap))
        return MakeUnexpected(Failure());
    const f32 scale = physicalSize / fontSize;
    const f64 scaleDouble = cast<f64>(scale);
    const f64 unsnappedX = cast<f64>(origin.x) + cast<f64>(glyph.position.x) + cast<f64>(self.m_bitmap.bearingX) / scaleDouble;
    const f64 unsnappedY = cast<f64>(origin.y) + cast<f64>(glyph.position.y) - cast<f64>(self.m_bitmap.bearingY) / scaleDouble;
    const f64 snappedX = Floor(unsnappedX * cast<f64>(display.pixelScaleX) + 0.5) / cast<f64>(display.pixelScaleX);
    const f64 snappedY = Floor(unsnappedY * cast<f64>(display.pixelScaleY) + 0.5) / cast<f64>(display.pixelScaleY);
    const Rect rectangle = Rect(cast<f32>(snappedX), cast<f32>(snappedY), cast<f32>(self.m_bitmap.width) / scale, cast<f32>(self.m_bitmap.height) / scale);
    if(!(rectangle.width > 0.0f && rectangle.height > 0.0f))
        return MakeUnexpected(Failure());
    return rectangle;
}

SelectablePaintFlags MakeUiSelectablePaintFlags(in b8 enabled, in b8 selected, in b8 hovered, in b8 focused){
    SelectablePaintFlags flags = SelectablePaintFlags();
    flags.enabled = enabled;
    flags.selected = selected;
    flags.hover = hovered;
    flags.focused = focused;
    return flags;
}

Rect UiTextVisibleBakedOutlineCenterClip(in PlacedGlyph glyph, in Point origin){
    const Rect outline = ComputePlacedGlyphOutlineRect(glyph, origin);
    return Rect(outline.x + (outline.width * 0.5f), outline.y + (outline.height * 0.5f), 1.0f, 1.0f);
}

Rect ComputeUiTextVisibleRasterFringe(in Rect raster, in Rect outline){
    if(raster.x + 0.001f < outline.x)
        return Rect(raster.x, raster.y, Min(0.05f, (outline.x - raster.x) * 0.5f), raster.height);
    if(raster.y + 0.001f < outline.y)
        return Rect(raster.x, raster.y, raster.width, Min(0.05f, (outline.y - raster.y) * 0.5f));
    const f32 rasterRight = raster.x + raster.width;
    const f32 rasterBottom = raster.y + raster.height;
    const f32 outlineRight = outline.x + outline.width;
    const f32 outlineBottom = outline.y + outline.height;
    if(rasterRight > outlineRight + 0.001f){
        const f32 fringe = Min(0.05f, (rasterRight - outlineRight) * 0.5f);
        return Rect(rasterRight - fringe, raster.y, fringe, raster.height);
    }
    if(rasterBottom > outlineBottom + 0.001f){
        const f32 fringe = Min(0.05f, (rasterBottom - outlineBottom) * 0.5f);
        return Rect(raster.x, rasterBottom - fringe, raster.width, fringe);
    }
    return Rect();
}

ShapeRequest MakeUiTextRegionShapeRequest(in StringView text, in f32 fontSize){
    ShapeRequest request = ShapeRequest();
    request.text = text;
    request.fontSize = fontSize;
    return request;
}

ShapeRequest MakeUiTextRegionDefaultShapeRequest(in StringView text){
    ShapeRequest request = ShapeRequest();
    request.text = text;
    return request;
}


