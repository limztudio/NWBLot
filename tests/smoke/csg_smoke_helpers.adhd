){
    return CreateSmokeCsgFieldCutter<Impl::CsgSphereShapeParameters>(receiverGroup, shapeType, active, &Impl::CsgSphereShapeParameters::radius, radius, center, rotation, world);
}

FOUNDATION_INLINE Core::ECS::EntityID CreateSmokeCsgSphereCutter(
    const Name receiverGroup,
    const Name shapeType,
    const b8 active,
    const Float4& radius,
    Core::ECS::World& world
){
    return CreateSmokeCsgSphereCutter(receiverGroup, shapeType, active, radius, VectorZero(), QuaternionIdentity(), world);
}

FOUNDATION_INLINE Core::ECS::EntityID CreateSmokeCsgCapsuleCutter(
    const Name receiverGroup,
    const Name shapeType,
    const b8 active,
    const Float4& radiusHalfHeight,
    const SIMDVectorSingle center,
    const SIMDVectorSingle rotation,
    Core::ECS::World& world
){
    return CreateSmokeCsgFieldCutter<Impl::CsgCapsuleShapeParameters>(receiverGroup, shapeType, active, &Impl::CsgCapsuleShapeParameters::radiusHalfHeight, radiusHalfHeight, center, rotation, world);
}

FOUNDATION_INLINE Core::ECS::EntityID CreateSmokeCsgCapsuleCutter(
    const Name receiverGroup,
    const Name shapeType,
    const b8 active,
    const Float4& radiusHalfHeight,
    Core::ECS::World& world
){
    return CreateSmokeCsgCapsuleCutter(receiverGroup, shapeType, active, radiusHalfHeight, VectorZero(), QuaternionIdentity(), world);
}
};


