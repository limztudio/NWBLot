////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <utilities/fbx_to_nwb/module.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ShouldPauseAfterPromptedRun(in b8 prompted, in i32 exitResult){
    return prompted && exitResult >= s_PromptSuccessThreshold;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
i32 RunConsole(in ConsoleArguments arguments){
    b8 prompted = false;
    const i32 result = Run(arguments, prompted);
    if(ShouldPauseAfterPromptedRun(prompted, result)){
        ConsoleWrite("Press Enter to exit...");
        String line;
        if(!ConsoleReadLine(line))
            ConsoleWrite("\n");
    }
    return result;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

