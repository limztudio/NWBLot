////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_SKINNED_MESH_BINDLESS_RESOURCES_SLANGI
#define NWB_GRAPHICS_SKINNED_MESH_BINDLESS_RESOURCES_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "../bindless/bindless_heap.slangi"
#include "../mesh/meshlet_payload.slangi"
#include "constants.h"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct NwbSkinnedMeshSkinInfluence{
    uint2 packedJoint;
    float2 weight01;
    float2 weight23;
};

uint4 nwbSkinnedMeshSkinJoints(const NwbSkinnedMeshSkinInfluence skin){
    return uint4(skin.packedJoint.x & NWB_SKINNED_MESH_SKIN_JOINT_MASK, skin.packedJoint.x >> NWB_SKINNED_MESH_SKIN_JOINT_BITS, skin.packedJoint.y & NWB_SKINNED_MESH_SKIN_JOINT_MASK, skin.packedJoint.y >> NWB_SKINNED_MESH_SKIN_JOINT_BITS);
}

float4 nwbSkinnedMeshSkinWeights(const NwbSkinnedMeshSkinInfluence skin){
    return float4(skin.weight01, skin.weight23);
}

struct NwbSkinnedMeshJointMatrix{
    float4 row0;
    float4 row1;
    float4 row2;
};

struct NwbSkinnedMeshBindlessResources{
    uint4 streamSlots0;
    uint4 streamSlots1;
    uint4 streamSlots2;
    uint4 streamSlots3;
    uint4 streamSlots4;
};

#pragma warning(push)
#pragma warning(disable: 39001)
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_UNIFORM_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] ConstantBuffer<NwbSkinnedMeshBindlessResources, Std140DataLayout> g_NwbHeapSkinnedMeshBindlessResources[];
#pragma warning(pop)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#pragma warning(push)
#pragma warning(disable: 39001)
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] StructuredBuffer<NwbMeshPosition, Std430DataLayout> g_NwbHeapSkinnedMeshPositionBuffers[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] RWStructuredBuffer<NwbMeshPosition, Std430DataLayout> g_NwbHeapSkinnedMeshWritablePositionBuffers[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] StructuredBuffer<NwbMeshHalf4, Std430DataLayout> g_NwbHeapSkinnedMeshHalf4Buffers[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] RWStructuredBuffer<NwbMeshHalf4, Std430DataLayout> g_NwbHeapSkinnedMeshWritableHalf4Buffers[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] StructuredBuffer<NwbMeshletDesc, Std430DataLayout> g_NwbHeapSkinnedMeshletDescBuffers[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] StructuredBuffer<NwbMeshletLocalVertexRef, Std430DataLayout> g_NwbHeapSkinnedMeshletLocalVertexRefBuffers[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] StructuredBuffer<uint, Std430DataLayout> g_NwbHeapSkinnedMeshUintBuffers[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] StructuredBuffer<NwbSkinnedMeshSkinInfluence, Std430DataLayout> g_NwbHeapSkinnedMeshSkinInfluenceBuffers[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] StructuredBuffer<NwbSkinnedMeshJointMatrix, Std430DataLayout> g_NwbHeapSkinnedMeshJointMatrixBuffers[];
#pragma warning(pop)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


StructuredBuffer<NwbMeshPosition, Std430DataLayout> nwbSkinnedMeshHeapPositions(const uint slot){
    return g_NwbHeapSkinnedMeshPositionBuffers[NonUniformResourceIndex(slot)];
}

RWStructuredBuffer<NwbMeshPosition, Std430DataLayout> nwbSkinnedMeshHeapWritablePositions(const uint slot){
    return g_NwbHeapSkinnedMeshWritablePositionBuffers[NonUniformResourceIndex(slot)];
}

StructuredBuffer<NwbMeshHalf4, Std430DataLayout> nwbSkinnedMeshHeapHalf4s(const uint slot){
    return g_NwbHeapSkinnedMeshHalf4Buffers[NonUniformResourceIndex(slot)];
}

RWStructuredBuffer<NwbMeshHalf4, Std430DataLayout> nwbSkinnedMeshHeapWritableHalf4s(const uint slot){
    return g_NwbHeapSkinnedMeshWritableHalf4Buffers[NonUniformResourceIndex(slot)];
}

StructuredBuffer<NwbMeshletDesc, Std430DataLayout> nwbSkinnedMeshHeapMeshlets(const uint slot){
    return g_NwbHeapSkinnedMeshletDescBuffers[NonUniformResourceIndex(slot)];
}

StructuredBuffer<NwbMeshletLocalVertexRef, Std430DataLayout> nwbSkinnedMeshHeapLocalVertexRefs(const uint slot){
    return g_NwbHeapSkinnedMeshletLocalVertexRefBuffers[NonUniformResourceIndex(slot)];
}

StructuredBuffer<uint, Std430DataLayout> nwbSkinnedMeshHeapUints(const uint slot){
    return g_NwbHeapSkinnedMeshUintBuffers[NonUniformResourceIndex(slot)];
}

StructuredBuffer<NwbSkinnedMeshSkinInfluence, Std430DataLayout> nwbSkinnedMeshHeapSkinInfluences(const uint slot){
    return g_NwbHeapSkinnedMeshSkinInfluenceBuffers[NonUniformResourceIndex(slot)];
}

StructuredBuffer<NwbSkinnedMeshJointMatrix, Std430DataLayout> nwbSkinnedMeshHeapJointPalette(const uint slot){
    return g_NwbHeapSkinnedMeshJointMatrixBuffers[NonUniformResourceIndex(slot)];
}

RWByteAddressBuffer nwbSkinnedMeshHeapWritableRawBuffer(const uint slot){
    return g_NwbHeapStorageBuffers[NonUniformResourceIndex(slot)];
}

ConstantBuffer<NwbSkinnedMeshBindlessResources, Std140DataLayout> nwbSkinnedMeshHeapBindlessResources(const uint slot){
    return g_NwbHeapSkinnedMeshBindlessResources[slot];
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

