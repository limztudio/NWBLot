[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/global.adhd.h>
#include <impl/assets/graphics/bvh/scene_refit_constants.h>
#include <impl/assets_graphics/bvh_subsystem.adhd.h>
#include <impl/ecs_render/components.adhd.h>
#include <impl/ecs_render/kernel/compute_pipeline_utils.adhd.h>
#include <impl/ecs_render/kernel/descriptor_register_utils.adhd.h>
#include <impl/ecs_render/kernel/task_graph_resource_utils.adhd.h>
#include <impl/ecs_render/mesh/mesh_system.adhd.h>
#include <impl/ecs_render/raytrace/prepared_builds.adhd.h>
#include <impl/ecs_render/raytrace/prepared_scene_bvh_upload.adhd.h>
#include <impl/ecs_render/raytrace/prepared_scene_sw_bvh_traversal.adhd.h>
#include <impl/ecs_render/raytrace/raytrace_internal.adhd.h>
#include <impl/ecs_render/raytrace/raytracing_system.adhd.h>
#include <impl/ecs_render/raytrace/renderer_raytracing_state.adhd.h>
#include <impl/ecs_render/raytrace/rt_private.adhd.h>
#include <impl/ecs_render/raytrace/scene_bvh_upload_policy.adhd.h>
#include <impl/ecs_render/raytrace/software_scene_refit.adhd.h>
#include <impl/ecs_render/raytrace/types.adhd.h>
#include <impl/ecs_render/shader/shader_system.adhd.h>
#include <impl/ecs_render/shadow/prepared_shadow_material_context.adhd.h>
#include <impl/ecs_scene/module.adhd.h>

#include <core/alloc/global.h>
#include <core/alloc/scratch.h>
#include <core/common/log.h>
#include <core/ecs/world.h>
#include <core/graphics/api.h>
#include <core/graphics/runtime/runtime.h>
#include <core/graphics/shader_archive.h>
#include <core/task/gpu/task_graph.h>

#include <global/algorithm.h>
#include <global/arena_object.h>
