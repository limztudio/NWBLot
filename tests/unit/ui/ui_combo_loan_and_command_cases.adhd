void VerifyUiCommandOwnerTests_EnterIntentionSharesNavigationSequenceWithoutAnActivation(mut UiCommandOwnerTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    self.focus();
    self.press(CoreKey::Down);
    self.press(CoreKey::Enter);
    self.press(CoreKey::Up);
    const Expected<ControlAction> downResult = self.take();
    ASSERT_TRUE(downResult.has_value());
    const ControlAction down = downResult.value();
    const Expected<ControlAction> submitResult = self.take();
    ASSERT_TRUE(submitResult.has_value());
    const ControlAction submit = submitResult.value();
    const Expected<ControlAction> upResult = self.take();
    ASSERT_TRUE(upResult.has_value());
    const ControlAction up = upResult.value();
    EXPECT_EQ(down.kind, ControlActionKind::Down);
    EXPECT_EQ(submit.kind, ControlActionKind::Submit);
    EXPECT_EQ(up.kind, ControlActionKind::Up);
    EXPECT_LT(down.id.sequence, submit.id.sequence);
    EXPECT_LT(submit.id.sequence, up.id.sequence);
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
}

void VerifyUiCommandOwnerTests_AcceptedOwnerGeometryAndPageRowsRemainUntilTheCandidateIsCommitted(mut UiCommandOwnerTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    self.focus();
    self.m_targets[1u].pageRows = 17u;
    self.m_targets[1u].rectangle.height = 180.0f;
    self.press(CoreKey::PageDown);
    const Expected<ControlAction> actionResult1 = self.take();
    ASSERT_TRUE(actionResult1.has_value());
    EXPECT_EQ(actionResult1.value().pageRows, 5u);
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u));
    self.press(CoreKey::PageDown);
    const Expected<ControlAction> actionResult2 = self.take();
    ASSERT_TRUE(actionResult2.has_value());
    EXPECT_EQ(actionResult2.value().pageRows, 17u);
    EXPECT_EQ(actionResult2.value().id.layoutGeneration, 2u);
}

void VerifyUiCommandOwnerTests_MissingDisabledAndNonNavigableOwnersRejectCandidateAcceptance(mut UiCommandOwnerTests self){
    EXPECT_FALSE(self.m_router.commitTargets(MakeUiSingleHitTargetArray(self.m_targets[0u]), 1u));
    self.m_targets[1u].enabled = false;
    EXPECT_FALSE(self.m_router.commitTargets(self.m_targets, 1u));
    self.m_targets[1u].enabled = true;
    self.m_targets[1u].navigable = false;
    EXPECT_FALSE(self.m_router.commitTargets(self.m_targets, 1u));
    self.m_targets[1u].navigable = true;
    self.m_targets[1u].focusable = false;
    EXPECT_FALSE(self.m_router.commitTargets(self.m_targets, 1u));
    EXPECT_TRUE(self.m_router.targets().empty());
}

void VerifyUiCommandOwnerTests_PartialBindingAndWrongOwnerEpochRejectRatherThanSwallowingEditorKeys(mut UiCommandOwnerTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    self.focus();
    ++self.m_targets[0u].commandOwnerDeclarationGeneration;
    EXPECT_FALSE(self.m_router.commitTargets(self.m_targets, 2u));
    EXPECT_EQ(self.m_router.layoutGeneration(), 1u);
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    const HitTarget owner = self.m_targets[1u];
    self.bind(owner);
    ++self.m_targets[0u].commandControl.contentRevision;
    EXPECT_FALSE(self.m_router.commitTargets(self.m_targets, 2u));
    self.bind(owner);
    self.m_targets[0u].commandOwner = WidgetId();
    EXPECT_FALSE(self.m_router.commitTargets(self.m_targets, 2u));
    self.press(CoreKey::Down);
    const Expected<ControlAction> actionResult = self.take();
    ASSERT_TRUE(actionResult.has_value());
    EXPECT_EQ(actionResult.value().id.layoutGeneration, 1u);
}

void VerifyUiCommandOwnerTests_NonEditableDisabledAndPartSourcesCannotBorrowNavigation(mut UiCommandOwnerTests self){
    self.m_targets[0u].textEditable = false;
    EXPECT_FALSE(self.m_router.commitTargets(self.m_targets, 1u));
    self.m_targets[0u].textEditable = true;
    self.m_targets[0u].enabled = false;
    EXPECT_FALSE(self.m_router.commitTargets(self.m_targets, 1u));
    self.m_targets[0u].enabled = true;
    self.m_targets[0u].focusable = false;
    EXPECT_FALSE(self.m_router.commitTargets(self.m_targets, 1u));
    self.m_targets[0u].focusable = true;
    self.m_targets[0u].owner = self.m_targets[1u].id;
    self.m_targets[0u].ownerDeclarationGeneration = self.m_targets[1u].declarationGeneration;
    EXPECT_FALSE(self.m_router.commitTargets(self.m_targets, 1u));
}

void VerifyUiCommandOwnerTests_SelfDelegationAndCompetingNavigationHostsAreRejected(mut UiCommandOwnerTests self){
    self.m_targets[0u].commandOwner = self.m_targets[0u].id;
    self.m_targets[0u].commandOwnerDeclarationGeneration = self.m_targets[0u].declarationGeneration;
    self.m_targets[0u].commandControl = self.m_targets[0u].control;
    EXPECT_FALSE(self.m_router.commitTargets(self.m_targets, 1u));
    const HitTarget owner = self.m_targets[1u];
    self.bind(owner);
    self.m_targets[0u].navigable = true;
    EXPECT_FALSE(self.m_router.commitTargets(self.m_targets, 1u));
}

void VerifyUiCommandOwnerTests_RebindingEditorRetiresQueuedActionsAndTheHeldInitialOwnerPermanently(mut UiCommandOwnerTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    self.focus();
    EXPECT_TRUE(self.send(MakeUiCommandOwnerKeyEvent(InputEventType::KeyDown, CoreKey::Down, false)).commandConsumed);
    ASSERT_EQ(self.m_router.controlActions().size(), 1u);
    const HitTarget secondOwner = self.m_targets[2u];
    self.bind(secondOwner);
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u));
    EXPECT_TRUE(self.m_router.controlActions().empty());
    const HitTarget firstOwner = self.m_targets[1u];
    self.bind(firstOwner);
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 3u));
    EXPECT_TRUE(self.send(MakeUiCommandOwnerKeyEvent(InputEventType::KeyDown, CoreKey::Down, true)).commandConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.send(MakeUiCommandOwnerKeyEvent(InputEventType::KeyUp, CoreKey::Down, false)).commandConsumed);
    self.press(CoreKey::Down);
    const Expected<ControlAction> actionResult = self.take();
    ASSERT_TRUE(actionResult.has_value());
}

void VerifyUiCommandOwnerTests_RebindingEditorWhileSubmitIsHeldCannotRedirectOrReviveItsRelease(mut UiCommandOwnerTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    self.focus();
    EXPECT_TRUE(self.send(MakeUiCommandOwnerKeyEvent(InputEventType::KeyDown, CoreKey::Enter, false)).commandConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    const HitTarget secondOwner = self.m_targets[2u];
    self.bind(secondOwner);
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u));
    const HitTarget firstOwner = self.m_targets[1u];
    self.bind(firstOwner);
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 3u));
    EXPECT_TRUE(self.send(MakeUiCommandOwnerKeyEvent(InputEventType::KeyUp, CoreKey::Enter, false)).commandConsumed);
    EXPECT_FALSE(self.take().has_value());
    EXPECT_FALSE(self.take(2u).has_value());
    self.press(CoreKey::Enter);
    const Expected<ControlAction> submitted = self.take();
    ASSERT_TRUE(submitted.has_value());
    EXPECT_EQ(submitted.value().kind, ControlActionKind::Submit);
    EXPECT_FALSE(self.take(2u).has_value());
}

void VerifyUiCommandOwnerTests_OmittedEditorRetiresItsActionsEvenWhenTheListSurvives(mut UiCommandOwnerTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    self.focus();
    EXPECT_TRUE(self.send(MakeUiCommandOwnerKeyEvent(InputEventType::KeyDown, CoreKey::Down, false)).commandConsumed);
    Array<HitTarget, 2u> remaining = Array<HitTarget, 2u>();
    remaining[0u] = self.m_targets[1u];
    remaining[1u] = self.m_targets[2u];
    ASSERT_TRUE(self.m_router.commitTargets(remaining, 2u));
    EXPECT_TRUE(self.m_router.controlActions().empty());
    self.m_targets[1u].focusOnCommit = true;
    remaining[0u] = self.m_targets[1u];
    ASSERT_TRUE(self.m_router.commitTargets(remaining, 3u));
    EXPECT_EQ(self.m_router.focus(), self.m_targets[1u].id);
    EXPECT_TRUE(self.send(MakeUiCommandOwnerKeyEvent(InputEventType::KeyDown, CoreKey::Down, true)).commandConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.send(MakeUiCommandOwnerKeyEvent(InputEventType::KeyUp, CoreKey::Down, false)).commandConsumed);
}

void VerifyUiCommandOwnerTests_RemovingTheBindingFencesHeldNavigationWhileOrdinaryEditingContinues(mut UiCommandOwnerTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    self.focus();
    EXPECT_TRUE(self.send(MakeUiCommandOwnerKeyEvent(InputEventType::KeyDown, CoreKey::Down, false)).commandConsumed);
    self.clearBinding();
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u));
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    self.press(CoreKey::Left);
    const HitTarget firstOwner = self.m_targets[1u];
    self.bind(firstOwner);
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 3u));
    EXPECT_TRUE(self.send(MakeUiCommandOwnerKeyEvent(InputEventType::KeyDown, CoreKey::Down, true)).commandConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.send(MakeUiCommandOwnerKeyEvent(InputEventType::KeyUp, CoreKey::Down, false)).commandConsumed);
}

void VerifyUiCommandOwnerTests_ReplacedEditorDeclarationOrModelTokenRetiresCopiedActions(mut UiCommandOwnerTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    self.focus();
    self.press(CoreKey::Down);
    ++self.m_targets[0u].declarationGeneration;
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u));
    EXPECT_TRUE(self.m_router.controlActions().empty());
    self.focus();
    self.press(CoreKey::Down);
    ++self.m_targets[0u].control.instanceGeneration;
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 3u));
    EXPECT_TRUE(self.m_router.controlActions().empty());
}

void VerifyUiCommandOwnerTests_FenceControlRetiresTheDelegateWithoutStealingEditorFocus(mut UiCommandOwnerTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    self.focus();
    EXPECT_TRUE(self.send(MakeUiCommandOwnerKeyEvent(InputEventType::KeyDown, CoreKey::Down, false)).commandConsumed);
    ControlToken replacement = self.m_targets[1u].control;
    ++replacement.contentRevision;
    self.m_router.fenceControl(self.m_targets[1u].id, self.m_targets[1u].declarationGeneration, replacement);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    EXPECT_TRUE(self.send(MakeUiCommandOwnerKeyEvent(InputEventType::KeyDown, CoreKey::Down, true)).commandConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.send(MakeUiCommandOwnerKeyEvent(InputEventType::KeyUp, CoreKey::Down, false)).commandConsumed);
}

void VerifyUiCommandOwnerTests_PopupDelegationRetainsItsAcceptedScopeAndCannotCrossLayers(mut UiCommandOwnerTests self){
    const PopupScope scope = self.popup();
    for(mut HitTarget target : self.m_targets){
        target.popup = scope.token;
        target.layer = scope.layer;
    }
    HitTarget barrier = HitTarget();
    barrier.id = scope.token.widget;
    barrier.declarationGeneration = scope.token.declarationGeneration;
    barrier.rectangle = scope.bounds;
    barrier.clip = scope.viewport;
    barrier.popup = scope.token;
    barrier.layer = scope.layer;
    Array<HitTarget, 4u> targets = Array<HitTarget, 4u>();
    targets[0u] = barrier;
    targets[1u] = self.m_targets[0u];
    targets[2u] = self.m_targets[1u];
    targets[3u] = self.m_targets[2u];
    ASSERT_TRUE(self.m_router.commitTargets(targets, 1u, MakeUiSinglePopupScopeArray(scope)));
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    self.press(CoreKey::Down);
    const Expected<ControlAction> actionResult = self.take();
    ASSERT_TRUE(actionResult.has_value());
    EXPECT_EQ(actionResult.value().popup, scope.token);
    targets[2u].popup = PopupToken();
    targets[2u].layer = 0u;
    EXPECT_FALSE(self.m_router.commitTargets(targets, 2u, MakeUiSinglePopupScopeArray(scope)));
    EXPECT_EQ(self.m_router.layoutGeneration(), 1u);
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
}

void VerifyUiCommandOwnerTests_HeldEnterCannotSubmitAgainUntilItsConsumedRelease(mut UiCommandOwnerTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    self.focus();
    EXPECT_TRUE(self.send(MakeUiCommandOwnerKeyEvent(InputEventType::KeyDown, CoreKey::Enter, false)).commandConsumed);
    EXPECT_FALSE(self.take().has_value());
    EXPECT_TRUE(self.send(MakeUiCommandOwnerKeyEvent(InputEventType::KeyDown, CoreKey::Enter, true)).commandConsumed);
    EXPECT_FALSE(self.take().has_value());
    EXPECT_TRUE(self.send(MakeUiCommandOwnerKeyEvent(InputEventType::KeyUp, CoreKey::Enter, false)).commandConsumed);
    const Expected<ControlAction> actionResult1 = self.take();
    ASSERT_TRUE(actionResult1.has_value());
    EXPECT_EQ(actionResult1.value().kind, ControlActionKind::Submit);
    EXPECT_FALSE(self.take().has_value());
    self.press(CoreKey::Enter);
    const Expected<ControlAction> actionResult2 = self.take();
    ASSERT_TRUE(actionResult2.has_value());
}


