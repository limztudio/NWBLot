////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_ui/toolkit/text/sdf_page.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type SharedBakedFontAtlas = Shared<BakedFontAtlas>;

class BakedFontAtlas : NoCopy{
    private Vector<FontAtlasGlyph> m_glyphs;
    private Vector<SharedSdfAtlasPage> m_pages;
    private u32 m_unitsPerEm;
    private u32 m_bakePpem;
    private b8 m_ready;

    public BakedFontAtlas(in SharedPool pool, in FontAtlas atlas, in u64 fontGeneration){
        in FontAtlasPayload payload = atlas.payload();
        this.m_unitsPerEm = payload.unitsPerEm;
        this.m_bakePpem = payload.bakePpem;
        this.m_glyphs = payload.glyphs;
        this.m_ready = this.installPages(pool, atlas, fontGeneration);
    }

    private b8 installPages(in SharedPool pool, in FontAtlas atlas, in u64 fontGeneration){
        in FontAtlasPayload payload = atlas.payload();
        this.m_pages.reserve(payload.groups.size());
        const u64 identity = AllocateServiceIdentity();
        for(u32 group = 0u; group < payload.groups.size(); ++group){
            Expected<SharedSdfAtlasPage> page = CreateSdfAtlasPage(pool, atlas, fontGeneration, identity, group);
            if(!page.has_value())
                return false;
            this.m_pages.push_back(page.value());
        }
        return true;
    }

    public b8 valid()const{ return this.m_ready; }
    public u32 unitsPerEm()const{ return this.m_unitsPerEm; }
    public u32 bakePpem()const{ return this.m_bakePpem; }
    public b8 hasGlyph(in u32 glyphId)const{ return glyphId < this.m_glyphs.size(); }
    public in FontAtlasGlyph glyph(in u32 glyphId)const{
        if(!this.hasGlyph(glyphId))
            TerminateInvariant();
        return this.m_glyphs[glyphId];
    }
    public in SharedSdfAtlasPage page(in u32 group)const{
        if(group >= this.m_pages.size())
            TerminateInvariant();
        return this.m_pages[group];
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<SharedBakedFontAtlas> CreateBakedFontAtlas(in SharedPool pool, in FontAtlas atlas, in u64 fontGeneration){
    Expected<SharedBakedFontAtlas> candidate = pool.make<BakedFontAtlas>(pool, atlas, fontGeneration);
    if(!candidate.has_value() || !candidate.value().deref().valid())
        return MakeUnexpected(Failure());
    return candidate;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

