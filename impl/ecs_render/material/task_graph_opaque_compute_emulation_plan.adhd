////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/material/generated_geometry_validation.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class OpaqueRegularComputeEmulationGraphPlan{
    public AliasFreeComputeEmulationGraphPlan generated;
    public Vector<MaterialPassDrawItem> meshDrawItems;
    public Vector<MaterialPassDrawItem> indexedDrawItems;

    public void reset(){
        this.meshDrawItems.clear();
        this.indexedDrawItems.clear();
        this.generated.reset();
    }

    public b8 capture(in MaterialPassDrawItemsView source, in b8 requireCsg){
        this.reset();
        if(source.computeDrawItems.empty())
            return false;
        this.meshDrawItems.reserve(source.meshDrawItems.size());
        this.meshDrawItems.assign(source.meshDrawItems.begin(), source.meshDrawItems.end());
        this.indexedDrawItems.reserve(source.indexedDrawItems.size());
        this.indexedDrawItems.assign(source.indexedDrawItems.begin(), source.indexedDrawItems.end());
        if(!this.generated.capture(source, requireCsg)){
            this.reset();
            return false;
        }
        return true;
    }

    public MaterialPassDrawItemsView drawItemsView()const{
        return MaterialPassDrawItemsView(this.meshDrawItems, this.indexedDrawItems, this.generated.drawItems);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

