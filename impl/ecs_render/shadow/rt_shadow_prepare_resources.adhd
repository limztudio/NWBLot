////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/shadow/rt_shadow_internal_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ShadowPrepareBufferRequest{
    public BufferHandle buffer;
    public GpuGraphResourceId resource;
    public b8 listedForTrace = false;
    public b8 selected = false;
}

class ShadowPrepareGeometryResources : NoCopy{
    public Vector<GpuGraphResourceId> m_blasBuildInputs;
    public Vector<GpuGraphResourceId> m_remainingTraceGeometry;
    private ShadowPrepareGeometryInputs m_inputs;
    private FixedVector<ShadowPrepareBufferRequest, s_ShadowTraceInlineCapacity> m_inlineRequests;
    private Vector<ShadowPrepareBufferRequest> m_requests;
    private HashMap<usize, usize> m_bufferIndices;
    private HashMap<u32, usize> m_resourceIndices;
    private HashSet<Name> m_names;
    private Vector<u8> m_traceResourceSelected;
    private u64 m_graphGeneration = 0u;
    private b8 m_promoted = false;
    private b8 m_namesPrepared = false;

    public ShadowPrepareGeometryResources(in ShadowPrepareGeometryInputs inputs){
        this.m_inputs = inputs;
    }

    private usize count()const{
        if(this.m_promoted)
            return this.m_requests.size();
        return this.m_inlineRequests.size();
    }

    private mut ShadowPrepareBufferRequest at(in usize index){
        if(this.m_promoted)
            return this.m_requests[index];
        return this.m_inlineRequests[index];
    }

    private usize findBuffer(in BufferHandle buffer)const{
        if(buffer.valid()){
            if(this.m_promoted){
                const auto found = this.m_bufferIndices.find(buffer.identity());
                if(found != this.m_bufferIndices.end())
                    return found.value();
            }
            else{
                for(usize i = 0u; i < this.m_inlineRequests.size(); ++i){
                    if(this.m_inlineRequests[i].buffer.identity() == buffer.identity())
                        return i;
                }
            }
        }
        return usize.max;
    }

    private void add(in BufferHandle buffer){
        if(!buffer.valid())
            return;
        ShadowPrepareBufferRequest request;
        request.buffer = buffer;
        if(!this.m_promoted){
            if(this.findBuffer(buffer) != usize.max)
                return;
            if(this.m_inlineRequests.size() < s_ShadowTraceInlineCapacity){
                this.m_inlineRequests.push_back(request);
                return;
            }
            const usize reserveCapacity = this.m_inputs.blasBuilds.size() * 2u;
            this.m_requests.reserve(reserveCapacity);
            this.m_bufferIndices.reserve(reserveCapacity);
            this.m_resourceIndices.reserve(reserveCapacity);
            for(in ShadowPrepareBufferRequest entry : this.m_inlineRequests){
                this.m_bufferIndices.try_emplace(entry.buffer.identity(), this.m_requests.size());
                this.m_requests.push_back(entry);
            }
            this.m_inlineRequests.clear();
            this.m_promoted = true;
        }
        if(this.m_bufferIndices.try_emplace(buffer.identity(), this.m_requests.size()).second)
            this.m_requests.push_back(request);
    }

    private usize findResource(in GpuGraphResourceId resource)const{
        if(CanMatchResolvedShadowPrepareRequest(resource.valid(), resource.generation, this.m_graphGeneration)){
            if(this.m_promoted){
                const auto found = this.m_resourceIndices.find(resource.index);
                if(found != this.m_resourceIndices.end())
                    return found.value();
            }
            else{
                for(usize i = 0u; i < this.m_inlineRequests.size(); ++i){
                    if(this.m_inlineRequests[i].resource == resource)
                        return i;
                }
            }
        }
        return usize.max;
    }

    public void prepareStorage(in b8 graphOwned){
        if(graphOwned){
            for(in PreparedMeshBlasBuild build : this.m_inputs.blasBuilds){
                this.add(build.positionBuffer);
                this.add(build.triangleIndexBuffer);
            }
        }
        this.m_blasBuildInputs.reserve(this.count());
        this.m_remainingTraceGeometry.reserve(this.m_inputs.traceResources.size());
        if(graphOwned && this.count() != 0u)
            this.m_traceResourceSelected.resize(this.m_inputs.traceResources.size(), 0u);
    }

    public b8 gatherBuildInputs(in GpuTaskGraph graph, in b8 graphOwned){
        if(!graphOwned)
            return true;
        if(this.count() != 0u){
            GpuTaskGraphDeclarationReadView declarations(graph);
            if(!declarations.valid())
                return false;
            this.m_graphGeneration = declarations.generation();
            for(usize i = 0u; i < this.count(); ++i){
                mut ShadowPrepareBufferRequest request = this.at(i);
                request.resource = declarations.findImportedBuffer(request.buffer);
                if(this.m_promoted && request.resource.valid() && !this.m_resourceIndices.try_emplace(request.resource.index, i).second)
                    TerminateInvariant();
            }
            for(usize traceIndex = 0u; traceIndex < this.m_inputs.traceResources.size(); ++traceIndex){
                const usize index = this.findResource(this.m_inputs.traceResources[traceIndex]);
                if(index != usize.max){
                    this.at(index).listedForTrace = true;
                    this.m_traceResourceSelected[traceIndex] = 1u;
                }
            }
        }
        for(in PreparedMeshBlasBuild build : this.m_inputs.blasBuilds){
            if(!build.positionBuffer.valid() || !build.triangleIndexBuffer.valid())
                return false;
        }
        for(usize i = 0u; i < this.count(); ++i){
            in ShadowPrepareBufferRequest request = this.at(i);
            if(!CanAppendShadowPrepareBuildInput(true, request.resource.valid(), request.listedForTrace))
                return false;
        }
        for(usize i = 0u; i < this.count(); ++i){
            mut ShadowPrepareBufferRequest request = this.at(i);
            this.m_blasBuildInputs.push_back(request.resource);
            request.selected = true;
        }
        return true;
    }

    public b8 gatherRemainingTraceResources(){
        if(this.count() == 0u || this.m_traceResourceSelected.size() != this.m_inputs.traceResources.size()){
            for(in GpuGraphResourceId resource : this.m_inputs.traceResources){
                if(!resource.valid())
                    return false;
                this.m_remainingTraceGeometry.push_back(resource);
            }
            return true;
        }
        for(usize traceIndex = 0u; traceIndex < this.m_inputs.traceResources.size(); ++traceIndex){
            in GpuGraphResourceId resource = this.m_inputs.traceResources[traceIndex];
            if(!resource.valid())
                return false;
            if(this.m_traceResourceSelected[traceIndex] == 0u)
                this.m_remainingTraceGeometry.push_back(resource);
        }
        return true;
    }

    public b8 isPreparedMeshBlasBuild(in Name meshName){
        if(!this.m_inputs.blasBuildsGraphOwned)
            return false;
        if(ShouldUseInlinePreparedBlasNameScan(this.m_inputs.blasBuilds.size())){
            for(in PreparedMeshBlasBuild build : this.m_inputs.blasBuilds){
                if(build.meshName == meshName)
                    return true;
            }
            return false;
        }
        if(!this.m_namesPrepared){
            for(in PreparedMeshBlasBuild build : this.m_inputs.blasBuilds)
                this.m_names.insert(build.meshName);
            this.m_namesPrepared = true;
        }
        return this.m_names.contains(meshName);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ShouldUseInlinePreparedBlasNameScan(in usize buildCount){
    return buildCount <= s_SmallInlineIndexCapacity;
}

b8 CanMatchResolvedShadowPrepareRequest(in b8 resourceValid, in u64 resourceGeneration, in u64 graphGeneration){
    return resourceValid && resourceGeneration == graphGeneration;
}

b8 CanAppendShadowPrepareBuildInput(in b8 hasRequest, in b8 resourceValid, in b8 listedForTrace){
    return hasRequest && resourceValid && listedForTrace;
}

ResourceStates ShadowPrepareBlasInitialState(in b8 fresh){
    if(fresh)
        return ResourceStates::Common;
    return ResourceStates::Unknown;
}

[cpp_unwind]
b8 ShadowPrepareResourcePlanner::prepare(in ShadowPrepareResourceInputs inputs, mut ShadowPrepareResourcePlan result){

    const auto currentBindlessSlots = inputs.currentBindlessSlots;
    const auto materialContextSlots = inputs.materialContextSlots;
    const auto sceneTlasBuildGraphOwned = inputs.sceneTlasBuildGraphOwned;
    const auto meshBlasBuildsGraphOwned = inputs.meshBlasBuildsGraphOwned;
    const auto meshBlasGeometryBuildInputStatesGraphOwned = inputs.meshBlasGeometryBuildInputStatesGraphOwned;

    ShadowPrepareGeometryInputs geometryInputs;
    geometryInputs.blasBuilds = inputs.preparedMeshBlasBuilds;
    geometryInputs.traceResources = inputs.shadowTraceGeometryResources;
    geometryInputs.blasBuildsGraphOwned = meshBlasBuildsGraphOwned;
    ShadowPrepareGeometryResources geometryResources(geometryInputs);
    MeshBlasGraphStateVector liveMeshBlasGraphStates;
    this.m_meshSystem.collectBlasGraphStates(liveMeshBlasGraphStates);
    result.resourceUses.reserve(ResolveShadowPrepareResourceUseReserveCount(
        inputs.uploads.csgTraceContext.valid(),
        sceneTlasBuildGraphOwned && inputs.uploads.tlasInstanceBuffer.valid(),
        inputs.shadowTraceGeometryResources.size(),
        inputs.softwareBvhBuildStateResources.size(),
        liveMeshBlasGraphStates.size(),
        inputs.preparedMeshBlasBuilds.size()
    ));
    result.accelStructFinalizeResourceUses.reserve(ResolveExpectedAccelStructFinalizeResourceUseCount(sceneTlasBuildGraphOwned, inputs.preparedMeshBlasBuilds.size()));
    geometryResources.prepareStorage(meshBlasGeometryBuildInputStatesGraphOwned);
    result.resourceUses.push_back(ReadWriteUse(currentBindlessSlots, ResourceStates::ConstantBuffer));
    result.resourceUses.push_back(WriteUse(materialContextSlots, ResourceStates::ConstantBuffer));
    if(sceneTlasBuildGraphOwned && inputs.uploads.tlasInstanceBuffer.valid())
        result.resourceUses.push_back(ReadUse(inputs.uploads.tlasInstanceBuffer, ResourceStates::AccelStructBuildInput));
    if(inputs.uploads.csgTraceContext.valid())
        result.resourceUses.push_back(WriteUse(inputs.uploads.csgTraceContext, ResourceStates::ShaderResource));
    if(inputs.uploads.causticEmissionTargets.valid())
        result.resourceUses.push_back(WriteUse(inputs.uploads.causticEmissionTargets, ResourceStates::ShaderResource));
    if(inputs.uploads.surfelFrameConstants.valid())
        result.resourceUses.push_back(WriteUse(inputs.uploads.surfelFrameConstants, ResourceStates::ConstantBuffer));
    if(inputs.uploads.shadowInstanceMaterials.valid())
        result.resourceUses.push_back(WriteUse(inputs.uploads.shadowInstanceMaterials, ResourceStates::ShaderResource));
    if(inputs.uploads.shadowInstances.valid())
        result.resourceUses.push_back(WriteUse(inputs.uploads.shadowInstances, ResourceStates::ShaderResource));
    if(inputs.uploads.shadowMaterialTyped.valid())
        result.resourceUses.push_back(WriteUse(inputs.uploads.shadowMaterialTyped, ResourceStates::ShaderResource));
    if(inputs.uploads.sceneBvhNodes.valid())
        result.resourceUses.push_back(WriteUse(inputs.uploads.sceneBvhNodes, ResourceStates::ShaderResource));
    if(inputs.uploads.sceneBvhInstances.valid())
        result.resourceUses.push_back(WriteUse(inputs.uploads.sceneBvhInstances, ResourceStates::ShaderResource));

    b8 resourcesImported = true;
    if(!geometryResources.gatherBuildInputs(this.m_graph, meshBlasGeometryBuildInputStatesGraphOwned)){
        warning("RendererSystem: frozen BLAS geometry inputs are missing graph resources");
        return false;
    }
    if(meshBlasBuildsGraphOwned){
        for(in PreparedMeshBlasBuild build : inputs.preparedMeshBlasBuilds){
            const auto blasIdentity = DeriveName(build.meshName, s_BlasNameSuffix);
            if(!blasIdentity.has_value()){
                resourcesImported = false;
                continue;
            }
            const ResourceStates blasInitialState = ShadowPrepareBlasInitialState(build.backingFresh);
            GpuGraphResourceDesc blasDesc = AccelStructResourceDesc(blasIdentity.value(), "Prepared Mesh BLAS");
            blasDesc.setInitialState(blasInitialState);
            const auto blas = this.m_graph.importAccelStruct(build.blas, blasDesc);
            resourcesImported = resourcesImported && blas.has_value();
            if(blas.has_value()){
                result.resourceUses.push_back(ReadWriteUse(blas.value(), ResourceStates::AccelStructWrite));
                result.accelStructFinalizeResourceUses.push_back(ReadUse(blas.value(), ResourceStates::AccelStructRead));
            }
        }
    }
    GpuGraphResourceSetId meshBlasGeometryBuildInputSet;
    if(meshBlasGeometryBuildInputStatesGraphOwned && !geometryResources.m_blasBuildInputs.empty()){
        GpuGraphResourceSetDesc setDesc;
        setDesc.setIdentity(s_ShadowPrepareBlasGeometryBuildInputs)
            .setMarkerLabel("Shadow Prepare BLAS Geometry Build Inputs")
            .setMembers(geometryResources.m_blasBuildInputs);
        const auto meshBlasGeometryBuildInputSetResult = this.m_graph.importResourceSet(setDesc);
        if(meshBlasGeometryBuildInputSetResult.has_value())
            meshBlasGeometryBuildInputSet = meshBlasGeometryBuildInputSetResult.value();
    }
    const b8 meshBlasGeometryBuildInputSetGraphOwned = meshBlasGeometryBuildInputSet.valid();
    if(meshBlasGeometryBuildInputStatesGraphOwned && !meshBlasGeometryBuildInputSetGraphOwned){
        for(in GpuGraphResourceId resource : geometryResources.m_blasBuildInputs)
            result.resourceUses.push_back(ReadWriteUse(resource, ResourceStates::AccelStructBuildInput));
    }
    GpuTaskResourceSetUse meshBlasGeometryBuildInputSetUse;
    meshBlasGeometryBuildInputSetUse.resourceSet = meshBlasGeometryBuildInputSet;
    meshBlasGeometryBuildInputSetUse.requiredState = ResourceStates::AccelStructBuildInput;
    meshBlasGeometryBuildInputSetUse.access = GpuTaskResourceAccess::ReadWrite;
    if(meshBlasGeometryBuildInputSetGraphOwned)
        result.resourceSetUses[result.resourceSetUseCount++] = meshBlasGeometryBuildInputSetUse;
    if(!geometryResources.gatherRemainingTraceResources())
        return false;

    GpuGraphResourceSetId shadowPrepareTraceGeometrySet;
    if(!geometryResources.m_remainingTraceGeometry.empty()){
        GpuGraphResourceSetDesc setDesc;
        setDesc.setIdentity(s_ShadowPrepareTraceGeometry)
            .setMarkerLabel("Shadow Prepare Trace Geometry")
            .setMembers(geometryResources.m_remainingTraceGeometry);
        const auto shadowPrepareTraceGeometrySetResult = this.m_graph.importResourceSet(setDesc);
        if(shadowPrepareTraceGeometrySetResult.has_value())
            shadowPrepareTraceGeometrySet = shadowPrepareTraceGeometrySetResult.value();
    }
    const b8 shadowPrepareTraceGeometryStatesGraphOwned = shadowPrepareTraceGeometrySet.valid();
    if(!shadowPrepareTraceGeometryStatesGraphOwned){
        for(in GpuGraphResourceId resource : geometryResources.m_remainingTraceGeometry)
            result.resourceUses.push_back(ReadWriteUse(resource, ResourceStates::ShaderResource));
    }
    GpuTaskResourceSetUse shadowPrepareTraceGeometrySetUse;
    shadowPrepareTraceGeometrySetUse.resourceSet = shadowPrepareTraceGeometrySet;
    shadowPrepareTraceGeometrySetUse.requiredState = ResourceStates::ShaderResource;
    shadowPrepareTraceGeometrySetUse.access = GpuTaskResourceAccess::ReadWrite;
    if(shadowPrepareTraceGeometryStatesGraphOwned)
        result.resourceSetUses[result.resourceSetUseCount++] = shadowPrepareTraceGeometrySetUse;
    for(in GpuGraphResourceId resource : inputs.softwareBvhBuildStateResources){
        if(!resource.valid())
            return false;
    }
    GpuGraphResourceSetId softwareBvhBuildStateSet;
    if(!inputs.softwareBvhBuildStateResources.empty()){
        GpuGraphResourceSetDesc setDesc;
        setDesc.setIdentity(s_ShadowPrepareSoftwareBvhBuildState)
            .setMarkerLabel("Shadow Prepare Software BVH Build State")
            .setMembers(inputs.softwareBvhBuildStateResources);
        const auto softwareBvhBuildStateSetResult = this.m_graph.importResourceSet(setDesc);
        if(softwareBvhBuildStateSetResult.has_value())
            softwareBvhBuildStateSet = softwareBvhBuildStateSetResult.value();
    }
    const b8 softwareBvhBuildStateStatesGraphOwned = softwareBvhBuildStateSet.valid();
    if(!softwareBvhBuildStateStatesGraphOwned){
        for(in GpuGraphResourceId resource : inputs.softwareBvhBuildStateResources){
            result.resourceUses.push_back(ReadWriteUse(resource, ResourceStates::UnorderedAccess));
        }
    }
    GpuTaskResourceSetUse softwareBvhBuildStateSetUse;
    softwareBvhBuildStateSetUse.resourceSet = softwareBvhBuildStateSet;
    softwareBvhBuildStateSetUse.requiredState = ResourceStates::UnorderedAccess;
    softwareBvhBuildStateSetUse.access = GpuTaskResourceAccess::ReadWrite;
    if(softwareBvhBuildStateStatesGraphOwned)
        result.resourceSetUses[result.resourceSetUseCount++] = softwareBvhBuildStateSetUse;

    if(inputs.rayTracingShadowResources.sceneTlas.valid()){
        const ResourceStates sceneTlasInitialState = this.m_raytracingSystem.sceneTlasBackingInitialState();
        GpuGraphResourceDesc tlasDesc = AccelStructResourceDesc(Name(s_SceneTlasResourceName), s_SceneTlasResourceLabel);
        tlasDesc.setInitialState(sceneTlasInitialState);
        const auto sceneTlasResult = this.m_graph.importAccelStruct(inputs.rayTracingShadowResources.sceneTlas, tlasDesc);
        if(sceneTlasResult.has_value())
            result.sceneTlas = sceneTlasResult.value();
        resourcesImported = resourcesImported && sceneTlasResult.has_value();
        if(result.sceneTlas.valid()){
            if(sceneTlasBuildGraphOwned){
                result.resourceUses.push_back(ReadWriteUse(result.sceneTlas, ResourceStates::AccelStructWrite));
                result.accelStructFinalizeResourceUses.push_back(ReadUse(result.sceneTlas, ResourceStates::AccelStructRead));
            }
            else{
                result.resourceUses.push_back(ReadWriteUse(result.sceneTlas, ResourceStates::AccelStructRead));
            }
        }
    }
    for(in MeshBlasGraphState state : liveMeshBlasGraphStates){
        if(geometryResources.isPreparedMeshBlasBuild(state.meshName))
            continue;

        const auto blasIdentity = DeriveName(state.meshName, s_BlasNameSuffix);
        if(!blasIdentity.has_value()){
            resourcesImported = false;
            continue;
        }
        const ResourceStates blasInitialState = ShadowPrepareBlasInitialState(state.backingFresh);
        GpuGraphResourceDesc blasDesc = AccelStructResourceDesc(blasIdentity.value(), "Mesh BLAS");
        blasDesc.setInitialState(blasInitialState);
        const auto blas = this.m_graph.importAccelStruct(state.blas, blasDesc);
        resourcesImported = resourcesImported && blas.has_value();
        if(blas.has_value()){
            if(state.nativeBuildsBlas){
                result.resourceUses.push_back(ReadWriteUse(blas.value(), ResourceStates::AccelStructRead));
            }
            else{
                result.resourceUses.push_back(ReadUse(blas.value(), ResourceStates::AccelStructRead));
            }
        }
    }
    if(!resourcesImported){
        warning("RendererSystem: could not import preflighted shadow-preparation resources");
        return false;
    }

    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

