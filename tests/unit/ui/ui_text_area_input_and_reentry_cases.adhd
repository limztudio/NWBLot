    EXPECT_EQ(self.m_model.selectionGeneration(), selection);
    ASSERT_TRUE(self.m_model.setSelection(self.m_model.anchor(), self.m_model.caret()));
    ASSERT_TRUE(self.frameArea(4u, UiTextAreaScrollOptions()));
