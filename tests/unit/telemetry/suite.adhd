Expected<Name> DeriveSequenceName(in Name prefix, in u64 seq){
    String sequenceText = String();
    AppendUnsignedU64Text(sequenceText, seq);
    return DeriveName(prefix, StringView(sequenceText));
}

String FormatNameHashText(in NameHash hash){
    String text = String();
    for(u32 lane = 0u; lane < s_NameHashLaneCount; ++lane){
        if(lane > 0u)
            text.append("_");
        AppendHexU64(hash.qwords[lane], text);
    }
    return text;
}

StringView FindOwnerJsonRecord(in StringView json, in Name owner, in StringView sourceField){
    const String identityText = FormatNameHashText(owner.hash());
    usize cursor = json.find("\"memoryRecords\": [");
    while(cursor != usize.max && cursor < json.size()){
        const usize nextLine = json.find("\n", cursor);
        usize lineLength = json.size() - cursor;
        if(nextLine != usize.max)
            lineLength = nextLine - cursor;
        const StringView line = json.substr(cursor, lineLength);
        if(line.find(StringView(identityText)) != usize.max && line.find(sourceField) != usize.max)
            return line;
        if(line.find("    ]") != usize.max || nextLine == usize.max)
            break;
        cursor = nextLine + 1u;
    }
    return "";
}

DiagnosticEventRecord MakeDiagnosticEvent(in StringView event, in StringView category, in StringView message, in StringView file, in u32 line){
    DiagnosticEventRecord record = DiagnosticEventRecord();
    record.event = event;
    record.category = category;
    record.message = message;
    record.file = file;
    record.line = line;
    return record;
}

Expected<TelemetryReport> BuildTestTelemetryReport(in EventView events, mut TelemetryArena arena, mut ScratchArena scratchArena){
