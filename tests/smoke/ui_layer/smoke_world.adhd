#include "document_window_scenes.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class UiLayerResizeRenderPass : IRenderPass{
    public UiLayerResizeRenderPass(mut GraphicsRuntime graphics){}

    public b8 shouldRenderUnfocused()override{
        return true;
    }
}

class UiLayerSmokeModeFlags{
    public b8 windowSmoke = false;
    public b8 popupSmoke = false;
    public b8 popupToolsSmoke = false;
    public b8 nestedPopupSmoke = false;
    public b8 radioGroupSmoke = false;
    public b8 sliderSmoke = false;
    public b8 progressSmoke = false;
    public b8 imageSmoke = false;
    public b8 textureImageSmoke = false;
    public b8 textAreaSmoke = false;
    public b8 numericEditSmoke = false;
    public b8 listSmoke = false;
    public b8 comboSmoke = false;
    public b8 searchComboSmoke = false;
    public b8 editSmoke = false;
    public b8 interactionSmoke = false;
    public b8 alternateSkin = false;
}

class UiDefaultSmokeScene : IUiSmokeScene{
    private UiTextSmokeSamples m_textSamples;
    private u32 m_paintFrame = 0u;

    public UiDefaultSmokeScene();

    public b8 paint(mut UiPaintContext paintContext)override;
}

class UiSmokeInputSubscription<T : IUiSmokeInputScene> : IInputEventHandler, IUiSmokeScene{
    private mut InputDispatcher m_input;
    public Shared<T> scene;

    public UiSmokeInputSubscription(mut InputDispatcher input, in Shared<T> scene){
        this.m_input = input;
        this.scene = scene;
        input.addHandlerToBack(this);
    }

    public ~UiSmokeInputSubscription(){
        this.m_input.removeHandler(this);
    }

    public KeyboardInputResult keyboardUpdate(in i32 key, in i32 scancode, in i32 action, in i32 mods)override{
        return this.scene.deref().keyboardUpdate(key, scancode, action, mods);
    }

    public b8 paint(mut UiPaintContext context)override{
        return this.scene.deref().paint(context);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


UiDefaultSmokeScene::UiDefaultSmokeScene(){
    this.m_textSamples = UiTextSmokeSamples();
}

b8 UiDefaultSmokeScene::paint(mut UiPaintContext paintContext){
    if(this.m_paintFrame < 3u){
        ++this.m_paintFrame;
        if(this.m_paintFrame <= 2u)
            return true;
        [essential] info("UiLayerSmokeProject: deterministic solid, skin, alpha and nested clip geometry submitted");
    }
    PaintUiLayerSmokeScene(paintContext);
    if(!this.m_textSamples.paint(paintContext))
        error("UiLayerSmokeProject: text or glyph coverage painting failed");
    return true;
}

UiLayerSmokeModeFlags ResolveUiLayerSmokeModes(){
    UiLayerSmokeModeFlags modes();
    modes.windowSmoke = IsUiLayerWindowSmokeEnabled();
    modes.popupSmoke = IsUiLayerPopupSmokeEnabled();
    modes.popupToolsSmoke = IsUiLayerPopupToolsSmokeEnabled();
    modes.nestedPopupSmoke = IsUiLayerNestedPopupSmokeEnabled();
    modes.radioGroupSmoke = IsUiLayerRadioGroupSmokeEnabled();
    modes.sliderSmoke = IsUiLayerSliderSmokeEnabled();
    modes.progressSmoke = IsUiLayerProgressSmokeEnabled();
    modes.imageSmoke = IsUiLayerImageSmokeEnabled();
    modes.textureImageSmoke = IsUiLayerTextureImageSmokeEnabled();
    modes.textAreaSmoke = ReadSmokeEnvironmentFlag("NWB_UI_LAYER_TEXT_AREA");
    modes.numericEditSmoke = IsUiLayerNumericEditSmokeEnabled();
    modes.listSmoke = IsUiLayerListSmokeEnabled();
    modes.comboSmoke = IsUiLayerComboSmokeEnabled();
    modes.searchComboSmoke = IsUiLayerSearchComboSmokeEnabled();
    modes.editSmoke = IsUiLayerEditSmokeEnabled();
    modes.interactionSmoke = IsUiLayerInteractionSmokeEnabled();
    modes.alternateSkin = (modes.windowSmoke && IsUiLayerWindowSkinSmokeEnabled())
        || (modes.popupSmoke && IsUiLayerPopupSkinSmokeEnabled())
        || (modes.listSmoke && IsUiLayerListSkinSmokeEnabled())
        || (modes.comboSmoke && IsUiLayerComboSkinSmokeEnabled())
        || (modes.searchComboSmoke && IsUiLayerSearchComboSkinSmokeEnabled())
        || (modes.popupToolsSmoke && IsUiLayerPopupToolsSkinSmokeEnabled())
        || (modes.nestedPopupSmoke && IsUiLayerNestedPopupSkinSmokeEnabled())
        || (modes.numericEditSmoke && IsUiLayerNumericEditSkinSmokeEnabled())
        || (modes.textAreaSmoke && ReadSmokeEnvironmentFlag("NWB_UI_LAYER_TEXT_AREA_SKIN"))
        || (modes.radioGroupSmoke && IsUiLayerRadioGroupSkinSmokeEnabled())
        || (modes.sliderSmoke && IsUiLayerSliderSkinSmokeEnabled())
        || (modes.progressSmoke && IsUiLayerProgressSkinSmokeEnabled())
        || (modes.imageSmoke && IsUiLayerImageSkinSmokeEnabled())
        || (modes.textureImageSmoke && IsUiLayerTextureImageSkinSmokeEnabled());
    return modes;
}

void LogSmokeSkinIfEnabled(in b8 enabled, in StringView tag, in b8 alternateSkin){
    if(!enabled)
        return;
    StringView skinName = "default";
    if(alternateSkin)
        skinName = "alternate";
    [essential] info("{}: skin={}", tag, skinName);
}

void LogActiveUiLayerSmokeSkins(in UiLayerSmokeModeFlags modes){
    LogSmokeSkinIfEnabled(modes.windowSmoke, "UiWindowSmoke", modes.alternateSkin);
    LogSmokeSkinIfEnabled(modes.popupSmoke, "UiPopupSmoke", modes.alternateSkin);
    LogSmokeSkinIfEnabled(modes.listSmoke, "UiListSmoke", modes.alternateSkin);
    LogSmokeSkinIfEnabled(modes.comboSmoke, "UiComboSmoke", modes.alternateSkin);
    LogSmokeSkinIfEnabled(modes.searchComboSmoke, "UiSearchComboSmoke", modes.alternateSkin);
    LogSmokeSkinIfEnabled(modes.popupToolsSmoke, "UiPopupToolsSmoke", modes.alternateSkin);
    LogSmokeSkinIfEnabled(modes.nestedPopupSmoke, "UiNestedPopupSmoke", modes.alternateSkin);
    LogSmokeSkinIfEnabled(modes.numericEditSmoke, "UiNumericEditSmoke", modes.alternateSkin);
    LogSmokeSkinIfEnabled(modes.textAreaSmoke, "UiTextAreaSmoke", modes.alternateSkin);
    LogSmokeSkinIfEnabled(modes.radioGroupSmoke, "UiRadioGroupSmoke", modes.alternateSkin);
    LogSmokeSkinIfEnabled(modes.sliderSmoke, "UiSliderSmoke", modes.alternateSkin);
    LogSmokeSkinIfEnabled(modes.progressSmoke, "UiProgressSmoke", modes.alternateSkin);
    LogSmokeSkinIfEnabled(modes.imageSmoke, "UiImageSmoke", modes.alternateSkin);
    LogSmokeSkinIfEnabled(modes.textureImageSmoke, "UiTextureImageSmoke", modes.alternateSkin);
}

b8 CheckUiLayerSmokePersistentState(mut ProjectRuntimeContext context){
    BufferDesc desc();
    desc.setDebugName(s_UiSmokeNameTestsUiLayerPersistentStateBuffer);
    desc.setByteSize(16u);
    const auto first = context.graphics.createBuffer(desc);
    const auto second = context.graphics.createBuffer(desc);
    mut Device device = context.graphics.getDevice();
    const auto list = device.createCommandList();
    if(!first.has_value() || !second.has_value() || !list.has_value())
        return false;

    CommandListResourceStateHandoff state(context.objectArena);
    mut CommandList commands = list.value().deref();
    commands.open();
    commands.beginTrackingBufferState(first.value().deref(), ResourceStates::CopyDest);
    commands.beginTrackingBufferState(second.value().deref(), ResourceStates::CopyDest);
    commands.close(state);
    const GpuPhysicalQueueId queue = device.getPrimaryPhysicalQueue(CommandQueue::Graphics);
    if(!state.valid() || !queue.valid() || commands.commandRecordingFailed())
        return false;

    GpuPersistentResourceStateCache cache(context.objectArena);
    GpuPersistentStateCandidate candidate(cache);
    Array<BufferHandle, 2u> buffers();
    buffers[0u] = first.value();
    buffers[1u] = second.value();
    const Span<TextureHandle> textures();
    if(!cache.buildFilteredResourceSubset(state, textures, Span<BufferHandle>(buffers.data(), buffers.size()), candidate) || cache.valid())
        return false;

    const Optional<in CommandListResourceStateHandoff> source = candidate.borrowSource();
    if(!source.has_value() || !cache.buildFilteredResourceSubset(source.value(), textures, Span<BufferHandle>(buffers.data(), 1u), candidate))
        return false;
    const Optional<in CommandListResourceStateHandoff> filtered = candidate.borrowSource();
    const GpuPhysicalQueueId noRelease();
    if(!filtered.has_value() || !filtered.value().coversBufferWithOwnership(first.value().deref(), queue, noRelease)
        || filtered.value().coversBufferWithOwnership(second.value().deref(), queue, noRelease)
        || cache.valid() || !cache.commit(candidate) || candidate.valid())
        return false;

    const Optional<in CommandListResourceStateHandoff> accepted = cache.borrowSource();
    return accepted.has_value() && accepted.value().coversBufferWithOwnership(first.value().deref(), queue, noRelease)
        && !accepted.value().coversBufferWithOwnership(second.value().deref(), queue, noRelease);
}

b8 ConfigureSmokeLayerInputProfile(mut UiLayerSystem layer){
    if(!ReadSmokeEnvironmentFlag("NWB_UI_LAYER_INPUT_BINDINGS_SMOKE"))
        return true;
    const InputBindings defaults();
    Vector<InputKeyBinding> bindings = Vector<InputKeyBinding>();
    bindings.reserve(defaults.bindings().size() + 4u);
    for(in InputKeyBinding binding : defaults.bindings()){
        if(binding.key != s_SmokeKeyTab)
            bindings.push_back(binding);
    }
    InputKeyBinding activateBinding();
    activateBinding.key = s_SmokeKeyQ;
    activateBinding.command = InputCommand::Activate;
    bindings.push_back(activateBinding);
    InputKeyBinding leftBinding();
    leftBinding.key = s_SmokeKeyW;
    leftBinding.command = InputCommand::Left;
    bindings.push_back(leftBinding);
    InputKeyBinding focusNextBinding();
    focusNextBinding.key = s_SmokeKeyR;
    focusNextBinding.command = InputCommand::FocusNext;
    bindings.push_back(focusNextBinding);
    InputKeyBinding focusPrevBinding();
    focusPrevBinding.key = s_SmokeKeyT;
    focusPrevBinding.command = InputCommand::FocusPrevious;
    bindings.push_back(focusPrevBinding);
    if(!layer.setInputBindings(bindings)){
        error("UiLayerSmokeProject: configured input profile was rejected");
        return false;
    }
    [essential] info("UiLayerSmokeProject: custom input profile Q=Activate W=Left R=FocusNext T=FocusPrevious Tab=unbound");
    return true;
}

void ConfigureSmokeLayerRecordingMode(mut UiLayerSystem layer){
    if(ReadSmokeEnvironmentFlag("NWB_UI_IR_REPLAY")){
        layer.setGpuCommandRecordingMode(GpuCommandRecordingMode::CommandIrReplay);
        [essential] info("UiLayerSmokeProject: command IR replay enabled");
    }
}

void SpawnManySmokeRootsIfEnabled(mut World world){
    if(!ReadSmokeEnvironmentFlag("NWB_UI_LAYER_MANY_ROOTS"))
        return;
    for(usize index = 0u; index < s_InputMaxTargets; ++index){
        auto root = world.createEntity();
        mut UiPaintComponent paint = root.addComponent<UiPaintComponent>();
        UiPaintCallback callback = lambda[](mut UiPaintContext paintContext) -> void{};
        paint.paint.setCallback(callback);
    }
    auto lastRoot = world.createEntity();
    mut UiPaintComponent lastPaint = lastRoot.addComponent<UiPaintComponent>();
    UiPaintCallback last = lambda[](mut UiPaintContext paintContext) -> void{
        const EntityID id = paintContext.entity;
        [essential] info("UiLayerSmokeProject: root beyond target limit painted");
        paintContext.world.destroyEntity(id);
        if(paintContext.world.entity(id).alive())
            error("UiLayerSmokeProject: root removal during paint failed");
        else
            [essential] info("UiLayerSmokeProject: root removed during paint");
    };
    lastPaint.paint.setCallback(last);
}

b8 InstallUiSmokePaint<T : IUiSmokeScene>(mut UiPaintSlot slot, in Expected<Shared<T>> created, in StringView message){
    if(!created.has_value())
        return false;
    const Shared<T> scene = created.value();
    UiPaintCallback callback = lambda[in scene, in message](mut UiPaintContext paintContext) -> void{
        if(!scene.deref().paint(paintContext))
            error("UiLayerSmokeProject: {}", message);
    };
    slot.setCallback(callback);
    return true;
}

Expected<Shared<UiSmokeInputSubscription<T>>> SubscribeUiSmokeInput<T : IUiSmokeInputScene>(
    in SharedPool pool,
    mut InputDispatcher input,
    in Expected<Shared<T>> created
){
    if(!created.has_value())
        return MakeUnexpected(Failure());
    return pool.make<UiSmokeInputSubscription<T>>(input, created.value());
}

b8 AttachUiLayerSmokeScene(mut ProjectRuntimeContext context, mut World world, in UiLayerSmokeModeFlags modes){
    SharedPool pool();
    auto entity = world.createEntity();
    mut UiPaintComponent paint = entity.addComponent<UiPaintComponent>();
    if(modes.textureImageSmoke){
        const auto subscribed = SubscribeUiSmokeInput<UiTextureImageSmokeScene>(pool, context.input, pool.make<UiTextureImageSmokeScene>(context.assetManager));
        return InstallUiSmokePaint<UiSmokeInputSubscription<UiTextureImageSmokeScene>>(paint.paint, subscribed, "texture-image UI paint failed");
    }
    if(modes.imageSmoke){
        const auto subscribed = SubscribeUiSmokeInput<UiImageSmokeScene>(pool, context.input, pool.make<UiImageSmokeScene>());
        return InstallUiSmokePaint<UiSmokeInputSubscription<UiImageSmokeScene>>(paint.paint, subscribed, "image UI paint failed");
    }
    if(modes.progressSmoke){
        const auto subscribed = SubscribeUiSmokeInput<UiProgressSmokeScene>(pool, context.input, pool.make<UiProgressSmokeScene>());
        return InstallUiSmokePaint<UiSmokeInputSubscription<UiProgressSmokeScene>>(paint.paint, subscribed, "progress UI paint failed");
    }
    if(modes.sliderSmoke){
        const auto subscribed = SubscribeUiSmokeInput<UiSliderSmokeScene>(pool, context.input, pool.make<UiSliderSmokeScene>());
        return InstallUiSmokePaint<UiSmokeInputSubscription<UiSliderSmokeScene>>(paint.paint, subscribed, "slider UI paint failed");
    }
    if(modes.radioGroupSmoke){
        const auto subscribed = SubscribeUiSmokeInput<UiRadioGroupSmokeScene>(pool, context.input, pool.make<UiRadioGroupSmokeScene>());
        return InstallUiSmokePaint<UiSmokeInputSubscription<UiRadioGroupSmokeScene>>(paint.paint, subscribed, "radio group UI paint failed");
    }
    if(modes.textAreaSmoke)
        return InstallUiSmokePaint<UiTextAreaSmokeScene>(paint.paint, pool.make<UiTextAreaSmokeScene>(context.clipboard), "text area UI paint failed");
    if(modes.numericEditSmoke){
        const auto subscribed = SubscribeUiSmokeInput<UiNumericEditSmokeScene>(pool, context.input, pool.make<UiNumericEditSmokeScene>());
        return InstallUiSmokePaint<UiSmokeInputSubscription<UiNumericEditSmokeScene>>(paint.paint, subscribed, "numeric editor UI paint failed");
    }
    if(modes.nestedPopupSmoke){
        const auto subscribed = SubscribeUiSmokeInput<UiNestedPopupSmokeScene>(pool, context.input, pool.make<UiNestedPopupSmokeScene>());
        return InstallUiSmokePaint<UiSmokeInputSubscription<UiNestedPopupSmokeScene>>(paint.paint, subscribed, "nested popup UI paint failed");
    }
    if(modes.popupToolsSmoke){
        const auto subscribed = SubscribeUiSmokeInput<UiPopupToolsSmokeScene>(pool, context.input, pool.make<UiPopupToolsSmokeScene>());
        return InstallUiSmokePaint<UiSmokeInputSubscription<UiPopupToolsSmokeScene>>(paint.paint, subscribed, "tooltip/context menu UI paint failed");
    }
    if(modes.searchComboSmoke){
        const auto subscribed = SubscribeUiSmokeInput<UiSearchComboSmokeScene>(pool, context.input, pool.make<UiSearchComboSmokeScene>());
        return InstallUiSmokePaint<UiSmokeInputSubscription<UiSearchComboSmokeScene>>(paint.paint, subscribed, "searchable combo UI paint failed");
    }
    if(modes.comboSmoke){
        const auto subscribed = SubscribeUiSmokeInput<UiComboSmokeScene>(pool, context.input, pool.make<UiComboSmokeScene>());
        return InstallUiSmokePaint<UiSmokeInputSubscription<UiComboSmokeScene>>(paint.paint, subscribed, "combo UI paint failed");
    }
    if(modes.listSmoke){
        const auto subscribed = SubscribeUiSmokeInput<UiListSmokeScene>(pool, context.input, pool.make<UiListSmokeScene>());
        return InstallUiSmokePaint<UiSmokeInputSubscription<UiListSmokeScene>>(paint.paint, subscribed, "virtual list paint failed");
    }
    if(modes.popupSmoke){
        const auto subscribed = SubscribeUiSmokeInput<UiPopupSmokeScene>(pool, context.input, pool.make<UiPopupSmokeScene>());
        if(!subscribed.has_value())
            return false;
        const Shared<UiSmokeInputSubscription<UiPopupSmokeScene>> popup = subscribed.value();
        if(!InstallUiSmokePaint<UiSmokeInputSubscription<UiPopupSmokeScene>>(paint.paint, subscribed, "popup UI paint failed"))
            return false;
        auto laterEntity = world.createEntity();
        mut UiPaintComponent laterPaint = laterEntity.addComponent<UiPaintComponent>();
        laterPaint.order = 100;
        UiPaintCallback later = lambda[in popup](mut UiPaintContext paintContext) -> void{
            if(!popup.deref().scene.deref().paintLaterRoot(paintContext))
                error("UiLayerSmokeProject: later popup root paint failed");
        };
        laterPaint.paint.setCallback(later);
        return true;
    }
    if(modes.editSmoke){
        const auto subscribed = SubscribeUiSmokeInput<UiEditSmokeScene>(pool, context.input, pool.make<UiEditSmokeScene>());
        return InstallUiSmokePaint<UiSmokeInputSubscription<UiEditSmokeScene>>(paint.paint, subscribed, "edit UI paint failed");
    }
    if(modes.windowSmoke)
        return InstallUiSmokePaint<UiWindowSmokeScene>(paint.paint, pool.make<UiWindowSmokeScene>(), "window UI paint failed");
    if(modes.interactionSmoke)
        return InstallUiSmokePaint<UiInteractiveSmokeScene>(paint.paint, pool.make<UiInteractiveSmokeScene>(), "interactive UI paint failed");
    return InstallUiSmokePaint<UiDefaultSmokeScene>(paint.paint, pool.make<UiDefaultSmokeScene>(), "default UI paint failed");
}

b8 InitUiLayerSmokeSystem(mut ProjectRuntimeContext context, mut World world, in b8 alternateSkin){
    AssetRef<UiSkin> skin();
    if(alternateSkin)
        skin = AssetRef<UiSkin>("alternate_skin");
    mut UiLayerSystem layer = world.addSystem<UiLayerSystem>(
        world, context.graphics, context.input, context.clipboard, context.textInput,
        context.cursor, context.accessibility,
        context.assetManager, context.shaderPathResolver, skin, UiLayerPresentation::Standalone
    );
    if(!ConfigureSmokeLayerInputProfile(layer))
        return false;
    ConfigureSmokeLayerRecordingMode(layer);
    PointerInput touch;
    touch.source.device = 77u;
    touch.source.control = 1u;
    touch.phase = PointerPhase::Press;
    touch.position = Point(4.0f, 4.0f);
    b8 consumed = true;
    if(!layer.dispatchPointerInput(touch, consumed) || consumed){
        error("UiLayerSmokeProject: custom pointer dispatch failed unexpectedly");
        return false;
    }
    layer.cancelPointerDevice(77u);
    InputEvent extraKey;
    extraKey.source.device = 77u;
    extraKey.source.control = 2u;
    extraKey.type = InputEventType::KeyUp;
    extraKey.key = s_SmokeKeyF12;
    b8 blockText = true;
    if(!layer.dispatchInputEvent(extraKey, blockText) || blockText){
        error("UiLayerSmokeProject: custom input event dispatch failed unexpectedly");
        return false;
    }
    return true;
}

Expected<NotNullUniquePtr<World>> CreateUiLayerSmokeWorld(mut ProjectRuntimeContext context){
    if(!cast<b8>(context.shaderPathResolver)){
        error("UiLayerSmokeProject: shader path resolver is unavailable");
        return MakeUnexpected(Failure());
    }
    UniquePtr<World> allocatedWorld = MakeUnique<World>(context.objectArena, context.cpuTasks);
    auto finalized = TryTakeNotNullUnique<World>(allocatedWorld);
    if(!finalized.has_value()){
        error("UiLayerSmokeProject: ECS world allocation failed");
        return MakeUnexpected(Failure());
    }
    NotNullUniquePtr<World> world = TakeSmokeWorld(finalized.value());

    const UiLayerSmokeModeFlags modes = ResolveUiLayerSmokeModes();
    LogActiveUiLayerSmokeSkins(modes);
    if(!InitUiLayerSmokeSystem(context, SmokeWorldRef(world), modes.alternateSkin))
        return MakeUnexpected(Failure());

    SpawnManySmokeRootsIfEnabled(SmokeWorldRef(world));
    if(!AttachUiLayerSmokeScene(context, SmokeWorldRef(world), modes))
        return MakeUnexpected(Failure());
    return TakeSmokeWorld(world);
}

void ClearUiLayerSmokeWorld(mut ProjectRuntimeContext context, mut World world){
    world.taskScope().wait();
    Optional<mut UiLayerSystem> layer = world.borrowSystem<UiLayerSystem>();
    if(!layer.has_value())
        return;
    context.graphics.removeRenderPass(layer.value());
    const b8 deviceIdle = context.graphics.waitForIdle();
    [essential] assert(deviceIdle || context.graphics.isDeviceLost(), "UI smoke teardown requires device idle or terminal loss");
    world.clear();
}

b8 ConfigureUiLayerSmokeStartup(
    mut ProjectRuntimeContext context,
    mut NotNullUniquePtr<World> world,
    mut UiLayerResizeRenderPass resizeRenderPass,
    mut b8 outResizeRenderPassRegistered,
    mut u64 outResizePresentationBaseline,
    mut UniquePtr<FramebufferCapture> outFramebufferCapture
){
    Optional<mut UiLayerSystem> layer = world.deref().borrowSystem<UiLayerSystem>();
    if(!layer.has_value())
        return false;
    context.graphics.addRenderPassToBack(layer.value());
    if(ReadSmokeEnvironmentFlag("NWB_UI_LAYER_RESIZE_RENDER")){
        outResizePresentationBaseline = context.graphics.getSuccessfulPresentationCount();
        context.graphics.addRenderPassToBack(resizeRenderPass);
        outResizeRenderPassRegistered = true;
    }
    FramebufferCaptureOptions captureOptions();
    if(ReadSmokeEnvironmentFlag("NWB_UI_LAYER_RESIZE_CAPTURE")){
        captureOptions.requiredWidth = 800u;
        captureOptions.requiredHeight = 600u;
    }
    return ConfigureSmokeFramebufferCapture(context, "UiLayerSmokeProject", s_DefaultCaptureFrameCount, captureOptions, outFramebufferCapture);
}

b8 TickUiLayerSmokeWorld(in f32 delta, mut NotNullUniquePtr<World> world, mut UniquePtr<FramebufferCapture> framebufferCapture){
    return TickSmokeWorldWithCapture(delta, SmokeWorldRef(world), framebufferCapture);
}

void StopUiLayerSmokeCaptureAndClearWorld(
    mut ProjectRuntimeContext context,
    mut NotNullUniquePtr<World> world,
    mut UniquePtr<FramebufferCapture> framebufferCapture
){
    StopAndResetSmokeFramebufferCapture(framebufferCapture);
    ClearUiLayerSmokeWorld(context, SmokeWorldRef(world));
}


