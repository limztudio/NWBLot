[cpp_header("<core/alloc/general.h>"), cpp_name("::NWB::Core::Alloc::GlobalArena")]
extern class GlobalAllocator{
    ArenaMemoryStats memoryStats()const;
};

[cpp_header("<core/alloc/module.h>"), cpp_name("::AString<::NWB::Core::Alloc::GlobalArena>")]
extern class GlobalString{
    void append(...);
    void assign(...);
    void reserve(in usize capacity);
    void resize(...);
    void clear();
    usize size()const;
    b8 empty()const;
    void push_back(in u8 byte);
    u8 operator[](in usize index)const;
    usize find(...)const;
};

[cpp_header("<core/alloc/module.h>"), cpp_name("::NWB::Path")]
extern class GlobalPath{
    GlobalPath(in auto first, ...);
    GlobalPath operator/(in auto child)const;
    GlobalPath parentPath()const;
    GlobalPath lexicallyNormal()const;
    PlatformStringView native()const;
    PlatformStringView filenameView()const;
    b8 empty()const;
    b8 isAbsolute()const;
};

