#include <impl/ecs_render/kernel/graphics_prefix_timing_ticket.adhd>

#include <impl/ecs_render/csg/csg_graph_resource_snapshot.adhd>
#include <impl/ecs_render/csg/task_graph_opaque_compute_emulation_plan.adhd>
#include <impl/ecs_render/deferred/deferred_frame_targets.adhd>
#include <impl/ecs_render/kernel/task_graph_scheduling.adhd>
#include <impl/ecs_render/material/material_system.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[modular]
class OpaqueCsgReceiverComputeEmulationGraphTaskPayload{
    public mut RendererMaterialSystem materialSystem;
    public in DeferredFrameTargets targets;
    public in GraphicsPrefixTimingTicket timingTicket;
    public in b8 meshViewSetupReady;
    public in b8 sceneShadingSetupReady;
    public MeshFrameBindingSnapshot frameBindings;
    public CsgGraphResourceSnapshot csgResources;
    public OpaqueCsgReceiverComputeEmulationGraphPlan plan;
    public usize instanceCount = 0u;
    public usize materialTypedByteCount = 0u;
    public b8 materialDrawBuffersUploaded = false;
    public b8 csgFrameBuffersUploaded = false;
    public b8 materialFrameStatesGraphOwned = false;
    public b8 materialGeometryStatesGraphOwned = false;

    public OpaqueCsgReceiverComputeEmulationGraphTaskPayload(
        mut RendererMaterialSystem materials,
        in DeferredFrameTargets targets,
        in GraphicsPrefixTimingTicket ticket,
        in b8 meshReady,
        in b8 shadingReady
    ){
        this.materialSystem = materials;
        this.targets = targets;
        this.timingTicket = ticket;
        this.meshViewSetupReady = meshReady;
        this.sceneShadingSetupReady = shadingReady;
    }

    public GpuTaskCommandRequirements commandRequirements()const{
        return SharedComputeEmulationCommandRequirements(true);
    }
    [cpp_unwind]
    public b8 record(mut CommandList commands, in GpuTaskRecordContext context)const;
}

[modular]
class OpaqueCsgIntervalSampleComputeEmulationGraphTask{
    public mut GraphicsRuntime graphics;
    public mut Optional<GpuTimingMeasure> opaqueCsgTiming;
    public mut RendererMaterialSystem materialSystem;
    public in DeferredFrameTargets targets;
    public in GraphicsPrefixTimingTicket timingTicket;
    public in b8 meshViewSetupReady;
    public in b8 sceneShadingSetupReady;
    public MeshFrameBindingSnapshot frameBindings;
    public CsgGraphResourceSnapshot csgResources;
    public OpaqueCsgIntervalSampleComputeEmulationGraphPlan plan;
    public usize instanceCount = 0u;
    public usize materialTypedByteCount = 0u;
    public b8 materialDrawBuffersUploaded = false;
    public b8 csgFrameBuffersUploaded = false;
    public b8 materialFrameStatesGraphOwned = false;
    public b8 materialGeometryStatesGraphOwned = false;

    public OpaqueCsgIntervalSampleComputeEmulationGraphTask(
        mut GraphicsRuntime graphics,
        mut RendererMaterialSystem materials,
        in DeferredFrameTargets targets,
        in GraphicsPrefixTimingTicket ticket,
        in b8 meshReady,
        in b8 shadingReady,
        mut Optional<GpuTimingMeasure> timing
    ){
        this.materialSystem = materials;
        this.targets = targets;
        this.timingTicket = ticket;
        this.meshViewSetupReady = meshReady;
        this.sceneShadingSetupReady = shadingReady;
        this.graphics = graphics;
        this.opaqueCsgTiming = timing;
    }

    public GpuTaskCommandRequirements commandRequirements()const{
        return SharedComputeEmulationCommandRequirements(true);
    }
    [cpp_unwind]
    public b8 record(mut CommandList commands, in GpuTaskRecordContext context)const;
    public void discarded(){
        DiscardGpuTimingMeasure(this.opaqueCsgTiming);
    }
}


