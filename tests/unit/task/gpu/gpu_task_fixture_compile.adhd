Expected<Name> IndexedName(in Name prefix, in usize index){
    CompactString text = CompactString();
    AppendUnsignedU64Text(text, cast<u64>(index));
    return DeriveName(prefix, text);
}

GpuQueueCapabilityMask QueueCapabilities(
    in GpuQueueCapabilityMask first,
    in GpuQueueCapabilityMask second,
    in GpuQueueCapabilityMask third
){
    return CombineQueueCapabilities(first, second, third);
}

GpuQueueCapabilityMask QueueCapabilities(in GpuQueueCapabilityMask first, in GpuQueueCapabilityMask second){
    return CombineQueueCapabilities(first, second, GpuQueueCapability::None);
}

GpuQueueCapabilityMask QueueCapabilities(in GpuQueueCapabilityMask first){
    return first;
}

GpuPhysicalQueueInfo GraphicsQueue(in u16 index, in GpuQueueCapabilityMask capabilities){
    GpuPhysicalQueueInfo queueInfo = GpuPhysicalQueueInfo();
    queueInfo.familyIndex = 0u;
    queueInfo.queueIndex = 0u;
    queueInfo.id.index = index;
    queueInfo.id.deviceGeneration = 1u;
    queueInfo.queueClass = CommandQueue::Graphics;
    queueInfo.capabilities = capabilities;
    queueInfo.dedicated = false;
    return queueInfo;
}

GpuPhysicalQueueInfo GraphicsQueue(in u16 index){
    return GraphicsQueue(
        index,
        QueueCapabilities(GpuQueueCapability::Graphics, GpuQueueCapability::Compute, GpuQueueCapability::Transfer)
    );
}

GpuPhysicalQueueInfo GraphicsQueue(){
    return GraphicsQueue(0u);
}

GpuPhysicalQueueInfo DedicatedComputeQueue(in u16 index){
    GpuPhysicalQueueInfo queueInfo = GpuPhysicalQueueInfo();
    queueInfo.familyIndex = 1u;
    queueInfo.queueIndex = 0u;
    queueInfo.id.index = index;
    queueInfo.id.deviceGeneration = 1u;
    queueInfo.queueClass = CommandQueue::Compute;
    queueInfo.capabilities = QueueCapabilities(GpuQueueCapability::Compute, GpuQueueCapability::Transfer);
    queueInfo.dedicated = true;
    return queueInfo;
}

GpuPhysicalQueueInfo DedicatedComputeQueue(){
    return DedicatedComputeQueue(1u);
}

GpuPhysicalQueueInfo DedicatedTransferQueue(in u16 index){
    GpuPhysicalQueueInfo queueInfo = GpuPhysicalQueueInfo();
    queueInfo.familyIndex = 2u;
    queueInfo.queueIndex = 0u;
    queueInfo.id.index = index;
    queueInfo.id.deviceGeneration = 1u;
    queueInfo.queueClass = CommandQueue::Transfer;
    queueInfo.capabilities = GpuQueueCapability::Transfer;
    queueInfo.dedicated = true;
    return queueInfo;
}

GpuPhysicalQueueInfo DedicatedTransferQueue(){
    return DedicatedTransferQueue(2u);
}

b8 Assign(
    mut GpuTaskGraphQueueAssignments assignments,
    mut ScratchArena scratchArena,
    in GpuTaskGraph graph,
    in GpuTaskGraphAnalysis analysis,
    in GpuPhysicalQueueTopology topology,
    in GpuTaskGraphQueueAssignmentOptions options
){
    const GpuTaskGraphCompiler compiler = GpuTaskGraphCompiler();
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
    return compiler.assignQueues(declarations, analysis, topology, options, scratchArena, assignments);
}

b8 Assign(
    mut GpuTaskGraphQueueAssignments assignments,
    mut ScratchArena scratchArena,
    in GpuTaskGraph graph,
    in GpuTaskGraphAnalysis analysis,
    in GpuPhysicalQueueTopology topology
){
    const GpuTaskGraphQueueAssignmentOptions options = GpuTaskGraphQueueAssignmentOptions();
    return Assign(assignments, scratchArena, graph, analysis, topology, options);
}

b8 Compile(
    mut GpuTaskGraphAnalysis analysis,
    mut GpuTaskGraphQueueAssignments assignments,
    mut GpuCompiledGraph compiledGraph,
    mut ScratchArena scratchArena,
    in GpuTaskGraph graph,
    in GpuPhysicalQueueTopology topology,
    in GpuTaskGraphCompileOptions options
){
    const GpuTaskGraphCompiler compiler = GpuTaskGraphCompiler();
    GpuTaskGraphCompileOptions metadataOptions = options;
    // Allow metadata-only tasks in unit packetization helpers.
    metadataOptions.allowMetadataOnlyTasks = true;
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
    return compiler.compile(declarations, topology, metadataOptions, scratchArena, analysis, assignments, compiledGraph);
}

b8 Compile(
    mut GpuTaskGraphAnalysis analysis,
    mut GpuTaskGraphQueueAssignments assignments,
    mut GpuCompiledGraph compiledGraph,
    mut ScratchArena scratchArena,
    in GpuTaskGraph graph,
    in GpuPhysicalQueueTopology topology
){
    const GpuTaskGraphCompileOptions options = GpuTaskGraphCompileOptions();
    return Compile(analysis, assignments, compiledGraph, scratchArena, graph, topology, options);
}

// Compile on a topology where Compute and Transfer capabilities stay on their dedicated queue classes.
b8 CompileWithSeparatedCommandQueues(
    mut GpuTaskGraphAnalysis analysis,
    mut GpuTaskGraphQueueAssignments assignments,
    mut GpuCompiledGraph compiledGraph,
    mut ScratchArena scratchArena,
    in GpuTaskGraph graph,
    in GpuPhysicalQueueTopology topology,
    in GpuTaskGraphCompileOptions options
){
    if(!HasTopologyQueuesPtr(topology))
        return Compile(analysis, assignments, compiledGraph, scratchArena, graph, topology, options);

    const Span<GpuPhysicalQueueInfo> sourceQueues = TopologyQueues(topology);
    b8 hasComputeQueue = false;
    b8 hasTransferQueue = false;
    for(in GpuPhysicalQueueInfo queue : sourceQueues){
        hasComputeQueue = hasComputeQueue || queue.queueClass == CommandQueue::Compute;
        hasTransferQueue = hasTransferQueue || queue.queueClass == CommandQueue::Transfer;
    }

    Vector<GpuPhysicalQueueInfo> queues = Vector<GpuPhysicalQueueInfo>();
    queues.reserve(sourceQueues.size());
    for(in GpuPhysicalQueueInfo sourceQueue : sourceQueues){
        GpuPhysicalQueueInfo adjusted = sourceQueue;
        if(hasComputeQueue && adjusted.queueClass == CommandQueue::Graphics)
            adjusted.capabilities = MaskOutQueueCapability(adjusted.capabilities, GpuQueueCapability::Compute);
        if(hasTransferQueue && adjusted.queueClass != CommandQueue::Transfer)
            adjusted.capabilities = MaskOutQueueCapability(adjusted.capabilities, GpuQueueCapability::Transfer);
        queues.push_back(adjusted);
    }
    return Compile(analysis, assignments, compiledGraph, scratchArena, graph, MakeTopology(queues), options);
}

b8 CompileWithSeparatedCommandQueues(
    mut GpuTaskGraphAnalysis analysis,
    mut GpuTaskGraphQueueAssignments assignments,
    mut GpuCompiledGraph compiledGraph,
    mut ScratchArena scratchArena,
    in GpuTaskGraph graph,
    in GpuPhysicalQueueTopology topology
){
    const GpuTaskGraphCompileOptions options = GpuTaskGraphCompileOptions();
    return CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, scratchArena, graph, topology, options);
}

Optional<GpuTaskDependencyEdge> TryFindEdge(
    in GpuTaskGraphAnalysis analysis,
    in GpuTaskId producer,
    in GpuTaskId consumer
){
    const Span<GpuTaskDependencyEdge> edges = analysis.edges();
    for(usize i = 0u; i < edges.size(); ++i){
        const GpuTaskDependencyEdge edge = edges[i];
        if(edge.producer == producer && edge.consumer == consumer)
            return edge;
    }
    return Optional<GpuTaskDependencyEdge>();
}

b8 HasEdge(in GpuTaskGraphAnalysis analysis, in GpuTaskId producer, in GpuTaskId consumer){
    return TryFindEdge(analysis, producer, consumer).has_value();
}

GpuTaskCommandRequirements GraphicsCommands(){
    GpuTaskCommandRequirements requirements = GpuTaskCommandRequirements();
    requirements.requiredCapabilities = GpuQueueCapability::Graphics;
    return requirements;
}

GpuTaskCommandRequirements ComputeCommands(){
    GpuTaskCommandRequirements requirements = GpuTaskCommandRequirements();
    requirements.requiredCapabilities = GpuQueueCapability::Compute;
    return requirements;
}

Expected<GpuGraphResourceId> AddTextureMetadata(
    mut GpuTaskGraph graph,
    in Name identity,
    in AStringView label,
    in ResourceStatesMask initialState,
    in ResourceQueueSharingMask queueSharing
){
    GpuGraphResourceDesc desc = GpuGraphResourceDesc();
    desc.setIdentity(identity);
    desc.setMarkerLabel(label);
    desc.setType(GpuGraphResourceType::Texture);
    desc.setInitialState(initialState);
    desc.setQueueSharing(queueSharing);
    return graph.importResource(desc);
}

