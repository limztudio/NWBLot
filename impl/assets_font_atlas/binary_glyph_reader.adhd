#include <impl/assets_font_atlas/glyph_validation.adhd>

native{
#include <global/binary_little_endian.h>
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class FontAtlasBinaryDecodedHeader{
    public u32 faceIndex = 0u;
    public u32 unitsPerEm = 0u;
    public u32 sourceGlyphCount = 0u;
    public u32 bakePpem = s_FontAtlasDefaultBakePpem;
    public u32 spreadPixels = s_FontAtlasDefaultSpreadPixels;
    public u32 guardTexels = s_FontAtlasDefaultGuardTexels;
    public FontAtlasRasterMode rasterMode = FontAtlasRasterMode::Bitmap;
    public f32 ascenderUnits = 0.0f;
    public f32 descenderUnits = 0.0f;
    public f32 lineGapUnits = 0.0f;
    public u32 glyphCount = 0u;
    public u32 groupCount = 0u;
    public u32 tableCount = 0u;
}


b8 IsValidFontAtlasBinaryPreamble(in u32 magic, in u32 version, in u32 encoding, in u32 reserved){
    return magic == s_FontAtlasBinaryMagic
        && version == s_FontAtlasBinaryVersion
        && encoding == s_FontAtlasDistanceEncoding
        && reserved == 0u
    ;
}

b8 IsValidFontAtlasBinaryCounts(
    in u32 glyphCount,
    in u32 sourceGlyphCount,
    in u32 groupCount,
    in u32 tableCount,
    in u32 raster,
    in usize cursor,
    in usize totalByteCount
){
    if(
        glyphCount == 0u
        || glyphCount > s_FontAtlasMaxGlyphCount
        || glyphCount != sourceGlyphCount
        || groupCount == 0u
        || groupCount > s_FontAtlasMaxGroupCount
        || tableCount > s_FontAtlasMaxPositioningTableCount
        || raster > cast<u32>(FontAtlasRasterMode::Bitmap)
    )
        return false;
    const u64 minimumRemaining =
        cast<u64>(glyphCount) * cast<u64>(s_FontAtlasBinaryGlyphBytes)
        + cast<u64>(groupCount) * cast<u64>(s_FontAtlasBinaryGroupHeaderBytes)
        + cast<u64>(tableCount) * cast<u64>(s_FontAtlasBinaryTableHeaderBytes)
    ;
    return cursor <= totalByteCount && minimumRemaining <= cast<u64>(totalByteCount - cursor);
}

b8 AreFontAtlasByteSpansEqual(in Span<u8> lhs, in Span<u8> rhs){
    if(lhs.size() != rhs.size())
        return false;
    for(usize i = 0u; i < lhs.size(); ++i){
        if(lhs[i] != rhs[i])
            return false;
    }
    return true;
}

Expected<FontAtlasGlyph> TryReadFontAtlasGlyph(in Span<u8> bytes, mut usize cursor){
    FontAtlasGlyph glyph;
    const Expected<u32> glyphId = ReadU32LittleEndian(bytes, cursor);
    if(!glyphId.has_value())
        return MakeUnexpected(Failure());
    glyph.glyphId = glyphId.value();
    const Expected<u32> group = ReadU32LittleEndian(bytes, cursor);
    if(!group.has_value())
        return MakeUnexpected(Failure());
    glyph.group = group.value();
    const Expected<u32> channel = ReadU32LittleEndian(bytes, cursor);
    if(!channel.has_value())
        return MakeUnexpected(Failure());
    glyph.channel = channel.value();
    const Expected<u32> x = ReadU32LittleEndian(bytes, cursor);
    if(!x.has_value())
        return MakeUnexpected(Failure());
    glyph.x = x.value();
    const Expected<u32> y = ReadU32LittleEndian(bytes, cursor);
    if(!y.has_value())
        return MakeUnexpected(Failure());
    glyph.y = y.value();
    const Expected<u32> width = ReadU32LittleEndian(bytes, cursor);
    if(!width.has_value())
        return MakeUnexpected(Failure());
    glyph.width = width.value();
    const Expected<u32> height = ReadU32LittleEndian(bytes, cursor);
    if(!height.has_value())
        return MakeUnexpected(Failure());
    glyph.height = height.value();
    const Expected<f32> planeLeft = ReadF32LittleEndian(bytes, cursor);
    if(!planeLeft.has_value())
        return MakeUnexpected(Failure());
    glyph.planeLeft = planeLeft.value();
    const Expected<f32> planeTop = ReadF32LittleEndian(bytes, cursor);
    if(!planeTop.has_value())
        return MakeUnexpected(Failure());
    glyph.planeTop = planeTop.value();
    const Expected<f32> planeRight = ReadF32LittleEndian(bytes, cursor);
    if(!planeRight.has_value())
        return MakeUnexpected(Failure());
    glyph.planeRight = planeRight.value();
    const Expected<f32> planeBottom = ReadF32LittleEndian(bytes, cursor);
    if(!planeBottom.has_value())
        return MakeUnexpected(Failure());
    glyph.planeBottom = planeBottom.value();
    const Expected<f32> advanceUnits = ReadF32LittleEndian(bytes, cursor);
    if(!advanceUnits.has_value())
        return MakeUnexpected(Failure());
    glyph.advanceUnits = advanceUnits.value();
    const Expected<u32> drawable = ReadU32LittleEndian(bytes, cursor);
    if(!drawable.has_value())
        return MakeUnexpected(Failure());
    glyph.drawable = drawable.value();
    return glyph;
}

b8 TryReadFontAtlasGlyphs(
    in Span<u8> bytes,
    in u32 glyphCount,
    mut usize cursor,
    mut Vector<FontAtlasGlyph> outGlyphs
){
    outGlyphs.clear();
    outGlyphs.resize(cast<usize>(glyphCount));
    for(usize index = 0u; index < cast<usize>(glyphCount); ++index){
        const Expected<FontAtlasGlyph> decoded = TryReadFontAtlasGlyph(bytes, cursor);
        if(!decoded.has_value())
            return false;
        outGlyphs[index] = decoded.value();
    }
    return true;
}

void AppendFontAtlasGlyphBinary(in FontAtlasGlyph glyph, mut Vector<u8> outBinary){
    AppendU32LittleEndian(outBinary, glyph.glyphId);
    AppendU32LittleEndian(outBinary, glyph.group);
    AppendU32LittleEndian(outBinary, glyph.channel);
    AppendU32LittleEndian(outBinary, glyph.x);
    AppendU32LittleEndian(outBinary, glyph.y);
    AppendU32LittleEndian(outBinary, glyph.width);
    AppendU32LittleEndian(outBinary, glyph.height);
    AppendF32LittleEndian(outBinary, glyph.planeLeft);
    AppendF32LittleEndian(outBinary, glyph.planeTop);
    AppendF32LittleEndian(outBinary, glyph.planeRight);
    AppendF32LittleEndian(outBinary, glyph.planeBottom);
    AppendF32LittleEndian(outBinary, glyph.advanceUnits);
    AppendU32LittleEndian(outBinary, glyph.drawable);
}

void AppendFontAtlasGlyphsBinary(in Span<FontAtlasGlyph> glyphs, mut Vector<u8> outBinary){
    for(in FontAtlasGlyph glyph : glyphs)
        AppendFontAtlasGlyphBinary(glyph, outBinary);
}

b8 ValidateFontAtlasGlyphGroupRect(
    in FontAtlasGlyph glyph,
    in usize index,
    in u32 groupWidth,
    in u32 groupHeight,
    in u32 groupChannelCount,
    in u32 guardTexels
){
    if(IsValidFontAtlasGlyphGroupRect(glyph, groupWidth, groupHeight, groupChannelCount, guardTexels))
        return true;

    error("FontAtlas validation failed: glyph {} exceeds guarded page bounds", index);
    return false;
}

b8 TryReadFontAtlasBinaryPreambleAndIdentity(
    in Span<u8> bytes,
    mut usize cursor,
    mut Array<u64, s_FontAtlasIdentityLaneCount> outIdentityQwords
){
    const Expected<u32> magic = ReadU32LittleEndian(bytes, cursor);
    if(!magic.has_value())
        return false;
    const Expected<u32> version = ReadU32LittleEndian(bytes, cursor);
    if(!version.has_value())
        return false;
    const Expected<u32> encoding = ReadU32LittleEndian(bytes, cursor);
    if(!encoding.has_value())
        return false;
    const Expected<u32> reserved = ReadU32LittleEndian(bytes, cursor);
    if(!reserved.has_value())
        return false;
    if(!IsValidFontAtlasBinaryPreamble(magic.value(), version.value(), encoding.value(), reserved.value()))
        return false;
    for(usize lane = 0u; lane < s_FontAtlasIdentityLaneCount; ++lane){
        const Expected<u32> low = ReadU32LittleEndian(bytes, cursor);
        if(!low.has_value())
            return false;
        const Expected<u32> high = ReadU32LittleEndian(bytes, cursor);
        if(!high.has_value())
            return false;
        outIdentityQwords[lane] = PackFontAtlasQword(low.value(), high.value());
    }
    return true;
}

Expected<FontAtlasBinaryDecodedHeader> TryReadFontAtlasBinaryHeaderTail(
    in Span<u8> bytes,
    mut usize cursor
){
    FontAtlasBinaryDecodedHeader header;
    const Expected<u32> faceIndex = ReadU32LittleEndian(bytes, cursor);
    if(!faceIndex.has_value())
        return MakeUnexpected(Failure());
    header.faceIndex = faceIndex.value();
    const Expected<u32> unitsPerEm = ReadU32LittleEndian(bytes, cursor);
    if(!unitsPerEm.has_value())
        return MakeUnexpected(Failure());
    header.unitsPerEm = unitsPerEm.value();
    const Expected<u32> sourceGlyphCount = ReadU32LittleEndian(bytes, cursor);
    if(!sourceGlyphCount.has_value())
        return MakeUnexpected(Failure());
    header.sourceGlyphCount = sourceGlyphCount.value();
    const Expected<u32> bakePpem = ReadU32LittleEndian(bytes, cursor);
    if(!bakePpem.has_value())
        return MakeUnexpected(Failure());
    header.bakePpem = bakePpem.value();
    const Expected<u32> spreadPixels = ReadU32LittleEndian(bytes, cursor);
    if(!spreadPixels.has_value())
        return MakeUnexpected(Failure());
    header.spreadPixels = spreadPixels.value();
    const Expected<u32> guardTexels = ReadU32LittleEndian(bytes, cursor);
    if(!guardTexels.has_value())
        return MakeUnexpected(Failure());
    header.guardTexels = guardTexels.value();
    const Expected<u32> raster = ReadU32LittleEndian(bytes, cursor);
    if(!raster.has_value())
        return MakeUnexpected(Failure());
    const Expected<f32> ascenderUnits = ReadF32LittleEndian(bytes, cursor);
    if(!ascenderUnits.has_value())
        return MakeUnexpected(Failure());
    header.ascenderUnits = ascenderUnits.value();
    const Expected<f32> descenderUnits = ReadF32LittleEndian(bytes, cursor);
    if(!descenderUnits.has_value())
        return MakeUnexpected(Failure());
    header.descenderUnits = descenderUnits.value();
    const Expected<f32> lineGapUnits = ReadF32LittleEndian(bytes, cursor);
    if(!lineGapUnits.has_value())
        return MakeUnexpected(Failure());
    header.lineGapUnits = lineGapUnits.value();
    const Expected<u32> glyphCount = ReadU32LittleEndian(bytes, cursor);
    if(!glyphCount.has_value())
        return MakeUnexpected(Failure());
    header.glyphCount = glyphCount.value();
    const Expected<u32> groupCount = ReadU32LittleEndian(bytes, cursor);
    if(!groupCount.has_value())
        return MakeUnexpected(Failure());
    header.groupCount = groupCount.value();
    const Expected<u32> tableCount = ReadU32LittleEndian(bytes, cursor);
    if(!tableCount.has_value())
        return MakeUnexpected(Failure());
    header.tableCount = tableCount.value();
    if(!IsValidFontAtlasBinaryCounts(header.glyphCount, header.sourceGlyphCount, header.groupCount, header.tableCount, raster.value(), cursor, bytes.size()))
        return MakeUnexpected(Failure());
    header.rasterMode = cast<FontAtlasRasterMode>(raster.value());
    return header;
}

b8 ValidateFontAtlasBinaryGroupChunk(
    in u32 width,
    in u32 height,
    in u32 channelCount,
    in u32 byteCount,
    in u64 pixelBytes,
    in usize cursor,
    in usize totalBytes
){
    if(!IsValidFontAtlasGroupDimensions(width, height, channelCount))
        return false;
    const u64 expectedBytes = cast<u64>(width) * cast<u64>(height) * cast<u64>(channelCount);
    return expectedBytes == cast<u64>(byteCount)
        && pixelBytes + cast<u64>(byteCount) <= s_FontAtlasMaxPixelBytes
        && cursor <= totalBytes
        && cast<usize>(byteCount) <= totalBytes - cursor;
}

b8 ValidateFontAtlasBinaryTableChunk(
    in u32 byteCount,
    in u64 tableBytes,
    in usize cursor,
    in usize totalBytes
){
    return byteCount != 0u
        && tableBytes + cast<u64>(byteCount) <= s_FontAtlasMaxPositioningBytes
        && cursor <= totalBytes
        && cast<usize>(byteCount) <= totalBytes - cursor;
}

void AppendFontAtlasBinaryPreambleAndIdentity(
    in Array<u64, s_FontAtlasIdentityLaneCount> fontIdentityQwords,
    mut Vector<u8> outBinary
){
    AppendU32LittleEndian(outBinary, s_FontAtlasBinaryMagic);
    AppendU32LittleEndian(outBinary, s_FontAtlasBinaryVersion);
    AppendU32LittleEndian(outBinary, s_FontAtlasDistanceEncoding);
    AppendU32LittleEndian(outBinary, 0u);
    for(usize lane = 0u; lane < s_FontAtlasIdentityLaneCount; ++lane){
        AppendU32LittleEndian(outBinary, UnpackFontAtlasLowWord(fontIdentityQwords[lane]));
        AppendU32LittleEndian(outBinary, UnpackFontAtlasHighWord(fontIdentityQwords[lane]));
    }
}

void AppendFontAtlasBinaryHeaderTail(
    in u32 faceIndex,
    in u32 unitsPerEm,
    in u32 sourceGlyphCount,
    in u32 bakePpem,
    in u32 spreadPixels,
    in u32 guardTexels,
    in FontAtlasRasterMode rasterMode,
    in f32 ascenderUnits,
    in f32 descenderUnits,
    in f32 lineGapUnits,
    in u32 glyphCount,
    in u32 groupCount,
    in u32 tableCount,
    mut Vector<u8> outBinary
){
    AppendU32LittleEndian(outBinary, faceIndex);
    AppendU32LittleEndian(outBinary, unitsPerEm);
    AppendU32LittleEndian(outBinary, sourceGlyphCount);
    AppendU32LittleEndian(outBinary, bakePpem);
    AppendU32LittleEndian(outBinary, spreadPixels);
    AppendU32LittleEndian(outBinary, guardTexels);
    AppendU32LittleEndian(outBinary, cast<u32>(rasterMode));
    AppendF32LittleEndian(outBinary, ascenderUnits);
    AppendF32LittleEndian(outBinary, descenderUnits);
    AppendF32LittleEndian(outBinary, lineGapUnits);
    AppendU32LittleEndian(outBinary, glyphCount);
    AppendU32LittleEndian(outBinary, groupCount);
    AppendU32LittleEndian(outBinary, tableCount);
}

void AppendFontAtlasGroupChunk(
    in u32 width,
    in u32 height,
    in u32 channelCount,
    in Span<u8> sha256Bytes,
    in Span<u8> pixels,
    mut Vector<u8> outBinary
){
    AppendU32LittleEndian(outBinary, width);
    AppendU32LittleEndian(outBinary, height);
    AppendU32LittleEndian(outBinary, channelCount);
    AppendU32LittleEndian(outBinary, cast<u32>(pixels.size()));
    for(in u8 b : sha256Bytes)
        outBinary.push_back(b);
    for(in u8 p : pixels)
        outBinary.push_back(p);
}

void AppendFontAtlasTableChunk(
    in u32 tag,
    in Span<u8> sha256Bytes,
    in Span<u8> tableBytes,
    mut Vector<u8> outBinary
){
    AppendU32LittleEndian(outBinary, tag);
    AppendU32LittleEndian(outBinary, cast<u32>(tableBytes.size()));
    for(in u8 b : sha256Bytes)
        outBinary.push_back(b);
    for(in u8 d : tableBytes)
        outBinary.push_back(d);
}

b8 TryReadFontAtlasGroupHeader(
    in Span<u8> bytes,
    mut usize cursor,
    mut u32 outWidth,
    mut u32 outHeight,
    mut u32 outChannelCount,
    mut u32 outByteCount
){
    const Expected<u32> width = ReadU32LittleEndian(bytes, cursor);
    if(!width.has_value())
        return false;
    const Expected<u32> height = ReadU32LittleEndian(bytes, cursor);
    if(!height.has_value())
        return false;
    const Expected<u32> channelCount = ReadU32LittleEndian(bytes, cursor);
    if(!channelCount.has_value())
        return false;
    const Expected<u32> byteCount = ReadU32LittleEndian(bytes, cursor);
    if(!byteCount.has_value())
        return false;
    outWidth = width.value();
    outHeight = height.value();
    outChannelCount = channelCount.value();
    outByteCount = byteCount.value();
    return true;
}

b8 TryReadFontAtlasTableHeader(
    in Span<u8> bytes,
    mut usize cursor,
    mut u32 outTag,
    mut u32 outByteCount
){
    const Expected<u32> tag = ReadU32LittleEndian(bytes, cursor);
    if(!tag.has_value())
        return false;
    const Expected<u32> byteCount = ReadU32LittleEndian(bytes, cursor);
    if(!byteCount.has_value())
        return false;
    outTag = tag.value();
    outByteCount = byteCount.value();
    return true;
}

b8 ReadFontAtlasBytesInto(
    in Span<u8> bytes,
    in u32 byteCount,
    mut usize cursor,
    mut Vector<u8> outData
){
    const usize count = cast<usize>(byteCount);
    if(!CanReadBytes(bytes, cursor, count) || !CanStoreValueCount(outData, count))
        return false;
    outData.clear();
    outData.reserve(count);
    for(usize i = 0u; i < count; ++i)
        outData.push_back(bytes[cursor + i]);
    cursor += count;
    return true;
}

b8 ValidateFontAtlasGroupPixelChunk(
    in u32 width,
    in u32 height,
    in u32 channelCount,
    in Span<u8> pixels,
    in Span<u8> expectedSha256Bytes,
    mut u64 inOutPixelBytes
){
    if(!IsValidFontAtlasGroupDimensions(width, height, channelCount)){
        error("FontAtlas validation failed: invalid extent or channel count");
        return false;
    }
    const u64 byteCount = cast<u64>(width) * cast<u64>(height) * cast<u64>(channelCount);
    if(cast<u64>(pixels.size()) != byteCount || inOutPixelBytes + byteCount > cast<u64>(s_FontAtlasMaxPixelBytes)){
        error("FontAtlas validation failed: invalid extent, payload size, or byte budget");
        return false;
    }
    if(!DoesFontAtlasDigestMatchBytes(pixels, expectedSha256Bytes)){
        error("FontAtlas validation failed: pixel content hash mismatch");
        return false;
    }
    inOutPixelBytes += byteCount;
    return true;
}


