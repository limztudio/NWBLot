const Name s_AvboitTransmittanceVolumeTargetName = "engine/avboit/transmittance_volume";
const u32 s_AvboitU32WordByteSize = 4u;

u64 ComputeAvboitU32WordBytes(in u64 wordCount){
    return wordCount * cast<u64>(s_AvboitU32WordByteSize);
}

Expected<TextureHandle> CreateAvboitRenderTarget(
    mut GraphicsRuntime graphics,
    in u32 width,
    in u32 height,
    in Format format,
    in Name debugName,
    in Color clearValue,
    in b8 shareWithAsyncCompute
){
    TextureDesc desc = TextureDesc();
    desc.setWidth(width).setHeight(height).setFormat(format).setIsRenderTarget(true).setName(debugName).setClearValue(clearValue).setInitialState(ResourceStates::Common).setKeepInitialState(true);
    if(shareWithAsyncCompute)
        desc.setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute);
    return graphics.createTexture(desc);
}

Expected<TextureHandle> CreateAvboitRenderTarget(
    mut GraphicsRuntime graphics,
    in u32 width,
    in u32 height,
    in Format format,
    in Name debugName,
    in Color clearValue
){
    return CreateAvboitRenderTarget(graphics, width, height, format, debugName, clearValue, false);
}

Expected<TextureHandle> CreateAvboitTransmittanceVolume(mut GraphicsRuntime graphics, in u32 width, in u32 height, in u32 depth, in Format format){
    TextureDesc desc = TextureDesc();
    desc
        .setWidth(width)
        .setHeight(height)
        .setDepth(depth)
        .setFormat(format)
        .setDimension(TextureDimension::Texture3D)
        .setIsUAV(true)
        // Cross-lane submissions own the execution/memory dependencies.
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
        .setName(s_AvboitTransmittanceVolumeTargetName)
        .setClearValue(Color(1.0f, 1.0f, 1.0f, 1.0f))
        .setInitialState(ResourceStates::Common)
        .setKeepInitialState(true)
    ;
    return graphics.createTexture(desc);
}

Expected<BufferHandle> CreateAvboitU32Buffer(mut GraphicsRuntime graphics, in u64 byteSize, in Name debugName){
    BufferDesc desc = BufferDesc();
    desc
        .setByteSize(byteSize)
        .setStructStride(s_AvboitU32WordByteSize)
        .setCanHaveUAVs(true)
        // Shared by raster passes and interleaved compute kernels.
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
        .setDebugName(debugName)
        .enableAutomaticStateTracking(ResourceStates::Common)
    ;
    return graphics.createBuffer(desc);
}


