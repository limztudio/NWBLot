#include <impl/assets_mesh/payload_validation.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_PositionStreamNameView = "position";
const StringView s_NormalStreamNameView = "normal";
const StringView s_TangentStreamNameView = "tangent";
const StringView s_Uv0StreamNameView = "uv0";
const StringView s_ColorStreamNameView = "color";
const StringView s_PositionsStreamLabel = "positions";
const StringView s_NormalsStreamLabel = "normals";
const StringView s_TangentsStreamLabel = "tangents";
const StringView s_Uv0StreamLabel = "uv0";
const StringView s_ColorsStreamLabel = "colors";
const StringView s_MeshletsStreamLabel = "meshlets";
const StringView s_MeshletBoundsStreamLabel = "meshlet bounds";
const StringView s_MeshletPositionRefDeltasStreamLabel = "meshlet position ref deltas";
const StringView s_MeshletAttributeRefDeltasStreamLabel = "meshlet attribute ref deltas";
const StringView s_MeshletLocalVertexRefsStreamLabel = "meshlet local vertex refs";
const StringView s_MeshletPrimitiveIndicesStreamLabel = "meshlet primitive indices";
const StringView s_SolidTriangleWordsStreamLabel = "solid triangle words";

interface IMeshPayloadStreams{
    in Vector<f32x3u> positionStream()const;
    in Vector<f16x4u> normalStream()const;
    in Vector<f16x4u> tangentStream()const;
    in Vector<f32x2u> uv0Stream()const;
    in Vector<f16x4u> colorStream()const;
    in Vector<MeshletDesc> meshlets()const;
    in Vector<MeshletBounds> meshletBounds()const;
    in Vector<u8> meshletPositionRefDeltas()const;
    in Vector<u8> meshletAttributeRefDeltas()const;
    in Vector<MeshletLocalVertexRef> meshletLocalVertexRefs()const;
    in Vector<u8> meshletPrimitiveIndices()const;
    in Vector<u32> solidTriangleWords()const;
}

b8 AddMeshBaseReserveBytes<T : IMeshPayloadStreams>(in T mesh, mut usize bytes)noexcept_like(){
    return AddBinaryVectorReserveBytes(bytes, mesh.positionStream())
        && AddBinaryVectorReserveBytes(bytes, mesh.normalStream())
        && AddBinaryVectorReserveBytes(bytes, mesh.tangentStream())
        && AddBinaryVectorReserveBytes(bytes, mesh.uv0Stream())
        && AddBinaryVectorReserveBytes(bytes, mesh.colorStream())
        && AddBinaryVectorReserveBytes(bytes, mesh.meshlets())
        && AddBinaryVectorReserveBytes(bytes, mesh.meshletBounds())
        && AddBinaryVectorReserveBytes(bytes, mesh.meshletPositionRefDeltas())
        && AddBinaryVectorReserveBytes(bytes, mesh.meshletAttributeRefDeltas())
        && AddBinaryVectorReserveBytes(bytes, mesh.meshletLocalVertexRefs())
        && AddBinaryVectorReserveBytes(bytes, mesh.meshletPrimitiveIndices())
        && AddBinaryVectorReserveBytes(bytes, mesh.solidTriangleWords());
}


