[cpp_header("<core/telemetry/session.h>"), cpp_name("::NWB::Core::Telemetry::CaptureSession")]
extern class CaptureSession{
    void clear(...);
    b8 enabled(...)const;
    usize eventCount(...)const;
    u64 frameIndex(...)const;
    b8 recordFrameGraph(...);
    PerfSessionRecordResult recordPerfReport(...);
    mut Recorder recorder(...)const;
    void setCaptureOptions(in TelemetryCaptureOptions options);
    void setFrameIndex(...);
    void setStreamId(...);
    u32 streamId(...)const;
    EventView view(...)const;
};

[cpp_header("<core/telemetry/session.h>"), cpp_name("::NWB::Core::Telemetry::CaptureSessionCaptureScope")]
extern class CaptureSessionCaptureScope;


