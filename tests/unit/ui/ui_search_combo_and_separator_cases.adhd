namespace __hidden_ui_search_selection_epoch_tests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace UiSearchComboTests;

namespace SelectionMutation{
    enum Enum : u8{ None, Identical, AwayAndBack };
};

class SelectionProbe final{
public:
    explicit SelectionProbe(EditModel& query)noexcept
        : m_query(query)
    {}


public:
    void arm(const SelectionMutation::Enum mutation)noexcept{
        m_mutation = mutation;
        m_anchor = m_query.anchor();
        m_caret = m_query.caret();
    }

    [[nodiscard]] b8 apply()noexcept{
        const SelectionMutation::Enum mutation = m_mutation;
        m_mutation = SelectionMutation::None;
        if(mutation == SelectionMutation::None)
            return true;
        ++m_calls;
        if(mutation == SelectionMutation::AwayAndBack && !m_query.setSelection(0u, 0u))
            return false;
        return m_query.setSelection(m_anchor, m_caret);
    }

    [[nodiscard]] u64 calls()const noexcept{ return m_calls; }


private:
    EditModel& m_query;
    SelectionMutation::Enum m_mutation = SelectionMutation::None;
    usize m_anchor = 0u;
    usize m_caret = 0u;
    u64 m_calls = 0u;
};

class SelectionView final : public IListDataSource{
public:
    SelectionView(const IListDataSource& source, EditModel& query)noexcept
        : m_source(source)
        , m_probe(query)
    {}


public:
    [[nodiscard]] virtual u64 instanceGeneration()const override{ return m_source.instanceGeneration(); }

    [[nodiscard]] virtual u64 revision()const override{ return m_source.revision(); }

    [[nodiscard]] virtual u64 rowCount()const override{ return m_source.rowCount(); }

    [[nodiscard]] virtual u64 key(const u64 index)const override{ return m_source.key(index); }

    [[nodiscard]] virtual Expected<u64> indexOf(const u64 key)const override{ return m_source.indexOf(key); }

    [[nodiscard]] virtual Expected<u64> findEnabled(const u64 start, const b8 reverse)const override{
        return m_source.findEnabled(start, reverse);
    }

    [[nodiscard]] virtual StringView text(const u64 index)const override{
        ++m_textCalls;
        if(!m_probe.apply())
            ADD_FAILURE() << "row callback selection change failed";
        return m_source.text(index);
    }

    [[nodiscard]] virtual b8 enabled(const u64 index)const override{ return m_source.enabled(index); }

    void arm(const SelectionMutation::Enum mutation)noexcept{ m_probe.arm(mutation); }

    [[nodiscard]] u64 mutationCalls()const noexcept{ return m_probe.calls(); }

    [[nodiscard]] u64 textCalls()const noexcept{ return m_textCalls; }


private:
    const IListDataSource& m_source;
    mutable SelectionProbe m_probe;
    mutable u64 m_textCalls = 0u;
};

class SelectionSource final : public ISearchableListDataSource{
public:
    SelectionSource(SearchSource& source, EditModel& query)noexcept
        : m_source(source)
        , m_probe(query)
        , m_view(source.filtered(), query)
    {}


public:
    [[nodiscard]] virtual u64 instanceGeneration()const noexcept override{ return m_source.instanceGeneration(); }

    [[nodiscard]] virtual u64 revision()const noexcept override{ return m_source.revision(); }

    [[nodiscard]] virtual u64 rowCount()const noexcept override{ return m_source.rowCount(); }

    [[nodiscard]] virtual u64 key(const u64 index)const noexcept override{ return m_source.key(index); }

    [[nodiscard]] virtual Expected<u64> indexOf(const u64 key)const noexcept override{ return m_source.indexOf(key); }

    [[nodiscard]] virtual Expected<u64> findEnabled(const u64 start, const b8 reverse)const noexcept override{
        return m_source.findEnabled(start, reverse);
    }

    [[nodiscard]] virtual StringView text(const u64 index)const noexcept override{ return m_source.text(index); }

    [[nodiscard]] virtual b8 enabled(const u64 index)const override{ return m_source.enabled(index); }

    [[nodiscard]] virtual b8 filter(const AStringView query)override{
        return m_probe.apply() && m_source.filter(query);
    }

    [[nodiscard]] virtual const IListDataSource& filtered()const noexcept override{ return m_view; }

    void armFilter(const SelectionMutation::Enum mutation)noexcept{ m_probe.arm(mutation); }

    [[nodiscard]] u64 filterMutationCalls()const noexcept{ return m_probe.calls(); }

    [[nodiscard]] SelectionView& view()noexcept{ return m_view; }


private:
    SearchSource& m_source;
    SelectionProbe m_probe;
    SelectionView m_view;
};


