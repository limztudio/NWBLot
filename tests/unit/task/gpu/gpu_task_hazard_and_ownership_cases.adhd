void GpuHazardOwner_ExpectMissingTypedImport(
    mut TestArena testArena,
    in GpuPhysicalQueueTopology topology,
    in Name identity,
    in AStringView label,
    in GpuGraphResourceTypeEnum resourceType,
    in ResourceStatesMask requiredState
){
    const GpuTaskGraphCompiler compiler = GpuTaskGraphCompiler();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuGraphResourceDesc resDesc = GpuGraphResourceDesc();
    resDesc.setIdentity(identity);
    resDesc.setMarkerLabel(label);
    resDesc.setType(resourceType);
    resDesc.setInitialState(ResourceStates::Common);
    const auto resourceResult = graph.importResource(resDesc);
    ASSERT_TRUE(resourceResult.has_value());
    const GpuGraphResourceId resource = resourceResult.value();
    ASSERT_TRUE(resource.valid());

    Array<GpuTaskResourceUse, 1> uses = Array<GpuTaskResourceUse, 1>();
    uses[0u].resource = resource;
    uses[0u].requiredState = requiredState;
    uses[0u].access = GpuTaskResourceAccess::Read;
    GpuTaskDesc desc = GpuTaskDesc();
    desc.setIdentity(identity);
    desc.setMarkerLabel(label);
    desc.setResourceUses(uses);

    u32 recordCount = 0u;
    const Expected<GpuTaskId> taskResult = AddNativeRecordProbeTask(graph, desc, recordCount);
    ASSERT_TRUE(taskResult.has_value());
    const GpuTaskId task = taskResult.value();
    ASSERT_TRUE(task.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ScratchArena scratchArena = ScratchArena(s_TaskGpuScratch);
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
    EXPECT_TRUE(declarations.taskAt(task.index).hasPayload);
    EXPECT_TRUE(declarations.taskAt(task.index).hasRecordPayload);
    EXPECT_FALSE(compiler.compile(declarations, topology, GpuTaskGraphCompileOptions(), scratchArena, analysis, assignments, compiledGraph));
    EXPECT_EQ(analysis.diagnostic().status, GpuTaskGraphAnalysisStatus::InvalidResourceUse);
    EXPECT_EQ(analysis.diagnostic().task, task);
    EXPECT_EQ(analysis.diagnostic().resource, resource);
    EXPECT_FALSE(analysis.valid());
    EXPECT_FALSE(assignments.valid());
    {
        const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);
        EXPECT_FALSE(compiledPlan.valid());
    }
    EXPECT_EQ(recordCount, 0u);

    GpuTaskGraphCompileOptions metadataOptions = GpuTaskGraphCompileOptions();
    metadataOptions.allowMetadataOnlyTasks = true;
    EXPECT_TRUE(compiler.compile(declarations, topology, metadataOptions, scratchArena, analysis, assignments, compiledGraph));
    EXPECT_TRUE(analysis.valid());
    EXPECT_TRUE(assignments.valid());
    {
        const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);
        EXPECT_TRUE(compiledPlan.validFor(declarations));
    }
    EXPECT_EQ(recordCount, 0u);
}

void VerifyGpuHazardOwner_RejectsMetadataResourceUsesBeforeNativeRecording(){
    TestArena testArena = TestArena();
    Array<GpuPhysicalQueueInfo, 1> queues = Array<GpuPhysicalQueueInfo, 1>();
    queues[0u] = GraphicsQueue();
    const GpuPhysicalQueueTopology topology = MakeTopology(queues);
    const GpuTaskGraphCompiler compiler = GpuTaskGraphCompiler();

    GpuHazardOwner_ExpectMissingTypedImport(testArena, topology, s_GpuCaseTaskGraphNativeMetadataTexture, "Native Metadata Texture", GpuGraphResourceType::Texture, ResourceStates::ShaderResource);
    GpuHazardOwner_ExpectMissingTypedImport(testArena, topology, s_GpuCaseTaskGraphNativeMetadataBuffer, "Native Metadata Buffer", GpuGraphResourceType::Buffer, ResourceStates::ShaderResource);
    GpuHazardOwner_ExpectMissingTypedImport(testArena, topology, s_GpuCaseTaskGraphNativeMetadataAccelStruct, "Native Metadata Accel Struct", GpuGraphResourceType::AccelStruct, ResourceStates::AccelStructRead);

    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const auto unusedTextureResult = AddTextureMetadata(graph, s_GpuCaseTaskGraphNativeUnusedMetadataTexture, "Native Unused Metadata Texture");
    ASSERT_TRUE(unusedTextureResult.has_value());
    const GpuGraphResourceId unusedTexture = unusedTextureResult.value();
    const auto hazardDomainResult = AddHazardDomain(graph, s_GpuCaseTaskGraphNativeHazardDomain, "Native Hazard Domain");
    ASSERT_TRUE(hazardDomainResult.has_value());
    const GpuGraphResourceId hazardDomain = hazardDomainResult.value();
    ASSERT_TRUE(unusedTexture.valid());
    ASSERT_TRUE(hazardDomain.valid());

    Array<GpuTaskResourceUse, 1> uses = Array<GpuTaskResourceUse, 1>();
    uses[0u].resource = hazardDomain;
    uses[0u].requiredState = ResourceStates::Common;
    uses[0u].access = GpuTaskResourceAccess::Write;
    GpuTaskDesc desc = GpuTaskDesc();
    desc.setIdentity(s_GpuCaseTaskGraphNativeHazardDomainTask);
    desc.setMarkerLabel("Native Hazard Domain Task");
    desc.setResourceUses(uses);

    u32 recordCount = 0u;
    const Expected<GpuTaskId> taskResult = AddNativeRecordProbeTask(graph, desc, recordCount);
    ASSERT_TRUE(taskResult.has_value());
    ASSERT_TRUE(taskResult.value().valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ScratchArena scratchArena = ScratchArena(s_TaskGpuScratch);
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        EXPECT_TRUE(compiler.compile(declarations, topology, GpuTaskGraphCompileOptions(), scratchArena, analysis, assignments, compiledGraph));
        EXPECT_TRUE(analysis.valid());
        EXPECT_TRUE(assignments.valid());
        const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);
        EXPECT_TRUE(compiledPlan.validFor(declarations));
        EXPECT_EQ(recordCount, 0u);
    }

    Array<GpuTaskResourceUse, 1> invalidTypedUses = Array<GpuTaskResourceUse, 1>();
    invalidTypedUses[0u].resource = unusedTexture;
    invalidTypedUses[0u].requiredState = ResourceStates::Unknown;
    invalidTypedUses[0u].access = GpuTaskResourceAccess::Read;
    GpuTaskDesc invalidTypedDesc = GpuTaskDesc();
    invalidTypedDesc.setIdentity(s_GpuCaseTaskGraphNativeUnknownTypedStateTask);
    invalidTypedDesc.setMarkerLabel("Native Unknown Typed State Task");
    invalidTypedDesc.setResourceUses(invalidTypedUses);

    const Expected<GpuTaskId> invalidTypedTaskResult = AddNativeRecordProbeTask(graph, invalidTypedDesc, recordCount);
    ASSERT_TRUE(invalidTypedTaskResult.has_value());
    const GpuTaskId invalidTypedTask = invalidTypedTaskResult.value();
    ASSERT_TRUE(invalidTypedTask.valid());

    GpuTaskGraphCompileOptions metadataOptions = GpuTaskGraphCompileOptions();
    metadataOptions.allowMetadataOnlyTasks = true;
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        EXPECT_FALSE(compiler.compile(declarations, topology, metadataOptions, scratchArena, analysis, assignments, compiledGraph));
        EXPECT_EQ(analysis.diagnostic().status, GpuTaskGraphAnalysisStatus::InvalidResourceUse);
        EXPECT_EQ(analysis.diagnostic().task, invalidTypedTask);
        EXPECT_EQ(analysis.diagnostic().resource, unusedTexture);
        EXPECT_EQ(recordCount, 0u);
    }
}

void VerifyGpuHazardOwner_RejectsPresentationEndpointWithoutNativeBackBuffer(){
    TestArena testArena = TestArena();
    ScratchArena scratchArena = ScratchArena(s_TaskGpuScratch);
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuGraphResourceDesc resDesc = GpuGraphResourceDesc();
    resDesc.setIdentity(s_TaskGraphCasePresentMetadata);
    resDesc.setMarkerLabel("Present Metadata");
    resDesc.setType(GpuGraphResourceType::Texture);
    resDesc.setInitialState(ResourceStates::Unknown);
    resDesc.setExternalFinalState(ResourceStates::Present);
    const auto resource = graph.importResource(resDesc);
    ASSERT_TRUE(resource.has_value());
    const auto producer = GpuHazardOwner_AddEmptyTask(s_TaskGraphCasePresentMetadataProducer, "Present Metadata Producer", graph);
    ASSERT_TRUE(producer.has_value());

    GpuPresentEndpoint endpoint = GpuPresentEndpoint();
    endpoint.producer = producer.value();
    endpoint.backBuffer = resource.value();
    ASSERT_TRUE(graph.declarePresentEndpoint(endpoint));

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    EXPECT_FALSE(Analyze(graph, scratchArena, analysis));
    EXPECT_EQ(analysis.diagnostic().status, GpuTaskGraphAnalysisStatus::InvalidPresentationEndpoint);
    EXPECT_EQ(analysis.diagnostic().task, producer.value());
    EXPECT_EQ(analysis.diagnostic().resource, resource.value());
    EXPECT_FALSE(analysis.valid());
}

void GpuHazardOwner_CheckOwnershipStatistics(in usize resourceCount){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    ScratchArena declarationScratch = ScratchArena(s_TaskGpuScratch);
    Vector<GpuTaskResourceUse> uses = Vector<GpuTaskResourceUse>();
    uses.reserve(resourceCount * 2u);
    for(usize resourceIndex = 0u; resourceIndex < resourceCount; ++resourceIndex){
        const auto identityNameResult = IndexedName(s_GpuCaseOwnershipStatisticsResource, resourceIndex);
        ASSERT_TRUE(identityNameResult.has_value());
        const auto resourceResult = AddTextureMetadata(
            graph,
            identityNameResult.value(),
            "Ownership Statistics Texture",
            ResourceStates::Common,
            ResourceQueueSharing::Exclusive
        );
        ASSERT_TRUE(resourceResult.has_value());
        const GpuGraphResourceId resource = resourceResult.value();
        ASSERT_TRUE(resource.valid());
        for(u32 rangeIndex = 0u; rangeIndex < 2u; ++rangeIndex){
            GpuTaskResourceUse use = GpuTaskResourceUse();
            use.resource = resource;
            use.range.textureSubresources = TextureSubresourceSet(rangeIndex * 2u, 1u, 0u, 1u);
            use.requiredState = ResourceStates::CopySource;
            use.access = GpuTaskResourceAccess::Write;
            uses.push_back(use);
        }
    }
    for(usize taskIndex = 0u; taskIndex < 3u; ++taskIndex){
        GpuTaskDesc desc = GpuTaskDesc();
        const auto resourceNameResult = IndexedName(s_GpuCaseOwnershipStatisticsTask, taskIndex);
        ASSERT_TRUE(resourceNameResult.has_value());
        desc.setIdentity(resourceNameResult.value());
        desc.setMarkerLabel("Ownership Statistics Task");
        desc.setResourceUses(uses);
        GpuTaskCommandRequirements commands = GraphicsCommands();
        if(taskIndex == 1u)
            commands = ComputeCommands();
        const auto gpuTaskAdmission = graph.addTask(desc, commands);
        ASSERT_TRUE(gpuTaskAdmission.has_value());
        ASSERT_TRUE(gpuTaskAdmission.value().valid());
    }

    ThreeQueueCompile compilation = GpuHazardOwner_MakeThreeQueueCompile(testArena);
    {
        ASSERT_TRUE(compilation.compile(graph));
        ASSERT_EQ(compilation.analysis.inferredEdges().size(), resourceCount * 2u);
        for(usize edgeIndex = 0u; edgeIndex < compilation.analysis.inferredEdges().size(); ++edgeIndex){
            const GpuTaskDependencyEdge edge = compilation.analysis.inferredEdges()[edgeIndex];
            EXPECT_EQ(edge.producer.index, edgeIndex / resourceCount);
            EXPECT_EQ(edge.consumer.index, edgeIndex / resourceCount + 1u);
            EXPECT_EQ(edge.resource.index, edgeIndex % resourceCount);
            EXPECT_EQ(edge.hazard, GpuTaskHazardType::WriteAfterWrite);
        }

        const GpuCompiledGraphReadView plan = GpuCompiledGraphReadView(compilation.compiledGraph);
        const GpuTaskGraphCompileStatistics statistics = plan.compileStatistics();
        EXPECT_EQ(statistics.logicalOwnershipTransferCount, resourceCount * 4u);
        EXPECT_EQ(statistics.logicalOwnershipTransferSignatureCount, resourceCount * 2u);
        EXPECT_EQ(statistics.repeatedOwnershipTransferSignatureCount, resourceCount);
        EXPECT_EQ(statistics.concurrentSharingCouldAvoidTransferCount, resourceCount * 4u);
        EXPECT_EQ(statistics.concurrentSharingAdviceResourceCount, resourceCount);

        const GpuTaskGraphPhysicalQueueCompileStatistics graphics = plan.physicalQueueCompileStatistics(compilation.graphicsQueue.id);
        const GpuTaskGraphPhysicalQueueCompileStatistics compute = plan.physicalQueueCompileStatistics(compilation.computeQueue.id);
        const GpuTaskGraphPhysicalQueueCompileStatistics idle = plan.physicalQueueCompileStatistics(compilation.transferQueue.id);
        EXPECT_EQ(graphics.taskCount, 2u);
        EXPECT_EQ(compute.taskCount, 1u);
        EXPECT_TRUE(idle.valid());
        EXPECT_EQ(idle.taskCount, 0u);
        EXPECT_EQ(idle.incomingLogicalOwnershipTransferCount, 0u);
        EXPECT_EQ(idle.outgoingLogicalOwnershipTransferSignatureCount, 0u);
        EXPECT_EQ(idle.concurrentSharingAdviceResourceCount, 0u);
        EXPECT_FALSE(plan.physicalQueueCompileStatistics(GpuHazardOwner_MakeQueueId(0u, 2u)).valid());
        EXPECT_FALSE(plan.physicalQueueCompileStatistics(GpuHazardOwner_MakeQueueId(17u, 1u)).valid());

        Array<GpuTaskGraphPhysicalQueueCompileStatistics, 2> activeStats = Array<GpuTaskGraphPhysicalQueueCompileStatistics, 2>();
        activeStats[0u] = graphics;
        activeStats[1u] = compute;
        for(in GpuTaskGraphPhysicalQueueCompileStatistics queue : activeStats){
            EXPECT_EQ(queue.incomingLogicalOwnershipTransferCount, resourceCount * 2u);
            EXPECT_EQ(queue.outgoingLogicalOwnershipTransferCount, resourceCount * 2u);
            EXPECT_EQ(queue.incomingLogicalOwnershipTransferSignatureCount, resourceCount);
            EXPECT_EQ(queue.outgoingLogicalOwnershipTransferSignatureCount, resourceCount);
            EXPECT_EQ(queue.ownershipReleaseBarrierCount, resourceCount * 2u);
            EXPECT_EQ(queue.ownershipAcquireBarrierCount, resourceCount * 2u);
            EXPECT_EQ(queue.concurrentSharingAdviceResourceCount, resourceCount);
        }
        EXPECT_EQ(graphics.incomingRepeatedOwnershipTransferSignatureCount, resourceCount);
        EXPECT_EQ(graphics.outgoingRepeatedOwnershipTransferSignatureCount, 0u);
        EXPECT_EQ(compute.incomingRepeatedOwnershipTransferSignatureCount, 0u);
        EXPECT_EQ(compute.outgoingRepeatedOwnershipTransferSignatureCount, resourceCount);
    }

    compilation.compiledGraph.reset();
    {
        const GpuCompiledGraphReadView plan = GpuCompiledGraphReadView(compilation.compiledGraph);
        EXPECT_FALSE(plan.physicalQueueCompileStatistics(compilation.graphicsQueue.id).valid());
    }
    ASSERT_TRUE(compilation.compile(graph));
    const GpuPhysicalQueueTopology invalidTopology = GpuPhysicalQueueTopology();
    EXPECT_FALSE(Compile(compilation.analysis, compilation.assignments, compilation.compiledGraph, declarationScratch, graph, invalidTopology));
    const GpuCompiledGraphReadView plan = GpuCompiledGraphReadView(compilation.compiledGraph);
    EXPECT_FALSE(plan.physicalQueueCompileStatistics(compilation.graphicsQueue.id).valid());
}

void VerifyGpuHazardOwner_CountsRepeatedOwnershipSignaturesAcrossResourcesAndSubranges(){
    GpuHazardOwner_CheckOwnershipStatistics(3u);
    ASSERT_FALSE(TestHasFatalFailure());
    GpuHazardOwner_CheckOwnershipStatistics(17u);
    ASSERT_FALSE(TestHasFatalFailure());
}

void VerifyGpuHazardOwner_DeduplicatesMergedPacketExternalDependenciesInTaskOrder(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuExternalCompletionDesc extDescA = GpuExternalCompletionDesc();
    extDescA.setIdentity(s_GpuCaseTaskGraphMergedExternalA);
    extDescA.setMarkerLabel("Merged External A");
    GpuExternalCompletionDesc extDescB = GpuExternalCompletionDesc();
    extDescB.setIdentity(s_GpuCaseTaskGraphMergedExternalB);
    extDescB.setMarkerLabel("Merged External B");
    GpuExternalCompletionDesc extDescC = GpuExternalCompletionDesc();
    extDescC.setIdentity(s_GpuCaseTaskGraphMergedExternalC);
    extDescC.setMarkerLabel("Merged External C");
    const auto completionsAdmission0 = graph.importExternalCompletion(extDescA);
    const auto completionsAdmission1 = graph.importExternalCompletion(extDescB);
    const auto completionsAdmission2 = graph.importExternalCompletion(extDescC);
    ASSERT_TRUE(completionsAdmission0.has_value());
    ASSERT_TRUE(completionsAdmission1.has_value());
    ASSERT_TRUE(completionsAdmission2.has_value());

    Array<GpuExternalCompletionId, 3> completions = Array<GpuExternalCompletionId, 3>();
    completions[0u] = completionsAdmission0.value();
    completions[1u] = completionsAdmission1.value();
    completions[2u] = completionsAdmission2.value();
    for(in GpuExternalCompletionId completion : completions)
        ASSERT_TRUE(completion.valid());

    Array<GpuExternalCompletionId, 3> firstExternalDependencies = Array<GpuExternalCompletionId, 3>();
    firstExternalDependencies[0u] = completions[1u];
    firstExternalDependencies[1u] = completions[0u];
    firstExternalDependencies[2u] = completions[1u];
    GpuTaskSchedulingHint firstScheduling = GpuTaskSchedulingHint();
    firstScheduling.allowPacketMerge = true;
    GpuTaskDesc firstDesc = GpuTaskDesc();
    firstDesc.setIdentity(s_GpuCaseTaskGraphMergedExternalFirst);
    firstDesc.setMarkerLabel("Merged External First");
    firstDesc.setScheduling(firstScheduling);
    firstDesc.setExternalDependencies(firstExternalDependencies);
    const auto firstResult = graph.addTask(firstDesc);
    ASSERT_TRUE(firstResult.has_value());
    const GpuTaskId first = firstResult.value();
    ASSERT_TRUE(first.valid());

    Array<GpuExternalCompletionId, 4> secondExternalDependencies = Array<GpuExternalCompletionId, 4>();
    secondExternalDependencies[0u] = completions[0u];
    secondExternalDependencies[1u] = completions[2u];
    secondExternalDependencies[2u] = completions[1u];
    secondExternalDependencies[3u] = completions[2u];
    Array<GpuTaskId, 1> firstDeps = Array<GpuTaskId, 1>();
    firstDeps[0u] = first;
    GpuTaskSchedulingHint secondScheduling = GpuTaskSchedulingHint();
    secondScheduling.allowPacketMerge = true;
    secondScheduling.mergeWithPrevious = true;
    GpuTaskDesc secondDesc = GpuTaskDesc();
    secondDesc.setIdentity(s_GpuCaseTaskGraphMergedExternalSecond);
    secondDesc.setMarkerLabel("Merged External Second");
    secondDesc.setScheduling(secondScheduling);
    secondDesc.setDependencies(firstDeps);
    secondDesc.setExternalDependencies(secondExternalDependencies);
    const auto secondResult = graph.addTask(secondDesc);
    ASSERT_TRUE(secondResult.has_value());
    const GpuTaskId second = secondResult.value();
    ASSERT_TRUE(second.valid());

    Array<GpuPhysicalQueueInfo, 1> queues = Array<GpuPhysicalQueueInfo, 1>();
    queues[0u] = GraphicsQueue();
    const GpuPhysicalQueueTopology topology = MakeTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

    const auto analysisDependencies = analysis.externalDependencies();
    ASSERT_EQ(analysisDependencies.size(), 5u);
    EXPECT_EQ(analysisDependencies[0u].completion, completions[1u]);
    EXPECT_EQ(analysisDependencies[0u].consumer, first);
    EXPECT_EQ(analysisDependencies[1u].completion, completions[0u]);
    EXPECT_EQ(analysisDependencies[1u].consumer, first);
    EXPECT_EQ(analysisDependencies[2u].completion, completions[0u]);
    EXPECT_EQ(analysisDependencies[2u].consumer, second);
    EXPECT_EQ(analysisDependencies[3u].completion, completions[2u]);
    EXPECT_EQ(analysisDependencies[3u].consumer, second);
    EXPECT_EQ(analysisDependencies[4u].completion, completions[1u]);
    EXPECT_EQ(analysisDependencies[4u].consumer, second);

    const GpuSubmissionPacketId packet = compiledPlan.packetForTask(first);
    ASSERT_TRUE(packet.valid());
    EXPECT_EQ(compiledPlan.packetForTask(second), packet);
    const GpuCompiledPacketView pktView = compiledPlan.packet(packet);
    const Optional<GpuSubmissionPacket> pktPlan = PacketPlan(pktView);
    ASSERT_TRUE(pktPlan.has_value());
    ASSERT_EQ(pktPlan.value().taskCount, 2u);
    const Span<GpuExternalCompletionId> packetDependencies = PacketExternalDependencies(pktView);
    ASSERT_EQ(packetDependencies.size(), 3u);
    EXPECT_EQ(packetDependencies[0u], completions[1u]);
    EXPECT_EQ(packetDependencies[1u], completions[0u]);
    EXPECT_EQ(packetDependencies[2u], completions[2u]);
    EXPECT_EQ(compiledPlan.compileStatistics().declaredExternalDependencyCount, analysisDependencies.size());
    EXPECT_EQ(compiledPlan.compileStatistics().packetExternalDependencyCount, 3u);
}

void VerifyGpuHazardOwner_CompilesOneTaskPacketsWithDependenciesAndLifecycleBoundaries(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const GpuPhysicalQueueInfo producerQueue = DedicatedComputeQueue();
    const QueueSubmissionToken completionToken = GpuHazardOwner_MakeToken(41u, producerQueue.id.index, producerQueue.id.deviceGeneration, producerQueue.queueClass);
    GpuExternalCompletionDesc extDesc = GpuExternalCompletionDesc();
    extDesc.setIdentity(s_GpuCaseTaskGraphPacketExternal);
    extDesc.setMarkerLabel("External Completion");
    extDesc.setToken(completionToken);
    const auto completionResult = graph.importExternalCompletion(extDesc);
    ASSERT_TRUE(completionResult.has_value());
    const GpuExternalCompletionId completion = completionResult.value();
    ASSERT_TRUE(completion.valid());

    const auto recoveryDomainResult = AddHazardDomain(graph, s_GpuCaseTaskGraphPacketRecoveryDomain, "Frame Recovery Timing");
    ASSERT_TRUE(recoveryDomainResult.has_value());
    const GpuGraphResourceId recoveryDomain = recoveryDomainResult.value();
    ASSERT_TRUE(recoveryDomain.valid());

    GpuTaskDesc firstDesc = GpuTaskDesc();
    firstDesc.setIdentity(s_GpuCaseTaskGraphPacketFirst);
    firstDesc.setMarkerLabel("Packet First");
    const Expected<GpuTaskId> firstResult = AddPacketLifecycleTask(graph, firstDesc, GpuQueueCapability::Compute);
    ASSERT_TRUE(firstResult.has_value());
    const GpuTaskId first = firstResult.value();
    ASSERT_TRUE(first.valid());

    Array<GpuTaskId, 1> secondTaskDeps = Array<GpuTaskId, 1>();
    secondTaskDeps[0u] = first;
    Array<GpuExternalCompletionId, 1> secondExternalDeps = Array<GpuExternalCompletionId, 1>();
    secondExternalDeps[0u] = completion;
    GpuTaskDesc secondDesc = GpuTaskDesc();
    secondDesc.setIdentity(s_GpuCaseTaskGraphPacketSecond);
    secondDesc.setMarkerLabel("Packet Second");
    secondDesc.setDependencies(secondTaskDeps);
    secondDesc.setExternalDependencies(secondExternalDeps);
    const Expected<GpuTaskId> secondResult = AddPacketLifecycleTask(graph, secondDesc, GpuQueueCapability::Graphics);
    ASSERT_TRUE(secondResult.has_value());
    const GpuTaskId second = secondResult.value();
    ASSERT_TRUE(second.valid());

    GpuTaskDesc transferDesc = GpuTaskDesc();
    transferDesc.setIdentity(s_GpuCaseTaskGraphPacketTransfer);
    transferDesc.setMarkerLabel("Packet Transfer");
    const Expected<GpuTaskId> transferResult = AddPacketLifecycleTask(graph, transferDesc, GpuQueueCapability::Transfer);
    ASSERT_TRUE(transferResult.has_value());
    const GpuTaskId transfer = transferResult.value();
    ASSERT_TRUE(transfer.valid());

    Array<GpuTaskResourceUse, 1> recoveryUses = Array<GpuTaskResourceUse, 1>();
    recoveryUses[0u].resource = recoveryDomain;
    recoveryUses[0u].requiredState = ResourceStates::Common;
    recoveryUses[0u].access = GpuTaskResourceAccess::ReadWrite;
    GpuTaskSchedulingHint recoveryScheduling = GpuTaskSchedulingHint();
    recoveryScheduling.forceSubmissionBoundary = true;
    recoveryScheduling.allowPacketMerge = false;
    recoveryScheduling.joinsAcceptedQueueFrontier = true;
    recoveryScheduling.isRecoverySubmission = true;
    GpuTaskDesc recoveryDesc = GpuTaskDesc();
    recoveryDesc.setIdentity(s_GpuCaseTaskGraphPacketRecovery);
    recoveryDesc.setMarkerLabel("Frame Recovery");
    recoveryDesc.setScheduling(recoveryScheduling);
    recoveryDesc.setResourceUses(recoveryUses);
    const Expected<GpuTaskId> recoveryResult = AddPacketLifecycleTask(graph, recoveryDesc, GpuQueueCapability::Graphics);
    ASSERT_TRUE(recoveryResult.has_value());
    const GpuTaskId recovery = recoveryResult.value();
    ASSERT_TRUE(recovery.valid());

    Array<GpuPhysicalQueueInfo, 3> queues = Array<GpuPhysicalQueueInfo, 3>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    queues[2u] = DedicatedTransferQueue();
    const GpuPhysicalQueueTopology topology = MakeTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    {
        const GpuTaskGraphReadViews reads = GpuTaskGraphReadViews(graph, compiledGraph);
        ASSERT_TRUE(reads.valid());
        ASSERT_EQ(reads.compiled.taskCount(), 4u);
        ASSERT_EQ(reads.compiled.packetCount(), 4u);
        const GpuSubmissionPacketId firstPacket = reads.compiled.packetForTask(first);
        const GpuSubmissionPacketId secondPacket = reads.compiled.packetForTask(second);
        const GpuSubmissionPacketId transferPacket = reads.compiled.packetForTask(transfer);
        const GpuSubmissionPacketId recoveryPacket = reads.compiled.packetForTask(recovery);
        ASSERT_TRUE(firstPacket.valid());
        ASSERT_TRUE(secondPacket.valid());
        ASSERT_TRUE(transferPacket.valid());
        ASSERT_TRUE(recoveryPacket.valid());
        EXPECT_NE(firstPacket, secondPacket);
        EXPECT_NE(recoveryPacket, secondPacket);
        EXPECT_FALSE(reads.compiled.tasksSharePacket(first, second));
        EXPECT_FALSE(reads.compiled.tasksSharePacket(first, GpuTaskId()));
        EXPECT_TRUE(reads.compiled.taskPrecedesOrSharesPacket(first, second));
        EXPECT_FALSE(reads.compiled.taskPrecedesOrSharesPacket(second, first));
        EXPECT_FALSE(reads.compiled.taskPrecedesOrSharesPacket(first, GpuTaskId()));
        EXPECT_FALSE(reads.compiled.taskPrecedesInSamePacket(first, second));
        EXPECT_FALSE(reads.compiled.taskPrecedesInSamePacket(first, first));
        const Span<GpuTaskId> emptyTasks = Span<GpuTaskId>();
        EXPECT_FALSE(reads.compiled.tasksFormContiguousPacketSequence(emptyTasks));
        EXPECT_FALSE(reads.compiled.taskJoinsAcceptedQueueFrontier(first));
        EXPECT_TRUE(reads.compiled.taskJoinsAcceptedQueueFrontier(recovery));
        EXPECT_FALSE(reads.compiled.taskJoinsAcceptedQueueFrontier(GpuTaskId()));
        EXPECT_FALSE(QueueInfoForTaskValue(reads.compiled, GpuTaskId()).has_value());

        const GpuSubmissionPacketRange firstTwoPacketRange = reads.compiled.packetRange(firstPacket, secondPacket);
        ASSERT_TRUE(firstTwoPacketRange.valid());
        EXPECT_TRUE(reads.compiled.validPacketRange(firstTwoPacketRange));
        EXPECT_TRUE(reads.compiled.validPacketRange(reads.compiled.allPacketRange()));
        EXPECT_FALSE(reads.compiled.packetRange(secondPacket, firstPacket).valid());
        EXPECT_FALSE(reads.compiled.packetRangeForTasks(second, first).valid());
        EXPECT_FALSE(reads.compiled.packetRangeForTasks(first, GpuTaskId()).valid());
        GpuSubmissionPacketRange oversizedRange = GpuSubmissionPacketRange();
        oversizedRange.first = firstPacket;
        oversizedRange.packetCount = reads.compiled.packetCount() + 1u;
        EXPECT_FALSE(reads.compiled.validPacketRange(oversizedRange));

        const GpuCompiledPacketView secondPacketView = reads.compiled.packet(secondPacket);
        ASSERT_TRUE(secondPacketView.valid());
        const Optional<GpuSubmissionPacket> secondPktPlan = PacketPlan(secondPacketView);
        ASSERT_TRUE(secondPktPlan.has_value());
        ASSERT_EQ(secondPktPlan.value().taskCount, 1u);
        const Span<GpuPacketDependency> secondDeps = PacketDependencies(secondPacketView);
        const Span<GpuExternalCompletionId> secondExtDeps = PacketExternalDependencies(secondPacketView);
        ASSERT_EQ(secondDeps.size(), 1u);
        ASSERT_EQ(secondExtDeps.size(), 1u);
        EXPECT_EQ(secondDeps[0u].producer, firstPacket);
        EXPECT_EQ(secondExtDeps[0u], completion);

        const GpuCompiledPacketView recoveryPacketView = reads.compiled.packet(recoveryPacket);
        ASSERT_TRUE(recoveryPacketView.valid());
        const Optional<GpuSubmissionPacket> recoveryPktPlan = PacketPlan(recoveryPacketView);
        ASSERT_TRUE(recoveryPktPlan.has_value());
        EXPECT_EQ(recoveryPktPlan.value().dependencyCount, 0u);
        EXPECT_EQ(recoveryPktPlan.value().externalDependencyCount, 0u);
    }

    compiledGraph.reset();
    const GpuCompiledGraphReadView resetPlan = GpuCompiledGraphReadView(compiledGraph);
    const GpuPhysicalQueueTopology resetQueueTopology = resetPlan.queueTopology();
    EXPECT_FALSE(HasTopologyQueuesPtr(resetQueueTopology));
    EXPECT_EQ(resetQueueTopology.queueCount, 0u);
}

void VerifyGpuHazardOwner_KeepsExplicitPacketDependenciesOutOfRecordingReadyFrontiers(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const auto firstResult = GpuHazardOwner_AddEmptyTask(s_GpuCaseTaskGraphRecordingFrontierFirst, "Recording Frontier First", graph);
    ASSERT_TRUE(firstResult.has_value());
    const GpuTaskId first = firstResult.value();
    const auto secondResult = GpuHazardOwner_AddEmptyTask(s_GpuCaseTaskGraphRecordingFrontierSecond, "Recording Frontier Second", graph);
    ASSERT_TRUE(secondResult.has_value());
    const GpuTaskId second = secondResult.value();

    Array<GpuTaskId, 1> thirdDependencies = Array<GpuTaskId, 1>();
    thirdDependencies[0u] = first;
    const auto thirdResult = GpuHazardOwner_AddDepTask(s_GpuCaseTaskGraphRecordingFrontierThird, "Recording Frontier Third", thirdDependencies, graph);
    ASSERT_TRUE(thirdResult.has_value());
    const GpuTaskId third = thirdResult.value();

    Array<GpuTaskId, 2> fourthDependencies = Array<GpuTaskId, 2>();
    fourthDependencies[0u] = second;
    fourthDependencies[1u] = third;
    const auto fourthResult = GpuHazardOwner_AddDepTask(s_GpuCaseTaskGraphRecordingFrontierFourth, "Recording Frontier Fourth", fourthDependencies, graph);
    ASSERT_TRUE(fourthResult.has_value());
    const GpuTaskId fourth = fourthResult.value();
    ASSERT_TRUE(first.valid());
    ASSERT_TRUE(second.valid());
    ASSERT_TRUE(third.valid());
    ASSERT_TRUE(fourth.valid());

    SingleQueueCompile singleQueueCompile = GpuHazardOwner_MakeSingleQueueCompile(testArena);
    ASSERT_TRUE(singleQueueCompile.compile(graph));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(singleQueueCompile.compiledGraph);

    const GpuSubmissionPacketId firstPacket = compiledPlan.packetForTask(first);
    const GpuSubmissionPacketId secondPacket = compiledPlan.packetForTask(second);
    const GpuSubmissionPacketId thirdPacket = compiledPlan.packetForTask(third);
    const GpuSubmissionPacketId fourthPacket = compiledPlan.packetForTask(fourth);
    ASSERT_TRUE(firstPacket.valid());
    ASSERT_TRUE(secondPacket.valid());
    ASSERT_TRUE(thirdPacket.valid());
    ASSERT_TRUE(fourthPacket.valid());
    const Optional<GpuSubmissionPacket> firstPktPlan = PacketPlan(compiledPlan.packet(firstPacket));
    const Optional<GpuSubmissionPacket> secondPktPlan = PacketPlan(compiledPlan.packet(secondPacket));
    const Optional<GpuSubmissionPacket> thirdPktPlan = PacketPlan(compiledPlan.packet(thirdPacket));
    const Optional<GpuSubmissionPacket> fourthPktPlan = PacketPlan(compiledPlan.packet(fourthPacket));
    ASSERT_TRUE(firstPktPlan.has_value());
    ASSERT_TRUE(secondPktPlan.has_value());
    ASSERT_TRUE(thirdPktPlan.has_value());
    ASSERT_TRUE(fourthPktPlan.has_value());
    EXPECT_EQ(firstPktPlan.value().recordingFrontier, 0u);
    EXPECT_EQ(secondPktPlan.value().recordingFrontier, 0u);
    EXPECT_EQ(thirdPktPlan.value().recordingFrontier, 0u);
    EXPECT_EQ(fourthPktPlan.value().recordingFrontier, 0u);
    EXPECT_EQ(compiledPlan.compileStatistics().recordingFrontierCount, 1u);

    const Span<GpuPacketDependency> thirdDeps = PacketDependencies(compiledPlan.packet(thirdPacket));
    ASSERT_EQ(thirdDeps.size(), 1u);
    EXPECT_EQ(thirdDeps[0u].producer, firstPacket);

    const Span<GpuPacketDependency> fourthDeps = PacketDependencies(compiledPlan.packet(fourthPacket));
    ASSERT_EQ(fourthDeps.size(), 2u);
    b8 hasSecondProducer = false;
    b8 hasThirdProducer = false;
    for(in GpuPacketDependency dependency : fourthDeps){
        if(dependency.producer == secondPacket)
            hasSecondProducer = true;
        if(dependency.producer == thirdPacket)
            hasThirdProducer = true;
    }
    EXPECT_TRUE(hasSecondProducer);
    EXPECT_TRUE(hasThirdProducer);
}

void VerifyGpuHazardOwner_PlansSchedulingPacketDependenciesInStableIncomingOrder(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const auto firstResult = GpuHazardOwner_AddEmptyTask(s_GpuCaseTaskGraphStablePacketDependencyFirst, "Stable Packet Dependency First", graph);
    ASSERT_TRUE(firstResult.has_value());
    const GpuTaskId first = firstResult.value();
    const auto secondResult = GpuHazardOwner_AddEmptyTask(s_GpuCaseTaskGraphStablePacketDependencySecond, "Stable Packet Dependency Second", graph);
    ASSERT_TRUE(secondResult.has_value());
    const GpuTaskId second = secondResult.value();
    const auto thirdResult = GpuHazardOwner_AddEmptyTask(s_GpuCaseTaskGraphStablePacketDependencyThird, "Stable Packet Dependency Third", graph);
    ASSERT_TRUE(thirdResult.has_value());
    const GpuTaskId third = thirdResult.value();

    Array<GpuTaskId, 3> consumerDependencies = Array<GpuTaskId, 3>();
    consumerDependencies[0u] = third;
    consumerDependencies[1u] = first;
    consumerDependencies[2u] = second;
    const auto consumerResult = GpuHazardOwner_AddDepTask(
        s_GpuCaseTaskGraphStablePacketDependencyConsumer,
        "Stable Packet Dependency Consumer",
        consumerDependencies,
        graph
    );
    ASSERT_TRUE(consumerResult.has_value());
    const GpuTaskId consumer = consumerResult.value();
    ASSERT_TRUE(first.valid());
    ASSERT_TRUE(second.valid());
    ASSERT_TRUE(third.valid());
    ASSERT_TRUE(consumer.valid());

    Array<GpuPhysicalQueueInfo, 1> queues = Array<GpuPhysicalQueueInfo, 1>();
    queues[0u] = GraphicsQueue();
    const GpuPhysicalQueueTopology topology = MakeTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

    const GpuTaskGraphSchedulingTaskIndexView producers = analysis.schedulingProducers(consumer);
    ASSERT_EQ(producers.taskCount, consumerDependencies.size());
    EXPECT_EQ(producers[0u], third.index);
    EXPECT_EQ(producers[1u], first.index);
    EXPECT_EQ(producers[2u], second.index);

    const GpuSubmissionPacketId firstPacket = compiledPlan.packetForTask(first);
    const GpuSubmissionPacketId secondPacket = compiledPlan.packetForTask(second);
    const GpuSubmissionPacketId thirdPacket = compiledPlan.packetForTask(third);
    const GpuSubmissionPacketId consumerPacket = compiledPlan.packetForTask(consumer);
    ASSERT_TRUE(firstPacket.valid());
    ASSERT_TRUE(secondPacket.valid());
    ASSERT_TRUE(thirdPacket.valid());
    ASSERT_TRUE(consumerPacket.valid());
    const Span<GpuPacketDependency> dependencies = PacketDependencies(compiledPlan.packet(consumerPacket));
    ASSERT_EQ(dependencies.size(), consumerDependencies.size());
    EXPECT_EQ(dependencies[0u].producer, thirdPacket);
    EXPECT_EQ(dependencies[1u].producer, firstPacket);
    EXPECT_EQ(dependencies[2u].producer, secondPacket);
}

void VerifyGpuHazardOwner_DerivesRecordingReadyFrontiersFromStateSeedProducers(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const auto bufferResult = AddBufferMetadata(graph, s_GpuCaseTaskGraphRecordingFrontierStateSeedBuffer, "Recording Frontier State Seed Buffer");
    ASSERT_TRUE(bufferResult.has_value());
    const GpuGraphResourceId buffer = bufferResult.value();
    ASSERT_TRUE(buffer.valid());
    const auto orderingProducerResult = GpuHazardOwner_AddEmptyTask(
        s_GpuCaseTaskGraphRecordingFrontierOrderingProducer,
        "Recording Frontier Ordering Producer",
        graph
    );
    ASSERT_TRUE(orderingProducerResult.has_value());
    const GpuTaskId orderingProducer = orderingProducerResult.value();
    ASSERT_TRUE(orderingProducer.valid());

    const GpuTaskCommandRequirements graphicsCommands = GraphicsCommands();
    GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
    scheduling.forceSubmissionBoundary = true;
    scheduling.allowPacketMerge = false;
    scheduling.allowParallelRecording = true;

    Array<GpuTaskResourceUse, 1> producerUses = Array<GpuTaskResourceUse, 1>();
    producerUses[0u].resource = buffer;
    producerUses[0u].requiredState = ResourceStates::CopyDest;
    producerUses[0u].access = GpuTaskResourceAccess::Write;
    GpuTaskDesc producerDesc = GpuTaskDesc();
    producerDesc.setIdentity(s_GpuCaseTaskGraphRecordingFrontierStateSeedProducer);
    producerDesc.setMarkerLabel("Recording Frontier State Seed Producer");
    producerDesc.setScheduling(scheduling);
    producerDesc.setResourceUses(producerUses);
    const auto producerResult = graph.addTask(producerDesc, graphicsCommands);
    ASSERT_TRUE(producerResult.has_value());
    const GpuTaskId producer = producerResult.value();
    ASSERT_TRUE(producer.valid());

    Array<GpuTaskId, 2> consumerDependencies = Array<GpuTaskId, 2>();
    consumerDependencies[0u] = producer;
    consumerDependencies[1u] = orderingProducer;
    Array<GpuTaskResourceUse, 1> consumerUses = Array<GpuTaskResourceUse, 1>();
    consumerUses[0u].resource = buffer;
    consumerUses[0u].requiredState = ResourceStates::CopySource;
    consumerUses[0u].access = GpuTaskResourceAccess::Read;
    GpuTaskDesc consumerDesc = GpuTaskDesc();
    consumerDesc.setIdentity(s_GpuCaseTaskGraphRecordingFrontierStateSeedConsumer);
    consumerDesc.setMarkerLabel("Recording Frontier State Seed Consumer");
    consumerDesc.setScheduling(scheduling);
    consumerDesc.setDependencies(consumerDependencies);
    consumerDesc.setResourceUses(consumerUses);
    const auto consumerResult = graph.addTask(consumerDesc, graphicsCommands);
    ASSERT_TRUE(consumerResult.has_value());
    const GpuTaskId consumer = consumerResult.value();
    ASSERT_TRUE(consumer.valid());

    SingleQueueCompile singleQueueCompile = GpuHazardOwner_MakeSingleQueueCompile(testArena);
    ASSERT_TRUE(singleQueueCompile.compile(graph));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(singleQueueCompile.compiledGraph);

    const GpuSubmissionPacketId orderingProducerPacket = compiledPlan.packetForTask(orderingProducer);
    const GpuSubmissionPacketId producerPacket = compiledPlan.packetForTask(producer);
    const GpuSubmissionPacketId consumerPacket = compiledPlan.packetForTask(consumer);
    const GpuCompiledTaskView consumerView = compiledPlan.findTask(consumer);
    const Optional<GpuCompiledTask> compiledConsumer = TaskPlan(consumerView);
    ASSERT_TRUE(orderingProducerPacket.valid());
    ASSERT_TRUE(producerPacket.valid());
    ASSERT_TRUE(consumerPacket.valid());
    ASSERT_NE(producerPacket, consumerPacket);
    ASSERT_TRUE(compiledConsumer.has_value());
    const Optional<GpuSubmissionPacket> producerPktPlan = PacketPlan(compiledPlan.packet(producerPacket));
    const Optional<GpuSubmissionPacket> consumerPktPlan = PacketPlan(compiledPlan.packet(consumerPacket));
    ASSERT_TRUE(producerPktPlan.has_value());
    ASSERT_TRUE(consumerPktPlan.has_value());
    EXPECT_EQ(producerPktPlan.value().recordingFrontier, 0u);
    EXPECT_EQ(consumerPktPlan.value().recordingFrontier, 1u);
    EXPECT_EQ(compiledPlan.compileStatistics().recordingFrontierCount, 2u);
    const Span<GpuPacketDependency> dependencies = PacketDependencies(compiledPlan.packet(consumerPacket));
    ASSERT_EQ(dependencies.size(), 2u);
    // Deduplicating a state-seed dependency preserves the original scheduling order.
    EXPECT_EQ(dependencies[0u].producer, producerPacket);
    EXPECT_EQ(dependencies[1u].producer, orderingProducerPacket);
    const Span<GpuPacketStateSeed> stateSeeds = PrologueStateSeeds(consumerView);
    ASSERT_EQ(stateSeeds.size(), 1u);
    EXPECT_EQ(stateSeeds[0u].resource, buffer);
    EXPECT_EQ(stateSeeds[0u].sourcePacket, producerPacket);
}


