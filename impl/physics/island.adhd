////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/physics/solver_set.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class IslandSplitScratch{
    public Vector<u32> dsuParents;
    public Vector<u8> dsuRanks;
    public Vector<u32> rootToIsland;
    public Vector<u32> bodyAssignedIsland;

    public void clear(){
        this.dsuParents.clear();
        this.dsuRanks.clear();
        this.rootToIsland.clear();
        this.bodyAssignedIsland.clear();
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u32 CreateIslandInWorld(mut Vector<Island> islands, mut Vector<u32> freeIslandIds, mut Vector<SolverSet> sets, in u32 setIndex){
    u32 islandId = s_NullIndex;
    if(!freeIslandIds.empty()){
        islandId = freeIslandIds[freeIslandIds.size() - 1u];
        freeIslandIds.pop_back();
    }
    else{
        islandId = cast<u32>(islands.size());
        islands.push_back(Island());
    }

    mut Island island = islands[islandId];
    island.setIndex = setIndex;
    island.localIndex = cast<u32>(sets[setIndex].islands.size());
    island.islandId = islandId;
    island.constraintRemoveCount = 0u;
    island.bodies.clear();
    island.contacts.clear();
    island.joints.clear();
    island.alive = true;
    sets[setIndex].islands.push_back(islandId);
    return islandId;
}

void DestroyIslandInWorld(mut Vector<Island> islands, mut Vector<u32> freeIslandIds, mut Vector<SolverSet> sets, in u32 islandId){
    if(islandId >= islands.size() || !islands[islandId].alive)
        return;

    in Island island = islands[islandId];
    const u32 setIndex = island.setIndex;
    const u32 localIdx = island.localIndex;
    if(setIndex < sets.size() && localIdx < sets[setIndex].islands.size()){
        mut Vector<u32> setIslands = sets[setIndex].islands;
        const u32 lastIdx = cast<u32>(setIslands.size() - 1u);
        if(localIdx != lastIdx){
            const u32 movedIslandId = setIslands[lastIdx];
            setIslands[localIdx] = movedIslandId;
            islands[movedIslandId].localIndex = localIdx;
        }
        setIslands.pop_back();
    }

    islands[islandId].setIndex = s_NullIndex;
    islands[islandId].localIndex = s_NullIndex;
    islands[islandId].constraintRemoveCount = 0u;
    islands[islandId].bodies.clear();
    islands[islandId].contacts.clear();
    islands[islandId].joints.clear();
    islands[islandId].alive = false;
    freeIslandIds.push_back(islandId);
}

void AddBodyToIsland(mut Vector<Body> bodies, mut Vector<Island> islands, in u32 bodyId, in u32 islandId){
    mut Body body = bodies[bodyId];
    mut Island island = islands[islandId];
    body.islandId = islandId;
    body.islandIndex = cast<u32>(island.bodies.size());
    island.bodies.push_back(bodyId);
}

void RemoveBodyFromIsland(mut Vector<Body> bodies, mut Vector<Island> islands, in u32 bodyId){
    mut Body body = bodies[bodyId];
    const u32 islandId = body.islandId;
    if(islandId == s_NullIndex || islandId >= islands.size() || !islands[islandId].alive)
        return;

    mut Island island = islands[islandId];
    const u32 idx = body.islandIndex;
    const u32 lastIdx = cast<u32>(island.bodies.size() - 1u);
    if(idx < island.bodies.size()){
        if(idx != lastIdx){
            const u32 movedBodyId = island.bodies[lastIdx];
            island.bodies[idx] = movedBodyId;
            bodies[movedBodyId].islandIndex = idx;
        }
        island.bodies.pop_back();
    }
    body.islandId = s_NullIndex;
    body.islandIndex = s_NullIndex;
}

void WakeIslandInSets(
    mut Vector<Body> bodies,
    mut Vector<Island> islands,
    mut Vector<SolverSet> sets,
    in u32 islandId
){
    if(islandId == s_NullIndex || islandId >= islands.size() || !islands[islandId].alive)
        return;
    const u32 oldSetIndex = islands[islandId].setIndex;
    if(oldSetIndex == s_AwakeSetIndex || oldSetIndex < 3u)
        return;

    const u32 bodyCount = cast<u32>(islands[islandId].bodies.size());
    for(u32 i = 0u; i < bodyCount; ++i){
        const u32 bodyId = islands[islandId].bodies[i];
        mut Body body = bodies[bodyId];
        if(body.setIndex != oldSetIndex || body.localIndex >= sets[oldSetIndex].sims.size())
            continue;

        const BodySim sim = sets[oldSetIndex].sims[body.localIndex];
        BodySim awakeSim = sim;
        awakeSim.flags |= cast<u32>(BodyFlags::JustWoke);
        body.flags |= cast<u32>(BodyFlags::JustWoke);
        BodyState state;
        state.setFlags(awakeSim.flags);
        body.sleepTime = 0.0f;
        RemoveBodyFromSolverSet(bodies, sets[oldSetIndex], body.localIndex);
        AddBodyToSolverSet(bodies, sets[s_AwakeSetIndex], awakeSim, state);
    }

    const u32 oldLocal = islands[islandId].localIndex;
    if(oldLocal < sets[oldSetIndex].islands.size()){
        const u32 lastIdx = cast<u32>(sets[oldSetIndex].islands.size() - 1u);
        if(oldLocal != lastIdx){
            const u32 movedId = sets[oldSetIndex].islands[lastIdx];
            sets[oldSetIndex].islands[oldLocal] = movedId;
            islands[movedId].localIndex = oldLocal;
        }
        sets[oldSetIndex].islands.pop_back();
    }
    islands[islandId].setIndex = s_AwakeSetIndex;
    islands[islandId].localIndex = cast<u32>(sets[s_AwakeSetIndex].islands.size());
    sets[s_AwakeSetIndex].islands.push_back(islandId);
    if(islands[islandId].constraintRemoveCount > 0u)
        sets[s_AwakeSetIndex].dirtySplitIslands.push_back(islandId);
}

void MarkIslandDirtySplit(mut Vector<Island> islands, mut Vector<SolverSet> sets, in u32 islandId){
    if(islandId == s_NullIndex || islandId >= islands.size() || !islands[islandId].alive)
        return;
    ++islands[islandId].constraintRemoveCount;
    if(islands[islandId].constraintRemoveCount == 1u && islands[islandId].setIndex == s_AwakeSetIndex && s_AwakeSetIndex < sets.size())
        sets[s_AwakeSetIndex].dirtySplitIslands.push_back(islandId);
}

void WakeBodyWithIsland(
    mut Vector<Body> bodies,
    mut Vector<Island> islands,
    mut Vector<SolverSet> sets,
    in u32 bodyId
){
    if(bodyId >= bodies.size() || !bodies[bodyId].alive)
        return;
    const u32 setIdx = bodies[bodyId].setIndex;
    if(setIdx == s_StaticSetIndex || setIdx == s_DisabledSetIndex || setIdx == s_AwakeSetIndex)
        return;

    bodies[bodyId].sleepTime = 0.0f;
    if(bodies[bodyId].islandId != s_NullIndex){
        WakeIslandInSets(bodies, islands, sets, bodies[bodyId].islandId);
        return;
    }

    if(bodies[bodyId].localIndex < sets[setIdx].sims.size()){
        const BodySim sim = sets[setIdx].sims[bodies[bodyId].localIndex];
        BodySim awakeSim = sim;
        awakeSim.flags |= BodyFlags::JustWoke;
        bodies[bodyId].flags |= BodyFlags::JustWoke;
        bodies[bodyId].sleepTime = 0.0f;
        BodyState state;
        state.setFlags(awakeSim.flags);
        RemoveBodyFromSolverSet(bodies, sets[setIdx], bodies[bodyId].localIndex);
        AddBodyToSolverSet(bodies, sets[s_AwakeSetIndex], awakeSim, state);
    }
}

u32 MergeIslandsInWorld(
    mut Vector<Body> bodies,
    mut Vector<Island> islands,
    mut Vector<u32> freeIslandIds,
    mut Vector<SolverSet> sets,
    mut Vector<Contact> contacts,
    mut Vector<Joint> joints,
    in u32 islandIdA,
    in u32 islandIdB
){
    if(islandIdA == islandIdB)
        return islandIdA;
    if(islandIdA == s_NullIndex)
        return islandIdB;
    if(islandIdB == s_NullIndex)
        return islandIdA;

    WakeIslandInSets(bodies, islands, sets, islandIdA);
    WakeIslandInSets(bodies, islands, sets, islandIdB);

    u32 bigId = islandIdA;
    u32 smallId = islandIdB;
    if(islands[smallId].bodies.size() > islands[bigId].bodies.size()){
        bigId = islandIdB;
        smallId = islandIdA;
    }

    mut Island big = islands[bigId];
    mut Island small = islands[smallId];

    for(usize i = 0u; i < small.bodies.size(); ++i){
        const u32 bodyId = small.bodies[i];
        bodies[bodyId].islandId = bigId;
        bodies[bodyId].islandIndex = cast<u32>(big.bodies.size());
        big.bodies.push_back(bodyId);
    }

    for(usize i = 0u; i < small.contacts.size(); ++i){
        const ContactLink link = small.contacts[i];
        contacts[link.contactId].islandId = bigId;
        contacts[link.contactId].islandIndex = cast<u32>(big.contacts.size());
        big.contacts.push_back(link);
    }

    for(usize i = 0u; i < small.joints.size(); ++i){
        const JointLink link = small.joints[i];
        joints[link.jointId].islandId = bigId;
        joints[link.jointId].islandIndex = cast<u32>(big.joints.size());
        big.joints.push_back(link);
    }

    const b8 becomeDirty = (big.constraintRemoveCount == 0u && small.constraintRemoveCount > 0u);
    big.constraintRemoveCount += small.constraintRemoveCount;
    if(becomeDirty && s_AwakeSetIndex < sets.size())
        sets[s_AwakeSetIndex].dirtySplitIslands.push_back(bigId);
    small.bodies.clear();
    small.contacts.clear();
    small.joints.clear();
    DestroyIslandInWorld(islands, freeIslandIds, sets, smallId);
    return bigId;
}

void UnlinkContactFromIsland(mut Vector<Island> islands, mut Vector<SolverSet> sets, mut Vector<Contact> contacts, in u32 contactId){
    mut Contact contact = contacts[contactId];
    const u32 islandId = contact.islandId;
    if(islandId == s_NullIndex || islandId >= islands.size() || !islands[islandId].alive){
        contact.islandId = s_NullIndex;
        contact.islandIndex = s_NullIndex;
        return;
    }

    mut Island island = islands[islandId];
    const u32 idx = contact.islandIndex;
    if(idx < island.contacts.size()){
        const u32 lastIdx = cast<u32>(island.contacts.size() - 1u);
        if(idx != lastIdx){
            const ContactLink movedLink = island.contacts[lastIdx];
            island.contacts[idx] = movedLink;
            contacts[movedLink.contactId].islandIndex = idx;
        }
        island.contacts.pop_back();
    }

    contact.islandId = s_NullIndex;
    contact.islandIndex = s_NullIndex;
    MarkIslandDirtySplit(islands, sets, islandId);
}

void UnlinkJointFromIsland(mut Vector<Island> islands, mut Vector<SolverSet> sets, mut Vector<Joint> joints, in u32 jointId){
    mut Joint joint = joints[jointId];
    const u32 islandId = joint.islandId;
    if(islandId == s_NullIndex || islandId >= islands.size() || !islands[islandId].alive){
        joint.islandId = s_NullIndex;
        joint.islandIndex = s_NullIndex;
        return;
    }

    mut Island island = islands[islandId];
    const u32 idx = joint.islandIndex;
    if(idx < island.joints.size()){
        const u32 lastIdx = cast<u32>(island.joints.size() - 1u);
        if(idx != lastIdx){
            const JointLink movedLink = island.joints[lastIdx];
            island.joints[idx] = movedLink;
            joints[movedLink.jointId].islandIndex = idx;
        }
        island.joints.pop_back();
    }

    joint.islandId = s_NullIndex;
    joint.islandIndex = s_NullIndex;
    MarkIslandDirtySplit(islands, sets, islandId);
}

b8 MergeIslandBodyComponents(in u32 a, in u32 b, mut Vector<u32> parents, mut Vector<u8> ranks){
    const isize ra = FindDisjointRoot(cast<isize>(a), parents);
    const isize rb = FindDisjointRoot(cast<isize>(b), parents);
    if(ra == rb)
        return false;
    const usize ua = cast<usize>(ra);
    const usize ub = cast<usize>(rb);
    const u8 rankA = ranks[ua];
    const u8 rankB = ranks[ub];
    if(rankA < rankB){
        parents[ua] = cast<u32>(ub);
    }
    else if(rankA > rankB){
        parents[ub] = cast<u32>(ua);
    }
    else{
        parents[ub] = cast<u32>(ua);
        ++ranks[ua];
    }
    return true;
}

void SplitIslandInWorld(
    mut Vector<Body> bodies,
    mut Vector<Island> islands,
    mut Vector<u32> freeIslandIds,
    mut Vector<SolverSet> sets,
    mut Vector<Contact> contacts,
    mut Vector<Joint> joints,
    mut IslandSplitScratch scratch,
    in u32 baseIslandId
){
    if(baseIslandId >= islands.size() || !islands[baseIslandId].alive)
        return;
    if(islands[baseIslandId].constraintRemoveCount == 0u || islands[baseIslandId].bodies.size() <= 1u){
        islands[baseIslandId].constraintRemoveCount = 0u;
        return;
    }

    const u32 setIndex = islands[baseIslandId].setIndex;
    const usize bodyCount = islands[baseIslandId].bodies.size();
    const usize contactCount = islands[baseIslandId].contacts.size();
    const usize jointCount = islands[baseIslandId].joints.size();

    if(contactCount == 0u && jointCount == 0u){
        for(usize rev = 1u; rev < bodyCount; ++rev){
            const usize i = bodyCount - rev;
            const u32 bodyId = islands[baseIslandId].bodies[i];
            const u32 newIslandId = CreateIslandInWorld(islands, freeIslandIds, sets, setIndex);
            AddBodyToIsland(bodies, islands, bodyId, newIslandId);
            islands[baseIslandId].bodies.pop_back();
        }
        islands[baseIslandId].constraintRemoveCount = 0u;
        return;
    }

    mut Vector<u32> dsuParents = scratch.dsuParents;
    dsuParents.resize(bodyCount);
    for(usize i = 0u; i < bodyCount; ++i)
        dsuParents[i] = cast<u32>(i);
    mut Vector<u8> dsuRanks = scratch.dsuRanks;
    dsuRanks.clear();
    dsuRanks.resize(bodyCount, 0u);

    usize remainingComponents = bodyCount;
    in Vector<ContactLink> baseContacts = islands[baseIslandId].contacts;
    for(usize i = 0u; i < contactCount; ++i){
        in ContactLink link = baseContacts[i];
        in Body bA = bodies[link.bodyIdA];
        in Body bB = bodies[link.bodyIdB];
        if(bA.islandId == baseIslandId && bB.islandId == baseIslandId){
            if(MergeIslandBodyComponents(bA.islandIndex, bB.islandIndex, dsuParents, dsuRanks)){
                --remainingComponents;
                if(remainingComponents == 1u){
                    islands[baseIslandId].constraintRemoveCount = 0u;
                    return;
                }
            }
        }
    }

    in Vector<JointLink> baseJoints = islands[baseIslandId].joints;
    for(usize i = 0u; i < jointCount; ++i){
        in JointLink link = baseJoints[i];
        in Body bA = bodies[link.bodyIdA];
        in Body bB = bodies[link.bodyIdB];
        if(bA.islandId == baseIslandId && bB.islandId == baseIslandId){
            if(MergeIslandBodyComponents(bA.islandIndex, bB.islandIndex, dsuParents, dsuRanks)){
                --remainingComponents;
                if(remainingComponents == 1u){
                    islands[baseIslandId].constraintRemoveCount = 0u;
                    return;
                }
            }
        }
    }

    mut Vector<u32> rootToIsland = scratch.rootToIsland;
    rootToIsland.clear();
    rootToIsland.resize(bodyCount, 0u);
    mut Vector<u32> bodyAssignedIsland = scratch.bodyAssignedIsland;
    bodyAssignedIsland.clear();
    bodyAssignedIsland.resize(bodyCount, s_NullIndex);

    u32 largestRoot = 0u;
    u32 maxRootSize = 0u;
    for(usize i = 0u; i < bodyCount; ++i){
        const u32 root = cast<u32>(FindDisjointRoot(cast<isize>(i), dsuParents));
        bodyAssignedIsland[i] = root;
        const u32 sz = rootToIsland[root] + 1u;
        rootToIsland[root] = sz;
        if(sz > maxRootSize){
            maxRootSize = sz;
            largestRoot = root;
        }
    }

    rootToIsland.clear();
    rootToIsland.resize(bodyCount, s_NullIndex);
    rootToIsland[largestRoot] = baseIslandId;
    for(usize i = 0u; i < bodyCount; ++i){
        const u32 root = bodyAssignedIsland[i];
        u32 targetIslandId = rootToIsland[root];
        if(targetIslandId == s_NullIndex){
            targetIslandId = CreateIslandInWorld(islands, freeIslandIds, sets, setIndex);
            rootToIsland[root] = targetIslandId;
        }
        bodyAssignedIsland[i] = targetIslandId;
    }

    for(usize rev = 0u; rev < contactCount; ++rev){
        const usize i = contactCount - 1u - rev;
        const ContactLink link = islands[baseIslandId].contacts[i];
        u32 targetIslandId = s_NullIndex;
        in Body bA = bodies[link.bodyIdA];
        if(bA.islandId == baseIslandId){
            targetIslandId = bodyAssignedIsland[bA.islandIndex];
        }
        else{
            in Body bB = bodies[link.bodyIdB];
            if(bB.islandId == baseIslandId)
                targetIslandId = bodyAssignedIsland[bB.islandIndex];
        }
        if(targetIslandId != baseIslandId){
            if(targetIslandId != s_NullIndex){
                contacts[link.contactId].islandId = targetIslandId;
                contacts[link.contactId].islandIndex = cast<u32>(islands[targetIslandId].contacts.size());
                islands[targetIslandId].contacts.push_back(link);
            }
            else{
                contacts[link.contactId].islandId = s_NullIndex;
                contacts[link.contactId].islandIndex = s_NullIndex;
            }
            const usize lastIdx = islands[baseIslandId].contacts.size() - 1u;
            if(i != lastIdx){
                const ContactLink movedLink = islands[baseIslandId].contacts[lastIdx];
                islands[baseIslandId].contacts[i] = movedLink;
                contacts[movedLink.contactId].islandIndex = cast<u32>(i);
            }
            islands[baseIslandId].contacts.pop_back();
        }
    }

    for(usize rev = 0u; rev < jointCount; ++rev){
        const usize i = jointCount - 1u - rev;
        const JointLink link = islands[baseIslandId].joints[i];
        u32 targetIslandId = s_NullIndex;
        in Body bA = bodies[link.bodyIdA];
        if(bA.islandId == baseIslandId){
            targetIslandId = bodyAssignedIsland[bA.islandIndex];
        }
        else{
            in Body bB = bodies[link.bodyIdB];
            if(bB.islandId == baseIslandId)
                targetIslandId = bodyAssignedIsland[bB.islandIndex];
        }
        if(targetIslandId != baseIslandId){
            if(targetIslandId != s_NullIndex){
                joints[link.jointId].islandId = targetIslandId;
                joints[link.jointId].islandIndex = cast<u32>(islands[targetIslandId].joints.size());
                islands[targetIslandId].joints.push_back(link);
            }
            else{
                joints[link.jointId].islandId = s_NullIndex;
                joints[link.jointId].islandIndex = s_NullIndex;
            }
            const usize lastIdx = islands[baseIslandId].joints.size() - 1u;
            if(i != lastIdx){
                const JointLink movedLink = islands[baseIslandId].joints[lastIdx];
                islands[baseIslandId].joints[i] = movedLink;
                joints[movedLink.jointId].islandIndex = cast<u32>(i);
            }
            islands[baseIslandId].joints.pop_back();
        }
    }

    for(usize rev = 0u; rev < bodyCount; ++rev){
        const usize i = bodyCount - 1u - rev;
        const u32 targetIslandId = bodyAssignedIsland[i];
        if(targetIslandId != baseIslandId){
            const u32 bodyId = islands[baseIslandId].bodies[i];
            AddBodyToIsland(bodies, islands, bodyId, targetIslandId);
            const usize lastIdx = islands[baseIslandId].bodies.size() - 1u;
            if(i != lastIdx){
                const u32 movedBodyId = islands[baseIslandId].bodies[lastIdx];
                islands[baseIslandId].bodies[i] = movedBodyId;
                bodies[movedBodyId].islandIndex = cast<u32>(i);
            }
            islands[baseIslandId].bodies.pop_back();
        }
    }

    islands[baseIslandId].constraintRemoveCount = 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

