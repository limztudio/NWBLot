class LinuxForceAssertFalseForCrashObservation{}

void VerifyLoggerServerCrash_LinuxAssertCrashProducesObservableLoggerReport(mut LoggerServerCrash self){
    if(!IsDesktopLinuxLoggerCrashPlatform())
        return;

    HeapStorage testArena = HeapStorage();
    const StringView group = "logger_server_linux_assert_observe_test";
    const StringView stem = "linux_assert_observe_001";
    RemoveTestArtifacts(group);

    const Path spoolDirectory = SpoolDirectory(group);
    const Path pendingDirectory = spoolDirectory / s_PendingDirectoryName;
    const Path archiveInputDirectory = ArchiveInputDirectory(group);
    const Path archivePath = ArchivePath(group, stem);
    const i32 child = ForkTestChild();
    ASSERT_GE(child, 0);
    if(child == 0){
        PersistentStorage installArena(s_AssertChildInstallArena, CrashStorageAlignedSize(64u * 1024u));
        TestValueSlot<PersistentCrashConfig> configSlot;
        mut PersistentCrashConfig config = configSlot.constructIn(installArena);
        config.applicationName = s_ApplicationName;
        config.version = s_ApplicationVersion;
        config.buildId = "linux-assert-observe-test";
        config.spoolDirectory = spoolDirectory;
        if(!InstallCrashHandler(config))
            ExitTestChild(121);
        SilenceTestChildConsole();
        ObserveStackFrame<LinuxForceAssertFalseForCrashObservation>(lambda[]() -> void{
            ObservableTestAssertion(false);
            ExitTestChild(120);
        });
        ExitTestChild(122);
    }

    const ChildWaitResult status = WaitForTestChild(child);
    ASSERT_TRUE(status.collected);
    EXPECT_TRUE(status.signaled);
    EXPECT_EQ(status.signal, s_TestAbortSignal);
    const auto directoryReady = WaitForDirectory(pendingDirectory, 3000u);
    ASSERT_TRUE(directoryReady.has_value());
    EXPECT_TRUE(directoryReady.value());
    const String abortCode = StringFormat("\"reason_code\": {}", s_TestAbortSignal);
    EXPECT_FALSE(PendingDirectoryContainsManifestTexts(pendingDirectory, "\"reason_kind\": \"signal\"", abortCode));
    const auto package = WaitForTriggerPackage(pendingDirectory, s_TestAssertCategory, "false", "", s_TestSourceFilename);
    ASSERT_TRUE(package.has_value());
    HeapStorage archiveOwner;
    ScratchStorage archiveScratch(s_ArchiveScratch);
    const auto archive = BuildObservationArchive(archiveOwner, archiveScratch, package.value());
    ASSERT_TRUE(archive.has_value());
    ASSERT_TRUE(EnsureDirectories(archiveInputDirectory).has_value());
    EXPECT_TRUE(WriteBinaryFile(archivePath, Span<u8>(archive.value())));
    const auto external = LinuxExternalSymbolizerAvailable();
    ASSERT_TRUE(external.has_value());
    const b8 externalSymbolizerAvailable = external.value();

    const CrashIngestResult result = ProcessCrashUpload(testArena, archivePath, MakeIngestConfig(testArena, group));
    EXPECT_TRUE(result.accepted);
    EXPECT_EQ(result.type, LogType::Assert);

    String report = "";
    ASSERT_TRUE(ReadServerSymbolicationText(group, stem, report));
    EXPECT_TRUE(Contains(StringView(report), s_PlatformLinux));
    EXPECT_TRUE(Contains(StringView(report), "reason=manual_dump"));
    EXPECT_TRUE(Contains(StringView(report), s_Event));
    EXPECT_TRUE(Contains(StringView(report), "event=assert"));
    EXPECT_TRUE(Contains(StringView(report), s_StatusCallstackCaptured));
    EXPECT_TRUE(Contains(StringView(report), s_Callstack));
    EXPECT_EQ(report.find("false\nat "), 0u);
    EXPECT_TRUE(Contains(StringView(report), s_TestSourceFilename));
    if(externalSymbolizerAvailable)
        EXPECT_TRUE(Contains(StringView(report), "LinuxForceAssertFalseForCrashObservation"));

    PreserveObservedReport(StringView(report), "linux_assert");
    RemoveTestArtifacts(group);
}

class CaptureRecoverableErrorForCrashObservation{}

void VerifyLoggerServerCrash_RecoverableErrorDiagnosticProducesObservableLoggerReport(mut LoggerServerCrash self){
    if(!IsDesktopLoggerCrashPlatform())
        return;

    HeapStorage testArena = HeapStorage();
    const StringView group = "logger_server_recoverable_error_observe_test";
    const StringView stem = "recoverable_error_observe_001";
    const StringView errorMessage = "recoverable logger error observation";
    RemoveTestArtifacts(group);

    const Path spoolDirectory = SpoolDirectory(group);
    const Path pendingDirectory = spoolDirectory / s_PendingDirectoryName;
    const Path archiveInputDirectory = ArchiveInputDirectory(group);
    const Path archivePath = ArchivePath(group, stem);
    b8 externalSymbolizerAvailable = false;
    PersistentStorage installArena(s_RecoverableErrorInstallArena, CrashStorageAlignedSize(64u * 1024u));
    TestValueSlot<PersistentCrashConfig> configSlot;
    mut PersistentCrashConfig config = configSlot.constructIn(installArena);
    config.applicationName = s_ApplicationName;
    config.version = s_ApplicationVersion;
    config.buildId = "recoverable-error-observe-test";
    config.spoolDirectory = spoolDirectory;
    const b8 installed = InstallCrashHandler(config);
    EXPECT_TRUE(installed);
    b8 continuedAfterError = false;
    if(installed){
        ObserveStackFrame<CaptureRecoverableErrorForCrashObservation>(lambda[in errorMessage]() -> void{
            DiagnosticEventRecord record;
            record.event = s_DiagnosticEventError;
            record.category = s_ObservedErrorCategory;
            record.message = errorMessage;
            record.file = s_TestSourceFilename;
            record.line = s_ObservationSourceLine;
            CaptureDiagnosticEvent(record);
        });
        continuedAfterError = true;
    }
    const auto package = WaitForTriggerPackage(pendingDirectory, s_ObservedErrorCategory, "", errorMessage, s_TestSourceFilename);
    EXPECT_TRUE(package.has_value());
    EXPECT_TRUE(continuedAfterError);
    UninstallCrashHandler();
    ASSERT_TRUE(package.has_value());
    HeapStorage archiveOwner;
    ScratchStorage archiveScratch(s_ArchiveScratch);
    const auto archive = BuildObservationArchive(archiveOwner, archiveScratch, package.value());
    ASSERT_TRUE(archive.has_value());
    ASSERT_TRUE(EnsureDirectories(archiveInputDirectory).has_value());
    EXPECT_TRUE(WriteBinaryFile(archivePath, Span<u8>(archive.value())));
    if(IsDesktopLinuxLoggerCrashPlatform()){
        const auto external = LinuxExternalSymbolizerAvailable();
        ASSERT_TRUE(external.has_value());
        externalSymbolizerAvailable = external.value();
    }

    const CrashIngestResult result = ProcessCrashUpload(testArena, archivePath, MakeIngestConfig(testArena, group));
    EXPECT_TRUE(result.accepted);
    EXPECT_EQ(result.type, LogType::Error);

    String report = "";
    ASSERT_TRUE(ReadServerSymbolicationText(group, stem, report));
    EXPECT_TRUE(Contains(StringView(report), s_Event));
    EXPECT_TRUE(Contains(StringView(report), "event=error"));
    EXPECT_TRUE(Contains(StringView(report), errorMessage));
    EXPECT_TRUE(Contains(StringView(report), s_TestSourceFilename));
    if(IsDesktopLinuxLoggerCrashPlatform()){
        EXPECT_TRUE(Contains(StringView(report), s_PlatformLinux));
        EXPECT_TRUE(Contains(StringView(report), s_StatusCallstackCaptured));
        EXPECT_TRUE(Contains(StringView(report), s_Callstack));
        if(externalSymbolizerAvailable)
            EXPECT_TRUE(Contains(StringView(report), "CaptureRecoverableErrorForCrashObservation"));
    }
    else if(IsWindowsLoggerCrashPlatform()){
        EXPECT_TRUE(Contains(StringView(report), "platform=windows"));
        EXPECT_TRUE(Contains(StringView(report), "resolver=windows_pdb_minidump"));
    }

    PreserveObservedReport(StringView(report), "recoverable_error");
    RemoveTestArtifacts(group);
}

void VerifyLoggerServerCrash_LinuxCrashPackageReportsMissingProcMaps(mut LoggerServerCrash self){
    HeapStorage testArena = HeapStorage();
    const StringView group = "logger_server_linux_missing_maps_test";
    const StringView stem = "linux_missing_maps_001";
    RemoveTestArtifacts(group);

    String archive = "";
    BeginArchiveWithManifest("linux-missing-maps-test", s_Linux, s_Crash, s_Signal, 11u, ManifestEventField::Include, ManifestTriggerFields(), archive);
    AppendArchiveFile(s_CpuContextFileName, "instruction_pointer=4198964\n", archive);

    const CrashIngestResult result = ProcessCrashArchive(testArena, group, stem, StringView(archive));
    EXPECT_TRUE(result.accepted);

    String report = "";
    ASSERT_TRUE(ReadServerSymbolicationText(group, stem, report));
    EXPECT_TRUE(Contains(StringView(report), s_PlatformLinux));
    EXPECT_TRUE(Contains(StringView(report), "proc_maps=missing"));
    EXPECT_TRUE(Contains(StringView(report), "proc maps missing for module lookup"));

    RemoveTestArtifacts(group);
}

void VerifyLoggerServerCrash_LinuxCrashPackageReportsUnmappedInstructionPointer(mut LoggerServerCrash self){
    HeapStorage testArena = HeapStorage();
