struct MetaRuntimeSourceArenaTag{};
struct MetaRuntimeDestinationArenaTag{};
struct MetaRuntimeReaderArenaTag{};

using SourceArena = Tests::TestArena<MetaRuntimeSourceArenaTag>;
using DestinationArena = Tests::TestArena<MetaRuntimeDestinationArenaTag>;
using ReaderArena = Tests::TestArena<MetaRuntimeReaderArenaTag>;
using Document = Core::Metascript::Document;
using Value = Core::Metascript::Value;
using ScopedTestTrace = Tests::ScopedTestTrace;
[[nodiscard]] NWB_INLINE b8 TryDecodeCharLiteral(const MStringView text, i64& outValue)noexcept{
    return Core::Metascript::LiteralDecoder::TryDecodeCharLiteral(text, outValue);
}

inline constexpr AStringView s_MetaRuntimeAssetVariable = "asset";
inline constexpr AStringView s_MetaRuntimeNameField = "name";
inline constexpr AStringView s_MetaRuntimeItemsField = Tests::s_MetascriptValueItemsField;
inline constexpr usize s_MetaRuntimeInitialCount = Tests::s_MetascriptValueInitialCount;

struct InvalidTargetCase{
    MStringView source;
    MStringView message;
    i64 retainedValue = 0;
};

inline constexpr Array<InvalidTargetCase, 2u> s_InvalidAssignmentTargetCases = {
    InvalidTargetCase{ "float asset = 7;\nmissing.value = 2;", "assignments must target a declared variable", 7 },
    InvalidTargetCase{ "float asset = 9;\nasset.value = 2;", "cannot access field on non-map value", 9 },
};

class UnexpectedReadFailure final : public GeneralException{
public:
    [[nodiscard]] virtual const char* what()const noexcept override{ return "unexpected reader failure"; }
};

class ThrowingReader final : public Core::Metascript::IMetaReader{
public:
    [[nodiscard]] virtual Expected<usize> read(Core::Metascript::MChar*, usize)override{ throw UnexpectedReadFailure{}; }
};

class EndOfFileReader final : public Core::Metascript::IMetaReader{
public:
    [[nodiscard]] virtual Expected<usize> read(Core::Metascript::MChar*, usize)noexcept override{ return 0u; }
};

class RejectedReader final : public Core::Metascript::IMetaReader{
public:
    explicit RejectedReader(const b8 oversized)noexcept
        : m_oversized(oversized)
    {}


public:
    [[nodiscard]] virtual Expected<usize> read(Core::Metascript::MChar*, const usize maxBytes)noexcept override{
        if(m_oversized)
            return maxBytes + 1u;
        return MakeUnexpected(Failure{});
    }


private:
    b8 m_oversized;
};

struct LerpMoveOnlyOperand{
    i32 value = 10;
    LerpMoveOnlyOperand() = default;
    explicit LerpMoveOnlyOperand(const i32 v) : value(v){}
    LerpMoveOnlyOperand(const LerpMoveOnlyOperand&) = delete;
    LerpMoveOnlyOperand(LerpMoveOnlyOperand&&) = default;
    LerpMoveOnlyOperand operator-(const LerpMoveOnlyOperand& rhs)&&{ return LerpMoveOnlyOperand(value - rhs.value); }
    LerpMoveOnlyOperand operator*(LerpMoveOnlyOperand&& rhs)&&{ return LerpMoveOnlyOperand(value * rhs.value); }
    LerpMoveOnlyOperand operator+(LerpMoveOnlyOperand&& rhs)&{ return LerpMoveOnlyOperand(value + rhs.value); }
    LerpMoveOnlyOperand operator+(LerpMoveOnlyOperand&& rhs)&&{ return LerpMoveOnlyOperand(value + rhs.value + 100); }
};

[[nodiscard]] NWB_INLINE b8 HasVariable(const Document& doc, const MStringView name)noexcept{
    return doc.findVariable(name) != nullptr;
}

[[nodiscard]] NWB_INLINE const Value& RequireVariable(const Document& doc, const MStringView name)noexcept{
    return *doc.findVariable(name);
}

[[nodiscard]] NWB_INLINE b8 HasDeclaration(const Document& doc, const MStringView name)noexcept{
    return doc.findDeclaration(name) != nullptr;
}

[[nodiscard]] NWB_INLINE MStringView DeclarationType(const Document& doc, const MStringView name)noexcept{
    return doc.findDeclaration(name)->type;
}

[[nodiscard]] NWB_INLINE MStringView DeclarationVariable(const Document& doc, const MStringView name)noexcept{
    return doc.findDeclaration(name)->variable;
}

[[nodiscard]] NWB_INLINE b8 HasStruct(const Document& doc, const MStringView name)noexcept{
    return doc.structs().find(name) != doc.structs().end();
}

[[nodiscard]] NWB_INLINE const Value& StructMetadata(const Document& doc, const MStringView name)noexcept{
    return doc.structs().find(name).value();
}

[[nodiscard]] NWB_INLINE b8 HasValueField(const Value& value, const MStringView name)noexcept{
    return value.findField(name) != nullptr;
}

[[nodiscard]] NWB_INLINE const Value& RequireValueField(const Value& value, const MStringView name)noexcept{
    return *value.findField(name);
}

[[nodiscard]] NWB_INLINE MStringView DocumentErrorMessage(const Document& doc, const usize index)noexcept{
    return MStringView(doc.errors()[index].message);
}

[[nodiscard]] NWB_INLINE Tests::TestAString MakeRepeatedCharString(const usize count, const char ch){
    return Tests::TestAString(count, ch);
}

[[nodiscard]] NWB_INLINE Tests::TestAString BuildStructGrowthDocumentSource(){
    Tests::TestAString source("struct Description{ float value; }; Description runtime;\n");
    for(usize index = 0u; index < 128u; ++index){
        Array<char, s_DecimalTextBufferBytes> indexText = {};
        const AStringView indexView = FormatDecimal(index, indexText);
        source.append("float extra");
        source.append(indexView.data(), indexView.size());
        source.append(";\n");
    }
    return source;
}

