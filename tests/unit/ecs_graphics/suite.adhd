    }
}

class FrameCacheRuntimeProvider : IRuntimeMeshProvider{
    public EntityID receiver = s_InvalidEntityId;
    public b8 attached = false;
    public Expected<RuntimeMeshDesc> resolveRuntimeMesh(in EntityID entity)override{ return MakeUnexpected(Failure()); }
    public b8 hasRuntimeMeshBinding(in EntityID entity)const override{ return this.attached && entity == this.receiver; }
    public void markLiveRuntimeMeshes(mut RuntimeMeshRequestSet requests)override{}
}

[ordered]
class CsgShadowSnapshotContext{
    public EcsTestWorld testWorld;
    public ScratchStorage scratch = ScratchStorage(s_EcsCaseTestsCsgShadowScratch);
    public TestValueSlot<CsgShapeRegistry> registryStorage;
    public TestValueSlot<CsgShadowSnapshot> snapshotStorage;
    public mut CsgShapeRegistry registry;
    public mut CsgShadowSnapshot snapshot;
    public CsgShadowSnapshotContext(){
        this.testWorld = EcsTestWorld();
        this.registry = this.registryStorage.constructIn(this.testWorld.arena);
        this.snapshot = this.snapshotStorage.constructIn(this.testWorld.arena);
    }
    public b8 build(in Span<CsgShadowReceiverInput> receivers){ return BuildCsgShadowSnapshot(this.registry, receivers, this.testWorld.world, this.snapshot); }
    public b8 buildEmpty(){ return this.build(Span<CsgShadowReceiverInput>()); }
    public EntityID addReceiver(in Name group, in b8 skinned){
        auto entity = this.testWorld.world.createEntity();
        if(skinned)
            entity.addComponent<SkinnedCsgMeshComponent>().receiverGroup = group;
        else
            entity.addComponent<StaticCsgMeshComponent>().receiverGroup = group;
        return entity.id();
    }
    public EntityID addReceiver(in Name group){ return this.addReceiver(group, false); }
    public EntityID addReceiver(){ return this.addReceiver(s_CsgShadowReceiverGroup, false); }
    public EntityID addCutter(in Name shape, in Name group){
        auto entity = this.testWorld.world.createEntity();
        mut CsgCutterComponent cutter = entity.addComponent<CsgCutterComponent>();
        cutter.receiverGroup = group;
        cutter.shapeType = shape;
        return entity.id();
    }
    public EntityID addCutter(in Name shape){ return this.addCutter(shape, s_CsgShadowReceiverGroup); }
    public void setCutterTranslation(in EntityID id, in f32 x, in f32 y, in f32 z){
        mut CsgCutterComponent cutter = this.testWorld.world.entity(id).getComponent<CsgCutterComponent>();
        cutter.shapeToWorld = f32x4x4(MatrixTranslation(x, y, z));
        cutter.worldToShape = f32x4x4(MatrixTranslation(-x, -y, -z));
    }
    public void setCutterParameters(in EntityID id, in VectorSingle parameter){
        SetCsgCutterParameters(parameter, this.testWorld.world.entity(id).getComponent<CsgCutterComponent>());
    }
}


