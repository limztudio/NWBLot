[arena]
class ThrowingFontConstructionLogger : Utf8LogSink{
    public b8 sawFaceFailure = false;

    [cpp_unwind]
    public void receive(in StringView text, in LogType kind)override{
        if(text.find("UI font face initialization failed") == usize.max)
            return;
        this.sawFaceFailure = true;
        ThrowTestException<i32>(61);
    }
}

class GeometryShaper : ITextShaper{
    public Point m_offset;
    public Point m_secondOffset;
    public Point m_advance = Point(10.0f, 0.0f);
    public Rect m_ink = Rect(-2.0f, -8.0f, 9.0f, 10.0f);
    public GlyphCoverageBounds m_coverage;

    [cpp_unwind]
    public Expected<ShapedRun, TextLayoutStatus> shape(in ShapeRequest request)override{
        ShapedRun run;
        run.metrics.ascender = 8.0f;
        run.metrics.descender = 2.0f;
        run.metrics.lineGap = 2.0f;
        for(usize index = 0u; index < request.text.size(); ++index){
            Point offset = this.m_secondOffset;
            if(index == 0u)
                offset = this.m_offset;
            run.glyphs.push_back(ShapedGlyph(SharedFontFace(), 1u, cast<u32>(index), cast<u32>(index + 1u), offset, this.m_advance, this.m_ink, this.m_coverage));
        }
        return run;
    }
}

class TextFontTests{
    public Font m_latin = Font(Name(s_TestLatinFontPath));
    public Font m_korean = Font(Name(s_TestKoreanFontPath));
    public TextService m_service;
    public TextLayout m_layout;
    public UiSkin m_skin = UiSkin(Name(s_TestSkinPath));
    public PaintBuilder m_paint;

    public void setup(){
        ASSERT_TRUE(LoadBundledFixtureFont("latin.font", this.m_latin));
        ASSERT_TRUE(LoadBundledFixtureFont("korean.font", this.m_korean));
        const Array<FontSource, 2u> sources(FontSource(AssetRef<Font>(s_TestLatinFontPath), this.m_latin, 1u), FontSource(AssetRef<Font>(s_TestKoreanFontPath), this.m_korean, 1u));
        ASSERT_TRUE(this.m_service.setFonts(sources));
        this.m_skin.setAtlas(AssetRef<Texture>("tests/ui/texture"), 4u, 4u, 1.0f, RegionVector());
    }
    public void beginPaint(in u64 generation){ this.beginPaint(generation, 1.0f); }
    public void beginPaint(in u64 generation, in f32 scale){
        this.m_paint.begin(DisplayMetrics(800.0f, 600.0f, scale, scale), generation, 1u, AssetRef<UiSkin>(s_TestSkinPath), this.m_skin);
    }
    public b8 applyLayout(in ShapeRequest request){
        auto result = this.m_service.layout(request);
        if(!result.has_value())
            return false;
        TestMoveAssign<TextLayout>(this.m_layout, result.value());
        return true;
    }
    public b8 setLatinFontGeneration(in u64 generation){
        const Array<FontSource, 1u> sources(FontSource(AssetRef<Font>(s_TestLatinFontPath), this.m_latin, generation));
        return this.m_service.setFonts(sources);
    }
    public void clearLatinFontBytes(){ this.m_latin.setFontBytes(Vector<u8>(), 0u); }
    public b8 setEmptyFonts(){ return this.m_service.setFonts(Span<FontSource>()); }
    public Expected<SharedFontFace> makeLatinFace(){ return this.makeLatinFace(1u); }
    public Expected<SharedFontFace> makeLatinFace(in u64 generation){ return MakeFontFace(this.pool, FontSource(AssetRef<Font>(s_TestLatinFontPath), this.m_latin, generation)); }
    public SharedPool pool = SharedPool();}

class TextGlyphVisibilityFontTests{
    public Font m_latin = Font(Name(s_TestLatinFontPath));
    public Font m_korean = Font(Name(s_TestKoreanFontPath));
    public SharedFontFace m_face;
    public SharedFontFace m_koreanFace;

    public void setup(){
        ASSERT_TRUE(this.loadFont("latin.font", this.m_latin));
        ASSERT_TRUE(this.loadFont("korean.font", this.m_korean));
        const auto face = MakeFontFace(this.pool, FontSource(AssetRef<Font>(s_TestLatinFontPath), this.m_latin, 1u));
        const auto korean = MakeFontFace(this.pool, FontSource(AssetRef<Font>(s_TestKoreanFontPath), this.m_korean, 1u));
        ASSERT_TRUE(face.has_value());
        ASSERT_TRUE(korean.has_value());
        this.m_face = face.value();
        this.m_koreanFace = korean.value();
        ASSERT_TRUE(this.m_face.deref().coverageInkReliable());
        ASSERT_FALSE(this.m_koreanFace.deref().coverageInkReliable());
    }
    public b8 loadFont(in StringView filename, mut Font font){ return LoadBundledFixtureFont(filename, font); }
    public SharedPool pool = SharedPool();}

class TextGlyphVisibilityAtlasTests{
    public FontAtlas m_asset = FontAtlas(Name(s_UiCaseTestsUiGlyphVisibilityAtlas));
    public SharedBakedFontAtlas m_atlas;

    public void setup(){
        FontAtlasPayload payload;
        payload.font = AssetRef<Font>("tests/ui/glyph_visibility/font");
        const Array<u8, 1u> source(1u);
        payload.fontSha256 = ComputeSha256(source);
        payload.unitsPerEm = 1000u;
        payload.sourceGlyphCount = 2u;
        payload.bakePpem = 32u;
        payload.ascenderUnits = 800.0f;
        payload.descenderUnits = -200.0f;
        payload.glyphs.resize(2u);
        mut FontAtlasGlyph testGlyph = payload.glyphs[0u];
        testGlyph.glyphId = 0u;
        testGlyph.x = 1u;
        testGlyph.y = 1u;
        testGlyph.width = 2u;
        testGlyph.height = 4u;
        testGlyph.planeLeft = -125.0f;
        testGlyph.planeTop = -500.0f;
        testGlyph.planeRight = -62.5f;
        testGlyph.planeBottom = -375.0f;
        testGlyph.drawable = 1u;
        payload.glyphs[1u].glyphId = 1u;
        AppendArenaElement<FontAtlasGroup>(payload.groups);
        mut FontAtlasGroup group = payload.groups.back();
        group.width = 8u;
        group.height = 8u;
        group.pixels.resize(8u * 8u * 4u, 128u);
        group.sha256 = ComputeSha256(group.pixels);
        this.m_asset.setPayload(payload);
        ASSERT_TRUE(this.m_asset.validatePayload());
        auto atlasResult = CreateBakedFontAtlas(this.pool, this.m_asset, 1u);
        ASSERT_TRUE(atlasResult.has_value());
        this.m_atlas = atlasResult.value();
        ASSERT_TRUE(this.m_atlas.valid());
    }
    public SharedPool pool = SharedPool();}

