void VerifyUiSearchComboBehaviorTests_FilterMayNotChangeFullGenerationRevisionOrCount(mut UiSearchComboBehaviorTests self){
    for(u32 change = 0u; change < 3u; ++change){
        SearchComboState state = SearchComboState(self.m_arena);
        UiSearchComboBehaviorSource source = UiSearchComboBehaviorSource(self.m_arena, state);
        state.combo().select(5u);
        const u64 previewGeneration = state.combo().listState().inputGeneration();
        source.changeFullGeneration = change == 0u;
        source.changeFullRevision = change == 1u;
        source.changeFullCount = change == 2u;
        EXPECT_FALSE(UiSearchComboFilterState(state, source));
        EXPECT_EQ(state.combo().selectedKey(), 5u);
        EXPECT_EQ(state.combo().listState().inputGeneration(), previewGeneration);
    }
}

