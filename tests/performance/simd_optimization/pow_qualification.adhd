namespace SimdOptimizationBenchmark{
namespace PowKernels{

using UInt4 = u32 __attribute__((ext_vector_type(4)));
using Int4 = i32 __attribute__((ext_vector_type(4)));
using UInt64x4 = u64 __attribute__((ext_vector_type(4)));
using Int64x4 = i64 __attribute__((ext_vector_type(4)));
using Evaluate = SIMDVectorSingle(*)(SIMDVectorSingle, SIMDVectorSingle)noexcept;

FOUNDATION_NOINLINE inline SIMDVectorSingle Reference(const SIMDVectorSingle x, const SIMDVectorSingle y)noexcept{
    return VectorSet(Pow(VectorGetX(x), VectorGetX(y)), Pow(VectorGetY(x), VectorGetY(y)), Pow(VectorGetZ(x), VectorGetZ(y)), Pow(VectorGetW(x), VectorGetW(y)));
}

FOUNDATION_NOINLINE inline SIMDVectorSingle Production(const SIMDVectorSingle x, const SIMDVectorSingle y)noexcept{
    return VectorPow(x, y);
}

FOUNDATION_NOINLINE inline SIMDVectorSingle PackedSingle(const SIMDVectorSingle x, const SIMDVectorSingle y)noexcept{
    return VectorExp2(VectorMultiply(VectorLog2(x), y));
}

FOUNDATION_NOINLINE inline SIMDVectorSingle PackedDouble(const SIMDVectorSingle x, const SIMDVectorSingle y)noexcept{
#pragma STDC FENV_ACCESS ON
    const UInt4 xBits = BitCast<UInt4>(x), yBits = BitCast<UInt4>(y);
    const UInt4 magnitude = xBits & 0x7fffffffu, yMagnitude = yBits & 0x7fffffffu;
    const auto ordinary = (magnitude != 0u) & (magnitude < 0x7f800000u) & (yMagnitude < 0x7f800000u);
    const UInt4 admittedX = ordinary ? magnitude : UInt4{ 0x3f800000u, 0x3f800000u, 0x3f800000u, 0x3f800000u };
    const SIMDVectorSingle safeX = BitCast<SIMDVectorSingle>(admittedX);
    const auto subnormal = admittedX < 0x00800000u;
    const SIMDVectorSingle normalized = VectorSelect(safeX, VectorScale(VectorSelect(s_SIMDOne, safeX, BitCast<SIMDVectorSingle>(subnormal)), 0x1p24f), BitCast<SIMDVectorSingle>(subnormal));
    const UInt4 normalizedBits = BitCast<UInt4>(normalized);
    const Int4 exponent = __builtin_convertvector(normalizedBits >> 23u, Int4) - 127 - (subnormal ? 24 : 0);
    const SIMDVectorSingle mantissa = BitCast<SIMDVectorSingle>((normalizedBits & 0x007fffffu) | 0x3f800000u);
    SIMDVectorDouble m = ConvertVectorSingleToDouble(mantissa);
    SIMDVectorDouble e = __builtin_convertvector(exponent, SIMDVectorDouble);
    const SIMDVectorDouble upper = VectorDoubleGreater(m, VectorDoubleReplicate(0x1.6a09e667f3bcdp0));
    m = VectorDoubleSelect(m, VectorDoubleScale(m, 0.5), upper);
    e = VectorDoubleAdd(e, VectorDoubleSelect(VectorDoubleZero(), s_DoubleSIMDOne, upper));
    const SIMDVectorDouble z = VectorDoubleDivide(VectorDoubleSubtract(m, s_DoubleSIMDOne), VectorDoubleAdd(m, s_DoubleSIMDOne));
    const SIMDVectorDouble zSquared = VectorDoubleMultiply(z, z);
    constexpr Array<f64, 16> s_LogCoefficients = {
        1.0, 1.0 / 3.0, 1.0 / 5.0, 1.0 / 7.0, 1.0 / 9.0, 1.0 / 11.0, 1.0 / 13.0, 1.0 / 15.0,
        1.0 / 17.0, 1.0 / 19.0, 1.0 / 21.0, 1.0 / 23.0, 1.0 / 25.0, 1.0 / 27.0, 1.0 / 29.0, 1.0 / 31.0,
    };
    SIMDVectorDouble logarithm = VectorDoubleReplicate(s_LogCoefficients[15]);
    for(i32 degree = 14; degree >= 0; --degree)
        logarithm = VectorDoubleMultiplyAdd(logarithm, zSquared, VectorDoubleReplicate(s_LogCoefficients[degree]));
    logarithm = VectorDoubleMultiply(VectorDoubleScale(z, 2.0), logarithm);
    const SIMDVectorDouble log2 = VectorDoubleAdd(e, VectorDoubleScale(logarithm, 0x1.71547652b82fep0));
    const SIMDVectorDouble safeY = ConvertVectorSingleToDouble(BitCast<SIMDVectorSingle>(ordinary ? yBits : UInt4{}));
    const SIMDVectorDouble power = VectorDoubleMultiply(log2, safeY);
    const SIMDVectorDouble bounded = VectorDoubleMin(VectorDoubleReplicate(129.0), VectorDoubleMax(VectorDoubleReplicate(-151.0), power));
    const SIMDVectorDouble integral = VectorDoubleFloor(bounded);
    const SIMDVectorDouble remainder = VectorDoubleScale(VectorDoubleSubtract(bounded, integral), 0x1.62e42fefa39efp-1);
    // The series use binary64 lanes so the final binary32 rounding has guard bits.
    constexpr Array<f64, 21> s_InverseFactorials = {
        1.0,
        1.0,
        0.5,
        1.0 / 6.0,
        1.0 / 24.0,
        1.0 / 120.0,
        1.0 / 720.0,
        1.0 / 5040.0,
        1.0 / 40320.0,
        1.0 / 362880.0,
        1.0 / 3628800.0,
        1.0 / 39916800.0,
        1.0 / 479001600.0,
        1.0 / 6227020800.0,
        1.0 / 87178291200.0,
        1.0 / 1307674368000.0,
        1.0 / 20922789888000.0,
        1.0 / 355687428096000.0,
        1.0 / 6402373705728000.0,
        1.0 / 121645100408832000.0,
        1.0 / 2432902008176640000.0,
    };
    SIMDVectorDouble exponential = VectorDoubleReplicate(s_InverseFactorials[20]);
    for(i32 degree = 19; degree >= 0; --degree)
        exponential = VectorDoubleMultiplyAdd(exponential, remainder, VectorDoubleReplicate(s_InverseFactorials[degree]));
    const Int64x4 integralBits = __builtin_convertvector(integral, Int64x4);
    const SIMDVectorDouble scale = BitCast<SIMDVectorDouble>(__builtin_convertvector(integralBits + 1023, UInt64x4) << 52u);
    UInt4 result = BitCast<UInt4>(ConvertVectorDoubleToSingle(VectorDoubleMultiply(exponential, scale)));
    const UInt4 yExponent = yMagnitude >> 23u;
    const UInt4 shifts = yExponent < 127u ? 23u : (yExponent > 150u ? 0u : 150u - yExponent);
    const UInt4 significand = (yMagnitude & 0x007fffffu) | 0x00800000u;
    const auto integerY = (yMagnitude == 0u) | (yExponent >= 151u) | ((yExponent >= 127u) & ((significand & ((UInt4{ 1u, 1u, 1u, 1u } << shifts) - 1u)) == 0u));
    const auto oddY = integerY & (yExponent <= 150u) & (((significand >> shifts) & 1u) != 0u);
    const UInt4 sign = oddY ? (xBits & 0x80000000u) : UInt4{};
    result |= sign;
    const auto yNegative = (yBits & 0x80000000u) != 0u;
    result = magnitude == 0u ? (yNegative ? 0x7f800000u : 0u) | sign : result;
    result = magnitude == 0x7f800000u ? (yNegative ? 0u : 0x7f800000u) | sign : result;
    const auto domain = ((xBits & 0x80000000u) != 0u) & (magnitude != 0u) & (magnitude < 0x7f800000u) & !integerY;
    result = domain ? 0x7fc00000u : result;
    const UInt4 infiniteY = yNegative ? (magnitude < 0x3f800000u ? 0x7f800000u : 0u) : (magnitude < 0x3f800000u ? 0u : 0x7f800000u);
    result = yMagnitude == 0x7f800000u ? (magnitude == 0x3f800000u ? 0x3f800000u : infiniteY) : result;
    const auto nanX = magnitude > 0x7f800000u, nanY = yMagnitude > 0x7f800000u;
    const SIMDVectorSingle quiet = VectorAdd(BitCast<SIMDVectorSingle>(nanX ? xBits : UInt4{}), BitCast<SIMDVectorSingle>(nanY ? yBits : UInt4{}));
    result = (nanX | nanY) ? BitCast<UInt4>(quiet) : result;
    result = ((xBits == 0x3f800000u) | (yMagnitude == 0u)) ? 0x3f800000u : result;
    // errno also needs the libm side effects, beyond the packed result bits.
    if(__builtin_reduce_or(domain) != 0)
        errno = EDOM;
    else if(__builtin_reduce_or((magnitude == 0u) & yNegative & !nanY) != 0 || (TestFloatingPointExceptions(FE_OVERFLOW | FE_UNDERFLOW) != 0))
        errno = ERANGE;
    return BitCast<SIMDVectorSingle>(result);
}

[[nodiscard]] FOUNDATION_INLINE NotNull<Evaluate> SelectEvaluator(const u8 variantCode, const b8 useReference)noexcept{
    if(useReference)
        return MakeNotNull<Evaluate>(Reference);
    if(variantCode == 0u)
        return MakeNotNull<Evaluate>(Production);
    if(variantCode == 1u)
        return MakeNotNull<Evaluate>(PackedSingle);
    return MakeNotNull<Evaluate>(PackedDouble);
}

#if defined(FOUNDATION_PLATFORM_WINDOWS)
[[nodiscard]] FOUNDATION_INLINE u32 ObserveTrap(const NotNull<Evaluate> evaluate, const SIMDVectorSingle x, const SIMDVectorSingle y){
    u32 initial{}, control{}, exception{};
    if(_controlfp_s(&initial, 0u, 0u) != 0)
        return 1u;
    const u32 previousFlags = _clearfp();
    if(_controlfp_s(&control, initial & ~(_EM_INVALID | _EM_OVERFLOW | _EM_ZERODIVIDE), _MCW_EM) != 0)
        return 2u;
    __try{
        const SIMDVectorSingle value = evaluate.get()(x, y);
        volatile u32 sink = VectorGetIntX(value);
        if(sink == previousFlags)
            exception = 0u;
    }
    __except(EXCEPTION_EXECUTE_HANDLER){
        exception = _exception_code();
    }
    const u32 raisedFlags = _clearfp();
    if(_controlfp_s(&control, initial, _MCW_EM) != 0)
        return 3u;
    FOUNDATION_COUT << "trap exception=0x" << StreamHex << exception << " flags=0x" << raisedFlags << " mask=0x" << (control & _MCW_EM) << StreamDec << '\n';
    return exception;
}

struct TrapEdgeObservation{
    u32 code = 0u;
    u32 flags = 0u;
    u32 control = 0u;
    u32 valueBits = 0u;
    i32 error = 0;
    u64 nativeStatus = 0u;
    u64 nativeControl = 0u;

    friend b8 operator==(const TrapEdgeObservation&, const TrapEdgeObservation&)noexcept = default;
};

[[nodiscard]] FOUNDATION_INLINE Expected<TrapEdgeObservation> ObserveTrapEdge(const NotNull<Evaluate> evaluate, const SIMDVectorSingle x, const SIMDVectorSingle y, const u32 enabled)noexcept{
    u32 initial{}, control{}, exception{}, valueBits{};
    if(_controlfp_s(&initial, 0u, 0u) != 0)
        return MakeUnexpected(Failure{});
    if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT))
        return MakeUnexpected(Failure{});
#if defined(FOUNDATION_HAS_NEON64) && !defined(_M_ARM64EC)
    u64 initialNativeControl{};
    __asm__ __volatile__("mrs %0, fpcr" : "=r"(initialNativeControl));
    const u64 clearNativeStatus = 0u;
    __asm__ __volatile__("msr fpsr, %0" : : "r"(clearNativeStatus));
#endif
    if(_controlfp_s(&control, (initial | _MCW_EM) & ~enabled, _MCW_EM) != 0)
        return MakeUnexpected(Failure{});
    errno = E2BIG;
    __try{
        const SIMDVectorSingle value = evaluate.get()(x, y);
        volatile u32 sink = VectorGetIntX(value);
        valueBits = sink;
    }
    __except(EXCEPTION_EXECUTE_HANDLER){
        exception = _exception_code();
    }
    const i32 observedError = errno;
    u64 nativeStatus{}, nativeControl{};
#if defined(FOUNDATION_HAS_NEON64) && !defined(_M_ARM64EC)
    __asm__ __volatile__("mrs %0, fpsr" : "=r"(nativeStatus));
    __asm__ __volatile__("mrs %0, fpcr" : "=r"(nativeControl));
#endif
    u32 observedControl{};
    if(_controlfp_s(&observedControl, 0u, 0u) != 0)
        return MakeUnexpected(Failure{});
    const u32 flags = _clearfp();
    if(_controlfp_s(&control, initial, _MCW_EM) != 0)
        return MakeUnexpected(Failure{});
#if defined(FOUNDATION_HAS_NEON64) && !defined(_M_ARM64EC)
    __asm__ __volatile__("msr fpcr, %0" : : "r"(initialNativeControl));
#endif
    return TrapEdgeObservation{ exception, flags, observedControl, valueBits, observedError, nativeStatus, nativeControl };
}
#endif

[[nodiscard]] FOUNDATION_INLINE i32 VerifyTrapsImpl([[maybe_unused]] const NotNull<Evaluate> evaluate){
#if defined(FOUNDATION_PLATFORM_WINDOWS)
    alignas(SIMDVectorSingle) const Array<SIMDVectorSingle, 5> x = {
        VectorSet(-1.0f, 1.0f, 1.0f, 1.0f),
        VectorSet(0x1.fffffep127f, 1.0f, 1.0f, 1.0f),
        VectorSet(0.0f, 1.0f, 1.0f, 1.0f),
        VectorSet(0x1.fffffep127f, -1.0f, 1.0f, 1.0f),
        VectorSet(-1.0f, 0x1.fffffep127f, 1.0f, 1.0f),
    };
    alignas(SIMDVectorSingle) const Array<SIMDVectorSingle, 5> y = {
        VectorSet(0.5f, 1.0f, 1.0f, 1.0f),
        VectorSet(2.0f, 1.0f, 1.0f, 1.0f),
        VectorSet(-1.0f, 1.0f, 1.0f, 1.0f),
        VectorSet(2.0f, 0.5f, 1.0f, 1.0f),
        VectorSet(0.5f, 2.0f, 1.0f, 1.0f),
    };
    u32 failures = 0u;
    constexpr Array<u32, 3> s_ReferenceCategories = { EXCEPTION_FLT_INVALID_OPERATION, EXCEPTION_FLT_OVERFLOW, EXCEPTION_FLT_DIVIDE_BY_ZERO };
    b8 delivered = true;
    for(usize index = 0u; index < x.size(); ++index){
        FOUNDATION_COUT << "trap case=" << index << " reference\n";
        const u32 expected = ObserveTrap(MakeNotNull<Evaluate>(Reference), x[index], y[index]);
        FOUNDATION_COUT << "trap case=" << index << " candidate\n";
        const u32 actual = ObserveTrap(evaluate, x[index], y[index]);
        delivered = delivered && (index < s_ReferenceCategories.size() ? expected == s_ReferenceCategories[index] : (expected == EXCEPTION_FLT_INVALID_OPERATION || expected == EXCEPTION_FLT_OVERFLOW));
        failures += expected != actual;
    }
    FOUNDATION_COUT << "trap differences=" << failures << " distinguishable=" << delivered << '\n';
    return delivered ? (failures == 0u ? 0 : 1) : 2;
#else
    FOUNDATION_COUT << "trap qualification unavailable on this platform\n";
    return 2;
#endif
}

[[nodiscard]] FOUNDATION_INLINE i32 VerifyTrapEdgesImpl([[maybe_unused]] const NotNull<Evaluate> evaluate){
#if defined(FOUNDATION_PLATFORM_WINDOWS)
    const i32 savedError = errno;
#if defined(FOUNDATION_HAS_NEON64) && !defined(_M_ARM64EC)
    u64 savedNativeStatus{}, savedNativeControl{};
    __asm__ __volatile__("mrs %0, fpsr" : "=r"(savedNativeStatus));
    __asm__ __volatile__("mrs %0, fpcr" : "=r"(savedNativeControl));
#endif
    const auto environment = HoldFloatingPointExceptions();
    if(!environment)
        return 2;
    ScopeExit restore([&]()noexcept{
        if(!SetFloatingPointEnvironment(*environment))
            __builtin_trap();
#if defined(FOUNDATION_HAS_NEON64) && !defined(_M_ARM64EC)
        __asm__ __volatile__("msr fpsr, %0" : : "r"(savedNativeStatus));
        __asm__ __volatile__("msr fpcr, %0" : : "r"(savedNativeControl));
#endif
        errno = savedError;
    });
    constexpr Array<i32, 4> s_Modes = { FE_TONEAREST, FE_DOWNWARD, FE_UPWARD, FE_TOWARDZERO };
#if defined(FOUNDATION_HAS_NEON64) && !defined(_M_ARM64EC)
    constexpr Array<u32, 2> s_DenormalModes = { _DN_SAVE, _DN_FLUSH };
#else
    constexpr Array<u32, 1> s_DenormalModes = { _DN_SAVE };
#endif
    alignas(SIMDVectorSingle) const Array<SIMDVectorSingle, 3> x = {
        VectorSet(0.5f, 1.0f, 1.0f, 1.0f),
        VectorSet(0.5f, 1.0f, 1.0f, 1.0f),
        VectorSetInt(1u, 0x3f800000u, 0x3f800000u, 0x3f800000u),
    };
    alignas(SIMDVectorSingle) const Array<SIMDVectorSingle, 3> y = {
        VectorSet(149.0f, 1.0f, 1.0f, 1.0f),
        VectorSet(127.0f, 1.0f, 1.0f, 1.0f),
        VectorSet(0.0f, 1.0f, 1.0f, 1.0f),
    };
    u32 differences = 0u, cases = 0u;
    b8 delivered = true;
    for(const u32 denormalMode : s_DenormalModes){
        u32 control{};
        if(_controlfp_s(&control, denormalMode, _MCW_DN) != 0 || (control & _MCW_DN) != denormalMode)
            return 2;
        for(const i32 mode : s_Modes){
            if(!SetFloatingPointRoundingMode(mode))
                return 2;
            for(const u32 enabled : { _EM_UNDERFLOW, _EM_UNDERFLOW | _EM_INEXACT }){
                for(usize index = 0u; index < x.size(); ++index){
                    const auto expected = ObserveTrapEdge(MakeNotNull<Evaluate>(Reference), x[index], y[index], enabled), actual = ObserveTrapEdge(evaluate, x[index], y[index], enabled);
                    if(!expected || !actual)
                        return 2;
                    if(index < 2u && denormalMode == _DN_SAVE)
                        delivered = delivered && expected->code == EXCEPTION_FLT_UNDERFLOW;
                    const b8 different = *expected != *actual;
                    differences += different;
                    ++cases;
                    FOUNDATION_COUT << "trap_edge DN=" << denormalMode << " rounding=" << mode << " enabled=" << enabled << " case=" << index
                             << " expected=" << expected->code << '/' << expected->flags << '/' << expected->control << '/' << expected->error << '/' << expected->nativeStatus << '/' << expected->nativeControl << '/' << expected->valueBits
                             << " actual=" << actual->code << '/' << actual->flags << '/' << actual->control << '/' << actual->error << '/' << actual->nativeStatus << '/' << actual->nativeControl << '/' << actual->valueBits
                             << " differs=" << different << '\n';
                }
            }
        }
    }
    FOUNDATION_COUT << "trap edge cases=" << cases << " differences=" << differences << " distinguishable=" << delivered << '\n';
    return delivered ? (differences == 0u ? 0 : 1) : 2;
#else
    return 2;
#endif
}

}

[[nodiscard]] FOUNDATION_INLINE b8 ObservePowKernel(
    const u8 variantCode,
    const b8 useReference,
    const SIMDVectorSingle x,
    const SIMDVectorSingle y,
    Array<u32, 4>& outBits,
    i32& outStandardFlags,
    u32& outMappedFlags,
    u64& outNativeBits,
    i32& outError
)noexcept{
#pragma STDC FENV_ACCESS ON
#if defined(FOUNDATION_PLATFORM_WINDOWS) && defined(FOUNDATION_HAS_NEON64) && !defined(_M_ARM64EC)
    const u64 clearNativeStatus = 0u;
    __asm__ __volatile__("msr fpsr, %0" : : "r"(clearNativeStatus));
#endif
#if defined(FOUNDATION_PLATFORM_WINDOWS)
    _clearfp();
#endif
    if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT))
        return false;
    const auto evaluate = PowKernels::SelectEvaluator(variantCode, useReference);
    errno = E2BIG;
    const SIMDVectorSingle result = evaluate.get()(x, y);
    outError = errno;
    outStandardFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    u32 mappedStatus = 0u;
#if defined(FOUNDATION_PLATFORM_WINDOWS)
    mappedStatus = _statusfp();
#endif
    u64 nativeStatus = 0u;
#if defined(FOUNDATION_PLATFORM_WINDOWS) && defined(FOUNDATION_HAS_NEON64) && !defined(_M_ARM64EC)
    __asm__ __volatile__("mrs %0, fpsr" : "=r"(nativeStatus));
#endif
    outMappedFlags = mappedStatus;
    outNativeBits = nativeStatus;
    for(usize lane = 0u; lane < 4u; ++lane)
        outBits[lane] = VectorGetIntByIndex(result, lane);
    return true;
}

FOUNDATION_INLINE void EvaluatePowKernel(const u8 variantCode, const b8 useReference, const SIMDVectorSingle x, const SIMDVectorSingle y, UInt4& outBits)noexcept{
    const auto evaluate = PowKernels::SelectEvaluator(variantCode, useReference);
    StoreInt(evaluate.get()(x, y), outBits);
}

FOUNDATION_INLINE void FOUNDATION_SIMD_CALL SelectPowSrgbLinearBranch(const SIMDVectorSingle nonlinear, const SIMDVectorSingle linearBranch, const SIMDVectorSingle clamped, const f32 cutoff, UInt4& outBits)noexcept{
    StoreInt(VectorSelect(nonlinear, linearBranch, VectorLessOrEqual(clamped, VectorReplicate(cutoff))), outBits);
}

[[nodiscard]] FOUNDATION_INLINE i32 VerifyPowTrapsKernel(const u8 variantCode){
    return PowKernels::VerifyTrapsImpl(PowKernels::SelectEvaluator(variantCode, false));
}

[[nodiscard]] FOUNDATION_INLINE i32 VerifyPowTrapEdgesKernel(const u8 variantCode){
    return PowKernels::VerifyTrapEdgesImpl(PowKernels::SelectEvaluator(variantCode, false));
}

class PowQualificationEnvironmentScope final{
public:
    PowQualificationEnvironmentScope()noexcept
        : m_originalError(errno)
        , m_environment(HoldFloatingPointExceptions())
    {
#if defined(FOUNDATION_PLATFORM_WINDOWS) && defined(FOUNDATION_HAS_NEON64) && !defined(_M_ARM64EC)
        __asm__ __volatile__("mrs %0, fpsr" : "=r"(m_originalNativeStatus));
#endif
    }

    ~PowQualificationEnvironmentScope()noexcept{
        if(!m_environment)
            return;
        if(!SetFloatingPointEnvironment(*m_environment))
            __builtin_trap();
#if defined(FOUNDATION_PLATFORM_WINDOWS) && defined(FOUNDATION_HAS_NEON64) && !defined(_M_ARM64EC)
        __asm__ __volatile__("msr fpsr, %0" : : "r"(m_originalNativeStatus));
#endif
        errno = m_originalError;
    }

    PowQualificationEnvironmentScope(const PowQualificationEnvironmentScope&) = delete;
    PowQualificationEnvironmentScope& operator=(const PowQualificationEnvironmentScope&) = delete;

public:
    [[nodiscard]] b8 available()const noexcept{
        return static_cast<b8>(m_environment);
    }

private:
    i32 m_originalError;
#if defined(FOUNDATION_PLATFORM_WINDOWS) && defined(FOUNDATION_HAS_NEON64) && !defined(_M_ARM64EC)
    u64 m_originalNativeStatus = 0u;
#endif
    Expected<FloatingPointEnvironment> m_environment;
};
};


