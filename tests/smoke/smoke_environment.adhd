native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <core/alloc/scratch.h>
#include <core/alloc/general.h>
#include <core/common/log.h>

#include <global/environment.h>
#include <global/name.h>
#include <global/text_utils.h>
#include <global/type.h>

namespace NWB::Tests::Smoke{
inline constexpr Name s_SmokeEnvironmentArena = NWB::Tests::Smoke::s_SmokeNameSmokeEnvironment;

using SmokeEnvironmentString = AString<Core::Alloc::GlobalArena>;

template<typename ArenaT>
[[nodiscard]] inline Expected<AString<ArenaT>, ErrorCode> ReadSmokeEnvironmentText(ArenaT& arena, const AStringView variableName){
    auto value = ReadEnvironmentVariable(arena, variableName);
    if(!value){
        NWB_LOGGER_ERROR(NWB_TEXT("Smoke: failed to read environment '{}': {}"), ConvertString(variableName), ConvertString(value.error().message()));
        return MakeUnexpected(value.error());
    }
    if(!*value || (*value)->empty())
        return MakeUnexpected(MakeErrorCode(ErrorCondition::no_such_file_or_directory));
    return Move(**value);
}
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<String> ReadSmokeEnvironmentString(in StringView variableName){
    b8 found = false;
    String text;
    native(in variableName, mut found, mut text){
        Core::Alloc::ScratchArena arena(s_SmokeEnvironmentArena);
        const auto value = ReadSmokeEnvironmentText(arena, variableName);
        if(value){
            text.assign(value->data(), value->size());
            found = true;
        }
    }
    if(!found)
        return MakeUnexpected(Failure());
    return text;
}

Expected<f32> ReadSmokeEnvironmentF32(in StringView variableName){
    const Expected<String> text = ReadSmokeEnvironmentString(variableName);
    if(!text.has_value())
        return MakeUnexpected(Failure());
    return ParseF32(StringView(text.value()));
}

// Truthy env reader for on/off flags: absent/empty/"0" -> false, anything else -> true.
b8 ReadSmokeEnvironmentFlag(in StringView variableName){
    const Expected<String> text = ReadSmokeEnvironmentString(variableName);
    if(!text.has_value())
        return false;
    const StringView view = StringView(text.value());
    return !view.empty() && view[0u] != 0 && !view.starts_with("0");
}


