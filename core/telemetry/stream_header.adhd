native{
#include <core/telemetry/event.h>
namespace NWB::Core::Telemetry{
constexpr u16 s_EncodedEventUnknown = EventKind::Unknown;
};
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_StreamMagic = 0x4E574253u; // NWBS


[serialize]
class EncodedStreamHeader{
    public u32 magic = s_StreamMagic;
    public u16 version = s_TelemetryFormatVersion;
    public u16 reserved = 0u;
    public u64 eventCount = 0u;
    public u64 payloadBytes = 0u;
}


[serialize]
class EncodedEventHeader{
    public u32 magic = s_EventMagic;
    public u16 version = s_TelemetryFormatVersion;
    public u16 kind = s_EncodedEventUnknown;
    public u8 reserved = 0u;
    public u32 streamId = 0u;
    public u64 frameIndex = 0u;
    public u64 timestampNanoseconds = 0u;
    public u64 payloadBytes = 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

