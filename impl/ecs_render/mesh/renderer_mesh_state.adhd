#include <impl/ecs_render/mesh/renderer_mesh_types.adhd>
#include <impl/ecs_render/mesh/instance_gpu_data.adhd>
#include <impl/ecs_render/mesh/mesh_frame_bindings.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererMeshState : NoCopy{
    public HashMap<Name, MeshResources> m_meshes;
    public BufferHandle m_meshViewBuffer;
    public MeshFrameBindings m_frameBindings;
    public Array<u8, s_MeshViewGpuDataBytes> m_meshViewGpuData;
    public b8 m_meshViewGpuDataValid = false;

    public RendererMeshState(){}

    public void invalidateResources(){
        this.m_meshes.clear();
        this.m_meshViewBuffer.reset();
        this.m_frameBindings.reset();
        this.m_meshViewGpuDataValid = false;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

