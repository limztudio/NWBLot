void VerifyTextBakedTests_FontHashMismatchUsesCoverageForTheAlreadySelectedFace(mut TextBakedTests self){
    ASSERT_TRUE(self.corruptPayloadFontHash());
    ASSERT_TRUE(self.installAtlas());
    ShapeRequest request = ShapeRequest();
    request.text = s_UiTextBakedSampleGlyphText;
    ASSERT_TRUE(self.applyLayout(request));
    EXPECT_FALSE(FontFaceHasBakedAtlas(self.m_layout.glyphs()[0u].face));
    EXPECT_EQ(FontFaceIdentityName(self.m_layout.glyphs()[0u].face), Name(s_TestLatinFontPath));
    const DrawSnapshot snapshot = self.paint();
    EXPECT_TRUE(snapshot.sdfPages().empty());
    EXPECT_FALSE(snapshot.glyphPages().empty());
}

void VerifyTextBakedTests_LogicalFontIdentityMustMatchEvenWhenTheBytesMatch(mut TextBakedTests self){
    ASSERT_TRUE(self.rebindPayloadFont("tests/ui/fonts/other"));
    ASSERT_TRUE(self.installAtlas());
    ASSERT_TRUE(self.applyLayout(MakeUiTextScrollShapeRequest(s_UiTextBakedSampleGlyphText, 24.0f)));
    EXPECT_FALSE(FontFaceHasBakedAtlas(self.m_layout.glyphs()[0u].face));
    EXPECT_TRUE(self.paint().sdfPages().empty());
}

void VerifyTextBakedTests_OldLayoutAndSnapshotOwnTheirAtlasAfterFontReplacementAndAssetRelease(mut TextBakedTests self){
    ASSERT_TRUE(self.installAtlas());
    ASSERT_TRUE(self.applyLayout(MakeUiTextScrollShapeRequest(s_UiTextBakedSampleGlyphText, 24.0f)));
    const SharedBakedFontAtlas retained = FontFaceBakedAtlas(self.m_layout.glyphs()[0u].face);
    const DrawSnapshot first = self.paint();
    ASSERT_EQ(first.sdfPages().size(), 1u);
    ASSERT_TRUE(self.replaceWithUnbakedFontAndClearAtlas());
    const DrawSnapshot second = self.paint();
    ASSERT_EQ(second.sdfPages().size(), 1u);
    EXPECT_EQ(first.sdfPages()[0u], second.sdfPages()[0u]);
    EXPECT_EQ(SdfPageBindingOf(second.sdfPages()[0u]).fontGeneration, 1u);
    EXPECT_EQ(retained, FontFaceBakedAtlas(self.m_layout.glyphs()[0u].face));
    EXPECT_EQ(SdfPagePixelsOf(first.sdfPages()[0u])[0u], 128u);
}

void VerifyTextBakedTests_OutsideBakedSizeRangeUsesCoverageWithLowerThresholdControl(mut TextBakedTests self){
    ASSERT_TRUE(self.installAtlas());
    ASSERT_TRUE(self.applyLayout(MakeUiTextScrollShapeRequest(s_UiTextBakedSampleGlyphText, 24.0f)));
    const DrawSnapshot first = self.paint();
    ASSERT_EQ(first.sdfPages().size(), 1u);
    ASSERT_TRUE(self.applyLayout(MakeUiTextScrollShapeRequest(s_UiTextBakedSampleGlyphText, 8.0f)));
    const DrawSnapshot small = self.paint();
    EXPECT_TRUE(small.sdfPages().empty());
    EXPECT_FALSE(small.glyphPages().empty());
    ASSERT_TRUE(self.applyLayout(MakeUiTextScrollShapeRequest(s_UiTextBakedSampleGlyphText, 129.0f)));
    EXPECT_TRUE(self.paint().sdfPages().empty());
}

void VerifyTextBakedTests_FractionalPhysicalSizeBelowSdfThresholdUsesCoverage(mut TextBakedTests self){
    ASSERT_TRUE(self.installAtlas());
    ASSERT_TRUE(self.applyLayout(MakeUiTextScrollShapeRequest(s_UiTextBakedSampleGlyphText, 23.5f)));
    const DrawSnapshot fractionalFont = self.paint();
    EXPECT_TRUE(fractionalFont.sdfPages().empty());
    ASSERT_EQ(fractionalFont.glyphPages().size(), 1u);
    ASSERT_EQ(fractionalFont.commands().size(), 1u);
    EXPECT_EQ(fractionalFont.commands()[0u].material, PaintMaterial::Glyph);

    ASSERT_TRUE(self.applyLayout(MakeUiTextScrollShapeRequest(s_UiTextBakedSampleGlyphText, 16.0f)));
    const DrawSnapshot fractionalDpi = self.paint(1.49f);
    EXPECT_TRUE(fractionalDpi.sdfPages().empty());
    ASSERT_EQ(fractionalDpi.glyphPages().size(), 1u);
    ASSERT_EQ(fractionalDpi.commands().size(), 1u);
    EXPECT_EQ(fractionalDpi.commands()[0u].material, PaintMaterial::Glyph);

    const DrawSnapshot thresholdDpi = self.paint(1.5f);
    EXPECT_TRUE(thresholdDpi.glyphPages().empty());
    ASSERT_EQ(thresholdDpi.sdfPages().size(), 1u);
    ASSERT_EQ(thresholdDpi.commands().size(), 1u);
    EXPECT_EQ(thresholdDpi.commands()[0u].material, PaintMaterial::SdfGlyph);
}

void VerifyTextBakedTests_WhitespaceKeepsItsAdvanceWithoutAdmittingAnImage(mut TextBakedTests self){
    ASSERT_TRUE(self.installAtlas());
    ASSERT_TRUE(self.applyLayout(MakeUiTextScrollShapeRequest("   ", 24.0f)));
    EXPECT_GT(self.m_layout.measure().x, 0.0f);
    const DrawSnapshot snapshot = self.paint();
    EXPECT_TRUE(snapshot.sdfPages().empty());
    EXPECT_TRUE(snapshot.glyphPages().empty());
    EXPECT_TRUE(snapshot.vertices().empty());
}


