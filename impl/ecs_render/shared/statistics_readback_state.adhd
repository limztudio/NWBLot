////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/shared/statistics_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


interface IStatisticsOutcome<StatisticsT>{
    usize counterCount()const;
    void accept(mut StatisticsT metadata)const;
    void copyCounters(in Span<u32> counters, in StatisticsT metadata, mut StatisticsT latest)const;
}

class StatisticsReadbackSlot<StatisticsT>{
    public StatisticsT metadata;
    public b8 reserved = false;
    public b8 inFlight = false;

    public StatisticsReadbackSlot(){ this.metadata = StatisticsT(); }
}

class StatisticsReadbackState<StatisticsT, OutcomeT : IStatisticsOutcome<StatisticsT>> : NoCopy{
    private Array<StatisticsReadbackSlot<StatisticsT>, s_StatisticsReadbackSlotCount> m_slots;
    private StatisticsT m_latest;
    private u64 m_generation = 1u;
    private u64 m_nextSequence = 1u;
    private Futex m_mutex;
    private u16 m_deviceGeneration;

    public StatisticsReadbackState(in u16 deviceGeneration){
        this.m_deviceGeneration = deviceGeneration;
        this.m_latest = StatisticsT();
    }

    public void reset(in u16 deviceGeneration){
        const FutexGuard guard = AcquireFutex(this.m_mutex);
        if(this.m_generation == u64.max)
            this.m_generation = 0u;
        else
            ++this.m_generation;
        this.m_deviceGeneration = deviceGeneration;
        this.m_latest = StatisticsT();
        for(usize index = 0u; index < s_StatisticsReadbackSlotCount; ++index)
            this.m_slots[index] = StatisticsReadbackSlot<StatisticsT>();
    }

    public StatisticsReservationKey reserve(in StatisticsT metadata){
        const FutexGuard guard = AcquireFutex(this.m_mutex);
        if(this.m_deviceGeneration == 0u || this.m_generation == 0u || this.m_nextSequence == u64.max)
            return StatisticsReservationKey();
        for(u32 index = 0u; index < s_StatisticsReadbackSlotCount; ++index){
            mut StatisticsReadbackSlot<StatisticsT> slot = this.m_slots[index];
            if(slot.reserved || slot.inFlight)
                continue;
            slot.metadata = metadata;
            slot.metadata.sequence = this.m_nextSequence;
            ++this.m_nextSequence;
            slot.metadata.generation = this.m_generation;
            slot.metadata.acceptedToken = QueueSubmissionToken();
            slot.metadata.hardwareReady = false;
            slot.reserved = true;
            return StatisticsReservationKey(slot.metadata.sequence, this.m_generation, index);
        }
        return StatisticsReservationKey();
    }

    private b8 matches(in StatisticsReservationKey key)const{
        if(!key.valid() || key.generation != this.m_generation || key.slot >= s_StatisticsReadbackSlotCount)
            return false;
        in StatisticsReadbackSlot<StatisticsT> slot = this.m_slots[key.slot];
        return slot.metadata.sequence == key.sequence && slot.metadata.generation == key.generation;
    }

    public void discard(in StatisticsReservationKey key){
        const FutexGuard guard = AcquireFutex(this.m_mutex);
        if(!this.matches(key))
            return;
        mut StatisticsReadbackSlot<StatisticsT> slot = this.m_slots[key.slot];
        if(slot.reserved && !slot.inFlight)
            this.m_slots[key.slot] = StatisticsReadbackSlot<StatisticsT>();
    }

    public Expected<StatisticsPendingReadback> pending(in u32 index)const{
        const FutexGuard guard = AcquireFutex(this.m_mutex);
        if(index >= s_StatisticsReadbackSlotCount)
            return MakeUnexpected(Failure());
        in StatisticsReadbackSlot<StatisticsT> slot = this.m_slots[index];
        const QueueSubmissionToken token = slot.metadata.acceptedToken;
        if(!slot.inFlight || !token.valid() || !token.hasPhysicalQueueIdentity() || token.deviceGeneration != this.m_deviceGeneration)
            return MakeUnexpected(Failure());
        return StatisticsPendingReadback(StatisticsReservationKey(slot.metadata.sequence, slot.metadata.generation, index), token);
    }

    public Expected<StatisticsT> tryGetLatestStatistics()const{
        const FutexGuard guard = AcquireFutex(this.m_mutex);
        if(this.m_latest.sequence == 0u)
            return MakeUnexpected(Failure());
        return this.m_latest;
    }

    public void accept(in StatisticsReservationKey key, in QueueSubmissionToken token, in b8 hardwareReady){
        this.accept(key, token, hardwareReady, OutcomeT());
    }

    public void accept(in StatisticsReservationKey key, in QueueSubmissionToken token, in b8 hardwareReady, in OutcomeT outcome){
        const FutexGuard guard = AcquireFutex(this.m_mutex);
        if(!this.matches(key))
            return;
        mut StatisticsReadbackSlot<StatisticsT> slot = this.m_slots[key.slot];
        if(!slot.reserved || slot.inFlight)
            return;
        slot.reserved = false;
        slot.inFlight = true;
        slot.metadata.acceptedToken = token;
        slot.metadata.hardwareReady = hardwareReady;
        outcome.accept(slot.metadata);
    }

    public void complete(in StatisticsReservationKey key, in QueueSubmissionToken token, in Span<u32> counters){
        const FutexGuard guard = AcquireFutex(this.m_mutex);
        if(!this.matches(key))
            return;
        mut StatisticsReadbackSlot<StatisticsT> slot = this.m_slots[key.slot];
        if(!slot.inFlight || !token.valid() || !token.hasPhysicalQueueIdentity() || token.deviceGeneration != this.m_deviceGeneration || slot.metadata.acceptedToken != token)
            return;
        const OutcomeT outcome = OutcomeT();
        if(counters.size() >= outcome.counterCount() && slot.metadata.sequence > this.m_latest.sequence){
            this.m_latest = slot.metadata;
            outcome.copyCounters(counters, slot.metadata, this.m_latest);
        }
        this.m_slots[key.slot] = StatisticsReadbackSlot<StatisticsT>();
    }
}

[move_only]
class StatisticsReservation<StatisticsT, OutcomeT : IStatisticsOutcome<StatisticsT>>{
    private PlanReservation<Shared<StatisticsReadbackState<StatisticsT, OutcomeT>>, StatisticsReservationKey> m_lease;

    public StatisticsReservation(in Shared<StatisticsReadbackState<StatisticsT, OutcomeT>> control, in StatisticsT metadata){
        if(control.valid()){
            const StatisticsReservationKey key = control.deref().reserve(metadata);
            this.m_lease.adopt(control, key, key.valid());
        }
    }

    public b8 valid()const{ return this.m_lease.valid(); }

    public u32 slotIndex()const{
        if(!this.m_lease.valid())
            return 0u;
        return this.m_lease.plan().slot;
    }

    public void discard(){ this.m_lease.discard(); }

    public void acceptReservation(in QueueSubmissionToken token, in b8 hardwareReady){
        this.acceptReservation(token, hardwareReady, OutcomeT());
    }

    public void acceptReservation(in QueueSubmissionToken token, in b8 hardwareReady, in OutcomeT outcome){
        if(this.m_lease.valid()){
            const Shared<StatisticsReadbackState<StatisticsT, OutcomeT>> control = this.m_lease.control();
            control.deref().accept(this.m_lease.plan(), token, hardwareReady, outcome);
        }
        this.m_lease.release();
    }
}


