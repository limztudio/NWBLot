#include <impl/assets_material/bind_value_parser.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class MaterialBindAttribute{
    public String name = "";
    public Vector<String> arguments;
}

class MaterialBindField{
    public String type = "";
    public String name = "";
    public Vector<MaterialBindAttribute> attributes;

    public b8 hasAttribute(in StringView attributeName)const{
        for(in MaterialBindAttribute attribute : this.attributes){
            if(attribute.name == attributeName)
                return true;
        }
        return false;
    }

    public StringView defaultArgument()const{
        for(in MaterialBindAttribute attribute : this.attributes){
            if(attribute.name == s_MaterialDefaultAttribute && attribute.arguments.size() == 1u)
                return attribute.arguments[0u];
        }
        return "";
    }
}

class MaterialBindStruct{
    public String name = "";
    public Vector<MaterialBindAttribute> attributes;
    public Vector<MaterialBindField> fields;

    public b8 hasField(in StringView fieldName)const{
        for(in MaterialBindField field : this.fields){
            if(field.name == fieldName)
                return true;
        }
        return false;
    }

    public b8 hasAttribute(in StringView attributeName)const{
        for(in MaterialBindAttribute attribute : this.attributes){
            if(attribute.name == attributeName)
                return true;
        }
        return false;
    }
}

class MaterialBindInstance{
    public String type = "";
    public String name = "";
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void CopyMaterialBindTypedLayoutDefaults(
    in u64 layoutHash,
    in Span<MaterialTypedLayoutBlock> typedLayoutBlocks,
    in Span<MaterialTypedLayoutField> typedLayoutFields,
    in Span<u8> typedBlockBytes,
    mut u64 outLayoutHash,
    mut Vector<MaterialTypedLayoutBlock> outBlocks,
    mut Vector<MaterialTypedLayoutField> outFields,
    mut Vector<u8> outBlockBytes
){
    outLayoutHash = layoutHash;
    outBlocks.clear();
    outBlocks.reserve(typedLayoutBlocks.size());
    for(in MaterialTypedLayoutBlock block : typedLayoutBlocks)
        outBlocks.push_back(block);
    outFields.clear();
    outFields.reserve(typedLayoutFields.size());
    for(in MaterialTypedLayoutField field : typedLayoutFields)
        outFields.push_back(field);
    outBlockBytes.clear();
    outBlockBytes.reserve(typedBlockBytes.size());
    for(in u8 byteValue : typedBlockBytes)
        outBlockBytes.push_back(byteValue);
}

Expected<MaterialBindStorageByteSizes> TryComputeMaterialBindStorageByteSizes(in Span<MaterialTypedLayoutBlock> blocks){
    MaterialBindStorageByteSizes outSizes;
    for(usize i = 0u; i < blocks.size(); ++i){
        const MaterialTypedLayoutBlock block = blocks[i];
        if(block.blockClass == MaterialBlockClass::MaterialConstant){
            if(block.byteSize > 0xFFFFFFFFu - outSizes.constantBytes)
                return makeUnexpected(Failure());
            outSizes.constantBytes += block.byteSize;
        }
        else if(block.blockClass == MaterialBlockClass::MaterialMutable){
            if(block.byteSize > 0xFFFFFFFFu - outSizes.mutableBytes)
                return makeUnexpected(Failure());
            outSizes.mutableBytes += block.byteSize;
        }
        else
            return makeUnexpected(Failure());
    }
    return outSizes;
}

u32 ComputeMaterialBindBlockStorageByteBegin(in Span<MaterialTypedLayoutBlock> blocks, in u32 blockIndex){
    u32 byteBegin = 0u;
    const MaterialBlockClass blockClass = blocks[cast<usize>(blockIndex)].blockClass;
    for(u32 currentBlockIndex = 0u; currentBlockIndex < blockIndex; ++currentBlockIndex){
        const MaterialTypedLayoutBlock block = blocks[cast<usize>(currentBlockIndex)];
        if(block.blockClass != blockClass)
            continue;
        byteBegin += block.byteSize;
    }
    return byteBegin;
}

u8 ExtractMaterialLayoutValueByte(in u32x4u value, in u32 byteIndex){
    const u32 wordIndex = byteIndex / 4u;
    const u32 shift = (byteIndex % 4u) * 8u;
    u32 word = value.w;
    if(wordIndex == 0u)
        word = value.x;
    else if(wordIndex == 1u)
        word = value.y;
    else if(wordIndex == 2u)
        word = value.z;
    return cast<u8>((word >> shift) & 0xffu);
}

void AppendMaterialTypedLayoutFieldBytes(in MaterialLayoutFieldType fieldType, in u32x4u value, mut Vector<u8> inOutBlockBytes){
    const u32 byteSize = MaterialLayoutFieldByteSize(fieldType);
    assert(byteSize != 0u && byteSize <= 16u);
    const usize oldSize = inOutBlockBytes.size();
    inOutBlockBytes.resize(oldSize + cast<usize>(byteSize), 0u);
    for(u32 i = 0u; i < byteSize; ++i)
        inOutBlockBytes[oldSize + cast<usize>(i)] = ExtractMaterialLayoutValueByte(value, i);
}

void PadMaterialTypedLayoutBytesTo(in usize targetByteSize, mut Vector<u8> inOutBlockBytes){
    assert(targetByteSize >= inOutBlockBytes.size());
    inOutBlockBytes.reserve(targetByteSize);
    inOutBlockBytes.resize(targetByteSize, 0u);
}

b8 WriteMaterialTypedLayoutFieldBytes(in usize byteOffset, in MaterialLayoutFieldType fieldType, in u32x4u value, mut Vector<u8> inOutBlockBytes){
    const u32 byteSize = MaterialLayoutFieldByteSize(fieldType);
    if(byteSize == 0u || byteSize > 16u)
        return false;
    if(byteOffset > inOutBlockBytes.size() || cast<usize>(byteSize) > inOutBlockBytes.size() - byteOffset)
        return false;
    for(u32 i = 0u; i < byteSize; ++i)
        inOutBlockBytes[byteOffset + cast<usize>(i)] = ExtractMaterialLayoutValueByte(value, i);
    return true;
}

Expected<u32x4u> TryBuildMaterialTypedLayoutDefaultValue(
    in Name materialName,
    in StringView instanceName,
    in StringView fieldName,
    in StringView fieldTypeText,
    in StringView defaultArgument,
    in MaterialLayoutFieldType fieldType
){
    if(IsMaterialLayoutResourceFieldType(fieldType))
        return u32x4u(0u, 0u, 0u, 0u);

    const Expected<CompactString> key = BuildMaterialBindParameterKey(instanceName, fieldName);
    if(!key.has_value()){
        error("Material bind typed layout: field '{}.{}' for '{}' exceeds ACompactString capacity", instanceName, fieldName, materialName.resolvedText());
        return makeUnexpected(Failure());
    }

    CompactString defaultText;
    if(!defaultText.assign(defaultArgument)){
        error("Material bind typed layout: default for '{}.{}' in '{}' exceeds ACompactString capacity", instanceName, fieldName, materialName.resolvedText());
        return makeUnexpected(Failure());
    }

    const Expected<MaterialTypedValueData> defaultParameter = ParseMaterialTypedValue(key.value().view(), defaultText.view());
    if(!defaultParameter.has_value()){
        error("Material bind typed layout: default '{}' for '{}.{}' in '{}' is invalid", defaultArgument, instanceName, fieldName, materialName.resolvedText());
        return makeUnexpected(Failure());
    }

    const MaterialLayoutFieldType defaultFieldType = MaterialLayoutFieldTypeFromParameterType(cast<MaterialParameterValueType>(defaultParameter.value().meta.z), defaultParameter.value().meta.w);
    if(defaultFieldType != fieldType){
        error(
            "Material bind typed layout: default '{}' for '{}.{}' in '{}' does not match field type '{}'",
            defaultArgument,
            instanceName,
            fieldName,
            materialName.resolvedText(),
            fieldTypeText
        );
        return makeUnexpected(Failure());
    }

    return MaterialTypedValueToLayoutValue(defaultParameter.value());
}

Expected<u32x4u> TryParseMaterialTypedLayoutParameterValue(
    in Name materialName,
    in StringView parameterName,
    in StringView parameterValue,
    in MaterialTypedLayoutField field
){
    const Expected<MaterialTypedValueData> parameter = ParseMaterialTypedValue(parameterName, parameterValue);
    if(!parameter.has_value()){
        error("Material bind typed layout: parameter '{}' for '{}' has invalid value '{}'", parameterName, materialName.resolvedText(), parameterValue);
        return makeUnexpected(Failure());
    }

    const MaterialLayoutFieldType parameterFieldType = MaterialLayoutFieldTypeFromParameterType(cast<MaterialParameterValueType>(parameter.value().meta.z), parameter.value().meta.w);
    if(parameterFieldType != field.fieldType){
        error("Material bind typed layout: parameter '{}' for '{}' does not match interface field type", parameterName, materialName.resolvedText());
        return makeUnexpected(Failure());
    }

    return MaterialTypedValueToLayoutValue(parameter.value());
}

Expected<Name> TryParseMaterialBindName(in StringView text){
    Name resolved = s_NameNone;
    b8 valid = false;
    native(in text, mut resolved, mut valid){
        const auto name = Name::FromText(text);
        if(name && *name){
            resolved = *name;
            valid = true;
        }
    }
    if(!valid)
        return makeUnexpected(Failure());
    return resolved;
}

b8 BuildMaterialBindTypedLayoutBlockLookup(
    in StringView contextLabel,
    in Span<MaterialTypedLayoutBlock> typedLayoutBlocks,
    mut HashMap<Name, MaterialBindTypedLayoutBlockLookupEntry> outBlockLookup
){
    outBlockLookup.clear();
    outBlockLookup.reserve(typedLayoutBlocks.size());

    usize blockByteBegin = 0u;
    u32 constantByteBegin = 0u;
    for(usize blockIndex = 0u; blockIndex < typedLayoutBlocks.size(); ++blockIndex){
        const MaterialTypedLayoutBlock block = typedLayoutBlocks[blockIndex];
        assert(blockIndex < cast<usize>(u32.max));
        if(blockByteBegin > cast<usize>(u32.max)){
            error("Material bind typed layout: block byte offset exceeds u32 for '{}'", contextLabel);
            return false;
        }

        MaterialBindTypedLayoutBlockLookupEntry entry;
        entry.blockIndex = cast<u32>(blockIndex);
        entry.byteBegin = cast<u32>(blockByteBegin);
        entry.constantByteBegin = constantByteBegin;
        if(outBlockLookup.contains(block.blockName)){
            error("Material bind typed layout: duplicate block in '{}'", contextLabel);
            return false;
        }
        outBlockLookup.try_emplace(block.blockName, entry);
        assert(cast<usize>(block.byteSize) <= usize.max - blockByteBegin);

        blockByteBegin += cast<usize>(block.byteSize);
        if(block.blockClass == MaterialBlockClass::MaterialConstant){
            assert(block.byteSize <= u32.max - constantByteBegin);
            constantByteBegin += block.byteSize;
        }
    }

    return true;
}

b8 ApplyMaterialBindTypedLayoutParameterValueToStorage(
    in StringView interfacePath,
    in HashMap<CompactString, MaterialBindTypedLayoutParameterLookupEntry> parameterLookup,
    in Span<MaterialTypedLayoutField> typedLayoutFields,
    in Name materialName,
    in CompactString parameterName,
    in StringView parameterValue,
    mut Vector<MaterialResourceReference> outResourceReferences,
    mut Vector<u8> inOutBlockBytes
){
    if(!parameterLookup.contains(parameterName)){
        error(
            "Material bind typed layout: typed parameter '{}' is not declared by interface '{}' for '{}'",
            parameterName.view(),
            interfacePath,
            materialName.resolvedText()
        );
        return false;
    }
    const MaterialBindTypedLayoutParameterLookupEntry parameterEntry = parameterLookup.at(parameterName);
    assert(cast<usize>(parameterEntry.fieldIndex) < typedLayoutFields.size());

    const MaterialTypedLayoutField field = typedLayoutFields[cast<usize>(parameterEntry.fieldIndex)];
    if(IsMaterialLayoutResourceFieldType(field.fieldType)){
        const MaterialResourceKind resourceKind = MaterialLayoutFieldResourceKind(field.fieldType);
        const StringView resourcePath = trimView(parameterValue);
        const Expected<Name> resourceName = TryParseMaterialBindName(resourcePath);
        assert(parameterEntry.blockName != s_NameNone && field.fieldName != s_NameNone);
        if(!resourceName.has_value() || !IsSupportedMaterialResourceReference(resourceKind, resourcePath)){
            error("Material bind typed layout: resource parameter '{}' for '{}' must be an engine or project asset path", parameterName.view(), materialName.resolvedText());
            return false;
        }

        MaterialResourceReference resourceReference;
        resourceReference.blockName = parameterEntry.blockName;
        resourceReference.fieldName = field.fieldName;
        resourceReference.resourceKind = resourceKind;
        resourceReference.constantByteOffset = parameterEntry.constantByteOffset;
        if(!TryAssignMaterialResourceReferenceAsset(resourceKind, resourceName.value(), resourceReference)){
            assert(false);
            return false;
        }
        outResourceReferences.push_back(resourceReference);
        return true;
    }

    const Expected<u32x4u> typedValue = TryParseMaterialTypedLayoutParameterValue(materialName, parameterName.view(), parameterValue, field);
    if(!typedValue.has_value())
        return false;

    if(!WriteMaterialTypedLayoutFieldBytes(cast<usize>(parameterEntry.byteOffset), field.fieldType, typedValue.value(), inOutBlockBytes)){
        error("Material bind typed layout: parameter '{}' write exceeds packed layout bytes for '{}'", parameterName.view(), materialName.resolvedText());
        return false;
    }

    return true;
}

b8 LessMaterialResourceReferenceOffset(in MaterialResourceReference lhs, in MaterialResourceReference rhs){
    return lhs.constantByteOffset < rhs.constantByteOffset;
}

b8 ApplyMaterialBindTypedLayoutParametersToStorage(
    in StringView interfacePath,
    in HashMap<CompactString, MaterialBindTypedLayoutParameterLookupEntry> parameterLookup,
    in Span<MaterialTypedLayoutField> typedLayoutFields,
    in Name materialName,
    in HashMap<CompactString, CompactString> parameters,
    mut Vector<u8> inOutBlockBytes,
    mut Vector<MaterialResourceReference> outResourceReferences
){
    outResourceReferences.clear();
    for(in auto entry : parameters){
        if(!ApplyMaterialBindTypedLayoutParameterValueToStorage(
            interfacePath,
            parameterLookup,
            typedLayoutFields,
            materialName,
            entry.first,
            entry.second.view(),
            outResourceReferences,
            inOutBlockBytes
        ))
            return false;
    }

    native(mut outResourceReferences){
        ::Sort(outResourceReferences.begin(), outResourceReferences.end(), LessMaterialResourceReferenceOffset);
    }
    return true;
}

b8 TryInsertMaterialBindTypedLayoutParameterLookupEntry(
    in StringView interfacePath,
    in StringView contextLabel,
    in StringView instanceName,
    in StringView structName,
    in StringView fieldName,
    in MaterialBindTypedLayoutBlockLookupEntry blockEntry,
    in MaterialTypedLayoutBlock block,
    in usize fieldIndex,
    in MaterialTypedLayoutField field,
    mut HashMap<CompactString, MaterialBindTypedLayoutParameterLookupEntry> inOutParameterLookup
){
    if(fieldIndex > cast<usize>(u32.max)){
        error("Material bind typed layout: interface '{}' instance '{}' field range exceeds layout for '{}'", interfacePath, instanceName, contextLabel);
        return false;
    }
    if(field.offset > u32.max - blockEntry.byteBegin){
        error(
            "Material bind typed layout: interface '{}' field '{}.{}' byte offset exceeds u32 for '{}'",
            interfacePath,
            structName,
            fieldName,
            contextLabel
        );
        return false;
    }
    assert(!IsMaterialLayoutResourceFieldType(field.fieldType) || field.offset <= u32.max - blockEntry.constantByteBegin);

    const Expected<CompactString> parameterName = BuildMaterialBindParameterKey(instanceName, fieldName);
    if(!parameterName.has_value()){
        error("Material bind typed layout: field '{}.{}' for '{}' exceeds ACompactString capacity", instanceName, fieldName, contextLabel);
        return false;
    }

    MaterialBindTypedLayoutParameterLookupEntry entry;
    entry.fieldIndex = cast<u32>(fieldIndex);
    entry.byteOffset = blockEntry.byteBegin + field.offset;
    entry.constantByteOffset = blockEntry.constantByteBegin + field.offset;
    entry.blockName = block.blockName;
    if(inOutParameterLookup.contains(parameterName.value())){
        error("Material bind typed layout: duplicate parameter '{}' in '{}'", parameterName.value().view(), contextLabel);
        return false;
    }
    inOutParameterLookup.try_emplace(parameterName.value(), entry);
    return true;
}

b8 TryAppendMaterialBindTypedLayoutField(
    in StringView interfacePath,
    in Name contextName,
    in StringView instanceName,
    in StringView fieldName,
    in StringView fieldTypeText,
    in StringView defaultArgument,
    in MaterialBlockClass blockClass,
    in usize blockByteBegin,
    mut u32 inOutBlockByteSize,
    mut Vector<MaterialTypedLayoutField> inOutFields,
    mut Vector<u8> inOutBlockBytes
){
    const Expected<MaterialLayoutFieldType> fieldTypeResult = TryParseMaterialLayoutFieldTypeText(fieldTypeText);
    if(!fieldTypeResult.has_value()){
        error(
            "Material bind typed layout: interface '{}' field '{}.{}' has unsupported type '{}' for '{}'",
            interfacePath,
            instanceName,
            fieldName,
            fieldTypeText,
            contextName.resolvedText()
        );
        return false;
    }
    const MaterialLayoutFieldType fieldType = fieldTypeResult.value();
    if(IsMaterialLayoutResourceFieldType(fieldType) && blockClass != MaterialBlockClass::MaterialConstant){
        error("Material bind typed layout: resource field '{}.{}' must use material-constant storage for '{}'", instanceName, fieldName, contextName.resolvedText());
        return false;
    }

    const u32 fieldByteSize = MaterialLayoutFieldByteSize(fieldType);
    const Expected<u32> fieldOffset = TryAlignMaterialLayoutFieldOffset(inOutBlockByteSize, fieldType);
    if(fieldByteSize == 0u || !fieldOffset.has_value() || fieldOffset.value() > u32.max - fieldByteSize){
        error("Material bind typed layout: interface '{}' block '{}' exceeds u32 byte size for '{}'", interfacePath, instanceName, contextName.resolvedText());
        return false;
    }

    MaterialTypedLayoutField field;
    const Expected<Name> parsedFieldName = TryParseMaterialBindName(fieldName);
    if(!parsedFieldName.has_value()){
        error(
            "Material bind typed layout: interface '{}' has invalid field '{}.{}' for '{}'",
            interfacePath,
            instanceName,
            fieldName,
            contextName.resolvedText()
        );
        return false;
    }
    field.fieldName = parsedFieldName.value();
    field.fieldType = fieldType;
    field.offset = fieldOffset.value();
    const Expected<u32x4u> defaultValue = TryBuildMaterialTypedLayoutDefaultValue(
        contextName,
        instanceName,
        fieldName,
        fieldTypeText,
        defaultArgument,
        fieldType
    );
    if(!defaultValue.has_value())
        return false;
    field.defaultValue = defaultValue.value();
    if(cast<usize>(field.offset) > usize.max - blockByteBegin){
        error(
            "Material bind typed layout: interface '{}' field '{}.{}' could not append alignment padding for '{}'",
            interfacePath,
            instanceName,
            fieldName,
            contextName.resolvedText()
        );
        return false;
    }
    PadMaterialTypedLayoutBytesTo(blockByteBegin + cast<usize>(field.offset), inOutBlockBytes);
    AppendMaterialTypedLayoutFieldBytes(fieldType, field.defaultValue, inOutBlockBytes);

    inOutFields.push_back(field);
    inOutBlockByteSize = fieldOffset.value() + fieldByteSize;
    return true;
}

b8 TryFinalizeMaterialBindTypedLayoutBlock(
    in StringView interfacePath,
    in Name contextName,
    in StringView instanceName,
    in usize blockByteBegin,
    mut MaterialTypedLayoutBlock inOutBlock,
    mut u32 inOutConstantTypedByteSize,
    mut Vector<MaterialTypedLayoutBlock> inOutBlocks,
    mut Vector<u8> inOutBlockBytes
){
    const Expected<u32> alignedBlockByteSize = TryAlignMaterialLayoutBlockByteSize(inOutBlock.byteSize);
    if(!alignedBlockByteSize.has_value()){
        error("Material bind typed layout: interface '{}' block '{}' exceeds u32 byte size for '{}'", interfacePath, instanceName, contextName.resolvedText());
        return false;
    }
    inOutBlock.byteSize = alignedBlockByteSize.value();
    if(cast<usize>(inOutBlock.byteSize) > usize.max - blockByteBegin){
        error("Material bind typed layout: interface '{}' block '{}' could not append alignment padding for '{}'", interfacePath, instanceName, contextName.resolvedText());
        return false;
    }
    PadMaterialTypedLayoutBytesTo(blockByteBegin + cast<usize>(inOutBlock.byteSize), inOutBlockBytes);

    inOutBlocks.push_back(inOutBlock);
    if(inOutBlock.blockClass == MaterialBlockClass::MaterialConstant){
        if(inOutBlock.byteSize > u32.max - inOutConstantTypedByteSize){
            error("Material bind typed layout: interface '{}' constant storage exceeds u32 byte size for '{}'", interfacePath, instanceName, contextName.resolvedText());
            return false;
        }
        inOutConstantTypedByteSize += inOutBlock.byteSize;
    }
    return true;
}

b8 AppendMaterialBindGlobalLayoutConstants(
    in StringView includePath,
    in Name interfaceName,
    in u64 layoutHash,
    in Span<MaterialTypedLayoutBlock> typedLayoutBlocks,
    in usize typedLayoutFieldCount,
    mut HashSet<String> inOutSymbols,
    mut String inOutSource
){
    const Expected<MaterialBindStorageByteSizes> storageByteSizes = TryComputeMaterialBindStorageByteSizes(typedLayoutBlocks);
    if(!storageByteSizes.has_value()){
        error("Material bind include '{}': typed layout storage byte size exceeds u32", includePath);
        return false;
    }
    const u32 constantByteSize = storageByteSizes.value().constantBytes;
    const u32 mutableByteSize = storageByteSizes.value().mutableBytes;

    const NameHash interfaceHash = interfaceName.hash();
    for(u32 lane = 0u; lane < s_NameHashLaneCount; ++lane){
        String laneSuffix = "";
        laneSuffix.append(s_MaterialBindInterfaceHashSymbolPrefix);
        AppendDecimalU32(lane, laneSuffix);
        const String symbol = BuildMaterialBindGeneratedSymbol(laneSuffix);
        if(!AppendMaterialBindU64Constant(includePath, symbol, interfaceHash.qwords[cast<usize>(lane)], inOutSymbols, inOutSource))
            return false;
    }

    const String layoutHashSymbol = BuildMaterialBindGeneratedSymbol(s_MaterialBindLayoutHashSymbol);
    const String blockCountSymbol = BuildMaterialBindGeneratedSymbol(s_MaterialBindBlockCountSymbol);
    const String fieldCountSymbol = BuildMaterialBindGeneratedSymbol(s_MaterialBindFieldCountSymbol);
    const String storageConstantSymbol = BuildMaterialBindGeneratedSymbol(s_MaterialBindStorageConstantSymbol);
    const String storageMutableSymbol = BuildMaterialBindGeneratedSymbol(s_MaterialBindStorageMutableSymbol);
    const String constantByteSizeSymbol = BuildMaterialBindGeneratedSymbol(s_MaterialBindConstantByteSizeSymbol);
    const String mutableByteSizeSymbol = BuildMaterialBindGeneratedSymbol(s_MaterialBindMutableByteSizeSymbol);

    if(!AppendMaterialBindU64Constant(includePath, layoutHashSymbol, layoutHash, inOutSymbols, inOutSource))
        return false;
    if(!AppendMaterialBindU32Constant(includePath, blockCountSymbol, cast<u32>(typedLayoutBlocks.size()), inOutSymbols, inOutSource))
        return false;
    if(!AppendMaterialBindU32Constant(includePath, fieldCountSymbol, cast<u32>(typedLayoutFieldCount), inOutSymbols, inOutSource))
        return false;
    if(!AppendMaterialBindU32Constant(includePath, storageConstantSymbol, cast<u32>(MaterialBlockClass::MaterialConstant), inOutSymbols, inOutSource))
        return false;
    if(!AppendMaterialBindU32Constant(includePath, storageMutableSymbol, cast<u32>(MaterialBlockClass::MaterialMutable), inOutSymbols, inOutSource))
        return false;
    if(!AppendMaterialBindU32Constant(includePath, constantByteSizeSymbol, constantByteSize, inOutSymbols, inOutSource))
        return false;
    if(!AppendMaterialBindU32Constant(includePath, mutableByteSizeSymbol, mutableByteSize, inOutSymbols, inOutSource))
        return false;
    return true;
}

b8 AppendMaterialBindBlockLayoutConstants(
    in StringView includePath,
    in StringView instanceName,
    in Span<MaterialTypedLayoutBlock> typedLayoutBlocks,
    in u32 blockIndex,
    mut HashSet<String> inOutSymbols,
    mut String inOutSource
){
    const MaterialTypedLayoutBlock block = typedLayoutBlocks[cast<usize>(blockIndex)];
    const u32 blockStorageByteBegin = ComputeMaterialBindBlockStorageByteBegin(typedLayoutBlocks, blockIndex);
    const String storageSymbol = BuildMaterialBindGeneratedSymbol(instanceName, s_MaterialBindStorageSymbolSuffix);
    const String offsetSymbol = BuildMaterialBindGeneratedSymbol(instanceName, s_MaterialBindByteOffsetSymbolSuffix);
    const String sizeSymbol = BuildMaterialBindGeneratedSymbol(instanceName, s_MaterialBindByteSizeSymbolSuffix);
    if(!AppendMaterialBindU32Constant(includePath, storageSymbol, cast<u32>(block.blockClass), inOutSymbols, inOutSource))
        return false;
    if(!AppendMaterialBindU32Constant(includePath, offsetSymbol, blockStorageByteBegin, inOutSymbols, inOutSource))
        return false;
    if(!AppendMaterialBindU32Constant(includePath, sizeSymbol, block.byteSize, inOutSymbols, inOutSource))
        return false;
    return true;
}

b8 AppendMaterialBindFieldConstants(
    in StringView includePath,
    in StringView instanceName,
    in StringView fieldName,
    in StringView fieldType,
    in StringView defaultAttribute,
    in StringView keySymbol,
    in StringView defaultSymbol,
    mut HashSet<String> inOutSymbols,
    mut String inOutSource
){
    assert(!defaultAttribute.empty());
    const Expected<CompactString> keyText = BuildMaterialBindParameterKey(instanceName, fieldName);
    if(!keyText.has_value()){
        error("Material bind include '{}': failed to build key for '{}.{}'", includePath, instanceName, fieldName);
        return false;
    }
    const u64 keyHash = computeFnv64AsciiLowerText(keyText.value().view());
    if(!AppendMaterialBindU64Constant(includePath, keySymbol, keyHash, inOutSymbols, inOutSource))
        return false;
    if(!RegisterGeneratedMaterialBindSymbol(includePath, defaultSymbol, inOutSymbols))
        return false;
    AppendMaterialBindDefaultConstantStatement(defaultSymbol, fieldType, defaultAttribute, inOutSource);
    return true;
}

b8 AppendMaterialBindGeneratedInstanceField(
    in StringView includePath,
    in StringView instanceName,
    in StringView fieldName,
    in StringView fieldType,
    in StringView defaultAttribute,
    in MaterialBlockClass blockClass,
    in u32 layoutBlockStorageByteBegin,
    in MaterialTypedLayoutField layoutField,
    mut HashSet<String> inOutSymbols,
    mut String inOutSource
){
    assert(layoutField.offset <= u32.max - layoutBlockStorageByteBegin);
    const b8 isResourceField = IsMaterialLayoutResourceFieldType(layoutField.fieldType);
    const String byteOffsetSymbol = BuildMaterialBindGeneratedSymbol(instanceName, fieldName, s_MaterialBindByteOffsetSymbolSuffix);
    const String functionName = BuildMaterialBindAccessorName(instanceName, fieldName);
    if(!RegisterGeneratedMaterialBindSymbol(includePath, functionName, inOutSymbols))
        return false;

    const u32 fieldByteOffset = layoutBlockStorageByteBegin + layoutField.offset;
    if(!AppendMaterialBindU32Constant(includePath, byteOffsetSymbol, fieldByteOffset, inOutSymbols, inOutSource))
        return false;
    inOutSource.push_back('\n');
    if(isResourceField){
        assert(blockClass == MaterialBlockClass::MaterialConstant);
        AppendMaterialBindResourceFieldAccessor(layoutField.fieldType, byteOffsetSymbol, functionName, inOutSource);
        inOutSource.push_back('\n');
        return true;
    }

    const String loadFunctionName = BuildMaterialBindFieldLookupFunctionName(layoutField.fieldType, blockClass);
    assert(!loadFunctionName.empty());
    const String keySymbol = BuildMaterialBindGeneratedSymbol(instanceName, fieldName, s_MaterialBindKeySymbolSuffix);
    const String defaultSymbol = BuildMaterialBindGeneratedSymbol(instanceName, fieldName, s_MaterialBindDefaultSymbolSuffix);
    if(!AppendMaterialBindFieldConstants(includePath, instanceName, fieldName, fieldType, defaultAttribute, keySymbol, defaultSymbol, inOutSymbols, inOutSource))
        return false;
    AppendMaterialBindFieldAccessor(fieldType, byteOffsetSymbol, functionName, loadFunctionName, inOutSource);
    inOutSource.push_back('\n');
    return true;
}

b8 ValidateMaterialBindStructAttributes(in StringView bindFilePathText, in MaterialBindStruct bindStruct){
    b8 foundBlockClass = false;

    for(in MaterialBindAttribute attribute : bindStruct.attributes){
        if(attribute.name != s_MaterialConstantAttribute && attribute.name != s_MaterialMutableAttribute){
            error("Material bind '{}': struct '{}' has unsupported attribute '{}'", bindFilePathText, bindStruct.name, attribute.name);
            return false;
        }
        if(!attribute.arguments.empty()){
            error("Material bind '{}': struct '{}' block class attribute '{}' must not have arguments", bindFilePathText, bindStruct.name, attribute.name);
            return false;
        }
        if(foundBlockClass){
            error("Material bind '{}': struct '{}' declares more than one block class attribute", bindFilePathText, bindStruct.name);
            return false;
        }

        foundBlockClass = true;
    }

    if(foundBlockClass)
        return true;

    error("Material bind '{}': struct '{}' must declare a material block class attribute", bindFilePathText, bindStruct.name);
    return false;
}

b8 ValidateMaterialBindFieldAttributes(in StringView bindFilePathText, in MaterialBindStruct bindStruct, in MaterialBindField field){
    const b8 isResourceField = TryParseMaterialBindResourceFieldTypeText(field.type).has_value();
    if(isResourceField && field.attributes.empty())
        return true;
    b8 foundRequiredAttribute = false;

    for(in MaterialBindAttribute attribute : field.attributes){
        if(isResourceField || attribute.name != s_MaterialDefaultAttribute){
            error("Material bind '{}': field '{}.{}' has unsupported attribute '{}'", bindFilePathText, bindStruct.name, field.name, attribute.name);
            return false;
        }
        if(foundRequiredAttribute){
            error("Material bind '{}': field '{}.{}' declares {} more than once", bindFilePathText, bindStruct.name, field.name, s_MaterialDefaultAttribute);
            return false;
        }
        if(attribute.arguments.size() != 1u || attribute.arguments[0u].empty()){
            error("Material bind '{}': field '{}.{}' attribute '{}' requires one non-empty string argument", bindFilePathText, bindStruct.name, field.name, attribute.name);
            return false;
        }
        foundRequiredAttribute = true;
    }

    if(!foundRequiredAttribute){
        error("Material bind '{}': field '{}.{}' must declare a {} attribute", bindFilePathText, bindStruct.name, field.name, s_MaterialDefaultAttribute);
        return false;
    }

    return true;
}

b8 ValidateMaterialBindFieldSpec(in StringView bindFilePathText, in MaterialBindStruct bindStruct, in MaterialBindField field){
    const b8 isResourceField = TryParseMaterialBindResourceFieldTypeText(field.type).has_value();
    if(!IsAsciiIdentifier(field.type) || (!isResourceField && !TryParseMaterialParameterTypeText(field.type).has_value())){
        error("Material bind '{}': field '{}.{}' has unsupported type '{}'", bindFilePathText, bindStruct.name, field.name, field.type);
        return false;
    }
    if(isResourceField && bindStruct.hasAttribute(s_MaterialMutableAttribute)){
        error("Material bind '{}': resource field '{}.{}' must use material_constant storage", bindFilePathText, bindStruct.name, field.name);
        return false;
    }
    if(!IsAsciiIdentifier(field.name)){
        error("Material bind '{}': field '{}.{}' has invalid name", bindFilePathText, bindStruct.name, field.name);
        return false;
    }
    return true;
}

Expected<usize> FindMaterialBindStructIndex(in Span<MaterialBindStruct> structs, in StringView structName){
    for(usize i = 0u; i < structs.size(); ++i){
        if(structs[i].name == structName)
            return i;
    }
    return makeUnexpected(Failure());
}

b8 HasMaterialBindInstance(in Span<MaterialBindInstance> instances, in StringView instanceName){
    for(in MaterialBindInstance instance : instances){
        if(instance.name == instanceName)
            return true;
    }
    return false;
}

b8 ValidateAndAppendMaterialBindInstance(
    in StringView bindFilePathText,
    in Span<MaterialBindStruct> structs,
    in StringView typeName,
    in StringView instanceName,
    mut Vector<MaterialBindInstance> inOutInstances
){
    if(!IsAsciiIdentifier(typeName) || !FindMaterialBindStructIndex(structs, typeName).has_value()){
        error("Material bind '{}': instance '{}' references unknown struct type '{}'", bindFilePathText, instanceName, typeName);
        return false;
    }
    if(!IsAsciiIdentifier(instanceName)){
        error("Material bind '{}': invalid instance name '{}'", bindFilePathText, instanceName);
        return false;
    }
    if(HasMaterialBindInstance(inOutInstances, instanceName)){
        error("Material bind '{}': duplicate instance name '{}'", bindFilePathText, instanceName);
        return false;
    }
    MaterialBindInstance instance;
    instance.type.assign(typeName);
    instance.name.assign(instanceName);
    inOutInstances.push_back(instance);
    return true;
}

b8 IsMaterialBindNameLess(in StringView lhs, in StringView rhs){
    const usize minLen = min(lhs.size(), rhs.size());
    for(usize i = 0u; i < minLen; ++i){
        const u8 a = cast<u8>(lhs[i]);
        const u8 b = cast<u8>(rhs[i]);
        if(a != b)
            return a < b;
    }
    return lhs.size() < rhs.size();
}

Expected<MaterialBlockClass> ParseMaterialBindBlockClass(in MaterialBindStruct bindStruct){
    if(bindStruct.hasAttribute(s_MaterialConstantAttribute))
        return MaterialBlockClass::MaterialConstant;
    if(bindStruct.hasAttribute(s_MaterialMutableAttribute))
        return MaterialBlockClass::MaterialMutable;
    return makeUnexpected(Failure());
}

b8 BuildSortedMaterialBindInstanceIndices(
    in StringView interfaceVirtualPath,
    in Name contextName,
    in Span<MaterialBindInstance> instances,
    mut Vector<usize> outSortedIndices
){
    outSortedIndices.clear();
    if(instances.size() > cast<usize>(u32.max)){
        error("Material bind typed layout: interface '{}' exceeds supported block count for '{}'", interfaceVirtualPath, contextName.resolvedText());
        return false;
    }
    outSortedIndices.reserve(instances.size());
    for(usize i = 0u; i < instances.size(); ++i){
        usize insertPos = outSortedIndices.size();
        outSortedIndices.push_back(i);
        while(insertPos > 0u && IsMaterialBindNameLess(instances[i].name, instances[outSortedIndices[insertPos - 1u]].name)){
            outSortedIndices[insertPos] = outSortedIndices[insertPos - 1u];
            --insertPos;
        }
        outSortedIndices[insertPos] = i;
    }
    return true;
}

b8 AccumulateMaterialBindStructLayoutReserve(
    in StringView interfaceVirtualPath,
    in Name contextName,
    in MaterialBindStruct bindStruct,
    mut usize inOutFieldReserveCount,
    mut usize inOutByteReserveCount
){
    if(inOutFieldReserveCount > usize.max - bindStruct.fields.size()){
        error("Material bind typed layout: interface '{}' exceeds supported field count for '{}'", interfaceVirtualPath, contextName.resolvedText());
        return false;
    }
    inOutFieldReserveCount += bindStruct.fields.size();

    for(in MaterialBindField bindField : bindStruct.fields){
        usize fieldByteReserve = 16u;
        const Expected<MaterialLayoutFieldType> fieldType = TryParseMaterialLayoutFieldTypeText(bindField.type);
        if(fieldType.has_value()){
            const u32 fieldByteSize = MaterialLayoutFieldByteSize(fieldType.value());
            if(fieldByteSize != 0u)
                fieldByteReserve = cast<usize>(fieldByteSize);
        }

        if(inOutByteReserveCount > usize.max - fieldByteReserve){
            error("Material bind typed layout: interface '{}' exceeds supported byte count for '{}'", interfaceVirtualPath, contextName.resolvedText());
            return false;
        }
        inOutByteReserveCount += fieldByteReserve;
    }
    return true;
}

b8 ReserveMaterialBindTypedLayoutStorage(
    in StringView interfaceVirtualPath,
    in Name contextName,
    in Span<MaterialBindStruct> structs,
    in Span<MaterialBindInstance> instances,
    in Span<usize> sortedInstanceIndices,
    mut Vector<MaterialTypedLayoutBlock> outBlocks,
    mut Vector<MaterialTypedLayoutField> outFields,
    mut Vector<u8> outBlockBytes
){
    usize fieldReserveCount = 0u;
    usize byteReserveCount = 0u;
    for(in usize instanceIndex : sortedInstanceIndices){
        const Expected<usize> structIndex = FindMaterialBindStructIndex(structs, instances[instanceIndex].type);
        if(!structIndex.has_value())
            continue;
        if(!AccumulateMaterialBindStructLayoutReserve(
            interfaceVirtualPath,
            contextName,
            structs[structIndex.value()],
            fieldReserveCount,
            byteReserveCount
        ))
            return false;
    }

    outBlocks.reserve(sortedInstanceIndices.size());
    outFields.reserve(fieldReserveCount);
    outBlockBytes.reserve(byteReserveCount);
    return true;
}

b8 InsertMaterialBindInstanceParameterLookupEntries(
    in StringView interfaceVirtualPath,
    in StringView contextLabel,
    in MaterialBindInstance instance,
    in MaterialBindStruct bindStruct,
    in HashMap<Name, MaterialBindTypedLayoutBlockLookupEntry> blockLookup,
    in Span<MaterialTypedLayoutBlock> typedLayoutBlocks,
    in Span<MaterialTypedLayoutField> typedLayoutFields,
    mut HashMap<CompactString, MaterialBindTypedLayoutParameterLookupEntry> outParameterLookup
){
    const Expected<Name> instanceName = TryParseMaterialBindName(instance.name);
    assert(instanceName.has_value());
    assert(blockLookup.contains(instanceName.value()));
    const MaterialBindTypedLayoutBlockLookupEntry blockEntry = blockLookup.at(instanceName.value());
    assert(cast<usize>(blockEntry.blockIndex) < typedLayoutBlocks.size());

    const MaterialTypedLayoutBlock block = typedLayoutBlocks[cast<usize>(blockEntry.blockIndex)];
    assert(cast<usize>(block.fieldCount) == bindStruct.fields.size());

    for(u32 fieldOffset = 0u; fieldOffset < block.fieldCount; ++fieldOffset){
        const usize fieldIndex = cast<usize>(block.fieldBegin) + cast<usize>(fieldOffset);
        assert(fieldIndex < typedLayoutFields.size());
        if(!TryInsertMaterialBindTypedLayoutParameterLookupEntry(
            interfaceVirtualPath,
            contextLabel,
            instance.name,
            bindStruct.name,
            bindStruct.fields[cast<usize>(fieldOffset)].name,
            blockEntry,
            block,
            fieldIndex,
            typedLayoutFields[fieldIndex],
            outParameterLookup
        ))
            return false;
    }
    return true;
}

b8 BuildMaterialBindTypedLayoutParameterLookup(
    in StringView interfaceVirtualPath,
    in StringView contextLabel,
    in Span<MaterialBindStruct> structs,
    in Span<MaterialBindInstance> instances,
    in HashMap<Name, MaterialBindTypedLayoutBlockLookupEntry> blockLookup,
    in Span<MaterialTypedLayoutBlock> typedLayoutBlocks,
    in Span<MaterialTypedLayoutField> typedLayoutFields,
    mut HashMap<CompactString, MaterialBindTypedLayoutParameterLookupEntry> outParameterLookup
){
    outParameterLookup.clear();
    outParameterLookup.reserve(typedLayoutFields.size());

    for(in MaterialBindInstance instance : instances){
        const Expected<usize> structIndex = FindMaterialBindStructIndex(structs, instance.type);
        assert(structIndex.has_value());
        if(!InsertMaterialBindInstanceParameterLookupEntries(
            interfaceVirtualPath,
            contextLabel,
            instance,
            structs[structIndex.value()],
            blockLookup,
            typedLayoutBlocks,
            typedLayoutFields,
            outParameterLookup
        ))
            return false;
    }

    return true;
}

b8 AppendMaterialBindInstanceTypedLayoutBlock(
    in StringView interfaceVirtualPath,
    in Name contextName,
    in MaterialBindInstance instance,
    in MaterialBindStruct bindStruct,
    mut u32 inOutConstantTypedByteSize,
    mut Vector<MaterialTypedLayoutBlock> outBlocks,
    mut Vector<MaterialTypedLayoutField> outFields,
    mut Vector<u8> outBlockBytes
){
    const Expected<MaterialBlockClass> blockClassResult = ParseMaterialBindBlockClass(bindStruct);
    if(!blockClassResult.has_value()){
        error(
            "Material bind typed layout: interface '{}' struct '{}' is missing a material block class for '{}'"
            , interfaceVirtualPath
            , bindStruct.name
            , contextName.resolvedText()
        );
        return false;
    }

    const MaterialBlockClass blockClass = blockClassResult.value();
    if(outFields.size() > cast<usize>(u32.max) || bindStruct.fields.size() > cast<usize>(u32.max)){
        error(
            "Material bind typed layout: interface '{}' block '{}' exceeds supported field count for '{}'"
            , interfaceVirtualPath
            , instance.name
            , contextName.resolvedText()
        );
        return false;
    }

    const usize blockByteBegin = outBlockBytes.size();

    MaterialTypedLayoutBlock block;
    const Expected<Name> blockName = TryParseMaterialBindName(instance.name);
    if(!blockName.has_value()){
        error("Material bind typed layout: interface '{}' has invalid block '{}' for '{}'", interfaceVirtualPath, instance.name, contextName.resolvedText());
        return false;
    }
    block.blockName = blockName.value();
    block.blockClass = blockClass;
    block.fieldBegin = cast<u32>(outFields.size());
    block.fieldCount = cast<u32>(bindStruct.fields.size());
    block.byteSize = 0u;

    for(in MaterialBindField bindField : bindStruct.fields){
        if(!TryAppendMaterialBindTypedLayoutField(
            interfaceVirtualPath,
            contextName,
            instance.name,
            bindField.name,
            bindField.type,
            bindField.defaultArgument(),
            blockClass,
            blockByteBegin,
            block.byteSize,
            outFields,
            outBlockBytes
        ))
            return false;
    }

    return TryFinalizeMaterialBindTypedLayoutBlock(
        interfaceVirtualPath,
        contextName,
        instance.name,
        blockByteBegin,
        block,
        inOutConstantTypedByteSize,
        outBlocks,
        outBlockBytes
    );
}

b8 BuildMaterialBindTypedLayoutData(
    in StringView interfaceVirtualPath,
    in Name contextName,
    in Span<MaterialBindStruct> structs,
    in Span<MaterialBindInstance> instances,
    mut u64 outLayoutHash,
    mut Vector<MaterialTypedLayoutBlock> outBlocks,
    mut Vector<MaterialTypedLayoutField> outFields,
    mut Vector<u8> outBlockBytes,
    mut HashMap<Name, MaterialBindTypedLayoutBlockLookupEntry> outBlockLookup,
    mut HashMap<CompactString, MaterialBindTypedLayoutParameterLookupEntry> outParameterLookup
){
    outLayoutHash = 0u;
    outBlocks.clear();
    outFields.clear();
    outBlockBytes.clear();
    outBlockLookup.clear();
    outParameterLookup.clear();

    Vector<usize> sortedInstanceIndices;
    if(!BuildSortedMaterialBindInstanceIndices(interfaceVirtualPath, contextName, instances, sortedInstanceIndices))
        return false;
    if(!ReserveMaterialBindTypedLayoutStorage(interfaceVirtualPath, contextName, structs, instances, sortedInstanceIndices, outBlocks, outFields, outBlockBytes))
        return false;

    u32 constantTypedByteSize = 0u;
    for(in usize instanceIndex : sortedInstanceIndices){
        const Expected<usize> structIndex = FindMaterialBindStructIndex(structs, instances[instanceIndex].type);
        if(!structIndex.has_value()){
            error(
                "Material bind typed layout: interface '{}' instance '{}' references unknown struct type '{}' for '{}'"
                , interfaceVirtualPath
                , instances[instanceIndex].name
                , instances[instanceIndex].type
                , contextName.resolvedText()
            );
            return false;
        }
        if(!AppendMaterialBindInstanceTypedLayoutBlock(
            interfaceVirtualPath,
            contextName,
            instances[instanceIndex],
            structs[structIndex.value()],
            constantTypedByteSize,
            outBlocks,
            outFields,
            outBlockBytes
        ))
            return false;
    }

    outLayoutHash = ComputeMaterialTypedLayoutHash(outBlocks, outFields);
    if(outLayoutHash == 0u){
        error("Material bind typed layout: interface '{}' produced an empty layout for '{}'", interfaceVirtualPath, contextName.resolvedText());
        return false;
    }

    const Expected<usize> expectedBlockByteSize = ComputeMaterialTypedBlockByteSize(outBlocks);
    if(!expectedBlockByteSize.has_value() || expectedBlockByteSize.value() != outBlockBytes.size()){
        error("Material bind typed layout: interface '{}' has inconsistent block storage for '{}'", interfaceVirtualPath, contextName.resolvedText());
        return false;
    }

    if(!BuildMaterialBindTypedLayoutBlockLookup(contextName.resolvedText(), outBlocks, outBlockLookup))
        return false;
    return BuildMaterialBindTypedLayoutParameterLookup(
        interfaceVirtualPath,
        contextName.resolvedText(),
        structs,
        instances,
        outBlockLookup,
        outBlocks,
        outFields,
        outParameterLookup
    );
}

b8 AppendMaterialBindLayoutConstants(
    in StringView includePath,
    in Span<MaterialBindInstance> instances,
    in Name interfaceName,
    in u64 layoutHash,
    in Span<MaterialTypedLayoutBlock> typedLayoutBlocks,
    in usize typedLayoutFieldCount,
    in HashMap<Name, MaterialBindTypedLayoutBlockLookupEntry> blockLookup,
    mut HashSet<String> inOutSymbols,
    mut String inOutSource
){
    if(!AppendMaterialBindGlobalLayoutConstants(
        includePath,
        interfaceName,
        layoutHash,
        typedLayoutBlocks,
        typedLayoutFieldCount,
        inOutSymbols,
        inOutSource
    ))
        return false;

    assert(instances.size() == typedLayoutBlocks.size());

    for(in MaterialBindInstance instance : instances){
        const Expected<Name> instanceName = TryParseMaterialBindName(instance.name);
        assert(instanceName.has_value());
        assert(blockLookup.contains(instanceName.value()));
        const MaterialBindTypedLayoutBlockLookupEntry blockEntry = blockLookup.at(instanceName.value());
        assert(cast<usize>(blockEntry.blockIndex) < typedLayoutBlocks.size());
        if(!AppendMaterialBindBlockLayoutConstants(
            includePath,
            instance.name,
            typedLayoutBlocks,
            blockEntry.blockIndex,
            inOutSymbols,
            inOutSource
        ))
            return false;
    }

    return true;
}

b8 AppendMaterialBindGeneratedInstance(
    in StringView includePath,
    in MaterialBindInstance instance,
    in MaterialBindStruct bindStruct,
    in Span<MaterialTypedLayoutBlock> typedLayoutBlocks,
    in Span<MaterialTypedLayoutField> typedLayoutFields,
    in HashMap<Name, MaterialBindTypedLayoutBlockLookupEntry> blockLookup,
    mut HashSet<String> inOutSymbols,
    mut String inOutSource
){
    inOutSource.push_back('\n');
    AppendMaterialBindGeneratedSeparator(s_MaterialBindGeneratedSeparatorNewlineCount, inOutSource);

    const Expected<Name> instanceName = TryParseMaterialBindName(instance.name);
    assert(instanceName.has_value());
    assert(blockLookup.contains(instanceName.value()));
    const MaterialBindTypedLayoutBlockLookupEntry blockEntry = blockLookup.at(instanceName.value());
    assert(cast<usize>(blockEntry.blockIndex) < typedLayoutBlocks.size());

    const MaterialTypedLayoutBlock layoutBlock = typedLayoutBlocks[cast<usize>(blockEntry.blockIndex)];
    assert(cast<usize>(layoutBlock.fieldCount) == bindStruct.fields.size());

    const u32 layoutBlockStorageByteBegin = ComputeMaterialBindBlockStorageByteBegin(typedLayoutBlocks, blockEntry.blockIndex);
    for(u32 fieldOffset = 0u; fieldOffset < layoutBlock.fieldCount; ++fieldOffset){
        const usize layoutFieldIndex = cast<usize>(layoutBlock.fieldBegin) + cast<usize>(fieldOffset);
        assert(layoutFieldIndex < typedLayoutFields.size());

        const usize fieldIndex = cast<usize>(fieldOffset);
        const MaterialTypedLayoutField layoutField = typedLayoutFields[layoutFieldIndex];
        if(!AppendMaterialBindGeneratedInstanceField(
            includePath,
            instance.name,
            bindStruct.fields[fieldIndex].name,
            bindStruct.fields[fieldIndex].type,
            bindStruct.fields[fieldIndex].defaultArgument(),
            layoutBlock.blockClass,
            layoutBlockStorageByteBegin,
            layoutField,
            inOutSymbols,
            inOutSource
        ))
            return false;
    }

    const String blockFunctionName = BuildMaterialBindAccessorName(instance.name);
    if(!RegisterGeneratedMaterialBindSymbol(includePath, blockFunctionName, inOutSymbols))
        return false;

    AppendMaterialBindBlockAccessorHeader(bindStruct.name, blockFunctionName, inOutSource);
    for(in MaterialBindField field : bindStruct.fields){
        if(TryParseMaterialBindResourceFieldTypeText(field.type).has_value())
            continue;

        const String functionName = BuildMaterialBindAccessorName(instance.name, field.name);
        AppendMaterialBindBlockAccessorFieldAssign(field.name, functionName, inOutSource);
    }
    AppendMaterialBindBlockAccessorFooter(inOutSource);

    return true;
}

b8 BuildMaterialBindIncludeSourceFromData(
    in StringView entrySource,
    in StringView entryVirtualPath,
    in Span<MaterialBindStruct> structs,
    in Span<MaterialBindInstance> instances,
    mut String outSource
){
    outSource.clear();
    if(entryVirtualPath.empty()){
        error("Material bind include generation failed: virtual path is empty for '{}'", entrySource);
        return false;
    }

    String includePath = "";
    includePath.reserve(entryVirtualPath.size() + s_MaterialBindSourceExtensionText.size());
    includePath.append(entryVirtualPath);
    includePath.append(s_MaterialBindSourceExtensionText);

    const String includeGuard = BuildMaterialBindIncludeGuard(includePath);
    const Expected<Name> interfaceName = TryParseMaterialBindName(entryVirtualPath);
    if(!interfaceName.has_value())
        return false;

    u64 layoutHash = 0u;
    Vector<MaterialTypedLayoutBlock> typedLayoutBlocks;
    Vector<MaterialTypedLayoutField> typedLayoutFields;
    Vector<u8> typedBlockBytes;
    HashMap<Name, MaterialBindTypedLayoutBlockLookupEntry> blockLookup;
    HashMap<CompactString, MaterialBindTypedLayoutParameterLookupEntry> parameterLookup;
    if(!BuildMaterialBindTypedLayoutData(
        entryVirtualPath,
        interfaceName.value(),
        structs,
        instances,
        layoutHash,
        typedLayoutBlocks,
        typedLayoutFields,
        typedBlockBytes,
        blockLookup,
        parameterLookup
    ))
        return false;

    HashSet<String> generatedSymbols;
    AppendMaterialBindIncludeHeader(includeGuard, outSource);

    if(!AppendMaterialBindLayoutConstants(
        includePath,
        instances,
        interfaceName.value(),
        layoutHash,
        typedLayoutBlocks,
        typedLayoutFields.size(),
        blockLookup,
        generatedSymbols,
        outSource
    ))
        return false;

    outSource.push_back('\n');
    AppendMaterialBindGeneratedSeparator(s_MaterialBindGeneratedSeparatorNewlineCount, outSource);

    usize estimatedStructBytes = 0u;
    for(in MaterialBindStruct bindStruct : structs){
        estimatedStructBytes += bindStruct.name.size() + s_MaterialBindGeneratedStructReserveBytes;
        for(in MaterialBindField bindField : bindStruct.fields)
            estimatedStructBytes += bindField.type.size() + bindField.name.size() + s_MaterialBindGeneratedFieldReserveBytes;
    }
    for(in MaterialBindInstance bindInstance : instances)
        estimatedStructBytes += bindInstance.type.size() + bindInstance.name.size() + s_MaterialBindGeneratedInstanceReserveBytes;
    outSource.reserve(outSource.size() + estimatedStructBytes);

    for(in MaterialBindStruct bindStruct : structs){
        if(!RegisterGeneratedMaterialBindSymbol(includePath, bindStruct.name, generatedSymbols))
            return false;

        AppendMaterialBindStructHeader(bindStruct.name, outSource);
        for(in MaterialBindField field : bindStruct.fields){
            if(TryParseMaterialBindResourceFieldTypeText(field.type).has_value())
                continue;

            AppendMaterialBindStructField(field.type, field.name, outSource);
        }
        AppendMaterialBindStructFooter(outSource);
    }

    for(in MaterialBindInstance instance : instances){
        const Expected<usize> structIndex = FindMaterialBindStructIndex(structs, instance.type);
        assert(structIndex.has_value());
        if(!AppendMaterialBindGeneratedInstance(
            includePath,
            instance,
            structs[structIndex.value()],
            typedLayoutBlocks,
            typedLayoutFields,
            blockLookup,
            generatedSymbols,
            outSource
        ))
            return false;
    }

    AppendMaterialBindIncludeFooter(outSource);
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
