#include <impl/ecs_render/reflection/push_constants.adhd>
#include <impl/ecs_render/reflection/feedback_resources.adhd>
#include <impl/ecs_render/reflection/postprocess_resources.adhd>
#include <impl/ecs_render/reflection/reflection_pipelines.adhd>
#include <impl/ecs_render/kernel/compute_pipeline_utils.adhd>
#include <impl/ecs_render/kernel/descriptor_register_utils.adhd>
#include <impl/ecs_render/kernel/timing_names.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ReflectionFeedbackExtentOrDeviceChanged(
    in u32 width,
    in u32 height,
    in u16 deviceGeneration,
    in u32 cachedWidth,
    in u32 cachedHeight,
    in u16 cachedDeviceGeneration
){
    return width != cachedWidth || height != cachedHeight || deviceGeneration != cachedDeviceGeneration;
}

b8 IsReflectionFeedbackActive(in b8 enabled, in b8 hybridTraceMode, in u32 maxHardwareRaysPerFrame){
    return enabled && hybridTraceMode && maxHardwareRaysPerFrame > 0u;
}

b8 IsReflectionSpatialFilterActive(in b8 spatialFilterEnabled, in u32 spatialRadius, in u32 maxSpatialRadius, in b8 traceActive){
    return spatialFilterEnabled && spatialRadius > 0u && spatialRadius <= maxSpatialRadius && traceActive;
}

u32 ReflectionSpatialRadiusPipelineIndex(in u32 spatialRadius){
    return spatialRadius - 1u;
}

b8 CanPrepareReflectionHardwarePipelines(in b8 prepareHardware, in b8 rayQuerySupported, in b8 hasAccelStructLayout){
    return prepareHardware && rayQuerySupported && hasAccelStructLayout;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 PrepareReflectionPipeline(
    mut RendererShaderSystem shaders,
    mut Device device,
    mut ComputePipelineHandle pipeline,
    mut ShaderHandle shader,
    in ReflectionComputeShaderSelector selector,
    in Name debugName,
    in b8 hardware,
    in BindingLayoutHandle layout,
    in StringView variant
){
    if(pipeline.valid())
        return true;
    return shaders.loadShader<ComputeShader, ReflectionSubsystem>(selector, variant, debugName, shader) && CreateHeapComputePipeline(device, shader, layout, hardware, pipeline);
}

[cpp_unwind]
void RendererReflectionFeedback::invalidateResources(){
    if(this.m_control.valid())
        this.m_control.deref().reset(0u);
    this.releaseBuffers();
    this.m_extent = ReflectionFeedbackExtent();
    this.m_deviceGeneration = 0u;
}

[cpp_unwind]
b8 RendererReflectionFeedback::prepareResources(in u32 width, in u32 height, in ReflectionSettings settings, in b8 enabled){
    const Expected<ReflectionFeedbackExtent> extentResult = TryComputeReflectionFeedbackExtent(width, height);
    if(!extentResult.has_value()){
        error("Reflection feedback: invalid extent or feedback address range ({}x{})", width, height);
        return false;
    }
    in ReflectionFeedbackExtent extent = extentResult.value();
    mut Device device = this.m_graphics.getDevice();
    const u16 deviceGeneration = device.getDeviceGeneration();
    if(!this.m_control.valid()){
        auto controlResult = this.m_versions.make<ReflectionFeedbackState>(deviceGeneration);
        if(!controlResult.has_value()){
            error("Reflection feedback: failed to allocate acceptance control");
            return false;
        }
        this.m_control = controlResult.value();
    }
    const b8 changed = ReflectionFeedbackExtentOrDeviceChanged(width, height, deviceGeneration, this.m_extent.width, this.m_extent.height, this.m_deviceGeneration);
    const b8 active = IsReflectionFeedbackActive(enabled, settings.traceMode == ReflectionTraceMode::Hybrid, settings.maxHardwareRaysPerFrame);
    if(active && (changed || !this.m_banks[0].valid() || !this.m_banks[1].valid())){
        auto firstBank = this.prepareBank(extent.byteCount, s_ReflectionScreenFeedback0Name);
        if(!firstBank.has_value())
            return false;
        mut GpuDescriptorHeap heap = device.getDescriptorHeap();
        GpuDescriptorRetirementGuard retireFirst(heap, firstBank.value().descriptor);
        auto secondBank = this.prepareBank(extent.byteCount, s_ReflectionScreenFeedback1Name);
        if(!secondBank.has_value())
            return false;
        GpuDescriptorRetirementGuard retireSecond(heap, secondBank.value().descriptor);
        this.releaseBuffers();
        this.m_banks[0] = firstBank.value();
        this.m_banks[1] = secondBank.value();
        retireFirst.release();
        retireSecond.release();
    }
    else if(changed)
        this.releaseBuffers();
    if(changed)
        this.m_control.deref().reset(deviceGeneration);
    this.m_extent = extent;
    this.m_deviceGeneration = deviceGeneration;
    return true;
}

ReflectionFeedbackSnapshot RendererReflectionFeedback::snapshot(in ReflectionSceneContentStamp stamp, in ReflectionSettings settings, in b8 enabled, in u64 graphicsFrameIndex)const{
    ReflectionFeedbackSnapshot result;
    if(!this.m_control.valid())
        return result;
    result.control = this.m_control;
    result.plan = this.m_control.deref().plan(stamp, settings, enabled, graphicsFrameIndex);
    result.extent = this.m_extent;
    result.current = this.m_banks[result.plan.currentBank];
    result.previous = this.m_banks[result.plan.previousBank];
    return result;
}

[cpp_unwind]
void RendererReflectionFeedback::releaseBuffers(){
    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
    for(mut ReflectionFeedbackBinding bank : this.m_banks){
        if(bank.descriptor.valid() && heap.isInitialized())
            heap.free(bank.descriptor);
        bank = ReflectionFeedbackBinding();
    }
}

[cpp_unwind]
Expected<ReflectionFeedbackBinding> RendererReflectionFeedback::prepareBank(in u32 byteCount, in Name name){
    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized()){
        error("Reflection feedback: descriptor heap is unavailable during preflight");
        return MakeUnexpected(Failure());
    }
    BufferDesc desc;
    desc.setByteSize(byteCount).setCanHaveRawViews(true).setCanHaveUAVs(true).setDebugName(name).enableAutomaticStateTracking(ResourceStates::Common);
    auto bufferResult = this.m_graphics.createBuffer(desc);
    if(!bufferResult.has_value()){
        error("Reflection feedback: failed to create {}-byte buffer", byteCount);
        return MakeUnexpected(Failure());
    }
    BufferHandle buffer = bufferResult.value();
    const Expected<GpuDescriptorHandle> descriptor = RegisterDescriptor(heap, GpuDescriptorClass::StorageBuffer, DescriptorWriteItemRawBufferUav(0u, buffer.deref()));
    if(!descriptor.has_value()){
        error("Reflection feedback: failed to register storage buffer");
        return MakeUnexpected(Failure());
    }
    return ReflectionFeedbackBinding(buffer, descriptor.value());
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
void RendererReflectionPostprocess::invalidateResources(){
    this.releaseTargets();
    this.m_temporalPipeline.reset();
    for(mut ComputePipelineHandle pipeline : this.m_spatialPipelines)
        pipeline.reset();
    this.m_temporalShader.reset();
    for(mut ShaderHandle shader : this.m_spatialShaders)
        shader.reset();
    this.m_layout.reset();
}

[cpp_unwind]
b8 RendererReflectionPostprocess::prepareResources(in u32 width, in u32 height, in ReflectionSettings settings){
    if(settings.spatialRadius > s_ReflectionShaderSpatialMaxRadius)
        return false;
    mut Device device = this.m_graphics.getDevice();
    if(width != this.m_width || height != this.m_height){
        this.releaseTargets();
        this.m_width = width;
        this.m_height = height;
        if(this.m_control.valid())
            this.m_control.deref().reset(device.getDeviceGeneration());
    }
    if(!this.m_control.valid()){
        auto controlResult = this.m_versions.make<ReflectionHistoryState>(device.getDeviceGeneration());
        if(!controlResult.has_value()){
            error("Reflection history: failed to allocate acceptance control");
            return false;
        }
        this.m_control = controlResult.value();
    }
    const b8 active = settings.traceMode != ReflectionTraceMode::Disabled;
    if(settings.temporalEnabled && active){
        if(
            !this.preparePipeline(lambda[](in ReflectionSubsystem s) -> AssetRef<ComputeShader>{ return s.temporalCs; }, s_ShaderArchiveDefaultVariant, this.m_temporalPipeline, this.m_temporalShader)
            || !this.prepareImage(this.m_history, s_ReflectionHistoryDescriptorIndex, s_ReflectionOpaqueHistoryName)
            || !this.m_graphics.gpuTiming().prepareScopeQueries(s_TimingScopeReflectionTemporal.identity, device, s_ReflectionGpuTimingQueriesPerRange)
        )
            return false;
    }
    if(IsReflectionSpatialFilterActive(settings.spatialFilterEnabled, settings.spatialRadius, s_ReflectionShaderSpatialMaxRadius, active)){
        const u32 radiusIndex = ReflectionSpatialRadiusPipelineIndex(settings.spatialRadius);
        if(
            !this.preparePipeline(lambda[](in ReflectionSubsystem s) -> AssetRef<ComputeShader>{ return s.spatialCs; }, ResolveReflectionSpatialVariant(radiusIndex), this.m_spatialPipelines[radiusIndex], this.m_spatialShaders[radiusIndex])
            || !this.prepareImage(this.m_spatial, s_ReflectionSpatialDescriptorIndex, s_ReflectionOpaqueSpatialName)
            || !this.m_graphics.gpuTiming().prepareScopeQueries(s_TimingScopeReflectionSpatial.identity, device, s_ReflectionGpuTimingQueriesPerRange)
        )
            return false;
    }
    return true;
}

ReflectionPostprocessSnapshot RendererReflectionPostprocess::snapshot(in ReflectionRadianceBinding base, in ReflectionSceneContentStamp stamp, in ReflectionSettings settings, in u64 graphicsFrameIndex)const{
    ReflectionPostprocessSnapshot result;
    if(!this.m_control.valid())
        return result;
    result.control = this.m_control;
    result.history = this.m_control.deref().plan(stamp, settings, graphicsFrameIndex);
    result.current = base;
    if(result.history.currentBank != 0u)
        result.current = this.m_history;
    result.previous = base;
    if(result.history.previousBank != 0u)
        result.previous = this.m_history;
    result.spatial = this.m_spatial;
    result.temporalPipeline = this.m_temporalPipeline;
    result.spatialEnabled = IsReflectionSpatialFilterActive(settings.spatialFilterEnabled, settings.spatialRadius, s_ReflectionShaderSpatialMaxRadius, settings.traceMode != ReflectionTraceMode::Disabled);
    if(result.spatialEnabled)
        result.spatialPipeline = this.m_spatialPipelines[ReflectionSpatialRadiusPipelineIndex(settings.spatialRadius)];
    return result;
}

[cpp_unwind]
void RendererReflectionPostprocess::releaseTargets(){
    if(this.m_control.valid())
        this.m_control.deref().reset(0u);
    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
    for(mut GpuDescriptorHandle descriptor : this.m_descriptors)
        RetireDescriptor(heap, descriptor);
    this.m_history = ReflectionRadianceBinding();
    this.m_spatial = ReflectionRadianceBinding();
    this.m_width = 0u;
    this.m_height = 0u;
}

[cpp_unwind]
b8 RendererReflectionPostprocess::preparePipeline(
    in ReflectionComputeShaderSelector selector,
    in StringView variant,
    mut ComputePipelineHandle pipeline,
    mut ShaderHandle shader
){
    const Name shaderName = this.m_shaders.resolveSubsystemAsset<ReflectionSubsystem, ComputeShader>(selector);
    return EnsurePushConstantComputePipeline<ReflectionSubsystem>(
        this.m_graphics.getDevice(),
        this.m_shaders,
        selector,
        variant,
        shaderName,
        s_ReflectionShaderTemporalPushBytes,
        false,
        this.m_layout,
        shader,
        pipeline
    );
}

[cpp_unwind]
b8 RendererReflectionPostprocess::prepareImage(mut ReflectionRadianceBinding image, in u32 descriptorIndex, in Name name){
    if(image.texture.valid())
        return true;
    TextureDesc desc;
    desc.setWidth(this.m_width).setHeight(this.m_height).setFormat(Format::RGBA16_FLOAT).setIsUAV(true).setName(name).setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute).setInitialState(ResourceStates::Common).setKeepInitialState(true);
    auto textureResult = this.m_graphics.createTexture(desc);
    if(!textureResult.has_value())
        return false;
    TextureHandle texture = textureResult.value();
    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
    const Expected<GpuDescriptorHandle> sampled = RegisterSampledTexture(heap, GpuDescriptorClass::SampledImage, texture);
    const Expected<GpuDescriptorHandle> storage = RegisterStorageTexture(heap, texture);
    if(!sampled.has_value() || !storage.has_value()){
        if(sampled.has_value())
            heap.free(sampled.value());
        if(storage.has_value())
            heap.free(storage.value());
        return false;
    }
    this.m_descriptors[descriptorIndex] = sampled.value();
    this.m_descriptors[descriptorIndex + 1u] = storage.value();
    image = ReflectionRadianceBinding(texture, sampled.value().slot(), storage.value().slot());
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 RendererReflectionPipelines::prepare(in b8 prepareHardware, in b8 prepareCsgHardware, mut ReflectionFrameSnapshot resources){
    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(
        !EnsurePushConstantBindingLayout(device, sizeof(u32), ShaderTypeMask::Compute, this.m_bindingLayout)
        || !EnsurePushConstantBindingLayout(device, s_ReflectionShaderDepthPushBytes, ShaderTypeMask::Compute, this.m_depthBindingLayout)
    )
        return false;
    if(
        !PrepareReflectionPipeline(this.m_shaders, device, resources.classifyPipeline, this.m_classifyShader, lambda[](in ReflectionSubsystem s) -> AssetRef<ComputeShader>{ return s.classifyCs; },
            Name(s_RenderNameECSRenderReflectionClassify), false, this.m_bindingLayout, s_ShaderArchiveDefaultVariant)
        || !PrepareReflectionPipeline(this.m_shaders, device, resources.buildArgsPipeline, this.m_buildArgsShader, lambda[](in ReflectionSubsystem s) -> AssetRef<ComputeShader>{ return s.buildArgsCs; },
            Name(s_RenderNameECSRenderReflectionBuildArgs), false, this.m_bindingLayout, s_ReflectionBuildArgsVariant)
        || !PrepareReflectionPipeline(this.m_shaders, device, resources.depthPyramid.pipeline, this.m_depthShader, lambda[](in ReflectionSubsystem s) -> AssetRef<ComputeShader>{ return s.depthReduceCs; },
            Name(s_RenderNameECSRenderReflectionDepthReduce), false, this.m_depthBindingLayout, s_ShaderArchiveDefaultVariant)
    )
        return false;
    const b8 rayQueryReady = CanPrepareReflectionHardwarePipelines(true, this.m_graphics.queryFeatureSupport(Feature::RayQuery), heap.hasAccelStructLayout());
    if(
        CanPrepareReflectionHardwarePipelines(prepareHardware, rayQueryReady, true)
        && (!PrepareReflectionPipeline(this.m_shaders, device, resources.hardwarePipeline, this.m_hardwareShader, lambda[](in ReflectionSubsystem s) -> AssetRef<ComputeShader>{ return s.resolveHwCs; },
            Name(s_RenderNameECSRenderReflectionOpticalHardware), true, this.m_bindingLayout, s_ReflectionHwOpticalVariant) || !PrepareReflectionPipeline(this.m_shaders, device,
            this.m_plainHardwarePipeline, this.m_plainHardwareShader,
            lambda[](in ReflectionSubsystem s) -> AssetRef<ComputeShader>{ return s.resolveHwCs; }, Name(s_RenderNameECSRenderReflectionHardware), true, this.m_bindingLayout,
            s_ReflectionHwPlainVariant
        ) || !PrepareReflectionPipeline(this.m_shaders, device, this.m_unspecifiedHardwarePipeline, this.m_unspecifiedHardwareShader,
            lambda[](in ReflectionSubsystem s) -> AssetRef<ComputeShader>{ return s.resolveHwCs; }, Name(s_RenderNameECSRenderReflectionUnspecifiedOpticalHardware), true, this.m_bindingLayout, s_ReflectionHwUnspecifiedVariant))
    )
        return false;
    const b8 csgHardware = CanPrepareReflectionHardwarePipelines(prepareCsgHardware, rayQueryReady, true);
    if(csgHardware && !EnsurePushConstantBindingLayout(device, s_ReflectionShaderCsgPushBytes, ShaderTypeMask::Compute, this.m_csgBindingLayout))
        return false;
    if(
        csgHardware
        && (!PrepareReflectionPipeline(this.m_shaders, device, this.m_csgBuildArgsPipeline, this.m_csgBuildArgsShader, lambda[](in ReflectionSubsystem s) -> AssetRef<ComputeShader>{ return s.buildArgsCs; },
            Name(s_RenderNameECSRenderReflectionCsgBuildArgs), false, this.m_csgBindingLayout, s_ReflectionCsgBuildArgsVariant) || !PrepareReflectionPipeline(this.m_shaders, device,
            this.m_csgHardwarePipeline, this.m_csgHardwareShader,
            lambda[](in ReflectionSubsystem s) -> AssetRef<ComputeShader>{ return s.resolveHwCs; }, Name(s_RenderNameECSRenderReflectionCsgOpticalHardware), true, this.m_csgBindingLayout,
            s_ReflectionHwCsgOpticalVariant
        ) || !PrepareReflectionPipeline(this.m_shaders, device, this.m_csgPlainHardwarePipeline, this.m_csgPlainHardwareShader, lambda[](in ReflectionSubsystem s) -> AssetRef<ComputeShader>{ return s.resolveHwCs; },
            Name(s_RenderNameECSRenderReflectionCsgHardware), true, this.m_csgBindingLayout, s_ReflectionHwCsgPlainVariant) || !PrepareReflectionPipeline(this.m_shaders, device,
            this.m_csgUnspecifiedHardwarePipeline, this.m_csgUnspecifiedHardwareShader,
            lambda[](in ReflectionSubsystem s) -> AssetRef<ComputeShader>{ return s.resolveHwCs; }, Name(s_RenderNameECSRenderReflectionCsgUnspecifiedOpticalHardware), true, this.m_csgBindingLayout,
            s_ReflectionHwCsgUnspecifiedVariant
        ))
    )
        return false;
    return true;
}

void RendererReflectionPipelines::invalidate(mut ReflectionFrameSnapshot resources){
    resources.classifyPipeline.reset();
    resources.buildArgsPipeline.reset();
    resources.hardwarePipeline.reset();
    resources.depthPyramid.pipeline.reset();
    this.m_classifyShader.reset();
    this.m_buildArgsShader.reset();
    this.m_hardwareShader.reset();
    this.m_plainHardwareShader.reset();
    this.m_plainHardwarePipeline.reset();
    this.m_unspecifiedHardwareShader.reset();
    this.m_unspecifiedHardwarePipeline.reset();
    this.m_csgBuildArgsShader.reset();
    this.m_csgBuildArgsPipeline.reset();
    this.m_csgHardwareShader.reset();
    this.m_csgPlainHardwareShader.reset();
    this.m_csgUnspecifiedHardwareShader.reset();
    this.m_csgHardwarePipeline.reset();
    this.m_csgPlainHardwarePipeline.reset();
    this.m_csgUnspecifiedHardwarePipeline.reset();
    this.m_depthShader.reset();
    this.m_bindingLayout.reset();
    this.m_depthBindingLayout.reset();
    this.m_csgBindingLayout.reset();
}


