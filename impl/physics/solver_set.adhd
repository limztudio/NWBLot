    }

    public void setLastConstraintForce(in VectorSingle v){
        this.lastForceConeSusp = f32x4(v, this.lastForceConeSusp.w);
    }

    public f32 coneOrSuspensionImpulse()const{
        return this.lastForceConeSusp.w;
    }

    public void setConeOrSuspensionImpulse(in f32 v){
        this.lastForceConeSusp.w = v;
    }

    public VectorSingle lastConstraintTorque()const{
        return VectorSingle(this.lastTorqueMotorSpeed, 0.0f);
    }

    public void setLastConstraintTorque(in VectorSingle v){
        this.lastTorqueMotorSpeed = f32x4(v, this.lastTorqueMotorSpeed.w);
    }

