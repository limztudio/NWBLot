#include <impl/ecs_ui/toolkit/text/atlas_types.adhd>

native{
#include <impl/ecs_ui/toolkit/text/font.adhd.h>
#include <impl/ecs_ui/toolkit/text/glyph_page.adhd.h>

#include <global/atomic_identity.h>
#include <global/containers.h>
#include <global/hash_utils.h>
#include <global/termination.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_UI_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using AtlasGlyph = AtlasGlyphRecord<SharedFontFace>;

struct AtlasPage{
    SharedFontFace face;
    GlyphPage::Pixels pixels;
    SharedGlyphPage published;
    u32 cursorX = 0u;
    u32 cursorY = 0u;
    u32 rowHeight = 0u;
    b8 dirty = false;
    u64 generation = 0u;


public:
    AtlasPage(Core::Alloc::GlobalArena& arena, const SharedFontFace& font)
        : face(font)
        , pixels(arena)
    {
        pixels.resize(static_cast<usize>(s_GlyphAtlasPageExtent) * s_GlyphAtlasPageExtent, 0u);
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Only unused padded rectangles are written; page publication copies after a batch of mutations.
class GlyphAtlas final : NoCopy{
private:
    using Placement = GlyphAtlasPlacement;

    struct GlyphKey{
        SharedFontFace::pointer face = nullptr;
        u32 glyphId = 0u;
        u32 pixelSize = 0u;
    };

    struct GlyphKeyHasher{
        [[nodiscard]] usize operator()(const GlyphKey& key)const noexcept{
            usize seed = 0u;
            ::HashCombine(seed, key.face);
            ::HashCombine(seed, key.glyphId);
            ::HashCombine(seed, key.pixelSize);
            return seed;
        }
    };

    struct GlyphKeyEqualTo{
        [[nodiscard]] b8 operator()(const GlyphKey& lhs, const GlyphKey& rhs)const noexcept{
            return lhs.face == rhs.face && lhs.glyphId == rhs.glyphId && lhs.pixelSize == rhs.pixelSize;
        }
    };


private:
    using GlyphIndex = HashMap<GlyphKey, usize, Core::Alloc::GlobalArena, GlyphKeyHasher, GlyphKeyEqualTo>;


private:
    [[nodiscard]] static u64 NextAtlasIdentity()noexcept;


public:
    explicit GlyphAtlas(Core::Alloc::GlobalArena& arena);


public:
    void reset()noexcept;
    [[nodiscard]] b8 prepare(const SharedFontFace& face, u32 glyphId, u32 pixelSize);
    [[nodiscard]] const AtlasGlyph* find(const SharedFontFace& face, u32 glyphId, u32 pixelSize)const noexcept;
    [[nodiscard]] Expected<SharedGlyphPage> page(u32 index);

    [[nodiscard]] usize pageCount()const noexcept{ return m_pages.size(); }

    [[nodiscard]] usize glyphCount()const noexcept{ return m_glyphs.size(); }


private:
    [[nodiscard]] static Expected<Placement> TryPlace(u32 cursorX, u32 cursorY, u32 rowHeight, u32 width, u32 height)noexcept;
    void appendGlyph(AtlasGlyph&& record);


private:
    Core::Alloc::GlobalArena& m_arena;
    PaintVector<AtlasGlyph> m_glyphs;
    GlyphIndex m_index;
    PaintVector<AtlasPage> m_pages;
    GlyphBitmap m_bitmap;
    u64 m_identity = 0u;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_UI_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CanPackGlyphBitmapExtent(in u32 width, in u32 height){
    const u32 maxGlyphExtent = s_GlyphAtlasPageExtent - s_GlyphAtlasGlyphGutter;
    return width <= maxGlyphExtent && height <= maxGlyphExtent;
}

Rect MakePlacedGlyphAtlasPixelRect(in u32 placementX, in u32 placementY, in u32 width, in u32 height){
    return Rect(cast<f32>(placementX + 1u), cast<f32>(placementY + 1u), cast<f32>(width), cast<f32>(height));
}

GlyphAtlasPlacement MakeInitialGlyphAtlasPlacement(in u32 paddedHeight){
    GlyphAtlasPlacement placement;
    placement.x = 0u;
    placement.y = 0u;
    placement.rowHeight = paddedHeight;
    return placement;
}

Expected<GlyphPageBindingRecord<TFont>> TryMakeNextGlyphPageBinding<TFont>(
    in AssetRef<TFont> font,
    in u64 fontGeneration,
    in u64 atlasIdentity,
    in u64 currentGeneration,
    in u32 pageIndex
){
    if(currentGeneration == u64.max)
        return MakeUnexpected(Failure());
    GlyphPageBindingRecord<TFont> binding;
    binding.font = font;
    binding.fontGeneration = fontGeneration;
    binding.atlasIdentity = atlasIdentity;
    binding.generation = currentGeneration + 1u;
    binding.index = pageIndex;
    binding.width = s_GlyphAtlasPageExtent;
    binding.height = s_GlyphAtlasPageExtent;
    return binding;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


native{
NWB_IMPL_UI_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u64 GlyphAtlas::NextAtlasIdentity()noexcept{
    static Atomic<u64> s_NextAtlasIdentity{ 1u };
    return NextNonWrappingIdentity(s_NextAtlasIdentity);
}

GlyphAtlas::GlyphAtlas(Core::Alloc::GlobalArena& arena)
    : m_arena(arena)
    , m_glyphs(arena)
    , m_index(arena)
    , m_pages(arena)
    , m_bitmap(arena)
    , m_identity(NextAtlasIdentity())
{
    m_glyphs.reserve(s_GlyphAtlasMaxGlyphs);
    m_pages.reserve(s_GlyphAtlasMaxPages);
}

void GlyphAtlas::reset()noexcept{
    m_index.clear();
    m_glyphs.clear();
    m_pages.clear();
    m_identity = NextAtlasIdentity();
}

b8 GlyphAtlas::prepare(const SharedFontFace& face, const u32 glyphId, const u32 pixelSize){
    if(!face || !face->valid() || pixelSize == 0u)
        return false;
    if(find(face, glyphId, pixelSize))
        return true;
    if(m_glyphs.size() >= s_GlyphAtlasMaxGlyphs || !face->rasterize(glyphId, pixelSize, m_bitmap))
        return false;
    AtlasGlyph record;
    record.face = face;
    record.glyphId = glyphId;
    record.pixelSize = pixelSize;
    record.bearingX = m_bitmap.bearingX;
    record.bearingY = m_bitmap.bearingY;
    if(m_bitmap.width == 0u || m_bitmap.height == 0u){
        appendGlyph(Move(record));
        return true;
    }
    if(!CanPackGlyphBitmapExtent(m_bitmap.width, m_bitmap.height))
        return false;
    const u32 paddedWidth = m_bitmap.width + s_GlyphAtlasGlyphGutter;
    const u32 paddedHeight = m_bitmap.height + s_GlyphAtlasGlyphGutter;
    Placement placement;
    usize pageIndex = 0u;
    while(pageIndex < m_pages.size()){
        const AtlasPage& page = m_pages[pageIndex];
        if(page.face.get() == face.get()){
            const auto placed = TryPlace(page.cursorX, page.cursorY, page.rowHeight, paddedWidth, paddedHeight);
            if(placed){
                placement = *placed;
                break;
            }
        }
        ++pageIndex;
    }
    if(pageIndex == m_pages.size()){
        if(m_pages.size() >= s_GlyphAtlasMaxPages)
            return false;
        m_pages.emplace_back(m_arena, face);
        placement = MakeInitialGlyphAtlasPlacement(paddedHeight);
    }
    AtlasPage& page = m_pages[pageIndex];
    record.pageIndex = static_cast<u32>(pageIndex);
    record.pixels = MakePlacedGlyphAtlasPixelRect(placement.x, placement.y, m_bitmap.width, m_bitmap.height);
    CopyGlyphBitmapToAtlasPage(placement.x, placement.y, m_bitmap.width, m_bitmap.height, m_bitmap.pixels, page.pixels);
    page.cursorX = placement.x + paddedWidth;
    page.cursorY = placement.y;
    page.rowHeight = placement.rowHeight;
    page.dirty = true;
    appendGlyph(Move(record));
    return true;
}

const AtlasGlyph* GlyphAtlas::find(const SharedFontFace& face, const u32 glyphId, const u32 pixelSize)const noexcept{
    const auto found = m_index.find(GlyphKey{ face.get(), glyphId, pixelSize });
    return found == m_index.end() ? nullptr : &m_glyphs[found.value()];
}

Expected<SharedGlyphPage> GlyphAtlas::page(const u32 index){
    if(index >= m_pages.size())
        return MakeUnexpected(Failure{});
    AtlasPage& page = m_pages[index];
    if(page.dirty){
        const auto binding = TryMakeNextGlyphPageBinding<Font>(page.face->identity(), page.face->generation(), m_identity, page.generation, index);
        if(!binding)
            return MakeUnexpected(Failure{});
        GlyphPage::Pixels copy(m_arena);
        copy.assign(page.pixels.begin(), page.pixels.end());
        auto published = CreateGlyphPage(m_arena, *binding, Move(copy));
        if(!published)
            return MakeUnexpected(Failure{});
        page.published = Move(*published);
        ++page.generation;
        page.dirty = false;
    }
    return page.published;
}

Expected<GlyphAtlas::Placement> GlyphAtlas::TryPlace(const u32 cursorX, const u32 cursorY, const u32 rowHeight, const u32 width, const u32 height)noexcept{
    return TryPlaceGlyphAtlasBitmap(cursorX, cursorY, rowHeight, width, height);
}

void GlyphAtlas::appendGlyph(AtlasGlyph&& record){
    const GlyphKey key{ record.face.get(), record.glyphId, record.pixelSize };
    const usize index = m_glyphs.size();
    m_glyphs.push_back(Move(record));
    if(!m_index.emplace(key, index).second)
        TerminateInvariant();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_UI_END
}


