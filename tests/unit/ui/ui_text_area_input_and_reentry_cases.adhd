void VerifyUiTextAreaBuilderTests_SingleLineIsRejectedBeforeBorrowingOrChangingViewport(mut UiTextAreaBuilderTests self){
    self.useHost();
    EditModel singleLine = EditModel(self.m_arena);
    ASSERT_TRUE(singleLine.setText("single"));
    ASSERT_TRUE(self.m_state.scrollTo(Point(13.0f, 17.0f)));
    const u64 revision = self.m_state.revision();
    ASSERT_TRUE(self.beginArea(1u));
    const EditBoxResult result = self.m_builder.textArea(s_UiTextAreaWidgetKey, singleLine, self.m_state);
    EXPECT_FALSE(result.valid);
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_EQ(self.m_host.loans, 0u);
    EXPECT_EQ(self.m_state.revision(), revision);
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, 13.0f);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 17.0f);
    EXPECT_EQ(singleLine.text(), "single");
}

void VerifyUiTextAreaBuilderTests_UnsupportedNavigatedHostCannotFallBackToOrdinaryEdit(mut UiTextAreaBuilderTests self){
    UiTextAreaOrdinaryHost host = UiTextAreaOrdinaryHost();
    self.setEditHost(host);
    ASSERT_TRUE(self.beginArea(1u));
    const EditBoxResult result = self.m_builder.textArea(s_UiTextAreaWidgetKey, self.m_model, self.m_state);
    EXPECT_FALSE(result.valid);
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_EQ(host.ordinaryLoans, 0u);
    EXPECT_EQ(host.publishes, 0u);
}

void VerifyUiTextAreaBuilderTests_ReadOnlyNavigatedHostRejectsQueuedText(mut UiTextAreaBuilderTests self){
    self.useHost();
    ASSERT_TRUE(self.m_model.setText("first\nsecond"));
    TextAreaOptions options = TextAreaOptions();
    options.width = LayoutSize(LayoutSizePolicy::Fixed, 140.0f);
    options.height = LayoutSize(LayoutSizePolicy::Fixed, 60.0f);
    options.readOnly = true;
    self.m_host.text("ignored");
    ASSERT_TRUE(self.frameArea(1u, options));
    EXPECT_EQ(self.m_host.loans, 1u);
    EXPECT_EQ(self.m_host.ordinaryLoans, 0u);
    EXPECT_EQ(self.m_host.actionLoans, 0u);
    EXPECT_EQ(self.m_model.text(), "first\nsecond");
}

void VerifyUiTextAreaBuilderTests_RawPointerCapturePersistsOutsideWithoutGestureRecords(mut UiTextAreaBuilderTests self){
    ASSERT_TRUE(self.frameArea(1u));
    const WidgetId widget = self.id(s_UiTextAreaWidgetKey, s_UiTextAreaPanelKey);
    const auto foundArea = self.tryTarget(widget);
    ASSERT_TRUE(foundArea.has_value());
    const HitTarget area = foundArea.value();
    const VectorSingle originValue = VectorSingle(area.rectangle.x, area.rectangle.y, 0.0f, 0.0f) + VectorSingle(10.0f, 10.0f, 10.0f, 10.0f);
    const Point origin = Point(originValue.x, originValue.y);
    EXPECT_TRUE(self.send(MakeUiTextAreaPointerEvent(origin, InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_EQ(self.m_context.input().capture(), widget);
    EXPECT_TRUE(self.send(MakeUiTextAreaPointerEvent(Point(780.0f, 580.0f), InputEventType::PointerMove)).pointerConsumed);
    EXPECT_EQ(self.m_context.input().capture(), widget);
    EXPECT_TRUE(self.send(MakeUiTextAreaPointerEvent(Point(780.0f, 580.0f), InputEventType::PrimaryUp)).pointerConsumed);
    EXPECT_FALSE(self.m_context.input().capture().valid());
    EXPECT_FALSE(self.m_context.input().consumePointerGesture(widget, area.declarationGeneration).has_value());
}

void VerifyUiTextAreaBuilderTests_DisabledAreaRetainsAPointerBarrierAndDiscardsHostText(mut UiTextAreaBuilderTests self){
    self.useHost();
    ASSERT_TRUE(self.m_model.setText("first\nsecond"));
    self.m_host.text("ignored");
    TextAreaOptions options = TextAreaOptions();
    options.enabled = false;
    ASSERT_TRUE(self.frameArea(1u, options));
    const WidgetId widget = self.id(s_UiTextAreaWidgetKey, s_UiTextAreaPanelKey);
    const auto foundArea = self.tryTarget(widget);
    ASSERT_TRUE(foundArea.has_value());
    const HitTarget area = foundArea.value();
    EXPECT_FALSE(area.enabled || area.focusable || area.textEditable || area.pointerGesture);
    const VectorSingle pointValue = VectorSingle(area.rectangle.x, area.rectangle.y, 0.0f, 0.0f) + VectorSingle(5.0f, 5.0f, 5.0f, 5.0f);
    const Point point = Point(pointValue.x, pointValue.y);
    EXPECT_EQ(self.m_context.input().hitTest(point), RequireUiWidgetId(RequireUiRootId(self.m_root), s_UiTextAreaPanelKey));
    EXPECT_TRUE(self.send(MakeUiTextAreaPointerEvent(point, InputEventType::PrimaryDown)).pointerConsumed);
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_TRUE(self.send(MakeUiTextAreaPointerEvent(point, InputEventType::PrimaryUp)).pointerConsumed);
    EXPECT_FALSE(self.m_state.focused());
    EXPECT_EQ(self.m_model.text(), "first\nsecond");
    EXPECT_FALSE(self.m_model.canUndo());
}

void VerifyUiTextAreaBuilderTests_PopupAreaDefersPublicationUntilItsOwningPopupEnds(mut UiTextAreaBuilderTests self){
    self.useHost();
    PopupState popup = PopupState();
    popup.open();
    PopupOptions options = PopupOptions();
    options.anchor = Rect(20.0f, 20.0f, 40.0f, 20.0f);
    options.size = Point(300.0f, 240.0f);
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginPopup("popup", popup, options));
    const PopupToken token = self.m_context.popupToken();
    ASSERT_TRUE(self.m_builder.textArea(s_UiTextAreaWidgetKey, self.m_model, self.m_state).valid);
    EXPECT_EQ(self.m_host.lastPopup, token);
    EXPECT_EQ(self.m_host.publishes, 0u);
    ASSERT_TRUE(self.m_builder.endPopup());
    ASSERT_TRUE(self.m_context.endRoot());
    ASSERT_TRUE(self.m_context.finishFrame());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    ASSERT_EQ(self.m_host.publications.size(), 1u);
    EXPECT_EQ(self.m_host.publications[0u].popup, token);
}

void VerifyUiTextAreaBuilderTests_AcceptingActionsKeepTextAndHistoryThroughSubmitBlurAbandonAndCancel(mut UiTextAreaBuilderTests self){
    self.useHost();
    ASSERT_TRUE(self.m_model.setText("ab\ncd"));
    self.m_host.text("X");
    self.m_host.action(EditAction::Submit);
    self.m_host.text("Y");
    self.m_host.action(EditAction::Blur);
    self.m_host.action(EditAction::Abandon);
    self.m_host.action(EditAction::Cancel);
    ASSERT_TRUE(self.frameArea(1u));
    EXPECT_TRUE(self.m_result.submitted && self.m_result.blurred && self.m_result.abandoned && self.m_result.cancelled);
    EXPECT_FALSE(self.m_result.focused);
    EXPECT_EQ(self.m_model.text(), "ab\ncdXY");
    ASSERT_EQ(self.m_host.actionTexts.size(), 4u);
    EXPECT_EQ(UiTextAreaActionText(self.m_host.actionTexts[0u]), "ab\ncdX");
    EXPECT_EQ(UiTextAreaActionText(self.m_host.actionTexts[3u]), "ab\ncdXY");
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "ab\ncdX");
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "ab\ncd");
    EXPECT_FALSE(self.m_model.canUndo());
}

void VerifyUiTextAreaBuilderTests_OrderedHostUsesTheRealResolverAfterEarlierInsertedText(mut UiTextAreaBuilderTests self){
    self.useHost();
    ASSERT_TRUE(self.m_model.setText("aa\naaaa\nxx"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 1u));
    self.m_host.text("a");
    self.m_host.key(UiTextAreaKey::Down);
    self.m_host.text("!");
    ASSERT_TRUE(self.frameArea(1u));
    ASSERT_EQ(self.m_host.resolutions.size(), 1u);
    EXPECT_EQ(UiTextAreaResolutionText(self.m_host.resolutions[0u]), "aaa\naaaa\nxx");
    EXPECT_EQ(self.m_host.resolutions[0u].caret, 2u);
    ASSERT_TRUE(self.m_host.resolutions[0u].result.has_value());
    EXPECT_EQ(self.m_host.resolutions[0u].result.value().committedByte, 6u);
    EXPECT_EQ(self.m_model.text(), "aaa\naa!aa\nxx");
    EXPECT_EQ(self.m_model.caret(), 7u);
    ASSERT_EQ(self.m_host.publications.size(), 1u);
    EXPECT_EQ(UiTextAreaPublicationText(self.m_host.publications[0u]), "aaa\naa!aa\nxx");
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "aaa\naaaa\nxx");
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "aa\naaaa\nxx");
    EXPECT_FALSE(self.m_model.canUndo());
}

void VerifyUiTextAreaBuilderTests_BorrowedPreferredColumnSurvivesShortLineThenReturnsToLongLine(mut UiTextAreaBuilderTests self){
    self.useHost();
    ASSERT_TRUE(self.m_model.setText("aaaaaa\na\naaaaaa"));
    ASSERT_TRUE(self.m_model.setSelection(5u, 5u));
    EditBoxView reference = EditBoxView(self.m_arena);
    ASSERT_TRUE(reference.snapshot(self.m_model));
    ASSERT_EQ(reference.shape(self.m_text, MakeUiTextAreaFontSizeShapeRequest(14.0f)), TextLayoutStatus::Success);
    const auto caret = reference.caretGeometry().caretRect(reference.displayCaret());
    ASSERT_TRUE(caret.has_value());
    self.m_host.seedColumn = true;
    self.m_host.seededColumn = caret.value().x;
    self.m_host.key(UiTextAreaKey::Down);
    self.m_host.key(UiTextAreaKey::Down);
    ASSERT_TRUE(self.frameArea(1u));
    ASSERT_EQ(self.m_host.resolutions.size(), 2u);
    ASSERT_TRUE(self.m_host.resolutions[0u].result.has_value());
    EXPECT_EQ(self.m_host.resolutions[0u].result.value().committedByte, 8u);
    ASSERT_TRUE(self.m_host.resolutions[1u].result.has_value());
    EXPECT_EQ(self.m_host.resolutions[1u].result.value().committedByte, 14u);
    EXPECT_TRUE(self.m_host.resolutions[1u].preferred.valid);
    EXPECT_FLOAT_EQ(self.m_host.resolutions[1u].preferred.preferredX, caret.value().x);
    EXPECT_FLOAT_EQ(self.m_state.navigation().preferredX(), caret.value().x);
    EXPECT_EQ(self.m_model.caret(), 14u);
    EXPECT_FALSE(self.m_model.canUndo());
}


