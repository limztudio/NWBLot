inline constexpr AStringView s_PendingBucket = CrashNames::s_PendingDirectoryName;
inline constexpr AStringView s_UploadedBucket = CrashNames::s_UploadedDirectoryName;
inline constexpr AStringView s_FailedBucket = CrashNames::s_FailedDirectoryName;
inline constexpr AStringView s_UploadingBucket = CrashNames::s_UploadingDirectoryName;
inline constexpr AStringView s_ArchiveHeaderText = CrashNames::s_ArchiveHeaderText;
inline constexpr AStringView s_UploadAttemptFileName = CrashNames::s_UploadAttemptFileName;
inline constexpr AStringView s_RetryPendingState = CrashNames::s_UploadAttemptRetryPendingState;
inline constexpr AStringView s_RetryInterruptedState = CrashNames::s_UploadAttemptRetryInterruptedState;
inline constexpr u32 s_MaxCrashMetadata = static_cast<u32>(Core::Crash::CrashDetail::s_MaxMetadata);
inline constexpr u32 s_MaxCrashBreadcrumbs = static_cast<u32>(Core::Crash::CrashDetail::s_MaxBreadcrumbs);
inline constexpr u32 s_MaxCrashCallstackFrames = static_cast<u32>(Core::Crash::CrashDetail::s_MaxCallstackFrames);

template<usize N>
inline void CopyPathText(const CrashTestPath& path, GlobalArena& arena, Array<char, N>& outText){
    const AString<GlobalArena> text = PathToString<char>(arena, path);
    CopyFixedBuffer(outText, AStringView(text.data(), text.size()));
}

template<usize N>
inline void BuildCrashIdForProcess(const u32 processId, const u64 sequence, Array<char, N>& outCrashId)noexcept{
    CopyFixedBuffer(outCrashId, AStringView(CrashNames::s_CrashIdPrefix));
    AppendUnsignedToFixedBuffer(outCrashId, static_cast<u64>(processId));
    AppendFixedBuffer(outCrashId, "-");
    AppendUnsignedToFixedBuffer(outCrashId, sequence);
}

[[nodiscard]] Core::Crash::CrashDetail::PlatformKind::Enum CurrentCrashPlatformKind()noexcept;

#if defined(NWB_PLATFORM_WINDOWS) || (defined(NWB_PLATFORM_LINUX) && !defined(NWB_PLATFORM_ANDROID))
extern u32 s_NativeLifecycleDiagnostics;
extern u32 s_UnlockedLifecycleDiagnostics;
extern Array<char, 192u> s_LastLifecycleDiagnostic;
extern Array<char, 32u> s_LastLifecycleOperation;

void ObserveNativeLifecycle(const DiagnosticEventRecord& record)noexcept;
#endif

extern u32 s_UploadDiagnostics;
extern Array<char, 64u> s_LastUploadOperation;
extern Array<char, 192u> s_LastUploadDiagnostic;
void ObserveUploadDiagnostic(const DiagnosticEventRecord& record)noexcept;

