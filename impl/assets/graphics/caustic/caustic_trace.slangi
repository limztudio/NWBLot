////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_CAUSTIC_TRACE_SLANGI
#define NWB_GRAPHICS_CAUSTIC_TRACE_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "../common/math.slangi"
#include "../shadow/shadow_surface.slangi"
#include "../mesh/surface.slangi"
#include "../optics/ray_precision.slangi"
#include "photon_push_constants.slangi"
#include "../raytrace/optical_events.slangi"
#include "../raytrace/optical_bounds.slangi"
#include "splat_constants.slangi"
#include "caustic_photon_emission.slangi"

#ifndef NWB_RT_CSG_ENABLED
#define NWB_RT_CSG_ENABLED 0
#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#define NWB_CAUSTIC_MAX_BOUNCES 16u

#define NWB_CAUSTIC_FLUX_EPSILON 1e-6
#define NWB_CAUSTIC_EXTERIOR_MARGIN_MINIMUM 1e-3
#define NWB_CAUSTIC_TRACE_T_MAX 1e7


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct NwbCausticHit{
    bool hit;
#if NWB_RT_CSG_ENABLED
    uint failure;
#endif
    bool isRefractive;
    uint instance;
    float t;
    float3 worldPos;
};

struct NwbCausticBoundary{
    uint instance;
    float3 geometricNormal;
};

NwbCausticHit nwbCausticTraceClosest(float3 origin, float3 direction, float tMin, float tMax);
#if !NWB_RT_CSG_ENABLED
NwbCausticHit nwbCausticTraceBounceZero(float3 origin, float3 direction, float tMin, float tMax);
#endif
bool nwbCausticSceneBounds(out float3 boundsMin, out float3 boundsMax, out uint flags);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct NwbCausticSplat{
    bool valid;
    uint termination;
    float3 worldPos;
    half3 flux;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NwbOpticalTraceConfig nwbCausticOpticalConfig();
bool nwbCausticCollectRefractiveEvents(
    const NwbOpticalTraceConfig config, const float3 origin, const float3 direction, const float minimum, const float maximum, const bool reverse,
    __ref NwbOpticalBootstrapEvent events[NWB_OPTICAL_MAX_CANDIDATE_EVENTS], out uint eventCount, out NwbCausticBoundary boundary, out float tolerance, inout NwbOpticalTraceResult result
);
bool nwbCausticCheckRefractiveBoundary(
    const NwbOpticalTraceConfig config, const float3 origin, const float3 direction, const float minimum, const float maximum, const uint expectedInstance,
    inout bool hasFirst, inout NwbOpticalBootstrapEvent firstEvent, inout uint candidateCount, inout NwbCausticBoundary boundary, inout NwbOpticalInstance outOptical, inout NwbOpticalTraceResult result
);

bool nwbCausticAppendBoundary(
    const NwbOpticalTraceConfig config, const float3 origin, const float3 direction, const float distance, const uint instance, const uint primitive, const float3 normal, const bool reverse,
    __ref NwbOpticalBootstrapEvent events[NWB_OPTICAL_MAX_CANDIDATE_EVENTS], inout uint count, inout NwbCausticBoundary boundary, inout float tolerance, inout NwbOpticalTraceResult result
){
    if(count == NWB_OPTICAL_MAX_CANDIDATE_EVENTS){
        result.termination = NWB_OPTICAL_TERMINATION_EVENT_LIMIT;
        return false;
    }
    NwbOpticalInstance optical;
    if(!nwbOpticalReadInstance(config, instance, optical, result))
        return false;
    if(optical.mode != NWB_RT_OPTICAL_BOUNDARY_CLOSED_NESTED && optical.mode != NWB_RT_OPTICAL_BOUNDARY_CLOSED_PRIORITY){
        result.termination = NWB_OPTICAL_TERMINATION_UNSUPPORTED;
        return false;
    }
    const float facing = dot(direction, normal);
    const float3 position = origin + direction * distance;
    if(!isfinite(distance) || !all(isfinite(position)) || !isfinite(facing) || abs(facing) <= NWB_OPTICAL_FACING_EPSILON){
        result.termination = NWB_OPTICAL_TERMINATION_AMBIGUOUS;
        return false;
    }
    tolerance = max(tolerance, NWB_OPTICS_POSITION_TOLERANCE_SCALE * nwbOpticsPositionUncertainty(position));
    NwbOpticalBootstrapEvent event;
    event.distance = reverse ? -distance : distance;
    event.instance = instance;
    event.primitive = primitive;
    event.entering = (reverse ? facing > 0.0 : facing < 0.0) ? 1u : 0u;
    if(count == 0u){
        boundary.instance = instance;
        boundary.geometricNormal = normal;
    }
    events[count] = event;
    ++count;
    ++result.bootstrapEventCount;
    return true;
}

bool nwbCausticVisitBoundaryCandidate(
    const NwbOpticalTraceConfig config,
    const float3 origin,
    const float3 direction,
    const float distance,
    const uint instance,
    const uint primitive,
    const float3 normal,
    const uint expectedInstance,
    inout bool hasFirst,
    inout NwbOpticalBootstrapEvent firstEvent,
    inout uint candidateCount,
    inout NwbCausticBoundary boundary,
    inout NwbOpticalInstance outOptical,
    inout NwbOpticalTraceResult result
){
    if(candidateCount == NWB_OPTICAL_MAX_CANDIDATE_EVENTS){
        result.termination = NWB_OPTICAL_TERMINATION_EVENT_LIMIT;
        return false;
    }
    NwbOpticalInstance optical;
    if(!nwbOpticalReadInstance(config, instance, optical, result))
        return false;
    if(optical.mode != NWB_RT_OPTICAL_BOUNDARY_CLOSED_NESTED && optical.mode != NWB_RT_OPTICAL_BOUNDARY_CLOSED_PRIORITY){
        result.termination = NWB_OPTICAL_TERMINATION_UNSUPPORTED;
        return false;
    }
    const float facing = dot(direction, normal);
    const float3 position = origin + direction * distance;
    if(!isfinite(distance) || !all(isfinite(position)) || !isfinite(facing) || abs(facing) <= NWB_OPTICAL_FACING_EPSILON){
        result.termination = NWB_OPTICAL_TERMINATION_AMBIGUOUS;
        return false;
    }
    const uint entering = facing < 0.0 ? 1u : 0u;
    ++candidateCount;
    ++result.bootstrapEventCount;
    if(!hasFirst){
        if(instance != expectedInstance){
            result.termination = NWB_OPTICAL_TERMINATION_AMBIGUOUS;
            return false;
        }
        hasFirst = true;
        firstEvent.distance = distance;
        firstEvent.instance = instance;
        firstEvent.primitive = primitive;
        firstEvent.entering = entering;
        boundary.instance = instance;
        boundary.geometricNormal = normal;
        outOptical = optical;
        return true;
    }
    if(
        instance != firstEvent.instance || entering != firstEvent.entering
#if NWB_RT_CSG_ENABLED
        || primitive == NWB_CSG_RAY_INVALID_INDEX || firstEvent.primitive == NWB_CSG_RAY_INVALID_INDEX
#endif
        || !nwbRayTraceCoplanarSeam(config.instanceMaterialHeapSlot, firstEvent.instance, firstEvent.primitive, primitive)
    ){
        result.termination = NWB_OPTICAL_TERMINATION_AMBIGUOUS;
        return false;
    }
    return true;
}

bool nwbCausticCheckBoundary(const NwbOpticalTraceConfig config, const float3 origin, const float3 direction, const NwbCausticHit hit, out NwbCausticBoundary boundary, out NwbOpticalInstance optical, inout NwbOpticalTraceResult result){
    const float tolerance = NWB_OPTICS_POSITION_TOLERANCE_SCALE * max(nwbOpticsPositionUncertainty(origin), nwbOpticsPositionUncertainty(hit.worldPos));
    bool hasFirst = false;
    NwbOpticalBootstrapEvent firstEvent = (NwbOpticalBootstrapEvent)0;
    uint candidateCount = 0u;
    boundary = (NwbCausticBoundary)0;
    optical = (NwbOpticalInstance)0;
    if(!nwbCausticCheckRefractiveBoundary(config, origin, direction, max(0.0, hit.t - tolerance), hit.t + tolerance, hit.instance, hasFirst, firstEvent, candidateCount, boundary, optical, result))
        return false;
    if(!hasFirst){
        result.termination = NWB_OPTICAL_TERMINATION_AMBIGUOUS;
        return false;
    }
    return true;
}

[noinline]
bool nwbCausticBootstrapFiniteOrigin(const NwbOpticalTraceConfig config, const float3 origin, const float3 direction, out NwbOpticalMedia media, inout NwbOpticalTraceResult result){
    media = (NwbOpticalMedia)0;
    NwbOpticalBootstrapEvent events[NWB_OPTICAL_MAX_CANDIDATE_EVENTS];
    uint count;
    NwbCausticBoundary boundary;
    float tolerance;
    const float sourceTolerance = NWB_OPTICS_POSITION_TOLERANCE_SCALE * nwbOpticsPositionUncertainty(origin);
    if(!nwbCausticCollectRefractiveEvents(config, origin, direction, 0.0, sourceTolerance, false, events, count, boundary, tolerance, result))
        return false;
    if(count != 0u){
        result.termination = NWB_OPTICAL_TERMINATION_AMBIGUOUS;
        return false;
    }
    if(!nwbCausticCollectRefractiveEvents(config, origin, -direction, 0.0, NWB_FLOAT_MAX, true, events, count, boundary, tolerance, result))
        return false;
    [loop] for(uint index = 0u; index < count; ++index){
        if(-events[index].distance <= sourceTolerance){
            result.termination = NWB_OPTICAL_TERMINATION_AMBIGUOUS;
            return false;
        }
    }
    return nwbOpticalReplayBootstrap(config, origin, direction, tolerance, events, count, media, result);
}

NwbCausticSplat nwbCausticTracePhoton(NwbCausticPhoton photon){
    NwbCausticSplat splat = (NwbCausticSplat)0;
    splat.termination = NWB_OPTICAL_TERMINATION_UNSUPPORTED;
    NwbOpticalTraceResult result = (NwbOpticalTraceResult)0;
    result.termination = NWB_OPTICAL_TERMINATION_UNSUPPORTED;
    const NwbOpticalTraceConfig config = nwbCausticOpticalConfig();
    NwbOpticalMedia media = (NwbOpticalMedia)0;
    float3 origin = photon.origin;
    float3 physicalOrigin = photon.origin;
    float3 direction = photon.direction;
    half3 flux = photon.flux;
    uint refractiveCrossings = 0u;
    float backShiftDistance = 0.0;
    if(!all(isfinite(origin)))
        return splat;

    if(photon.finiteOrigin){
        const float sourceTolerance = NWB_OPTICS_POSITION_TOLERANCE_SCALE * nwbOpticsPositionUncertainty(origin);
        if(!nwbOpticalHalfLineOutsideBounds(config.opticalSceneHeapSlot, origin, direction, sourceTolerance)){
            if(!nwbCausticBootstrapFiniteOrigin(config, origin, direction, media, result)){
                splat.termination = result.termination;
                return splat;
            }
        }
    }
    else{
        bool complete = false;
        float3 bMin;
        float3 bMax;
        uint bFlags;
        if(nwbCausticSceneBounds(bMin, bMax, bFlags) && all(isfinite(bMin)) && all(isfinite(bMax)) && all(bMin <= bMax)){
            const float3 sceneCenter = (bMin + bMax) * 0.5;
            const float3 sceneHalf = (bMax - bMin) * 0.5;
            const float backProj = dot(sceneCenter - origin, -direction) + dot(abs(direction), sceneHalf);
            const float sceneMargin = NWB_CAUSTIC_EXTERIOR_MARGIN_MINIMUM + NWB_OPTICS_POSITION_TOLERANCE_SCALE * max(nwbOpticsPositionUncertainty(bMin), nwbOpticsPositionUncertainty(bMax)) + 1e-3 * length(bMax - bMin);
            const float backDist = max(0.0, backProj + sceneMargin);
            const float3 shiftedOrigin = origin - direction * backDist;
            if(isfinite(backDist) && all(isfinite(shiftedOrigin))){
                origin = shiftedOrigin;
                backShiftDistance = backDist;
                if(bFlags == NWB_CAUSTIC_SCENE_BOUNDS_EXACT)
                    complete = true;
            }
        }
        if(!complete){
            const float3 traceStart = origin;
            float minimum = 0.0;
            [loop] for(uint step = 0u; step <= NWB_CAUSTIC_MAX_BOUNCES; ++step){
                if(!nwbOpticalConsumeQuery(config, result))
                    break;
                const NwbCausticHit previous = nwbCausticTraceClosest(traceStart, -direction, minimum, NWB_FLOAT_MAX);
#if NWB_RT_CSG_ENABLED
                if(previous.failure != 0u)
                    break;
#endif
                if(!previous.hit){
                    complete = true;
                    break;
                }
                if(step == NWB_CAUSTIC_MAX_BOUNCES || !isfinite(previous.t) || previous.t < minimum)
                    break;
                minimum = asfloat(asuint(previous.t) + 1u);
                const float margin = NWB_CAUSTIC_EXTERIOR_MARGIN_MINIMUM + NWB_OPTICS_POSITION_TOLERANCE_SCALE * nwbOpticsPositionUncertainty(previous.worldPos);
                origin = previous.worldPos - direction * margin;
                if(!isfinite(minimum) || !all(isfinite(origin)))
                    break;
            }
        }
        if(!complete){
            splat.termination = result.termination;
            return splat;
        }
    }

    [loop] for(uint bounce = 0u; bounce < NWB_CAUSTIC_MAX_BOUNCES; ++bounce){
        if(max(max(flux.x, flux.y), flux.z) < NWB_CAUSTIC_FLUX_EPSILON || !nwbOpticalConsumeQuery(config, result))
            break;
        const float maxTraceDistance = bounce == 0u ? max(NWB_CAUSTIC_TRACE_T_MAX, backShiftDistance + NWB_CAUSTIC_TRACE_T_MAX) : NWB_CAUSTIC_TRACE_T_MAX;
#if NWB_RT_CSG_ENABLED
        const NwbCausticHit hit = nwbCausticTraceClosest(origin, direction, 0.0, maxTraceDistance);
#else
        const NwbCausticHit hit = (bounce == 0u && refractiveCrossings == 0u && media.count == 0u)
            ? nwbCausticTraceBounceZero(origin, direction, 0.0, maxTraceDistance)
            : nwbCausticTraceClosest(origin, direction, 0.0, NWB_CAUSTIC_TRACE_T_MAX);
#endif
#if NWB_RT_CSG_ENABLED
        if(hit.failure != 0u)
            break;
#endif
        if(!hit.hit)
            break;
        const float segmentDistance = length(hit.worldPos - physicalOrigin);
        if(!isfinite(segmentDistance) || segmentDistance <= 0.0){
            result.termination = NWB_OPTICAL_TERMINATION_AMBIGUOUS;
            break;
        }
        const NwbOpticalMedium incident = nwbOpticalDominantMedium(media);
        if(media.count != 0u)
            flux *= nwbDielectricBeerTransmission(incident.absorption, segmentDistance);
        if(!hit.isRefractive){
            if(refractiveCrossings == 0u && media.count == 0u)
                break;
            splat.valid = true;
            splat.worldPos = hit.worldPos;
            splat.flux = flux;
            splat.termination = NWB_OPTICAL_TERMINATION_OPAQUE;
            return splat;
        }
        NwbCausticBoundary boundary;
        NwbOpticalInstance optical;
        if(!nwbCausticCheckBoundary(config, origin, direction, hit, boundary, optical, result))
            break;
        const bool entering = dot(direction, boundary.geometricNormal) < 0.0;
        NwbOpticalMedium medium = (NwbOpticalMedium)0;
        medium.instance = hit.instance;
        medium.entityId = optical.entityId;
        medium.priority = optical.priority;
        medium.mode = optical.mode;
        if(entering && !nwbOpticalLoadHomogeneousMedium(config, hit.worldPos, direction, medium, result))
            break;
        const half incidentIor = half(incident.ior);
        if(!nwbOpticalApplyBoundary(medium, entering, media, result))
            break;
        const NwbOpticalMedium transmitted = nwbOpticalDominantMedium(media);
        const float3 normal = entering ? boundary.geometricNormal : -boundary.geometricNormal;
        const NwbDielectricInterface interface = nwbDielectricTransmit(direction, normal, incidentIor, half(transmitted.ior));
        if(interface.totalInternalReflection){
            ++result.tirCount;
            break;
        }
        flux *= half(1.0h) - half(interface.reflectedFraction);
        ++refractiveCrossings;
        physicalOrigin = hit.worldPos;
        direction = interface.direction;
        const float3 offsetNormal = dot(direction, boundary.geometricNormal) >= 0.0 ? boundary.geometricNormal : -boundary.geometricNormal;
        origin = hit.worldPos + offsetNormal * nwbOpticsPositionUncertainty(hit.worldPos);
    }
    splat.termination = result.termination;
    return splat;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


