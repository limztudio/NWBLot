StableDedupValue MakeStableDedupValue(in u32 key, in u32 order){
    StableDedupValue item;
    item.key = key;
    item.order = order;
    return item;
}

void VerifyBase64_RejectsMalformedAlphabetLengthPaddingAndUnusedBits(){
    Array<StringView, 18> invalid = Array<StringView, 18>();
    invalid[0u] = "Z";
    invalid[1u] = "Zg";
    invalid[2u] = "Zg=";
    invalid[3u] = "Zg===";
    invalid[4u] = "=g==";
    invalid[5u] = "Z===";
    invalid[6u] = "Zg=A";
    invalid[7u] = "Zg==AAAA";
    invalid[8u] = "AAAAZg==AAAA";
    invalid[9u] = "Zm9=";
    invalid[10u] = "Zh==";
    invalid[11u] = "AB==";
    invalid[12u] = "AAB=";
    invalid[13u] = "Zg-_";
    invalid[14u] = "Zg\r\n";
    invalid[15u] = "Zg \t";
    invalid[16u] = "Zg#=";
    invalid[17u] = "====";
    for(in StringView text : invalid){
        const Expected<usize> sizeResult = Base64DecodedSize(text, 1024u);
        EXPECT_FALSE(sizeResult.has_value());
        b8 decodedOk = true;
        native(in text, mut decodedOk){
            NWB::Tests::TestArena<> context;
            using Bytes = ::Vector<u8, NWB::Core::Alloc::GlobalArena>;
            const typename Bytes::allocator_type allocator(context.arena);
            decodedOk = DecodeBase64<Bytes>(text, allocator, 1024u).has_value();
        }
        EXPECT_FALSE(decodedOk);
    }
    native{
        NWB::Tests::TestArena<> context;
        using Bytes = ::Vector<u8, NWB::Core::Alloc::GlobalArena>;
        const typename Bytes::allocator_type allocator(context.arena);
        const Array<AStringView, 2u> binaryInvalid = {
            AStringView("Zg\0=", 4u),
            AStringView("Zg\xff=", 4u),
        };
        for(const AStringView text : binaryInvalid){
            EXPECT_FALSE(Base64DecodedSize(text, 1024u));
            EXPECT_FALSE(DecodeBase64<Bytes>(text, allocator, 1024u));
        }
    }
}

void VerifyBase64_ExactDecodedBoundsAreCheckedBeforeAllocation(){
    EXPECT_FALSE(Base64DecodedSize("Zm9v", 2u).has_value());
    const Expected<usize> size = Base64DecodedSize("Zm9v", 3u);
    ASSERT_TRUE(size.has_value());
    EXPECT_EQ(size.value(), 3u);
    native{
        NWB::Tests::TestArena<> context;
        using Bytes = ::Vector<u8, NWB::Core::Alloc::GlobalArena>;
        const typename Bytes::allocator_type allocator(context.arena);
        const auto before = context.arena.memoryStats();
        EXPECT_FALSE(DecodeBase64<Bytes>("Zm9v", allocator, 2u));
        EXPECT_EQ(context.arena.memoryStats().allocationCount, before.allocationCount);
        const auto output = DecodeBase64<Bytes>("Zm9v", allocator, 3u);
        ASSERT_TRUE(output);
        ASSERT_EQ(output->size(), 3u);
        EXPECT_EQ((*output)[0u], static_cast<u8>('f'));
        const auto empty = DecodeBase64<Bytes>("", allocator, 0u);
        ASSERT_TRUE(empty);
        EXPECT_TRUE(empty->empty());
    }
}

void VerifyBase64_InvalidEncodeInputAndSizeOverflowDoNotAllocate(){
    b8 encodedNullNonzero = true;
    b8 encodedSizeOverflow = true;
    u64 beforeAllocations = 0u;
    u64 afterInvalidAllocations = 1u;
    b8 emptySucceeded = false;
    String emptyEncoded = "nonempty";
    native(mut encodedNullNonzero, mut encodedSizeOverflow, mut beforeAllocations, mut afterInvalidAllocations, mut emptySucceeded, mut emptyEncoded){
        NWB::Tests::TestArena<> context;
        using Text = ::AString<NWB::Core::Alloc::GlobalArena>;
        const typename Text::allocator_type allocator(context.arena);
        const auto before = context.arena.memoryStats();
        beforeAllocations = before.allocationCount;
        encodedNullNonzero = EncodeBase64<Text>({ nullptr, 1u }, allocator).has_value();
        const u8 byte = 0u;
        encodedSizeOverflow = EncodeBase64<Text>({ &byte, Limit<usize>::s_Max }, allocator).has_value();
        afterInvalidAllocations = context.arena.memoryStats().allocationCount;
        const auto empty = EncodeBase64<Text>({}, allocator);
        emptySucceeded = empty.has_value();
        if(empty)
            emptyEncoded.assign(*empty);
    }
    EXPECT_FALSE(encodedNullNonzero);
    EXPECT_FALSE(encodedSizeOverflow);
    EXPECT_EQ(afterInvalidAllocations, beforeAllocations);
    ASSERT_TRUE(emptySucceeded);
    EXPECT_TRUE(emptyEncoded.empty());
}

void VerifyGlobal_AtomicIdentityAndHighWaterRespectLimits(){
    Atomic<u64> highWater = Atomic<u64>(u64.max - 1u);
    UpdateAtomicMaxRelaxed(highWater, cast<u64>(0u));
    EXPECT_EQ(highWater.load(MemoryOrder::relaxed), u64.max - 1u);
    UpdateAtomicMaxRelaxed(highWater, u64.max);
    EXPECT_EQ(DecrementAtomicOrTerminate(highWater), u64.max);
    EXPECT_EQ(highWater.load(MemoryOrder::relaxed), u64.max - 1u);

    Atomic<u64> identities = Atomic<u64>(u64.max - 1u);
    EXPECT_EQ(TryNextAtomicIdentity(identities), u64.max - 1u);
    EXPECT_EQ(TryNextAtomicIdentity(identities), 0u);
    EXPECT_EQ(identities.load(MemoryOrder::relaxed), u64.max);

    Atomic<u32> boundedIdentity = Atomic<u32>(cast<u32>(u16.max));
    const Expected<u16> lastBoundedIdentity = TryNextAtomicBoundedIdentity<u16>(boundedIdentity);
    ASSERT_TRUE(lastBoundedIdentity.has_value());
    EXPECT_EQ(lastBoundedIdentity.value(), u16.max);
    EXPECT_EQ(boundedIdentity.load(MemoryOrder::relaxed), cast<u32>(u16.max) + 1u);
    EXPECT_FALSE(TryNextAtomicBoundedIdentity<u16>(boundedIdentity).has_value());

    Atomic<u32> zeroBoundedIdentity = Atomic<u32>(0u);
    EXPECT_FALSE(TryNextAtomicBoundedIdentity<u16>(zeroBoundedIdentity).has_value());
    EXPECT_EQ(zeroBoundedIdentity.load(MemoryOrder::relaxed), 0u);

    Atomic<u64> zeroIdentity = Atomic<u64>(0u);
    EXPECT_EQ(TryNextAtomicIdentity(zeroIdentity), 0u);
    EXPECT_EQ(zeroIdentity.load(MemoryOrder::relaxed), 0u);
    const Expected<u64> allowedZeroIdentity = TryNextAtomicIdentityAllowZero(zeroIdentity);
    ASSERT_TRUE(allowedZeroIdentity.has_value());
    EXPECT_EQ(allowedZeroIdentity.value(), 0u);
    EXPECT_EQ(zeroIdentity.load(MemoryOrder::relaxed), 1u);
    EXPECT_FALSE(TryNextAtomicIdentityAllowZero(identities).has_value());
    EXPECT_EQ(identities.load(MemoryOrder::relaxed), u64.max);
}

void VerifyGlobal_ExhaustedPodReadsPreserveCursor(){
    Vector<u8> binary = Vector<u8>();
    binary.reserve(4u);
    const u32 writtenValue = 0x11223344u;
    AppendPOD(binary, writtenValue);

    usize cursor = 0u;
    const Expected<u32> readValue = ReadPOD<u32>(binary, cursor);
    ASSERT_TRUE(readValue.has_value());
    EXPECT_EQ(readValue.value(), writtenValue);
    EXPECT_EQ(cursor, 4u);

    const usize failedCursor = cursor;
    EXPECT_FALSE(ReadPOD<u32>(binary, cursor).has_value());
    EXPECT_EQ(cursor, failedCursor);
}

void VerifyGlobal_TruncatedStringReadsDoNotAdvanceCursor(){
    Vector<u8> truncated = Vector<u8>();
    truncated.reserve(5u);
    AppendPOD(truncated, 4u);
    truncated.push_back(cast<u8>(120u));
    usize cursor = 0u;
    const Expected<StringView> parsed = ReadString(truncated, cursor);
    EXPECT_FALSE(parsed.has_value());
    EXPECT_EQ(cursor, 0u);
}

void VerifyGlobal_StringTableUsesPrefixedBoundsAndRejectsEmptyAppend(){
    Vector<u8> stringTable = Vector<u8>();
    stringTable.reserve(16u);
    const Expected<u32> alphaOffset = AppendStringTableText(stringTable, s_GlobalTestTableAlpha);
    const Expected<u32> betaOffset = AppendStringTableText(stringTable, s_GlobalTestTableBeta);
    ASSERT_TRUE(alphaOffset.has_value());
    ASSERT_TRUE(betaOffset.has_value());

    Vector<u8> prefixedBinary = Vector<u8>();
    prefixedBinary.reserve(17u);
    prefixedBinary.push_back(0xFFu);
    for(in u8 byte : stringTable)
        prefixedBinary.push_back(byte);

    const Expected<CompactString> parsed = ReadStringTableText(prefixedBinary, 1u, stringTable.size(), betaOffset.value());
    ASSERT_TRUE(parsed.has_value());
    EXPECT_EQ(parsed.value().view(), s_GlobalTestTableBeta);

    const usize previousSize = stringTable.size();
    const Expected<u32> emptyOffset = AppendStringTableText(stringTable, StringView());
    EXPECT_FALSE(emptyOffset.has_value());
    EXPECT_EQ(stringTable.size(), previousSize);
}

void VerifyGlobal_InvalidStringTableReads(){
    Vector<u8> unterminated = Vector<u8>();
    unterminated.reserve(2u);
    unterminated.push_back(cast<u8>(97u));
    unterminated.push_back(cast<u8>(98u));
    const Expected<CompactString> first = ReadStringTableText(unterminated, 0u, unterminated.size(), 0u);
    EXPECT_FALSE(first.has_value());

    Vector<u8> emptyText = Vector<u8>();
    emptyText.reserve(1u);
    emptyText.push_back(0u);
    const Expected<CompactString> second = ReadStringTableText(emptyText, 0u, emptyText.size(), 0u);
    EXPECT_FALSE(second.has_value());
}

void VerifyGlobal_EmptyBinaryVectorReadClearsReusedOutputWithoutAdvancing(){
    Vector<u8> binary = Vector<u8>();
    binary.reserve(6u);
    Vector<u16> source = Vector<u16>();
    source.reserve(3u);
    source.push_back(1u);
    source.push_back(2u);
    source.push_back(cast<u16>(0xBEEFu));

    ASSERT_TRUE(AppendBinaryVectorPayload(binary, source));

    usize cursor = 0u;
    Vector<u16> parsed = Vector<u16>();
    parsed.reserve(4u);
    const BinaryVectorVoidResult firstRead = ReadBinaryVectorPayload(binary, cast<u64>(source.size()), cursor, parsed);
    ASSERT_TRUE(firstRead.has_value());

    cursor = 0u;
    parsed.push_back(7u);
    const BinaryVectorVoidResult emptyRead = ReadBinaryVectorPayload(binary, 0u, cursor, parsed);
    ASSERT_TRUE(emptyRead.has_value());
    EXPECT_EQ(cursor, 0u);
    EXPECT_TRUE(parsed.empty());
}

void VerifyGlobal_FixedVectorOverflowDoesNotAdvanceBinaryCursor(){
    Vector<u8> vectorBinary = Vector<u8>();
    vectorBinary.reserve(6u);
    Array<u16, 3> values = Array<u16, 3>();
    values[0u] = 4u;
    values[1u] = 5u;
    values[2u] = 6u;
    for(in u16 value : values)
        AppendPOD(vectorBinary, value);

    usize vectorCursor = 0u;
    FixedVector<u16, 2> tooSmall = FixedVector<u16, 2>();
    const BinaryVectorVoidResult overflowRead = ReadBinaryVectorPayload(vectorBinary, 3u, vectorCursor, tooSmall);
    ASSERT_FALSE(overflowRead.has_value());
    EXPECT_EQ(overflowRead.error(), BinaryVectorPayloadFailure::OutputOverflow);
    EXPECT_EQ(vectorCursor, 0u);
    EXPECT_TRUE(tooSmall.empty());
}

void VerifyGlobal_RejectedBinaryVectorPayloadReadsDoNotAdvanceCursor(){
    Vector<u8> truncated = Vector<u8>();
    truncated.reserve(5u);
    const u32 source = 0x12345678u;
    AppendPOD(truncated, source);

    usize cursor = 0u;
    Vector<u32> parsed = Vector<u32>();
    parsed.reserve(4u);
    parsed.push_back(0xAABBCCDDu);
    const BinaryVectorVoidResult truncatedRead = ReadBinaryVectorPayload(truncated, 2u, cursor, parsed);
    ASSERT_FALSE(truncatedRead.has_value());
    EXPECT_EQ(truncatedRead.error(), BinaryVectorPayloadFailure::SourceTruncated);
    EXPECT_EQ(cursor, 0u);
    EXPECT_TRUE(parsed.empty());
}

void VerifyGlobal_AppendTriviallyCopyableVectorSelfAppend(){
    Vector<u32> values = Vector<u32>();
    values.reserve(3u);
    values.push_back(1u);
    values.push_back(2u);
    values.push_back(3u);

    AppendTriviallyCopyableVector(values, values);

    EXPECT_EQ(values.size(), 6u);
    EXPECT_EQ(values[0u], 1u);
    EXPECT_EQ(values[1u], 2u);
    EXPECT_EQ(values[2u], 3u);
    EXPECT_EQ(values[3u], 1u);
    EXPECT_EQ(values[4u], 2u);
    EXPECT_EQ(values[5u], 3u);
}

void VerifyGlobal_TriviallyCopyableVectorPreservesOverlappingSourceRanges(){
    Vector<u32> values = Vector<u32>();
    values.reserve(4u);
    values.push_back(1u);
    values.push_back(2u);
    values.push_back(3u);
    values.push_back(4u);

    native(mut values){
        const __hidden_global_binary_tests::U32VectorView middle{ values.data() + 1u, 2u };
        AppendTriviallyCopyableVector(values, middle);
    }

    EXPECT_EQ(values.size(), 6u);
    EXPECT_EQ(values[0u], 1u);
    EXPECT_EQ(values[1u], 2u);
    EXPECT_EQ(values[2u], 3u);
    EXPECT_EQ(values[3u], 4u);
    EXPECT_EQ(values[4u], 2u);
    EXPECT_EQ(values[5u], 3u);

    native(mut values){
        const __hidden_global_binary_tests::U32VectorView assignedMiddle{ values.data() + 1u, 3u };
        AssignTriviallyCopyableVector(values, assignedMiddle);
    }

    EXPECT_EQ(values.size(), 3u);
    EXPECT_EQ(values[0u], 2u);
    EXPECT_EQ(values[1u], 3u);
    EXPECT_EQ(values[2u], 4u);
}

void VerifyGlobal_DirectionalSearchHandlesChangingCountsAndThrows(){
    u32 countCalls = 0u;
    const auto countRows = lambda[mut countCalls]() -> u64{
        ++countCalls;
        return 3u;
    };
    const auto matchFirst = lambda[](in u64 index) -> b8{
        return index == 0u;
    };
    const Expected<u64> firstReverse = FindDirectionalIndex(2u, true, countRows, matchFirst);
    ASSERT_TRUE(firstReverse.has_value());
    EXPECT_EQ(firstReverse.value(), 0u);
    EXPECT_EQ(countCalls, 4u);

    countCalls = 0u;
    EXPECT_FALSE(FindDirectionalIndex(3u, false, countRows, matchFirst).has_value());
    EXPECT_EQ(countCalls, 1u);

    native{
        u32 nativeCountCalls = 0u;
        const auto nativeCountRows = [&nativeCountCalls]()noexcept{ ++nativeCountCalls; return u64(3u); };
        const auto matchNone = [](const u64)noexcept{ return false; };
        EXPECT_FALSE(FindDirectionalIndex(0u, true, nativeCountRows, matchNone));
        const auto throwingMatch = [](const u64) -> b8{ throw RuntimeException("directional predicate failure"); };
        static_assert(!noexcept(FindDirectionalIndex(0u, false, nativeCountRows, throwingMatch)));
        EXPECT_THROW(static_cast<void>(FindDirectionalIndex(0u, false, nativeCountRows, throwingMatch)), RuntimeException);
        u32 shrinkingCalls = 0u;
        u32 matchedCalls = 0u;
        const auto shrinkingCount = [&shrinkingCalls]()noexcept{ return ++shrinkingCalls == 1u ? u64(3u) : u64(1u); };
        const auto trackMatch = [&matchedCalls](const u64)noexcept{ ++matchedCalls; return true; };
        EXPECT_FALSE(FindDirectionalIndex(2u, false, shrinkingCount, trackMatch));
        EXPECT_EQ(shrinkingCalls, 2u);
        EXPECT_EQ(matchedCalls, 0u);
        const auto maximumRowCount = []()noexcept{ return Limit<u64>::s_Max; };
        EXPECT_FALSE(FindDirectionalIndex(Limit<u64>::s_Max - 1u, false, maximumRowCount, matchNone));
        const auto throwingCount = []() -> u64{ throw RuntimeException("directional count failure"); };
        static_assert(!noexcept(FindDirectionalIndex(0u, false, throwingCount, matchNone)));
        EXPECT_THROW(static_cast<void>(FindDirectionalIndex(0u, false, throwingCount, matchNone)), RuntimeException);
    }
}

void VerifyGlobal_CollectionValidationAndOrderingPreserveBoundaries(){
    Array<u32, 3> valuesToValidate = Array<u32, 3>();
    valuesToValidate[0u] = 2u;
    valuesToValidate[1u] = 3u;
    valuesToValidate[2u] = 0u;
    Array<u32, 4> validationEvents = Array<u32, 4>();
    usize validationEventCount = 0u;
    const auto recordValid = lambda[mut validationEvents, mut validationEventCount](in u32 value) -> b8{
        validationEvents[validationEventCount] = 100u + value;
        ++validationEventCount;
        return value != 0u;
    };
    const auto recordDuplicate = lambda[mut validationEvents, mut validationEventCount](in u32 current, in u32 previous) -> b8{
        validationEvents[validationEventCount] = current * 10u + previous;
        ++validationEventCount;
        return current == previous;
    };
    const Span<u32> emptyValues = Span<u32>();
    const Span<u32> allValues = valuesToValidate;
    const Span<u32> singleValue = allValues.subspan(0u, 1u);
    EXPECT_TRUE(AllValidAndDistinct(emptyValues, recordValid, recordDuplicate));
    const b8 singleValid = AllValidAndDistinct(singleValue, lambda[](in u32 value) -> b8{ return value != 0u; }, lambda[](in u32 lhs, in u32 rhs) -> b8{ return lhs == rhs; });
    EXPECT_TRUE(singleValid);
    EXPECT_FALSE(AllValidAndDistinct(allValues, recordValid, recordDuplicate));
    EXPECT_EQ(validationEventCount, 4u);
    EXPECT_EQ(validationEvents[0u], 102u);
    EXPECT_EQ(validationEvents[1u], 103u);
    EXPECT_EQ(validationEvents[2u], 32u);
    EXPECT_EQ(validationEvents[3u], 100u);

    Array<u32, 4> duplicateValues = Array<u32, 4>();
    duplicateValues[0u] = 2u;
    duplicateValues[1u] = 3u;
    duplicateValues[2u] = 3u;
    duplicateValues[3u] = 5u;
    u32 visitedValues = 0u;
    u32 comparedValues = 0u;
    const auto countValid = lambda[mut visitedValues](in u32 value) -> b8{
        if(value == 0u)
            ++visitedValues;
        else
            ++visitedValues;
        return true;
    };
    const auto countDuplicate = lambda[mut comparedValues](in u32 current, in u32 previous) -> b8{
        ++comparedValues;
        return current == previous;
    };
    const Span<u32> duplicateSpan = duplicateValues;
    EXPECT_FALSE(AllValidAndDistinct(duplicateSpan, countValid, countDuplicate));
    EXPECT_EQ(visitedValues, 3u);
    EXPECT_EQ(comparedValues, 3u);

    Vector<StableDedupValue> duplicates = Vector<StableDedupValue>();
    duplicates.reserve(5u);
    duplicates.push_back(MakeStableDedupValue(2u, 0u));
    duplicates.push_back(MakeStableDedupValue(1u, 1u));
    duplicates.push_back(MakeStableDedupValue(2u, 2u));
    duplicates.push_back(MakeStableDedupValue(1u, 3u));
    duplicates.push_back(MakeStableDedupValue(3u, 4u));
    StableDeduplicate(duplicates, lambda[](in StableDedupValue lhs, in StableDedupValue rhs) -> b8{ return lhs.key == rhs.key; });
    ASSERT_EQ(duplicates.size(), 3u);
    EXPECT_EQ(duplicates[0u].order, 0u);
    EXPECT_EQ(duplicates[1u].order, 1u);
    EXPECT_EQ(duplicates[2u].order, 4u);

    native(in valuesToValidate, mut duplicates){
        const auto recordDuplicateNoexcept = [](const u32 current, const u32 previous)noexcept{ return current == previous; };
        const auto throwingValid = [](const u32) -> b8{ throw RuntimeException("validity predicate failure"); };
        static_assert(!noexcept(AllValidAndDistinct(Span<const u32>{}, throwingValid, recordDuplicateNoexcept)));
        EXPECT_THROW(static_cast<void>(AllValidAndDistinct(Span<const u32>(valuesToValidate), throwingValid, recordDuplicateNoexcept)), RuntimeException);

        using KeyedValue = NWB::Tests::GlobalCases::StableDedupValue;
        const auto throwingSameKey = [](const KeyedValue&, const KeyedValue&) -> b8{ throw RuntimeException("deduplication predicate failure"); };
        EXPECT_THROW(StableDeduplicate(duplicates, throwingSameKey), RuntimeException);

        struct ThrowingAssignment{
            u32 key = 0u;
            ThrowingAssignment& operator=(ThrowingAssignment& other)noexcept{ key = other.key; return *this; }
            ThrowingAssignment& operator=(const ThrowingAssignment&){ throw RuntimeException("const assignment failure"); }
        };
        struct SmallSequence{
            Array<ThrowingAssignment, 3u> entries{ ThrowingAssignment{ 1u }, ThrowingAssignment{ 1u }, ThrowingAssignment{ 2u } };
            usize count = 3u;
            [[nodiscard]] usize size()const noexcept{ return count; }
            ThrowingAssignment& operator[](const usize index)noexcept{ return entries[index]; }
            void resize(const usize value)noexcept{ count = value; }
        };
        struct ThrowingComparison{
            [[nodiscard]] b8 operator()(ThrowingAssignment& lhs, ThrowingAssignment& rhs)const noexcept{ return lhs.key == rhs.key; }
            [[nodiscard]] b8 operator()(ThrowingAssignment&, const ThrowingAssignment&)const{ throw RuntimeException("const comparison failure"); }
        };
        const auto sameAssignmentKey = [](const ThrowingAssignment& lhs, const ThrowingAssignment& rhs)noexcept{ return lhs.key == rhs.key; };
        SmallSequence assignmentValues;
        static_assert(!noexcept(StableDeduplicate(assignmentValues, sameAssignmentKey)));
        EXPECT_THROW(StableDeduplicate(assignmentValues, sameAssignmentKey), RuntimeException);
        SmallSequence comparisonValues;
        const ThrowingComparison throwingComparison;
        static_assert(!noexcept(StableDeduplicate(comparisonValues, throwingComparison)));
        EXPECT_THROW(StableDeduplicate(comparisonValues, throwingComparison), RuntimeException);

        struct ThrowingIndexSequence{
            KeyedValue value{};
            [[nodiscard]] usize size()const noexcept{ return 1u; }
            KeyedValue& operator[](usize&){ throw RuntimeException("lvalue index failure"); }
            KeyedValue& operator[](usize&&)noexcept{ return value; }
            void resize(usize&)noexcept{}
            void resize(usize&&)noexcept{}
        };
        const auto sameKeyedValue = [](const KeyedValue& lhs, const KeyedValue& rhs)noexcept{ return lhs.key == rhs.key; };
        ThrowingIndexSequence indexValues;
        static_assert(!noexcept(StableDeduplicate(indexValues, sameKeyedValue)));
        EXPECT_THROW(StableDeduplicate(indexValues, sameKeyedValue), RuntimeException);

        struct ThrowingResizeSequence{
            KeyedValue value{};
            [[nodiscard]] usize size()const noexcept{ return 0u; }
            KeyedValue& operator[](usize&)noexcept{ return value; }
            KeyedValue& operator[](usize&&)noexcept{ return value; }
            void resize(usize&){ throw RuntimeException("lvalue resize failure"); }
            void resize(usize&&)noexcept{}
        };
        ThrowingResizeSequence resizeValues;
        static_assert(!noexcept(StableDeduplicate(resizeValues, sameKeyedValue)));
        EXPECT_THROW(StableDeduplicate(resizeValues, sameKeyedValue), RuntimeException);
    }
    EXPECT_EQ(duplicates.size(), 3u);

    Array<i32, 4> projectedValues = Array<i32, 4>();
    projectedValues[0u] = 3;
    projectedValues[1u] = 0;
    projectedValues[2u] = 1;
    projectedValues[3u] = -2;
    Vector<usize> projectedIndices = Vector<usize>();
    BuildProjectedRecordIndex(projectedIndices, projectedValues, lambda[](in i32 value) -> b8{ return value != 0; }, lambda[](in i32 lhs, in i32 rhs) -> b8{ return lhs < rhs; });
    ASSERT_EQ(projectedIndices.size(), 3u);
    EXPECT_EQ(projectedIndices[0u], 3u);
    EXPECT_EQ(projectedIndices[1u], 2u);
    EXPECT_EQ(projectedIndices[2u], 0u);

    FixedVector<u32, 4> sortedValues = FixedVector<u32, 4>();
    b8 pointerIdentitiesMatched = false;
    native(mut sortedValues, mut pointerIdentitiesMatched){
        NWB::Core::Alloc::ScratchArena scratchArena(NWB::Tests::s_TestArena);
        const u32 one = 1u;
        const u32 two = 2u;
        const u32 three = 3u;
        const Array<const u32*, 4u> items{ &one, &two, nullptr, &three };
        ::Vector<u8, NWB::Core::Alloc::ScratchArena> state(items.size(), 0u, scratchArena);
        ::Vector<const u32*, NWB::Core::Alloc::ScratchArena> sorted(scratchArena);
        TopologicallySortPointers(Span<const u32* const>(items.data(), items.size()), [](const u32 current, const u32 dependency)noexcept{
            return (current == 1u && dependency == 2u) || (current == 2u && dependency == 1u);
        }, state, sorted);
        for(const u32* const ptr : sorted)
            sortedValues.push_back(ptr != nullptr ? *ptr : 0u);
        pointerIdentitiesMatched =
            sorted.size() == 4u
            && sorted[0u] == &two
            && sorted[1u] == &one
            && sorted[2u] == nullptr
            && sorted[3u] == &three
        ;
    }
    ASSERT_EQ(sortedValues.size(), 4u);
    EXPECT_EQ(sortedValues[0u], 2u);
    EXPECT_EQ(sortedValues[1u], 1u);
    EXPECT_EQ(sortedValues[2u], 0u);
    EXPECT_EQ(sortedValues[3u], 3u);
    EXPECT_TRUE(pointerIdentitiesMatched);
}

void VerifyGlobal_IntervalCoverageHandlesOverlapAndThrows(){
    Array<u8, 5> overlapFlags = Array<u8, 5>();
    native(mut overlapFlags){
        using TestInterval = NWB::Tests::GlobalCases::IntervalProbe;
        auto makeInterval = [](const u64 first, const u64 last, const u32 index)noexcept{
            TestInterval item;
            item.first = first;
            item.last = last;
            item.index = index;
            return item;
        };
        const Array<TestInterval, 3u> unsortedIntervals{ makeInterval(5u, 10u, 0u), makeInterval(0u, 5u, 1u), makeInterval(2u, 3u, 2u) };
        const auto eligible = [](const TestInterval&)noexcept{ return true; };
        const auto intervalBegin = [](const TestInterval& interval)noexcept{ return interval.first; };
        const auto intervalEnd = [](const TestInterval& interval)noexcept{ return interval.last; };
        static_assert(noexcept(CoversHalfOpenRange(0u, 0u, Span<const TestInterval>{}, eligible, intervalBegin, intervalEnd)));
        EXPECT_TRUE(CoversHalfOpenRange(0u, 0u, Span<const TestInterval>{}, eligible, intervalBegin, intervalEnd));
        const auto throwingEligible = [](const TestInterval&) -> b8{ throw RuntimeException("interval predicate failure"); };
        static_assert(!noexcept(CoversHalfOpenRange(0u, 1u, Span<const TestInterval>{}, throwingEligible, intervalBegin, intervalEnd)));
        EXPECT_THROW(static_cast<void>(CoversHalfOpenRange(0u, 10u, Span<const TestInterval>(unsortedIntervals), throwingEligible, intervalBegin, intervalEnd)), RuntimeException);
        EXPECT_TRUE(CoversHalfOpenRange(0u, 10u, Span<const TestInterval>(unsortedIntervals), eligible, intervalBegin, intervalEnd));
        EXPECT_FALSE(CoversHalfOpenRange(0u, 11u, Span<const TestInterval>(unsortedIntervals), eligible, intervalBegin, intervalEnd));
        const Array<TestInterval, 5u> sortedIntervals{ makeInterval(0u, 10u, 0u), makeInterval(1u, 2u, 1u), makeInterval(3u, 4u, 2u), makeInterval(10u, 11u, 3u), makeInterval(10u, 11u, 4u) };
        const auto noVisit = [](const TestInterval&)noexcept{};
        static_assert(noexcept(VisitOverlappingSortedIntervals(Span<const TestInterval>{}, intervalBegin, intervalEnd, noVisit)));
        const auto throwingVisit = [](const TestInterval&){ throw RuntimeException("interval visitor failure"); };
        static_assert(!noexcept(VisitOverlappingSortedIntervals(Span<const TestInterval>{}, intervalBegin, intervalEnd, throwingVisit)));
        EXPECT_THROW(VisitOverlappingSortedIntervals(Span<const TestInterval>(sortedIntervals), intervalBegin, intervalEnd, throwingVisit), RuntimeException);
        VisitOverlappingSortedIntervals(Span<const TestInterval>(sortedIntervals), intervalBegin, intervalEnd, [&overlapFlags](const TestInterval& interval)noexcept{ overlapFlags[interval.index] = 1u; });
    }
    for(in u8 overlap : overlapFlags)
        EXPECT_EQ(overlap, 1u);
}

void VerifyGlobal_DisjointSetJoinsPreserveRoots(){
    Array<u32, 4> parents = Array<u32, 4>();
    parents[0u] = 0u;
    parents[1u] = 1u;
    parents[2u] = 2u;
    parents[3u] = 3u;
    Array<u8, 4> ranks = Array<u8, 4>();
    JoinDisjointSets(0u, 1u, parents, ranks);
    JoinDisjointSets(2u, 3u, parents, ranks);
    JoinDisjointSets(0u, 2u, parents, ranks);
    EXPECT_EQ(FindDisjointRoot(3u, parents), 0u);
    EXPECT_EQ(parents[3u], 0u);
    EXPECT_EQ(ranks[0u], 2u);
}

void VerifyGlobal_DiagnosticFormatSupportsBoundedFormatViewsAndNullableAdapters(){
    const StringView formatPrefix = s_GlobalDiagnosticValueFormatTrailing.substr(0u, 8u);
    const StringView expected = s_GlobalDiagnosticValue42;
    const DiagnosticEventText narrow = MakeDiagnosticEventText(formatPrefix, 42u);
    EXPECT_EQ(narrow.view(), expected);

    DiagnosticEventText wide = DiagnosticEventText();
    DiagnosticEventText nullFormatted = DiagnosticEventText();
    native(mut wide, mut nullFormatted){
        constexpr WStringView s_ValueFormatTrailingWide = L"value {}.trailing";
        wide = MakeDiagnosticEventText(s_ValueFormatTrailingWide.substr(0u, 8u), 42u);
        nullFormatted = MakeDiagnosticEventText(static_cast<const char*>(nullptr), 42u);
    }
    EXPECT_EQ(wide.view(), expected);
    EXPECT_EQ(nullFormatted.view(), StringView());
}

void VerifyGlobal_DiagnosticEventTextViewsStopAtNullOrBufferBounds(){
    DiagnosticEventText text = DiagnosticEventText();
    usize capacity = 0u;
    native(mut text, mut capacity){
        capacity = sizeof(text.value);
        for(char& character : text.value)
            character = 'x';
    }
    const StringView fullView = text.view();
    EXPECT_EQ(fullView.size(), capacity);
    const DiagnosticEventText formatted = MakeDiagnosticEventText("{}", text);
    const StringView formattedView = formatted.view();
    EXPECT_EQ(formattedView.size(), capacity - 1u);
    EXPECT_EQ(formattedView, fullView.substr(0u, capacity - 1u));

    native(mut text){
        text.value[3u] = '\0';
    }
    EXPECT_EQ(text.view(), StringView("xxx"));
}

void VerifyGlobal_DiagnosticEventHookRejectsReentryAndHonorsBoundedText(){
    const StringView unitCategory = s_GlobalDiagnosticUnit;
    u32 captureCount = 0u;
    b8 nonNullFields = false;
    StringView capturedName = StringView();
    StringView capturedCategory = StringView();
    StringView capturedExpression = StringView();
    StringView capturedMessage = StringView();
    native(in unitCategory, mut captureCount, mut nonNullFields, mut capturedName, mut capturedCategory, mut capturedExpression, mut capturedMessage){
        using namespace __hidden_diagnostic_event_tests;
        ResetDiagnosticEventCapture();

        const auto callback = MakeNotNull<DiagnosticEventCallback>([](const DiagnosticEventRecord& record)noexcept{
            RecordDiagnosticEvent(record);
            CaptureDiagnosticEvent("recursive", "ignored");
        });

        SetDiagnosticEventCallback(callback.get());
        CaptureDiagnosticEvent(AStringView("unit.trailing").substr(0u, 4u), AStringView("message.trailing").substr(0u, 7u), "diagnostics_test.cpp", 42u);
        ClearDiagnosticEventCallback(callback.get());
        CaptureDiagnosticEvent(unitCategory, "ignored");

        const DiagnosticCaptureSnapshot snapshot = ReadDiagnosticCaptureSnapshot();
        captureCount = snapshot.captureCount;
        nonNullFields =
            snapshot.name.data() != nullptr
            && snapshot.category.data() != nullptr
            && snapshot.expression.data() != nullptr
            && snapshot.message.data() != nullptr
            && snapshot.file.data() != nullptr
        ;
        capturedName = snapshot.name;
        capturedCategory = snapshot.category;
        capturedExpression = snapshot.expression;
        capturedMessage = snapshot.message;
    }
    EXPECT_EQ(captureCount, 1u);
    ASSERT_TRUE(nonNullFields);
    EXPECT_EQ(capturedName, StringView(""));
    EXPECT_EQ(capturedCategory, StringView("unit"));
    EXPECT_EQ(capturedExpression, StringView(""));
    EXPECT_EQ(capturedMessage, StringView("message"));
    EXPECT_EQ(DiagnosticEventNameFromCategory("unknown"), StringView());
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_diagnostic_event_tests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static u32 s_DiagnosticEventCaptureCount = 0u;
static AStringView s_DiagnosticEventName = {};
static AStringView s_DiagnosticEventCategory = {};
static AStringView s_DiagnosticEventExpression = {};
static AStringView s_DiagnosticEventMessage = {};
static AStringView s_DiagnosticEventFile = {};
static Array<char, s_MaxEventTextBytes> s_DiagnosticEventNameText = {};
static Array<char, s_MaxEventTextBytes> s_DiagnosticEventCategoryText = {};
static Array<char, s_MaxEventTextBytes> s_DiagnosticEventExpressionText = {};
static Array<char, s_MaxEventTextBytes> s_DiagnosticEventMessageText = {};
static Array<char, s_MaxEventTextBytes> s_DiagnosticEventFileText = {};

void ResetDiagnosticEventCapture()noexcept{
    s_DiagnosticEventCaptureCount = 0u;
    s_DiagnosticEventName = {};
    s_DiagnosticEventCategory = {};
    s_DiagnosticEventExpression = {};
    s_DiagnosticEventMessage = {};
    s_DiagnosticEventFile = {};
    s_DiagnosticEventNameText[0u] = 0;
    s_DiagnosticEventCategoryText[0u] = 0;
    s_DiagnosticEventExpressionText[0u] = 0;
    s_DiagnosticEventMessageText[0u] = 0;
    s_DiagnosticEventFileText[0u] = 0;
}

void RecordDiagnosticEvent(const DiagnosticEventRecord& record)noexcept{
    ++s_DiagnosticEventCaptureCount;
    CopyFixedBuffer(s_DiagnosticEventNameText, record.event);
    CopyFixedBuffer(s_DiagnosticEventCategoryText, record.category);
    CopyFixedBuffer(s_DiagnosticEventExpressionText, record.expression);
    CopyFixedBuffer(s_DiagnosticEventMessageText, record.message);
    CopyFixedBuffer(s_DiagnosticEventFileText, record.file);
    s_DiagnosticEventName = AStringView(s_DiagnosticEventNameText.data());
    s_DiagnosticEventCategory = AStringView(s_DiagnosticEventCategoryText.data());
    s_DiagnosticEventExpression = AStringView(s_DiagnosticEventExpressionText.data());
    s_DiagnosticEventMessage = AStringView(s_DiagnosticEventMessageText.data());
    s_DiagnosticEventFile = AStringView(s_DiagnosticEventFileText.data());
}

DiagnosticCaptureSnapshot ReadDiagnosticCaptureSnapshot()noexcept{
    DiagnosticCaptureSnapshot snapshot;
    snapshot.captureCount = s_DiagnosticEventCaptureCount;
    snapshot.name = s_DiagnosticEventName;
    snapshot.category = s_DiagnosticEventCategory;
    snapshot.expression = s_DiagnosticEventExpression;
    snapshot.message = s_DiagnosticEventMessage;
    snapshot.file = s_DiagnosticEventFile;
    return snapshot;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


