#include <impl/assets_scene/asset.adhd>
#include <impl/assets_scene/component_asset_binary_codec.adhd>
#include <impl/assets_scene/scene_asset_binary_codec.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_ActiveSceneSubsystemsDiagnosticOwner = "ActiveSceneSubsystems";

void LogSceneSubsystemLoadFailed(in Name subsystemName){
    error("{}: failed to load subsystem asset '{}'", s_ActiveSceneSubsystemsDiagnosticOwner, subsystemName.resolvedText());
}

void LogSceneAssetNotSubsystem(in Name subsystemName){
    error("{}: asset '{}' is not a subsystem", s_ActiveSceneSubsystemsDiagnosticOwner, subsystemName.resolvedText());
}

void LogSceneDuplicateSubsystemType(in Name subsystemType, in Name sceneName){
    error(
        "{}: duplicate subsystem type '{}' in scene '{}'"
        , s_ActiveSceneSubsystemsDiagnosticOwner
        , subsystemType.resolvedText()
        , sceneName.resolvedText()
    );
}

void LogSceneComponentLoadFailed(in Name componentName, in Name entityName){
    error(
        "{}: failed to load component asset '{}' for entity '{}'"
        , s_ActiveSceneSubsystemsDiagnosticOwner
        , componentName.resolvedText()
        , entityName.resolvedText()
    );
}

void LogSceneAssetNotComponent(in Name componentName){
    error("{}: asset '{}' is not a component", s_ActiveSceneSubsystemsDiagnosticOwner, componentName.resolvedText());
}

void LogSceneDuplicateComponentType(in Name componentType, in Name entityName){
    error(
        "{}: duplicate component type '{}' on entity '{}'"
        , s_ActiveSceneSubsystemsDiagnosticOwner
        , componentType.resolvedText()
        , entityName.resolvedText()
    );
}

b8 ValidateSceneEntityInstantiationReady(in b8 sceneValid){
    if(sceneValid)
        return true;

    error("{}: cannot instantiate entities before loading a valid scene", s_ActiveSceneSubsystemsDiagnosticOwner);
    return false;
}

b8 ValidateSceneLoadedEntityHasComponents(in b8 hasComponents, in Name entityName){
    if(hasComponents)
        return true;

    error("{}: loaded entity '{}' has no components", s_ActiveSceneSubsystemsDiagnosticOwner, entityName.resolvedText());
    return false;
}

b8 ValidateCreatedSceneEcsEntity(in EntityID entityId, in Name entityName){
    if(entityId.valid())
        return true;

    error("{}: failed to create ECS entity for '{}'", s_ActiveSceneSubsystemsDiagnosticOwner, entityName.resolvedText());
    return false;
}

b8 EntityAsset::validatePayload()const{
    if(!this.checkVirtualPath("EntityAsset::validatePayload"))
        return false;
    if(!ValidateEntityAssetComponentCount(this.m_components.size()))
        return false;
    if(!ValidateUniqueAssetRefs(Span<ComponentRef>(this.m_components), "EntityAsset::validatePayload", "component"))
        return false;
    return true;
}

b8 EntityAsset::loadBinary(in Span<u8> binary){
    EntityAsset candidate(this.virtualPath());
    if(!SceneAssetBinaryCodec().deserializeEntity(binary, candidate.m_components))
        return false;
    if(!candidate.validatePayload())
        return false;
    this = candidate;
    return true;
}

b8 ProjectAsset::validatePayload()const{
    if(!this.checkVirtualPath("ProjectAsset::validatePayload"))
        return false;
    return ValidateProjectAssetPayload(this.m_startScene.valid());
}

b8 ProjectAsset::loadBinary(in Span<u8> binary){
    const Expected<NameHash> startSceneHash = SceneAssetBinaryCodec().deserializeProject(binary);
    if(!startSceneHash.has_value())
        return false;
    const SceneRef startScene(Name(startSceneHash.value()));
    ProjectAsset candidate(this.virtualPath());
    candidate.setStartScene(startScene);
    if(!candidate.validatePayload())
        return false;
    this.m_startScene = startScene;
    return true;
}

b8 SceneAsset::validatePayload()const{
    if(!this.checkVirtualPath("SceneAsset::validatePayload"))
        return false;
    if(!ValidateSceneAssetSubsystemCount(this.m_subsystems.size()))
        return false;
    if(!ValidateUniqueAssetRefs(Span<SubsystemRef>(this.m_subsystems), "SceneAsset::validatePayload", "subsystem"))
        return false;
    if(!ValidateUniqueAssetRefs(Span<EntityRef>(this.m_entities), "SceneAsset::validatePayload", "entity"))
        return false;
    if(!ValidateSceneAssetMap(this.m_assets))
        return false;
    return true;
}

b8 SceneAsset::loadBinary(in Span<u8> binary){
    SceneAsset candidate(this.virtualPath());
    if(!SceneAssetBinaryCodec().deserializeScene(binary, candidate.m_subsystems, candidate.m_entities, candidate.m_assets))
        return false;
    DeduplicateSubsystemRefs(candidate.m_subsystems);
    if(!candidate.validatePayload())
        return false;
    this = candidate;
    return true;
}

b8 TransformComponentAsset::loadBinary(in Span<u8> binary){
    TransformComponentAsset candidate(this.virtualPath());
    if(!ComponentAssetBinaryCodec().loadBinary(binary, candidate))
        return false;
    this.component = candidate.component;
    return true;
}

b8 TransformComponentAsset::loadComponentPayload(in Span<u8> payload){
    const Expected<TransformComponent> component = ComponentAssetBinaryCodec().deserializeTransform(payload);
    if(!component.has_value())
        return false;
    this.component = component.value();
    return true;
}

b8 TransformComponentAsset::validatePayload()const{
    if(!this.checkVirtualPath("TransformComponentAsset::validatePayload"))
        return false;
    return ValidateTransformComponentAssetPayload(this.component, this.virtualPath());
}

b8 TransformComponentAsset::serializeComponentPayload(mut Vector<u8> outPayload)const{
    return ComponentAssetBinaryCodec().serializeTransform(this.component, outPayload);
}

b8 TransformComponentAsset::appendValidatedComponentPayload(mut Vector<u8> outBinary)const{
    return ComponentAssetBinaryCodec().appendTransform(this.component, outBinary);
}

