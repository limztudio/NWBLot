////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_PhysicsMaterialDiagnosticPrefix = "PhysicsMaterial meta";
const StringView s_CollisionLayerMatrixDiagnosticPrefix = "CollisionLayerMatrix meta";
const StringView s_ConvexHullDiagnosticPrefix = "ConvexHull meta";
const StringView s_CompoundHullDiagnosticPrefix = "CompoundHull meta";
const StringView s_CollisionMeshDiagnosticPrefix = "CollisionMesh meta";
const StringView s_HeightfieldDiagnosticPrefix = "Heightfield meta";
const StringView s_SdfDiagnosticPrefix = "Sdf meta";
const StringView s_ChainShapeDiagnosticPrefix = "ChainShape meta";
const StringView s_CompoundShapeDiagnosticPrefix = "CompoundShape meta";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class PhysicsMaterialCookEntry{
    public Name virtualPath = s_NameNone;
    public SurfaceMaterial material;
}

class CollisionLayerMatrixCookEntry{
    public Name virtualPath = s_NameNone;
    public CollisionLayerMatrix matrix;
}

class ConvexHullCookEntry{
    public Name virtualPath = s_NameNone;
    public HullShape hull;
}

class CompoundHullCookEntry{
    public Name virtualPath = s_NameNone;
    public Vector<HullShape> hulls;
}

class CollisionMeshCookEntry{
    public Name virtualPath = s_NameNone;
    public MeshShape mesh;
}

class HeightfieldCookEntry{
    public Name virtualPath = s_NameNone;
    public HeightfieldShape heightfield;
}

class SdfCookEntry{
    public Name virtualPath = s_NameNone;
    public SdfShape sdf;
}

class ChainShapeCookEntry{
    public Name virtualPath = s_NameNone;
    public ChainShape chain;
}

class CompoundShapeCookEntry{
    public Name virtualPath = s_NameNone;
    public CompoundShapeAssetData compound;
}


