b8 AssetByteRangeEquals(in AssetBytes haystack, in usize offset, in AssetBytes needle){
    if(offset > haystack.size() || needle.size() > haystack.size() - offset)
        return false;
    for(usize i = 0u; i < needle.size(); ++i){
        if(haystack[offset + i] != needle[i])
            return false;
    }
    return true;
}

