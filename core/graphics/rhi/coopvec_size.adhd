native{
#include <core/graphics/rhi/coopvec.h>
namespace NWB::Core{
using CooperativeVectorDataTypeValue = CooperativeVectorDataType::Enum;
constexpr CooperativeVectorDataTypeValue s_CoopTypeUInt8 = CooperativeVectorDataType::UInt8;
constexpr CooperativeVectorDataTypeValue s_CoopTypeSInt8 = CooperativeVectorDataType::SInt8;
constexpr CooperativeVectorDataTypeValue s_CoopTypeUInt8Packed = CooperativeVectorDataType::UInt8Packed;
constexpr CooperativeVectorDataTypeValue s_CoopTypeSInt8Packed = CooperativeVectorDataType::SInt8Packed;
constexpr CooperativeVectorDataTypeValue s_CoopTypeUInt16 = CooperativeVectorDataType::UInt16;
constexpr CooperativeVectorDataTypeValue s_CoopTypeSInt16 = CooperativeVectorDataType::SInt16;
constexpr CooperativeVectorDataTypeValue s_CoopTypeUInt32 = CooperativeVectorDataType::UInt32;
constexpr CooperativeVectorDataTypeValue s_CoopTypeSInt32 = CooperativeVectorDataType::SInt32;
constexpr CooperativeVectorDataTypeValue s_CoopTypeUInt64 = CooperativeVectorDataType::UInt64;
constexpr CooperativeVectorDataTypeValue s_CoopTypeSInt64 = CooperativeVectorDataType::SInt64;
constexpr CooperativeVectorDataTypeValue s_CoopTypeFloatE4M3 = CooperativeVectorDataType::FloatE4M3;
constexpr CooperativeVectorDataTypeValue s_CoopTypeFloatE5M2 = CooperativeVectorDataType::FloatE5M2;
constexpr CooperativeVectorDataTypeValue s_CoopTypeFloat16 = CooperativeVectorDataType::Float16;
constexpr CooperativeVectorDataTypeValue s_CoopTypeBFloat16 = CooperativeVectorDataType::BFloat16;
constexpr CooperativeVectorDataTypeValue s_CoopTypeFloat32 = CooperativeVectorDataType::Float32;
constexpr CooperativeVectorDataTypeValue s_CoopTypeFloat64 = CooperativeVectorDataType::Float64;
};
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


usize MapCooperativeVectorTypeSize(in CooperativeVectorDataTypeValue type){
    if(
        type == s_CoopTypeUInt8
        || type == s_CoopTypeSInt8
        || type == s_CoopTypeUInt8Packed
        || type == s_CoopTypeSInt8Packed
        || type == s_CoopTypeFloatE4M3
        || type == s_CoopTypeFloatE5M2
    )
        return 1u;
    if(
        type == s_CoopTypeUInt16
        || type == s_CoopTypeSInt16
        || type == s_CoopTypeFloat16
        || type == s_CoopTypeBFloat16
    )
        return 2u;
    if(
        type == s_CoopTypeUInt32
        || type == s_CoopTypeSInt32
        || type == s_CoopTypeFloat32
    )
        return 4u;
    if(
        type == s_CoopTypeUInt64
        || type == s_CoopTypeSInt64
        || type == s_CoopTypeFloat64
    )
        return 8u;
    return 0u;
}


