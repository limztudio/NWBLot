Expected<DeferredFrameTargets> RendererDeferredSystem::createDeferredFrameTargets(in u32 width, in u32 height){
    if(!ValidDeferredTargetExtent(width, height))
        return MakeUnexpected(Failure());

    mut Device device = this.m_graphics.getDevice();
    const Format albedoFormat = SelectGBufferAlbedoFormat(device);
    const Format normalFormat = SelectGBufferAlbedoFormat(device);
    const Format worldPositionFormat = SelectGBufferAlbedoFormat(device);
    const Format opaqueColorFormat = SelectDeferredOpaqueColorFormat(device);
    const Format depthFormat = SelectGBufferDepthFormat(device);
    const Format csgCapNormalFormat = SelectCsgFormat(s_CsgCapNormalCoreFormat, s_CsgPeelFormatSupport, device);
    const Format csgIntervalDepthFormat = SelectCsgFormat(s_CsgIntervalDepthCoreFormat, s_CsgPeelFormatSupport, device);
    const Format csgIntervalIdFormat = SelectCsgFormat(s_CsgIntervalIdCoreFormat, s_CsgPeelFormatSupport, device);
    const Format csgReceiverEventDataFormat = SelectCsgFormat(s_CsgReceiverEventDataCoreFormat, s_CsgStorageFormatSupport, device);
    const Format csgReceiverEventCountFormat = SelectCsgFormat(s_CsgReceiverEventCountCoreFormat, s_CsgStorageFormatSupport, device);
    const Format csgReceiverSpanDataFormat = SelectCsgFormat(s_CsgReceiverSpanDataCoreFormat, s_CsgStorageFormatSupport, device);
    const Format csgReceiverSpanCountFormat = SelectCsgFormat(s_CsgReceiverSpanCountCoreFormat, s_CsgStorageFormatSupport, device);
    const Format csgRemovedIntervalDepthFormat = SelectCsgFormat(s_CsgRemovedIntervalDepthCoreFormat, s_CsgStorageFormatSupport, device);
    const Format csgRemovedIntervalCapNormalFormat = SelectCsgFormat(s_CsgRemovedIntervalCapNormalCoreFormat, s_CsgStorageFormatSupport, device);
    const Format csgRemovedIntervalDataFormat = SelectCsgFormat(s_CsgRemovedIntervalDataCoreFormat, s_CsgStorageFormatSupport, device);
    const Format csgRemovedIntervalCountFormat = SelectCsgFormat(s_CsgRemovedIntervalCountCoreFormat, s_CsgStorageFormatSupport, device);
    const b8 gbufferFormatsKnown =
        albedoFormat != Format::UNKNOWN
        && normalFormat != Format::UNKNOWN
        && worldPositionFormat != Format::UNKNOWN
        && opaqueColorFormat != Format::UNKNOWN
        && depthFormat != Format::UNKNOWN
    ;
    const b8 csgPeelFormatsKnown =
        csgCapNormalFormat != Format::UNKNOWN
        && csgIntervalDepthFormat != Format::UNKNOWN
        && csgIntervalIdFormat != Format::UNKNOWN
    ;
    const b8 csgStorageFormatsKnown =
        csgReceiverEventDataFormat != Format::UNKNOWN
        && csgReceiverEventCountFormat != Format::UNKNOWN
        && csgReceiverSpanDataFormat != Format::UNKNOWN
        && csgReceiverSpanCountFormat != Format::UNKNOWN
        && csgRemovedIntervalDepthFormat != Format::UNKNOWN
        && csgRemovedIntervalCapNormalFormat != Format::UNKNOWN
        && csgRemovedIntervalDataFormat != Format::UNKNOWN
        && csgRemovedIntervalCountFormat != Format::UNKNOWN
    ;
    if(!AllDeferredTargetFormatsKnown(gbufferFormatsKnown, csgPeelFormatsKnown, csgStorageFormatsKnown)){
        LogUnsupportedDeferredTargetFormats();
        return MakeUnexpected(Failure());
    }
    if(!this.createDeferredLightingResources())
        return MakeUnexpected(Failure());
    if(!this.createDeferredCompositeResources())
        return MakeUnexpected(Failure());

    this.m_deferredState.m_lightingPipeline.reset();
    this.m_deferredState.m_compositeComputePipeline.reset();
    this.m_deferredState.m_presentPipeline.reset();

    DeferredFrameTargets createdTargets;
    createdTargets.width = width;
    createdTargets.height = height;
    createdTargets.albedoFormat = albedoFormat;
    createdTargets.normalFormat = normalFormat;
    createdTargets.worldPositionFormat = worldPositionFormat;
    createdTargets.specularRoughnessFormat = worldPositionFormat;
    createdTargets.opaqueColorFormat = opaqueColorFormat;
    createdTargets.compositeColorFormat = opaqueColorFormat;
    createdTargets.depthFormat = depthFormat;
    createdTargets.csgCapNormalFormat = csgCapNormalFormat;
    createdTargets.csgIntervalDepthFormat = csgIntervalDepthFormat;
    createdTargets.csgIntervalIdFormat = csgIntervalIdFormat;
    createdTargets.csgReceiverEventDataFormat = csgReceiverEventDataFormat;
    createdTargets.csgReceiverEventCountFormat = csgReceiverEventCountFormat;
    createdTargets.csgReceiverSpanDataFormat = csgReceiverSpanDataFormat;
    createdTargets.csgReceiverSpanCountFormat = csgReceiverSpanCountFormat;
    createdTargets.csgRemovedIntervalDepthFormat = csgRemovedIntervalDepthFormat;
    createdTargets.csgRemovedIntervalCapNormalFormat = csgRemovedIntervalCapNormalFormat;
    createdTargets.csgRemovedIntervalDataFormat = csgRemovedIntervalDataFormat;
    createdTargets.csgRemovedIntervalCountFormat = csgRemovedIntervalCountFormat;
    createdTargets.csgPeelLayerCount = s_CsgPeelLayerCount;
    createdTargets.csgReceiverEventLayerCount = s_CsgReceiverEventLayerCount;
    createdTargets.csgReceiverSpanLayerCount = s_CsgReceiverSpanLayerCount;
    createdTargets.csgRemovedIntervalLayerCount = s_CsgRemovedIntervalLayerCount;

    const Expected<TextureHandle> albedo = CreateDeferredTargetTexture(createdTargets.width, createdTargets.height, createdTargets.albedoFormat, false, true, s_ClearColor, s_DeferredAlbedoTargetName, "RendererSystem: failed to create deferred albedo target", this.m_graphics);
    if(!albedo.has_value())
        return MakeUnexpected(Failure());
    createdTargets.albedo = albedo.value();
    const Expected<TextureHandle> normal = CreateDeferredTargetTexture(createdTargets.width, createdTargets.height, createdTargets.normalFormat, false, true, s_GBufferNormalClearColor, s_DeferredNormalTargetName, "RendererSystem: failed to create deferred normal target", this.m_graphics);
    if(!normal.has_value())
        return MakeUnexpected(Failure());
    createdTargets.normal = normal.value();
    const Expected<TextureHandle> worldPosition = CreateDeferredTargetTexture(createdTargets.width, createdTargets.height, createdTargets.worldPositionFormat, false, true, s_GBufferWorldPositionClearColor, s_DeferredWorldPositionTargetName, "RendererSystem: failed to create deferred world-position target", this.m_graphics);
    if(!worldPosition.has_value())
        return MakeUnexpected(Failure());
    createdTargets.worldPosition = worldPosition.value();
    const Expected<TextureHandle> specularRoughness = CreateDeferredTargetTexture(createdTargets.width, createdTargets.height, createdTargets.specularRoughnessFormat, false, true, s_GBufferSpecularRoughnessClearColor, s_DeferredSpecularRoughnessTargetName, "RendererSystem: failed to create deferred specular/roughness target", this.m_graphics);
    if(!specularRoughness.has_value())
        return MakeUnexpected(Failure());
    createdTargets.specularRoughness = specularRoughness.value();
    const Expected<TextureHandle> opaqueColor = CreateDeferredTargetTexture(createdTargets.width, createdTargets.height, createdTargets.opaqueColorFormat, true, true, s_ClearColor, s_DeferredOpaqueColorTargetName, "RendererSystem: failed to create deferred opaque color target", this.m_graphics);
    if(!opaqueColor.has_value())
        return MakeUnexpected(Failure());
    createdTargets.opaqueColor = opaqueColor.value();
    const Expected<TextureHandle> compositeColor = CreateDeferredTargetTexture(createdTargets.width, createdTargets.height, createdTargets.compositeColorFormat, true, true, s_ClearColor, s_DeferredCompositeColorTargetName, "RendererSystem: failed to create deferred composite color target", this.m_graphics);
    if(!compositeColor.has_value())
        return MakeUnexpected(Failure());
    createdTargets.compositeColor = compositeColor.value();
    const Expected<TextureHandle> depth = CreateDeferredTargetTexture(createdTargets.width, createdTargets.height, createdTargets.depthFormat, false, false, s_ClearColor, s_DeferredDepthTargetName, "RendererSystem: failed to create deferred depth target", this.m_graphics);
    if(!depth.has_value())
        return MakeUnexpected(Failure());
    createdTargets.depth = depth.value();

    Array<FramebufferAttachment, s_MeshGbufferTargetCount> gbufferAttachments;
    gbufferAttachments[s_MeshGbufferBaseColorLocation].setTexture(createdTargets.albedo.deref()).setSubresources(s_FramebufferSubresources);
    gbufferAttachments[s_MeshGbufferNormalLocation].setTexture(createdTargets.normal.deref()).setSubresources(s_FramebufferSubresources);
    gbufferAttachments[s_MeshGbufferWorldPositionLocation].setTexture(createdTargets.worldPosition.deref()).setSubresources(s_FramebufferSubresources);
    gbufferAttachments[s_MeshGbufferSpecularRoughnessLocation].setTexture(createdTargets.specularRoughness.deref()).setSubresources(s_FramebufferSubresources);
    FramebufferDesc framebufferDesc;
    for(in FramebufferAttachment attachment : gbufferAttachments)
        framebufferDesc.addColorAttachment(attachment);
    framebufferDesc.setDepthAttachment(createdTargets.depth.deref(), s_FramebufferSubresources);
    const Expected<FramebufferHandle> framebufferResult = device.createFramebuffer(framebufferDesc);
    if(!framebufferResult.has_value()){
        createdTargets.framebuffer.reset();
        error("RendererSystem: failed to create deferred framebuffer");
        return MakeUnexpected(Failure());
    }
    createdTargets.framebuffer = framebufferResult.value();

    return createdTargets;
}

static_assert(s_CsgCapNormalCoreFormat == s_ShaderCsgCapNormalCoreFormat);
static_assert(s_CsgIntervalDepthCoreFormat == s_ShaderCsgIntervalDepthCoreFormat);
static_assert(s_CsgIntervalIdCoreFormat == s_ShaderCsgIntervalIdCoreFormat);
static_assert(s_CsgReceiverEventDataCoreFormat == s_ShaderCsgReceiverEventDataCoreFormat);
static_assert(s_CsgReceiverEventCountCoreFormat == s_ShaderCsgReceiverEventCountCoreFormat);
static_assert(s_CsgReceiverSpanDataCoreFormat == s_ShaderCsgReceiverSpanDataCoreFormat);
static_assert(s_CsgReceiverSpanCountCoreFormat == s_ShaderCsgReceiverSpanCountCoreFormat);
static_assert(s_CsgRemovedIntervalDepthCoreFormat == s_ShaderCsgRemovedIntervalDepthCoreFormat);
static_assert(s_CsgRemovedIntervalCapNormalCoreFormat == s_ShaderCsgRemovedIntervalCapNormalCoreFormat);
static_assert(s_CsgRemovedIntervalDataCoreFormat == s_ShaderCsgRemovedIntervalDataCoreFormat);
static_assert(s_CsgRemovedIntervalCountCoreFormat == s_ShaderCsgRemovedIntervalCountCoreFormat);
static_assert(s_MeshGbufferBaseColorLocation == s_ShaderMeshGbufferBaseColorLocation);
static_assert(s_MeshGbufferNormalLocation == s_ShaderMeshGbufferNormalLocation);
static_assert(s_MeshGbufferWorldPositionLocation == s_ShaderMeshGbufferWorldPositionLocation);
static_assert(s_MeshGbufferSpecularRoughnessLocation == s_ShaderMeshGbufferSpecularRoughnessLocation);
static_assert(s_MeshGbufferTargetCount == s_ShaderMeshGbufferTargetCount);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 DeferredFrameTargets::valid()const{
    if(!s_RuntimeAssertionsEnabled)
        return this.framebuffer.valid();
    return
        ValidDeferredTargetExtent(this.width, this.height)
        && this.albedoFormat != Format::UNKNOWN
        && this.normalFormat != Format::UNKNOWN
        && this.worldPositionFormat != Format::UNKNOWN
        && this.specularRoughnessFormat != Format::UNKNOWN
        && this.opaqueColorFormat != Format::UNKNOWN
        && this.compositeColorFormat != Format::UNKNOWN
        && this.depthFormat != Format::UNKNOWN
        && this.csgIntervalTargetsValid()
        && this.albedo.valid()
        && this.normal.valid()
        && this.worldPosition.valid()
        && this.specularRoughness.valid()
        && this.opaqueColor.valid()
        && this.compositeColor.valid()
        && this.depth.valid()
        && this.framebuffer.valid()
        && this.bindless.valid()
        && this.avboit.valid()
    ;
}

b8 RendererDeferredSystem::createLaggedLightingHistoryResources(mut DeferredFrameTargets targets){
    mut DeferredLaggedLightingHistoryResources history = targets.laggedLightingHistory;
    if(history.valid())
        return true;
    assert(targets.bindless.valid());
    assert(targets.shadowVisibility.valid());
    assert(targets.causticIrradiance.valid());
    assert(targets.surfelIrradiance.valid());
    this.resetLaggedLightingHistoryResources(targets);
    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
    if(!heap.isInitialized()){
        LogLaggedLightingHistoryHeapMissing();
        return false;
    }

    TextureDesc shadowHistoryDesc;
    shadowHistoryDesc
        .setWidth(targets.width)
        .setHeight(targets.height)
        .setArraySize(s_SceneShadowSlotCount)
        .setDimension(TextureDimension::Texture2DArray)
        .setFormat(targets.shadowVisibilityFormat)
        .setInitialState(ResourceStates::Common)
        .setKeepInitialState(true)
        .setQueueSharing(ResourceQueueSharing::GraphicsAsyncComputeAndTransfer)
        .setName("engine/temporal/lagged_shadow_visibility")
    ;
    auto shadowVisibilityResult = this.m_graphics.createTexture(shadowHistoryDesc);
    if(!shadowVisibilityResult.has_value()){
        error("RendererSystem: failed to create lagged shadow-visibility history");
        this.resetLaggedLightingHistoryResources(targets);
        return false;
    }
    history.shadowVisibility = shadowVisibilityResult.value();

    TextureDesc irradianceHistoryDesc;
    irradianceHistoryDesc
        .setWidth(targets.width)
        .setHeight(targets.height)
        .setFormat(targets.causticIrradianceFormat)
        .setInitialState(ResourceStates::Common)
        .setKeepInitialState(true)
        .setQueueSharing(ResourceQueueSharing::GraphicsAsyncComputeAndTransfer)
        .setName("engine/temporal/lagged_caustic_irradiance")
    ;
    auto causticIrradianceResult = this.m_graphics.createTexture(irradianceHistoryDesc);
    if(!causticIrradianceResult.has_value()){
        error("RendererSystem: failed to create lagged caustic-irradiance history");
        this.resetLaggedLightingHistoryResources(targets);
        return false;
    }
    history.causticIrradiance = causticIrradianceResult.value();

    irradianceHistoryDesc.setFormat(targets.surfelIrradianceFormat).setName("engine/temporal/lagged_surfel_irradiance");
    auto surfelIrradianceResult = this.m_graphics.createTexture(irradianceHistoryDesc);
    if(!surfelIrradianceResult.has_value()){
        error("RendererSystem: failed to create lagged surfel-irradiance history");
        this.resetLaggedLightingHistoryResources(targets);
        return false;
    }
    history.surfelIrradiance = surfelIrradianceResult.value();

    const Expected<GpuDescriptorHandle> shadowVisibilityDescriptor = RegisterSampledTexture(heap, GpuDescriptorClass::SampledImage2DArray, history.shadowVisibility, targets.shadowVisibilityFormat, s_ShadowVisibilitySubresources, TextureDimension::Texture2DArray);
    if(!shadowVisibilityDescriptor.has_value()){
        error("RendererSystem: failed to register lagged lighting-history images in the descriptor heap");
        this.resetLaggedLightingHistoryResources(targets);
        return false;
    }
    history.shadowVisibilityDescriptor = shadowVisibilityDescriptor.value();

    const Expected<GpuDescriptorHandle> causticIrradianceDescriptor = RegisterSampledTexture(heap, GpuDescriptorClass::SampledImage, history.causticIrradiance, targets.causticIrradianceFormat, s_FramebufferSubresources, TextureDimension::Texture2D);
    if(!causticIrradianceDescriptor.has_value()){
        error("RendererSystem: failed to register lagged lighting-history images in the descriptor heap");
        this.resetLaggedLightingHistoryResources(targets);
        return false;
    }
    history.causticIrradianceDescriptor = causticIrradianceDescriptor.value();

    const Expected<GpuDescriptorHandle> surfelIrradianceDescriptor = RegisterSampledTexture(heap, GpuDescriptorClass::SampledImage, history.surfelIrradiance, targets.surfelIrradianceFormat, s_FramebufferSubresources, TextureDimension::Texture2D);
    if(!surfelIrradianceDescriptor.has_value()){
        error("RendererSystem: failed to register lagged lighting-history images in the descriptor heap");
        this.resetLaggedLightingHistoryResources(targets);
        return false;
    }
    history.surfelIrradianceDescriptor = surfelIrradianceDescriptor.value();

    history.slots = DeferredBindlessSlotsBuilder().buildHistory(
        targets.bindless.slots,
        history.shadowVisibilityDescriptor.slot(),
        history.causticIrradianceDescriptor.slot(),
        history.surfelIrradianceDescriptor.slot()
    );

    BufferDesc slotsBufferDesc;
    slotsBufferDesc
        .setByteSize(size_of<DeferredBindlessResourceSlots>())
        .setIsConstantBuffer(true)
        .setDebugName("ECSRender_DeferredLaggedLightingResourceSlots")
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
        .enableAutomaticStateTracking(ResourceStates::Common)
    ;
    auto slotsBufferResult = this.m_graphics.createBuffer(slotsBufferDesc);
    if(!slotsBufferResult.has_value()){
        error("RendererSystem: failed to create lagged lighting-history slot buffer");
        this.resetLaggedLightingHistoryResources(targets);
        return false;
    }
    history.slotsBuffer = slotsBufferResult.value();

    const Expected<GpuDescriptorHandle> slotsBufferDescriptor = RegisterConstantBuffer(heap, history.slotsBuffer);
    if(!slotsBufferDescriptor.has_value()){
        error("RendererSystem: failed to register lagged lighting-history slot buffer in the descriptor heap");
        this.resetLaggedLightingHistoryResources(targets);
        return false;
    }

    history.slotsBufferDescriptor = slotsBufferDescriptor.value();
    history.generation = AllocateWrappingIdentity<DeferredLaggedLightingHistoryResources>();
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

