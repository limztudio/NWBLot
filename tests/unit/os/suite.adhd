class SelectionTextInput : QueuedTextInputService{
    [cpp_base(QueuedTextInputService, storage)]
    public SelectionTextInput(mut HeapStorage storage){}
    public TextInputCapabilities capabilities()const override{ return FullTestTextInputCapabilities(); }

    public TextInputAdmission sendCommit(in TextInputSessionToken token, in StringView text){ return this.emitCommit(token, text); }
    public TextInputAdmission sendPreedit(in TextInputSessionToken token, in StringView text, in usize anchor, in usize caret){ return this.emitPreedit(token, text, anchor, caret); }
    public TextInputAdmission sendPreedit(in TextInputSessionToken token, in StringView text, in usize anchor, in usize caret, in b8 visible){ return this.emitPreedit(token, text, anchor, caret, visible); }
    public TextInputAdmission sendPreedit(in TextInputSessionToken token, in StringView text, in usize anchor, in usize caret, in b8 visible, in Span<TextInputPreeditClause> clauses){ return this.emitPreedit(token, text, anchor, caret, visible, clauses); }
    public TextInputAdmission sendDeletion(in TextInputSessionToken token, in usize before, in usize after, in u64 revision, in TextInputDeletionBasis basis){ return this.emitDeleteSurrounding(token, before, after, revision, basis); }
}

class FakeClipboardService : QueuedClipboardService{
    [cpp_base(QueuedClipboardService, storage)]
    public FakeClipboardService(mut HeapStorage storage){}

    public String m_text;
    public OsServiceHook m_onRead;
    public ClipboardStatus m_readStatus = ClipboardStatus::Success;
    public usize m_readCount = 0u;
    public usize m_writeCount = 0u;
    private ClipboardRequestToken m_nativeToken;

    public ClipboardCapabilities capabilities(in ClipboardChannel channel)const override{ return TestClipboardTextCapabilities(channel); }
    public void startNativeRequest(in ClipboardRequestToken token, in ClipboardOperation operation, in ClipboardChannel channel, in StringView input)override{
        this.m_nativeToken = token;
        if(operation == ClipboardOperation::ReadText){
            ++this.m_readCount;
            if(this.m_onRead)
                this.m_onRead();
            if(this.m_nativeToken != token)
                return;
            this.m_nativeToken = ClipboardRequestToken();
            if(!this.completeNativeRequest(token, this.m_readStatus, this.m_text))
                TerminateInvariant();
        }
        else{
            ++this.m_writeCount;
            this.m_text.assign(input);
            this.m_nativeToken = ClipboardRequestToken();
            if(!this.completeNativeRequest(token, ClipboardStatus::Success))
                TerminateInvariant();
        }
    }
    public void cancelNativeRequest(in ClipboardRequestToken token)override{
        if(this.m_nativeToken == token)
            this.m_nativeToken = ClipboardRequestToken();
    }
}

class DelayedClipboardService : QueuedClipboardService{
    [cpp_base(QueuedClipboardService, storage)]
    public DelayedClipboardService(mut HeapStorage storage){}

    public String m_startedText;
    public OsServiceHook m_onStart;
    public OsServiceHook m_onCancel;
    public ClipboardRequestToken m_nativeToken;
    public ClipboardOperation m_nativeOperation = ClipboardOperation::ReadText;
    public usize m_startCount = 0u;
    public usize m_cancelCount = 0u;

    public ClipboardCapabilities capabilities(in ClipboardChannel channel)const override{ return TestClipboardTextCapabilities(channel); }
    public b8 deliver(in ClipboardRequestToken token, in ClipboardStatus status){ return this.deliver(token, status, ""); }
    public b8 deliver(in ClipboardRequestToken token, in ClipboardStatus status, in StringView text){
        const b8 completed = this.completeNativeRequest(token, status, text);
        if(completed && token == this.m_nativeToken)
            this.m_nativeToken = ClipboardRequestToken();
        return completed;
    }
    public void startNativeRequest(in ClipboardRequestToken token, in ClipboardOperation operation, in ClipboardChannel channel, in StringView text)override{
        this.m_nativeToken = token;
        this.m_nativeOperation = operation;
        this.m_startedText.assign(text);
        ++this.m_startCount;
        if(this.m_onStart)
            this.m_onStart();
    }
    public void cancelNativeRequest(in ClipboardRequestToken token)override{
        ++this.m_cancelCount;
        if(this.m_nativeToken == token)
            this.m_nativeToken = ClipboardRequestToken();
        if(this.m_onCancel)
            this.m_onCancel();
    }
}

class FakeTextInputService : QueuedTextInputService{
    [cpp_base(QueuedTextInputService, storage)]
    public FakeTextInputService(mut HeapStorage storage){}

    public TextInputAdmission sendCommit(in TextInputSessionToken token, in StringView text){ return this.emitCommit(token, text); }
    public TextInputAdmission sendPreedit(in TextInputSessionToken token, in StringView text, in usize anchor, in usize caret){ return this.emitPreedit(token, text, anchor, caret); }
    public TextInputAdmission sendPreedit(in TextInputSessionToken token, in StringView text, in usize anchor, in usize caret, in b8 visible){ return this.emitPreedit(token, text, anchor, caret, visible); }
    public TextInputAdmission sendPreedit(in TextInputSessionToken token, in StringView text, in usize anchor, in usize caret, in b8 visible, in Span<TextInputPreeditClause> clauses){ return this.emitPreedit(token, text, anchor, caret, visible, clauses); }
    public TextInputAdmission sendDeletion(in TextInputSessionToken token, in usize before, in usize after, in u64 revision, in TextInputDeletionBasis basis){ return this.emitDeleteSurrounding(token, before, after, revision, basis); }

    public String m_nativeSurrounding;
    public OsServiceHook m_onStart;
    public OsServiceHook m_onCaret;
    public OsServiceHook m_onSurrounding;
    public OsSessionHook m_onEnd;
    public TextInputSessionToken m_nativeToken;
    public usize m_endCount = 0u;
    public TextInputAdmission m_startAdmission = TextInputAdmission::Accepted;
    public TextInputChangeCause m_nativeCause = TextInputChangeCause::Other;
    public b8 m_supported = true;

    public TextInputCapabilities capabilities()const override{
        if(this.m_supported)
            return FullTestTextInputCapabilities();
        return TextInputCapabilities();
    }
    public b8 sendCancel(in TextInputSessionToken token, in TextInputCancelReason reason){ return this.cancelSession(token, reason); }
    public StringView currentText()const{ return this.surroundingText(); }
    public usize currentCaretByte()const{ return this.surroundingCaretByte(); }
    public TextInputRect currentRectangle()const{ return this.caretRect(); }
    public TextInputAdmission startNativeSession(in TextInputSessionToken token, in TextInputSessionDesc desc)override{
        this.m_nativeToken = token;
        this.m_nativeSurrounding.assign(desc.surrounding);
        if(this.m_onStart)
            this.m_onStart();
        return this.m_startAdmission;
    }
    public void endNativeSession(in TextInputSessionToken token)override{
        EXPECT_FALSE(this.activeSession().valid());
        this.m_nativeToken = TextInputSessionToken();
        ++this.m_endCount;
        if(this.m_onEnd)
            this.m_onEnd(token);
    }
    public TextInputAdmission updateNativeCaret(in TextInputRect rectangle)override{
        if(this.m_onCaret)
            this.m_onCaret();
        return TextInputAdmission::Accepted;
    }
    public void updateNativeSurrounding(in StringView text, in usize anchor, in usize caret, in u64 revision, in TextInputChangeCause cause)override{
        this.m_nativeSurrounding.assign(text);
        this.m_nativeCause = cause;
        if(this.m_onSurrounding)
            this.m_onSurrounding();
    }
}

