    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryUp, MakeUiContextPoint(180.0f, 180.0f))).pointerConsumed);
    EXPECT_FALSE(self.m_router.wantsPointer());
    EXPECT_FALSE(self.m_router.consumeActivation(base.id));
}

void VerifyUiContextMenuInputTests_PopupTriggersCopyTheExactScopeAndClosingItRetiresQueuedIntentions(mut UiContextMenuInputTests self){
    const PopupScope scope = MakeUiContextMenuScope(1u);
