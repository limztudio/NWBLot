////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_sampler/asset.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SamplerGpuResource : NoCopy{
    public SamplerHandle sampler;
    public GpuDescriptorHandle samplerHeapHandle = GpuDescriptorHandleInvalid();


    public b8 valid()const{
        return this.sampler.valid() && this.samplerHeapHandle.valid();
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_SamplerDescriptorBindingSlot = 0u;

Name ResolveSamplerDebugName(in Name debugName, in Name assetVirtualPath){
    if(debugName != s_NameNone)
        return debugName;
    return assetVirtualPath;
}

b8 HasInitializedSamplerResourceState(in b8 hasSampler, in b8 hasDescriptorHandle){
    return hasSampler || hasDescriptorHandle;
}

b8 CreateSamplerGpuResource(in Sampler samplerAsset, in Name debugName, in StringView ownerName, mut GraphicsRuntime graphics, mut SamplerGpuResource outResource){
    const Name samplerName = ResolveSamplerDebugName(debugName, samplerAsset.virtualPath());
    assert(!outResource.valid());
    if(HasInitializedSamplerResourceState(outResource.sampler.valid(), outResource.samplerHeapHandle.valid())){
        error("{}: sampler resource is partially initialized; release it before recreating", ownerName);
        return false;
    }
    // Sampler::loadBinary already validated the cooked description; keep a debug-only invariant here.
    assert(samplerAsset.validatePayload());

    mut Device device = graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized()){
        error("{}: cannot load sampler '{}' without an initialized descriptor heap", ownerName, samplerName.resolvedText());
        return false;
    }

    Expected<SamplerHandle> samplerResult = device.createSampler(samplerAsset.description());
    if(!samplerResult.has_value()){
        error("{}: failed to create sampler '{}'", ownerName, samplerName.resolvedText());
        return false;
    }
    mut SamplerHandle sampler = samplerResult.value();

    const Expected<GpuDescriptorHandle> samplerHandleResult = heap.allocate(GpuDescriptorClass::Sampler);
    if(!samplerHandleResult.has_value()){
        error("{}: failed to allocate a bindless sampler slot for '{}'", ownerName, samplerName.resolvedText());
        return false;
    }
    const GpuDescriptorHandle samplerHandle = samplerHandleResult.value();
    GpuDescriptorRetirementGuard releaseDescriptor(heap, samplerHandle);
    if(!heap.write(samplerHandle, DescriptorWriteItemSampler(s_SamplerDescriptorBindingSlot, sampler.deref()))){
        error("{}: failed to write the bindless sampler slot for '{}'", ownerName, samplerName.resolvedText());
        return false;
    }

    outResource.sampler = sampler;
    outResource.samplerHeapHandle = samplerHandle;
    releaseDescriptor.release();
    return true;
}

b8 LoadSamplerGpuResource(in AssetRef<Sampler> samplerAsset, in Name debugName, in StringView ownerName, mut GraphicsRuntime graphics, in AssetManager assetManager, mut SamplerGpuResource outResource){
    if(!CheckAssetLoaderEnter(samplerAsset, outResource, ownerName))
        return outResource.valid();

    const Name samplerVirtualPath = samplerAsset.name();

    Expected<UniquePtr<Sampler>> loadedAsset = LoadTypedAssetSync<Sampler>(assetManager, samplerVirtualPath, ownerName);
    if(!loadedAsset.has_value() || !loadedAsset.value().valid())
        return false;

    return CreateSamplerGpuResource(loadedAsset.value().deref(), debugName, ownerName, graphics, outResource);
}

void ReleaseSamplerGpuResource(mut GraphicsRuntime graphics, mut SamplerGpuResource inOutResource){
    if(inOutResource.samplerHeapHandle.valid()){
        mut GpuDescriptorHeap heap = graphics.getDevice().getDescriptorHeap();
        if(heap.isInitialized())
            heap.free(inOutResource.samplerHeapHandle);
        inOutResource.samplerHeapHandle = GpuDescriptorHandleInvalid();
    }

    inOutResource.sampler.reset();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

