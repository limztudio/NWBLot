            return false;
        const BodyId bodyId = found.value().bodyId;
        if(!this.m_physicsWorld.applyForceAtPoint(bodyId, force, worldPoint, wake))
            return false;
        if(wake)
            this.syncEcsRigidBodyRuntimeState(entity, bodyId);
        return true;
    }

