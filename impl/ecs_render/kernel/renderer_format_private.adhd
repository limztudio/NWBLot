[[nodiscard]] FOUNDATION_INLINE constexpr KernelColor MakeKernelColor(const f32 r, const f32 g, const f32 b, const f32 a)noexcept{
    return Core::Color(r, g, b, a);
}

[[nodiscard]] FOUNDATION_INLINE b8 HasLiveKernelBuffer(const KernelBufferHandle& buffer)noexcept{
