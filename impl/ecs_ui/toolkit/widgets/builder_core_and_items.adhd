#include <impl/ecs_ui/toolkit/builder.adhd>
#include <impl/ecs_ui/toolkit/widgets/control_style_metrics.adhd>
#include <impl/ecs_ui/toolkit/widgets/control_visual_painter.adhd>
#include <impl/ecs_ui/toolkit/widgets/hit_target_factory.adhd>
#include <impl/ecs_ui/toolkit/widgets/ui_scope_descriptor_factory.adhd>
#include <impl/ecs_ui/toolkit/widgets/popup_style.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Rect s_FullImageUvRect = Rect(0.0f, 0.0f, 1.0f, 1.0f);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsValidPanelDirection(in LayoutDirection direction){
    return direction == LayoutDirection::Row || direction == LayoutDirection::Column;
}

b8 IsValidSeparatorDeclaration(in SeparatorOptions options){
    return options.direction <= SeparatorDirection::Vertical && IsFinite(VectorSingle(options.thickness)) && options.thickness >= 0.0f;
}

b8 IsBasicControlInteractive(in WidgetKind kind){
    return kind == WidgetKind::Button || kind == WidgetKind::Checkbox;
}

b8 NeedsBasicControlHitTarget(in b8 interactive, in b8 annotated){
    return interactive || annotated;
}

LayoutNodeDesc BuildSizedLeafNodeDesc(in LayoutSize width, in LayoutSize height, in Point intrinsicSize){
    LayoutNodeDesc description;
    description.width = width;
    description.height = height;
    description.intrinsicSize = intrinsicSize;
    return description;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 Builder::beginPanel(in StringView stableKey, in Rect bounds, in LayoutDirection direction){
    if(this.declarationBlocked() || this.m_scope.value().m_panelActive || this.m_scope.value().m_windowActive || !this.m_skin.has_value() || !IsValidPanelDirection(direction)){
        this.m_context.fail();
        return false;
    }
    const auto panel = this.region(this.m_style.panel, this.m_style.panel);
    const auto state = this.m_context.declare(stableKey, WidgetKind::Panel);
    if(!panel.has_value() || !state.has_value()){
        this.m_context.fail();
        return false;
    }
    this.reset();
    this.m_scope.value().m_panelStyle = this.m_style;
    this.m_scope.value().m_panelState = state.value();
    this.m_scope.value().m_bounds = bounds;
    const LayoutNodeDesc description = UiScopeDescriptorFactory().panelRoot(bounds, direction, panel.value().padding, this.m_style.gap);
    u32 node = 0u;
    const auto admittedNode = this.m_scope.value().m_layout.addNode(s_LayoutNoParent, description);
    if(!admittedNode.has_value() || !this.m_context.pushScope(stableKey)){
        this.m_context.fail();
        return false;
    }
    node = admittedNode.value();
    this.m_scope.value().m_stack.push_back(node);
    this.m_scope.value().m_panelActive = true;
    return true;
}

b8 Builder::endPanel(){
    if(this.declarationBlocked() || !this.m_scope.value().m_panelActive || this.m_scope.value().m_windowActive || this.m_scope.value().m_popupState.has_value() || this.m_scope.value().m_stack.size() != 1u
        || this.m_context.failed() || !this.m_scope.value().m_layout.arrange(this.m_scope.value().m_bounds)){
        this.m_context.fail();
        return false;
    }
    this.m_finalizing = true;
    BuilderOperationEnd finish(this.m_finalizing);
    const b8 painted = this.paintPanel();
    const b8 popped = this.m_context.popScope();
    this.m_scope.value().m_panelActive = false;
    this.m_scope.value().m_stack.clear();
    const b8 combosPainted = painted && popped && this.paintDeferred();
    this.publishSliderResults(combosPainted);
    this.releaseDeferredLoans();
    if(!combosPainted)
        this.m_context.fail();
    return combosPainted;
}

b8 Builder::endContainer(){
    if(this.declarationBlocked() || !this.m_scope.value().m_panelActive || this.m_scope.value().m_stack.size() <= 1u){
        this.m_context.fail();
        return false;
    }
    this.m_scope.value().m_stack.pop_back();
    return this.m_context.popScope();
}

b8 Builder::button(in StringView stableKey, in StringView text, in WidgetOptions options){
    const auto item = this.addItem(stableKey, text, WidgetKind::Button, options);
    return item.has_value() && this.m_context.takeActivation(item.value().state, item.value().enabled);
}

b8 Builder::checkbox(in StringView stableKey, in StringView text, mut b8 checked, in WidgetOptions options){
    const auto item = this.addItem(stableKey, text, WidgetKind::Checkbox, options);
    if(!item.has_value())
        return false;
    const b8 changed = this.m_context.takeActivation(item.value().state, item.value().enabled);
    if(changed)
        checked = !checked;
    item.value().checked = checked;
    return changed;
}

b8 Builder::selectable(in StringView stableKey, in StringView text, in b8 selected, in WidgetOptions options){
    const auto item = this.addItem(stableKey, text, WidgetKind::Selectable, options);
    if(!item.has_value())
        return false;
    item.value().selectableStyleIndex = this.currentSelectableStyleIndex();
    item.value().checked = selected;
    return this.m_context.takeActivation(item.value().state, item.value().enabled);
}

void Builder::reset(){
    if(this.declarationBlocked()){
        this.m_context.fail();
        return;
    }
    if(this.m_scope.value().m_panelActive || this.m_scope.value().m_windowActive)
        this.m_context.fail();
    this.m_scope = Optional<mut BuilderScopeFrame>(this.m_scopeFrame);
    this.m_scopeFrame.reset();
    for(mut auto frame : this.m_popupFrames){
        if(frame.valid())
            frame.value().reset();
    }
    this.m_popupFrameCount = 0u;
    this.m_itemStyles.clear();
    this.m_itemSelectableStyles.clear();
    this.m_widgetStyleDirty = true;
    this.m_selectableStyleDirty = true;
    ++this.m_editViewFrameCounter;
    if(this.m_editBoxCacheEntries.size() >= 256u){
        this.m_editBoxCacheIndex.clear();
        this.m_editBoxCacheEntries.clear();
    }
}

b8 Builder::separator(in StringView stableKey, in SeparatorOptions options){
    if(this.itemDeclarationBlocked() || !IsValidSeparatorDeclaration(options)){
        this.m_context.fail();
        return false;
    }
    const auto skinRegion = this.region(this.m_style.separator, this.m_style.separator);
    const auto state = this.m_context.declare(stableKey, WidgetKind::Separator);
    if(!skinRegion.has_value() || !state.has_value()){
        this.m_context.fail();
        return false;
    }
    auto item = this.makeItem();
    item.styleIndex = this.currentItemStyleIndex();
    item.state = state.value();
    const LayoutNodeDesc description = ResolveSeparatorNodeDesc(skinRegion.value(), options);
    if(!this.addItemNode(description, item))
        return false;
    AppendOwned<BuilderItem>(this.m_scope.value().m_items, item);
    return true;
}

void Builder::setSkin(in borrow UiSkin skin){
    if(!this.balanced() || this.m_context.failed()){
        this.m_context.fail();
        return;
    }
    const u64 styleVersion = skin.styleVersion();
    if(this.m_skin.has_value() && !this.m_customPaletteStyleDirty && this.m_lastSkinStyleVersion == styleVersion){
        this.m_skin = Optional<in UiSkin>(skin);
        return;
    }
    this.m_skin = Optional<in UiSkin>(skin);
    ApplyBuilderSkinStyles(
        skin.palette(),
        skin.typography().defaultFontSize,
        this.m_skinDefaultFontSize,
        this.m_style,
        this.m_tooltipStyle,
        this.m_editStyle,
        this.m_scrollbarStyle,
        this.m_popupStyle,
        this.m_radioGroupStyle,
        this.m_sliderStyle,
        this.m_progressStyle
    );
    this.m_customPaletteStyleDirty = false;
    this.m_widgetStyleDirty = true;
    this.m_lastSkinStyleVersion = styleVersion;
    this.syncMetricsCacheSkinVersion();
}

b8 Builder::setTextShaping(in u32 scriptTag, in StringView language){
    if(!this.balanced() || this.m_context.failed()){
        this.m_context.fail();
        return false;
    }
    ShapeRequest request;
    request.language = language;
    request.scriptTag = scriptTag;
    if(ValidateTextRequest(request, false) != TextLayoutStatus::Success)
        return false;
    this.m_textLanguage.assign(language);
    this.m_textScriptTag = scriptTag;
    return true;
}

b8 Builder::beginContainer(in StringView stableKey, in LayoutDirection direction, in ContainerOptions options){
    if(this.panelDeclarationBlocked() || this.m_scope.value().m_stack.size() >= s_ContextMaxScopeDepth || !this.m_context.declare(stableKey, WidgetKind::Container).has_value()){
        this.m_context.fail();
        return false;
    }
    const LayoutNodeDesc description = UiScopeDescriptorFactory().container(direction, options);
    u32 node = 0u;
    const auto admittedNode = this.m_scope.value().m_layout.addNode(this.m_scope.value().m_stack.back(), description);
    if(!admittedNode.has_value() || !this.m_context.pushScope(stableKey)){
        this.m_context.fail();
        return false;
    }
    node = admittedNode.value();
    this.m_scope.value().m_stack.push_back(node);
    return true;
}

Expected<mut BuilderItem> Builder::addItem(in StringView stableKey, in StringView text, in WidgetKind kind, in WidgetOptions options){
    if(this.itemDeclarationBlocked()){
        this.m_context.fail();
        return MakeUnexpected(Failure());
    }
    const auto state = this.m_context.declare(stableKey, kind);
    if(!state.has_value())
        return MakeUnexpected(Failure());
    auto item = this.makeItem();
    item.styleIndex = this.currentItemStyleIndex();
    item.state = state.value();
    item.enabled = options.enabled && this.synchronizePopup();
    const ShapeRequest request = this.textShapeRequest(text, this.m_style.fontSize);
    const auto measuredText = this.m_text.layoutAndMeasureShared(request, this.m_paint.displayMetrics());
    if(!measuredText.has_value()){
        this.m_context.fail();
        return MakeUnexpected(Failure());
    }
    item.text = measuredText.value().layout;
    item.textBounds = measuredText.value().bounds;
    const Point textSize = Point(item.textBounds.width, item.textBounds.height);
    Point intrinsicSize = textSize;
    if(kind == WidgetKind::Selectable){
        const auto metrics = this.loadSelectableMetrics();
        if(!metrics.has_value()){
            this.m_context.fail();
            return MakeUnexpected(Failure());
        }
        item.padding = metrics.value().padding;
        intrinsicSize = ResolvePaddedIntrinsicSize(textSize, item.padding, metrics.value().minimum);
    }
    else if(kind == WidgetKind::Button){
        Point minimum;
        if(!this.loadButtonMetrics(minimum, item.padding)){
            this.m_context.fail();
            return MakeUnexpected(Failure());
        }
        intrinsicSize = ResolvePaddedIntrinsicSize(textSize, item.padding, minimum);
    }
    else if(kind == WidgetKind::Checkbox){
        const auto checkboxExtent = this.loadCheckboxExtent();
        if(!checkboxExtent.has_value()){
            this.m_context.fail();
            return MakeUnexpected(Failure());
        }
        intrinsicSize = ResolveCheckboxIntrinsicSize(textSize, checkboxExtent.value(), this.m_style.gap);
        item.checkboxExtent = checkboxExtent.value();
    }
    const LayoutNodeDesc description = BuildSizedLeafNodeDesc(options.width, options.height, intrinsicSize);
    if(!this.addItemNode(description, item))
        return MakeUnexpected(Failure());
    AppendOwned<BuilderItem>(this.m_scope.value().m_items, item);
    return Expected<mut BuilderItem>(this.m_scope.value().m_items[this.m_scope.value().m_items.size() - 1u]);
}

b8 Builder::addItemNode(in LayoutNodeDesc description, mut BuilderItem item){
    const auto admittedNode = this.m_scope.value().m_layout.addNode(this.m_scope.value().m_stack.back(), description);
    if(!admittedNode.has_value()){
        this.m_context.fail();
        return false;
    }
    item.node = admittedNode.value();
    return true;
}

Optional<in UiSkinRegion> Builder::region(in Name preferred, in Name fallback)const{
    if(!this.m_skin.has_value())
        return Optional<in UiSkinRegion>();
    const auto preferredIdx = this.m_skin.value().findRegionIndex(preferred);
    if(preferredIdx.has_value())
        return Optional<in UiSkinRegion>(this.m_skin.value().regions()[preferredIdx.value()]);
    if(fallback != preferred){
        const auto fallbackIdx = this.m_skin.value().findRegionIndex(fallback);
        if(fallbackIdx.has_value())
            return Optional<in UiSkinRegion>(this.m_skin.value().regions()[fallbackIdx.value()]);
    }
    return Optional<in UiSkinRegion>();
}

Insets Builder::resolveRegionsPadding(in Insets initial, in Span<Name> names, in Name fallback)const{
    if(!this.m_skin.has_value())
        return initial;
    return ControlStyleMetrics().skinRegionsMaxPadding(this.m_skin.value(), initial, names, fallback);
}

b8 Builder::loadButtonMetrics(mut Point size, mut Insets padding){
    this.syncMetricsCacheSkinVersion();
    if(!this.m_buttonMetricsCached){
        this.m_cachedButtonMinSize = Point();
        this.m_cachedButtonPadding = Insets();
        this.m_buttonMetricsValid = this.m_skin.has_value() && this.m_skin.value().hasRegion(this.m_style.button);
        if(this.m_buttonMetricsValid)
            ControlStyleMetrics().buttonMetrics(this.m_skin.value(), this.m_style, this.m_cachedButtonMinSize, this.m_cachedButtonPadding);
        this.m_buttonMetricsCached = true;
    }
    if(!this.m_buttonMetricsValid)
        return false;
    size = this.m_cachedButtonMinSize;
    padding = this.m_cachedButtonPadding;
    return true;
}

Expected<f32> Builder::loadCheckboxExtent(){
    this.syncMetricsCacheSkinVersion();
    if(!this.m_checkboxExtentCached){
        this.m_checkboxExtentValid = false;
        this.m_cachedCheckboxExtent = 0.0f;
        if(this.m_skin.has_value()){
            const auto measured = ControlStyleMetrics().checkboxExtent(this.m_skin.value(), this.m_style);
            if(measured.has_value()){
                this.m_checkboxExtentValid = true;
                this.m_cachedCheckboxExtent = measured.value();
            }
        }
        this.m_checkboxExtentCached = true;
    }
    if(!this.m_checkboxExtentValid)
        return MakeUnexpected(Failure());
    return this.m_cachedCheckboxExtent;
}

Expected<SelectableMetrics> Builder::loadSelectableMetrics(){
    this.syncMetricsCacheSkinVersion();
    if(!this.m_selectableMetricsCached){
        this.m_selectableMetricsValid = false;
        this.m_cachedSelectableMetrics = SelectableMetrics();
        if(this.m_skin.has_value()){
            const auto measured = MeasureSelectable(this.m_skin.value(), this.m_listStyle.row);
            if(measured.has_value()){
                this.m_selectableMetricsValid = true;
                this.m_cachedSelectableMetrics = measured.value();
            }
        }
        this.m_selectableMetricsCached = true;
    }
    if(!this.m_selectableMetricsValid)
        return MakeUnexpected(Failure());
    return this.m_cachedSelectableMetrics;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 Builder::validateDeferredSources()const{
    for(in auto frame : this.m_scope.value().m_radioGroups){
        if(!this.radioGroupMatches(frame))
            return false;
    }
    for(in auto frame : this.m_scope.value().m_lists){
        if(!this.listMatches(frame))
            return false;
    }
    for(in auto frame : this.m_scope.value().m_combos){
        if(!this.comboMatches(frame))
            return false;
    }
    for(in auto frame : this.m_scope.value().m_contextMenus){
        if(!this.contextMenuMatches(frame))
            return false;
    }
    return true;
}

b8 Builder::validateDeferredStates()const{
    for(in auto frame : this.m_scope.value().m_sliders){
        if(!this.sliderMatches(frame))
            return false;
    }
    for(in auto frame : this.m_scope.value().m_textAreas){
        if(!this.textAreaMatches(frame))
            return false;
    }
    for(in auto frame : this.m_scope.value().m_integerEdits){
        if(!this.numericEditFrameMatches(frame))
            return false;
    }
    for(in auto frame : this.m_scope.value().m_floatEdits){
        if(!this.numericEditFrameMatches(frame))
            return false;
    }
    for(in auto frame : this.m_scope.value().m_radioGroups){
        if(!this.radioGroupStateMatches(frame))
            return false;
    }
    for(in auto frame : this.m_scope.value().m_lists){
        if(!this.listStateMatches(frame))
            return false;
    }
    for(in auto frame : this.m_scope.value().m_combos){
        if(!this.comboStateMatches(frame))
            return false;
    }
    for(in auto frame : this.m_scope.value().m_contextMenus){
        if(!this.contextMenuStateMatches(frame))
            return false;
    }
    for(in auto frame : this.m_scope.value().m_tooltips){
        if(!frame.state.has_value() || frame.state.value().revision() != frame.revision)
            return false;
    }
    return true;
}

void Builder::releaseDeferredLoans(){
    this.m_scope.value().m_radioGroups.clear();
    this.m_scope.value().m_sliders.clear();
    for(mut auto editBox : this.m_scope.value().m_editBoxes)
        editBox.editState.reset();
    for(mut auto frame : this.m_scope.value().m_textAreas){
        frame.model.reset();
        frame.state.reset();
    }
    for(mut auto frame : this.m_scope.value().m_integerEdits){
        frame.model.reset();
        frame.state.reset();
    }
    for(mut auto frame : this.m_scope.value().m_floatEdits){
        frame.model.reset();
        frame.state.reset();
    }
    for(mut auto frame : this.m_scope.value().m_lists){
        frame.source.reset();
        frame.state.reset();
    }
    for(mut auto frame : this.m_scope.value().m_combos){
        frame.source.reset();
        frame.results.reset();
        frame.searchSource.reset();
        frame.search.reset();
        frame.state.reset();
    }
    for(mut auto frame : this.m_scope.value().m_contextMenus){
        frame.source.reset();
        frame.state.reset();
    }
    for(mut auto frame : this.m_scope.value().m_tooltips)
        frame.state.reset();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 Builder::image(in StringView stableKey, in Name regionName, in ImageOptions options){
    if(this.itemDeclarationBlocked() || !this.m_skin.has_value()){
        this.m_context.fail();
        return false;
    }
    if(!this.synchronizePopup())
        return true;
    this.m_declaring = true;
    BuilderOperationEnd finish(this.m_declaring);
    const auto widget = this.m_context.declare(stableKey, WidgetKind::Image);
    ImageFrame frame;
    frame.options = options;
    if(!widget.has_value()){
        this.m_context.fail();
        return false;
    }
    const Expected<ImageResolvedMetrics> imageMetrics = ControlStyleMetrics().imageMetrics(this.m_skin.value(), regionName, options);
    if(!imageMetrics.has_value()){
        this.m_context.fail();
        return false;
    }
    frame.metrics = imageMetrics.value().metrics;
    frame.region = imageMetrics.value().region;
    return this.publishImageFrame(widget.value(), frame);
}

b8 Builder::image(in StringView stableKey, in SharedImageSource source, in ImageOptions options){
    if(this.itemDeclarationBlocked() || !this.m_skin.has_value()){
        this.m_context.fail();
        return false;
    }
    if(!this.synchronizePopup())
        return true;
    this.m_declaring = true;
    BuilderOperationEnd finish(this.m_declaring);
    const auto widget = this.m_context.declare(stableKey, WidgetKind::Image);
    ImageFrame frame;
    frame.source = source;
    frame.options = options;
    if(!widget.has_value() || !frame.source.valid()){
        this.m_context.fail();
        return false;
    }
    const auto metrics = MeasureImage(frame.options, frame.source.deref());
    if(!metrics.has_value()){
        this.m_context.fail();
        return false;
    }
    frame.metrics = metrics.value();
    return this.publishImageFrame(widget.value(), frame);
}

b8 Builder::publishImageFrame(in WidgetState widget, mut ImageFrame frame){
    auto item = this.makeItem();
    item.state = widget;
    item.image = cast<u32>(this.m_scope.value().m_images.size());
    const LayoutNodeDesc description = BuildSizedLeafNodeDesc(frame.options.width, frame.options.height, frame.metrics.contentSize);
    if(!this.addItemNode(description, item))
        return false;
    AppendOwned<ImageFrame>(this.m_scope.value().m_images, frame);
    AppendOwned<BuilderItem>(this.m_scope.value().m_items, item);
    return true;
}

b8 Builder::paintImage(in BuilderItem item, in LayoutBox box){
    if(item.image >= this.m_scope.value().m_images.size())
        return false;
    in ImageFrame frame = this.m_scope.value().m_images[item.image];
    const auto placement = PlaceImage(box.rectangle, this.visibleClip(box.clip));
    if(!placement.has_value())
        return false;
    this.m_paint.pushClip(placement.value().clip);
    b8 painted = false;
    if(frame.source.valid())
        painted = this.m_paint.drawImage(frame.source, placement.value().bounds, s_FullImageUvRect, frame.options.tint);
    else
        painted = this.m_paint.drawRegion(frame.region, placement.value().bounds, frame.options.tint);
    return this.finishClipPaint(item, placement.value().bounds, placement.value().clip, painted);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 Builder::progress(in StringView stableKey, in f64 fraction, in ProgressOptions options){
    if(this.itemDeclarationBlocked() || !this.m_skin.has_value()){
        this.m_context.fail();
        return false;
    }
    if(!this.synchronizePopup())
        return true;
    this.m_declaring = true;
    BuilderOperationEnd finish(this.m_declaring);
    const auto widget = this.m_context.declare(stableKey, WidgetKind::Progress);
    if(!widget.has_value())
        return false;
    ProgressFrame frame;
    frame.fraction = fraction;
    frame.options = options;
    frame.style = this.m_progressStyle;
    const Expected<ProgressMetrics> progressMetrics = ControlStyleMetrics().progressMetrics(this.m_skin.value(), fraction, options, frame.style);
    if(!progressMetrics.has_value()){
        this.m_context.fail();
        return false;
    }
    frame.metrics = progressMetrics.value();
    auto item = this.makeItem();
    item.state = widget.value();
    item.progress = cast<u32>(this.m_scope.value().m_progress.size());
    const LayoutNodeDesc description = BuildWidthLeafNodeDesc(frame.options.width, frame.metrics.contentSize);
    if(!this.addItemNode(description, item))
        return false;
    AppendOwned<ProgressFrame>(this.m_scope.value().m_progress, frame);
    AppendOwned<BuilderItem>(this.m_scope.value().m_items, item);
    return true;
}

b8 Builder::paintProgress(in BuilderItem item, in LayoutBox box){
    ControlVisualPainter painter;
    if(item.progress >= this.m_scope.value().m_progress.size())
        return false;
    in ProgressFrame frame = this.m_scope.value().m_progress[item.progress];
    const auto placement = PlaceProgress(box.rectangle, this.visibleClip(box.clip), frame.metrics, frame.fraction);
    if(!placement.has_value())
        return false;
    const b8 painted = painter.paintProgressBarRegions(this.m_paint, frame.style, placement.value());
    return this.finishClipPaint(item, placement.value().bounds, placement.value().clip, painted);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 Builder::paintPanel(){
    HitTargetFactory targets;
    const Optional<LayoutBox> panel = this.m_scope.value().m_layout.box(0u);
    if(!panel.has_value())
        return false;
    this.m_paint.pushClip(this.visibleClip(panel.value().clip));
    const b8 painted = this.m_paint.drawRegion(this.m_scope.value().m_panelStyle.panel, panel.value().rectangle);
    const b8 popped = this.m_paint.popClip();
    const HitTarget barrier = targets.makeBarrierHitTarget(panel.value().rectangle, this.visibleClip(panel.value().clip));
    if(!painted || !popped || !this.m_context.addTarget(this.m_scope.value().m_panelState, barrier))
        return false;
    return this.paintItems();
}

b8 Builder::paintItems(){
    if(!this.m_scope.value().m_items.empty() && !this.popupAncestorsVisible())
        return false;
    for(in auto item : this.m_scope.value().m_items){
        const Optional<LayoutBox> box = this.m_scope.value().m_layout.box(item.node);
        if(!box.has_value() || !this.paintItem(item, box.value()))
            return false;
    }
    return true;
}

b8 Builder::paintItem(in BuilderItem item, in LayoutBox box){
    HitTargetFactory targets;
    ControlVisualPainter painter;
    if(item.state.kind == WidgetKind::ComboBox || item.state.kind == WidgetKind::SearchComboBox)
        return this.paintCombo(item, box);
    if(item.state.kind == WidgetKind::TextArea)
        return this.paintTextArea(item, box);
    if(item.state.kind == WidgetKind::EditBox)
        return this.paintEditBox(item, box);
    if(item.state.kind == WidgetKind::Selectable)
        return this.paintSelectable(item, box);
    if(item.state.kind == WidgetKind::VirtualList)
        return this.paintList(item, box);
    if(item.state.kind == WidgetKind::RadioGroup)
        return this.paintRadioGroup(item, box);
    if(item.state.kind == WidgetKind::Slider)
        return this.paintSlider(item, box);
    if(item.state.kind == WidgetKind::Progress)
        return this.paintProgress(item, box);
    if(item.state.kind == WidgetKind::Image)
        return this.paintImage(item, box);
    in WidgetStyle itemStyle = this.itemWidgetStyle(item);
    if(item.state.kind == WidgetKind::Separator){
        const Rect clip = this.visibleClip(box.clip);
        this.m_paint.pushClip(clip);
        const b8 painted = this.m_paint.drawRegion(itemStyle.separator, box.rectangle);
        const b8 popped = this.m_paint.popClip();
        return painted && popped;
    }
    if(!item.text.valid())
        return false;
    in InputRouter input = this.m_context.input();
    const b8 hover = input.hover() == item.state.id;
    const b8 pressed = input.pressed(item.state.id);
    const b8 focused = input.focus() == item.state.id;
    const b8 interactive = IsBasicControlInteractive(item.state.kind);
    const Rect clip = this.visibleClip(box.clip);
    if(!painter.paintBasicControlItemVisual(
        this.m_paint,
        this.m_text,
        this.m_skin.value(),
        item.state.kind,
        itemStyle,
        item.text.deref(),
        item.textBounds,
        item.padding,
        item.checkboxExtent,
        box.rectangle,
        clip,
        item.enabled,
        item.checked,
        hover,
        pressed,
        focused,
        interactive
    ))
        return false;
    if(NeedsBasicControlHitTarget(interactive, item.annotated)){
        const HitTarget target = targets.makeBasicControlHitTarget(box.rectangle, clip, item.enabled, interactive, item.contextMenu);
        return this.m_context.addTarget(item.state, target);
    }
    return true;
}

b8 Builder::paintSelectable(in BuilderItem item, in LayoutBox box){
    if(!item.text.valid())
        return false;
    HitTargetFactory targets;
    in InputRouter input = this.m_context.input();
    in WidgetStyle itemStyle = this.itemWidgetStyle(item);
    SelectablePaintFlags flags;
    flags.enabled = item.enabled;
    flags.selected = item.checked;
    flags.hover = input.hover() == item.state.id;
    flags.focused = input.focus() == item.state.id;
    const Rect clip = this.visibleClip(box.clip);
    if(!PaintSelectable(this.m_paint, this.m_text, this.m_skin.value(), item.text.deref(), item.textBounds, item.padding, box.rectangle, clip, this.itemSelectableStyle(item), flags, itemStyle.text, itemStyle.disabledText))
        return false;
    const HitTarget target = targets.makeBasicControlHitTarget(box.rectangle, clip, item.enabled, true, item.contextMenu);
    return this.m_context.addTarget(item.state, target);
}

b8 Builder::finishClipPaint(in BuilderItem item, in Rect bounds, in Rect clip, in b8 painted){
    HitTargetFactory targets;
    const b8 popped = this.m_paint.popClip();
    if(!painted || !popped)
        return false;
    if(!item.annotated)
        return true;
    const HitTarget target = targets.makeAnnotatedClipHitTarget(bounds, clip, item.contextMenu);
    return this.m_context.addTarget(item.state, target);
}


