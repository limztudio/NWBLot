namespace NWB::Tests::Smoke{
[[nodiscard]] NWB_INLINE AStringView GatherBenchmarkProjectName()noexcept{
    return "RendererGatherBenchmark";
}

class GatherBenchmarkTimingPass final : public Core::IRenderPass{
private:
    static constexpr u32 s_InFlightRanges = 32u;
    static constexpr Array<StringView, 18> s_GpuNames = {
        "render.frame", "render.opaque_regular", "render.shadow_visibility", "render.deferred_lighting",
        "render.deferred_composite", "render.deferred_present", "render.avboit_clear", "render.avboit_occupancy",
        "render.avboit_depth_warp", "render.avboit_extinction", "render.avboit_integration", "render.avboit_accumulate",
        "render.reflection_classify", "render.reflection_build_args", "render.reflection_hardware",
        "render.reflection_depth_pyramid", "render.reflection_temporal", "render.reflection_spatial",
    };

public:
    explicit GatherBenchmarkTimingPass(Core::GraphicsRuntime& graphics)noexcept
        : IRenderPass(graphics)
    {}

public:
    [[nodiscard]] b8 prepareQueries(){
        auto& graphics = getGraphics();
        for(const StringView scope : s_GpuNames){
            if(scope == "render.reflection_depth_pyramid")
                continue;
            const auto scopeName = Name::FromText(scope);
            if(!scopeName)
                return false;
            if(!graphics.gpuTiming().prepareScopeQueries(*scopeName, graphics.getDevice(), s_InFlightRanges))
                return false;
        }
        return true;
    }

    virtual b8 shouldRenderUnfocused()noexcept override{ return true; }
};
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const f32 s_GatherBenchmarkFixedDelta = 0.016666667f;
const u32 s_GatherBenchmarkInFlightRanges = 32u;
const StringView s_GatherBenchmarkSharedWorkload = "shared";
const StringView s_GatherBenchmarkRuntimeWorkload = "runtime";
const StringView s_GatherBenchmarkMemoryMode = "memory";
const StringView s_GatherBenchmarkTimingMode = "timing";
const SmokeMeshRef s_GatherBenchmarkOctahedronMesh = "project/meshes/octahedron";
const SmokeMeshRef s_GatherBenchmarkPlaneMesh = "project/meshes/shadow_plane";
const SmokeMaterialRef s_GatherBenchmarkOpaqueMaterial = "project/smoke/reflection/materials/opaque";
const SmokeMaterialRef s_GatherBenchmarkGlassMaterial = "project/smoke/gather_benchmark/materials/glass_00";
const SmokeModelRef s_GatherBenchmarkCharacterModel = "project/characters/body/model";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererGatherBenchmarkScene{
    public b8 build(in StringView workload, in b8 runtime, mut World world){
        this.m_runtime = runtime;
        const EntityID cameraEntity = CreateSmokeCamera(2.6f, 9.0f, 0.0f, world);
        if(!cameraEntity.valid())
            return false;
        if(!CreateSmokeDirectionalLight(0.9f, 0.65f, 0.0f, f32x4(1.0f, 0.96f, 0.88f, 1.0f), 2.0f, false, world).valid())
            return false;
        if(!this.createBackdrop(world))
            return false;

        for(u32 index = 0u; index < s_GatherBenchmarkObjectCount; ++index){
            const VectorSingle grid = VectorSingle(cast<f32>(index % 8u), cast<f32>(index / 8u), 0.0f, 0.0f) - VectorSingle(3.5f, 0.0f, 0.0f, 0.0f);
            const VectorSingle spacing = grid * VectorSingle(0.75f, 0.58f, 0.0f, 0.0f);
            const VectorSingle position = VectorSingle(0.0f, 0.7f, 0.0f, 0.0f) + spacing;
            if(this.m_runtime && index % 8u == 0u){
                if(!this.createRuntime(index, position, world))
                    return false;
                continue;
            }
            const b8 opaque = workload == s_GatherBenchmarkOpaqueWorkload || (workload == s_GatherBenchmarkHybridWorkload && index % 2u == 0u);
            SmokeMeshRef mesh = s_GatherBenchmarkOctahedronMesh;
            SmokeMaterialRef material = s_GatherBenchmarkGlassMaterial;
            if(opaque)
                material = s_GatherBenchmarkOpaqueMaterial;
            if(workload == s_GatherBenchmarkUniqueWorkload){
                const String meshPath = StringFormat("project/smoke/gather_benchmark/meshes/mesh_{:02}", index);
                const String materialPath = StringFormat("project/smoke/gather_benchmark/materials/glass_{:02}", index);
                const Expected<SmokeMeshRef, NameTextErrorEnum> meshReference = SmokeMeshRefFromText(StringView(meshPath));
                const Expected<SmokeMaterialRef, NameTextErrorEnum> materialReference = SmokeMaterialRefFromText(StringView(materialPath));
                if(!meshReference.has_value() || !materialReference.has_value())
                    return false;
                mesh = meshReference.value();
                material = materialReference.value();
            }

            const f32x4 storedPosition = f32x4(position);
            const b8 applyOverride = workload == s_GatherBenchmarkOverridesWorkload;
            const f32x4 overrideTint = f32x4(0.55f + cast<f32>(index) / 256.0f, 0.85f, 1.0f, 1.0f);
            b8 entityOk = true;
            native(in storedPosition, in mesh, in material, in opaque, in applyOverride, in overrideTint, mut world, mut entityOk){
                auto entity = world.createEntity();
                auto& transform = entity.addComponent<Impl::Scene::TransformComponent>();
                transform.position = storedPosition;
                transform.scale = Float4(0.43f, 0.43f, 0.43f, 0.0f);
                entity.addComponent<Impl::MeshComponent>().mesh = mesh;
                auto& component = entity.addComponent<Impl::RendererComponent>();
                component.material = material;
                if(!opaque)
                    component.opticalBoundaryMode = Impl::OpticalBoundaryMode::ClosedNested;
                if(applyOverride){
                    entity.addComponent<Impl::MaterialInstanceComponent>(Name(s_SmokeSurfaceMaterialInterface));
                    if(!Impl::SetMaterialMutableHalf4(world, entity.id(), Name(s_SmokeSurfaceMaterialInterface), "runtime.color_tint", overrideTint))
                        entityOk = false;
                }
            }
            if(!entityOk)
                return false;
            if(!opaque)
                ++this.m_counts.transparentRenderers;
            ++this.m_counts.renderers;
        }
        if(this.m_runtime)
            SyncSmokeModelRuntimes(world);
        return true;
    }

    public RendererGatherBenchmarkSceneCounts counts()const{
        return this.m_counts;
    }

    public void setResolvedCounts(in u32 renderers, in u32 runtimeRenderers){
        this.m_counts.renderers = renderers;
        this.m_counts.runtimeRenderers = runtimeRenderers;
    }

    private b8 createBackdrop(mut World world){
        const EntityID backdrop = CreateTintedStaticMeshEntity(
            s_GatherBenchmarkPlaneMesh,
            s_GatherBenchmarkOpaqueMaterial,
            NameTextAscii(s_SmokeSurfaceMaterialInterface),
            VectorSingle(0.1f, 0.1f, 0.1f, 1.0f),
            VectorSingle(0.0f, 2.6f, 2.0f, 0.0f),
            VectorSingle(5.0f, 1.0f, 3.5f, 0.0f),
            world
        );
        if(!backdrop.valid())
            return false;
        const f32x4 rotation = f32x4(QuaternionRotationRollPitchYawFromVector(VectorSingle(-s_PIDIV2, 0.0f, 0.0f, 0.0f)));
        if(!SetSmokeEntityRotation(backdrop, rotation, world))
            return false;
        b8 paramsOk = false;
        native(in backdrop, mut world, mut paramsOk){
            const Half4U f0 = MakeHalf4U(0.35f, 0.35f, 0.35f, 0.0f);
            const Half roughness = ConvertFloatToHalf(0.0f);
            paramsOk = Impl::SetMaterialMutableParameter(
                world,
                backdrop,
                Name(s_SmokeSurfaceMaterialInterface),
                "runtime.specular_f0",
                Impl::MaterialLayoutFieldType::f16x3,
                Impl::PackMaterialInstanceBytes(Span<const Half>(f0.raw, 3u))
            ) && Impl::SetMaterialMutableParameter(
                world,
                backdrop,
                Name(s_SmokeSurfaceMaterialInterface),
                "runtime.perceptual_roughness",
                Impl::MaterialLayoutFieldType::f16,
                Impl::PackMaterialInstanceValue(roughness)
            );
        }
        if(!paramsOk)
            return false;
        ++this.m_counts.renderers;
        return true;
    }

    private b8 createRuntime(in u32 index, in VectorSingle position, mut World world){
        const SmokeTintedModelEntityResult modelResult = CreateTintedModelEntity(
            s_GatherBenchmarkCharacterModel,
            s_GatherBenchmarkOpaqueMaterial,
            NameTextAscii(s_SmokeSurfaceMaterialInterface),
            VectorSingle(0.9f, 0.45f, 0.2f, 1.0f),
            position,
            VectorSingle(0.22f, 0.22f, 0.22f, 0.0f),
            world
        );
        const EntityID owner = modelResult.entity;
        if(!owner.valid() || !modelResult.tintApplied)
            return false;
        SyncSmokeModelRuntimes(world);
        const EntityID skeleton = FindSpawnedModelObject(owner, s_SmokeNameSkeleton, ModelObjectKind::Skeleton, world);
        if(!skeleton.valid())
            return false;
        f32 yaw = -0.08f;
        if((index & 8u) != 0u)
            yaw = 0.08f;
        const MatrixSingle yawRotation = MatrixRotationRollPitchYawFromVector(VectorSingle(0.0f, yaw, 0.0f, 0.0f));
        b8 posedOk = false;
        native(in skeleton, in yawRotation, mut world, mut posedOk){
            auto& pose = world.entity(skeleton).getComponent<Impl::SkeletonPoseComponent>();
            if(pose.localJoints.size() >= 2u){
                StoreFloat(MatrixMultiply(LoadFloat(pose.localJoints[1u]), yawRotation), pose.localJoints[1u]);
                posedOk = true;
            }
        }
        if(!posedOk)
            return false;
        ++this.m_counts.runtimeOwners;
        return true;
    }

    private RendererGatherBenchmarkSceneCounts m_counts;
    private b8 m_runtime = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[arena]
class RendererGatherBenchmarkProjectImpl : IProjectEntryCallbacks{
    public RendererGatherBenchmarkProjectImpl(mut ProjectRuntimeContext context){
        this.m_context = context;
        this.m_world = CreateSmokeWorldOrDie(GatherBenchmarkProjectName(), context);
        this.m_scene = RendererGatherBenchmarkScene();
        this.m_timingPass = GatherBenchmarkTimingPass(context.graphics);
        this.m_probe = RendererGatherBenchmarkProbe(context.objectArena);
        this.m_compilerProbe = RendererCompilerStatisticsProbe(context.graphics, context.objectArena);
    }

    public ~RendererGatherBenchmarkProjectImpl(){
        this.destroyWorld();
    }

    public b8 onStartup()override{
        const Expected<String> requestedWorkload = ReadSmokeEnvironmentString("NWB_GATHER_BENCHMARK_WORKLOAD");
        if(!requestedWorkload.has_value())
            return false;
        const Expected<String> requestedOutput = ReadSmokeEnvironmentString("NWB_GATHER_BENCHMARK_OUTPUT");
        if(!requestedOutput.has_value())
            return false;
        this.m_workload = requestedWorkload.value();
        this.m_output = requestedOutput.value();
        const StringView workload = StringView(this.m_workload);
        if(
            workload != s_GatherBenchmarkOpaqueWorkload
            && workload != s_GatherBenchmarkHybridWorkload
            && workload != s_GatherBenchmarkSharedWorkload
            && workload != s_GatherBenchmarkUniqueWorkload
            && workload != s_GatherBenchmarkOverridesWorkload
            && workload != s_GatherBenchmarkRuntimeWorkload
        )
            return false;

        const Expected<String> mode = ReadSmokeEnvironmentString("NWB_GATHER_BENCHMARK_MODE");
        if(!mode.has_value())
            return false;
        const StringView modeView = StringView(mode.value());
        if(modeView != s_GatherBenchmarkTimingMode && modeView != s_GatherBenchmarkMemoryMode)
            return false;
        this.m_memoryEnabled = modeView == s_GatherBenchmarkMemoryMode;
        this.m_runtime = workload == s_GatherBenchmarkRuntimeWorkload;

        const b8 hasRayQuery = this.m_context.graphics.queryFeatureSupport(Feature::RayTracingAccelStruct)
            && this.m_context.graphics.queryFeatureSupport(Feature::RayQuery);
        if(!hasRayQuery){
            error("RendererGatherBenchmark: hardware ray queries are required");
            return false;
        }

        if(this.m_runtime)
            AddSmokeSkinnedRenderSystems(SmokeWorldRef(this.m_world), this.m_context);
        else
            AddSmokeRenderSystems(SmokeWorldRef(this.m_world), this.m_context);
        this.m_worldReady = true;

        ReflectionSettings settings = ReflectionSettings();
        settings.traceMode = ReflectionTraceMode::Hardware;
        settings.maxHardwareRaysPerFrame = 4096u;
        settings.maxOpticalQueries = 16u;
        settings.temporalEnabled = false;
        settings.spatialFilterEnabled = false;
        settings.screenFeedbackEnabled = false;
        settings.diagnosticsEnabled = false;
        settings.samplingSeed = 0u;
        if(!SmokeRendererSystemRef(SmokeWorldRef(this.m_world)).setReflectionSettings(settings))
            return false;
        SmokeRendererSystemRef(SmokeWorldRef(this.m_world)).setRefractionEnabled(true);
        SmokeRendererSystemRef(SmokeWorldRef(this.m_world)).setRefractionHardwareTracingEnabled(true);

        if(!this.m_scene.build(workload, this.m_runtime, SmokeWorldRef(this.m_world)))
            return false;
        if(!this.m_timingPass.prepareQueries())
            return false;
        this.m_context.graphics.addRenderPassToBack(this.m_timingPass);
        this.m_timingRegistered = true;

        const Expected<String> compilerOutput = ReadSmokeEnvironmentString("NWB_GATHER_COMPILER_STATISTICS_FILE");
        if(compilerOutput.has_value()){
            if(!this.m_compilerProbe.start(StringView(compilerOutput.value()), SmokeRendererSystemRef(SmokeWorldRef(this.m_world))))
                return false;
        }

        PerfCaptureOptions capture = PerfCaptureOptions();
        capture.enabled = true;
        capture.cpuTiming = true;
        capture.gpuTiming = true;
        capture.memory = this.m_memoryEnabled;
        this.m_context.setPerfCapture(capture);
        u32 vsyncEnabled = 0u;
        if(this.m_context.graphics.isVSyncEnabled())
            vsyncEnabled = 1u;
        [essential] info("RendererGatherBenchmark: workload {} mode {} fixed objects 64", workload, modeView);
        [essential] info("RendererGatherBenchmark: hardware reflection 4096 queries 16 refraction 1 diagnostics 0 temporal 0 spatial 0 feedback 0");
        [essential] info("RendererGatherBenchmark: fixed delta 0.016666667 extent 960x720 async compute requested 1");
        [essential] info("RendererGatherBenchmark: vsync {}", vsyncEnabled);
        return true;
    }

    public void onShutdown()override{
        this.m_compilerProbe.stop();
        if(!this.m_compilerProbe.write())
            error("RendererGatherBenchmark: compiler statistics diagnostic is incomplete or could not be written");
        const RendererGatherBenchmarkSceneCounts sceneCounts = this.m_scene.counts();
        if(!this.m_probe.write(
            StringView(this.m_output),
            StringView(this.m_workload),
            this.m_memoryEnabled,
            sceneCounts.renderers,
            sceneCounts.runtimeRenderers,
            sceneCounts.transparentRenderers,
            sceneCounts.runtimeOwners
        )){
            error("RendererGatherBenchmark: complete result could not be written; successful frames {}", this.m_probe.successfulFrames());
        }
        this.destroyWorld();
        [essential] info("RendererGatherBenchmark: shutdown successful frames {}", this.m_probe.successfulFrames());
    }

    public b8 onUpdate(in f32 delta)override{
        if(!this.m_probe.poll(this.m_context.perfSession.report(), this.m_memoryEnabled)){
            error("RendererGatherBenchmark: incomplete or mismatched successful CPU frame");
            return false;
        }
        if(this.m_probe.finished()){
            RequestSmokeQuit(this.m_context);
            return true;
        }
        if(this.m_probe.successfulFrames() == 64u && !this.m_actualCountsRead){
            if(!this.readActualCounts())
                return false;
            this.m_actualCountsRead = true;
        }
        return TickSmokeWorld(s_GatherBenchmarkFixedDelta, SmokeWorldRef(this.m_world));
    }

    private b8 readActualCounts(){
        u32 readyRenderers = 0u;
        u32 readyRuntimeRenderers = 0u;
        native(mut world = this.m_world, mut readyRenderers, mut readyRuntimeRenderers){
            Impl::MeshSystem& meshes = *MakeNotNull(world->getSystem<Impl::MeshSystem>());
            auto view = world->view<Impl::RendererComponent>();
            for(auto&& [entity, renderer] : view){
                if(!renderer.visible)
                    continue;
                const auto meshResult = meshes.resolveRenderableMeshStatus(entity);
                if(!meshResult)
                    continue;
                const auto& mesh = *meshResult;
                ++readyRenderers;
                if(mesh.runtime)
                    ++readyRuntimeRenderers;
            }
        }
        this.m_scene.setResolvedCounts(readyRenderers, readyRuntimeRenderers);
        const RendererGatherBenchmarkSceneCounts sceneCounts = this.m_scene.counts();
        if(
            sceneCounts.renderers != 65u
            || (this.m_runtime && (sceneCounts.runtimeRenderers != 8u || sceneCounts.runtimeOwners != 8u))
            || (!this.m_runtime && sceneCounts.runtimeRenderers != 0u)
        ){
            error("RendererGatherBenchmark: actual ready renderer/runtime counts do not match the workload");
            return false;
        }
        [essential] info(
            "RendererGatherBenchmark: warmed ready renderers {} runtime {} transparent {}"
            , sceneCounts.renderers
            , sceneCounts.runtimeRenderers
            , sceneCounts.transparentRenderers
        );
        return true;
    }

    private void destroyWorld(){
        this.m_compilerProbe.stop();
        if(this.m_timingRegistered){
            this.m_context.graphics.removeRenderPass(this.m_timingPass);
            this.m_timingRegistered = false;
        }
        if(!this.m_worldReady)
            return;
        if(this.m_runtime)
            DestroySmokeSkinnedRenderWorld(this.m_context, this.m_world);
        else
            DestroySmokeRenderWorld(this.m_context, this.m_world);
        this.m_worldReady = false;
    }

    private mut ProjectRuntimeContext m_context;
    private NotNullUniquePtr<World> m_world;
    private RendererGatherBenchmarkScene m_scene;
    private GatherBenchmarkTimingPass m_timingPass;
    private RendererGatherBenchmarkProbe m_probe;
    private RendererCompilerStatisticsProbe m_compilerProbe;
    private String m_workload;
    private String m_output;
    private b8 m_runtime = false;
    private b8 m_memoryEnabled = false;
    private b8 m_worldReady = false;
    private b8 m_timingRegistered = false;
    private b8 m_actualCountsRead = false;
}


