void VerifyUiBuilderTests_LabelTextChangesPreserveStableIdAndDeclarationLifetime(mut UiBuilderTests self){
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.label(s_UiBuilderCaptionKey, "A"));
    ASSERT_TRUE(self.finish());
    const DrawSnapshot first = self.m_paint.freeze();
    ASSERT_EQ(first.generation(), 1u);
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const WidgetId caption = self.id(s_UiBuilderCaptionKey);
    const Optional<WidgetState> original = self.findState(caption);
    ASSERT_TRUE(original.has_value());
    const u64 lifetime = original.value().declarationGeneration;
    ASSERT_TRUE(self.begin(2u));
    ASSERT_TRUE(self.m_builder.label(s_UiBuilderCaptionKey, "A changed caption"));
    ASSERT_TRUE(self.finish());
    const DrawSnapshot second = self.m_paint.freeze();
    const Optional<WidgetState> updated = self.findState(caption);
    ASSERT_TRUE(updated.has_value());
    EXPECT_EQ(updated.value().id, caption);
    EXPECT_EQ(updated.value().declarationGeneration, lifetime);
    EXPECT_GT(second.vertices().size(), first.vertices().size());
    EXPECT_EQ(first.generation(), 1u);
    EXPECT_FALSE(first.glyphPages().empty());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
}

void VerifyUiBuilderTests_CheckboxTogglesOncePerAcceptedActionAcrossRepeatedBuilds(mut UiBuilderTests self){
    b8 checked = false;
    ASSERT_TRUE(self.begin(1u));
    EXPECT_FALSE(self.m_builder.checkbox("enabled", "Enabled", checked));
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const Expected<HitTarget> control = self.tryTarget(self.id("enabled"));
    ASSERT_TRUE(control.has_value());
    const VectorSingle centerValue = VectorSingle(control.value().rectangle.x, control.value().rectangle.y, 0.0f, 0.0f) + VectorSingle(4.0f);
    const Point center = Point(centerValue.x, centerValue.y);
    self.click(center);
    ASSERT_EQ(self.m_context.input().actions().size(), 1u);
    EXPECT_FALSE(self.m_context.input().process().pointerConsumed);
    EXPECT_EQ(self.m_context.input().actions().size(), 1u);
    ASSERT_TRUE(self.begin(2u));
    EXPECT_TRUE(self.m_builder.checkbox("enabled", "Enabled", checked));
    EXPECT_TRUE(checked);
    EXPECT_TRUE(self.m_context.input().actions().empty());
    ASSERT_TRUE(self.finish());
    EXPECT_FALSE(self.m_context.beginFrame(3u));
    EXPECT_FALSE(self.m_context.input().process().pointerConsumed);
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    ASSERT_TRUE(self.begin(3u));
    EXPECT_FALSE(self.m_builder.checkbox("enabled", "Enabled", checked));
    EXPECT_TRUE(checked);
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(3u));
}

void VerifyUiBuilderTests_ButtonChecksCurrentEnabledValueBeforeTakingPendingActivation(mut UiBuilderTests self){
    ASSERT_TRUE(self.begin(1u));
    EXPECT_FALSE(self.m_builder.button(s_UiBuilderApplyKey, "Apply"));
    ASSERT_FALSE(self.m_context.failed());
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    Expected<HitTarget> control = self.tryTarget(self.id(s_UiBuilderApplyKey));
    ASSERT_TRUE(control.has_value());
    const VectorSingle pointValue = VectorSingle(control.value().rectangle.x, control.value().rectangle.y, 0.0f, 0.0f) + VectorSingle(4.0f);
    const Point point = Point(pointValue.x, pointValue.y);
    self.click(point);
    ASSERT_EQ(self.m_context.input().actions().size(), 1u);
    ASSERT_TRUE(self.begin(2u));
    WidgetOptions disabled = WidgetOptions();
    disabled.enabled = false;
    EXPECT_FALSE(self.m_builder.button(s_UiBuilderApplyKey, "Apply", disabled));
    EXPECT_FALSE(self.m_context.failed());
    EXPECT_TRUE(self.m_context.input().actions().empty());
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    control = self.tryTarget(self.id(s_UiBuilderApplyKey));
    ASSERT_TRUE(control.has_value());
    EXPECT_FALSE(control.value().enabled);
    EXPECT_FALSE(control.value().focusable);
    EXPECT_FALSE(control.value().activatable);
    EXPECT_NE(self.m_context.input().hitTest(point), control.value().id);
    self.click(point);
    EXPECT_TRUE(self.m_context.input().actions().empty());
    ASSERT_TRUE(self.begin(3u));
    EXPECT_FALSE(self.m_builder.button(s_UiBuilderApplyKey, "Apply"));
    EXPECT_FALSE(self.m_context.failed());
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    const Expected<HitTarget> enabledControl = self.tryTarget(self.id(s_UiBuilderApplyKey));
    ASSERT_TRUE(enabledControl.has_value());
    EXPECT_TRUE(enabledControl.value().enabled);
}

void VerifyUiBuilderTests_MissingSkinRejectsDeclarationsWithoutPublishingCandidateTargets(mut UiBuilderTests self){
    ASSERT_TRUE(self.begin(1u));
    EXPECT_FALSE(self.m_builder.button(s_UiBuilderApplyKey, "Apply"));
    ASSERT_TRUE(self.finish());
    const DrawSnapshot first = self.m_paint.freeze();
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const WidgetId accepted = self.id(s_UiBuilderApplyKey);
    ASSERT_EQ(self.m_context.input().targets().size(), 2u);
    Builder noSkin = Builder(self.m_context, self.m_paint, self.m_text);
    ASSERT_TRUE(self.m_context.beginFrame(2u));
    self.beginPaintFrame(2u);
    ASSERT_TRUE(self.m_context.beginRoot(self.m_root));
    EXPECT_FALSE(noSkin.beginPanel(s_UiBuilderPanelKey, Rect(100.0f, 100.0f, 100.0f, 100.0f)));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.finishFrame());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
    EXPECT_EQ(self.m_context.input().targets().size(), 2u);
    EXPECT_EQ(self.m_context.input().hitTest(Point(15.0f, 15.0f)), accepted);
    EXPECT_EQ(first.generation(), 1u);
}

void VerifyUiBuilderTests_MissingBaseControlRegionRejectsFrameAndKeepsAcceptedHitLayout(mut UiBuilderTests self){
    ASSERT_TRUE(self.begin(1u));
    EXPECT_FALSE(self.m_builder.button(s_UiBuilderApplyKey, "Apply"));
    ASSERT_TRUE(self.finish());
    const DrawSnapshot first = self.m_paint.freeze();
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    self.configureSkin(true, false);
    ASSERT_TRUE(self.begin(2u));
    EXPECT_FALSE(self.m_builder.button(s_UiBuilderApplyKey, "Apply"));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_FALSE(self.m_context.finishFrame());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
    EXPECT_EQ(self.m_context.input().hitTest(Point(15.0f, 15.0f)), self.id(s_UiBuilderApplyKey));
    EXPECT_TRUE(self.regionQuad(first, 1u).has_value());
}

void VerifyUiBuilderTests_RowUsesSkinMetricsPaddingAndClipsOverflowingControlHits(mut UiBuilderTests self){
    ContainerOptions row = ContainerOptions();
    row.width.policy = LayoutSizePolicy::Fixed;
    row.width.value = 100.0f;
    row.height.policy = LayoutSizePolicy::Fixed;
    row.height.value = 70.0f;
    row.padding.left = 2.0f;
    row.padding.top = 3.0f;
    row.padding.right = 4.0f;
    row.padding.bottom = 5.0f;
    row.gap = 6.0f;
    ASSERT_TRUE(self.begin(1u, Rect(10.0f, 20.0f, 150.0f, 90.0f)));
    ASSERT_TRUE(self.m_builder.beginRow("actions", row));
    EXPECT_FALSE(self.m_builder.button("first", "i"));
    EXPECT_FALSE(self.m_builder.button("second", "ii"));
    ASSERT_TRUE(self.m_builder.endContainer());
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const WidgetId rowId = self.id("actions");
    const WidgetId firstId = RequireUiWidgetId(rowId, "first");
    const WidgetId secondId = RequireUiWidgetId(rowId, "second");
    const Expected<HitTarget> secondTarget = self.tryTarget(secondId);
    ASSERT_TRUE(secondTarget.has_value());
    EXPECT_FLOAT_EQ(secondTarget.value().clip.width, 18.0f);
    EXPECT_EQ(self.m_context.input().hitTest(Point(100.0f, 40.0f)), secondId);
    EXPECT_NE(self.m_context.input().hitTest(Point(125.0f, 40.0f)), secondId);
    self.click(Point(125.0f, 40.0f));
    EXPECT_TRUE(self.m_context.input().actions().empty());
    self.click(Point(100.0f, 40.0f));
    EXPECT_TRUE(self.m_context.input().consumeActivation(secondId));
    EXPECT_FALSE(self.m_context.input().consumeActivation(firstId));
}

void VerifyUiBuilderTests_ScopedKeysRemainDistinctAndDuplicateDeclarationsRejectPublication(mut UiBuilderTests self){
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginRow("left"));
    ASSERT_TRUE(self.m_builder.label(s_UiBuilderCaptionKey, "Left"));
    ASSERT_TRUE(self.m_builder.endContainer());
    ASSERT_TRUE(self.m_builder.beginRow("right"));
    ASSERT_TRUE(self.m_builder.label(s_UiBuilderCaptionKey, "Right"));
    ASSERT_TRUE(self.m_builder.endContainer());
    ASSERT_TRUE(self.finish());
    const DrawSnapshot first = self.m_paint.freeze();
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const WidgetId left = RequireUiWidgetId(self.id("left"), s_UiBuilderCaptionKey);
    const WidgetId right = RequireUiWidgetId(self.id("right"), s_UiBuilderCaptionKey);
    EXPECT_NE(left, right);
    EXPECT_TRUE(self.findState(left).has_value());
    EXPECT_TRUE(self.findState(right).has_value());
    ASSERT_TRUE(self.begin(2u));
    ASSERT_TRUE(self.m_builder.label("duplicate", "First"));
    EXPECT_FALSE(self.m_builder.label("duplicate", "Second"));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_FALSE(self.m_context.finishFrame());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
    EXPECT_EQ(first.generation(), 1u);
}

void VerifyUiBuilderTests_PreparedFrameTargetsStayInaccessibleUntilExactCommit(mut UiBuilderTests self){
    WidgetOptions fixed = WidgetOptions();
    fixed.width.policy = LayoutSizePolicy::Fixed;
    fixed.width.value = 20.0f;
    fixed.height.policy = LayoutSizePolicy::Fixed;
    fixed.height.value = 20.0f;
    ASSERT_TRUE(self.begin(1u, Rect(0.0f, 0.0f, 100.0f, 100.0f)));
    EXPECT_FALSE(self.m_builder.button(s_UiBuilderApplyKey, "", fixed));
    ASSERT_TRUE(self.finish());
    const DrawSnapshot first = self.m_paint.freeze();
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    ASSERT_TRUE(self.begin(2u, Rect(150.0f, 50.0f, 100.0f, 100.0f)));
    EXPECT_FALSE(self.m_builder.button(s_UiBuilderApplyKey, "", fixed));
    ASSERT_TRUE(self.finish());
    const DrawSnapshot prepared = self.m_paint.freeze();
    EXPECT_EQ(first.generation(), 1u);
    EXPECT_EQ(prepared.generation(), 2u);
    EXPECT_TRUE(self.m_context.ready());
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
    EXPECT_EQ(self.m_context.input().hitTest(Point(15.0f, 15.0f)), self.id(s_UiBuilderApplyKey));
    EXPECT_FALSE(self.m_context.input().hitTest(Point(160.0f, 60.0f)).valid());
    EXPECT_FALSE(self.send(MakeUiPointerEvent(InputEventType::PrimaryDown, Point(160.0f, 60.0f))).pointerConsumed);
    EXPECT_FALSE(self.send(MakeUiPointerEvent(InputEventType::PrimaryUp, Point(160.0f, 60.0f))).pointerConsumed);
    EXPECT_TRUE(self.m_context.input().actions().empty());
    EXPECT_FALSE(self.m_context.beginFrame(3u));
    EXPECT_FALSE(self.m_context.commitFrame(1u));
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_context.input().hitTest(Point(160.0f, 60.0f)), self.id(s_UiBuilderApplyKey));
    EXPECT_FALSE(self.m_context.input().hitTest(Point(15.0f, 15.0f)).valid());
}

void VerifyUiBuilderTests_EscapeBeforeReleaseCancelsPointerAndKeyboardButtonSubmission(mut UiBuilderTests self){
    ASSERT_TRUE(self.begin(1u));
    EXPECT_FALSE(self.m_builder.button(s_UiBuilderApplyKey, "Apply"));
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const Expected<HitTarget> target = self.tryTarget(self.id(s_UiBuilderApplyKey));
    ASSERT_TRUE(target.has_value());
    const Point point = CenterUiRect(target.value().rectangle);
    u64 generation = 1u;
    Array<i32, 3u> keys = Array<i32, 3u>();
    keys[0u] = Key::Unknown;
    keys[1u] = Key::Enter;
    keys[2u] = Key::Space;
    for(in i32 key : keys){
        if(!self.m_context.input().focus().valid()){
            EXPECT_TRUE(self.send(Key(InputEventType::KeyDown, Key::Tab)).commandConsumed);
            EXPECT_TRUE(self.send(Key(InputEventType::KeyUp, Key::Tab)).commandConsumed);
        }
        ASSERT_EQ(self.m_context.input().focus(), self.id(s_UiBuilderApplyKey));
        const b8 pointer = key == Key::Unknown;
        InputEvent down = InputEvent();
        down.position = point;
        down.key = key;
        if(pointer)
            down.type = InputEventType::PrimaryDown;
        else
            down.type = InputEventType::KeyDown;
        InputEvent up = InputEvent();
        up.position = point;
        up.key = key;
        if(pointer)
            up.type = InputEventType::PrimaryUp;
        else
            up.type = InputEventType::KeyUp;
        const InputRoutingResult held = self.send(down);
        if(pointer)
            EXPECT_TRUE(held.pointerConsumed);
        else
            EXPECT_TRUE(held.commandConsumed);
        ++generation;
        ASSERT_TRUE(self.begin(generation));
        EXPECT_FALSE(self.m_builder.button(s_UiBuilderApplyKey, "Apply"));
        ASSERT_TRUE(self.finish());
        ASSERT_TRUE(self.m_context.commitFrame(generation));
        EXPECT_TRUE(self.send(Key(InputEventType::KeyDown, Key::Escape)).commandConsumed);
        EXPECT_TRUE(self.send(Key(InputEventType::KeyUp, Key::Escape)).commandConsumed);
        const InputRoutingResult released = self.send(up);
        if(pointer)
            EXPECT_TRUE(released.pointerConsumed);
        else
            EXPECT_TRUE(released.commandConsumed);
        ++generation;
        ASSERT_TRUE(self.begin(generation));
        EXPECT_FALSE(self.m_builder.button(s_UiBuilderApplyKey, "Apply"));
        ASSERT_TRUE(self.finish());
        ASSERT_TRUE(self.m_context.commitFrame(generation));
        EXPECT_TRUE(self.m_context.input().actions().empty());
    }
    EXPECT_TRUE(self.send(Key(InputEventType::KeyDown, Key::Tab)).commandConsumed);
    EXPECT_TRUE(self.send(Key(InputEventType::KeyUp, Key::Tab)).commandConsumed);
    ASSERT_EQ(self.m_context.input().focus(), self.id(s_UiBuilderApplyKey));
    EXPECT_TRUE(self.send(Key(InputEventType::KeyDown, Key::Enter)).commandConsumed);
    EXPECT_TRUE(self.send(Key(InputEventType::KeyUp, Key::Enter)).commandConsumed);
    ++generation;
    ASSERT_TRUE(self.begin(generation));
    EXPECT_TRUE(self.m_builder.button(s_UiBuilderApplyKey, "Apply"));
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(generation));
}

void VerifyUiBuilderTests_FocusTransferWhileButtonSubmitIsHeldCannotActivateEitherButton(mut UiBuilderTests self){
    ASSERT_TRUE(self.begin(1u));
    EXPECT_FALSE(self.m_builder.button("first", "First"));
    EXPECT_FALSE(self.m_builder.button("second", "Second"));
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    EXPECT_TRUE(self.send(Key(InputEventType::KeyDown, Key::Tab)).commandConsumed);
    EXPECT_TRUE(self.send(Key(InputEventType::KeyUp, Key::Tab)).commandConsumed);
    ASSERT_EQ(self.m_context.input().focus(), self.id("first"));
    EXPECT_TRUE(self.send(Key(InputEventType::KeyDown, Key::Enter)).commandConsumed);
    EXPECT_TRUE(self.send(Key(InputEventType::KeyDown, Key::Tab)).commandConsumed);
    EXPECT_TRUE(self.send(Key(InputEventType::KeyUp, Key::Tab)).commandConsumed);
    ASSERT_EQ(self.m_context.input().focus(), self.id("second"));
    EXPECT_TRUE(self.send(Key(InputEventType::KeyUp, Key::Enter)).commandConsumed);
    ASSERT_TRUE(self.begin(2u));
    EXPECT_FALSE(self.m_builder.button("first", "First"));
    EXPECT_FALSE(self.m_builder.button("second", "Second"));
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_TRUE(self.send(Key(InputEventType::KeyDown, Key::Enter)).commandConsumed);
    EXPECT_TRUE(self.send(Key(InputEventType::KeyUp, Key::Enter)).commandConsumed);
    ASSERT_TRUE(self.begin(3u));
    EXPECT_FALSE(self.m_builder.button("first", "First"));
    EXPECT_TRUE(self.m_builder.button("second", "Second"));
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(3u));
}

void VerifyUiBuilderTests_OverlayAndUnclippedContainerPreserveChildBoundsAgainstOuterClip(mut UiBuilderTests self){
    ASSERT_TRUE(self.begin(1u, Rect(10.0f, 10.0f, 200.0f, 160.0f)));
    ContainerOptions overlayOpts = ContainerOptions();
    overlayOpts.height.policy = LayoutSizePolicy::Fixed;
    overlayOpts.height.value = 40.0f;
    ASSERT_TRUE(self.m_builder.beginOverlay("overlay", overlayOpts));
    WidgetOptions firstBtn = WidgetOptions();
    firstBtn.width.policy = LayoutSizePolicy::Fixed;
    firstBtn.width.value = 100.0f;
    firstBtn.height.policy = LayoutSizePolicy::Fixed;
    firstBtn.height.value = 20.0f;
    WidgetOptions secondBtn = firstBtn;
    secondBtn.width.value = 60.0f;
    EXPECT_FALSE(self.m_builder.button("first", "First", firstBtn));
    EXPECT_FALSE(self.m_builder.button("second", "Second", secondBtn));
    ASSERT_TRUE(self.m_builder.endContainer());

    ContainerOptions clippedOpts = ContainerOptions();
    clippedOpts.width.policy = LayoutSizePolicy::Fixed;
    clippedOpts.width.value = 40.0f;
    clippedOpts.height.policy = LayoutSizePolicy::Fixed;
    clippedOpts.height.value = 24.0f;
    clippedOpts.clipChildren = true;
    ASSERT_TRUE(self.m_builder.beginRow("clipped", clippedOpts));
    EXPECT_FALSE(self.m_builder.button("btn", "Wide", firstBtn));
    ASSERT_TRUE(self.m_builder.endContainer());

    ContainerOptions unclippedOpts = clippedOpts;
    unclippedOpts.clipChildren = false;
    ASSERT_TRUE(self.m_builder.beginRow("unclipped", unclippedOpts));
    EXPECT_FALSE(self.m_builder.button("btn", "Wide", firstBtn));
    ASSERT_TRUE(self.m_builder.endContainer());

    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const Expected<HitTarget> firstTarget = self.tryTarget(RequireUiWidgetId(self.id("overlay"), "first"));
    const Expected<HitTarget> secondTarget = self.tryTarget(RequireUiWidgetId(self.id("overlay"), "second"));
    ASSERT_TRUE(firstTarget.has_value());
    ASSERT_TRUE(secondTarget.has_value());
    EXPECT_FLOAT_EQ(firstTarget.value().rectangle.x, secondTarget.value().rectangle.x);
    EXPECT_FLOAT_EQ(firstTarget.value().rectangle.y, secondTarget.value().rectangle.y);

    const Expected<HitTarget> clippedTarget = self.tryTarget(RequireUiWidgetId(self.id("clipped"), "btn"));
    const Expected<HitTarget> unclippedTarget = self.tryTarget(RequireUiWidgetId(self.id("unclipped"), "btn"));
    ASSERT_TRUE(clippedTarget.has_value());
    ASSERT_TRUE(unclippedTarget.has_value());
    EXPECT_FLOAT_EQ(clippedTarget.value().clip.width, 40.0f);
    EXPECT_GT(unclippedTarget.value().clip.width, 90.0f);
}

void VerifyUiBuilderTests_LabelOptionsAlignmentAndEllipsisTruncateInLtrAndRtl(mut UiBuilderTests self){
    LabelOptions truncOpts = LabelOptions();
    truncOpts.width.policy = LayoutSizePolicy::Fixed;
    truncOpts.width.value = 48.0f;
    truncOpts.ellipsis = true;
    truncOpts.alignment = TextAlignment::Trailing;

    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.label("trunc", "ABCDEFGHIJKLMNOP", truncOpts));
    ASSERT_TRUE(self.finish());
    Vector<Vertex> ltrVerts;
    CopyGlyphVertices(self.m_paint.freeze(), ltrVerts);
    const usize ltrQuads = ltrVerts.size() / 6u;
    EXPECT_GE(ltrQuads, 4u);
    EXPECT_LT(ltrQuads, 16u);
    ASSERT_TRUE(self.m_context.commitFrame(1u));

    ASSERT_TRUE(self.m_builder.setTextDirection(TextDirection::RightToLeft));
    ASSERT_TRUE(self.begin(2u));
    truncOpts.alignment = TextAlignment::Center;
    ASSERT_TRUE(self.m_builder.label("rtl_trunc", "ABCDEFGHIJKLMNOP", truncOpts));
    ASSERT_TRUE(self.finish());
    Vector<Vertex> rtlVerts;
    CopyGlyphVertices(self.m_paint.freeze(), rtlVerts);
    const usize rtlQuads = rtlVerts.size() / 6u;
    EXPECT_GE(rtlQuads, 4u);
    EXPECT_LT(rtlQuads, 16u);
    ASSERT_TRUE(self.m_context.commitFrame(2u));

    ASSERT_TRUE(self.m_builder.setTextDirection(TextDirection::LeftToRight));
    LabelOptions alignOpts = LabelOptions();
    alignOpts.width.policy = LayoutSizePolicy::Fixed;
    alignOpts.width.value = 140.0f;
    alignOpts.alignment = TextAlignment::Trailing;
    ASSERT_TRUE(self.begin(3u));
    ASSERT_TRUE(self.m_builder.label("aligned", "A", alignOpts));
    ASSERT_TRUE(self.finish());
    Vector<Vertex> alignVerts;
    CopyGlyphVertices(self.m_paint.freeze(), alignVerts);
    ASSERT_EQ(alignVerts.size(), 6u);
    EXPECT_GT(alignVerts[0u].position.x, 100.0f);
    ASSERT_TRUE(self.m_context.commitFrame(3u));
}

void VerifyUiBuilderTests_FrozenPaintRetainsValuesAndFontPagesAfterModelChangeAndBuilderReuse(mut UiBuilderTests self){
    b8 checked = true;
    String caption = "A";
    ASSERT_TRUE(self.begin(1u));
    EXPECT_FALSE(self.m_builder.checkbox("enabled", "Enabled", checked));
    ASSERT_TRUE(self.m_builder.label(s_UiBuilderCaptionKey, caption));
    ASSERT_TRUE(self.finish());
    const DrawSnapshot first = self.m_paint.freeze();
    const Expected<Rect> originalMarker = self.regionQuad(first, 9u);
    ASSERT_TRUE(originalMarker.has_value());
    EXPECT_FLOAT_EQ(originalMarker.value().width, 20.4f);
    ASSERT_FALSE(first.glyphPages().empty());
    const Sha256Digest pixelHash = ComputeUiBuilderFirstGlyphPageHash(first);
    Vector<Vertex> saved;
    saved.reserve(first.vertices().size());
    for(usize index = 0u; index < first.vertices().size(); ++index)
        saved.push_back(first.vertices()[index]);
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    checked = false;
    caption.assign("A longer changed model caption");
    ASSERT_TRUE(self.begin(2u));
    EXPECT_FALSE(self.m_builder.checkbox("enabled", "Enabled", checked));
    ASSERT_TRUE(self.m_builder.label(s_UiBuilderCaptionKey, caption));
    ASSERT_TRUE(self.finish());
    const DrawSnapshot second = self.m_paint.freeze();
    EXPECT_FALSE(self.regionQuad(second, 9u).has_value());
    const Expected<Rect> retainedMarker = self.regionQuad(first, 9u);
    ASSERT_TRUE(retainedMarker.has_value());
    EXPECT_FLOAT_EQ(retainedMarker.value().width, originalMarker.value().width);
    ASSERT_EQ(first.vertices().size(), saved.size());
    EXPECT_TRUE(EqualUiBuilderVertexBytes(first.vertices(), saved));
    EXPECT_EQ(ComputeUiBuilderFirstGlyphPageHash(first), pixelHash);
    EXPECT_EQ(ReadUiBuilderFirstGlyphPageFontGeneration(first), 1u);
    EXPECT_EQ(first.generation(), 1u);
    EXPECT_EQ(second.generation(), 2u);
    ASSERT_TRUE(self.m_context.commitFrame(2u));
}


