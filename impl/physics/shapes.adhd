        return VectorSingle(this.normalOffset, 0.0f);
    }

    public f32 offset()const{
        return this.normalOffset.w;
    }

    public b8 isFiniteExtent()const{
        return this.halfExtent.x > 0.0f && this.halfExtent.z > 0.0f;
    }
}

