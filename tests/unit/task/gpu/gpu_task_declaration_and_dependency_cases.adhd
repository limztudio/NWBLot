const Name s_GpuDeclDeferredLightingPipelinePath = "tests/task_graph/deferred_lighting_pipeline";
const StringView s_GpuDeclDeepCycleTaskLabel = "Deep Cycle Task";
const usize s_GpuDeclMaxDenseScratchBytes = 32u * 1024u * 1024u;

enum<u8> GpuDeclDenseScenario{
    Explicit = 0,
    Inferred = 1,
    Mixed = 2,
    kCount
}

TwoQueueCompile GpuDecl_MakeTwoQueueCompile(mut TestArena testArena){
    return TwoQueueCompile(testArena);
}

GpuDeclFrameGraphBuilder GpuDecl_MakeFrameGraphBuilder(
    mut ScratchArena scratchArena,
    mut GpuDeclNodeDescs nodes,
    mut GpuDeclEdgeDescs edges,
    mut GpuDeclPendingEdges pendingEdges
){
    return GpuDeclFrameGraphBuilder(scratchArena, nodes, edges, pendingEdges);
}

GpuTaskId GpuDecl_MakeTaskId(in u64 generation, in u32 index){
    GpuTaskId id = GpuTaskId();
    id.generation = generation;
    id.index = index;
    return id;
}

GpuPhysicalQueueTopology GpuDecl_MakeTopology(in Span<GpuPhysicalQueueInfo> queues, in usize count){
    GpuPhysicalQueueTopology topology = GpuPhysicalQueueTopology();
    native(in queues, in count, mut topology){
        topology.queues = queues.data();
        topology.queueCount = count;
    }
    return topology;
}

b8 GpuDecl_HasFatalFailure(){
    b8 failed = false;
    native(mut failed){
        failed = ::testing::Test::HasFatalFailure();
    }
    return failed;
}

b8 GpuDecl_HasEdge(in GpuTaskGraphAnalysis analysis, in GpuTaskId producer, in GpuTaskId consumer){
    b8 found = false;
    native(in analysis, in producer, in consumer, mut found){
        found = FindEdge(analysis, producer, consumer) != nullptr;
    }
    return found;
}

Optional<GpuTaskDependencyEdge> GpuDecl_FindEdge(in GpuTaskGraphAnalysis analysis, in GpuTaskId producer, in GpuTaskId consumer){
    Optional<GpuTaskDependencyEdge> out = Optional<GpuTaskDependencyEdge>();
    native(in analysis, in producer, in consumer, mut out){
        if(const Core::GpuTaskDependencyEdge* const found = FindEdge(analysis, producer, consumer))
            out = *found;
    }
    return out;
}

Optional<GpuTaskQueueAssignment> GpuDecl_FindAssignment(in GpuTaskGraphQueueAssignments assignments, in GpuTaskId task){
    Optional<GpuTaskQueueAssignment> out = Optional<GpuTaskQueueAssignment>();
    native(in assignments, in task, mut out){
        if(const Core::GpuTaskQueueAssignment* const found = assignments.find(task))
            out = *found;
    }
    return out;
}

Optional<GpuCompiledTask> GpuDecl_TaskPlan(in GpuCompiledTaskView view){
    Optional<GpuCompiledTask> out = Optional<GpuCompiledTask>();
    native(in view, mut out){
        if(view.plan)
            out = *view.plan;
    }
    return out;
}

Span<GpuCompiledBarrier> GpuDecl_PrologueBarriers(in GpuCompiledTaskView view){
    Span<GpuCompiledBarrier> out = Span<GpuCompiledBarrier>();
    native(in view, mut out){
        if(view.plan && view.prologueBarriers)
            out = Span<const Core::GpuCompiledBarrier>(view.prologueBarriers, view.plan->prologueBarrierCount);
    }
    return out;
}

Span<GpuPacketStateSeed> GpuDecl_PrologueSeeds(in GpuCompiledTaskView view){
    Span<GpuPacketStateSeed> out = Span<GpuPacketStateSeed>();
    native(in view, mut out){
        if(view.plan && view.prologueStateSeeds)
            out = Span<const Core::GpuPacketStateSeed>(view.prologueStateSeeds, view.plan->prologueStateSeedCount);
    }
    return out;
}

Span<GpuPacketDependency> GpuDecl_PacketDependencies(in GpuCompiledPacketView view){
    Span<GpuPacketDependency> out = Span<GpuPacketDependency>();
    native(in view, mut out){
        if(view.plan && view.dependencies)
            out = Span<const Core::GpuPacketDependency>(view.dependencies, view.plan->dependencyCount);
    }
    return out;
}

Span<GpuTaskId> GpuDecl_PacketTasks(in GpuCompiledPacketView view){
    Span<GpuTaskId> out = Span<GpuTaskId>();
    native(in view, mut out){
        if(view.plan && view.tasks)
            out = Span<const Core::GpuTaskId>(view.tasks, view.plan->taskCount);
    }
    return out;
}

b8 GpuDecl_HasPacketTasksPtr(in GpuCompiledPacketView view){
    b8 hasPtr = false;
    native(in view, mut hasPtr){
        hasPtr = view.tasks != nullptr;
    }
    return hasPtr;
}

