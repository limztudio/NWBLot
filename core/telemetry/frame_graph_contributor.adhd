[cpp_header("<core/telemetry/frame_graph_contributor.h>"), cpp_name("::NWB::Core::Telemetry::FrameGraphBuilder"), cpp_flags(no_copy, no_assign)]
extern class FrameGraphBuilder{
    void addEdge(...);
    FrameGraphNodeHandle addExternal(...);
    b8 addPacketSubmissionStatistics(...);
    FrameGraphNodeHandle addPass(...);
    b8 addPhysicalQueueRuntimeStatistics(...);
    FrameGraphNodeHandle addResource(...);
    void dependsOnByName(...);
    u64 frameIndex(...)const;
};

[cpp_header("<core/telemetry/frame_graph_contributor.h>"), cpp_name("::NWB::Core::Telemetry::FrameGraphNodeHandle"), cpp_flags(self_defaulted, small_value, binary_serializable, brace_init)]
extern class FrameGraphNodeHandle{
    u32 index;
    b8 valid(...)const;
};

[cpp_header("<core/telemetry/frame_graph_contributor.h>"), cpp_name("::NWB::Core::Telemetry::FrameGraphPassMetadata"), cpp_flags(self_defaulted, binary_serializable, brace_init)]
extern class FrameGraphPassMetadata{
    FrameGraphQueueAssignment queueAssignment;
    FrameGraphCompiledTask compiledTask;
    FrameGraphRuntimeStatistics runtimeStatistics;
};

[cpp_header("<core/telemetry/frame_graph_contributor.h>"), cpp_name("::NWB::Core::Telemetry::FrameGraphPendingNameEdge"), cpp_flags(self_defaulted, binary_serializable, brace_init)]
extern class FrameGraphPendingNameEdge{
    Name toName;
    u32 fromNodeIndex;
    FrameGraphEdgeKind kind;
    u8 flags;
};

[cpp_header("<core/telemetry/frame_graph_contributor.h>"), cpp_name("::NWB::Core::Telemetry::IFrameGraphContributor"), cpp_flags(no_copy, no_assign, abstract, polymorphic_base)]
extern class IFrameGraphContributor{
    [cpp_flags(unwind)] b8 appendFrameGraph(mut FrameGraphBuilder builder);
};


