#include <impl/ecs_ui/toolkit/context.adhd>
#include <impl/ecs_ui/toolkit/widgets/edit_box.adhd>
#include <impl/ecs_ui/toolkit/widgets/text_area.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Shape the event's current model during the host loan. The resolver keeps no layout between keys.
class TextAreaNavigationResolver : IEditNavigationResolver{
    private mut TextService m_text;
    private in Context m_context;
    private in TextAreaState m_state;
    private String m_language;
    private u64 m_instanceGeneration = 0u;
    private u64 m_revision = 0u;
    private f32 m_fontSize = 0.0f;
    private u32 m_scriptTag = 0u;

    public TextAreaNavigationResolver(mut TextService text, in Context context, in TextAreaState state, in f32 fontSize){
        this.m_text = text;
        this.m_context = context;
        this.m_state = state;
        this.capture(fontSize, s_TextDefaultScriptTag, s_TextDefaultLanguage);
    }

    public TextAreaNavigationResolver(mut TextService text, in Context context, in TextAreaState state, in f32 fontSize, in u32 scriptTag){
        this.m_text = text;
        this.m_context = context;
        this.m_state = state;
        this.capture(fontSize, scriptTag, s_TextDefaultLanguage);
    }

    public TextAreaNavigationResolver(mut TextService text, in Context context, in TextAreaState state, in f32 fontSize, in u32 scriptTag, in StringView language){
        this.m_text = text;
        this.m_context = context;
        this.m_state = state;
        this.capture(fontSize, scriptTag, language);
    }

    private void capture(in f32 fontSize, in u32 scriptTag, in StringView language){
        this.m_instanceGeneration = this.m_state.instanceGeneration();
        this.m_revision = this.m_state.revision();
        this.m_fontSize = fontSize;
        this.m_scriptTag = scriptTag;
        this.m_language.assign(language);
    }
    private b8 current()const{
        return !this.m_context.failed() && this.m_state.instanceGeneration() == this.m_instanceGeneration && this.m_state.revision() == this.m_revision;
    }

    public Expected<EditNavigationResult> resolve(in EditModel model, in EditNavigationDirection direction, in EditNavigationSnapshot preferred, in f32 viewportHeight)override{
        const Expected<b8> page = ValidateTextAreaNavigationInputs(model.textMode(), model.composition().active, direction, this.m_fontSize, viewportHeight, preferred);
        if(!this.current() || !page.has_value() || !this.m_state.navigation().matches(preferred))
            return MakeUnexpected(Failure());
        const TextAreaModelStamp expected = model.stamp();
        EditBoxView view;
        const ShapeRequest request("", StringView(this.m_language), this.m_fontSize, this.m_scriptTag, TextDirection::LeftToRight);
        if(!view.snapshot(model) || view.shape(this.m_text, request) != TextLayoutStatus::Success)
            return MakeUnexpected(Failure());
        if(!this.current() || !model.matchesStamp(expected) || model.composition().active || !this.m_state.navigation().matches(preferred))
            return MakeUnexpected(Failure());
        in EditCaretGeometry geometry = view.caretGeometry();
        return TryResolveTextAreaNavigationTarget(
            geometry.ready(), page.value(), direction, preferred, viewportHeight, model.caret(), view.displayCaret(),
            geometry.layout().utf8(), geometry.layout().lines(), geometry.layout().clusters(), geometry.boundaries(),
            geometry.lines(), geometry.caretStops()
        );
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

