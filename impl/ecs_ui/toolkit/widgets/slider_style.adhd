#include "style.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// The default key step is one hundredth of the range.
const f64 s_SliderDefaultKeyStepDivisor = 100.0;
const u32 s_SliderPageStepCount = 10u;

class SliderStyle{
    public Name track = Name("slider.track");
    public Name normal = Name("slider.thumb.normal");
    public Name hover = Name("slider.thumb.hover");
    public Name pressed = Name("slider.thumb.pressed");
    public Name disabled = Name("slider.thumb.disabled");
    public Name trackFallback = Name("scrollbar.track");
    public Name thumbFallback = Name("scrollbar.thumb.normal");
    public Name focus = Name("focus.overlay");
    public Color hoverTint = s_StyleHoverTint;
    public Color pressedTint = s_StylePressedTint;
    public Color disabledTint = s_StyleDisabledTint;
    public Insets padding = Insets(s_StyleSpacingSmall, s_StyleSpacingSmall, s_StyleSpacingSmall, s_StyleSpacingSmall);
    public Point thumbExtent = Point(s_StyleControlExtent, s_StyleControlExtent);
    public f32 trackHeight = s_StyleSliderTrackHeight;
}

class SliderOptions{
    public LayoutSize width = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
    public f32 height = s_StyleControlHeight;
    public b8 enabled = true;
    public f64 minimum = 0.0;
    public f64 maximum = 1.0;
    // Zero chooses one hundredth of the range, with a representable fallback for tiny spans.
    public f64 keyStep = 0.0;
}

class SliderResult{
    public b8 valid = false;
    public b8 valueChanged = false;
    public b8 focused = false;
    public b8 dragging = false;
}

class SliderSnapshot{
    public b8 operator==(in SliderSnapshot rhs)const{
        return this.instanceGeneration == rhs.instanceGeneration
            && this.inputGeneration == rhs.inputGeneration
            && this.revision == rhs.revision
            && this.admissionGeneration == rhs.admissionGeneration
            && this.valueBits == rhs.valueBits
            && this.press == rhs.press
            && this.pressMoved == rhs.pressMoved;
    }

    public b8 operator!=(in SliderSnapshot rhs)const{
        return this.instanceGeneration != rhs.instanceGeneration
            || this.inputGeneration != rhs.inputGeneration
            || this.revision != rhs.revision
            || this.admissionGeneration != rhs.admissionGeneration
            || this.valueBits != rhs.valueBits
            || this.press != rhs.press
            || this.pressMoved != rhs.pressMoved;
    }

    public u64 instanceGeneration = 0u;
    public u64 inputGeneration = 0u;
    public u64 revision = 0u;
    public u64 admissionGeneration = 0u;
    public u64 valueBits = 0u;
    public InputActionId press;
    public b8 pressMoved = false;
}

class SliderMetrics{
    public Insets padding;
    public Point thumbExtent = Point(s_StyleControlExtent, s_StyleControlExtent);
    public f32 trackHeight = s_StyleSliderTrackHeight;
    public Point contentSize;
}

class SliderPlacement{
    public Rect bounds;
    public Rect clip;
    public Rect travelBounds;
    public Rect track;
    public Rect centerTravel;
    public Rect thumb;
    public Point thumbExtent;
}

b8 SameSliderPlacementGeometry(in SliderPlacement lhs, in SliderPlacement rhs){
    return EqualUiRect(lhs.bounds, rhs.bounds)
        && EqualUiRect(lhs.clip, rhs.clip)
        && EqualUiRect(lhs.travelBounds, rhs.travelBounds)
        && EqualUiRect(lhs.track, rhs.track)
        && EqualUiRect(lhs.centerTravel, rhs.centerTravel)
        && bit_cast<u32>(lhs.thumbExtent.x) == bit_cast<u32>(rhs.thumbExtent.x)
        && bit_cast<u32>(lhs.thumbExtent.y) == bit_cast<u32>(rhs.thumbExtent.y);
}

b8 IsValidSliderRange(in f64 minimum, in f64 maximum){
    return IsFinite(minimum) && IsFinite(maximum) && minimum <= maximum;
}

b8 IsValidSliderPlacement(in SliderPlacement placement){
    return IsPreciseUiRect(placement.bounds)
        && IsPreciseUiRect(placement.clip)
        && IsPreciseUiRect(placement.travelBounds)
        && IsPreciseUiRect(placement.track)
        && IsPreciseUiRect(placement.centerTravel)
        && IsPreciseUiRect(placement.thumb)
        && IsValidUiExtent(placement.thumbExtent)
        && placement.thumbExtent.x == placement.thumb.width
        && placement.thumbExtent.y == placement.thumb.height
        && placement.thumbExtent.x <= placement.travelBounds.width
        && placement.thumbExtent.y <= placement.travelBounds.height
        && placement.centerTravel.width <= placement.travelBounds.width
        && placement.centerTravel.height <= placement.travelBounds.height
        && placement.track.width <= placement.travelBounds.width
        && placement.track.height <= placement.travelBounds.height;
}

b8 IsValidSliderGesture(in PointerGesture gesture){
    return gesture.id.valid()
        && gesture.updateSequence != 0u
        && gesture.state <= PointerGestureState::Completed
        && IsFinite(gesture.origin.x)
        && IsFinite(gesture.origin.y)
        && IsFinite(gesture.position.x)
        && IsFinite(gesture.position.y)
        && IsPreciseUiRect(gesture.targetRectangle)
        && IsPreciseUiRect(gesture.referenceRectangle);
}

b8 IsValidSliderOptions(in SliderOptions options){
    return IsValidSliderRange(options.minimum, options.maximum)
        && IsFinite(options.keyStep)
        && options.keyStep >= 0.0
        && IsValidLayoutSize(options.width)
        && IsFinite(options.height)
        && options.height >= 0.0f;
}

void ApplySkinPaletteToSliderStyle(in UiSkinPalette palette, mut SliderStyle style){
    style.hoverTint = ResolveUiSkinColor(palette, UiSkinColorRole::ControlHoverTint);
    style.pressedTint = ResolveUiSkinColor(palette, UiSkinColorRole::ControlPressedTint);
    style.disabledTint = ResolveUiSkinColor(palette, UiSkinColorRole::ControlDisabledTint);
}

b8 IsValidSliderMetrics(in SliderMetrics metrics){
    if(
        !IsValidUiPadding(metrics.padding)
        || !IsFinite(metrics.thumbExtent.x) || metrics.thumbExtent.x <= 0.0f
        || !IsFinite(metrics.thumbExtent.y) || metrics.thumbExtent.y <= 0.0f
        || !IsFinite(metrics.trackHeight) || metrics.trackHeight <= 0.0f
        || !IsValidUiExtent(metrics.contentSize)
    )
        return false;
    const f64 padW = cast<f64>(metrics.padding.left) + cast<f64>(metrics.padding.right);
    const f64 padH = cast<f64>(metrics.padding.top) + cast<f64>(metrics.padding.bottom);
    const f64 width = padW + cast<f64>(metrics.thumbExtent.x);
    const f64 height = padH + Max(cast<f64>(metrics.thumbExtent.y), cast<f64>(metrics.trackHeight));
    return width <= s_UiMaxFloatF64
        && height <= s_UiMaxFloatF64
        && cast<f64>(metrics.contentSize.x) >= cast<f64>(cast<f32>(width))
        && cast<f64>(metrics.contentSize.y) >= cast<f64>(cast<f32>(height));
}

Expected<SliderMetrics> MeasureSlider(in SliderOptions options, in SliderStyle style){
    if(
        !IsValidSliderOptions(options)
        || !IsValidUiPadding(style.padding)
        || !IsFinite(style.thumbExtent.x) || style.thumbExtent.x <= 0.0f
        || !IsFinite(style.thumbExtent.y) || style.thumbExtent.y <= 0.0f
        || !IsFinite(style.trackHeight) || style.trackHeight <= 0.0f
        || !IsValidUiColor(style.hoverTint) || !IsValidUiColor(style.pressedTint) || !IsValidUiColor(style.disabledTint)
    )
        return MakeUnexpected(Failure());
    SliderMetrics candidate;
    candidate.padding = style.padding;
    candidate.thumbExtent = style.thumbExtent;
    candidate.trackHeight = style.trackHeight;
    const f64 padW = cast<f64>(style.padding.left) + cast<f64>(style.padding.right);
    const f64 padH = cast<f64>(style.padding.top) + cast<f64>(style.padding.bottom);
    const f64 width = padW + cast<f64>(style.thumbExtent.x);
    const f64 intrinsicH = padH + Max(cast<f64>(style.thumbExtent.y), cast<f64>(style.trackHeight));
    const f64 height = Max(intrinsicH, cast<f64>(options.height));
    if(!IsFinite(width) || width > s_UiMaxFloatF64 || !IsFinite(height) || height > s_UiMaxFloatF64)
        return MakeUnexpected(Failure());
    candidate.contentSize = Point(cast<f32>(width), cast<f32>(height));
    if(!IsValidSliderMetrics(candidate))
        return MakeUnexpected(Failure());
    return candidate;
}

Expected<SliderPlacement> PlaceSlider(in Rect bounds, in Rect clip, in SliderMetrics metrics, in f64 normalized){
    if(!IsPreciseUiRect(bounds) || !IsPreciseUiRect(clip) || !IsValidSliderMetrics(metrics) || !IsFinite(normalized) || normalized < 0.0 || normalized > 1.0)
        return MakeUnexpected(Failure());
    SliderPlacement candidate;
    candidate.bounds = bounds;
    const Expected<Rect> clipped = TryIntersectUiRects(bounds, clip, UiRectPrecision::PreciseExtents);
    if(!clipped.has_value())
        return MakeUnexpected(Failure());
    candidate.clip = clipped.value();
    const VectorDouble insetRect = ComputeInsetUiRectBounds(bounds, metrics.padding);
    const f64 x = insetRect.x;
    const f64 y = insetRect.y;
    const f64 w = insetRect.z;
    const f64 h = insetRect.w;
    const f64 thumbW = Min(cast<f64>(metrics.thumbExtent.x), Max(0.0, w));
    const f64 thumbH = Min(cast<f64>(metrics.thumbExtent.y), Max(0.0, h));
    const f64 trackH = Min(cast<f64>(metrics.trackHeight), h);
    const f64 travelW = w - thumbW;
    const f64 centerStartX = x + thumbW * 0.5;
    const f64 thumbCenterX = x + travelW * normalized;
    f64 thumbX = thumbCenterX;
    if(normalized == 0.0)
        thumbX = x;
    else if(normalized == 1.0)
        thumbX = x + travelW;
    const Expected<Rect> travelBounds = TryMakeUiRect(x, y, w, h, UiRectPrecision::PreciseExtents);
    if(!travelBounds.has_value())
        return MakeUnexpected(Failure());
    candidate.travelBounds = travelBounds.value();
    const Expected<Rect> centerTravel = TryMakeUiRect(centerStartX, y, travelW, h, UiRectPrecision::PreciseExtents);
    if(!centerTravel.has_value())
        return MakeUnexpected(Failure());
    candidate.centerTravel = centerTravel.value();
    const f64 trackY = y + (h - trackH) * 0.5;
    const f64 thumbY = y + (h - thumbH) * 0.5;
    const Expected<Rect> track = TryMakeUiRect(centerStartX, trackY, travelW, trackH, UiRectPrecision::PreciseExtents);
    if(!track.has_value())
        return MakeUnexpected(Failure());
    candidate.track = track.value();
    const Expected<Rect> thumb = TryMakeUiRect(thumbX, thumbY, thumbW, thumbH, UiRectPrecision::PreciseExtents);
    if(!thumb.has_value())
        return MakeUnexpected(Failure());
    candidate.thumb = thumb.value();
    candidate.thumbExtent = Point(cast<f32>(thumbW), cast<f32>(thumbH));
    return candidate;
}


