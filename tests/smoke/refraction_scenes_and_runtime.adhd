#include <impl/ecs_render/refraction/types.adhd>
#include <impl/ecs_render/module.adhd>
#include <loader/project_entry.adhd>
#include <loader/runtime_constants.adhd>
#include "refraction_gallery_scene.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const SmokeMaterialRef s_RefractionSceneClearMaterial = "project/smoke/refraction/materials/clear";
const SmokeMaterialRef s_RefractionSceneOpaqueMaterial = "project/smoke/refraction/materials/opaque";
const SmokeMaterialRef s_RefractionSceneTransparentMaterial = "project/smoke/refraction/materials/transparent";
const SmokeMeshRef s_RefractionScenePlaneMesh = "project/meshes/shadow_plane";
const SmokeMeshRef s_RefractionSceneCubeMesh = "project/meshes/cube_hard_edges";
const SmokeMeshRef s_RefractionSceneSphereMesh = "project/meshes/caustic_sphere";
const usize s_RefractionLifecyclePhaseCount = 7u;
const u32 s_RefractionDefaultCaptureFrameCount = 16u;
const u64 s_RefractionFrameGraphRequiredFrames = 360u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RefractionTargetFrames{
    public ProjectFrameClientSize extent;
    public u64 currentFrame;
    public u64 startFrame;
    public RefractionTargetFrames(in ProjectFrameClientSize extent, in u64 currentFrame, in u64 startFrame){
        this.extent = extent;
        this.currentFrame = currentFrame;
        this.startFrame = startFrame;
    }
}

class RefractionQueryDiagnostics : ISmokeCapturePredicate{
    public RefractionQueryDiagnostics(mut ProjectRuntimeContext context){
        this.m_context = context;
    }

    public b8 configure(in b8 densityEnabled, in b8 lifecycleEnabled, in b8 timingEnabled, mut World world){
        const Expected<Optional<String>, ErrorCode> configured = ReadEnvironmentVariable("NWB_REFRACTION_SMOKE_DIAGNOSTICS");
        if(!configured.has_value()){
            error("RefractionSmokeProject: diagnostics must be absent, 0, or 1");
            return false;
        }
        if(configured.value().has_value()){
            const StringView configuredView = StringView(configured.value().value());
            if(configuredView != "0" && configuredView != "1"){
                error("RefractionSmokeProject: diagnostics must be absent, 0, or 1");
                return false;
            }
            this.m_enabled = configuredView == "1";
        }
        else{
            this.m_enabled = false;
        }
        if(!this.m_enabled)
            return true;

        const Expected<Optional<String>, ErrorCode> freeze = ReadEnvironmentVariable("NWB_RENDERER_BASELINE_CAPTURE_FREEZE_FRAME");
        const Expected<String> readback = ReadSmokeEnvironmentString("NWB_SMOKE_FRAMEBUFFER_CAPTURE_PATH");
        const Expected<Optional<String>, ErrorCode> hardware = ReadEnvironmentVariable("NWB_REFRACTION_SMOKE_HARDWARE");
        const b8 invalidHardware = !hardware.has_value()
            || (hardware.value().has_value() && StringView(hardware.value().value()) != "1");
        if(
            !freeze.has_value()
            || freeze.value().has_value()
            || !readback.has_value()
            || !densityEnabled
            || lifecycleEnabled
            || timingEnabled
            || invalidHardware
        ){
            error("RefractionSmokeProject: query diagnostics require a hardware density framebuffer capture with timing, lifecycle, and frame freeze disabled");
            return false;
        }
        SmokeRendererSystemRef(world).setRefractionDiagnosticsEnabled(true);
        return true;
    }

    public void update(mut World world){
        if(!this.m_enabled || this.m_reported)
            return;
        const auto observation = ObserveRefractionTargetFrames(this.m_context.graphics, s_RefractionDiagnosticsRequiredTargetFrames, this.m_targetStart);
        if(!observation.has_value())
            return;
        const RefractionTargetFrames frames = observation.value();

        const Expected<RefractionStatistics> result = SmokeRendererSystemRef(world).tryGetLatestRefractionStatistics();
        if(!result.has_value())
            return;
        const RefractionStatistics statistics = result.value();
        if(
            statistics.width == frames.extent.width
            && statistics.height == frames.extent.height
            && statistics.graphicsFrameIndex >= frames.startFrame
            && statistics.graphicsFrameIndex - frames.startFrame >= s_RefractionDiagnosticsRequiredTargetFrames
            && statistics.graphicsFrameIndex <= frames.currentFrame
        ){
            LogRefractionQueryDiagnosticsCounters(statistics, frames.currentFrame, frames.startFrame);
            this.m_sourceFrame = statistics.graphicsFrameIndex;
            this.m_reported = true;
        }
    }

    public b8 enabled()const{
        return this.m_enabled;
    }

    public b8 shouldCapture(in u64 graphicsFrame)const{
        return ShouldCaptureRefractionQueryDiagnostics(this.m_reported, graphicsFrame, this.m_sourceFrame);
    }

    public b8 shouldCaptureFrame(in u64 graphicsFrame)const override{
        return this.shouldCapture(graphicsFrame);
    }

    private mut ProjectRuntimeContext m_context;
    private Optional<u64> m_targetStart;
    private u64 m_sourceFrame = 0u;
    private b8 m_enabled = false;
    private b8 m_reported = false;
}

[arena]
class RefractionSmokeProjectImpl : IProjectEntryCallbacks{
    public RefractionSmokeProjectImpl(mut NotNullUniquePtr<World> world, mut ProjectRuntimeContext context){
        this.m_context = context;
        this.m_world = TakeSmokeWorld(world);
        this.m_queryDiagnostics = RefractionQueryDiagnostics(context);
        this.m_timingRenderPass = AvboitTimingRenderPass(context.graphics);
        this.m_fpsProbe = FpsProbe(RefractionSmokeProjectName());
        this.m_gpuPassTimingProbe = GpuPassTimingProbe(RefractionSmokeProjectName());
    }

    public ~RefractionSmokeProjectImpl(){
        this.m_timingRenderPass.stop();
        DestroyCapturedSmokeRenderWorld(this.m_context, this.m_world, this.m_framebufferCapture);
    }

    public b8 onStartup()override{
        this.m_lifecycleEnabled = ReadSmokeEnvironmentFlag("NWB_REFRACTION_SMOKE_LIFECYCLE");
        this.m_timingEnabled = ReadSmokeEnvironmentFlag("NWB_REFRACTION_SMOKE_TIMING");
        const Expected<Optional<u32>> density = ReadRefractionDensityPercent();
        if(!density.has_value())
            return false;
        const Optional<u32> densityValue = density.value();
        this.m_densityEnabled = densityValue.has_value();

        if(!this.m_queryDiagnostics.configure(
            this.m_densityEnabled,
            this.m_lifecycleEnabled,
            this.m_timingEnabled,
            SmokeWorldRef(this.m_world)
        ))
            return false;
        if(!this.configureFrameGraphSnapshot())
            return false;
        if(this.m_timingEnabled){
            this.m_context.setPerfCapture(PerfCaptureOptionsGpuTimingOnly());
            if(!this.m_timingRenderPass.start())
                return false;
        }
        if(!this.configureFramebufferCapture())
            return false;

        const Expected<String> galleryCase = ReadSmokeEnvironmentString("NWB_REFRACTION_SMOKE_CASE");
        const b8 hasGalleryCase = galleryCase.has_value();
        if((hasGalleryCase && this.m_lifecycleEnabled) || (this.m_densityEnabled && (hasGalleryCase || this.m_lifecycleEnabled))){
            error("RefractionSmokeProject: lifecycle, gallery, and density cases are mutually exclusive");
            return false;
        }
        if(this.m_densityEnabled){
            const Expected<EntityID> glassResult = CreateRefractionDensityScene(
                densityValue.value(),
                SmokeWorldRef(this.m_world),
                this.m_context
            );
            if(!glassResult.has_value())
                return false;
            this.m_glass = glassResult.value();
            return true;
        }
        if(hasGalleryCase){
            const StringView caseView = StringView(galleryCase.value());
            const b8 geometryPreview = ReadSmokeEnvironmentFlag("NWB_REFRACTION_SMOKE_GEOMETRY");
            return CreateRefractionGalleryScene(caseView, geometryPreview, SmokeWorldRef(this.m_world));
        }

        const EntityID camera = CreateSmokeCamera(1.4f, 6.0f, 0.0f, SmokeWorldRef(this.m_world));
        const EntityID light = CreateSmokeDirectionalLight(
            0.6f,
            0.4f,
            0.0f,
            VectorSingle(1.0f, 1.0f, 1.0f, 1.0f),
            1.0f,
            false,
            SmokeWorldRef(this.m_world)
        );
        const EntityID glassEntity = CreateTintedStaticMeshEntity(
            s_RefractionSceneSphereMesh,
            s_RefractionSceneClearMaterial,
            NameTextAscii(s_SmokeSurfaceMaterialInterface),
            VectorSingle(1.0f, 1.0f, 1.0f, 1.0f),
            VectorSingle(0.0f, 1.4f, 0.0f, 0.0f),
            VectorSingle(1.15f, 1.15f, 1.15f, 0.0f),
            SmokeWorldRef(this.m_world)
        );
        const b8 defaultSceneOk = camera.valid() && glassEntity.valid() && light.valid();
        [essential] assert(defaultSceneOk, "RefractionSmokeProject: camera/glass/light creation failed");

        u32 stripeCount = 20u;
        f32 stripeStart = -2.85f;
        if(this.m_lifecycleEnabled){
            stripeCount = 48u;
            stripeStart = -7.05f;
        }
        for(u32 stripe = 0u; stripe < stripeCount; ++stripe){
            f32 value = 0.04f;
            if((stripe & 1u) != 0u)
                value = 0.92f;
            const f32 x = cast<f32>(stripe) * 0.3f + stripeStart;
            CreateRefractionScenePanel(
                s_RefractionSceneOpaqueMaterial,
                VectorSingle(value, value, value, 1.0f),
                VectorSingle(x, 1.4f, 2.8f, 0.0f),
                VectorSingle(0.15f, 1.0f, 2.0f, 0.0f),
                SmokeWorldRef(this.m_world)
            );
        }
        CreateRefractionScenePanel(
            s_RefractionSceneTransparentMaterial,
            VectorSingle(1.0f, 0.025f, 0.025f, 0.75f),
            VectorSingle(0.0f, 0.85f, -1.7f, 0.0f),
            VectorSingle(1.6f, 1.0f, 0.08f, 0.0f),
            SmokeWorldRef(this.m_world)
        );
        CreateRefractionScenePanel(
            s_RefractionSceneTransparentMaterial,
            VectorSingle(0.025f, 0.1f, 1.0f, 0.70f),
            VectorSingle(0.0f, 1.9f, 1.6f, 0.0f),
            VectorSingle(2.0f, 1.0f, 0.12f, 0.0f),
            SmokeWorldRef(this.m_world)
        );
        this.m_glass = glassEntity;
        [essential] info("RefractionSmokeProject: zero-coverage clear sphere + opaque stripes + foreground/background AVBOIT panels created");
        if(this.m_lifecycleEnabled)
            this.applyLifecyclePhase();
        return true;
    }

    public void onShutdown()override{
        this.m_timingRenderPass.stop();
        DestroyCapturedSmokeRenderWorld(this.m_context, this.m_world, this.m_framebufferCapture);
        [essential] info("RefractionSmokeProject: shutdown");
    }

    public b8 onUpdate(in f32 delta)override{
        this.m_queryDiagnostics.update(SmokeWorldRef(this.m_world));
        UpdateSmokeFramebufferCapture(this.m_framebufferCapture);
        if(!this.advanceLifecycleCapture())
            return false;
        if(!this.updateFrameGraphSnapshot())
            return false;
        if(this.m_frameGraphSnapshotCompleted)
            return true;
        if(this.m_timingEnabled){
            this.m_fpsProbe.recordFrame(delta);
            this.m_gpuPassTimingProbe.recordFrame(delta, this.m_context.gpuTimingView());
        }
        f32 tickDelta = RendererBaselineDelta(delta);
        if(this.m_densityEnabled)
            tickDelta = 1.0f / 60.0f;
        return TickSmokeWorld(tickDelta, SmokeWorldRef(this.m_world));
    }

    private b8 configureFrameGraphSnapshot(){
        const Expected<Optional<String>, ErrorCode> path = ReadEnvironmentVariable("NWB_REFRACTION_FRAME_GRAPH_SNAPSHOT_PATH");
        if(!path.has_value()){
            error("RefractionSmokeProject: failed to read frame-graph snapshot path");
            return false;
        }
        if(!path.value().has_value())
            return true;
        const Expected<Optional<String>, ErrorCode> readback = ReadEnvironmentVariable("NWB_SMOKE_FRAMEBUFFER_CAPTURE_PATH");
        const Expected<Optional<String>, ErrorCode> freeze = ReadEnvironmentVariable("NWB_RENDERER_BASELINE_CAPTURE_FREEZE_FRAME");
        const StringView candidatePath = StringView(path.value().value());
        if(
            !readback.has_value()
            || !freeze.has_value()
            || candidatePath.empty()
            || this.m_timingEnabled
            || this.m_lifecycleEnabled
            || this.m_queryDiagnostics.enabled()
            || readback.value().has_value()
            || freeze.value().has_value()
        ){
            error("RefractionSmokeProject: a nonempty frame-graph snapshot path requires timing, lifecycle, framebuffer readback, and frame freeze disabled");
            return false;
        }
        this.m_frameGraphSnapshotPath = candidatePath;
        return true;
    }

    private b8 updateFrameGraphSnapshot(){
        if(this.m_frameGraphSnapshotPath.empty() || this.m_frameGraphSnapshotCompleted)
            return true;
        const auto observation = ObserveRefractionTargetFrames(this.m_context.graphics, s_RefractionFrameGraphRequiredFrames, this.m_frameGraphTargetStart);
        if(!observation.has_value())
            return true;
        const RefractionTargetFrames frames = observation.value();
        const u64 completedFrames = frames.currentFrame - frames.startFrame;
        if(!CaptureStressFrameGraphSnapshot(StringView(this.m_frameGraphSnapshotPath), completedFrames, this.m_context))
            return false;
        this.m_frameGraphSnapshotCompleted = true;
        [essential] info("RefractionFrameGraphSnapshot: target_extent {}x{} completed_target_frames {}", frames.extent.width, frames.extent.height, completedFrames);
        RequestSmokeQuit(this.m_context);
        return true;
    }

    private b8 configureFramebufferCapture(){
        if(this.m_lifecycleEnabled){
            const Expected<String> output = ReadSmokeEnvironmentString("NWB_SMOKE_FRAMEBUFFER_CAPTURE_PATH");
            if(!output.has_value()){
                error("RefractionSmokeProject: lifecycle requires application framebuffer capture");
                return false;
            }
            const StringView outputView = StringView(output.value());
            const auto captureFrames = ReadSmokeCaptureFrameCount(s_RefractionDefaultCaptureFrameCount);
            if(!captureFrames.has_value()){
                error("RefractionSmokeProject: lifecycle frame count must be a positive u32");
                return false;
            }
            this.m_lifecyclePaths.reserve(s_RefractionLifecyclePhaseCount);
            for(usize phase = 0u; phase < s_RefractionLifecyclePhaseCount; ++phase){
                String phasePath;
                if(phase + 1u == s_RefractionLifecyclePhaseCount){
                    phasePath = String(outputView);
                }
                else{
                    const StringView phaseName = RefractionLifecyclePhaseAt(phase).name;
                    phasePath = StringFormat("{}.{}.bmp", outputView, phaseName);
                }
                this.m_lifecyclePaths.push_back(phasePath);
            }
            const StringView firstPath = StringView(this.m_lifecyclePaths[0u]);
            const ProjectFrameClientSize extent = GetProjectFrameClientSize();
            FramebufferCaptureOptions options = FramebufferCaptureOptions();
            options.requiredWidth = extent.width;
            options.requiredHeight = extent.height;
            options.quitWhenReady = false;
            return StartNewSmokeFramebufferCapture(
                firstPath,
                captureFrames.value(),
                this.m_context,
                options,
                this.m_framebufferCapture
            );
        }

        FramebufferCaptureOptions options = FramebufferCaptureOptions();
        if(this.m_densityEnabled){
            const ProjectFrameClientSize extent = GetProjectFrameClientSize();
            options.requiredWidth = extent.width;
            options.requiredHeight = extent.height;
            options.quitWhenReady = false;
        }
        if(this.m_queryDiagnostics.enabled()){
            options = MakeSmokeCaptureOptions(
                this.m_queryDiagnostics,
                options.requiredWidth,
                options.requiredHeight,
                options.quitWhenReady
            );
        }
        SmokeCaptureFactory captureFactory = SmokeCaptureFactory(this.m_context);
        Expected<UniquePtr<FramebufferCapture>> capture = captureFactory.configure(
            RefractionSmokeProjectName(),
            s_RefractionDefaultCaptureFrameCount,
            options
        );
        if(!capture.has_value())
            return false;
        MoveSmokeFramebufferCapture(capture.value(), this.m_framebufferCapture);
        return true;
    }

    private void applyLifecyclePhase(){
        const RefractionLifecyclePhase phase = RefractionLifecyclePhaseAt(this.m_lifecyclePhase);
        const b8 moved = SetSmokeEntityPosition(
            this.m_glass,
            VectorSingle(phase.glassX, 1.4f, 0.0f, 0.0f),
            SmokeWorldRef(this.m_world)
        );
        [essential] assert(moved, "RefractionSmokeProject: failed to move lifecycle glass");
        SmokeRendererSystemRef(SmokeWorldRef(this.m_world)).setRefractionEnabled(phase.enabled);
        [essential] info("RefractionLifecycle: phase {} applied", phase.name);
    }

    private b8 advanceLifecycleCapture(){
        if(!this.m_lifecycleEnabled || this.m_lifecyclePhase == s_RefractionLifecyclePhaseCount)
            return true;
        if(!SmokeFramebufferCaptureReady(this.m_framebufferCapture))
            return true;
        const u64 capturedFrame = SmokeFramebufferCapturedFrameIndex(this.m_framebufferCapture);
        [essential] info("RefractionLifecycle: captured {} graphics frame {}", RefractionLifecyclePhaseAt(this.m_lifecyclePhase).name, capturedFrame);
        ++this.m_lifecyclePhase;
        if(this.m_lifecyclePhase == s_RefractionLifecyclePhaseCount){
            [essential] info("RefractionLifecycle: complete samples=7");
            FinishSmokeFramebufferCapture(this.m_framebufferCapture);
            return true;
        }
        this.applyLifecyclePhase();
        const StringView nextPath = StringView(this.m_lifecyclePaths[this.m_lifecyclePhase]);
        if(!RearmSmokeFramebufferCapture(this.m_framebufferCapture, nextPath)){
            error("RefractionSmokeProject: failed to advance lifecycle capture");
            return false;
        }
        return true;
    }

    private mut ProjectRuntimeContext m_context;
    private NotNullUniquePtr<World> m_world;
    private RefractionQueryDiagnostics m_queryDiagnostics;
    private UniquePtr<FramebufferCapture> m_framebufferCapture = UniquePtr<FramebufferCapture>();
    private AvboitTimingRenderPass m_timingRenderPass;
    private FpsProbe m_fpsProbe;
    private GpuPassTimingProbe m_gpuPassTimingProbe;
    private Vector<String> m_lifecyclePaths;
    private String m_frameGraphSnapshotPath;
    private Optional<u64> m_frameGraphTargetStart;
    private usize m_lifecyclePhase = 0u;
    private EntityID m_glass = s_InvalidEntityId;
    private b8 m_lifecycleEnabled = false;
    private b8 m_timingEnabled = false;
    private b8 m_densityEnabled = false;
    private b8 m_frameGraphSnapshotCompleted = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void LogRefractionQueryCounter(in RefractionStatistics statistics, in StringView name, in u32 value){
    [essential] info("RefractionQueryCounter: sequence={} generation={} name={} value={}", statistics.sequence, statistics.generation, name, value);
}

void LogRefractionQueryDiagnosticsCounters(
    in RefractionStatistics statistics,
    in u64 currentFrame,
    in u64 targetStart
){
    [essential] info("RefractionQueryDiagnostics: sequence={} generation={} graphics_frame={} observed_frame={} target_start_frame={} completed_target_frames={} frame_index={} width={} height={} hardware_requested={} hardware_available={} hardware_ready={} csg_enabled={} token_valid={} physical_valid={} token_queue={} token_value={} physical_queue={} device_generation={}"
        , statistics.sequence
        , statistics.generation
        , statistics.graphicsFrameIndex
        , currentFrame
        , targetStart
        , statistics.graphicsFrameIndex - targetStart
        , statistics.frameIndex
        , statistics.width
        , statistics.height
        , cast<u32>(statistics.hardwareRequested)
        , cast<u32>(statistics.hardwareAvailable)
        , cast<u32>(statistics.hardwareReady)
        , cast<u32>(statistics.csgHardwareEnabled)
        , cast<u32>(statistics.acceptedToken.valid())
        , cast<u32>(statistics.acceptedToken.hasPhysicalQueueIdentity())
        , cast<u32>(statistics.acceptedToken.queue)
        , statistics.acceptedToken.value
        , statistics.acceptedToken.physicalQueueIndex
        , statistics.acceptedToken.deviceGeneration
    );
    LogRefractionQueryCounter(statistics, "hardwarePixels", statistics.hardwarePixels);
    LogRefractionQueryCounter(statistics, "entryQueries", statistics.entryQueries);
    LogRefractionQueryCounter(statistics, "entryAssociationMisses", statistics.entryAssociationMisses);
    LogRefractionQueryCounter(statistics, "entryWrongEntities", statistics.entryWrongEntities);
    LogRefractionQueryCounter(statistics, "entryFailures", statistics.entryFailures);
    LogRefractionQueryCounter(statistics, "associatedEntries", statistics.associatedEntries);
    LogRefractionQueryCounter(statistics, "invalidEntryDirections", statistics.invalidEntryDirections);
    LogRefractionQueryCounter(statistics, "exitQueries", statistics.exitQueries);
    LogRefractionQueryCounter(statistics, "exitMisses", statistics.exitMisses);
    LogRefractionQueryCounter(statistics, "exitFailures", statistics.exitFailures);
    LogRefractionQueryCounter(statistics, "tirEvents", statistics.tirEvents);
    LogRefractionQueryCounter(statistics, "tirCappedPixels", statistics.tirCappedPixels);
    LogRefractionQueryCounter(statistics, "volumeExits", statistics.volumeExits);
    LogRefractionQueryCounter(statistics, "backgroundQueries", statistics.backgroundQueries);
    LogRefractionQueryCounter(statistics, "backgroundMisses", statistics.backgroundMisses);
    LogRefractionQueryCounter(statistics, "backgroundFailures", statistics.backgroundFailures);
    LogRefractionQueryCounter(statistics, "secondaryGlassPixels", statistics.secondaryGlassPixels);
    LogRefractionQueryCounter(statistics, "transparentHits", statistics.transparentHits);
    LogRefractionQueryCounter(statistics, "backgroundLayerCapPixels", statistics.backgroundLayerCapPixels);
    LogRefractionQueryCounter(statistics, "cachedOpaqueReturns", statistics.cachedOpaqueReturns);
    LogRefractionQueryCounter(statistics, "shadedOpaqueReturns", statistics.shadedOpaqueReturns);
    LogRefractionQueryCounter(statistics, "exitScreenBackgroundReturns", statistics.exitScreenBackgroundReturns);
    LogRefractionQueryCounter(statistics, "exitStraightFallbackPixels", statistics.exitStraightFallbackPixels);
    LogRefractionQueryCounter(statistics, "materialShadeCalls", statistics.materialShadeCalls);
    LogRefractionQueryCounter(statistics, "cachedHitAttempts", statistics.cachedHitAttempts);
    LogRefractionQueryCounter(statistics, "cachedHitMisses", statistics.cachedHitMisses);
    LogRefractionQueryCounter(statistics, "physicalQueries", statistics.physicalQueries);
    LogRefractionQueryCounter(statistics, "queryBudgetUnits", statistics.queryBudgetUnits);
    LogRefractionQueryCounter(statistics, "overflowFlags", statistics.overflowFlags);
    [essential] info("RefractionQueryDiagnostics: complete sequence={} generation={} counters={}", statistics.sequence, statistics.generation, 29u);
}

AStringView RefractionSmokeProjectName(){
    return "RefractionSmokeProject";
}

ProjectFrameClientSize MakeRefractionFrameClientSize(in u32 width, in u32 height){
    ProjectFrameClientSize size = ProjectFrameClientSize();
    size.width = width;
    size.height = height;
    return size;
}

ProjectFrameClientSize QueryRefractionSmokeFrameClientSize(){
    const Expected<Optional<String>, ErrorCode> extentResult = ReadEnvironmentVariable("NWB_REFRACTION_SMOKE_EXTENT");
    [essential] assert(extentResult.has_value(), "RefractionSmokeProject: failed to read extent");
    if(!extentResult.value().has_value())
        return MakeRefractionFrameClientSize(960u, 720u);
    const StringView extent = StringView(extentResult.value().value());
    if(extent == "native" || extent == "960x720")
        return MakeRefractionFrameClientSize(960u, 720u);
    if(extent == "1600x900")
        return MakeRefractionFrameClientSize(1600u, 900u);
    if(extent == "1920x1080")
        return MakeRefractionFrameClientSize(1920u, 1080u);
    [essential] assert(extent == "npot", "RefractionSmokeProject: extent must be native, npot, 960x720, 1600x900, or 1920x1080");
    return MakeRefractionFrameClientSize(967u, 727u);
}

Expected<NotNullUniquePtr<World>> CreateRefractionSmokeWorld(mut ProjectRuntimeContext context){
    auto created = CreateSmokeWorld(RefractionSmokeProjectName(), context);
    if(!created.has_value())
        return MakeUnexpected(Failure());
    mut NotNullUniquePtr<World> world = created.value();
    AddSmokeRenderSystems(SmokeWorldRef(world), context);
    ReflectionSettings reflection = ReflectionSettings();
    reflection.traceMode = ReflectionTraceMode::Disabled;
    const b8 reflectionApplied = SmokeRendererSystemRef(SmokeWorldRef(world)).setReflectionSettings(reflection);
    [essential] assert(reflectionApplied, "RefractionSmokeProject: invalid reflection settings");
    const Expected<f32> enabled = ReadSmokeEnvironmentF32("NWB_REFRACTION_SMOKE_ENABLED");
    const b8 refractionEnabled = !enabled.has_value() || enabled.value() != 0.0f;
    SmokeRendererSystemRef(SmokeWorldRef(world)).setRefractionEnabled(refractionEnabled);
    const Expected<f32> hardware = ReadSmokeEnvironmentF32("NWB_REFRACTION_SMOKE_HARDWARE");
    const b8 hardwareEnabled = !hardware.has_value() || hardware.value() != 0.0f;
    SmokeRendererSystemRef(SmokeWorldRef(world)).setRefractionHardwareTracingEnabled(hardwareEnabled);
    StringView status = "disabled";
    if(refractionEnabled)
        status = "enabled";
    [essential] info("RefractionSmokeProject: refraction {}", status);
    return TakeSmokeWorld(world);
}

RefractionLifecyclePhase RefractionLifecyclePhaseAt(in usize phase){
    switch(phase){
    case 0u: return RefractionLifecyclePhase("baseline", 0.0f, false);
    case 1u: return RefractionLifecyclePhase("active", 0.0f, true);
    case 2u: return RefractionLifecyclePhase("moved", 1.9f, true);
    case 3u: return RefractionLifecyclePhase("edge", 4.2f, true);
    case 4u: return RefractionLifecyclePhase("empty", 100.0f, true);
    case 5u: return RefractionLifecyclePhase("disabled", 0.0f, false);
    }
    return RefractionLifecyclePhase("reenabled", 0.0f, true);
}

Optional<RefractionTargetFrames> ObserveRefractionTargetFrames(mut GraphicsRuntime graphics, in u64 requiredFrames, mut Optional<u64> targetStart){
    i32 width = 0;
    i32 height = 0;
    graphics.getWindowDimensions(width, height);
    const ProjectFrameClientSize extent = GetProjectFrameClientSize();
    const u64 currentFrame = graphics.getFrameIndex();
    if(width != cast<i32>(extent.width) || height != cast<i32>(extent.height) || (targetStart.has_value() && currentFrame < targetStart.value())){
        targetStart.reset();
        return Optional<RefractionTargetFrames>();
    }
    if(!targetStart.has_value()){
        targetStart = currentFrame;
        return Optional<RefractionTargetFrames>();
    }
    const u64 startFrame = targetStart.value();
    if(currentFrame - startFrame < requiredFrames)
        return Optional<RefractionTargetFrames>();
    return RefractionTargetFrames(extent, currentFrame, startFrame);
}

EntityID CreateRefractionScenePanel(
    in SmokeMaterialRef material,
    in VectorSingle tint,
    in VectorSingle position,
    in VectorSingle scale,
    mut World world
){
    const EntityID entity = CreateTintedStaticMeshEntity(
        s_RefractionScenePlaneMesh,
        material,
        NameTextAscii(s_SmokeSurfaceMaterialInterface),
        tint,
        position,
        scale,
        world
    );
    [essential] assert(entity.valid(), "RefractionSmokeProject: panel creation failed");
    const VectorSingle rotation = QuaternionRotationRollPitchYawFromVector(VectorSingle(-s_RefractionHalfPi, 0.0f, 0.0f, 0.0f));
    const b8 rotated = SetSmokeEntityRotation(entity, rotation, world);
    [essential] assert(rotated, "RefractionSmokeProject: panel rotation failed");
    return entity;
}

Expected<EntityID> CreateRefractionDensityScene(in u32 percent, mut World world, mut ProjectRuntimeContext context){
    const Expected<String> configuredExtent = ReadSmokeEnvironmentString("NWB_REFRACTION_SMOKE_EXTENT");
    if(!configuredExtent.has_value()){
        error("RefractionSmokeProject: density requires explicit extent 960x720, 1600x900, or 1920x1080");
        return MakeUnexpected(Failure());
    }
    const StringView extentText = StringView(configuredExtent.value());
    if(extentText != "960x720" && extentText != "1600x900" && extentText != "1920x1080"){
        error("RefractionSmokeProject: density requires explicit extent 960x720, 1600x900, or 1920x1080");
        return MakeUnexpected(Failure());
    }

    const Expected<Optional<String>, ErrorCode> enabled = ReadEnvironmentVariable("NWB_REFRACTION_SMOKE_ENABLED");
    const Expected<Optional<String>, ErrorCode> hardware = ReadEnvironmentVariable("NWB_REFRACTION_SMOKE_HARDWARE");
    const b8 invalidEnabled = !enabled.has_value()
        || (enabled.value().has_value() && StringView(enabled.value().value()) != "1");
    const b8 invalidHardware = !hardware.has_value()
        || (hardware.value().has_value() && StringView(hardware.value().value()) != "0" && StringView(hardware.value().value()) != "1");
    if(invalidEnabled || invalidHardware){
        error("RefractionSmokeProject: density requires refraction enabled and hardware selection absent, 0, or 1");
        return MakeUnexpected(Failure());
    }
    const b8 hardwareRequested = !hardware.value().has_value() || StringView(hardware.value().value()) == "1";
    const ProjectFrameClientSize extent = GetProjectFrameClientSize();
    const u32 frameWidth = extent.width;
    const u32 frameHeight = extent.height;

    const f32 frameWidthFloat = cast<f32>(frameWidth);
    const f32 frameHeightFloat = cast<f32>(frameHeight);
    const f32 aspect = frameWidthFloat / frameHeightFloat;
    const f32 tangent = Tan(s_RefractionPi / 6.0f);
    const f32 fractionEdge = Sqrt(cast<f32>(percent) * 0.01f);
    const u32 coveredWidth = Min(frameWidth, 2u * cast<u32>(frameWidthFloat * fractionEdge * 0.5f + 0.5f));
    const u32 coveredHeight = Min(frameHeight, 2u * cast<u32>(frameHeightFloat * fractionEdge * 0.5f + 0.5f));
    u32 left = 0u;
    u32 top = 0u;
    if(percent != 0u){
        left = (frameWidth - coveredWidth) / 2u;
        top = (frameHeight - coveredHeight) / 2u;
    }
    const u32 right = left + coveredWidth;
    const u32 bottom = top + coveredHeight;
    const u64 admittedPixels = cast<u64>(coveredWidth) * cast<u64>(coveredHeight);
    const u64 totalPixels = cast<u64>(frameWidth) * cast<u64>(frameHeight);
    const u32 tileEdge = s_RefractionDensityTileEdge;
    u32 activeTiles = 0u;
    if(percent != 0u){
        const u32 tilesRight = (right + tileEdge - 1u) / tileEdge;
        const u32 tilesBottom = (bottom + tileEdge - 1u) / tileEdge;
        activeTiles = (tilesRight - left / tileEdge) * (tilesBottom - top / tileEdge);
    }
    const u32 totalTiles = ((frameWidth + tileEdge - 1u) / tileEdge) * ((frameHeight + tileEdge - 1u) / tileEdge);

    const EntityID camera = CreateSmokeCamera(1.4f, 6.0f, 0.0f, world);
    if(!camera.valid())
        return MakeUnexpected(Failure());
    const f32 verticalFov = s_RefractionPi / 3.0f;
    if(!SetSmokeCameraProjection(camera, verticalFov, aspect, world))
        return MakeUnexpected(Failure());
    const EntityID light = CreateSmokeDirectionalLight(0.0f, 0.0f, 0.0f, VectorSingle(1.0f, 1.0f, 1.0f, 1.0f), 1.0f, false, world);
    if(!light.valid())
        return MakeUnexpected(Failure());

    const f32 backdropDepth = s_RefractionDensityBackdropDepth;
    const f32 backdropHalfHeight = tangent * (6.0f + backdropDepth);
    const f32 backdropHalfWidth = backdropHalfHeight * aspect;
    const f32 backdropPanelHalfWidth = backdropHalfWidth * 1.05f;
    const f32 backdropPanelHalfHeight = backdropHalfHeight * 1.05f;
    CreateRefractionScenePanel(
        s_RefractionSceneOpaqueMaterial,
        VectorSingle(0.04f, 0.04f, 0.04f, 1.0f),
        VectorSingle(0.0f, 1.4f, backdropDepth, 0.0f),
        VectorSingle(backdropPanelHalfWidth, 1.0f, backdropPanelHalfHeight, 0.0f),
        world
    );
    const u32 stripeCount = s_RefractionDensityStripeCount;
    const f32 stripeHalfWidth = backdropHalfWidth / cast<f32>(stripeCount);
    const f32 stripeStart = -backdropHalfWidth;
    for(u32 stripe = 1u; stripe < stripeCount; stripe += 2u){
        const f32 stripeSlot = 2.0f * cast<f32>(stripe) + 1.0f;
        const f32 x = stripeSlot * stripeHalfWidth + stripeStart;
        CreateRefractionScenePanel(
            s_RefractionSceneOpaqueMaterial,
            VectorSingle(0.92f, 0.92f, 0.92f, 1.0f),
            VectorSingle(x, 1.4f, backdropDepth - 0.01f, 0.0f),
            VectorSingle(stripeHalfWidth, 1.0f, backdropPanelHalfHeight, 0.0f),
            world
        );
    }

    f32 frontDepthValue = 0.0f;
    if(percent == 0u)
        frontDepthValue = 4.0f;
    f32 projectedWidth = cast<f32>(coveredWidth);
    f32 projectedHeight = cast<f32>(coveredHeight);
    if(percent == 0u || percent == 100u){
        projectedWidth = frameWidthFloat + 2.0f;
        projectedHeight = frameHeightFloat + 2.0f;
    }
    const f32 halfHeight = (6.0f + frontDepthValue) * tangent;
    const VectorSingle scale = VectorSingle(
        (halfHeight * 2.0f * aspect * projectedWidth) / frameWidthFloat,
        (halfHeight * 2.0f * projectedHeight) / frameHeightFloat,
        0.2f,
        0.0f
    );
    const EntityID glass = CreateTintedStaticMeshEntity(
        s_RefractionSceneCubeMesh,
        s_RefractionSceneClearMaterial,
        NameTextAscii(s_SmokeSurfaceMaterialInterface),
        VectorSingle(1.0f, 1.0f, 1.0f, 0.0f),
        VectorSingle(0.0f, 1.4f, frontDepthValue + 0.1f, 0.0f),
        scale,
        world
    );
    if(!glass.valid())
        return MakeUnexpected(Failure());

    StringView captureMode = "visible";
    if(percent == 0u)
        captureMode = "occluded";
    StringView tracingMode = "screen-space";
    if(hardwareRequested)
        tracingMode = "hardware";
    u32 rayQuerySupported = 0u;
    if(context.graphics.queryFeatureSupport(Feature::RayQuery))
        rayQuerySupported = 1u;
    [essential] info(
        "RefractionDensity: extent {}x{} requested_percent {} admitted_pixels {} total_pixels {} active_tiles {} total_tiles {} glass_instances 1 capture_mode {}"
        , frameWidth
        , frameHeight
        , percent
        , admittedPixels
        , totalPixels
        , activeTiles
        , totalTiles
        , captureMode
    );
    [essential] info("RefractionDensity: pixel_bounds {} {} {} {}", left, top, right, bottom);
    [essential] info(
        "RefractionDensity: tracing requested {} ray_query_supported {} refraction_enabled 1"
        , tracingMode
        , rayQuerySupported
    );
    return glass;
}

Expected<Optional<u32>> ReadRefractionDensityPercent(){
    const Expected<Optional<String>, ErrorCode> configured = ReadEnvironmentVariable("NWB_REFRACTION_SMOKE_DENSITY");
    if(!configured.has_value()){
        error("RefractionSmokeProject: failed to read density fixture selection");
        return MakeUnexpected(Failure());
    }
    if(!configured.value().has_value())
        return Optional<u32>();
    const StringView view = StringView(configured.value().value());
    if(view == "0")
        return Optional<u32>(0u);
    if(view == "1")
        return Optional<u32>(1u);
    if(view == "10")
        return Optional<u32>(10u);
    if(view == "50")
        return Optional<u32>(50u);
    if(view == "100")
        return Optional<u32>(100u);
    error("RefractionSmokeProject: density must be exactly 0, 1, 10, 50, or 100");
    return MakeUnexpected(Failure());
}

ProjectFrameClientSize GetProjectFrameClientSize(){
    return QueryRefractionSmokeFrameClientSize();
}

PlatformStringView GetProjectWindowTitle(){
    return PlatformTextLiteral("NWB Refraction Smoke");
}

[cpp_unwind]
UniquePtr<IProjectEntryCallbacks> CreateProjectCallbacks(mut ProjectRuntimeContext context){
    auto world = CreateRefractionSmokeWorld(context);
    if(!world.has_value())
        return UniquePtr<IProjectEntryCallbacks>();
    mut NotNullUniquePtr<World> owner = world.value();
    return MakeUnique<RefractionSmokeProjectImpl>(owner, context);
}


