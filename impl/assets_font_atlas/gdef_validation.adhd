////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_font_atlas/ot_table_reader.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateFontAtlasGdefTableBytes(in Span<u8> bytes, in u32 glyphCount){
    FontAtlasOtTableReader reader(bytes, glyphCount);
    if(!reader.range(0u, s_FontAtlasGdefHeaderBytes) || reader.u16At(0u) != 1u || cast<u32>(reader.u16At(s_FontAtlasOtMinorVersionOffset)) > s_FontAtlasGdefItemVarStoreMinorVersion || reader.u16At(s_FontAtlasOtMinorVersionOffset) == 1u)
        return false;
    const u32 minor = cast<u32>(reader.u16At(s_FontAtlasOtMinorVersionOffset));
    u32 headerSize = s_FontAtlasGdefHeaderBytes;
    if(minor == s_FontAtlasGdefItemVarStoreMinorVersion)
        headerSize = s_FontAtlasGdefHeaderV13Bytes;
    else if(minor == s_FontAtlasGdefMarkGlyphSetsMinorVersion)
        headerSize = s_FontAtlasGdefHeaderV12Bytes;
    if(!reader.range(0u, headerSize))
        return false;
    if(!reader.classDef(cast<u64>(reader.u16At(s_FontAtlasGdefGlyphClassDefOffset)), s_FontAtlasGdefGlyphClassCount) || !reader.classDef(cast<u64>(reader.u16At(s_FontAtlasGdefMarkAttachClassDefOffset)), s_FontAtlasOtAnyClassCount))
        return false;
    for(u32 field = s_FontAtlasGdefAttachListOffset; field <= s_FontAtlasGdefLigCaretListOffset; field += s_FontAtlasOtU16Bytes){
        const u64 list = cast<u64>(reader.u16At(field));
        if(list == 0u)
            continue;
        if(!reader.range(list, s_FontAtlasGdefGlyphListHeaderBytes))
            return false;
        const u32 count = cast<u32>(reader.u16At(list + s_FontAtlasGdefGlyphListCountOffset));
        const Expected<u32> coverageCount = reader.coverage(list + reader.u16At(list));
        if(!coverageCount.has_value() || count != coverageCount.value() || !reader.range(list + s_FontAtlasGdefGlyphListHeaderBytes, cast<u64>(count) * s_FontAtlasOtU16Bytes))
            return false;
        for(u32 index = 0u; index < count; ++index){
            const u64 item = list + reader.u16At(list + s_FontAtlasGdefGlyphListHeaderBytes + cast<u64>(index) * s_FontAtlasOtU16Bytes);
            if(item == list || !reader.range(item, s_FontAtlasOtU16Bytes) || !reader.range(item + s_FontAtlasOtU16Bytes, cast<u64>(reader.u16At(item)) * s_FontAtlasOtU16Bytes))
                return false;
            if(s_FontAtlasGdefLigCaretListOffset == field){
                const u32 caretCount = cast<u32>(reader.u16At(item));
                for(u32 caret = 0u; caret < caretCount; ++caret){
                    const u64 target = item + reader.u16At(item + s_FontAtlasOtU16Bytes + cast<u64>(caret) * s_FontAtlasOtU16Bytes);
                    if(target == item || !reader.range(target, s_FontAtlasCaretValueBytes))
                        return false;
                    const u16 format = reader.u16At(target);
                    if(
                        format < 1u
                        || cast<u32>(format) > s_FontAtlasCaretValueDeviceFormat
                        || (
                            cast<u32>(format) == s_FontAtlasCaretValueDeviceFormat
                            && (!reader.range(target, s_FontAtlasCaretValueDeviceBytes) || !reader.device(target, cast<u32>(reader.u16At(target + s_FontAtlasCaretValueDeviceOffset))))
                        )
                    )
                        return false;
                }
            }
        }
    }
    if(minor >= s_FontAtlasGdefMarkGlyphSetsMinorVersion && reader.u16At(s_FontAtlasGdefMarkGlyphSetsOffset) != 0u){
        const u64 sets = cast<u64>(reader.u16At(s_FontAtlasGdefMarkGlyphSetsOffset));
        if(!reader.range(sets, s_FontAtlasMarkGlyphSetsHeaderBytes))
            return false;
        const u32 setCount = cast<u32>(reader.u16At(sets + s_FontAtlasMarkGlyphSetsCountOffset));
        if(reader.u16At(sets) != 1u || !reader.range(sets + s_FontAtlasMarkGlyphSetsHeaderBytes, cast<u64>(setCount) * s_FontAtlasOtU32Bytes))
            return false;
        for(u32 index = 0u; index < setCount; ++index){
            const u32 offset = reader.u32At(sets + s_FontAtlasMarkGlyphSetsHeaderBytes + cast<u64>(index) * s_FontAtlasOtU32Bytes);
            if(offset == 0u || !reader.coverage(sets + offset).has_value())
                return false;
        }
    }
    if(minor == s_FontAtlasGdefItemVarStoreMinorVersion && reader.u32At(s_FontAtlasGdefItemVarStoreOffset) != 0u){
        const u64 store = cast<u64>(reader.u32At(s_FontAtlasGdefItemVarStoreOffset));
        if(!reader.range(store, s_FontAtlasItemVarStoreHeaderBytes) || reader.u16At(store) != 1u || !reader.range(store + s_FontAtlasItemVarStoreHeaderBytes, cast<u64>(reader.u16At(store + s_FontAtlasItemVarStoreDataCountOffset)) * s_FontAtlasOtU32Bytes))
            return false;
    }
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

