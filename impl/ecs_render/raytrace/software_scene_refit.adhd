[cpp_header("<impl/assets/graphics/bvh/scene_refit_constants.h>"), cpp_name("NWB_SCENE_BVH_REFIT_PUSH_BYTES")]
extern const u32 s_ShaderSceneBvhRefitPushBytes;
[cpp_header("<impl/assets/graphics/bvh/scene_refit_constants.h>"), cpp_name("NWB_SCENE_BVH_REFIT_INSTANCE_BYTES")]
extern const u32 s_ShaderSceneBvhRefitInstanceBytes;
[cpp_header("<impl/assets/graphics/bvh/scene_refit_constants.h>"), cpp_name("NWB_SCENE_BVH_REFIT_MESH_SLOT_OFFSET")]
extern const u32 s_ShaderSceneBvhRefitMeshSlotOffset;
[cpp_header("<impl/assets/graphics/bvh/scene_refit_constants.h>"), cpp_name("NWB_SCENE_BVH_REFIT_GROUP_SIZE")]
extern const u32 s_ShaderSceneBvhRefitGroupSize;
[cpp_header("<impl/assets/graphics/bvh/scene_refit_constants.h>"), cpp_name("NWB_SCENE_BVH_REFIT_MODE_INIT_PARENTS")]
extern const u32 s_ShaderSceneBvhRefitModeInitParents;
[cpp_header("<impl/assets/graphics/bvh/scene_refit_constants.h>"), cpp_name("NWB_SCENE_BVH_REFIT_MODE_REFIT")]
extern const u32 s_ShaderSceneBvhRefitModeRefit;

type SoftwareSceneRefitHandle = Shared<SoftwareSceneRefitSnapshot>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SoftwareSceneBvhValidationPolicy{
    public b8 validateSceneRefitCounts(in usize instanceCount, in usize meshNodeCount, in u32 nodeCount)const{
        return instanceCount != 0u
            && meshNodeCount != 0u
            && meshNodeCount <= instanceCount
            && instanceCount <= cast<usize>(u32.max) / cast<usize>(s_ShaderSceneBvhRefitInstanceBytes)
            && ComputeBinaryBvhNodeCount(instanceCount) == cast<usize>(nodeCount);
    }

    public b8 validateSceneNodeBufferBytes(in u32 nodeCount, in u64 sceneByteSize)const{
        return sceneByteSize >= cast<u64>(nodeCount) * cast<u64>(s_NwbBvhNodeGpuByteSize);
    }

    public b8 validateTraversalCaptureCounts(in usize meshCount, in u32 instanceCount)const{
        return meshCount != 0u && meshCount <= cast<usize>(u32.max) && instanceCount != 0u;
    }

    public b8 validateTraversalMeshMetadata(in Name meshName, in u32 primitiveCount, in usize nodeByteSize, in usize positionByteSize, in usize triangleIndexByteSize, in usize attributeByteSize)const{
        return meshName != Name() && primitiveCount != 0u && nodeByteSize != 0u && positionByteSize != 0u && triangleIndexByteSize != 0u && attributeByteSize != 0u;
    }

    public b8 matchesTraversalTableSizes(
        in u32 swShadowMeshCount,
        in usize preparedMeshCount,
        in u32 sceneBvhInstanceCount,
        in u32 preparedInstanceCount,
        in usize nodeBufferCount,
        in usize positionBufferCount,
        in usize indexBufferCount,
        in usize attributeBufferCount,
        in usize nodeHandleCount,
        in usize positionHandleCount,
        in usize indexHandleCount,
        in usize attributeHandleCount
    )const{
        return swShadowMeshCount == cast<u32>(preparedMeshCount) && sceneBvhInstanceCount == preparedInstanceCount
            && nodeBufferCount == preparedMeshCount && positionBufferCount == preparedMeshCount && indexBufferCount == preparedMeshCount && attributeBufferCount == preparedMeshCount
            && nodeHandleCount == preparedMeshCount && positionHandleCount == preparedMeshCount && indexHandleCount == preparedMeshCount && attributeHandleCount == preparedMeshCount;
    }
}

class SoftwareSceneRefitSnapshot{
    public BufferHandle inputBuffer;
    public BufferHandle sceneNodes;
    public BufferHandle parentBuffer;
    public BufferHandle visitCounterBuffer;
    public ComputePipelineHandle pipeline;
    public Vector<SoftwareSceneRefitInstanceGpu> inputs;
    public Vector<u32> instanceEntityIds;
    public Vector<BufferHandle> meshNodes;
    public mut GraphicsRuntime graphics;
    public GpuDescriptorHandle inputDescriptor = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle inputUavDescriptor = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle sceneDescriptor = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle parentDescriptor = GpuDescriptorHandleInvalid();
    public GpuDescriptorHandle visitCounterDescriptor = GpuDescriptorHandleInvalid();
    public GpuPhysicalQueueId queue;
    public u32 nodeCount = 0u;
    public u64 inputHash = 0u;
    public u64 patchMembershipSig = 0u;
    public b8 needsInitParents = true;
    public b8 needsInputUpload = true;
    public b8 staticScene = false;
    public b8 gpuPatched = false;

    public SoftwareSceneRefitSnapshot(mut GraphicsRuntime graphics){ this.graphics = graphics; }
}

class SoftwareSceneRefitResources : NoCopy{
    private SharedPool m_versions = SharedPool();
    private mut GraphicsRuntime m_graphics;
    private Vector<SoftwareSceneRefitHandle> m_snapshots;
    private BufferHandle m_inputBuffer;
    private BufferHandle m_parentBuffer;
    private BufferHandle m_visitCounterBuffer;
    private GpuDescriptorHandle m_inputDescriptor = GpuDescriptorHandleInvalid();
    private GpuDescriptorHandle m_inputUavDescriptor = GpuDescriptorHandleInvalid();
    private GpuDescriptorHandle m_parentDescriptor = GpuDescriptorHandleInvalid();
    private GpuDescriptorHandle m_visitCounterDescriptor = GpuDescriptorHandleInvalid();
    private BindingLayoutHandle m_bindingLayout;
    private ShaderHandle m_shader;
    private ComputePipelineHandle m_pipeline;
    private usize m_parentsSceneNodesIdentity = 0u;
    private usize m_parentsBufferIdentity = 0u;
    private usize m_visitsBufferIdentity = 0u;
    private u32 m_parentsNodeCount = 0u;
    private b8 m_parentsInitialized = false;
    private usize m_inputUploadBufferIdentity = 0u;
    private u64 m_inputUploadHash = 0u;
    private u64 m_inputUploadPatchMembershipSig = 0u;
    private b8 m_inputUploadValid = false;

    public SoftwareSceneRefitResources(mut GraphicsRuntime graphics){
        this.m_graphics = graphics;
    }

    private void releaseOwnedBufferDescriptor(mut Device device, mut GpuDescriptorHeap heap, mut BufferHandle buffer, mut GpuDescriptorHandle descriptor){
        if(heap.isInitialized() && buffer.valid() && descriptor.valid() && buffer.deref().getDeviceGeneration() == device.getDeviceGeneration())
            heap.free(descriptor);
        buffer.reset();
        descriptor = GpuDescriptorHandleInvalid();
    }

    private b8 ensureU32StorageBuffer(in u32 requiredCount, in Name debugName, mut BufferHandle inOutBuffer, mut GpuDescriptorHandle inOutDescriptor){
        mut Device device = this.m_graphics.getDevice();
        mut GpuDescriptorHeap heap = device.getDescriptorHeap();
        if(inOutBuffer.valid() && inOutBuffer.deref().getDeviceGeneration() != device.getDeviceGeneration())
            return false;
        const usize requiredByteSize = cast<usize>(requiredCount) * size_of<u32>();
        if(inOutBuffer.valid() && inOutBuffer.deref().getCreationDescription().byteSize >= requiredByteSize && inOutDescriptor.valid())
            return true;

        usize currentCapacity = 0u;
        if(inOutBuffer.valid())
            currentCapacity = cast<usize>(inOutBuffer.deref().getCreationDescription().byteSize / size_of<u32>());
        const usize allocByteSize = NextGrowingCapacity(currentCapacity, cast<usize>(requiredCount), 64u) * size_of<u32>();

        BufferDesc desc;
        desc.setByteSize(allocByteSize).setStructStride(size_of<u32>()).setCanHaveUAVs(true).setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
            .setDebugName(debugName).enableAutomaticStateTracking(ResourceStates::Common);
        auto replacementResult = this.m_graphics.createBuffer(desc);
        if(!replacementResult.has_value())
            return false;
        BufferHandle replacement = replacementResult.value();
        const Expected<GpuDescriptorHandle> descriptorResult = RegisterHeapBuffer(heap, replacement.deref(), GpuDescriptorClass::StorageBuffer, true);
        if(!descriptorResult.has_value())
            return false;
        const GpuDescriptorHandle descriptor = descriptorResult.value();
        if(inOutDescriptor.valid())
            heap.free(inOutDescriptor);
        inOutBuffer = replacement;
        inOutDescriptor = descriptor;
        return true;
    }

    public void invalidateInputUpload(){
        this.m_inputUploadValid = false;
    }

    public void invalidate(){
        this.m_snapshots.clear();
        mut Device device = this.m_graphics.getDevice();
        mut GpuDescriptorHeap heap = device.getDescriptorHeap();
        if(heap.isInitialized() && this.m_inputBuffer.valid() && this.m_inputUavDescriptor.valid() && this.m_inputBuffer.deref().getDeviceGeneration() == device.getDeviceGeneration())
            heap.free(this.m_inputUavDescriptor);
        this.m_inputUavDescriptor = GpuDescriptorHandleInvalid();
        this.releaseOwnedBufferDescriptor(device, heap, this.m_inputBuffer, this.m_inputDescriptor);
        this.releaseOwnedBufferDescriptor(device, heap, this.m_parentBuffer, this.m_parentDescriptor);
        this.releaseOwnedBufferDescriptor(device, heap, this.m_visitCounterBuffer, this.m_visitCounterDescriptor);
        this.m_pipeline.reset();
        this.m_shader.reset();
        this.m_bindingLayout.reset();
        this.m_parentsInitialized = false;
        this.m_parentsSceneNodesIdentity = 0u;
        this.m_parentsBufferIdentity = 0u;
        this.m_visitsBufferIdentity = 0u;
        this.m_parentsNodeCount = 0u;
        this.m_inputUploadValid = false;
        this.m_inputUploadBufferIdentity = 0u;
        this.m_inputUploadHash = 0u;
        this.m_inputUploadPatchMembershipSig = 0u;
    }

    public void confirmAccepted(in SoftwareSceneRefitHandle snapshotHandle){
        if(!snapshotHandle.valid())
            return;
        in SoftwareSceneRefitSnapshot snapshot = snapshotHandle.deref();
        this.m_parentsInitialized = true;
        this.m_parentsSceneNodesIdentity = snapshot.sceneNodes.identity();
        this.m_parentsBufferIdentity = snapshot.parentBuffer.identity();
        this.m_visitsBufferIdentity = snapshot.visitCounterBuffer.identity();
        this.m_parentsNodeCount = snapshot.nodeCount;
        if(snapshot.staticScene){
            this.m_inputUploadBufferIdentity = snapshot.inputBuffer.identity();
            this.m_inputUploadHash = snapshot.inputHash;
            this.m_inputUploadPatchMembershipSig = snapshot.patchMembershipSig;
            this.m_inputUploadValid = true;
        }
        else{
            this.m_inputUploadValid = false;
        }
    }

    public Expected<SoftwareSceneRefitHandle> prepare(
        in Span<SoftwareSceneRefitInstanceGpu> inputs,
        in Span<BufferHandle> meshNodes,
        in Span<u32> instanceEntityIds,
        in BufferHandle sceneNodes,
        in GpuDescriptorHandle sceneDescriptor,
        in u32 nodeCount,
        in b8 staticScene,
        in b8 sceneBvhRebuilt,
        in b8 gpuPatched,
        in u64 patchMembershipSig,
        mut RendererShaderSystem shaderSystem
    ){
        const SoftwareSceneBvhValidationPolicy validationPolicy = SoftwareSceneBvhValidationPolicy();
        const usize instanceCount = inputs.size();
        if(
            !validationPolicy.validateSceneRefitCounts(instanceCount, meshNodes.size(), nodeCount)
            || instanceEntityIds.size() != instanceCount
            || !sceneNodes.valid() || !sceneDescriptor.valid() || sceneDescriptor.descriptorClass() != GpuDescriptorClass::StorageBuffer
            || !this.ensurePipeline(shaderSystem)
        )
            return MakeUnexpected(Failure());
        mut Device device = this.m_graphics.getDevice();
        mut GpuDescriptorHeap heap = device.getDescriptorHeap();
        in BufferDesc sceneDesc = sceneNodes.deref().getCreationDescription();
        if(sceneNodes.deref().getDeviceGeneration() != device.getDeviceGeneration() || !sceneDesc.canHaveUAVs || !validationPolicy.validateSceneNodeBufferBytes(nodeCount, sceneDesc.byteSize))
            return MakeUnexpected(Failure());
        const usize byteSize = instanceCount * size_of<SoftwareSceneRefitInstanceGpu>();
        if(this.m_inputBuffer.valid() && this.m_inputBuffer.deref().getDeviceGeneration() != device.getDeviceGeneration())
            return MakeUnexpected(Failure());
        if(!this.m_inputBuffer.valid() || this.m_inputBuffer.deref().getCreationDescription().byteSize < byteSize){
            usize currentInputCapacity = 0u;
            if(this.m_inputBuffer.valid())
                currentInputCapacity = cast<usize>(this.m_inputBuffer.deref().getCreationDescription().byteSize / size_of<SoftwareSceneRefitInstanceGpu>());
            const usize allocInputBytes = NextGrowingCapacity(currentInputCapacity, instanceCount, 64u) * size_of<SoftwareSceneRefitInstanceGpu>();
            BufferDesc desc;
            desc.setByteSize(allocInputBytes).setStructStride(size_of<SoftwareSceneRefitInstanceGpu>()).setCanHaveRawViews(true).setCanHaveUAVs(true).setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
                .setDebugName(Name(s_SoftwareSceneRefitInputsName)).enableAutomaticStateTracking(ResourceStates::Common);
            auto replacementResult = this.m_graphics.createBuffer(desc);
            if(!replacementResult.has_value())
                return MakeUnexpected(Failure());
            BufferHandle replacement = replacementResult.value();
            const Expected<GpuDescriptorHandle> descriptorResult = RegisterDescriptor(heap, GpuDescriptorClass::StorageBuffer, DescriptorWriteItemRawBufferSrv(0u, replacement.deref()));
            if(!descriptorResult.has_value())
                return MakeUnexpected(descriptorResult.error());
            GpuDescriptorRetirementGuard retireSrv(heap, descriptorResult.value());
            const Expected<GpuDescriptorHandle> uavDescriptorResult = RegisterHeapBuffer(heap, replacement.deref(), GpuDescriptorClass::StorageBuffer, true);
            if(!uavDescriptorResult.has_value())
                return MakeUnexpected(uavDescriptorResult.error());
            retireSrv.release();
            if(this.m_inputDescriptor.valid())
                heap.free(this.m_inputDescriptor);
            if(this.m_inputUavDescriptor.valid())
                heap.free(this.m_inputUavDescriptor);
            this.m_inputBuffer = replacement;
            this.m_inputDescriptor = descriptorResult.value();
            this.m_inputUavDescriptor = uavDescriptorResult.value();
            this.m_inputUploadValid = false;
        }
        if(!this.ensureU32StorageBuffer(nodeCount, Name(s_SoftwareSceneRefitParentsName), this.m_parentBuffer, this.m_parentDescriptor)
            || !this.ensureU32StorageBuffer(nodeCount, Name(s_SoftwareSceneRefitVisitsName), this.m_visitCounterBuffer, this.m_visitCounterDescriptor)
        )
            return MakeUnexpected(Failure());
        SoftwareSceneRefitHandle snapshot;
        for(in SoftwareSceneRefitHandle cached : this.m_snapshots){
            if(cached.referenceCount() == 1u){
                AtomicThreadFence(MemoryOrder::acquire);
                snapshot = cached;
                break;
            }
        }
        if(!snapshot.valid()){
            const auto created = this.m_versions.make<SoftwareSceneRefitSnapshot>(this.m_graphics);
            if(!created.has_value())
                return MakeUnexpected(Failure());
            snapshot = created.value();
            this.m_snapshots.push_back(snapshot);
        }
        const u64 inputHash = UpdateFnv64(s_Fnv64OffsetBasis, PodArrayBytes<SoftwareSceneRefitInstanceGpu>(inputs));
        const b8 needsInitParents = !(
            this.m_parentsInitialized
            && !sceneBvhRebuilt
            && this.m_parentsSceneNodesIdentity == sceneNodes.identity()
            && this.m_parentsBufferIdentity == this.m_parentBuffer.identity()
            && this.m_visitsBufferIdentity == this.m_visitCounterBuffer.identity()
            && this.m_parentsNodeCount == nodeCount
        );
        const b8 needsInputUpload = !(
            staticScene
            && this.m_inputUploadValid
            && this.m_inputUploadBufferIdentity == this.m_inputBuffer.identity()
            && this.m_inputUploadHash == inputHash
            && this.m_inputUploadPatchMembershipSig == patchMembershipSig
        );
        snapshot.deref().inputs.clear();
        snapshot.deref().instanceEntityIds.clear();
        snapshot.deref().meshNodes.clear();
        snapshot.deref().inputBuffer = this.m_inputBuffer;
        snapshot.deref().sceneNodes = sceneNodes;
        snapshot.deref().parentBuffer = this.m_parentBuffer;
        snapshot.deref().visitCounterBuffer = this.m_visitCounterBuffer;
        snapshot.deref().pipeline = this.m_pipeline;
        snapshot.deref().inputDescriptor = this.m_inputDescriptor;
        snapshot.deref().inputUavDescriptor = this.m_inputUavDescriptor;
        snapshot.deref().sceneDescriptor = sceneDescriptor;
        snapshot.deref().parentDescriptor = this.m_parentDescriptor;
        snapshot.deref().visitCounterDescriptor = this.m_visitCounterDescriptor;
        snapshot.deref().queue = device.getPrimaryPhysicalQueue(CommandQueue::Graphics);
        snapshot.deref().nodeCount = nodeCount;
        snapshot.deref().inputHash = inputHash;
        snapshot.deref().patchMembershipSig = patchMembershipSig;
        snapshot.deref().needsInitParents = needsInitParents;
        snapshot.deref().needsInputUpload = needsInputUpload;
        snapshot.deref().staticScene = staticScene;
        snapshot.deref().gpuPatched = gpuPatched;
        snapshot.deref().inputs.reserve(instanceCount);
        snapshot.deref().instanceEntityIds.reserve(instanceCount);
        snapshot.deref().meshNodes.reserve(meshNodes.size());
        for(usize index = 0u; index < instanceCount; ++index){
            if(inputs[index].meshNodeSlot == u32.max)
                return MakeUnexpected(Failure());
            snapshot.deref().inputs.push_back(inputs[index]);
            snapshot.deref().instanceEntityIds.push_back(instanceEntityIds[index]);
        }
        for(in BufferHandle root : meshNodes){
            if(!root.valid() || root.deref().getDeviceGeneration() != device.getDeviceGeneration() || root.deref().getCreationDescription().byteSize < s_NwbBvhNodeGpuByteSize)
                return MakeUnexpected(Failure());
            snapshot.deref().meshNodes.push_back(root);
        }
        return snapshot;
    }

    private b8 ensurePipeline(mut RendererShaderSystem shaderSystem){
        return EnsurePushConstantComputePipeline<BvhSubsystem>(
            this.m_graphics.getDevice(), shaderSystem, lambda[](in BvhSubsystem subsystem) -> AssetRef<ComputeShader>{ return subsystem.sceneRefitCs; }, s_DefaultVariant, Name(s_RenderNameSoftwareSceneRefit),
                size_of<SoftwareSceneRefitPushConstants>(), false, this.m_bindingLayout, this.m_shader, this.m_pipeline
        );
    }
}

class SoftwareSceneRefitTask{
    private SoftwareSceneRefitHandle m_snapshot;

    public SoftwareSceneRefitTask(in SoftwareSceneRefitHandle snapshot){ this.m_snapshot = snapshot; }

    public GpuTaskCommandRequirements commandRequirements()const{
        GpuTaskCommandRequirements commands;
        commands.requiredCapabilities = GpuQueueCapability::Compute;
        commands.requiresPrimaryGraphicsQueue = true;
        return commands;
    }

    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.m_snapshot.valid() || context.commandIrCapture)
            return false;
        in SoftwareSceneRefitSnapshot snapshot = this.m_snapshot.deref();
        if(context.queue != snapshot.queue || !snapshot.pipeline.valid())
            return false;
        commandList.endRenderPass();
        ComputeState state;
        state.setPipeline(snapshot.pipeline.deref());
        commandList.setComputeState(state);
        snapshot.graphics.getDevice().getDescriptorHeap().bindCompute(commandList, snapshot.pipeline.deref());

        const u32 groupCount = DivideUp(snapshot.nodeCount, s_ShaderSceneBvhRefitGroupSize);

        if(snapshot.needsInitParents){
            const BufferRange refitRange(0u, cast<u64>(snapshot.nodeCount) * size_of<u32>());
            mut Buffer parentBuffer = snapshot.parentBuffer.deref();
            mut Buffer visitCounterBuffer = snapshot.visitCounterBuffer.deref();
            const SoftwareSceneRefitPushConstants initPush = MakeSoftwareSceneRefitPushConstants(snapshot, s_ShaderSceneBvhRefitModeInitParents);
            commandList.setPushConstants(initPush);
            commandList.dispatch(groupCount, 1u, 1u);

            commandList.setEnableUavBarriersForBuffer(parentBuffer, true);
            commandList.setEnableUavBarriersForBuffer(visitCounterBuffer, true);
            commandList.setBufferState(parentBuffer, ResourceStates::UnorderedAccess, false, refitRange);
            commandList.setBufferState(visitCounterBuffer, ResourceStates::UnorderedAccess, false, refitRange);
            commandList.commitBarriers();
        }

        const SoftwareSceneRefitPushConstants refitPush = MakeSoftwareSceneRefitPushConstants(snapshot, s_ShaderSceneBvhRefitModeRefit);
        commandList.setPushConstants(refitPush);
        commandList.dispatch(groupCount, 1u, 1u);
        return true;
    }
}

static_assert(align_of<SoftwareSceneRefitInstanceGpu>() >= 16u);
static_assert(size_of<SoftwareSceneRefitInstanceGpu>() == s_ShaderSceneBvhRefitInstanceBytes);
static_assert(offset_of<SoftwareSceneRefitInstanceGpu>(meshNodeSlot) == s_ShaderSceneBvhRefitMeshSlotOffset);
static_assert(size_of<SoftwareSceneRefitPushConstants>() == s_ShaderSceneBvhRefitPushBytes);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


SoftwareSceneRefitPushConstants MakeSoftwareSceneRefitPushConstants(in SoftwareSceneRefitSnapshot snapshot, in u32 passMode){
    SoftwareSceneRefitPushConstants push;
    push.nodeCount = snapshot.nodeCount;
    push.sceneNodeSlot = snapshot.sceneDescriptor.slot();
    push.instanceInputSlot = snapshot.inputDescriptor.slot();
    push.instanceCount = cast<u32>(snapshot.inputs.size());
    push.parentSlot = snapshot.parentDescriptor.slot();
    push.visitCounterSlot = snapshot.visitCounterDescriptor.slot();
    push.passMode = passMode;
    return push;
}

Expected<SoftwareSceneRefitGraphTasks> DeclareSoftwareSceneRefit(
    in SoftwareSceneRefitHandle snapshot,
    in GpuGraphResourceId sceneNodes,
    in Optional<mut IGpuTaskGraphInstanceTransformPatchContributor> instanceTransformPatchContributor,
    in borrow GpuTaskId dependency,
    mut GpuTaskGraph graph
){
    if(!snapshot.valid() || !sceneNodes.valid() || snapshot.deref().inputs.empty())
        return MakeUnexpected(Failure());
    {
        const GpuTaskGraphDeclarationReadView declarations(graph);
        if(!declarations.valid() || declarations.findImportedBuffer(snapshot.deref().sceneNodes) != sceneNodes)
            return MakeUnexpected(Failure());
    }
    GpuGraphResourceDesc inputDesc = BufferResourceDesc(Name(s_SoftwareSceneRefitInputsName), "Software Scene Refit Inputs");
    inputDesc.setInitialState(ResourceStates::Common).setExternalFinalState(ResourceStates::Common);
    const auto inputResult = graph.importBuffer(snapshot.deref().inputBuffer, inputDesc);
    if(!inputResult.has_value())
        return MakeUnexpected(Failure());
    const GpuGraphResourceId input = inputResult.value();

    GpuGraphResourceDesc parentDesc = BufferResourceDesc(Name(s_SoftwareSceneRefitParentsName), "Software Scene Refit Parents");
    parentDesc.setInitialState(ResourceStates::Common).setExternalFinalState(ResourceStates::Common);
    const auto parentResult = graph.importBuffer(snapshot.deref().parentBuffer, parentDesc);
    if(!parentResult.has_value())
        return MakeUnexpected(Failure());
    const GpuGraphResourceId parents = parentResult.value();

    GpuGraphResourceDesc visitsDesc = BufferResourceDesc(Name(s_SoftwareSceneRefitVisitsName), "Software Scene Refit Visits");
    visitsDesc.setInitialState(ResourceStates::Common).setExternalFinalState(ResourceStates::Common);
    const auto visitsResult = graph.importBuffer(snapshot.deref().visitCounterBuffer, visitsDesc);
    if(!visitsResult.has_value())
        return MakeUnexpected(Failure());
    const GpuGraphResourceId visits = visitsResult.value();

    Vector<GpuTaskResourceUse> uses;
    uses.reserve(snapshot.deref().meshNodes.size() + s_SoftwareSceneRefitFixedUseCapacity);
    uses.push_back(ReadUse(input, ResourceStates::ShaderResource));
    uses.push_back(ReadWriteUse(sceneNodes, ResourceStates::UnorderedAccess));
    uses.push_back(ReadWriteUse(parents, ResourceStates::UnorderedAccess));
    uses.push_back(ReadWriteUse(visits, ResourceStates::UnorderedAccess));
    HashSet<u32> seenResources;
    seenResources.reserve(snapshot.deref().meshNodes.size() + s_SoftwareSceneRefitFixedUseCapacity);
    seenResources.insert(input.index);
    seenResources.insert(sceneNodes.index);
    seenResources.insert(parents.index);
    seenResources.insert(visits.index);
    {
        const GpuTaskGraphDeclarationReadView declarations(graph);
        if(!declarations.valid())
            return MakeUnexpected(Failure());
        for(in BufferHandle root : snapshot.deref().meshNodes){
            const GpuGraphResourceId resource = declarations.findImportedBuffer(root);
            if(!resource.valid())
                return MakeUnexpected(Failure());
            if(seenResources.insert(resource.index).second)
                uses.push_back(ReadUse(resource, ResourceStates::ShaderResource));
        }
    }
    GpuTaskSchedulingHint scheduling;
    scheduling.cost = GpuTaskCostHint::Tiny;
    scheduling.allowPacketMerge = true;
    scheduling.mergeWithPrevious = true;
    scheduling.allowMergeAcrossConsumerFrontier = true;
    SoftwareSceneRefitGraphTasks result;
    GpuTaskId refitDependency = dependency;
    if(snapshot.deref().needsInputUpload){
        const auto uploadResult = graph.copyUploadBytes<u32>(PodArrayBytes<SoftwareSceneRefitInstanceGpu>(Span<SoftwareSceneRefitInstanceGpu>(snapshot.deref().inputs)));
        if(!uploadResult.has_value())
            return MakeUnexpected(Failure());
        const GpuUploadBlobId upload = uploadResult.value();
        GpuTaskSchedulingHint uploadScheduling = scheduling;
        uploadScheduling.mergeWithPrevious = dependency.valid();
        GpuTaskDesc uploadDesc;
        uploadDesc.setIdentity(Name(s_RenderNameRenderShadowPrepareSceneRefitInputsUpload)).setMarkerLabel("Software Scene Refit Inputs Upload").setScheduling(uploadScheduling);
        if(dependency.valid())
            uploadDesc.setDependency(dependency);
        GpuUploadBufferTaskDesc uploadTask;
        uploadTask.source = upload;
        uploadTask.destination = input;
        uploadTask.finalState = ResourceStates::Common;
        const auto inputUploadResult = graph.addUploadBufferTask(uploadDesc, uploadTask);
        if(!inputUploadResult.has_value())
            return MakeUnexpected(Failure());
        result.inputUpload = inputUploadResult.value();
        refitDependency = result.inputUpload;
    }
    if(!AppendTypedInstanceTransformPatch(
        instanceTransformPatchContributor,
        Span<u32>(snapshot.deref().instanceEntityIds),
        input,
        snapshot.deref().inputUavDescriptor,
        cast<u32>(size_of<SoftwareSceneRefitInstanceGpu>() / size_of<f32x4>()),
        GpuTaskGraphInstanceTransformPatchLayout::Affine3x4ObjectToWorld,
        0u,
        Name("shadow.prepare.sw_bvh_refit.physics_patch"),
        true,
        true,
        graph,
        refitDependency
    ))
        return MakeUnexpected(Failure());
    GpuTaskDesc desc;
    desc.setIdentity(Name(s_RenderNameRenderShadowPrepareSceneRefit)).setMarkerLabel("Software Scene BVH Refit").setScheduling(scheduling).setDependency(refitDependency).setResourceUses(Span<GpuTaskResourceUse>(uses));
    const auto refitResult = graph.addPayloadTask(desc, SoftwareSceneRefitTask(snapshot));
    if(!refitResult.has_value())
        return MakeUnexpected(refitResult.error());
    result.refit = refitResult.value();
    return result;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

