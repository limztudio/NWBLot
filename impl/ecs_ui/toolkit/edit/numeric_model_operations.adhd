////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "model.adhd"
#include "numeric_types.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


EditLimits MakeNumericDraftLimits(){
    EditLimits limits;
    limits.maxBytes = s_NumericEditMaxBytes;
    limits.maxHistoryRecords = s_NumericEditMaxHistoryRecords;
    limits.maxHistoryBytes = s_NumericEditMaxBytes * s_NumericEditHistoryBytesFactor;
    return limits;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class NumericEditDraft : NoCopy{
    private EditModel m_model;
    private String m_accepted;
    private u64 m_revision = 1u;

    public NumericEditDraft(){
        this.m_model = EditModel(MakeNumericDraftLimits());
        this.m_accepted.reserve(s_NumericEditMaxBytes);
    }

    public in EditModel model()const{ return this.m_model; }

    public mut EditModel lend(){ return this.m_model; }

    public b8 dirty()const{ return this.m_model.text() != StringView(this.m_accepted); }

    public u64 revision()const{ return this.m_revision; }

    public b8 setText(in StringView text){
        return FinalizeNumericDraftTextUpdate(this.m_model.setText(text), this.m_revision);
    }

    public Expected<b8, ErrorCode> canonicalize(in StringView formatted){
        const b8 changed = HasCanonicalDraftChanged(formatted, this.m_model.text());
        const b8 updated = this.m_model.setText(formatted);
        return FinalizeCanonicalNumericDraft(formatted, changed, updated, this.m_accepted);
    }

    public void advance(){ AdvanceNonWrappingRevision(this.m_revision); }

    public NumericEditResult restore(in Expected<b8, ErrorCode> restored, in b8 cancelled){
        NumericEditResult result;
        if(restored.has_value()){
            result.restored = restored.value();
            result.valid = true;
            result.cancelled = cancelled;
            this.advance();
        }
        return result;
    }

    public NumericEditResult commit(
        in b8 canonical,
        in b8 accepted,
        in b8 clamped,
        in b8 changed,
        in Expected<b8, ErrorCode> canonicalized
    ){
        NumericEditResult result;
        if(canonical || clamped){
            if(!canonicalized.has_value())
                return result;
            result.restored = !accepted && canonicalized.value();
        }
        else if(accepted)
            this.m_accepted.assign(this.m_model.text());
        result.valid = true;
        result.committed = accepted;
        result.rejected = !accepted;
        result.valueChanged = accepted && changed;
        result.clamped = clamped;
        this.advance();
        return result;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

