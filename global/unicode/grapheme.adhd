[cpp_header("<global/unicode/grapheme.h>"), cpp_name("::GraphemeBoundaryState"), cpp_flags(small_value, brace_init)]
extern class GraphemeBoundaryState{
    b8 first;
    b8 indicConsonantRun;
    b8 indicLinker;
    b8 pictographExtendRun;
    GraphemeBreak previous;
    b8 previousZwjAfterPictograph;
    usize regionalRun;
};


