using EcsTestWorld = ::NWB::Tests::EcsTestWorld;
using GlobalArena = ::NWB::Core::Alloc::GlobalArena;
using CpuTaskScheduler = ::NWB::Core::CpuTaskScheduler;
using CpuTaskScope = ::NWB::Core::CpuTaskScope;
using World = ::NWB::Core::ECS::World;
