#include <impl/assets_scene/asset.adhd>
#include <impl/assets_shader/loader.adhd>
#include <impl/assets_ui_skin/types.adhd>
#include <impl/ecs_ui/toolkit/gpu/renderer_tasks.adhd>
#include <impl/ecs_ui/toolkit/gpu/image_resources.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_GpuRendererContext = "GpuRenderer";

class GpuRendererState : NoCopy{
    public mut GraphicsRuntime m_graphics;
    public mut AssetManager m_assets;
    public SharedPool m_versions = SharedPool();
    public ShaderArchivePathResolver m_resolver;
    public ActiveSceneSubsystemsRef m_activeSceneSubsystems;
    public GpuVersion<GpuSharedResources> m_resources;
    public GpuVersion<GpuSkinVersion> m_skin;
    public GpuImageCache m_imageCache;
    public GpuSampledTextureNameTable m_sampledTextureNames;
    public Array<GpuFrameSlot, s_GpuTargetSlotCount> m_slots;
    public Array<GpuFrame, s_GpuFrameCount> m_frames;
    public GpuFrame m_pending;
    public AcquiredPresentationFrame m_lastAcceptedAcquired;
    public Optional<mut IGpuTaskGraphPresentationContributor> m_presentationContributor;
    public Optional<in GpuTaskGraph> m_declaredGraph;
    public GpuTaskGraphOutputLayer m_declaredLayer;
    public u64 m_graphGeneration = 0u;
    public u64 m_lastAcceptedGeneration = 0u;
    public GpuCommandRecordingMode m_recordingMode = GpuCommandRecordingMode::Direct;
    public u32 m_width = 0u;
    public u32 m_height = 0u;
    public b8 m_frameTimingScopePrepared = false;
    public b8 m_claimed = false;
    public b8 m_readyToDeclare = false;

    [cpp_unwind]
    public GpuRendererState(mut GraphicsRuntime graphics, mut AssetManager assets, in ShaderArchivePathResolver resolver){
        this.m_graphics = graphics;
        this.m_assets = assets;
        this.m_resolver = resolver;
        this.m_imageCache.reserve();
    }

    [cpp_unwind]
    private b8 loadShader<TShader : IShader>(in AssetRef<TShader> reference, in Name identity, mut ShaderHandle outShader){
        return reference.valid() && Load<TShader, ShaderArchivePathResolver>(reference.name(), s_DefaultVariant, identity, s_GpuRendererContext, this.m_graphics, this.m_assets, this.m_resolver, Optional<Name>(), outShader);
    }

    public mut GraphicsRuntime graphics(){ return this.m_graphics; }
    [owner_result]
    private GpuFrameData emptyFrame()const{ return GpuFrameData(); }

    [cpp_unwind]
    public Expected<GpuFrame> makeFrame(){
        auto rasterCapture = this.m_versions.make<GpuCommandIrCapture>(this.m_graphics.allocator());
        auto outputCapture = this.m_versions.make<GpuCommandIrCapture>(this.m_graphics.allocator());
        if(!rasterCapture.has_value() || !outputCapture.has_value())
            return MakeUnexpected(Failure());
        GpuFrameData prepared = this.emptyFrame();
        prepared.m_rasterCommandIrCapture = rasterCapture.value();
        prepared.m_outputCommandIrCapture = outputCapture.value();
        return this.m_versions.makePrepared<GpuFrameData>(prepared);
    }
    [cpp_unwind]
    public b8 createResources();
    [cpp_unwind]
    public b8 prepareOutputPipeline(in FramebufferInfo info);
    [cpp_unwind]
    public b8 prepareBuffers(mut GpuFrameSlot slot, in DrawSnapshot snapshot);
    [cpp_unwind]
    public b8 prepare(in AcquiredPresentationFrame acquired);
    [cpp_unwind]
    public Expected<GpuTaskGraphOutputLayer> declare(mut GpuTaskGraph graph, in b8 allowEmptySceneLayer);
    [cpp_unwind]
    public Expected<GpuTaskId> declareStandalone(mut GpuTaskGraph graph, mut GpuTimingFrameTransaction frameTimingTransaction);
    [cpp_unwind]
    public b8 renderStandalone(in AcquiredPresentationFrame frame);
    public void acceptOutputLayer(in u64 generation, in QueueSubmissionToken token);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

