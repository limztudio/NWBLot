////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_name("::ArenaMemoryReservation::Enum")]
extern enum ArenaMemoryReservation : u8{
    Separate,
    FollowsUsage
};

[cpp_name("::ArenaMemorySource::Enum")]
extern enum ArenaMemorySource : u8{
    Arena,
    HeapBacking
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_name("::ArenaMemoryOwnerIdentity"), cpp_flags(self_defaulted, binary_serializable, brace_init)]
extern class ArenaMemoryOwnerIdentity{
    Name ownerName;
    ArenaMemorySource source;
};

[cpp_name("::ArenaMemoryOwnerSnapshot"), cpp_flags(self_defaulted, binary_serializable, brace_init)]
extern class ArenaMemoryOwnerSnapshot{
    Name ownerName;
    ArenaMemorySource source;
    ArenaMemoryStats stats;
};

[cpp_name("::ArenaMemoryStats"), cpp_flags(self_defaulted, binary_serializable, brace_init)]
extern class ArenaMemoryStats{
    u64 allocationCount;
    u64 deallocationCount;
    u64 peakUsedBytes;
    u64 reallocationCount;
    u64 reservedBytes;
    u64 usedBytes;
};

[cpp_name("::ArenaMemoryTracker"), cpp_flags(self_defaulted, brace_init, no_copy, no_assign)]
extern class ArenaMemoryTracker{
    void addReservedBytes(...);
    Name ownerName(...)const;
    void recordAllocation(...);
    void recordDeallocation(...);
    void recordReallocation(...);
    void releaseRetainedMemory(...);
    void removeReservedBytes(...);
    void reset(...);
    ArenaMemoryStats snapshot(...)const;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_name("::HeapBackingMemoryStats")]
extern ArenaMemoryStats HeapBackingMemoryStats();

[cpp_name("::RecordHeapMemoryAllocation")]
extern void RecordHeapMemoryAllocation(in isize a0);

[cpp_name("::RecordHeapMemoryDeallocation")]
extern void RecordHeapMemoryDeallocation(in isize a0);

[cpp_name("::RecordHeapMemoryReallocation")]
extern void RecordHeapMemoryReallocation(in isize a0, in isize a1);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<global/arena_memory.h>"), cpp_name("::ArenaMemoryOwnerCursor"), cpp_flags(self_defaulted)]
extern class ArenaMemoryOwnerCursor{
    b8 next(mut ArenaMemoryOwnerSnapshot snapshot);
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

