////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_SMOKE_LAMBERT_SHADING_SLANGI
#define NWB_SMOKE_LAMBERT_SHADING_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Smoke-test-owned deferred lighting BXDF.
// The engine provides lights and visibility/caustic transport; this asset owns BRDF, light loop, and tone-map for both paths.
static const half NWB_SMOKE_LAMBERT_TONEMAP_KNEE = 0.65h;
static const half NWB_SMOKE_LAMBERT_RIM_EXPONENT = 3.0h;
static const half NWB_SMOKE_LAMBERT_PRIMARY_SPECULAR_EXPONENT = 72.0h;
static const half NWB_SMOKE_LAMBERT_PRIMARY_SPECULAR_WEIGHT = 0.85h;
static const half NWB_SMOKE_LAMBERT_SECONDARY_SPECULAR_EXPONENT = 18.0h;
static const half NWB_SMOKE_LAMBERT_SECONDARY_SPECULAR_WEIGHT = 0.18h;
static const half NWB_SMOKE_LAMBERT_VIEW_SPECULAR_EXPONENT = 22.0h;
static const half NWB_SMOKE_LAMBERT_VIEW_SPECULAR_WEIGHT = 0.28h;
static const half NWB_SMOKE_LAMBERT_ANISOTROPIC_LOBE_EXPONENT = 18.0h;
static const half3 NWB_SMOKE_LAMBERT_SPECULAR_TINT_NEUTRAL = half3(0.78h);
static const half3 NWB_SMOKE_LAMBERT_SPECULAR_TINT_WARM = half3(1.0h, 0.9h, 0.68h);
static const half NWB_SMOKE_LAMBERT_SPECULAR_TINT_MIX = 0.65h;
static const half NWB_SMOKE_LAMBERT_DIFFUSE_FLOOR = 0.02h;
static const half NWB_SMOKE_LAMBERT_DIFFUSE_SCALE = 0.98h;
static const half NWB_SMOKE_LAMBERT_SPECULAR_NDOTL_FLOOR = 0.08h;
static const half NWB_SMOKE_LAMBERT_SPECULAR_NDOTL_SCALE = 0.92h;
static const half3 NWB_SMOKE_LAMBERT_RIM_TINT = half3(0.12h, 0.26h, 0.52h);
static const half NWB_SMOKE_LAMBERT_RIM_RADIANCE_MIX = 0.25h;
static const half NWB_SMOKE_LAMBERT_RIM_NDOTL_FLOOR = 0.04h;
static const half NWB_SMOKE_LAMBERT_RIM_NDOTL_SCALE = 0.96h;
static const half NWB_SMOKE_LAMBERT_FRAME_CUE_WEIGHT = 0.16h;
static const half3 NWB_SMOKE_LAMBERT_TANGENT_CUE_COLOR = half3(1.0h, 0.35h, 0.2h);
static const half3 NWB_SMOKE_LAMBERT_BITANGENT_CUE_COLOR = half3(0.2h, 0.7h, 1.0h);
static const half3 NWB_SMOKE_LAMBERT_BACKLIGHT_CUE_COLOR = half3(0.012h, 0.02h, 0.04h);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


half3 nwbSmokeLambertTonemap(half3 color){
    return color / (color + half3(NWB_SMOKE_LAMBERT_TONEMAP_KNEE));
}

half3 nwbSmokeLambertShadeLight(NwbSceneLight light, half3 baseColor, float3 normalVector, float3 tangentVector, float3 bitangentVector, float3 viewVector, half ndotv, float3 worldPosition){
    float3 lightVector;
    half3 lightRadiance;
    nwbSceneResolveLight(light, worldPosition, lightVector, lightRadiance);
    if(all(lightRadiance <= half3(0.0h)))
        return half3(0.0h);

    const float3 halfVector = nwbSafeNormalize(lightVector + viewVector, lightVector);
    const half ndotl = half(max(dot(normalVector, lightVector), 0.0));
    const half keyDiffuse = ndotl * ndotl;
    const half rim = pow(max(1.0h - ndotv, 0.0h), NWB_SMOKE_LAMBERT_RIM_EXPONENT);
    const half halfDotNormal = half(max(dot(normalVector, halfVector), 0.0));
    const half specular = pow(halfDotNormal, NWB_SMOKE_LAMBERT_PRIMARY_SPECULAR_EXPONENT) * NWB_SMOKE_LAMBERT_PRIMARY_SPECULAR_WEIGHT + pow(halfDotNormal, NWB_SMOKE_LAMBERT_SECONDARY_SPECULAR_EXPONENT) * NWB_SMOKE_LAMBERT_SECONDARY_SPECULAR_WEIGHT;
    const half viewSpecular = pow(ndotv, NWB_SMOKE_LAMBERT_VIEW_SPECULAR_EXPONENT) * NWB_SMOKE_LAMBERT_VIEW_SPECULAR_WEIGHT;
    const half tangentLobe = pow(half(abs(dot(tangentVector, halfVector))), NWB_SMOKE_LAMBERT_ANISOTROPIC_LOBE_EXPONENT);
    const half bitangentLobe = pow(half(abs(dot(bitangentVector, halfVector))), NWB_SMOKE_LAMBERT_ANISOTROPIC_LOBE_EXPONENT);
    const half backLight = half(max(dot(-normalVector, lightVector), 0.0));

    const half3 specularTint = lerp(NWB_SMOKE_LAMBERT_SPECULAR_TINT_NEUTRAL, NWB_SMOKE_LAMBERT_SPECULAR_TINT_WARM, NWB_SMOKE_LAMBERT_SPECULAR_TINT_MIX);
    const half3 diffuse = baseColor * lightRadiance * (NWB_SMOKE_LAMBERT_DIFFUSE_FLOOR + NWB_SMOKE_LAMBERT_DIFFUSE_SCALE * keyDiffuse);
    const half3 specularColor = lightRadiance * specularTint * (specular * (NWB_SMOKE_LAMBERT_SPECULAR_NDOTL_FLOOR + NWB_SMOKE_LAMBERT_SPECULAR_NDOTL_SCALE * ndotl) + viewSpecular);
    const half3 rimColor = lerp(NWB_SMOKE_LAMBERT_RIM_TINT, lightRadiance, NWB_SMOKE_LAMBERT_RIM_RADIANCE_MIX) * (rim * (NWB_SMOKE_LAMBERT_RIM_NDOTL_FLOOR + NWB_SMOKE_LAMBERT_RIM_NDOTL_SCALE * ndotl));
    const half3 frameCue = NWB_SMOKE_LAMBERT_FRAME_CUE_WEIGHT * (NWB_SMOKE_LAMBERT_TANGENT_CUE_COLOR * half(tangentLobe) + NWB_SMOKE_LAMBERT_BITANGENT_CUE_COLOR * half(bitangentLobe));
    const half3 backLightCue = NWB_SMOKE_LAMBERT_BACKLIGHT_CUE_COLOR * half(backLight);

    return diffuse + specularColor + rimColor + frameCue + backLightCue;
}

half3 nwbSmokeLambertShadeSurface(NwbBxdfSurface surface, int2 pixel){
    const float3 normalVector = nwbSafeNormalize(surface.normal, float3(0.0, 0.0, 1.0));
    const float3 tangentVector = nwbFrameOrthonormalTangent(float3(0.0, 0.0, 0.0), normalVector);
    const float3 bitangentVector = nwbSafeNormalize(cross(normalVector, tangentVector), cross(normalVector, nwbFrameFallbackTangent(normalVector)));
    const float3 viewVector = nwbSafeNormalize(surface.viewVector, float3(0.0, 0.0, 1.0));
    const half ndotv = half(max(dot(normalVector, viewVector), 0.0));

    half3 litColor = surface.baseColor * surface.indirectIrradiance;
    const uint lightCount = nwbSceneLightCount();
    for(uint i = 0u; i < lightCount; ++i){
        const half3 transmittance = nwbBxdfLightTransmittance(pixel, i);
        litColor += transmittance * nwbSmokeLambertShadeLight(g_NwbSceneLights[i], surface.baseColor, normalVector, tangentVector, bitangentVector, viewVector, ndotv, surface.worldPosition);
    }

    litColor += nwbBxdfCausticIrradiance(pixel) * surface.baseColor;
    return nwbBxdfRequiresLinearOutput() ? max(litColor, half3(0.0h)) : nwbSmokeLambertTonemap(litColor);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

