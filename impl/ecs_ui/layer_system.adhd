////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_ui/components.adhd.h>
#include <impl/ecs_ui/paint_context.adhd.h>
#include <impl/ecs_ui/edit_box_host.adhd.h>
#include <impl/ecs_ui/skin_selection.adhd.h>

#include <impl/assets_scene/asset.adhd.h>
#include <impl/assets_ui_skin/types.adhd.h>
#include <impl/ecs_ui/toolkit/input/pointer.adhd.h>
#include <impl/ecs_ui/toolkit/gpu/renderer.adhd.h>

#include <core/ecs/system.h>
#include <core/input/module.h>
#include <core/graphics/runtime/render_pass.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


inline constexpr TStringView s_UiLayerSystemOwnerName = FOUNDATION_TEXT("UiLayerSystem");

using ActiveSceneSubsystemsConstPtr = const ActiveSceneSubsystems*;
using UiLayerShaderPathResolveCallback = Function<Expected<Name>(const Name&, AStringView, const Name&)>;
using UiInputKeyBinding = Ui::InputKeyBinding;
using UiPaintBuilder = Ui::PaintBuilder;
using UiTextService = Ui::TextService;
using UiContext = Ui::Context;
using UiBuilder = Ui::Builder;
using UiLiveRootVector = Ui::PaintVector<UiLiveRoot>;
using UiWidgetRootVector = Ui::PaintVector<Ui::WidgetRoot>;
using UiGpuRenderer = Ui::GpuRenderer;
using UiDisplayMetrics = Ui::DisplayMetrics;
using UiPoint = Ui::Point;
using UiInputEvent = Ui::InputEvent;
using UiPointerInput = Ui::PointerInput;
using UiGpuCommandRecordingMode = Ui::GpuCommandRecordingMode::Enum;
using BoolPtr = b8*;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// ECS owns callback execution; the independent GPU renderer receives only frozen paint snapshots.
[arena, system("ui_layer")]
class UiLayerSystem : IRenderPass, IInputEventHandler{
    private mut World m_world;
    private mut GraphicsRuntime m_graphics;
    private mut InputDispatcher m_input;
    private mut IClipboardService m_clipboard;
    private mut ITextInputService m_textInput;
    private mut AssetManager m_assetManager;
    private ActiveSceneSubsystems m_defaultSceneSubsystems;
    private ActiveSceneSubsystemsConstPtr m_activeSceneSubsystems;
    private UiSkinSelectionState m_skinSelection;
    private UniquePtr<IAsset> m_skinAsset;
    private UiPaintBuilder m_paint;
    private UiTextService m_text;
    private UiContext m_context;
    private UiEditBoxHost m_editHost;
    private UiBuilder m_ui;
    private UiLiveRootVector m_liveRoots;
    private UiWidgetRootVector m_rootIdentities;
    private UiGpuRenderer m_renderer;
    private UiDisplayMetrics m_display;
    private UiPoint m_pointer;
    private u64 m_frameGeneration = 0u;
    private UiFrameDelta m_frameDelta;
    private u32 m_pressedButtons = 0u;
    private u32 m_width = 0u;
    private u32 m_height = 0u;
    // Native-key ownership survives focus transfer; the CPU router retains each resolved held intention.
    private Array<u8, s_UiNativeKeySlotCount> m_nativeKeyOwners;
    private UiLayerPresentation m_presentation = UiLayerPresentation::Scene;
    private u8 m_pointerOwner = 0u;
    private b8 m_blockNativeChars = false;
    private b8 m_blockCommandChars = false;
    private b8 m_resourcesReady = false;
    private b8 m_fontsReady = false;

    public UiLayerSystem(
        mut World world,
        mut GraphicsRuntime graphics,
        mut InputDispatcher input,
        mut IClipboardService clipboard,
        mut ITextInputService textInput,
        mut AssetManager assetManager,
        in UiLayerShaderPathResolveCallback shaderPathResolver,
        in AssetRef<UiSkin> skin,
        in UiLayerPresentation presentation
    );
    public ~UiLayerSystem();

    public void setActiveSceneSubsystems(in ActiveSceneSubsystemsConstPtr subsystems);
    public void setGpuCommandRecordingMode(in UiGpuCommandRecordingMode mode);

    public CpuTaskOptions taskOptions()const override;
    public void prepare(mut World world)override;
    public Expected<void, CpuTaskAdmissionError> update(mut World world, in f32 delta)override;
    public b8 validateResources(in u32 width, in u32 height, in u32 sampleCount)override;
    public void invalidateResources()override;
    public b8 prepareResources(in FramebufferPtr framebuffer)override;
    public void render(in FramebufferPtr framebuffer)override;
    public void displayScaleChanged(in f32 scaleX, in f32 scaleY)override;

    // Main-thread profile replacement copies bindings; an empty profile disables every default shortcut.
    public b8 setInputBindings(in Span<UiInputKeyBinding> bindings);
    public KeyboardInputResult keyboardUpdate(in i32 key, in i32 scancode, in i32 action, in i32 mods)override;
    public b8 keyboardCharInput(in u32 unicode, in i32 mods)override;
    public b8 mousePosUpdate(in f64 xpos, in f64 ypos)override;
    public b8 mouseButtonUpdate(in i32 button, in i32 action, in i32 mods)override;
    public b8 mouseScrollUpdate(in f64 xoffset, in f64 yoffset)override;
    public void windowFocusUpdate(in b8 focused)override;
    public void pointerLeave()override;
    public void pointerCaptureLost()override;
    public b8 wantsKeyboard()const;
    public b8 wantsPointer()const;

    private void collectRoots();
    private void synchronizeInput();
    private void routeInput(in UiInputEvent event);
    private void routeInput(in UiInputEvent event, in BoolPtr blockText);
    private void routePointerInput(in UiPointerInput input);
    private void routePointerInput(in UiPointerInput input, in BoolPtr consumed);
    private void synchronizeNativeInput();
    private void abandonPendingFrame();
    private void abandonPendingFrame(in b8 resetUi);
    private void resetNormalizedInput();
    private void resetNativeInputState();
    private b8 loadFonts(mut ScratchArena scratchArena);
    private AssetRef<UiSkin> basicSkin()const;
    private AssetRef<UiSkin> resolveSkin(in AssetRef<UiSkin> ref)const;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsValidUiDisplayScale(in f32 scaleX, in f32 scaleY){
    return IsFinite(scaleX) && scaleX > 0.0f && IsFinite(scaleY) && scaleY > 0.0f;
}

b8 ShouldSuppressControlCharInput(in b8 hasControlModifier, in b8 hasAltModifier){
    return hasControlModifier && !hasAltModifier;
}

b8 ShouldBlockRoutedCommandText(in b8 isCommandDown, in b8 hasCommand, in b8 allowText){
    return isCommandDown && hasCommand && !allowText;
}

u8 ResolveUiPointerPressOwner(
    in b8 nativeActive,
    in b8 wouldConsumePointer,
    in b8 hasPopup,
    in b8 hitTargetValid
){
    b8 consumed = hasPopup || hitTargetValid;
    if(nativeActive)
        consumed = wouldConsumePointer;
    if(consumed)
        return cast<u8>(UiInputOwner::Custom);
    return cast<u8>(UiInputOwner::Scene);
}

b8 CanBeginUiLayerPaintFrame(in b8 resourcesReady, in b8 rendererHasPendingFrame, in b8 contextReady){
    return resourcesReady && !rendererHasPendingFrame && !contextReady;
}


