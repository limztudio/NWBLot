////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


HitTarget MakeHorizontalNavigationPart(in HitTarget host){
    HitTarget part = HitTarget();
    part.id.value = 4u;
    part.declarationGeneration = host.declarationGeneration;
    part.rectangle.x = 20.0f;
    part.rectangle.y = 20.0f;
    part.rectangle.width = 60.0f;
    part.rectangle.height = 20.0f;
    part.clip = host.clip;
    part.paintOrder = 1u;
    part.activatable = true;
    part.control = host.control;
    part.owner = host.id;
    part.ownerDeclarationGeneration = host.declarationGeneration;
    part.value = 91u;
    part.popup = host.popup;
    part.layer = host.layer;
    return part;
}

PopupScope MakeHorizontalNavigationPopup(in HitTarget owner, in u64 openGeneration){
    PopupScope popup = PopupScope();
    popup.token.widget = owner.id;
    popup.token.declarationGeneration = owner.declarationGeneration;
    popup.token.instanceGeneration = 6u;
    popup.token.openGeneration = openGeneration;
    popup.bounds.x = 0.0f;
    popup.bounds.y = 0.0f;
    popup.bounds.width = 300.0f;
    popup.bounds.height = 200.0f;
    popup.viewport = popup.bounds;
    popup.layer = 1u;
    return popup;
}

void ExpectUiEditBoxPlacement(in EditBoxPlacement actual, in EditBoxPlacement expected){
    ExpectUiRect(actual.bounds, expected.bounds);
    ExpectUiRect(actual.frameClip, expected.frameClip);
    ExpectUiRect(actual.content, expected.content);
    ExpectUiRect(actual.clip, expected.clip);
    ExpectUiRect(actual.caret, expected.caret);
    EXPECT_FLOAT_EQ(actual.textOrigin.x, expected.textOrigin.x);
    EXPECT_FLOAT_EQ(actual.textOrigin.y, expected.textOrigin.y);
    EXPECT_FLOAT_EQ(actual.scroll, expected.scroll);
    EXPECT_FLOAT_EQ(actual.scrollY, expected.scrollY);
}

void ExpectUiEditCaretRect(in Rect rectangle, in f32 x, in f32 y, in f32 height){
    EXPECT_FLOAT_EQ(rectangle.x, x);
    EXPECT_FLOAT_EQ(rectangle.y, y);
    EXPECT_FLOAT_EQ(rectangle.width, 0.0f);
    EXPECT_FLOAT_EQ(rectangle.height, height);
}

void PopulateCaretShapedRun(in CaretShaper shaper, in ShapeRequest request, mut ShapedRun run){
    if(shaper.variedHeight && request.text == "TALL"){
        run.metrics.ascender = 10.0f;
        run.metrics.descender = 4.0f;
        run.metrics.lineGap = 6.0f;
    }
    else{
        run.metrics.ascender = 8.0f;
        run.metrics.descender = 2.0f;
        run.metrics.lineGap = 2.0f;
    }
    if(shaper.fault == UiFixtureShaperFault::Overlap){
        run.glyphs.push_back(ShapedGlyph(SharedFontFace(), 1u, 0u, 2u, Point(), Point(s_CaretGlyphAdvance, 0.0f), Rect()));
        run.glyphs.push_back(ShapedGlyph(SharedFontFace(), 2u, 1u, 3u, Point(), Point(s_CaretGlyphAdvance, 0.0f), Rect()));
    }
    else if(shaper.fault == UiFixtureShaperFault::InconsistentGlyphEnd){
        run.glyphs.push_back(ShapedGlyph(SharedFontFace(), 1u, 0u, 1u, Point(), Point(s_CaretGlyphAdvance, 0.0f), Rect()));
        run.glyphs.push_back(ShapedGlyph(SharedFontFace(), 2u, 0u, 3u, Point(), Point(), Rect()));
    }
    else if(shaper.fault == UiFixtureShaperFault::NonfinitePlacement){
        const f32 maxFloat = 3.40282346638528859812e+38f;
        run.glyphs.push_back(ShapedGlyph(SharedFontFace(), 1u, 0u, 1u, Point(), Point(maxFloat, 0.0f), Rect()));
        run.glyphs.push_back(ShapedGlyph(SharedFontFace(), 2u, 1u, 2u, Point(maxFloat, 0.0f), Point(), Rect()));
    }
    else if(request.text == "ffi")
        run.glyphs.push_back(ShapedGlyph(SharedFontFace(), 1u, 0u, 3u, Point(), Point(30.0f, 0.0f), Rect()));
    else if(request.text == "A\314\201B"){
        run.glyphs.push_back(ShapedGlyph(SharedFontFace(), 1u, 0u, 3u, Point(), Point(s_CaretGlyphAdvance, 0.0f), Rect()));
        run.glyphs.push_back(ShapedGlyph(SharedFontFace(), 2u, 3u, 4u, Point(), Point(s_CaretGlyphAdvance, 0.0f), Rect()));
    }
    else if(request.text == "e\xcc\x81")
        run.glyphs.push_back(ShapedGlyph(SharedFontFace(), 1u, 0u, 3u, Point(), Point(s_CaretGlyphAdvance, 0.0f), Rect()));
    else if(request.text == "\xe1\x84\x92\xe1\x85\xa1\xe1\x86\xab")
        run.glyphs.push_back(ShapedGlyph(SharedFontFace(), 1u, 0u, 9u, Point(), Point(12.0f, 0.0f), Rect()));
    else{
        usize begin = 0u;
        if(shaper.fault == UiFixtureShaperFault::LeadingGap)
            begin = 1u;
        usize trim = 0u;
        if(shaper.fault == UiFixtureShaperFault::TrailingGap && !request.text.empty())
            trim = 1u;
        const usize limit = request.text.size() - trim;
        while(begin < limit){
            usize end = begin + 1u;
            while(end < limit && IsUtf8Continuation(cast<u8>(request.text[end])))
                ++end;
            run.glyphs.push_back(ShapedGlyph(SharedFontFace(), 1u, cast<u32>(begin), cast<u32>(end), Point(), Point(shaper.scalarAdvance, 0.0f), Rect()));
            begin = end;
        }
    }
    if(shaper.zeroAdvance){
        for(mut ShapedGlyph glyph : run.glyphs)
            glyph.advance.x = 0.0f;
    }
    if(request.direction == TextDirection::RightToLeft)
        ReverseGlyphs(run);
}

void ExpectEditCaretFixtureCaret(in EditCaretFixture self, in usize byte, in f32 x, in f32 y, in f32 height){
    const Expected<Rect> rectangle = self.m_geometry.caretRect(byte);
    ASSERT_TRUE(rectangle.has_value());
    ExpectUiEditCaretRect(rectangle.value(), x, y, height);
}

void ExpectEditCaretFixtureRange(in EditCaretFixture self, in EditBoxRange range, in u32 line, in Rect expected, in f32 cap){
    const Expected<Rect> rectangle = self.m_geometry.rangeOnLine(range, line, cap);
    ASSERT_TRUE(rectangle.has_value());
    ExpectUiRect(rectangle.value(), expected);
}

void InitHorizontalNavigationTargets(mut Array<HitTarget, 3u> targets){
    for(usize index = 0u; index < 2u; ++index){
        targets[index].id.value = index + 1u;
        targets[index].declarationGeneration = 7u;
        targets[index].rectangle = Rect(cast<f32>(index) * 140.0f, 0.0f, 100.0f, 100.0f);
        targets[index].clip = Rect(0.0f, 0.0f, 300.0f, 200.0f);
        targets[index].focusable = true;
        targets[index].control.instanceGeneration = 11u + index;
        targets[index].control.contentGeneration = 21u;
        targets[index].control.contentRevision = 31u;
        targets[index].navigable = true;
        targets[index].horizontalNavigation = true;
        targets[index].pageRows = 4u;
    }
    targets[2u].id.value = 3u;
    targets[2u].declarationGeneration = 9u;
    targets[2u].rectangle = Rect(0.0f, 120.0f, 120.0f, 24.0f);
    targets[2u].clip = targets[0u].clip;
    targets[2u].focusable = true;
    targets[2u].textEditable = true;
    targets[2u].control.instanceGeneration = 101u;
    targets[2u].control.contentGeneration = 102u;
    targets[2u].control.contentRevision = 103u;
}

InputRoutingResult SendHorizontalNavigationKeyDown(mut HorizontalNavigationFixture self, in KeyEnum key, in b8 repeat){
    InputEvent event = InputEvent();
    event.key = key;
    event.type = InputEventType::KeyDown;
    event.repeat = repeat;
    return self.send(event);
}

InputRoutingResult SendHorizontalNavigationKeyUp(mut HorizontalNavigationFixture self, in KeyEnum key){
    InputEvent event = InputEvent();
    event.key = key;
    event.type = InputEventType::KeyUp;
    return self.send(event);
}

void PressHorizontalNavigationKey(mut HorizontalNavigationFixture self, in KeyEnum key){
    EXPECT_TRUE(self.keyDown(key).commandConsumed);
    EXPECT_TRUE(self.keyUp(key).commandConsumed);
}

void FocusHorizontalNavigationTarget(mut HorizontalNavigationFixture self, in usize index){
    const Rect rectangle = self.m_targets[index].rectangle;
    const Point point = Point(rectangle.x + 10.0f, rectangle.y + 10.0f);
    InputEvent down = InputEvent();
    down.position = point;
    down.type = InputEventType::PrimaryDown;
    EXPECT_TRUE(self.send(down).pointerConsumed);
    InputEvent up = InputEvent();
    up.position = point;
    up.type = InputEventType::PrimaryUp;
    EXPECT_TRUE(self.send(up).pointerConsumed);
    EXPECT_EQ(self.m_router.focus(), self.m_targets[index].id);
}

b8 PublishHorizontalNavigationTargets(mut HorizontalNavigationFixture self, in usize count, in Span<PopupScope> popups){
    const u64 generation = self.m_generation + 1u;
    if(!self.m_router.commitTargets(Span<HitTarget>(self.m_targets.data(), count), generation, popups))
        return false;
    self.m_generation = generation;
    return true;
}

Expected<ControlAction> TakeHorizontalNavigationAction(mut HorizontalNavigationFixture self, in usize index){
    const HitTarget host = self.m_targets[index];
    return self.m_router.consumeControlAction(host.id, host.declarationGeneration, host.control);
}

void BindHorizontalNavigationEditor(mut HorizontalNavigationFixture self, in usize hostIndex){
    const HitTarget host = self.m_targets[hostIndex];
    self.m_targets[2u].commandOwner = host.id;
    self.m_targets[2u].commandOwnerDeclarationGeneration = host.declarationGeneration;
    self.m_targets[2u].commandControl = host.control;
    self.m_targets[2u].popup = host.popup;
    self.m_targets[2u].layer = host.layer;
}

void CollectUiSolidRects(in DrawSnapshot snapshot, in Color color, mut PaintVector<Rect> output){
    output.clear();
    for(in DrawCommand command : snapshot.commands()){
        if(command.material != PaintMaterial::Solid)
            continue;
        for(u32 index = command.firstIndex; index + 5u < command.firstIndex + command.indexCount; index += 6u){
            const Vertex first = snapshot.vertices()[snapshot.indices()[index]];
            if(first.color.r != color.r || first.color.g != color.g || first.color.b != color.b || first.color.a != color.a)
                continue;
            const Vertex opposite = snapshot.vertices()[snapshot.indices()[index + 2u]];
            output.push_back(Rect(first.position.x, first.position.y, opposite.position.x - first.position.x, opposite.position.y - first.position.y));
        }
    }
}

b8 PlaceMultilineViewFixture(mut MultilineViewFixture self, in f32 width, in f32 height, in Point previousScroll){
    const Expected<EditBoxPlacement> placement = self.m_view.arrange(Rect(10.0f, 20.0f, width, height), Insets(), s_MultilineViewViewport, previousScroll);
    if(!placement.has_value())
        return false;
    self.m_placement = placement.value();
    return true;
}

Expected<DrawSnapshot> PaintMultilineViewFixture(mut MultilineViewFixture self, in EditBoxStyle style, in EditBoxPaintFlags flags){
    self.m_paint.begin(DisplayMetrics(s_MultilineViewViewport.width, s_MultilineViewViewport.height, 1.0f, 1.0f), 1u, 1u, MakeUiSkinAssetRef(s_MultilineViewSkinPath), self.m_skin);
    if(!self.m_view.paint(self.m_text, self.m_paint, self.m_skin, self.m_placement, style, flags))
        return MakeUnexpected(Failure());
    EXPECT_FALSE(self.m_paint.popClip());
    return self.m_paint.freeze();
}


