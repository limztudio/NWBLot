}

void VerifyAssetsGraphics_ShaderMetadataRejectsDefinesThatCannotRoundTripVariantSignatures(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_ShaderScratchArena);

    const Expected<GraphicsTestPath> rootResult = PrepareCaseRoot(testArena, "shader_invalid_define_tokens");
    ASSERT_TRUE(rootResult.has_value());
    const GraphicsTestPath root = rootResult.value();

    ASSERT_TRUE(WriteTextFile(JoinGraphicsPath(root, "shader.slang"), "void main(){}\n"));
    ASSERT_TRUE(WriteTextFile(JoinGraphicsPath(root, "include.slangi"), "static const uint sourceValue = 1u;\n"));

    Vector<StringView> invalidDefinesList = Vector<StringView>();
    invalidDefinesList.reserve(6u);
    invalidDefinesList.push_back("\"\": [\"1\"]");
    invalidDefinesList.push_back("\"9QUALITY\": [\"1\"]");
    invalidDefinesList.push_back("\"PROJECT-QUALITY\": [\"1\"]");
    invalidDefinesList.push_back("\"PROJECT_QUALITY\": [\"1;OTHER=0\"]");
    invalidDefinesList.push_back("\"PROJECT_QUALITY\": [\" 1\"]");
    invalidDefinesList.push_back("\"PROJECT_QUALITY\": [\"1 \"]");

    ShaderCook shaderCook(testArena.arena);
    ShaderCookShaderEntry shaderEntry(testArena.arena);
    ShaderCookIncludeEntry includeEntry(testArena.arena);

    for(u32 modeIndex = 0u; modeIndex < 2u; ++modeIndex){
        const b8 isInclude = modeIndex == 1u;
        StringView modeLabel = "shader";
        StringView filename = "shader.nwb";
        StringView declaration = "compute_shader asset;\nasset.entry_point = \"main\";\n";
        if(isInclude){
            modeLabel = "include";
            filename = "include.nwb";
            declaration = "include asset;\n";
        }
        const ScopedTestTrace traceMode(modeLabel);
        const GraphicsTestPath metadataPath = JoinGraphicsPath(root, filename);

        TestAString validMetadata = TestAString();
        validMetadata.append(declaration);
        validMetadata.append("asset.defines = { \"PROJECT_QUALITY\": [\"1\"] };\n");

        for(in StringView invalidDefines : invalidDefinesList){
            const ScopedTestTrace traceDefines(invalidDefines);
            ASSERT_TRUE(WriteTextFile(metadataPath, ViewTestString(validMetadata)));
            if(isInclude){
                Expected<ShaderCookIncludeEntry> parsedValid = ParseTestIncludeEntryFile(metadataPath, testArena, scratchArena, shaderCook);
                ASSERT_TRUE(parsedValid.has_value());
                includeEntry = parsedValid.value();
                ASSERT_FALSE(includeEntry.defineValues.empty());
            }
            else{
                Expected<ShaderCookShaderEntry> parsedValid = ParseTestShaderEntryFile(metadataPath, testArena, scratchArena, shaderCook);
                ASSERT_TRUE(parsedValid.has_value());
                shaderEntry = parsedValid.value();
                ASSERT_FALSE(shaderEntry.defineValues.empty());
            }

            TestAString invalidMetadata = TestAString();
            invalidMetadata.append(declaration);
            invalidMetadata.append("asset.defines = { ");
            invalidMetadata.append(invalidDefines);
            invalidMetadata.append(" };\n");
            ASSERT_TRUE(WriteTextFile(metadataPath, ViewTestString(invalidMetadata)));
            if(isInclude){
                EXPECT_FALSE(CanParseIncludeEntryFile(metadataPath, testArena, scratchArena, shaderCook));
                EXPECT_FALSE(includeEntry.defineValues.empty());
            }
            else{
                EXPECT_FALSE(CanParseShaderEntryFile(metadataPath, testArena, scratchArena, shaderCook));
                EXPECT_FALSE(shaderEntry.defineValues.empty());
            }

            ASSERT_TRUE(WriteTextFile(metadataPath, ViewTestString(validMetadata)));
            if(isInclude){
                Expected<ShaderCookIncludeEntry> parsedRecovered = ParseTestIncludeEntryFile(metadataPath, testArena, scratchArena, shaderCook);
                ASSERT_TRUE(parsedRecovered.has_value());
                includeEntry = parsedRecovered.value();
                EXPECT_TRUE(ValidateIncludeEntryVariantSignature("project/define_probe", "PROJECT_QUALITY=1", includeEntry, scratchArena));
            }
            else{
                Expected<ShaderCookShaderEntry> parsedRecovered = ParseTestShaderEntryFile(metadataPath, testArena, scratchArena, shaderCook);
                ASSERT_TRUE(parsedRecovered.has_value());
                shaderEntry = parsedRecovered.value();
                EXPECT_TRUE(ValidateShaderEntryVariantSignature("project/define_probe", "PROJECT_QUALITY=1", shaderEntry, scratchArena));
            }
        }
    }
    EXPECT_TRUE(RemoveAllIfExists(root));
}

void VerifySkeletonPayload_RejectsLaterSelfAndMissingParentsAndRecoversWithValidParents(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistration(logger, s_BreakOnFatal);
    for(u32 invalidCase = 0u; invalidCase < 4u; ++invalidCase){
        const ScopedTestTrace trace(invalidCase);
        SkeletonInputs inputs = SkeletonInputs();
        switch(invalidCase){
        case 0u: inputs.entry.joints[0u].parent = Name(s_SkeletonJointLeft); break;
        case 1u: inputs.entry.joints[1u].parent = Name(s_SkeletonJointLeft); break;
        case 2u: inputs.entry.joints[3u].parent = Name(s_AssetCaseMissing); break;
        case 3u: inputs.entry.joints[1u].parent = Name(s_SkeletonJointRight); break;
        default: break;
        }
        EXPECT_FALSE(inputs.canBuild());
        inputs.entry.joints[0u].parent = s_NameNone;
        inputs.entry.joints[1u].parent = Name(s_SkeletonJointRoot);
        inputs.entry.joints[3u].parent = Name(s_SkeletonJointLeft);
        EXPECT_TRUE(inputs.canBuild());
    }
    EXPECT_EQ(logger.errorCount(), 4u);
    EXPECT_TRUE(SawCapturedError(logger, "references missing or later parent"));
}

void VerifySkeletonPayload_RejectsDuplicateCanonicalIdsAfterResolvingEarlierParent(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistration(logger, s_BreakOnFatal);
    for(u32 duplicateIndex = 0u; duplicateIndex < 2u; ++duplicateIndex){
        Name duplicate = Name(s_SkeletonJointLeft);
        if(duplicateIndex == 1u)
            duplicate = Name("ROOT");
        SkeletonInputs inputs = SkeletonInputs();
        inputs.entry.joints[3u].name = duplicate;
        inputs.entry.joints[3u].parent = duplicate;
        EXPECT_FALSE(inputs.canBuild());
    }
    EXPECT_EQ(logger.errorCount(), 2u);
    EXPECT_TRUE(SawCapturedError(logger, "duplicate joint name"));
}

void VerifySkeletonPayload_CodecRejectsEveryTruncatedTablePrefixWithoutReplacingPriorJoints(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistration(logger, s_BreakOnFatal);
    SkeletonInputs inputs = SkeletonInputs();
    ASSERT_TRUE(inputs.buildIntoSkeleton());

    SkeletonAssetCodec codec = SkeletonAssetCodec();
    AssetBytes binary = MakeSkeletonInputsBytes(inputs);
    ASSERT_TRUE(SerializeSkeletonAsset(codec, inputs.skeleton, binary));
    ASSERT_TRUE(LoadSkeletonInputsBinary(inputs, binary));

    for(usize prefix = 0u; prefix < binary.size(); ++prefix){
        const ScopedTestTrace trace(prefix);
        AssetBytes malformed = MakeSkeletonInputsBytes(inputs);
        CopyAssetBytes(binary, malformed);
        malformed.resize(prefix);
        EXPECT_FALSE(LoadSkeletonInputsBinary(inputs, malformed));
        AssetBytes retained = MakeSkeletonInputsBytes(inputs);
        ASSERT_TRUE(SerializeSkeletonAsset(codec, inputs.skeleton, retained));
        EXPECT_EQ(retained, binary);
    }
    EXPECT_EQ(logger.errorCount(), binary.size());
}

void VerifySkeletonPayload_RepeatedValidationReclaimsCallerScratchAfterSuccessAndInvalidLookup(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistration(logger, s_BreakOnFatal);
    SkeletonInputs inputs = SkeletonInputs();
    ASSERT_TRUE(inputs.buildIntoSkeleton());
    ASSERT_TRUE(inputs.validate());

    const ArenaMemoryStats warm = inputs.scratchStats();
    for(usize iteration = 0u; iteration < 16u; ++iteration){
        const b8 valid = iteration % 2u == 0u;
        u32 indexValue = 0u;
        if(valid)
            indexValue = 1u;
        inputs.setJointIndexOverride(Name(s_SkeletonJointLeft), indexValue);
        EXPECT_EQ(inputs.validate(), valid);
        const ArenaMemoryStats current = inputs.scratchStats();
        EXPECT_EQ(current.usedBytes, warm.usedBytes);
        EXPECT_EQ(current.reservedBytes, warm.reservedBytes);
    }
    EXPECT_EQ(logger.errorCount(), 8u);
}

void VerifyAssetsGraphics_Rgba8FallbackMipSizeRejectsAddressOverflow(){
