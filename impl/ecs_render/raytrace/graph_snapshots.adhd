#include <impl/ecs_render/refraction/statistics_readback.adhd>
#include <impl/ecs_render/shadow/light_space_shadow.adhd>
#include <impl/ecs_render/raytrace/graph_types.adhd>
#include <impl/ecs_render/shadow/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RayTracingShadowVisibilityGraphPlanSnapshot{
    public FrozenLightSpaceShadowHandle lightSpace;
    public GraphOwnedAdaptiveShadowPlan adaptivePlan;

    public b8 lightSpaceReady()const{
        return this.lightSpace.valid() && this.lightSpace.deref().snapshot.ready;
    }

    public b8 hardwareTransparentTrace = false;
    public b8 softTransparentFoldReady = false;
    public b8 combinedSoftUpsample = false;
    public b8 combinedSoftWaveletReady = false;
    public b8 combinedSoftTemporalReady = false;
    public b8 softShadowHistoryReadable = false;
    public b8 opaqueTemporalMergeReady = false;
    public b8 transparentTemporalMergeReady = false;
    public b8 historyFrontIsA = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RayTracingFrameCpuStateSnapshot{
    public QueueSubmissionToken surfelCountReadbackSubmissionToken;

    public u32 softShadowFrameIndex = 0u;
    public u32 surfelFrameIndex = 0u;
    public u32 surfelCountReadbackFrame = 0u;
    public u32 softShadowSlotMask = 0u;
    public u32 causticLightCount = 0u;

    public b8 swShadowDispatchLogged = false;
    public b8 causticAccumulatorInitialized = false;
    public b8 swCausticDispatchLogged = false;
    public b8 hwCausticDispatchLogged = false;
    public b8 causticEmissionGateLogged = false;
    public b8 surfelSeeded = false;
}

class RayTracingShadowPreparationResourceSnapshot{
    public RayTracingAccelStructHandle sceneTlas;
    public BufferHandle sceneTlasBackingBuffer;
    public BufferHandle bvhSortKeysBuffer;
    public BufferHandle bvhSortPayloadBuffer;
    public BufferHandle bvhVisitCounterBuffer;
    public BufferHandle swShadowEdgeCounterBuffer;
    public BufferHandle swShadowEdgeListBuffer;
    public BufferHandle swShadowIndirectArgsBuffer;
}

class RayTracingDeferredGraphResourceSnapshot{
    public BufferHandle materialContextSlotsBuffer;
    public BufferHandle csgTraceContextBuffer;
    public Span<QueueSubmissionToken> rayTraceContextReadSubmissionTokens;
    public Span<BufferHandle> csgTraceBoundsBuffers;
    public BufferHandle shadowInstanceMaterialBuffer;
    public BufferHandle shadowMaterialTypedBuffer;
    public BufferHandle shadowInstanceBuffer;
    public BufferHandle causticEmissionTargetBuffer;
    public BufferHandle surfelFrameConstantsBuffer;
    public BufferHandle hardwareTransparentCrossingsBuffer;
    public BufferHandle hardwareTransparentOverflowListBuffer;
    public BufferHandle hardwareTransparentOverflowArgsBuffer;
    public BufferHandle sceneBvhNodeBuffer;
    public BufferHandle sceneInstanceBuffer;
    public RayTracingAccelStructHandle sceneTlas;

    public b8 causticAccumulatorInitialized = false;
    public b8 surfelUsesHardwareTrace = false;
    public b8 surfelSplitGraphPipelinesReady = false;
}

class RayTracingSurfelPersistentResourceSnapshot{
    public BufferHandle constantsBuffer;
    public BufferHandle poolBuffer;
    public BufferHandle guidePoolBuffer;
    public BufferHandle cellHeadBuffer;
    public BufferHandle counterBuffer;
    public BufferHandle traceIndirectArgsBuffer;
    public BufferHandle freeListBuffer;
    public BufferHandle poolSnapshotBuffer;
    public BufferHandle cellHeadSnapshotBuffer;
    public BufferHandle counterReadbackBuffer;
    public QueueSubmissionToken countReadbackSubmissionToken;
}

class RayTracingRefractionGraphResources{
    public RefractionStatisticsReadbackSnapshot statistics = RefractionStatisticsReadbackSnapshot();
    public ComputePipelineHandle pipeline;
    public ComputePipelineHandle densePipeline;
    public ComputePipelineHandle screenFallbackPipeline;
    public ComputePipelineHandle denseScreenFallbackPipeline;
    public ComputePipelineHandle classifyTilesPipeline;
    public ComputePipelineHandle finalizeTilesPipeline;
    public BufferHandle materialContextSlotsBuffer;
    public BufferHandle viewBuffer;
    public RayTracingAccelStructHandle sceneTlas;
    public GpuDescriptorHandle tlasHeapHandle;
    public u32 materialContextSlotsHeapSlot = 0u;
    public u32 viewHeapSlot = 0u;
    public u32 opaqueReflectionSlot = s_Invalid;
    public u32 certifiedInstanceIndex = u32.max;
    public b8 refractionEnabled = true;
    public b8 usesHardwareTrace = false;

    public b8 valid()const{
        return this.pipeline.valid()
            && this.densePipeline.valid()
            && this.classifyTilesPipeline.valid()
            && this.finalizeTilesPipeline.valid()
            && this.viewBuffer.valid()
            && (!this.usesHardwareTrace || (this.sceneTlas.valid() && this.tlasHeapHandle.valid() && this.materialContextSlotsBuffer.valid()));
    }
}


