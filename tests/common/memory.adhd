[cpp_header("<tests/common/memory_sdk.h>"), cpp_name("::NWB::Core::Alloc::ScratchArena")]
extern class TestScratchAllocator{
    ArenaMemoryStats memoryStats()const;
};

[cpp_header("<tests/common/memory_sdk.h>"), cpp_name("::NWB::Tests::RawAllocation"), cpp_flags(brace_init, small_value)]
extern class RawAllocation{
    usize address()const;
    mut u8 operator[](in usize index)const;
    u8 readVolatile(in usize index)const;
    void writeVolatile(in usize index, in u8 value)const;
};

[cpp_header("<tests/common/memory_sdk.h>"), cpp_name("::NWB::Tests::AllocateBytes")]
extern RawAllocation AllocateBytes(mut auto storage, in usize alignment, in usize count);

[cpp_header("<tests/common/memory_sdk.h>"), cpp_name("::NWB::Tests::FreeBytes")]
extern void FreeBytes(mut auto storage, in RawAllocation block, in usize alignment, in usize count);

[cpp_header("<tests/common/memory_sdk.h>"), cpp_name("::NWB::Tests::ResizeBytes")]
extern RawAllocation ResizeBytes(mut auto storage, in RawAllocation block, in usize alignment, in usize count);

[cpp_header("<tests/common/memory_sdk.h>"), cpp_name("::NWB::Tests::BackendSize")]
extern usize BackendSize(in RawAllocation block);

[cpp_header("<tests/common/memory_sdk.h>"), cpp_name("::NWB::Tests::HeapStorage")]
extern class HeapStorageHandle{
    GlobalAllocator arena;
    T makeValue<T>(...);
    ArenaMemoryStats memoryStats()const;
    AllocationIdentity identity()const;
};


