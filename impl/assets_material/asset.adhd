////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_material/binary_validation.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Materials hold only mesh and pixel stages. The compute emulation shader is found by the mesh shader name, so it is never stored here.
b8 IsSupportedMaterialShaderStage(in ShaderType shaderType){
    return shaderType == ShaderType::MeshStage || shaderType == ShaderType::PixelStage;
}

type StageShaderArray = Array<AssetRef<IShader>, s_MaterialShaderStageCount>;
type TypedLayoutBlockVector = Vector<MaterialTypedLayoutBlock>;
type TypedLayoutFieldVector = Vector<MaterialTypedLayoutField>;
type TypedBlockByteVector = Vector<u8>;
type ResourceReferenceVector = Vector<MaterialResourceReference>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[arena, asset("material")]
class Material{
    private String m_shaderVariant;
    private Name m_materialInterface = s_NameNone;
    private u32 m_shadingModelId = 0u;
    private u32 m_surfaceDispatchId = 0u;
    private u64 m_typedLayoutHash = 0u;
    private TypedLayoutBlockVector m_typedLayoutBlocks;
    private TypedLayoutFieldVector m_typedLayoutFields;
    private TypedBlockByteVector m_typedBlockBytes;
    private ResourceReferenceVector m_resourceReferences;
    private StageShaderArray m_stageShaders;
    private u32 m_stageShaderCount = 0u;
    private b8 m_transparent = false;
    private b8 m_twoSided = false;
    private b8 m_refractive = false;
    private AssetRef<PixelShader> m_avboitAccumulatePixelShader;
    private AssetRef<PixelShader> m_avboitOccupancyPixelShader;
    private AssetRef<PixelShader> m_avboitExtinctionPixelShader;

    public b8 loadBinary(in Span<u8> binary);
    public b8 validatePayload()const;
    public b8 validatePayload(in StringView failureContext)const;
    public b8 validatePayload(in StringView failureContext, in StringView failureContextText)const;

    public void setShaderVariant(in StringView variantName){ this.m_shaderVariant.assign(variantName); }
    public void setMaterialInterface(in Name materialInterface){ this.m_materialInterface = materialInterface; }
    public void setShadingModelId(in u32 shadingModelId){ this.m_shadingModelId = shadingModelId; }
    public void setSurfaceDispatchId(in u32 surfaceDispatchId){ this.m_surfaceDispatchId = surfaceDispatchId; }
    public void setAvboitAccumulatePixelShader(in AssetRef<PixelShader> shaderAsset){ this.m_avboitAccumulatePixelShader = shaderAsset; }
    public void setAvboitOccupancyPixelShader(in AssetRef<PixelShader> shaderAsset){ this.m_avboitOccupancyPixelShader = shaderAsset; }
    public void setAvboitExtinctionPixelShader(in AssetRef<PixelShader> shaderAsset){ this.m_avboitExtinctionPixelShader = shaderAsset; }
    public void setTransparent(in b8 transparent){ this.m_transparent = transparent; }
    public void setTwoSided(in b8 twoSided){ this.m_twoSided = twoSided; }
    public void setRefractive(in b8 refractive){ this.m_refractive = refractive; }
    public void setTypedLayout(in u64 layoutHash, in Span<MaterialTypedLayoutBlock> blocks, in Span<MaterialTypedLayoutField> fields, in Span<u8> blockBytes);
    public void setResourceReferences(in Span<MaterialResourceReference> resourceReferences);
    public b8 setShaderForStage(in ShaderType shaderType, in AssetRef<IShader> shaderAsset);

    public Expected<AssetRef<MeshShader>> findMeshShader()const{
        AssetRef<MeshShader> shaderAsset(this.m_stageShaders[cast<usize>(ShaderType::MeshStage)].virtualPath);
        if(!shaderAsset.valid())
            return MakeUnexpected(Failure());
        return shaderAsset;
    }

    public Expected<AssetRef<PixelShader>> findPixelShader()const{
        AssetRef<PixelShader> shaderAsset(this.m_stageShaders[cast<usize>(ShaderType::PixelStage)].virtualPath);
        if(!shaderAsset.valid())
            return MakeUnexpected(Failure());
        return shaderAsset;
    }

    public in String shaderVariant()const{ return this.m_shaderVariant; }
    public in Name materialInterface()const{ return this.m_materialInterface; }
    public u32 shadingModelId()const{ return this.m_shadingModelId; }
    public u32 surfaceDispatchId()const{ return this.m_surfaceDispatchId; }
    public u64 typedLayoutHash()const{ return this.m_typedLayoutHash; }
    public in TypedLayoutBlockVector typedLayoutBlocks()const{ return this.m_typedLayoutBlocks; }
    public in TypedLayoutFieldVector typedLayoutFields()const{ return this.m_typedLayoutFields; }
    public in TypedBlockByteVector typedBlockBytes()const{ return this.m_typedBlockBytes; }
    public in ResourceReferenceVector resourceReferences()const{ return this.m_resourceReferences; }
    public in StageShaderArray stageShaders()const{ return this.m_stageShaders; }
    public u32 stageShaderCount()const{ return this.m_stageShaderCount; }
    // Cook-generated AVBOIT accumulate pixel shader for this material's transparent draw.
    // Valid only for surface-authored transparent materials; missing means a cook/runtime contract failure.
    // Not a graphics stage: the material has one pixel stage, and this is the transparent-only shader the renderer selects by pass.
    public in AssetRef<PixelShader> avboitAccumulatePixelShader()const{ return this.m_avboitAccumulatePixelShader; }
    // Accumulate twins for AVBOIT passes; same surface renderCoverage and validity as above.
    public in AssetRef<PixelShader> avboitOccupancyPixelShader()const{ return this.m_avboitOccupancyPixelShader; }
    public in AssetRef<PixelShader> avboitExtinctionPixelShader()const{ return this.m_avboitExtinctionPixelShader; }
    public b8 transparent()const{ return this.m_transparent; }
    public b8 twoSided()const{ return this.m_twoSided; }
    // Refractive-caster flag, separate from `transparent`. Refraction values stay shader-side (NwbMeshSurface).
    public b8 refractive()const{ return this.m_refractive; }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
