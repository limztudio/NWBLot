class ReflectionFeedbackExtent{
    public ReflectionFeedbackExtent(){
        this.width = 0u;
        this.height = 0u;
        this.tilesX = 0u;
        this.tilesY = 0u;
        this.entryCount = 0u;
        this.byteCount = 0u;
    }

    public ReflectionFeedbackExtent(in u32 inWidth, in u32 inHeight, in u32 inTilesX, in u32 inTilesY, in u32 inEntryCount, in u32 inByteCount){
        this.width = inWidth;
        this.height = inHeight;
        this.tilesX = inTilesX;
        this.tilesY = inTilesY;
        this.entryCount = inEntryCount;
        this.byteCount = inByteCount;
    }

    public b8 valid()const{
        return this.byteCount != 0u;
    }

    public u32 width;
    public u32 height;
    public u32 tilesX;
    public u32 tilesY;
    public u32 entryCount;
    public u32 byteCount;
}

const u32 s_ReflectionFeedbackGroupSize = 8u;
const usize s_ReflectionFeedbackBankCount = 2u;
const usize s_ReflectionPostprocessDescriptorCount = 4u;
const u64 s_ReflectionFeedbackSurfaceCount = 2u;
const u64 s_ReflectionFeedbackHeaderBytes = 16u;
const u64 s_ReflectionFeedbackEntryBytes = 4u;
const u64 s_ReflectionFeedbackMaxCount = 0xffffffffull;
const u32 s_ReflectionFeedbackWriteEnabled = 1u;
const u32 s_ReflectionFeedbackPreviousValid = 2u;

Expected<ReflectionFeedbackExtent> TryComputeReflectionFeedbackExtent(in u32 width, in u32 height){
    if(width == 0u || height == 0u)
        return makeUnexpected(Failure());
    const u32 tilesX = divideUp(width, s_ReflectionFeedbackGroupSize);
    const u32 tilesY = divideUp(height, s_ReflectionFeedbackGroupSize);
    const u64 entryCount = cast<u64>(tilesX) * cast<u64>(tilesY) * s_ReflectionFeedbackSurfaceCount;
    const u64 byteCount = s_ReflectionFeedbackHeaderBytes + entryCount * s_ReflectionFeedbackEntryBytes;
    if(entryCount > s_ReflectionFeedbackMaxCount || byteCount > s_ReflectionFeedbackMaxCount)
        return makeUnexpected(Failure());
    return ReflectionFeedbackExtent(width, height, tilesX, tilesY, cast<u32>(entryCount), cast<u32>(byteCount));
}

[reflect]
enum<u32> ReflectionDescriptorIndex{
    OpaqueSampled,
    OpaqueStorage,
    GlassSampled,
    GlassStorage,
    Queue,
    Counters,
    Args,
    Parameters
}

Expected<u32> TryResolveReflectionQueueCapacity(in u32 width, in u32 height, in u32 maxHardwareRaysPerFrame){
    u64 pixelCount = cast<u64>(width) * cast<u64>(height);
    if(width == 0u || height == 0u || pixelCount > cast<u64>(0xFFFFFFFFu) / 2u)
        return makeUnexpected(Failure());
    u64 boundedCapacity = max(cast<u64>(1u), min(pixelCount * 2u, cast<u64>(maxHardwareRaysPerFrame)));
    if(boundedCapacity > cast<u64>(0xFFFFFFFFu) / 4u)
        return makeUnexpected(Failure());
    return cast<u32>(boundedCapacity);
}

u32 ResolveReflectionIndirectArgumentCount(in u32 capacity, in b8 sliced){
    if(sliced)
        return divideUp(capacity, s_ReflectionTraceSliceRays);
    return 1u;
}

