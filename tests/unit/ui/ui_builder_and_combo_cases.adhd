void VerifyUiComboBuilderTests_SiblingComboFieldsPaintTheirOwnDeclarationStyles(mut UiComboBuilderTests self){
    self.m_source.count = 0u;
    ComboState secondState = ComboState();
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginPanel(s_UiComboBuilderPanelKey, MakeUiBuilderRect(10.0f, 10.0f, 320.0f, 240.0f)));
    self.m_builder.comboStyle().normal = s_UiCaseNameButtonNormal;
    ASSERT_TRUE(self.m_builder.comboBox("first", self.m_source, self.m_state, MakeUiComboBuilderDefaultOptions()).valid);
    self.m_builder.comboStyle().normal = s_UiCaseButtonHover;
    ASSERT_TRUE(self.m_builder.comboBox("second", self.m_source, secondState, MakeUiComboBuilderDefaultOptions()).valid);
    ASSERT_TRUE(self.finishPanel());
    const DrawSnapshot snapshot = self.m_paint.freeze();
    const Expected<Rect> first = self.skinQuad(snapshot, 6u);
    ASSERT_TRUE(first.has_value());
    const Expected<Rect> second = self.skinQuad(snapshot, 7u);
    ASSERT_TRUE(second.has_value());
    EXPECT_LT(first.value().y, second.value().y);
}

void VerifyUiComboBuilderTests_TabExitsAnExplicitlyOpenedComboRelativeToItsFieldWithoutCommittingPreview(mut UiComboBuilderTests self){
    self.m_source.count = 4u;
    self.m_state.select(1u);
    self.m_state.open();
    ASSERT_TRUE(AcceptUiComboBuilderNeighbors(self, 1u));
    ASSERT_EQ(self.m_context.input().focus(), self.list());
    self.press(CoreKey::Down);
    ASSERT_TRUE(AcceptUiComboBuilderNeighbors(self, 2u));
    ASSERT_EQ(self.m_state.listState().cursorKey(), 2u);
    self.press(CoreKey::Tab);
    ASSERT_TRUE(AcceptUiComboBuilderNeighbors(self, 3u));
    EXPECT_TRUE(self.m_result.closed);
    EXPECT_FALSE(self.m_result.committed);
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    EXPECT_EQ(self.m_state.listState().cursorKey(), 1u);
    EXPECT_EQ(self.m_context.input().focus(), self.id("after", s_UiComboBuilderPanelKey));
    self.m_state.open();
    ASSERT_TRUE(AcceptUiComboBuilderNeighbors(self, 4u));
    ASSERT_EQ(self.m_context.input().focus(), self.list());
    const InputEvent reverseDown = MakeUiBuilderKeyEvent(InputEventType::KeyDown, CoreKey::Tab, true, false);
    const InputEvent reverseUp = MakeUiBuilderKeyEvent(InputEventType::KeyUp, CoreKey::Tab, true, false);
    EXPECT_TRUE(self.send(reverseDown).commandConsumed);
    EXPECT_TRUE(self.send(reverseUp).commandConsumed);
    ASSERT_TRUE(AcceptUiComboBuilderNeighbors(self, 5u));
    EXPECT_TRUE(self.m_result.closed);
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    EXPECT_EQ(self.m_context.input().focus(), self.id("before", s_UiComboBuilderPanelKey));
}

void VerifyUiComboBuilderTests_TabExitsAnEmptyComboWithoutASelectionOrActivation(mut UiComboBuilderTests self){
    self.m_source.count = 0u;
    ASSERT_TRUE(self.accept(1u));
    ASSERT_TRUE(self.openByPointer(2u));
    ASSERT_EQ(self.m_state.selectedKey(), 0u);
    self.press(CoreKey::Tab);
    ASSERT_TRUE(self.accept(3u));
    EXPECT_TRUE(self.m_result.closed);
    EXPECT_FALSE(self.m_result.committed);
    EXPECT_FALSE(self.m_result.selectionChanged);
    EXPECT_EQ(self.m_state.selectedKey(), 0u);
    EXPECT_EQ(self.m_state.listState().cursorKey(), 0u);
    EXPECT_EQ(self.m_context.input().focus(), self.id(s_UiComboBuilderKey, s_UiComboBuilderPanelKey));
}

void VerifyUiComboBuilderTests_OutsideDismissalConsumesTheWholePointerSequence(mut UiComboBuilderTests self){
    self.m_state.select(1u);
    ASSERT_TRUE(self.accept(1u));
    ASSERT_TRUE(self.openByPointer(2u));
    EXPECT_TRUE(self.send(MakeUiBuilderPointerEvent(InputEventType::PrimaryDown, MakeUiBuilderPoint(790.0f, 590.0f))).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiBuilderPointerEvent(InputEventType::PrimaryUp, MakeUiBuilderPoint(790.0f, 590.0f))).pointerConsumed);
    EXPECT_TRUE(self.m_context.input().actions().empty());
    ASSERT_TRUE(self.accept(3u));
    EXPECT_TRUE(self.m_result.closed);
    EXPECT_FALSE(self.m_result.committed);
    EXPECT_FALSE(self.m_result.selectionChanged);
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    EXPECT_FALSE(self.m_state.isOpen());
}

void VerifyUiComboBuilderTests_HeldOpeningSubmitWaitsForReleaseBeforeTransferringFocus(mut UiComboBuilderTests self){
    self.m_state.select(1u);
    ASSERT_TRUE(self.accept(1u));
    self.press(CoreKey::Tab);
    InputEvent event = MakeUiBuilderKeyEvent(InputEventType::KeyDown, CoreKey::Enter, false, false);
    EXPECT_TRUE(self.send(event).commandConsumed);
    ASSERT_TRUE(self.accept(2u));
    EXPECT_FALSE(self.m_state.isOpen());
    EXPECT_FALSE(self.m_result.opened);
    EXPECT_EQ(self.m_context.input().focus(), self.id(s_UiComboBuilderKey, s_UiComboBuilderPanelKey));
    event.repeat = true;
    EXPECT_TRUE(self.send(event).commandConsumed);
    ASSERT_TRUE(self.prepare(3u));
    EXPECT_FALSE(self.m_state.isOpen());
    EXPECT_FALSE(self.m_result.committed);
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    event.type = InputEventType::KeyUp;
    event.repeat = false;
    EXPECT_TRUE(self.send(event).commandConsumed);
    ASSERT_TRUE(self.accept(4u));
    EXPECT_TRUE(self.m_state.isOpen());
    EXPECT_TRUE(self.m_result.opened);
    EXPECT_FALSE(self.m_result.committed);
    EXPECT_EQ(self.m_context.input().focus(), self.list());
    self.press(CoreKey::Enter);
    ASSERT_TRUE(self.accept(5u));
    EXPECT_TRUE(self.m_result.committed);
    EXPECT_FALSE(self.m_result.selectionChanged);
    EXPECT_FALSE(self.m_state.isOpen());
}

void VerifyUiComboBuilderTests_EscapeBeforeReleaseCancelsFieldOpeningAndPopupSubmission(mut UiComboBuilderTests self){
    self.m_source.count = 4u;
    self.m_state.select(1u);
    ASSERT_TRUE(self.accept(1u));
    self.press(CoreKey::Tab);
    EXPECT_TRUE(self.send(MakeUiBuilderKeyEvent(InputEventType::KeyDown, CoreKey::Enter, false, false)).commandConsumed);
    ASSERT_TRUE(self.accept(2u));
    EXPECT_FALSE(self.m_state.isOpen());
    self.press(CoreKey::Escape);
    EXPECT_TRUE(self.send(MakeUiBuilderKeyEvent(InputEventType::KeyUp, CoreKey::Enter, false, false)).commandConsumed);
    ASSERT_TRUE(self.accept(3u));
    EXPECT_FALSE(self.m_state.isOpen());
    EXPECT_FALSE(self.m_result.opened);
    EXPECT_FALSE(self.m_result.committed);
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    self.press(CoreKey::Tab);
    ASSERT_EQ(self.m_context.input().focus(), self.id(s_UiComboBuilderKey, s_UiComboBuilderPanelKey));
    self.press(CoreKey::Enter);
    ASSERT_TRUE(self.accept(4u));
    ASSERT_TRUE(self.m_state.isOpen());
    self.press(CoreKey::Down);
    ASSERT_TRUE(self.accept(5u));
    ASSERT_EQ(self.m_state.listState().cursorKey(), 2u);
    EXPECT_TRUE(self.send(MakeUiBuilderKeyEvent(InputEventType::KeyDown, CoreKey::Enter, false, false)).commandConsumed);
    ASSERT_TRUE(self.accept(6u));
    EXPECT_FALSE(self.m_result.committed);
    self.press(CoreKey::Escape);
    EXPECT_TRUE(self.send(MakeUiBuilderKeyEvent(InputEventType::KeyUp, CoreKey::Enter, false, false)).commandConsumed);
    ASSERT_TRUE(self.accept(7u));
    EXPECT_FALSE(self.m_state.isOpen());
    EXPECT_FALSE(self.m_result.committed);
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    self.press(CoreKey::Enter);
    ASSERT_TRUE(self.accept(8u));
    EXPECT_TRUE(self.m_state.isOpen());
    EXPECT_FALSE(self.m_result.committed);
}

void VerifyUiComboBuilderTests_DisabledFieldFencesQueuedOpeningAndHasNoTabStop(mut UiComboBuilderTests self){
    self.m_state.select(1u);
    ASSERT_TRUE(self.accept(1u));
    const Optional<HitTarget> initialField = self.findTarget(self.id(s_UiComboBuilderKey, s_UiComboBuilderPanelKey));
    ASSERT_TRUE(initialField.has_value());
    self.click(CenterUiRect(initialField.value().rectangle));
    ComboOptions options = MakeUiComboBuilderDefaultOptions();
    options.enabled = false;
    ASSERT_TRUE(self.accept(2u, options));
    EXPECT_FALSE(self.m_state.isOpen());
    EXPECT_FALSE(self.m_result.opened);
    EXPECT_FALSE(self.m_result.committed);
    EXPECT_FALSE(self.m_result.focused);
    const Optional<HitTarget> disabledField = self.findTarget(self.id(s_UiComboBuilderKey, s_UiComboBuilderPanelKey));
    ASSERT_TRUE(disabledField.has_value());
    EXPECT_FALSE(disabledField.value().enabled);
    EXPECT_FALSE(disabledField.value().focusable);
    EXPECT_FALSE(self.findTarget(self.list()).has_value());
}

void VerifyUiComboBuilderTests_EmptySourceShowsPlaceholderAndSubmitCannotCommitAKey(mut UiComboBuilderTests self){
    self.m_source.count = 0u;
    ASSERT_TRUE(self.accept(1u));
    EXPECT_EQ(self.m_source.textCalls, 0u);
    EXPECT_EQ(self.m_state.selectedKey(), 0u);
    ASSERT_TRUE(self.openByPointer(2u));
    EXPECT_EQ(self.m_source.textCalls, 0u);
    EXPECT_EQ(self.m_state.listState().cursorKey(), 0u);
    self.press(CoreKey::Enter);
    ASSERT_TRUE(self.accept(3u));
    EXPECT_FALSE(self.m_result.committed);
    EXPECT_FALSE(self.m_result.selectionChanged);
    EXPECT_EQ(self.m_state.selectedKey(), 0u);
}

void VerifyUiComboBuilderTests_NavigationSkipsDisabledRowsAndCannotWrapTheBoundary(mut UiComboBuilderTests self){
    self.m_source.count = 3u;
    self.m_source.disabled = 2u;
    self.m_state.select(1u);
    ASSERT_TRUE(self.accept(1u));
    ASSERT_TRUE(self.openByPointer(2u));
    self.press(CoreKey::Down);
    ASSERT_TRUE(self.accept(3u));
    EXPECT_EQ(self.m_state.listState().cursorKey(), 3u);
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    self.press(CoreKey::Down);
    ASSERT_TRUE(self.accept(4u));
    EXPECT_EQ(self.m_state.listState().cursorKey(), 3u);
    self.press(CoreKey::Up);
    ASSERT_TRUE(self.accept(5u));
    EXPECT_EQ(self.m_state.listState().cursorKey(), 1u);
    self.press(CoreKey::Up);
    ASSERT_TRUE(self.accept(6u));
    EXPECT_EQ(self.m_state.listState().cursorKey(), 1u);
}

void VerifyUiComboBuilderTests_ReorderPreservesCommittedKeyAndRemovalClearsIt(mut UiComboBuilderTests self){
    self.m_state.select(50000u);
    ASSERT_TRUE(self.accept(1u));
    self.m_source.reverse = true;
    ++self.m_source.contentRevision;
    ASSERT_TRUE(self.accept(2u));
    EXPECT_EQ(self.m_state.selectedKey(), 50000u);
    EXPECT_FALSE(self.m_result.selectionChanged);
    self.m_source.removed = 50000u;
    --self.m_source.count;
    ++self.m_source.contentRevision;
    ASSERT_TRUE(self.accept(3u));
    EXPECT_EQ(self.m_state.selectedKey(), 0u);
    EXPECT_TRUE(self.m_result.selectionChanged);
    EXPECT_EQ(self.m_source.textCalls, 2u);
}

void VerifyUiComboBuilderTests_SourceRevisionFencesAcceptedRowActivationBeforeTheNewLayout(mut UiComboBuilderTests self){
    self.m_state.select(1u);
    ASSERT_TRUE(self.accept(1u));
    ASSERT_TRUE(self.openByPointer(2u));
    const Optional<HitTarget> rowTarget = self.findTarget(self.row(2u));
    ASSERT_TRUE(rowTarget.has_value());
    self.click(CenterUiRect(rowTarget.value().rectangle));
    self.m_source.reverse = true;
    ++self.m_source.contentRevision;
    ASSERT_TRUE(self.accept(3u));
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    EXPECT_FALSE(self.m_result.committed);
    EXPECT_TRUE(self.m_context.input().controlActions().empty());
}

void VerifyUiComboBuilderTests_ReplacementSourceCannotBorrowThePreviousSelectionOrPopup(mut UiComboBuilderTests self){
    self.m_state.select(1u);
    ASSERT_TRUE(self.accept(1u));
    ASSERT_TRUE(self.openByPointer(2u));
    const Optional<HitTarget> rowTarget = self.findTarget(self.row(2u));
    ASSERT_TRUE(rowTarget.has_value());
    self.click(CenterUiRect(rowTarget.value().rectangle));
    UiComboBuilderSource replacement = UiComboBuilderSource();
    replacement.generation = self.m_source.generation + 1u;
    ASSERT_TRUE(self.declareSource(3u, replacement, self.m_state));
    EXPECT_EQ(self.m_state.selectedKey(), 0u);
    EXPECT_FALSE(self.m_state.isOpen());
    EXPECT_FALSE(self.m_result.committed);
    EXPECT_TRUE(self.m_result.selectionChanged);
    ASSERT_TRUE(self.finishPanel());
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    const Optional<HitTarget> fieldTarget = self.findTarget(self.id(s_UiComboBuilderKey, s_UiComboBuilderPanelKey));
    ASSERT_TRUE(fieldTarget.has_value());
    EXPECT_EQ(fieldTarget.value().control.contentGeneration, replacement.generation);
    EXPECT_FALSE(self.findTarget(self.popup()).has_value());
}

void VerifyUiComboBuilderTests_APreparedMoveKeepsAcceptedFieldAndPopupGeometryUntilCommit(mut UiComboBuilderTests self){
    self.m_state.select(1u);
    ASSERT_TRUE(self.accept(1u));
    ASSERT_TRUE(self.openByPointer(2u));
    const Optional<HitTarget> fieldBefore = self.findTarget(self.id(s_UiComboBuilderKey, s_UiComboBuilderPanelKey));
    const Optional<HitTarget> popupBefore = self.findTarget(self.popup());
    ASSERT_TRUE(fieldBefore.has_value());
    ASSERT_TRUE(popupBefore.has_value());
    const Rect acceptedField = fieldBefore.value().rectangle;
    const Rect acceptedPopup = popupBefore.value().rectangle;
    ASSERT_TRUE(self.prepare(3u, MakeUiComboBuilderDefaultOptions(), MakeUiBuilderRect(300.0f, 300.0f, 320.0f, 240.0f)));
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 2u);
    const Optional<HitTarget> fieldPrepared = self.findTarget(self.id(s_UiComboBuilderKey, s_UiComboBuilderPanelKey));
    const Optional<HitTarget> popupPrepared = self.findTarget(self.popup());
    ASSERT_TRUE(fieldPrepared.has_value());
    ASSERT_TRUE(popupPrepared.has_value());
    ExpectUiRect(fieldPrepared.value().rectangle, acceptedField);
    ExpectUiRect(popupPrepared.value().rectangle, acceptedPopup);
    EXPECT_NE(self.m_state.bounds().x, acceptedField.x);
    EXPECT_FALSE(self.m_context.commitFrame(4u));
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    const Optional<HitTarget> fieldCommitted = self.findTarget(self.id(s_UiComboBuilderKey, s_UiComboBuilderPanelKey));
    const Optional<HitTarget> popupCommitted = self.findTarget(self.popup());
    ASSERT_TRUE(fieldCommitted.has_value());
    ASSERT_TRUE(popupCommitted.has_value());
    ExpectUiRect(fieldCommitted.value().rectangle, self.m_state.bounds());
    ExpectUiRect(popupCommitted.value().rectangle, self.m_state.placement().bounds);
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 3u);
}

void VerifyUiComboBuilderTests_MultipleFieldsHaveIndependentStableInternalIdsAndState(mut UiComboBuilderTests self){
    ComboState other = ComboState();
    self.m_state.select(1u);
    other.select(2u);
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginPanel(s_UiComboBuilderPanelKey, MakeUiBuilderRect(10.0f, 10.0f, 320.0f, 240.0f)));
    ASSERT_TRUE(self.m_builder.comboBox(s_UiComboBuilderKey, self.m_source, self.m_state, MakeUiComboBuilderDefaultOptions()).valid);
    ASSERT_TRUE(self.m_builder.comboBox(s_UiComboBuilderSecondKey, self.m_source, other, MakeUiComboBuilderDefaultOptions()).valid);
    ASSERT_TRUE(self.finishPanel());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const Optional<HitTarget> firstTarget = self.findTarget(self.id(s_UiComboBuilderKey, s_UiComboBuilderPanelKey));
    const Optional<HitTarget> secondTarget = self.findTarget(self.id(s_UiComboBuilderSecondKey, s_UiComboBuilderPanelKey));
    ASSERT_TRUE(firstTarget.has_value());
    ASSERT_TRUE(secondTarget.has_value());
    self.click(CenterUiRect(secondTarget.value().rectangle));
    ASSERT_TRUE(self.begin(2u));
    ASSERT_TRUE(self.m_builder.beginPanel(s_UiComboBuilderPanelKey, MakeUiBuilderRect(10.0f, 10.0f, 320.0f, 240.0f)));
    ASSERT_TRUE(self.m_builder.comboBox(s_UiComboBuilderKey, self.m_source, self.m_state, MakeUiComboBuilderDefaultOptions()).valid);
    const ComboResult result = self.m_builder.comboBox(s_UiComboBuilderSecondKey, self.m_source, other, MakeUiComboBuilderDefaultOptions());
    EXPECT_TRUE(result.valid);
    EXPECT_TRUE(result.opened);
    ASSERT_TRUE(self.finishPanel());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_FALSE(self.m_state.isOpen());
    EXPECT_TRUE(other.isOpen());
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    EXPECT_EQ(other.selectedKey(), 2u);
    EXPECT_FALSE(self.findTarget(self.popup()).has_value());
    EXPECT_TRUE(self.findTarget(self.popup(s_UiComboBuilderSecondKey)).has_value());
    EXPECT_EQ(self.m_context.input().focus(), self.list(s_UiComboBuilderSecondKey));
}

void VerifyUiComboBuilderTests_NativeFocusLossCancelsPreviewAndDoesNotRestoreFocusOnCommit(mut UiComboBuilderTests self){
    self.m_state.select(1u);
    ASSERT_TRUE(self.accept(1u));
    ASSERT_TRUE(self.openByPointer(2u));
    self.press(CoreKey::Down);
    ASSERT_TRUE(self.accept(3u));
    InputEvent focusLost = InputEvent();
    focusLost.type = InputEventType::FocusLost;
    EXPECT_FALSE(self.send(focusLost).focus.valid());
    ASSERT_TRUE(self.accept(4u));
    EXPECT_FALSE(self.m_state.isOpen());
    EXPECT_FALSE(self.m_result.committed);
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    EXPECT_FALSE(self.m_context.input().focus().valid());
}

void VerifyUiComboBuilderTests_FullyClippedFieldCannotPublishItsPopupAboveTheParent(mut UiComboBuilderTests self){
    self.m_state.select(1u);
    self.m_state.open();
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginPanel(s_UiComboBuilderPanelKey, MakeUiBuilderRect(10.0f, 10.0f, 320.0f, 40.0f)));
    WidgetOptions filler = WidgetOptions();
    filler.height.policy = LayoutSizePolicy::Fixed;
    filler.height.value = 100.0f;
    ASSERT_TRUE(self.m_builder.label("filler", "Clipped combo below", filler));
    ASSERT_TRUE(self.m_builder.comboBox(s_UiComboBuilderKey, self.m_source, self.m_state, MakeUiComboBuilderDefaultOptions()).valid);
    ASSERT_TRUE(self.finishPanel());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const Optional<HitTarget> fieldTarget = self.findTarget(self.id(s_UiComboBuilderKey, s_UiComboBuilderPanelKey));
    ASSERT_TRUE(fieldTarget.has_value());
    EXPECT_GE(fieldTarget.value().rectangle.y, fieldTarget.value().clip.y + fieldTarget.value().clip.height);
    EXPECT_FLOAT_EQ(fieldTarget.value().clip.height, 0.0f);
    EXPECT_FALSE(self.findTarget(self.popup()).has_value());
    EXPECT_FALSE(self.findTarget(self.list()).has_value());
    EXPECT_FALSE(self.m_context.input().hasPopup());
    EXPECT_FALSE(self.m_state.isOpen());
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
}

void VerifyUiComboBuilderTests_SharingOneStateAcrossSequentialPanelsRejectsTheSecondDeclaration(mut UiComboBuilderTests self){
    self.m_state.select(1u);
    ASSERT_TRUE(self.declareCombo(1u));
    ASSERT_TRUE(self.m_builder.endPanel());
    const u64 inputGeneration = self.m_state.inputGeneration();
    self.m_source.resetCounters();
    ASSERT_TRUE(self.m_builder.beginPanel("later", MakeUiBuilderRect(400.0f, 10.0f, 300.0f, 200.0f)));
    const ComboResult result = self.m_builder.comboBox(s_UiComboBuilderSecondKey, self.m_source, self.m_state, MakeUiComboBuilderDefaultOptions());
    EXPECT_FALSE(result.valid);
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_EQ(self.m_state.inputGeneration(), inputGeneration);
    EXPECT_EQ(self.m_source.textCalls, 0u);
    EXPECT_EQ(self.m_source.keyCalls, 0u);
    EXPECT_FALSE(self.m_context.commitFrame(1u));
}

void VerifyUiComboBuilderTests_SharingOneStateAcrossRootsRejectsBeforeLendingTheSecondSource(mut UiComboBuilderTests self){
    self.m_state.select(1u);
    ASSERT_TRUE(self.declareCombo(1u));
    ASSERT_TRUE(self.m_builder.endPanel());
    ASSERT_TRUE(self.m_context.endRoot());
    WidgetRoot later = WidgetRoot();
    later.value = 87u;
    later.generation = 2u;
    ASSERT_TRUE(self.m_context.beginRoot(later));
    ASSERT_TRUE(self.m_builder.beginPanel(s_UiComboBuilderPanelKey, MakeUiBuilderRect(400.0f, 10.0f, 300.0f, 200.0f)));
    UiComboBuilderSource replacement = UiComboBuilderSource();
    replacement.generation = 703u;
    const ComboResult result = self.m_builder.comboBox(s_UiComboBuilderKey, replacement, self.m_state, MakeUiComboBuilderDefaultOptions());
    EXPECT_FALSE(result.valid);
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    EXPECT_EQ(replacement.textCalls, 0u);
    EXPECT_EQ(replacement.keyCalls, 0u);
    EXPECT_FALSE(self.m_context.commitFrame(1u));
}

void VerifyUiComboBuilderTests_OmissionRetiresThePopupAndHeldNavigationCannotOpenItsReplacement(mut UiComboBuilderTests self){
    self.m_state.select(1u);
    ASSERT_TRUE(self.accept(1u));
    ASSERT_TRUE(self.openByPointer(2u));
    const Optional<HitTarget> initialField = self.findTarget(self.id(s_UiComboBuilderKey, s_UiComboBuilderPanelKey));
    ASSERT_TRUE(initialField.has_value());
    const u64 oldDeclaration = initialField.value().declarationGeneration;
    InputEvent held = MakeUiBuilderKeyEvent(InputEventType::KeyDown, CoreKey::Down, false, false);
    EXPECT_TRUE(self.send(held).commandConsumed);
    ASSERT_TRUE(self.begin(3u));
    ASSERT_TRUE(self.m_builder.beginPanel(s_UiComboBuilderPanelKey, MakeUiBuilderRect(10.0f, 10.0f, 320.0f, 240.0f)));
    ASSERT_TRUE(self.m_builder.label("label", "Combo hidden"));
    ASSERT_TRUE(self.finishPanel());
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    EXPECT_FALSE(self.m_context.input().hasPopup());
    EXPECT_FALSE(self.findTarget(self.id(s_UiComboBuilderKey, s_UiComboBuilderPanelKey)).has_value());
    EXPECT_FALSE(self.findTarget(self.list()).has_value());
    EXPECT_TRUE(self.m_context.input().controlActions().empty());
    ASSERT_TRUE(self.accept(4u));
    EXPECT_FALSE(self.m_state.isOpen());
    EXPECT_TRUE(self.m_result.closed);
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    EXPECT_EQ(self.m_state.listState().cursorKey(), 1u);
    const Optional<HitTarget> recreatedField = self.findTarget(self.id(s_UiComboBuilderKey, s_UiComboBuilderPanelKey));
    ASSERT_TRUE(recreatedField.has_value());
    EXPECT_NE(recreatedField.value().declarationGeneration, oldDeclaration);
    self.press(CoreKey::Tab);
    EXPECT_EQ(self.m_context.input().focus(), self.id(s_UiComboBuilderKey, s_UiComboBuilderPanelKey));
    held.repeat = true;
    EXPECT_TRUE(self.send(held).commandConsumed);
    ASSERT_TRUE(self.accept(5u));
    EXPECT_FALSE(self.m_state.isOpen());
    EXPECT_FALSE(self.m_result.opened);
    held.type = InputEventType::KeyUp;
    held.repeat = false;
    EXPECT_TRUE(self.send(held).commandConsumed);
    self.press(CoreKey::Down);
    ASSERT_TRUE(self.accept(6u));
    EXPECT_TRUE(self.m_state.isOpen());
    EXPECT_TRUE(self.m_result.opened);
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    EXPECT_EQ(self.m_state.listState().cursorKey(), 2u);
}

void VerifyUiComboBuilderTests_ReplacementStateDiscardsAcceptedRowsAndItsQueuedActivation(mut UiComboBuilderTests self){
    self.m_state.select(1u);
    ASSERT_TRUE(self.accept(1u));
    ASSERT_TRUE(self.openByPointer(2u));
    const Optional<HitTarget> rowTarget = self.findTarget(self.row(2u));
    ASSERT_TRUE(rowTarget.has_value());
    self.click(CenterUiRect(rowTarget.value().rectangle));
    ComboState replacement = ComboState();
    ASSERT_TRUE(self.declareSource(3u, self.m_source, replacement));
    EXPECT_TRUE(self.m_result.valid);
    EXPECT_FALSE(self.m_result.committed);
    EXPECT_EQ(replacement.selectedKey(), 0u);
    EXPECT_FALSE(replacement.isOpen());
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    EXPECT_TRUE(self.m_state.isOpen());
    ASSERT_TRUE(self.finishPanel());
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    EXPECT_FALSE(self.findTarget(self.popup()).has_value());
    EXPECT_TRUE(self.m_context.input().controlActions().empty());
}

void VerifyUiComboBuilderTests_SelectedLabelLookupMustRoundTripItsStableKeyBeforeReadingText(mut UiComboBuilderTests self){
    self.m_state.select(1u);
    UiComboBuilderLabelLookupSource source = UiComboBuilderLabelLookupSource();
    EXPECT_FALSE(self.declareSource(1u, source, self.m_state));
    EXPECT_FALSE(self.m_result.valid);
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    EXPECT_EQ(source.textCalls, 0u);
    EXPECT_FALSE(self.m_context.commitFrame(1u));
}


