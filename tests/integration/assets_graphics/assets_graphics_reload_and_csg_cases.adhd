void VerifyAssetsGraphics_RendererComponentCookAndSerializePreservesOpticalFields(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    native(in logger, mut testArena){
        auto cookCase = PrepareAssetsGraphicsCookCase(testArena, "renderer_component_optical_fields");
        ASSERT_TRUE(cookCase);
        const Path& root = cookCase->root;
        const Path& outputDirectory = cookCase->outputDirectory;
        const Path assetRoot = root / s_AssetsDirectory;
        const Name virtualPath = s_ProjectEntitiesLensRenderer;

        ASSERT_TRUE(WriteTextFile(assetRoot / "entities" / "lens" / "renderer.nwb", s_RendererComponentMetadata));
        ASSERT_TRUE(CookPreparedGraphicsAssetRoots(testArena, root, outputDirectory, { assetRoot }, 1u));

        const auto loadedAsset = LoadCookedAsset<NWB::Impl::ComponentAssetCodec>(outputDirectory, virtualPath, 1u, testArena);
        ASSERT_TRUE(loadedAsset);
        ASSERT_NE(loadedAsset->get(), nullptr);
        EXPECT_EQ((*loadedAsset)->assetType(), NWB::Impl::RendererComponentAsset::AssetTypeName());
        const auto* rendererAsset = static_cast<const NWB::Impl::RendererComponentAsset*>(loadedAsset->get());
        EXPECT_EQ(rendererAsset->component.material.name(), Name("project/materials/glass"));
        EXPECT_TRUE(rendererAsset->component.visible);
        EXPECT_EQ(rendererAsset->component.opticalVolumeCoincidence, NWB::Impl::OpticalVolumeCoincidence::SharedGroup);
        EXPECT_EQ(rendererAsset->component.opticalVolumeGroup, Name("lens_assembly"));
