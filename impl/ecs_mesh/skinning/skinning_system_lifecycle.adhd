[cpp_header("<impl/assets/graphics/skinned_mesh/constants.h>"), cpp_name("NWB_SKINNED_MESH_SKINNING_MODE_LINEAR_BLEND")]
extern const usize s_ShaderSkinnedMeshSkinningModeLinearBlend;

[cpp_header("<impl/assets/graphics/skinned_mesh/constants.h>"), cpp_name("NWB_SKINNED_MESH_SKINNING_MODE_DUAL_QUATERNION")]
extern const usize s_ShaderSkinnedMeshSkinningModeDualQuaternion;

[cpp_header("<impl/assets/graphics/skinned_mesh/constants.h>"), cpp_name("NWB_SKINNED_MESH_PUSH_CONSTANT_BYTE_SIZE")]
extern const usize s_ShaderSkinnedMeshPushConstantByteSize;

[cpp_header("<impl/assets/graphics/skinned_mesh/constants.h>"), cpp_name("NWB_SKINNED_MESH_PUSH_MESHLET_COUNT")]
extern const usize s_ShaderSkinnedMeshPushMeshletCount;

[cpp_header("<impl/assets/graphics/skinned_mesh/constants.h>"), cpp_name("NWB_SKINNED_MESH_PUSH_SKIN_COUNT")]
extern const usize s_ShaderSkinnedMeshPushSkinCount;

[cpp_header("<impl/assets/graphics/skinned_mesh/constants.h>"), cpp_name("NWB_SKINNED_MESH_PUSH_JOINT_COUNT")]
extern const usize s_ShaderSkinnedMeshPushJointCount;

[cpp_header("<impl/assets/graphics/skinned_mesh/constants.h>"), cpp_name("NWB_SKINNED_MESH_PUSH_SKINNING_MODE")]
extern const usize s_ShaderSkinnedMeshPushSkinningMode;

[cpp_header("<impl/assets/graphics/skinned_mesh/constants.h>"), cpp_name("NWB_SKINNED_MESH_PUSH_BINDLESS_RESOURCES_SLOT")]
extern const usize s_ShaderSkinnedMeshPushBindlessResourcesSlot;

[cpp_header("<impl/assets/graphics/skinned_mesh/constants.h>"), cpp_name("NWB_SKINNED_MESH_BOUNDS_PUSH_CONSTANT_BYTE_SIZE")]
extern const usize s_ShaderSkinnedMeshBoundsPushConstantByteSize;

[cpp_header("<impl/assets/graphics/skinned_mesh/constants.h>"), cpp_name("NWB_SKINNED_MESH_BOUNDS_PUSH_MESHLET_COUNT")]
extern const usize s_ShaderSkinnedMeshBoundsPushMeshletCount;

[cpp_header("<impl/assets/graphics/skinned_mesh/constants.h>"), cpp_name("NWB_SKINNED_MESH_BOUNDS_PUSH_BINDLESS_RESOURCES_SLOT")]
extern const usize s_ShaderSkinnedMeshBoundsPushBindlessResourcesSlot;

[cpp_header("<impl/assets/graphics/skinned_mesh/constants.h>"), cpp_name("NWB_SKINNED_MESH_REPACK_PUSH_CONSTANT_BYTE_SIZE")]
extern const usize s_ShaderSkinnedMeshRepackPushConstantByteSize;

[cpp_header("<impl/assets/graphics/skinned_mesh/constants.h>"), cpp_name("NWB_SKINNED_MESH_REPACK_PUSH_MESHLET_COUNT")]
extern const usize s_ShaderSkinnedMeshRepackPushMeshletCount;

[cpp_header("<impl/assets/graphics/skinned_mesh/constants.h>"), cpp_name("NWB_SKINNED_MESH_REPACK_PUSH_BINDLESS_RESOURCES_SLOT")]
extern const usize s_ShaderSkinnedMeshRepackPushBindlessResourcesSlot;

static_assert(SkeletonSkinningMode::LinearBlend == s_ShaderSkinnedMeshSkinningModeLinearBlend && SkeletonSkinningMode::DualQuaternion == s_ShaderSkinnedMeshSkinningModeDualQuaternion, "Skeleton skinning mode values must match the shader ABI");
static_assert(s_RuntimeRequiredStorageDescriptorCount == cast<usize>(RuntimeStorageDescriptorSlot::SkinInfluences), "Runtime required storage descriptor count must match slot enum");
static_assert(s_RuntimeStorageDescriptorCount == cast<usize>(RuntimeStorageDescriptorSlot::kCount), "Runtime storage descriptor count must match slot enum");
static_assert(size_of<MeshSkinningBindlessResourceSlots>() == size_of<u32>() * 20u, "MeshSkinning bindless resource slots must stay five uint4 lanes");
static_assert(size_of<MeshSkinningGraphDispatchPlan>() == s_MeshSkinningGraphDispatchPlanByteSize, "Graph-owned skinning plans should stay compact");

static_assert(size_of<MeshSkinningPushConstants>() == s_ShaderSkinnedMeshPushConstantByteSize, "MeshSkinning push constants layout must match the shader ABI");
static_assert(offset_of<MeshSkinningPushConstants>(meshletCount) == size_of<u32>() * s_ShaderSkinnedMeshPushMeshletCount, "MeshSkinning meshlet-count push offset drifted");
static_assert(offset_of<MeshSkinningPushConstants>(skinCount) == size_of<u32>() * s_ShaderSkinnedMeshPushSkinCount, "MeshSkinning skin-count push offset drifted");
static_assert(offset_of<MeshSkinningPushConstants>(jointCount) == size_of<u32>() * s_ShaderSkinnedMeshPushJointCount, "MeshSkinning joint-count push offset drifted");
static_assert(offset_of<MeshSkinningPushConstants>(skinningMode) == size_of<u32>() * s_ShaderSkinnedMeshPushSkinningMode, "MeshSkinning skinning-mode push offset drifted");
static_assert(offset_of<MeshSkinningPushConstants>(bindlessResourceSlots) == size_of<u32>() * s_ShaderSkinnedMeshPushBindlessResourcesSlot, "MeshSkinning bindless-resource slot push offset drifted");

static_assert(size_of<MeshletBoundsPushConstants>() == s_ShaderSkinnedMeshBoundsPushConstantByteSize, "MeshSkinning bounds push constants layout must match the shader ABI");
static_assert(offset_of<MeshletBoundsPushConstants>(meshletCount) == size_of<u32>() * s_ShaderSkinnedMeshBoundsPushMeshletCount, "MeshSkinning bounds meshlet-count push offset drifted");
static_assert(offset_of<MeshletBoundsPushConstants>(bindlessResourceSlots) == size_of<u32>() * s_ShaderSkinnedMeshBoundsPushBindlessResourcesSlot, "MeshSkinning bounds bindless-resource slot push offset drifted");

static_assert(size_of<MeshletBoundsPushConstants>() == s_ShaderSkinnedMeshRepackPushConstantByteSize, "MeshSkinning repack push constants layout must match the shader ABI");
static_assert(offset_of<MeshletBoundsPushConstants>(meshletCount) == size_of<u32>() * s_ShaderSkinnedMeshRepackPushMeshletCount, "MeshSkinning repack meshlet-count push offset drifted");
static_assert(offset_of<MeshletBoundsPushConstants>(bindlessResourceSlots) == size_of<u32>() * s_ShaderSkinnedMeshRepackPushBindlessResourcesSlot, "MeshSkinning repack bindless-resource slot push offset drifted");


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> SkinningShaderPass{
    Deformation,
    MeshletBounds,
    LocalBounds,
    RepackNormals
}

AssetRef<ComputeShader> ResolveSkinningPassShader(in SkinningSubsystem subsystem, in SkinningShaderPass pass){
    switch(pass){
    case SkinningShaderPass::Deformation: return subsystem.skinningCs;
    case SkinningShaderPass::MeshletBounds: return subsystem.meshletBoundsCs;
    case SkinningShaderPass::LocalBounds: return subsystem.localBoundsCs;
    case SkinningShaderPass::RepackNormals: return subsystem.repackNormalsCs;
    }
    return AssetRef<ComputeShader>();
}

b8 EnsureSkinningComputePipeline(
    mut GraphicsRuntime graphics,
    in AssetManager assets,
    mut ShaderArchivePathResolver resolver,
    in ActiveSceneSubsystemsRef active,
    in SkinningShaderPass pass,
    in Name debugName,
    in BindingLayoutHandle layout,
    in StringView label,
    mut ShaderHandle shader,
    mut ComputePipelineHandle pipeline
){
    if(!active.has_value())
        return false;
    const auto subsystem = active.value().findSubsystem<SkinningSubsystem>();
    if(!subsystem.has_value())
        return false;
    const auto ref = ResolveSkinningPassShader(subsystem.value(), pass);
    if(!ref.valid() || !Load<ComputeShader, ShaderArchivePathResolver>(ref.name(), s_DefaultVariant, debugName, "MeshSkinningSystem", graphics, assets, resolver, Optional<Name>(), shader))
        return false;
    return EnsureLoadedComputePipeline(shader, layout, label, graphics, pipeline);
}

b8 EnsureSkinningPushConstantPipeline<T>(
    mut GraphicsRuntime graphics,
    in AssetManager assets,
    mut ShaderArchivePathResolver resolver,
    in ActiveSceneSubsystemsRef active,
    in SkinningShaderPass pass,
    in Name debugName,
    in StringView requirement,
    in StringView label,
    mut BindingLayoutHandle layout,
    mut ShaderHandle shader,
    mut ComputePipelineHandle pipeline
){
    mut Device device = graphics.getDevice();
    if(!device.getDescriptorHeap().isInitialized()){
        LogSkinningDescriptorHeapRequired(requirement);
        return false;
    }
    if(!EnsurePushConstantBindingLayout(size_of<T>(), label, device, layout))
        return false;
    return EnsureSkinningComputePipeline(graphics, assets, resolver, active, pass, debugName, layout, label, shader, pipeline);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void MeshSkinningSystem::prepare(mut World world){
    this.m_runtimeSetupReady = false;
    if(!this.ensureActiveSceneSubsystems())
        return;
    if(!this.isSkinningFeatureEnabled()){
        this.m_runtimeSetupReady = true;
        return;
    }
    if(!this.m_skinningComputePipeline.valid() || !this.m_boundsComputePipeline.valid() || !this.m_localBoundsComputePipeline.valid() || !this.m_repackComputePipeline.valid())
        return;
    this.m_runtimeMeshCache.prepareResources(this.m_world);
    this.pruneRuntimeResources();
    for(in auto row : this.m_world.view<SkinnedMeshBindingComponent>()){
        const auto instance = this.m_runtimeMeshCache.editInstance(Get<1>(row).runtimeMesh);
        if(instance.has_value()){
            assert(instance.value().valid());
            if(!this.prepareRuntimeMeshResources(instance.value()))
                return;
        }
    }
    this.m_runtimeSetupReady = true;
}

b8 MeshSkinningSystem::prepareResources(in FramebufferPtr framebuffer){
    const auto previous = this.m_acceptedSkinningState.borrowSource();
    if(previous.has_value() && !this.replaceAcceptedSkinningState(previous.value())){
        error("MeshSkinningSystem: failed to prune the accepted skinning state handoff");
        return false;
    }
    return this.m_runtimeSetupReady;
}

void MeshSkinningSystem::invalidateResources(){
    this.m_runtimeSetupReady = false;
    this.resetFrameTaskGraph();
    [essential] assert(this.m_frameRecordedGraph.releaseCommandListCache(), "skinning invalidation requires joined graph recording before device-bound cache release");
    this.m_acceptedSkinningState.reset();
    for(auto it = this.m_runtimeResources.begin(); it != this.m_runtimeResources.end(); ++it)
        this.releaseRuntimeResourceBindlessHeapHandles(it.value());
    this.m_runtimeResources.clear();
    this.m_runtimeMeshCache.clear();
    this.resetPipelineResources();
}

Expected<RuntimeMeshDesc> MeshSkinningSystem::resolveRuntimeMesh(in EntityID entity){
    if(!this.m_world.hasComponent<SkinnedMeshBindingComponent>(entity))
        return MakeUnexpected(Failure());
    const RuntimeMeshHandle handle = this.m_world.getComponent<SkinnedMeshBindingComponent>(entity).runtimeMesh;
    const auto instance = this.m_runtimeMeshCache.findInstance(handle);
    if(!instance.has_value())
        return MakeUnexpected(Failure());
    return BuildSkinnedRuntimeMeshDesc(entity, handle, instance.value(), s_RuntimeSkinningMeshletFrustumCullingEnabled, s_RuntimeSkinningMeshletConeCullingEnabled);
}

void MeshSkinningSystem::markLiveRuntimeMeshes(mut RuntimeMeshRequestSet requests){
    for(in auto row : this.m_world.view<SkinnedMeshBindingComponent>()){
        if(requests.complete())
            return;
        const RuntimeMeshHandle handle = Get<1>(row).runtimeMesh;
        const auto instance = this.m_runtimeMeshCache.findInstance(handle);
        if(instance.has_value()){
            const auto identity = ResolveSkinnedRuntimeMeshIdentity(Get<0>(row), handle, instance.value());
            if(identity.has_value())
                requests.markLive(identity.value().meshKey, identity.value().version);
        }
    }
}

b8 MeshSkinningSystem::isSkinningFeatureEnabled()const{
    return this.m_activeSceneSubsystems.has_value() && this.m_activeSceneSubsystems.value().hasSubsystem<SkinningSubsystem>();
}

b8 MeshSkinningSystem::ensureActiveSceneSubsystems(){
    if(this.m_activeSceneSubsystems.has_value())
        return true;
    if(!this.m_defaultSceneSubsystems.loadProjectStartScene(this.m_assetManager))
        return false;
    this.m_activeSceneSubsystems = ActiveSceneSubsystemsRef(this.m_defaultSceneSubsystems);
    return true;
}

b8 MeshSkinningSystem::ensureSkinningPipeline(){
    return EnsureSkinningPushConstantPipeline<MeshSkinningPushConstants>(
        this.m_graphics,
        this.m_assetManager,
        this.m_shaderPathResolver,
        this.m_activeSceneSubsystems,
        SkinningShaderPass::Deformation,
        s_SkinningComputeShaderName,
        "skinning",
        "skinning",
        this.m_skinningBindingLayout,
        this.m_skinningComputeShader,
        this.m_skinningComputePipeline
    );
}

b8 MeshSkinningSystem::ensureBoundsPipeline(){
    return EnsureSkinningPushConstantPipeline<MeshletBoundsPushConstants>(
        this.m_graphics,
        this.m_assetManager,
        this.m_shaderPathResolver,
        this.m_activeSceneSubsystems,
        SkinningShaderPass::MeshletBounds,
        s_MeshletBoundsComputeShaderName,
        "meshlet-bounds",
        "bounds",
        this.m_boundsBindingLayout,
        this.m_boundsComputeShader,
        this.m_boundsComputePipeline
    );
}

b8 MeshSkinningSystem::ensureLocalBoundsPipeline(){
    if(this.m_localBoundsComputePipeline.valid())
        return true;
    if(!this.ensureBoundsPipeline())
        return false;
    return EnsureSkinningComputePipeline(
        this.m_graphics,
        this.m_assetManager,
        this.m_shaderPathResolver,
        this.m_activeSceneSubsystems,
        SkinningShaderPass::LocalBounds,
        s_LocalBoundsComputeShaderName,
        this.m_boundsBindingLayout,
        "local bounds",
        this.m_localBoundsComputeShader,
        this.m_localBoundsComputePipeline
    );
}

b8 MeshSkinningSystem::ensureRepackPipeline(){
    return EnsureSkinningPushConstantPipeline<MeshletBoundsPushConstants>(
        this.m_graphics,
        this.m_assetManager,
        this.m_shaderPathResolver,
        this.m_activeSceneSubsystems,
        SkinningShaderPass::RepackNormals,
        s_RepackNormalsComputeShaderName,
        "normal-repack",
        "repack",
        this.m_repackBindingLayout,
        this.m_repackComputeShader,
        this.m_repackComputePipeline
    );
}

void MeshSkinningSystem::collectLiveSkinningStateBuffers(){
    this.m_frameLiveBuffers.clear();
    HashSet<BufferHandle> index;
    for(in auto row : this.m_world.view<SkinnedMeshBindingComponent>()){
        const RuntimeMeshHandle handle = Get<1>(row).runtimeMesh;
        const auto instance = this.m_runtimeMeshCache.findInstance(handle);
        if(!instance.has_value())
            continue;
        Optional<in MeshSkinningRuntimeResources> resources;
        if(this.m_runtimeResources.contains(handle.value)){
            in MeshSkinningRuntimeResources retained = this.m_runtimeResources.at(handle.value);
            resources = Optional<in MeshSkinningRuntimeResources>(retained);
        }
        CollectSkinningStateBuffers(instance.value(), resources, this.m_frameLiveBuffers, index);
    }
}

b8 MeshSkinningSystem::replaceAcceptedSkinningState(in CommandListResourceStateHandoff state){
    this.collectLiveSkinningStateBuffers();
    const b8 replaced = this.m_acceptedSkinningState.replaceBufferSubset(state, Span<BufferHandle>(this.m_frameLiveBuffers));
    this.m_frameLiveBuffers.clear();
    return replaced;
}

void MeshSkinningSystem::pruneRuntimeResources(){
    auto it = this.m_runtimeResources.begin();
    while(it != this.m_runtimeResources.end()){
        mut MeshSkinningRuntimeResources resources = it.value();
        const auto instance = this.m_runtimeMeshCache.findInstance(resources.handle);
        if(instance.has_value() && CanRetainPreparedRuntimeResources(instance.value().valid(), instance.value().editRevision, resources.editRevision)){
            ++it;
            continue;
        }
        this.releaseRuntimeResourceBindlessHeapHandles(resources);
        it = this.m_runtimeResources.erase(it);
    }
}


