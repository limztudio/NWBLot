const f32 s_EcsUiViewportWidth = 500.0f;
const f32 s_EcsUiViewportHeight = 200.0f;
const usize s_EcsUiInputMaxEvents = 256u;


class FakeTextInput : QueuedTextInputService{
    [cpp_base(QueuedTextInputService, storage)]
    public FakeTextInput(mut HeapStorage storage){}

    public u32 starts = 0u;
    public u32 ends = 0u;

    public TextInputCapabilities capabilities()const override{ return FullTestTextInputCapabilities(); }

    public TextInputAdmission sendCommit(in TextInputSessionToken token, in StringView text){ return this.emitCommit(token, text); }
    public TextInputRect currentCaret()const{ return this.caretRect(); }
    public StringView surrounding()const{ return this.surroundingText(); }
    public TextInputAdmission commit(in StringView text){ return this.emitCommit(this.activeSession(), text); }
    public TextInputAdmission preedit(in StringView text){ return this.preedit(text, 0u, text.size(), true); }
    public TextInputAdmission preedit(in StringView text, in usize anchor, in usize caret){ return this.preedit(text, anchor, caret, true); }
    public TextInputAdmission preedit(in StringView text, in usize anchor, in usize caret, in b8 visible){
        return this.emitPreedit(this.activeSession(), text, anchor, caret, visible);
    }
    public TextInputAdmission preedit(in StringView text, in usize anchor, in usize caret, in b8 visible, in Span<TextInputPreeditClause> clauses){
        return this.emitPreedit(this.activeSession(), text, anchor, caret, visible, clauses);
    }
    public TextInputAdmission erase(in usize before, in usize after, in u64 revision, in TextInputDeletionBasis basis){
        return this.emitDeleteSurrounding(this.activeSession(), before, after, revision, basis);
    }
    public TextInputAdmission startNativeSession(in TextInputSessionToken token, in TextInputSessionDesc description)override{
        ++this.starts;
        return TextInputAdmission::Accepted;
    }
    public void endNativeSession(in TextInputSessionToken token)override{ ++this.ends; }
}

class FakeClipboard : QueuedClipboardService{
    [cpp_base(QueuedClipboardService, storage)]
    public FakeClipboard(mut HeapStorage storage){ this.delayed = false; }
    [cpp_base(QueuedClipboardService, storage)]
    public FakeClipboard(mut HeapStorage storage, in b8 delayed){ this.delayed = delayed; }

    public String document;
    public String startedText;
    public ClipboardRequestToken startedToken;
    public ClipboardOperation startedOperation = ClipboardOperation::ReadText;
    public b8 delayed;

    public ClipboardCapabilities capabilities(in ClipboardChannel channel)const override{ return TestClipboardTextCapabilities(channel); }
    public b8 finishRequest(in ClipboardRequestToken token, in ClipboardStatus status, in StringView text){
        return this.completeNativeRequest(token, status, text);
    }
    public b8 deliver(in ClipboardRequestToken token, in ClipboardStatus status){ return this.deliver(token, status, ""); }
    public b8 deliver(in ClipboardRequestToken token, in ClipboardStatus status, in StringView text){
        return DeliverEcsUiFakeClipboard(this, token, status, text);
    }
    public b8 complete(in ClipboardRequestToken token, in StringView text){
        return this.finishRequest(token, ClipboardStatus::Success, text);
    }
    public void startNativeRequest(in ClipboardRequestToken token, in ClipboardOperation operation, in ClipboardChannel channel, in StringView text)override{
        StartEcsUiFakeClipboardRequest(this, token, operation, text);
    }
}

class FakeCursor : TrackedCursorService{
    [cpp_base(TrackedCursorService, storage)]
    public FakeCursor(mut HeapStorage storage){}

    public Array<CursorShape, 64u> history;
    public u32 historyCount = 0u;
    public b8 rejectApply = false;

    public CursorCapabilities capabilities()const override{
        CursorCapabilities caps;
        caps.setShape = true;
        caps.hide = true;
        caps.backend = CursorBackend::Win32;
        return caps;
    }

    public b8 applyNativeCursor(in CursorShape shape)override{
        if(this.rejectApply)
            return false;
        if(this.historyCount < 64u)
            this.history[this.historyCount] = shape;
        ++this.historyCount;
        return true;
    }
}

class FakeAccessibility : TrackedAccessibilityService{
    [cpp_base(TrackedAccessibilityService, storage)]
    public FakeAccessibility(mut HeapStorage storage){}

    public u64 lastVersion = 0u;
    public u64 lastFocusedId = 0u;
    public usize lastNodeCount = 0u;
    public f32 lastScaleX = 0.0f;
    public f32 lastScaleY = 0.0f;
    public Vector<AccessibilityNodeData> publishedNodes;
    public String publishedText;
    public Vector<String> announcements;

    public AccessibilityCapabilities capabilities()const override{
        AccessibilityCapabilities caps;
        caps.tree = true;
        caps.announcements = true;
        caps.actions = true;
        caps.backend = AccessibilityBackend::Win32Uia;
        return caps;
    }

    public b8 pushAction(in u64 targetId, in AccessibilityActionKind kind, in f64 numericValue){
        AccessibilityActionEvent ev;
        ev.targetId = targetId;
        ev.kind = kind;
        ev.numericValue = numericValue;
        return this.enqueueAction(ev);
    }

    [cpp_unwind]
    public void onTreePublished(in Span<AccessibilityNodeData> nodes, in StringView textStorage, in u64 focusedId, in u64 version, in f32 scaleX, in f32 scaleY)override{
        RecordEcsUiFakeA11yTree(this, nodes, textStorage, focusedId, version, scaleX, scaleY);
    }

    [cpp_unwind]
    public void onAnnouncement(in StringView text, in AccessibilityLiveMode politeness)override{
        RecordEcsUiFakeA11yAnnouncement(this, text, politeness);
    }
}

class UiEditBoxHostTests{
    public HeapStorage storage(Name(s_EcsUiEditBoxHost));
    public Context m_context;
    public FakeTextInput m_textInput;
    public FakeClipboard m_clipboard;
    public UiEditBoxHost m_host;
    public EditModel m_model;
    public FixtureShaper m_shaper;
    public TextLayoutBuilder m_layoutBuilder;
    public WidgetState m_widget;
    public EditBoxPlacement m_placement;
    public WidgetState m_otherWidget;
    public u64 m_generation = 0u;
    public EditBoxResult m_result;
    public b8 m_includeButton = false;

    public UiEditBoxHostTests(){
        this.m_textInput = FakeTextInput(this.storage);
        this.m_clipboard = FakeClipboard(this.storage);
        this.m_host = UiEditBoxHost(this.m_context, this.m_textInput, this.m_clipboard);
        this.m_layoutBuilder = TextLayoutBuilder(this.m_shaper);
    }

    public void setup(){ ASSERT_TRUE(this.m_textInput.setFocused(true)); }
    public b8 prepare(mut EditModel model){ return this.prepare(model, EditBoxOptions()); }
    public b8 prepare(mut EditModel model, in EditBoxOptions options){ return this.prepare(model, options, MakeEcsUiRect(10.0f, 20.0f, 180.0f, 30.0f)); }
    public b8 prepare(mut EditModel model, in EditBoxOptions options, in Rect bounds){ return PrepareEcsUiEditBoxFrame(this, model, options, bounds); }
    public b8 commit(){ return CommitEcsUiEditFrame(this); }
    public b8 frame(mut EditModel model){ return this.frame(model, EditBoxOptions()); }
    public b8 frame(mut EditModel model, in EditBoxOptions options){ return this.prepare(model, options) && this.commit(); }

    public Point atByte(in usize byte)const{
        return MakeEcsUiPoint(cast<f32>(byte) * 10.0f + this.m_placement.textOrigin.x + 1.0f, this.m_placement.textOrigin.y + 5.0f);
    }
    public b8 dispatch(in InputEvent event){ return DispatchEcsUiEditEvent(this, event); }
    public b8 dispatchPointer(in PointerInput input){ return DispatchEcsUiEditPointer(this, input); }
    public b8 dispatchType(in InputEventType type){
        InputEvent event();
        event.type = type;
        return this.dispatch(event);
    }
    public b8 dispatchPoint(in Point position, in InputEventType type){ return this.dispatchPoint(position, type, false); }
    public b8 dispatchPoint(in Point position, in InputEventType type, in b8 shift){
        InputEvent event();
        event.position = position;
        event.type = type;
        event.shift = shift;
        return this.dispatch(event);
    }
    public b8 key(in Key value){ return this.key(value, false, false); }
    public b8 key(in Key value, in b8 shift){ return this.key(value, shift, false); }
    public b8 key(in Key value, in b8 shift, in b8 control){
        InputEvent event();
        event.key = value;
        event.type = InputEventType::KeyDown;
        event.shift = shift;
        event.control = control;
        if(!this.dispatch(event))
            return false;
        event.type = InputEventType::KeyUp;
        return this.dispatch(event);
    }
    public b8 activate(){
        return this.frame(this.m_model) && this.key(Key::Tab) && this.frame(this.m_model) && this.m_textInput.activeSession().valid();
    }
    public b8 emptyFrame(){ return EmptyEcsUiEditFrame(this); }
}

class ActionRecord{
    public String text;
    public EditAction action = EditAction::Submit;
}

class RecordingActions : IEditActionSink{
    public String committed;
    public Vector<ActionRecord> records;
    public Optional<mut UiEditBoxHost> resetHost;
    public b8 canonicalizeSubmit = false;
    public b8 failSubmit = false;
    public b8 rejectBlur = false;

    public RecordingActions(){ this.committed.assign("0"); }
    public b8 apply(mut EditModel draft, in EditAction action, in b8 readOnly)override{ return ApplyEcsUiRecordingAction(this, draft, action, readOnly); }
    public void resetIfConfigured(){ if(this.resetHost.has_value()) this.resetHost.value().reset(); }
    public void clear(){ this.records.clear(); }
}

class UiEditActionHostTests{
    public UiEditBoxHostTests core;
    public RecordingActions m_actions;

    public void setup(){ this.core.setup(); this.core.m_includeButton = true; }
    public b8 actionFrame(){ return this.actionFrame(EditBoxOptions()); }
    public b8 actionFrame(in EditBoxOptions options){
        return PrepareEcsUiEditActionsFrame(this.core, this.core.m_model, options, MakeEcsUiRect(10.0f, 20.0f, 180.0f, 30.0f), this.m_actions) && this.core.commit();
    }
    public b8 activateActions(){ return ActivateEcsUiEditActions(this); }
    public b8 commitNative(in StringView text){ return this.core.m_textInput.commit(text) == TextInputAdmission::Accepted; }
    public b8 replaceNative(in StringView text){ return this.core.key(Key::A, false, true) && this.commitNative(text); }
    public b8 focusOther(){ return this.core.key(Key::Tab) && this.core.m_context.input().focus() == this.core.m_otherWidget.id; }
    public b8 focusEditor(){ return this.core.key(Key::Tab) && this.core.m_context.input().focus() == this.core.m_widget.id; }
    public usize actionCount(in EditAction action)const{ return CountEcsUiRecordedActions(this, action); }
    public void enableHostResetOnSubmit(){ this.m_actions.resetHost = Optional<mut UiEditBoxHost>(this.core.m_host); }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Rect MakeEcsUiRect(in f32 x, in f32 y, in f32 width, in f32 height){
    Rect rect = Rect();
    rect.x = x;
    rect.y = y;
    rect.width = width;
    rect.height = height;
    return rect;
}

Point MakeEcsUiPoint(in f32 x, in f32 y){
    Point point = Point();
    point.x = x;
    point.y = y;
    return point;
}

InputSource MakeEcsUiInputSource(in u32 device, in u32 control){
    InputSource source = InputSource();
    source.device = device;
    source.control = control;
    return source;
}

b8 DeliverEcsUiFakeClipboard(mut FakeClipboard self, in ClipboardRequestToken token, in ClipboardStatus status, in StringView text){
    if(!self.finishRequest(token, status, text)){
        return false;
    }
    if(status == ClipboardStatus::Success && self.startedOperation == ClipboardOperation::WriteText && token == self.startedToken){
        self.document = self.startedText;
    }
    return true;
}

void StartEcsUiFakeClipboardRequest(mut FakeClipboard self, in ClipboardRequestToken token, in ClipboardOperation operation, in StringView text){
    self.startedToken = token;
    self.startedOperation = operation;
    self.startedText.assign(text.data(), text.size());
    StringView payload = StringView();
    if(operation == ClipboardOperation::ReadText){
        payload = StringView(self.document);
    }
    if(!self.delayed && !DeliverEcsUiFakeClipboard(self, token, ClipboardStatus::Success, payload)){
        EXPECT_TRUE(false);
    }
}

[cpp_unwind]
void RecordEcsUiFakeA11yTree(mut FakeAccessibility self, in Span<AccessibilityNodeData> nodes, in StringView textStorage, in u64 focusedId, in u64 version, in f32 scaleX, in f32 scaleY){
    self.lastVersion = version;
    self.lastFocusedId = focusedId;
    self.lastNodeCount = nodes.size();
    self.lastScaleX = scaleX;
    self.lastScaleY = scaleY;
    self.publishedNodes.clear();
    for(usize index = 0u; index < nodes.size(); ++index)
        self.publishedNodes.push_back(nodes[index]);
    self.publishedText.assign(textStorage);
}

[cpp_unwind]
void RecordEcsUiFakeA11yAnnouncement(mut FakeAccessibility self, in StringView text, in AccessibilityLiveMode politeness){
    String msg;
    msg.assign(text);
    self.announcements.push_back(msg);
}

b8 PrepareEcsUiEditView(in EditModel model, mut TextLayoutBuilder layoutBuilder, mut EditBoxView view){
    if(!view.snapshot(model)){
        return false;
    }
    ShapeRequest desc = ShapeRequest();
    desc.text = view.displayText();
    auto layout = layoutBuilder.layout(desc);
    return layout.has_value() && view.adoptLayout(layout.value());
}

b8 BeginEcsUiRootFrame(mut UiEditBoxHostTests self){
    ++self.m_generation;
    if(!self.m_context.beginFrame(self.m_generation)){
        return false;
    }
    DisplayMetrics metrics = DisplayMetrics();
    metrics.logicalWidth = s_EcsUiViewportWidth;
    metrics.logicalHeight = s_EcsUiViewportHeight;
    metrics.pixelScaleX = 1.0f;
    metrics.pixelScaleY = 1.0f;
    self.m_host.beginFrame(self.m_generation, metrics);
    WidgetRoot rootSurface = WidgetRoot();
    rootSurface.value = 17u;
    rootSurface.generation = 1u;
    return self.m_context.beginRoot(rootSurface);
}

b8 BeginEcsUiEditFrame(mut UiEditBoxHostTests self){
    if(!BeginEcsUiRootFrame(self))
        return false;
    const auto declared = self.m_context.declare("edit", WidgetKind::EditBox);
    if(!declared.has_value())
        return false;
    self.m_widget = declared.value();
    return true;
}

b8 PublishEcsUiEditBox(mut UiEditBoxHostTests self, mut EditModel model, in EditBoxOptions options, in Rect bounds, in Point previousScroll){
    EditBoxView view = EditBoxView();
    if(!PrepareEcsUiEditView(model, self.m_layoutBuilder, view)){
        return false;
    }
    const Rect viewport = MakeEcsUiRect(0.0f, 0.0f, s_EcsUiViewportWidth, s_EcsUiViewportHeight);
    const auto placement = view.arrange(bounds, Insets(), viewport, previousScroll);
    if(!placement){
        return false;
    }
    self.m_placement = placement.value();
    if(!self.m_host.publish(self.m_widget, view, self.m_placement, options)){
        return false;
    }
    HitTarget target = HitTarget();
    target.rectangle = bounds;
    target.clip = viewport;
    target.enabled = options.enabled;
    target.focusable = options.enabled;
    target.pointerGesture = options.enabled;
    target.textEditable = true;
    target.acceptTab = options.acceptTab;
    return self.m_context.addTarget(self.m_widget, target);
}

b8 FinishEcsUiEditBoxPrepare(mut UiEditBoxHostTests self, mut EditModel model, in EditBoxOptions options, in Rect bounds){
    if(!self.m_result.valid || !PublishEcsUiEditBox(self, model, options, bounds, Point())){
        return false;
    }
    if(self.m_includeButton){
        const auto declaredOther = self.m_context.declare("other", WidgetKind::Button);
        if(!declaredOther.has_value()){
            return false;
        }
        self.m_otherWidget = declaredOther.value();
        HitTarget other = HitTarget();
        other.rectangle = MakeEcsUiRect(230.0f, 20.0f, 100.0f, 30.0f);
        other.clip = MakeEcsUiRect(0.0f, 0.0f, s_EcsUiViewportWidth, s_EcsUiViewportHeight);
        other.focusable = true;
        other.activatable = true;
        if(!self.m_context.addTarget(self.m_otherWidget, other)){
            return false;
        }
    }
    if(!self.m_context.endRoot() || !self.m_context.finishFrame()){
        return false;
    }
    self.m_host.finishFrame();
    return true;
}

b8 PrepareEcsUiEditBoxFrame(mut UiEditBoxHostTests self, mut EditModel model, in EditBoxOptions options, in Rect bounds){
    if(!BeginEcsUiEditFrame(self)){
        return false;
    }
    self.m_result = self.m_host.edit(self.m_widget, options, model);
    return FinishEcsUiEditBoxPrepare(self, model, options, bounds);
}

b8 PrepareEcsUiEditActionsFrame(mut UiEditBoxHostTests self, mut EditModel model, in EditBoxOptions options, in Rect bounds, mut IEditActionSink actions){
    if(!BeginEcsUiEditFrame(self)){
        return false;
    }
    self.m_result = self.m_host.editActions(self.m_widget, options, PopupToken(), model, actions);
    return FinishEcsUiEditBoxPrepare(self, model, options, bounds);
}

b8 CommitEcsUiEditFrame(mut UiEditBoxHostTests self){
    if(!self.m_context.commitFrame(self.m_generation)){
        return false;
    }
    self.m_host.commitFrame(self.m_generation);
    return true;
}

b8 DispatchEcsUiEditEvent(mut UiEditBoxHostTests self, in InputEvent event){
    self.m_host.collectNative();
    const WidgetId previousCapture = self.m_context.input().capture();
    const auto normalized = self.m_context.input().queue(NativeInput(event));
    if(!normalized){
        return false;
    }
    const b8 submit = self.m_host.prepareSubmit(normalized.value());
    const InputRoutingResult result = self.m_context.input().process();
    self.m_host.input(normalized.value(), previousCapture, submit);
    return !result.activationOverflow && !result.gestureOverflow;
}

b8 DispatchEcsUiEditPointer(mut UiEditBoxHostTests self, in PointerInput input){
    self.m_host.collectNative();
    const WidgetId previousCapture = self.m_context.input().capture();
    const auto normalized = self.m_context.input().queuePointer(input);
    if(!normalized){
        return false;
    }
    const InputRoutingResult result = self.m_context.input().process();
    if(result.pointerRouted){
        self.m_host.input(normalized.value(), previousCapture, false);
    }
    return !result.activationOverflow && !result.gestureOverflow;
}

b8 EmptyEcsUiEditFrame(mut UiEditBoxHostTests self){
    if(!BeginEcsUiRootFrame(self) || !self.m_context.endRoot() || !self.m_context.finishFrame()){
        return false;
    }
    self.m_host.finishFrame();
    return CommitEcsUiEditFrame(self);
}

b8 ApplyEcsUiRecordingAction(mut RecordingActions self, mut EditModel draft, in EditAction action, in b8 readOnly){
    ActionRecord record = ActionRecord();
    record.action = action;
    record.text.assign(draft.text().data(), draft.text().size());
    self.records.push_back(record);
    if(self.failSubmit && action == EditAction::Submit){
        return false;
    }
    if(action == EditAction::Submit){
        self.resetIfConfigured();
        if(readOnly){
            return true;
        }
        self.committed.assign(draft.text().data(), draft.text().size());
        return !self.canonicalizeSubmit || draft.setText(StringView(self.committed));
    }
    if(action == EditAction::Blur && !readOnly && !self.rejectBlur){
        self.committed.assign(draft.text().data(), draft.text().size());
    }
    return draft.setText(StringView(self.committed));
}

b8 ActivateEcsUiEditActions(mut UiEditActionHostTests self){
    if(!self.actionFrame() || !self.core.key(Key::Tab) || !self.actionFrame() || !self.core.m_textInput.activeSession().valid()){
        return false;
    }
    self.m_actions.clear();
    return true;
}

usize CountEcsUiRecordedActions(in UiEditActionHostTests self, in EditAction action){
    usize count = 0u;
    for(usize i = 0u; i < self.m_actions.records.size(); ++i){
        if(self.m_actions.records[i].action == action){
            ++count;
        }
    }
    return count;
}


