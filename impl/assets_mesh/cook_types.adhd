#include <impl/assets_mesh/cook_metadata_value.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateSourceStreamIndexWithContext(in StringView context, in StringView streamName, in u32 index, in usize streamCount){
    if(cast<usize>(index) < streamCount)
        return true;

    error("{}: vertex_ref {} index is out of range", context, streamName);
    return false;
}

b8 IsAllowedSkinMetadataField(in StringView fieldName){
    return
        fieldName == s_SkinMetaMeshField
        || fieldName == s_SkinMetaSkeletonField
        || fieldName == s_SkinInfluencesField
        || fieldName == s_SkinInverseBindMatricesField
    ;
}

b8 IsAllowedMeshAssetField(in StringView fieldName){
    return
        fieldName == s_MeshPositionsFieldNameView
        || fieldName == s_MeshNormalsFieldNameView
        || fieldName == s_MeshTangentsFieldNameView
        || fieldName == s_MeshUv0FieldNameView
        || fieldName == s_MeshColorsFieldNameView
        || fieldName == s_MeshVertexRefsFieldNameView
        || fieldName == s_MeshIndicesFieldNameView
    ;
}

b8 IsAllowedSkinInfluenceMetadataField(in StringView fieldName){
    return fieldName == s_SkinJointsField || fieldName == s_SkinWeightsField;
}

Expected<f32x4u, SkinInfluenceWeightFailure> TryNormalizeSkinInfluenceWeights(in f32x4u weights){
    const VectorSingle weightVec(weights);
    if(
        !IsFinite(weightVec)
        || weightVec.x < 0.0f
        || weightVec.y < 0.0f
        || weightVec.z < 0.0f
        || weightVec.w < 0.0f
    )
        return MakeUnexpected(SkinInfluenceWeightFailure::NegativeWeight);

    const f32 totalWeight = Dot(weightVec, VectorSingle(1.0f));
    if(!IsFinite(totalWeight) || !(totalWeight > s_SkinValidationEpsilon))
        return MakeUnexpected(SkinInfluenceWeightFailure::ZeroTotalWeight);

    const VectorSingle normalizedWeights = weightVec / VectorSingle(totalWeight);
    if(!ValidSkinInfluenceWeights(normalizedWeights))
        return MakeUnexpected(SkinInfluenceWeightFailure::InvalidNormalized);

    return f32x4u(normalizedWeights);
}

SourceIndexStreamFailure ValidateSourceIndexStreamValues(in Span<u32> indices, in usize vertexRefCount){
    if(indices.empty() || indices.size() % cast<usize>(s_MeshletTriangleIndexCount) != 0u)
        return SourceIndexStreamFailure::EmptyOrNotMultipleOfThree;

    for(in u32 index : indices){
        if(cast<usize>(index) >= vertexRefCount)
            return SourceIndexStreamFailure::IndexOutOfRange;
    }
    return SourceIndexStreamFailure::None;
}

void CopySourceMeshStreamsToCookStreams(
    in Span<f32x3u> sourcePositions,
    in Span<f32x3u> sourceNormals,
    in Span<f32x4u> sourceTangents,
    in Span<f32x2u> sourceUv0,
    in Span<f32x4u> sourceColors,
    in Span<MeshVertexRef> sourceVertexRefs,
    mut Vector<f32x3u> outPositions,
    mut Vector<f16x4u> outNormals,
    mut Vector<f16x4u> outTangents,
    mut Vector<f32x2u> outUv0,
    mut Vector<f16x4u> outColors,
    mut Vector<MeshVertexRef> outVertexRefs
){
    outPositions.clear();
    outNormals.clear();
    outTangents.clear();
    outUv0.clear();
    outColors.clear();
    outVertexRefs.clear();

    outPositions.reserve(sourcePositions.size());
    outNormals.reserve(sourceNormals.size());
    outTangents.reserve(sourceTangents.size());
    outUv0.reserve(sourceUv0.size());
    outColors.reserve(sourceColors.size());
    outVertexRefs.reserve(sourceVertexRefs.size());

    for(in f32x3u position : sourcePositions)
        outPositions.push_back(position);
    for(in f32x3u normal : sourceNormals)
        outNormals.push_back(MakeHalf4U(normal.x, normal.y, normal.z, 0.0f));
    for(in f32x4u tangent : sourceTangents)
        outTangents.push_back(MakeHalf4U(tangent.x, tangent.y, tangent.z, tangent.w));
    for(in f32x2u uv : sourceUv0)
        outUv0.push_back(uv);
    for(in f32x4u color : sourceColors)
        outColors.push_back(MakeHalf4U(color.x, color.y, color.z, color.w));
    for(in MeshVertexRef ref : sourceVertexRefs)
        outVertexRefs.push_back(ref);
}

String FormatMeshMetadataIndexedLabel(in StringView baseLabel, in usize index){
    return StringFormat("{}[{}]", baseLabel, index);
}

String FormatMeshVertexRefComponentLabel(in usize vertexRefIndex, in StringView componentName){
    return StringFormat("{}[{}].{}", s_MeshVertexRefsFieldNameView, vertexRefIndex, componentName);
}

StringView ResolveMetadataF32ValueFailureReason(in MetadataF32ValueFailure failure){
    if(failure == MetadataF32ValueFailure::NotNumeric)
        return "must contain only numeric values";
    if(failure == MetadataF32ValueFailure::NonFinite)
        return "must contain only finite numeric values";
    if(failure == MetadataF32ValueFailure::OutOfRange)
        return "contains a value outside the f32 range";
    return "";
}

StringView ResolveMetadataU32ValueFailureReason(in MetadataU32ValueFailure failure){
    if(failure == MetadataU32ValueFailure::NotNumeric)
        return "must contain only integer values";
    if(failure == MetadataU32ValueFailure::NonIntegerOrNegative)
        return "contains a non-integer or negative value";
    if(failure == MetadataU32ValueFailure::OutOfRange)
        return "contains a value that exceeds u32";
    return "";
}

StringView ResolveSourceIndexStreamFailureReason(in SourceIndexStreamFailure failure){
    if(failure == SourceIndexStreamFailure::EmptyOrNotMultipleOfThree)
        return "'indices' must contain whole triangles";
    if(failure == SourceIndexStreamFailure::IndexOutOfRange)
        return "'indices' references an out-of-range vertex_ref";
    return "";
}

StringView FindOutOfRangeVertexRefStreamName(
    in u32 positionIndex,
    in u32 normalIndex,
    in u32 tangentIndex,
    in u32 uv0Index,
    in u32 colorIndex,
    in usize positionCount,
    in usize normalCount,
    in usize tangentCount,
    in usize uv0Count,
    in usize colorCount
){
    if(cast<usize>(positionIndex) >= positionCount)
        return s_VertexRefPositionName;
    if(cast<usize>(normalIndex) >= normalCount)
        return s_VertexRefNormalName;
    if(cast<usize>(tangentIndex) >= tangentCount)
        return s_VertexRefTangentName;
    if(cast<usize>(uv0Index) >= uv0Count)
        return s_VertexRefUvName;
    if(cast<usize>(colorIndex) >= colorCount)
        return s_VertexRefColorName;
    return "";
}

Expected<u16> TryValidateSkinInfluenceJointIndex(in b8 isNumeric, in f64 numericValue){
    const Expected<u32, MetadataU32ValueFailure> parsedJoint = ValidateMetadataU32Number(isNumeric, numericValue);
    if(!parsedJoint.has_value() || parsedJoint.value() > cast<u32>(u16.max))
        return MakeUnexpected(Failure());
    return cast<u16>(parsedJoint.value());
}

StringView ResolveSkinInfluenceWeightFailureReason(in SkinInfluenceWeightFailure failure){
    if(failure == SkinInfluenceWeightFailure::NegativeWeight)
        return "must be finite and non-negative";
    if(failure == SkinInfluenceWeightFailure::ZeroTotalWeight)
        return "must contain a positive total";
    return "";
}


