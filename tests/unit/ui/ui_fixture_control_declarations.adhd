SliderOptions MakeSliderFixtureOptions(){
    SliderOptions settings = SliderOptions();
    settings.width.policy = LayoutSizePolicy::Fixed;
    settings.width.value = 280.0f;
    settings.keyStep = 0.125;
    return settings;
}

ListOptions MakeSliderSiblingListOptions(){
    ListOptions settings = ListOptions();
    settings.width.policy = LayoutSizePolicy::Fixed;
    settings.width.value = 280.0f;
    settings.height.policy = LayoutSizePolicy::Fixed;
    settings.height.value = 48.0f;
    return settings;
}

Point ComputeSliderTrackPoint(in SliderPlacement placement, in f64 normalized){
    Point point = Point();
    point.x = placement.centerTravel.x + (cast<f32>(normalized) * placement.centerTravel.width);
    point.y = placement.track.y + (placement.track.height * 0.5f);
    return point;
}

SearchComboOptions MakeSearchComboFixtureOptions(){
    SearchComboOptions value = SearchComboOptions();
    value.combo = MakeComboFixtureOptions();
    value.combo.popupHeight = 220.0f;
    return value;
}

u64 ComputeRadioFixtureRawCount(in u64 count, in u64 removed){
    if(removed != 0u)
        return count - 1u;
    return count;
}

u64 ComputeRadioFixtureRawKey(in u64 count, in u64 removed, in b8 reverse, in b8 duplicate, in u64 index){
    const u64 activeCount = ComputeRadioFixtureRawCount(count, removed);
    if(index >= activeCount)
        return 0u;
    if(duplicate)
        return 10u;
    u64 forward = index;
    if(reverse)
        forward = activeCount - 1u - index;
    const u64 value = (forward + 1u) * 10u;
    if(removed != 0u && value >= removed)
        return value + 10u;
    return value;
}

u64 ComputeSearchFilterRowCount(in UiFixtureSearchFilterMode mode, in u64 fullCount){
    if(mode == UiFixtureSearchFilterMode::Empty)
        return 0u;
    if(mode == UiFixtureSearchFilterMode::Second)
        return fullCount / 2u;
    return fullCount;
}

u64 ComputeSearchFilterRowKey(in UiFixtureSearchFilterMode mode, in u64 index){
    if(mode == UiFixtureSearchFilterMode::Second)
        return index * 2u + 2u;
    return index + 1u;
}

Expected<u64> FindSearchFilterRowIndex(in UiFixtureSearchFilterMode mode, in u64 fullCount, in u64 value){
    if(value == 0u || value > fullCount || mode == UiFixtureSearchFilterMode::Empty)
        return MakeUnexpected(Failure());
    if(mode == UiFixtureSearchFilterMode::Second){
        if(value % 2u != 0u)
            return MakeUnexpected(Failure());
        return value / 2u - 1u;
    }
    return value - 1u;
}


