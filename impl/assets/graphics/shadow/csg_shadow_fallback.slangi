#if NWB_LIGHT_SPACE_MAP_ONLY && (NWB_CSG_SHADOW_HW_TRACE || NWB_LIGHT_SPACE_OCCLUDER == NWB_SW_SHADOW_OCCLUDER_TRANSPARENT)
