////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[reflect]
enum<u8> TransparentShadowSampling{
    ReferenceThree,
    TemporalOne
}

[reflect]
enum<u8> ShadowReceiverResolution{
    Half = 2u,
    Quarter = 4u
}

const u32 s_ShadowReceiverFactorHalf = cast<u32>(ShadowReceiverResolution::Half);
const u32 s_ShadowReceiverFactorQuarter = cast<u32>(ShadowReceiverResolution::Quarter);
const u32 s_SwShadowTransparentSpp = 3u;

[reflect]
class ShadowQualitySettings{
    public TransparentShadowSampling transparentSampling = TransparentShadowSampling::ReferenceThree;
    public ShadowReceiverResolution receiverResolution = ShadowReceiverResolution::Half;
}

b8 ValidateShadowQualitySettings(in ShadowQualitySettings settings){
    return cast<u8>(settings.transparentSampling) <= cast<u8>(TransparentShadowSampling::TemporalOne) && (settings.receiverResolution == ShadowReceiverResolution::Half || settings.receiverResolution == ShadowReceiverResolution::Quarter);
}

// Reduced sampling requires an accepted history and an available transparent temporal filter.
u32 ResolveTransparentShadowSampleCount(in ShadowQualitySettings settings, in b8 temporalHistoryUsable){
    if(settings.transparentSampling == TransparentShadowSampling::TemporalOne && temporalHistoryUsable)
        return 1u;
    return s_SwShadowTransparentSpp;
}


