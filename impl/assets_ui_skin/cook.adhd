////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct UiSkinCookEntry{
    Core::Assets::AssetArena& arena;
    UiSkin::RegionVector regions;
    Core::Assets::AssetRef<Texture> texture;
    Name virtualPath = s_NameNone;
    u32 atlasWidth = 0u;
    u32 atlasHeight = 0u;
    f32 referenceDensity = 1.0f;
    b8 completeToolkitSkin = false;
    UiSkinPalette palette;
    UiSkinTypography typography;


public:
    explicit UiSkinCookEntry(Core::Assets::AssetArena& memoryArena)noexcept
        : arena(memoryArena)
        , regions(memoryArena)
    {}
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] Expected<UiSkinCookEntry> ParseUiSkinCookMetadata(Name virtualPath, const Path& nwbFilePath, const Core::Metascript::Value& asset, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);
[[nodiscard]] Expected<UiSkinCookEntry> ParseUiSkinCookMetadata(const Path& assetRoot, AStringView virtualRoot, const Path& nwbFilePath, const Core::Metascript::Document& doc, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);
[[nodiscard]] Expected<UiSkin> BuildUiSkinAsset(const UiSkinCookEntry& entry, Core::Assets::AssetArena& arena);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ImplAssetsUiSkinCookAdhdModule(in u64 value){
    return value != 0u;
}


