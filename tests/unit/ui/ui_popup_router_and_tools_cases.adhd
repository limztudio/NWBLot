    scopes[0u] = lower;
    scopes[1u] = higher;
    ASSERT_TRUE(self.m_router.commitTargets(targets, 3u, scopes));
    ASSERT_EQ(self.m_router.focus().value, 201u);
    ASSERT_TRUE(self.install(higher, 4u));
