void VerifyUiEditNavigationHostTests_AppliedDelayedPasteResetsTheColumnAtItsCompletionLoan(mut UiEditNavigationHostTests self){
    ASSERT_TRUE(self.m_navigationModel.setText("abcdef\nx\nabcdef"));
    ASSERT_TRUE(self.m_navigationModel.setSelection(5u, 5u));
    ASSERT_TRUE(self.activateNavigation());
    ASSERT_TRUE(self.key(Key::Down));
    ASSERT_TRUE(self.navigationFrame());
    self.m_clipboard.delayed = true;
    ASSERT_TRUE(self.key(Key::V, false, true));
    ASSERT_TRUE(self.navigationFrame());
    EXPECT_TRUE(self.m_navigation.snapshot().valid);
    EXPECT_FLOAT_EQ(self.m_navigation.snapshot().preferredX, 50.0f);
    ASSERT_TRUE(self.m_clipboard.pump());
    const ClipboardRequestToken token = self.m_clipboard.startedToken;
    ASSERT_TRUE(token.valid());
    ASSERT_TRUE(self.m_clipboard.deliver(token, ClipboardStatus::Success, "zz"));
    ASSERT_TRUE(self.navigationFrame());
    EXPECT_EQ(self.m_navigationModel.text(), "abcdef\nxzz\nabcdef");
    EXPECT_FALSE(self.m_navigation.snapshot().valid);
    ASSERT_TRUE(self.key(Key::Down));
    ASSERT_TRUE(self.navigationFrame());
    ASSERT_EQ(self.m_resolver.records.size(), 2u);
    EXPECT_FALSE(self.m_resolver.records[1u].navigation.valid);
    ASSERT_TRUE(self.m_resolver.records[1u].result.has_value());
    EXPECT_FLOAT_EQ(self.m_resolver.records[1u].result.value().preferredX, 30.0f);
    EXPECT_EQ(self.m_navigationModel.caret(), 14u);
}

void VerifyUiEditNavigationHostTests_FailedAndCancelledPastePreserveTheAcceptedColumn(mut UiEditNavigationHostTests self){
    ASSERT_TRUE(self.m_navigationModel.setText("abcdef\nx\nabcdef"));
    ASSERT_TRUE(self.m_navigationModel.setSelection(5u, 5u));
    ASSERT_TRUE(self.activateNavigation());
    ASSERT_TRUE(self.key(Key::Down));
    ASSERT_TRUE(self.navigationFrame());
    self.m_clipboard.delayed = true;
    ASSERT_TRUE(self.key(Key::V, false, true));
    ASSERT_TRUE(self.navigationFrame());
    ASSERT_TRUE(self.m_clipboard.pump());
    ASSERT_TRUE(self.m_clipboard.deliver(self.m_clipboard.startedToken, ClipboardStatus::NativeFailure));
    ASSERT_TRUE(self.navigationFrame());
    EXPECT_TRUE(self.m_navigation.snapshot().valid);
    EXPECT_FLOAT_EQ(self.m_navigation.snapshot().preferredX, 50.0f);
    EXPECT_EQ(self.m_navigationModel.caret(), 8u);
    ASSERT_TRUE(self.key(Key::V, false, true));
    ASSERT_TRUE(self.navigationFrame());
    ASSERT_TRUE(self.m_clipboard.pump());
    const ClipboardRequestToken cancelled = self.m_clipboard.startedToken;
    ASSERT_TRUE(self.key(Key::Down));
    ASSERT_TRUE(self.navigationFrame());
    ASSERT_EQ(self.m_resolver.records.size(), 2u);
    EXPECT_TRUE(self.m_resolver.records[1u].navigation.valid);
    EXPECT_FLOAT_EQ(self.m_resolver.records[1u].navigation.preferredX, 50.0f);
    EXPECT_EQ(self.m_navigationModel.caret(), 14u);
    EXPECT_EQ(self.m_navigationModel.text(), "abcdef\nx\nabcdef");
    EXPECT_FALSE(self.m_clipboard.deliver(cancelled, ClipboardStatus::Success, "late"));
    EXPECT_FALSE(self.m_navigationModel.canUndo());
}

void VerifyUiEditNavigationHostTests_PageMovementCarriesTheViewportAcceptedAtInputAdmission(mut UiEditNavigationHostTests self){
    ASSERT_TRUE(self.m_navigationModel.setText("a\nb\nc\nd\ne\nf\ng"));
    ASSERT_TRUE(self.m_navigationModel.setSelection(1u, 1u));
    ASSERT_TRUE(self.activateNavigation(UiEditBoxOptions(), MakeEcsUiRect(10.0f, 20.0f, 180.0f, 24.0f)));
    const u64 displayed = self.m_context.input().layoutGeneration();
    const UiRect nextBounds = MakeEcsUiRect(10.0f, 20.0f, 180.0f, 36.0f);
    ASSERT_TRUE(self.prepareNavigation(UiEditBoxOptions(), nextBounds));
    EXPECT_EQ(self.m_context.input().layoutGeneration(), displayed);
    ASSERT_TRUE(self.key(Key::PageDown));
    ASSERT_TRUE(self.commit());
    ASSERT_TRUE(self.navigationFrame(UiEditBoxOptions(), nextBounds));
    ASSERT_EQ(self.m_resolver.records.size(), 1u);
    EXPECT_FLOAT_EQ(self.m_resolver.records[0u].viewportHeight, 24.0f);
    EXPECT_EQ(self.m_navigationModel.caret(), 5u);
    ASSERT_TRUE(self.key(Key::PageDown));
    ASSERT_TRUE(self.navigationFrame(UiEditBoxOptions(), nextBounds));
    ASSERT_EQ(self.m_resolver.records.size(), 2u);
    EXPECT_FLOAT_EQ(self.m_resolver.records[1u].viewportHeight, 36.0f);
    EXPECT_EQ(self.m_navigationModel.caret(), 11u);
}

