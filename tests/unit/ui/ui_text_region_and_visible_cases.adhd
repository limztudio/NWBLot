void VerifyUiTextRegionTests_StandaloneMultilineLabelClipsNestedBoundsAfterResizeAcrossDisplayScales(mut UiTextRegionTests self){
    Label label = Label(self.m_arena);
    ASSERT_EQ(label.setText(MakeUiTextRegionShapeRequest(s_UiTextRegionOverflowText, 16.0f)), TextLayoutStatus::Success);
    u64 generation = 1u;
    Array<f32, 3u> scales;
    scales[0u] = 1.0f;
    scales[1u] = 1.5f;
    scales[2u] = 2.0f;
    Array<Rect, 2u> boundsList;
    boundsList[0u] = Rect(20.0f, 20.0f, 80.0f, 34.0f);
    boundsList[1u] = Rect(20.0f, 20.0f, 41.0f, 19.0f);
    for(usize scaleIndex = 0u; scaleIndex < scales.size(); ++scaleIndex){
        const f32 scale = scales[scaleIndex];
        usize previousIndices = 0u;
        for(usize boundsIndex = 0u; boundsIndex < boundsList.size(); ++boundsIndex){
            const Rect bounds = boundsList[boundsIndex];
            self.m_paint.begin(DisplayMetrics(300.0f, 200.0f, scale, scale), generation, 1u, MakeUiSkinAssetRef(s_TestSkinPath), self.m_skin);
            ++generation;
            self.m_paint.pushClip(Rect(12.0f, 10.0f, 210.0f, 140.0f));
            const Rect inherited = Rect(25.0f, 24.0f, 110.0f, 70.0f);
            self.m_paint.pushClip(inherited);
            ASSERT_TRUE(label.paint(self.m_text, self.m_paint, bounds));
            EXPECT_GT(label.layout().measure().x, bounds.width);
            EXPECT_GT(label.layout().measure().y, bounds.height);
            ExpectUiRect(self.m_paint.currentClip(), inherited);
            ASSERT_TRUE(self.m_paint.popClip());
            ASSERT_TRUE(self.m_paint.popClip());
            EXPECT_FALSE(self.m_paint.popClip());
            const DrawSnapshot snapshot = self.m_paint.freeze();
            ExpectUiTextGlyphRegion(snapshot, Rect(25.0f, 24.0f, bounds.width - 5.0f, bounds.height - 4.0f));
            const usize indices = CountUiTextRegionGlyphIndices(snapshot);
            if(previousIndices != 0u)
                EXPECT_LT(indices, previousIndices);
            previousIndices = indices;
        }
    }
}

void VerifyUiTextRegionTests_EmptyAndFailedStandaloneLabelRegionsRestoreClipBeforePaintingASibling(mut UiTextRegionTests self){
    Label label = Label(self.m_arena);
    ASSERT_EQ(label.setText(MakeUiTextRegionDefaultShapeRequest(s_UiTextRegionOverflowText)), TextLayoutStatus::Success);
    const Rect inherited = Rect(10.0f, 10.0f, 180.0f, 120.0f);
    u64 generation = 1u;
    Array<Rect, 4u> emptyRegions;
    emptyRegions[0u] = Rect(20.0f, 20.0f, 0.0f, 40.0f);
    emptyRegions[1u] = Rect(20.0f, 20.0f, 40.0f, 0.0f);
    emptyRegions[2u] = Rect(20.0f, 20.0f, 0.0f, 0.0f);
    emptyRegions[3u] = Rect(220.0f, 20.0f, 40.0f, 40.0f);
    for(usize regionIndex = 0u; regionIndex < emptyRegions.size(); ++regionIndex){
        const Rect bounds = emptyRegions[regionIndex];
        self.m_paint.begin(DisplayMetrics(300.0f, 200.0f, 1.0f, 1.0f), generation, 1u, MakeUiSkinAssetRef(s_TestSkinPath), self.m_skin);
        ++generation;
        self.m_paint.pushClip(inherited);
        ASSERT_TRUE(label.paint(self.m_text, self.m_paint, bounds));
        ExpectUiRect(self.m_paint.currentClip(), inherited);
        ASSERT_TRUE(self.m_paint.popClip());
        EXPECT_FALSE(self.m_paint.popClip());
        const DrawSnapshot snapshot = self.m_paint.freeze();
        EXPECT_TRUE(snapshot.commands().empty());
        EXPECT_TRUE(snapshot.vertices().empty());
        EXPECT_TRUE(snapshot.indices().empty());
    }
    ASSERT_EQ(label.setText(MakeUiTextRegionDefaultShapeRequest("MMMMMMMMMMMM")), TextLayoutStatus::Success);
    self.m_paint.begin(DisplayMetrics(300.0f, 200.0f, 1.0f, 1.0f), generation, 1u, MakeUiSkinAssetRef(s_TestSkinPath), self.m_skin);
    self.m_paint.pushClip(inherited);
    EXPECT_FALSE(label.paint(self.m_text, self.m_paint, Rect(20.0f, 20.0f, 30.0f, 20.0f), Color(1.0f, 1.0f, 1.0f, 2.0f)));
    ExpectUiRect(self.m_paint.currentClip(), inherited);
    const Rect sibling = Rect(110.0f, 70.0f, 60.0f, 22.0f);
    ASSERT_TRUE(label.paint(self.m_text, self.m_paint, sibling));
    ExpectUiRect(self.m_paint.currentClip(), inherited);
    ASSERT_TRUE(self.m_paint.popClip());
    EXPECT_FALSE(self.m_paint.popClip());
    const DrawSnapshot snapshot = self.m_paint.freeze();
    ExpectUiTextGlyphRegion(snapshot, sibling);
}

void VerifyUiTextRegionTests_OversizedButtonTextKeepsAsymmetricPaddingWithoutShrinkingItsSkinOrHitTarget(mut UiTextRegionTests self){
    u64 generation = 1u;
    Array<f32, 3u> scales;
    scales[0u] = 1.0f;
    scales[1u] = 1.5f;
    scales[2u] = 2.0f;
    for(usize scaleIndex = 0u; scaleIndex < scales.size(); ++scaleIndex){
        const f32 scale = scales[scaleIndex];
        ASSERT_TRUE(self.begin(generation, DisplayMetrics(800.0f, 600.0f, scale, scale)));
        ASSERT_TRUE(self.m_builder.beginPanel(s_UiTextRegionPanelKey, Rect(10.0f, 20.0f, 220.0f, 130.0f)));
        WidgetOptions options = WidgetOptions();
        options.width = LayoutSize(LayoutSizePolicy::Fixed, 80.0f);
        options.height = LayoutSize(LayoutSizePolicy::Fixed, 28.0f);
        EXPECT_FALSE(self.m_builder.button("button", s_UiTextRegionOverflowText, options));
        ASSERT_TRUE(self.finishPanel());
        EXPECT_FALSE(self.m_paint.popClip());
        const DrawSnapshot snapshot = self.m_paint.freeze();
        ASSERT_TRUE(self.m_context.commitFrame(generation));
        ++generation;
        const auto foundButton = self.tryTarget(self.id("button", s_UiTextRegionPanelKey));
        ASSERT_TRUE(foundButton.has_value());
        const HitTarget button = foundButton.value();
        ExpectUiRect(button.rectangle, Rect(13.0f, 24.0f, 80.0f, 28.0f));
        ExpectUiRect(button.clip, button.rectangle);
        const auto skin = self.sampleSkinPaint(snapshot, Name(s_UiTextRegionButtonNormalRegion));
        ASSERT_TRUE(skin.has_value());
        ExpectUiRect(skin.value().bounds, button.rectangle);
        ExpectUiTextGlyphRegion(snapshot, Rect(15.0f, 27.0f, 74.0f, 20.0f));
    }
}

void VerifyUiTextRegionTests_EmptyControlTextRegionsDoNotLeakIntoPaddingOrClipTheFollowingSibling(mut UiTextRegionTests self){
    self.m_builder.listStyle().row.padding = Insets(7.0f, 11.0f, 13.0f, 3.0f);
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginPanel(s_UiTextRegionPanelKey, Rect(10.0f, 20.0f, 220.0f, 240.0f)));
    WidgetOptions options = WidgetOptions();
    options.width = LayoutSize(LayoutSizePolicy::Fixed, 4.0f);
    options.height = LayoutSize(LayoutSizePolicy::Fixed, 40.0f);
    EXPECT_FALSE(self.m_builder.button("button", "MMMM", options));
    options.width.value = 10.0f;
    EXPECT_FALSE(self.m_builder.selectable("selectable", "MMMM", false, options));
    options.width.value = 20.0f;
    b8 checked = false;
    EXPECT_FALSE(self.m_builder.checkbox("checkbox", "MMMM", checked, options));
    EXPECT_FALSE(checked);
    options.width.value = 50.0f;
    options.height.value = 32.0f;
    EXPECT_FALSE(self.m_builder.button("sibling", "MMMMMMMM", options));
    ASSERT_TRUE(self.finishPanel());
    EXPECT_FALSE(self.m_paint.popClip());
    const DrawSnapshot snapshot = self.m_paint.freeze();
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const auto foundSibling = self.tryTarget(self.id("sibling", s_UiTextRegionPanelKey));
    ASSERT_TRUE(foundSibling.has_value());
    const HitTarget sibling = foundSibling.value();
    ExpectUiTextGlyphRegion(snapshot, Rect(sibling.rectangle.x + 2.0f, sibling.rectangle.y + 3.0f, 44.0f, 24.0f));
}

void VerifyUiTextRegionTests_CheckboxGlyphOverhangCannotEnterIndicatorReservationOrEscapeAncestorClip(mut UiTextRegionTests self){
    self.m_builder.style().fontSize = 48.0f;
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginPanel(s_UiTextRegionPanelKey, Rect(10.0f, 20.0f, 100.0f, 110.0f)));
    WidgetOptions options = WidgetOptions();
    options.width = LayoutSize(LayoutSizePolicy::Fixed, 120.0f);
    options.height = LayoutSize(LayoutSizePolicy::Fixed, 36.0f);
    b8 checked = false;
    EXPECT_FALSE(self.m_builder.checkbox("checkbox", "jjjjjjjjjjjjjjjj", checked, options));
    EXPECT_FALSE(checked);
    ASSERT_TRUE(self.finishPanel());
    const DrawSnapshot snapshot = self.m_paint.freeze();
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const auto foundCheckbox = self.tryTarget(self.id("checkbox", s_UiTextRegionPanelKey));
    ASSERT_TRUE(foundCheckbox.has_value());
    const HitTarget checkbox = foundCheckbox.value();
    ExpectUiRect(checkbox.rectangle, Rect(13.0f, 24.0f, 120.0f, 36.0f));
    ExpectUiRect(checkbox.clip, Rect(13.0f, 24.0f, 92.0f, 36.0f));
    ExpectUiTextGlyphRegion(snapshot, Rect(45.0f, 24.0f, 60.0f, 36.0f));
    const auto skin = self.sampleSkinPaint(snapshot, Name(s_UiTextRegionCheckboxNormalRegion));
    ASSERT_TRUE(skin.has_value());
    ExpectUiRect(skin.value().bounds, Rect(13.0f, 30.0f, 24.0f, 24.0f));
}

void VerifyUiTextRegionTests_OversizedSelectableTextKeepsAllFourPaddingEdgesAndFullRowHitBounds(mut UiTextRegionTests self){
    self.m_builder.listStyle().row.padding = Insets(7.0f, 11.0f, 13.0f, 3.0f);
