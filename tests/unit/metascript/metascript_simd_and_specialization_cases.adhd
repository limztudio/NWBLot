static_assert(NWB::Core::Metascript::Adhd::BuiltinTypeSemantics::FindBuiltinScalarType("f64")->isFloat);
static_assert(NWB::Core::Metascript::Adhd::BuiltinTypeSemantics::FindBuiltinScalarType("unknown") == nullptr);


