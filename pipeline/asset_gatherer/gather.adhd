[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <engine_namespace.h>

#include <core/global.h>
#include <core/assets/gather_merge_registry.h>
#include <core/assets/module.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#define NWB_ASSET_GATHERER_BEGIN NWB_BEGIN namespace Pipeline{ namespace AssetGatherer{
#define NWB_ASSET_GATHERER_END }; }; NWB_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_ASSET_GATHERER_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct AssetGatherOptions{
    Core::Assets::AssetVector<Core::Assets::AssetString> inputs;
    Core::Assets::AssetString outputDirectory;
    ACompactString configuration;
    Core::Assets::AssetGatherMergeFunction mergePayloads = nullptr;


public:
    explicit AssetGatherOptions(Core::Assets::AssetArena& arena)noexcept
        : inputs(arena)
        , outputDirectory(arena)
    {}
};

b8 GatherAssets(const AssetGatherOptions& options, Core::Alloc::ScratchArena& scratchArena);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_ASSET_GATHERER_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


StringView SelectEffectiveGatherConfiguration(in StringView canonicalConfiguration){
    if(canonicalConfiguration.empty())
        return s_DefaultGatherConfig;
    return canonicalConfiguration;
}

void LogConflictingBuiltAssetIdentity(in Name virtualPath){
    error("AssetGatherer: conflicting built asset identity '{}'", virtualPath.resolvedText());
}

void LogGatherOutputResolveFailure(in StringView outputDirectory){
    error("AssetGatherer: failed to resolve output '{}'", outputDirectory);
}

void LogAssetsGathered(in u64 fileCount, in StringView outputDirectory){
    [essential] info("AssetGatherer: gathered {} assets into '{}'", fileCount, outputDirectory);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <core/assets/input_list.h>
#include <core/assets/volume/asset_volume_writer.h>
#include <core/assets/volume/built_asset.h>
#include <core/common/log.h>

#include <global/binary.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_ASSET_GATHERER_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace Assets = Core::Assets;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_asset_gatherer_gather{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] static Expected<Assets::AssetVector<Assets::AssetString>> CollectGatherInputFiles(const AssetGatherOptions& options, Core::Alloc::ScratchArena& scratchArena){
    Assets::AssetArena& arena = options.inputs.get_allocator().arena();
    Assets::AssetVector<Assets::AssetString> files(arena);
    files.reserve(options.inputs.size());
    for(const Assets::AssetString& input : options.inputs){
        const auto absolutePath = AbsolutePath(Path(arena, input));
        if(!absolutePath){
            LogGatherInputResolveFailure(input);
            return MakeUnexpected(Failure{});
        }
        const Path path = absolutePath->lexicallyNormal();
        const auto directory = IsDirectory(path);
        if(!directory){
            LogGatherInputInspectFailure(input);
            return MakeUnexpected(Failure{});
        }
        if(!*directory){
            files.emplace_back(PathToString(arena, path));
            continue;
        }

        const Path manifest = path / Assets::BuiltAssetDetail::s_ManifestFilename;
        const auto manifestExists = FileExists(manifest);
        if(!manifestExists){
            LogGatherBuildManifestInspectFailure(PathToString<char>(scratchArena, manifest));
            return MakeUnexpected(Failure{});
        }
        if(*manifestExists){
            if(!Assets::ReadAssetInputList(manifest, scratchArena, files, true))
                return MakeUnexpected(Failure{});
            continue;
        }
        const auto entries = RecursiveDirectoryIterator<Assets::AssetArena>::Create(path);
        if(!entries){
            LogGatherInputScanFailure(input);
            return MakeUnexpected(Failure{});
        }
        for(const auto& entry : *entries){
            const auto regular = entry.isRegularFile();
            if(!regular){
                LogGatherInputEntryInspectFailure(PathToString<char>(scratchArena, entry.path()));
                return MakeUnexpected(Failure{});
            }
            const Assets::ScratchString extText = PathToString(scratchArena, entry.path().extensionView());
            if(IsBuiltAssetEntryExtension(*regular, extText, Assets::BuiltAssetDetail::s_Extension))
                files.emplace_back(PathToString(arena, entry.path()));
        }
    }
    Sort(files.begin(), files.end());
    files.erase(Unique(files.begin(), files.end()), files.end());
    return files;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 GatherAssets(const AssetGatherOptions& options, Core::Alloc::ScratchArena& scratchArena){
    Assets::AssetArena& arena = options.inputs.get_allocator().arena();
    if(!ValidateAssetGathererOutputDirectory(!options.outputDirectory.empty()))
        return false;

    const auto filesResult = __hidden_asset_gatherer_gather::CollectGatherInputFiles(options, scratchArena);
    if(!filesResult)
        return false;
    const auto& files = *filesResult;
    Assets::AssetsVolumeCookDetail::AssetVolumePackManifest manifest(arena);
    if(!Assets::AssetsVolumeCookDetail::ReserveAssetVolumePackManifest(files.size(), manifest))
        return false;

    HashMap<Name, usize, Core::Alloc::ScratchArena> entryIndices(scratchArena);
    entryIndices.reserve(files.size());
    Assets::AssetBytes bytes(arena);
    for(const Assets::AssetString& file : files){
        const auto payload = Assets::BuiltAssetDetail::ReadBuiltAsset(Path(arena, file), bytes);
        if(!payload)
            return false;
        const Name& virtualPath = payload->virtualPath;
        const usize payloadOffset = payload->payloadOffset;
        const Span<const u8> payloadBytes = Span<const u8>(bytes).subspan(payloadOffset);
        const auto inserted = entryIndices.try_emplace(virtualPath, manifest.entries.size());
        if(!inserted.second){
            auto& existing = manifest.entries[inserted.first.value()];
            const b8 identical = AreGatheredAssetPayloadsIdentical(existing.payloadBytes, payloadBytes);
            if(!identical){
                if(!options.mergePayloads || !options.mergePayloads(virtualPath, payloadBytes, scratchArena, existing.payloadBytes)){
                    LogConflictingBuiltAssetIdentity(virtualPath);
                    return false;
                }
                existing.identity.payloadSize = existing.payloadBytes.size();
                existing.identity.payloadHash = ComputeGatheredPayloadHash(existing.payloadBytes);
            }
            --manifest.plannedFileCount;
            continue;
        }
        if(!Assets::AssetsVolumeCookDetail::AppendPayloadBytesToManifest(virtualPath, payloadBytes, manifest, 0u))
            return false;
    }

    Assets::ResolvedCookPaths paths(arena);
    const auto outputDirectory = AbsolutePath(Path(arena, options.outputDirectory));
    if(!outputDirectory){
        LogGatherOutputResolveFailure(options.outputDirectory);
        return false;
    }
    paths.outputDirectory = outputDirectory->lexicallyNormal();
    const AString<> effectiveConfiguration = ResolveEffectiveGatherConfiguration(options.configuration.view());
    Assets::CookString configuration(AStringView(effectiveConfiguration), arena);

    const auto result = Assets::AssetsVolumeCookDetail::WriteAssetVolume(paths, configuration, manifest, arena, scratchArena);
    if(!result)
        return false;
    LogAssetsGathered(result->fileCount, options.outputDirectory);
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_ASSET_GATHERER_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

