usize ResolveRefractionCaptureSetUseCount(in b8 sampledTextureSetValid){
    if(sampledTextureSetValid)
        return s_RefractionCaptureGeometryAndTextureSetUseCount;
    return 1u;
}


class FrameGraphAvboitStageTiming{
    public mut GpuTimingSubmissionTicket preTimingTicket;
    public mut GpuTimingSubmissionTicket depthWarpTimingTicket;
    public mut GpuTimingSubmissionTicket extinctionTimingTicket;
    public mut GpuTimingSubmissionTicket integrationTimingTicket;
    public mut GpuTimingSubmissionTicket accumulationTimingTicket;
    public mut GraphClearTimingRecordState clearTimingState;
    public mut GraphClearTimingRecordState transparentCsgIntervalClearTimingState;
    public mut Optional<GpuTimingMeasure> transparentCsgIntervalsTiming;
    public mut Optional<GpuTimingMeasure> occupancyComputeEmulationTiming;
    public mut Optional<GpuTimingMeasure> extinctionComputeEmulationTiming;
    public mut Optional<GpuTimingMeasure> accumulationComputeEmulationTiming;

    public FrameGraphAvboitStageTiming(
        mut GpuTimingSubmissionTicket preTimingTicket,
        mut GpuTimingSubmissionTicket depthWarpTimingTicket,
        mut GpuTimingSubmissionTicket extinctionTimingTicket,
        mut GpuTimingSubmissionTicket integrationTimingTicket,
        mut GpuTimingSubmissionTicket accumulationTimingTicket,
        mut GraphClearTimingRecordState clearTimingState,
        mut GraphClearTimingRecordState transparentCsgIntervalClearTimingState,
        mut Optional<GpuTimingMeasure> transparentCsgIntervalsTiming,
        mut Optional<GpuTimingMeasure> occupancyComputeEmulationTiming,
        mut Optional<GpuTimingMeasure> extinctionComputeEmulationTiming,
        mut Optional<GpuTimingMeasure> accumulationComputeEmulationTiming
    ){
        this.preTimingTicket = preTimingTicket;
        this.depthWarpTimingTicket = depthWarpTimingTicket;
        this.extinctionTimingTicket = extinctionTimingTicket;
        this.integrationTimingTicket = integrationTimingTicket;
        this.accumulationTimingTicket = accumulationTimingTicket;
        this.clearTimingState = clearTimingState;
        this.transparentCsgIntervalClearTimingState = transparentCsgIntervalClearTimingState;
        this.transparentCsgIntervalsTiming = transparentCsgIntervalsTiming;
        this.occupancyComputeEmulationTiming = occupancyComputeEmulationTiming;
        this.extinctionComputeEmulationTiming = extinctionComputeEmulationTiming;
        this.accumulationComputeEmulationTiming = accumulationComputeEmulationTiming;
    }
}

[modular]
class FrameGraphAvboitStage : NoCopy{
    private mut GpuTaskGraph m_graph;
    private mut GraphicsRuntime m_graphics;
    private mut RendererMaterialSystem m_materialSystem;
    private mut RendererCsgSystem m_csgSystem;
    private mut RendererAvboitSystem m_avboitSystem;
    private mut RendererTaskTimingFeedback m_timingFeedback;

    public FrameGraphAvboitStage(
        mut GpuTaskGraph graph,
        mut GraphicsRuntime graphics,
        mut RendererMaterialSystem materials,
        mut RendererCsgSystem csg,
        mut RendererAvboitSystem avboit,
        mut RendererTaskTimingFeedback timing
    ){
        this.m_graph = graph;
        this.m_graphics = graphics;
        this.m_materialSystem = materials;
        this.m_csgSystem = csg;
        this.m_avboitSystem = avboit;
        this.m_timingFeedback = timing;
    }
    [cpp_unwind]
    public Expected<GpuTaskId> declare(in FrameGraphAvboitStageInputs inputs, in FrameGraphAvboitStageTiming timing, mut ObjectGeometryCacheGraph objectGeometry);
    [cpp_unwind]
    private b8 declareExtinction(
        in FrameGraphAvboitStageInputs inputs,
        in FrameGraphAvboitStageTiming timing,
        in GpuTaskId avboitDepthWarpCompletionTask,
        in b8 avboitIntervalOutputsGraphOwned,
        mut ObjectGeometryCacheGraph objectGeometry,
        mut AvboitGeneratedGeometryReuse generatedGeometry,
        mut AvboitComputeEffectChainBuilder avboitComputeEffectChainBuilder
    );
    [cpp_unwind]
    private b8 declareAccumulation(
        in FrameGraphAvboitStageInputs inputs,
        in FrameGraphAvboitStageTiming timing,
        in b8 avboitIntervalOutputsGraphOwned,
        mut ObjectGeometryCacheGraph objectGeometry,
        mut AvboitGeneratedGeometryReuse generatedGeometry
    );
}


