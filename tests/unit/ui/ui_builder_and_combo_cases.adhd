void VerifyUiComboBehaviorTests_InvalidIdentitiesAndMalformedLookupLeaveExistingStateUnchanged(){
    UiComboBehaviorSource source = UiComboBehaviorSource();
    ComboState state = ComboState();
    state.select(4u);
    ASSERT_TRUE(UiComboBehaviorReconcile(state, source));
    UiComboBehaviorOpen(state);
    source.generation = 0u;
    EXPECT_FALSE(UiComboBehaviorReconcile(state, source));
    source.generation = 51u;
    source.revisionValue = 0u;
    EXPECT_FALSE(UiComboBehaviorReconcile(state, source));
    source.revisionValue = 1u;
    source.badLookup = true;
    EXPECT_FALSE(UiComboBehaviorReconcile(state, source));
    EXPECT_FALSE(UiComboBehaviorCommit(state, source, 5u));
    source.badLookup = false;
    source.wrongLookup = true;
    EXPECT_FALSE(UiComboBehaviorReconcile(state, source));
    EXPECT_FALSE(UiComboBehaviorCommit(state, source, 5u));
    EXPECT_EQ(state.selectedKey(), 4u);
    EXPECT_EQ(state.listState().cursorKey(), 4u);
    EXPECT_TRUE(state.isOpen());
}

void VerifyUiComboBehaviorTests_CommitRequiresReconciledRevisionAndRejectsSourceReplacement(){
