namespace NWB::Tests::Smoke{
namespace ReflectionGpuTimingScope = Impl::ReflectionGpuTimingScope;
inline constexpr u32 s_ReflectionMaxDepthMipsCap = NWB_REFLECTION_MAX_DEPTH_MIPS;

[[nodiscard]] NWB_INLINE AStringView ReflectionSmokeProjectName()noexcept{
    return "ReflectionSmokeProject";
}

[[nodiscard]] NWB_INLINE AStringView ReflectionCpuTimingOwnerLabel()noexcept{
    return "reflection";
}
};


