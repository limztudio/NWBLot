#include <impl/ecs_render/kernel/graphics_prefix_timing_ticket.adhd>
#include <impl/ecs_render/kernel/task_graph_clear_timing.adhd>
#include <impl/ecs_render/deferred/deferred_system.adhd>
#include <impl/ecs_render/deferred/import_types.adhd>
#include <impl/ecs_render/material/task_graph_object_geometry_cache.adhd>
#include <impl/ecs_render/raytrace/raytracing_system.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class GraphicsPrefixGraphContext{
    public mut GraphicsRuntime graphics;
    public mut GpuTaskGraph graph;
    public mut RendererCsgSystem csg;
    public mut RendererDeferredSystem deferred;
    public mut RendererMaterialSystem material;
    public mut RendererMeshSystem mesh;
    public mut RendererRayTracingSystem rayTracing;
    public in GpuTaskId shadowVisibilityTask;

    public GraphicsPrefixGraphContext(
        mut GraphicsRuntime graphics,
        mut GpuTaskGraph graph,
        mut RendererCsgSystem csg,
        mut RendererDeferredSystem deferred,
        mut RendererMaterialSystem material,
        mut RendererMeshSystem mesh,
        mut RendererRayTracingSystem rayTracing,
        in GpuTaskId shadowVisibilityTask
    ){
        this.graphics = graphics;
        this.graph = graph;
        this.csg = csg;
        this.deferred = deferred;
        this.material = material;
        this.mesh = mesh;
        this.rayTracing = rayTracing;
        this.shadowVisibilityTask = shadowVisibilityTask;
    }
}


[modular]
class GraphicsPrefixGraphCoordinator : NoCopy{
    [cpp_unwind]
    public Expected<u64> declareDeferredGraphicsPrefixTasks(
        in GraphicsPrefixGraphContext context,
        in GpuTaskId shadowPrepareTask,
        in CsgFrameState csgFrameState,
        in MeshFrameBindingSnapshot frameBindings,
        in CsgGraphResourceSnapshot csgResources,
        in b8 hasOpaqueCsgFrameWork,
        in f32 meshViewAspectRatio,
        in MeshViewGpuData meshViewState,
        in b8 meshViewUploadRequired,
        in DeferredGraphResourceImportResult resources,
        in Span<GpuGraphResourceId> shadowTraceGeometryResources,
        in GpuGraphResourceSetId shadowTraceGeometrySet,
        in borrow b8 asyncPrefixTimingSpansOnePacket,
        mut DeferredFrameTargets deferredTargets,
        mut ObjectGeometryCacheGraph objectGeometry,
        mut Optional<GpuTimingMeasure> asyncPrefixTiming,
        mut Optional<GpuTimingMeasure> deferredClearTiming,
        mut GraphClearTimingRecordState deferredClearTimingState,
        mut GraphClearTimingRecordState csgIntervalClearTimingState,
        mut Optional<GpuTimingMeasure> opaqueRegularSharedComputeEmulationTiming,
        mut Optional<GpuTimingMeasure> opaqueCsgIntervalSampleComputeEmulationTiming,
        in Span<GraphicsPrefixTimingTicket> timingTickets
    );
    public void resetGraphicsPrefixTaskState();

    public GpuTaskId m_graphicsPrefixMeshViewSetupTask;
    public GpuTaskId m_graphicsPrefixSceneShadingSetupTask;
    public GpuTaskId m_graphicsPrefixDeferredClearTask;
    public GpuTaskId m_graphicsPrefixCsgIntervalClearFirstTask;
    public GpuTaskId m_graphicsPrefixCsgIntervalClearTask;
    public GpuTaskId m_graphicsPrefixOpaqueComputeEmulationTask;
    public Array<GpuTaskId, s_SharedComputeEmulationMaximumPhaseCount> m_graphicsPrefixOpaqueSharedComputeEmulationTasks;
    public usize m_graphicsPrefixOpaqueSharedComputeEmulationTaskCount = 0u;
    public GpuTaskId m_graphicsPrefixOpaqueCsgReceiverComputeEmulationTask;
    public GpuTaskId m_graphicsPrefixOpaqueCsgIntervalSampleComputeEmulationTask;
    public GpuTaskId m_graphicsPrefixGbufferTask;
    public GpuTaskId m_graphicsPrefixCsgReceiverSpanTask;
    public GpuTaskId m_graphicsPrefixCsgIntervalCombineTask;
    public GpuTaskId m_graphicsPrefixCsgIntervalSampleTask;
    public GpuTaskId m_graphicsPrefixTask;
    public b8 m_graphicsPrefixMeshViewSetupReady = false;
    public b8 m_graphicsPrefixSceneShadingSetupReady = false;
}


