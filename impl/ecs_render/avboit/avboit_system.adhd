////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererAvboitTaskGraphTimingTickets{
    public mut GpuTimingSubmissionTicket pre;
    public mut GpuTimingSubmissionTicket depthWarp;
    public mut GpuTimingSubmissionTicket extinction;
    public mut GpuTimingSubmissionTicket integration;
    public mut GpuTimingSubmissionTicket accumulation;

    public RendererAvboitTaskGraphTimingTickets(
        mut GpuTimingSubmissionTicket inPre,
        mut GpuTimingSubmissionTicket inDepthWarp,
        mut GpuTimingSubmissionTicket inExtinction,
        mut GpuTimingSubmissionTicket inIntegration,
        mut GpuTimingSubmissionTicket inAccumulation
    ){
        this.pre = inPre;
        this.depthWarp = inDepthWarp;
        this.extinction = inExtinction;
        this.integration = inIntegration;
        this.accumulation = inAccumulation;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[modular]
class RendererAvboitSystem : NoCopy{
    private mut GraphicsRuntime m_graphics;
    private mut RendererAvboitState m_avboitState;
    private mut RendererShaderSystem m_shaderSystem;
    private mut RendererMaterialSystem m_materialSystem;
    private mut RendererCsgSystem m_csgSystem;
    private RendererAvboitTaskGraphStageState m_taskGraphStage;

    public RendererAvboitSystem(
        mut GraphicsRuntime graphics,
        mut RendererAvboitState avboitState,
        mut RendererShaderSystem shaderSystem,
        mut RendererMaterialSystem materialSystem,
        mut RendererCsgSystem csgSystem
    ){
        this.m_graphics = graphics;
        this.m_avboitState = avboitState;
        this.m_shaderSystem = shaderSystem;
        this.m_materialSystem = materialSystem;
        this.m_csgSystem = csgSystem;
    }

    public b8 shouldClearTargets(in b8 hasTransparentRenderers)const{
        return hasTransparentRenderers || this.m_avboitState.m_targetsNeedClear;
    }

    public b8 captureTargetClearState()const{
        return this.m_avboitState.m_targetsNeedClear;
    }

    public void restoreTargetClearState(in b8 targetsNeedClear){
        this.m_avboitState.m_targetsNeedClear = targetsNeedClear;
    }

    public void markFrameTargetUsage(in b8 hasTransparentRenderers){
        this.m_avboitState.m_targetsNeedClear = hasTransparentRenderers;
    }

    public void invalidateResources(){
        this.m_avboitState.invalidateResources();
    }

    public void resetTaskGraphStage(){
        this.m_taskGraphStage.reset();
    }

    public mut RendererAvboitTaskGraphStageState taskGraphStage(){
        return this.m_taskGraphStage;
    }

    public RendererAvboitTaskGraphValidation validateTaskGraphStage(in GpuCompiledGraphReadView compiledGraph, in b8 clearTargets, in b8 hasTransparentRenderers)const;
    public b8 appendTaskGraphTimingTickets(
        in RendererAvboitTaskGraphValidation validation,
        mut RendererAvboitTaskGraphTimingTickets timingTickets,
        in usize currentBindingCount,
        in usize maxBindingCount,
        in Func<64u, b8(in GpuTaskId, mut GpuTimingSubmissionTicket)> appendTicket
    )const;

    public b8 createAvboitSampler();
    public b8 createAvboitResources();
    public b8 createAvboitPipelines();
    public void resetAvboitFrameTargets(mut AvboitFrameTargets targets);
    public b8 createAvboitFrameTargets(mut DeferredFrameTargets createdTargets);
    public b8 registerAvboitFrameTargetDescriptors(mut DeferredFrameTargets createdTargets, mut AvboitFrameTargets avboitTargets);
    public mut RhiSampler linearSampler();
    public b8 prepareAvboitPassResources(in CsgFrameState csgFrameState, mut DeferredFrameTargets targets);
    public void renderAvboitTransparentCsgIntervals(
        mut CommandList commandList,
        mut DeferredFrameTargets targets,
        in MaterialPassDrawItemsView receiverSurfaceDrawItems,
        in CsgFrameGpuDataView csgFrameData,
        in CsgGraphResourceSnapshot csgResources,
        in MeshFrameBindingSnapshot frameBindings,
        in usize instanceCount,
        in usize materialTypedByteCount,
        in b8 materialGeometryStatesGraphOwned,
        mut Optional<GpuTimingMeasure> intervalTiming
    );
    [cpp_unwind]
    public void renderPreparedGraphPass(
        mut CommandList commands,
        mut DeferredFrameTargets targets,
        in MaterialPipelinePass pass,
        in TransparentMaterialPassGraphSnapshot snapshot,
        in CsgGraphResourceSnapshot csg,
        in MeshFrameBindingSnapshot bindings,
        in b8 frameOwned,
        in b8 geometryOwned,
        in b8 outputOwned,
        in b8 csgOutputOwned,
        in b8 reused,
        in Optional<mut Optional<GpuTimingMeasure>> timing
    ){
        if(pass == MaterialPipelinePass::AvboitOccupancy){
            assert(this.m_avboitState.m_depthWarpPipeline.valid());
            assert(this.m_avboitState.m_integratePipeline.valid());
        }
        FramebufferHandle framebuffer = targets.avboit.lowFramebuffer;
        if(pass == MaterialPipelinePass::AvboitAccumulate)
            framebuffer = targets.avboit.accumulationFramebuffer;
        const auto draws = snapshot.drawItemsView();
        const auto csgFrame = snapshot.csgFrameDataView();
        this.renderAvboitMaterialPass(commands, framebuffer, pass, targets.avboit, draws, csgFrame, csg, bindings,
            snapshot.instanceCount, snapshot.materialTypedByteCount, frameOwned, geometryOwned, outputOwned, csgOutputOwned, reused, timing);
    }
    public void dispatchAvboitDepthWarp(mut CommandList commandList, mut AvboitFrameTargets targets);
    public void dispatchAvboitDepthWarp(mut CommandList commandList, mut AvboitFrameTargets targets, in GpuTimingSampleAttribution timingAttribution, mut b8 timingRecorded);
    public void dispatchAvboitIntegration(mut CommandList commandList, mut AvboitFrameTargets targets);
    public void dispatchAvboitIntegration(mut CommandList commandList, mut AvboitFrameTargets targets, in GpuTimingSampleAttribution timingAttribution, mut b8 timingRecorded);

    private void renderAvboitMaterialPass(
        mut CommandList commandList,
        in FramebufferHandle framebuffer,
        in MaterialPipelinePass pass,
        mut AvboitFrameTargets avboitTargets,
        in MaterialPassDrawItemPartitionsView preparedDrawItems,
        in CsgFrameGpuDataView preparedCsgFrameData,
        in CsgGraphResourceSnapshot preparedCsgResources,
        in MeshFrameBindingSnapshot preparedFrameBindings,
        in usize preparedInstanceCount,
        in usize preparedMaterialTypedByteCount,
        in b8 materialFrameStatesGraphOwned,
        in b8 materialGeometryStatesGraphOwned,
        in b8 computeEmulationOutputStatesGraphOwned,
        in b8 csgComputeEmulationOutputStatesGraphOwned,
        in b8 generatedGeometryReused,
        in Optional<mut Optional<GpuTimingMeasure>> computeEmulationTiming
    );
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 HasTransparentCsgWork(in b8 hasTransparentStaticWork, in b8 hasTransparentSkinnedWork){
    return hasTransparentStaticWork || hasTransparentSkinnedWork;
}

u32 ComputeAvboitIntegrationDispatchGroups(in u32 lowWidth, in u32 lowHeight, in u32 groupSizeX){
    const u32 pixelCount = lowWidth * lowHeight;
    return DivideUpWrappingU32(pixelCount, groupSizeX);
}


