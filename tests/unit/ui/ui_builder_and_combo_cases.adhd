void VerifyUiComboBehaviorTests_CallbackCloseAndReopenPreserveTheExplicitPopupLifetime(){
    Array<UiComboBehaviorCallbackMutationEnum, 2u> mutations = Array<UiComboBehaviorCallbackMutationEnum, 2u>();
    mutations[0u] = UiComboBehaviorCallbackMutation::Open;
    mutations[1u] = UiComboBehaviorCallbackMutation::Close;
    for(in UiComboBehaviorCallbackMutationEnum mutation : mutations){
        ComboState state = ComboState();
        UiComboBehaviorSource source = UiComboBehaviorSource(state);
        state.select(4u);
        ASSERT_TRUE(UiComboBehaviorReconcile(state, source));
        UiComboBehaviorOpen(state);
        const u64 inputGeneration = state.inputGeneration();
        source.arm(UiComboBehaviorCallbackStage::Enabled, mutation);
        EXPECT_FALSE(UiComboBehaviorCommit(state, source, 5u));
        EXPECT_NE(state.inputGeneration(), inputGeneration);
        EXPECT_EQ(state.selectedKey(), 4u);
        EXPECT_EQ(state.listState().cursorKey(), 4u);
        EXPECT_EQ(state.isOpen(), mutation == UiComboBehaviorCallbackMutation::Open);
    }
}

void VerifyUiComboBehaviorTests_SameValueCallbackSelectionStillRejectsTheOutstandingCommit(){
    ComboState state = ComboState();
    UiComboBehaviorSource source = UiComboBehaviorSource(state);
