////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_MeshObjectGeometryBufferSuffix = ":object_geometry";

b8 IsObjectGeometryCacheReady(in b8 hasBuffer, in b8 heapHandleValid){
    return hasBuffer && heapHandleValid;
}

b8 ShouldRecordMeshGraphicsFrameMarker(in b8 shadowVisibilityRunsOnCompute, in b8 frameScopeValid){
    return !shadowVisibilityRunsOnCompute && frameScopeValid;
}

b8 ShouldRecordMeshSplitAsyncPrefixTiming(in b8 shadowVisibilityRunsOnCompute, in b8 asyncPrefixTimingSpansOnePacket){
    return shadowVisibilityRunsOnCompute && asyncPrefixTimingSpansOnePacket;
}


b8 MeshViewSetupGraphTask::record(mut CommandList commandList, in GpuTaskRecordContext context)const{
    const auto queue = QueueForTask(context, this.m_shadowVisibilityTask);
    if(!queue.has_value())
        return false;
    const b8 onCompute = queue.value().queueClass == CommandQueue::Compute;
    GpuTimingTicketRecordingScope recording(this.m_timingTicket.value());
    const b8 frameMarker = ShouldRecordMeshGraphicsFrameMarker(onCompute, s_TimingScopeFrame.valid());
    if(frameMarker)
        commandList.beginMarker(s_TimingScopeFrame.markerLabel);
    if(ShouldRecordMeshSplitAsyncPrefixTiming(onCompute, this.m_asyncPrefixTimingSpansOnePacket)){
        this.m_asyncPrefixTiming.emplace(this.m_graphics.gpuTiming(), s_TimingScopeAsyncPrefix, this.m_graphics.getDevice(), commandList);
        if(!FinishSplitGpuTimingMarker(this.m_asyncPrefixTiming))
            return false;
    }
    if(frameMarker)
        commandList.endMarker();
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
void RendererMeshSystem::invalidateResources(){
    this.releaseAllMeshGeometryHeapHandles();
    this.releaseMeshFrameHeapHandles();
    this.m_meshState.invalidateResources();
}

[cpp_unwind]
b8 RendererMeshSystem::prepareObjectGeometryCache(mut MeshResources mesh, in ComputePipelineHandle decoderPipeline){
    if(!decoderPipeline.valid())
        return false;
    mut ObjectGeometryCacheState cache = mesh.objectGeometryCache;
    if(cache.decoderPipeline != decoderPipeline){
        cache.decoderPipeline = decoderPipeline;
        cache.acceptedContent = false;
    }
    if(IsObjectGeometryCacheReady(cache.buffer.valid(), cache.heapHandle.valid()))
        return true;
    if(!cache.buffer.valid()){
        if(!mesh.buffers.meshletLocalVertexRefBuffer.valid())
            return false;
        const Expected<ObjectGeometryCacheLayout> layoutResult = MeshGeometryBufferPolicy().resolveObjectCacheLayout(mesh.buffers.meshletLocalVertexRefBuffer.deref().getCreationDescription().byteSize, mesh.meshletPrimitiveIndexCount);
        if(!layoutResult.has_value())
            return false;
        in ObjectGeometryCacheLayout layout = layoutResult.value();
        const auto bufferName = DeriveName(mesh.meshName, s_MeshObjectGeometryBufferSuffix);
        if(!bufferName.has_value())
            return false;
        BufferDesc desc;
        desc
            .setByteSize(layout.bufferByteSize)
            .setStructStride(s_MeshObjectVertexByteSize)
            .setCanHaveRawViews(true)
            .setCanHaveUAVs(true)
            .setIsVertexBuffer(true)
            .setIsIndexBuffer(true)
            .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
            .setDebugName(bufferName.value())
        ;
        auto bufferResult = this.m_graphics.createBuffer(desc);
        if(bufferResult.has_value())
            cache.buffer = bufferResult.value();
        else
            cache.buffer.reset();
        if(!bufferResult.has_value()){
            error("RendererSystem: failed to create object geometry cache for mesh '{}'", mesh.meshName.resolvedText());
            return false;
        }
        cache.indexByteOffset = layout.indexByteOffset;
        cache.indexCount = layout.indexCount;
        cache.acceptedContent = false;
        cache.initialized = false;
    }
    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
    if(!heap.isInitialized())
        return false;
    return AssignDescriptor(heap, GpuDescriptorClass::StorageBuffer, DescriptorWriteItemStructuredBufferUav(0u, cache.buffer.deref()), cache.heapHandle);
}

b8 RendererMeshSystem::confirmObjectGeometryCache(in Name meshKey, in RuntimeMeshBuffers sourceBuffers, in ObjectGeometryCacheSnapshot expected, in b8 runtimeMesh){
    const auto mesh = this.findMeshResources(meshKey);
    if(!mesh.has_value())
        return false;
    return AcceptObjectGeometryCacheWrite(mesh.value(), sourceBuffers, expected, runtimeMesh);
}

[cpp_unwind]
b8 RendererMeshSystem::createMeshViewBuffer(){
    if(this.m_meshState.m_meshViewBuffer.valid())
        return true;

    BufferDesc meshViewBufferDesc;
    meshViewBufferDesc
        .setByteSize(size_of<MeshViewGpuData>())
        .setIsConstantBuffer(true)
        .setDebugName(s_MeshViewBufferName)
        // Either caustic producer can consume the view; keep concurrent to avoid serializing lanes.
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute).enableAutomaticStateTracking(ResourceStates::Common)
    ;
    auto meshViewBufferResult = this.m_graphics.createBuffer(meshViewBufferDesc);
    if(!meshViewBufferResult.has_value()){
        error("RendererSystem: failed to create mesh view buffer");
        return false;
    }
    BufferHandle meshViewBuffer = meshViewBufferResult.value();

    this.releaseMeshFrameHeapHandles();
    this.m_meshState.m_meshViewBuffer = meshViewBuffer;
    return true;
}

MeshViewBufferSnapshot RendererMeshSystem::meshViewBufferSnapshot()const{
    return this.m_meshState.m_frameBindings.viewSnapshot(this.m_meshState.m_meshViewBuffer);
}

Expected<f32x4x4> RendererMeshSystem::snapshotAcceptedMeshViewWorldToClip()const{
    const Expected<MeshViewGpuData> acceptedView = MeshViewStatePolicy().readAccepted(this.m_meshState.m_meshViewGpuDataValid, this.m_meshState.m_meshViewGpuData);
    if(!acceptedView.has_value())
        return MakeUnexpected(Failure());
    return acceptedView.value().worldToClip;
}

MeshViewBufferUpload RendererMeshSystem::prepareMeshViewBufferUpload(in f32 fallbackAspectRatio)const{
    assert(this.m_meshState.m_meshViewBuffer.valid());

    MeshViewBufferUpload upload;
    upload.viewState = ResolveMeshViewState(fallbackAspectRatio, this.m_world);
    upload.uploadRequired = MeshViewStatePolicy().uploadRequired(this.m_meshState.m_meshViewGpuDataValid, this.m_meshState.m_meshViewGpuData, upload.viewState);
    return upload;
}

void RendererMeshSystem::confirmMeshViewBufferUpload(in MeshViewGpuData viewState){
    MeshViewStatePolicy().storeConfirmed(viewState, this.m_meshState.m_meshViewGpuData, this.m_meshState.m_meshViewGpuDataValid);
}


