    EXPECT_TRUE(self.send(MakeUiContextMenuKey(CoreKey::Menu)).commandConsumed);
    EXPECT_TRUE(self.release(CoreKey::Menu).commandConsumed);
    ASSERT_TRUE(self.take().has_value());
}

