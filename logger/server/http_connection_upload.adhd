#include <logger/server/server_values.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> ServerUploadKind{
    LogMessage = 0,
    Crash = 1,
    Telemetry = 2,
    kCount
}

b8 CanAppendConnectionUploadBytes(in usize currentSize, in usize appendSize){
    return appendSize <= usize.max - currentSize;
}


