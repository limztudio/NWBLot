#include <impl/ecs_ui/edit_box_host.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ShouldCancelUnfocusedUiEditTransfers(
    in b8 focused,
    in UiTextEditOwner focusedOwner,
    in b8 sessionValid,
    in UiTextEditOwner sessionOwner,
    in b8 clipboardPending,
    in UiTextEditOwner clipboardOwner,
    in b8 primaryPending,
    in UiTextEditOwner primaryOwner
){
    return (sessionValid && (!focused || focusedOwner != sessionOwner))
        || (clipboardPending && (!focused || focusedOwner != clipboardOwner))
        || (primaryPending && (!focused || focusedOwner != primaryOwner));
}

u64 AdvanceUiEditSelectionSequence(mut u64 inOutSelectionSequence){
    AdvanceNonWrappingRevision(inOutSelectionSequence);
    return inOutSelectionSequence;
}

b8 ResolveNextUiEditCompositionState(
    in b8 currentComposing,
    in UiEditBoxEventKind eventKind,
    in u8 nativeEventKind,
    in u8 preeditEventKind,
    in u8 cancelledEventKind,
    in u8 commitEventKind,
    in b8 nativeTextEmpty,
    in b8 isCancelCommand
){
    if(eventKind == UiEditBoxEventKind::Native){
        if(nativeEventKind == preeditEventKind)
            return !nativeTextEmpty;
        if(nativeEventKind == cancelledEventKind || (nativeEventKind == commitEventKind && !nativeTextEmpty))
            return false;
        return currentComposing;
    }
    if(eventKind == UiEditBoxEventKind::Command && isCancelCommand)
        return false;
    return currentComposing;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


EditBoxResult UiEditBoxHost::editNavigated(
    in WidgetState widget,
    in EditBoxOptions options,
    in PopupToken popup,
    mut EditModel model,
    mut EditNavigationState navigation,
    mut IEditNavigationResolver resolver,
    mut IEditActionSink actions
){
    UiEditNavigationBorrow borrowed(navigation, resolver);
    return this.editBorrowed(widget, options, popup, model, Optional<mut IEditActionSink>(actions), Optional<mut UiEditNavigationBorrow>(borrowed));
}

b8 UiEditBoxHost::publish(in WidgetState widget, in EditBoxView view, in EditBoxPlacement placement, in EditBoxOptions options){
    if(this.rejectBorrowedMutation())
        return false;
    auto entry = this.findEntry(widget.id);
    if(!entry.has_value() || entry.value().owner.declarationGeneration != widget.declarationGeneration || entry.value().popup != this.m_context.popupToken() || !view.ready())
        return false;
    UiEditGeometry().publish(
        entry.value().popup,
        placement,
        view.sharedCaretStopTable(),
        view.textMode(),
        options,
        this.m_generation,
        entry.value().expected.m_expectedRevision,
        entry.value().expected.m_expectedExternalRevision,
        entry.value().owner.modelGeneration,
        entry.value().candidate
    );
    return true;
}

void UiEditBoxHost::beginFrame(in u64 generation, in DisplayMetrics display){
    if(this.rejectBorrowedMutation())
        return;
    if(this.m_publications.pending() != 0u)
        this.drainPublications();
    this.collectNative();
    this.m_generation = generation;
    this.m_display = display;
}

void UiEditBoxHost::finishFrame(){
    if(this.rejectBorrowedMutation())
        return;
    for(usize index = this.m_entries.size(); index > 0u; --index){
        in auto entry = this.m_entries[index - 1u];
        if(entry.seen == this.m_generation)
            continue;
        if(HasPendingUiEditOwnerTransfer(entry.owner, this.m_session.owner(), this.m_clipboard.pending(), this.m_clipboardOwner, this.m_primary.pending(), this.m_primaryOwner))
            this.cancelTransfers();
        this.discard(entry.owner);
        this.m_entries.erase(this.m_entries.begin() + cast<isize>(index - 1u));
        this.m_focusSyncDirty = true;
    }
    this.synchronizeFocus();
}

void UiEditBoxHost::commitFrame(in u64 generation){
    if(this.rejectBorrowedMutation())
        return;
    if(this.m_context.input().layoutGeneration() != generation)
        return;
    for(mut auto entry : this.m_entries){
        if(UiEditGeometry().commit(generation, entry.candidate, entry.displayed))
            this.m_focusSyncDirty = true;
    }
    if(this.m_session.token().valid()){
        const auto entry = this.findEntry(this.m_session.owner().widget);
        if(entry.has_value() && entry.value().owner == this.m_session.owner() && entry.value().displayed.generation == generation){
            const auto status = this.m_textInput.updateCaret(this.m_session.token(), this.nativeCaret(entry.value().displayed));
            if(status != TextInputAdmission::Accepted && !this.m_session.cancel())
                TerminateInvariant();
        }
    }
    this.synchronizeFocus();
}

void UiEditBoxHost::collectNative(){
    if(this.rejectBorrowedMutation())
        return;
    for(usize index = 0u; this.m_session.token().valid() && index <= s_TextInputMaxEvents; ++index){
        UiEditBoxEvent event = this.makeEvent();
        const auto poll = this.m_session.pollOwned(event.native);
        if(poll == TextInputPollResult::Pending)
            return;
        if(poll != TextInputPollResult::Event){
            this.discard(this.m_session.owner());
            if(!this.m_session.cancel())
                TerminateInvariant();
            return;
        }
        if(index == s_TextInputMaxEvents || event.native.token != this.m_session.token() || event.native.sequence <= this.m_lastNativeSequence){
            this.reset();
            return;
        }
        this.m_lastNativeSequence = event.native.sequence;
        this.m_clickTracker.cancel();
        event.owner = this.m_session.owner();
        const auto entry = this.findEntry(event.owner.widget);
        if(entry.has_value() && entry.value().owner == event.owner)
            event.focusGeneration = entry.value().focusGeneration;
        event.kind = UiEditBoxEventKind::Native;
        event.surroundingRevision = this.m_session.surroundingRevision();
        event.surroundingModelRevision = this.m_nativePublished.revision;
        event.surroundingSelectionGeneration = this.m_nativePublished.selectionGeneration;
        event.geometryExternalRevision = this.m_nativePublished.externalRevision;
        event.surroundingAnchor = this.m_nativePublished.anchor;
        event.surroundingCaret = this.m_nativePublished.caret;
        if(event.native.kind == TextInputEventKind::Preedit && !event.native.text.empty())
            this.m_context.input().cancelSubmitCommands(event.owner.widget);
        if(!this.append(event))
            return;
    }
}

b8 UiEditBoxHost::prepareSubmit(in InputEvent event){
    if(this.rejectBorrowedMutation() || !this.m_context.input().canSubmitCommand(event))
        return false;
    const auto entry = this.findEntry(this.m_context.input().focus());
    if(!entry.has_value() || !this.hasTextFocus())
        return false;
    InputCommandIntent intent;
    intent.command = event.command;
    intent.extend = event.extend;
    intent.edit = event.edit;
    if(TranslateEditCommand(intent, false, entry.value().displayed.textMode).command != EditCommand::Submit)
        return false;
    if(this.compositionActive(entry.value())){
        this.m_context.input().cancelSubmitCommands(entry.value().widget.id);
        return false;
    }
    return true;
}

void UiEditBoxHost::input(in InputEvent input, in WidgetId previousCapture, in b8 submit){
    if(this.rejectBorrowedMutation())
        return;
    const b8 selectionRelease = input.type == InputEventType::PrimaryUp && input.source == this.m_selectionSource;
    UiEditSelectionRelease finishSelection(this.m_activeSelectionSequence, this.m_selectionSource, selectionRelease);

    if(input.type == InputEventType::FocusLost){
        this.reset();
        return;
    }
    this.synchronizeFocus();
    if(input.type == InputEventType::PointerMove && this.m_activeSelectionSequence != 0u && input.source == this.m_selectionSource)
        this.m_clickTracker.move(input.position);
    if(input.type == InputEventType::PointerCaptureLost){
        if(this.m_activeSelectionSequence == 0u || input.source != this.m_selectionSource)
            return;
        this.m_clickTracker.cancel();
        for(mut auto entry : this.m_entries){
            entry.dragging = false;
            entry.dragMode = UiEditClickKind::Caret;
        }
        for(usize index = this.m_events.size(); index > 0u; --index){
            in UiEditBoxEvent event = this.m_events[index - 1u];
            if(event.kind == UiEditBoxEventKind::Selection && event.selectionSequence == this.m_activeSelectionSequence && event.selectionSource == input.source)
                this.m_events.erase(this.m_events.begin() + cast<isize>(index - 1u));
        }
        this.m_activeSelectionSequence = 0u;
        this.m_selectionSource = InputSource();
        return;
    }
    if(input.type == InputEventType::CommandDown || input.type == InputEventType::CommandUp){
        this.m_clickTracker.cancel();
        auto entry = this.findEntry(this.m_context.input().focus());
        const b8 released = input.type == InputEventType::CommandUp;
        const b8 acceptTab = !released && input.command == InputCommand::FocusNext && entry.has_value() && entry.value().acceptTab && entry.value().displayed.options.acceptTab;
        if((!input.edit && !acceptTab) || !entry.has_value() || !this.hasTextFocus() || ((released && !submit) || (!released && !this.m_context.input().canEditCommand(input))))
            return;
        UiEditBoxEvent event = this.makeEvent();
        event.owner = entry.value().owner;
        event.focusGeneration = entry.value().focusGeneration;
        if(released)
            event.command.command = EditCommand::Submit;
        else if(acceptTab){
            event.command = EditCommandRequest();
            event.command.command = EditCommand::InsertTab;
            event.command.repeat = input.repeat;
        }
        else{
            InputCommandIntent intent;
            intent.command = input.command;
            intent.extend = input.extend;
            intent.edit = input.edit;
            event.command = TranslateEditCommand(intent, input.repeat, entry.value().displayed.textMode);
            if(event.command.command == EditCommand::Submit){
                if(this.compositionActive(entry.value()))
                    this.m_context.input().cancelSubmitCommands(entry.value().widget.id);
                return;
            }
            const auto navigationDirection = TryTranslateEditNavigation(intent);
            event.navigation = navigationDirection.has_value();
            if(navigationDirection.has_value()){
                event.navigationDirection = navigationDirection.value();
                if(entry.value().navigationInstanceGeneration == 0u || entry.value().displayed.textMode != EditTextMode::Multiline)
                    return;
                event.navigationViewportHeight = entry.value().displayed.placement.content.height;
            }
            else if(event.command.command == EditCommand::None)
                return;
        }
        if(!this.append(event))
            return;
    }
    else if((input.type == InputEventType::PrimaryDown || input.type == InputEventType::PrimaryUp || input.type == InputEventType::PointerMove) && (input.type != InputEventType::PointerMove || previousCapture.valid())){
        if(input.type == InputEventType::PrimaryDown){
            this.m_activeSelectionSequence = AdvanceUiEditSelectionSequence(this.m_selectionSequence);
            this.m_selectionSource = input.source;
        }
        else if(this.m_activeSelectionSequence == 0u || input.source != this.m_selectionSource)
            return;
        WidgetId target = previousCapture;
        if(input.type == InputEventType::PrimaryDown)
            target = this.m_context.input().focus();
        if(input.type == InputEventType::PrimaryDown && this.m_context.input().capture() != target){
            this.m_clickTracker.cancel();
            return;
        }
        auto entry = this.findEntry(target);
        if(!entry.has_value()){
            this.m_clickTracker.cancel();
            return;
        }
        const auto byte = UiEditGeometry().hitCaret(entry.value().displayed, entry.value().owner, entry.value().popup, input.position);
        if(!byte.has_value()){
            this.m_clickTracker.cancel();
            return;
        }
        const auto wordByte = UiEditGeometry().hitWord(entry.value().displayed, entry.value().owner, entry.value().popup, input.position);
        if(!wordByte.has_value()){
            this.m_clickTracker.cancel();
            return;
        }
        UiEditBoxEvent event = this.makeEvent();
        event.owner = entry.value().owner;
        event.focusGeneration = entry.value().focusGeneration;
        event.kind = UiEditBoxEventKind::Selection;
        event.selectionSequence = this.m_activeSelectionSequence;
        event.selectionSource = this.m_selectionSource;
        event.position = byte.value();
        event.wordPosition = wordByte.value();
        event.geometryRevision = entry.value().displayed.revision;
        event.geometryExternalRevision = entry.value().displayed.externalRevision;
        event.extend = input.extend;
        event.dragging = input.type != InputEventType::PrimaryDown;
        event.completed = input.type == InputEventType::PrimaryUp;
        if(input.type == InputEventType::PrimaryDown){
            u64 clickTimestampMs = 0u;
            if(input.hoverCapable)
                clickTimestampMs = input.timestampMs;
            event.clickKind = this.m_clickTracker.press(entry.value().owner, entry.value().popup, entry.value().displayed.revision, entry.value().displayed.externalRevision, input.position, clickTimestampMs, input.extend);
        }
        else if(input.type == InputEventType::PrimaryUp)
            this.m_clickTracker.release(entry.value().owner);
        if(!this.append(event))
            return;
    }
    else if(input.type == InputEventType::PointerLeave || input.type == InputEventType::SecondaryDown)
        this.m_clickTracker.cancel();
    this.synchronizeFocus();
}

b8 UiEditBoxHost::character(in u32 unicode){
    if(this.rejectBorrowedMutation())
        return false;
    this.synchronizeFocus();
    if(!this.hasTextFocus())
        return false;
    if(this.m_session.token().valid())
        return true;
    if(!IsTextInputCodePoint(unicode))
        return true;
    in UiEditBoxEntry entry = this.findEntry(this.m_context.input().focus()).value();
    UiEditBoxEvent event = this.makeEvent();
    event.kind = UiEditBoxEventKind::Character;
    event.owner = entry.owner;
    event.focusGeneration = entry.focusGeneration;
    if(!EncodeUtf8CodePoint(unicode, event.native.text))
        return true;
    this.m_clickTracker.cancel();
    if(!this.append(event))
        return true;
    return true;
}

b8 UiEditBoxHost::pastePrimary(in Point position){
    if(this.rejectBorrowedMutation())
        return false;
    this.synchronizeFocus();
    const WidgetId target = this.m_context.input().hitTest(position);
    auto entry = this.findEntry(target);
    if(!entry.has_value() || !this.hasTextFocus() || this.m_context.input().focus() != target)
        return false;
    this.m_clickTracker.cancel();
    UiEditBoxEvent event = this.makeEvent();
    event.owner = entry.value().owner;
    event.focusGeneration = entry.value().focusGeneration;
    event.kind = UiEditBoxEventKind::PastePrimary;
    return this.append(event);
}

b8 UiEditBoxHost::hasTextFocus()const{
    return this.focusedTextEntry().has_value();
}

b8 UiEditBoxHost::wantsTextInput()const{
    if(!this.m_context.input().windowFocused())
        return false;
    const auto entry = this.focusedTextEntry();
    return entry.has_value() && !entry.value().displayed.options.readOnly;
}

b8 UiEditBoxHost::takeClipboardFailure(){
    if(this.rejectBorrowedMutation())
        return false;
    const b8 failed = this.m_clipboardFailure;
    this.m_clipboardFailure = false;
    return failed;
}

void UiEditBoxHost::synchronizeFocus(){
    if(this.rejectBorrowedMutation())
        return;
    const WidgetId currentFocus = this.m_context.input().focus();
    const u64 currentLayoutGeneration = this.m_context.input().layoutGeneration();
    if(
        !this.m_focusSyncDirty
        && this.m_syncedFocusId == currentFocus
        && this.m_syncedLayoutGeneration == currentLayoutGeneration
        && !this.m_session.token().valid()
        && !this.m_clipboard.pending()
        && !this.m_primary.pending()
    )
        return;
    const auto entry = this.focusedTextEntry();
    const b8 focused = entry.has_value();
    UiTextEditOwner focusedOwner;
    if(focused)
        focusedOwner = entry.value().owner;
    this.m_clickTracker.retainFocus(focusedOwner);
    for(mut auto candidate : this.m_entries){
        const b8 active = focused && candidate.owner == entry.value().owner;
        if(candidate.actionCapable){
            if(active && !candidate.focused){
                candidate.focused = true;
                candidate.focusGeneration = this.nextFocusGeneration();
                if(candidate.navigationInstanceGeneration != 0u){
                    UiEditBoxEvent event = this.makeEvent();
                    event.owner = candidate.owner;
                    event.focusGeneration = candidate.focusGeneration;
                    event.kind = UiEditBoxEventKind::Focus;
                    if(!this.append(event))
                        return;
                }
            }
            else if(!active && candidate.focused){
                UiEditBoxEvent event = this.makeEvent();
                event.owner = candidate.owner;
                event.focusGeneration = candidate.focusGeneration;
                event.kind = UiEditBoxEventKind::Blur;
                candidate.focused = false;
                if(!this.append(event))
                    return;
            }
        }
        if(active)
            continue;
        if(!candidate.actionCapable && !this.m_events.empty())
            this.discard(candidate.owner);
        candidate.dragging = false;
        candidate.dragMode = UiEditClickKind::Caret;
    }
    if(ShouldCancelUnfocusedUiEditTransfers(focused, focusedOwner, this.m_session.token().valid(), this.m_session.owner(), this.m_clipboard.pending(), this.m_clipboardOwner, this.m_primary.pending(), this.m_primaryOwner))
        this.cancelTransfers();
    this.m_syncedFocusId = currentFocus;
    this.m_syncedLayoutGeneration = currentLayoutGeneration;
    this.m_focusSyncDirty = false;
}

void UiEditBoxHost::reset(){
    if(this.rejectBorrowedMutation())
        return;
    this.cancelTransfers();
    this.m_clickTracker.cancel();
    this.m_activeSelectionSequence = 0u;
    this.m_selectionSource = InputSource();
    this.m_entries.clear();
    this.m_events.clear();
    this.m_queuedTextBytes = 0u;
    this.m_context.input().clearFocus();
    this.m_syncedFocusId = WidgetId();
    this.m_syncedLayoutGeneration = 0u;
    this.m_focusSyncDirty = true;
}

Optional<mut UiEditBoxEntry> UiEditBoxHost::findEntry(in WidgetId widget){
    for(usize index = 0u; index < this.m_entries.size(); ++index){
        if(this.m_entries[index].widget.id == widget)
            return Optional<mut UiEditBoxEntry>(this.m_entries[index]);
    }
    return Optional<mut UiEditBoxEntry>();
}

Optional<in UiEditBoxEntry> UiEditBoxHost::findConstEntry(in WidgetId widget)const{
    for(usize index = 0u; index < this.m_entries.size(); ++index){
        if(this.m_entries[index].widget.id == widget)
            return Optional<in UiEditBoxEntry>(this.m_entries[index]);
    }
    return Optional<in UiEditBoxEntry>();
}

Optional<in UiEditBoxEntry> UiEditBoxHost::focusedTextEntry()const{
    const WidgetId focus = this.m_context.input().focus();
    if(!focus.valid())
        return Optional<in UiEditBoxEntry>();
    const auto entry = this.findConstEntry(focus);
    if(!entry.has_value() || !UiEditGeometry().focusedReady(entry.value().displayed, entry.value().owner, entry.value().popup))
        return Optional<in UiEditBoxEntry>();
    const auto target = this.m_context.input().findTarget(entry.value().widget.id, entry.value().owner.declarationGeneration);
    if(target.has_value() && target.value().enabled && target.value().textEditable && target.value().popup == entry.value().popup)
        return entry;
    return Optional<in UiEditBoxEntry>();
}

b8 UiEditBoxHost::append(mut UiEditBoxEvent event){
    if(!CanAppendUiEditBoxEvent(this.m_events.size(), s_InputMaxEvents, event.native.text.size(), this.m_queuedTextBytes, s_TextInputMaxQueuedTextBytes)){
        this.reset();
        return false;
    }
    this.m_queuedTextBytes += event.native.text.size();
    this.m_events.emplace_back();
    MoveInto<UiEditBoxEvent>(this.m_events[this.m_events.size() - 1u], event);
    this.m_focusSyncDirty = true;
    return true;
}

b8 UiEditBoxHost::compositionActive(in UiEditBoxEntry entry)const{
    b8 composing = entry.expected.m_expectedComposition.active;
    for(in UiEditBoxEvent event : this.m_events){
        if(event.owner != entry.owner || event.focusGeneration != entry.focusGeneration)
            continue;
        composing = ResolveNextUiEditCompositionState(
            composing,
            event.kind,
            cast<u8>(event.native.kind),
            cast<u8>(TextInputEventKind::Preedit),
            cast<u8>(TextInputEventKind::Cancelled),
            cast<u8>(TextInputEventKind::Commit),
            event.native.text.empty(),
            event.command.command == EditCommand::Cancel
        );
    }
    return composing;
}

void UiEditBoxHost::discard(in UiTextEditOwner owner){
    for(usize index = this.m_events.size(); index > 0u; --index){
        if(this.m_events[index - 1u].owner == owner){
            this.m_queuedTextBytes -= this.m_events[index - 1u].native.text.size();
            this.m_events.erase(this.m_events.begin() + cast<isize>(index - 1u));
        }
    }
}

b8 UiEditBoxHost::rejectBorrowedMutation(){
    if(!this.m_borrowed)
        return false;
    this.m_borrowRejected = true;
    return true;
}

u64 UiEditBoxHost::nextFocusGeneration(){
    return AdvanceUiEditFocusGeneration(this.m_focusGeneration);
}

void UiEditBoxHost::cancelTransfers(){
    const b8 text = this.m_session.cancel();
    const b8 clipboard = this.m_clipboard.cancel();
    const b8 primary = this.m_primary.cancel();
    if(!text || !clipboard || !primary)
        TerminateInvariant();
}

void UiEditBoxHost::drainPublications(){
    const auto completion = this.m_publications.drain();
    this.m_clipboardFailure |= completion.failed != 0u || completion.status == UiClipboardPublicationStatus::WrongThread;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

