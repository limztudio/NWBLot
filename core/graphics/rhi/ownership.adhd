native{
#include <core/graphics/rhi/command.h>
namespace NWB::Core{
using ResourceOwnershipQueue = GpuPhysicalQueueId;
};
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 MatchesResourceStateOwnership(in ResourceOwnershipQueue ownerQueue, in ResourceOwnershipQueue releaseDestinationQueue, in ResourceOwnershipQueue expectedOwnerQueue, in ResourceOwnershipQueue expectedReleaseDestinationQueue){
    if(ownerQueue != expectedOwnerQueue)
        return false;
    if(expectedOwnerQueue == expectedReleaseDestinationQueue)
        return !releaseDestinationQueue.valid();
    return releaseDestinationQueue == expectedReleaseDestinationQueue;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

