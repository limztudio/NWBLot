class PointerBinding{
    public PointerBinding(){
        this.intent = PointerIntent::Activate;
        this.hoverCapable = false;
    }

    public PointerBinding(in InputSource inSource, in PointerIntent inIntent, in b8 inHoverCapable){
        this.source = inSource;
        this.intent = inIntent;
        this.hoverCapable = inHoverCapable;
    }

    public InputSource source;
    public PointerIntent intent;
    public b8 hoverCapable;
}

class PointerSource{
    public PointerSource(){
        this.intent = PointerIntent::Activate;
        this.consumed = false;
        this.inert = false;
    }

    public PointerSource(in InputSource inSource, in PointerIntent inIntent, in b8 inConsumed, in b8 inInert){
        this.source = inSource;
        this.intent = inIntent;
        this.consumed = inConsumed;
        this.inert = inInert;
    }

    public InputSource source;
    public PointerIntent intent;
    public b8 consumed;
    public b8 inert;
}

class PointerSourceKey{
    public PointerSourceKey(){
        this.device = 0u;
        this.control = 0u;
        this.intent = PointerIntent::Activate;
    }

    public PointerSourceKey(in InputSource inSource, in PointerIntent inIntent){
        this.device = inSource.device;
        this.control = inSource.control;
        this.intent = inIntent;
    }

    public b8 operator==(in PointerSourceKey rhs)const{
        return this.device == rhs.device && this.control == rhs.control && this.intent == rhs.intent;
    }

    public usize hash()const{
        usize seed = HashValue(this.device);
        seed = HashCombineValue(seed, this.control);
        return HashCombineValue(seed, cast<u8>(this.intent));
    }

    public u64 device;
    public u64 control;
    public PointerIntent intent;
}

class IndexedPointerEntryTable<T> : NoCopy{
    public void reserve(in usize capacity){
        this.m_entries.reserve(capacity);
    }

    public b8 empty()const{ return this.m_entries.empty(); }
    public usize size()const{ return this.m_entries.size(); }
    public Span<T> span()const{ return Span<T>(this.m_entries); }
    public in T at(in usize index)const{ return this.m_entries[index]; }
    public b8 hasIndexedLookup()const{ return this.m_indexActive; }

    public Expected<usize> findIndexedIndex(in InputSource source, in PointerIntent intent)const{
        const auto found = this.m_index.find(PointerSourceKey(source, intent));
        if(found == this.m_index.end())
            return MakeUnexpected(Failure());
        return cast<usize>(found.value());
    }

    public Expected<usize> findIndex(in InputSource source, in PointerIntent intent)const{
        if(this.m_indexActive)
            return this.findIndexedIndex(source, intent);
        for(usize index = 0u; index < this.m_entries.size(); ++index){
            if(this.m_entries[index].source == source && this.m_entries[index].intent == intent)
                return index;
        }
        return MakeUnexpected(Failure());
    }

    public void pushBack(in T entry){
        const usize newIndex = this.m_entries.size();
        this.m_entries.push_back(entry);
        if(this.m_entries.size() > s_InputSourceReserve){
            if(!this.m_indexActive){
                this.m_index.reserve(s_InputMaxSources);
                for(usize i = 0u; i < this.m_entries.size(); ++i){
                    in T item = this.m_entries[i];
                    this.m_index.try_emplace(PointerSourceKey(item.source, item.intent), cast<u32>(i));
                }
                this.m_indexActive = true;
            }
            else
                this.m_index.try_emplace(PointerSourceKey(entry.source, entry.intent), cast<u32>(newIndex));
        }
    }

    public void eraseAt(in usize index){
        if(index >= this.m_entries.size())
            return;
        if(this.m_indexActive)
            this.m_index.erase(PointerSourceKey(this.m_entries[index].source, this.m_entries[index].intent));
        for(usize moveIndex = index + 1u; moveIndex < this.m_entries.size(); ++moveIndex){
            this.m_entries[moveIndex - 1u] = this.m_entries[moveIndex];
            if(this.m_indexActive){
                const auto it = this.m_index.find(PointerSourceKey(this.m_entries[moveIndex - 1u].source, this.m_entries[moveIndex - 1u].intent));
                if(it != this.m_index.end())
                    it.value() = cast<u32>(moveIndex - 1u);
            }
        }
        this.m_entries.pop_back();
        if(this.m_indexActive && this.m_entries.size() <= s_InputSourceReserve){
            this.m_index.clear();
            this.m_indexActive = false;
        }
    }

    public void retainSourceNotEqual(in InputSource source){
        this.retainNotEqual(true, source, 0u);
    }

    public void retainDeviceNotEqual(in u64 device){
        this.retainNotEqual(false, InputSource(), device);
    }

    private void retainNotEqual(in b8 matchSource, in InputSource source, in u64 device){
        usize kept = 0u;
        for(usize index = 0u; index < this.m_entries.size(); ++index){
            in T entry = this.m_entries[index];
            b8 keep = false;
            if(matchSource)
                keep = entry.source != source;
            else
                keep = entry.source.device != device;
            if(keep){
                if(kept != index)
                    this.m_entries[kept] = entry;
                if(this.m_indexActive){
                    const auto it = this.m_index.find(PointerSourceKey(entry.source, entry.intent));
                    if(it != this.m_index.end())
                        it.value() = cast<u32>(kept);
                }
                ++kept;
            }
            else if(this.m_indexActive)
                this.m_index.erase(PointerSourceKey(entry.source, entry.intent));
        }
        this.m_entries.resize(kept);
        if(this.m_indexActive && this.m_entries.size() <= s_InputSourceReserve){
            this.m_index.clear();
            this.m_indexActive = false;
        }
    }

    private Vector<T> m_entries;
    private HashMap<PointerSourceKey, u32> m_index;
    private b8 m_indexActive = false;
}

class PointerSourceTable : NoCopy{
    public void reserve(in usize capacity){ this.m_table.reserve(capacity); }
    public b8 empty()const{ return this.m_table.empty(); }
    public usize size()const{ return this.m_table.size(); }
    public Span<PointerSource> span()const{ return this.m_table.span(); }
    public in PointerSource at(in usize index)const{ return this.m_table.at(index); }
    public Expected<usize> findIndex(in InputSource source, in PointerIntent intent)const{ return this.m_table.findIndex(source, intent); }
    public void pushBack(in PointerSource entry){ this.m_table.pushBack(entry); }
    public void eraseAt(in usize index){ this.m_table.eraseAt(index); }
    public void retainSourceNotEqual(in InputSource source){ this.m_table.retainSourceNotEqual(source); }
    public void retainDeviceNotEqual(in u64 device){ this.m_table.retainDeviceNotEqual(device); }

    public b8 hasInertSource(in InputSource source)const{
        if(this.m_table.hasIndexedLookup()){
            const auto activateIdx = this.m_table.findIndexedIndex(source, PointerIntent::Activate);
            if(activateIdx.has_value() && this.m_table.at(activateIdx.value()).inert)
                return true;
            const auto contextIdx = this.m_table.findIndexedIndex(source, PointerIntent::ContextMenu);
            return contextIdx.has_value() && this.m_table.at(contextIdx.value()).inert;
        }
        for(in PointerSource held : this.m_table.span()){
            if(held.source == source && held.inert)
                return true;
        }
        return false;
    }

    public b8 hasAnyConsumed()const{
        for(in PointerSource held : this.m_table.span()){
            if(held.consumed)
                return true;
        }
        return false;
    }

    public b8 hasSource(in InputSource source)const{
        if(this.m_table.hasIndexedLookup()){
            return this.m_table.findIndexedIndex(source, PointerIntent::Activate).has_value()
                || this.m_table.findIndexedIndex(source, PointerIntent::ContextMenu).has_value();
        }
        for(in PointerSource held : this.m_table.span()){
            if(held.source == source)
                return true;
        }
        return false;
    }

    public void querySourceFlags(in InputSource source, mut b8 outAnyInert, mut b8 outAnyConsumed)const{
        outAnyInert = false;
        outAnyConsumed = false;
        if(this.m_table.hasIndexedLookup()){
            const auto activateIdx = this.m_table.findIndexedIndex(source, PointerIntent::Activate);
            if(activateIdx.has_value()){
                in PointerSource entry = this.m_table.at(activateIdx.value());
                outAnyInert = entry.inert;
                outAnyConsumed = entry.consumed;
            }
            const auto contextIdx = this.m_table.findIndexedIndex(source, PointerIntent::ContextMenu);
            if(contextIdx.has_value()){
                in PointerSource entry = this.m_table.at(contextIdx.value());
                outAnyInert = outAnyInert || entry.inert;
                outAnyConsumed = outAnyConsumed || entry.consumed;
            }
            return;
        }
        u32 matchedCount = 0u;
        for(in PointerSource held : this.m_table.span()){
            if(held.source != source)
                continue;
            if(held.inert)
                outAnyInert = true;
            if(held.consumed)
                outAnyConsumed = true;
            ++matchedCount;
            if(matchedCount == 2u || (outAnyInert && outAnyConsumed))
                break;
        }
    }

    private IndexedPointerEntryTable<PointerSource> m_table;
}

class PointerBindingTable : NoCopy{
    public void reserve(in usize capacity){ this.m_table.reserve(capacity); }
    public usize size()const{ return this.m_table.size(); }
    public in PointerBinding at(in usize index)const{ return this.m_table.at(index); }
    public void pushBack(in PointerBinding entry){ this.m_table.pushBack(entry); }
    public void eraseAt(in usize index){ this.m_table.eraseAt(index); }
    public void retainSourceNotEqual(in InputSource source){ this.m_table.retainSourceNotEqual(source); }
    public void retainDeviceNotEqual(in u64 device){ this.m_table.retainDeviceNotEqual(device); }

    public void findContactAndHeld(in InputSource source, in PointerIntent intent, in b8 needHeld, mut usize outContactIndex, mut usize outHeldIndex)const{
        const usize entryCount = this.m_table.size();
        outContactIndex = entryCount;
        outHeldIndex = entryCount;
        if(this.m_table.hasIndexedLookup()){
            const auto heldIdx = this.m_table.findIndexedIndex(source, intent);
            if(heldIdx.has_value())
                outHeldIndex = heldIdx.value();
            PointerIntent otherIntent = PointerIntent::ContextMenu;
            if(intent == PointerIntent::ContextMenu)
                otherIntent = PointerIntent::Activate;
            const auto otherIdx = this.m_table.findIndexedIndex(source, otherIntent);
            if(outHeldIndex != entryCount){
                outContactIndex = outHeldIndex;
                if(otherIdx.has_value() && otherIdx.value() < outContactIndex)
                    outContactIndex = otherIdx.value();
            }
            else if(otherIdx.has_value())
                outContactIndex = otherIdx.value();
            return;
        }
        for(usize index = 0u; index < entryCount; ++index){
            if(this.m_table.at(index).source == source){
                if(outContactIndex == entryCount){
                    outContactIndex = index;
                    if(!needHeld)
                        break;
                }
                if(this.m_table.at(index).intent == intent && outHeldIndex == entryCount){
                    outHeldIndex = index;
                    break;
                }
            }
        }
    }

    private IndexedPointerEntryTable<PointerBinding> m_table;
}

class ContextOwnedPopup{
    public PopupScope scope;
    public WidgetRoot root;
}

class PopupDismissRequest{
    public PopupToken expectedTop;
    public PopupDismissReason reason = PopupDismissReason::OutsideClick;
    public WidgetId restoreFocus;
    public u64 restoreDeclaration = 0u;
    public PopupToken restorePopup;
    public b8 requested = false;
    public b8 replaceRestore = false;
}

class InputPopupRetirement{
    public PopupRecord restore;
    public b8 top = false;
}

class InputPointerRouteEffects{
    public PopupDismissRequest popupDismissal;
    public b8 advanceHover = false;
    public b8 dismissedPopup = false;
    public b8 ok = true;
}


