#include <impl/ecs_render/kernel/renderer_format_private.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Name s_AvboitDepthWarpShaderDebugName = "ECSRender_AvboitDepthWarpCS";
const Name s_AvboitIntegrateShaderDebugName = "ECSRender_AvboitIntegrateCS";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererAvboitState : NoCopy{
    public KernelSamplerHandle m_linearSampler = KernelSamplerHandle();
    public KernelShaderHandle m_depthWarpComputeShader = KernelShaderHandle();
    public KernelShaderHandle m_integrateComputeShader = KernelShaderHandle();
    public KernelComputePipelineHandle m_depthWarpPipeline = KernelComputePipelineHandle();
    public KernelComputePipelineHandle m_integratePipeline = KernelComputePipelineHandle();
    public b8 m_targetsNeedClear = true;

    public void invalidateResources(){
        this.m_linearSampler.reset();
        this.m_depthWarpComputeShader.reset();
        this.m_integrateComputeShader.reset();
        this.m_depthWarpPipeline.reset();
        this.m_integratePipeline.reset();
        this.m_targetsNeedClear = true;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

