UiSearchComboSmokeScene::UiSearchComboSmokeScene(mut GlobalArena arena){
    this.m_source = UiSearchComboSmokeSource(arena);
    this.m_state = SearchComboState(arena);
    this.m_selectionView = EditBoxView(arena);
}

b8 UiSearchComboSmokeScene::paint(mut UiPaintContext context){
    ObserveSmokeDisplay(s_UiSearchComboSmokeTag, context.display, this.m_lastDisplay, this.m_displayChanged);
    this.m_source.beginFrame();
    this.m_focused = false;
    context.ui.style().fontSize = 12.0f;
    context.ui.style().gap = 8.0f;
    context.ui.listStyle().padding = MakeUniformSmokeInsets(8.0f);
    if(!context.ui.beginPanel("search_combo_fixture", Rect(24.0f, 24.0f, 400.0f, 160.0f)))
        return false;
    const WidgetOptions title = MakeFixedHeightSmokeWidget(24.0f);
    if(!context.ui.label("title", "Search 100000 rows by numeric prefix", title))
        return false;
    SearchComboOptions options();
    options.combo.height.policy = LayoutSizePolicy::Fixed;
    options.combo.height.value = 36.0f;
    options.combo.popupHeight = 280.0f;
    options.combo.enabled = this.m_enabled;
    const SearchComboResult result = context.ui.searchComboBox("choice", this.m_source, this.m_state, options);
    if(!result.combo.valid)
        return false;
    this.m_focused = result.combo.focused;
    if(result.combo.committed)
        ++this.m_commits;
    if(!context.ui.label("hint", "Type 12 or 5 / Arrows preview / Enter commit", title) || !context.ui.endPanel())
        return false;
    if(!context.ui.beginPanel("outside_fixture", Rect(448.0f, 24.0f, 146.0f, 52.0f)))
        return false;
    const WidgetOptions counter = MakeFixedSmokeWidget(130.0f, 36.0f);
    if(context.ui.button("underlying", "Outside counter", counter))
        ++this.m_underlying;
    if(!context.ui.endPanel())
        return false;
    this.observeState(context.text);
    const Array<u64, 22u> markerValues = this.values();
    PaintKeyedSmokeValueMarkersDefault(markerValues, cast<u64>(this.m_sequence), 12u, 8u, context);
    return true;
}

b8 UiSearchComboSmokeScene::keyboardUpdate(in i32 key, in i32 scancode, in i32 action, in i32 mods){
    if(key < s_SmokeKeyF4 || key > s_SmokeKeyF9)
        return false;
    if(action != s_SmokeActionPress)
        return true;
    if(key == s_SmokeKeyF4){
        this.m_state.combo().select(100000u);
    }
    else if(key == s_SmokeKeyF5){
        this.m_source.reverse();
    }
    else if(key == s_SmokeKeyF6){
        this.m_source.remove(this.m_state.combo().selectedKey());
    }
    else if(key == s_SmokeKeyF7){
        const b8 cleared = this.m_state.query().setText("");
        [essential] assert(cleared, "UI search combo query clear must succeed");
    }
    else if(key == s_SmokeKeyF9){
        this.m_enabled = !this.m_enabled;
    }
    return true;
}

Array<u64, 22u> UiSearchComboSmokeScene::values()const{
    const ScrollPlacement placement = this.m_state.combo().listState().placement();
    Array<u64, 22u> out;
    out[0u] = this.m_state.combo().selectedKey();
    out[1u] = this.m_state.combo().listState().cursorKey();
    out[2u] = this.m_source.rowCount();
    out[3u] = this.m_source.filtered().rowCount();
    out[4u] = placement.firstRow;
    out[5u] = placement.endRow;
    out[6u] = cast<u64>(this.m_source.labelReads());
    out[7u] = cast<u64>(this.m_state.combo().isOpen());
    out[8u] = cast<u64>(this.m_state.query().text().size());
    out[9u] = cast<u64>(ComputeFnv32TextHash(this.m_state.query().text()) & s_SmokeMarker24BitMask);
    out[10u] = cast<u64>(this.m_state.query().anchor());
    out[11u] = cast<u64>(this.m_state.query().caret());
    out[12u] = cast<u64>(this.m_state.editorState().focused);
    out[13u] = cast<u64>(this.m_focused);
    out[14u] = cast<u64>(this.m_commits);
    out[15u] = this.m_source.filtered().revision();
    out[16u] = cast<u64>(this.m_source.reversed());
    out[17u] = this.m_source.removedKey();
    out[18u] = cast<u64>(this.m_enabled);
    out[19u] = this.m_source.revision();
    out[20u] = cast<u64>(this.m_underlying);
    out[21u] = cast<u64>(this.m_state.query().composition().active);
    return out;
}

Rect UiSearchComboSmokeScene::cursorRow()const{
    const ScrollPlacement placement = this.m_state.combo().listState().placement();
    if(!this.m_state.combo().isOpen())
        return Rect();
    const Expected<u64> index = this.m_source.filtered().indexOf(this.m_state.combo().listState().cursorKey());
    if(!index.has_value() || index.value() < placement.firstRow || index.value() >= placement.endRow)
        return Rect();
    const Expected<Rect> rectangle = SmokeListRowBounds(placement, index.value());
    if(!rectangle.has_value())
        return Rect();
    return rectangle.value();
}

void UiSearchComboSmokeScene::observeState(mut TextService text){
    const Array<u64, 22u> current = this.values();
    const ScrollPlacement placement = this.m_state.combo().listState().placement();
    const PopupPlacement popup = this.m_state.combo().placement();
    const Rect bounds = this.m_state.combo().bounds();
    const EditBoxPlacement editor = this.m_state.editorState().placement;
    if(
        this.m_sequence != 0u
        && !this.m_displayChanged
        && SameSmokeU64Span(current, this.m_lastValues)
        && placement.offset == this.m_lastPlacement.offset
        && placement.contentHeight == this.m_lastPlacement.contentHeight
        && SameSmokeRect(placement.bounds, this.m_lastPlacement.bounds)
        && SameSmokeRect(placement.thumb, this.m_lastPlacement.thumb)
        && SameSmokeRect(popup.bounds, this.m_lastPopup.bounds)
        && SameSmokeRect(bounds, this.m_lastBounds)
        && SameSmokeRect(editor.bounds, this.m_lastQueryBounds)
    )
        return;
    ++this.m_sequence;
    this.m_lastValues = current;
    this.m_lastPlacement = placement;
    this.m_lastPopup = popup;
    this.m_lastBounds = bounds;
    this.m_lastQueryBounds = editor.bounds;
    this.m_displayChanged = false;
    [essential] info(
        "UiSearchComboSmoke: state sequence={} values={},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{}"
        , this.m_sequence
        , current[0u]
        , current[1u]
        , current[2u]
        , current[3u]
        , current[4u]
        , current[5u]
        , current[6u]
        , current[7u]
        , current[8u]
        , current[9u]
        , current[10u]
        , current[11u]
        , current[12u]
        , current[13u]
        , current[14u]
        , current[15u]
        , current[16u]
        , current[17u]
        , current[18u]
        , current[19u]
        , current[20u]
        , current[21u]
    );
    LogSmokeRect(s_UiSearchComboSmokeTag, this.m_sequence, "trigger", bounds);
    LogSmokeRect(s_UiSearchComboSmokeTag, this.m_sequence, "popup", popup.bounds);
    LogSmokeRect(s_UiSearchComboSmokeTag, this.m_sequence, "list", placement.bounds);
    LogSmokeRect(s_UiSearchComboSmokeTag, this.m_sequence, "viewport", placement.viewport);
    const Expected<Rect> first = SmokeListRowBounds(placement, placement.firstRow);
    Rect firstRect();
    if(first.has_value())
        firstRect = first.value();
    LogSmokeRect(s_UiSearchComboSmokeTag, this.m_sequence, "first_row", firstRect);
    LogSmokeRect(s_UiSearchComboSmokeTag, this.m_sequence, "track", placement.track);
    LogSmokeRect(s_UiSearchComboSmokeTag, this.m_sequence, "thumb", placement.thumb);
    LogSmokeRect(s_UiSearchComboSmokeTag, this.m_sequence, "cursor_row", this.cursorRow());
    LogSmokeRect(s_UiSearchComboSmokeTag, this.m_sequence, "counter", Rect(456.0f, 32.0f, 130.0f, 36.0f));
    LogSmokeRect(s_UiSearchComboSmokeTag, this.m_sequence, "query", editor.bounds);
    LogSmokeRect(s_UiSearchComboSmokeTag, this.m_sequence, "query_content", editor.content);
    LogSmokeRect(s_UiSearchComboSmokeTag, this.m_sequence, "query_caret", editor.caret);
    LogSmokeRect(s_UiSearchComboSmokeTag, this.m_sequence, "query_selection", CaptureEditSelection(this.m_selectionView, text, this.m_state.query(), editor, 12.0f));
}


