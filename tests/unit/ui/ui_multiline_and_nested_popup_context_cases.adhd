    EXPECT_TRUE(self.m_context.failed());
    EXPECT_TRUE(self.m_context.hasPopupScope(parent.scope.token));
    EXPECT_FALSE(self.m_context.finishFrame());
    EXPECT_FALSE(self.m_context.commitFrame(1u));
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 0u);
}

void VerifyUiNestedPopupContextTests_AcceptedChildActionCanOnlyBeConsumedDuringThatChildActivation(mut UiNestedPopupContextTests self){
    ASSERT_TRUE(self.begin(1u));
    const auto parentResult = self.reserve(s_UiNestedPopupContextParentKey);
    ASSERT_TRUE(parentResult.has_value());
    const UiNestedPopupContextPopupDeclaration parent = parentResult.value();
    ASSERT_TRUE(self.m_context.activatePopupScope(parent.scope.token));
    ASSERT_TRUE(self.publish(parent));
    const auto childResult = self.reserve(s_UiNestedPopupContextChildKey, MakeUiMultilinePopupRect(180.0f, 120.0f, 100.0f, 70.0f));
    ASSERT_TRUE(childResult.has_value());
    const UiNestedPopupContextPopupDeclaration child = childResult.value();
    ASSERT_TRUE(self.m_context.activatePopupScope(child.scope.token));
    ASSERT_TRUE(self.publish(child));
    ASSERT_TRUE(self.m_context.endPopupScope(true));
    ASSERT_TRUE(self.m_context.endPopupScope(true));
    ASSERT_TRUE(self.finish());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    EXPECT_TRUE(self.send(MakeUiNestedPopupContextPointerEvent(InputEventType::PrimaryDown, 185.0f, 125.0f)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiNestedPopupContextPointerEvent(InputEventType::PrimaryUp, 185.0f, 125.0f)).pointerConsumed);
    ASSERT_EQ(self.m_context.input().actions().size(), 1u);
    ASSERT_TRUE(self.begin(2u));
    const auto nextParentResult = self.reserve(s_UiNestedPopupContextParentKey);
    ASSERT_TRUE(nextParentResult.has_value());
    const UiNestedPopupContextPopupDeclaration nextParent = nextParentResult.value();
    ASSERT_TRUE(self.m_context.activatePopupScope(nextParent.scope.token));
    const auto nextChildResult = self.reserve(s_UiNestedPopupContextChildKey, child.scope.bounds);
    ASSERT_TRUE(nextChildResult.has_value());
    const UiNestedPopupContextPopupDeclaration nextChild = nextChildResult.value();
    EXPECT_EQ(nextChild.action.id, child.action.id);
    EXPECT_FALSE(self.m_context.takeActivation(nextChild.action, true));
    ASSERT_EQ(self.m_context.input().actions().size(), 1u);
    ASSERT_TRUE(self.m_context.activatePopupScope(nextChild.scope.token));
    EXPECT_TRUE(self.m_context.takeActivation(nextChild.action, true));
    EXPECT_FALSE(self.m_context.takeActivation(nextChild.action, true));
}

void VerifyUiNestedPopupContextTests_EighthNestedActivationIsBoundedAndNinthReservationFails(mut UiNestedPopupContextTests self){
    ASSERT_TRUE(self.begin(1u));
    Array<StringView, 8u> keys = Array<StringView, 8u>();
    keys[0u] = "popup0";
    keys[1u] = "popup1";
    keys[2u] = "popup2";
    keys[3u] = "popup3";
    keys[4u] = "popup4";
    keys[5u] = "popup5";
    keys[6u] = "popup6";
    keys[7u] = "popup7";
    for(usize index = 0u; index < s_InputMaxPopups; ++index){
        const auto popupResult = self.reserve(keys[index]);
        ASSERT_TRUE(popupResult.has_value());
        const UiNestedPopupContextPopupDeclaration popup = popupResult.value();
        ASSERT_TRUE(self.m_context.activatePopupScope(popup.scope.token));
        ASSERT_TRUE(self.publish(popup));
        EXPECT_EQ(self.m_context.popupLayer(), cast<u32>(index + 1u));
    }
    const auto declared = self.declareState("overflow", WidgetKind::Popup);
    ASSERT_TRUE(declared.has_value());
    const WidgetState overflow = declared.value();
    PopupScope scope = PopupScope();
    scope.token = MakeUiNestedPopupContextToken(overflow.id, overflow.declarationGeneration, 901u, 1u);
    scope.parent = self.m_context.popupToken();
    scope.bounds = MakeUiMultilinePopupRect(60.0f, 40.0f, 120.0f, 80.0f);
    scope.viewport = MakeUiMultilinePopupRect(0.0f, 0.0f, 400.0f, 300.0f);
    EXPECT_FALSE(self.m_context.registerPopupScope(overflow, scope));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.finishFrame());
    EXPECT_FALSE(self.m_context.commitFrame(1u));
}


