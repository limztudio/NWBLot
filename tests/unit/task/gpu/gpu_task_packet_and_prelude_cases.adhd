using GpuPayloadLifetimeScope = Core::GpuGraphSubmissionTransaction::PayloadLifetimeScope;

struct GpuPacketResetDiscardFailure{};
struct GpuPacketResetOriginalFailure{};

struct GpuPacketThrowingResetTask{
public:
    struct Payload{
        u32& destructionCount;
        u32& discardCount;
        b8 owned = true;


    public:
        Payload(u32& destructions, u32& discards)noexcept
            : destructionCount(destructions)
            , discardCount(discards)
        {}
        Payload(Payload&& other)noexcept
            : destructionCount(other.destructionCount)
            , discardCount(other.discardCount)
            , owned(other.owned)
        { other.owned = false; }
        ~Payload()noexcept{
            if(owned)
                ++destructionCount;
        }
    };


public:
    static void Discarded(Payload& payload){
        ++payload.discardCount;
        throw GpuPacketResetDiscardFailure{};
    }
};

struct GpuPacketBorrowedPayloadLifetimeTask{
public:
    struct Payload{
        b8& ownerAlive;
        u32& destructionCount;
        u32& discardCount;
        u32& lateUseCount;
        b8 throwOnDiscard = false;
        b8 owned = true;


    public:
        Payload(b8& alive, u32& destructions, u32& discards, u32& lateUses, const b8 throws)noexcept
            : ownerAlive(alive)
            , destructionCount(destructions)
            , discardCount(discards)
            , lateUseCount(lateUses)
            , throwOnDiscard(throws)
        {}
        Payload(Payload&& other)noexcept
            : ownerAlive(other.ownerAlive)
            , destructionCount(other.destructionCount)
            , discardCount(other.discardCount)
            , lateUseCount(other.lateUseCount)
            , throwOnDiscard(other.throwOnDiscard)
            , owned(other.owned)
        { other.owned = false; }
        ~Payload()noexcept{
            if(!owned)
                return;
            if(!ownerAlive)
                ++lateUseCount;
            ++destructionCount;
        }
    };


public:
    static void Discarded(Payload& payload){
        if(!payload.ownerAlive)
            ++payload.lateUseCount;
        ++payload.discardCount;
        if(payload.throwOnDiscard)
            throw GpuPacketResetDiscardFailure{};
    }
};

[[nodiscard]] NWB_INLINE Core::GpuTaskExternalStateSource MakeGpuPacketExternalStateSource(
    const Core::CommandListResourceStateHandoff& stateHandoff
)noexcept{
    return Core::GpuTaskExternalStateSource{ .states = &stateHandoff };
}

[[nodiscard]] NWB_INLINE Expected<Core::GpuTaskId> AddPacketLifecycleDiscardTask(
    Core::GpuTaskGraph& graph,
    const Core::GpuTaskDesc& desc,
    u32& discardedCount
){
    return graph.addTask<PacketLifecycleTask>(desc, PacketLifecycleTask::Payload{ .discardedCount = &discardedCount });
}

[[nodiscard]] NWB_INLINE Expected<Core::GpuTaskId> AddPacketLifecycleTask(
    Core::GpuTaskGraph& graph,
    const Core::GpuTaskDesc& desc,
    u32& acceptedCount,
    u32& discardedCount
){
    return graph.addTask<PacketLifecycleTask>(
        desc,
        PacketLifecycleTask::Payload{ .acceptedCount = &acceptedCount, .discardedCount = &discardedCount }
    );
}

[[nodiscard]] NWB_INLINE Expected<Core::GpuTaskId> AddMalformedLifecycleTask(
    Core::GpuTaskGraph& graph,
    const Core::GpuTaskDesc& desc,
    u32& recordCount,
    u32& acceptedCount,
    u32& discardedCount
){
    return graph.addTask<MalformedLifecycleTask>(
        desc,
        MalformedLifecycleTask::Payload{ .recordCount = &recordCount, .acceptedCount = &acceptedCount, .discardedCount = &discardedCount }
    );
}

[[nodiscard]] NWB_INLINE Expected<Core::GpuTaskId> AddThrowingResetTask(
    Core::GpuTaskGraph& graph,
    const Core::GpuTaskDesc& desc,
    u32& destructionCount,
    u32& discardCount
){
    return graph.addTask<GpuPacketThrowingResetTask>(
        desc,
        GpuPacketThrowingResetTask::Payload(destructionCount, discardCount)
    );
}

[[nodiscard]] NWB_INLINE Expected<Core::GpuTaskId> AddBorrowedPayloadLifetimeTask(
    Core::GpuTaskGraph& graph,
    const Core::GpuTaskDesc& desc,
    b8& ownerAlive,
    u32& destructionCount,
    u32& discardCount,
    u32& lateUseCount,
    const b8 throwOnDiscard
){
    return graph.addTask<GpuPacketBorrowedPayloadLifetimeTask>(
        desc,
        GpuPacketBorrowedPayloadLifetimeTask::Payload(ownerAlive, destructionCount, discardCount, lateUseCount, throwOnDiscard)
    );
}

[[nodiscard]] NWB_INLINE b8 ResetThrowsDiscardFailure(Core::GpuTaskGraph& graph){
    try{
        graph.reset();
        return false;
    }
    catch(const GpuPacketResetDiscardFailure&){
        return true;
    }
}

[[nodiscard]] NWB_INLINE b8 UnwindWithScopeExitResetPreservesOriginalFailure(Core::GpuTaskGraph& graph){
    try{
        ScopeExit resetOnUnwind([&]()noexcept{ graph.reset(); });
        throw GpuPacketResetOriginalFailure{};
    }
    catch(const GpuPacketResetOriginalFailure&){
        return true;
    }
}

[[nodiscard]] NWB_INLINE b8 RetireTwoBorrowedPayloadsCatchesDiscardFailure(
    Core::GpuGraphSubmissionTransaction& transaction,
    Core::GpuTaskGraph& graph,
    Core::GpuCompiledGraph& compiledGraph,
    b8& ownerAlive,
    u32& destructionCount,
    u32& discardCount,
    u32& lateUseCount
){
    b8 bothAdded = false;
    try{
        GpuPayloadLifetimeScope payloadLifetime(transaction, graph, compiledGraph);
        Core::GpuTaskDesc firstDesc;
        firstDesc.setIdentity(s_GpuCaseTaskGraphRetireThrowFirst).setMarkerLabel("Retire Throw First");
        const auto first = AddBorrowedPayloadLifetimeTask(graph, firstDesc, ownerAlive, destructionCount, discardCount, lateUseCount, true);
        if(!first)
            return false;
        Core::GpuTaskDesc secondDesc;
        secondDesc.setIdentity(s_GpuCaseTaskGraphRetireThrowSecond).setMarkerLabel("Retire Throw Second");
        const auto second = AddBorrowedPayloadLifetimeTask(graph, secondDesc, ownerAlive, destructionCount, discardCount, lateUseCount, false);
        bothAdded = second.has_value();
    }
    catch(const GpuPacketResetDiscardFailure&){
        return bothAdded;
    }
    return false;
}

[[nodiscard]] NWB_INLINE b8 UnwindBorrowedPayloadLifetimeCatchesOriginalFailure(
    Core::GpuGraphSubmissionTransaction& transaction,
    Core::GpuTaskGraph& graph,
    Core::GpuCompiledGraph& compiledGraph,
    b8& ownerAlive,
    u32& destructionCount,
    u32& discardCount,
    u32& lateUseCount
){
    try{
        GpuPayloadLifetimeScope payloadLifetime(transaction, graph, compiledGraph);
        Core::GpuTaskDesc desc;
        desc.setIdentity(s_GpuCaseTaskGraphRetirementUnwind).setMarkerLabel("Retirement Unwind");
        const auto task = AddBorrowedPayloadLifetimeTask(graph, desc, ownerAlive, destructionCount, discardCount, lateUseCount, true);
        if(!task)
            return false;
        throw GpuPacketResetOriginalFailure{};
    }
    catch(const GpuPacketResetOriginalFailure&){
        return true;
    }
}

