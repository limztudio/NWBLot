    public void shiftOrigin(mut World world, in VectorDouble delta){
        if(!IsFinite(delta))
            return;
        if(delta.x == 0.0 && delta.y == 0.0 && delta.z == 0.0)
            return;

        this.m_physicsWorld.shiftOrigin(delta);
        const VectorSingle negDelta(cast<f32>(-delta.x), cast<f32>(-delta.y), cast<f32>(-delta.z), 0.0f);
        this.m_environmentScratch.shiftOrigin(negDelta);

        world.view<TransformComponent>().each(
            lambda[in negDelta, mut world](in EntityID entity, mut TransformComponent xf) -> void{
                xf.position = f32x4(VectorSingle(xf.position) + negDelta, 0.0f);
                if(EntityUsesLocalHierarchyTransform(world, entity)){
                    const Optional<mut LocalTransformComponent> localOpt = world.borrowComponent<LocalTransformComponent>(entity);
                    if(localOpt.has_value()){
                        EntityID parent = s_InvalidEntityId;
                        b8 inheritScale = true;
                        if(!TryGetPhysicsOrSceneParent(world, entity, parent, inheritScale) || !parent.valid() || parent == entity || !world.alive(parent) || !world.hasComponent<TransformComponent>(parent))
                            localOpt.value().position = f32x4(VectorSingle(localOpt.value().position) + negDelta, 0.0f);
                    }
                }
            }
        );

        world.view<CharacterControllerComponent>().each(
            lambda[in negDelta](in EntityID entity, mut CharacterControllerComponent cc) -> void{
                cc.controller.shiftOrigin(negDelta);
            }
        );
        world.view<VehicleComponent>().each(
            lambda[in negDelta](in EntityID entity, mut VehicleComponent vc) -> void{
                vc.controller.shiftOrigin(negDelta);
            }
        );
        world.view<RagdollComponent>().each(
            lambda[in negDelta](in EntityID entity, mut RagdollComponent rc) -> void{
                rc.instance.shiftOrigin(negDelta);
            }
        );
        world.view<ArticulationComponent>().each(
            lambda[in negDelta](in EntityID entity, mut ArticulationComponent ac) -> void{
                ac.articulation.shiftOrigin(negDelta);
            }
        );
        world.view<SoftBodyComponent>().each(
            lambda[in negDelta](in EntityID entity, mut SoftBodyComponent sb) -> void{
                sb.softBody.shiftOrigin(negDelta);
            }
        );
        world.view<FractureComponent>().each(
            lambda[in negDelta](in EntityID entity, mut FractureComponent fc) -> void{
                fc.cluster.shiftOrigin(negDelta);
            }
        );

        for(usize i = 0u; i < this.m_bodyTransformSnapshots.size(); ++i){
            mut EcsBodyTransformSnapshot snap = this.m_bodyTransformSnapshots[i];
            snap.prevTransform.position = f32x4(VectorSingle(snap.prevTransform.position) + negDelta, 0.0f);
            snap.currTransform.position = f32x4(VectorSingle(snap.currTransform.position) + negDelta, 0.0f);
        }
        for(in auto kv : this.m_syncScratch.characterSyncStates){
            mut EcsCharacterControllerSyncState cs = this.m_syncScratch.characterSyncStates.at(kv.first);
            cs.prevPosition = f32x4(VectorSingle(cs.prevPosition) + negDelta, 0.0f);
            cs.currPosition = f32x4(VectorSingle(cs.currPosition) + negDelta, 0.0f);
        }
        for(in auto kv : this.m_syncScratch.articulationLiveStates){
            mut EcsArticulationLiveState ls = this.m_syncScratch.articulationLiveStates.at(kv.first);
            ls.prevBaseTransform.position = f32x4(VectorSingle(ls.prevBaseTransform.position) + negDelta, 0.0f);
            ls.currBaseTransform.position = f32x4(VectorSingle(ls.currBaseTransform.position) + negDelta, 0.0f);
            for(usize li = 0u; li < ls.prevLinkWorldTransforms.size(); ++li)
                ls.prevLinkWorldTransforms[li].position = f32x4(VectorSingle(ls.prevLinkWorldTransforms[li].position) + negDelta, 0.0f);
            for(usize li = 0u; li < ls.currLinkWorldTransforms.size(); ++li)
                ls.currLinkWorldTransforms[li].position = f32x4(VectorSingle(ls.currLinkWorldTransforms[li].position) + negDelta, 0.0f);
        }
        for(usize i = 0u; i < this.m_syncScratch.ecsFluidImmersionState.size(); ++i)
            this.m_syncScratch.ecsFluidImmersionState[i].lastPoint = f32x4(VectorSingle(this.m_syncScratch.ecsFluidImmersionState[i].lastPoint) + negDelta, 0.0f);
        this.m_syncScratch.writeBackPoseCache.clear();
    }

    public void shiftOrigin(in VectorDouble delta){
        this.shiftOrigin(this.m_world, delta);
    }

    public b8 captureWorldSnapshot(mut Vector<u8> outBytes){
        this.syncGpuResidentToWorld();
        PhysicsSubsystemsBundle bundle;
        bundle.environment = this.m_environmentScratch;
        Vector<EntityID> sortedIds;

        CollectSortedEntities<SoftBodyComponent>(this.m_world, sortedIds);
        bundle.softBodies.reserve(sortedIds.size());
        for(usize i = 0u; i < sortedIds.size(); ++i){
            const Optional<mut SoftBodyComponent> sbOpt = this.m_world.borrowComponent<SoftBodyComponent>(sortedIds[i]);
            if(sbOpt.has_value())
                bundle.softBodies.push_back(sbOpt.value().softBody);
        }

        CollectSortedEntities<VehicleComponent>(this.m_world, sortedIds);
        bundle.vehicles.reserve(sortedIds.size());
        for(usize i = 0u; i < sortedIds.size(); ++i){
            const Optional<mut VehicleComponent> vcOpt = this.m_world.borrowComponent<VehicleComponent>(sortedIds[i]);
            if(vcOpt.has_value())
                bundle.vehicles.push_back(vcOpt.value().controller);
        }

        CollectSortedEntities<RagdollComponent>(this.m_world, sortedIds);
        bundle.ragdolls.reserve(sortedIds.size());
        for(usize i = 0u; i < sortedIds.size(); ++i){
            const Optional<mut RagdollComponent> rcOpt = this.m_world.borrowComponent<RagdollComponent>(sortedIds[i]);
            if(rcOpt.has_value())
                bundle.ragdolls.push_back(rcOpt.value().instance);
        }

        CollectSortedEntities<CharacterControllerComponent>(this.m_world, sortedIds);
        bundle.characters.reserve(sortedIds.size());
        for(usize i = 0u; i < sortedIds.size(); ++i){
            const Optional<mut CharacterControllerComponent> ccOpt = this.m_world.borrowComponent<CharacterControllerComponent>(sortedIds[i]);
            if(ccOpt.has_value())
                bundle.characters.push_back(ccOpt.value().controller);
        }

        CollectSortedEntities<ArticulationComponent>(this.m_world, sortedIds);
        bundle.articulations.reserve(sortedIds.size());
        for(usize i = 0u; i < sortedIds.size(); ++i){
            const Optional<mut ArticulationComponent> acOpt = this.m_world.borrowComponent<ArticulationComponent>(sortedIds[i]);
            if(acOpt.has_value())
                bundle.articulations.push_back(acOpt.value().articulation);
        }

        CollectSortedEntities<FractureComponent>(this.m_world, sortedIds);
        bundle.fractureClusters.reserve(sortedIds.size());
        for(usize i = 0u; i < sortedIds.size(); ++i){
            const Optional<mut FractureComponent> fcOpt = this.m_world.borrowComponent<FractureComponent>(sortedIds[i]);
            if(fcOpt.has_value())
                bundle.fractureClusters.push_back(fcOpt.value().cluster);
        }

        return SerializeFullPhysicsSnapshot(this.m_physicsWorld, bundle, outBytes);
    }

    public b8 restoreWorldSnapshot(in Span<u8> bytes){
        PhysicsSubsystemsBundle bundle;
        if(!RestoreFullPhysicsSnapshot(bytes, this.m_physicsWorld, bundle))
            return false;

        ReleaseEcsPhysicsAssetCache(this.m_assetCache, this.m_physicsWorld, false);
        this.m_syncScratch.failedRagdollAssets.clear();
        this.m_syncScratch.failedFractureAssets.clear();
        const usize keepFluidCbCount = Min(this.m_environmentScratch.fluids.size(), bundle.environment.fluids.size());
        for(usize fi = 0u; fi < keepFluidCbCount; ++fi)
            bundle.environment.fluids[fi].copySurfaceCallbackFrom(this.m_environmentScratch.fluids[fi]);
        this.m_environmentScratch = bundle.environment;
        this.m_syncScratch.jointFastCache.clear();
        for(auto it = this.m_activeRagdolls.begin(); it != this.m_activeRagdolls.end(); ++it)
            it.value().wroteSleepingPose = false;
        for(auto it = this.m_activeFractures.begin(); it != this.m_activeFractures.end(); ++it)
            it.value().wroteSleepingPose = false;
        for(auto it = this.m_syncScratch.vehicleEventSyncStates.begin(); it != this.m_syncScratch.vehicleEventSyncStates.end(); ++it)
            it.value().wroteSleepingPose = false;
        for(auto it = this.m_syncScratch.articulationLiveStates.begin(); it != this.m_syncScratch.articulationLiveStates.end(); ++it)
            it.value().wroteSleepingPose = false;
        this.m_syncScratch.hierarchyCacheValid = false;
        this.m_syncScratch.mutationVersionsValid = false;
        this.m_syncScratch.hasSyncedPhysicsEntityCounts = false;
        this.m_hasActiveInstanceTransformPatches = false;
        this.m_activeInstanceTransformPatchMembershipSig = 0u;
        this.m_hasAnyPhysicsParents = RefreshPhysicsHierarchyCache(this.m_world, this.m_syncScratch);

        in WorldDef restoredDef = this.m_physicsWorld.m_def;
        const PhysicsBackendMode restoredBackend = this.m_physicsWorld.m_backendMode;
        const u32 restoredGpuThresh = this.m_physicsWorld.m_gpuDispatchThreshold;
        const f32 restoredGpuFrac = this.m_physicsWorld.m_gpuWorkloadFraction;
        const b8 restoredWarm = this.m_physicsWorld.m_enableWarmStarting;
        const f32 restoredSplashThreshold = this.m_environmentScratch.splashImpulseThreshold;
        this.m_world.view<PhysicsWorldConfigComponent>().each(
            lambda[in restoredDef, in restoredBackend, in restoredGpuThresh, in restoredGpuFrac, in restoredWarm, in restoredSplashThreshold](
                in EntityID entity,
                mut PhysicsWorldConfigComponent cfg
            ) -> void{
                cfg.gravity = restoredDef.gravity;
                cfg.restitutionThreshold = restoredDef.restitutionThreshold;
                cfg.hitEventThreshold = restoredDef.hitEventThreshold;
                cfg.contactHertz = restoredDef.contactHertz;
                cfg.contactDampingRatio = restoredDef.contactDampingRatio;
                cfg.maxLinearVelocity = restoredDef.maxLinearVelocity;
                cfg.timeToSleep = restoredDef.timeToSleep;
                cfg.enableSleep = restoredDef.enableSleep;
                cfg.enableContinuous = restoredDef.enableContinuous;
                cfg.enableContactSoftening = restoredDef.enableContactSoftening;
                cfg.enableGpuCollision = restoredDef.enableGpuCollision;
                cfg.forceGpuCollision = restoredDef.forceGpuCollision;
                cfg.gpuResidentMode = restoredDef.gpuResidentMode;
                cfg.useGpuLbvhBroadphase = restoredDef.useGpuLbvhBroadphase;
                cfg.enableBlockSolver = restoredDef.enableBlockSolver;
                cfg.enableShockPropagation = restoredDef.enableShockPropagation;
                cfg.deterministicMode = restoredDef.deterministicMode;
                cfg.enableGlobalCcd = restoredDef.enableGlobalCcd;
                cfg.enablePerPointFriction = restoredDef.enablePerPointFriction;
                cfg.enableDoublePrecisionPositions = restoredDef.enableDoublePrecisionPositions;
                cfg.splashImpulseThreshold = restoredSplashThreshold;
                cfg.broadPhaseLayerMasks = restoredDef.broadPhaseLayerMasks;
                cfg.backendMode = restoredBackend;
                cfg.gpuDispatchThreshold = restoredGpuThresh;
                cfg.gpuWorkloadFraction = restoredGpuFrac;
                cfg.enableWarmStarting = restoredWarm;
                cfg.dirty = false;
            }
        );

        const usize bodyCount = this.m_physicsWorld.m_bodies.size();
        const usize shapeCount = this.m_physicsWorld.m_shapes.size();
        const usize jointCount = this.m_physicsWorld.m_joints.size();
        this.m_bodyIndexToEntity.clear();
        this.m_bodyIndexToEntity.resize(bodyCount);
        this.m_shapeIndexToEntity.clear();
        this.m_shapeIndexToEntity.resize(shapeCount);
        this.m_jointIndexToEntity.clear();
        this.m_jointIndexToEntity.resize(jointCount);

        this.m_syncScratch.writeBackPoseCache.clear();
        this.m_syncScratch.restoreRemoveRecsScratch.clear();
        mut Vector<EntityID> removeRecs = this.m_syncScratch.restoreRemoveRecsScratch;
        mut Vector<ShapeId> validExtras = this.m_syncScratch.restoreValidExtrasScratch;
        for(in auto kv : this.m_entityRecords){
            const EntityID entity = kv.first;
            mut EcsEntityPhysicsRecord rec = this.m_entityRecords.at(entity);
            const b8 validBody = rec.bodyId.valid() && this.m_physicsWorld.isValidBody(rec.bodyId);
            const b8 validPrimary = rec.primaryShapeId.valid() && this.m_physicsWorld.isValidShape(rec.primaryShapeId);
            validExtras.clear();
            for(usize si = 0u; si < rec.extraShapeIds.size(); ++si){
                const ShapeId sId = rec.extraShapeIds[si];
                if(sId.valid() && this.m_physicsWorld.isValidShape(sId))
                    validExtras.push_back(sId);
            }
            const b8 droppedExtra = (validExtras.size() != rec.extraShapeIds.size());
            const b8 entityAlive = this.m_world.alive(entity);

            if(!validBody && !validPrimary && validExtras.empty()){
                removeRecs.push_back(entity);
                if(entityAlive){
                    const Optional<mut RigidBodyComponent> rbOpt = this.m_world.borrowComponent<RigidBodyComponent>(entity);
                    if(rbOpt.has_value()){
                        rbOpt.value().runtimeBodyId = BodyId();
                        rbOpt.value().dirty = true;
                    }
                    const Optional<mut ColliderComponent> colOpt = this.m_world.borrowComponent<ColliderComponent>(entity);
                    if(colOpt.has_value()){
                        colOpt.value().runtimeShapeId = ShapeId();
                        colOpt.value().runtimeExtraShapeIds.clear();
                        colOpt.value().boundBodyId = BodyId();
                        colOpt.value().dirty = true;
                    }
                }
                continue;
            }

            if(!validBody){
                rec.bodyId = BodyId();
                rec.attachedToParentBody = false;
                rec.parentBodyEntity = s_InvalidEntityId;
                if(entityAlive){
                    const Optional<mut RigidBodyComponent> rbOpt = this.m_world.borrowComponent<RigidBodyComponent>(entity);
                    if(rbOpt.has_value()){
                        rbOpt.value().runtimeBodyId = BodyId();
                        rbOpt.value().dirty = true;
                    }
                }
            }
            else if(!rec.attachedToParentBody && rec.bodyId.index < cast<u32>(bodyCount)){
                in Body b = this.m_physicsWorld.m_bodies[rec.bodyId.index];
                mut EcsSlotOwner bOwner = this.m_bodyIndexToEntity[rec.bodyId.index];
                bOwner.entity = entity;
                bOwner.generation = b.generation;
                bOwner.hasPhysicsParent = rec.hadPhysicsParent;
                if(entityAlive){
                    const Expected<Transform3D> xf = this.m_physicsWorld.tryGetBodyTransform(rec.bodyId);
                    if(xf.has_value())
                        WriteWorldPoseBackToEntityTransform(entity, xf.value(), this.m_hasAnyPhysicsParents, this.m_world, this.m_syncScratch.writeBackPoseCache);
                    const Optional<mut RigidBodyComponent> rbOpt = this.m_world.borrowComponent<RigidBodyComponent>(entity);
                    if(rbOpt.has_value()){
                        mut RigidBodyComponent rb = rbOpt.value();
                        rb.runtimeBodyId = rec.bodyId;
                        rb.type = b.type;
                        rb.isEnabled = this.m_physicsWorld.isBodyEnabled(rec.bodyId);
                        rb.isBullet = (b.flags & cast<u32>(BodyFlags::IsBullet)) != 0u;
                        rb.hasCustomMaxAngularVelocity = (b.flags & cast<u32>(BodyFlags::HasCustomMaxAngularVelocity)) != 0u;
                        if(rb.hasCustomMaxAngularVelocity)
                            rb.maxAngularVelocity = b.maxAngularVelocity;
                        else
                            rb.maxAngularVelocity = 0.0f;
                        rb.motionLocks = b.flags & 0x3Fu;
                        rb.enableSleep = (b.flags & cast<u32>(BodyFlags::EnableSleep)) != 0u;
                        rb.allowFastRotation = (b.flags & cast<u32>(BodyFlags::AllowFastRotation)) != 0u;
                        rb.enableGyroscopicTorque = (b.flags & cast<u32>(BodyFlags::EnableGyroscopicTorque)) != 0u;
                        rb.sleepThreshold = b.sleepThreshold;
                        rb.userData = b.userData;
                        if(b.setIndex < this.m_physicsWorld.m_solverSets.size() && b.localIndex < this.m_physicsWorld.m_solverSets[b.setIndex].sims.size()){
                            in BodySim sim = this.m_physicsWorld.m_solverSets[b.setIndex].sims[b.localIndex];
                            rb.gravityScale = sim.gravityScale;
                            rb.linearDamping = sim.linearDamping();
                            rb.angularDamping = sim.angularDamping();
                            if(rb.useCustomMass){
                                rb.customMass = b.mass;
                                rb.customCenterOfMass = f32x4(sim.localCenter(), 0.0f);
                                rb.customInertiaDiag = f32x4(b.inertiaLocal.m00, b.inertiaLocal.m11, b.inertiaLocal.m22, 0.0f);
                                rb.customInertiaOffDiag = f32x4(b.inertiaLocal.m01, b.inertiaLocal.m02, b.inertiaLocal.m12, 0.0f);
                            }
                        }
                        SyncRigidBodyVelocityAndAwakeDirect(this.m_physicsWorld, rec.bodyId.index, rb);
                        rb.dirty = false;
                    }
                }
            }

            if(validPrimary && rec.primaryShapeId.index < cast<u32>(shapeCount)){
                mut EcsSlotOwner sOwner = this.m_shapeIndexToEntity[rec.primaryShapeId.index];
                sOwner.entity = entity;
                sOwner.generation = rec.primaryShapeId.generation;
                sOwner.hasPhysicsParent = rec.hadPhysicsParent;
            }
            else if(!validPrimary){
                rec.primaryShapeId = ShapeId();
            }

            if(droppedExtra){
                rec.extraShapeIds.clear();
                for(usize si = 0u; si < validExtras.size(); ++si)
                    rec.extraShapeIds.push_back(validExtras[si]);
            }
            for(usize si = 0u; si < validExtras.size(); ++si){
                const ShapeId sId = validExtras[si];
                if(sId.index < cast<u32>(shapeCount)){
                    mut EcsSlotOwner sOwner = this.m_shapeIndexToEntity[sId.index];
                    sOwner.entity = entity;
                    sOwner.generation = sId.generation;
                    sOwner.hasPhysicsParent = rec.hadPhysicsParent;
                }
            }

            if(entityAlive){
                const Optional<mut ColliderComponent> colOpt = this.m_world.borrowComponent<ColliderComponent>(entity);
                if(colOpt.has_value()){
                    mut ColliderComponent col = colOpt.value();
                    col.runtimeShapeId = rec.primaryShapeId;
                    col.runtimeExtraShapeIds.clear();
                    for(usize si = 0u; si < validExtras.size(); ++si)
                        col.runtimeExtraShapeIds.push_back(validExtras[si]);
                    col.boundBodyId = rec.bodyId;
                    if(!validPrimary || droppedExtra || !validBody)
                        col.dirty = true;
                }
            }
        }
        for(usize ri = 0u; ri < removeRecs.size(); ++ri)
            this.m_entityRecords.erase(removeRecs[ri]);
        removeRecs.clear();
        validExtras.clear();

        this.m_syncScratch.restoreRemoveJointsScratch.clear();
        mut Vector<EntityID> removeJoints = this.m_syncScratch.restoreRemoveJointsScratch;
        for(in auto kv : this.m_entityJoints){
            const EntityID entity = kv.first;
            mut EcsJointSyncRecord jRec = this.m_entityJoints.at(entity);
            jRec.hasStructure = false;
            for(usize ei = 0u; ei < jRec.extraHasStructures.size(); ++ei)
                jRec.extraHasStructures[ei] = false;
            const b8 validPrimaryJoint = jRec.jointId.valid() && this.m_physicsWorld.isValidJoint(jRec.jointId);
            if(validPrimaryJoint && jRec.jointId.index < cast<u32>(jointCount)){
                mut EcsSlotOwner jOwner = this.m_jointIndexToEntity[jRec.jointId.index];
                jOwner.entity = entity;
                jOwner.generation = jRec.jointId.generation;
                jRec.primaryBroken = false;
            }
            else{
                jRec.jointId = JointId();
            }

            b8 anyValidExtra = false;
            for(usize ei = 0u; ei < jRec.extraJointIds.size(); ++ei){
                const JointId eId = jRec.extraJointIds[ei];
                if(eId.valid() && this.m_physicsWorld.isValidJoint(eId) && eId.index < cast<u32>(jointCount)){
                    mut EcsSlotOwner eOwner = this.m_jointIndexToEntity[eId.index];
                    eOwner.entity = entity;
                    eOwner.generation = eId.generation;
                    anyValidExtra = true;
                    if(ei < jRec.extraBroken.size())
                        jRec.extraBroken[ei] = false;
                }
                else{
                    jRec.extraJointIds[ei] = JointId();
                }
            }

            const b8 entityAlive = this.m_world.alive(entity);
            if(!validPrimaryJoint && !anyValidExtra){
                removeJoints.push_back(entity);
                if(entityAlive){
                    const Optional<mut JointComponent> jcOpt = this.m_world.borrowComponent<JointComponent>(entity);
                    if(jcOpt.has_value()){
                        mut JointComponent jc = jcOpt.value();
                        jc.runtimeJointId = JointId();
                        jc.runtimeExtraJointIds.clear();
                        jc.boundBodyIdA = BodyId();
                        jc.boundBodyIdB = BodyId();
                        jc.boundExtraBodyIdAs.clear();
                        jc.boundExtraBodyIdBs.clear();
                        jc.dirty = true;
                    }
                }
                continue;
            }

            if(entityAlive){
                const Optional<mut JointComponent> jcOpt = this.m_world.borrowComponent<JointComponent>(entity);
                if(jcOpt.has_value()){
                    mut JointComponent jc = jcOpt.value();
                    jc.runtimeJointId = jRec.jointId;
                    jc.runtimeExtraJointIds.clear();
                    for(usize ei = 0u; ei < jRec.extraJointIds.size(); ++ei)
                        jc.runtimeExtraJointIds.push_back(jRec.extraJointIds[ei]);
                }
            }
        }
        for(usize ri = 0u; ri < removeJoints.size(); ++ri)
            this.m_entityJoints.erase(removeJoints[ri]);
        removeJoints.clear();

        Vector<EntityID> sortedIds;

        for(auto fracIt = this.m_activeFractures.begin(); fracIt != this.m_activeFractures.end(); ++fracIt)
            DestroyTrackedFractureChunkEntities(this.m_world, fracIt.value());
        this.m_activeRagdolls.clear();
        this.m_activeFractures.clear();
        CollectSortedEntities<RagdollComponent>(this.m_world, sortedIds);
        for(usize ri = 0u; ri < sortedIds.size(); ++ri){
            const EntityID entity = sortedIds[ri];
            const Optional<mut RagdollComponent> rcOpt = this.m_world.borrowComponent<RagdollComponent>(entity);
            if(!rcOpt.has_value())
                continue;
            mut RagdollComponent rc = rcOpt.value();
            b8 ragdollValid = (ri < bundle.ragdolls.size()) && !bundle.ragdolls[ri].boneBodies.empty();
            if(ragdollValid){
                for(usize bi = 0u; bi < bundle.ragdolls[ri].boneBodies.size(); ++bi){
                    if(!this.m_physicsWorld.isValidBody(bundle.ragdolls[ri].boneBodies[bi])){
                        ragdollValid = false;
                        break;
                    }
                }
            }
            if(ragdollValid){
                rc.instance = bundle.ragdolls[ri];
                rc.mode = rc.instance.mode;
                rc.enableSelfCollision = rc.instance.enableSelfCollision;
                rc.autoExcludeInitialOverlaps = rc.instance.autoExcludeInitialOverlaps;
                rc.disabledSelfCollisionPairs = rc.instance.disabledSelfCollisionPairs;
                rc.initialized = true;
                rc.dirty = false;
                EcsTrackedRagdoll tracked;
                tracked.syncedMode = rc.mode;
                tracked.syncedAutoExcludeInitialOverlaps = rc.autoExcludeInitialOverlaps;
                tracked.syncedKinematic = rc.kinematic;
                tracked.syncedKinematicMask = rc.boneKinematicMask;
                tracked.syncedEnableSelfCollision = rc.enableSelfCollision;
                tracked.syncedDisabledSelfCollisionPairs = rc.disabledSelfCollisionPairs;
                tracked.syncedCollisionLayer = rc.collisionLayer;
                tracked.syncedRagdollAsset = rc.ragdollAsset.name();
                tracked.syncedMaterialAsset = rc.materialAsset.name();
                tracked.syncedBoneMaterialAssets.resize(rc.boneMaterialAssets.size());
                for(usize bi = 0u; bi < rc.boneMaterialAssets.size(); ++bi)
                    tracked.syncedBoneMaterialAssets[bi] = rc.boneMaterialAssets[bi].name();
                ComputeRagdollBoneToJointOffsetsFromDef(rc, tracked.boneToJointLocalOffsets);
                RegisterTrackedRagdollSlots(
                    entity,
                    rc.instance,
                    this.m_physicsWorld,
                    this.m_bodyIndexToEntity,
                    this.m_shapeIndexToEntity,
                    this.m_jointIndexToEntity,
                    tracked
                );
                this.m_activeRagdolls.insert_or_assign(entity, tracked);
            }
            else{
                rc.initialized = false;
                rc.dirty = true;
                rc.instance.reset();
            }
        }

        this.m_syncScratch.vehicleEventSyncStates.clear();
        CollectSortedEntities<VehicleComponent>(this.m_world, sortedIds);
        for(usize vi = 0u; vi < sortedIds.size(); ++vi){
            const Optional<mut VehicleComponent> vcOpt = this.m_world.borrowComponent<VehicleComponent>(sortedIds[vi]);
            if(!vcOpt.has_value())
                continue;
            mut VehicleComponent vc = vcOpt.value();
            if(
                vi < bundle.vehicles.size()
                && bundle.vehicles[vi].chassisBodyId.valid()
                && this.m_physicsWorld.isValidBody(bundle.vehicles[vi].chassisBodyId)
            ){
                vc.controller = bundle.vehicles[vi];
                vc.initialized = true;
                vc.dirty = false;
                if(vc.vehicleAsset.valid()){
                    EcsVehicleEventSyncState vehEv;
                    vehEv.syncedVehicleAsset = vc.vehicleAsset.name();
                    this.m_syncScratch.vehicleEventSyncStates.insert_or_assign(sortedIds[vi], vehEv);
                }
            }
            else{
                vc.controller = VehicleController();
                vc.initialized = false;
                vc.dirty = true;
            }
        }

        this.m_syncScratch.characterSyncStates.clear();
        CollectSortedEntities<CharacterControllerComponent>(this.m_world, sortedIds);
        for(usize ci = 0u; ci < sortedIds.size(); ++ci){
            const EntityID entity = sortedIds[ci];
            const Optional<mut CharacterControllerComponent> ccOpt = this.m_world.borrowComponent<CharacterControllerComponent>(entity);
            if(!ccOpt.has_value())
                continue;
            mut CharacterControllerComponent cc = ccOpt.value();
            if(ci < bundle.characters.size()){
                bundle.characters[ci].copyCallbacksFrom(cc.controller);
                cc.controller = bundle.characters[ci];
                cc.initialized = true;
                cc.dirty = false;
                const Transform3D charXf(VectorSingle(cc.controller.position), SafeNormalizeQuat(VectorSingle(cc.controller.rotation)));
                WriteWorldPoseBackToEntityTransform(entity, charXf, this.m_hasAnyPhysicsParents, this.m_world, this.m_syncScratch.writeBackPoseCache);
                EcsCharacterControllerSyncState charSync;
                charSync.prevPosition = cc.controller.position;
                charSync.currPosition = cc.controller.position;
                charSync.prevRotation = cc.controller.rotation;
                charSync.currRotation = cc.controller.rotation;
                charSync.hasPrevSnapshot = true;
                charSync.prevGroundState = cc.controller.groundState;
                charSync.prevGroundBodyId = cc.controller.groundBodyId;
                charSync.hasPrevGroundState = true;
                charSync.prevHitCeiling = cc.controller.hitCeiling;
                this.m_syncScratch.characterSyncStates.insert_or_assign(entity, charSync);
            }
            else{
                cc.initialized = false;
                cc.dirty = true;
            }
        }

        this.m_syncScratch.articulationProxySyncStates.clear();
        this.m_syncScratch.articulationLiveStates.clear();
        CollectSortedEntities<ArticulationComponent>(this.m_world, sortedIds);
        for(usize ai = 0u; ai < sortedIds.size(); ++ai){
            const EntityID entity = sortedIds[ai];
            const Optional<mut ArticulationComponent> acOpt = this.m_world.borrowComponent<ArticulationComponent>(entity);
            if(!acOpt.has_value())
                continue;
            mut ArticulationComponent ac = acOpt.value();
            if(ai < bundle.articulations.size() && !bundle.articulations[ai].linkDefs.empty()){
                ac.articulation = bundle.articulations[ai];
                ac.initialized = true;
                ac.dirty = false;
                EcsArticulationLiveState live;
                EcsWorldPose rootPose;
                VectorSingle signedScale(1.0f, 1.0f, 1.0f, 0.0f);
                if(ResolveEcsSubsystemWorldPoseCached(entity, this.m_hasAnyPhysicsParents, this.m_world, this.m_syncScratch.writeBackPoseCache, rootPose))
                    signedScale = ResolveSignedColliderScale(VectorSingle(rootPose.scale));
                live.syncedRootScale = f32x4(signedScale);
                live.hasSyncedRootScale = true;
                live.syncedIsFixedBase = ac.isFixedBase;
                live.syncedLinks = ac.links;
                live.prevBaseTransform = ac.articulation.baseTransform;
                live.currBaseTransform = ac.articulation.baseTransform;
                const usize lCount = ac.articulation.linkStates.size();
                live.prevLinkWorldTransforms.resize(lCount);
                live.currLinkWorldTransforms.resize(lCount);
                for(usize li = 0u; li < lCount; ++li){
                    live.prevLinkWorldTransforms[li] = ac.articulation.linkStates[li].worldTransform;
                    live.currLinkWorldTransforms[li] = ac.articulation.linkStates[li].worldTransform;
                }
                live.hasPrevPoseSnapshot = false;
                live.wroteSleepingPose = false;
                live.syncedArticulationAsset = ac.articulationAsset.name();
                this.m_syncScratch.articulationLiveStates.insert_or_assign(entity, live);
            }
            else{
                ac.articulation = Articulation();
                ac.initialized = false;
                ac.dirty = true;
            }
        }

        this.m_syncScratch.softBodySyncStates.clear();
        CollectSortedEntities<SoftBodyComponent>(this.m_world, sortedIds);
        for(usize si = 0u; si < sortedIds.size(); ++si){
            const EntityID entity = sortedIds[si];
            const Optional<mut SoftBodyComponent> sbOpt = this.m_world.borrowComponent<SoftBodyComponent>(entity);
            if(!sbOpt.has_value())
                continue;
            mut SoftBodyComponent sb = sbOpt.value();
            if(si < bundle.softBodies.size()){
                sb.softBody = bundle.softBodies[si];
                sb.dirty = false;
                EcsSoftBodySyncState sbSync;
                sbSync.transformApplied = !sb.softBody.particles.empty();
                sbSync.hasBaseCollisionFilter = true;
                sbSync.baseCollisionFilter = sb.softBody.collisionFilter;
                sbSync.syncedCollisionLayer = sb.collisionLayer;
                sbSync.hasBaseSurfaceMaterial = true;
                sbSync.baseSurfaceMaterial = sb.softBody.surfaceMaterial;
                sbSync.syncedMaterialAsset = sb.materialAsset.name();
                sbSync.syncedSoftBodyAsset = sb.softBodyAsset.name();
                this.m_syncScratch.softBodySyncStates.insert_or_assign(entity, sbSync);
            }
        }

        CollectSortedEntities<FractureComponent>(this.m_world, sortedIds);
        for(usize fi = 0u; fi < sortedIds.size(); ++fi){
            const EntityID entity = sortedIds[fi];
            const Optional<mut FractureComponent> fcOpt = this.m_world.borrowComponent<FractureComponent>(entity);
            if(!fcOpt.has_value())
                continue;
            mut FractureComponent fc = fcOpt.value();
            b8 fractureValid = (fi < bundle.fractureClusters.size()) && !bundle.fractureClusters[fi].chunks.empty();
            if(fractureValid){
                in FractureClusterBody cand = bundle.fractureClusters[fi];
                b8 anyLiveBody = cand.rootBodyId.valid() && this.m_physicsWorld.isValidBody(cand.rootBodyId);
                if(!anyLiveBody){
                    for(usize di = 0u; di < cand.detachedBodies.size(); ++di){
                        if(cand.detachedBodies[di].valid() && this.m_physicsWorld.isValidBody(cand.detachedBodies[di])){
                            anyLiveBody = true;
                            break;
                        }
                    }
                }
                if(!anyLiveBody){
                    for(usize ai = 0u; ai < cand.anchoredBodies.size(); ++ai){
                        if(cand.anchoredBodies[ai].valid() && this.m_physicsWorld.isValidBody(cand.anchoredBodies[ai])){
                            anyLiveBody = true;
                            break;
                        }
                    }
                }
                fractureValid = anyLiveBody;
            }
            if(fractureValid){
                fc.cluster = bundle.fractureClusters[fi];
                fc.initialized = true;
                fc.dirty = false;
                EcsTrackedFracture tracked;
                tracked.syncedCollisionLayer = fc.collisionLayer;
                tracked.syncedFractureAsset = fc.fractureAsset.name();
                RegisterTrackedFractureSlots(
                    entity,
                    fc.cluster,
                    this.m_physicsWorld,
                    this.m_bodyIndexToEntity,
                    this.m_shapeIndexToEntity,
                    tracked
                );
                SyncFractureDetachedChunkEntities(this.m_world, this.m_physicsWorld, tracked, fc);
                this.m_activeFractures.insert_or_assign(entity, tracked);
            }
            else{
                fc.cluster.clear();
                fc.detachedChunkEntities.clear();
                fc.initialized = false;
                fc.dirty = true;
            }
        }

        const usize currJointCount = this.m_physicsWorld.m_joints.size();
        for(usize ji = 0u; ji < currJointCount; ++ji){
            in Joint j = this.m_physicsWorld.m_joints[ji];
            if(!j.alive())
                continue;
            const b8 owned =
                (ji < this.m_jointIndexToEntity.size())
                && this.m_jointIndexToEntity[ji].entity.valid()
                && this.m_jointIndexToEntity[ji].generation == j.generation
            ;
            if(!owned)
                this.m_physicsWorld.destroyJoint(this.m_physicsWorld.makeJointId(cast<u32>(ji)));
        }

        const usize currBodyCount = this.m_physicsWorld.m_bodies.size();
        for(usize bi = 0u; bi < currBodyCount; ++bi){
            in Body b = this.m_physicsWorld.m_bodies[bi];
            if(!b.alive)
                continue;
            const b8 owned =
                (bi < this.m_bodyIndexToEntity.size())
                && this.m_bodyIndexToEntity[bi].entity.valid()
                && this.m_bodyIndexToEntity[bi].generation == b.generation
            ;
            if(!owned)
                this.m_physicsWorld.destroyBody(this.m_physicsWorld.makeBodyId(cast<u32>(bi)));
        }

        this.m_bodyTransformSnapshots.resize(currBodyCount);
        this.m_bodyTransformSnapshotMeta.resize(currBodyCount, 0u);
        for(usize bi = 0u; bi < currBodyCount; ++bi){
            in Body b = this.m_physicsWorld.m_bodies[bi];
            const BodyId id = this.m_physicsWorld.makeBodyId(cast<u32>(bi));
            if(b.alive && id.valid()){
                const Expected<Transform3D> xf = this.m_physicsWorld.tryGetBodyTransform(id);
                if(xf.has_value())
                    SetBodyTransformSnapshotBoth(id, xf.value(), this.m_bodyTransformSnapshots, this.m_bodyTransformSnapshotMeta);
                else
                    this.m_bodyTransformSnapshotMeta[bi] = 0u;
            }
            else{
                this.m_bodyTransformSnapshotMeta[bi] = 0u;
            }
        }

        WriteBackEcsRagdollRootPoses(
            this.m_physicsWorld,
            this.m_scopedNames,
            this.m_activeRagdolls,
            this.m_bodyTransformSnapshots,
            this.m_bodyTransformSnapshotMeta,
            false,
            1.0f,
            this.m_hasAnyPhysicsParents,
            this.m_world,
            this.m_syncScratch
        );
        WriteBackEcsVehicleWheelPoses(
            this.m_physicsWorld,
            this.m_scopedNames,
            this.m_bodyTransformSnapshots,
            this.m_bodyTransformSnapshotMeta,
            false,
            1.0f,
            true,
            this.m_hasAnyPhysicsParents,
            this.m_world,
            this.m_syncScratch
        );
        WriteBackEcsArticulationPoses(
            this.m_physicsWorld,
            this.m_scopedNames,
            this.m_bodyIndexToEntity,
            false,
            1.0f,
            true,
            this.m_hasAnyPhysicsParents,
            this.m_world,
            this.m_syncScratch
        );
        WriteBackEcsFracturePoses(
            this.m_physicsWorld,
            this.m_activeFractures,
            this.m_bodyTransformSnapshots,
            this.m_bodyTransformSnapshotMeta,
            false,
            1.0f,
            this.m_hasAnyPhysicsParents,
            this.m_world,
            this.m_syncScratch
        );

        this.m_physicsWorld.consumePendingEndEvents(this.m_frameContactEndEvents, this.m_frameSensorEndEvents);
        this.m_physicsWorld.consumePendingWakeEvents(this.m_frameBodyWakeEvents);
        this.clearFrameEvents();
        this.m_syncScratch.writeBackPoseCache.clear();
        this.m_gpuDispatcher.invalidateWorldCaches();
        ClearDestroyedSlotOwners(this.m_syncScratch);
        this.m_syncScratch.vehicleEventSyncStates.clear();
        this.m_syncScratch.ecsFluidImmersionState.clear();
        this.m_syncScratch.ecsFluidSamplesScratch.clear();
        this.m_syncScratch.ecsFluidSplashScratch.clear();
        this.m_syncScratch.activeFluidEntitiesById.clear();
        this.m_syncScratch.seenFluidIdsThisStep.clear();
        this.m_syncScratch.csgColliderStates.clear();
        this.m_syncScratch.skinnedColliderEntrySigs.clear();
        this.m_syncScratch.deferredAttachedColliderEntities.clear();
        this.m_syncScratch.envFluidEntitiesScratch.clear();
        this.m_syncScratch.bodySyncedPoses.clear();
        this.m_syncScratch.staticBodyPoseCache.clear();
        this.m_syncScratch.colliderScaleCache.clear();
        this.m_syncScratch.syncedParentNames.clear();
        this.m_syncScratch.subsystemBoundTargetNameCache.clear();
        this.m_syncScratch.subsystemSkeletonTargetNameCache.clear();
        this.m_syncScratch.softBodyAttachmentNameCache.clear();
        this.m_syncScratch.pendingWriteBackBodyIndices.clear();
        this.m_syncScratch.prevAwakeWriteBackBodyIndices.clear();
        this.m_syncScratch.nextAwakeWriteBackBodyIndices.clear();
        this.m_syncScratch.dirtyPrevSnapshotBodyIndices.clear();
        this.m_syncScratch.drivenKinematicEntries.clear();
        this.m_syncScratch.kinematicTargets.clear();
        ClearMovedStaticBodies(this.m_syncScratch.movedStaticBodyFlags, this.m_syncScratch.movedStaticBodyIndices);
        this.m_syncScratch.hasSyncedTopologyVersion = false;
        this.m_syncScratch.hasRagdollTopology = false;
        this.m_syncScratch.mutationVersionsValid = false;
        this.m_syncScratch.tagPrepassVersionsValid = false;
        this.m_accumulator = 0.0f;
        this.m_interpolationAlpha = 1.0f;
        return true;
    }

    public void setCollisionLayerMatrix(in CollisionLayerMatrix matrix){
        this.m_collisionLayerMatrix = matrix;
        this.m_syncScratch.collisionLayerMatrixChanged = true;
    }

    public in CollisionLayerMatrix collisionLayerMatrix()const{
        return this.m_collisionLayerMatrix;
    }

    public b8 loadCollisionLayerMatrixAsset(in AssetRef<CollisionLayerMatrixAsset> assetRef){
        if(!assetRef.valid() || !this.m_assetManager.has_value())
            return false;
        const auto loaded = LoadTypedAssetSync<CollisionLayerMatrixAsset>(this.m_assetManager.value(), assetRef.name(), "PhysicsSystem");
        if(!loaded.has_value())
            return false;
        this.m_collisionLayerMatrix = loaded.value().deref().layerMatrix();
        this.m_syncScratch.collisionLayerMatrixChanged = true;
        return true;
    }

    public Filter makeLayerFilter(in u32 layerIdx, in i32 groupIndex)const{
        return this.m_collisionLayerMatrix.makeFilter(layerIdx, groupIndex);
    }

    public Filter makeLayerFilterByName(in Name layerName, in i32 groupIndex)const{
        return this.m_collisionLayerMatrix.makeFilterByName(layerName, groupIndex);
    }

