class MisdirectedImageCodec : IAssetCodec{
    private b8 m_wrongType;

    [cpp_base(IAssetCodec, type)]
    public MisdirectedImageCodec(in borrow Name type, in b8 wrongType){ this.m_wrongType = wrongType; }

    [cpp_unwind]
    public Expected<UniquePtr<IAsset>> deserialize(in Name path, in Span<u8> binary, mut GlobalAllocator storage)const override{
        if(this.m_wrongType){
            UniquePtr<IAsset> skin = MakeUnique<UiSkin>(storage, path);
            return skin;
        }
        DeclaredAssetCodec<Texture> codec = DeclaredAssetCodec<Texture>();
        return codec.deserialize(s_UiCaseTestsUiImageLoaderOtherTexture, binary, storage);
    }
}

class MemoryImageBinarySource : IAssetBinarySource{
    public Vector<u8> m_binary;
    public Name m_path = s_ImageFixtureTexturePath;
    public TestObserved<usize> m_readCount;
    public b8 m_available = true;

    public b8 readAssetBinary(in Name virtualPath, mut AssetByteBuffer outBinary)const override{
        ++this.m_readCount.value();
        outBinary.clear();
        if(!this.m_available || virtualPath != this.m_path)
            return false;
        for(in u8 byteValue : this.m_binary)
            outBinary.push_back(byteValue);
        return true;
    }
}

class UiImageBuilderTests : WidgetFixture{


    public void setup(){
        this.setUpWidgetBase();
        if(HasFatalTestFailure())
            return;
        this.configureImages();
    }
    public void configureImages(){
        this.configureSkin();
        RegionVector regions;
        for(in UiSkinRegion region : this.m_skin.regions())
            regions.push_back(region);
        UiSkinRegion sprite;
        sprite.name = Name("image.sprite");
        sprite.rectangle.y = 16u;
        sprite.rectangle.width = 20u;
        sprite.rectangle.height = 12u;
        sprite.padding = MakeFixtureSkinInsets(9.0f, 9.0f, 9.0f, 9.0f);
        regions.push_back(sprite);
        this.m_skin.setAtlas(AssetRef<Texture>("tests/ui/texture"), 128u, 32u, 1.0f, regions);
        ASSERT_TRUE(this.m_skin.validatePayload());
        this.m_builder.setSkin(this.m_skin);
    }
}

[ordered]
class ImageLoaderTests{
    public HeapStorage storage = HeapStorage(s_UiCaseTestsUiImageLoader);
    public CapturingLogger m_logger;
    public LoggerRegistrationGuard m_loggerGuard;
    public TestValueSlot<SharedPool> poolSlot;
    public mut SharedPool m_pool;
    public TestValueSlot<AssetRegistry> registrySlot;
    public mut AssetRegistry m_registry;
    public mut AssetRegistry registry(){ return this.m_registry; }
    public MemoryImageBinarySource m_source;
    public TestValueSlot<AssetManager> assetSlot;
    public mut AssetManager m_assets;
    public mut AssetManager assets(){ return this.m_assets; }

    public AssetRef<Texture> m_identity = AssetRef<Texture>("tests/ui/image_loader/texture");
    public ImageLoaderTests(){
        this.m_loggerGuard = LoggerRegistrationGuard(this.m_logger, LoggerBreakPolicy::BreakOnFatal);
        this.m_pool = this.poolSlot.constructIn(this.storage);
        this.m_registry = this.registrySlot.constructIn(this.storage);
        this.m_assets = this.assetSlot.constructIn(this.storage, this.m_registry, this.m_source);
    }
    public void setup(){
        ASSERT_TRUE(this.registry().registerCodec(MakeUnique<DeclaredAssetCodec<Texture>>()));
        this.m_source.m_binary = MakeImageTextureBinary(3u);
    }
    public void rebuildBinary(in u8 initialValue){
        this.m_source.m_binary = MakeImageTextureBinary(initialValue);
    }
    public void flipFirstBinaryByte(){
        this.m_source.m_binary[0u] ^= 0xFFu;
    }
    public void zeroAndClearBinary(){
        for(mut u8 byteValue : this.m_source.m_binary)
            byteValue = 0u;
        this.m_source.m_binary.clear();
    }
    public b8 unregisterTextureCodec(){
        return this.registry().unregisterCodec(s_ImageFixtureTextureType);
    }
    public b8 registerMisdirectedCodec(in b8 wrongType){
        return this.registry().registerCodec(MakeUnique<MisdirectedImageCodec>(s_ImageFixtureTextureType, wrongType), true);
    }
    public b8 sawError(in StringView substring)const{
        return this.m_logger.sawErrorContainingUtf8(substring);
    }
    public b8 payloadDisjointFromSource(in SharedImageSource image)const{
        const usize payloadOffset = s_TextureHeaderBinaryBytes + 2u * s_TextureMipLevelBinaryBytes;
        return TestDataAddress(image.deref().texture().payloadBytes()) != TestDataAddress(this.m_source.m_binary) + payloadOffset;
    }
}

class UiImageSourceTextureDescription{
    public u32 width = 9u;
    public u32 height = 5u;
    public u32 depth = 1u;
    public TexturePayloadDimension dimension = TexturePayloadDimension::Texture2D;
    public TexturePayloadFormat format = TexturePayloadFormat::UastcLdr4x4;
    public TextureAlphaMode alphaMode = TextureAlphaMode::EmbeddedLdr;
    public u8 alphaConstant = s_TextureOpaqueAlphaUnorm8;
    public u8 seed = 37u;


}

[ordered]
class UiImageSourceTests{
    public CapturingLogger m_logger;
    public LoggerRegistrationGuard m_loggerGuard;
    public HeapStorage m_inputArena = HeapStorage(s_UiCaseTestsUiImageSourceInput);
    public HeapStorage m_sourceArena = HeapStorage(s_UiCaseTestsUiImageSourceOwned);
    public TestValueSlot<SharedPool> poolSlot;
    public mut SharedPool m_pool;

    public UiImageSourceTests(){
        this.m_loggerGuard = LoggerRegistrationGuard(this.m_logger, LoggerBreakPolicy::BreakOnFatal);
        this.m_pool = this.poolSlot.constructIn(this.m_sourceArena);
    }
    public void install(in UiImageSourceTextureDescription description, in MipLevelVector mips, in Vector<u8> bytes, mut Texture texture)const{
        texture.setPayload(description.width, description.height, mips, bytes, description.dimension, description.depth, description.format, description.alphaMode, description.alphaConstant);
    }
    public b8 prepareDefault(mut Texture texture)const{ return this.prepareCustom(texture, UiImageSourceTextureDescription()); }
    public b8 prepareCustom(mut Texture texture, in UiImageSourceTextureDescription description)const{
        const auto count = ComputeCompleteMipCount(description.dimension, description.width, description.height, description.depth);
        if(!count.has_value())
            return false;
        MipLevelVector mips;
        mips.reserve(count.value());
        u32 width = description.width;
        u32 height = description.height;
        u32 depth = description.depth;
        u64 offset = 0u;
        for(u32 index = 0u; index < count.value(); ++index){
            const auto plane = ComputeMipPlaneBlockLayout(description.format, width, height);
            const auto slices = ComputeMipSliceCount(description.dimension, depth);
            if(!plane.has_value() || !slices.has_value())
                return false;
            TextureMipLevel mip;
            mip.offsetBytes = offset;
            mip.sizeBytes = plane.value().planeByteCount * slices.value();
            mip.width = width;
            mip.height = height;
            mip.blockCountX = plane.value().blocksX;
            mip.blockCountY = plane.value().blocksY;
            mip.sliceCount = slices.value();
            mips.push_back(mip);
            offset += mip.sizeBytes;
            width = Max(1u, width >> 1u);
            height = Max(1u, height >> 1u);
            if(description.dimension == TexturePayloadDimension::Texture3D)
                depth = Max(1u, depth >> 1u);
        }
        u64 byteCount = offset;
        if(description.alphaMode == TextureAlphaMode::SeparateUastcLdr4x4)
            byteCount *= 2u;
        if(byteCount > usize.max)
            return false;
        Vector<u8> bytes;
        bytes.resize(cast<usize>(byteCount));
        for(usize index = 0u; index < bytes.size(); ++index)
            bytes[index] = cast<u8>(cast<u32>(description.seed) + index * 17u);
        this.install(description, mips, bytes, texture);
        return true;
    }
    public void installEmptyBytesKeepMips(mut Texture texture){
        MipLevelVector mips = texture.mipLevels();
        Vector<u8> bytes;
        this.install(UiImageSourceTextureDescription(), mips, bytes, texture);
    }
    public void installShapeVariant(mut Texture texture, in u32 variant){
        UiImageSourceTextureDescription description;
        switch(variant){
        case 0u: description.width = 0u; break;
        case 1u: description.height = 0u; break;
        case 2u: description.depth = 0u; break;
        case 3u: description.depth = 2u; break;
        case 4u: description.dimension = cast<TexturePayloadDimension>(255u); break;
        case 5u: description.format = cast<TexturePayloadFormat>(255u); break;
        case 6u: description.alphaMode = cast<TextureAlphaMode>(255u); break;
        }
        MipLevelVector mips = texture.mipLevels();
        Vector<u8> bytes = texture.payloadBytes();
        this.install(description, mips, bytes, texture);
    }
    public void installMipVariant(mut Texture texture, in u32 variant){
        MipLevelVector mips = texture.mipLevels();
        Vector<u8> bytes = texture.payloadBytes();
        switch(variant){
        case 0u: mips.pop_back(); break;
        case 1u: mips[1u].width = 3u; break;
        case 2u: mips[1u].offsetBytes += 16u; break;
        case 3u: mips[0u].sizeBytes -= 16u; break;
        case 4u: ++mips[0u].blockCountX; break;
        case 5u: mips[0u].sliceCount = 2u; break;
        case 6u: mips.push_back(mips.back()); break;
        }
        this.install(UiImageSourceTextureDescription(), mips, bytes, texture);
    }
    public void installTransportVariant(mut Texture texture, in u32 variant){
        UiImageSourceTextureDescription description;
        MipLevelVector mips = texture.mipLevels();
        Vector<u8> bytes = texture.payloadBytes();
        switch(variant){
        case 0u: bytes.pop_back(); break;
        case 1u: bytes.push_back(0u); break;
        case 2u:
            description.format = TexturePayloadFormat::UastcHdr4x4;
            description.alphaMode = TextureAlphaMode::SeparateUastcLdr4x4;
            break;
        case 3u: description.format = TexturePayloadFormat::UastcHdr4x4; break;
        case 4u:
            description.alphaMode = TextureAlphaMode::ConstantUnorm8;
            description.alphaConstant = 77u;
            break;
        case 5u: description.alphaConstant = 77u; break;
        }
        this.install(description, mips, bytes, texture);
    }
    public void expectSeparateHdrAlphaStream(in Texture original, in SharedImageSource source)const{
        in Texture copied = source.deref().texture();
        EXPECT_EQ(copied.primaryPayloadByteCount(), 144u);
        ASSERT_EQ(copied.payloadBytes().size(), 288u);
        ASSERT_FALSE(copied.alphaUastcBlocks().empty());
        EXPECT_EQ(TestDataAddress(copied.alphaUastcBlocks()), TestDataAddress(copied.payloadBytes()) + 144u);
        EXPECT_NE(TestDataAddress(copied.alphaUastcBlocks()), TestDataAddress(original.alphaUastcBlocks()));
        EXPECT_EQ(copied.alphaUastcBlocks()[143u], cast<u8>(37u + 287u * 17u));
    }
}

static_assert(!is_cpp_constructible<ImageSource>());
static_assert(!is_cpp_constructible<ImageSource, mut GlobalAllocator, in Texture>());
static_assert(!is_cpp_constructible<ImageSource, mut GlobalAllocator, in Texture, u64>());
static_assert(!is_cpp_constructible<ImageSource, in ImageSource>());
static_assert(!is_cpp_constructible<ImageSource, ImageSource>());
static_assert(!ImageFixtureMoveAssignable<ImageSource>());


