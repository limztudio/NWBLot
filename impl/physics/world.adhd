    public b8 setJointRatio(in JointId jointId, in f32 ratio){
        if(!this.isValidJoint(jointId) || !IsFinite(VectorSingle(ratio)))
            return false;
        in JointType jt = this.m_joints[jointId.index].type;
        if((jt == JointType::Gear || jt == JointType::RackAndPinion) && Abs(VectorSingle(ratio)).x <= 1.0e-7f)
            return false;
        if(jt == JointType::Pulley && ratio <= 0.0f)
            return false;
        this.m_joints[jointId.index].ratio = ratio;
        this.resetJointWarmStartAndWake(jointId.index);
        return true;
    }

    public Expected<f32> tryGetJointRatio(in JointId jointId)const{
