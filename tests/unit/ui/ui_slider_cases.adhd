    EXPECT_FALSE(self.m_state.result().valueChanged);
    const SliderPlacement placement = self.m_state.placement();
    EXPECT_FLOAT_EQ(CenterUiRect(placement.thumb).x, placement.centerTravel.x + placement.centerTravel.width);
    self.press(UiSliderKey::Tab);
    self.press(UiSliderKey::Home);
    ASSERT_TRUE(self.accept(2u));
    EXPECT_DOUBLE_EQ(self.m_state.value(), 0.0);
    EXPECT_TRUE(self.m_state.result().valueChanged);
}

void VerifyUiSliderBuilderTests_IdleFramesPreserveSignedZeroBitsAndDoNotInventChangeNotifications(mut UiSliderBuilderTests self){
    ASSERT_TRUE(self.m_state.setValue(bit_cast<f64>(s_UiSliderNegZeroF64Bits)));
    ASSERT_TRUE(self.accept(1u));
    EXPECT_EQ(bit_cast<u64>(self.m_state.value()), s_UiSliderNegZeroF64Bits);
    ASSERT_TRUE(self.accept(2u));
    EXPECT_EQ(bit_cast<u64>(self.m_state.value()), s_UiSliderNegZeroF64Bits);
    EXPECT_TRUE(self.m_state.result().valid);
