type OsServiceHook = Func<128u, void()>;
type OsSessionHook = Func<128u, void(in TextInputSessionToken)>;
type ClipboardChannelEnum = ClipboardChannel;
type ClipboardOperationEnum = ClipboardOperation;
type ClipboardPollResultEnum = ClipboardPollResult;
type ClipboardStatusEnum = ClipboardStatus;
type TextInputCancelReasonEnum = TextInputCancelReason;
type TextInputChangeCauseEnum = TextInputChangeCause;
type TextInputPollResultEnum = TextInputPollResult;
type ClipboardAdmissionEnum = ClipboardAdmission;
type TextInputAdmissionEnum = TextInputAdmission;
type TextInputDeletionBasisEnum = TextInputDeletionBasis;
type TextInputEventKindEnum = TextInputEventKind;


