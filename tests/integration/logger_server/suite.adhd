void VerifyLoggerServerCrash_LinuxAssertCrashProducesObservableLoggerReport(mut LoggerServerCrash self){
    if(!IsDesktopLinuxLoggerCrashPlatform())
        return;

    LoggerTestArena testArena = LoggerTestArena();
    const StringView group = "logger_server_linux_assert_observe_test";
    const StringView stem = "linux_assert_observe_001";
    RemoveTestArtifacts(testArena.arena, group);

    const CrashTestPath spoolDirectory = SpoolDirectory(testArena.arena, group);
    const CrashTestPath pendingDirectory = spoolDirectory / s_PendingDirectoryName;
    const CrashTestPath archiveInputDirectory = ArchiveInputDirectory(testArena.arena, group);
    const CrashTestPath archivePath = ArchivePath(testArena.arena, group, stem);
    b8 externalSymbolizerAvailable = false;
    native(in spoolDirectory, in pendingDirectory, in archiveInputDirectory, in archivePath, mut testArena, mut externalSymbolizerAvailable){
#if defined(NWB_PLATFORM_LINUX) && !defined(NWB_PLATFORM_ANDROID)
        auto& arena = testArena.arena;
        const AStringView expectedAssertCategory(LinuxObservableAssertCategory());
        const pid_t childPid = fork();
        ASSERT_GE(childPid, 0);
        if(childPid == 0){
            PersistentArena installArena(s_AssertChildInstallArena, PersistentArena::StructureAlignedSize(64u * 1024u));
            Core::Crash::CrashConfigT<PersistentArena> config(installArena);
            config.applicationName = s_ApplicationName;
            config.version = s_ApplicationVersion;
            config.buildId = AStringView("linux-assert-observe-test");
            config.spoolDirectory = spoolDirectory;

            if(!Core::Crash::InstallCrashHandler(config))
                _exit(121);

            LinuxSilenceExpectedCrashChildConsole();
            LinuxForceAssertFalseForCrashObservation();
            _exit(122);
        }

        int status = 0;
        while(waitpid(childPid, &status, 0) < 0){
            if(errno == EINTR)
                continue;
            break;
        }

        EXPECT_TRUE(WIFSIGNALED(status));
        EXPECT_EQ(WTERMSIG(status), SIGABRT);

        {
            constexpr u32 s_PendingDirectoryReadyTimeoutMS = 3000u;
            const auto directoryReady = WaitForDirectory(pendingDirectory, s_PendingDirectoryReadyTimeoutMS);
            ASSERT_TRUE(directoryReady);
            EXPECT_TRUE(*directoryReady);
        }

        CrashTestText expectedAbortCode(arena);
        expectedAbortCode += "\"reason_code\": ";
        AppendDecimalText(static_cast<u64>(SIGABRT), expectedAbortCode);
        EXPECT_FALSE(PendingDirectoryContainsManifestTexts(arena, pendingDirectory, AStringView("\"reason_kind\": \"signal\""), AStringView(expectedAbortCode.data(), expectedAbortCode.size())));

        const auto assertPackageDirectory = WaitForTriggerPackage(arena, pendingDirectory, expectedAssertCategory, "false", AStringView(), s_TestSourceFilename);
        EXPECT_TRUE(assertPackageDirectory);

        ASSERT_TRUE(assertPackageDirectory);
        ScratchArena archiveScratch(s_ArchiveScratch);
        const auto archive = Core::Crash::CrashDetail::CrashPackageArchive::Build(arena, archiveScratch, *assertPackageDirectory);
        ASSERT_TRUE(archive);
        ASSERT_TRUE(EnsureDirectories(archiveInputDirectory));
        EXPECT_TRUE(WriteBinaryFile(archivePath, *archive));
        const auto externalSymbolizer = LinuxExternalSymbolizerAvailable(arena);
        ASSERT_TRUE(externalSymbolizer);
        externalSymbolizerAvailable = *externalSymbolizer;
#endif
    }

    const CrashIngestResult result = ProcessCrashUpload(testArena.arena, archivePath, MakeIngestConfig(testArena.arena, group));
    EXPECT_TRUE(result.accepted);
    EXPECT_EQ(result.type, s_LogTypeAssert);

    CrashTestText report = CrashTestText(testArena.arena);
    ASSERT_TRUE(ReadServerSymbolicationText(testArena.arena, group, stem, report));
    EXPECT_TRUE(Contains(report, s_PlatformLinux));
    EXPECT_TRUE(Contains(report, "reason=manual_dump"));
    EXPECT_TRUE(Contains(report, s_Event));
    EXPECT_TRUE(Contains(report, "event=assert"));
    EXPECT_TRUE(Contains(report, s_StatusCallstackCaptured));
    EXPECT_TRUE(Contains(report, s_Callstack));
    EXPECT_EQ(report.find("false\nat "), 0u);
    EXPECT_TRUE(Contains(report, s_TestSourceFilename));
    if(externalSymbolizerAvailable)
        EXPECT_TRUE(Contains(report, "LinuxForceAssertFalseForCrashObservation"));

    PreserveObservedReport(testArena.arena, StringView(report.data(), report.size()), "linux_assert");
    RemoveTestArtifacts(testArena.arena, group);
}

void VerifyLoggerServerCrash_RecoverableErrorDiagnosticProducesObservableLoggerReport(mut LoggerServerCrash self){
    if(!IsDesktopLoggerCrashPlatform())
        return;

    LoggerTestArena testArena = LoggerTestArena();
    const StringView group = "logger_server_recoverable_error_observe_test";
    const StringView stem = "recoverable_error_observe_001";
    const StringView errorMessage = "recoverable logger error observation";
    RemoveTestArtifacts(testArena.arena, group);

    const CrashTestPath spoolDirectory = SpoolDirectory(testArena.arena, group);
    const CrashTestPath pendingDirectory = spoolDirectory / s_PendingDirectoryName;
    const CrashTestPath archiveInputDirectory = ArchiveInputDirectory(testArena.arena, group);
    const CrashTestPath archivePath = ArchivePath(testArena.arena, group, stem);
    b8 externalSymbolizerAvailable = false;
    native(in spoolDirectory, in pendingDirectory, in archiveInputDirectory, in archivePath, in errorMessage, mut testArena, mut externalSymbolizerAvailable){
#if defined(NWB_PLATFORM_WINDOWS) || (defined(NWB_PLATFORM_LINUX) && !defined(NWB_PLATFORM_ANDROID))
        auto& arena = testArena.arena;
        PersistentArena installArena(s_RecoverableErrorInstallArena, PersistentArena::StructureAlignedSize(64u * 1024u));
        Core::Crash::CrashConfigT<PersistentArena> crashConfig(installArena);
        crashConfig.applicationName = s_ApplicationName;
        crashConfig.version = s_ApplicationVersion;
        crashConfig.buildId = AStringView("recoverable-error-observe-test");
        crashConfig.spoolDirectory = spoolDirectory;

        const b8 installed = Core::Crash::InstallCrashHandler(crashConfig);
        EXPECT_TRUE(installed);

        b8 continuedAfterError = false;
        if(installed){
            CaptureRecoverableErrorForCrashObservation(errorMessage);
            continuedAfterError = true;
        }

        const auto errorPackageDirectory = WaitForTriggerPackage(arena, pendingDirectory, Core::Common::LoggerDetail::s_DiagnosticEventCategoryError, AStringView(), errorMessage, s_TestSourceFilename);
        EXPECT_TRUE(errorPackageDirectory);
        EXPECT_TRUE(continuedAfterError);
        Core::Crash::UninstallCrashHandler();

        ASSERT_TRUE(errorPackageDirectory);
        ScratchArena archiveScratch(s_ArchiveScratch);
        const auto archive = Core::Crash::CrashDetail::CrashPackageArchive::Build(arena, archiveScratch, *errorPackageDirectory);
        ASSERT_TRUE(archive);
        ASSERT_TRUE(EnsureDirectories(archiveInputDirectory));
        EXPECT_TRUE(WriteBinaryFile(archivePath, *archive));
#if defined(NWB_PLATFORM_LINUX) && !defined(NWB_PLATFORM_ANDROID)
        const auto externalSymbolizer = LinuxExternalSymbolizerAvailable(arena);
        ASSERT_TRUE(externalSymbolizer);
        externalSymbolizerAvailable = *externalSymbolizer;
#endif
#endif
    }

    const CrashIngestResult result = ProcessCrashUpload(testArena.arena, archivePath, MakeIngestConfig(testArena.arena, group));
    EXPECT_TRUE(result.accepted);
    EXPECT_EQ(result.type, s_LogTypeError);

    CrashTestText report = CrashTestText(testArena.arena);
    ASSERT_TRUE(ReadServerSymbolicationText(testArena.arena, group, stem, report));
    EXPECT_TRUE(Contains(report, s_Event));
    EXPECT_TRUE(Contains(report, "event=error"));
    EXPECT_TRUE(Contains(report, errorMessage));
    EXPECT_TRUE(Contains(report, s_TestSourceFilename));
    if(IsDesktopLinuxLoggerCrashPlatform()){
        EXPECT_TRUE(Contains(report, s_PlatformLinux));
        EXPECT_TRUE(Contains(report, s_StatusCallstackCaptured));
        EXPECT_TRUE(Contains(report, s_Callstack));
        if(externalSymbolizerAvailable)
            EXPECT_TRUE(Contains(report, "CaptureRecoverableErrorForCrashObservation"));
    }
    else if(IsWindowsLoggerCrashPlatform()){
        EXPECT_TRUE(Contains(report, "platform=windows"));
        EXPECT_TRUE(Contains(report, "resolver=windows_pdb_minidump"));
    }

    PreserveObservedReport(testArena.arena, StringView(report.data(), report.size()), "recoverable_error");
    RemoveTestArtifacts(testArena.arena, group);
}

void VerifyLoggerServerCrash_LinuxCrashPackageReportsMissingProcMaps(mut LoggerServerCrash self){
    LoggerTestArena testArena = LoggerTestArena();
    const StringView group = "logger_server_linux_missing_maps_test";
    const StringView stem = "linux_missing_maps_001";
    RemoveTestArtifacts(testArena.arena, group);

    CrashTestText archive = CrashTestText(testArena.arena);
    BeginArchiveWithManifest("linux-missing-maps-test", s_Linux, s_Crash, s_Signal, 11u, s_IncludeEventField, ManifestTriggerFields(), testArena.arena, archive);
    AppendArchiveFile(s_CpuContextFileName, "instruction_pointer=4198964\n", archive);

    const CrashIngestResult result = ProcessCrashArchive(testArena.arena, group, stem, archive);
    EXPECT_TRUE(result.accepted);

    CrashTestText report = CrashTestText(testArena.arena);
    ASSERT_TRUE(ReadServerSymbolicationText(testArena.arena, group, stem, report));
    EXPECT_TRUE(Contains(report, s_PlatformLinux));
    EXPECT_TRUE(Contains(report, "proc_maps=missing"));
    EXPECT_TRUE(Contains(report, "proc maps missing for module lookup"));

    RemoveTestArtifacts(testArena.arena, group);
}

void VerifyLoggerServerCrash_LinuxCrashPackageReportsUnmappedInstructionPointer(mut LoggerServerCrash self){
    LoggerTestArena testArena = LoggerTestArena();
    const StringView group = "logger_server_linux_unmapped_ip_test";
    const StringView stem = "linux_unmapped_ip_001";
    RemoveTestArtifacts(testArena.arena, group);

    CrashTestText archive = CrashTestText(testArena.arena);
    BeginArchiveWithManifest("linux-unmapped-ip-test", s_Linux, s_Crash, s_Signal, 11u, s_IncludeEventField, ManifestTriggerFields(), testArena.arena, archive);
    AppendArchiveFile(s_CpuContextFileName, "instruction_pointer=7340032\n", archive);
    AppendArchiveFile(s_ProcMapsFileName, "00400000-00452000 r-xp 00000000 08:01 123 /tmp/nwb_loader\n", archive);

    const CrashIngestResult result = ProcessCrashArchive(testArena.arena, group, stem, archive);
    EXPECT_TRUE(result.accepted);

    CrashTestText report = CrashTestText(testArena.arena);
    ASSERT_TRUE(ReadServerSymbolicationText(testArena.arena, group, stem, report));
    EXPECT_TRUE(Contains(report, s_PlatformLinux));
    EXPECT_TRUE(Contains(report, "proc_maps=present"));
    EXPECT_TRUE(Contains(report, "instruction pointer was not found in proc maps"));

    RemoveTestArtifacts(testArena.arena, group);
}

void VerifyLoggerServerCrash_LinuxCrashPackageDoesNotWrapSymbolOffset(mut LoggerServerCrash self){
    LoggerTestArena testArena = LoggerTestArena();
    const StringView group = "logger_server_linux_offset_overflow_test";
    const StringView stem = "linux_offset_overflow_001";
    RemoveTestArtifacts(testArena.arena, group);

    CrashTestText archive = CrashTestText(testArena.arena);
    BeginArchiveWithManifest("linux-offset-overflow-test", s_Linux, s_Crash, s_Signal, 11u, s_IncludeEventField, ManifestTriggerFields(), testArena.arena, archive);
    AppendArchiveFile(s_CpuContextFileName, "instruction_pointer=4097\n", archive);
    AppendArchiveFile(s_ProcMapsFileName, "1000-2000 r-xp ffffffffffffffff 00:00 0 /tmp/overflow\n", archive);
    const CrashIngestResult result = ProcessCrashArchive(testArena.arena, group, stem, archive);
    ASSERT_TRUE(result.accepted);

    CrashTestText report = CrashTestText(testArena.arena);
    ASSERT_TRUE(ReadServerSymbolicationText(testArena.arena, group, stem, report));
    EXPECT_TRUE(Contains(report, "instruction_pointer_module=/tmp/overflow"));
    EXPECT_TRUE(Contains(report, "symbolication_relative_ip=unavailable"));
    RemoveTestArtifacts(testArena.arena, group);
}

void VerifyLoggerServerCrash_AndroidCrashPackageReportsTombstoneWithoutFrames(mut LoggerServerCrash self){
    LoggerTestArena testArena = LoggerTestArena();
    const StringView group = "logger_server_android_no_frames_test";
    const StringView stem = "android_no_frames_001";
    RemoveTestArtifacts(testArena.arena, group);

    CrashTestText archive = CrashTestText(testArena.arena);
    BeginArchiveWithManifest("android-no-frames-test", "android", s_Crash, s_ManualDump, 0u, s_IncludeEventField, ManifestTriggerFields(), testArena.arena, archive);
    AppendArchiveFile(s_AndroidTombstoneFileName, "pid: 7, tid: 7, name: nwb\nbacktrace:\n", archive);

    const CrashIngestResult result = ProcessCrashArchive(testArena.arena, group, stem, archive);
    EXPECT_TRUE(result.accepted);

    CrashTestText report = CrashTestText(testArena.arena);
    ASSERT_TRUE(ReadServerSymbolicationText(testArena.arena, group, stem, report));
    EXPECT_TRUE(Contains(report, "platform=android"));
    EXPECT_TRUE(Contains(report, "status=not_decoded"));
    EXPECT_TRUE(Contains(report, "android_tombstone=present"));
    EXPECT_TRUE(Contains(report, "no native frame lines were recognized"));

    RemoveTestArtifacts(testArena.arena, group);
}

void VerifyLoggerServerCrash_WindowsCrashPackageReportsMissingMinidump(mut LoggerServerCrash self){
    LoggerTestArena testArena = LoggerTestArena();
    const StringView group = "logger_server_windows_missing_dump_test";
    const StringView stem = "windows_missing_dump_001";
    RemoveTestArtifacts(testArena.arena, group);

    CrashTestText archive = CrashTestText(testArena.arena);
    BeginArchiveWithManifest("windows-missing-dump-test", s_Windows, s_Crash, s_WindowsExceptionCategory, 0xC0000005u, s_IncludeEventField, ManifestTriggerFields(), testArena.arena, archive);

    const CrashIngestResult result = ProcessCrashArchive(testArena.arena, group, stem, archive);
    EXPECT_TRUE(result.accepted);

    CrashTestText report = CrashTestText(testArena.arena);
    ASSERT_TRUE(ReadServerSymbolicationText(testArena.arena, group, stem, report));
    EXPECT_TRUE(Contains(report, "platform=windows"));
    EXPECT_TRUE(Contains(report, s_Event));
    EXPECT_TRUE(Contains(report, "event=crash"));
    EXPECT_TRUE(Contains(report, "exception=access_violation 0x00000000c0000005"));
    EXPECT_TRUE(Contains(report, "resolver=windows_pdb_minidump"));
    native(mut testArena, in report){
#if defined(NWB_PLATFORM_WINDOWS)
        CrashTestText missingDumpMessage(testArena.arena);
        missingDumpMessage += CrashNames::s_ProcessDumpFileName;
        missingDumpMessage += " is missing or unreadable";
        EXPECT_TRUE(Contains(report, AStringView(missingDumpMessage.data(), missingDumpMessage.size())));
#else
        (void)testArena;
        EXPECT_TRUE(Contains(report, "only available on Windows logserver builds"));
#endif
    }

    RemoveTestArtifacts(testArena.arena, group);
}

void VerifyLoggerServerCrash_WindowsCrashPackageDecodesGpuDetectiveCaptureInProcess(mut LoggerServerCrash self){
    LoggerTestArena testArena = LoggerTestArena();
    const StringView group = "logger_server_gpu_detective_test";
    const StringView stem = "gpu_detective_001";
    RemoveTestArtifacts(testArena.arena, group);

    CrashTestText archive = CrashTestText(testArena.arena);
    BeginArchiveWithManifest("gpu-detective-test", s_Windows, s_Crash, s_WindowsExceptionCategory, 0xC0000005u, s_IncludeEventField, ManifestTriggerFields(), testArena.arena, archive);
    // Malformed RGD input must report decode failure without aborting crash ingest.
    AppendArchiveFile(s_GpuDetectiveCaptureFileName, "not a valid radeon gpu detective capture\n", archive);

    const CrashIngestResult result = ProcessCrashArchive(testArena.arena, group, stem, archive);
    EXPECT_TRUE(result.accepted);

    CrashTestText report = CrashTestText(testArena.arena);
    ASSERT_TRUE(ReadServerSymbolicationText(testArena.arena, group, stem, report));
    // The decoder always emits the section header before reporting invalid input.
    EXPECT_TRUE(Contains(report, "[gpu_detective]"));
    EXPECT_TRUE(Contains(report, "status=decode_failed"));

    RemoveTestArtifacts(testArena.arena, group);
}

void VerifyLoggerServerCrash_InvalidCrashPackageIsRejected(mut LoggerServerCrash self){
    LoggerTestArena testArena = LoggerTestArena();
    const StringView group = "logger_server_invalid_crash_test";
    const StringView stem = "invalid_001";
    RemoveTestArtifacts(testArena.arena, group);

    CrashTestText archive = CrashTestText(testArena.arena);
    archive += s_InvalidArchiveHeader;
    const CrashIngestResult result = ProcessCrashArchive(testArena.arena, group, stem, archive);

    EXPECT_FALSE(result.accepted);
    EXPECT_EQ(result.type, s_LogTypeError);
    native(in result){
        EXPECT_TRUE(Contains(result.message, NWB_TEXT("Crash upload rejected")));
        EXPECT_TRUE(Contains(result.message, NWB_TEXT("invalid crash archive header")));
    }

    ExpectIsRegularFile(InvalidArchivePath(testArena.arena, group, stem), true);
    RemoveTestArtifacts(testArena.arena, group);
}

void VerifyLoggerServerCrash_UnsafeArchiveEntryCannotEscapePackageDirectory(mut LoggerServerCrash self){
    LoggerTestArena testArena = LoggerTestArena();
    const StringView group = "logger_server_unsafe_archive_20261107";
    const StringView stem = "unsafe_001";
    const CrashTestPath testDirectory = TestCaseDirectory(testArena.arena, group);
    native(in testDirectory){
        const auto existed = FileExistsNoFollow(testDirectory);
        ASSERT_TRUE(existed);
        ASSERT_FALSE(*existed);
    }

    CrashTestText archive = CrashTestText(testArena.arena);
    archive += s_ArchiveHeaderText;
    AppendArchiveFile("../escape", "payload", archive);
    const CrashIngestResult result = ProcessCrashArchive(testArena.arena, group, stem, archive);
    EXPECT_FALSE(result.accepted);
    const CrashTestPath escapePath = StorageDirectory(testArena.arena, group) / "packages" / "escape";
    native(in result, in escapePath){
        EXPECT_TRUE(Contains(result.message, NWB_TEXT("malformed crash archive file header")));
        const auto escaped = FileExistsNoFollow(escapePath);
        ASSERT_TRUE(escaped);
        EXPECT_FALSE(*escaped);
    }
    RemoveTestArtifacts(testArena.arena, group);
}

void VerifyLoggerServerCrash_CrashManifestWithoutEventIsRejected(mut LoggerServerCrash self){
    LoggerTestArena testArena = LoggerTestArena();
    const StringView group = "logger_server_missing_event_manifest_crash_test";
    const StringView stem = "missing_event_manifest_001";
    RemoveTestArtifacts(testArena.arena, group);

    CrashTestText archive = CrashTestText(testArena.arena);
    BeginArchiveWithManifest("missing-event-manifest-test", s_Linux, s_Crash, s_Signal, 11u, s_OmitEventField, ManifestTriggerFields(), testArena.arena, archive);
    const CrashIngestResult result = ProcessCrashArchive(testArena.arena, group, stem, archive);

    EXPECT_FALSE(result.accepted);
    EXPECT_EQ(result.type, s_LogTypeError);
    native(in result){
        EXPECT_TRUE(Contains(result.message, NWB_TEXT("manifest.json is missing required fields")));
    }
    ExpectIsRegularFile(InvalidArchivePath(testArena.arena, group, stem), true);

    RemoveTestArtifacts(testArena.arena, group);
}

void VerifyLoggerServerCrash_InvalidManifestBooleanIsRejectedWhileFalseAndZeroRemainValid(mut LoggerServerCrash self){
    LoggerTestArena testArena = LoggerTestArena();
    const StringView group = "logger_server_boolean_manifest_test";
    const StringView validStem = "valid_false_001";
    const StringView invalidStem = "invalid_boolean_001";
    RemoveTestArtifacts(testArena.arena, group);

    CrashTestText validArchive = CrashTestText(testArena.arena);
    BeginArchiveWithManifest(validStem, s_Linux, s_Crash, s_Signal, 0u, s_IncludeEventField, ManifestTriggerFields(), testArena.arena, validArchive);
    const CrashIngestResult validResult = ProcessCrashArchive(testArena.arena, group, validStem, validArchive);
    ASSERT_TRUE(validResult.accepted);

    CrashTestText manifest = BuildManifest(invalidStem, s_Linux, s_Crash, s_Signal, 0u, s_IncludeEventField, ManifestTriggerFields(), testArena.arena);
    const StringView booleanPrefix = "\"has_exception_context\": ";
    const usize fieldOffset = StringView(manifest.data(), manifest.size()).find(booleanPrefix);
    ASSERT_LT(fieldOffset, manifest.size());
    manifest.replace(fieldOffset + booleanPrefix.size(), 5u, "null");

    CrashTestText invalidArchive = CrashTestText(testArena.arena);
    invalidArchive += s_ArchiveHeaderText;
    AppendArchiveFile(s_ManifestFileName, StringView(manifest.data(), manifest.size()), invalidArchive);
    const CrashIngestResult invalidResult = ProcessCrashArchive(testArena.arena, group, invalidStem, invalidArchive);
    EXPECT_FALSE(invalidResult.accepted);
    native(in invalidResult){
        EXPECT_TRUE(Contains(invalidResult.message, NWB_TEXT("manifest.json is missing required fields")));
    }
    ExpectIsRegularFile(InvalidArchivePath(testArena.arena, group, invalidStem), true);
    ExpectIsDirectory(ExtractedPackageDirectory(testArena.arena, group, validStem), true);

    RemoveTestArtifacts(testArena.arena, group);
}

void VerifyLoggerServerCrash_CrashRetentionPrunesOldestAcceptedUploads(mut LoggerServerCrash self){
    LoggerTestArena testArena = LoggerTestArena();
    const StringView group = "logger_server_retention_accepted_test";
    const StringView stem0 = "retention_001";
    const StringView stem1 = "retention_002";
    const StringView stem2 = "retention_003";
    RemoveTestArtifacts(testArena.arena, group);

    CrashIngestConfig config = MakeIngestConfig(testArena.arena, group);
    config.retention.maxExtractedPackages = 2u;
    config.retention.maxRawArchives = 2u;
    config.retention.maxInvalidArchives = 0u;

    CrashTestText archive0 = CrashTestText(testArena.arena);
    BuildLinuxCrashArchive(stem0, testArena.arena, archive0);
    EXPECT_TRUE(ProcessCrashArchive(testArena.arena, group, stem0, archive0, config).accepted);

    CrashTestText archive1 = CrashTestText(testArena.arena);
    BuildLinuxCrashArchive(stem1, testArena.arena, archive1);
    EXPECT_TRUE(ProcessCrashArchive(testArena.arena, group, stem1, archive1, config).accepted);

    CrashTestText archive2 = CrashTestText(testArena.arena);
    BuildLinuxCrashArchive(stem2, testArena.arena, archive2);
    EXPECT_TRUE(ProcessCrashArchive(testArena.arena, group, stem2, archive2, config).accepted);

    ExpectPathExists(ExtractedPackageDirectory(testArena.arena, group, stem0), false);
    ExpectPathExists(RawArchivePath(testArena.arena, group, stem0), false);
    ExpectIsDirectory(ExtractedPackageDirectory(testArena.arena, group, stem1), true);
    ExpectIsRegularFile(RawArchivePath(testArena.arena, group, stem1), true);
    ExpectIsDirectory(ExtractedPackageDirectory(testArena.arena, group, stem2), true);
    ExpectIsRegularFile(RawArchivePath(testArena.arena, group, stem2), true);

    RemoveTestArtifacts(testArena.arena, group);
}

void VerifyLoggerServerCrash_AcceptedCrashWarnsWhenRawArchiveCannotBeRetained(mut LoggerServerCrash self){
    LoggerTestArena testArena = LoggerTestArena();
    const StringView group = "logger_server_raw_archive_failed_test";
    const StringView stem = "raw_blocked_001";
    RemoveTestArtifacts(testArena.arena, group);

    CrashTestText archive = CrashTestText(testArena.arena);
    BuildLinuxCrashArchive(stem, testArena.arena, archive);

    const CrashTestPath storageDir = StorageDirectory(testArena.arena, group);
    const CrashTestPath rawDirFile = storageDir / s_CrashRawDirectoryName;
    native(in storageDir, in rawDirFile){
        EXPECT_TRUE(EnsureDirectories(storageDir));
        EXPECT_TRUE(WriteTextFile(rawDirFile, AStringView("blocked")));
    }

    const CrashIngestConfig config = MakeIngestConfig(testArena.arena, group);
    const CrashIngestResult result = ProcessCrashArchive(testArena.arena, group, stem, archive, config);

    EXPECT_TRUE(result.accepted);
    EXPECT_EQ(result.type, s_LogTypeWarning);
    native(in result){
        EXPECT_TRUE(Contains(result.message, NWB_TEXT("raw upload archive could not be retained")));
    }
    ExpectIsDirectory(ExtractedPackageDirectory(testArena.arena, group, stem), true);
    ExpectPathExists(ArchivePath(testArena.arena, group, stem), false);

    RemoveTestArtifacts(testArena.arena, group);
}

void VerifyLoggerServerCrash_CrashRetentionPrunesOldestInvalidUploads(mut LoggerServerCrash self){
    LoggerTestArena testArena = LoggerTestArena();
    const StringView group = "logger_server_retention_invalid_test";
    const StringView stem0 = "invalid_retention_001";
    const StringView stem1 = "invalid_retention_002";
    RemoveTestArtifacts(testArena.arena, group);

    CrashIngestConfig config = MakeIngestConfig(testArena.arena, group);
    config.retention.maxExtractedPackages = 0u;
    config.retention.maxRawArchives = 0u;
    config.retention.maxInvalidArchives = 1u;

    CrashTestText archive0 = CrashTestText(testArena.arena);
    archive0 += s_InvalidArchiveHeader;
    EXPECT_FALSE(ProcessCrashArchive(testArena.arena, group, stem0, archive0, config).accepted);

    CrashTestText archive1 = CrashTestText(testArena.arena);
    archive1 += s_InvalidArchiveHeader;
    EXPECT_FALSE(ProcessCrashArchive(testArena.arena, group, stem1, archive1, config).accepted);

    ExpectPathExists(InvalidArchivePath(testArena.arena, group, stem0), false);
    ExpectIsRegularFile(InvalidArchivePath(testArena.arena, group, stem1), true);

    RemoveTestArtifacts(testArena.arena, group);
}


