////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_GI_TRACE_COMMON_SLANGI
#define NWB_GRAPHICS_GI_TRACE_COMMON_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "constants.h"
#include "../scene/buffer.slangi"
#include "../scene/lighting.slangi"
#include "../common/math.slangi"
#include "../bvh/instance_material.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GI_SW_TRACE_DEFAULT_ALBEDO
#define NWB_GI_SW_TRACE_DEFAULT_ALBEDO 0.5h, 0.5h, 0.5h
#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct NwbGiTraceHit{
    bool hit;
    float t;
    float3 worldPos;
    float3 normal;
    half3 albedo;
};

NwbGiTraceHit nwbGiTraceClosest(float3 origin, float3 direction, float tMin, float tMax);

bool nwbGiTraceOccluded(float3 origin, float3 direction, float tMin, float tMax);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


half3 nwbGiShadeHit(const NwbGiTraceHit hit, const float3 rayDir){
    half3 irradiance = half3(0.0h, 0.0h, 0.0h);

    const float3 normal = hit.normal;
    const float3 facingNormal = dot(normal, rayDir) < 0.0 ? normal : -normal;

    const uint lightCount = min(nwbSceneLightCount(), NWB_SCENE_MAX_LIGHTS);
    for(uint i = 0u; i < lightCount; ++i){
        const NwbSceneLight light = g_NwbSceneLights[i];
        float3 lightVector;
        half3 lightRadiance;
        nwbSceneResolveLight(light, hit.worldPos, lightVector, lightRadiance);
        if(all(lightRadiance <= half3(0.0h)))
            continue;
        const half ndotl = half(max(dot(facingNormal, lightVector), 0.0h));
        irradiance += lightRadiance * ndotl;
    }

#if NWB_GI_HIT_SHADOW_RAYS
    {
        half bestNdotl = half(0.0h);
        float3 dominantLightDir = float3(0.0, 1.0, 0.0);
        uint dominantLightIndex = NWB_GI_INVALID_LIGHT_INDEX;
        for(uint i = 0u; i < lightCount; ++i){
            const NwbSceneLight light = g_NwbSceneLights[i];
            float3 lv;
            half3 lr;
            nwbSceneResolveLight(light, hit.worldPos, lv, lr);
            if(all(lr <= half3(0.0h)))
                continue;
            const half ndotl = half(max(dot(facingNormal, lv), 0.0h));
            if(ndotl > bestNdotl){
                bestNdotl = ndotl;
                dominantLightDir = lv;
                dominantLightIndex = i;
            }
        }
        if(dominantLightIndex != NWB_GI_INVALID_LIGHT_INDEX && bestNdotl > half(0.0h)){
            const float3 shadowOrigin = hit.worldPos + facingNormal * NWB_GI_TRACE_RAY_MIN_DISTANCE;
            float shadowMaximum = NWB_GI_TRACE_RAY_MAX_DISTANCE;
            const NwbSceneLight dominantLight = g_NwbSceneLights[dominantLightIndex];
            if(dominantLight.params.y >= NWB_SCENE_LIGHT_TYPE_DIRECTIONAL_MAX){
                const float3 toLight = dominantLight.position.xyz - shadowOrigin;
                const float distance = length(toLight);
                shadowMaximum = min(shadowMaximum, distance - NWB_GI_TRACE_RAY_MIN_DISTANCE);
                if(distance > 0.0)
                    dominantLightDir = toLight / distance;
            }
            const bool occluded = shadowMaximum > NWB_GI_TRACE_RAY_MIN_DISTANCE && nwbGiTraceOccluded(shadowOrigin, dominantLightDir, NWB_GI_TRACE_RAY_MIN_DISTANCE, shadowMaximum);
            if(occluded)
                irradiance *= 0.0h;
        }
    }
#endif

    irradiance *= hit.albedo;
    return irradiance;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

