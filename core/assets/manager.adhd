[cpp_header("<core/assets/manager.h>"), cpp_name("::NWB::Core::Assets::AssetBytes")]
extern class AssetByteBuffer{
    void clear();
    usize size()const;
    void resize(in usize count);
    void push_back(in u8 value);
    mut u8 operator[](in usize index);
};

[cpp_header("<core/assets/manager.h>"), cpp_name("::NWB::Core::Assets::AssetManager"), cpp_flags(binary_serializable, no_copy, no_assign)]
extern class AssetManager{
    Expected<UniquePtr<IAsset>> loadSync(...)const;
};

[cpp_header("<core/assets/manager.h>"), cpp_name("::NWB::Core::Assets::IAssetBinarySource"), cpp_flags(no_copy, no_assign, abstract, polymorphic_base)]
extern class IAssetBinarySource{
    b8 readAssetBinary(in cpp_ref Name path, mut AssetByteBuffer bytes)const;
};


