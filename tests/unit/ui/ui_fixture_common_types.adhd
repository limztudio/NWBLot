enum<u8> UiFixtureShaperFault{
    None,
    LeadingGap,
    TrailingGap,
    Overlap,
    InconsistentGlyphEnd,
    NonfinitePlacement,
}

enum<u8> UiFixtureNumericEventKind{
    Text,
    Key,
    Preedit,
    Action,
}

enum<u8> UiFixtureRadioMutation{
    None,
    Select,
    SelectAwayBack,
    Revision,
    Replacement,
    ResetBuilder,
    PanelBuilder,
    ClosePopup,
}

enum<u8> UiFixtureSearchFilterMode{
    All,
    Second,
    Empty,
}

enum<u8> UiFixtureSliderCallbackMutation{
