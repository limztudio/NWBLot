[cpp_header("<impl/assets/graphics/bvh/constants.h>"), cpp_name("NWB_RT_INSTANCE_MATERIAL_FLAG_TRANSPARENT")]
extern const u32 s_ShaderRtInstanceMaterialFlagTransparent;

[cpp_header("<impl/assets/graphics/bvh/constants.h>"), cpp_name("NWB_RT_INSTANCE_MATERIAL_FLAG_REFRACTIVE")]
extern const u32 s_ShaderRtInstanceMaterialFlagRefractive;

[cpp_header("<impl/assets/graphics/bvh/constants.h>"), cpp_name("NWB_RT_INSTANCE_MATERIAL_FLAG_CSG_SHADOW")]
extern const u32 s_ShaderRtInstanceMaterialFlagCsgShadow;

[cpp_header("<impl/assets/graphics/bvh/constants.h>"), cpp_name("NWB_RT_INSTANCE_MATERIAL_FLAG_REFRACTION_ENTRY_CERTIFIED")]
extern const u32 s_ShaderRtInstanceMaterialFlagRefractionEntryCertified;

[cpp_header("<impl/assets/graphics/bvh/constants.h>"), cpp_name("NWB_RT_SHADOW_BASE_INSTANCE_MASK")]
extern const u32 s_ShaderRtShadowBaseInstanceMask;

[cpp_header("<impl/assets/graphics/bvh/constants.h>"), cpp_name("NWB_RT_SHADOW_TRANSPARENT_INSTANCE_MASK")]
extern const u32 s_ShaderRtShadowTransparentInstanceMask;

[cpp_header("<impl/assets/graphics/bvh/constants.h>"), cpp_name("NWB_RT_SHADOW_OPAQUE_INSTANCE_MASK")]
extern const u32 s_ShaderRtShadowOpaqueInstanceMask;

[cpp_header("<impl/assets/graphics/raytrace/constants.h>"), cpp_name("NWB_RT_CSG_INSTANCE_MASK")]
extern const u32 s_ShaderRtCsgInstanceMask;

[cpp_header("<impl/assets/graphics/raytrace/constants.h>"), cpp_name("NWB_RT_REFRACTIVE_INSTANCE_MASK")]
extern const u32 s_ShaderRtRefractiveInstanceMask;

[cpp_header("<impl/assets/graphics/raytrace/constants.h>"), cpp_name("NWB_RT_NON_REFRACTIVE_INSTANCE_MASK")]
extern const u32 s_ShaderRtNonRefractiveInstanceMask;


[cpp_header("<impl/assets/graphics/bvh/binding_slots.h>"), cpp_name("NWB_BVH_SORT_GROUP_SIZE")]
extern const u32 s_ShaderBvhSortGroupSize;

[cpp_header("<impl/assets/graphics/bvh/binding_slots.h>"), cpp_name("NWB_BVH_SORT_PUSH_CONSTANT_WORD_COUNT")]
extern const u32 s_ShaderBvhSortPushConstantWordCount;

[cpp_header("<impl/assets/graphics/bvh/binding_slots.h>"), cpp_name("NWB_BVH_BUILD_MODE_FULL")]
extern const u32 s_ShaderBvhBuildModeFull;
static_assert(size_of<NwbRtInstanceMaterialGpu>() == s_NwbRtInstanceMaterialGpuByteSize, "NwbRtInstanceMaterialGpu must match the shader NwbRtInstanceMaterial std430 layout (9 x uint)");
static_assert(offset_of<NwbRtInstanceMaterialGpu>(shadingModelId) == size_of<u32>() * 2u);
static_assert(RtInstanceMaterialFlag::Transparent == s_ShaderRtInstanceMaterialFlagTransparent);
static_assert(RtInstanceMaterialFlag::Refractive == s_ShaderRtInstanceMaterialFlagRefractive);
static_assert(RtInstanceMaterialFlag::CsgShadow == s_ShaderRtInstanceMaterialFlagCsgShadow);
static_assert(RtInstanceMaterialFlag::RefractionEntryCertified == s_ShaderRtInstanceMaterialFlagRefractionEntryCertified);
static_assert(s_RtShadowBaseInstanceMask == s_ShaderRtShadowBaseInstanceMask);
static_assert(s_RtShadowTransparentInstanceMask == s_ShaderRtShadowTransparentInstanceMask);
static_assert(s_RtShadowOpaqueInstanceMask == s_ShaderRtShadowOpaqueInstanceMask);
static_assert(s_RtCsgInstanceMask == s_ShaderRtCsgInstanceMask);
static_assert(s_RtRefractiveInstanceMask == s_ShaderRtRefractiveInstanceMask);
static_assert(s_RtNonRefractiveInstanceMask == s_ShaderRtNonRefractiveInstanceMask);
static_assert(s_SceneShadowSlotCount == s_ShaderSceneShadowSlotCount);
static_assert(size_of<RayTraceMaterialContextSlots>() == size_of<u32>() * 8u, "Ray-trace material-context slots must stay two uint4 lanes");
static_assert(GpuUploadBlobId().generation == 0u && GpuUploadBlobId().index == s_PreparedGraphInvalidIndex);
static_assert(size_of<NwbBvhNodeGpu>() == s_NwbBvhNodeGpuByteSize, "NwbBvhNodeGpu must match the shader NwbBvhNode std430 layout");
static_assert(size_of<SceneSwBvhInstanceGpu>() == size_of<f32x3x4>() + size_of<u32>() * 4u, "SceneSwBvhInstanceGpu must stay a tight 64-byte record");
static_assert(s_BvhSortGroupSize == s_ShaderBvhSortGroupSize);
static_assert(size_of<BvhSortPushConstants>() == size_of<u32>() * s_ShaderBvhSortPushConstantWordCount, "BvhSortPushConstants must match the shader NwbBvhBitonicSortPushConstants layout");
static_assert(offset_of<BvhSortPushConstants>(mode) == 12u);
static_assert(offset_of<BvhSortPushConstants>(keysHeapSlot) == 16u);
static_assert(offset_of<BvhSortPushConstants>(payloadHeapSlot) == 20u);
static_assert(is_standard_layout<BvhSortPushConstants>());
static_assert(is_trivially_copyable<BvhSortPushConstants>());
static_assert(s_BvhBuildModeFull == s_ShaderBvhBuildModeFull);
static_assert(size_of<BvhBuildPushConstants>() == 64u, "BvhBuildPushConstants must match the shader NwbBvhBuildPushConstants layout");
static_assert(offset_of<BvhBuildPushConstants>(aabbMin) == 32u);
static_assert(offset_of<BvhBuildPushConstants>(parentHeapSlot) == 44u);
static_assert(offset_of<BvhBuildPushConstants>(aabbMax) == 48u);
static_assert(offset_of<BvhBuildPushConstants>(visitCounterHeapSlot) == 60u);
static_assert(is_standard_layout<BvhBuildPushConstants>());
static_assert(is_trivially_copyable<BvhBuildPushConstants>());


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RenderableRayTracingMeshResources{
    public RenderableMeshDesc resolvedMesh;
    public MeshRayTracingResourceSnapshot meshResources;
}

[cpp_unwind]
Expected<RenderableRayTracingMeshResources, RenderableMeshResolution> ResolveRenderableMeshResources(mut MeshSystem meshSystem, mut RendererMeshSystem rendererMeshSystem, in EntityID entity){
    const auto resolved = meshSystem.resolveRenderableMeshStatus(entity);
    if(!resolved.has_value())
        return MakeUnexpected(resolved.error());
    const auto mesh = rendererMeshSystem.findRenderableRayTracingResourceSnapshot(resolved.value());
    if(!mesh.has_value())
        return MakeUnexpected(RenderableMeshResolution::Unavailable);
    RenderableRayTracingMeshResources result;
    result.resolvedMesh = resolved.value();
    result.meshResources = mesh.value();
    return result;
}

ComputeState MakeComputePassState(in ComputePipelineHandle pipeline){
    ComputeState state;
    if(pipeline.valid())
        state.setPipeline(pipeline.deref());
    return state;
}


