[cpp_header("<core/mesh/tangent_frame_rebuild.h>"), cpp_name("::NWB::Core::Mesh::TangentFrameRebuildResult")]
extern class TangentFrameRebuildResult{
    u32 rebuiltVertexCount;
    u32 degenerateUvTriangleCount;
    u32 fallbackTangentVertexCount;
};

[cpp_header("<core/mesh/tangent_frame_rebuild.h>"), cpp_name("::NWB::Core::Mesh::TangentFrameRebuildVertex")]
extern class TangentFrameRebuildVertex{
    f32x4 position;
    f32x4 normal;
    f32x4 tangent;
    f32x2u uv0;
};


[cpp_header("<core/mesh/tangent_frame_rebuild.h>"), cpp_name("::NWB::Core::Mesh::RebuildTangentFrames")]
extern Expected<TangentFrameRebuildResult> RebuildTangentFrames(in Span<u32> indices, mut Span<TangentFrameRebuildVertex> vertices, in f64 minimumTriangleAreaLengthSquared);


