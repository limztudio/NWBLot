    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.causticHistoryStorage = descriptor.value();
    descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage, this.m_targets.causticResolveHalf, this.m_targets.causticHistoryFormat, s_FramebufferSubresources, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.causticResolveHalf = descriptor.value();
    descriptor = RegisterStorageTexture(this.m_heap, this.m_targets.causticResolveHalf, this.m_targets.causticHistoryFormat, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.causticResolveHalfStorage = descriptor.value();
    descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage, this.m_targets.causticResolveGeometry, this.m_targets.causticHistoryFormat, s_FramebufferSubresources, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.causticResolveGeometry = descriptor.value();
    descriptor = RegisterStorageTexture(this.m_heap, this.m_targets.causticResolveGeometry, this.m_targets.causticHistoryFormat, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.causticResolveGeometryStorage = descriptor.value();
    return Expected<void>();
}


Expected<void> DeferredBindlessDescriptorRegistrar::registerSoftShadowTargets(){
    Expected<GpuDescriptorHandle> descriptor = RegisterStorageTexture(this.m_heap, this.m_targets.shadowCoarseTransmittance, this.m_targets.shadowCoarseTransmittanceFormat, TextureDimension::Texture2DArray);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.shadowCoarseTransmittanceStorage = descriptor.value();
    descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage, this.m_targets.shadowSoftGeometry, this.m_targets.shadowSoftGeometryFormat, s_FramebufferSubresources, TextureDimension::Texture2D);
