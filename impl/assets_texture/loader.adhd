[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_texture/asset.adhd.h>

#include <core/assets/manager.h>
#include <core/assets/ref.h>
#include <core/graphics/runtime/runtime.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Owns a texture asset's device-local image and global sampled-image heap entry; release before Graphics teardown.
struct TextureGpuResource final : NoCopy{
    Core::TextureHandle texture;
    Core::GpuDescriptorHandle sampledImageHeapHandle = Core::GpuDescriptorHandle::Invalid();
    // Authoritative completion of the static upload, imported by later graph consumers.
    Core::QueueSubmissionToken readinessToken;
    Core::Format::Enum format = Core::Format::UNKNOWN;


public:
    [[nodiscard]] b8 valid()const noexcept{
        return texture != nullptr && sampledImageHeapHandle.valid() && format != Core::Format::UNKNOWN;
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace TextureAssetLoader{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Creates, uploads, and registers a static 2D, cube, or 3D texture asset.
// LDR UASTC uses ASTC 4x4 when available, then BC7, otherwise portable RGBA8.
// Opaque HDR UASTC uses ASTC HDR 4x4, then BC6H, then RGBA16_FLOAT.
// HDR with flat/companion alpha decodes into RGBA16_FLOAT; one descriptor owns the full RGBA result.
[[nodiscard]] b8 Create(const Texture& textureAsset, const Name& debugName, TStringView ownerName, Core::GraphicsRuntime& graphics, TextureGpuResource& outResource);

// Loads a cooked Texture asset through the normal asset manager, then delegates to Create().
[[nodiscard]] b8 Load(const Core::Assets::AssetRef<Texture>& textureAsset, const Name& debugName, TStringView ownerName, Core::GraphicsRuntime& graphics, Core::Assets::AssetManager& assetManager, TextureGpuResource& outResource);

// Frees the global descriptor first, then releases the owner's TextureHandle. Safe to call on an empty resource.
void Release(Core::GraphicsRuntime& graphics, TextureGpuResource& inOutResource);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


usize ComputeUastcBlockByteOffset(in u32 blockX, in u32 blockY, in u32 blockCountX){
    const u64 blockIndex = cast<u64>(blockY) * cast<u64>(blockCountX) + cast<u64>(blockX);
    return cast<usize>(blockIndex * s_TextureUastcBytesPerBlock);
}

usize ComputeDecodedUastcDestinationTexelIndex(
    in u64 destinationX,
    in u64 destinationY,
    in u32 mipWidth
){
    return cast<usize>(destinationY * cast<u64>(mipWidth) + destinationX);
}

f32 NormalizeTextureAlphaUnorm8(in u8 alphaUnorm8){
    return cast<f32>(alphaUnorm8) / cast<f32>(u8.max);
}

u8 ResolveHdrUniformAlphaUnorm8(in b8 isConstantUnorm8, in u8 alphaConstantUnorm8){
    if(isConstantUnorm8)
        return alphaConstantUnorm8;
    return u8.max;
}

Name ResolveTextureUploadDebugName(in Name debugName, in Name virtualPath){
    if(debugName != s_NameNone)
        return debugName;
    return virtualPath;
}

b8 ShouldRetryTextureCreateWithFallback(
    in b8 isLdrPayload,
    in b8 isRgba8Format,
    in b8 isHdrPayload,
    in b8 isOpaqueAlpha
){
    return (isLdrPayload && !isRgba8Format) || (isHdrPayload && isOpaqueAlpha);
}

usize ComputeTextureUploadRegionReserveCount(
    in Span<TextureMipLevel> mipLevels,
    in b8 isVolumeTexture
){
    if(isVolumeTexture)
        return mipLevels.size();
    usize totalRegions = 0u;
    for(in TextureMipLevel mip : mipLevels)
        totalRegions += cast<usize>(mip.sliceCount);
    return totalRegions;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_texture/texture_mip_decoder.adhd.h>
#include <impl/assets_texture/asset.adhd.h>
#include <core/graphics/api.h>
#include <core/graphics/backend_selection.h>
#include <core/common/log.h>
#include <core/graphics/rhi/gpu_descriptor_heap.h>
#include <global/span.h>
#include <global/sync.h>
#include <basisu_transcoder.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


inline constexpr Core::FormatSupport::Mask s_RequiredTextureFormatSupport = Core::FormatSupport::Texture | Core::FormatSupport::ShaderSample;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TextureFormatSelector final{
private:
    [[nodiscard]] static b8 SupportsTextureFormat(const Core::Format::Enum format, Core::Device& device)noexcept{
        return (device.queryFormatSupport(format) & s_RequiredTextureFormatSupport) == s_RequiredTextureFormatSupport;
    }


public:
    [[nodiscard]] static Core::Format::Enum SelectUploadFormat(const Texture& textureAsset, Core::Device& device)noexcept{
        if(textureAsset.payloadFormat() == TexturePayloadFormat::UastcHdr4x4){
            if(textureAsset.alphaMode() == TextureAlphaMode::Opaque){
                if(SupportsTextureFormat(Core::Format::ASTC_4x4_FLOAT, device))
                    return Core::Format::ASTC_4x4_FLOAT;
                if(SupportsTextureFormat(Core::Format::BC6H_UFLOAT, device))
                    return Core::Format::BC6H_UFLOAT;
            }
            return SupportsTextureFormat(Core::Format::RGBA16_FLOAT, device) ? Core::Format::RGBA16_FLOAT : Core::Format::UNKNOWN;
        }
        if(textureAsset.payloadFormat() != TexturePayloadFormat::UastcLdr4x4)
            return Core::Format::UNKNOWN;

        if(SupportsTextureFormat(Core::Format::ASTC_4x4_UNORM, device))
            return Core::Format::ASTC_4x4_UNORM;

        if(SupportsTextureFormat(Core::Format::BC7_UNORM, device))
            return Core::Format::BC7_UNORM;

        return SupportsTextureFormat(Core::Format::RGBA8_UNORM, device) ? Core::Format::RGBA8_UNORM : Core::Format::UNKNOWN;
    }

    [[nodiscard]] static Core::Format::Enum SelectHdrOpaqueUploadFallback(const Core::Format::Enum failedFormat, Core::Device& device)noexcept{
        if(failedFormat == Core::Format::ASTC_4x4_FLOAT && SupportsTextureFormat(Core::Format::BC6H_UFLOAT, device))
            return Core::Format::BC6H_UFLOAT;
        if(failedFormat != Core::Format::RGBA16_FLOAT && SupportsTextureFormat(Core::Format::RGBA16_FLOAT, device))
            return Core::Format::RGBA16_FLOAT;
        return Core::Format::UNKNOWN;
    }

    [[nodiscard]] static Core::Format::Enum SelectLdrUploadFallback(const Core::Format::Enum failedFormat, Core::Device& device)noexcept{
        if(failedFormat == Core::Format::ASTC_4x4_UNORM && SupportsTextureFormat(Core::Format::BC7_UNORM, device))
            return Core::Format::BC7_UNORM;
        if(failedFormat != Core::Format::RGBA8_UNORM && SupportsTextureFormat(Core::Format::RGBA8_UNORM, device))
            return Core::Format::RGBA8_UNORM;
        return Core::Format::UNKNOWN;
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_texture_mip_decoder{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using TextureFormat::s_UastcBlockHeight;
using TextureFormat::s_UastcBlockWidth;
using TextureFormat::s_UastcBytesPerBlock;
static_assert(sizeof(basist::half_float) == sizeof(u16), "Basis HDR output must use 16-bit half components");
static_assert(s_TextureRgba16FloatBytesPerTexel == static_cast<u32>(sizeof(basist::half_float) * s_TextureRgba16FloatComponentCount));
static_assert(s_TextureRgba16FloatAlphaByteOffset == static_cast<u32>(sizeof(basist::half_float) * (s_TextureRgba16FloatComponentCount - 1u)));


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] static b8 DecodeTextureSliceAsAstc(const Texture& textureAsset, const TextureMipLevel& mip, const u32 sliceIndex, const Span<u8> outUploadBytes){
    const auto source = TryGetPrimaryUastcSlice(textureAsset.payloadBytes(), textureAsset.primaryPayloadByteCount(), mip, sliceIndex);
    if(!source || source->bytes.size() != outUploadBytes.size()){
        NWB_LOGGER_ERROR(NWB_TEXT("TextureAssetLoader: ASTC UASTC slice size is invalid"));
        return false;
    }

    for(u64 blockOffset = 0u; blockOffset < source->bytes.size(); blockOffset += s_UastcBytesPerBlock){
        basist::uastc_block sourceBlock;
        NWB_MEMCPY(&sourceBlock, sizeof(sourceBlock), source->bytes.data() + static_cast<usize>(blockOffset), sizeof(sourceBlock));
        if(!basist::transcode_uastc_to_astc(sourceBlock, outUploadBytes.data() + static_cast<usize>(blockOffset))){
            NWB_LOGGER_ERROR(NWB_TEXT("TextureAssetLoader: UASTC-to-ASTC transcoding failed"));
            return false;
        }
    }
    return true;
}

[[nodiscard]] static b8 DecodeTextureSliceAsBc7(const Texture& textureAsset, const TextureMipLevel& mip, const u32 mipLevel, const u32 sliceIndex, const Span<u8> outUploadBytes){
    const auto source = TryGetPrimaryUastcSlice(textureAsset.payloadBytes(), textureAsset.primaryPayloadByteCount(), mip, sliceIndex);
    if(!source){
        NWB_LOGGER_ERROR(NWB_TEXT("TextureAssetLoader: BC7 UASTC slice size is invalid"));
        return false;
    }
    if(!ValidateBc7UastcTranscodeLayout(*source, outUploadBytes.size()))
        return false;

    basist::basisu_lowlevel_uastc_ldr_4x4_transcoder transcoder;
    if(!transcoder.transcode_image(
        basist::transcoder_texture_format::cTFBC7_RGBA,
        outUploadBytes.data(),
        static_cast<u32>(source->blockCount),
        source->bytes.data(),
        static_cast<u32>(source->bytes.size()),
        mip.blockCountX,
        mip.blockCountY,
        mip.width,
        mip.height,
        mipLevel,
        0u,
        static_cast<u32>(source->bytes.size()),
        0u,
        true,
        false,
        mip.blockCountX,
        nullptr,
        mip.height
    )){
        NWB_LOGGER_ERROR(NWB_TEXT("TextureAssetLoader: UASTC-to-BC7 transcoding failed"));
        return false;
    }
    return true;
}

template<typename StoreTexelT>
[[nodiscard]] static b8 VisitDecodedUastcTexels(const TextureMipLevel& mip, const BinaryByteView sourceBytes, StoreTexelT&& storeTexel){
    for(u32 blockY = 0u; blockY < mip.blockCountY; ++blockY){
        for(u32 blockX = 0u; blockX < mip.blockCountX; ++blockX){
            const usize blockOffset = ComputeUastcBlockByteOffset(blockX, blockY, mip.blockCountX);
            basist::uastc_block sourceBlock;
            NWB_MEMCPY(&sourceBlock, sizeof(sourceBlock), sourceBytes.data() + blockOffset, sizeof(sourceBlock));

            Array<basist::color32, s_UastcBlockWidth * s_UastcBlockHeight> decodedTexels{};
            if(!basist::unpack_uastc(sourceBlock, decodedTexels.data(), false))
                return false;

            for(u32 localY = 0u; localY < s_UastcBlockHeight; ++localY){
                const u64 destinationY = static_cast<u64>(blockY) * s_UastcBlockHeight + localY;
                if(destinationY >= mip.height)
                    break;

                for(u32 localX = 0u; localX < s_UastcBlockWidth; ++localX){
                    const u64 destinationX = static_cast<u64>(blockX) * s_UastcBlockWidth + localX;
                    if(destinationX >= mip.width)
                        break;

                    const usize sourceTexelIndex = static_cast<usize>(localY * s_UastcBlockWidth + localX);
                    const usize destinationTexelIndex = ComputeDecodedUastcDestinationTexelIndex(destinationX, destinationY, mip.width);
                    storeTexel(decodedTexels[sourceTexelIndex], destinationTexelIndex);
                }
            }
        }
    }
    return true;
}

[[nodiscard]] static b8 DecodeTextureSliceAsRgba(const Texture& textureAsset, const TextureMipLevel& mip, const u32 sliceIndex, const Span<u8> outUploadBytes){
    const auto expectedUploadByteCount = TryComputeRgba8FallbackMipBytes(mip.width, mip.height);
    if(!expectedUploadByteCount)
        return false;
    const auto source = *expectedUploadByteCount == outUploadBytes.size()
        ? TryGetPrimaryUastcSlice(textureAsset.payloadBytes(), textureAsset.primaryPayloadByteCount(), mip, sliceIndex)
        : Expected<PrimaryUastcSlice>{ MakeUnexpected(Failure{}) };
    if(*expectedUploadByteCount != outUploadBytes.size() || !source){
        NWB_LOGGER_ERROR(NWB_TEXT("TextureAssetLoader: invalid RGBA8 UASTC slice layout"));
        return false;
    }
    NWB_ASSERT(source->bytes.size() == source->blockCount * s_UastcBytesPerBlock);

    if(!VisitDecodedUastcTexels(mip, BinaryByteView{ source->bytes.data(), source->bytes.size() }, [outUploadBytes](const basist::color32& sourceTexel, const usize destinationTexelIndex)noexcept{
        const usize destinationByteOffset = destinationTexelIndex * s_TextureRgbaBytesPerTexel;
        outUploadBytes[destinationByteOffset + 0u] = sourceTexel.r;
        outUploadBytes[destinationByteOffset + 1u] = sourceTexel.g;
        outUploadBytes[destinationByteOffset + 2u] = sourceTexel.b;
        outUploadBytes[destinationByteOffset + 3u] = sourceTexel.a;
    }
    )){
        NWB_LOGGER_ERROR(NWB_TEXT("TextureAssetLoader: UASTC-to-RGBA8 decoding failed"));
        return false;
    }
    return true;
}

[[nodiscard]] static b8 DecodeHdrTextureSlice(const Texture& textureAsset, const TextureMipLevel& mip, const u32 mipLevel, const u32 sliceIndex, const Core::Format::Enum format, const Span<u8> outUploadBytes){
    const auto source = TryGetPrimaryUastcSlice(textureAsset.payloadBytes(), textureAsset.primaryPayloadByteCount(), mip, sliceIndex);
    if(!source)
        return false;

    basist::transcoder_texture_format targetFormat = basist::transcoder_texture_format::cTFRGBA_HALF;
    b8 compressedOutput = false;
    switch(format){
    case Core::Format::ASTC_4x4_FLOAT:
        targetFormat = basist::transcoder_texture_format::cTFASTC_HDR_4x4_RGBA;
        compressedOutput = true;
        break;
    case Core::Format::BC6H_UFLOAT:
        targetFormat = basist::transcoder_texture_format::cTFBC6H;
        compressedOutput = true;
        break;
    case Core::Format::RGBA16_FLOAT:
        break;
    default:
        NWB_LOGGER_ERROR(NWB_TEXT("TextureAssetLoader: unsupported HDR UASTC upload format"));
        return false;
    }

    u32 outputElementCount = 0u;
    u32 outputRowBlocksOrPixels = 0u;
    if(!ValidateHdrUastcTranscodeLayout(mip, *source, compressedOutput, outUploadBytes.size(), outputElementCount, outputRowBlocksOrPixels))
        return false;

    basist::basisu_lowlevel_uastc_hdr_4x4_transcoder transcoder;
    if(!transcoder.transcode_image(
        targetFormat,
        outUploadBytes.data(),
        outputElementCount,
        source->bytes.data(),
        static_cast<u32>(source->bytes.size()),
        mip.blockCountX,
        mip.blockCountY,
        mip.width,
        mip.height,
        mipLevel,
        0u,
        static_cast<u32>(source->bytes.size()),
        0u,
        false,
        false,
        outputRowBlocksOrPixels,
        nullptr,
        mip.height
    )){
        NWB_LOGGER_ERROR(NWB_TEXT("TextureAssetLoader: HDR UASTC transcoding failed"));
        return false;
    }
    return true;
}

static void StoreHdrAlpha(const usize texelIndex, const u8 alphaUnorm8, const Span<u8> outRgba16FloatBytes)noexcept{
    const basist::half_float alphaHalf = basist::float_to_half(NormalizeTextureAlphaUnorm8(alphaUnorm8));
    u8* const destination = outRgba16FloatBytes.data() + texelIndex * s_TextureRgba16FloatBytesPerTexel + s_TextureRgba16FloatAlphaByteOffset;
    NWB_MEMCPY(destination, sizeof(alphaHalf), &alphaHalf, sizeof(alphaHalf));
}

[[nodiscard]] static b8 MergeHdrAlpha(const Texture& textureAsset, const TextureMipLevel& mip, const u32 sliceIndex, const Span<u8> outRgba16FloatBytes){
    usize texelCount = 0u;
    if(!ValidateHdrRgba16FloatAlphaMergeLayout(mip, outRgba16FloatBytes.size(), texelCount))
        return false;

    if(textureAsset.alphaMode() != TextureAlphaMode::SeparateUastcLdr4x4){
        const u8 alphaUnorm8 = ResolveHdrUniformAlphaUnorm8(
            textureAsset.alphaMode() == TextureAlphaMode::ConstantUnorm8,
            textureAsset.alphaConstantUnorm8()
        );
        for(usize texelIndex = 0u; texelIndex < texelCount; ++texelIndex)
            StoreHdrAlpha(texelIndex, alphaUnorm8, outRgba16FloatBytes);
        return true;
    }

    const auto alphaSource = TryGetSeparateAlphaUastcSlice(
        textureAsset.payloadBytes(),
        textureAsset.primaryPayloadByteCount(),
        textureAsset.alphaMode() == TextureAlphaMode::SeparateUastcLdr4x4 && textureAsset.alphaUastcBlocks() != nullptr,
        mip,
        sliceIndex
    );
    if(!alphaSource)
        return false;
    NWB_ASSERT(alphaSource->size() == static_cast<u64>(mip.blockCountX) * mip.blockCountY * s_UastcBytesPerBlock);

    if(!VisitDecodedUastcTexels(mip, BinaryByteView{ alphaSource->data(), alphaSource->size() }, [outRgba16FloatBytes](const basist::color32& sourceTexel, const usize destinationTexelIndex)noexcept{
        // The companion stream is a grayscale LDR mask: (a, a, a, 255).
        StoreHdrAlpha(destinationTexelIndex, sourceTexel.r, outRgba16FloatBytes);
    }
    )){
        NWB_LOGGER_ERROR(NWB_TEXT("TextureAssetLoader: UASTC alpha decoding failed"));
        return false;
    }
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<TextureDecodedMipUpload> TextureMipDecoder::decode(const Texture& textureAsset, const TextureMipLevel& mip, const u32 mipLevel, const Core::Format::Enum format, Core::Alloc::ScratchArena& arena){
    if(textureAsset.payloadFormat() == TexturePayloadFormat::UastcLdr4x4)
        return decodeLdr(textureAsset, mip, mipLevel, format, arena);
    if(textureAsset.payloadFormat() == TexturePayloadFormat::UastcHdr4x4)
        return decodeHdr(textureAsset, mip, mipLevel, format, arena);

    NWB_LOGGER_ERROR(NWB_TEXT("TextureAssetLoader: unsupported texture payload format"));
    return MakeUnexpected(Failure{});
}


Expected<TextureDecodedMipUpload> TextureMipDecoder::decodeLdr(const Texture& textureAsset, const TextureMipLevel& mip, const u32 mipLevel, const Core::Format::Enum format, Core::Alloc::ScratchArena& arena){
    if(format != Core::Format::ASTC_4x4_UNORM && format != Core::Format::BC7_UNORM && format != Core::Format::RGBA8_UNORM){
        NWB_LOGGER_ERROR(NWB_TEXT("TextureAssetLoader: unsupported linear LDR texture upload format"));
        return MakeUnexpected(Failure{});
    }

    usize rowPitch = 0u;
    usize sliceUploadByteCount = 0u;
    usize totalUploadByteCount = 0u;
    if(!ValidateAndComputeLdrMipUploadLayout(mip, format == Core::Format::RGBA8_UNORM, rowPitch, sliceUploadByteCount, totalUploadByteCount))
        return MakeUnexpected(Failure{});
    TextureDecodedMipUpload upload(arena);
    upload.bytes.resize(totalUploadByteCount);
    for(u32 sliceIndex = 0u; sliceIndex < mip.sliceCount; ++sliceIndex){
        const Span<u8> destination(upload.bytes.data() + static_cast<usize>(sliceIndex) * sliceUploadByteCount, sliceUploadByteCount);
        b8 decoded = false;
        if(format == Core::Format::ASTC_4x4_UNORM)
            decoded = __hidden_texture_mip_decoder::DecodeTextureSliceAsAstc(textureAsset, mip, sliceIndex, destination);
        else if(format == Core::Format::BC7_UNORM)
            decoded = __hidden_texture_mip_decoder::DecodeTextureSliceAsBc7(textureAsset, mip, mipLevel, sliceIndex, destination);
        else
            decoded = __hidden_texture_mip_decoder::DecodeTextureSliceAsRgba(textureAsset, mip, sliceIndex, destination);
        if(!decoded)
            return MakeUnexpected(Failure{});
    }
    upload.rowPitch = rowPitch;
    upload.sliceByteCount = sliceUploadByteCount;
    return upload;
}

Expected<TextureDecodedMipUpload> TextureMipDecoder::decodeHdr(const Texture& textureAsset, const TextureMipLevel& mip, const u32 mipLevel, const Core::Format::Enum format, Core::Alloc::ScratchArena& arena){
    const b8 compressedOutput = Core::Format::IsHdrCompressedFormat(format);
    if(!compressedOutput && format != Core::Format::RGBA16_FLOAT){
        NWB_LOGGER_ERROR(NWB_TEXT("TextureAssetLoader: unsupported HDR texture upload format"));
        return MakeUnexpected(Failure{});
    }

    usize rowPitch = 0u;
    usize sliceUploadByteCount = 0u;
    usize totalUploadByteCount = 0u;
    if(!ValidateAndComputeHdrMipUploadLayout(mip, compressedOutput, rowPitch, sliceUploadByteCount, totalUploadByteCount))
        return MakeUnexpected(Failure{});

    TextureDecodedMipUpload upload(arena);
    upload.bytes.resize(totalUploadByteCount);
    for(u32 sliceIndex = 0u; sliceIndex < mip.sliceCount; ++sliceIndex){
        const Span<u8> destination(upload.bytes.data() + static_cast<usize>(sliceIndex) * sliceUploadByteCount, sliceUploadByteCount);
        if(!__hidden_texture_mip_decoder::DecodeHdrTextureSlice(textureAsset, mip, mipLevel, sliceIndex, format, destination))
            return MakeUnexpected(Failure{});
        if(format == Core::Format::RGBA16_FLOAT && !__hidden_texture_mip_decoder::MergeHdrAlpha(textureAsset, mip, sliceIndex, destination))
            return MakeUnexpected(Failure{});
    }
    upload.rowPitch = rowPitch;
    upload.sliceByteCount = sliceUploadByteCount;
    return upload;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_texture_loader{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static Futex s_BasisTranscoderInitializationMutex;
static Atomic<b8> s_BasisTranscoderInitialized = false;

struct CreatedTexture{
    Core::TextureHandle texture;
    Core::Format::Enum format;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static void InitializeBasisTranscoder(){
    if(s_BasisTranscoderInitialized.load(MemoryOrder::acquire))
        return;

    ScopedLock lock(s_BasisTranscoderInitializationMutex);
    if(s_BasisTranscoderInitialized.load(MemoryOrder::acquire))
        return;

    basist::basisu_transcoder_init();
    s_BasisTranscoderInitialized.store(true, MemoryOrder::release);
}

[[nodiscard]] static Expected<CreatedTexture> CreateTextureWithFormatFallback(
    const Core::TextureDesc& textureDesc,
    const Core::Format::Enum failedFormat,
    Core::Format::Enum (&selectFallback)(Core::Format::Enum, Core::Device&)noexcept,
    Core::GraphicsRuntime& graphics,
    Core::Device& device
){
    Core::TextureDesc fallbackDesc = textureDesc;
    Core::Format::Enum format = failedFormat;
    Expected<Core::TextureHandle> texture = MakeUnexpected(Failure{});
    for(;;){
        const Core::Format::Enum fallbackFormat = selectFallback(format, device);
        if(fallbackFormat == Core::Format::UNKNOWN)
            break;
        fallbackDesc.setFormat(fallbackFormat);
        format = fallbackFormat;
        texture = graphics.createTexture(fallbackDesc);
        if(texture)
            return CreatedTexture{ Move(*texture), format };
    }
    return MakeUnexpected(texture.error());
}

[[nodiscard]] static Core::TextureDimension::Enum ToCoreTextureDimension(const TextureDimension::Enum dimension)noexcept{
    switch(dimension){
    case TextureDimension::Texture2D: return Core::TextureDimension::Texture2D;
    case TextureDimension::TextureCube: return Core::TextureDimension::TextureCube;
    case TextureDimension::Texture3D: return Core::TextureDimension::Texture3D;
    default: return Core::TextureDimension::Unknown;
    }
}

[[nodiscard]] static Core::GpuDescriptorClass::Enum ToSampledImageDescriptorClass(const TextureDimension::Enum dimension)noexcept{
    switch(dimension){
    case TextureDimension::Texture2D: return Core::GpuDescriptorClass::SampledImage;
    case TextureDimension::TextureCube: return Core::GpuDescriptorClass::SampledImageCube;
    case TextureDimension::Texture3D: return Core::GpuDescriptorClass::SampledImage3D;
    default: return Core::GpuDescriptorClass::Count;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 TextureAssetLoader::Create(const Texture& textureAsset, const Name& debugName, const TStringView ownerName, Core::GraphicsRuntime& graphics, TextureGpuResource& outResource){
    NWB_ASSERT(!outResource.valid());
    if(outResource.texture || outResource.sampledImageHeapHandle.valid() || outResource.format != Core::Format::UNKNOWN){
        NWB_LOGGER_ERROR(NWB_TEXT("{}: texture resource is partially initialized; release it before recreating"), ownerName);
        return false;
    }
    // Texture::loadBinary already validated the cooked payload; keep a debug-only invariant here.
    NWB_ASSERT(textureAsset.validatePayload());

    Core::Device& device = graphics.getDevice();
    Core::GpuDescriptorHeap& heap = device.getDescriptorHeap();
    if(!heap.isInitialized()){
        NWB_LOGGER_ERROR(NWB_TEXT("{}: cannot load texture '{}' without an initialized descriptor heap"), ownerName, ConvertString(textureAsset.virtualPath().resolvedText()));
        return false;
    }

    Core::Format::Enum format = TextureFormatSelector::SelectUploadFormat(textureAsset, device);
    if(format == Core::Format::UNKNOWN){
        NWB_LOGGER_ERROR(NWB_TEXT("{}: device cannot sample the required texture format for '{}'"), ownerName, ConvertString(textureAsset.virtualPath().resolvedText()));
        return false;
    }

    const Name imageName = ResolveTextureUploadDebugName(debugName, textureAsset.virtualPath());
    const Core::TextureDimension::Enum textureDimension = __hidden_texture_loader::ToCoreTextureDimension(textureAsset.dimension());
    const Core::GpuDescriptorClass::Enum descriptorClass = __hidden_texture_loader::ToSampledImageDescriptorClass(textureAsset.dimension());
    // Texture::loadBinary already validated the cooked dimension; keep a debug-only invariant here.
    NWB_ASSERT(textureDimension != Core::TextureDimension::Unknown && descriptorClass != Core::GpuDescriptorClass::Count);

    Core::TextureDesc textureDesc;
    textureDesc
        .setWidth(textureAsset.width())
        .setHeight(textureAsset.height())
        .setMipLevels(static_cast<u32>(textureAsset.mipLevels().size()))
        .setFormat(format)
        .setDimension(textureDimension)
        .setInitialState(Core::ResourceStates::ShaderResource)
        .setKeepInitialState(true)
        // Declare Transfer, Compute, and Graphics transports so graph-owned uploads can route static textures across all three queues.
        .setQueueSharing(Core::ResourceQueueSharing::GraphicsAsyncComputeAndTransfer).setName(imageName)
    ;
    if(textureAsset.dimension() == TextureDimension::TextureCube)
        textureDesc.setArraySize(TextureFormat::s_TextureCubeFaceCount);
    else if(textureAsset.dimension() == TextureDimension::Texture3D)
        textureDesc.setDepth(textureAsset.depth());

    auto textureResult = graphics.createTexture(textureDesc);
    if(
        !textureResult
        && ShouldRetryTextureCreateWithFallback(
            textureAsset.payloadFormat() == TexturePayloadFormat::UastcLdr4x4,
            format == Core::Format::RGBA8_UNORM,
            textureAsset.payloadFormat() == TexturePayloadFormat::UastcHdr4x4,
            textureAsset.alphaMode() == TextureAlphaMode::Opaque
        )
    ){
        auto fallbackResult = __hidden_texture_loader::CreateTextureWithFormatFallback(
            textureDesc,
            format,
            textureAsset.payloadFormat() == TexturePayloadFormat::UastcLdr4x4 ? TextureFormatSelector::SelectLdrUploadFallback : TextureFormatSelector::SelectHdrOpaqueUploadFallback,
            graphics,
            device
        );
        if(fallbackResult){
            format = fallbackResult->format;
            textureResult = Move(fallbackResult->texture);
        }
        else
            textureResult = MakeUnexpected(fallbackResult.error());
    }
    if(!textureResult){
        NWB_LOGGER_ERROR(NWB_TEXT("{}: failed to create texture '{}'"), ownerName, ConvertString(imageName.resolvedText()));
        return false;
    }
    Core::TextureHandle texture = Move(*textureResult);

    __hidden_texture_loader::InitializeBasisTranscoder();

    Core::Alloc::ScratchArena scratchArena(s_TextureUploadScratchArena);
    TextureMipDecoder mipDecoder;
    Vector<TextureDecodedMipUpload, Core::Alloc::ScratchArena> decodedMips{scratchArena};
    decodedMips.reserve(textureAsset.mipLevels().size());
    for(usize mipIndex = 0u; mipIndex < textureAsset.mipLevels().size(); ++mipIndex){
        auto decoded = mipDecoder.decode(textureAsset, textureAsset.mipLevels()[mipIndex], static_cast<u32>(mipIndex), format, scratchArena);
        if(!decoded)
            return false;
        decodedMips.push_back(Move(*decoded));
    }

    Vector<Core::GraphicsStandaloneService::TextureUploadRegion, Core::Alloc::ScratchArena> uploadRegions{scratchArena};
    const b8 isVolumeTexture = textureAsset.dimension() == TextureDimension::Texture3D;
    uploadRegions.reserve(ComputeTextureUploadRegionReserveCount(textureAsset.mipLevels(), isVolumeTexture));
    for(usize mipIndex = 0u; mipIndex < textureAsset.mipLevels().size(); ++mipIndex){
        const TextureMipLevel& mip = textureAsset.mipLevels()[mipIndex];
        const TextureDecodedMipUpload& decoded = decodedMips[mipIndex];
        NWB_ASSERT(!decoded.bytes.empty() && decoded.rowPitch != 0u && decoded.sliceByteCount != 0u && mip.sliceCount != 0u);

        if(isVolumeTexture){
            uploadRegions.push_back(Core::GraphicsStandaloneService::TextureUploadRegion{
                .data = decoded.bytes.data(),
                .dataSize = decoded.bytes.size(),
                .rowPitch = decoded.rowPitch,
                .depthPitch = decoded.sliceByteCount,
                .arraySlice = 0u,
                .mipLevel = static_cast<u32>(mipIndex),
            });
            continue;
        }

        for(u32 sliceIndex = 0u; sliceIndex < mip.sliceCount; ++sliceIndex){
            uploadRegions.push_back(Core::GraphicsStandaloneService::TextureUploadRegion{
                .data = decoded.bytes.data() + static_cast<usize>(sliceIndex) * decoded.sliceByteCount,
                .dataSize = decoded.sliceByteCount,
                .rowPitch = decoded.rowPitch,
                .depthPitch = decoded.sliceByteCount,
                .arraySlice = sliceIndex,
                .mipLevel = static_cast<u32>(mipIndex),
            });
        }
    }

    // Resolve descriptor failures before accepting the upload; publish the whole resource before releasing this lease.
    const Expected<Core::GpuDescriptorHandle> sampledImageHandleResult = heap.allocate(descriptorClass);
    if(!sampledImageHandleResult){
        NWB_LOGGER_ERROR(NWB_TEXT("{}: failed to allocate a bindless sampled-image slot for texture '{}'"), ownerName, ConvertString(imageName.resolvedText()));
        return false;
    }
    const Core::GpuDescriptorHandle sampledImageHandle = *sampledImageHandleResult;
    Core::GpuDescriptorRetirementGuard releaseDescriptor(heap, sampledImageHandle);

    if(!heap.write(sampledImageHandle, Core::DescriptorWriteItem::TextureSrv(0u, texture.get(), format, Core::s_AllSubresources, textureDimension))){
        NWB_LOGGER_ERROR(NWB_TEXT("{}: failed to write the bindless sampled-image slot for texture '{}'"), ownerName, ConvertString(imageName.resolvedText()));
        return false;
    }

    Core::QueueSubmissionToken uploadToken;
    if(!graphics.standaloneGraph().uploadTextureBatch(Core::GraphicsStandaloneService::TextureUploadBatchDesc{
        .destination = texture,
        .regions = uploadRegions.data(),
        .regionCount = uploadRegions.size(),
        .acceptedToken = &uploadToken,
        .finalState = Core::ResourceStates::ShaderResource,
        // Descriptor state is the post-upload contract, not the native layout before first write.
        .physicalInitialState = Core::ResourceStates::Unknown,
        .hasPhysicalInitialState = true,
    })){
        NWB_LOGGER_ERROR(NWB_TEXT("{}: failed to submit graph-owned texture upload for '{}'"), ownerName, ConvertString(imageName.resolvedText()));
        return false;
    }

    outResource.texture = Move(texture);
    outResource.sampledImageHeapHandle = sampledImageHandle;
    outResource.format = format;
    outResource.readinessToken = uploadToken;
    releaseDescriptor.release();
    return true;
}

b8 TextureAssetLoader::Load(const Core::Assets::AssetRef<Texture>& textureAsset, const Name& debugName, const TStringView ownerName, Core::GraphicsRuntime& graphics, Core::Assets::AssetManager& assetManager, TextureGpuResource& outResource){
    if(!Core::Assets::AssetManager::CheckLoaderEnter(textureAsset, outResource, ownerName))
        return outResource.valid();

    const Name& textureVirtualPath = textureAsset.name();

    auto loadedAsset = assetManager.loadTypedSync<Texture>(textureVirtualPath, ownerName);
    const Texture* loadedTexture = loadedAsset ? loadedAsset->get() : nullptr;
    if(!loadedTexture)
        return false;

    return Create(*loadedTexture, debugName, ownerName, graphics, outResource);
}

void TextureAssetLoader::Release(Core::GraphicsRuntime& graphics, TextureGpuResource& inOutResource){
    if(inOutResource.sampledImageHeapHandle.valid()){
        Core::GpuDescriptorHeap& heap = graphics.getDevice().getDescriptorHeap();
        if(heap.isInitialized())
            heap.free(inOutResource.sampledImageHeapHandle);
        inOutResource.sampledImageHeapHandle = Core::GpuDescriptorHandle::Invalid();
    }

    inOutResource.texture.reset();
    inOutResource.format = Core::Format::UNKNOWN;
    inOutResource.readinessToken = {};
}


