[cpp_unwind]
Expected<Optional<GpuUploadBlobId>> RendererRayTracingSystem::retainPreparedCsgTraceContextUpload(mut GpuTaskGraph graph, mut u64 outHash, mut usize outByteSize, mut usize outBufferIdentity)const{
    outHash = 0u;
    outByteSize = 0u;
    outBufferIdentity = 0u;
    if(!this.m_shadowVisibilityTraceResourcesPreflighted || !this.m_lightSpaceShadow.m_csg.snapshot.hasCsg)
        return Optional<GpuUploadBlobId>();
    in Vector<u8> bytes = this.m_lightSpaceShadow.m_csg.bytes;
    if(bytes.empty() || !this.m_rayTracingState.sceneBvh.m_csgTraceContextBuffer.valid() || !this.m_rayTracingState.sceneBvh.m_csgTraceContextHeapHandle.valid())
        return MakeUnexpected(Failure());

    const usize bufferIdentity = this.m_rayTracingState.sceneBvh.m_csgTraceContextBuffer.identity();
    const usize byteSize = bytes.size();
    const u64 hash = UpdateFnv64(s_Fnv64OffsetBasis, Span<u8>(bytes));
    in RtSceneBvhState sceneBvh = this.m_rayTracingState.sceneBvh;
    if(
        bufferIdentity != 0u
        && sceneBvh.m_acceptedCsgTraceContextValid
        && sceneBvh.m_acceptedCsgTraceContextBufferIdentity == bufferIdentity
        && sceneBvh.m_acceptedCsgTraceContextByteSize == byteSize
        && sceneBvh.m_acceptedCsgTraceContextHash == hash
    )
        return Optional<GpuUploadBlobId>();

    const auto blobResult = graph.copyUploadBytes<u32>(Span<u8>(bytes));
    if(!blobResult.has_value())
        return MakeUnexpected(Failure());
    outHash = hash;
    outByteSize = byteSize;
    outBufferIdentity = bufferIdentity;
    return Optional<GpuUploadBlobId>(blobResult.value());
}

void RendererRayTracingSystem::confirmPreparedCsgTraceContextUpload(in u64 hash, in usize byteSize, in usize bufferIdentity){
    if(
        bufferIdentity == 0u
        || byteSize == 0u
        || !this.m_rayTracingState.sceneBvh.m_csgTraceContextBuffer.valid()
        || this.m_rayTracingState.sceneBvh.m_csgTraceContextBuffer.identity() != bufferIdentity
    )
        return;
    this.m_rayTracingState.sceneBvh.m_acceptedCsgTraceContextHash = hash;
    this.m_rayTracingState.sceneBvh.m_acceptedCsgTraceContextByteSize = byteSize;
    this.m_rayTracingState.sceneBvh.m_acceptedCsgTraceContextBufferIdentity = bufferIdentity;
    this.m_rayTracingState.sceneBvh.m_acceptedCsgTraceContextValid = true;
}

[cpp_unwind]
b8 RendererRayTracingSystem::prepareCausticOpticalReadTracking(in MeshViewBufferSnapshot meshView){
    b8 admitted = false;
    if(this.m_shadowVisibilityHardwareSupported)
        admitted = this.hasHwCausticWork(meshView);
    else
        admitted = this.hasCausticWork(meshView);
    if(!this.ensureRayTraceContextReadTracking(admitted))
        return false;
    this.m_opticalCausticReaderAdmitted = admitted;
    return true;
}

void RendererRayTracingSystem::confirmRayTraceContextReadSubmission(in QueueSubmissionToken token){
    if(!token.valid() || (!this.m_lightSpaceShadow.m_csg.snapshot.hasCsg && !this.m_opticalCausticReaderAdmitted))
        return;
    mut Vector<QueueSubmissionToken> readTokens = this.m_rayTracingState.shadow.m_rayTraceContextReadSubmissionTokens;
    assert(token.hasPhysicalQueueIdentity() && token.physicalQueueIndex < readTokens.size());
    mut QueueSubmissionToken previous = readTokens[token.physicalQueueIndex];
    if(ShouldAdvanceRayTraceReadToken(previous.valid(), previous.matchesPhysicalQueue(token.physicalQueueIndex, token.deviceGeneration), token.value, previous.value))
        previous = token;
}

[cpp_unwind]
b8 RendererRayTracingSystem::ensureRayTraceContextReadTracking(in b8 opticalCausticReader){
    mut Vector<QueueSubmissionToken> readTokens = this.m_rayTracingState.shadow.m_rayTraceContextReadSubmissionTokens;
    const b8 readerAdmitted = this.m_lightSpaceShadow.m_csg.snapshot.hasCsg || opticalCausticReader;
    if(!readerAdmitted && readTokens.empty())
        return true;

    mut Device device = this.m_graphics.getDevice();
    b8 readersPending = false;
    for(mut QueueSubmissionToken token : readTokens){
        if(!token.valid())
            continue;
        GpuPhysicalQueueId queue;
        queue.index = token.physicalQueueIndex;
        queue.deviceGeneration = token.deviceGeneration;
        const b8 matchesQueueIdentity = device.matchesPhysicalQueueIdentity(token.queue, token.physicalQueueIndex, token.deviceGeneration);
        Expected<u64> completedValue = MakeUnexpected(Failure());
        if(matchesQueueIdentity)
            completedValue = device.queueGetCompletedInstance(queue);
        u64 completed = 0u;
        if(completedValue.has_value())
            completed = completedValue.value();
        if(ClassifyRayTraceReadTokenStatus(matchesQueueIdentity, completedValue.has_value(), completed, token.value) == RayTraceReadTokenStatus::Retired)
            token = QueueSubmissionToken();
        else
            readersPending = true;
    }
    if(!readerAdmitted){
        if(!readersPending)
            readTokens.clear();
        return true;
    }

    const GpuPhysicalQueueTopology topology = device.getPhysicalQueueTopology();
    if(topology.queueSpan().empty())
        return false;
    readTokens.resize(topology.queueCount);
    return true;
}

[cpp_unwind]
b8 RendererRayTracingSystem::ensureCsgTraceContextResources(){
    if(!this.ensureRayTraceContextReadTracking(false))
        return false;
    if(!this.m_lightSpaceShadow.m_csg.snapshot.hasCsg)
        return true;

    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    const usize byteCount = this.m_lightSpaceShadow.m_csg.bytes.size();
    mut BufferHandle buffer = this.m_rayTracingState.sceneBvh.m_csgTraceContextBuffer;
    mut GpuDescriptorHandle handle = this.m_rayTracingState.sceneBvh.m_csgTraceContextHeapHandle;
    u64 capacity = 0u;
    u64 currentBytes = 0u;
    if(buffer.valid())
        currentBytes = buffer.deref().getCreationDescription().byteSize;
    if(!ResolveCsgTraceContextBufferCapacity(
        heap.isInitialized(),
        byteCount,
        device.getMaxStorageBufferRange(),
        buffer.valid(),
        currentBytes,
        capacity
    ))
        return false;
    if(buffer.valid() && buffer.deref().getCreationDescription().byteSize >= byteCount)
        return EnsureHeapBuffer(GpuDescriptorClass::StorageBuffer, false, heap, buffer.deref(), handle);
    BufferDesc desc;
    desc.setByteSize(capacity).setStructStride(size_of<u32>()).setCanHaveRawViews(true).setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute).setDebugName(Name(s_CsgContextDebug)).enableAutomaticStateTracking(ResourceStates::Common);
    auto replacementResult = this.m_graphics.createBuffer(desc);
    if(!replacementResult.has_value())
        return false;
    BufferHandle replacement = replacementResult.value();
    const auto replacementHandle = RegisterHeapBuffer(heap, replacement.deref(), GpuDescriptorClass::StorageBuffer, false);
    if(!replacementHandle.has_value())
        return false;
    GpuDescriptorRetirementGuard retireReplacement(heap, replacementHandle.value());

    RetireDescriptor(heap, handle);
    buffer = replacement;
    handle = replacementHandle.value();
    this.m_rayTracingState.sceneBvh.m_acceptedCsgTraceContextValid = false;
    retireReplacement.release();
    return true;
}


