// Generation-scoped CPU telemetry; fixed-width counts (no host-width leak).
// Wire records: packed fixed-size, codec-native byte order (no cross-endian format).
// Durations are seconds.
class FrameGraphCompileRuntimeStatistics{
    public u64 taskCount = 0u;
    public u64 resourceCount = 0u;
    public u64 resourceVersionCount = 0u;
    public u64 resourceVersionEdgeCount = 0u;
    public u64 resourceUseCount = 0u;
    public u64 explicitDependencyCount = 0u;
    public u64 inferredDependencyCount = 0u;
    public u64 packetCount = 0u;
    public u64 packetDependencyCount = 0u;
    public u64 mergedTaskCount = 0u;
    public u64 transitionBarrierCount = 0u;
    public u64 uavBarrierCount = 0u;
    public u64 ownershipReleaseBarrierCount = 0u;
    public u64 ownershipAcquireBarrierCount = 0u;
    public u64 stateExportBarrierCount = 0u;
    public u64 logicalOwnershipTransferCount = 0u;
    public u64 logicalOwnershipTransferSignatureCount = 0u;
    public u64 repeatedOwnershipTransferSignatureCount = 0u;
    public u64 concurrentSharingCouldAvoidTransferCount = 0u;
    public u64 concurrentSharingAdviceResourceCount = 0u;
    public u64 logicalOwnershipTransferInternalCount = 0u;
    public u64 logicalOwnershipTransferExternalImportCount = 0u;
    public u64 logicalOwnershipTransferExternalExportCount = 0u;
    public u64 resourceSetCount = 0u;
    public u64 resourceSetMemberCount = 0u;
    public u64 directResourceUseCount = 0u;
    public u64 declaredResourceSetUseCount = 0u;
    public u64 expandedResourceSetMemberUseCount = 0u;
    public u64 payloadObjectCount = 0u;
    public u64 payloadObjectBytes = 0u;
    public u64 uploadBlobCount = 0u;
    public u64 uploadBlobBytes = 0u;
    public f64 declarationSeconds = 0.0;
    public f64 analysisSeconds = 0.0;
    public f64 validationSeconds = 0.0;
    public f64 dependencyAnalysisSeconds = 0.0;
    public f64 hazardAnalysisSeconds = 0.0;
    public f64 topologicalOrderSeconds = 0.0;
    public f64 queueAssignmentSeconds = 0.0;
    public f64 planningSeconds = 0.0;
    public f64 packetizationSeconds = 0.0;
    public f64 resourceStatePlanningSeconds = 0.0;
    public f64 packetDependencyPlanningSeconds = 0.0;
    public f64 totalSeconds = 0.0;
}


