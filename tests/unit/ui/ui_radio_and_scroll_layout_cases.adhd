void VerifyUiRadioGroupPopupTests_ChildEndKeepsTheRadioStateLoanThroughTheOutermostPopupEnd(mut UiRadioGroupPopupTests self){
    ASSERT_TRUE(self.acceptFamily(1u));
    const UiRadioAcceptedInput128 displayed = self.accepted();
    ASSERT_TRUE(self.declareFamily(2u));
    const u64 token = self.m_childState.inputGeneration();
    self.m_childState.select(20u);
    EXPECT_FALSE(self.m_builder.endPopup());
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_NE(self.m_childState.inputGeneration(), token);
    EXPECT_EQ(self.m_childState.selectedKey(), 20u);
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    // Discarding a rejected popup candidate may retire displayed popup focus/scopes, but never replaces its layout.
    self.expectAccepted(displayed, false, false);
}

