StringView ResolveReflectionSpatialVariant(in u32 radiusIndex){
    switch(radiusIndex){
    case 0u:
        return s_ReflectionSpatialRadius1Variant;
    case 1u:
        return s_ReflectionSpatialRadius2Variant;
    case 2u:
        return s_ReflectionSpatialRadius3Variant;
    default:
        return s_ReflectionSpatialRadius1Variant;
    }
}


