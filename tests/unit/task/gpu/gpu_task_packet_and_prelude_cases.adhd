void VerifyGpuPacket_ConditionalRecoveryDoesNotCreateOverlapForSerialNormalWork(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuTaskCommandRequirements graphicsCommands = GpuTaskCommandRequirements();
    graphicsCommands.requiredCapabilities = GpuQueueCapability::Graphics;
    GpuTaskSchedulingHint graphicsScheduling = GpuTaskSchedulingHint();
    graphicsScheduling.cost = GpuTaskCostHint::Large;
    const Expected<GpuTaskId> prefixResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphRecoveryOverlapPrefix,
        "Recovery Overlap Prefix",
        graphicsCommands,
        graphicsScheduling,
        GpuTaskTimingMetadata(),
        Span<GpuTaskId>(),
        graph
    );
    ASSERT_TRUE(prefixResult.has_value());
    const GpuTaskId prefix = prefixResult.value();
    ASSERT_TRUE(prefix.valid());

    Array<GpuTaskId, 1> prefixDeps = Array<GpuTaskId, 1>();
    prefixDeps[0u] = prefix;
    const Expected<GpuTaskId> middleResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphRecoveryOverlapMiddle,
        "Recovery Overlap Middle",
        ComputeCommands(),
        GpuTaskSchedulingHint(),
        GpuTaskTimingMetadata(),
        prefixDeps,
        graph
    );
    ASSERT_TRUE(middleResult.has_value());
    const GpuTaskId middle = middleResult.value();
    ASSERT_TRUE(middle.valid());

    Array<GpuTaskId, 1> middleDeps = Array<GpuTaskId, 1>();
    middleDeps[0u] = middle;
    const Expected<GpuTaskId> suffixResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphRecoveryOverlapSuffix,
        "Recovery Overlap Suffix",
        graphicsCommands,
        graphicsScheduling,
        GpuTaskTimingMetadata(),
        middleDeps,
        graph
    );
    ASSERT_TRUE(suffixResult.has_value());
    const GpuTaskId suffix = suffixResult.value();
    ASSERT_TRUE(suffix.valid());

    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    const GpuPhysicalQueueTopology topology = MakeGpuPacketTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments normalAssignments = GpuTaskGraphQueueAssignments(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    ASSERT_TRUE(Assign(normalAssignments, operationScratchArena, graph, analysis, topology));
    native(in normalAssignments, in middle, in queues){
        const Core::GpuTaskQueueAssignment* const normalMiddle = normalAssignments.find(middle);
        ASSERT_NE(normalMiddle, nullptr);
        ASSERT_EQ(normalMiddle->queue, queues[0u].id);
    }

    GpuTaskSchedulingHint recoveryScheduling = GpuTaskSchedulingHint();
    recoveryScheduling.cost = GpuTaskCostHint::Tiny;
    recoveryScheduling.forceSubmissionBoundary = true;
    recoveryScheduling.allowPacketMerge = false;
    recoveryScheduling.joinsAcceptedQueueFrontier = true;
    recoveryScheduling.isRecoverySubmission = true;
    const Expected<GpuTaskId> recoveryResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphRecoveryOverlapFallback,
        "Recovery Overlap Fallback",
        graphicsCommands,
        recoveryScheduling,
        GpuTaskTimingMetadata(),
        Span<GpuTaskId>(),
        graph
    );
    ASSERT_TRUE(recoveryResult.has_value());
    const GpuTaskId recovery = recoveryResult.value();
    ASSERT_TRUE(recovery.valid());
    GpuTaskGraphQueueAssignments recoveryAssignments = GpuTaskGraphQueueAssignments(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    ASSERT_TRUE(Assign(recoveryAssignments, operationScratchArena, graph, analysis, topology));
    Array<GpuTaskId, 3> normalTasks = Array<GpuTaskId, 3>();
    normalTasks[0u] = prefix;
    normalTasks[1u] = middle;
    normalTasks[2u] = suffix;
    for(in GpuTaskId task : normalTasks){
        native(in normalAssignments, in recoveryAssignments, in task){
            const Core::GpuTaskQueueAssignment* const before = normalAssignments.find(task);
            const Core::GpuTaskQueueAssignment* const after = recoveryAssignments.find(task);
            ASSERT_NE(before, nullptr);
            ASSERT_NE(after, nullptr);
            EXPECT_EQ(after->queue, before->queue);
            EXPECT_EQ(after->score.overlap, 0);
        }
    }
    native(in recoveryAssignments, in recovery, in queues){
        const Core::GpuTaskQueueAssignment* const recoveryAssignment = recoveryAssignments.find(recovery);
        ASSERT_NE(recoveryAssignment, nullptr);
        EXPECT_EQ(recoveryAssignment->queue, queues[0u].id);
    }
}

void VerifyGpuPacket_ChoosesAutomaticPlacementDeterministicallyAcrossTopologyOrder(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);

    GpuTaskCommandRequirements graphicsCommands = GpuTaskCommandRequirements();
    graphicsCommands.requiredCapabilities = GpuQueueCapability::Graphics;
    GpuTaskSchedulingHint graphicsScheduling = GpuTaskSchedulingHint();
    graphicsScheduling.cost = GpuTaskCostHint::Large;
    const Expected<GpuTaskId> graphicsTaskResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphDeterministicGraphics,
        "Deterministic Graphics",
        graphicsCommands,
        graphicsScheduling,
        GpuTaskTimingMetadata(),
        Span<GpuTaskId>(),
        graph
    );
    ASSERT_TRUE(graphicsTaskResult.has_value());
    const GpuTaskId graphicsTask = graphicsTaskResult.value();

    GpuTaskCommandRequirements transferCommands = GpuTaskCommandRequirements();
    transferCommands.requiredCapabilities = GpuQueueCapability::Transfer;
    const Expected<GpuTaskId> transferTaskResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphDeterministicTransfer,
        "Deterministic Transfer",
        transferCommands,
        GpuTaskSchedulingHint(),
        GpuTaskTimingMetadata(),
        Span<GpuTaskId>(),
        graph
    );
    ASSERT_TRUE(transferTaskResult.has_value());
    const GpuTaskId transferTask = transferTaskResult.value();
    ASSERT_TRUE(graphicsTask.valid());
    ASSERT_TRUE(transferTask.valid());

    GpuPhysicalQueueInfo auxiliaryGraphics = GraphicsQueue(3u);
    auxiliaryGraphics.queueIndex = 1u;
    Array<GpuPhysicalQueueInfo, 4> firstQueues = Array<GpuPhysicalQueueInfo, 4>();
    firstQueues[0u] = auxiliaryGraphics;
    firstQueues[1u] = DedicatedTransferQueue();
    firstQueues[2u] = DedicatedComputeQueue();
    firstQueues[3u] = GraphicsQueue();
    Array<GpuPhysicalQueueInfo, 4> secondQueues = Array<GpuPhysicalQueueInfo, 4>();
    secondQueues[0u] = GraphicsQueue();
    secondQueues[1u] = DedicatedComputeQueue();
    secondQueues[2u] = auxiliaryGraphics;
    secondQueues[3u] = DedicatedTransferQueue();
    const GpuPhysicalQueueTopology firstTopology = MakeGpuPacketTopology(firstQueues);
    const GpuPhysicalQueueTopology secondTopology = MakeGpuPacketTopology(secondQueues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    GpuTaskGraphQueueAssignments firstAssignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuTaskGraphQueueAssignments secondAssignments = GpuTaskGraphQueueAssignments(testArena.arena);
    ASSERT_TRUE(Assign(firstAssignments, operationScratchArena, graph, analysis, firstTopology));
    ASSERT_TRUE(Assign(secondAssignments, operationScratchArena, graph, analysis, secondTopology));

    native(in firstAssignments, in secondAssignments, in transferTask, in auxiliaryGraphics){
        const Core::GpuTaskQueueAssignment* const firstAssignment = firstAssignments.find(transferTask);
        const Core::GpuTaskQueueAssignment* const secondAssignment = secondAssignments.find(transferTask);
        ASSERT_NE(firstAssignment, nullptr);
        ASSERT_NE(secondAssignment, nullptr);
        EXPECT_EQ(firstAssignment->queue, DedicatedComputeQueue().id);
        EXPECT_EQ(secondAssignment->queue, firstAssignment->queue);
        EXPECT_NE(firstAssignment->queue, auxiliaryGraphics.id);
    }
}

void VerifyGpuPacket_QueueScoreUsesOnlyReducedOutgoingDependencies(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuTaskCommandRequirements computeCommands = GpuTaskCommandRequirements();
    computeCommands.requiredCapabilities = GpuQueueCapability::Compute;
    GpuTaskCommandRequirements graphicsCommands = GpuTaskCommandRequirements();
    graphicsCommands.requiredCapabilities = GpuQueueCapability::Graphics;

    const Expected<GpuTaskId> producerResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphReducedQueueScoreProducer,
        "Reduced Queue Score Producer",
        computeCommands,
        GpuTaskSchedulingHint(),
        GpuTaskTimingMetadata(),
        Span<GpuTaskId>(),
        graph
    );
    ASSERT_TRUE(producerResult.has_value());
    const GpuTaskId producer = producerResult.value();

    Array<GpuTaskId, 1> producerDeps = Array<GpuTaskId, 1>();
    producerDeps[0u] = producer;
    const Expected<GpuTaskId> middleResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphReducedQueueScoreMiddle,
        "Reduced Queue Score Middle",
        graphicsCommands,
        GpuTaskSchedulingHint(),
        GpuTaskTimingMetadata(),
        producerDeps,
        graph
    );
    ASSERT_TRUE(middleResult.has_value());
    const GpuTaskId middle = middleResult.value();

    Array<GpuTaskId, 2> finalDependencies = Array<GpuTaskId, 2>();
    finalDependencies[0u] = producer;
    finalDependencies[1u] = middle;
    const Expected<GpuTaskId> finalTaskResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphReducedQueueScoreFinal,
        "Reduced Queue Score Final",
        graphicsCommands,
        GpuTaskSchedulingHint(),
        GpuTaskTimingMetadata(),
        finalDependencies,
        graph
    );
    ASSERT_TRUE(finalTaskResult.has_value());
    const GpuTaskId finalTask = finalTaskResult.value();
    ASSERT_TRUE(producer.valid());
    ASSERT_TRUE(middle.valid());
    ASSERT_TRUE(finalTask.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    ASSERT_EQ(analysis.edges().size(), 3u);
    ASSERT_EQ(analysis.schedulingEdges().size(), 2u);
    // The graphics queue has no compute support, so the compute producer must run on the dedicated queue.
    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue(0u, QueueCapabilities(GpuQueueCapability::Graphics, GpuQueueCapability::Transfer));
    queues[1u] = DedicatedComputeQueue();
    const GpuPhysicalQueueTopology topology = MakeGpuPacketTopology(queues);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology));
    native(in assignments, in producer){
        const Core::GpuTaskQueueAssignment* const producerAssignment = assignments.find(producer);
        ASSERT_NE(producerAssignment, nullptr);
        EXPECT_EQ(producerAssignment->queueClass, Core::CommandQueue::Compute);
        EXPECT_EQ(producerAssignment->score.outgoingCrossings, 1);
    }
}

void VerifyGpuPacket_DeduplicatesRawOwnershipScoreAndIgnoresSameFamilyQueueCrossings(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuGraphResourceId> textureResult = AddTextureMetadata(graph, s_GpuCaseTaskGraphOwnershipScoreTexture, "Ownership Score Texture");
    ASSERT_TRUE(textureResult.has_value());
    const GpuGraphResourceId texture = textureResult.value();
    ASSERT_TRUE(texture.valid());
    const Expected<GpuGraphResourceId> secondTextureResult = AddTextureMetadata(graph, s_GpuCaseTaskGraphOwnershipScoreSecondTexture, "Ownership Score Second Texture");
    ASSERT_TRUE(secondTextureResult.has_value());
    const GpuGraphResourceId secondTexture = secondTextureResult.value();
    ASSERT_TRUE(secondTexture.valid());

    GpuTaskResourceUse producerUse = GpuTaskResourceUse();
    producerUse.resource = texture;
    producerUse.requiredState = ResourceStates::UnorderedAccess;
    producerUse.access = GpuTaskResourceAccess::Write;
    GpuTaskResourceUse consumerUse = GpuTaskResourceUse();
    consumerUse.resource = texture;
    consumerUse.requiredState = ResourceStates::UnorderedAccess;
    consumerUse.access = GpuTaskResourceAccess::ReadWrite;
    Array<GpuTaskResourceUse, 2> producerUses = Array<GpuTaskResourceUse, 2>();
    producerUses[0u] = producerUse;
    producerUses[1u] = producerUse;
    producerUses[1u].resource = secondTexture;
    Array<GpuTaskResourceUse, 2> consumerUses = Array<GpuTaskResourceUse, 2>();
    consumerUses[0u] = consumerUse;
    consumerUses[1u] = consumerUse;
    consumerUses[1u].resource = secondTexture;
    Array<GpuTaskResourceUse, 2> finalUses = Array<GpuTaskResourceUse, 2>();
    finalUses[0u] = consumerUses[0u];
    finalUses[1u] = consumerUses[1u];
    for(mut GpuTaskResourceUse use : finalUses)
        use.access = GpuTaskResourceAccess::Read;
    const GpuTaskCommandRequirements graphicsCommands = GraphicsCommands();
    const GpuTaskCommandRequirements computeCommands = ComputeCommands();
    GpuTaskDesc producerDesc = GpuTaskDesc();
    producerDesc.setIdentity(s_GpuCaseTaskGraphOwnershipScoreProducer);
    producerDesc.setMarkerLabel("Ownership Score Producer");
    producerDesc.setResourceUses(producerUses);
    const Expected<GpuTaskId> producerTaskResult = graph.addTask(producerDesc, graphicsCommands);
    ASSERT_TRUE(producerTaskResult.has_value());
    const GpuTaskId producer = producerTaskResult.value();
    GpuTaskDesc consumerDesc = GpuTaskDesc();
    consumerDesc.setIdentity(s_GpuCaseTaskGraphOwnershipScoreConsumer);
    consumerDesc.setMarkerLabel("Ownership Score Consumer");
    consumerDesc.setResourceUses(consumerUses);
    const Expected<GpuTaskId> consumerResult = graph.addTask(consumerDesc, computeCommands);
    ASSERT_TRUE(consumerResult.has_value());
    const GpuTaskId consumer = consumerResult.value();
    ASSERT_TRUE(producer.valid());
    ASSERT_TRUE(consumer.valid());
    GpuTaskDesc finalDesc = GpuTaskDesc();
    finalDesc.setIdentity(s_GpuCaseTaskGraphOwnershipScoreFinalConsumer);
    finalDesc.setMarkerLabel("Ownership Score Final Consumer");
    finalDesc.setResourceUses(finalUses);
    const Expected<GpuTaskId> finalConsumerResult = graph.addTask(finalDesc, graphicsCommands);
    ASSERT_TRUE(finalConsumerResult.has_value());
    const GpuTaskId finalConsumer = finalConsumerResult.value();
    ASSERT_TRUE(finalConsumer.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    ASSERT_EQ(analysis.inferredEdges().size(), 6u);
    ASSERT_EQ(analysis.schedulingEdges().size(), 2u);

    // The graphics queue has no compute support, so the compute consumer must run on the dedicated queue.
    const GpuPhysicalQueueInfo graphicsQueue = GraphicsQueue(0u, QueueCapabilities(GpuQueueCapability::Graphics, GpuQueueCapability::Transfer));
    Array<GpuPhysicalQueueInfo, 2> separateFamilyQueues = Array<GpuPhysicalQueueInfo, 2>();
    separateFamilyQueues[0u] = graphicsQueue;
    separateFamilyQueues[1u] = DedicatedComputeQueue();
    const GpuPhysicalQueueTopology separateFamilyTopology = MakeGpuPacketTopology(separateFamilyQueues);
    GpuTaskGraphQueueAssignments separateFamilyAssignments = GpuTaskGraphQueueAssignments(testArena.arena);
    ASSERT_TRUE(Assign(separateFamilyAssignments, operationScratchArena, graph, analysis, separateFamilyTopology));
    native(in separateFamilyAssignments, in producer, in consumer, in finalConsumer){
        const Core::GpuTaskQueueAssignment* const separateFamilyAssignment = separateFamilyAssignments.find(consumer);
        ASSERT_NE(separateFamilyAssignment, nullptr);
        EXPECT_EQ(separateFamilyAssignment->score.incomingCrossings, 1);
        EXPECT_EQ(separateFamilyAssignment->score.outgoingCrossings, 1);
        EXPECT_EQ(separateFamilyAssignment->score.ownershipTransfers, 4);
        const Core::GpuTaskQueueAssignment* const producerAssignment = separateFamilyAssignments.find(producer);
        const Core::GpuTaskQueueAssignment* const finalAssignment = separateFamilyAssignments.find(finalConsumer);
        ASSERT_NE(producerAssignment, nullptr);
        ASSERT_NE(finalAssignment, nullptr);
        EXPECT_EQ(producerAssignment->score.ownershipTransfers, 2);
        EXPECT_EQ(finalAssignment->score.ownershipTransfers, 2);
    }

    GpuPhysicalQueueInfo sameFamilyCompute = DedicatedComputeQueue();
    sameFamilyCompute.familyIndex = graphicsQueue.familyIndex;
    sameFamilyCompute.queueIndex = 1u;
    Array<GpuPhysicalQueueInfo, 2> sameFamilyQueues = Array<GpuPhysicalQueueInfo, 2>();
    sameFamilyQueues[0u] = graphicsQueue;
    sameFamilyQueues[1u] = sameFamilyCompute;
    const GpuPhysicalQueueTopology sameFamilyTopology = MakeGpuPacketTopology(sameFamilyQueues);
    GpuTaskGraphQueueAssignments sameFamilyAssignments = GpuTaskGraphQueueAssignments(testArena.arena);
    ASSERT_TRUE(Assign(sameFamilyAssignments, operationScratchArena, graph, analysis, sameFamilyTopology));
    native(in sameFamilyAssignments, in producer, in consumer, in finalConsumer){
        const Core::GpuTaskQueueAssignment* const sameFamilyAssignment = sameFamilyAssignments.find(consumer);
        ASSERT_NE(sameFamilyAssignment, nullptr);
        EXPECT_EQ(sameFamilyAssignment->score.incomingCrossings, 1);
        EXPECT_EQ(sameFamilyAssignment->score.ownershipTransfers, 0);
        const Core::GpuTaskQueueAssignment* const sameFamilyProducer = sameFamilyAssignments.find(producer);
        const Core::GpuTaskQueueAssignment* const sameFamilyFinal = sameFamilyAssignments.find(finalConsumer);
        ASSERT_NE(sameFamilyProducer, nullptr);
        ASSERT_NE(sameFamilyFinal, nullptr);
        EXPECT_EQ(sameFamilyProducer->score.ownershipTransfers, 0);
        EXPECT_EQ(sameFamilyFinal->score.ownershipTransfers, 0);
    }
}

void VerifyGpuPacket_RejectsInvalidAndIncompatibleQueueTopologiesDeterministically(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuTaskCommandRequirements computeCommands = GpuTaskCommandRequirements();
    computeCommands.requiredCapabilities = GpuQueueCapability::Compute;
    const Expected<GpuTaskId> taskResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphQueueDiagnostic,
        "Queue Diagnostic",
        computeCommands,
        GpuTaskSchedulingHint(),
        GpuTaskTimingMetadata(),
        Span<GpuTaskId>(),
        graph
    );
    ASSERT_TRUE(taskResult.has_value());
    const GpuTaskId task = taskResult.value();
    ASSERT_TRUE(task.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    EXPECT_FALSE(Assign(assignments, operationScratchArena, graph, analysis, GpuPhysicalQueueTopology()));
    EXPECT_EQ(assignments.diagnostic().status, GpuTaskGraphQueueAssignmentStatus::InvalidQueueTopology);

    Array<GpuPhysicalQueueInfo, 1> graphicsOnly = Array<GpuPhysicalQueueInfo, 1>();
    graphicsOnly[0u] = GraphicsQueue(0u, GpuQueueCapability::Graphics);
    const GpuPhysicalQueueTopology graphicsOnlyTopology = MakeGpuPacketTopology(graphicsOnly);
    EXPECT_FALSE(Assign(assignments, operationScratchArena, graph, analysis, graphicsOnlyTopology));
    EXPECT_EQ(assignments.diagnostic().status, GpuTaskGraphQueueAssignmentStatus::NoCompatibleQueue);
    EXPECT_EQ(assignments.diagnostic().task, task);
    EXPECT_EQ(assignments.diagnostic().requiredCapabilities, GpuQueueCapability::Compute);

    Array<GpuPhysicalQueueInfo, 1> invalidTransferQueues = Array<GpuPhysicalQueueInfo, 1>();
    invalidTransferQueues[0u] = DedicatedTransferQueue();
    invalidTransferQueues[0u].capabilities = GpuQueueCapability::Compute;
    const GpuPhysicalQueueTopology invalidTransferTopology = MakeGpuPacketTopology(invalidTransferQueues);
    EXPECT_FALSE(Assign(assignments, operationScratchArena, graph, analysis, invalidTransferTopology));
    EXPECT_EQ(assignments.diagnostic().status, GpuTaskGraphQueueAssignmentStatus::InvalidQueueTopology);

    GpuPhysicalQueueInfo duplicateNativeQueue = GraphicsQueue(3u);
    // Different graph IDs must not alias the same physical queue family/index transport.
    duplicateNativeQueue.queueIndex = GraphicsQueue().queueIndex;
    Array<GpuPhysicalQueueInfo, 2> duplicateNativeQueues = Array<GpuPhysicalQueueInfo, 2>();
    duplicateNativeQueues[0u] = GraphicsQueue();
    duplicateNativeQueues[1u] = duplicateNativeQueue;
    const GpuPhysicalQueueTopology duplicateNativeTopology = MakeGpuPacketTopology(duplicateNativeQueues);
    EXPECT_FALSE(Assign(assignments, operationScratchArena, graph, analysis, duplicateNativeTopology));
    EXPECT_EQ(assignments.diagnostic().status, GpuTaskGraphQueueAssignmentStatus::InvalidQueueTopology);
}


