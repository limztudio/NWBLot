#include <impl/ecs_render/mesh/mesh_view_state_policy.adhd.h>

#include <gtest/gtest.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_mesh_view_state_policy_tests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace NWB;
using namespace NWB::Impl;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


TEST(MeshViewStatePolicyTests, MissingTruncatedAndChangedSnapshotsRequireUpload){
    const MeshViewStatePolicy policy;
    MeshViewGpuData view;
    Array<u8, s_MeshViewGpuDataBytes> bytes{};
    b8 valid = false;
    const Span<const u8> full(bytes.data(), bytes.size());
    const Span<const u8> truncated(bytes.data(), bytes.size() - 1u);

    EXPECT_FALSE(policy.readAccepted(valid, full));
    EXPECT_TRUE(policy.uploadRequired(valid, full, view));
    policy.storeConfirmed(view, bytes, valid);
    ASSERT_TRUE(valid);
    ASSERT_TRUE(policy.readAccepted(valid, full));
    EXPECT_FALSE(policy.uploadRequired(valid, full, view));
    EXPECT_FALSE(policy.readAccepted(valid, truncated));
    EXPECT_TRUE(policy.uploadRequired(valid, truncated, view));
    bytes[0] ^= 1u;
    EXPECT_TRUE(policy.uploadRequired(valid, full, view));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


