void VerifyUiSearchComboBuilderTests_TabMovesFromQueryToResultsThenExitsWithoutCommittingPreview(mut UiSearchComboBuilderTests self){
    self.m_search.combo().select(1u);
    ASSERT_TRUE(self.acceptSearch(1u));
    ASSERT_TRUE(self.openSearch(2u));
    self.press(UiSearchComboKey::Down);
    ASSERT_TRUE(self.acceptSearch(3u));
    ASSERT_EQ(self.m_search.combo().listState().cursorKey(), 2u);
    ASSERT_EQ(self.m_context.input().focus(), self.query());
    self.press(UiSearchComboKey::Tab);
    EXPECT_EQ(self.m_context.input().focus(), self.list());
    self.press(UiSearchComboKey::Tab);
    ASSERT_TRUE(self.acceptSearch(4u));
    EXPECT_TRUE(self.m_searchResult.combo.closed);
    EXPECT_FALSE(self.m_searchResult.combo.committed);
    EXPECT_EQ(self.m_search.combo().selectedKey(), 1u);
    EXPECT_EQ(self.m_search.combo().listState().cursorKey(), 1u);
    EXPECT_EQ(self.m_context.input().focus(), self.id(s_UiSearchComboKey, s_UiSearchComboPanelKey));
}

void VerifyUiSearchComboBuilderTests_ReverseTabFromQueryCancelsPreeditAndKeepsTheCommittedValue(mut UiSearchComboBuilderTests self){
    self.m_search.combo().select(1u);
    ASSERT_TRUE(self.acceptSearch(1u));
    ASSERT_TRUE(self.openSearch(2u));
    ASSERT_TRUE(self.m_search.query().beginComposition());
    ASSERT_TRUE(self.m_search.query().updateComposition(s_UiSearchComboPreeditText, 0u, 7u));
    ASSERT_TRUE(self.m_search.query().composition().active);
    InputEvent reverseDown = InputEvent();
    reverseDown.key = UiSearchComboKey::Tab;
    reverseDown.type = InputEventType::KeyDown;
    reverseDown.shift = true;
    InputEvent reverseUp = InputEvent();
    reverseUp.key = UiSearchComboKey::Tab;
    reverseUp.type = InputEventType::KeyUp;
    reverseUp.shift = true;
    EXPECT_TRUE(self.send(reverseDown).commandConsumed);
    EXPECT_TRUE(self.send(reverseUp).commandConsumed);
    ASSERT_TRUE(self.acceptSearch(3u));
    EXPECT_TRUE(self.m_searchResult.combo.closed);
    EXPECT_FALSE(self.m_searchResult.combo.committed);
    EXPECT_EQ(self.m_search.combo().selectedKey(), 1u);
    EXPECT_FALSE(self.m_search.query().composition().active);
    EXPECT_TRUE(self.m_search.query().text().empty());
    EXPECT_EQ(self.m_context.input().focus(), self.id(s_UiSearchComboKey, s_UiSearchComboPanelKey));
}

