#include "presentation_types.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<Optional<String>> ReadSmokeOptionalEnvironmentString(in StringView variableName){
    const Expected<Optional<String>, ErrorCode> value = ReadEnvironmentVariable(variableName);
    if(!value.has_value()){
        const String errorText = StringFormat("{}", value.error().message());
        error("Smoke: failed to read environment '{}': {}", variableName, errorText);
        return MakeUnexpected(Failure());
    }
    return value.value();
}

Expected<String> ReadSmokeEnvironmentString(in StringView variableName){
    const Expected<Optional<String>> value = ReadSmokeOptionalEnvironmentString(variableName);
    if(!value.has_value())
        return MakeUnexpected(Failure());
    const Optional<String> candidate = value.value();
    if(!candidate.has_value() || candidate.value().empty())
        return MakeUnexpected(Failure());
    return candidate.value();
}

Expected<f32> ReadSmokeEnvironmentF32(in StringView variableName){
    const Expected<String> text = ReadSmokeEnvironmentString(variableName);
    if(!text.has_value())
        return MakeUnexpected(Failure());
    return ParseF32(StringView(text.value()));
}

// Truthy env reader for on/off flags: absent/empty/"0" -> false, anything else -> true.
b8 ReadSmokeEnvironmentFlag(in StringView variableName){
    const Expected<String> text = ReadSmokeEnvironmentString(variableName);
    if(!text.has_value())
        return false;
    const StringView view = StringView(text.value());
    return !view.empty() && view[0u] != 0 && !view.starts_with("0");
}


