void VerifyUiEditActionHostTests_ReboundEditorModelCannotReceiveAnEarlierHeldSubmit(mut UiEditActionHostTests self){
    ASSERT_TRUE(self.activateActions());
    UiInputEvent down = UiInputEvent();
    down.key = Key::Enter;
    down.type = UiInputEventType::KeyDown;
    ASSERT_TRUE(self.dispatch(down));
    UiEditModel replacement = UiEditModel(self.m_arena);
    ASSERT_TRUE(replacement.setText("replacement"));
    native(mut self, mut replacement){
        ASSERT_TRUE(self.prepare(replacement, {}, { 10.0f, 20.0f, 180.0f, 30.0f }, &self.m_actions));
    }
    ASSERT_TRUE(self.commit());
    self.m_actions.clear();
    UiInputEvent up = UiInputEvent();
    up.key = Key::Enter;
    up.type = UiInputEventType::KeyUp;
    ASSERT_TRUE(self.dispatch(up));
    native(mut self, mut replacement){
        ASSERT_TRUE(self.prepare(replacement, {}, { 10.0f, 20.0f, 180.0f, 30.0f }, &self.m_actions));
    }
    ASSERT_TRUE(self.commit());
    EXPECT_FALSE(self.m_result.submitted);
    EXPECT_EQ(self.actionCount(UiEditAction::Submit), 0u);
    ASSERT_TRUE(self.key(Key::Enter));
    native(mut self, mut replacement){
        ASSERT_TRUE(self.prepare(replacement, {}, { 10.0f, 20.0f, 180.0f, 30.0f }, &self.m_actions));
    }
    ASSERT_TRUE(self.commit());
    EXPECT_EQ(self.actionCount(UiEditAction::Submit), 1u);
}

