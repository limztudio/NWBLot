#ifndef NWB_GRAPHICS_CAUSTIC_PHOTON_TYPES_SLANGI
#define NWB_GRAPHICS_CAUSTIC_PHOTON_TYPES_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "../mesh/runtime_constants.h"


// Producer input records shared by both the software compute kernel and the hardware ray-tracing shaders. The C++
// renderer supplies the same emission-target and mesh-view layouts to both backends.
struct NwbCausticEmissionTarget{
    float4 aabbMin;
    float4 aabbMax;
};

struct NwbCausticPhotonView{
    row_major float4x4 worldToClip;
    row_major float4x4 clipToWorld;
    float4 cameraPosition;
    float4 frustumPlanes[NWB_MESH_VIEW_FRUSTUM_PLANE_COUNT];
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif



////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


