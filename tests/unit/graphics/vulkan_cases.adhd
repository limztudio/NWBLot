[cpp_header("<core/graphics/vulkan/cluster_operation_input.h>"), cpp_name("::NWB::Core::GraphicsBackend::VulkanDetail::ClusterOperationInput")]
extern class ClusterOperationInput{
    VkClusterInputInfo nativeInfo();
};

[cpp_header("<core/graphics/vulkan/cluster_operation_input.h>"), cpp_name("::VkClusterAccelerationStructureInputInfoNV")]
extern class VkClusterInputInfo{
    u32 maxAccelerationStructureCount;
};

[cpp_header("<tests/unit/graphics/vulkan_resource_sdk.h>"), cpp_name("::NWB::Tests::VulkanSdk::BuildClusterInput")]
extern Expected<ClusterOperationInput> BuildClusterInput(in RayTracingClusterOperationParams params, in StringView operation, mut ScratchStorage scratch);

[cpp_header("<tests/unit/graphics/vulkan_resource_sdk.h>"), cpp_name("::NWB::Tests::VulkanSdk::MoveInputAddress")]
extern usize MoveInputAddress(in VkClusterInputInfo input);

[cpp_header("<tests/unit/graphics/vulkan_resource_sdk.h>"), cpp_name("::NWB::Tests::VulkanSdk::BlasInputAddress")]
extern usize BlasInputAddress(in VkClusterInputInfo input);

[cpp_header("<tests/unit/graphics/vulkan_resource_sdk.h>"), cpp_name("::NWB::Tests::VulkanSdk::TriangleInputAddress")]
extern usize TriangleInputAddress(in VkClusterInputInfo input);

[cpp_header("<tests/unit/graphics/vulkan_resource_sdk.h>"), cpp_name("::NWB::Tests::VulkanSdk::MoveFieldAddress")]
extern usize MoveFieldAddress(in ClusterOperationInput input);

[cpp_header("<tests/unit/graphics/vulkan_resource_sdk.h>"), cpp_name("::NWB::Tests::VulkanSdk::BlasFieldAddress")]
extern usize BlasFieldAddress(in ClusterOperationInput input);

[cpp_header("<tests/unit/graphics/vulkan_resource_sdk.h>"), cpp_name("::NWB::Tests::VulkanSdk::TriangleFieldAddress")]
extern usize TriangleFieldAddress(in ClusterOperationInput input);

[cpp_header("<tests/unit/graphics/vulkan_resource_sdk.h>"), cpp_name("::NWB::Tests::VulkanSdk::QueryCalibratedTimestamps")]
extern b8 QueryCalibratedTimestamps(mut auto driver, mut ScratchStorage scratch);

type RayTracingClusterOperationTypeEnum = RayTracingClusterOperationType;

class ClusterOperationCopyInspection{
    public b8 builtOk = false;
    public u32 maxAccelerationStructureCount = 0u;
    public usize activeInputAddress = 0u;
    public usize moveFieldAddress = 1u;
    public usize blasFieldAddress = 1u;
    public usize clusterFieldAddress = 1u;
}

ClusterOperationCopyInspection InspectClusterOperationCopy(in RayTracingClusterOperationParams params){
    ClusterOperationCopyInspection result;
    ScratchStorage scratch(s_TestArena);
    const Expected<ClusterOperationInput> built = BuildClusterInput(params, "test cluster input", scratch);
    result.builtOk = built.has_value();
    if(built){
        ClusterOperationInput copied = built.value();
        const VkClusterInputInfo info = copied.nativeInfo();
        result.maxAccelerationStructureCount = info.maxAccelerationStructureCount;
        if(params.type == RayTracingClusterOperationType::Move)
            result.activeInputAddress = MoveInputAddress(info);
        else if(params.type == RayTracingClusterOperationType::BlasBuild)
            result.activeInputAddress = BlasInputAddress(info);
        else
            result.activeInputAddress = TriangleInputAddress(info);
        result.moveFieldAddress = MoveFieldAddress(copied);
        result.blasFieldAddress = BlasFieldAddress(copied);
        result.clusterFieldAddress = TriangleFieldAddress(copied);
    }
    return result;
}

class CalibratedTimestampProbeResult{
    public b8 supported = false;
    public u32 countCalls = 0u;
    public u32 listCalls = 0u;
    public u32 timestampCalls = 0u;
}

class TimestampProbeDriver{
    public CalibratedTimestampProbeResult result;
    public b8 retryFirstCount = false;
    public b8 hasDeviceDomain = false;
    public b8 enumerateCount(mut u32 count){
        ++this.result.countCalls;
        count = 1u;
        return !(this.retryFirstCount && this.result.countCalls == 1u);
    }
    public b8 enumerateDomain(mut u32 count){
        ++this.result.listCalls;
        count = 1u;
        return this.hasDeviceDomain;
    }
    public void timestamp(mut u64 ticks, mut u64 deviation){
        ++this.result.timestampCalls;
        ticks = 1u;
        deviation = 0u;
    }
}

CalibratedTimestampProbeResult RunCalibratedTimestampProbe(in b8 retryFirstCount, in b8 hasDeviceDomain){
    TimestampProbeDriver driver;
    driver.retryFirstCount = retryFirstCount;
    driver.hasDeviceDomain = hasDeviceDomain;
    ScratchStorage scratch(s_TestArena);
    driver.result.supported = QueryCalibratedTimestamps(driver, scratch);
    return driver.result;
}
void VerifyCalibratedTimestampProbe_RetriesIncompleteEnumerationBeforeDeviceQuery(){
    const CalibratedTimestampProbeResult probe = RunCalibratedTimestampProbe(true, true);
    EXPECT_TRUE(probe.supported);
    EXPECT_EQ(probe.countCalls, 2u);
    EXPECT_EQ(probe.listCalls, 1u);
    EXPECT_EQ(probe.timestampCalls, 1u);
}

void VerifyCalibratedTimestampProbe_MissingDeviceDomainDoesNotQueryTimestamps(){
    const CalibratedTimestampProbeResult probe = RunCalibratedTimestampProbe(false, false);
    EXPECT_FALSE(probe.supported);
    EXPECT_EQ(probe.countCalls, 1u);
    EXPECT_EQ(probe.listCalls, 1u);
    EXPECT_EQ(probe.timestampCalls, 0u);
}

void VerifyGpuClusterOperation_NativeInputRebindsUnionPointersAfterCopy(){
    Array<RayTracingClusterOperationTypeEnum, 5> opTypes = Array<RayTracingClusterOperationTypeEnum, 5>();
    opTypes[0u] = RayTracingClusterOperationType::Move;
    opTypes[1u] = RayTracingClusterOperationType::ClasBuild;
    opTypes[2u] = RayTracingClusterOperationType::ClasBuildTemplates;
    opTypes[3u] = RayTracingClusterOperationType::ClasInstantiateTemplates;
    opTypes[4u] = RayTracingClusterOperationType::BlasBuild;
    for(in RayTracingClusterOperationTypeEnum opType : opTypes){
        RayTracingClusterOperationParams params = RayTracingClusterOperationParams();
        params.type = opType;
        params.maxArgCount = 7u;
        const ClusterOperationCopyInspection inspection = InspectClusterOperationCopy(params);
        ASSERT_TRUE(inspection.builtOk);
        EXPECT_EQ(inspection.maxAccelerationStructureCount, 7u);
        if(opType == RayTracingClusterOperationType::Move)
            EXPECT_EQ(inspection.activeInputAddress, inspection.moveFieldAddress);
        else if(opType == RayTracingClusterOperationType::BlasBuild)
            EXPECT_EQ(inspection.activeInputAddress, inspection.blasFieldAddress);
        else
            EXPECT_EQ(inspection.activeInputAddress, inspection.clusterFieldAddress);
    }
}


NWB_ADHD_GTEST(CalibratedTimestampProbe, RetriesIncompleteEnumerationBeforeDeviceQuery, VerifyCalibratedTimestampProbe_RetriesIncompleteEnumerationBeforeDeviceQuery)
NWB_ADHD_GTEST(CalibratedTimestampProbe, MissingDeviceDomainDoesNotQueryTimestamps, VerifyCalibratedTimestampProbe_MissingDeviceDomainDoesNotQueryTimestamps)
NWB_ADHD_GTEST(GpuClusterOperation, NativeInputRebindsUnionPointersAfterCopy, VerifyGpuClusterOperation_NativeInputRebindsUnionPointersAfterCopy)

