void VerifyUiSliderPopupTests_ChildResultsRemainStagedUntilTheOutermostPopupValidatesTheCompleteFamily(mut UiSliderPopupTests self){
    ASSERT_TRUE(self.beginParent(1u));
    EXPECT_FALSE(self.m_state.result().valid);
    ASSERT_TRUE(self.beginChild());
    EXPECT_FALSE(self.m_childState.result().valid);
    ASSERT_TRUE(self.m_builder.endPopup());
    EXPECT_FALSE(self.m_childState.result().valid);
    EXPECT_FALSE(self.m_state.result().valid);
    ASSERT_TRUE(self.finishParent());
    EXPECT_TRUE(self.m_state.result().valid);
    EXPECT_TRUE(self.m_childState.result().valid);
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    EXPECT_EQ(self.m_context.input().popupCount(), 2u);
}

void VerifyUiSliderPopupTests_AnIdenticalIntentOnTheEndedChildRejectsBothUnpublishedResults(mut UiSliderPopupTests self){
    ASSERT_TRUE(self.acceptFamily(1u));
