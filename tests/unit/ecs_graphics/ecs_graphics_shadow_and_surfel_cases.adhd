namespace EcsGraphicsSurfelCoverageDetail{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct ShaderFloat3{
    f32 x;
    f32 y;
    f32 z;


public:
    explicit ShaderFloat3(const f32 value)noexcept : x(value), y(value), z(value){}
    ShaderFloat3(const f32 red, const f32 green, const f32 blue)noexcept : x(red), y(green), z(blue){}
};

struct ShaderFloat4{
    f32 x;
    f32 y;
    f32 z;
    f32 w;


public:
    ShaderFloat4(const ShaderFloat3 rgb, const f32 alpha)noexcept : x(rgb.x), y(rgb.y), z(rgb.z), w(alpha){}
};

[[nodiscard]] inline ShaderFloat3 operator/(const ShaderFloat3 value, const f32 divisor)noexcept{
    const SIMDVectorSingle quotient = VectorDivide(VectorSet(value.x, value.y, value.z, 0.0f), VectorSet(divisor, divisor, divisor, 1.0f));
    return ShaderFloat3(VectorGetX(quotient), VectorGetY(quotient), VectorGetZ(quotient));
}

[[nodiscard]] inline f32 exp(const f32 value)noexcept{ return ::Exp(value); }

[[nodiscard]] f32 nwbSurfelGatherCoverage(f32 totalWeight);
[[nodiscard]] b8 nwbSurfelUpsampleNormalCompatible(f32 normalDot);
[[nodiscard]] f32 nwbSurfelUpsampleGeometryWeight(f32 bilinearWeight, f32 worldDistanceSquared, f32 invTwoSigmaWorldSq);
[[nodiscard]] f32 nwbSurfelUpsampleCoveredWeight(f32 geometryWeight, f32 tapCoverage);
[[nodiscard]] ShaderFloat4 nwbSurfelUpsampleFinalize(ShaderFloat3 weightedIrradianceSum, f32 coveredWeightSum, f32 compatibleWeightSum);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace EcsGraphicsSurfelHashDetail{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct ShaderInt3{
    i32 x;
    i32 y;
    i32 z;


public:
    ShaderInt3()noexcept : x(0), y(0), z(0){}
    ShaderInt3(const i32 xValue, const i32 yValue, const i32 zValue)noexcept
        : x(xValue)
        , y(yValue)
        , z(zValue)
    {}
    explicit ShaderInt3(const Float3U value)noexcept
        : x(static_cast<i32>(value.x))
        , y(static_cast<i32>(value.y))
        , z(static_cast<i32>(value.z))
    {}
};

[[nodiscard]] inline Float3U operator/(const Float3U value, const f32 divisor)noexcept{
    return Float3U(value.x / divisor, value.y / divisor, value.z / divisor);
}

[[nodiscard]] inline b8 operator==(const ShaderInt3 first, const ShaderInt3 second)noexcept{
    return first.x == second.x && first.y == second.y && first.z == second.z;
}

[[nodiscard]] inline Float3U FloorShaderVector(const Float3U value)noexcept{
    Float3U floored;
    StoreFloat(VectorFloor(LoadFloat(value)), floored);
    return floored;
}

[[nodiscard]] inline b8 AllShaderLanes(const b8 value)noexcept{ return value; }

[[nodiscard]] ShaderInt3 nwbSurfelCellCoord(Float3U worldPosition, f32 cellSize);
[[nodiscard]] b8 nwbSurfelSameCell(ShaderInt3 ownerCell, ShaderInt3 visitedCell);
[[nodiscard]] u32 nwbSurfelHashCell(ShaderInt3 cell, u32 cellCount);
[[nodiscard]] f32 GatherBoundaryValue(Float3U position, b8 validateCell)noexcept;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


