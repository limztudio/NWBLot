inline constexpr TStringView s_ClampMessage = NWB_TEXT("Frame Win32 client size clamped");
inline constexpr TStringView s_FrameClassName = NWB_TEXT("NWB_FRAME");

struct ClampObserverFailure final{};

class ThrowingClampLogger final : public Core::Common::ILogger{
private:
    using LogArena = Core::Common::LogArena;
    using LogString = Core::Common::LogString;


public:
    ThrowingClampLogger()
        : m_arena(Tests::FrameCases::s_OneOffNameTestsFrameClampObserver)
    {}


public:
    virtual LogArena& arena()noexcept override{ return m_arena; }

    virtual void enqueue(LogString&& text, Core::Common::LogType::Enum)override{ record(text); }

    virtual void enqueue(const LogString& text, Core::Common::LogType::Enum)override{ record(text); }

    [[nodiscard]] u32 clampCount()const noexcept{ return m_clampCount; }


private:
    void record(TStringView text);


private:
    LogArena m_arena;
    u32 m_clampCount = 0u;
};

class LoopLogger final : public Core::Common::ILogger{
private:
    static void Record(const Core::Common::LogString& text, Core::Common::LogType::Enum type);


public:
    virtual Core::Common::LogArena& arena()noexcept override{ return m_arena; }
    virtual void enqueue(Core::Common::LogString&& text, Core::Common::LogType::Enum type)override{ Record(text, type); }
    virtual void enqueue(const Core::Common::LogString& text, Core::Common::LogType::Enum type)override{ Record(text, type); }


private:
    Core::Common::LogArena m_arena{ Name(Tests::FrameCases::s_OneOffNameTestsFrameInactiveLoopLogger) };
};

class UnfocusedLoopRenderPass final : public Core::IRenderPass{
public:
    explicit UnfocusedLoopRenderPass(Core::GraphicsRuntime& graphics)noexcept
        : IRenderPass(graphics)
    {}


public:
    virtual b8 shouldRenderUnfocused()noexcept override{ return true; }
};

class CollectionTestPass final : public Core::IRenderPass{
public:
    explicit CollectionTestPass(Core::GraphicsRuntime& graphics)noexcept
        : IRenderPass(graphics)
    {}


public:
    virtual b8 validateResources(u32, u32, u32)override;
    virtual void invalidateResources()override{ ++invalidationCount; }


public:
    u32 validationCount = 0u;
    u32 invalidationCount = 0u;
    b8 valid = true;
};

struct LoopCallbackState{
    Core::Frame& frame;
    u32 callbacks = 0u;
};

b8 RequestQuitOnUpdate(void* userData, f32 delta);

#if defined(NWB_PLATFORM_WINDOWS)
void DrainQuitMessages()noexcept;
#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


