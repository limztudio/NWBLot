    public u32 blockIndex = 0u;
    public u32 byteBegin = 0u;
    public u32 constantByteBegin = 0u;
}

class MaterialBindTypedLayoutParameterLookupEntry{
    public Name blockName = s_NameNone;
    public u32 fieldIndex = 0u;
    public u32 byteOffset = 0u;
    public u32 constantByteOffset = 0u;
}

class MaterialBindStorageByteSizes{
    public u32 constantBytes = 0u;
    public u32 mutableBytes = 0u;
}

