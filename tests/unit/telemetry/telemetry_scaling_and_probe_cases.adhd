}

void VerifyTelemetry_PhysicalQueueBuilderOwnsSourceAndRejectsDuplicateOrExcessCounts(){
    TelemetryTestArena testArena = TelemetryTestArena();
    StatisticsFixture fixture = StatisticsFixture(testArena.arena);
    FrameGraphBuilder builder = FrameGraphBuilder(testArena.scratchArena, fixture.nodes, fixture.edges, fixture.pendingEdges, fixture.queues, 915u);

    FrameGraphPassMetadata passMeta = FrameGraphPassMetadata();
    passMeta.runtimeStatistics = MakeFrameGraphRuntimeStatistics();
    const FrameGraphNodeHandle owner = builder.addPass(s_RuntimeOwner, "Runtime owner", passMeta);
    FrameGraphPhysicalQueueRuntimeStatistics statistics = MakeFrameGraphPhysicalQueueRuntimeStatistics(1u);
    ASSERT_TRUE(builder.addPhysicalQueueRuntimeStatistics(owner, statistics));
    statistics.compile.taskCount = 0u;

    ASSERT_EQ(fixture.queues.size(), 1u);
    EXPECT_EQ(fixture.queues[0u].statistics.compile.taskCount, 50u);
    FrameGraphPhysicalQueueRuntimeStatistics outOfBounds = MakeFrameGraphPhysicalQueueRuntimeStatistics(3u);
    outOfBounds.compile.taskCount = 79u;
    outOfBounds.compile.packetCount = 78u;
    outOfBounds.compile.mergedTaskCount = 1u;
    EXPECT_FALSE(builder.addPhysicalQueueRuntimeStatistics(owner, outOfBounds));
    EXPECT_EQ(fixture.queues.size(), 1u);

    FrameGraphPhysicalQueueRuntimeStatistics derivedOutOfBounds = MakeFrameGraphPhysicalQueueRuntimeStatistics(3u);
    derivedOutOfBounds.compile.taskCount = 29u;
    derivedOutOfBounds.compile.mergedTaskCount = 2u;
    derivedOutOfBounds.recording.taskCount = 13u;
    EXPECT_TRUE(IsValidFrameGraphPhysicalQueueRuntimeStatistics(derivedOutOfBounds));
    EXPECT_FALSE(IsValidFrameGraphPhysicalQueueRuntimeStatisticsForOwner(derivedOutOfBounds, MakeFrameGraphRuntimeStatistics()));
    EXPECT_FALSE(builder.addPhysicalQueueRuntimeStatistics(owner, derivedOutOfBounds));
    EXPECT_EQ(fixture.queues.size(), 1u);

    FrameGraphPhysicalQueueRuntimeStatistics reorderedSubmissionDuration = MakeFrameGraphPhysicalQueueRuntimeStatistics(3u);
    reorderedSubmissionDuration.submission.submissionSeconds = 0.021000000000000004;
    EXPECT_TRUE(IsValidFrameGraphPhysicalQueueRuntimeStatisticsForOwner(reorderedSubmissionDuration, MakeFrameGraphRuntimeStatistics()));
    EXPECT_FALSE(builder.addPhysicalQueueRuntimeStatistics(owner, MakeFrameGraphPhysicalQueueRuntimeStatistics(1u)));
}

void VerifyFrameGraphReport_GroupsSparseOwnersWithoutLeakingStatisticsIntoAdjacentNodes(){
    TelemetryTestArena testArena = TelemetryTestArena();
    ReportFixture fixture = ReportFixture(testArena.arena);
    AddReportUnmeasuredNode(fixture);
    AddReportOwner(fixture, 3u, 1u);
    AddReportUnmeasuredNode(fixture);
    AddReportOwner(fixture, 0u, 5u);
    AddReportUnmeasuredNode(fixture);
    AddReportOwner(fixture, 2u, 7u, false);
    AddReportUnmeasuredNode(fixture);

    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureAll());
    ASSERT_TRUE(RecordTestFrameGraph(recorder, testArena.scratchArena, 918u, fixture.nodes, fixture.edges, fixture.queues, fixture.packets, 19u));

    ScratchArena scratchArena = ScratchArena(s_TelemetryCaseTestsTelemetryReportWork);
    const Expected<TelemetryReport> reportResult = BuildTestTelemetryReport(recorder.view(), testArena.arena, scratchArena);
    ASSERT_TRUE(reportResult.has_value());
    in TelemetryReport report = reportResult.value();
    ASSERT_EQ(report.summary.parseFailureCount, 0u);
    ASSERT_EQ(report.summary.frameGraphNodeCount, 7u);
    const StringView json = ReportJsonView(report);
    const StringView first = FindLineWithPrefix(json, "{\"index\": 1, \"identity\":");
    const StringView empty = FindLineWithPrefix(json, "{\"index\": 3, \"identity\":");
    const StringView last = FindLineWithPrefix(json, "{\"index\": 5, \"identity\":");
    ASSERT_FALSE(first.empty());
    ASSERT_FALSE(empty.empty());
    ASSERT_FALSE(last.empty());
    EXPECT_EQ(CountText(first, s_PacketIndex), 3u);
    EXPECT_TRUE(first.contains("\"physicalQueues\": [{"));
    EXPECT_TRUE(first.contains("\"queue\": {\"index\": 1,"));
    EXPECT_TRUE(first.contains("\"queue\": {\"index\": 2,"));
    EXPECT_FALSE(first.contains("\"queue\": {\"index\": 7,"));
    EXPECT_LT(first.find("\"packet\": {\"index\": 0,"), first.find("\"packet\": {\"index\": 1,"));
    EXPECT_LT(first.find("\"packet\": {\"index\": 1,"), first.find("\"packet\": {\"index\": 2,"));
    EXPECT_TRUE(empty.contains("\"physicalQueues\": null, \"packetSubmissions\": []"));
    EXPECT_EQ(CountText(last, s_PacketIndex), 2u);
    EXPECT_TRUE(last.contains("\"physicalQueues\": null"));
    EXPECT_TRUE(last.contains("\"queue\": {\"index\": 7,"));
    EXPECT_TRUE(last.contains("\"queue\": {\"index\": 8,"));
    EXPECT_FALSE(last.contains("\"queue\": {\"index\": 1,"));
    EXPECT_EQ(CountText(json, "\"runtimeStatistics\": null"), 4u);

    const StringView dot = ReportGraphView(report);
    const StringView firstDot = FindLineWithPrefix(dot, "  n1 [");
    const StringView emptyDot = FindLineWithPrefix(dot, "  n3 [");
    const StringView lastDot = FindLineWithPrefix(dot, "  n5 [");
    EXPECT_TRUE(firstDot.contains("runtime_physical_queue_count=2"));
    EXPECT_TRUE(firstDot.contains(s_RuntimePacketSubmissionCount3));
    EXPECT_TRUE(emptyDot.contains("runtime_physical_queue_count=\"unknown\""));
    EXPECT_TRUE(emptyDot.contains("runtime_packet_submission_count=0"));
    EXPECT_TRUE(lastDot.contains("runtime_physical_queue_count=\"unknown\""));
    EXPECT_TRUE(lastDot.contains(s_RuntimePacketSubmissionCount2));
    EXPECT_EQ(CountText(dot, "runtime_packet_submission_count="), 3u);
}

void VerifyFrameGraphReport_RestartsOwnerRangesForEveryCaptureAndReportRebuild(){
    TelemetryTestArena testArena = TelemetryTestArena();
    ReportFixture first = ReportFixture(testArena.arena);
    AddReportOwner(first, 3u, 1u);
    AddReportUnmeasuredNode(first);
    ReportFixture second = ReportFixture(testArena.arena);
    AddReportUnmeasuredNode(second);
    AddReportOwner(second, 2u, 7u);
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureAll());
    ScratchArena scratchArena = ScratchArena(s_TelemetryCaseTestsTelemetryReportWork);

    ASSERT_TRUE(RecordTestFrameGraph(recorder, testArena.scratchArena, 918u, first.nodes, first.edges, first.queues, first.packets, 19u));
    ASSERT_TRUE(RecordTestFrameGraph(recorder, testArena.scratchArena, 919u, second.nodes, second.edges, second.queues, second.packets, 20u));
    const Expected<TelemetryReport> reportResult3 = BuildTestTelemetryReport(recorder.view(), testArena.arena, scratchArena);
    ASSERT_TRUE(reportResult3.has_value());
    in TelemetryReport report3 = reportResult3.value();
    ASSERT_EQ(report3.summary.frameGraphFrameCount, 2u);
    EXPECT_EQ(CountText(ReportJsonView(report3), s_PacketIndex), 5u);
    EXPECT_EQ(CountText(ReportGraphView(report3), "runtime_physical_queue_count=2"), 2u);
    EXPECT_EQ(CountText(ReportGraphView(report3), s_RuntimePacketSubmissionCount3), 1u);
    EXPECT_EQ(CountText(ReportGraphView(report3), s_RuntimePacketSubmissionCount2), 1u);

    recorder.clear();
    ASSERT_TRUE(RecordTestFrameGraph(recorder, testArena.scratchArena, 920u, second.nodes, second.edges, second.queues, second.packets, 21u));
    const Expected<TelemetryReport> reportResult4 = BuildTestTelemetryReport(recorder.view(), testArena.arena, scratchArena);
    ASSERT_TRUE(reportResult4.has_value());
    in TelemetryReport report4 = reportResult4.value();
    ASSERT_EQ(report4.summary.frameGraphFrameCount, 1u);
    EXPECT_EQ(CountText(ReportJsonView(report4), s_PacketIndex), 2u);
    EXPECT_EQ(CountText(ReportGraphView(report4), s_RuntimePacketSubmissionCount2), 1u);
    EXPECT_FALSE(ReportGraphView(report4).contains(s_RuntimePacketSubmissionCount3));
}

void VerifyFrameGraphReport_RejectsMalformedOwnerTablesBeforeReportingAndRetainsTheNextValidCapture(){
    TelemetryTestArena testArena = TelemetryTestArena();
    ReportFixture fixture = ReportFixture(testArena.arena);
    AddReportUnmeasuredNode(fixture);
    AddReportOwner(fixture, 3u, 1u);
    TelemetryBytes original = TelemetryBytes(testArena.arena);
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureAll());
    ScratchArena scratchArena = ScratchArena(s_TelemetryCaseTestsTelemetryReportWork);

    ASSERT_TRUE(BuildTestFrameGraphPayload(918u, fixture.nodes, fixture.edges, fixture.queues, fixture.packets, testArena.scratchArena, original));
    EncodedFrameGraphPayloadHeader header = EncodedFrameGraphPayloadHeader();
    ReadTelemetryPod(original, 0u, header);
    ASSERT_EQ(header.queueAssignmentCount, 0u);
    ASSERT_EQ(header.compiledTaskCount, 0u);
    ASSERT_EQ(header.edgeCount, 0u);
    ASSERT_EQ(header.runtimeStatisticsCount, 1u);
    ASSERT_EQ(header.physicalQueueRuntimeStatisticsCount, 2u);
    ASSERT_EQ(header.packetSubmissionStatisticsCount, 3u);
    const usize queueOffset = s_EncodedFrameGraphPayloadHeaderByteSize
        + cast<usize>(header.nodeCount) * s_EncodedFrameGraphNodeByteSize
        + s_EncodedFrameGraphRuntimeStatisticsByteSize;
    const usize packetOffset = queueOffset + 2u * s_EncodedFrameGraphPhysicalQueueRuntimeStatisticsByteSize;
    ASSERT_LE(packetOffset + 3u * s_EncodedFrameGraphPacketSubmissionStatisticsByteSize, original.size());

    TelemetryBytes malformed = TelemetryBytes(testArena.arena);
    CopyTelemetryBytes(original, malformed);
    EncodedFrameGraphPacketSubmissionStatistics packet = EncodedFrameGraphPacketSubmissionStatistics();
    ReadTelemetryPod(malformed, packetOffset, packet);
    packet.ownerNodeIndex = header.nodeCount;
    WriteTelemetryPod(malformed, packetOffset, packet);
    ASSERT_TRUE(RecordBinaryBytes(recorder, EventKind::FrameGraphFrame, 918u, malformed, 1u));

    CopyTelemetryBytes(original, malformed);
    EncodedFrameGraphPacketSubmissionStatistics nextPacket = EncodedFrameGraphPacketSubmissionStatistics();
    ReadTelemetryPod(original, packetOffset, packet);
    ReadTelemetryPod(original, packetOffset + s_EncodedFrameGraphPacketSubmissionStatisticsByteSize, nextPacket);
    WriteTelemetryPod(malformed, packetOffset, nextPacket);
    WriteTelemetryPod(malformed, packetOffset + s_EncodedFrameGraphPacketSubmissionStatisticsByteSize, packet);
    ASSERT_TRUE(RecordBinaryBytes(recorder, EventKind::FrameGraphFrame, 918u, malformed, 2u));

    CopyTelemetryBytes(original, malformed);
    EncodedFrameGraphPhysicalQueueRuntimeStatistics queue = EncodedFrameGraphPhysicalQueueRuntimeStatistics();
    EncodedFrameGraphPhysicalQueueRuntimeStatistics nextQueue = EncodedFrameGraphPhysicalQueueRuntimeStatistics();
    ReadTelemetryPod(original, queueOffset, queue);
    ReadTelemetryPod(original, queueOffset + s_EncodedFrameGraphPhysicalQueueRuntimeStatisticsByteSize, nextQueue);
    WriteTelemetryPod(malformed, queueOffset, nextQueue);
    WriteTelemetryPod(malformed, queueOffset + s_EncodedFrameGraphPhysicalQueueRuntimeStatisticsByteSize, queue);
    ASSERT_TRUE(RecordBinaryBytes(recorder, EventKind::FrameGraphFrame, 918u, malformed, 3u));
    ASSERT_TRUE(RecordBinaryBytes(recorder, EventKind::FrameGraphFrame, 918u, original, 4u));

    const Expected<TelemetryReport> reportResult5 = BuildTestTelemetryReport(recorder.view(), testArena.arena, scratchArena);
    ASSERT_TRUE(reportResult5.has_value());
    in TelemetryReport report = reportResult5.value();
    EXPECT_EQ(report.summary.eventCount, 4u);
    EXPECT_EQ(report.summary.parseFailureCount, 3u);
    EXPECT_EQ(report.summary.frameGraphFrameCount, 1u);
    EXPECT_EQ(report.summary.frameGraphNodeCount, 2u);
    EXPECT_EQ(CountText(ReportJsonView(report), s_PacketIndex), 3u);
    EXPECT_EQ(CountText(ReportGraphView(report), s_RuntimePacketSubmissionCount3), 1u);
    EXPECT_TRUE(ReportGraphView(report).contains("Frame 918 stream 4"));
}

void VerifyTelemetry_FrameGraphRuntimeStatisticsPayloadRejectsMalformedRecords(){
    TelemetryTestArena testArena = TelemetryTestArena();
    FrameGraphNodeDescs nodes = FrameGraphNodeDescs(testArena.arena);
    FrameGraphEdgeDescs edges = FrameGraphEdgeDescs(testArena.arena);
    BuildTestRuntimeFrameGraph(testArena.arena, nodes, edges);
    TelemetryBytes payload = TelemetryBytes(testArena.arena);

    const usize runtimeStatisticsOffset = s_EncodedFrameGraphPayloadHeaderByteSize
        + s_EncodedFrameGraphNodeByteSize * nodes.size()
        + s_EncodedFrameGraphEdgeByteSize * edges.size()
        + s_EncodedFrameGraphQueueAssignmentByteSize * 2u
        + s_EncodedFrameGraphCompiledTaskByteSize * 2u;
    EncodedFrameGraphRuntimeStatistics first = EncodedFrameGraphRuntimeStatistics();
    EncodedFrameGraphRuntimeStatistics second = EncodedFrameGraphRuntimeStatistics();

    ASSERT_TRUE(ReloadRuntimeStatisticsPayload(nodes, edges, runtimeStatisticsOffset, testArena.scratchArena, payload, first, second));
    second.nodeIndex = first.nodeIndex;
    WriteTelemetryPod(payload, runtimeStatisticsOffset + s_EncodedFrameGraphRuntimeStatisticsByteSize, second);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(ReloadRuntimeStatisticsPayload(nodes, edges, runtimeStatisticsOffset, testArena.scratchArena, payload, first, second));
    first.nodeIndex = 2u;
    second.nodeIndex = 0u;
    WriteTelemetryPod(payload, runtimeStatisticsOffset, first);
    WriteTelemetryPod(payload, runtimeStatisticsOffset + s_EncodedFrameGraphRuntimeStatisticsByteSize, second);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(ReloadRuntimeStatisticsPayload(nodes, edges, runtimeStatisticsOffset, testArena.scratchArena, payload, first, second));
    first.nodeIndex = 1u;
    WriteTelemetryPod(payload, runtimeStatisticsOffset, first);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(ReloadRuntimeStatisticsPayload(nodes, edges, runtimeStatisticsOffset, testArena.scratchArena, payload, first, second));
    first.nodeIndex = 3u;
    WriteTelemetryPod(payload, runtimeStatisticsOffset, first);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(ReloadRuntimeStatisticsPayload(nodes, edges, runtimeStatisticsOffset, testArena.scratchArena, payload, first, second));
    first.reserved = 1u;
    WriteTelemetryPod(payload, runtimeStatisticsOffset, first);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(ReloadRuntimeStatisticsPayload(nodes, edges, runtimeStatisticsOffset, testArena.scratchArena, payload, first, second));
    first.graphGeneration = 0u;
    WriteTelemetryPod(payload, runtimeStatisticsOffset, first);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(ReloadRuntimeStatisticsPayload(nodes, edges, runtimeStatisticsOffset, testArena.scratchArena, payload, first, second));
    first.planGeneration = 0u;
    WriteTelemetryPod(payload, runtimeStatisticsOffset, first);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(ReloadRuntimeStatisticsPayload(nodes, edges, runtimeStatisticsOffset, testArena.scratchArena, payload, first, second));
    first.recordingAttemptGeneration = 0u;
    WriteTelemetryPod(payload, runtimeStatisticsOffset, first);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(ReloadRuntimeStatisticsPayload(nodes, edges, runtimeStatisticsOffset, testArena.scratchArena, payload, first, second));
    first.deviceGeneration = 0u;
    WriteTelemetryPod(payload, runtimeStatisticsOffset, first);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(ReloadRuntimeStatisticsPayload(nodes, edges, runtimeStatisticsOffset, testArena.scratchArena, payload, first, second));
    first.compile.declarationSeconds = -1.0;
    WriteTelemetryPod(payload, runtimeStatisticsOffset, first);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(ReloadRuntimeStatisticsPayload(nodes, edges, runtimeStatisticsOffset, testArena.scratchArena, payload, first, second));
    first.recording.recordingSeconds = bit_cast<f64>(0x7FF0000000000000uLL);
    WriteTelemetryPod(payload, runtimeStatisticsOffset, first);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(ReloadRuntimeStatisticsPayload(nodes, edges, runtimeStatisticsOffset, testArena.scratchArena, payload, first, second));
    first.submission.submissionSeconds = bit_cast<f64>(0x7FF8000000000000uLL);
    WriteTelemetryPod(payload, runtimeStatisticsOffset, first);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    for(usize mutationIndex = 0u; mutationIndex < s_RuntimeStatisticsCountMutationCount; ++mutationIndex){
        ScopedTestTrace trace = ScopedTestTrace(mutationIndex);
        ASSERT_TRUE(ReloadRuntimeStatisticsPayload(nodes, edges, runtimeStatisticsOffset, testArena.scratchArena, payload, first, second));
        FrameGraphRuntimeStatistics malformed = MakeFrameGraphRuntimeStatistics();
        ApplyRuntimeStatisticsCountMutation(malformed, mutationIndex);
        first = EncodeTestFrameGraphRuntimeStatistics(malformed, first.nodeIndex, first.reserved);
        WriteTelemetryPod(payload, runtimeStatisticsOffset, first);
        EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());
    }

    ASSERT_TRUE(ReloadRuntimeStatisticsPayload(nodes, edges, runtimeStatisticsOffset, testArena.scratchArena, payload, first, second));
    EncodedFrameGraphPayloadHeader header = EncodedFrameGraphPayloadHeader();
    ReadTelemetryPod(payload, 0u, header);
    header.runtimeStatisticsCount = 4u;
    WriteTelemetryPod(payload, 0u, header);
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload).has_value());

    ASSERT_TRUE(ReloadRuntimeStatisticsPayload(nodes, edges, runtimeStatisticsOffset, testArena.scratchArena, payload, first, second));
    EXPECT_FALSE(ParseTestFrameGraphPayload(testArena.arena, testArena.scratchArena, payload, payload.size() - 1u).has_value());
}

void VerifyTelemetry_FrameGraphPayloadRejectsInvalidInput(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    FrameGraphNodeDescs nodes = FrameGraphNodeDescs(testArena.arena);
    FrameGraphEdgeDescs edges = FrameGraphEdgeDescs(testArena.arena);
    BuildTestFrameGraph(testArena.arena, nodes, edges);

    nodes[0u].kind = FrameGraphNodeKind::Unknown;
    EXPECT_FALSE(BuildTestFrameGraphPayload(1u, nodes, edges, testArena.scratchArena, payload));

    BuildTestFrameGraph(testArena.arena, nodes, edges);
    String embeddedNulLabel = String("bad");
    embeddedNulLabel.resize(4u);
    embeddedNulLabel.append("label");
    nodes[0u].label = StringView(embeddedNulLabel);
    EXPECT_FALSE(BuildTestFrameGraphPayload(1u, nodes, edges, testArena.scratchArena, payload));

    BuildTestFrameGraph(testArena.arena, nodes, edges);
    edges[0u].toNodeIndex = 99u;
    EXPECT_FALSE(BuildTestFrameGraphPayload(1u, nodes, edges, testArena.scratchArena, payload));

    BuildTestAssignedFrameGraph(testArena.arena, nodes, edges);
    nodes[0u].queueAssignment.acceptance = FrameGraphQueueAssignmentAcceptance::First;
    EXPECT_FALSE(BuildTestFrameGraphPayload(1u, nodes, edges, testArena.scratchArena, payload));

    BuildTestAssignedFrameGraph(testArena.arena, nodes, edges);
    nodes[1u].queueAssignment = MakeChangedFrameGraphQueueAssignment();
    EXPECT_FALSE(BuildTestFrameGraphPayload(1u, nodes, edges, testArena.scratchArena, payload));

    BuildTestCompiledFrameGraph(testArena.arena, nodes, edges);
    nodes[1u].compiledTask = MakeFrameGraphCompiledTask(41u, 7u, FrameGraphTaskPacketizationDecision::FirstTask);
    EXPECT_FALSE(BuildTestFrameGraphPayload(1u, nodes, edges, testArena.scratchArena, payload));

    BuildTestFrameGraph(testArena.arena, nodes, edges);
    nodes[1u].runtimeStatistics = MakeFrameGraphRuntimeStatistics();
    EXPECT_FALSE(BuildTestFrameGraphPayload(1u, nodes, edges, testArena.scratchArena, payload));

    BuildTestRuntimeFrameGraph(testArena.arena, nodes, edges);
    nodes[0u].runtimeStatistics.graphGeneration = 0u;
    EXPECT_FALSE(BuildTestFrameGraphPayload(1u, nodes, edges, testArena.scratchArena, payload));

    BuildTestRuntimeFrameGraph(testArena.arena, nodes, edges);
    nodes[0u].runtimeStatistics.compile.totalSeconds = -1.0;
    EXPECT_FALSE(BuildTestFrameGraphPayload(1u, nodes, edges, testArena.scratchArena, payload));

    BuildTestRuntimeFrameGraph(testArena.arena, nodes, edges);
    nodes[0u].runtimeStatistics.recording.recordingElapsedSeconds = bit_cast<f64>(0x7FF8000000000000uLL);
    EXPECT_FALSE(BuildTestFrameGraphPayload(1u, nodes, edges, testArena.scratchArena, payload));

    for(usize mutationIndex = 0u; mutationIndex < s_RuntimeStatisticsCountMutationCount; ++mutationIndex){
        ScopedTestTrace trace = ScopedTestTrace(mutationIndex);
        BuildTestRuntimeFrameGraph(testArena.arena, nodes, edges);
        ApplyRuntimeStatisticsCountMutation(nodes[0u].runtimeStatistics, mutationIndex);
        EXPECT_FALSE(IsValidFrameGraphRuntimeStatistics(nodes[0u].runtimeStatistics));
        EXPECT_FALSE(BuildTestFrameGraphPayload(1u, nodes, edges, testArena.scratchArena, payload));
    }
}

void VerifyTelemetry_FrameGraphDurationTailsRejectInvalidValuesAndPreserveSignedZeroSubnormals(){
    // The final submission durations are scalar tails after four-lane validation blocks.
    const f64 minimumSubnormal = bit_cast<f64>(1uLL);
    Array<f64, 5> invalidDurations = Array<f64, 5>();
    invalidDurations[0u] = -1.0;
    invalidDurations[1u] = bit_cast<f64>(0x8000000000000001uLL);
    invalidDurations[2u] = bit_cast<f64>(0x7FF0000000000000uLL);
    invalidDurations[3u] = bit_cast<f64>(0x7FF8000000000000uLL);
    invalidDurations[4u] = bit_cast<f64>(0x7FF0000000000001uLL);
    for(in f64 duration : invalidDurations){
        FrameGraphRuntimeStatistics owner = MakeFrameGraphRuntimeStatistics();
        FrameGraphPhysicalQueueRuntimeStatistics queue = MakeFrameGraphPhysicalQueueRuntimeStatistics(1u);
        owner.submission.submissionSeconds = duration;
        EXPECT_FALSE(IsValidFrameGraphRuntimeStatistics(owner));
        owner = MakeFrameGraphRuntimeStatistics();
        queue.submission.submissionSeconds = duration;
        EXPECT_FALSE(IsValidFrameGraphPhysicalQueueRuntimeStatistics(queue));
        EXPECT_FALSE(IsValidFrameGraphPhysicalQueueRuntimeStatisticsForOwner(queue, owner));
    }
    Array<f64, 2> validDurations = Array<f64, 2>();
    validDurations[0u] = -0.0;
    validDurations[1u] = minimumSubnormal;
    for(in f64 duration : validDurations){
        FrameGraphRuntimeStatistics owner = MakeFrameGraphRuntimeStatistics();
        FrameGraphPhysicalQueueRuntimeStatistics queue = MakeFrameGraphPhysicalQueueRuntimeStatistics(1u);
        owner.submission.submissionSeconds = duration;
        queue.submission.submissionSeconds = duration;
        EXPECT_TRUE(IsValidFrameGraphRuntimeStatistics(owner));
        EXPECT_TRUE(IsValidFrameGraphPhysicalQueueRuntimeStatistics(queue));
        EXPECT_TRUE(IsValidFrameGraphPhysicalQueueRuntimeStatisticsForOwner(queue, owner));
    }
}

void VerifyFrameGraphSnapshotValidation_FullyAcceptedCountsCannotHideMissingTasksOrPackets(){
    TelemetryTestArena testArena = TelemetryTestArena();
    SnapshotValidationFixture fixture = SnapshotValidationFixture(testArena.arena);
    SeedSnapshotValidationFixture(fixture);
    ASSERT_TRUE(IsSnapshotValidationFixtureValid(fixture));
    fixture.payload.nodes.pop_back();
    --fixture.runtime.compile.taskCount;
    --fixture.runtime.compile.packetCount;
    fixture.runtime.submission.rejectedTaskCount = 0u;
    fixture.runtime.submission.rejectedPacketCount = 0u;
    fixture.payload.nodes[2u].compiledTask.present = false;
    EXPECT_FALSE(IsSnapshotValidationFixtureValid(fixture));
    fixture.payload.nodes[2u].compiledTask.present = true;
    fixture.payload.packetSubmissionStatistics.pop_back();
    EXPECT_FALSE(IsSnapshotValidationFixtureValid(fixture));
}

void VerifyFrameGraphSnapshotValidation_FullyAcceptedCountsStillRejectExecutedRecovery(){
    TelemetryTestArena testArena = TelemetryTestArena();
    SnapshotValidationFixture fixture = SnapshotValidationFixture(testArena.arena);
    SeedSnapshotValidationFixture(fixture);
    fixture.runtime.submission.acceptedTaskCount = fixture.runtime.compile.taskCount;
    fixture.runtime.submission.acceptedPacketCount = fixture.runtime.compile.packetCount;
    fixture.runtime.submission.rejectedTaskCount = 0u;
    fixture.runtime.submission.rejectedPacketCount = 0u;
    fixture.runtime.submission.recoverySubmissionCount = 1u;
    FrameGraphPacketSubmissionStatisticsRecord recovery = FrameGraphPacketSubmissionStatisticsRecord();
    recovery.packetGeneration = fixture.runtime.planGeneration;
    recovery.packetIndex = 2u;
    recovery.taskCount = 1u;
    recovery.queue.index = 0u;
    recovery.queue.deviceGeneration = 1u;
    recovery.recoverySubmission = true;
    fixture.payload.packetSubmissionStatistics.push_back(recovery);
    EXPECT_FALSE(IsSnapshotValidationFixtureValid(fixture));
    fixture.runtime.submission.recoverySubmissionCount = 0u;
    EXPECT_FALSE(IsSnapshotValidationFixtureValid(fixture));
    fixture.payload.packetSubmissionStatistics[2u].recoverySubmission = false;
    EXPECT_FALSE(IsSnapshotValidationFixtureValid(fixture));
}

