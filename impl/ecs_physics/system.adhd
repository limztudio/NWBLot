    }

    public Expected<void, CpuTaskAdmissionError> update(mut World world, in f32 delta)override{
        ClearDestroyedSlotOwners(this.m_syncScratch);
        this.clearFrameEvents();

        f32 fixedDt = 1.0f / 60.0f;
        u32 subStepCount = 4u;
        u32 maxSubStepsPerFrame = 4u;
        b8 paused = false;
        b8 interpolateTransforms = false;
        ResolvePhysicsConfigSettings(this.m_world, this.m_physicsWorld, fixedDt, subStepCount, maxSubStepsPerFrame, paused, interpolateTransforms);

        b8 hasAnyPhysicsParents = false;
        b8 hasDrivenKinematic = false;
        SyncEcsEntitiesToPhysicsWorld(
            this.m_assetManager,
            this.m_world,
            this.m_physicsWorld,
            this.m_entityRecords,
            this.m_entityJoints,
            this.m_bodyIndexToEntity,
            this.m_shapeIndexToEntity,
            this.m_jointIndexToEntity,
            this.m_namedEntities,
            this.m_syncedRigidBodyTags,
            this.m_syncedColliderTags,
            this.m_bodyTransformSnapshots,
            this.m_bodyTransformSnapshotMeta,
            this.m_syncScratch,
            hasAnyPhysicsParents,
            hasDrivenKinematic
        );
        PruneRemovedEcsRagdolls(this.m_world, this.m_physicsWorld, this.m_activeRagdolls, this.m_syncScratch.deadRagdolls);

        if(paused || !IsFinite(delta) || delta <= 0.0f){
            this.m_physicsWorld.consumePendingEndEvents(this.m_frameContactEndEvents, this.m_frameSensorEndEvents);
            this.m_physicsWorld.consumePendingWakeEvents(this.m_frameBodyWakeEvents);
            this.populateEcsFrameEvents();
            return Expected<void, CpuTaskAdmissionError>();
        }

        const f32 clampedDelta = Min(delta, fixedDt * cast<f32>(maxSubStepsPerFrame));
        this.m_accumulator += clampedDelta;

        u32 plannedSteps = 0u;
        f32 simAccum = this.m_accumulator;
        while(simAccum + 1.0e-6f >= fixedDt && plannedSteps < maxSubStepsPerFrame){
            if(simAccum >= fixedDt)
                simAccum -= fixedDt;
            else
                simAccum = 0.0f;
            ++plannedSteps;
        }

        const b8 useCollectedEnv = plannedSteps > 1u;
        if(useCollectedEnv){
            if(hasDrivenKinematic)
                SnapshotDrivenKinematicTargets(this.m_physicsWorld, this.m_syncScratch.drivenKinematicEntries, hasAnyPhysicsParents, this.m_world, this.m_syncScratch.kinematicTargets);
            CollectEcsPhysicsEnvironment(this.m_world, this.m_environmentScratch);
        }

        mut CpuTaskScheduler scheduler = this.m_world.taskScheduler();
        u32 stepsExecuted = 0u;
        while(this.m_accumulator + 1.0e-6f >= fixedDt && stepsExecuted < maxSubStepsPerFrame){
            if(this.m_accumulator >= fixedDt)
                this.m_accumulator -= fixedDt;
            else
                this.m_accumulator = 0.0f;

            if(stepsExecuted + 1u == plannedSteps)
                PreparePrevEcsBodyTransformSnapshots(this.m_physicsWorld, this.bodyMoveEvents(), this.m_syncScratch.dirtyPrevSnapshotBodyIndices, this.m_syncScratch.snapshotBodyStamps, this.m_syncScratch.snapshotStamp, this.m_bodyTransformSnapshots, this.m_bodyTransformSnapshotMeta);
            if(hasDrivenKinematic){
                if(plannedSteps <= 1u)
                    ApplyKinematicTargetsFromEcs(this.m_syncScratch.drivenKinematicEntries, fixedDt, hasAnyPhysicsParents, this.m_world, this.m_physicsWorld);
                else
                    ApplyInterpolatedKinematicTargets(this.m_syncScratch.kinematicTargets, stepsExecuted, plannedSteps, fixedDt, this.m_physicsWorld);
            }

            StepEcsPhysicsSubsystemBridges(
                this.m_world,
                this.m_physicsWorld,
                this.m_entityRecords,
                this.m_bodyIndexToEntity,
                fixedDt,
                useCollectedEnv,
                this.m_environmentScratch,
                this.m_activeRagdolls,
                this.m_syncScratch,
                scheduler
            );

            const Timer stepStart = TimerNow();
            StepWorldWithGpu(this.m_physicsWorld, this.m_gpuDispatcher, fixedDt, subStepCount, scheduler);
            this.m_lastStepMs = DurationInMS<f64>(TimerNow(), stepStart);

            if(plannedSteps == 1u)
                this.m_useDirectWorldEvents = true;
            else
                this.appendLastStepEvents();
            this.m_lastStepStats = this.m_physicsWorld.lastStepStats();
            ++stepsExecuted;
        }

        this.m_interpolationAlpha = Clamp(this.m_accumulator / fixedDt, 0.0f, 1.0f);

        if(stepsExecuted > 0u){
            if(stepsExecuted == 1u){
                WriteBackPhysicsTransformsToEcs(
                    this.m_physicsWorld,
                    this.bodyMoveEvents(),
                    this.m_bodyIndexToEntity,
                    hasAnyPhysicsParents,
                    true,
                    interpolateTransforms,
                    this.m_interpolationAlpha,
                    this.m_world,
                    this.m_syncScratch,
                    this.m_bodyTransformSnapshots,
                    this.m_bodyTransformSnapshotMeta
                );
            }
            else{
                CommitCurrEcsBodyTransformSnapshots(this.m_physicsWorld, this.m_syncScratch.dirtyPrevSnapshotBodyIndices, this.m_bodyTransformSnapshots, this.m_bodyTransformSnapshotMeta);
                WriteBackPhysicsTransformsToEcs(
                    this.m_physicsWorld,
                    this.bodyMoveEvents(),
                    this.m_bodyIndexToEntity,
                    hasAnyPhysicsParents,
                    false,
                    interpolateTransforms,
                    this.m_interpolationAlpha,
                    this.m_world,
                    this.m_syncScratch,
                    this.m_bodyTransformSnapshots,
                    this.m_bodyTransformSnapshotMeta
                );
            }
        }
        else{
            this.m_physicsWorld.consumePendingEndEvents(this.m_frameContactEndEvents, this.m_frameSensorEndEvents);
            this.m_physicsWorld.consumePendingWakeEvents(this.m_frameBodyWakeEvents);
            if(interpolateTransforms){
                ApplyInterpolatedRenderTransformsToEcs(
                    this.m_physicsWorld,
                    this.m_bodyIndexToEntity,
                    hasAnyPhysicsParents,
                    this.m_interpolationAlpha,
                    this.m_bodyTransformSnapshots,
                    this.m_bodyTransformSnapshotMeta,
                    this.m_world,
                    this.m_syncScratch
                );
            }
        }

        this.populateEcsFrameEvents();
        return Expected<void, CpuTaskAdmissionError>();
    }
}


