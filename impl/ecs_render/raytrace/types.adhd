    public u32 transparentMomentsInSlot = 0u;
    public u32 transparentHistoryOutSlot = 0u;
    public u32 transparentMomentsOutSlot = 0u;
}

enum<u8> SoftShadowOpaqueResolvePhase{
    enum TemporalAndWavelet,
    enum TemporalOnly,
    enum WaveletOnly
}

// Soft resolve either overwrites visibility or multiplies transparent transmittance.
enum<u32> SoftShadowUpsampleFold{
    enum Overwrite = 0u,
    enum Multiply
}

b8 CanCombineSoftShadowWavelets(in b8 combinedUpsample, in b8 pipelineReady, in b8 opaqueTemporalReady, in b8 transparentTemporalReady, in u32 opaquePassCount, in u32 transparentPassCount){
    return combinedUpsample && pipelineReady && opaqueTemporalReady && transparentTemporalReady && opaquePassCount == 1u && transparentPassCount == 1u;
}


