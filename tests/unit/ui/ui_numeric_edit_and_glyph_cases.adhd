IntegerBounds MakeUiNumericIntegerBounds(in i64 minimum, in i64 maximum, in NumericBoundsPolicyEnum policy){
    IntegerBounds bounds = IntegerBounds();
    bounds.minimum = minimum;
    bounds.maximum = maximum;
    bounds.policy = policy;
    return bounds;
}

FloatBounds MakeUiNumericFloatBounds(in f64 minimum, in f64 maximum, in NumericBoundsPolicyEnum policy){
    FloatBounds bounds = FloatBounds();
    bounds.minimum = minimum;
    bounds.maximum = maximum;
    bounds.policy = policy;
    return bounds;
}

Rect MakeUiPaintGlyphRect(in f32 x, in f32 y, in f32 width, in f32 height){
    Rect rect = Rect();
    rect.x = x;
    rect.y = y;
    rect.width = width;
    rect.height = height;
    return rect;
}

Color MakeUiPaintGlyphColor(in f32 r, in f32 g, in f32 b, in f32 a){
    Color color = Color();
    color.r = r;
    color.g = g;
    color.b = b;
    color.a = a;
    return color;
}

void ExpectUiNumericAtomicBadIntegerBounds(in IntegerBounds bounds, mut UiNumericLifetimeGlobalArena arena, mut IntegerEditModel model){
    ASSERT_TRUE(model.setValue(7));
    ASSERT_TRUE(model.lendDraft().replaceSelection("8"));
    ASSERT_TRUE(model.lendDraft().setSelection(0u, 1u));
    ASSERT_TRUE(model.lendDraft().beginComposition());
    ASSERT_TRUE(model.lendDraft().updateComposition("9", 0u, 1u));
    const UiNumericLifetimeDraftSnapshot before = UiNumericLifetimeDraftSnapshot(arena, model.draft());
    const u64 epoch = model.revision();
    const u64 valueBits = bit_cast<u64>(model.value());
    EXPECT_FALSE(model.submit(bounds).valid);
    EXPECT_FALSE(model.blur(bounds).valid);
    EXPECT_EQ(model.status(bounds), NumericParseStatus::Invalid);
    EXPECT_EQ(model.revision(), epoch);
    EXPECT_EQ(bit_cast<u64>(model.value()), valueBits);
    EXPECT_TRUE(model.dirty());
    before.expectUnchanged(model.draft());
}

void ExpectUiNumericAtomicBadFloatBounds(in FloatBounds bounds, mut UiNumericLifetimeGlobalArena arena, mut FloatEditModel model){
    ASSERT_TRUE(model.setValue(7.0));
    ASSERT_TRUE(model.lendDraft().replaceSelection("8"));
    ASSERT_TRUE(model.lendDraft().setSelection(0u, 1u));
    ASSERT_TRUE(model.lendDraft().beginComposition());
    ASSERT_TRUE(model.lendDraft().updateComposition("9", 0u, 1u));
    const UiNumericLifetimeDraftSnapshot before = UiNumericLifetimeDraftSnapshot(arena, model.draft());
    const u64 epoch = model.revision();
    const u64 valueBits = bit_cast<u64>(model.value());
    EXPECT_FALSE(model.submit(bounds).valid);
    EXPECT_FALSE(model.blur(bounds).valid);
    EXPECT_EQ(model.status(bounds), NumericParseStatus::Invalid);
    EXPECT_EQ(model.revision(), epoch);
    EXPECT_EQ(bit_cast<u64>(model.value()), valueBits);
    EXPECT_TRUE(model.dirty());
    before.expectUnchanged(model.draft());
}


