void VerifyAdhdCompiler_TopologicallyOrdersOutOfOrderDeclarationsAndRejectsAccessViolations(){
    AdhdTestArena arena = AdhdTestArena();

    CompileResult res = CompileResult(arena.arena);
    ASSERT_TRUE(Compile(s_SuiteTopoLayoutAccessSource, "impl/sim/topo_layout_access.adhd", arena.arena, res));

    const StringView hdrView = GeneratedHeaderView(res);

    const usize aliasAPos = hdrView.find("using AliasA = i32;");
    const usize aliasBPos = hdrView.find("using AliasB = AliasA;");
    ASSERT_NE(aliasAPos, usize.max);
    ASSERT_NE(aliasBPos, usize.max);
    EXPECT_LT(aliasAPos, aliasBPos);

    const usize baseIfacePos = hdrView.find("class IBaseNode{");
    const usize derivedIfacePos = hdrView.find("class IDerivedNode : public IBaseNode{");
    ASSERT_NE(baseIfacePos, usize.max);
    ASSERT_NE(derivedIfacePos, usize.max);
    EXPECT_LT(baseIfacePos, derivedIfacePos);

    const usize leafPos = hdrView.find("class LeafInner final{");
    const usize midPos = hdrView.find("class MidOuter final{");
    const usize grandPos = hdrView.find("class GrandOuter final{");
    ASSERT_NE(leafPos, usize.max);
    ASSERT_NE(midPos, usize.max);
    ASSERT_NE(grandPos, usize.max);
    EXPECT_LT(leafPos, midPos);
    EXPECT_LT(midPos, grandPos);

    ASSERT_EQ(UnitClassCount(res), 4u);
    EXPECT_EQ(UnitClassName(res, 1u), "GrandOuter");
    EXPECT_EQ(UnitClassTotalAlign(res, 1u), 8u);
    EXPECT_EQ(UnitClassTotalSize(res, 1u), 24u);

    ExpectCompileFails(arena, "class SecretBox {\r\n    private i32 hidden = 7;\r\n}\r\ni32 Leak(in SecretBox b) {\r\n    return b.hidden;\r\n}\r\n", "impl/sim/priv_field.adhd");
    ExpectCompileFails(arena, "class SecretBox {\r\n    private i32 calc()const { return 7; }\r\n}\r\ni32 Leak(in SecretBox b) {\r\n    return b.calc();\r\n}\r\n", "impl/sim/priv_method.adhd");
    ExpectCompileFails(arena, "class SecretBox {\r\n    public i32 v = 0;\r\n    private SecretBox(in i32 x) { this.v = x; }\r\n}\r\nvoid Make() {\r\n    SecretBox b(5);\r\n}\r\n", "impl/sim/priv_ctor.adhd");
    ExpectCompileFails(arena, "interface INode {\r\n    i32 id()const;\r\n}\r\nvoid BadAuto(in INode n) {\r\n    auto copy = n;\r\n}\r\n", "impl/sim/auto_iface.adhd");
    ExpectCompileFails(arena, s_SuiteMutRebindConstSource, "impl/sim/mut_rebind_const.adhd");

    CompileResult inRebindRes = CompileResult(arena.arena);
    ASSERT_TRUE(Compile(
        "class RefTarget {\r\n    public i32 value = 0;\r\n}\r\nclass RefHolder {\r\n    public in RefTarget target;\r\n    public RefHolder(in RefTarget t){ this.target = t; }\r\n    public void rebind(in RefTarget next){ this.target = next; }\r\n    public i32 read()const{ return this.target.value; }\r\n}\r\ni32 StepRefs(in RefTarget a, in RefTarget b){\r\n    in RefTarget localRef = a;\r\n    localRef = b;\r\n    RefHolder holder(a);\r\n    holder.rebind(b);\r\n    holder.target = a;\r\n    return localRef.value + holder.read();\r\n}\r\n",
        "impl/sim/in_rebind_ok.adhd",
        arena.arena,
        inRebindRes
    ));
    const StringView inRebindHdrView = GeneratedHeaderView(inRebindRes);
    const StringView inRebindCppView = GeneratedSourceView(inRebindRes);
    EXPECT_NE(inRebindHdrView.find("(this->target = ::MakeNotNull(&(next)))"), usize.max);
    EXPECT_NE(inRebindCppView.find("(localRef = ::MakeNotNull(&(b)))"), usize.max);
    EXPECT_NE(inRebindCppView.find("(holder.target = ::MakeNotNull(&(a)))"), usize.max);

    ExpectCompileFails(arena, "class RefTarget { public i32 value = 0; }\r\nclass RefHolder {\r\n    public in RefTarget target;\r\n    public RefHolder(in RefTarget t){ this.target = t; }\r\n    public void badConstRebind(in RefTarget next)const{ this.target = next; }\r\n}\r\n", "impl/sim/in_rebind_const_method.adhd");
    ExpectCompileFails(arena, "class RefTarget { public i32 value = 0; }\r\nvoid BadTempRebind(in RefTarget a){\r\n    in RefTarget localRef = a;\r\n    localRef = RefTarget();\r\n}\r\n", "impl/sim/in_rebind_rvalue.adhd");
    ExpectCompileFails(arena, "class RefTarget { public i32 value = 0; }\r\nvoid BadParamRebind(in RefTarget a, in RefTarget b){\r\n    a = b;\r\n}\r\n", "impl/sim/in_rebind_param.adhd");
    ExpectCompileFails(arena, "class RefTarget { public i32 value = 0; }\r\nclass RefHolder {\r\n    public in RefTarget target;\r\n    public RefHolder(in RefTarget t){ this.target = t; }\r\n}\r\nvoid BadConstOwnerRebind(in RefHolder ch, in RefTarget b){\r\n    ch.target = b;\r\n}\r\n", "impl/sim/in_rebind_const_owner.adhd");
}

void VerifyAdhdCompiler_ExcludesKCountFromEnumReflectionOrdersDeferredTemplateSpecsAndRejectsInvalidTemplates(){
    AdhdTestArena arena = AdhdTestArena();

    CompileResult res = CompileResult(arena.arena);
    ASSERT_TRUE(Compile(s_SuiteNamedEnumSpecSource, "impl/sim/named_enum_spec.adhd", arena.arena, res));

    const StringView hdrView = GeneratedHeaderView(res);

    EXPECT_NE(hdrView.find("constexpr usize reflectedEnumeratorCount()noexcept{ return 2u; }"), usize.max);
    EXPECT_EQ(hdrView.find("{ \"kCount\", kCount },"), usize.max);

    const usize boxPrimaryPos = hdrView.find("template<typename T>\r\nclass Box final{");
    const usize payloadClassPos = hdrView.find("class Payload final{");
    const usize boxSpecPos = hdrView.find("template<>\r\nclass Box<Payload> final{");
    const usize wrapperClassPos = hdrView.find("class Wrapper final{");
    ASSERT_NE(boxPrimaryPos, usize.max);
    ASSERT_NE(payloadClassPos, usize.max);
    ASSERT_NE(boxSpecPos, usize.max);
    ASSERT_NE(wrapperClassPos, usize.max);
    EXPECT_LT(boxPrimaryPos, boxSpecPos);
    EXPECT_LT(payloadClassPos, boxSpecPos);
    EXPECT_LT(boxSpecPos, wrapperClassPos);

    ExpectCompileFails(arena, "class Box<T> {\r\n    public T item;\r\n}\r\nclass BadRec {\r\n    public Box<BadRec> next;\r\n}\r\n", "impl/sim/template_rec.adhd");
    ExpectCompileFails(arena, "[serialize]\r\nclass Packet<T> {\r\n    public T data;\r\n}\r\nvoid UsePacket(in Packet<Vector<u32>> p) {}\r\n", "impl/sim/template_ser_bad.adhd");
    ExpectCompileFails(arena, "enum<u8> BadMode {\r\n    Idle,\r\n    Count,\r\n}\r\n", "impl/sim/bad_enum_count.adhd");
}

