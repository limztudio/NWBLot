void VerifyUiNestedPopupContextTests_RegistrationRejectsAnAncestorTokenFromAnotherOpenEpoch(mut UiNestedPopupContextTests self){
    ASSERT_TRUE(self.begin(1u));
    const auto parentResult = self.reserve(s_UiNestedPopupContextParentKey);
    ASSERT_TRUE(parentResult.has_value());
    const UiNestedPopupContextPopupDeclaration parent = parentResult.value();
    ASSERT_TRUE(self.m_context.activatePopupScope(parent.scope.token));
    const auto declared = self.declareState(s_UiNestedPopupContextChildKey, WidgetKind::Popup);
    ASSERT_TRUE(declared.has_value());
    const WidgetState child = declared.value();
    PopupScope invalid = parent.scope;
    invalid.token = MakeUiNestedPopupContextToken(child.id, child.declarationGeneration, 901u, 1u);
    invalid.parent = parent.scope.token;
    ++invalid.parent.openGeneration;
    EXPECT_FALSE(self.m_context.registerPopupScope(child, invalid));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_EQ(self.m_context.popupToken(), parent.scope.token);
    EXPECT_FALSE(self.m_context.hasPopupScope(invalid.token));
}

void VerifyUiNestedPopupContextTests_FinalGeometryCannotRebindParentTokenOrReservedLayer(mut UiNestedPopupContextTests self){
    ASSERT_TRUE(self.begin(1u));
    const auto parentResult = self.reserve(s_UiNestedPopupContextParentKey);
    ASSERT_TRUE(parentResult.has_value());
    const UiNestedPopupContextPopupDeclaration parent = parentResult.value();
    ASSERT_TRUE(self.m_context.activatePopupScope(parent.scope.token));
    const auto childResult = self.reserve(s_UiNestedPopupContextChildKey);
    ASSERT_TRUE(childResult.has_value());
    const UiNestedPopupContextPopupDeclaration child = childResult.value();
    PopupScope invalid = child.scope;
    invalid.layer = 1u;
    EXPECT_FALSE(self.m_context.updatePopupScope(child.scope.token, invalid));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_EQ(self.m_context.popupLayer(child.scope.token), 2u);
    self.m_context.abandonFrame();
    ASSERT_TRUE(self.begin(2u));
    const auto nextParentResult = self.reserve(s_UiNestedPopupContextParentKey);
    ASSERT_TRUE(nextParentResult.has_value());
    const UiNestedPopupContextPopupDeclaration nextParent = nextParentResult.value();
    ASSERT_TRUE(self.m_context.activatePopupScope(nextParent.scope.token));
    const auto nextChildResult = self.reserve(s_UiNestedPopupContextChildKey);
    ASSERT_TRUE(nextChildResult.has_value());
    const UiNestedPopupContextPopupDeclaration nextChild = nextChildResult.value();
    invalid = nextChild.scope;
    invalid.parent = PopupToken();
    EXPECT_FALSE(self.m_context.updatePopupScope(nextChild.scope.token, invalid));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_EQ(self.m_context.popupToken(), nextParent.scope.token);
}

void VerifyUiNestedPopupContextTests_InvalidFinalGeometryCannotPublishThePreparedFamily(mut UiNestedPopupContextTests self){
    ASSERT_TRUE(self.begin(1u));
    const auto parentResult = self.reserve(s_UiNestedPopupContextParentKey);
