////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_model/binary_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsAllowedModelMetadataField(in StringView fieldName){
    return
        fieldName == s_ModelSkeletonsField
        || fieldName == s_ModelStaticMeshesField
        || fieldName == s_ModelSkinnedMeshesField
    ;
}

b8 IsAllowedModelSkeletonObjectField(in StringView fieldName){
    return fieldName == s_ModelSkeletonField || fieldName == s_ModelTransformField;
}

b8 IsAllowedModelStaticMeshObjectField(in StringView fieldName){
    return
        fieldName == s_ModelMeshField
        || fieldName == s_ModelMaterialField
        || fieldName == s_ModelParentObjectField
        || fieldName == s_ModelParentJointField
        || fieldName == s_ModelTransformField
    ;
}

b8 IsAllowedModelSkinnedMeshObjectField(in StringView fieldName){
    return
        fieldName == s_ModelSkinField
        || fieldName == s_ModelMaterialField
        || fieldName == s_ModelSkeletonField
        || fieldName == s_ModelTransformField
    ;
}

b8 IsValidModelHeaderBinary(in ModelHeaderBinary header){
    return header.padding0 == 0u;
}

b8 ValidateModelHeaderBinary(in ModelHeaderBinary header){
    if(IsValidModelHeaderBinary(header))
        return true;

    error("Model::loadBinary failed: reserved header fields must be zero");
    return false;
}

b8 IsModelObjectFlaggedSkeleton(in u8 flags){
    return (flags & s_ModelSkeletonObjectNameFlag) != 0u;
}

b8 IsModelObjectFlaggedDuplicate(in u8 flags){
    return (flags & s_ModelDuplicateObjectNameFlag) != 0u;
}

void MarkDuplicateModelObjectNameFlags(mut u8 inOutFlags){
    inOutFlags |= s_ModelDuplicateObjectNameFlag;
}

void ResolveModelStaticMeshParentState(
    in Name objectName,
    in Name parentObject,
    in b8 foundParent,
    in u8 parentFlags,
    mut b8 outParentExists,
    mut b8 outParentIsSkeleton
){
    outParentExists = parentObject == objectName;
    outParentIsSkeleton = false;
    if(parentObject != s_NameNone && foundParent){
        outParentExists = true;
        outParentIsSkeleton = IsModelObjectFlaggedSkeleton(parentFlags);
    }
}

b8 ResolveModelSkinnedMeshTargetState(in b8 foundParent, in u8 parentFlags){
    return foundParent && IsModelObjectFlaggedSkeleton(parentFlags);
}

Expected<usize> TryComputeTotalModelObjectCount(in usize skeletonCount, in usize staticMeshCount, in usize skinnedMeshCount){
    usize objectCount = 0u;
    if(skeletonCount > 0xffffffffffffffffu - objectCount)
        return makeUnexpected(Failure());
    objectCount += skeletonCount;
    if(staticMeshCount > 0xffffffffffffffffu - objectCount)
        return makeUnexpected(Failure());
    objectCount += staticMeshCount;
    if(skinnedMeshCount > 0xffffffffffffffffu - objectCount)
        return makeUnexpected(Failure());
    objectCount += skinnedMeshCount;
    return objectCount;
}

Expected<usize> ResolveModelObjectCount(in usize skeletonCount, in usize staticMeshCount, in usize skinnedMeshCount){
    if(skeletonCount == 0u && staticMeshCount == 0u && skinnedMeshCount == 0u){
        error("Model::validatePayload failed: model has no objects");
        return makeUnexpected(Failure());
    }
    const Expected<usize> objectCountResult = TryComputeTotalModelObjectCount(skeletonCount, staticMeshCount, skinnedMeshCount);
    if(!objectCountResult.has_value()){
        error("Model::validatePayload failed: total object count overflows");
        return makeUnexpected(Failure());
    }
    const usize objectCount = objectCountResult.value();
    if(objectCount > 1u && objectCount > usize.max / 2u){
        error("Model::validatePayload failed: name index capacity overflows");
        return makeUnexpected(Failure());
    }
    return objectCount;
}

b8 IsCompleteModelSkeletonObject(in ModelSkeletonObject object){
    return object.name != s_NameNone && object.skeleton.valid();
}

b8 IsCompleteModelStaticMeshObject(in ModelStaticMeshObject object){
    return object.name != s_NameNone && object.mesh.valid();
}

b8 IsValidOptionalModelMaterialRef(in AssetRef<Material> material){
    if(material.virtualPath == s_NameNone)
        return true;
    return material.valid();
}

b8 IsCompleteModelSkinnedMeshObject(in ModelSkinnedMeshObject object){
    return object.name != s_NameNone && object.skin.valid() && object.skeletonObject != s_NameNone;
}

b8 ValidateModelSkeletonObject(in ModelSkeletonObject object, in usize index, in b8 nameIsUnique){
    if(!IsFiniteSkeletonJointMatrix(MatrixSingle(object.transform))){
        error("Model::validatePayload failed: skeleton object {} has non-finite transform", index);
        return false;
    }
    if(!IsCompleteModelSkeletonObject(object)){
        error("Model::validatePayload failed: skeleton object {} is incomplete", index);
        return false;
    }
    if(!nameIsUnique){
        error("Model::validatePayload failed: skeleton object {} name is duplicated in the model", index);
        return false;
    }
    return true;
}

b8 ValidateModelStaticMeshObject(
    in ModelStaticMeshObject object,
    in usize index,
    in b8 nameIsUnique,
    in b8 parentExists,
    in b8 parentIsSkeleton
){
    if(!IsFiniteSkeletonJointMatrix(MatrixSingle(object.transform))){
        error("Model::validatePayload failed: static mesh object {} has non-finite transform", index);
        return false;
    }
    if(!IsCompleteModelStaticMeshObject(object)){
        error("Model::validatePayload failed: static mesh object {} is incomplete", index);
        return false;
    }
    if(!IsValidOptionalModelMaterialRef(object.material)){
        error("Model::validatePayload failed: static mesh object {} has invalid material reference", index);
        return false;
    }
    if(!nameIsUnique){
        error("Model::validatePayload failed: static mesh object {} name is duplicated in the model", index);
        return false;
    }
    if(object.parentObject == s_NameNone && object.parentJoint != s_NameNone){
        error("Model::validatePayload failed: static mesh object {} has joint parent without object parent", index);
        return false;
    }
    if(object.parentObject != s_NameNone){
        if(parentIsSkeleton)
            return true;
        if(parentExists)
            error("Model::validatePayload failed: static mesh object {} parent_object must reference a skeleton object", index);
        else
            error("Model::validatePayload failed: static mesh object {} targets a missing skeleton object parent", index);
        return false;
    }
    return true;
}

b8 ValidateModelSkinnedMeshObject(
    in ModelSkinnedMeshObject object,
    in usize index,
    in b8 nameIsUnique,
    in b8 targetIsSkeleton
){
    if(!IsFiniteSkeletonJointMatrix(MatrixSingle(object.transform))){
        error("Model::validatePayload failed: skinned mesh object {} has non-finite transform", index);
        return false;
    }
    if(!IsCompleteModelSkinnedMeshObject(object)){
        error("Model::validatePayload failed: skinned mesh object {} is incomplete", index);
        return false;
    }
    if(!IsValidOptionalModelMaterialRef(object.material)){
        error("Model::validatePayload failed: skinned mesh object {} has invalid material reference", index);
        return false;
    }
    if(!nameIsUnique){
        error("Model::validatePayload failed: skinned mesh object {} name is duplicated in the model", index);
        return false;
    }
    if(!targetIsSkeleton){
        error("Model::validatePayload failed: skinned mesh object {} targets a missing skeleton object", index);
        return false;
    }
    return true;
}


