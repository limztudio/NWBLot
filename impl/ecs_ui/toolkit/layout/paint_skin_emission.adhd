#include "paint_emission.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void EmitPaintSkinQuadWithTransform(
    in b8 recording,
    in PaintClipEntry clip,
    in Rect rectangle,
    in Rect uv,
    in Color tint,
    in b8 hasTransform,
    in PaintTransform2D xf,
    in b8 axisAlignedPositive,
    in u32 layer,
    mut Vector<Vertex> vertices,
    mut Vector<u32> indices,
    mut Vector<DrawCommand> commands,
    mut b8 inOutCommandsOrdered,
    mut b8 inOutCommandsStrictlyDescending
){
    if(!hasTransform){
        EmitPaintQuadValidated(
            recording, clip, rectangle, uv, tint, PaintMaterial::Skin, layer,
            u32.max, u32.max, 0u, u32.max, u32.max,
            vertices, indices, commands, inOutCommandsOrdered, inOutCommandsStrictlyDescending
        );
        return;
    }
    if(!(rectangle.width > 0.0f) || !(rectangle.height > 0.0f) || !IsFinite(VectorSingle(rectangle.x + rectangle.width, rectangle.y + rectangle.height, 0.0f, 0.0f).xy))
        return;
    if(axisAlignedPositive){
        EmitPaintQuadValidated(
            recording, clip, ScaleAxisAlignedPaintRect(xf, rectangle), uv, tint, PaintMaterial::Skin, layer,
            u32.max, u32.max, 0u, u32.max, u32.max,
            vertices, indices, commands, inOutCommandsOrdered, inOutCommandsStrictlyDescending
        );
        return;
    }
    Point p00 = Point();
    Point p10 = Point();
    Point p11 = Point();
    Point p01 = Point();
    TransformPaintRectQuad(xf, rectangle, p00, p10, p11, p01);
    EmitPaintTransformedQuad(
        recording, clip, p00, p10, p11, p01, uv, tint, PaintMaterial::Skin, layer,
        u32.max, u32.max, 0u, u32.max, u32.max,
        vertices, indices, commands, inOutCommandsOrdered, inOutCommandsStrictlyDescending
    );
}

void EmitPaintNineSliceCore(
    in b8 recording,
    in PaintClipEntry clip,
    in UiSkinRegion region,
    in Rect rectangle,
    in Color tint,
    in u32 atlasWidth,
    in u32 atlasHeight,
    in f32 referenceDensity,
    in b8 hasTransform,
    in PaintTransform2D xf,
    in b8 axisAlignedPositive,
    in u32 layer,
    mut Vector<Vertex> vertices,
    mut Vector<u32> indices,
    mut Vector<DrawCommand> commands,
    mut b8 inOutCommandsOrdered,
    mut b8 inOutCommandsStrictlyDescending
){
    if(!HasUiRectArea(rectangle))
        return;
    if(!recording){
        ReportPaintQuadRecordingOff();
        return;
    }
    if(!IsFinite(VectorSingle(tint.r, tint.g, tint.b, tint.a)) || tint.a < 0.0f || tint.a > 1.0f){
        ReportPaintQuadInvalidColor();
        return;
    }
    if(tint.a <= 0.0f || !(clip.rect.width > 0.0f) || !(clip.rect.height > 0.0f) || !IsFinite(VectorSingle(clip.right, clip.bottom, 0.0f, 0.0f).xy))
        return;

    VectorSingle xVec(0.0f);
    VectorSingle yVec(0.0f);
    VectorSingle uVec(0.0f);
    VectorSingle vVec(0.0f);
    ResolveNineSliceCoordinates(region.rectangle, region.sliceInsets, rectangle, referenceDensity, xVec, yVec, uVec, vVec);

    const VectorSingle uNormVec = uVec / VectorSingle(cast<f32>(atlasWidth));
    const VectorSingle vNormVec = vVec / VectorSingle(cast<f32>(atlasHeight));
    Array<f32, 4u> u;
    u[0u] = uNormVec.x;
    u[1u] = uNormVec.y;
    u[2u] = uNormVec.z;
    u[3u] = uNormVec.w;
    Array<f32, 4u> v;
    v[0u] = vNormVec.x;
    v[1u] = vNormVec.y;
    v[2u] = vNormVec.z;
    v[3u] = vNormVec.w;

    const Color premultiplied = PremultiplyPaintColor(tint);

    if(!hasTransform || axisAlignedPositive){
        if(hasTransform){
            xVec = xVec * VectorSingle(xf.m00) + VectorSingle(xf.tx);
            yVec = yVec * VectorSingle(xf.m11) + VectorSingle(xf.ty);
        }
        if(
            !IsFinite(xVec)
            || !IsFinite(yVec)
            || xVec.w <= xVec.x
            || yVec.w <= yVec.x
            || xVec.w <= clip.rect.x
            || yVec.w <= clip.rect.y
            || xVec.x >= clip.right
            || yVec.x >= clip.bottom
        )
            return;

        Array<f32, 4u> x;
        x[0u] = xVec.x;
        x[1u] = xVec.y;
        x[2u] = xVec.z;
        x[3u] = xVec.w;
        Array<f32, 4u> y;
        y[0u] = yVec.x;
        y[1u] = yVec.y;
        y[2u] = yVec.z;
        y[3u] = yVec.w;

        Array<f32, 3u> cx0;
        Array<f32, 3u> cx1;
        Array<f32, 3u> uLeft;
        Array<f32, 3u> uRight;
        u32 activeColCount = 0u;
        for(u32 col = 0u; col < s_PaintNineSliceAxisCells; ++col){
            const usize c = cast<usize>(col);
            const f32 rx0 = x[c];
            const f32 rx1 = x[c + 1u];
            const f32 rw = rx1 - rx0;
            if(!(rw > 0.0f) || rx1 <= clip.rect.x || rx0 >= clip.right)
                continue;
            f32 clipX0 = rx0;
            if(clip.rect.x > clipX0)
                clipX0 = clip.rect.x;
            f32 clipX1 = rx1;
            if(clip.right < clipX1)
                clipX1 = clip.right;
            const f32 visW = clipX1 - clipX0;
            const f32 visEndX = clipX0 + visW;
            if(!(visW > 0.0f) || !IsFinite(VectorSingle(visW, visEndX, 0.0f, 0.0f).xy))
                continue;
            const f32 baseU0 = u[c];
            const f32 baseU1 = u[c + 1u];
            f32 l = baseU0;
            f32 r = baseU1;
            if(clipX0 != rx0 || visW != rw || visEndX != rx1){
                const f32 du = baseU1 - baseU0;
                l = ((clipX0 - rx0) / rw) * du + baseU0;
                r = ((visEndX - rx0) / rw) * du + baseU0;
            }
            const usize outIdx = cast<usize>(activeColCount);
            cx0[outIdx] = clipX0;
            cx1[outIdx] = visEndX;
            uLeft[outIdx] = l;
            uRight[outIdx] = r;
            ++activeColCount;
        }
        if(activeColCount == 0u)
            return;

        Array<f32, 3u> cy0;
        Array<f32, 3u> cy1;
        Array<f32, 3u> vTop;
        Array<f32, 3u> vBottom;
        u32 activeRowCount = 0u;
        for(u32 row = 0u; row < s_PaintNineSliceAxisCells; ++row){
            const usize r = cast<usize>(row);
            const f32 ry0 = y[r];
            const f32 ry1 = y[r + 1u];
            const f32 rh = ry1 - ry0;
            if(!(rh > 0.0f) || ry1 <= clip.rect.y || ry0 >= clip.bottom)
                continue;
            f32 clipY0 = ry0;
            if(clip.rect.y > clipY0)
                clipY0 = clip.rect.y;
            f32 clipY1 = ry1;
            if(clip.bottom < clipY1)
                clipY1 = clip.bottom;
            const f32 visH = clipY1 - clipY0;
            const f32 visEndY = clipY0 + visH;
            if(!(visH > 0.0f) || !IsFinite(VectorSingle(visH, visEndY, 0.0f, 0.0f).xy))
                continue;
            const f32 baseV0 = v[r];
            const f32 baseV1 = v[r + 1u];
            f32 t = baseV0;
            f32 b = baseV1;
            if(clipY0 != ry0 || visH != rh || visEndY != ry1){
                const f32 dv = baseV1 - baseV0;
                t = ((clipY0 - ry0) / rh) * dv + baseV0;
                b = ((visEndY - ry0) / rh) * dv + baseV0;
            }
            const usize outIdx = cast<usize>(activeRowCount);
            cy0[outIdx] = clipY0;
            cy1[outIdx] = visEndY;
            vTop[outIdx] = t;
            vBottom[outIdx] = b;
            ++activeRowCount;
        }
        if(activeRowCount == 0u)
            return;

        const usize quadCount = cast<usize>(activeColCount * activeRowCount);
        const usize addedVertices = quadCount * cast<usize>(s_PaintQuadVertexCount);
        const usize addedIndices = quadCount * cast<usize>(s_PaintQuadIndexCount);
        if(vertices.size() > cast<usize>(u32.max) - addedVertices || indices.size() > cast<usize>(u32.max) - addedIndices){
            assert(false);
            return;
        }
        ReservePaintVectorGeometric(vertices.size() + addedVertices, vertices);
        ReservePaintVectorGeometric(indices.size() + addedIndices, indices);
        const u32 firstIndex = cast<u32>(indices.size());
        for(u32 ri = 0u; ri < activeRowCount; ++ri){
            const usize rowIdx = cast<usize>(ri);
            const f32 y0 = cy0[rowIdx];
            const f32 y1 = cy1[rowIdx];
            const f32 t = vTop[rowIdx];
            const f32 b = vBottom[rowIdx];
            for(u32 ci = 0u; ci < activeColCount; ++ci){
                const usize colIdx = cast<usize>(ci);
                const f32 x0 = cx0[colIdx];
                const f32 x1 = cx1[colIdx];
                const f32 l = uLeft[colIdx];
                const f32 r = uRight[colIdx];
                const u32 vertexBase = cast<u32>(vertices.size());
                vertices.push_back(Vertex(Point(x0, y0), Point(l, t), premultiplied));
                vertices.push_back(Vertex(Point(x1, y0), Point(r, t), premultiplied));
                vertices.push_back(Vertex(Point(x1, y1), Point(r, b), premultiplied));
                vertices.push_back(Vertex(Point(x0, y1), Point(l, b), premultiplied));
                indices.push_back(vertexBase);
                indices.push_back(vertexBase + 1u);
                indices.push_back(vertexBase + 2u);
                indices.push_back(vertexBase);
                indices.push_back(vertexBase + 2u);
                indices.push_back(vertexBase + 3u);
            }
        }
        AppendPaintCommand(
            clip, firstIndex, cast<u32>(addedIndices), layer, PaintMaterial::Skin,
            u32.max, u32.max, 0u, u32.max, u32.max,
            commands, inOutCommandsOrdered, inOutCommandsStrictlyDescending
        );
        return;
    }

    Array<f32, 4u> x;
    x[0u] = xVec.x;
    x[1u] = xVec.y;
    x[2u] = xVec.z;
    x[3u] = xVec.w;
    Array<f32, 4u> y;
    y[0u] = yVec.x;
    y[1u] = yVec.y;
    y[2u] = yVec.z;
    y[3u] = yVec.w;

    const Point c00 = ApplyPaintTransform(xf, Point(x[0u], y[0u]));
    const Point c10 = ApplyPaintTransform(xf, Point(x[3u], y[0u]));
    const Point c11 = ApplyPaintTransform(xf, Point(x[3u], y[3u]));
    const Point c01 = ApplyPaintTransform(xf, Point(x[0u], y[3u]));
    if(!IntersectsPaintClipQuadBounds(clip, c00, c10, c11, c01))
        return;

    Array<Point, 16u> gridPts;
    for(usize r = 0u; r < 4u; ++r){
        for(usize c = 0u; c < 4u; ++c)
            gridPts[r * 4u + c] = ApplyPaintTransform(xf, Point(x[c], y[r]));
    }

    Array<usize, 9u> emitRows;
    Array<usize, 9u> emitCols;
    usize emitCount = 0u;
    for(usize r = 0u; r < 3u; ++r){
        if(!(y[r + 1u] > y[r]) || !IsFinite(VectorSingle(y[r + 1u])))
            continue;
        for(usize c = 0u; c < 3u; ++c){
            if(!(x[c + 1u] > x[c]) || !IsFinite(VectorSingle(x[c + 1u])))
                continue;
            in Point p00 = gridPts[r * 4u + c];
            in Point p10 = gridPts[r * 4u + c + 1u];
            in Point p11 = gridPts[(r + 1u) * 4u + c + 1u];
            in Point p01 = gridPts[(r + 1u) * 4u + c];
            if(!IntersectsPaintClipQuadBounds(clip, p00, p10, p11, p01))
                continue;
            emitRows[emitCount] = r;
            emitCols[emitCount] = c;
            ++emitCount;
        }
    }
    if(emitCount == 0u)
        return;

    const usize addedVertices = emitCount * cast<usize>(s_PaintQuadVertexCount);
    const usize addedIndices = emitCount * cast<usize>(s_PaintQuadIndexCount);
    if(vertices.size() > cast<usize>(u32.max) - addedVertices || indices.size() > cast<usize>(u32.max) - addedIndices){
        assert(false);
        return;
    }
    ReservePaintVectorGeometric(vertices.size() + addedVertices, vertices);
    ReservePaintVectorGeometric(indices.size() + addedIndices, indices);
    const u32 firstIndex = cast<u32>(indices.size());
    for(usize qi = 0u; qi < emitCount; ++qi){
        const usize r = emitRows[qi];
        const usize c = emitCols[qi];
        in Point p00 = gridPts[r * 4u + c];
        in Point p10 = gridPts[r * 4u + c + 1u];
        in Point p11 = gridPts[(r + 1u) * 4u + c + 1u];
        in Point p01 = gridPts[(r + 1u) * 4u + c];
        const f32 u0 = u[c];
        const f32 u1 = u[c + 1u];
        const f32 v0 = v[r];
        const f32 v1 = v[r + 1u];
        const u32 vertexBase = cast<u32>(vertices.size());
        vertices.push_back(Vertex(p00, Point(u0, v0), premultiplied));
        vertices.push_back(Vertex(p10, Point(u1, v0), premultiplied));
        vertices.push_back(Vertex(p11, Point(u1, v1), premultiplied));
        vertices.push_back(Vertex(p01, Point(u0, v1), premultiplied));
        indices.push_back(vertexBase);
        indices.push_back(vertexBase + 1u);
        indices.push_back(vertexBase + 2u);
        indices.push_back(vertexBase);
        indices.push_back(vertexBase + 2u);
        indices.push_back(vertexBase + 3u);
    }
    AppendPaintCommand(
        clip, firstIndex, cast<u32>(addedIndices), layer, PaintMaterial::Skin,
        u32.max, u32.max, 0u, u32.max, u32.max,
        commands, inOutCommandsOrdered, inOutCommandsStrictlyDescending
    );
}

void EmitPaintSkinRegionCore(
    in b8 recording,
    in PaintClipEntry clip,
    in UiSkinRegion region,
    in Rect rectangle,
    in Color tint,
    in u32 atlasWidth,
    in u32 atlasHeight,
    in f32 referenceDensity,
    in b8 hasTransform,
    in PaintTransform2D xf,
    in b8 axisAlignedPositive,
    in u32 layer,
    mut Vector<Vertex> vertices,
    mut Vector<u32> indices,
    mut Vector<DrawCommand> commands,
    mut b8 inOutCommandsOrdered,
    mut b8 inOutCommandsStrictlyDescending
){
    if(region.drawMode == UiSkinDrawMode::NineSlice){
        EmitPaintNineSliceCore(
            recording,
            clip,
            region,
            rectangle,
            tint,
            atlasWidth,
            atlasHeight,
            referenceDensity,
            hasTransform,
            xf,
            axisAlignedPositive,
            layer,
            vertices,
            indices,
            commands,
            inOutCommandsOrdered,
            inOutCommandsStrictlyDescending
        );
    }
    else{
        const Rect uv = ResolveSkinRegionUv(region.rectangle, atlasWidth, atlasHeight);
        EmitPaintSkinQuadWithTransform(
            recording,
            clip,
            rectangle,
            uv,
            tint,
            hasTransform,
            xf,
            axisAlignedPositive,
            layer,
            vertices,
            indices,
            commands,
            inOutCommandsOrdered,
            inOutCommandsStrictlyDescending
        );
    }
}

void EmitPaintSkinRegionSubRectCore(
    in b8 recording,
    in PaintClipEntry clip,
    in UiSkinRegion region,
    in Rect rectangle,
    in Rect uvSubRect,
    in Color tint,
    in u32 atlasWidth,
    in u32 atlasHeight,
    in b8 hasTransform,
    in PaintTransform2D xf,
    in b8 axisAlignedPositive,
    in u32 layer,
    mut Vector<Vertex> vertices,
    mut Vector<u32> indices,
    mut Vector<DrawCommand> commands,
    mut b8 inOutCommandsOrdered,
    mut b8 inOutCommandsStrictlyDescending
){
    const Rect baseUv = ResolveSkinRegionUv(region.rectangle, atlasWidth, atlasHeight);
    const VectorSingle baseExtent(baseUv.width, baseUv.height, baseUv.width, baseUv.height);
    const VectorSingle subVec(uvSubRect.x, uvSubRect.y, uvSubRect.width, uvSubRect.height);
    const VectorSingle composed = VectorSingle(baseUv.x, baseUv.y, 0.0f, 0.0f) + (baseExtent * subVec);
    const Rect composedUv(composed.x, composed.y, composed.z, composed.w);
    EmitPaintSkinQuadWithTransform(
        recording,
        clip,
        rectangle,
        composedUv,
        tint,
        hasTransform,
        xf,
        axisAlignedPositive,
        layer,
        vertices,
        indices,
        commands,
        inOutCommandsOrdered,
        inOutCommandsStrictlyDescending
    );
}

u64 MakePaintCommandSortKey(in DrawCommand command){
    return (cast<u64>(command.layer) << 32u) | cast<u64>(command.zOrder);
}

b8 IsPaintDrawCommandBefore(in DrawCommand lhs, in DrawCommand rhs){
    if(lhs.layer != rhs.layer)
        return lhs.layer < rhs.layer;
    if(lhs.zOrder != rhs.zOrder)
        return lhs.zOrder < rhs.zOrder;
    return lhs.firstIndex < rhs.firstIndex;
}

b8 IsValidPaintImageDrawRequest(in Rect rectangle, in Rect uv, in Color tint){
    return IsValidUiRect(rectangle)
        && IsValidPaintUvRect(uv)
        && IsValidPaintColor(tint);
}

b8 IsPaintImageInvisible(in Rect rectangle, in Rect clip, in Color tint){
    return !HasUiRectArea(rectangle)
        || !HasUiRectArea(clip)
        || tint.a == 0.0f
        || !HasVisibleUiRectIntersection(rectangle, clip);
}

void RefreshPaintBuilderSkinRegions(
    in Span<UiSkinRegion> skinRegions,
    mut Vector<UiSkinRegion> outRegions,
    mut HashMap<Name, usize> outRegionLookup
){
    outRegions.clear();
    outRegions.reserve(skinRegions.size());
    outRegionLookup.clear();
    outRegionLookup.reserve(skinRegions.size());
    for(usize index = 0u; index < skinRegions.size(); ++index){
        outRegions.push_back(skinRegions[index]);
        outRegionLookup.try_emplace(skinRegions[index].name, index);
    }
}

void BeginPaintBuilderRecordingCached(
    in DisplayMetrics metrics,
    mut Vector<Vertex> outVertices,
    mut Vector<u32> outIndices,
    mut Vector<DrawCommand> outCommands,
    mut Vector<PaintClipEntry> outClips,
    mut usize outOverlayDepth,
    mut u32 outLayer,
    mut b8 outZOrderActive,
    mut u32 outZOrder,
    mut usize outZOrderCommandStart,
    mut b8 outCommandsOrdered,
    mut b8 outCommandsStrictlyDescending,
    mut b8 outRecording
){
    assert(IsFinite(VectorSingle(metrics.logicalWidth, metrics.logicalHeight, metrics.pixelScaleX, metrics.pixelScaleY)));
    assert(metrics.logicalWidth >= 0.0f && metrics.logicalHeight >= 0.0f && metrics.pixelScaleX > 0.0f && metrics.pixelScaleY > 0.0f);
    outVertices.clear();
    outIndices.clear();
    outCommands.clear();
    outClips.clear();
    PaintClipEntry rootClip;
    rootClip.rect = Rect(0.0f, 0.0f, metrics.logicalWidth, metrics.logicalHeight);
    rootClip.right = metrics.logicalWidth;
    rootClip.bottom = metrics.logicalHeight;
    outClips.push_back(rootClip);
    outOverlayDepth = 0u;
    outLayer = 0u;
    outZOrderActive = false;
    outZOrder = 0u;
    outZOrderCommandStart = 0u;
    outCommandsOrdered = true;
    outCommandsStrictlyDescending = true;
    outRecording = true;
}

void RadixSortPaintCommands(mut Vector<DrawCommand> inOutCommands, in u64 orDiff, mut Vector<DrawCommand> scratch){
    const usize count = inOutCommands.size();
    scratch.resize(count);
    b8 inScratch = false;
    const u64 mask = 0xffu;
    for(u32 shift = 0u; shift < 64u; shift += 8u){
        if(((orDiff >> shift) & mask) == 0u)
            continue;
        Array<u32, 256u> counts;
        for(usize bucket = 0u; bucket < 256u; ++bucket)
            counts[bucket] = 0u;
        if(!inScratch){
            for(usize index = 0u; index < count; ++index)
                ++counts[cast<usize>((MakePaintCommandSortKey(inOutCommands[index]) >> shift) & mask)];
        }
        else{
            for(usize index = 0u; index < count; ++index)
                ++counts[cast<usize>((MakePaintCommandSortKey(scratch[index]) >> shift) & mask)];
        }
        u32 offset = 0u;
        for(usize bucket = 0u; bucket < 256u; ++bucket){
            const u32 bucketCount = counts[bucket];
            counts[bucket] = offset;
            offset += bucketCount;
        }
        if(!inScratch){
            for(usize index = 0u; index < count; ++index){
                in DrawCommand command = inOutCommands[index];
                const usize bucket = cast<usize>((MakePaintCommandSortKey(command) >> shift) & mask);
                scratch[cast<usize>(counts[bucket])] = command;
                ++counts[bucket];
            }
        }
        else{
            for(usize index = 0u; index < count; ++index){
                in DrawCommand command = scratch[index];
                const usize bucket = cast<usize>((MakePaintCommandSortKey(command) >> shift) & mask);
                inOutCommands[cast<usize>(counts[bucket])] = command;
                ++counts[bucket];
            }
        }
        inScratch = !inScratch;
    }
    if(inScratch)
        AssignTriviallyCopyableVector(inOutCommands, Span<DrawCommand>(scratch));
}

void FinalizePaintBuilderRecording(
    in b8 commandsOrdered,
    in b8 commandsStrictlyDescending,
    in usize overlayDepth,
    in b8 zOrderActive,
    mut Vector<DrawCommand> inOutCommands,
    mut Vector<PaintClipEntry> inOutClips,
    mut Vector<DrawCommand> sortScratch,
    mut b8 inOutRecording
){
    [essential] assert(inOutRecording && inOutClips.size() == 1u && overlayDepth == 0u && !zOrderActive);
    const usize count = inOutCommands.size();
    if(!commandsOrdered && count > 1u){
        if(commandsStrictlyDescending){
            const usize half = count / 2u;
            for(usize index = 0u; index < half; ++index){
                const DrawCommand temp = inOutCommands[index];
                inOutCommands[index] = inOutCommands[count - 1u - index];
                inOutCommands[count - 1u - index] = temp;
            }
        }
        else{
            b8 firstIndexMonotonic = true;
            u64 orDiff = 0u;
            const u64 firstKey = MakePaintCommandSortKey(inOutCommands[0u]);
            for(usize index = 1u; index < count; ++index){
                in DrawCommand prev = inOutCommands[index - 1u];
                in DrawCommand cur = inOutCommands[index];
                if(!(prev.firstIndex < cur.firstIndex))
                    firstIndexMonotonic = false;
                orDiff |= (MakePaintCommandSortKey(cur) ^ firstKey);
            }
            if(orDiff != 0u){
                if(count <= 32u || !firstIndexMonotonic)
                    SortSequence<DrawCommand>(inOutCommands, IsPaintDrawCommandBefore);
                else
                    RadixSortPaintCommands(inOutCommands, orDiff, sortScratch);
            }
        }
    }
    inOutRecording = false;
    inOutClips.clear();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

