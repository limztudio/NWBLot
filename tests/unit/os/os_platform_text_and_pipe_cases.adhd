void VerifyWaylandTextInputState_ShortUtf8ReverseSelectionRetainsScalarByteEndpoints(){
    const StringView text = "A\xED\x95\x9C\xF0\x9F\x98\x80Z";
    const WaylandTextInputSurrounding slice = SliceWaylandTextInputSurrounding(text, 8u, 1u);
    ASSERT_TRUE(slice.available);
    EXPECT_EQ(slice.text, text);
    EXPECT_EQ(slice.offsetByte, 0u);
    EXPECT_EQ(slice.anchorByte, 8u);
    EXPECT_EQ(slice.caretByte, 1u);
}

void VerifyWaylandTextInputState_LongSurroundingClipsWithoutSplittingUnicode(){
    WaylandStateContext ctx = WaylandStateContext();
    for(usize index = 0u; index < 3000u; ++index){
        AppendGlobalString(ctx.scratch, "\xED\x95\x9C");
    }
    const WaylandTextInputSurrounding slice = SliceWaylandTextInputSurrounding(ViewGlobalString(ctx.scratch), 4500u, 4503u);
    ASSERT_TRUE(slice.available);
    EXPECT_LE(slice.text.size(), 4000u);
    EXPECT_EQ(ValidateTextInputUtf8(slice.text, 4000u), TextInputAdmission::Accepted);
    EXPECT_EQ(slice.offsetByte + slice.anchorByte, 4500u);
    EXPECT_EQ(slice.offsetByte + slice.caretByte, 4503u);
    EXPECT_TRUE(IsUtf8ScalarBoundary(slice.text, slice.anchorByte));
    EXPECT_TRUE(IsUtf8ScalarBoundary(slice.text, slice.caretByte));
}

void VerifyWaylandTextInputState_SelectionMustFitNativeMessageAndContainByteBoundaries(){
    WaylandStateContext ctx = WaylandStateContext();
    FillGlobalString(ctx.scratch, 5000u, 0x78u);
    EXPECT_FALSE(SliceWaylandTextInputSurrounding(ViewGlobalString(ctx.scratch), 0u, 4001u).available);
    EXPECT_FALSE(SliceWaylandTextInputSurrounding(ViewGlobalString(ctx.scratch), 5001u, 1u).available);
    EXPECT_FALSE(SliceWaylandTextInputSurrounding("\xED\x95\x9C", 1u, 3u).available);
    const WaylandTextInputSurrounding exact = SliceWaylandTextInputSurrounding(ViewGlobalString(ctx.scratch), 500u, 4500u);
    ASSERT_TRUE(exact.available);
    EXPECT_EQ(exact.text.size(), 4000u);
    EXPECT_EQ(exact.anchorByte, 0u);
    EXPECT_EQ(exact.caretByte, 4000u);
}

void VerifyWaylandTextInputState_EdgeCursorSlicesUseAvailableContext(){
    WaylandStateContext ctx = WaylandStateContext();
    FillGlobalString(ctx.scratch, 9000u, 0x78u);
    const WaylandTextInputSurrounding first = SliceWaylandTextInputSurrounding(ViewGlobalString(ctx.scratch), 0u, 0u);
    ASSERT_TRUE(first.available);
    EXPECT_EQ(first.text.size(), 4000u);
    EXPECT_EQ(first.offsetByte, 0u);
    const WaylandTextInputSurrounding last = SliceWaylandTextInputSurrounding(ViewGlobalString(ctx.scratch), 9000u, 9000u);
    ASSERT_TRUE(last.available);
    EXPECT_EQ(last.text.size(), 4000u);
    EXPECT_EQ(last.offsetByte, 5000u);
    EXPECT_EQ(last.caretByte, 4000u);
}

void VerifyWaylandTextInputState_UnavailableSurroundingNeverRetagsOldNativeSnapshot(){
    WaylandStateContext ctx = WaylandStateContext();
    const TextInputSessionToken token = MakeSessionToken(7u, 8u);
    ASSERT_TRUE(ctx.wire.update("old", 1u, 1u, 1u).available);
    ctx.tracker.record(1u, token, ctx.wire.revision());
    FillGlobalString(ctx.scratch, 5000u, 0x78u);
    EXPECT_FALSE(ctx.wire.update(ViewGlobalString(ctx.scratch), 0u, 5000u, 2u).available);
    EXPECT_EQ(ctx.wire.revision(), 1u);
    ctx.tracker.record(2u, token, ctx.wire.revision());
    EXPECT_EQ(ctx.tracker.resolve(2u, token).revision, 1u);
    ASSERT_TRUE(ctx.wire.update("new", 3u, 3u, 3u).available);
    ctx.tracker.record(3u, token, ctx.wire.revision());
    EXPECT_EQ(ctx.tracker.resolve(3u, token).revision, 3u);
    ctx.wire.reset();
    EXPECT_FALSE(ctx.wire.update(ViewGlobalString(ctx.scratch), 0u, 5000u, 4u).available);
    ctx.tracker.record(4u, token, ctx.wire.revision());
    EXPECT_FALSE(ctx.tracker.resolve(4u, token).revisionKnown);
}

void VerifyWaylandTextInputState_NativeDeletionExcludesSelectionAndRequiresTheExactPublishedEndpoints(){
    WaylandStateContext ctx = WaylandStateContext();
    ASSERT_TRUE(ctx.wire.update("abcDEFghi", 3u, 6u, 7u).available);
    const WaylandTextInputProvenance known = MakeWaylandProvenance(MakeSessionToken(1u, 2u), 7u, true);
    EXPECT_TRUE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 3u, 6u, 2u, 1u));
    EXPECT_TRUE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 3u, 6u, 3u, 3u));
    EXPECT_TRUE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 3u, 6u, 0u, 0u));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 3u, 6u, 4u, 0u));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 3u, 6u, 0u, 4u));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 1u, 3u, 2u, 1u));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(known, 8u, ctx.wire, 3u, 6u, 2u, 1u));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(MakeWaylandProvenance(MakeSessionToken(1u, 2u), 0u, false), 7u, ctx.wire, 3u, 6u, 2u, 1u));
    ASSERT_TRUE(ctx.wire.update("abcDEFghi", 6u, 3u, 8u).available);
    const WaylandTextInputProvenance reverse = MakeWaylandProvenance(MakeSessionToken(1u, 2u), 8u, true);
    EXPECT_TRUE(CanApplyWaylandTextInputDeletion(reverse, 8u, ctx.wire, 6u, 3u, 2u, 1u));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(reverse, 8u, ctx.wire, 3u, 6u, 2u, 1u));
}

void VerifyWaylandTextInputState_DeletionCannotReachBeyondTheSentSliceEvenWhenTheFullTextContainsThoseBytes(){
    WaylandStateContext ctx = WaylandStateContext();
    FillGlobalString(ctx.scratch, 9000u, 0x78u);
    const WaylandTextInputSurrounding sent = ctx.wire.update(ViewGlobalString(ctx.scratch), 4500u, 4503u, 7u);
    ASSERT_TRUE(sent.available);
    ASSERT_GT(sent.offsetByte, 0u);
    const usize before = Min(sent.anchorByte, sent.caretByte);
    const usize after = sent.text.size() - Max(sent.anchorByte, sent.caretByte);
    ASSERT_LT(before + 1u, 4500u);
    ASSERT_LT(after + 1u, ctx.scratch.size() - 4503u);
    const WaylandTextInputProvenance known = MakeWaylandProvenance(MakeSessionToken(1u, 2u), 7u, true);
    EXPECT_TRUE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 4500u, 4503u, before, after));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 4500u, 4503u, before + 1u, after));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 4500u, 4503u, before, after + 1u));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 4500u, 4503u, usize.max, 0u));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 4500u, 4503u, 0u, usize.max));
}

void VerifyWaylandTextInputState_WireSelectionEndpointsMustMatchDirectionOffsetAndCurrentPositions(){
    WaylandStateContext ctx = WaylandStateContext();
    FillGlobalString(ctx.scratch, 9000u, 0x78u);
    ASSERT_TRUE(ctx.wire.update(ViewGlobalString(ctx.scratch), 4500u, 4503u, 7u).available);
    const WaylandTextInputProvenance known = MakeWaylandProvenance(MakeSessionToken(1u, 2u), 7u, true);
    EXPECT_TRUE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 4500u, 4503u, 2u, 1u));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 4501u, 4503u, 2u, 1u));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 4500u, 4504u, 2u, 1u));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 4503u, 4500u, 2u, 1u));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 0u, 4503u, 0u, 0u));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 4500u, 0u, 0u, 0u));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, usize.max, 4503u, 0u, 0u));
}

void VerifyWaylandTextInputState_WireEdgeCursorsAndASelectionFillingTheMessageHaveExactOuterLimits(){
    WaylandStateContext ctx = WaylandStateContext();
    FillGlobalString(ctx.scratch, 9000u, 0x78u);
    const WaylandTextInputProvenance known = MakeWaylandProvenance(MakeSessionToken(1u, 2u), 7u, true);
    ASSERT_TRUE(ctx.wire.update(ViewGlobalString(ctx.scratch), 0u, 0u, 7u).available);
    EXPECT_TRUE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 0u, 0u, 0u, 4000u));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 0u, 0u, 1u, 0u));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 0u, 0u, 0u, 4001u));
    ASSERT_TRUE(ctx.wire.update(ViewGlobalString(ctx.scratch), 9000u, 9000u, 7u).available);
    EXPECT_TRUE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 9000u, 9000u, 4000u, 0u));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 9000u, 9000u, 4001u, 0u));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 9000u, 9000u, 0u, 1u));
    ASSERT_TRUE(ctx.wire.update(ViewGlobalString(ctx.scratch), 500u, 4500u, 7u).available);
    EXPECT_TRUE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 500u, 4500u, 0u, 0u));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 500u, 4500u, 1u, 0u));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 500u, 4500u, 0u, 1u));
}

void VerifyWaylandTextInputState_UnavailableReplacementPreservesEveryPreviouslySentNumericBound(){
    WaylandStateContext ctx = WaylandStateContext();
    FillGlobalString(ctx.scratch, 9000u, 0x78u);
    const WaylandTextInputSurrounding sent = ctx.wire.update(ViewGlobalString(ctx.scratch), 4500u, 4503u, 7u);
    ASSERT_TRUE(sent.available);
    const usize before = Min(sent.anchorByte, sent.caretByte);
    const usize after = sent.text.size() - Max(sent.anchorByte, sent.caretByte);
    const WaylandTextInputProvenance known = MakeWaylandProvenance(MakeSessionToken(1u, 2u), 7u, true);
    EXPECT_FALSE(ctx.wire.update(ViewGlobalString(ctx.scratch), 0u, 5000u, 8u).available);
    EXPECT_EQ(ctx.wire.revision(), 7u);
    EXPECT_TRUE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 4500u, 4503u, before, after));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 4500u, 4503u, before + 1u, after));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(known, 8u, ctx.wire, 4500u, 4503u, 0u, 0u));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(MakeWaylandProvenance(MakeSessionToken(1u, 2u), 8u, true), 8u, ctx.wire, 4500u, 4503u, 0u, 0u));
    ctx.wire.reset();
    EXPECT_EQ(ctx.wire.revision(), 0u);
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 4500u, 4503u, 0u, 0u));
    EXPECT_FALSE(ctx.wire.update(ViewGlobalString(ctx.scratch), 0u, 5000u, 9u).available);
    EXPECT_EQ(ctx.wire.revision(), 0u);
}

void VerifyWaylandTextInputState_WireBoundsOwnNoViewOfTheCallerText(){
    WaylandStateContext ctx = WaylandStateContext();
    FillGlobalString(ctx.scratch, 9000u, 0x78u);
    const WaylandTextInputSurrounding sent = ctx.wire.update(ViewGlobalString(ctx.scratch), 4500u, 4503u, 7u);
    ASSERT_TRUE(sent.available);
    const usize before = Min(sent.anchorByte, sent.caretByte);
    const usize after = sent.text.size() - Max(sent.anchorByte, sent.caretByte);
    ClearAndShrinkGlobalString(ctx.scratch);
    const WaylandTextInputProvenance known = MakeWaylandProvenance(MakeSessionToken(1u, 2u), 7u, true);
    EXPECT_TRUE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 4500u, 4503u, before, after));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 4500u, 4503u, before + 1u, after));
}

void VerifyWaylandTextInputState_EmptyOrResetWireStillRequiresKnownNonzeroSnapshotProvenance(){
    WaylandStateContext ctx = WaylandStateContext();
    const WaylandTextInputProvenance known = MakeWaylandProvenance(MakeSessionToken(1u, 2u), 7u, true);
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 0u, 0u, 0u, 0u));
    ASSERT_TRUE(ctx.wire.update(StringView(), 0u, 0u, 7u).available);
    EXPECT_TRUE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 0u, 0u, 0u, 0u));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 0u, 0u, 1u, 0u));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(known, 7u, ctx.wire, 0u, 0u, 0u, 1u));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(MakeWaylandProvenance(TextInputSessionToken(), 7u, true), 7u, ctx.wire, 0u, 0u, 0u, 0u));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(MakeWaylandProvenance(MakeSessionToken(1u, 2u), 7u, false), 7u, ctx.wire, 0u, 0u, 0u, 0u));
    ASSERT_TRUE(ctx.wire.update(StringView(), 0u, 0u, 0u).available);
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(MakeWaylandProvenance(MakeSessionToken(1u, 2u), 0u, true), 0u, ctx.wire, 0u, 0u, 0u, 0u));
}

void VerifyWaylandTextInputState_DeferredSurroundingChangesCannotRetagUnsentSliceOrCurrentSerials(){
    WaylandStateContext ctx = WaylandStateContext();
    const TextInputSessionToken token = MakeSessionToken(7u, 8u);
    ASSERT_TRUE(ctx.wire.update("abcDEFghi", 3u, 6u, 7u).available);
    ctx.tracker.record(42u, token, ctx.wire.revision());
    ctx.deferred.surroundingChanged(TextInputChangeCause::Other);
    ctx.deferred.caretChanged();
    ASSERT_TRUE(ctx.deferred.pending());
    const WaylandTextInputProvenance old = ctx.tracker.resolve(42u, token);
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(old, 8u, ctx.wire, 3u, 6u, 2u, 1u));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(MakeWaylandProvenance(token, 8u, true), 8u, ctx.wire, 3u, 6u, 2u, 1u));
    ctx.deferred.clear();
    ASSERT_TRUE(ctx.wire.update("aDEFhi", 1u, 4u, 8u).available);
    ctx.tracker.record(43u, token, ctx.wire.revision());
    EXPECT_TRUE(CanApplyWaylandTextInputDeletion(ctx.tracker.resolve(43u, token), 8u, ctx.wire, 1u, 4u, 1u, 2u));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(old, 8u, ctx.wire, 1u, 4u, 1u, 2u));
}

void VerifyWaylandTextInputState_DelayedSerialWithTheCurrentWireRevisionStillAdmitsDeletion(){
    WaylandStateContext ctx = WaylandStateContext();
    const TextInputSessionToken token = MakeSessionToken(7u, 8u);
    ASSERT_TRUE(ctx.wire.update("abcDEFghi", 3u, 6u, 7u).available);
    ctx.tracker.record(42u, token, ctx.wire.revision());
    ctx.tracker.record(43u, token, ctx.wire.revision());
    EXPECT_TRUE(CanApplyWaylandTextInputDeletion(ctx.tracker.resolve(42u, token), 7u, ctx.wire, 3u, 6u, 2u, 1u));
    EXPECT_TRUE(CanApplyWaylandTextInputDeletion(ctx.tracker.resolve(43u, token), 7u, ctx.wire, 3u, 6u, 2u, 1u));
}

void VerifyWaylandTextInputState_NegativeCaretEdgesRoundOutwardWithoutWideningExactEdges(){
    const TextInputRect exact = WaylandTextInputRectForPixels(MakeTextInputRect(-6, -8, 2, 4), 2);
    EXPECT_EQ(exact.x, -3);
    EXPECT_EQ(exact.y, -4);
    EXPECT_EQ(exact.width, 1);
    EXPECT_EQ(exact.height, 2);
    const TextInputRect crossed = WaylandTextInputRectForPixels(MakeTextInputRect(-3, -3, 4, 4), 2);
    EXPECT_EQ(crossed.x, -2);
    EXPECT_EQ(crossed.y, -2);
    EXPECT_EQ(crossed.width, 3);
    EXPECT_EQ(crossed.height, 3);
}

void VerifyWaylandTextInputState_PositiveOddPixelEdgesRoundOutwardAndZeroScaleUsesPixelBounds(){
    const TextInputRect scaled = WaylandTextInputRectForPixels(MakeTextInputRect(3, 5, 4, 4), 2);
    EXPECT_EQ(scaled.x, 1);
    EXPECT_EQ(scaled.y, 2);
    EXPECT_EQ(scaled.width, 3);
    EXPECT_EQ(scaled.height, 3);
    const TextInputRect unit = WaylandTextInputRectForPixels(MakeTextInputRect(-7, 5, 2, 3), 0);
    EXPECT_EQ(unit.x, -7);
    EXPECT_EQ(unit.y, 5);
    EXPECT_EQ(unit.width, 2);
    EXPECT_EQ(unit.height, 3);
}

void VerifyWaylandTextInputState_DeferredCaretPreservesLatestSurroundingChangeCause(){
    WaylandStateContext ctx = WaylandStateContext();
    ctx.deferred.surroundingChanged(TextInputChangeCause::InputMethod);
    ctx.deferred.caretChanged();
    EXPECT_TRUE(ctx.deferred.pending());
    EXPECT_EQ(ctx.deferred.cause(), TextInputChangeCause::InputMethod);
    ctx.deferred.surroundingChanged(TextInputChangeCause::Other);
    ctx.deferred.caretChanged();
    EXPECT_EQ(ctx.deferred.cause(), TextInputChangeCause::Other);
    ctx.deferred.surroundingChanged(TextInputChangeCause::InputMethod);
    EXPECT_EQ(ctx.deferred.cause(), TextInputChangeCause::InputMethod);
    ctx.deferred.clear();
    EXPECT_FALSE(ctx.deferred.pending());
    ctx.deferred.caretChanged();
    EXPECT_EQ(ctx.deferred.cause(), TextInputChangeCause::InputMethod);
}

void VerifyWaylandTextInputState_SerialTracksHistoricalCurrentSessionRevision(){
    WaylandStateContext ctx = WaylandStateContext();
    const TextInputSessionToken token = MakeSessionToken(7u, 9u);
    ctx.tracker.record(10u, token, 1u);
    ctx.tracker.record(11u, token, 2u);
    const WaylandTextInputProvenance old = ctx.tracker.resolve(10u, token);
    EXPECT_EQ(old.token, token);
    EXPECT_TRUE(old.revisionKnown);
    EXPECT_EQ(old.revision, 1u);
    EXPECT_EQ(ctx.tracker.resolve(11u, token).revision, 2u);
    EXPECT_FALSE(ctx.tracker.resolve(9u, token).token.valid());
    EXPECT_FALSE(ctx.tracker.resolve(12u, token).token.valid());
}

void VerifyWaylandTextInputState_NewSessionAndDisableFenceDelayedOldSerials(){
    WaylandStateContext ctx = WaylandStateContext();
    const TextInputSessionToken first = MakeSessionToken(1u, 1u);
    const TextInputSessionToken second = MakeSessionToken(1u, 2u);
    ctx.tracker.record(20u, first, 1u);
    ctx.tracker.record(22u, second, 1u);
    EXPECT_FALSE(ctx.tracker.resolve(20u, second).token.valid());
    EXPECT_FALSE(ctx.tracker.resolve(22u, first).token.valid());
    EXPECT_EQ(ctx.tracker.resolve(22u, second).token, second);
    ctx.tracker.record(23u, TextInputSessionToken(), 0u);
    EXPECT_FALSE(ctx.tracker.resolve(22u, second).token.valid());
}

void VerifyWaylandTextInputState_SerialWraparoundPreservesCurrentSessionInterval(){
    WaylandStateContext ctx = WaylandStateContext();
    const TextInputSessionToken token = MakeSessionToken(2u, 3u);
    ctx.tracker.record(0xFFFFFFFEu, token, 1u);
    ctx.tracker.record(0xFFFFFFFFu, token, 2u);
    ctx.tracker.record(0u, token, 3u);
    ctx.tracker.record(1u, token, 4u);
    EXPECT_EQ(ctx.tracker.resolve(0xFFFFFFFFu, token).revision, 2u);
    EXPECT_EQ(ctx.tracker.resolve(0u, token).revision, 3u);
    EXPECT_EQ(ctx.tracker.resolve(1u, token).revision, 4u);
    EXPECT_FALSE(ctx.tracker.resolve(0xFFFFFFFDu, token).token.valid());
    EXPECT_FALSE(ctx.tracker.resolve(2u, token).token.valid());
    ASSERT_TRUE(ctx.wire.update("abcDEFghi", 3u, 6u, 4u).available);
    EXPECT_TRUE(CanApplyWaylandTextInputDeletion(ctx.tracker.resolve(1u, token), 4u, ctx.wire, 3u, 6u, 2u, 1u));
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(ctx.tracker.resolve(0u, token), 4u, ctx.wire, 3u, 6u, 2u, 1u));
}

void VerifyWaylandTextInputState_RingEvictionStillAdmitsDelayedCommitButMarksDeletionRevisionUnknown(){
    WaylandStateContext ctx = WaylandStateContext();
    const TextInputSessionToken token = MakeSessionToken(3u, 5u);
    for(u32 serial = 100u; serial < 200u; ++serial){
        ctx.tracker.record(serial, token, cast<u64>(serial - 99u));
    }
    const WaylandTextInputProvenance old = ctx.tracker.resolve(100u, token);
    EXPECT_EQ(old.token, token);
    EXPECT_FALSE(old.revisionKnown);
    EXPECT_EQ(ctx.tracker.resolve(199u, token).revision, 100u);
    EXPECT_FALSE(ctx.tracker.resolve(99u, token).token.valid());
    ASSERT_TRUE(ctx.wire.update("abcDEFghi", 3u, 6u, 100u).available);
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(old, 100u, ctx.wire, 3u, 6u, 2u, 1u));
    EXPECT_TRUE(CanApplyWaylandTextInputDeletion(ctx.tracker.resolve(199u, token), 100u, ctx.wire, 3u, 6u, 2u, 1u));
    ctx.tracker.reset();
    EXPECT_FALSE(ctx.tracker.resolve(199u, token).token.valid());
    EXPECT_FALSE(CanApplyWaylandTextInputDeletion(ctx.tracker.resolve(199u, token), 100u, ctx.wire, 3u, 6u, 2u, 1u));
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

void VerifyWin32TextInputFixture_RepeatedExplicitContextReleasePreservesActiveNativeSession(mut Win32TextInputFixture self){
    native(mut self){
#if defined(NWB_PLATFORM_WINDOWS)
        const HIMC nativeContext = ImmGetContext(self.m_window);
        ASSERT_NE(nativeContext, nullptr);
        Win32TextInputContextGuard context(self.m_window, nativeContext);
        ASSERT_TRUE(context.release());
        ASSERT_TRUE(context.release());
        EXPECT_EQ(self.m_service->activeSession(), self.m_token);
        EXPECT_EQ(SendMessageW(self.m_window, WM_CHAR, 'R', 0), 0);
        TextInputEvent event(self.m_arena.arena);
        ASSERT_EQ(self.m_service->poll(self.m_token, event), TextInputPollResult::Event);
        EXPECT_EQ(event.text, "R");
#else
        (void)self;
#endif
    }
}

void VerifyWin32TextInputFixture_ContextScopeUnwindPreservesOriginalThrownMarkerAndNativeSession(mut Win32TextInputFixture self){
    native(mut self){
#if defined(NWB_PLATFORM_WINDOWS)
        struct UnwindMarker final{};
        b8 caughtOriginal = false;
        try{
            const HIMC nativeContext = ImmGetContext(self.m_window);
            ASSERT_NE(nativeContext, nullptr);
            Win32TextInputContextGuard context(self.m_window, nativeContext);
            throw UnwindMarker{};
        }
        catch(const UnwindMarker&){
            caughtOriginal = true;
        }
        EXPECT_TRUE(caughtOriginal);
        EXPECT_EQ(self.m_service->activeSession(), self.m_token);
        EXPECT_EQ(SendMessageW(self.m_window, WM_CHAR, 'U', 0), 0);
        TextInputEvent event(self.m_arena.arena);
        ASSERT_EQ(self.m_service->poll(self.m_token, event), TextInputPollResult::Event);
        EXPECT_EQ(event.text, "U");
#else
        (void)self;
#endif
    }
}

void VerifyWin32TextInputFixture_SurrogatePairRemainsPerServiceUntilComplete(mut Win32TextInputFixture self){
    native(mut self){
#if defined(NWB_PLATFORM_WINDOWS)
        EXPECT_EQ(SendMessageW(self.m_window, WM_CHAR, 0xd83du, 0), 0);
        TextInputEvent event(self.m_arena.arena);
        EXPECT_EQ(self.m_service->poll(self.m_token, event), TextInputPollResult::Pending);
        EXPECT_EQ(SendMessageW(self.m_window, WM_CHAR, 0xde00u, 0), 0);
        ASSERT_EQ(self.m_service->poll(self.m_token, event), TextInputPollResult::Event);
        EXPECT_EQ(event.text, "\xF0\x9F\x98\x80");
        EXPECT_EQ(self.m_service->poll(self.m_token, event), TextInputPollResult::Pending);
#else
        (void)self;
#endif
    }
}

void VerifyWin32TextInputFixture_AggregateCharacterCountsIgnoreHighFlagsAndKeepScalarBoundaries(mut Win32TextInputFixture self){
    native(mut self){
#if defined(NWB_PLATFORM_WINDOWS)
        EXPECT_EQ(SendMessageW(self.m_window, WM_CHAR, 'A', 0x40000003), 0);
        EXPECT_EQ(SendMessageW(self.m_window, WM_SYSCHAR, 0xd55cu, 0x20000002), 0);
        EXPECT_EQ(SendMessageW(self.m_window, WM_UNICHAR, 0x1f600u, 2), 0);
        EXPECT_EQ(SendMessageW(self.m_window, WM_CHAR, 0xd83du, 2), 0);
        EXPECT_EQ(SendMessageW(self.m_window, WM_CHAR, 0xde00u, 2), 0);
        TextInputEvent event(self.m_arena.arena);
        ASSERT_EQ(self.m_service->poll(self.m_token, event), TextInputPollResult::Event);
        EXPECT_EQ(event.text, "AAA");
        ASSERT_EQ(self.m_service->poll(self.m_token, event), TextInputPollResult::Event);
        EXPECT_EQ(event.text, "\xED\x95\x9C\xED\x95\x9C");
        for(usize index = 0u; index < 2u; ++index){
            ASSERT_EQ(self.m_service->poll(self.m_token, event), TextInputPollResult::Event);
            EXPECT_EQ(event.text, "\xF0\x9F\x98\x80\xF0\x9F\x98\x80");
        }
        EXPECT_EQ(self.m_service->poll(self.m_token, event), TextInputPollResult::Pending);
#else
        (void)self;
#endif
    }
}

void VerifyWin32TextInputFixture_MaximumAggregateSupplementaryCommitBatchesWithoutEventOverflow(mut Win32TextInputFixture self){
    native(mut self){
#if defined(NWB_PLATFORM_WINDOWS)
        EXPECT_EQ(SendMessageW(self.m_window, WM_UNICHAR, 0x1f600u, 0xffff), 0);
        ASSERT_EQ(self.m_service->activeSession(), self.m_token);
        TextInputEvent event(self.m_arena.arena);
        usize totalBytes = 0u;
        u64 sequence = 0u;
        while(totalBytes < 0xffffu * 4u){
            ASSERT_EQ(self.m_service->poll(self.m_token, event), TextInputPollResult::Event);
            ASSERT_EQ(event.kind, TextInputEventKind::Commit);
            ASSERT_FALSE(event.text.empty());
            EXPECT_LE(event.text.size(), s_TextInputMaxEventTextBytes);
            ASSERT_EQ(event.text.size() % 4u, 0u);
            EXPECT_GT(event.sequence, sequence);
            sequence = event.sequence;
            for(usize offset = 0u; offset < event.text.size(); offset += 4u)
                ASSERT_EQ(AStringView(event.text.data() + offset, 4u), "\xF0\x9F\x98\x80");
            totalBytes += event.text.size();
        }
        EXPECT_EQ(totalBytes, 0xffffu * 4u);
        EXPECT_EQ(self.m_service->poll(self.m_token, event), TextInputPollResult::Pending);
#else
        (void)self;
#endif
    }
}

