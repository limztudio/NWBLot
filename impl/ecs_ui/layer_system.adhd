const StringView s_UiLayerSystemOwnerName = "UiLayerSystem";
type UiGpuRenderer = GpuRenderer;
type UiLayerShaderPathResolveCallback = ShaderArchivePathResolver;
type UiInputKeyBinding = InputKeyBinding;
type UiPaintBuilder = PaintBuilder;
type UiTextService = TextService;
type UiContext = Context;
type UiBuilder = Builder;
type UiLiveRootVector = Vector<UiLiveRoot>;
type UiWidgetRootVector = Vector<WidgetRoot>;
type UiDisplayMetrics = DisplayMetrics;
type UiPoint = Point;
type UiInputEvent = InputEvent;
type UiPointerInput = PointerInput;
type UiGpuCommandRecordingMode = GpuCommandRecordingMode;


