    EXPECT_FALSE(take());
    EXPECT_TRUE(send(Pointer(InputEventType::SecondaryUp)).pointerConsumed);
    EXPECT_FALSE(take());
    EXPECT_TRUE(send(Pointer(InputEventType::SecondaryDown)).pointerConsumed);
