namespace __hidden_ui_glyph_sdf_tests{
using UiSliderBehaviorTests = ::NWB::__hidden_ui_slider_behavior_tests::UiSliderBehaviorTests;
using UiSliderBuilderTests = ::__hidden_ui_slider_builder_tests::UiSliderBuilderTests;
using UiSliderInputTests = ::__hidden_ui_slider_input_tests::UiSliderInputTests;
using UiSliderLifetimeTests = ::__hidden_ui_slider_lifetime_tests::UiSliderLifetimeTests;
using UiSliderPopupTests = ::__hidden_ui_slider_popup_tests::UiSliderPopupTests;
using SliderState = ::NWB::Impl::Ui::SliderState;
using SliderStyle = ::NWB::Impl::Ui::SliderStyle;
using SliderMetrics = ::NWB::Impl::Ui::SliderMetrics;
using SliderPlacement = ::NWB::Impl::Ui::SliderPlacement;
using SliderSnapshot = ::NWB::Impl::Ui::SliderSnapshot;
using SliderResult = ::NWB::Impl::Ui::SliderResult;
using ControlAction = ::NWB::Impl::Ui::ControlAction;
using ControlToken = ::NWB::Impl::Ui::ControlToken;
namespace ControlActionKind = ::NWB::Impl::Ui::ControlActionKind;
using ControlActionKindEnum = ::NWB::Impl::Ui::ControlActionKind::Enum;
using PointerGesture = ::NWB::Impl::Ui::PointerGesture;
namespace PointerGestureState = ::NWB::Impl::Ui::PointerGestureState;
using DisplayMetrics = ::NWB::Impl::Ui::DisplayMetrics;
using LayoutSize = ::NWB::Impl::Ui::LayoutSize;
using InputEvent = ::NWB::Impl::Ui::InputEvent;
namespace InputEventType = ::NWB::Impl::Ui::InputEventType;
using InputEventTypeEnum = ::NWB::Impl::Ui::InputEventType::Enum;
namespace UiSliderKey = ::NWB::Core::Key;
namespace UiSliderCallbackMutation = ::NWB::UiSliderTests::SliderCallbackMutation;
using UiSliderAcceptedInput64 = ::NWB::UiWidgetTests::AcceptedInputState<64u>;
using ::NWB::Impl::Ui::MeasureSlider;
using ::NWB::Impl::Ui::PlaceSlider;

[[nodiscard]] inline b8 UiSliderAdmit(::NWB::Impl::Ui::SliderState& state, const ::NWB::Impl::Ui::SliderOptions& options, const ::NWB::Impl::Ui::SliderPlacement& placement)noexcept{
    return ::NWB::Impl::Ui::SliderBehavior::Admit(state, options, placement);
}

[[nodiscard]] inline b8 UiSliderApply(const ::NWB::Impl::Ui::SliderOptions& options, const ::NWB::Impl::Ui::ControlAction& action, ::NWB::Impl::Ui::SliderState& state, ::NWB::Impl::Ui::SliderResult& result)noexcept{
    return ::NWB::Impl::Ui::SliderBehavior::Apply(options, action, state, result);
}

[[nodiscard]] inline b8 UiSliderSeek(const ::NWB::Impl::Ui::SliderOptions& options, const ::NWB::Impl::Ui::PointerGesture& gesture, ::NWB::Impl::Ui::SliderState& state, ::NWB::Impl::Ui::SliderResult& result)noexcept{
    return ::NWB::Impl::Ui::SliderBehavior::Seek(options, gesture, state, result);
}

[[nodiscard]] inline b8 UiSliderDrag(const ::NWB::Impl::Ui::SliderOptions& options, const ::NWB::Impl::Ui::PointerGesture& gesture, ::NWB::Impl::Ui::SliderState& state, ::NWB::Impl::Ui::SliderResult& result)noexcept{
    return ::NWB::Impl::Ui::SliderBehavior::Drag(options, gesture, state, result);
}

[[nodiscard]] inline Expected<f64> UiSliderNormalize(const f64 minimum, const f64 maximum, const f64 value)noexcept{
    return ::NWB::Impl::Ui::SliderBehavior::Normalize(minimum, maximum, value);
}

[[nodiscard]] inline Expected<f64> UiSliderInterpolate(const f64 minimum, const f64 maximum, const f64 normalized)noexcept{
    return ::NWB::Impl::Ui::SliderBehavior::Interpolate(minimum, maximum, normalized);
}
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_UiSliderQuietNaNF32Bits = 0x7fc00000u;
const u32 s_UiSliderPosInfF32Bits = 0x7f800000u;
const u64 s_UiSliderQuietNaNF64Bits = 0x7ff8000000000000u;
const u64 s_UiSliderPosInfF64Bits = 0x7ff0000000000000u;
const u64 s_UiSliderNegInfF64Bits = 0xfff0000000000000u;
const u64 s_UiSliderNegZeroF64Bits = 0x8000000000000000u;
const AStringView s_UiSliderPanelKey = "panel";
const AStringView s_UiSliderKey = "slider";
const AStringView s_UiSliderChildPopupKey = "child";


void ExpectUiSliderResult(in SliderResult actual, in SliderResult expected){
    EXPECT_EQ(actual.valid, expected.valid);
    EXPECT_EQ(actual.valueChanged, expected.valueChanged);
    EXPECT_EQ(actual.focused, expected.focused);
    EXPECT_EQ(actual.dragging, expected.dragging);
}

SliderResult MakeUiSliderResult(in b8 valid, in b8 valueChanged, in b8 focused, in b8 dragging){
    SliderResult result = SliderResult();
    result.valid = valid;
    result.valueChanged = valueChanged;
    result.focused = focused;
    result.dragging = dragging;
    return result;
}

InputEvent MakeUiSliderPointerEvent(in Point position, in InputEventTypeEnum eventType){
    InputEvent event = InputEvent();
    event.position = position;
    event.type = eventType;
    return event;
}

DisplayMetrics MakeUiSliderDisplayMetrics(in f32 width, in f32 height, in f32 scaleX, in f32 scaleY){
    DisplayMetrics metrics = DisplayMetrics();
    metrics.logicalWidth = width;
    metrics.logicalHeight = height;
    metrics.pixelScaleX = scaleX;
    metrics.pixelScaleY = scaleY;
    return metrics;
}


