    settings.spatialFilterEnabled = false;
    settings.spatialRadius = 3u;
    settings.diagnosticsEnabled = true;
    settings.debugView = ReflectionDebugView::TraceSource;
    const ReflectionHistoryPlan next = state.plan(Stamp(), settings, 2u);
    EXPECT_TRUE(next.reused);
    EXPECT_FALSE(next.reset);
    EXPECT_EQ(next.resetReason, ReflectionHistoryResetReason::None);
}

void VerifyReflectionHistory_RejectedDisabledTransitionCannotOverwriteAcceptedHistoryBank(){
    ReflectionHistoryState state = ReflectionHistoryState(1u);
    ReflectionSettings settings = ReflectionSettings();
    const ReflectionHistoryPlan first = state.plan(Stamp(), settings, 1u);
    ReflectionHistory_Accept(first, state);
    settings.temporalEnabled = false;
    const ReflectionHistoryPlan disabled = state.plan(Stamp(), settings, 2u);
    EXPECT_FALSE(disabled.eligible);
    EXPECT_NE(disabled.currentBank, first.currentBank);
    ASSERT_TRUE(state.reserve(disabled));
    state.discard(disabled);
    settings.temporalEnabled = true;
    const ReflectionHistoryPlan retry = state.plan(Stamp(), settings, 3u);
    EXPECT_TRUE(retry.reused);
    EXPECT_EQ(retry.previousBank, first.currentBank);
    EXPECT_EQ(retry.previousSampleCount, 1u);
}

void VerifyReflectionHistory_RejectedUntrustedTransitionCannotOverwriteAcceptedHistoryBank(){
    ReflectionHistoryState state = ReflectionHistoryState(1u);
    const ReflectionHistoryPlan first = state.plan(Stamp(), ReflectionSettings(), 1u);
    ReflectionHistory_Accept(first, state);
    ReflectionSceneContentStamp stamp = Stamp();
    stamp.trusted = false;
    const ReflectionHistoryPlan untrusted = state.plan(stamp, ReflectionSettings(), 2u);
    EXPECT_FALSE(untrusted.eligible);
    EXPECT_NE(untrusted.currentBank, first.currentBank);
    ASSERT_TRUE(state.reserve(untrusted));
    state.discard(untrusted);
    EXPECT_TRUE(state.plan(Stamp(), ReflectionSettings(), 3u).reused);
}

void VerifyReflectionHistory_StableUntrustedSceneNeverAccumulatesButDoesAdvanceAcceptedSampling(){
    ReflectionHistoryState state = ReflectionHistoryState(1u);
    ReflectionSceneContentStamp stamp = Stamp();
    stamp.trusted = false;
    const ReflectionHistoryPlan first = state.plan(stamp, ReflectionSettings(), 1u);
    EXPECT_EQ(first.resetReason, ReflectionHistoryResetReason::UntrustedScene);
    EXPECT_EQ(ResolveReflectionHistoryOutcome(first, false).sampleCount, 0u);
    ReflectionHistory_AcceptWithHardware(first, state, false);
    const ReflectionHistoryPlan next = state.plan(stamp, ReflectionSettings(), 2u);
    EXPECT_FALSE(next.reset);
    EXPECT_FALSE(next.eligible);
    EXPECT_EQ(next.resetReason, ReflectionHistoryResetReason::None);
    EXPECT_EQ(next.sampleIndex, 1u);
    EXPECT_EQ(ResolveReflectionHistoryOutcome(next, false).historyStartGraphicsFrame, 0u);
}

void VerifyReflectionHistory_StalePlanCannotReserveAfterAnotherFrameAccepts(){
    ReflectionHistoryState state = ReflectionHistoryState(1u);
    const ReflectionHistoryPlan old = state.plan(Stamp(), ReflectionSettings(), 1u);
    const ReflectionHistoryPlan accepted = state.plan(Stamp(), ReflectionSettings(), 2u);
    ReflectionHistory_Accept(accepted, state);
    EXPECT_FALSE(state.reserve(old));
    state.discard(old);
    state.accept(old, Token(99u), true);
    EXPECT_EQ(state.plan(Stamp(), ReflectionSettings(), 3u).acceptedSequence, accepted.sequence);
}

void VerifyReflectionHistory_ResourceGenerationRejectsOldAcceptanceAndResetsEpoch(){
    ReflectionHistoryState state = ReflectionHistoryState(1u);
    const ReflectionHistoryPlan old = state.plan(Stamp(), ReflectionSettings(), 1u);
    ASSERT_TRUE(state.reserve(old));
    state.reset(2u);
    state.accept(old, Token(), true);
    const ReflectionHistoryPlan next = state.plan(Stamp(), ReflectionSettings(), 2u);
    EXPECT_GT(next.generation, old.generation);
    EXPECT_EQ(next.resetReason, ReflectionHistoryResetReason::ResourcesChanged);
    EXPECT_EQ(next.sampleIndex, 0u);
    ASSERT_TRUE(state.reserve(next));
    QueueSubmissionToken token = Token();
    token.deviceGeneration = 2u;
    state.accept(next, token, false);
    EXPECT_EQ(state.plan(Stamp(), ReflectionSettings(), 3u).previousSampleCount, 1u);
}

void VerifyReflectionHistory_GraphRejectionAndResetReleaseUnacceptedLease(){
    ReflectionHistoryControlContext context = ReflectionHistoryControlContext();
    ASSERT_TRUE(context.valid());
    const ReflectionHistoryPlan rejected = context.plan(Stamp(), ReflectionSettings(), 1u);
    b8 rejectedAdmitted = true;
    native(mut context, in rejected, mut rejectedAdmitted){
        using LeaseTask = ReflectionStatisticsTestHelpers::ReservationLeaseTask<ReflectionHistoryReservation>;
        rejectedAdmitted = context.graph.addTask<LeaseTask>(Core::GpuTaskDesc{}, LeaseTask::Payload{ ReflectionHistoryReservation(context.inner.control, rejected) }).has_value();
    }
    EXPECT_FALSE(rejectedAdmitted);
    GpuTaskDesc desc = GpuTaskDesc();
    desc.setIdentity(s_EcsCaseTestsHistoryLease).setMarkerLabel("History Lease");
    const ReflectionHistoryPlan pending = context.plan(Stamp(), ReflectionSettings(), 2u);
    b8 pendingAdmitted = false;
    b8 pendingTaskValid = false;
    native(mut context, in desc, in pending, mut pendingAdmitted, mut pendingTaskValid){
        using LeaseTask = ReflectionStatisticsTestHelpers::ReservationLeaseTask<ReflectionHistoryReservation>;
        const auto gpuTaskAdmission = context.graph.addTask<LeaseTask>(desc, LeaseTask::Payload{ ReflectionHistoryReservation(context.inner.control, pending) });
        pendingAdmitted = gpuTaskAdmission.has_value();
        if(gpuTaskAdmission)
            pendingTaskValid = gpuTaskAdmission->valid();
    }
    ASSERT_TRUE(pendingAdmitted);
    ASSERT_TRUE(pendingTaskValid);
    context.graph.reset();
    const ReflectionHistoryPlan retry = context.plan(Stamp(), ReflectionSettings(), 3u);
    EXPECT_TRUE(context.reserve(retry));
    EXPECT_EQ(retry.sampleIndex, 0u);
}

