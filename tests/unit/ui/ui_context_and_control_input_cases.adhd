void VerifyUiContextMenuInputTests_OutsideSecondaryDismissesTheTopPopupAndConsumesItsReleaseAfterRemoval(mut UiContextMenuInputTests self){
    const PopupScope scope = MakeUiContextMenuScope(1u);
