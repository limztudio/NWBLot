const StringView s_RetainedMarkerLabel = "Retained marker view";
const StringView s_DuplicateRootLabel = "Duplicate root";
const StringView s_DuplicateLeafLabel = "Duplicate leaf";

usize WorkspaceAddress(in StandaloneGraphWorkspaceLease lease){
    usize address = 0u;
    native(in lease, mut address){
        address = reinterpret_cast<usize>(lease.workspace());
    }
    return address;
}

void VerifyQueueBarrierScopePolicy_TransferQueueRemovesUnsupportedShaderAccess(){
    VkPipelineStageFlags2 stages = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_2_COPY_BIT;
    VkAccessFlags2 access = VK_ACCESS_2_SHADER_READ_BIT | VK_ACCESS_2_TRANSFER_READ_BIT;
    QueueBarrierScopePolicy::Normalize(GpuQueueCapability::Transfer, stages, access);
    EXPECT_EQ(stages, VK_PIPELINE_STAGE_2_COPY_BIT);
    EXPECT_EQ(access, VK_ACCESS_2_TRANSFER_READ_BIT);

    stages = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT;
    access = VK_ACCESS_2_SHADER_READ_BIT;
    QueueBarrierScopePolicy::Normalize(GpuQueueCapability::Transfer, stages, access);
    EXPECT_EQ(stages, VK_PIPELINE_STAGE_2_NONE);
    EXPECT_EQ(access, 0u);
}

void VerifyGpuBlasOpacityMicromapPolicyTests_AttachmentSkipsAbsentAndHandlesEmptyUsageCounts(){
    native{
        using namespace NWB::Core;
        using namespace NWB::Core::GraphicsBackend::VulkanDetail;
        Alloc::ScratchArena arena(NWB::Tests::s_TestArena);
        RayTracingGeometryDesc geometries[3];
        geometries[2].geometryData.triangles.numOmmUsageCounts = 2u;
        OpacityMicromapUsageOffsetVector offsets(arena);
        offsets.resize(3u);
        offsets[0] = Limit<usize>::s_Max;
        offsets[1] = offsets[2] = 0u;
        OpacityMicromapUsageVector usages(arena);
        usages.resize(2u);
        OpacityMicromapGeometryVector micromaps(arena);
        micromaps.resize(3u);
        BlasGeometryScratch scratch(arena);
        scratch.resizeForSizeQuery(3u);
        BlasOpacityMicromapPolicy::AttachBlasOpacityMicromapGeometries(geometries, 3u, offsets, usages, micromaps, scratch);
        EXPECT_EQ(scratch.geometries[0].geometry.triangles.pNext, nullptr);
        EXPECT_EQ(scratch.geometries[1].geometry.triangles.pNext, &micromaps[1]);
        EXPECT_EQ(micromaps[1].pUsageCounts, nullptr);
        EXPECT_EQ(scratch.geometries[2].geometry.triangles.pNext, &micromaps[2]);
        EXPECT_EQ(micromaps[2].pUsageCounts, usages.data());
    }
    const Expected<OpacityMicromapIndexFormat> implicitFormat = ResolveImplicitOpacityMicromapIndexFormat();
    ASSERT_TRUE(implicitFormat.has_value());
    EXPECT_EQ(implicitFormat.value().indexType, VK_INDEX_TYPE_NONE_KHR);
    EXPECT_EQ(implicitFormat.value().indexStride, 0u);
}

void VerifyCalibratedTimestampProbe_RetriesIncompleteEnumerationBeforeDeviceQuery(){
    b8 supported = false;
    u32 countCalls = 0u;
    u32 listCalls = 0u;
    u32 timestampCalls = 0u;
    native(mut supported, mut countCalls, mut listCalls, mut timestampCalls){
#if defined(NWB_GRAPHICS_BACKEND_VULKAN) && NWB_GRAPHICS_BACKEND_VULKAN
        const auto probe = NWB::Tests::GraphicsResourceSuiteDetail::RunCalibratedTimestampProbe(true, true);
        supported = probe.supported;
        countCalls = probe.countCalls;
        listCalls = probe.listCalls;
        timestampCalls = probe.timestampCalls;
#endif
    }
    EXPECT_TRUE(supported);
    EXPECT_EQ(countCalls, 2u);
    EXPECT_EQ(listCalls, 1u);
    EXPECT_EQ(timestampCalls, 1u);
}

void VerifyCalibratedTimestampProbe_MissingDeviceDomainDoesNotQueryTimestamps(){
    b8 supported = true;
    u32 countCalls = 0u;
    u32 listCalls = 0u;
    u32 timestampCalls = 0u;
    native(mut supported, mut countCalls, mut listCalls, mut timestampCalls){
#if defined(NWB_GRAPHICS_BACKEND_VULKAN) && NWB_GRAPHICS_BACKEND_VULKAN
        const auto probe = NWB::Tests::GraphicsResourceSuiteDetail::RunCalibratedTimestampProbe(false, false);
        supported = probe.supported;
        countCalls = probe.countCalls;
        listCalls = probe.listCalls;
        timestampCalls = probe.timestampCalls;
#endif
    }
    EXPECT_FALSE(supported);
    EXPECT_EQ(countCalls, 1u);
    EXPECT_EQ(listCalls, 1u);
    EXPECT_EQ(timestampCalls, 0u);
}

void VerifyGpuClusterOperation_NativeInputRebindsUnionPointersAfterCopy(){
    native{
#if defined(NWB_GRAPHICS_BACKEND_VULKAN) && NWB_GRAPHICS_BACKEND_VULKAN
        using namespace NWB::Core;
        using namespace NWB::Core::GraphicsBackend;
        for(const auto opType : {
            RayTracingClusterOperationType::Move,
            RayTracingClusterOperationType::ClasBuild,
            RayTracingClusterOperationType::ClasBuildTemplates,
            RayTracingClusterOperationType::ClasInstantiateTemplates,
            RayTracingClusterOperationType::BlasBuild
        }){
            RayTracingClusterOperationParams params;
            params.type = opType;
            params.maxArgCount = 7u;
            const auto built = VulkanDetail::ClusterOperationInput::Build(params, NWB_TEXT("test cluster input"));
            ASSERT_TRUE(built);
            auto copied = *built;
            const auto nativeInfo = copied.nativeInfo();
            EXPECT_EQ(nativeInfo.maxAccelerationStructureCount, 7u);
            if(opType == RayTracingClusterOperationType::Move)
                EXPECT_EQ(nativeInfo.opInput.pMoveObjects, &copied.move);
            else if(opType == RayTracingClusterOperationType::BlasBuild)
                EXPECT_EQ(nativeInfo.opInput.pClustersBottomLevel, &copied.blas);
            else
                EXPECT_EQ(nativeInfo.opInput.pTriangleClusters, &copied.cluster);
        }
#endif
    }
}

void VerifyGpuCrashMarkerTracker_CopiesExactNonTerminatedViewAndEmbeddedNullBytes(){
    GpuCrashMarkerTestArena testArena = GpuCrashMarkerTestArena();
    GpuCrashTracker crashTracker = GpuCrashTracker(testArena.arena);
    GpuCrashMarkerTracker commandListTracker = GpuCrashMarkerTracker(crashTracker, testArena.arena);
    usize outerHash = 0u;
    usize nestedHash = 0u;
    native(mut commandListTracker, mut outerHash, mut nestedHash){
        Array<char, 6u> label = { 'O', 'u', 't', 'e', 'r', 'X' };
        outerHash = commandListTracker.pushEvent(AStringView(label.data(), 5u));
        label[0] = 'x';
        const Array<char, 3u> nestedLabel = { 'I', '\0', 'n' };
        nestedHash = commandListTracker.pushEvent(AStringView(nestedLabel.data(), nestedLabel.size()));
    }
    const ResolvedMarker outer = crashTracker.resolveMarker(outerHash);
    const ResolvedMarker nested = crashTracker.resolveMarker(nestedHash);
    ASSERT_TRUE(outer.first());
    ASSERT_TRUE(nested.first());
    EXPECT_EQ(outer.second(), StringView("Outer"));
    native(in nested){
        constexpr Array<char, 9u> s_Expected = { 'O', 'u', 't', 'e', 'r', '/', 'I', '\0', 'n' };
        EXPECT_EQ(nested.second(), AStringView(s_Expected.data(), s_Expected.size()));
    }
}

void VerifyGpuCrashMarkerTracker_SharedDeviceTrackerPreservesHistoryAcrossCommandListTrackerReset(){
    GpuCrashMarkerTestArena testArena = GpuCrashMarkerTestArena();
    GpuCrashTracker crashTracker = GpuCrashTracker(testArena.arena);
    GpuCrashMarkerTracker firstCommandListTracker = GpuCrashMarkerTracker(crashTracker, testArena.arena);
    GpuCrashMarkerTracker secondCommandListTracker = GpuCrashMarkerTracker(crashTracker, testArena.arena);

    const usize outerHash = firstCommandListTracker.pushEvent("Outer");
    const usize nestedHash = firstCommandListTracker.pushEvent("Inner");
    const ResolvedMarker nested = crashTracker.resolveMarker(nestedHash);
    ASSERT_TRUE(nested.first());
    EXPECT_EQ(nested.second(), StringView("Outer/Inner"));

    firstCommandListTracker.resetEventStack();

    const usize freshHash = secondCommandListTracker.pushEvent("Fresh");
    const ResolvedMarker fresh = crashTracker.resolveMarker(freshHash);
    ASSERT_TRUE(fresh.first());
    EXPECT_EQ(fresh.second(), StringView("Fresh"));

    const ResolvedMarker historicalOuter = crashTracker.resolveMarker(outerHash);
    const ResolvedMarker historicalNested = crashTracker.resolveMarker(nestedHash);
    ASSERT_TRUE(historicalOuter.first());
    ASSERT_TRUE(historicalNested.first());
    EXPECT_EQ(historicalOuter.second(), StringView("Outer"));
    EXPECT_EQ(historicalNested.second(), StringView("Outer/Inner"));

    secondCommandListTracker.popEvent();
    const usize finalHash = firstCommandListTracker.pushEvent("Final");
    const ResolvedMarker finalMarker = crashTracker.resolveMarker(finalHash);
    ASSERT_TRUE(finalMarker.first());
    EXPECT_EQ(finalMarker.second(), StringView("Final"));
}

void VerifyGpuCrashMarkerTracker_DestroyedCommandListTrackersLeaveAllDeviceHistoryResolvable(){
    GpuCrashMarkerTestArena testArena = GpuCrashMarkerTestArena();
    GpuCrashTracker crashTracker = GpuCrashTracker(testArena.arena);
    Array<StringView, 6> markerNames = Array<StringView, 6>();
    markerNames[0u] = "Destroyed command list 0";
    markerNames[1u] = "Destroyed command list 1";
    markerNames[2u] = "Destroyed command list 2";
    markerNames[3u] = "Destroyed command list 3";
    markerNames[4u] = "Destroyed command list 4";
    markerNames[5u] = "Destroyed command list 5";
    Array<usize, 6> markerHashes = Array<usize, 6>();

    usize markerIndex = 0u;
    for(in StringView markerName : markerNames){
        GpuCrashMarkerTracker commandListTracker = GpuCrashMarkerTracker(crashTracker, testArena.arena);
        markerHashes[markerIndex] = commandListTracker.pushEvent(markerName);
        ++markerIndex;
    }

    markerIndex = 0u;
    for(in StringView markerName : markerNames){
        const ResolvedMarker resolved = crashTracker.resolveMarker(markerHashes[markerIndex]);
        ASSERT_TRUE(resolved.first());
        EXPECT_EQ(resolved.second(), markerName);
        ++markerIndex;
    }
}

void VerifyGpuCrashMarkerTracker_RetainedResolvedViewSurvivesConcurrentHistoryGrowthAndTrackerDestruction(){
    GpuCrashMarkerTestArena testArena = GpuCrashMarkerTestArena();
    GpuCrashTracker crashTracker = GpuCrashTracker(testArena.arena);
    usize retainedHash = 0u;
    {
        GpuCrashMarkerTracker commandListTracker = GpuCrashMarkerTracker(crashTracker, testArena.arena);
        retainedHash = commandListTracker.pushEvent(s_RetainedMarkerLabel);
    }
    const ResolvedMarker retained = crashTracker.resolveMarker(retainedHash);
    ASSERT_TRUE(retained.first());
    ASSERT_EQ(retained.second(), StringView("Retained marker view"));

    b8 invalidObservation = false;
    native(mut crashTracker, mut testArena, in retainedHash, in retained, in s_RetainedMarkerLabel, mut invalidObservation){
        invalidObservation = NWB::Tests::GraphicsResourceSuiteDetail::RunConcurrentCrashMarkerGrowthCheck(
            crashTracker,
            testArena.arena,
            retainedHash,
            retained,
            s_RetainedMarkerLabel
        );
    }

    EXPECT_FALSE(invalidObservation);
    EXPECT_EQ(retained.second(), StringView("Retained marker view"));
    const ResolvedMarker resolvedAgain = crashTracker.resolveMarker(retainedHash);
    ASSERT_TRUE(resolvedAgain.first());
    EXPECT_EQ(resolvedAgain.second(), retained.second());
}

void VerifyGpuCrashMarkerTracker_ExactDuplicatePathsReuseIdsAndDistinctPathsResolveIndependently(){
    GpuCrashMarkerTestArena testArena = GpuCrashMarkerTestArena();
    GpuCrashTracker crashTracker = GpuCrashTracker(testArena.arena);
    GpuCrashMarkerTracker commandListTracker = GpuCrashMarkerTracker(crashTracker, testArena.arena);

    const usize firstRootHash = commandListTracker.pushEvent(s_DuplicateRootLabel);
    const usize firstDuplicateHash = commandListTracker.pushEvent(s_DuplicateLeafLabel);
    commandListTracker.resetEventStack();
    const usize secondRootHash = commandListTracker.pushEvent(s_DuplicateRootLabel);
    const usize secondDuplicateHash = commandListTracker.pushEvent(s_DuplicateLeafLabel);
    commandListTracker.resetEventStack();
    const usize distinctHash = commandListTracker.pushEvent("Distinct path");

    EXPECT_EQ(firstRootHash, secondRootHash);
    EXPECT_EQ(firstDuplicateHash, secondDuplicateHash);
    EXPECT_NE(firstDuplicateHash, distinctHash);
    const ResolvedMarker duplicate = crashTracker.resolveMarker(firstDuplicateHash);
    const ResolvedMarker distinct = crashTracker.resolveMarker(distinctHash);
    ASSERT_TRUE(duplicate.first());
    ASSERT_TRUE(distinct.first());
    EXPECT_EQ(duplicate.second(), StringView("Duplicate root/Duplicate leaf"));
    EXPECT_EQ(distinct.second(), StringView("Distinct path"));
}

void VerifyGpuDescriptorBufferAllocation_CoalescingReusesRangeWithoutRevivingStaleIdentity(){
    DescriptorBufferAllocationHarness harness = DescriptorBufferAllocationHarness();
    const DescriptorBufferSegmentKindEnum kind = DescriptorBufferSegmentKind::Resource;
    const Expected<DescriptorBufferSegment> first = harness.allocate(kind, 16u, 8u, 41u);
    const Expected<DescriptorBufferSegment> middle = harness.allocate(kind, 16u, 8u, 41u);
    const Expected<DescriptorBufferSegment> last = harness.allocate(kind, 16u, 8u, 41u);
    ASSERT_TRUE(first.has_value() && middle.has_value() && last.has_value());
    harness.free(middle.value(), 41u);
    harness.free(first.value(), 41u);
    harness.free(last.value(), 41u);
    const Expected<DescriptorBufferSegment> merged = harness.allocate(kind, 48u, 8u, 41u);
    ASSERT_TRUE(merged.has_value());
    EXPECT_EQ(merged.value().offsetBytes, 0u);
    EXPECT_NE(merged.value().allocationSerial, first.value().allocationSerial);
    EXPECT_FALSE(harness.isLive(first.value(), kind, 41u));
    EXPECT_FALSE(harness.state.ownsAt(first.value(), first.value().offsetBytes));
    EXPECT_TRUE(harness.isLive(merged.value(), kind, 41u));
    EXPECT_TRUE(harness.state.ownsAt(merged.value(), merged.value().offsetBytes + 8u));
    harness.state.resetOffset();
    harness.state.clearAllocations();
    const Expected<DescriptorBufferSegment> afterReset = harness.allocate(kind, 16u, 8u, 41u);
    ASSERT_TRUE(afterReset.has_value());
    EXPECT_NE(afterReset.value().allocationSerial, first.value().allocationSerial);
    EXPECT_FALSE(harness.isLive(first.value(), kind, 41u));
}

void VerifyGpuDescriptorClassPolicy_StorageAliasesAndSampledImageDimensionsStayDistinct(){
    EXPECT_EQ(DescriptorClassPolicy::ClassToResourceType(GpuDescriptorClass::StorageBuffer), ResourceType::StructuredBuffer_UAV);
    EXPECT_TRUE(DescriptorClassPolicy::IsResourceTypeCompatible(GpuDescriptorClass::StorageBuffer, ResourceType::StructuredBuffer_SRV));
    EXPECT_TRUE(DescriptorClassPolicy::IsResourceTypeCompatible(GpuDescriptorClass::StorageBuffer, ResourceType::RawBuffer_UAV));
    EXPECT_FALSE(DescriptorClassPolicy::IsResourceTypeCompatible(GpuDescriptorClass::UniformBuffer, ResourceType::RawBuffer_UAV));
    EXPECT_TRUE(DescriptorClassPolicy::IsSampledImageClass(GpuDescriptorClass::SampledImage2DArrayUint));
    EXPECT_EQ(DescriptorClassPolicy::GetSampledImageDimension(GpuDescriptorClass::SampledImage2DArrayUint), TextureDimension::Texture2DArray);
    EXPECT_EQ(DescriptorClassPolicy::GetSampledImageDimension(GpuDescriptorClass::SampledImageCube), TextureDimension::TextureCube);
    EXPECT_FALSE(DescriptorClassPolicy::IsSampledImageClass(GpuDescriptorClass::StorageImage));
    EXPECT_EQ(DescriptorClassPolicy::GetSampledImageDimension(GpuDescriptorClass::StorageImage), TextureDimension::Unknown);
}

void VerifyGpuDescriptorImagePolicy_Storage3dRejectsIntegerFormatWhileTwoDimensionalStorageAcceptsIt(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard guard(logger, LoggerBreakPolicy::ReportOnly);
    TextureDesc texture = TextureDesc();
    texture.dimension = TextureDimension::Texture3D;
    texture.format = Format::R32_UINT;
    DescriptorWriteItem item = DescriptorWriteItem::None();
    EXPECT_FALSE(DescriptorImagePolicy::Validate(GpuDescriptorClass::StorageImage, item, texture));
    EXPECT_TRUE(SawCapturedError(logger, "rejected format"));
    item.dimension = TextureDimension::Texture2D;
    EXPECT_TRUE(DescriptorImagePolicy::Validate(GpuDescriptorClass::StorageImage, item, texture));
    item.dimension = TextureDimension::Unknown;
    item.format = Format::R32_FLOAT;
    EXPECT_TRUE(DescriptorImagePolicy::Validate(GpuDescriptorClass::StorageImage, item, texture));
}

void VerifySetupUploadGraph_LargeThresholdKeepsQueueRoutingAndSubmissionBoundary(){
    const SetupUploadScheduling below = SetupUploadGraph::Scheduling(SetupUploadGraph::s_LargeMinimumBytes - 1u, true, true);
    const SetupUploadScheduling at = SetupUploadGraph::Scheduling(SetupUploadGraph::s_LargeMinimumBytes, true, true);
    EXPECT_EQ(below.cost, GpuTaskCostHint::Tiny);
    EXPECT_EQ(at.cost, GpuTaskCostHint::Large);
    Array<SetupUploadScheduling, 2> hints = Array<SetupUploadScheduling, 2>();
    hints[0u] = below;
    hints[1u] = at;
    for(in SetupUploadScheduling hint : hints){
        EXPECT_TRUE(hint.forceSubmissionBoundary);
        EXPECT_FALSE(hint.allowPacketMerge);
        EXPECT_TRUE(hint.allowSameClassQueueRouting);
        EXPECT_TRUE(hint.preferNonPrimarySameClassQueue);
        EXPECT_TRUE(hint.allowCrossFamilySameClassQueueRouting);
    }
}

void VerifySetupUploadGraph_UnknownStateAndCrossFamilySharingKeepUploadContract(){
    EXPECT_EQ(SetupUploadGraph::FinalState(ResourceStates::Unknown), ResourceStates::CopyDest);
    EXPECT_EQ(SetupUploadGraph::FinalState(ResourceStates::ShaderResource), ResourceStates::ShaderResource);
    EXPECT_EQ(SetupUploadGraph::ResolveConsumerSharing(ResourceQueueSharing::Exclusive, CommandQueue::Compute, false), ResourceQueueSharing::GraphicsAndAsyncCompute);
    EXPECT_EQ(SetupUploadGraph::ResolveConsumerSharing(ResourceQueueSharing::Exclusive, CommandQueue::Compute, true), ResourceQueueSharing::AsyncCompute);
    EXPECT_EQ(SetupUploadGraph::ResolveConsumerSharing(ResourceQueueSharing::Graphics, CommandQueue::Transfer, false), ResourceQueueSharing::GraphicsAndTransfer);
}

void VerifyStandaloneGraphWorkspacePool_OverlappingLeasesKeepDistinctWorkspacesAndReuseReleasedStorage(){
    DefaultResourceTestArena arena = DefaultResourceTestArena();
    StandaloneGraphWorkspacePool pool = StandaloneGraphWorkspacePool(arena.arena);
    usize firstWorkspaceAddress = 0u;
    {
        const StandaloneGraphWorkspaceLease first = StandaloneGraphWorkspaceLease(pool);
        firstWorkspaceAddress = WorkspaceAddress(first);
        ASSERT_NE(firstWorkspaceAddress, 0u);
        {
            const StandaloneGraphWorkspaceLease second = StandaloneGraphWorkspaceLease(pool);
            const usize secondWorkspaceAddress = WorkspaceAddress(second);
            ASSERT_NE(secondWorkspaceAddress, 0u);
            EXPECT_NE(firstWorkspaceAddress, secondWorkspaceAddress);
            EXPECT_FALSE(pool.releaseCommandListCaches());
        }
        EXPECT_FALSE(pool.releaseCommandListCaches());
    }
    EXPECT_TRUE(pool.releaseCommandListCaches());
    {
        const StandaloneGraphWorkspaceLease reused = StandaloneGraphWorkspaceLease(pool);
        EXPECT_EQ(WorkspaceAddress(reused), firstWorkspaceAddress);
    }
    EXPECT_TRUE(pool.releaseCommandListCaches());
}

void VerifyStandaloneGraphWorkspacePool_ExceptionDiscardsLeaseWithoutBlockingNextSubmission(){
    DefaultResourceTestArena arena = DefaultResourceTestArena();
    StandaloneGraphWorkspacePool pool = StandaloneGraphWorkspacePool(arena.arena);
    native(mut pool){
        EXPECT_THROW({
            const Core::GraphicsModuleDetail::StandaloneGraphWorkspacePool::Lease lease(pool);
            ASSERT_NE(lease.workspace(), nullptr);
            throw RuntimeException("expected workspace unwind");
        }, RuntimeException);
    }
    EXPECT_TRUE(pool.releaseCommandListCaches());
    {
        const StandaloneGraphWorkspaceLease next = StandaloneGraphWorkspaceLease(pool);
        ASSERT_NE(WorkspaceAddress(next), 0u);
        EXPECT_FALSE(pool.releaseCommandListCaches());
    }
    EXPECT_TRUE(pool.releaseCommandListCaches());
}

void VerifyGpuTextureImagePolicyTests_ImageSharingRequiresCompleteQueueFamilyProvenance(){
    TextureDesc desc = TextureDesc();
    desc.format = Format::RGBA8_UNORM;
    const Expected<TextureCreateMetadata> metadata = ValidateDefaultTextureCreateDesc(desc);
    ASSERT_TRUE(metadata.has_value());
    VkImageCreateInfo imageInfo = TextureImagePolicy::BuildTextureImageCreateInfo(desc, metadata.value());
    EXPECT_TRUE(TextureImagePolicy::IsTextureImageInfoConsistent(desc, imageInfo));
    imageInfo.sharingMode = VK_SHARING_MODE_CONCURRENT;
    imageInfo.queueFamilyIndexCount = 1u;
    EXPECT_FALSE(TextureImagePolicy::IsTextureImageInfoConsistent(desc, imageInfo));
    native(in desc, mut imageInfo){
        const uint32_t families[] = { 0u, 1u };
        imageInfo.queueFamilyIndexCount = 2u;
        imageInfo.pQueueFamilyIndices = families;
        EXPECT_TRUE(TextureImagePolicy::IsTextureImageInfoConsistent(desc, imageInfo));
        imageInfo.flags |= VK_IMAGE_CREATE_PROTECTED_BIT;
        EXPECT_FALSE(TextureImagePolicy::IsTextureImageInfoConsistent(desc, imageInfo));
    }
}

void VerifyGpuTextureShapePolicyTests_CubeArraysRequireWholeCubesAndSquareFaces(){
    TextureDesc desc = TextureDesc();
    desc.dimension = TextureDimension::TextureCubeArray;
    desc.width = 16u;
    desc.height = 16u;
    desc.arraySize = 12u;
    EXPECT_TRUE(TextureShapePolicy::IsValid(desc));
    desc.arraySize = 13u;
    EXPECT_FALSE(TextureShapePolicy::IsValid(desc));
    desc.arraySize = 12u;
    desc.height = 8u;
    EXPECT_FALSE(TextureShapePolicy::IsValid(desc));
}

void VerifyGpuTextureShapePolicyTests_ThreeDimensionalDepthDeterminesMipLimit(){
    TextureDesc desc = TextureDesc();
    desc.dimension = TextureDimension::Texture3D;
    desc.depth = 16u;
    desc.mipLevels = 5u;
    EXPECT_EQ(TextureShapePolicy::MaxMipLevels(desc), 5u);
    EXPECT_TRUE(TextureShapePolicy::IsValid(desc));
    desc.mipLevels = 6u;
    EXPECT_FALSE(TextureShapePolicy::IsValid(desc));
}

void VerifyGpuTextureTransferLayoutTests_CompressedPaddedSlicesPreserveTouchedByteBoundary(){
    VkExtent3D extent = VkExtent3D();
    extent.width = 5u;
    extent.height = 5u;
    extent.depth = 2u;
    TextureFormatBlockLayout block = TextureFormatBlockLayout();
    block.blockWidth = 4u;
    block.blockHeight = 4u;
    block.bytesPerBlock = 16u;
    const Expected<BufferImageCopyLayout> touched = TextureTransferLayout::BuildBufferImageCopyLayout(extent, block, 48u, 144u, BufferImageCopyRequiredSize::TouchedBytes, BufferImageCopyPitchFields::EmitExplicit);
    const Expected<BufferImageCopyLayout> padded = TextureTransferLayout::BuildBufferImageCopyLayout(extent, block, 48u, 144u, BufferImageCopyRequiredSize::PaddedSlices, BufferImageCopyPitchFields::EmitExplicit);
    ASSERT_TRUE(touched.has_value());
    ASSERT_TRUE(padded.has_value());
    EXPECT_EQ(touched.value().requiredSize, 224u);
    EXPECT_EQ(padded.value().requiredSize, 240u);
    EXPECT_EQ(touched.value().bufferRowLength, 12u);
    EXPECT_EQ(touched.value().bufferImageHeight, 12u);
    EXPECT_FALSE(TextureTransferLayout::BuildBufferImageCopyLayout(extent, block, 17u, 0u, BufferImageCopyRequiredSize::TouchedBytes, BufferImageCopyPitchFields::OmitImplicit).has_value());
}

native{
NWB_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace Tests::GraphicsResourceSuiteDetail{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 RunConcurrentCrashMarkerGrowthCheck(
    Core::GpuCrashTracker& crashTracker,
    Core::Alloc::GlobalArena& arena,
    const usize retainedHash,
    const Core::ResolvedMarker& retained,
    const AStringView retainedLabel
){
    constexpr Array<AStringView, 16> s_FirstWriterMarkerNames = {
        "Concurrent writer A marker 00", "Concurrent writer A marker 01",
        "Concurrent writer A marker 02", "Concurrent writer A marker 03",
        "Concurrent writer A marker 04", "Concurrent writer A marker 05",
        "Concurrent writer A marker 06", "Concurrent writer A marker 07",
        "Concurrent writer A marker 08", "Concurrent writer A marker 09",
        "Concurrent writer A marker 10", "Concurrent writer A marker 11",
        "Concurrent writer A marker 12", "Concurrent writer A marker 13",
        "Concurrent writer A marker 14", "Concurrent writer A marker 15",
    };
    constexpr Array<AStringView, 16> s_SecondWriterMarkerNames = {
        "Concurrent writer B marker 00", "Concurrent writer B marker 01",
        "Concurrent writer B marker 02", "Concurrent writer B marker 03",
        "Concurrent writer B marker 04", "Concurrent writer B marker 05",
        "Concurrent writer B marker 06", "Concurrent writer B marker 07",
        "Concurrent writer B marker 08", "Concurrent writer B marker 09",
        "Concurrent writer B marker 10", "Concurrent writer B marker 11",
        "Concurrent writer B marker 12", "Concurrent writer B marker 13",
        "Concurrent writer B marker 14", "Concurrent writer B marker 15",
    };
    Latch growthStart(3u);
    Latch growthMidpoint(3u);
    Atomic<u32> activeWriters{ 2u };
    Atomic<b8> invalidObservation{ false };
    const auto insertMarkers = [&](const Span<const AStringView> markerNames){
        {
            Core::GpuCrashMarkerTracker commandListTracker(crashTracker, arena);
            growthStart.arrive_and_wait();
            for(usize markerIndex = 0u; markerIndex < markerNames.size(); ++markerIndex){
                if(markerIndex == markerNames.size() / 2u)
                    growthMidpoint.arrive_and_wait();

                commandListTracker.resetEventStack();
                const usize insertedHash = commandListTracker.pushEvent(markerNames[markerIndex]);
                const Core::ResolvedMarker inserted = crashTracker.resolveMarker(insertedHash);
                if(!inserted.first() || inserted.second() != markerNames[markerIndex])
                    invalidObservation.store(true, MemoryOrder::release);
            }
        }
        const u32 previousActiveWriters = activeWriters.fetch_sub(1u, MemoryOrder::acq_rel);
        if(previousActiveWriters == 0u || previousActiveWriters > 2u)
            invalidObservation.store(true, MemoryOrder::release);
    };
    Thread firstWriter([&](){ insertMarkers(s_FirstWriterMarkerNames); });
    Thread secondWriter([&](){ insertMarkers(s_SecondWriterMarkerNames); });

    const auto retainedViewIsValid = [&]()noexcept{
        const Core::ResolvedMarker resolved = crashTracker.resolveMarker(retainedHash);
        return retained.second() == retainedLabel && resolved.first() && resolved.second() == retainedLabel;
    };
    growthStart.arrive_and_wait();
    if(!retainedViewIsValid())
        invalidObservation.store(true, MemoryOrder::release);
    growthMidpoint.arrive_and_wait();
    do{
        if(!retainedViewIsValid())
            invalidObservation.store(true, MemoryOrder::release);
        YieldThread();
    }while(activeWriters.load(MemoryOrder::acquire) != 0u);

    firstWriter.join();
    secondWriter.join();
    return invalidObservation.load(MemoryOrder::acquire);
}

#if defined(NWB_GRAPHICS_BACKEND_VULKAN) && NWB_GRAPHICS_BACKEND_VULKAN
namespace{

static u32 s_CountCalls = 0u;
static u32 s_ListCalls = 0u;
static u32 s_TimestampCalls = 0u;
static b8 s_RetryFirstCount = false;
static b8 s_HasDeviceDomain = false;

VKAPI_ATTR VkResult VKAPI_CALL EnumerateDomains([[maybe_unused]] VkPhysicalDevice physicalDevice, u32* const count, VkTimeDomainKHR* const domains){
    if(!domains){
        ++s_CountCalls;
        *count = 1u;
        return s_RetryFirstCount && s_CountCalls == 1u ? VK_INCOMPLETE : VK_SUCCESS;
    }
    ++s_ListCalls;
    *count = 1u;
    domains[0] = s_HasDeviceDomain ? VK_TIME_DOMAIN_DEVICE_KHR : VK_TIME_DOMAIN_CLOCK_MONOTONIC_KHR;
    return VK_SUCCESS;
}

VKAPI_ATTR VkResult VKAPI_CALL GetTimestamps([[maybe_unused]] VkDevice device, [[maybe_unused]] u32 count, [[maybe_unused]] const VkCalibratedTimestampInfoKHR* const infos, u64* const timestamps, u64* const maxDeviation){
    ++s_TimestampCalls;
    *timestamps = 1u;
    *maxDeviation = 0u;
    return VK_SUCCESS;
}

}

CalibratedTimestampProbeResult RunCalibratedTimestampProbe(const b8 retryFirstCount, const b8 hasDeviceDomain){
    s_CountCalls = 0u;
    s_ListCalls = 0u;
    s_TimestampCalls = 0u;
    s_RetryFirstCount = retryFirstCount;
    s_HasDeviceDomain = hasDeviceDomain;
    Core::Alloc::ScratchArena scratch(Tests::s_TestArena);
    const b8 supported = Core::GraphicsBackend::VulkanDetail::CalibratedTimestampProbe::Query(
        VK_NULL_HANDLE,
        VK_NULL_HANDLE,
        &EnumerateDomains,
        &GetTimestamps,
        scratch
    );
    return CalibratedTimestampProbeResult{
        .supported = supported,
        .countCalls = s_CountCalls,
        .listCalls = s_ListCalls,
        .timestampCalls = s_TimestampCalls,
    };
}
#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_END
}

