void VerifyGpuPacket_ClearsPrimitiveAcceptedTokensWhenDeclarationFails(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuTaskDesc desc = GpuTaskDesc();
    QueueSubmissionToken token = QueueSubmissionToken();

    native(mut graph, in desc, mut token){
        token = Core::QueueSubmissionToken{ .value = 1u, .physicalQueueIndex = 0u, .deviceGeneration = 1u, .queue = Core::CommandQueue::Graphics };
        Core::GpuCopyBufferTaskDesc copyBuffer;
        copyBuffer.acceptedToken = &token;
        EXPECT_FALSE(graph.addCopyBufferTask(desc, copyBuffer).has_value());
        EXPECT_FALSE(token.valid());

        token = Core::QueueSubmissionToken{ .value = 1u, .physicalQueueIndex = 0u, .deviceGeneration = 1u, .queue = Core::CommandQueue::Graphics };
        Core::GpuCopyTextureTaskDesc copyTexture;
        copyTexture.acceptedToken = &token;
        EXPECT_FALSE(graph.addCopyTextureTask(desc, copyTexture).has_value());
        EXPECT_FALSE(token.valid());

        token = Core::QueueSubmissionToken{ .value = 1u, .physicalQueueIndex = 0u, .deviceGeneration = 1u, .queue = Core::CommandQueue::Graphics };
        Core::GpuResolveTextureTaskDesc resolveTexture;
        resolveTexture.acceptedToken = &token;
        EXPECT_FALSE(graph.addResolveTextureTask(desc, resolveTexture).has_value());
        EXPECT_FALSE(token.valid());

        token = Core::QueueSubmissionToken{ .value = 1u, .physicalQueueIndex = 0u, .deviceGeneration = 1u, .queue = Core::CommandQueue::Graphics };
        Core::GpuClearBufferTaskDesc clearBuffer;
        clearBuffer.acceptedToken = &token;
        EXPECT_FALSE(graph.addClearBufferTask(desc, clearBuffer).has_value());
        EXPECT_FALSE(token.valid());

        token = Core::QueueSubmissionToken{ .value = 1u, .physicalQueueIndex = 0u, .deviceGeneration = 1u, .queue = Core::CommandQueue::Graphics };
        Core::GpuClearTextureTaskDesc clearTexture;
        clearTexture.acceptedToken = &token;
        EXPECT_FALSE(graph.addClearTextureTask(desc, clearTexture).has_value());
        EXPECT_FALSE(token.valid());

        token = Core::QueueSubmissionToken{ .value = 1u, .physicalQueueIndex = 0u, .deviceGeneration = 1u, .queue = Core::CommandQueue::Graphics };
        Core::GpuClearTextureRectUIntTaskDesc clearTextureRect;
        clearTextureRect.acceptedToken = &token;
        EXPECT_FALSE(graph.addClearTextureRectUIntTask(desc, clearTextureRect).has_value());
        EXPECT_FALSE(token.valid());
    }
}

void VerifyGpuPacket_NormalExecutionPreludeGatesIndependentBranchesWithoutOrderingThem(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedTransferQueue();
    const GpuPhysicalQueueTopology topology = MakeGpuPacketTopology(queues);

    const Expected<GpuTaskId> preludeResult = GpuPacketAddPrelude(graph);
    ASSERT_TRUE(preludeResult.has_value());
    const GpuTaskId prelude = preludeResult.value();
    ASSERT_TRUE(prelude.valid());
    ASSERT_TRUE(graph.setNormalExecutionPrelude(prelude));

    GpuTaskCommandRequirements graphicsCommands = GpuTaskCommandRequirements();
    graphicsCommands.requiredCapabilities = GpuQueueCapability::Graphics;
    GpuTaskCommandRequirements uiTransferCommands = GpuTaskCommandRequirements();
    uiTransferCommands.requiredCapabilities = GpuQueueCapability::Transfer;
    uiTransferCommands.externalQueue = queues[1u].id;

    const Expected<GpuTaskId> sceneRootResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphPreludeSceneRoot,
        "Scene Root",
        graphicsCommands,
        GpuTaskSchedulingHint(),
        GpuTaskTimingMetadata(),
        Span<GpuTaskId>(),
        graph
    );
    ASSERT_TRUE(sceneRootResult.has_value());
    const GpuTaskId sceneRoot = sceneRootResult.value();
    const Expected<GpuTaskId> uiRootResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphPreludeUiRoot,
        "UI Upload Root",
        uiTransferCommands,
        GpuTaskSchedulingHint(),
        GpuTaskTimingMetadata(),
        Span<GpuTaskId>(),
        graph
    );
    ASSERT_TRUE(uiRootResult.has_value());
    const GpuTaskId uiRoot = uiRootResult.value();
    ASSERT_TRUE(sceneRoot.valid());
    ASSERT_TRUE(uiRoot.valid());

    Array<GpuTaskId, 1> sceneRootDeps = Array<GpuTaskId, 1>();
    sceneRootDeps[0u] = sceneRoot;
    const Expected<GpuTaskId> sceneTailResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphPreludeSceneTail,
        "Scene Tail",
        graphicsCommands,
        GpuTaskSchedulingHint(),
        GpuTaskTimingMetadata(),
        sceneRootDeps,
        graph
    );
    ASSERT_TRUE(sceneTailResult.has_value());
    const GpuTaskId sceneTail = sceneTailResult.value();

    Array<GpuTaskId, 1> uiRootDeps = Array<GpuTaskId, 1>();
    uiRootDeps[0u] = uiRoot;
    const Expected<GpuTaskId> uiTailResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphPreludeUiTail,
        "UI Tail",
        uiTransferCommands,
        GpuTaskSchedulingHint(),
        GpuTaskTimingMetadata(),
        uiRootDeps,
        graph
    );
    ASSERT_TRUE(uiTailResult.has_value());
    const GpuTaskId uiTail = uiTailResult.value();
    ASSERT_TRUE(sceneTail.valid());
    ASSERT_TRUE(uiTail.valid());

    Array<GpuTaskId, 2> terminalDependencies = Array<GpuTaskId, 2>();
    terminalDependencies[0u] = sceneTail;
    terminalDependencies[1u] = uiTail;
    const Expected<GpuTaskId> terminalResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphPreludeTerminal,
        "Presentation Terminal",
        GpuPacketPrimaryGraphicsRequirements(),
        GpuTaskSchedulingHint(),
        GpuTaskTimingMetadata(),
        terminalDependencies,
        graph
    );
    ASSERT_TRUE(terminalResult.has_value());
    const GpuTaskId terminal = terminalResult.value();
    ASSERT_TRUE(terminal.valid());

    GpuTaskSchedulingHint recoveryScheduling = GpuPacketPreludeScheduling();
    recoveryScheduling.joinsAcceptedQueueFrontier = true;
    recoveryScheduling.isRecoverySubmission = true;
    const Expected<GpuTaskId> recoveryResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphPreludeRecovery,
        "Recovery Frontier",
        GpuPacketPrimaryGraphicsRequirements(),
        recoveryScheduling,
        GpuTaskTimingMetadata(),
        Span<GpuTaskId>(),
        graph
    );
    ASSERT_TRUE(recoveryResult.has_value());
    const GpuTaskId recovery = recoveryResult.value();
    ASSERT_TRUE(recovery.valid());

    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        ASSERT_TRUE(declarations.valid());
        const GpuTaskGraphTaskView scene = declarations.taskAt(sceneRoot.index);
        const GpuTaskGraphTaskView ui = declarations.taskAt(uiRoot.index);
        const GpuTaskGraphTaskView sceneDependent = declarations.taskAt(sceneTail.index);
        const GpuTaskGraphTaskView uiDependent = declarations.taskAt(uiTail.index);
        const GpuTaskGraphTaskView lateRecovery = declarations.taskAt(recovery.index);
        ASSERT_EQ(scene.dependencyCount, 1u);
        ASSERT_EQ(ui.dependencyCount, 1u);
        ASSERT_EQ(sceneDependent.dependencyCount, 1u);
        ASSERT_EQ(uiDependent.dependencyCount, 1u);
        native(in scene, in ui, in sceneDependent, in uiDependent, in prelude, in sceneRoot, in uiRoot){
            EXPECT_EQ(scene.dependencies[0u], prelude);
            EXPECT_EQ(ui.dependencies[0u], prelude);
            EXPECT_EQ(sceneDependent.dependencies[0u], sceneRoot);
            EXPECT_EQ(uiDependent.dependencies[0u], uiRoot);
        }
        EXPECT_EQ(lateRecovery.dependencyCount, 0u);
    }

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    GpuTaskGraphCompileOptions options = GpuTaskGraphCompileOptions();
    options.packetizationPolicy = GpuTaskGraphPacketizationPolicy::FrontierSafe;
    options.packetTimingEnvelope.firstTask = prelude;
    options.packetTimingEnvelope.lastTask = terminal;
    ASSERT_TRUE(Compile(analysis, assignments, compiledGraph, operationScratchArena, graph, topology, options));
    const GpuCompiledGraphReadView plan = GpuCompiledGraphReadView(compiledGraph);
    ASSERT_TRUE(plan.valid());
    const GpuSubmissionPacketId preludePacket = plan.packetForTask(prelude);
    const GpuSubmissionPacketId scenePacket = plan.packetForTask(sceneRoot);
    const GpuSubmissionPacketId uiPacket = plan.packetForTask(uiRoot);
    const GpuSubmissionPacketId recoveryPacket = plan.packetForTask(recovery);
    ASSERT_TRUE(preludePacket.valid());
    ASSERT_TRUE(scenePacket.valid());
    ASSERT_TRUE(uiPacket.valid());
    ASSERT_TRUE(recoveryPacket.valid());
    EXPECT_EQ(preludePacket.index, 0u);
    EXPECT_LT(preludePacket.index, scenePacket.index);
    EXPECT_LT(preludePacket.index, uiPacket.index);
    native(in plan, in preludePacket, in uiPacket, in queues){
        EXPECT_EQ(plan.packet(preludePacket).plan->queue, queues[0u].id);
        EXPECT_EQ(plan.packet(uiPacket).plan->queue, queues[1u].id);
    }
    EXPECT_TRUE(GpuPacketHasPacketDependency(plan.packet(scenePacket), preludePacket));
    EXPECT_TRUE(GpuPacketHasPacketDependency(plan.packet(uiPacket), preludePacket));
    EXPECT_FALSE(GpuPacketHasPacketDependency(plan.packet(scenePacket), uiPacket));
    EXPECT_FALSE(GpuPacketHasPacketDependency(plan.packet(uiPacket), scenePacket));
    const GpuCompiledPacketView recoveryPlan = plan.packet(recoveryPacket);
    ASSERT_TRUE(recoveryPlan.valid());
    native(in recoveryPlan){
        EXPECT_EQ(recoveryPlan.plan->dependencyCount, 0u);
        EXPECT_TRUE(recoveryPlan.plan->joinsAcceptedQueueFrontier);
    }
}

void VerifyGpuPacket_NormalExecutionPreludeRejectsInvalidRegistrationAndClearsOnReset(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuTaskGraph otherGraph = GpuTaskGraph(testArena.arena);
    const Expected<GpuTaskId> foreignPreludeResult = GpuPacketAddPrelude(otherGraph);
    ASSERT_TRUE(foreignPreludeResult.has_value());
    const GpuTaskId foreignPrelude = foreignPreludeResult.value();
    ASSERT_TRUE(foreignPrelude.valid());
    EXPECT_FALSE(graph.setNormalExecutionPrelude(GpuTaskId()));
    EXPECT_FALSE(graph.setNormalExecutionPrelude(foreignPrelude));

    const Expected<GpuTaskId> preludeResult = GpuPacketAddPrelude(graph);
    ASSERT_TRUE(preludeResult.has_value());
    const GpuTaskId prelude = preludeResult.value();
    ASSERT_TRUE(prelude.valid());
    ASSERT_TRUE(graph.setNormalExecutionPrelude(prelude));
    EXPECT_FALSE(graph.setNormalExecutionPrelude(prelude));
    const Expected<GpuTaskId> rootResult = AddTask(
        s_GpuCaseTaskGraphPreludeRootBeforeReset,
        "Root Before Reset",
        Span<GpuTaskId>(),
        Span<GpuTaskResourceUse>(),
        Span<GpuTaskResourceSetUse>(),
        Span<GpuTaskResourceVersionUse>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(rootResult.has_value());
    const GpuTaskId root = rootResult.value();
    ASSERT_TRUE(root.valid());
    graph.reset();
    EXPECT_FALSE(graph.setNormalExecutionPrelude(prelude));
    const Expected<GpuTaskId> unguardedRootResult = AddTask(
        s_GpuCaseTaskGraphPreludeRootAfterReset,
        "Root After Reset",
        Span<GpuTaskId>(),
        Span<GpuTaskResourceUse>(),
        Span<GpuTaskResourceSetUse>(),
        Span<GpuTaskResourceVersionUse>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(unguardedRootResult.has_value());
    const GpuTaskId unguardedRoot = unguardedRootResult.value();
    ASSERT_TRUE(unguardedRoot.valid());
    const Expected<GpuTaskId> latePreludeResult = GpuPacketAddPrelude(graph);
    ASSERT_TRUE(latePreludeResult.has_value());
    const GpuTaskId latePrelude = latePreludeResult.value();
    ASSERT_TRUE(latePrelude.valid());
    EXPECT_FALSE(graph.setNormalExecutionPrelude(latePrelude));
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
    ASSERT_TRUE(declarations.valid());
    EXPECT_EQ(declarations.taskAt(unguardedRoot.index).dependencyCount, 0u);
}

void VerifyGpuPacket_NormalExecutionPreludeRejectsNonPrimaryAndDependentRoots(){
    TestArena testArena = TestArena();
    {
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        GpuTaskCommandRequirements transferOnly = GpuPacketPrimaryGraphicsRequirements();
        transferOnly.requiredCapabilities = GpuQueueCapability::Transfer;
        const Expected<GpuTaskId> taskResult = AddTaskWithCommands(
            s_GpuCaseTaskGraphPreludeTransferOnly,
            "Transfer Only Prelude",
            transferOnly,
            GpuPacketPreludeScheduling(),
            GpuTaskTimingMetadata(),
            Span<GpuTaskId>(),
            graph
        );
        ASSERT_TRUE(taskResult.has_value());
        const GpuTaskId task = taskResult.value();
        ASSERT_TRUE(task.valid());
        EXPECT_FALSE(graph.setNormalExecutionPrelude(task));
    }
    {
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        GpuTaskCommandRequirements external = GpuPacketPrimaryGraphicsRequirements();
        external.externalQueue = GraphicsQueue().id;
        const Expected<GpuTaskId> taskResult = AddTaskWithCommands(
            s_GpuCaseTaskGraphPreludeExternal,
            "External Queue Prelude",
            external,
            GpuPacketPreludeScheduling(),
            GpuTaskTimingMetadata(),
            Span<GpuTaskId>(),
            graph
        );
        ASSERT_TRUE(taskResult.has_value());
        const GpuTaskId task = taskResult.value();
        ASSERT_TRUE(task.valid());
        EXPECT_FALSE(graph.setNormalExecutionPrelude(task));
    }
    {
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        const Expected<GpuTaskId> taskResult = AddTaskWithCommands(
            s_GpuCaseTaskGraphPreludeMergeable,
            "Mergeable Prelude",
            GpuPacketPrimaryGraphicsRequirements(),
            GpuTaskSchedulingHint(),
            GpuTaskTimingMetadata(),
            Span<GpuTaskId>(),
            graph
        );
        ASSERT_TRUE(taskResult.has_value());
        const GpuTaskId task = taskResult.value();
        ASSERT_TRUE(task.valid());
        EXPECT_FALSE(graph.setNormalExecutionPrelude(task));
    }
    {
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        const Expected<GpuGraphResourceId> domainResult = AddHazardDomain(graph, s_GpuCaseTaskGraphPreludeResource, "Prelude Resource");
        ASSERT_TRUE(domainResult.has_value());
        const GpuGraphResourceId domain = domainResult.value();
        ASSERT_TRUE(domain.valid());
        Array<GpuTaskResourceUse, 1> uses = Array<GpuTaskResourceUse, 1>();
        uses[0u].resource = domain;
        uses[0u].requiredState = ResourceStates::Common;
        uses[0u].access = GpuTaskResourceAccess::ReadWrite;
        GpuTaskDesc desc = GpuTaskDesc();
        desc.setIdentity(s_GpuCaseTaskGraphPreludeResourceUse);
        desc.setMarkerLabel("Resource Using Prelude");
        desc.setScheduling(GpuPacketPreludeScheduling());
        desc.setResourceUses(uses);
        const Expected<GpuTaskId> taskResult = graph.addTask(desc, GpuPacketPrimaryGraphicsRequirements());
        ASSERT_TRUE(taskResult.has_value());
        const GpuTaskId task = taskResult.value();
        ASSERT_TRUE(task.valid());
        EXPECT_FALSE(graph.setNormalExecutionPrelude(task));
    }
}

void VerifyGpuPacket_CopyBufferTaskRequiresTypedBufferImports(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuGraphResourceId> sourceResult = AddBufferMetadata(graph, s_GpuCaseTaskGraphBuiltInBufferCopySource, "Built-In Buffer Copy Source");
    ASSERT_TRUE(sourceResult.has_value());
    const GpuGraphResourceId source = sourceResult.value();
    const Expected<GpuGraphResourceId> destinationResult = AddBufferMetadata(graph, s_GpuCaseTaskGraphBuiltInBufferCopyDestination, "Built-In Buffer Copy Destination");
    ASSERT_TRUE(destinationResult.has_value());
    const GpuGraphResourceId destination = destinationResult.value();
    ASSERT_TRUE(source.valid());
    ASSERT_TRUE(destination.valid());

    GpuTaskDesc desc = GpuTaskDesc();
    desc.setIdentity(s_GpuCaseTaskGraphBuiltInBufferCopy);
    desc.setMarkerLabel("Built-In Buffer Copy");
    native(mut graph, in desc, in source, in destination){
        const Core::GpuCopyBufferTaskRegion region{ .source = source, .destination = destination, .dataSizeBytes = sizeof(u32) };
        EXPECT_FALSE(graph.addCopyBufferTask(desc, Core::GpuCopyBufferTaskDesc{ .regions = &region, .regionCount = 1u }).has_value());
    }
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);

    EXPECT_EQ(declarations.taskCount(), 0u);
}

void VerifyGpuPacket_AutomaticallyUsesTheOnlyQueueSupportingAllCommandKinds(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuTaskCommandRequirements mixedCommands = GpuTaskCommandRequirements();
    mixedCommands.requiredCapabilities = QueueCapabilities(GpuQueueCapability::Graphics, GpuQueueCapability::Compute);
    const Expected<GpuTaskId> taskResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphMixedCommands,
        "Mixed Commands",
        mixedCommands,
        GpuTaskSchedulingHint(),
        GpuTaskTimingMetadata(),
        Span<GpuTaskId>(),
        graph
    );
    ASSERT_TRUE(taskResult.has_value());
    const GpuTaskId task = taskResult.value();
    ASSERT_TRUE(task.valid());
    Array<GpuPhysicalQueueInfo, 3> queues = Array<GpuPhysicalQueueInfo, 3>();
    queues[0u] = DedicatedTransferQueue();
    queues[1u] = DedicatedComputeQueue();
    queues[2u] = GraphicsQueue();
    const GpuPhysicalQueueTopology topology = MakeGpuPacketTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology));
    native(in assignments, in task, in queues){
        ASSERT_NE(assignments.find(task), nullptr);
        EXPECT_EQ(assignments.find(task)->queue, queues[2u].id);
    }
    Array<GpuPhysicalQueueInfo, 2> incompatibleQueues = Array<GpuPhysicalQueueInfo, 2>();
    incompatibleQueues[0u] = DedicatedComputeQueue();
    incompatibleQueues[1u] = DedicatedTransferQueue();
    const GpuPhysicalQueueTopology incompatibleTopology = MakeGpuPacketTopology(incompatibleQueues);
    EXPECT_FALSE(Assign(assignments, operationScratchArena, graph, analysis, incompatibleTopology));
    EXPECT_EQ(assignments.diagnostic().status, GpuTaskGraphQueueAssignmentStatus::NoCompatibleQueue);
    EXPECT_EQ(assignments.diagnostic().task, task);
}

