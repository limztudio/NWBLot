    context.testWorld.world.entity(inputs[0u].entity).getComponent<StaticCsgMeshComponent>().enabled = true;
    context.testWorld.world.entity(firstCutter).getComponent<CsgCutterComponent>().shapeType = s_CsgShadowCustomShape;
