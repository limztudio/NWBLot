void VerifyUiWindowTests_ContentHeightFitsOnlyFirstUseAndPreservesLaterHostGeometry(mut UiWindowTests self){
    WindowState state = WindowState();
    WindowOptions options = WindowOptions();
    options.initialBounds = Rect(18.0f, 22.0f, 240.0f, 400.0f);
    options.minimumSize = Point(120.0f, 60.0f);
    options.contentHeightFirstUse = true;
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginWindow("window", "Title", state, options));
    ASSERT_TRUE(self.m_builder.label("caption", "One label"));
    EXPECT_FALSE(self.m_builder.button("apply", "Apply"));
    ASSERT_TRUE(self.finishWindow());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const auto foundApply = self.tryTarget(self.id("apply"));
    ASSERT_TRUE(foundApply.has_value());
    const HitTarget apply = foundApply.value();
    EXPECT_FLOAT_EQ(state.bounds.height, apply.rectangle.y + apply.rectangle.height + 6.0f - state.bounds.y);
    EXPECT_LT(state.bounds.height, 400.0f);
    const f32 firstHeight = state.bounds.height;
    options.initialBounds = Rect(500.0f, 500.0f, 500.0f, 500.0f);
    ASSERT_TRUE(self.begin(2u));
    ASSERT_TRUE(self.m_builder.beginWindow("window", "Title", state, options));
    ASSERT_TRUE(self.m_builder.label("caption", "A changed label"));
    ASSERT_TRUE(self.m_builder.label("extra", "Another label"));
    EXPECT_FALSE(self.m_builder.button("apply", "Apply"));
    ASSERT_TRUE(self.finishWindow());
    EXPECT_FLOAT_EQ(state.bounds.x, 18.0f);
    EXPECT_FLOAT_EQ(state.bounds.y, 22.0f);
    EXPECT_FLOAT_EQ(state.bounds.width, 240.0f);
    EXPECT_FLOAT_EQ(state.bounds.height, firstHeight);
    ASSERT_TRUE(self.m_context.commitFrame(2u));
}

