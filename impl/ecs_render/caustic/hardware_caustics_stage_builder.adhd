#include <impl/ecs_render/caustic/caustic_resolve_state.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/global.adhd.h>
#include <impl/ecs_render/raytrace/graph_snapshots.adhd.h>
#include <impl/ecs_render/shared/renderer_frame_bindings.adhd.h>
#include <impl/ecs_render/deferred/deferred_frame_targets.adhd.h>

#include <core/graphics/gpu_timing.h>
#include <core/task/gpu/persistent_state.h>
#include <core/task/gpu/task_graph.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererRayTracingSystem;
class DeferredFrameTargets;
class DeferredLightingGraphResources;

// Hardware caustics stage owns photon plus geometry plus resolve-wavelet declaration.
struct HardwareCausticsStageInputs{
    DeferredFrameTargets& targets;
    const DeferredLightingGraphResources& lightingResources;
    const MeshViewBufferSnapshot& meshViewSnapshot;
    const RayTracingDeferredGraphResourceSnapshot& rayTracingResources;
    const RendererFrameGraphFeatures& features;
    Core::GpuGraphResourceId worldPosition;
    Core::GpuGraphResourceId depth;
    Core::GpuGraphResourceId currentCausticIrradiance;
    Core::GpuGraphResourceId currentBindlessSlots;
    Core::GpuGraphResourceId sceneShading;
    Core::GpuGraphResourceId lights;
    Core::GpuGraphResourceId materialContextSlots;
    Core::GpuGraphResourceId opticalScene;
    Core::GpuGraphResourceSetId hardwareTraceGeometrySet;
    Span<const Core::GpuGraphResourceId> hardwareTraceGeometryResources{};
    Core::GpuGraphResourceSetId traceMaterialSampledTextureSet;
    Core::GpuTaskId graphicsPrefixTask;
    const b8& shadowPreparationReady;
    const Core::GpuExternalCompletionId& historyWriterDrainCompletion;
    Core::GpuPersistentResourceStateCache& accumulatorPersistentState;
    b8 declaresHardwareCaustics = false;
    b8& producerDispatched;
    Core::GpuTimingSubmissionTicket& timingTicket;
    Optional<Core::GpuTimingMeasure>& photonTiming;
    Optional<Core::GpuTimingMeasure>& resolveTiming;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_name("::NWB::Impl::RendererRayTracingSystem")]
extern class RendererRayTracingSystem : NoCopy;
[cpp_name("::NWB::Impl::HardwareCausticsStageInputs")]
extern class HardwareCausticsStageInputs : NoCopy;

class HardwareCausticsStageResult{
    public GpuTaskId hardwareCausticsTask;
    public GpuTaskId causticIrradianceClearTask;
    public GpuTaskId causticAccumulatorBootstrapClearTask;
    public GpuTaskId causticAccumulatorDecayTask;
    public GpuTaskId causticPhotonTask;
    public GpuTaskId causticGeometryTask;
    public GpuTaskId causticResolvePrepareTask;
    public Array<GpuTaskId, s_CausticResolvePassCount> causticResolveWaveletTasks;
    public GpuTaskId causticResolveUpsampleTask;

    public HardwareCausticsStageResult(){}
}

[modular]
class HardwareCausticsStageBuilder : NoCopy{
    private mut GpuTaskGraph m_graph;
    private mut RendererRayTracingSystem m_raytracingSystem;

    public HardwareCausticsStageBuilder(mut GpuTaskGraph graph, mut RendererRayTracingSystem raytracingSystem){
        this.m_graph = graph;
        this.m_raytracingSystem = raytracingSystem;
    }

    public Expected<HardwareCausticsStageResult> declare(in HardwareCausticsStageInputs inputs);
}


