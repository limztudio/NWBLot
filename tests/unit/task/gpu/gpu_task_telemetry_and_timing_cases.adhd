inline constexpr u32 s_GpuTelemetryNameHashLaneCount = s_NameHashLaneCount;

[[nodiscard]] FOUNDATION_INLINE Name MakeGpuTelemetryFlippedHashName(const Name& base, const u32 lane)noexcept{
    NameHash hash = base.hash();
    hash.qwords[lane] ^= 1u;
    return Name(hash);
}

[[nodiscard]] FOUNDATION_INLINE Optional<Core::GpuPhysicalQueueInfo> FindTimingFeedbackQueueValue(
    const Core::GpuTaskGraph::DeclarationReadView& declarations,
    const Core::GpuTaskGraphAnalysis& analysis,
    const AssignmentGraphicsVector& assignments,
    const U32GraphicsVector& assignmentIndices,
    const Core::GpuPhysicalQueueTopology& topology,
    const Core::GpuTaskGraphCompilerDetail::GpuTaskSchedulingReachability& reachability,
    const Core::GpuTaskGraphCompilerDetail::GpuTaskQueueScoringData& scoringData,
    const Core::GpuTaskGraphTaskView& task,
    const Core::GpuPhysicalQueueInfo& incumbent,
    const Core::GpuTaskTimingAssignmentKey& assignmentKey,
    const Core::GpuTaskTimingHistorySnapshot& snapshot,
    const Core::GpuTaskTimingFeedbackPolicy& policy,
    const u64 frameIndex
)noexcept{
    if(const Core::GpuPhysicalQueueInfo* const selected = Core::GpuTaskGraphCompilerDetail::FindTimingFeedbackQueue(
        declarations,
        analysis,
        assignments,
        assignmentIndices,
        topology,
        reachability,
        scoringData,
        task,
        incumbent,
        assignmentKey,
        snapshot,
        policy,
        frameIndex
    ))
        return *selected;
    return {};
}

[[nodiscard]] FOUNDATION_INLINE Optional<Core::GpuTaskTimingHistory> FindStoreTimingHistoryValue(
    const Core::GpuTaskTimingHistoryStore& store,
    const Core::GpuTaskTimingKey& key,
    const Core::GpuPhysicalQueueId& queue
)noexcept{
    if(const Core::GpuTaskTimingHistory* const found = store.find(key, queue))
        return *found;
    return {};
}

[[nodiscard]] FOUNDATION_INLINE Optional<Core::GpuTaskTimingAssignmentState> FindStoreTimingAssignmentValue(
    const Core::GpuTaskTimingHistoryStore& store,
    const Core::GpuTaskTimingAssignmentKey& key
)noexcept{
    if(const Core::GpuTaskTimingAssignmentState* const found = store.findAssignment(key))
        return *found;
    return {};
}

[[nodiscard]] FOUNDATION_INLINE Optional<Core::GpuTaskTimingHistory> FindSnapshotTimingHistoryValue(
    const Core::GpuTaskTimingHistorySnapshot& snapshot,
    const Core::GpuTaskTimingKey& key,
    const Core::GpuPhysicalQueueId& queue
)noexcept{
    if(const Core::GpuTaskTimingHistory* const found = snapshot.find(key, queue))
        return *found;
    return {};
}

[[nodiscard]] FOUNDATION_INLINE Optional<Core::GpuTaskTimingAssignmentState> FindSnapshotTimingAssignmentValue(
    const Core::GpuTaskTimingHistorySnapshot& snapshot,
    const Core::GpuTaskTimingAssignmentKey& key
)noexcept{
    if(const Core::GpuTaskTimingAssignmentState* const found = snapshot.findAssignment(key))
        return *found;
    return {};
}


