#include <impl/ecs_render/reflection/types.adhd>
#include <impl/ecs_render/reflection/history.adhd>
#include <impl/assets_graphics/reflection_subsystem.adhd>
#include <impl/ecs_render/shader/shader_system.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type ReflectionComputeShaderSelector = Func<64u, AssetRef<ComputeShader>(in ReflectionSubsystem)>;

[cpp_header("<impl/assets/graphics/reflection/spatial_constants.h>"), cpp_name("NWB_REFLECTION_SPATIAL_MAX_RADIUS")]
extern const u32 s_ReflectionShaderSpatialMaxRadius;

class ReflectionPostprocessSnapshot{
    public ReflectionHistoryControlHandle control;
    public ReflectionHistoryPlan history;
    public ReflectionRadianceBinding current;
    public ReflectionRadianceBinding previous;
    public ReflectionRadianceBinding spatial;
    public ComputePipelineHandle temporalPipeline;
    public ComputePipelineHandle spatialPipeline;
    public u32 deferredResourcesSlot = 0u;
    public u32 opaqueSpecularSlot = 0u;
    public u32 viewSlot = 0u;
    public b8 spatialEnabled = false;
}

class RendererReflectionPostprocess : NoCopy{
    private SharedPool m_versions = SharedPool();
    private mut GraphicsRuntime m_graphics;
    private mut RendererShaderSystem m_shaders;
    private ReflectionHistoryControlHandle m_control;
    private ReflectionRadianceBinding m_history;
    private ReflectionRadianceBinding m_spatial;
    private BindingLayoutHandle m_layout;
    private ComputePipelineHandle m_temporalPipeline;
    private Array<ComputePipelineHandle, s_ReflectionShaderSpatialMaxRadius> m_spatialPipelines;
    private ShaderHandle m_temporalShader;
    private Array<ShaderHandle, s_ReflectionShaderSpatialMaxRadius> m_spatialShaders;
    private Array<GpuDescriptorHandle, s_ReflectionPostprocessDescriptorCount> m_descriptors;
    private u32 m_width = 0u;
    private u32 m_height = 0u;

    public RendererReflectionPostprocess(mut GraphicsRuntime graphics, mut RendererShaderSystem shaders){
        this.m_graphics = graphics;
        this.m_shaders = shaders;
    }
    public void invalidateResources();
    public b8 prepareResources(in u32 width, in u32 height, in ReflectionSettings settings);
    public ReflectionPostprocessSnapshot snapshot(in ReflectionRadianceBinding base, in ReflectionSceneContentStamp stamp, in ReflectionSettings settings, in u64 graphicsFrameIndex)const;
    private void releaseTargets();
    private b8 preparePipeline(in ReflectionComputeShaderSelector selector, in StringView variant, mut ComputePipelineHandle pipeline, mut ShaderHandle shader);
    private b8 prepareImage(mut ReflectionRadianceBinding image, in u32 descriptorIndex, in Name name);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

