////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_ui/toolkit/widgets/popup.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const f32 s_TooltipDefaultDelaySeconds = 0.5f;
const f32 s_TooltipDefaultMaximumWidth = 320.0f;
const Name s_TooltipNormalRegionName = "tooltip.normal";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TooltipStyle{
    public Name background = s_TooltipNormalRegionName;
    public Name fallback = s_StylePanelNormalRegionName;
    public Insets padding = Insets(s_StyleSpacingMedium, s_StyleFieldPaddingY, s_StyleSpacingMedium, s_StyleFieldPaddingY);
    public Color text;
}

class TooltipOptions{
    public b8 operator==(in TooltipOptions rhs)const{
        return this.enabled == rhs.enabled
            && this.side == rhs.side
            && this.delaySeconds == rhs.delaySeconds
            && this.maximumWidth == rhs.maximumWidth
            && this.gap == rhs.gap;
    }

    public b8 operator!=(in TooltipOptions rhs)const{
        return this.enabled != rhs.enabled
            || this.side != rhs.side
            || this.delaySeconds != rhs.delaySeconds
            || this.maximumWidth != rhs.maximumWidth
            || this.gap != rhs.gap;
    }

    public b8 enabled = true;
    public PopupPlacementSide side = PopupPlacementSide::Below;
    public f32 delaySeconds = s_TooltipDefaultDelaySeconds;
    public f32 maximumWidth = s_TooltipDefaultMaximumWidth;
    public f32 gap = s_StyleSpacingSmall;
}

class TooltipState : NoCopy{
    public u64 m_instanceGeneration = AllocateServiceIdentity();
    public u64 m_revision = 1u;
    public WidgetId m_owner;
    public u64 m_ownerDeclaration = 0u;
    public WidgetId m_anchor;
    public u64 m_declarationGeneration = 0u;
    public PopupToken m_popup;
    public u64 m_focusLossGeneration = 0u;
    public u64 m_hoverActivityGeneration = 0u;
    public TooltipOptions m_options;
    public PopupPlacement m_placement;
    public b8 m_hovered = false;
    public b8 m_visible = false;
    public f64 m_elapsed = 0.0;

    public void reset(){
        AdvanceNonWrappingRevision(this.m_revision);
        ResetTooltipStateFields(
            this.m_owner,
            this.m_ownerDeclaration,
            this.m_anchor,
            this.m_declarationGeneration,
            this.m_popup,
            this.m_focusLossGeneration,
            this.m_hoverActivityGeneration,
            this.m_options,
            this.m_placement,
            this.m_elapsed,
            this.m_hovered,
            this.m_visible
        );
    }

    public u64 instanceGeneration()const{
        return this.m_instanceGeneration;
    }

    public u64 revision()const{
        return this.m_revision;
    }

    public b8 visible()const{
        return this.m_visible;
    }

    public in PopupPlacement placement()const{
        return this.m_placement;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsValidTooltipOptions(in TooltipOptions options){
    return IsFinite(VectorSingle(options.delaySeconds, options.maximumWidth, options.gap, 0.0f).xyz)
        && options.delaySeconds >= 0.0f
        && options.maximumWidth > 0.0f
        && options.gap >= 0.0f
        && options.side <= PopupPlacementSide::Center;
}

void ApplySkinPaletteToTooltipStyle(in UiSkinPalette palette, mut TooltipStyle style){
    style.text = ResolveUiSkinColor(palette, UiSkinColorRole::TextTooltip);
}

Expected<b8> TryEvaluateTooltipStateUpdate(
    in WidgetId anchor,
    in u64 declarationGeneration,
    in PopupToken popup,
    in u64 focusLossGeneration,
    in u64 hoverActivityGeneration,
    in b8 hovered,
    in f32 deltaSeconds,
    in TooltipOptions options,
    mut WidgetId inOutAnchor,
    mut u64 inOutDeclarationGeneration,
    mut PopupToken inOutPopup,
    mut u64 inOutFocusLossGeneration,
    mut u64 inOutHoverActivityGeneration,
    mut TooltipOptions inOutOptions,
    mut PopupPlacement inOutPlacement,
    mut b8 inOutHovered,
    mut b8 inOutVisible,
    mut f64 inOutElapsed
){
    if(!anchor.valid() || declarationGeneration == 0u || (!popup.valid() && !popup.empty()) || !IsFinite(VectorSingle(deltaSeconds)) || deltaSeconds < 0.0f || !IsValidTooltipOptions(options))
        return MakeUnexpected(Failure());
    const b8 sameBinding = inOutAnchor == anchor
        && inOutDeclarationGeneration == declarationGeneration
        && inOutPopup == popup
        && inOutFocusLossGeneration == focusLossGeneration
        && inOutHoverActivityGeneration == hoverActivityGeneration;
    const b8 sameOptions = inOutOptions == options;
    const b8 activeHover = options.enabled && hovered;
    f64 elapsed = 0.0;
    if(activeHover && inOutHovered && sameBinding && sameOptions)
        elapsed = Min(inOutElapsed + cast<f64>(deltaSeconds), cast<f64>(options.delaySeconds));
    const b8 visible = activeHover && elapsed >= cast<f64>(options.delaySeconds);
    b8 changed = false;
    if(!sameBinding || !sameOptions || inOutHovered != activeHover || inOutElapsed != elapsed || inOutVisible != visible){
        changed = true;
        inOutAnchor = anchor;
        inOutDeclarationGeneration = declarationGeneration;
        inOutPopup = popup;
        inOutFocusLossGeneration = focusLossGeneration;
        inOutHoverActivityGeneration = hoverActivityGeneration;
        inOutOptions = options;
        inOutElapsed = elapsed;
        inOutHovered = activeHover;
        inOutVisible = visible;
        if(!visible || !sameBinding || !sameOptions)
            inOutPlacement = PopupPlacement();
    }
    return changed;
}

PopupOptions BuildTooltipPopupOptions(
    in Rect anchorRect,
    in Point measured,
    in Insets padding,
    in UiSkinRegion background,
    in TooltipOptions tooltipOptions
){
    PopupOptions options;
    options.anchor = anchorRect;
    const VectorSingle padded = Max((VectorSingle(measured.x, measured.y, measured.x, measured.y) + VectorSingle(padding.left, padding.top, padding.left, padding.top)) + VectorSingle(padding.right, padding.bottom, padding.right, padding.bottom), VectorSingle(background.minimumWidth, background.minimumHeight, background.minimumWidth, background.minimumHeight));
    const f32 paddedWidth = padded.x;
    const f32 paddedHeight = padded.y;
    options.size = Point(Min(paddedWidth, tooltipOptions.maximumWidth), paddedHeight);
    options.gap = tooltipOptions.gap;
    options.side = tooltipOptions.side;
    return options;
}

void ResetTooltipStateFields(
    mut WidgetId outOwner,
    mut u64 outOwnerDeclaration,
    mut WidgetId outAnchor,
    mut u64 outDeclarationGeneration,
    mut PopupToken outPopup,
    mut u64 outFocusLossGeneration,
    mut u64 outHoverActivityGeneration,
    mut TooltipOptions outOptions,
    mut PopupPlacement outPlacement,
    mut f64 outElapsed,
    mut b8 outHovered,
    mut b8 outVisible
){
    outOwner = WidgetId();
    outOwnerDeclaration = 0u;
    outAnchor = WidgetId();
    outDeclarationGeneration = 0u;
    outPopup = PopupToken();
    outFocusLossGeneration = 0u;
    outHoverActivityGeneration = 0u;
    outOptions = TooltipOptions();
    outPlacement = PopupPlacement();
    outElapsed = 0.0;
    outHovered = false;
    outVisible = false;
}

b8 BindTooltipOwner(
    in WidgetId owner,
    in u64 ownerDeclaration,
    mut WidgetId inOutOwner,
    mut u64 inOutOwnerDeclaration
){
    if(inOutOwner == owner && inOutOwnerDeclaration == ownerDeclaration)
        return false;
    inOutOwner = owner;
    inOutOwnerDeclaration = ownerDeclaration;
    return true;
}

b8 UpdateTooltipState(
    mut TooltipState state,
    in WidgetId anchor,
    in u64 declarationGeneration,
    in PopupToken popup,
    in u64 focusLossGeneration,
    in u64 hoverActivityGeneration,
    in b8 hovered,
    in f32 deltaSeconds,
    in TooltipOptions options
){
    const Expected<b8> changed = TryEvaluateTooltipStateUpdate(
        anchor,
        declarationGeneration,
        popup,
        focusLossGeneration,
        hoverActivityGeneration,
        hovered,
        deltaSeconds,
        options,
        state.m_anchor,
        state.m_declarationGeneration,
        state.m_popup,
        state.m_focusLossGeneration,
        state.m_hoverActivityGeneration,
        state.m_options,
        state.m_placement,
        state.m_hovered,
        state.m_visible,
        state.m_elapsed
    );
    if(!changed.has_value())
        return false;
    if(changed.value())
        AdvanceNonWrappingRevision(state.m_revision);
    return true;
}


