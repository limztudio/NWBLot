[cpp_header("<impl/assets/graphics/bindless/binding_slots.h>"), cpp_name("NWB_BINDLESS_HEAP_RESOURCE_SET")]
extern const u32 s_BindlessResourceSetIndex;

[cpp_header("<impl/assets/graphics/bindless/binding_slots.h>"), cpp_name("NWB_BINDLESS_HEAP_SAMPLER_SET")]
extern const u32 s_BindlessSamplerSetIndex;

[cpp_header("<impl/assets/graphics/bindless/binding_slots.h>"), cpp_name("NWB_BINDLESS_HEAP_ACCEL_STRUCT_SET")]
extern const u32 s_BindlessAccelStructSetIndex;

[cpp_header("<impl/assets/graphics/bindless/binding_slots.h>"), cpp_name("NWB_BINDLESS_HEAP_BINDING_SAMPLED_IMAGE")]
extern const u32 s_BindlessSampledImageBinding;

[cpp_header("<impl/assets/graphics/bindless/binding_slots.h>"), cpp_name("NWB_BINDLESS_HEAP_BINDING_STORAGE_IMAGE")]
extern const u32 s_BindlessStorageImageBinding;

[cpp_header("<impl/assets/graphics/bindless/binding_slots.h>"), cpp_name("NWB_BINDLESS_HEAP_BINDING_SAMPLED_BUFFER")]
extern const u32 s_BindlessSampledBufferBinding;

[cpp_header("<impl/assets/graphics/bindless/binding_slots.h>"), cpp_name("NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER")]
extern const u32 s_BindlessStorageBufferBinding;

[cpp_header("<impl/assets/graphics/bindless/binding_slots.h>"), cpp_name("NWB_BINDLESS_HEAP_BINDING_UNIFORM_BUFFER")]
extern const u32 s_BindlessUniformBufferBinding;

[cpp_header("<impl/assets/graphics/bindless/binding_slots.h>"), cpp_name("NWB_BINDLESS_HEAP_BINDING_SAMPLED_IMAGE_2D_ARRAY")]
extern const u32 s_BindlessSampledImage2DArrayBinding;

[cpp_header("<impl/assets/graphics/bindless/binding_slots.h>"), cpp_name("NWB_BINDLESS_HEAP_BINDING_SAMPLED_IMAGE_3D")]
extern const u32 s_BindlessSampledImage3DBinding;

[cpp_header("<impl/assets/graphics/bindless/binding_slots.h>"), cpp_name("NWB_BINDLESS_HEAP_BINDING_SAMPLED_IMAGE_2D_ARRAY_UINT")]
extern const u32 s_BindlessSampledImage2DArrayUintBinding;

[cpp_header("<impl/assets/graphics/bindless/binding_slots.h>"), cpp_name("NWB_BINDLESS_HEAP_BINDING_SAMPLED_IMAGE_CUBE")]
extern const u32 s_BindlessSampledImageCubeBinding;

[cpp_header("<impl/assets/graphics/bindless/binding_slots.h>"), cpp_name("NWB_BINDLESS_HEAP_BINDING_SAMPLER")]
extern const u32 s_BindlessSamplerBinding;

[cpp_header("<impl/assets/graphics/bindless/binding_slots.h>"), cpp_name("NWB_BINDLESS_HEAP_BINDING_ACCEL_STRUCT")]
extern const u32 s_BindlessAccelStructBinding;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static_assert(s_BindlessResourceSetIndex == 0u);
static_assert(s_BindlessSamplerSetIndex == s_BindlessResourceSetIndex + 1u);
static_assert(s_BindlessAccelStructSetIndex == s_BindlessSamplerSetIndex + 1u);

GpuDescriptorHeapAbi MakeGpuDescriptorHeapAbi(){
    GpuDescriptorHeapAbi abi;
    abi.resourceSetIndex = s_BindlessResourceSetIndex;
    abi.samplerSetIndex = s_BindlessSamplerSetIndex;
    abi.accelStructSetIndex = s_BindlessAccelStructSetIndex;
    abi.sampledImageBinding = s_BindlessSampledImageBinding;
    abi.storageImageBinding = s_BindlessStorageImageBinding;
    abi.sampledBufferBinding = s_BindlessSampledBufferBinding;
    abi.storageBufferBinding = s_BindlessStorageBufferBinding;
    abi.uniformBufferBinding = s_BindlessUniformBufferBinding;
    abi.sampledImage2DArrayBinding = s_BindlessSampledImage2DArrayBinding;
    abi.sampledImage3DBinding = s_BindlessSampledImage3DBinding;
    abi.sampledImage2DArrayUintBinding = s_BindlessSampledImage2DArrayUintBinding;
    abi.sampledImageCubeBinding = s_BindlessSampledImageCubeBinding;
    abi.samplerBinding = s_BindlessSamplerBinding;
    abi.accelStructBinding = s_BindlessAccelStructBinding;
    return abi;
}


