class FloatingPointEnvironmentGuard{
    private FloatingPointEnvironment m_environment;
    private b8 m_active = true;

    public FloatingPointEnvironmentGuard(in FloatingPointEnvironment environment){
        this.m_environment = environment;
    }

    public ~FloatingPointEnvironmentGuard(){
        if(this.m_active){
            const auto restored = SetFloatingPointEnvironment(this.m_environment);
            if(!restored.has_value()){
                assert(false, "Failed to restore floating-point environment");
                TerminateInvariant();
            }
        }
    }

    public void release(){
        this.m_active = false;
    }
}


