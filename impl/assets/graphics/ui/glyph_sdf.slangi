////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_UI_GLYPH_SDF_SLANGI
#define NWB_UI_GLYPH_SDF_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Alpha is an independent distance plane; select one channel without multiplying it into the other pages.
float nwbUiSdfChannel(float4 sampled, uint channel){
    return channel == 0u ? sampled.x : channel == 1u ? sampled.y : channel == 2u ? sampled.z : sampled.w;
}

// FreeType u8 SDF represents zero at 128/255 and positive distance inside the outline.
float nwbUiSdfDistance(float encoded, uint spreadPixels){
    return (encoded * 255.0 - 128.0) * float(spreadPixels) / 128.0;
}

float nwbUiSdfCoverage(float distance, float pixelWidth){
    return saturate(0.5 + distance / max(pixelWidth, 0.001));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

