Expected<ShaderArchiveRecordVector> LoadShaderArchiveRecords(mut TestArena testArena, in GraphicsTestPath outputDirectory){
    VolumeMountDesc mount(testArena.arena);
    EXPECT_TRUE(mount.volumeName.assign("graphics"));
    mount.mountDirectory = outputDirectory;
    const auto mounted = CreateVolumeFilesystem(testArena.arena, mount);
    EXPECT_TRUE(mounted.has_value());
    if(!mounted.has_value())
        return MakeUnexpected(mounted.error());
    AssetBytes binary(testArena.arena);
    const b8 loaded = mounted.value().deref().readFile(s_IndexVirtualPathName, binary);
    EXPECT_TRUE(loaded);
    EXPECT_FALSE(binary.empty());
    if(!loaded || binary.empty())
        return MakeUnexpected(Failure());
    const Expected<ShaderArchiveRecordVector> records = DeserializeIndex(testArena.arena, Span<u8>(binary));
    EXPECT_TRUE(records.has_value());
    return records;
}

