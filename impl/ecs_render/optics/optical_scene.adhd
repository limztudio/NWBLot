class RayTracingOpticalRuntimeBounds{
    public f32x3x4 objectToWorld;
    public BufferHandle buffer;
    public GpuDescriptorHandle descriptor;
    public u32 instanceIndex;

    public RayTracingOpticalRuntimeBounds(){
        this.objectToWorld = f32x3x4();
        this.instanceIndex = 0u;
    }

    public RayTracingOpticalRuntimeBounds(in BufferHandle inBuffer, in GpuDescriptorHandle inDescriptor, in MatrixSingle inObjectToWorld, in u32 inInstanceIndex){
        this.buffer = inBuffer;
        this.descriptor = inDescriptor;
        this.objectToWorld = f32x3x4(inObjectToWorld);
        this.instanceIndex = inInstanceIndex;
    }
}

class RayTracingOpticalSceneGather{
    public RayTracingOpticalSceneHeaderGpu header;
    public Vector<RayTracingOpticalInstanceGpu> instances;
    public Vector<RayTracingOpticalRuntimeBounds> runtimeBounds;
    public b8 hasBounds = false;
    public b8 boundsCompleteExceptRuntime = true;
    public b8 unspecifiedBoundariesOnly = true;

    public RayTracingOpticalSceneGather(){}

    public RayTracingOpticalSceneGather(in usize capacity){
        this.instances.reserve(capacity);
    }

    public void reset(in usize capacity){
        this.header = RayTracingOpticalSceneHeaderGpu();
        this.instances.clear();
        this.runtimeBounds.clear();
        this.instances.reserve(capacity);
        this.hasBounds = false;
        this.boundsCompleteExceptRuntime = true;
        this.unspecifiedBoundariesOnly = true;
    }

    public void append(in EntityID entity, in RendererComponent renderer, in b8 transparent, in VectorSingle boundsMin, in VectorSingle boundsMax, in b8 boundsValid){
        const RayTracingOpticalInstanceGpu instance = BuildRayTracingOpticalInstance(
            entity,
            renderer,
            transparent,
            boundsMin,
            boundsMax,
            boundsValid,
            this.header,
            this.hasBounds,
            this.boundsCompleteExceptRuntime,
            this.unspecifiedBoundariesOnly
        );
        this.instances.push_back(instance);
    }

    public void appendRuntime(in EntityID entity, in RendererComponent renderer, in BufferHandle boundsBuffer, in GpuDescriptorHandle boundsDescriptor, in MatrixSingle objectToWorld){
        const b8 staticComplete = this.boundsCompleteExceptRuntime;
        const u32 instanceIndex = cast<u32>(this.instances.size());
        this.append(entity, renderer, true, VectorSingle(), VectorSingle(), false);
        if(!ValidOpticalRuntimeBoundsHandle(boundsBuffer.valid(), boundsDescriptor.valid(), boundsDescriptor.descriptorClass() == GpuDescriptorClass::StorageBuffer))
            return;
        this.boundsCompleteExceptRuntime = staticComplete;
        this.runtimeBounds.push_back(RayTracingOpticalRuntimeBounds(boundsBuffer, boundsDescriptor, objectToWorld, instanceIndex));
    }

    public void markIncomplete(){
        MarkRayTracingOpticalSceneIncomplete(this.header, this.boundsCompleteExceptRuntime);
    }

    public u64 contentHash()const{
        const OpticalSceneIdentityBuilder builder = OpticalSceneIdentityBuilder();
        u64 hash = builder.baseHash(
            this.header,
            Span<RayTracingOpticalInstanceGpu>(this.instances),
            !this.runtimeBounds.empty(),
            this.boundsCompleteExceptRuntime
        );
        for(in RayTracingOpticalRuntimeBounds bounds : this.runtimeBounds)
            hash = builder.updateRuntimeBounds(hash, MatrixSingle(bounds.objectToWorld), bounds.instanceIndex);
        return hash;
    }
}

static_assert(size_of<RayTracingOpticalSceneHeaderGpu>() == s_ShaderRtOpticalSceneHeaderBytes);
static_assert(offset_of<RayTracingOpticalSceneHeaderGpu>(transparentCount) == s_ShaderRtOpticalSceneTransparentCountOffset);
static_assert(offset_of<RayTracingOpticalSceneHeaderGpu>(flags) == s_ShaderRtOpticalSceneFlagsOffset);
static_assert(size_of<RayTracingOpticalInstanceGpu>() == s_ShaderRtOpticalInstanceBytes);
static_assert(offset_of<RayTracingOpticalInstanceGpu>(mediumPriority) == s_ShaderRtOpticalInstancePriorityOffset);
static_assert(offset_of<RayTracingOpticalInstanceGpu>(boundaryMode) == s_ShaderRtOpticalInstanceBoundaryOffset);
static_assert(offset_of<RayTracingOpticalInstanceGpu>(flags) == s_ShaderRtOpticalInstanceFlagsOffset);
static_assert(s_OpticalBoundsSignBit == s_ShaderOpticalBoundsSignBit);
static_assert(s_OpticalBoundsMagnitudeMask == s_ShaderOpticalBoundsMagnitudeMask);
static_assert(s_OpticalBoundsFractionMask == s_ShaderOpticalBoundsFractionMask);
static_assert(s_OpticalBoundsHiddenBit == s_ShaderOpticalBoundsHiddenBit);
static_assert(s_OpticalBoundsMantissaBits == s_ShaderOpticalBoundsMantissaBits);
static_assert(s_OpticalBoundsExponentBias == s_ShaderOpticalBoundsExponentBias);
static_assert(s_OpticalBoundsOneBits == s_ShaderOpticalBoundsOneBits);
static_assert(s_OpticalBoundsMinInputExponent == s_ShaderOpticalBoundsMinInputExponent);
static_assert(s_OpticalBoundsMaxInputExponent == s_ShaderOpticalBoundsMaxInputExponent);
static_assert(s_OpticalBoundsMaxMagnitudeExponent == s_ShaderOpticalBoundsMaxMagnitudeExponent);
static_assert(s_OpticalBoundsZeroExponent == s_ShaderOpticalBoundsZeroExponent);
static_assert(s_OpticalBoundsFixedBits == s_ShaderOpticalBoundsFixedBits);
static_assert(s_OpticalBoundsRelativeMarginShift == s_ShaderOpticalBoundsRelativeMarginShift);
static_assert(s_OpticalBoundsMinMarginExponent == s_ShaderOpticalBoundsMinMarginExponent);
static_assert(align_of<RayTracingOpticalRuntimeBounds>() >= 16u);
static_assert(offset_of<RayTracingOpticalRuntimeBounds>(objectToWorld) % 16u == 0u);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<OpticalWorldBounds> ComputeOpticalWorldBounds(in MatrixSingle objectToWorld, in VectorSingle localMin, in VectorSingle localMax){
    return OpticalBoundsEvaluator().computeWorldBounds(objectToWorld, localMin, localMax);
}

b8 ValidOpticalRuntimeBoundsHandle(in b8 hasBuffer, in b8 descriptorValid, in b8 isStorageBufferClass){
    return hasBuffer && descriptorValid && isStorageBufferClass;
}

b8 MaterialParticipatesInOpticalVolumeSelection(in b8 transparent, in b8 refractive, in b8 closedBoundary){
    return transparent && (refractive || closedBoundary);
}

usize ComputeOpticalRuntimeInputsByteSize(in usize runtimeCount, in usize inputByteSize){
    return runtimeCount * inputByteSize;
}

usize ComputeOpticalResolvedSceneByteSize(in usize headerBytes, in usize instanceCount, in usize instanceBytes){
    return headerBytes + instanceCount * instanceBytes;
}

b8 ValidOpticalBoundsFinalizeRecordState(
    in b8 hasSource,
    in b8 hasFinalize,
    in b8 hasInputs,
    in b8 commandIrCapture,
    in b8 matchesQueue,
    in b8 hasPipeline,
    in b8 hasInputBuffer,
    in b8 hasOutputBuffer,
    in usize blobByteSize,
    in usize expectedByteSize
){
    return
        hasSource
        && hasFinalize
        && hasInputs
        && !commandIrCapture
        && matchesQueue
        && hasPipeline
        && hasInputBuffer
        && hasOutputBuffer
        && blobByteSize == expectedByteSize
    ;
}

b8 ValidOpticalBoundsFinalizeDeclareInputs(
    in b8 hasFinalize,
    in b8 hasUploadBuffer,
    in b8 sourceValid,
    in usize inputCount,
    in usize boundsBufferCount
){
    return hasFinalize && hasUploadBuffer && sourceValid && inputCount != 0u && inputCount == boundsBufferCount;
}


