////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_ui/toolkit/text/font.adhd>
#include <impl/ecs_ui/toolkit/text/glyph_page.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type AtlasGlyph = AtlasGlyphRecord<SharedFontFace>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class GlyphAtlasKey{
    public u64 faceIdentity;
    public u32 glyphId;
    public u32 pixelSize;

    public GlyphAtlasKey(in u64 faceIdentity, in u32 glyphId, in u32 pixelSize){
        this.faceIdentity = faceIdentity;
        this.glyphId = glyphId;
        this.pixelSize = pixelSize;
    }

    public b8 operator==(in GlyphAtlasKey other)const{
        return this.faceIdentity == other.faceIdentity && this.glyphId == other.glyphId && this.pixelSize == other.pixelSize;
    }

    public usize hash()const{
        return HashCombineValue(HashCombineValue(HashValue(this.faceIdentity), this.glyphId), this.pixelSize);
    }
}

class AtlasPage{
    public SharedFontFace face;
    public GlyphPagePixels pixels;
    public SharedGlyphPage published;
    public u32 cursorX = 0u;
    public u32 cursorY = 0u;
    public u32 rowHeight = 0u;
    public u64 generation = 0u;
    public b8 dirty = false;
    public b8 isColor;

    public AtlasPage(in SharedFontFace face){
        this.face = face;
        this.isColor = false;
        this.pixels.resize(cast<usize>(s_GlyphAtlasPageExtent) * s_GlyphAtlasPageExtent, 0u);
    }

    public AtlasPage(in SharedFontFace face, in b8 isColor){
        this.face = face;
        this.isColor = isColor;
        usize ch = 1u;
        if(isColor)
            ch = 4u;
        this.pixels.resize(cast<usize>(s_GlyphAtlasPageExtent) * s_GlyphAtlasPageExtent * ch, 0u);
    }
}

class GlyphAtlas : NoCopy{
    private SharedPool m_pool = SharedPool();
    private Vector<AtlasGlyph> m_glyphs;
    private HashMap<GlyphAtlasKey, usize> m_index;
    private Vector<AtlasPage> m_pages;
    private GlyphBitmap m_bitmap = GlyphBitmap();
    private u64 m_identity = AllocateServiceIdentity();

    public GlyphAtlas(){
        this.m_glyphs.reserve(s_GlyphAtlasMaxGlyphs);
        this.m_pages.reserve(s_GlyphAtlasMaxPages);
    }

    public void reset(){
        this.m_index.clear();
        this.m_glyphs.clear();
        this.m_pages.clear();
        this.m_identity = AllocateServiceIdentity();
    }

    public usize pageCount()const{ return this.m_pages.size(); }
    public usize glyphCount()const{ return this.m_glyphs.size(); }
    public u64 identity()const{ return this.m_identity; }

    public Optional<in AtlasGlyph> find(in SharedFontFace face, in u32 glyphId, in u32 pixelSize)const{
        if(!face.valid())
            return Optional<in AtlasGlyph>();
        const auto found = this.m_index.find(GlyphAtlasKey(face.deref().faceIdentity(), glyphId, pixelSize));
        if(found == this.m_index.end())
            return Optional<in AtlasGlyph>();
        return Optional<in AtlasGlyph>(this.m_glyphs[found.value()]);
    }

    private void appendGlyph(in AtlasGlyph record){
        const GlyphAtlasKey key(record.face.deref().faceIdentity(), record.glyphId, record.pixelSize);
        const usize index = this.m_glyphs.size();
        this.m_glyphs.push_back(record);
        if(!this.m_index.try_emplace(key, index).second)
            TerminateInvariant();
    }

    public Optional<in AtlasGlyph> prepareAndFind(in SharedFontFace face, in u32 glyphId, in u32 pixelSize){
        if(!face.valid() || !face.deref().valid() || pixelSize == 0u)
            return Optional<in AtlasGlyph>();
        const GlyphAtlasKey key(face.deref().faceIdentity(), glyphId, pixelSize);
        const auto found = this.m_index.find(key);
        if(found != this.m_index.end())
            return Optional<in AtlasGlyph>(this.m_glyphs[found.value()]);
        if(this.m_glyphs.size() >= s_GlyphAtlasMaxGlyphs || !face.deref().rasterize(glyphId, pixelSize, this.m_bitmap))
            return Optional<in AtlasGlyph>();
        AtlasGlyph record;
        record.face = face;
        record.glyphId = glyphId;
        record.pixelSize = pixelSize;
        record.bearingX = this.m_bitmap.bearingX;
        record.bearingY = this.m_bitmap.bearingY;
        record.bitmapScale = this.m_bitmap.bitmapScale;
        record.isColor = this.m_bitmap.isColor;
        if(this.m_bitmap.width == 0u || this.m_bitmap.height == 0u){
            this.appendGlyph(record);
            return Optional<in AtlasGlyph>(this.m_glyphs[this.m_glyphs.size() - 1u]);
        }
        if(!CanPackGlyphBitmapExtent(this.m_bitmap.width, this.m_bitmap.height))
            return Optional<in AtlasGlyph>();
        const u32 paddedWidth = this.m_bitmap.width + s_GlyphAtlasGlyphGutter;
        const u32 paddedHeight = this.m_bitmap.height + s_GlyphAtlasGlyphGutter;
        GlyphAtlasPlacement placement;
        usize pageIndex = 0u;
        while(pageIndex < this.m_pages.size()){
            in AtlasPage existing = this.m_pages[pageIndex];
            if(existing.face == face && existing.isColor == this.m_bitmap.isColor){
                const Expected<GlyphAtlasPlacement> placed = TryPlaceGlyphAtlasBitmap(existing.cursorX, existing.cursorY, existing.rowHeight, paddedWidth, paddedHeight);
                if(placed.has_value()){
                    placement = placed.value();
                    break;
                }
            }
            ++pageIndex;
        }
        if(pageIndex == this.m_pages.size()){
            if(this.m_pages.size() >= s_GlyphAtlasMaxPages)
                return Optional<in AtlasGlyph>();
            this.m_pages.emplace_back(face, this.m_bitmap.isColor);
            placement = MakeInitialGlyphAtlasPlacement(paddedHeight);
        }
        mut AtlasPage page = this.m_pages[pageIndex];
        u32 chCount = 1u;
        if(this.m_bitmap.isColor)
            chCount = 4u;
        record.pageIndex = cast<u32>(pageIndex);
        record.pixels = MakePlacedGlyphAtlasPixelRect(placement.x, placement.y, this.m_bitmap.width, this.m_bitmap.height);
        CopyGlyphBitmapToAtlasPage(placement.x, placement.y, this.m_bitmap.width, this.m_bitmap.height, chCount, this.m_bitmap.pixels, page.pixels);
        page.cursorX = placement.x + paddedWidth;
        page.cursorY = placement.y;
        page.rowHeight = placement.rowHeight;
        page.dirty = true;
        this.appendGlyph(record);
        return Optional<in AtlasGlyph>(this.m_glyphs[this.m_glyphs.size() - 1u]);
    }

    public b8 prepare(in SharedFontFace face, in u32 glyphId, in u32 pixelSize){
        return this.prepareAndFind(face, glyphId, pixelSize).has_value();
    }

    public Expected<SharedGlyphPage> page(in u32 index){
        if(index >= this.m_pages.size())
            return MakeUnexpected(Failure());
        mut AtlasPage page = this.m_pages[index];
        if(page.dirty){
            u32 chCount = 1u;
            if(page.isColor)
                chCount = 4u;
            const Expected<GlyphPageBindingRecord<Font>> binding = TryMakeNextGlyphPageBinding<Font>(page.face.deref().identity(), page.face.deref().generation(), this.m_identity, page.generation, index, chCount);
            if(!binding.has_value())
                return MakeUnexpected(Failure());
            Expected<SharedGlyphPage> published = CopyGlyphPage(this.m_pool, binding.value(), Span<u8>(page.pixels));
            if(!published.has_value())
                return MakeUnexpected(Failure());
            page.published = published.value();
            ++page.generation;
            page.dirty = false;
        }
        return page.published;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CanPackGlyphBitmapExtent(in u32 width, in u32 height){
    const u32 maxGlyphExtent = s_GlyphAtlasPageExtent - s_GlyphAtlasGlyphGutter;
    return width <= maxGlyphExtent && height <= maxGlyphExtent;
}

Rect MakePlacedGlyphAtlasPixelRect(in u32 placementX, in u32 placementY, in u32 width, in u32 height){
    return Rect(cast<f32>(placementX + 1u), cast<f32>(placementY + 1u), cast<f32>(width), cast<f32>(height));
}

GlyphAtlasPlacement MakeInitialGlyphAtlasPlacement(in u32 paddedHeight){
    GlyphAtlasPlacement placement;
    placement.x = 0u;
    placement.y = 0u;
    placement.rowHeight = paddedHeight;
    return placement;
}

Expected<GlyphPageBindingRecord<TFont>> TryMakeNextGlyphPageBinding<TFont>(
    in AssetRef<TFont> font,
    in u64 fontGeneration,
    in u64 atlasIdentity,
    in u64 currentGeneration,
    in u32 pageIndex,
    in u32 channelCount
){
    if(currentGeneration == u64.max)
        return MakeUnexpected(Failure());
    GlyphPageBindingRecord<TFont> binding;
    binding.font = font;
    binding.fontGeneration = fontGeneration;
    binding.atlasIdentity = atlasIdentity;
    binding.generation = currentGeneration + 1u;
    binding.index = pageIndex;
    binding.width = s_GlyphAtlasPageExtent;
    binding.height = s_GlyphAtlasPageExtent;
    binding.channelCount = channelCount;
    return binding;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

