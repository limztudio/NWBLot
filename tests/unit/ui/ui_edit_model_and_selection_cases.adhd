}

void VerifyUiEditCompositionTests_InvalidSurroundingByteRangesPreserveCompositionAndZeroDeletePreservesSelection(mut UiEditCompositionTests self){
    ASSERT_TRUE(self.m_model.setText("a\xCC\x81z"));
    ASSERT_TRUE(self.m_model.setSelection(0u, 3u));
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("x", 0u, 1u));
    const u64 revision = self.m_model.revision();
    EXPECT_FALSE(self.m_model.eraseSurrounding(1u, 0u));
    EXPECT_FALSE(self.m_model.eraseSurrounding(4u, 0u));
    EXPECT_FALSE(self.m_model.eraseSurrounding(0u, 2u));
    ASSERT_TRUE(self.m_model.eraseSurrounding(0u, 0u));
    EXPECT_EQ(self.m_model.text(), "a\xCC\x81z");
    EXPECT_EQ(self.m_model.anchor(), 0u);
    EXPECT_EQ(self.m_model.caret(), 3u);
    EXPECT_EQ(self.m_model.revision(), revision);
    EXPECT_TRUE(self.m_model.composition().active);
    EXPECT_EQ(self.m_model.composition().text, "x");
    EXPECT_FALSE(self.m_model.canUndo());
}

void VerifyUiEditCompositionTests_AcceptedSurroundingDeleteCancelsPreeditWithoutPublishingTransientText(mut UiEditCompositionTests self){
    ASSERT_TRUE(self.m_model.setText("abcd"));
    ASSERT_TRUE(self.m_model.setSelection(2u, 2u));
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("transient", 0u, 9u));
    ASSERT_TRUE(self.m_model.eraseSurrounding(1u, 1u));
    EXPECT_EQ(self.m_model.text(), "ad");
    EXPECT_FALSE(self.m_model.composition().active);
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "abcd");
    EXPECT_EQ(self.m_model.anchor(), 2u);
    EXPECT_EQ(self.m_model.caret(), 2u);
}


