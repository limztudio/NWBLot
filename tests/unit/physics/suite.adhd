        BodyId ragBone0Before;
        {
            mut RagdollComponent rc = ragEnt.getComponent<RagdollComponent>();
            EXPECT_TRUE(rc.initialized);
            EXPECT_FALSE(rc.instance.enableSelfCollision);
            EXPECT_NEAR(ragEnt.getComponent<TransformComponent>().position.y, physSys.physicsWorld().tryGetBodyTransform(rc.instance.boneBodies[0u]).value().position.y - 1.5f, 1.0e-3f);
            rc.enableSelfCollision = true;
            ragBone0Before = rc.instance.boneBodies[0u];
        }

        {
            in VehicleComponent vc = chEnt.getComponent<VehicleComponent>();
            EXPECT_TRUE(vc.initialized);
            ASSERT_EQ(vc.controller.wheelDefs.size(), 1u);
            EXPECT_NEAR(vc.controller.wheelDefs[0u].wheelRadius, 0.35f * 2.5f, 1.0e-4f);
            EXPECT_NEAR(vc.controller.wheelStates[0u].worldTransform.position.y, wheelEnt.getComponent<TransformComponent>().position.y, 1.0e-3f);
        }

        {
            in ArticulationComponent ac = artEnt.getComponent<ArticulationComponent>();
            EXPECT_TRUE(ac.initialized);
            EXPECT_FLOAT_EQ(ac.articulation.linkDefs[1u].jointToChild.position.y, -1.0f);
            const BodyId artStatBodyId = physSys.bodyForEntity(proxyStatEnt.id());
            ASSERT_TRUE(artStatBodyId.valid());
            EXPECT_NEAR(physSys.physicsWorld().tryGetBodyTransform(artStatBodyId).value().position.y, ac.articulation.linkStates[0u].worldTransform.position.y, 1.0e-3f);
        }

        {
            in CharacterControllerComponent cc = charEnt.getComponent<CharacterControllerComponent>();
            EXPECT_TRUE(cc.initialized);
            EXPECT_FLOAT_EQ(cc.controller.def.radius, 0.8f);
            EXPECT_EQ(cc.controller.def.ignoreBodyId, physSys.bodyForEntity(charEnt.id()));
        }

        b8 sawVehicleEvt = false;
        b8 sawCharGroundEvt = false;
        for(u32 step = 0u; step < 30u; ++step){
            charEnt.getComponent<CharacterControllerComponent>().controller.linearVelocity = f32x4(0.0f, -6.0f, 0.0f, 0.0f);
            ASSERT_TRUE(tw.world.tick(dt).has_value());
            if(!physSys.ecsVehicleStateEvents().empty())
                sawVehicleEvt = true;
            if(!physSys.ecsCharacterGroundChangedEvents().empty())
                sawCharGroundEvt = true;
            tw.world.swapMessageBuffers();
            tw.world.consumeMessages<EcsVehicleStateEvent>(lambda[mut sawVehicleEvt](in EcsVehicleStateEvent ev) -> void{ sawVehicleEvt = true; });
            tw.world.consumeMessages<EcsCharacterGroundChangedEvent>(lambda[mut sawCharGroundEvt](in EcsCharacterGroundChangedEvent ev) -> void{ sawCharGroundEvt = true; });
        }
        EXPECT_TRUE(sawVehicleEvt);
        EXPECT_TRUE(sawCharGroundEvt);
        EXPECT_EQ(ragEnt.getComponent<RagdollComponent>().instance.boneBodies[0u], ragBone0Before);
        EXPECT_TRUE(ragEnt.getComponent<RagdollComponent>().instance.enableSelfCollision);

        cfgEnt.getComponent<PhysicsWorldConfigComponent>().interpolateTransforms = true;
        cfgEnt.getComponent<PhysicsWorldConfigComponent>().dirty = true;
        ASSERT_TRUE(physSys.setLinearVelocity(chEnt.id(), VectorSingle(0.0f, 0.0f, 6.0f, 0.0f)));
        ASSERT_TRUE(tw.world.tick(dt).has_value());
        charEnt.getComponent<TransformComponent>().position = f32x4(-12.0f, 9.0f, 0.0f, 0.0f);
        charEnt.getComponent<CharacterControllerComponent>().syncFromTransform = true;
        const f32 wheelZAtStep = chEnt.getComponent<VehicleComponent>().controller.wheelStates[0u].worldTransform.position.z;
        ASSERT_TRUE(tw.world.tick(dt * 0.25f).has_value());
        EXPECT_NEAR(charEnt.getComponent<TransformComponent>().position.y, 9.0f, 1.0e-4f);
        EXPECT_NE(wheelEnt.getComponent<TransformComponent>().position.z, wheelZAtStep);
    }

    {
        EcsTestWorld tw;
