void VerifyUiSliderLifetimeTests_IdenticalPublicValueIntentRetiresAlreadyCopiedKeyboardAndThumbInput(mut UiSliderLifetimeTests self){
    ASSERT_TRUE(self.accept(1u));
    const Point origin = self.thumbPoint();
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(origin, InputEventType::PrimaryDown)).pointerConsumed);
    self.press(UiSliderKey::Right);
    EXPECT_TRUE(self.send(MakeUiSliderPointerEvent(Point(origin.x + 50.0f, origin.y), InputEventType::PointerMove)).pointerConsumed);
    const u64 token = self.m_state.inputGeneration();
    ASSERT_TRUE(self.m_state.setValue(0.25));
    ASSERT_TRUE(self.accept(2u));
    EXPECT_NE(self.m_state.inputGeneration(), token);
    EXPECT_DOUBLE_EQ(self.m_state.value(), 0.25);
    EXPECT_FALSE(self.m_state.result().valueChanged);
    EXPECT_FALSE(self.m_state.result().dragging);
    EXPECT_FALSE(self.m_context.input().capture().valid());
}

void VerifyUiSliderLifetimeTests_PublicValueAwayAndBackDuringTheLoanRejectsTheCandidateWithoutUndoingTheIntent(mut UiSliderLifetimeTests self){
    ASSERT_TRUE(self.accept(1u));
