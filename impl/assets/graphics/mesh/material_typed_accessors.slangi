#ifndef NWB_GRAPHICS_MESH_SHADER_MATERIAL_TYPED_ACCESSORS_SLANGI
#define NWB_GRAPHICS_MESH_SHADER_MATERIAL_TYPED_ACCESSORS_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "../../../assets_material/material_typed_constants.h"
// The typed-load families below unpack half-precision values (nwbUnpackHalf2x16); pull in the math helpers directly so this header is self-sufficient.
#include <common/math.slangi>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


typedef int8_t char;
typedef vector<char, 2> char2;
typedef vector<char, 3> char3;
typedef vector<char, 4> char4;
typedef uint8_t uchar;
typedef vector<uchar, 2> uchar2;
typedef vector<uchar, 3> uchar3;
typedef vector<uchar, 4> uchar4;
typedef int16_t short;
typedef vector<short, 2> short2;
typedef vector<short, 3> short3;
typedef vector<short, 4> short4;
typedef uint16_t ushort;
typedef vector<ushort, 2> ushort2;
typedef vector<ushort, 3> ushort3;
typedef vector<ushort, 4> ushort4;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


uint nwbMaterialLoadRawUIntAtBase(const uint storageByteOffset, const uint byteOffset){
    const uint absoluteByteOffset = storageByteOffset + byteOffset;
    const uint wordIndex = absoluteByteOffset >> NWB_MATERIAL_TYPED_WORD_BYTE_SHIFT;
    const uint byteShift = (absoluteByteOffset & NWB_MATERIAL_TYPED_BYTE_LANE_MASK) * NWB_MATERIAL_TYPED_BYTE_BITS;
    const uint word = g_NwbMaterialTypedWords[wordIndex] >> byteShift;
    if(byteShift == 0u)
        return word;

    return word | (g_NwbMaterialTypedWords[wordIndex + 1u] << ((NWB_MATERIAL_TYPED_WORD_BYTES * NWB_MATERIAL_TYPED_BYTE_BITS) - byteShift));
}

uint nwbMaterialLoadRawSubwordAtBase(const uint storageByteOffset, const uint byteOffset, const uint byteLaneMask, const uint valueMask){
    const uint absoluteByteOffset = storageByteOffset + byteOffset;
    const uint word = g_NwbMaterialTypedWords[absoluteByteOffset >> NWB_MATERIAL_TYPED_WORD_BYTE_SHIFT];
    return (word >> ((absoluteByteOffset & byteLaneMask) * NWB_MATERIAL_TYPED_BYTE_BITS)) & valueMask;
}

uint nwbMaterialLoadRawByteAtBase(const uint storageByteOffset, const uint byteOffset){
    return nwbMaterialLoadRawSubwordAtBase(storageByteOffset, byteOffset, NWB_MATERIAL_TYPED_BYTE_LANE_MASK, NWB_MATERIAL_TYPED_BYTE_MASK);
}

uint nwbMaterialLoadRawUShortAtBase(const uint storageByteOffset, const uint byteOffset){
    return nwbMaterialLoadRawSubwordAtBase(storageByteOffset, byteOffset, NWB_MATERIAL_TYPED_U16_BYTE_LANE_MASK, NWB_MATERIAL_TYPED_U16_MASK);
}

int nwbMaterialSignExtendByte(const uint value){
    return int(value & NWB_MATERIAL_TYPED_SIGNED_BYTE_VALUE_MASK) - int(value & NWB_MATERIAL_TYPED_SIGNED_BYTE_SIGN_MASK);
}

int nwbMaterialSignExtendShort(const uint value){
    return int(value & NWB_MATERIAL_TYPED_SIGNED_U16_VALUE_MASK) - int(value & NWB_MATERIAL_TYPED_SIGNED_U16_SIGN_MASK);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


bool nwbMaterialLoadBoolAtBase(const uint storageByteOffset, const uint byteOffset){
    return nwbMaterialLoadRawByteAtBase(storageByteOffset, byteOffset) != 0u;
}

char nwbMaterialLoadCharAtBase(const uint storageByteOffset, const uint byteOffset){
    return char(nwbMaterialSignExtendByte(nwbMaterialLoadRawByteAtBase(storageByteOffset, byteOffset)));
}

uchar nwbMaterialLoadUCharAtBase(const uint storageByteOffset, const uint byteOffset){
    return uchar(nwbMaterialLoadRawByteAtBase(storageByteOffset, byteOffset));
}

short nwbMaterialLoadShortAtBase(const uint storageByteOffset, const uint byteOffset){
    return short(nwbMaterialSignExtendShort(nwbMaterialLoadRawUShortAtBase(storageByteOffset, byteOffset)));
}

ushort nwbMaterialLoadUShortAtBase(const uint storageByteOffset, const uint byteOffset){
    return ushort(nwbMaterialLoadRawUShortAtBase(storageByteOffset, byteOffset));
}

int nwbMaterialLoadIntAtBase(const uint storageByteOffset, const uint byteOffset){
    return asint(nwbMaterialLoadRawUIntAtBase(storageByteOffset, byteOffset));
}

uint nwbMaterialLoadUIntAtBase(const uint storageByteOffset, const uint byteOffset){
    return nwbMaterialLoadRawUIntAtBase(storageByteOffset, byteOffset);
}

float nwbMaterialLoadFloatAtBase(const uint storageByteOffset, const uint byteOffset){
    return asfloat(nwbMaterialLoadRawUIntAtBase(storageByteOffset, byteOffset));
}

half2 nwbMaterialLoadPackedHalf2AtBase(const uint storageByteOffset, const uint byteOffset){
    return half2(nwbUnpackHalf2x16(nwbMaterialLoadRawUIntAtBase(storageByteOffset, byteOffset)));
}

half nwbMaterialLoadHalfAtBase(const uint storageByteOffset, const uint byteOffset){
    const uint absoluteByteOffset = storageByteOffset + byteOffset;
    const uint word = g_NwbMaterialTypedWords[absoluteByteOffset >> NWB_MATERIAL_TYPED_WORD_BYTE_SHIFT];
    const uint byteLane = absoluteByteOffset & NWB_MATERIAL_TYPED_BYTE_LANE_MASK;
    if(byteLane == 0u || byteLane == NWB_MATERIAL_TYPED_U16_BYTE_LANE_MASK){
        const half2 value = half2(nwbUnpackHalf2x16(word));
        return half(byteLane == 0u ? value.x : value.y);
    }

    return nwbMaterialLoadPackedHalf2AtBase(storageByteOffset, byteOffset).x;
}

half2 nwbMaterialLoadHalf2AtBase(const uint storageByteOffset, const uint byteOffset){
    return nwbMaterialLoadPackedHalf2AtBase(storageByteOffset, byteOffset);
}

half3 nwbMaterialLoadHalf3AtBase(const uint storageByteOffset, const uint byteOffset){
    const half2 xy = nwbMaterialLoadHalf2AtBase(storageByteOffset, byteOffset);
    return half3(xy.x, xy.y, nwbMaterialLoadHalfAtBase(storageByteOffset, byteOffset + NWB_MATERIAL_TYPED_WORD_BYTES));
}

half4 nwbMaterialLoadHalf4AtBase(const uint storageByteOffset, const uint byteOffset){
    const half2 xy = nwbMaterialLoadPackedHalf2AtBase(storageByteOffset, byteOffset);
    const half2 zw = nwbMaterialLoadPackedHalf2AtBase(storageByteOffset, byteOffset + NWB_MATERIAL_TYPED_WORD_BYTES);
    return half4(xy.x, xy.y, zw.x, zw.y);
}

bool2 nwbMaterialLoadBool2AtBase(const uint storageByteOffset, const uint byteOffset){
    return bool2(nwbMaterialLoadBoolAtBase(storageByteOffset, byteOffset + 0u), nwbMaterialLoadBoolAtBase(storageByteOffset, byteOffset + 1u));
}

bool3 nwbMaterialLoadBool3AtBase(const uint storageByteOffset, const uint byteOffset){
    return bool3(nwbMaterialLoadBoolAtBase(storageByteOffset, byteOffset + 0u), nwbMaterialLoadBoolAtBase(storageByteOffset, byteOffset + 1u), nwbMaterialLoadBoolAtBase(storageByteOffset, byteOffset + 2u));
}

bool4 nwbMaterialLoadBool4AtBase(const uint storageByteOffset, const uint byteOffset){
    return bool4(
        nwbMaterialLoadBoolAtBase(storageByteOffset, byteOffset + 0u),
        nwbMaterialLoadBoolAtBase(storageByteOffset, byteOffset + 1u),
        nwbMaterialLoadBoolAtBase(storageByteOffset, byteOffset + 2u),
        nwbMaterialLoadBoolAtBase(storageByteOffset, byteOffset + 3u)
    );
}

