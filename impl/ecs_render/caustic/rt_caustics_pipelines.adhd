#include <impl/global.adhd.h>
#include <impl/assets/graphics/caustic/resolve_binding_slots.h>
#include <impl/assets_graphics/refractive_subsystem.adhd.h>
#include <impl/ecs_render/caustic/caustic_activity_resources.adhd.h>
#include <impl/ecs_render/caustic/caustic_emission_target_buffer.adhd.h>
#include <impl/ecs_render/caustic/caustic_resolve_state.adhd.h>
#include <impl/ecs_render/caustic/graph_types.adhd.h>
#include <impl/ecs_render/caustic/rt_caustics_internal.adhd.h>
#include <impl/ecs_render/kernel/compute_pipeline_utils.adhd.h>
#include <impl/ecs_render/kernel/descriptor_register_utils.adhd.h>
#include <impl/ecs_render/kernel/renderer_constants_private.adhd.h>
#include <impl/ecs_render/mesh/mesh_system.adhd.h>
#include <impl/ecs_render/raytrace/ray_trace_material_resources.adhd.h>
#include <impl/ecs_render/raytrace/raytracing_system.adhd.h>
#include <impl/ecs_render/raytrace/renderer_raytracing_state.adhd.h>
#include <impl/ecs_render/raytrace/rt_private.adhd.h>
#include <impl/ecs_render/shader/shader_system.adhd.h>
#include <impl/ecs_render/shared/renderer_frame_bindings.adhd.h>

