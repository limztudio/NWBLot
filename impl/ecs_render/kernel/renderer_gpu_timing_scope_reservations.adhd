            && ReserveGpuTimingScope(graphics, Name("render.deferred_composite"), s_GpuTimingQueriesPerRange)
            && ReserveGpuTimingScope(graphics, Name("render.deferred_present"), s_GpuTimingQueriesPerRange)
            && ReserveGpuTimingScope(graphics, Name("render.material_upload"), s_GpuTimingQueriesPerRange)
            && ReserveGpuTimingScope(graphics, Name("render.opaque_regular"), s_GpuTimingQueriesPerRange)
            && ReserveGpuTimingScope(graphics, Name("render.opaque_csg_receiver_surface"), s_GpuTimingQueriesPerRange)
