const u32 s_RefractionDiagnosticVariantCount = 2u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CanEnableSurfelSceneTrace(in b8 backendReady, in u32 instanceCount, in u32 meshCount){
    return backendReady && instanceCount > 0u && meshCount > 0u;
}

b8 AreSurfelSplitGraphPipelinesReady(
    in b8 ageFreeReady,
    in b8 hashBuildReady,
    in b8 spawnReady,
    in b8 useHwTrace,
    in b8 useCsgTrace,
    in b8 traceCsgHwReady,
    in b8 traceHwReady,
    in b8 traceCsgSwReady,
    in b8 traceSwReady,
    in b8 resolveReady,
    in b8 upsampleReady,
    in b8 traceBuildArgsReady
){
    b8 traceReady = false;
    if(useHwTrace){
        if(useCsgTrace)
            traceReady = traceCsgHwReady;
        else
            traceReady = traceHwReady;
    }
    else{
        if(useCsgTrace)
            traceReady = traceCsgSwReady;
        else
            traceReady = traceSwReady;
    }
    return ageFreeReady && hashBuildReady && spawnReady && traceReady && resolveReady && upsampleReady && traceBuildArgsReady;
}

RayTraceMaterialContextSlots PackRayTraceMaterialContextSlots(
    in u32 sceneBvhNodes,
    in u32 sceneInstances,
    in u32 instanceMaterial,
    in u32 materialTyped,
    in u32 meshInstances,
    in b8 opticalValid,
    in u32 opticalSlot,
    in u32 opticalInstanceCount,
    in b8 hasCsgContext,
    in u32 csgContextSlot
){
    RayTraceMaterialContextSlots slots;
    slots.sceneBvhNodes = sceneBvhNodes;
    slots.sceneInstances = sceneInstances;
    slots.instanceMaterial = instanceMaterial;
    slots.materialTyped = materialTyped;
    slots.meshInstances = meshInstances;
    if(opticalValid){
        slots.opticalScene = opticalSlot;
        slots.opticalInstanceCount = opticalInstanceCount;
    }
    if(hasCsgContext)
        slots.csgContext = csgContextSlot;
    return slots;
}


