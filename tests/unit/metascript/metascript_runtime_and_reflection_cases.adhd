    EXPECT_EQ(recvCounter, 1);
    EXPECT_EQ(posCounter, 1);
    EXPECT_EQ(countCounter, 1);
    EXPECT_EQ(result.size(), 72u);
    EXPECT_EQ(StringView(result), "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_tail_segm");

    const CompactString compact = CompactString("Header/SubstrPayload/Tail");
