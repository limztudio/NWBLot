#include <logger/server/frame.adhd>
#include <logger/server/server_values.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsDisplayedMessageIndexValid(in usize itemIndex, in usize messageCount){
    return itemIndex < messageCount;
}

b8 CanSynchronizeDisplayedMessageCount(in i64 existingCount, in usize messageCount){
    if(existingCount < 0)
        return false;
    return cast<usize>(existingCount) <= messageCount;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

