b8 IsCurrentRouterControlAction(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in ControlAction action
){
    const Expected<usize> hostIndex = FindTargetIndexInTable(targets, lookup, action.id.target, action.id.declarationGeneration);
    if(!hostIndex.has_value())
        return false;
    const HitTarget host = targets[hostIndex.value()];
    if(
        !IsRouterTargetInteractive(targets, lookup, popups, host)
        || !host.focusable || host.owner.valid()
        || !action.control.valid() || host.control != action.control || host.popup != action.popup
    )
        return false;
    if(action.kind == ControlActionKind::Wheel)
        return host.scrollable;
    if(action.kind != ControlActionKind::Activate){
        if(!host.navigable || ((action.kind == ControlActionKind::Left || action.kind == ControlActionKind::Right) && !host.horizontalNavigation))
            return false;
        if(action.source == host.id)
            return true;
        const Expected<usize> sourceIndex = FindTargetIndexInTable(targets, lookup, action.source, action.sourceDeclarationGeneration);
        if(!sourceIndex.has_value())
            return false;
        const HitTarget source = targets[sourceIndex.value()];
        if(!IsRouterTargetInteractive(targets, lookup, popups, source) || source.control != action.sourceControl)
            return false;
        const Expected<usize> commandHostIndex = TryResolveRouterCommandHostIndex(targets, lookup, popups, source);
        return commandHostIndex.has_value() && commandHostIndex.value() == hostIndex.value();
    }
    const Expected<usize> sourceIndex = FindTargetIndexInTable(targets, lookup, action.source, action.sourceDeclarationGeneration);
    if(!sourceIndex.has_value())
        return false;
    const HitTarget source = targets[sourceIndex.value()];
    return
        IsRouterTargetInteractive(targets, lookup, popups, source) && source.activatable
        && source.owner == host.id && source.ownerDeclarationGeneration == host.declarationGeneration
        && source.control == action.control && source.popup == action.popup && source.value == action.value
    ;
}

Expected<ControlAction> TryConsumeRouterControlAction(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in WidgetId host,
    in u64 declarationGeneration,
    in ControlToken token,
    mut Vector<ControlAction> controlActions
){
    const Expected<usize> targetIndex = FindTargetIndexInTable(targets, lookup, host, declarationGeneration);
    if(declarationGeneration == 0u || !token.valid() || !targetIndex.has_value())
        return MakeUnexpected(Failure());
    const HitTarget target = targets[targetIndex.value()];
    if(!IsRouterTargetInteractive(targets, lookup, popups, target) || target.control != token || target.owner.valid() || !target.focusable)
        return MakeUnexpected(Failure());
    for(usize index = 0u; index < controlActions.size(); ++index){
        const ControlAction candidate = controlActions[index];
        if(candidate.id.target != host || candidate.id.declarationGeneration != declarationGeneration || candidate.control != token || !IsCurrentRouterControlAction(targets, lookup, popups, candidate))
            continue;
        for(usize moveIndex = index + 1u; moveIndex < controlActions.size(); ++moveIndex)
            controlActions[moveIndex - 1u] = controlActions[moveIndex];
        controlActions.pop_back();
        return candidate;
    }
    return MakeUnexpected(Failure());
}

b8 FenceRouterControlTargets(
    in WidgetId host,
    in u64 declarationGeneration,
    in ControlToken token,
    in Span<TargetLookup> lookup,
    mut Vector<HitTarget> targets
){
    const Expected<usize> acceptedIndex = FindTargetIndexInTable(targets, lookup, host, 0u);
    if(!acceptedIndex.has_value())
        return false;
    const HitTarget accepted = targets[acceptedIndex.value()];
    if(accepted.declarationGeneration == declarationGeneration && accepted.control == token)
        return false;
    const b8 preserveText = accepted.declarationGeneration == declarationGeneration && accepted.textEditable && !accepted.owner.valid() && (accepted.scrollable || accepted.control.empty());
    for(usize index = 0u; index < targets.size(); ++index){
        HitTarget target = targets[index];
        if(target.id == host){
            if(preserveText){
                target.control = ControlToken();
                target.scrollable = false;
                target.navigable = false;
                target.horizontalNavigation = false;
            }
            else
                target.enabled = false;
            targets[index] = target;
        }
        else if(target.owner == host){
            target.enabled = false;
            targets[index] = target;
        }
    }
    return true;
}

void ReconcileRouterControlActions(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    mut Vector<ControlAction> controlActions,
    mut Vector<CommandSource> commandSources
){
    usize keptActions = 0u;
    for(usize index = 0u; index < controlActions.size(); ++index){
        if(IsCurrentRouterControlAction(targets, lookup, popups, controlActions[index])){
            if(keptActions != index)
                controlActions[keptActions] = controlActions[index];
            ++keptActions;
        }
    }
    controlActions.resize(keptActions);
    for(usize index = 0u; index < commandSources.size(); ++index){
        CommandSource source = commandSources[index];
        if(!IsCurrentRouterControlCommandOwner(targets, lookup, popups, source)){
            if(source.controlOwner.host.valid())
                source.submitArmed = false;
            source.controlOwner = ControlCommandOwner();
        }
        const Expected<usize> focusedIndex = FindTargetIndexInTable(targets, lookup, source.focusOwner.target, source.focusOwner.declarationGeneration);
        b8 validFocus = false;
        if(focusedIndex.has_value()){
            const HitTarget focused = targets[focusedIndex.value()];
            validFocus = IsRouterTargetInteractive(targets, lookup, popups, focused)
                && focused.popup == source.focusOwner.popup
                && focused.control == source.focusOwner.control;
        }
        if(!validFocus)
            source.focusOwner = TargetOwner();
        commandSources[index] = source;
    }
}

b8 TryRouteRouterControlNavigation(
    in InputEvent event,
    in HitTarget host,
    in HitTarget source,
    in b8 alreadyPressed,
    in u64 layoutGeneration,
    mut CommandSource inOutHeld,
    mut Vector<ControlAction> controlActions,
    mut u64 inOutNextActionSequence,
    mut InputRoutingResult inOutResult
){
    const Expected<ControlActionKind> kind = TryTranslateControlNavigationCommand(event.command, host.horizontalNavigation);
    if(!kind.has_value())
        return false;
    ControlCommandOwner owner = inOutHeld.controlOwner;
    if(!alreadyPressed && !event.repeat){
        owner = ControlCommandOwner(host.id, host.declarationGeneration, host.popup, host.control, kind.value() == ControlActionKind::Left || kind.value() == ControlActionKind::Right);
        inOutHeld.controlOwner = owner;
    }
    if(
        owner.host == host.id && owner.declarationGeneration == host.declarationGeneration
        && owner.popup == host.popup && owner.control == host.control
        && inOutHeld.focusOwner.target == source.id && inOutHeld.focusOwner.declarationGeneration == source.declarationGeneration
        && inOutHeld.focusOwner.popup == source.popup && inOutHeld.focusOwner.control == source.control
    )
        AppendRouterControlAction(host, source, layoutGeneration, kind.value(), 0.0, 0.0, controlActions, inOutNextActionSequence, inOutResult);
    return true;
}

void RouteRouterWheel(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in InputEvent event,
    in b8 hasHit,
    in HitTarget hit,
    in b8 primaryDown,
    in b8 pointerSequenceConsumed,
    in b8 secondaryDown,
    in b8 secondarySequenceConsumed,
    in u64 layoutGeneration,
    mut Vector<ControlAction> controlActions,
    mut u64 inOutNextActionSequence,
    mut InputRoutingResult inOutResult
){
    if(primaryDown)
        inOutResult.pointerConsumed = inOutResult.pointerConsumed || pointerSequenceConsumed;
    else if(secondaryDown)
        inOutResult.pointerConsumed = inOutResult.pointerConsumed || secondarySequenceConsumed;
    else
        inOutResult.pointerConsumed = inOutResult.pointerConsumed || !popups.empty() || hasHit;
    if((primaryDown && !pointerSequenceConsumed) || (secondaryDown && !secondarySequenceConsumed) || !hasHit || (event.scrollX == 0.0 && event.scrollY == 0.0))
        return;
    const Expected<HitTarget> host = TryResolveRouterControlHost(targets, lookup, popups, hit);
    if(host.has_value() && host.value().scrollable && (event.scrollY != 0.0 || host.value().scrollStepX > 0.0))
        AppendRouterControlAction(host.value(), hit, layoutGeneration, ControlActionKind::Wheel, event.scrollY, event.scrollX, controlActions, inOutNextActionSequence, inOutResult);
}


