////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_font_atlas/types.adhd>

native{
namespace NWB::FontBuilderUtility{
using NWB::Impl::s_FontAtlasMinBakePpem;
using NWB::Impl::s_FontAtlasMaxBakePpem;
using NWB::Impl::s_FontAtlasMinSpreadPixels;
using NWB::Impl::s_FontAtlasMaxSpreadPixels;
using NWB::Impl::s_FontAtlasMaxExtent;
using NWB::Impl::s_FontAtlasMaxGroupCount;
using NWB::Impl::s_FontAtlasMaxChannelCount;
using NWB::Impl::s_FontAtlasMaxGlyphCount;
using NWB::Impl::s_FontAtlasMaxPixelBytes;
using NWB::Impl::s_FontAtlasRasterModeBitmap;
using NWB::Impl::s_FontAtlasRasterModeOutline;
using NWB::Impl::ComputeFontAtlasGlyphPlaneBounds;
using NWB::Impl::FontAtlasGlyph;
using NWB::Impl::FontAtlasGroupCompactBounds;
namespace FontAtlasRasterMode = NWB::Impl::FontAtlasRasterMode;
};
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_TrueTypeExtension = ".ttf";
const StringView s_OpenTypeExtension = ".otf";
// One guard pixel on each side keeps neighbouring glyphs from bleeding into each other.
const u32 s_GlyphGuardExtent = 2u;
const u32 s_DefaultBakeExtent = 1024u;
const u32 s_MinBakeExtent = 32u;
const StringView s_PublicationDiagnosticTag = "font_builder_publication";
const Name s_FontBuilderArena = "utilities/font_builder";
const Name s_FontBuilderBakeArena = "utilities/font_builder/bake";
const i32 s_FontBuilderEntryFailure = -1;
const StringView s_FontBuilderAppDescription = "Build readable .nwb font declarations and a paired .font containing shaping bytes and compact SDF images.";
const StringView s_FontOptionFlag = "--font";
const StringView s_OutputOptionFlag = "-o,--output";
const StringView s_PpemOptionFlag = "--ppem";
const StringView s_SpreadOptionFlag = "--spread";
const StringView s_ExtentOptionFlag = "--extent";
const StringView s_MaxGroupsOptionFlag = "--max-groups";
const StringView s_RendererOptionFlag = "--renderer";
const StringView s_OverwriteOptionFlag = "--overwrite";
const usize s_MaxBakeShelfPages = s_FontAtlasMaxGroupCount * s_FontAtlasMaxChannelCount;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class Shelf{
    public u32 x = 0u;
    public u32 y = 0u;
    public u32 height = 0u;
}

class ShelfPlacement{
    public u32 page = 0u;
    public u32 group = 0u;
    public u32 channel = 0u;
    public u32 x = 0u;
    public u32 y = 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 TryPlaceGlyphOnShelf(in u32 width, in u32 height, in u32 extent, mut Shelf inOutShelf, mut u32 outX, mut u32 outY){
    Shelf next = inOutShelf;
    if(next.x + width > extent){
        next.x = 0u;
        next.y += next.height;
        next.height = 0u;
    }
    if(next.y + height > extent)
        return false;
    outX = next.x + 1u;
    outY = next.y + 1u;
    next.x += width;
    if(height > next.height)
        next.height = height;
    inOutShelf = next;
    return true;
}

b8 IsValidBakeNumericOptions(in u32 ppem, in u32 spread, in u32 extent, in u32 maxGroups){
    return
        ppem >= s_FontAtlasMinBakePpem
        && ppem <= s_FontAtlasMaxBakePpem
        && spread >= s_FontAtlasMinSpreadPixels
        && spread <= s_FontAtlasMaxSpreadPixels
        && extent >= s_MinBakeExtent
        && extent <= s_FontAtlasMaxExtent
        && maxGroups != 0u
        && maxGroups <= s_FontAtlasMaxGroupCount
        && cast<u64>(extent) * cast<u64>(extent) * cast<u64>(s_FontAtlasMaxChannelCount) * cast<u64>(maxGroups) <= s_FontAtlasMaxPixelBytes
    ;
}

Expected<b8> TryParseBakeRendererOutline(in StringView rendererArgument){
    if(rendererArgument == s_FontAtlasRasterModeBitmap)
        return false;
    if(rendererArgument == s_FontAtlasRasterModeOutline)
        return true;
    error("font_builder: unknown renderer; choose bitmap or outline");
    return makeUnexpected(Failure());
}

StringView ResolveBakeFreeTypeSdfModule(in b8 outline){
    if(outline)
        return "sdf";
    return "bsdf";
}

f32 ComputeBakeFontLineGapUnits(in i32 height, in i32 ascender, in i32 descender){
    return cast<f32>(height - ascender + descender);
}

b8 IsFontAtlasGlyphPackOrderBefore(in FontAtlasGlyph lhs, in FontAtlasGlyph rhs){
    if(lhs.height != rhs.height)
        return lhs.height > rhs.height;
    if(lhs.width != rhs.width)
        return lhs.width > rhs.width;
    return lhs.glyphId < rhs.glyphId;
}

Expected<ShelfPlacement> TryPlaceGlyphInShelves(
    in u32 width,
    in u32 height,
    in u32 extent,
    in u32 maxGroups,
    mut Array<Shelf, s_MaxBakeShelfPages> inOutShelves
){
    const u32 pageCount = maxGroups * s_FontAtlasMaxChannelCount;
    for(u32 page = 0u; page < pageCount; ++page){
        u32 placedX = 0u;
        u32 placedY = 0u;
        if(!TryPlaceGlyphOnShelf(width, height, extent, inOutShelves[cast<usize>(page)], placedX, placedY))
            continue;
        ShelfPlacement placement;
        placement.page = page;
        placement.group = page / s_FontAtlasMaxChannelCount;
        placement.channel = page % s_FontAtlasMaxChannelCount;
        placement.x = placedX;
        placement.y = placedY;
        return placement;
    }
    return makeUnexpected(Failure());
}

void CopyGlyphToAtlasGroup(
    in Span<u8> glyphPixels,
    in u32 extent,
    in ShelfPlacement placement,
    mut FontAtlasGlyph inOutRecord,
    mut Vector<u8> inOutGroupPixels
){
    inOutRecord.group = placement.group;
    inOutRecord.channel = placement.channel;
    inOutRecord.x = placement.x;
    inOutRecord.y = placement.y;
    for(u32 y = 0u; y < inOutRecord.height; ++y){
        for(u32 x = 0u; x < inOutRecord.width; ++x){
            const usize destination = (cast<usize>(inOutRecord.y + y) * cast<usize>(extent) + cast<usize>(inOutRecord.x + x)) * cast<usize>(s_FontAtlasMaxChannelCount) + cast<usize>(inOutRecord.channel);
            inOutGroupPixels[destination] = glyphPixels[cast<usize>(y) * cast<usize>(inOutRecord.width) + cast<usize>(x)];
        }
    }
}

void CompactFontAtlasGroupPixels(
    in FontAtlasGroupCompactBounds bounds,
    in u32 groupWidth,
    in u32 groupChannelCount,
    in Span<u8> groupPixels,
    mut Vector<u8> outCompactPixels
){
    outCompactPixels.resize(cast<usize>(bounds.width) * cast<usize>(bounds.height) * cast<usize>(bounds.channelCount), 0u);
    for(u32 y = 0u; y < bounds.height; ++y){
        for(u32 x = 0u; x < bounds.width; ++x){
            const usize source = (cast<usize>(bounds.firstY + y) * cast<usize>(groupWidth) + cast<usize>(bounds.firstX + x)) * cast<usize>(groupChannelCount);
            const usize destination = (cast<usize>(y) * cast<usize>(bounds.width) + cast<usize>(x)) * cast<usize>(bounds.channelCount);
            for(u32 channel = 0u; channel < bounds.channelCount; ++channel)
                outCompactPixels[destination + cast<usize>(channel)] = groupPixels[source + cast<usize>(channel)];
        }
    }
}

b8 IsValidBakeFontFaceMetrics(in i64 numGlyphs, in u16 unitsPerEm){
    return numGlyphs > 0 && cast<u64>(numGlyphs) <= s_FontAtlasMaxGlyphCount && unitsPerEm != 0u;
}

FontAtlasRasterMode ResolveBakeFontAtlasRasterMode(in b8 outline){
    if(outline)
        return FontAtlasRasterMode::Outline;
    return FontAtlasRasterMode::Bitmap;
}

b8 ValidateBakeGlyphBitmapFootprint(
    in u32 glyphId,
    in b8 isGrayPixelMode,
    in u32 width,
    in u32 rows,
    in u32 extent,
    in u32 maxGroups,
    in u64 capacity,
    mut u64 inOutRasterBytes,
    mut usize outByteCount
){
    if(!isGrayPixelMode || width + s_GlyphGuardExtent > extent || rows + s_GlyphGuardExtent > extent){
        error("font_builder: glyph {} footprint {}x{} exceeds page {} including guards", glyphId, width + s_GlyphGuardExtent, rows + s_GlyphGuardExtent, extent);
        return false;
    }
    const u64 byteCount = cast<u64>(width) * cast<u64>(rows);
    if(byteCount > capacity - inOutRasterBytes){
        error("font_builder: raster bytes exceed {} group capacity at glyph {}; increase extent or lower ppem", maxGroups, glyphId);
        return false;
    }
    inOutRasterBytes += byteCount;
    outByteCount = cast<usize>(byteCount);
    return true;
}

void PopulateBakeGlyphRecord(
    in u32 width,
    in u32 rows,
    in i32 bitmapLeft,
    in i32 bitmapTop,
    in f32 designPerPixel,
    mut FontAtlasGlyph inOutRecord
){
    inOutRecord.width = width;
    inOutRecord.height = rows;
    inOutRecord.planeLeft = cast<f32>(bitmapLeft) * designPerPixel;
    inOutRecord.planeTop = -cast<f32>(bitmapTop) * designPerPixel;
    ComputeFontAtlasGlyphPlaneBounds(designPerPixel, inOutRecord);
}


