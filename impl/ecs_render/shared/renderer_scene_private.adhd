#include <impl/ecs_render/caustic/settings.adhd>
#include <impl/ecs_render/shadow/light_space_settings.adhd>
#include <impl/ecs_render/shadow/push_constants.adhd>
#include <impl/ecs_render/shadow/slot_selection.adhd>
#include <impl/ecs_render/shared/renderer_push_constants_private.adhd>
#include <impl/ecs_scene/camera.adhd>
#include <impl/ecs_scene/lighting.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<impl/assets/graphics/scene/binding_slots.h>"), cpp_name("NWB_SCENE_MAX_LIGHTS")]
extern const u32 s_ShaderMaxSceneLights;

static_assert(s_SceneMaxLights == s_ShaderMaxSceneLights);
static_assert(size_of<RayTracingLightingClassificationInput>() == size_of<u32>());
static_assert(size_of<RayTracingLightingClassification>() == size_of<u32>() * 2u);
static_assert(size_of<DeferredBindlessResourceSlots>() == size_of<u32>() * 44u, "Deferred bindless slots must match eleven std140 uint4 lanes");


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u32 ResolveSceneLights(mut World world, mut Span<SceneLightGpuData> outLights, mut Span<f32> outCausticImportance){
    const usize capacity = Min(outLights.size(), outCausticImportance.size());
    if(capacity == 0u)
        return 0u;

    const MatrixSingle defaultBasis = BuildDefaultSceneViewBasis();
    Array<SceneLight, s_SceneMaxLights> sceneLights;
    Array<f32, s_SceneMaxLights> shadowImportance;
    const usize count = GatherSceneLights(world, defaultBasis[2], capacity, sceneLights);
    const SceneCameraView cameraView = ResolveSceneCameraView(world, s_CameraFallbackAspectRatio);
    VectorSingle cameraPosition = VectorZero();
    if(cameraView.valid())
        cameraPosition = VectorSingle(cameraView.components.value().transform.position);

    for(usize i = 0u; i < count; ++i){
        in SceneLight src = sceneLights[i];
        f32 causticSlot = s_CausticSlotDisabled;
        if(src.enableCaustics)
            causticSlot = s_ShadowSlotUnassigned;
        outLights[i] = BuildUnassignedSceneLightGpuData(
            LoadFloat(src.position),
            LoadFloat(src.direction),
            LoadFloat(src.colorIntensity),
            src.range,
            cast<f32>(src.type),
            causticSlot,
            src.angularRadius,
            src.sourceRadius,
            cameraPosition,
            outCausticImportance[i],
            shadowImportance[i]
        );
    }

    const u32 lightCount = cast<u32>(count);
    AssignShadowSlotLights(shadowImportance, lightCount, outLights);
    return lightCount;
}

SceneShadingGpuData ResolveSceneShadingState(in f32 fallbackAspectRatio, in u32 lightCount, mut World world){
    const SceneCameraView cameraView = ResolveSceneCameraView(world, fallbackAspectRatio);
    if(cameraView.valid())
        return MakeSceneShadingGpuData(VectorSingle(cameraView.components.value().transform.position), lightCount);
    const MatrixSingle defaultBasis = BuildDefaultSceneViewBasis();
    return MakeSceneShadingGpuData(defaultBasis[3], lightCount);
}


