NWB_ADHD_GTEST(Telemetry, FrameGraphPayloadRejectsHistoricalEmptyPayloads, VerifyTelemetry_FrameGraphPayloadRejectsHistoricalEmptyPayloads)
NWB_ADHD_GTEST(Telemetry, FrameGraphQueueAssignmentPayloadRejectsMalformedRecords, VerifyTelemetry_FrameGraphQueueAssignmentPayloadRejectsMalformedRecords)
NWB_ADHD_GTEST(Telemetry, FrameGraphCompiledTaskPayloadRejectsMalformedRecords, VerifyTelemetry_FrameGraphCompiledTaskPayloadRejectsMalformedRecords)
