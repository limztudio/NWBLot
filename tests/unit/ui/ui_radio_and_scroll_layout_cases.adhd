void VerifyUiScrollLayoutTests_EmptyContentUsesFullPaddedViewportAndEmptyVisibleRange(){
    const auto placementResult = CalculateScrollPlacement(
        Rect(10.0f, 20.0f, 200.0f, 120.0f),
        Rect(0.0f, 0.0f, 400.0f, 300.0f),
        MakeUiRadioScrollInsets(8.0f, 6.0f, 4.0f, 14.0f),
        12.0f,
        16.0f,
        0u,
        20.0f,
        500.0
    );
    ASSERT_TRUE(placementResult.has_value());
    const ScrollPlacement placement = placementResult.value();
    ExpectUiRect(placement.viewport, Rect(18.0f, 26.0f, 188.0f, 100.0f));
    ExpectUiRect(placement.contentClip, placement.viewport);
    ExpectUiRect(placement.track, Rect());
    ExpectUiRect(placement.thumb, Rect());
    EXPECT_DOUBLE_EQ(placement.contentHeight, 0.0);
    EXPECT_DOUBLE_EQ(placement.offset, 0.0);
    EXPECT_DOUBLE_EQ(placement.maxOffset, 0.0);
    EXPECT_EQ(placement.firstRow, 0u);
    EXPECT_EQ(placement.endRow, 0u);
    EXPECT_EQ(placement.rowCount, 0u);
    EXPECT_FALSE(placement.scrollbarVisible);
}

void VerifyUiScrollLayoutTests_ContentExactlyFittingDoesNotReserveScrollbarWidth(){
    const Rect bounds = Rect(10.0f, 20.0f, 200.0f, 100.0f);
    const auto placementResult = CalculateScrollPlacement(bounds, bounds, Insets(), 12.0f, 16.0f, 5u, 20.0f, 10.0);
    ASSERT_TRUE(placementResult.has_value());
    const ScrollPlacement placement = placementResult.value();
    ExpectUiRect(placement.viewport, bounds);
    EXPECT_FALSE(placement.scrollbarVisible);
    EXPECT_DOUBLE_EQ(placement.maxOffset, 0.0);
    EXPECT_DOUBLE_EQ(placement.offset, 0.0);
    EXPECT_EQ(placement.firstRow, 0u);
    EXPECT_EQ(placement.endRow, 5u);
}

void VerifyUiScrollLayoutTests_OverscrollClampsThumbToTheFinalVisibleRow(){
