NWB_IMPL_UI_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Stateless queries borrow immutable layout and atlas metadata.
namespace TextGlyphVisibility{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] NWB_INLINE const BakedFontAtlas* SelectAtlas(const PlacedGlyph& glyph, const f32 physicalSize)noexcept{
    if(!glyph.face || !glyph.face->valid())
        return nullptr;
    const SharedBakedFontAtlas& atlas = glyph.face->bakedAtlas();
    if(!atlas || !atlas->valid() || !CanUseBakedFontAtlasAtPhysicalSize(atlas->bakePpem(), physicalSize) || !atlas->glyph(glyph.glyphId))
        return nullptr;
    return atlas.get();
}

[[nodiscard]] NWB_INLINE Expected<SIMDVectorDoubleResult> LoadAtlasRectangle(const PlacedGlyph& glyph, const BakedFontAtlas& atlas, const f32 fontSize, const Point& topLeft)noexcept{
    if(!atlas.valid())
        return MakeUnexpected(Failure{});
    const FontAtlasGlyph* record = atlas.glyph(glyph.glyphId);
    if(!record)
        return MakeUnexpected(Failure{});
    return TryLoadGlyphAtlasRectangle(glyph.position, topLeft, fontSize, atlas.unitsPerEm(), *record);
}

[[nodiscard]] NWB_INLINE Expected<Rect> AtlasRectangle(const PlacedGlyph& glyph, const BakedFontAtlas& atlas, const f32 fontSize, const Point& topLeft)noexcept{
    const auto rectangle = LoadAtlasRectangle(glyph, atlas, fontSize, topLeft);
    if(!rectangle)
        return MakeUnexpected(rectangle.error());
    return ToTextGlyphAtlasRect(rectangle->value);
}

// Coverage needs explicit bounds or a valid native face; untrusted native bounds retain conservative preparation.
[[nodiscard]] NWB_INLINE TextGlyphIntersection::Enum Candidate(const PlacedGlyph& glyph, const BakedFontAtlas* const selectedAtlas, const f32 fontSize, const f32 physicalSize, const Point& topLeft, const Rect& clip, const Point pixelScale = { 1.0f, 1.0f })noexcept{
    const TextGlyphIntersection::Enum inputStatus = ValidateTextGlyphCandidateInputs(glyph.position, topLeft, fontSize, physicalSize, clip, pixelScale);
    if(inputStatus != TextGlyphIntersection::Visible)
        return inputStatus;
    if(selectedAtlas){
        const auto rectangle = LoadAtlasRectangle(glyph, *selectedAtlas, fontSize, topLeft);
        if(!rectangle)
            return TextGlyphIntersection::Invalid;
        return IntersectGlyphAtlasRectangle(rectangle->value, clip);
    }
    const b8 hasValidFace = glyph.face && glyph.face->valid();
    const b8 coverageInkReliable = hasValidFace && glyph.face->coverageInkReliable();
    const u32 faceUnitsPerEm = hasValidFace ? glyph.face->unitsPerEm() : 1u;
    return EvaluateUnselectedAtlasGlyphCandidate(glyph.position, topLeft, glyph.ink, glyph.coverage, hasValidFace, coverageInkReliable, faceUnitsPerEm, fontSize, physicalSize, clip, pixelScale);
}

[[nodiscard]] NWB_INLINE Expected<Rect> CoverageRectangle(const PlacedGlyph& glyph, const AtlasGlyph& record, const f32 rasterScale, const Point& topLeft, const Point pixelScale = { 1.0f, 1.0f })noexcept{
    return TryResolveGlyphCoverageRectangle(glyph.position, record.pageIndex, record.pixels, record.bearingX, record.bearingY, rasterScale, topLeft, pixelScale);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


