    const f32 physicalSize,
    const ::NWB::Impl::Ui::Point& origin,
    const ::NWB::Impl::Ui::Rect& clip
)noexcept{
    return ::NWB::Impl::Ui::TextGlyphVisibility::Candidate(glyph, atlas.get(), fontSize, physicalSize, origin, clip);
}

[[nodiscard]] FOUNDATION_INLINE Expected<Rect> UiTextGlyphAtlasRect(
    const ::NWB::Impl::Ui::PlacedGlyph& glyph,
    const ::NWB::Impl::Ui::SharedBakedFontAtlas& atlas,
    const f32 fontSize,
    const ::NWB::Impl::Ui::Point& origin
)noexcept{
    return ::NWB::Impl::Ui::TextGlyphVisibility::AtlasRectangle(glyph, *atlas, fontSize, origin);
}

[[nodiscard]] FOUNDATION_INLINE StringView MakeUiTextLayoutNullByteView()noexcept{
    return StringView("\0", 1u);
}
