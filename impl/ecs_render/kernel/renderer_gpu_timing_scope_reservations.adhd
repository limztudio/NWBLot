            && ReserveGpuTimingScope(graphics, Name("render.shadow_transparent_gather"), s_GpuTimingHighFrequencyScopeQueryBudget)
            && ReserveGpuTimingScope(graphics, Name("render.shadow_transparent_evaluate"), s_GpuTimingHighFrequencyScopeQueryBudget)
            && ReserveGpuTimingScope(graphics, Name("render.shadow_transparent_continuation"), s_GpuTimingHighFrequencyScopeQueryBudget)
            && ReserveGpuTimingScope(graphics, Name("render.shadow_transparent_temporal"), s_GpuTimingQueriesPerRange)
            && ReserveGpuTimingScope(graphics, Name("render.shadow_transparent_resolve"), s_GpuTimingQueriesPerRange)
            && ReserveGpuTimingScope(graphics, Name("render.sw_bvh_sort"), s_GpuTimingQueriesPerTwoRangeScope)
            && ReserveGpuTimingScope(graphics, Name("render.caustic_photons"), s_GpuTimingQueriesPerRange)
