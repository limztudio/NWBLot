////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_ui/toolkit/paint_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_LayoutNoParent = 0xffffffffu;
const u32 s_LayoutMaxNodes = 4096u;
const u32 s_LayoutInitialReserve = 64u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> LayoutDirection{
    Leaf,
    Row,
    Column,
    Overlay,
}

enum<u32> LayoutSizePolicy{
    Fixed,
    Content,
    Stretch,
}

class LayoutSize{
    public LayoutSizePolicy policy = LayoutSizePolicy::Content;
    public f32 value = 0.0f;
}

class LayoutNodeDesc{
    public LayoutDirection direction = LayoutDirection::Leaf;
    public b8 clipChildren = true;
    public LayoutSize width;
    public LayoutSize height;
    public Insets padding;
    public f32 gap = 0.0f;
    public Point intrinsicSize;
}

class LayoutBox{
    public Rect rectangle;
    public Rect content;
    public Rect clip;
    public Rect hit;
    public Point measuredSize;
}

class LayoutTreeNode{
    public LayoutTreeNode(){
        this.firstChild = s_LayoutNoParent;
        this.lastChild = s_LayoutNoParent;
        this.nextSibling = s_LayoutNoParent;
    }

    public LayoutTreeNode(in LayoutNodeDesc inDescription){
        this.description = inDescription;
        this.firstChild = s_LayoutNoParent;
        this.lastChild = s_LayoutNoParent;
        this.nextSibling = s_LayoutNoParent;
    }

    public LayoutNodeDesc description;
    public u32 firstChild;
    public u32 lastChild;
    public u32 nextSibling;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

