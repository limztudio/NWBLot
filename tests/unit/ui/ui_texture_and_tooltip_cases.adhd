        ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.5f, options));
        ASSERT_TRUE(state.visible());
        ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 100.0f, replacement));
        EXPECT_FALSE(state.visible());
        ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.5f, replacement));
        EXPECT_TRUE(state.visible());
    }
}

void VerifyUiTooltipBehaviorTests_FiniteMaximumLimitsAndMaximumDelayAreAcceptedWithoutOverflow(){
    const WidgetId anchor = MakeUiTooltipAnchor();
    const f32 maxF32 = bit_cast<f32>(s_UiTextureMaxF32Bits);
    TooltipState zeroDelay = TooltipState();
    TooltipOptions extreme = TooltipOptions();
    extreme.delaySeconds = 0.0f;
    extreme.maximumWidth = maxF32;
    extreme.gap = maxF32;
    extreme.side = PopupPlacementSide::Right;
    ASSERT_TRUE(TooltipBehavior::Update(zeroDelay, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.0f, extreme));
    EXPECT_TRUE(zeroDelay.visible());
    TooltipState state = TooltipState();
    TooltipOptions options = TooltipOptions();
    options.delaySeconds = maxF32;
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.0f, options));
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, maxF32, options));
    EXPECT_TRUE(state.visible());
}

void VerifyUiTooltipBehaviorTests_InvalidTimingPreservesTheOldBindingAndItsAccumulatedDelay(){
    Array<f32, 4u> invalidDeltas;
    invalidDeltas[0u] = -1.0f;
    invalidDeltas[1u] = bit_cast<f32>(s_UiTextureQuietNaNF32Bits);
    invalidDeltas[2u] = bit_cast<f32>(s_UiTexturePosInfF32Bits);
    invalidDeltas[3u] = bit_cast<f32>(s_UiTextureNegInfF32Bits);
    const TooltipOptions options = TooltipOptions();
    const WidgetId anchor = MakeUiTooltipAnchor();
    const PopupToken popup = MakeUiTooltipPopup();
    for(usize index = 0u; index < invalidDeltas.size(); ++index){
        const f32 delta = invalidDeltas[index];
        TooltipState state = TooltipState();
        ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.0f, options));
        ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.25f, options));
        const u64 revision = state.revision();
        EXPECT_FALSE(TooltipBehavior::Update(state, WidgetId(202u), s_UiTooltipDeclaration + 1u, popup, 1u, 0u, false, delta, options));
        EXPECT_FALSE(state.visible());
        EXPECT_EQ(state.revision(), revision);
        ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.25f, options));
        EXPECT_TRUE(state.visible());
    }
}

void VerifyUiTooltipBehaviorTests_InvalidOptionsAreRejectedBeforeAnyBindingOrDelayMutation(){
    Array<TooltipOptions, 12u> invalid;
    invalid[0u].delaySeconds = -1.0f;
    invalid[1u].delaySeconds = bit_cast<f32>(s_UiTextureQuietNaNF32Bits);
    invalid[2u].delaySeconds = bit_cast<f32>(s_UiTexturePosInfF32Bits);
    invalid[3u].maximumWidth = 0.0f;
    invalid[4u].maximumWidth = -1.0f;
    invalid[5u].maximumWidth = bit_cast<f32>(s_UiTextureQuietNaNF32Bits);
    invalid[6u].maximumWidth = bit_cast<f32>(s_UiTexturePosInfF32Bits);
    invalid[7u].gap = -1.0f;
    invalid[8u].gap = bit_cast<f32>(s_UiTextureQuietNaNF32Bits);
    invalid[9u].gap = bit_cast<f32>(s_UiTexturePosInfF32Bits);
    invalid[10u].side = cast<PopupPlacementSideEnum>(255u);
    invalid[11u].enabled = false;
    invalid[11u].maximumWidth = 0.0f;
    const TooltipOptions options = TooltipOptions();
    const WidgetId anchor = MakeUiTooltipAnchor();
    const PopupToken popup = MakeUiTooltipPopup();
    for(usize index = 0u; index < invalid.size(); ++index){
        const TooltipOptions rejected = invalid[index];
        TooltipState state = TooltipState();
        ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.0f, options));
        ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.25f, options));
        const u64 revision = state.revision();
        EXPECT_FALSE(TooltipBehavior::Update(state, WidgetId(202u), s_UiTooltipDeclaration + 1u, popup, 1u, 0u, false, 0.5f, rejected));
        EXPECT_FALSE(state.visible());
        EXPECT_EQ(state.revision(), revision);
        ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.25f, options));
        EXPECT_TRUE(state.visible());
    }
}

void VerifyUiTooltipBehaviorTests_InvalidAnchorsDeclarationsAndPartialPopupTokensPreserveState(){
    const WidgetId anchor = MakeUiTooltipAnchor();
    const PopupToken popup = MakeUiTooltipPopup();
    Array<UiTooltipTestBinding, 7u> invalid;
    invalid[0u] = MakeUiTooltipTestBinding(WidgetId(), s_UiTooltipDeclaration, popup);
    invalid[1u] = MakeUiTooltipTestBinding(anchor, 0u, popup);
    invalid[2u] = MakeUiTooltipTestBinding(anchor, s_UiTooltipDeclaration, MakeUiTooltipPartialPopup(WidgetId(), 19u, 23u, 7u));
    invalid[3u] = MakeUiTooltipTestBinding(anchor, s_UiTooltipDeclaration, MakeUiTooltipPartialPopup(popup.widget, 0u, 23u, 7u));
    invalid[4u] = MakeUiTooltipTestBinding(anchor, s_UiTooltipDeclaration, MakeUiTooltipPartialPopup(popup.widget, 19u, 0u, 7u));
    invalid[5u] = MakeUiTooltipTestBinding(anchor, s_UiTooltipDeclaration, MakeUiTooltipPartialPopup(popup.widget, 19u, 23u, 0u));
    invalid[6u] = MakeUiTooltipTestBinding(anchor, s_UiTooltipDeclaration, MakeUiTooltipPartialPopup(popup.widget, 0u, 0u, 0u));
    const TooltipOptions options = TooltipOptions();
    for(usize index = 0u; index < invalid.size(); ++index){
        const UiTooltipTestBinding rejected = invalid[index];
        TooltipState state = TooltipState();
        ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.0f, options));
        ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.25f, options));
        const u64 revision = state.revision();
        EXPECT_FALSE(TooltipBehavior::Update(state, rejected.anchor, rejected.declaration, rejected.popup, 1u, 0u, false, 0.5f, options));
        EXPECT_FALSE(state.visible());
        EXPECT_EQ(state.revision(), revision);
        ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.25f, options));
        EXPECT_TRUE(state.visible());
    }
}

void VerifyUiTooltipBehaviorTests_InvalidUpdatesCannotHideAnAlreadyVisibleTooltip(){
    TooltipState state = TooltipState();
    TooltipOptions options = TooltipOptions();
    options.delaySeconds = 0.0f;
    const WidgetId anchor = MakeUiTooltipAnchor();
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.0f, options));
    ASSERT_TRUE(state.visible());
    const u64 revision = state.revision();
    options.enabled = false;
    options.maximumWidth = 0.0f;
    EXPECT_FALSE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, false, 0.0f, options));
    EXPECT_TRUE(state.visible());
    EXPECT_EQ(state.revision(), revision);
}

void VerifyUiTooltipBehaviorTests_ExplicitResetInvalidatesEvenAnAlreadyHiddenStateWithoutReplacingItsInstance(){
    TooltipState state = TooltipState();
    const u64 instance = state.instanceGeneration();
    const u64 revision = state.revision();
    state.reset();
    EXPECT_EQ(state.instanceGeneration(), instance);
    EXPECT_GT(state.revision(), revision);
    EXPECT_FALSE(state.visible());
    const u64 resetRevision = state.revision();
    state.reset();
    EXPECT_GT(state.revision(), resetRevision);
    EXPECT_EQ(state.instanceGeneration(), instance);
}

void VerifyUiTooltipBehaviorTests_ExplicitResetRetiresVisibleStateAndAllAccumulatedHoverTime(){
    TooltipState state = TooltipState();
    const TooltipOptions options = TooltipOptions();
    const WidgetId anchor = MakeUiTooltipAnchor();
    const PopupToken popup = MakeUiTooltipPopup();
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, popup, 5u, 0u, true, 0.0f, options));
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, popup, 5u, 0u, true, 0.5f, options));
    ASSERT_TRUE(state.visible());
    const u64 revision = state.revision();
    state.reset();
    EXPECT_FALSE(state.visible());
    EXPECT_GT(state.revision(), revision);
    EXPECT_FLOAT_EQ(state.placement().bounds.width, 0.0f);
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, popup, 5u, 0u, true, 100.0f, options));
    EXPECT_FALSE(state.visible());
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, popup, 5u, 0u, true, 0.25f, options));
    EXPECT_FALSE(state.visible());
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, popup, 5u, 0u, true, 0.25f, options));
    EXPECT_TRUE(state.visible());
}


