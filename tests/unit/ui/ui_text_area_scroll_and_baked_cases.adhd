void VerifyUiTextAreaViewTests_SuppressedCaretRevealPreservesBothRequestedAxesAndHitMapping(mut UiTextAreaViewTests self){
    ASSERT_TRUE(self.prepareDense());
    ASSERT_TRUE(self.manualPlace(Point(5.0f, 6.0f)));
    EXPECT_FLOAT_EQ(self.m_placement.scroll, 5.0f);
    EXPECT_FLOAT_EQ(self.m_placement.scrollY, 6.0f);
    EXPECT_FLOAT_EQ(self.m_placement.textOrigin.x, 5.0f);
    EXPECT_FLOAT_EQ(self.m_placement.textOrigin.y, 14.0f);
    const VectorSingle clipEnd = VectorSingle(self.m_placement.clip.x, self.m_placement.clip.y, 0.0f, 0.0f) + VectorSingle(self.m_placement.clip.width, self.m_placement.clip.height, 0.0f, 0.0f);
    EXPECT_GT(self.m_placement.caret.x, clipEnd.x);
    EXPECT_GT(self.m_placement.caret.y, clipEnd.y);
    const auto hit = self.m_view.hitTest(Point(15.0f, 20.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), 1u);
}

void VerifyUiTextAreaViewTests_SuppressedRevealStillClampsToBothContentExtents(mut UiTextAreaViewTests self){
