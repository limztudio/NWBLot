#include <impl/ecs_ui/toolkit/text/shaper_glyph_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsTextAsciiAlphaNumericOrHyphen(in u32 codePoint){
    return IsAsciiAlpha(codePoint) || (codePoint >= 0x30u && codePoint <= 0x39u) || codePoint == 0x2du;
}

b8 IsValidFontDescriptor(in FontDescriptor desc){
    return desc.weight >= FontWeight::Thin && desc.weight <= FontWeight::Black && desc.slant <= FontSlant::Oblique;
}

b8 IsValidOpenTypeFeatures(in Array<OpenTypeFeature, s_TextMaxOpenTypeFeatures> features, in u8 count){
    if(cast<usize>(count) > s_TextMaxOpenTypeFeatures)
        return false;
    for(usize i = 0u; i < cast<usize>(count); ++i){
        in OpenTypeFeature f = features[i];
        if(f.tag == 0u || f.start > f.end)
            return false;
    }
    return true;
}

TextLayoutStatus ValidateTextRequest(in ShapeRequest request, in b8 allowLineBreaks){
    if(
        request.text.size() > s_TextMaxBytes
        || !IsFinite(VectorSingle(request.fontSize, request.maxWidth, 0.0f, 0.0f).xy)
        || !IsFinite(VectorSingle(request.letterSpacing, request.wordSpacing, request.lineHeightMultiplier, request.lineHeightOverride))
        || request.fontSize < 1.0f / s_TextFixedPointScale
        || request.fontSize > s_TextMaxFontSize
        || request.lineHeightMultiplier <= 0.0f
        || request.lineHeightMultiplier > s_TextMaxLineHeightMultiplier
        || request.lineHeightOverride < 0.0f
        || request.lineHeightOverride > s_TextMaxFontSize * 4.0f
        || request.maxWidth < 0.0f
        || !IsValidFontDescriptor(request.font)
        || !IsValidOpenTypeFeatures(request.features, request.featureCount)
        || request.scriptTag == 0u
        || request.language.empty()
        || request.language.size() > s_TextMaxLanguageBytes
        || (request.direction != TextDirection::LeftToRight && request.direction != TextDirection::RightToLeft)
        || request.bidiMode > TextBidiMode::ForceRightToLeft
        || request.wrapMode > TextWrapMode::Character
        || request.alignment > TextAlignment::Trailing
        || request.tabStopSpaces == 0u
        || request.tabStopSpaces > s_TextMaxTabStopSpaces
    )
        return TextLayoutStatus::InvalidParameters;
    for(u32 byte = 0u; byte < s_ScriptTagLetterCount; ++byte){
        const u32 letter = (request.scriptTag >> (byte * s_ScriptTagBitsPerByte)) & s_ScriptTagLetterMask;
        if(!IsAsciiAlpha(letter))
            return TextLayoutStatus::InvalidParameters;
    }
    for(usize i = 0u; i < request.language.size(); ++i){
        if(!IsTextAsciiAlphaNumericOrHyphen(cast<u32>(cast<u8>(request.language[i]))))
            return TextLayoutStatus::InvalidParameters;
    }
    const StringView text = request.text;
    usize offset = 0u;
    while(offset < text.size()){
        u32 scalar = 0u;
        usize byteCount = 0u;
        if(!TryDecodeUtf8Scalar(text.substr(offset), scalar, byteCount) || scalar == 0u)
            return TextLayoutStatus::InvalidUtf8;
        offset += byteCount;
        if(scalar == '\r'){
            if(!allowLineBreaks || offset == text.size() || text[offset] != '\n')
                return TextLayoutStatus::UnsupportedControl;
        }
        else if(scalar == '\n'){
            if(!allowLineBreaks)
                return TextLayoutStatus::UnsupportedControl;
        }
        else if(scalar == s_TextUnicodeTab){
            continue;
        }
        else if(scalar < s_TextUnicodeSpace || (scalar >= s_TextUnicodeDelete && scalar <= s_TextUnicodeC1Last) || scalar == s_TextUnicodeLineSeparator || scalar == s_TextUnicodeParagraphSeparator){
            return TextLayoutStatus::UnsupportedControl;
        }
    }
    return TextLayoutStatus::Success;
}

usize FindClusterEnd(in Span<RawShapedGlyph> glyphs, in usize begin){
    usize end = begin + 1u;
    while(end < glyphs.size() && glyphs[end].byteBegin == glyphs[begin].byteBegin)
        ++end;
    return end;
}

b8 ClusterHasMissingGlyph(in Span<RawShapedGlyph> glyphs, in usize begin, in usize end){
    for(usize index = begin; index < end; ++index){
        if(glyphs[index].glyphId == 0u)
            return true;
    }
    return false;
}

b8 FitsTextCoordinate(in f64 value){
    return IsFinite(VectorDouble(cast<f64>(value))) && value >= -s_TextMaxCoordinateF64 && value <= s_TextMaxCoordinateF64;
}

b8 IsValidTextFontSize(in f32 fontSize){
    return IsFinite(VectorSingle(fontSize)) && fontSize >= 1.0f / s_TextFixedPointScale && fontSize <= s_TextMaxFontSize;
}

b8 SameShapeRequest(in ShapeRequest lhs, in ShapeRequest rhs){
    if(
        lhs.text != rhs.text
        || lhs.language != rhs.language
        || lhs.font != rhs.font
        || lhs.fontSize != rhs.fontSize
        || lhs.letterSpacing != rhs.letterSpacing
        || lhs.wordSpacing != rhs.wordSpacing
        || lhs.lineHeightMultiplier != rhs.lineHeightMultiplier
        || lhs.lineHeightOverride != rhs.lineHeightOverride
        || lhs.scriptTag != rhs.scriptTag
        || lhs.direction != rhs.direction
        || lhs.bidiMode != rhs.bidiMode
        || lhs.maxWidth != rhs.maxWidth
        || lhs.wrapMode != rhs.wrapMode
        || lhs.alignment != rhs.alignment
        || lhs.tabStopSpaces != rhs.tabStopSpaces
        || lhs.preserveWrapSpaces != rhs.preserveWrapSpaces
        || lhs.featureCount != rhs.featureCount
    )
        return false;
    for(usize i = 0u; i < cast<usize>(lhs.featureCount); ++i){
        if(lhs.features[i] != rhs.features[i])
            return false;
    }
    return true;
}

u32 ResolveFontSlantPreferenceScore(in FontSlant query, in FontSlant candidate){
    if(candidate == query)
        return 0u;
    if(query == FontSlant::Italic){
        if(candidate == FontSlant::Oblique)
            return 1u;
        return 2u;
    }
    if(query == FontSlant::Oblique){
        if(candidate == FontSlant::Italic)
            return 1u;
        return 2u;
    }
    if(candidate == FontSlant::Oblique)
        return 1u;
    return 2u;
}

void ComputeFontWeightMatchRank(in u32 targetW, in u32 candW, mut u32 outTier, mut u32 outDistance){
    if(candW == targetW){
        outTier = 0u;
        outDistance = 0u;
        return;
    }
    if(targetW >= 400u && targetW <= 500u){
        if(candW > targetW && candW <= 500u){
            outTier = 1u;
            outDistance = candW - targetW;
            return;
        }
        if(candW < targetW){
            outTier = 2u;
            outDistance = targetW - candW;
            return;
        }
        outTier = 3u;
        outDistance = candW - 500u;
        return;
    }
    if(targetW < 400u){
        if(candW < targetW){
            outTier = 1u;
            outDistance = targetW - candW;
            return;
        }
        outTier = 2u;
        outDistance = candW - targetW;
        return;
    }
    if(candW > targetW){
        outTier = 1u;
        outDistance = candW - targetW;
        return;
    }
    outTier = 2u;
    outDistance = targetW - candW;
}

usize ResolveBestFontDescriptorIndex(in Span<FontDescriptor> descriptors, in Name defaultFamily, in FontDescriptor query){
    if(descriptors.empty())
        return 0u;
    Name resolvedFamily = s_NameNone;
    b8 hasTargetFamily = false;
    if(query.family != s_NameNone){
        for(in FontDescriptor d : descriptors){
            if(d.family == query.family){
                resolvedFamily = query.family;
                hasTargetFamily = true;
                break;
            }
        }
    }
    if(!hasTargetFamily && defaultFamily != s_NameNone){
        for(in FontDescriptor d : descriptors){
            if(d.family == defaultFamily){
                resolvedFamily = defaultFamily;
                hasTargetFamily = true;
                break;
            }
        }
    }
    if(!hasTargetFamily){
        resolvedFamily = descriptors[0u].family;
        hasTargetFamily = true;
    }

    usize bestIndex = 0u;
    b8 hasBest = false;
    u32 bestSlantScore = u32.max;
    u32 bestWeightTier = u32.max;
    u32 bestWeightDistance = u32.max;
    const u32 targetW = cast<u32>(query.weight);

    for(usize idx = 0u; idx < descriptors.size(); ++idx){
        in FontDescriptor cand = descriptors[idx];
        if(hasTargetFamily && cand.family != resolvedFamily)
            continue;
        const u32 slantScore = ResolveFontSlantPreferenceScore(query.slant, cand.slant);
        u32 weightTier = 0u;
        u32 weightDistance = 0u;
        ComputeFontWeightMatchRank(targetW, cast<u32>(cand.weight), weightTier, weightDistance);
        if(!hasBest
            || slantScore < bestSlantScore
            || (slantScore == bestSlantScore && weightTier < bestWeightTier)
            || (slantScore == bestSlantScore && weightTier == bestWeightTier && weightDistance < bestWeightDistance)
        ){
            bestIndex = idx;
            hasBest = true;
            bestSlantScore = slantScore;
            bestWeightTier = weightTier;
            bestWeightDistance = weightDistance;
        }
    }
    return bestIndex;
}

b8 ValidateShapedRunMetrics(in FontMetrics metrics, in usize glyphCount){
    const VectorSingle values(metrics.ascender, metrics.descender, metrics.lineGap, 0.0f);
    return
        IsFinite(values.xyz)
        && metrics.ascender >= 0.0f && metrics.descender >= 0.0f && metrics.lineGap >= 0.0f
        && metrics.ascender + metrics.descender > 0.0f && glyphCount <= s_TextMaxBytes
        && FitsTextCoordinate((cast<f64>(metrics.ascender) + cast<f64>(metrics.descender)) + cast<f64>(metrics.lineGap))
    ;
}

b8 ValidateShapedGlyph(
    in u32 byteBegin,
    in u32 byteEnd,
    in Point offset,
    in Point advance,
    in Rect ink,
    in GlyphCoverageBounds coverage,
    in StringView text,
    in TextDirection direction,
    mut u32 inoutPreviousByteBegin
){
    const VectorSingle placement(advance.x, advance.y, offset.x, offset.y);
    if(
        byteBegin >= byteEnd || !IsUtf8ScalarBoundary(text, cast<usize>(byteBegin)) || !IsUtf8ScalarBoundary(text, cast<usize>(byteEnd))
        || !IsFinite(placement) || advance.x < 0.0f || advance.y != 0.0f || !HasValidUiRectDimensions(ink)
    )
        return false;
    if(!FitsTextCoordinate(cast<f64>(ink.x) + cast<f64>(ink.width)) || !FitsTextCoordinate(cast<f64>(ink.y) + cast<f64>(ink.height)))
        return false;
    if(coverage.known){
        const Rect cov = coverage.ink;
        if(!HasValidUiRectDimensions(cov))
            return false;
        if(!FitsTextCoordinate(cast<f64>(cov.x) + cast<f64>(cov.width)) || !FitsTextCoordinate(cast<f64>(cov.y) + cast<f64>(cov.height)))
            return false;
    }
    if(direction == TextDirection::LeftToRight){
        if(byteBegin < inoutPreviousByteBegin)
            return false;
    }
    else{
        if(byteBegin > inoutPreviousByteBegin)
            return false;
    }
    inoutPreviousByteBegin = byteBegin;
    return true;
}

FontMetrics MaxFontMetrics(in FontMetrics lhs, in FontMetrics rhs){
    const VectorSingle maximum = Max(VectorSingle(lhs.ascender, lhs.descender, lhs.lineGap, 0.0f), VectorSingle(rhs.ascender, rhs.descender, rhs.lineGap, 0.0f));
    FontMetrics out;
    out.ascender = maximum.x;
    out.descender = maximum.y;
    out.lineGap = maximum.z;
    return out;
}

i32 ComputeTextFixedPointScale(in f32 fontSize){
    return cast<i32>(fontSize * s_TextFixedPointScale + s_TextFixedPointRoundBiasF32);
}

GlyphCoverageBounds ComputeOutlineCoverageBounds(in i64 xMin, in i64 yMin, in i64 xMax, in i64 yMax, in f32 fontSize, in u32 unitsPerEm){
    const VectorDouble scale(cast<f64>(fontSize) / cast<f64>(unitsPerEm));
    const VectorDouble rawOrigin = VectorDouble(cast<f64>(xMin), -cast<f64>(yMax), 0.0, 0.0) - VectorDouble(s_TextOutlineBoundsMargin);
    const VectorDouble rawExtent = (VectorDouble(cast<f64>(xMax), cast<f64>(yMax), 0.0, 0.0) - VectorDouble(cast<f64>(xMin), cast<f64>(yMin), 0.0, 0.0)) + VectorDouble(s_TextOutlineBoundsMarginBothSides);
    const VectorDouble origin = rawOrigin * scale;
    const VectorDouble extent = rawExtent * scale;
    const VectorDouble candidate(origin.x, origin.y, extent.x, extent.y);
    if(!IsFinite(candidate) || extent.x < 0.0 || extent.y < 0.0)
        return GlyphCoverageBounds();
    const VectorDouble mag = VectorDoubleAbs(candidate);
    if(mag.x > s_TextMaxCoordinateF64 || mag.y > s_TextMaxCoordinateF64 || mag.z > s_TextMaxCoordinateF64 || mag.w > s_TextMaxCoordinateF64)
        return GlyphCoverageBounds();
    const VectorDouble endMag = VectorDoubleAbs(origin + extent);
    if(endMag.x > s_TextMaxCoordinateF64 || endMag.y > s_TextMaxCoordinateF64)
        return GlyphCoverageBounds();
    const VectorSingle rounded(cast<f32>(origin.x), cast<f32>(origin.y), cast<f32>(extent.x), cast<f32>(extent.y));
    const VectorSingle roundedEnds = rounded + rounded.zwxy;
    if(!IsFinite(roundedEnds.xy))
        return GlyphCoverageBounds();
    return GlyphCoverageBounds(Rect(rounded.x, rounded.y, rounded.z, rounded.w), true);
}

Expected<FontMetrics> TryResolveFontExtentsMetrics(in i32 ascender, in i32 descender, in i32 lineGap){
    const VectorSingle scaled = VectorSingle(cast<f32>(ascender), -cast<f32>(descender), cast<f32>(lineGap), 0.0f) * (1.0f / s_TextFixedPointScale);
    const VectorSingle clamped = Max(VectorSingle(0.0f), scaled);
    FontMetrics outMetrics;
    outMetrics.ascender = clamped.x;
    outMetrics.descender = clamped.y;
    outMetrics.lineGap = clamped.z;
    if(outMetrics.ascender + outMetrics.descender <= 0.0f)
        return MakeUnexpected(Failure());
    return outMetrics;
}

Rect ResolveHbGlyphExtentsInk(in i32 xBearing, in i32 yBearing, in i32 width, in i32 height){
    const f32 scale = 1.0f / s_TextFixedPointScale;
    const VectorSingle origin = VectorSingle(cast<f32>(xBearing), -cast<f32>(yBearing), cast<f32>(xBearing), -cast<f32>(yBearing)) * scale;
    const VectorSingle scaledExtent = VectorSingle(cast<f32>(width), -cast<f32>(height), cast<f32>(width), -cast<f32>(height)) * scale;
    const VectorSingle end = origin + scaledExtent;
    const VectorSingle minXY = Min(origin, end);
    const VectorSingle size = Abs(end - origin);
    return Rect(minXY.x, minXY.y, size.x, size.y);
}

void ResolveHbGlyphPlacement(in i32 xOffset, in i32 yOffset, in i32 xAdvance, in i32 yAdvance, mut Point outOffset, mut Point outAdvance){
    const VectorSingle scaled = VectorSingle(cast<f32>(xOffset), -cast<f32>(yOffset), cast<f32>(xAdvance), -cast<f32>(yAdvance)) * (1.0f / s_TextFixedPointScale);
    outOffset = Point(scaled.x, scaled.y);
    outAdvance = Point(scaled.z, scaled.w);
}

void AppendOrMergeTextFontSpan(in TextFontSpan span, mut Vector<TextFontSpan> inOutSpans){
    if(!inOutSpans.empty() && inOutSpans[inOutSpans.size() - 1u].fontIndex == span.fontIndex){
        const usize lastIndex = inOutSpans.size() - 1u;
        inOutSpans[lastIndex].glyphEnd = span.glyphEnd;
        inOutSpans[lastIndex].byteBegin = Min(inOutSpans[lastIndex].byteBegin, span.byteBegin);
        inOutSpans[lastIndex].byteEnd = Max(inOutSpans[lastIndex].byteEnd, span.byteEnd);
    }
    else
        inOutSpans.push_back(span);
}

b8 IsValidHbShapedGlyphClusterStep(
    in u32 cluster,
    in u32 previousCluster,
    in u32 byteBegin,
    in u32 byteEnd,
    in i32 xAdvance,
    in u32 index,
    in TextDirection direction
){
    if(cluster < byteBegin || cluster >= byteEnd || xAdvance < 0)
        return false;
    if(index == 0u)
        return true;
    if(direction == TextDirection::LeftToRight)
        return cluster >= previousCluster;
    return cluster <= previousCluster;
}

Rect MakeRasterGlyphBoundsRect(in i32 bitmapLeft, in i32 bitmapTop, in u32 width, in u32 rows){
    return Rect(cast<f32>(bitmapLeft), -cast<f32>(bitmapTop), cast<f32>(width), cast<f32>(rows));
}

void AppendRawShapedGlyphs<TFace>(
    in TFace face,
    in Span<RawShapedGlyph> glyphs,
    in usize begin,
    in usize end,
    mut Vector<ShapedGlyphRecord<TFace>> inOutGlyphs
){
    if(begin < end)
        inOutGlyphs.reserve(inOutGlyphs.size() + (end - begin));
    for(usize index = begin; index < end; ++index){
        in RawShapedGlyph glyph = glyphs[index];
        inOutGlyphs.emplace_back();
        mut ShapedGlyphRecord<TFace> shaped = inOutGlyphs[inOutGlyphs.size() - 1u];
        shaped.face = face;
        shaped.glyphId = glyph.glyphId;
        shaped.byteBegin = glyph.byteBegin;
        shaped.byteEnd = glyph.byteEnd;
        shaped.offset = glyph.offset;
        shaped.advance = glyph.advance;
        shaped.ink = glyph.ink;
        shaped.coverage = glyph.coverage;
    }
}

b8 ValidateShapedRun<TFace>(
    in FontMetrics metrics,
    in Span<ShapedGlyphRecord<TFace>> glyphs,
    in StringView text,
    in TextDirection direction
){
    if(!ValidateShapedRunMetrics(metrics, glyphs.size()))
        return false;
    u32 previous = 0u;
    if(direction != TextDirection::LeftToRight)
        previous = cast<u32>(text.size());
    for(in ShapedGlyphRecord<TFace> glyph : glyphs){
        if(!ValidateShapedGlyph(glyph.byteBegin, glyph.byteEnd, glyph.offset, glyph.advance, glyph.ink, glyph.coverage, text, direction, previous))
            return false;
    }
    return true;
}


