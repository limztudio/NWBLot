#include <utilities/cli/tool_cli.adhd>
#include <utilities/font_builder/bake.adhd>
#include <utilities/font_builder/command_line.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
i32 RunConsole(in ConsoleArguments arguments){
    String source;
    String output;
    String renderer(s_FontAtlasRasterModeBitmap);
    BakeOptions options;
    ToolCli app(s_FontBuilderAppDescription);
    auto sourceOption = app.addText(s_FontOptionFlag, source, "Static source .ttf/.otf or prepared .font");
    sourceOption.required();
    auto outputOption = app.addText(s_OutputOptionFlag, output, "Output .nwb asset bunch; paired binary .font shares its stem");
    outputOption.required();
    app.addU32(s_PpemOptionFlag, options.ppem, "Bake pixels per em (16..256, default64)");
    app.addU32(s_SpreadOptionFlag, options.spread, "SDF distance range (2..32, default8)");
    app.addU32(s_ExtentOptionFlag, options.extent, "Maximum square packing extent; final groups are cropped (32..2048, default1024)");
    app.addU32(s_MaxGroupsOptionFlag, options.maxGroups, "Maximum four-plane packing groups (1..8, default8)");
    app.addText(s_RendererOptionFlag, renderer, "bitmap (default) or outline; errors never switch algorithms");
    app.addFlag(s_OverwriteOptionFlag, options.overwrite, "Replace an existing complete .nwb/.font pair");
    const auto parsed = app.parse(arguments);
    if(!parsed.ok())
        return parsed.exitToConsole();

    const auto outline = TryParseBakeRendererOutline(renderer);
    if(!outline.has_value())
        return s_FontBuilderExitFailure;
    options.outline = outline.value();
    options.source = Path(source);
    options.output = Path(output);
    if(!ValidateOptions(options))
        return s_FontBuilderExitFailure;
    Vector<u8> sourceFontBytes;
    const auto payload = Bake(options, sourceFontBytes);
    if(!payload.has_value() || !WriteOutputs(options, sourceFontBytes, payload.value()))
        return s_FontBuilderExitFailure;
    LogFontBuilderPublishedSummary(options.output, payload.value().glyphs.size(), payload.value().groups.size());
    return s_FontBuilderExitSuccess;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

