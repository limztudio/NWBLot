// Shader-mirrored BVH child encoding.
enum<u32> BvhNodeIndex{
    flag LeafFlag = 0x80000000u,
    // Reuses LeafFlag in rightChild to mark transparent subtrees.
    flag TransparentSubtreeFlag = 0x80000000u,
    flag ChildIndexMask = 0x7fffffffu,
    flag Invalid = 0xffffffffu
}

