inline constexpr i32 s_FontConstructionLogFailure = 61;


class ThrowingFontConstructionLogger final : public Core::Common::ILogger{
public:
    explicit ThrowingFontConstructionLogger(Core::Common::LogArena& arena)noexcept
        : m_arena(arena)
    {}


public:
    virtual Core::Common::LogArena& arena()noexcept override{ return m_arena; }

    virtual void enqueue(Core::Common::LogString&& text, Core::Common::LogType::Enum)override{ observe(text); }

    virtual void enqueue(const Core::Common::LogString& text, Core::Common::LogType::Enum)override{ observe(text); }

    [[nodiscard]] b8 sawFaceFailure()const noexcept{ return m_sawFaceFailure; }


private:
    void observe(const Core::Common::LogString& text){
        if(text.find(FOUNDATION_TEXT("UI font face initialization failed")) == Core::Common::LogString::npos)
            return;
        m_sawFaceFailure = true;
        throw s_FontConstructionLogFailure;
    }


private:
    Core::Common::LogArena& m_arena;
    b8 m_sawFaceFailure = false;
};


class TextFontTests : public testing::Test{
public:
    TextFontTests()
        : m_arena(Name(NWB::Tests::UiCases::s_UiCaseTestsUiTextFont))
        , m_latin(m_arena, Name(s_TestLatinFontPath))
        , m_korean(m_arena, Name(s_TestKoreanFontPath))
        , m_service(m_arena)
        , m_layout(m_arena)
        , m_skin(m_arena, Name(s_TestSkinPath))
        , m_paint(m_arena)
    {}


public:
    virtual void SetUp()override{
        Core::Alloc::ScratchArena fontScratchArena(s_FontScratchArenaName);
        ASSERT_TRUE(Tests::LoadBundledFont(m_latin, m_arena, NWB_TEST_FONT_DIRECTORY, "latin.font"));
        ASSERT_TRUE(Tests::LoadBundledFont(m_korean, m_arena, NWB_TEST_FONT_DIRECTORY, "korean.font"));
        const Array<FontSource, 2> sources{
            FontSource{ Core::Assets::AssetRef<Font>(s_TestLatinFontPath), m_latin, 1u },
            FontSource{ Core::Assets::AssetRef<Font>(s_TestKoreanFontPath), m_korean, 1u },
        };
        ASSERT_TRUE(m_service.setFonts(fontScratchArena, Span(sources.data(), 2u)));
        UiSkin::RegionVector regions(m_arena);
        m_skin.setAtlas(Core::Assets::AssetRef<Texture>("tests/ui/texture"), 4u, 4u, 1.0f, Move(regions));
    }

    void beginPaint(u64 generation, f32 scale = 1.0f){
        m_paint.begin({ 800.0f, 600.0f, scale, scale }, generation, 1u, Core::Assets::AssetRef<UiSkin>(s_TestSkinPath), m_skin);
    }

    [[nodiscard]] b8 applyLayout(const ShapeRequest& request){
        auto layoutResult = m_service.layout(request);
        if(!layoutResult)
            return false;
        m_layout = Move(*layoutResult);
        return true;
    }

    [[nodiscard]] b8 setLatinFontGeneration(const u64 generation){
        Core::Alloc::ScratchArena fontScratchArena(s_FontScratchArenaName);
        const FontSource replacement{ Core::Assets::AssetRef<Font>(s_TestLatinFontPath), m_latin, generation };
        return m_service.setFonts(fontScratchArena, Span(&replacement, 1u));
    }

    void clearLatinFontBytes(){
        Core::Assets::AssetBytes cleared(m_arena);
        m_latin.setFontBytes(Move(cleared));
    }

    [[nodiscard]] b8 setEmptyFonts(){
        Core::Alloc::ScratchArena fontScratchArena(s_FontScratchArenaName);
        return m_service.setFonts(fontScratchArena, {});
    }

    [[nodiscard]] Expected<SharedFontFace> makeLatinFace(const u64 generation = 1u){
        Core::Alloc::ScratchArena fontScratchArena(s_FontScratchArenaName);
        const FontSource source{ Core::Assets::AssetRef<Font>(s_TestLatinFontPath), m_latin, generation };
        return MakeFontFace(fontScratchArena, m_arena, source);
    }


public:
    Core::Alloc::GlobalArena m_arena;
    Font m_latin;
    Font m_korean;
    TextService m_service;
    TextLayout m_layout;
    UiSkin m_skin;
    PaintBuilder m_paint;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


