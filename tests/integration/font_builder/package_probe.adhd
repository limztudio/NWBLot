////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <logger/client/module.h>

#include <impl/assets_font/cook.adhd.h>
#include <impl/assets_font_atlas/cook.adhd.h>

#include <core/assets/bunch/cook.h>
#include <core/common/application_entry.h>

#include <global/filesystem.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace NWB::Tests::FontPackageCases{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using AssetArena = Core::Assets::AssetArena;
using AssetBytes = Core::Assets::AssetBytes;
using ScratchArena = Core::Alloc::ScratchArena;
using Impl::Font;
using Impl::FontAtlas;
using Impl::FontAtlasPayload;
using Impl::ValidateFontAtlasSourceMatch;
using Impl::s_FontAtlasKernTag;
using Impl::s_FontAtlasGposTag;
using Impl::s_FontAtlasGdefTag;
inline constexpr TStringView s_LoggerAppName = NWB_TEXT("font_builder_package_probe");
inline constexpr TStringView s_LoggerInitFailureText = NWB_TEXT("[font_builder_package_probe] logger.init() failed");


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Name s_PackageArena = s_OneOffNameTestsIntegrationFontBuilderPackage;
const i32 s_EntryFailure = -1;

StringView TableTag(in u32 tag){
    if(tag == s_FontAtlasKernTag)
        return "kern";
    if(tag == s_FontAtlasGposTag)
        return "GPOS";
    if(tag == s_FontAtlasGdefTag)
        return "GDEF";
    return "";
}

b8 WriteAtlasHeaderBinary(in Path directory, in FontAtlasPayload payload, mut ScratchArena scratch){
    b8 ok = false;
    native(in directory, in payload, mut scratch, mut ok){
        const ::Path<NWB::Core::Alloc::ScratchArena> outputDirectory(scratch, directory);
        if(!EnsureDirectories(outputDirectory))
            return false;
        const auto binary = NWB::Impl::SerializeFontAtlasPayload(payload, payload.glyphs.get_allocator().arena(), scratch);
        ok = binary && WriteBinaryFile(outputDirectory / "atlas.bin", *binary);
    }
    return ok;
}

b8 WriteGroupPixelsFile(in Path directory, in usize index, in AssetBytes pixels, mut ScratchArena scratch){
    b8 ok = false;
    native(in directory, in index, in pixels, mut scratch, mut ok){
        const ::Path<NWB::Core::Alloc::ScratchArena> outputDirectory(scratch, directory);
        const auto name = StringFormat(scratch, "group_{}.pixels", index);
        ok = WriteBinaryFile(outputDirectory / name, pixels);
    }
    return ok;
}

b8 WritePositioningTableFile(in Path directory, in StringView tag, in AssetBytes bytes, mut ScratchArena scratch){
    b8 ok = false;
    native(in directory, in tag, in bytes, mut scratch, mut ok){
        const ::Path<NWB::Core::Alloc::ScratchArena> outputDirectory(scratch, directory);
        const auto name = StringFormat(scratch, "table_{}.bin", tag);
        ok = WriteBinaryFile(outputDirectory / name, bytes);
    }
    return ok;
}

b8 ExportPayload(in Path directory, in FontAtlasPayload payload, mut ScratchArena scratch){
    if(!WriteAtlasHeaderBinary(directory, payload, scratch))
        return false;
    for(usize index = 0u; index < payload.groups.size(); ++index){
        if(!WriteGroupPixelsFile(directory, index, payload.groups[index].pixels, scratch))
            return false;
    }
    for(usize index = 0u; index < payload.positioningTables.size(); ++index){
        const StringView tag = TableTag(payload.positioningTables[index].tag);
        if(tag.empty())
            return false;
        if(!WritePositioningTableFile(directory, tag, payload.positioningTables[index].bytes, scratch))
            return false;
    }
    return true;
}

b8 DecodePackage(in StringView source, in StringView destination){
    AssetArena arena(s_PackageArena);
    Path sourcePath(arena);
    Path destinationPath(arena);
    native(in source, in destination, mut sourcePath, mut destinationPath){
        sourcePath = source;
        destinationPath = destination;
    }
    ScratchArena scratch(Name(s_FontPackageNameTestsIntegrationFontBuilderScratch));
    Font font(arena);
    FontAtlas atlas(arena);
    b8 foundFont = false;
    b8 foundAtlas = false;

    native(in sourcePath, mut arena, mut scratch, mut font, mut atlas, mut foundFont, mut foundAtlas){
        NWB::Core::Metascript::MetaArena metadataArena{Name(s_FontPackageNameTestsIntegrationFontBuilderMetadata)};
        NWB::Core::Metascript::MString metadata(metadataArena);
        NWB::Core::Metascript::Document document(metadataArena);
        if(!ReadTextFile(sourcePath, metadata))
            return false;
        StripUtf8Bom(metadata);
        if(!document.parse(metadata))
            return false;
        auto expanded = NWB::Core::Assets::AssetsBunchCook::ExpandAssetBunch(sourcePath.parentPath(), "probe", sourcePath, document, scratch);
        if(!expanded || expanded->size() != 2u)
            return false;

        for(const auto& asset : *expanded){
            if(asset.assetType == Name(s_FontPackageLookupNameFont)){
                if(foundFont)
                    return false;
                auto entryResult = NWB::Impl::ParseFontCookMetadataValue(asset.virtualPath, sourcePath, asset.value, arena);
                if(!entryResult)
                    return false;
                auto assetResult = NWB::Impl::BuildFontAsset(Move(*entryResult), arena);
                if(!assetResult)
                    return false;
                font = Move(*assetResult);
                foundFont = true;
            }
            else if(asset.assetType == Name(s_FontPackageLookupNameFontAtlas)){
                if(foundAtlas)
                    return false;
                auto entryResult = NWB::Impl::ParseFontAtlasCookMetadataValue(asset.virtualPath, sourcePath, asset.value, arena, scratch);
                if(!entryResult)
                    return false;
                auto assetResult = NWB::Impl::BuildFontAtlasAsset(Move(*entryResult), arena, scratch);
                if(!assetResult)
                    return false;
                atlas = Move(*assetResult);
                foundAtlas = true;
            }
            else
                return false;
        }
    }

    if(!foundFont || !foundAtlas)
        return false;
    if(!ValidateFontAtlasSourceMatch(atlas.payload(), font))
        return false;
    if(!ExportPayload(destinationPath, atlas.payload(), scratch))
        return false;

    b8 wroteSfnt = false;
    native(in destinationPath, in font, mut wroteSfnt){
        wroteSfnt = WriteBinaryFile(destinationPath / "source.sfnt", font.fontBytes());
    }
    return wroteSfnt;
}

native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_font_builder_package_probe{
int Run(const int argc, char** argv){
    using namespace NWB::Tests::FontPackageCases;
    NWB::Log::ClientStandalone logger;
    if(!logger.init(s_LoggerAppName)){
        NWB_TCERR << s_LoggerInitFailureText << NWB_TEXT("\n");
        return s_EntryFailure;
    }
    NWB::Core::Common::LoggerRegistrationGuard loggerRegistrationGuard(logger, NWB::Core::Common::LoggerBreakPolicy::BreakOnFatal);
    if(argc != 3){
        NWB_LOGGER_ERROR(NWB_TEXT("font_builder_package_probe: expected source .nwb and decoded output directory"));
        return s_EntryFailure;
    }
    if(!DecodePackage(argv[1], argv[2])){
        NWB_LOGGER_ERROR(NWB_TEXT("font_builder_package_probe: cannot cook or export font pair"));
        return s_EntryFailure;
    }
    return 0;
}
};

NWB_DEFINE_UTF8_APPLICATION_ENTRY_POINT(__hidden_font_builder_package_probe::Run)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


