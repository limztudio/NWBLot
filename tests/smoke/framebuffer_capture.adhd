// limztudio@gmail.com
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <loader/project_entry.adhd>
#include "bitmap_capture_writer.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u64 s_UncapturedGraphicsFrame = 0xffffffffffffffffu;
interface ISmokeCapturePredicate{
    b8 shouldCaptureFrame(in u64 frame)const;
}

class FramebufferCaptureOptions{
    public Optional<in ISmokeCapturePredicate> shouldCapture;
    public u32 requiredWidth = 0u;
    public u32 requiredHeight = 0u;
    public b8 quitWhenReady = true;
}

class FramebufferCaptureCompletion{
    public QueueSubmissionToken acceptedToken;
    public u64 graphicsFrameIndex = s_UncapturedGraphicsFrame;
    public u64 generation = 1u;
}

class FramebufferReadbackTask{
    public TextureHandle source;
    public StagingTextureHandle destination;
    public Shared<FramebufferCaptureCompletion> completion;
    public u64 graphicsFrameIndex = 0u;
    public u64 generation = 0u;

    public GpuTaskCommandRequirements commandRequirements()const{
        GpuTaskCommandRequirements commands;
        commands.requiredCapabilities = GpuQueueCapability::Transfer;
        return commands;
    }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.source.valid() || !this.destination.valid() || !this.completion.valid() || context.hasCommandIrCapture())
            return false;
        commandList.copyTexture(this.destination.deref(), TextureSlice(), this.source.deref(), TextureSlice());
        return !commandList.commandRecordingFailed();
    }

    public void accepted(in QueueSubmissionToken token){
        if(this.completion.valid() && this.generation == this.completion.deref().generation){
            this.completion.deref().acceptedToken = token;
            this.completion.deref().graphicsFrameIndex = this.graphicsFrameIndex;
        }
    }

    public void discarded(){
        if(this.completion.valid() && this.generation == this.completion.deref().generation)
            this.completion.deref().acceptedToken = QueueSubmissionToken();
    }
}

[arena]
class FramebufferCapture : IRenderPass, IGpuTaskGraphPresentationContributor{
    private mut ProjectRuntimeContext m_context;
    private Path m_outputPath;
    private FramebufferCaptureOptions m_options;
    private SharedPool m_completionPool = SharedPool();
    private Shared<FramebufferCaptureCompletion> m_completionState;
    private StagingTextureHandle m_readback;
    private TextureDesc m_captureDescription;
    private AcquiredPresentationFrame m_preparedFrame;
    private u64 m_preparedGraphGeneration = 0u;
    private u64 m_lastCountedGraphicsFrame = s_UncapturedGraphicsFrame;
    private u32 m_captureFrameCount;
    private u32 m_preparedFrameCount = 0u;
    private b8 m_registered = false;
    private b8 m_taskGraphPresentationPrepared = false;
    private b8 m_taskGraphPresentationClaimed = false;
    private b8 m_captureReady = false;
    private b8 m_skipped = false;
    private b8 m_failed = false;
    private b8 m_quitRequested = false;
    private b8 m_stopped = false;

    public FramebufferCapture(mut GraphicsRuntime graphics, in StringView outputPath, in u32 captureFrameCount, mut ProjectRuntimeContext context, in FramebufferCaptureOptions options){
        this.m_context = context;
        this.m_outputPath = Path(outputPath);
        this.m_options = options;
        this.m_completionState = this.m_completionPool.make<FramebufferCaptureCompletion>().value();
        this.m_captureFrameCount = captureFrameCount;
        if(this.m_outputPath.empty())
            this.markFailed("capture output path is empty");
        if(this.m_captureFrameCount == 0u)
            this.markFailed("capture frame count must be greater than zero");
    }

    public ~FramebufferCapture(){ this.stop(); }

    public b8 start(){
        if(this.m_registered)
            return true;
        if(this.m_failed || this.m_stopped)
            return false;

        mut GraphicsRuntime graphics = this.getGraphics();
        const Optional<mut IGpuTaskGraphPresentationContributor> contributor = graphics.borrowTaskGraphPresentationContributor();
        mut IGpuTaskGraphPresentationContributor self = this;
        if(contributor.has_value() && !SameAddress(contributor.value(), self)){
            this.markFailed("another task-graph presentation contributor is already registered");
            return false;
        }

        graphics.addRenderPassToBack(this);
        if(this.m_failed){
            graphics.removeRenderPass(this);
            return false;
        }
        graphics.setTaskGraphPresentationContributor(this);
        this.m_registered = true;
        return true;
    }

    public void stop(){
        if(!this.m_registered)
            return;

        mut GraphicsRuntime graphics = this.getGraphics();
        graphics.clearTaskGraphPresentationContributor(this);
        this.m_registered = false;
        this.m_stopped = true;
        graphics.removeRenderPass(this);
        this.resetPendingReadback();
    }

    public void update(){
        if(!this.m_registered)
            return;
        if(this.m_skipped || this.m_failed){
            this.requestTerminalQuit();
            return;
        }
        if(this.m_captureReady){
            if(this.m_options.quitWhenReady)
                this.requestTerminalQuit();
            return;
        }
        const QueueSubmissionToken acceptedToken = this.m_completionState.deref().acceptedToken;
        if(!acceptedToken.valid())
            return;
        if(!acceptedToken.hasPhysicalQueueIdentity()){
            this.markFailed("accepted readback submission has no physical queue identity");
            this.requestTerminalQuit();
            return;
        }

        mut GraphicsRuntime graphics = this.getGraphics();
        mut Device device = graphics.getDevice();
        if(acceptedToken.deviceGeneration != device.getDeviceGeneration()){
            this.markFailed("accepted readback submission belongs to a stale graphics device");
            this.requestTerminalQuit();
            return;
        }
        GpuPhysicalQueueId physicalQueue = GpuPhysicalQueueId();
        physicalQueue.index = acceptedToken.physicalQueueIndex;
        physicalQueue.deviceGeneration = acceptedToken.deviceGeneration;
        const Expected<u64> completedValue = device.queueGetCompletedInstance(physicalQueue);
        if(!completedValue.has_value()){
            this.markFailed("failed to query readback submission completion");
            this.requestTerminalQuit();
            return;
        }
        if(completedValue.value() < acceptedToken.value)
            return;
        if(!this.m_readback.valid()){
            this.markFailed("accepted readback submission lost its staging texture");
            this.requestTerminalQuit();
            return;
        }

        const auto mapping = device.mapStagingTexture(this.m_readback.deref(), TextureSlice(), CpuAccessMode::Read);
        if(!mapping.has_value()){
            this.markFailed("failed to map the completed readback staging texture");
            this.requestTerminalQuit();
            return;
        }

        usize requiredSourceBytes = 0u;
        b8 validSourceSpan = true;
        if(this.m_captureDescription.width > 0u && this.m_captureDescription.height > 0u){
            const auto lastRowOffset = TryMultiply<usize>(cast<usize>(this.m_captureDescription.height - 1u), mapping.value().rowPitch);
            const auto rowBytes = TryMultiply<usize>(cast<usize>(this.m_captureDescription.width), s_BitmapSourceBytesPerPixel);
            if(!lastRowOffset.has_value() || !rowBytes.has_value() || AddOverflows<usize>(lastRowOffset.value(), rowBytes.value()))
                validSourceSpan = false;
            else
                requiredSourceBytes = lastRowOffset.value() + rowBytes.value();
        }
        b8 captureWritten = false;
        const Span<u8> mapped = mapping.value().readBytes();
        if(validSourceSpan && !mapped.empty() && requiredSourceBytes <= mapped.size()){
            const Span<u8> sourceSpan = mapped.first(requiredSourceBytes);
            captureWritten = BitmapCaptureWriter(this.m_captureDescription).write(this.m_outputPath, sourceSpan, mapping.value().rowPitch);
        }
        device.unmapStagingTexture(this.m_readback.deref());
        if(!captureWritten){
            this.markFailed("failed to write the framebuffer capture atomically");
            this.requestTerminalQuit();
            return;
        }

        this.m_captureReady = true;
        [essential] info("FramebufferCapture: capture ready");
        [essential] info("FramebufferCapture: graphics source frame {}", this.m_completionState.deref().graphicsFrameIndex);
        if(this.m_options.quitWhenReady)
            this.requestTerminalQuit();
    }

    public b8 rearm(in StringView path){
        const Path outputPath = Path(path);
        if(!this.m_registered || !this.m_captureReady || this.m_failed || this.m_skipped || this.m_quitRequested || outputPath.empty() || this.m_completionState.deref().generation == s_UncapturedGraphicsFrame)
            return false;

        this.m_outputPath = outputPath;
        ++this.m_completionState.deref().generation;
        this.m_completionState.deref().acceptedToken = QueueSubmissionToken();
        this.m_completionState.deref().graphicsFrameIndex = s_UncapturedGraphicsFrame;
        this.m_preparedFrame = AcquiredPresentationFrame();
        this.m_preparedGraphGeneration = 0u;
        this.m_lastCountedGraphicsFrame = s_UncapturedGraphicsFrame;
        this.m_preparedFrameCount = 0u;
        this.m_taskGraphPresentationPrepared = false;
        this.m_taskGraphPresentationClaimed = false;
        this.m_captureReady = false;
        return true;
    }


    public b8 captureReady()const { return this.m_captureReady; }

    public u64 capturedGraphicsFrameIndex()const { return this.m_completionState.deref().graphicsFrameIndex; }

    public void finish(){
        assert(this.m_captureReady);
        this.requestTerminalQuit();
    }

    public b8 shouldRenderUnfocused() override{ return true; }

    public b8 validateResources(in u32 width, in u32 height, in u32 samples)override{
        if(this.m_skipped || this.m_failed || width == 0u || height == 0u)
            return true;
        if((this.m_options.requiredWidth != 0u && width != this.m_options.requiredWidth) || (this.m_options.requiredHeight != 0u && height != this.m_options.requiredHeight))
            return true;
        if(!this.getGraphics().isSwapChainReadbackAvailable())
            return true;

        const TexturePtr backbuffer = this.getGraphics().getBackBuffer(0u);
        if(!IsValidTexturePtr(backbuffer)){
            this.markFailed("swap-chain texture is unavailable during capture resource setup");
            return false;
        }
        return this.prepareReadback(DerefTexturePtr(backbuffer).getCreationDescription());
    }

    public void invalidateResources()override{
        if(!this.m_registered)
            return;

        if(this.m_captureReady){
            this.m_readback.reset();
            this.m_captureDescription = TextureDesc();
        }
        else if(!this.m_skipped && !this.m_failed)
            this.resetPendingReadback();
    }

    public void backBufferResizing()override{
        if(this.m_registered)
            this.invalidateResources();
    }

    public b8 prepareTaskGraphPresentation(in AcquiredPresentationFrame frame)override{
        this.m_taskGraphPresentationPrepared = false;
        if(this.m_captureReady || this.m_skipped || this.m_failed || this.m_completionState.deref().acceptedToken.valid())
            return true;

        if(!this.getGraphics().isSwapChainReadbackAvailable()){
            this.m_skipped = true;
            [essential] info("FramebufferCapture: skipped because swap-chain transfer-source usage is unavailable");
            return true;
        }
        if(!frame.valid()){
            this.markFailed("renderer supplied an invalid acquired presentation frame");
            return true;
        }

        const u64 graphicsFrame = this.getGraphics().getFrameIndex();
        if(graphicsFrame != this.m_lastCountedGraphicsFrame){
            this.m_lastCountedGraphicsFrame = graphicsFrame;
            if(this.m_preparedFrameCount < this.m_captureFrameCount)
                ++this.m_preparedFrameCount;
        }
        if(this.m_preparedFrameCount < this.m_captureFrameCount)
            return true;
        in TextureDesc description = frame.backBuffer.texture.deref().getCreationDescription();
        if((this.m_options.requiredWidth != 0u && description.width != this.m_options.requiredWidth) || (this.m_options.requiredHeight != 0u && description.height != this.m_options.requiredHeight))
            return true;
        if(this.m_options.shouldCapture.has_value() && !this.m_options.shouldCapture.value().shouldCaptureFrame(graphicsFrame))
            return true;

        if(!this.stagingMatches(description)){
            this.markFailed("framebuffer readback staging texture was not prepared for the current swap chain");
            return true;
        }

        this.m_preparedFrame = frame;
        this.m_taskGraphPresentationPrepared = true;
        this.m_taskGraphPresentationClaimed = false;
        this.m_preparedGraphGeneration = 0u;
        return true;
    }

    public b8 hasTaskGraphPresentationWork()const  override{
        return this.m_taskGraphPresentationPrepared && this.m_readback.valid() && !this.m_completionState.deref().acceptedToken.valid() && !this.m_captureReady && !this.m_skipped && !this.m_failed;
    }

    public Expected<GpuTaskId> declareTaskGraphPresentation(mut GpuTaskGraph graph, in AcquiredPresentationFrame frame, in GpuGraphResourceId backbuffer, in GpuTaskId previousTask)override{
        u64 graphGeneration = 0u;
        {
            const GpuTaskGraphDeclarationReadView declarations(graph);
            graphGeneration = declarations.generation();
        }
        if(this.m_taskGraphPresentationClaimed && this.m_preparedGraphGeneration != graphGeneration){
            this.m_taskGraphPresentationClaimed = false;
            this.m_preparedGraphGeneration = 0u;
        }
        if(!this.m_taskGraphPresentationPrepared || this.m_taskGraphPresentationClaimed || !this.m_readback.valid() || this.m_completionState.deref().acceptedToken.valid())
            return MakeUnexpected(Failure());
        if(
            !frame.valid()
            || !previousTask.valid()
            || !backbuffer.valid()
            || frame.backBuffer.texture != this.m_preparedFrame.backBuffer.texture
            || frame.backBuffer.nativeInitialState != this.m_preparedFrame.backBuffer.nativeInitialState
            || frame.backBuffer.index != this.m_preparedFrame.backBuffer.index
            || frame.framebuffer != this.m_preparedFrame.framebuffer
        ){
            this.markFailed("presentation declaration no longer matches the prepared acquired frame");
            return MakeUnexpected(Failure());
        }

        GpuTaskSchedulingHint scheduling;
        scheduling.cost = GpuTaskCostHint::Small;
        scheduling.overlapPreferred = false;
        scheduling.avoidQueueCrossing = true;
        scheduling.forceSubmissionBoundary = true;
        scheduling.allowPacketMerge = false;

        GpuGraphResourceDesc hazard;
        hazard.setIdentity(s_SmokeNameTestsSmokeFramebufferCaptureStaging).setMarkerLabel("Framebuffer Capture Staging").setType(GpuGraphResourceType::HazardDomain);
        const auto stagingHazardResult = graph.importHazardDomain(hazard);
        if(!stagingHazardResult.has_value()){
            this.markFailed("failed to declare the framebuffer staging hazard domain");
            return MakeUnexpected(Failure());
        }

        const GpuGraphResourceId stagingHazard = stagingHazardResult.value();

        GpuTaskDesc taskDesc;
        Array<GpuTaskResourceUse, 2u> resourceUses;
        resourceUses[0u].resource = backbuffer;
        resourceUses[0u].range.textureSubresources = TextureSubresourceSet(0u, 1u, 0u, 1u);
        resourceUses[0u].requiredState = ResourceStates::CopySource;
        resourceUses[0u].access = GpuTaskResourceAccess::Read;
        resourceUses[1u].resource = stagingHazard;
        resourceUses[1u].requiredState = ResourceStates::Unknown;
        resourceUses[1u].access = GpuTaskResourceAccess::Write;
        const GpuTaskId dependency = previousTask;
        taskDesc.setIdentity(s_SmokeNameTestsSmokeFramebufferCapture).setMarkerLabel("Framebuffer Capture Readback").setScheduling(scheduling).setDependency(dependency).setResourceUses(resourceUses);
        FramebufferReadbackTask payload;
        payload.source = frame.backBuffer.texture;
        payload.destination = this.m_readback;
        payload.completion = this.m_completionState;
        payload.graphicsFrameIndex = this.m_lastCountedGraphicsFrame;
        payload.generation = this.m_completionState.deref().generation;
        const auto readbackTask = graph.addPayloadTask(taskDesc, payload);
        if(!readbackTask.has_value()){
            this.markFailed("failed to declare the framebuffer readback task");
            return MakeUnexpected(Failure());
        }

        this.m_taskGraphPresentationClaimed = true;
        this.m_preparedGraphGeneration = graphGeneration;
        return readbackTask;
    }

    private void markFailed(in StringView reason){
        if(this.m_failed)
            return;

        this.m_failed = true;
        error("FramebufferCapture: {}", reason);
    }

    private void requestTerminalQuit(){
        if(this.m_quitRequested)
            return;

        this.m_quitRequested = true;
        this.m_context.requestQuit();
    }

    private void resetPendingReadback(){
        this.m_completionState = this.m_completionPool.make<FramebufferCaptureCompletion>().value();
        this.m_readback.reset();
        this.m_captureDescription = TextureDesc();
        this.m_preparedFrame = AcquiredPresentationFrame();
        this.m_preparedGraphGeneration = 0u;
        this.m_taskGraphPresentationPrepared = false;
        this.m_taskGraphPresentationClaimed = false;
    }

    private b8 stagingMatches(in TextureDesc description)const {
        return
            this.m_readback.valid()
            && this.m_captureDescription.width == description.width
            && this.m_captureDescription.height == description.height
            && this.m_captureDescription.depth == description.depth
            && this.m_captureDescription.arraySize == description.arraySize
            && this.m_captureDescription.mipLevels == description.mipLevels
            && this.m_captureDescription.sampleCount == description.sampleCount
            && this.m_captureDescription.sampleQuality == description.sampleQuality
            && this.m_captureDescription.format == description.format
            && this.m_captureDescription.dimension == description.dimension
            && this.m_captureDescription.queueSharing == description.queueSharing
        ;
    }

    private b8 prepareReadback(in TextureDesc description){
        if(!IsSupportedFramebufferSdrFormat(description.format)){
            this.markFailed("swap-chain format is not SDR RGBA8/BGRA8 UNORM or SRGB");
            return false;
        }
        if(description.width == 0u || description.height == 0u || description.depth != 1u || description.arraySize != 1u || description.mipLevels != 1u || description.sampleCount != 1u || description.dimension != TextureDimension::Texture2D){
            this.markFailed("swap-chain texture shape cannot be represented by the SDR framebuffer capture");
            return false;
        }
        if(this.stagingMatches(description))
            return true;

        this.m_readback.reset();
        this.m_captureDescription = description;
        mut GraphicsRuntime graphics = this.getGraphics();
        mut Device device = graphics.getDevice();
        auto readbackResult = device.createStagingTexture(description, CpuAccessMode::Read);
        if(readbackResult.has_value())
            this.m_readback = readbackResult.value();
        else
            this.m_readback.reset();
        if(!readbackResult.has_value()){
            this.markFailed("failed to allocate the matching framebuffer readback staging texture");
            return false;
        }
        return true;
    }


}

[cpp_unwind]
b8 StartNewSmokeFramebufferCapture(in StringView outputPath, in u32 count, mut ProjectRuntimeContext context, in FramebufferCaptureOptions options, mut UniquePtr<FramebufferCapture> outCapture){
    auto capture = MakeUnique<FramebufferCapture>(context.graphics, outputPath, count, context, options);
    if(!capture.valid() || !capture.deref().start())
        return false;
    outCapture = capture;
    return true;
}

void UpdateSmokeFramebufferCapture(mut UniquePtr<FramebufferCapture> capture){
    if(capture.valid())
        capture.deref().update();
}

void StopAndResetSmokeFramebufferCapture(mut UniquePtr<FramebufferCapture> capture){
    if(capture.valid()){
        capture.deref().stop();
        capture.reset();
    }
}

b8 SmokeFramebufferCaptureValid(in UniquePtr<FramebufferCapture> capture){
    return capture.valid();
}

b8 SmokeFramebufferCaptureReady(in UniquePtr<FramebufferCapture> capture){
    return capture.valid() && capture.deref().captureReady();
}

u64 SmokeFramebufferCapturedFrameIndex(in UniquePtr<FramebufferCapture> capture){
    if(capture.valid())
        return capture.deref().capturedGraphicsFrameIndex();
    return s_UncapturedGraphicsFrame;
}

void FinishSmokeFramebufferCapture(mut UniquePtr<FramebufferCapture> capture){
    if(capture.valid())
        capture.deref().finish();
}

b8 RearmSmokeFramebufferCapture(mut UniquePtr<FramebufferCapture> capture, in StringView outputPath){
    return capture.valid() && capture.deref().rearm(outputPath);
}

void MoveSmokeFramebufferCapture(mut UniquePtr<FramebufferCapture> source, mut UniquePtr<FramebufferCapture> destination){
    destination = TakeUnique<FramebufferCapture>(source);
}

FramebufferCaptureOptions MakeSmokeCaptureOptions(in borrow ISmokeCapturePredicate owner, in u32 width, in u32 height, in b8 quitWhenReady){
    FramebufferCaptureOptions options;
    options.requiredWidth = width;
    options.requiredHeight = height;
    options.quitWhenReady = quitWhenReady;
    options.shouldCapture = Optional<in ISmokeCapturePredicate>(owner);
    return options;
}

FramebufferCaptureOptions MakeSmokeCaptureOptions(in borrow ISmokeCapturePredicate owner, in u32 width, in u32 height){
    return MakeSmokeCaptureOptions(owner, width, height, true);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u64 s_FramebufferCaptureMaxFrameCount = 4294967295u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SmokeCaptureSeries{
    public Vector<String> paths;
    public UniquePtr<FramebufferCapture> capture = UniquePtr<FramebufferCapture>();
}

class SmokeCaptureFactory{
    public SmokeCaptureFactory(mut ProjectRuntimeContext context){
        this.m_context = context;
    }

    public Expected<UniquePtr<FramebufferCapture>> configure(in StringView projectName, in u32 defaultFrameCount, in FramebufferCaptureOptions options){
        const Expected<String> outputPath = ReadSmokeEnvironmentString("NWB_SMOKE_FRAMEBUFFER_CAPTURE_PATH");
        if(!outputPath.has_value())
            return UniquePtr<FramebufferCapture>();

        u32 captureFrameCount = defaultFrameCount;
        const Expected<String> frameCountText = ReadSmokeEnvironmentString("NWB_SMOKE_FRAMEBUFFER_CAPTURE_FRAME_COUNT");
        if(frameCountText.has_value()){
            const Expected<u64> parsedFrameCount = ParseU64(StringView(frameCountText.value()));
            if(!parsedFrameCount.has_value() || parsedFrameCount.value() == 0u || parsedFrameCount.value() > s_FramebufferCaptureMaxFrameCount){
                error("{}: capture frame count must be a positive u32", projectName);
                return MakeUnexpected(Failure());
            }
            captureFrameCount = cast<u32>(parsedFrameCount.value());
        }

        const StringView pathView = StringView(outputPath.value());
        UniquePtr<FramebufferCapture> capture = UniquePtr<FramebufferCapture>();
        if(!StartNewSmokeFramebufferCapture(pathView, captureFrameCount, this.m_context, options, capture))
            return MakeUnexpected(Failure());
        return capture;
    }

    public Expected<UniquePtr<FramebufferCapture>> configure(in StringView projectName, in u32 defaultFrameCount){
        return this.configure(projectName, defaultFrameCount, FramebufferCaptureOptions());
    }

    public Expected<SmokeCaptureSeries> prepareSeries(in StringView outputPath, in u32 sampleCount, in FramebufferCaptureOptions options){
        if(sampleCount == 0u)
            return MakeUnexpected(Failure());

        SmokeCaptureSeries result = SmokeCaptureSeries();
        result.paths.reserve(sampleCount);
        for(u32 sample = 0u; sample < sampleCount; ++sample){
            String samplePath = String();
            if(sample + 1u == sampleCount)
                samplePath = String(outputPath);
            else
                samplePath = StringFormat("{}.{}.bmp", outputPath, sample);
            result.paths.push_back(samplePath);
        }

        const StringView firstPath = StringView(result.paths[0u]);
        if(!StartNewSmokeFramebufferCapture(firstPath, 1u, this.m_context, options, result.capture))
            return MakeUnexpected(Failure());
        return result;
    }

    public b8 prepareSeriesInto(
        in StringView outputPath,
        in u32 sampleCount,
        in FramebufferCaptureOptions options,
        mut Vector<String> outPaths,
        mut UniquePtr<FramebufferCapture> outCapture
    ){
        if(sampleCount == 0u)
            return false;

        outPaths.clear();
        outPaths.reserve(sampleCount);
        for(u32 sample = 0u; sample < sampleCount; ++sample){
            String samplePath = String();
            if(sample + 1u == sampleCount)
                samplePath = String(outputPath);
            else
                samplePath = StringFormat("{}.{}.bmp", outputPath, sample);
            outPaths.push_back(samplePath);
        }

        const StringView firstPath = StringView(outPaths[0u]);
        return StartNewSmokeFramebufferCapture(firstPath, 1u, this.m_context, options, outCapture);
    }

    private mut ProjectRuntimeContext m_context;
}

b8 ConfigureSmokeFramebufferCapture(
    mut ProjectRuntimeContext context,
    in StringView projectName,
    in u32 defaultFrameCount,
    in FramebufferCaptureOptions options,
    mut UniquePtr<FramebufferCapture> outCapture
){
    const Expected<String> outputPath = ReadSmokeEnvironmentString("NWB_SMOKE_FRAMEBUFFER_CAPTURE_PATH");
    if(!outputPath.has_value())
        return true;

    u32 captureFrameCount = defaultFrameCount;
    const Expected<String> frameCountText = ReadSmokeEnvironmentString("NWB_SMOKE_FRAMEBUFFER_CAPTURE_FRAME_COUNT");
    if(frameCountText.has_value()){
        const Expected<u64> parsedFrameCount = ParseU64(StringView(frameCountText.value()));
        if(!parsedFrameCount.has_value() || parsedFrameCount.value() == 0u || parsedFrameCount.value() > s_FramebufferCaptureMaxFrameCount){
            error("{}: capture frame count must be a positive u32", projectName);
            return false;
        }
        captureFrameCount = cast<u32>(parsedFrameCount.value());
    }

    return StartNewSmokeFramebufferCapture(StringView(outputPath.value()), captureFrameCount, context, options, outCapture);
}

b8 ConfigureSmokeFramebufferCapture(
    mut ProjectRuntimeContext context,
    in StringView projectName,
    in u32 defaultFrameCount,
    mut UniquePtr<FramebufferCapture> outCapture
){
    return ConfigureSmokeFramebufferCapture(context, projectName, defaultFrameCount, FramebufferCaptureOptions(), outCapture);
}

type TickAdmissionResult = Expected<void, CpuTaskAdmissionError>;

b8 TickSmokeWorld(in f32 delta, mut World world){
    const TickAdmissionResult updated = world.tick(delta);
    if(!updated.has_value()){
        error("Project: world update rejected CPU work: {}", cast<u32>(updated.error()));
        return false;
    }
    return true;
}

b8 TickSmokeWorldWithCapture(in f32 delta, mut World world, mut UniquePtr<FramebufferCapture> capture){
    UpdateSmokeFramebufferCapture(capture);
    return TickSmokeWorld(delta, world);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

