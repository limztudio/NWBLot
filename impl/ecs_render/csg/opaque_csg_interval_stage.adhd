native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/global.adhd.h>
#include <impl/ecs_render/csg/graph_types.adhd.h>
#include <impl/ecs_render/csg/renderer_csg_types.adhd.h>
#include <impl/ecs_render/csg/task_graph_opaque_compute_tasks.adhd.h>
#include <impl/ecs_render/csg/task_graph_opaque_interval_tasks.adhd.h>
#include <impl/ecs_render/material/renderer_draw_types.adhd.h>
#include <impl/ecs_render/deferred/deferred_frame_targets.adhd.h>

#include <core/graphics/gpu_timing.h>
#include <core/task/gpu/task_graph.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ObjectGeometryCacheGraph;
class RendererCsgSystem;
class RendererMaterialSystem;
class DeferredGraphResourceImportResult;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct OpaqueCsgIntervalStageInputs{
    DeferredFrameTargets& targets;
    const DeferredGraphResourceImportResult& resources;
    const ECSRenderDetail::MeshFrameBindingSnapshot& frameBindings;
    const ECSRenderDetail::CsgGraphResourceSnapshot& csgResources;
    MaterialPassDrawItemPartitionsView opaqueDrawItems{};
    CsgFrameGpuDataView csgFrameData{};
    Core::GpuTimingSubmissionTicket** intervalSampleTimingTicket = nullptr;
    Core::TextureSubresourceSet removedIntervalSubresources{};
    Core::TextureSubresourceSet removedIntervalCountSubresources{};
    Core::BufferRange materialInstanceRange{};
    Core::BufferRange materialTypedRange{};
    Core::BufferRange csgReceiverRange{};
    Core::BufferRange csgCutterRange{};
    Core::GpuTaskId dependencyTask;
    usize instanceCount = 0u;
    usize materialTypedByteCount = 0u;
    b8 hasOpaqueDrawItems = false;
    b8 hasCsgFrameGpuWork = false;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Opaque CSG work after the G-buffer: receiver spans, interval combine, the optional interval-sample compute producer, and interval sample.
// The payloads are built before the G-buffer task freezes its upload state, then move into the graph in declare().
class OpaqueCsgIntervalStage final : NoCopy{
public:
    OpaqueCsgIntervalStage(
        Core::GpuTaskGraph& graph,
        Core::Alloc::GlobalArena& arena,
        Core::GraphicsRuntime& graphics,
        RendererMaterialSystem& materialSystem,
        RendererCsgSystem& csgSystem,
        DeferredFrameTargets& targets,
        Core::GpuTimingSubmissionTicket*& receiverSpanTimingTicket,
        Core::GpuTimingSubmissionTicket*& intervalCombineTimingTicket,
        Core::GpuTimingSubmissionTicket*& intervalSampleTimingTicket,
        const b8& meshViewSetupReady,
        const b8& sceneShadingSetupReady,
        Optional<Core::GpuTimingMeasure>& intervalSampleComputeEmulationTiming
    )noexcept
        : m_graph(graph)
        , m_materialSystem(materialSystem)
        , m_intervalSampleComputeEmulationTiming(intervalSampleComputeEmulationTiming)
        , m_receiverSpanPayload{ arena, materialSystem, csgSystem, targets, receiverSpanTimingTicket, meshViewSetupReady, sceneShadingSetupReady, }
        , m_intervalCombinePayload{ arena, materialSystem, csgSystem, targets, intervalCombineTimingTicket, meshViewSetupReady, sceneShadingSetupReady, }
        , m_intervalSamplePayload{ arena, graphics, materialSystem, csgSystem, targets, intervalSampleTimingTicket, meshViewSetupReady, sceneShadingSetupReady, }
        , m_intervalSampleComputeEmulationPayload{ arena, graphics, materialSystem, targets, intervalSampleTimingTicket, meshViewSetupReady, sceneShadingSetupReady, intervalSampleComputeEmulationTiming, }
    {}


public:
    // Copies the frozen opaque draw stream and the G-buffer upload state into the CSG payloads.
    void capturePayloads(
        const ECSRenderDetail::MeshFrameBindingSnapshot& frameBindings,
        const ECSRenderDetail::CsgGraphResourceSnapshot& csgResources,
        const MaterialPassDrawItemPartitionsView& opaqueDrawItems,
        const CsgFrameGpuDataView& csgFrameData,
        usize instanceCount,
        usize materialTypedByteCount,
        b8 materialDrawBuffersUploaded,
        b8 csgFrameBuffersUploaded,
        b8 hasOpaqueDrawItems,
        b8 hasOpaqueCsgFrameWork
    );
    [[nodiscard]] Expected<OpaqueCsgIntervalStageTasks> declare(const OpaqueCsgIntervalStageInputs& inputs, Core::Alloc::ScratchArena& scratchArena, ObjectGeometryCacheGraph& objectGeometry);


private:
    Core::GpuTaskGraph& m_graph;
    RendererMaterialSystem& m_materialSystem;
    Optional<Core::GpuTimingMeasure>& m_intervalSampleComputeEmulationTiming;
    ECSRenderDetail::CsgReceiverSpanBuildGraphTask::Payload m_receiverSpanPayload;
    ECSRenderDetail::CsgIntervalCombineGraphTask::Payload m_intervalCombinePayload;
    ECSRenderDetail::CsgIntervalSampleGraphTask::Payload m_intervalSamplePayload;
    ECSRenderDetail::OpaqueCsgIntervalSampleComputeEmulationGraphTask::Payload m_intervalSampleComputeEmulationPayload;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

