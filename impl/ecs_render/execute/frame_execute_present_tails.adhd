#include <impl/ecs_render/execute/frame_execute_recovery.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class FrameExecutePresentTails : NoCopy{
    private mut RendererFramePipeline m_renderer;
    private mut FrameExecuteRecovery m_recovery;
    private in GpuCompiledGraphReadView m_compiledPlan;
    private QueueSubmissionToken m_finalPresentationSubmissionToken;

    public FrameExecutePresentTails(mut RendererFramePipeline renderer, mut FrameExecuteRecovery recovery, in GpuCompiledGraphReadView compiledPlan, in QueueSubmissionToken finalPresentationSubmissionToken){
        this.m_renderer = renderer;
        this.m_recovery = recovery;
        this.m_compiledPlan = compiledPlan;
        this.m_finalPresentationSubmissionToken = finalPresentationSubmissionToken;
    }

    [cpp_unwind]
    public b8 executeSurfelCounterReadback(in Optional<GpuPhysicalQueueInfo> readbackQueue, in Span<BufferHandle> counterBuffers);
    [cpp_unwind]
    public void executeLaggedLightingHistoryCapture(mut DeferredFrameTargets targets, in Optional<GpuPhysicalQueueInfo> historyQueue, in b8 requestsCapture, in b8 captureDeclared, in b8 laggedAsyncLightingSchedule);
}


