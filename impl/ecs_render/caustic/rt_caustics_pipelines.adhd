////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/caustic/settings.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


StringView SelectRayTracingCsgVariant(in b8 hasCsg){
    if(hasCsg)
        return s_RayTracingCsgEnabledVariant;
    return s_RayTracingCsgDisabledVariant;
}

b8 AreAllCausticResolveStagePipelinesReady(
    in b8 hasPrepare,
    in b8 hasWavelet,
    in b8 hasStepOne,
    in b8 hasStepTwo,
    in b8 hasDirect,
    in b8 hasUpsample
){
    return hasPrepare && hasWavelet && hasStepOne && hasStepTwo && hasDirect && hasUpsample;
}

b8 MatchesCausticResolveActivityExtent(in u32 activityHalfWidth, in u32 activityHalfHeight, in u32 targetWidth, in u32 targetHeight){
    if(targetWidth == 0u || targetHeight == 0u)
        return false;
    return activityHalfWidth == DivideUp(targetWidth, s_CausticResolveDownscaleFactor) && activityHalfHeight == DivideUp(targetHeight, s_CausticResolveDownscaleFactor);
}

u32 ComputeCausticHalfTargetExtent(in u32 extent){
    return DivideUpWrappingU32(extent, 2u);
}

u64 ComputeCausticEmissionTargetBufferByteSize(in usize capacity){
    return cast<u64>(s_CausticEmissionTargetGpuBytes * capacity);
}


