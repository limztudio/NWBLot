[cpp_header("<core/input/module.h>"), cpp_name("::NWB::Core::HandlerMutationType::Enum")]
extern enum HandlerMutationType : u8{
    AddFront,
    AddBack,
    Remove
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<core/input/module.h>"), cpp_name("::NWB::Core::InputDispatcher")]
extern class InputDispatcher{
    void addHandlerToBack(...);
    void addHandlerToFront(...);
    void gamepadAxisUpdate(...);
    void gamepadButtonUpdate(...);
    void gamepadConnectionUpdate(...);
    void keyboardCharInput(...);
    b8 keyboardTextBlocked(...)const;
    void keyboardUpdate(...);
    void mouseButtonUpdate(...);
    void mousePosUpdate(...);
    void mouseScrollUpdate(...);
    void pointerCaptureLost(...);
    void pointerLeave(...);
    void removeHandler(...);
    void setMousePositionScale(...);
    void windowFocusUpdate(...);
    b8 windowFocused(...)const;
};


