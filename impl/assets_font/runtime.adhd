#include <impl/assets_font/asset.adhd>
#include <impl/assets_font/font_binary_codec.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static_assert(size_of<FontBinaryHeader>() == 24u && align_of<FontBinaryHeader>() == 1u, "Font payload header layout drifted");

b8 Font::loadBinary(in Span<u8> binary){
    Font candidate(this.virtualPath());
    if(!FontBinaryCodec().deserialize(binary, candidate.m_fontBytes, candidate.m_faceIndex))
        return false;
    if(!candidate.validatePayload())
        return false;
    this = candidate;
    return true;
}

b8 Font::validatePayload()const{
    return this.checkVirtualPath("Font::validatePayload") && ValidateFontSource(this.m_fontBytes, this.m_faceIndex);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

