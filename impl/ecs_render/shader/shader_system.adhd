////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_scene/asset.adhd>
#include <impl/assets_graphics/deferred_subsystem.adhd>
#include <impl/assets_graphics/components.adhd>
#include <impl/assets_shader/loader.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_RendererAssetOwnerName = "RendererSystem";
const StringView s_ShaderArchiveDefaultVariant = "default";
type RendererShaderPathResolveCallback = ShaderArchivePathResolver;
type SubsystemAssetSelector<SubsystemT, TAsset> = Func<64u, AssetRef<TAsset>(in SubsystemT)>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererShaderSystem : NoCopy{
    private mut GraphicsRuntime m_graphics;
    private mut AssetManager m_assetManager;
    private mut RendererShaderPathResolveCallback m_shaderPathResolver;
    private ActiveSceneSubsystemsRef m_activeSceneSubsystems;
    private ShaderHandle m_deferredCompositeVertexShader;

    public RendererShaderSystem(mut GraphicsRuntime graphics, mut AssetManager assetManager, mut RendererShaderPathResolveCallback shaderPathResolver){
        this.m_graphics = graphics;
        this.m_assetManager = assetManager;
        this.m_shaderPathResolver = shaderPathResolver;
    }

    public void setActiveSceneSubsystems(in ActiveSceneSubsystemsRef subsystems){
        this.m_activeSceneSubsystems = subsystems;
    }

    public Name resolveSubsystemAsset<SubsystemT, TAsset>(in SubsystemAssetSelector<SubsystemT, TAsset> selector)const{
        if(!this.m_activeSceneSubsystems.has_value())
            return s_NameNone;
        const auto subsystem = this.m_activeSceneSubsystems.value().findSubsystem<SubsystemT>();
        if(!subsystem.has_value())
            return s_NameNone;
        const AssetRef<TAsset> ref = selector(subsystem.value());
        if(!ref.valid())
            return s_NameNone;
        return ref.name();
    }

    public void invalidateResources(){
        this.m_deferredCompositeVertexShader.reset();
    }

    public b8 loadShader<TShader : IShader, SubsystemT>(
        in SubsystemAssetSelector<SubsystemT, TShader> selector,
        in StringView variantName,
        in Name debugName,
        mut ShaderHandle outShader
    ){
        const Name resolvedShaderName = this.resolveSubsystemAsset<SubsystemT, TShader>(selector);
        if(!resolvedShaderName)
            return false;
        return this.loadShader<TShader>(resolvedShaderName, variantName, debugName, outShader);
    }

    public b8 loadShader<TShader : IShader, SubsystemT>(
        in SubsystemAssetSelector<SubsystemT, TShader> selector,
        in StringView variantName,
        in Name debugName,
        in Name archiveStageName,
        mut ShaderHandle outShader
    ){
        const Name resolvedShaderName = this.resolveSubsystemAsset<SubsystemT, TShader>(selector);
        if(!resolvedShaderName)
            return false;
        return this.loadShader<TShader>(resolvedShaderName, variantName, debugName, archiveStageName, outShader);
    }

    public b8 loadShader<TShader : IShader>(
        in Name shaderAssetName,
        in StringView variantName,
        in Name debugName,
        mut ShaderHandle outShader
    ){
        return Load<TShader, ShaderArchivePathResolver>(shaderAssetName, variantName, debugName, s_RendererAssetOwnerName, this.m_graphics, this.m_assetManager, this.m_shaderPathResolver, Optional<Name>(), outShader);
    }

    public b8 loadShader<TShader : IShader>(
        in Name shaderAssetName,
        in StringView variantName,
        in Name debugName,
        in Name archiveStageName,
        mut ShaderHandle outShader
    ){
        return Load<TShader, ShaderArchivePathResolver>(shaderAssetName, variantName, debugName, s_RendererAssetOwnerName, this.m_graphics, this.m_assetManager, this.m_shaderPathResolver, Optional<Name>(archiveStageName), outShader);
    }

    public b8 hasShaderArchiveStage(in Name shaderAssetName, in StringView variantName, in Name stageName)const{
        return HasRendererShaderArchiveStage<ShaderArchivePathResolver>(this.m_shaderPathResolver, shaderAssetName, variantName, stageName);
    }

    public b8 loadDeferredCompositeVertexShader(){
        return this.loadShader<VertexShader, DeferredSubsystem>(
            lambda[](in DeferredSubsystem sub) -> AssetRef<VertexShader>{ return sub.compositeVs; },
            s_ShaderArchiveDefaultVariant,
            Name("ECSRender_DeferredCompositeVS"),
            this.m_deferredCompositeVertexShader
        );
    }

    public in ShaderHandle deferredCompositeVertexShader()const{
        return this.m_deferredCompositeVertexShader;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 HasRendererShaderArchiveStage<Resolver>(mut Resolver resolver, in Name shaderName, in StringView variant, in Name stage){
    return resolver(shaderName, variant, stage).has_value();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

