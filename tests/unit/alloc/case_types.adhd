class PersistentArenaWorkerResult{
    public b8 allocationFailed = false;
    public b8 contentsPreserved = true;
    public b8 alignmentPreserved = true;
}

class PersistentArenaSlotRecord{
    public u64 serial = 0u;
    public usize markerHash = 0u;
    public u32 marker = 0u;
}

class AllocationRequest{
    public usize alignment = 0u;
    public usize bytes = 0u;
}

class AllocatorWorkerResult{
    public ArenaStatsValue stats = ArenaStatsValue();
    public b8 allocationFailed = false;
    public b8 contentsPreserved = true;
}

AllocationRequest MakeAllocationRequest(in usize alignment, in usize bytes){
    AllocationRequest request = AllocationRequest();
    request.alignment = alignment;
    request.bytes = bytes;
    return request;
}

void FillPattern(mut Span<u8> bytes){
    for(usize index = 0u; index < bytes.size(); ++index)
        bytes[index] = cast<u8>(index * 17u + 3u);
}

void ExpectPattern(in Span<u8> bytes){
    for(usize index = 0u; index < bytes.size(); ++index){
        const u8 expected = cast<u8>(index * 17u + 3u);
        EXPECT_EQ(bytes[index], expected);
    }
}


