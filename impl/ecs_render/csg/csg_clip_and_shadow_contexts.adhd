    return AppendCsgReceiverClipDataImpl(this.m_csgShapeRegistry, this.m_meshSystem, receiverLookup, receiverDrawState, receiverBounds, Optional<in TransformComponent>(), frameWidth, frameHeight,
        Optional<in MeshViewGpuData>(csgWorkRegionMeshViewState), csgFrameData);
}

Expected<CsgReceiverRangeGpuData> RendererCsgSystem::appendCsgReceiverClipData(
    in CsgFrameReceiverLookup receiverLookup,
    in CsgReceiverDrawState receiverDrawState,
    in CsgReceiverCpuBounds receiverBounds,
    in TransformComponent transform,
    in u32 frameWidth,
    in u32 frameHeight,
    in MeshViewGpuData csgWorkRegionMeshViewState,
    mut CsgFrameGpuData csgFrameData
)const{
    return AppendCsgReceiverClipDataImpl(this.m_csgShapeRegistry, this.m_meshSystem, receiverLookup, receiverDrawState, receiverBounds, Optional<in TransformComponent>(transform), frameWidth, frameHeight,
        Optional<in MeshViewGpuData>(csgWorkRegionMeshViewState), csgFrameData);
}


