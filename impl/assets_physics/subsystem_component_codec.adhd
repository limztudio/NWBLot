const u8 s_CharCtrlFlagHitSensors = 0x01u;
const u8 s_CharCtrlFlagStickToFloor = 0x02u;
const u8 s_CharCtrlFlagPushDynamicBodies = 0x04u;
const u8 s_CharCtrlFlagEnabled = 0x08u;
const u8 s_CharCtrlFlagSyncFromTransform = 0x10u;
const u8 s_CharCtrlFlagApplyStandingWeight = 0x20u;
const u8 s_CharCtrlFlagFollowPlatformPitchRoll = 0x40u;

const u16 s_VehicleFlagUseAckerman = 0x0001u;
const u16 s_VehicleFlagAutomatic = 0x0002u;
const u16 s_VehicleFlagEnabled = 0x0004u;
const u16 s_VehicleFlagEnableAbs = 0x0008u;
const u16 s_VehicleFlagEnableTcs = 0x0010u;
const u16 s_VehicleFlagUseTorqueConverter = 0x0020u;
const u16 s_VehicleFlagUseSolverImpulses = 0x0040u;
const u16 s_VehicleFlagEnableEsp = 0x0080u;
const u16 s_VehicleFlagWriteBackToSkeleton = 0x0100u;

const u8 s_VehicleWheelFlagSteerable = 0x01u;
const u8 s_VehicleWheelFlagDriven = 0x02u;
const u8 s_VehicleWheelFlagHandbrakeAffected = 0x04u;
const u8 s_VehicleWheelFlagUseSweptCast = 0x08u;

const u8 s_RagdollFlagEnabled = 0x01u;
const u8 s_RagdollFlagKinematic = 0x02u;
const u8 s_RagdollFlagDriveToPose = 0x04u;
const u8 s_RagdollFlagEnableSelfCollision = 0x08u;
const u8 s_RagdollFlagDriveFromSkeleton = 0x10u;
const u8 s_RagdollFlagWriteBackToSkeleton = 0x20u;
const u8 s_RagdollFlagAutoGenerateFromSkeleton = 0x40u;

const u8 s_RagdollShapeFlagIsSensor = 0x02u;
const u8 s_RagdollShapeFlagContactEvents = 0x04u;
const u8 s_RagdollShapeFlagHitEvents = 0x08u;
const u8 s_RagdollShapeFlagSensorEvents = 0x10u;
const u8 s_RagdollShapeFlagPreSolveEvents = 0x20u;
const u8 s_RagdollShapeFlagInvokeCreation = 0x40u;
const u8 s_RagdollShapeFlagUpdateBodyMass = 0x80u;

const u8 s_RagdollBoneExtraFlagUseSixDof = 0x01u;
const u8 s_RagdollBoneExtraFlagUseSolverMotors = 0x02u;

const u8 s_FluidFlagVolumeEnabled = 0x01u;
const u8 s_FluidFlagComponentEnabled = 0x02u;

const u8 s_ForceFieldFlagUseBounds = 0x01u;
const u8 s_ForceFieldFlagFieldEnabled = 0x02u;
const u8 s_ForceFieldFlagComponentEnabled = 0x04u;

const u8 s_ArticulationFlagIsFixedBase = 0x01u;
const u8 s_ArticulationFlagEnabled = 0x02u;
const u8 s_ArticulationFlagEnableContactCoupling = 0x04u;
const u8 s_ArticulationFlagEnableSelfCollision = 0x08u;
const u8 s_ArticulationFlagEnableSleep = 0x10u;
const u8 s_ArticulationFlagWriteBackToSkeleton = 0x20u;
const u8 s_ArticulationFlagWriteBackLinkTransforms = 0x40u;

const u8 s_ArticulationLinkFlagEnableLimit = 0x01u;
const u8 s_ArticulationLinkFlagEnableDrive = 0x02u;
const u8 s_ArticulationLinkFlagUseFullInertiaTensor = 0x04u;

const u8 s_ArticulationMimicFlagEnabled = 0x01u;

const u8 s_ArticulationTendonFlagIsEquality = 0x01u;
const u8 s_ArticulationTendonFlagEnabled = 0x02u;

const u8 s_ArticulationLoopFlagLockOrientation = 0x01u;
const u8 s_ArticulationLoopFlagEnabled = 0x02u;

const u8 s_SoftBodyFlagCollideWithWorld = 0x01u;
const u8 s_SoftBodyFlagEnabled = 0x02u;
const u8 s_SoftBodyFlagEnableSelfCollision = 0x04u;
const u8 s_SoftBodyFlagEnableTriangleEdgeSelfCollision = 0x08u;
const u8 s_SoftBodyFlagEnableVertexSplitTearing = 0x10u;
const u8 s_SoftBodyFlagEnableShapeMatching = 0x20u;

const u8 s_GpuExportFlagEnabled = 0x01u;

[serialize]
class CharacterControllerComponentBinary{
    public f32x4 up(0.0f, 1.0f, 0.0f, 0.0f);
    public f32x4 boxHalfExtents(0.35f, 0.9f, 0.35f, 0.0f);
    public NameHash collisionLayerHash;
    public f32 radius = 0.35f;
    public f32 halfHeight = 0.55f;
    public f32 skinWidth = 0.02f;
    public f32 maxSlopeAngleRad = 0.78539816f;
    public f32 stepUpHeight = 0.4f;
    public f32 stepDownHeight = 0.35f;
    public f32 maxStrength = 100.0f;
    public f32 mass = 75.0f;
    public f32 predictiveContactDistance = 0.08f;
    public u32 maxCollisionIterations = 4u;
    public u32 maxConstraintIterations = 4u;
    public u32 filterCategoryBits = 1u;
    public u32 filterMaskBits = u32.max;
    public i32 filterGroupIndex = 0;
    public u8 flags = 0u;
    public u8 shapeType = cast<u8>(CharacterShapeType::Capsule);
    public u16 reserved0 = 0u;
    public u32 reserved1 = 0u;
}

[serialize]
class VehicleComponentBinary{
    public NameHash collisionLayerHash;
    public u32 wheelCount = 0u;
    public u32 wheelNameCount = 0u;
    public u32 torqueCurvePointCount = 0u;
    public u32 gearCount = 5u;
    public i32 requestedGear = 1;
    public f32 maxTorque = 450.0f;
    public f32 idleRpm = 900.0f;
    public f32 maxRpm = 7000.0f;
    public f32 shiftUpRpm = 6200.0f;
    public f32 shiftDownRpm = 2200.0f;
    public f32 finalDriveRatio = 3.73f;
    public f32 reverseRatio = -3.4f;
    public f32 differentialBias = 0.5f;
    public f32 centerDiffFrontSplit = 0.5f;
    public f32 differentialLockTorque = 250.0f;
    public f32 clutchStrength = 12.0f;
    public f32 torqueConverterStallRpm = 2200.0f;
    public f32 torqueConverterMaxTorqueRatio = 1.6f;
    public f32 engineInertia = 0.35f;
    public f32 dragCoeff = 0.35f;
    public f32 downforceCoeff = 0.25f;
    public f32 trackWidth = 1.6f;
    public f32 wheelbase = 2.6f;
    public f32 espStrength = 1.0f;
    public f32 espMaxBrakeTorque = 2500.0f;
    public Array<f32, 6u> forwardGearRatios;
    public f32 throttle = 0.0f;
    public f32 brake = 0.0f;
    public f32 steer = 0.0f;
    public f32 handbrake = 0.0f;
    public f32 clutch = 0.0f;
    public u32 queryFilterCategoryBits = 1u;
    public u32 queryFilterMaskBits = u32.max;
    public i32 queryFilterGroupIndex = 0;
    public u16 flags = 0u;
    public u8 centerDifferentialMode = cast<u8>(VehicleDifferentialMode::LimitedSlip);
    public u8 axleDifferentialMode = cast<u8>(VehicleDifferentialMode::LimitedSlip);
}

[serialize]
class VehicleTorqueCurvePointBinary{
    public f32 rpm = 0.0f;
    public f32 torque = 0.0f;
}

[serialize]
class VehicleWheelBinary{
