void VerifyTextureImageLayoutFixture_SameIdentityVersionsMeasureTheirOwnImmutableDimensions(mut TextureImageLayoutFixture self){
    auto firstResult = self.makeImage(s_UiTextureLayoutVersionImagePath, 37u, 20u, 12u);
    ASSERT_TRUE(firstResult.has_value());
    auto secondResult = self.makeImage(s_UiTextureLayoutVersionImagePath, 73u, 9u, 7u);
    ASSERT_TRUE(secondResult.has_value());
    const SharedImageSource first = firstResult.value();
    const SharedImageSource second = secondResult.value();
    ASSERT_TRUE(cast<b8>(first) && cast<b8>(second));
    ASSERT_EQ(ImageSourceIdentity(first), ImageSourceIdentity(second));
    ASSERT_NE(ImageSourceGeneration(first), ImageSourceGeneration(second));
    const auto metricsResult = UiMeasureTextureImage(ImageOptions(), first);
    ASSERT_TRUE(metricsResult.has_value());
    EXPECT_FLOAT_EQ(metricsResult.value().contentSize.x, 20.0f);
    EXPECT_FLOAT_EQ(metricsResult.value().contentSize.y, 12.0f);
    const auto metricsResult2 = UiMeasureTextureImage(ImageOptions(), second);
    ASSERT_TRUE(metricsResult2.has_value());
    EXPECT_FLOAT_EQ(metricsResult2.value().contentSize.x, 9.0f);
    EXPECT_FLOAT_EQ(metricsResult2.value().contentSize.y, 7.0f);
    const auto metricsResult3 = UiMeasureTextureImage(ImageOptions(), first);
    ASSERT_TRUE(metricsResult3.has_value());
    EXPECT_FLOAT_EQ(metricsResult3.value().contentSize.x, 20.0f);
    EXPECT_FLOAT_EQ(metricsResult3.value().contentSize.y, 12.0f);
}

void VerifyTextureImageLayoutFixture_ZeroFixedExtentAndEmptyPlacementRemainValid(mut TextureImageLayoutFixture self){
    auto imageResult = self.makeImage();
    ASSERT_TRUE(imageResult.has_value());
    const SharedImageSource image = imageResult.value();
    ASSERT_TRUE(cast<b8>(image));
    ImageOptions options = ImageOptions();
    options.width = LayoutSize(LayoutSizePolicy::Fixed, 0.0f);
    options.height = LayoutSize(LayoutSizePolicy::Fixed, 0.0f);
    const auto metricsResult = UiMeasureTextureImage(options, image);
    ASSERT_TRUE(metricsResult.has_value());
    EXPECT_FLOAT_EQ(metricsResult.value().contentSize.x, 8.0f);
    EXPECT_FLOAT_EQ(metricsResult.value().contentSize.y, 4.0f);
    const auto placementResult = PlaceImage(Rect(10.0f, 20.0f, 0.0f, 0.0f), Rect(0.0f, 0.0f, 100.0f, 100.0f));
    ASSERT_TRUE(placementResult.has_value());
    EXPECT_FLOAT_EQ(placementResult.value().bounds.width, 0.0f);
    EXPECT_FLOAT_EQ(placementResult.value().clip.height, 0.0f);
}

void VerifyTextureImageLayoutFixture_InvalidSizePoliciesAndValuesRejectMeasurement(mut TextureImageLayoutFixture self){
    auto imageResult = self.makeImage();
    ASSERT_TRUE(imageResult.has_value());
    const SharedImageSource image = imageResult.value();
    ASSERT_TRUE(cast<b8>(image));
    for(u32 field = 0u; field < 8u; ++field){
        ImageOptions options = ImageOptions();
        if(field == 0u)
            options.width.policy = cast<LayoutSizePolicyEnum>(3u);
        else if(field == 1u)
            options.height.policy = cast<LayoutSizePolicyEnum>(3u);
        else if(field == 2u)
            options.width.value = -1.0f;
        else if(field == 3u)
            options.height.value = -1.0f;
        else if(field == 4u)
            options.width = LayoutSize(LayoutSizePolicy::Stretch, 0.0f);
        else if(field == 5u)
            options.height = LayoutSize(LayoutSizePolicy::Stretch, 0.0f);
        else if(field == 6u)
            options.width.value = bit_cast<f32>(s_UiTextureQuietNaNF32Bits);
        else
            options.height.value = bit_cast<f32>(s_UiTexturePosInfF32Bits);
        EXPECT_FALSE(UiMeasureTextureImage(options, image).has_value());
    }
}

void VerifyTextureImageLayoutFixture_InvalidTintRejectsMeasurement(mut TextureImageLayoutFixture self){
    auto imageResult = self.makeImage();
    ASSERT_TRUE(imageResult.has_value());
    const SharedImageSource image = imageResult.value();
    ASSERT_TRUE(cast<b8>(image));
    for(u32 field = 0u; field < 8u; ++field){
        ImageOptions options = ImageOptions();
        if(field == 0u)
            options.tint.r = -1.0f;
        else if(field == 1u)
            options.tint.g = -1.0f;
        else if(field == 2u)
            options.tint.b = -1.0f;
        else if(field == 3u)
            options.tint.r = bit_cast<f32>(s_UiTexturePosInfF32Bits);
        else if(field == 4u)
            options.tint.g = bit_cast<f32>(s_UiTextureQuietNaNF32Bits);
        else if(field == 5u)
            options.tint.b = bit_cast<f32>(s_UiTextureNegInfF32Bits);
        else if(field == 6u)
            options.tint.a = -0.01f;
        else
            options.tint.a = 1.01f;
        EXPECT_FALSE(UiMeasureTextureImage(options, image).has_value());
    }
}


