#include "scrollbar_style.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<ScrollViewportPlacement> CalculateScrollViewportPlacementCoreF64(
    in Rect bounds,
    in Rect clip,
    in Insets padding,
    in f64 contentWidth,
    in f64 contentHeight,
    in f64 previousScrollX,
    in f64 previousScrollY,
    in f32 thickness,
    in f32 minThumb,
    in ScrollbarPolicy horizontalPolicy,
    in ScrollbarPolicy verticalPolicy
){
    if(
        !IsValidUiRect(bounds) || !IsValidUiRect(clip) || !IsValidUiPadding(padding)
        || !IsFinite(VectorDouble(contentWidth, contentHeight, previousScrollX, previousScrollY))
        || contentWidth < 0.0 || contentHeight < 0.0 || previousScrollX < 0.0 || previousScrollY < 0.0
        || !IsFinite(VectorSingle(thickness, minThumb, 0.0f, 0.0f))
        || thickness < 0.0f || minThumb < 0.0f
        || horizontalPolicy > ScrollbarPolicy::Never
        || verticalPolicy > ScrollbarPolicy::Never
    )
        return MakeUnexpected(Failure());
    const Expected<Rect> paddedOpt = TryInsetUiRect(bounds, padding, UiRectPrecision::RoundedEndpoints);
    if(!paddedOpt.has_value())
        return MakeUnexpected(Failure());
    const Rect padded = paddedOpt.value();
    const f64 availableWidth = cast<f64>(padded.width);
    const f64 availableHeight = cast<f64>(padded.height);
    b8 horizontal = false;
    b8 vertical = false;
    f64 barWidth = 0.0;
    f64 barHeight = 0.0;
    ReserveScrollViewportAxes(
        availableWidth,
        availableHeight,
        contentWidth,
        contentHeight,
        cast<f64>(thickness),
        horizontalPolicy,
        verticalPolicy,
        horizontal,
        vertical,
        barWidth,
        barHeight
    );
    ScrollViewportPlacement candidate;
    const f64 paddedX = cast<f64>(padded.x);
    const f64 paddedY = cast<f64>(padded.y);
    const VectorDouble viewportSize = VectorDouble(availableWidth, availableHeight, availableWidth, availableHeight) - VectorDouble(barWidth, barHeight, barWidth, barHeight);
    const Expected<Rect> viewportRect = TryMakeUiRect(paddedX, paddedY, viewportSize.x, viewportSize.y, UiRectPrecision::RoundedEndpoints);
    if(!viewportRect.has_value())
        return MakeUnexpected(Failure());
    candidate.viewport = viewportRect.value();
    if((barWidth > 0.0 && candidate.viewport.width >= padded.width) || (barHeight > 0.0 && candidate.viewport.height >= padded.height))
        return MakeUnexpected(Failure());
    const Expected<Rect> contentClip = TryIntersectUiRects(candidate.viewport, clip, UiRectPrecision::RoundedEndpoints);
    if(!contentClip.has_value())
        return MakeUnexpected(Failure());
    candidate.contentClip = contentClip.value();
    const f64 viewportWidth = cast<f64>(candidate.viewport.width);
    const f64 viewportHeight = cast<f64>(candidate.viewport.height);
    const VectorDouble cornerOrigin = VectorDouble(paddedX, paddedY, paddedX, paddedY) + VectorDouble(viewportWidth, viewportHeight, viewportWidth, viewportHeight);
    const f64 cornerX = cornerOrigin.x;
    const f64 cornerY = cornerOrigin.y;
    Rect horizontalTrack;
    Rect verticalTrack;
    if(horizontal && viewportWidth > 0.0 && barHeight > 0.0){
        const Expected<Rect> hTrack = TryMakeUiRect(paddedX, cornerY, viewportWidth, barHeight, UiRectPrecision::RoundedEndpoints);
        if(!hTrack.has_value())
            return MakeUnexpected(Failure());
        horizontalTrack = hTrack.value();
    }
    if(vertical && viewportHeight > 0.0 && barWidth > 0.0){
        const Expected<Rect> vTrack = TryMakeUiRect(cornerX, paddedY, barWidth, viewportHeight, UiRectPrecision::RoundedEndpoints);
        if(!vTrack.has_value())
            return MakeUnexpected(Failure());
        verticalTrack = vTrack.value();
    }
    if(barWidth > 0.0 && barHeight > 0.0){
        const Expected<Rect> corner = TryMakeUiRect(cornerX, cornerY, barWidth, barHeight, UiRectPrecision::RoundedEndpoints);
        if(!corner.has_value())
            return MakeUnexpected(Failure());
        candidate.corner = corner.value();
    }
    f64 hContent = contentWidth;
    f64 hOffset = previousScrollX;
    if(horizontalPolicy == ScrollbarPolicy::Never){
        hContent = viewportWidth;
        hOffset = 0.0;
    }
    f64 vContent = contentHeight;
    f64 vOffset = previousScrollY;
    if(verticalPolicy == ScrollbarPolicy::Never){
        vContent = viewportHeight;
        vOffset = 0.0;
    }
    const Expected<ScrollbarPlacement> hPlacement = TryBuildScrollbarPlacement(hContent, viewportWidth, horizontalTrack, minThumb, hOffset, ScrollAxis::Horizontal);
    if(!hPlacement.has_value())
        return MakeUnexpected(Failure());
    candidate.horizontal = hPlacement.value();
    const Expected<ScrollbarPlacement> vPlacement = TryBuildScrollbarPlacement(vContent, viewportHeight, verticalTrack, minThumb, vOffset, ScrollAxis::Vertical);
    if(!vPlacement.has_value())
        return MakeUnexpected(Failure());
    candidate.vertical = vPlacement.value();
    return candidate;
}

Expected<ScrollViewportPlacement> CalculateScrollViewportPlacementCore(
    in Rect bounds,
    in Rect clip,
    in Insets padding,
    in f64 contentWidth,
    in f64 contentHeight,
    in Point previousScroll,
    in f32 thickness,
    in f32 minThumb,
    in ScrollbarPolicy horizontalPolicy,
    in ScrollbarPolicy verticalPolicy
){
    if(!IsValidUiExtent(previousScroll))
        return MakeUnexpected(Failure());
    return CalculateScrollViewportPlacementCoreF64(
        bounds,
        clip,
        padding,
        contentWidth,
        contentHeight,
        cast<f64>(previousScroll.x),
        cast<f64>(previousScroll.y),
        thickness,
        minThumb,
        horizontalPolicy,
        verticalPolicy
    );
}

Expected<ScrollViewportPlacement> CalculateScrollViewportPlacementWithPolicies(
    in Rect bounds,
    in Rect clip,
    in Insets padding,
    in Point contentMeasure,
    in Point previousScroll,
    in f32 thickness,
    in f32 minThumb,
    in ScrollbarPolicy horizontalPolicy,
    in ScrollbarPolicy verticalPolicy
){
    if(!IsValidUiExtent(contentMeasure))
        return MakeUnexpected(Failure());
    return CalculateScrollViewportPlacementCore(
        bounds,
        clip,
        padding,
        cast<f64>(contentMeasure.x),
        cast<f64>(contentMeasure.y),
        previousScroll,
        thickness,
        minThumb,
        horizontalPolicy,
        verticalPolicy
    );
}

Expected<ScrollViewportPlacement> CalculateScrollViewportPlacement(in Rect bounds, in Rect clip, in Insets padding, in Point contentMeasure, in f32 caretWidth, in Point previousScroll, in f32 thickness, in f32 minThumb){
    if(
        !IsValidUiExtent(contentMeasure)
        || !IsFinite(VectorSingle(caretWidth)) || caretWidth <= 0.0f
    )
        return MakeUnexpected(Failure());
    const VectorDouble contentExtent = VectorDouble(cast<f64>(contentMeasure.x), cast<f64>(contentMeasure.y), 0.0, 0.0) + VectorDouble(cast<f64>(caretWidth), 0.0, 0.0, 0.0);
    return CalculateScrollViewportPlacementCore(
        bounds,
        clip,
        padding,
        contentExtent.x,
        contentExtent.y,
        previousScroll,
        thickness,
        minThumb,
        ScrollbarPolicy::Auto,
        ScrollbarPolicy::Auto
    );
}

b8 TryUpdateScrollViewportOffsets(in Point scroll, mut ScrollViewportPlacement placement){
    if(
        !IsValidUiExtent(scroll) || !IsValidUiRect(placement.viewport) || !IsValidUiRect(placement.contentClip) || !IsValidUiRect(placement.corner)
        || placement.horizontal.viewportExtent != cast<f64>(placement.viewport.width)
        || placement.vertical.viewportExtent != cast<f64>(placement.viewport.height)
        || !IsValidScrollbarPlacement(placement.horizontal, ScrollAxis::Horizontal)
        || !IsValidScrollbarPlacement(placement.vertical, ScrollAxis::Vertical)
    )
        return false;
    ScrollViewportPlacement candidate = placement;
    if(!TryStoreScrollbarOffset(cast<f64>(scroll.x), ScrollAxis::Horizontal, candidate.horizontal) || !TryStoreScrollbarOffset(cast<f64>(scroll.y), ScrollAxis::Vertical, candidate.vertical))
        return false;
    placement = candidate;
    return true;
}

Expected<f32> TryStepScrollbarOffset(in f64 offset, in f64 delta, in f64 step, in f64 maximum){
    if(!IsFinite(VectorDouble(offset, delta, step, maximum)) || step < 0.0 || maximum < 0.0)
        return MakeUnexpected(Failure());
    f64 next = 0.0;
    if(offset > 0.0)
        next = UiSimdMinF64(maximum, offset);
    if(step > 0.0 && delta > 0.0){
        const f64 distanceInSteps = (maximum - next) / step;
        if(delta >= distanceInSteps)
            next = maximum;
        else
            next = next + (delta * step);
    }
    else if(step > 0.0 && delta < 0.0){
        const f64 distanceInSteps = next / step;
        if((-delta) >= distanceInSteps)
            next = 0.0;
        else
            next = next + (delta * step);
    }
    if(!IsFinite(VectorDouble(next)) || next > s_UiMaxFloatF64)
        return MakeUnexpected(Failure());
    return cast<f32>(next);
}

Expected<f32> TryDragScrollbarOffset(in PointerGesture gesture, in b8 horizontal){
    f64 currentTarget = cast<f64>(gesture.targetRectangle.y);
    f64 currentPointer = cast<f64>(gesture.position.y);
    f64 referenceTarget = cast<f64>(gesture.referenceRectangle.y);
    f64 referencePointer = cast<f64>(gesture.origin.y);
    f64 referenceExtent = cast<f64>(gesture.referenceRectangle.height);
    f64 targetExtent = cast<f64>(gesture.targetRectangle.height);
    if(horizontal){
        currentTarget = cast<f64>(gesture.targetRectangle.x);
        currentPointer = cast<f64>(gesture.position.x);
        referenceTarget = cast<f64>(gesture.referenceRectangle.x);
        referencePointer = cast<f64>(gesture.origin.x);
        referenceExtent = cast<f64>(gesture.referenceRectangle.width);
        targetExtent = cast<f64>(gesture.targetRectangle.width);
    }
    const f64 startDelta = currentTarget - referenceTarget;
    const f64 pointerDelta = currentPointer - referencePointer;
    const f64 travel = referenceExtent - targetExtent;
    const f64 maximum = gesture.maximum;
    if(!IsFinite(VectorDouble(travel, startDelta, pointerDelta, maximum)) || travel <= 0.0 || maximum < 0.0)
        return MakeUnexpected(Failure());
    const f64 normalized = (startDelta + pointerDelta) / travel;
    f64 clamped = 0.0;
    if(normalized > 0.0)
        clamped = UiSimdMinF64(1.0, normalized);
    const f64 next = clamped * maximum;
    if(!IsFinite(VectorDouble(next)) || next > s_UiMaxFloatF64)
        return MakeUnexpected(Failure());
    return cast<f32>(next);
}

Name ResolveScrollbarThumbRegionName(in ScrollbarStyle style, in b8 enabled, in b8 pressed, in b8 hovered){
    if(!enabled)
        return style.thumbDisabled;
    if(pressed)
        return style.thumbPressed;
    if(hovered)
        return style.thumbHover;
    return style.thumb;
}

void ResolveScrollTrackBeforeAfterRects(
    in Rect track,
    in Rect thumb,
    in b8 horizontal,
    mut Rect outBeforeRect,
    mut Rect outAfterRect
){
    f32 start = track.y;
    f32 thumbStart = thumb.y;
    f32 trackExtent = track.height;
    f32 thumbExtent = thumb.height;
    if(horizontal){
        start = track.x;
        thumbStart = thumb.x;
        trackExtent = track.width;
        thumbExtent = thumb.width;
    }
    const VectorSingle zeroVec(0.0f);
    const VectorSingle marginInputs(
        thumbStart - start,
        ((start + trackExtent) - thumbStart) - thumbExtent,
        0.0f,
        0.0f
    );
    const VectorSingle clampedMargins = VectorSelect(marginInputs, zeroVec, VectorGreater(zeroVec, marginInputs));
    const f32 before = clampedMargins.x;
    const f32 after = clampedMargins.y;
    outBeforeRect = track;
    outAfterRect = track;
    if(horizontal){
        outBeforeRect.width = before;
        outAfterRect.x = thumbStart + thumbExtent;
        outAfterRect.width = after;
    }
    else{
        outBeforeRect.height = before;
        outAfterRect.y = thumbStart + thumbExtent;
        outAfterRect.height = after;
    }
}

void ResolveScrollbarBeforeAfterRects(
    in ScrollbarPlacement bar,
    in b8 horizontal,
    mut Rect outBeforeRect,
    mut Rect outAfterRect
){
    ResolveScrollTrackBeforeAfterRects(bar.track, bar.thumb, horizontal, outBeforeRect, outAfterRect);
}

u8 SelectNextScrollInputStream(
    in b8 haveHorizontal,
    in u64 horizontalSequence,
    in b8 haveVertical,
    in u64 verticalSequence,
    in b8 haveAction,
    in u64 actionSequence
){
    if(haveHorizontal && (!haveVertical || horizontalSequence <= verticalSequence) && (!haveAction || horizontalSequence <= actionSequence))
        return 0u;
    if(haveVertical && (!haveAction || verticalSequence <= actionSequence))
        return 1u;
    return 2u;
}

Expected<ListScrollPlacementResult> CalculateListScrollPlacement(
    in Rect bounds,
    in Rect inheritedClip,
    in Insets padding,
    in f32 scrollbarWidth,
    in f32 minimumThumb,
    in u64 rowCount,
    in f32 rowHeight,
    in Span<f64> rowOffsets,
    in f64 contentWidth,
    in f64 offsetX,
    in f64 offsetY,
    in ScrollbarPolicy horizontalPolicy,
    in ScrollbarPolicy verticalPolicy
){
    if(
        (!rowOffsets.empty() && rowOffsets.size() != cast<usize>(rowCount) + 1u)
        || !IsFinite(VectorDouble(contentWidth, offsetX, offsetY, 0.0))
        || contentWidth < 0.0 || offsetX < 0.0 || offsetY < 0.0
    )
        return MakeUnexpected(Failure());
    if(horizontalPolicy == ScrollbarPolicy::Never && verticalPolicy == ScrollbarPolicy::Auto && rowOffsets.empty()){
        const Expected<ScrollPlacement> uniform = CalculateScrollPlacement(
            bounds,
            inheritedClip,
            padding,
            scrollbarWidth,
            minimumThumb,
            rowCount,
            rowHeight,
            offsetY
        );
        if(!uniform.has_value())
            return MakeUnexpected(Failure());
        ListScrollPlacementResult result;
        result.placement = uniform.value();
        result.scrollbars.viewport = uniform.value().viewport;
        result.scrollbars.contentClip = uniform.value().contentClip;
        result.scrollbars.horizontal.contentExtent = cast<f64>(uniform.value().viewport.width);
        result.scrollbars.horizontal.viewportExtent = cast<f64>(uniform.value().viewport.width);
        result.scrollbars.vertical.track = uniform.value().track;
        result.scrollbars.vertical.thumb = uniform.value().thumb;
        result.scrollbars.vertical.contentExtent = uniform.value().contentHeight;
        result.scrollbars.vertical.viewportExtent = cast<f64>(uniform.value().viewport.height);
        result.scrollbars.vertical.maximum = uniform.value().maxOffset;
        result.scrollbars.vertical.offset = uniform.value().offset;
        result.scrollbars.vertical.visible = uniform.value().scrollbarVisible;
        return result;
    }
    if(!IsFinite(VectorSingle(rowHeight)) || rowHeight <= 0.0f)
        return MakeUnexpected(Failure());
    f64 contentHeight = 0.0;
    if(rowOffsets.empty())
        contentHeight = cast<f64>(rowCount) * cast<f64>(rowHeight);
    else
        contentHeight = rowOffsets[cast<usize>(rowCount)];
    if(!IsFinite(VectorDouble(contentHeight)) || contentHeight < 0.0)
        return MakeUnexpected(Failure());
    const Expected<ScrollViewportPlacement> scrollbarsOpt = CalculateScrollViewportPlacementCoreF64(
        bounds,
        inheritedClip,
        padding,
        contentWidth,
        contentHeight,
        offsetX,
        offsetY,
        scrollbarWidth,
        minimumThumb,
        horizontalPolicy,
        verticalPolicy
    );
    if(!scrollbarsOpt.has_value())
        return MakeUnexpected(Failure());
    in ScrollViewportPlacement sb = scrollbarsOpt.value();
    ListScrollPlacementResult result;
    result.scrollbars = sb;
    result.placement.bounds = bounds;
    result.placement.viewport = sb.viewport;
    result.placement.contentClip = sb.contentClip;
    result.placement.track = sb.vertical.track;
    result.placement.thumb = sb.vertical.thumb;
    result.placement.contentHeight = sb.vertical.contentExtent;
    result.placement.maxOffset = sb.vertical.maximum;
    result.placement.offset = sb.vertical.offset;
    result.placement.rowCount = rowCount;
    result.placement.scrollbarVisible = sb.vertical.visible;
    if(sb.contentClip.width > 0.0f && sb.contentClip.height > 0.0f && rowCount > 0u){
        const f64 clippedTop = cast<f64>(sb.contentClip.y) - cast<f64>(sb.viewport.y);
        const f64 startPos = sb.vertical.offset + clippedTop;
        const f64 endPos = startPos + cast<f64>(sb.contentClip.height);
        const f64 clampedStart = UiSimdMaxF64(0.0, startPos);
        const f64 clampedEnd = UiSimdMaxF64(0.0, endPos);
        if(!rowOffsets.empty()){
            CalculateVariableRowScrollRange(rowOffsets, clampedStart, clampedEnd, result.placement.firstRow, result.placement.endRow);
        }
        else{
            const f64 rowHeightF64 = cast<f64>(rowHeight);
            const f64 firstRow = VectorDoubleFloor(VectorDouble(clampedStart / rowHeightF64)).x;
            const f64 endRow = VectorDoubleCeiling(VectorDouble(clampedEnd / rowHeightF64)).x;
            const f64 rowCountF64 = cast<f64>(rowCount);
            if(firstRow >= rowCountF64)
                result.placement.firstRow = rowCount;
            else if(firstRow <= 0.0)
                result.placement.firstRow = 0u;
            else
                result.placement.firstRow = cast<u64>(firstRow);
            u64 boundedEnd = 0u;
            if(endRow >= rowCountF64)
                boundedEnd = rowCount;
            else if(endRow <= 0.0)
                boundedEnd = 0u;
            else
                boundedEnd = cast<u64>(endRow);
            result.placement.endRow = Max(result.placement.firstRow, boundedEnd);
        }
    }
    return result;
}


