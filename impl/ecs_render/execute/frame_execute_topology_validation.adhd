////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/kernel/graphics_prefix_timing_ticket.adhd>

#include <impl/ecs_render/execute/deferred_frame_topology_validator.adhd>
#include <impl/ecs_render/execute/execute_internal.adhd>
#include <impl/ecs_render/execute/frame_diagnostics.adhd>
#include <impl/ecs_render/shadow/shadow_prepare_packet_validator.adhd>
#include <impl/ecs_render/shadow/shadow_visibility_merge_validator.adhd>
#include <impl/ecs_render/shared/frame_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsValidDeferredFrameTimingEnvelopeBegin(in b8 taskValid, in b8 taskCompiled, in b8 queueGraphicsOnPrimary, in b8 beginPacketValid, in u32 beginPacketIndex, in b8 envelopeValid, in b8 envelopeStartsAtBeginPacket){
    return taskValid && taskCompiled && queueGraphicsOnPrimary && beginPacketValid && beginPacketIndex == 0u && envelopeValid && envelopeStartsAtBeginPacket;
}

b8 HasQueueCapabilityMask(in u8 queueCapabilities, in u8 requiredCapability){
    return (queueCapabilities & requiredCapability) != 0u;
}

b8 IsValidGraphicsPrefixTimingSliceLengths(in usize ownedTicketsSize, in usize timingTicketsSize, in usize timingTasksSize){
    return ownedTicketsSize == s_GraphicsPrefixTimingTaskCount && timingTicketsSize == s_GraphicsPrefixTimingTaskCount && timingTasksSize == s_GraphicsPrefixTimingTaskCount;
}

b8 IsAcceptedShadowPreparePacketMerges(
    in b8 softwareBvhBuildsMerged,
    in b8 softwareSceneRefitMerged,
    in b8 accelStructFinalizeMerged,
    in b8 bindlessSlotsUploadMerged,
    in b8 rayTraceMaterialContextSlotsUploadMerged,
    in b8 causticEmissionTargetsUploadMerged,
    in b8 surfelFrameConstantsUploadMerged,
    in b8 shadowMaterialContextUploadsMerged,
    in b8 sceneBvhUploadsMerged
){
    return
        softwareBvhBuildsMerged
        && softwareSceneRefitMerged
        && accelStructFinalizeMerged
        && bindlessSlotsUploadMerged
        && rayTraceMaterialContextSlotsUploadMerged
        && causticEmissionTargetsUploadMerged
        && surfelFrameConstantsUploadMerged
        && shadowMaterialContextUploadsMerged
        && sceneBvhUploadsMerged
    ;
}

b8 IsAcceptedOpaqueEmulationMerges(in OpaqueEmulationMergeValidationResult validation){
    return
        validation.packetsAreGraphics
        && validation.opaqueComputeEmulationMerged
        && validation.opaqueSharedComputeEmulationMerged
        && validation.opaqueCsgReceiverComputeEmulationMerged
        && validation.opaqueCsgIntervalSampleComputeEmulationMerged
        && validation.csgIntervalClearBundleMerged
    ;
}

b8 IsAcceptedCausticsPacketMerges(
    in b8 irradianceClearValid,
    in b8 photonValid,
    in b8 photonMerged,
    in b8 geometryValid,
    in b8 geometryMerged,
    in b8 resolvePrepareValid,
    in b8 resolvePrepareMerged,
    in b8 resolveWaveletsMerged,
    in b8 resolveUpsampleValid,
    in b8 resolveUpsampleMerged,
    in b8 irradianceClearMerged,
    in b8 accumulatorBootstrapClearMerged,
    in b8 accumulatorDecayMerged
){
    return
        irradianceClearValid
        && photonValid
        && photonMerged
        && geometryValid
        && geometryMerged
        && resolvePrepareValid
        && resolvePrepareMerged
        && resolveWaveletsMerged
        && resolveUpsampleValid
        && resolveUpsampleMerged
        && irradianceClearMerged
        && accumulatorBootstrapClearMerged
        && accumulatorDecayMerged
    ;
}

b8 AreAllSurfelGiPreparedPrefixTasksAbsent(in b8 ageFreeValid, in b8 cellHeadClearValid, in b8 hashBuildValid, in b8 spawnValid, in b8 traceBuildArgsValid, in b8 traceValid, in b8 resolveValid){
    return !ageFreeValid && !cellHeadClearValid && !hashBuildValid && !spawnValid && !traceBuildArgsValid && !traceValid && !resolveValid;
}

b8 AreAllSurfelGiPreparedPrefixTasksPresent(in b8 ageFreeValid, in b8 cellHeadClearValid, in b8 hashBuildValid, in b8 spawnValid, in b8 traceBuildArgsValid, in b8 traceValid, in b8 resolveValid){
    return ageFreeValid && cellHeadClearValid && hashBuildValid && spawnValid && traceBuildArgsValid && traceValid && resolveValid;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


GpuTaskId GraphicsPrefixTaskOrFallback(in GpuTaskId task, in GpuTaskId fallback){
    if(task.valid())
        return task;
    return fallback;
}

b8 DeferredFrameTopologyValidator::validate(
    in GpuCompiledGraphReadView deferredCompiledPlan,
    in GpuTaskGraphDeclarationReadView deferredTaskGraphView,
    mut FrameExecuteTimingState timing,
    in GpuPhysicalQueueId primaryGraphicsQueue,
    in b8 deferredGraphScheduled,
    in b8 captureLaggedLightingHistory,
    in b8 hardwareShadowSupported,
    in b8 hasOpaqueCsgFrameWork,
    in b8 hasTransparentRenderers,
    in b8 clearAvboitTargets,
    in b8 laggedAsyncLightingSchedule,
    in b8 laggedLightingHistoryWriterWaitPending,
    in b8 surfelCounterReadbackCompletionValid,
    mut DeferredFrameTopologyResult outResult
)const{
    ShadowPreparePacketValidator shadowPreparePacketValidator(this.m_pipeline);
    ShadowPreparePacketValidationResult shadowPreparePacket;
    shadowPreparePacketValidator.validate(deferredCompiledPlan, shadowPreparePacket);
    Array<GpuTaskId, s_GraphicsPrefixTimingTaskCount> graphicsPrefixTimingTasks;
    GraphicsPrefixTimingResolver graphicsPrefixTimingResolver(this.m_pipeline);
    GraphicsPrefixTimingResolutionResult graphicsPrefixTimingResolution;
    graphicsPrefixTimingResolver.resolve(deferredCompiledPlan, timing.graphicsPrefixOwnedTimingTickets, timing.graphicsPrefixTimingTickets, graphicsPrefixTimingTasks, timing.asyncPrefixTimingSpansOnePacket, graphicsPrefixTimingResolution);
    const b8 graphicsPrefixTimingBindingsValid = graphicsPrefixTimingResolution.bindingsValid;
    const usize graphicsPrefixUniquePacketCount = graphicsPrefixTimingResolution.uniquePacketCount;
    ShadowVisibilityMergeValidator shadowVisibilityMergeValidator(this.m_pipeline);
    ShadowVisibilityMergeValidationResult shadowVisibilityMerge;
    shadowVisibilityMergeValidator.validate(deferredCompiledPlan, shadowVisibilityMerge);
    const b8 shadowVisibilityPreparedTasksMerged = shadowVisibilityMerge.preparedTasksMerged;
    const b8 shadowVisibilityAllLitClearMerged = shadowVisibilityMerge.allLitClearMerged;
    const b8 shadowVisibilityAdaptivePrimitivesMerged = shadowVisibilityMerge.adaptivePrimitivesMerged;
    const Optional<GpuPhysicalQueueInfo> shadowVisibilityQueue = deferredCompiledPlan.findQueueInfoForTask(this.m_pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityTask);
    const Optional<GpuPhysicalQueueInfo> graphicsPrefixQueue = deferredCompiledPlan.findQueueInfoForTask(this.m_pipeline.m_graphicsPrefixGraph.m_graphicsPrefixTask);
    OpaqueEmulationMergeValidator opaqueEmulationMergeValidator(this.m_pipeline);
    OpaqueEmulationMergeValidationResult opaqueEmulationMerge;
    opaqueEmulationMergeValidator.validate(deferredCompiledPlan, graphicsPrefixTimingTasks, graphicsPrefixTimingBindingsValid, hasOpaqueCsgFrameWork, opaqueEmulationMerge);
    const Optional<GpuPhysicalQueueInfo> frameTimingBeginQueue = deferredCompiledPlan.findQueueInfoForTask(this.m_pipeline.m_deferredFrameTimingBeginTask);
    const GpuSubmissionPacketId frameTimingBeginPacket = deferredCompiledPlan.packetForTask(this.m_pipeline.m_deferredFrameTimingBeginTask);
    const GpuSubmissionPacketRange frameTimingEnvelope = deferredCompiledPlan.packetTimingEnvelopeRange();
    const Optional<GpuPhysicalQueueInfo> shadowPrepareQueue = deferredCompiledPlan.findQueueInfoForTask(this.m_pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareTask);
    const Optional<GpuPhysicalQueueInfo> softwareCausticsQueue = deferredCompiledPlan.findQueueInfoForTask(this.m_pipeline.m_causticsGraph.m_deferredSoftwareCausticsTask);
    const RendererAvboitTaskGraphValidation avboitValidation = this.m_pipeline.m_avboitSystem.validateTaskGraphStage(deferredCompiledPlan, clearAvboitTargets, hasTransparentRenderers);
    GpuTaskId causticsTask = this.m_pipeline.m_causticsGraph.m_deferredSoftwareCausticsTask;
    if(hardwareShadowSupported)
        causticsTask = this.m_pipeline.m_causticsGraph.m_deferredHardwareCausticsTask;
    const b8 laggedLightingHistorySlotsUploadMergedIntoLightingPacket = !this.m_pipeline.m_deferredLaggedLightingHistorySlotsUploadTask.valid()
        || deferredCompiledPlan.tasksSharePacket(this.m_pipeline.m_deferredLightingTask, this.m_pipeline.m_deferredLaggedLightingHistorySlotsUploadTask);
    const Optional<GpuCompiledPresentEndpoint> presentationEndpoint = deferredCompiledPlan.findPresentEndpoint();
    GpuTaskId terminalPresentationTask;
    if(presentationEndpoint.has_value())
        terminalPresentationTask = presentationEndpoint.value().producer;
    const Optional<GpuPhysicalQueueInfo> deferredLightingQueue = deferredCompiledPlan.findQueueInfoForTask(this.m_pipeline.m_deferredLightingTask);
    const Optional<GpuPhysicalQueueInfo> deferredCompositeQueue = deferredCompiledPlan.findQueueInfoForTask(this.m_pipeline.m_deferredCompositeTask);
    const Optional<GpuPhysicalQueueInfo> deferredPresentQueue = deferredCompiledPlan.findQueueInfoForTask(this.m_pipeline.m_deferredPresentTask);
    const Optional<GpuPhysicalQueueInfo> deferredPresentationOverlayQueue = deferredCompiledPlan.findQueueInfoForTask(this.m_pipeline.m_deferredPresentationOverlayTask);
    Optional<GpuPhysicalQueueInfo> terminalPresentationQueue;
    if(presentationEndpoint.has_value())
        terminalPresentationQueue = deferredCompiledPlan.findQueueInfo(presentationEndpoint.value().queue);
    const Optional<GpuPhysicalQueueInfo> deferredLaggedLightingHistoryQueue = deferredCompiledPlan.findQueueInfoForTask(this.m_pipeline.m_deferredLaggedLightingHistoryTask);
    const Optional<GpuPhysicalQueueInfo> deferredFrameRecoveryQueue = deferredCompiledPlan.findQueueInfoForTask(this.m_pipeline.m_deferredFrameRecoveryTask);
    SurfelCausticsMergeValidator surfelCausticsMergeValidator(this.m_pipeline);
    SurfelCausticsMergeValidationResult surfelCausticsMerge;
    surfelCausticsMergeValidator.validate(deferredCompiledPlan, causticsTask, terminalPresentationTask, captureLaggedLightingHistory, surfelCausticsMerge);
    const Optional<GpuPhysicalQueueInfo> hardwareCausticsQueue = surfelCausticsMerge.hardwareCausticsQueue;
    const Optional<GpuPhysicalQueueInfo> surfelGiQueue = surfelCausticsMerge.surfelGiQueue;
    const Optional<GpuPhysicalQueueInfo> surfelGiPreparationQueue = surfelCausticsMerge.surfelGiPreparationQueue;
    const Optional<GpuPhysicalQueueInfo> surfelGiSnapshotCopyQueue = surfelCausticsMerge.surfelGiSnapshotCopyQueue;
    const Optional<GpuPhysicalQueueInfo> surfelGiCounterReadbackQueue = surfelCausticsMerge.surfelGiCounterReadbackQueue;
    const b8 surfelGiOutputClearMergedIntoGiPacket = surfelCausticsMerge.surfelGiOutputClearMergedIntoGiPacket;
    const b8 surfelGiPreparedPrefixMergedIntoGiPacket = surfelCausticsMerge.surfelGiPreparedPrefixMergedIntoGiPacket;
    const b8 surfelGiInitializationLifecycleMergedIntoPreparationPacket = surfelCausticsMerge.surfelGiInitializationLifecycleMergedIntoPreparationPacket;
    const b8 causticPhotonMergedIntoCausticsPacket = surfelCausticsMerge.causticPhotonMergedIntoCausticsPacket;
    const b8 causticGeometryMergedIntoCausticsPacket = surfelCausticsMerge.causticGeometryMergedIntoCausticsPacket;
    const b8 surfelGiSnapshotCopyAndTimingPacketsAreDistinct = surfelCausticsMerge.surfelGiSnapshotCopyAndTimingPacketsAreDistinct;
    const b8 surfelCounterReadbackFollowsPresentation = surfelCausticsMerge.surfelCounterReadbackFollowsPresentation;
    const b8 laggedLightingHistoryFollowsPresentation = surfelCausticsMerge.laggedLightingHistoryFollowsPresentation;
    if(
        !deferredGraphScheduled
        || !this.m_pipeline.m_deferredLightingTaskGraphScheduled
        || !IsValidDeferredFrameTimingEnvelopeBegin(
            this.m_pipeline.m_deferredFrameTimingBeginTask.valid(),
            deferredCompiledPlan.findTask(this.m_pipeline.m_deferredFrameTimingBeginTask).valid(),
            frameTimingBeginQueue.has_value() && frameTimingBeginQueue.value().queueClass == CommandQueue::Graphics && frameTimingBeginQueue.value().id == primaryGraphicsQueue,
            frameTimingBeginPacket.valid(),
            frameTimingBeginPacket.index,
            frameTimingEnvelope.valid(),
            frameTimingEnvelope.first == frameTimingBeginPacket
        )
        || !this.m_pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareTask.valid()
        || !deferredCompiledPlan.findTask(this.m_pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareTask).valid()
        || deferredCompiledPlan.tasksSharePacket(this.m_pipeline.m_deferredFrameTimingBeginTask, this.m_pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareTask)
        || !IsAcceptedShadowPreparePacketMerges(
            shadowPreparePacket.softwareBvhBuildsMerged,
            shadowPreparePacket.softwareSceneRefitMerged,
            shadowPreparePacket.accelStructFinalizeMerged,
            shadowPreparePacket.bindlessSlotsUploadMerged,
            shadowPreparePacket.rayTraceMaterialContextSlotsUploadMerged,
            shadowPreparePacket.causticEmissionTargetsUploadMerged,
            shadowPreparePacket.surfelFrameConstantsUploadMerged,
            shadowPreparePacket.shadowMaterialContextUploadsMerged,
            shadowPreparePacket.sceneBvhUploadsMerged
        )
        || !shadowPrepareQueue.has_value()
        || shadowPrepareQueue.value().queueClass != CommandQueue::Graphics
        || !this.m_pipeline.m_graphicsPrefixGraph.m_graphicsPrefixMeshViewSetupTask.valid()
        || !this.m_pipeline.m_graphicsPrefixGraph.m_graphicsPrefixSceneShadingSetupTask.valid()
        || !this.m_pipeline.m_graphicsPrefixGraph.m_graphicsPrefixDeferredClearTask.valid()
        || !this.m_pipeline.m_graphicsPrefixGraph.m_graphicsPrefixGbufferTask.valid()
        || (hasOpaqueCsgFrameWork && (!this.m_pipeline.m_graphicsPrefixGraph.m_graphicsPrefixCsgReceiverSpanTask.valid() || !this.m_pipeline.m_graphicsPrefixGraph.m_graphicsPrefixCsgIntervalCombineTask.valid()
            || !this.m_pipeline.m_graphicsPrefixGraph.m_graphicsPrefixCsgIntervalSampleTask.valid()))
        || !this.m_pipeline.m_graphicsPrefixGraph.m_graphicsPrefixTask.valid()
        || !deferredCompiledPlan.findTask(this.m_pipeline.m_graphicsPrefixGraph.m_graphicsPrefixMeshViewSetupTask).valid()
        || !deferredCompiledPlan.findTask(this.m_pipeline.m_graphicsPrefixGraph.m_graphicsPrefixSceneShadingSetupTask).valid()
        || !deferredCompiledPlan.findTask(this.m_pipeline.m_graphicsPrefixGraph.m_graphicsPrefixDeferredClearTask).valid()
        || !deferredCompiledPlan.findTask(this.m_pipeline.m_graphicsPrefixGraph.m_graphicsPrefixGbufferTask).valid()
        || (hasOpaqueCsgFrameWork && (
            !deferredCompiledPlan.findTask(this.m_pipeline.m_graphicsPrefixGraph.m_graphicsPrefixCsgReceiverSpanTask).valid()
            || !deferredCompiledPlan.findTask(this.m_pipeline.m_graphicsPrefixGraph.m_graphicsPrefixCsgIntervalCombineTask).valid()
            || !deferredCompiledPlan.findTask(this.m_pipeline.m_graphicsPrefixGraph.m_graphicsPrefixCsgIntervalSampleTask).valid()
        ))
        || !deferredCompiledPlan.findTask(this.m_pipeline.m_graphicsPrefixGraph.m_graphicsPrefixTask).valid()
        || !graphicsPrefixTimingBindingsValid
        || !IsAcceptedOpaqueEmulationMerges(opaqueEmulationMerge)
        || !graphicsPrefixQueue.has_value()
        || graphicsPrefixQueue.value().queueClass != CommandQueue::Graphics
        || !this.m_pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityTask.valid()
        || !deferredCompiledPlan.findTask(this.m_pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityTask).valid()
        || !shadowVisibilityPreparedTasksMerged
        || !shadowVisibilityAllLitClearMerged
        || !shadowVisibilityAdaptivePrimitivesMerged
        || !shadowVisibilityQueue.has_value()
        || (!hardwareShadowSupported && (!this.m_pipeline.m_causticsGraph.m_deferredSoftwareCausticsTask.valid() || !deferredCompiledPlan.findTask(this.m_pipeline.m_causticsGraph.m_deferredSoftwareCausticsTask).valid() || !softwareCausticsQueue.has_value()))
        || !IsAcceptedCausticsPacketMerges(
            this.m_pipeline.m_causticsGraph.m_deferredCausticIrradianceClearTask.valid(),
            this.m_pipeline.m_causticsGraph.m_deferredCausticPhotonTask.valid(),
            causticPhotonMergedIntoCausticsPacket,
            this.m_pipeline.m_causticsGraph.m_deferredCausticGeometryTask.valid(),
            causticGeometryMergedIntoCausticsPacket,
            this.m_pipeline.m_causticsGraph.m_deferredCausticResolvePrepareTask.valid(),
            surfelCausticsMerge.causticResolvePrepareMergedIntoCausticsPacket,
            surfelCausticsMerge.causticResolveWaveletsMergedIntoCausticsPacket,
            this.m_pipeline.m_causticsGraph.m_deferredCausticResolveUpsampleTask.valid(),
            surfelCausticsMerge.causticResolveUpsampleMergedIntoCausticsPacket,
            surfelCausticsMerge.causticIrradianceClearMergedIntoCausticsPacket,
            surfelCausticsMerge.causticAccumulatorBootstrapClearMergedIntoCausticsPacket,
            surfelCausticsMerge.causticAccumulatorDecayMergedIntoCausticsPacket
        )
        || !this.m_pipeline.m_surfelGiGraph.m_deferredSurfelGiTask.valid()
        || !this.m_pipeline.m_surfelGiGraph.m_deferredSurfelGiIrradianceClearTask.valid()
        || !surfelGiOutputClearMergedIntoGiPacket
        || !surfelGiPreparedPrefixMergedIntoGiPacket
        || !surfelGiInitializationLifecycleMergedIntoPreparationPacket
        || !deferredCompiledPlan.findTask(this.m_pipeline.m_surfelGiGraph.m_deferredSurfelGiTask).valid()
        || !surfelGiQueue.has_value()
        || (this.m_pipeline.m_surfelGiGraph.m_deferredSurfelGiSnapshotCopyTask.valid() && (
            !this.m_pipeline.m_surfelGiGraph.m_deferredSurfelGiPreparationTask.valid()
            || !deferredCompiledPlan.findTask(this.m_pipeline.m_surfelGiGraph.m_deferredSurfelGiPreparationTask).valid()
            || !surfelGiPreparationQueue.has_value()
            || !deferredCompiledPlan.findTask(this.m_pipeline.m_surfelGiGraph.m_deferredSurfelGiSnapshotCopyTask).valid()
            || !surfelGiSnapshotCopyQueue.has_value()
            || !HasQueueCapabilityMask(cast<u8>(surfelGiSnapshotCopyQueue.value().capabilities), cast<u8>(GpuQueueCapability::Transfer))
        ))
        || (this.m_pipeline.m_surfelGiGraph.m_deferredSurfelGiCounterReadbackTask.valid() && (
            !deferredCompiledPlan.findTask(this.m_pipeline.m_surfelGiGraph.m_deferredSurfelGiCounterReadbackTask).valid()
            || !surfelGiCounterReadbackQueue.has_value()
            || !HasQueueCapabilityMask(cast<u8>(surfelGiCounterReadbackQueue.value().capabilities), cast<u8>(GpuQueueCapability::Transfer))
        ))
        || !surfelCounterReadbackFollowsPresentation
        || (hardwareShadowSupported && (
            !this.m_pipeline.m_causticsGraph.m_deferredHardwareCausticsTask.valid()
            || !deferredCompiledPlan.findTask(this.m_pipeline.m_causticsGraph.m_deferredHardwareCausticsTask).valid()
            || !hardwareCausticsQueue.has_value()
            || !HasQueueCapabilityMask(cast<u8>(hardwareCausticsQueue.value().capabilities), cast<u8>(GpuQueueCapability::Compute))
        ))
        || !avboitValidation.valid()
        || !this.m_pipeline.m_deferredLightingTask.valid()
        || !this.m_pipeline.m_deferredCompositeTask.valid()
        || !this.m_pipeline.m_deferredPresentTask.valid()
        || !this.m_pipeline.m_deferredFrameTimingEndTask.valid()
        || (this.m_pipeline.m_deferredPresentationOverlayRequired != this.m_pipeline.m_deferredPresentationOverlayTask.valid())
        || !this.m_pipeline.m_deferredFrameRecoveryTask.valid()
        || (this.m_pipeline.m_deferredSurfelGiCounterReadbackCompletion.valid() && !surfelCounterReadbackCompletionValid)
        || (captureLaggedLightingHistory && (
            !this.m_pipeline.m_deferredLaggedLightingHistoryTask.valid()
            || !deferredCompiledPlan.findTask(this.m_pipeline.m_deferredLaggedLightingHistoryTask).valid()
            || !deferredLaggedLightingHistoryQueue.has_value()
            || !HasQueueCapabilityMask(cast<u8>(deferredLaggedLightingHistoryQueue.value().capabilities), cast<u8>(GpuQueueCapability::Transfer))
        ))
        || !laggedLightingHistoryFollowsPresentation
        || (laggedAsyncLightingSchedule && !this.m_pipeline.m_deferredLightingHistoryReadReadyCompletion.valid())
        || (laggedLightingHistoryWriterWaitPending && !this.m_pipeline.m_deferredLightingHistoryWriterDrainCompletion.valid())
        || !deferredCompiledPlan.findTask(this.m_pipeline.m_deferredLightingTask).valid()
        || !laggedLightingHistorySlotsUploadMergedIntoLightingPacket
        || !deferredCompiledPlan.findTask(this.m_pipeline.m_deferredCompositeTask).valid()
        || !deferredCompiledPlan.findTask(this.m_pipeline.m_deferredPresentTask).valid()
        || !deferredCompiledPlan.findTask(this.m_pipeline.m_deferredFrameTimingEndTask).valid()
        || (this.m_pipeline.m_deferredPresentationOverlayRequired && !deferredCompiledPlan.findTask(this.m_pipeline.m_deferredPresentationOverlayTask).valid())
        || !presentationEndpoint.has_value()
        || !presentationEndpoint.value().valid()
        || presentationEndpoint.value().producer != this.m_pipeline.m_deferredFrameTimingEndTask
        || !deferredTaskGraphView.validResource(presentationEndpoint.value().backBuffer)
        || !deferredCompiledPlan.findTask(this.m_pipeline.m_deferredFrameRecoveryTask).valid()
        || !deferredLightingQueue.has_value()
        || !deferredCompositeQueue.has_value()
        || !deferredPresentQueue.has_value()
        || (this.m_pipeline.m_deferredPresentationOverlayRequired && !deferredPresentationOverlayQueue.has_value())
        || !terminalPresentationQueue.has_value()
        || !deferredFrameRecoveryQueue.has_value()
        || !primaryGraphicsQueue.valid()
        || presentationEndpoint.value().queue != primaryGraphicsQueue
        || deferredPresentQueue.value().id != primaryGraphicsQueue
        || (this.m_pipeline.m_deferredPresentationOverlayRequired && deferredPresentationOverlayQueue.value().id != primaryGraphicsQueue)
        || terminalPresentationQueue.value().id != primaryGraphicsQueue
        || (laggedAsyncLightingSchedule && !surfelGiSnapshotCopyAndTimingPacketsAreDistinct)
        || !HasQueueCapabilityMask(cast<u8>(deferredLightingQueue.value().capabilities), cast<u8>(GpuQueueCapability::Compute))
        || !HasQueueCapabilityMask(cast<u8>(deferredCompositeQueue.value().capabilities), cast<u8>(GpuQueueCapability::Compute))
        || deferredPresentQueue.value().queueClass != CommandQueue::Graphics
        || (this.m_pipeline.m_deferredPresentationOverlayRequired && deferredPresentationOverlayQueue.value().queueClass != CommandQueue::Graphics)
        || terminalPresentationQueue.value().queueClass != CommandQueue::Graphics
        || deferredFrameRecoveryQueue.value().queueClass != CommandQueue::Graphics
    ){
        DeferredFrameDiagnostics diagnostics;
        diagnostics.logRejectedDeferredGraphTopology(
            deferredCompiledPlan.packetForTask(this.m_pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityOpaqueTask).index,
            deferredCompiledPlan.packetForTask(this.m_pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityOpaqueFirstWaveletTask).index,
            deferredCompiledPlan.packetForTask(this.m_pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityOpaqueResolveTask).index,
            deferredCompiledPlan.packetForTask(this.m_pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityTransparentTraceTask).index,
            deferredCompiledPlan.packetForTask(this.m_pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityTransparentTemporalMergeTask).index,
            deferredCompiledPlan.packetForTask(this.m_pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityTransparentFirstWaveletTask).index,
            deferredCompiledPlan.packetForTask(this.m_pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityTask).index,
            shadowVisibilityPreparedTasksMerged,
            shadowVisibilityAllLitClearMerged,
            shadowVisibilityAdaptivePrimitivesMerged,
            surfelGiOutputClearMergedIntoGiPacket,
            surfelGiPreparedPrefixMergedIntoGiPacket,
            surfelGiInitializationLifecycleMergedIntoPreparationPacket,
            causticPhotonMergedIntoCausticsPacket,
            causticGeometryMergedIntoCausticsPacket,
            cast<u32>(deferredCompiledPlan.packetizationDecisionForTask(this.m_pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityOpaqueTask)),
            cast<u32>(deferredCompiledPlan.packetizationDecisionForTask(this.m_pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityTransparentTraceTask)),
            cast<u32>(deferredCompiledPlan.packetizationDecisionForTask(this.m_pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityTransparentTemporalMergeTask)),
            cast<u32>(deferredCompiledPlan.packetizationDecisionForTask(this.m_pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityTransparentFirstWaveletTask)),
            cast<u32>(deferredCompiledPlan.packetizationDecisionForTask(this.m_pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityTask)),
            cast<u32>(deferredCompiledPlan.packetizationDecisionForTask(this.m_pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityDiagnosticsTask)),
            deferredCompiledPlan.packetForTask(this.m_pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityDiagnosticsTask).index,
            this.m_pipeline.m_deferredLightingTaskGraphDeclared,
            deferredGraphScheduled
        );
        return false;
    }
    outResult.graphicsPrefixTimingTasks = graphicsPrefixTimingTasks;
    outResult.graphicsPrefixUniquePacketCount = graphicsPrefixUniquePacketCount;
    outResult.avboitValidation = avboitValidation;
    outResult.terminalPresentationTask = terminalPresentationTask;
    outResult.surfelGiCounterReadbackQueue = surfelGiCounterReadbackQueue;
    outResult.laggedLightingHistoryQueue = deferredLaggedLightingHistoryQueue;
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void GraphicsPrefixTimingResolver::resolve(
    in GpuCompiledGraphReadView compiledPlan,
    in Span<GraphicsPrefixTimingTicket> ownedTickets,
    mut Span<GraphicsPrefixTimingTicket> timingTickets,
    mut Span<GpuTaskId> timingTasks,
    mut b8 asyncSpansOnePacket,
    mut GraphicsPrefixTimingResolutionResult outResult
)const{
    in RendererFramePipeline pipeline = this.m_pipeline;
    outResult = GraphicsPrefixTimingResolutionResult();
    const Array<GpuTaskId, s_GraphicsPrefixTimingTaskCount> resolvedTasks(
        pipeline.m_graphicsPrefixGraph.m_graphicsPrefixMeshViewSetupTask,
        pipeline.m_graphicsPrefixGraph.m_graphicsPrefixSceneShadingSetupTask,
        pipeline.m_graphicsPrefixGraph.m_graphicsPrefixDeferredClearTask,
        pipeline.m_graphicsPrefixGraph.m_graphicsPrefixGbufferTask,
        GraphicsPrefixTaskOrFallback(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixCsgReceiverSpanTask, pipeline.m_graphicsPrefixGraph.m_graphicsPrefixGbufferTask),
        GraphicsPrefixTaskOrFallback(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixCsgIntervalCombineTask, pipeline.m_graphicsPrefixGraph.m_graphicsPrefixGbufferTask),
        GraphicsPrefixTaskOrFallback(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixCsgIntervalSampleTask, pipeline.m_graphicsPrefixGraph.m_graphicsPrefixGbufferTask),
        pipeline.m_graphicsPrefixGraph.m_graphicsPrefixTask
    );
    if(!IsValidGraphicsPrefixTimingSliceLengths(ownedTickets.size(), timingTickets.size(), timingTasks.size()))
        return;
    for(usize taskIndex = 0u; taskIndex < s_GraphicsPrefixTimingTaskCount; ++taskIndex)
        timingTasks[taskIndex] = resolvedTasks[taskIndex];
    for(usize prefixTaskIndex = 0u; prefixTaskIndex < s_GraphicsPrefixTimingTaskCount; ++prefixTaskIndex){
        const GpuTaskId task = timingTasks[prefixTaskIndex];
        if(!compiledPlan.findTask(task).valid() || (prefixTaskIndex != 0u && !compiledPlan.taskPrecedesOrSharesPacket(timingTasks[prefixTaskIndex - 1u], task))){
            outResult.bindingsValid = false;
            break;
        }
        b8 sharesPacketWithEarlierTask = false;
        for(usize earlierTaskIndex = 0u; earlierTaskIndex < prefixTaskIndex; ++earlierTaskIndex){
            if(!compiledPlan.tasksSharePacket(task, timingTasks[earlierTaskIndex]))
                continue;
            timingTickets[prefixTaskIndex] = timingTickets[earlierTaskIndex];
            sharesPacketWithEarlierTask = true;
            break;
        }
        if(!sharesPacketWithEarlierTask){
            timingTickets[prefixTaskIndex] = ownedTickets[prefixTaskIndex];
            ++outResult.uniquePacketCount;
        }
    }
    asyncSpansOnePacket = outResult.bindingsValid && compiledPlan.tasksSharePacket(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixMeshViewSetupTask, pipeline.m_graphicsPrefixGraph.m_graphicsPrefixTask);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 OpaqueEmulationMergeValidator::sharedPhasesMerge(in GpuCompiledGraphReadView compiledPlan, in Optional<GpuPhysicalQueueInfo> opaqueSharedComputeEmulationQueue)const{
    in RendererFramePipeline pipeline = this.m_pipeline;
    const usize phaseCount = pipeline.m_graphicsPrefixGraph.m_graphicsPrefixOpaqueSharedComputeEmulationTaskCount;
    if(phaseCount == 0u){
        for(in GpuTaskId task : pipeline.m_graphicsPrefixGraph.m_graphicsPrefixOpaqueSharedComputeEmulationTasks){
            if(task.valid())
                return false;
        }
        return true;
    }
    if(!IsSupportedSharedComputeEmulationPhaseCount(phaseCount))
        return false;
    if(
        !opaqueSharedComputeEmulationQueue.has_value()
        || opaqueSharedComputeEmulationQueue.value().queueClass != CommandQueue::Graphics
        || !compiledPlan.tasksSharePacket(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixGbufferTask, pipeline.m_graphicsPrefixGraph.m_graphicsPrefixOpaqueSharedComputeEmulationTasks[0u])
    )
        return false;
    for(usize phaseIndex = 0u; phaseIndex < phaseCount; ++phaseIndex){
        const GpuTaskId task = pipeline.m_graphicsPrefixGraph.m_graphicsPrefixOpaqueSharedComputeEmulationTasks[phaseIndex];
        const Optional<GpuPhysicalQueueInfo> queue = compiledPlan.findQueueInfoForTask(task);
        if(!task.valid() || !queue.has_value() || queue.value().queueClass != CommandQueue::Graphics || !compiledPlan.tasksSharePacket(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixGbufferTask, task))
            return false;
    }
    for(usize phaseIndex = phaseCount; phaseIndex < pipeline.m_graphicsPrefixGraph.m_graphicsPrefixOpaqueSharedComputeEmulationTasks.size(); ++phaseIndex){
        if(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixOpaqueSharedComputeEmulationTasks[phaseIndex].valid())
            return false;
    }
    return
        compiledPlan.tasksFormContiguousPacketSequence(Span<GpuTaskId>(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixOpaqueSharedComputeEmulationTasks).first(phaseCount))
        && compiledPlan.taskPrecedesInSamePacket(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixGbufferTask, pipeline.m_graphicsPrefixGraph.m_graphicsPrefixOpaqueSharedComputeEmulationTasks[0u])
    ;
}

b8 OpaqueEmulationMergeValidator::intervalSampleMerges(in GpuCompiledGraphReadView compiledPlan, in Optional<GpuPhysicalQueueInfo> opaqueCsgIntervalSampleComputeEmulationQueue)const{
    in RendererFramePipeline pipeline = this.m_pipeline;
    if(!pipeline.m_graphicsPrefixGraph.m_graphicsPrefixOpaqueCsgIntervalSampleComputeEmulationTask.valid())
        return true;
    if(
        !pipeline.m_graphicsPrefixGraph.m_graphicsPrefixCsgIntervalCombineTask.valid()
        || !pipeline.m_graphicsPrefixGraph.m_graphicsPrefixCsgIntervalSampleTask.valid()
        || !opaqueCsgIntervalSampleComputeEmulationQueue.has_value()
        || opaqueCsgIntervalSampleComputeEmulationQueue.value().queueClass != CommandQueue::Graphics
        || !compiledPlan.taskPrecedesOrSharesPacket(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixCsgIntervalCombineTask, pipeline.m_graphicsPrefixGraph.m_graphicsPrefixOpaqueCsgIntervalSampleComputeEmulationTask)
        || !compiledPlan.tasksSharePacket(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixOpaqueCsgIntervalSampleComputeEmulationTask, pipeline.m_graphicsPrefixGraph.m_graphicsPrefixCsgIntervalSampleTask)
    )
        return false;
    const Array<GpuTaskId, 2u> sequence(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixOpaqueCsgIntervalSampleComputeEmulationTask, pipeline.m_graphicsPrefixGraph.m_graphicsPrefixCsgIntervalSampleTask);
    return compiledPlan.tasksFormContiguousPacketSequence(Span<GpuTaskId>(sequence));
}

void OpaqueEmulationMergeValidator::validate(
    in GpuCompiledGraphReadView compiledPlan,
    in Span<GpuTaskId> timingTasks,
    in b8 timingBindingsValid,
    in b8 hasOpaqueCsgFrameWork,
    mut OpaqueEmulationMergeValidationResult outResult
)const{
    in RendererFramePipeline pipeline = this.m_pipeline;
    outResult = OpaqueEmulationMergeValidationResult();
    Optional<GpuPhysicalQueueInfo> opaqueComputeEmulationQueue;
    if(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixOpaqueComputeEmulationTask.valid())
        opaqueComputeEmulationQueue = compiledPlan.findQueueInfoForTask(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixOpaqueComputeEmulationTask);
    Optional<GpuPhysicalQueueInfo> opaqueSharedComputeEmulationQueue;
    if(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixOpaqueSharedComputeEmulationTaskCount != 0u
        && pipeline.m_graphicsPrefixGraph.m_graphicsPrefixOpaqueSharedComputeEmulationTasks[0u].valid())
        opaqueSharedComputeEmulationQueue = compiledPlan.findQueueInfoForTask(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixOpaqueSharedComputeEmulationTasks[0u]);
    Optional<GpuPhysicalQueueInfo> opaqueCsgReceiverComputeEmulationQueue;
    if(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixOpaqueCsgReceiverComputeEmulationTask.valid())
        opaqueCsgReceiverComputeEmulationQueue = compiledPlan.findQueueInfoForTask(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixOpaqueCsgReceiverComputeEmulationTask);
    Optional<GpuPhysicalQueueInfo> opaqueCsgIntervalSampleComputeEmulationQueue;
    if(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixOpaqueCsgIntervalSampleComputeEmulationTask.valid())
        opaqueCsgIntervalSampleComputeEmulationQueue = compiledPlan.findQueueInfoForTask(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixOpaqueCsgIntervalSampleComputeEmulationTask);
    outResult.packetsAreGraphics = timingBindingsValid;
    for(usize prefixTaskIndex = 0u; outResult.packetsAreGraphics && prefixTaskIndex < timingTasks.size(); ++prefixTaskIndex){
        const Optional<GpuPhysicalQueueInfo> queue = compiledPlan.findQueueInfoForTask(timingTasks[prefixTaskIndex]);
        outResult.packetsAreGraphics = queue.has_value() && queue.value().queueClass == CommandQueue::Graphics;
    }
    outResult.opaqueComputeEmulationMerged =
        !pipeline.m_graphicsPrefixGraph.m_graphicsPrefixOpaqueComputeEmulationTask.valid()
        || (
            compiledPlan.findTask(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixOpaqueComputeEmulationTask).valid()
            && compiledPlan.tasksSharePacket(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixOpaqueComputeEmulationTask, pipeline.m_graphicsPrefixGraph.m_graphicsPrefixGbufferTask)
            && opaqueComputeEmulationQueue.has_value()
            && opaqueComputeEmulationQueue.value().queueClass == CommandQueue::Graphics
        )
    ;
    outResult.opaqueSharedComputeEmulationMerged = this.sharedPhasesMerge(compiledPlan, opaqueSharedComputeEmulationQueue);
    outResult.opaqueCsgReceiverComputeEmulationMerged =
        !pipeline.m_graphicsPrefixGraph.m_graphicsPrefixOpaqueCsgReceiverComputeEmulationTask.valid()
        || (
            compiledPlan.findTask(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixOpaqueCsgReceiverComputeEmulationTask).valid()
            && compiledPlan.tasksSharePacket(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixOpaqueCsgReceiverComputeEmulationTask, pipeline.m_graphicsPrefixGraph.m_graphicsPrefixGbufferTask)
            && opaqueCsgReceiverComputeEmulationQueue.has_value()
            && opaqueCsgReceiverComputeEmulationQueue.value().queueClass == CommandQueue::Graphics
        )
    ;
    outResult.opaqueCsgIntervalSampleComputeEmulationMerged = this.intervalSampleMerges(compiledPlan, opaqueCsgIntervalSampleComputeEmulationQueue);
    Optional<GpuPhysicalQueueInfo> csgIntervalClearQueue;
    if(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixCsgIntervalClearTask.valid())
        csgIntervalClearQueue = compiledPlan.findQueueInfoForTask(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixCsgIntervalClearTask);
    if(!hasOpaqueCsgFrameWork)
        outResult.csgIntervalClearBundleMerged = (!pipeline.m_graphicsPrefixGraph.m_graphicsPrefixCsgIntervalClearFirstTask.valid() && !pipeline.m_graphicsPrefixGraph.m_graphicsPrefixCsgIntervalClearTask.valid());
    else
        outResult.csgIntervalClearBundleMerged = (
            pipeline.m_graphicsPrefixGraph.m_graphicsPrefixCsgIntervalClearFirstTask.valid()
            && pipeline.m_graphicsPrefixGraph.m_graphicsPrefixCsgIntervalClearTask.valid()
            && compiledPlan.findTask(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixCsgIntervalClearFirstTask).valid()
            && compiledPlan.findTask(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixCsgIntervalClearTask).valid()
            && compiledPlan.tasksSharePacket(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixCsgIntervalClearFirstTask, pipeline.m_graphicsPrefixGraph.m_graphicsPrefixCsgIntervalClearTask)
            && compiledPlan.tasksSharePacket(pipeline.m_graphicsPrefixGraph.m_graphicsPrefixCsgIntervalClearTask, pipeline.m_graphicsPrefixGraph.m_graphicsPrefixGbufferTask)
            && csgIntervalClearQueue.has_value()
            && csgIntervalClearQueue.value().queueClass == CommandQueue::Graphics
        )
    ;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void SurfelCausticsMergeValidator::validate(
    in GpuCompiledGraphReadView compiledPlan,
    in GpuTaskId causticsTask,
    in GpuTaskId terminalPresentationTask,
    in b8 captureLaggedLightingHistory,
    mut SurfelCausticsMergeValidationResult outResult
)const{
    in RendererFramePipeline pipeline = this.m_pipeline;
    outResult = SurfelCausticsMergeValidationResult();
    outResult.hardwareCausticsQueue = compiledPlan.findQueueInfoForTask(pipeline.m_causticsGraph.m_deferredHardwareCausticsTask);
    outResult.surfelGiQueue = compiledPlan.findQueueInfoForTask(pipeline.m_surfelGiGraph.m_deferredSurfelGiTask);
    outResult.surfelGiPreparationQueue = compiledPlan.findQueueInfoForTask(pipeline.m_surfelGiGraph.m_deferredSurfelGiPreparationTask);
    outResult.surfelGiSnapshotCopyQueue = compiledPlan.findQueueInfoForTask(pipeline.m_surfelGiGraph.m_deferredSurfelGiSnapshotCopyTask);
    outResult.surfelGiCounterReadbackQueue = compiledPlan.findQueueInfoForTask(pipeline.m_surfelGiGraph.m_deferredSurfelGiCounterReadbackTask);
    outResult.surfelGiOutputClearMergedIntoGiPacket = pipeline.m_surfelGiGraph.m_deferredSurfelGiIrradianceClearTask.valid() && compiledPlan.tasksSharePacket(pipeline.m_surfelGiGraph.m_deferredSurfelGiIrradianceClearTask, pipeline.m_surfelGiGraph.m_deferredSurfelGiTask);
    const b8 ageFreeValid = pipeline.m_surfelGiGraph.m_deferredSurfelGiAgeFreeTask.valid();
    const b8 cellHeadClearValid = pipeline.m_surfelGiGraph.m_deferredSurfelGiCellHeadClearTask.valid();
    const b8 hashBuildValid = pipeline.m_surfelGiGraph.m_deferredSurfelGiHashBuildTask.valid();
    const b8 spawnValid = pipeline.m_surfelGiGraph.m_deferredSurfelGiSpawnTask.valid();
    const b8 traceBuildArgsValid = pipeline.m_surfelGiGraph.m_deferredSurfelGiTraceBuildArgsTask.valid();
    const b8 traceValid = pipeline.m_surfelGiGraph.m_deferredSurfelGiTraceTask.valid();
    const b8 resolveValid = pipeline.m_surfelGiGraph.m_deferredSurfelGiResolveTask.valid();
    outResult.surfelGiPreparedPrefixMergedIntoGiPacket =
        AreAllSurfelGiPreparedPrefixTasksAbsent(ageFreeValid, cellHeadClearValid, hashBuildValid, spawnValid, traceBuildArgsValid, traceValid, resolveValid)
        || (
            AreAllSurfelGiPreparedPrefixTasksPresent(ageFreeValid, cellHeadClearValid, hashBuildValid, spawnValid, traceBuildArgsValid, traceValid, resolveValid)
            && compiledPlan.tasksSharePacket(pipeline.m_surfelGiGraph.m_deferredSurfelGiAgeFreeTask, pipeline.m_surfelGiGraph.m_deferredSurfelGiTask)
            && compiledPlan.tasksSharePacket(pipeline.m_surfelGiGraph.m_deferredSurfelGiCellHeadClearTask, pipeline.m_surfelGiGraph.m_deferredSurfelGiTask)
            && compiledPlan.tasksSharePacket(pipeline.m_surfelGiGraph.m_deferredSurfelGiHashBuildTask, pipeline.m_surfelGiGraph.m_deferredSurfelGiTask)
            && compiledPlan.tasksSharePacket(pipeline.m_surfelGiGraph.m_deferredSurfelGiSpawnTask, pipeline.m_surfelGiGraph.m_deferredSurfelGiTask)
            && compiledPlan.tasksSharePacket(pipeline.m_surfelGiGraph.m_deferredSurfelGiTraceBuildArgsTask, pipeline.m_surfelGiGraph.m_deferredSurfelGiTask)
            && compiledPlan.tasksSharePacket(pipeline.m_surfelGiGraph.m_deferredSurfelGiTraceTask, pipeline.m_surfelGiGraph.m_deferredSurfelGiTask)
            && compiledPlan.tasksSharePacket(pipeline.m_surfelGiGraph.m_deferredSurfelGiResolveTask, pipeline.m_surfelGiGraph.m_deferredSurfelGiTask)
        )
    ;
    outResult.surfelGiInitializationLifecycleMergedIntoPreparationPacket =
        !pipeline.m_surfelGiGraph.m_deferredSurfelGiInitializationLifecycleTask.valid()
        || (pipeline.m_surfelGiGraph.m_deferredSurfelGiPreparationTask.valid() && compiledPlan.tasksSharePacket(pipeline.m_surfelGiGraph.m_deferredSurfelGiPreparationTask, pipeline.m_surfelGiGraph.m_deferredSurfelGiInitializationLifecycleTask))
    ;
    outResult.causticPhotonMergedIntoCausticsPacket = pipeline.m_causticsGraph.m_deferredCausticPhotonTask.valid() && compiledPlan.tasksSharePacket(pipeline.m_causticsGraph.m_deferredCausticPhotonTask, causticsTask);
    outResult.causticGeometryMergedIntoCausticsPacket = pipeline.m_causticsGraph.m_deferredCausticGeometryTask.valid() && compiledPlan.tasksSharePacket(pipeline.m_causticsGraph.m_deferredCausticGeometryTask, causticsTask);
    outResult.causticResolvePrepareMergedIntoCausticsPacket = pipeline.m_causticsGraph.m_deferredCausticResolvePrepareTask.valid() && compiledPlan.tasksSharePacket(pipeline.m_causticsGraph.m_deferredCausticResolvePrepareTask, causticsTask);
    outResult.causticResolveWaveletsMergedIntoCausticsPacket = true;
    for(in GpuTaskId waveletTask : pipeline.m_causticsGraph.m_deferredCausticResolveWaveletTasks){
        if(!waveletTask.valid() || !compiledPlan.tasksSharePacket(waveletTask, causticsTask)){
            outResult.causticResolveWaveletsMergedIntoCausticsPacket = false;
            break;
        }
    }
    outResult.causticResolveUpsampleMergedIntoCausticsPacket = pipeline.m_causticsGraph.m_deferredCausticResolveUpsampleTask.valid() && compiledPlan.tasksSharePacket(pipeline.m_causticsGraph.m_deferredCausticResolveUpsampleTask, causticsTask);
    outResult.causticIrradianceClearMergedIntoCausticsPacket = pipeline.m_causticsGraph.m_deferredCausticIrradianceClearTask.valid() && compiledPlan.tasksSharePacket(pipeline.m_causticsGraph.m_deferredCausticIrradianceClearTask, causticsTask);
    outResult.causticAccumulatorBootstrapClearMergedIntoCausticsPacket = !pipeline.m_causticsGraph.m_deferredCausticAccumulatorBootstrapClearTask.valid() || compiledPlan.tasksSharePacket(pipeline.m_causticsGraph.m_deferredCausticAccumulatorBootstrapClearTask, causticsTask);
    outResult.causticAccumulatorDecayMergedIntoCausticsPacket = !pipeline.m_causticsGraph.m_deferredCausticAccumulatorDecayTask.valid() || compiledPlan.tasksSharePacket(pipeline.m_causticsGraph.m_deferredCausticAccumulatorDecayTask, causticsTask);
    outResult.surfelGiSnapshotCopyAndTimingPacketsAreDistinct = !pipeline.m_surfelGiGraph.m_deferredSurfelGiSnapshotCopyTask.valid() || !compiledPlan.tasksSharePacket(pipeline.m_surfelGiGraph.m_deferredSurfelGiSnapshotCopyTask, pipeline.m_surfelGiGraph.m_deferredSurfelGiTask);
    outResult.surfelCounterReadbackFollowsPresentation = !pipeline.m_surfelGiGraph.m_deferredSurfelGiCounterReadbackTask.valid()
        || (compiledPlan.taskPrecedesOrSharesPacket(terminalPresentationTask, pipeline.m_surfelGiGraph.m_deferredSurfelGiCounterReadbackTask) && !compiledPlan.tasksSharePacket(terminalPresentationTask, pipeline.m_surfelGiGraph.m_deferredSurfelGiCounterReadbackTask))
    ;
    outResult.laggedLightingHistoryFollowsPresentation = !captureLaggedLightingHistory
        || (compiledPlan.taskPrecedesOrSharesPacket(terminalPresentationTask, pipeline.m_deferredLaggedLightingHistoryTask) && !compiledPlan.tasksSharePacket(terminalPresentationTask, pipeline.m_deferredLaggedLightingHistoryTask))
    ;
}


