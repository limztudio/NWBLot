// Every nested state is a member and remains lent through the outermost endPopup.
class UiNestedPopupSmokeScene{
    private UiNestedPopupSmokeSource m_source;
    private PopupState m_parent = PopupState();
    private PopupState m_child = PopupState();
    private ListState m_beforeList = ListState();
    private ListState m_afterList = ListState();
    private ComboState m_combo = ComboState();
    private SearchComboState m_search;
    private ContextMenuState m_menu = ContextMenuState();
    private EditModel m_beforeText;
    private EditModel m_afterText;
    private EditModel m_childText;
    private EditBoxState m_beforeEdit = EditBoxState();
    private EditBoxState m_afterEdit = EditBoxState();
    private EditBoxState m_childEdit = EditBoxState();
    private DisplayMetrics m_lastDisplay = DisplayMetrics();
    private Array<Rect, 26u> m_rectangles;
    private Array<Rect, 26u> m_lastRectangles;
    private Array<u64, 29u> m_lastValues;
    private u64 m_command = 0u;
    private u32 m_sequence = 0u;
    private u32 m_beforeClicks = 0u;
    private u32 m_afterClicks = 0u;
    private u32 m_childClicks = 0u;
    private u32 m_outside = 0u;
    private u32 m_focusScope = 0u;
    private u32 m_focusCode = 0u;
    private u32 m_popupTargets = 0u;
    private u32 m_popupCount = 0u;
    private b8 m_childParentScope = false;
    private b8 m_childDeclared = false;
    private b8 m_displayChanged = false;

    public UiNestedPopupSmokeScene(mut GlobalArena arena);

    public b8 paint(mut UiPaintContext context);
    public b8 keyboardUpdate(in i32 key, in i32 scancode, in i32 action, in i32 mods);

    private b8 paintRoot(mut Builder ui);
    private b8 paintParent(mut Builder ui);
    private b8 paintChild(mut Builder ui);
    private void observeState(mut UiPaintContext context);
    private void paintMarkers(mut UiPaintContext context)const;
    private Array<u64, 29u> values()const;
    private Rect rowBounds(in ListState state, in IListDataSource source, in u64 key)const;
}


