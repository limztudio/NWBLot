void GpuPacketExpectMissingTask(
    in GpuTaskGraphQueueAssignments assignments,
    in GpuCompiledGraphReadView compiledPlan,
    in GpuTaskId task
){
    EXPECT_FALSE(HasQueueAssignment(assignments, task));
    EXPECT_FALSE(HasTaskPlan(compiledPlan.findTask(task)));
    EXPECT_FALSE(compiledPlan.packetForTask(task).valid());
    EXPECT_EQ(compiledPlan.packetizationDecisionForTask(task), GpuTaskPacketizationDecision::Unknown);
}

GpuTaskSchedulingHint GpuPacketPreludeScheduling(){
    GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
    scheduling.cost = GpuTaskCostHint::Tiny;
    scheduling.forceSubmissionBoundary = true;
    scheduling.allowPacketMerge = false;
    return scheduling;
}

GpuTaskCommandRequirements GpuPacketPrimaryGraphicsRequirements(){
    GpuTaskCommandRequirements commands = GpuTaskCommandRequirements();
    commands.requiredCapabilities = GpuQueueCapability::Graphics;
    commands.requiresPrimaryGraphicsQueue = true;
    return commands;
}

Expected<GpuTaskId> GpuPacketAddPrelude(mut GpuTaskGraph graph){
    GpuTaskTimingMetadata timing = GpuTaskTimingMetadata();
    timing.policy = GpuTaskTimingPolicy::PacketOnly;
    return AddTaskWithCommands(
        s_GpuCaseTaskGraphPrelude,
        "Normal Execution Prelude",
        GpuPacketPrimaryGraphicsRequirements(),
        GpuPacketPreludeScheduling(),
        timing,
        Span<GpuTaskId>(),
        graph
    );
}

b8 GpuPacketHasPacketDependency(in GpuCompiledPacketView consumer, in GpuSubmissionPacketId producer){
    if(!consumer.valid())
        return false;
    const Span<GpuPacketDependency> deps = PacketDependencies(consumer);
    for(usize index = 0u; index < deps.size(); ++index){
        if(deps[index].producer == producer)
            return true;
    }
    return false;
}

void VerifyGpuPacket_ClampsReadyFrontierWorkerUtilization(){
    GpuTaskGraphRecordingStatistics statistics = GpuTaskGraphRecordingStatistics();
    EXPECT_EQ(statistics.readyFrontierWorkerUtilization(), 0.0);

    statistics.readyFrontierWorkerCapacitySeconds = 1.0;

    statistics.readyFrontierWorkerBusySeconds = 2.0;
    EXPECT_EQ(statistics.readyFrontierWorkerUtilization(), 1.0);

    statistics.readyFrontierWorkerBusySeconds = -1.0;
    EXPECT_EQ(statistics.readyFrontierWorkerUtilization(), 0.0);
}

void VerifyGpuPacket_RecreatesPacketRecordingStateAfterRecompile(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    Array<GpuPhysicalQueueInfo, 1> queues = Array<GpuPhysicalQueueInfo, 1>();
    queues[0u] = GraphicsQueue();
    const GpuPhysicalQueueTopology topology = MakeTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);

    const Expected<GpuTaskId> firstTaskResult = AddTask(
        s_GpuCaseTaskGraphRecreateRecordingFirst,
        "Recreate Recording First",
        Span<GpuTaskId>(),
        Span<GpuTaskResourceUse>(),
        Span<GpuTaskResourceSetUse>(),
        Span<GpuTaskResourceVersionUse>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(firstTaskResult.has_value());
    const GpuTaskId firstTask = firstTaskResult.value();
    ASSERT_TRUE(firstTask.valid());
    ASSERT_TRUE(Compile(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    GpuSubmissionPacketId firstPacket = GpuSubmissionPacketId();
    GpuPhysicalQueueId firstQueue = GpuPhysicalQueueId();
    u64 firstCompiledGeneration = 0u;
    {
        const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

        firstPacket = compiledPlan.packetForTask(firstTask);
        ASSERT_TRUE(firstPacket.valid());
        const Optional<GpuSubmissionPacket> firstPacketPlan = PacketPlan(compiledPlan.packet(firstPacket));
        ASSERT_TRUE(firstPacketPlan.has_value());
        firstQueue = firstPacketPlan.value().queue;
        ASSERT_TRUE(firstQueue.valid());
        firstCompiledGeneration = compiledPlan.generation();
    }

    GpuRecordedGraph recordedGraph = GpuRecordedGraph(testArena.arena);
    GpuGraphSubmissionTransaction transaction = GpuGraphSubmissionTransaction(testArena.arena);
    recordedGraph.reset(compiledGraph);
    transaction.reset(compiledGraph);
    {
        const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

        ASSERT_TRUE(recordedGraph.validFor(compiledGraph, compiledPlan));
        ASSERT_TRUE(transaction.validFor(compiledPlan));
        const GpuTaskGraphPhysicalQueueRecordingStatistics firstQueueStatistics = recordedGraph.physicalQueueRecordingStatistics(compiledGraph, compiledPlan, firstQueue);
        ASSERT_TRUE(firstQueueStatistics.valid());
        GpuPhysicalQueueId staleFirstQueue = GpuPhysicalQueueId();
        staleFirstQueue.index = firstQueue.index;
        if(firstQueue.deviceGeneration == u16.max)
            staleFirstQueue.deviceGeneration = 1u;
        else
            staleFirstQueue.deviceGeneration = cast<u16>(firstQueue.deviceGeneration + 1u);
        EXPECT_FALSE(recordedGraph.physicalQueueRecordingStatistics(compiledGraph, compiledPlan, staleFirstQueue).valid());
        // A current-generation ID is still invalid when the compiled plan has no matching physical topology entry.
        GpuPhysicalQueueId nonPlanQueue = GpuPhysicalQueueId();
        nonPlanQueue.index = 3u;
        nonPlanQueue.deviceGeneration = compiledPlan.deviceGeneration();
        EXPECT_TRUE(nonPlanQueue.valid());
        EXPECT_FALSE(recordedGraph.physicalQueueRecordingStatistics(compiledGraph, compiledPlan, nonPlanQueue).valid());
    }

    graph.reset();
    const Expected<GpuTaskId> secondTaskResult = AddTask(
        s_GpuCaseTaskGraphRecreateRecordingSecond,
        "Recreate Recording Second",
        Span<GpuTaskId>(),
        Span<GpuTaskResourceUse>(),
        Span<GpuTaskResourceSetUse>(),
        Span<GpuTaskResourceVersionUse>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(secondTaskResult.has_value());
    const GpuTaskId secondTask = secondTaskResult.value();
    ASSERT_TRUE(secondTask.valid());
    ASSERT_TRUE(Compile(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    GpuSubmissionPacketId secondPacket = GpuSubmissionPacketId();
    GpuPhysicalQueueId secondQueue = GpuPhysicalQueueId();
    {
        const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

        ASSERT_NE(compiledPlan.generation(), firstCompiledGeneration);
        secondPacket = compiledPlan.packetForTask(secondTask);
        ASSERT_TRUE(secondPacket.valid());
        const Optional<GpuSubmissionPacket> secondPacketPlan = PacketPlan(compiledPlan.packet(secondPacket));
        ASSERT_TRUE(secondPacketPlan.has_value());
        secondQueue = secondPacketPlan.value().queue;
        ASSERT_TRUE(secondQueue.valid());
        EXPECT_FALSE(recordedGraph.validFor(compiledGraph, compiledPlan));
        EXPECT_FALSE(transaction.validFor(compiledPlan));
        EXPECT_FALSE(recordedGraph.physicalQueueRecordingStatistics(compiledGraph, compiledPlan, secondQueue).valid());
    }

    // Reset releases old command lists and rebuilds packet scratch for the new graph.
    recordedGraph.reset(compiledGraph);
    transaction.reset(compiledGraph);
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

    EXPECT_TRUE(recordedGraph.validFor(compiledGraph, compiledPlan));
    EXPECT_TRUE(transaction.validFor(compiledPlan));
    const GpuTaskGraphPhysicalQueueRecordingStatistics secondQueueStatistics = recordedGraph.physicalQueueRecordingStatistics(compiledGraph, compiledPlan, secondQueue);
    ASSERT_TRUE(secondQueueStatistics.valid());
}

void VerifyGpuPacket_InvalidatesPacketRuntimeAndCaptureForSameGraphRecompile(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const GpuTaskCommandRequirements computeCommands = ComputeCommands();
    const Expected<GpuTaskId> taskResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphSameGraphRecompile,
        "Same Graph Recompile",
        computeCommands,
        GpuTaskSchedulingHint(),
        GpuTaskTimingMetadata(),
        Span<GpuTaskId>(),
        graph
    );
    ASSERT_TRUE(taskResult.has_value());
    const GpuTaskId task = taskResult.value();
    ASSERT_TRUE(task.valid());

    Array<GpuPhysicalQueueInfo, 1> graphicsOnly = Array<GpuPhysicalQueueInfo, 1>();
    graphicsOnly[0u] = GraphicsQueue();
    const GpuPhysicalQueueTopology firstTopology = MakeTopology(graphicsOnly);
    Array<GpuPhysicalQueueInfo, 2> graphicsAndCompute = Array<GpuPhysicalQueueInfo, 2>();
    graphicsAndCompute[0u] = GraphicsQueue();
    graphicsAndCompute[1u] = DedicatedComputeQueue();
    const GpuPhysicalQueueTopology secondTopology = MakeTopology(graphicsAndCompute);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(Compile(analysis, assignments, compiledGraph, operationScratchArena, graph, firstTopology));
    u64 graphGeneration = 0u;
    u64 firstPlanGeneration = 0u;
    GpuSubmissionPacketId firstPacket = GpuSubmissionPacketId();
    GpuPhysicalQueueId firstQueue = GpuPhysicalQueueId();
    {
        const GpuTaskGraphReadViews reads = GpuTaskGraphReadViews(graph, compiledGraph);

        ASSERT_TRUE(reads.valid());
        ASSERT_EQ(reads.compiled.packetCount(), 1u);
        graphGeneration = reads.declarations.generation();
        firstPlanGeneration = reads.compiled.planGeneration();
        firstPacket = reads.compiled.packetForTask(task);
        ASSERT_TRUE(firstPacket.valid());
        EXPECT_EQ(firstPacket.generation, firstPlanGeneration);
        const Optional<GpuSubmissionPacket> firstPacketPlan = PacketPlan(reads.compiled.packet(firstPacket));
        ASSERT_TRUE(firstPacketPlan.has_value());
        firstQueue = firstPacketPlan.value().queue;
        ASSERT_TRUE(firstQueue.valid());
    }

    GpuRecordedGraph recordedGraph = GpuRecordedGraph(testArena.arena);
    GpuGraphSubmissionTransaction transaction = GpuGraphSubmissionTransaction(testArena.arena);
    recordedGraph.reset(compiledGraph);
    transaction.reset(compiledGraph);
    {
        const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

        ASSERT_TRUE(recordedGraph.validFor(compiledGraph, compiledPlan));
        ASSERT_TRUE(transaction.validFor(compiledPlan));
    }

    GpuCommandIrCapture capture = GpuCommandIrCapture(testArena.arena);
    GpuGraphResourceId targetBuffer = GpuGraphResourceId();
    targetBuffer.generation = graphGeneration;
    targetBuffer.index = 0u;
    ASSERT_TRUE(capture.captureClearBuffer(task, firstPacket, firstQueue, targetBuffer, 0xdecafbadu));
    ASSERT_EQ(capture.planGeneration(), firstPlanGeneration);

    ASSERT_TRUE(Compile(analysis, assignments, compiledGraph, operationScratchArena, graph, secondTopology));
    const GpuTaskGraphReadViews reads = GpuTaskGraphReadViews(graph, compiledGraph);

    ASSERT_TRUE(reads.valid());
    ASSERT_EQ(reads.compiled.generation(), graphGeneration);
    ASSERT_EQ(reads.compiled.packetCount(), 1u);
    const GpuSubmissionPacketId secondPacket = reads.compiled.packetForTask(task);
    ASSERT_TRUE(secondPacket.valid());
    EXPECT_NE(reads.compiled.planGeneration(), firstPlanGeneration);
    EXPECT_NE(secondPacket, firstPacket);
    EXPECT_FALSE(reads.compiled.validPacket(firstPacket));
    EXPECT_FALSE(recordedGraph.validFor(compiledGraph, reads.compiled));
    EXPECT_FALSE(transaction.validFor(reads.compiled));

    const GpuCommandIrReplayResult staleCapture = PreflightGpuCommandIrPacket(capture.commandBytes(), reads.declarations, reads.compiled, secondPacket);
    EXPECT_EQ(staleCapture.error, GpuCommandIrReplayError::PlanGenerationMismatch);
    EXPECT_TRUE(staleCapture.streamValidation.valid());
}

void VerifyGpuPacket_CompiledTaskLookupRejectsOutOfRangeStaleAndUncompiledHandles(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuTaskId> firstResult = AddTask(
        s_GpuCaseTaskGraphCompiledLookupFirst,
        "Compiled Lookup First",
        Span<GpuTaskId>(),
        Span<GpuTaskResourceUse>(),
        Span<GpuTaskResourceSetUse>(),
        Span<GpuTaskResourceVersionUse>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(firstResult.has_value());
    const GpuTaskId first = firstResult.value();
    ASSERT_TRUE(first.valid());

    Array<GpuPhysicalQueueInfo, 1> queues = Array<GpuPhysicalQueueInfo, 1>();
    queues[0u] = GraphicsQueue();
    const GpuPhysicalQueueTopology topology = MakeTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(Compile(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    usize graphTaskCount = 0u;
    u64 graphGeneration = 0u;
    {
        const GpuTaskGraphReadViews reads = GpuTaskGraphReadViews(graph, compiledGraph);

        ASSERT_TRUE(reads.valid());
        ASSERT_TRUE(HasTaskPlan(reads.compiled.findTask(first)));
        graphTaskCount = reads.declarations.taskCount();
        graphGeneration = reads.declarations.generation();
    }

    GpuTaskId onePastCompiledTasks = GpuTaskId();
    onePastCompiledTasks.generation = graphGeneration;
    onePastCompiledTasks.index = cast<u32>(graphTaskCount);
    GpuTaskId largeSameGenerationTask = GpuTaskId();
    largeSameGenerationTask.generation = graphGeneration;
    largeSameGenerationTask.index = cast<u32>(u32.max - 1u);
    ASSERT_TRUE(onePastCompiledTasks.valid());
    ASSERT_TRUE(largeSameGenerationTask.valid());
    {
        const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

        GpuPacketExpectMissingTask(assignments, compiledPlan, onePastCompiledTasks);
        GpuPacketExpectMissingTask(assignments, compiledPlan, largeSameGenerationTask);
    }

    GpuTaskGraph foreignGraph = GpuTaskGraph(testArena.arena);
    const Expected<GpuTaskId> foreignResult = AddTask(
        s_GpuCaseTaskGraphCompiledLookupForeign,
        "Compiled Lookup Foreign",
        Span<GpuTaskId>(),
        Span<GpuTaskResourceUse>(),
        Span<GpuTaskResourceSetUse>(),
        Span<GpuTaskResourceVersionUse>(),
        Span<GpuExternalCompletionId>(),
        foreignGraph
    );
    ASSERT_TRUE(foreignResult.has_value());
    const GpuTaskId foreign = foreignResult.value();
    ASSERT_TRUE(foreign.valid());
    ASSERT_NE(foreign.generation, graphGeneration);
    {
        const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

        GpuPacketExpectMissingTask(assignments, compiledPlan, foreign);
    }

    const Expected<GpuTaskId> appendedResult = AddTask(
        s_GpuCaseTaskGraphCompiledLookupAppended,
        "Compiled Lookup Appended",
        Span<GpuTaskId>(),
        Span<GpuTaskResourceUse>(),
        Span<GpuTaskResourceSetUse>(),
        Span<GpuTaskResourceVersionUse>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(appendedResult.has_value());
    const GpuTaskId appended = appendedResult.value();
    ASSERT_TRUE(appended.valid());
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

        EXPECT_FALSE(compiledPlan.validFor(declarations));
        GpuPacketExpectMissingTask(assignments, compiledPlan, appended);
    }

    ASSERT_TRUE(Compile(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    {
        const GpuTaskGraphReadViews reads = GpuTaskGraphReadViews(graph, compiledGraph);

        ASSERT_TRUE(reads.valid());
        ASSERT_TRUE(HasQueueAssignment(assignments, first));
        ASSERT_TRUE(HasQueueAssignment(assignments, appended));
        ASSERT_TRUE(HasTaskPlan(reads.compiled.findTask(first)));
        ASSERT_TRUE(HasTaskPlan(reads.compiled.findTask(appended)));
    }

    graph.reset();
    const Expected<GpuTaskId> replacementResult = AddTask(
        s_GpuCaseTaskGraphCompiledLookupReplacement,
        "Compiled Lookup Replacement",
        Span<GpuTaskId>(),
        Span<GpuTaskResourceUse>(),
        Span<GpuTaskResourceSetUse>(),
        Span<GpuTaskResourceVersionUse>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(replacementResult.has_value());
    const GpuTaskId replacement = replacementResult.value();
    ASSERT_TRUE(replacement.valid());
    ASSERT_NE(replacement.generation, first.generation);
    ASSERT_TRUE(Compile(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    {
        const GpuTaskGraphReadViews reads = GpuTaskGraphReadViews(graph, compiledGraph);

        ASSERT_TRUE(reads.valid());
        GpuPacketExpectMissingTask(assignments, reads.compiled, first);
        GpuPacketExpectMissingTask(assignments, reads.compiled, appended);
        ASSERT_TRUE(HasQueueAssignment(assignments, replacement));
        ASSERT_TRUE(HasTaskPlan(reads.compiled.findTask(replacement)));
        EXPECT_TRUE(reads.compiled.packetForTask(replacement).valid());
    }
}

void VerifyGpuPacket_RejectsRecoverySubmissionWithoutAcceptedQueueFrontierRole(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuTaskSchedulingHint recoveryScheduling = GpuTaskSchedulingHint();
    recoveryScheduling.forceSubmissionBoundary = true;
    recoveryScheduling.allowPacketMerge = false;
    recoveryScheduling.isRecoverySubmission = true;
    GpuTaskDesc recoveryDesc = GpuTaskDesc();
    recoveryDesc.setIdentity(s_GpuCaseTaskGraphRecoveryWithoutFrontier);
    recoveryDesc.setMarkerLabel("Recovery Without Frontier");
    recoveryDesc.setScheduling(recoveryScheduling);
    const Expected<GpuTaskId> recoveryResult = graph.addTask(recoveryDesc);
    ASSERT_TRUE(recoveryResult.has_value());
    const GpuTaskId recovery = recoveryResult.value();
    ASSERT_TRUE(recovery.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    EXPECT_FALSE(Analyze(graph, operationScratchArena, analysis));
    EXPECT_FALSE(analysis.valid());
