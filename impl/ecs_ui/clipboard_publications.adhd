////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "clipboard_types.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class UiClipboardPublicationRecord{
    public ClipboardRequestToken token;
    public ClipboardChannel channel = ClipboardChannel::Clipboard;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


UiClipboardPublicationStatus MapUiClipboardPublicationStatus(in ClipboardStatus status){
    switch(status){
    case ClipboardStatus::Success: return UiClipboardPublicationStatus::Published;
    case ClipboardStatus::Unsupported: return UiClipboardPublicationStatus::Unsupported;
    case ClipboardStatus::InvalidText: return UiClipboardPublicationStatus::InvalidText;
    case ClipboardStatus::TooLarge: return UiClipboardPublicationStatus::TooLarge;
    default: return UiClipboardPublicationStatus::NativeFailure;
    }
}

UiClipboardPublicationStatus ResolveUiClipboardAdmissionFailure(in b8 wrongThread){
    if(wrongThread)
        return UiClipboardPublicationStatus::WrongThread;
    return UiClipboardPublicationStatus::QueueFull;
}

void RecordUiClipboardDrainOutcome(in UiClipboardPublicationStatus status, mut UiClipboardPublicationResult inOutResult){
    if(status == UiClipboardPublicationStatus::Published)
        ++inOutResult.published;
    else{
        ++inOutResult.failed;
        inOutResult.status = status;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Copies are immutable native publications.
// Their owned OS requests survive later edits, focus and widget removal.
// Drain on the OS thread; destruction cancels remaining requests.
// Service and arena outlive this bounded owner.
[modular]
class UiClipboardPublications : NoCopy{
    private mut IClipboardService m_service;
    private ClipboardCompletion m_completion;
    private Vector<UiClipboardPublicationRecord> m_requests;

    public UiClipboardPublications(mut IClipboardService service);

    public ~UiClipboardPublications(){
        if(!this.cancel())
            TerminateInvariant();
    }

    public UiClipboardPublicationStatus request(in StringView text, in ClipboardChannel channel){
        if(!this.m_service.isOwnerThread())
            return UiClipboardPublicationStatus::WrongThread;
        if(cast<u8>(channel) > cast<u8>(ClipboardChannel::PrimarySelection) || !this.m_service.capabilities(channel).writeText)
            return UiClipboardPublicationStatus::Unsupported;
        const ClipboardStatus validation = ValidateClipboardUtf8Text(text);
        if(validation != ClipboardStatus::Success)
            return MapUiClipboardPublicationStatus(validation);
        if(this.m_requests.size() == s_UiClipboardMaxPublications)
            return UiClipboardPublicationStatus::QueueFull;
        const Expected<ClipboardRequestToken, ClipboardAdmission> result = this.m_service.requestWriteText(channel, text);
        if(!result.has_value())
            return ResolveUiClipboardAdmissionFailure(result.error() == ClipboardAdmission::WrongThread);
        if(!result.value().valid())
            return UiClipboardPublicationStatus::NativeFailure;
        UiClipboardPublicationRecord record;
        record.token = result.value();
        record.channel = channel;
        this.m_requests.push_back(record);
        return UiClipboardPublicationStatus::Pending;
    }

    public UiClipboardPublicationStatus request(in StringView text){
        return this.request(text, ClipboardChannel::Clipboard);
    }

    public UiClipboardPublicationResult drain(){
        UiClipboardPublicationResult result;
        if(!this.m_service.isOwnerThread()){
            result.status = UiClipboardPublicationStatus::WrongThread;
            return result;
        }
        usize index = 0u;
        while(index < this.m_requests.size()){
            const UiClipboardPublicationRecord publication = this.m_requests[index];
            const ClipboardPollResult poll = this.m_service.poll(publication.token, this.m_completion);
            if(poll == ClipboardPollResult::Pending){
                ++index;
                continue;
            }
            if(poll == ClipboardPollResult::WrongThread){
                result.status = UiClipboardPublicationStatus::WrongThread;
                return result;
            }
            UiClipboardPublicationStatus status = UiClipboardPublicationStatus::NativeFailure;
            if(poll == ClipboardPollResult::Completed && this.m_completion.token == publication.token && this.m_completion.operation == ClipboardOperation::WriteText && this.m_completion.channel == publication.channel)
                status = MapUiClipboardPublicationStatus(this.m_completion.status);
            RecordUiClipboardDrainOutcome(status, result);
            this.m_requests.erase(this.m_requests.begin() + cast<isize>(index));
        }
        FinalizeUiClipboardPublicationDrainStatus(this.m_requests.size(), result);
        return result;
    }

    public b8 cancel(){
        if(this.m_requests.empty())
            return true;
        if(!this.m_service.isOwnerThread())
            return false;
        b8 cancelled = true;
        for(in UiClipboardPublicationRecord publication : this.m_requests){
            if(!this.m_service.cancel(publication.token) && this.m_service.poll(publication.token, this.m_completion) != ClipboardPollResult::InvalidRequest)
                cancelled = false;
        }
        if(cancelled)
            this.m_requests.clear();
        return cancelled;
    }

    public usize pending()const{
        return this.m_requests.size();
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


UiClipboardPublications::UiClipboardPublications(::ArenaBase& __adhd_mother_arena, Core::IClipboardService& service)noexcept
    : __adhd_arena(::MakeNotNull(&__adhd_mother_arena))
    , m_completion(static_cast<Core::Alloc::GlobalArena&>(__adhd_mother_arena))
    , m_service(::MakeNotNull(&service))
{
    m_requests.reserve(s_UiClipboardMaxPublications);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


