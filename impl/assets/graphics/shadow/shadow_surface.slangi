////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_SHADOW_SURFACE_SLANGI
#define NWB_GRAPHICS_SHADOW_SURFACE_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Shadow trace serves the material-constants accessors from the ray hit via per-invocation globals, so the same hook evaluates here and in the rasterizer (NWB_MESH_MATERIAL_CONTEXT_PROVIDED).
#define NWB_MESH_MATERIAL_CONTEXT_PROVIDED
#include "../mesh/material_typed_bindings.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// One ray hit resolved for the surface hook: corner attributes + occluder record (instance/dispatch/constant offset).
// Normal is world space (surface contract); backends inverse-transpose before filling.
struct NwbShadowHit{
    uint meshInstanceIndex;
    uint surfaceDispatchId;
    uint materialConstantByteOffset;
    float2 uv0;
    float3 worldNormal;
    float3 worldPosition;
    float3 rayDirection;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Per-invocation material context populated from the current hit before invoking the material surface hook.
static uint g_NwbShadowMaterialConstantByteOffset = 0u;
static uint g_NwbShadowMeshInstanceIndex = 0u;
static uint g_NwbShadowSurfaceDispatchId = 0u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void nwbShadowSetMaterialContext(NwbShadowHit hit){
    g_NwbShadowMaterialConstantByteOffset = hit.materialConstantByteOffset;
    g_NwbShadowMeshInstanceIndex = hit.meshInstanceIndex;
    g_NwbShadowSurfaceDispatchId = hit.surfaceDispatchId;
}

uint nwbMeshMaterialConstantByteOffset(){
    return g_NwbShadowMaterialConstantByteOffset;
}

uint nwbMeshInstanceIndex(){
    return g_NwbShadowMeshInstanceIndex;
}

uint nwbMeshShadingModelId(){
    return g_NwbShadowSurfaceDispatchId;
}

NwbMeshInstanceData nwbMeshLoadInstance(){
    return g_NwbMeshInstances[nwbMeshInstanceIndex()];
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Typed-word loads for generated .bind accessors; NWB_MESH_MATERIAL_CONTEXT_PROVIDED suppresses the single-material nwbMaterialSurfaceAt.
#include "../mesh/material_typed_accessors.slangi"
#include "../mesh/surface.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Builds the surface-input bundle from a ray hit with world-space normal, uv0, worldPosition, and neutral color/tangent defaults.
NwbMeshSurfaceInputs nwbShadowBuildSurfaceInputs(NwbShadowHit hit){
    NwbMeshSurfaceInputs inputs;
    inputs.color = half4(1.0h, 1.0h, 1.0h, 1.0h);
    inputs.normal = hit.worldNormal;
    inputs.tangent = float4(1.0, 0.0, 0.0, 1.0);
    inputs.uv0 = hit.uv0;
    inputs.worldPosition = hit.worldPosition;
    // World-space shadow ray direction used by surface hooks and per-crossing Fresnel evaluation.
    inputs.incidentDirection = hit.rayDirection;
    return inputs;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

