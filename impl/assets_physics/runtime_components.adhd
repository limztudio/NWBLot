////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


register_asset RigidBodyComponentAsset using TypedComponentAutoRegistrar<RigidBodyComponentAsset>;
register_asset ColliderComponentAsset using TypedComponentAutoRegistrar<ColliderComponentAsset>;
register_asset JointComponentAsset using TypedComponentAutoRegistrar<JointComponentAsset>;
register_asset PhysicsWorldConfigComponentAsset using TypedComponentAutoRegistrar<PhysicsWorldConfigComponentAsset>;


