void SpinBoxModifiedClick(mut WidgetFixture self, in Point pos, in b8 extend, in b8 toggle){
    InputEvent down = InputEvent();
    down.type = InputEventType::PrimaryDown;
    down.position = pos;
    down.shift = extend;
    down.extend = extend;
    down.control = toggle;
    EXPECT_TRUE(self.send(down).pointerConsumed);
    InputEvent up = InputEvent();
    up.type = InputEventType::PrimaryUp;
    up.position = pos;
    up.shift = extend;
    up.extend = extend;
    up.control = toggle;
    EXPECT_TRUE(self.send(up).pointerConsumed);
}

void TreeModifiedClick(mut WidgetFixture self, in Point pos, in b8 extend, in b8 toggle){
    SpinBoxModifiedClick(self, pos, extend, toggle);
}


