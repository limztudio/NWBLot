#include <impl/ecs_render/reflection/feedback_planning.adhd>
#include <impl/ecs_render/reflection/history_planning.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ReflectionFeedbackState : NoCopy{
    private ReflectionSceneContentStamp m_stamp;
    private ReflectionSettings m_settings;
    private u64 m_generation = 1u;
    private u64 m_nextSequence = 1u;
    private u64 m_acceptedSequence = 0u;
    private u64 m_reservedSequence = 0u;
    private u64 m_epoch = 0u;
    private u64 m_startGraphicsFrame = 0u;
    private QueueSubmissionToken m_acceptedToken;
    private u32 m_nextProbeIndex = 0u;
    private u32 m_acceptedBank = 0u;
    private Futex m_mutex;
    private u16 m_deviceGeneration;
    private b8 m_enabled = false;
    private b8 m_eligible = false;
    private b8 m_hardwareReady = false;
    private b8 m_resourcesChanged = false;
    private b8 m_quarantined = false;

    public ReflectionFeedbackState(in u16 deviceGeneration){ this.m_deviceGeneration = deviceGeneration; }

    public void reset(in u16 deviceGeneration){
        const FutexGuard guard = AcquireFutex(this.m_mutex);

        ++this.m_generation;
        this.m_deviceGeneration = deviceGeneration;
        this.m_acceptedSequence = 0u;
        this.m_reservedSequence = 0u;
        this.m_acceptedToken = QueueSubmissionToken();
        this.m_nextProbeIndex = 0u;
        this.m_startGraphicsFrame = 0u;
        this.m_acceptedBank = 0u;
        this.m_enabled = false;
        this.m_eligible = false;
        this.m_hardwareReady = false;
        this.m_resourcesChanged = true;
        this.m_quarantined = false;
    }
    public ReflectionFeedbackPlan plan(in ReflectionSceneContentStamp stamp, in ReflectionSettings settings, in b8 enabled, in u64 graphicsFrameIndex){
        const FutexGuard guard = AcquireFutex(this.m_mutex);

        const u64 sequence = this.m_nextSequence;
        ++this.m_nextSequence;
        return ResolveReflectionFeedbackPlan(
            stamp,
            settings,
            enabled,
            graphicsFrameIndex,
            this.m_stamp,
            this.m_settings,
            this.m_generation,
            sequence,
            this.m_acceptedSequence,
            this.m_epoch,
            this.m_startGraphicsFrame,
            this.m_nextProbeIndex,
            this.m_acceptedBank,
            this.m_enabled,
            this.m_eligible,
            this.m_hardwareReady,
            this.m_resourcesChanged,
            this.m_quarantined
        );
    }
    public b8 reserve(in ReflectionFeedbackPlan plan){
        const FutexGuard guard = AcquireFutex(this.m_mutex);

        if(!CanReserveReflectionFeedbackPlan(this.m_quarantined, this.m_deviceGeneration, this.m_reservedSequence, this.m_generation, this.m_acceptedSequence, plan))
            return false;
        this.m_reservedSequence = plan.sequence;
        return true;
    }
    public void discard(in ReflectionFeedbackPlan plan){
        const FutexGuard guard = AcquireFutex(this.m_mutex);

        if(plan.generation == this.m_generation && plan.sequence == this.m_reservedSequence)
            this.m_reservedSequence = 0u;
    }
    public b8 accept(in ReflectionFeedbackPlan plan, in QueueSubmissionToken token, in b8 hardwareReady){
        const FutexGuard guard = AcquireFutex(this.m_mutex);

        if(plan.generation != this.m_generation || plan.sequence != this.m_reservedSequence)
            return false;
        this.m_reservedSequence = 0u;
        if(!IsValidAcceptedReflectionFeedbackToken(token, this.m_deviceGeneration, this.m_acceptedToken)){
            this.m_quarantined = true;
            return false;
        }
        this.m_acceptedToken = token;
        ApplyAcceptedReflectionFeedbackPlan(
            plan,
            hardwareReady,
            this.m_stamp,
            this.m_settings,
            this.m_acceptedSequence,
            this.m_epoch,
            this.m_startGraphicsFrame,
            this.m_nextProbeIndex,
            this.m_acceptedBank,
            this.m_enabled,
            this.m_eligible,
            this.m_hardwareReady,
            this.m_resourcesChanged
        );
        return true;
    }
}

type ReflectionFeedbackControlHandle = Shared<ReflectionFeedbackState>;

[move_only]
class ReflectionFeedbackReservation{
    private PlanReservation<ReflectionFeedbackControlHandle, ReflectionFeedbackPlan> m_lease;

    public ReflectionFeedbackReservation(){}
    public ReflectionFeedbackReservation(in ReflectionFeedbackControlHandle control, in ReflectionFeedbackPlan plan){
        this.m_lease = PlanReservation<ReflectionFeedbackControlHandle, ReflectionFeedbackPlan>(control, plan);
    }

    public b8 valid()const{ return this.m_lease.valid(); }
    public void discard(){ this.m_lease.discard(); }

    public void accept(in QueueSubmissionToken token, in b8 hardwareReady){
        if(!this.m_lease.valid())
            return;
        const ReflectionFeedbackControlHandle control = this.m_lease.control();
        if(!control.deref().accept(this.m_lease.plan(), token, hardwareReady)){
            this.m_lease.discard();
            return;
        }
        this.m_lease.release();
    }
}


