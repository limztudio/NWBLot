NWB_ADHD_GTEST(PhysicsEdgeCases, SpeculativeContactAndFastImpact, VerifyPhysicsEdgeCases_SpeculativeContactAndFastImpact)
NWB_ADHD_GTEST(PhysicsEdgeCases, RayCastAndShapeCastEdgeCases, VerifyPhysicsEdgeCases_RayCastAndShapeCastEdgeCases)
NWB_ADHD_GTEST(PhysicsEdgeCases, GpuLayoutAndEcsCpuFallbackContract, VerifyPhysicsEdgeCases_GpuLayoutAndEcsCpuFallbackContract)
NWB_ADHD_GTEST(PhysicsEdgeCases, SphereBounceAccuracyAndNoMidAirFreeze, VerifyPhysicsEdgeCases_SphereBounceAccuracyAndNoMidAirFreeze)
NWB_ADHD_GTEST(PhysicsEdgeCases, CoupledTowerImpactAndCoplanarGjk, VerifyPhysicsEdgeCases_CoupledTowerImpactAndCoplanarGjk)
NWB_ADHD_GTEST(PhysicsEdgeCases, SleepingStackWakeupAndSensorEvents, VerifyPhysicsEdgeCases_SleepingStackWakeupAndSensorEvents)
