void VerifyGlobal_EnvironmentVariableNamesSupportSlicesAndRejectEmbeddedNull(){
    const StringView pathName = "PATH";
    const StringView slicedPathName = StringView("PATH.trailing").substr(0u, 4u);
    const Expected<Optional<String>, ErrorCode> expected = ReadEnvironmentVariable(pathName);
    const Expected<Optional<String>, ErrorCode> actual = ReadEnvironmentVariable(slicedPathName);
    ASSERT_TRUE(expected.has_value());
    ASSERT_TRUE(actual.has_value());

    ASSERT_TRUE(expected.value().has_value());
    ASSERT_TRUE(actual.value().has_value());
    const StringView expectedValue = StringView(expected.value().value());
    EXPECT_EQ(StringView(actual.value().value()), expectedValue);

    String different = String(expectedValue);
    different.append("x");
    const Expected<b8, ErrorCode> exactMatch = EnvironmentVariableEquals(pathName, StringView(expectedValue));
    const Expected<b8, ErrorCode> mutatedMatch = EnvironmentVariableEquals(pathName, StringView(different));
    const Expected<b8, ErrorCode> hasValueResult = HasEnvironmentValue(pathName);
    ASSERT_TRUE(exactMatch.has_value());
    EXPECT_TRUE(exactMatch.value());
    ASSERT_TRUE(mutatedMatch.has_value());
    EXPECT_FALSE(mutatedMatch.value());
    ASSERT_TRUE(hasValueResult.has_value());
    EXPECT_EQ(hasValueResult.value(), !expectedValue.empty());

    const StringView invalidName = StringView("PATH\0X", 6u);
    const Expected<Optional<String>, ErrorCode> invalid = ReadEnvironmentVariable(invalidName);
    ASSERT_FALSE(invalid.has_value());
    EXPECT_EQ(invalid.error(), MakeErrorCode(ErrorCondition::invalid_argument));
    const Expected<b8, ErrorCode> invalidEquals = EnvironmentVariableEquals(invalidName, "unused");
    const Expected<b8, ErrorCode> invalidHasValue = HasEnvironmentValue(invalidName);
    ASSERT_FALSE(invalidEquals.has_value());
    ASSERT_FALSE(invalidHasValue.has_value());
    EXPECT_EQ(invalidEquals.error(), invalid.error());
    EXPECT_EQ(invalidHasValue.error(), invalid.error());
}

void VerifyGlobal_DirectoryRetentionPreservesPredicateErrorAndRetainsUnadmittedEntries(){
    b8 retentionFailedWithExpectedError = false;
    Expected<b8, ErrorCode> firstExists = false;
    Expected<b8, ErrorCode> secondExists = false;
    b8 removedRoot = false;

    native(mut retentionFailedWithExpectedError, mut firstExists, mut secondExists, mut removedRoot){
        NWB::Tests::TestArena<> testArena;
        const ::Path<NWB::Core::Alloc::GlobalArena> root(testArena.arena, "global_test_artifacts/retention_predicate_error");
        ASSERT_TRUE(EnsureEmptyDirectory(root));
        ASSERT_TRUE(WriteTextFile(root / "a", "retained"));
        ASSERT_TRUE(WriteTextFile(root / "b", "retained"));
        const ErrorCode expectedError = MakeErrorCode(ErrorCondition::permission_denied);
        const auto retained = ApplyDirectoryRetention(testArena.arena, root, 1u, [&](const auto&)noexcept->Expected<b8, ErrorCode>{ return MakeUnexpected(expectedError); });
        retentionFailedWithExpectedError = !retained && retained.error() == expectedError;
        firstExists = FileExists(root / "a");
        secondExists = FileExists(root / "b");
        removedRoot = RemoveAllIfExists(root).has_value();
    }

    EXPECT_TRUE(retentionFailedWithExpectedError);
    ASSERT_TRUE(firstExists.has_value());
    ASSERT_TRUE(secondExists.has_value());
    EXPECT_TRUE(firstExists.value());
    EXPECT_TRUE(secondExists.value());
    EXPECT_TRUE(removedRoot);
}

void VerifyGlobal_FileWriteSizeRejectionPreservesExistingOutput(){
    b8 oversizedWriteAccepted = true;
    b8 readBackOk = false;
    String retainedText = "";
    b8 removedRoot = false;

    native(mut oversizedWriteAccepted, mut readBackOk, mut retainedText, mut removedRoot){
        using namespace __hidden_process_filesystem_boundary_tests;
        NWB::Tests::TestArena<> testArena;
        const ::Path<NWB::Core::Alloc::GlobalArena> root(testArena.arena, "global_test_artifacts/oversized_file_write");
        const auto outputPath = root / "output.bin";
        ASSERT_TRUE(EnsureEmptyDirectory(root));
        ASSERT_TRUE(WriteTextFile(outputPath, "retained"));

        oversizedWriteAccepted = WriteBinaryFile(outputPath, OversizedBinarySource{});
        NWB::Tests::TestAString retained(testArena.arena);
        readBackOk = ReadTextFile(outputPath, retained).has_value();
        retainedText.assign(AStringView(retained));
        removedRoot = RemoveAllIfExists(root).has_value();
    }

    EXPECT_FALSE(oversizedWriteAccepted);
    ASSERT_TRUE(readBackOk);
    EXPECT_EQ(StringView(retainedText), StringView("retained"));
    EXPECT_TRUE(removedRoot);
}

void VerifyGlobal_DirectoryCreationRejectsExistingFileWithoutChangingIt(){
    const Path root = Path("global_test_artifacts/directory_creation_file_collision");
    const Path blocker = root / "existing.txt";
    ASSERT_TRUE(EnsureEmptyDirectory(root).has_value());
    ASSERT_TRUE(WriteTextFile(blocker, "retained"));

    const Expected<b8, ErrorCode> unchangedDirectory = CreateDirectories(root);
    const Expected<b8, ErrorCode> collidedCreate = CreateDirectories(blocker);
    ASSERT_TRUE(unchangedDirectory.has_value());
    EXPECT_FALSE(unchangedDirectory.value());
    ASSERT_FALSE(collidedCreate.has_value());
    EXPECT_NE(collidedCreate.error().value(), 0);
    EXPECT_FALSE(EnsureDirectories(blocker).has_value());

    String retainedText = "";
    ASSERT_TRUE(ReadTextFile(blocker, retainedText).has_value());
    EXPECT_EQ(StringView(retainedText), StringView("retained"));
    EXPECT_TRUE(RemoveAllIfExists(root).has_value());
}

void VerifyGlobal_FileWritesRejectBufferedDeviceFailure(){
    b8 linuxSupported = false;
    b8 textWriteSucceeded = true;
    b8 binaryWriteSucceeded = true;
    Array<u8, 3> payload = Array<u8, 3>();
    payload[0u] = 1u;
    payload[1u] = 2u;
    payload[2u] = 3u;

    native(in payload, mut linuxSupported, mut textWriteSucceeded, mut binaryWriteSucceeded){
#if defined(FOUNDATION_PLATFORM_LINUX) && !defined(FOUNDATION_PLATFORM_ANDROID)
        linuxSupported = true;
        NWB::Tests::TestArena<> testArena;
        const ::Path<NWB::Core::Alloc::GlobalArena> fullDevice(testArena.arena, "/dev/full");
        textWriteSucceeded = WriteTextFile(fullDevice, "buffered output");
        binaryWriteSucceeded = WriteBinaryFile(fullDevice, Span<const u8>(payload));
#else
        static_cast<void>(payload);
#endif
    }

    if(!linuxSupported)
        return;

    EXPECT_FALSE(textWriteSucceeded);
    EXPECT_FALSE(binaryWriteSucceeded);
}

void VerifyGlobal_PathNativeComponentsMatchOwningIterationAndRemainValidAfterAdvance(){
    usize componentCount = 0u;
    b8 allComponentsMatched = true;
    b8 incrementedPastEndStaysAtEnd = false;
    b8 emptyPathBeginEqualsEnd = false;

    native(mut componentCount, mut allComponentsMatched, mut incrementedPastEndStaysAtEnd, mut emptyPathBeginEqualsEnd){
        NWB::Tests::TestArena<> testArena;
#if defined(FOUNDATION_UNICODE)
        constexpr TStringView s_KoreanComponent = FOUNDATION_TEXT("\uD55C\uAE00");
#else
        constexpr TStringView s_KoreanComponent = FOUNDATION_TEXT("\xED\x95\x9C\xEA\xB8\x80");
#endif
#if defined(FOUNDATION_PLATFORM_WINDOWS)
        const ::Path<NWB::Core::Alloc::GlobalArena> path(testArena.arena, "C:\\Root//./\xED\x95\x9C\xEA\xB8\x80/File.TXT/");
        constexpr Array<TStringView, 5u> s_Expected = { FOUNDATION_TEXT("C:\\"), FOUNDATION_TEXT("Root"), FOUNDATION_TEXT("."), s_KoreanComponent, FOUNDATION_TEXT("File.TXT") };
#else
        const ::Path<NWB::Core::Alloc::GlobalArena> path(testArena.arena, "/Root//./\xED\x95\x9C\xEA\xB8\x80/File.TXT/");
        constexpr Array<TStringView, 5u> s_Expected = { FOUNDATION_TEXT("/"), FOUNDATION_TEXT("Root"), FOUNDATION_TEXT("."), s_KoreanComponent, FOUNDATION_TEXT("File.TXT") };
#endif
        auto componentIt = path.begin();
        const TStringView first = componentIt.nativeComponent();
        while(componentIt != path.end()){
            if(componentCount >= LengthOf(s_Expected)){
                allComponentsMatched = false;
                break;
            }
            const TStringView borrowed = componentIt.nativeComponent();
            const auto owned = *componentIt;
            auto next = componentIt;
            ++next;
            const b8 stepOk =
                borrowed == s_Expected[componentCount]
                && owned.native() == borrowed
                && componentIt.nativeComponent() == borrowed
            ;
            componentIt = next;
            allComponentsMatched = allComponentsMatched && stepOk && borrowed == s_Expected[componentCount] && first == s_Expected[0u];
            ++componentCount;
        }
        ++componentIt;
        incrementedPastEndStaysAtEnd = componentIt == path.end();

        const ::Path<NWB::Core::Alloc::GlobalArena> empty(testArena.arena);
        emptyPathBeginEqualsEnd = empty.begin() == empty.end();
    }

    EXPECT_EQ(componentCount, 5u);
    EXPECT_TRUE(allComponentsMatched);
    EXPECT_TRUE(incrementedPastEndStaysAtEnd);
    EXPECT_TRUE(emptyPathBeginEqualsEnd);
}

void VerifyGlobal_PathNativeComponentViewsBorrowSourceStorageWithoutAllocating(){
    const Name owner = s_GlobalCaseTestsPathNativeComponentViews;
    b8 firstPointsToStart = false;
    b8 allSlicesWithinBounds = true;
    b8 secondDiffersFromFirst = false;
    b8 retainedMatchesFirstComponent = false;
    ArenaMemoryStats before = ArenaMemoryStats();
    ArenaMemoryStats after = ArenaMemoryStats();

    native(in owner, mut firstPointsToStart, mut allSlicesWithinBounds, mut secondDiffersFromFirst, mut retainedMatchesFirstComponent, mut before, mut after){
        NWB::Core::Alloc::GlobalArena arena(owner);
        const ::Path<NWB::Core::Alloc::GlobalArena> path(arena, "First_component_long_enough_to_require_owning_storage/Second_component_with_Unicode_\xED\x95\x9C\xEA\xB8\x80_\xF0\x9F\x98\x80/Third_component");
        const TStringView nativeView = path.native();
        before = arena.memoryStats();
        TStringView retained;
        {
            auto componentIt = path.begin();
            retained = componentIt.nativeComponent();
            firstPointsToStart = retained.data() == nativeView.data();
            for(usize repetition = 0u; repetition < 32u; ++repetition){
                usize count = 0u;
                for(auto it = path.begin(); it != path.end(); ++it){
                    const TStringView component = it.nativeComponent();
                    allSlicesWithinBounds = allSlicesWithinBounds && component.data() >= nativeView.data() && (component.data() + component.size()) <= (nativeView.data() + nativeView.size());
                    ++count;
                }
                allSlicesWithinBounds = allSlicesWithinBounds && count == 3u;
            }
            ++componentIt;
            secondDiffersFromFirst = componentIt.nativeComponent().data() != retained.data();
        }
        retainedMatchesFirstComponent = retained == TStringView(FOUNDATION_TEXT("First_component_long_enough_to_require_owning_storage"));
        after = arena.memoryStats();
    }

    EXPECT_TRUE(firstPointsToStart);
    EXPECT_TRUE(allSlicesWithinBounds);
    EXPECT_TRUE(secondDiffersFromFirst);
    EXPECT_TRUE(retainedMatchesFirstComponent);
    EXPECT_EQ(after.allocationCount, before.allocationCount);
    EXPECT_EQ(after.reallocationCount, before.reallocationCount);
    EXPECT_EQ(after.deallocationCount, before.deallocationCount);
    EXPECT_EQ(after.usedBytes, before.usedBytes);
}

void VerifyGlobal_MovePathReplacesExistingDestinationWithoutRetainingSource(){
    const StringView sourceFilename = "source.txt";
    const Path root = Path("global_test_artifacts/move_path_to_directory");
    const Path source = root / sourceFilename;
    const Path destinationDirectory = root / "moved";
    const Path destination = destinationDirectory / sourceFilename;

    ASSERT_TRUE(EnsureEmptyDirectory(root).has_value());
    ASSERT_TRUE(WriteTextFile(source, "fresh"));
    ASSERT_TRUE(EnsureDirectories(destinationDirectory).has_value());
    ASSERT_TRUE(WriteTextFile(destination, "old"));

    const Expected<Path, ErrorCode> movedPath = MovePathToDirectory(source, destinationDirectory);
    ASSERT_TRUE(movedPath.has_value());
    EXPECT_EQ(movedPath.value(), destination);

    String destinationText = "";
    ASSERT_TRUE(ReadTextFile(destination, destinationText).has_value());
    EXPECT_EQ(StringView(destinationText), StringView("fresh"));

    const Expected<b8, ErrorCode> sourceExistsAfterMove = FileExists(source);
    ASSERT_TRUE(sourceExistsAfterMove.has_value());
    EXPECT_FALSE(sourceExistsAfterMove.value());
    EXPECT_TRUE(RemoveAllIfExists(root).has_value());
}

void VerifyGlobal_PathViewAccessorsAndSelfAliasingMutationsPreserveBoundariesWithoutExtraAllocations(){
    b8 viewAccessorsMatched = false;
    b8 multiDotListed = false;
    b8 hiddenListed = true;
    u64 baselineUsedBytes = 0u;
    u64 afterViewsUsedBytes = 1u;
    b8 selfAliasingMutationsMatched = false;

    native(mut viewAccessorsMatched, mut multiDotListed, mut hiddenListed, mut baselineUsedBytes, mut afterViewsUsedBytes, mut selfAliasingMutationsMatched){
        NWB::Tests::TestArena<> testArena;
        const ::Path<NWB::Core::Alloc::GlobalArena> emptyPath(testArena.arena);
        const ::Path<NWB::Core::Alloc::GlobalArena> rootSlash(testArena.arena, FOUNDATION_TEXT("///"));
        const ::Path<NWB::Core::Alloc::GlobalArena> hiddenPath(testArena.arena, FOUNDATION_TEXT("dir/.hidden///"));
        const ::Path<NWB::Core::Alloc::GlobalArena> multiDotPath(testArena.arena, FOUNDATION_TEXT("alpha/beta/archive.tar.NWB"));
        baselineUsedBytes = testArena.arena.memoryStats().usedBytes;

        viewAccessorsMatched =
            emptyPath.parentPathView().empty()
            && emptyPath.filenameView().empty()
            && emptyPath.stemView().empty()
            && emptyPath.extensionView().empty()
            && rootSlash.parentPathView() == TStringView(FOUNDATION_TEXT("/"))
            && rootSlash.filenameView().empty()
            && hiddenPath.parentPathView() == TStringView(FOUNDATION_TEXT("dir"))
            && hiddenPath.filenameView() == TStringView(FOUNDATION_TEXT(".hidden"))
            && hiddenPath.stemView() == TStringView(FOUNDATION_TEXT(".hidden"))
            && hiddenPath.extensionView().empty()
            && multiDotPath.parentPathView() == TStringView(FOUNDATION_TEXT("alpha/beta"))
            && multiDotPath.filenameView() == TStringView(FOUNDATION_TEXT("archive.tar.NWB"))
            && multiDotPath.stemView() == TStringView(FOUNDATION_TEXT("archive.tar"))
            && multiDotPath.extensionView() == TStringView(FOUNDATION_TEXT(".NWB"))
        ;

        constexpr Array<AStringView, 2u> s_AllowedExtensions = { ".nwb", ".slang" };
        multiDotListed = PathHasListedExtension(multiDotPath, s_AllowedExtensions);
        hiddenListed = PathHasListedExtension(hiddenPath, s_AllowedExtensions);
        afterViewsUsedBytes = testArena.arena.memoryStats().usedBytes;

        ::Path<NWB::Core::Alloc::GlobalArena> aliased(
            testArena.arena,
            FOUNDATION_TEXT("alpha_segment_0123456789/beta_segment_0123456789/gamma_segment_0123456789/delta.ext")
        );
        aliased += aliased.extensionView();
        const b8 step1 = aliased.filenameView() == TStringView(FOUNDATION_TEXT("delta.ext.ext"));
        aliased.replaceExtension(aliased.stemView());
        const b8 step2 = aliased.filenameView() == TStringView(FOUNDATION_TEXT("delta.ext.delta.ext"));
        aliased /= aliased.parentPathView();
        const b8 step3 = aliased.filenameView() == TStringView(FOUNDATION_TEXT("gamma_segment_0123456789"));

        ::Path<NWB::Core::Alloc::GlobalArena> extension(testArena.arena, FOUNDATION_TEXT("name.ext"));
        extension.replaceExtension(extension.extensionView());
        ::Path<NWB::Core::Alloc::GlobalArena> filename(testArena.arena, FOUNDATION_TEXT("name.ext"));
        filename.replaceExtension(filename.filenameView());
        ::Path<NWB::Core::Alloc::GlobalArena> self(testArena.arena, FOUNDATION_TEXT("name.ext"));
        self.replaceExtension(self);

        selfAliasingMutationsMatched =
            step1
            && step2
            && step3
            && extension.native() == TStringView(FOUNDATION_TEXT("name.ext"))
            && filename.native() == TStringView(FOUNDATION_TEXT("name.name.ext"))
            && self.native() == TStringView(FOUNDATION_TEXT("name.name.ext"))
        ;
    }

    EXPECT_TRUE(viewAccessorsMatched);
    EXPECT_TRUE(multiDotListed);
    EXPECT_FALSE(hiddenListed);
    EXPECT_EQ(afterViewsUsedBytes, baselineUsedBytes);
    EXPECT_TRUE(selfAliasingMutationsMatched);
}

void VerifyGlobal_AreSameExistingPathAndAtomicWriteHandleHardLinksAndRejectDirectoryTargets(){
    Expected<b8, ErrorCode> sameSelf = false;
    Expected<b8, ErrorCode> sameDistinct = true;
    Expected<b8, ErrorCode> sameMissing = true;
    b8 hardLinkCreated = false;
    Expected<b8, ErrorCode> sameHardLink = false;
    b8 atomicWriteToDirectoryAccepted = true;
    Expected<b8, ErrorCode> dirStillExists = false;
    b8 atomicUpdateSucceeded = false;
    b8 readBackOk = false;
    String updatedText = "";
    b8 removedRoot = false;

    native(
        mut sameSelf,
        mut sameDistinct,
        mut sameMissing,
        mut hardLinkCreated,
        mut sameHardLink,
        mut atomicUpdateSucceeded,
        mut atomicWriteToDirectoryAccepted,
        mut dirStillExists,
        mut readBackOk,
        mut updatedText,
        mut removedRoot
    ){
        NWB::Tests::TestArena<> testArena;
        const ::Path<NWB::Core::Alloc::GlobalArena> root(testArena.arena, "global_test_artifacts/same_existing_and_atomic_write");
        const ::Path<NWB::Core::Alloc::GlobalArena> firstFile = root / "first.txt";
        const ::Path<NWB::Core::Alloc::GlobalArena> secondFile = root / "second.txt";
        const ::Path<NWB::Core::Alloc::GlobalArena> hardLinkFile = root / "first_hardlink.txt";
        const ::Path<NWB::Core::Alloc::GlobalArena> missingFile = root / "missing.txt";
        const ::Path<NWB::Core::Alloc::GlobalArena> directoryTarget = root / "dir_target";

        ASSERT_TRUE(EnsureEmptyDirectory(root));
        ASSERT_TRUE(StagedFileWriter(firstFile).writeTextAtomic(AStringView("initial")));
        ASSERT_TRUE(StagedFileWriter(secondFile).writeTextAtomic(AStringView("distinct")));
        ASSERT_TRUE(EnsureDirectories(directoryTarget));

        sameSelf = PathIdentity(firstFile, firstFile).sameExisting();
        sameDistinct = PathIdentity(firstFile, secondFile).sameExisting();
        sameMissing = PathIdentity(firstFile, missingFile).sameExisting();

#if defined(FOUNDATION_PLATFORM_WINDOWS)
        hardLinkCreated = CreateHardLink(hardLinkFile.c_str(), firstFile.c_str(), nullptr) != 0;
#else
        hardLinkCreated = ::link(firstFile.c_str(), hardLinkFile.c_str()) == 0;
#endif
        if(hardLinkCreated)
            sameHardLink = PathIdentity(firstFile, hardLinkFile).sameExisting();

        atomicWriteToDirectoryAccepted = StagedFileWriter(directoryTarget).writeTextAtomic(AStringView("must_fail"));
        dirStillExists = IsDirectory(directoryTarget);

        atomicUpdateSucceeded = StagedFileWriter(firstFile).writeTextAtomic(AStringView("updated_atomically"));
        ::AString<NWB::Core::Alloc::GlobalArena> readBack(testArena.arena);
        readBackOk = ReadTextFile(firstFile, readBack).has_value();
        updatedText.assign(AStringView(readBack));
        removedRoot = RemoveAllIfExists(root).has_value();
    }

    ASSERT_TRUE(sameSelf.has_value());
    ASSERT_TRUE(sameDistinct.has_value());
    ASSERT_TRUE(sameMissing.has_value());
    EXPECT_TRUE(sameSelf.value());
    EXPECT_FALSE(sameDistinct.value());
    EXPECT_FALSE(sameMissing.value());
    if(hardLinkCreated){
        ASSERT_TRUE(sameHardLink.has_value());
        EXPECT_TRUE(sameHardLink.value());
    }
    EXPECT_FALSE(atomicWriteToDirectoryAccepted);
    ASSERT_TRUE(dirStillExists.has_value());
    EXPECT_TRUE(dirStillExists.value());
    ASSERT_TRUE(atomicUpdateSucceeded);
    ASSERT_TRUE(readBackOk);
    EXPECT_EQ(StringView(updatedText), StringView("updated_atomically"));
    EXPECT_TRUE(removedRoot);
}

void VerifyGlobal_RecursiveDirectoryIteratorDoesNotFollowDirectorySymlinks(){
    b8 linuxSupported = false;
    Expected<b8, ErrorCode> followed = false;
    Expected<b8, ErrorCode> noFollow = true;
    b8 iteratorCreated = false;
    usize entryCount = 0u;
    b8 allEntriesNonEmpty = true;
    b8 removedRoot = false;

    native(mut linuxSupported, mut followed, mut noFollow, mut iteratorCreated, mut entryCount, mut allEntriesNonEmpty, mut removedRoot){
#if defined(FOUNDATION_PLATFORM_LINUX)
        linuxSupported = true;
        NWB::Tests::TestArena<> testArena;
        const ::Path<NWB::Core::Alloc::GlobalArena> root(testArena.arena, "global_test_artifacts/recursive_directory_iterator_links");
        const ::Path<NWB::Core::Alloc::GlobalArena> regularFile = root / "regular.txt";
        const ::Path<NWB::Core::Alloc::GlobalArena> directoryLink = root / "self";

        ASSERT_TRUE(EnsureEmptyDirectory(root));
        ASSERT_TRUE(WriteTextFile(regularFile, AStringView("regular")));
        ASSERT_EQ(::symlink(".", directoryLink.c_str()), 0);

        followed = IsDirectory(directoryLink);
        noFollow = IsDirectoryNoFollow(directoryLink);

        const auto directory = RecursiveDirectoryIterator<NWB::Core::Alloc::GlobalArena>::Create(root);
        iteratorCreated = directory.has_value();
        if(directory){
            for(const auto& entry : *directory){
                allEntriesNonEmpty = allEntriesNonEmpty && !entry.path().empty();
                ++entryCount;
            }
        }
        removedRoot = RemoveAllIfExists(root).has_value();
#endif
    }

    if(!linuxSupported)
        return;

    ASSERT_TRUE(followed.has_value());
    ASSERT_TRUE(noFollow.has_value());
    EXPECT_TRUE(followed.value());
    EXPECT_FALSE(noFollow.value());
    ASSERT_TRUE(iteratorCreated);
    EXPECT_TRUE(allEntriesNonEmpty);
    EXPECT_EQ(entryCount, 2u);
    EXPECT_TRUE(removedRoot);
}

void VerifyGlobal_ProcessArgumentValidationPreservesExistingOutput(){
    b8 embeddedNullRunAccepted = true;
    b8 emptyArgvRunAccepted = true;
    b8 readBackOk = false;
    String retainedOutput = "";
    b8 removedRoot = false;

    native(mut embeddedNullRunAccepted, mut emptyArgvRunAccepted, mut readBackOk, mut retainedOutput, mut removedRoot){
        NWB::Tests::TestArena<> testArena;
        const ::Path<NWB::Core::Alloc::GlobalArena> root(testArena.arena, "global_test_artifacts/invalid_process_arguments");
        const auto outputPath = root / "output.txt";
        ASSERT_TRUE(EnsureEmptyDirectory(root));
        ASSERT_TRUE(WriteTextFile(outputPath, AStringView("retained")));
#if defined(FOUNDATION_UNICODE)
        const auto outputPathText = PathToString<char>(testArena.arena, outputPath);
#else
        const AStringView outputPathText = outputPath.native();
#endif

        const Array<char, 3u> invalidArgument = { 'a', '\0', 'b' };
        const Array<AStringView, 2u> arguments = { "unused_program", AStringView(invalidArgument) };
        embeddedNullRunAccepted = RunProcessRedirectedToFile(testArena.arena, arguments, AStringView(outputPathText)).has_value();
        emptyArgvRunAccepted = RunProcessRedirectedToFile(testArena.arena, {}, AStringView(outputPathText)).has_value();
        NWB::Tests::TestAString output(testArena.arena);
        readBackOk = ReadTextFile(outputPath, output).has_value();
        retainedOutput.assign(AStringView(output));
        removedRoot = RemoveAllIfExists(root).has_value();
    }

    EXPECT_FALSE(embeddedNullRunAccepted);
    EXPECT_FALSE(emptyArgvRunAccepted);
    ASSERT_TRUE(readBackOk);
    EXPECT_EQ(StringView(retainedOutput), StringView("retained"));
    EXPECT_TRUE(removedRoot);
}

void VerifyGlobal_WindowsProcessInputsSupportBoundedViews(){
    const StringView trailingSuffix = s_GlobalProcessTrailingSuffix;
    const StringView combinedFilename = s_GlobalProcessCombinedOutputFilename;
    b8 windowsSupported = false;
    Expected<b8, ErrorCode> executableAvailable = false;
    b8 runSucceeded = false;
    i32 exitCodeValue = 0;
    b8 readOutputOk = false;
    String outputText = "";
    b8 removedRoot = false;

    native(in trailingSuffix, in combinedFilename, mut windowsSupported, mut executableAvailable, mut runSucceeded, mut exitCodeValue, mut readOutputOk, mut outputText, mut removedRoot){
#if defined(FOUNDATION_PLATFORM_WINDOWS)
        windowsSupported = true;
        NWB::Tests::TestArena<> testArena;
        auto executableResult = ReadEnvironmentVariable(testArena.arena, "ComSpec");
        ASSERT_TRUE(executableResult);
        ASSERT_TRUE(*executableResult);
        auto executableText = Move(**executableResult);
        const ::Path<NWB::Core::Alloc::GlobalArena> executablePath(testArena.arena, AStringView(executableText));
        ::AString<NWB::Core::Alloc::GlobalArena> searchPathText = PathToString<char>(testArena.arena, executablePath.parentPathView());
        ::AString<NWB::Core::Alloc::GlobalArena> executableNameText = PathToString<char>(testArena.arena, executablePath.filenameView());
        const usize searchPathLength = searchPathText.size();
        const usize executableNameLength = executableNameText.size();
        searchPathText += trailingSuffix;
        executableNameText += trailingSuffix;
        executableAvailable = ExecutableAvailableInPath(testArena.arena, AStringView(searchPathText).substr(0u, searchPathLength), AStringView(executableNameText).substr(0u, executableNameLength));

        const ::Path<NWB::Core::Alloc::GlobalArena> root(testArena.arena, "global_test_artifacts/bounded_process");
        const auto outputPath = root / combinedFilename;
        ASSERT_TRUE(EnsureEmptyDirectory(root));
        ::AString<NWB::Core::Alloc::GlobalArena> outputPathText = PathToString<char>(testArena.arena, outputPath);
        const usize outputPathLength = outputPathText.size();
        const usize executableLength = executableText.size();
        outputPathText += trailingSuffix;
        executableText += trailingSuffix;
        const Array<AStringView, 3u> arguments = { AStringView(executableText).substr(0u, executableLength), "/c", "echo stdout&echo stderr 1>&2&exit /b 23" };
        const auto exitCode = RunProcessRedirectedToFile(testArena.arena, arguments, AStringView(outputPathText).substr(0u, outputPathLength));
        runSucceeded = exitCode.has_value();
        if(exitCode)
            exitCodeValue = *exitCode;
        ::AString<NWB::Core::Alloc::GlobalArena> output(testArena.arena);
        readOutputOk = ReadTextFile(outputPath, output).has_value();
        outputText.assign(AStringView(output));
        removedRoot = RemoveAllIfExists(root).has_value();
#else
        static_cast<void>(trailingSuffix);
        static_cast<void>(combinedFilename);
#endif
    }

    if(!windowsSupported)
        return;

    ASSERT_TRUE(executableAvailable.has_value());
    EXPECT_TRUE(executableAvailable.value());
    ASSERT_TRUE(runSucceeded);
    EXPECT_EQ(exitCodeValue, 23);
    ASSERT_TRUE(readOutputOk);
    EXPECT_LT(outputText.find("stdout"), outputText.size());
    EXPECT_LT(outputText.find("stderr"), outputText.size());
    EXPECT_TRUE(removedRoot);
}

void VerifyGlobal_CaptureProcessOutputAdmitsEmptySuccessAndPreservesExitFailure(){
    const StringView binSh = s_GlobalProcessBinSh;
    const StringView cFlag = s_GlobalProcessCFlag;
    b8 linuxSupported = false;
    b8 invalidRejected = false;
    b8 emptyCaptureSucceeded = false;
    b8 emptyOutputWasEmpty = false;
    b8 failedChildRejected = false;
    i32 failedExitCode = 0;
    String retainedChildStdout = "";

    native(in binSh, in cFlag, mut linuxSupported, mut invalidRejected, mut emptyCaptureSucceeded, mut emptyOutputWasEmpty, mut failedChildRejected, mut failedExitCode, mut retainedChildStdout){
#if defined(FOUNDATION_PLATFORM_LINUX) && !defined(FOUNDATION_PLATFORM_ANDROID)
        linuxSupported = true;
        NWB::Tests::TestArena<> testArena;
        NWB::Tests::TestAString output(testArena.arena);
        const auto invalid = CaptureProcessOutput(output, testArena.arena, {});
        invalidRejected = !invalid && invalid.error().kind == ProcessCaptureFailureKind::InvalidArguments && invalid.error().nativeError == ErrorCondition::invalid_argument;
        const Array<AStringView, 3u> emptyArguments = { binSh, cFlag, "exit 0" };
        emptyCaptureSucceeded = CaptureProcessOutput(output, testArena.arena, emptyArguments).has_value();
        emptyOutputWasEmpty = output.empty();
        const Array<AStringView, 3u> failedArguments = { binSh, cFlag, "printf retained; exit 23" };
        const auto failed = CaptureProcessOutput(output, testArena.arena, failedArguments);
        if(!failed){
            failedChildRejected = failed.error().kind == ProcessCaptureFailureKind::ChildExitedUnsuccessfully;
            failedExitCode = failed.error().exitCode;
        }
        retainedChildStdout.assign(AStringView(output));
#else
        static_cast<void>(binSh);
        static_cast<void>(cFlag);
#endif
    }

    if(!linuxSupported)
        return;

    EXPECT_TRUE(invalidRejected);
    ASSERT_TRUE(emptyCaptureSucceeded);
    EXPECT_TRUE(emptyOutputWasEmpty);
    ASSERT_TRUE(failedChildRejected);
    EXPECT_EQ(failedExitCode, 23);
    EXPECT_EQ(StringView(retainedChildStdout), StringView("retained"));
}

void VerifyGlobal_CaptureProcessOutputAppendFailureClosesPipeAndReapsChildBeforeUnwinding(){
    const StringView binSh = s_GlobalProcessBinSh;
    const StringView cFlag = s_GlobalProcessCFlag;
    const u32 captureTimeoutMS = s_GlobalProcessCaptureTimeoutMS;
    b8 linuxSupported = false;
    i64 childPidValue = 0;
    i64 waitResultValue = 0;
    b8 waitReportedNoChild = false;

    native(in binSh, in cFlag, in captureTimeoutMS, mut linuxSupported, mut childPidValue, mut waitResultValue, mut waitReportedNoChild){
#if defined(FOUNDATION_PLATFORM_LINUX) && !defined(FOUNDATION_PLATFORM_ANDROID)
        using namespace __hidden_process_execution_boundary_tests;
        linuxSupported = true;
        const Array<AStringView, 3u> argv = { binSh, cFlag, "printf '%s\\n' \"$$\"; exec 1>&-; while :; do :; done" };
        NWB::Tests::TestArena<> testArena;
        ThrowingCaptureOutput output;
        EXPECT_THROW(EXPECT_FALSE(CaptureProcessOutput(output, testArena.arena, argv, 64u, 64u, captureTimeoutMS)), RuntimeException);
        childPidValue = static_cast<i64>(output.childPid);
        if(output.childPid > 0){
            int status = 0;
            errno = 0;
            const pid_t waitResult = ::waitpid(output.childPid, &status, WNOHANG);
            const int waitError = errno;
            if(waitResult == 0)
                ProcessExecutionDetail::KillAndReapProcess(output.childPid);
            waitResultValue = static_cast<i64>(waitResult);
            waitReportedNoChild = waitError == ECHILD;
        }
#else
        static_cast<void>(binSh);
        static_cast<void>(cFlag);
        static_cast<void>(captureTimeoutMS);
#endif
    }

    if(!linuxSupported)
        return;

    ASSERT_GT(childPidValue, 0);
    EXPECT_EQ(waitResultValue, -1);
    EXPECT_TRUE(waitReportedNoChild);
}

void VerifyGlobal_CaptureProcessOutputReapsTruncatedChild(){
    const StringView binSh = s_GlobalProcessBinSh;
    const StringView cFlag = s_GlobalProcessCFlag;
    const u32 captureTimeoutMS = s_GlobalProcessCaptureTimeoutMS;
    b8 linuxSupported = false;
    b8 truncatedFailed = false;
    b8 outputMarkedTruncated = false;
    String capturedPrefix = "";
    u64 pidMaxLimit = 0u;

    native(in binSh, in cFlag, in captureTimeoutMS, mut linuxSupported, mut truncatedFailed, mut outputMarkedTruncated, mut capturedPrefix, mut pidMaxLimit){
#if defined(FOUNDATION_PLATFORM_LINUX) && !defined(FOUNDATION_PLATFORM_ANDROID)
        linuxSupported = true;
        pidMaxLimit = static_cast<u64>(Limit<pid_t>::s_Max);
        const Array<AStringView, 3u> argv = { binSh, cFlag, "printf '%s\\nxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx' \"$$\"; exec 1>&-; while :; do :; done" };
        NWB::Tests::TestArena<> testArena;
        NWB::Tests::TestAString output(testArena.arena);
        const auto captured = CaptureProcessOutput(output, testArena.arena, argv, 16u, 64u, captureTimeoutMS);
        truncatedFailed = !captured.has_value();
        if(!captured)
            outputMarkedTruncated = captured.error().outputTruncated;
        capturedPrefix.assign(AStringView(output));
#else
        static_cast<void>(binSh);
        static_cast<void>(cFlag);
        static_cast<void>(captureTimeoutMS);
#endif
    }

    if(!linuxSupported)
        return;

    ASSERT_TRUE(truncatedFailed);
    EXPECT_TRUE(outputMarkedTruncated);
    const StringView prefixView = capturedPrefix;
    const usize lineEnd = prefixView.find("\n");
    ASSERT_LT(lineEnd, prefixView.size());
    const Expected<u64> childPidParsed = ParseU64(prefixView.substr(0u, lineEnd));
    ASSERT_TRUE(childPidParsed.has_value());
    const u64 parsedPid = childPidParsed.value();
    ASSERT_GT(parsedPid, 0u);
    ASSERT_LE(parsedPid, pidMaxLimit);

    i64 waitResultValue = 0;
    b8 waitReportedNoChild = false;
    native(in parsedPid, mut waitResultValue, mut waitReportedNoChild){
#if defined(FOUNDATION_PLATFORM_LINUX) && !defined(FOUNDATION_PLATFORM_ANDROID)
        const pid_t childPid = static_cast<pid_t>(parsedPid);
        int status = 0;
        errno = 0;
        const pid_t waitResult = ::waitpid(childPid, &status, WNOHANG);
        const int waitError = errno;
        if(waitResult == 0)
            ProcessExecutionDetail::KillAndReapProcess(childPid);
        waitResultValue = static_cast<i64>(waitResult);
        waitReportedNoChild = waitError == ECHILD;
#else
        static_cast<void>(parsedPid);
#endif
    }

    EXPECT_EQ(waitResultValue, -1);
    EXPECT_TRUE(waitReportedNoChild);
}

void VerifyGlobal_CaptureProcessOutputTimesOutWithContinuousOutput(){
    const StringView binSh = s_GlobalProcessBinSh;
    const StringView cFlag = s_GlobalProcessCFlag;
    const u32 continuousTimeoutMS = s_GlobalProcessContinuousOutputTimeoutMS;
    const u32 maxElapsedMS = s_GlobalProcessMaximumCaptureElapsedMS;
    b8 linuxSupported = false;
    b8 haveTimestamps = false;
    b8 timedOutMatched = false;
    u64 startMS = 0u;
    u64 finishMS = 0u;

    native(in binSh, in cFlag, in continuousTimeoutMS, mut linuxSupported, mut haveTimestamps, mut timedOutMatched, mut startMS, mut finishMS){
#if defined(FOUNDATION_PLATFORM_LINUX) && !defined(FOUNDATION_PLATFORM_ANDROID)
        linuxSupported = true;
        const Array<AStringView, 3u> argv = { binSh, cFlag, "while :; do printf x; done" };
        NWB::Tests::TestArena<> testArena;
        NWB::Tests::TestAString output(testArena.arena);
        const auto startMilliseconds = ProcessExecutionDetail::MonotonicMilliseconds();
        const auto captured = CaptureProcessOutput(output, testArena.arena, argv, 64u, 64u, continuousTimeoutMS);
        const auto finishMilliseconds = ProcessExecutionDetail::MonotonicMilliseconds();
        haveTimestamps = startMilliseconds.has_value() && finishMilliseconds.has_value();
        if(haveTimestamps){
            startMS = *startMilliseconds;
            finishMS = *finishMilliseconds;
        }
        timedOutMatched = !captured && captured.error().kind == ProcessCaptureFailureKind::TimedOut && captured.error().nativeError == ErrorCondition::timed_out;
#else
        static_cast<void>(binSh);
        static_cast<void>(cFlag);
        static_cast<void>(continuousTimeoutMS);
#endif
    }

    if(!linuxSupported)
        return;

    ASSERT_TRUE(haveTimestamps);
    EXPECT_TRUE(timedOutMatched);
    ASSERT_GE(finishMS, startMS);
    const u64 elapsedMS = finishMS - startMS;
    EXPECT_LT(elapsedMS, cast<u64>(maxElapsedMS));
}

void VerifyGlobal_RedirectedNonzeroExitAndInvalidArgumentsPreserveCapturedStreams(){
    const StringView binSh = s_GlobalProcessBinSh;
    const StringView cFlag = s_GlobalProcessCFlag;
    const StringView combinedFilename = s_GlobalProcessCombinedOutputFilename;
    const StringView boundedScript = StringView("printf stdout; printf stderr >&2; exit 23; printf ignored").substr(0u, 41u);
    b8 linuxSupported = false;
    b8 runSucceeded = false;
    i32 exitCodeValue = 0;
    b8 emptyRedirectAccepted = true;
    b8 readBackOk = false;
    String capturedCombined = "";
    b8 removedRoot = false;

    native(in binSh, in cFlag, in combinedFilename, in boundedScript, mut linuxSupported, mut runSucceeded, mut exitCodeValue, mut emptyRedirectAccepted, mut readBackOk, mut capturedCombined, mut removedRoot){
#if defined(FOUNDATION_PLATFORM_LINUX) && !defined(FOUNDATION_PLATFORM_ANDROID)
        linuxSupported = true;
        NWB::Tests::TestArena<> testArena;
        const ::Path<NWB::Core::Alloc::GlobalArena> root(testArena.arena, "global_test_artifacts/redirected_process");
        const ::Path<NWB::Core::Alloc::GlobalArena> outputPath = root / combinedFilename;
        ASSERT_TRUE(EnsureEmptyDirectory(root));
        ASSERT_TRUE(WriteTextFile(outputPath, AStringView("stale")));

        const Array<AStringView, 3u> argv = { binSh, cFlag, boundedScript };
#if defined(FOUNDATION_UNICODE)
        const auto outputPathText = PathToString<char>(testArena.arena, outputPath);
#else
        const AStringView outputPathText = outputPath.native();
#endif
        const auto exitCode = RunProcessRedirectedToFile(testArena.arena, argv, AStringView(outputPathText));
        runSucceeded = exitCode.has_value();
        if(exitCode)
            exitCodeValue = *exitCode;
        emptyRedirectAccepted = RunProcessRedirectedToFile(testArena.arena, {}, AStringView(outputPathText)).has_value();

        NWB::Tests::TestAString output;
        readBackOk = ReadTextFile(outputPath, output).has_value();
        capturedCombined.assign(AStringView(output));
        removedRoot = RemoveAllIfExists(root).has_value();
#else
        static_cast<void>(binSh);
        static_cast<void>(cFlag);
        static_cast<void>(combinedFilename);
        static_cast<void>(boundedScript);
#endif
    }

    if(!linuxSupported)
        return;

    ASSERT_TRUE(runSucceeded);
    EXPECT_EQ(exitCodeValue, 23);
    EXPECT_FALSE(emptyRedirectAccepted);
    ASSERT_TRUE(readBackOk);
    EXPECT_EQ(StringView(capturedCombined), StringView("stdoutstderr"));
    EXPECT_TRUE(removedRoot);
}

void VerifyGlobal_SharedLibraryAcceptsBoundedNamesAndRejectsInvalidSymbols(){
    b8 windowsSupported = false;
    b8 openedKernel = false;
    b8 resolvedPidMatches = false;
    b8 invalidSymbolRejected = false;
    b8 missingSymbolRejected = false;
    b8 remainedOpen = false;

    native(mut windowsSupported, mut openedKernel, mut resolvedPidMatches, mut invalidSymbolRejected, mut missingSymbolRejected, mut remainedOpen){
#if defined(FOUNDATION_PLATFORM_WINDOWS)
        windowsSupported = true;
        NWB::Tests::TestArena<> testArena;
        SharedLibrary library;
        constexpr TStringView s_LibraryName = FOUNDATION_TEXT("kernel32.dll.trailing");
        openedKernel = library.open(testArena.arena, s_LibraryName.substr(0u, 12u)).has_value();
        if(openedKernel){
            using CurrentProcessIdFn = DWORD(WINAPI*)();
            const auto currentProcessId = library.resolve<CurrentProcessIdFn>(testArena.arena, AStringView("GetCurrentProcessId.trailing").substr(0u, 19u));
            resolvedPidMatches = currentProcessId.has_value() && (*currentProcessId)() == ::GetCurrentProcessId();

            const Array<char, 3u> invalidSymbol = { 'G', '\0', 'e' };
            const auto invalid = library.resolve<CurrentProcessIdFn>(testArena.arena, AStringView(invalidSymbol));
            invalidSymbolRejected = !invalid && invalid.error().code == MakeErrorCode(ErrorCondition::invalid_argument);
            const auto missing = library.resolve<CurrentProcessIdFn>(testArena.arena, "nwb_missing_symbol_bec2119d19ec4c48");
            missingSymbolRejected = !missing && missing.error().code.value() != 0;
            remainedOpen = library.isOpen();
        }
#endif
    }

    if(!windowsSupported)
        return;

    ASSERT_TRUE(openedKernel);
    EXPECT_TRUE(resolvedPidMatches);
    EXPECT_TRUE(invalidSymbolRejected);
    EXPECT_TRUE(missingSymbolRejected);
    EXPECT_TRUE(remainedOpen);
}

void VerifyGlobal_SharedLibraryInvalidNamePreservesNativeFailureStatusWithoutOpening(){
    SharedLibrary library = SharedLibrary();
    b8 emptyNameRejected = false;
    b8 openAfterEmpty = true;
    b8 missingLibraryFailed = false;
    i32 missingErrorCode = 0;
    b8 nonWindowsBuild = false;
    StringView missingDetailView = StringView();

    native(mut library, mut emptyNameRejected, mut openAfterEmpty, mut missingLibraryFailed, mut missingErrorCode, mut nonWindowsBuild, mut missingDetailView){
        NWB::Tests::TestArena<> testArena;
        const auto invalid = library.open(testArena.arena, TStringView{});
        emptyNameRejected = !invalid && invalid.error().code == MakeErrorCode(ErrorCondition::invalid_argument);
        openAfterEmpty = library.isOpen();
        const auto missing = library.open(testArena.arena, FOUNDATION_TEXT("nwb_contract_missing_library_6ee251a68fe246b0"));
        missingLibraryFailed = !missing.has_value();
        if(!missing){
            missingErrorCode = missing.error().code.value();
#if !defined(FOUNDATION_PLATFORM_WINDOWS)
            nonWindowsBuild = true;
            missingDetailView = missing.error().detail.view();
#endif
        }
    }

    EXPECT_TRUE(emptyNameRejected);
    EXPECT_FALSE(openAfterEmpty);
    ASSERT_TRUE(missingLibraryFailed);
    EXPECT_NE(missingErrorCode, 0);
    if(nonWindowsBuild)
        EXPECT_FALSE(missingDetailView.empty());
    EXPECT_FALSE(library.isOpen());
}

void VerifyGlobal_MemoryMapLookupUsesHalfOpenRangesAndRejectsMissingAddresses(){
    const StringView mapsText = "00001000-00002000 r-xp 00000020 00:00 0 /tmp/first.so\n00003000-00004000 r--p 00000000 00:00 0 /tmp/second.so\n";
    Vector<LinuxProcessMemoryMapEntry> entries = Vector<LinuxProcessMemoryMapEntry>();
    entries.reserve(2u);
    ParseLinuxProcessMemoryMaps(mapsText, entries);
    ASSERT_EQ(entries.size(), 2u);

    const Expected<LinuxProcessMemoryMapEntry> first = FindLinuxProcessMemoryMapForAddress(entries, 0x1000u);
    const Expected<LinuxProcessMemoryMapEntry> last = FindLinuxProcessMemoryMapForAddress(entries, 0x3fffu);
    ASSERT_TRUE(first.has_value());
    ASSERT_TRUE(last.has_value());
    EXPECT_EQ(first.value().path, StringView("/tmp/first.so"));
    EXPECT_EQ(last.value().path, StringView("/tmp/second.so"));
    EXPECT_FALSE(FindLinuxProcessMemoryMapForAddress(entries, 0x2000u).has_value());
}

void VerifyGlobal_MemoryMapRejectsMalformedOffsetsWithoutDiscardingValidNeighbors(){
    const StringView mapsText = "1000-2000 r-xp 0 00:00 0 /valid\n2000-3000 r-xp invalid 00:00 0 /bad\n3000-4000 r-xp 10000000000000000 00:00 0 /overflow\n4000-5000 r--p 20 00:00 0\n";
    Vector<LinuxProcessMemoryMapEntry> entries = Vector<LinuxProcessMemoryMapEntry>();
    ParseLinuxProcessMemoryMaps(mapsText, entries);
    ASSERT_EQ(entries.size(), 2u);
    EXPECT_EQ(entries[0u].fileOffset, 0u);
    EXPECT_EQ(entries[1u].fileOffset, 0x20u);
    EXPECT_TRUE(entries[1u].path.empty());
    EXPECT_FALSE(FindLinuxProcessMemoryMapForAddress(entries, 0x2000u).has_value());
    EXPECT_FALSE(FindLinuxProcessMemoryMapForAddress(entries, 0x3000u).has_value());
}


