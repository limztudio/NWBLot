#include <impl/assets_model/asset.adhd>
#include <impl/assets_skeleton/asset.adhd>
#include <impl/ecs_mesh/skinning/system.adhd>
#include <impl/ecs_model/system.adhd>
#include <impl/ecs_model_renderer/model_renderer.adhd>
#include <impl/ecs_model/components.adhd>
#include <impl/ecs_skeleton/components.adhd>
#include "smoke_scene_helpers.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type SmokeModelRef = AssetRef<Model>;
type ModelObjectKindEnum = ModelObjectKind;

mut MeshSkinningSystem SmokeMeshSkinningSystemRef(mut World world){
    const Optional<mut MeshSkinningSystem> system = world.borrowSystem<MeshSkinningSystem>();
    return system.value();
}

b8 HasSmokeMeshSkinningSystem(mut World world){
    return world.borrowSystem<MeshSkinningSystem>().has_value();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


StringView DefaultSmokeSkinnedLabel(){
    return "SmokeSkinnedScene";
}

type SkeletonJointMatrixVector = Vector<f32x3x4>;

b8 SetSmokeSkeletonLocalJoints(in EntityID entity, in Span<f32x3x4> joints, mut World world){
    if(!world.hasComponent<SkeletonPoseComponent>(entity))
        return false;

    mut SkeletonPoseComponent pose = world.getComponent<SkeletonPoseComponent>(entity);
    if(pose.localJoints.size() != joints.size())
        return false;

    for(usize index = 0u; index < joints.size(); ++index)
        pose.localJoints[index] = joints[index];
    return true;
}

class SmokeTintedModelEntityResult{
    public EntityID entity = s_InvalidEntityId;
    public b8 tintApplied = false;
}

void AddSmokeSkinnedRenderSystems(mut World world, mut ProjectRuntimeContext context, in SmokeRenderQualitySettings baseSettings){
    const SmokeRenderSystems systems = CreateSmokeRenderSystems(world, context, baseSettings);
    world.addSystem<ModelSystem>(world, context.assetManager, CreateModelObjectRendererHooks());
    mut MeshSkinningSystem meshSkinningSystem = world.addSystem<MeshSkinningSystem>(world, context.graphics, context.assetManager, systems.mesh, context.shaderPathResolver);
    context.graphics.addRenderPassToBack(meshSkinningSystem);
    context.graphics.addRenderPassToBack(systems.renderer);
    mut FrameGraphRegistry registry = context.frameGraphRegistry;
    registry.registerContributor(systems.renderer);
}

void AddSmokeSkinnedRenderSystems(mut World world, mut ProjectRuntimeContext context){
    AddSmokeSkinnedRenderSystems(world, context, SmokeRenderQualitySettings());
}

Expected<SkeletonJointMatrixVector> LoadSmokeSkeletonBindJoints(
    in SmokeModelRef modelRef,
    in StringView projectName,
    in Name preferredSkeletonObject,
    in b8 requireInvertibleBindPose,
    mut AssetManager assetManager
){
    const auto loadedModel = assetManager.loadSync(Model::AssetTypeName(), modelRef.name());
    if(!loadedModel.has_value()){
        error("{}: failed to load model for skeleton bind joints", projectName);
        return MakeUnexpected(Failure());
    }
    assert(loadedModel.value().valid());
    const Optional<in Model> model = BorrowTypedAsset<Model>(loadedModel.value().deref());
    if(!model.has_value()){
        error("{}: loaded model has unexpected type", projectName);
        return MakeUnexpected(Failure());
    }
    in SkeletonObjectVector objects = model.value().skeletonObjects();
    usize selected = 0u;
    if(preferredSkeletonObject != s_NameNone){
        for(usize i = 0u; i < objects.size(); ++i){
            if(objects[i].name == preferredSkeletonObject){
                selected = i;
                break;
            }
        }
    }
    if(objects.empty() || !objects[selected].skeleton.valid()){
        error("{}: model has no skeleton object", projectName);
        return MakeUnexpected(Failure());
    }
    const auto loadedSkeleton = assetManager.loadSync(Skeleton::AssetTypeName(), objects[selected].skeleton.name());
    if(!loadedSkeleton.has_value()){
        error("{}: failed to load skeleton for bind joints", projectName);
        return MakeUnexpected(Failure());
    }
    assert(loadedSkeleton.value().valid());
    const Optional<in Skeleton> skeleton = BorrowTypedAsset<Skeleton>(loadedSkeleton.value().deref());
    if(!skeleton.has_value()){
        error("{}: loaded skeleton has unexpected type", projectName);
        return MakeUnexpected(Failure());
    }
    in JointVector joints = skeleton.value().joints();
    if(joints.empty()){
        error("{}: skeleton has no joints", projectName);
        return MakeUnexpected(Failure());
    }
    SkeletonJointMatrixVector bindJoints;
    bindJoints.reserve(joints.size());
    for(in SkeletonJoint joint : joints){
        if(requireInvertibleBindPose && !MatrixIsInvertibleAffine(MatrixSingle(joint.localBindPose), s_SkeletonAffineEpsilon, s_SkeletonJointDeterminantEpsilon)){
            error("{}: skeleton contains an invalid bind pose", projectName);
            return MakeUnexpected(Failure());
        }
        bindJoints.push_back(joint.localBindPose);
    }
    return bindJoints;
}

Expected<SkeletonJointMatrixVector> LoadSmokeSkeletonBindJoints(
    in SmokeModelRef modelRef,
    in Name preferredSkeletonObject,
    in b8 requireInvertibleBindPose,
    mut AssetManager assetManager
){
    return LoadSmokeSkeletonBindJoints(
        modelRef,
        DefaultSmokeSkinnedLabel(),
        preferredSkeletonObject,
        requireInvertibleBindPose,
        assetManager
    );
}

void DestroySmokeSkinnedRenderWorld(mut ProjectRuntimeContext context, mut NotNullUniquePtr<World> world){
    if(!world.owner())
        return;

    mut World liveWorld = SmokeWorldRef(world);
    context.graphics.removeRenderPass(SmokeMeshSkinningSystemRef(liveWorld));
    RemoveSmokeRendererSystem(context, liveWorld);
    FinishDestroyingSmokeWorld(context, world);
}

void SyncSmokeModelRuntimes(mut World world){
    const Optional<mut ModelSystem> models = world.borrowSystem<ModelSystem>();
    models.value().syncModelRuntimes();
}

SmokeTintedModelEntityResult CreateTintedModelEntity(
    in SmokeModelRef model,
    in SmokeMaterialRef material,
    in NameTextAscii materialInterfacePath,
    in VectorSingle colorTint,
    in VectorSingle position,
    in VectorSingle scale,
    mut World world
){
    const SmokeTintedEntitySetup setup = CreateSmokeTintedEntity(material, materialInterfacePath, position, scale, world);
    mut ModelComponent modelComponent = world.entity(setup.entity).addComponent<ModelComponent>();
    modelComponent.model = model;
    SmokeTintedModelEntityResult result = SmokeTintedModelEntityResult();
    result.entity = setup.entity;
    result.tintApplied = ApplySmokeMaterialTint(setup, colorTint, "runtime.color_tint", world);
    return result;
}

EntityID FindSpawnedModelObject(in EntityID owner, in Name objectName, in ModelObjectKindEnum objectKind, mut World world){
    for(in auto row : world.view<ModelObjectComponent>()){
        if(Get<1>(row).owner == owner && Get<1>(row).object == objectName && Get<1>(row).kind == objectKind)
            return Get<0>(row);
    }
    return s_InvalidEntityId;
}

void AnimateSkinningBenchmarkPoses(mut World world, in Span<EntityID> entities, in Span<f32x3x4> bindJoints, in f32 timeSeconds, in b8 staticPreview){
    for(usize entityIndex = 0u; entityIndex < entities.size(); ++entityIndex){
        const EntityID entity = entities[entityIndex];
        const u32 seedIndex = cast<u32>(entityIndex);
        if(world.hasComponent<SkeletonPoseComponent>(entity)){
            mut SkeletonPoseComponent pose = world.getComponent<SkeletonPoseComponent>(entity);
            AnimateSkinningBenchmarkPoseJoints(bindJoints, seedIndex, timeSeconds, staticPreview, pose.localJoints);
        }
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
Expected<NotNullUniquePtr<World>> CreateSmokeSkinnedRenderWorld(in StringView projectName, in SmokeRenderQualitySettings baseSettings, mut ProjectRuntimeContext context){
    auto created = CreateSmokeWorld(projectName, context);
    if(!created.has_value())
        return MakeUnexpected(Failure());
    mut NotNullUniquePtr<World> world = created.value();
    AddSmokeSkinnedRenderSystems(SmokeWorldRef(world), context, baseSettings);
    return TakeSmokeWorld(world);
}

[cpp_unwind]
Expected<NotNullUniquePtr<World>> CreateSmokeSkinnedRenderWorld(in StringView projectName, mut ProjectRuntimeContext context){
    return CreateSmokeSkinnedRenderWorld(projectName, SmokeRenderQualitySettings(), context);
}


