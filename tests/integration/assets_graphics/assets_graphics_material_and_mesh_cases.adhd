void VerifyAssetsGraphics_MaterialMetadataRejectsEngineRootedPolicySelectors(){
    if(AssetsGraphicsTestConfigurationName() != "fin")
        return;

    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_ReportOnly);
    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_MaterialScratchArena);

    Vector<MaterialPolicyRejectionCase> cases = Vector<MaterialPolicyRejectionCase>();
    cases.reserve(4u);
    cases.push_back(MaterialPolicyRejectionCase(
        "material asset;\n\nasset.interface = \"engine/material_interfaces/test_surface.bind\";\nasset.bxdf = \"project/shaders/material_bxdf.bxdf\";\nasset.transparent = 0;\nasset.two_sided = 0;\nasset.refractive = 0;\n\nasset.shaders = {\n    \"mesh\": \"project/shaders/material_mesh\",\n    \"ps\": \"project/shaders/material_ps\",\n};\nasset.shader_variant = \"default\";\n",
        "interface must use the project/ virtual root"
    ));
    cases.push_back(MaterialPolicyRejectionCase(
        "material asset;\n\nasset.interface = \"project/material_interfaces/test_surface.bind\";\nasset.surface = \"engine/shaders/surface.surface\";\nasset.bxdf = \"project/shaders/material_bxdf.bxdf\";\nasset.transparent = 0;\nasset.two_sided = 0;\nasset.refractive = 0;\nasset.shader_variant = \"default\";\n",
        "field 'surface' must use the project/ virtual root"
    ));
    cases.push_back(MaterialPolicyRejectionCase(
        "material asset;\n\nasset.interface = \"project/material_interfaces/test_surface.bind\";\nasset.bxdf = \"engine/shaders/material_bxdf.bxdf\";\nasset.transparent = 0;\nasset.two_sided = 0;\nasset.refractive = 0;\n\nasset.shaders = {\n    \"mesh\": \"project/shaders/material_mesh\",\n    \"ps\": \"project/shaders/material_ps\",\n};\nasset.shader_variant = \"default\";\n",
        "field 'bxdf' must use the project/ virtual root"
    ));
    cases.push_back(MaterialPolicyRejectionCase(
        "material asset;\n\nasset.interface = \"project/material_interfaces/test_surface.bind\";\nasset.bxdf = \"project/shaders/material_bxdf.bxdf\";\nasset.transparent = 0;\nasset.two_sided = 0;\nasset.refractive = 0;\n\nasset.shaders = {\n    \"mesh\": \"engine/graphics/mesh/shared_ms\",\n    \"ps\": \"project/shaders/material_ps\",\n};\nasset.shader_variant = \"default\";\n",
        "shader stage 'mesh' must use the project/ virtual root"
    ));

    for(in MaterialPolicyRejectionCase policyCase : cases){
        EXPECT_FALSE(CanParseMaterialMeta(policyCase.m_metaText, testArena, scratchArena));
        EXPECT_TRUE(SawCapturedError(logger, policyCase.m_diagnostic));
    }
    EXPECT_EQ(logger.errorCount(), 4u);
}

void VerifyAssetsGraphics_MaterialCodecTypedLayoutBoundary(){
    if(AssetsGraphicsTestConfigurationName() != "fin")
        return;

    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_MaterialScratchArena);
    MaterialAsset material(testArena.arena);

    {
        CapturingLogger logger = CapturingLogger();
        LoggerRegistrationGuard loggerRegistrationGuard(logger, s_ReportOnly);
        Expected<MaterialAsset> built = BuildTestMaterialFromBindAndMeta(s_MinimalMaterialBindSource, s_BlockScopedMaterialMeta, "material_codec_typed_layout_boundary", testArena, scratchArena);
        EXPECT_TRUE(built.has_value());
        if(!built.has_value())
            return;
        material = built.value();

        MaterialAssetCodec codec = MaterialAssetCodec();
        material.setTransparent(true);
        AssetBytes invalidBinary = MakeAssetBytes(testArena);
        EXPECT_FALSE(SerializeMaterialAsset(codec, material, invalidBinary));
        EXPECT_TRUE(invalidBinary.empty());
        SetGeneratedMaterialAvboitPixelShaders(material);
        ASSERT_TRUE(CanRoundTripMaterialAssetCodec(material, testArena, codec));
        EXPECT_TRUE(SawCapturedError(logger, "AVBOIT pixel shaders must be present if and only if the material is transparent"));
        EXPECT_EQ(logger.errorCount(), 1u);
    }

    {
        CapturingLogger logger = CapturingLogger();
        LoggerRegistrationGuard loggerRegistrationGuard(logger, s_ReportOnly);
        MaterialAssetCodec codec = MaterialAssetCodec();
        AssetBytes binary = MakeAssetBytes(testArena);
        EXPECT_TRUE(SerializeMaterialAsset(codec, material, binary));

        const Expected<MaterialBinaryTypedLayoutOffsets> typedLayoutOffsets = FindTestMaterialBinaryTypedLayoutOffsets(binary);
        ASSERT_TRUE(typedLayoutOffsets.has_value());
        const usize layoutHashOffset = typedLayoutOffsets.value().layoutHashOffset;
        const usize blockByteCountOffset = typedLayoutOffsets.value().blockByteCountOffset;

        AssetBytes retiredFixtureLayoutBinary = MakeAssetBytes(testArena);
        CopyAssetBytes(binary, retiredFixtureLayoutBinary);
        EXPECT_TRUE(OverwriteU32InAssetBytes(0u, 0x4D544C39u, retiredFixtureLayoutBinary));
        RejectMaterialCodecBinary(codec, material.virtualPath(), retiredFixtureLayoutBinary, testArena);

        AssetBytes hashMismatchBinary = MakeAssetBytes(testArena);
        CopyAssetBytes(binary, hashMismatchBinary);
        u64 invalidLayoutHash = material.typedLayoutHash() + 1u;
        if(material.typedLayoutHash() == u64.max)
            invalidLayoutHash = material.typedLayoutHash() - 1u;
        EXPECT_TRUE(OverwriteU64InAssetBytes(layoutHashOffset, invalidLayoutHash, hashMismatchBinary));
        RejectMaterialCodecBinary(codec, material.virtualPath(), hashMismatchBinary, testArena);

        AssetBytes byteSizeMismatchBinary = MakeAssetBytes(testArena);
        CopyAssetBytes(binary, byteSizeMismatchBinary);
        EXPECT_FALSE(material.typedBlockBytes().empty());
        EXPECT_TRUE(OverwriteU32InAssetBytes(blockByteCountOffset, cast<u32>(material.typedBlockBytes().size() - 1u), byteSizeMismatchBinary));
        RejectMaterialCodecBinary(codec, material.virtualPath(), byteSizeMismatchBinary, testArena);

        ASSERT_GE(binary.size(), s_AvboitPixelShaderEntryBytes * 3u);
        const usize occupancyPresenceOffset = binary.size() - s_AvboitPixelShaderEntryBytes * 2u;
        AssetBytes missingOccupancyBinary = MakeAssetBytes(testArena);
        CopyAssetBytes(binary, missingOccupancyBinary);
        EXPECT_TRUE(OverwriteU32InAssetBytes(occupancyPresenceOffset, 0u, missingOccupancyBinary));
        EraseAssetByteRange(missingOccupancyBinary, occupancyPresenceOffset + 4u, occupancyPresenceOffset + s_AvboitPixelShaderEntryBytes);
        RejectMaterialCodecBinary(codec, material.virtualPath(), missingOccupancyBinary, testArena);

        EXPECT_EQ(logger.errorCount(), 4u);
        EXPECT_TRUE(SawCapturedError(logger, "typed layout hash mismatch"));
        EXPECT_TRUE(SawCapturedError(logger, "typed block byte count does not match typed layout"));
        EXPECT_TRUE(SawCapturedError(logger, "AVBOIT pixel shaders must be present if and only if the material is transparent"));
    }
}

void VerifyAssetsGraphics_MaterialFailedReloadPreservesTypedLayoutStagesFlagsAndAvboitReferences(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_MaterialScratchArena);

    MaterialAsset material(testArena.arena);
    {
        Expected<MaterialAsset> built = BuildTestMaterialFromBindAndMeta(s_MinimalMaterialBindSource, s_BlockScopedMaterialMeta, "material_reload_admission", testArena, scratchArena);
        ASSERT_TRUE(built.has_value());
        material = built.value();
    }
    material.setTransparent(true);
    material.setTwoSided(true);
    SetReloadMaterialAvboitPixelShaders(material);

    MaterialAssetCodec codec = MaterialAssetCodec();
    AssetBytes binary = MakeAssetBytes(testArena);
    ASSERT_TRUE(SerializeMaterialAsset(codec, material, binary));
    ASSERT_TRUE(LoadMaterialAssetBinary(material, binary));

    for(usize prefix = 0u; prefix < binary.size(); ++prefix){
        const ScopedTestTrace trace(prefix);
        AssetBytes malformed = MakeAssetBytes(testArena);
        CopyAssetBytes(binary, malformed);
        malformed.resize(prefix);
        EXPECT_FALSE(LoadMaterialAssetBinary(material, malformed));
        AssetBytes retained = MakeAssetBytes(testArena);
        ASSERT_TRUE(SerializeMaterialAsset(codec, material, retained));
        EXPECT_EQ(retained, binary);
    }

    const Expected<MaterialBinaryTypedLayoutOffsets> layoutOffsets = FindTestMaterialBinaryTypedLayoutOffsets(binary);
    ASSERT_TRUE(layoutOffsets.has_value());

    // First stage entry follows block bytes, resource references, and stage count.
    const usize firstStageOffset = layoutOffsets.value().blockByteCountOffset + 4u + material.typedBlockBytes().size() + 4u + material.resourceReferences().size() * s_MaterialResourceReferenceBytes + 4u;
    for(u32 invalidCase = 0u; invalidCase < 5u; ++invalidCase){
        const ScopedTestTrace trace(invalidCase);
        AssetBytes malformed = MakeAssetBytes(testArena);
        CopyAssetBytes(binary, malformed);
        switch(invalidCase){
        case 0u:
            ASSERT_TRUE(OverwriteU32InAssetBytes(0u, 0u, malformed));
            break;
        case 1u:
            ASSERT_TRUE(OverwriteU64InAssetBytes(layoutOffsets.value().layoutHashOffset, 0ull, malformed));
            break;
        case 2u:
            ASSERT_TRUE(OverwriteU32InAssetBytes(binary.size() - s_AvboitPixelShaderEntryBytes, 2u, malformed));
            break;
        case 3u:
            malformed.push_back(0u);
            break;
        case 4u:
            // Materials only hold mesh and pixel stages.
            ASSERT_TRUE(OverwriteVertexStageInMaterialBytes(firstStageOffset, malformed));
            break;
        default: break;
        }
        EXPECT_FALSE(LoadMaterialAssetBinary(material, malformed));
        AssetBytes retained = MakeAssetBytes(testArena);
        ASSERT_TRUE(SerializeMaterialAsset(codec, material, retained));
        EXPECT_EQ(retained, binary);
    }
    EXPECT_EQ(logger.errorCount(), binary.size() + 5u);
    EXPECT_TRUE(SawCapturedError(logger, "is not a material stage"));
}

