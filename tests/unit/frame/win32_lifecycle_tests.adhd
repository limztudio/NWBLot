////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


GpuDescriptorHeapAbi MakeShaderlessHeapAbi(){
    GpuDescriptorHeapAbi heapAbi = GpuDescriptorHeapAbi();
    heapAbi.resourceSetIndex = 0u;
    heapAbi.samplerSetIndex = 1u;
    heapAbi.accelStructSetIndex = 2u;
    heapAbi.sampledImageBinding = 0u;
    heapAbi.storageImageBinding = 1u;
    heapAbi.sampledBufferBinding = 2u;
    heapAbi.storageBufferBinding = 3u;
    heapAbi.uniformBufferBinding = 4u;
    heapAbi.sampledImage2DArrayBinding = 5u;
    heapAbi.sampledImage3DBinding = 6u;
    heapAbi.sampledImage2DArrayUintBinding = 7u;
    heapAbi.sampledImageCubeBinding = 8u;
    heapAbi.samplerBinding = 0u;
    heapAbi.accelStructBinding = 0u;
    return heapAbi;
}

void CheckRenderPassCollection(mut GraphicsRuntime graphics){
    GlobalArena arena(s_OneOffNameTestsFrameRenderPassCollection);
    RenderPassCollection passes(arena);
    CollectionTestPass first(graphics);
    CollectionTestPass second(graphics);
    passes.addToBack(first, 64u, 64u, 1u);
    passes.addToBack(second, 64u, 64u, 1u);
    first.validationCount = 0u;
    second.validationCount = 0u;
    first.valid = false;
    EXPECT_FALSE(passes.validateResources(64u, 64u, 1u));
    EXPECT_EQ(first.validationCount, 1u);
    EXPECT_EQ(second.validationCount, 1u);

    first.valid = true;
    passes.addToBack(first, 64u, 64u, 1u);
    ASSERT_EQ(passes.passes().size(), 2u);
    native(in first, in second, in passes){
        EXPECT_EQ(passes.passes().front().get(), &second);
        EXPECT_EQ(passes.passes().back().get(), &first);
    }
    passes.remove(first);
    EXPECT_EQ(first.invalidationCount, 1u);
    EXPECT_EQ(passes.passes().size(), 1u);
}

void CheckInactiveLoop(in b8 renderUnfocused){
    const GpuDescriptorHeapAbi heapAbi = MakeShaderlessHeapAbi();
    CpuTaskSchedulerConfig cpuTasks = CpuTaskSchedulerConfig();
    cpuTasks.workerCount = 1u;

    native(in renderUnfocused, in heapAbi, in cpuTasks){
        (void)renderUnfocused;
        (void)heapAbi;
        (void)cpuTasks;
#if defined(NWB_PLATFORM_WINDOWS)
        FrameLifecycleTestsDetail::DrainQuitMessages();
        ScopeExit drainQuit([]()noexcept{ FrameLifecycleTestsDetail::DrainQuitMessages(); });
        const i32 screenWidth = GetSystemMetrics(SM_CXSCREEN);
        const i32 screenHeight = GetSystemMetrics(SM_CYSCREEN);
        if(screenWidth <= 0 || screenHeight <= 0)
            GTEST_SKIP() << "Native desktop unavailable; inactive-window loop remains unqualified";
        if(!AreDpiAwarenessContextsEqual(GetThreadDpiAwarenessContext(), DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2) && !SetProcessDpiAwarenessContext(DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2))
            GTEST_SKIP() << "Native DPI admission unavailable; inactive-window loop remains unqualified; native_code=" << GetLastError();

        const HINSTANCE instance = GetModuleHandle(nullptr);
        ASSERT_NE(instance, nullptr);
        LoopLogger logger;
        LoggerRegistrationGuard loggerGuard(logger, LoggerBreakPolicy::ReportOnly);
        Core::Frame frame(instance, 64u, 64u, cpuTasks);
        // Supply a generic descriptor heap layout for shaderless startup.
        ASSERT_TRUE(frame.graphics().setBindlessHeapAbi(heapAbi));
        if(!frame.init())
            GTEST_SKIP() << "Hidden Win32 frame or selected graphics startup unsupported; inactive-window loop remains unqualified; native_code=" << GetLastError();
        auto& nativeFrame = frame.data<Core::Common::WinFrame>();
        ASSERT_NE(nativeFrame.hwnd(), nullptr);
        ASSERT_FALSE(IsWindowVisible(nativeFrame.hwnd()));
        nativeFrame.setActive(false);
        if(renderUnfocused)
            CheckRenderPassCollection(frame.graphics());
        UnfocusedLoopRenderPass pass(frame.graphics());
        if(renderUnfocused)
            frame.graphics().addRenderPassToBack(pass);
        ScopeExit removePass([&]()noexcept{
            if(renderUnfocused)
                frame.graphics().removeRenderPass(pass);
        });
        ASSERT_EQ(frame.graphics().shouldRenderUnfocused(), renderUnfocused);
        FrameLifecycleTestsDetail::LoopCallbackState callback{ frame };
        frame.setProjectUpdateCallback(&FrameLifecycleTestsDetail::RequestQuitOnUpdate, &callback);
        const DWORD mainThread = GetCurrentThreadId();
        Atomic<b8> watchdogFired{ false };
        Atomic<DWORD> watchdogPostError{ ERROR_SUCCESS };
        // The bounded quit keeps the old blocking loop a normal assertion failure.
        JoiningThread watchdog([&](const StopToken& stop)noexcept{
            const ULONGLONG deadline = GetTickCount64() + s_FrameTestInactiveLoopWatchdogMS;
            while(!stop.stop_requested() && GetTickCount64() < deadline)
                SleepMS(s_FrameTestWatchdogPollMS);
            if(stop.stop_requested())
                return;
            watchdogFired.store(true, MemoryOrder::relaxed);
            if(!PostThreadMessage(mainThread, WM_QUIT, 0u, 0)){
                watchdogPostError.store(GetLastError(), MemoryOrder::relaxed);
                if(!PostMessage(nativeFrame.hwnd(), WM_CLOSE, 0u, 0))
                    TerminateInvariant();
            }
        });
        const b8 loopSucceeded = frame.mainLoop();
        watchdog.request_stop();
        watchdog.join();
        EXPECT_TRUE(loopSucceeded);
        EXPECT_EQ(watchdogPostError.load(MemoryOrder::relaxed), static_cast<DWORD>(ERROR_SUCCESS));
        EXPECT_EQ(callback.callbacks, renderUnfocused ? 1u : 0u);
        EXPECT_EQ(watchdogFired.load(MemoryOrder::relaxed), !renderUnfocused);
        EXPECT_EQ(frame.graphics().getFrameIndex(), 0u);
#endif
    }
}

void VerifyFrameWindowDimensions_LogicalDimensionsRemainPositiveAtLargestNativeScale(){
    EXPECT_EQ(LogicalDimensionForPixels(2u, i32.max), 1);
    EXPECT_EQ(LogicalDimensionForPixels(u16.max, i32.max), 1);
    EXPECT_EQ(LogicalDimensionForPixels(u16.max, 1), cast<i32>(u16.max));
    EXPECT_EQ(LogicalDimensionForPixels(5u, 2), 3);
    EXPECT_EQ(LogicalDimensionForPixels(0u, i32.max), 1);
    EXPECT_EQ(LogicalDimensionForPixels(5u, 0), 5);
}

void VerifyFrameWin32Lifecycle_ThrowingClampObserverReleasesNativeClassBeforeLaterInitialization(){
    CpuTaskSchedulerConfig cpuTasks = CpuTaskSchedulerConfig();
    cpuTasks.workerCount = 1u;

    native(in cpuTasks){
        (void)cpuTasks;
#if defined(NWB_PLATFORM_WINDOWS)
        const i32 screenWidth = GetSystemMetrics(SM_CXSCREEN);
        const i32 screenHeight = GetSystemMetrics(SM_CYSCREEN);
        if(screenWidth <= 0 || screenHeight <= 0 || screenWidth >= static_cast<i32>(s_MaxU16) || screenHeight >= static_cast<i32>(s_MaxU16))
            GTEST_SKIP() << "Native desktop cannot provide the bounded oversize client clamp trigger; class unwind remains unqualified: " << screenWidth << "x" << screenHeight;
        if(!AreDpiAwarenessContextsEqual(GetThreadDpiAwarenessContext(), DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2) && !SetProcessDpiAwarenessContext(DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2)){
            const DWORD nativeError = GetLastError();
            GTEST_SKIP() << "Native desktop DPI admission unavailable; class unwind remains unqualified; native_code=" << nativeError;
        }

        const HINSTANCE instance = GetModuleHandle(nullptr);
        ASSERT_NE(instance, nullptr);
        ThrowingClampLogger logger;
        LoggerRegistrationGuard loggerGuard(logger);
        for(u32 attempt = 0u; attempt < s_FrameTestInitializationAttempts; ++attempt){
            WNDCLASSEX before{};
            before.cbSize = sizeof(before);
            const b8 existed = GetClassInfoEx(instance, FrameLifecycleTestsDetail::s_FrameClassName.data(), &before) != FALSE;
            const DWORD beforeError = existed ? ERROR_SUCCESS : GetLastError();
            ASSERT_FALSE(existed);
            ASSERT_EQ(beforeError, static_cast<DWORD>(ERROR_CLASS_DOES_NOT_EXIST));

            const int result = InvokeTerminalEntry<FrameLifecycleTestsDetail::ClampObserverFailure>([&]()->int{
                Core::Frame frame(instance, static_cast<u16>(s_MaxU16), static_cast<u16>(s_MaxU16), cpuTasks);
                return frame.init() ? 0 : 1;
            }, [](const FrameLifecycleTestsDetail::ClampObserverFailure&)noexcept{ return s_FrameTestClampObserverFailure; }, []()noexcept{ return s_FrameTestUnexpectedFailure; });
            ASSERT_EQ(result, s_FrameTestClampObserverFailure);
            ASSERT_EQ(logger.clampCount(), attempt + 1u);

            WNDCLASSEX after{};
            after.cbSize = sizeof(after);
            const b8 retained = GetClassInfoEx(instance, FrameLifecycleTestsDetail::s_FrameClassName.data(), &after) != FALSE;
            const DWORD afterError = retained ? ERROR_SUCCESS : GetLastError();
            EXPECT_FALSE(retained);
            EXPECT_EQ(afterError, static_cast<DWORD>(ERROR_CLASS_DOES_NOT_EXIST));
        }
#endif
    }
}

void VerifyFrameWin32Lifecycle_InactiveWindowRunsAnUpdateForAnUnfocusedRenderPass(){
    CheckInactiveLoop(true);
}

void VerifyFrameWin32Lifecycle_InactiveWindowWithoutUnfocusedRenderPassWaitsForQuit(){
    CheckInactiveLoop(false);
}

native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace FrameLifecycleTestsDetail{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void ThrowingClampLogger::record(const TStringView text){
    if(text.find(s_ClampMessage) == TStringView::npos)
        return;
    ++m_clampCount;
    throw ClampObserverFailure{};
}

void LoopLogger::Record(const Core::Common::LogString& text, const Core::Common::LogType::Enum type){
    if(type >= Core::Common::LogType::Warning)
        NWB_TCERR << text.data() << NWB_TEXT("\n");
}

b8 CollectionTestPass::validateResources(u32, u32, u32){
    ++validationCount;
    return valid;
}

b8 RequestQuitOnUpdate(void* userData, [[maybe_unused]] const f32 delta){
    auto& state = *MakeNotNull(static_cast<LoopCallbackState*>(userData));
    ++state.callbacks;
    state.frame.requestQuit();
    return true;
}

#if defined(NWB_PLATFORM_WINDOWS)
void DrainQuitMessages()noexcept{
    MSG message{};
    while(PeekMessage(&message, nullptr, WM_QUIT, WM_QUIT, PM_REMOVE)){}
}
#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


