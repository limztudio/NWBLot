namespace NWB::Tests::Smoke{

class UiLayerResizeRenderPass final : public Core::IRenderPass{
public:
    explicit UiLayerResizeRenderPass(Core::GraphicsRuntime& graphics)noexcept
        : Core::IRenderPass(graphics)
    {}

    virtual b8 shouldRenderUnfocused()noexcept override{
        return true;
    }
};

[[nodiscard]] inline NotNullUniquePtr<Core::ECS::World> TakeUiLayerSmokeWorld(NotNullUniquePtr<Core::ECS::World>& world)noexcept{
    return Move(world);
}

[[nodiscard]] inline Expected<NotNullUniquePtr<Core::ECS::World>> FinalizeUiLayerSmokeWorld(UniquePtr<Core::ECS::World> world)noexcept{
    if(!world)
        return MakeUnexpected(Failure{});
    return MakeNotNullUnique(Move(world));
}

};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class UiLayerSmokeModeFlags{
    public b8 windowSmoke = false;
    public b8 popupSmoke = false;
    public b8 popupToolsSmoke = false;
    public b8 nestedPopupSmoke = false;
    public b8 radioGroupSmoke = false;
    public b8 sliderSmoke = false;
    public b8 progressSmoke = false;
    public b8 imageSmoke = false;
    public b8 textureImageSmoke = false;
    public b8 textAreaSmoke = false;
    public b8 numericEditSmoke = false;
    public b8 listSmoke = false;
    public b8 comboSmoke = false;
    public b8 searchComboSmoke = false;
    public b8 editSmoke = false;
    public b8 interactionSmoke = false;
    public b8 alternateSkin = false;
}


class UiDefaultSmokeScene{
    private UiTextSmokeSamples m_textSamples;
    private u32 m_paintFrame = 0u;

    public UiDefaultSmokeScene(mut GlobalArena arena);

    public void paint(mut UiPaintContext paintContext);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


UiDefaultSmokeScene::UiDefaultSmokeScene(mut GlobalArena arena){
    this.m_textSamples = UiTextSmokeSamples(arena);
}

void UiDefaultSmokeScene::paint(mut UiPaintContext paintContext){
    if(this.m_paintFrame < 3u){
        ++this.m_paintFrame;
        if(this.m_paintFrame <= 2u)
            return;
        [essential] info("UiLayerSmokeProject: deterministic solid, skin, alpha and nested clip geometry submitted");
    }
    PaintUiLayerSmokeScene(paintContext);
    if(!this.m_textSamples.paint(paintContext))
        error("UiLayerSmokeProject: text or glyph coverage painting failed");
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


UiLayerSmokeModeFlags ResolveUiLayerSmokeModes(){
    UiLayerSmokeModeFlags modes();
    modes.windowSmoke = IsUiLayerWindowSmokeEnabled();
    modes.popupSmoke = IsUiLayerPopupSmokeEnabled();
    modes.popupToolsSmoke = IsUiLayerPopupToolsSmokeEnabled();
    modes.nestedPopupSmoke = IsUiLayerNestedPopupSmokeEnabled();
    modes.radioGroupSmoke = IsUiLayerRadioGroupSmokeEnabled();
    modes.sliderSmoke = IsUiLayerSliderSmokeEnabled();
    modes.progressSmoke = IsUiLayerProgressSmokeEnabled();
    modes.imageSmoke = IsUiLayerImageSmokeEnabled();
    modes.textureImageSmoke = IsUiLayerTextureImageSmokeEnabled();
    modes.textAreaSmoke = ReadSmokeEnvironmentFlag("NWB_UI_LAYER_TEXT_AREA");
    modes.numericEditSmoke = IsUiLayerNumericEditSmokeEnabled();
    modes.listSmoke = IsUiLayerListSmokeEnabled();
    modes.comboSmoke = IsUiLayerComboSmokeEnabled();
    modes.searchComboSmoke = IsUiLayerSearchComboSmokeEnabled();
    modes.editSmoke = IsUiLayerEditSmokeEnabled();
    modes.interactionSmoke = IsUiLayerInteractionSmokeEnabled();
    modes.alternateSkin = (modes.windowSmoke && IsUiLayerWindowSkinSmokeEnabled())
        || (modes.popupSmoke && IsUiLayerPopupSkinSmokeEnabled())
        || (modes.listSmoke && IsUiLayerListSkinSmokeEnabled())
        || (modes.comboSmoke && IsUiLayerComboSkinSmokeEnabled())
        || (modes.searchComboSmoke && IsUiLayerSearchComboSkinSmokeEnabled())
        || (modes.popupToolsSmoke && IsUiLayerPopupToolsSkinSmokeEnabled())
        || (modes.nestedPopupSmoke && IsUiLayerNestedPopupSkinSmokeEnabled())
        || (modes.numericEditSmoke && IsUiLayerNumericEditSkinSmokeEnabled())
        || (modes.textAreaSmoke && ReadSmokeEnvironmentFlag("NWB_UI_LAYER_TEXT_AREA_SKIN"))
        || (modes.radioGroupSmoke && IsUiLayerRadioGroupSkinSmokeEnabled())
        || (modes.sliderSmoke && IsUiLayerSliderSkinSmokeEnabled())
        || (modes.progressSmoke && IsUiLayerProgressSkinSmokeEnabled())
        || (modes.imageSmoke && IsUiLayerImageSkinSmokeEnabled())
        || (modes.textureImageSmoke && IsUiLayerTextureImageSkinSmokeEnabled());
    return modes;
}

void LogSmokeSkinIfEnabled(in b8 enabled, in StringView tag, in b8 alternateSkin){
    if(!enabled)
        return;
    StringView skinName = "default";
    if(alternateSkin)
        skinName = "alternate";
    [essential] info("{}: skin={}", tag, skinName);
}

void LogActiveUiLayerSmokeSkins(in UiLayerSmokeModeFlags modes){
    LogSmokeSkinIfEnabled(modes.windowSmoke, "UiWindowSmoke", modes.alternateSkin);
    LogSmokeSkinIfEnabled(modes.popupSmoke, "UiPopupSmoke", modes.alternateSkin);
    LogSmokeSkinIfEnabled(modes.listSmoke, "UiListSmoke", modes.alternateSkin);
    LogSmokeSkinIfEnabled(modes.comboSmoke, "UiComboSmoke", modes.alternateSkin);
    LogSmokeSkinIfEnabled(modes.searchComboSmoke, "UiSearchComboSmoke", modes.alternateSkin);
    LogSmokeSkinIfEnabled(modes.popupToolsSmoke, "UiPopupToolsSmoke", modes.alternateSkin);
    LogSmokeSkinIfEnabled(modes.nestedPopupSmoke, "UiNestedPopupSmoke", modes.alternateSkin);
    LogSmokeSkinIfEnabled(modes.numericEditSmoke, "UiNumericEditSmoke", modes.alternateSkin);
    LogSmokeSkinIfEnabled(modes.textAreaSmoke, "UiTextAreaSmoke", modes.alternateSkin);
    LogSmokeSkinIfEnabled(modes.radioGroupSmoke, "UiRadioGroupSmoke", modes.alternateSkin);
    LogSmokeSkinIfEnabled(modes.sliderSmoke, "UiSliderSmoke", modes.alternateSkin);
    LogSmokeSkinIfEnabled(modes.progressSmoke, "UiProgressSmoke", modes.alternateSkin);
    LogSmokeSkinIfEnabled(modes.imageSmoke, "UiImageSmoke", modes.alternateSkin);
    LogSmokeSkinIfEnabled(modes.textureImageSmoke, "UiTextureImageSmoke", modes.alternateSkin);
}

b8 CheckUiLayerSmokePersistentState(mut ProjectRuntimeContext context){
    b8 passed = false;
    native(mut context, mut passed){
        Core::Alloc::ScratchArena scratch{Name(s_UiSmokeNameTestsUiLayerPersistentState)};
        Core::BufferDesc desc;
        desc.setDebugName(Name(s_UiSmokeNameTestsUiLayerPersistentStateBuffer)).setByteSize(16u);
        const auto first = context.graphics.createBuffer(desc);
        const auto second = context.graphics.createBuffer(desc);
        auto& device = context.graphics.getDevice();
        const auto list = device.createCommandList();
        if(first && second && list){
            Core::CommandListResourceStateHandoff state(context.objectArena);
            (*list)->open();
            (*list)->beginTrackingBufferState(first->get(), Core::ResourceStates::CopyDest);
            (*list)->beginTrackingBufferState(second->get(), Core::ResourceStates::CopyDest);
            (*list)->close(&state);
            const Core::GpuPhysicalQueueId queue = device.getPrimaryPhysicalQueue(Core::CommandQueue::Graphics);
            if(state.valid() && queue.valid() && !(*list)->commandRecordingFailed()){
                Core::GpuPersistentResourceStateCache cache(context.objectArena);
                Core::GpuPersistentResourceStateCache::Candidate candidate(cache);
                const Array<Core::BufferHandle, 2u> buffers{ *first, *second };
                if(
                    cache.buildFilteredBufferSubset(state, buffers, scratch, candidate)
                    && candidate.source() != nullptr
                    && !cache.valid()
                    && cache.buildFilteredBufferSubset(*candidate.source(), Span<const Core::BufferHandle>(buffers.data(), 1u), scratch, candidate)
                ){
                    const auto* filtered = candidate.source();
                    if(
                        filtered != nullptr
                        && filtered->coversBufferWithOwnership(first->get(), queue, {})
                        && !filtered->coversBufferWithOwnership(second->get(), queue, {})
                        && !cache.valid()
                        && cache.commit(candidate)
                        && !candidate.valid()
                        && cache.source() != nullptr
                    ){
                        passed = cache.source()->coversBufferWithOwnership(first->get(), queue, {})
                            && !cache.source()->coversBufferWithOwnership(second->get(), queue, {});
                    }
                }
            }
        }
    }
    return passed;
}

b8 ConfigureSmokeLayerInputProfile(mut GlobalArena arena, mut UiLayerSystem layer){
    if(!ReadSmokeEnvironmentFlag("NWB_UI_LAYER_INPUT_BINDINGS_SMOKE"))
        return true;
    b8 accepted = false;
    native(mut arena, mut layer, mut accepted){
        Impl::Ui::InputBindings defaults(arena);
        Impl::Ui::InputBindings::BindingVector bindings(arena);
        bindings.reserve(defaults.bindings().size() + 4u);
        for(const auto& binding : defaults.bindings()){
            if(binding.key != Core::Key::Tab)
                bindings.push_back(binding);
        }
        bindings.push_back({ .key = Core::Key::Q, .command = Impl::Ui::InputCommand::Activate });
        bindings.push_back({ .key = Core::Key::W, .command = Impl::Ui::InputCommand::Left });
        bindings.push_back({ .key = Core::Key::R, .command = Impl::Ui::InputCommand::FocusNext });
        bindings.push_back({ .key = Core::Key::T, .command = Impl::Ui::InputCommand::FocusPrevious });
        accepted = layer.setInputBindings(bindings);
    }
    if(!accepted){
        error("UiLayerSmokeProject: configured input profile was rejected");
        return false;
    }
    [essential] info("UiLayerSmokeProject: custom input profile Q=Activate W=Left R=FocusNext T=FocusPrevious Tab=unbound");
    return true;
}

void ConfigureSmokeLayerRecordingMode(mut UiLayerSystem layer){
    if(ReadSmokeEnvironmentFlag("NWB_UI_IR_REPLAY")){
        layer.setGpuCommandRecordingMode(GpuCommandRecordingMode::CommandIrReplay);
        [essential] info("UiLayerSmokeProject: command IR replay enabled");
    }
}

void SpawnManySmokeRootsIfEnabled(mut World world){
    if(!ReadSmokeEnvironmentFlag("NWB_UI_LAYER_MANY_ROOTS"))
        return;
    native(mut world){
        for(usize index = 0u; index < Impl::Ui::s_InputMaxTargets; ++index){
            auto root = world.createEntity();
            root.addComponent<Impl::UiPaintComponent>().paint = [](Impl::UiPaintContext&){};
        }
        auto lastRoot = world.createEntity();
        lastRoot.addComponent<Impl::UiPaintComponent>().paint = [](Impl::UiPaintContext& paintContext){
            const Core::ECS::EntityID id = paintContext.entity;
            NWB_LOGGER_ESSENTIAL_INFO(NWB_TEXT("UiLayerSmokeProject: root beyond target limit painted"));
            paintContext.world.destroyEntity(id);
            if(paintContext.world.entity(id).alive())
                NWB_LOGGER_ERROR(NWB_TEXT("UiLayerSmokeProject: root removal during paint failed"));
            else
                NWB_LOGGER_ESSENTIAL_INFO(NWB_TEXT("UiLayerSmokeProject: root removed during paint"));
        };
    }
}

void AttachUiLayerSmokeScene(mut ProjectRuntimeContext context, mut World world, in UiLayerSmokeModeFlags modes){
    native(mut context, mut world, in modes){
        auto entity = world.createEntity();
        auto& paint = entity.addComponent<Impl::UiPaintComponent>();
        if(modes.textureImageSmoke){
            const auto scene = CreateSmokeInputSceneBox<UiTextureImageSmokeScene>(context.objectArena, context.input, context.objectArena, context.assetManager);
            paint.paint = [scene](Impl::UiPaintContext& paintContext){
                if(!scene->paint(paintContext))
                    NWB_LOGGER_ERROR(NWB_TEXT("UiLayerSmokeProject: texture-image UI paint failed"));
            };
        }
        else if(modes.imageSmoke){
            const auto scene = CreateSmokeInputSceneBox<UiImageSmokeScene>(context.objectArena, context.input);
            paint.paint = [scene](Impl::UiPaintContext& paintContext){
                if(!scene->paint(paintContext))
                    NWB_LOGGER_ERROR(NWB_TEXT("UiLayerSmokeProject: image UI paint failed"));
            };
        }
        else if(modes.progressSmoke){
            const auto scene = CreateSmokeInputSceneBox<UiProgressSmokeScene>(context.objectArena, context.input);
            paint.paint = [scene](Impl::UiPaintContext& paintContext){
                if(!scene->paint(paintContext))
                    NWB_LOGGER_ERROR(NWB_TEXT("UiLayerSmokeProject: progress UI paint failed"));
            };
        }
        else if(modes.sliderSmoke){
            const auto scene = CreateSmokeInputSceneBox<UiSliderSmokeScene>(context.objectArena, context.input);
            paint.paint = [scene](Impl::UiPaintContext& paintContext){
                if(!scene->paint(paintContext))
                    NWB_LOGGER_ERROR(NWB_TEXT("UiLayerSmokeProject: slider UI paint failed"));
            };
        }
        else if(modes.radioGroupSmoke){
            const auto scene = CreateSmokeInputSceneBox<UiRadioGroupSmokeScene>(context.objectArena, context.input);
            paint.paint = [scene](Impl::UiPaintContext& paintContext){
                if(!scene->paint(paintContext))
                    NWB_LOGGER_ERROR(NWB_TEXT("UiLayerSmokeProject: radio group UI paint failed"));
            };
        }
        else if(modes.textAreaSmoke){
            const auto scene = CreateSmokeSceneBox<UiTextAreaSmokeScene>(context.objectArena, context.objectArena, context.clipboard);
            paint.paint = [scene](Impl::UiPaintContext& paintContext){
                if(!scene->paint(paintContext))
                    NWB_LOGGER_ERROR(NWB_TEXT("UiLayerSmokeProject: text area UI paint failed"));
            };
        }
        else if(modes.numericEditSmoke){
            const auto scene = CreateSmokeInputSceneBox<UiNumericEditSmokeScene>(context.objectArena, context.input, context.objectArena);
            paint.paint = [scene](Impl::UiPaintContext& paintContext){
                if(!scene->paint(paintContext))
                    NWB_LOGGER_ERROR(NWB_TEXT("UiLayerSmokeProject: numeric editor UI paint failed"));
            };
        }
        else if(modes.nestedPopupSmoke){
            const auto scene = CreateSmokeInputSceneBox<UiNestedPopupSmokeScene>(context.objectArena, context.input, context.objectArena);
            paint.paint = [scene](Impl::UiPaintContext& paintContext){
                if(!scene->paint(paintContext))
                    NWB_LOGGER_ERROR(NWB_TEXT("UiLayerSmokeProject: nested popup UI paint failed"));
            };
        }
        else if(modes.popupToolsSmoke){
            const auto scene = CreateSmokeInputSceneBox<UiPopupToolsSmokeScene>(context.objectArena, context.input, context.objectArena);
            paint.paint = [scene](Impl::UiPaintContext& paintContext){
                if(!scene->paint(paintContext))
                    NWB_LOGGER_ERROR(NWB_TEXT("UiLayerSmokeProject: tooltip/context menu UI paint failed"));
            };
        }
        else if(modes.searchComboSmoke){
            const auto scene = CreateSmokeInputSceneBox<UiSearchComboSmokeScene>(context.objectArena, context.input, context.objectArena);
            paint.paint = [scene](Impl::UiPaintContext& paintContext){
                if(!scene->paint(paintContext))
                    NWB_LOGGER_ERROR(NWB_TEXT("UiLayerSmokeProject: searchable combo UI paint failed"));
            };
        }
        else if(modes.comboSmoke){
            const auto scene = CreateSmokeInputSceneBox<UiComboSmokeScene>(context.objectArena, context.input);
            paint.paint = [scene](Impl::UiPaintContext& paintContext){
                if(!scene->paint(paintContext))
                    NWB_LOGGER_ERROR(NWB_TEXT("UiLayerSmokeProject: combo UI paint failed"));
            };
        }
        else if(modes.listSmoke){
            const auto scene = CreateSmokeInputSceneBox<UiListSmokeScene>(context.objectArena, context.input);
            paint.paint = [scene](Impl::UiPaintContext& paintContext){
                if(!scene->paint(paintContext))
                    NWB_LOGGER_ERROR(NWB_TEXT("UiLayerSmokeProject: virtual list paint failed"));
            };
        }
        else if(modes.popupSmoke){
            const auto scene = CreateSmokeInputSceneBox<UiPopupSmokeScene>(context.objectArena, context.input, context.objectArena);
            paint.paint = [scene](Impl::UiPaintContext& paintContext){
                if(!scene->paint(paintContext))
                    NWB_LOGGER_ERROR(NWB_TEXT("UiLayerSmokeProject: popup UI paint failed"));
            };
            auto laterEntity = world.createEntity();
            auto& laterPaint = laterEntity.addComponent<Impl::UiPaintComponent>();
            laterPaint.order = 100;
            laterPaint.paint = [scene](Impl::UiPaintContext& paintContext){
                if(!scene->scene.paintLaterRoot(paintContext))
                    NWB_LOGGER_ERROR(NWB_TEXT("UiLayerSmokeProject: later popup root paint failed"));
            };
        }
        else if(modes.editSmoke){
            const auto scene = CreateSmokeInputSceneBox<UiEditSmokeScene>(context.objectArena, context.input, context.objectArena);
            paint.paint = [scene](Impl::UiPaintContext& paintContext){
                if(!scene->paint(paintContext))
                    NWB_LOGGER_ERROR(NWB_TEXT("UiLayerSmokeProject: edit UI paint failed"));
            };
        }
        else if(modes.windowSmoke){
            const auto scene = CreateSmokeSceneBox<UiWindowSmokeScene>(context.objectArena);
            paint.paint = [scene](Impl::UiPaintContext& paintContext){
                if(!scene->paint(paintContext))
                    NWB_LOGGER_ERROR(NWB_TEXT("UiLayerSmokeProject: window UI paint failed"));
            };
        }
        else if(modes.interactionSmoke){
            const auto scene = CreateSmokeSceneBox<UiInteractiveSmokeScene>(context.objectArena);
            paint.paint = [scene](Impl::UiPaintContext& paintContext){
                if(!scene->paint(paintContext))
                    NWB_LOGGER_ERROR(NWB_TEXT("UiLayerSmokeProject: interactive UI paint failed"));
            };
        }
        else{
            const auto scene = CreateSmokeSceneBox<UiDefaultSmokeScene>(context.objectArena, context.objectArena);
            paint.paint = [scene](Impl::UiPaintContext& paintContext){
                scene->scene.paint(paintContext);
            };
        }
    }
}

b8 InitUiLayerSmokeSystem(mut ProjectRuntimeContext context, mut UniquePtr<World> world, in b8 alternateSkin){
    b8 ok = false;
    native(mut context, mut world, in alternateSkin, mut ok){
        const Core::Assets::AssetRef<Impl::UiSkin> skin = alternateSkin
            ? Core::Assets::AssetRef<Impl::UiSkin>("alternate_skin")
            : Core::Assets::AssetRef<Impl::UiSkin>{};
        auto& layer = world->addSystem<Impl::UiLayerSystem>(
            *world,
            context.graphics,
            context.input,
            context.clipboard,
            context.textInput,
            context.assetManager,
            context.shaderPathResolver,
            skin,
            Impl::UiLayerPresentation::Standalone
        );
        if(ConfigureSmokeLayerInputProfile(context.objectArena, layer)){
            ConfigureSmokeLayerRecordingMode(layer);
            ok = true;
        }
    }
    return ok;
}

Expected<NotNullUniquePtr<World>> CreateUiLayerSmokeWorld(mut ProjectRuntimeContext context){
    b8 hasShaderResolver = false;
    native(in context, mut hasShaderResolver){
        hasShaderResolver = static_cast<b8>(context.shaderPathResolver);
    }
    if(!hasShaderResolver){
        error("UiLayerSmokeProject: shader path resolver is unavailable");
        return MakeUnexpected(Failure());
    }

    UniquePtr<World> world = UniquePtr<World>();
    b8 worldAllocated = false;
    native(mut context, mut world, mut worldAllocated){
        world = MakeUnique<Core::ECS::World>(context.objectArena, context.cpuTasks);
        worldAllocated = static_cast<b8>(world);
    }
    if(!worldAllocated){
        error("UiLayerSmokeProject: ECS world allocation failed");
        return MakeUnexpected(Failure());
    }

    const UiLayerSmokeModeFlags modes = ResolveUiLayerSmokeModes();
    LogActiveUiLayerSmokeSkins(modes);
    if(!InitUiLayerSmokeSystem(context, world, modes.alternateSkin))
        return MakeUnexpected(Failure());

    native(mut context, mut world, in modes){
        SpawnManySmokeRootsIfEnabled(*world);
        AttachUiLayerSmokeScene(context, *world, modes);
    }
    return FinalizeUiLayerSmokeWorld(world);
}

void ClearUiLayerSmokeWorld(mut ProjectRuntimeContext context, mut World world){
    b8 hasLayer = false;
    native(mut context, mut world, mut hasLayer){
        world.taskScope().wait();
        if(auto* const layer = world.getSystem<Impl::UiLayerSystem>()){
            context.graphics.removeRenderPass(*layer);
            hasLayer = true;
        }
    }
    if(!hasLayer)
        return;
    const b8 deviceIdle = context.graphics.waitForIdle();
    [essential] assert(deviceIdle || context.graphics.isDeviceLost(), "UI smoke teardown requires device idle or terminal loss");
    world.clear();
}

b8 ConfigureUiLayerSmokeStartup(
    mut ProjectRuntimeContext context,
    mut NotNullUniquePtr<World> world,
    mut UiLayerResizeRenderPass resizeRenderPass,
    mut b8 outResizeRenderPassRegistered,
    mut u64 outResizePresentationBaseline,
    mut UniquePtr<FramebufferCapture> outFramebufferCapture
){
    native(mut context, mut world){
        auto& layer = *MakeNotNull(world->getSystem<Impl::UiLayerSystem>());
        context.graphics.addRenderPassToBack(layer);
    }
    if(ReadSmokeEnvironmentFlag("NWB_UI_LAYER_RESIZE_RENDER")){
        outResizePresentationBaseline = context.graphics.getSuccessfulPresentationCount();
        context.graphics.addRenderPassToBack(resizeRenderPass);
        outResizeRenderPassRegistered = true;
    }
    FramebufferCaptureOptions captureOptions();
    if(ReadSmokeEnvironmentFlag("NWB_UI_LAYER_RESIZE_CAPTURE")){
        captureOptions.requiredWidth = 800u;
        captureOptions.requiredHeight = 600u;
    }
    b8 configured = false;
    native(mut context, in captureOptions, mut outFramebufferCapture, mut configured){
        auto capture = SmokeCaptureFactory(context).configure(NWB_TEXT("UiLayerSmokeProject"), s_DefaultCaptureFrameCount, captureOptions);
        if(capture){
            outFramebufferCapture = Move(*capture);
            configured = true;
        }
    }
    return configured;
}

b8 TickUiLayerSmokeWorld(in f32 delta, mut NotNullUniquePtr<World> world, mut UniquePtr<FramebufferCapture> framebufferCapture){
    b8 keepRunning = false;
    native(in delta, mut world, mut framebufferCapture, mut keepRunning){
        keepRunning = TickSmokeWorldWithCapture(delta, *world, framebufferCapture);
    }
    return keepRunning;
}

void StopUiLayerSmokeCaptureAndClearWorld(
    mut ProjectRuntimeContext context,
    mut NotNullUniquePtr<World> world,
    mut UniquePtr<FramebufferCapture> framebufferCapture
){
    native(mut context, mut world, mut framebufferCapture){
        if(framebufferCapture){
            framebufferCapture->stop();
            framebufferCapture.reset();
        }
        ClearUiLayerSmokeWorld(context, *world);
    }
}


