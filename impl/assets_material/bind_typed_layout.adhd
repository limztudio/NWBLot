Expected<u32x4u> TryBuildMaterialTypedLayoutDefaultValue(
    in Name materialName,
    in StringView instanceName,
    in StringView fieldName,
    in StringView fieldTypeText,
    in StringView defaultArgument,
    in MaterialLayoutFieldType fieldType
){
    if(IsMaterialLayoutResourceFieldType(fieldType))
        return u32x4u(0u, 0u, 0u, 0u);

    const Expected<CompactString> key = BuildMaterialBindParameterKey(instanceName, fieldName);
    if(!key.has_value()){
        error("Material bind typed layout: field '{}.{}' for '{}' exceeds ACompactString capacity", instanceName, fieldName, materialName.resolvedText());
        return MakeUnexpected(Failure());
    }

    CompactString defaultText;
    if(!defaultText.assign(defaultArgument)){
        error("Material bind typed layout: default for '{}.{}' in '{}' exceeds ACompactString capacity", instanceName, fieldName, materialName.resolvedText());
        return MakeUnexpected(Failure());
    }

    const Expected<MaterialTypedValueData> defaultParameter = ParseMaterialTypedValue(key.value().view(), defaultText.view());
    if(!defaultParameter.has_value()){
        error("Material bind typed layout: default '{}' for '{}.{}' in '{}' is invalid", defaultArgument, instanceName, fieldName, materialName.resolvedText());
        return MakeUnexpected(Failure());
    }

    const MaterialLayoutFieldType defaultFieldType = MaterialLayoutFieldTypeFromParameterType(cast<MaterialParameterValueType>(defaultParameter.value().meta.z), defaultParameter.value().meta.w);
    if(defaultFieldType != fieldType){
        error(
            "Material bind typed layout: default '{}' for '{}.{}' in '{}' does not match field type '{}'"
            , defaultArgument
            , instanceName
            , fieldName
            , materialName.resolvedText()
            , fieldTypeText
        );
        return MakeUnexpected(Failure());
    }

    return MaterialTypedValueToLayoutValue(defaultParameter.value());
}





b8 TryAppendMaterialBindTypedLayoutField(
    in StringView interfacePath,
    in Name contextName,
    in StringView instanceName,
    in StringView fieldName,
    in StringView fieldTypeText,
    in StringView defaultArgument,
    in MaterialBlockClass blockClass,
    in usize blockByteBegin,
    mut u32 inOutBlockByteSize,
    mut Vector<MaterialTypedLayoutField> inOutFields,
    mut Vector<u8> inOutBlockBytes
){
    const Expected<MaterialLayoutFieldType> fieldTypeResult = TryParseMaterialLayoutFieldTypeText(fieldTypeText);
    if(!fieldTypeResult.has_value()){
        error(
            "Material bind typed layout: interface '{}' field '{}.{}' has unsupported type '{}' for '{}'"
            , interfacePath
            , instanceName
            , fieldName
            , fieldTypeText
            , contextName.resolvedText()
        );
        return false;
    }
    const MaterialLayoutFieldType fieldType = fieldTypeResult.value();
    if(IsMaterialLayoutResourceFieldType(fieldType) && blockClass != MaterialBlockClass::MaterialConstant){
        error("Material bind typed layout: resource field '{}.{}' must use material-constant storage for '{}'", instanceName, fieldName, contextName.resolvedText());
        return false;
    }

    const u32 fieldByteSize = MaterialLayoutFieldByteSize(fieldType);
    const Expected<u32> fieldOffset = TryAlignMaterialLayoutFieldOffset(inOutBlockByteSize, fieldType);
    if(fieldByteSize == 0u || !fieldOffset.has_value() || fieldOffset.value() > u32.max - fieldByteSize){
        error("Material bind typed layout: interface '{}' block '{}' exceeds u32 byte size for '{}'", interfacePath, instanceName, contextName.resolvedText());
        return false;
    }

    MaterialTypedLayoutField field;
    const Expected<Name> parsedFieldName = TryParseMaterialBindName(fieldName);
    if(!parsedFieldName.has_value()){
        error(
            "Material bind typed layout: interface '{}' has invalid field '{}.{}' for '{}'"
            , interfacePath
            , instanceName
            , fieldName
            , contextName.resolvedText()
        );
        return false;
    }
    field.fieldName = parsedFieldName.value();
    field.fieldType = fieldType;
    field.offset = fieldOffset.value();
    const Expected<u32x4u> defaultValue = TryBuildMaterialTypedLayoutDefaultValue(
        contextName,
        instanceName,
        fieldName,
        fieldTypeText,
        defaultArgument,
        fieldType
    );
    if(!defaultValue.has_value())
        return false;
    field.defaultValue = defaultValue.value();
    if(cast<usize>(field.offset) > usize.max - blockByteBegin){
        error(
            "Material bind typed layout: interface '{}' field '{}.{}' could not append alignment padding for '{}'"
            , interfacePath
            , instanceName
            , fieldName
            , contextName.resolvedText()
        );
        return false;
    }
    MaterialBindStorage storage = MaterialBindStorage();
    storage.padMaterialTypedLayoutBytesTo(blockByteBegin + cast<usize>(field.offset), inOutBlockBytes);
    storage.appendMaterialTypedLayoutFieldBytes(fieldType, field.defaultValue, inOutBlockBytes);

    inOutFields.push_back(field);
    inOutBlockByteSize = fieldOffset.value() + fieldByteSize;
    return true;
}

b8 TryFinalizeMaterialBindTypedLayoutBlock(
    in StringView interfacePath,
    in Name contextName,
    in StringView instanceName,
    in usize blockByteBegin,
    mut MaterialTypedLayoutBlock inOutBlock,
    mut u32 inOutConstantTypedByteSize,
    mut Vector<MaterialTypedLayoutBlock> inOutBlocks,
    mut Vector<u8> inOutBlockBytes
){
    const Expected<u32> alignedBlockByteSize = TryAlignMaterialLayoutBlockByteSize(inOutBlock.byteSize);
    if(!alignedBlockByteSize.has_value()){
        error("Material bind typed layout: interface '{}' block '{}' exceeds u32 byte size for '{}'", interfacePath, instanceName, contextName.resolvedText());
        return false;
    }
    inOutBlock.byteSize = alignedBlockByteSize.value();
    if(cast<usize>(inOutBlock.byteSize) > usize.max - blockByteBegin){
        error("Material bind typed layout: interface '{}' block '{}' could not append alignment padding for '{}'", interfacePath, instanceName, contextName.resolvedText());
        return false;
    }
    MaterialBindStorage storage = MaterialBindStorage();
    storage.padMaterialTypedLayoutBytesTo(blockByteBegin + cast<usize>(inOutBlock.byteSize), inOutBlockBytes);

    inOutBlocks.push_back(inOutBlock);
    if(inOutBlock.blockClass == MaterialBlockClass::MaterialConstant){
        if(inOutBlock.byteSize > u32.max - inOutConstantTypedByteSize){
            error("Material bind typed layout: interface '{}' constant storage exceeds u32 byte size for '{}'", interfacePath, instanceName, contextName.resolvedText());
            return false;
        }
        inOutConstantTypedByteSize += inOutBlock.byteSize;
    }
    return true;
}

b8 IsMaterialBindNameLess(in StringView lhs, in StringView rhs){
    const usize minLen = Min(lhs.size(), rhs.size());
    for(usize i = 0u; i < minLen; ++i){
        const u8 a = cast<u8>(lhs[i]);
        const u8 b = cast<u8>(rhs[i]);
        if(a != b)
            return a < b;
    }
    return lhs.size() < rhs.size();
}

Expected<MaterialBlockClass> ParseMaterialBindBlockClass(in MaterialBindStruct bindStruct){
    if(bindStruct.hasAttribute(s_MaterialConstantAttribute))
        return MaterialBlockClass::MaterialConstant;
    if(bindStruct.hasAttribute(s_MaterialMutableAttribute))
        return MaterialBlockClass::MaterialMutable;
    return MakeUnexpected(Failure());
}

b8 BuildSortedMaterialBindInstanceIndices(
    in StringView interfaceVirtualPath,
    in Name contextName,
    in Span<MaterialBindInstance> instances,
    mut Vector<usize> outSortedIndices
){
    outSortedIndices.clear();
    if(instances.size() > cast<usize>(u32.max)){
        error("Material bind typed layout: interface '{}' exceeds supported block count for '{}'", interfaceVirtualPath, contextName.resolvedText());
        return false;
    }
    outSortedIndices.reserve(instances.size());
    for(usize i = 0u; i < instances.size(); ++i){
        usize insertPos = outSortedIndices.size();
        outSortedIndices.push_back(i);
        while(insertPos > 0u && IsMaterialBindNameLess(instances[i].name, instances[outSortedIndices[insertPos - 1u]].name)){
            outSortedIndices[insertPos] = outSortedIndices[insertPos - 1u];
            --insertPos;
        }
        outSortedIndices[insertPos] = i;
    }
    return true;
}

b8 AccumulateMaterialBindStructLayoutReserve(
    in StringView interfaceVirtualPath,
    in Name contextName,
    in MaterialBindStruct bindStruct,
    mut usize inOutFieldReserveCount,
    mut usize inOutByteReserveCount
){
    if(inOutFieldReserveCount > usize.max - bindStruct.fields.size()){
        error("Material bind typed layout: interface '{}' exceeds supported field count for '{}'", interfaceVirtualPath, contextName.resolvedText());
        return false;
    }
    inOutFieldReserveCount += bindStruct.fields.size();

    for(in MaterialBindField bindField : bindStruct.fields){
        usize fieldByteReserve = 16u;
        const Expected<MaterialLayoutFieldType> fieldType = TryParseMaterialLayoutFieldTypeText(bindField.type);
        if(fieldType.has_value()){
            const u32 fieldByteSize = MaterialLayoutFieldByteSize(fieldType.value());
            if(fieldByteSize != 0u)
                fieldByteReserve = cast<usize>(fieldByteSize);
        }

        if(inOutByteReserveCount > usize.max - fieldByteReserve){
            error("Material bind typed layout: interface '{}' exceeds supported byte count for '{}'", interfaceVirtualPath, contextName.resolvedText());
            return false;
        }
        inOutByteReserveCount += fieldByteReserve;
    }
    return true;
}

b8 ReserveMaterialBindTypedLayoutStorage(
    in StringView interfaceVirtualPath,
    in Name contextName,
    in Span<MaterialBindStruct> structs,
    in Span<MaterialBindInstance> instances,
    in Span<usize> sortedInstanceIndices,
    mut Vector<MaterialTypedLayoutBlock> outBlocks,
    mut Vector<MaterialTypedLayoutField> outFields,
    mut Vector<u8> outBlockBytes
){
    usize fieldReserveCount = 0u;
    usize byteReserveCount = 0u;
    for(in usize instanceIndex : sortedInstanceIndices){
        const Expected<usize> structIndex = FindMaterialBindStructIndex(structs, instances[instanceIndex].type);
        if(!structIndex.has_value())
            continue;
        if(!AccumulateMaterialBindStructLayoutReserve(
            interfaceVirtualPath,
            contextName,
            structs[structIndex.value()],
            fieldReserveCount,
            byteReserveCount
        ))
            return false;
    }

    outBlocks.reserve(sortedInstanceIndices.size());
    outFields.reserve(fieldReserveCount);
    outBlockBytes.reserve(byteReserveCount);
    return true;
}





b8 AppendMaterialBindInstanceTypedLayoutBlock(
    in StringView interfaceVirtualPath,
    in Name contextName,
    in MaterialBindInstance instance,
    in MaterialBindStruct bindStruct,
    mut u32 inOutConstantTypedByteSize,
    mut Vector<MaterialTypedLayoutBlock> outBlocks,
    mut Vector<MaterialTypedLayoutField> outFields,
    mut Vector<u8> outBlockBytes
){
    const Expected<MaterialBlockClass> blockClassResult = ParseMaterialBindBlockClass(bindStruct);
    if(!blockClassResult.has_value()){
        error(
            "Material bind typed layout: interface '{}' struct '{}' is missing a material block class for '{}'"
            , interfaceVirtualPath
            , bindStruct.name
            , contextName.resolvedText()
        );
        return false;
    }

    const MaterialBlockClass blockClass = blockClassResult.value();
    if(outFields.size() > cast<usize>(u32.max) || bindStruct.fields.size() > cast<usize>(u32.max)){
        error(
            "Material bind typed layout: interface '{}' block '{}' exceeds supported field count for '{}'"
            , interfaceVirtualPath
            , instance.name
            , contextName.resolvedText()
        );
        return false;
    }

    const usize blockByteBegin = outBlockBytes.size();

    MaterialTypedLayoutBlock block;
    const Expected<Name> blockName = TryParseMaterialBindName(instance.name);
    if(!blockName.has_value()){
        error("Material bind typed layout: interface '{}' has invalid block '{}' for '{}'", interfaceVirtualPath, instance.name, contextName.resolvedText());
        return false;
    }
    block.blockName = blockName.value();
    block.blockClass = blockClass;
    block.fieldBegin = cast<u32>(outFields.size());
    block.fieldCount = cast<u32>(bindStruct.fields.size());
    block.byteSize = 0u;

    for(in MaterialBindField bindField : bindStruct.fields){
        if(!TryAppendMaterialBindTypedLayoutField(
            interfaceVirtualPath,
            contextName,
            instance.name,
            bindField.name,
            bindField.type,
            bindField.defaultArgument(),
            blockClass,
            blockByteBegin,
            block.byteSize,
            outFields,
            outBlockBytes
        ))
            return false;
    }

    return TryFinalizeMaterialBindTypedLayoutBlock(
        interfaceVirtualPath,
        contextName,
        instance.name,
        blockByteBegin,
        block,
        inOutConstantTypedByteSize,
        outBlocks,
        outBlockBytes
    );
}

b8 BuildMaterialBindTypedLayoutData(
    in StringView interfaceVirtualPath,
    in Name contextName,
    in Span<MaterialBindStruct> structs,
    in Span<MaterialBindInstance> instances,
    mut u64 outLayoutHash,
    mut Vector<MaterialTypedLayoutBlock> outBlocks,
    mut Vector<MaterialTypedLayoutField> outFields,
    mut Vector<u8> outBlockBytes,
    mut HashMap<Name, MaterialBindTypedLayoutBlockLookupEntry> outBlockLookup,
    mut HashMap<CompactString, MaterialBindTypedLayoutParameterLookupEntry> outParameterLookup
){
    outLayoutHash = 0u;
    outBlocks.clear();
    outFields.clear();
    outBlockBytes.clear();
    outBlockLookup.clear();
    outParameterLookup.clear();

    Vector<usize> sortedInstanceIndices;
    if(!BuildSortedMaterialBindInstanceIndices(interfaceVirtualPath, contextName, instances, sortedInstanceIndices))
        return false;
    if(!ReserveMaterialBindTypedLayoutStorage(interfaceVirtualPath, contextName, structs, instances, sortedInstanceIndices, outBlocks, outFields, outBlockBytes))
        return false;

    u32 constantTypedByteSize = 0u;
    for(in usize instanceIndex : sortedInstanceIndices){
        const Expected<usize> structIndex = FindMaterialBindStructIndex(structs, instances[instanceIndex].type);
        if(!structIndex.has_value()){
            error(
                "Material bind typed layout: interface '{}' instance '{}' references unknown struct type '{}' for '{}'"
                , interfaceVirtualPath
                , instances[instanceIndex].name
                , instances[instanceIndex].type
                , contextName.resolvedText()
            );
            return false;
        }
        if(!AppendMaterialBindInstanceTypedLayoutBlock(
            interfaceVirtualPath,
            contextName,
            instances[instanceIndex],
            structs[structIndex.value()],
            constantTypedByteSize,
            outBlocks,
            outFields,
            outBlockBytes
        ))
            return false;
    }

    outLayoutHash = ComputeMaterialTypedLayoutHash(outBlocks, outFields);
    if(outLayoutHash == 0u){
        error("Material bind typed layout: interface '{}' produced an empty layout for '{}'", interfaceVirtualPath, contextName.resolvedText());
        return false;
    }

    const Expected<usize> expectedBlockByteSize = ComputeMaterialTypedBlockByteSize(outBlocks);
    if(!expectedBlockByteSize.has_value() || expectedBlockByteSize.value() != outBlockBytes.size()){
        error("Material bind typed layout: interface '{}' has inconsistent block storage for '{}'", interfaceVirtualPath, contextName.resolvedText());
        return false;
    }

    MaterialBindLayoutLookupBuilder lookupBuilder = MaterialBindLayoutLookupBuilder();
    if(!lookupBuilder.buildMaterialBindTypedLayoutBlockLookup(contextName.resolvedText(), outBlocks, outBlockLookup))
        return false;
    return lookupBuilder.buildMaterialBindTypedLayoutParameterLookup(
        interfaceVirtualPath,
        contextName.resolvedText(),
        structs,
        instances,
        outBlockLookup,
        outBlocks,
        outFields,
        outParameterLookup
    );
}




