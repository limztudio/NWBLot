////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_scene/cook.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type TransformComponentCodec = TypedComponentAssetCodec<TransformComponentAsset>;
type LocalTransformComponentCodec = TypedComponentAssetCodec<LocalTransformComponentAsset>;
type SceneParentComponentCodec = TypedComponentAssetCodec<SceneParentComponentAsset>;
type CameraComponentCodec = TypedComponentAssetCodec<CameraComponentAsset>;
type LightComponentCodec = TypedComponentAssetCodec<LightComponentAsset>;
type ActiveCameraComponentCodec = TypedComponentAssetCodec<ActiveCameraComponentAsset>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SortedSceneAssetDependencyEntry{
    public Name nickname = s_NameNone;
    public Name assetName = s_NameNone;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 LessSortedSceneAssetDependencyEntry(in SortedSceneAssetDependencyEntry lhs, in SortedSceneAssetDependencyEntry rhs){
    if(lhs.nickname != rhs.nickname)
        return lhs.nickname < rhs.nickname;
    return lhs.assetName < rhs.assetName;
}

Vector<Name> CollectSortedSceneAssetDependencyNames(in AssetMap assets){
    Vector<SortedSceneAssetDependencyEntry> sortedEntries;
    sortedEntries.reserve(assets.size());
    for(in auto entry : assets){
        SortedSceneAssetDependencyEntry candidate;
        candidate.nickname = entry.first;
        candidate.assetName = entry.second.name();
        sortedEntries.push_back(candidate);
    }
    SortSequence<SortedSceneAssetDependencyEntry>(sortedEntries, LessSortedSceneAssetDependencyEntry);

    Vector<Name> sortedNames;
    sortedNames.reserve(sortedEntries.size());
    for(in SortedSceneAssetDependencyEntry entry : sortedEntries)
        sortedNames.push_back(entry.assetName);
    return sortedNames;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


register_asset EntityAsset using CompositeRootRegistration<EntityAsset>;
register_asset SceneAsset using CompositeRootRegistration<SceneAsset>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cook_entry("component", s_TransformDiagnosticPrefix, ParseTransformComponentCookMetadata, document_and_value, log_failure, TransformComponentCodec)]
Expected<TransformComponentAsset> CookTransformVolumeEntry(in TransformComponentCookEntry entry){
    return BuildComponentAssetFromEntry<TransformComponentAsset, TransformComponentCookEntry>(entry);
}

b8 ExtractTransformComponentDependencies(in CookDependencyItemContext context, mut ICookDependencyCollector collector){
    return ReadCookDependencyEntry<TransformComponentCookEntry>(context, s_TransformDiagnosticPrefix, ParseTransformComponentCookMetadata).has_value();
}

[cook_entry("component", s_LocalTransformDiagnosticPrefix, ParseLocalTransformComponentCookMetadata, document_and_value, log_failure, LocalTransformComponentCodec)]
Expected<LocalTransformComponentAsset> CookLocalTransformVolumeEntry(in LocalTransformComponentCookEntry entry){
    return BuildComponentAssetFromEntry<LocalTransformComponentAsset, LocalTransformComponentCookEntry>(entry);
}

b8 ExtractLocalTransformComponentDependencies(in CookDependencyItemContext context, mut ICookDependencyCollector collector){
    return ReadCookDependencyEntry<LocalTransformComponentCookEntry>(context, s_LocalTransformDiagnosticPrefix, ParseLocalTransformComponentCookMetadata).has_value();
}

[cook_entry("component", s_SceneParentDiagnosticPrefix, ParseSceneParentComponentCookMetadata, document_and_value, log_failure, SceneParentComponentCodec)]
Expected<SceneParentComponentAsset> CookSceneParentVolumeEntry(in SceneParentComponentCookEntry entry){
    return BuildComponentAssetFromEntry<SceneParentComponentAsset, SceneParentComponentCookEntry>(entry);
}

b8 ExtractSceneParentComponentDependencies(in CookDependencyItemContext context, mut ICookDependencyCollector collector){
    return ReadCookDependencyEntry<SceneParentComponentCookEntry>(context, s_SceneParentDiagnosticPrefix, ParseSceneParentComponentCookMetadata).has_value();
}

[cook_entry("component", s_CameraDiagnosticPrefix, ParseCameraComponentCookMetadata, document_and_value, log_failure, CameraComponentCodec)]
Expected<CameraComponentAsset> CookCameraVolumeEntry(in CameraComponentCookEntry entry){
    return BuildComponentAssetFromEntry<CameraComponentAsset, CameraComponentCookEntry>(entry);
}

b8 ExtractCameraComponentDependencies(in CookDependencyItemContext context, mut ICookDependencyCollector collector){
    return ReadCookDependencyEntry<CameraComponentCookEntry>(context, s_CameraDiagnosticPrefix, ParseCameraComponentCookMetadata).has_value();
}

[cook_entry("component", s_LightDiagnosticPrefix, ParseLightComponentCookMetadata, document_and_value, log_failure, LightComponentCodec)]
Expected<LightComponentAsset> CookLightVolumeEntry(in LightComponentCookEntry entry){
    return BuildComponentAssetFromEntry<LightComponentAsset, LightComponentCookEntry>(entry);
}

b8 ExtractLightComponentDependencies(in CookDependencyItemContext context, mut ICookDependencyCollector collector){
    return ReadCookDependencyEntry<LightComponentCookEntry>(context, s_LightDiagnosticPrefix, ParseLightComponentCookMetadata).has_value();
}

[cook_entry("component", s_ActiveCameraDiagnosticPrefix, ParseActiveCameraComponentCookMetadata, document_and_value, log_failure, ActiveCameraComponentCodec)]
Expected<ActiveCameraComponentAsset> CookActiveCameraComponentVolumeEntry(in ActiveCameraComponentCookEntry entry){
    ActiveCameraComponentAsset asset(entry.virtualPath);
    if(!asset.validatePayload())
        return MakeUnexpected(Failure());
    return asset;
}

b8 ExtractActiveCameraComponentDependencies(in CookDependencyItemContext context, mut ICookDependencyCollector collector){
    return ReadCookDependencyEntry<ActiveCameraComponentCookEntry>(context, s_ActiveCameraDiagnosticPrefix, ParseActiveCameraComponentCookMetadata).has_value();
}

[cook_entry("entity", s_EntityDiagnosticPrefix, ParseEntityCookMetadata, document_and_value, log_failure)]
Expected<EntityAsset> CookEntityVolumeEntry(in EntityCookEntry entry){
    return BuildEntityAssetFromComponents(entry.virtualPath, entry.name, entry.components);
}

[cook_entry("project", s_ProjectDiagnosticPrefix, ParseProjectCookMetadata, document_and_value, log_failure)]
Expected<ProjectAsset> CookProjectVolumeEntry(in ProjectCookEntry entry){
    return BuildProjectAssetFromStartScene(entry.virtualPath, entry.startScene);
}

[cook_entry("scene", s_SceneDiagnosticPrefix, ParseSceneCookMetadata, document_and_value, log_failure)]
Expected<SceneAsset> CookSceneVolumeEntry(in SceneCookEntry entry){
    return BuildSceneAssetFromContents(entry.virtualPath, entry.subsystems, entry.assets, entry.entities);
}

b8 ExtractEntityDependencies(in CookDependencyItemContext context, mut ICookDependencyCollector collector){
    const auto entry = ReadCookDependencyEntry<EntityCookEntry>(context, s_EntityDiagnosticPrefix, ParseEntityCookMetadata);
    if(!entry.has_value())
        return false;
    for(in ComponentRef component : entry.value().components){
        if(!collector.addAssetDependency(component.name(), IComponent::AssetTypeName()))
            return false;
    }
    return true;
}

b8 ExtractProjectDependencies(in CookDependencyItemContext context, mut ICookDependencyCollector collector){
    const auto entry = ReadCookDependencyEntry<ProjectCookEntry>(context, s_ProjectDiagnosticPrefix, ParseProjectCookMetadata);
    return entry.has_value() && collector.addAssetDependency(entry.value().startScene.name(), SceneAsset::AssetTypeName());
}

b8 ExtractSceneDependencies(in CookDependencyItemContext context, mut ICookDependencyCollector collector){
    const auto entry = ReadCookDependencyEntry<SceneCookEntry>(context, s_SceneDiagnosticPrefix, ParseSceneCookMetadata);
    if(!entry.has_value())
        return false;
    for(in SubsystemRef subsystem : entry.value().subsystems){
        if(!collector.addAssetDependency(subsystem.name(), ISubsystem::AssetTypeName()))
            return false;
    }
    for(in EntityRef entity : entry.value().entities){
        if(!collector.addAssetDependency(entity.name(), EntityAsset::AssetTypeName()))
            return false;
    }
    const Vector<Name> names = CollectSortedSceneAssetDependencyNames(entry.value().assets);
    for(in Name name : names){
        if(!collector.addAssetDependency(name))
            return false;
    }
    return true;
}

[cook_registrar]
b8 RegisterSceneCookDependencies(mut CookDependencyRegistry registry){
    return registry.registerDefaultEntryAsset(s_DefaultProjectVirtualPath, ProjectAsset::AssetTypeName(), s_DefaultProjectVirtualPathText)
        && registry.registerType(TransformComponentAsset::AssetTypeName(), ExtractTransformComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(LocalTransformComponentAsset::AssetTypeName(), ExtractLocalTransformComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(SceneParentComponentAsset::AssetTypeName(), ExtractSceneParentComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(CameraComponentAsset::AssetTypeName(), ExtractCameraComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(LightComponentAsset::AssetTypeName(), ExtractLightComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(ActiveCameraComponentAsset::AssetTypeName(), ExtractActiveCameraComponentDependencies, IComponent::AssetTypeName())
        && registry.registerType(EntityAsset::AssetTypeName(), ExtractEntityDependencies)
        && registry.registerType(ProjectAsset::AssetTypeName(), ExtractProjectDependencies)
        && registry.registerType(SceneAsset::AssetTypeName(), ExtractSceneDependencies);
}


