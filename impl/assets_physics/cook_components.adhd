#include <impl/assets_mesh/asset.adhd>
#include <impl/assets_physics/components.adhd>
#include <impl/assets_physics/physics_component_binary_codec.adhd>
#include <impl/assets_scene/cook.adhd>
#include <impl/assets_scene/cook_component_metadata.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_RigidBodyComponentDiagnosticPrefix = "RigidBody component meta";
const StringView s_ColliderComponentDiagnosticPrefix = "Collider component meta";
const StringView s_JointComponentDiagnosticPrefix = "Joint component meta";
const StringView s_PhysicsWorldConfigComponentDiagnosticPrefix = "PhysicsWorldConfig component meta";
const StringView s_PhysicsParentComponentDiagnosticPrefix = "PhysicsParent component meta";

type RigidBodyComponentCookEntry = TypedComponentCookEntry<RigidBodyComponent>;
type ColliderComponentCookEntry = TypedComponentCookEntry<ColliderComponent>;
type JointComponentCookEntry = TypedComponentCookEntry<JointComponent>;
type PhysicsWorldConfigComponentCookEntry = TypedComponentCookEntry<PhysicsWorldConfigComponent>;
type PhysicsParentComponentCookEntry = TypedComponentCookEntry<PhysicsParentComponent>;

type RigidBodyComponentCodec = TypedComponentAssetCodec<RigidBodyComponentAsset>;
type ColliderComponentCodec = TypedComponentAssetCodec<ColliderComponentAsset>;
type JointComponentCodec = TypedComponentAssetCodec<JointComponentAsset>;
type PhysicsWorldConfigComponentCodec = TypedComponentAssetCodec<PhysicsWorldConfigComponentAsset>;
type PhysicsParentComponentCodec = TypedComponentAssetCodec<PhysicsParentComponentAsset>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ReadPhysicsU32Value(
    in Path file,
    in MetascriptValue fieldVal,
    in StringView prefix,
    in StringView field,
    mut u32 outVal
){
    if(fieldVal.isInteger()){
        const i64 integerValue = fieldVal.asInteger();
        if(integerValue < 0 || integerValue > cast<i64>(u32.max)){
            error("{} '{}': field '{}' must be a u32 integer", prefix, PathToString(file), field);
            return false;
        }
        outVal = cast<u32>(integerValue);
        return true;
    }
    if(!fieldVal.isNumeric()){
        error("{} '{}': field '{}' must be a non-negative integer", prefix, PathToString(file), field);
        return false;
    }
    const f64 num = fieldVal.toDouble();
    if(!IsFinite(num) || num < 0.0 || num > 4294967295.0 || Floor(num) != num){
        error("{} '{}': field '{}' must be a u32 integer", prefix, PathToString(file), field);
        return false;
    }
    outVal = cast<u32>(num);
    return true;
}

b8 ReadPhysicsU64Value(
    in Path file,
    in MetascriptValue fieldVal,
    in StringView prefix,
    in StringView field,
    mut u64 outVal
){
    if(fieldVal.isInteger()){
        const i64 integerValue = fieldVal.asInteger();
        if(integerValue < 0){
            error("{} '{}': field '{}' must be a u64 integer", prefix, PathToString(file), field);
            return false;
        }
        outVal = cast<u64>(integerValue);
        return true;
    }
    if(!fieldVal.isNumeric()){
        error("{} '{}': field '{}' must be a non-negative integer", prefix, PathToString(file), field);
        return false;
    }
    const f64 num = fieldVal.toDouble();
    if(!IsFinite(num) || num < 0.0 || num > 9007199254740991.0 || Floor(num) != num){
        error("{} '{}': field '{}' must be a u64 integer", prefix, PathToString(file), field);
        return false;
    }
    outVal = cast<u64>(num);
    return true;
}

b8 ReadPhysicsI32Value(
    in Path file,
    in MetascriptValue fieldVal,
    in StringView prefix,
    in StringView field,
    mut i32 outVal
){
    if(!fieldVal.isInteger()){
        error("{} '{}': field '{}' must be an integer", prefix, PathToString(file), field);
        return false;
    }
    const i64 integerValue = fieldVal.asInteger();
    if(integerValue < cast<i64>(i32.min) || integerValue > cast<i64>(i32.max)){
        error("{} '{}': field '{}' is outside the supported 32-bit signed integer range", prefix, PathToString(file), field);
        return false;
    }
    outVal = cast<i32>(integerValue);
    return true;
}

b8 ReadPhysicsF32Value(
    in Path file,
    in MetascriptValue fieldVal,
    in StringView prefix,
    in StringView field,
    mut f32 outVal
){
    const Expected<f32> parsed = ReadMetadataFiniteF32Value(file, fieldVal, prefix, field);
    if(!parsed.has_value())
        return false;
    outVal = parsed.value();
    return true;
}

b8 ReadPhysicsBoolValue(
    in Path file,
    in MetascriptValue fieldVal,
    in StringView prefix,
    in StringView field,
    mut b8 outVal
){
    const Expected<b8> parsed = ParseMetadataBoolField(file, prefix, fieldVal, field, "must be 0 or 1");
    if(!parsed.has_value())
        return false;
    outVal = parsed.value();
    return true;
}

Expected<StringView> ReadPhysicsStringValue(
    in Path file,
    in MetascriptValue fieldVal,
    in StringView prefix,
    in StringView field
){
    if(!fieldVal.isString()){
        error("{} '{}': field '{}' must be a string", prefix, PathToString(file), field);
        return MakeUnexpected(Failure());
    }
    const StringView text = fieldVal.asString();
    if(text.empty()){
        error("{} '{}': field '{}' must not be empty", prefix, PathToString(file), field);
        return MakeUnexpected(Failure());
    }
    return text;
}

b8 ReadPhysicsNameValue(
    in Path file,
    in MetascriptValue fieldVal,
    in StringView prefix,
    in StringView field,
    mut Name outName
){
    const Expected<StringView> text = ReadPhysicsStringValue(file, fieldVal, prefix, field);
    if(!text.has_value())
        return false;
    const Expected<Name> parsed = ParseName(text.value());
    if(!parsed.has_value() || parsed.value() == s_NameNone){
        error("{} '{}': field '{}' must be a non-empty name", prefix, PathToString(file), field);
        return false;
    }
    outName = parsed.value();
    return true;
}

Expected<VectorSingle> DecodePhysicsFloat3Value(
    in Path file,
    in MetascriptValue listVal,
    in StringView prefix,
    in StringView field
){
    if(!listVal.isList()){
        error("{} '{}': field '{}' must be a 3-element numeric list", prefix, PathToString(file), field);
        return MakeUnexpected(Failure());
    }
    const Span<MetascriptValue> items = listVal.listView();
    if(items.size() != s_SceneFloat3ComponentCount){
        error("{} '{}': field '{}' must be a 3-element numeric list", prefix, PathToString(file), field);
        return MakeUnexpected(Failure());
    }
    const Expected<f32> x = ReadMetadataFiniteF32Value(file, items[0u], prefix, field);
    if(!x.has_value())
        return MakeUnexpected(Failure());
    const Expected<f32> y = ReadMetadataFiniteF32Value(file, items[1u], prefix, field);
    if(!y.has_value())
        return MakeUnexpected(Failure());
    const Expected<f32> z = ReadMetadataFiniteF32Value(file, items[2u], prefix, field);
    if(!z.has_value())
        return MakeUnexpected(Failure());
    return VectorSingle(x.value(), y.value(), z.value(), 0.0f);
}

Expected<VectorSingle> ReadPhysicsRotationVectorValue(
    in Path file,
    in MetascriptValue fieldVal,
    in StringView prefix,
    in StringView field,
    in StringView quatField,
    in StringView eulerField,
    in StringView eulerDegField,
    in b8 isQuaternion,
    in b8 inDegrees,
    mut u32 rotFieldCount
){
    ++rotFieldCount;
    if(rotFieldCount > 1u){
        error("{} '{}': only one of '{}', '{}', or '{}' may be set", prefix, PathToString(file), quatField, eulerField, eulerDegField);
        return MakeUnexpected(Failure());
    }
    if(isQuaternion){
        const Expected<VectorSingle> q = ParseSceneQuaternionValue(file, fieldVal, prefix, quatField);
        if(!q.has_value())
            return MakeUnexpected(Failure());
        return q.value();
    }
    const Expected<VectorSingle> euler = DecodePhysicsFloat3Value(file, fieldVal, prefix, field);
    if(!euler.has_value())
        return MakeUnexpected(Failure());
    return VectorSingle(BuildTransformEulerQuaternion(euler.value(), inDegrees));
}

b8 ReadPhysicsFloat3ArrayValue(
    in Path file,
    in MetascriptValue listVal,
    in StringView prefix,
    in StringView field,
    mut Vector<f32x4> outPoints
){
    if(!listVal.isList()){
        error("{} '{}': field '{}' must be a list of 3-element float lists", prefix, PathToString(file), field);
        return false;
    }
    const Span<MetascriptValue> items = listVal.listView();
    outPoints.clear();
    outPoints.reserve(items.size());
    for(usize i = 0u; i < items.size(); ++i){
        const Expected<VectorSingle> pt = DecodePhysicsFloat3Value(file, items[i], prefix, field);
        if(!pt.has_value())
            return false;
        outPoints.push_back(f32x4(pt.value(), 0.0f));
    }
    return true;
}

b8 ReadPhysicsU32ArrayValue(
    in Path file,
    in MetascriptValue listVal,
    in StringView prefix,
    in StringView field,
    mut Vector<u32> outIndices
){
    if(!listVal.isList()){
        error("{} '{}': field '{}' must be a list of u32 integers", prefix, PathToString(file), field);
        return false;
    }
    const Span<MetascriptValue> items = listVal.listView();
    outIndices.clear();
    outIndices.reserve(items.size());
    for(usize i = 0u; i < items.size(); ++i){
        in MetascriptValue item = items[i];
        if(item.isInteger()){
            const i64 integerValue = item.asInteger();
            if(integerValue < 0 || integerValue > cast<i64>(u32.max)){
                error("{} '{}': field '{}' entries must be u32 integers", prefix, PathToString(file), field);
                return false;
            }
            outIndices.push_back(cast<u32>(integerValue));
            continue;
        }
        if(!item.isNumeric()){
            error("{} '{}': field '{}' entries must be numeric integers", prefix, PathToString(file), field);
            return false;
        }
        const f64 num = item.toDouble();
        if(!IsFinite(num) || num < 0.0 || num > 4294967295.0 || Floor(num) != num){
            error("{} '{}': field '{}' entries must be u32 integers", prefix, PathToString(file), field);
            return false;
        }
        outIndices.push_back(cast<u32>(num));
    }
    return true;
}

Expected<RigidBodyComponentCookEntry> ParseRigidBodyComponentCookMetadata(in Name virtualPath, in Path file, in MetascriptValue value){
    RigidBodyComponentCookEntry entry;
    if(!ValidateOptionalSceneMetadataMap(file, value, s_RigidBodyComponentDiagnosticPrefix)
        || !AssignCookEntryVirtualPath(virtualPath, file, s_RigidBodyComponentDiagnosticPrefix, entry))
        return MakeUnexpected(Failure());

    if(value.isMap()){
        if(!value.forEachMapEntry(lambda[in file, mut entry](in StringView key, in MetascriptValue fieldVal) -> b8{
            if(key == "type"){
                const Expected<StringView> text = ReadPhysicsStringValue(file, fieldVal, s_RigidBodyComponentDiagnosticPrefix, "type");
                if(!text.has_value())
                    return false;
                if(text.value() == "static") entry.component.type = BodyType::Static;
                else if(text.value() == "kinematic") entry.component.type = BodyType::Kinematic;
                else if(text.value() == "dynamic") entry.component.type = BodyType::Dynamic;
                else{
                    error("{} '{}': field 'type' must be 'static', 'kinematic', or 'dynamic'", s_RigidBodyComponentDiagnosticPrefix, PathToString(file));
                    return false;
                }
                return true;
            }
            if(key == "linear_velocity" || key == "angular_velocity" || key == "custom_center_of_mass" || key == "custom_inertia_diag" || key == "custom_inertia_off_diag"){
                const Expected<VectorSingle> v = DecodePhysicsFloat3Value(file, fieldVal, s_RigidBodyComponentDiagnosticPrefix, key);
                if(!v.has_value())
                    return false;
                if(key == "linear_velocity") entry.component.linearVelocity = f32x4(v.value(), 0.0f);
                else if(key == "angular_velocity") entry.component.angularVelocity = f32x4(v.value(), 0.0f);
                else if(key == "custom_center_of_mass") entry.component.customCenterOfMass = f32x4(v.value(), 0.0f);
                else if(key == "custom_inertia_diag") entry.component.customInertiaDiag = f32x4(v.value(), 0.0f);
                else entry.component.customInertiaOffDiag = f32x4(v.value(), 0.0f);
                return true;
            }
            if(key == "linear_damping") return ReadPhysicsF32Value(file, fieldVal, s_RigidBodyComponentDiagnosticPrefix, key, entry.component.linearDamping);
            if(key == "angular_damping") return ReadPhysicsF32Value(file, fieldVal, s_RigidBodyComponentDiagnosticPrefix, key, entry.component.angularDamping);
            if(key == "gravity_scale") return ReadPhysicsF32Value(file, fieldVal, s_RigidBodyComponentDiagnosticPrefix, key, entry.component.gravityScale);
            if(key == "sleep_threshold") return ReadPhysicsF32Value(file, fieldVal, s_RigidBodyComponentDiagnosticPrefix, key, entry.component.sleepThreshold);
            if(key == "motion_locks") return ReadPhysicsU32Value(file, fieldVal, s_RigidBodyComponentDiagnosticPrefix, key, entry.component.motionLocks);
            if(key == "user_data") return ReadPhysicsU64Value(file, fieldVal, s_RigidBodyComponentDiagnosticPrefix, key, entry.component.userData);
            if(key == "entity_tag") return ReadPhysicsNameValue(file, fieldVal, s_RigidBodyComponentDiagnosticPrefix, key, entry.component.entityTag);
            if(key == "use_custom_mass") return ReadPhysicsBoolValue(file, fieldVal, s_RigidBodyComponentDiagnosticPrefix, key, entry.component.useCustomMass);
            if(key == "custom_mass") return ReadPhysicsF32Value(file, fieldVal, s_RigidBodyComponentDiagnosticPrefix, key, entry.component.customMass);
            if(key == "enable_sleep") return ReadPhysicsBoolValue(file, fieldVal, s_RigidBodyComponentDiagnosticPrefix, key, entry.component.enableSleep);
            if(key == "is_awake") return ReadPhysicsBoolValue(file, fieldVal, s_RigidBodyComponentDiagnosticPrefix, key, entry.component.isAwake);
            if(key == "is_bullet") return ReadPhysicsBoolValue(file, fieldVal, s_RigidBodyComponentDiagnosticPrefix, key, entry.component.isBullet);
            if(key == "is_enabled") return ReadPhysicsBoolValue(file, fieldVal, s_RigidBodyComponentDiagnosticPrefix, key, entry.component.isEnabled);
            if(key == "allow_fast_rotation") return ReadPhysicsBoolValue(file, fieldVal, s_RigidBodyComponentDiagnosticPrefix, key, entry.component.allowFastRotation);
            if(key == "enable_gyroscopic_torque") return ReadPhysicsBoolValue(file, fieldVal, s_RigidBodyComponentDiagnosticPrefix, key, entry.component.enableGyroscopicTorque);
            if(key == "drive_kinematic_from_transform") return ReadPhysicsBoolValue(file, fieldVal, s_RigidBodyComponentDiagnosticPrefix, key, entry.component.driveKinematicFromTransform);
            error("{} '{}': unsupported asset field '{}'", s_RigidBodyComponentDiagnosticPrefix, PathToString(file), key);
            return false;
        }))
            return MakeUnexpected(Failure());
    }

    if(!PhysicsComponentBinaryCodec().validateRigidBody(entry.component, entry.virtualPath))
        return MakeUnexpected(Failure());
    return entry;
}

b8 ApplyColliderShapeField(
    in Path file,
    in StringView key,
    in MetascriptValue fieldVal,
    mut ShapeType outShapeType,
    mut VectorSingle outCenter,
    mut VectorSingle outCenter2,
    mut VectorSingle outHalfExtents,
    mut VectorSingle outLocalRotation,
    mut u32 inOutVecMask,
    mut f32 outRadius,
    mut f32 outSkinRadius,
    mut f32 outDensity,
    mut f32 outFriction,
    mut f32 outRestitution,
    mut f32 outRollingResistance,
    mut f32 outTangentSpeed,
    mut u32 outCategoryBits,
    mut u32 outMaskBits,
    mut i32 outGroupIndex,
    mut u64 outUserData,
    mut b8 outIsBox,
    mut b8 outIsSensor,
    mut b8 outEnableContactEvents,
    mut b8 outEnableHitEvents,
    mut b8 outEnableSensorEvents,
    mut b8 outEnablePreSolveEvents,
    mut b8 outInvokeContactCreation,
    mut Vector<f32x4> outHullPoints,
    mut Vector<f32x4> outMeshVertices,
    mut Vector<u32> outMeshIndices,
    mut AssetRef<Mesh> outMeshAsset,
    mut u32 inOutRotFieldCount
){
    if(key == "shape_type"){
        const Expected<StringView> text = ReadPhysicsStringValue(file, fieldVal, s_ColliderComponentDiagnosticPrefix, "shape_type");
        if(!text.has_value())
            return false;
        if(text.value() == "sphere") outShapeType = ShapeType::Sphere;
        else if(text.value() == "capsule") outShapeType = ShapeType::Capsule;
        else if(text.value() == "hull") outShapeType = ShapeType::Hull;
        else if(text.value() == "mesh") outShapeType = ShapeType::Mesh;
        else{
            error("{} '{}': field 'shape_type' must be 'sphere', 'capsule', 'hull', or 'mesh'", s_ColliderComponentDiagnosticPrefix, PathToString(file));
            return false;
        }
        return true;
    }
    if(key == "center"){
        const Expected<VectorSingle> v = DecodePhysicsFloat3Value(file, fieldVal, s_ColliderComponentDiagnosticPrefix, key);
        if(!v.has_value())
            return false;
        outCenter = v.value();
        inOutVecMask |= 1u;
        return true;
    }
    if(key == "center2"){
        const Expected<VectorSingle> v = DecodePhysicsFloat3Value(file, fieldVal, s_ColliderComponentDiagnosticPrefix, key);
        if(!v.has_value())
            return false;
        outCenter2 = v.value();
        inOutVecMask |= 2u;
        return true;
    }
    if(key == "half_extents"){
        const Expected<VectorSingle> v = DecodePhysicsFloat3Value(file, fieldVal, s_ColliderComponentDiagnosticPrefix, key);
        if(!v.has_value())
            return false;
        outHalfExtents = v.value();
        inOutVecMask |= 4u;
        return true;
    }
    if(key == "local_rotation" || key == "local_rotation_euler" || key == "local_rotation_euler_degrees"){
        const Expected<VectorSingle> q = ReadPhysicsRotationVectorValue(
            file,
            fieldVal,
            s_ColliderComponentDiagnosticPrefix,
            key,
            "local_rotation",
            "local_rotation_euler",
            "local_rotation_euler_degrees",
            key == "local_rotation",
            key == "local_rotation_euler_degrees",
            inOutRotFieldCount
        );
        if(!q.has_value())
            return false;
        outLocalRotation = q.value();
        inOutVecMask |= 8u;
        return true;
    }
    if(key == "radius") return ReadPhysicsF32Value(file, fieldVal, s_ColliderComponentDiagnosticPrefix, key, outRadius);
    if(key == "skin_radius") return ReadPhysicsF32Value(file, fieldVal, s_ColliderComponentDiagnosticPrefix, key, outSkinRadius);
    if(key == "density") return ReadPhysicsF32Value(file, fieldVal, s_ColliderComponentDiagnosticPrefix, key, outDensity);
    if(key == "friction") return ReadPhysicsF32Value(file, fieldVal, s_ColliderComponentDiagnosticPrefix, key, outFriction);
    if(key == "restitution") return ReadPhysicsF32Value(file, fieldVal, s_ColliderComponentDiagnosticPrefix, key, outRestitution);
    if(key == "rolling_resistance") return ReadPhysicsF32Value(file, fieldVal, s_ColliderComponentDiagnosticPrefix, key, outRollingResistance);
    if(key == "tangent_speed") return ReadPhysicsF32Value(file, fieldVal, s_ColliderComponentDiagnosticPrefix, key, outTangentSpeed);
    if(key == "category_bits") return ReadPhysicsU32Value(file, fieldVal, s_ColliderComponentDiagnosticPrefix, key, outCategoryBits);
    if(key == "mask_bits") return ReadPhysicsU32Value(file, fieldVal, s_ColliderComponentDiagnosticPrefix, key, outMaskBits);
    if(key == "group_index") return ReadPhysicsI32Value(file, fieldVal, s_ColliderComponentDiagnosticPrefix, key, outGroupIndex);
    if(key == "user_data") return ReadPhysicsU64Value(file, fieldVal, s_ColliderComponentDiagnosticPrefix, key, outUserData);
    if(key == "is_box") return ReadPhysicsBoolValue(file, fieldVal, s_ColliderComponentDiagnosticPrefix, key, outIsBox);
    if(key == "is_sensor") return ReadPhysicsBoolValue(file, fieldVal, s_ColliderComponentDiagnosticPrefix, key, outIsSensor);
    if(key == "enable_contact_events") return ReadPhysicsBoolValue(file, fieldVal, s_ColliderComponentDiagnosticPrefix, key, outEnableContactEvents);
    if(key == "enable_hit_events") return ReadPhysicsBoolValue(file, fieldVal, s_ColliderComponentDiagnosticPrefix, key, outEnableHitEvents);
    if(key == "enable_sensor_events") return ReadPhysicsBoolValue(file, fieldVal, s_ColliderComponentDiagnosticPrefix, key, outEnableSensorEvents);
    if(key == "enable_pre_solve_events") return ReadPhysicsBoolValue(file, fieldVal, s_ColliderComponentDiagnosticPrefix, key, outEnablePreSolveEvents);
    if(key == "invoke_contact_creation") return ReadPhysicsBoolValue(file, fieldVal, s_ColliderComponentDiagnosticPrefix, key, outInvokeContactCreation);
    if(key == "hull_points") return ReadPhysicsFloat3ArrayValue(file, fieldVal, s_ColliderComponentDiagnosticPrefix, key, outHullPoints);
    if(key == "mesh_vertices") return ReadPhysicsFloat3ArrayValue(file, fieldVal, s_ColliderComponentDiagnosticPrefix, key, outMeshVertices);
    if(key == "mesh_indices") return ReadPhysicsU32ArrayValue(file, fieldVal, s_ColliderComponentDiagnosticPrefix, key, outMeshIndices);
    if(key == "mesh_asset"){
        const Expected<StringView> meshText = ReadPhysicsStringValue(file, fieldVal, s_ColliderComponentDiagnosticPrefix, "mesh_asset");
        if(!meshText.has_value())
            return false;
        const Expected<AssetRef<Mesh>> meshRef = ParseReservedAssetRefText<Mesh>(file, s_ColliderComponentDiagnosticPrefix, "mesh_asset", meshText.value());
        if(!meshRef.has_value())
            return false;
        outMeshAsset = meshRef.value();
        return true;
    }
    error("{} '{}': unsupported asset field '{}'", s_ColliderComponentDiagnosticPrefix, PathToString(file), key);
    return false;
}

b8 ParseColliderShapeEntryMap(in Path file, in MetascriptValue mapVal, mut ColliderShapeEntry outEntry){
    VectorSingle center(0.0f);
    VectorSingle center2(0.0f);
    VectorSingle halfExtents(0.0f);
    VectorSingle localRotation(0.0f);
    u32 vecMask = 0u;
    u32 rotFieldCount = 0u;
    if(!mapVal.forEachMapEntry(lambda[in file, mut outEntry, mut center, mut center2, mut halfExtents, mut localRotation, mut vecMask, mut rotFieldCount](in StringView key, in MetascriptValue fieldVal) -> b8{
        return ApplyColliderShapeField(
            file,
            key,
            fieldVal,
            outEntry.shapeType,
            center,
            center2,
            halfExtents,
            localRotation,
            vecMask,
            outEntry.radius,
            outEntry.skinRadius,
            outEntry.density,
            outEntry.friction,
            outEntry.restitution,
            outEntry.rollingResistance,
            outEntry.tangentSpeed,
            outEntry.categoryBits,
            outEntry.maskBits,
            outEntry.groupIndex,
            outEntry.userData,
            outEntry.isBox,
            outEntry.isSensor,
            outEntry.enableContactEvents,
            outEntry.enableHitEvents,
            outEntry.enableSensorEvents,
            outEntry.enablePreSolveEvents,
            outEntry.invokeContactCreation,
            outEntry.hullPoints,
            outEntry.meshVertices,
            outEntry.meshIndices,
            outEntry.meshAsset,
            rotFieldCount
        );
    }))
        return false;
    if((vecMask & 1u) != 0u) outEntry.center = f32x4(center, 0.0f);
    if((vecMask & 2u) != 0u) outEntry.center2 = f32x4(center2, 0.0f);
    if((vecMask & 4u) != 0u) outEntry.halfExtents = f32x4(halfExtents, 0.0f);
    if((vecMask & 8u) != 0u) outEntry.localRotation = f32x4(localRotation);
    return true;
}

Expected<ColliderComponentCookEntry> ParseColliderComponentCookMetadata(in Name virtualPath, in Path file, in MetascriptValue value){
    ColliderComponentCookEntry entry;
    if(!ValidateOptionalSceneMetadataMap(file, value, s_ColliderComponentDiagnosticPrefix)
        || !AssignCookEntryVirtualPath(virtualPath, file, s_ColliderComponentDiagnosticPrefix, entry))
        return MakeUnexpected(Failure());

    if(value.isMap()){
        VectorSingle center(0.0f);
        VectorSingle center2(0.0f);
        VectorSingle halfExtents(0.0f);
        VectorSingle localRotation(0.0f);
        u32 vecMask = 0u;
        u32 rotFieldCount = 0u;
        if(!value.forEachMapEntry(lambda[in file, mut entry, mut center, mut center2, mut halfExtents, mut localRotation, mut vecMask, mut rotFieldCount](in StringView key, in MetascriptValue fieldVal) -> b8{
            if(key == "entity_tag")
                return ReadPhysicsNameValue(file, fieldVal, s_ColliderComponentDiagnosticPrefix, "entity_tag", entry.component.entityTag);
            if(key == "extra_shapes"){
                if(!fieldVal.isList()){
                    error("{} '{}': field 'extra_shapes' must be a list of collider maps", s_ColliderComponentDiagnosticPrefix, PathToString(file));
                    return false;
                }
                const Span<MetascriptValue> items = fieldVal.listView();
                entry.component.extraShapes.clear();
                entry.component.extraShapes.resize(items.size());
                for(usize i = 0u; i < items.size(); ++i){
                    in MetascriptValue item = items[i];
                    if(!item.isMap()){
                        error("{} '{}': 'extra_shapes[{}]' must be a map", s_ColliderComponentDiagnosticPrefix, PathToString(file), i);
                        return false;
                    }
                    if(!ParseColliderShapeEntryMap(file, item, entry.component.extraShapes[i]))
                        return false;
                }
                return true;
            }
            return ApplyColliderShapeField(
                file,
                key,
                fieldVal,
                entry.component.shapeType,
                center,
                center2,
                halfExtents,
                localRotation,
                vecMask,
                entry.component.radius,
                entry.component.skinRadius,
                entry.component.density,
                entry.component.friction,
                entry.component.restitution,
                entry.component.rollingResistance,
                entry.component.tangentSpeed,
                entry.component.categoryBits,
                entry.component.maskBits,
                entry.component.groupIndex,
                entry.component.userData,
                entry.component.isBox,
                entry.component.isSensor,
                entry.component.enableContactEvents,
                entry.component.enableHitEvents,
                entry.component.enableSensorEvents,
                entry.component.enablePreSolveEvents,
                entry.component.invokeContactCreation,
                entry.component.hullPoints,
                entry.component.meshVertices,
                entry.component.meshIndices,
                entry.component.meshAsset,
                rotFieldCount
            );
        }))
            return MakeUnexpected(Failure());
        if((vecMask & 1u) != 0u) entry.component.center = f32x4(center, 0.0f);
        if((vecMask & 2u) != 0u) entry.component.center2 = f32x4(center2, 0.0f);
        if((vecMask & 4u) != 0u) entry.component.halfExtents = f32x4(halfExtents, 0.0f);
        if((vecMask & 8u) != 0u) entry.component.localRotation = f32x4(localRotation);
    }

    if(!PhysicsComponentBinaryCodec().validateCollider(entry.component, entry.virtualPath))
        return MakeUnexpected(Failure());
    return entry;
}

Expected<JointComponentCookEntry> ParseJointComponentCookMetadata(in Name virtualPath, in Path file, in MetascriptValue value){
    JointComponentCookEntry entry;
    if(!ValidateOptionalSceneMetadataMap(file, value, s_JointComponentDiagnosticPrefix)
        || !AssignCookEntryVirtualPath(virtualPath, file, s_JointComponentDiagnosticPrefix, entry))
        return MakeUnexpected(Failure());

    if(value.isMap()){
        u32 rotFieldCount = 0u;
        if(!value.forEachMapEntry(lambda[in file, mut entry, mut rotFieldCount](in StringView key, in MetascriptValue fieldVal) -> b8{
            if(key == "type"){
                const Expected<StringView> text = ReadPhysicsStringValue(file, fieldVal, s_JointComponentDiagnosticPrefix, "type");
                if(!text.has_value())
                    return false;
                if(text.value() == "distance") entry.component.type = JointType::Distance;
                else if(text.value() == "spherical") entry.component.type = JointType::Spherical;
                else if(text.value() == "revolute") entry.component.type = JointType::Revolute;
                else if(text.value() == "prismatic") entry.component.type = JointType::Prismatic;
                else if(text.value() == "fixed") entry.component.type = JointType::Fixed;
                else if(text.value() == "motor") entry.component.type = JointType::Motor;
                else if(text.value() == "wheel") entry.component.type = JointType::Wheel;
                else{
                    error("{} '{}': field 'type' must be 'distance', 'spherical', 'revolute', 'prismatic', 'fixed', 'motor', or 'wheel'", s_JointComponentDiagnosticPrefix, PathToString(file));
                    return false;
                }
                return true;
            }
            if(key == "local_anchor_a" || key == "local_anchor_b" || key == "local_axis_a" || key == "local_axis_b" || key == "linear_offset"){
                const Expected<VectorSingle> v = DecodePhysicsFloat3Value(file, fieldVal, s_JointComponentDiagnosticPrefix, key);
                if(!v.has_value())
                    return false;
                if(key == "local_anchor_a") entry.component.localAnchorA = f32x4(v.value(), 0.0f);
                else if(key == "local_anchor_b") entry.component.localAnchorB = f32x4(v.value(), 0.0f);
                else if(key == "local_axis_a") entry.component.localAxisA = f32x4(v.value(), 0.0f);
                else if(key == "local_axis_b") entry.component.localAxisB = f32x4(v.value(), 0.0f);
                else entry.component.linearOffset = f32x4(v.value(), 0.0f);
                return true;
            }
            if(key == "reference_rotation" || key == "reference_rotation_euler" || key == "reference_rotation_euler_degrees"){
                const Expected<VectorSingle> q = ReadPhysicsRotationVectorValue(
                    file,
                    fieldVal,
                    s_JointComponentDiagnosticPrefix,
                    key,
                    "reference_rotation",
                    "reference_rotation_euler",
                    "reference_rotation_euler_degrees",
                    key == "reference_rotation",
                    key == "reference_rotation_euler_degrees",
                    rotFieldCount
                );
                if(!q.has_value())
                    return false;
                entry.component.referenceRotation = f32x4(q.value());
                return true;
            }
            if(key == "use_reference_rotation") return ReadPhysicsBoolValue(file, fieldVal, s_JointComponentDiagnosticPrefix, key, entry.component.useReferenceRotation);
            if(key == "length") return ReadPhysicsF32Value(file, fieldVal, s_JointComponentDiagnosticPrefix, key, entry.component.length);
            if(key == "min_length") return ReadPhysicsF32Value(file, fieldVal, s_JointComponentDiagnosticPrefix, key, entry.component.minLength);
            if(key == "max_length") return ReadPhysicsF32Value(file, fieldVal, s_JointComponentDiagnosticPrefix, key, entry.component.maxLength);
            if(key == "enable_limit") return ReadPhysicsBoolValue(file, fieldVal, s_JointComponentDiagnosticPrefix, key, entry.component.enableLimit);
            if(key == "lower_limit") return ReadPhysicsF32Value(file, fieldVal, s_JointComponentDiagnosticPrefix, key, entry.component.lowerLimit);
            if(key == "upper_limit") return ReadPhysicsF32Value(file, fieldVal, s_JointComponentDiagnosticPrefix, key, entry.component.upperLimit);
            if(key == "enable_motor") return ReadPhysicsBoolValue(file, fieldVal, s_JointComponentDiagnosticPrefix, key, entry.component.enableMotor);
            if(key == "motor_speed") return ReadPhysicsF32Value(file, fieldVal, s_JointComponentDiagnosticPrefix, key, entry.component.motorSpeed);
            if(key == "max_motor_force") return ReadPhysicsF32Value(file, fieldVal, s_JointComponentDiagnosticPrefix, key, entry.component.maxMotorForce);
            if(key == "enable_spring") return ReadPhysicsBoolValue(file, fieldVal, s_JointComponentDiagnosticPrefix, key, entry.component.enableSpring);
            if(key == "hertz") return ReadPhysicsF32Value(file, fieldVal, s_JointComponentDiagnosticPrefix, key, entry.component.hertz);
            if(key == "damping_ratio") return ReadPhysicsF32Value(file, fieldVal, s_JointComponentDiagnosticPrefix, key, entry.component.dampingRatio);
            if(key == "correction_factor") return ReadPhysicsF32Value(file, fieldVal, s_JointComponentDiagnosticPrefix, key, entry.component.correctionFactor);
            if(key == "max_torque") return ReadPhysicsF32Value(file, fieldVal, s_JointComponentDiagnosticPrefix, key, entry.component.maxTorque);
            if(key == "swing_limit") return ReadPhysicsF32Value(file, fieldVal, s_JointComponentDiagnosticPrefix, key, entry.component.swingLimit);
            if(key == "suspension_hertz") return ReadPhysicsF32Value(file, fieldVal, s_JointComponentDiagnosticPrefix, key, entry.component.suspensionHertz);
            if(key == "suspension_damping_ratio") return ReadPhysicsF32Value(file, fieldVal, s_JointComponentDiagnosticPrefix, key, entry.component.suspensionDampingRatio);
            if(key == "break_force") return ReadPhysicsF32Value(file, fieldVal, s_JointComponentDiagnosticPrefix, key, entry.component.breakForce);
            if(key == "break_torque") return ReadPhysicsF32Value(file, fieldVal, s_JointComponentDiagnosticPrefix, key, entry.component.breakTorque);
            if(key == "collide_connected") return ReadPhysicsBoolValue(file, fieldVal, s_JointComponentDiagnosticPrefix, key, entry.component.collideConnected);
            if(key == "body_entity_a") return ReadPhysicsNameValue(file, fieldVal, s_JointComponentDiagnosticPrefix, key, entry.component.bodyEntityNameA);
            if(key == "body_entity_b") return ReadPhysicsNameValue(file, fieldVal, s_JointComponentDiagnosticPrefix, key, entry.component.bodyEntityNameB);
            if(key == "user_data") return ReadPhysicsU64Value(file, fieldVal, s_JointComponentDiagnosticPrefix, key, entry.component.userData);
            error("{} '{}': unsupported asset field '{}'", s_JointComponentDiagnosticPrefix, PathToString(file), key);
            return false;
        }))
            return MakeUnexpected(Failure());
    }

    if(!PhysicsComponentBinaryCodec().validateJoint(entry.component, entry.virtualPath))
        return MakeUnexpected(Failure());
    return entry;
}

Expected<PhysicsWorldConfigComponentCookEntry> ParsePhysicsWorldConfigComponentCookMetadata(in Name virtualPath, in Path file, in MetascriptValue value){
    PhysicsWorldConfigComponentCookEntry entry;
    if(!ValidateOptionalSceneMetadataMap(file, value, s_PhysicsWorldConfigComponentDiagnosticPrefix)
        || !AssignCookEntryVirtualPath(virtualPath, file, s_PhysicsWorldConfigComponentDiagnosticPrefix, entry))
        return MakeUnexpected(Failure());

    if(value.isMap()){
        if(!value.forEachMapEntry(lambda[in file, mut entry](in StringView key, in MetascriptValue fieldVal) -> b8{
            if(key == "backend_mode"){
                const Expected<StringView> text = ReadPhysicsStringValue(file, fieldVal, s_PhysicsWorldConfigComponentDiagnosticPrefix, "backend_mode");
                if(!text.has_value())
                    return false;
                if(text.value() == "auto") entry.component.backendMode = PhysicsBackendMode::Auto;
                else if(text.value() == "cpu_only") entry.component.backendMode = PhysicsBackendMode::CpuOnly;
                else if(text.value() == "gpu_preferred") entry.component.backendMode = PhysicsBackendMode::GpuPreferred;
                else{
                    error("{} '{}': field 'backend_mode' must be 'auto', 'cpu_only', or 'gpu_preferred'", s_PhysicsWorldConfigComponentDiagnosticPrefix, PathToString(file));
                    return false;
                }
                return true;
            }
            if(key == "gravity"){
                const Expected<VectorSingle> v = DecodePhysicsFloat3Value(file, fieldVal, s_PhysicsWorldConfigComponentDiagnosticPrefix, key);
                if(!v.has_value())
                    return false;
                entry.component.gravity = f32x4(v.value(), 0.0f);
                return true;
            }
            if(key == "restitution_threshold") return ReadPhysicsF32Value(file, fieldVal, s_PhysicsWorldConfigComponentDiagnosticPrefix, key, entry.component.restitutionThreshold);
            if(key == "hit_event_threshold") return ReadPhysicsF32Value(file, fieldVal, s_PhysicsWorldConfigComponentDiagnosticPrefix, key, entry.component.hitEventThreshold);
            if(key == "contact_hertz") return ReadPhysicsF32Value(file, fieldVal, s_PhysicsWorldConfigComponentDiagnosticPrefix, key, entry.component.contactHertz);
            if(key == "contact_damping_ratio") return ReadPhysicsF32Value(file, fieldVal, s_PhysicsWorldConfigComponentDiagnosticPrefix, key, entry.component.contactDampingRatio);
            if(key == "max_linear_velocity") return ReadPhysicsF32Value(file, fieldVal, s_PhysicsWorldConfigComponentDiagnosticPrefix, key, entry.component.maxLinearVelocity);
            if(key == "fixed_delta_time") return ReadPhysicsF32Value(file, fieldVal, s_PhysicsWorldConfigComponentDiagnosticPrefix, key, entry.component.fixedDeltaTime);
            if(key == "sub_step_count") return ReadPhysicsU32Value(file, fieldVal, s_PhysicsWorldConfigComponentDiagnosticPrefix, key, entry.component.subStepCount);
            if(key == "max_sub_steps_per_frame") return ReadPhysicsU32Value(file, fieldVal, s_PhysicsWorldConfigComponentDiagnosticPrefix, key, entry.component.maxSubStepsPerFrame);
            if(key == "gpu_dispatch_threshold") return ReadPhysicsU32Value(file, fieldVal, s_PhysicsWorldConfigComponentDiagnosticPrefix, key, entry.component.gpuDispatchThreshold);
            if(key == "gpu_workload_fraction") return ReadPhysicsF32Value(file, fieldVal, s_PhysicsWorldConfigComponentDiagnosticPrefix, key, entry.component.gpuWorkloadFraction);
            if(key == "enable_sleep") return ReadPhysicsBoolValue(file, fieldVal, s_PhysicsWorldConfigComponentDiagnosticPrefix, key, entry.component.enableSleep);
            if(key == "enable_continuous") return ReadPhysicsBoolValue(file, fieldVal, s_PhysicsWorldConfigComponentDiagnosticPrefix, key, entry.component.enableContinuous);
            if(key == "enable_contact_softening") return ReadPhysicsBoolValue(file, fieldVal, s_PhysicsWorldConfigComponentDiagnosticPrefix, key, entry.component.enableContactSoftening);
            if(key == "enable_warm_starting") return ReadPhysicsBoolValue(file, fieldVal, s_PhysicsWorldConfigComponentDiagnosticPrefix, key, entry.component.enableWarmStarting);
            if(key == "paused") return ReadPhysicsBoolValue(file, fieldVal, s_PhysicsWorldConfigComponentDiagnosticPrefix, key, entry.component.paused);
            error("{} '{}': unsupported asset field '{}'", s_PhysicsWorldConfigComponentDiagnosticPrefix, PathToString(file), key);
            return false;
        }))
            return MakeUnexpected(Failure());
    }

    if(!PhysicsComponentBinaryCodec().validateWorldConfig(entry.component, entry.virtualPath))
        return MakeUnexpected(Failure());
    return entry;
}

Expected<PhysicsParentComponentCookEntry> ParsePhysicsParentComponentCookMetadata(in Name virtualPath, in Path file, in MetascriptValue value){
    PhysicsParentComponentCookEntry entry;
    if(!ValidateOptionalSceneMetadataMap(file, value, s_PhysicsParentComponentDiagnosticPrefix)
        || !AssignCookEntryVirtualPath(virtualPath, file, s_PhysicsParentComponentDiagnosticPrefix, entry))
        return MakeUnexpected(Failure());

    if(value.isMap()){
        if(!value.forEachMapEntry(lambda[in file, mut entry](in StringView key, in MetascriptValue fieldVal) -> b8{
            if(key == "parent_entity") return ReadPhysicsNameValue(file, fieldVal, s_PhysicsParentComponentDiagnosticPrefix, key, entry.component.parentEntityName);
            if(key == "inherit_scale") return ReadPhysicsBoolValue(file, fieldVal, s_PhysicsParentComponentDiagnosticPrefix, key, entry.component.inheritScale);
            error("{} '{}': unsupported asset field '{}'", s_PhysicsParentComponentDiagnosticPrefix, PathToString(file), key);
            return false;
        }))
            return MakeUnexpected(Failure());
    }

    if(!PhysicsComponentBinaryCodec().validatePhysicsParent(entry.component, entry.virtualPath))
        return MakeUnexpected(Failure());
    return entry;
}


