    byte = self.m_geometry.verticalTarget(byte.value(), false, 50.0f);
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 8u);
    byte = self.m_geometry.verticalTarget(byte.value(), false, 50.0f);
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 5u);
    byte = self.m_geometry.verticalTarget(0u, true, 5.0f);
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 7u);
    byte = self.m_geometry.verticalTarget(0u, true, 5.01f);
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 8u);
}

