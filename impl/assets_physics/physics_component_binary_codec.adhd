const u16 s_RigidBodyFlagEnableSleep = 0x0001u;
const u16 s_RigidBodyFlagIsAwake = 0x0002u;
const u16 s_RigidBodyFlagIsBullet = 0x0004u;
const u16 s_RigidBodyFlagIsEnabled = 0x0008u;
const u16 s_RigidBodyFlagAllowFastRotation = 0x0010u;
const u16 s_RigidBodyFlagEnableGyroscopic = 0x0020u;
const u16 s_RigidBodyFlagDriveKinematic = 0x0040u;
const u16 s_RigidBodyFlagUseCustomMass = 0x0080u;
const u16 s_RigidBodyFlagHasCustomMaxAngVel = 0x0100u;

const u16 s_ColliderFlagIsBox = 0x0001u;
const u16 s_ColliderFlagIsSensor = 0x0002u;
const u16 s_ColliderFlagContactEvents = 0x0004u;
const u16 s_ColliderFlagHitEvents = 0x0008u;
const u16 s_ColliderFlagSensorEvents = 0x0010u;
const u16 s_ColliderFlagPreSolveEvents = 0x0020u;
const u16 s_ColliderFlagInvokeCreation = 0x0040u;
const u16 s_ColliderFlagCullBackfaces = 0x0080u;
const u16 s_ColliderFlagAutoConvexDecompose = 0x0100u;
const u16 s_ColliderFlagIsChain = 0x0200u;
const u16 s_ColliderFlagChainClosed = 0x0400u;
const u16 s_ColliderFlagHeightfieldFlipDiagonal = 0x0800u;
const u16 s_ColliderFlagVhacdEnableArbitraryPlanes = 0x1000u;
const u16 s_ColliderFlagVhacdEnableHullMerging = 0x2000u;
const u16 s_ColliderFlagSyncCsgCuts = 0x4000u;
const u16 s_ColliderFlagUseMeshComponentFallback = 0x8000u;

const u16 s_JointFlagUseRefRotation = 0x0001u;
const u16 s_JointFlagEnableLimit = 0x0002u;
const u16 s_JointFlagEnableMotor = 0x0004u;
const u16 s_JointFlagEnableSpring = 0x0008u;
const u16 s_JointFlagCollideConnected = 0x0010u;
const u16 s_JointFlagEnabled = 0x0020u;
const u16 s_JointFlagEnableProjection = 0x0040u;
const u16 s_JointFlagPathClosed = 0x0080u;
const u16 s_JointFlagPathLockRotation = 0x0100u;
const u16 s_JointFlagEnableTwistLimit = 0x0200u;
const u16 s_JointFlagEnableSlerpDrive = 0x0400u;
const u8 s_SixDofAxisFlagEnableMotor = 0x01u;
const u8 s_SixDofAxisFlagEnableSpring = 0x02u;

const u8 s_PhysicsParentFlagInheritScale = 0x01u;
const u8 s_PhysicsParentFlagAttachColliderToParent = 0x02u;

const u16 s_WorldCfgFlagEnableSleep = 0x0001u;
const u16 s_WorldCfgFlagEnableContinuous = 0x0002u;
const u16 s_WorldCfgFlagContactSoftening = 0x0004u;
const u16 s_WorldCfgFlagWarmStarting = 0x0008u;
const u16 s_WorldCfgFlagPaused = 0x0010u;
const u16 s_WorldCfgFlagEnableGpuCollision = 0x0020u;
const u16 s_WorldCfgFlagForceGpuCollision = 0x0040u;
const u16 s_WorldCfgFlagGpuResidentMode = 0x0080u;
const u16 s_WorldCfgFlagUseGpuLbvhBroadphase = 0x0100u;
const u16 s_WorldCfgFlagInterpolateTransforms = 0x0200u;
const u16 s_WorldCfgFlagPublishEventsToMessageBus = 0x0400u;
const u16 s_WorldCfgFlagPublishContinuousEventsToMessageBus = 0x0800u;


b8 ValidateSixDofAxes(in Array<SixDofAxisConfig, 6u> axes){
    for(usize k = 0u; k < 6u; ++k){
        in SixDofAxisConfig cfg = axes[k];
        if(cast<u8>(cfg.motion) >= cast<u8>(JointMotion::kCount))
            return false;
        if(!IsFinite(VectorSingle(cfg.lowerLimit, cfg.upperLimit, cfg.motorTargetVelocity, cfg.motorTargetPosition)))
            return false;
        if(!IsFinite(VectorSingle(cfg.maxMotorForce, cfg.springHertz, cfg.springDampingRatio, 0.0f)))
            return false;
        if(cfg.upperLimit < cfg.lowerLimit || cfg.maxMotorForce < 0.0f || cfg.springHertz < 0.0f || cfg.springDampingRatio < 0.0f)
            return false;
    }
    return true;
}

void PackSixDofAxesBinary(
    in Array<SixDofAxisConfig, 6u> axes,
    mut Array<u8, 8u> outMotions,
    mut Array<u8, 8u> outFlags,
    mut Array<f32, 42u> outParams
){
    for(usize k = 0u; k < 6u; ++k){
        in SixDofAxisConfig cfg = axes[k];
        outMotions[k] = cast<u8>(cfg.motion);
        u8 axisFlags = 0u;
        if(cfg.enableMotor) axisFlags |= s_SixDofAxisFlagEnableMotor;
        if(cfg.enableSpring) axisFlags |= s_SixDofAxisFlagEnableSpring;
        outFlags[k] = axisFlags;
        const usize pBase = k * 7u;
        outParams[pBase + 0u] = cfg.lowerLimit;
        outParams[pBase + 1u] = cfg.upperLimit;
        outParams[pBase + 2u] = cfg.motorTargetVelocity;
        outParams[pBase + 3u] = cfg.motorTargetPosition;
        outParams[pBase + 4u] = cfg.maxMotorForce;
        outParams[pBase + 5u] = cfg.springHertz;
        outParams[pBase + 6u] = cfg.springDampingRatio;
    }
}

b8 UnpackSixDofAxesBinary(
    in Array<u8, 8u> motions,
    in Array<u8, 8u> flags,
    in Array<f32, 42u> params,
    mut Array<SixDofAxisConfig, 6u> outAxes
){
    for(usize k = 0u; k < 6u; ++k){
        if(motions[k] >= cast<u8>(JointMotion::kCount) || (flags[k] & 0xfcu) != 0u)
            return false;
        mut SixDofAxisConfig cfg = outAxes[k];
        cfg.motion = cast<JointMotion>(motions[k]);
        cfg.enableMotor = (flags[k] & s_SixDofAxisFlagEnableMotor) != 0u;
        cfg.enableSpring = (flags[k] & s_SixDofAxisFlagEnableSpring) != 0u;
        const usize pBase = k * 7u;
        cfg.lowerLimit = params[pBase + 0u];
        cfg.upperLimit = params[pBase + 1u];
        cfg.motorTargetVelocity = params[pBase + 2u];
        cfg.motorTargetPosition = params[pBase + 3u];
        cfg.maxMotorForce = params[pBase + 4u];
        cfg.springHertz = params[pBase + 5u];
        cfg.springDampingRatio = params[pBase + 6u];
    }
    return true;
}


class PhysicsComponentBinaryCodec{
    private b8 validRigidBodyData(in RigidBodyComponent c)const{
        if(cast<u8>(c.type) > cast<u8>(BodyType::Dynamic))
            return false;
        if((c.motionLocks & ~0x3Fu) != 0u)
            return false;
        if(!IsFinite(VectorSingle(c.linearVelocity)) || !IsFinite(VectorSingle(c.angularVelocity)))
            return false;
        if(!IsFinite(VectorSingle(c.linearDamping, c.angularDamping, c.gravityScale, c.sleepThreshold)))
            return false;
        if(!IsFinite(VectorSingle(c.maxAngularVelocity)) || c.maxAngularVelocity < 0.0f)
            return false;
        if(c.linearDamping < 0.0f || c.angularDamping < 0.0f || c.sleepThreshold < 0.0f)
            return false;
        if(!IsFinite(VectorSingle(c.customMass))
            || !IsFinite(VectorSingle(c.customCenterOfMass))
            || !IsFinite(VectorSingle(c.customInertiaDiag))
            || !IsFinite(VectorSingle(c.customInertiaOffDiag)))
            return false;
        if(c.useCustomMass){
            if(c.customMass <= 0.0f)
                return false;
            if(c.customInertiaDiag.x < 0.0f || c.customInertiaDiag.y < 0.0f || c.customInertiaDiag.z < 0.0f)
                return false;
        }
        return true;
    }

    private b8 validColliderEntryHeaderFields(
        in ColliderShapeEntry e,
        in usize chainPointCount,
        in usize hullPointCount,
        in usize meshVertexCount,
        in usize meshIndexCount,
        in usize heightfieldCount,
        in usize heightfieldMaterialCount,
        in usize heightfieldCellMaterialCount,
        in usize heightfieldCellHoleByteCount
    )const{
        if(cast<u8>(e.shapeType) >= cast<u8>(ShapeType::kCount))
            return false;
        const VectorSingle center(e.center);
        const VectorSingle center2(e.center2);
        const VectorSingle halfExtents(e.halfExtents);
        const VectorSingle localRotation(e.localRotation);
        const VectorSingle anisotropicFriction(e.anisotropicFriction);
        const VectorSingle surfaceVelocity(e.surfaceVelocity);
        const VectorSingle frictionDirection(e.frictionDirection);
        const VectorSingle planeNormalOffset(e.planeNormalOffset);
        const VectorSingle heightfieldScale(e.heightfieldScale);
        if(!IsValidPositionVec3(center) || !IsFinite(center2) || !IsFinite(halfExtents) || !IsFinite(localRotation))
            return false;
        if(LengthSq(localRotation) <= s_NormalizeEpsilonSq)
            return false;
        if(!IsFinite(VectorSingle(e.radius, e.skinRadius, e.density, e.friction)))
            return false;
        if(!IsFinite(VectorSingle(e.restitution, e.rollingResistance, e.tangentSpeed, e.staticFriction)))
            return false;
        if(!IsFinite(anisotropicFriction) || !IsFinite(surfaceVelocity) || !IsFinite(frictionDirection) || !IsFinite(planeNormalOffset) || !IsFinite(heightfieldScale))
            return false;
        if(!IsFinite(VectorSingle(e.cylinderHalfHeight, e.topRadius, e.heightfieldThickness, e.chainRadius)))
            return false;
        if(!IsFinite(VectorSingle(e.vhacdConcavityThreshold, e.vhacdMinVolumeRatio, e.vhacdMergeVolumeTolerance, 0.0f)))
            return false;
        if(cast<u8>(e.frictionCombineMode) >= cast<u8>(MaterialCombineMode::kCount) || cast<u8>(e.restitutionCombineMode) >= cast<u8>(MaterialCombineMode::kCount))
            return false;
        if(anisotropicFriction.x < 0.0f || anisotropicFriction.y < 0.0f || anisotropicFriction.z < 0.0f)
            return false;
        if(e.staticFriction < 0.0f && e.staticFriction != -1.0f)
            return false;
        if(e.vhacdMaxHulls < 1u || e.vhacdMaxRecursionDepth < 1u || e.vhacdMaxVerticesPerHull < 4u || e.vhacdConcavityThreshold < 0.0f || e.vhacdMinVolumeRatio < 0.0f || e.vhacdMergeVolumeTolerance < 0.0f)
            return false;
        if(e.cylinderHalfHeight <= 0.0f || e.topRadius < 0.0f || e.heightfieldThickness < 0.0f || e.chainRadius < 0.0f)
            return false;
        if(LengthSq(VectorSingle(planeNormalOffset.x, planeNormalOffset.y, planeNormalOffset.z, 0.0f)) <= s_NormalizeEpsilonSq || Abs(planeNormalOffset).w > s_HugeCoordinate)
            return false;
        if(e.shapeType == ShapeType::Plane){
            if(halfExtents.x < 0.0f || halfExtents.z < 0.0f || (halfExtents.x > 0.0f) != (halfExtents.z > 0.0f))
                return false;
        }
        if(heightfieldScale.x <= 0.0f || heightfieldScale.z <= 0.0f)
            return false;
        if(e.radius < 0.0f || e.skinRadius < 0.0f || e.density < 0.0f || e.friction < 0.0f || e.restitution < 0.0f || e.rollingResistance < 0.0f)
            return false;
        if((e.shapeType == ShapeType::Sphere || e.shapeType == ShapeType::Capsule || e.shapeType == ShapeType::Cylinder || e.shapeType == ShapeType::Cone || e.shapeType == ShapeType::TaperedCapsule) && e.radius <= 0.0f)
            return false;
        if(e.shapeType == ShapeType::Capsule || e.shapeType == ShapeType::TaperedCapsule || (e.shapeType == ShapeType::Segment && !e.isChain)){
            if(!IsValidPositionVec3(center2))
                return false;
            const VectorSingle lenSq = Vector3LengthSq(center2 - center);
            if(!IsFinite(lenSq) || lenSq.x < s_MinCapsuleLength * s_MinCapsuleLength)
                return false;
        }
        if(e.isChain){
            if(e.shapeType != ShapeType::Segment || chainPointCount < 2u)
                return false;
        }
        if(e.shapeType == ShapeType::TaperedCapsule && e.topRadius <= 0.0f)
            return false;
        if(e.shapeType == ShapeType::Hull && !e.convexHullAsset.valid() && !e.compoundHullAsset.valid()){
            if(e.isBox && (halfExtents.x <= 0.0f || halfExtents.y <= 0.0f || halfExtents.z <= 0.0f))
                return false;
            if(!e.isBox && !e.useMeshComponentFallback && !e.meshAsset.valid() && hullPointCount < 4u)
                return false;
        }
        else if(e.shapeType == ShapeType::Mesh){
            if(!e.useMeshComponentFallback && !e.meshAsset.valid() && !e.collisionMeshAsset.valid() && !e.compoundHullAsset.valid() && (meshVertexCount == 0u || meshIndexCount == 0u))
                return false;
            if((meshIndexCount % 3u) != 0u)
                return false;
        }
        const b8 hasInlineHeightfield = (heightfieldCount > 0u || e.heightfieldRows != 0u || e.heightfieldCols != 0u);
        if(hasInlineHeightfield || (e.shapeType == ShapeType::Heightfield && !e.heightfieldAsset.valid())){
            if(e.heightfieldRows < 2u || e.heightfieldCols < 2u)
                return false;
            if(cast<u64>(e.heightfieldRows) * cast<u64>(e.heightfieldCols) != cast<u64>(heightfieldCount))
                return false;
        }
        if(heightfieldCellMaterialCount > 0u){
            if(heightfieldMaterialCount == 0u || e.heightfieldRows < 2u || e.heightfieldCols < 2u)
                return false;
            const u64 expectedCells = cast<u64>(e.heightfieldRows - 1u) * cast<u64>(e.heightfieldCols - 1u);
            if(cast<u64>(heightfieldCellMaterialCount) != expectedCells)
                return false;
        }
        if(heightfieldCellHoleByteCount > 0u){
            if(e.heightfieldRows < 2u || e.heightfieldCols < 2u)
                return false;
            const u64 expectedCells = cast<u64>(e.heightfieldRows - 1u) * cast<u64>(e.heightfieldCols - 1u);
            const u64 expectedHoleBytes = (expectedCells + 7u) / 8u;
            if(cast<u64>(heightfieldCellHoleByteCount) != expectedHoleBytes)
                return false;
        }
        return true;
    }

    private b8 validColliderEntryNonMaterialArrayFields(in ColliderShapeEntry e)const{
        if(e.shapeType == ShapeType::Hull && !e.isBox && !e.convexHullAsset.valid() && !e.compoundHullAsset.valid()){
            for(usize i = 0u; i < e.hullPoints.size(); ++i){
                if(!IsValidPositionVec3(VectorSingle(e.hullPoints[i])))
                    return false;
            }
        }
        else if(e.shapeType == ShapeType::Mesh){
            for(usize i = 0u; i < e.meshVertices.size(); ++i){
                if(!IsValidPositionVec3(VectorSingle(e.meshVertices[i])))
                    return false;
            }
            if(!e.meshVertices.empty()){
                const usize vCount = e.meshVertices.size();
                for(usize i = 0u; i < e.meshIndices.size(); ++i){
                    if(cast<usize>(e.meshIndices[i]) >= vCount)
                        return false;
                }
            }
        }
        for(usize i = 0u; i < e.heightfieldHeights.size(); ++i){
            const f32 h = e.heightfieldHeights[i];
            if(!IsFinite(VectorSingle(h)) && h == h)
                return false;
        }
        const usize matCount = e.heightfieldMaterials.size();
        for(usize i = 0u; i < e.heightfieldCellMaterialIndices.size(); ++i){
            if(cast<usize>(e.heightfieldCellMaterialIndices[i]) >= matCount)
                return false;
        }
        for(usize i = 0u; i < e.chainPoints.size(); ++i){
            if(!IsValidPositionVec3(VectorSingle(e.chainPoints[i])))
                return false;
        }
        return true;
    }

    private b8 validColliderEntryData(in ColliderShapeEntry e)const{
        if(!this.validColliderEntryHeaderFields(
            e,
            e.chainPoints.size(),
            e.hullPoints.size(),
            e.meshVertices.size(),
            e.meshIndices.size(),
            e.heightfieldHeights.size(),
            e.heightfieldMaterials.size(),
            e.heightfieldCellMaterialIndices.size(),
            e.heightfieldCellHoles.size()
        ))
            return false;
        if(!this.validColliderEntryNonMaterialArrayFields(e))
            return false;
        PhysicsAssetBinaryCodec assetCodec;
        for(usize i = 0u; i < e.heightfieldMaterials.size(); ++i){
            if(!assetCodec.validSurfaceMaterial(e.heightfieldMaterials[i]))
                return false;
        }
        return true;
    }

    private usize colliderEntrySerializedBytes(in ColliderShapeEntry e)const{
        return size_of<ColliderShapeEntryHeaderBinary>()
            + e.hullPoints.size() * size_of<PhysicsVec4Binary>()
            + e.meshVertices.size() * size_of<PhysicsVec4Binary>()
            + e.meshIndices.size() * size_of<PhysicsU32Binary>()
            + e.heightfieldHeights.size() * size_of<f32>()
            + e.heightfieldMaterials.size() * size_of<PhysicsSurfaceMaterialBinary>()
            + e.heightfieldCellMaterialIndices.size() * size_of<CollisionMeshU16Binary>()
            + e.chainPoints.size() * size_of<PhysicsVec4Binary>()
            + e.heightfieldCellHoles.size();
    }

    private b8 validJointEntry(in JointEntry j)const{
        in JointSettings s = j.settings;
        if(cast<u8>(s.type) >= cast<u8>(JointType::kCount) || s.sixDofAxes.size() != 6u)
            return false;
        if(cast<u8>(s.sixDofSwingLimitMode) >= cast<u8>(SixDofSwingLimitMode::kCount))
            return false;
        const VectorSingle localAnchorA(s.localAnchorA);
        const VectorSingle localAnchorB(s.localAnchorB);
        const VectorSingle localAxisA(s.localAxisA);
        const VectorSingle localAxisB(s.localAxisB);
        const VectorSingle referenceRotation(s.referenceRotation);
        const VectorSingle targetOrientation(s.targetOrientation);
        const VectorSingle linearOffset(s.linearOffset);
        const VectorSingle groundAnchorA(s.groundAnchorA);
        const VectorSingle groundAnchorB(s.groundAnchorB);
        if(!IsFinite(localAnchorA) || !IsFinite(localAnchorB) || !IsFinite(localAxisA) || !IsFinite(localAxisB))
            return false;
        if(!IsFinite(referenceRotation) || LengthSq(referenceRotation) <= s_NormalizeEpsilonSq)
            return false;
        if(!IsFinite(targetOrientation) || LengthSq(targetOrientation) <= s_NormalizeEpsilonSq)
            return false;
        if(!IsFinite(linearOffset) || !IsFinite(groundAnchorA) || !IsFinite(groundAnchorB))
            return false;
        if(!IsFinite(VectorSingle(s.length, s.minLength, s.maxLength, s.lowerLimit)))
            return false;
        if(!IsFinite(VectorSingle(s.upperLimit, s.motorSpeed, s.maxMotorForce, s.hertz)))
            return false;
        if(!IsFinite(VectorSingle(s.dampingRatio, s.correctionFactor, s.maxTorque, s.swingLimit)))
            return false;
        if(!IsFinite(VectorSingle(s.suspensionHertz, s.suspensionDampingRatio, s.breakForce, s.breakTorque)))
            return false;
        if(!IsFinite(VectorSingle(s.projectionLinearTolerance, s.projectionAngularTolerance, s.invMassScaleA, s.invMassScaleB)))
            return false;
        if(!IsFinite(VectorSingle(s.invInertiaScaleA, s.invInertiaScaleB, s.limitRestitution, s.limitHertz)))
            return false;
        if(!IsFinite(VectorSingle(s.limitDampingRatio, s.swingLimitY, s.springTarget, s.steeringAngle)))
            return false;
        if(!IsFinite(VectorSingle(s.suspensionRestLength, s.ratio, s.lengthA, s.lengthB)))
            return false;
        if(!IsFinite(VectorSingle(s.slerpHertz, s.slerpDampingRatio, s.slerpMaxTorque, 0.0f)))
            return false;
        if(!IsFinite(VectorSingle(s.sixDofSwingLimitY, s.sixDofSwingLimitZ, 0.0f, 0.0f)))
            return false;
        if(!(s.lowerLimit <= s.upperLimit
            && s.length >= 0.0f
            && s.minLength >= 0.0f
            && s.maxLength >= s.minLength
            && s.maxMotorForce >= 0.0f
            && s.hertz >= 0.0f
            && s.dampingRatio >= 0.0f
            && s.correctionFactor >= 0.0f
            && s.correctionFactor <= 1.0f
            && s.maxTorque >= 0.0f
            && s.swingLimit >= 0.0f
            && s.swingLimitY >= 0.0f
            && s.suspensionHertz >= 0.0f
            && s.suspensionDampingRatio >= 0.0f
            && s.suspensionRestLength >= 0.0f
            && s.breakForce >= 0.0f
            && s.breakTorque >= 0.0f
            && s.projectionLinearTolerance >= 0.0f
            && s.projectionAngularTolerance >= 0.0f
            && s.invMassScaleA >= 0.0f
            && s.invMassScaleB >= 0.0f
            && s.invInertiaScaleA >= 0.0f
            && s.invInertiaScaleB >= 0.0f
            && s.limitRestitution >= 0.0f
            && s.limitRestitution <= 1.0f
            && s.limitHertz >= 0.0f
            && s.limitDampingRatio >= 0.0f
            && s.lengthA >= 0.0f
            && s.lengthB >= 0.0f
            && s.slerpHertz >= 0.0f
            && s.slerpDampingRatio >= 0.0f
            && s.slerpMaxTorque >= 0.0f
            && s.sixDofSwingLimitY >= 0.0f
            && s.sixDofSwingLimitZ >= 0.0f
        ))
            return false;
        if((s.type == JointType::Gear || s.type == JointType::RackAndPinion) && Abs(VectorSingle(s.ratio)).x <= 1.0e-7f)
            return false;
        if(s.type == JointType::Pulley && s.ratio <= 0.0f)
            return false;
        if(!ValidateSixDofAxes(s.sixDofAxes))
            return false;
        for(usize pi = 0u; pi < j.pathPoints.size(); ++pi){
            if(!IsValidPositionVec3(VectorSingle(j.pathPoints[pi])))
                return false;
        }
        if(s.type == JointType::Path && j.pathPoints.size() < 2u)
            return false;
        const b8 needsAxisA =
            (s.type == JointType::Spherical)
            || (s.type == JointType::Revolute)
            || (s.type == JointType::Prismatic)
            || (s.type == JointType::Wheel)
            || (s.type == JointType::Gear)
            || (s.type == JointType::RackAndPinion)
        ;
        const b8 needsAxisB =
            (s.type == JointType::Spherical)
            || (s.type == JointType::Revolute)
            || (s.type == JointType::Wheel)
            || (s.type == JointType::Gear)
            || (s.type == JointType::RackAndPinion)
            || (s.type == JointType::Path && s.pathLockRotation)
        ;
        if(needsAxisA && Vector3LengthSq(VectorSingle(localAxisA, 0.0f)).x <= s_NormalizeEpsilonSq)
            return false;
        if(needsAxisB && Vector3LengthSq(VectorSingle(localAxisB, 0.0f)).x <= s_NormalizeEpsilonSq)
            return false;
        return true;
    }

    private b8 validJointData(in JointComponent j)const{
        if(!this.validJointEntry(j.primaryJoint))
            return false;
        for(usize i = 0u; i < j.extraJoints.size(); ++i){
            if(!this.validJointEntry(j.extraJoints[i]))
                return false;
        }
        return true;
    }

    private b8 validWorldConfigData(in PhysicsWorldConfigComponent w)const{
        if(cast<u8>(w.backendMode) > cast<u8>(PhysicsBackendMode::GpuPreferred))
            return false;
        if(!IsFinite(VectorSingle(w.gravity)))
            return false;
        if(!IsFinite(VectorSingle(w.restitutionThreshold, w.hitEventThreshold, w.contactHertz, w.contactDampingRatio)))
            return false;
        if(!IsFinite(VectorSingle(w.maxLinearVelocity, w.fixedDeltaTime, w.gpuWorkloadFraction, w.timeToSleep)))
            return false;
        return w.restitutionThreshold >= 0.0f && w.hitEventThreshold >= 0.0f && w.fixedDeltaTime > 0.0f && w.subStepCount >= 1u && w.maxSubStepsPerFrame >= 1u && w.contactHertz > 0.0f && w.contactDampingRatio >= 0.0f && w.maxLinearVelocity > 0.0f && w.timeToSleep > 0.0f && w.gpuWorkloadFraction >= 0.0f && w.gpuWorkloadFraction <= 1.0f;
    }

    private b8 validPhysicsParentData(in PhysicsParentComponent p)const{
        return true;
    }

    public b8 validateRigidBody(in RigidBodyComponent c, in Name virtualPath)const{
        if(this.validRigidBodyData(c))
            return true;
        error("RigidBodyComponentAsset::validatePayload failed: invalid rigid body config for '{}'", virtualPath.resolvedText());
        return false;
    }

    public b8 appendRigidBodyValidated(in RigidBodyComponent c, mut Vector<u8> outBinary)const{
        static_assert(size_of<RigidBodyComponentPayloadBinary>() == 192u && offset_of<RigidBodyComponentPayloadBinary>(reserved1) == 184u);
        const usize reqBytes = size_of<RigidBodyComponentPayloadBinary>();
        if(!CanAppendBytes(outBinary, reqBytes))
            return false;
        RigidBodyComponentPayloadBinary bin;
        bin.bodyType = cast<u8>(c.type);
        u16 flags = 0u;
        if(c.enableSleep) flags |= s_RigidBodyFlagEnableSleep;
        if(c.isAwake) flags |= s_RigidBodyFlagIsAwake;
        if(c.isBullet) flags |= s_RigidBodyFlagIsBullet;
        if(c.isEnabled) flags |= s_RigidBodyFlagIsEnabled;
        if(c.allowFastRotation) flags |= s_RigidBodyFlagAllowFastRotation;
        if(c.enableGyroscopicTorque) flags |= s_RigidBodyFlagEnableGyroscopic;
        if(c.driveKinematicFromTransform) flags |= s_RigidBodyFlagDriveKinematic;
        if(c.useCustomMass) flags |= s_RigidBodyFlagUseCustomMass;
        if(c.hasCustomMaxAngularVelocity) flags |= s_RigidBodyFlagHasCustomMaxAngVel;
        bin.flags = flags;
        bin.motionLocks = c.motionLocks;
        bin.linearVelocity = c.linearVelocity;
        bin.angularVelocity = c.angularVelocity;
        bin.linearDamping = c.linearDamping;
        bin.angularDamping = c.angularDamping;
        bin.gravityScale = c.gravityScale;
        bin.sleepThreshold = c.sleepThreshold;
        bin.maxAngularVelocity = c.maxAngularVelocity;
        bin.userData = c.userData;
        bin.entityTagHash = c.entityTag.hash();
        bin.customMass = c.customMass;
        bin.customCenterOfMass = c.customCenterOfMass;
        bin.customInertiaDiag = c.customInertiaDiag;
        bin.customInertiaOffDiag = c.customInertiaOffDiag;
        outBinary.reserve(outBinary.size() + reqBytes);
        AppendPOD(outBinary, bin);
        return true;
    }

    public b8 serializeRigidBody(in RigidBodyComponent c, mut Vector<u8> outPayload)const{
        if(!this.validRigidBodyData(c))
            return false;
        outPayload.clear();
        return this.appendRigidBodyValidated(c, outPayload);
    }

    public Expected<RigidBodyComponent> deserializeRigidBody(in Span<u8> payload)const{
        usize cursor = 0u;
        const Expected<RigidBodyComponentPayloadBinary> res = ReadPOD<RigidBodyComponentPayloadBinary>(payload, cursor);
        if(!res.has_value() || cursor != payload.size()){
            error("RigidBodyComponentAsset::loadComponentPayload failed: invalid payload size");
            return MakeUnexpected(Failure());
        }
        in RigidBodyComponentPayloadBinary bin = res.value();
        if(bin.reserved0 != 0u || bin.reserved1 != 0u || (bin.flags & 0xfe00u) != 0u){
            error("RigidBodyComponentAsset::loadComponentPayload failed: unsupported flags or non-zero reserved bits");
            return MakeUnexpected(Failure());
        }
        RigidBodyComponent c;
        c.type = cast<BodyType>(bin.bodyType);
        c.enableSleep = (bin.flags & s_RigidBodyFlagEnableSleep) != 0u;
        c.isAwake = (bin.flags & s_RigidBodyFlagIsAwake) != 0u;
        c.isBullet = (bin.flags & s_RigidBodyFlagIsBullet) != 0u;
        c.isEnabled = (bin.flags & s_RigidBodyFlagIsEnabled) != 0u;
        c.allowFastRotation = (bin.flags & s_RigidBodyFlagAllowFastRotation) != 0u;
        c.enableGyroscopicTorque = (bin.flags & s_RigidBodyFlagEnableGyroscopic) != 0u;
        c.driveKinematicFromTransform = (bin.flags & s_RigidBodyFlagDriveKinematic) != 0u;
        c.useCustomMass = (bin.flags & s_RigidBodyFlagUseCustomMass) != 0u;
        c.hasCustomMaxAngularVelocity = (bin.flags & s_RigidBodyFlagHasCustomMaxAngVel) != 0u;
        c.motionLocks = bin.motionLocks;
        c.linearVelocity = bin.linearVelocity;
        c.angularVelocity = bin.angularVelocity;
        c.linearDamping = bin.linearDamping;
        c.angularDamping = bin.angularDamping;
        c.gravityScale = bin.gravityScale;
        c.sleepThreshold = bin.sleepThreshold;
        c.maxAngularVelocity = bin.maxAngularVelocity;
        c.userData = bin.userData;
        c.entityTag = DecodeOptionalPhysicsName(bin.entityTagHash);
        c.customMass = bin.customMass;
        c.customCenterOfMass = bin.customCenterOfMass;
        c.customInertiaDiag = bin.customInertiaDiag;
        c.customInertiaOffDiag = bin.customInertiaOffDiag;
        c.dirty = true;
        if(!this.validRigidBodyData(c)){
            error("RigidBodyComponentAsset::loadComponentPayload failed: invalid rigid body fields");
            return MakeUnexpected(Failure());
        }
        return c;
    }

    private b8 appendColliderEntryUnchecked(in ColliderShapeEntry e, mut Vector<u8> outPayload)const{
        if(
            e.hullPoints.size() > cast<usize>(u32.max)
            || e.meshVertices.size() > cast<usize>(u32.max)
            || e.meshIndices.size() > cast<usize>(u32.max)
            || e.heightfieldHeights.size() > cast<usize>(u32.max)
            || e.heightfieldMaterials.size() > cast<usize>(u32.max)
            || e.heightfieldCellMaterialIndices.size() > cast<usize>(u32.max)
            || e.chainPoints.size() > cast<usize>(u32.max)
            || e.heightfieldCellHoles.size() > cast<usize>(u32.max)
        )
            return false;
        static_assert(
            size_of<ColliderShapeEntryHeaderBinary>() == 752u
            && offset_of<ColliderShapeEntryHeaderBinary>(reserved5) == 744u
            && size_of<ColliderComponentPayloadHeaderBinary>() == 72u
            && offset_of<ColliderComponentPayloadHeaderBinary>(reserved0) == 68u
        );
        static_assert(
            size_of<PhysicsVec4Binary>() == size_of<f32x4>()
            && size_of<PhysicsU32Binary>() == size_of<u32>()
            && size_of<CollisionMeshU16Binary>() == size_of<u16>()
        );
        ColliderShapeEntryHeaderBinary hdr;
        hdr.center = e.center;
        hdr.center2 = e.center2;
        hdr.halfExtents = e.halfExtents;
        hdr.localRotation = e.localRotation;
        hdr.anisotropicFriction = e.anisotropicFriction;
        hdr.surfaceVelocity = e.surfaceVelocity;
        hdr.frictionDirection = e.frictionDirection;
        hdr.planeNormalOffset = e.planeNormalOffset;
        hdr.heightfieldScale = f32x4(VectorSingle(e.heightfieldScale), 0.0f);
        hdr.meshAssetHash = e.meshAsset.name().hash();
        hdr.materialAssetHash = e.materialAsset.name().hash();
        hdr.convexHullAssetHash = e.convexHullAsset.name().hash();
        hdr.compoundHullAssetHash = e.compoundHullAsset.name().hash();
        hdr.collisionMeshAssetHash = e.collisionMeshAsset.name().hash();
        hdr.heightfieldAssetHash = e.heightfieldAsset.name().hash();
        hdr.collisionLayerHash = e.collisionLayer.hash();
        hdr.userData = e.userData;
        hdr.groupIndex = e.groupIndex;
        hdr.categoryBits = e.categoryBits;
        hdr.maskBits = e.maskBits;
        hdr.radius = e.radius;
        hdr.skinRadius = e.skinRadius;
        hdr.density = e.density;
        hdr.friction = e.friction;
        hdr.restitution = e.restitution;
        hdr.rollingResistance = e.rollingResistance;
        hdr.tangentSpeed = e.tangentSpeed;
        hdr.staticFriction = e.staticFriction;
        hdr.vhacdMaxHulls = e.vhacdMaxHulls;
        hdr.cylinderHalfHeight = e.cylinderHalfHeight;
        hdr.topRadius = e.topRadius;
        hdr.heightfieldRows = e.heightfieldRows;
        hdr.heightfieldCols = e.heightfieldCols;
        hdr.heightfieldThickness = e.heightfieldThickness;
        hdr.chainRadius = e.chainRadius;
        hdr.hullPointCount = cast<u32>(e.hullPoints.size());
        hdr.meshVertexCount = cast<u32>(e.meshVertices.size());
        hdr.meshIndexCount = cast<u32>(e.meshIndices.size());
        hdr.heightfieldCount = cast<u32>(e.heightfieldHeights.size());
        hdr.heightfieldMaterialCount = cast<u32>(e.heightfieldMaterials.size());
        hdr.heightfieldCellMaterialCount = cast<u32>(e.heightfieldCellMaterialIndices.size());
        hdr.chainPointCount = cast<u32>(e.chainPoints.size());
        hdr.vhacdMaxRecursionDepth = e.vhacdMaxRecursionDepth;
        hdr.vhacdConcavityThreshold = e.vhacdConcavityThreshold;
        hdr.vhacdMaxVerticesPerHull = e.vhacdMaxVerticesPerHull;
        hdr.vhacdMinVolumeRatio = e.vhacdMinVolumeRatio;
        hdr.vhacdMergeVolumeTolerance = e.vhacdMergeVolumeTolerance;
        hdr.heightfieldCellHoleByteCount = cast<u32>(e.heightfieldCellHoles.size());
        u16 flags = 0u;
        if(e.isBox) flags |= s_ColliderFlagIsBox;
        if(e.isSensor) flags |= s_ColliderFlagIsSensor;
        if(e.enableContactEvents) flags |= s_ColliderFlagContactEvents;
        if(e.enableHitEvents) flags |= s_ColliderFlagHitEvents;
        if(e.enableSensorEvents) flags |= s_ColliderFlagSensorEvents;
        if(e.enablePreSolveEvents) flags |= s_ColliderFlagPreSolveEvents;
        if(e.invokeContactCreation) flags |= s_ColliderFlagInvokeCreation;
        if(e.cullBackfaces) flags |= s_ColliderFlagCullBackfaces;
        if(e.autoConvexDecompose) flags |= s_ColliderFlagAutoConvexDecompose;
        if(e.isChain) flags |= s_ColliderFlagIsChain;
        if(e.chainClosed) flags |= s_ColliderFlagChainClosed;
        if(e.heightfieldFlipDiagonal) flags |= s_ColliderFlagHeightfieldFlipDiagonal;
        if(e.vhacdEnableArbitraryPlanes) flags |= s_ColliderFlagVhacdEnableArbitraryPlanes;
        if(e.vhacdEnableHullMerging) flags |= s_ColliderFlagVhacdEnableHullMerging;
        if(e.syncCsgCuts) flags |= s_ColliderFlagSyncCsgCuts;
        if(e.useMeshComponentFallback) flags |= s_ColliderFlagUseMeshComponentFallback;
        hdr.flags = flags;
        hdr.shapeType = cast<u8>(e.shapeType);
        hdr.frictionCombineMode = cast<u8>(e.frictionCombineMode);
        hdr.restitutionCombineMode = cast<u8>(e.restitutionCombineMode);
        AppendPOD(outPayload, hdr);

        if(
            !AppendBinaryVectorPayload(outPayload, e.hullPoints).has_value()
            || !AppendBinaryVectorPayload(outPayload, e.meshVertices).has_value()
            || !AppendBinaryVectorPayload(outPayload, e.meshIndices).has_value()
            || !AppendBinaryVectorPayload(outPayload, e.heightfieldHeights).has_value()
        )
            return false;

        PhysicsAssetBinaryCodec assetCodec;
        for(usize mi = 0u; mi < e.heightfieldMaterials.size(); ++mi)
            AppendPOD(outPayload, assetCodec.packSurfaceMaterialFields(e.heightfieldMaterials[mi]));
        if(!AppendBinaryVectorPayload(outPayload, e.heightfieldCellMaterialIndices).has_value())
            return false;
        if(!AppendBinaryVectorPayload(outPayload, e.chainPoints).has_value())
            return false;
        return AppendBinaryVectorPayload(outPayload, e.heightfieldCellHoles).has_value();
    }

    private b8 deserializeColliderEntry(in Span<u8> payload, mut usize inOutCursor, mut ColliderShapeEntry outEntry)const{
        outEntry = ColliderShapeEntry();
        const Expected<ColliderShapeEntryHeaderBinary> hdrRes = ReadPOD<ColliderShapeEntryHeaderBinary>(payload, inOutCursor);
        if(!hdrRes.has_value())
            return false;
        in ColliderShapeEntryHeaderBinary hdr = hdrRes.value();
        if(
            hdr.reserved0 != 0u
            || hdr.reserved1 != 0u
            || hdr.reserved2 != 0u
            || hdr.reserved3 != 0u
            || hdr.reserved4 != 0u
            || hdr.reserved5 != 0u
            || hdr.frictionCombineMode >= cast<u8>(MaterialCombineMode::kCount)
            || hdr.restitutionCombineMode >= cast<u8>(MaterialCombineMode::kCount)
        )
            return false;

        const u64 remaining = cast<u64>(payload.size() - inOutCursor);
        const u64 vecBytes = (cast<u64>(hdr.hullPointCount) + cast<u64>(hdr.meshVertexCount) + cast<u64>(hdr.chainPointCount)) * cast<u64>(size_of<PhysicsVec4Binary>())
            + (cast<u64>(hdr.meshIndexCount) + cast<u64>(hdr.heightfieldCount)) * cast<u64>(size_of<PhysicsU32Binary>())
            + cast<u64>(hdr.heightfieldMaterialCount) * cast<u64>(size_of<PhysicsSurfaceMaterialBinary>())
            + cast<u64>(hdr.heightfieldCellMaterialCount) * cast<u64>(size_of<CollisionMeshU16Binary>())
            + cast<u64>(hdr.heightfieldCellHoleByteCount);
        if(vecBytes > remaining)
            return false;

        outEntry.shapeType = cast<ShapeType>(hdr.shapeType);
        outEntry.isBox = (hdr.flags & s_ColliderFlagIsBox) != 0u;
        outEntry.isSensor = (hdr.flags & s_ColliderFlagIsSensor) != 0u;
        outEntry.enableContactEvents = (hdr.flags & s_ColliderFlagContactEvents) != 0u;
        outEntry.enableHitEvents = (hdr.flags & s_ColliderFlagHitEvents) != 0u;
        outEntry.enableSensorEvents = (hdr.flags & s_ColliderFlagSensorEvents) != 0u;
        outEntry.enablePreSolveEvents = (hdr.flags & s_ColliderFlagPreSolveEvents) != 0u;
        outEntry.invokeContactCreation = (hdr.flags & s_ColliderFlagInvokeCreation) != 0u;
        outEntry.cullBackfaces = (hdr.flags & s_ColliderFlagCullBackfaces) != 0u;
        outEntry.autoConvexDecompose = (hdr.flags & s_ColliderFlagAutoConvexDecompose) != 0u;
        outEntry.isChain = (hdr.flags & s_ColliderFlagIsChain) != 0u;
        outEntry.chainClosed = (hdr.flags & s_ColliderFlagChainClosed) != 0u;
        outEntry.heightfieldFlipDiagonal = (hdr.flags & s_ColliderFlagHeightfieldFlipDiagonal) != 0u;
        outEntry.vhacdEnableArbitraryPlanes = (hdr.flags & s_ColliderFlagVhacdEnableArbitraryPlanes) != 0u;
        outEntry.vhacdEnableHullMerging = (hdr.flags & s_ColliderFlagVhacdEnableHullMerging) != 0u;
        outEntry.syncCsgCuts = (hdr.flags & s_ColliderFlagSyncCsgCuts) != 0u;
        outEntry.useMeshComponentFallback = (hdr.flags & s_ColliderFlagUseMeshComponentFallback) != 0u;
        outEntry.groupIndex = hdr.groupIndex;
        outEntry.categoryBits = hdr.categoryBits;
        outEntry.maskBits = hdr.maskBits;
        outEntry.center = hdr.center;
        outEntry.center2 = hdr.center2;
        outEntry.halfExtents = hdr.halfExtents;
        outEntry.localRotation = hdr.localRotation;
        outEntry.anisotropicFriction = hdr.anisotropicFriction;
        outEntry.surfaceVelocity = hdr.surfaceVelocity;
        outEntry.frictionDirection = hdr.frictionDirection;
        outEntry.planeNormalOffset = hdr.planeNormalOffset;
        outEntry.heightfieldScale = f32x4(VectorSingle(hdr.heightfieldScale), 0.0f);
        outEntry.radius = hdr.radius;
        outEntry.skinRadius = hdr.skinRadius;
        outEntry.density = hdr.density;
        outEntry.friction = hdr.friction;
        outEntry.restitution = hdr.restitution;
        outEntry.rollingResistance = hdr.rollingResistance;
        outEntry.tangentSpeed = hdr.tangentSpeed;
        outEntry.staticFriction = hdr.staticFriction;
        outEntry.vhacdMaxHulls = hdr.vhacdMaxHulls;
        outEntry.vhacdMaxRecursionDepth = hdr.vhacdMaxRecursionDepth;
        outEntry.vhacdConcavityThreshold = hdr.vhacdConcavityThreshold;
        outEntry.vhacdMaxVerticesPerHull = hdr.vhacdMaxVerticesPerHull;
        outEntry.vhacdMinVolumeRatio = hdr.vhacdMinVolumeRatio;
        outEntry.vhacdMergeVolumeTolerance = hdr.vhacdMergeVolumeTolerance;
        outEntry.cylinderHalfHeight = hdr.cylinderHalfHeight;
        outEntry.topRadius = hdr.topRadius;
        outEntry.heightfieldRows = hdr.heightfieldRows;
        outEntry.heightfieldCols = hdr.heightfieldCols;
        outEntry.heightfieldThickness = hdr.heightfieldThickness;
        outEntry.chainRadius = hdr.chainRadius;
        outEntry.frictionCombineMode = cast<MaterialCombineMode>(hdr.frictionCombineMode);
        outEntry.restitutionCombineMode = cast<MaterialCombineMode>(hdr.restitutionCombineMode);
        outEntry.userData = hdr.userData;
        outEntry.meshAsset.virtualPath = DecodeOptionalPhysicsName(hdr.meshAssetHash);
        outEntry.materialAsset.virtualPath = DecodeOptionalPhysicsName(hdr.materialAssetHash);
        outEntry.convexHullAsset.virtualPath = DecodeOptionalPhysicsName(hdr.convexHullAssetHash);
        outEntry.compoundHullAsset.virtualPath = DecodeOptionalPhysicsName(hdr.compoundHullAssetHash);
        outEntry.collisionMeshAsset.virtualPath = DecodeOptionalPhysicsName(hdr.collisionMeshAssetHash);
        outEntry.heightfieldAsset.virtualPath = DecodeOptionalPhysicsName(hdr.heightfieldAssetHash);
        outEntry.collisionLayer = DecodeOptionalPhysicsName(hdr.collisionLayerHash);

        if(!this.validColliderEntryHeaderFields(
            outEntry,
            cast<usize>(hdr.chainPointCount),
            cast<usize>(hdr.hullPointCount),
            cast<usize>(hdr.meshVertexCount),
            cast<usize>(hdr.meshIndexCount),
            cast<usize>(hdr.heightfieldCount),
            cast<usize>(hdr.heightfieldMaterialCount),
            cast<usize>(hdr.heightfieldCellMaterialCount),
            cast<usize>(hdr.heightfieldCellHoleByteCount)
        ))
            return false;

        static_assert(
            size_of<PhysicsVec4Binary>() == size_of<f32x4>()
            && size_of<PhysicsU32Binary>() == size_of<u32>()
            && size_of<f32>() == size_of<u32>()
            && size_of<CollisionMeshU16Binary>() == size_of<u16>()
        );
        if(
            !ReadBinaryVectorPayload(payload, hdr.hullPointCount, inOutCursor, outEntry.hullPoints).has_value()
            || !ReadBinaryVectorPayload(payload, hdr.meshVertexCount, inOutCursor, outEntry.meshVertices).has_value()
            || !ReadBinaryVectorPayload(payload, hdr.meshIndexCount, inOutCursor, outEntry.meshIndices).has_value()
            || !ReadBinaryVectorPayload(payload, hdr.heightfieldCount, inOutCursor, outEntry.heightfieldHeights).has_value()
        )
            return false;

        PhysicsAssetBinaryCodec assetCodec;
        outEntry.heightfieldMaterials.resize(hdr.heightfieldMaterialCount);
        for(u32 mi = 0u; mi < hdr.heightfieldMaterialCount; ++mi){
            const Expected<PhysicsSurfaceMaterialBinary> matBinRes = ReadPOD<PhysicsSurfaceMaterialBinary>(payload, inOutCursor);
            if(!matBinRes.has_value())
                return false;
            const Expected<SurfaceMaterial> unpackedMat = assetCodec.unpackSurfaceMaterialFields(matBinRes.value());
            if(!unpackedMat.has_value())
                return false;
            outEntry.heightfieldMaterials[mi] = unpackedMat.value();
        }

        if(
            !ReadBinaryVectorPayload(payload, hdr.heightfieldCellMaterialCount, inOutCursor, outEntry.heightfieldCellMaterialIndices).has_value()
            || !ReadBinaryVectorPayload(payload, hdr.chainPointCount, inOutCursor, outEntry.chainPoints).has_value()
            || !ReadBinaryVectorPayload(payload, hdr.heightfieldCellHoleByteCount, inOutCursor, outEntry.heightfieldCellHoles).has_value()
        )
            return false;

        return this.validColliderEntryNonMaterialArrayFields(outEntry);
    }

    public b8 validateCollider(in ColliderComponent c, in Name virtualPath)const{
        if(!this.validColliderEntryData(c.primaryShape)){
            error("ColliderComponentAsset::validatePayload failed: invalid primary collider entry for '{}'", virtualPath.resolvedText());
            return false;
        }
        for(usize i = 0u; i < c.extraShapes.size(); ++i){
            if(!this.validColliderEntryData(c.extraShapes[i])){
                error("ColliderComponentAsset::validatePayload failed: invalid extra collider shape for '{}'", virtualPath.resolvedText());
                return false;
            }
        }
        return true;
    }

    public b8 appendColliderValidated(in ColliderComponent c, mut Vector<u8> outBinary)const{
        if(c.extraShapes.size() > cast<usize>(u32.max))
            return false;
        ColliderComponentPayloadHeaderBinary rootHdr;
        rootHdr.extraShapeCount = cast<u32>(c.extraShapes.size());
        rootHdr.entityTagHash = c.entityTag.hash();
        usize totalBytes = size_of<ColliderComponentPayloadHeaderBinary>()
            + this.colliderEntrySerializedBytes(c.primaryShape);
        for(usize i = 0u; i < c.extraShapes.size(); ++i){
            const usize entryBytes = this.colliderEntrySerializedBytes(c.extraShapes[i]);
            if(entryBytes > usize.max - totalBytes)
                return false;
            totalBytes += entryBytes;
        }
        if(!CanAppendBytes(outBinary, totalBytes))
            return false;
        outBinary.reserve(outBinary.size() + totalBytes);
        AppendPOD(outBinary, rootHdr);
        if(!this.appendColliderEntryUnchecked(c.primaryShape, outBinary))
            return false;
        for(usize i = 0u; i < c.extraShapes.size(); ++i){
            if(!this.appendColliderEntryUnchecked(c.extraShapes[i], outBinary))
                return false;
        }
        return true;
    }

    public b8 serializeCollider(in ColliderComponent c, mut Vector<u8> outPayload)const{
        outPayload.clear();
        if(c.extraShapes.size() > cast<usize>(u32.max))
            return false;
        if(!this.validColliderEntryData(c.primaryShape))
            return false;
        for(usize i = 0u; i < c.extraShapes.size(); ++i){
            if(!this.validColliderEntryData(c.extraShapes[i]))
                return false;
        }
        if(!this.appendColliderValidated(c, outPayload)){
            outPayload.clear();
            return false;
        }
        return true;
    }

    public Expected<ColliderComponent> deserializeCollider(in Span<u8> payload)const{
        usize cursor = 0u;
        const Expected<ColliderComponentPayloadHeaderBinary> rootRes = ReadPOD<ColliderComponentPayloadHeaderBinary>(payload, cursor);
        if(!rootRes.has_value()){
            error("ColliderComponentAsset::loadComponentPayload failed: truncated header");
            return MakeUnexpected(Failure());
        }
        in ColliderComponentPayloadHeaderBinary rootHdr = rootRes.value();
        if(rootHdr.reserved0 != 0u){
            error("ColliderComponentAsset::loadComponentPayload failed: non-zero reserved bits");
            return MakeUnexpected(Failure());
        }
        const u64 minExtraBytes = cast<u64>(rootHdr.extraShapeCount) * cast<u64>(size_of<ColliderShapeEntryHeaderBinary>());
        if(minExtraBytes > cast<u64>(payload.size() - cursor)){
            error("ColliderComponentAsset::loadComponentPayload failed: truncated extra shapes");
            return MakeUnexpected(Failure());
        }

        ColliderComponent c;
        if(!this.deserializeColliderEntry(payload, cursor, c.primaryShape)){
            error("ColliderComponentAsset::loadComponentPayload failed: invalid primary shape");
            return MakeUnexpected(Failure());
        }

        c.entityTag = DecodeOptionalPhysicsName(rootHdr.entityTagHash);
        c.extraShapes.resize(rootHdr.extraShapeCount);
        for(u32 i = 0u; i < rootHdr.extraShapeCount; ++i){
            if(!this.deserializeColliderEntry(payload, cursor, c.extraShapes[i])){
                error("ColliderComponentAsset::loadComponentPayload failed: invalid extra shape");
                return MakeUnexpected(Failure());
            }
        }
        if(cursor != payload.size()){
            error("ColliderComponentAsset::loadComponentPayload failed: trailing bytes in payload");
            return MakeUnexpected(Failure());
        }
        c.dirty = true;
        return c;
    }

    private usize jointEntrySerializedBytes(in usize pathPointCount)const{
        return size_of<JointComponentPayloadBinary>() + pathPointCount * size_of<PhysicsVec4Binary>();
    }

    private b8 appendJointEntryValidated(in JointEntry j, in u32 extraJointCount, mut Vector<u8> outBinary)const{
        static_assert(size_of<JointComponentPayloadBinary>() == 640u && offset_of<JointComponentPayloadBinary>(reserved1) == 632u);
        in JointSettings s = j.settings;
        if(j.pathPoints.size() > cast<usize>(u32.max) || s.sixDofAxes.size() != 6u)
            return false;
        JointComponentPayloadBinary bin;
        bin.jointType = cast<u8>(s.type);
        bin.sixDofSwingLimitMode = cast<u8>(s.sixDofSwingLimitMode);
        u16 flags = 0u;
        if(s.useReferenceRotation) flags |= s_JointFlagUseRefRotation;
        if(s.enableLimit) flags |= s_JointFlagEnableLimit;
        if(s.enableMotor) flags |= s_JointFlagEnableMotor;
        if(s.enableSpring) flags |= s_JointFlagEnableSpring;
        if(s.collideConnected) flags |= s_JointFlagCollideConnected;
        if(s.enabled) flags |= s_JointFlagEnabled;
        if(s.enableProjection) flags |= s_JointFlagEnableProjection;
        if(s.pathClosed) flags |= s_JointFlagPathClosed;
        if(s.pathLockRotation) flags |= s_JointFlagPathLockRotation;
        if(s.enableTwistLimit) flags |= s_JointFlagEnableTwistLimit;
        if(s.enableSlerpDrive) flags |= s_JointFlagEnableSlerpDrive;
        bin.flags = flags;
        bin.localAnchorA = s.localAnchorA;
        bin.localAnchorB = s.localAnchorB;
        bin.localAxisA = s.localAxisA;
        bin.localAxisB = s.localAxisB;
        bin.referenceRotation = s.referenceRotation;
        bin.targetOrientation = s.targetOrientation;
        bin.linearOffset = s.linearOffset;
        bin.groundAnchorA = s.groundAnchorA;
        bin.groundAnchorB = s.groundAnchorB;
        bin.bodyEntityNameAHash = j.bodyEntityNameA.hash();
        bin.bodyEntityNameBHash = j.bodyEntityNameB.hash();
        bin.userData = j.userData;
        bin.length = s.length;
        bin.minLength = s.minLength;
        bin.maxLength = s.maxLength;
        bin.lowerLimit = s.lowerLimit;
        bin.upperLimit = s.upperLimit;
        bin.motorSpeed = s.motorSpeed;
        bin.maxMotorForce = s.maxMotorForce;
        bin.hertz = s.hertz;
        bin.dampingRatio = s.dampingRatio;
        bin.correctionFactor = s.correctionFactor;
        bin.maxTorque = s.maxTorque;
        bin.swingLimit = s.swingLimit;
        bin.suspensionHertz = s.suspensionHertz;
        bin.suspensionDampingRatio = s.suspensionDampingRatio;
        bin.breakForce = s.breakForce;
        bin.breakTorque = s.breakTorque;
        bin.projectionLinearTolerance = s.projectionLinearTolerance;
        bin.projectionAngularTolerance = s.projectionAngularTolerance;
        bin.invMassScaleA = s.invMassScaleA;
        bin.invMassScaleB = s.invMassScaleB;
        bin.invInertiaScaleA = s.invInertiaScaleA;
        bin.invInertiaScaleB = s.invInertiaScaleB;
        bin.limitRestitution = s.limitRestitution;
        bin.limitHertz = s.limitHertz;
        bin.limitDampingRatio = s.limitDampingRatio;
        bin.swingLimitY = s.swingLimitY;
        bin.springTarget = s.springTarget;
        bin.steeringAngle = s.steeringAngle;
        bin.suspensionRestLength = s.suspensionRestLength;
        bin.ratio = s.ratio;
        bin.lengthA = s.lengthA;
        bin.lengthB = s.lengthB;
        bin.slerpHertz = s.slerpHertz;
        bin.slerpDampingRatio = s.slerpDampingRatio;
        bin.slerpMaxTorque = s.slerpMaxTorque;
        bin.sixDofSwingLimitY = s.sixDofSwingLimitY;
        bin.sixDofSwingLimitZ = s.sixDofSwingLimitZ;
        bin.pathPointCount = cast<u32>(j.pathPoints.size());
        bin.extraJointCount = extraJointCount;
        PackSixDofAxesBinary(s.sixDofAxes, bin.sixDofMotions, bin.sixDofFlags, bin.sixDofParams);
        AppendPOD(outBinary, bin);
        return AppendBinaryVectorPayload(outBinary, Span<f32x4>(j.pathPoints.data(), j.pathPoints.size())).has_value();
    }

    private b8 deserializeJointEntry(
        in Span<u8> payload,
        mut usize inOutCursor,
        in b8 allowExtraJoints,
        mut JointEntry outEntry,
        mut u32 outExtraJointCount
    )const{
        outEntry = JointEntry();
        outExtraJointCount = 0u;
        const Expected<JointComponentPayloadBinary> res = ReadPOD<JointComponentPayloadBinary>(payload, inOutCursor);
        if(!res.has_value())
            return false;
        in JointComponentPayloadBinary bin = res.value();
        if(
            bin.reserved0 != 0u
            || bin.reserved1 != 0u
            || (bin.flags & 0xf800u) != 0u
            || (!allowExtraJoints && bin.extraJointCount != 0u)
            || bin.sixDofSwingLimitMode >= cast<u8>(SixDofSwingLimitMode::kCount)
            || bin.sixDofMotions[6u] != 0u
            || bin.sixDofMotions[7u] != 0u
            || bin.sixDofFlags[6u] != 0u
            || bin.sixDofFlags[7u] != 0u
        )
            return false;
        const u64 pathBytes = cast<u64>(bin.pathPointCount) * cast<u64>(size_of<PhysicsVec4Binary>());
        if(pathBytes > cast<u64>(payload.size() - inOutCursor))
            return false;

        mut JointSettings s = outEntry.settings;
        s.type = cast<JointType>(bin.jointType);
        s.sixDofSwingLimitMode = cast<SixDofSwingLimitMode>(bin.sixDofSwingLimitMode);
        s.useReferenceRotation = (bin.flags & s_JointFlagUseRefRotation) != 0u;
        s.enableLimit = (bin.flags & s_JointFlagEnableLimit) != 0u;
        s.enableMotor = (bin.flags & s_JointFlagEnableMotor) != 0u;
        s.enableSpring = (bin.flags & s_JointFlagEnableSpring) != 0u;
        s.collideConnected = (bin.flags & s_JointFlagCollideConnected) != 0u;
        s.enabled = (bin.flags & s_JointFlagEnabled) != 0u;
        s.enableProjection = (bin.flags & s_JointFlagEnableProjection) != 0u;
        s.pathClosed = (bin.flags & s_JointFlagPathClosed) != 0u;
        s.pathLockRotation = (bin.flags & s_JointFlagPathLockRotation) != 0u;
        s.enableTwistLimit = (bin.flags & s_JointFlagEnableTwistLimit) != 0u;
        s.enableSlerpDrive = (bin.flags & s_JointFlagEnableSlerpDrive) != 0u;
        s.localAnchorA = bin.localAnchorA;
        s.localAnchorB = bin.localAnchorB;
        s.localAxisA = bin.localAxisA;
        s.localAxisB = bin.localAxisB;
        s.referenceRotation = bin.referenceRotation;
        s.targetOrientation = bin.targetOrientation;
        s.linearOffset = bin.linearOffset;
        s.groundAnchorA = bin.groundAnchorA;
        s.groundAnchorB = bin.groundAnchorB;
        s.length = bin.length;
        s.minLength = bin.minLength;
        s.maxLength = bin.maxLength;
        s.lowerLimit = bin.lowerLimit;
        s.upperLimit = bin.upperLimit;
        s.motorSpeed = bin.motorSpeed;
        s.maxMotorForce = bin.maxMotorForce;
        s.hertz = bin.hertz;
        s.dampingRatio = bin.dampingRatio;
        s.correctionFactor = bin.correctionFactor;
        s.maxTorque = bin.maxTorque;
        s.swingLimit = bin.swingLimit;
        s.suspensionHertz = bin.suspensionHertz;
        s.suspensionDampingRatio = bin.suspensionDampingRatio;
        s.breakForce = bin.breakForce;
        s.breakTorque = bin.breakTorque;
        s.projectionLinearTolerance = bin.projectionLinearTolerance;
        s.projectionAngularTolerance = bin.projectionAngularTolerance;
        s.invMassScaleA = bin.invMassScaleA;
        s.invMassScaleB = bin.invMassScaleB;
        s.invInertiaScaleA = bin.invInertiaScaleA;
        s.invInertiaScaleB = bin.invInertiaScaleB;
        s.limitRestitution = bin.limitRestitution;
        s.limitHertz = bin.limitHertz;
        s.limitDampingRatio = bin.limitDampingRatio;
        s.swingLimitY = bin.swingLimitY;
        s.springTarget = bin.springTarget;
        s.steeringAngle = bin.steeringAngle;
        s.suspensionRestLength = bin.suspensionRestLength;
        s.ratio = bin.ratio;
        s.lengthA = bin.lengthA;
        s.lengthB = bin.lengthB;
        s.slerpHertz = bin.slerpHertz;
        s.slerpDampingRatio = bin.slerpDampingRatio;
        s.slerpMaxTorque = bin.slerpMaxTorque;
        s.sixDofSwingLimitY = bin.sixDofSwingLimitY;
        s.sixDofSwingLimitZ = bin.sixDofSwingLimitZ;
        outEntry.bodyEntityNameA = DecodeOptionalPhysicsName(bin.bodyEntityNameAHash);
        outEntry.bodyEntityNameB = DecodeOptionalPhysicsName(bin.bodyEntityNameBHash);
        outEntry.userData = bin.userData;
        outExtraJointCount = bin.extraJointCount;

        if(!UnpackSixDofAxesBinary(bin.sixDofMotions, bin.sixDofFlags, bin.sixDofParams, s.sixDofAxes))
            return false;
        if(!ReadBinaryVectorPayload(payload, bin.pathPointCount, inOutCursor, outEntry.pathPoints).has_value())
            return false;
        return this.validJointEntry(outEntry);
    }

    public b8 validateJoint(in JointComponent j, in Name virtualPath)const{
        if(this.validJointData(j))
            return true;
        error("JointComponentAsset::validatePayload failed: invalid joint parameters for '{}'", virtualPath.resolvedText());
        return false;
    }

    public b8 appendJointValidated(in JointComponent j, mut Vector<u8> outBinary)const{
        if(j.extraJoints.size() > cast<usize>(u32.max))
            return false;
        usize totalBytes = this.jointEntrySerializedBytes(j.primaryJoint.pathPoints.size());
        for(usize i = 0u; i < j.extraJoints.size(); ++i){
            const usize eb = this.jointEntrySerializedBytes(j.extraJoints[i].pathPoints.size());
            if(eb > usize.max - totalBytes)
                return false;
            totalBytes += eb;
        }
        if(!CanAppendBytes(outBinary, totalBytes))
            return false;
        outBinary.reserve(outBinary.size() + totalBytes);
        if(!this.appendJointEntryValidated(j.primaryJoint, cast<u32>(j.extraJoints.size()), outBinary))
            return false;
        for(usize i = 0u; i < j.extraJoints.size(); ++i){
            if(!this.appendJointEntryValidated(j.extraJoints[i], 0u, outBinary))
                return false;
        }
        return true;
    }

    public b8 serializeJoint(in JointComponent j, mut Vector<u8> outPayload)const{
        if(!this.validJointData(j))
            return false;
        outPayload.clear();
        if(!this.appendJointValidated(j, outPayload)){
            outPayload.clear();
            return false;
        }
        return true;
    }

    public Expected<JointComponent> deserializeJoint(in Span<u8> payload)const{
        usize cursor = 0u;
        JointComponent j;
        u32 extraCount = 0u;
        if(!this.deserializeJointEntry(payload, cursor, true, j.primaryJoint, extraCount)){
            error("JointComponentAsset::loadComponentPayload failed: invalid payload header or parameters");
            return MakeUnexpected(Failure());
        }
        const u64 minExtraBytes = cast<u64>(extraCount) * cast<u64>(size_of<JointComponentPayloadBinary>());
        if(minExtraBytes > cast<u64>(payload.size() - cursor)){
            error("JointComponentAsset::loadComponentPayload failed: truncated extra joints");
            return MakeUnexpected(Failure());
        }

        j.extraJoints.resize(extraCount);
        for(u32 i = 0u; i < extraCount; ++i){
            u32 dummyExtra = 0u;
            if(!this.deserializeJointEntry(payload, cursor, false, j.extraJoints[i], dummyExtra)){
                error("JointComponentAsset::loadComponentPayload failed: invalid extra joint");
                return MakeUnexpected(Failure());
            }
        }
        if(cursor != payload.size()){
            error("JointComponentAsset::loadComponentPayload failed: trailing bytes in payload");
            return MakeUnexpected(Failure());
        }
        j.dirty = true;
        return j;
    }

    public b8 validateWorldConfig(in PhysicsWorldConfigComponent w, in Name virtualPath)const{
        if(this.validWorldConfigData(w))
            return true;
        error("PhysicsWorldConfigComponentAsset::validatePayload failed: invalid config for '{}'", virtualPath.resolvedText());
        return false;
    }

    public b8 appendWorldConfigValidated(in PhysicsWorldConfigComponent w, mut Vector<u8> outBinary)const{
        static_assert(size_of<PhysicsWorldConfigComponentPayloadBinary>() == 128u && offset_of<PhysicsWorldConfigComponentPayloadBinary>(reserved0) == 127u);
        const usize reqBytes = size_of<PhysicsWorldConfigComponentPayloadBinary>();
        if(!CanAppendBytes(outBinary, reqBytes))
            return false;
        PhysicsWorldConfigComponentPayloadBinary bin;
        bin.gravity = w.gravity;
        bin.collisionLayerMatrixAssetHash = w.collisionLayerMatrixAsset.name().hash();
        bin.subStepCount = w.subStepCount;
        bin.maxSubStepsPerFrame = w.maxSubStepsPerFrame;
        bin.gpuDispatchThreshold = w.gpuDispatchThreshold;
        bin.restitutionThreshold = w.restitutionThreshold;
        bin.hitEventThreshold = w.hitEventThreshold;
        bin.contactHertz = w.contactHertz;
        bin.contactDampingRatio = w.contactDampingRatio;
        bin.maxLinearVelocity = w.maxLinearVelocity;
        bin.fixedDeltaTime = w.fixedDeltaTime;
        bin.gpuWorkloadFraction = w.gpuWorkloadFraction;
        bin.timeToSleep = w.timeToSleep;
        u16 flags = 0u;
        if(w.enableSleep) flags |= s_WorldCfgFlagEnableSleep;
        if(w.enableContinuous) flags |= s_WorldCfgFlagEnableContinuous;
        if(w.enableContactSoftening) flags |= s_WorldCfgFlagContactSoftening;
        if(w.enableWarmStarting) flags |= s_WorldCfgFlagWarmStarting;
        if(w.paused) flags |= s_WorldCfgFlagPaused;
        if(w.enableGpuCollision) flags |= s_WorldCfgFlagEnableGpuCollision;
        if(w.forceGpuCollision) flags |= s_WorldCfgFlagForceGpuCollision;
        if(w.gpuResidentMode) flags |= s_WorldCfgFlagGpuResidentMode;
        if(w.useGpuLbvhBroadphase) flags |= s_WorldCfgFlagUseGpuLbvhBroadphase;
        if(w.interpolateTransforms) flags |= s_WorldCfgFlagInterpolateTransforms;
        if(w.publishEventsToMessageBus) flags |= s_WorldCfgFlagPublishEventsToMessageBus;
        if(w.publishContinuousEventsToMessageBus) flags |= s_WorldCfgFlagPublishContinuousEventsToMessageBus;
        bin.flags = flags;
        bin.backendMode = cast<u8>(w.backendMode);
        outBinary.reserve(outBinary.size() + reqBytes);
        AppendPOD(outBinary, bin);
        return true;
    }

    public b8 serializeWorldConfig(in PhysicsWorldConfigComponent w, mut Vector<u8> outPayload)const{
        if(!this.validWorldConfigData(w))
            return false;
        outPayload.clear();
        return this.appendWorldConfigValidated(w, outPayload);
    }

    public Expected<PhysicsWorldConfigComponent> deserializeWorldConfig(in Span<u8> payload)const{
        usize cursor = 0u;
        const Expected<PhysicsWorldConfigComponentPayloadBinary> res = ReadPOD<PhysicsWorldConfigComponentPayloadBinary>(payload, cursor);
        if(!res.has_value() || cursor != payload.size()){
            error("PhysicsWorldConfigComponentAsset::loadComponentPayload failed: invalid payload size");
            return MakeUnexpected(Failure());
        }
        in PhysicsWorldConfigComponentPayloadBinary bin = res.value();
        if(bin.reserved0 != 0u || (bin.flags & 0xf000u) != 0u){
            error("PhysicsWorldConfigComponentAsset::loadComponentPayload failed: unsupported flags or non-zero reserved bits");
            return MakeUnexpected(Failure());
        }
        PhysicsWorldConfigComponent w;
        w.gravity = bin.gravity;
        w.collisionLayerMatrixAsset.virtualPath = DecodeOptionalPhysicsName(bin.collisionLayerMatrixAssetHash);
        w.subStepCount = bin.subStepCount;
        w.maxSubStepsPerFrame = bin.maxSubStepsPerFrame;
        w.gpuDispatchThreshold = bin.gpuDispatchThreshold;
        w.restitutionThreshold = bin.restitutionThreshold;
        w.hitEventThreshold = bin.hitEventThreshold;
        w.contactHertz = bin.contactHertz;
        w.contactDampingRatio = bin.contactDampingRatio;
        w.maxLinearVelocity = bin.maxLinearVelocity;
        w.fixedDeltaTime = bin.fixedDeltaTime;
        w.gpuWorkloadFraction = bin.gpuWorkloadFraction;
        w.timeToSleep = bin.timeToSleep;
        w.backendMode = cast<PhysicsBackendMode>(bin.backendMode);
        w.enableSleep = (bin.flags & s_WorldCfgFlagEnableSleep) != 0u;
        w.enableContinuous = (bin.flags & s_WorldCfgFlagEnableContinuous) != 0u;
        w.enableContactSoftening = (bin.flags & s_WorldCfgFlagContactSoftening) != 0u;
        w.enableWarmStarting = (bin.flags & s_WorldCfgFlagWarmStarting) != 0u;
        w.paused = (bin.flags & s_WorldCfgFlagPaused) != 0u;
        w.enableGpuCollision = (bin.flags & s_WorldCfgFlagEnableGpuCollision) != 0u;
        w.forceGpuCollision = (bin.flags & s_WorldCfgFlagForceGpuCollision) != 0u;
        w.gpuResidentMode = (bin.flags & s_WorldCfgFlagGpuResidentMode) != 0u;
        w.useGpuLbvhBroadphase = (bin.flags & s_WorldCfgFlagUseGpuLbvhBroadphase) != 0u;
        w.interpolateTransforms = (bin.flags & s_WorldCfgFlagInterpolateTransforms) != 0u;
        w.publishEventsToMessageBus = (bin.flags & s_WorldCfgFlagPublishEventsToMessageBus) != 0u;
        w.publishContinuousEventsToMessageBus = (bin.flags & s_WorldCfgFlagPublishContinuousEventsToMessageBus) != 0u;
        w.dirty = true;
        if(!this.validWorldConfigData(w)){
            error("PhysicsWorldConfigComponentAsset::loadComponentPayload failed: invalid world config values");
            return MakeUnexpected(Failure());
        }
        return w;
    }

    public b8 validatePhysicsParent(in PhysicsParentComponent p, in Name virtualPath)const{
        if(this.validPhysicsParentData(p))
            return true;
        error("PhysicsParentComponentAsset::validatePayload failed: invalid parent component for '{}'", virtualPath.resolvedText());
        return false;
    }

    public b8 appendPhysicsParentValidated(in PhysicsParentComponent p, mut Vector<u8> outBinary)const{
        static_assert(size_of<PhysicsParentComponentPayloadBinary>() == 72u && offset_of<PhysicsParentComponentPayloadBinary>(reserved2) == 68u);
        if(!CanAppendBytes(outBinary, size_of<PhysicsParentComponentPayloadBinary>()))
            return false;
        PhysicsParentComponentPayloadBinary bin;
        u8 flags = 0u;
        if(p.inheritScale) flags |= s_PhysicsParentFlagInheritScale;
        if(p.attachColliderToParentBody) flags |= s_PhysicsParentFlagAttachColliderToParent;
        bin.flags = flags;
        bin.parentEntityNameHash = p.parentEntityName.hash();
        outBinary.reserve(outBinary.size() + size_of<PhysicsParentComponentPayloadBinary>());
        AppendPOD(outBinary, bin);
        return true;
    }

    public b8 serializePhysicsParent(in PhysicsParentComponent p, mut Vector<u8> outPayload)const{
        if(!this.validPhysicsParentData(p))
            return false;
        outPayload.clear();
        return this.appendPhysicsParentValidated(p, outPayload);
    }

    public Expected<PhysicsParentComponent> deserializePhysicsParent(in Span<u8> payload)const{
        usize cursor = 0u;
        const Expected<PhysicsParentComponentPayloadBinary> res = ReadPOD<PhysicsParentComponentPayloadBinary>(payload, cursor);
        if(!res.has_value() || cursor != payload.size()){
            error("PhysicsParentComponentAsset::loadComponentPayload failed: invalid payload size");
            return MakeUnexpected(Failure());
        }
        in PhysicsParentComponentPayloadBinary bin = res.value();
        if(bin.reserved0 != 0u || bin.reserved1 != 0u || bin.reserved2 != 0u || (bin.flags & 0xfcu) != 0u){
            error("PhysicsParentComponentAsset::loadComponentPayload failed: unsupported flags or non-zero reserved bits");
            return MakeUnexpected(Failure());
        }
        PhysicsParentComponent p;
        p.inheritScale = (bin.flags & s_PhysicsParentFlagInheritScale) != 0u;
        p.attachColliderToParentBody = (bin.flags & s_PhysicsParentFlagAttachColliderToParent) != 0u;
        p.parentEntityName = DecodeOptionalPhysicsName(bin.parentEntityNameHash);
        if(!this.validPhysicsParentData(p)){
            error("PhysicsParentComponentAsset::loadComponentPayload failed: invalid parent component");
            return MakeUnexpected(Failure());
        }
        return p;
    }
}


