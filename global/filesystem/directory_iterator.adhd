[cpp_name("::DirectoryEntry"), cpp_flags(non_thread_safe)]
extern class DirectoryEntry{
    Expected<b8, ErrorCode> isRegularFile(...)const;
    Path path(...)const;
};

[cpp_name("::DirectoryIterator"), cpp_flags(non_thread_safe)]
extern class DirectoryIterator;

[cpp_name("::RecursiveDirectoryIterator"), cpp_flags(non_thread_safe)]
extern class RecursiveDirectoryIterator;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_name("::DirectoryIterator<::ArenaBase>::Create")]
extern Expected<DirectoryIterator, ErrorCode> DirectoryIteratorCreate(in Path a0);

[cpp_name("::RecursiveDirectoryIterator<::ArenaBase>::Create")]
extern Expected<RecursiveDirectoryIterator, ErrorCode> RecursiveDirectoryIteratorCreate(in Path a0);


