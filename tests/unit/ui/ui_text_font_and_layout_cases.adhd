void VerifyTextGlyphVisibility_CoverageSnapMatchesScalarAtHalfPixelsAndDirectedRounding(){
    const auto originalEnvironment = HoldFloatingPointExceptions();
    ASSERT_TRUE(originalEnvironment.has_value());
    FloatingPointEnvironmentGuard restoreEnvironment(originalEnvironment.value());
    const Array<i32, 4u> modes(FE_TONEAREST, FE_DOWNWARD, FE_UPWARD, FE_TOWARDZERO);
    for(in i32 rounding : modes){
        ASSERT_TRUE(SetFloatingPointRoundingMode(rounding).has_value());
        const f32 raster = ObserveValue<f32>(3.0f);
        const Point glyphPosition(0.0f, 0.0f);
        const Point topLeft(ObserveValue<f32>(-1.0f), 0.0f);
        const Point pixelScale(ObserveValue<f32>(0.75f), ObserveValue<f32>(1.5f));
        const Rect pixels(0.0f, 0.0f, 1.0f, 1.0f);
        ASSERT_TRUE(ClearFloatingPointExceptions(FE_ALL_EXCEPT).has_value());
        const f64 inverseRaster = ScalarDivideReference<f64>(1.0, cast<f64>(raster));
        const f64 posX = ScalarAddReference<f64>(ScalarAddReference<f64>(topLeft.x, glyphPosition.x), inverseRaster);
        const f64 posY = ScalarSubtractReference<f64>(ScalarAddReference<f64>(topLeft.y, glyphPosition.y), inverseRaster);
        const f64 alignedX = ScalarDivideReference<f64>(Floor(ScalarMultiplyAddReference<f64>(posX, pixelScale.x, 0.5)), pixelScale.x);
        const f64 alignedY = ScalarDivideReference<f64>(Floor(ScalarMultiplyAddReference<f64>(posY, pixelScale.y, 0.5)), pixelScale.y);
        const f64 width = ScalarDivideReference<f64>(pixels.width, raster);
        const f64 height = ScalarDivideReference<f64>(pixels.height, raster);
        const auto expected = TryMakeUiRect(alignedX, alignedY, width, height, UiRectPrecision::BoundedEndpoints);
        const i32 expectedFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
        ASSERT_TRUE(ClearFloatingPointExceptions(FE_ALL_EXCEPT).has_value());
        const auto actual = TryResolveGlyphCoverageRectangle(glyphPosition, 0u, pixels, 1, 1, raster, topLeft, pixelScale);
        const i32 actualFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
        ASSERT_TRUE(expected.has_value());
        ASSERT_TRUE(actual.has_value());
        EXPECT_EQ(bit_cast<u32>(actual.value().x), bit_cast<u32>(expected.value().x));
        EXPECT_EQ(bit_cast<u32>(actual.value().y), bit_cast<u32>(expected.value().y));
        EXPECT_EQ(bit_cast<u32>(actual.value().width), bit_cast<u32>(expected.value().width));
        EXPECT_EQ(bit_cast<u32>(actual.value().height), bit_cast<u32>(expected.value().height));
        EXPECT_EQ(actualFlags, expectedFlags);
    }
}

NWB_ADHD_GTEST(TextGlyphVisibility, CoverageSnapMatchesScalarAtHalfPixelsAndDirectedRounding, VerifyTextGlyphVisibility_CoverageSnapMatchesScalarAtHalfPixelsAndDirectedRounding)


