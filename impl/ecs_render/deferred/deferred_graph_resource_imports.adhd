// limztudio@gmail.com
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/deferred/deferred_internal.adhd>
#include <impl/ecs_render/kernel/task_graph_resource_utils.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidDeferredOptionalGraphImports(
    in b8 hasCsgFrameWork,
    in b8 csgTexturesValid,
    in b8 hasMaterialContextBuffer,
    in b8 materialContextValid,
    in b8 capturesHistory,
    in b8 historyCopyValid
){
    return (!hasCsgFrameWork || csgTexturesValid) && (!hasMaterialContextBuffer || materialContextValid) && (!capturesHistory || historyCopyValid);
}

b8 DeferredAvboitResourceImports::validRefractionInputs()const{
    return
        this.m_refractionDepth.has_value()
        && this.m_refractionNormalIor.has_value()
        && this.m_refractionTintCoverage.has_value()
        && this.m_refractionInstance.has_value()
        && this.m_refractionResolve.has_value()
        && this.m_avboitForegroundColor.has_value()
        && this.m_avboitForegroundExtinction.has_value()
    ;
}

b8 DeferredAvboitResourceImports::validRefractionSpecular()const{
    return this.m_refractionSpecularRoughness.has_value();
}

b8 DeferredAvboitResourceImports::validAvboitInputs()const{
    return
        this.m_avboitLowRaster.has_value()
        && this.m_avboitAccumColor.has_value()
        && this.m_avboitAccumExtinction.has_value()
        && this.m_avboitTransmittance.has_value()
        && this.m_avboitCoverage.has_value()
        && this.m_avboitDepthWarp.has_value()
        && this.m_avboitControl.has_value()
        && this.m_avboitExtinction.has_value()
        && this.m_avboitExtinctionOverflow.has_value()
        && this.m_avboitMaterialDomain.has_value()
        && this.m_avboitCsgDomain.has_value()
    ;
}

void DeferredAvboitResourceImports::publish(mut DeferredGraphResourceImportResult result)const{
    result.avboitLowRaster = this.m_avboitLowRaster.value();
    result.avboitAccumColor = this.m_avboitAccumColor.value();
    result.avboitAccumExtinction = this.m_avboitAccumExtinction.value();
    result.refractionDepth = this.m_refractionDepth.value();
    result.refractionNormalIor = this.m_refractionNormalIor.value();
    result.refractionTintCoverage = this.m_refractionTintCoverage.value();
    result.refractionInstance = this.m_refractionInstance.value();
    result.refractionSpecularRoughness = this.m_refractionSpecularRoughness.value();
    result.refractionResolve = this.m_refractionResolve.value();
    result.avboitForegroundColor = this.m_avboitForegroundColor.value();
    result.avboitForegroundExtinction = this.m_avboitForegroundExtinction.value();
    result.avboitTransmittance = this.m_avboitTransmittance.value();
    result.avboitCoverage = this.m_avboitCoverage.value();
    result.avboitDepthWarp = this.m_avboitDepthWarp.value();
    result.avboitControl = this.m_avboitControl.value();
    result.avboitExtinction = this.m_avboitExtinction.value();
    result.avboitExtinctionOverflow = this.m_avboitExtinctionOverflow.value();
    result.avboitMaterialDomain = this.m_avboitMaterialDomain.value();
    result.avboitCsgDomain = this.m_avboitCsgDomain.value();
}

b8 DeferredCsgTextureImports::valid()const{
    return
        this.m_csgCapBackNormal.has_value()
        && this.m_csgIntervalDepth.has_value()
        && this.m_csgIntervalId.has_value()
        && this.m_csgReceiverEventData.has_value()
        && this.m_csgReceiverEventCount.has_value()
        && this.m_csgReceiverSpanData.has_value()
        && this.m_csgReceiverSpanCount.has_value()
        && this.m_csgRemovedIntervalDepth.has_value()
        && this.m_csgRemovedIntervalCapNormal.has_value()
        && this.m_csgRemovedIntervalData.has_value()
        && this.m_csgRemovedIntervalCount.has_value()
    ;
}

void DeferredCsgTextureImports::publish(mut DeferredGraphResourceImportResult result)const{
    result.csgCapBackNormal = this.m_csgCapBackNormal.value();
    result.csgIntervalDepth = this.m_csgIntervalDepth.value();
    result.csgIntervalId = this.m_csgIntervalId.value();
    result.csgReceiverEventData = this.m_csgReceiverEventData.value();
    result.csgReceiverEventCount = this.m_csgReceiverEventCount.value();
    result.csgReceiverSpanData = this.m_csgReceiverSpanData.value();
    result.csgReceiverSpanCount = this.m_csgReceiverSpanCount.value();
    result.csgRemovedIntervalDepth = this.m_csgRemovedIntervalDepth.value();
    result.csgRemovedIntervalCapNormal = this.m_csgRemovedIntervalCapNormal.value();
    result.csgRemovedIntervalData = this.m_csgRemovedIntervalData.value();
    result.csgRemovedIntervalCount = this.m_csgRemovedIntervalCount.value();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<GpuGraphResourceId> ImportDeferredAvboitTexture(
    in TextureHandle texture,
    in Name identity,
    in StringView label,
    in b8 clearTargets,
    mut GpuTaskGraph graph
){
    if(clearTargets)
        return ImportExternalTexture(graph, texture, identity, label, Optional<ResourceStates>(ResourceStates::Unknown));
    return ImportExternalTexture(graph, texture, identity, label);
}

void DeferredAvboitResourceImports::capture(mut GpuTaskGraph graph, in DeferredFrameTargets deferredTargets, in b8 clearTargets){
    this.m_avboitLowRaster = ImportDeferredAvboitTexture(deferredTargets.avboit.lowRasterTarget, Name(s_DeferredImportNameRenderAvboitLowRaster), "AVBOIT Low Raster", clearTargets, graph);
    this.m_avboitAccumColor = ImportDeferredAvboitTexture(deferredTargets.avboit.accumColor, Name(s_DeferredImportNameRenderAvboitAccumColor), "AVBOIT Accumulated Color", clearTargets, graph);
    this.m_avboitAccumExtinction = ImportDeferredAvboitTexture(deferredTargets.avboit.accumExtinction, Name(s_DeferredImportNameRenderAvboitAccumExtinction), "AVBOIT Accumulated Extinction", clearTargets, graph);
    this.m_refractionDepth = ImportDeferredAvboitTexture(deferredTargets.avboit.refractionDepth, Name(s_DeferredImportNameRenderAvboitRefractionDepth), "AVBOIT refractionDepth", clearTargets, graph);
    this.m_refractionNormalIor = ImportDeferredAvboitTexture(deferredTargets.avboit.refractionNormalIor, Name(s_DeferredImportNameRenderAvboitRefractionNormalIor), "AVBOIT refractionNormalIor", clearTargets, graph);
    this.m_refractionTintCoverage = ImportDeferredAvboitTexture(deferredTargets.avboit.refractionTintCoverage, Name(s_DeferredImportNameRenderAvboitRefractionTintCoverage), "AVBOIT refractionTintCoverage", clearTargets, graph);
    this.m_refractionInstance = ImportDeferredAvboitTexture(deferredTargets.avboit.refractionInstance, Name(s_DeferredImportNameRenderAvboitRefractionInstance), "AVBOIT refractionInstance", clearTargets, graph);
    this.m_refractionSpecularRoughness = ImportDeferredAvboitTexture(deferredTargets.avboit.refractionSpecularRoughness, Name(s_DeferredImportNameRenderAvboitRefractionSpecularRoughness), "AVBOIT Refraction Specular Roughness", clearTargets, graph);
    this.m_refractionResolve = ImportDeferredAvboitTexture(deferredTargets.avboit.refractionResolve, Name(s_DeferredImportNameRenderAvboitRefractionResolve), "AVBOIT refractionResolve", clearTargets, graph);
    this.m_avboitForegroundColor = ImportDeferredAvboitTexture(deferredTargets.avboit.foregroundAccumColor, Name(s_DeferredImportNameRenderAvboitAvboitForegroundColor), "AVBOIT avboitForegroundColor", clearTargets, graph);
    this.m_avboitForegroundExtinction = ImportDeferredAvboitTexture(deferredTargets.avboit.foregroundAccumExtinction, Name(s_DeferredImportNameRenderAvboitAvboitForegroundExtinction), "AVBOIT avboitForegroundExtinction", clearTargets, graph);
    this.m_avboitTransmittance = ImportDeferredAvboitTexture(deferredTargets.avboit.transmittanceTexture, Name(s_DeferredImportNameRenderAvboitTransmittance), "AVBOIT Transmittance", clearTargets, graph);
    this.m_avboitCoverage = ImportExternalBuffer(graph, deferredTargets.avboit.coverageBuffer, Name(s_DeferredImportNameRenderAvboitCoverage), "AVBOIT Coverage");
    this.m_avboitDepthWarp = ImportExternalBuffer(graph, deferredTargets.avboit.depthWarpBuffer, Name(s_AvboitDepthWarpName), s_AvboitDepthWarpLabel);
    this.m_avboitControl = ImportExternalBuffer(graph, deferredTargets.avboit.controlBuffer, Name(s_DeferredImportNameRenderAvboitControl), "AVBOIT Control");
    this.m_avboitExtinction = ImportExternalBuffer(graph, deferredTargets.avboit.extinctionBuffer, Name(s_AvboitExtinctionName), s_AvboitExtinctionLabel);
    this.m_avboitExtinctionOverflow = ImportExternalBuffer(graph, deferredTargets.avboit.extinctionOverflowBuffer, Name(s_DeferredImportNameRenderAvboitExtinctionOverflow), "AVBOIT Extinction Overflow");
    this.m_avboitMaterialDomain = graph.importHazardDomain(HazardDomainDesc(Name(s_DeferredImportNameRenderAvboitMaterialDomain), "Transparent Materials and Geometry"));
    this.m_avboitCsgDomain = graph.importHazardDomain(HazardDomainDesc(Name(s_DeferredImportNameRenderAvboitCsgDomain), s_TransparentCsgIntervalsLabel));
}

void DeferredCsgTextureImports::capture(mut GpuTaskGraph graph, in DeferredFrameTargets deferredTargets){
    this.m_csgCapBackNormal = ImportExternalTexture(graph, deferredTargets.csgCapBackNormal, Name(s_DeferredImportNameRenderDeferredCsgCapBackNormal), "CSG Cap Back Normal");
    this.m_csgIntervalDepth = ImportExternalTexture(graph, deferredTargets.csgIntervalDepth, Name(s_DeferredImportNameRenderDeferredCsgIntervalDepth), "CSG Interval Depth");
    this.m_csgIntervalId = ImportExternalTexture(graph, deferredTargets.csgIntervalId, Name(s_DeferredImportNameRenderDeferredCsgIntervalId), "CSG Interval ID");
    this.m_csgReceiverEventData = ImportExternalTexture(graph, deferredTargets.csgReceiverEventData, Name(s_DeferredImportNameRenderDeferredCsgReceiverEventData), "CSG Receiver Event Data");
    this.m_csgReceiverEventCount = ImportExternalTexture(graph, deferredTargets.csgReceiverEventCount, Name(s_DeferredImportNameRenderDeferredCsgReceiverEventCount), "CSG Receiver Event Count");
    this.m_csgReceiverSpanData = ImportExternalTexture(graph, deferredTargets.csgReceiverSpanData, Name(s_DeferredImportNameRenderDeferredCsgReceiverSpanData), "CSG Receiver Span Data");
    this.m_csgReceiverSpanCount = ImportExternalTexture(graph, deferredTargets.csgReceiverSpanCount, Name(s_DeferredImportNameRenderDeferredCsgReceiverSpanCount), "CSG Receiver Span Count");
    this.m_csgRemovedIntervalDepth = ImportExternalTexture(graph, deferredTargets.csgRemovedIntervalDepth, Name(s_DeferredImportNameRenderDeferredCsgRemovedIntervalDepth), "CSG Removed Interval Depth");
    this.m_csgRemovedIntervalCapNormal = ImportExternalTexture(graph, deferredTargets.csgRemovedIntervalCapNormal, Name(s_DeferredImportNameRenderDeferredCsgRemovedIntervalCapNormal), "CSG Removed Interval Cap Normal");
    this.m_csgRemovedIntervalData = ImportExternalTexture(graph, deferredTargets.csgRemovedIntervalData, Name(s_DeferredImportNameRenderDeferredCsgRemovedIntervalData), "CSG Removed Interval Data");
    this.m_csgRemovedIntervalCount = ImportExternalTexture(graph, deferredTargets.csgRemovedIntervalCount, Name(s_DeferredImportNameRenderDeferredCsgRemovedIntervalCount), "CSG Removed Interval Count");
}


