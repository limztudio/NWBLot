[ordered]
class FilesystemVolumeTest{
    public HeapStorage m_arena(s_FilesystemNameTestsFilesystem);
    public Path m_directory("filesystem_unit_test_volume");
    public VolumeMountDesc m_desc(this.m_arena);
    public CapturingLogger m_logger;
    private LoggerRegistrationGuard m_guard(this.m_logger, LoggerBreakPolicy::ReportOnly);

    public void setup(){
        ASSERT_TRUE(RemoveAllIfExists(this.m_directory).has_value());
        ASSERT_TRUE(this.m_desc.volumeName.assign("test"));
        this.m_desc.mountDirectory = this.m_directory;
        this.m_desc.segmentSize = 4096u;
        this.m_desc.metadataSize = 512u;
        this.m_desc.createIfMissing = true;
        this.m_desc.usage = VolumeUsage::CookWrite;
    }
    public void teardown(){ EXPECT_TRUE(RemoveAllIfExists(this.m_directory).has_value()); }
}

class CreatedFilesystem{
    private Expected<UniquePtr<IFilesystem>> m_owner;
    public CreatedFilesystem(mut HeapStorage storage, in VolumeMountDesc desc){ this.m_owner = CreateVolumeFilesystem(storage, desc); }
    public b8 valid()const{ return this.m_owner.has_value() && cast<b8>(this.m_owner.value()); }
    public mut IFilesystem get(){ return this.m_owner.value().deref(); }
    public void reset(){ if(this.m_owner.has_value()) this.m_owner.value().reset(); }
}

class ThrowingPublishLogger : Utf8LogSink{
    [cpp_unwind]
    public void receive(in StringView text, in LogType kind)override{ ThrowTestException<i32>(s_FilesystemPublishLogFailure); }
}

class BlockingRestoreLogger : Utf8LogSink{
    private Path m_path;
    private b8 m_throws;
    private b8 m_received = false;
    public BlockingRestoreLogger(in Path path, in b8 throws){ this.m_path = path; this.m_throws = throws; }
    [cpp_unwind]
    public void receive(in StringView text, in LogType kind)override{
        this.m_received = EnsureDirectories(this.m_path).has_value();
        if(this.m_throws) ThrowTestException<i32>(s_FilesystemPublishLogFailure);
    }
    public b8 blocked()const{ return this.m_received; }
}

class RestoreSegment{
    private Path m_live;
    private Path m_backup;
    private mut b8 m_restored;
    public RestoreSegment(in Path live, in Path backup, mut b8 restored){
        this.m_live = live;
        this.m_backup = backup;
        this.m_restored = restored;
    }
    public ~RestoreSegment(){
        if(RemoveAllForCleanup(this.m_live).has_value())
            this.m_restored = RenamePath(this.m_backup, this.m_live).has_value();
    }
}

class RollbackSignal{
    public b8 triggered = false;
    public void rollbackFailed(){ this.triggered = true; }
}

class EmptyVolumeFactory{
    public Expected<UniquePtr<IFilesystem>> create()const{ UniquePtr<IFilesystem> empty; return empty; }
}
class FailedVolumeFactory{
    public Expected<UniquePtr<IFilesystem>> create()const{ return MakeUnexpected(Failure()); }
}


