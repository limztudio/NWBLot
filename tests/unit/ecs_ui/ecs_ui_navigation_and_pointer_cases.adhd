UiEditNavigationResult MakeNavigationResult(in usize committedByte, in f32 preferredX){
    UiEditNavigationResult result = UiEditNavigationResult();
    result.committedByte = committedByte;
    result.preferredX = preferredX;
    return result;
}

void VerifyUiEditNavigationHostTests_CandidateGeometryCannotReplacePublishedYHitsBeforeAcceptance(mut UiEditNavigationHostTests self){
    ASSERT_TRUE(self.m_navigationModel.setText("ab\ncd\nxy"));
    ASSERT_TRUE(self.m_navigationModel.setSelection(0u, 0u));
    ASSERT_TRUE(self.activateNavigation());
    const u64 displayed = self.m_context.input().layoutGeneration();
    const TextInputRect nativeRect = self.m_textInput.caretRect();
    const UiRect shiftedBounds = MakeEcsUiRect(10.0f, 80.0f, 180.0f, 48.0f);
    ASSERT_TRUE(self.prepareNavigation(UiEditBoxOptions(), shiftedBounds));
    EXPECT_EQ(self.m_context.input().layoutGeneration(), displayed);
    self.m_host.commitFrame(self.m_generation);
    EXPECT_EQ(self.m_textInput.caretRect().y, nativeRect.y);
    ASSERT_TRUE(self.click(MakeEcsUiPoint(20.0f, 38.0f)));
    ASSERT_TRUE(self.commit());
    ASSERT_TRUE(self.navigationFrame(UiEditBoxOptions(), shiftedBounds));
    EXPECT_EQ(self.m_navigationModel.caret(), 4u);
    EXPECT_EQ(self.m_navigationModel.anchor(), 4u);
    EXPECT_FLOAT_EQ(self.m_placement.caret.y, 92.0f);
    EXPECT_EQ(self.m_textInput.caretRect().y, 92);
    EXPECT_TRUE(self.m_resolver.records.empty());
}

void VerifyUiEditNavigationHostTests_EmptyAndTrailingHardLinesPublishDistinctEndpoints(mut UiEditNavigationHostTests self){
    ASSERT_TRUE(self.m_navigationModel.setText("a\n\n"));
    ASSERT_TRUE(self.m_navigationModel.setSelection(0u, 0u));
    ASSERT_TRUE(self.activateNavigation());
    ASSERT_TRUE(self.click(MakeEcsUiPoint(20.0f, 38.0f)));
    ASSERT_TRUE(self.navigationFrame());
    EXPECT_EQ(self.m_navigationModel.caret(), 2u);
    ASSERT_TRUE(self.click(MakeEcsUiPoint(20.0f, 50.0f)));
    ASSERT_TRUE(self.navigationFrame());
    EXPECT_EQ(self.m_navigationModel.caret(), 3u);
    EXPECT_EQ(self.m_navigationModel.anchor(), 3u);
    EXPECT_EQ(self.m_navigationModel.text(), "a\n\n");
    EXPECT_FALSE(self.m_navigationModel.canUndo());
}

void VerifyUiEditNavigationHostTests_EarlierCommittedTextRetiresQueuedPublishedPointerPositions(mut UiEditNavigationHostTests self){
    ASSERT_TRUE(self.m_navigationModel.setText("ab\ncd\nxy"));
    ASSERT_TRUE(self.m_navigationModel.setSelection(0u, 0u));
    ASSERT_TRUE(self.activateNavigation());
    ASSERT_TRUE(self.commitNative("Q"));
    ASSERT_TRUE(self.click(MakeEcsUiPoint(20.0f, 38.0f)));
    ASSERT_TRUE(self.navigationFrame());
    EXPECT_EQ(self.m_navigationModel.text(), "Qab\ncd\nxy");
    EXPECT_EQ(self.m_navigationModel.anchor(), 1u);
    EXPECT_EQ(self.m_navigationModel.caret(), 1u);
    EXPECT_TRUE(self.m_resolver.records.empty());
    ASSERT_TRUE(self.m_navigationModel.undo());
    EXPECT_EQ(self.m_navigationModel.text(), "ab\ncd\nxy");
    EXPECT_FALSE(self.m_navigationModel.canUndo());
}

