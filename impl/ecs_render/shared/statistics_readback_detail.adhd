#include <impl/ecs_render/shared/statistics_readback_state.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
b8 RecordStatisticsReadbackCopy(
    mut CommandList commandList,
    in GpuTaskRecordContext context,
    in BufferHandle sourceBuffer,
    in BufferHandle destinationBuffer,
    in GpuGraphResourceId sourceResource,
    in GpuGraphResourceId destinationResource,
    in usize byteCount
){
    if(!sourceBuffer.valid() || !destinationBuffer.valid())
        return false;
    const GpuGraphResourceId source = sourceResource;
    const GpuGraphResourceId destination = destinationResource;
    const usize copyBytes = byteCount;
    in GpuTaskRecordContext contextRef = context;
    if(!CaptureGpuTaskCommandsIfEnabled(contextRef, lambda[in contextRef, in source, in destination, in copyBytes](mut GpuCommandIrCapture capture) -> b8{
        return capture.captureCopyBuffer(contextRef.task, contextRef.packet, contextRef.queue, source, 0u, destination, 0u, copyBytes);
    }))
        return false;
    commandList.endRenderPass();
    commandList.copyBuffer(destinationBuffer.deref(), 0u, sourceBuffer.deref(), 0u, byteCount);
    return !commandList.commandRecordingFailed();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class StatisticsReadbackBuffers<StatisticsT, OutcomeT : IStatisticsOutcome<StatisticsT>, const usize CounterCount> : NoCopy{
    private SharedPool m_versions = SharedPool();
    public mut GraphicsRuntime graphics;
    public Shared<StatisticsReadbackState<StatisticsT, OutcomeT>> control;
    public Array<BufferHandle, s_StatisticsReadbackSlotCount> buffers;

    public StatisticsReadbackBuffers(mut GraphicsRuntime graphics){ this.graphics = graphics; }

    public void resetReadbackBuffers(){
        if(this.control.valid())
            this.control.deref().reset(0u);
        for(u32 index = 0u; index < s_StatisticsReadbackSlotCount; ++index)
            this.buffers[index].reset();
    }

    public Expected<StatisticsT> latestStatistics()const{
        if(!this.control.valid())
            return MakeUnexpected(Failure());
        return this.control.deref().tryGetLatestStatistics();
    }

    public void populateSnapshot<SnapshotT>(in StatisticsT metadata, mut SnapshotT snapshot)const{
        snapshot.control = this.control;
        snapshot.metadata = metadata;
        snapshot.buffers = this.buffers;
    }

    [cpp_unwind]
    public b8 prepare(in Array<Name, s_StatisticsReadbackSlotCount> names, in StringView errorMessage){
        const u16 generation = this.graphics.getDevice().getDeviceGeneration();
        if(!this.control.valid()){
            const auto created = this.m_versions.make<StatisticsReadbackState<StatisticsT, OutcomeT>>(generation);
            if(!created.has_value()){
                error("{}", errorMessage);
                return false;
            }
            this.control = created.value();
        }
        Array<BufferHandle, s_StatisticsReadbackSlotCount> buffers;
        for(usize index = 0u; index < s_StatisticsReadbackSlotCount; ++index){
            const auto buffer = CreateStatisticsReadbackBuffer(CounterCount * size_of<u32>(), names[index], this.graphics);
            if(!buffer.has_value())
                return false;
            buffers[index] = buffer.value();
        }
        this.control.deref().reset(generation);
        this.buffers = buffers;
        return true;
    }

    [cpp_unwind]
    public void pollCompleted(in StringView errorMessage){
        if(!this.control.valid())
            return;
        mut Device device = this.graphics.getDevice();
        for(u32 index = 0u; index < s_StatisticsReadbackSlotCount; ++index){
            if(!this.buffers[index].valid())
                continue;
            const Expected<StatisticsPendingReadback> pending = this.control.deref().pending(index);
            if(!pending.has_value() || pending.value().token.deviceGeneration != device.getDeviceGeneration())
                continue;
            const QueueSubmissionToken token = pending.value().token;
            GpuPhysicalQueueId physicalQueue;
            physicalQueue.index = token.physicalQueueIndex;
            physicalQueue.deviceGeneration = token.deviceGeneration;
            const Expected<u64> completedValue = device.queueGetCompletedInstance(physicalQueue);
            if(!completedValue.has_value() || completedValue.value() < token.value)
                continue;
            Array<u32, CounterCount> counters;
            if(!device.readMappedBuffer(this.buffers[index].deref(), counters)){
                error("{}", errorMessage);
                this.control.deref().complete(pending.value().key, token, Span<u32>());
            }
            else
                this.control.deref().complete(pending.value().key, token, Span<u32>(counters));
        }
    }
}


