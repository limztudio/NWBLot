[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/global.adhd.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_CORE_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class GraphicsRuntime;
namespace Alloc{
    class GlobalArena;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_CORE_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererShaderSystem;
class DeferredFrameTargets;
class HardwareTransparentShadowState;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_name("::NWB::Impl::RendererShaderSystem")]
extern class RendererShaderSystem;
[cpp_name("::NWB::Impl::DeferredFrameTargets")]
extern class DeferredFrameTargets;
[cpp_name("::NWB::Impl::HardwareTransparentShadowState")]
extern class HardwareTransparentShadowState;


[modular]
class HardwareTransparentShadowResources : NoCopy{
    private mut GlobalArena m_arena;
    private mut GraphicsRuntime m_graphics;
    private mut RendererShaderSystem m_shaderSystem;
    private mut HardwareTransparentShadowState m_state;

    public HardwareTransparentShadowResources(mut GlobalArena arena, mut GraphicsRuntime graphics, mut RendererShaderSystem shaderSystem, mut HardwareTransparentShadowState state){
        this.m_arena = arena;
        this.m_graphics = graphics;
        this.m_shaderSystem = shaderSystem;
        this.m_state = state;
    }

    public b8 prepareHardwareTransparentShadowResources(mut DeferredFrameTargets targets);
    public void releaseHardwareTransparentShadowResources();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

