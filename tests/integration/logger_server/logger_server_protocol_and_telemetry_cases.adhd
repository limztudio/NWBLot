void VerifyLoggerProducerContracts_MessagePayloadRejectsInvalidTypeWithoutPublishingStaleBytes(mut LoggerProducerContracts self){
    self.touch();
    LoggerTestArena testArena = LoggerTestArena();
    LogBytes payload = LogBytes(testArena.arena);
    payload.push_back(42u);
    native(mut testArena, mut payload){
        const Log::MessageType source = MakeTuple(Timer{}, static_cast<Core::Common::LogType::Enum>(255u), Log::LogString(NWB_TEXT("invalid"), testArena.arena));
        const auto built = Log::MessagePayloadCodec::Build(source, payload);
        ASSERT_FALSE(built);
        EXPECT_EQ(built.error(), Log::MessagePayloadError::InvalidType);
    }
    EXPECT_TRUE(payload.empty());
}

void VerifyLoggerProducerContracts_SimultaneousProcessedFilesKeepIndependentRecords(mut LoggerProducerContracts self){
    self.touch();
    LoggerTestArena testArena = LoggerTestArena();
    ProcessedMessageFile first = ProcessedMessageFile(testArena.arena);
    ProcessedMessageFile second = ProcessedMessageFile(testArena.arena);
    native(mut testArena, mut first, mut second){
        ASSERT_TRUE(first.open(NWB_TEXT("processed_file_isolation")));
        ASSERT_TRUE(second.open(NWB_TEXT("processed_file_isolation")));
        EXPECT_NE(first.path(), second.path());
        ASSERT_TRUE(first.writeLine(NWB_TEXT("first record")));
        ASSERT_TRUE(second.writeLine(NWB_TEXT("second record")));
        first.close();
        second.close();
        AString<Log::LogArena> firstText(testArena.arena);
        AString<Log::LogArena> secondText(testArena.arena);
        ASSERT_TRUE(ReadTextFile(first.path(), firstText));
        ASSERT_TRUE(ReadTextFile(second.path(), secondText));
        EXPECT_TRUE(Contains(firstText, "first record"));
        EXPECT_FALSE(Contains(firstText, "second record"));
        EXPECT_TRUE(Contains(secondText, "second record"));
        EXPECT_FALSE(Contains(secondText, "first record"));
    }
}

void VerifyLoggerProducerContracts_MissingArchiveRetainsNativeReadFailureInOwningRejection(mut LoggerProducerContracts self){
    self.touch();
    LoggerTestArena testArena = LoggerTestArena();
    const StringView group = "logger_server_missing_archive_native_error_test";
    const StringView stem = "missing_archive_001";
    RemoveTestArtifacts(testArena.arena, group);
    const CrashIngestConfig config = MakeIngestConfig(testArena.arena, group);
    const CrashTestPath path = ArchivePath(testArena.arena, group, stem);
    ScratchArena scratchArena(s_LoggerCrashTestNameTestsIntegrationLoggerServerProducerContractsScratch);
    native(mut testArena, in config, in path, mut scratchArena){
        const auto missing = FileSize(path);
        ASSERT_FALSE(missing);
        const auto result = ProcessCrashUpload(testArena.arena, path, config);
        EXPECT_FALSE(result.accepted);
        EXPECT_TRUE(Contains(result.message, NWB_TEXT("failed to read crash archive")));
        const auto nativeText = MakeDiagnosticEventText("native_category='{}'; native_code={}", missing.error().category().name(), missing.error().value());
        const auto converted = ConvertString(scratchArena, nativeText.view());
        EXPECT_TRUE(Contains(result.message, converted));
    }
    RemoveTestArtifacts(testArena.arena, group);
}


