[cpp_header("<core/telemetry/frame_graph_contributor.h>"), cpp_name("::NWB::Core::Telemetry::FrameGraphBuilder")]
extern class FrameGraphBuilder{
    void addEdge(...);
    FrameGraphNodeHandle addExternal(...);
    b8 addPacketSubmissionStatistics(...);
    FrameGraphNodeHandle addPass(...);
    b8 addPhysicalQueueRuntimeStatistics(...);
    FrameGraphNodeHandle addResource(...);
    void dependsOnByName(...);
    u64 frameIndex(...)const;
};

[cpp_header("<core/telemetry/frame_graph_contributor.h>"), cpp_name("::NWB::Core::Telemetry::FrameGraphNodeHandle")]
extern class FrameGraphNodeHandle{
    u32 index;
    b8 valid(...)const;
};

[cpp_header("<core/telemetry/frame_graph_contributor.h>"), cpp_name("::NWB::Core::Telemetry::FrameGraphPassMetadata")]
extern class FrameGraphPassMetadata{
    FrameGraphQueueAssignment queueAssignment;
    FrameGraphCompiledTask compiledTask;
    FrameGraphRuntimeStatistics runtimeStatistics;
};

[cpp_header("<core/telemetry/frame_graph_contributor.h>"), cpp_name("::NWB::Core::Telemetry::FrameGraphPendingNameEdge")]
extern class FrameGraphPendingNameEdge{
    Name toName;
    u32 fromNodeIndex;
    FrameGraphEdgeKind kind;
    u8 flags;
};

[cpp_header("<core/telemetry/frame_graph_contributor.h>"), cpp_name("::NWB::Core::Telemetry::IFrameGraphContributor")]
extern class IFrameGraphContributor{
    b8 appendFrameGraph(mut FrameGraphBuilder builder);
};


