[cpp_header("<tests/integration/windows/minidump_records.h>"), cpp_name("::MINIDUMP_LOCATION_DESCRIPTOR"), cpp_flags(self_defaulted, binary_serializable)]
extern class WinDumpLocation{
    u32 DataSize;
    u32 Rva;
};

