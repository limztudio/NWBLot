class ScopedHeldFloatingPointEnvironment final : NoCopy{
public:
    ScopedHeldFloatingPointEnvironment() = default;
    ScopedHeldFloatingPointEnvironment(ScopedHeldFloatingPointEnvironment&&) = delete;
    ~ScopedHeldFloatingPointEnvironment()noexcept{
        if(m_active && m_original && !SetFloatingPointEnvironment(*m_original))
            NWB_ASSERT(false);
    }


public:
    [[nodiscard]] b8 valid()const noexcept{ return m_original.has_value(); }

    [[nodiscard]] b8 restoreNow()noexcept{
        if(!m_original || !SetFloatingPointEnvironment(*m_original))
            return false;
        m_active = false;
        return true;
    }


private:
    Expected<FloatingPointEnvironment> m_original = HoldFloatingPointExceptions();
    b8 m_active = true;
};

using ScopedTestTrace = NWB::Tests::ScopedTestTrace;

inline constexpr Array<i32, 4u> s_FloatingPointRoundingModes = { FE_TONEAREST, FE_DOWNWARD, FE_UPWARD, FE_TOWARDZERO };
inline constexpr Array<i32, 3u> s_DirectedRoundingModes = { FE_DOWNWARD, FE_UPWARD, FE_TOWARDZERO };
inline constexpr i32 s_FeAllExcept = FE_ALL_EXCEPT;
inline constexpr i32 s_FeInvalid = FE_INVALID;
inline constexpr i32 s_FeOverflow = FE_OVERFLOW;
inline constexpr i32 s_FeDivByZero = FE_DIVBYZERO;
inline constexpr i32 s_FeInexact = FE_INEXACT;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


