NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using CsgReceiverVisibleCallback = b8(*)(Core::ECS::World& world, Core::ECS::EntityID entity, CsgReceiverKind::Enum receiverKind, const CsgReceiverComponent& receiver, void* userData);

struct CsgFrameBuildDesc{
    CsgReceiverVisibleCallback receiverVisible = nullptr;
    void* receiverVisibleUserData = nullptr;

    b8 includeOpaquePass = true;
    b8 includeTransparentPass = true;
};

static_assert(IsStandardLayout_V<CsgReceiverComponent>, "CsgReceiverComponent must stay layout-stable for ECS storage");
static_assert(IsTriviallyCopyable_V<CsgReceiverComponent>, "CsgReceiverComponent must stay cheap to move in dense ECS storage");
static_assert(IsStandardLayout_V<StaticCsgMeshComponent>, "StaticCsgMeshComponent must stay layout-stable for ECS storage");
static_assert(IsTriviallyCopyable_V<StaticCsgMeshComponent>, "StaticCsgMeshComponent must stay cheap to move in dense ECS storage");
static_assert(IsStandardLayout_V<SkinnedCsgMeshComponent>, "SkinnedCsgMeshComponent must stay layout-stable for ECS storage");
static_assert(IsTriviallyCopyable_V<SkinnedCsgMeshComponent>, "SkinnedCsgMeshComponent must stay cheap to move in dense ECS storage");
static_assert(IsStandardLayout_V<CsgReceiverDrawState>, "CsgReceiverDrawState must stay layout-stable for frame handoff");
static_assert(IsTriviallyCopyable_V<CsgReceiverDrawState>, "CsgReceiverDrawState must stay cheap to pass by value");
static_assert(IsStandardLayout_V<CsgFrameState>, "CsgFrameState must stay layout-stable for frame handoff");
static_assert(IsTriviallyCopyable_V<CsgFrameState>, "CsgFrameState must stay cheap to pass by value");
static_assert(IsStandardLayout_V<CsgFrameCutterRange>, "CsgFrameCutterRange must stay layout-stable for frame handoff");
static_assert(IsTriviallyCopyable_V<CsgFrameCutterRange>, "CsgFrameCutterRange must stay cheap to pass by value");
static_assert(IsStandardLayout_V<CsgFrameCutterRangeEntry>, "CsgFrameCutterRangeEntry must stay layout-stable for frame handoff");
static_assert(IsTriviallyCopyable_V<CsgFrameCutterRangeEntry>, "CsgFrameCutterRangeEntry must stay cheap to pass by value");
static_assert(IsStandardLayout_V<CsgFrameBuildDesc>, "CsgFrameBuildDesc must stay layout-stable");
static_assert(IsTriviallyCopyable_V<CsgFrameBuildDesc>, "CsgFrameBuildDesc must stay cheap to pass by value");


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] inline b8 HasCsgFrameCandidates(Core::ECS::World& world)noexcept{
    return world.view<CsgCutterComponent>().candidateCount() > 0u && (world.view<StaticCsgMeshComponent>().candidateCount() > 0u || world.view<SkinnedCsgMeshComponent>().candidateCount() > 0u);
}

[[nodiscard]] inline Expected<CsgResolvedReceiver> ResolveCsgReceiverComponent(Core::ECS::World& world, const Core::ECS::EntityID entity)noexcept{
    if(const StaticCsgMeshComponent* receiver = world.tryGetComponent<StaticCsgMeshComponent>(entity))
        return MakeCsgResolvedReceiver(receiver->asReceiver(), CsgReceiverKind::Static);
    if(const SkinnedCsgMeshComponent* receiver = world.tryGetComponent<SkinnedCsgMeshComponent>(entity))
        return MakeCsgResolvedReceiver(receiver->asReceiver(), CsgReceiverKind::Skinned);
    return MakeUnexpected(Failure{});
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class CsgFrameReceiverLookup final : NoCopy{
private:
    struct CsgFrameCutterRef{
        Core::ECS::EntityID entity;
        const CsgCutterComponent* cutter = nullptr;
    };


private:
    using CutterRangeMap = HashMap<Name, CsgFrameCutterRangeEntry, Core::Alloc::ScratchArena, Hasher<Name>, EqualTo<Name>>;
    using CutterRefVector = Vector<CsgFrameCutterRef, Core::Alloc::ScratchArena>;


public:
    CsgFrameReceiverLookup(Core::ECS::World& world, Core::Alloc::ScratchArena& scratchArena)
        : m_world(world)
        , m_cutterRanges(0, Hasher<Name>(), EqualTo<Name>(), scratchArena)
        , m_cutterRefs(scratchArena)
    {
        auto cutterView = m_world.view<CsgCutterComponent>();
        m_cutterRanges.reserve(cutterView.candidateCount());

        cutterView.each([&]([[maybe_unused]] const Core::ECS::EntityID entity, CsgCutterComponent& cutter){
            if(!IsActiveCsgCutter(cutter))
                return;

            auto result = m_cutterRanges.try_emplace(cutter.receiverGroup, CsgFrameCutterRangeEntry{});
            CsgFrameCutterRange& range = result.first.value().range;
            range.cutterCount = AddSaturating<u32>(range.cutterCount, 1u);
        });

        u32 firstCutter = 0u;
        for(auto it = m_cutterRanges.begin(); it != m_cutterRanges.end(); ++it){
            CsgFrameCutterRange& range = it.value().range;
            range.firstCutter = firstCutter;
            firstCutter = AddSaturating<u32>(firstCutter, range.cutterCount);
        }

        if(firstCutter == 0u)
            return;

        m_cutterRefs.resize(static_cast<usize>(firstCutter));

        cutterView.each([&](const Core::ECS::EntityID entity, CsgCutterComponent& cutter)noexcept{
            if(!IsActiveCsgCutter(cutter))
                return;

            const auto foundRange = m_cutterRanges.find(cutter.receiverGroup);
            FOUNDATION_ASSERT(foundRange != m_cutterRanges.end());

            CsgFrameCutterRangeEntry& entry = foundRange.value();
            u32& writtenCount = entry.writtenCount;
            const CsgFrameCutterRange& range = entry.range;
            if(writtenCount >= range.cutterCount)
                return;

            const usize cutterIndex = static_cast<usize>(range.firstCutter + writtenCount);
            FOUNDATION_ASSERT(cutterIndex < m_cutterRefs.size());
            m_cutterRefs[cutterIndex] = CsgFrameCutterRef{ entity, &cutter };
            ++writtenCount;
        });
    }


public:
    [[nodiscard]] b8 empty()const noexcept{ return m_cutterRanges.empty(); }

    [[nodiscard]] u32 cutterCount()const noexcept{ return static_cast<u32>(m_cutterRefs.size()); }
    [[nodiscard]] Expected<CsgReceiverDrawState> resolveReceiverDrawState(const Core::ECS::EntityID entity, const CsgReceiverPass::Enum receiverPass)const noexcept{
        const auto resolvedReceiver = ResolveCsgReceiverComponent(m_world, entity);
        if(!resolvedReceiver || !IsCsgReceiverPassEnabled(resolvedReceiver->receiver, receiverPass))
            return MakeUnexpected(Failure{});

        const auto range = resolveReceiverCutterRange(resolvedReceiver->receiver);
        if(!range)
            return MakeUnexpected(Failure{});

        return MakeCsgReceiverDrawState(resolvedReceiver->receiverKind, *range);
    }
    template<typename CutterHandler>
    void forEachReceiverCutter(const CsgReceiverDrawState& drawState, CutterHandler&& handler)const noexcept(noexcept(handler(DeclVal<const Core::ECS::EntityID&>(), DeclVal<const CsgCutterComponent&>()))){
        if(!drawState.active || drawState.cutterCount == 0u)
            return;

        const usize firstCutter = static_cast<usize>(drawState.firstCutter);
        const usize cutterCount = static_cast<usize>(drawState.cutterCount);
        if(firstCutter > m_cutterRefs.size() || cutterCount > m_cutterRefs.size() - firstCutter){
            FOUNDATION_ASSERT(false);
            return;
        }

        const usize cutterEnd = firstCutter + cutterCount;
        for(usize cutterIndex = firstCutter; cutterIndex < cutterEnd; ++cutterIndex){
            const CsgFrameCutterRef& cutterRef = m_cutterRefs[cutterIndex];
            if(!cutterRef.cutter){
                FOUNDATION_ASSERT(false);
                continue;
            }
            const CsgCutterComponent& cutter = *cutterRef.cutter;
            handler(cutterRef.entity, cutter);
        }
    }


private:
    [[nodiscard]] Expected<CsgFrameCutterRange> resolveReceiverCutterRange(const CsgReceiverComponent& receiver)const noexcept{
        if(m_cutterRanges.empty() || !receiver.enabled)
            return MakeUnexpected(Failure{});

        const auto foundCutterRange = m_cutterRanges.find(receiver.receiverGroup);
        if(foundCutterRange == m_cutterRanges.end() || foundCutterRange.value().range.cutterCount == 0u)
            return MakeUnexpected(Failure{});

        return foundCutterRange.value().range;
    }


private:
    Core::ECS::World& m_world;
    CutterRangeMap m_cutterRanges;
    CutterRefVector m_cutterRefs;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace CsgFrameStateDetail{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] inline b8 ReceiverVisible(Core::ECS::World& world, const Core::ECS::EntityID entity, const CsgReceiverKind::Enum receiverKind, const CsgReceiverComponent& receiver, const CsgFrameBuildDesc& desc){
    if(!desc.receiverVisible)
        return true;

    return desc.receiverVisible(world, entity, receiverKind, receiver, desc.receiverVisibleUserData);
}

template<typename ReceiverT>
inline void GatherReceiverState(Core::ECS::World& world, const CsgReceiverKind::Enum receiverKind, const CsgFrameReceiverLookup& receiverLookup, const CsgFrameBuildDesc& desc, CsgFrameState& inOutState){
    auto receiverView = world.view<ReceiverT>();
    receiverView.each([&](const Core::ECS::EntityID entity, ReceiverT& typedReceiver){
        const CsgReceiverComponent receiver = typedReceiver.asReceiver();
        if(!receiver.enabled)
            return;
        if(!ReceiverVisible(world, entity, receiverKind, receiver, desc))
            return;

        const auto opaqueState = desc.includeOpaquePass ? receiverLookup.resolveReceiverDrawState(entity, CsgReceiverPass::Opaque) : Expected<CsgReceiverDrawState>(MakeUnexpected(Failure{}));
        const auto transparentState = desc.includeTransparentPass ? receiverLookup.resolveReceiverDrawState(entity, CsgReceiverPass::Transparent) : Expected<CsgReceiverDrawState>(MakeUnexpected(Failure{}));
        const b8 opaqueWork = opaqueState && opaqueState->receiverKind == receiverKind;
        const b8 transparentWork = transparentState && transparentState->receiverKind == receiverKind;
        if(!opaqueWork && !transparentWork)
            return;

        const CsgReceiverDrawState& receiverState = opaqueWork ? *opaqueState : *transparentState;
        AddCsgFrameReceiverWork(receiverKind, opaqueWork, transparentWork, receiverState.cutterCount, inOutState);
    });
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] inline CsgFrameState BuildCsgFrameState(Core::ECS::World& world, Core::Alloc::ScratchArena& scratchArena, const CsgFrameBuildDesc& desc = CsgFrameBuildDesc{}){
    CsgFrameState state;

    if(!HasCsgFrameCandidates(world))
        return state;

    const CsgFrameReceiverLookup receiverLookup(world, scratchArena);
    if(receiverLookup.empty())
        return state;

    CsgFrameStateDetail::GatherReceiverState<StaticCsgMeshComponent>(world, CsgReceiverKind::Static, receiverLookup, desc, state);
    CsgFrameStateDetail::GatherReceiverState<SkinnedCsgMeshComponent>(world, CsgReceiverKind::Skinned, receiverLookup, desc, state);

    FinalizeCsgFrameState(state);
    return state;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ImplEcsCsgFrameStateAdhdModule(in u64 value){
    return value != 0u;
}


