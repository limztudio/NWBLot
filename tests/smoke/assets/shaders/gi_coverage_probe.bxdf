// Test-only view of the full-resolution surfel resolve alpha. Red means covered, green means missing;
// blue marks the perpendicular -X face so the capture checker can assess the faces independently.
half3 NWB_DEFERRED_BXDF_FUNCTION(NwbBxdfSurface surface, int2 pixel){
#ifdef NWB_GRAPHICS_DEFERRED_LIGHTING_FRAMEWORK_SLANGI
    const half coverage = saturate(half(
        NwbHeapSampledImage2D(g_NwbDeferredBindlessResources.lightingSlots.z).Load(int3(pixel, 0)).a
    ));
    if(surface.normal.z < -0.7)
        return half3(coverage, 1.0h - coverage, 0.0h);
    if(surface.normal.x < -0.7)
        return half3(coverage, 1.0h - coverage, 1.0h);
#endif
    return half3(0.0h);
}


