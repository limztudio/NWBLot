NWB_ADHD_GTEST(AllocationOwnerTelemetry, RejectsMalformedMemoryPayloadsWithoutInvalidatingPriorValue, VerifyAllocationOwnerTelemetry_RejectsMalformedMemoryPayloadsWithoutInvalidatingPriorValue)
NWB_ADHD_GTEST(AllocationOwnerTelemetry, SeparatesRecorderSourcesAndKeepsPreviousFrameDuringReplacement, VerifyAllocationOwnerTelemetry_SeparatesRecorderSourcesAndKeepsPreviousFrameDuringReplacement)
NWB_ADHD_GTEST(AllocationOwnerTelemetry, CapturesAutomaticAllocationOwnersAcrossEnableReallocationAndDestruction, VerifyAllocationOwnerTelemetry_CapturesAutomaticAllocationOwnersAcrossEnableReallocationAndDestruction)
NWB_ADHD_GTEST(AllocationOwnerTelemetry, SharedNameSumsLiveUsageAndPreservesLargestIndividualArenaPeak, VerifyAllocationOwnerTelemetry_SharedNameSumsLiveUsageAndPreservesLargestIndividualArenaPeak)
NWB_ADHD_GTEST(AllocationOwnerTelemetry, KeepsHeapBackingRecordsWithoutCountingTheirUsageAgain, VerifyAllocationOwnerTelemetry_KeepsHeapBackingRecordsWithoutCountingTheirUsageAgain)
NWB_ADHD_GTEST(AllocationOwnerTelemetry, ResolvesLoadedOwnerSymbolsByFullIdentityAndPreservesExplicitText, VerifyAllocationOwnerTelemetry_ResolvesLoadedOwnerSymbolsByFullIdentityAndPreservesExplicitText)


