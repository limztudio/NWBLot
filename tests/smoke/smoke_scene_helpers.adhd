[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace NWB::Tests::Smoke{
Impl::RendererSystem& AddSmokeRenderSystems(Core::ECS::World& world, ProjectRuntimeContext& context)noexcept{
    SetupSmokeRenderSystems(world, context);
    return *MakeNotNull(world.getSystem<Impl::RendererSystem>());
}

NotNullUniquePtr<Core::ECS::World> CreateSmokeRenderWorldOrDie(const AStringView projectName, ProjectRuntimeContext& context){
    auto world = CreateSmokeWorldOrDie(projectName, context);
    SetupSmokeRenderSystems(*world, context);
    return world;
}
};


