#define EXPECT_TRUE(...) native{ EXPECT_TRUE(...) }
#define EXPECT_FALSE(...) native{ EXPECT_FALSE(...) }
#define EXPECT_EQ(...) native{ EXPECT_EQ(...) }

b8 TelemetryCaptureAndFrameGraphCasesReady(in u64 value){
    return value != 0u;
}

native{
#include <tests/unit/telemetry/suite.adhd.h>


#include <gtest/gtest.h>

#include <global/scope_exit.h>
#include <global/thread.h>

#include <tests/common/capturing_logger.adhd.h>


