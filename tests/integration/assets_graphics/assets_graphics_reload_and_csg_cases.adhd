    ASSERT_TRUE(rootResult.has_value());
    const GraphicsTestPath root = rootResult.value();

    ScratchArena scratchArena(s_ShaderScratchArena);
    b8 emitted = true;
    native(in root, mut testArena, mut scratchArena, mut emitted){
        using namespace NWB::Impl::AssetsCsgCook;
        CsgShapeCookEntryVector entries(testArena.arena);
        AppendCsgShapeCookEntry(Name(s_AssetCaseProjectCsgFirstShape), Name(s_AssetCaseProjectCsgFirstModule), "project/csg/generated/shared.slangi", testArena.arena, entries);
        AppendCsgShapeCookEntry(Name(s_AssetCaseProjectCsgSecondShape), Name(s_AssetCaseProjectCsgSecondModule), "project/csg/generated/SHARED.slangi", testArena.arena, entries);
        emitted = CsgShapeModuleWriter().emit(root / s_CacheDirectory, "tests", entries, scratchArena).has_value();
    }
