#include <impl/ecs_render/optics/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class OpticalSceneBinaryCodec{
    public Expected<usize> computeByteSize(in usize instanceCount)const{
        if(!OpticalSceneInstanceCountFits(instanceCount)){
            error("Ray optical scene: instance table exceeds the shader address range");
            return MakeUnexpected(Failure());
        }
        return s_RayTracingOpticalSceneHeaderBytes + instanceCount * s_RayTracingOpticalInstanceBytes;
    }

    public u32 serialize(in RayTracingOpticalSceneHeaderGpu header, in Span<RayTracingOpticalInstanceGpu> instances, mut Vector<u8> outBytes)const{
        const usize byteCount = s_RayTracingOpticalSceneHeaderBytes + instances.size() * s_RayTracingOpticalInstanceBytes;
        outBytes.clear();
        outBytes.reserve(byteCount);
        AppendPOD(outBytes, header);
        for(in RayTracingOpticalInstanceGpu instance : instances)
            AppendPOD(outBytes, instance);
        return cast<u32>(instances.size());
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

