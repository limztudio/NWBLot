void BuildTestPhysicalQueueRuntimeStatistics(mut TelemetryTestArena testArena, mut FrameGraphPhysicalQueueRuntimeStatisticsRecords records){
    records = FrameGraphPhysicalQueueRuntimeStatisticsRecords(testArena.arena);

    FrameGraphPhysicalQueueRuntimeStatisticsRecord computeRecord = FrameGraphPhysicalQueueRuntimeStatisticsRecord();
    computeRecord.ownerNodeIndex = 0u;
    computeRecord.statistics = MakeFrameGraphPhysicalQueueRuntimeStatistics(3u);
    records.push_back(computeRecord);

    FrameGraphPhysicalQueueRuntimeStatisticsRecord graphicsRecord = FrameGraphPhysicalQueueRuntimeStatisticsRecord();
    graphicsRecord.ownerNodeIndex = 0u;
    graphicsRecord.statistics = MakeFrameGraphPhysicalQueueRuntimeStatistics(1u);
    records.push_back(graphicsRecord);
}

void BuildTestAssignedFrameGraph(mut TelemetryTestArena testArena, mut FrameGraphNodeDescs nodes, mut FrameGraphEdgeDescs edges){
    BuildTestFrameGraph(testArena, nodes, edges);
    nodes[0u].queueAssignment = MakeChangedFrameGraphQueueAssignment();
    nodes[2u].queueAssignment = MakeNotAcceptedFrameGraphQueueAssignment();
}

void BuildTestCompiledFrameGraph(mut TelemetryTestArena testArena, mut FrameGraphNodeDescs nodes, mut FrameGraphEdgeDescs edges){
    BuildTestAssignedFrameGraph(testArena, nodes, edges);
    nodes[0u].compiledTask = MakeFrameGraphCompiledTask(41u, 7u, FrameGraphTaskPacketizationDecision::FirstTask);
    nodes[2u].compiledTask = MakeFrameGraphCompiledTask(41u, 7u, FrameGraphTaskPacketizationDecision::MergedExplicit);
}

void BuildTestRuntimeFrameGraph(mut TelemetryTestArena testArena, mut FrameGraphNodeDescs nodes, mut FrameGraphEdgeDescs edges){
    BuildTestCompiledFrameGraph(testArena, nodes, edges);
    nodes[0u].runtimeStatistics = MakeFrameGraphRuntimeStatistics();
    nodes[2u].runtimeStatistics = MakeFrameGraphRuntimeStatistics();
    nodes[2u].runtimeStatistics.graphGeneration = 61u;
    nodes[2u].runtimeStatistics.planGeneration = 62u;
    nodes[2u].runtimeStatistics.recordingAttemptGeneration = 63u;
}

