void CorruptModelBinarySkinnedName(in Name duplicateName, mut AssetBytes malformed){
    const usize start = size_of<ModelHeaderBinary>() + size_of<ModelSkeletonObjectBinary>() + size_of<ModelStaticMeshObjectBinary>();
    usize cursor = start;
    const auto read = ReadPOD<ModelSkinnedMeshObjectBinary>(Span<u8>(malformed), cursor);
    ASSERT_TRUE(read.has_value());
    ModelSkinnedMeshObjectBinary record = read.value();
    record.nameHash = duplicateName.hash();
    ASSERT_TRUE(OverwritePOD(start, record, malformed));
}

void CorruptModelBinaryStaticParent(in Name wrongParentName, mut AssetBytes malformed){
    const usize start = size_of<ModelHeaderBinary>() + size_of<ModelSkeletonObjectBinary>();
    usize cursor = start;
    const auto read = ReadPOD<ModelStaticMeshObjectBinary>(Span<u8>(malformed), cursor);
    ASSERT_TRUE(read.has_value());
    ModelStaticMeshObjectBinary record = read.value();
    record.parentObjectNameHash = wrongParentName.hash();
    ASSERT_TRUE(OverwritePOD(start, record, malformed));
}

