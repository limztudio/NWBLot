)noexcept{
    return ::NWB::Impl::Ui::TextGlyphVisibility::Candidate(glyph, nullptr, fontSize, physicalSize, origin, clip, pixelScale);
}

[[nodiscard]] FOUNDATION_INLINE TextGlyphIntersectionEnum UiTextGlyphCandidateWithAtlas(
    const ::NWB::Impl::Ui::PlacedGlyph& glyph,
    const ::NWB::Impl::Ui::SharedBakedFontAtlas& atlas,
