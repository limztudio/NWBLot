void VerifyUiTextAreaInputScrollTests_InvalidWheelLinesRejectTheCandidateBeforeBorrowingOrChangingTheAcceptedViewport(mut UiTextAreaInputScrollTests self){
    self.useHost();
    self.m_host.focused = false;
    ASSERT_TRUE(self.prepareDocument(Point(20.0f, 30.0f)));
    Array<f32, 3u> invalid;
    invalid[0u] = 0.0f;
    invalid[1u] = -1.0f;
    invalid[2u] = bit_cast<f32>(s_UiTextAreaQuietNaNF32Bits);
    u64 generation = 1u;
    for(in f32 wheelLines : invalid){
        ASSERT_TRUE(self.frameArea(generation, MakeUiTextAreaScrollOptions()));
        ++generation;
        const UiTextAreaModelSnapshot model = UiTextAreaModelSnapshot(self.m_model);
        const Point scroll = self.m_state.scroll();
        const EditBoxPlacement placement = self.m_state.placement();
        const EditNavigationSnapshot navigation = self.m_state.navigation().snapshot();
        const u64 revision = self.m_state.revision();
        const usize loans = self.m_host.loans;
        const usize publishes = self.m_host.publishes;
        const usize targets = self.m_context.input().targets().size();
        const auto displayedAccepted = self.tryTarget(self.id("area", "panel"));
        ASSERT_TRUE(displayedAccepted.has_value());
        const HitTarget accepted = displayedAccepted.value();
        TextAreaOptions options = MakeUiTextAreaScrollOptions();
        options.wheelLines = wheelLines;
        ASSERT_TRUE(self.beginArea(generation));
        const EditBoxResult result = self.m_builder.textArea(s_UiTextAreaWidgetKey, self.m_model, self.m_state, options);
        EXPECT_FALSE(result.valid);
        EXPECT_TRUE(self.m_context.failed());
        EXPECT_FALSE(self.m_builder.endPanel());
        EXPECT_FALSE(self.m_context.finishFrame());
        EXPECT_FALSE(self.m_context.commitFrame(generation));
        EXPECT_EQ(self.m_context.input().layoutGeneration(), generation - 1u);
        EXPECT_EQ(self.m_context.input().targets().size(), targets);
        const auto displayedCurrent = self.tryTarget(self.id("area", "panel"));
        ASSERT_TRUE(displayedCurrent.has_value());
        const HitTarget current = displayedCurrent.value();
        EXPECT_EQ(current.control, accepted.control);
        ExpectUiRect(current.rectangle, accepted.rectangle);
        ExpectUiRect(self.m_state.placement().bounds, placement.bounds);
        ExpectUiRect(self.m_state.placement().content, placement.content);
        EXPECT_FLOAT_EQ(self.m_state.scroll().x, scroll.x);
        EXPECT_FLOAT_EQ(self.m_state.scroll().y, scroll.y);
        EXPECT_EQ(self.m_state.revision(), revision);
        EXPECT_TRUE(self.m_state.navigation().matches(navigation));
        EXPECT_EQ(self.m_host.loans, loans);
        EXPECT_EQ(self.m_host.publishes, publishes);
        model.expect(self.m_model);
        self.m_builder.reset();
        self.m_context.abandonFrame();
        ++generation;
    }
}

void VerifyUiTextAreaInputScrollTests_CopiedVerticalWheelAppliesOnlyAtFinalPaintAndPreservesTheModel(mut UiTextAreaInputScrollTests self){
    ASSERT_TRUE(self.prepareScroll());
    const UiTextAreaModelSnapshot model = UiTextAreaModelSnapshot(self.m_model);
    const u64 revision = self.m_state.revision();
    const EditNavigationSnapshot navigation = self.m_state.navigation().snapshot();
    const auto hostTarget = self.tryTarget(self.id("area", "panel"));
    ASSERT_TRUE(hostTarget.has_value());
    const f64 step = hostTarget.value().scrollStep;
    ASSERT_GT(step, 0.0);
    ASSERT_TRUE(self.wheel(0.0, -1.0));
    ASSERT_EQ(self.m_context.input().controlActions().size(), 1u);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
    ASSERT_TRUE(self.beginArea(2u));
    self.m_result = self.m_builder.textArea(s_UiTextAreaWidgetKey, self.m_model, self.m_state, MakeUiTextAreaScrollOptions());
    ASSERT_TRUE(self.m_result.valid);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
    ASSERT_TRUE(self.acceptArea());
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().y), step, 0.001);
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, 0.0f);
    EXPECT_EQ(self.m_state.revision(), revision);
    EXPECT_TRUE(self.m_state.navigation().matches(navigation));
    EXPECT_FALSE(self.m_result.textChanged || self.m_result.selectionChanged);
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_TRUE(self.m_context.input().controlActions().empty());
    model.expect(self.m_model);
}

void VerifyUiTextAreaInputScrollTests_LargeWheelDeltasClampBothEndpointsWithoutChangingSelectionOrHistory(mut UiTextAreaInputScrollTests self){
    ASSERT_TRUE(self.prepareScroll());
    const UiTextAreaModelSnapshot model = UiTextAreaModelSnapshot(self.m_model);
    const ScrollViewportPlacement bars = self.m_state.scrollbars();
    ASSERT_GT(bars.horizontal.maximum, 0.0);
    ASSERT_GT(bars.vertical.maximum, 0.0);
    ASSERT_TRUE(self.wheel(1000000.0, -1000000.0));
    ASSERT_TRUE(self.frameArea(2u, MakeUiTextAreaScrollOptions()));
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().x), bars.horizontal.maximum, 0.001);
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().y), bars.vertical.maximum, 0.001);
    ASSERT_TRUE(self.wheel(-1000000.0, 1000000.0));
    ASSERT_TRUE(self.frameArea(3u, MakeUiTextAreaScrollOptions()));
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, 0.0f);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
    model.expect(self.m_model);
}

void VerifyUiTextAreaInputScrollTests_ReadOnlyWheelAndThumbScrollingLeaveUndoAndRedoIntact(mut UiTextAreaInputScrollTests self){
    TextAreaOptions options = MakeUiTextAreaScrollOptions();
    options.readOnly = true;
    ASSERT_TRUE(self.prepareScroll(options));
    const UiTextAreaModelSnapshot model = UiTextAreaModelSnapshot(self.m_model);
    ASSERT_TRUE(self.wheel(1.0, -1.0));
    ASSERT_TRUE(self.frameArea(2u, options));
    EXPECT_GT(self.m_state.scroll().x, 0.0f);
    EXPECT_GT(self.m_state.scroll().y, 0.0f);
    const auto foundThumb = self.tryTarget(self.part("scroll.y.thumb"));
    ASSERT_TRUE(foundThumb.has_value());
    const HitTarget thumb = foundThumb.value();
    const Point origin = CenterUiRect(thumb.rectangle);
    const Point destination = Point(origin.x, thumb.gestureReference.y + thumb.gestureReference.height + 50.0f);
    self.drag(origin, destination);
    ASSERT_TRUE(self.frameArea(3u, options));
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().y), self.m_state.scrollbars().vertical.maximum, 0.001);
    model.expect(self.m_model);
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), self.documentView());
    ASSERT_TRUE(self.m_model.redo());
    EXPECT_EQ(self.m_model.text(), model.textView());
}

void VerifyUiTextAreaInputScrollTests_DisabledEditorUsesTheContainingPanelBarrierAndCannotScroll(mut UiTextAreaInputScrollTests self){
    TextAreaOptions options = MakeUiTextAreaScrollOptions();
    options.enabled = false;
    ASSERT_TRUE(self.prepareScroll(options));
    const UiTextAreaModelSnapshot model = UiTextAreaModelSnapshot(self.m_model);
    const auto foundHost = self.tryTarget(self.id("area", "panel"));
    ASSERT_TRUE(foundHost.has_value());
    const HitTarget host = foundHost.value();
    EXPECT_FALSE(host.enabled || host.focusable || host.textEditable || host.scrollable);
    const Point point = CenterUiRect(self.m_state.placement().content);
    EXPECT_EQ(self.m_context.input().hitTest(point), RequireUiWidgetId(RequireUiRootId(self.m_root), s_UiTextAreaPanelKey));
    ASSERT_TRUE(self.wheel(1.0, -1.0, point));
    EXPECT_TRUE(self.m_context.input().controlActions().empty());
    self.click(point);
    ASSERT_TRUE(self.frameArea(2u, options));
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, 0.0f);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
    EXPECT_FALSE(self.m_context.input().focus().valid());
    EXPECT_FALSE(self.m_state.focused());
    model.expect(self.m_model);
}

void VerifyUiTextAreaInputScrollTests_WheelViewportPersistsUntilAnAcceptedIdenticalCaretIntentResumesReveal(mut UiTextAreaInputScrollTests self){
    ASSERT_TRUE(self.prepareScroll());
    const u64 revision = self.m_model.revision();
    const u64 selection = self.m_model.selectionGeneration();
    ASSERT_TRUE(self.wheel(1.0, -1.0));
    ASSERT_TRUE(self.frameArea(2u, MakeUiTextAreaScrollOptions()));
    const Point scroll = self.m_state.scroll();
    ASSERT_GT(scroll.x, 0.0f);
    ASSERT_GT(scroll.y, 0.0f);
    ASSERT_TRUE(self.frameArea(3u, MakeUiTextAreaScrollOptions()));
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, scroll.x);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, scroll.y);
    EXPECT_EQ(self.m_model.revision(), revision);
    EXPECT_EQ(self.m_model.selectionGeneration(), selection);
    ASSERT_TRUE(self.m_model.setSelection(self.m_model.anchor(), self.m_model.caret()));
    ASSERT_TRUE(self.frameArea(4u, MakeUiTextAreaScrollOptions()));
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, 0.0f);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
    EXPECT_GT(self.m_model.selectionGeneration(), selection);
    EXPECT_EQ(self.m_model.revision(), revision);
    EXPECT_TRUE(self.m_model.canUndo());
}

void VerifyUiTextAreaInputScrollTests_UnfocusedThumbPressPreservesGrabOffsetAndTheBaselineAcrossRepaints(mut UiTextAreaInputScrollTests self){
    ASSERT_TRUE(self.prepareScroll(MakeUiTextAreaScrollOptions(), Point(30.0f, 50.0f)));
    const UiTextAreaModelSnapshot model = UiTextAreaModelSnapshot(self.m_model);
    const auto foundThumb = self.tryTarget(self.part("scroll.y.thumb"));
    ASSERT_TRUE(foundThumb.has_value());
    const HitTarget thumb = foundThumb.value();
    const f32 travelValue = thumb.gestureReference.height - thumb.rectangle.height;
    ASSERT_GT(travelValue, 0.0f);
    const VectorSingle travel = VectorSingle(travelValue, travelValue, travelValue, travelValue);
    const VectorSingle originValue = VectorSingle(thumb.rectangle.width, thumb.rectangle.height, 0.0f, 0.0f) * VectorSingle(0.5f, 0.25f, 0.0f, 0.0f) + VectorSingle(thumb.rectangle.x, thumb.rectangle.y, 0.0f, 0.0f);
    const Point origin = Point(originValue.x, originValue.y);
    EXPECT_FALSE(self.m_context.input().focus().valid());
    ASSERT_TRUE(self.send(MakeUiPointerEvent(InputEventType::PrimaryDown, origin)).pointerConsumed);
    EXPECT_EQ(self.m_context.input().capture(), thumb.id);
    EXPECT_EQ(self.m_context.input().focus(), self.id(s_UiTextAreaWidgetKey, s_UiTextAreaPanelKey));
    ASSERT_TRUE(self.frameArea(2u, MakeUiTextAreaScrollOptions()));
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().y), 50.0, 0.001);
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().x), 30.0, 0.001);
    const auto foundAfterPress = self.tryTarget(self.part("scroll.y.thumb"));
    ASSERT_TRUE(foundAfterPress.has_value());
    const HitTarget afterPress = foundAfterPress.value();
    EXPECT_EQ(afterPress.control, thumb.control);
    // Lanes are the quarter and half drag steps.
    const VectorSingle dragY = travel * VectorSingle(0.25f, 0.5f, 0.0f, 0.0f) + VectorSingle(originValue.y, originValue.y, originValue.y, originValue.y);
    const VectorDouble expectedScroll = VectorDouble(thumb.gestureMaximum, thumb.gestureMaximum, thumb.gestureMaximum, thumb.gestureMaximum) * VectorDouble(0.25, 0.5, 0.0, 0.0) + VectorDouble(50.0, 50.0, 50.0, 50.0);
    const Point quarter = Point(origin.x, dragY.x);
    ASSERT_TRUE(self.send(MakeUiPointerEvent(InputEventType::PointerMove, quarter)).pointerConsumed);
    ASSERT_TRUE(self.frameArea(3u, MakeUiTextAreaScrollOptions()));
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().y), expectedScroll.x, 0.001);
    const auto foundAfterMove = self.tryTarget(self.part("scroll.y.thumb"));
    ASSERT_TRUE(foundAfterMove.has_value());
    const HitTarget afterMove = foundAfterMove.value();
    EXPECT_EQ(afterMove.control, thumb.control);
    EXPECT_GT(afterMove.rectangle.y, thumb.rectangle.y);
    const Point half = Point(origin.x, dragY.y);
    ASSERT_TRUE(self.send(MakeUiPointerEvent(InputEventType::PointerMove, half)).pointerConsumed);
    ASSERT_TRUE(self.send(MakeUiPointerEvent(InputEventType::PrimaryUp, half)).pointerConsumed);
    ASSERT_TRUE(self.frameArea(4u, MakeUiTextAreaScrollOptions()));
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().y), expectedScroll.y, 0.001);
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, 30.0f);
    EXPECT_FALSE(self.m_context.input().capture().valid());
    model.expect(self.m_model);
}

void VerifyUiTextAreaInputScrollTests_CompletedHorizontalThumbDragKeepsOutsideReleaseAndClampsItsEndpoint(mut UiTextAreaInputScrollTests self){
    ASSERT_TRUE(self.prepareScroll());
    const UiTextAreaModelSnapshot model = UiTextAreaModelSnapshot(self.m_model);
    const auto foundThumb = self.tryTarget(self.part("scroll.x.thumb"));
    ASSERT_TRUE(foundThumb.has_value());
    const HitTarget thumb = foundThumb.value();
    const VectorSingle originValue = VectorSingle(thumb.rectangle.width, thumb.rectangle.height, 0.0f, 0.0f) * VectorSingle(0.25f, 0.5f, 0.0f, 0.0f) + VectorSingle(thumb.rectangle.x, thumb.rectangle.y, 0.0f, 0.0f);
    const Point origin = Point(originValue.x, originValue.y);
    const Point outside = Point(900.0f, origin.y);
    ASSERT_TRUE(self.send(MakeUiPointerEvent(InputEventType::PrimaryDown, origin)).pointerConsumed);
    ASSERT_TRUE(self.send(MakeUiPointerEvent(InputEventType::PointerMove, outside)).pointerConsumed);
    ASSERT_TRUE(self.send(MakeUiPointerEvent(InputEventType::PointerLeave, Point())).pointerConsumed);
    ASSERT_TRUE(self.send(MakeUiPointerEvent(InputEventType::PrimaryUp, outside)).pointerConsumed);
    EXPECT_FALSE(self.m_context.input().capture().valid());
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, 0.0f);
    ASSERT_TRUE(self.frameArea(2u, MakeUiTextAreaScrollOptions()));
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().x), thumb.gestureMaximum, 0.001);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
    model.expect(self.m_model);
}

void VerifyUiTextAreaInputScrollTests_TrackPagesOnlyOnReleaseByTheAcceptedViewport(mut UiTextAreaInputScrollTests self){
    ASSERT_TRUE(self.prepareScroll(MakeUiTextAreaScrollOptions(), Point(0.0f, 100.0f)));
    const UiTextAreaModelSnapshot model = UiTextAreaModelSnapshot(self.m_model);
    const f64 page = self.m_state.scrollbars().vertical.viewportExtent;
    const auto foundAfter = self.tryTarget(self.part("scroll.y.after"));
    ASSERT_TRUE(foundAfter.has_value());
    const HitTarget after = foundAfter.value();
    const Point point = CenterUiRect(after.rectangle);
    ASSERT_TRUE(self.send(MakeUiPointerEvent(InputEventType::PrimaryDown, point)).pointerConsumed);
    ASSERT_TRUE(self.frameArea(2u, MakeUiTextAreaScrollOptions()));
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().y), 100.0, 0.001);
    ASSERT_TRUE(self.send(MakeUiPointerEvent(InputEventType::PrimaryUp, point)).pointerConsumed);
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().y), 100.0, 0.001);
    ASSERT_TRUE(self.frameArea(3u, MakeUiTextAreaScrollOptions()));
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().y), 100.0 + page, 0.001);
    model.expect(self.m_model);
}

void VerifyUiTextAreaInputScrollTests_LaterCoalescedThumbUpdateRunsAfterAnInterveningWheelAction(mut UiTextAreaInputScrollTests self){
    ASSERT_TRUE(self.prepareScroll());
    const UiTextAreaModelSnapshot model = UiTextAreaModelSnapshot(self.m_model);
    const auto foundThumb = self.tryTarget(self.part("scroll.y.thumb"));
    ASSERT_TRUE(foundThumb.has_value());
    const HitTarget thumb = foundThumb.value();
    const Point origin = CenterUiRect(thumb.rectangle);
    const f32 travel = thumb.gestureReference.height - thumb.rectangle.height;
    ASSERT_GT(travel, 0.0f);
    ASSERT_TRUE(self.send(MakeUiPointerEvent(InputEventType::PrimaryDown, origin)).pointerConsumed);
    ASSERT_TRUE(self.wheel(0.0, -1.0, origin));
    ASSERT_EQ(self.m_context.input().controlActions().size(), 1u);
    const Point quarter = Point(origin.x, travel * 0.25f + origin.y);
    ASSERT_TRUE(self.send(MakeUiPointerEvent(InputEventType::PointerMove, quarter)).pointerConsumed);
    ASSERT_TRUE(self.send(MakeUiPointerEvent(InputEventType::PrimaryUp, quarter)).pointerConsumed);
    ASSERT_TRUE(self.frameArea(2u, MakeUiTextAreaScrollOptions()));
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().y), thumb.gestureMaximum * 0.25, 0.001);
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, 0.0f);
    EXPECT_TRUE(self.m_context.input().controlActions().empty());
    model.expect(self.m_model);
}

void VerifyUiTextAreaInputScrollTests_PopupWheelUsesTheAcceptedPopupScopeAndDefersUntilItsEnd(mut UiTextAreaInputScrollTests self){
    ASSERT_TRUE(self.prepareDocument());
    PopupState popup = PopupState();
    popup.open();
    ASSERT_TRUE(self.framePopup(1u, popup));
    const WidgetId popupArea = self.id(s_UiTextAreaWidgetKey, s_UiTextAreaPopupKey);
    const auto foundHost = self.tryTarget(popupArea);
    ASSERT_TRUE(foundHost.has_value());
    const HitTarget host = foundHost.value();
    const PopupToken token = host.popup;
    ASSERT_TRUE(token.valid());
    const f64 step = host.scrollStep;
    const UiTextAreaModelSnapshot model = UiTextAreaModelSnapshot(self.m_model);
    ASSERT_TRUE(self.wheel(0.0, -1.0));
    ASSERT_EQ(self.m_context.input().controlActions().size(), 1u);
    EXPECT_EQ(self.m_context.input().controlActions()[0u].popup, token);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
    ASSERT_TRUE(self.framePopup(2u, popup));
    EXPECT_NEAR(cast<f64>(self.m_state.scroll().y), step, 0.001);
    model.expect(self.m_model);
}


