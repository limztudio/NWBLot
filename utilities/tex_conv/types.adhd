////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_AlphaWhiteKeyword = "white";
const StringView s_AlphaBlackKeyword = "black";
const f32 s_AlphaWhiteConstant = 1.0f;
const f32 s_AlphaBlackConstant = 0.0f;
const StringView s_PngExtension = ".png";
const StringView s_JpgExtension = ".jpg";
const StringView s_JpegExtension = ".jpeg";
const StringView s_JfifExtension = ".jfif";
const StringView s_TgaExtension = ".tga";
const StringView s_QoiExtension = ".qoi";
const StringView s_ExrExtension = ".exr";
const StringView s_HdrExtension = ".hdr";
const StringView s_NwbOutputExtension = ".nwb";
const StringView s_TexOutputExtension = ".tex";
const u32 s_ColorChannelCount = 4u;
const f32 s_UastcHdrMaximum = 65216.0f;
const f32 s_SrgbLinearSegmentScale = 12.92f;
const f32 s_SrgbOffset = 0.055f;
const f32 s_SrgbOffsetScale = 1.055f;
const f32 s_SrgbDecodeExponent = 2.4f;
const f32 s_SrgbLinearThreshold = 0.04045f;
const u32 s_EncoderWorkerCount = 1u;
const f32 s_UnormScale = 255.0f;
const f32 s_UnormRoundingBias = 0.5f;
const u32 s_SeparateAlphaPayloadMultiplier = 2u;
const StringView s_MipFilter = "box";
const usize s_InvalidSlice = ~cast<usize>(0u);
const StringView s_NewLine = "\r\n";
const StringView s_PublicationDiagnosticTag = "tex_conv_publication";
const StringView s_InputOptionName = "input";
const StringView s_CubeOptionName = "--cube";
const StringView s_VolumeOptionName = "--volume";
const StringView s_OutputOptionName = "-o,--output";
const StringView s_AlphaOptionName = "--alpha";
const StringView s_LinearFlagName = "--linear";
const StringView s_ForceFlagName = "--force";
const i32 s_MinVolumeSliceCount = 1;
const i32 s_UnboundedOptionCount = -1;
const u32 s_SingleTextureInputModeCount = 1u;
const i32 s_AlphaOptionPresentCount = 0;
const i32 s_TexConvExitSuccess = 0;
const i32 s_TexConvExitFailure = 1;
const i32 s_TexConvExitFatal = -1;
const usize s_CompletionReportReserveSlack = 128u;
const usize s_MetadataTextReserveBytes = 256u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[reflect]
enum<u8> AlphaSourceMode{
    Original,
    Constant,
    Image
}

enum<u8> TexConvDimension{
    Texture2D = 0,
    TextureCube = 1,
    Texture3D = 2,
    kCount
}

enum<u8> TexConvPayloadFormat{
    UastcLdr4x4 = 0,
    UastcHdr4x4 = 1,
    kCount
}

enum<u8> TexConvAlphaMode{
    Opaque = 0,
    EmbeddedLdr = 1,
    ConstantUnorm8 = 2,
    SeparateUastcLdr4x4 = 3,
    kCount
}

class TexConvAlphaOption{
    public AlphaSourceMode mode = AlphaSourceMode::Original;
    public f32 constantValue = 0.0f;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateTexConvInputModeCount(in b8 hasInput, in b8 hasCube, in b8 hasVolume){
    const u32 modeCount = cast<u32>(hasInput) + cast<u32>(hasCube) + cast<u32>(hasVolume);
    if(modeCount != s_SingleTextureInputModeCount){
        error("tex_conv: provide exactly one of a 2D input, --cube, or --volume.");
        return false;
    }
    return true;
}

b8 ValidateTexConvInputImageCount(in usize inputCount, in b8 validDimension, in b8 is2d, in b8 isCube, in usize cubeFaceCount){
    if(inputCount == 0u || inputCount > cast<usize>(u32.max))
        return false;
    if(!validDimension || (is2d && inputCount != 1u) || (isCube && inputCount != cubeFaceCount)){
        error("tex_conv: texture dimension and input image count do not match.");
        return false;
    }
    return true;
}

b8 IsValidAlphaSourceMode(in AlphaSourceMode mode){
    return mode == AlphaSourceMode::Original || mode == AlphaSourceMode::Constant || mode == AlphaSourceMode::Image;
}

f32 ResolveMaxTexConvRgb(in b8 hdr){
    if(hdr)
        return s_UastcHdrMaximum;
    return 1.0f;
}

VectorSingle QuantizeUnorm(in VectorSingle value){
    return Saturate(value) * s_UnormScale + s_UnormRoundingBias;
}

b8 ValidateTexConvRgbPixel(in VectorSingle rgb, in f32 maxRgb){
    if(
        !IsFinite(rgb.xyz)
        || rgb.x < 0.0f
        || rgb.y < 0.0f
        || rgb.z < 0.0f
        || rgb.x > maxRgb
        || rgb.y > maxRgb
        || rgb.z > maxRgb
    ){
        error("tex_conv: RGB input must contain finite values in [0, {}].", maxRgb);
        return false;
    }
    return true;
}

Expected<f32> TryResolveTexConvPixelAlpha(
    in AlphaSourceMode mode,
    in f32 sourceAlpha,
    in f32 constantAlpha,
    in f32 maskAlpha
){
    f32 alpha = sourceAlpha;
    if(mode == AlphaSourceMode::Constant)
        alpha = constantAlpha;
    else if(mode == AlphaSourceMode::Image)
        alpha = maskAlpha;
    if(!IsFinite(VectorSingle(alpha))){
        error("tex_conv: alpha input contains a non-finite value.");
        return MakeUnexpected(Failure());
    }
    if(mode != AlphaSourceMode::Original){
        const VectorSingle va(alpha);
        const VectorSingle zero(0.0f);
        const VectorSingle one(1.0f);
        return VectorSelect(VectorSelect(va, one, VectorGreater(va, one)), zero, VectorLess(va, zero)).x;
    }
    if(alpha < 0.0f || alpha > 1.0f){
        error("tex_conv: original alpha input must be in [0, 1].");
        return MakeUnexpected(Failure());
    }
    return alpha;
}

b8 ValidateTexConvPlaneResolution(
    in b8 isFirstPlane,
    in b8 isCube,
    in b8 hasAlphaMask,
    in u32 planeWidth,
    in u32 planeHeight,
    in u32 alphaWidth,
    in u32 alphaHeight,
    mut u32 inOutWidth,
    mut u32 inOutHeight
){
    if(isFirstPlane){
        inOutWidth = planeWidth;
        inOutHeight = planeHeight;
        if(isCube && inOutWidth != inOutHeight){
            error("tex_conv: cubemap faces must be square.");
            return false;
        }
        if(hasAlphaMask && (alphaWidth != inOutWidth || alphaHeight != inOutHeight)){
            error("tex_conv: alpha image resolution must match the texture input resolution.");
            return false;
        }
        return true;
    }
    if(planeWidth != inOutWidth || planeHeight != inOutHeight){
        error("tex_conv: texture inputs must have the same resolution.");
        return false;
    }
    return true;
}

VectorSingle SrgbToLinearRgb(in VectorSingle rgb){
    const VectorSingle linearPart = rgb * VectorSingle(1.0f / s_SrgbLinearSegmentScale);
    const VectorSingle nonlinearPart = Pow((rgb + VectorSingle(s_SrgbOffset)) * VectorSingle(1.0f / s_SrgbOffsetScale), VectorSingle(s_SrgbDecodeExponent));
    return VectorSelect(nonlinearPart, linearPart, VectorLessOrEqual(rgb, VectorSingle(s_SrgbLinearThreshold)));
}

b8 TryPrepareTexConvLinearPixel(
    in VectorSingle rgb,
    in f32 sourceAlpha,
    in AlphaSourceMode alphaMode,
    in f32 constantAlpha,
    in f32 maskAlpha,
    in f32 maxRgb,
    in b8 srgb,
    mut VectorSingle outPixel
){
    if(!ValidateTexConvRgbPixel(rgb, maxRgb))
        return false;
    const Expected<f32> alpha = TryResolveTexConvPixelAlpha(alphaMode, sourceAlpha, constantAlpha, maskAlpha);
    if(!alpha.has_value())
        return false;
    VectorSingle linearRgb = rgb;
    if(srgb)
        linearRgb = SrgbToLinearRgb(rgb);
    outPixel = VectorSingle(linearRgb, alpha.value());
    return true;
}

Expected<TexConvAlphaOption> TryParseTexConvAlphaOption(in StringView alphaText){
    if(alphaText.empty()){
        error("tex_conv: --alpha expects an image path, white, or black.");
        return MakeUnexpected(Failure());
    }
    TexConvAlphaOption option = TexConvAlphaOption();
    if(EqualsAsciiIgnoreCase(alphaText, s_AlphaWhiteKeyword)){
        option.mode = AlphaSourceMode::Constant;
        option.constantValue = s_AlphaWhiteConstant;
        return option;
    }
    if(EqualsAsciiIgnoreCase(alphaText, s_AlphaBlackKeyword)){
        option.mode = AlphaSourceMode::Constant;
        option.constantValue = s_AlphaBlackConstant;
        return option;
    }
    option.mode = AlphaSourceMode::Image;
    return option;
}


