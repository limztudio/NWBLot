#include <impl/ecs_render/reflection/frame_snapshot.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/reflection/reflection_pipelines.adhd>
#include <impl/ecs_render/deferred/deferred_frame_targets.adhd>
#include <impl/ecs_render/shared/renderer_frame_bindings.adhd>

static_assert(size_of<ReflectionFrameParameters>() == 176u, "Reflection frame parameters must match the shader");
static_assert(offset_of<ReflectionFrameParameters>(opaqueSpecularSlot) == 16u, "Reflection frame parameters must match the shader");
static_assert(offset_of<ReflectionFrameParameters>(maxRayDistance) == 120u, "Reflection frame parameters must match the shader");
static_assert(offset_of<ReflectionFrameParameters>(environmentTopR) == 132u, "Reflection frame parameters must match the shader");
static_assert(offset_of<ReflectionFrameParameters>(environmentBottomR) == 144u, "Reflection frame parameters must match the shader");
static_assert(offset_of<ReflectionFrameParameters>(screenThickness) == 156u, "Reflection frame parameters must match the shader");

class ReflectionCsgDispatchState{
    public ReflectionFrameSnapshot resources;
    public Optional<GpuTimingFrameTransaction> timing;

    public ReflectionCsgDispatchState(mut GpuTimingRecorder recorder){
        this.timing.emplace(recorder);
    }
}
type ReflectionCsgDispatchHandle = Shared<ReflectionCsgDispatchState>;

class RendererReflectionSystem : NoCopy{
    private SharedPool m_versions = SharedPool();
    private mut GraphicsRuntime m_graphics;
    private ReflectionStatisticsReadback m_statistics;
    private RendererReflectionPostprocess m_postprocess;
    private RendererReflectionFeedback m_feedback;
    private RendererReflectionPipelines m_pipelines;
    private ReflectionFrameSnapshot m_resources;
    private Vector<ReflectionCsgDispatchHandle> m_csgDispatchStates;
    private Optional<usize> m_preparedCsgDispatch;
    private Array<GpuDescriptorHandle, s_ReflectionDescriptorCount> m_descriptors;
    private GpuDescriptorHandle m_depthSampledDescriptor;
    private Array<GpuDescriptorHandle, s_ReflectionMaxDepthMips> m_depthMipSampledDescriptors;
    private Array<GpuDescriptorHandle, s_ReflectionMaxDepthMips> m_depthMipStorageDescriptors;

    public RendererReflectionSystem(mut GraphicsRuntime graphics, mut RendererShaderSystem shaders){
        this.m_graphics = graphics;
        this.m_statistics = ReflectionStatisticsReadback(graphics);
        this.m_postprocess = RendererReflectionPostprocess(graphics, shaders);
        this.m_feedback = RendererReflectionFeedback(graphics);
        this.m_pipelines = RendererReflectionPipelines(graphics, shaders);
    }
    [cpp_unwind]
    public void invalidateResources();
    [cpp_unwind]
    public b8 prepareResources(in u32 width, in u32 height, in b8 prepareHardware, in b8 prepareCsgHardware, in ReflectionSettings settings);
    public Expected<ReflectionCsgDispatchHandle> acquireCsgDispatchState(in ReflectionFrameSnapshot resources);
    [cpp_unwind]
    public void pollStatistics(){ this.m_statistics.pollCompleted(); }
    public Expected<ReflectionStatistics> tryGetLatestStatistics()const{ return this.m_statistics.latestStatistics(); }
    public ReflectionFrameSnapshot snapshotFrameResources(
        in DeferredFrameTargets targets,
        in MeshViewBufferSnapshot view,
        in RayTracingSceneGraphResources scene,
        in ReflectionSettings settings,
        in u32 frameIndex,
        in ReflectionSceneContentStamp stamp
    )const;

    [cpp_unwind]
    private void releaseTargets();
    [cpp_unwind]
    private b8 prepareCsgDispatchResources();
    [cpp_unwind]
    private b8 prepareQueue(in u32 capacity);
    [cpp_unwind]
    private b8 prepareArguments(in u32 capacity, in b8 sliced);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

