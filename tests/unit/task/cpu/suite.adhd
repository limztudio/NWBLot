#if defined(NWB_PLATFORM_WINDOWS)
#include <windows.h>
#elif defined(NWB_PLATFORM_LINUX)
#include <unistd.h>
#endif

namespace CpuTaskSchedulerTestSupport{

[[noreturn]] void ExitTestProcess([[maybe_unused]] const u32 code)noexcept{
#if defined(NWB_PLATFORM_WINDOWS)
    ExitProcess(code);
#elif defined(NWB_PLATFORM_LINUX)
    ::_exit(static_cast<int>(code));
#else
    TerminateInvariant();
#endif
}

[[nodiscard]] b8 WaitUntil(const Atomic<b8>& condition, const u32 timeoutMS)noexcept{
    const Timer begin = TimerNow();
    while(!condition.load(MemoryOrder::acquire)){
        if(DurationInMS<u64>(TimerNow(), begin) >= timeoutMS)
            return false;
        SleepMS(s_PollIntervalMS);
    }
    return true;
}

DeadlineGuard::DeadlineGuard(const b8 deathTest, const u32 timeoutMS)
    : m_watchdog([deathTest, timeoutMS](const StopToken& stop)noexcept {
        const Timer begin = TimerNow();
        while(!stop.stop_requested()){
            if(DurationInMS<u64>(TimerNow(), begin) >= timeoutMS){
                // A timeout must fail a death test instead of being mistaken for the expected invariant rejection.
                if(deathTest)
                    ExitTestProcess(0u);
                TerminateInvariant();
            }
            SleepMS(s_PollIntervalMS);
        }
    })
{}

void TaskGate::block()noexcept{
    entered.store(true, MemoryOrder::release);
    if(!WaitUntil(released, s_GateTimeoutMS))
        expired.store(true, MemoryOrder::release);
}

LifetimeProbe::LifetimeProbe(LifetimeProbe&& other)noexcept
    : retirements(other.retirements)
    , value(other.value)
{
    other.retirements = nullptr;
}

LifetimeProbe::~LifetimeProbe()noexcept{
    if(retirements)
        retirements->fetch_add(1u, MemoryOrder::release);
}

};

namespace __hidden_cpu_task_fanin_tests{

void VerifyFanIn(Alloc::ScratchArena& scratchArena, const usize uniqueDependencyCount, const usize repetitionCount){
    DeadlineGuard deadline(false, s_TestTimeoutMS);
    Atomic<b8> rootEntered{ false };
    Atomic<b8> releaseRoot{ false };
    Atomic<b8> rootExpired{ false };
    Atomic<u32> dependencyCompletionCount{ 0u };
    Atomic<u32> completionCountObservedByJoin{ 0u };
    Atomic<u32> joinInvocationCount{ 0u };
    Vector<u32, Alloc::ScratchArena> dependencyInvocations(uniqueDependencyCount, 0u, scratchArena);
    CpuTaskScheduler scheduler(HomogeneousWorkers(1u));
    ScopeExit releaseGuard([&]()noexcept { releaseRoot.store(true, MemoryOrder::release); });

    const auto completedTaskAdmission = scheduler.submit([]()noexcept {});
    ASSERT_TRUE(completedTaskAdmission);
    const CpuTaskHandle completed = *completedTaskAdmission;
    ASSERT_TRUE(completed.valid());
    scheduler.wait(completed);

    const auto cpuTaskAdmission = scheduler.submit([&]()noexcept {
        rootEntered.store(true, MemoryOrder::release);
        if(!WaitUntil(releaseRoot, s_GateTimeoutMS))
            rootExpired.store(true, MemoryOrder::release);
    });
    ASSERT_TRUE(cpuTaskAdmission);
    const CpuTaskHandle root = *cpuTaskAdmission;
    ASSERT_TRUE(root.valid());
    ASSERT_TRUE(WaitUntil(rootEntered, s_GateTimeoutMS));
    EXPECT_TRUE(scheduler.isComplete(completed));
    EXPECT_FALSE(scheduler.isComplete(root));

    Vector<CpuTaskHandle, Alloc::ScratchArena> tasks(scratchArena);
    Vector<CpuTaskHandle, Alloc::ScratchArena> dependencies(scratchArena);
    tasks.reserve(uniqueDependencyCount);
    dependencies.reserve(uniqueDependencyCount * repetitionCount + 2u);
    for(usize index = 0u; index < uniqueDependencyCount; ++index){
        const auto secondCpuTaskAdmission = scheduler.submit([&, index]()noexcept {
            ++dependencyInvocations[index];
            dependencyCompletionCount.fetch_add(1u, MemoryOrder::release);
        }, root);
        ASSERT_TRUE(secondCpuTaskAdmission);
        const CpuTaskHandle dependency = *secondCpuTaskAdmission;
        ASSERT_TRUE(dependency.valid());
        tasks.push_back(dependency);
    }

    // An odd stride permutes the power-of-two task counts, separating repeated edges by a full pass.
    for(usize repeat = 0u; repeat < repetitionCount; ++repeat){
        for(usize index = 0u; index < uniqueDependencyCount; ++index)
            dependencies.push_back(tasks[(index * 4051u + repeat) % uniqueDependencyCount]);
    }
    // Retired generations and default handles add no pending prerequisite after node storage is reused.
    dependencies.push_back(completed);
    dependencies.push_back(CpuTaskHandle{});

    const auto thirdCpuTaskAdmission = scheduler.submit([&]()noexcept {
        completionCountObservedByJoin.store(dependencyCompletionCount.load(MemoryOrder::acquire), MemoryOrder::release);
        joinInvocationCount.fetch_add(1u, MemoryOrder::release);
    }, {}, dependencies.data(), dependencies.size());
    ASSERT_TRUE(thirdCpuTaskAdmission);
    const CpuTaskHandle joined = *thirdCpuTaskAdmission;
    ASSERT_TRUE(joined.valid());
    EXPECT_FALSE(scheduler.isComplete(joined));
    EXPECT_EQ(dependencyCompletionCount.load(MemoryOrder::acquire), 0u);
    EXPECT_EQ(joinInvocationCount.load(MemoryOrder::acquire), 0u);

    releaseRoot.store(true, MemoryOrder::release);
    scheduler.wait(joined);
    scheduler.wait();
    EXPECT_FALSE(rootExpired.load(MemoryOrder::acquire));
    EXPECT_EQ(dependencyCompletionCount.load(MemoryOrder::acquire), uniqueDependencyCount);
    EXPECT_EQ(completionCountObservedByJoin.load(MemoryOrder::acquire), uniqueDependencyCount);
    EXPECT_EQ(joinInvocationCount.load(MemoryOrder::acquire), 1u);
    for(const u32 invocations : dependencyInvocations)
        EXPECT_EQ(invocations, 1u);
    EXPECT_EQ(scheduler.statistics().completedTasks, uniqueDependencyCount + 3u);
    EXPECT_EQ(scheduler.statistics().canceledTasks, 0u);
    EXPECT_EQ(scheduler.statistics().outstandingTasks, 0u);
}

};

namespace __hidden_cpu_task_mpmc_tests{

void Produce(CpuTaskScheduler& scheduler, CpuTaskScope& scope, ProducerState& state, u32 producer){
    if(!WaitUntil([&]()noexcept { return state.start.load(MemoryOrder::acquire); })){
        state.expired.store(true, MemoryOrder::release);
        return;
    }
    for(u32 task = 0u; task < s_TasksPerProducer; ++task){
        const u32 slot = (producer * s_TasksPerProducer + task) * 4u;
        auto callback = [&scheduler, &state, slot]() {
            state.visits[slot].fetch_add(1u, MemoryOrder::relaxed);
            const auto cpuTaskAdmission = scheduler.submit([&scheduler, &state, slot]() {
                state.visits[slot + 1u].fetch_add(1u, MemoryOrder::relaxed);
                const auto secondCpuTaskAdmission = scheduler.submit([&state, slot]()noexcept {
                    state.visits[slot + 2u].fetch_add(1u, MemoryOrder::relaxed);
                });
                if(!secondCpuTaskAdmission || !secondCpuTaskAdmission->valid())
                    state.rejected.store(true, MemoryOrder::release);
            });
            if(!cpuTaskAdmission || !cpuTaskAdmission->valid())
                state.rejected.store(true, MemoryOrder::release);
        };
        CpuTaskOptions options;
        options.cost = static_cast<CpuTaskCost::Enum>(task % 3u);
        options.priority = static_cast<CpuTaskPriority::Enum>((task / 3u) % 3u);
        const auto thirdCpuTaskAdmission = task % 2u == 0u ? scope.submit(Move(callback), options) : scheduler.submit(Move(callback), options);
        if(!thirdCpuTaskAdmission){
            state.rejected.store(true, MemoryOrder::release);
            state.published[producer].store(true, MemoryOrder::release);
            return;
        }
        const CpuTaskHandle handle = *thirdCpuTaskAdmission;
        state.handles[producer][task] = handle;
        if(!handle.valid())
            state.rejected.store(true, MemoryOrder::release);
        if(task == 31u && scheduler.currentWorkerIndex() != 0u && handle.valid()){
            scheduler.wait(handle);
            for(u32 descendant = 0u; descendant < 3u; ++descendant){
                if(state.visits[slot + descendant].load(MemoryOrder::acquire) != 1u)
                    state.invalidOrder.store(true, MemoryOrder::release);
            }
            if(state.published[producer].load(MemoryOrder::acquire))
                state.invalidOrder.store(true, MemoryOrder::release);
            state.consumedPrefixMask.fetch_or(1u << (producer - 1u - s_ExternalProducerCount), MemoryOrder::release);
        }
    }
    state.published[producer].store(true, MemoryOrder::release);
    const u32 predecessor = (producer + 1u) % s_ProducerCount;
    if(!WaitUntil([&]()noexcept { return state.published[predecessor].load(MemoryOrder::acquire); })){
        state.expired.store(true, MemoryOrder::release);
        return;
    }
    for(u32 task = 0u; task < s_TasksPerProducer; ++task){
        const u32 slot = (producer * s_TasksPerProducer + task) * 4u;
        const u32 precedingSlot = (predecessor * s_TasksPerProducer + task) * 4u;
        const auto fourthCpuTaskAdmission = scope.submit([&state, slot, precedingSlot]()noexcept {
            for(u32 descendant = 0u; descendant < 3u; ++descendant){
                if(state.visits[precedingSlot + descendant].load(MemoryOrder::acquire) != 1u)
                    state.invalidOrder.store(true, MemoryOrder::release);
            }
            state.visits[slot + 3u].fetch_add(1u, MemoryOrder::relaxed);
        }, state.handles[predecessor][task]);
        if(!fourthCpuTaskAdmission || !fourthCpuTaskAdmission->valid())
            state.rejected.store(true, MemoryOrder::release);
    }
}

};


