using namespace NWB;
using namespace NWB::Impl::Ui;
using namespace NWB::UiTextAreaTests;


class UiTextAreaScrollLifetimeTests : public TextAreaFixture{
public:
    [[nodiscard]] static TextAreaOptions SmallOptions()noexcept;


public:
    UiTextAreaScrollLifetimeTests()
        : m_dense(m_arena)
    {
        const AStringView line("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789xx");
        for(usize row = 0u; row < 40u; ++row){
            if(row != 0u)
                m_dense.push_back('\n');
            m_dense.append(line.data(), line.size());
        }
    }


public:
    [[nodiscard]] AStringView denseView()const noexcept{
        return AStringView(m_dense.data(), m_dense.size());
    }

    [[nodiscard]] b8 seedModel();
    [[nodiscard]] b8 prepareOverflow(u64 generation = 1u, const TextAreaOptions& options = SmallOptions(), const Rect& bounds = { 20.0f, 20.0f, 740.0f, 520.0f });
    [[nodiscard]] WidgetId popupArea()const;
    [[nodiscard]] b8 popupFrame(u64 generation);
    [[nodiscard]] b8 wheel(f64 delta = -1.0);
    [[nodiscard]] b8 startThumb(WidgetId area);


public:
    PopupState m_parent;
    PopupState m_child;
    AString<Core::Alloc::GlobalArena> m_dense;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


