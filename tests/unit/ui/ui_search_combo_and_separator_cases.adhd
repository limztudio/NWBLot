const AStringView s_UiSearchComboCallbackQuery = "callback";
const AStringView s_UiSearchComboEmptyResultQuery = "None";
const AStringView s_UiSearchComboSecondHalfQuery = "Second";
const AStringView s_UiSearchComboPreeditText = "preedit";
const AStringView s_UiSearchComboKey = "combo";
const AStringView s_UiSearchComboPanelKey = "panel";
const u32 s_UiSeparatorQuietNaNF32Bits = 0x7fc00000u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> UiSearchComboBehaviorMutation{
    None, Query, SameQuery, QuerySelection, Selection, Open, Close, PreviewScroll,
    CompositionBegin, CompositionUpdate, CompositionCancel, CompositionCycle
}
enum<u8> UiSearchSelectionMutation{ None, Identical, AwayAndBack }
type UiSearchComboBuilderTests = SearchFixture;
type UiSeparatorTests = WidgetFixture;

class SearchBehaviorFilteredView : IListDataSource{
    public u64 generation = 97u;
    public u64 revisionValue = 1u;
    public u64 start = 0u;
    public u64 count = 0u;
    public TestObserved<b8> changeQueryOnCount;
    public mut SearchComboState m_state;

    public SearchBehaviorFilteredView(mut SearchComboState state){ this.m_state = state; }
    public u64 instanceGeneration()const override{ return this.generation; }
    public u64 revision()const override{ return this.revisionValue; }
    public u64 rowCount()const override{
        if(this.changeQueryOnCount.value()){
            this.changeQueryOnCount.value() = false;
            EXPECT_TRUE(this.m_state.query().setText(s_CallbackQuery));
        }
        return this.count;
    }
    public u64 key(in u64 index)const override{
        if(index < this.count)
            return this.start + index + 1u;
        return 0u;
    }
    public Expected<u64> indexOf(in u64 keyValue)const override{
        u64 index = 0u;
        if(keyValue <= this.start || keyValue - this.start > this.count)
            return MakeUnexpected(Failure());
        index = keyValue - this.start - 1u;
        return index;
    }
    public Expected<u64> findEnabled(in u64 first, in b8 arg1)const override{
        u64 index = 0u;
        if(first >= this.count)
            return MakeUnexpected(Failure());
        index = first;
        return index;
    }
    public StringView text(in u64 arg0)const override{ return "match"; }
    public b8 enabled(in u64 index)const override{ return index < this.count; }
}


class UiSearchComboBehaviorSource : ISearchableListDataSource{
    public SearchBehaviorFilteredView view;
    public String queryBytes;
    public u64 generation = 71u;
    public u64 revisionValue = 1u;
    public u64 count = 100000u;
    public u64 filterCalls = 0u;
    public u64 rebuilds = 0u;
    public b8 failFilter = false;
    public b8 changeFullGeneration = false;
    public b8 changeFullRevision = false;
    public b8 changeFullCount = false;
    public b8 invalidViewIdentity = false;
    public b8 oversizedView = false;
    public TestObserved<b8> changeQueryOnGeneration;
    public UiSearchComboBehaviorMutation onFilter = UiSearchComboBehaviorMutation::None;
    public mut SearchComboState m_state;
    public u64 m_generation = 0u;
    public u64 m_revision = 0u;
    public u64 m_count = 0u;
    public b8 m_valid = false;

    public UiSearchComboBehaviorSource(mut SearchComboState state){
        this.view = SearchBehaviorFilteredView(state);
        this.m_state = state;
    }
    public u64 instanceGeneration()const override{
        if(this.changeQueryOnGeneration.value()){
            this.changeQueryOnGeneration.value() = false;
            EXPECT_TRUE(this.m_state.query().setText(s_CallbackQuery));
        }
        return this.generation;
    }
    public u64 revision()const override{ return this.revisionValue; }
    public u64 rowCount()const override{ return this.count; }
    public u64 key(in u64 index)const override{
        if(index < this.count)
            return index + 1u;
        return 0u;
    }
    public Expected<u64> indexOf(in u64 keyValue)const override{
        u64 index = 0u;
        if(keyValue == 0u || keyValue > this.count)
            return MakeUnexpected(Failure());
        index = keyValue - 1u;
        return index;
    }
    public Expected<u64> findEnabled(in u64 start, in b8 arg1)const override{
        u64 index = 0u;
        if(start >= this.count)
            return MakeUnexpected(Failure());
        index = start;
        return index;
    }
    public StringView text(in u64 arg0)const override{ return "full row"; }
    public b8 enabled(in u64 index)const override{ return index < this.count; }
    public b8 filter(in StringView query)override{
        ++this.filterCalls;
        if(this.failFilter)
            return false;
        const StringView old = StringView(this.queryBytes);
        if(!this.m_valid || old != query || this.m_generation != this.generation || this.m_revision != this.revisionValue || this.m_count != this.count){
            this.queryBytes.clear();
            if(!query.empty())
                this.queryBytes.assign(query);
            this.view.start = 0u;
            if(query == "tail")
                this.view.start = this.count - Min<u64>(3u, this.count);
            this.view.count = this.count - this.view.start;
            if(query == "none")
                this.view.count = 0u;
            ++this.view.revisionValue;
            ++this.rebuilds;
            this.m_generation = this.generation;
            this.m_revision = this.revisionValue;
            this.m_count = this.count;
            this.m_valid = true;
        }
        if(this.changeFullGeneration)
            ++this.generation;
        if(this.changeFullRevision)
            ++this.revisionValue;
        if(this.changeFullCount)
            ++this.count;
        if(this.invalidViewIdentity)
            this.view.revisionValue = 0u;
        if(this.oversizedView)
            this.view.count = this.count + 1u;
        this.mutate();
        return true;
    }
    public in IListDataSource filtered()const override{ return this.view; }
    public StringView queryView()const{ return StringView(this.queryBytes); }
    public void mutate(){
        const UiSearchComboBehaviorMutation mutation = this.onFilter;
        this.onFilter = UiSearchComboBehaviorMutation::None;
        switch(mutation){
        case UiSearchComboBehaviorMutation::None:
            break;
        case UiSearchComboBehaviorMutation::Query:
            EXPECT_TRUE(this.m_state.query().setText(s_CallbackQuery));
            break;
        case UiSearchComboBehaviorMutation::SameQuery:
            EXPECT_TRUE(this.m_state.query().setText(this.m_state.query().text()));
            break;
        case UiSearchComboBehaviorMutation::QuerySelection:
            EXPECT_TRUE(this.m_state.query().selectAll());
            break;
        case UiSearchComboBehaviorMutation::Selection:
            this.m_state.combo().select(8u);
            break;
        case UiSearchComboBehaviorMutation::Open:
            this.m_state.combo().open();
            break;
        case UiSearchComboBehaviorMutation::Close:
            this.m_state.combo().close();
            break;
        case UiSearchComboBehaviorMutation::PreviewScroll:
            EXPECT_TRUE(this.m_state.combo().listState().scrollTo(64.0));
            break;
        case UiSearchComboBehaviorMutation::CompositionBegin:
            EXPECT_TRUE(this.m_state.query().beginComposition());
            break;
        case UiSearchComboBehaviorMutation::CompositionUpdate:
            EXPECT_TRUE(this.m_state.query().updateComposition(s_PreeditText, 0u, 7u));
            break;
        case UiSearchComboBehaviorMutation::CompositionCancel:
            this.m_state.query().cancelComposition();
            break;
        case UiSearchComboBehaviorMutation::CompositionCycle:
            EXPECT_TRUE(this.m_state.query().beginComposition() && this.m_state.query().updateComposition(s_PreeditText, 0u, 7u));
            this.m_state.query().cancelComposition();
            break;
        }
    }
}


class UiSearchComboBehaviorTests{
    public SearchComboState m_state;
    public UiSearchComboBehaviorSource m_source;

    public UiSearchComboBehaviorTests(){ this.m_source = UiSearchComboBehaviorSource(this.m_state); }

}


class SelectionProbe{
    public mut EditModel m_query;
    public TestObserved<UiSearchSelectionMutation> m_mutation = TestObserved<UiSearchSelectionMutation>(UiSearchSelectionMutation::None);
    public usize m_anchor = 0u;
    public usize m_caret = 0u;
    public TestObserved<u64> m_calls;

    public SelectionProbe(mut EditModel query){ this.m_query = query; }
    public void arm(in UiSearchSelectionMutation mutation){
        this.m_mutation.value() = mutation;
        this.m_anchor = this.m_query.anchor();
        this.m_caret = this.m_query.caret();
    }
    public b8 apply()const{
        const UiSearchSelectionMutation mutation = this.m_mutation.value();
        this.m_mutation.value() = UiSearchSelectionMutation::None;
        if(mutation == UiSearchSelectionMutation::None)
            return true;
        ++this.m_calls.value();
        if(mutation == UiSearchSelectionMutation::AwayAndBack && !this.m_query.setSelection(0u, 0u))
            return false;
        return this.m_query.setSelection(this.m_anchor, this.m_caret);
    }
    public u64 calls()const{ return this.m_calls.value(); }
}


class SelectionView : IListDataSource{
    public in IListDataSource m_source;
    public SelectionProbe m_probe;
    public TestObserved<u64> m_textCalls;

    public SelectionView(in borrow IListDataSource source, mut EditModel query){ this.m_source = source; this.m_probe = SelectionProbe(query); }
    public u64 instanceGeneration()const override{ return this.m_source.instanceGeneration(); }
    public u64 revision()const override{ return this.m_source.revision(); }
    public u64 rowCount()const override{ return this.m_source.rowCount(); }
    public u64 key(in u64 index)const override{ return this.m_source.key(index); }
    public Expected<u64> indexOf(in u64 key)const override{ return this.m_source.indexOf(key); }
    public Expected<u64> findEnabled(in u64 start, in b8 reverse)const override{
        return this.m_source.findEnabled(start, reverse);
    }
    public StringView text(in u64 index)const override{
        ++this.m_textCalls.value();
        EXPECT_TRUE(this.m_probe.apply());
        return this.m_source.text(index);
    }
    public b8 enabled(in u64 index)const override{ return this.m_source.enabled(index); }
    public void arm(in UiSearchSelectionMutation mutation){ this.m_probe.arm(mutation); }
    public u64 mutationCalls()const{ return this.m_probe.calls(); }
    public u64 textCalls()const{ return this.m_textCalls.value(); }
}


class SelectionSource : ISearchableListDataSource{
    public mut SearchSource m_source;
    public SelectionProbe m_probe;
    public SelectionView m_view;

    public SelectionSource(mut SearchSource source, mut EditModel query){ this.m_source = source; this.m_probe = SelectionProbe(query); this.m_view = SelectionView(source.filtered(), query); }
    public u64 instanceGeneration()const override{ return this.m_source.instanceGeneration(); }
    public u64 revision()const override{ return this.m_source.revision(); }
    public u64 rowCount()const override{ return this.m_source.rowCount(); }
    public u64 key(in u64 index)const override{ return this.m_source.key(index); }
    public Expected<u64> indexOf(in u64 key)const override{ return this.m_source.indexOf(key); }
    public Expected<u64> findEnabled(in u64 start, in b8 reverse)const override{
        return this.m_source.findEnabled(start, reverse);
    }
    public StringView text(in u64 index)const override{ return this.m_source.text(index); }
    public b8 enabled(in u64 index)const override{ return this.m_source.enabled(index); }
    public b8 filter(in StringView query)override{
        return this.m_probe.apply() && this.m_source.filter(query);
    }
    public in IListDataSource filtered()const override{ return this.m_view; }
    public void armFilter(in UiSearchSelectionMutation mutation){ this.m_probe.arm(mutation); }
    public u64 filterMutationCalls()const{ return this.m_probe.calls(); }
    public mut SelectionView view(){ return this.m_view; }
}


class UiSearchSelectionEpochTests : SearchFixture{
    public SelectionSource m_epochSource;
    public Rect m_displayedEditor;
    public WidgetId m_displayedFocus;
    public u64 m_queryRevision = 0u;
    public u64 m_queryExternalRevision = 0u;
    public u64 m_compositionGeneration = 0u;
    public u64 m_selectionGeneration = 0u;

    public UiSearchSelectionEpochTests(){ this.m_epochSource = SelectionSource(this.m_searchSource, this.m_search.query()); }
    public b8 declareEpochSearch(in u64 generation){
        return DeclareUiSearchSelectionEpoch(this, generation);
    }
}


b8 UiSearchComboReconcilePreview(mut SearchComboState state, in IListDataSource source){ return ReconcileListState(state.combo().listState(), source); }
void UiSearchComboSelectPreview(mut SearchComboState state, in u64 key){ state.combo().listState().select(key); }
b8 UiSearchComboScrollPreview(mut SearchComboState state, in f64 offset){ return state.combo().listState().scrollTo(offset); }


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 DeclareUiSearchSelectionEpoch(mut UiSearchSelectionEpochTests self, in u64 generation){
    Rect bounds = Rect();
    bounds.x = 10.0f;
    bounds.y = 10.0f;
    bounds.width = 320.0f;
    bounds.height = 280.0f;
    if(!self.begin(generation) || !self.m_builder.beginPanel("panel", bounds))
        return false;
    self.m_searchResult = self.m_builder.searchComboBox("combo", self.m_epochSource, self.m_search, MakeSearchComboFixtureOptions());
    return self.m_searchResult.combo.valid;
}


b8 AcceptUiSearchSelectionEpochInitial(mut UiSearchSelectionEpochTests self){
    self.m_search.combo().select(4u);
    self.m_search.combo().open();
    if(!self.m_search.query().setText(s_UiSearchComboSecondHalfQuery) || !self.m_search.query().setSelection(1u, 4u))
        return false;
    if(!self.declareEpochSearch(1u) || !self.finishPanel() || !self.m_context.commitFrame(1u))
        return false;
    const auto editor = self.tryTarget(self.query());
    if(!editor.has_value())
        return false;
    self.m_displayedEditor = editor.value().rectangle;
    self.m_displayedFocus = self.m_context.input().focus();
    self.m_queryRevision = self.m_search.query().revision();
    self.m_queryExternalRevision = self.m_search.query().externalRevision();
    self.m_compositionGeneration = self.m_search.query().compositionGeneration();
    self.m_selectionGeneration = self.m_search.query().selectionGeneration();
    return true;
}

void ExpectUiSearchSelectionEpochPreservedState(mut UiSearchSelectionEpochTests self, in b8 focusRetired){
    EXPECT_EQ(self.m_search.query().text(), s_UiSearchComboSecondHalfQuery);
    EXPECT_EQ(self.m_search.query().anchor(), 1u);
    EXPECT_EQ(self.m_search.query().caret(), 4u);
    EXPECT_EQ(self.m_search.query().revision(), self.m_queryRevision);
    EXPECT_EQ(self.m_search.query().externalRevision(), self.m_queryExternalRevision);
    EXPECT_EQ(self.m_search.query().compositionGeneration(), self.m_compositionGeneration);
    EXPECT_NE(self.m_search.query().selectionGeneration(), self.m_selectionGeneration);
    EXPECT_EQ(self.m_search.combo().selectedKey(), 4u);
    EXPECT_TRUE(self.m_search.combo().isOpen());
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
    if(focusRetired)
        EXPECT_FALSE(self.m_context.input().focus().valid());
    else
        EXPECT_EQ(self.m_context.input().focus(), self.m_displayedFocus);
    const auto editor = self.tryTarget(self.query());
    ASSERT_TRUE(editor.has_value());
    const Rect actualEditor = editor.value().rectangle;
    ExpectUiRect(actualEditor, self.m_displayedEditor);
}

void VerifyUiSearchSelectionEpochFilterRejection(mut UiSearchSelectionEpochTests self, in UiSearchSelectionMutation mutation){
    ASSERT_TRUE(AcceptUiSearchSelectionEpochInitial(self));
    const u64 loans = self.m_host.loans;
    const u64 rowCalls = self.m_epochSource.view().textCalls();
    ++self.m_searchSource.full.contentRevision;
    self.m_epochSource.armFilter(mutation);
    EXPECT_FALSE(self.declareEpochSearch(2u));
    EXPECT_EQ(self.m_epochSource.filterMutationCalls(), 1u);
    EXPECT_EQ(self.m_host.loans, loans);
    EXPECT_EQ(self.m_epochSource.view().textCalls(), rowCalls);
    EXPECT_EQ(self.m_searchSource.full.contentRevision, 2u);
    ExpectUiSearchSelectionEpochPreservedState(self, false);
}

void VerifyUiSearchSelectionEpochDeferredPaintRejection(mut UiSearchSelectionEpochTests self, in UiSearchSelectionMutation mutation){
    ASSERT_TRUE(AcceptUiSearchSelectionEpochInitial(self));
    ASSERT_TRUE(self.declareEpochSearch(2u));
    const u64 rowCalls = self.m_epochSource.view().textCalls();
    self.m_epochSource.view().arm(mutation);
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_EQ(self.m_epochSource.view().mutationCalls(), 1u);
    EXPECT_GT(self.m_epochSource.view().textCalls(), rowCalls);
    ExpectUiSearchSelectionEpochPreservedState(self, true);
}


