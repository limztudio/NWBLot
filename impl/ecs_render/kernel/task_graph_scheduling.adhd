// These buffers return to Common at packet close. The first consumer owns the transition to its read state.
[cpp_unwind]
b8 AppendImmutableBufferUpload(mut GpuTaskGraph graph, in GpuUploadBlobId blob, in GpuGraphResourceId destination, in Name identity, in StringView label, mut GpuTaskId dependency, in b8 mergeWithPrevious){
    GpuTaskSchedulingHint scheduling;
    scheduling.cost = GpuTaskCostHint::Tiny;
    scheduling.forceSubmissionBoundary = false;
    scheduling.allowPacketMerge = true;
    scheduling.mergeWithPrevious = mergeWithPrevious;
    GpuTaskDesc task;
    task.setIdentity(identity).setMarkerLabel(label).setScheduling(scheduling);
    task.setDependency(dependency);
    GpuUploadBufferTaskDesc upload;
    upload.source = blob;
    upload.destination = destination;
    upload.finalState = ResourceStates::Common;
    const auto result = graph.addUploadBufferTask(task, upload);
    if(!result.has_value()){
        dependency = GpuTaskId();
        return false;
    }
    dependency = result.value();
    return true;
}

[cpp_unwind]
b8 AppendImmutableBufferUpload(mut GpuTaskGraph graph, in GpuUploadBlobId blob, in GpuGraphResourceId destination, in Name identity, in StringView label, mut GpuTaskId dependency){
    return AppendImmutableBufferUpload(graph, blob, destination, identity, label, dependency, true);
}

GpuTaskCommandRequirements SharedComputeEmulationCommandRequirements(in b8 generatePhase){
    GpuTaskCommandRequirements requirements;
    if(generatePhase)
        requirements.requiredCapabilities = GpuQueueCapability::Compute;
    else
        requirements.requiredCapabilities = GpuQueueCapability::Graphics;
    return requirements;
}


class SharedComputeEmulationPhaseTable{
    public Array<Name, s_SharedComputeEmulationMaximumPhaseCount> identities;
    public Array<StringView, s_SharedComputeEmulationMaximumPhaseCount> markers;

    public void set(in usize index, in Name identity, in StringView marker){
        this.identities[index] = identity;
        this.markers[index] = marker;
    }
}


SharedComputeEmulationPhaseTable OpaqueSharedComputeEmulationPhases(){
    SharedComputeEmulationPhaseTable table;
    table.set(0u, Name("render.graphics_prefix.opaque.shared_compute_emulation_generate_a"), "Opaque Shared Compute Emulation Generate A");
    table.set(1u, Name("render.graphics_prefix.opaque.shared_compute_emulation_raster_a"), "Opaque Shared Compute Emulation Raster A");
    table.set(2u, Name("render.graphics_prefix.opaque.shared_compute_emulation_generate_b"), "Opaque Shared Compute Emulation Generate B");
    table.set(3u, Name("render.graphics_prefix.opaque.shared_compute_emulation_raster_b"), "Opaque Shared Compute Emulation Raster B");
    table.set(4u, Name("render.graphics_prefix.opaque.shared_compute_emulation_generate_c"), "Opaque Shared Compute Emulation Generate C");
    table.set(5u, Name("render.graphics_prefix.opaque.shared_compute_emulation_raster_c"), "Opaque Shared Compute Emulation Raster C");
    table.set(6u, Name("render.graphics_prefix.opaque.shared_compute_emulation_generate_d"), "Opaque Shared Compute Emulation Generate D");
    table.set(7u, Name("render.graphics_prefix.opaque.shared_compute_emulation_raster_d"), "Opaque Shared Compute Emulation Raster D");
    table.set(8u, Name("render.graphics_prefix.opaque.shared_compute_emulation_generate_e"), "Opaque Shared Compute Emulation Generate E");
    table.set(9u, Name("render.graphics_prefix.opaque.shared_compute_emulation_raster_e"), "Opaque Shared Compute Emulation Raster E");
    return table;
}

