////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/global.adhd>
#include <impl/assets_skeleton/joint_validation.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_SkeletonAssetKindLabel = "skeleton";

type JointVector = Vector<SkeletonJoint>;
type JointIndexMap = HashMap<Name, u32>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[arena, asset("skeleton")]
class Skeleton{
    private JointVector m_joints;
    private JointIndexMap m_jointIndices;

    public void setJoints(in JointVector joints, in JointIndexMap jointIndices){
        this.m_joints = joints;
        this.m_jointIndices = jointIndices;
    }

    public in JointVector joints()const{ return this.m_joints; }
    public in JointIndexMap jointIndices()const{ return this.m_jointIndices; }
    public u32 jointCount()const{ return cast<u32>(this.m_joints.size()); }
    public u32 findJointIndex(in Name jointName)const{
        if(!this.m_jointIndices.contains(jointName))
            return s_SkeletonInvalidJointIndex;
        for(in auto jointLookup : this.m_jointIndices){
            if(jointLookup.first == jointName)
                return jointLookup.second;
        }
        return s_SkeletonInvalidJointIndex;
    }

    public b8 validatePayload(mut ScratchArena scratchArena)const;
    public b8 loadBinary(in Span<u8> binary);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
