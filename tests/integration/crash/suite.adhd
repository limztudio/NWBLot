}

void VerifyCrash_LinuxSignalHandlerWritesCrashPackage(){
    if(!IsDesktopLinuxCrashPlatform())
        return;

    const StringView group = "crash_linux_signal_runtime_test";
    RemoveTestArtifacts(group);
    const Path spoolDirectory = SpoolDirectory(group);
    b8 childSpawned = false;
    b8 signaledBySegv = false;
    String crashIdText = String();
    native(in spoolDirectory, mut childSpawned, mut signaledBySegv, mut crashIdText){
#if defined(FOUNDATION_PLATFORM_LINUX) && !defined(FOUNDATION_PLATFORM_ANDROID)
        const pid_t childPid = fork();
        ASSERT_GE(childPid, 0);
        if(childPid == 0){
            PersistentArena installArena(s_SignalChildInstallArena, PersistentArena::StructureAlignedSize(64u * 1024u));
            Core::Crash::CrashConfigT<PersistentArena> config(installArena);
            config.applicationName = AStringView(s_CrashTests);
            config.version = AStringView(s_ApplicationVersion);
            config.buildId = AStringView("linux-signal-runtime-test");
            config.spoolDirectory = spoolDirectory;

            {
                ScopedLock lock(Core::Crash::CrashDetail::g_State.mutex);
                Core::Crash::CrashDetail::g_State.crashSequence.store(1u, MemoryOrder::relaxed);
            }

            if(!Core::Crash::InstallCrashHandler(config))
                _exit(111);

            raise(SIGSEGV);
            _exit(112);
        }

        if(childPid > 0){
            childSpawned = true;
            int status = 0;
            while(waitpid(childPid, &status, 0) < 0){
                if(errno == EINTR)
                    continue;
                break;
            }

            signaledBySegv = WIFSIGNALED(status) && WTERMSIG(status) == SIGSEGV;
            Array<char, Core::Crash::CrashDetail::s_MaxShortText> crashId = {};
            BuildCrashIdForProcess(static_cast<u32>(childPid), 1u, crashId);
            const AStringView idView = FixedBufferView(crashId);
            crashIdText.assign(idView.data(), idView.size());
        }
#endif
    }

    if(childSpawned){
        EXPECT_TRUE(signaledBySegv);
        const Path packageDirectory = PackageDirectory(group, s_PendingBucket, crashIdText);
        const u32 missingPackageReadyTimeoutMs = 1000u;
        ExpectDirectoryReady(packageDirectory, missingPackageReadyTimeoutMs);
        ExpectIsRegularFile(packageDirectory / s_ManifestFileName, true);
        ExpectIsRegularFile(packageDirectory / s_CallstackFileName, true);
        // The faulting callstack must reach past the leaf frame without frame pointers.
        EXPECT_TRUE(TextFileContains(packageDirectory / s_CallstackFileName, "#1 0x"));
        ExpectIsRegularFile(packageDirectory / s_ProcMapsFileName, true);
        EXPECT_TRUE(TextFileContains(packageDirectory / s_ManifestFileName, "\"reason_kind\": \"signal\""));
    }
    RemoveTestArtifacts(group);
}

