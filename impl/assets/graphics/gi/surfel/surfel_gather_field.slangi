////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_GI_SURFEL_GATHER_FIELD_SLANGI
#define NWB_GRAPHICS_GI_SURFEL_GATHER_FIELD_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_SURFEL_GATHER_FIELD_POOL
    #error NWB_SURFEL_GATHER_FIELD_POOL must select a read-only NwbSurfel buffer
#endif
#ifndef NWB_SURFEL_GATHER_FIELD_CELL_HEAD
    #error NWB_SURFEL_GATHER_FIELD_CELL_HEAD must select a read-only cell-head buffer
#endif
#ifndef NWB_SURFEL_GATHER_FIELD_CONSTANTS
    #error NWB_SURFEL_GATHER_FIELD_CONSTANTS must select NwbSurfelConstants
#endif
#ifndef NWB_SURFEL_GATHER_FIELD_INDEX_VALID
    #error NWB_SURFEL_GATHER_FIELD_INDEX_VALID must validate a cell-list index
#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "surfel_heap_resources.slangi"
#include "surfel_hash.slangi"
#include "surfel_sh.slangi"
#include "surfel_coverage.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


bool nwbSurfelGatherField(const float3 worldPosition, const float3 normal, const uint poolCapacity, out half3 outIrradiance, out half outCoverage){
    outIrradiance = half3(0.0h);
    outCoverage = half(0.0h);

    const float cellSize = NWB_SURFEL_GATHER_FIELD_CONSTANTS.cellSizeRadiusBiasAccum.x;
    const float safeCellSize = max(cellSize, NWB_SURFEL_HASH_CELL_SIZE_MIN);
    const uint cellMask = uint(NWB_SURFEL_GATHER_FIELD_CONSTANTS.hashPoolFrameDivisor.x) - 1u;
    const float normalBias = NWB_SURFEL_GATHER_FIELD_CONSTANTS.cellSizeRadiusBiasAccum.z;
    const float radius = max(NWB_SURFEL_GATHER_FIELD_CONSTANTS.cellSizeRadiusBiasAccum.y, NWB_SURFEL_RADIUS_MIN);
    const float radiusSq = radius * radius;
    const float invRadius = 1.0 / radius;
    const half invFullConf = half(1.0 / NWB_SURFEL_GATHER_FULL_CONFIDENCE_SAMPLE_COUNT);
    const half4 shBasis = nwbSurfelShReconstructionBasis(half3(normal));
    const float3 biasedPosition = worldPosition + normal * normalBias;

    half3 irradianceSum = half3(0.0h);
    half totalWeight = half(0.0h);
    const int3 baseCell = nwbSurfelCellCoord(biasedPosition, safeCellSize);
    const int3 minCell = max(nwbSurfelCellCoord(biasedPosition - float3(radius), safeCellSize), baseCell - int3(NWB_SURFEL_GATHER_CELL_EXTENT));
    const int3 maxCell = min(nwbSurfelCellCoord(biasedPosition + float3(radius), safeCellSize), baseCell + int3(NWB_SURFEL_GATHER_CELL_EXTENT));
    for(int cz = minCell.z; cz <= maxCell.z; ++cz){
        const float minZ = float(cz) * safeCellSize;
        const float maxZ = minZ + safeCellSize;
        const float dz = biasedPosition.z - clamp(biasedPosition.z, minZ, maxZ);
        const float dzSq = dz * dz;
        if(dzSq >= radiusSq)
            continue;
        const uint hashZ = uint(cz) * NWB_SURFEL_HASH_PRIME_Z;

        for(int cy = minCell.y; cy <= maxCell.y; ++cy){
            const float minY = float(cy) * safeCellSize;
            const float maxY = minY + safeCellSize;
            const float dy = biasedPosition.y - clamp(biasedPosition.y, minY, maxY);
            const float dyzSq = dzSq + dy * dy;
            if(dyzSq >= radiusSq)
                continue;
            const uint hashYZ = (uint(cy) * NWB_SURFEL_HASH_PRIME_Y) ^ hashZ;

            for(int cx = minCell.x; cx <= maxCell.x; ++cx){
                const float minX = float(cx) * safeCellSize;
                const float maxX = minX + safeCellSize;
                const float dx = biasedPosition.x - clamp(biasedPosition.x, minX, maxX);
                if(dyzSq + dx * dx >= radiusSq)
                    continue;

                const int3 cell = int3(cx, cy, cz);
                const uint bucket = (hashYZ ^ (uint(cx) * NWB_SURFEL_HASH_PRIME_X)) & cellMask;
                uint id = NWB_SURFEL_GATHER_FIELD_CELL_HEAD[bucket];
                uint walk = 0u;
                [loop] while(NWB_SURFEL_GATHER_FIELD_INDEX_VALID(id, poolCapacity) && walk < NWB_SURFEL_MAX_WALK){
                    const uint nextInCell = NWB_SURFEL_GATHER_FIELD_POOL[id].nextInCell;
                    const uint sampleState = NWB_SURFEL_GATHER_FIELD_POOL[id].sampleState;
                    const uint sampleCount = nwbSurfelSampleCount(sampleState);
                    if(nwbSurfelIsAlive(sampleState) && sampleCount != 0u){
                        const float3 delta = biasedPosition - NWB_SURFEL_GATHER_FIELD_POOL[id].position;
                        const float distSq = dot(delta, delta);
                        if(distSq < radiusSq){
                            const half normalWeight = half(saturate(dot(normal, NWB_SURFEL_GATHER_FIELD_POOL[id].normal)));
                            if(normalWeight > half(0.0h) && nwbSurfelSameCell(NWB_SURFEL_GATHER_FIELD_POOL[id].cell, cell)){
                                const half distanceWeight = half(saturate(1.0 - sqrt(distSq) * invRadius));
                                const half confidence = saturate(half(sampleCount) * invFullConf);
                                const half weight = normalWeight * distanceWeight * confidence;
                                if(weight > half(0.0h)){
                                    irradianceSum += nwbSurfelShReconstructWithScaledBasis(half4(NWB_SURFEL_GATHER_FIELD_POOL[id].shR), half4(NWB_SURFEL_GATHER_FIELD_POOL[id].shG), half4(NWB_SURFEL_GATHER_FIELD_POOL[id].shB), shBasis) * weight;
                                    totalWeight += weight;
                                }
                            }
                        }
                    }
                    id = nextInCell;
                    ++walk;
                }
            }
        }
    }

    if(totalWeight < half(NWB_SURFEL_GATHER_WEIGHT_EPSILON))
        return false;
    outIrradiance = irradianceSum / totalWeight;
    outCoverage = half(nwbSurfelGatherCoverage(float(totalWeight)));
    return true;
}

bool nwbSurfelGatherField(const float3 worldPosition, const float3 normal, const uint poolCapacity, out half3 outIrradiance){
    half ignoredCoverage;
    return nwbSurfelGatherField(worldPosition, normal, poolCapacity, outIrradiance, ignoredCoverage);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

