#include "validation.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class LayoutGridCellPlacement{
    public u32 child = 0u;
    public u32 row = 0u;
    public u32 col = 0u;
    public u32 rowSpan = 1u;
    public u32 colSpan = 1u;
}

class LayoutScratch{
    public Vector<u32> gridColOccupiedUntil;
    public Vector<LayoutGridCellPlacement> gridPlacements;
    public Vector<f64> gridColWidths;
    public Vector<f64> gridRowHeights;
    public Vector<f64> gridColWeights;
    public Vector<f64> gridRowWeights;
    public Vector<b8> gridTrackFrozen;
    public Vector<f64> gridColX;
    public Vector<f64> gridRowY;
    public Vector<u32> flowChildren;
    public Vector<f64> flowMeasuredMain;
    public Vector<f64> flowMeasuredCross;
    public Vector<u32> wrapLineStarts;
    public Vector<u32> wrapLineEnds;
    public Vector<f64> wrapLineCrossHeights;
    public Vector<f64> flexItemMain;
    public Vector<f64> flexMinMains;
    public Vector<f64> flexMaxMains;
    public Vector<f64> flexMainWeights;
    public Vector<f64> flexMarginMains;
    public Vector<b8> flexFrozenMain;
}

b8 CanAddLayoutTreeNode(in Span<LayoutTreeNode> nodes, in u32 maxNodes, in b8 buildFailed, in u32 parent, in LayoutNodeDesc description){
    if(buildFailed || nodes.size() >= cast<usize>(maxNodes) || !IsValidLayoutNodeDesc(description))
        return false;
    if(nodes.empty())
        return parent == s_LayoutNoParent;
    if(cast<usize>(parent) >= nodes.size())
        return false;
    return nodes[cast<usize>(parent)].description.direction != LayoutDirection::Leaf;
}

VectorDouble ComputeFlowChildOuterSizeF64(in LayoutNodeDesc childDesc, in Point measured){
    const f64 outerX = cast<f64>(measured.x) + cast<f64>(childDesc.margin.left) + cast<f64>(childDesc.margin.right);
    const f64 outerY = cast<f64>(measured.y) + cast<f64>(childDesc.margin.top) + cast<f64>(childDesc.margin.bottom);
    return VectorDouble(outerX, outerY, 0.0, 0.0);
}

b8 BuildLayoutGridPlacements(
    in Span<LayoutTreeNode> nodes,
    in u32 index,
    mut Vector<u32> colOccupiedUntil,
    mut Vector<LayoutGridCellPlacement> outPlacements,
    mut u32 outRowCount
){
    outPlacements.clear();
    colOccupiedUntil.clear();
    outRowCount = 0u;
    in LayoutTreeNode parent = nodes[cast<usize>(index)];
    const u32 cols = parent.description.gridColumns;
    if(cols == 0u)
        return false;
    u32 cursorRow = 0u;
    u32 cursorCol = 0u;
    u32 maxRow = 0u;
    for(u32 child = parent.firstChild; child != s_LayoutNoParent; child = nodes[cast<usize>(child)].nextSibling){
        in LayoutNodeDesc childDesc = nodes[cast<usize>(child)].description;
        if(childDesc.positionMode == LayoutPositionMode::Absolute)
            continue;
        u32 colSpan = childDesc.gridColumnSpan;
        if(colSpan > cols)
            colSpan = cols;
        if(colSpan == 0u)
            colSpan = 1u;
        const u32 rowSpan = Min(childDesc.gridRowSpan, s_LayoutMaxNodes);
        b8 scannedFromZero = cursorCol == 0u;
        u32 nextEventRow = u32.max;
        while(true){
            if(cursorCol + colSpan > cols){
                if(scannedFromZero && nextEventRow != u32.max && nextEventRow > cursorRow)
                    cursorRow = nextEventRow;
                else
                    ++cursorRow;
                cursorCol = 0u;
                scannedFromZero = true;
                nextEventRow = u32.max;
            }
            if(cursorRow >= maxRow || cast<usize>(cursorCol) >= colOccupiedUntil.size())
                break;
            u32 blockedCol = u32.max;
            for(u32 k = colSpan; k > 0u; --k){
                const u32 c = cursorCol + k - 1u;
                if(cast<usize>(c) < colOccupiedUntil.size()){
                    const u32 until = colOccupiedUntil[cast<usize>(c)];
                    if(until > cursorRow){
                        if(until < nextEventRow)
                            nextEventRow = until;
                        if(blockedCol == u32.max)
                            blockedCol = c;
                    }
                }
            }
            if(blockedCol == u32.max)
                break;
            cursorCol = blockedCol + 1u;
        }
        LayoutGridCellPlacement entry;
        entry.child = child;
        entry.row = cursorRow;
        entry.col = cursorCol;
        entry.rowSpan = rowSpan;
        entry.colSpan = colSpan;
        outPlacements.push_back(entry);
        const u32 endRow = cursorRow + rowSpan;
        if(endRow > maxRow)
            maxRow = endRow;
        const usize neededCols = cast<usize>(cursorCol + colSpan);
        if(colOccupiedUntil.size() < neededCols)
            colOccupiedUntil.resize(neededCols, 0u);
        for(u32 k = 0u; k < colSpan; ++k)
            colOccupiedUntil[cast<usize>(cursorCol + k)] = endRow;
        cursorCol += colSpan;
        if(cursorCol >= cols){
            ++cursorRow;
            cursorCol = 0u;
        }
    }
    outRowCount = maxRow;
    return true;
}

b8 MeasureLayoutWrappedNodeF64(
    in Span<LayoutTreeNode> nodes,
    in Span<LayoutBox> boxes,
    in u32 index,
    in f64 mainLimit,
    mut f64 outExtentX,
    mut f64 outExtentY
){
    outExtentX = 0.0;
    outExtentY = 0.0;
    in LayoutTreeNode parent = nodes[cast<usize>(index)];
    in LayoutNodeDesc description = parent.description;
    const b8 row = description.direction == LayoutDirection::Row;
    const f64 mainGap = cast<f64>(description.gap);
    const f64 crossGap = ResolveLayoutCrossGapF64(description);
    f64 totalMain = 0.0;
    f64 totalCross = 0.0;
    f64 lineMain = 0.0;
    f64 lineCross = 0.0;
    u32 lineItemCount = 0u;
    u32 lineCount = 0u;
    for(u32 child = parent.firstChild; child != s_LayoutNoParent; child = nodes[cast<usize>(child)].nextSibling){
        in LayoutNodeDesc childDesc = nodes[cast<usize>(child)].description;
        if(childDesc.positionMode == LayoutPositionMode::Absolute)
            continue;
        const VectorDouble outer = ComputeFlowChildOuterSizeF64(childDesc, boxes[cast<usize>(child)].measuredSize);
        f64 itemMain = outer.y;
        f64 itemCross = outer.x;
        if(row){
            itemMain = outer.x;
            itemCross = outer.y;
        }
        if(lineItemCount > 0u && ((lineMain + mainGap) + itemMain) > mainLimit){
            totalMain = Max(totalMain, lineMain);
            totalCross += lineCross;
            ++lineCount;
            lineMain = itemMain;
            lineCross = itemCross;
            lineItemCount = 1u;
        }
        else{
            if(lineItemCount > 0u)
                lineMain += mainGap;
            lineMain += itemMain;
            lineCross = Max(lineCross, itemCross);
            ++lineItemCount;
        }
    }
    if(lineItemCount > 0u){
        totalMain = Max(totalMain, lineMain);
        totalCross += lineCross;
        ++lineCount;
    }
    if(lineCount > 1u)
        totalCross += crossGap * cast<f64>(lineCount - 1u);
    if(totalMain > s_UiMaxFloatF64 || totalCross > s_UiMaxFloatF64)
        return false;
    if(row){
        outExtentX = totalMain;
        outExtentY = totalCross;
    }
    else{
        outExtentX = totalCross;
        outExtentY = totalMain;
    }
    return true;
}

void ResolveLayoutGridAxisTracksF64(
    in b8 hasAvail,
    in f64 availExtent,
    in f64 trackGap,
    in Vector<f64> stretchWeights,
    mut Vector<b8> frozen,
    mut Vector<f64> trackSizes
){
    const u32 count = cast<u32>(trackSizes.size());
    if(!hasAvail || count == 0u)
        return;
    f64 totalWeight = 0.0;
    f64 nonStretchSum = 0.0;
    for(u32 i = 0u; i < count; ++i){
        const f64 w = stretchWeights[cast<usize>(i)];
        if(w > 0.0)
            totalWeight += w;
        else
            nonStretchSum += trackSizes[cast<usize>(i)];
    }
    if(totalWeight <= 0.0)
        return;
    const f64 totalGap = trackGap * cast<f64>(count - 1u);
    f64 budget = Max(0.0, (availExtent - totalGap) - nonStretchSum);
    frozen.clear();
    frozen.resize(cast<usize>(count), false);
    for(u32 i = 0u; i < count; ++i){
        if(stretchWeights[cast<usize>(i)] <= 0.0)
            frozen[cast<usize>(i)] = true;
    }
    f64 activeWeight = totalWeight;
    for(u32 pass = 0u; pass < count; ++pass){
        if(activeWeight <= 0.0)
            break;
        b8 newlyFrozen = false;
        for(u32 i = 0u; i < count; ++i){
            if(frozen[cast<usize>(i)])
                continue;
            const f64 share = budget * (stretchWeights[cast<usize>(i)] / activeWeight);
            const f64 floorVal = trackSizes[cast<usize>(i)];
            if(share < floorVal){
                frozen[cast<usize>(i)] = true;
                budget = Max(0.0, budget - floorVal);
                activeWeight -= stretchWeights[cast<usize>(i)];
                newlyFrozen = true;
            }
        }
        if(!newlyFrozen){
            for(u32 i = 0u; i < count; ++i){
                if(!frozen[cast<usize>(i)])
                    trackSizes[cast<usize>(i)] = budget * (stretchWeights[cast<usize>(i)] / activeWeight);
            }
            break;
        }
    }
}

b8 ResolveLayoutGridTracksFromPlacementsF64(
    in Span<LayoutTreeNode> nodes,
    in Span<LayoutBox> boxes,
    in u32 index,
    in b8 hasAvailW,
    in f64 availW,
    in b8 hasAvailH,
    in f64 availH,
    in Span<LayoutGridCellPlacement> placements,
    in u32 rowCount,
    mut Vector<f64> colWeights,
    mut Vector<f64> rowWeights,
    mut Vector<b8> frozen,
    mut Vector<f64> outColWidths,
    mut Vector<f64> outRowHeights,
    mut f64 outExtentX,
    mut f64 outExtentY
){
    outColWidths.clear();
    outRowHeights.clear();
    outExtentX = 0.0;
    outExtentY = 0.0;
    if(placements.empty())
        return true;
    u32 usedCols = 0u;
    for(in auto placed : placements){
        const u32 endCol = placed.col + placed.colSpan;
        if(endCol > usedCols)
            usedCols = endCol;
    }
    if(usedCols == 0u || rowCount == 0u)
        return true;
    in LayoutNodeDesc description = nodes[cast<usize>(index)].description;
    const f64 colGap = cast<f64>(description.gap);
    const f64 rowGap = ResolveLayoutCrossGapF64(description);
    outColWidths.resize(cast<usize>(usedCols), 0.0);
    outRowHeights.resize(cast<usize>(rowCount), 0.0);
    colWeights.clear();
    rowWeights.clear();
    colWeights.resize(cast<usize>(usedCols), 0.0);
    rowWeights.resize(cast<usize>(rowCount), 0.0);
    for(in auto placed : placements){
        in LayoutNodeDesc childDesc = nodes[cast<usize>(placed.child)].description;
        const VectorDouble outer = ComputeFlowChildOuterSizeF64(childDesc, boxes[cast<usize>(placed.child)].measuredSize);
        if(placed.colSpan == 1u){
            const usize c = cast<usize>(placed.col);
            if(childDesc.width.policy == LayoutSizePolicy::Stretch){
                colWeights[c] = Max(colWeights[c], cast<f64>(childDesc.width.value));
                const f64 minOuterX = cast<f64>(childDesc.minWidth) + cast<f64>(childDesc.margin.left) + cast<f64>(childDesc.margin.right);
                outColWidths[c] = Max(outColWidths[c], minOuterX);
            }
            else{
                outColWidths[c] = Max(outColWidths[c], outer.x);
            }
        }
        if(placed.rowSpan == 1u){
            const usize r = cast<usize>(placed.row);
            if(childDesc.height.policy == LayoutSizePolicy::Stretch){
                rowWeights[r] = Max(rowWeights[r], cast<f64>(childDesc.height.value));
                const f64 minOuterY = cast<f64>(childDesc.minHeight) + cast<f64>(childDesc.margin.top) + cast<f64>(childDesc.margin.bottom);
                outRowHeights[r] = Max(outRowHeights[r], minOuterY);
            }
            else{
                outRowHeights[r] = Max(outRowHeights[r], outer.y);
            }
        }
    }
    for(in auto placed : placements){
        in LayoutNodeDesc childDesc = nodes[cast<usize>(placed.child)].description;
        const VectorDouble outer = ComputeFlowChildOuterSizeF64(childDesc, boxes[cast<usize>(placed.child)].measuredSize);
        if(placed.colSpan > 1u){
            if(childDesc.width.policy == LayoutSizePolicy::Stretch){
                for(u32 k = 0u; k < placed.colSpan; ++k){
                    const usize c = cast<usize>(placed.col + k);
                    colWeights[c] = Max(colWeights[c], cast<f64>(childDesc.width.value) / cast<f64>(placed.colSpan));
                }
            }
            else{
                f64 spannedSum = colGap * cast<f64>(placed.colSpan - 1u);
                for(u32 k = 0u; k < placed.colSpan; ++k)
                    spannedSum += outColWidths[cast<usize>(placed.col + k)];
                if(outer.x > spannedSum){
                    const f64 shareAdd = (outer.x - spannedSum) / cast<f64>(placed.colSpan);
                    for(u32 k = 0u; k < placed.colSpan; ++k)
                        outColWidths[cast<usize>(placed.col + k)] += shareAdd;
                }
            }
        }
        if(placed.rowSpan > 1u){
            if(childDesc.height.policy == LayoutSizePolicy::Stretch){
                for(u32 k = 0u; k < placed.rowSpan; ++k){
                    const usize r = cast<usize>(placed.row + k);
                    rowWeights[r] = Max(rowWeights[r], cast<f64>(childDesc.height.value) / cast<f64>(placed.rowSpan));
                }
            }
            else{
                f64 spannedSum = rowGap * cast<f64>(placed.rowSpan - 1u);
                for(u32 k = 0u; k < placed.rowSpan; ++k)
                    spannedSum += outRowHeights[cast<usize>(placed.row + k)];
                if(outer.y > spannedSum){
                    const f64 shareAdd = (outer.y - spannedSum) / cast<f64>(placed.rowSpan);
                    for(u32 k = 0u; k < placed.rowSpan; ++k)
                        outRowHeights[cast<usize>(placed.row + k)] += shareAdd;
                }
            }
        }
    }
    ResolveLayoutGridAxisTracksF64(hasAvailW, availW, colGap, colWeights, frozen, outColWidths);
    ResolveLayoutGridAxisTracksF64(hasAvailH, availH, rowGap, rowWeights, frozen, outRowHeights);
    f64 sumX = colGap * cast<f64>(usedCols - 1u);
    for(in f64 w : outColWidths)
        sumX += w;
    f64 sumY = rowGap * cast<f64>(rowCount - 1u);
    for(in f64 h : outRowHeights)
        sumY += h;
    if(sumX > s_UiMaxFloatF64 || sumY > s_UiMaxFloatF64)
        return false;
    outExtentX = sumX;
    outExtentY = sumY;
    return true;
}

b8 MeasureLayoutGridTracksF64(
    in Span<LayoutTreeNode> nodes,
    in Span<LayoutBox> boxes,
    in u32 index,
    in b8 hasAvailW,
    in f64 availW,
    in b8 hasAvailH,
    in f64 availH,
    mut LayoutScratch scratch,
    mut f64 outExtentX,
    mut f64 outExtentY
){
    u32 rowCount = 0u;
    if(!BuildLayoutGridPlacements(nodes, index, scratch.gridColOccupiedUntil, scratch.gridPlacements, rowCount)){
        scratch.gridColWidths.clear();
        scratch.gridRowHeights.clear();
        outExtentX = 0.0;
        outExtentY = 0.0;
        return false;
    }
    return ResolveLayoutGridTracksFromPlacementsF64(
        nodes,
        boxes,
        index,
        hasAvailW,
        availW,
        hasAvailH,
        availH,
        Span<LayoutGridCellPlacement>(scratch.gridPlacements),
        rowCount,
        scratch.gridColWeights,
        scratch.gridRowWeights,
        scratch.gridTrackFrozen,
        scratch.gridColWidths,
        scratch.gridRowHeights,
        outExtentX,
        outExtentY
    );
}

Expected<Point> MeasureLayoutTreeNode(in Span<LayoutTreeNode> nodes, in Span<LayoutBox> boxes, in u32 index, mut LayoutScratch scratch, mut Point outContentSize){
    in LayoutTreeNode node = nodes[cast<usize>(index)];
    in LayoutNodeDesc description = node.description;
    f64 extentX = 0.0;
    f64 extentY = 0.0;
    if(node.firstChild != s_LayoutNoParent){
        u32 childCount = 0u;
        if(description.direction == LayoutDirection::Row || description.direction == LayoutDirection::Column){
            const b8 isRow = description.direction == LayoutDirection::Row;
            f64 wrapLimit = 0.0;
            b8 useWrap = false;
            if(description.flexWrap){
                LayoutSize mainPolicy = description.height;
                f32 mainMax = description.maxHeight;
                f32 padStart = description.padding.top;
                f32 padEnd = description.padding.bottom;
                if(isRow){
                    mainPolicy = description.width;
                    mainMax = description.maxWidth;
                    padStart = description.padding.left;
                    padEnd = description.padding.right;
                }
                if(mainPolicy.policy == LayoutSizePolicy::Fixed){
                    wrapLimit = Max(0.0, cast<f64>(mainPolicy.value) - cast<f64>(padStart) - cast<f64>(padEnd));
                    useWrap = true;
                }
                else if(mainMax > 0.0f){
                    wrapLimit = Max(0.0, cast<f64>(mainMax) - cast<f64>(padStart) - cast<f64>(padEnd));
                    useWrap = true;
                }
            }
            if(useWrap){
                if(!MeasureLayoutWrappedNodeF64(nodes, boxes, index, wrapLimit, extentX, extentY))
                    return MakeUnexpected(Failure());
            }
            else{
                for(u32 child = node.firstChild; child != s_LayoutNoParent; child = nodes[cast<usize>(child)].nextSibling){
                    in LayoutNodeDesc childDesc = nodes[cast<usize>(child)].description;
                    if(childDesc.positionMode == LayoutPositionMode::Absolute)
                        continue;
                    const VectorDouble outer = ComputeFlowChildOuterSizeF64(childDesc, boxes[cast<usize>(child)].measuredSize);
                    if(isRow){
                        extentX += outer.x;
                        extentY = Max(extentY, outer.y);
                    }
                    else{
                        extentX = Max(extentX, outer.x);
                        extentY += outer.y;
                    }
                    ++childCount;
                }
                if(childCount > 1u){
                    const f64 gapTotal = cast<f64>(description.gap) * cast<f64>(childCount - 1u);
                    if(isRow)
                        extentX += gapTotal;
                    else
                        extentY += gapTotal;
                }
            }
        }
        else if(description.direction == LayoutDirection::Grid){
            b8 hasAvailW = false;
            f64 availW = 0.0;
            if(description.width.policy == LayoutSizePolicy::Fixed){
                hasAvailW = true;
                availW = Max(0.0, cast<f64>(description.width.value) - cast<f64>(description.padding.left) - cast<f64>(description.padding.right));
            }
            else if(description.maxWidth > 0.0f){
                hasAvailW = true;
                availW = Max(0.0, cast<f64>(description.maxWidth) - cast<f64>(description.padding.left) - cast<f64>(description.padding.right));
            }
            b8 hasAvailH = false;
            f64 availH = 0.0;
            if(description.height.policy == LayoutSizePolicy::Fixed){
                hasAvailH = true;
                availH = Max(0.0, cast<f64>(description.height.value) - cast<f64>(description.padding.top) - cast<f64>(description.padding.bottom));
            }
            else if(description.maxHeight > 0.0f){
                hasAvailH = true;
                availH = Max(0.0, cast<f64>(description.maxHeight) - cast<f64>(description.padding.top) - cast<f64>(description.padding.bottom));
            }
            if(!MeasureLayoutGridTracksF64(nodes, boxes, index, hasAvailW, availW, hasAvailH, availH, scratch, extentX, extentY))
                return MakeUnexpected(Failure());
        }
        else{
            VectorDouble extentVec(extentX, extentY, 0.0, 0.0);
            for(u32 child = node.firstChild; child != s_LayoutNoParent; child = nodes[cast<usize>(child)].nextSibling){
                in LayoutNodeDesc childDesc = nodes[cast<usize>(child)].description;
                if(childDesc.positionMode == LayoutPositionMode::Absolute)
                    continue;
                const VectorDouble outer = ComputeFlowChildOuterSizeF64(childDesc, boxes[cast<usize>(child)].measuredSize);
                extentVec = VectorDoubleSelect(extentVec, outer, VectorDoubleGreater(outer, extentVec));
            }
            extentX = extentVec.x;
            extentY = extentVec.y;
        }
    }
    const VectorDouble intrinsic(cast<f64>(description.intrinsicSize.x), cast<f64>(description.intrinsicSize.y), 0.0, 0.0);
    const VectorDouble extent(extentX, extentY, 0.0, 0.0);
    const VectorDouble baseExtent = VectorDoubleSelect(extent, intrinsic, VectorDoubleGreater(intrinsic, extent));
    const VectorDouble leadingPad(cast<f64>(description.padding.left), cast<f64>(description.padding.top), 0.0, 0.0);
    const VectorDouble trailingPad(cast<f64>(description.padding.right), cast<f64>(description.padding.bottom), 0.0, 0.0);
    const VectorDouble size = (baseExtent + leadingPad) + trailingPad;
    const f64 width = size.x;
    const f64 height = size.y;
    if(width > s_UiMaxFloatF64 || height > s_UiMaxFloatF64)
        return MakeUnexpected(Failure());
    outContentSize = Point(cast<f32>(baseExtent.x), cast<f32>(baseExtent.y));
    f64 rawWidth = width;
    if(description.width.policy == LayoutSizePolicy::Fixed)
        rawWidth = cast<f64>(description.width.value);
    f64 rawHeight = height;
    if(description.height.policy == LayoutSizePolicy::Fixed)
        rawHeight = cast<f64>(description.height.value);
    const VectorDouble constrained = ResolveLayoutConstrainedSizeF64(
        description,
        rawWidth,
        rawHeight,
        description.width.policy == LayoutSizePolicy::Fixed,
        description.height.policy == LayoutSizePolicy::Fixed
    );
    if(constrained.x > s_UiMaxFloatF64 || constrained.y > s_UiMaxFloatF64)
        return MakeUnexpected(Failure());
    return Point(cast<f32>(constrained.x), cast<f32>(constrained.y));
}

Expected<u32> TryAppendLayoutTreeNode(
    mut Vector<LayoutTreeNode> nodes,
    in u32 maxNodes,
    in b8 buildFailed,
    in u32 parent,
    in LayoutNodeDesc description
){
    if(!CanAddLayoutTreeNode(nodes, maxNodes, buildFailed, parent, description))
        return MakeUnexpected(Failure());
    const u32 index = cast<u32>(nodes.size());
    nodes.push_back(LayoutTreeNode(description));
    if(parent != s_LayoutNoParent){
        const u32 previousLastChild = nodes[cast<usize>(parent)].lastChild;
        if(previousLastChild == s_LayoutNoParent)
            nodes[cast<usize>(parent)].firstChild = index;
        else
            nodes[cast<usize>(previousLastChild)].nextSibling = index;
        nodes[cast<usize>(parent)].lastChild = index;
    }
    return index;
}

b8 MeasureLayoutTreeNodes(in Span<LayoutTreeNode> nodes, mut LayoutScratch scratch, mut Vector<LayoutBox> boxes){
    const Span<LayoutBox> boxSpan = Span<LayoutBox>(boxes);
    for(usize reverse = nodes.size(); reverse > 0u; --reverse){
        const u32 index = cast<u32>(reverse - 1u);
        Point contentSize;
        const Expected<Point> measuredSize = MeasureLayoutTreeNode(nodes, boxSpan, index, scratch, contentSize);
        if(!measuredSize.has_value())
            return false;
        boxes[cast<usize>(index)].measuredSize = measuredSize.value();
        boxes[cast<usize>(index)].contentSize = contentSize;
    }
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

