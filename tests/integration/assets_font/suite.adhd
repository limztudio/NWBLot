const u32 s_CollectionSignature = 0x74746366u;

// SFNT directory holds a big-endian u16 table count at byte 4 followed by 16-byte table records.
const usize s_SfntTableCountHighByte = 4u;
const usize s_SfntTableCountLowByte = 5u;
const usize s_SfntTableRecordBytes = 16u;
const usize s_SfntRecordOffsetField = 8u;
const usize s_SfntRecordLengthField = 12u;
const usize s_OneTableDirectoryBytes = s_FontSfntHeaderBytes + s_SfntTableRecordBytes;
const usize s_FirstRecordOffsetField = s_FontSfntHeaderBytes + s_SfntRecordOffsetField;
const usize s_FirstRecordLengthField = s_FontSfntHeaderBytes + s_SfntRecordLengthField;
const usize s_SecondRecordOffsetField = s_OneTableDirectoryBytes + s_SfntRecordOffsetField;
const usize s_SecondRecordLengthField = s_OneTableDirectoryBytes + s_SfntRecordLengthField;

// The big-endian u16 unitsPerEm field of the 'head' table.
const usize s_HeadUnitsPerEmOffset = 18u;
const usize s_HeadUnitsPerEmEnd = 20u;

const usize s_HeaderBytes = 56u;
const usize s_GroupHeaderBytes = 48u;
const usize s_GroupCount = 4u;
const usize s_FontBytes = 7u;
const usize s_FontOffset = s_HeaderBytes + s_GroupCount * s_GroupHeaderBytes;
const usize s_PixelOffset = s_FontOffset + s_FontBytes;
const usize s_GroupHeightField = 4u;
const usize s_GroupChannelsField = 8u;
const usize s_GroupImageBytesField = 12u;
const u32 s_MaxImageSide = 2048u;
const u32 s_MaxChannelCount = 4u;

class MalformedField{
    public StringView m_filename;
    public usize m_offset;
    public u32 m_value;
    public b8 m_rejectsBeforeDirectoryAllocation;

    public MalformedField(in StringView filename, in usize offset, in u32 value, in b8 rejectsBeforeDirectoryAllocation){
        this.m_filename = filename;
        this.m_offset = offset;
        this.m_value = value;
        this.m_rejectsBeforeDirectoryAllocation = rejectsBeforeDirectoryAllocation;
    }
};

class CutCase{
    public StringView m_filename;
    public usize m_byteCount;

    public CutCase(in StringView filename, in usize byteCount){
        this.m_filename = filename;
        this.m_byteCount = byteCount;
    }
};

void WriteBigU32At(mut AssetBytes bytes, in usize offset, in u32 value){
    bytes[offset] = cast<u8>(value >> 24u);
    bytes[offset + 1u] = cast<u8>(value >> 16u);
    bytes[offset + 2u] = cast<u8>(value >> 8u);
    bytes[offset + 3u] = cast<u8>(value);
}

u32 ReadBigU32At(in AssetBytes bytes, in usize offset){
    return (cast<u32>(bytes[offset]) << 24u)
        | (cast<u32>(bytes[offset + 1u]) << 16u)
        | (cast<u32>(bytes[offset + 2u]) << 8u)
        | cast<u32>(bytes[offset + 3u]);
}

void WriteLittleU32At(mut AssetBytes bytes, in usize offset, in u32 value){
    bytes[offset] = cast<u8>(value);
    bytes[offset + 1u] = cast<u8>(value >> 8u);
    bytes[offset + 2u] = cast<u8>(value >> 16u);
    bytes[offset + 3u] = cast<u8>(value >> 24u);
}

usize FindTableRecord(in AssetBytes bytes, in u32 tag){
    const u32 tableCount = (cast<u32>(bytes[s_SfntTableCountHighByte]) << 8u) | cast<u32>(bytes[s_SfntTableCountLowByte]);
    for(u32 index = 0u; index < tableCount; ++index){
        const usize record = s_FontSfntHeaderBytes + cast<usize>(index) * s_SfntTableRecordBytes;
        if(ReadBigU32At(bytes, record) == tag)
            return record;
    }
    return 0u;
}

AssetBytes CopyAssetBytes(in AssetBytes source, mut AssetArena arena){
    AssetBytes copy(arena);
    copy.resize(source.size());
    for(usize index = 0u; index < source.size(); ++index)
        copy[index] = source[index];
    return copy;
}

b8 LoadLatin(mut FontTestArena testArena, mut Font outFont){
    b8 ok = false;
    native(mut testArena, mut outFont, mut ok){
        const Path path = DefaultBundledFontRoot(testArena) / "latin.font";
        Core::Assets::AssetBytes source(testArena.arena);
        Font candidate(testArena.arena, Name(s_FontCaseEngineUiFontsDefaultLatinFace));
        auto sourceResult = ReadBundledFontBytes(path, source.get_allocator().arena());
        if(!sourceResult)
            return false;
        source = Move(*sourceResult);
        candidate.setFontBytes(Move(source));
        if(!candidate.validatePayload())
            return false;
        outFont = Move(candidate);
        ok = true;
    }
    return ok;
}

AssetBytes MakeBinary(in FontBinaryHeader header, in AssetBytes source, mut FontTestArena testArena){
    AssetBytes binary(testArena.arena);
    native(in header, in source, mut binary){
        binary.reserve(sizeof(header) + source.size());
        AppendPOD(binary, header);
        binary.insert(binary.end(), source.begin(), source.end());
    }
    return binary;
}

b8 SerializeFixtureSource(in SourceFixture fixture, mut AssetArena arena, mut AssetBytes outBinary){
    b8 ok = false;
    native(in fixture, mut arena, mut outBinary, mut ok){
        auto result = SerializePreparedFontSource({ fixture.sfnt.data(), fixture.sfnt.size() }, 0u, fixture.views, arena);
        if(!result)
            return false;
        outBinary = Move(*result);
        ok = true;
    }
    return ok;
}

b8 WriteCase(in StringView filename, in AssetBytes binary, mut SourceTestArena testArena, mut Path outPath){
    b8 ok = false;
    native(in filename, in binary, mut testArena, mut outPath, mut ok){
        Path candidate = Path(testArena.arena, NWB_REPO_ROOT) / "__artifacts" / "font_source_tests" / filename;
        if(!EnsureDirectories(candidate.parentPath()) || !WriteBinaryFile(candidate, binary))
            return false;
        outPath = Move(candidate);
        ok = true;
    }
    return ok;
}

b8 ReadPreparedInto(in Path path, in b8 includePixels, mut AssetArena arena, mut PreparedFontSource outSource){
    b8 ok = false;
    native(in path, in includePixels, mut arena, mut outSource, mut ok){
        auto result = ReadPreparedFontSource(path, includePixels, arena);
        if(!result)
            return false;
        outSource = Move(*result);
        ok = true;
    }
    return ok;
}

b8 CanReadPrepared(in Path path, in b8 includePixels, mut AssetArena arena){
    b8 ok = false;
    native(in path, in includePixels, mut arena, mut ok){
        ok = ReadPreparedFontSource(path, includePixels, arena).has_value();
    }
    return ok;
}

void VerifyAssetsFont_SfntDirectoryRejectsTruncatedRecordsAndUnsupportedTableCounts(){
    FontTestArena testArena = FontTestArena();
    AssetBytes bytes(testArena.arena);
    bytes.resize(s_OneTableDirectoryBytes, 0u);
    WriteBigU32At(bytes, 0u, s_TrueTypeSignature);
    bytes[s_SfntTableCountLowByte] = 1u;
    for(usize size = 0u; size < bytes.size(); ++size){
        const ScopedTestTrace trace(size);
        b8 accepted = true;
        native(in bytes, in size, mut accepted){
            accepted = ReadFontSfntDirectory({ bytes.data(), size }).has_value();
        }
        EXPECT_FALSE(accepted);
    }
    native(mut bytes){
        ASSERT_TRUE(ReadFontSfntDirectory({ bytes.data(), bytes.size() }));
        bytes[s_SfntTableCountLowByte] = 0u;
        EXPECT_FALSE(ReadFontSfntDirectory({ bytes.data(), bytes.size() }));
        bytes[s_SfntTableCountHighByte] = 1u;
        bytes[s_SfntTableCountLowByte] = 1u;
        EXPECT_FALSE(ReadFontSfntDirectory({ bytes.data(), bytes.size() }));
        bytes[s_SfntTableCountLowByte] = 0u;
        EXPECT_FALSE(ReadFontSfntDirectory({ bytes.data(), bytes.size() }));
        Array<u8, s_FontSfntHeaderBytes + s_FontMaxTableCount * s_SfntTableRecordBytes> maximumDirectory = {};
        maximumDirectory[s_SfntTableCountHighByte] = 1u;
        const Expected<FontSfntDirectory> maximumResult = ReadFontSfntDirectory({ maximumDirectory.data(), maximumDirectory.size() });
        ASSERT_TRUE(maximumResult);
        EXPECT_EQ(maximumResult->tableCount(), s_FontMaxTableCount);
    }
}

void VerifyAssetsFont_SfntTableViewsCheckBoundsWithoutCopyingOrScanningOtherRecords(){
    // Two records, then the first table's data right after the directory.
    const u32 tableDataOffset = 44u;
    const u32 tableDataBytes = 4u;
    FontTestArena testArena = FontTestArena();
    AssetBytes bytes(testArena.arena);
    bytes.resize(tableDataOffset + tableDataBytes, 0u);
    WriteBigU32At(bytes, 0u, s_TrueTypeSignature);
    bytes[s_SfntTableCountLowByte] = 2u;
    WriteBigU32At(bytes, s_FontSfntHeaderBytes, s_FontSfntHeadTag);
    WriteBigU32At(bytes, s_FirstRecordOffsetField, tableDataOffset);
    WriteBigU32At(bytes, s_FirstRecordLengthField, tableDataBytes);
    WriteBigU32At(bytes, s_OneTableDirectoryBytes, s_FontSfntMaxpTag);
    WriteBigU32At(bytes, s_SecondRecordOffsetField, u32.max);
    WriteBigU32At(bytes, s_SecondRecordLengthField, 2u);
    WriteBigU32At(bytes, tableDataOffset, 0x12345678u);

    native(in bytes, in tableDataOffset, in tableDataBytes){
        const Expected<FontSfntDirectory> directory = ReadFontSfntDirectory({ bytes.data(), bytes.size() });
        ASSERT_TRUE(directory);
        EXPECT_EQ(directory->signature(), s_TrueTypeSignature);
        EXPECT_EQ(directory->directoryBytes(), tableDataOffset);
        EXPECT_EQ(directory->tableCount(), 2u);
        const Expected<FontSfntTable> tableResult = directory->table(0u);
        ASSERT_TRUE(tableResult);
        EXPECT_EQ(tableResult->tag, s_FontSfntHeadTag);
        EXPECT_EQ(tableResult->offset, tableDataOffset);
        EXPECT_EQ(tableResult->bytes.data(), bytes.data() + tableDataOffset);
        EXPECT_EQ(tableResult->bytes.size(), tableDataBytes);
        const auto valueResult = ReadU16BigEndian(BinaryByteView{ tableResult->bytes.data(), tableResult->bytes.size() }, 0u);
        ASSERT_TRUE(valueResult);
        EXPECT_EQ(*valueResult, 0x1234u);
        EXPECT_FALSE(directory->table(1u));
        const Expected<u32> secondTagResult = directory->tableTag(1u);
        ASSERT_TRUE(secondTagResult);
        EXPECT_EQ(*secondTagResult, s_FontSfntMaxpTag);
        EXPECT_FALSE(directory->table(2u));
        EXPECT_FALSE(directory->tableTag(Limit<usize>::s_Max));
        EXPECT_FALSE(ReadU16BigEndian(BinaryByteView{ tableResult->bytes.data(), tableResult->bytes.size() }, 3u));
        EXPECT_FALSE(ReadU16BigEndian(BinaryByteView{ tableResult->bytes.data(), tableResult->bytes.size() }, Limit<usize>::s_Max));
    }
}

void VerifyAssetsFont_SfntTableBoundsHandleOverflowAndEmptyEndSpansWithoutAddingFontPolicy(){
    FontTestArena testArena = FontTestArena();
    AssetBytes bytes(testArena.arena);
    bytes.resize(32u, 0u);
    // Signature admission remains with Font validation.
    WriteBigU32At(bytes, 0u, s_CollectionSignature);
    bytes[s_SfntTableCountLowByte] = 1u;
    WriteBigU32At(bytes, s_FontSfntHeaderBytes, s_FontSfntHeadTag);
    WriteBigU32At(bytes, s_FirstRecordOffsetField, cast<u32>(s_OneTableDirectoryBytes));
    WriteBigU32At(bytes, s_FirstRecordLengthField, u32.max);
    native(in bytes){
        const Expected<FontSfntDirectory> directoryResult = ReadFontSfntDirectory({ bytes.data(), bytes.size() });
        ASSERT_TRUE(directoryResult);
        EXPECT_EQ(directoryResult->signature(), s_CollectionSignature);
        EXPECT_FALSE(directoryResult->table(0u));
    }

    WriteBigU32At(bytes, s_FirstRecordLengthField, 5u);
    native(in bytes){
        const Expected<FontSfntDirectory> directoryResult = ReadFontSfntDirectory({ bytes.data(), bytes.size() });
        ASSERT_TRUE(directoryResult);
        EXPECT_FALSE(directoryResult->table(0u));
    }

    WriteBigU32At(bytes, s_FirstRecordOffsetField, cast<u32>(bytes.size()));
    WriteBigU32At(bytes, s_FirstRecordLengthField, 0u);
    native(in bytes){
        const Expected<FontSfntDirectory> directoryResult = ReadFontSfntDirectory({ bytes.data(), bytes.size() });
        ASSERT_TRUE(directoryResult);
        const Expected<FontSfntTable> emptyTableResult = directoryResult->table(0u);
        ASSERT_TRUE(emptyTableResult);
        EXPECT_TRUE(emptyTableResult->bytes.empty());
        EXPECT_EQ(emptyTableResult->bytes.data(), bytes.data() + bytes.size());
    }

    // Directory-overlap admission remains with Font validation.
    WriteBigU32At(bytes, s_FirstRecordOffsetField, 0u);
    WriteBigU32At(bytes, s_FirstRecordLengthField, 4u);
    native(in bytes){
        const Expected<FontSfntDirectory> directoryResult = ReadFontSfntDirectory({ bytes.data(), bytes.size() });
        ASSERT_TRUE(directoryResult);
        const Expected<FontSfntTable> tableResult = directoryResult->table(0u);
        ASSERT_TRUE(tableResult);
        EXPECT_EQ(tableResult->bytes.data(), bytes.data());
    }
}

void VerifyAssetsFont_PreparedAtlasPixelsAreExcludedFromCookedFontsAndRejectedByRuntimeImport(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    FontTestArena testArena = FontTestArena();
    const Path bundledRoot = DefaultBundledFontRoot(testArena);
    for(usize index = 0u; index < s_BundledFontFilenames.size(); ++index){
        Name fontName = s_FontCaseEngineUiFontsDefaultLatinFace;
        if(index == 1u)
            fontName = s_FontCaseEngineUiFontsDefaultKoreanFace;
        Font font(testArena.arena, fontName);
        AssetBytes source(testArena.arena);
        AssetBytes prepared(testArena.arena);
        b8 loadedBundled = false;
        b8 readRaw = false;
        native(in bundledRoot, in index, mut testArena, mut font, mut source, mut prepared, mut loadedBundled, mut readRaw){
            const Path bundledPath = bundledRoot / s_BundledFontFilenames[index];
            auto sourceResult = ReadBundledFontBytes(bundledPath, source.get_allocator().arena());
            if(sourceResult){
                source = Move(*sourceResult);
                AssetBytes sourceCopy(source.begin(), source.end(), testArena.arena);
                font.setFontBytes(Move(sourceCopy));
                loadedBundled = true;
            }
            readRaw = static_cast<b8>(ReadBinaryFile(bundledPath, prepared));
        }
        ASSERT_TRUE(loadedBundled);
        ASSERT_TRUE(font.validatePayload());
        ASSERT_TRUE(readRaw);

        FontAssetCodec codec = FontAssetCodec();
        AssetBytes binary(testArena.arena);
        ASSERT_TRUE(codec.serialize(font, binary));
        EXPECT_EQ(binary.size(), s_FontBinaryHeaderSize + source.size());
        EXPECT_LT(binary.size(), prepared.size());
        EXPECT_FALSE(font.loadBinary(prepared));
        EXPECT_EQ(font.fontBytes(), source);
    }
    EXPECT_EQ(logger.errorCount(), s_BundledFontFilenames.size());
}

void VerifyAssetsFont_MalformedBinaryPreservesThePreviouslyLoadedFont(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    FontTestArena testArena = FontTestArena();
    Font font(testArena.arena, s_FontCaseEngineUiFontsDefaultLatinFace);
    ASSERT_TRUE(LoadLatin(testArena, font));
    const AssetBytes original = CopyAssetBytes(font.fontBytes(), testArena.arena);
    FontBinaryHeader validHeader = FontBinaryHeader();
    validHeader.byteCount = original.size();
    for(u32 variant = 0u; variant < 7u; ++variant){
        const ScopedTestTrace trace(variant);
        FontBinaryHeader header = validHeader;
        switch(variant){
        case 0u: header.magic = 0u; break;
        case 1u: header.version = 2u; break;
        case 2u: header.faceIndex = 1u; break;
        case 3u: header.reserved = 1u; break;
        case 4u: header.byteCount = 0u; break;
        case 5u: header.byteCount -= 1u; break;
        case 6u: header.byteCount += 1u; break;
        default: break;
        }
        EXPECT_FALSE(font.loadBinary(MakeBinary(header, original, testArena)));
        EXPECT_EQ(font.fontBytes(), original);
        EXPECT_EQ(font.faceIndex(), 0u);
    }
    AssetBytes binary = MakeBinary(validHeader, original, testArena);
    binary.resize(s_FontBinaryHeaderSize - 1u);
    EXPECT_FALSE(font.loadBinary(binary));
    binary = MakeBinary(validHeader, original, testArena);
    binary.push_back(0u);
    EXPECT_FALSE(font.loadBinary(binary));
    binary = MakeBinary(validHeader, original, testArena);
    binary.pop_back();
    EXPECT_FALSE(font.loadBinary(binary));
    EXPECT_EQ(font.fontBytes(), original);
}

void VerifyAssetsFont_OversizedCountIsRejectedBeforeSourceAllocation(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    FontTestArena testArena = FontTestArena();
    FontBinaryHeader header = FontBinaryHeader();
    header.byteCount = cast<u64>(s_FontMaxSourceBytes) + 1u;
    AssetBytes binary(testArena.arena);
    native(in header, mut binary){
        AppendPOD(binary, header);
    }
    Font font(testArena.arena, s_FontCaseProjectFontsTest);
    EXPECT_FALSE(font.loadBinary(binary));
    EXPECT_TRUE(font.fontBytes().empty());
    EXPECT_TRUE(logger.sawErrorContaining(s_ErrSourceSizeRange));
    header.byteCount = u64.max;
    binary.clear();
    native(in header, mut binary){
        AppendPOD(binary, header);
    }
    EXPECT_FALSE(font.loadBinary(binary));
    EXPECT_TRUE(font.fontBytes().empty());
}

void VerifyAssetsFont_RejectsCollectionsCompressedFontsAndVariableTables(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    FontTestArena testArena = FontTestArena();
    Font font(testArena.arena, s_FontCaseEngineUiFontsDefaultLatinFace);
    ASSERT_TRUE(LoadLatin(testArena, font));
    for(usize index = 0u; index < s_UnsupportedSignatures.size(); ++index){
        AssetBytes bytes = CopyAssetBytes(font.fontBytes(), testArena.arena);
        WriteBigU32At(bytes, 0u, s_UnsupportedSignatures[index]);
        EXPECT_FALSE(ValidateFontSource(bytes, 0u));
    }
    for(usize index = 0u; index < s_VariableTags.size(); ++index){
        AssetBytes bytes = CopyAssetBytes(font.fontBytes(), testArena.arena);
        WriteBigU32At(bytes, s_FontSfntHeaderBytes, s_VariableTags[index]);
        EXPECT_FALSE(ValidateFontSource(bytes, 0u));
    }
    EXPECT_FALSE(ValidateFontSource(font.fontBytes(), 1u));
}

void VerifyAssetsFont_RejectsMalformedDirectoriesAndNativeFaceMetrics(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    FontTestArena testArena = FontTestArena();
    Font font(testArena.arena, s_FontCaseEngineUiFontsDefaultLatinFace);
    ASSERT_TRUE(LoadLatin(testArena, font));
    for(u32 variant = 0u; variant < 7u; ++variant){
        const ScopedTestTrace trace(variant);
        AssetBytes bytes = CopyAssetBytes(font.fontBytes(), testArena.arena);
        switch(variant){
        case 0u:
            bytes[s_SfntTableCountHighByte] = 0u;
            bytes[s_SfntTableCountLowByte] = 0u;
            break;
        case 1u:
            bytes[s_SfntTableCountHighByte] = 1u;
            bytes[s_SfntTableCountLowByte] = 1u;
            break;
        case 2u:
            WriteBigU32At(bytes, s_FirstRecordOffsetField, u32.max);
            break;
        case 3u:
            WriteBigU32At(bytes, s_FirstRecordLengthField, u32.max);
            break;
        case 4u:
            WriteBigU32At(bytes, s_OneTableDirectoryBytes, ReadBigU32At(bytes, s_FontSfntHeaderBytes));
            break;
        case 5u: {
            const usize head = FindTableRecord(bytes, s_FontSfntHeadTag);
            ASSERT_NE(head, 0u);
            WriteBigU32At(bytes, head, 0x62616421u);
            break;
        }
        case 6u: {
            const usize head = FindTableRecord(bytes, s_FontSfntHeadTag);
            ASSERT_NE(head, 0u);
            const u32 offset = ReadBigU32At(bytes, head + s_SfntRecordOffsetField);
            bytes[offset + s_HeadUnitsPerEmOffset] = 0u;
            bytes[offset + s_HeadUnitsPerEmOffset + 1u] = 0u;
            break;
        }
        default:
            break;
        }
        EXPECT_FALSE(ValidateFontSource(bytes, 0u));
    }
}

void VerifyAssetsFont_NativeFaceFailurePreservesErrorCodeAndReclaimsValidationAllocations(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    FontTestArena testArena = FontTestArena();
    Font font(testArena.arena, s_FontCaseEngineUiFontsDefaultLatinFace);
    ASSERT_TRUE(LoadLatin(testArena, font));
    AssetBytes bytes = CopyAssetBytes(font.fontBytes(), testArena.arena);
    const usize head = FindTableRecord(bytes, s_FontSfntHeadTag);
    ASSERT_NE(head, 0u);
    const u32 offset = ReadBigU32At(bytes, head + s_SfntRecordOffsetField);
    ASSERT_LE(cast<usize>(offset) + s_HeadUnitsPerEmEnd, bytes.size());
    bytes[offset + s_HeadUnitsPerEmOffset] = 0u;
    bytes[offset + s_HeadUnitsPerEmOffset + 1u] = 0u;

    i64 expectedNativeError = 0;
    native(in bytes, mut expectedNativeError){
        FT_Library library = nullptr;
        ASSERT_EQ(FT_Init_FreeType(&library), 0);
        FT_Face nativeFace = nullptr;
        const FT_Error nativeError = FT_New_Memory_Face(library, bytes.data(), static_cast<FT_Long>(bytes.size()), 0, &nativeFace);
        const FT_Error faceClosed = nativeFace ? FT_Done_Face(nativeFace) : 0;
        const FT_Error libraryClosed = FT_Done_FreeType(library);
        ASSERT_EQ(faceClosed, 0);
        ASSERT_EQ(libraryClosed, 0);
        ASSERT_NE(nativeError, 0);
        expectedNativeError = nativeError;
    }

    const u64 baselineUsedBytes = testArena.arena.memoryStats().usedBytes;
    EXPECT_FALSE(ValidateFontSource(bytes, 0u));
    EXPECT_EQ(testArena.arena.memoryStats().usedBytes, baselineUsedBytes);
    EXPECT_TRUE(logger.sawErrorContaining(s_ErrFtNewMemoryFace));
    native(in logger, in expectedNativeError){
        constexpr usize s_ExpectedCodeCapacity = 64u;
        Array<char, s_ExpectedCodeCapacity> expectedCode = {};
        CopyFixedBuffer(expectedCode, "native_code=");
        if(expectedNativeError < 0)
            AppendFixedBuffer(expectedCode, "-");
        AppendUnsignedToFixedBuffer(expectedCode, static_cast<u64>(expectedNativeError < 0 ? -expectedNativeError : expectedNativeError));
        Core::Alloc::ScratchArena scratchArena(s_OneOffNameTestsAssetsFontNativeValidationDiagnostic);
        const auto expectedDiagnostic = ConvertString(scratchArena, FixedBufferView(expectedCode));
        EXPECT_TRUE(logger.sawErrorContaining(expectedDiagnostic));
    }
    EXPECT_EQ(logger.errorCount(), 1u);
    EXPECT_TRUE(ValidateFontSource(font.fontBytes(), 0u));
    EXPECT_EQ(testArena.arena.memoryStats().usedBytes, baselineUsedBytes);
}

void VerifyPreparedFontSource_ImageCorruptionRejectsFullReadWhileFontOnlySkipsCompactPlanes(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    SourceTestArena testArena = SourceTestArena();
    SourceFixture fixture(testArena.arena);
    AssetBytes binary(testArena.arena);
    ASSERT_TRUE(SerializeFixtureSource(fixture, testArena.arena, binary));
    ASSERT_EQ(binary.size(), s_PixelOffset + 150u);
    Path path(testArena.arena);
    ASSERT_TRUE(WriteCase("image_integrity_control.font", binary, testArena, path));
    PreparedFontSource original(testArena.arena);
    ASSERT_TRUE(ReadPreparedInto(path, true, testArena.arena, original));
    ASSERT_EQ(original.groups.size(), s_GroupCount);

    usize imageOffset = s_PixelOffset;
    for(usize index = 0u; index < s_CorruptImageFilenames.size(); ++index){
        const ScopedTestTrace trace(index);
        AssetBytes corrupted = CopyAssetBytes(binary, testArena.arena);
        usize corruptionOffset = s_HeaderBytes + 16u;
        if(index < s_GroupCount)
            corruptionOffset = imageOffset;
        corrupted[corruptionOffset] ^= 0x80u;
        ASSERT_TRUE(WriteCase(s_CorruptImageFilenames[index], corrupted, testArena, path));
        EXPECT_FALSE(CanReadPrepared(path, true, testArena.arena));
        PreparedFontSource fontOnly(testArena.arena);
        ASSERT_TRUE(ReadPreparedInto(path, false, testArena.arena, fontOnly));
        EXPECT_EQ(fontOnly.fontBytes, original.fontBytes);
        EXPECT_TRUE(fontOnly.fontSha256 == original.fontSha256);
        ASSERT_EQ(fontOnly.groups.size(), s_GroupCount);
        for(usize group = 0u; group < s_GroupCount; ++group){
            EXPECT_TRUE(fontOnly.groups[group].pixels.empty());
            EXPECT_EQ(fontOnly.groups[group].width, 3u);
            EXPECT_EQ(fontOnly.groups[group].height, 5u);
            EXPECT_EQ(fontOnly.groups[group].channelCount, group + 1u);
        }
        if(index < s_GroupCount)
            imageOffset += fixture.groups[index].pixels.size();
    }
    EXPECT_EQ(logger.errorCount(), s_CorruptImageFilenames.size());
    EXPECT_TRUE(logger.sawErrorContaining(s_ErrImageHashDiffers));
}

void VerifyPreparedFontSource_SfntByteAndDigestCorruptionRejectBothReadModes(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    SourceTestArena testArena = SourceTestArena();
    SourceFixture fixture(testArena.arena);
    AssetBytes binary(testArena.arena);
    ASSERT_TRUE(SerializeFixtureSource(fixture, testArena.arena, binary));
    Path path(testArena.arena);
    ASSERT_TRUE(WriteCase("font_integrity_control.font", binary, testArena, path));
    ASSERT_TRUE(CanReadPrepared(path, true, testArena.arena));
    for(usize index = 0u; index < s_CorruptSfntFilenames.size(); ++index){
        usize offset = s_FontOffset;
        if(index == 1u)
            offset = 24u;
        AssetBytes corrupted = CopyAssetBytes(binary, testArena.arena);
        corrupted[offset] ^= 0x40u;
        ASSERT_TRUE(WriteCase(s_CorruptSfntFilenames[index], corrupted, testArena, path));
        EXPECT_FALSE(CanReadPrepared(path, false, testArena.arena));
        EXPECT_FALSE(CanReadPrepared(path, true, testArena.arena));
    }
    EXPECT_EQ(logger.errorCount(), 4u);
    EXPECT_TRUE(logger.sawErrorContaining(s_ErrSfntHashDiffers));
}

void CheckMalformedPreparedField(in MalformedField field, in AssetBytes binary, mut SourceTestArena testArena, mut GlobalArena outputArena){
    const ScopedTestTrace trace(field.m_filename);
    AssetBytes malformed = CopyAssetBytes(binary, testArena.arena);
    WriteLittleU32At(malformed, field.m_offset, field.m_value);
    Path path(testArena.arena);
    ASSERT_TRUE(WriteCase(field.m_filename, malformed, testArena, path));
    for(u32 mode = 0u; mode < 2u; ++mode){
        const b8 includePixels = mode == 1u;
        const ArenaMemoryStats before = outputArena.memoryStats();
        EXPECT_FALSE(CanReadPrepared(path, includePixels, outputArena));
        const ArenaMemoryStats after = outputArena.memoryStats();
        EXPECT_EQ(after.usedBytes, before.usedBytes);
        EXPECT_LE(after.peakUsedBytes, before.usedBytes + 8u * s_PreparedGroupSize);
        if(field.m_rejectsBeforeDirectoryAllocation)
            EXPECT_EQ(after.allocationCount, before.allocationCount);
    }
}

void VerifyPreparedFontSource_MalformedDirectoryCountsAndOverflowRejectBeforePayloadAllocation(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    SourceTestArena testArena = SourceTestArena();
    GlobalArena outputArena(s_FontCaseTestsIntegrationAssetsFontPreparedOutput);
    SourceFixture fixture(testArena.arena);
    AssetBytes binary(testArena.arena);
    ASSERT_TRUE(SerializeFixtureSource(fixture, testArena.arena, binary));
    Path path(testArena.arena);
    ASSERT_TRUE(WriteCase("directory_control.font", binary, testArena, path));
    ASSERT_TRUE(CanReadPrepared(path, true, outputArena));

    Vector<MalformedField> fields = Vector<MalformedField>();
    fields.reserve(27u);
    fields.push_back(MalformedField("magic.font", 0u, 0u, true));
    fields.push_back(MalformedField("retired_fon1.font", 0u, 0x464f4e31u, true));
    fields.push_back(MalformedField("old_version.font", 4u, 0u, true));
    fields.push_back(MalformedField("future_version.font", 4u, 2u, true));
    fields.push_back(MalformedField("face_index.font", 8u, 1u, true));
    fields.push_back(MalformedField("reserved.font", 20u, 1u, true));
    fields.push_back(MalformedField("font_zero.font", 12u, 0u, true));
    fields.push_back(MalformedField("font_limit.font", 12u, s_FontMaxSourceBytes + 1u, true));
    fields.push_back(MalformedField("font_overflow.font", 12u, u32.max, true));
    fields.push_back(MalformedField("font_length.font", 12u, cast<u32>(s_FontBytes + 1u), false));
    fields.push_back(MalformedField("groups_zero.font", 16u, 0u, true));
    fields.push_back(MalformedField("groups_limit.font", 16u, 9u, true));
    fields.push_back(MalformedField("groups_overflow.font", 16u, u32.max, true));
    fields.push_back(MalformedField("missing_group_header.font", 16u, 5u, false));
    fields.push_back(MalformedField("width_zero.font", s_HeaderBytes, 0u, false));
    fields.push_back(MalformedField("width_limit.font", s_HeaderBytes, s_MaxImageSide + 1u, false));
    fields.push_back(MalformedField("width_overflow.font", s_HeaderBytes, u32.max, false));
    fields.push_back(MalformedField("height_zero.font", s_HeaderBytes + s_GroupHeightField, 0u, false));
    fields.push_back(MalformedField("height_limit.font", s_HeaderBytes + s_GroupHeightField, s_MaxImageSide + 1u, false));
    fields.push_back(MalformedField("height_overflow.font", s_HeaderBytes + s_GroupHeightField, u32.max, false));
    fields.push_back(MalformedField("channels_zero.font", s_HeaderBytes + s_GroupChannelsField, 0u, false));
    fields.push_back(MalformedField("channels_limit.font", s_HeaderBytes + s_GroupChannelsField, s_MaxChannelCount + 1u, false));
    fields.push_back(MalformedField("channels_overflow.font", s_HeaderBytes + s_GroupChannelsField, u32.max, false));
    fields.push_back(MalformedField("image_bytes_zero.font", s_HeaderBytes + s_GroupImageBytesField, 0u, false));
    fields.push_back(MalformedField("image_bytes_short.font", s_HeaderBytes + s_GroupImageBytesField, 14u, false));
    fields.push_back(MalformedField("image_bytes_long.font", s_HeaderBytes + s_GroupImageBytesField, 16u, false));
    fields.push_back(MalformedField("image_bytes_overflow.font", s_HeaderBytes + s_GroupImageBytesField, u32.max, false));

    for(usize index = 0u; index < fields.size(); ++index)
        CheckMalformedPreparedField(fields[index], binary, testArena, outputArena);

    // Valid maximum dimensions still require their full payload length before any SFNT/image allocation.
    AssetBytes oversized = CopyAssetBytes(binary, testArena.arena);
    WriteLittleU32At(oversized, s_HeaderBytes, s_MaxImageSide);
    WriteLittleU32At(oversized, s_HeaderBytes + s_GroupHeightField, s_MaxImageSide);
    WriteLittleU32At(oversized, s_HeaderBytes + s_GroupChannelsField, s_MaxChannelCount);
    WriteLittleU32At(oversized, s_HeaderBytes + s_GroupImageBytesField, s_MaxImageSide * s_MaxImageSide * s_MaxChannelCount);
    ASSERT_TRUE(WriteCase("missing_large_image.font", oversized, testArena, path));
    for(u32 mode = 0u; mode < 2u; ++mode){
        const b8 includePixels = mode == 1u;
        const ArenaMemoryStats before = outputArena.memoryStats();
        EXPECT_FALSE(CanReadPrepared(path, includePixels, outputArena));
        EXPECT_LE(outputArena.memoryStats().peakUsedBytes, before.usedBytes + 8u * s_PreparedGroupSize);
    }
    EXPECT_EQ(logger.errorCount(), 2u * (fields.size() + 1u));
}

void VerifyPreparedFontSource_TruncatedSectionsAndTrailingBytesRejectBothReadModes(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    SourceTestArena testArena = SourceTestArena();
    SourceFixture fixture(testArena.arena);
    AssetBytes binary(testArena.arena);
    ASSERT_TRUE(SerializeFixtureSource(fixture, testArena.arena, binary));
    Path path(testArena.arena);
    ASSERT_TRUE(WriteCase("length_control.font", binary, testArena, path));
    ASSERT_TRUE(CanReadPrepared(path, true, testArena.arena));

    Vector<CutCase> cuts = Vector<CutCase>();
    cuts.reserve(7u);
    cuts.push_back(CutCase("short_header.font", s_HeaderBytes - 1u));
    cuts.push_back(CutCase("missing_directory.font", s_HeaderBytes));
    cuts.push_back(CutCase("short_directory.font", s_FontOffset - 1u));
    cuts.push_back(CutCase("short_font.font", s_PixelOffset - 1u));
    cuts.push_back(CutCase("missing_images.font", s_PixelOffset));
    cuts.push_back(CutCase("short_images.font", binary.size() - 1u));
    cuts.push_back(CutCase("trailing_byte.font", binary.size() + 1u));

    for(usize index = 0u; index < cuts.size(); ++index){
        const ScopedTestTrace trace(cuts[index].m_filename);
        AssetBytes malformed = CopyAssetBytes(binary, testArena.arena);
        malformed.resize(cuts[index].m_byteCount);
        ASSERT_TRUE(WriteCase(cuts[index].m_filename, malformed, testArena, path));
        EXPECT_FALSE(CanReadPrepared(path, false, testArena.arena));
        EXPECT_FALSE(CanReadPrepared(path, true, testArena.arena));
    }
    EXPECT_EQ(logger.errorCount(), 2u * cuts.size());
}

void VerifyPreparedFontSource_InvalidSerializationInputsRejectWithoutAllocating(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    SourceTestArena testArena = SourceTestArena();
    GlobalArena outputArena(s_FontCaseTestsIntegrationAssetsFontPreparedSerializeOutput);
    SourceFixture fixture(testArena.arena);
    AssetBytes validOutput(outputArena);
    ASSERT_TRUE(SerializeFixtureSource(fixture, outputArena, validOutput));
    const u32 invalidCaseCount = 18u;
    for(u32 variant = 0u; variant < invalidCaseCount; ++variant){
        const ScopedTestTrace trace(variant);
        const ArenaMemoryStats before = outputArena.memoryStats();
        b8 accepted = true;
        native(in fixture, in variant, mut outputArena, mut accepted){
            constexpr usize s_OverLimitGroupCount = 9u;
            BinaryByteView sfnt{ fixture.sfnt.data(), fixture.sfnt.size() };
            Array<PreparedFontImageView, s_OverLimitGroupCount> views = {};
            for(usize index = 0u; index < SourceFixture::s_GroupCount; ++index)
                views[index] = fixture.views[index];
            usize groupCount = SourceFixture::s_GroupCount;
            u32 faceIndex = 0u;
            switch(variant){
            case 0u: sfnt.byteCount = 0u; break;
            case 1u: sfnt.bytes = nullptr; break;
            case 2u: sfnt.byteCount = s_FontMaxSourceBytes + 1u; break;
            case 3u: faceIndex = 1u; break;
            case 4u: groupCount = 0u; break;
            case 5u: groupCount = s_OverLimitGroupCount; break;
            case 6u: views[0u].width = 0u; break;
            case 7u: views[0u].width = 2049u; break;
            case 8u: views[0u].width = Limit<u32>::s_Max; break;
            case 9u: views[0u].height = 0u; break;
            case 10u: views[0u].height = 2049u; break;
            case 11u: views[0u].height = Limit<u32>::s_Max; break;
            case 12u: views[0u].channelCount = 0u; break;
            case 13u: views[0u].channelCount = 5u; break;
            case 14u: views[0u].channelCount = Limit<u32>::s_Max; break;
            case 15u: views[0u].pixels = Span<const u8>(); break;
            case 16u: views[0u].pixels = views[0u].pixels.first(views[0u].pixels.size() - 1u); break;
            case 17u: views[0u].pixels = fixture.views[1u].pixels.first(views[0u].pixels.size() + 1u); break;
            default: break;
            }
            accepted = SerializePreparedFontSource(sfnt, faceIndex, Span<const PreparedFontImageView>(views.data(), groupCount), outputArena).has_value();
        }
        EXPECT_FALSE(accepted);
        EXPECT_EQ(outputArena.memoryStats().allocationCount, before.allocationCount);
    }
    EXPECT_EQ(logger.errorCount(), invalidCaseCount);
}

native{


