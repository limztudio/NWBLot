#include <impl/ecs_ui/toolkit/builder_scope.adhd>
#include <impl/ecs_ui/toolkit/paint.adhd>
#include <impl/ecs_ui/toolkit/widgets/ui_scope_descriptor_factory.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ListLayoutPreparer{
    private in BuilderScopeFrame m_scope;
    private in Context m_context;
    private mut TextService m_text;
    private in PaintBuilder m_paint;

    public ListLayoutPreparer(in BuilderScopeFrame scope, in Context context, mut TextService text, in PaintBuilder paint){
        this.m_scope = scope;
        this.m_context = context;
        this.m_text = text;
        this.m_paint = paint;
    }

    [cpp_unwind]
    private Expected<BuilderListRow> prepareListRow(in BuilderListFrame frame, in u64 index)const{
        BuilderListRow row;
        if(!this.m_scope.listMatches(this.m_context, frame) || index >= frame.rowCount)
            return MakeUnexpected(Failure());
        const u64 key = frame.source.value().key(index);
        if(key == 0u || !this.m_scope.listStateMatches(this.m_context, frame))
            return MakeUnexpected(Failure());
        const auto resolved = frame.source.value().indexOf(key);
        if(!resolved.has_value() || resolved.value() != index || !this.m_scope.listStateMatches(this.m_context, frame))
            return MakeUnexpected(Failure());
        const b8 enabled = frame.options.enabled && frame.source.value().enabled(index);
        if(!this.m_scope.listStateMatches(this.m_context, frame))
            return MakeUnexpected(Failure());
        ShapeRequest request;
        request.text = frame.source.value().text(index);
        const auto language = ReadBinaryTextSlice(Span<u8>(frame.measureKey.language), 0u, frame.measureKey.languageLength);
        if(!language.has_value())
            return MakeUnexpected(Failure());
        request.language = language.value();
        request.fontSize = frame.widgetStyle.fontSize;
        request.scriptTag = frame.measureKey.scriptTag;
        request.direction = frame.measureKey.direction;
        if(!this.m_scope.listStateMatches(this.m_context, frame))
            return MakeUnexpected(Failure());
        const auto measured = this.m_text.layoutAndMeasureShared(request, this.m_paint.displayMetrics());
        if(!measured.has_value() || !this.m_scope.listMatches(this.m_context, frame))
            return MakeUnexpected(Failure());
        row.index = index;
        row.key = key;
        row.enabled = enabled;
        row.text = measured.value().layout;
        row.textBounds = measured.value().bounds;
        if(!this.m_scope.listMatches(this.m_context, frame))
            return MakeUnexpected(Failure());
        return row;
    }

    [cpp_unwind]
    public b8 ensureVariableRowOffsets(in BuilderListFrame frame, mut ListState state)const{
        if(!frame.rowHeights.has_value()){
            if(!state.m_rowOffsets.empty())
                state.m_rowOffsets.clear();
            return true;
        }
        if(state.m_measureKey == frame.measureKey && state.m_rowOffsets.size() == cast<usize>(frame.rowCount) + 1u)
            return true;
        const u64 inputGeneration = state.m_inputGeneration;
        Vector<f64> offsets;
        offsets.resize(cast<usize>(frame.rowCount) + 1u, 0.0);
        f64 total = 0.0;
        in IListRowHeightProvider heights = frame.rowHeights.value();
        for(u64 index = 0u; index < frame.rowCount; ++index){
            if(!this.m_scope.listMatches(this.m_context, frame) || state.m_inputGeneration != inputGeneration)
                return false;
            const f32 h = heights.rowHeight(index, frame.rowHeight);
            if(!IsFinite(VectorSingle(h)) || h <= 0.0f || !this.m_scope.listMatches(this.m_context, frame) || state.m_inputGeneration != inputGeneration)
                return false;
            total += cast<f64>(h);
            if(!IsFinite(VectorDouble(total)))
                return false;
            offsets[cast<usize>(index + 1u)] = total;
        }
        if(!this.m_scope.listMatches(this.m_context, frame) || state.m_inputGeneration != inputGeneration)
            return false;
        TransferVector<f64>(state.m_rowOffsets, offsets);
        state.m_measureKey = frame.measureKey;
        state.m_rowHeight = frame.rowHeight;
        state.m_scrollRowHeight = frame.rowHeight;
        state.m_scrollSourceGeneration = frame.measureKey.sourceGeneration;
        state.m_contentWidth = 0.0;
        return true;
    }

    [cpp_unwind]
    public Expected<ListScrollPlacementResult> measureListPlacement(mut BuilderListFrame frame, in LayoutBox box, in Rect clip)const{
        mut Vector<BuilderListRow> rows = frame.rows;
        mut ListState state = frame.state.value();
        ScrollState scroll;
        ScrollState scrollX;
        if(!this.m_scope.listMatches(this.m_context, frame) || !scroll.setOffset(frame.scrollOffset) || !scrollX.setOffset(frame.scrollOffsetX))
            return MakeUnexpected(Failure());
        if(!this.ensureVariableRowOffsets(frame, state))
            return MakeUnexpected(Failure());
        const Span<f64> rowOffsets(state.m_rowOffsets);
        const b8 revealCursor = frame.revealCursor && frame.cursorKey != 0u;
        u64 cursorIndex = 0u;
        if(revealCursor){
            const auto resolved = frame.source.value().indexOf(frame.cursorKey);
            if(!resolved.has_value() || resolved.value() >= frame.rowCount || !this.m_scope.listStateMatches(this.m_context, frame))
                return MakeUnexpected(Failure());
            cursorIndex = resolved.value();
            if(frame.source.value().key(cursorIndex) != frame.cursorKey || !this.m_scope.listStateMatches(this.m_context, frame) || !frame.source.value().enabled(cursorIndex) || !this.m_scope.listMatches(this.m_context, frame))
                return MakeUnexpected(Failure());
        }
        f64 measuredContentWidth = frame.contentWidth;
        const b8 trackHorizontal = frame.options.horizontalScrollbar != ScrollbarPolicy::Never;
        while(true){
            auto candidate = CalculateListScrollPlacement(
                box.rectangle,
                clip,
                frame.padding,
                frame.style.scrollbarWidth,
                frame.style.minimumThumb,
                frame.rowCount,
                frame.rowHeight,
                rowOffsets,
                measuredContentWidth,
                scrollX.offset(),
                scroll.offset(),
                frame.options.horizontalScrollbar,
                frame.options.verticalScrollbar
            );
            if(!candidate.has_value())
                return MakeUnexpected(Failure());
            if(revealCursor){
                VectorDouble span(0.0);
                if(!TryResolveListCursorScrollSpan(cursorIndex, frame.rowHeight, rowOffsets, span) || !scroll.ensureVisible(span.x, span.y, candidate.value().placement.viewport.height))
                    return MakeUnexpected(Failure());
                candidate = CalculateListScrollPlacement(
                    box.rectangle,
                    clip,
                    frame.padding,
                    frame.style.scrollbarWidth,
                    frame.style.minimumThumb,
                    frame.rowCount,
                    frame.rowHeight,
                    rowOffsets,
                    measuredContentWidth,
                    scrollX.offset(),
                    scroll.offset(),
                    frame.options.horizontalScrollbar,
                    frame.options.verticalScrollbar
                );
            }
            if(!candidate.has_value() || candidate.value().placement.endRow - candidate.value().placement.firstRow > s_ListMaxPreparedRows)
                return MakeUnexpected(Failure());
            f32 height = frame.rowHeight;
            f64 nextContentWidth = measuredContentWidth;
            usize cursor = ListRowInsertionIndex(rows, candidate.value().placement.firstRow);
            for(u64 index = candidate.value().placement.firstRow; index < candidate.value().placement.endRow; ++index){
                while(cursor < rows.size() && rows[cursor].index < index)
                    ++cursor;
                if(cursor < rows.size() && rows[cursor].index == index){
                    if(trackHorizontal){
                        const f64 rowW = (cast<f64>(rows[cursor].textBounds.width) + cast<f64>(frame.style.row.padding.left)) + cast<f64>(frame.style.row.padding.right);
                        nextContentWidth = Max(nextContentWidth, rowW);
                    }
                    ++cursor;
                    continue;
                }
                if(rows.size() >= s_ListMaxPreparedRows)
                    return MakeUnexpected(Failure());
                auto row = this.prepareListRow(frame, index);
                if(!row.has_value())
                    return MakeUnexpected(Failure());
                if(!frame.rowHeights.has_value())
                    height = ComputeListRowPaddedHeight(row.value().textBounds.height, frame.style.row.padding, height);
                if(trackHorizontal){
                    const f64 rowW = (cast<f64>(row.value().textBounds.width) + cast<f64>(frame.style.row.padding.left)) + cast<f64>(frame.style.row.padding.right);
                    nextContentWidth = Max(nextContentWidth, rowW);
                }
                if(cursor == rows.size()){
                    rows.push_back(row.value());
                    ++cursor;
                }
                else{
                    rows.emplace(rows.begin() + cast<isize>(cursor));
                    rows[cursor] = row.value();
                    ++cursor;
                }
            }
            if(!IsFinite(VectorSingle(height)) || height <= 0.0f || !IsFinite(VectorDouble(nextContentWidth)) || !this.m_scope.listMatches(this.m_context, frame))
                return MakeUnexpected(Failure());
            if(height == frame.rowHeight && nextContentWidth == measuredContentWidth){
                frame.scrollOffset = candidate.value().placement.offset;
                frame.scrollOffsetX = candidate.value().scrollbars.horizontal.offset;
                frame.contentWidth = nextContentWidth;
                if(!frame.rowHeights.has_value() && state.m_measureKey == frame.measureKey && !(state.m_rowHeight > frame.rowHeight))
                    state.m_rowHeight = frame.rowHeight;
                state.m_contentWidth = nextContentWidth;
                state.m_visibleFirstRow = candidate.value().placement.firstRow;
                state.m_visibleEndRow = candidate.value().placement.endRow;
                return candidate.value();
            }
            if(height != frame.rowHeight){
                const f64 offset = ComputeListExpandedScrollOffset(
                    candidate.value().placement.contentClip.y,
                    candidate.value().placement.viewport.y,
                    candidate.value().placement.offset,
                    candidate.value().placement.firstRow,
                    frame.rowHeight,
                    height
                );
                if(!scroll.setOffset(offset))
                    return MakeUnexpected(Failure());
                frame.rowHeight = height;
            }
            measuredContentWidth = nextContentWidth;
        }
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 TryResolveListCursorScrollSpan(in u64 cursorIndex, in f32 rowHeight, in Span<f64> rowOffsets, mut VectorDouble outSpan){
    if(!rowOffsets.empty()){
        if(cursorIndex + 1u >= rowOffsets.size())
            return false;
        const f64 start = rowOffsets[cast<usize>(cursorIndex)];
        const f64 end = rowOffsets[cast<usize>(cursorIndex + 1u)];
        const VectorDouble span(start, end, 0.0, 0.0);
        if(!IsFinite(span) || end <= start)
            return false;
        outSpan = span;
        return true;
    }
    const f64 start = cast<f64>(cursorIndex) * cast<f64>(rowHeight);
    const f64 end = start + cast<f64>(rowHeight);
    const VectorDouble span(start, end, 0.0, 0.0);
    if(!IsFinite(span) || end <= start)
        return false;
    outSpan = span;
    return true;
}

usize ListRowInsertionIndex(in Vector<BuilderListRow> rows, in u64 index){
    usize begin = 0u;
    usize end = rows.size();
    while(begin < end){
        const usize middle = begin + (end - begin) / 2u;
        if(rows[middle].index < index)
            begin = middle + 1u;
        else
            end = middle;
    }
    return begin;
}


