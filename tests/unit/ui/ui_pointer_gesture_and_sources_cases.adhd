void VerifyUiPointerHitTests_VisibleOwnedPartCannotBypassItsClippedHostOrDisabledOverlaps(mut UiPointerHitTests self){
    const InputSource cursor = MakeUiPointerGestureSource(11u, 1u);
    Array<HitTarget, 5u> targets = Array<HitTarget, 5u>();
    targets[0u] = MakeUiPointerHitTarget(1u);
    targets[1u] = MakeUiPointerHitTarget(2u);
    targets[2u] = MakeUiPointerHitTarget(3u);
    targets[3u] = MakeUiPointerHitTarget(4u);
    targets[4u] = MakeUiPointerHitTarget(5u);
    targets[1u].paintOrder = 20u;
    targets[1u].clip = MakeUiPointerGestureRect(40.0f, 40.0f, 10.0f, 10.0f);
    targets[2u].paintOrder = 100u;
    targets[2u].enabled = false;
    targets[3u].clip.width = 0.0f;
    targets[3u].control.instanceGeneration = 14u;
    targets[3u].control.contentGeneration = 15u;
    targets[3u].control.contentRevision = 16u;
    targets[4u].owner = targets[3u].id;
    targets[4u].ownerDeclarationGeneration = targets[3u].declarationGeneration;
    targets[4u].control = targets[3u].control;
    targets[4u].focusable = false;
    targets[4u].paintOrder = u32.max;
    targets[4u].value = 27u;
    ASSERT_TRUE(self.m_router.commitTargets(targets, 1u));
    EXPECT_EQ(self.m_router.hitTest(MakeUiPointerGesturePoint(40.0f, 40.0f)), targets[1u].id);
    EXPECT_EQ(self.m_router.hitTest(MakeUiPointerGesturePoint(50.0f, 45.0f)), targets[0u].id);
    EXPECT_EQ(self.m_router.hitTest(MakeUiPointerGesturePoint(45.0f, 50.0f)), targets[0u].id);
    ASSERT_TRUE(self.send(MakeUiPointerContactHover(PointerPhase::Press, cursor, 45.0f, 45.0f, true)).pointerConsumed);
    EXPECT_EQ(self.m_router.hover(), targets[1u].id);
    EXPECT_EQ(self.m_router.capture(), targets[1u].id);
    ASSERT_TRUE(self.send(MakeUiPointerContactHover(PointerPhase::Release, cursor, 45.0f, 45.0f, true)).pointerConsumed);
    EXPECT_TRUE(self.m_router.consumeActivation(targets[1u].id));
    EXPECT_FALSE(self.m_router.consumeActivation(targets[4u].id));
    EXPECT_FALSE(self.m_router.consumeControlAction(targets[3u].id, 7u, targets[3u].control).has_value());

    targets[3u].clip.width = 100.0f;
    ASSERT_TRUE(self.m_router.commitTargets(targets, 2u));
    EXPECT_EQ(self.m_router.hover(), targets[4u].id);
    ASSERT_TRUE(self.send(MakeUiPointerContactHover(PointerPhase::Press, cursor, 45.0f, 45.0f, true)).pointerConsumed);
    EXPECT_EQ(self.m_router.capture(), targets[4u].id);
    EXPECT_EQ(self.m_router.focus(), targets[3u].id);
    ASSERT_TRUE(self.send(MakeUiPointerContactHover(PointerPhase::Release, cursor, 45.0f, 45.0f, true)).pointerConsumed);
    const auto actionResult = self.m_router.consumeControlAction(targets[3u].id, 7u, targets[3u].control);
    ASSERT_TRUE(actionResult.has_value());
    const ControlAction action = actionResult.value();
    EXPECT_EQ(action.source, targets[4u].id);
    EXPECT_EQ(action.value, 27u);
    EXPECT_FALSE(self.m_router.consumeActivation(targets[1u].id));
}

void VerifyUiPointerHitTests_OutsideTouchDismissalRefreshesAnIndependentCursorsPopupHover(mut UiPointerHitTests self){
    const InputSource cursor = MakeUiPointerGestureSource(11u, 1u);
    const InputSource contact = MakeUiPointerGestureSource(13u, 1u);
    Array<PointerIntentEnum, 2u> intents = Array<PointerIntentEnum, 2u>();
    intents[0u] = PointerIntent::Activate;
    intents[1u] = PointerIntent::ContextMenu;
    for(in PointerIntentEnum intent : intents){
        UiPointerHitPopupHarness harness = UiPointerHitPopupHarness();
        PopupScope scope = PopupScope();
        scope.token.widget.value = 100u;
        scope.token.declarationGeneration = 7u;
        scope.token.instanceGeneration = 8u;
        scope.token.openGeneration = 9u;
        scope.bounds = MakeUiPointerGestureRect(40.0f, 40.0f, 80.0f, 60.0f);
        scope.viewport = MakeUiPointerGestureRect(0.0f, 0.0f, 200.0f, 150.0f);
        scope.layer = 3u;
        const HitTarget base = MakeUiPointerHitTargetWithRect(1u, scope.viewport);
        HitTarget popup = MakeUiPointerHitTargetWithRect(100u, scope.bounds);
        popup.popup = scope.token;
        popup.layer = scope.layer;
        Array<HitTarget, 2u> targets = Array<HitTarget, 2u>();
        targets[0u] = base;
        targets[1u] = popup;
        ASSERT_TRUE(harness.commitWithPopup(targets, 1u, scope));
        ASSERT_TRUE(harness.router.queuePointer(MakeUiPointerContactHover(PointerPhase::Move, cursor, 50.0f, 50.0f, true)).has_value());
        ASSERT_EQ(harness.router.process().hover, popup.id);
        const u64 hovered = harness.router.hoverActivityGeneration();

        ASSERT_TRUE(harness.router.queuePointer(MakeUiPointerContactFull(PointerPhase::Press, contact, 10.0f, 10.0f, false, intent)).has_value());
        const InputRoutingResult dismissed = harness.router.process();
        EXPECT_TRUE(dismissed.pointerConsumed);
        EXPECT_FALSE(dismissed.hover.valid());
        EXPECT_GT(harness.router.hoverActivityGeneration(), hovered);
        EXPECT_TRUE(harness.router.pointerKnown());
        EXPECT_FLOAT_EQ(harness.router.pointerPosition().x, 50.0f);
        EXPECT_FLOAT_EQ(harness.router.pointerPosition().y, 50.0f);
        const auto reason = harness.router.consumePopupDismissal(scope.token);
        ASSERT_TRUE(reason.has_value());
        EXPECT_EQ(reason.value(), PopupDismissReason::OutsideClick);
        ASSERT_TRUE(harness.commitSingle(base, 2u));
        EXPECT_EQ(harness.router.hover(), base.id);
        ASSERT_TRUE(harness.router.queuePointer(MakeUiPointerContactFull(PointerPhase::Release, contact, 10.0f, 10.0f, false, intent)).has_value());
        EXPECT_TRUE(harness.router.process().pointerConsumed);
        EXPECT_FALSE(harness.router.consumeActivation(base.id));
    }
    EXPECT_FALSE(self.m_router.pointerKnown());
}

void VerifyUiPointerHitTests_HoverProviderChangesAndLayoutRelocationCannotReuseAnOlderTarget(mut UiPointerHitTests self){
    const InputSource cursor = MakeUiPointerGestureSource(11u, 1u);
    const InputSource otherCursor = MakeUiPointerGestureSource(12u, 1u);
    Array<HitTarget, 2u> targets = Array<HitTarget, 2u>();
    targets[0u] = MakeUiPointerHitTargetWithRect(1u, MakeUiPointerGestureRect(0.0f, 0.0f, 60.0f, 100.0f));
    targets[1u] = MakeUiPointerHitTargetWithRect(2u, MakeUiPointerGestureRect(70.0f, 0.0f, 60.0f, 100.0f));
    ASSERT_TRUE(self.m_router.commitTargets(targets, 1u));
    ASSERT_EQ(self.send(MakeUiPointerContactHover(PointerPhase::Move, cursor, 20.0f, 20.0f, true)).hover, targets[0u].id);
    const u64 initial = self.m_router.hoverActivityGeneration();
    ASSERT_EQ(self.send(MakeUiPointerContactHover(PointerPhase::Move, otherCursor, 20.0f, 20.0f, true)).hover, targets[0u].id);
    EXPECT_EQ(self.m_router.hoverActivityGeneration(), initial);
    EXPECT_EQ(self.send(MakeUiPointerContactHover(PointerPhase::Leave, cursor, 20.0f, 20.0f, true)).hover, targets[0u].id);
    EXPECT_TRUE(self.m_router.pointerKnown());

    targets[0u].rectangle.x = 70.0f;
    targets[1u].rectangle.x = 0.0f;
    ASSERT_TRUE(self.m_router.commitTargets(targets, 2u));
    EXPECT_EQ(self.m_router.hover(), targets[1u].id);
    const u64 relocated = self.m_router.hoverActivityGeneration();
    EXPECT_GT(relocated, initial);
    ASSERT_EQ(self.send(MakeUiPointerContactHover(PointerPhase::Move, otherCursor, 20.0f, 20.0f, true)).hover, targets[1u].id);
    EXPECT_EQ(self.m_router.hoverActivityGeneration(), relocated);
    targets[1u].declarationGeneration = 8u;
    ASSERT_TRUE(self.m_router.commitTargets(targets, 3u));
    EXPECT_EQ(self.m_router.hover(), targets[1u].id);
    EXPECT_GT(self.m_router.hoverActivityGeneration(), relocated);
    EXPECT_FALSE(self.send(MakeUiPointerContactHover(PointerPhase::Leave, otherCursor, 20.0f, 20.0f, true)).hover.valid());
    EXPECT_FALSE(self.m_router.pointerKnown());
}

void VerifyUiPointerHitTests_CrossTargetTouchDragKeepsCaptureWhileAnotherCursorRefreshesHover(mut UiPointerHitTests self){
    const InputSource cursor = MakeUiPointerGestureSource(11u, 1u);
    const InputSource contact = MakeUiPointerGestureSource(13u, 1u);
    Array<HitTarget, 2u> targets = Array<HitTarget, 2u>();
    targets[0u] = MakeUiPointerHitTargetWithRect(1u, MakeUiPointerGestureRect(0.0f, 0.0f, 60.0f, 100.0f));
    targets[1u] = MakeUiPointerHitTargetWithRect(2u, MakeUiPointerGestureRect(70.0f, 0.0f, 60.0f, 100.0f));
    ASSERT_TRUE(self.m_router.commitTargets(targets, 1u));
    ASSERT_EQ(self.send(MakeUiPointerContactHover(PointerPhase::Move, cursor, 20.0f, 20.0f, true)).hover, targets[0u].id);
    ASSERT_TRUE(self.send(MakeUiPointerContactAt(PointerPhase::Press, contact, 80.0f, 20.0f)).pointerConsumed);
    ASSERT_EQ(self.m_router.capture(), targets[1u].id);
    const auto initialResult = self.m_router.consumePointerGesture(targets[1u].id, 7u);
    ASSERT_TRUE(initialResult.has_value());
    const PointerGesture initial = initialResult.value();
    ASSERT_TRUE(self.send(MakeUiPointerContactAt(PointerPhase::Move, contact, 20.0f, 20.0f)).pointerConsumed);
    EXPECT_EQ(self.m_router.capture(), targets[1u].id);
    EXPECT_EQ(self.m_router.hover(), targets[0u].id);
    const auto movedResult = self.m_router.consumePointerGesture(targets[1u].id, 7u);
    ASSERT_TRUE(movedResult.has_value());
    const PointerGesture moved = movedResult.value();
    EXPECT_EQ(moved.id.sequence, initial.id.sequence);
    EXPECT_FLOAT_EQ(moved.position.x, 20.0f);
    const InputRoutingResult cursorResult = self.send(MakeUiPointerContactHover(PointerPhase::Move, cursor, 80.0f, 20.0f, true));
    EXPECT_FALSE(cursorResult.pointerRouted);
    EXPECT_EQ(cursorResult.hover, targets[1u].id);
    EXPECT_EQ(cursorResult.capture, targets[1u].id);

    ASSERT_TRUE(self.m_router.queuePointer(MakeUiPointerContactAt(PointerPhase::Move, contact, 20.0f, 20.0f)).has_value());
    ASSERT_TRUE(self.m_router.queuePointer(MakeUiPointerContactHover(PointerPhase::Move, cursor, 20.0f, 20.0f, true)).has_value());
    ASSERT_TRUE(self.m_router.queuePointer(MakeUiPointerContactAt(PointerPhase::Release, contact, 80.0f, 20.0f)).has_value());
    const InputRoutingResult released = self.m_router.process();
    EXPECT_TRUE(released.pointerConsumed);
    EXPECT_FALSE(released.capture.valid());
    EXPECT_EQ(released.hover, targets[0u].id);
    EXPECT_FLOAT_EQ(self.m_router.pointerPosition().x, 20.0f);
    EXPECT_TRUE(self.m_router.consumeActivation(targets[1u].id));
    EXPECT_FALSE(self.m_router.consumeActivation(targets[0u].id));
    const auto completedResult = self.m_router.consumePointerGesture(targets[1u].id, 7u);
    ASSERT_TRUE(completedResult.has_value());
    const PointerGesture completed = completedResult.value();
    EXPECT_EQ(completed.id.sequence, initial.id.sequence);
    EXPECT_EQ(completed.state, PointerGestureState::Completed);
    EXPECT_FLOAT_EQ(completed.position.x, 80.0f);
}


