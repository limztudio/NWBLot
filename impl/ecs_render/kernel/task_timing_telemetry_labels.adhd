// limztudio@gmail.com
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ShouldAppendPhysicalQueueRuntimeTelemetry(
    in u64 acceptedPacketCount,
    in u64 rejectedPacketCount,
    in u64 incomingLogicalOwnershipTransferCount,
    in u64 outgoingLogicalOwnershipTransferCount,
    in u64 incomingLogicalOwnershipTransferSignatureCount,
    in u64 outgoingLogicalOwnershipTransferSignatureCount,
    in u64 incomingRepeatedOwnershipTransferSignatureCount,
    in u64 outgoingRepeatedOwnershipTransferSignatureCount,
    in u64 concurrentSharingAdviceResourceCount
){
    if(acceptedPacketCount != 0u || rejectedPacketCount != 0u)
        return true;
    return
        incomingLogicalOwnershipTransferCount != 0u
        || outgoingLogicalOwnershipTransferCount != 0u
        || incomingLogicalOwnershipTransferSignatureCount != 0u
        || outgoingLogicalOwnershipTransferSignatureCount != 0u
        || incomingRepeatedOwnershipTransferSignatureCount != 0u
        || outgoingRepeatedOwnershipTransferSignatureCount != 0u
        || concurrentSharingAdviceResourceCount != 0u
    ;
}

b8 CanBuildFrameGraphRuntimeStatistics(in b8 statisticsValid, in u64 captureFrameIndex, in u64 sourceFrameIndex){
    return statisticsValid && captureFrameIndex == sourceFrameIndex;
}

b8 HasMatchingPhysicalQueueTelemetryEpochs(
    in u64 compileGraphGeneration,
    in u64 recordingGraphGeneration,
    in u64 submissionGraphGeneration,
    in u64 compilePlanGeneration,
    in u64 recordingPlanGeneration,
    in u64 submissionPlanGeneration,
    in u64 recordingAttemptGeneration,
    in u64 submissionAttemptGeneration,
    in u16 compileDeviceGeneration,
    in u16 recordingDeviceGeneration,
    in u16 submissionDeviceGeneration
){
    return
        compileGraphGeneration == recordingGraphGeneration
        && compileGraphGeneration == submissionGraphGeneration
        && compilePlanGeneration == recordingPlanGeneration
        && compilePlanGeneration == submissionPlanGeneration
        && recordingAttemptGeneration == submissionAttemptGeneration
        && compileDeviceGeneration == recordingDeviceGeneration
        && compileDeviceGeneration == submissionDeviceGeneration
    ;
}


