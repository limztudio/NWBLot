const usize s_TokenCapacity = s_TextLength + 1u;
const usize s_ResolvedCapacity = s_MaxResolvedTextLength;
const u32 s_SymbolRecorderIterations = 400u;
const u32 s_ConcurrentLoggerThreadCount = 4u;
const u32 s_ConcurrentLoggerMessagesPerThread = 512u;
const u32 s_ConcurrentLoggerExpectedMessages = s_ConcurrentLoggerThreadCount * s_ConcurrentLoggerMessagesPerThread;
const u32 s_ConcurrentLoggerExpectedErrors = s_ConcurrentLoggerExpectedMessages / 2u;
const StringView s_TargetText = "concurrent/symbol_entry";
const StringView s_ParallelLoggerMessageText = "parallel logger message";
const StringView s_TestsNamesymbolsBeforeRegistryLive = "tests/namesymbols/before_registry_live";
const StringView s_TestsNamesymbolsBeforeRegistryRetire = "tests/namesymbols/before_registry_retired";
const StringView s_GlobalArenaMemoryHeapBacking = "global/arena_memory/heap_backing";
const StringView s_OriginalEscapedSymbol = "symbols/line\ncarriage\rtab\tend";
const StringView s_RetainedAdmissionSymbol = "admission/retained";
const StringView s_DecodeKnownSymbol = "decode/known";
const StringView s_DecodeShortSymbol = "decode/short";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SymbolRegistryScope{
    private b8 m_restore;

    public SymbolRegistryScope(in b8 restore){ this.m_restore = restore; }
    public ~SymbolRegistryScope(){
        if(this.m_restore)
            InstallRuntimeRegistry();
        ClearRuntimeSymbols();
        if(!this.m_restore)
            UninstallRuntimeRegistry();
    }
}

class CallbackUnregisterLogger : Utf8LogSink{
    private mut Optional<LoggerRegistrationGuard> m_guard;
    private mut Latch m_entered;
    private mut TestAtomic<b8> m_started;
    private mut TestAtomic<b8> m_active;
    private mut TestAtomic<b8> m_returnedEarly;
    private mut TestAtomic<u32> m_count;

    public CallbackUnregisterLogger(mut Optional<LoggerRegistrationGuard> guard, mut Latch entered, mut TestAtomic<b8> started, mut TestAtomic<b8> active, mut TestAtomic<b8> returnedEarly, mut TestAtomic<u32> count){
        this.m_guard = guard;
        this.m_entered = entered;
        this.m_started = started;
        this.m_active = active;
        this.m_returnedEarly = returnedEarly;
        this.m_count = count;
    }

    public void receive(in StringView text, in LogType kind)override{
        this.m_count.fetch_add(1u, MemoryOrder::relaxed);
        this.m_entered.arrive_and_wait();
        if(text == "self-unregister"){
            this.m_started.store(true, MemoryOrder::release);
            this.m_started.notify_all();
            this.m_guard.reset();
            if(this.m_active.load(MemoryOrder::acquire))
                this.m_returnedEarly.store(true, MemoryOrder::relaxed);
            WriteEssentialLog(PlatformTextLiteral("routed-to-base-after-self-unregister"));
            return;
        }
        while(!this.m_started.load(MemoryOrder::acquire))
            this.m_started.wait(false, MemoryOrder::relaxed);
        for(u32 spin = 0u; spin < 64u; ++spin)
            YieldThread();
        this.m_active.store(false, MemoryOrder::release);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void CopyAsciiText(in StringView source, mut MeasuredText text){
    text.append(source);
}

void CopyAsciiToPlatform(in StringView source, mut MeasuredPlatformText text){
    text.reserve(source.size());
    for(usize index = 0u; index < source.size(); ++index)
        text.push_back(cast<u8>(source[index]));
}

void BuildBoundaryTokenSource(in Name known, mut String source){
    String knownTokenText = "";
    String unknownTokenText = "";
    String mutatedKnownTokenText = "";
    {
        SymbolBuffer<s_TokenCapacity> knownToken;
        SymbolBuffer<s_TokenCapacity> unknownToken;
        knownToken.format(known.identityHash());
        unknownToken.format(ComputeNameHash(StringView("decode/unknown")).value());
        knownTokenText.assign(knownToken.view());
        unknownTokenText.assign(unknownToken.view());
        knownToken.setByte(0u, 103u);
        mutatedKnownTokenText.assign(knownToken.view());
    }
    const StringView knownView = knownTokenText;
    const StringView unknownView = unknownTokenText;
    const StringView mutatedKnownView = mutatedKnownTokenText;
    source.clear();
    source.append(unknownView);
    source.append(" !");
    source.append(knownView);
    source.append("_ !a");
    source.append(knownView);
    source.append(" !");
    source.append(mutatedKnownView);
}

void BuildResolvedSpanSources(in Name shortName, mut b8 longNameCreated, mut String source, mut String expectedSource){
    String expanded = "";
    expanded.reserve(300u);
    for(u32 index = 0u; index < 300u; ++index)
        expanded.append("z");
    const StringView expandedView = expanded;

    String shortTokenText = "";
    String longTokenText = "";
    String unknownTokenText = "";
    {
        const auto longNameResult = NameFromText(expandedView);
        longNameCreated = longNameResult.has_value();
        if(longNameCreated){
            SymbolBuffer<s_TokenCapacity> shortToken;
            SymbolBuffer<s_TokenCapacity> longToken;
            SymbolBuffer<s_TokenCapacity> unknownToken;
            shortToken.format(shortName.identityHash());
            longToken.format(longNameResult.value().identityHash());
            unknownToken.format(ComputeNameHash(StringView("decode/unresolved")).value());
            shortTokenText.assign(shortToken.view());
            longTokenText.assign(longToken.view());
            unknownTokenText.assign(unknownToken.view());
        }
    }
    if(!longNameCreated)
        return;

    const StringView shortView = shortTokenText;
    const StringView longView = longTokenText;
    const StringView unknownView = unknownTokenText;

    source.clear();
    source.append(shortView);
    source.append(" !");
    source.append(unknownView);
    source.append(" !");
    source.append(longView);
    source.append(" !");
    source.append(shortView);

    expectedSource.clear();
    expectedSource.append("decode/short !");
    expectedSource.append(unknownView);
    expectedSource.append(" !");
    expectedSource.append(expandedView);
    expectedSource.append(" !decode/short");
}

void VerifyNameSymbolDecodeTests_UnknownAndBoundaryNarrowTokensDoNotAllocate(){
    InstallRuntimeRegistry();
    ClearRuntimeSymbols();
    const Name known(s_DecodeKnownSymbol);
    String source = "";
    BuildBoundaryTokenSource(known, source);
    const StringView sourceView = source;

    String decoded = "";
    b8 dataPointerUnchanged = false;
    ArenaMemoryStats before = ArenaMemoryStats();
    ArenaMemoryStats after = ArenaMemoryStats();
    {
        HeapStorage storage(Name("Tests/NameSymbols/Boundaries"));
        TestValueSlot<MeasuredText> textSlot;
        mut MeasuredText text = textSlot.constructIn(storage);
        CopyAsciiText(sourceView, text);
        const usize originalData = TestDataAddress(text);
        before = storage.memoryStats();
        DecodeMeasuredText(storage, text);
        after = storage.memoryStats();
        dataPointerUnchanged = TestDataAddress(text) == originalData;
        decoded.assign(NarrowView(text));
    }

    EXPECT_EQ(decoded, source);
    EXPECT_TRUE(dataPointerUnchanged);
    EXPECT_EQ(after.allocationCount, before.allocationCount);
    EXPECT_EQ(after.reallocationCount, before.reallocationCount);
    EXPECT_EQ(after.deallocationCount, before.deallocationCount);
}

void VerifyNameSymbolDecodeTests_UnknownAndBoundaryWideTokensDoNotAllocate(){
    InstallRuntimeRegistry();
    ClearRuntimeSymbols();

    const Name known(s_DecodeKnownSymbol);
    String source = "";
    BuildBoundaryTokenSource(known, source);
    const StringView sourceView = source;

    b8 textMatchesExpected = false;
    b8 dataPointerUnchanged = false;
    ArenaMemoryStats before = ArenaMemoryStats();
    ArenaMemoryStats after = ArenaMemoryStats();
    {
        HeapStorage storage(Name("Tests/NameSymbols/Boundaries"));
        TestValueSlot<MeasuredPlatformText> textSlot;
        mut MeasuredPlatformText text = textSlot.constructIn(storage);
        CopyAsciiToPlatform(sourceView, text);
        TestValueSlot<MeasuredPlatformText> expectedSlot;
        mut MeasuredPlatformText expected = expectedSlot.constructIn(storage);
        CopyAsciiToPlatform(sourceView, expected);
        const usize originalData = TestDataAddress(text);
        before = storage.memoryStats();
        DecodeMeasuredText(storage, text);
        after = storage.memoryStats();
        dataPointerUnchanged = TestDataAddress(text) == originalData;
        textMatchesExpected = PlatformView(text) == PlatformView(expected);
    }

    EXPECT_TRUE(textMatchesExpected);
    EXPECT_TRUE(dataPointerUnchanged);
    EXPECT_EQ(after.allocationCount, before.allocationCount);
    EXPECT_EQ(after.reallocationCount, before.reallocationCount);
    EXPECT_EQ(after.deallocationCount, before.deallocationCount);
}

void VerifyNameSymbolDecodeTests_ResolvesNarrowSpansWithoutChangingUnresolvedText(){
    InstallRuntimeRegistry();
    ClearRuntimeSymbols();
    const Name shortName(s_DecodeShortSymbol);
    b8 longNameCreated = false;
    String source = "";
    String expectedSource = "";
    BuildResolvedSpanSources(shortName, longNameCreated, source, expectedSource);
    ASSERT_TRUE(longNameCreated);

    const StringView sourceView = source;
    String decoded = "";
    {
        HeapStorage storage(Name("Tests/NameSymbols/Resolved"));
        TestValueSlot<MeasuredText> textSlot;
        mut MeasuredText text = textSlot.constructIn(storage);
        CopyAsciiText(sourceView, text);
        DecodeMeasuredText(storage, text);
        decoded.assign(NarrowView(text));
    }

    EXPECT_EQ(decoded, expectedSource);
}

void VerifyNameSymbolDecodeTests_ResolvesWideSpansWithoutChangingUnresolvedText(){
    InstallRuntimeRegistry();
    ClearRuntimeSymbols();

    const Name shortName(s_DecodeShortSymbol);
    b8 longNameCreated = false;
    String source = "";
    String expectedSource = "";
    BuildResolvedSpanSources(shortName, longNameCreated, source, expectedSource);
    ASSERT_TRUE(longNameCreated);

    const StringView sourceView = source;
    const StringView expectedView = expectedSource;
    b8 decodedMatchesExpected = false;
    usize decodedLength = 0u;
    {
        HeapStorage storage(Name("Tests/NameSymbols/Resolved"));
        TestValueSlot<MeasuredPlatformText> textSlot;
        mut MeasuredPlatformText text = textSlot.constructIn(storage);
        CopyAsciiToPlatform(sourceView, text);
        TestValueSlot<MeasuredPlatformText> expectedSlot;
        mut MeasuredPlatformText expected = expectedSlot.constructIn(storage);
        CopyAsciiToPlatform(expectedView, expected);
        DecodeMeasuredText(storage, text);
        decodedMatchesExpected = PlatformView(text) == PlatformView(expected);
        decodedLength = text.size();
    }

    EXPECT_TRUE(decodedMatchesExpected);
    EXPECT_EQ(decodedLength, expectedSource.size());
}

void VerifyNameSymbolDecodeTests_EscapedDocumentRoundTripsAndMalformedRecordsStayUnpublished(){
    InstallRuntimeRegistry();
    ClearRuntimeSymbols();
    const StringView original = s_OriginalEscapedSymbol;
    const Name stored(s_OriginalEscapedSymbol);
    b8 serialized = false;
    String documentText = "";
    b8 loadedFromMemory = false;
    b8 resolvedStored = false;
    String resolvedText = "";
    b8 resolvedInvalid = true;

    {
        HeapStorage storage(Name("Tests/NameSymbols/EscapedDocument"));
        ScratchStorage scratchArena(s_CommonNameTestsNameSymbolsScratch);
        SymbolRegistryScope cleanup(false);
        const NameHash invalidHash = ComputeNameHash(StringView("symbols/invalid_escape_record")).value();
        SymbolBuffer<s_TokenCapacity> invalidToken;
        invalidToken.format(invalidHash);

        TestValueSlot<MeasuredText> documentSlot;
        mut MeasuredText document = documentSlot.constructIn(storage);
        document.append("prefix:");
        const usize prefixLength = document.size();
        serialized = SerializeMeasured(document).has_value();
        documentText.assign(NarrowView(document));
        if(serialized){
            document.append(invalidToken.view());
            document.append("\truntime\tinvalid\\q\n");
            document.append(invalidToken.view());
            document.append("\truntime\tdangling\\\n");
            ClearRuntimeSymbols();
            loadedFromMemory = LoadFromMemory(NarrowView(document).substr(prefixLength), scratchArena);
            if(loadedFromMemory){
                SymbolBuffer<s_ResolvedCapacity> resolved;
                resolvedStored = resolved.resolve(stored.identityHash());
                if(resolvedStored)
                    resolvedText.assign(resolved.view());
                resolvedInvalid = resolved.resolve(invalidHash);
            }
        }
    }

    ASSERT_TRUE(serialized);
    EXPECT_LT(documentText.find("symbols/line\\ncarriage\\rtab\\tend"), documentText.size());
    ASSERT_TRUE(loadedFromMemory);
    ASSERT_TRUE(resolvedStored);
    const StringView resolvedView = resolvedText;
    EXPECT_EQ(resolvedView, original);
    EXPECT_FALSE(resolvedInvalid);
}

void VerifyNameSymbolDecodeTests_RejectsNoncurrentDocumentHeaderBeforePublishingSymbols(){
    InstallRuntimeRegistry();
    ClearRuntimeSymbols();
    const Name retained(s_RetainedAdmissionSymbol);
    Array<StringView, 6> rejectedHeaders = Array<StringView, 6>();
    rejectedHeaders[0u] = "";
    rejectedHeaders[1u] = "nwb_namesym_v0\tproducer=runtime\n";
    rejectedHeaders[2u] = "nwb_namesym_v2\tproducer=runtime\n";
    rejectedHeaders[3u] = "nwb_namesym_v10\tproducer=runtime\n";
    rejectedHeaders[4u] = "nwb_namesym_v1_suffix\tproducer=runtime\n";
    rejectedHeaders[5u] = "\n";

    b8 rejectedAllInvalidHeaders = true;
    b8 loadedCurrentDocument = false;
    b8 retainedStillResolved = false;
    b8 incomingResolvedAfterLoad = false;
    String incomingText = "";

    {
        ScratchStorage scratchArena(s_CommonNameTestsNameSymbolsScratch);
        const NameHash incomingHash = ComputeNameHash(StringView("admission/incoming")).value();
        SymbolBuffer<s_TokenCapacity> incomingToken;
        incomingToken.format(incomingHash);
        String record;
        StringAppendFormat(record, "{}\truntime\tAdmission/Incoming\n", incomingToken.view());
        const usize retainedCount = EntryCount();
        SymbolBuffer<s_ResolvedCapacity> resolvedText;
        for(in StringView header : rejectedHeaders){
            String document;
            document.append(header);
            document.append(record);
            const b8 loaded = LoadFromMemory(StringView(document), scratchArena);
            const b8 countPreserved = EntryCount() == retainedCount;
            const b8 retainedOk = resolvedText.resolve(retained.hash()) && resolvedText.view() == "admission/retained";
            const b8 incomingPublished = resolvedText.resolve(incomingHash);
            if(loaded || !countPreserved || !retainedOk || incomingPublished)
                rejectedAllInvalidHeaders = false;
        }

        String currentDocument;
        currentDocument.append(s_FileHeader);
        currentDocument.append("\tproducer=runtime\r\n");
        currentDocument.append(record);
        loadedCurrentDocument = LoadFromMemory(StringView(currentDocument), scratchArena);
        if(loadedCurrentDocument){
            retainedStillResolved = resolvedText.resolve(retained.hash());
            incomingResolvedAfterLoad = resolvedText.resolve(incomingHash);
            if(incomingResolvedAfterLoad)
                incomingText.assign(resolvedText.view());
        }
        ClearRuntimeSymbols();
    }

    EXPECT_TRUE(rejectedAllInvalidHeaders);
    ASSERT_TRUE(loadedCurrentDocument);
    EXPECT_TRUE(retainedStillResolved);
    ASSERT_TRUE(incomingResolvedAfterLoad);
    const StringView incomingView = incomingText;
    EXPECT_EQ(incomingView, "admission/incoming");
}

Expected<b8, ErrorCode> LoadNameSymbolsFileForTest(in Path path){
    Expected<b8, ErrorCode> loaded = false;
    ScratchStorage storage(s_CommonNameTestsNameSymbolsScratch);
    loaded = LoadSymbolFile(path, storage);
    return loaded;
}

void VerifyNameSymbolDecodeTests_FileLoadSeparatesHeaderAnswerFromNativeReadFailure(){
    const Path path("name_symbol_expected_file_unit.namesym");
    ASSERT_TRUE(RemoveAllIfExists(path).has_value());

    const b8 wroteV1 = WriteTextFile(path, "nwb_namesym_v1\n");
    Expected<b8, ErrorCode> accepted = false;
    if(wroteV1)
        accepted = LoadNameSymbolsFileForTest(path);

    const b8 wroteV2 = wroteV1 && WriteTextFile(path, "nwb_namesym_v2\n");
    Expected<b8, ErrorCode> rejectedHeader = true;
    if(wroteV2)
        rejectedHeader = LoadNameSymbolsFileForTest(path);

    const Expected<b8, ErrorCode> removed = RemoveFile(path);
    const Expected<u64, ErrorCode> missingFileSize = FileSize(path);
    const Expected<b8, ErrorCode> missing = LoadNameSymbolsFileForTest(path);
    const b8 cleanedUp = RemoveFile(path).has_value();

    ASSERT_TRUE(wroteV1);
    ASSERT_TRUE(accepted.has_value());
    EXPECT_TRUE(accepted.value());
    ASSERT_TRUE(wroteV2);
    ASSERT_TRUE(rejectedHeader.has_value());
    EXPECT_FALSE(rejectedHeader.value());
    ASSERT_TRUE(removed.has_value());
    ASSERT_TRUE(removed.value());
    ASSERT_FALSE(missingFileSize.has_value());
    ASSERT_FALSE(missing.has_value());
    EXPECT_EQ(missing.error(), missingFileSize.error());
    EXPECT_EQ(missing.error().category(), missingFileSize.error().category());
    EXPECT_TRUE(cleanedUp);
}

void VerifyNameSymbolDecodeTests_NameSymbolsCollectArenaOwnersWithoutPerformanceCapture(){
    const b8 buildSymbolsEnabled = s_SymbolsEnabled;
    b8 preResolveAny = true;
    b8 serialized = false;
    String serializedText = "";
    b8 resolvedLive = false;
    b8 resolvedRetired = false;
    b8 resolvedHeap = false;
    String liveResolvedText = "";
    String retiredResolvedText = "";
    String heapResolvedText = "";
    b8 wroteDefaultFile = false;
    b8 readDefaultFile = false;
    String defaultFileText = "";
    b8 loadedDefaultOk = false;
    b8 resolvedLiveAfterDefault = false;
    String liveAfterDefaultText = "";
    b8 removedDefaultFile = false;

    {
        const NameHash s_LiveHash = ComputeNameHash(StringView("tests/namesymbols/before_registry_live")).value();
        const NameHash s_RetiredHash = ComputeNameHash(StringView("tests/namesymbols/before_registry_retired")).value();
        const NameHash s_HeapHash = ComputeNameHash(StringView("global/arena_memory/heap_backing")).value();
        UninstallRuntimeRegistry();
        HeapStorage liveOwner(s_CommonNameTestsNameSymbolsBeforeRegistryLive);
        {
            HeapStorage retiredOwner(s_CommonNameTestsNameSymbolsBeforeRegistryRetired);
        }
        InstallRuntimeRegistry();
        ClearRuntimeSymbols();

        SymbolBuffer<128u> resolvedBuffer;
        preResolveAny =
            resolvedBuffer.resolve(s_LiveHash)
            || resolvedBuffer.resolve(s_RetiredHash)
            || resolvedBuffer.resolve(s_HeapHash)
        ;

        TestValueSlot<MeasuredText> textSlot;
        mut MeasuredText namesymText = textSlot.constructIn(liveOwner);
        serialized = SerializeMeasured(namesymText).has_value();
        serializedText.assign(NarrowView(namesymText));

        resolvedLive = resolvedBuffer.resolve(s_LiveHash);
        if(resolvedLive)
            liveResolvedText.assign(resolvedBuffer.view());
        resolvedRetired = resolvedBuffer.resolve(s_RetiredHash);
        if(resolvedRetired)
            retiredResolvedText.assign(resolvedBuffer.view());
        resolvedHeap = resolvedBuffer.resolve(s_HeapHash);
        if(resolvedHeap)
            heapResolvedText.assign(resolvedBuffer.view());

        ClearRuntimeSymbols();
        const auto executableDirectory = ExecutablePaths().directory();
        const auto executableName = ExecutablePaths().name();
        ASSERT_TRUE(executableDirectory);
        ASSERT_TRUE(executableName);
        Path namesymPath = executableDirectory.value() / executableName.value();
        namesymPath.replaceExtension(PlatformTextLiteral(".namesym"));
        UninstallRuntimeRegistry();
        wroteDefaultFile = WriteDefaultFile();
        InstallRuntimeRegistry();
        namesymText.clear();
        if(wroteDefaultFile){
            readDefaultFile = ReadMeasuredFile(namesymPath, namesymText).has_value();
            defaultFileText.assign(NarrowView(namesymText));
        }
        ClearRuntimeSymbols();
        const auto loadedDefault = LoadDefaultFile();
        if(loadedDefault.has_value())
            loadedDefaultOk = loadedDefault.value();
        else
            loadedDefaultOk = loadedDefault.error().loadedAny;
        resolvedLiveAfterDefault = resolvedBuffer.resolve(s_LiveHash);
        if(resolvedLiveAfterDefault)
            liveAfterDefaultText.assign(resolvedBuffer.view());
        removedDefaultFile = RemoveFile(namesymPath).has_value();
    }

    EXPECT_FALSE(preResolveAny);
    ASSERT_TRUE(serialized);
    if(buildSymbolsEnabled){
        EXPECT_TRUE(resolvedLive);
        const StringView liveView = liveResolvedText;
        EXPECT_EQ(liveView, s_TestsNamesymbolsBeforeRegistryLive);
        EXPECT_TRUE(resolvedRetired);
        const StringView retiredView = retiredResolvedText;
        EXPECT_EQ(retiredView, s_TestsNamesymbolsBeforeRegistryRetire);
        EXPECT_TRUE(resolvedHeap);
        const StringView heapView = heapResolvedText;
        EXPECT_EQ(heapView, s_GlobalArenaMemoryHeapBacking);
        EXPECT_LT(serializedText.find(s_TestsNamesymbolsBeforeRegistryLive), serializedText.size());
        EXPECT_LT(serializedText.find(s_TestsNamesymbolsBeforeRegistryRetire), serializedText.size());
        EXPECT_LT(serializedText.find(s_GlobalArenaMemoryHeapBacking), serializedText.size());
    }
    else{
        EXPECT_FALSE(resolvedLive);
        EXPECT_FALSE(resolvedRetired);
        EXPECT_FALSE(resolvedHeap);
    }

    ASSERT_TRUE(wroteDefaultFile);
    ASSERT_TRUE(readDefaultFile);
    if(buildSymbolsEnabled){
        EXPECT_LT(defaultFileText.find(s_TestsNamesymbolsBeforeRegistryLive), defaultFileText.size());
        EXPECT_LT(defaultFileText.find(s_TestsNamesymbolsBeforeRegistryRetire), defaultFileText.size());
        EXPECT_LT(defaultFileText.find(s_GlobalArenaMemoryHeapBacking), defaultFileText.size());
    }
    else{
        EXPECT_GE(defaultFileText.find(s_TestsNamesymbolsBeforeRegistryLive), defaultFileText.size());
        EXPECT_GE(defaultFileText.find(s_TestsNamesymbolsBeforeRegistryRetire), defaultFileText.size());
        EXPECT_GE(defaultFileText.find(s_GlobalArenaMemoryHeapBacking), defaultFileText.size());
    }
    EXPECT_TRUE(loadedDefaultOk);
    if(buildSymbolsEnabled){
        ASSERT_TRUE(resolvedLiveAfterDefault);
        const StringView liveDefaultView = liveAfterDefaultText;
        EXPECT_EQ(liveDefaultView, s_TestsNamesymbolsBeforeRegistryLive);
    }
    EXPECT_TRUE(removedDefaultFile);
}

void VerifyNameSymbolDecodeTests_ConcurrentRecordResolveClearAndUninstallStaySynchronized(){
    const usize maxAllowedEntries = 64u;
    u32 completedIterations = 0u;
    b8 sawIdentityMismatch = false;
    b8 sawResolvedTextMismatch = false;
    usize observedPeakEntryCount = 0u;

    {
        InstallRuntimeRegistry();
        ClearRuntimeSymbols();
        SymbolRegistryScope restoreRegistry(true);

        const NameHash targetHash = ComputeNameHash(StringView("concurrent/symbol_entry")).value();
        TestAtomic<b8> stop(false);
        TestAtomic<u32> recordedCount(0u);
        TestAtomic<b8> identityMismatch(false);
        TestAtomic<b8> resolvedMismatch(false);
        TestAtomic<usize> maxCount(0u);
        Latch startLatch(4);

        {
            JoiningThread recorderThread(lambda[mut startLatch, in targetHash, mut identityMismatch, mut recordedCount, mut stop]() -> void{
                startLatch.arrive_and_wait();
                for(u32 i = 0u; i < s_SymbolRecorderIterations; ++i){
                    const Name recorded(s_TargetText);
                    if(recorded.identityHash() != targetHash)
                        identityMismatch.store(true, MemoryOrder::relaxed);
                    recordedCount.fetch_add(1u, MemoryOrder::relaxed);
                }
                stop.store(true, MemoryOrder::release);
            });

            JoiningThread resolverThread(lambda[mut startLatch, mut stop, in targetHash, mut resolvedMismatch]() -> void{
                startLatch.arrive_and_wait();
                SymbolBuffer<s_ResolvedCapacity> buffer;
                while(!stop.load(MemoryOrder::acquire)){
                    if(buffer.resolve(targetHash) && buffer.view() != s_TargetText)
                        resolvedMismatch.store(true, MemoryOrder::relaxed);
                }
            });

            JoiningThread clearThread(lambda[mut startLatch, mut stop, mut maxCount]() -> void{
                startLatch.arrive_and_wait();
                while(!stop.load(MemoryOrder::acquire)){
                    ClearRuntimeSymbols();
                    const usize count = EntryCount();
                    usize previousMax = maxCount.load(MemoryOrder::relaxed);
                    while(count > previousMax && !maxCount.compare_exchange_weak(previousMax, count, MemoryOrder::relaxed)){}
                }
            });

            JoiningThread toggleThread(lambda[mut startLatch, mut stop]() -> void{
                startLatch.arrive_and_wait();
                while(!stop.load(MemoryOrder::acquire)){
                    UninstallRuntimeRegistry();
                    InstallRuntimeRegistry();
                }
            });
        }

        completedIterations = recordedCount.load(MemoryOrder::relaxed);
        sawIdentityMismatch = identityMismatch.load(MemoryOrder::relaxed);
        sawResolvedTextMismatch = resolvedMismatch.load(MemoryOrder::relaxed);
        observedPeakEntryCount = maxCount.load(MemoryOrder::relaxed);
    }

    EXPECT_EQ(completedIterations, s_SymbolRecorderIterations);
    EXPECT_FALSE(sawIdentityMismatch);
    EXPECT_FALSE(sawResolvedTextMismatch);
    EXPECT_LE(observedPeakEntryCount, maxAllowedEntries);
}

void VerifyCommonLoggingBoundaries_LoggerMacrosBehaveAsSingleStatements(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard guard(logger);

    b8 elseBranchRan = false;
    UnbracedIfElse(false, WriteEssentialLog(PlatformTextLiteral("unreachable")), lambda[mut elseBranchRan]() -> void{
        elseBranchRan = true;
    });

    EXPECT_TRUE(elseBranchRan);
    EXPECT_EQ(logger.messageCount(), 0u);
}

void VerifyCommonLoggingBoundaries_CapturingLoggerSerializesConcurrentWritersAndReaders(){
    CapturingLogger logger = CapturingLogger();
    b8 sawInvalidObservation = false;
    u32 observedMessageTotal = 0u;
    u32 observedErrorTotal = 0u;

    {
        Latch startGate(s_ConcurrentLoggerThreadCount + 2u);
        TestAtomic<u32> activeWriters(s_ConcurrentLoggerThreadCount);
        TestAtomic<u32> observedMessages(0u);
        TestAtomic<u32> observedErrors(0u);
        TestAtomic<b8> invalidObservation(false);
        JoiningThread reader(lambda[mut startGate, mut activeWriters, mut logger, mut invalidObservation, mut observedMessages, mut observedErrors]() -> void{
            startGate.arrive_and_wait();
            while(activeWriters.load(MemoryOrder::acquire) == s_ConcurrentLoggerThreadCount)
                YieldThread();
            u32 lastMessageCount = 0u;
            u32 lastErrorCount = 0u;
            while(true){
                const u32 messageCount = logger.messageCount();
                const u32 errorCount = logger.errorCount();
                const LogType lastType = logger.lastType();
                if(messageCount > s_ConcurrentLoggerExpectedMessages || errorCount > s_ConcurrentLoggerExpectedErrors || (lastType != LogType::Info && lastType != LogType::Error))
                    invalidObservation.store(true, MemoryOrder::relaxed);
                if(messageCount > lastMessageCount){
                    observedMessages.fetch_add(messageCount - lastMessageCount, MemoryOrder::relaxed);
                    lastMessageCount = messageCount;
                }
                if(errorCount > lastErrorCount){
                    observedErrors.fetch_add(errorCount - lastErrorCount, MemoryOrder::relaxed);
                    lastErrorCount = errorCount;
                }
                YieldThread();
                if(activeWriters.load(MemoryOrder::acquire) == 0u)
                    break;
            }
            const u32 messageCount = logger.messageCount();
            const u32 errorCount = logger.errorCount();
            if(messageCount > lastMessageCount)
                observedMessages.fetch_add(messageCount - lastMessageCount, MemoryOrder::relaxed);
            if(errorCount > lastErrorCount)
                observedErrors.fetch_add(errorCount - lastErrorCount, MemoryOrder::relaxed);
        });
        Array<Optional<JoiningThread>, 4> writers;
        for(u32 threadIndex = 0u; threadIndex < s_ConcurrentLoggerThreadCount; ++threadIndex){
            writers[threadIndex].emplace(lambda[mut logger, mut startGate, mut activeWriters]() -> void{
                startGate.arrive_and_wait();
                for(u32 messageIndex = 0u; messageIndex < s_ConcurrentLoggerMessagesPerThread; ++messageIndex){
                    LogType kind = LogType::Info;
                    if((messageIndex & 1u) != 0u)
                        kind = LogType::Error;
                    EnqueueTestLog(logger, kind, PlatformTextLiteral("parallel logger message"));
                }
                activeWriters.fetch_sub(1u, MemoryOrder::release);
            });
        }

        startGate.arrive_and_wait();
        for(mut Optional<JoiningThread> writer : writers)
            writer.value().join();
        reader.join();

        sawInvalidObservation = invalidObservation.load(MemoryOrder::relaxed);
        observedMessageTotal = observedMessages.load(MemoryOrder::relaxed);
        observedErrorTotal = observedErrors.load(MemoryOrder::relaxed);
    }

    EXPECT_FALSE(sawInvalidObservation);
    EXPECT_GT(observedMessageTotal, 0u);
    EXPECT_GT(observedErrorTotal, 0u);
    EXPECT_EQ(logger.messageCount(), s_ConcurrentLoggerExpectedMessages);
    EXPECT_EQ(logger.errorCount(), s_ConcurrentLoggerExpectedErrors);
    EXPECT_TRUE(SawCapturedMessage(logger, s_ParallelLoggerMessageText));
    EXPECT_TRUE(SawCapturedError(logger, s_ParallelLoggerMessageText));
}

void RegisterCallbackLogger(mut Optional<LoggerRegistrationGuard> guard, mut CallbackUnregisterLogger logger){
    guard.emplace(logger, LoggerBreakPolicy::ReportOnly);
}

void VerifyCommonLoggingBoundaries_GuardTeardownInsideEnqueueWaitsForOtherReaderWithoutSelfDeadlock(){
    CapturingLogger baseLogger = CapturingLogger();
    LoggerRegistrationGuard baseGuard(baseLogger, LoggerBreakPolicy::ReportOnly);
    b8 nestedGuardStillPresent = false;
    b8 unregistrationReturnedEarly = false;
    u32 totalCallbacks = 0u;

    {
        Optional<LoggerRegistrationGuard> nestedGuard;
        Latch bothEnteredGate(2u);
        TestAtomic<b8> unregistrationStarted(false);
        TestAtomic<b8> peerStillInCallback(true);
        TestAtomic<b8> unregistrationReturnedWhilePeerActive(false);
        TestAtomic<u32> callbackCount(0u);

        CallbackUnregisterLogger callbackLogger(
            nestedGuard,
            bothEnteredGate,
            unregistrationStarted,
            peerStillInCallback,
            unregistrationReturnedWhilePeerActive,
            callbackCount
        );
        RegisterCallbackLogger(nestedGuard, callbackLogger);

        JoiningThread selfUnregisterThread(lambda[]() -> void{
            WriteErrorLog(PlatformTextLiteral("self-unregister"));
        });
        JoiningThread peerReaderThread(lambda[]() -> void{
            WriteErrorLog(PlatformTextLiteral("peer-reader"));
        });

        selfUnregisterThread.join();
        peerReaderThread.join();

        nestedGuardStillPresent = nestedGuard.has_value();
        unregistrationReturnedEarly = unregistrationReturnedWhilePeerActive.load(MemoryOrder::relaxed);
        totalCallbacks = callbackCount.load(MemoryOrder::relaxed);
    }

    EXPECT_FALSE(nestedGuardStillPresent);
    EXPECT_FALSE(unregistrationReturnedEarly);
    EXPECT_EQ(totalCallbacks, 2u);
    EXPECT_EQ(baseLogger.messageCount(), 1u);
    EXPECT_TRUE(SawCapturedMessage(baseLogger, "routed-to-base-after-self-unregister"));
}

