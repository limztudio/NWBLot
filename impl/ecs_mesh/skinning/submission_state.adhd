////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> RuntimeStorageDescriptorSlot{
    RestPosition = 0u,
    SkinnedPosition,
    RestNormal,
    SkinnedNormal,
    RestTangent,
    SkinnedTangent,
    MeshletDesc,
    PositionRefDeltas,
    AttributeRefDeltas,
    AttributeSkins,
    LocalVertexRefs,
    PrimitiveIndices,
    MeshletBounds,
    MeshletLocalBounds,
    LocalBounds,
    SkinInfluences,
    JointPalette,
    AttributeBuffer,
    kCount
}

// Captures CPU state true only when the producing command list was accepted.
[serialize, reflect]
class MeshSkinningSubmissionCommit{
    public u32 editRevision = 0u;
    public b8 bindlessResourceSlotsUploadRecorded = false;
    public RuntimeMeshDirtyFlag handledDirtyFlags = RuntimeMeshDirtyFlag::None;
}

// Mirrors bindless resources: five uint4 lanes; handles are StorageBuffer registrations.
[serialize, reflect]
class MeshSkinningBindlessResourceSlots{
    public b8 operator==(in MeshSkinningBindlessResourceSlots rhs)const{
        return
            this.restPosition == rhs.restPosition
            && this.skinnedPosition == rhs.skinnedPosition
            && this.restNormal == rhs.restNormal
            && this.skinnedNormal == rhs.skinnedNormal
            && this.restTangent == rhs.restTangent
            && this.skinnedTangent == rhs.skinnedTangent
            && this.meshletDesc == rhs.meshletDesc
            && this.positionRefDeltas == rhs.positionRefDeltas
            && this.attributeRefDeltas == rhs.attributeRefDeltas
            && this.attributeSkins == rhs.attributeSkins
            && this.skinInfluences == rhs.skinInfluences
            && this.jointPalette == rhs.jointPalette
            && this.localVertexRefs == rhs.localVertexRefs
            && this.primitiveIndices == rhs.primitiveIndices
            && this.meshletBounds == rhs.meshletBounds
            && this.attributeBuffer == rhs.attributeBuffer
            && this.meshletLocalBounds == rhs.meshletLocalBounds
            && this.localBounds == rhs.localBounds
            && this.reserved0 == rhs.reserved0
            && this.reserved1 == rhs.reserved1
        ;
    }

    public u32 restPosition = 0u;
    public u32 skinnedPosition = 0u;
    public u32 restNormal = 0u;
    public u32 skinnedNormal = 0u;
    public u32 restTangent = 0u;
    public u32 skinnedTangent = 0u;
    public u32 meshletDesc = 0u;
    public u32 positionRefDeltas = 0u;
    public u32 attributeRefDeltas = 0u;
    public u32 attributeSkins = 0u;
    public u32 skinInfluences = 0u;
    public u32 jointPalette = 0u;
    public u32 localVertexRefs = 0u;
    public u32 primitiveIndices = 0u;
    public u32 meshletBounds = 0u;
    public u32 attributeBuffer = 0u;
    public u32 meshletLocalBounds = 0u;
    public u32 localBounds = 0u;
    public u32 reserved0 = 0u;
    public u32 reserved1 = 0u;
}

[serialize, reflect]
class MeshSkinningPushConstants{
    public u32 meshletCount = 0u;
    public u32 skinCount = 0u;
    public u32 jointCount = 0u;
    public u32 skinningMode = cast<u32>(SkeletonSkinningMode::LinearBlend);
    // UniformBuffer heap slot for MeshSkinningBindlessResourceSlots.
    public u32 bindlessResourceSlots = 0u;
}

[serialize, reflect]
class MeshletBoundsPushConstants{
    public u32 meshletCount = 0u;
    public u32 bindlessResourceSlots = 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void ApplyMeshSkinningSubmissionCommit(in b8 submissionAccepted, in u32 currentEditRevision, in MeshSkinningSubmissionCommit commit, mut RuntimeMeshDirtyFlag inOutDirtyFlags, mut b8 inOutBindlessResourceSlotsUploaded){
    if(!submissionAccepted || currentEditRevision != commit.editRevision)
        return;

    inOutDirtyFlags &= ~commit.handledDirtyFlags;
    if(commit.bindlessResourceSlotsUploadRecorded)
        inOutBindlessResourceSlotsUploaded = true;
}

MeshSkinningPushConstants MakeMeshSkinningPushConstants(in u32 meshletCount, in u32 skinCount, in u32 jointCount, in u32 skinningMode, in u32 bindlessResourceSlots){
    MeshSkinningPushConstants out;
    out.meshletCount = meshletCount;
    out.skinCount = skinCount;
    out.jointCount = jointCount;
    out.skinningMode = skinningMode;
    out.bindlessResourceSlots = bindlessResourceSlots;
    return out;
}

MeshletBoundsPushConstants MakeMeshletBoundsPushConstants(in u32 meshletCount, in u32 bindlessResourceSlots){
    MeshletBoundsPushConstants out;
    out.meshletCount = meshletCount;
    out.bindlessResourceSlots = bindlessResourceSlots;
    return out;
}

b8 EqualSkeletonJointMatrixSpan(in Span<SkeletonJointMatrix> lhs, in Span<SkeletonJointMatrix> rhs){
    if(lhs.size() != rhs.size())
        return false;
    for(usize i = 0u; i < lhs.size(); ++i){
        const MatrixSingle a(lhs[i]);
        const MatrixSingle b(rhs[i]);
        for(u32 row = 0u; row < s_SkeletonJointMatrixRowCount; ++row){
            if(!equalF32x4Bits(a[row], b[row]))
                return false;
        }
    }
    return true;
}

b8 CanStageMeshSkinningDeformationCandidate(in b8 hasResourceSlotsBuffer, in usize jointCount, in b8 hasJointData, in u64 candidateSerial, in u64 acceptedRevision){
    return
        hasResourceSlotsBuffer
        && (jointCount == 0u || hasJointData)
        && jointCount <= s_MaxSkeletonJointMatrixSpanCount
        && candidateSerial != u64.max
        && acceptedRevision != u64.max
    ;
}

b8 CanReuseMeshSkinningDeformationState(
    in b8 inputDirty,
    in u64 acceptedRevision,
    in b8 sameResourceSlotsBuffer,
    in u32 editRevision,
    in u32 acceptedEditRevision,
    in u32 skinningMode,
    in u32 acceptedSkinningMode,
    in b8 hasJointData,
    in Span<SkeletonJointMatrix> joints,
    in Span<SkeletonJointMatrix> acceptedJoints
){
    if(
        inputDirty
        || acceptedRevision == 0u
        || !sameResourceSlotsBuffer
        || editRevision != acceptedEditRevision
        || skinningMode != acceptedSkinningMode
        || joints.size() != acceptedJoints.size()
        || (!joints.empty() && !hasJointData)
    )
        return false;
    return EqualSkeletonJointMatrixSpan(joints, acceptedJoints);
}

Expected<u64> TryStageMeshSkinningDeformationCandidate(
    in b8 hasResourceSlotsBuffer,
    in Span<SkeletonJointMatrix> joints,
    in b8 hasJointData,
    in u64 acceptedRevision,
    mut u64 inoutCandidateSerial,
    mut Vector<SkeletonJointMatrix> outPendingJoints
){
    if(!CanStageMeshSkinningDeformationCandidate(hasResourceSlotsBuffer, joints.size(), hasJointData, inoutCandidateSerial, acceptedRevision)){
        error("MeshSkinningDeformationState: invalid or exhausted deformation candidate");
        return makeUnexpected(Failure());
    }
    outPendingJoints.clear();
    if(!joints.empty()){
        outPendingJoints.reserve(joints.size());
        for(in SkeletonJointMatrix joint : joints)
            outPendingJoints.push_back(joint);
    }
    ++inoutCandidateSerial;
    return inoutCandidateSerial;
}

b8 TryAcceptMeshSkinningDeformationCandidate(in u64 candidate, mut u64 inoutPendingCandidate, mut u64 inoutAcceptedRevision, mut b8 outCurrent){
    if(candidate == 0u || candidate != inoutPendingCandidate)
        return false;
    ++inoutAcceptedRevision;
    inoutPendingCandidate = 0u;
    outCurrent = true;
    return true;
}

b8 NeedsMeshSkinningRuntimeResourcesRebuild(
    in b8 inserted,
    in b8 sameBuffers,
    in u32 existingEditRevision,
    in u32 instanceEditRevision,
    in u32 existingPositionCount,
    in u32 positionCount,
    in u32 existingAttributeCount,
    in u32 attributeCount,
    in u32 existingMeshletCount,
    in u32 meshletCount,
    in u32 existingSkinCount,
    in u32 skinCount,
    in u32 existingJointCount,
    in u32 jointCount,
    in b8 hasPersistentHeapDescriptors,
    in b8 hasSkinPayload,
    in b8 hasSkinBuffers
){
    return
        inserted
        || !sameBuffers
        || existingEditRevision != instanceEditRevision
        || existingPositionCount != positionCount
        || existingAttributeCount != attributeCount
        || existingMeshletCount != meshletCount
        || existingSkinCount != skinCount
        || existingJointCount != jointCount
        || !hasPersistentHeapDescriptors
        || (hasSkinPayload && !hasSkinBuffers)
    ;
}

b8 ValidateMeshSkinningLocalBoundsMeshletCount(in usize meshletCount, in u32 boundsByteSize){
    if(meshletCount == 0u || meshletCount > cast<usize>(u32.max / boundsByteSize)){
        error("MeshSkinningSystem: runtime local bounds partial count is empty or exceeds shader addressing");
        return false;
    }
    return true;
}

RuntimeMeshDirtyFlag ResolveHandledSkinningDirtyFlags(in b8 skinningInputDirty, in b8 meshletBoundsDirty){
    RuntimeMeshDirtyFlag flags = RuntimeMeshDirtyFlag::None;
    if(skinningInputDirty)
        flags |= RuntimeMeshDirtyFlag::SkinningInputDirty;
    if(meshletBoundsDirty)
        flags |= RuntimeMeshDirtyFlag::MeshletBoundsDirty;
    return flags;
}


