void VerifyCpuTaskSchedulerTests_WorkerSelfWaitIsRejectedInsteadOfDeadlocking(){
    native{
        EXPECT_DEATH({
            using namespace CpuTaskSchedulerTestSupport;
            DeadlineGuard deadline(true);
            TaskGate start;
            CpuTaskScheduler scheduler(HomogeneousWorkers(1u));
            CpuTaskHandle self;
            const auto selfTaskAdmission = scheduler.submit([&]() { start.block(); scheduler.wait(self); });
            if(!selfTaskAdmission)
                ExitTestProcess(0u);
            self = *selfTaskAdmission;
            start.open();
            scheduler.wait();
        }, "");
    }
}

void VerifyCpuTaskSchedulerTests_DescendantWaitForAnAncestorIsRejectedInsteadOfDeadlocking(){
    native{
        EXPECT_DEATH({
            using namespace CpuTaskSchedulerTestSupport;
            DeadlineGuard deadline(true);
            TaskGate start;
            CpuTaskScheduler scheduler(HomogeneousWorkers(1u));
            CpuTaskHandle parent;
            const auto cpuTaskAdmission = scheduler.submit([&]() {
                start.block();
                const auto childTaskAdmission = scheduler.submit([&]() { scheduler.wait(parent); });
                if(!childTaskAdmission)
                    ExitTestProcess(0u);
                const auto child = *childTaskAdmission;
                EXPECT_TRUE(child.valid());
            });
            if(!cpuTaskAdmission)
                ExitTestProcess(0u);
            parent = *cpuTaskAdmission;
            start.open();
            scheduler.wait();
        }, "");
    }
}

void VerifyCpuTaskSchedulerTests_JoiningTheScopeThatContainsTheCurrentTaskIsRejected(){
    native{
