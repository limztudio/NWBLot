const u32 s_PackageReadyTimeoutMS = 3000u;
const StringView s_SpoolDirectory = "spool";
const StringView s_ApplicationVersion = "1";
const StringView s_Crash001 = "crash-001";
const StringView s_Crash002 = "crash-002";
const StringView s_Crash003 = "crash-003";
const StringView s_CrashTests = "crash_tests";
const StringView s_Test = "test";

const Name s_OperationScratch = s_CrashTestNameTestsIntegrationCrashOperationScratch;
const Name s_InstallArena = s_CrashTestNameTestsIntegrationCrashInstall;
const Name s_SignalChildInstallArena = s_CrashTestNameTestsIntegrationCrashSignalChildInstall;
const Name s_ArchiveFixtureArena = s_CrashTestNameTestsIntegrationCrashArchiveUpload;
const Name s_ArchiveOperationScratch = s_CrashTestNameTestsIntegrationCrashArchiveUploadScratch;

Path BucketDirectory(in StringView testGroup, in StringView bucketName){
    return SpoolDirectory(testGroup) / bucketName;
}

Path PackageDirectory(in StringView testGroup, in StringView bucketName, in StringView packageName){
    return BucketDirectory(testGroup, bucketName) / packageName;
}

b8 CreatePackageDirectory(in StringView testGroup, in StringView bucketName, in StringView packageName){
    const Path packageDirectory = PackageDirectory(testGroup, bucketName, packageName);
    if(!EnsureDirectories(packageDirectory).has_value())
        return false;
    return WriteTextFile(packageDirectory / "marker.txt", "package");
}

void FillPackageRequest(in Path spoolDirectory, in StringView crashId, mut CrashRequest request){
    request = CrashRequest();
    request.platform = CurrentCrashPlatformKind();
    request.reasonKind = s_ManualDumpCrashReasonKind;
    request.processId = CurrentProcessId();
    request.threadId = CurrentThreadId();
    CopyFixedBuffer(request.crashId, crashId);
    CopyFixedBuffer(request.applicationName, s_CrashTests);
    CopyFixedBuffer(request.versionText, s_ApplicationVersion);
    CopyFixedBuffer(request.buildId, s_Test);
    CopyFixedBuffer(request.abi, CurrentAbiName());
    CopyFixedBuffer(request.spoolDirectory, PathToString(spoolDirectory));
}

void ExpectPathExists(in Path path, in b8 expected){
    const Expected<b8, ErrorCode> query = FileExists(path);
    ASSERT_TRUE(query.has_value());
    EXPECT_EQ(query.value(), expected);
}

void ExpectIsDirectory(in Path path, in b8 expected){
    const Expected<b8, ErrorCode> query = IsDirectory(path);
    ASSERT_TRUE(query.has_value());
    EXPECT_EQ(query.value(), expected);
}

void ExpectIsRegularFile(in Path path, in b8 expected){
    const Expected<b8, ErrorCode> query = IsRegularFile(path);
    ASSERT_TRUE(query.has_value());
    EXPECT_EQ(query.value(), expected);
}

void ExpectDirectoryReady(in Path path, in u32 timeoutMs){
    const Expected<b8, ErrorCode> ready = WaitForDirectory(path, timeoutMs);
    ASSERT_TRUE(ready.has_value());
    EXPECT_TRUE(ready.value());
}

b8 IsWindowsCrashPlatform(){
    return CurrentCrashPlatformKind() == s_WindowsCrashPlatform;
}

b8 IsDesktopLinuxCrashPlatform(){
    return s_IsDesktopLinuxCrashPlatform;
}

b8 IsDesktopCrashPlatform(){
    return IsWindowsCrashPlatform() || IsDesktopLinuxCrashPlatform();
}

String FormatProcessGroup(in StringView prefix){
    return StringFormat("{}{}", prefix, CurrentProcessId());
}

Expected<CrashBytes, ErrorCode> BuildCrashArchiveInTemporaryScratch(mut GlobalArena arena, in Path root){
    CrashArchiveScratch temporaryScratch = CrashArchiveScratch();
    return CrashPackageArchive::Build(arena, temporaryScratch.scratch, root);
}

b8 BytesStartWith(in CrashBytes bytes, in StringView needle){
    if(bytes.size() < needle.size())
        return false;
    for(usize index = 0u; index < needle.size(); ++index){
        if(bytes[index] != needle[index])
            return false;
    }
    return true;
}

b8 BytesContain(in CrashBytes bytes, in StringView needle){
    if(needle.empty())
        return true;
    if(bytes.size() < needle.size())
        return false;
    const usize limit = bytes.size() - needle.size();
    for(usize start = 0u; start <= limit; ++start){
        b8 matched = true;
        for(usize index = 0u; index < needle.size(); ++index){
            if(bytes[start + index] != needle[index]){
                matched = false;
                break;
            }
        }
        if(matched)
            return true;
    }
    return false;
}

void VerifyCrashArchiveUpload_PreservesNativeMissingDirectoryError(mut CrashArchiveUpload self){
    const Path missing = self.m_root / "missing";
    const Expected<CrashDirectoryIterator, ErrorCode> nativeDirectory = CrashDirectoryIterator::Create(missing);
    ASSERT_FALSE(nativeDirectory.has_value());
    const Expected<CrashBytes, ErrorCode> archive = CrashPackageArchive::Build(self.m_arena, self.m_scratch, missing);
    ASSERT_FALSE(archive.has_value());
    EXPECT_EQ(archive.error(), nativeDirectory.error());
}

void VerifyCrashArchiveUpload_ResultOwnsBytesAfterWorkingScratchExpires(mut CrashArchiveUpload self){
    const Path payloadPath = self.m_root / "payload.txt";
    ASSERT_TRUE(WriteTextFile(payloadPath, "payload survives scratch"));
    const Expected<CrashBytes, ErrorCode> archiveResult = BuildCrashArchiveInTemporaryScratch(self.m_arena, self.m_root);
    ASSERT_TRUE(archiveResult.has_value());
    const CrashBytes archive = archiveResult.value();
    EXPECT_TRUE(BytesStartWith(archive, s_ArchiveHeaderText));
    EXPECT_TRUE(BytesContain(archive, "payload.txt"));
    EXPECT_TRUE(BytesContain(archive, "payload survives scratch"));
}

void VerifyCrashArchiveUpload_UnsupportedProtocolPreservesFailureAndPendingRetry(mut CrashArchiveUpload self){
    const StringView crashId = "crash-unsupported-protocol";
    const Path spoolDirectory = self.m_root / "spool";
    const Path pending = spoolDirectory / s_PendingBucket / crashId;
    ASSERT_TRUE(EnsureDirectories(pending).has_value());
    ASSERT_TRUE(WriteTextFile(pending / "marker.txt", "package"));
    CrashUploadSnapshot snapshot = CrashUploadSnapshot();
    CopyFixedBuffer(snapshot.spoolDirectory, PathToString(spoolDirectory));
    CopyFixedBuffer(snapshot.logServerUrl, "nwb-unsupported://local");
    UninstallCrashHandler();
    native(mut self, in snapshot){
        const auto previousCallback = DiagnosticDetail::g_EventCallback.exchange(ObserveUploadDiagnostic, MemoryOrder::acq_rel);
        ScopeExit restoreCallback([previousCallback]()noexcept{ SetDiagnosticEventCallback(previousCallback); });
        s_UploadDiagnostics = 0u;
        EXPECT_FALSE(FlushPendingCrashReportsImpl(self.m_arena, snapshot));
        EXPECT_EQ(s_UploadDiagnostics, 1u);
        EXPECT_EQ(FixedBufferView(s_LastUploadOperation), AStringView("perform_upload"));
        EXPECT_NE(FixedBufferView(s_LastUploadDiagnostic).find("curl code="), AStringView::npos);
    }
    ExpectIsDirectory(pending, true);
    ExpectIsDirectory(spoolDirectory / s_UploadingBucket / crashId, false);
    EXPECT_TRUE(TextFileContains(pending / s_UploadAttemptFileName, s_RetryPendingState));
}

void VerifyCrash_RequestAdmissionRejectsCorruptCountsAndUnterminatedText(){
    CrashRequest request = CrashRequest();
    CopyFixedBuffer(request.crashId, "crash-1-1");
    ASSERT_TRUE(CrashProtocol::IsCurrentCrashRequest(request));

    request.metadataCount = s_MaxCrashMetadata + 1u;
    EXPECT_FALSE(CrashProtocol::IsCurrentCrashRequest(request));
    request.metadataCount = 1u;
    request.breadcrumbCount = s_MaxCrashBreadcrumbs + 1u;
    EXPECT_FALSE(CrashProtocol::IsCurrentCrashRequest(request));
    request.breadcrumbCount = 1u;
    request.callstackFrameCount = s_MaxCrashCallstackFrames + 1u;
    EXPECT_FALSE(CrashProtocol::IsCurrentCrashRequest(request));
    request.callstackFrameCount = 0u;

    native(mut request){
        const auto rejectUnterminated = [&request](auto& text){
            const auto original = text;
            text.fill('x');
            EXPECT_FALSE(CrashProtocol::IsCurrentCrashRequest(request));
            text = original;
        };
        rejectUnterminated(request.crashId);
        rejectUnterminated(request.applicationName);
        rejectUnterminated(request.versionText);
        rejectUnterminated(request.buildId);
        rejectUnterminated(request.abi);
        rejectUnterminated(request.spoolDirectory);
        rejectUnterminated(request.logServerUrl);
        rejectUnterminated(request.crashUploadToken);
        rejectUnterminated(request.event);
        rejectUnterminated(request.triggerCategory);
        rejectUnterminated(request.triggerExpression);
        rejectUnterminated(request.triggerMessage);
        rejectUnterminated(request.triggerFile);
        rejectUnterminated(request.metadata[0u].key);
        rejectUnterminated(request.metadata[0u].value);
        rejectUnterminated(request.breadcrumbs[0u].category);
        rejectUnterminated(request.breadcrumbs[0u].message);
    }
    EXPECT_TRUE(CrashProtocol::IsCurrentCrashRequest(request));
    CopyFixedBuffer(request.crashId, "../outside");
    EXPECT_FALSE(CrashProtocol::IsCurrentCrashRequest(request));
    CopyFixedBuffer(request.crashId, "..\\outside");
    EXPECT_FALSE(CrashProtocol::IsCurrentCrashRequest(request));
}

void VerifyCrash_AckAdmissionRequiresBoundedTerminatedIdentity(){
    CrashRequest request = CrashRequest();
    CrashAck ack = CrashAck();
    CopyFixedBuffer(request.crashId, "crash-1-1");
    CopyFixedBuffer(ack.crashId, "crash-1-1");
    EXPECT_TRUE(CrashProtocol::CrashAckMatchesRequest(ack, request));
    ack.packageWritten = 2u;
    EXPECT_FALSE(CrashProtocol::CrashAckMatchesRequest(ack, request));
    ack.packageWritten = 0u;
    ack.crashId.fill(120);
    EXPECT_FALSE(CrashProtocol::CrashAckMatchesRequest(ack, request));
    request.crashId.fill(120);
    EXPECT_FALSE(CrashProtocol::CrashAckMatchesRequest(ack, request));
}

void VerifyCrash_InstallRejectsUnrepresentableConfigurationBeforeCreatingSpool(){
    if(!IsWindowsCrashPlatform())
        return;

    Vector<StringView> casePrefixes = Vector<StringView>();
    casePrefixes.reserve(5u);
    casePrefixes.push_back("crash_install_text_");
    casePrefixes.push_back("crash_install_path_");
    casePrefixes.push_back("crash_install_nul_");
    casePrefixes.push_back("crash_install_path_nul_");
    casePrefixes.push_back("crash_install_handler_nul_");

    for(usize caseIndex = 0u; caseIndex < casePrefixes.size(); ++caseIndex){
        const String group = FormatProcessGroup(casePrefixes[caseIndex]);
        const Path root = TestCaseDirectory(group);
        ExpectIsDirectory(root, false);
        const Path spool = SpoolDirectory(group);
        b8 installed = true;
        native(in caseIndex, in spool, mut installed){
#if defined(FOUNDATION_PLATFORM_WINDOWS)
            PersistentArena installArena(s_InstallArena, PersistentArena::StructureAlignedSize(64u * 1024u));
            Core::Crash::CrashConfig config(installArena);
            config.applicationName = s_CrashTests;
            config.spoolDirectory = spool;
            Array<char, Core::Crash::CrashDetail::s_MaxUrlText> longUrl;
            longUrl.fill('u');
            Array<char, 96u> segment;
            segment.fill('p');
            const Array<char, 3u> embedded{ 'a', '\0', 'b' };
            if(caseIndex == 0u)
                config.logServerUrl = AStringView(longUrl.data(), longUrl.size());
            else if(caseIndex == 1u){
                for(u32 i = 0u; i < 12u; ++i)
                    config.spoolDirectory /= AStringView(segment.data(), segment.size());
            }
            else if(caseIndex == 2u)
                config.applicationName = AStringView(embedded.data(), embedded.size());
            else if(caseIndex == 3u)
                config.spoolDirectory /= AStringView(embedded.data(), embedded.size());
            else
                config.handlerExecutablePath = AStringView(embedded.data(), embedded.size());
            installed = Core::Crash::InstallCrashHandler(config);
#endif
        }
        if(installed)
            UninstallCrashHandler();
        EXPECT_FALSE(installed);
        ExpectIsDirectory(root, false);
    }
}

void VerifyCrash_AttachmentFailureDoesNotClaimTheHandlerAcceptedARequest(){
    if(!IsWindowsCrashPlatform())
        return;

    CrashTestArena testArena = CrashTestArena();
    const String group = FormatProcessGroup("crash_attachment_admission_");
    const StringView groupView = group;
    ExpectIsDirectory(TestCaseDirectory(groupView), false);
    const Path spool = SpoolDirectory(groupView);
    b8 attachmentRejected = false;
    b8 handlerAcceptedFailure = false;
    native(in groupView, in spool, mut testArena, mut attachmentRejected, mut handlerAcceptedFailure){
#if defined(FOUNDATION_PLATFORM_WINDOWS)
        PersistentArena installArena(s_InstallArena, PersistentArena::StructureAlignedSize(64u * 1024u));
        Core::Crash::CrashConfig config(installArena);
        config.applicationName = s_CrashTests;
        config.spoolDirectory = spool;
        ASSERT_TRUE(Core::Crash::InstallCrashHandler(config));
        ScopeExit uninstall([]()noexcept{ UninstallCrashHandler(); });

        const auto noDumpKind = Core::Crash::CaptureGpuCrashDump("report", "binary", Core::Crash::GpuCrashDumpKind::None);
        EXPECT_EQ(noDumpKind.status, Core::Crash::CrashDumpStatus::RequestFailed);
        EXPECT_FALSE(noDumpKind.requestAccepted());
        const auto invalidDumpKind = Core::Crash::CaptureGpuCrashDump("report", "binary", static_cast<Core::Crash::GpuCrashDumpKind::Enum>(255u));
        EXPECT_EQ(invalidDumpKind.status, Core::Crash::CrashDumpStatus::RequestFailed);
        EXPECT_FALSE(invalidDumpKind.requestAccepted());
        const Array<Core::Crash::GpuCrashDumpKind::Enum, 2u> kinds{ Core::Crash::GpuCrashDumpKind::Aftermath, Core::Crash::GpuCrashDumpKind::RadeonGpuDetective };
        const Array<AStringView, 2u> names{ CrashNames::s_AftermathGpuDumpFileName, CrashNames::s_GpuDetectiveCaptureFileName };
        const Array<u8, 4u> binary{ 0x61u, 0x00u, 0x62u, 0xffu };
        for(usize index = 0u; index < kinds.size(); ++index){
            Array<char, Core::Crash::CrashDetail::s_MaxShortText> crashId = {};
            const u64 sequence = Core::Crash::CrashDetail::g_State.crashSequence.load(MemoryOrder::relaxed);
            BuildCrashIdForProcess(CurrentProcessId(), sequence, crashId);
            const auto captured = Core::Crash::CaptureGpuCrashDump("report", AStringView(reinterpret_cast<const char*>(binary.data()), binary.size()), kinds[index]);
            ASSERT_TRUE(captured.packageWritten());
            Vector<u8, ScratchArena> data(testArena.scratchArena);
            ASSERT_TRUE(ReadBinaryFile(PackageDirectory(groupView, CrashNames::s_PendingDirectoryName, FixedBufferView(crashId)) / names[index], data));
            ASSERT_EQ(data.size(), binary.size());
            for(usize byte = 0u; byte < binary.size(); ++byte)
                EXPECT_EQ(data[byte], binary[byte]);
        }

        ASSERT_TRUE(Core::Crash::SetCrashUploadDestination("http://localhost", "token"));
        Array<char, Core::Crash::CrashDetail::s_MaxUrlText> longUrl;
        longUrl.fill('u');
        Array<char, Core::Crash::CrashDetail::s_MaxMediumText> longToken;
        longToken.fill('t');
        const Array<char, 3u> embedded{ 'a', '\0', 'b' };
        ASSERT_TRUE(Core::Crash::SetCrashUploadDestination(AStringView(longUrl.data(), longUrl.size() - 1u), AStringView(longToken.data(), longToken.size() - 1u)));
        ASSERT_TRUE(Core::Crash::SetCrashUploadDestination("http://localhost", "token"));
        EXPECT_FALSE(Core::Crash::SetCrashUploadDestination(AStringView(longUrl.data(), longUrl.size()), "new"));
        EXPECT_FALSE(Core::Crash::SetCrashUploadDestination("new", AStringView(longToken.data(), longToken.size())));
        EXPECT_FALSE(Core::Crash::SetCrashUploadDestination(AStringView(embedded.data(), embedded.size()), "new"));
        const auto snapshot = Core::Crash::CrashDetail::BuildCrashDumpRequest(Core::Crash::CrashDetail::CrashReasonKind::ManualDump, 0u, {});
        EXPECT_EQ(FixedBufferView(snapshot.logServerUrl), AStringView("http://localhost"));
        EXPECT_EQ(FixedBufferView(snapshot.crashUploadToken), AStringView("token"));

        const auto blockNextPackage = [&](){
            Array<char, Core::Crash::CrashDetail::s_MaxShortText> crashId = {};
            const u64 sequence = Core::Crash::CrashDetail::g_State.crashSequence.load(MemoryOrder::relaxed);
            BuildCrashIdForProcess(CurrentProcessId(), sequence, crashId);
            return WriteTextFile(PackageDirectory(groupView, CrashNames::s_PendingDirectoryName, FixedBufferView(crashId)), AStringView("block package directory"));
        };
        ASSERT_TRUE(blockNextPackage());
        const auto attachmentFailure = Core::Crash::CaptureGpuCrashDump("gpu report", {}, Core::Crash::GpuCrashDumpKind::None);
        EXPECT_EQ(attachmentFailure.status, Core::Crash::CrashDumpStatus::AttachmentWriteFailed);
        attachmentRejected = !attachmentFailure.requestAccepted();

        ASSERT_TRUE(blockNextPackage());
        const auto handlerFailure = Core::Crash::CaptureCrashDump("manual", "blocked handler package");
        EXPECT_EQ(handlerFailure.status, Core::Crash::CrashDumpStatus::PackageWriteFailed);
        handlerAcceptedFailure = handlerFailure.requestAccepted();
#endif
    }
    EXPECT_TRUE(attachmentRejected);
    EXPECT_TRUE(handlerAcceptedFailure);
}

void VerifyCrash_ConcurrentManualCaptureDoesNotClaimAnUnsentRequestWasQueued(){
    if(!IsWindowsCrashPlatform())
        return;

    const String group = FormatProcessGroup("crash_manual_contention_");
    const StringView groupView = group;
    ExpectIsDirectory(TestCaseDirectory(groupView), false);
    const Path spool = SpoolDirectory(groupView);
    b8 active = false;
    b8 firstWritten = false;
    b8 secondRejected = false;
    u32 suppressedBefore = 0u;
    u32 suppressedWhileBusy = 0u;
    u32 suppressedAfter = 0u;
    b8 consumedSuppressed = false;
    native(in spool, mut active, mut firstWritten, mut secondRejected, mut suppressedBefore, mut suppressedWhileBusy, mut suppressedAfter, mut consumedSuppressed){
#if defined(FOUNDATION_PLATFORM_WINDOWS)
        PersistentArena installArena(s_InstallArena, PersistentArena::StructureAlignedSize(64u * 1024u));
        Core::Crash::CrashConfig config(installArena);
        config.applicationName = s_CrashTests;
        config.spoolDirectory = spool;
        ASSERT_TRUE(Core::Crash::InstallCrashHandler(config));
        ScopeExit uninstall([]()noexcept{ UninstallCrashHandler(); });

        const HANDLE handlerThread = Core::Crash::CrashDetail::g_State.handlerProcessInfo.hThread;
        ASSERT_NE(handlerThread, nullptr);
        const DWORD previousSuspendCount = SuspendThread(handlerThread);
        ASSERT_NE(previousSuspendCount, static_cast<DWORD>(-1));
        ScopeExit resume([handlerThread]()noexcept{
            if(ResumeThread(handlerThread) == static_cast<DWORD>(-1))
                TerminateInvariant();
        });
        ASSERT_EQ(previousSuspendCount, 0u);
        Core::Crash::CrashDumpResult first;
        JoiningThread writer([&](){ first = Core::Crash::CaptureCrashDump("first", "held in transport"); });
        for(u32 attempt = 0u; attempt < 2000u && Core::Crash::CrashDetail::g_State.transportInFlight.load(MemoryOrder::acquire) == 0u; ++attempt)
            SleepMS(1u);
        active = Core::Crash::CrashDetail::g_State.transportInFlight.load(MemoryOrder::acquire) != 0u;
        Core::Crash::CrashDumpResult second;
        suppressedBefore = Core::Crash::CrashDetail::g_State.suppressedPlatformCrashCaptures.load(MemoryOrder::acquire);
        if(active){
            second = Core::Crash::CaptureCrashDump("second", "transport already owned");
            CaptureDiagnosticEvent(DiagnosticEventRecord{ .event = DiagnosticEventName::s_Fatal, .category = "contention", .message = "not sent", .terminatesProcess = true });
        }
        suppressedWhileBusy = Core::Crash::CrashDetail::g_State.suppressedPlatformCrashCaptures.load(MemoryOrder::acquire);
        const DWORD resumeResult = ResumeThread(handlerThread);
        resume.release();
        writer.join();
        ASSERT_NE(resumeResult, static_cast<DWORD>(-1));
        firstWritten = first.packageWritten();
        secondRejected = second.status == Core::Crash::CrashDumpStatus::RequestFailed && !second.requestAccepted();
        CaptureDiagnosticEvent(DiagnosticEventRecord{ .event = DiagnosticEventName::s_Fatal, .category = "available", .message = "sent", .terminatesProcess = true });
        suppressedAfter = Core::Crash::CrashDetail::g_State.suppressedPlatformCrashCaptures.load(MemoryOrder::acquire);
        consumedSuppressed = Core::Crash::CrashDetail::TryConsumeSuppressedPlatformCrashCapture();
#endif
    }
    ASSERT_TRUE(active);
    EXPECT_TRUE(firstWritten);
    EXPECT_TRUE(secondRejected);
    EXPECT_EQ(suppressedWhileBusy, suppressedBefore);
    EXPECT_EQ(suppressedAfter, suppressedBefore + 1u);
    EXPECT_TRUE(consumedSuppressed);
}

void VerifyCrash_ManualContextTimeoutRetainsOwnedDumpAndReusableHandlerAfterSourceStorageExpires(){
    if(!IsWindowsCrashPlatform())
        return;

    CrashTestArena testArena = CrashTestArena();
    const StringView group = "crash_manual_owned_context_test";
    RemoveTestArtifacts(group);
    const Path spool = SpoolDirectory(group);
    String crashIdText = String();
    b8 reusableAfterTimeout = false;
    native(in spool, mut testArena, mut crashIdText, mut reusableAfterTimeout){
#if defined(FOUNDATION_PLATFORM_WINDOWS)
        CrashRequest request = {};
        PersistentArena installArena(s_InstallArena, PersistentArena::StructureAlignedSize(64u * 1024u));
        Core::Crash::CrashConfig config(installArena);
        config.applicationName = AStringView(s_CrashTests);
        config.spoolDirectory = spool;
        ASSERT_TRUE(Core::Crash::InstallCrashHandler(config));
        ScopeExit uninstall([]()noexcept{ UninstallCrashHandler(); });

        u32 capturedContextFlags = 0u;
        u64 capturedInstructionPointer = 0u;
        {
            Core::Crash::CrashDetail::ManualDumpContextStorage storage;
            Core::Crash::CrashDetail::CrashDumpRequestOptions options;
            Core::Crash::CrashDetail::CaptureManualDumpContext(options, storage);
            capturedContextFlags = storage.context.ContextFlags & ~Core::Crash::CrashDetail::s_WindowsExtendedContextFlag;
            capturedInstructionPointer = options.instructionPointer;
            auto sourceRequest = Core::Crash::CrashDetail::BuildCrashDumpRequest(Core::Crash::CrashDetail::CrashReasonKind::ManualDump, 0u, options);
            FOUNDATION_MEMCPY(&request, sizeof(request), &sourceRequest, sizeof(sourceRequest));
            sourceRequest = CrashRequest{};
            storage.context = CONTEXT{};
            storage.exceptionRecord = EXCEPTION_RECORD{};
            storage.exceptionPointers = EXCEPTION_POINTERS{};
        }
        ASSERT_TRUE(CrashProtocol::IsCurrentCrashRequest(request));
        EXPECT_EQ(request.exceptionPointers, 0u);
        EXPECT_EQ(request.manualContext.ContextFlags, capturedContextFlags);
        EXPECT_NE(capturedContextFlags, 0u);
        Core::Crash::CrashDetail::ManualDumpContextStorage handlerStorage(request);
        EXPECT_EQ(handlerStorage.exceptionPointers.ContextRecord, &handlerStorage.context);
        EXPECT_EQ(handlerStorage.exceptionPointers.ExceptionRecord, &handlerStorage.exceptionRecord);
        EXPECT_EQ(handlerStorage.exceptionRecord.ExceptionRecord, nullptr);
        EXPECT_EQ(handlerStorage.exceptionRecord.ExceptionAddress, reinterpret_cast<void*>(static_cast<usize>(capturedInstructionPointer)));

        const HANDLE handlerThread = Core::Crash::CrashDetail::g_State.handlerProcessInfo.hThread;
        ASSERT_NE(handlerThread, nullptr);
        const DWORD previousSuspendCount = SuspendThread(handlerThread);
        ASSERT_NE(previousSuspendCount, static_cast<DWORD>(-1));
        ScopeExit resume([handlerThread]()noexcept{
            if(ResumeThread(handlerThread) == static_cast<DWORD>(-1))
                TerminateInvariant();
        });
        ASSERT_EQ(previousSuspendCount, 0u);
        const auto transport = Core::Crash::CrashDetail::RequestCrashHandler(request, 1u);
        EXPECT_EQ(transport, Core::Crash::CrashDetail::CrashDumpTransportStatus::TimedOut);
        ASSERT_NE(ResumeThread(handlerThread), static_cast<DWORD>(-1));
        resume.release();
        ASSERT_EQ(WaitForSingleObject(Core::Crash::CrashDetail::g_State.crashHandledEvent, Core::Crash::CrashDetail::s_ManualCrashDumpWaitMilliseconds), WAIT_OBJECT_0);

        crashIdText.assign(request.crashId.data());
        const CrashTestPath packageDirectory = spool / CrashNames::s_PendingDirectoryName / AStringView(request.crashId.data());
        Vector<u8, ScratchArena> dumpBytes(testArena.scratchArena);
        const auto read = ReadBinaryFile(packageDirectory / CrashNames::s_ProcessDumpFileName, dumpBytes);
        ASSERT_TRUE(read);
        MINIDUMP_DIRECTORY* directory = nullptr;
        void* streamData = nullptr;
        ULONG streamSize = 0u;
        ASSERT_TRUE(MiniDumpReadDumpStream(dumpBytes.data(), ExceptionStream, &directory, &streamData, &streamSize));
        ASSERT_NE(streamData, nullptr);
        ASSERT_GE(streamSize, sizeof(MINIDUMP_EXCEPTION_STREAM));
        const usize dumpBegin = reinterpret_cast<usize>(dumpBytes.data());
        const usize streamAddress = reinterpret_cast<usize>(streamData);
        ASSERT_GE(streamAddress, dumpBegin);
        const usize streamOffset = streamAddress - dumpBegin;
        ASSERT_LE(streamOffset, dumpBytes.size());
        ASSERT_LE(sizeof(MINIDUMP_EXCEPTION_STREAM), dumpBytes.size() - streamOffset);
        MINIDUMP_EXCEPTION_STREAM exceptionStream = {};
        FOUNDATION_MEMCPY(&exceptionStream, sizeof(exceptionStream), dumpBytes.data() + streamOffset, sizeof(exceptionStream));
        EXPECT_EQ(exceptionStream.ThreadId, request.threadId);
        EXPECT_EQ(exceptionStream.ExceptionRecord.ExceptionCode, Core::Crash::CrashDetail::s_ManualDumpExceptionCode);
        EXPECT_EQ(exceptionStream.ExceptionRecord.ExceptionAddress, capturedInstructionPointer);
        ASSERT_GE(exceptionStream.ThreadContext.DataSize, sizeof(CONTEXT));
        ASSERT_LE(static_cast<u64>(exceptionStream.ThreadContext.Rva) + sizeof(CONTEXT), dumpBytes.size());
        CONTEXT dumpedContext = {};
        FOUNDATION_MEMCPY(&dumpedContext, sizeof(dumpedContext), dumpBytes.data() + exceptionStream.ThreadContext.Rva, sizeof(dumpedContext));
#if defined(_M_X64) || defined(__x86_64__)
        EXPECT_EQ(dumpedContext.Rip, capturedInstructionPointer);
#elif defined(_M_IX86) || defined(__i386__)
        EXPECT_EQ(dumpedContext.Eip, capturedInstructionPointer);
#elif defined(_M_ARM64) || defined(__aarch64__)
        EXPECT_EQ(dumpedContext.Pc, capturedInstructionPointer);
#endif
        reusableAfterTimeout = Core::Crash::CaptureCrashDump(AStringView("after_timeout"), AStringView("handler remains reusable")).packageWritten();
        UninstallCrashHandler();
        uninstall.release();
#endif
    }
    const Path packageDirectory = PackageDirectory(group, s_PendingBucket, crashIdText);
    EXPECT_TRUE(TextFileContains(packageDirectory / "symbolication.txt", "minidump captured;"));
    EXPECT_TRUE(TextFileContains(packageDirectory / s_ManifestFileName, "\"has_exception_context\": true"));
    EXPECT_TRUE(reusableAfterTimeout);
    RemoveTestArtifacts(group);
}

void VerifyCrash_ManualNativeContextAdmissionRejectsWrongVersionSizeArchitectureAndLinkedRecords(){
    if(!IsWindowsCrashPlatform())
        return;

    CrashRequest request = CrashRequest();
    native(mut request){
#if defined(FOUNDATION_PLATFORM_WINDOWS)
        Core::Crash::CrashDetail::ManualDumpContextStorage storage;
        Core::Crash::CrashDetail::CrashDumpRequestOptions options;
        Core::Crash::CrashDetail::CaptureManualDumpContext(options, storage);
        request = Core::Crash::CrashDetail::BuildCrashDumpRequest(Core::Crash::CrashDetail::CrashReasonKind::ManualDump, 0u, options);
        ASSERT_TRUE(CrashProtocol::IsCurrentCrashRequest(request));
        const u32 validVersion = request.version;
        request.version = 1u;
        EXPECT_FALSE(CrashProtocol::IsCurrentCrashRequest(request));
        request.version = validVersion + 1u;
        EXPECT_FALSE(CrashProtocol::IsCurrentCrashRequest(request));
        request.version = validVersion;

        --request.manualContextSize;
        EXPECT_FALSE(CrashProtocol::IsCurrentCrashRequest(request));
        request.manualContextSize = sizeof(CONTEXT);
        request.manualContextArchitecture ^= 0x00010000u;
        EXPECT_FALSE(CrashProtocol::IsCurrentCrashRequest(request));
        request.manualContextArchitecture = Core::Crash::CrashDetail::s_WindowsContextArchitecture;
        request.manualExceptionRecord.ExceptionRecord = &storage.exceptionRecord;
        EXPECT_FALSE(CrashProtocol::IsCurrentCrashRequest(request));
        request.manualExceptionRecord.ExceptionRecord = nullptr;
        request.manualContext.ContextFlags |= Core::Crash::CrashDetail::s_WindowsExtendedContextFlag;
        EXPECT_FALSE(CrashProtocol::IsCurrentCrashRequest(request));
#endif
    }
}

void VerifyCrash_DesktopHandlerDoesNotRetainUnrelatedInheritableHandles(){
    if(!IsWindowsCrashPlatform())
        return;

    const StringView group = "crash_handler_handle_inheritance_test";
    RemoveTestArtifacts(group);
    const Path testDirectory = TestCaseDirectory(group);
    ASSERT_TRUE(EnsureDirectories(testDirectory).has_value());
    const Path sentinelPath = testDirectory / "inheritable_handle_sentinel.tmp";
    const Path spool = SpoolDirectory(group);
    b8 installed = false;
    b8 closedSentinel = false;
    b8 deletedSentinel = false;
    native(in sentinelPath, in spool, mut installed, mut closedSentinel, mut deletedSentinel){
#if defined(FOUNDATION_PLATFORM_WINDOWS)
        SECURITY_ATTRIBUTES securityAttributes = {};
        securityAttributes.nLength = sizeof(securityAttributes);
        securityAttributes.bInheritHandle = TRUE;
        const HANDLE sentinelHandle = CreateFileW(sentinelPath.c_str(), GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, &securityAttributes, CREATE_ALWAYS, FILE_ATTRIBUTE_TEMPORARY, nullptr);
        ASSERT_NE(sentinelHandle, INVALID_HANDLE_VALUE);

        PersistentArena installArena(s_InstallArena, PersistentArena::StructureAlignedSize(64u * 1024u));
        Core::Crash::CrashConfigT<PersistentArena> config(installArena);
        config.applicationName = AStringView(s_CrashTests);
        config.version = AStringView(s_ApplicationVersion);
        config.buildId = AStringView("handle-inheritance-test");
        config.spoolDirectory = spool;

        installed = Core::Crash::InstallCrashHandler(config);
        closedSentinel = CloseHandle(sentinelHandle) != FALSE;
        deletedSentinel = DeleteFileW(sentinelPath.c_str()) != FALSE;
#endif
    }
    EXPECT_TRUE(installed);
    EXPECT_TRUE(closedSentinel);
    EXPECT_TRUE(deletedSentinel);
    if(installed)
        UninstallCrashHandler();
    RemoveTestArtifacts(group);
}

void VerifyCrash_LinuxManualDumpUnwindsBeyondTheLeafWithoutFramePointers(){
    if(!IsDesktopLinuxCrashPlatform())
        return;

    const StringView group = "crash_desktop_handler_runtime_test";
    RemoveTestArtifacts(group);
    const Path spool = SpoolDirectory(group);
    String crashIdText = String();
    native(in spool, mut crashIdText){
#if defined(FOUNDATION_PLATFORM_LINUX) && !defined(FOUNDATION_PLATFORM_ANDROID)
        PersistentArena installArena(s_InstallArena, PersistentArena::StructureAlignedSize(64u * 1024u));
        Core::Crash::CrashConfigT<PersistentArena> config(installArena);
        config.applicationName = AStringView(s_CrashTests);
        config.version = AStringView(s_ApplicationVersion);
        config.buildId = AStringView("desktop-handler-runtime-test");
        config.spoolDirectory = spool;

        {
            ScopedLock lock(Core::Crash::CrashDetail::g_State.mutex);
            Core::Crash::CrashDetail::g_State.crashSequence.store(1u, MemoryOrder::relaxed);
        }

        ASSERT_TRUE(Core::Crash::InstallCrashHandler(config));

        Core::Crash::CrashDetail::CrashDumpRequestOptions options;
        options.waitMilliseconds = Core::Crash::CrashDetail::s_PlatformCrashHandlerWaitMilliseconds;
        options.triggerCategory = AStringView(s_Test);
        options.triggerMessage = AStringView("desktop handler runtime");
        options.triggerFile = AStringView("tests/integration/crash/crash_package_tests.cpp");
        Core::Crash::CrashDetail::ManualDumpContextStorage contextStorage;
        Core::Crash::CrashDetail::CaptureManualDumpContext(options, contextStorage);
        const Core::Crash::CrashDumpResult result = Core::Crash::CrashDetail::RequestCrashDump(Core::Crash::CrashDetail::CrashReasonKind::ManualDump, 0u, options);
        EXPECT_EQ(result.status, Core::Crash::CrashDumpStatus::PackageWritten);

        Array<char, Core::Crash::CrashDetail::s_MaxShortText> crashId = {};
        BuildCrashIdForProcess(CurrentProcessId(), 1u, crashId);
        const AStringView idView = FixedBufferView(crashId);
        crashIdText.assign(idView.data(), idView.size());
#endif
    }

    const Path packageDirectory = PackageDirectory(group, s_PendingBucket, crashIdText);
    ExpectDirectoryReady(packageDirectory, s_PackageReadyTimeoutMS);
    ExpectIsRegularFile(packageDirectory / s_CallstackFileName, true);
    // Frame #1 proves unwinding walked past the leaf frame without frame pointers.
    EXPECT_TRUE(TextFileContains(packageDirectory / s_CallstackFileName, "#1 0x"));
    UninstallCrashHandler();
    RemoveTestArtifacts(group);
}

