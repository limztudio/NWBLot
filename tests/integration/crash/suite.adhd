const u32 s_PackageReadyTimeoutMS = 3000u;
const StringView s_ApplicationVersion = "1";
const StringView s_Crash001 = "crash-001";
const StringView s_Crash002 = "crash-002";
const StringView s_Crash003 = "crash-003";
const StringView s_CrashTests = "crash_tests";
const StringView s_Test = "test";
const Name s_OperationScratch = s_CrashTestNameTestsIntegrationCrashOperationScratch;
const Name s_InstallArena = s_CrashTestNameTestsIntegrationCrashInstall;
const Name s_SignalChildInstallArena = s_CrashTestNameTestsIntegrationCrashSignalChildInstall;
const Name s_ArchiveFixtureArena = s_CrashTestNameTestsIntegrationCrashArchiveUpload;
const Name s_ArchiveOperationScratch = s_CrashTestNameTestsIntegrationCrashArchiveUploadScratch;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class CrashDiagnosticObserver{
    public StringView category;
    public u32 count = 0u;
    public u32 unlocked = 0u;
    public Array<CrashChar, 192u> message;
    public Array<CrashChar, 64u> operation;
    public b8 checkMutex;

    public CrashDiagnosticObserver(in StringView observedCategory, in b8 check){
        this.category = observedCategory;
        this.checkMutex = check;
    }

    public void observe(in DiagnosticEventRecord record){
        if(record.category != this.category)
            return;
        ++this.count;
        CopyFixedBuffer(this.message, record.message);
        CopyFixedBuffer(this.operation, record.expression);
        if(this.checkMutex){
            mut CrashRuntimeState state = TestCrashState();
            if(state.mutex.try_lock()){
                ++this.unlocked;
                state.mutex.unlock();
            }
        }
    }
}

[ordered]
class CrashArchiveUpload{
    public HeapStorage m_arena = HeapStorage(s_ArchiveFixtureArena);
    public ScratchStorage m_scratch = ScratchStorage(s_ArchiveOperationScratch);
    public Path m_root;
    private b8 m_rootReady = false;

    public void setup(){
        const ExecutablePaths paths = ExecutablePaths();
        const auto directory = paths.directory();
        ASSERT_TRUE(directory.has_value());
        this.m_root = directory.value() / "crashes" / "test_storage" / CurrentCrashTestName();
        this.m_rootReady = true;
        ASSERT_TRUE(RemoveAllIfExists(this.m_root).has_value());
        ASSERT_TRUE(EnsureDirectories(this.m_root).has_value());
    }

    public void teardown(){
        if(this.m_rootReady)
            EXPECT_TRUE(RemoveAllIfExists(this.m_root).has_value());
    }
}

class CrashHandlerCleanup{
    public ~CrashHandlerCleanup(){ UninstallCrashHandler(); }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Path BucketDirectory(in StringView testGroup, in StringView bucketName){
    return SpoolDirectory(testGroup) / bucketName;
}

Path PackageDirectory(in StringView testGroup, in StringView bucketName, in StringView packageName){
    return BucketDirectory(testGroup, bucketName) / packageName;
}

b8 CreatePackageDirectory(in StringView testGroup, in StringView bucketName, in StringView packageName){
    const Path packageDirectory = PackageDirectory(testGroup, bucketName, packageName);
    if(!EnsureDirectories(packageDirectory).has_value())
        return false;
    return WriteTextFile(packageDirectory / "marker.txt", "package");
}

void CopyCrashPath<const usize N>(in Path source, mut Array<CrashChar, N> destination){
    const String text = PathToString(source);
    CopyFixedBuffer(destination, StringView(text));
}

void FillPackageRequest(in Path spoolDirectory, in StringView crashId, mut CrashRequest request){
    request = CrashRequest();
    request.platform = CurrentCrashPlatformKind();
    request.reasonKind = cast<u32>(RequestReason::ManualDump);
    request.processId = CurrentProcessId();
    request.threadId = CurrentThreadId();
    CopyFixedBuffer(request.crashId, crashId);
    CopyFixedBuffer(request.applicationName, s_CrashTests);
    CopyFixedBuffer(request.versionText, s_ApplicationVersion);
    CopyFixedBuffer(request.buildId, s_Test);
    CopyFixedBuffer(request.abi, CurrentAbiName());
    CopyCrashPath(spoolDirectory, request.spoolDirectory);
}

void ExpectDirectoryReady(in Path path, in u32 timeoutMs){
    const Expected<b8, ErrorCode> ready = WaitForDirectory(path, timeoutMs);
    ASSERT_TRUE(ready.has_value());
    EXPECT_TRUE(ready.value());
}

b8 IsWindowsCrashPlatform(){
    return CurrentCrashPlatformKind() == s_CrashPlatformWindows;
}

b8 IsDesktopLinuxCrashPlatform(){
    return CurrentCrashPlatformKind() == s_CrashPlatformLinux;
}

b8 IsDesktopCrashPlatform(){
    return IsWindowsCrashPlatform() || IsDesktopLinuxCrashPlatform();
}

String FormatProcessGroup(in StringView prefix){
    return StringFormat("{}{}", prefix, CurrentProcessId());
}

b8 BytesStartWith(in ObservationArchiveBytes bytes, in StringView needle){
    if(bytes.size() < needle.size())
        return false;
    for(usize index = 0u; index < needle.size(); ++index){
        if(bytes[index] != needle[index])
            return false;
    }
    return true;
}

b8 BytesContain(in ObservationArchiveBytes bytes, in StringView needle){
    if(needle.empty())
        return true;
    if(bytes.size() < needle.size())
        return false;
    const usize limit = bytes.size() - needle.size();
    for(usize start = 0u; start <= limit; ++start){
        b8 matched = true;
        for(usize index = 0u; index < needle.size(); ++index){
            if(bytes[start + index] != needle[index]){
                matched = false;
                break;
            }
        }
        if(matched)
            return true;
    }
    return false;
}

Expected<ObservationArchiveBytes, ErrorCode> BuildCrashArchiveInTemporaryScratch(mut HeapStorage heap, in Path root){
    ScratchStorage scratch(s_ArchiveOperationScratch);
    return BuildObservationArchive(heap, scratch, root);
}

void VerifyCrashArchiveUpload_PreservesNativeMissingDirectoryError(mut CrashArchiveUpload self){
    const Path missing = self.m_root / "missing";
    const Expected<DirectoryIterator, ErrorCode> nativeDirectory = DirectoryIteratorCreate(missing);
    ASSERT_FALSE(nativeDirectory.has_value());
    const Expected<ObservationArchiveBytes, ErrorCode> archive = BuildObservationArchive(self.m_arena, self.m_scratch, missing);
    ASSERT_FALSE(archive.has_value());
    EXPECT_EQ(archive.error(), nativeDirectory.error());
}

void VerifyCrashArchiveUpload_ResultOwnsBytesAfterWorkingScratchExpires(mut CrashArchiveUpload self){
    const Path payloadPath = self.m_root / "payload.txt";
    ASSERT_TRUE(WriteTextFile(payloadPath, "payload survives scratch"));
    const Expected<ObservationArchiveBytes, ErrorCode> archiveResult = BuildCrashArchiveInTemporaryScratch(self.m_arena, self.m_root);
    ASSERT_TRUE(archiveResult.has_value());
    in ObservationArchiveBytes archive = archiveResult.value();
    EXPECT_TRUE(BytesStartWith(archive, s_ArchiveHeaderText));
    EXPECT_TRUE(BytesContain(archive, "payload.txt"));
    EXPECT_TRUE(BytesContain(archive, "payload survives scratch"));
}

void VerifyCrashArchiveUpload_UnsupportedProtocolPreservesFailureAndPendingRetry(mut CrashArchiveUpload self){
    const StringView crashId = "crash-unsupported-protocol";
    const Path spoolDirectory = self.m_root / "spool";
    const Path pending = spoolDirectory / s_PendingDirectoryName / crashId;
    ASSERT_TRUE(EnsureDirectories(pending).has_value());
    ASSERT_TRUE(WriteTextFile(pending / "marker.txt", "package"));
    CrashUploadSnapshot snapshot = CrashUploadSnapshot();
    CopyCrashPath(spoolDirectory, snapshot.spoolDirectory);
    CopyFixedBuffer(snapshot.logServerUrl, "nwb-unsupported://local");
    UninstallCrashHandler();
    {
        CrashDiagnosticObserver observed("crash_package_upload", false);
        CrashDiagnosticSubscription<CrashDiagnosticObserver> registration(observed);
        EXPECT_FALSE(FlushTestCrashReports(self.m_arena, snapshot));
        EXPECT_EQ(observed.count, 1u);
        EXPECT_EQ(FixedBufferView(observed.operation), "perform_upload");
        EXPECT_TRUE(Contains(FixedBufferView(observed.message), "curl code="));
    }
    ExpectIsDirectory(pending, true);
    ExpectIsDirectory(spoolDirectory / s_UploadingDirectoryName / crashId, false);
    EXPECT_TRUE(TextFileContains(pending / s_UploadAttemptFileName, s_UploadAttemptRetryPendingState));
}

void RejectUnterminatedCrashText<const usize N>(mut CrashRequest request, mut Array<CrashChar, N> text){
    const Array<CrashChar, N> original = text;
    text.fill(120);
    EXPECT_FALSE(IsCurrentCrashRequest(request));
    text = original;
}

void VerifyCrash_RequestAdmissionRejectsCorruptCountsAndUnterminatedText(){
    CrashRequest request = CrashRequest();
    CopyFixedBuffer(request.crashId, "crash-1-1");
    ASSERT_TRUE(IsCurrentCrashRequest(request));

    request.metadataCount = s_CrashMaxMetadata + 1u;
    EXPECT_FALSE(IsCurrentCrashRequest(request));
    request.metadataCount = 1u;
    request.breadcrumbCount = s_CrashMaxBreadcrumbs + 1u;
    EXPECT_FALSE(IsCurrentCrashRequest(request));
    request.breadcrumbCount = 1u;
    request.callstackFrameCount = s_CrashMaxCallstackFrames + 1u;
    EXPECT_FALSE(IsCurrentCrashRequest(request));
    request.callstackFrameCount = 0u;

    RejectUnterminatedCrashText(request, request.crashId);
    RejectUnterminatedCrashText(request, request.applicationName);
    RejectUnterminatedCrashText(request, request.versionText);
    RejectUnterminatedCrashText(request, request.buildId);
    RejectUnterminatedCrashText(request, request.abi);
    RejectUnterminatedCrashText(request, request.spoolDirectory);
    RejectUnterminatedCrashText(request, request.logServerUrl);
    RejectUnterminatedCrashText(request, request.crashUploadToken);
    RejectUnterminatedCrashText(request, request.event);
    RejectUnterminatedCrashText(request, request.triggerCategory);
    RejectUnterminatedCrashText(request, request.triggerExpression);
    RejectUnterminatedCrashText(request, request.triggerMessage);
    RejectUnterminatedCrashText(request, request.triggerFile);
    RejectUnterminatedCrashText(request, request.metadata[0u].key);
    RejectUnterminatedCrashText(request, request.metadata[0u].value);
    RejectUnterminatedCrashText(request, request.breadcrumbs[0u].category);
    RejectUnterminatedCrashText(request, request.breadcrumbs[0u].message);
    EXPECT_TRUE(IsCurrentCrashRequest(request));
    CopyFixedBuffer(request.crashId, "../outside");
    EXPECT_FALSE(IsCurrentCrashRequest(request));
    CopyFixedBuffer(request.crashId, "..\\outside");
    EXPECT_FALSE(IsCurrentCrashRequest(request));
}

void VerifyCrash_AckAdmissionRequiresBoundedTerminatedIdentity(){
    CrashRequest request = CrashRequest();
    CrashAck ack = CrashAck();
    CopyFixedBuffer(request.crashId, "crash-1-1");
    CopyFixedBuffer(ack.crashId, "crash-1-1");
    EXPECT_TRUE(CrashAckMatchesRequest(ack, request));
    ack.packageWritten = 2u;
    EXPECT_FALSE(CrashAckMatchesRequest(ack, request));
    ack.packageWritten = 0u;
    ack.crashId.fill(120);
    EXPECT_FALSE(CrashAckMatchesRequest(ack, request));
    request.crashId.fill(120);
    EXPECT_FALSE(CrashAckMatchesRequest(ack, request));
}

void ResetCrashSequence(){
    mut CrashRuntimeState state = TestCrashState();
    const FutexGuard guard = AcquireFutex(state.mutex);
    state.crashSequence.store(1u, MemoryOrder::relaxed);
}

String TestCrashId(in u32 processId, in u64 sequence){
    return StringFormat("{}{}-{}", s_CrashIdPrefix, processId, sequence);
}

void VerifyCrash_LinuxManualDumpUnwindsBeyondTheLeafWithoutFramePointers(){
    if(!IsDesktopLinuxCrashPlatform())
        return;

    const StringView group = "crash_desktop_handler_runtime_test";
    RemoveTestArtifacts(group);
    const Path spool = SpoolDirectory(group);
    String crashIdText = String();
    PersistentStorage installArena(s_InstallArena, PersistentArenaStructureAlignedSize(64u * 1024u));
    TestValueSlot<PersistentCrashConfig> slot;
    mut PersistentCrashConfig config = slot.constructIn(installArena);
    config.applicationName = s_CrashTests;
    config.version = s_ApplicationVersion;
    config.buildId = "desktop-handler-runtime-test";
    config.spoolDirectory = spool;
    ResetCrashSequence();
    ASSERT_TRUE(InstallCrashHandler(config));

    CrashRequestOptions options;
    options.waitMilliseconds = s_CrashHandlerWaitMilliseconds;
    options.triggerCategory = s_Test;
    options.triggerMessage = "desktop handler runtime";
    options.triggerFile = "tests/integration/crash/crash_package_tests.cpp";
    ManualContext context;
    CaptureManualContext(options, context);
    const CrashDumpResult result = RequestCrashDump(RequestReason::ManualDump, 0u, options);
    EXPECT_EQ(result.status, CrashDumpStatus::PackageWritten);
    crashIdText = TestCrashId(CurrentProcessId(), 1u);

    const Path packageDirectory = PackageDirectory(group, s_PendingDirectoryName, crashIdText);
    ExpectDirectoryReady(packageDirectory, s_PackageReadyTimeoutMS);
    ExpectIsRegularFile(packageDirectory / s_CallstackFileName, true);
    EXPECT_TRUE(TextFileContains(packageDirectory / s_CallstackFileName, "#1 0x"));
    UninstallCrashHandler();
    RemoveTestArtifacts(group);
}

void VerifyCrash_DesktopInstalledHandlerWritesGpuCrashTextOnlyPackage(){
    if(!IsDesktopCrashPlatform())
        return;

    const StringView group = "crash_gpu_text_only_runtime_test";
    RemoveTestArtifacts(group);
    const Path spool = SpoolDirectory(group);
    String crashIdText = String();
    PersistentStorage installArena(s_InstallArena, PersistentArenaStructureAlignedSize(64u * 1024u));
    TestValueSlot<PersistentCrashConfig> slot;
    mut PersistentCrashConfig config = slot.constructIn(installArena);
    config.applicationName = s_CrashTests;
    config.version = s_ApplicationVersion;
    config.buildId = "gpu-text-only-runtime-test";
    config.spoolDirectory = spool;
    ResetCrashSequence();
    ASSERT_TRUE(InstallCrashHandler(config));

    CrashRequestOptions options;
    options.waitMilliseconds = s_CrashHandlerWaitMilliseconds;
    options.triggerCategory = s_CrashGpuCategory;
    options.gpuReport = "minimal GPU crash report: no vendor GPU dump or device-fault details were available\n";
    options.gpuDumpKind = CrashGpuCrashDumpKind::None;
    ManualContext context;
    CaptureManualContext(options, context);
    const CrashDumpResult result = RequestCrashDump(RequestReason::GpuCrash, 0u, options);
    EXPECT_EQ(result.status, CrashDumpStatus::PackageWritten);
    crashIdText = TestCrashId(CurrentProcessId(), 1u);

    const Path packageDirectory = PackageDirectory(group, s_PendingDirectoryName, crashIdText);
    ExpectDirectoryReady(packageDirectory, s_PackageReadyTimeoutMS);
    ExpectIsRegularFile(packageDirectory / s_GpuCrashReportFileName, true);
    ExpectPathExists(packageDirectory / s_GpuDetectiveCaptureFileName, false);
    ExpectPathExists(packageDirectory / s_AftermathGpuDumpFileName, false);
    EXPECT_TRUE(TextFileContains(packageDirectory / s_GpuCrashReportFileName, "minimal GPU crash report"));
    UninstallCrashHandler();
    RemoveTestArtifacts(group);
}

void VerifyCrash_LinuxSignalHandlerWritesCrashPackage(){
    if(!IsDesktopLinuxCrashPlatform())
        return;

    const StringView group = "crash_linux_signal_runtime_test";
    RemoveTestArtifacts(group);
    const Path spoolDirectory = SpoolDirectory(group);
    b8 childSpawned = false;
    b8 signaledBySegv = false;
    String crashIdText = String();
    const i32 child = ForkTestChild();
    ASSERT_GE(child, 0);
    if(child == 0){
        PersistentStorage installArena(s_SignalChildInstallArena, PersistentArenaStructureAlignedSize(64u * 1024u));
        TestValueSlot<PersistentCrashConfig> slot;
        mut PersistentCrashConfig config = slot.constructIn(installArena);
        config.applicationName = s_CrashTests;
        config.version = s_ApplicationVersion;
        config.buildId = "linux-signal-runtime-test";
        config.spoolDirectory = spoolDirectory;
        ResetCrashSequence();
        if(!InstallCrashHandler(config))
            ExitTestChild(111);
        RaiseTestSignal(s_TestSegvSignal);
        ExitTestChild(112);
    }
    if(child > 0){
        childSpawned = true;
        const ChildWaitResult status = WaitForTestChild(child);
        signaledBySegv = status.signaled && status.signal == s_TestSegvSignal;
        crashIdText = TestCrashId(cast<u32>(child), 1u);
    }

    if(childSpawned){
        EXPECT_TRUE(signaledBySegv);
        const Path packageDirectory = PackageDirectory(group, s_PendingDirectoryName, crashIdText);
        const u32 missingPackageReadyTimeoutMs = 1000u;
        ExpectDirectoryReady(packageDirectory, missingPackageReadyTimeoutMs);
        ExpectIsRegularFile(packageDirectory / s_ManifestFileName, true);
        ExpectIsRegularFile(packageDirectory / s_CallstackFileName, true);
        EXPECT_TRUE(TextFileContains(packageDirectory / s_CallstackFileName, "#1 0x"));
        ExpectIsRegularFile(packageDirectory / s_ProcMapsFileName, true);
        EXPECT_TRUE(TextFileContains(packageDirectory / s_ManifestFileName, "\"reason_kind\": \"signal\""));
    }
    RemoveTestArtifacts(group);
}

NWB_ADHD_GTEST_F(CrashArchiveUpload, PreservesNativeMissingDirectoryError, VerifyCrashArchiveUpload_PreservesNativeMissingDirectoryError)

NWB_ADHD_GTEST_F(CrashArchiveUpload, ResultOwnsBytesAfterWorkingScratchExpires, VerifyCrashArchiveUpload_ResultOwnsBytesAfterWorkingScratchExpires)

NWB_ADHD_GTEST_F(CrashArchiveUpload, UnsupportedProtocolPreservesFailureAndPendingRetry, VerifyCrashArchiveUpload_UnsupportedProtocolPreservesFailureAndPendingRetry)

NWB_ADHD_GTEST(Crash, RequestAdmissionRejectsCorruptCountsAndUnterminatedText, VerifyCrash_RequestAdmissionRejectsCorruptCountsAndUnterminatedText)

NWB_ADHD_GTEST(Crash, AckAdmissionRequiresBoundedTerminatedIdentity, VerifyCrash_AckAdmissionRequiresBoundedTerminatedIdentity)


