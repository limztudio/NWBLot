inline constexpr AStringView s_ProbeRegressionLabel = "Probe regression";
inline constexpr AStringView s_ProbeGrowthLabel = "Probe growth";
inline constexpr AStringView s_ScalingTargetText = "target";

struct ContributionFailure{};

class PendingNameFrameGraphContributor final : public Core::Telemetry::IFrameGraphContributor{
public:
    virtual b8 appendFrameGraph(Core::Telemetry::FrameGraphBuilder& builder)override{
        const Core::Telemetry::FrameGraphNodeHandle source = builder.addPass(s_TelemetryCaseSource, "Source");
        const Core::Telemetry::FrameGraphNodeHandle target = builder.addResource(Name(s_ScalingTargetText), "Target");
        const Core::Telemetry::FrameGraphNodeHandle duplicateTarget = builder.addResource(Name(s_ScalingTargetText), "Duplicate Target");
        if(!target.valid() || !duplicateTarget.valid())
            return false;

        builder.dependsOnByName(source, Name(s_ScalingTargetText), 7u);
        builder.dependsOnByName(source, s_TelemetryCaseMissing, 9u);
        return true;
    }
};

class LocalLabelContributor final : public Core::Telemetry::IFrameGraphContributor{
public:
    virtual b8 appendFrameGraph(Core::Telemetry::FrameGraphBuilder& builder)override{
        char label[] = "local label";
        const auto node = builder.addPass(s_TelemetryCaseLocalLabel, AStringView(label));
        label[0u] = 'X';
        return node.valid();
    }
};

class MutatingContributor final : public Core::Telemetry::IFrameGraphContributor{
public:
    explicit MutatingContributor(Core::Telemetry::FrameGraphRegistry& registry)noexcept
        : m_registry(&registry)
    {}

    virtual b8 appendFrameGraph(Core::Telemetry::FrameGraphBuilder& builder)override{
        ++calls;
        const auto node = builder.addPass(s_TelemetryCaseMutation, "mutation");
        if(clearRegistry)
            m_registry->clear();
        if(removeSelf)
            m_registry->unregisterContributor(*this);
        if(removeOther)
            m_registry->unregisterContributor(*removeOther);
        if(addOther)
            m_registry->registerContributor(*addOther);
        if(throwAfterMutation)
            throw ContributionFailure{};
        return node.valid();
    }

    void setRemoveOther(Core::Telemetry::IFrameGraphContributor& other)noexcept{ removeOther = &other; }
    void setAddOther(Core::Telemetry::IFrameGraphContributor& other)noexcept{ addOther = &other; }


public:
    Core::Telemetry::IFrameGraphContributor* removeOther = nullptr;
    Core::Telemetry::IFrameGraphContributor* addOther = nullptr;
    usize calls = 0u;
    b8 removeSelf = false;
    b8 clearRegistry = false;
    b8 throwAfterMutation = false;


private:
    Core::Telemetry::FrameGraphRegistry* m_registry = nullptr;
};

class OwnedLabelContributor final : public Core::Telemetry::IFrameGraphContributor{
public:
    OwnedLabelContributor(Core::Telemetry::FrameGraphRegistry& registry, Core::Telemetry::TelemetryArena& arena)
        : m_registry(&registry)
        , m_label("label retained after contributor destruction", arena)
    {}

    virtual b8 appendFrameGraph(Core::Telemetry::FrameGraphBuilder& builder)override{
        const auto node = builder.addPass(s_TelemetryCaseOwnedLabel, AStringView(m_label));
        m_registry->unregisterContributor(*this);
        return node.valid();
    }


private:
    Core::Telemetry::FrameGraphRegistry* m_registry = nullptr;
    AString<Core::Telemetry::TelemetryArena> m_label;
};

class DestroyContributor final : public Core::Telemetry::IFrameGraphContributor{
public:
    explicit DestroyContributor(Optional<OwnedLabelContributor>& target)noexcept
        : m_target(&target)
    {}

    virtual b8 appendFrameGraph(Core::Telemetry::FrameGraphBuilder& builder)override{
        m_target->reset();
        return builder.addPass(s_TelemetryCaseDestroyer, "destroyer").valid();
    }


private:
    Optional<OwnedLabelContributor>* m_target = nullptr;
};

class CacheLifetimeContributor final : public Core::Telemetry::IFrameGraphContributor{
public:
    CacheLifetimeContributor(Core::Telemetry::FrameGraphRegistry& registry, Core::Telemetry::CaptureSession& session, const AString<Core::Telemetry::TelemetryArena>& label)noexcept
        : m_registry(&registry)
        , m_session(&session)
        , m_label(&label)
    {}


public:
    virtual b8 appendFrameGraph(Core::Telemetry::FrameGraphBuilder& builder)override{
        if(!builder.addPass(s_TelemetryCaseCacheLifetime, AStringView(*m_label)).valid())
            return false;
        if(m_throwNext){
            m_throwNext = false;
            throw ContributionFailure{};
        }
        m_reentryRejected = !m_registry->record(*m_session);
        return true;
    }


public:
    b8 m_throwNext = true;
    b8 m_reentryRejected = false;


private:
    Core::Telemetry::FrameGraphRegistry* m_registry = nullptr;
    Core::Telemetry::CaptureSession* m_session = nullptr;
    const AString<Core::Telemetry::TelemetryArena>* m_label = nullptr;
};

