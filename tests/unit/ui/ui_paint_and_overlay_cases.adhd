const StringView s_UiPaintOverlayDefaultImagePath = "tests/ui/image";
const StringView s_UiPaintOverlayVersionedImagePath = "tests/ui/versioned_image";
const StringView s_UiPaintOverlaySameImagePath = "tests/ui/same_image";
const StringView s_UiPaintOverlayReplacementImagePath = "tests/ui/replacement";
const u64 s_UiPaintOverlayDefaultAtlasIdentity = 11u;

const Name s_UiPaintOverlayTextureName = "tests/ui/texture";
const Name s_UiPaintOverlayPanelRegionName = "panel";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Rect MakeUiPaintOverlayRect(in f32 x, in f32 y, in f32 width, in f32 height){
    Rect rect = Rect();
    rect.x = x;
    rect.y = y;
    rect.width = width;
    rect.height = height;
    return rect;
}

Color MakeUiPaintOverlayColor(in f32 r, in f32 g, in f32 b, in f32 a){
    Color color = Color();
    color.r = r;
    color.g = g;
    color.b = b;
    color.a = a;
    return color;
}

UiSkinSliceInsets MakeUiPaintOverlaySliceInsets(in u32 left, in u32 top, in u32 right, in u32 bottom){
    UiSkinSliceInsets insets = UiSkinSliceInsets();
    insets.left = left;
    insets.top = top;
    insets.right = right;
    insets.bottom = bottom;
    return insets;
}

void RecordUiPaintImageAdmissionBaseline(
    mut PaintBuilder builder,
    in Span<SharedGlyphPage> glyphs,
    in SharedSdfAtlasPage sdf,
    in SharedImageSource image
){
    ASSERT_TRUE(UiPaintOverlayPrepareGlyphsAndSingleSdfAndImage(builder, glyphs, sdf, image));
    builder.fillRect(MakeUiPaintOverlayRect(2.0f, 3.0f, 4.0f, 5.0f), MakeUiPaintOverlayColor(0.8f, 0.4f, 0.2f, 0.5f));
    ASSERT_TRUE(builder.drawGlyph(glyphs[0u], MakeUiPaintOverlayRect(12.0f, 3.0f, 4.0f, 5.0f), MakeUiPaintOverlayRect(0.125f, 0.25f, 0.5f, 0.5f)));
    ASSERT_TRUE(builder.drawSdfGlyph(sdf, 3u, MakeUiPaintOverlayRect(22.0f, 3.0f, 4.0f, 5.0f), MakeUiPaintOverlayRect(0.0f, 0.0f, 0.5f, 0.5f)));
    ASSERT_TRUE(builder.drawImage(image, MakeUiPaintOverlayRect(32.0f, 3.0f, 8.0f, 4.0f)));
}

void RecordUiPaintImageMixedOverflowBaseline(
    mut PaintBuilder builder,
    in Span<SharedGlyphPage> glyphs,
    in SharedSdfAtlasPage sdf,
    in SharedImageSource image
){
    ASSERT_TRUE(UiPaintOverlayPrepareGlyphsAndSingleSdfAndImage(builder, glyphs, sdf, image));
    builder.fillRect(MakeUiPaintOverlayRect(2.0f, 3.0f, 5.0f, 7.0f), MakeUiPaintOverlayColor(0.6f, 0.3f, 0.2f, 0.5f));
    ASSERT_TRUE(builder.drawGlyph(glyphs[0u], MakeUiPaintOverlayRect(12.0f, 13.0f, 5.0f, 7.0f), MakeUiPaintOverlayRect(0.125f, 0.25f, 0.5f, 0.5f)));
    ASSERT_TRUE(builder.beginOverlay(2u));
    builder.pushClip(MakeUiPaintOverlayRect(30.0f, 10.0f, 40.0f, 20.0f));
    ASSERT_TRUE(builder.drawSdfGlyph(sdf, 2u, MakeUiPaintOverlayRect(32.0f, 12.0f, 8.0f, 8.0f), MakeUiPaintOverlayRect(0.0f, 0.0f, 0.5f, 0.5f)));
    ASSERT_TRUE(builder.drawImage(image, MakeUiPaintOverlayRect(44.0f, 12.0f, 12.0f, 8.0f), MakeUiPaintOverlayRect(0.25f, 0.25f, 0.5f, 0.5f)));
    ASSERT_TRUE(builder.popClip());
    ASSERT_TRUE(builder.endOverlay());
}

void RecordUiPaintImageNullThirdPassInitial(mut PaintBuilder builder, in SharedGlyphPage glyph, in SharedImageSource image){
    ASSERT_TRUE(UiPaintOverlayPrepareOneGlyphAndOneImage(builder, glyph, image));
    ASSERT_TRUE(builder.drawGlyph(glyph, MakeUiPaintOverlayRect(2.0f, 3.0f, 4.0f, 5.0f), MakeUiPaintOverlayRect(0.125f, 0.25f, 0.5f, 0.5f)));
    ASSERT_TRUE(builder.drawImage(image, MakeUiPaintOverlayRect(12.0f, 3.0f, 8.0f, 4.0f)));
}

void RecordUiPaintImageNullThirdPassRetry(
    mut PaintBuilder builder,
    in SharedGlyphPage upgrade,
    in SharedSdfAtlasPage sdf,
    in SharedImageSource addition
){
    ASSERT_TRUE(UiPaintOverlayPrepareOneEach(builder, upgrade, sdf, addition));
    ASSERT_TRUE(builder.drawSdfGlyph(sdf, 1u, MakeUiPaintOverlayRect(22.0f, 3.0f, 4.0f, 5.0f), MakeUiPaintOverlayRect(0.0f, 0.0f, 0.5f, 0.5f)));
    ASSERT_TRUE(builder.drawImage(addition, MakeUiPaintOverlayRect(32.0f, 3.0f, 8.0f, 4.0f)));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyPaintImageFixture_ThreeKindsShareSixtyFourSlotsWhileCopiesDeduplicateAndOverflowIsAtomic(mut PaintImageFixture self){
    ASSERT_EQ(s_PaintMaxImages, 64u);
    FixedVector<SharedGlyphPage, 62u> glyphs = FixedVector<SharedGlyphPage, 62u>();
    for(usize index = 0u; index < 62u; ++index){
        auto pageCreationResult = self.makeGlyph(100u + index);
        ASSERT_TRUE(pageCreationResult.has_value());
        SharedGlyphPage page = SharedGlyphPage();
        TakeUiPaintOverlayGlyphPage(page, pageCreationResult);
        ASSERT_TRUE(UiPaintOverlayHasGlyphPage(page));
        glyphs.push_back(page);
    }
    auto sdfCreationResult = self.makeSdf();
    ASSERT_TRUE(sdfCreationResult.has_value());
    SharedSdfAtlasPage sdf = SharedSdfAtlasPage();
    TakeUiPaintOverlaySdfPage(sdf, sdfCreationResult);
    auto imageResult = self.makeImage();
    ASSERT_TRUE(imageResult.has_value());
    SharedImageSource image = SharedImageSource();
    TakeUiPaintOverlayImageSource(image, imageResult);
    auto overflowResult = self.makeImage(s_UiPaintOverlayDefaultImagePath, 81u);
    ASSERT_TRUE(overflowResult.has_value());
    SharedImageSource overflow = SharedImageSource();
    TakeUiPaintOverlayImageSource(overflow, overflowResult);
    ASSERT_TRUE(UiPaintOverlayHasSdfPage(sdf) && UiPaintOverlayHasImage(image) && UiPaintOverlayHasImage(overflow));
    PaintBuilder reference = PaintBuilder(self.m_arena);
    self.beginPaint(reference);
    RecordUiPaintImageAdmissionBaseline(self.m_builder, glyphs, sdf, image);
    RecordUiPaintImageAdmissionBaseline(reference, glyphs, sdf, image);
    const DrawSnapshot expected = reference.freeze();
    const SharedImageSource imageCopy = image;
    Array<SharedGlyphPage, 3u> glyphCopies = Array<SharedGlyphPage, 3u>();
    glyphCopies[0u] = glyphs[0u];
    glyphCopies[1u] = glyphs[1u];
    glyphCopies[2u] = glyphs[0u];
    Array<SharedSdfAtlasPage, 2u> sdfCopies = Array<SharedSdfAtlasPage, 2u>();
    sdfCopies[0u] = sdf;
    sdfCopies[1u] = sdf;
    Array<SharedImageSource, 3u> imageCopies = Array<SharedImageSource, 3u>();
    imageCopies[0u] = image;
    imageCopies[1u] = imageCopy;
    imageCopies[2u] = image;
    ASSERT_TRUE(self.m_builder.prepareImages(glyphCopies, sdfCopies, imageCopies));
    EXPECT_FALSE(UiPaintOverlayPrepareSingleTextureImage(self.m_builder, overflow));
    EXPECT_FALSE(self.m_builder.drawImage(overflow, MakeUiPaintOverlayRect(48.0f, 3.0f, 8.0f, 4.0f)));
    const DrawSnapshot actual = self.m_builder.freeze();
    ASSERT_EQ(actual.glyphPages().size(), 62u);
    ASSERT_EQ(actual.sdfPages().size(), 1u);
    ASSERT_EQ(actual.textureImages().size(), 1u);
    EXPECT_EQ(actual.glyphPages().size() + actual.sdfPages().size() + actual.textureImages().size(), 64u);
    ExpectUiPaintOverlaySameImagePaint(actual, expected);
}

void VerifyPaintImageFixture_MixedOverflowPreservesCoverageGenerationSdfImageVersionsAndAllPriorGeometry(mut PaintImageFixture self){
    ASSERT_EQ(s_PaintMaxImages, 64u);
    FixedVector<SharedGlyphPage, 62u> glyphs = FixedVector<SharedGlyphPage, 62u>();
    for(usize index = 0u; index < 62u; ++index){
        auto pageCreationResult = self.makeGlyph(100u + index);
        ASSERT_TRUE(pageCreationResult.has_value());
        SharedGlyphPage page = SharedGlyphPage();
        TakeUiPaintOverlayGlyphPage(page, pageCreationResult);
        ASSERT_TRUE(UiPaintOverlayHasGlyphPage(page));
        glyphs.push_back(page);
    }
    auto sdfCreationResult = self.makeSdf();
    ASSERT_TRUE(sdfCreationResult.has_value());
    SharedSdfAtlasPage sdf = SharedSdfAtlasPage();
    TakeUiPaintOverlaySdfPage(sdf, sdfCreationResult);
    auto imageResult = self.makeImage();
    ASSERT_TRUE(imageResult.has_value());
    SharedImageSource image = SharedImageSource();
    TakeUiPaintOverlayImageSource(image, imageResult);
    auto upgradeCreationResult = self.makeGlyph(100u, 2u);
    ASSERT_TRUE(upgradeCreationResult.has_value());
    SharedGlyphPage upgrade = SharedGlyphPage();
    TakeUiPaintOverlayGlyphPage(upgrade, upgradeCreationResult);
    auto newSdfCreationResult = self.makeSdf(99u);
    ASSERT_TRUE(newSdfCreationResult.has_value());
    SharedSdfAtlasPage newSdf = SharedSdfAtlasPage();
    TakeUiPaintOverlaySdfPage(newSdf, newSdfCreationResult);
    auto newImageResult = self.makeImage(s_UiPaintOverlayDefaultImagePath, 81u);
    ASSERT_TRUE(newImageResult.has_value());
    SharedImageSource newImage = SharedImageSource();
    TakeUiPaintOverlayImageSource(newImage, newImageResult);
    ASSERT_TRUE(UiPaintOverlayHasSdfPage(sdf) && UiPaintOverlayHasImage(image) && UiPaintOverlayHasGlyphPage(upgrade) && UiPaintOverlayHasSdfPage(newSdf) && UiPaintOverlayHasImage(newImage));
    PaintBuilder reference = PaintBuilder(self.m_arena);
    self.beginPaint(reference);
    RecordUiPaintImageMixedOverflowBaseline(self.m_builder, glyphs, sdf, image);
    RecordUiPaintImageMixedOverflowBaseline(reference, glyphs, sdf, image);
    const DrawSnapshot expected = reference.freeze();
    EXPECT_FALSE(UiPaintOverlayPrepareOneEach(self.m_builder, upgrade, newSdf, newImage));
    const DrawSnapshot actual = self.m_builder.freeze();
    ExpectUiPaintOverlaySameImagePaint(actual, expected);
    ASSERT_EQ(actual.glyphPages().size(), 62u);
    EXPECT_EQ(UiPaintOverlayGlyphPageAddress(actual.glyphPages()[0u]), UiPaintOverlayGlyphPageAddress(glyphs[0u]));
    EXPECT_EQ(UiPaintOverlayGlyphPageGeneration(actual.glyphPages()[0u]), 1u);
    EXPECT_EQ(UiPaintOverlayGlyphPagePixel(actual.glyphPages()[0u], 32u), 0u);
    ASSERT_EQ(actual.sdfPages().size(), 1u);
    EXPECT_EQ(UiPaintOverlaySdfPageAddress(actual.sdfPages()[0u]), UiPaintOverlaySdfPageAddress(sdf));
    ASSERT_EQ(actual.textureImages().size(), 1u);
    EXPECT_EQ(UiPaintOverlayImageAddress(actual.textureImages()[0u]), UiPaintOverlayImageAddress(image));
    EXPECT_EQ(UiPaintOverlayImageGeneration(actual.textureImages()[0u]), UiPaintOverlayImageGeneration(image));
    EXPECT_EQ(UiPaintOverlayImagePayloadByte(actual.textureImages()[0u], 0u), 37u);
}

void VerifyPaintImageFixture_NullThirdKindRejectsEarlierCandidatesAtomicallyAndAValidRetryStillSucceeds(mut PaintImageFixture self){
    auto glyphCreationResult = self.makeGlyph();
    ASSERT_TRUE(glyphCreationResult.has_value());
    SharedGlyphPage glyph = SharedGlyphPage();
    TakeUiPaintOverlayGlyphPage(glyph, glyphCreationResult);
    auto upgradeCreationResult = self.makeGlyph(11u, 2u);
    ASSERT_TRUE(upgradeCreationResult.has_value());
    SharedGlyphPage upgrade = SharedGlyphPage();
    TakeUiPaintOverlayGlyphPage(upgrade, upgradeCreationResult);
    auto sdfCreationResult = self.makeSdf();
    ASSERT_TRUE(sdfCreationResult.has_value());
    SharedSdfAtlasPage sdf = SharedSdfAtlasPage();
    TakeUiPaintOverlaySdfPage(sdf, sdfCreationResult);
    auto imageResult = self.makeImage();
    ASSERT_TRUE(imageResult.has_value());
    SharedImageSource image = SharedImageSource();
    TakeUiPaintOverlayImageSource(image, imageResult);
    auto additionResult = self.makeImage("tests/ui/added_image", 81u);
    ASSERT_TRUE(additionResult.has_value());
    SharedImageSource addition = SharedImageSource();
    TakeUiPaintOverlayImageSource(addition, additionResult);
    ASSERT_TRUE(UiPaintOverlayHasGlyphPage(glyph) && UiPaintOverlayHasGlyphPage(upgrade) && UiPaintOverlayHasSdfPage(sdf) && UiPaintOverlayHasImage(image) && UiPaintOverlayHasImage(addition));
    Array<SharedImageSource, 2u> invalidImages = Array<SharedImageSource, 2u>();
    invalidImages[0u] = addition;
    invalidImages[1u] = SharedImageSource();
    PaintBuilder reference = PaintBuilder(self.m_arena);
    for(u64 pass = 0u; pass < 2u; ++pass){
        self.beginPaint(self.m_builder, pass + 1u);
        self.beginPaint(reference, pass + 1u);
        RecordUiPaintImageNullThirdPassInitial(self.m_builder, glyph, image);
        RecordUiPaintImageNullThirdPassInitial(reference, glyph, image);
        EXPECT_FALSE(UiPaintOverlayPrepareOneGlyphOneSdfAndImageSpan(self.m_builder, upgrade, sdf, invalidImages));
        // Retry image admission in a second builder before either builder finishes.
        if(pass != 0u){
            RecordUiPaintImageNullThirdPassRetry(self.m_builder, upgrade, sdf, addition);
            RecordUiPaintImageNullThirdPassRetry(reference, upgrade, sdf, addition);
        }
        const DrawSnapshot expected = reference.freeze();
        const DrawSnapshot actual = self.m_builder.freeze();
        ExpectUiPaintOverlaySameImagePaint(actual, expected);
        ASSERT_EQ(actual.glyphPages().size(), 1u);
        usize expectedGlyphAddress = UiPaintOverlayGlyphPageAddress(glyph);
        u64 expectedGeneration = 1u;
        usize expectedSdfCount = 0u;
        usize expectedImageCount = 1u;
        if(pass != 0u){
            expectedGlyphAddress = UiPaintOverlayGlyphPageAddress(upgrade);
            expectedGeneration = 2u;
            expectedSdfCount = 1u;
            expectedImageCount = 2u;
        }
        EXPECT_EQ(UiPaintOverlayGlyphPageAddress(actual.glyphPages()[0u]), expectedGlyphAddress);
        EXPECT_EQ(UiPaintOverlayGlyphPageGeneration(actual.glyphPages()[0u]), expectedGeneration);
        EXPECT_EQ(actual.sdfPages().size(), expectedSdfCount);
        EXPECT_EQ(actual.textureImages().size(), expectedImageCount);
    }
}

void VerifyPaintImageFixture_SamePathFreshVersionsCoexistWhileCopiedHandlesUseOneSlotPerVersion(mut PaintImageFixture self){
    auto firstResult = self.makeImage(s_UiPaintOverlayVersionedImagePath, 37u);
    ASSERT_TRUE(firstResult.has_value());
    SharedImageSource first = SharedImageSource();
    TakeUiPaintOverlayImageSource(first, firstResult);
    auto secondResult = self.makeImage(s_UiPaintOverlayVersionedImagePath, 81u);
    ASSERT_TRUE(secondResult.has_value());
    SharedImageSource second = SharedImageSource();
    TakeUiPaintOverlayImageSource(second, secondResult);
    ASSERT_TRUE(UiPaintOverlayHasImage(first) && UiPaintOverlayHasImage(second));
    ASSERT_EQ(UiPaintOverlayImageIdentity(first), UiPaintOverlayImageIdentity(second));
    ASSERT_NE(UiPaintOverlayImageGeneration(first), UiPaintOverlayImageGeneration(second));
    ASSERT_NE(UiPaintOverlayImageAddress(first), UiPaintOverlayImageAddress(second));
    SharedImageSource copy = first;
    const u64 firstGeneration = UiPaintOverlayImageGeneration(first);
    const u64 secondGeneration = UiPaintOverlayImageGeneration(second);
    const usize firstPointer = UiPaintOverlayImageAddress(first);
    const usize secondPointer = UiPaintOverlayImageAddress(second);
    Array<SharedImageSource, 4u> candidates = Array<SharedImageSource, 4u>();
    candidates[0u] = first;
    candidates[1u] = copy;
    candidates[2u] = second;
    candidates[3u] = first;
    ASSERT_TRUE(self.m_builder.prepareTextureImages(candidates));
    ASSERT_TRUE(UiPaintOverlayPrepareSingleTextureImage(self.m_builder, copy));
    for(mut SharedImageSource candidate : candidates)
        candidate.reset();
    first.reset();
    second.reset();
    copy.reset();
    const DrawSnapshot actual = self.m_builder.freeze();
    ASSERT_EQ(actual.textureImages().size(), 2u);
    EXPECT_EQ(UiPaintOverlayImageAddress(actual.textureImages()[0u]), firstPointer);
    EXPECT_EQ(UiPaintOverlayImageAddress(actual.textureImages()[1u]), secondPointer);
    EXPECT_EQ(UiPaintOverlayImageGeneration(actual.textureImages()[0u]), firstGeneration);
    EXPECT_EQ(UiPaintOverlayImageGeneration(actual.textureImages()[1u]), secondGeneration);
    EXPECT_EQ(UiPaintOverlayImageIdentity(actual.textureImages()[0u]), UiPaintOverlayImageIdentity(actual.textureImages()[1u]));
    EXPECT_EQ(UiPaintOverlayImagePayloadByte(actual.textureImages()[0u], 0u), 37u);
    EXPECT_EQ(UiPaintOverlayImagePayloadByte(actual.textureImages()[1u], 0u), 81u);
}

