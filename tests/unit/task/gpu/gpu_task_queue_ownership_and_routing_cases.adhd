void VerifyGpuRouting_SparsePartialRowsAndDenseThresholdsBoundPeakScratch(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    Array<GpuRoutingStorageCase, 11> cases = Array<GpuRoutingStorageCase, 11>();
    cases[0u] = GpuRoutingStorageCase(16u, GpuRoutingPartialDagShape::DisjointPairs);
    cases[1u] = GpuRoutingStorageCase(64u, GpuRoutingPartialDagShape::DisjointPairs);
    cases[2u] = GpuRoutingStorageCase(130u, GpuRoutingPartialDagShape::DisjointPairs);
    cases[3u] = GpuRoutingStorageCase(256u, GpuRoutingPartialDagShape::DisjointPairs);
    cases[4u] = GpuRoutingStorageCase(257u, GpuRoutingPartialDagShape::DisjointPairs);
    cases[5u] = GpuRoutingStorageCase(382u, GpuRoutingPartialDagShape::FanOut);
    cases[6u] = GpuRoutingStorageCase(382u, GpuRoutingPartialDagShape::FanIn);
    cases[7u] = GpuRoutingStorageCase(513u, GpuRoutingPartialDagShape::ReversedPairs);
    cases[8u] = GpuRoutingStorageCase(4032u, GpuRoutingPartialDagShape::DenseLayers);
    cases[9u] = GpuRoutingStorageCase(4033u, GpuRoutingPartialDagShape::DenseLayers);
    cases[10u] = GpuRoutingStorageCase(4097u, GpuRoutingPartialDagShape::DenseLayers);

    const usize bitsPerWord = 64u;
    const usize boundsBudgetDivisor = 32u;
    const usize reachabilityVectorCount = 4u;
    usize emptyVectorBookkeepingBytes = 0u;
    native(mut emptyVectorBookkeepingBytes){
        Core::Alloc::ScratchArena bookkeepingScratch(s_TaskGraphScratchArena);
        const Vector<u64, Core::Alloc::ScratchArena> emptyVector(bookkeepingScratch);
        emptyVectorBookkeepingBytes = bookkeepingScratch.memoryStats().usedBytes;
    }
    const usize reachabilityBookkeepingBytes = reachabilityVectorCount * emptyVectorBookkeepingBytes;
    for(in GpuRoutingStorageCase testCase : cases){
        const ScopedTestTrace traceTaskCount = ScopedTestTrace(testCase.taskCount);
        const ScopedTestTrace traceShape = ScopedTestTrace(cast<u32>(testCase.shape));
        TestArena testArena = TestArena();
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        native(mut graph, in testCase){
            ASSERT_NO_FATAL_FAILURE(GpuRoutingDeclarePartialDag(graph, testCase.taskCount, testCase.shape));
        }
        GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
        ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
        const GpuTaskGraphDeclarationReadView view = GpuTaskGraphDeclarationReadView(graph);
        ScratchArena scratch = ScratchArena(s_TaskGraphScratchArena);
        GpuTaskSchedulingReachability reachability = GpuTaskSchedulingReachability(scratch);
        ASSERT_EQ(scratch.memoryStats().usedBytes, reachabilityBookkeepingBytes);
        ASSERT_TRUE(BuildGpuTaskSchedulingReachability(view, analysis, reachability));
        const usize wordsPerRow = (testCase.taskCount + bitsPerWord - 1u) / bitsPerWord;
        const usize matrixBytes = testCase.taskCount * wordsPerRow * 8u;
        usize denseBytes = 0u;
        native(in matrixBytes, in testCase, mut denseBytes){
            denseBytes = matrixBytes + testCase.taskCount * (sizeof(u32) + 2u * sizeof(usize));
        }
        if(testCase.shape == GpuRoutingPartialDagShape::ReversedPairs){
            // A partial last tile and backward cross-word edges must not allocate the full square matrix.
            EXPECT_LT(scratch.memoryStats().peakUsedBytes, matrixBytes);
            EXPECT_TRUE(reachability.reaches(view.taskAt(512u).id, view.taskAt(511u).id));
            EXPECT_TRUE(reachability.reaches(view.taskAt(64u).id, view.taskAt(63u).id));
            EXPECT_FALSE(reachability.reaches(view.taskAt(63u).id, view.taskAt(64u).id));
        }
        else{
            usize boundsBudget = 0u;
            usize boundsBookkeepingBytes = 0u;
            if(wordsPerRow >= bitsPerWord){
                boundsBudget = matrixBytes / boundsBudgetDivisor;
                boundsBookkeepingBytes = emptyVectorBookkeepingBytes;
            }
            const usize peakBookkeepingBytes = reachabilityBookkeepingBytes + boundsBookkeepingBytes;
            EXPECT_LE(scratch.memoryStats().peakUsedBytes, denseBytes + boundsBudget + peakBookkeepingBytes);
        }
    }
}

void VerifyGpuRouting_RebuildingRelationsClearsCompactedDenseOrderedAndFailedState(){
    const usize taskCount = 513u;
    Array<GpuRoutingPartialDagShape, 6> shapes = Array<GpuRoutingPartialDagShape, 6>();
    shapes[0u] = GpuRoutingPartialDagShape::ReversedPairs;
    shapes[1u] = GpuRoutingPartialDagShape::DenseLayers;
    shapes[2u] = GpuRoutingPartialDagShape::OneEdge;
    shapes[3u] = GpuRoutingPartialDagShape::Independent;
    shapes[4u] = GpuRoutingPartialDagShape::TotalOrder;
    shapes[5u] = GpuRoutingPartialDagShape::ReversedPairs;

    TestArena testArena = TestArena();
    ScratchArena scratch = ScratchArena(s_TaskGraphScratchArena);
    GpuTaskSchedulingReachability reachability = GpuTaskSchedulingReachability(scratch);
    GpuTaskId previousTask = GpuTaskId();
    for(in GpuRoutingPartialDagShape shape : shapes){
        const ScopedTestTrace traceShape = ScopedTestTrace(cast<u32>(shape));
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        native(mut graph, in taskCount, in shape){
            ASSERT_NO_FATAL_FAILURE(GpuRoutingDeclarePartialDag(graph, taskCount, shape));
        }
        GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
        ASSERT_TRUE(Analyze(graph, scratch, analysis));
        const GpuTaskGraphDeclarationReadView view = GpuTaskGraphDeclarationReadView(graph);
        ASSERT_TRUE(BuildGpuTaskSchedulingReachability(view, analysis, reachability));
        for(usize source = 0u; source < taskCount; ++source){
            for(usize destination = 0u; destination < taskCount; ++destination){
                const GpuTaskId from = view.taskAt(source).id;
                const GpuTaskId to = view.taskAt(destination).id;
                const b8 expectedForward = GpuRoutingExpectedPartialDagReach(shape, source, destination);
                const b8 expectedBackward = GpuRoutingExpectedPartialDagReach(shape, destination, source);
                EXPECT_EQ(reachability.reaches(from, to), expectedForward);
                EXPECT_EQ(reachability.transitivelyIndependent(from, to), source != destination && !expectedForward && !expectedBackward);
            }
        }
        EXPECT_FALSE(reachability.reaches(previousTask, view.taskAt(0u).id));
        EXPECT_FALSE(reachability.transitivelyIndependent(previousTask, view.taskAt(0u).id));
        previousTask = view.taskAt(0u).id;
    }
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    native(mut graph, in taskCount){
        ASSERT_NO_FATAL_FAILURE(GpuRoutingDeclarePartialDag(graph, taskCount, GpuRoutingPartialDagShape::ReversedPairs));
    }
    const GpuTaskGraphDeclarationReadView view = GpuTaskGraphDeclarationReadView(graph);
    GpuTaskGraphAnalysis invalidAnalysis = GpuTaskGraphAnalysis(testArena.arena);
    EXPECT_FALSE(BuildGpuTaskSchedulingReachability(view, invalidAnalysis, reachability));
    EXPECT_FALSE(reachability.reaches(view.taskAt(512u).id, view.taskAt(511u).id));
    EXPECT_FALSE(reachability.transitivelyIndependent(view.taskAt(0u).id, view.taskAt(1u).id));
}

void VerifyGpuRouting_PartialAssignmentsExcludeRelatedTasksWithoutRequiringOwnAssignment(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    ScratchArena declarationScratch = ScratchArena(s_TaskGraphScratchArena);
    native(mut graph){
        ASSERT_NO_FATAL_FAILURE(GpuRoutingDeclarePartialDag(graph, 4u, GpuRoutingPartialDagShape::OneEdge));
    }
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, declarationScratch, analysis));
    const GpuTaskGraphDeclarationReadView view = GpuTaskGraphDeclarationReadView(graph);
    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    const GpuPhysicalQueueTopology topology = MakeGpuRoutingTopology(queues);
    native(in testArena, in view, in analysis, in queues, in topology){
        Core::Alloc::ScratchArena scratch(s_TaskGraphScratchArena);
        GpuTaskSchedulingReachability reachability(scratch);
        ASSERT_TRUE(BuildGpuTaskSchedulingReachability(view, analysis, reachability));
        GpuTaskQueueScoringData scoringData(view, analysis, reachability, {}, scratch);
        Core::GraphicsVector<Core::GpuTaskQueueAssignment> assignments(testArena.arena);
        Core::GraphicsVector<u32> indices(4u, Limit<u32>::s_Max, testArena.arena);
        constexpr Array<usize, 2u> s_AssignedTasks = { 0u, 3u };
        for(const usize taskIndex : s_AssignedTasks){
            indices[taskIndex] = static_cast<u32>(assignments.size());
            assignments.push_back({ .task = view.taskAt(taskIndex).id, .initialQueue = queues[1u].id, .queue = queues[1u].id, .score = {} });
        }
        scoringData.rebuildAssignmentLoads(assignments, topology);
        const auto score = [&](const usize taskIndex, const GpuTaskQueueScoreExclusions exclusions = {})noexcept{
            return BuildQueueAssignmentScore(view, analysis, assignments, indices, topology, reachability, scoringData, view.taskAt(taskIndex), queues[0u], exclusions);
        };
        EXPECT_EQ(score(1u).overlap, 8);
        EXPECT_EQ(score(2u).overlap, 9);
        EXPECT_EQ(score(2u, { .assignmentOffset = 1u, .assignmentCount = 1u, .totalCost = 8u }).overlap, 1);
    }
}

void VerifyGpuRouting_OrderedAndUnusedReachabilityAvoidMaskAllocationsAcrossQueueLoadChanges(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    const usize taskCount = 129u;
    Array<b8, 2> buildReachabilityCases = Array<b8, 2>();
    buildReachabilityCases[0u] = false;
    buildReachabilityCases[1u] = true;
    for(in b8 buildReachability : buildReachabilityCases){
        const ScopedTestTrace traceBuild = ScopedTestTrace(buildReachability);
        TestArena testArena = TestArena();
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        GpuTaskId preceding = GpuTaskId();
        for(usize index = 0u; index < taskCount; ++index){
            GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
            scheduling.cost = GpuTaskCostHint::Large;
            const Expected<Name> derivedNameResult = IndexedName(s_GpuCaseQueueNoMasks, index);
            ASSERT_TRUE(derivedNameResult.has_value());
            Array<GpuTaskId, 1> singleDep = Array<GpuTaskId, 1>();
            singleDep[0u] = preceding;
            Span<GpuTaskId> depSpan = Span<GpuTaskId>();
            if(preceding.valid())
                depSpan = singleDep;
            const Expected<GpuTaskId> precedingTaskAdmission = AddTaskWithCommands(
                derivedNameResult.value(),
                "Ordered Queue Task",
                ComputeCommands(),
                scheduling,
                GpuTaskTimingMetadata(),
                depSpan,
                graph
            );
            ASSERT_TRUE(precedingTaskAdmission.has_value());
            preceding = precedingTaskAdmission.value();
            ASSERT_TRUE(preceding.valid());
        }
        GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
        ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
        const GpuTaskGraphDeclarationReadView view = GpuTaskGraphDeclarationReadView(graph);
        ScratchArena scratch = ScratchArena(s_TaskGraphScratchArena);
        GpuTaskSchedulingReachability reachability = GpuTaskSchedulingReachability(scratch);
        if(buildReachability){
            ASSERT_TRUE(BuildGpuTaskSchedulingReachability(view, analysis, reachability));
            ASSERT_FALSE(reachability.mayContainIndependentTasks());
        }
        Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
        queues[0u] = GraphicsQueue();
        queues[1u] = DedicatedComputeQueue(77u);
        native(in testArena, in view, in analysis, mut reachability, mut scratch, in queues, in buildReachability, in taskCount){
            const Core::GpuPhysicalQueueTopology topology{ .queues = queues.data(), .queueCount = buildReachability ? 2u : 1u };
            GpuTaskQueueScoringData scoringData(view, analysis, reachability, {}, scratch);
            Core::GraphicsVector<Core::GpuTaskQueueAssignment> assignments(testArena.arena);
            Core::GraphicsVector<u32> indices(testArena.arena);
            assignments.reserve(taskCount);
            indices.reserve(taskCount);
            for(usize index = 0u; index < taskCount; ++index){
                const auto queue = queues[index % topology.queueCount].id;
                assignments.push_back({ .task = view.taskAt(index).id, .initialQueue = queue, .queue = queue, .score = {} });
                indices.push_back(static_cast<u32>(index));
            }
            const auto expectScoresWithoutMasks = [&](){
                // Zero capacity proves neither optional index allocated storage, rather than merely clearing its contents.
                EXPECT_EQ(scoringData.taskCostGroups.capacity(), 0u);
                EXPECT_EQ(scoringData.assignedCostWords.capacity(), 0u);
                for(usize candidateIndex = 0u; candidateIndex < topology.queueCount; ++candidateIndex){
                    const auto& candidate = queues[candidateIndex];
                    for(usize index = 0u; index < taskCount; ++index){
                        i32 expectedLoad = 0;
                        for(usize other = 0u; other < taskCount; ++other){
                            if(other != index && assignments[other].queue == candidate.id)
                                expectedLoad += 8;
                        }
                        const auto score = BuildQueueAssignmentScore(view, analysis, assignments, indices, topology, reachability, scoringData, view.taskAt(index), candidate);
                        EXPECT_EQ(score.queueLoad, expectedLoad);
                        EXPECT_EQ(score.overlap, 0);
                        EXPECT_EQ(score.incomingCrossings, index != 0u && assignments[index - 1u].queue != candidate.id ? 1 : 0);
                        EXPECT_EQ(score.outgoingCrossings, index + 1u < taskCount && assignments[index + 1u].queue != candidate.id ? 1 : 0);
                        EXPECT_EQ(score.ownershipTransfers, 0);
                    }
                }
            };
            scoringData.rebuildAssignmentLoads(assignments, topology);
            expectScoresWithoutMasks();
            auto& moved = assignments[taskCount / 2u];
            const auto destination = queues[topology.queueCount - 1u].id;
            scoringData.updateAssignmentLoads(moved.task, moved.queue, destination);
            moved.queue = destination;
            expectScoresWithoutMasks();
            scoringData.rebuildAssignmentLoads(assignments, topology);
            expectScoresWithoutMasks();
        }
    }
}

void VerifyGpuRouting_RoutesOptedInWorkAcrossSameClassPhysicalQueues(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuGraphResourceId> bufferResult = AddBufferMetadata(graph, s_GpuCaseTaskGraphSameClassBuffer, "Same Class Buffer");
    ASSERT_TRUE(bufferResult.has_value());
    const GpuGraphResourceId buffer = bufferResult.value();
    ASSERT_TRUE(buffer.valid());

    GpuTaskCommandRequirements graphicsCommands = GpuTaskCommandRequirements();
    graphicsCommands.requiredCapabilities = GpuQueueCapability::Graphics;

    GpuTaskSchedulingHint producerScheduling = GpuTaskSchedulingHint();
    producerScheduling.cost = GpuTaskCostHint::Large;
    producerScheduling.allowSameClassQueueRouting = true;
    Array<GpuTaskResourceUse, 1> producerUses = Array<GpuTaskResourceUse, 1>();
    producerUses[0u].resource = buffer;
    producerUses[0u].requiredState = ResourceStates::CopyDest;
    producerUses[0u].access = GpuTaskResourceAccess::Write;
    GpuTaskDesc producerDesc = GpuTaskDesc();
    producerDesc.setIdentity(s_GpuCaseTaskGraphSameClassProducer);
    producerDesc.setMarkerLabel("Same Class Producer");
    producerDesc.setScheduling(producerScheduling);
    producerDesc.setResourceUses(producerUses);
    const Expected<GpuTaskId> producerResult = graph.addTask(producerDesc, graphicsCommands);
    ASSERT_TRUE(producerResult.has_value());
    const GpuTaskId producer = producerResult.value();
    ASSERT_TRUE(producer.valid());

    GpuTaskSchedulingHint consumerScheduling = GpuTaskSchedulingHint();
    consumerScheduling.cost = GpuTaskCostHint::Medium;
    consumerScheduling.allowSameClassQueueRouting = true;
    Array<GpuTaskId, 1> consumerDependencies = Array<GpuTaskId, 1>();
    consumerDependencies[0u] = producer;
    Array<GpuTaskResourceUse, 1> consumerUses = Array<GpuTaskResourceUse, 1>();
    consumerUses[0u].resource = buffer;
    consumerUses[0u].requiredState = ResourceStates::CopySource;
    consumerUses[0u].access = GpuTaskResourceAccess::Read;
    GpuTaskDesc consumerDesc = GpuTaskDesc();
    consumerDesc.setIdentity(s_GpuCaseTaskGraphSameClassConsumer);
    consumerDesc.setMarkerLabel("Same Class Consumer");
    consumerDesc.setScheduling(consumerScheduling);
    consumerDesc.setDependencies(consumerDependencies);
    consumerDesc.setResourceUses(consumerUses);
    const Expected<GpuTaskId> consumerResult = graph.addTask(consumerDesc, graphicsCommands);
    ASSERT_TRUE(consumerResult.has_value());
    const GpuTaskId consumer = consumerResult.value();
    ASSERT_TRUE(consumer.valid());

    GpuPhysicalQueueInfo secondaryGraphicsQueue = GraphicsQueue(1u);
    secondaryGraphicsQueue.queueIndex = 1u;
    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = secondaryGraphicsQueue;
    const GpuPhysicalQueueTopology topology = MakeGpuRoutingTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(Compile(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

    native(in assignments, in compiledPlan, in producer, in consumer, in queues){
        const Core::GpuTaskQueueAssignment* const producerAssignment = assignments.find(producer);
        const Core::GpuTaskQueueAssignment* const consumerAssignment = assignments.find(consumer);
        ASSERT_NE(producerAssignment, nullptr);
        ASSERT_NE(consumerAssignment, nullptr);
        EXPECT_EQ(producerAssignment->queue, queues[0u].id);
        EXPECT_EQ(consumerAssignment->queue, queues[1u].id);

        const Core::GpuSubmissionPacketId producerPacket = compiledPlan.packetForTask(producer);
        const Core::GpuSubmissionPacketId consumerPacket = compiledPlan.packetForTask(consumer);
        const Core::GpuCompiledTask* const compiledProducer = compiledPlan.findTask(producer).plan;
        const Core::GpuCompiledTask* const compiledConsumer = compiledPlan.findTask(consumer).plan;
        ASSERT_TRUE(producerPacket.valid());
        ASSERT_TRUE(consumerPacket.valid());
        ASSERT_NE(compiledProducer, nullptr);
        ASSERT_NE(compiledConsumer, nullptr);
        EXPECT_NE(compiledPlan.packet(producerPacket).plan->queue, compiledPlan.packet(consumerPacket).plan->queue);
        ASSERT_EQ(compiledPlan.packet(consumerPacket).plan->dependencyCount, 1u);
        EXPECT_EQ(compiledPlan.packet(consumerPacket).dependencies[0u].producer, producerPacket);
        ASSERT_EQ(compiledConsumer->prologueStateSeedCount, 1u);
        EXPECT_EQ(compiledProducer->epilogueBarrierCount, 0u);
        ASSERT_EQ(compiledConsumer->prologueBarrierCount, 1u);
        EXPECT_EQ(compiledPlan.findTask(consumer).prologueBarriers[0u].type, Core::GpuCompiledBarrierType::BufferTransition);
    }
}

void VerifyGpuRouting_PreservesLatestDirectDependencyRouteAcrossIncomingAdjacencyOrder(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);

    GpuTaskCommandRequirements graphicsCommands = GpuTaskCommandRequirements();
    graphicsCommands.requiredCapabilities = GpuQueueCapability::Graphics;

    GpuTaskSchedulingHint producerScheduling = GpuTaskSchedulingHint();
    producerScheduling.cost = GpuTaskCostHint::Large;
    producerScheduling.allowSameClassQueueRouting = true;
    const Expected<GpuTaskId> firstResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphDirectAffinityOrderFirst,
        "Direct Affinity Order First",
        graphicsCommands,
        producerScheduling,
        GpuTaskTimingMetadata(),
        Span<GpuTaskId>(),
        graph
    );
    ASSERT_TRUE(firstResult.has_value());
    const GpuTaskId first = firstResult.value();
    const Expected<GpuTaskId> secondResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphDirectAffinityOrderSecond,
        "Direct Affinity Order Second",
        graphicsCommands,
        producerScheduling,
        GpuTaskTimingMetadata(),
        Span<GpuTaskId>(),
        graph
    );
    ASSERT_TRUE(secondResult.has_value());
    const GpuTaskId second = secondResult.value();
    ASSERT_TRUE(first.valid());
    ASSERT_TRUE(second.valid());

    GpuTaskSchedulingHint consumerScheduling = GpuTaskSchedulingHint();
    consumerScheduling.cost = GpuTaskCostHint::Tiny;
    consumerScheduling.allowSameClassQueueRouting = true;
    consumerScheduling.preserveSameClassQueueWithDirectDependency = true;
    Array<GpuTaskId, 2> consumerDependencies = Array<GpuTaskId, 2>();
    consumerDependencies[0u] = second;
    consumerDependencies[1u] = first;
    const Expected<GpuTaskId> consumerResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphDirectAffinityOrderConsumer,
        "Direct Affinity Order Consumer",
        graphicsCommands,
        consumerScheduling,
        GpuTaskTimingMetadata(),
        consumerDependencies,
        graph
    );
    ASSERT_TRUE(consumerResult.has_value());
    const GpuTaskId consumer = consumerResult.value();
    ASSERT_TRUE(consumer.valid());

    GpuPhysicalQueueInfo auxiliaryGraphicsQueue = GraphicsQueue(1u);
    auxiliaryGraphicsQueue.queueIndex = 1u;
    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = auxiliaryGraphicsQueue;
    const GpuPhysicalQueueTopology topology = MakeGpuRoutingTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    ASSERT_EQ(analysis.topologicalOrder().size(), 3u);
    EXPECT_EQ(analysis.topologicalOrder()[0u], first);
    EXPECT_EQ(analysis.topologicalOrder()[1u], second);
    EXPECT_EQ(analysis.topologicalOrder()[2u], consumer);
    const GpuTaskGraphSchedulingTaskIndexView producers = analysis.schedulingProducers(consumer);
    ASSERT_EQ(producers.taskCount, 2u);
    EXPECT_EQ(producers[0u], second.index);
    EXPECT_EQ(producers[1u], first.index);

    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology));
    native(in assignments, in first, in second, in consumer, in queues, in auxiliaryGraphicsQueue){
        const Core::GpuTaskQueueAssignment* const firstAssignment = assignments.find(first);
        const Core::GpuTaskQueueAssignment* const secondAssignment = assignments.find(second);
        const Core::GpuTaskQueueAssignment* const consumerAssignment = assignments.find(consumer);
        ASSERT_NE(firstAssignment, nullptr);
        ASSERT_NE(secondAssignment, nullptr);
        ASSERT_NE(consumerAssignment, nullptr);
        EXPECT_EQ(firstAssignment->queue, queues[0u].id);
        EXPECT_EQ(secondAssignment->queue, auxiliaryGraphicsQueue.id);
        EXPECT_EQ(consumerAssignment->queue, auxiliaryGraphicsQueue.id);
        EXPECT_TRUE(consumerAssignment->modifiers & Core::GpuTaskQueueAssignmentModifier::DirectDependencyAffinity);
    }
}

void VerifyGpuRouting_RetainsSameFamilyRoutingWithoutCrossFamilyOptIn(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);

