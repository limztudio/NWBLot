native{
#include <impl/global.adhd.h>

#include <core/graphics/gpu_timing.h>
#include <core/task/gpu/task_graph.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererRayTracingSystem;
class DeferredGraphResourceImportResult;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct PostGbufferNormalizeInputs{
    const DeferredGraphResourceImportResult& resources;
    Span<const Core::GpuGraphResourceId> shadowTraceGeometryResources;
    Core::GpuGraphResourceSetId shadowTraceGeometrySet;
    Core::GpuTaskId gbufferCompletionTask;
    const Core::GpuTaskId& shadowVisibilityTask;
    Optional<Core::GpuTimingMeasure>& asyncPrefixTiming;
    Core::GpuTimingSubmissionTicket*& timingTicket;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class PostGbufferNormalizeBuilder final : NoCopy{
public:
    PostGbufferNormalizeBuilder(Core::GpuTaskGraph& graph, RendererRayTracingSystem& raytracingSystem)noexcept
        : m_graph(graph)
        , m_raytracingSystem(raytracingSystem)
    {}


public:
    [[nodiscard]] Expected<Core::GpuTaskId> declare(const PostGbufferNormalizeInputs& inputs, Core::Alloc::ScratchArena& scratchArena);


private:
    Core::GpuTaskGraph& m_graph;
    RendererRayTracingSystem& m_raytracingSystem;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
}


