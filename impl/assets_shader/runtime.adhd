register_asset VertexShader using AssetCodecRegistration<ShaderAssetCodec<VertexShader>>;
register_asset HullShader using AssetCodecRegistration<ShaderAssetCodec<HullShader>>;
register_asset DomainShader using AssetCodecRegistration<ShaderAssetCodec<DomainShader>>;
register_asset GeometryShader using AssetCodecRegistration<ShaderAssetCodec<GeometryShader>>;
