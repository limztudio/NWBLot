void VerifyUiTextAreaScrollTests_ResetThenScrollSeedsANewInitialBinding(mut UiTextAreaScrollTests self){
    ASSERT_TRUE(self.m_model.setText(UiTextAreaScrollDenseText()));
    ASSERT_TRUE(self.frameArea(1u, UiTextAreaScrollSmallOptions()));
    self.m_state.reset();
    ASSERT_TRUE(self.m_state.scrollTo(Point(17.0f, 19.0f)));
    const u64 revision = self.m_state.revision();
    ASSERT_TRUE(self.frameArea(2u, UiTextAreaScrollSmallOptions()));
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, 17.0f);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 19.0f);
    EXPECT_EQ(self.m_state.revision(), revision);
}

void VerifyUiTextAreaScrollTests_DocumentEdgesRevealCombiningMarksAndFallbackInkBeyondLogicalLines(mut UiTextAreaScrollTests self){
    ASSERT_TRUE(self.installKoreanFallback());
    self.useHost();
    self.m_builder.style().fontSize = 24.0f;
    const StringView text = "A\xcc\x81\xcc\x81\n\xed\x95\x9c\xea\xb8\x80 \xec\xa1\xb0\xed\x95\xa9\nMMMMMMMMMMMMMMMMMMMMMMMMg\xcc\xa3";
    ASSERT_TRUE(self.m_model.setText(text));
    ASSERT_TRUE(self.m_model.setSelection(0u, 0u));
    EditBoxView reference = EditBoxView(self.m_arena);
    ASSERT_TRUE(reference.snapshot(self.m_model));
    ASSERT_EQ(reference.shape(self.m_text, MakeUiTextScrollShapeRequest("", 24.0f)), TextLayoutStatus::Success);
    ASSERT_TRUE(reference.measure(self.m_text, MakeUiTextScrollDisplayMetrics(800.0f, 600.0f, 1.0f, 1.0f)));
    const Rect visual = reference.visualBounds();
    const Point logical = reference.layout().measure();
    ASSERT_LT(visual.y, 0.0f);
    ASSERT_GT(visual.y + visual.height, logical.y);
    b8 sawLatin = false;
    b8 sawKorean = false;
    for(usize index = 0u; index < reference.layout().glyphs().size(); ++index){
        const PlacedGlyph glyph = reference.layout().glyphs()[index];
        ASSERT_TRUE(cast<b8>(glyph.face));
        sawLatin = sawLatin || FontFaceIdentityName(glyph.face) == Name(s_TestLatinFontPath);
        sawKorean = sawKorean || FontFaceIdentityName(glyph.face) == Name(s_TestKoreanFontPath);
    }
    ASSERT_TRUE(sawLatin && sawKorean);
    TextAreaOptions options = TextAreaOptions();
    options.width = LayoutSize(LayoutSizePolicy::Fixed, 120.0f);
    options.height = LayoutSize(LayoutSizePolicy::Fixed, 90.0f);
    ASSERT_TRUE(self.frameArea(1u, options));
    const EditBoxPlacement first = self.m_state.placement();
    EXPECT_FLOAT_EQ(first.scroll, 0.0f);
    EXPECT_FLOAT_EQ(first.scrollY, 0.0f);
    EXPECT_NEAR(first.textOrigin.x + visual.x, first.content.x, 0.001f);
    EXPECT_NEAR(first.textOrigin.y + visual.y, first.content.y, 0.001f);
    EXPECT_GE(first.caret.y, first.content.y);
    EXPECT_LE(first.caret.y + first.caret.height, first.content.y + first.content.height);
    self.m_host.key(UiTextScrollBakedKey::End, true);
    ASSERT_TRUE(self.frameArea(2u, options));
    EXPECT_EQ(self.m_model.caret(), text.size());
    const EditBoxPlacement last = self.m_state.placement();
    ASSERT_GT(last.scroll, 0.0f);
    ASSERT_GT(last.scrollY, 0.0f);
    EXPECT_NEAR(cast<f64>(last.scroll), self.m_state.scrollbars().horizontal.maximum, 0.001);
    EXPECT_NEAR(cast<f64>(last.scrollY), self.m_state.scrollbars().vertical.maximum, 0.001);
    EXPECT_NEAR(last.textOrigin.x + visual.x + visual.width + last.caret.width, last.content.x + last.content.width, 0.001f);
    EXPECT_NEAR(last.textOrigin.y + visual.y + visual.height, last.content.y + last.content.height, 0.001f);
    const auto endCaret = reference.caretGeometry().caretRect(text.size());
    ASSERT_TRUE(endCaret.has_value());
    EXPECT_FLOAT_EQ(last.caret.x, last.textOrigin.x + endCaret.value().x);
    EXPECT_FLOAT_EQ(last.caret.y, last.textOrigin.y + endCaret.value().y);
    const auto hit = reference.hitTest(Point(last.caret.x, last.caret.height * 0.5f + last.caret.y), last);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), text.size());
    ASSERT_EQ(self.m_host.publications.size(), 2u);
    ExpectUiRect(self.m_host.publications[1u].placement.caret, last.caret);
    self.m_host.key(UiTextScrollBakedKey::Home, true);
    ASSERT_TRUE(self.frameArea(3u, options));
    EXPECT_EQ(self.m_model.caret(), 0u);
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, 0.0f);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
    EXPECT_NEAR(self.m_state.placement().textOrigin.y + visual.y, self.m_state.placement().content.y, 0.001f);
    ASSERT_TRUE(self.m_state.scrollTo(Point(10000.0f, 10000.0f)));
    ASSERT_TRUE(self.frameArea(4u, options));
    EXPECT_EQ(self.m_model.caret(), 0u);
    EXPECT_NEAR(self.m_state.scroll().x, last.scroll, 0.001f);
    EXPECT_NEAR(self.m_state.scroll().y, last.scrollY, 0.001f);
    const EditBoxPlacement scrolled = self.m_state.placement();
    const f32 scrolledInkBottom = scrolled.textOrigin.y + visual.y + visual.height;
    EXPECT_NEAR(scrolledInkBottom, scrolled.content.y + scrolled.content.height, 0.001f);
}

void VerifyUiTextAreaScrollTests_SingleLineVisualMeasurementRefreshesAcrossDpiAndTextChangesWithoutMovingCaretStops(mut UiTextAreaScrollTests self){
    EditModel model = EditModel(self.m_arena);
    EditBoxView view = EditBoxView(self.m_arena);
    ASSERT_TRUE(model.setText("A\xcc\x81\xcc\x81 g\xcc\xa3"));
    ASSERT_TRUE(view.snapshot(model));
    ASSERT_EQ(view.shape(self.m_text, MakeUiTextScrollShapeRequest("", 17.3f)), TextLayoutStatus::Success);
    const Point logical = view.layout().measure();
    ExpectUiRect(view.visualBounds(), Rect(0.0f, 0.0f, logical.x, logical.y));
    const auto logicalCaret = view.caretGeometry().caretRect(view.displayCaret());
    ASSERT_TRUE(logicalCaret.has_value());
    Rect previous = Rect();
    b8 changedWithScale = false;
    Array<f32, 3u> scales;
    scales[0u] = 1.0f;
    scales[1u] = 1.5f;
    scales[2u] = 2.0f;
    for(in f32 scale : scales){
        const DisplayMetrics display = MakeUiTextScrollDisplayMetrics(800.0f, 600.0f, scale, scale);
        const auto expected = self.m_text.measure(view.layout(), display);
        ASSERT_TRUE(expected.has_value());
        ASSERT_TRUE(view.measure(self.m_text, display));
        ExpectUiRect(view.visualBounds(), expected.value());
        EXPECT_FLOAT_EQ(view.layout().measure().x, logical.x);
        EXPECT_FLOAT_EQ(view.layout().measure().y, logical.y);
        const auto caret = view.caretGeometry().caretRect(view.displayCaret());
        ASSERT_TRUE(caret.has_value());
        ExpectUiRect(caret.value(), logicalCaret.value());
        const f32 caretWidth = 1.0f / scale;
        const Rect bounds = Rect(20.25f, 30.75f, expected.value().width + caretWidth, expected.value().height);
        const auto placement = view.arrange(bounds, Insets(), Rect(0.0f, 0.0f, 800.0f, 600.0f), Point(), caretWidth);
        ASSERT_TRUE(placement.has_value());
        EXPECT_NEAR(placement.value().textOrigin.x + expected.value().x, bounds.x, 0.001f);
        EXPECT_NEAR(placement.value().textOrigin.y + expected.value().y, bounds.y, 0.001f);
        EXPECT_NEAR(placement.value().textOrigin.y + expected.value().y + expected.value().height, bounds.y + bounds.height, 0.001f);
        EXPECT_FLOAT_EQ(placement.value().caret.x, placement.value().textOrigin.x + logicalCaret.value().x);
        EXPECT_FLOAT_EQ(placement.value().caret.y, placement.value().textOrigin.y + logicalCaret.value().y);
        if(scale != 1.0f)
            changedWithScale = changedWithScale || previous.x != expected.value().x || previous.y != expected.value().y || previous.width != expected.value().width || previous.height != expected.value().height;
        previous = expected.value();
    }
    EXPECT_TRUE(changedWithScale);
    EXPECT_FALSE(view.measure(self.m_text, MakeUiTextScrollDisplayMetrics(800.0f, 600.0f, 0.0f, 1.0f)));
    ExpectUiRect(view.visualBounds(), previous);
    ASSERT_TRUE(model.setText("x"));
    ASSERT_TRUE(view.snapshot(model));
    EXPECT_FALSE(view.ready());
    ASSERT_EQ(view.shape(self.m_text, MakeUiTextScrollShapeRequest("", 17.3f)), TextLayoutStatus::Success);
    const Point replacementLogical = view.layout().measure();
    ExpectUiRect(view.visualBounds(), Rect(0.0f, 0.0f, replacementLogical.x, replacementLogical.y));
    ASSERT_TRUE(view.measure(self.m_text, MakeUiTextScrollDisplayMetrics(800.0f, 600.0f, 1.0f, 1.0f)));
    const auto replacement = self.m_text.measure(view.layout(), MakeUiTextScrollDisplayMetrics(800.0f, 600.0f, 1.0f, 1.0f));
    ASSERT_TRUE(replacement.has_value());
    ExpectUiRect(view.visualBounds(), replacement.value());
    EXPECT_LT(view.visualBounds().height, previous.height);
}


