const u32 s_SceneMaxLights = 64u;

const f32 s_Rec709LuminanceRed = 0.2126f;
const f32 s_Rec709LuminanceGreen = 0.7152f;
const f32 s_Rec709LuminanceBlue = 0.0722f;
const f32 s_LightTypeDirectionalMax = 0.5f;
const f32 s_LightTypePointMax = 1.5f;

class SceneShadingBufferUploads{
    public Array<SceneLightGpuData, 64u> lightData;
    public SceneShadingGpuData sceneShadingState;
    public RayTracingLightingClassification lightingClassification;
    public u32 lightCount = 0u;
    public b8 lightUploadRequired = false;
    public b8 sceneShadingUploadRequired = false;
}

f32 CausticSlotImportanceData(in f32x4 colorIntensity){
    const f32 luminance = dot(colorIntensity, f32x4(s_Rec709LuminanceRed, s_Rec709LuminanceGreen, s_Rec709LuminanceBlue, 0.0f));
    const f32 intensity = max(colorIntensity.w, 0.0f);
    return luminance * intensity;
}


