[cpp_header("<core/telemetry/event.h>"), cpp_name("::NWB::Core::Telemetry::CaptureFlag::Mask")]
extern enum TelemetryCaptureFlag : u32{
    None,
    TextLog,
    Diagnostic,
    Perf,
    FrameGraph,
    All
};

[cpp_header("<core/telemetry/event.h>"), cpp_name("::NWB::Core::Telemetry::EventKind::Enum")]
extern enum EventKind : u16{
    Unknown,
    TextLog,
    Diagnostic,
    PerfFrame,
    FrameGraphFrame,
    MemoryFrame
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<core/telemetry/event.h>"), cpp_name("::NWB::Core::Telemetry::CaptureOptions"), cpp_flags(small_value, binary_serializable, brace_init)]
extern class TelemetryCaptureOptions{
    TelemetryCaptureFlag flags;
    b8 diagnosticEnabled(...)const;
    b8 enabled(...)const;
    b8 frameGraphEnabled(...)const;
    b8 perfEnabled(...)const;
};

[cpp_header("<core/telemetry/event.h>"), cpp_name("::NWB::Core::Telemetry::EventHeader"), cpp_flags(binary_serializable, brace_init)]
extern class EventHeader{
    u64 frameIndex;
    u64 timestampNanoseconds;
    u64 payloadBytes;
    u32 magic;
    u32 streamId;
    u16 version;
    EventKind kind;
    u8 reserved;
    b8 valid(...)const;
};


