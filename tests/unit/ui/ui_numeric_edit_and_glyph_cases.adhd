void VerifyUiNumericSelectionEpochTests_LaterSiblingSourceRejectsAnAlreadyPaintedFloatSelectionRoundTrip(mut UiNumericSelectionEpochTests self){
    self.useHost();
    ASSERT_TRUE(self.m_float.setValue(1.25));
    UiNumericSelectionEpochSource source = UiNumericSelectionEpochSource();
    ListState list = ListState();
