[cpp_name("::NameTextError::Enum")]
extern enum NameTextError : u8{
    NullText,
    EmbeddedNull
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_name("::NameHash"), cpp_flags(self_defaulted, binary_serializable, brace_init, equality_switch)]
extern class NameHash{
    Array<u64, 8u> qwords;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<global/name_hash.h>"), cpp_name("::ComputeNameHash<char>")]
extern Expected<NameHash, NameTextError> ComputeNameHash(in StringView a0);

[cpp_name("::FoldNameHash64")]
extern u64 FoldNameHash64(in NameHash a0);

[cpp_name("::IsZeroHash")]
extern b8 IsZeroHash(in NameHash a0);

[cpp_name("::LessNameHash")]
extern b8 LessNameHash(in NameHash a0, in NameHash a1);

[cpp_name("::UpdateFnv64NameHash")]
extern u64 UpdateFnv64NameHash(in isize a0, in NameHash a1);


