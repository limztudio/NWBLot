void VerifyLogRowPainter_EmptyErrorRowsUseAlternatingColorsAndRestoreDeviceContext(){
    if(!IsWindowsLoggerCrashPlatform())
        return;

    LoggerTestArena testArena = LoggerTestArena();
    u32 firstPixel = 0u;
    u32 secondPixel = 0u;
    u32 restoredTextColor = 0u;
    i32 restoredBkMode = 0;
    u32 expectedFirstPixel = 0u;
    u32 expectedSecondPixel = 0u;
    u32 expectedTextColor = 0u;
    i32 expectedBkMode = 0;
    native(mut testArena, mut firstPixel, mut secondPixel, mut restoredTextColor, mut restoredBkMode, mut expectedFirstPixel, mut expectedSecondPixel, mut expectedTextColor, mut expectedBkMode){
#if defined(FOUNDATION_PLATFORM_WINDOWS)
        const HDC dc = CreateCompatibleDC(nullptr);
        ASSERT_NE(dc, nullptr);
        ScopeExit releaseDc([&]()noexcept{ DeleteDC(dc); });
        BITMAPINFO info{};
        info.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
        info.bmiHeader.biWidth = 4;
        info.bmiHeader.biHeight = -4;
        info.bmiHeader.biPlanes = 1;
        info.bmiHeader.biBitCount = 32;
        info.bmiHeader.biCompression = BI_RGB;
        void* pixels = nullptr;
        const HBITMAP bitmap = CreateDIBSection(dc, &info, DIB_RGB_COLORS, &pixels, nullptr, 0u);
        ASSERT_NE(bitmap, nullptr);
        ScopeExit releaseBitmap([&]()noexcept{ DeleteObject(bitmap); });
        const HGDIOBJ previous = SelectObject(dc, bitmap);
        ASSERT_TRUE(previous && previous != HGDI_ERROR);
        ScopeExit restoreBitmap([&]()noexcept{ SelectObject(dc, previous); });
        ASSERT_NE(pixels, nullptr);
        ASSERT_NE(SetTextColor(dc, RGB(3, 4, 5)), CLR_INVALID);
        ASSERT_NE(SetBkMode(dc, OPAQUE), 0);
        Log::FrameDetail::MessageItem message(Log::LogString(FOUNDATION_TEXT(""), testArena.arena), Core::Common::LogType::Error);
        DRAWITEMSTRUCT item{};
        item.hDC = dc;
        item.rcItem = RECT{ 0, 0, 4, 4 };
        Log::FrameDetail::LogRowPainter::Draw(item, message);
        firstPixel = static_cast<u32>(GetPixel(dc, 1, 1));
        item.itemID = 1u;
        Log::FrameDetail::LogRowPainter::Draw(item, message);
        secondPixel = static_cast<u32>(GetPixel(dc, 1, 1));
        restoredTextColor = static_cast<u32>(GetTextColor(dc));
        restoredBkMode = GetBkMode(dc);
        expectedFirstPixel = static_cast<u32>(RGB(170, 0, 0));
        expectedSecondPixel = static_cast<u32>(RGB(200, 0, 0));
        expectedTextColor = static_cast<u32>(RGB(3, 4, 5));
        expectedBkMode = OPAQUE;
#endif
    }
    EXPECT_EQ(firstPixel, expectedFirstPixel);
    EXPECT_EQ(secondPixel, expectedSecondPixel);
    EXPECT_EQ(restoredTextColor, expectedTextColor);
    EXPECT_EQ(restoredBkMode, expectedBkMode);
}

void VerifyLogRowPainter_LongTextWrapsWithinHiddenParentClientWidth(){
    if(!IsWindowsLoggerCrashPlatform())
        return;

    LoggerTestArena testArena = LoggerTestArena();
    u32 measuredHeight = 0u;
    u32 singleRowHeight = 0u;
    native(mut testArena, mut measuredHeight, mut singleRowHeight){
#if defined(FOUNDATION_PLATFORM_WINDOWS)
        const HWND parent = CreateWindowEx(0, FOUNDATION_TEXT("STATIC"), FOUNDATION_TEXT(""), WS_POPUP, 0, 0, 60, 100, nullptr, nullptr, GetModuleHandle(nullptr), nullptr);
        ASSERT_NE(parent, nullptr);
        ScopeExit destroyParent([&]()noexcept{ DestroyWindow(parent); });
        const HWND child = CreateWindowEx(0, FOUNDATION_TEXT("STATIC"), FOUNDATION_TEXT(""), WS_CHILD, 0, 0, 60, 100, parent, nullptr, GetModuleHandle(nullptr), nullptr);
        ASSERT_NE(child, nullptr);
        SendMessage(child, WM_SETFONT, reinterpret_cast<WPARAM>(GetStockObject(DEFAULT_GUI_FONT)), FALSE);
        Log::FrameDetail::MessageItem message(Log::LogString(FOUNDATION_TEXT("A long message that must wrap across several narrow rows of the hidden logger window."), testArena.arena), Core::Common::LogType::Info);
        MEASUREITEMSTRUCT item{};
        Log::FrameDetail::LogRowPainter::Measure(parent, child, item, message);
        measuredHeight = static_cast<u32>(item.itemHeight);
        singleRowHeight = static_cast<u32>(Log::FrameDetail::LogRowPainter::s_FontHeight);
#endif
    }
    EXPECT_GT(measuredHeight, singleRowHeight);
}

void VerifyMinidumpBoundaryTests_MissingDumpRetainsNativeReadFailureInReturnedReport(mut MinidumpBoundaryTests self){
    if(!IsWindowsLoggerCrashPlatform())
        return;

    String actualReport = String();
    String expectedNativeDiagnostic = String();
    native(mut self, mut actualReport, mut expectedNativeDiagnostic){
#if defined(FOUNDATION_PLATFORM_WINDOWS)
        const auto missing = FileSize(self.m_directory / Core::Crash::PackageNames::s_ProcessDumpFileName);
        ASSERT_FALSE(missing);
        Log::CrashPackageSummary summary(self.m_testArena.arena);
        summary.platform = "windows";
        Log::CrashSymbolicationConfig config(self.m_testArena.arena);
        const Log::CrashScratchPath scratchDirectory(self.m_scratchArena, self.m_directory);
        const auto actual = Log::BuildCrashSymbolicationReport(scratchDirectory, summary, config, self.m_testArena.arena, self.m_scratchArena);
        actualReport.assign(actual.data(), actual.size());
        const auto nativeText = MakeDiagnosticEventText("native_category={}\nnative_code={}\n", missing.error().category().name(), missing.error().value());
        expectedNativeDiagnostic.assign(nativeText.view().data(), nativeText.view().size());
#endif
    }
    EXPECT_TRUE(Contains(StringView(actualReport), "status=not_decoded"));
    EXPECT_TRUE(Contains(StringView(actualReport), StringView(expectedNativeDiagnostic)));
}

void VerifyMinidumpBoundaryTests_TruncatedHeadersAndOutOfFileStreamDirectoriesCannotDecode(mut MinidumpBoundaryTests self){
    if(!IsWindowsLoggerCrashPlatform())
        return;

    u32 notDecodedCount = 0u;
    native(mut self, mut notDecodedCount){
#if defined(FOUNDATION_PLATFORM_WINDOWS)
        DumpBytes bytes(self.m_testArena.arena);
        bytes.resize(sizeof(MINIDUMP_HEADER), 0u);
        for(const usize size : Array<usize, 3u>{ 1u, sizeof(MINIDUMP_HEADER) - 1u, sizeof(MINIDUMP_HEADER) }){
            bytes.resize(size, 0u);
            const auto actual = self.report(bytes);
            ASSERT_TRUE(actual);
            if(actual->find("status=not_decoded") != Log::CrashReportText::npos)
                ++notDecodedCount;
        }
        bytes.resize(sizeof(MINIDUMP_HEADER), 0u);
        MINIDUMP_HEADER header{};
        header.Signature = MINIDUMP_SIGNATURE;
        header.Version = MINIDUMP_VERSION;
        header.StreamDirectoryRva = sizeof(MINIDUMP_HEADER);
        for(const ULONG count : Array<ULONG, 2u>{ 1u, Limit<ULONG>::s_Max }){
            header.NumberOfStreams = count;
            StoreDumpRecord(0u, header, bytes);
            const auto actual = self.report(bytes);
            ASSERT_TRUE(actual);
            if(actual->find("status=not_decoded") != Log::CrashReportText::npos)
                ++notDecodedCount;
        }
        header.NumberOfStreams = 1u;
        header.StreamDirectoryRva = Limit<RVA>::s_Max;
        StoreDumpRecord(0u, header, bytes);
        const auto actual = self.report(bytes);
        ASSERT_TRUE(actual);
        if(actual->find("status=not_decoded") != Log::CrashReportText::npos)
            ++notDecodedCount;
#endif
    }
    EXPECT_EQ(notDecodedCount, 6u);
}

void VerifyMinidumpBoundaryTests_TruncatedThreadListCountCannotReadBeyondItsAdmittedStream(mut MinidumpBoundaryTests self){
