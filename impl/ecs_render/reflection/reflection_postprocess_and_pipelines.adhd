////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ReflectionFeedbackExtentOrDeviceChanged(
    in u32 width,
    in u32 height,
    in u16 deviceGeneration,
    in u32 cachedWidth,
    in u32 cachedHeight,
    in u16 cachedDeviceGeneration
){
    return width != cachedWidth || height != cachedHeight || deviceGeneration != cachedDeviceGeneration;
}

b8 IsReflectionFeedbackActive(in b8 enabled, in b8 hybridTraceMode, in u32 maxHardwareRaysPerFrame){
    return enabled && hybridTraceMode && maxHardwareRaysPerFrame > 0u;
}

b8 IsReflectionSpatialFilterActive(in b8 spatialFilterEnabled, in u32 spatialRadius, in u32 maxSpatialRadius, in b8 traceActive){
    return spatialFilterEnabled && spatialRadius > 0u && spatialRadius <= maxSpatialRadius && traceActive;
}

u32 ReflectionSpatialRadiusPipelineIndex(in u32 spatialRadius){
    return spatialRadius - 1u;
}

b8 CanPrepareReflectionHardwarePipelines(in b8 prepareHardware, in b8 rayQuerySupported, in b8 hasAccelStructLayout){
    return prepareHardware && rayQuerySupported && hasAccelStructLayout;
}

b8 ResolveAcceptedReflectionOpticalTransport(in b8 metadataOpticalTransportEnabled, in b8 hardwareReady){
    return metadataOpticalTransportEnabled && hardwareReady;
}


