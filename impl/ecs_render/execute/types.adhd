////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/avboit/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const usize s_GraphicsPrefixTimingTaskCount = 8u;
const usize s_DeferredTimingTicketCapacity = 15u + s_AvboitTaskGraphTimingTicketCapacity;
// Capacity, not a runtime packet-count assumption.
const usize s_FrameExecuteLifecycleCallbackCapacity = 6u;
// Scene TLAS backing and the three BVH sort buffers; the CSG trace context adds one.
const usize s_ShadowPrepareFixedStateBufferCapacity = 4u;
const usize s_ShadowPrepareCsgStateBufferCapacity = 5u;
const usize s_SinglePersistentResourceCapacity = 1u;
const usize s_ShadowComputeScratchTextureCapacity = 15u;
const usize s_ShadowComputeScratchBufferCapacity = 12u;
const usize s_CausticsComputeScratchTextureCapacity = 4u;
const usize s_SurfelGiComputeScratchBufferCapacity = 6u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[reflect]
enum<u8> DeferredGraphicsPrefixTimingSlot{
    MeshViewSetup,
    SceneShadingSetup,
    DeferredClear,
    Gbuffer,
    CsgReceiverSpanBuild,
    CsgIntervalCombine,
    CsgIntervalSample,
    Normalize,
    kCount
}

[reflect]
enum<u8> LaggedLightingReport{
    Unreported,
    NoDedicatedAsyncCompute,
    BootstrapAccepted,
    ActiveHistoryAccepted,
    CurrentFrameAccepted
}

class GraphicsPrefixTimingResolutionResult{
    public usize uniquePacketCount = 0u;
    public b8 bindingsValid = true;
}

class OpaqueEmulationMergeValidationResult{
    public b8 packetsAreGraphics = false;
    public b8 opaqueComputeEmulationMerged = false;
    public b8 opaqueSharedComputeEmulationMerged = false;
    public b8 opaqueCsgReceiverComputeEmulationMerged = false;
    public b8 opaqueCsgIntervalSampleComputeEmulationMerged = false;
    public b8 csgIntervalClearBundleMerged = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsShadowPrepareStateCandidatePrepared(in b8 candidateBuilt, in b8 candidateValid, in b8 candidateEmpty, in b8 candidateRequired){
    if(!candidateBuilt)
        return false;
    if(candidateValid && !candidateEmpty)
        return true;
    return !candidateRequired;
}

b8 CanCommitShadowPrepareStateCandidate(in b8 candidateValid, in b8 candidateEmpty, in b8 candidateRequired){
    if(!candidateValid)
        return false;
    if(candidateEmpty && candidateRequired)
        return false;
    return true;
}

b8 AreDualPersistentStateSubsetsReady(in b8 firstReady, in b8 secondReady){
    return firstReady && secondReady;
}

b8 AreTriplePersistentStateSubsetsReady(in b8 firstReady, in b8 secondReady, in b8 thirdReady){
    return firstReady && secondReady && thirdReady;
}

b8 ShouldAcceptLightSpaceShadowCaptureOnVisibility(in b8 stateReady, in b8 hasLightSpacePreparedFlag){
    return stateReady && hasLightSpacePreparedFlag;
}

b8 ShouldBuildDirectDeferredLightingReturnStates(in b8 usesLaggedHistory){
    return !usesLaggedHistory;
}

usize SelectShadowPrepareFixedStateBufferCapacity(in b8 hasCsgTraceContextBuffer){
    if(hasCsgTraceContextBuffer)
        return s_ShadowPrepareCsgStateBufferCapacity;
    return s_ShadowPrepareFixedStateBufferCapacity;
}

b8 HasExpectedGraphicsPrefixTimingTaskCount(in usize taskCount){
    return taskCount == s_GraphicsPrefixTimingTaskCount;
}

b8 MatchesBoundGraphicsPrefixPacketCount(in usize ticketCount, in usize uniquePacketCount){
    return ticketCount == 1u + uniquePacketCount;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

