const StringView s_SuiteCoreGlobalExportsShadowAndLayoutSource =
    "enum<u8> Format {\r\n    Custom8 = 0,\r\n}\r\nclass Color {\r\n    public f32 luma = 1.0f;\r\n}\r\nf32 Viewport(in Color c) {\r\n    return c.luma;\r\n}\r\n[serialize]\r\nclass PackedUnalignedMat {\r\n    public u8 tag = 1u;\r\n    public f32x4x4u world = f32x4x4u();\r\n}\r\n[serialize]\r\nclass AlignedBoundsPacket {\r\n    public u8 tag = 1u;\r\n    public BoundingBox bounds = BoundingBox();\r\n}\r\nclass CustomInputHandler : IInputEventHandler {\r\n    public b8 keyboardCharInput(in u32 codePoint, in i32 mods)override {\r\n        return codePoint != 0u || mods != 0;\r\n    }\r\n}\r\nb8 InspectExports(in IFilesystem fs, in Path entryPath, in Span<u8> rawBytes, in f32x4x4u srcMat, mut f32x4x4u dstMat) {\r\n    Color localColor;\r\n    Format localFmt = Format::Custom8;\r\n    in IFilesystem localFs = fs;\r\n    DirectoryEntry entry = DirectoryEntry(entryPath);\r\n    ResourceStates mask = (ResourceStates::ShaderResource | ResourceStates::CopySource) ^ ResourceStates::CopySource;\r\n    MatrixSingle reg = MatrixSingle(srcMat);\r\n    dstMat = f32x4x4u(reg);\r\n    MatrixDecomposition decomp = MatrixDecomposition();\r\n    Sha1Digest digest = ComputeSha1(rawBytes);\r\n    usize alignedBytes = PersistentArenaStructureAlignedSize(64u);\r\n    DescriptorWriteItem emptyWrite = DescriptorWriteItem::None();\r\n    f32x3x4 joint = MatrixIdentity<f32x3x4>();\r\n    joint._14 = 2.0f;\r\n    MatrixSingle ident = MatrixIdentity();\r\n    f32x4x4 identStore = f32x4x4(ident);\r\n    return joint._14 == 2.0f && identStore._11 == 1.0f && localFs.mounted() && CanRepresentU64<u32>(cast<u32>(localFmt)) && Viewport(localColor) > 0.0f && mask == ResourceStates::ShaderResource && digest.bytes[0u] <= 255u && Sha1Digest::s_HexTextLength == 40u && BufferRange::s_AllBytes > 0u && alignedBytes >= 64u && emptyWrite.slot == 0u && !entry.path().empty() && IsFinite(decomp.scale.xyz);\r\n}\r\n";

const StringView s_SuiteHandleDerefRhiAndAssetExportsSource =
    "b8 AcceptMutBuffer(mut Buffer buf) {\r\n    return buf.getDeviceGeneration() != 0u;\r\n}\r\nb8 AcceptMutAsset(mut IAsset asset, mut Framebuffer fb) {\r\n    return fb.getDescription().colorAttachments.empty() || !asset.name().empty();\r\n}\r\nb8 ExerciseHandleRhiAndAssetExports(\r\n    mut GraphicsRuntime rt,\r\n    mut CommandList cmd,\r\n    mut BufferHandle buf,\r\n    mut TextureHandle tex,\r\n    mut UniquePtr<IAsset> assetPtr,\r\n    mut RefCountPtr<IAsset> rcAsset,\r\n    in Span<u8> indexBytes,\r\n    mut CookEntryRegistry entryRegistry,\r\n    in Name vp,\r\n    in AssetBunchExpandContext bunchCtx\r\n) {\r\n    mut Device dev = rt.getDevice();\r\n    b8 bufOk = buf.valid() && AcceptMutBuffer(buf.deref());\r\n    DescriptorWriteItem srv = DescriptorWriteItem::TextureSrv(0u, tex.deref());\r\n    srv.setDimension(TextureDimension::Texture2D);\r\n    cmd.open();\r\n    if(IsValidFramebufferPtr(rt.getFramebuffer(0u))){\r\n        cmd.setResourceStatesForFramebuffer(DerefFramebufferPtr(rt.getFramebuffer(0u)));\r\n    }\r\n    cmd.clearState();\r\n    cmd.close();\r\n    auto vpRes = BuildVirtualPathName(vp, \"default\", vp);\r\n    auto cmdStreamRes = ValidateGpuCommandIrStream(indexBytes);\r\n    auto bunchRes = ExpandAssetBunchForAssetCook(bunchCtx);\r\n    b8 assetOk = assetPtr.valid() && rcAsset.valid() && AcceptMutAsset(assetPtr.deref(), DerefFramebufferPtr(rt.getFramebuffer(0u))) && AcceptMutAsset(rcAsset.deref(), DerefFramebufferPtr(rt.getFramebuffer(0u)));\r\n    return dev.getDeviceGeneration() != 0u && bufOk && srv.slot == 0u && vpRes.hasValue() && cmdStreamRes.valid() && bunchRes.hasValue() && entryRegistry.has(vp) && entryRegistry.entryCount() == 0u && assetOk;\r\n}\r\n";

const StringView s_SuiteCrossNamespaceImportSource =
    "#include \"foreign_bridge.adhd\"\r\n[reflect]\r\nclass LocalMirror {\r\n    public ForeignMode mode = ForeignMode::Beta;\r\n    public ForeignItem item;\r\n    public FixedVector<u32, kForeignCap> caps;\r\n    public HashMap<ForeignMode, ForeignItem> modeMap;\r\n    public ForeignMode sentinel = ForeignMode::kCount;\r\n    public AssetRef<ForeignAsset> asset;\r\n}\r\nu32 UseForeign(in u32 x) {\r\n    u32 kForeignConst = 100u;\r\n    ForeignMode m = ForeignMode::Alpha;\r\n    ForeignItem it = ForeignItem();\r\n    if(ForeignAsset::s_AssetTypeName.empty())\r\n        return kForeignConst;\r\n    return ForeignFn(x) + kForeignConst + kForeignOther + kSameBridgeConst;\r\n}\r\n";

const StringView s_SuiteNestedTemplateAndDocumentVisitorSource =
    "[arena, asset(\"mock_nested\")]\r\nclass MockNestedAsset {\r\n    public u32 dummy = 0u;\r\n}\r\nb8 ExerciseNestedTemplatesAndVisitors(\r\n    mut AssetDocumentMetadataParseContext docCtx,\r\n    in Path nwbPath,\r\n    mut GpuDescriptorRetirementGuard guard,\r\n    in AssetManager assetMgr,\r\n    in Name vp\r\n) {\r\n    if(!docCtx.doc.parse(\"asset = { items = [1, 2], ref = \\\"mock/a\\\" };\")) {\r\n        for(in MetascriptParseError err : docCtx.doc.errors()) {\r\n            if(err.line > 0u)\r\n                return false;\r\n        }\r\n    }\r\n    if(!docCtx.doc.hasVariable(\"asset\"))\r\n        return false;\r\n    const b8 visited = docCtx.doc.visitVariable(\"asset\", lambda[in nwbPath](in MetascriptValue assetVal) -> b8 {\r\n        if(!ValidateMetadataAssetFields(nwbPath, assetVal, \"test\"))\r\n            return false;\r\n        if(!ValidateMetadataAssetFields(nwbPath, assetVal, \"test\", lambda[](in StringView key) -> b8 { return key == \"items\" || key == \"ref\"; }))\r\n            return false;\r\n        if(!assetVal.forEachMapEntry(lambda[](in StringView k, in MetascriptValue v) -> b8 { return !k.empty() && !v.isNull(); }))\r\n            return false;\r\n        assetVal.visitField(\"items\", lambda[](in MetascriptValue listVal) -> void {\r\n            for(in MetascriptValue item : listVal.listView()) {\r\n                if(!item.isNumeric())\r\n                    return;\r\n            }\r\n        });\r\n        Expected<AssetRef<MockNestedAsset>> refRes = ReadMetadataAssetRefField<MockNestedAsset>(nwbPath, assetVal, \"test\", \"ref\", false);\r\n        if(!refRes.hasValue())\r\n            return false;\r\n        AssetRef<MockNestedAsset> refVal = refRes.value();\r\n        refVal.reset();\r\n        return !refVal.valid();\r\n    });\r\n    guard.release();\r\n    Expected<UniquePtr<MockNestedAsset>> loaded = LoadTypedAssetSync<MockNestedAsset>(assetMgr, vp, \"test\");\r\n    return visited && loaded.hasValue() && loaded.value().valid();\r\n}\r\n";

CompilerTypeArg MakeTypeArgument(in StringView text){
    CompilerTypeArg result;
    result.constantText = text;
    return result;
}

b8 CompileNamed(in StringView source, in StringView path, in StringView name, mut HeapStorage arena, mut CompileResult result){
    CompilerOptions options;
    options.source = source;
    options.virtualFilePath = path;
    options.customNamespace = name;
    return CompileOptionsResult(options, arena, result);
}

void ExpectCompileFails(mut AdhdTestArena arena, in StringView source, in StringView virtualPath){
    CompileResult result = CompileResult(arena.arena);
    EXPECT_FALSE(Compile(source, virtualPath, arena.arena, result));
}

void ExpectCompileFailsWithMessage(mut AdhdTestArena arena, in StringView source, in StringView virtualPath, in StringView expectedMessage){
    CompileResult result = CompileResult(arena.arena);
    EXPECT_FALSE(Compile(source, virtualPath, arena.arena, result));
    ASSERT_FALSE(result.errors.empty());
    EXPECT_EQ(FirstErrorMessage(result), expectedMessage);
}

void VerifyAdhdPreprocessor_DeduplicatesRepeatedIncludes(){
    AdhdTestArena arena = AdhdTestArena();
    MockIncludeResolver resolver = MockIncludeResolver();

    CompileResult result = CompileResult(arena.arena);
    ASSERT_TRUE(CompileWithResolver(s_SuiteDedupAdhdSource, "impl/math/compute.adhd", resolver, arena.arena, result));
    EXPECT_EQ(resolver.resolveCallCount, 1u);

    CompileResult rawStringResult = CompileResult(arena.arena);
    ASSERT_TRUE(CompileWithResolver(s_SuiteNativeRawStringSource, "impl/math/raw_string.adhd", resolver, arena.arena, rawStringResult));
}

void VerifyAdhdCompiler_ReordersClassFieldsByDescendingAlignmentAndSize(){
    AdhdTestArena arena = AdhdTestArena();

    CompileResult result = CompileResult(arena.arena);
    ASSERT_TRUE(Compile(s_SuiteReorderFieldsSource, "impl/scene/transform_node.adhd", arena.arena, result));
    ASSERT_EQ(UnitClassCount(result), 1u);

    ASSERT_EQ(UnitClassOrderedFieldCount(result, 0u), 6u);
    EXPECT_EQ(UnitClassOrderedFieldName(result, 0u, 0u), "translation");
    EXPECT_EQ(UnitClassOrderedFieldAlign(result, 0u, 0u), 16u);
    EXPECT_EQ(UnitClassOrderedFieldName(result, 0u, 1u), "handle");
    EXPECT_EQ(UnitClassOrderedFieldAlign(result, 0u, 1u), 8u);
    EXPECT_EQ(UnitClassOrderedFieldName(result, 0u, 2u), "entityId");
    EXPECT_EQ(UnitClassOrderedFieldAlign(result, 0u, 2u), 4u);
    EXPECT_EQ(UnitClassOrderedFieldName(result, 0u, 3u), "layer");
    EXPECT_EQ(UnitClassOrderedFieldAlign(result, 0u, 3u), 2u);
    EXPECT_EQ(UnitClassOrderedFieldName(result, 0u, 4u), "dirty");
    EXPECT_EQ(UnitClassOrderedFieldAlign(result, 0u, 4u), 1u);
    EXPECT_EQ(UnitClassOrderedFieldName(result, 0u, 5u), "flags");
    EXPECT_EQ(UnitClassOrderedFieldAlign(result, 0u, 5u), 1u);
}

void VerifyAdhdCompiler_SerializeClassPacksTightlyInSourceOrder(){
    AdhdTestArena arena = AdhdTestArena();

    CompileResult result = CompileResult(arena.arena);
    ASSERT_TRUE(Compile(s_SuiteBinaryHeaderSource, "impl/assets/binary_header.adhd", arena.arena, result));
    ASSERT_EQ(UnitClassCount(result), 1u);

    EXPECT_TRUE(UnitClassIsSerialize(result, 0u));
    EXPECT_EQ(UnitClassTotalAlign(result, 0u), 1u);
    EXPECT_EQ(UnitClassTotalSize(result, 0u), 7u);
    ASSERT_EQ(UnitClassOrderedFieldCount(result, 0u), 3u);
    EXPECT_EQ(UnitClassOrderedFieldName(result, 0u, 0u), "magic");
    EXPECT_EQ(UnitClassOrderedFieldOffset(result, 0u, 0u), 0u);
    EXPECT_EQ(UnitClassOrderedFieldName(result, 0u, 1u), "version");
    EXPECT_EQ(UnitClassOrderedFieldOffset(result, 0u, 1u), 1u);
    EXPECT_EQ(UnitClassOrderedFieldName(result, 0u, 2u), "flags");
    EXPECT_EQ(UnitClassOrderedFieldOffset(result, 0u, 2u), 5u);

    CompileResult simdResult = CompileResult(arena.arena);
    ASSERT_TRUE(Compile(s_SuiteSimdPayloadSource, "impl/assets/simd_payload.adhd", arena.arena, simdResult));
    ASSERT_EQ(UnitClassCount(simdResult), 1u);

    ASSERT_EQ(UnitClassOrderedFieldCount(simdResult, 0u), 4u);
    EXPECT_EQ(UnitClassOrderedFieldName(simdResult, 0u, 0u), "header");
    EXPECT_EQ(UnitClassOrderedFieldName(simdResult, 0u, 1u), "pad");
    EXPECT_EQ(UnitClassOrderedFieldName(simdResult, 0u, 2u), "vector");
    EXPECT_EQ(UnitClassOrderedFieldName(simdResult, 0u, 3u), "trailer");
}

void VerifyAdhdCompiler_EnforcesInterfaceOverrideAndFinalClasses(){
    AdhdTestArena arena = AdhdTestArena();
    ExpectCompileFails(arena, s_SuiteMissingOverrideSource, "impl/task/bad_task.adhd");
    ExpectCompileFails(arena, s_SuiteClassInheritanceSource, "impl/task/derived.adhd");
}

void VerifyAdhdCompiler_EnforcesMandatoryInitializationAndProhibitions(){
    AdhdTestArena arena = AdhdTestArena();
    ExpectCompileFails(arena, "void TestFn(in u32 a) {\r\n    u32 count;\r\n}\r\n", "impl/test.adhd");
    ExpectCompileFails(arena, s_SuiteDoubleInitCtorSource, "impl/test.adhd");
    ExpectCompileFails(arena, "class BitfieldBad {\r\n    public u32 flag : 1;\r\n}\r\n", "impl/test.adhd");
    ExpectCompileFails(arena, "void BadFn(in u32 x = 5) {\r\n}\r\n", "impl/test.adhd");
    ExpectCompileFails(arena, s_SuiteMoveCallSource, "impl/test.adhd");
    ExpectCompileFails(arena, "void BadMutate(in u32 a) {\r\n    a = 10;\r\n}\r\n", "impl/test.adhd");
    ExpectCompileFailsWithMessage(arena, "void lowerGlobal() {}\r\n", "impl/test.adhd", "global function name must start with an uppercase letter");
    ExpectCompileFailsWithMessage(arena, "class BadMethodCase { public void UpperMethod() {} }\r\n", "impl/test.adhd", "member function name must start with a lowercase letter");
    ExpectCompileFailsWithMessage(arena, "interface IBadCase { void UpperMethod(); }\r\n", "impl/test.adhd", "member function name must start with a lowercase letter");
}

void VerifyAdhdCompiler_ReordersTemplateInstantiationFieldsAndRejectsFreeOperatorsOrMissingMethodBodies(){
    AdhdTestArena arena = AdhdTestArena();

    CompileResult result = CompileResult(arena.arena);
    ASSERT_TRUE(Compile(s_SuiteTemplateInstReorderSource, "impl/render/material_def.adhd", arena.arena, result));
    ASSERT_EQ(UnitTemplateInstCount(result), 1u);
    ASSERT_EQ(UnitTemplateInstOrderedFieldCount(result, 0u), 2u);
    EXPECT_EQ(UnitTemplateInstOrderedFieldName(result, 0u, 0u), "second");
    EXPECT_EQ(UnitTemplateInstOrderedFieldName(result, 0u, 1u), "first");

    ExpectCompileFails(arena, "u32 operator+(in u32 a, in u32 b) {\r\n    return a + b;\r\n}\r\n", "impl/render/bad_op.adhd");
    ExpectCompileFails(arena, s_SuiteUnimplementedMethodSource, "impl/render/incomplete.adhd");
}

void VerifyAdhdCompiler_EnforcesMutCallSiteAndParallelConcurrencySafety(){
    AdhdTestArena arena = AdhdTestArena();
    ExpectCompileFails(arena, s_SuiteMutLiteralCallSource, "impl/test_mut.adhd");
    ExpectCompileFails(arena, s_SuiteUnsafeParallelVectorSource, "impl/test_par_bad.adhd");

    CompileResult safeParRes = CompileResult(arena.arena);
    EXPECT_TRUE(Compile(s_SuiteSafeParallelVectorSource, "impl/test_par_good.adhd", arena.arena, safeParRes));
    CompileResult borrowed = CompileResult(arena.arena);
    EXPECT_TRUE(Compile("class Held{ public mut u32 value; public Held(mut u32 v){ this.value = v; } } class Task{ public Held held; public Task(mut u32 v){ this.held = Held(v); } public void record()const{ this.held.value = 4u; } }", "impl/nested_mutable_borrow.adhd", arena.arena, borrowed));
    ExpectCompileFails(arena, "class Held{ public in u32 value; public Held(in u32 v){ this.value = v; } } void Bad(in Held h){ h.value = 4u; }", "impl/nested_read_only_borrow.adhd");
    ExpectCompileFails(arena, "class Held{ public u32 value = 0u; } class Task{ public Held held; public void bad()const{ this.held.value = 4u; } }", "impl/nested_owned_field.adhd");
}

void VerifyAdhdCompiler_RejectsFlagBitWidthOverflowInvalidSwitchCtorAndAttributeConflicts(){
    AdhdTestArena arena = AdhdTestArena();
    ExpectCompileFails(arena, s_SuiteOverflowFlagEnumSource, "impl/bad_flag_overflow.adhd");
    ExpectCompileFails(arena, s_SuiteBadFloatSwitchSource, "impl/bad_float_switch.adhd");
    ExpectCompileFails(arena, s_SuiteDupCaseSwitchSource, "impl/bad_dup_case.adhd");
    ExpectCompileFails(arena, s_SuitePartialCtorInitSource, "impl/bad_partial_ctor.adhd");
    ExpectCompileFails(arena, s_SuiteCallNonFuncFieldSource, "impl/bad_call_field.adhd");
    ExpectCompileFails(arena, "[inline]\r\nvoid BadInlineAttr() {}\r\n", "impl/bad_inline_attr.adhd");
    ExpectCompileFailsWithMessage(arena, "void Bad(mut GpuTaskDesc desc){ desc.setDependency(GpuTaskId()); }", "impl/bad_retained_sdk_temporary.adhd", "retained reference requires a stable lvalue");
    ExpectCompileFailsWithMessage(arena, "class View{ private in u32 v; public View(in u32 n){ this.v = n; } } View Bad(){ return View(7u); }", "impl/bad_retained_temporary.adhd", "retained reference requires a stable lvalue");
    ExpectCompileFailsWithMessage(arena, "class View{ private in u32 v; public View(in u32 n){ this.v = n; } } View Bad(in u32 n){ return View(n); }", "impl/bad_retained_copy.adhd", "a retained reference cannot bind to a copied parameter; declare the parameter as 'in borrow'");
    ExpectCompileFailsWithMessage(arena, "void Bad(mut Optional<in u32> count){ count.value() = 7u; }", "impl/bad_optional_read_only.adhd", "cannot mutate 'in' parameter or read-only borrow");
    ExpectCompileFailsWithMessage(arena, "Optional<in u32> Bad(){ return Optional<in u32>(7u); }", "impl/bad_optional_temporary.adhd", "a stored reference requires an lvalue with an enclosing lifetime");
    ExpectCompileFailsWithMessage(arena, "Expected<mut u32> Bad(in borrow u32 n){ return Expected<mut u32>(n); }", "impl/bad_expected_mutable.adhd", "a stored mutable reference requires a mutable lvalue");
    ExpectCompileFailsWithMessage(arena, "Expected<in u32> Bad(in u32 n){ return Expected<in u32>(n); }", "impl/bad_expected_copied_param.adhd", "cannot return a stored reference to parameter copies or stack-local storage");
    ExpectCompileFailsWithMessage(arena, "Optional<in u32> Bad(){ u32 n = 7u; Optional<in u32> copy(n); return copy; }", "impl/bad_optional_local.adhd", "cannot return a stored reference to parameter copies or stack-local storage");
    ExpectCompileFailsWithMessage(arena, "void Bad(mut Optional<in u32> outValue){ u32 n = 7u; outValue = Optional<in u32>(n); }", "impl/bad_optional_assignment.adhd", "cannot assign a stored reference into a longer-lived target");
    ExpectCompileFailsWithMessage(arena, "[extensible] class Parent{ private u32 hidden = 1u; } class Child : Parent{ public u32 read()const{ return this.hidden; } }", "impl/private_inherited_field.adhd", "cannot access an inherited private member");
    ExpectCompileFailsWithMessage(arena, "[extensible] class Parent{ private u32 read()const{ return 1u; } } class Child : Parent{ public u32 other()const{ return this.read(); } }", "impl/private_inherited_method.adhd", "cannot access an inherited private member");
    ExpectCompileFailsWithMessage(arena, "[extensible] class Parent{ public Parent(in u32 value){} } class Child : Parent{}", "impl/missing_base_constructor.adhd", "a derived class requires an accessible default constructor on its concrete base");
    ExpectCompileFailsWithMessage(arena, "[cpp_unwind] extern void Foreign();", "impl/bad_unwind_extern.adhd", "'[cpp_unwind]' takes no arguments and may appear once on an ADHD function or method");
    ExpectCompileFailsWithMessage(arena, "class Item{ [cpp_base(IRenderPass, value)] public Item(mut u32 value){} }", "impl/bad_cpp_base_target.adhd", "'[cpp_base]' must name a direct external polymorphic base");
    ExpectCompileFailsWithMessage(arena, "class Pass : IRenderPass{ [cpp_base(IRenderPass, value)] public Pass(in u32 value){} }", "impl/bad_cpp_base_input.adhd", "'[cpp_base]' must forward a 'mut' or 'in borrow' constructor parameter");
    ExpectCompileFailsWithMessage(arena, "class Pass : IRenderPass{ [cpp_base(IRenderPass, first, second)] public Pass(mut u32 first, in u32 second){} }", "impl/bad_cpp_base_second_input.adhd", "'[cpp_base]' must forward a 'mut' or 'in borrow' constructor parameter");
    ExpectCompileFailsWithMessage(arena, "interface IObserver{ void observe(); } class Owner : IObserver{ public void observe()override{} [cpp_unwind] public ~Owner(){} }", "impl/bad_unwind_dtor.adhd", "'[cpp_unwind]' cannot weaken an inherited destructor contract");
    ExpectCompileFailsWithMessage(arena, "[arena, component(\"part\")] class Part{ [cpp_unwind] public Part(){} }", "impl/bad_unwind_component_ctor.adhd", "'[cpp_unwind]' cannot change a registered class construction or destruction contract");
    ExpectCompileFailsWithMessage(arena, "[friend(Writer)] class Vault{ private u32 key = 1u; } class Reader{ public u32 read(in Vault vault)const{ return vault.key; } }", "impl/bad_friend_access.adhd", "cannot access 'private' or 'protected' field outside of its declaring class");
    ExpectCompileFailsWithMessage(arena, "[friend(Box)] class Vault{} class Box<T>{}", "impl/bad_friend_template.adhd", "a friend must name a non-template peer class");
    ExpectCompileFailsWithMessage(arena, "[move_only] class Secret{} class A{ public Secret v; } class B{ public A a; } class C{ public B b; } class D{ public C c; } class E{ public D d; } void Bad(in E source){ E copy = source; }", "impl/bad_deep_move_only_copy.adhd", "cannot copy a non-copyable type");
    ExpectCompileFailsWithMessage(arena, "[move_only] class Payload{ public u32 index = 0u; } u32 Bad(in Payload value){ Payload copy = value; return copy.index; }", "impl/bad_move_only_copy.adhd", "cannot copy a non-copyable type");
    ExpectCompileFailsWithMessage(arena, "[move_only] class Payload{} void Bad(mut Payload outValue, mut u32 count){ MoveInto<Payload>(outValue, count); }", "impl/bad_move_source_type.adhd", "argument type does not match the explicit type parameter");
    ExpectCompileFailsWithMessage(arena, "[move_only] class Payload{} void Bad(mut Payload outValue){ MoveInto<Payload>(outValue, Payload()); }", "impl/bad_move_source_temporary.adhd", "a mutable type parameter requires a mutable lvalue");
    ExpectCompileFailsWithMessage(arena, "interface Receiver{ void record(); } class Task : Receiver{ [cpp_unwind] public void record()override{} }", "impl/bad_unwind_interface.adhd", "'[cpp_unwind]' cannot weaken a nonthrowing interface contract");
    ExpectCompileFailsWithMessage(arena, "interface Base{ void record(); } interface Sub : Base{ [cpp_unwind] void record(); }", "impl/bad_unwind_derived_interface.adhd", "'[cpp_unwind]' cannot weaken an inherited nonthrowing interface contract");
    ExpectCompileFailsWithMessage(arena, "void Call(); [cpp_unwind] void Call(){}", "impl/bad_unwind_decl.adhd", "free function declarations must agree on '[cpp_unwind]'");
    ExpectCompileFails(arena, "[noinline]\r\nvoid BadNoInlineAttr() {}\r\n", "impl/bad_noinline_attr.adhd");
    ExpectCompileFails(arena, "inline void BadInlineKeyword() {}\r\n", "impl/bad_inline_kw.adhd");
    ExpectCompileFails(arena, "noinline void BadNoInlineKeyword() {}\r\n", "impl/bad_noinline_kw.adhd");
    ExpectCompileFailsWithMessage(arena, "void BadArenaParam(mut ScratchArena a) {}\r\n", "impl/bad_scratch_param.adhd", "explicit '*Arena' types are prohibited in adhd; arenas are managed automatically by the adhd compiler");
    ExpectCompileFailsWithMessage(arena, "void BadGlobalLocal() {\r\n    GlobalArena a = GlobalArena(\"bad\");\r\n}\r\n", "impl/bad_global_local.adhd", "explicit '*Arena' types are prohibited in adhd; arenas are managed automatically by the adhd compiler");
    ExpectCompileFailsWithMessage(arena, "class BadArenaField {\r\n    public AssetArena a;\r\n}\r\n", "impl/bad_asset_field.adhd", "explicit '*Arena' types are prohibited in adhd; arenas are managed automatically by the adhd compiler");
    ExpectCompileFailsWithMessage(arena, "void BadArenaBase(in ArenaBase a) {}\r\n", "impl/bad_arena_base.adhd", "explicit '*Arena' types are prohibited in adhd; arenas are managed automatically by the adhd compiler");
    ExpectCompileFailsWithMessage(arena, "void BadCookArena(mut CookArena a) {}\r\n", "impl/bad_cook_arena.adhd", "explicit '*Arena' types are prohibited in adhd; arenas are managed automatically by the adhd compiler");
    ExpectCompileFailsWithMessage(arena, "void BadGraphicsArena(mut GraphicsArena a) {}\r\n", "impl/bad_graphics_arena.adhd", "explicit '*Arena' types are prohibited in adhd; arenas are managed automatically by the adhd compiler");
    ExpectCompileFailsWithMessage(arena, "void BadMetaArena(mut MetaArena a) {}\r\n", "impl/bad_meta_arena.adhd", "explicit '*Arena' types are prohibited in adhd; arenas are managed automatically by the adhd compiler");
    ExpectCompileFailsWithMessage(arena, "void BadPersistentArena(mut PersistentArena a) {}\r\n", "impl/bad_persistent_arena.adhd", "explicit '*Arena' types are prohibited in adhd; arenas are managed automatically by the adhd compiler");
    ExpectCompileFailsWithMessage(arena, "void BadTelemetryArena(mut TelemetryArena a) {}\r\n", "impl/bad_telemetry_arena.adhd", "explicit '*Arena' types are prohibited in adhd; arenas are managed automatically by the adhd compiler");
    ExpectCompileFails(arena, "usize BadScratchStatic() {\r\n    return ScratchArena::s_DefaultInitialChunkBytes;\r\n}\r\n", "impl/bad_scratch_static.adhd");
    ExpectCompileFails(arena, "[arena, serialize, asset(\"bad_asset\")]\r\nclass BadSerializeAsset { public u32 v = 0u; }\r\n", "impl/bad_serialize_asset.adhd");
    ExpectCompileFails(arena, "[asset(\"bad_asset\")]\r\nclass BadNoArenaAsset { public Vector<u8> bytes; }\r\n", "impl/bad_no_arena_asset.adhd");
    ExpectCompileFails(arena, "[arena, asset(\"bad_asset\")]\r\nclass BadTemplateAsset<T> { public T v; }\r\n", "impl/bad_template_asset.adhd");
    ExpectCompileFails(arena, "[arena, serialize, system(\"bad_sys\")]\r\nclass BadSerializeSystem { public u32 v = 0u; }\r\n", "impl/bad_serialize_system.adhd");
    ExpectCompileFails(arena, "[system(\"bad_sys\")]\r\nclass BadNoArenaSystem { public u32 v = 0u; }\r\n", "impl/bad_no_arena_system.adhd");
    ExpectCompileFails(arena, "[arena, system(\"bad_sys\")]\r\nclass BadTemplateSystem<T> { public T v; }\r\n", "impl/bad_template_system.adhd");
    ExpectCompileFails(arena, "[arena, component(\"comp\"), system(\"bad_sys\")]\r\nclass BadComponentSystem { public u32 v = 0u; }\r\n", "impl/bad_component_system.adhd");

    CompileResult assetRes = CompileResult(arena.arena);
    ASSERT_TRUE(Compile("[arena, asset(\"sample_blob\")]\r\nclass SampleBlob {\r\n    private Vector<u8> m_bytes;\r\n    public in Vector<u8> bytes()const { return this.m_bytes; }\r\n    public b8 loadBinary(in Span<u8> binary) { return this.checkVirtualPath(\"SampleBlob::loadBinary\") && !this.virtualPath().empty() && !binary.empty(); }\r\n}\r\n", "impl/assets_sample/asset.adhd", arena.arena, assetRes));
    const StringView assetHdr = GeneratedHeaderView(assetRes);
    const StringView assetCpp = GeneratedSourceView(assetRes);
    EXPECT_NE(assetHdr.find("#include <core/assets/module.h>"), usize.max);
    EXPECT_NE(assetHdr.find("class SampleBlob final : public ::NWB::Core::Assets::TypedAsset<SampleBlob>"), usize.max);
    EXPECT_NE(assetHdr.find("NWB_DEFINE_ASSET_TYPE(\"sample_blob\")"), usize.max);
    EXPECT_NE(assetHdr.find("const Vector<u8, ::ArenaBase>& bytes()const noexcept"), usize.max);
    EXPECT_NE(assetHdr.find("NWB_DEFINE_ASSET_CODEC(SampleBlobAssetCodec, SampleBlob);"), usize.max);
    EXPECT_NE(assetCpp.find("__adhd_asset_codec_registrar_SampleBlob(&::NWB::Core::Assets::CreateAssetCodec<SampleBlobAssetCodec>);"), usize.max);

    CompileResult systemRes = CompileResult(arena.arena);
    ASSERT_TRUE(Compile("[arena, component(\"pos\")]\r\nclass PosComp {\r\n    public i32 x = 0;\r\n}\r\n[arena, system(\"sample_sys\")]\r\nclass SampleSystem {\r\n    public u32 ticks = 0u;\r\n    public SampleSystem() {\r\n        this.writeAccess<PosComp>();\r\n    }\r\n    public void prepare(mut World world) {\r\n        ++this.ticks;\r\n    }\r\n    public Expected<void, CpuTaskAdmissionError> update(mut World world, in f32 delta) {\r\n        return Expected<void, CpuTaskAdmissionError>();\r\n    }\r\n    public Name currentType()const {\r\n        return SampleSystem::SystemTypeName();\r\n    }\r\n}\r\n", "impl/ecs_sample/system.adhd", arena.arena, systemRes));
    const StringView sysHdr = GeneratedHeaderView(systemRes);
    const StringView sysCpp = GeneratedSourceView(systemRes);
    EXPECT_NE(sysHdr.find("#include <core/ecs/component.h>"), usize.max);
    EXPECT_NE(sysHdr.find("NWB_DEFINE_COMPONENT_TYPE(\"pos\")"), usize.max);
    EXPECT_NE(sysHdr.find("#include <core/ecs/system.h>"), usize.max);
    EXPECT_NE(sysHdr.find("class SampleSystem final : public ::NWB::Core::ECS::ISystem"), usize.max);
    EXPECT_NE(sysHdr.find("NWB_DEFINE_SYSTEM_TYPE(\"sample_sys\")"), usize.max);
    EXPECT_NE(sysHdr.find("[[nodiscard]] virtual const ::Name& systemType()const noexcept override{ return s_SystemTypeName; }"), usize.max);
    EXPECT_NE(sysHdr.find("virtual void prepare(::NWB::Core::ECS::World& world)noexcept override"), usize.max);
    EXPECT_NE(sysHdr.find("virtual Expected<void, ::NWB::Core::CpuTaskAdmissionError::Enum> update(::NWB::Core::ECS::World& world, const f32 delta)noexcept override"), usize.max);
    EXPECT_NE(sysCpp.find(": ::NWB::Core::ECS::ISystem(__adhd_mother_arena)"), usize.max);
}

void VerifyAdhdCompiler_RejectsMalformedHexMacroParamsCastsDanglingRefsAndEarlyReturnCtors(){
    AdhdTestArena arena = AdhdTestArena();
    ExpectCompileFails(arena, "const u32 kBad = 0x1G;\r\n", "impl/bad_hex.adhd");
    ExpectCompileFails(arena, "#define BAD_MACRO(x, x) (x)\r\nconst i32 kVal = 1;\r\n", "impl/bad_macro_param.adhd");
    ExpectCompileFails(arena, "i32 BadCast() {\r\n    return (i32)-1;\r\n}\r\n", "impl/bad_unary_cast.adhd");
    ExpectCompileFails(arena, "u64 BadBitCast(in f32 x) {\r\n    return bit_cast<u64>(x);\r\n}\r\n", "impl/bad_bit_cast.adhd");
    ExpectCompileFails(arena, "in i32 BadReturnRef() {\r\n    i32 localVal = 7;\r\n    return localVal;\r\n}\r\n", "impl/bad_dangling_ret.adhd");
    ExpectCompileFails(arena, "void MutateInt(mut i32 v) { v = v + 1; }\r\nvoid Caller(in i32 a, in i32 b) {\r\n    MutateInt(a + b);\r\n}\r\n", "impl/bad_rvalue_mut.adhd");
    ExpectCompileFails(arena, s_SuiteEarlyReturnCtorSource, "impl/bad_early_ret_ctor.adhd");
    ExpectCompileFails(arena, "void BadParSet(in Set<i32> items) {\r\n    parallel_for(in i32 x : items) {\r\n    }\r\n}\r\n", "impl/bad_par_set.adhd");
}

void VerifyAdhdCompiler_RequiresExplicitHeaderOrSourceOnTopLevelNativeBlocks(){
    AdhdTestArena arena = AdhdTestArena();

    CompileResult explicitRes = CompileResult(arena.arena);
    ASSERT_TRUE(Compile("[source]\r\nnative{\r\nstatic constexpr int kOnlyInCpp = 42;\r\n}\r\nconst u32 s_AfterSourceBlock = 7u;\r\n[header]\r\nnative{\r\nstruct ExplicitHeaderTag {};\r\n}\r\n", "impl/explicit_native_targets.adhd", arena.arena, explicitRes));
    EXPECT_EQ(GeneratedHeaderView(explicitRes).find("kOnlyInCpp"), usize.max);
    EXPECT_NE(GeneratedSourceView(explicitRes).find("kOnlyInCpp"), usize.max);
    EXPECT_NE(GeneratedHeaderView(explicitRes).find("ExplicitHeaderTag"), usize.max);
    EXPECT_EQ(GeneratedSourceView(explicitRes).find("ExplicitHeaderTag"), usize.max);
    EXPECT_NE(GeneratedHeaderView(explicitRes).find("s_AfterSourceBlock"), usize.max);

    ExpectCompileFailsWithMessage(arena, "native{\r\nstruct MissingTarget {};\r\n}\r\n", "impl/missing_native_target.adhd", "top-level 'native' block must specify '[header]' or '[source]'");
    ExpectCompileFailsWithMessage(arena, "[header, source]\r\nnative{\r\n}\r\n", "impl/conflict_native.adhd", "duplicate or conflicting target attribute on top-level 'native' block");
    ExpectCompileFailsWithMessage(arena, "[source(1)]\r\nnative{\r\n}\r\n", "impl/arg_native.adhd", "top-level 'native' target attribute does not accept arguments");
    ExpectCompileFailsWithMessage(arena, "[reflect]\r\nnative{\r\n}\r\n", "impl/bad_native_attr.adhd", "unsupported attribute on top-level 'native' block; only '[header]' or '[source]' is permitted");
    ExpectCompileFailsWithMessage(arena, "void ScopedFn() {\r\n    [header]\r\n    native{}\r\n}\r\n", "impl/scoped_native_attr.adhd", "attributes are not permitted on 'native' blocks");
}

