        this.stateReady = AreDualPersistentStateSubsetsReady(returnStateReady, scratchStateReady);
        return this.stateReady;
    }
}

class SurfelGiStateLifecycleContext{
    public mut RendererFramePipeline renderer;
    private PersistentStateSubsetBinding m_returnState;
    private PersistentStateSubsetBinding m_counterState;
    private PersistentStateSubsetBinding m_computeState;
    public Span<TextureHandle> returnTextures;
    public Span<BufferHandle> counterBuffers;
    public Span<TextureHandle> computeTextures;
    public Span<BufferHandle> computeBuffers;
    public b8 statePrepared = false;
    public b8 stateReady = false;

    public SurfelGiStateLifecycleContext(mut RendererFramePipeline renderer){
        this.renderer = renderer;
        this.m_returnState = PersistentStateSubsetBinding(renderer.m_surfelIrradianceReturnState, false);
        this.m_counterState = PersistentStateSubsetBinding(renderer.m_surfelGiCounterPersistentState, false);
        this.m_computeState = PersistentStateSubsetBinding(renderer.m_surfelGiComputePersistentState, false);
    }

    public b8 recorded(in Optional<in CommandListResourceStateHandoff> finalState){
        if(this.returnTextures.empty() || this.counterBuffers.empty() || this.computeTextures.empty() || this.computeBuffers.empty() || !finalState.has_value())
            return false;

        const b8 returnStateReady = this.m_returnState.record(finalState.value(), this.returnTextures, Span<BufferHandle>());
        const b8 counterStateReady = this.m_counterState.record(finalState.value(), Span<TextureHandle>(), this.counterBuffers);
        const b8 computeStateReady = this.m_computeState.record(finalState.value(), this.computeTextures, this.computeBuffers);
        this.statePrepared = AreTriplePersistentStateSubsetsReady(returnStateReady, counterStateReady, computeStateReady);
        return this.statePrepared;
    }
    public b8 accepted(in QueueSubmissionToken token){
        if(!this.statePrepared)
            return false;

        const b8 returnStateReady = this.m_returnState.commit();
        const b8 counterStateReady = this.m_counterState.commit();
        const b8 computeStateReady = this.m_computeState.commit();
        this.stateReady = AreTriplePersistentStateSubsetsReady(returnStateReady, counterStateReady, computeStateReady);
        if(this.stateReady)
            this.renderer.m_raytracingSystem.confirmRayTraceContextReadSubmission(token);
        return this.stateReady;
    }
}

class HardwareCausticsStateLifecycleContext{
    public mut RendererFramePipeline renderer;
    private PersistentStateSubsetBinding m_accumulatorState;
    public Span<TextureHandle> accumulatorTextures;
    public b8 statePrepared = false;
    public b8 stateReady = false;

    public HardwareCausticsStateLifecycleContext(mut RendererFramePipeline renderer){
        this.renderer = renderer;
        this.m_accumulatorState = PersistentStateSubsetBinding(renderer.m_hardwareCausticAccumulatorPersistentState, false);
    }

    public b8 recorded(in Optional<in CommandListResourceStateHandoff> finalState){
        if(this.accumulatorTextures.empty() || !finalState.has_value())
            return false;

        this.statePrepared = this.m_accumulatorState.record(finalState.value(), this.accumulatorTextures, Span<BufferHandle>());
        return this.statePrepared;
    }
    public b8 accepted(in QueueSubmissionToken token){
        if(!this.statePrepared)
            return false;

        this.stateReady = this.m_accumulatorState.commit();
        return this.stateReady;
    }
}

class DeferredLightingStateLifecycleContext{
    public mut RendererFramePipeline renderer;
    public mut DeferredFrameTargets targets;
    private PersistentStateSubsetBinding m_shadowReturnState;
    private PersistentStateSubsetBinding m_causticReturnState;
    private PersistentStateSubsetBinding m_surfelReturnState;
    public Span<TextureHandle> shadowReturnTextures;
    public Span<TextureHandle> causticReturnTextures;
    public Span<TextureHandle> surfelReturnTextures;
    public b8 usesLaggedHistory = false;
    public b8 statePrepared = false;
    public b8 stateReady = false;

    public DeferredLightingStateLifecycleContext(mut RendererFramePipeline renderer, mut DeferredFrameTargets targets){
        this.renderer = renderer;
        this.targets = targets;
        this.m_shadowReturnState = PersistentStateSubsetBinding(renderer.m_shadowVisibilityReturnState, false);
        this.m_causticReturnState = PersistentStateSubsetBinding(renderer.m_causticIrradianceReturnState, false);
        this.m_surfelReturnState = PersistentStateSubsetBinding(renderer.m_surfelIrradianceReturnState, false);
    }

    public b8 recorded(in Optional<in CommandListResourceStateHandoff> finalState){
        if(this.shadowReturnTextures.empty() || this.causticReturnTextures.empty() || this.surfelReturnTextures.empty() || !finalState.has_value())
            return false;

        b8 shadowStateReady = true;
        b8 causticStateReady = true;
        b8 surfelStateReady = true;
        if(ShouldBuildDirectDeferredLightingReturnStates(this.usesLaggedHistory)){
            shadowStateReady = this.m_shadowReturnState.record(finalState.value(), this.shadowReturnTextures, Span<BufferHandle>());
            causticStateReady = this.m_causticReturnState.record(finalState.value(), this.causticReturnTextures, Span<BufferHandle>());
            surfelStateReady = this.m_surfelReturnState.record(finalState.value(), this.surfelReturnTextures, Span<BufferHandle>());
        }
        this.statePrepared = AreTriplePersistentStateSubsetsReady(shadowStateReady, causticStateReady, surfelStateReady);
        return this.statePrepared;
    }
    public b8 accepted(in QueueSubmissionToken token){
        if(!this.statePrepared)
            return false;

        mut RendererFramePipeline renderer = this.renderer;
        if(this.usesLaggedHistory)
            this.targets.laggedLightingHistory.slotsUploaded = true;
        b8 shadowStateReady = true;
        b8 causticStateReady = true;
        b8 surfelStateReady = true;
        if(ShouldBuildDirectDeferredLightingReturnStates(this.usesLaggedHistory)){
            shadowStateReady = this.m_shadowReturnState.commit();
            causticStateReady = this.m_causticReturnState.commit();
            surfelStateReady = this.m_surfelReturnState.commit();
        }
        this.stateReady = AreTriplePersistentStateSubsetsReady(shadowStateReady, causticStateReady, surfelStateReady);
        if(!this.stateReady)
            return false;
        if(this.usesLaggedHistory)
            renderer.reportLaggedLightingTransition(LaggedLightingReport::ActiveHistoryAccepted, this.targets.laggedLightingHistory.generation);
        return true;
    }
}


