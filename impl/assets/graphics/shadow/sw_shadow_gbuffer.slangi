////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_SHADOW_SW_SHADOW_GBUFFER_SLANGI
#define NWB_GRAPHICS_SHADOW_SW_SHADOW_GBUFFER_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "sw_binding_slots.h"
#include "sw_shadow_heap_resources.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Software-shadow G-buffer inputs and material context are selected from global heap tables by the shared push block.
#define NWB_SW_SHADOW_DEFERRED_RESOURCES nwbHeapDeferredBindlessResources(g_NwbSwShadowPush.deferredResourcesHeapSlot)
#define g_NwbSwShadowMaterialContextSlots nwbHeapShadowMaterialContextSlots(g_NwbSwShadowPush.materialContextSlotsHeapSlot)
#define NWB_SCENE_SHADING_HEAP_SLOT NWB_SW_SHADOW_DEFERRED_RESOURCES.avboitSlots.z
#define NWB_SCENE_LIGHT_LIST_HEAP_SLOT NWB_SW_SHADOW_DEFERRED_RESOURCES.avboitSlots.w
#include "../scene/buffer.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Returns true when the texel is cleared background (fully lit, no candidate ray).
bool nwbSwShadowIsBackground(const int3 texel){
    return nwbHeapSampledImage2D(NWB_SW_SHADOW_DEFERRED_RESOURCES.gbufferSlots.w).Load(texel).r >= NWB_SW_SHADOW_BACKGROUND_DEPTH;
}

// The world-space surface position at this texel (the shade point the occlusion ray leaves from).
float3 nwbSwShadowLoadWorldPosition(const int3 texel){
    // Vector attachments are RGBA16F. Keep the payload compact; widen at the FP32 ray-geometry boundary.
    const half3 worldPositionSample = half3(nwbHeapSampledImage2D(NWB_SW_SHADOW_DEFERRED_RESOURCES.gbufferSlots.z).Load(texel).xyz);
    return float3(worldPositionSample);
}

// Surface normal, unpacked from [0,1] to [-1,1] and renormalised (origin biases along it against self-hits).
float3 nwbSwShadowLoadNormal(const int3 texel){
    const half3 normalSample = half3(nwbHeapSampledImage2D(NWB_SW_SHADOW_DEFERRED_RESOURCES.gbufferSlots.y).Load(texel).xyz);
    return normalize(float3(normalSample) * 2.0 - 1.0);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

