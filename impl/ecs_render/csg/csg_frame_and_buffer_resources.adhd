#include <impl/ecs_render/csg/clip_bounds.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class CsgReceiverPassWorkSummary{
    public u32 maxCutterCount = 0u;
    public b8 opaqueWork = false;
    public b8 transparentWork = false;

    public b8 anyWork()const{
        return this.opaqueWork || this.transparentWork;
    }
}

b8 HasValidCsgGraphResourceCapacities(
    in usize receiverRangeCapacity,
    in usize cutterCapacity,
    in usize receiverRangeCount,
    in usize cutterCount
){
    return receiverRangeCapacity >= receiverRangeCount && cutterCapacity >= cutterCount;
}

b8 ShouldEvaluateCsgPassCutters(
    in b8 materialTransparent,
    in b8 affectOpaquePass,
    in b8 affectTransparentPass,
    in CsgReceiverPass pass
){
    switch(pass){
    case CsgReceiverPass::Opaque:
        return !materialTransparent && affectOpaquePass;
    case CsgReceiverPass::Transparent:
        return materialTransparent && affectTransparentPass;
    default:
        return false;
    }
}

CsgReceiverPassWorkSummary SummarizeCsgReceiverPassWork(in u32 opaqueCutterCount, in u32 transparentCutterCount){
    CsgReceiverPassWorkSummary summary;
    summary.maxCutterCount = Max(opaqueCutterCount, transparentCutterCount);
    summary.opaqueWork = opaqueCutterCount > 0u;
    summary.transparentWork = transparentCutterCount > 0u;
    return summary;
}


