enum<u8> ContextMenuReconcileSourceAction{
    KeepSelectionAndScroll = 0,
    CloseOnNewGeneration = 1,
    ResetSelectionAndScroll = 2,
    kCount
}

ContextMenuReconcileSourceAction ClassifyContextMenuSourceChange(
    in u64 previousGeneration,
    in u64 currentGeneration,
    in u64 previousRevision,
    in u64 currentRevision
){
    if(previousGeneration != 0u && previousGeneration != currentGeneration)
        return ContextMenuReconcileSourceAction::CloseOnNewGeneration;
    if(previousRevision != 0u && previousRevision != currentRevision)
        return ContextMenuReconcileSourceAction::ResetSelectionAndScroll;
    return ContextMenuReconcileSourceAction::KeepSelectionAndScroll;
}

Rect BuildContextMenuTriggerAnchorRect(in Point position){
    return Rect(position.x, position.y, 0.0f, 0.0f);
}

PopupOptions BuildContextMenuPopupOptions(in Rect anchor, in Point size){
    PopupOptions options;
    options.anchor = anchor;
    options.size = size;
    options.gap = 0.0f;
    return options;
}

f32 ResolveSinglePixelCaretWidth(in DisplayMetrics display){
    return 1.0f / display.pixelScaleX;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 SnapshotNumericFrame(in Optional<mut BuilderIntegerEditFrame> loan, in EditModel model, in b8 focused){
    if(!loan.has_value())
        return true;
    mut BuilderIntegerEditFrame frame = loan.value();
    if(!frame.model.has_value() || frame.model.value().revision() != frame.revision)
        return false;
    frame.draftStamp = model.stamp();
    frame.focused = focused;
    return true;
}

b8 SnapshotNumericFrame(in Optional<mut BuilderFloatEditFrame> loan, in EditModel model, in b8 focused){
    if(!loan.has_value())
        return true;
    mut BuilderFloatEditFrame frame = loan.value();
    if(!frame.model.has_value() || frame.model.value().revision() != frame.revision)
        return false;
    frame.draftStamp = model.stamp();
    frame.focused = focused;
    return true;
}


b8 Builder::applySliderInput(mut SliderFrame frame, in SliderPlacement placement, in b8 interactive){
    if(!this.sliderMatches(frame))
        return false;
    if(!interactive || placement.centerTravel.width <= 0.0f)
        return true;
    const auto track = TryMakeWidgetId(frame.m_widget.id, s_WidgetPartTrack);
    if(!track.has_value())
        return false;
    const auto thumb = TryMakeWidgetId(frame.m_widget.id, s_WidgetPartThumb);
    if(!thumb.has_value())
        return false;
    auto control = this.m_context.takeControlAction(frame.m_widget, true, frame.m_token);
    b8 hasControl = control.has_value();
    auto trackGesture = this.m_context.takePartPointerGesture(frame.m_widget, track.value(), true);
    b8 hasTrack = trackGesture.has_value();
    auto thumbGesture = this.m_context.takePartPointerGesture(frame.m_widget, thumb.value(), true);
    b8 hasThumb = thumbGesture.has_value();
    while(hasControl || hasTrack || hasThumb){
        if(!this.sliderMatches(frame))
            return false;
        u64 controlSequence = 0u;
        u64 trackSequence = 0u;
        u64 thumbSequence = 0u;
        if(hasControl)
            controlSequence = control.value().id.sequence;
        if(hasTrack)
            trackSequence = trackGesture.value().updateSequence;
        if(hasThumb)
            thumbSequence = thumbGesture.value().updateSequence;
        const u8 stream = SelectNextSliderInputStream(
            hasControl,
            controlSequence,
            hasTrack,
            trackSequence,
            hasThumb,
            thumbSequence
        );
        if(stream == 0u){
            if(control.value().control != frame.m_token || !ApplySliderControlAction(frame.m_options, control.value(), frame.m_state, frame.m_result))
                return false;
            frame.m_snapshot = frame.m_state.snapshot();
            control = this.m_context.takeControlAction(frame.m_widget, true, frame.m_token);
            hasControl = control.has_value();
        }
        else if(stream == 1u){
            if(trackGesture.value().control != frame.m_token || !SeekSliderPointerGesture(frame.m_options, trackGesture.value(), frame.m_state, frame.m_result))
                return false;
            frame.m_snapshot = frame.m_state.snapshot();
            trackGesture = this.m_context.takePartPointerGesture(frame.m_widget, track.value(), true);
            hasTrack = trackGesture.has_value();
        }
        else{
            if(thumbGesture.value().control != frame.m_token || !DragSliderPointerGesture(frame.m_options, thumbGesture.value(), frame.m_state, frame.m_result))
                return false;
            frame.m_snapshot = frame.m_state.snapshot();
            thumbGesture = this.m_context.takePartPointerGesture(frame.m_widget, thumb.value(), true);
            hasThumb = thumbGesture.has_value();
        }
    }
    return this.sliderMatches(frame);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


ContextMenuResult Builder::contextMenu(in StringView stableKey, in StringView anchorKey, in borrow IListDataSource source, mut ContextMenuState state, in ContextMenuOptions options){
    ContextMenuResult result;
    const auto anchorIndex = this.annotationAnchorIndex(anchorKey);
    if(this.panelDeclarationBlocked() || !anchorIndex.has_value() || !IsValidContextMenuDeclarationOptions(options, this.m_scope.value().m_contextMenus.size(), s_InputMaxPopups)){
        this.m_context.fail();
        return result;
    }
    mut BuilderItem anchor = this.m_scope.value().m_items[anchorIndex.value()];
    if(!this.synchronizePopup()){
        result.valid = true;
        return result;
    }
    for(in auto previous : this.m_scope.value().m_contextMenus){
        if(previous.anchor.id == anchor.state.id){
            this.m_context.fail();
            return result;
        }
    }
    this.m_declaring = true;
    BuilderOperationEnd finish(this.m_declaring);
    const auto widget = this.m_context.declare(stableKey, WidgetKind::ContextMenu);
    if(!widget.has_value() || !this.m_context.claimState(widget.value(), state.instanceGeneration()))
        return result;
    BuilderContextMenuFrame frame;
    frame.parentToken = this.m_context.popupToken();
    frame.widget = widget.value();
    frame.anchor = anchor.state;
    frame.anchorIndex = cast<u32>(anchorIndex.value());
    frame.source = Optional<in IListDataSource>(source);
    frame.state = Optional<mut ContextMenuState>(state);
    frame.popupStyle = this.m_popupStyle;
    frame.options = options;
    frame.options.enabled = options.enabled && anchor.enabled;
    const b8 previouslyOpen = state.isOpen();
    if(DidContextMenuBindingChange(
        widget.value().id,
        widget.value().declarationGeneration,
        anchor.state.id,
        anchor.state.declarationGeneration,
        state.m_owner,
        state.m_ownerDeclaration,
        state.m_anchorWidget,
        state.m_anchorDeclaration
    )){
        if(state.m_owner.valid())
            state.close();
        state.m_owner = widget.value().id;
        state.m_ownerDeclaration = widget.value().declarationGeneration;
        state.m_anchorWidget = anchor.state.id;
        state.m_anchorDeclaration = anchor.state.declarationGeneration;
        AdvanceNonWrappingRevision(state.m_revision);
    }
    const b8 boundOpen = state.isOpen();
    state.m_popup.bindParent(frame.parentToken);
    if(boundOpen && !state.isOpen())
        state.close();
    const auto popup = this.m_context.declarePart(frame.widget, s_WidgetPartPopup, WidgetKind::Popup);
    if(!popup.has_value())
        return result;
    frame.popup = popup.value();
    const auto rows = this.m_context.declarePart(frame.widget, s_WidgetPartRows, WidgetKind::VirtualList);
    if(!rows.has_value())
        return result;
    frame.rows = rows.value();
    const b8 previouslyListFocused = this.m_context.input().focus() == frame.rows.id;
    frame.popupToken.widget = frame.popup.id;
    frame.popupToken.declarationGeneration = frame.popup.declarationGeneration;
    frame.popupToken.instanceGeneration = state.instanceGeneration();
    frame.popupToken.openGeneration = state.m_popup.openGeneration();
    frame.revision = state.revision();
    frame.open = state.isOpen();
    frame.listToken.instanceGeneration = state.m_list.inputGeneration();
    frame.listToken.contentGeneration = source.instanceGeneration();
    frame.listToken.contentRevision = source.revision();
    frame.rowCount = source.rowCount();
    if(!this.contextMenuMatches(frame)){
        this.m_context.fail();
        return result;
    }
    const u64 previousGeneration = state.m_list.m_sourceGeneration;
    const u64 previousRevision = state.m_list.m_sourceRevision;
    if(!ReconcileListState(state.m_list, source) || !this.contextMenuMatches(frame)){
        this.m_context.fail();
        return result;
    }
    switch(ClassifyContextMenuSourceChange(previousGeneration, frame.listToken.contentGeneration, previousRevision, frame.listToken.contentRevision)){
    case ContextMenuReconcileSourceAction::CloseOnNewGeneration:
        state.close();
        break;
    case ContextMenuReconcileSourceAction::ResetSelectionAndScroll:
        state.m_list.select(0u);
        if(!state.m_list.scrollTo(0.0)){
            this.m_context.fail();
            return result;
        }
        break;
    case ContextMenuReconcileSourceAction::KeepSelectionAndScroll:
    default:
        break;
    }
    this.snapshotContextMenu(frame);
    if(!this.prepareContextMenu(frame, result)){
        this.m_context.fail();
        return result;
    }
    ListOptions listOptions;
    listOptions.wheelRows = options.wheelRows;
    listOptions.enabled = frame.options.enabled;
    listOptions.selectOnNavigate = false;
    const b8 focusOnCommit = frame.open && frame.options.enabled && previouslyListFocused && this.m_context.input().focus() != frame.rows.id;
    auto list = this.makeListFrame();
    if(!this.prepareListFrame(source, state.m_list, listOptions, frame.listToken, frame.rowCount, focusOnCommit, WidgetId(), list).has_value() || !this.contextMenuMatches(frame)){
        this.m_context.fail();
        return result;
    }
    frame.list = cast<u32>(this.m_scope.value().m_lists.size());
    state.m_popup.bindParent(frame.parentToken);
    if(frame.open && !this.reserveCompoundPopup(frame.popup, frame.popupToken)){
        this.m_context.fail();
        return ContextMenuResult();
    }
    AppendOwned<BuilderListFrame>(this.m_scope.value().m_lists, list);
    anchor.contextMenu = frame.options.enabled;
    anchor.annotated = true;
    result.valid = true;
    result.opened = !previouslyOpen && state.isOpen();
    result.closed = previouslyOpen && !state.isOpen();
    this.m_scope.value().m_contextMenus.push_back(frame);
    return result;
}

b8 Builder::prepareContextMenu(mut BuilderContextMenuFrame frame, mut ContextMenuResult result){
    mut InputRouter input = this.m_context.input();
    mut ContextMenuState state = frame.state.value();
    input.fencePopup(frame.popupToken);
    if(input.consumePopupDismissal(frame.popupToken))
        state.close();
    while(true){
        const auto trigger = input.consumeContextMenu(frame.anchor.id, frame.anchor.declarationGeneration);
        if(!trigger.has_value())
            break;
        if(frame.options.enabled && trigger.value().popup == this.m_context.popupToken() && !state.open(BuildContextMenuTriggerAnchorRect(trigger.value().position)))
            return false;
    }
    if(!frame.options.enabled)
        state.close();
    this.snapshotContextMenu(frame);
    input.fencePopup(frame.popupToken);
    input.fenceControl(frame.rows.id, frame.rows.declarationGeneration, frame.listToken);
    if(!frame.open){
        input.closePopup(frame.popupToken);
        return this.contextMenuMatches(frame);
    }
    if(!ReconcileListState(state.m_list, frame.source.value()) || !this.contextMenuMatches(frame))
        return false;
    if(state.m_list.cursorKey() == 0u){
        ControlAction first;
        first.control = frame.listToken;
        first.kind = ControlActionKind::Home;
        ListOptions options;
        options.wheelRows = frame.options.wheelRows;
        options.selectOnNavigate = false;
        ListResult preview;
        if(!ApplyListControlAction(frame.source.value(), options, first, state.m_list, preview) || !this.contextMenuMatches(frame))
            return false;
    }
    return this.applyContextMenuInput(frame, result);
}

b8 Builder::applyContextMenuInput(mut BuilderContextMenuFrame frame, mut ContextMenuResult result){
    ListOptions options;
    options.wheelRows = frame.options.wheelRows;
    options.selectOnNavigate = false;
    ListInput inputs(this.m_context);
    const ListInputMatches matches = lambda[in this, mut frame]() -> b8{ return this.contextMenuMatches(frame); };
    const ListInputApplyAction apply = lambda[mut this, mut frame, in options, mut result](in ControlAction action) -> ListActionOutcome{
        ListResult preview;
        if(!ApplyListControlAction(frame.source.value(), options, action, frame.state.value().m_list, preview) || !this.contextMenuMatches(frame))
            return ListActionOutcome::Failed;
        if(!preview.activated)
            return ListActionOutcome::Continue;
        result.activated = true;
        result.key = frame.state.value().m_list.selectedKey();
        frame.state.value().close();
        this.m_context.input().closePopup(frame.popupToken);
        this.snapshotContextMenu(frame);
        return ListActionOutcome::Stop;
    };
    return inputs.consume(
        frame.rows,
        frame.listToken,
        true,
        frame.popupToken,
        frame.state.value().m_list,
        matches,
        apply
    );
}

void Builder::snapshotContextMenu(mut BuilderContextMenuFrame frame){
    frame.revision = frame.state.value().revision();
    frame.open = frame.state.value().isOpen();
    frame.popupToken.openGeneration = frame.state.value().m_popup.openGeneration();
    frame.listToken.instanceGeneration = frame.state.value().m_list.inputGeneration();
    if(frame.list < this.m_scope.value().m_lists.size())
        this.m_scope.value().m_lists[frame.list].token = frame.listToken;
}

b8 Builder::paintContextMenus(){
    for(mut auto frame : this.m_scope.value().m_contextMenus){
        if(!this.contextMenuMatches(frame) || frame.list >= this.m_scope.value().m_lists.size() || frame.anchorIndex >= this.m_scope.value().m_items.size())
            return false;
        if(frame.open && frame.options.enabled && !this.paintContextMenuPopup(frame))
            return false;
    }
    return true;
}

b8 Builder::paintContextMenuPopup(mut BuilderContextMenuFrame frame){
    in BuilderItem anchor = this.m_scope.value().m_items[frame.anchorIndex];
    const Optional<LayoutBox> anchorBox = this.m_scope.value().m_layout.box(anchor.node);
    const auto background = this.region(frame.popupStyle.background, frame.popupStyle.fallback);
    if(!anchorBox.has_value() || !background.has_value() || !this.contextMenuMatches(frame))
        return false;
    const Rect clip = this.visibleClip(anchorBox.value().clip);
    if(!IsContextMenuAnchorVisible(anchorBox.value().rectangle, clip, anchor.enabled)){
        frame.state.value().close();
        this.m_context.discardPopupScope(frame.popupToken);
        this.snapshotContextMenu(frame);
        return true;
    }
    const PopupOptions options = BuildContextMenuPopupOptions(frame.state.value().m_anchor, frame.options.size);
    const auto placement = PlacePopup(options, this.m_paint.displayMetrics());
    if(!placement.has_value())
        return false;
    const PopupScope scope = UiScopeDescriptorFactory().basicPopup(frame.popupToken, frame.parentToken, placement.value());
    if(!this.m_context.updatePopupScope(frame.popupToken, scope) || !this.m_context.activatePopupScope(frame.popupToken))
        return false;
    if(!this.m_paint.beginOverlay(this.m_context.popupLayer())){
        const b8 ended = this.m_context.endPopupScope(false);
        if(!ended)
            this.m_context.fail();
        return false;
    }
    const Insets padding = MaxUiPadding(frame.popupStyle.padding, background.value().padding);
    this.m_paint.pushClip(placement.value().bounds);
    const b8 backgroundPainted = this.m_paint.drawRegion(background.value().name, placement.value().bounds);
    const b8 popped = this.m_paint.popClip();
    HitTargetFactory targets;
    const HitTarget barrier = targets.makeBarrierHitTarget(placement.value().bounds, placement.value().viewport);
    b8 painted = backgroundPainted && popped && this.m_context.addTarget(frame.popup, barrier);
    if(painted){
        auto item = this.makeItem();
        item.state = frame.rows;
        item.list = frame.list;
        LayoutBox box;
        box.rectangle = InsetUiRectBounds(placement.value().bounds, padding);
        box.clip = placement.value().bounds;
        painted = this.paintList(item, box) && this.contextMenuMatches(frame);
    }
    const b8 overlayEnded = this.m_paint.endOverlay();
    const b8 scopeEnded = this.m_context.endPopupScope(painted);
    if(painted)
        frame.state.value().m_popup.m_placement = placement.value();
    return painted && overlayEnded && scopeEnded;
}


b8 Builder::contextMenuStateMatches(in BuilderContextMenuFrame frame)const{
    if(!frame.state.has_value())
        return false;
    return MatchesContextMenuFrameStateValues(
        this.popupAncestorsVisible(),
        frame.state.value().revision(),
        frame.revision,
        frame.state.value().isOpen(),
        frame.open,
        frame.state.value().m_popup.instanceGeneration(),
        frame.popupToken.instanceGeneration,
        frame.state.value().m_popup.openGeneration(),
        frame.popupToken.openGeneration,
        frame.state.value().m_popup.m_parent,
        frame.parentToken,
        frame.state.value().m_list.inputGeneration(),
        frame.listToken.instanceGeneration,
        frame.state.value().m_owner,
        frame.widget.id,
        frame.state.value().m_ownerDeclaration,
        frame.widget.declarationGeneration,
        frame.state.value().m_anchorWidget,
        frame.anchor.id,
        frame.state.value().m_anchorDeclaration,
        frame.anchor.declarationGeneration
    );
}

b8 Builder::contextMenuMatches(in BuilderContextMenuFrame frame)const{
    return
        frame.source.has_value() && this.contextMenuStateMatches(frame)
        && frame.listToken.contentGeneration != 0u && frame.listToken.contentRevision != 0u && frame.source.value().instanceGeneration() == frame.listToken.contentGeneration && this.contextMenuStateMatches(frame)
        && frame.source.value().revision() == frame.listToken.contentRevision && this.contextMenuStateMatches(frame)
        && frame.source.value().rowCount() == frame.rowCount && this.contextMenuStateMatches(frame)
    ;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


EditBoxResult Builder::declareEditBox(in StringView stableKey, in EditBoxOptions options, mut EditModel model, mut EditBoxState state, in Optional<mut IEditActionSink> actions,
    in Optional<mut BuilderIntegerEditFrame> integerFrame, in Optional<mut BuilderFloatEditFrame> floatFrame){
    if(this.itemDeclarationBlocked() || model.textMode() != EditTextMode::SingleLine){
        this.m_context.fail();
        return EditBoxResult();
    }
    if(!this.synchronizePopup()){
        EditBoxResult result;
        result.valid = true;
        return result;
    }
    this.m_declaring = true;
    BuilderOperationEnd finish(this.m_declaring);
    const auto widget = this.m_context.declare(stableKey, WidgetKind::EditBox);
    if(!widget.has_value())
        return EditBoxResult();
    if((integerFrame.has_value() || floatFrame.has_value()) && (!this.numericStateAvailable(state) || !this.m_context.claimState(widget.value(), model.instanceGeneration()))){
        this.m_context.fail();
        return EditBoxResult();
    }
    if(!options.enabled)
        this.m_context.input().invalidateTarget(widget.value().id);
    EditBoxResult result;
    result.valid = true;
    result.focused = options.enabled && this.m_context.input().focus() == widget.value().id;
    if(this.m_editHost.has_value()){
        if(actions.has_value())
            result = this.m_editHost.value().editActions(widget.value(), options, this.m_context.popupToken(), model, actions.value());
        else
            result = this.m_editHost.value().edit(widget.value(), options, model);
    }
    if(!result.valid || this.m_context.failed()){
        result.valid = false;
        this.m_context.fail();
        return result;
    }
    if(!SnapshotNumericFrame(integerFrame, model, result.focused) || !SnapshotNumericFrame(floatFrame, model, result.focused)){
        this.m_context.fail();
        result.valid = false;
        return result;
    }
    auto item = this.makeItem();
    item.style = this.m_style;
    item.editStyle = this.m_editStyle;
    item.state = widget.value();
    item.editOptions = options;
    if(!this.prepareEditBox(result, model, state, item)){
        result.valid = false;
        return result;
    }
    if((integerFrame.has_value() && !this.numericEditFrameMatches(integerFrame.value())) || (floatFrame.has_value() && !this.numericEditFrameMatches(floatFrame.value()))){
        this.m_context.fail();
        result.valid = false;
        return result;
    }
    if(integerFrame.has_value())
        item.integerEdit = cast<u32>(this.m_scope.value().m_integerEdits.size());
    if(floatFrame.has_value())
        item.floatEdit = cast<u32>(this.m_scope.value().m_floatEdits.size());
    LayoutNodeDesc description;
    description.width = options.width;
    description.height = options.height;
    description.intrinsicSize = ResolveEditIntrinsicSize(this.loadEditMinimumSize(), item.editView.visualBounds().height, item.padding);
    if(!this.addItemNode(description, item)){
        result.valid = false;
        return result;
    }
    AppendOwned<BuilderItem>(this.m_scope.value().m_items, item);
    return result;
}

b8 Builder::prepareEditBox(in EditBoxResult result, mut EditModel model, mut EditBoxState state, mut BuilderItem item){
    state.updateFromModel(model.stamp(), result.focused, this.m_deltaSeconds);

    item.editFlags.enabled = item.editOptions.enabled;
    item.editFlags.hovered = this.m_context.input().hover() == item.state.id;
    item.editFlags.focused = result.focused;
    item.editFlags.readOnly = item.editOptions.readOnly;
    item.editFlags.caretVisible = state.caretElapsed < s_CaretVisiblePhaseEnd;
    item.editFlags.preeditCaretVisible = result.preeditCaretVisible;
    if(!item.editView.snapshot(model) || item.editView.shape(this.m_text, this.textShapeRequest("", this.m_style.fontSize)) != TextLayoutStatus::Success || !item.editView.measure(this.m_text, this.m_paint.displayMetrics())){
        this.m_context.fail();
        return false;
    }
    item.editState = Optional<mut EditBoxState>(state);
    item.padding = item.editStyle.padding;
    if(this.m_skin.has_value())
        item.padding = ControlStyleMetrics().editPadding(this.m_skin.value(), item.editStyle);
    return true;
}

b8 Builder::paintEditBox(in BuilderItem item, in LayoutBox box, in Optional<in HitTarget> navigation){
    if(!this.numericEditMatches(item))
        return false;
    const f32 caretWidth = ResolveSinglePixelCaretWidth(this.m_paint.displayMetrics());
    const auto arranged = item.editView.arrange(box.rectangle, item.padding, this.visibleClip(box.clip), Point(item.editState.value().scroll, 0.0f), caretWidth);
    if(!arranged.has_value())
        return false;
    in EditBoxPlacement placement = arranged.value();
    if(!item.editView.paint(this.m_text, this.m_paint, this.m_skin.value(), placement, item.editStyle, item.editFlags))
        return false;
    item.editState.value().placement = placement;
    item.editState.value().scroll = placement.scroll;
    HitTarget navigationTarget;
    if(navigation.has_value())
        navigationTarget = navigation.value();
    HitTargetFactory targets;
    const HitTarget target = targets.makeEditBoxHitTarget(navigationTarget, box.rectangle, this.visibleClip(box.clip), item.editOptions.enabled, item.contextMenu);
    if(!this.m_context.addTarget(item.state, target))
        return false;
    const b8 published = !this.m_editHost.has_value() || this.m_editHost.value().publish(item.state, item.editView, placement, item.editOptions);
    return published && this.numericEditMatches(item);
}


Point Builder::loadEditMinimumSize()const{
    if(!this.m_skin.has_value())
        return Point(s_StyleMinimumFieldWidth, 0.0f);
    return ControlStyleMetrics().editMinimumSize(this.m_skin.value(), this.m_editStyle);
}


