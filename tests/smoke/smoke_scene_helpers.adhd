b8 SetSmokeMaterialHalf4(
    in EntityID entity,
    in Name materialInterface,
    in StringView parameterPath,
    in VectorSingle value,
    mut World world
){
    return SetMaterialMutableHalf4(world, entity, materialInterface, parameterPath, value);
}

b8 SetSmokeSurfaceRoughnessF0(
    in EntityID entity,
    in Name materialInterface,
    in StringView f0Path,
    in StringView roughnessPath,
    in f32 f0,
    in f32 roughness,
    mut World world
){
    const f16x4u packedF0 = ConvertMaterialInstanceHalf4(VectorSingle(f0, f0, f0, 0.0f));
    const u16 packedRoughness = ConvertFloatToHalf(roughness);
    return SetMaterialMutableParameter(
        world,
        entity,
        materialInterface,
        f0Path,
        MaterialLayoutFieldType::f16x3,
        PackMaterialInstanceHalf4U(packedF0)
    ) && SetMaterialMutableParameter(
        world,
        entity,
        materialInterface,
        roughnessPath,
        MaterialLayoutFieldType::f16,
        PackMaterialInstanceHalfBits(packedRoughness)
    );
}

b8 SetSmokeOpticalMaterialParameters(
    in EntityID entity,
    in Name materialInterface,
    in f32 ior,
    in VectorSingle transmission,
    mut World world
){
    const u16 packedIor = ConvertFloatToHalf(ior);
    const f16x4u packedTransmission = ConvertMaterialInstanceHalf4(VectorSingle(transmission.x, transmission.y, transmission.z, 0.0f));
    return SetMaterialMutableParameter(
        world,
        entity,
        materialInterface,
        "runtime.ior",
        MaterialLayoutFieldType::f16,
        PackMaterialInstanceHalfBits(packedIor)
    ) && SetMaterialMutableParameter(
        world,
        entity,
        materialInterface,
        "runtime.unit_transmission",
        MaterialLayoutFieldType::f16x3,
        PackMaterialInstanceHalf4U(packedTransmission)
    );
}

b8 SetSmokeLightColor(in EntityID entity, in VectorSingle color, mut World world){
    if(!world.hasComponent<LightComponent>(entity))
