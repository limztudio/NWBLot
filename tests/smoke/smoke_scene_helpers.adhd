[[nodiscard]] FOUNDATION_INLINE Core::ECS::EntityID CreateSmokePointLight(
    const Float4& position,
    const Float4& color,
    const f32 intensity,
    const f32 range,
    Core::ECS::World& world
){
    return Impl::Scene::CreatePointLightEntity(world, position, color, intensity, range);
}

[[nodiscard]] FOUNDATION_INLINE b8 RecycleSmokeEntityGenerations(const u32 count, Core::ECS::World& world){
    for(u32 generation = 0u; generation < count; ++generation){
        const auto recycled = world.createEntity();
        if(!recycled.id().valid())
            return false;
        world.destroyEntity(recycled.id());
    }
    return true;
}

[[nodiscard]] FOUNDATION_INLINE u32 SmokeEntityRawId(const Core::ECS::EntityID entity)noexcept{
    return entity.id;
}

[[nodiscard]] FOUNDATION_INLINE Core::ECS::EntityID CreateSmokeDirectionalLight(
    const f32 pitch,
    const f32 yaw,
    const f32 roll,
    const Float4& color,
    const f32 intensity,
    Core::ECS::World& world
){
    return Impl::Scene::CreateDirectionalLightEntity(world, pitch, yaw, roll, color, intensity);
}

[[nodiscard]] FOUNDATION_INLINE Core::ECS::EntityID CreateSmokeDirectionalLight(
    const f32 pitch,
    const f32 yaw,
    const f32 roll,
    const Float4& color,
    const f32 intensity,
    const b8 enableCaustics,
    Core::ECS::World& world
){
    const auto light = Impl::Scene::CreateDirectionalLightEntity(world, pitch, yaw, roll, color, intensity);
    if(auto* const comp = world.tryGetComponent<Impl::Scene::LightComponent>(light))
        comp->enableCaustics = enableCaustics;
    return light;
}

[[nodiscard]] FOUNDATION_INLINE Core::ECS::EntityID CreateSmokePointLight(
    const Float4& position,
    const Float4& color,
    const f32 intensity,
    const f32 range,
    const f32 sourceRadius,
    const b8 enableCaustics,
    Core::ECS::World& world
){
    const auto light = Impl::Scene::CreatePointLightEntity(world, position, color, intensity, range);
    if(auto* const comp = world.tryGetComponent<Impl::Scene::LightComponent>(light)){
        comp->sourceRadius = sourceRadius;
        comp->enableCaustics = enableCaustics;
        return light;
    }
    return Core::ECS::s_InvalidEntityId;
}

