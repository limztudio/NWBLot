        const PlacedGlyph glyph = mixed.value().glyphs()[glyphIndex];
        sawLatin = sawLatin || FontFaceIdentityName(glyph.face) == Name(s_TestLatinFontPath);
        sawKorean = sawKorean || FontFaceIdentityName(glyph.face) == Name(s_TestKoreanFontPath);
