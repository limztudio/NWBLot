void VerifyUiImageSourceTests_NonPowerOfTwoMipsKeepPaddedBlockAndPayloadBounds(mut UiImageSourceTests self){
    Texture texture = Texture(self.m_inputArena, s_UiCaseTestsUiImagePaint);
    ASSERT_TRUE(self.prepareDefault(self.m_inputArena, texture));
    ASSERT_TRUE(texture.validatePayload());
    const Expected<SharedImageSource> sourceResult = MakeImageSource(self.m_sourceArena, texture);
    ASSERT_TRUE(sourceResult.has_value());
    const SharedImageSource source = sourceResult.value();
    ASSERT_TRUE(UiImageHandlePresent(source));
    const Span<TextureMipLevel> mips = UiReadImageTexture(source).mipLevels();
    ASSERT_EQ(mips.size(), 4u);
    EXPECT_EQ(mips[0u].width, 9u);
    EXPECT_EQ(mips[0u].height, 5u);
    EXPECT_EQ(mips[0u].blockCountX, 3u);
    EXPECT_EQ(mips[0u].blockCountY, 2u);
    EXPECT_EQ(mips[0u].sizeBytes, 96u);
    EXPECT_EQ(mips[1u].width, 4u);
    EXPECT_EQ(mips[1u].height, 2u);
    EXPECT_EQ(mips[1u].offsetBytes, 96u);
    EXPECT_EQ(mips[2u].offsetBytes, 112u);
    EXPECT_EQ(mips[3u].offsetBytes, 128u);
    EXPECT_EQ(UiReadImageTexture(source).payloadBytes().size(), 144u);
}

void VerifyUiImageSourceTests_RetainedSourceOutlivesCallerReplacementTextureAndItsArena(mut UiImageSourceTests self){
    SharedImageSource source = SharedImageSource();
    {
        GlobalArena callerArena = GlobalArena(s_UiCaseTestsUiImageSourceTemporary);
        Texture texture = Texture(callerArena, s_UiCaseTestsUiImageTemporary);
        ASSERT_TRUE(self.prepareDefault(callerArena, texture));
        const Expected<SharedImageSource> sourceReplacement = MakeImageSource(self.m_sourceArena, texture);
        ASSERT_TRUE(sourceReplacement.has_value());
        source = sourceReplacement.value();
        ASSERT_TRUE(UiImageHandlePresent(source));
        UiImageSourceExpectCopy(texture, source);
        UiImageSourceTextureDescription replacement = UiImageSourceTextureDescription();
        replacement.width = 1u;
        replacement.height = 1u;
        replacement.alphaMode = TextureAlphaMode::Opaque;
        replacement.seed = 91u;
        ASSERT_TRUE(self.prepareCustom(callerArena, texture, replacement));
        EXPECT_EQ(texture.payloadBytes().size(), 16u);
        EXPECT_EQ(UiReadImageTexture(source).payloadBytes().size(), 144u);
        EXPECT_EQ(UiReadImageTexture(source).width(), 9u);
    }
    EXPECT_EQ(UiReadImageIdentity(source).name(), s_UiImageSourceTempExpectedName);
    EXPECT_EQ(UiReadImageTexture(source).height(), 5u);
    EXPECT_EQ(UiReadImageTexture(source).alphaMode(), TextureAlphaMode::EmbeddedLdr);
    ASSERT_EQ(UiReadImageTexture(source).payloadBytes().size(), 144u);
    for(usize index = 0u; index < UiReadImageTexture(source).payloadBytes().size(); ++index)
        EXPECT_EQ(UiReadImageTexture(source).payloadBytes()[index], cast<u8>(37u + index * 17u));
    EXPECT_TRUE(UiReadImageTexture(source).validatePayload());
}

void VerifyUiImageSourceTests_IdenticalLoadsAndSamePathReplacementReceiveFreshGenerations(mut UiImageSourceTests self){
    Texture texture = Texture(self.m_inputArena, s_UiCaseTestsUiImageSharedPath);
    ASSERT_TRUE(self.prepareDefault(self.m_inputArena, texture));
    const Expected<SharedImageSource> originalResult = MakeImageSource(self.m_sourceArena, texture);
    ASSERT_TRUE(originalResult.has_value());
    const SharedImageSource original = originalResult.value();
    const Expected<SharedImageSource> identicalResult = MakeImageSource(self.m_sourceArena, texture);
    ASSERT_TRUE(identicalResult.has_value());
    const SharedImageSource identical = identicalResult.value();
    ASSERT_TRUE(UiImageHandlePresent(original));
    ASSERT_TRUE(UiImageHandlePresent(identical));
    EXPECT_EQ(UiReadImageIdentity(original), UiReadImageIdentity(identical));
    EXPECT_NE(UiReadImageGeneration(original), UiReadImageGeneration(identical));
    EXPECT_FALSE(UiSameTextureAddress(original, identical));
    UiImageSourceTextureDescription changed = UiImageSourceTextureDescription();
    changed.seed = 149u;
    ASSERT_TRUE(self.prepareCustom(self.m_inputArena, texture, changed));
    const Expected<SharedImageSource> replacementResult = MakeImageSource(self.m_sourceArena, texture);
    ASSERT_TRUE(replacementResult.has_value());
    const SharedImageSource replacement = replacementResult.value();
    ASSERT_TRUE(UiImageHandlePresent(replacement));
    EXPECT_EQ(UiReadImageIdentity(replacement), UiReadImageIdentity(original));
    EXPECT_NE(UiReadImageGeneration(replacement), UiReadImageGeneration(original));
    EXPECT_NE(UiReadImageGeneration(replacement), UiReadImageGeneration(identical));
    EXPECT_EQ(UiReadImageTexture(replacement).payloadBytes()[0u], 149u);
    EXPECT_EQ(UiReadImageTexture(original).payloadBytes()[0u], 37u);
    EXPECT_EQ(UiReadImageTexture(identical).payloadBytes(), UiReadImageTexture(original).payloadBytes());
}

void VerifyUiImageSourceTests_CopiedSharedHandleRetainsTheSameImmutableVersionAfterOriginalRelease(mut UiImageSourceTests self){
    Texture texture = Texture(self.m_inputArena, s_UiCaseTestsUiImageRetained);
    ASSERT_TRUE(self.prepareDefault(self.m_inputArena, texture));
    const Expected<SharedImageSource> originalResult = MakeImageSource(self.m_sourceArena, texture);
    ASSERT_TRUE(originalResult.has_value());
    SharedImageSource original = originalResult.value();
    ASSERT_TRUE(UiImageHandlePresent(original));
    const u64 generation = UiReadImageGeneration(original);
    const SharedImageSource retained = original;
    EXPECT_TRUE(UiSameImageHandlePtr(retained, original));
    UiResetImageHandle(original);
    ASSERT_TRUE(UiImageHandlePresent(retained));
    EXPECT_EQ(UiReadImageGeneration(retained), generation);
    EXPECT_EQ(UiReadImageTexture(retained).payloadBytes()[143u], cast<u8>(37u + 143u * 17u));
    EXPECT_TRUE(UiReadImageTexture(retained).validatePayload());
}

void VerifyUiImageSourceTests_SeparateHdrAlphaOwnsTheCompleteTrailingPayloadStream(mut UiImageSourceTests self){
    UiImageSourceTextureDescription description = UiImageSourceTextureDescription();
    description.format = TexturePayloadFormat::UastcHdr4x4;
    description.alphaMode = TextureAlphaMode::SeparateUastcLdr4x4;
    Texture texture = Texture(self.m_inputArena, s_UiCaseTestsUiImageHdr);
    ASSERT_TRUE(self.prepareCustom(self.m_inputArena, texture, description));
    ASSERT_TRUE(texture.validatePayload());
    const Expected<SharedImageSource> sourceResult = MakeImageSource(self.m_sourceArena, texture);
    ASSERT_TRUE(sourceResult.has_value());
    ASSERT_TRUE(UiImageHandlePresent(sourceResult.value()));
    self.expectSeparateHdrAlphaStream(texture, sourceResult.value());
}

void VerifyUiImageSourceTests_RejectsValidCubeAndVolumeAssetsRatherThanFlatteningTheirSlices(mut UiImageSourceTests self){
    Array<TextureDimensionEnum, 2u> dimensions = Array<TextureDimensionEnum, 2u>();
    dimensions[0u] = TextureDimension::TextureCube;
    dimensions[1u] = TextureDimension::Texture3D;
    for(in TextureDimensionEnum dimension : dimensions){
        UiImageSourceTextureDescription description = UiImageSourceTextureDescription();
        description.dimension = dimension;
        if(dimension == TextureDimension::TextureCube)
            description.height = 9u;
        else
            description.height = 5u;
        if(dimension == TextureDimension::Texture3D)
            description.depth = 4u;
        else
            description.depth = 1u;
        Texture texture = Texture(self.m_inputArena, s_UiCaseTestsUiImageSpatial);
        ASSERT_TRUE(self.prepareCustom(self.m_inputArena, texture, description));
        ASSERT_TRUE(texture.validatePayload());
        EXPECT_FALSE(MakeImageSource(self.m_sourceArena, texture).has_value());
    }
}

void VerifyUiImageSourceTests_RejectsMissingAssetIdentityAndEmptyTexturePayload(mut UiImageSourceTests self){
    Texture unnamed = Texture(self.m_inputArena);
    ASSERT_TRUE(self.prepareDefault(self.m_inputArena, unnamed));
    EXPECT_FALSE(MakeImageSource(self.m_sourceArena, unnamed).has_value());
    Texture empty = Texture(self.m_inputArena, s_UiFixtureNameTestsUiImageEmpty);
    EXPECT_FALSE(MakeImageSource(self.m_sourceArena, empty).has_value());
    Texture texture = Texture(self.m_inputArena, s_UiFixtureNameTestsUiImageNoBytes);
    ASSERT_TRUE(self.prepareDefault(self.m_inputArena, texture));
    self.installEmptyBytesKeepMips(texture);
    EXPECT_FALSE(MakeImageSource(self.m_sourceArena, texture).has_value());
}

