[cpp_header("<core/common/module.h>"), cpp_name("::NWB::Core::Common::Initializer"), cpp_flags(no_copy, no_assign)]
extern class Initializer{
    b8 acquire(...);
    void enqueue(...);
    void finalize(...);
    b8 initialize(...);
    void release(...);
};

[cpp_header("<core/common/module.h>"), cpp_name("::NWB::Core::Common::InitializerGuard"), cpp_flags(self_defaulted, brace_init, no_copy, no_assign)]
extern class InitializerGuard{
    void finalize(...);
    b8 initialize(...);
};

[cpp_header("<core/common/module.h>"), cpp_name("::NWB::Core::Common::Initializerable"), cpp_flags(no_copy, no_assign, abstract, polymorphic_base)]
extern class Initializerable{
    [cpp_flags(unwind)] b8 initialize();
    void finalize();
};


