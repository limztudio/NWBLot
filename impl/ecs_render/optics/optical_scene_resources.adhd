native{
#include <impl/ecs_render/optics/optical_scene_upload.adhd.h>
#include <impl/ecs_render/optics/optical_bounds_finalize.adhd.h>

#include <impl/ecs_render/optics/graph_types.adhd.h>

#include <core/alloc/global.h>
#include <core/graphics/rhi/gpu_descriptor_heap.h>
#include <core/graphics/rhi/resource.h>

#include <global/arena_object.h>
#include <global/refcount_ptr.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_CORE_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class GraphicsRuntime;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_CORE_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RayTracingOpticalSceneResources final : NoCopy{
public:
    RayTracingOpticalSceneResources(Core::Alloc::GlobalArena& arena, Core::GraphicsRuntime& graphics, const Name identity)noexcept
        : m_arena(arena)
        , m_graphics(graphics)
        , m_identity(identity)
        , m_uploads(arena)
        , m_runtimeBounds(arena, graphics)
    {}


public:
    void invalidate();
    void resetPrepared()noexcept{ m_prepared = false; }
    [[nodiscard]] b8 prepare(const RayTracingOpticalSceneGather& gather);
    [[nodiscard]] b8 prepareRuntimeBounds(const RayTracingOpticalSceneGather& gather, RendererShaderSystem& shaderSystem);
    [[nodiscard]] RayTracingOpticalSceneSnapshot snapshot()const noexcept;


private:
    Core::Alloc::GlobalArena& m_arena;
    Core::GraphicsRuntime& m_graphics;
    Name m_identity;
    RayTracingOpticalSceneSnapshot m_resources;
    Vector<RayTracingOpticalSceneUploadHandle, Core::Alloc::GlobalArena> m_uploads;
    RayTracingOpticalBoundsFinalizeResources m_runtimeBounds;
    RayTracingOpticalBoundsFinalizeHandle m_runtimeBoundsSnapshot;
    usize m_capacity = 0u;
    b8 m_prepared = false;
    b8 m_runtimeBoundsRequired = false;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

