void VerifyAdhdCompiler_StringAndCompactSubstrPreserveOwnershipAndSingleEvaluation(){
    AdhdTestArena arena = AdhdTestArena();
    i32 recvCounter = 0;
    i32 posCounter = 0;
    i32 countCounter = 0;
