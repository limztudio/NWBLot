const StringView s_RendererComponentMetadata = "renderer_component asset;\nasset.material = \"project/materials/glass\";\nasset.visible = 1;\nasset.optical_volume_coincidence = \"shared_group\";\nasset.optical_volume_group = \"lens_assembly\";\nasset.optical_volume_priority = 4;\nasset.optical_boundary_mode = \"closed_priority\";\nasset.optical_medium_priority = 9;\n";


void VerifyAssetsGraphics_SkinBinaryRejectsInvalidWeightsJointsMatricesAndReservedFieldsWithoutReplacingState(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    native(mut testArena){
        using namespace NWB::Impl;
        SkinHeaderBinary header;
        header.meshNameHash = Name(s_AssetCaseProjectMeshesOriginal).hash();
        header.skeletonNameHash = Name(s_AssetCaseProjectSkeletonsOriginal).hash();
        header.influenceCount = 1u;
        header.inverseBindMatrixCount = 1u;
        SkinInfluence4 influence;
        influence.weight = Float4U(1.0f, 0.0f, 0.0f, 0.0f);
        const SkeletonJointMatrix originalMatrix = MatrixIdentity<Float34>();
        Core::Assets::AssetBytes original(testArena.arena);
        AppendPOD(original, header);
        AppendPOD(original, influence);
        AppendPOD(original, originalMatrix);
        Skin skin(testArena.arena, Name(s_AssetCaseProjectSkinsOriginal));
        ASSERT_TRUE(skin.loadBinary(original));
        SkinAssetCodec codec;
        for(u32 invalidCase = 0u; invalidCase < 8u; ++invalidCase){
            SkinHeaderBinary malformedHeader = header;
            malformedHeader.meshNameHash = Name(s_AssetCaseProjectMeshesReplacement).hash();
            SkinInfluence4 malformedInfluence = influence;
            SkeletonJointMatrix matrix = originalMatrix;
            switch(invalidCase){
            case 0u: malformedHeader.padding0 = 1u; break;
            case 1u: malformedInfluence.weight.x = BitCast<f32>(0x7fc00001u); break;
            case 2u: malformedInfluence.weight.x = -1.0f; break;
            case 3u: malformedInfluence.weight.x = 0.5f; break;
            case 4u: malformedInfluence.joint[3u] = 1u; break;
            case 5u: matrix._11 = 0.0f; break;
            case 6u: matrix._14 = BitCast<f32>(0x7f800000u); break;
            }
            Core::Assets::AssetBytes malformed(testArena.arena);
            AppendPOD(malformed, malformedHeader);
            AppendPOD(malformed, malformedInfluence);
            AppendPOD(malformed, matrix);
            if(invalidCase == 7u)
                malformed.push_back(0u);
            EXPECT_FALSE(skin.loadBinary(malformed)) << invalidCase;
            Core::Assets::AssetBytes retained(testArena.arena);
            ASSERT_TRUE(codec.serialize(skin, retained));
            EXPECT_EQ(retained, original) << invalidCase;
        }
    }
}

void VerifyAssetsGraphics_ModelBinaryRejectsNonFiniteTransformsAndReservedFieldsWithoutReplacingState(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    native(mut testArena){
        using namespace NWB::Impl;
        ModelHeaderBinary header;
        header.skeletonObjectCount = 1u;
        header.staticMeshObjectCount = 1u;
        header.skinnedMeshObjectCount = 1u;
        ModelSkeletonObjectBinary skeleton;
        skeleton.nameHash = Name(s_AssetCaseRig).hash();
        skeleton.skeletonNameHash = Name(s_AssetCaseProjectSkeletonsOriginal).hash();
        skeleton.transform = MatrixIdentity<Float34>();
        ModelStaticMeshObjectBinary staticMesh;
        staticMesh.nameHash = Name(s_AssetCaseProp).hash();
        staticMesh.meshNameHash = Name(s_AssetCaseProjectMeshesProp).hash();
        staticMesh.transform = MatrixIdentity<Float34>();
        ModelSkinnedMeshObjectBinary skinnedMesh;
        skinnedMesh.nameHash = Name(s_AssetCaseBody).hash();
        skinnedMesh.skinNameHash = Name(s_AssetCaseProjectSkinsBody).hash();
        skinnedMesh.skeletonObjectNameHash = skeleton.nameHash;
        skinnedMesh.transform = MatrixIdentity<Float34>();
        Core::Assets::AssetBytes original(testArena.arena);
        AppendPOD(original, header);
        AppendPOD(original, skeleton);
        AppendPOD(original, staticMesh);
        AppendPOD(original, skinnedMesh);
        Model model(testArena.arena, Name(s_AssetCaseProjectModelsOriginal));
        ASSERT_TRUE(model.loadBinary(original));
        ModelAssetCodec codec;
        for(u32 invalidCase = 0u; invalidCase < 7u; ++invalidCase){
            auto malformedHeader = header;
            auto malformedSkeleton = skeleton;
            auto malformedStatic = staticMesh;
            auto malformedSkinned = skinnedMesh;
            switch(invalidCase){
            case 0u: malformedHeader.padding0 = 1u; break;
            case 1u: malformedSkeleton.transform._11 = BitCast<f32>(0x7fc00001u); break;
            case 2u: malformedStatic.transform._24 = BitCast<f32>(0x7f800000u); break;
            case 3u: malformedSkinned.transform._33 = BitCast<f32>(0xff800000u); break;
            case 4u: malformedStatic.nameHash = skeleton.nameHash; break;
            case 5u: malformedSkinned.skeletonObjectNameHash = staticMesh.nameHash; break;
            }
            Core::Assets::AssetBytes malformed(testArena.arena);
            AppendPOD(malformed, malformedHeader);
            AppendPOD(malformed, malformedSkeleton);
            AppendPOD(malformed, malformedStatic);
            AppendPOD(malformed, malformedSkinned);
            if(invalidCase == 6u)
                malformed.pop_back();
            EXPECT_FALSE(model.loadBinary(malformed)) << invalidCase;
            Core::Assets::AssetBytes retained(testArena.arena);
            ASSERT_TRUE(codec.serialize(model, retained));
            EXPECT_EQ(retained, original) << invalidCase;
        }
    }
}

void VerifyAssetsGraphics_SkeletonBinaryRejectsNonFinitePosesInvalidParentsAndReservedFieldsWithoutReplacingState(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    native(mut testArena){
        using namespace NWB::Impl;
        SkeletonHeaderBinary header;
        header.jointCount = 1u;
        SkeletonJointBinary joint;
        joint.nameHash = Name(s_AssetCaseRoot).hash();
        joint.parentIndex = s_SkeletonInvalidJointIndex;
        joint.localBindPose = MatrixIdentity<Float34>();
        Core::Assets::AssetBytes original(testArena.arena);
        AppendPOD(original, header);
        AppendPOD(original, joint);
        Skeleton skeleton(testArena.arena, Name(s_AssetCaseProjectSkeletonsOriginal));
        ASSERT_TRUE(skeleton.loadBinary(original));
        SkeletonAssetCodec codec;
        for(u32 invalidCase = 0u; invalidCase < 7u; ++invalidCase){
            auto malformedHeader = header;
            auto malformedJoint = joint;
            malformedJoint.nameHash = Name(s_AssetCaseReplacement).hash();
            switch(invalidCase){
            case 0u: malformedHeader.padding0 = 1u; break;
            case 1u: malformedJoint.padding0 = 1u; break;
            case 2u: malformedJoint.padding1[1u] = 1u; break;
            case 3u: malformedJoint.localBindPose._14 = BitCast<f32>(0x7fc00001u); break;
            case 4u: malformedJoint.parentIndex = 0u; break;
            case 5u: malformedHeader.jointCount = static_cast<u64>(Limit<u32>::s_Max) + 1u; break;
            }
            Core::Assets::AssetBytes malformed(testArena.arena);
            AppendPOD(malformed, malformedHeader);
            AppendPOD(malformed, malformedJoint);
            if(invalidCase == 6u)
                malformed.push_back(0u);
            EXPECT_FALSE(skeleton.loadBinary(malformed)) << invalidCase;
            Core::Assets::AssetBytes retained(testArena.arena);
            ASSERT_TRUE(codec.serialize(skeleton, retained));
            EXPECT_EQ(retained, original) << invalidCase;
            EXPECT_EQ(skeleton.findJointIndex(Name(s_AssetInputNameRoot)), 0u);
            EXPECT_EQ(skeleton.findJointIndex(Name(s_AssetInputNameReplacement)), s_SkeletonInvalidJointIndex);
        }
    }
}

void VerifyBuildInputSelection_MissingRootTakesPriorityOverMissingOutput(mut BuildInputSelection self){
    EXPECT_FALSE(ValidateAssetBuilderPathInputs(false, false));
    EXPECT_TRUE(SawCapturedError(self.m_logger, "no asset roots specified"));
    EXPECT_FALSE(SawCapturedError(self.m_logger, "output directory is empty"));
    EXPECT_FALSE(ValidateAssetBuilderPathInputs(true, false));
    EXPECT_TRUE(SawCapturedError(self.m_logger, "output directory is empty"));
    EXPECT_EQ(self.m_logger.errorCount(), 2u);
}

void VerifyBuildInputSelection_EmptyBuildDomainIsRejectedBeforeInputDiscovery(mut BuildInputSelection self){
    self.m_options.assetType.clear();
    EXPECT_FALSE(BuildAssets(self.m_options, self.m_scratchArena));
    EXPECT_TRUE(SawCapturedError(self.m_logger, "unsupported --asset-type ''"));
    EXPECT_EQ(self.m_logger.errorCount(), 1u);

    ASSERT_TRUE(self.m_options.assetType.assign(s_AssetVolumeName));
    EXPECT_FALSE(BuildAssets(self.m_options, self.m_scratchArena));
    EXPECT_TRUE(SawCapturedError(self.m_logger, "no asset roots specified"));
    EXPECT_EQ(self.m_logger.errorCount(), 2u);
}

void VerifyBuildInputSelection_ExactInputsPreserveDiscoveredOrderAndDuplicateRecords(mut BuildInputSelection self){
    self.addFile("assets/z.nwb");
    self.addFile(s_BuildInputAssetsANwb);
    self.addFile("assets/excluded.nwb");
    self.addFile(s_BuildInputAssetsANwb);
    self.addInput("assets/./a.nwb");
    self.addInput("assets/z.nwb");
    self.addInput(s_BuildInputAssetsANwb);
    ASSERT_TRUE(self.select());
    native(mut self){
        ASSERT_EQ(self.m_files.size(), 3u);
        EXPECT_EQ(PathToString(self.m_testArena.arena, self.m_files[0].filePath.filenameView()), "z.nwb");
        EXPECT_EQ(PathToString(self.m_testArena.arena, self.m_files[1].filePath.filenameView()), s_BuildInputANwb);
        EXPECT_EQ(PathToString(self.m_testArena.arena, self.m_files[2].filePath.filenameView()), s_BuildInputANwb);
    }
}

void VerifyBuildInputSelection_DirectoryInputsRespectBoundariesAndAllowEmptyRoots(mut BuildInputSelection self){
    self.addFile("assets/part/a.nwb");
    self.addFile("assets/partial/b.nwb");
    self.addFile("assets/part/nested/c.nwb");
    self.addInput("assets/part/../part");
    self.addInput("assets/part/nested");
    self.addInput("assets/empty");
    ASSERT_TRUE(self.select());
    native(mut self){
        ASSERT_EQ(self.m_files.size(), 2u);
        EXPECT_EQ(PathToString(self.m_testArena.arena, self.m_files[0].filePath.filenameView()), s_BuildInputANwb);
        EXPECT_EQ(PathToString(self.m_testArena.arena, self.m_files[1].filePath.filenameView()), "c.nwb");
    }
}

void VerifyBuildInputSelection_RejectedInputsLeaveDiscoveredFilesIntact(mut BuildInputSelection self){
    self.addFile(s_BuildInputAssetsANwb);
    self.addFile("outside/b.nwb");
    self.addInput(s_BuildInputAssetsANwb);
    self.addInput("outside");
    EXPECT_FALSE(self.select());
    native(mut self){
        EXPECT_EQ(self.m_files.size(), 2u);
        self.m_options.inputs.clear();
        self.addInput("assets/missing.nwb");
        EXPECT_FALSE(self.select());
        EXPECT_EQ(self.m_files.size(), 2u);
        self.m_options.inputs.clear();
        self.addInput("assets/empty");
        ASSERT_TRUE(self.select());
        EXPECT_TRUE(self.m_files.empty());
    }
}

void VerifyBuildInputSelection_DirectoryCaseFollowsHostFilesystemContract(mut BuildInputSelection self){
    self.addFile("assets/Case/a.nwb");
    self.addFile("assets/case/b.nwb");
    self.addInput("assets/Case");
    ASSERT_TRUE(self.select());
    native(mut self){
#if defined(NWB_PLATFORM_WINDOWS)
        EXPECT_EQ(self.m_files.size(), 2u);
#else
        ASSERT_EQ(self.m_files.size(), 1u);
        EXPECT_EQ(PathToString(self.m_testArena.arena, self.m_files[0].filePath.filenameView()), s_BuildInputANwb);
#endif
    }
}

void VerifyBuildInputSelection_InferredRootsDeduplicateAssetsAncestorsWithoutDroppingExternalDirectories(mut BuildInputSelection self){
    self.addFile("assets/part/a.nwb");
    self.addFile("impl/assets/b.nwb");
    self.addFile("loose/c.nwb");
    ScratchArena scratchArena(s_AssetCaseTestsAssetsInferredRoots);
    native(mut self, mut scratchArena){
        namespace Assets = NWB::Core::Assets;
        Assets::CookVector<Assets::CookString> sources(self.m_testArena.arena);
        for(const AStringView source : { "assets/part/../part/a.nwb", "impl/assets/b.nwb", "assets/empty", "loose/c.nwb" })
            sources.emplace_back(source, self.m_testArena.arena);
        const auto roots = Assets::ResolveAssetRoots(self.m_root, sources, true, Assets::AssetRootDuplicatePolicy::ExactText, scratchArena);
        ASSERT_TRUE(roots);
        ASSERT_EQ(roots->size(), 3u);
        EXPECT_EQ((*roots)[0].path, (self.m_root / s_AssetsDirectory).lexicallyNormal());
        EXPECT_EQ((*roots)[0].virtualRoot.view(), s_ProjectVirtualRoot);
        EXPECT_EQ((*roots)[1].path, (self.m_root / "impl" / s_AssetsDirectory).lexicallyNormal());
        EXPECT_EQ((*roots)[1].virtualRoot.view(), "engine");
        EXPECT_EQ((*roots)[2].path, (self.m_root / "loose").lexicallyNormal());
        EXPECT_EQ((*roots)[2].virtualRoot.view(), s_ProjectVirtualRoot);
    }
}

void VerifyBuildInputSelection_ExplicitRootsPreserveFirstSpellingAndCallerDuplicatePolicy(mut BuildInputSelection self){
    ScratchArena scratchArena(s_AssetCaseTestsAssetsExplicitRoots);
    native(mut self, mut scratchArena){
        namespace Assets = NWB::Core::Assets;
        Assets::CookVector<Assets::CookString> sources(self.m_testArena.arena);
        for(const AStringView source : { "assets/./Case", "assets/Case", "assets/case", "impl/assets/graphics" })
            sources.emplace_back(source, self.m_testArena.arena);
        sources.push_back(PathToString(self.m_testArena.arena, self.m_root / s_AssetsDirectory / "Case"));
        const auto exact = Assets::ResolveAssetRoots(self.m_root, sources, false, Assets::AssetRootDuplicatePolicy::ExactText, scratchArena);
        ASSERT_TRUE(exact);
        ASSERT_EQ(exact->size(), 3u);
        EXPECT_EQ((*exact)[0].path, (self.m_root / s_AssetsDirectory / "Case").lexicallyNormal());
        EXPECT_EQ((*exact)[1].path, (self.m_root / s_AssetsDirectory / "case").lexicallyNormal());
        // Explicit roots remain exact directories rather than climbing to their assets ancestor.
        EXPECT_EQ((*exact)[2].path, (self.m_root / "impl" / s_AssetsDirectory / "graphics").lexicallyNormal());
        EXPECT_EQ((*exact)[2].virtualRoot.view(), s_ProjectVirtualRoot);
        const auto host = Assets::ResolveAssetRoots(self.m_root, sources, false, Assets::AssetRootDuplicatePolicy::HostFilesystem, scratchArena);
        ASSERT_TRUE(host);
#if defined(NWB_PLATFORM_WINDOWS)
        ASSERT_EQ(host->size(), 2u);
        EXPECT_EQ((*host)[1].path, (*exact)[2].path);
#else
        ASSERT_EQ(host->size(), exact->size());
        EXPECT_EQ((*host)[1].path, (*exact)[1].path);
#endif
        EXPECT_EQ((*host)[0].path, (*exact)[0].path);
    }
}

void VerifyBuildInputSelection_RootResolutionFailureRetainsSourceIndexWithoutPublishingPartialRoots(mut BuildInputSelection self){
    ScratchArena scratchArena(s_AssetCaseTestsAssetsRejectedRoots);
    native(mut self, mut scratchArena){
        namespace Assets = NWB::Core::Assets;
        Assets::CookVector<Assets::CookString> sources(self.m_testArena.arena);
        sources.emplace_back("assets", self.m_testArena.arena);
        sources.emplace_back("", self.m_testArena.arena);
        const auto rejected = Assets::ResolveAssetRoots(self.m_root, sources, false, Assets::AssetRootDuplicatePolicy::ExactText, scratchArena);
        ASSERT_FALSE(rejected);
        EXPECT_EQ(rejected.error().sourceIndex, 1u);
        EXPECT_EQ(rejected.error().reason, Assets::AssetRootResolutionFailure::ResolvePath);
        EXPECT_TRUE(rejected.error().inputPath.empty());
        EXPECT_TRUE(static_cast<b8>(rejected.error().error));
        sources[1] = "assets/empty";
        const auto recovered = Assets::ResolveAssetRoots(self.m_root, sources, true, Assets::AssetRootDuplicatePolicy::ExactText, scratchArena);
        ASSERT_TRUE(recovered);
        ASSERT_EQ(recovered->size(), 1u);
        EXPECT_EQ((*recovered)[0].path, (self.m_root / s_AssetsDirectory).lexicallyNormal());
    }
}

void VerifyAssetsGraphics_RendererOpticalVolumeGroupRejectsOnlyAsciiEdgePadding(){
    EXPECT_FALSE(IsUnpaddedRendererOpticalVolumeGroup(""));
