#include "smoke_world.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class UiLayerSmokeProject : IProjectEntryCallbacks{
    public UiLayerSmokeProject(mut NotNullUniquePtr<World> world, mut ProjectRuntimeContext context){
        this.m_world = TakeUiLayerSmokeWorld(world);
        this.m_context = context;
        this.m_resizeRenderPass = UiLayerResizeRenderPass(context.graphics);
    }

    public ~UiLayerSmokeProject(){
        this.destroyRuntime();
    }

    public b8 onStartup()override{
        if(ReadSmokeEnvironmentFlag("NWB_UI_LAYER_PERSISTENT_STATE_TEST")){
            if(!CheckUiLayerSmokePersistentState(this.m_context)){
                error("UiLayerSmokeProject: persistent state self-filter failed");
                return false;
            }
            [essential] info("UiLayerSmokeProject: persistent state self-filter passed");
        }
        if(!ConfigureUiLayerSmokeStartup(
            this.m_context,
            this.m_world,
            this.m_resizeRenderPass,
            this.m_resizeRenderPassRegistered,
            this.m_resizePresentationBaseline,
            this.m_framebufferCapture
        ))
            return false;

        [essential] info("UiLayerSmokeProject: standalone layer ready; default atlas; SDR; empty startup frames=2");
        return true;
    }

    public void onShutdown()override{
        this.destroyRuntime();
        [essential] info("UiLayerSmokeProject: shutdown");
    }

    public b8 onUpdate(in f32 delta)override{
        if(this.m_resizeRenderPassRegistered && !this.m_resizePresentationReported){
            const u64 presentations = this.m_context.graphics.getSuccessfulPresentationCount();
            if(presentations >= this.m_resizePresentationBaseline && presentations - this.m_resizePresentationBaseline >= s_ResizePreparationPresentations){
                [essential] info("UiLayerSmokeProject: resize scene presented");
                this.m_resizePresentationReported = true;
            }
        }
        return TickUiLayerSmokeWorld(delta, this.m_world, this.m_framebufferCapture);
    }

    private void destroyRuntime(){
        if(this.m_resizeRenderPassRegistered){
            this.m_context.graphics.removeRenderPass(this.m_resizeRenderPass);
            this.m_resizeRenderPassRegistered = false;
        }
        StopUiLayerSmokeCaptureAndClearWorld(this.m_context, this.m_world, this.m_framebufferCapture);
    }

    private NotNullUniquePtr<World> m_world;
    private UniquePtr<FramebufferCapture> m_framebufferCapture = UniquePtr<FramebufferCapture>();
    private mut ProjectRuntimeContext m_context;
    private UiLayerResizeRenderPass m_resizeRenderPass;
    private b8 m_resizeRenderPassRegistered = false;
    private b8 m_resizePresentationReported = false;
    private u64 m_resizePresentationBaseline = 0u;
}

native{
NWB::ProjectFrameClientSize NWB::QueryProjectFrameClientSize(){
    return { 960u, 540u };
}

TStringView NWB::QueryProjectWindowTitle()noexcept{
    return NWB_TEXT("NWB UI Layer Smoke");
}

b8 NWB::ConfigureProjectRuntime(ProjectStartupContext& context)noexcept{
    return context.graphics.setBindlessHeapAbi(Impl::AssetsGraphicsBindless::MakeGpuDescriptorHeapAbi()) && context.graphics.setHDR10OutputEnabled(false) && context.graphics.setSwapChainReadbackEnabled(true);
}

UniquePtr<NWB::IProjectEntryCallbacks> NWB::CreateProjectEntryCallbacks(ProjectRuntimeContext& context){
    auto world = Tests::Smoke::CreateUiLayerSmokeWorld(context);
    if(!world)
        return nullptr;
    return MakeUnique<Tests::Smoke::UiLayerSmokeProject>(*world, context);
}
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
