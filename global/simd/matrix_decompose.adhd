////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_name("::MatrixDecomposition"), cpp_flags(self_defaulted, binary_serializable, brace_init)]
extern class MatrixDecomposition{
    VectorSingle rotation;
    VectorSingle scale;
    VectorSingle translation;
};

[cpp_name("::MatrixDoubleDecomposition"), cpp_flags(self_defaulted, binary_serializable, brace_init)]
extern class MatrixDoubleDecomposition{
    VectorDouble rotation;
    VectorDouble scale;
    VectorDouble translation;
};

[cpp_name("::RigidDualQuaternion"), cpp_flags(self_defaulted, binary_serializable, brace_init)]
extern class RigidDualQuaternion{
    VectorSingle dual;
    VectorSingle real;
};

[cpp_name("::RigidDualQuaternionDouble"), cpp_flags(self_defaulted, binary_serializable, brace_init)]
extern class RigidDualQuaternionDouble{
    VectorDouble dual;
    VectorDouble real;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_name("::MatrixDecompose")]
extern Expected<MatrixDecomposition> MatrixDecompose(in MatrixSingle a0);

[cpp_name("::MatrixDoubleDecompose")]
extern Expected<MatrixDoubleDecomposition> MatrixDoubleDecompose(in MatrixDouble a0);

[cpp_name("::MatrixDoubleIsAffine")]
extern b8 MatrixDoubleIsAffine(in MatrixDouble a0, in auto a1);

[cpp_name("::MatrixDoubleIsInvertibleAffine")]
extern b8 MatrixDoubleIsInvertibleAffine(in MatrixDouble a0, in auto a1, in auto a2);

[cpp_name("::MatrixDoubleIsRigidAffine")]
extern b8 MatrixDoubleIsRigidAffine(in MatrixDouble a0, in auto a1, in auto a2);

[cpp_name("::MatrixDoubleLinearDeterminantV")]
extern VectorDouble MatrixDoubleLinearDeterminantV(in MatrixDouble a0);

[cpp_name("::MatrixDoubleTryBuildRigidDualQuaternion")]
extern Expected<RigidDualQuaternionDouble> MatrixDoubleTryBuildRigidDualQuaternion(in MatrixDouble a0, in auto a1, in auto a2);

[cpp_name("::MatrixDoubleTryBuildRigidRotationQuaternion")]
extern Expected<VectorDouble> MatrixDoubleTryBuildRigidRotationQuaternion(in MatrixDouble a0, in auto a1, in auto a2);

[cpp_name("::MatrixIsAffine")]
extern b8 MatrixIsAffine(in MatrixSingle a0, in auto a1);

[cpp_name("::MatrixIsInvertibleAffine")]
extern b8 MatrixIsInvertibleAffine(in MatrixSingle a0, in f32 a1, in f32 a2);

[cpp_name("::MatrixIsRigidAffine")]
extern b8 MatrixIsRigidAffine(in MatrixSingle a0, in auto a1, in auto a2);

[cpp_name("::MatrixLinearDeterminantV")]
extern VectorSingle MatrixLinearDeterminantV(in MatrixSingle a0);

[cpp_name("::MatrixTryBuildRigidDualQuaternion")]
extern Expected<RigidDualQuaternion> MatrixTryBuildRigidDualQuaternion(in MatrixSingle a0, in auto a1, in auto a2);

[cpp_name("::MatrixTryBuildRigidRotationQuaternion")]
extern Expected<VectorSingle> MatrixTryBuildRigidRotationQuaternion(in MatrixSingle a0, in auto a1, in auto a2);


