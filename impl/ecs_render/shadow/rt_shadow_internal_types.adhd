class SoftShadowSplitResourceInputs{
    public in DeferredFrameTargets targets;
    public in RayTracingDeferredGraphResourceSnapshot rayTracingResources;
    public in RayTracingShadowVisibilityGraphPlanSnapshot rayTracingPlan;
    public in RayTracingSceneGraphReads hardwareSceneReads;
    public Span<GpuGraphResourceId> hardwareTransparentScratch;
    public SoftShadowSplitRoute route;
    public Span<GpuGraphResourceId> traceGeometryResources;
    public GpuGraphResourceId worldPosition;
    public GpuGraphResourceId normal;
    public GpuGraphResourceId depth;
    public GpuGraphResourceId shadowVisibility;
    public GpuGraphResourceId currentBindlessSlots;
    public GpuGraphResourceId sceneShading;
    public GpuGraphResourceId lights;
    public GpuGraphResourceId materialContextSlots;
    public GpuGraphResourceId sceneGeometryDomain;
    public GpuGraphResourceId sceneTlas;

    public SoftShadowSplitResourceInputs(
        in borrow DeferredFrameTargets targets,
        in borrow RayTracingDeferredGraphResourceSnapshot rayTracingResources,
        in borrow RayTracingShadowVisibilityGraphPlanSnapshot rayTracingPlan,
        in borrow RayTracingSceneGraphReads hardwareSceneReads,
        in Span<GpuGraphResourceId> hardwareTransparentScratch,
        in SoftShadowSplitRoute route,
        in Span<GpuGraphResourceId> traceGeometryResources,
        in GpuGraphResourceId worldPosition,
        in GpuGraphResourceId normal,
        in GpuGraphResourceId depth,
        in GpuGraphResourceId shadowVisibility,
        in GpuGraphResourceId currentBindlessSlots,
        in GpuGraphResourceId sceneShading,
        in GpuGraphResourceId lights,
        in GpuGraphResourceId materialContextSlots,
        in GpuGraphResourceId sceneGeometryDomain,
        in GpuGraphResourceId sceneTlas
    ){
        this.targets = targets;
        this.rayTracingResources = rayTracingResources;
        this.rayTracingPlan = rayTracingPlan;
        this.hardwareSceneReads = hardwareSceneReads;
        this.hardwareTransparentScratch = hardwareTransparentScratch;
        this.route = route;
        this.traceGeometryResources = traceGeometryResources;
        this.worldPosition = worldPosition;
        this.normal = normal;
        this.depth = depth;
        this.shadowVisibility = shadowVisibility;
        this.currentBindlessSlots = currentBindlessSlots;
        this.sceneShading = sceneShading;
        this.lights = lights;
        this.materialContextSlots = materialContextSlots;
        this.sceneGeometryDomain = sceneGeometryDomain;
        this.sceneTlas = sceneTlas;
    }
}

class SoftShadowSplitResourceUses{
    public Vector<GpuTaskResourceUse> opaque;
    public Array<GpuTaskResourceUse, s_MaxOpaqueFirstWaveletUses> opaqueFirstWavelet;
    public usize opaqueFirstWaveletCount = 0u;
    public Array<GpuTaskResourceUse, s_MaxOpaqueResolveUses> opaqueResolve;
    public usize opaqueResolveCount = 0u;
    public Vector<GpuTaskResourceUse> transparentTrace;
    public Array<GpuTaskResourceUse, s_MaxTransparentTemporalMergeUses> transparentTemporalMerge;
    public usize transparentTemporalMergeCount = 0u;
    public Array<GpuTaskResourceUse, s_MaxTransparentFirstWaveletUses> transparentFirstWavelet;
    public usize transparentFirstWaveletCount = 0u;
    public Array<GpuTaskResourceUse, s_MaxTransparentFoldUses> transparentFold;
    public usize transparentFoldCount = 0u;
    public b8 graphOwnsTransparentTemporalMergeEntryStates = false;
}

class SoftShadowSplitTaskChainInputs{
    public mut DeferredFrameTargets targets;
    public in DeferredLightingGraphResources deferredLightingResources;
    public in RayTracingDeferredGraphResourceSnapshot rayTracingResources;
    public in RayTracingShadowVisibilityGraphPlanSnapshot rayTracingPlan;
    public in b8 shadowPrepared;
    public mut GpuTimingSubmissionTicket timingTicket;
    public mut Optional<GpuTimingMeasure> asyncTiming;
    public mut Optional<GpuTimingMeasure> shadowVisibilityTiming;
    public mut Optional<GpuTimingMeasure> opaqueResolveTiming;
    public mut Optional<GpuTimingMeasure> transparentResolveTiming;
    public mut b8 opaqueProduced;
    public mut b8 transparentTraceProduced;
    public mut u32 opaqueFrameIndex;
    public SoftShadowSplitRoute route;
    public Span<GpuGraphResourceId> traceGeometryResources;
    public Span<GpuTaskResourceSetUse> traceResourceSetUses;
    public GpuTaskResourceSetUse traceGeometrySetUse;
    public Span<GpuTaskExternalStateSource> stateSources;
    public Span<GpuExternalCompletionId> historyWriterDrainDependencies;
    public GpuGraphResourceId currentBindlessSlots;
    public GpuGraphResourceId sceneShading;
    public GpuGraphResourceId lights;
    public GpuGraphResourceId materialContextSlots;
    public GpuTaskId prefixTask;

    public SoftShadowSplitTaskChainInputs(
        mut DeferredFrameTargets targets,
        in borrow DeferredLightingGraphResources deferredLightingResources,
        in borrow RayTracingDeferredGraphResourceSnapshot rayTracingResources,
        in borrow RayTracingShadowVisibilityGraphPlanSnapshot rayTracingPlan,
        in borrow b8 shadowPrepared,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> asyncTiming,
        mut Optional<GpuTimingMeasure> shadowVisibilityTiming,
        mut Optional<GpuTimingMeasure> opaqueResolveTiming,
        mut Optional<GpuTimingMeasure> transparentResolveTiming,
        mut b8 opaqueProduced,
        mut b8 transparentTraceProduced,
        mut u32 opaqueFrameIndex,
        in SoftShadowSplitRoute route,
        in Span<GpuGraphResourceId> traceGeometryResources,
        in Span<GpuTaskResourceSetUse> traceResourceSetUses,
        in GpuTaskResourceSetUse traceGeometrySetUse,
        in Span<GpuTaskExternalStateSource> stateSources,
        in Span<GpuExternalCompletionId> historyWriterDrainDependencies,
        in GpuGraphResourceId currentBindlessSlots,
        in GpuGraphResourceId sceneShading,
        in GpuGraphResourceId lights,
        in GpuGraphResourceId materialContextSlots,
        in GpuTaskId prefixTask
    ){
        this.targets = targets;
        this.deferredLightingResources = deferredLightingResources;
        this.rayTracingResources = rayTracingResources;
        this.rayTracingPlan = rayTracingPlan;
        this.shadowPrepared = shadowPrepared;
        this.timingTicket = timingTicket;
        this.asyncTiming = asyncTiming;
        this.shadowVisibilityTiming = shadowVisibilityTiming;
        this.opaqueResolveTiming = opaqueResolveTiming;
        this.transparentResolveTiming = transparentResolveTiming;
        this.opaqueProduced = opaqueProduced;
        this.transparentTraceProduced = transparentTraceProduced;
        this.opaqueFrameIndex = opaqueFrameIndex;
        this.route = route;
        this.traceGeometryResources = traceGeometryResources;
        this.traceResourceSetUses = traceResourceSetUses;
        this.traceGeometrySetUse = traceGeometrySetUse;
        this.stateSources = stateSources;
        this.historyWriterDrainDependencies = historyWriterDrainDependencies;
        this.currentBindlessSlots = currentBindlessSlots;
        this.sceneShading = sceneShading;
        this.lights = lights;
        this.materialContextSlots = materialContextSlots;
        this.prefixTask = prefixTask;
    }
}

class ShadowVisibilityResourceInputs{
    public in DeferredFrameTargets deferredTargets;
    public in RayTracingShadowPreparationResourceSnapshot rayTracingShadowResources;
    public in RayTracingDeferredGraphResourceSnapshot rayTracingResources;
    public in RayTracingShadowVisibilityGraphPlanSnapshot rayTracingPlan;
    public in RayTracingSceneGraphReads hardwareSceneReads;
    public GpuGraphResourceId worldPosition;
    public GpuGraphResourceId normal;
    public GpuGraphResourceId depth;
    public GpuGraphResourceId shadowVisibility;
    public GpuGraphResourceId currentBindlessSlots;
    public GpuGraphResourceId sceneShading;
    public GpuGraphResourceId lights;
    public GpuGraphResourceId materialContextSlots;
    public Span<GpuGraphResourceId> traceGeometryResources;
    public b8 traceGeometryStatesGraphOwned;
    public b8 splitSoftTransparentFold;
    public b8 graphOwnsOpaqueTemporalMergeEntryStates;
    public b8 softShadowHistoryReadable;
    public b8 opaqueHistoryFrontIsA;
    public b8 hardwareTransparentTrace;
    public b8 adaptiveCompact;

    public ShadowVisibilityResourceInputs(
        in borrow DeferredFrameTargets deferredTargets,
        in borrow RayTracingShadowPreparationResourceSnapshot rayTracingShadowResources,
        in borrow RayTracingDeferredGraphResourceSnapshot rayTracingResources,
        in borrow RayTracingShadowVisibilityGraphPlanSnapshot rayTracingPlan,
        in borrow RayTracingSceneGraphReads hardwareSceneReads,
        in GpuGraphResourceId worldPosition,
        in GpuGraphResourceId normal,
        in GpuGraphResourceId depth,
        in GpuGraphResourceId shadowVisibility,
        in GpuGraphResourceId currentBindlessSlots,
        in GpuGraphResourceId sceneShading,
        in GpuGraphResourceId lights,
        in GpuGraphResourceId materialContextSlots,
        in Span<GpuGraphResourceId> traceGeometryResources,
        in b8 traceGeometryStatesGraphOwned,
        in b8 splitSoftTransparentFold,
        in b8 graphOwnsOpaqueTemporalMergeEntryStates,
        in b8 softShadowHistoryReadable,
        in b8 opaqueHistoryFrontIsA,
        in b8 hardwareTransparentTrace,
        in b8 adaptiveCompact
    ){
        this.deferredTargets = deferredTargets;
        this.rayTracingShadowResources = rayTracingShadowResources;
        this.rayTracingResources = rayTracingResources;
        this.rayTracingPlan = rayTracingPlan;
        this.hardwareSceneReads = hardwareSceneReads;
        this.worldPosition = worldPosition;
        this.normal = normal;
        this.depth = depth;
        this.shadowVisibility = shadowVisibility;
        this.currentBindlessSlots = currentBindlessSlots;
        this.sceneShading = sceneShading;
        this.lights = lights;
        this.materialContextSlots = materialContextSlots;
        this.traceGeometryResources = traceGeometryResources;
        this.traceGeometryStatesGraphOwned = traceGeometryStatesGraphOwned;
        this.splitSoftTransparentFold = splitSoftTransparentFold;
        this.graphOwnsOpaqueTemporalMergeEntryStates = graphOwnsOpaqueTemporalMergeEntryStates;
        this.softShadowHistoryReadable = softShadowHistoryReadable;
        this.opaqueHistoryFrontIsA = opaqueHistoryFrontIsA;
        this.hardwareTransparentTrace = hardwareTransparentTrace;
        this.adaptiveCompact = adaptiveCompact;
    }
}

class ShadowVisibilityResourcePlan{
    public GpuGraphResourceId sceneGeometryDomain;
    public GpuGraphResourceId sceneTlas;
    public Array<GpuGraphResourceId, s_HwTransparentScratchBufferCount> hardwareTransparentScratch;
    public GpuGraphResourceId adaptiveEdgeCounter;
    public Vector<GpuTaskResourceUse> resourceUses;
}

class SoftShadowSplitResourceUseBuilder : NoCopy{
    private mut GpuTaskGraph m_graph;

    public SoftShadowSplitResourceUseBuilder(mut GpuTaskGraph graph){
        this.m_graph = graph;
    }

    [cpp_unwind]
    public b8 build(in SoftShadowSplitResourceInputs inputs, mut SoftShadowSplitResourceUses uses);
}

class SoftShadowSplitTaskChainBuilder : NoCopy{
    private mut GpuTaskGraph m_graph;
    private mut GraphicsRuntime m_graphics;
    private mut RendererRayTracingSystem m_raytracingSystem;

    public SoftShadowSplitTaskChainBuilder(mut GpuTaskGraph graph, mut GraphicsRuntime graphics, mut RendererRayTracingSystem raytracingSystem){
        this.m_graph = graph;
        this.m_graphics = graphics;
        this.m_raytracingSystem = raytracingSystem;
    }

    [cpp_unwind]
    public b8 declare(in SoftShadowSplitTaskChainInputs inputs, mut SoftShadowSplitResourceUses uses, mut SoftShadowSplitTasks tasks);

    [cpp_unwind]
    private Expected<SoftShadowLightSpaceMaps> declareLightSpaceShadowMaps(in SoftShadowSplitTaskChainInputs inputs, mut SoftShadowSplitResourceUses uses);

    [cpp_unwind]
    private b8 declareOpaqueTasks(
        in SoftShadowSplitTaskChainInputs inputs,
        in SoftShadowSplitResourceUses uses,
        in borrow GpuTaskId shadowTraceDependency,
        in GpuTaskSchedulingHint tailScheduling,
        mut SoftShadowSplitTasks tasks
    );

    [cpp_unwind]
    private b8 declareTransparentTasks(
        in SoftShadowSplitTaskChainInputs inputs,
        in SoftShadowSplitResourceUses uses,
        in GpuTaskSchedulingHint tailScheduling,
        in GpuGraphResourceId csgShadowContext,
        mut SoftShadowSplitTasks tasks
    );
}

class ShadowVisibilityResourcePlanner : NoCopy{
    private mut GpuTaskGraph m_graph;
    private mut RendererRayTracingSystem m_raytracingSystem;

    public ShadowVisibilityResourcePlanner(mut GpuTaskGraph graph, mut RendererRayTracingSystem raytracingSystem){
        this.m_graph = graph;
        this.m_raytracingSystem = raytracingSystem;
    }

    [cpp_unwind]
    public b8 prepare(in ShadowVisibilityResourceInputs inputs, mut ShadowVisibilityResourcePlan result);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


usize ResolveShadowTraceGeometryReserveCount(in usize baseCapacity, in b8 traceGeometryStatesGraphOwned, in usize traceGeometryCount){
    if(traceGeometryStatesGraphOwned)
        return baseCapacity;
    return baseCapacity + traceGeometryCount;
}


