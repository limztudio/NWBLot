#ifndef NWB_GRAPHICS_AVBOIT_OCCUPANCY_PS_AUTHORING_SLANGI
#define NWB_GRAPHICS_AVBOIT_OCCUPANCY_PS_AUTHORING_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// AVBOIT-occupancy authoring: engine owns entry + coverage math; alpha comes from the shared surface hook, so all passes agree. Minimal alpha-only context.


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "material_alpha_context_authoring.slangi"

#include "material_alpha_authoring.slangi"
#include "coverage_splat.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void main(NwbAvboitMaterialAlphaPixelInput input){
    half alpha;
    if(!nwbAvboitLoadAcceptedMaterialAlpha(input, alpha))
        discard;

    nwbAvboitMarkCoverageFromDepth(input.position.z);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#undef g_NwbDeferredBindlessResources


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


