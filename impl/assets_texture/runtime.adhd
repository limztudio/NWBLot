////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_texture/validation.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateTextureRuntimePayload(
    in b8 hasValidVirtualPath,
    in Name virtualPath,
    in u8 payloadFormat,
    in u8 dimension,
    in u32 width,
    in u32 height,
    in u32 depth,
    in u8 alphaMode,
    in u8 alphaConstantUnorm8,
    in Span<TextureMipLevel> mipLevels,
    in Span<u8> payloadBytes
){
    if(!hasValidVirtualPath)
        return false;
    return ValidateTextureAssetPayload(
        virtualPath,
        payloadFormat,
        dimension,
        width,
        height,
        depth,
        alphaMode,
        alphaConstantUnorm8,
        mipLevels,
        payloadBytes
    );
}

Expected<usize> TryResolveSeparateAlphaUastcByteOffset(
    in b8 hasSeparateAlpha,
    in Span<TextureMipLevel> mipLevels,
    in usize totalPayloadByteCount
){
    if(!hasSeparateAlpha)
        return MakeUnexpected(Failure());
    const u64 primaryBytes = ComputeTexturePrimaryPayloadByteCount(mipLevels);
    if(primaryBytes > cast<u64>(totalPayloadByteCount))
        return MakeUnexpected(Failure());
    return cast<usize>(primaryBytes);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


native{
#include <impl/assets_texture/asset.adhd.h>

#include <impl/assets_texture/texture_binary_codec.adhd.h>

#include <core/assets/auto_registration.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_texture_runtime{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static constexpr TStringView s_LoadBinaryContext = NWB_TEXT("Texture::loadBinary");
static constexpr TStringView s_ValidatePayloadContext = NWB_TEXT("Texture::validatePayload");

NWB_DEFINE_ASSET_CODEC_REGISTRAR(s_TextureAssetCodecAutoRegistrar, TextureAssetCodec);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 Texture::validatePayload()const{
    return ValidateTextureRuntimePayload(
        checkVirtualPath(__hidden_texture_runtime::s_ValidatePayloadContext),
        virtualPath(),
        static_cast<u8>(m_payloadFormat),
        static_cast<u8>(m_dimension),
        m_width,
        m_height,
        m_depth,
        static_cast<u8>(m_alphaMode),
        m_alphaConstantUnorm8,
        m_mipLevels,
        m_payloadBytes
    );
}

b8 Texture::loadBinary(const Span<const u8> binary){
    if(!checkVirtualPath(__hidden_texture_runtime::s_LoadBinaryContext))
        return false;

    MipLevelVector mipLevels(m_mipLevels.get_allocator().arena());
    Core::Assets::AssetBytes payloadBytes(m_payloadBytes.get_allocator().arena());
    u32 width = 0u;
    u32 height = 0u;
    u32 depth = 1u;
    u8 dimensionValue = 0u;
    u8 payloadFormatValue = 0u;
    u8 alphaModeValue = 0u;
    u8 alphaConstantUnorm8 = 0u;
    if(!TextureBinaryCodec().deserialize(
        binary,
        width,
        height,
        depth,
        dimensionValue,
        payloadFormatValue,
        alphaModeValue,
        alphaConstantUnorm8,
        mipLevels,
        payloadBytes
    ))
        return false;

    Texture candidate(m_mipLevels.get_allocator().arena(), virtualPath());
    candidate.setPayload(
        width,
        height,
        Move(mipLevels),
        Move(payloadBytes),
        static_cast<TextureDimension::Enum>(dimensionValue),
        depth,
        static_cast<TexturePayloadFormat::Enum>(payloadFormatValue),
        static_cast<TextureAlphaMode::Enum>(alphaModeValue),
        alphaConstantUnorm8
    );
    if(!candidate.validatePayload())
        return false;
    *this = Move(candidate);
    return true;
}

void Texture::setPayload(
    const u32 width,
    const u32 height,
    MipLevelVector&& mipLevels,
    Core::Assets::AssetBytes&& payloadBytes,
    const TextureDimension::Enum dimension,
    const u32 depth,
    const TexturePayloadFormat::Enum payloadFormat,
    const TextureAlphaMode::Enum alphaMode,
    const u8 alphaConstantUnorm8
)noexcept{
    m_width = width;
    m_height = height;
    m_dimension = dimension;
    m_depth = depth;
    m_payloadFormat = payloadFormat;
    m_alphaMode = alphaMode;
    m_alphaConstantUnorm8 = alphaConstantUnorm8;
    m_mipLevels = Move(mipLevels);
    m_payloadBytes = Move(payloadBytes);
}

u64 Texture::primaryPayloadByteCount()const noexcept{
    return ComputeTexturePrimaryPayloadByteCount(m_mipLevels);
}

const u8* Texture::alphaUastcBlocks()const noexcept{
    const auto offset = TryResolveSeparateAlphaUastcByteOffset(
        m_alphaMode == TextureAlphaMode::SeparateUastcLdr4x4,
        m_mipLevels,
        m_payloadBytes.size()
    );
    if(!offset)
        return nullptr;
    return m_payloadBytes.data() + *offset;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
}


