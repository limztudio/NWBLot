#include <impl/ecs_render/kernel/graphics_prefix_timing_ticket.adhd>

#include <impl/ecs_render/kernel/task_timing_telemetry_labels.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class GraphClearTimingRecordState{
    private Optional<mut GraphicsRuntime> m_graphics;
    private Optional<mut Optional<GpuTimingMeasure>> m_timing;
    private Optional<in GraphicsPrefixTimingTicket> m_rebindableTimingTicket;
    private GraphicsPrefixTimingTicket m_timingTicket;
    private GpuTimingScopeDefinition m_scope;

    public GraphClearTimingRecordState(){}
    public GraphClearTimingRecordState(mut GraphicsRuntime graphics, mut Optional<GpuTimingMeasure> timing, in borrow GraphicsPrefixTimingTicket ticket, in GpuTimingScopeDefinition scope){
        this.m_graphics = Optional<mut GraphicsRuntime>(graphics);
        this.m_timing = Optional<mut Optional<GpuTimingMeasure>>(timing);
        this.m_rebindableTimingTicket = Optional<in GraphicsPrefixTimingTicket>(ticket);
        this.m_scope = scope;
    }
    public GraphClearTimingRecordState(mut GraphicsRuntime graphics, mut Optional<GpuTimingMeasure> timing, mut GpuTimingSubmissionTicket ticket, in GpuTimingScopeDefinition scope){
        this.m_graphics = Optional<mut GraphicsRuntime>(graphics);
        this.m_timing = Optional<mut Optional<GpuTimingMeasure>>(timing);
        this.m_timingTicket = Optional<mut GpuTimingSubmissionTicket>(ticket);
        this.m_scope = scope;
    }

    public b8 usesRebindableTiming(in Optional<GpuTimingMeasure> timing)const{
        return this.m_graphics.has_value() && this.m_rebindableTimingTicket.has_value() && this.m_timing.has_value() && SameAddress(this.m_timing.value(), timing);
    }
    private GraphicsPrefixTimingTicket currentTicket()const{
        if(this.m_rebindableTimingTicket.has_value())
            return this.m_rebindableTimingTicket.value();
        return this.m_timingTicket;
    }
    public GpuClearTextureTaskRecordHooks hooks(in b8 before, in b8 after){
        return MakeGpuClearTextureTaskRecordHooks(this, before, after);
    }
    [cpp_unwind]
    public b8 beforeClear(mut CommandList commands, in GpuTaskRecordContext context){
        const auto ticket = this.currentTicket();
        if(!CanBeginGraphClearTimingState(this.m_graphics.has_value(), this.m_timing.has_value(), ticket.has_value(), this.m_timing.has_value() && this.m_timing.value().has_value()))
            return false;
        GpuTimingTicketRecordingScope recording(ticket.value());
        this.m_timing.value().emplace(this.m_graphics.value().gpuTiming(), this.m_scope, this.m_graphics.value().getDevice(), commands);
        return FinishSplitGpuTimingMarker(this.m_timing.value());
    }
    [cpp_unwind]
    public b8 afterClear(mut CommandList commands, in GpuTaskRecordContext context){
        const auto ticket = this.currentTicket();
        if(!CanEndGraphClearTimingState(this.m_timing.has_value(), this.m_timing.has_value() && this.m_timing.value().has_value(), ticket.has_value()))
            return false;
        GpuTimingTicketRecordingScope recording(ticket.value());
        this.m_timing.value().value().finishTiming(commands);
        this.m_timing.value().reset();
        return true;
    }
    [cpp_unwind]
    public void discarded(){
        if(this.m_timing.has_value())
            DiscardGpuTimingMeasure(this.m_timing.value());
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

