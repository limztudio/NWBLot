const f32 s_MeshletConeCullUniformScaleEpsilon = 0.0001f;
const u32 s_MeshDispatchFlagScissorCull = 1u << 0u;
const u32 s_MeshDispatchFlagMeshletFrustumCull = 1u << 1u;
const u32 s_MeshDispatchFlagMeshletConeCull = 1u << 2u;
const u32 s_MeshDispatchFlagCsgMeshletFullyRemovedCull = 1u << 3u;
const u32 s_MeshDispatchFlagMask = 0x0000FFFFu;
const u32 s_MeshDispatchShadingModelShift = 16u;
const u32 s_MeshDispatchShadingModelMask = 0x0000FFFFu;

b8 MeshletConeCullScaleSafe(in f32x4 scale){
    if(!isFinite(scale.x) || !isFinite(scale.y) || !isFinite(scale.z))
        return false;
    if(scale.x <= 0.0f || scale.y <= 0.0f || scale.z <= 0.0f)
        return false;

    f32 minScale = min(scale.x, min(scale.y, scale.z));
    f32 maxScale = max(scale.x, max(scale.y, scale.z));
    f32 tolerance = max(maxScale, 1.0f) * s_MeshletConeCullUniformScaleEpsilon;
    return (maxScale - minScale) <= tolerance;
}

u32 ResolveMeshDispatchFlags(
    in b8 runtimeMesh,
    in b8 dynamicMeshletBoundsFresh,
    in b8 dynamicMeshletConesFresh,
    in MaterialPipelinePass pass,
    in b8 twoSided,
    in b8 meshletConeCullScaleSafe
){
    u32 flags = 0u;
    b8 meshletBoundsFresh = !runtimeMesh || dynamicMeshletBoundsFresh;
    b8 meshletConesFresh = !runtimeMesh || dynamicMeshletConesFresh;
    if(meshletBoundsFresh)
        flags |= s_MeshDispatchFlagMeshletFrustumCull;
    if(meshletConesFresh && pass == MaterialPipelinePass::Opaque && !twoSided && meshletConeCullScaleSafe)
        flags |= s_MeshDispatchFlagMeshletConeCull;
    if(!runtimeMesh)
        flags |= s_MeshDispatchFlagCsgMeshletFullyRemovedCull;
    return flags;
}

u32 ResolveMaterialPassDrawDispatchFlags(
    in b8 runtimeMesh,
    in b8 dynamicMeshletBoundsFresh,
    in b8 dynamicMeshletConesFresh,
    in MaterialPipelinePass pass,
    in b8 twoSided,
    in b8 meshletConeCullScaleSafe,
    in MaterialPipelineCsgMode csgMode,
    in u32 shadingModelId
){
    u32 flags = ResolveMeshDispatchFlags(runtimeMesh, dynamicMeshletBoundsFresh, dynamicMeshletConesFresh, pass, twoSided, meshletConeCullScaleSafe);
    if(csgMode != MaterialPipelineCsgMode::None)
        flags &= ~s_MeshDispatchFlagCsgMeshletFullyRemovedCull;
    flags = (flags & s_MeshDispatchFlagMask) | ((shadingModelId & s_MeshDispatchShadingModelMask) << s_MeshDispatchShadingModelShift);
    return flags;
}

const usize s_ModuleAssignmentPunctuationSize = 3u;
const usize s_ObjectGeometryVertexAttributeCount = 5u;

const Name s_InvalidAvboitPixelShaderDebugName = "ECSRender_InvalidAvboitPixelShader";
const Name s_AvboitOccupancyPsDebugName = "ECSRender_AvboitOccupancyPS";
const Name s_AvboitExtinctionPsDebugName = "ECSRender_AvboitExtinctionPS";
const Name s_AvboitAccumulatePsDebugName = "ECSRender_AvboitAccumulatePS";
const Name s_AvboitRefractionCapturePsDebugName = "ECSRender_AvboitRefractionCapturePS";
const Name s_InvalidPassPixelShaderDebugName = "ECSRender_InvalidPassPixelShader";
const Name s_RendererPsDebugName = "ECSRender_RendererPS";
const Name s_CsgReceiverSurfacePsDebugName = "ECSRender_CsgReceiverSurfacePS";
const Name s_RendererMeshDebugName = "ECSRender_RendererMesh";
const Name s_RendererCsDebugName = "ECSRender_RendererCS";
const Name s_ObjectGeometryDecodeDebugName = "ECSRender_ObjectGeometryDecode";
const Name s_ObjectGeometryVsDebugName = "ECSRender_ObjectGeometryVS";

const Name s_VertexAttributePositionName = "POSITION";
const Name s_VertexAttributeNormalName = "NORMAL";
const Name s_VertexAttributeTangentName = "TANGENT";
const Name s_VertexAttributeTexCoordName = "TEXCOORD";
const Name s_VertexAttributeColorName = "COLOR";

Name ResolveAvboitPixelShaderDebugName(in MaterialPipelinePass pass){
    switch(pass){
    case MaterialPipelinePass::AvboitOccupancy:
        return s_AvboitOccupancyPsDebugName;
    case MaterialPipelinePass::AvboitExtinction:
        return s_AvboitExtinctionPsDebugName;
    case MaterialPipelinePass::AvboitAccumulate:
        return s_AvboitAccumulatePsDebugName;
    case MaterialPipelinePass::AvboitRefractionCapture:
        return s_AvboitRefractionCapturePsDebugName;
    default:
        return s_InvalidAvboitPixelShaderDebugName;
    }
}


