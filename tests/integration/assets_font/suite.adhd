NWB_ADHD_GTEST(AssetsFont, SfntTableViewsCheckBoundsWithoutCopyingOrScanningOtherRecords, VerifyAssetsFont_SfntTableViewsCheckBoundsWithoutCopyingOrScanningOtherRecords)
NWB_ADHD_GTEST(AssetsFont, SfntTableBoundsHandleOverflowAndEmptyEndSpansWithoutAddingFontPolicy, VerifyAssetsFont_SfntTableBoundsHandleOverflowAndEmptyEndSpansWithoutAddingFontPolicy)
NWB_ADHD_GTEST(AssetsFont, PreparedAtlasPixelsAreExcludedFromCookedFontsAndRejectedByRuntimeImport, VerifyAssetsFont_PreparedAtlasPixelsAreExcludedFromCookedFontsAndRejectedByRuntimeImport)
NWB_ADHD_GTEST(AssetsFont, MalformedBinaryPreservesThePreviouslyLoadedFont, VerifyAssetsFont_MalformedBinaryPreservesThePreviouslyLoadedFont)
NWB_ADHD_GTEST(AssetsFont, OversizedCountIsRejectedBeforeSourceAllocation, VerifyAssetsFont_OversizedCountIsRejectedBeforeSourceAllocation)
NWB_ADHD_GTEST(AssetsFont, RejectsCollectionsCompressedFontsAndVariableTables, VerifyAssetsFont_RejectsCollectionsCompressedFontsAndVariableTables)
NWB_ADHD_GTEST(AssetsFont, RejectsMalformedDirectoriesAndNativeFaceMetrics, VerifyAssetsFont_RejectsMalformedDirectoriesAndNativeFaceMetrics)
NWB_ADHD_GTEST(AssetsFont, NativeFaceFailurePreservesErrorCodeAndReclaimsValidationAllocations, VerifyAssetsFont_NativeFaceFailurePreservesErrorCodeAndReclaimsValidationAllocations)
NWB_ADHD_GTEST(PreparedFontSource, ImageCorruptionRejectsFullReadWhileFontOnlySkipsCompactPlanes, VerifyPreparedFontSource_ImageCorruptionRejectsFullReadWhileFontOnlySkipsCompactPlanes)
NWB_ADHD_GTEST(PreparedFontSource, SfntByteAndDigestCorruptionRejectBothReadModes, VerifyPreparedFontSource_SfntByteAndDigestCorruptionRejectBothReadModes)
NWB_ADHD_GTEST(PreparedFontSource, MalformedDirectoryCountsAndOverflowRejectBeforePayloadAllocation, VerifyPreparedFontSource_MalformedDirectoryCountsAndOverflowRejectBeforePayloadAllocation)
NWB_ADHD_GTEST(PreparedFontSource, TruncatedSectionsAndTrailingBytesRejectBothReadModes, VerifyPreparedFontSource_TruncatedSectionsAndTrailingBytesRejectBothReadModes)
NWB_ADHD_GTEST(PreparedFontSource, InvalidSerializationInputsRejectWithoutAllocating, VerifyPreparedFontSource_InvalidSerializationInputsRejectWithoutAllocating)


