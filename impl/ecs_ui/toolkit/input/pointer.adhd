#include "commands.adhd"
#include <impl/ecs_ui/toolkit/paint_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> PointerPhase{
    Move,
    Press,
    Release,
    Cancel,
    Leave,
    Scroll,
}

enum<u8> PointerIntent{
    Activate,
    ContextMenu,
}

enum<u8> PointerCursor{
    Default,
    TextInput,
    Hand,
    Crosshair,
    ResizeEW,
    ResizeNS,
    ResizeNWSE,
    ResizeNESW,
    Move,
    NotAllowed,
    Wait,
    Progress,
    Grab,
    Grabbing,
    Hidden,
}

class PointerInput{
    public InputSource source;
    public PointerPhase phase = PointerPhase::Move;
    public PointerIntent intent = PointerIntent::Activate;
    public b8 extend = false;
    public b8 toggle = false;
    public b8 hoverCapable = false;
    public Point position;
    public f64 scrollX = 0.0;
    public f64 scrollY = 0.0;
    public u64 timestampMs = 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

