void VerifyEditCaretRangeFixture_TrailingLfDoesNotAddASecondCapOnTheEmptyTerminalLine(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("ab\n"));
    self.expectRange(MakeUiEditCaretRange(0u, 3u), 0u, MakeUiControlCaretRect(0.0f, 0.0f, 21.0f, 12.0f));
