void VerifyUiScrollbarLayoutTests_ExtremeFiniteStoredOffsetsClampBeforeThumbArithmetic(){
    const Rect bounds = Rect(10.0f, 20.0f, 100.0f, 80.0f);
    const auto placementResult = CalculateScrollViewportPlacement(bounds, bounds, Insets(), Point(399.0f, 200.0f), 1.0f, Point(f32.max, f32.max), 12.0f, 16.0f);
    ASSERT_TRUE(placementResult.has_value());
    const ScrollViewportPlacement placement = placementResult.value();
    EXPECT_DOUBLE_EQ(placement.horizontal.offset, 312.0);
    EXPECT_DOUBLE_EQ(placement.vertical.offset, 132.0);
    // Lanes are horizontal thumb end, horizontal track end, vertical thumb end, vertical track end.
    const VectorSingle starts = VectorSingle(placement.horizontal.thumb.x, placement.horizontal.track.x, placement.vertical.thumb.y, placement.vertical.track.y);
    const VectorSingle ends = starts + VectorSingle(placement.horizontal.thumb.width, placement.horizontal.track.width, placement.vertical.thumb.height, placement.vertical.track.height);
    EXPECT_FLOAT_EQ(ends.x, ends.y);
    EXPECT_FLOAT_EQ(ends.z, ends.w);
}

void VerifyUiScrollbarLayoutTests_OverscrollUpdatesClampBothThumbsAndRestoreExactStartGeometry(){
    const Rect bounds = Rect(10.0f, 20.0f, 112.0f, 112.0f);
    const auto placementResult = CalculateScrollViewportPlacement(bounds, bounds, Insets(), Point(399.0f, 400.0f), 1.0f, Point(), 12.0f, 0.0f);
    ASSERT_TRUE(placementResult.has_value());
    ScrollViewportPlacement placement = placementResult.value();
    const ScrollViewportPlacement initial = placement;
    ASSERT_TRUE(TryUpdateScrollViewportOffsets(Point(1000.0f, 1000.0f), placement));
    ExpectUiScrollbarReservedGeometry(placement, initial);
    ExpectUiRect(placement.horizontal.thumb, Rect(85.0f, 120.0f, 25.0f, 12.0f));
    ExpectUiRect(placement.vertical.thumb, Rect(110.0f, 95.0f, 12.0f, 25.0f));
    ASSERT_TRUE(TryUpdateScrollViewportOffsets(Point(), placement));
    ExpectUiScrollbarPlacement(placement, initial);
}

void VerifyUiScrollbarLayoutTests_InvalidCalculationInputsRejectPlacement(){
    const Rect bounds = Rect(10.0f, 20.0f, 112.0f, 112.0f);
    const Insets padding = MakeUiRadioScrollInsets(1.0f, 2.0f, 3.0f, 4.0f);
    const f32 nan = bit_cast<f32>(s_UiRadioScrollQuietNaNF32Bits);
    const f32 infinity = bit_cast<f32>(s_UiRadioScrollPosInfF32Bits);
    ExpectUiScrollbarViewportRejected(Rect(nan, 20.0f, 112.0f, 112.0f), bounds, padding, Point(399.0f, 400.0f), 1.0f, Point(), 12.0f, 16.0f);
    ExpectUiScrollbarViewportRejected(Rect(10.0f, 20.0f, -1.0f, 112.0f), bounds, padding, Point(399.0f, 400.0f), 1.0f, Point(), 12.0f, 16.0f);
    ExpectUiScrollbarViewportRejected(Rect(f32.max, 0.0f, f32.max, 112.0f), bounds, padding, Point(399.0f, 400.0f), 1.0f, Point(), 12.0f, 16.0f);
    ExpectUiScrollbarViewportRejected(bounds, Rect(10.0f, infinity, 112.0f, 112.0f), padding, Point(399.0f, 400.0f), 1.0f, Point(), 12.0f, 16.0f);
    ExpectUiScrollbarViewportRejected(bounds, Rect(10.0f, 20.0f, 112.0f, -1.0f), padding, Point(399.0f, 400.0f), 1.0f, Point(), 12.0f, 16.0f);
    ExpectUiScrollbarViewportRejected(bounds, bounds, MakeUiRadioScrollInsets(-1.0f, 2.0f, 3.0f, 4.0f), Point(399.0f, 400.0f), 1.0f, Point(), 12.0f, 16.0f);
    ExpectUiScrollbarViewportRejected(bounds, bounds, MakeUiRadioScrollInsets(1.0f, 2.0f, 3.0f, nan), Point(399.0f, 400.0f), 1.0f, Point(), 12.0f, 16.0f);
    ExpectUiScrollbarViewportRejected(bounds, bounds, padding, Point(-1.0f, 400.0f), 1.0f, Point(), 12.0f, 16.0f);
    ExpectUiScrollbarViewportRejected(bounds, bounds, padding, Point(399.0f, nan), 1.0f, Point(), 12.0f, 16.0f);
    ExpectUiScrollbarViewportRejected(bounds, bounds, padding, Point(infinity, 400.0f), 1.0f, Point(), 12.0f, 16.0f);
    ExpectUiScrollbarViewportRejected(bounds, bounds, padding, Point(399.0f, 400.0f), 0.0f, Point(), 12.0f, 16.0f);
    ExpectUiScrollbarViewportRejected(bounds, bounds, padding, Point(399.0f, 400.0f), infinity, Point(), 12.0f, 16.0f);
    ExpectUiScrollbarViewportRejected(bounds, bounds, padding, Point(399.0f, 400.0f), nan, Point(), 12.0f, 16.0f);
    ExpectUiScrollbarViewportRejected(bounds, bounds, padding, Point(399.0f, 400.0f), 1.0f, Point(-1.0f, 0.0f), 12.0f, 16.0f);
    ExpectUiScrollbarViewportRejected(bounds, bounds, padding, Point(399.0f, 400.0f), 1.0f, Point(0.0f, infinity), 12.0f, 16.0f);
    ExpectUiScrollbarViewportRejected(bounds, bounds, padding, Point(399.0f, 400.0f), 1.0f, Point(nan, 0.0f), 12.0f, 16.0f);
    ExpectUiScrollbarViewportRejected(bounds, bounds, padding, Point(399.0f, 400.0f), 1.0f, Point(), -1.0f, 16.0f);
    ExpectUiScrollbarViewportRejected(bounds, bounds, padding, Point(399.0f, 400.0f), 1.0f, Point(), infinity, 16.0f);
    ExpectUiScrollbarViewportRejected(bounds, bounds, padding, Point(399.0f, 400.0f), 1.0f, Point(), 12.0f, -1.0f);
    ExpectUiScrollbarViewportRejected(bounds, bounds, padding, Point(399.0f, 400.0f), 1.0f, Point(), 12.0f, nan);
}

void VerifyUiScrollbarLayoutTests_UnrepresentableFinalViewportRejectsExtremeContent(){
    const Rect bounds = Rect(0.0f, 0.0f, 112.0f, 112.0f);
    EXPECT_FALSE(CalculateScrollViewportPlacement(bounds, bounds, Insets(), Point(f32.max, f32.max), f32.max, Point(f32.max, f32.max), 12.0f, 16.0f).has_value());
    EXPECT_FALSE(CalculateScrollViewportPlacement(bounds, bounds, Insets(), Point(1.0e30f, 1.0e30f), 1.0f, Point(), 0.0f, 16.0f).has_value());
}

void VerifyUiScrollbarLayoutTests_UnrepresentableBarReservationRejectsCalculation(){
    const Rect bounds = Rect(0.0f, 0.0f, 112.0f, 112.0f);
    EXPECT_FALSE(CalculateScrollViewportPlacement(bounds, bounds, Insets(), Point(399.0f, 400.0f), 1.0f, Point(), 1.0e-30f, 0.0f).has_value());
}

void VerifyUiScrollbarLayoutTests_InvalidOffsetRequestsPreserveBothAxesAndGeometry(){
    const Rect bounds = Rect(0.0f, 0.0f, 112.0f, 112.0f);
    const auto previousResult = CalculateScrollViewportPlacement(bounds, bounds, Insets(), Point(399.0f, 400.0f), 1.0f, Point(40.0f, 50.0f), 12.0f, 16.0f);
    ASSERT_TRUE(previousResult.has_value());
    const ScrollViewportPlacement previous = previousResult.value();
    Array<Point, 4u> inputs;
    inputs[0u] = Point(-1.0f, 0.0f);
    inputs[1u] = Point(0.0f, -1.0f);
    inputs[2u] = Point(bit_cast<f32>(s_UiRadioScrollQuietNaNF32Bits), 0.0f);
    inputs[3u] = Point(0.0f, bit_cast<f32>(s_UiRadioScrollPosInfF32Bits));
    for(in Point input : inputs){
        ScrollViewportPlacement placement = previous;
        EXPECT_FALSE(TryUpdateScrollViewportOffsets(input, placement));
        ExpectUiScrollbarPlacement(placement, previous);
    }
}

void VerifyUiScrollbarLayoutTests_InvalidOwnedProjectionRejectsOffsetUpdateAtomically(){
    const Rect bounds = Rect(0.0f, 0.0f, 112.0f, 112.0f);
    const auto previousResult = CalculateScrollViewportPlacement(bounds, bounds, Insets(), Point(399.0f, 400.0f), 1.0f, Point(), 12.0f, 16.0f);
    ASSERT_TRUE(previousResult.has_value());
    const ScrollViewportPlacement previous = previousResult.value();
    ScrollViewportPlacement placement = previous;
    placement.horizontal.maximum = -1.0;
    ExpectUiScrollbarOffsetUpdateRejected(placement);
    placement = previous;
    placement.vertical.offset = placement.vertical.maximum + 1.0;
    ExpectUiScrollbarOffsetUpdateRejected(placement);
    placement = previous;
    placement.horizontal.viewportExtent = placement.horizontal.viewportExtent + 1.0;
    ExpectUiScrollbarOffsetUpdateRejected(placement);
    placement = previous;
    placement.vertical.thumb.height = placement.vertical.track.height + 1.0f;
    ExpectUiScrollbarOffsetUpdateRejected(placement);
    placement = previous;
    placement.horizontal.visible = false;
    ExpectUiScrollbarOffsetUpdateRejected(placement);
    placement = previous;
    placement.corner.width = -1.0f;
    ExpectUiScrollbarOffsetUpdateRejected(placement);
    placement = previous;
    placement.contentClip.y = bit_cast<f32>(s_UiRadioScrollPosInfF32Bits);
    ExpectUiScrollbarOffsetUpdateRejected(placement);
    placement = previous;
    placement.vertical.contentExtent = bit_cast<f64>(s_UiRadioScrollPosInfF64Bits);
    ExpectUiScrollbarOffsetUpdateRejected(placement);
}


