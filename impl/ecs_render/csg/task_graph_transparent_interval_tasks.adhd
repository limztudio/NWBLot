////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/csg/transparent_interval_payloads.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 EvaluateTransparentCsgIntervalReadiness(
    in b8 csgFrameBuffersUploaded,
    in b8 hasFramebuffer,
    in b8 hasReceiverSurfaceDrawItems,
    in b8 hasCsgFrameWork,
    in b8 drawBuffersReady,
    in b8 csgResourcesReady,
    in b8 receiverSurfaceDrawResourcesReady
){
    return csgFrameBuffersUploaded
        && hasFramebuffer
        && hasReceiverSurfaceDrawItems
        && hasCsgFrameWork
        && drawBuffersReady
        && csgResourcesReady
        && receiverSurfaceDrawResourcesReady
    ;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 TransparentCsgIntervalRecordInputs::record(mut CommandList commandList, in GpuTaskRecordContext context)const{
    if(!this.transparentCsgSnapshot.captured)
        return false;
    GpuTimingTicketRecordingScope timingRecording(this.timingTicket);
    if(!this.transparentCsgIntervalsTiming.has_value()){
        commandList.endRenderPass();
        return true;
    }

    const CsgFrameGpuDataView frame = this.transparentCsgSnapshot.csgFrameDataView();
    const b8 frameReady = this.frameBindings.frameReady(this.transparentCsgSnapshot.instanceCount, this.transparentCsgSnapshot.materialTypedByteCount);
    const b8 csgReady = this.csgResources.frameReady(frame);
    const b8 hasReceiverDraws = this.transparentCsgSnapshot.hasReceiverSurfaceDrawItems;
    const b8 drawReady = this.transparentCsgSnapshot.receiverSurfaceDrawResourcesReady;
    if(!EvaluateTransparentCsgIntervalReadiness(this.csgFrameBuffersUploaded, this.targets.framebuffer.valid(), hasReceiverDraws, frame.hasWork(), frameReady, csgReady, drawReady))
        DiscardGpuTimingMeasure(this.transparentCsgIntervalsTiming);
    else if(this.m_pass == TransparentCsgIntervalPass::ReceiverSpan)
        this.csgSystem.dispatchCsgReceiverSpanBuild(commandList, this.targets, frame, this.csgResources);
    else{
        this.csgSystem.dispatchCsgIntervalCombine(commandList, this.targets, frame, this.csgResources);
        this.transparentCsgIntervalsTiming.value().finishTiming(commandList);
        this.transparentCsgIntervalsTiming.reset();
    }
    commandList.endRenderPass();
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

