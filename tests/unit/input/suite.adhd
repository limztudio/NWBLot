#include <core/input/module.h>

#include <global/optional.h>

#include <new>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace InputDispatcherTestsImpl{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace Core;

class FocusHandler final : public IInputEventHandler{
public:
    explicit FocusHandler(InputDispatcher& dispatcher)noexcept
        : m_dispatcher(dispatcher)
    {}


public:
    virtual void windowFocusUpdate(b8 focused)override;
    virtual KeyboardInputResult keyboardUpdate(i32, i32, i32 action, i32)override;
    virtual b8 mouseButtonUpdate(i32, i32 action, i32)noexcept override;

    void setRemoveTarget(IInputEventHandler& target)noexcept{ m_removeTarget = &target; }
    void setAddTarget(IInputEventHandler& target)noexcept{ m_addTarget = &target; }


public:
    InputDispatcher& m_dispatcher;
    Array<b8, 8u> m_focusValues{};
    usize m_focusCount = 0u;
    usize m_keyPresses = 0u;
    usize m_keyReleases = 0u;
    usize m_buttonPresses = 0u;
    usize m_buttonReleases = 0u;
    mutable usize m_textPolicyQueries = 0u;
    IInputEventHandler* m_removeTarget = nullptr;
    IInputEventHandler* m_addTarget = nullptr;
    b8 m_removeSelf = false;
    b8 m_loseFocusOnPress = false;
    b8 m_regainFocusOnPress = false;
    b8 m_removeSelfOnPress = false;
    b8 m_blockText = false;
    b8 m_consumeKeys = false;
    b8 m_consumeButtons = false;
};

class SelfDestroyingKeyHandler final : public IInputEventHandler{
public:
    SelfDestroyingKeyHandler(InputDispatcher& dispatcher, Optional<SelfDestroyingKeyHandler>& owner)noexcept
        : m_dispatcher(dispatcher)
        , m_owner(owner)
    {}


public:
    virtual KeyboardInputResult keyboardUpdate(i32, i32, i32, i32)override;


private:
    InputDispatcher& m_dispatcher;
    Optional<SelfDestroyingKeyHandler>& m_owner;
};

class DestroyOtherKeyHandler final : public IInputEventHandler{
public:
    DestroyOtherKeyHandler(InputDispatcher& dispatcher, Optional<FocusHandler>& victim)noexcept
        : m_dispatcher(dispatcher)
        , m_victim(victim)
    {}


public:
    virtual KeyboardInputResult keyboardUpdate(i32, i32, i32, i32)override;


private:
    InputDispatcher& m_dispatcher;
    Optional<FocusHandler>& m_victim;
};

class ReplacingKeyHandler final : public IInputEventHandler{
public:
    ReplacingKeyHandler(InputDispatcher& dispatcher, ReplacingKeyHandler*& slot, usize& calls, const b8 replace)noexcept
        : m_dispatcher(dispatcher)
        , m_slot(slot)
        , m_calls(calls)
        , m_replace(replace)
    {}


public:
    virtual KeyboardInputResult keyboardUpdate(i32, i32, i32, i32)override;


private:
    InputDispatcher& m_dispatcher;
    ReplacingKeyHandler*& m_slot;
    usize& m_calls;
    b8 m_replace;
};

class ThrowingHandler final : public IInputEventHandler{
public:
    static constexpr u32 s_Failure = 0xD15A7C4u;


public:
    ThrowingHandler(InputDispatcher& dispatcher, const b8 nestedDispatch)noexcept
        : m_dispatcher(dispatcher)
        , m_nestedDispatch(nestedDispatch)
    {}


public:
    virtual KeyboardInputResult keyboardUpdate(i32, i32, i32, i32)override;
    virtual void pointerLeave()override;


public:
    InputDispatcher& m_dispatcher;
    usize m_keyUpdates = 0u;
    const b8 m_nestedDispatch;
};

class PointerLifecycleHandler final : public IInputEventHandler{
public:
    explicit PointerLifecycleHandler(InputDispatcher& dispatcher)noexcept
        : m_dispatcher(dispatcher)
    {}


public:
    virtual void windowFocusUpdate(b8)noexcept override{ ++m_focusChanges; }
    virtual void pointerLeave()override;
    virtual void pointerCaptureLost()override;
    virtual KeyboardInputResult keyboardUpdate(i32, i32, i32 action, i32)noexcept override;

    void setAddOnLeave(IInputEventHandler& target)noexcept{ m_addOnLeave = &target; }
    void setRemoveOnCaptureLoss(IInputEventHandler& target)noexcept{ m_removeOnCaptureLoss = &target; }


public:
    InputDispatcher& m_dispatcher;
    IInputEventHandler* m_addOnLeave = nullptr;
    IInputEventHandler* m_removeOnCaptureLoss = nullptr;
    usize m_leaves = 0u;
    usize m_captureLosses = 0u;
    usize m_focusChanges = 0u;
    usize m_keyPresses = 0u;
    usize m_keyReleases = 0u;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace Tests::Input{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using InputDispatcher = Core::InputDispatcher;
namespace Key = Core::Key;
namespace InputAction = Core::InputAction;
namespace MouseButton = Core::MouseButton;
using FocusHandler = InputDispatcherTestsImpl::FocusHandler;
using SelfDestroyingKeyHandler = InputDispatcherTestsImpl::SelfDestroyingKeyHandler;
using DestroyOtherKeyHandler = InputDispatcherTestsImpl::DestroyOtherKeyHandler;
using ReplacingKeyHandler = InputDispatcherTestsImpl::ReplacingKeyHandler;
using ThrowingHandler = InputDispatcherTestsImpl::ThrowingHandler;
using PointerLifecycleHandler = InputDispatcherTestsImpl::PointerLifecycleHandler;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyInputDispatcher_ReplacementAtRemovedHandlerAddressStartsOnNextDispatch(){
    InputDispatcher dispatcher = InputDispatcher();
    native(mut dispatcher){
        alignas(ReplacingKeyHandler) u8 storage[sizeof(ReplacingKeyHandler)];
        ReplacingKeyHandler* handler = nullptr;
        usize calls = 0u;
        handler = new (storage) ReplacingKeyHandler(dispatcher, handler, calls, true);
        dispatcher.addHandlerToBack(*handler);
        dispatcher.keyboardUpdate(Key::A, 30, InputAction::Press, 0);
        EXPECT_EQ(calls, 1u);
        EXPECT_TRUE(dispatcher.keyboardTextBlocked(30));
        dispatcher.keyboardUpdate(Key::A, 30, InputAction::Press, 0);
        EXPECT_EQ(calls, 2u);
        EXPECT_FALSE(dispatcher.keyboardTextBlocked(30));
        dispatcher.removeHandler(*handler);
        handler->~ReplacingKeyHandler();
    }
}

void VerifyInputDispatcher_KeyHandlerCanRemoveAndDestroyItselfBeforeReturningPolicy(){
    InputDispatcher dispatcher = InputDispatcher();
    native(mut dispatcher){
        Optional<SelfDestroyingKeyHandler> owner;
        owner.emplace(dispatcher, owner);
        dispatcher.addHandlerToBack(*owner);
        dispatcher.keyboardUpdate(Key::A, 30, InputAction::Press, 0);
        EXPECT_FALSE(owner);
        EXPECT_TRUE(dispatcher.keyboardTextBlocked(30));
        dispatcher.keyboardUpdate(Key::A, 30, InputAction::Press, 0);
        EXPECT_FALSE(dispatcher.keyboardTextBlocked(30));
    }
}

void VerifyInputDispatcher_RemovedHandlerCanBeDestroyedBeforeItsTurn(){
    InputDispatcher dispatcher = InputDispatcher();
    native(mut dispatcher){
        Optional<FocusHandler> victim;
        victim.emplace(dispatcher);
        DestroyOtherKeyHandler killer(dispatcher, victim);
        dispatcher.addHandlerToFront(*victim);
        dispatcher.addHandlerToBack(killer);
        dispatcher.keyboardUpdate(Key::A, 30, InputAction::Press, 0);
        EXPECT_FALSE(victim);
        dispatcher.keyboardUpdate(Key::A, 30, InputAction::Press, 0);
        EXPECT_FALSE(dispatcher.keyboardTextBlocked(30));
    }
}

void VerifyFocusTransitionHistory(in FocusHandler handler){
    ASSERT_EQ(handler.m_focusCount, 2u);
    EXPECT_FALSE(handler.m_focusValues[0u]);
    EXPECT_TRUE(handler.m_focusValues[1u]);
}

void VerifyInputDispatcher_WindowFocusTransitionsReachEveryHandlerAndDeduplicate(){
    InputDispatcher dispatcher = InputDispatcher();
    FocusHandler scene(dispatcher);
    FocusHandler legacyUi(dispatcher);
    FocusHandler customUi(dispatcher);
    customUi.m_consumeKeys = true;
    dispatcher.addHandlerToFront(scene);
    dispatcher.addHandlerToBack(legacyUi);
    dispatcher.addHandlerToBack(customUi);

    dispatcher.windowFocusUpdate(false);
    EXPECT_FALSE(dispatcher.windowFocused());
    dispatcher.windowFocusUpdate(false);
    dispatcher.windowFocusUpdate(true);
    dispatcher.windowFocusUpdate(true);
    EXPECT_TRUE(dispatcher.windowFocused());
    VerifyFocusTransitionHistory(scene);
    VerifyFocusTransitionHistory(legacyUi);
    VerifyFocusTransitionHistory(customUi);
}

void VerifyInputDispatcher_FocusBroadcastSkipsPendingRemovalWithoutSkippingOtherOwners(){
    InputDispatcher dispatcher = InputDispatcher();
    FocusHandler scene(dispatcher);
    FocusHandler removed(dispatcher);
    FocusHandler router(dispatcher);
    dispatcher.addHandlerToFront(scene);
    dispatcher.addHandlerToBack(removed);
    dispatcher.addHandlerToBack(router);
    router.setRemoveTarget(removed);

    dispatcher.windowFocusUpdate(false);
    EXPECT_EQ(router.m_focusCount, 1u);
    EXPECT_EQ(scene.m_focusCount, 1u);
    EXPECT_EQ(removed.m_focusCount, 0u);
    dispatcher.windowFocusUpdate(true);
    EXPECT_EQ(router.m_focusCount, 2u);
    EXPECT_EQ(scene.m_focusCount, 2u);
    EXPECT_EQ(removed.m_focusCount, 0u);
}

void VerifyInputDispatcher_HandlerAddedDuringFocusBroadcastWaitsUntilNextTransition(){
    InputDispatcher dispatcher = InputDispatcher();
    FocusHandler existing(dispatcher);
    FocusHandler added(dispatcher);
    dispatcher.addHandlerToBack(existing);
    existing.setAddTarget(added);

    dispatcher.windowFocusUpdate(false);
    EXPECT_EQ(existing.m_focusCount, 1u);
    EXPECT_EQ(added.m_focusCount, 0u);
    dispatcher.windowFocusUpdate(true);
    EXPECT_EQ(existing.m_focusCount, 2u);
    ASSERT_EQ(added.m_focusCount, 1u);
    EXPECT_TRUE(added.m_focusValues[0u]);
}

void VerifyInputDispatcher_HandlerMayRemoveItselfDuringFocusBroadcast(){
    InputDispatcher dispatcher = InputDispatcher();
    FocusHandler scene(dispatcher);
    FocusHandler transient(dispatcher);
    dispatcher.addHandlerToFront(scene);
    dispatcher.addHandlerToBack(transient);
    transient.m_removeSelf = true;

    dispatcher.windowFocusUpdate(false);
    dispatcher.windowFocusUpdate(true);
    EXPECT_EQ(scene.m_focusCount, 2u);
    EXPECT_EQ(transient.m_focusCount, 1u);
}

void VerifyInputDispatcher_NestedFocusBroadcastDefersHandlerMutationUntilOuterDispatchEnds(){
    InputDispatcher dispatcher = InputDispatcher();
    FocusHandler scene(dispatcher);
    FocusHandler router(dispatcher);
    dispatcher.addHandlerToFront(scene);
    dispatcher.addHandlerToBack(router);
    router.m_loseFocusOnPress = true;
    router.setRemoveTarget(scene);

    dispatcher.keyboardUpdate(Key::W, 0, InputAction::Press, 0);
    EXPECT_FALSE(dispatcher.windowFocused());
    EXPECT_EQ(router.m_keyPresses, 1u);
    EXPECT_EQ(router.m_focusCount, 1u);
    EXPECT_EQ(scene.m_keyPresses, 0u);
    EXPECT_EQ(scene.m_focusCount, 0u);
    dispatcher.keyboardUpdate(Key::W, 0, InputAction::Release, 0);
    EXPECT_EQ(router.m_keyReleases, 1u);
    EXPECT_EQ(scene.m_keyReleases, 0u);
}

void VerifyInputDispatcher_KeyboardReleaseClearsSceneEvenWhenUiConsumesAfterPress(){
    InputDispatcher dispatcher = InputDispatcher();
    FocusHandler scene(dispatcher);
    FocusHandler ui(dispatcher);
    dispatcher.addHandlerToFront(scene);
    dispatcher.addHandlerToBack(ui);

    dispatcher.keyboardUpdate(Key::W, 0, InputAction::Press, 0);
    ASSERT_EQ(scene.m_keyPresses, 1u);
    ui.m_consumeKeys = true;
    dispatcher.keyboardUpdate(Key::W, 0, InputAction::Release, 0);
    EXPECT_EQ(ui.m_keyReleases, 1u);
    EXPECT_EQ(scene.m_keyReleases, 1u);
    dispatcher.keyboardUpdate(Key::W, 0, InputAction::Repeat, 0);
    EXPECT_EQ(ui.m_keyPresses, 2u);
    EXPECT_EQ(scene.m_keyPresses, 1u);
}

void VerifyInputDispatcher_KeyboardTextPolicyComesOnlyFromTheFirstConsumingHandler(){
    InputDispatcher dispatcher = InputDispatcher();
    FocusHandler lower(dispatcher);
    FocusHandler higher(dispatcher);
    lower.m_consumeKeys = true;
    lower.m_blockText = true;
    higher.m_consumeKeys = true;
    dispatcher.addHandlerToFront(lower);
    dispatcher.addHandlerToBack(higher);
    dispatcher.keyboardUpdate(Key::A, 30, InputAction::Press, 0);
    EXPECT_FALSE(dispatcher.keyboardTextBlocked(30));
    EXPECT_EQ(higher.m_textPolicyQueries, 1u);
    EXPECT_EQ(lower.m_textPolicyQueries, 0u);

    higher.m_consumeKeys = false;
    higher.m_blockText = true;
    lower.m_blockText = false;
    dispatcher.keyboardUpdate(Key::B, 48, InputAction::Press, 0);
    EXPECT_FALSE(dispatcher.keyboardTextBlocked(48));
    EXPECT_EQ(higher.m_textPolicyQueries, 1u);
    EXPECT_EQ(lower.m_textPolicyQueries, 1u);
    lower.m_blockText = true;
    dispatcher.keyboardUpdate(Key::B, 48, InputAction::Repeat, 0);
    EXPECT_TRUE(dispatcher.keyboardTextBlocked(48));
    lower.m_consumeKeys = false;
    dispatcher.keyboardUpdate(Key::B, 48, InputAction::Repeat, 0);
    EXPECT_FALSE(dispatcher.keyboardTextBlocked(48));
    EXPECT_FALSE(dispatcher.keyboardTextBlocked());
    EXPECT_EQ(higher.m_textPolicyQueries, 1u);
    EXPECT_EQ(lower.m_textPolicyQueries, 2u);
}

void VerifyInputDispatcher_KeyboardTextScancodesRetainIndependentQueuedPoliciesAcrossReleases(){
    InputDispatcher dispatcher = InputDispatcher();
    FocusHandler handler(dispatcher);
    handler.m_consumeKeys = true;
    handler.m_blockText = true;
    dispatcher.addHandlerToBack(handler);
    dispatcher.keyboardUpdate(Key::A, 30, InputAction::Press, 0);
    handler.m_blockText = false;
    dispatcher.keyboardUpdate(Key::B, 48, InputAction::Press, 0);
    EXPECT_TRUE(dispatcher.keyboardTextBlocked(30));
    EXPECT_FALSE(dispatcher.keyboardTextBlocked(48));
    EXPECT_FALSE(dispatcher.keyboardTextBlocked());
    dispatcher.keyboardUpdate(Key::A, 30, InputAction::Release, 0);
    EXPECT_TRUE(dispatcher.keyboardTextBlocked(30));
    EXPECT_FALSE(dispatcher.keyboardTextBlocked());
    EXPECT_EQ(handler.m_textPolicyQueries, 2u);

    handler.m_blockText = true;
    dispatcher.keyboardUpdate(Key::B, 48, InputAction::Repeat, 0);
    EXPECT_TRUE(dispatcher.keyboardTextBlocked(48));
    EXPECT_TRUE(dispatcher.keyboardTextBlocked(-1));
    EXPECT_TRUE(dispatcher.keyboardTextBlocked(512));
    EXPECT_FALSE(dispatcher.keyboardTextBlocked(511));
    handler.m_blockText = false;
    dispatcher.keyboardUpdate(Key::C, 512, InputAction::Press, 0);
    EXPECT_FALSE(dispatcher.keyboardTextBlocked(512));
    EXPECT_TRUE(dispatcher.keyboardTextBlocked(30));
    EXPECT_TRUE(dispatcher.keyboardTextBlocked(48));
    dispatcher.keyboardUpdate(Key::Unknown, 48, InputAction::Press, 0);
    EXPECT_FALSE(dispatcher.keyboardTextBlocked(48));
    EXPECT_FALSE(dispatcher.keyboardTextBlocked());
}

void VerifyInputDispatcher_FocusLossClearsKeyboardTextPoliciesAndNestedRegainCannotReviveThem(){
    InputDispatcher dispatcher = InputDispatcher();
    FocusHandler handler(dispatcher);
    handler.m_consumeKeys = true;
    handler.m_blockText = true;
    dispatcher.addHandlerToBack(handler);
    dispatcher.keyboardUpdate(Key::A, 30, InputAction::Press, 0);
    dispatcher.keyboardUpdate(Key::B, 48, InputAction::Press, 0);
    ASSERT_TRUE(dispatcher.keyboardTextBlocked(30));
    ASSERT_TRUE(dispatcher.keyboardTextBlocked(48));
    dispatcher.windowFocusUpdate(false);
    EXPECT_FALSE(dispatcher.keyboardTextBlocked(30));
    EXPECT_FALSE(dispatcher.keyboardTextBlocked(48));
    EXPECT_FALSE(dispatcher.keyboardTextBlocked());
    dispatcher.keyboardUpdate(Key::B, 48, InputAction::Repeat, 0);
    EXPECT_FALSE(dispatcher.keyboardTextBlocked(48));
    dispatcher.windowFocusUpdate(true);
    handler.m_loseFocusOnPress = true;
    handler.m_regainFocusOnPress = true;
    dispatcher.keyboardUpdate(Key::A, 30, InputAction::Press, 0);
    EXPECT_TRUE(dispatcher.windowFocused());
    EXPECT_FALSE(dispatcher.keyboardTextBlocked(30));
    EXPECT_FALSE(dispatcher.keyboardTextBlocked());
}

void VerifyInputDispatcher_RemovingTheConsumingHandlerPreservesOnlyItsQueuedCharacterPolicy(){
    InputDispatcher dispatcher = InputDispatcher();
    FocusHandler scene(dispatcher);
    FocusHandler transient(dispatcher);
    scene.m_consumeKeys = true;
    transient.m_consumeKeys = true;
    transient.m_blockText = true;
    transient.m_removeSelfOnPress = true;
    dispatcher.addHandlerToFront(scene);
    dispatcher.addHandlerToBack(transient);
    dispatcher.keyboardUpdate(Key::A, 30, InputAction::Press, 0);
    EXPECT_TRUE(dispatcher.keyboardTextBlocked(30));
    EXPECT_EQ(transient.m_textPolicyQueries, 1u);
    EXPECT_EQ(scene.m_keyPresses, 0u);
    dispatcher.keyboardUpdate(Key::A, 30, InputAction::Release, 0);
    EXPECT_TRUE(dispatcher.keyboardTextBlocked(30));
    EXPECT_EQ(transient.m_keyReleases, 0u);
    EXPECT_EQ(scene.m_keyReleases, 1u);
    dispatcher.keyboardUpdate(Key::A, 30, InputAction::Repeat, 0);
    EXPECT_FALSE(dispatcher.keyboardTextBlocked(30));
    EXPECT_EQ(transient.m_textPolicyQueries, 1u);
    EXPECT_EQ(scene.m_textPolicyQueries, 1u);
}

void VerifyInputDispatcher_HandlerExceptionsRestoreDirectAndNestedDispatchDepth(){
    Array<b8, 2> modes = Array<b8, 2>();
    modes[0u] = false;
    modes[1u] = true;
    for(in b8 nestedDispatch : modes){
        InputDispatcher dispatcher = InputDispatcher();
        ThrowingHandler throwing(dispatcher, nestedDispatch);
        FocusHandler added(dispatcher);
        dispatcher.addHandlerToBack(throwing);

        native(mut dispatcher){
            EXPECT_THROW(dispatcher.keyboardUpdate(Key::W, 0, InputAction::Press, 0), u32);
        }
        EXPECT_EQ(throwing.m_keyUpdates, 1u);
        dispatcher.removeHandler(throwing);
        dispatcher.addHandlerToBack(added);
        dispatcher.keyboardUpdate(Key::W, 0, InputAction::Press, 0);
        EXPECT_EQ(throwing.m_keyUpdates, 1u);
        EXPECT_EQ(added.m_keyPresses, 1u);
    }
}

void VerifyInputDispatcher_MouseReleaseClearsSceneEvenWhenUiConsumesAfterPress(){
    InputDispatcher dispatcher = InputDispatcher();
    FocusHandler scene(dispatcher);
    FocusHandler ui(dispatcher);
    dispatcher.addHandlerToFront(scene);
    dispatcher.addHandlerToBack(ui);

    dispatcher.mouseButtonUpdate(MouseButton::Right, InputAction::Press, 0);
    ASSERT_EQ(scene.m_buttonPresses, 1u);
    ui.m_consumeButtons = true;
    dispatcher.mouseButtonUpdate(MouseButton::Right, InputAction::Release, 0);
    EXPECT_EQ(ui.m_buttonReleases, 1u);
    EXPECT_EQ(scene.m_buttonReleases, 1u);
    dispatcher.mouseButtonUpdate(MouseButton::Left, InputAction::Press, 0);
    EXPECT_EQ(ui.m_buttonPresses, 2u);
    EXPECT_EQ(scene.m_buttonPresses, 1u);
}

void VerifyInputDispatcher_CaptureLossSkipsPendingRemovalAndKeepsOtherOwners(){
    InputDispatcher dispatcher = InputDispatcher();
    PointerLifecycleHandler scene(dispatcher);
    PointerLifecycleHandler removed(dispatcher);
    PointerLifecycleHandler ui(dispatcher);
    dispatcher.addHandlerToFront(scene);
    dispatcher.addHandlerToBack(removed);
    dispatcher.addHandlerToBack(ui);
    ui.setRemoveOnCaptureLoss(removed);
    dispatcher.pointerCaptureLost();
    EXPECT_EQ(ui.m_captureLosses, 1u);
    EXPECT_EQ(scene.m_captureLosses, 1u);
    EXPECT_EQ(removed.m_captureLosses, 0u);
    dispatcher.pointerCaptureLost();
    EXPECT_EQ(ui.m_captureLosses, 2u);
    EXPECT_EQ(scene.m_captureLosses, 2u);
    EXPECT_EQ(removed.m_captureLosses, 0u);
}

void VerifyInputDispatcher_OwnerAddedDuringPointerLeaveWaitsForNextEvent(){
    InputDispatcher dispatcher = InputDispatcher();
    PointerLifecycleHandler existing(dispatcher);
    PointerLifecycleHandler added(dispatcher);
    dispatcher.addHandlerToBack(existing);
    existing.setAddOnLeave(added);
    dispatcher.pointerLeave();
    EXPECT_EQ(existing.m_leaves, 1u);
    EXPECT_EQ(added.m_leaves, 0u);
    dispatcher.pointerLeave();
    EXPECT_EQ(existing.m_leaves, 2u);
    EXPECT_EQ(added.m_leaves, 1u);
}

void VerifyInputDispatcher_PointerLifecycleDoesNotSynthesizeFocusOrKeyboardRelease(){
    InputDispatcher dispatcher = InputDispatcher();
    PointerLifecycleHandler handler(dispatcher);
    dispatcher.addHandlerToBack(handler);
    dispatcher.keyboardUpdate(Key::W, 0, InputAction::Press, 0);
    dispatcher.pointerLeave();
    dispatcher.pointerCaptureLost();
    EXPECT_TRUE(dispatcher.windowFocused());
    EXPECT_EQ(handler.m_focusChanges, 0u);
    EXPECT_EQ(handler.m_keyPresses, 1u);
    EXPECT_EQ(handler.m_keyReleases, 0u);
    dispatcher.keyboardUpdate(Key::W, 0, InputAction::Release, 0);
    EXPECT_EQ(handler.m_keyReleases, 1u);
}

native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace InputDispatcherTestsImpl{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void FocusHandler::windowFocusUpdate(const b8 focused){
    ASSERT_LT(m_focusCount, m_focusValues.size());
    m_focusValues[m_focusCount] = focused;
    ++m_focusCount;
    if(m_removeTarget){
        m_dispatcher.removeHandler(*m_removeTarget);
        m_removeTarget = nullptr;
    }
    if(m_addTarget){
        m_dispatcher.addHandlerToBack(*m_addTarget);
        m_addTarget = nullptr;
    }
    if(m_removeSelf)
        m_dispatcher.removeHandler(*this);
}

KeyboardInputResult FocusHandler::keyboardUpdate(i32, i32, const i32 action, i32){
    if(action == InputAction::Release)
        ++m_keyReleases;
    else
        ++m_keyPresses;
    if(m_loseFocusOnPress && action == InputAction::Press){
        m_dispatcher.windowFocusUpdate(false);
        if(m_regainFocusOnPress)
            m_dispatcher.windowFocusUpdate(true);
    }
    if(m_removeSelfOnPress && action != InputAction::Release)
        m_dispatcher.removeHandler(*this);
    if(m_consumeKeys && action != InputAction::Release)
        ++m_textPolicyQueries;
    return { m_consumeKeys, m_blockText };
}

b8 FocusHandler::mouseButtonUpdate(i32, const i32 action, i32)noexcept{
    if(action == InputAction::Release)
        ++m_buttonReleases;
    else
        ++m_buttonPresses;
    return m_consumeButtons;
}

KeyboardInputResult SelfDestroyingKeyHandler::keyboardUpdate(i32, i32, i32, i32){
    m_dispatcher.removeHandler(*this);
    auto* const owner = &m_owner;
    owner->reset();
    return { true, true };
}

KeyboardInputResult DestroyOtherKeyHandler::keyboardUpdate(i32, i32, i32, i32){
    if(m_victim){
        m_dispatcher.removeHandler(*m_victim);
        m_victim.reset();
    }
    return false;
}

KeyboardInputResult ReplacingKeyHandler::keyboardUpdate(i32, i32, i32, i32){
    ++m_calls;
    if(!m_replace)
        return { true, false };
    InputDispatcher* const dispatcher = &m_dispatcher;
    ReplacingKeyHandler** const slot = &m_slot;
    usize* const calls = &m_calls;
    void* const storage = this;
    dispatcher->removeHandler(*this);
    this->~ReplacingKeyHandler();
    *slot = new (storage) ReplacingKeyHandler(*dispatcher, *slot, *calls, false);
    dispatcher->addHandlerToBack(**slot);
    return { true, true };
}

KeyboardInputResult ThrowingHandler::keyboardUpdate(i32, i32, i32, i32){
    ++m_keyUpdates;
    if(m_nestedDispatch)
        m_dispatcher.pointerLeave();
    throw s_Failure;
}

void ThrowingHandler::pointerLeave(){
    throw s_Failure;
}

void PointerLifecycleHandler::pointerLeave(){
    ++m_leaves;
    if(m_addOnLeave){
        m_dispatcher.addHandlerToBack(*m_addOnLeave);
        m_addOnLeave = nullptr;
    }
}

void PointerLifecycleHandler::pointerCaptureLost(){
    ++m_captureLosses;
    if(m_removeOnCaptureLoss){
        m_dispatcher.removeHandler(*m_removeOnCaptureLoss);
        m_removeOnCaptureLoss = nullptr;
    }
}

KeyboardInputResult PointerLifecycleHandler::keyboardUpdate(i32, i32, const i32 action, i32)noexcept{
    if(action == InputAction::Release)
        ++m_keyReleases;
    else
        ++m_keyPresses;
    return false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}

NWB_ADHD_GTEST(InputDispatcher, ReplacementAtRemovedHandlerAddressStartsOnNextDispatch, VerifyInputDispatcher_ReplacementAtRemovedHandlerAddressStartsOnNextDispatch)
NWB_ADHD_GTEST(InputDispatcher, KeyHandlerCanRemoveAndDestroyItselfBeforeReturningPolicy, VerifyInputDispatcher_KeyHandlerCanRemoveAndDestroyItselfBeforeReturningPolicy)
NWB_ADHD_GTEST(InputDispatcher, RemovedHandlerCanBeDestroyedBeforeItsTurn, VerifyInputDispatcher_RemovedHandlerCanBeDestroyedBeforeItsTurn)
NWB_ADHD_GTEST(InputDispatcher, WindowFocusTransitionsReachEveryHandlerAndDeduplicate, VerifyInputDispatcher_WindowFocusTransitionsReachEveryHandlerAndDeduplicate)
NWB_ADHD_GTEST(InputDispatcher, FocusBroadcastSkipsPendingRemovalWithoutSkippingOtherOwners, VerifyInputDispatcher_FocusBroadcastSkipsPendingRemovalWithoutSkippingOtherOwners)
NWB_ADHD_GTEST(InputDispatcher, HandlerAddedDuringFocusBroadcastWaitsUntilNextTransition, VerifyInputDispatcher_HandlerAddedDuringFocusBroadcastWaitsUntilNextTransition)
