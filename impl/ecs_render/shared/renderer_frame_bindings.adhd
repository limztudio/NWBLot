#include <impl/ecs_render/shared/frame_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class MaterialPassBufferSnapshot{
    public BufferHandle instanceBuffer;
    public BufferHandle materialTypedBuffer;
    public usize instanceBufferCapacity;
    public usize materialTypedBufferCapacity;

    public MaterialPassBufferSnapshot(){
        this.instanceBuffer = BufferHandle();
        this.materialTypedBuffer = BufferHandle();
        this.instanceBufferCapacity = 0u;
        this.materialTypedBufferCapacity = 0u;
    }

    public MaterialPassBufferSnapshot(
        in BufferHandle instanceBufferIn,
        in BufferHandle materialTypedBufferIn,
        in usize instanceBufferCapacityIn,
        in usize materialTypedBufferCapacityIn
    ){
        this.instanceBuffer = instanceBufferIn;
        this.materialTypedBuffer = materialTypedBufferIn;
        this.instanceBufferCapacity = instanceBufferCapacityIn;
        this.materialTypedBufferCapacity = materialTypedBufferCapacityIn;
    }

    public b8 valid()const{
        return this.instanceBuffer.valid() && this.materialTypedBuffer.valid();
    }
}

class MeshViewBufferSnapshot{
    public BufferHandle buffer;
    public GpuDescriptorHandle heapHandle;

    public MeshViewBufferSnapshot(){
        this.buffer = BufferHandle();
        this.heapHandle = GpuDescriptorHandleInvalid();
    }

    public MeshViewBufferSnapshot(in BufferHandle bufferIn, in GpuDescriptorHandle heapHandleIn){
        this.buffer = bufferIn;
        this.heapHandle = heapHandleIn;
    }

    public b8 valid()const{
        return this.buffer.valid();
    }

    public b8 bindingValid()const{
        return this.buffer.valid() && this.heapHandle.valid() && this.heapHandle.descriptorClass() == GpuDescriptorClass::UniformBuffer;
    }
}

class MeshFrameBindingSnapshot{
    public BufferHandle instanceBuffer;
    public BufferHandle materialTypedBuffer;
    public MeshViewBufferSnapshot meshView;
    public GpuDescriptorHandle instanceHeapHandle;
    public GpuDescriptorHandle materialTypedHeapHandle;
    public usize instanceBufferCapacity;
    public usize materialTypedBufferCapacity;

    public MeshFrameBindingSnapshot(){
        this.instanceBuffer = BufferHandle();
        this.materialTypedBuffer = BufferHandle();
        this.meshView = MeshViewBufferSnapshot();
        this.instanceHeapHandle = GpuDescriptorHandleInvalid();
        this.materialTypedHeapHandle = GpuDescriptorHandleInvalid();
        this.instanceBufferCapacity = 0u;
        this.materialTypedBufferCapacity = 0u;
    }

    public MeshFrameBindingSnapshot(
        in BufferHandle instanceBufferIn,
        in BufferHandle materialTypedBufferIn,
        in MeshViewBufferSnapshot meshViewIn,
        in GpuDescriptorHandle instanceHeapHandleIn,
        in GpuDescriptorHandle materialTypedHeapHandleIn,
        in usize instanceBufferCapacityIn,
        in usize materialTypedBufferCapacityIn
    ){
        this.instanceBuffer = instanceBufferIn;
        this.materialTypedBuffer = materialTypedBufferIn;
        this.meshView = meshViewIn;
        this.instanceHeapHandle = instanceHeapHandleIn;
        this.materialTypedHeapHandle = materialTypedHeapHandleIn;
        this.instanceBufferCapacity = instanceBufferCapacityIn;
        this.materialTypedBufferCapacity = materialTypedBufferCapacityIn;
    }

    public b8 bindingValid()const{
        return
            this.instanceBuffer.valid()
            && this.materialTypedBuffer.valid()
            && this.meshView.bindingValid()
            && this.instanceHeapHandle.valid()
            && this.instanceHeapHandle.descriptorClass() == GpuDescriptorClass::StorageBuffer
            && this.materialTypedHeapHandle.valid()
            && this.materialTypedHeapHandle.descriptorClass() == GpuDescriptorClass::StorageBuffer
        ;
    }

    public b8 matches(in MaterialPassBufferSnapshot materialBuffers, in BufferHandle meshViewBuffer)const{
        return
            this.bindingValid()
            && this.instanceBuffer == materialBuffers.instanceBuffer
            && this.materialTypedBuffer == materialBuffers.materialTypedBuffer
            && this.meshView.buffer == meshViewBuffer
            && this.instanceBufferCapacity == materialBuffers.instanceBufferCapacity
            && this.materialTypedBufferCapacity == materialBuffers.materialTypedBufferCapacity
        ;
    }

    public b8 frameReady(in usize instanceCount, in usize materialTypedByteCount)const{
        return CanAcceptMeshFrameBindingCapacities(this.bindingValid(), this.instanceBufferCapacity, this.materialTypedBufferCapacity, instanceCount, materialTypedByteCount);
    }
}


