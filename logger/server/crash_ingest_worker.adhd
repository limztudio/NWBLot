////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <logger/server/arena_names.adhd>
#include <logger/server/crash_ingest.adhd>
#include <logger/server/server_values.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_LOG_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


inline constexpr usize s_MaxPendingCrashUploadPathText = ::NWB::Log::s_LogServerValueModuleMaxPendingCrashUploadPathText;

struct PendingCrashUpload{
    Array<char, s_MaxPendingCrashUploadPathText> path = {};
};

using CrashUploadQueue = ParallelQueue<PendingCrashUpload, LogArena>;


interface ICrashIngestSink{
    virtual ~ICrashIngestSink()noexcept = default;
    virtual void deliverCrashIngestMessage(LogString&& message, Core::Common::LogType::Enum type) = 0;
};


class CrashIngestWorker final : NoCopy{
public:
    CrashIngestWorker(LogArena& arena, ICrashIngestSink& sink);
    ~CrashIngestWorker()noexcept;


public:
    void configure(AStringView symbolStoreDirectory, CrashRetentionConfig retention);
    void start();
    void stop();
    [[nodiscard]] b8 enqueue(const Path& path, Core::Alloc::ScratchArena& scratchArena);


private:
    void run();
    [[nodiscard]] Expected<PendingCrashUpload> tryDequeue();


private:
    ICrashIngestSink& m_sink;
    CrashIngestConfig m_config;
    CrashUploadQueue m_uploads;
    Semaphore<> m_semaphore;
    Atomic<b8> m_exit;
    Thread m_thread;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_LOG_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CanFitPendingCrashUploadPath(in usize pathByteLength){
    return pathByteLength < s_LogServerValueModuleMaxPendingCrashUploadPathText;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <global/fixed_buffer.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_LOG_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


CrashIngestWorker::CrashIngestWorker(LogArena& arena, ICrashIngestSink& sink)
    : m_sink(sink)
    , m_config(arena)
    , m_uploads(arena)
    , m_semaphore(0)
    , m_exit(false)
{}

CrashIngestWorker::~CrashIngestWorker()noexcept{
    stop();
}


void CrashIngestWorker::configure(const AStringView symbolStoreDirectory, const CrashRetentionConfig retention){
    m_config.symbolication.symbolStoreDirectory.clear();
    if(!symbolStoreDirectory.empty())
        m_config.symbolication.symbolStoreDirectory = symbolStoreDirectory;
    m_config.retention = retention;
}

void CrashIngestWorker::start(){
    m_exit.store(false, MemoryOrder::release);
    m_thread = Thread([this](){ run(); });
}

void CrashIngestWorker::stop(){
    const b8 alreadyStopping = m_exit.exchange(true, MemoryOrder::acq_rel);
    if(!alreadyStopping)
        m_semaphore.release();
    if(m_thread.joinable())
        m_thread.join();
}

b8 CrashIngestWorker::enqueue(const Path& path, Core::Alloc::ScratchArena& scratchArena){
    PendingCrashUpload upload;
    const AString<Core::Alloc::ScratchArena> pathText = PathToString<char>(scratchArena, path);
    if(!CanFitPendingCrashUploadPath(pathText.size()))
        return false;

    CopyFixedBuffer(upload.path, AStringView(pathText.data(), pathText.size()));
    m_uploads.emplace(upload);
    m_semaphore.release();
    return true;
}


void CrashIngestWorker::run(){
    for(;;){
        m_semaphore.acquire();

        while(const auto crashUpload = tryDequeue()){
            LogArena ingestArena(s_LogServerArenaNameLoggerServerCrashIngest);
            CrashIngestConfig ingestConfig(ingestArena);
            ingestConfig.storageDirectory = m_config.storageDirectory;
            ingestConfig.symbolication.symbolStoreDirectory = m_config.symbolication.symbolStoreDirectory;
            ingestConfig.retention = m_config.retention;

            const Path archivePath(ingestArena, AStringView(crashUpload->path.data()));
            CrashIngestResult ingestResult = ProcessCrashUpload(ingestArena, archivePath, ingestConfig);
            m_sink.deliverCrashIngestMessage(Move(ingestResult.message), ingestResult.type);
        }

        if(m_exit.load(MemoryOrder::acquire))
            break;
    }
}

Expected<PendingCrashUpload> CrashIngestWorker::tryDequeue(){
    PendingCrashUpload upload;
    if(!m_uploads.try_pop(upload))
        return MakeUnexpected(Failure{});
    return upload;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_LOG_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

