    EXPECT_EQ(byte.value(), 3u);
    byte = self.m_geometry.verticalTarget(2u, true, 0.0f);
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 4u);
}

void VerifyEditCaretFixture_VerticalTargetsRetainTheCallerPreferredColumnAcrossShortLines(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("abcdef\nx\nabcd"));
    Expected<usize> byte = self.m_geometry.verticalTarget(5u, true, 50.0f);
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 8u);
    byte = self.m_geometry.verticalTarget(byte.value(), true, 50.0f);
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 13u);
    byte = self.m_geometry.verticalTarget(byte.value(), false, 50.0f);
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 8u);
    byte = self.m_geometry.verticalTarget(byte.value(), false, 50.0f);
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 5u);
    byte = self.m_geometry.verticalTarget(0u, true, 5.0f);
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 7u);
    byte = self.m_geometry.verticalTarget(0u, true, 5.01f);
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 8u);
}

void VerifyEditCaretFixture_VerticalDocumentBoundaryKeepsTheActiveCaretRatherThanReapplyingPreferredX(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("abc\nx"));
    Expected<usize> byte = self.m_geometry.verticalTarget(1u, false, 999.0f);
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 1u);
    byte = self.m_geometry.verticalTarget(5u, true, 0.0f);
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 5u);
    ASSERT_TRUE(self.adoptText("ffi", EditTextMode::SingleLine));
    byte = self.m_geometry.verticalTarget(1u, true, 0.0f);
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 1u);
}

void VerifyEditCaretFixture_VerticalMovementCanTargetEmptyAndTrailingLines(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("ab\n\nc\n"));
    Expected<usize> byte = self.m_geometry.verticalTarget(1u, true, 10.0f);
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 3u);
    byte = self.m_geometry.verticalTarget(byte.value(), true, 10.0f);
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 5u);
    byte = self.m_geometry.verticalTarget(byte.value(), true, 10.0f);
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 6u);
}

void VerifyEditCaretFixture_EmptyTextAndEmptyCollapsedPreeditHaveValidOwnedGeometry(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("", EditTextMode::SingleLine));
    ASSERT_EQ(self.m_geometry.lines().size(), 1u);
    ASSERT_EQ(self.m_geometry.caretStops().size(), 1u);
    self.expectCaret(0u, 0.0f, 0.0f);
    self.m_mapping.push_back(MakeUiEditCaretMapping(0u, 0u));
    ASSERT_TRUE(self.adopt("", 0u, EditTextMode::SingleLine));
    ASSERT_EQ(self.m_geometry.caretStops().size(), 2u);
    const Expected<usize> byte = self.m_geometry.hitTest(Point(20.0f, 20.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 0u);
}

void VerifyEditCaretFixture_MismatchedSourceFailurePreservesBothPriorGeometryAndCandidateOwnership(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("old\ntext"));
    ASSERT_TRUE(UiEditCaretAdoptMismatchedSource(self));
    EXPECT_EQ(self.m_geometry.layout().utf8(), "old\ntext");
    EXPECT_EQ(self.m_geometry.textMode(), EditTextMode::Multiline);
    EXPECT_TRUE(self.m_geometry.ready());
    self.expectCaret(4u, 0.0f, 12.0f);
}

void VerifyEditCaretFixture_MappingEndpointOrderAndBoundsFailuresPreservePriorGeometry(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("abc", EditTextMode::SingleLine));
    Array<usize, 28u> committed = Array<usize, 28u>();
    committed[0u] = 1u; committed[1u] = 1u; committed[2u] = 2u; committed[3u] = 3u;
    committed[4u] = 0u; committed[5u] = 1u; committed[6u] = 2u; committed[7u] = 3u;
    committed[8u] = 0u; committed[9u] = 1u; committed[10u] = 2u; committed[11u] = 2u;
    committed[12u] = 0u; committed[13u] = 1u; committed[14u] = 2u; committed[15u] = 3u;
    committed[16u] = 0u; committed[17u] = 2u; committed[18u] = 1u; committed[19u] = 3u;
    committed[20u] = 0u; committed[21u] = 1u; committed[22u] = 2u; committed[23u] = 3u;
    committed[24u] = 0u; committed[25u] = 4u; committed[26u] = 4u; committed[27u] = 3u;

    Array<usize, 28u> display = Array<usize, 28u>();
    display[0u] = 0u; display[1u] = 1u; display[2u] = 2u; display[3u] = 3u;
    display[4u] = 1u; display[5u] = 1u; display[6u] = 2u; display[7u] = 3u;
    display[8u] = 0u; display[9u] = 1u; display[10u] = 2u; display[11u] = 3u;
    display[12u] = 0u; display[13u] = 1u; display[14u] = 2u; display[15u] = 2u;
    display[16u] = 0u; display[17u] = 1u; display[18u] = 2u; display[19u] = 3u;
    display[20u] = 0u; display[21u] = 2u; display[22u] = 1u; display[23u] = 3u;
    display[24u] = 0u; display[25u] = 1u; display[26u] = 2u; display[27u] = 3u;

    for(usize caseIndex = 0u; caseIndex < 7u; ++caseIndex){
        self.m_mapping.clear();
        for(usize entryIndex = 0u; entryIndex < 4u; ++entryIndex){
            const usize flat = caseIndex * 4u + entryIndex;
            self.m_mapping.push_back(MakeUiEditCaretMapping(committed[flat], display[flat]));
        }
        EXPECT_FALSE(self.adopt("abc", 3u, EditTextMode::SingleLine));
        EXPECT_EQ(self.m_geometry.layout().utf8(), "abc");
        ASSERT_EQ(self.m_geometry.caretStops().size(), 4u);
        self.expectCaret(1u, 10.0f, 0.0f);
    }
}

void VerifyEditCaretFixture_NativeMappingAcceptsScalarEdgesButRejectsContinuationBytes(mut EditCaretFixture self){
    self.m_mapping.push_back(MakeUiEditCaretMapping(0u, 0u));
    self.m_mapping.push_back(MakeUiEditCaretMapping(1u, 1u));
    self.m_mapping.push_back(MakeUiEditCaretMapping(2u, 3u));
    ASSERT_TRUE(self.adopt("e\xcc\x81", 2u, EditTextMode::SingleLine));
    EXPECT_FLOAT_EQ(self.m_geometry.caretStops()[1u].x, 5.0f);
    self.m_mapping[1u].displayByte = 2u;
    EXPECT_FALSE(self.adopt("e\xcc\x81", 2u, EditTextMode::SingleLine));
    EXPECT_EQ(self.m_geometry.caretStops()[1u].displayByte, 1u);
}

void VerifyEditCaretFixture_MultilineRequiresCanonicalLfAndSingleLineRejectsHardBreaks(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("base", EditTextMode::SingleLine));
    EXPECT_FALSE(self.adoptText("ab\r\nc", EditTextMode::Multiline));
    EXPECT_FALSE(self.adoptText("ab\nc", EditTextMode::SingleLine));
    EXPECT_FALSE(self.adoptText("abc", cast<EditTextMode>(99u)));
    EXPECT_EQ(self.m_geometry.layout().utf8(), "base");
    EXPECT_EQ(self.m_geometry.textMode(), EditTextMode::SingleLine);
}

void VerifyEditCaretFixture_InvalidDirectionAndMalformedClusterCoverageCannotReplaceReadyGeometry(mut EditCaretFixture self){
    const StringView text = "abc";
    ASSERT_TRUE(self.adoptText("base", EditTextMode::SingleLine));
    ASSERT_TRUE(self.identityMapping(text));
    ShapeRequest invalidDirection = ShapeRequest();
    invalidDirection.text = text;
    invalidDirection.direction = cast<TextDirection>(99u);
    EXPECT_FALSE(self.m_builder.layout(invalidDirection).has_value());
    Array<UiFixtureShaperFault, 4u> faults = Array<UiFixtureShaperFault, 4u>();
    faults[0u] = UiFixtureShaperFault::LeadingGap;
    faults[1u] = UiFixtureShaperFault::TrailingGap;
    faults[2u] = UiFixtureShaperFault::Overlap;
    faults[3u] = UiFixtureShaperFault::InconsistentGlyphEnd;
    for(in UiFixtureShaperFault fault : faults){
        const ScopedTestTrace trace = ScopedTestTrace(cast<u32>(fault));
        self.m_shaper.fault = fault;
        EXPECT_FALSE(UiEditCaretAdoptBuiltLayout(self, text, text, 3u, EditTextMode::SingleLine));
        EXPECT_EQ(self.m_geometry.layout().utf8(), "base");
        self.expectCaret(1u, 10.0f, 0.0f);
    }
}

void VerifyEditCaretFixture_NonfiniteDerivedGlyphPlacementCannotReplaceReadyGeometry(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("base", EditTextMode::SingleLine));
    self.m_shaper.fault = UiFixtureShaperFault::NonfinitePlacement;
    EXPECT_FALSE(self.layout("ab").has_value());
    EXPECT_EQ(self.m_geometry.layout().utf8(), "base");
    self.expectCaret(1u, 10.0f, 0.0f);
    self.m_shaper.fault = UiFixtureShaperFault::None;
    EXPECT_FALSE(UiEditCaretAdoptNonfinitePlacement(self));
    EXPECT_EQ(self.m_geometry.layout().utf8(), "base");
}

void VerifyEditCaretFixture_RtlClustersSupportCaretsSelectionRangesWordHitAndVerticalTargets(mut EditCaretFixture self){
    const StringView text = "ab\ncd";
    ASSERT_TRUE(self.identityMapping(text));
    ASSERT_TRUE(UiEditCaretAdoptBuiltLayout(self, text, text, 5u, EditTextMode::Multiline, TextDirection::RightToLeft));
    self.expectCaret(0u, 20.0f, 0.0f);
    self.expectCaret(1u, 10.0f, 0.0f);
    self.expectCaret(2u, 0.0f, 0.0f);
    self.expectCaret(3u, 20.0f, 12.0f);
    self.expectCaret(4u, 10.0f, 12.0f);
    self.expectCaret(5u, 0.0f, 12.0f);

    const Expected<Rect> line0Full = self.m_geometry.rangeOnLine(MakeUiEditCaretRange(0u, 2u), 0u, 2.0f);
    ASSERT_TRUE(line0Full.has_value());
    ExpectUiRect(line0Full.value(), Rect(0.0f, 0.0f, 20.0f, 12.0f));
    const Expected<Rect> crossLine = self.m_geometry.rangeOnLine(MakeUiEditCaretRange(1u, 4u), 0u, 2.0f);
    ASSERT_TRUE(crossLine.has_value());
    ExpectUiRect(crossLine.value(), Rect(0.0f, 0.0f, 12.0f, 12.0f));

    const Expected<usize> down = self.m_geometry.verticalTarget(1u, true, 10.0f);
    ASSERT_TRUE(down.has_value());
    EXPECT_EQ(down.value(), 4u);

    const Expected<usize> wordLeft = TryHitEditWordCaretGeometry(self.m_geometry.lines(), self.m_geometry.caretStops(), Point(5.0f, 4.0f));
    const Expected<usize> wordRight = TryHitEditWordCaretGeometry(self.m_geometry.lines(), self.m_geometry.caretStops(), Point(15.0f, 4.0f));
    ASSERT_TRUE(wordLeft.has_value());
    ASSERT_TRUE(wordRight.has_value());
    EXPECT_EQ(wordLeft.value(), 1u);
    EXPECT_EQ(wordRight.value(), 0u);

    self.m_shaper.fault = UiFixtureShaperFault::LeadingGap;
    ASSERT_TRUE(self.identityMapping("xyz"));
    EXPECT_FALSE(UiEditCaretAdoptBuiltLayout(self, "xyz", "xyz", 3u, EditTextMode::SingleLine, TextDirection::RightToLeft));
    self.m_shaper.fault = UiFixtureShaperFault::None;
    EXPECT_EQ(self.m_geometry.layout().utf8(), "ab\ncd");
}

void VerifyEditCaretFixture_MalformedLineRecordsCannotReplaceReadyGeometry(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("base", EditTextMode::SingleLine));
    ASSERT_TRUE(self.identityMapping("a\nb"));
    for(u32 mutation = 0u; mutation < 15u; ++mutation){
        const ScopedTestTrace trace = ScopedTestTrace(mutation);
        EXPECT_FALSE(UiEditCaretAdoptMutatedLineRecord(self, mutation));
        EXPECT_EQ(self.m_geometry.layout().utf8(), "base");
        EXPECT_EQ(self.m_geometry.textMode(), EditTextMode::SingleLine);
        self.expectCaret(1u, 10.0f, 0.0f);
    }
}

void VerifyEditCaretFixture_OwnedGeometrySurvivesSourceAndMappingChangesAndMoves(mut EditCaretFixture self){
    String source = "ab\nc";
    ASSERT_TRUE(self.adoptText(source));
    source.assign("replacement");
    self.m_mapping.clear();
    EditCaretGeometry moved = EditCaretGeometry();
    TestMoveAssign<EditCaretGeometry>(moved, self.m_geometry);
    EXPECT_EQ(moved.layout().utf8(), "ab\nc");
    ASSERT_EQ(moved.lines().size(), 2u);
    const Expected<Rect> rectangle = moved.caretRect(4u);
    ASSERT_TRUE(rectangle.has_value());
    EXPECT_FLOAT_EQ(rectangle.value().x, 10.0f);
    EXPECT_FLOAT_EQ(rectangle.value().y, 12.0f);
    EditCaretGeometry assigned = EditCaretGeometry();
    TestMoveAssign<EditCaretGeometry>(assigned, moved);
    const Expected<usize> byte = assigned.hitTest(Point(10.0f, 14.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 4u);
}

void VerifyEditCaretFixture_ZeroAdvanceStopsKeepTheFirstExactTieAndFiniteExtremesStayQueryable(mut EditCaretFixture self){
    self.m_shaper.zeroAdvance = true;
    ASSERT_TRUE(self.adoptText("abc", EditTextMode::SingleLine));
    Expected<usize> byte = self.m_geometry.hitTest(Point(0.0f, 0.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 0u);
    byte = self.m_geometry.hitTest(Point(f32.max, 0.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 0u);
    byte = self.m_geometry.hitTest(Point(-f32.max, 0.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 0u);
    self.m_shaper.zeroAdvance = false;
    ASSERT_TRUE(self.adoptText("abc", EditTextMode::SingleLine));
    byte = self.m_geometry.hitTest(Point(-f32.max, 0.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 0u);
    byte = self.m_geometry.hitTest(Point(f32.max, 0.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 3u);
}

void VerifyEditCaretFixture_VariableLineHeightsDetermineCaretAndHitBoundaries(mut EditCaretFixture self){
    self.m_shaper.variedHeight = true;
    ASSERT_TRUE(self.adoptText("a\nTALL\nb"));
    self.expectCaret(2u, 0.0f, 12.0f, 20.0f);
    self.expectCaret(7u, 0.0f, 32.0f);
    Expected<usize> byte = self.m_geometry.hitTest(Point(0.0f, 31.9f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 2u);
    byte = self.m_geometry.hitTest(Point(0.0f, 32.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 7u);
}

void VerifyEditCaretFixture_InvalidCoordinatesAndCaretOffsetsRejectQueries(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("e\xcc\x81\nx"));
    Array<Point, 2u> invalid = Array<Point, 2u>();
    invalid[0u] = Point(bit_cast<f32>(0x7fc00000u), 0.0f);
    invalid[1u] = Point(0.0f, bit_cast<f32>(0x7f800000u));
    for(in Point point : invalid)
        EXPECT_FALSE(self.m_geometry.hitTest(point).has_value());
    EXPECT_FALSE(self.m_geometry.verticalTarget(2u, true, 10.0f).has_value());
    EXPECT_FALSE(self.m_geometry.verticalTarget(0u, true, bit_cast<f32>(0x7fc00000u)).has_value());
    EXPECT_FALSE(self.m_geometry.verticalTarget(6u, true, 10.0f).has_value());
    EXPECT_FALSE(self.m_geometry.caretRect(6u).has_value());
}

void VerifyEditCaretRangeFixture_SingleLineLigatureRangesUseInterpolatedCaretEdges(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("ffi", EditTextMode::SingleLine));
    self.expectRange(MakeUiEditCaretRange(1u, 2u), 0u, Rect(10.0f, 0.0f, 10.0f, 12.0f));
    self.expectRange(MakeUiEditCaretRange(1u, 1u), 0u, Rect());
}

void VerifyEditCaretRangeFixture_CrossLineSelectionIncludesContentAndEachSelectedBreakCap(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("abc\nx\nyz"));
    self.expectRange(MakeUiEditCaretRange(1u, 7u), 0u, Rect(10.0f, 0.0f, 21.0f, 12.0f));
    self.expectRange(MakeUiEditCaretRange(1u, 7u), 1u, Rect(0.0f, 12.0f, 11.0f, 12.0f));
    self.expectRange(MakeUiEditCaretRange(1u, 7u), 2u, Rect(0.0f, 24.0f, 10.0f, 12.0f));
}

void VerifyEditCaretRangeFixture_SelectingOnlyLfPaintsItsPrecedingLineCap(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("abc\nx"));
    self.expectRange(MakeUiEditCaretRange(3u, 4u), 0u, Rect(30.0f, 0.0f, 1.0f, 12.0f));
    self.expectRange(MakeUiEditCaretRange(3u, 4u), 1u, Rect());
}

void VerifyEditCaretRangeFixture_EmptyLineLfSelectionHasAVisibleCap(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("a\n\nb"));
    self.expectRange(MakeUiEditCaretRange(2u, 3u), 0u, Rect());
    self.expectRange(MakeUiEditCaretRange(2u, 3u), 1u, Rect(0.0f, 12.0f, 1.0f, 12.0f));
    self.expectRange(MakeUiEditCaretRange(2u, 3u), 2u, Rect());
}

void VerifyEditCaretRangeFixture_TrailingLfDoesNotAddASecondCapOnTheEmptyTerminalLine(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("ab\n"));
    self.expectRange(MakeUiEditCaretRange(0u, 3u), 0u, Rect(0.0f, 0.0f, 21.0f, 12.0f));
    self.expectRange(MakeUiEditCaretRange(0u, 3u), 1u, Rect());
    self.expectRange(MakeUiEditCaretRange(3u, 3u), 0u, Rect());
    self.expectRange(MakeUiEditCaretRange(3u, 3u), 1u, Rect());
}

void VerifyEditCaretRangeFixture_NonintersectingAndCollapsedRangesReturnEmptyRectangles(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("abc\nx\nyz"));
    self.expectRange(MakeUiEditCaretRange(6u, 8u), 0u, Rect());
    self.expectRange(MakeUiEditCaretRange(6u, 8u), 1u, Rect());
    self.expectRange(MakeUiEditCaretRange(0u, 1u), 2u, Rect());
    for(u32 line = 0u; line < self.m_geometry.lines().size(); ++line)
        self.expectRange(MakeUiEditCaretRange(0u, 0u), line, Rect());
}

void VerifyEditCaretRangeFixture_ScalarPreeditRangesCanCrossLinesInsideDisplayGraphemes(mut EditCaretFixture self){
    self.m_mapping.push_back(MakeUiEditCaretMapping(0u, 0u));
    self.m_mapping.push_back(MakeUiEditCaretMapping(0u, 5u));
    ASSERT_TRUE(self.adopt("e\xcc\x81\nZ", 0u));
    self.expectRange(MakeUiEditCaretRange(1u, 5u), 0u, Rect(5.0f, 0.0f, 6.0f, 12.0f));
    self.expectRange(MakeUiEditCaretRange(1u, 5u), 1u, Rect(0.0f, 12.0f, 10.0f, 12.0f));
    self.expectRange(MakeUiEditCaretRange(0u, 1u), 0u, Rect(0.0f, 0.0f, 5.0f, 12.0f));
}

void VerifyEditCaretRangeFixture_BreakCapWidthIsAppliedOnlyToSelectedLfBytes(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("ab\nc"));
    self.expectRange(MakeUiEditCaretRange(0u, 3u), 0u, Rect(0.0f, 0.0f, 20.0f, 12.0f), 0.0f);
    self.expectRange(MakeUiEditCaretRange(0u, 3u), 0u, Rect(0.0f, 0.0f, 20.5f, 12.0f), 0.5f);
    self.expectRange(MakeUiEditCaretRange(1u, 2u), 0u, Rect(10.0f, 0.0f, 10.0f, 12.0f), 100.0f);
    self.expectRange(MakeUiEditCaretRange(3u, 4u), 1u, Rect(0.0f, 12.0f, 10.0f, 12.0f), 100.0f);
}

void VerifyEditCaretRangeFixture_InvalidRangeEndpointsAndLineIndicesRejectQueries(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("e\xcc\x81\nx"));
    Array<EditBoxRange, 4u> invalid = Array<EditBoxRange, 4u>();
    invalid[0u] = MakeUiEditCaretRange(3u, 1u);
    invalid[1u] = MakeUiEditCaretRange(0u, 6u);
    invalid[2u] = MakeUiEditCaretRange(2u, 3u);
    invalid[3u] = MakeUiEditCaretRange(1u, 2u);
    for(in EditBoxRange range : invalid)
        EXPECT_FALSE(self.m_geometry.rangeOnLine(range, 0u, 1.0f).has_value());
    EXPECT_FALSE(self.m_geometry.rangeOnLine(MakeUiEditCaretRange(0u, 1u), 2u, 1.0f).has_value());
}

void VerifyEditCaretRangeFixture_InvalidBreakCapsRejectEvenCollapsedRanges(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("ab\nc"));
    Array<f32, 4u> invalid = Array<f32, 4u>();
    invalid[0u] = -1.0f;
    invalid[1u] = bit_cast<f32>(0x7fc00000u);
    invalid[2u] = bit_cast<f32>(0x7f800000u);
    invalid[3u] = -bit_cast<f32>(0x7f800000u);
    for(in f32 cap : invalid){
        EXPECT_FALSE(self.m_geometry.rangeOnLine(MakeUiEditCaretRange(0u, 3u), 0u, cap).has_value());
        EXPECT_FALSE(self.m_geometry.rangeOnLine(MakeUiEditCaretRange(1u, 1u), 0u, cap).has_value());
    }
}

void VerifyEditCaretRangeFixture_OverflowingSelectedBreakWidthRejectsQuery(mut EditCaretFixture self){
    self.m_shaper.scalarAdvance = f32.max;
    ASSERT_TRUE(self.adoptText("a\n"));
    EXPECT_FALSE(self.m_geometry.rangeOnLine(MakeUiEditCaretRange(0u, 2u), 0u, f32.max).has_value());
    self.expectRange(MakeUiEditCaretRange(0u, 1u), 0u, Rect(0.0f, 0.0f, f32.max, 12.0f));
}

void VerifyEditBoxLayoutTests_PasswordMaskingMapsCaretsHitsAndImePreeditAcrossMultiByteGlyphs(mut EditBoxLayoutTests self){
    ASSERT_TRUE(self.m_model.setText("a\xc3\xa9"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 3u));
    ASSERT_TRUE(self.m_view.snapshot(self.m_model, true, 0x2022u));
    EXPECT_EQ(self.m_view.displayText(), "\xe2\x80\xa2\xe2\x80\xa2");
    EXPECT_EQ(self.m_view.selectionRange().begin, 3u);
    EXPECT_EQ(self.m_view.selectionRange().end, 6u);
    EXPECT_EQ(self.m_view.displayCaret(), 6u);
    ASSERT_TRUE(self.tryAdoptBuiltLayout(self.m_view.displayText()));
    ASSERT_TRUE(self.place());
    ASSERT_EQ(self.m_view.caretStops().size(), 3u);
    EXPECT_EQ(self.m_view.caretStops()[1u].committedByte, 1u);
    EXPECT_EQ(self.m_view.caretStops()[1u].displayByte, 3u);
    const Expected<usize> hitMiddle = self.m_view.hitTest(Point(18.0f, 24.0f), self.m_placement);
    ASSERT_TRUE(hitMiddle.has_value());
    EXPECT_EQ(hitMiddle.value(), 1u);
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("xy", 1u, 2u, Span<EditPreeditClause>()));
    ASSERT_TRUE(self.m_view.snapshot(self.m_model, true, 0x2au));
    EXPECT_EQ(self.m_view.displayText(), "***");
    EXPECT_EQ(self.m_view.preeditRange().begin, 1u);
    EXPECT_EQ(self.m_view.preeditRange().end, 3u);
    EXPECT_EQ(self.m_view.selectionRange().begin, 2u);
    EXPECT_EQ(self.m_view.selectionRange().end, 3u);
    EXPECT_EQ(self.m_view.displayCaret(), 3u);
    EXPECT_FALSE(self.m_view.snapshot(self.m_model, true, 0x0au));
}

