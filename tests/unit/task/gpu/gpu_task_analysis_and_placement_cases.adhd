enum<u8> GpuAnalysisReadyOrderShape{
    ConsumerFirstPairs = 0,
    ProducerFirstPairs = 1,
    ReverseChain = 2,
    kCount
}

GpuTaskId GpuAnalysis_MakeTaskId(in u64 generation, in u32 index){
    GpuTaskId id = GpuTaskId();
    id.generation = generation;
    id.index = index;
    return id;
}

GpuGraphResourceId GpuAnalysis_MakeResourceId(in u64 generation, in u32 index){
    GpuGraphResourceId id = GpuGraphResourceId();
    id.generation = generation;
    id.index = index;
    return id;
}

GpuGraphResourceVersionId GpuAnalysis_MakeResourceVersionId(in u64 generation, in u32 index){
    GpuGraphResourceVersionId id = GpuGraphResourceVersionId();
    id.generation = generation;
    id.index = index;
    return id;
}

GpuTaskDependencyEdge GpuAnalysis_MakeEdge(
    in GpuTaskId producer,
    in GpuTaskId consumer,
    in GpuGraphResourceId resource,
    in GpuGraphResourceVersionId resourceVersion,
    in GpuTaskHazardTypeEnum hazard
){
    GpuTaskDependencyEdge edge = GpuTaskDependencyEdge();
    edge.producer = producer;
    edge.consumer = consumer;
    edge.resource = resource;
    edge.resourceVersion = resourceVersion;
    edge.hazard = hazard;
    return edge;
}

GpuPhysicalQueueTopology GpuAnalysis_MakeTopology(in Span<GpuPhysicalQueueInfo> queues){
    GpuPhysicalQueueTopology topology = GpuPhysicalQueueTopology();
    native(in queues, mut topology){
        topology.queues = queues.data();
        topology.queueCount = queues.size();
    }
    return topology;
}

Optional<GpuTaskQueueAssignment> GpuAnalysis_FindQueueAssignment(in GpuTaskGraphQueueAssignments assignments, in GpuTaskId task){
    Optional<GpuTaskQueueAssignment> result = Optional<GpuTaskQueueAssignment>();
    native(in assignments, in task, mut result){
        if(const Core::GpuTaskQueueAssignment* const found = assignments.find(task))
            result = *found;
    }
    return result;
}

b8 GpuAnalysis_HasFatalFailure(){
    b8 failed = false;
    native(mut failed){
        failed = ::testing::Test::HasFatalFailure();
    }
    return failed;
}

void GpuAnalysis_CheckPacketQueries(in usize taskCount){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    u64 graphGeneration = 0u;
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        ASSERT_TRUE(declarations.valid());
        graphGeneration = declarations.generation();
    }
    GpuAnalysisTaskGraphicsVector tasks = GpuAnalysisTaskGraphicsVector(testArena.arena);
    tasks.resize(taskCount);
    for(usize declarationIndex = 0u; declarationIndex < taskCount; ++declarationIndex){
        const usize orderIndex = taskCount - declarationIndex - 1u;
        GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
        scheduling.mergeWithPrevious = orderIndex != 0u;
        const GpuTaskId dependency = GpuAnalysis_MakeTaskId(graphGeneration, cast<u32>(declarationIndex + 1u));
        FixedVector<GpuTaskId, 1> dependencies = FixedVector<GpuTaskId, 1>();
        if(orderIndex != 0u)
            dependencies.push_back(dependency);
        const auto derivedNameResult = IndexedName(s_GpuCaseCompiledQueryTask, declarationIndex);
        ASSERT_TRUE(derivedNameResult.has_value());
        const auto taskAdmission = AddTaskWithCommands(
            derivedNameResult.value(),
            "Compiled Query Task",
            GraphicsCommands(),
            scheduling,
            GpuTaskTimingMetadata(),
            dependencies,
            graph
        );
        ASSERT_TRUE(taskAdmission.has_value());
        tasks[orderIndex] = taskAdmission.value();
        ASSERT_TRUE(tasks[orderIndex].valid());
    }
    Array<GpuTaskId, 1> backTaskDeps = Array<GpuTaskId, 1>();
    backTaskDeps[0u] = tasks.back();
    const auto nextPacketTaskResult = AddTaskWithCommands(
        s_GpuCaseCompiledQueryNextPacket,
        "Next Packet",
        GraphicsCommands(),
        GpuTaskSchedulingHint(),
        GpuTaskTimingMetadata(),
        backTaskDeps,
        graph
    );
    ASSERT_TRUE(nextPacketTaskResult.has_value());
    const GpuTaskId nextPacketTask = nextPacketTaskResult.value();
    ASSERT_TRUE(nextPacketTask.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    Array<GpuPhysicalQueueInfo, 1> queues = Array<GpuPhysicalQueueInfo, 1>();
    queues[0u] = GraphicsQueue();
    const GpuPhysicalQueueTopology topology = GpuAnalysis_MakeTopology(queues);
    ASSERT_TRUE(Compile(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));

    const GpuTaskGraphReadViews views = GpuTaskGraphReadViews(graph, compiledGraph);
    ASSERT_TRUE(views.valid());
    ASSERT_EQ(views.compiled.packetCount(), 2u);
    EXPECT_TRUE(views.compiled.taskPrecedesInSamePacket(tasks.front(), tasks.back()));
    EXPECT_FALSE(views.compiled.taskPrecedesInSamePacket(tasks.back(), tasks.front()));
    EXPECT_FALSE(views.compiled.taskPrecedesInSamePacket(tasks.front(), tasks.front()));
    EXPECT_FALSE(views.compiled.taskPrecedesInSamePacket(tasks.front(), nextPacketTask));
    EXPECT_FALSE(views.compiled.taskPrecedesInSamePacket(GpuTaskId(), tasks.back()));

    Array<GpuTaskId, 2> reversed = Array<GpuTaskId, 2>();
    reversed[0u] = tasks[1u];
    reversed[1u] = tasks[0u];
    Array<GpuTaskId, 2> duplicated = Array<GpuTaskId, 2>();
    duplicated[0u] = tasks[1u];
    duplicated[1u] = tasks[1u];
    Array<GpuTaskId, 2> noncontiguous = Array<GpuTaskId, 2>();
    noncontiguous[0u] = tasks.front();
    noncontiguous[1u] = tasks.back();
    Array<GpuTaskId, 2> crossesPackets = Array<GpuTaskId, 2>();
    crossesPackets[0u] = tasks.back();
    crossesPackets[1u] = nextPacketTask;
    Array<GpuTaskId, 1> staleSeq = Array<GpuTaskId, 1>();
    staleSeq[0u] = GpuAnalysis_MakeTaskId(graphGeneration + 1u, tasks.front().index);

    EXPECT_FALSE(views.compiled.tasksFormContiguousPacketSequence(reversed));
    EXPECT_FALSE(views.compiled.tasksFormContiguousPacketSequence(duplicated));
    EXPECT_FALSE(views.compiled.tasksFormContiguousPacketSequence(noncontiguous));
    EXPECT_FALSE(views.compiled.tasksFormContiguousPacketSequence(crossesPackets));
    EXPECT_FALSE(views.compiled.tasksFormContiguousPacketSequence(staleSeq));
    native(in views, in tasks){
        EXPECT_TRUE(views.compiled.tasksFormContiguousPacketSequence(Span<const Core::GpuTaskId>(tasks.data(), tasks.size())));
        EXPECT_TRUE(views.compiled.tasksFormContiguousPacketSequence(Span<const Core::GpuTaskId>(tasks.data() + 1u, tasks.size() - 2u)));
        EXPECT_FALSE(views.compiled.tasksFormContiguousPacketSequence(Span<const Core::GpuTaskId>(static_cast<const Core::GpuTaskId*>(nullptr), 1u)));
        EXPECT_FALSE(views.compiled.tasksFormContiguousPacketSequence(Span<const Core::GpuTaskId>(tasks.data(), 0u)));
    }
}

void VerifyGpuAnalysis_PacketQueriesFollowExecutionOrderAcrossReverseDeclarations(){
    GpuAnalysis_CheckPacketQueries(32u);
    ASSERT_FALSE(GpuAnalysis_HasFatalFailure());
}

void VerifyGpuAnalysis_PreservesUploadOnlyAndCompleteColorForms(){
    GpuTaskGraphOutputLayer layer = GpuTaskGraphOutputLayer();
    layer.readyTask = GpuAnalysis_MakeTaskId(3u, 0u);
    EXPECT_FALSE(layer.validShape());

    layer.frameGeneration = 17u;
    EXPECT_TRUE(layer.validShape());

    layer.color = GpuAnalysis_MakeResourceId(3u, 1u);
    EXPECT_FALSE(layer.validShape());
    layer.colorVersion = GpuAnalysis_MakeResourceVersionId(3u, 2u);
    EXPECT_FALSE(layer.validShape());
    native(mut layer){
        layer.sampledImage = Core::GpuDescriptorHandle::Make(Core::GpuDescriptorClass::SampledImage, 4u);
    }
    EXPECT_TRUE(layer.validShape());

    layer.readyTask = GpuTaskId();
    EXPECT_FALSE(layer.validShape());
    layer.readyTask = GpuAnalysis_MakeTaskId(3u, 0u);
    layer.frameGeneration = 0u;
    EXPECT_FALSE(layer.validShape());
}

void VerifyGpuAnalysis_RejectsPartialColorWithoutAReadyTask(){
    GpuTaskGraphOutputLayer layer = GpuTaskGraphOutputLayer();
    layer.frameGeneration = 17u;
    layer.colorVersion = GpuAnalysis_MakeResourceVersionId(3u, 2u);
    EXPECT_FALSE(layer.validShape());

    layer.colorVersion = GpuGraphResourceVersionId();
    native(mut layer){
        layer.sampledImage = Core::GpuDescriptorHandle::Make(Core::GpuDescriptorClass::SampledImage, 4u);
    }
    EXPECT_FALSE(layer.validShape());
}

void GpuAnalysis_BuildVersionChain(
    mut GpuTaskGraph graph,
    in GpuResourceVersionOriginEnum origin,
    in usize taskCount,
    in b8 disjointClobber,
    in b8 overlappingClobber
){
    usize minTasks = 2u;
    if(overlappingClobber)
        minTasks = 3u;
    ASSERT_GE(taskCount, minTasks);

    const auto bufferResult = AddBufferMetadata(graph, s_GpuCaseAnalysisOptimizationVersionBuffer, "Analysis Version Buffer");
    ASSERT_TRUE(bufferResult.has_value());
    const GpuGraphResourceId buffer = bufferResult.value();
    ASSERT_TRUE(buffer.valid());

    GpuTaskResourceRange versionRange = GpuTaskResourceRange();
    versionRange.bufferRange = BufferRange(0u, 64u);
    GpuGraphResourceVersionDesc versionDesc = GpuGraphResourceVersionDesc();
    versionDesc.setResource(buffer);
    versionDesc.setRange(versionRange);
    versionDesc.setOrigin(origin);
    const auto versionResult = graph.declareResourceVersion(versionDesc);
    ASSERT_TRUE(versionResult.has_value());
    const GpuGraphResourceVersionId version = versionResult.value();
    ASSERT_TRUE(version.valid());

    const b8 produced = origin == GpuGraphResourceVersionOrigin::TaskProduced;
    GpuTaskId previous = GpuTaskId();
    for(usize index = 0u; index < taskCount; ++index){
        FixedVector<GpuTaskResourceUse, 1> physicalUses = FixedVector<GpuTaskResourceUse, 1>();
        FixedVector<GpuTaskResourceVersionUse, 1> versionUses = FixedVector<GpuTaskResourceVersionUse, 1>();
        const b8 usesVersion = index == 0u || (produced && index == 1u);
        const b8 writesVersion = produced && index == 0u;
        if(usesVersion){
            GpuTaskResourceUse physicalUse = GpuTaskResourceUse();
            physicalUse.resource = buffer;
            physicalUse.range = versionRange;
            if(writesVersion){
                physicalUse.requiredState = ResourceStates::UnorderedAccess;
                physicalUse.access = GpuTaskResourceAccess::Write;
            }
            else{
                physicalUse.requiredState = ResourceStates::ShaderResource;
                physicalUse.access = GpuTaskResourceAccess::Read;
            }
            physicalUses.push_back(physicalUse);

            GpuTaskResourceVersionUse versionUse = GpuTaskResourceVersionUse();
            versionUse.version = version;
            if(writesVersion)
                versionUse.role = GpuTaskResourceVersionRole::Produce;
            else
                versionUse.role = GpuTaskResourceVersionRole::Consume;
            versionUses.push_back(versionUse);
        }
        else if((disjointClobber || overlappingClobber) && index + 1u == taskCount){
            GpuTaskResourceUse physicalUse = GpuTaskResourceUse();
            physicalUse.resource = buffer;
            u64 offset = 0u;
            if(disjointClobber)
                offset = 128u;
            physicalUse.range.bufferRange = BufferRange(offset, 64u);
            physicalUse.requiredState = ResourceStates::UnorderedAccess;
            physicalUse.access = GpuTaskResourceAccess::Write;
            physicalUses.push_back(physicalUse);
        }

        GpuTaskDesc desc = GpuTaskDesc();
        const auto derivedNameResult = IndexedName(s_GpuCaseAnalysisOptimizationVersionTask, index);
        ASSERT_TRUE(derivedNameResult.has_value());
        desc.setIdentity(derivedNameResult.value());
        desc.setMarkerLabel("Analysis Version Task");
        FixedVector<GpuTaskId, 1> deps = FixedVector<GpuTaskId, 1>();
        if(previous.valid()){
            deps.push_back(previous);
            desc.setDependencies(deps);
        }
        if(!physicalUses.empty())
            desc.setResourceUses(physicalUses);
        if(!versionUses.empty())
            desc.setResourceVersionUses(versionUses);

        const auto previousTaskAdmission = graph.addTask(desc, ComputeCommands());
        ASSERT_TRUE(previousTaskAdmission.has_value());
        previous = previousTaskAdmission.value();
        ASSERT_TRUE(previous.valid());
    }
}

void VerifyGpuAnalysis_ResourceVersionsWithoutOverlappingClobbersPreserveStableOrder(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    Array<GpuResourceVersionOriginEnum, 2> origins = Array<GpuResourceVersionOriginEnum, 2>();
    origins[0u] = GpuGraphResourceVersionOrigin::ImportedRoot;
    origins[1u] = GpuGraphResourceVersionOrigin::TaskProduced;
    for(in GpuResourceVersionOriginEnum origin : origins){
        const ScopedTestTrace trace = ScopedTestTrace(origin);
        TestArena testArena = TestArena();
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        GpuAnalysis_BuildVersionChain(graph, origin, 8u, true, false);
        ASSERT_FALSE(GpuAnalysis_HasFatalFailure());

        GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
        ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
        ASSERT_EQ(analysis.topologicalOrder().size(), 8u);
        usize expectedVersionEdges = 0u;
        if(origin == GpuGraphResourceVersionOrigin::TaskProduced)
            expectedVersionEdges = 1u;
        EXPECT_EQ(analysis.resourceVersionEdgeCount(), expectedVersionEdges);
        for(usize index = 0u; index < analysis.topologicalOrder().size(); ++index)
            EXPECT_EQ(analysis.topologicalOrder()[index].index, index);
        for(in GpuTaskDependencyEdge edge : analysis.inferredEdges())
            EXPECT_NE(edge.hazard, GpuTaskHazardType::VersionLifetime);
    }
}

void VerifyGpuAnalysis_VersionLifetimeConstraintsDoNotInventProducedVersionOrder(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    Array<b8, 2> reversedDeclarations = Array<b8, 2>();
    reversedDeclarations[0u] = false;
    reversedDeclarations[1u] = true;
    for(in b8 reversed : reversedDeclarations){
        const ScopedTestTrace trace = ScopedTestTrace(reversed);
        TestArena testArena = TestArena();
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        const auto bufferResult = AddBufferMetadata(graph, s_GpuCaseAnalysisOptimizationAmbiguousVersionBuffer, "Ambiguous Version Buffer");
        ASSERT_TRUE(bufferResult.has_value());
        const GpuGraphResourceId buffer = bufferResult.value();
        ASSERT_TRUE(buffer.valid());

        GpuTaskResourceRange range = GpuTaskResourceRange();
        range.bufferRange = BufferRange(0u, 64u);
        Array<GpuGraphResourceVersionId, 2> versions = Array<GpuGraphResourceVersionId, 2>();
        for(usize index = 0u; index < versions.size(); ++index){
            GpuGraphResourceVersionDesc versionDesc = GpuGraphResourceVersionDesc();
            versionDesc.setResource(buffer);
            versionDesc.setRange(range);
            versionDesc.setOrigin(GpuGraphResourceVersionOrigin::TaskProduced);
            const auto versionTaskAdmission = graph.declareResourceVersion(versionDesc);
            ASSERT_TRUE(versionTaskAdmission.has_value());
            usize slot = index;
            if(reversed)
                slot = 1u - index;
            versions[slot] = versionTaskAdmission.value();
            ASSERT_TRUE(versions[slot].valid());
        }

        Array<GpuTaskId, 4> tasks = Array<GpuTaskId, 4>();
        for(usize index = 0u; index < tasks.size(); ++index){
            const b8 producer = index < versions.size();
            Array<GpuTaskResourceUse, 1> physicalUses = Array<GpuTaskResourceUse, 1>();
            physicalUses[0u].resource = buffer;
            physicalUses[0u].range = range;
            if(producer){
                physicalUses[0u].requiredState = ResourceStates::UnorderedAccess;
                physicalUses[0u].access = GpuTaskResourceAccess::Write;
            }
            else{
                physicalUses[0u].requiredState = ResourceStates::ShaderResource;
                physicalUses[0u].access = GpuTaskResourceAccess::Read;
            }

            Array<GpuTaskResourceVersionUse, 1> versionUses = Array<GpuTaskResourceVersionUse, 1>();
            versionUses[0u].version = versions[index % versions.size()];
            if(producer)
                versionUses[0u].role = GpuTaskResourceVersionRole::Produce;
            else
                versionUses[0u].role = GpuTaskResourceVersionRole::Consume;

            GpuTaskDesc desc = GpuTaskDesc();
            const auto resourceNameResult = IndexedName(s_GpuCaseAnalysisOptimizationAmbiguousVersionTask, index);
            ASSERT_TRUE(resourceNameResult.has_value());
            desc.setIdentity(resourceNameResult.value());
            desc.setMarkerLabel("Ambiguous Version Task");
            desc.setResourceUses(physicalUses);
            desc.setResourceVersionUses(versionUses);
            const auto taskAdmission = graph.addTask(desc, ComputeCommands());
            ASSERT_TRUE(taskAdmission.has_value());
            tasks[index] = taskAdmission.value();
            ASSERT_TRUE(tasks[index].valid());
        }

        GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
        EXPECT_FALSE(Analyze(graph, operationScratchArena, analysis));
        EXPECT_EQ(analysis.diagnostic().status, GpuTaskGraphAnalysisStatus::Cycle);
        usize lifetimeEdges = 0u;
        b8 protectsFirst = false;
        b8 protectsSecond = false;
        for(in GpuTaskDependencyEdge edge : analysis.inferredEdges()){
            if(edge.hazard != GpuTaskHazardType::VersionLifetime)
                continue;
            ++lifetimeEdges;
            if(edge.resourceVersion == versions[0u]){
                EXPECT_EQ(edge.producer, tasks[2u]);
                EXPECT_EQ(edge.consumer, tasks[1u]);
                protectsFirst = true;
            }
            else if(edge.resourceVersion == versions[1u]){
                EXPECT_EQ(edge.producer, tasks[3u]);
                EXPECT_EQ(edge.consumer, tasks[0u]);
                protectsSecond = true;
            }
        }
        EXPECT_EQ(lifetimeEdges, 2u);
        EXPECT_TRUE(protectsFirst);
        EXPECT_TRUE(protectsSecond);
    }
}

void VerifyGpuAnalysis_ResourceVersionPreBirthReachabilityHandlesFrozenSemanticCycles(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const auto buffersAdmission0 = AddBufferMetadata(graph, s_GpuCaseAnalysisOptimizationSemanticCycleBufferA, "Semantic Cycle Buffer A");
    const auto buffersAdmission1 = AddBufferMetadata(graph, s_GpuCaseAnalysisOptimizationSemanticCycleBufferB, "Semantic Cycle Buffer B");
    ASSERT_TRUE(buffersAdmission0.has_value());
    ASSERT_TRUE(buffersAdmission1.has_value());
    Array<GpuGraphResourceId, 2> buffers = Array<GpuGraphResourceId, 2>();
    buffers[0u] = buffersAdmission0.value();
    buffers[1u] = buffersAdmission1.value();

    GpuTaskResourceRange range = GpuTaskResourceRange();
    range.bufferRange = BufferRange(0u, 64u);
    Array<GpuGraphResourceVersionId, 2> versions = Array<GpuGraphResourceVersionId, 2>();
    for(usize index = 0u; index < versions.size(); ++index){
        ASSERT_TRUE(buffers[index].valid());
        GpuGraphResourceVersionDesc versionDesc = GpuGraphResourceVersionDesc();
        versionDesc.setResource(buffers[index]);
        versionDesc.setRange(range);
        versionDesc.setOrigin(GpuGraphResourceVersionOrigin::TaskProduced);
        const auto versionTaskAdmission = graph.declareResourceVersion(versionDesc);
        ASSERT_TRUE(versionTaskAdmission.has_value());
        versions[index] = versionTaskAdmission.value();
        ASSERT_TRUE(versions[index].valid());
    }

    Array<GpuTaskId, 5> tasks = Array<GpuTaskId, 5>();
    for(usize index = 0u; index < tasks.size(); ++index){
        FixedVector<GpuTaskResourceUse, 2> physicalUses = FixedVector<GpuTaskResourceUse, 2>();
        FixedVector<GpuTaskResourceVersionUse, 1> versionUses = FixedVector<GpuTaskResourceVersionUse, 1>();
        if(index != 1u){
            const b8 consumer = index == 4u;
            usize resourceIndex = 0u;
            if(index == 2u)
                resourceIndex = 1u;
            GpuTaskResourceUse firstUse = GpuTaskResourceUse();
            firstUse.resource = buffers[resourceIndex];
            firstUse.range = range;
            if(consumer){
                firstUse.requiredState = ResourceStates::ShaderResource;
                firstUse.access = GpuTaskResourceAccess::Read;
            }
            else{
                firstUse.requiredState = ResourceStates::UnorderedAccess;
                firstUse.access = GpuTaskResourceAccess::Write;
            }
            physicalUses.push_back(firstUse);

            GpuTaskResourceVersionUse versionUse = GpuTaskResourceVersionUse();
            usize versionSlot = resourceIndex;
            if(index == 0u)
                versionSlot = 1u;
            versionUse.version = versions[versionSlot];
            if(consumer || index == 0u)
                versionUse.role = GpuTaskResourceVersionRole::Consume;
            else
                versionUse.role = GpuTaskResourceVersionRole::Produce;
            versionUses.push_back(versionUse);

            if(index == 0u){
                GpuTaskResourceUse secondUse = GpuTaskResourceUse();
                secondUse.resource = buffers[1u];
                secondUse.range = range;
                secondUse.requiredState = ResourceStates::ShaderResource;
                secondUse.access = GpuTaskResourceAccess::Read;
                physicalUses.push_back(secondUse);
            }
        }

        GpuTaskDesc desc = GpuTaskDesc();
        const auto derivedNameResult = IndexedName(s_GpuCaseAnalysisOptimizationSemanticCycleTask, index);
        ASSERT_TRUE(derivedNameResult.has_value());
        desc.setIdentity(derivedNameResult.value());
        desc.setMarkerLabel("Semantic Cycle Task");
        FixedVector<GpuTaskId, 1> deps = FixedVector<GpuTaskId, 1>();
        if(index != 0u){
            deps.push_back(tasks[index - 1u]);
            desc.setDependencies(deps);
        }
        if(!physicalUses.empty()){
            desc.setResourceUses(physicalUses);
            desc.setResourceVersionUses(versionUses);
        }
        const auto taskAdmission = graph.addTask(desc, ComputeCommands());
        ASSERT_TRUE(taskAdmission.has_value());
        tasks[index] = taskAdmission.value();
        ASSERT_TRUE(tasks[index].valid());
    }

    ScratchArena scratchArena = ScratchArena(s_GpuCaseAnalysisOptimizationSemanticCycleScratch);
    Vector<GpuTaskDependencyEdge> edges = Vector<GpuTaskDependencyEdge>();
    b8 builtEdges = false;
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        native(in declarations, mut scratchArena, mut edges, mut builtEdges){
            Vector<Core::GpuTaskDependencyEdge, Core::Alloc::ScratchArena> rawEdges(scratchArena);
            builtEdges = Core::GpuTaskGraphCompilerDetail::BuildResourceVersionDependencyEdges(declarations, scratchArena, rawEdges).has_value();
            for(const Core::GpuTaskDependencyEdge& edge : rawEdges)
                edges.push_back(edge);
        }
    }
    ASSERT_TRUE(builtEdges);
    ASSERT_EQ(edges.size(), 2u);
    EXPECT_EQ(edges[0u].producer, tasks[2u]);
    EXPECT_EQ(edges[0u].consumer, tasks[0u]);
    EXPECT_EQ(edges[1u].producer, tasks[3u]);
    EXPECT_EQ(edges[1u].consumer, tasks[4u]);
    for(in GpuTaskDependencyEdge edge : edges)
        EXPECT_EQ(edge.hazard, GpuTaskHazardType::VersionDependency);

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    EXPECT_FALSE(Analyze(graph, scratchArena, analysis));
    EXPECT_EQ(analysis.diagnostic().status, GpuTaskGraphAnalysisStatus::Cycle);
}

void VerifyGpuAnalysis_VersionLifetimeEdgesPreserveDistinctTaskAndVersionOrder(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    Array<b8, 2> reversedDeclarations = Array<b8, 2>();
    reversedDeclarations[0u] = false;
    reversedDeclarations[1u] = true;
    for(in b8 reversed : reversedDeclarations){
        const ScopedTestTrace trace = ScopedTestTrace(reversed);
        TestArena testArena = TestArena();
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        const auto buffersAdmission0 = AddBufferMetadata(graph, s_GpuCaseAnalysisOptimizationLifetimeBufferA, "Lifetime Buffer A");
        const auto buffersAdmission1 = AddBufferMetadata(graph, s_GpuCaseAnalysisOptimizationLifetimeBufferB, "Lifetime Buffer B");
        ASSERT_TRUE(buffersAdmission0.has_value());
        ASSERT_TRUE(buffersAdmission1.has_value());
        Array<GpuGraphResourceId, 2> buffers = Array<GpuGraphResourceId, 2>();
        buffers[0u] = buffersAdmission0.value();
        buffers[1u] = buffersAdmission1.value();

        GpuTaskResourceRange range = GpuTaskResourceRange();
        range.bufferRange = BufferRange(0u, 64u);
        Array<GpuGraphResourceVersionId, 2> versions = Array<GpuGraphResourceVersionId, 2>();
        for(usize index = 0u; index < versions.size(); ++index){
            usize versionIndex = index;
            if(reversed)
                versionIndex = 1u - index;
            ASSERT_TRUE(buffers[versionIndex].valid());
            GpuGraphResourceVersionDesc versionDesc = GpuGraphResourceVersionDesc();
            versionDesc.setResource(buffers[versionIndex]);
            versionDesc.setRange(range);
            versionDesc.setOrigin(GpuGraphResourceVersionOrigin::TaskProduced);
            const auto versionTaskAdmission = graph.declareResourceVersion(versionDesc);
            ASSERT_TRUE(versionTaskAdmission.has_value());
            versions[versionIndex] = versionTaskAdmission.value();
            ASSERT_TRUE(versions[versionIndex].valid());
        }

        Array<GpuTaskId, 3> tasks = Array<GpuTaskId, 3>();
        for(usize index = 0u; index < tasks.size(); ++index){
            const b8 writer = index != 1u;
            GpuResourceStatesMask state = ResourceStates::ShaderResource;
            GpuResourceAccessEnum access = GpuTaskResourceAccess::Read;
            if(writer){
                state = ResourceStates::UnorderedAccess;
                access = GpuTaskResourceAccess::Write;
            }
            GpuTaskResourceRange subRange = GpuTaskResourceRange();
            subRange.bufferRange = BufferRange(16u, 32u);
            Array<GpuTaskResourceUse, 3> physicalUses = Array<GpuTaskResourceUse, 3>();
            physicalUses[0u].resource = buffers[0u];
            physicalUses[0u].range = range;
            physicalUses[0u].requiredState = state;
            physicalUses[0u].access = access;
            physicalUses[1u].resource = buffers[0u];
            physicalUses[1u].range = subRange;
            physicalUses[1u].requiredState = state;
            physicalUses[1u].access = access;
            physicalUses[2u].resource = buffers[1u];
            physicalUses[2u].range = range;
            physicalUses[2u].requiredState = state;
            physicalUses[2u].access = access;

            GpuResourceVersionRoleEnum role = GpuTaskResourceVersionRole::Consume;
            if(index == 0u)
                role = GpuTaskResourceVersionRole::Produce;
            Array<GpuTaskResourceVersionUse, 2> versionUses = Array<GpuTaskResourceVersionUse, 2>();
            versionUses[0u].version = versions[0u];
            versionUses[0u].role = role;
            versionUses[1u].version = versions[1u];
            versionUses[1u].role = role;

            GpuTaskDesc desc = GpuTaskDesc();
            const auto resourceNameResult = IndexedName(s_GpuCaseAnalysisOptimizationLifetimeTask, index);
            ASSERT_TRUE(resourceNameResult.has_value());
            desc.setIdentity(resourceNameResult.value());
            desc.setMarkerLabel("Lifetime Version Task");
            desc.setResourceUses(physicalUses);
            if(index != 2u)
                desc.setResourceVersionUses(versionUses);
            const auto taskAdmission = graph.addTask(desc, ComputeCommands());
            ASSERT_TRUE(taskAdmission.has_value());
            tasks[index] = taskAdmission.value();
            ASSERT_TRUE(tasks[index].valid());
        }

        ScratchArena scratchArena = ScratchArena(s_GpuCaseAnalysisOptimizationLifetimeEdgeScratch);
        Vector<GpuTaskDependencyEdge> edges = Vector<GpuTaskDependencyEdge>();
        b8 builtEdges = false;
        {
            const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
            native(in declarations, mut scratchArena, mut edges, mut builtEdges){
                Vector<Core::GpuTaskDependencyEdge, Core::Alloc::ScratchArena> rawEdges(scratchArena);
                builtEdges = Core::GpuTaskGraphCompilerDetail::BuildResourceVersionDependencyEdges(declarations, scratchArena, rawEdges).has_value();
                for(const Core::GpuTaskDependencyEdge& edge : rawEdges)
                    edges.push_back(edge);
            }
        }
        ASSERT_TRUE(builtEdges);
        ASSERT_EQ(edges.size(), 4u);
        for(usize index = 0u; index < versions.size(); ++index){
            EXPECT_EQ(edges[index].producer, tasks[0u]);
            EXPECT_EQ(edges[index].consumer, tasks[1u]);
            EXPECT_EQ(edges[index].resourceVersion, versions[index]);
            EXPECT_EQ(edges[index].hazard, GpuTaskHazardType::VersionDependency);
            usize versionIndex = index;
            if(reversed)
                versionIndex = 1u - index;
            const GpuTaskDependencyEdge lifetime = edges[index + versions.size()];
            EXPECT_EQ(lifetime.producer, tasks[1u]);
            EXPECT_EQ(lifetime.consumer, tasks[2u]);
            EXPECT_EQ(lifetime.resource, buffers[versionIndex]);
            EXPECT_EQ(lifetime.resourceVersion, versions[versionIndex]);
            EXPECT_EQ(lifetime.hazard, GpuTaskHazardType::VersionLifetime);
        }

        GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
        ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
        ASSERT_EQ(analysis.topologicalOrder().size(), tasks.size());
        for(usize index = 0u; index < tasks.size(); ++index)
            EXPECT_EQ(analysis.topologicalOrder()[index], tasks[index]);
    }
}

void VerifyGpuAnalysis_ReportsEarlierUncoveredVersionUseBeforeLaterDuplicate(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const auto bufferResult = AddBufferMetadata(graph, s_GpuCaseAnalysisOptimizationBindingFailureBuffer, "Version Binding Failure Buffer");
    ASSERT_TRUE(bufferResult.has_value());
    const GpuGraphResourceId buffer = bufferResult.value();
    ASSERT_TRUE(buffer.valid());

    Array<GpuTaskResourceVersionUse, 10> versionUses = Array<GpuTaskResourceVersionUse, 10>();
    for(usize index = 0u; index + 1u < versionUses.size(); ++index){
        u64 offset = 0u;
        if(index == 0u)
            offset = 128u;
        GpuTaskResourceRange range = GpuTaskResourceRange();
        range.bufferRange = BufferRange(offset, 64u);
        GpuGraphResourceVersionDesc versionDesc = GpuGraphResourceVersionDesc();
        versionDesc.setResource(buffer);
        versionDesc.setRange(range);
        versionDesc.setOrigin(GpuGraphResourceVersionOrigin::ImportedRoot);
        const auto versionResult = graph.declareResourceVersion(versionDesc);
        ASSERT_TRUE(versionResult.has_value());
        const GpuGraphResourceVersionId version = versionResult.value();
        ASSERT_TRUE(version.valid());
        versionUses[index].version = version;
        versionUses[index].role = GpuTaskResourceVersionRole::Consume;
    }
    versionUses[versionUses.size() - 1u] = versionUses[1u];

    Array<GpuTaskResourceUse, 1> physicalUses = Array<GpuTaskResourceUse, 1>();
    physicalUses[0u].resource = buffer;
    physicalUses[0u].range.bufferRange = BufferRange(0u, 64u);
    physicalUses[0u].requiredState = ResourceStates::ShaderResource;
    physicalUses[0u].access = GpuTaskResourceAccess::Read;

    GpuTaskDesc desc = GpuTaskDesc();
    desc.setIdentity(s_GpuCaseAnalysisOptimizationBindingFailureTask);
    desc.setMarkerLabel("Version Binding Failure Task");
    desc.setResourceUses(physicalUses);
    desc.setResourceVersionUses(versionUses);
    const auto taskResult = graph.addTask(desc, ComputeCommands());
    ASSERT_TRUE(taskResult.has_value());
    const GpuTaskId task = taskResult.value();
    ASSERT_TRUE(task.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    EXPECT_FALSE(Analyze(graph, operationScratchArena, analysis));
    EXPECT_EQ(analysis.diagnostic().status, GpuTaskGraphAnalysisStatus::InvalidResourceVersionUse);
    EXPECT_EQ(analysis.diagnostic().task, task);
    EXPECT_FALSE(analysis.diagnostic().relatedTask.valid());
    EXPECT_EQ(analysis.diagnostic().resource, buffer);
    EXPECT_EQ(analysis.diagnostic().resourceVersion, versionUses[0u].version);
}

Expected<GpuTaskId> GpuAnalysis_AddIndexedTask(
    mut GpuTaskGraph graph,
    in usize taskIndex,
    in Span<GpuTaskId> dependencies,
    in Span<GpuTaskResourceUse> resourceUses
){
    GpuTaskDesc desc = GpuTaskDesc();
    const auto resourceNameResult = IndexedName(s_GpuCaseTaskGraphAnalysisTask, taskIndex);
    if(!resourceNameResult.has_value())
        return MakeUnexpected(Failure());
    desc.setIdentity(resourceNameResult.value());
    desc.setMarkerLabel("Analysis Test Task");
    desc.setDependencies(dependencies);
    desc.setResourceUses(resourceUses);
    return graph.addTask(desc);
}

Expected<GpuTaskId> GpuAnalysis_AddIndexedTask(mut GpuTaskGraph graph, in usize taskIndex, in Span<GpuTaskId> dependencies){
    const Span<GpuTaskResourceUse> emptyUses = Span<GpuTaskResourceUse>();
    return GpuAnalysis_AddIndexedTask(graph, taskIndex, dependencies, emptyUses);
}

Expected<GpuTaskId> GpuAnalysis_AddIndexedTask(mut GpuTaskGraph graph, in usize taskIndex){
    const Span<GpuTaskId> emptyDeps = Span<GpuTaskId>();
    const Span<GpuTaskResourceUse> emptyUses = Span<GpuTaskResourceUse>();
    return GpuAnalysis_AddIndexedTask(graph, taskIndex, emptyDeps, emptyUses);
}

void GpuAnalysis_ExpectEdgeEqual(in GpuTaskDependencyEdge expected, in GpuTaskDependencyEdge actual){
    EXPECT_EQ(actual.producer, expected.producer);
    EXPECT_EQ(actual.consumer, expected.consumer);
    EXPECT_EQ(actual.resource, expected.resource);
    EXPECT_EQ(actual.resourceVersion, expected.resourceVersion);
    EXPECT_EQ(actual.hazard, expected.hazard);
}

void GpuAnalysis_ExpectDagAnalysis(
    in GpuTaskGraph graph,
    in Span<GpuTaskDependencyEdge> expectedEdges,
    mut ScratchArena scratchArena,
    mut GpuTaskGraphAnalysis analysis
){
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
    ASSERT_TRUE(declarations.valid());
    const GpuTaskGraphCompiler compiler = GpuTaskGraphCompiler();
    ASSERT_TRUE(compiler.analyze(declarations, scratchArena, analysis));
    ASSERT_TRUE(analysis.validFor(declarations));
    ASSERT_EQ(analysis.edges().size(), expectedEdges.size());
    for(usize edgeIndex = 0u; edgeIndex < expectedEdges.size(); ++edgeIndex)
        GpuAnalysis_ExpectEdgeEqual(expectedEdges[edgeIndex], analysis.edges()[edgeIndex]);

    const usize taskCount = declarations.taskCount();
    Vector<u8> adjacency = Vector<u8>();
    adjacency.resize(taskCount * taskCount, 0u);
    Vector<u8> reachable = Vector<u8>();
    reachable.resize(taskCount * taskCount, 0u);
    Vector<u32> indegrees = Vector<u32>();
    indegrees.resize(taskCount, 0u);
    Vector<u8> emitted = Vector<u8>();
    emitted.resize(taskCount, 0u);
    for(in GpuTaskDependencyEdge edge : expectedEdges){
        const usize matrixIndex = edge.producer.index * taskCount + edge.consumer.index;
        ASSERT_EQ(adjacency[matrixIndex], 0u);
        adjacency[matrixIndex] = 1u;
        reachable[matrixIndex] = 1u;
        ++indegrees[edge.consumer.index];
    }

    ASSERT_EQ(analysis.topologicalOrder().size(), taskCount);
    for(usize orderIndex = 0u; orderIndex < taskCount; ++orderIndex){
        usize nextTask = 0u;
        while(nextTask < taskCount && (emitted[nextTask] != 0u || indegrees[nextTask] != 0u))
            ++nextTask;
        ASSERT_LT(nextTask, taskCount);
        EXPECT_EQ(analysis.topologicalOrder()[orderIndex], declarations.taskAt(nextTask).id);
        emitted[nextTask] = 1u;
        for(usize consumer = 0u; consumer < taskCount; ++consumer){
            if(adjacency[nextTask * taskCount + consumer] != 0u)
                --indegrees[consumer];
        }
    }

    // A plain Floyd-Warshall matrix gives an independent reference for strict reachability and reduction.
    for(usize intermediate = 0u; intermediate < taskCount; ++intermediate){
        for(usize producer = 0u; producer < taskCount; ++producer){
            if(reachable[producer * taskCount + intermediate] == 0u)
                continue;
            for(usize consumer = 0u; consumer < taskCount; ++consumer){
                if(reachable[intermediate * taskCount + consumer] != 0u)
                    reachable[producer * taskCount + consumer] = 1u;
            }
        }
    }

    GpuTaskSchedulingReachability schedulingReachability = GpuTaskSchedulingReachability(scratchArena);
    b8 reachabilityBuilt = false;
    native(in declarations, in analysis, mut schedulingReachability, mut reachabilityBuilt){
        reachabilityBuilt = Core::GpuTaskGraphCompilerDetail::BuildGpuTaskSchedulingReachability(declarations, analysis, schedulingReachability);
    }
    ASSERT_TRUE(reachabilityBuilt);
    for(usize source = 0u; source < taskCount; ++source){
        for(usize destination = 0u; destination < taskCount; ++destination){
            const GpuTaskId sourceTask = declarations.taskAt(source).id;
            const GpuTaskId destinationTask = declarations.taskAt(destination).id;
            EXPECT_EQ(schedulingReachability.reaches(sourceTask, destinationTask), reachable[source * taskCount + destination] != 0u);
            EXPECT_EQ(
                schedulingReachability.transitivelyIndependent(sourceTask, destinationTask),
                source != destination && reachable[source * taskCount + destination] == 0u && reachable[destination * taskCount + source] == 0u
            );
        }
    }

    Vector<usize> reducedEdgeIndices = Vector<usize>();
    reducedEdgeIndices.reserve(expectedEdges.size());
    for(usize edgeIndex = 0u; edgeIndex < expectedEdges.size(); ++edgeIndex){
        const GpuTaskDependencyEdge edge = expectedEdges[edgeIndex];
        b8 redundant = false;
        for(usize intermediate = 0u; intermediate < taskCount; ++intermediate){
            if(adjacency[edge.producer.index * taskCount + intermediate] != 0u && reachable[intermediate * taskCount + edge.consumer.index] != 0u){
                redundant = true;
                break;
            }
        }
        if(!redundant)
            reducedEdgeIndices.push_back(edgeIndex);
    }
    ASSERT_EQ(analysis.schedulingEdges().size(), reducedEdgeIndices.size());
    for(usize edgeIndex = 0u; edgeIndex < reducedEdgeIndices.size(); ++edgeIndex)
        GpuAnalysis_ExpectEdgeEqual(expectedEdges[reducedEdgeIndices[edgeIndex]], analysis.schedulingEdges()[edgeIndex]);

    for(usize taskIndex = 0u; taskIndex < taskCount; ++taskIndex){
        const GpuTaskId task = declarations.taskAt(taskIndex).id;
        const GpuTaskGraphSchedulingTaskIndexView consumers = analysis.schedulingConsumers(task);
        const GpuTaskGraphSchedulingTaskIndexView producers = analysis.schedulingProducers(task);
        usize consumerOffset = 0u;
        usize producerOffset = 0u;
        for(in usize edgeIndex : reducedEdgeIndices){
            const GpuTaskDependencyEdge edge = expectedEdges[edgeIndex];
            if(edge.producer == task){
                ASSERT_LT(consumerOffset, consumers.taskCount);
                EXPECT_EQ(consumers[consumerOffset], edge.consumer.index);
                ++consumerOffset;
            }
            if(edge.consumer == task){
                ASSERT_LT(producerOffset, producers.taskCount);
                EXPECT_EQ(producers[producerOffset], edge.producer.index);
                ++producerOffset;
            }
        }
        EXPECT_EQ(consumers.taskCount, consumerOffset);
        EXPECT_EQ(producers.taskCount, producerOffset);
    }
}

void GpuAnalysis_DeclareShortcutChain(mut GpuTaskGraph graph, in usize taskCount, in b8 reversed){
    u64 generation = 0u;
    {
        const GpuTaskGraphDeclarationReadView view = GpuTaskGraphDeclarationReadView(graph);
        generation = view.generation();
    }
    for(usize declarationIndex = 0u; declarationIndex < taskCount; ++declarationIndex){
        usize chainIndex = declarationIndex;
        if(reversed)
            chainIndex = taskCount - declarationIndex - 1u;
        FixedVector<GpuTaskId, 2> dependencies = FixedVector<GpuTaskId, 2>();
        const usize dependencyCount = Min(chainIndex, cast<usize>(2u));
        for(usize offset = 0u; offset < dependencyCount; ++offset){
            const usize sourceIndex = chainIndex - offset - 1u;
            usize depTaskIndex = sourceIndex;
            if(reversed)
                depTaskIndex = taskCount - sourceIndex - 1u;
            dependencies.push_back(GpuAnalysis_MakeTaskId(generation, cast<u32>(depTaskIndex)));
        }
        const auto gpuTaskAdmission = GpuAnalysis_AddIndexedTask(graph, declarationIndex, dependencies);
        ASSERT_TRUE(gpuTaskAdmission.has_value());
        ASSERT_TRUE(gpuTaskAdmission.value().valid());
    }
}

void GpuAnalysis_ExpectReducedShortcutChain(in GpuTaskGraphAnalysis analysis, in usize taskCount, in b8 reversed){
    ASSERT_EQ(analysis.edges().size(), taskCount * 2u - 3u);
    ASSERT_EQ(analysis.schedulingEdges().size(), taskCount - 1u);
    for(usize edgeIndex = 0u; edgeIndex + 1u < taskCount; ++edgeIndex){
        const GpuTaskDependencyEdge edge = analysis.schedulingEdges()[edgeIndex];
        usize expectedProducer = edgeIndex;
        usize expectedConsumer = edgeIndex + 1u;
        if(reversed){
            expectedProducer = edgeIndex + 1u;
            expectedConsumer = edgeIndex;
        }
        EXPECT_EQ(edge.producer.index, expectedProducer);
        EXPECT_EQ(edge.consumer.index, expectedConsumer);
    }
}

void GpuAnalysis_DeclareReadyOrderGraph(mut GpuTaskGraph graph, in usize taskCount, in GpuAnalysisReadyOrderShape shape){
    u64 generation = 0u;
    {
        const GpuTaskGraphDeclarationReadView view = GpuTaskGraphDeclarationReadView(graph);
        generation = view.generation();
    }
    for(usize taskIndex = 0u; taskIndex < taskCount; ++taskIndex){
        const usize half = taskCount / 2u;
        b8 hasDependency = false;
        if(shape == GpuAnalysisReadyOrderShape::ReverseChain)
            hasDependency = taskIndex + 1u < taskCount;
        else if(shape == GpuAnalysisReadyOrderShape::ConsumerFirstPairs)
            hasDependency = taskIndex < half;
        else
            hasDependency = taskIndex >= half;

        usize producerIndex = 0u;
        if(hasDependency){
            if(shape == GpuAnalysisReadyOrderShape::ReverseChain)
                producerIndex = taskIndex + 1u;
            else if(shape == GpuAnalysisReadyOrderShape::ConsumerFirstPairs)
                producerIndex = taskIndex + half;
            else
                producerIndex = taskIndex - half;
        }
        FixedVector<GpuTaskId, 1> deps = FixedVector<GpuTaskId, 1>();
        if(hasDependency)
            deps.push_back(GpuAnalysis_MakeTaskId(generation, cast<u32>(producerIndex)));
        const auto secondGpuTaskAdmission = GpuAnalysis_AddIndexedTask(graph, taskIndex, deps);
        ASSERT_TRUE(secondGpuTaskAdmission.has_value());
        ASSERT_TRUE(secondGpuTaskAdmission.value().valid());
    }
}

void GpuAnalysis_ExpectReadyOrder(in GpuTaskGraphAnalysis analysis, in usize taskCount, in GpuAnalysisReadyOrderShape shape){
    ASSERT_EQ(analysis.topologicalOrder().size(), taskCount);
    for(usize index = 0u; index < taskCount; ++index){
        usize expected = index;
        if(shape == GpuAnalysisReadyOrderShape::ReverseChain){
            expected = taskCount - index - 1u;
        }
        else if(shape == GpuAnalysisReadyOrderShape::ConsumerFirstPairs){
            if(index % 2u == 0u)
                expected = taskCount / 2u + index / 2u;
            else
                expected = index / 2u;
        }
        EXPECT_EQ(analysis.topologicalOrder()[index].index, expected);
    }
}

void VerifyGpuAnalysis_PreservesLowestReadyIdAcrossRepeatedBackwardReleasesAndPartialIndexWords(){
    Array<usize, 2> counts = Array<usize, 2>();
    counts[0u] = 130u;
    counts[1u] = 8194u;
    Array<GpuAnalysisReadyOrderShape, 3> shapes = Array<GpuAnalysisReadyOrderShape, 3>();
    shapes[0u] = GpuAnalysisReadyOrderShape::ConsumerFirstPairs;
    shapes[1u] = GpuAnalysisReadyOrderShape::ProducerFirstPairs;
    shapes[2u] = GpuAnalysisReadyOrderShape::ReverseChain;
    for(in usize count : counts){
        for(in GpuAnalysisReadyOrderShape shape : shapes){
            const ScopedTestTrace traceCount = ScopedTestTrace(count);
            const ScopedTestTrace traceShape = ScopedTestTrace(cast<u32>(shape));
            GpuAnalysisTestArena testArena = GpuAnalysisTestArena();
            GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
            GpuAnalysis_DeclareReadyOrderGraph(graph, count, shape);
            ASSERT_FALSE(GpuAnalysis_HasFatalFailure());
            GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
            const GpuTaskGraphDeclarationReadView view = GpuTaskGraphDeclarationReadView(graph);
            ScratchArena scratch = ScratchArena(s_TaskGpuAnalysisScratch);
            const GpuTaskGraphCompiler compiler = GpuTaskGraphCompiler();
            ASSERT_TRUE(compiler.analyze(view, scratch, analysis));
            GpuAnalysis_ExpectReadyOrder(analysis, count, shape);
            ASSERT_FALSE(GpuAnalysis_HasFatalFailure());
        }
    }
}

void VerifyGpuAnalysis_RetainsCycleDiagnosticsAfterBackwardReleasePrefixExhaustsReadyWork(){
    const usize prefixCount = 130u;
    GpuAnalysisTestArena testArena = GpuAnalysisTestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuAnalysis_DeclareReadyOrderGraph(graph, prefixCount, GpuAnalysisReadyOrderShape::ConsumerFirstPairs);
    ASSERT_FALSE(GpuAnalysis_HasFatalFailure());
    u64 generation = 0u;
    {
        const GpuTaskGraphDeclarationReadView view = GpuTaskGraphDeclarationReadView(graph);
        generation = view.generation();
    }
    const GpuTaskId first = GpuAnalysis_MakeTaskId(generation, cast<u32>(prefixCount));
    const GpuTaskId second = GpuAnalysis_MakeTaskId(generation, cast<u32>(prefixCount + 1u));
    {
        Array<GpuTaskId, 1> deps = Array<GpuTaskId, 1>();
        deps[0u] = second;
        const auto gpuTaskAdmission = GpuAnalysis_AddIndexedTask(graph, prefixCount, deps);
        ASSERT_TRUE(gpuTaskAdmission.has_value());
        ASSERT_EQ(gpuTaskAdmission.value(), first);
    }
    {
        Array<GpuTaskId, 1> deps = Array<GpuTaskId, 1>();
        deps[0u] = first;
        const auto secondGpuTaskAdmission = GpuAnalysis_AddIndexedTask(graph, prefixCount + 1u, deps);
        ASSERT_TRUE(secondGpuTaskAdmission.has_value());
        ASSERT_EQ(secondGpuTaskAdmission.value(), second);
    }
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    const GpuTaskGraphDeclarationReadView view = GpuTaskGraphDeclarationReadView(graph);
    ScratchArena scratch = ScratchArena(s_TaskGpuAnalysisScratch);
    const GpuTaskGraphCompiler compiler = GpuTaskGraphCompiler();
    EXPECT_FALSE(compiler.analyze(view, scratch, analysis));
    EXPECT_EQ(analysis.diagnostic().status, GpuTaskGraphAnalysisStatus::Cycle);
    EXPECT_TRUE(analysis.topologicalOrder().empty());
    ASSERT_EQ(analysis.cyclePath().size(), 3u);
    EXPECT_EQ(analysis.cyclePath()[0u], first);
    EXPECT_EQ(analysis.cyclePath()[1u], second);
    EXPECT_EQ(analysis.cyclePath()[2u], first);
}

void VerifyGpuAnalysis_ReducesShortcutEdgesAtTheLastDirectConsumerBeforeLongTails(){
    const usize taskCount = 257u;
    Array<b8, 2> reversedDeclarations = Array<b8, 2>();
    reversedDeclarations[0u] = false;
    reversedDeclarations[1u] = true;
    for(in b8 reversed : reversedDeclarations){
        const ScopedTestTrace trace = ScopedTestTrace(reversed);
        GpuAnalysisTestArena testArena = GpuAnalysisTestArena();
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        GpuAnalysis_DeclareShortcutChain(graph, taskCount, reversed);
        ASSERT_FALSE(GpuAnalysis_HasFatalFailure());
        const GpuTaskGraphDeclarationReadView view = GpuTaskGraphDeclarationReadView(graph);
        ScratchArena scratch = ScratchArena(s_TaskGpuAnalysisScratch);
        const GpuTaskGraphCompiler compiler = GpuTaskGraphCompiler();
        GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
        ASSERT_TRUE(compiler.analyze(view, scratch, analysis));
        GpuAnalysis_ExpectReducedShortcutChain(analysis, taskCount, reversed);
        ASSERT_FALSE(GpuAnalysis_HasFatalFailure());
    }
}

void VerifyGpuAnalysis_MatchesIndependentReferenceForPermutedDagsAndDuplicateDependencies(){
    Array<usize, 12> taskCounts = Array<usize, 12>();
    taskCounts[0u] = 0u;
    taskCounts[1u] = 1u;
    taskCounts[2u] = 9u;
    taskCounts[3u] = 63u;
    taskCounts[4u] = 64u;
    taskCounts[5u] = 65u;
    taskCounts[6u] = 127u;
    taskCounts[7u] = 128u;
    taskCounts[8u] = 129u;
    taskCounts[9u] = 191u;
    taskCounts[10u] = 192u;
    taskCounts[11u] = 193u;
    Array<u32, 2> seeds = Array<u32, 2>();
    seeds[0u] = 17u;
    seeds[1u] = 91u;
    for(in usize taskCount : taskCounts){
        for(in u32 seed : seeds){
            const ScopedTestTrace traceCount = ScopedTestTrace(taskCount);
            const ScopedTestTrace traceSeed = ScopedTestTrace(seed);
            GpuAnalysisTestArena testArena = GpuAnalysisTestArena();
            ScratchArena scratchArena = ScratchArena(s_TaskGpuAnalysisScratch);
            GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
            u64 generation = 0u;
            {
                const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
                ASSERT_TRUE(declarations.valid());
                generation = declarations.generation();
            }

            Vector<usize> ranks = Vector<usize>();
            ranks.resize(taskCount, 0u);
            for(usize taskIndex = 0u; taskIndex < taskCount; ++taskIndex)
                ranks[taskIndex] = taskIndex;
            u32 randomState = seed;
            for(usize remaining = taskCount; remaining > 1u; --remaining){
                randomState = randomState * 1664525u + 1013904223u;
                const usize swapIndex = cast<usize>(randomState) % remaining;
                const usize temp = ranks[remaining - 1u];
                ranks[remaining - 1u] = ranks[swapIndex];
                ranks[swapIndex] = temp;
            }

            Vector<GpuTaskId> dependencies = Vector<GpuTaskId>();
            dependencies.reserve(taskCount * 2u);
            Vector<GpuTaskDependencyEdge> expectedEdges = Vector<GpuTaskDependencyEdge>();
            expectedEdges.reserve(taskCount * taskCount / 2u);
            for(usize consumerIndex = 0u; consumerIndex < taskCount; ++consumerIndex){
                dependencies.clear();
                // Reverse producer declaration order deliberately differs from the shuffled topological order.
                for(usize remaining = taskCount; remaining > 0u; --remaining){
                    const usize producerIndex = remaining - 1u;
                    randomState = randomState * 1664525u + 1013904223u;
                    if(ranks[producerIndex] >= ranks[consumerIndex] || (randomState >> 24u) % 5u != 0u)
                        continue;
                    const GpuTaskId producer = GpuAnalysis_MakeTaskId(generation, cast<u32>(producerIndex));
                    dependencies.push_back(producer);
                    dependencies.push_back(producer);
                    expectedEdges.push_back(GpuAnalysis_MakeEdge(
                        producer,
                        GpuAnalysis_MakeTaskId(generation, cast<u32>(consumerIndex)),
                        GpuGraphResourceId(),
                        GpuGraphResourceVersionId(),
                        GpuTaskHazardType::Explicit
                    ));
                }
                const auto taskResult = GpuAnalysis_AddIndexedTask(graph, consumerIndex, dependencies);
                ASSERT_TRUE(taskResult.has_value());
                const GpuTaskId task = taskResult.value();
                ASSERT_TRUE(task.valid());
                EXPECT_EQ(task.index, consumerIndex);
                EXPECT_EQ(task.generation, generation);
            }

            GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
            GpuAnalysis_ExpectDagAnalysis(graph, expectedEdges, scratchArena, analysis);
            ASSERT_FALSE(GpuAnalysis_HasFatalFailure());
            EXPECT_EQ(analysis.explicitEdgeCount(), expectedEdges.size());
            EXPECT_EQ(analysis.inferredEdgeCount(), 0u);
            EXPECT_TRUE(analysis.inferredEdges().empty());
        }
    }
}

void GpuAnalysis_RunInferredReasonPromotion(mut GpuAnalysisTestArena testArena, mut ScratchArena scratchArena){
    GpuAnalysisEdgeGraphicsVector edges = GpuAnalysisEdgeGraphicsVector(testArena.arena);
    GpuAnalysisEdgeGraphicsVector inferred = GpuAnalysisEdgeGraphicsVector(testArena.arena);
    usize explicitCount = 0u;
    usize inferredCount = 0u;
    usize versionCount = 0u;
    GpuInferredDependencyCollector collector = GpuInferredDependencyCollector(
        scratchArena,
        edges,
        inferred,
        explicitCount,
        inferredCount,
        versionCount
    );
    collector.reserve(20u);
    GpuTaskDependencyEdge edge = GpuTaskDependencyEdge();
    edge.producer = GpuAnalysis_MakeTaskId(1u, 0u);
    edge.consumer = GpuAnalysis_MakeTaskId(1u, 1u);
    edge.hazard = GpuTaskHazardType::ReadAfterWrite;
    for(u32 index = 0u; index < 10u; ++index){
        edge.resource = GpuAnalysis_MakeResourceId(1u, index);
        collector.appendInferred(edge);
    }
    for(u32 index = 0u; index < 10u; ++index){
        edge.resource = GpuAnalysis_MakeResourceId(1u, index);
        collector.appendInferred(edge);
    }
    ASSERT_EQ(inferred.size(), 10u);
    ASSERT_EQ(edges.size(), 1u);
    EXPECT_EQ(inferredCount, 1u);
    EXPECT_EQ(versionCount, 0u);
    edge.resource = GpuGraphResourceId();
    edge.hazard = GpuTaskHazardType::Explicit;
    collector.appendRaw(edge);
    EXPECT_EQ(edges.size(), 1u);
    EXPECT_EQ(edges[0u].hazard, GpuTaskHazardType::Explicit);
    EXPECT_EQ(explicitCount, 1u);
}

void VerifyGpuAnalysis_InferredReasonPromotionKeepsPriorReasonsAndExplicitPriority(){
    GpuAnalysisTestArena testArena = GpuAnalysisTestArena();
    ScratchArena scratchArena = ScratchArena(s_TaskGpuAnalysisScratch);
    GpuAnalysis_RunInferredReasonPromotion(testArena, scratchArena);
}

void VerifyGpuAnalysis_DeduplicatesHazardReasonsAndPreservesExplicitRawEdgePriority(){
    GpuAnalysisTestArena testArena = GpuAnalysisTestArena();
    ScratchArena scratchArena = ScratchArena(s_TaskGpuAnalysisScratch);
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    Array<GpuGraphResourceId, 3> resources = Array<GpuGraphResourceId, 3>();
    for(usize resourceIndex = 0u; resourceIndex < resources.size(); ++resourceIndex){
        const auto resourceNameResult = IndexedName(s_GpuCaseTaskGraphAnalysisResource, resourceIndex);
        ASSERT_TRUE(resourceNameResult.has_value());
        const auto resourceTaskAdmission = AddHazardDomain(graph, resourceNameResult.value(), "Analysis Hazard Domain");
        ASSERT_TRUE(resourceTaskAdmission.has_value());
        resources[resourceIndex] = resourceTaskAdmission.value();
        ASSERT_TRUE(resources[resourceIndex].valid());
    }

    Array<GpuTaskId, 3> tasks = Array<GpuTaskId, 3>();
    Array<GpuResourceAccessEnum, 9> accesses = Array<GpuResourceAccessEnum, 9>();
    accesses[0u] = GpuTaskResourceAccess::ReadWrite;
    accesses[1u] = GpuTaskResourceAccess::Read;
    accesses[2u] = GpuTaskResourceAccess::Write;
    accesses[3u] = GpuTaskResourceAccess::ReadWrite;
    accesses[4u] = GpuTaskResourceAccess::Write;
    accesses[5u] = GpuTaskResourceAccess::Read;
    accesses[6u] = GpuTaskResourceAccess::Read;
    accesses[7u] = GpuTaskResourceAccess::Read;
    accesses[8u] = GpuTaskResourceAccess::Read;

    for(usize taskIndex = 0u; taskIndex < tasks.size(); ++taskIndex){
        usize resourceCount = 3u;
        if(taskIndex == 1u)
            resourceCount = 2u;
        FixedVector<GpuTaskResourceUse, 6> uses = FixedVector<GpuTaskResourceUse, 6>();
        for(usize resourceIndex = 0u; resourceIndex < resourceCount; ++resourceIndex){
            GpuTaskResourceUse use = GpuTaskResourceUse();
            use.resource = resources[resourceIndex];
            use.requiredState = ResourceStates::UnorderedAccess;
            use.access = accesses[taskIndex * 3u + resourceIndex];
            uses.push_back(use);
            uses.push_back(use);
        }
        FixedVector<GpuTaskId, 2> dependencies = FixedVector<GpuTaskId, 2>();
        if(taskIndex == 1u){
            dependencies.push_back(tasks[0u]);
            dependencies.push_back(tasks[0u]);
        }
        const auto taskAdmission = GpuAnalysis_AddIndexedTask(graph, taskIndex, dependencies, uses);
        ASSERT_TRUE(taskAdmission.has_value());
        tasks[taskIndex] = taskAdmission.value();
        ASSERT_TRUE(tasks[taskIndex].valid());
    }

    Vector<GpuTaskDependencyEdge> expectedEdges = Vector<GpuTaskDependencyEdge>();
    expectedEdges.reserve(3u);
    expectedEdges.push_back(GpuAnalysis_MakeEdge(tasks[0u], tasks[1u], GpuGraphResourceId(), GpuGraphResourceVersionId(), GpuTaskHazardType::Explicit));
    expectedEdges.push_back(GpuAnalysis_MakeEdge(tasks[1u], tasks[2u], resources[0u], GpuGraphResourceVersionId(), GpuTaskHazardType::ReadAfterWrite));
    expectedEdges.push_back(GpuAnalysis_MakeEdge(tasks[0u], tasks[2u], resources[2u], GpuGraphResourceVersionId(), GpuTaskHazardType::ReadAfterWrite));

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuAnalysis_ExpectDagAnalysis(graph, expectedEdges, scratchArena, analysis);
    ASSERT_FALSE(GpuAnalysis_HasFatalFailure());
    EXPECT_EQ(analysis.explicitEdgeCount(), 1u);
    EXPECT_EQ(analysis.inferredEdgeCount(), 3u);
    EXPECT_EQ(analysis.resourceVersionEdgeCount(), 0u);

    Array<GpuTaskDependencyEdge, 6> expectedInferred = Array<GpuTaskDependencyEdge, 6>();
    expectedInferred[0u] = GpuAnalysis_MakeEdge(tasks[0u], tasks[1u], resources[0u], GpuGraphResourceVersionId(), GpuTaskHazardType::ReadAfterWrite);
    expectedInferred[1u] = GpuAnalysis_MakeEdge(tasks[0u], tasks[1u], resources[0u], GpuGraphResourceVersionId(), GpuTaskHazardType::WriteAfterWrite);
    expectedInferred[2u] = GpuAnalysis_MakeEdge(tasks[0u], tasks[1u], resources[1u], GpuGraphResourceVersionId(), GpuTaskHazardType::WriteAfterRead);
    expectedInferred[3u] = GpuAnalysis_MakeEdge(tasks[1u], tasks[2u], resources[0u], GpuGraphResourceVersionId(), GpuTaskHazardType::ReadAfterWrite);
    expectedInferred[4u] = GpuAnalysis_MakeEdge(tasks[1u], tasks[2u], resources[1u], GpuGraphResourceVersionId(), GpuTaskHazardType::ReadAfterWrite);
    expectedInferred[5u] = GpuAnalysis_MakeEdge(tasks[0u], tasks[2u], resources[2u], GpuGraphResourceVersionId(), GpuTaskHazardType::ReadAfterWrite);
    ASSERT_EQ(analysis.inferredEdges().size(), expectedInferred.size());
    for(usize edgeIndex = 0u; edgeIndex < expectedInferred.size(); ++edgeIndex)
        GpuAnalysis_ExpectEdgeEqual(expectedInferred[edgeIndex], analysis.inferredEdges()[edgeIndex]);
}

void VerifyGpuAnalysis_EmptySchedulingReachabilityAvoidsStorageAndResetsAcrossDependencyGraphs(){
    const usize taskCount = 65u;
    GpuAnalysisTestArena testArena = GpuAnalysisTestArena();
    ScratchArena analysisScratchArena = ScratchArena(s_TaskGpuAnalysisScratch);
    ScratchArena reachabilityScratchArena = ScratchArena(s_GpuCaseTaskGpuEdgefreeReachability);
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    Array<GpuTaskId, 65> tasks = Array<GpuTaskId, 65>();
    for(usize taskIndex = 0u; taskIndex < taskCount; ++taskIndex){
        const auto taskAdmission = GpuAnalysis_AddIndexedTask(graph, taskIndex);
        ASSERT_TRUE(taskAdmission.has_value());
        tasks[taskIndex] = taskAdmission.value();
        ASSERT_TRUE(tasks[taskIndex].valid());
    }
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    const GpuTaskGraphCompiler compiler = GpuTaskGraphCompiler();
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        ASSERT_TRUE(compiler.analyze(declarations, analysisScratchArena, analysis));
        ASSERT_TRUE(analysis.schedulingEdges().empty());
    }

    GpuTaskSchedulingReachability reachability = GpuTaskSchedulingReachability(reachabilityScratchArena);
    EXPECT_FALSE(reachability.reaches(tasks[0u], tasks[taskCount - 1u]));
    EXPECT_FALSE(reachability.transitivelyIndependent(tasks[0u], tasks[taskCount - 1u]));
    const ArenaMemoryStats before = reachabilityScratchArena.memoryStats();
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        b8 built = false;
        native(in declarations, in analysis, mut reachability, mut built){
            built = Core::GpuTaskGraphCompilerDetail::BuildGpuTaskSchedulingReachability(declarations, analysis, reachability);
        }
        ASSERT_TRUE(built);
    }
    const ArenaMemoryStats after = reachabilityScratchArena.memoryStats();
    EXPECT_EQ(after.allocationCount, before.allocationCount);
    EXPECT_EQ(after.reallocationCount, before.reallocationCount);
    EXPECT_EQ(after.deallocationCount, before.deallocationCount);
    EXPECT_EQ(after.reservedBytes, before.reservedBytes);
    EXPECT_EQ(after.usedBytes, before.usedBytes);
    EXPECT_EQ(after.peakUsedBytes, before.peakUsedBytes);

    for(in GpuTaskId source : tasks){
        for(in GpuTaskId destination : tasks){
            EXPECT_FALSE(reachability.reaches(source, destination));
            EXPECT_EQ(reachability.transitivelyIndependent(source, destination), source != destination);
        }
    }
    Array<GpuTaskId, 3> invalidTasks = Array<GpuTaskId, 3>();
    invalidTasks[0u] = GpuTaskId();
    invalidTasks[1u] = GpuAnalysis_MakeTaskId(tasks[0u].generation + 1u, tasks[0u].index);
    invalidTasks[2u] = GpuAnalysis_MakeTaskId(tasks[0u].generation, cast<u32>(taskCount));
    for(in GpuTaskId invalid : invalidTasks){
        EXPECT_FALSE(reachability.reaches(tasks[0u], invalid));
        EXPECT_FALSE(reachability.reaches(invalid, tasks[0u]));
        EXPECT_FALSE(reachability.transitivelyIndependent(tasks[0u], invalid));
        EXPECT_FALSE(reachability.transitivelyIndependent(invalid, tasks[0u]));
    }

    GpuTaskGraph dependentGraph = GpuTaskGraph(testArena.arena);
    const auto producerResult = GpuAnalysis_AddIndexedTask(dependentGraph, 0u);
    ASSERT_TRUE(producerResult.has_value());
    const GpuTaskId producer = producerResult.value();
    Array<GpuTaskId, 1> producerDeps = Array<GpuTaskId, 1>();
    producerDeps[0u] = producer;
    const auto consumerResult = GpuAnalysis_AddIndexedTask(dependentGraph, 1u, producerDeps);
    ASSERT_TRUE(consumerResult.has_value());
    const GpuTaskId consumer = consumerResult.value();
    const auto independentResult = GpuAnalysis_AddIndexedTask(dependentGraph, 2u);
    ASSERT_TRUE(independentResult.has_value());
    const GpuTaskId independent = independentResult.value();
    ASSERT_TRUE(producer.valid());
    ASSERT_TRUE(consumer.valid());
    ASSERT_TRUE(independent.valid());

    GpuTaskGraphAnalysis dependentAnalysis = GpuTaskGraphAnalysis(testArena.arena);
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(dependentGraph);
        ASSERT_TRUE(compiler.analyze(declarations, analysisScratchArena, dependentAnalysis));
        ASSERT_FALSE(dependentAnalysis.schedulingEdges().empty());
        b8 built = false;
        native(in declarations, in dependentAnalysis, mut reachability, mut built){
            built = Core::GpuTaskGraphCompilerDetail::BuildGpuTaskSchedulingReachability(declarations, dependentAnalysis, reachability);
        }
        ASSERT_TRUE(built);
    }
    EXPECT_TRUE(reachability.reaches(producer, consumer));
    EXPECT_FALSE(reachability.reaches(consumer, producer));
    EXPECT_FALSE(reachability.transitivelyIndependent(producer, consumer));
    EXPECT_TRUE(reachability.transitivelyIndependent(producer, independent));
    EXPECT_GT(reachabilityScratchArena.memoryStats().allocationCount, after.allocationCount);
    EXPECT_FALSE(reachability.reaches(tasks[0u], tasks[taskCount - 1u]));
    EXPECT_FALSE(reachability.transitivelyIndependent(tasks[0u], tasks[taskCount - 1u]));

    const ArenaMemoryStats beforeReuse = reachabilityScratchArena.memoryStats();
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        b8 built = false;
        native(in declarations, in analysis, mut reachability, mut built){
            built = Core::GpuTaskGraphCompilerDetail::BuildGpuTaskSchedulingReachability(declarations, analysis, reachability);
        }
        ASSERT_TRUE(built);
    }
    EXPECT_EQ(reachabilityScratchArena.memoryStats().allocationCount, beforeReuse.allocationCount);
    EXPECT_FALSE(reachability.reaches(tasks[0u], tasks[taskCount - 1u]));
    EXPECT_TRUE(reachability.transitivelyIndependent(tasks[0u], tasks[taskCount - 1u]));
    EXPECT_FALSE(reachability.transitivelyIndependent(tasks[0u], tasks[0u]));
    EXPECT_FALSE(reachability.reaches(producer, consumer));
    EXPECT_FALSE(reachability.transitivelyIndependent(producer, independent));
}

void VerifyGpuAnalysis_PreservesDiagnosticsForSingleLegalClassAndIndependentMergeGroup(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
    scheduling.cost = GpuTaskCostHint::Large;
    const Span<GpuTaskId> emptyDeps = Span<GpuTaskId>();
    const auto graphicsResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphAutomaticDiagnosticsGraphics,
        "Automatic Diagnostics Graphics",
        GraphicsCommands(),
        scheduling,
        GpuTaskTimingMetadata(),
        emptyDeps,
        graph
    );
    ASSERT_TRUE(graphicsResult.has_value());
    const GpuTaskId graphics = graphicsResult.value();
    ASSERT_TRUE(graphics.valid());
    const auto firstComputeResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphAutomaticDiagnosticsFirstCompute,
        "Automatic Diagnostics First Compute",
        ComputeCommands(),
        scheduling,
        GpuTaskTimingMetadata(),
        emptyDeps,
        graph
    );
    ASSERT_TRUE(firstComputeResult.has_value());
    const GpuTaskId firstCompute = firstComputeResult.value();
    ASSERT_TRUE(firstCompute.valid());
    scheduling.mergeWithPrevious = true;
    const auto secondComputeResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphAutomaticDiagnosticsSecondCompute,
        "Automatic Diagnostics Second Compute",
        ComputeCommands(),
        scheduling,
        GpuTaskTimingMetadata(),
        emptyDeps,
        graph
    );
    ASSERT_TRUE(secondComputeResult.has_value());
    const GpuTaskId secondCompute = secondComputeResult.value();
    ASSERT_TRUE(secondCompute.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    ASSERT_TRUE(analysis.schedulingEdges().empty());

    const GpuPhysicalQueueInfo graphicsQueue = GraphicsQueue();
    const GpuPhysicalQueueInfo computeQueue = DedicatedComputeQueue();
    GpuTaskQueueLoad queueLoad = GpuTaskQueueLoad();
    queueLoad.queue = graphicsQueue.id;
    queueLoad.estimatedCost = 13u;
    GpuTaskGraphQueueAssignmentOptions options = GpuTaskGraphQueueAssignmentOptions();
    native(in queueLoad, mut options){
        options.queueLoads = &queueLoad;
        options.queueLoadCount = 1u;
    }

    Array<GpuTaskId, 3> tasks = Array<GpuTaskId, 3>();
    tasks[0u] = graphics;
    tasks[1u] = firstCompute;
    tasks[2u] = secondCompute;
    for(usize orderIndex = 0u; orderIndex < 2u; ++orderIndex){
        Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
        if(orderIndex == 0u){
            queues[0u] = graphicsQueue;
            queues[1u] = computeQueue;
        }
        else{
            queues[0u] = computeQueue;
            queues[1u] = graphicsQueue;
        }
        const GpuPhysicalQueueTopology topology = GpuAnalysis_MakeTopology(queues);
        GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
        ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology, options));
        for(in GpuTaskId task : tasks){
            const Optional<GpuTaskQueueAssignment> assignment = GpuAnalysis_FindQueueAssignment(assignments, task);
            ASSERT_TRUE(assignment.has_value());
            GpuPhysicalQueueId expectedId = computeQueue.id;
            if(task == graphics)
                expectedId = graphicsQueue.id;
            EXPECT_EQ(assignment.value().queue, expectedId);
        }
    }
}

void VerifyGpuAnalysis_ExtendsMergedGroupAfterLegalityWitnessFallsBackToGraphics(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
    scheduling.cost = GpuTaskCostHint::Large;
    const Span<GpuTaskId> emptyDeps = Span<GpuTaskId>();
    const auto firstResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphAutomaticWitnessCompute,
        "Automatic Witness Compute",
        ComputeCommands(),
        scheduling,
        GpuTaskTimingMetadata(),
        emptyDeps,
        graph
    );
    ASSERT_TRUE(firstResult.has_value());
    const GpuTaskId first = firstResult.value();
    ASSERT_TRUE(first.valid());

    scheduling.mergeWithPrevious = true;
    GpuTaskCommandRequirements primaryGraphicsCommands = GpuTaskCommandRequirements();
    primaryGraphicsCommands.requiredCapabilities = GpuQueueCapability::Graphics;
    primaryGraphicsCommands.requiresPrimaryGraphicsQueue = true;
    Array<GpuTaskId, 1> firstDeps = Array<GpuTaskId, 1>();
    firstDeps[0u] = first;
    const auto graphicsResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphAutomaticWitnessGraphics,
        "Automatic Witness Graphics",
        primaryGraphicsCommands,
        scheduling,
        GpuTaskTimingMetadata(),
        firstDeps,
        graph
    );
    ASSERT_TRUE(graphicsResult.has_value());
    const GpuTaskId graphics = graphicsResult.value();
    ASSERT_TRUE(graphics.valid());

    Array<GpuTaskId, 1> graphicsDeps = Array<GpuTaskId, 1>();
    graphicsDeps[0u] = graphics;
    const auto lastResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphAutomaticWitnessFinalCompute,
        "Automatic Witness Final Compute",
        ComputeCommands(),
        scheduling,
        GpuTaskTimingMetadata(),
        graphicsDeps,
        graph
    );
    ASSERT_TRUE(lastResult.has_value());
    const GpuTaskId last = lastResult.value();
    ASSERT_TRUE(last.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    const GpuPhysicalQueueInfo graphicsQueue = GraphicsQueue(7u);
    const GpuPhysicalQueueInfo computeQueue = DedicatedComputeQueue(0u);
    Array<GpuTaskId, 3> tasks = Array<GpuTaskId, 3>();
    tasks[0u] = first;
    tasks[1u] = graphics;
    tasks[2u] = last;
    for(usize orderIndex = 0u; orderIndex < 2u; ++orderIndex){
        Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
        if(orderIndex == 0u){
            queues[0u] = computeQueue;
            queues[1u] = graphicsQueue;
        }
        else{
            queues[0u] = graphicsQueue;
            queues[1u] = computeQueue;
        }
        const GpuPhysicalQueueTopology topology = GpuAnalysis_MakeTopology(queues);
        GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
        ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology));
        for(in GpuTaskId task : tasks){
            const Optional<GpuTaskQueueAssignment> assignment = GpuAnalysis_FindQueueAssignment(assignments, task);
            ASSERT_TRUE(assignment.has_value());
            EXPECT_EQ(assignment.value().queue, graphicsQueue.id);
        }
    }
}

void VerifyGpuAnalysis_SplitsMergedGroupForDisjointExternalQueueContracts(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
    scheduling.cost = GpuTaskCostHint::Large;
    GpuTaskCommandRequirements commands = ComputeCommands();
    commands.externalQueue = queues[1u].id;
    const Span<GpuTaskId> emptyDeps = Span<GpuTaskId>();
    const auto firstResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphAutomaticWitnessExternalCompute,
        "Automatic Witness External Compute",
        commands,
        scheduling,
        GpuTaskTimingMetadata(),
        emptyDeps,
        graph
    );
    ASSERT_TRUE(firstResult.has_value());
    const GpuTaskId first = firstResult.value();
    ASSERT_TRUE(first.valid());

    scheduling.mergeWithPrevious = true;
    commands.externalQueue = queues[0u].id;
    Array<GpuTaskId, 1> firstDeps = Array<GpuTaskId, 1>();
    firstDeps[0u] = first;
    const auto secondResult = AddTaskWithCommands(
        s_GpuCaseTaskGraphAutomaticWitnessExternalGraphics,
        "Automatic Witness External Graphics",
        commands,
        scheduling,
        GpuTaskTimingMetadata(),
        firstDeps,
        graph
    );
    ASSERT_TRUE(secondResult.has_value());
    const GpuTaskId second = secondResult.value();
    ASSERT_TRUE(second.valid());

    const GpuPhysicalQueueTopology topology = GpuAnalysis_MakeTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology));
    const Optional<GpuTaskQueueAssignment> firstAssignment = GpuAnalysis_FindQueueAssignment(assignments, first);
    const Optional<GpuTaskQueueAssignment> secondAssignment = GpuAnalysis_FindQueueAssignment(assignments, second);
    ASSERT_TRUE(firstAssignment.has_value());
    ASSERT_TRUE(secondAssignment.has_value());
    EXPECT_EQ(firstAssignment.value().queue, queues[1u].id);
    EXPECT_EQ(secondAssignment.value().queue, queues[0u].id);
}


