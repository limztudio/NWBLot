[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/kernel/timing_names.adhd.h>

#include <core/graphics/runtime/render_pass.h>
#include <core/graphics/runtime/runtime.h>

namespace NWB::Tests::Smoke{
namespace RendererGpuTimingScope = Impl::RendererGpuTimingScope;
using Core::GraphicsRuntime;
using Core::IRenderPass;

class TimingProbeUnfocusedPass final : public Core::IRenderPass{
public:
    explicit TimingProbeUnfocusedPass(Core::GraphicsRuntime& graphics)noexcept : Core::IRenderPass(graphics){}
    virtual b8 shouldRenderUnfocused()noexcept override{ return true; }
};
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_TimingProbeInFlightRanges = 32u;
const StringView s_AvboitTimingProbeName = "AvboitTimingProbe";
const StringView s_ShadowTimingProbeName = "ShadowTimingProbe";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 PrepareTimingProbeScopes(mut GraphicsRuntime graphics, in Span<Name> scopes, in StringView probeName){
    for(usize i = 0u; i < scopes.size(); ++i){
        const Name scope = scopes[i];
        if(!graphics.gpuTiming().prepareScopeQueries(scope, graphics.getDevice(), s_TimingProbeInFlightRanges)){
            error("{}: failed to prepare scope '{}'", probeName, scope.resolvedText());
            return false;
        }
    }
    return true;
}

void RegisterTimingProbeRenderPass(mut GraphicsRuntime graphics, mut TimingProbeUnfocusedPass pass, in StringView probeName){
    graphics.addRenderPassToBack(pass);
    [essential] info("{}: in-flight ranges {}", probeName, s_TimingProbeInFlightRanges);
    [essential] info("{}: render unfocused 1", probeName);
}

class AvboitTimingRenderPass{
    public AvboitTimingRenderPass(mut GraphicsRuntime graphics){
        this.m_graphics = graphics;
        this.m_pass = TimingProbeUnfocusedPass(graphics);
    }

    public ~AvboitTimingRenderPass(){
        this.stop();
    }

    public b8 start(){
        return this.start(false);
    }

    public b8 start(in b8 includeCaustics){
        if(this.m_registered)
            return this.m_includeCaustics == includeCaustics;

        Array<Name, 24u> scopes;
        scopes[0u] = RendererGpuTimingScope::s_Frame.identity;
        scopes[1u] = RendererGpuTimingScope::s_OpaqueRegular.identity;
        scopes[2u] = RendererGpuTimingScope::s_ShadowVisibility.identity;
        scopes[3u] = RendererGpuTimingScope::s_LightSpaceShadowViews.identity;
        scopes[4u] = RendererGpuTimingScope::s_LightSpaceShadowOpaqueCapture.identity;
        scopes[5u] = RendererGpuTimingScope::s_LightSpaceShadowTransparentCapture.identity;
        scopes[6u] = RendererGpuTimingScope::s_LightSpaceShadowShade.identity;
        scopes[7u] = RendererGpuTimingScope::s_LightSpaceShadowMapOpaque.identity;
        scopes[8u] = RendererGpuTimingScope::s_LightSpaceShadowMapTransparent.identity;
        scopes[9u] = RendererGpuTimingScope::s_LightSpaceShadowFallbackOpaque.identity;
        scopes[10u] = RendererGpuTimingScope::s_LightSpaceShadowFallbackTransparent.identity;
        scopes[11u] = RendererGpuTimingScope::s_DeferredLighting.identity;
        scopes[12u] = RendererGpuTimingScope::s_DeferredComposite.identity;
        scopes[13u] = RendererGpuTimingScope::s_DeferredPresent.identity;
        scopes[14u] = RendererGpuTimingScope::s_AvboitClear.identity;
        scopes[15u] = RendererGpuTimingScope::s_AvboitOccupancy.identity;
        scopes[16u] = RendererGpuTimingScope::s_AvboitDepthWarp.identity;
        scopes[17u] = RendererGpuTimingScope::s_AvboitExtinction.identity;
        scopes[18u] = RendererGpuTimingScope::s_AvboitIntegration.identity;
        scopes[19u] = RendererGpuTimingScope::s_AvboitAccumulate.identity;
        scopes[20u] = RendererGpuTimingScope::s_RefractionResolve.identity;
        scopes[21u] = RendererGpuTimingScope::s_RefractionClassifyTiles.identity;
        scopes[22u] = RendererGpuTimingScope::s_RefractionClearTileArguments.identity;
        scopes[23u] = RendererGpuTimingScope::s_OpticalBoundsFinalize.identity;

        Array<Name, 2u> causticScopes;
        causticScopes[0u] = RendererGpuTimingScope::s_CausticPhotons.identity;
        causticScopes[1u] = RendererGpuTimingScope::s_CausticResolve.identity;

        if(!PrepareTimingProbeScopes(this.m_graphics, scopes, s_AvboitTimingProbeName))
            return false;
        if(includeCaustics && !PrepareTimingProbeScopes(this.m_graphics, causticScopes, s_AvboitTimingProbeName))
            return false;
        RegisterTimingProbeRenderPass(this.m_graphics, this.m_pass, s_AvboitTimingProbeName);
        this.m_registered = true;
        this.m_includeCaustics = includeCaustics;
        if(includeCaustics)
            [essential] info("AvboitTimingProbe: caustic in-flight ranges {}", s_TimingProbeInFlightRanges);
        return true;
    }

    public void stop(){
        if(!this.m_registered)
            return;
        this.m_graphics.removeRenderPass(this.m_pass);
        this.m_registered = false;
        this.m_includeCaustics = false;
    }

    private mut GraphicsRuntime m_graphics;
    private TimingProbeUnfocusedPass m_pass;
    private b8 m_registered = false;
    private b8 m_includeCaustics = false;
}

class ShadowTimingRenderPass{
    public ShadowTimingRenderPass(mut GraphicsRuntime graphics){
        this.m_graphics = graphics;
        this.m_pass = TimingProbeUnfocusedPass(graphics);
    }

    public ~ShadowTimingRenderPass(){
        this.stop();
    }

    public b8 start(){
        if(this.m_registered)
            return true;

        Array<Name, 13u> scopes;
        scopes[0u] = RendererGpuTimingScope::s_Frame.identity;
        scopes[1u] = RendererGpuTimingScope::s_OpaqueRegular.identity;
        scopes[2u] = RendererGpuTimingScope::s_DeferredLighting.identity;
        scopes[3u] = RendererGpuTimingScope::s_DeferredComposite.identity;
        scopes[4u] = RendererGpuTimingScope::s_DeferredPresent.identity;
        scopes[5u] = RendererGpuTimingScope::s_ShadowVisibility.identity;
        scopes[6u] = RendererGpuTimingScope::s_ShadowOpaqueTrace.identity;
        scopes[7u] = RendererGpuTimingScope::s_ShadowGeometryDownsample.identity;
        scopes[8u] = RendererGpuTimingScope::s_ShadowOpaqueTemporal.identity;
        scopes[9u] = RendererGpuTimingScope::s_ShadowOpaqueResolve.identity;
        scopes[10u] = RendererGpuTimingScope::s_ShadowTransparentTrace.identity;
        scopes[11u] = RendererGpuTimingScope::s_ShadowTransparentTemporal.identity;
        scopes[12u] = RendererGpuTimingScope::s_ShadowTransparentResolve.identity;

        if(!PrepareTimingProbeScopes(this.m_graphics, scopes, s_ShadowTimingProbeName))
            return false;
        RegisterTimingProbeRenderPass(this.m_graphics, this.m_pass, s_ShadowTimingProbeName);
        this.m_registered = true;
        return true;
    }

    public void stop(){
        if(!this.m_registered)
            return;
        this.m_graphics.removeRenderPass(this.m_pass);
        this.m_registered = false;
    }

    private mut GraphicsRuntime m_graphics;
    private TimingProbeUnfocusedPass m_pass;
    private b8 m_registered = false;
}


