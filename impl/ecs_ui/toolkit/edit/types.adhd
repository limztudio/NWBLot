    Up,
    Down,
    PageUp,
    PageDown,
}

class EditNavigationSnapshot{
    public EditNavigationSnapshot(){
        this.instanceGeneration = 0u;
        this.generation = 0u;
        this.preferredX = 0.0f;
        this.valid = false;
    }

    public EditNavigationSnapshot(in u64 inInstanceGeneration, in u64 inGeneration, in f32 inPreferredX, in b8 inValid){
        this.instanceGeneration = inInstanceGeneration;
        this.generation = inGeneration;
        this.preferredX = inPreferredX;
        this.valid = inValid;
    }

    public b8 operator==(in EditNavigationSnapshot rhs)const{
        return this.instanceGeneration == rhs.instanceGeneration && this.generation == rhs.generation && this.preferredX == rhs.preferredX && this.valid == rhs.valid;
    }

    public b8 operator!=(in EditNavigationSnapshot rhs)const{
        return this.instanceGeneration != rhs.instanceGeneration || this.generation != rhs.generation || this.preferredX != rhs.preferredX || this.valid != rhs.valid;
    }

    public u64 instanceGeneration;
    public u64 generation;
    public f32 preferredX;
    public b8 valid;
}

class EditNavigationResult{
    public usize committedByte = 0u;
    public f32 preferredX = 0.0f;
}

enum<u8> NumericParseStatus{
    Complete,
    Incomplete,
    Invalid,
    OutOfRange,
}

enum<u8> NumericBoundsPolicy{
    Reject,
    Clamp,
}

class IntegerBounds{
    public i64 minimum = s_NumericEditMinI64;
    public i64 maximum = s_NumericEditMaxI64;
    public NumericBoundsPolicy policy = NumericBoundsPolicy::Reject;
}

class FloatBounds{
    public f64 minimum = s_NumericEditMinF64;
    public f64 maximum = s_NumericEditMaxF64;
    public NumericBoundsPolicy policy = NumericBoundsPolicy::Reject;
}

class NumericEditResult{
    public b8 valid = false;
    public b8 committed = false;
    public b8 valueChanged = false;
    public b8 cancelled = false;
    public b8 rejected = false;
    public b8 clamped = false;
    public b8 restored = false;
}

enum<u8> EditTextStatus{
    InvalidText = 0u,
    TooLarge,
}


