// limztudio@gmail.com
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_texture/validation.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TextureBinaryCodec{
    private b8 readMipLevelsAndPayloadBytes(
        in Span<u8> binary,
        in u32 headerVersion,
        in u32 headerDimension,
        in u32 headerDepth,
        in u32 headerMipCount,
        in u32 headerAlphaInfo,
        in u32 headerPayloadFormat,
        in u64 headerPayloadByteCount,
        mut usize inOutCursor,
        mut u8 outDimension,
        mut u8 outPayloadFormat,
        mut u8 outAlphaMode,
        mut u8 outAlphaConstantUnorm8,
        mut Vector<TextureMipLevel> outMipLevels,
        mut Vector<u8> outPayloadBytes
    )const{
        if(headerVersion != s_TextureBinaryVersion){
            error("Texture::loadBinary failed: unsupported texture payload version; recook required");
            return false;
        }
        if((headerAlphaInfo & s_TextureAlphaInfoReservedMask) != 0u || headerPayloadFormat > cast<u32>(u8.max)){
            error("Texture::loadBinary failed: invalid texture payload flags");
            return false;
        }

        const u8 payloadFormat = cast<u8>(headerPayloadFormat);
        const u8 alphaMode = cast<u8>(headerAlphaInfo & s_TextureAlphaInfoModeMask);
        const u8 alphaConstantUnorm8 = cast<u8>((headerAlphaInfo & s_TextureAlphaInfoConstantMask) >> s_TextureAlphaInfoConstantShift);
        if(
            headerDimension > cast<u32>(u8.max)
            || !IsValidTextureDimensionCode(cast<u8>(headerDimension))
            || !IsValidTexturePayloadFormatCode(payloadFormat)
            || alphaMode > 3u
            || headerDepth == 0u
        ){
            error("Texture::loadBinary failed: invalid texture payload dimensions");
            return false;
        }
        if(headerMipCount == 0u || headerPayloadByteCount > cast<u64>(usize.max)){
            error("Texture::loadBinary failed: texture payload counts exceed runtime limits");
            return false;
        }

        if(cast<u64>(headerMipCount) > cast<u64>(usize.max / s_TextureMipLevelBinaryBytes)){
            error("Texture::loadBinary failed: mip payload byte size overflows");
            return false;
        }
        const usize mipByteCount = cast<usize>(headerMipCount) * s_TextureMipLevelBinaryBytes;
        if(!CanReadBytes(binary, inOutCursor, mipByteCount)){
            error("Texture::loadBinary failed: malformed mip levels payload");
            return false;
        }

        const usize payloadByteCount = cast<usize>(headerPayloadByteCount);
        if(!CanReadBytes(binary, inOutCursor + mipByteCount, payloadByteCount)){
            error("Texture::loadBinary failed: texture payload is truncated");
            return false;
        }

        if(!CanStoreValueCount(outMipLevels, cast<usize>(headerMipCount))){
            error("Texture::loadBinary failed: mip count exceeds runtime container limits");
            return false;
        }
        outMipLevels.clear();
        outMipLevels.reserve(cast<usize>(headerMipCount));
        for(u32 mipIndex = 0u; mipIndex < headerMipCount; ++mipIndex){
            const Expected<u32> mipWidth = ReadPOD<u32>(binary, inOutCursor);
            const Expected<u32> mipHeight = ReadPOD<u32>(binary, inOutCursor);
            const Expected<u32> mipSliceCount = ReadPOD<u32>(binary, inOutCursor);
            const Expected<u32> mipBlockCountX = ReadPOD<u32>(binary, inOutCursor);
            const Expected<u32> mipBlockCountY = ReadPOD<u32>(binary, inOutCursor);
            const Expected<u32> mipReserved = ReadPOD<u32>(binary, inOutCursor);
            const Expected<u64> mipOffsetBytes = ReadPOD<u64>(binary, inOutCursor);
            const Expected<u64> mipSizeBytes = ReadPOD<u64>(binary, inOutCursor);
            if(
                !mipWidth.has_value()
                || !mipHeight.has_value()
                || !mipSliceCount.has_value()
                || !mipBlockCountX.has_value()
                || !mipBlockCountY.has_value()
                || !mipReserved.has_value()
                || !mipOffsetBytes.has_value()
                || !mipSizeBytes.has_value()
            ){
                error("Texture::loadBinary failed: malformed mip level {}", mipIndex);
                return false;
            }
            if(mipReserved.value() != 0u){
                error("Texture::loadBinary failed: invalid texture mip payload flags");
                return false;
            }

            TextureMipLevel level;
            level.offsetBytes = mipOffsetBytes.value();
            level.sizeBytes = mipSizeBytes.value();
            level.width = mipWidth.value();
            level.height = mipHeight.value();
            level.blockCountX = mipBlockCountX.value();
            level.blockCountY = mipBlockCountY.value();
            level.sliceCount = mipSliceCount.value();
            outMipLevels.push_back(level);
        }

        outPayloadBytes.clear();
        outPayloadBytes.resize(payloadByteCount);
        for(usize i = 0u; i < payloadByteCount; ++i)
            outPayloadBytes[i] = binary[inOutCursor + i];
        inOutCursor += payloadByteCount;

        outDimension = cast<u8>(headerDimension);
        outPayloadFormat = payloadFormat;
        outAlphaMode = alphaMode;
        outAlphaConstantUnorm8 = alphaConstantUnorm8;
        return true;
    }

    public b8 serialize(
        in u8 dimension,
        in u32 width,
        in u32 height,
        in u32 depth,
        in u8 alphaMode,
        in u8 alphaConstantUnorm8,
        in u8 payloadFormat,
        in Span<TextureMipLevel> mipLevels,
        in Span<u8> payloadBytes,
        mut Vector<u8> outBinary
    )const{
        if(mipLevels.size() > cast<usize>(u32.max)){
            error("TextureAssetCodec::serialize failed: mip count exceeds cooked payload limits");
            return false;
        }

        usize reserveBytes = s_TextureHeaderBinaryBytes;
        if(!AddBinaryRepeatedReserveBytes(reserveBytes, mipLevels.size(), s_TextureMipLevelBinaryBytes) || !AddBinaryReserveBytes(reserveBytes, payloadBytes.size())){
            error("TextureAssetCodec::serialize failed: cooked payload size overflows");
            return false;
        }

        outBinary.clear();
        outBinary.reserve(reserveBytes);

        const u32 alphaInfo = cast<u32>(alphaMode) | (cast<u32>(alphaConstantUnorm8) << s_TextureAlphaInfoConstantShift);
        AppendPOD(outBinary, s_TextureBinaryMagic);
        AppendPOD(outBinary, s_TextureBinaryVersion);
        AppendPOD(outBinary, cast<u32>(dimension));
        AppendPOD(outBinary, width);
        AppendPOD(outBinary, height);
        AppendPOD(outBinary, depth);
        AppendPOD(outBinary, cast<u32>(mipLevels.size()));
        AppendPOD(outBinary, alphaInfo);
        AppendPOD(outBinary, cast<u32>(payloadFormat));
        AppendPOD(outBinary, cast<u64>(payloadBytes.size()));

        for(in TextureMipLevel mip : mipLevels){
            AppendPOD(outBinary, mip.width);
            AppendPOD(outBinary, mip.height);
            AppendPOD(outBinary, mip.sliceCount);
            AppendPOD(outBinary, mip.blockCountX);
            AppendPOD(outBinary, mip.blockCountY);
            AppendPOD(outBinary, 0u);
            AppendPOD(outBinary, mip.offsetBytes);
            AppendPOD(outBinary, mip.sizeBytes);
        }

        for(in u8 byteValue : payloadBytes)
            outBinary.push_back(byteValue);
        return true;
    }

    public b8 deserialize(
        in Span<u8> binary,
        mut u32 outWidth,
        mut u32 outHeight,
        mut u32 outDepth,
        mut u8 outDimension,
        mut u8 outPayloadFormat,
        mut u8 outAlphaMode,
        mut u8 outAlphaConstantUnorm8,
        mut Vector<TextureMipLevel> outMipLevels,
        mut Vector<u8> outPayloadBytes
    )const{
        usize cursor = 0u;
        if(!CanReadBytes(binary, cursor, s_TextureHeaderBinaryBytes)){
            error("Texture::loadBinary failed: malformed header");
            return false;
        }
        const Expected<u32> magic = ReadPOD<u32>(binary, cursor);
        const Expected<u32> version = ReadPOD<u32>(binary, cursor);
        const Expected<u32> dimension = ReadPOD<u32>(binary, cursor);
        const Expected<u32> width = ReadPOD<u32>(binary, cursor);
        const Expected<u32> height = ReadPOD<u32>(binary, cursor);
        const Expected<u32> depth = ReadPOD<u32>(binary, cursor);
        const Expected<u32> mipCount = ReadPOD<u32>(binary, cursor);
        const Expected<u32> alphaInfo = ReadPOD<u32>(binary, cursor);
        const Expected<u32> payloadFormat = ReadPOD<u32>(binary, cursor);
        const Expected<u64> payloadByteCount = ReadPOD<u64>(binary, cursor);
        if(
            !magic.has_value()
            || !version.has_value()
            || !dimension.has_value()
            || !width.has_value()
            || !height.has_value()
            || !depth.has_value()
            || !mipCount.has_value()
            || !alphaInfo.has_value()
            || !payloadFormat.has_value()
            || !payloadByteCount.has_value()
        ){
            error("Texture::loadBinary failed: malformed header");
            return false;
        }
        if(magic.value() != s_TextureBinaryMagic){
            error("Texture::loadBinary failed: invalid texture asset format; recook required");
            return false;
        }
        if(!this.readMipLevelsAndPayloadBytes(
            binary,
            version.value(),
            dimension.value(),
            depth.value(),
            mipCount.value(),
            alphaInfo.value(),
            payloadFormat.value(),
            payloadByteCount.value(),
            cursor,
            outDimension,
            outPayloadFormat,
            outAlphaMode,
            outAlphaConstantUnorm8,
            outMipLevels,
            outPayloadBytes
        ))
            return false;
        if(cursor != binary.size()){
            error("Texture::loadBinary failed: trailing bytes detected");
            return false;
        }
        outWidth = width.value();
        outHeight = height.value();
        outDepth = depth.value();
        return true;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

