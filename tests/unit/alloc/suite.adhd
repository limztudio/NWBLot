const usize s_VerifyAlignedReallocationGrownBytes = s_AllocCaseVerifyAlignedReallocationAlignment * 4u;

usize PersistentStructureAlignedSize(in usize bytes){
    usize aligned = 0u;
    native(in bytes, mut aligned){
        const auto structureAlignedSize = static_cast<usize(*)(usize)>(&PersistentArena::StructureAlignedSize);
        aligned = structureAlignedSize(bytes);
    }
    return aligned;
}

usize PersistentStructureAlignedSize(in usize bytes, in usize alignment){
    usize aligned = 0u;
    native(in bytes, in alignment, mut aligned){
        aligned = PersistentArena::StructureAlignedSize(bytes, alignment);
    }
    return aligned;
}

void VerifyAlignedReallocation<Arena>(mut Arena arena){
    native(mut arena){
        EXPECT_EQ(arena.reallocate(nullptr, s_AllocCaseVerifyAlignedReallocationAlignment, 0u), nullptr);
        auto* initial = static_cast<u8*>(arena.reallocate(nullptr, s_AllocCaseVerifyAlignedReallocationAlignment, s_AllocCaseVerifyAlignedReallocationAlignment));
        ASSERT_NE(initial, nullptr);
        EXPECT_EQ(reinterpret_cast<usize>(initial) % s_AllocCaseVerifyAlignedReallocationAlignment, 0u);
        for(usize i = 0u; i < s_AllocCaseVerifyAlignedReallocationAlignment; ++i)
            initial[i] = static_cast<u8>(i);

        void* blocker = arena.allocate(1u, s_AllocCaseVerifyAlignedReallocationAlignment);
        ASSERT_NE(blocker, nullptr);

        auto* resized = static_cast<u8*>(arena.reallocate(initial, s_AllocCaseVerifyAlignedReallocationAlignment, s_VerifyAlignedReallocationGrownBytes));
        ASSERT_NE(resized, nullptr);
        EXPECT_EQ(reinterpret_cast<usize>(resized) % s_AllocCaseVerifyAlignedReallocationAlignment, 0u);
        for(usize i = 0u; i < s_AllocCaseVerifyAlignedReallocationAlignment; ++i)
            EXPECT_EQ(resized[i], static_cast<u8>(i));

        arena.deallocate(blocker, 1u, s_AllocCaseVerifyAlignedReallocationAlignment);
        EXPECT_EQ(arena.reallocate(resized, s_AllocCaseVerifyAlignedReallocationAlignment, 0u), nullptr);
    }
}

b8 RunAllocationBatch<const usize Count>(in Array<AllocationRequest, Count> requests, mut ScratchArena arena){
    b8 valid = true;
    native(in requests, mut arena, mut valid){
        Array<u8*, Count> allocations{};
        usize prepared = 0u;
        for(; prepared < Count; ++prepared){
            const AllocationRequest& request = requests[prepared];
            auto* allocation = static_cast<u8*>(arena.allocate(request.alignment, request.bytes));
            if(!allocation){
                valid = false;
                break;
            }
            allocations[prepared] = allocation;
            valid &= reinterpret_cast<usize>(allocation) % request.alignment == 0u;
            allocation[0u] = static_cast<u8>(prepared + 1u);
            allocation[request.bytes - 1u] = static_cast<u8>(prepared + s_AllocCaseScratchReuseTailTagOffset);
        }
        while(prepared != 0u){
            const usize index = --prepared;
            const AllocationRequest& request = requests[index];
            u8* allocation = allocations[index];
            valid &= allocation[0u] == static_cast<u8>(index + 1u);
            valid &= allocation[request.bytes - 1u] == static_cast<u8>(index + s_AllocCaseScratchReuseTailTagOffset);
            arena.deallocate(allocation, request.alignment, request.bytes);
        }
    }
    return valid;
}

// Public container operations model collecting and sorting transient work while a caller retains earlier storage.
b8 RunScopedCollection(in usize count, mut ScratchArena arena){
    b8 valid = true;
    native(in count, mut arena, mut valid){
        Vector<u64, ScratchArena> keys(arena);
        keys.resize(count);
        for(usize index = 0u; index < count; ++index)
            keys[index] = static_cast<u64>(count - index - 1u);
        Vector<u64, ScratchArena> payload(arena);
        payload.resize(count * 3u);
        for(usize index = 0u; index < payload.size(); ++index)
            payload[index] = static_cast<u64>(index * 7u + 3u);
        {
            Vector<usize, ScratchArena> ordinals(arena);
            ordinals.resize(count);
            for(usize index = 0u; index < count; ++index)
                ordinals[index] = index;
            Sort(keys.begin(), keys.end());
            AString<ScratchArena> path(arena);
            path.reserve(s_AllocCaseScratchReusePathReserveBytes);
            path += "project/fixtures/transient_collection/";
            path += "resolved_asset_name_with_a_nontrivial_path_length";
            if(path.size() <= 32u)
                valid = false;
            else{
                for(usize index = 0u; index < count; ++index){
                    if(keys[index] != ordinals[index] || payload[index * 3u] != static_cast<u64>(index * 21u + 3u)){
                        valid = false;
                        break;
                    }
                }
            }
        }
    }
    return valid;
}

void VerifyArenaAlignedReallocation_GlobalArenaReallocationPreservesAlignment(){
    GlobalArena arena(s_TestArena);
    VerifyAlignedReallocation(arena);
}

void VerifyArenaAlignedReallocation_PersistentArenaReallocationPreservesAlignment(){
    PersistentArena arena(s_TestArena, PersistentStructureAlignedSize(16u * 1024u));
    VerifyAlignedReallocation(arena);
}

void VerifyGlobalArenaTests_SharedOwnerAllocationChurnPreservesPayloadAndAccounting(){
    const usize threadCount = 4u;
    const usize iterationsPerThread = 32768u;
    const usize allocationBytes = 128u;
    Array<AllocatorWorkerResult, 4> results = Array<AllocatorWorkerResult, 4>();

    native(in threadCount, in iterationsPerThread, in allocationBytes, mut results){
        Array<Thread, 4> workers;
        Latch workersReady(threadCount);
        Latch start(1u);

        for(usize threadIndex = 0u; threadIndex < threadCount; ++threadIndex){
            workers[threadIndex] = Thread([&results, &workersReady, &start, threadIndex](){
                GlobalArena arena(s_GlobalSharedOwnerAllocationChurn);
                b8 allocationFailed = false;
                b8 contentsPreserved = true;
                workersReady.count_down();
                start.wait();

                for(usize iteration = 0u; iteration < iterationsPerThread; ++iteration){
                    auto* const allocation = static_cast<u8*>(arena.allocate(1u, allocationBytes));
                    if(!allocation){
                        allocationFailed = true;
                        break;
                    }
                    // Volatile payload accesses retain the cross-thread allocator correctness check in opt/fin builds.
                    volatile u8* const payload = allocation;
                    const u8 firstByte = static_cast<u8>(threadIndex);
                    const u8 lastByte = static_cast<u8>(iteration);
                    payload[0u] = firstByte;
                    payload[allocationBytes - 1u] = lastByte;
                    contentsPreserved &= payload[0u] == firstByte;
                    contentsPreserved &= payload[allocationBytes - 1u] == lastByte;
                    arena.deallocate(allocation, 1u, allocationBytes);
                }

                AllocatorWorkerResult out;
                out.stats = arena.memoryStats();
                out.allocationFailed = allocationFailed;
                out.contentsPreserved = contentsPreserved;
                results[threadIndex] = out;
            });
        }

        workersReady.wait();
        start.count_down();
        for(Thread& worker : workers)
            worker.join();
    }

    for(in AllocatorWorkerResult result : results){
        EXPECT_FALSE(result.allocationFailed);
        EXPECT_TRUE(result.contentsPreserved);
        EXPECT_EQ(result.stats.allocationCount, iterationsPerThread);
        EXPECT_EQ(result.stats.deallocationCount, iterationsPerThread);
        EXPECT_EQ(result.stats.reallocationCount, 0u);
        EXPECT_EQ(result.stats.usedBytes, 0u);
        EXPECT_EQ(result.stats.reservedBytes, 0u);
        EXPECT_GE(result.stats.peakUsedBytes, allocationBytes);
    }
}

void VerifyPersistentArenaTests_SharedArenaConcurrentAllocationCrossThreadFreeAndAccounting(){
    const usize threadCount = 4u;
    const usize iterationsPerThread = 4096u;
    const usize handoffAlignment = 256u;
    const usize handoffBytes = 256u;
    const usize poolBytes = PersistentStructureAlignedSize(512u * 1024u);
    PersistentArena arena(s_PersistentArenaSharedCrossThreadChurn, poolBytes);
    Array<PersistentArenaWorkerResult, 4> results = Array<PersistentArenaWorkerResult, 4>();
    ArenaMemoryStats live = ArenaMemoryStats();

    native(in threadCount, in iterationsPerThread, in handoffAlignment, in handoffBytes, mut arena, mut results, mut live){
        Array<u8*, 4> handoffs = {};
        Array<Thread, 4> workers;
        Latch workersReady(threadCount);
        Latch start(1u);
        Latch handoffsReady(threadCount);
        Latch releaseHandoffs(1u);

        for(usize threadIndex = 0u; threadIndex < threadCount; ++threadIndex){
            workers[threadIndex] = Thread([&arena, &handoffs, &results, &workersReady, &start, &handoffsReady, &releaseHandoffs, threadIndex]()noexcept{
                b8 allocationFailed = false;
                b8 contentsPreserved = true;
                b8 alignmentPreserved = true;
                workersReady.count_down();
                start.wait();

                auto* const handoff = static_cast<u8*>(arena.allocate(handoffAlignment, handoffBytes));
                if(!handoff)
                    allocationFailed = true;
                else{
                    volatile u8* const payload = handoff;
                    payload[0u] = static_cast<u8>(threadIndex);
                    payload[handoffBytes - 1u] = static_cast<u8>(threadIndex + 1u);
                    alignmentPreserved &= reinterpret_cast<usize>(handoff) % handoffAlignment == 0u;
                }
                handoffs[threadIndex] = handoff;
                handoffsReady.count_down();
                releaseHandoffs.wait();

                auto* const handedOff = handoffs[(threadIndex + 1u) % threadCount];
                if(!handedOff)
                    allocationFailed = true;
                else{
                    volatile u8* const payload = handedOff;
                    contentsPreserved &= payload[0u] == static_cast<u8>((threadIndex + 1u) % threadCount);
                    contentsPreserved &= payload[handoffBytes - 1u] == static_cast<u8>((threadIndex + 1u) % threadCount + 1u);
                    arena.deallocate(handedOff, handoffAlignment, handoffBytes);
                }

                for(usize iteration = 0u; iteration < iterationsPerThread; ++iteration){
                    const usize alignment = (iteration + threadIndex) % 2u == 0u ? 1u : handoffAlignment;
                    auto* const allocation = static_cast<u8*>(arena.allocate(alignment, 113u));
                    if(!allocation){
                        allocationFailed = true;
                        break;
                    }
                    volatile u8* const payload = allocation;
                    const u8 firstByte = static_cast<u8>(threadIndex + iteration);
                    const u8 lastByte = static_cast<u8>(threadIndex + iteration + 1u);
                    payload[0u] = firstByte;
                    payload[112u] = lastByte;
                    alignmentPreserved &= reinterpret_cast<usize>(allocation) % alignment == 0u;
                    YieldThread();
                    contentsPreserved &= payload[0u] == firstByte;
                    contentsPreserved &= payload[112u] == lastByte;
                    arena.deallocate(allocation, alignment, 113u);
                }

                PersistentArenaWorkerResult out;
                out.allocationFailed = allocationFailed;
                out.contentsPreserved = contentsPreserved;
                out.alignmentPreserved = alignmentPreserved;
                results[threadIndex] = out;
            });
        }

        workersReady.wait();
        start.count_down();
        handoffsReady.wait();
        live = arena.memoryStats();
        releaseHandoffs.count_down();
        for(Thread& worker : workers)
            worker.join();
    }

    const ArenaMemoryStats settled = arena.memoryStats();
    const u64 expectedOperations = cast<u64>(threadCount * (iterationsPerThread + 1u));
    for(in PersistentArenaWorkerResult result : results){
        EXPECT_FALSE(result.allocationFailed);
        EXPECT_TRUE(result.contentsPreserved);
        EXPECT_TRUE(result.alignmentPreserved);
    }
    EXPECT_EQ(live.reservedBytes, poolBytes);
    EXPECT_EQ(live.allocationCount, threadCount);
    EXPECT_EQ(live.reallocationCount, 0u);
    EXPECT_EQ(live.deallocationCount, 0u);
    EXPECT_GT(live.usedBytes, 0u);
    EXPECT_EQ(live.peakUsedBytes, live.usedBytes);
    EXPECT_EQ(settled.reservedBytes, poolBytes);
    EXPECT_EQ(settled.usedBytes, 0u);
    EXPECT_EQ(settled.allocationCount, expectedOperations);
    EXPECT_EQ(settled.reallocationCount, 0u);
    EXPECT_EQ(settled.deallocationCount, expectedOperations);
    EXPECT_GE(settled.peakUsedBytes, live.usedBytes);
    EXPECT_LE(settled.peakUsedBytes, poolBytes);
}

void VerifyPersistentArenaTests_SharedArenaConcurrentReallocationPreservesPayloadAndAccounting(){
    const usize threadCount = 4u;
    const usize iterationsPerThread = 4096u;
    const usize initialBytes = 113u;
    const usize replacementBytes = 389u;
    const usize replacementAlignment = 256u;
    const usize poolBytes = PersistentStructureAlignedSize(512u * 1024u);
    PersistentArena arena(s_PersistentArenaSharedReallocationChurn, poolBytes);
    Array<PersistentArenaWorkerResult, 4> results = Array<PersistentArenaWorkerResult, 4>();

    native(in threadCount, in iterationsPerThread, in initialBytes, in replacementBytes, in replacementAlignment, mut arena, mut results){
        Array<Thread, 4> workers;
        Latch workersReady(threadCount);
        Latch start(1u);

        for(usize threadIndex = 0u; threadIndex < threadCount; ++threadIndex){
            workers[threadIndex] = Thread([&arena, &results, &workersReady, &start, threadIndex]()noexcept{
                b8 allocationFailed = false;
                b8 contentsPreserved = true;
                b8 alignmentPreserved = true;
                workersReady.count_down();
                start.wait();

                for(usize iteration = 0u; iteration < iterationsPerThread; ++iteration){
                    auto* allocation = static_cast<u8*>(arena.allocate(1u, initialBytes));
                    if(!allocation){
                        allocationFailed = true;
                        break;
                    }
                    volatile u8* const initialPayload = allocation;
                    const u8 firstByte = static_cast<u8>(threadIndex + iteration);
                    const u8 lastByte = static_cast<u8>(threadIndex + iteration + 1u);
                    initialPayload[0u] = firstByte;
                    initialPayload[initialBytes - 1u] = lastByte;
                    YieldThread();

                    auto* const replacement = static_cast<u8*>(arena.reallocate(allocation, replacementAlignment, replacementBytes));
                    if(!replacement){
                        allocationFailed = true;
                        arena.deallocate(allocation, 1u, initialBytes);
                        break;
                    }
                    allocation = replacement;
                    volatile u8* const replacementPayload = allocation;
                    contentsPreserved &= replacementPayload[0u] == firstByte;
                    contentsPreserved &= replacementPayload[initialBytes - 1u] == lastByte;
                    alignmentPreserved &= reinterpret_cast<usize>(allocation) % replacementAlignment == 0u;
                    arena.deallocate(allocation, replacementAlignment, replacementBytes);
                }

                PersistentArenaWorkerResult out;
                out.allocationFailed = allocationFailed;
                out.contentsPreserved = contentsPreserved;
                out.alignmentPreserved = alignmentPreserved;
                results[threadIndex] = out;
            });
        }

        workersReady.wait();
        start.count_down();
        for(Thread& worker : workers)
            worker.join();
    }

    const ArenaMemoryStats settled = arena.memoryStats();
    const u64 expectedOperations = cast<u64>(threadCount * iterationsPerThread);
    for(in PersistentArenaWorkerResult result : results){
        EXPECT_FALSE(result.allocationFailed);
        EXPECT_TRUE(result.contentsPreserved);
        EXPECT_TRUE(result.alignmentPreserved);
    }
    EXPECT_EQ(settled.reservedBytes, poolBytes);
    EXPECT_EQ(settled.usedBytes, 0u);
    EXPECT_EQ(settled.allocationCount, expectedOperations);
    EXPECT_EQ(settled.reallocationCount, expectedOperations);
    EXPECT_EQ(settled.deallocationCount, expectedOperations);
    EXPECT_LE(settled.peakUsedBytes, poolBytes);
}

void VerifyPersistentArenaTests_StructureAlignedSizeFitsExactPayloadAndReusesTheFixedPool(){
    PersistentArena arena(s_AllocCasePersistentArenaExactPayload, PersistentStructureAlignedSize(s_AllocCasePersistentArenaHighAlignment));
    const ArenaMemoryStats initial = arena.memoryStats();

    native(in initial, mut arena){
        auto* const first = static_cast<u8*>(arena.allocate(1u, s_AllocCasePersistentArenaHighAlignment));
        ASSERT_NE(first, nullptr);
        FillPattern(Span<u8>(first, s_AllocCasePersistentArenaHighAlignment));
        const ArenaMemoryStats allocated = arena.memoryStats();
        EXPECT_EQ(allocated.reservedBytes, initial.reservedBytes);
        EXPECT_GT(allocated.usedBytes, 0u);
        EXPECT_EQ(allocated.allocationCount, initial.allocationCount + 1u);

        EXPECT_EQ(arena.allocate(1u, 1u), nullptr);
        ExpectMemoryStatsEqual(allocated, arena.memoryStats());

        arena.deallocate(first, 1u, s_AllocCasePersistentArenaHighAlignment);
        EXPECT_EQ(arena.memoryStats().usedBytes, 0u);
        auto* const reused = static_cast<u8*>(arena.allocate(1u, s_AllocCasePersistentArenaHighAlignment));
        ASSERT_NE(reused, nullptr);
        FillPattern(Span<u8>(reused, s_AllocCasePersistentArenaHighAlignment));
        ExpectPattern(Span<const u8>(reused, s_AllocCasePersistentArenaHighAlignment));
        arena.deallocate(reused, 1u, s_AllocCasePersistentArenaHighAlignment);
    }

    EXPECT_EQ(arena.memoryStats().usedBytes, 0u);
}

void VerifyPersistentArenaTests_StructureAlignedSizeFitsAnExactOverAlignedPayload(){
    PersistentArena arena(s_AllocCasePersistentArenaExactOveralignedPayload, PersistentStructureAlignedSize(1u, s_AllocCasePersistentArenaHighAlignment));

    native(mut arena){
        auto* const allocation = static_cast<u8*>(arena.allocate(s_AllocCasePersistentArenaHighAlignment, 1u));
        ASSERT_NE(allocation, nullptr);
        EXPECT_EQ(reinterpret_cast<usize>(allocation) % s_AllocCasePersistentArenaHighAlignment, 0u);
        arena.deallocate(allocation, s_AllocCasePersistentArenaHighAlignment, 1u);
    }

    EXPECT_EQ(arena.memoryStats().usedBytes, 0u);
}

void VerifyPersistentArenaTests_StructureAlignedSizeFitsMultipleExactTypedArrayBackings(){
    const usize queueCount = 9u;
    const usize slotsPerQueue = 256u;
    const usize slotCount = queueCount * slotsPerQueue;
    usize poolBytes = 0u;
    native(in queueCount, in slotCount, mut poolBytes){
        const usize slotRecordBytes = slotCount * sizeof(PersistentArenaSlotRecord);
        const usize nextSerialBytes = queueCount * sizeof(u64);
        poolBytes = PersistentArena::StructureAlignedSize(slotRecordBytes, alignof(PersistentArenaSlotRecord))
            + PersistentArena::StructureAlignedSize(nextSerialBytes, alignof(u64));
    }

    PersistentArena arena(s_AllocCasePersistentArenaFixedArrayBackings, poolBytes);
    native(in queueCount, in slotCount, mut arena){
        auto slotRecords = Core::MakePersistentUnique<PersistentArenaSlotRecord[]>(arena, slotCount);
        auto nextSerials = Core::MakePersistentUnique<u64[]>(arena, queueCount);

        ASSERT_TRUE(slotRecords);
        ASSERT_TRUE(nextSerials);
    }

    EXPECT_EQ(arena.memoryStats().usedBytes, 0u);
}

void VerifyPersistentArenaTests_ReusesAdjacentFreeBlocksForGrowthAndCoalescing(){
    const usize growthBytes = 512u;
    const usize blockBytes = 1024u;
    const usize grownBytes = 1024u;
    const usize combinedBytes = 1536u;
    PersistentArena arena(s_AllocCasePersistentArenaCoalescing, PersistentStructureAlignedSize(s_AllocCasePersistentArenaHighAlignment));

    native(in growthBytes, in blockBytes, in grownBytes, in combinedBytes, mut arena){
        auto* const growth = static_cast<u8*>(arena.allocate(1u, growthBytes));
        auto* const neighbor = static_cast<u8*>(arena.allocate(1u, blockBytes));
        ASSERT_NE(growth, nullptr);
        ASSERT_NE(neighbor, nullptr);
        FillPattern(Span<u8>(growth, growthBytes));
        arena.deallocate(neighbor, 1u, blockBytes);

        auto* const grown = static_cast<u8*>(arena.reallocate(growth, 1u, grownBytes));
        ASSERT_EQ(grown, growth);
        ExpectPattern(Span<const u8>(grown, growthBytes));
        arena.deallocate(grown, 1u, grownBytes);

        auto* const first = static_cast<u8*>(arena.allocate(1u, blockBytes));
        auto* const second = static_cast<u8*>(arena.allocate(1u, blockBytes));
        auto* const blocker = static_cast<u8*>(arena.allocate(1u, blockBytes));
        ASSERT_NE(first, nullptr);
        ASSERT_NE(second, nullptr);
        ASSERT_NE(blocker, nullptr);
        EXPECT_EQ(arena.allocate(1u, combinedBytes), nullptr);

        arena.deallocate(first, 1u, blockBytes);
        arena.deallocate(second, 1u, blockBytes);
        auto* const combined = static_cast<u8*>(arena.allocate(1u, combinedBytes));
        ASSERT_NE(combined, nullptr);
        arena.deallocate(combined, 1u, combinedBytes);
        arena.deallocate(blocker, 1u, blockBytes);
    }

    EXPECT_EQ(arena.memoryStats().usedBytes, 0u);
}

void VerifyPersistentArenaTests_ReallocationGrowsAcrossMultipleDeferredAdjacentBlocks(){
    const usize blockBytes = 512u;
    const usize grownBytes = 1600u;
    PersistentArena arena(s_AllocCasePersistentArenaDeferredReallocationGrowth, 3u * PersistentStructureAlignedSize(blockBytes));

    native(in blockBytes, in grownBytes, mut arena){
        auto* const first = static_cast<u8*>(arena.allocate(1u, blockBytes));
        auto* const second = static_cast<u8*>(arena.allocate(1u, blockBytes));
        auto* const third = static_cast<u8*>(arena.allocate(1u, blockBytes));
        ASSERT_NE(first, nullptr);
        ASSERT_NE(second, nullptr);
        ASSERT_NE(third, nullptr);
        FillPattern(Span<u8>(first, blockBytes));

        arena.deallocate(second, 1u, blockBytes);
        const ArenaMemoryStats beforeFailedGrowth = arena.memoryStats();
        EXPECT_EQ(arena.reallocate(first, 1u, grownBytes), nullptr);
        ExpectPattern(Span<const u8>(first, blockBytes));
        ExpectMemoryStatsEqual(beforeFailedGrowth, arena.memoryStats());

        arena.deallocate(third, 1u, blockBytes);

        auto* const grown = static_cast<u8*>(arena.reallocate(first, 1u, grownBytes));
        ASSERT_EQ(grown, first);
        ExpectPattern(Span<const u8>(grown, blockBytes));
        arena.deallocate(grown, 1u, grownBytes);
    }

    EXPECT_EQ(arena.memoryStats().usedBytes, 0u);
}

void VerifyPersistentArenaTests_FailedAlignedReallocationRetainsPayloadAndStats(){
    const usize initialBytes = 1024u;
    PersistentArena arena(s_AllocCasePersistentArenaFailedReallocation, PersistentStructureAlignedSize(2048u));

    native(in initialBytes, mut arena){
        auto* const initial = static_cast<u8*>(arena.allocate(1u, initialBytes));
        auto* const blocker = static_cast<u8*>(arena.allocate(1u, 800u));
        ASSERT_NE(initial, nullptr);
        ASSERT_NE(blocker, nullptr);
        FillPattern(Span<u8>(initial, initialBytes));
        const ArenaMemoryStats beforeFailure = arena.memoryStats();

        EXPECT_EQ(arena.reallocate(initial, 256u, 1536u), nullptr);
        ExpectPattern(Span<const u8>(initial, initialBytes));
        ExpectMemoryStatsEqual(beforeFailure, arena.memoryStats());

        arena.deallocate(initial, 1u, initialBytes);
        arena.deallocate(blocker, 1u, 800u);
    }

    EXPECT_EQ(arena.memoryStats().usedBytes, 0u);
}

void VerifyPersistentArenaTests_ReallocationMaintainsRequestedAlignmentAcrossShrinkAndGrowth(){
    const usize initialBytes = 512u;
    const usize grownBytes = 1024u;
    PersistentArena arena(s_AllocCasePersistentArenaReallocationAlignment, PersistentStructureAlignedSize(4096u, s_AllocCasePersistentArenaHighAlignment));

    native(in initialBytes, in grownBytes, mut arena){
        auto* const initial = static_cast<u8*>(arena.allocate(1u, initialBytes));
        ASSERT_NE(initial, nullptr);
        FillPattern(Span<u8>(initial, initialBytes));

        auto* const shrunk = static_cast<u8*>(arena.reallocate(initial, 256u, 256u));
        ASSERT_NE(shrunk, nullptr);
        EXPECT_EQ(reinterpret_cast<usize>(shrunk) % 256u, 0u);
        ExpectPattern(Span<const u8>(shrunk, 256u));

        auto* const grown = static_cast<u8*>(arena.reallocate(shrunk, s_AllocCasePersistentArenaHighAlignment, grownBytes));
        ASSERT_NE(grown, nullptr);
        EXPECT_EQ(reinterpret_cast<usize>(grown) % s_AllocCasePersistentArenaHighAlignment, 0u);
        ExpectPattern(Span<const u8>(grown, 256u));
        arena.deallocate(grown, s_AllocCasePersistentArenaHighAlignment, grownBytes);
    }

    EXPECT_EQ(arena.memoryStats().usedBytes, 0u);
}

void VerifyPersistentArenaTests_ReallocationRetainsAHighAlignedBlockForLowerAlignment(){
    PersistentArena arena(s_AllocCasePersistentArenaReallocationLowerAlignment, PersistentStructureAlignedSize(1u, s_AllocCasePersistentArenaHighAlignment));

    native(mut arena){
        auto* const allocation = static_cast<u8*>(arena.allocate(s_AllocCasePersistentArenaHighAlignment, 1u));
        ASSERT_NE(allocation, nullptr);
        allocation[0u] = 93u;

        auto* const shrunk = static_cast<u8*>(arena.reallocate(allocation, 1u, 1u));
        ASSERT_EQ(shrunk, allocation);
        EXPECT_EQ(shrunk[0u], 93u);
        arena.deallocate(shrunk, 1u, 1u);
    }

    EXPECT_EQ(arena.memoryStats().usedBytes, 0u);
}

void VerifyPersistentArenaTests_NullAndZeroReallocationFollowAllocationAccounting(){
    PersistentArena arena(s_AllocCasePersistentArenaNullZeroReallocation, PersistentStructureAlignedSize(s_AllocCaseSmallArenaPayloadBytes));
    const ArenaMemoryStats before = arena.memoryStats();
    ArenaMemoryStats allocated = ArenaMemoryStats();

    native(in before, mut arena, mut allocated){
        EXPECT_EQ(arena.reallocate(nullptr, 64u, 0u), nullptr);
        ExpectMemoryStatsEqual(before, arena.memoryStats());

        auto* const allocation = static_cast<u8*>(arena.reallocate(nullptr, 64u, 33u));
        ASSERT_NE(allocation, nullptr);
        allocated = arena.memoryStats();
        EXPECT_EQ(allocated.allocationCount, before.allocationCount + 1u);
        EXPECT_EQ(allocated.reallocationCount, before.reallocationCount);
        EXPECT_EQ(allocated.deallocationCount, before.deallocationCount);

        EXPECT_EQ(arena.reallocate(allocation, 64u, 0u), nullptr);
    }

    const ArenaMemoryStats released = arena.memoryStats();
    EXPECT_EQ(released.reservedBytes, before.reservedBytes);
    EXPECT_EQ(released.usedBytes, 0u);
    EXPECT_EQ(released.allocationCount, allocated.allocationCount);
    EXPECT_EQ(released.reallocationCount, allocated.reallocationCount);
    EXPECT_EQ(released.deallocationCount, allocated.deallocationCount + 1u);
}

void VerifyPersistentArenaTests_CAllocatorAdapterRetainsMaxAlignmentAndPrefix(){
    PersistentArena arena(s_AllocCasePersistentArenaCAllocator, PersistentStructureAlignedSize(s_AllocCaseSmallArenaPayloadBytes));

    native(mut arena){
        auto* const zeroAllocation = static_cast<u8*>(AllocateArenaCMemory(arena, 0u));
        ASSERT_NE(zeroAllocation, nullptr);
        EXPECT_EQ(reinterpret_cast<usize>(zeroAllocation) % alignof(MaxAlign), 0u);
        zeroAllocation[0u] = 47u;

        auto* const grown = static_cast<u8*>(ReallocateArenaCMemory(arena, zeroAllocation, 37u));
        ASSERT_NE(grown, nullptr);
        EXPECT_EQ(reinterpret_cast<usize>(grown) % alignof(MaxAlign), 0u);
        EXPECT_EQ(grown[0u], 47u);
        DeallocateArenaCMemory(arena, grown);
    }

    EXPECT_EQ(arena.memoryStats().usedBytes, 0u);
}

void VerifyScratchArenaReuse_ReverseFreesCrossChunkBoundariesAndReuseAllEmptyChunks(){
    ScratchArena arena(s_AllocCaseScratchReuseCrossChunk, 256u);
    Array<AllocationRequest, 3> requests = Array<AllocationRequest, 3>();
    requests[0u] = MakeAllocationRequest(8u, 192u);
    requests[1u] = MakeAllocationRequest(8u, 128u);
    requests[2u] = MakeAllocationRequest(8u, 768u);
    ASSERT_TRUE(RunAllocationBatch(requests, arena));
    const ArenaMemoryStats warm = arena.memoryStats();
    EXPECT_EQ(warm.usedBytes, 0u);
    EXPECT_EQ(warm.allocationCount, 3u);
    EXPECT_EQ(warm.deallocationCount, 3u);
    EXPECT_EQ(warm.peakUsedBytes, 1088u);
    for(usize iteration = 0u; iteration < 32u; ++iteration){
        ASSERT_TRUE(RunAllocationBatch(requests, arena));
        const ArenaMemoryStats current = arena.memoryStats();
        EXPECT_EQ(current.usedBytes, 0u);
        EXPECT_EQ(current.reservedBytes, warm.reservedBytes);
        EXPECT_EQ(current.allocationCount, cast<u64>((iteration + 2u) * 3u));
        EXPECT_EQ(current.deallocationCount, current.allocationCount);
    }
}

void VerifyScratchArenaReuse_ColdAlignmentBucketsAllocateOnceAndReleaseAllBacking(){
    Array<usize, 9> alignments = Array<usize, 9>();
    alignments[0u] = 1u;
    alignments[1u] = 2u;
    alignments[2u] = 4u;
    alignments[3u] = 8u;
    alignments[4u] = 16u;
    alignments[5u] = 32u;
    alignments[6u] = 64u;
    alignments[7u] = 128u;
    alignments[8u] = 256u;
    ArenaMemoryStats before = ArenaMemoryStats();
    ArenaMemoryStats live = ArenaMemoryStats();
    b8 valid = true;
    usize expectedReserved = 0u;
    ArenaMemoryStats released = ArenaMemoryStats();
    {
        ScratchArena arena(s_AllocCaseScratchReuseColdAlignmentBuckets, 257u);
        native(in alignments, mut arena, mut before, mut live, mut valid, mut expectedReserved){
            Array<u8*, 9> allocations = {};
            before = HeapBackingMemoryStats();
            for(usize index = 0u; index < alignments.size(); ++index){
                const usize alignment = alignments[index];
                const usize bytes = alignment + 3u;
                allocations[index] = static_cast<u8*>(arena.allocate(alignment, bytes));
                if(!allocations[index]){
                    valid = false;
                    continue;
                }
                valid &= reinterpret_cast<usize>(allocations[index]) % alignment == 0u;
                allocations[index][0u] = static_cast<u8>(index + 1u);
                allocations[index][bytes - 1u] = static_cast<u8>(index + 19u);
                expectedReserved += Alignment(alignment, 257u);
            }
            live = HeapBackingMemoryStats();
            valid &= arena.memoryStats().reservedBytes == expectedReserved;
            for(usize index = alignments.size(); index != 0u;){
                --index;
                if(!allocations[index])
                    continue;
                const usize alignment = alignments[index];
                const usize bytes = alignment + 3u;
                valid &= allocations[index][0u] == static_cast<u8>(index + 1u);
                valid &= allocations[index][bytes - 1u] == static_cast<u8>(index + 19u);
                arena.deallocate(allocations[index], alignment, bytes);
            }
        }
        released = arena.memoryStats();
    }
    const ArenaMemoryStats after = HeapBackingMemoryStats();
    EXPECT_TRUE(valid);
    EXPECT_EQ(live.allocationCount - before.allocationCount, alignments.size());
    EXPECT_EQ(after.deallocationCount - before.deallocationCount, alignments.size());
    EXPECT_EQ(after.usedBytes, before.usedBytes);
    EXPECT_EQ(released.usedBytes, 0u);
    EXPECT_EQ(released.reservedBytes, expectedReserved);
}

void VerifyScratchArenaReuse_InvalidRuntimeAlignmentDoesNotConsumeExistingBucket(){
    ScratchArena arena(s_AllocCaseScratchReuseInvalidAlignment, 256u);
    native(mut arena){
        auto* sentinel = static_cast<u8*>(arena.allocate(2u, 32u));
        ASSERT_NE(sentinel, nullptr);
        sentinel[0u] = static_cast<u8>(s_AllocCaseScratchReuseSentinelByte);
        const ArenaMemoryStats before = arena.memoryStats();
#if defined(NWB_DEBUG)
        EXPECT_DEATH_IF_SUPPORTED(EXPECT_EQ(arena.allocate(3u, 32u), nullptr), "");
        EXPECT_DEATH_IF_SUPPORTED(EXPECT_EQ(arena.reallocate(sentinel, 3u, 64u), nullptr), "");
        EXPECT_DEATH_IF_SUPPORTED({ arena.deallocate(sentinel, 3u, 32u); }, "");
#else
        EXPECT_EQ(arena.allocate(3u, 32u), nullptr);
        EXPECT_EQ(arena.reallocate(sentinel, 3u, 64u), nullptr);
        arena.deallocate(sentinel, 3u, 32u);
#endif
        EXPECT_EQ(sentinel[0u], static_cast<u8>(s_AllocCaseScratchReuseSentinelByte));
        EXPECT_EQ(arena.memoryStats().usedBytes, before.usedBytes);
        EXPECT_EQ(arena.memoryStats().allocationCount, before.allocationCount);
        EXPECT_EQ(arena.memoryStats().reallocationCount, before.reallocationCount);
        EXPECT_EQ(arena.memoryStats().deallocationCount, before.deallocationCount);
        EXPECT_THROW(EXPECT_EQ(arena.allocate(256u, Limit<usize>::s_Max), nullptr), AllocationSizeException);
        EXPECT_EQ(arena.memoryStats().usedBytes, before.usedBytes);
        arena.deallocate(sentinel, 2u, 32u);
    }
    EXPECT_EQ(arena.memoryStats().usedBytes, 0u);
}

void VerifyScratchArenaReuse_AlignmentBucketsKeepIndependentLifoStacksAndCallerSentinels(){
    ScratchArena arena(s_AllocCaseScratchReuseAlignments, 256u);
    Array<AllocationRequest, 8> requests = Array<AllocationRequest, 8>();
    requests[0u] = MakeAllocationRequest(1u, 256u);
    requests[1u] = MakeAllocationRequest(8u, 256u);
    requests[2u] = MakeAllocationRequest(64u, 256u);
    requests[3u] = MakeAllocationRequest(256u, 256u);
    requests[4u] = MakeAllocationRequest(1u, 1536u);
    requests[5u] = MakeAllocationRequest(8u, 1536u);
    requests[6u] = MakeAllocationRequest(64u, 1536u);
    requests[7u] = MakeAllocationRequest(256u, 1536u);

    native(in requests, mut arena){
        constexpr Array<usize, 4u> s_Alignments = { 1u, 8u, 64u, 256u };
        Array<u8*, LengthOf(s_Alignments)> sentinels = {};
        for(usize index = 0u; index < LengthOf(s_Alignments); ++index){
            sentinels[index] = static_cast<u8*>(arena.allocate(s_Alignments[index], 64u));
            ASSERT_NE(sentinels[index], nullptr);
            sentinels[index][0u] = static_cast<u8>(index + s_AllocCaseScratchReuseSentinelByte);
            sentinels[index][63u] = static_cast<u8>(index + 83u);
        }
        const ArenaMemoryStats retained = arena.memoryStats();
        for(usize iteration = 0u; iteration < 16u; ++iteration){
            ASSERT_TRUE(RunAllocationBatch(requests, arena));
            EXPECT_EQ(arena.memoryStats().usedBytes, retained.usedBytes);
            for(usize index = 0u; index < LengthOf(s_Alignments); ++index){
                EXPECT_EQ(sentinels[index][0u], static_cast<u8>(index + s_AllocCaseScratchReuseSentinelByte));
                EXPECT_EQ(sentinels[index][63u], static_cast<u8>(index + 83u));
            }
        }
        // The alignment buckets are independent, so global reverse order is not required here.
        for(usize index = 0u; index < LengthOf(s_Alignments); ++index)
            arena.deallocate(sentinels[index], s_Alignments[index], 64u);
    }

    EXPECT_EQ(arena.memoryStats().usedBytes, 0u);
    EXPECT_EQ(arena.memoryStats().allocationCount, arena.memoryStats().deallocationCount);
}

void VerifyScratchArenaReuse_OutOfOrderFreeRemainsANoopUntilThatAllocationBecomesTop(){
    ScratchArena arena(s_AllocCaseScratchReuseOutOfOrder, 256u);
    native(mut arena){
        auto* first = static_cast<u8*>(arena.allocate(8u, s_AllocCaseScratchReuseBlockBytes));
        auto* second = static_cast<u8*>(arena.allocate(8u, s_AllocCaseScratchReuseBlockBytes));
        auto* third = static_cast<u8*>(arena.allocate(8u, 192u));
        ASSERT_NE(first, nullptr);
        ASSERT_NE(second, nullptr);
        ASSERT_NE(third, nullptr);
        first[0u] = static_cast<u8>(s_AllocCaseScratchReuseFirstSentinel);
        first[95u] = 29u;
        const ArenaMemoryStats before = arena.memoryStats();
        arena.deallocate(first, 8u, s_AllocCaseScratchReuseBlockBytes);
        EXPECT_EQ(arena.memoryStats().usedBytes, before.usedBytes);
        EXPECT_EQ(arena.memoryStats().deallocationCount, before.deallocationCount);
        arena.deallocate(third, 8u, 192u);
        arena.deallocate(second, 8u, s_AllocCaseScratchReuseBlockBytes);
        EXPECT_EQ(arena.memoryStats().usedBytes, s_AllocCaseScratchReuseBlockBytes);
        EXPECT_EQ(first[0u], static_cast<u8>(s_AllocCaseScratchReuseFirstSentinel));
        EXPECT_EQ(first[95u], 29u);
        arena.deallocate(first, 8u, s_AllocCaseScratchReuseBlockBytes);
    }
    EXPECT_EQ(arena.memoryStats().usedBytes, 0u);
    EXPECT_EQ(arena.memoryStats().deallocationCount, 3u);
}

void VerifyScratchArenaReuse_RelocatedAndZeroSizedTopReallocationsExposeThePreviousLiveChunk(){
    ScratchArena arena(s_AllocCaseScratchReuseRelocation, 256u);
    native(mut arena){
        auto* sentinel = static_cast<u8*>(arena.allocate(8u, 64u));
        auto* allocation = static_cast<u8*>(arena.allocate(8u, 128u));
        ASSERT_NE(sentinel, nullptr);
        ASSERT_NE(allocation, nullptr);
        sentinel[0u] = 41u;
        for(usize index = 0u; index < 128u; ++index)
            allocation[index] = static_cast<u8>(index);
        auto* grown = static_cast<u8*>(arena.reallocate(allocation, 8u, 1024u));
        ASSERT_NE(grown, nullptr);
        EXPECT_NE(grown, allocation);
        for(usize index = 0u; index < 128u; ++index)
            EXPECT_EQ(grown[index], static_cast<u8>(index));
        EXPECT_EQ(arena.memoryStats().usedBytes, 1088u);
        EXPECT_EQ(arena.memoryStats().allocationCount, 3u);
        EXPECT_EQ(arena.memoryStats().deallocationCount, 1u);
        EXPECT_EQ(arena.reallocate(grown, 8u, 256u), grown);
        EXPECT_EQ(arena.memoryStats().reallocationCount, 1u);
        EXPECT_EQ(arena.memoryStats().usedBytes, 320u);
        // Zero-size top resize returns the retired address.
        EXPECT_EQ(arena.reallocate(grown, 8u, 0u), grown);
        EXPECT_EQ(arena.memoryStats().usedBytes, 64u);
        EXPECT_EQ(sentinel[0u], 41u);
        arena.deallocate(sentinel, 8u, 64u);
        EXPECT_EQ(arena.memoryStats().usedBytes, 0u);
        EXPECT_EQ(arena.memoryStats().deallocationCount, 3u);

        auto* sole = static_cast<u8*>(arena.allocate(8u, 128u));
        ASSERT_NE(sole, nullptr);
        sole[0u] = 97u;
        auto* moved = static_cast<u8*>(arena.reallocate(sole, 8u, 8192u));
        ASSERT_NE(moved, nullptr);
        EXPECT_EQ(moved[0u], 97u);
        arena.deallocate(moved, 8u, 8192u);
    }
    EXPECT_EQ(arena.memoryStats().usedBytes, 0u);
    Array<AllocationRequest, 2> afterRelocation = Array<AllocationRequest, 2>();
    afterRelocation[0u] = MakeAllocationRequest(8u, 128u);
    afterRelocation[1u] = MakeAllocationRequest(8u, 8192u);
    ASSERT_TRUE(RunAllocationBatch(afterRelocation, arena));
    EXPECT_EQ(arena.memoryStats().usedBytes, 0u);
}

void VerifyScratchArenaReuse_ZeroByteOperationsRemainValidBeforeAndAfterCachingTheLastChunk(){
    ScratchArena arena(s_AllocCaseScratchReuseZeroBytes, 256u);
    native(mut arena){
        EXPECT_EQ(arena.allocate<u8>(0u), nullptr);
        EXPECT_EQ(arena.memoryStats().reservedBytes, 0u);
        void* zero = arena.allocate(8u, 0u);
        ASSERT_NE(zero, nullptr);
        arena.deallocate(zero, 8u, 0u);
        EXPECT_EQ(arena.memoryStats().usedBytes, 0u);
        EXPECT_EQ(arena.memoryStats().allocationCount, 0u);
        auto* allocation = static_cast<u8*>(arena.allocate(8u, 128u));
        ASSERT_NE(allocation, nullptr);
        allocation[0u] = 43u;
        void* zeroAtTop = arena.allocate(8u, 0u);
        ASSERT_NE(zeroAtTop, nullptr);
        arena.deallocate(zeroAtTop, 8u, 0u);
        EXPECT_EQ(allocation[0u], 43u);
        EXPECT_EQ(arena.memoryStats().usedBytes, 128u);
        arena.deallocate(allocation, 8u, 128u);
        arena.deallocate(zeroAtTop, 8u, 0u);
        const ArenaMemoryStats cached = arena.memoryStats();
        EXPECT_EQ(cached.usedBytes, 0u);
        void* reusedZero = arena.allocate(8u, 0u);
        ASSERT_NE(reusedZero, nullptr);
        arena.deallocate(reusedZero, 8u, 0u);
        EXPECT_EQ(arena.memoryStats().reservedBytes, cached.reservedBytes);
        EXPECT_EQ(arena.memoryStats().allocationCount, cached.allocationCount);
        EXPECT_EQ(arena.memoryStats().deallocationCount, cached.deallocationCount);
        void* resized = arena.allocate(8u, 64u);
        ASSERT_NE(resized, nullptr);
        EXPECT_EQ(arena.reallocate(resized, 8u, 0u), resized);
        arena.deallocate(resized, 8u, 0u);
    }
    EXPECT_EQ(arena.memoryStats().usedBytes, 0u);
    EXPECT_EQ(arena.memoryStats().allocationCount, 2u);
    EXPECT_EQ(arena.memoryStats().deallocationCount, 2u);
}

void VerifyScratchArenaReuse_ZeroInitialCapacityNeedsPositiveBackingBeforeRawZeroAllocation(){
    ScratchArena arena(s_AllocCaseScratchReuseZeroInitialCapacity, 0u);
    ArenaMemoryStats cached = ArenaMemoryStats();
    native(mut arena, mut cached){
        EXPECT_EQ(arena.allocate(8u, 0u), nullptr);
        EXPECT_EQ(arena.memoryStats().reservedBytes, 0u);
        EXPECT_EQ(arena.memoryStats().allocationCount, 0u);
        void* allocation = arena.allocate(8u, 9u);
        ASSERT_NE(allocation, nullptr);
        arena.deallocate(allocation, 8u, 9u);
        cached = arena.memoryStats();
        EXPECT_NE(arena.allocate(8u, 0u), nullptr);
    }
    EXPECT_EQ(arena.memoryStats().usedBytes, 0u);
    EXPECT_EQ(arena.memoryStats().reservedBytes, cached.reservedBytes);
    EXPECT_EQ(arena.memoryStats().allocationCount, cached.allocationCount);
}

void VerifyScratchArenaReuse_RelocationReusesCachedBackingAndUnlinksAnEmptiedFormerTop(){
    const usize cachedBytes = 1024u;
    ScratchArena arena(s_AllocCaseScratchReuseCachedRelocation, 256u);
    native(in cachedBytes, mut arena){
        auto* sentinel = static_cast<u8*>(arena.allocate(8u, 64u));
        auto* allocation = static_cast<u8*>(arena.allocate(8u, 128u));
        void* cached = arena.allocate(8u, cachedBytes);
        ASSERT_NE(sentinel, nullptr);
        ASSERT_NE(allocation, nullptr);
        ASSERT_NE(cached, nullptr);
        sentinel[0u] = 79u;
        for(usize index = 0u; index < 128u; ++index)
            allocation[index] = static_cast<u8>(index + 11u);
        arena.deallocate(cached, 8u, cachedBytes);
        const ArenaMemoryStats beforeHeap = HeapBackingMemoryStats();
        auto* relocated = static_cast<u8*>(arena.reallocate(allocation, 8u, cachedBytes));
        const ArenaMemoryStats afterHeap = HeapBackingMemoryStats();
        ASSERT_NE(relocated, nullptr);
        EXPECT_EQ(relocated, cached);
        EXPECT_EQ(afterHeap.allocationCount, beforeHeap.allocationCount);
        EXPECT_EQ(afterHeap.deallocationCount, beforeHeap.deallocationCount);
        for(usize index = 0u; index < 128u; ++index)
            EXPECT_EQ(relocated[index], static_cast<u8>(index + 11u));
        arena.deallocate(relocated, 8u, cachedBytes);
        EXPECT_EQ(arena.memoryStats().usedBytes, 64u);
        EXPECT_EQ(sentinel[0u], 79u);
        arena.deallocate(sentinel, 8u, 64u);

        // Relocation must release the old chunk beneath the replacement block.
        allocation = static_cast<u8*>(arena.allocate(8u, 128u));
        ASSERT_NE(allocation, nullptr);
        allocation[0u] = 101u;
        relocated = static_cast<u8*>(arena.reallocate(allocation, 8u, cachedBytes));
        ASSERT_NE(relocated, nullptr);
        EXPECT_EQ(relocated, cached);
        EXPECT_EQ(relocated[0u], 101u);
        arena.deallocate(relocated, 8u, cachedBytes);
    }
    EXPECT_EQ(arena.memoryStats().usedBytes, 0u);
    Array<AllocationRequest, 2> requests = Array<AllocationRequest, 2>();
    requests[0u] = MakeAllocationRequest(8u, 128u);
    requests[1u] = MakeAllocationRequest(8u, 1024u);
    ASSERT_TRUE(RunAllocationBatch(requests, arena));
    EXPECT_EQ(arena.memoryStats().usedBytes, 0u);
    EXPECT_EQ(arena.memoryStats().allocationCount, arena.memoryStats().deallocationCount);
}

void VerifyScratchArenaReuse_FailedRelocationPreservesLiveAllocationsCachedChunksAndCounters(){
    const usize cachedBytes = 1536u;
    ScratchArena arena(s_AllocCaseScratchReuseFailedRelocation, 256u);
    native(in cachedBytes, mut arena){
        auto* sentinel = static_cast<u8*>(arena.allocate(1u, 64u));
        auto* allocation = static_cast<u8*>(arena.allocate(1u, 128u));
        void* cached = arena.allocate(1u, cachedBytes);
        ASSERT_NE(sentinel, nullptr);
        ASSERT_NE(allocation, nullptr);
        ASSERT_NE(cached, nullptr);
        sentinel[0u] = 131u;
        allocation[0u] = 139u;
        allocation[127u] = 149u;
        arena.deallocate(cached, 1u, cachedBytes);
        const ArenaMemoryStats before = arena.memoryStats();
        EXPECT_EQ(arena.reallocate(allocation, 1u, Limit<usize>::s_Max), nullptr);
        // Aligned request that overflows only when adding the chunk header.
        EXPECT_EQ(arena.allocate(256u, Limit<usize>::s_Max - 255u), nullptr);
        const ArenaMemoryStats after = arena.memoryStats();
        EXPECT_EQ(after.usedBytes, before.usedBytes);
        EXPECT_EQ(after.reservedBytes, before.reservedBytes);
        EXPECT_EQ(after.peakUsedBytes, before.peakUsedBytes);
        EXPECT_EQ(after.allocationCount, before.allocationCount);
        EXPECT_EQ(after.reallocationCount, before.reallocationCount);
        EXPECT_EQ(after.deallocationCount, before.deallocationCount);
        EXPECT_EQ(sentinel[0u], 131u);
        EXPECT_EQ(allocation[0u], 139u);
        EXPECT_EQ(allocation[127u], 149u);
        void* reused = arena.allocate(1u, cachedBytes);
        ASSERT_NE(reused, nullptr);
        EXPECT_EQ(reused, cached);
        arena.deallocate(reused, 1u, cachedBytes);
        arena.deallocate(allocation, 1u, 128u);
        arena.deallocate(sentinel, 1u, 64u);
    }
    EXPECT_EQ(arena.memoryStats().usedBytes, 0u);
}

void VerifyScratchArenaReuse_LargeSmallLargeRequestsDoNotRecreateUndersizedCachedChunks(){
    ScratchArena arena(s_AllocCaseScratchReuseMixedSizes, 256u);
    Array<AllocationRequest, 4> smallFirst = Array<AllocationRequest, 4>();
    smallFirst[0u] = MakeAllocationRequest(8u, 64u);
    smallFirst[1u] = MakeAllocationRequest(8u, 8192u);
    smallFirst[2u] = MakeAllocationRequest(8u, 96u);
    smallFirst[3u] = MakeAllocationRequest(8u, 512u);
    Array<AllocationRequest, 4> largeFirst = Array<AllocationRequest, 4>();
    largeFirst[0u] = MakeAllocationRequest(8u, 8192u);
    largeFirst[1u] = MakeAllocationRequest(8u, 96u);
    largeFirst[2u] = MakeAllocationRequest(8u, 64u);
    largeFirst[3u] = MakeAllocationRequest(8u, 8192u);
    for(usize iteration = 0u; iteration < 3u; ++iteration){
        ASSERT_TRUE(RunAllocationBatch(smallFirst, arena));
        ASSERT_TRUE(RunAllocationBatch(largeFirst, arena));
    }
    const ArenaMemoryStats warm = arena.memoryStats();
    const ArenaMemoryStats beforeHeap = HeapBackingMemoryStats();
    b8 valid = true;
    for(usize iteration = 0u; iteration < 64u; ++iteration){
        valid = valid && RunAllocationBatch(smallFirst, arena);
        valid = valid && RunAllocationBatch(largeFirst, arena);
    }
    const ArenaMemoryStats afterHeap = HeapBackingMemoryStats();
    EXPECT_TRUE(valid);
    EXPECT_EQ(arena.memoryStats().usedBytes, 0u);
    EXPECT_EQ(arena.memoryStats().reservedBytes, warm.reservedBytes);
    EXPECT_EQ(afterHeap.allocationCount, beforeHeap.allocationCount);
    EXPECT_EQ(afterHeap.deallocationCount, beforeHeap.deallocationCount);
}

void VerifyScratchArenaReuse_NestedContainerDestructionAndCallerUnwindPreserveEarlierStorage(){
    ScratchArena arena(s_AllocCaseScratchReuseNestedContainers, 256u);
    native(mut arena){
        Vector<u64, ScratchArena> caller(arena);
        caller.assign(48u, 0x12345678u);
        const ArenaMemoryStats retained = arena.memoryStats();
        ASSERT_TRUE(RunScopedCollection(s_AllocCaseScratchReuseCollectionCount, arena));
        const ArenaMemoryStats warm = arena.memoryStats();
        EXPECT_EQ(warm.usedBytes, retained.usedBytes);
        for(usize iteration = 0u; iteration < 16u; ++iteration){
            ASSERT_TRUE(RunScopedCollection(s_AllocCaseScratchReuseCollectionCount, arena));
            EXPECT_EQ(arena.memoryStats().usedBytes, retained.usedBytes);
            EXPECT_EQ(arena.memoryStats().reservedBytes, warm.reservedBytes);
        }
        EXPECT_THROW(([&](){
            Vector<u64, ScratchArena> outer(arena);
            outer.resize(2048u, 23u);
            Vector<u64, ScratchArena> inner(arena);
            inner.resize(4096u, 47u);
            throw RuntimeException("scratch nested scope unwind");
        })(), RuntimeException);
        EXPECT_EQ(arena.memoryStats().usedBytes, retained.usedBytes);
        for(const u64 value : caller)
            EXPECT_EQ(value, 0x12345678u);
    }
}

b8 TryReadArenaOwnerStats(in Name ownerName, mut ArenaMemoryStats outStats){
    b8 found = false;
    native(in ownerName, mut outStats, mut found){
        const ArenaMemoryOwnerRecord* record = FirstArenaMemoryOwnerRecord();
        while(record){
            ArenaMemoryOwnerSnapshot owner;
            record = ReadArenaMemoryOwnerRecord(*record, owner);
            if(owner.ownerName == ownerName && owner.source == ArenaMemorySource::Arena){
                outStats = owner.stats;
                found = true;
                break;
            }
        }
    }
    return found;
}

void VerifyScratchArenaReuse_OwnerTelemetryRetainsHistoryAndSeparatesReservedBackingFromUsage(){
    ArenaMemoryStats before = ArenaMemoryStats();
    TryReadArenaOwnerStats(s_ScratchReuseOwnerLifecycle, before);
    ArenaMemoryStats live = ArenaMemoryStats();
    {
        ScratchArena arena(s_ScratchReuseOwnerLifecycle, 256u);
        Array<AllocationRequest, 3> requests = Array<AllocationRequest, 3>();
        requests[0u] = MakeAllocationRequest(8u, 192u);
        requests[1u] = MakeAllocationRequest(8u, 128u);
        requests[2u] = MakeAllocationRequest(8u, 768u);
        ASSERT_TRUE(RunAllocationBatch(requests, arena));
        live = arena.memoryStats();
        EXPECT_EQ(live.usedBytes, 0u);
        EXPECT_GT(live.reservedBytes, 0u);
        ArenaMemoryStats liveOwner = ArenaMemoryStats();
        const b8 foundLive = TryReadArenaOwnerStats(s_ScratchReuseOwnerLifecycle, liveOwner);
        EXPECT_TRUE(foundLive);
        if(foundLive){
            EXPECT_EQ(liveOwner.usedBytes, 0u);
            EXPECT_EQ(liveOwner.reservedBytes, live.reservedBytes);
            EXPECT_EQ(liveOwner.allocationCount, before.allocationCount + live.allocationCount);
            EXPECT_EQ(liveOwner.deallocationCount, before.deallocationCount + live.deallocationCount);
        }
    }
    ArenaMemoryStats afterOwner = ArenaMemoryStats();
    const b8 foundAfter = TryReadArenaOwnerStats(s_ScratchReuseOwnerLifecycle, afterOwner);
    EXPECT_TRUE(foundAfter);
    if(foundAfter){
        EXPECT_EQ(afterOwner.usedBytes, 0u);
        EXPECT_EQ(afterOwner.reservedBytes, 0u);
        EXPECT_EQ(afterOwner.allocationCount, before.allocationCount + live.allocationCount);
        EXPECT_EQ(afterOwner.deallocationCount, before.deallocationCount + live.deallocationCount);
        EXPECT_EQ(afterOwner.peakUsedBytes, Max(before.peakUsedBytes, live.peakUsedBytes));
    }
}

void VerifyAllocatorUsageBoundaries_GlobalArenaChargesUsableBytesAcrossOddSizeReallocations(){
    const usize oddBytes = 13u;
    GlobalArena arena(s_AllocationOwnersOddReallocation);
    native(in oddBytes, mut arena){
        auto* pointer = static_cast<u8*>(arena.allocate(1u, oddBytes));
        ASSERT_NE(pointer, nullptr);
        for(usize index = 0u; index < oddBytes; ++index)
            pointer[index] = static_cast<u8>(index + 1u);
        EXPECT_EQ(arena.memoryStats().usedBytes, Core::Alloc::CoreMsize(pointer));
        EXPECT_EQ(arena.memoryStats().reservedBytes, Core::Alloc::CoreMsize(pointer));

        auto* replacement = static_cast<u8*>(arena.reallocate(pointer, 1u, 21u));
        ASSERT_NE(replacement, nullptr);
        pointer = replacement;
        for(usize index = 0u; index < oddBytes; ++index)
            EXPECT_EQ(pointer[index], static_cast<u8>(index + 1u));
        EXPECT_EQ(arena.memoryStats().usedBytes, Core::Alloc::CoreMsize(pointer));
        EXPECT_EQ(OwnerStats(s_AllocationOwnersOddReallocation).usedBytes, Core::Alloc::CoreMsize(pointer));

        replacement = static_cast<u8*>(arena.reallocate(pointer, 1u, 7u));
        ASSERT_NE(replacement, nullptr);
        pointer = replacement;
        EXPECT_EQ(arena.memoryStats().usedBytes, Core::Alloc::CoreMsize(pointer));
        const ArenaMemoryStats beforeFailure = arena.memoryStats();
        // Windows debug builds can use a separate CRT errno in the allocator DLL.
        errno = ERANGE;
        void* backendInvalidAlignment = scalable_aligned_realloc(pointer, 0u, 3u);
        const i32 backendInvalidAlignmentError = errno;
        errno = ERANGE;
        void* invalidAlignment = arena.reallocate(pointer, 3u, 0u);
        const i32 invalidAlignmentError = errno;
        EXPECT_EQ(invalidAlignment, nullptr);
        EXPECT_EQ(invalidAlignment, backendInvalidAlignment);
        EXPECT_EQ(invalidAlignmentError, backendInvalidAlignmentError);
        EXPECT_EQ(arena.reallocate(pointer, 1u, Limit<usize>::s_Max), nullptr);
        EXPECT_EQ(arena.memoryStats().usedBytes, beforeFailure.usedBytes);
        EXPECT_EQ(arena.memoryStats().reservedBytes, beforeFailure.reservedBytes);
        EXPECT_EQ(arena.memoryStats().reallocationCount, beforeFailure.reallocationCount);
        EXPECT_EQ(arena.memoryStats().deallocationCount, beforeFailure.deallocationCount);
        EXPECT_EQ(pointer[0u], 1u);
        arena.deallocate(pointer, 1u, 7u);
    }
    EXPECT_EQ(arena.memoryStats().usedBytes, 0u);
    EXPECT_EQ(arena.memoryStats().reservedBytes, 0u);
    EXPECT_EQ(OwnerStats(s_AllocationOwnersOddReallocation).usedBytes, 0u);
    EXPECT_EQ(OwnerStats(s_AllocationOwnersOddReallocation).reservedBytes, 0u);
    EXPECT_EQ(arena.memoryStats().allocationCount, 1u);
    EXPECT_EQ(arena.memoryStats().reallocationCount, 2u);
    EXPECT_EQ(arena.memoryStats().deallocationCount, 1u);
}

void VerifyAllocatorUsageBoundaries_ZeroSizeReallocationReleasesChargedBytes(){
    GlobalArena arena(s_AllocationOwnersObjectAndZero);
    native(mut arena){
        void* allocation = arena.allocate(64u, 13u);
        ASSERT_NE(allocation, nullptr);
        EXPECT_EQ(arena.reallocate(allocation, 64u, 0u), nullptr);
    }
    EXPECT_EQ(arena.memoryStats().usedBytes, 0u);
    EXPECT_EQ(arena.memoryStats().reservedBytes, 0u);
    EXPECT_EQ(arena.memoryStats().allocationCount, 1u);
    EXPECT_EQ(arena.memoryStats().deallocationCount, 1u);
    EXPECT_EQ(OwnerStats(s_AllocationOwnersObjectAndZero).usedBytes, 0u);
}

