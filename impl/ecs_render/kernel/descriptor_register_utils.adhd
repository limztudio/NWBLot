native{
#include <impl/global.adhd.h>

#include <core/graphics/api.h>
#include <core/graphics/backend_selection/backend.h>
#include <core/graphics/rhi/gpu_descriptor_heap.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace RendererDescriptorRegisterDetail{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] inline b8 IsDescriptorClass(const Core::GpuDescriptorHandle handle, const Core::GpuDescriptorClass::Enum descriptorClass)noexcept{
    return handle.valid() && handle.descriptorClass() == descriptorClass;
}

inline void RetireDescriptor(Core::GpuDescriptorHeap& heap, Core::GpuDescriptorHandle& inOutHandle)noexcept{
    if(inOutHandle.valid() && heap.isInitialized())
        heap.free(inOutHandle);
    inOutHandle = Core::GpuDescriptorHandle::Invalid();
}

[[nodiscard]] inline Expected<Core::GpuDescriptorHandle> RegisterDescriptor(Core::GpuDescriptorHeap& heap, const Core::GpuDescriptorClass::Enum descriptorClass, const Core::DescriptorWriteItem& item){
    const Expected<Core::GpuDescriptorHandle> allocated = heap.allocate(descriptorClass);
    if(!allocated)
        return MakeUnexpected(allocated.error());
    const Core::GpuDescriptorHandle handle = *allocated;
    Core::GpuDescriptorRetirementGuard retireUnpublished(heap, handle);

    if(heap.write(handle, item)){
        retireUnpublished.release();
        return handle;
    }
    return MakeUnexpected(Failure{});
}

[[nodiscard]] inline b8 AssignDescriptor(Core::GpuDescriptorHeap& heap, const Core::GpuDescriptorClass::Enum descriptorClass, const Core::DescriptorWriteItem& item, Core::GpuDescriptorHandle& outHandle){
    const Expected<Core::GpuDescriptorHandle> descriptor = RegisterDescriptor(heap, descriptorClass, item);
    if(!descriptor)
        return false;
    outHandle = *descriptor;
    return true;
}

[[nodiscard]] inline b8 ReplaceDescriptor(Core::GpuDescriptorHeap& heap, const Core::GpuDescriptorClass::Enum descriptorClass, const Core::DescriptorWriteItem& item, Core::GpuDescriptorHandle& inOutHandle){
    const Expected<Core::GpuDescriptorHandle> descriptor = RegisterDescriptor(heap, descriptorClass, item);
    if(!descriptor)
        return false;
    Core::GpuDescriptorRetirementGuard retireUnpublished(heap, *descriptor);
    if(inOutHandle.valid())
        heap.free(inOutHandle);
    inOutHandle = *descriptor;
    retireUnpublished.release();
    return true;
}

[[nodiscard]] inline Expected<Core::GpuDescriptorHandle> RegisterSampledTexture(
    Core::GpuDescriptorHeap& heap,
    const Core::GpuDescriptorClass::Enum descriptorClass,
    const Core::TextureHandle& texture,
    const Core::Format::Enum format = Core::Format::UNKNOWN,
    const Core::TextureSubresourceSet& subresources = Core::s_AllSubresources,
    const Core::TextureDimension::Enum dimension = Core::TextureDimension::Unknown
){
    return RegisterDescriptor(heap, descriptorClass, Core::DescriptorWriteItem::TextureSrv(0u, texture.get(), format, subresources, dimension));
}

[[nodiscard]] inline b8 AssignSampledTexture(
    Core::GpuDescriptorHeap& heap,
    const Core::GpuDescriptorClass::Enum descriptorClass,
    const Core::TextureHandle& texture,
    const Core::Format::Enum format,
    const Core::TextureSubresourceSet& subresources,
    const Core::TextureDimension::Enum dimension,
    Core::GpuDescriptorHandle& outHandle
){
    const Expected<Core::GpuDescriptorHandle> descriptor = RegisterSampledTexture(heap, descriptorClass, texture, format, subresources, dimension);
    if(!descriptor)
        return false;
    outHandle = *descriptor;
    return true;
}

[[nodiscard]] inline Expected<Core::GpuDescriptorHandle> RegisterStorageTexture(
    Core::GpuDescriptorHeap& heap,
    const Core::TextureHandle& texture,
    const Core::Format::Enum format = Core::Format::UNKNOWN,
    const Core::TextureDimension::Enum dimension = Core::TextureDimension::Unknown
){
    return RegisterDescriptor(heap, Core::GpuDescriptorClass::StorageImage, Core::DescriptorWriteItem::TextureUav(0u, texture.get(), format, Core::s_AllSubresources, dimension));
}

[[nodiscard]] inline b8 AssignStorageTexture(
    Core::GpuDescriptorHeap& heap,
    const Core::TextureHandle& texture,
    const Core::Format::Enum format,
    const Core::TextureDimension::Enum dimension,
    Core::GpuDescriptorHandle& outHandle
){
    const Expected<Core::GpuDescriptorHandle> descriptor = RegisterStorageTexture(heap, texture, format, dimension);
    if(!descriptor)
        return false;
    outHandle = *descriptor;
    return true;
}

[[nodiscard]] inline Expected<Core::GpuDescriptorHandle> RegisterSampler(Core::GpuDescriptorHeap& heap, Core::Sampler& sampler){
    return RegisterDescriptor(heap, Core::GpuDescriptorClass::Sampler, Core::DescriptorWriteItem::Sampler(0u, &sampler));
}

[[nodiscard]] inline Expected<Core::GpuDescriptorHandle> RegisterStructuredBuffer(Core::GpuDescriptorHeap& heap, Core::Buffer& buffer){
    return RegisterDescriptor(heap, Core::GpuDescriptorClass::StorageBuffer, Core::DescriptorWriteItem::StructuredBufferSrv(0u, &buffer));
}

[[nodiscard]] inline b8 AssignStructuredBufferUav(Core::GpuDescriptorHeap& heap, Core::Buffer& buffer, Core::GpuDescriptorHandle& outHandle){
    return AssignDescriptor(heap, Core::GpuDescriptorClass::StorageBuffer, Core::DescriptorWriteItem::StructuredBufferUav(0u, &buffer), outHandle);
}

[[nodiscard]] inline Expected<Core::GpuDescriptorHandle> RegisterConstantBuffer(Core::GpuDescriptorHeap& heap, Core::Buffer& buffer){
    return RegisterDescriptor(heap, Core::GpuDescriptorClass::UniformBuffer, Core::DescriptorWriteItem::ConstantBuffer(0u, &buffer));
}

[[nodiscard]] inline Expected<Core::GpuDescriptorHandle> RegisterConstantBuffer(Core::GpuDescriptorHeap& heap, const Core::BufferHandle& buffer){
    return RegisterDescriptor(heap, Core::GpuDescriptorClass::UniformBuffer, Core::DescriptorWriteItem::ConstantBuffer(0u, buffer.get()));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END
}


