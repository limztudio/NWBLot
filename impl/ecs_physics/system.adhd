    public b8 attachVehicleTrailer(
        in EntityID vehicleEntity,
        in EntityID trailerEntity,
        in VectorSingle localHitchChassis,
        in VectorSingle localHitchTrailer,
        in f32 swingLimitRad
    ){
        if(!vehicleEntity.valid() || !this.m_world.alive(vehicleEntity) || !trailerEntity.valid() || !this.m_world.alive(trailerEntity))
            return false;
        const Optional<mut VehicleComponent> vcOpt = this.m_world.borrowComponent<VehicleComponent>(vehicleEntity);
        if(!vcOpt.has_value())
            return false;
        const BodyId trailerBodyId = this.bodyForEntity(trailerEntity);
        if(!trailerBodyId.valid())
            return false;
        const VectorSingle vehScale = Abs(ResolveEntityWorldScale(vehicleEntity, this.m_world));
        const VectorSingle trScale = Abs(ResolveEntityWorldScale(trailerEntity, this.m_world));
        const VectorSingle scaledChassis = VectorSetW(VectorSingle(localHitchChassis) * vehScale, 0.0f);
        const VectorSingle scaledTrailer = VectorSetW(VectorSingle(localHitchTrailer) * trScale, 0.0f);
        return vcOpt.value().controller.attachTrailer(this.m_physicsWorld, trailerBodyId, scaledChassis, scaledTrailer, swingLimitRad);
    }

    public b8 detachVehicleTrailer(in EntityID vehicleEntity){
        if(!vehicleEntity.valid() || !this.m_world.alive(vehicleEntity))
            return false;
        const Optional<mut VehicleComponent> vcOpt = this.m_world.borrowComponent<VehicleComponent>(vehicleEntity);
        if(!vcOpt.has_value())
            return false;
        vcOpt.value().controller.detachTrailer(this.m_physicsWorld);
        return true;
    }

    public b8 setGravityScale(in EntityID entity, in f32 gravityScale){
        const auto found = this.m_entityRecords.find(entity);
        if(found == this.m_entityRecords.end() || found.value().attachedToParentBody || !found.value().bodyId.valid())
            return false;
        const BodyId bodyId = found.value().bodyId;
        if(!this.m_physicsWorld.setGravityScale(bodyId, gravityScale))
            return false;
        if(this.m_world.alive(entity)){
            const Optional<mut RigidBodyComponent> rbOpt = this.m_world.borrowComponent<RigidBodyComponent>(entity);
            if(rbOpt.has_value())
                rbOpt.value().gravityScale = gravityScale;
        }
        return true;
    }

    public b8 setBodyBullet(in EntityID entity, in b8 isBullet){
        const auto found = this.m_entityRecords.find(entity);
        if(found == this.m_entityRecords.end() || found.value().attachedToParentBody || !found.value().bodyId.valid())
            return false;
        const BodyId bodyId = found.value().bodyId;
        if(!this.m_physicsWorld.setBodyBullet(bodyId, isBullet))
            return false;
        if(this.m_world.alive(entity)){
            const Optional<mut RigidBodyComponent> rbOpt = this.m_world.borrowComponent<RigidBodyComponent>(entity);
            if(rbOpt.has_value())
                rbOpt.value().isBullet = isBullet;
        }
        return true;
    }

    public b8 setBodyMaxAngularVelocity(in EntityID entity, in f32 maxAngularVelocity){
        const auto found = this.m_entityRecords.find(entity);
        if(found == this.m_entityRecords.end() || found.value().attachedToParentBody || !found.value().bodyId.valid())
            return false;
        const BodyId bodyId = found.value().bodyId;
        if(!this.m_physicsWorld.setBodyMaxAngularVelocity(bodyId, maxAngularVelocity))
            return false;
        if(this.m_world.alive(entity)){
            const Optional<mut RigidBodyComponent> rbOpt = this.m_world.borrowComponent<RigidBodyComponent>(entity);
            if(rbOpt.has_value()){
                rbOpt.value().maxAngularVelocity = maxAngularVelocity;
                rbOpt.value().hasCustomMaxAngularVelocity = (maxAngularVelocity > 0.0f);
            }
        }
        return true;
    }

