    const GraphicsTestPath root(fixtureArena, "tests/metadata_extension/assets");
    const GraphicsTestPath path = JoinGraphicsPath(root, "invalid_shader.nwb");
    const DiscoveredNwbFile file(fixtureArena, root, path, "tests/metadata_extension/assets/invalid_shader.nwb", s_ProjectVirtualRoot);
    for(usize iteration = 0u; iteration < 4u; ++iteration){
        EXPECT_TRUE(RunGraphicsParserFailureIteration(ownerArena, file, document, scratchArena));
