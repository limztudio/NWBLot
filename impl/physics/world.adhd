    public Expected<ShapeId> createPlaneShape(in BodyId bodyId, in ShapeDef def, in PlaneShape plane){
        if(!this.isValidBody(bodyId) || !this.validateShapeDef(def))
            return MakeUnexpected(Failure());
        if(this.m_bodies[bodyId.index].type == BodyType::Dynamic && !plane.isFiniteExtent())
            return MakeUnexpected(Failure());
        const VectorSingle n = plane.normal();
        if(!IsFinite(n.xyz) || Vector3LengthSq(n).x <= s_NormalizeEpsilonSq || !IsFinite(VectorSingle(plane.offset(), plane.halfExtent.x, plane.halfExtent.z, 0.0f)) || Abs(VectorSingle(plane.offset())).x > s_HugeCoordinate)
            return MakeUnexpected(Failure());
        if(plane.halfExtent.x < 0.0f || plane.halfExtent.z < 0.0f)
            return MakeUnexpected(Failure());
        PlaneShape normPlane = plane;
        normPlane.normalOffset = f32x4(SafeNormalizeVec3(n, VectorSingle(0.0f, 1.0f, 0.0f, 0.0f)), plane.offset());
        Shape proto;
        proto.type = ShapeType::Plane;
        proto.setPlane(normPlane);
        return this.attachPreparedShapeInternal(bodyId, def, proto);
    }

