#include <impl/ecs_render/csg/clip_bounds.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class CsgIntervalComputeDispatchPlan{
    public CsgIntervalDispatchPushConstants pushConstants;
    public u32 groupsX = 0u;
    public u32 groupsY = 0u;
    public b8 active = false;
}

CsgIntervalComputeDispatchPlan BuildCsgIntervalComputeDispatchPlan(
    in CsgFrameWorkRegion workRegion,
    in u32 frameWidth,
    in u32 frameHeight,
    in u32 csgPeelLayerCount,
    in u32 receiverCount,
    in u32 meshViewHeapSlot,
    in u32 csgContextHeapSlot,
    in u32 groupSizeX,
    in u32 groupSizeY
){
    CsgIntervalComputeDispatchPlan plan;
    plan.pushConstants = ResolveCsgIntervalDispatchPushConstants(
        workRegion,
        frameWidth,
        frameHeight,
        csgPeelLayerCount,
        receiverCount,
        meshViewHeapSlot,
        csgContextHeapSlot
    );
    if(plan.pushConstants.workExtentX == 0u || plan.pushConstants.workExtentY == 0u)
        return plan;
    plan.groupsX = DivideUp(plan.pushConstants.workExtentX, groupSizeX);
    plan.groupsY = DivideUp(plan.pushConstants.workExtentY, groupSizeY);
    plan.active = true;
    return plan;
}

b8 HasValidCsgIntervalSampleTargetState(
    in b8 hasReceiverEventData,
    in b8 hasReceiverEventCount,
    in b8 hasRemovedIntervalDepth,
    in b8 hasRemovedIntervalCapNormal,
    in b8 hasRemovedIntervalData,
    in b8 hasRemovedIntervalCount,
    in u32 receiverEventLayerCount,
    in u32 removedIntervalLayerCount
){
    return hasReceiverEventData
        && hasReceiverEventCount
        && hasRemovedIntervalDepth
        && hasRemovedIntervalCapNormal
        && hasRemovedIntervalData
        && hasRemovedIntervalCount
        && receiverEventLayerCount != 0u
        && removedIntervalLayerCount != 0u
    ;
}

b8 HasValidCsgIntervalPeelTargetState(
    in b8 hasCapBackNormal,
    in b8 hasIntervalDepth,
    in b8 hasIntervalId,
    in b8 hasReceiverSpanData,
    in b8 hasReceiverSpanCount,
    in u32 peelLayerCount,
    in u32 receiverSpanLayerCount,
    in b8 sampleTargetsValid
){
    return sampleTargetsValid
        && hasCapBackNormal
        && hasIntervalDepth
        && hasIntervalId
        && hasReceiverSpanData
        && hasReceiverSpanCount
        && peelLayerCount != 0u
        && receiverSpanLayerCount != 0u
    ;
}


