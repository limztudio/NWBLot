inline constexpr AStringView s_BunchItemsField = "items";
inline constexpr AStringView s_BunchValuesField = "values";
inline constexpr AStringView s_BunchIdField = "id";
inline constexpr AStringView s_ProjectFixturesBundleFirst = "project/fixtures/bundle/first";
inline constexpr AStringView s_BunchLocal = "local";
inline constexpr AStringView s_BunchLabel = "label";
inline constexpr AStringView s_ASeparatelyOwnedMetadataString = "a separately owned metadata string";
inline constexpr TStringView s_DoesNotTargetADeclaredAsset = NWB_TEXT("does not target a declared asset");

inline constexpr AStringView s_BunchOwnershipMetadata = R"(
metadata local = { "label": "a separately owned metadata string", "items": [1, 2, 3] };
probe first;
probe second;
first.local = local;
first.target = second;
second.items = [local, { "target": first }];
asset_bunch bunch = [second, first];
)";

struct BunchFixture{
    Core::Metascript::MetaArena metadataArena{ Name(s_AssetCaseTestsAssetBunchMetadata) };
    Core::Assets::AssetArena outputArena{ Name(s_AssetCaseTestsAssetBunchOutput) };
    Core::Alloc::ScratchArena scratchArena{ Name(s_AssetCaseTestsAssetBunchScratch) };
    Core::Metascript::Document document{ metadataArena };
    const NWB::Path assetRoot{ outputArena, "tests/asset_bunch/assets" };
    const NWB::Path filePath{ outputArena, "tests/asset_bunch/assets/fixtures/bundle.nwb" };
};

inline void VerifyOwnedBunchOutput(const Span<const Core::Assets::ExpandedAssetMetadata> output, const Core::Metascript::Document& document){
    using Core::Metascript::Value;
    ASSERT_EQ(output.size(), 2u);
    EXPECT_EQ(output[0u].virtualPath, Name("project/fixtures/bundle/second"));
    EXPECT_EQ(output[1u].virtualPath, Name(s_ProjectFixturesBundleFirst));
    const Value* const items = output[0u].value.findField(s_BunchItemsField);
    ASSERT_NE(items, nullptr);
    ASSERT_TRUE(items->isList());
    ASSERT_EQ(items->asList().size(), 2u);
    const Value* const label = items->asList()[0u].findField(s_BunchLabel);
    ASSERT_NE(label, nullptr);
    EXPECT_EQ(label->asString(), s_ASeparatelyOwnedMetadataString);
    const Value* const target = items->asList()[1u].findField(s_FieldTarget);
    ASSERT_NE(target, nullptr);
    EXPECT_EQ(target->asString(), s_ProjectFixturesBundleFirst);
    const Value* const first = document.findVariable("first");
    ASSERT_NE(first, nullptr);
    const Value* const sourceTarget = first->findField(s_FieldTarget);
    ASSERT_NE(sourceTarget, nullptr);
    EXPECT_TRUE(sourceTarget->isReference());
    EXPECT_EQ(sourceTarget->asReference(), "second");
    const Value* const sourceLocal = first->findField(s_BunchLocal);
    ASSERT_NE(sourceLocal, nullptr);
    EXPECT_TRUE(sourceLocal->isReference());
    EXPECT_EQ(sourceLocal->asReference(), s_BunchLocal);
}

[[nodiscard]] inline b8 ParseBunchLookupFixture(const AStringView metadata, const usize unusedDeclarations, BunchFixture& fixture){
    AString<Core::Alloc::ScratchArena> source(fixture.scratchArena);
    source.reserve(unusedDeclarations * 32u + metadata.size());
    for(usize index = 0u; index < unusedDeclarations; ++index)
        source += StringFormat(fixture.scratchArena, "metadata unused_{};\n", index);
    source.append(metadata.data(), metadata.size());
    return fixture.document.parse(AStringView(source));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


