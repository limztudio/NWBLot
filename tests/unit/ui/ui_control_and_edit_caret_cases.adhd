void VerifyUiControlInputTests_InvalidWheelCoordinatesAndDeltasNeverReachAcceptedActions(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    InputEvent event = MakeUiControlInputPointer(InputEventType::PointerWheel);
    event.scrollY = UiControlCaretQuietNaNF64();
    EXPECT_FALSE(self.queueNative(event));
    event.scrollY = -1.0;
    event.scrollX = UiControlCaretInfinityF64();
    EXPECT_FALSE(self.queueNative(event));
    event.scrollX = 0.0;
    event.position.x = UiControlCaretQuietNaNF32();
    EXPECT_FALSE(self.queueNative(event));
    EXPECT_TRUE(self.m_router.controlActions().empty());
}

void VerifyUiControlInputTests_BoundedControlActionsUseOneSharedSequenceAndOverflowOncePerProcess(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    for(usize index = 0u; index < s_InputMaxControlActions; ++index)
        EXPECT_FALSE(self.wheel().activationOverflow);
    EXPECT_TRUE(self.wheel().activationOverflow);
    EXPECT_EQ(self.m_router.controlActions().size(), s_InputMaxControlActions);
    EXPECT_FALSE(self.m_router.process().activationOverflow);
    u64 previousSequence = 0u;
    for(usize index = 0u; index < s_InputMaxControlActions; ++index){
        const Expected<ControlAction> actionResult1 = self.take();
        ASSERT_TRUE(actionResult1.has_value());
        EXPECT_GT(actionResult1.value().id.sequence, previousSequence);
        previousSequence = actionResult1.value().id.sequence;
    }
    EXPECT_FALSE(self.take().has_value());
    EXPECT_FALSE(self.wheel().activationOverflow);
    const Expected<ControlAction> actionResult2 = self.take();
    ASSERT_TRUE(actionResult2.has_value());
    EXPECT_GT(actionResult2.value().id.sequence, previousSequence);
}

void VerifyUiControlInputTests_FocusLossCancelsActionsAndResetDoesNotRestartTheirSequence(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    EXPECT_TRUE(self.wheel().pointerConsumed);
    const u64 previousSequence = self.m_router.controlActions()[0u].id.sequence;
    self.focus();
    InputEvent focusLost = InputEvent();
    focusLost.type = InputEventType::FocusLost;
    EXPECT_TRUE(self.send(focusLost).commandConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    self.m_router.reset();
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    EXPECT_TRUE(self.wheel().pointerConsumed);
    const Expected<ControlAction> actionResult = self.take();
    ASSERT_TRUE(actionResult.has_value());
    EXPECT_GT(actionResult.value().id.sequence, previousSequence);
}

void VerifyUiControlInputTests_AcceptedPopupMaskOwnsWheelAndListFocusAboveLowerHosts(mut UiControlInputTests self){
    PopupScope popup = PopupScope();
    popup.token.widget.value = 10u;
    popup.token.declarationGeneration = 5u;
    popup.token.instanceGeneration = 6u;
    popup.token.openGeneration = 7u;
    popup.bounds = MakeUiControlCaretRect(140.0f, 0.0f, 100.0f, 100.0f);
    popup.viewport = self.m_targets[0u].clip;
    popup.layer = 1u;
    HitTarget barrier = HitTarget();
    barrier.id = popup.token.widget;
    barrier.declarationGeneration = popup.token.declarationGeneration;
    barrier.rectangle = popup.bounds;
    barrier.clip = popup.viewport;
    barrier.popup = popup.token;
    barrier.layer = popup.layer;
    HitTarget upper = MakeUiControlInputHost(4u, 140.0f);
    upper.popup = popup.token;
    upper.layer = popup.layer;
    upper.paintOrder = 1u;
    Array<HitTarget, 3u> targets = Array<HitTarget, 3u>();
    targets[0u] = self.m_targets[0u];
    targets[1u] = barrier;
    targets[2u] = upper;
    ASSERT_TRUE(self.m_router.commitTargets(targets, 1u, MakeUiControlSingleScope(popup)));
    EXPECT_EQ(self.m_router.focus(), upper.id);
    EXPECT_TRUE(self.wheel().pointerConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.wheel(-1.0, MakeUiControlCaretPoint(150.0f, 20.0f)).pointerConsumed);
    const Expected<ControlAction> actionResult = self.m_router.consumeControlAction(upper.id, upper.declarationGeneration, upper.control);
    ASSERT_TRUE(actionResult.has_value());
    EXPECT_EQ(actionResult.value().popup, popup.token);
    EXPECT_EQ(actionResult.value().kind, ControlActionKind::Wheel);
}

void VerifyUiControlInputTests_ClosingPopupBlocksFocusHintAndHeldNavigationCannotReachReopenedScope(mut UiControlInputTests self){
    PopupScope popup = PopupScope();
    popup.token.widget.value = 10u;
    popup.token.declarationGeneration = 5u;
    popup.token.instanceGeneration = 6u;
    popup.token.openGeneration = 7u;
    popup.bounds = MakeUiControlCaretRect(140.0f, 0.0f, 100.0f, 100.0f);
    popup.viewport = self.m_targets[0u].clip;
    popup.layer = 1u;
    HitTarget barrier = HitTarget();
    barrier.id = popup.token.widget;
    barrier.declarationGeneration = popup.token.declarationGeneration;
    barrier.rectangle = popup.bounds;
    barrier.clip = popup.viewport;
    barrier.popup = popup.token;
    barrier.layer = popup.layer;
    HitTarget upper = MakeUiControlInputHost(4u, 140.0f);
    upper.popup = popup.token;
    upper.layer = popup.layer;
    upper.paintOrder = 1u;
    self.m_targets[0u].focusOnCommit = true;
    Array<HitTarget, 3u> targets = Array<HitTarget, 3u>();
    targets[0u] = self.m_targets[0u];
    targets[1u] = barrier;
    targets[2u] = upper;
    ASSERT_TRUE(self.m_router.commitTargets(targets, 1u, MakeUiControlSingleScope(popup)));
    EXPECT_TRUE(self.send(MakeUiControlInputKey(InputEventType::KeyDown, CoreKey::Down)).commandConsumed);
    self.m_router.closePopup(popup.token);
    ASSERT_TRUE(self.m_router.commitTargets(targets, 2u, MakeUiControlSingleScope(popup)));
    EXPECT_FALSE(self.m_router.focus().valid());
    ++popup.token.openGeneration;
    targets[1u].popup = popup.token;
    targets[2u].popup = popup.token;
    ASSERT_TRUE(self.m_router.commitTargets(targets, 3u, MakeUiControlSingleScope(popup)));
    EXPECT_EQ(self.m_router.focus(), upper.id);
    EXPECT_TRUE(self.send(MakeUiControlInputKey(InputEventType::KeyDown, CoreKey::Down, true)).commandConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.send(MakeUiControlInputKey(InputEventType::KeyUp, CoreKey::Down)).commandConsumed);
}

void VerifyUiControlInputTests_ActivationAlsoFencesItsCopiedControlEpoch(mut UiControlInputTests self){
    HitTarget target = MakeUiControlInputHost(1u, 0.0f);
    target.navigable = false;
    target.scrollable = false;
    target.activatable = true;
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiControlSingleTarget(target), 1u));
    self.click();
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    EXPECT_EQ(self.m_router.actions()[0u].control, target.control);
    ++target.control.instanceGeneration;
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiControlSingleTarget(target), 2u));
    EXPECT_TRUE(self.m_router.actions().empty());
    EXPECT_FALSE(self.m_router.consumeActivation(target.id));
}

void VerifyUiControlInputTests_ControlActivationAndGestureActionsShareOneMonotonicSequence(mut UiControlInputTests self){
    HitTarget button = MakeUiControlInputHost(4u, 140.0f);
    button.control = ControlToken();
    button.navigable = false;
    button.scrollable = false;
    button.activatable = true;
    Array<HitTarget, 4u> targets = Array<HitTarget, 4u>();
    targets[0u] = self.m_targets[0u];
    targets[1u] = self.m_targets[1u];
    targets[2u] = self.m_targets[2u];
    targets[3u] = button;
    ASSERT_TRUE(self.m_router.commitTargets(targets, 1u));
    self.click(MakeUiControlCaretPoint(150.0f, 10.0f));
    ASSERT_EQ(self.m_router.actions().size(), 1u);
    const u64 activationSequence = self.m_router.actions()[0u].id.sequence;
    EXPECT_TRUE(self.wheel().pointerConsumed);
    const Expected<ControlAction> actionResult = self.take();
    ASSERT_TRUE(actionResult.has_value());
    EXPECT_GT(actionResult.value().id.sequence, activationSequence);
    const u64 wheelSequence = actionResult.value().id.sequence;
    EXPECT_TRUE(self.send(MakeUiControlInputPointer(InputEventType::PrimaryDown, MakeUiControlCaretPoint(95.0f, 25.0f))).pointerConsumed);
    const Expected<PointerGesture> gestureResult = self.m_router.consumePointerGesture(self.m_targets[2u].id, 7u);
    ASSERT_TRUE(gestureResult.has_value());
    EXPECT_GT(gestureResult.value().id.sequence, wheelSequence);
}

