extern const u32 s_ShaderMeshEmulationVertexUv0ByteOffset;

[cpp_header("<impl/assets/graphics/mesh/runtime_constants.h>"), cpp_name("NWB_MESH_EMULATION_VERTEX_COLOR_BYTE_OFFSET")]
extern const u32 s_ShaderMeshEmulationVertexColorByteOffset;

[cpp_header("<impl/assets/graphics/mesh/runtime_constants.h>"), cpp_name("NWB_MESH_EMULATION_VERTEX_WORLD_POSITION_BYTE_OFFSET")]
extern const u32 s_ShaderMeshEmulationVertexWorldPositionByteOffset;

[cpp_header("<impl/assets/graphics/mesh/runtime_constants.h>"), cpp_name("NWB_MESH_EMULATION_VERTEX_BUFFER_INDEX")]
extern const u32 s_ShaderMeshEmulationVertexBufferIndex;
static_assert(size_of<MeshFrameHeapSlots>() == size_of<u32>() * s_ShaderMeshFrameHeapSlotCount, "Mesh frame heap-slot payload must stay a uint4");
static_assert(offset_of<MeshFrameHeapSlots>(instance) == size_of<u32>() * s_ShaderMeshFrameHeapSlotInstance, "Instance heap slot must map to frame heap lane x");
static_assert(offset_of<MeshFrameHeapSlots>(materialTyped) == size_of<u32>() * s_ShaderMeshFrameHeapSlotMaterialTyped, "Material heap slot must map to frame heap lane y");
static_assert(offset_of<MeshFrameHeapSlots>(view) == size_of<u32>() * s_ShaderMeshFrameHeapSlotView, "View heap slot must map to frame heap lane z");
static_assert(offset_of<MeshFrameHeapSlots>(generatedVertex) == size_of<u32>() * s_ShaderMeshFrameHeapSlotGeneratedVertex, "Generated-vertex heap slot must map to frame heap lane w");
static_assert(size_of<ShaderDrivenPushConstants>() == s_ShaderMeshPushConstantByteSize, "ShaderDrivenPushConstants layout must stay stable");
static_assert(offset_of<ShaderDrivenPushConstants>(meshletCount) == size_of<u32>() * s_ShaderMeshPushDispatchMeshletCount, "ShaderDrivenPushConstants dispatch.x must be meshlet count");
static_assert(offset_of<ShaderDrivenPushConstants>(instanceIndex) == size_of<u32>() * s_ShaderMeshPushDispatchInstanceIndex, "ShaderDrivenPushConstants dispatch.y must be instance index");
static_assert(offset_of<ShaderDrivenPushConstants>(materialConstantByteOffset) == size_of<u32>() * s_ShaderMeshPushDispatchMaterialConstantByteOffset, "ShaderDrivenPushConstants dispatch.z must be material constant byte offset");
static_assert(offset_of<ShaderDrivenPushConstants>(dispatchFlags) == size_of<u32>() * s_ShaderMeshPushDispatchFlags, "ShaderDrivenPushConstants dispatch.w must be dispatch flags");
static_assert(offset_of<ShaderDrivenPushConstants>(frameHeapSlots) == size_of<u32>() * s_ShaderMeshPushFrameHeapSlotWordOffset, "ShaderDrivenPushConstants frame heap slots must follow the viewport lanes");
static_assert(size_of<MeshComputePushConstants>() == s_ShaderMeshComputePushConstantByteSize);
static_assert(offset_of<MeshComputePushConstants>(generatedIndexByteOffset) == s_ShaderMeshComputeIndexByteOffset);
static_assert(size_of<MeshComputePushConstants>() <= s_MaxPushConstantSize);
static_assert(size_of<TransparentDrawPushConstants>() == s_ShaderAvboitDrawPushConstantByteSize, "TransparentDrawPushConstants layout must stay stable");
static_assert(size_of<TransparentDrawPushConstants>() <= s_MaxPushConstantSize, "Transparent draw push constants must fit the portable push constant budget");
static_assert(size_of<EmulatedVertex>() == s_EmulatedVertexStride, "EmulatedVertex layout must match the mesh emulation shader");
static_assert(offset_of<EmulatedVertex>(position) == s_ShaderMeshEmulationVertexPositionByteOffset, "EmulatedVertex position offset must match the mesh emulation shader");
static_assert(offset_of<EmulatedVertex>(normal) == s_ShaderMeshEmulationVertexNormalByteOffset, "EmulatedVertex normal offset must match the mesh emulation shader");
static_assert(offset_of<EmulatedVertex>(tangent) == s_ShaderMeshEmulationVertexTangentByteOffset, "EmulatedVertex tangent offset must match the mesh emulation shader");
static_assert(offset_of<EmulatedVertex>(uv0) == s_ShaderMeshEmulationVertexUv0ByteOffset, "EmulatedVertex uv0 offset must match the mesh emulation shader");
static_assert(offset_of<EmulatedVertex>(color) == s_ShaderMeshEmulationVertexColorByteOffset, "EmulatedVertex color offset must match the mesh emulation shader");
static_assert(offset_of<EmulatedVertex>(worldPosition) == s_ShaderMeshEmulationVertexWorldPositionByteOffset, "EmulatedVertex world-position offset must match the mesh emulation shader");
static_assert(align_of<EmulatedVertex>() >= align_of<f32x4>(), "EmulatedVertex must stay SIMD-aligned");
static_assert(align_of<SceneShadingGpuData>() >= align_of<f32x4>(), "SceneShadingGpuData must stay SIMD-aligned");
static_assert(size_of<SceneLightGpuData>() == size_of<f32>() * s_ShaderSceneLightRecordFloatCount, "SceneLightGpuData layout must match the shading shaders");
static_assert(align_of<SceneLightGpuData>() >= align_of<f32x4>(), "SceneLightGpuData must stay SIMD-aligned");
static_assert(s_EmulatedVertexBufferIndex == s_ShaderMeshEmulationVertexBufferIndex, "s_EmulatedVertexBufferIndex must match NWB_MESH_EMULATION_VERTEX_BUFFER_INDEX");


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


ShaderDrivenPushConstants BuildShaderDrivenPushConstants(
    in u32 meshletCount,
    in u32 instanceIndex,
    in u32 materialConstantByteOffset,
    in ViewportState viewportState,
    in MeshFrameHeapSlots frameHeapSlots,
    in u32 dispatchFlags
){
    const b8 hasViewport = !viewportState.viewports.empty();
    Viewport viewport = Viewport();
    Rect scissorRect = Rect();
    if(hasViewport){
        viewport = viewportState.viewports[0u];
        if(!viewportState.scissorRects.empty())
            scissorRect = viewportState.scissorRects[0u];
        else
            scissorRect = RectFromViewport(viewport);
    }
    return ResolveShaderDrivenPushConstants(
        meshletCount,
        instanceIndex,
        materialConstantByteOffset,
        hasViewport,
        VectorSingle(viewport.minX, viewport.minY, viewport.maxX, viewport.maxY),
        VectorSingle(cast<f32>(scissorRect.minX), cast<f32>(scissorRect.minY), cast<f32>(scissorRect.maxX), cast<f32>(scissorRect.maxY)),
        frameHeapSlots,
        dispatchFlags
    );
}

MeshFrameHeapSlots ResolveMeshFrameHeapSlots(in MeshFrameBindingSnapshot frameBindings, in u32 generatedVertex){
    assert(frameBindings.bindingValid());
    return MakeMeshFrameHeapSlots(
        frameBindings.instanceHeapHandle.slot(),
        frameBindings.materialTypedHeapHandle.slot(),
        frameBindings.meshView.heapHandle.slot(),
        generatedVertex
    );
}

MeshFrameHeapSlots ResolveMeshFrameHeapSlots(in MeshFrameBindingSnapshot frameBindings){
    return ResolveMeshFrameHeapSlots(frameBindings, 0u);
}

void SetShaderDrivenPushConstants(
    mut CommandList commandList,
    in u32 meshletCount,
    in u32 instanceIndex,
    in u32 materialConstantByteOffset,
    in ViewportState viewportState,
    in MeshFrameHeapSlots frameHeapSlots,
    in u32 dispatchFlags
){
    const ShaderDrivenPushConstants pushConstants = BuildShaderDrivenPushConstants(
        meshletCount,
        instanceIndex,
        materialConstantByteOffset,
        viewportState,
        frameHeapSlots,
        dispatchFlags
    );
    commandList.setPushConstants(pushConstants);
}

void SetTransparentDrawPushConstants(
    mut CommandList commandList,
    in u32 meshletCount,
    in u32 instanceIndex,
    in u32 materialConstantByteOffset,
    in ViewportState viewportState,
    in AvboitFrameTargets targets,
    in MeshFrameHeapSlots frameHeapSlots,
    in u32 dispatchFlags,
    in u32 csgContextHeapSlot,
    in b8 refractionCapture
){
    const TransparentDrawPushConstants pushConstants = ResolveTransparentDrawPushConstants(
        BuildShaderDrivenPushConstants(
            meshletCount,
            instanceIndex,
            materialConstantByteOffset,
            viewportState,
            frameHeapSlots,
            dispatchFlags
        ),
        BuildRendererAvboitPushConstants(targets),
        csgContextHeapSlot,
        refractionCapture
    );
    commandList.setPushConstants(pushConstants);
}

void SetEmulatedVertexAttribute(in Format format, in u32 offsetByteCount, in Name name, mut VertexAttributeDesc attribute){
    attribute.setFormat(format).setBufferIndex(s_EmulatedVertexBufferIndex).setOffset(offsetByteCount).setElementStride(s_EmulatedVertexStride).setName(name);
}


