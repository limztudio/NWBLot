#include "suite.adhd"
#include <tests/common/gtest_macros.adhd>
#include <tests/common/threads.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Path MakeTelemetryPublicationTestDirectory(){
    Path root = Path();
    const Expected<Path, ErrorCode> executableDirectory = ExecutablePaths().directory();
    if(executableDirectory.has_value()){
        for(u32 attempt = 0u; attempt < 128u; ++attempt){
            const String name = StringFormat("telemetry_publication_test_{}_{}", CurrentProcessId(), attempt);
            const Path candidate = executableDirectory.value() / StringView(name);
            const Expected<b8, ErrorCode> created = CreateDirectories(candidate);
            if(!created.has_value())
                break;
            if(created.value()){
                root = candidate;
                break;
            }
        }
    }
    return root;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyLoggerProtocolTests_MessagePayloadReadsUnalignedBytesAndPreservesEmbeddedNulls(mut LoggerProtocolTests self){
    HeapStorage storage;
    const PlatformStringView message = ProtocolText("A\0Z");
    const ProtocolMessage source = MakeProtocolMessage(storage, Timer(), LogType::Warning, message);
    Vector<u8> payload;
    ASSERT_TRUE(BuildMessagePayload(source, payload).has_value());

    Vector<u8> shifted;
    shifted.resize(s_NativeCharacterBytes, 0u);
    AppendTriviallyCopyableVector(shifted, Span<u8>(payload));
    const auto parsed = ParseMessagePayload(storage, Span<u8>(shifted).subspan(s_NativeCharacterBytes));
    ASSERT_TRUE(parsed.has_value());
    EXPECT_EQ(ProtocolMessageText(parsed.value()), message);

    shifted.back() = 1u;
    const auto malformed = ParseMessagePayload(storage, Span<u8>(shifted).subspan(s_NativeCharacterBytes));
    ASSERT_FALSE(malformed.has_value());
    EXPECT_FALSE(malformed.error().empty());
    EXPECT_EQ(ProtocolMessageText(parsed.value()), message);
}

void VerifyLoggerProtocolTests_CrashUploadAuthorizationMatchesBearerToken(mut LoggerProtocolTests self){
    EXPECT_TRUE(CrashUploadAuthorizationMatches("", ""));
    EXPECT_TRUE(CrashUploadAuthorizationMatches("", "bad"));
    EXPECT_FALSE(CrashUploadAuthorizationMatches(s_LoggerProtocolSecretToken, ""));
    EXPECT_FALSE(CrashUploadAuthorizationMatches(s_LoggerProtocolSecretToken, s_LoggerProtocolSecretToken));
    EXPECT_FALSE(CrashUploadAuthorizationMatches(s_LoggerProtocolSecretToken, "Bearer wrong"));
    EXPECT_FALSE(CrashUploadAuthorizationMatches(s_LoggerProtocolSecretToken, "Bearer secret-token "));

    const StringView prefix = "Bearer secret-token";
    const StringView header = StringView(s_LoggerProtocolHeaderBytes.data(), prefix.size());
    EXPECT_TRUE(CrashUploadAuthorizationMatches(s_LoggerProtocolSecretToken, header));
    EXPECT_FALSE(CrashUploadAuthorizationMatches(s_LoggerProtocolSecretToken, header.substr(0u, header.size() - 1u)));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyLoggerTelemetryPublication_TelemetryPublicationDoesNotReplaceExistingFinalFile(mut LoggerTelemetryPublication self){
    const Path root = MakeTelemetryPublicationTestDirectory();
    ASSERT_FALSE(root.empty());
    const Path destination = root / "payload.nwbs";
    const Path staging = root / "payload.nwbs.partial";

    Array<u8, 3> existingBytes = Array<u8, 3>();
    existingBytes[0] = 1u;
    existingBytes[1] = 2u;
    existingBytes[2] = 3u;
    Array<u8, 3> newBytes = Array<u8, 3>();
    newBytes[0] = 4u;
    newBytes[1] = 5u;
    newBytes[2] = 6u;
    ASSERT_TRUE(WriteBinaryFile(destination, Span<u8>(existingBytes)));

    const FilePublicationResult result = PublishDurableBytes(destination, Span<u8>(newBytes));
    EXPECT_FALSE(result.published);
    EXPECT_TRUE(result.stagingRetained);
    EXPECT_TRUE(result.error);

    Vector<u8> bytes = Vector<u8>();
    ASSERT_TRUE(ReadBinaryFile(destination, bytes).has_value());
    EXPECT_TRUE(BytesMatch(Span<u8>(bytes), Span<u8>(existingBytes)));
    ASSERT_TRUE(ReadBinaryFile(staging, bytes).has_value());
    EXPECT_TRUE(BytesMatch(Span<u8>(bytes), Span<u8>(newBytes)));
}

void VerifyLoggerTelemetryPublication_TelemetryPublicationDoesNotReplaceExistingStagingFile(mut LoggerTelemetryPublication self){
    const Path root = MakeTelemetryPublicationTestDirectory();
    ASSERT_FALSE(root.empty());
    const Path destination = root / "payload.nwbs";
    const Path staging = root / "payload.nwbs.partial";

    Array<u8, 2> existingBytes = Array<u8, 2>();
    existingBytes[0] = 7u;
    existingBytes[1] = 8u;
    Array<u8, 2> newBytes = Array<u8, 2>();
    newBytes[0] = 9u;
    newBytes[1] = 10u;
    ASSERT_TRUE(WriteBinaryFile(staging, Span<u8>(existingBytes)));

    const FilePublicationResult result = PublishDurableBytes(destination, Span<u8>(newBytes));
    EXPECT_FALSE(result.published);
    EXPECT_FALSE(result.stagingRetained);
    EXPECT_TRUE(result.error);

    Vector<u8> bytes = Vector<u8>();
    ASSERT_TRUE(ReadBinaryFile(staging, bytes).has_value());
    EXPECT_TRUE(BytesMatch(Span<u8>(bytes), Span<u8>(existingBytes)));
    const Expected<b8, ErrorCode> finalExists = FileExists(destination);
    ASSERT_TRUE(finalExists.has_value());
    EXPECT_FALSE(finalExists.value());
}

void VerifyLoggerTelemetryPublication_ConcurrentTelemetryPublishersCannotReplaceEachOther(mut LoggerTelemetryPublication self){
    HeapStorage firstArena = HeapStorage();
    HeapStorage secondArena = HeapStorage();
    const Path root = MakeTelemetryPublicationTestDirectory();
    ASSERT_FALSE(root.empty());
    const Path destination = root / "payload.nwbs";
    Array<u8, 2> firstBytes = Array<u8, 2>();
    firstBytes[0] = 21u;
    firstBytes[1] = 22u;
    Array<u8, 2> secondBytes = Array<u8, 2>();
    secondBytes[0] = 31u;
    secondBytes[1] = 32u;
    b8 firstPublished = false;
    b8 secondPublished = false;
    TestValueSlot<LoggerPublicationPath> firstSlot;
    mut LoggerPublicationPath firstPath = firstSlot.constructIn(firstArena, destination);
    TestValueSlot<LoggerPublicationPath> secondSlot;
    mut LoggerPublicationPath secondPath = secondSlot.constructIn(secondArena, destination);
    TestLatch start(1);
    TestThread first(lambda[mut start, in firstPath, in firstBytes, mut firstPublished]() -> void{
        start.wait();
        firstPublished = PublishDurableBytes(firstPath, Span<u8>(firstBytes)).published;
    });
    TestThread second(lambda[mut start, in secondPath, in secondBytes, mut secondPublished]() -> void{
        start.wait();
        secondPublished = PublishDurableBytes(secondPath, Span<u8>(secondBytes)).published;
    });
    start.count_down();
    first.join();
    second.join();
    EXPECT_NE(firstPublished, secondPublished);
    Vector<u8> bytes = Vector<u8>();
    ASSERT_TRUE(ReadBinaryFile(destination, bytes).has_value());
    if(firstPublished)
        EXPECT_TRUE(BytesMatch(Span<u8>(bytes), Span<u8>(firstBytes)));
    else
        EXPECT_TRUE(BytesMatch(Span<u8>(bytes), Span<u8>(secondBytes)));
}

void VerifyLoggerTelemetryPublication_TelemetryPublicationMovesCompletedBytesToNewFinalFile(mut LoggerTelemetryPublication self){
    const Path root = MakeTelemetryPublicationTestDirectory();
    ASSERT_FALSE(root.empty());
    const Path destination = root / "payload.nwbs";
    const Path staging = root / "payload.nwbs.partial";

    Array<u8, 3> data = Array<u8, 3>();
    data[0] = 11u;
    data[1] = 12u;
    data[2] = 13u;
    const FilePublicationResult result = PublishDurableBytes(destination, Span<u8>(data));
    EXPECT_TRUE(result.published);
    EXPECT_FALSE(result.stagingRetained);
    EXPECT_FALSE(result.error);

    Vector<u8> bytes = Vector<u8>();
    ASSERT_TRUE(ReadBinaryFile(destination, bytes).has_value());
    EXPECT_TRUE(BytesMatch(Span<u8>(bytes), Span<u8>(data)));
    const Expected<b8, ErrorCode> stagingExists = FileExists(staging);
    ASSERT_TRUE(stagingExists.has_value());
    EXPECT_FALSE(stagingExists.value());
}


