// limztudio@gmail.com
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


usize ComputePostGbufferNormalizeUseCapacity(in usize baseCapacity, in b8 geometrySetGraphOwned, in usize geometryResourceCount){
    if(geometrySetGraphOwned)
        return baseCapacity;
    return baseCapacity + geometryResourceCount;
}

b8 CanCaptureOpaqueRegularComputeEmulationPlan(
    in b8 materialFrameStatesGraphOwned,
    in b8 materialGeometryStatesGraphOwned,
    in b8 gbufferMaterialSampledTexturesCollected
){
    return materialFrameStatesGraphOwned && materialGeometryStatesGraphOwned && gbufferMaterialSampledTexturesCollected;
}

b8 CanCaptureOpaqueSharedComputeEmulationPlan(
    in b8 hasOpaqueCsgFrameWork,
    in b8 regularOutputOwned,
    in b8 materialFrameStatesGraphOwned,
    in b8 materialGeometryStatesGraphOwned,
    in b8 gbufferMaterialSampledTexturesCollected
){
    return !hasOpaqueCsgFrameWork
        && !regularOutputOwned
        && materialFrameStatesGraphOwned
        && materialGeometryStatesGraphOwned
        && gbufferMaterialSampledTexturesCollected;
}

b8 CanCaptureOpaqueCsgReceiverComputeEmulationPlan(
    in b8 hasOpaqueCsgFrameWork,
    in b8 hasCsgFrameGpuWork,
    in b8 materialFrameStatesGraphOwned,
    in b8 materialGeometryStatesGraphOwned,
    in b8 gbufferMaterialSampledTexturesCollected
){
    return hasOpaqueCsgFrameWork
        && hasCsgFrameGpuWork
        && materialFrameStatesGraphOwned
        && materialGeometryStatesGraphOwned
        && gbufferMaterialSampledTexturesCollected;
}

b8 IsSharedComputeEmulationRasterPhase(in usize phaseIndex, in usize phasesPerDraw){
    return phaseIndex % phasesPerDraw != 0u;
}

usize ResolveSharedComputeEmulationDrawIndex(in usize phaseIndex, in usize phasesPerDraw){
    return phaseIndex / phasesPerDraw;
}

b8 IsFinalSharedComputeEmulationPhase(in usize phaseIndex, in usize phaseCount){
    return phaseIndex + 1u == phaseCount;
}


