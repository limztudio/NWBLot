#include <impl/ecs_csg/deform_wall_clip.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Owns zero-crossing splits with the shared edge cache (never welds source verts) and interpolated attributes, emitting the kept split triangles.
// Keep side is distance >= 0; caller snaps |distance| <= boundaryEpsilon to zero first.
Expected<b8, CsgDeformViabilityReason> ClipCsgDeformWallShell(
    in CsgDeformShape shape,
    in f32 boundaryEpsilon,
    in u32 registryParameterByteSize,
    in Optional<Func<Expected<f32>(in VectorSingle, in CsgShapeInlineParameters)>> registryDistanceCallback,
    mut HashMap<u64, u32> edgeSplits,
    mut Vector<CsgDeformTriangle> scratchKept,
    mut Vector<f32> scratchDistances,
    mut Vector<CsgDeformVertex> inOutVertices,
    mut Vector<CsgDeformTriangle> inOutTriangles
){
    const Expected<b8, CsgDeformViabilityReason> shapeDistances = ComputeCsgDeformShapeDistances(
        shape,
        inOutVertices,
        boundaryEpsilon,
        registryParameterByteSize,
        registryDistanceCallback,
        scratchDistances
    );
    if(!shapeDistances.has_value())
        return MakeUnexpected(shapeDistances.error());

    return ClipCsgDeformShellWithDistances(scratchDistances, edgeSplits, scratchKept, inOutVertices, inOutTriangles);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

