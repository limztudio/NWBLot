#include <impl/ecs_render/shadow/quality_settings.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u32 RequestedShadowReceiverResolutionFactor(in ShadowReceiverResolution receiverResolution){
    return cast<u32>(receiverResolution);
}

b8 IsShadowVisibilitySoftwareResourcesPreflighted(in b8 traceResourcesPreflighted, in b8 hardwareSupported){
    return traceResourcesPreflighted && !hardwareSupported;
}

b8 RequiresSurfelResourceInitialization(in b8 surfelEnabled, in b8 surfelResourcesNeedClear){
    return surfelEnabled && surfelResourcesNeedClear;
}

b8 PreparedTraversalStorageMatchesCurrent(in b8 sceneBvhStorageMatches, in b8 shadowMaterialContextStorageMatches){
    return sceneBvhStorageMatches && shadowMaterialContextStorageMatches;
}


