    ASSERT_TRUE(m_builder.beginPanel(s_PanelKey, { 10.0f, 10.0f, 320.0f, 260.0f }));
    m_source.textCalls = 0u;
    ASSERT_TRUE(m_builder.virtualList(s_ListKey, m_source, m_state, options).valid);
