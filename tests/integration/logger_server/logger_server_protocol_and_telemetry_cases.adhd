void VerifyLoggerTelemetryPublication_TelemetryPublicationDoesNotReplaceExistingFinalFile(mut LoggerTelemetryPublication self){
    const Path root = MakeTelemetryPublicationTestDirectory();
    ASSERT_FALSE(root.empty());
    const Path destination = root / "payload.nwbs";
    const Path staging = root / "payload.nwbs.partial";

    Array<u8, 3> existingBytes = Array<u8, 3>();
    existingBytes[0] = 1u;
    existingBytes[1] = 2u;
    existingBytes[2] = 3u;
    Array<u8, 3> newBytes = Array<u8, 3>();
    newBytes[0] = 4u;
    newBytes[1] = 5u;
    newBytes[2] = 6u;
    ASSERT_TRUE(WriteBinaryFile(destination, Span<u8>(existingBytes)));

    const FilePublicationResult result = PublishDurableBytes(destination, Span<u8>(newBytes));
    EXPECT_FALSE(result.published);
    EXPECT_TRUE(result.stagingRetained);
    EXPECT_TRUE(result.error);

    Vector<u8> bytes = Vector<u8>();
    ASSERT_TRUE(ReadBinaryFile(destination, bytes).has_value());
    EXPECT_TRUE(BytesMatch(Span<u8>(bytes), Span<u8>(existingBytes)));
    ASSERT_TRUE(ReadBinaryFile(staging, bytes).has_value());
    EXPECT_TRUE(BytesMatch(Span<u8>(bytes), Span<u8>(newBytes)));
}

void VerifyLoggerTelemetryPublication_TelemetryPublicationDoesNotReplaceExistingStagingFile(mut LoggerTelemetryPublication self){
    const Path root = MakeTelemetryPublicationTestDirectory();
    ASSERT_FALSE(root.empty());
    const Path destination = root / "payload.nwbs";
    const Path staging = root / "payload.nwbs.partial";

    Array<u8, 2> existingBytes = Array<u8, 2>();
    existingBytes[0] = 7u;
    existingBytes[1] = 8u;
    Array<u8, 2> newBytes = Array<u8, 2>();
    newBytes[0] = 9u;
    newBytes[1] = 10u;
    ASSERT_TRUE(WriteBinaryFile(staging, Span<u8>(existingBytes)));

    const FilePublicationResult result = PublishDurableBytes(destination, Span<u8>(newBytes));
    EXPECT_FALSE(result.published);
    EXPECT_FALSE(result.stagingRetained);
    EXPECT_TRUE(result.error);

    Vector<u8> bytes = Vector<u8>();
    ASSERT_TRUE(ReadBinaryFile(staging, bytes).has_value());
    EXPECT_TRUE(BytesMatch(Span<u8>(bytes), Span<u8>(existingBytes)));
    const Expected<b8, ErrorCode> finalExists = FileExists(destination);
    ASSERT_TRUE(finalExists.has_value());
    EXPECT_FALSE(finalExists.value());
}

void VerifyLoggerTelemetryPublication_ConcurrentTelemetryPublishersCannotReplaceEachOther(mut LoggerTelemetryPublication self){
    LoggerTestArena firstArena = LoggerTestArena();
    LoggerTestArena secondArena = LoggerTestArena();
    const Path root = MakeTelemetryPublicationTestDirectory();
    ASSERT_FALSE(root.empty());
    const Path destination = root / "payload.nwbs";
    Array<u8, 2> firstBytes = Array<u8, 2>();
    firstBytes[0] = 21u;
    firstBytes[1] = 22u;
    Array<u8, 2> secondBytes = Array<u8, 2>();
    secondBytes[0] = 31u;
    secondBytes[1] = 32u;
    b8 firstPublished = false;
    b8 secondPublished = false;
    native(mut firstArena, mut secondArena, in destination, in firstBytes, in secondBytes, mut firstPublished, mut secondPublished){
        const CrashTestPath firstPath(firstArena.arena, destination.native());
        const CrashTestPath secondPath(secondArena.arena, destination.native());
        FilePublicationResult firstResult;
        FilePublicationResult secondResult;
        Atomic<b8> start = false;
        Thread first([&](){
            while(!start.load(MemoryOrder::acquire))
                YieldThread();
            firstResult = PublishNewFileDurable(firstPath, BinaryByteView{ firstBytes.data(), firstBytes.size() });
        });
        Thread second([&](){
            while(!start.load(MemoryOrder::acquire))
                YieldThread();
            secondResult = PublishNewFileDurable(secondPath, BinaryByteView{ secondBytes.data(), secondBytes.size() });
        });
        start.store(true, MemoryOrder::release);
        first.join();
        second.join();
        firstPublished = firstResult.published;
        secondPublished = secondResult.published;
    }
    EXPECT_NE(firstPublished, secondPublished);
    Vector<u8> bytes = Vector<u8>();
    ASSERT_TRUE(ReadBinaryFile(destination, bytes).has_value());
    if(firstPublished)
        EXPECT_TRUE(BytesMatch(Span<u8>(bytes), Span<u8>(firstBytes)));
    else
        EXPECT_TRUE(BytesMatch(Span<u8>(bytes), Span<u8>(secondBytes)));
}

void VerifyLoggerTelemetryPublication_TelemetryPublicationMovesCompletedBytesToNewFinalFile(mut LoggerTelemetryPublication self){
    const Path root = MakeTelemetryPublicationTestDirectory();
    ASSERT_FALSE(root.empty());
    const Path destination = root / "payload.nwbs";
    const Path staging = root / "payload.nwbs.partial";

    Array<u8, 3> data = Array<u8, 3>();
    data[0] = 11u;
    data[1] = 12u;
    data[2] = 13u;
    const FilePublicationResult result = PublishDurableBytes(destination, Span<u8>(data));
    EXPECT_TRUE(result.published);
    EXPECT_FALSE(result.stagingRetained);
    EXPECT_FALSE(result.error);

    Vector<u8> bytes = Vector<u8>();
    ASSERT_TRUE(ReadBinaryFile(destination, bytes).has_value());
    EXPECT_TRUE(BytesMatch(Span<u8>(bytes), Span<u8>(data)));
    const Expected<b8, ErrorCode> stagingExists = FileExists(staging);
    ASSERT_TRUE(stagingExists.has_value());
    EXPECT_FALSE(stagingExists.value());
}


