const StringView s_PhysicsShaderDefaultVariant = "default";
const StringView s_PhysicsShaderNpPrimVariant = "NWB_PHYSICS_NP_PROFILE=0";
const StringView s_PhysicsShaderNpComplexVariant = "NWB_PHYSICS_NP_PROFILE=1";
const StringView s_PhysicsShaderNpBulletToiVariant = "NWB_PHYSICS_NP_PROFILE=2";
const StringView s_PhysicsShaderIslandSmallVariant = "NWB_PHYSICS_ISLAND_TIER=0";
const StringView s_PhysicsShaderIslandLargeVariant = "NWB_PHYSICS_ISLAND_TIER=1";
const StringView s_PhysicsShaderJointIslandMixVariant = "NWB_PHYSICS_JOINT_ISLAND_MODE=0";
const StringView s_PhysicsShaderJointIslandOnlyVariant = "NWB_PHYSICS_JOINT_ISLAND_MODE=1";
[cpp_header("<impl/assets/physics/constants.h>"), cpp_name("NWB_PHYSICS_ISLAND_JOINT_COLOR_COUNT")]
extern const u32 s_ShaderGpuIslandJointColorCount;

[cpp_header("<impl/assets/physics/constants.h>"), cpp_name("NWB_PHYSICS_ISLAND_JOINT_OVERFLOW_COLOR_INDEX")]
extern const u32 s_ShaderGpuIslandJointOverflowColorIndex;

const usize s_GpuJointColorCount = s_GraphColorCount;
const usize s_GpuJointOverflowColorIndex = s_OverflowColorIndex;
const usize s_GpuIslandJointColorCount = cast<usize>(s_ShaderGpuIslandJointColorCount);
const usize s_GpuIslandJointOverflowColorIndex = cast<usize>(s_ShaderGpuIslandJointOverflowColorIndex);


