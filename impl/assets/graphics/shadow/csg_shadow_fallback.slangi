#if NWB_CSG_SHADOW_HW_TRACE
#define NWB_CSG_RAY_RETAINED_POSE 1
#include "../common/math.slangi"

// Capture reuse retains receiver/cutter poses. Query unchanged local geometry through its current TLAS transform, preserving t.
bool nwbCsgRayPrepareHardwareRay(
    const uint contextSlot,
    const uint instanceIndex,
    const float3 worldOrigin,
    const float3 worldDirection,
    out float3 queryOrigin,
    out float3 queryDirection
){
    const NwbSwBvhInstance retained = nwbCsgRayLoadInstance(contextSlot, instanceIndex);
    const NwbRtInstanceMaterial material = nwbHeapRtInstanceMaterials(g_NwbSwShadowMaterialContextSlots.sceneSlots.z)[instanceIndex];
    const NwbMeshInstanceData current = nwbHeapMeshInstances(nwbMeshFrameInstanceHeapSlot())[material.meshInstanceIndex];
    const float3 localOrigin = nwbSwBvhTransformPoint(retained, worldOrigin);
    const float3 localDirection = nwbSwBvhTransformVector(retained, worldDirection);
    queryOrigin = nwbRotateVectorByQuaternion(localOrigin * current.scale.xyz, current.rotation) + current.translation;
    queryDirection = nwbRotateVectorByQuaternion(localDirection * current.scale.xyz, current.rotation);
    return all(isfinite(queryOrigin)) && all(isfinite(queryDirection)) && dot(queryDirection, queryDirection) > 0.0;
}
#endif

#include "../csg/ray_collect.slangi"

#if NWB_LIGHT_SPACE_OCCLUDER == NWB_SW_SHADOW_OCCLUDER_TRANSPARENT
#include "csg_shadow_ray_optics.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct NwbCsgShadowClosedOptics{
    half3 absorption;
    half interfaceTransmission;
    float chord;
    bool hasAbsorption;
};

bool nwbCsgShadowIntegrateRetainedSpan(
    const uint contextSlot,
    const uint materialSlot,
    const uint instanceIndex,
    const NwbCsgRayBoundary nearBoundary,
    const NwbCsgRayBoundary farBoundary,
    const float3 origin,
    const float3 direction,
    const float minimum,
    const float maximum,
    inout NwbCsgShadowClosedOptics optics
){
    const float lower = max(nearBoundary.distance, minimum);
    const float upper = min(farBoundary.distance, maximum);
    if(upper <= lower)
        return true;
    if(!isfinite(lower) || !isfinite(upper))
        return false;
    optics.chord += upper - lower;
    const bool nearInterface = nearBoundary.distance > minimum && nearBoundary.distance < maximum;
    const bool farInterface = farBoundary.distance > minimum && farBoundary.distance < maximum;
    const bool nearSurface = nearBoundary.cutter != NWB_CSG_RAY_INVALID_INDEX || nearBoundary.primitive != NWB_CSG_RAY_INVALID_INDEX;
    half3 absorption;
    half transmission;
    if(nearSurface && (!optics.hasAbsorption || nearInterface)){
        if(!nwbCsgShadowRayBoundaryOptics(contextSlot, materialSlot, instanceIndex, nearBoundary, origin, direction, absorption, transmission))
            return false;
        if(!optics.hasAbsorption){
            optics.absorption = absorption;
            optics.hasAbsorption = true;
        }
        if(nearInterface)
            optics.interfaceTransmission *= transmission;
    }
    if(!optics.hasAbsorption || farInterface){
        if(!nwbCsgShadowRayBoundaryOptics(contextSlot, materialSlot, instanceIndex, farBoundary, origin, direction, absorption, transmission))
            return false;
        if(!optics.hasAbsorption){
            optics.absorption = absorption;
            optics.hasAbsorption = true;
        }
        if(farInterface)
            optics.interfaceTransmission *= transmission;
    }
    return isfinite(optics.chord);
}

uint nwbCsgShadowRayInstanceOptics(
    const uint contextSlot,
    const uint materialSlot,
    const uint instanceIndex,
    const NwbSwBvhInstance instance,
    const NwbBvhNode root,
    const float3 origin,
    const float3 direction,
    const float minimum,
    const float maximum,
    inout NwbShadowVisibilityAccumulator accumulator
){
    const uint4 range = nwbCsgRayReceiverRange(contextSlot, instanceIndex);
    uint failure = nwbCsgRayValidateReceiverRange(contextSlot, range);
    if(failure != 0u)
        return failure;
    const float3 localOrigin = nwbSwBvhTransformPoint(instance, origin);
    failure = nwbCsgRayValidateReceiverOrigin(localOrigin, root);
    if(failure != 0u)
        return failure;
    NwbCsgRayCutInterval cuts[NWB_CSG_RAY_MAX_CUTTERS];
    uint cutCount;
    if(!nwbCsgRayLoadCutUnion(contextSlot, range, origin, direction, cuts, cutCount))
        return NWB_CSG_RAY_FAILURE_UNSUPPORTED;
    float2 receiverSegment;
    if(nwbCsgRayReceiverSegment(instance, root, origin, direction, minimum, maximum, receiverSegment)){
        const float cutoffMargin = 32.0 * 1.1920928955078125e-7 * (length(origin) + max(abs(receiverSegment.x), abs(receiverSegment.y)) + 1.0);
        for(uint index = 0u; index < cutCount; ++index)
            if(nwbCsgRayCutCoversSegment(cuts[index].distance, receiverSegment, cutoffMargin))
                return 0u;
    }
    NwbCsgRayCrossing crossings[NWB_CSG_RAY_CROSSING_CAPACITY];
    uint crossingCount = 0u;
    NwbCsgShadowRayOpenVisitor visitor;
    visitor.contextSlot = contextSlot;
    visitor.materialSlot = materialSlot;
    visitor.instanceIndex = instanceIndex;
    visitor.origin = origin;
    visitor.direction = direction;
    visitor.optics = nwbShadowInstanceOpticsBegin();
    visitor.hasAbsorption = false;
    failure = nwbCsgRayCollectCrossings(
        contextSlot, materialSlot, instanceIndex, range.w, origin, direction, minimum, maximum,
        cuts, cutCount, crossings, crossingCount, visitor
    );
    if(failure != 0u)
        return failure;
    NwbCsgRaySolidIterator solid;
    failure = nwbCsgRayBeginSolidWalk(crossings, crossingCount, localOrigin, root, solid);
    if(failure != 0u)
        return failure;
    NwbCsgShadowClosedOptics optics = (NwbCsgShadowClosedOptics)0;
    optics.interfaceTransmission = half(1.0h);
    NwbCsgRayBoundary nearBoundary;
    NwbCsgRayBoundary farBoundary;
    while(nwbCsgRayNextSolidSpan(crossings, crossingCount, solid, nearBoundary, farBoundary)){
        NwbCsgRayCutIterator cut = nwbCsgRayBeginCutWalk(nearBoundary);
        NwbCsgRayBoundary retainedNear;
        NwbCsgRayBoundary retainedFar;
        while(nwbCsgRayNextRetainedSpan(farBoundary, cuts, cutCount, cut, retainedNear, retainedFar)){
            if(!nwbCsgShadowIntegrateRetainedSpan(
                contextSlot, materialSlot, instanceIndex, retainedNear, retainedFar, origin, direction, minimum, maximum, optics
            ))
                return NWB_CSG_RAY_FAILURE_TOPOLOGY;
        }
    }
    accumulator.opticalDepth += optics.absorption * half(optics.chord);
    accumulator.interfaceTransmittance *= lerp(half(1.0h), optics.interfaceTransmission,
        half(smoothstep(0.0, NWB_SHADOW_INTERFACE_FADE_DISTANCE, optics.chord)));
    if(visitor.hasAbsorption)
        nwbShadowAccumulateInstance(accumulator, visitor.optics);
    return 0u;
}
#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Invalid/unsupported geometry remains conservative; valid cavity rays trace the retained solid and its union walls.
half3 nwbCsgShadowRayVisibility(const float3 origin, const float3 direction, const float minimum, const float maximum){
    if(!nwbCsgShadowEnabled())
        return half3(1.0h);
    if(!all(isfinite(origin)) || !all(isfinite(direction)) || !isfinite(minimum) || !isfinite(maximum))
        return nwbCsgShadowRayFailure(NWB_CSG_RAY_FAILURE_TOPOLOGY);
    const uint contextSlot = g_NwbLightSpacePush.csgContextSlot;
    const uint materialSlot = g_NwbSwShadowMaterialContextSlots.sceneSlots.z;
    const uint activeOffset = nwbHeapRawBuffer(contextSlot).Load(20u);
    const uint activeCount = nwbHeapRawBuffer(contextSlot).Load(24u);
#if NWB_LIGHT_SPACE_OCCLUDER == NWB_SW_SHADOW_OCCLUDER_TRANSPARENT
    NwbShadowVisibilityAccumulator accumulator = nwbShadowVisibilityBegin();
#endif
    for(uint index = 0u; index < activeCount; ++index){
        const uint instanceIndex = nwbHeapRawBuffer(contextSlot).Load(activeOffset + index * 4u);
        if(instanceIndex >= g_NwbLightSpacePush.instanceCount)
            return nwbCsgShadowRayFailure(NWB_CSG_RAY_FAILURE_TOPOLOGY);
        const NwbRtInstanceMaterial material = nwbHeapRtInstanceMaterials(materialSlot)[instanceIndex];
        const bool transparent = (material.flags & NWB_RT_INSTANCE_MATERIAL_FLAG_TRANSPARENT) != 0u;
#if NWB_LIGHT_SPACE_OCCLUDER == NWB_SW_SHADOW_OCCLUDER_OPAQUE
        if(transparent)
            continue;
#else
        if(!transparent)
            continue;
#endif
        const NwbSwBvhInstance instance = nwbCsgRayLoadInstance(contextSlot, instanceIndex);
        const NwbBvhNode root = nwbCsgRayReceiverRoot(contextSlot, instanceIndex, instance);
        if(!nwbCsgRayBoundsIntersect(instance, root, origin, direction, minimum, maximum))
            continue;
#if NWB_LIGHT_SPACE_OCCLUDER == NWB_SW_SHADOW_OCCLUDER_OPAQUE
        const NwbCsgRayBoundary boundary = nwbCsgRayResolveBoundary(contextSlot, materialSlot, instanceIndex, origin, direction, minimum, maximum);
        if(boundary.failure != 0u)
            return nwbCsgShadowRayFailure(boundary.failure);
        if(boundary.hit)
            return half3(0.0h);
#else
        const uint failure = nwbCsgShadowRayInstanceOptics(contextSlot, materialSlot, instanceIndex, instance, root, origin, direction, minimum, maximum, accumulator);
        if(failure != 0u)
            return nwbCsgShadowRayFailure(failure);
#endif
    }
#if NWB_LIGHT_SPACE_OCCLUDER == NWB_SW_SHADOW_OCCLUDER_TRANSPARENT
    return nwbShadowFinalizeVisibility(accumulator);
#else
    return half3(1.0h);
#endif
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


