NWB_ADHD_GTEST(ModelAttachment, RevalidatesPoseHierarchyAndParentBindingOnEveryUpdate, VerifyModelAttachmentRevalidatesPoseAndParent)
NWB_ADHD_GTEST(ModelAttachment, InvalidUnrequestedJointsRejectWholePoseAndRecover, VerifyModelAttachmentInvalidUnrequestedJoints)
NWB_ADHD_GTEST(ModelAttachment, PreservesOriginalAttachmentTransformWriteOrder, VerifyModelAttachmentPreservesTransformWriteOrder)
NWB_ADHD_GTEST(ModelAttachment, GroupedQueriesRejectShrunkAndEmptyPalettesAndRecover, VerifyModelAttachmentGroupedQueriesRejectShrunkPalettes)
NWB_ADHD_GTEST(ModelAttachment, SingleQueryRejectsMissingJointBoundsAndRetainsReusableCapacity, VerifyModelAttachmentSingleQueryRejectsMissingBounds)
NWB_ADHD_GTEST(ModelAttachment, InterleavedParentsKeepIndependentQueriesAndEntityGenerations, VerifyModelAttachmentInterleavedParentsKeepGenerations)
NWB_ADHD_GTEST(ModelRuntime, RemovingMultipleModelsDestroysEveryOwnedObjectInOneSync, VerifyModelRuntimeRemovingMultipleModelsDestroysObjects)
NWB_ADHD_GTEST(ModelRuntime, InvalidBindingsAndRemovedModelsUseIndependentCleanupBatches, VerifyModelRuntimeInvalidBindingsAndRemovedModels)
NWB_ADHD_GTEST(ModelRuntime, PrunesDestroyedOwnerGenerationWithoutTouchingItsReplacement, VerifyModelRuntimePrunesDestroyedOwnerGeneration)
NWB_ADHD_GTEST(ModelRuntime, SteadyStateAndEmptyRuntimeCleanupPerformNoBackingAllocations, VerifyModelRuntimeSteadyStatePerformsNoBackingAllocs)
NWB_ADHD_GTEST(ModelRuntime, FailedReplacementLoadClearsOnlyThatOwnersObjectsAndCanRetry, VerifyModelRuntimeFailedReplacementClearsOnlyThatOwner)


