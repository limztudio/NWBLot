////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_ui/toolkit/widgets/window_geometry.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 TryLoadWindowPointerDisplacement(in PointerGesture gesture, mut VectorDouble outDisplacement){
    if(
        !gesture.id.valid()
        || !IsFinite(VectorSingle(gesture.origin.x, gesture.origin.y, gesture.position.x, gesture.position.y))
        || !IsValidUiRect(gesture.referenceRectangle)
        || gesture.referenceRectangle.width <= 0.0f || gesture.referenceRectangle.height <= 0.0f
        || gesture.state > PointerGestureState::Completed
    )
        return false;
    outDisplacement = VectorDouble(cast<f64>(gesture.position.x), cast<f64>(gesture.position.y), 0.0, 0.0)
        - VectorDouble(cast<f64>(gesture.origin.x), cast<f64>(gesture.origin.y), 0.0, 0.0);
    return true;
}

b8 IsValidWindowMaximumSize(in Point minimumSize, in Point maximumSize){
    return IsValidUiExtent(minimumSize)
        && IsValidUiExtent(maximumSize)
        && (maximumSize.x == 0.0f || maximumSize.x >= minimumSize.x)
        && (maximumSize.y == 0.0f || maximumSize.y >= minimumSize.y);
}

VectorDouble ClampWindowSizeF64(in VectorDouble size, in Point minimumSize, in Point maximumSize){
    VectorDouble clamped = Max(VectorDouble(cast<f64>(minimumSize.x), cast<f64>(minimumSize.y), 0.0, 0.0), size);
    if(maximumSize.x > 0.0f)
        clamped.x = UiSimdMinF64(clamped.x, cast<f64>(maximumSize.x));
    if(maximumSize.y > 0.0f)
        clamped.y = UiSimdMinF64(clamped.y, cast<f64>(maximumSize.y));
    return clamped;
}

b8 TryInitializeWindow(in WindowOptions options, in WindowMetrics metrics, mut WindowState state){
    if(
        !IsValidUiRect(options.initialBounds)
        || options.direction > LayoutDirection::Grid || options.direction == LayoutDirection::Leaf
        || !IsValidUiExtent(options.minimumSize)
        || !IsFinite(VectorSingle(metrics.minimumSize.x, metrics.minimumSize.y, 0.0f, 0.0f))
        || metrics.minimumSize.x <= 0.0f
        || metrics.minimumSize.y <= 0.0f
        || !IsValidWindowMaximumSize(options.minimumSize, options.maximumSize)
        || !IsValidWindowMaximumSize(metrics.minimumSize, metrics.maximumSize)
    )
        return false;
    WindowState candidate = state;
    if(!candidate.initialized){
        candidate.bounds = options.initialBounds;
        candidate.moveGesture = WindowGestureState();
        candidate.resizeGesture = WindowGestureState();
    }
    if(!IsValidUiRect(candidate.bounds))
        return false;
    const VectorDouble size = ClampWindowSizeF64(VectorDouble(cast<f64>(candidate.bounds.width), cast<f64>(candidate.bounds.height), 0.0, 0.0), metrics.minimumSize, metrics.maximumSize);
    candidate.bounds.width = cast<f32>(size.x);
    candidate.bounds.height = cast<f32>(size.y);
    candidate.initialized = true;
    if(!IsValidUiRect(candidate.bounds))
        return false;
    state = candidate;
    return true;
}

b8 TryApplyWindowMove(in PointerGesture gesture, mut WindowState state){
    VectorDouble displacement(0.0);
    if(!TryLoadWindowPointerDisplacement(gesture, displacement))
        return false;
    WindowGestureState movement = state.moveGesture;
    if(movement.id != gesture.id){
        movement.id = gesture.id;
        movement.initialBounds = gesture.referenceRectangle;
    }
    const VectorDouble origin(cast<f64>(movement.initialBounds.x), cast<f64>(movement.initialBounds.y), 0.0, 0.0);
    const VectorDouble moved = origin + displacement;
    const f64 left = moved.x;
    const f64 top = moved.y;
    const VectorDouble mag = VectorDoubleAbs(VectorDouble(cast<f64>(left), cast<f64>(top), 0.0, 0.0));
    if(mag.x > s_UiMaxFloatF64 || mag.y > s_UiMaxFloatF64)
        return false;
    Rect candidate = state.bounds;
    candidate.x = cast<f32>(left);
    candidate.y = cast<f32>(top);
    if(!IsValidUiRect(candidate))
        return false;
    state.bounds = candidate;
    state.moveGesture = movement;
    return true;
}

b8 TryApplyWindowResize(in PointerGesture gesture, in Point minimumSize, in Point maximumSize, in WindowResizeEdge edge, mut WindowState state){
    VectorDouble displacement(0.0);
    if(
        !TryLoadWindowPointerDisplacement(gesture, displacement)
        || !IsFinite(VectorSingle(minimumSize.x, minimumSize.y, 0.0f, 0.0f))
        || minimumSize.x <= 0.0f
        || minimumSize.y <= 0.0f
        || !IsValidWindowMaximumSize(minimumSize, maximumSize)
    )
        return false;
    const u8 edgeBits = cast<u8>(edge);
    const b8 hasLeft = (edgeBits & cast<u8>(WindowResizeEdge::Left)) != 0u;
    const b8 hasRight = (edgeBits & cast<u8>(WindowResizeEdge::Right)) != 0u;
    const b8 hasTop = (edgeBits & cast<u8>(WindowResizeEdge::Top)) != 0u;
    const b8 hasBottom = (edgeBits & cast<u8>(WindowResizeEdge::Bottom)) != 0u;
    if((hasLeft && hasRight) || (hasTop && hasBottom) || (!hasLeft && !hasRight && !hasTop && !hasBottom))
        return false;
    WindowGestureState resizing = state.resizeGesture;
    if(resizing.id != gesture.id){
        resizing.id = gesture.id;
        resizing.initialBounds = gesture.referenceRectangle;
    }
    f64 deltaWidth = 0.0;
    if(hasRight)
        deltaWidth = displacement.x;
    else if(hasLeft)
        deltaWidth = -displacement.x;
    f64 deltaHeight = 0.0;
    if(hasBottom)
        deltaHeight = displacement.y;
    else if(hasTop)
        deltaHeight = -displacement.y;
    const VectorDouble initialPos(cast<f64>(resizing.initialBounds.x), cast<f64>(resizing.initialBounds.y), 0.0, 0.0);
    const VectorDouble initialSize(cast<f64>(resizing.initialBounds.width), cast<f64>(resizing.initialBounds.height), 0.0, 0.0);
    const VectorDouble resized = initialSize + VectorDouble(deltaWidth, deltaHeight, 0.0, 0.0);
    const VectorDouble size = ClampWindowSizeF64(resized, minimumSize, maximumSize);
    if(size.x > s_UiMaxFloatF64 || size.y > s_UiMaxFloatF64)
        return false;
    Rect candidate = state.bounds;
    if(hasRight)
        candidate.width = cast<f32>(size.x);
    else if(hasLeft){
        const f64 nextX = (initialPos.x + initialSize.x) - size.x;
        if(VectorDoubleAbs(VectorDouble(nextX, 0.0, 0.0, 0.0)).x > s_UiMaxFloatF64)
            return false;
        candidate.x = cast<f32>(nextX);
        candidate.width = cast<f32>(size.x);
    }
    if(hasBottom)
        candidate.height = cast<f32>(size.y);
    else if(hasTop){
        const f64 nextY = (initialPos.y + initialSize.y) - size.y;
        if(VectorDoubleAbs(VectorDouble(0.0, nextY, 0.0, 0.0)).y > s_UiMaxFloatF64)
            return false;
        candidate.y = cast<f32>(nextY);
        candidate.height = cast<f32>(size.y);
    }
    if(!IsValidUiRect(candidate))
        return false;
    state.bounds = candidate;
    state.resizeGesture = resizing;
    return true;
}

b8 TryConstrainWindow(in DisplayMetrics display, in f32 titleHeight, mut WindowState state){
    if(!IsFinite(VectorSingle(display.logicalWidth, display.logicalHeight, titleHeight, 0.0f)) || display.logicalWidth <= 0.0f || display.logicalHeight <= 0.0f || titleHeight <= 0.0f || !IsValidUiRect(state.bounds))
        return false;
    f32 height = state.bounds.height;
    if(state.collapsed)
        height = titleHeight;
    const VectorSingle maximum = Max(VectorSingle(0.0f), VectorSingle(display.logicalWidth, display.logicalHeight, display.logicalWidth, display.logicalHeight) - VectorSingle(state.bounds.width, height, state.bounds.width, height));
    const f32 maxX = maximum.x;
    const f32 maxY = maximum.y;
    const VectorSingle pos(state.bounds.x, state.bounds.y, 0.0f, 0.0f);
    const VectorSingle zeroVec(0.0f);
    const VectorSingle maxVec(maxX, maxY, 0.0f, 0.0f);
    const VectorSingle clampedUpper = VectorSelect(pos, maxVec, VectorGreater(pos, maxVec));
    const VectorSingle clampedPos = VectorSelect(zeroVec, clampedUpper, VectorGreater(clampedUpper, zeroVec));
    state.bounds.x = clampedPos.x;
    state.bounds.y = clampedPos.y;
    return true;
}

Rect ResolveWindowTitleContentBounds(in Rect header, in WindowMetrics metrics, in b8 collapsible, in b8 closable, in f32 gap){
    f32 collapseReservation = 0.0f;
    if(collapsible)
        collapseReservation = metrics.collapseExtent + gap;
    f32 closeReservation = 0.0f;
    if(closable)
        closeReservation = metrics.closeExtent + gap;
    const Insets padding(metrics.titlePadding.left + collapseReservation, metrics.titlePadding.top, metrics.titlePadding.right + closeReservation, metrics.titlePadding.bottom);
    return InsetUiRectBounds(header, padding);
}

LayoutNodeDesc BuildWindowRootLayoutNodeDesc(
    in WindowOptions options,
    in WindowMetrics metrics,
    in Rect bounds,
    in b8 firstUse,
    in f32 gap
){
    LayoutNodeDesc description;
    description.direction = options.direction;
    if(firstUse && options.contentWidthFirstUse)
        description.width = LayoutSize(LayoutSizePolicy::Content, 0.0f);
    else
        description.width = LayoutSize(LayoutSizePolicy::Fixed, bounds.width);
    if(firstUse && options.contentHeightFirstUse)
        description.height = LayoutSize(LayoutSizePolicy::Content, 0.0f);
    else
        description.height = LayoutSize(LayoutSizePolicy::Fixed, bounds.height);
    description.padding = metrics.contentPadding;
    description.gap = gap;
    const f32 contentHeight = metrics.minimumSize.y - metrics.titleHeight;
    const VectorSingle intrinsic = (VectorSingle(metrics.minimumSize.x, contentHeight, metrics.minimumSize.x, contentHeight) - VectorSingle(description.padding.left, description.padding.top, description.padding.left, description.padding.top)) - VectorSingle(description.padding.right, description.padding.bottom, description.padding.right, description.padding.bottom);
    const VectorSingle size = Max(VectorSingle(0.0f), intrinsic);
    description.intrinsicSize = Point(size.x, size.y);
    return description;
}

void ApplyWindowFirstUseContentBounds(
    in WindowOptions options,
    in WindowMetrics metrics,
    in Rect rootRectangle,
    in b8 firstUse,
    mut WindowState inOutState
){
    if(firstUse && options.contentWidthFirstUse){
        f32 width = UiSimdMax(rootRectangle.width, metrics.minimumSize.x);
        if(metrics.maximumSize.x > 0.0f)
            width = UiSimdMin(width, metrics.maximumSize.x);
        inOutState.bounds.width = width;
    }
    if(firstUse && options.contentHeightFirstUse){
        f32 height = UiSimdMax(rootRectangle.height + metrics.titleHeight, metrics.minimumSize.y);
        if(metrics.maximumSize.y > 0.0f)
            height = UiSimdMin(height, metrics.maximumSize.y);
        inOutState.bounds.height = height;
    }
}


