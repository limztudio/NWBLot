#include <tests/common/ecs_test_world.adhd>
#include <tests/common/gtest_macros.adhd>
#include "name_cases.adhd"

#include <impl/ecs_model_renderer/model_renderer.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


usize MaterialInstanceComponentAddress(mut World world, in EntityID entity){
    if(!world.hasComponent<MaterialInstanceComponent>(entity))
        return 0u;
    return ObjectAddressKey(world.getComponent<MaterialInstanceComponent>(entity));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyModelRendererOwnerOverridesSurvivePoolGrowth(){
    EcsTestWorld context = EcsTestWorld();
    Entity owner = context.world.createEntity();
    mut RendererComponent renderer = owner.addComponent<RendererComponent>();
    const Name identity = s_ModelFixtureNameObject;
    renderer.material = AssetRef<Material>(identity);
    mut MaterialInstanceComponent source = owner.addComponent<MaterialInstanceComponent>(identity);
    source.revision = 7u;
    MaterialInstanceParameter overrideItem = MaterialInstanceParameter();
    overrideItem.parameterName = identity;
    source.overrides.push_back(overrideItem);

    b8 relocated = false;
    for(u32 index = 0u; index < 256u && !relocated; ++index){
        const usize beforeAddress = MaterialInstanceComponentAddress(context.world, owner.id());
        ASSERT_NE(beforeAddress, 0u);

        Entity child = context.world.createEntity();
        ApplyModelObjectRenderer(owner.id(), AssetRef<Material>(), context.world, child);

        const usize afterAddress = MaterialInstanceComponentAddress(context.world, owner.id());
        const usize copiedAddress = MaterialInstanceComponentAddress(context.world, child.id());
        ASSERT_NE(afterAddress, 0u);
        ASSERT_NE(copiedAddress, 0u);
        relocated = beforeAddress != afterAddress;

        mut MaterialInstanceComponent after = context.world.entity(owner.id()).getComponent<MaterialInstanceComponent>();
        mut MaterialInstanceComponent copied = child.getComponent<MaterialInstanceComponent>();
        ASSERT_EQ(after.overrides.size(), 1u);
        ASSERT_EQ(copied.overrides.size(), 1u);
        EXPECT_EQ(copied.materialInterface, identity);
        EXPECT_EQ(copied.revision, 7u);
        EXPECT_EQ(copied.overrides.front().parameterName, identity);
    }
    EXPECT_TRUE(relocated);
}

void VerifyModelRendererOpticalFieldsNoEmptyMaterialInstanceAndRuntimeSync(){
    EcsTestWorld context = EcsTestWorld();
    Entity owner = context.world.createEntity();
    mut RendererComponent ownerRenderer = owner.addComponent<RendererComponent>();
    ownerRenderer.material = AssetRef<Material>(s_ModelFixtureNameObject);
    ownerRenderer.visible = false;
    ownerRenderer.opticalVolumeCoincidence = OpticalVolumeCoincidence::SharedGroup;
    ownerRenderer.opticalVolumeGroup = Name("tests/model/optical_group");
    ownerRenderer.opticalVolumePriority = 5;
    ownerRenderer.opticalBoundaryMode = OpticalBoundaryMode::ClosedPriority;
    ownerRenderer.opticalMediumPriority = -3;

    Entity child = context.world.createEntity();
    mut ModelObjectComponent obj = child.addComponent<ModelObjectComponent>();
    obj.owner = owner.id();
    obj.kind = ModelObjectKind::StaticMesh;

    ApplyModelObjectRenderer(owner.id(), AssetRef<Material>(), context.world, child);

    ASSERT_TRUE(child.hasComponent<RendererComponent>());
    in RendererComponent childRenderer = child.getComponent<RendererComponent>();
    EXPECT_EQ(childRenderer.material.name(), s_ModelFixtureNameObject);
    EXPECT_FALSE(childRenderer.visible);
    EXPECT_EQ(childRenderer.opticalVolumeCoincidence, OpticalVolumeCoincidence::SharedGroup);
    EXPECT_EQ(childRenderer.opticalVolumeGroup, Name("tests/model/optical_group"));
    EXPECT_EQ(childRenderer.opticalVolumePriority, 5);
    EXPECT_EQ(childRenderer.opticalBoundaryMode, OpticalBoundaryMode::ClosedPriority);
    EXPECT_EQ(childRenderer.opticalMediumPriority, -3);
    EXPECT_FALSE(child.hasComponent<MaterialInstanceComponent>());

    {
        mut RendererComponent editedOwner = owner.getComponent<RendererComponent>();
        editedOwner.visible = true;
        editedOwner.opticalVolumePriority = 11;
        mut MaterialInstanceComponent ownerMi = owner.addComponent<MaterialInstanceComponent>(Name("tests/model/iface"));
        ownerMi.revision = 3u;
        MaterialInstanceParameter p;
        p.parameterName = Name("block.tint");
        ownerMi.overrides.push_back(p);
    }
    SyncModelObjectRenderers(context.world);
    EXPECT_TRUE(child.getComponent<RendererComponent>().visible);
    EXPECT_EQ(child.getComponent<RendererComponent>().opticalVolumePriority, 11);
    ASSERT_TRUE(child.hasComponent<MaterialInstanceComponent>());
    EXPECT_EQ(child.getComponent<MaterialInstanceComponent>().revision, 3u);
    ASSERT_EQ(child.getComponent<MaterialInstanceComponent>().overrides.size(), 1u);

    const Name defaultMatName = Name("tests/model/default_mat");
    obj.defaultMaterial = defaultMatName;
    owner.getComponent<RendererComponent>().material.reset();
    owner.removeComponent<MaterialInstanceComponent>();
    SyncModelObjectRenderers(context.world);
    EXPECT_EQ(child.getComponent<RendererComponent>().material.name(), defaultMatName);
    EXPECT_FALSE(child.hasComponent<MaterialInstanceComponent>());
}

NWB_ADHD_GTEST(ModelRenderer, OwnerOverridesSurviveMaterialComponentPoolGrowth, VerifyModelRendererOwnerOverridesSurvivePoolGrowth)
NWB_ADHD_GTEST(ModelRenderer, OpticalFieldsNoEmptyMaterialInstanceAndRuntimeSync, VerifyModelRendererOpticalFieldsNoEmptyMaterialInstanceAndRuntimeSync)


