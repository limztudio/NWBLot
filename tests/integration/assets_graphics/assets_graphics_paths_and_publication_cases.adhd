void VerifyAssetsGraphics_ConcurrentImmutablePublicationPreservesTheWinner(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    const GraphicsTestPath root = GetGraphicsTestCaseRoot(testArena, "immutable_publication_race");
    ASSERT_TRUE(PrepareCleanDirectory(root));
    const GraphicsTestPath destination = JoinGraphicsPath(root, "shared.nwba");
    b8 firstWon = false;
    b8 secondWon = false;
    native(in destination, mut firstWon, mut secondWon){
        Atomic<u32> ready{0u};
        Atomic<b8> start{false};
        b8 results[2]{};
        const auto publish = [&](const usize index){
            NWB::Core::Alloc::ScratchArena scratch(s_CodecScratchArena);
            ::Path<NWB::Core::Alloc::ScratchArena> path(scratch, destination);
            Vector<u8, NWB::Core::Alloc::ScratchArena> bytes(scratch);
            Vector<u8, NWB::Core::Alloc::ScratchArena> existing(scratch);
            bytes.resize(1024u * 1024u, static_cast<u8>(index + 1u));
            ready.fetch_add(1u);
            while(!start.load())
                YieldThread();
            results[index] = NWB::Core::Assets::AssetFilePublisher::Write(path, bytes, false, existing);
        };
        Thread first(publish, 0u);
        Thread second(publish, 1u);
        while(ready.load() != 2u)
            YieldThread();
        start.store(true);
        first.join();
        second.join();
        firstWon = results[0];
        secondWon = results[1];
    }
    ASSERT_NE(firstWon, secondWon);
    AssetBytes stored(testArena.arena);
    ASSERT_TRUE(ReadBinaryFile(destination, stored).has_value());
    ASSERT_EQ(stored.size(), 1024u * 1024u);
    u8 expected = 2u;
    if(firstWon)
        expected = 1u;
    for(in u8 byte : stored)
        ASSERT_EQ(byte, expected);
    EXPECT_TRUE(RemoveAllIfExists(root));
}

void VerifyAssetsGraphics_DeferredWriteOwnsScratchBytesBeforeCallerMutation(){
    TestArena testArena = TestArena();
    const GraphicsTestPath root = GetGraphicsTestCaseRoot(testArena, "volume_scratch_bytes");
    const b8 prepared = PrepareCleanDirectory(root);
    EXPECT_TRUE(prepared);

    if(prepared){
        native(in root, mut testArena){
            NWB::Core::Filesystem::VolumeMountDesc mountDesc(testArena.arena);
            mountDesc.volumeName = "scratch_test";
            mountDesc.segmentSize = 64ull * 1024ull;
            mountDesc.metadataSize = 4ull * 1024ull;
            mountDesc.mountDirectory = root / "volume";
            mountDesc.createIfMissing = true;
            mountDesc.usage = NWB::Core::Filesystem::VolumeUsage::CookWrite;
            auto filesystemResult = NWB::Core::Filesystem::CreateFilesystem(testArena.arena, mountDesc);
            const b8 created = static_cast<b8>(filesystemResult);
            EXPECT_TRUE(created);
            if(created){
                UniquePtr<NWB::Core::Filesystem::IFilesystem> filesystem = Move(*filesystemResult);
                NWB::Core::Alloc::ScratchArena scratchArena(s_CodecScratchArena);
                ::Vector<u8, NWB::Core::Alloc::ScratchArena> payload{ scratchArena };
                payload.reserve(4u);
                payload.push_back(1u);
                payload.push_back(2u);
                payload.push_back(3u);
                payload.push_back(4u);

                const Name virtualPath = s_ProjectTestsScratchPayload;
                const b8 pushed = filesystem->writeFileDeferred(virtualPath, payload);
                EXPECT_TRUE(pushed);
                if(pushed){
                    payload[0] = 99u;

                    const b8 flushed = filesystem->flush();
                    EXPECT_TRUE(flushed);
                    if(flushed){
                        NWB::Core::Assets::AssetBytes readback = MakeAssetBytes(testArena);
                        const b8 loaded = filesystem->readFile(virtualPath, readback);
                        EXPECT_TRUE(loaded);
                        if(loaded){
                            ASSERT_EQ(readback.size(), 4u);
                            EXPECT_EQ(readback[0], 1u);
                        }
                    }
                }
            }
        }
    }

    EXPECT_TRUE(RemoveAllIfExists(root));
}

void VerifyAssetsGraphics_SharedCodecPayloadsKeepDistinctVirtualPathsUnderLongBuildDirectories(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    const Expected<CookCase> cookCase = PrepareCookCase(testArena, "shared_codec_payloads");
    ASSERT_TRUE(cookCase.has_value());
    const CookCase prepared = cookCase.value();
    const GraphicsTestPath root = prepared.root;
    const GraphicsTestPath outputDirectory = prepared.outputDirectory;
    const GraphicsTestPath assetRoot = JoinGraphicsPath(root, s_AssetsDirectory);
    ASSERT_TRUE(WriteTextFile(JoinGraphicsPath2(assetRoot, "samplers", "first.nwb"), s_LinearWrapSamplerMetadata));
    ASSERT_TRUE(WriteTextFile(JoinGraphicsPath2(assetRoot, "samplers", "second.nwb"), s_LinearWrapSamplerMetadata));

    // A 200-character directory leaves room for compact artifacts within the traditional Windows path limit.
    const usize rootTextLength = PathToString(root).size();
    ASSERT_LT(rootTextLength, 199u);
    AssetString directoryName(testArena.arena);
    AppendRepeatedAsciiByte(directoryName, 199u - rootTextLength, 98u);
    const GraphicsTestPath builtDirectory = JoinGraphicsPath(root, ViewArenaString(directoryName));
    ASSERT_EQ(PathToString(builtDirectory).size(), 200u);
    ASSERT_TRUE(BuildSingleAssetRoot(testArena, root, builtDirectory, assetRoot, 2u));

    ScratchArena scratchArena(s_GatherScratchArena);
    ASSERT_TRUE(GatherBuiltToOutputHelper(testArena, builtDirectory, outputDirectory, scratchArena));

    Array<Name, 2> virtualPaths = Array<Name, 2>();
    virtualPaths[0u] = Name(s_FirstSamplerPath);
    virtualPaths[1u] = Name(s_SecondSamplerPath);
    for(in Name virtualPath : virtualPaths){
        const Expected<SamplerAsset> asset = LoadCookedSamplerHelper(outputDirectory, virtualPath, 2u, testArena);
        ASSERT_TRUE(asset.has_value());
        EXPECT_EQ(asset.value().virtualPath(), virtualPath);
    }
    EXPECT_EQ(logger.errorCount(), 0u);
    EXPECT_TRUE(RemoveAllIfExists(root));
}

void VerifyAssetsGraphics_FailedReorderedSharedPayloadBuildPreservesPublishedVirtualPaths(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_CodecScratchArena);

    const Expected<CookCase> cookCase = PrepareCookCase(testArena, "failed_reordered_shared_payloads");
    ASSERT_TRUE(cookCase.has_value());
    const CookCase prepared = cookCase.value();
    const GraphicsTestPath root = prepared.root;
    const GraphicsTestPath publishedDirectory = JoinGraphicsPath(root, "published");
    const GraphicsTestPath manifestPath = JoinGraphicsPath(publishedDirectory, s_ManifestFilename);
    const Name firstPath(s_FirstSamplerPath);
    const Name secondPath(s_SecondSamplerPath);

    SamplerAsset samplerAsset(testArena.arena, firstPath);
    SamplerDesc samplerDesc = SamplerDesc();
    samplerDesc.borderColor = SamplerColor(0.0f);
    samplerAsset.setDescription(samplerDesc);
    const SamplerAssetCodec samplerCodec = SamplerAssetCodec();
    AssetBytes samplerPayload(testArena.arena);
    ASSERT_TRUE(samplerCodec.serialize(samplerAsset, samplerPayload));

    AssetVolumePackManifest initial(testArena.arena);
    ASSERT_TRUE(ReserveAssetVolumePackManifest(2u, initial));
    ASSERT_TRUE(AppendPayloadBytesToManifest(firstPath, samplerPayload, initial, s_SharedCookKeyHash));
    ASSERT_TRUE(AppendPayloadBytesToManifest(secondPath, samplerPayload, initial, s_SharedCookKeyHash));
    ASSERT_TRUE(WriteBuiltManifestHelper(publishedDirectory, initial, scratchArena));

    AssetBytes originalList(testArena.arena);
    ASSERT_TRUE(ReadBinaryFile(manifestPath, originalList).has_value());
    AssetTestVector<AssetString> originalArtifactPaths(testArena.arena);
    ASSERT_TRUE(ReadManifestArtifactPaths(manifestPath, scratchArena, originalArtifactPaths));
    ASSERT_EQ(originalArtifactPaths.size(), 2u);
    AssetTestVector<AssetBytes> originalArtifactBytes(testArena.arena);
    originalArtifactBytes.reserve(originalArtifactPaths.size());
    for(usize index = 0u; index < originalArtifactPaths.size(); ++index){
        AssetBytes artifactData(testArena.arena);
        const GraphicsTestPath artifactFile(testArena.arena, ViewArenaString(originalArtifactPaths[index]));
        ASSERT_TRUE(ReadBinaryFile(artifactFile, artifactData).has_value());
        originalArtifactBytes.push_back(artifactData);
    }

    AssetVolumePackManifest reordered(testArena.arena);
    ASSERT_TRUE(ReserveAssetVolumePackManifest(3u, reordered));
    ASSERT_TRUE(AppendPayloadBytesToManifest(secondPath, samplerPayload, reordered, s_SharedCookKeyHash));
    ASSERT_TRUE(AppendPayloadBytesToManifest(firstPath, samplerPayload, reordered, s_SharedCookKeyHash));
    // Reorder both shared-payload entries before failing, so publication also has to create a new artifact slot.
    ASSERT_TRUE(AppendPayloadBytesToManifest(s_AssetInputNameProjectSamplersFailing, samplerPayload, reordered, s_SharedCookKeyHash));
    CorruptLastManifestEntryHash(reordered);
    EXPECT_FALSE(WriteBuiltManifestHelper(publishedDirectory, reordered, scratchArena));
    EXPECT_TRUE(SawCapturedError(logger, "invalid payload identity"));

    AssetBytes retainedList(testArena.arena);
    ASSERT_TRUE(ReadBinaryFile(manifestPath, retainedList).has_value());
    EXPECT_EQ(retainedList, originalList);
    AssetBytes retainedArtifactBytes(testArena.arena);
    for(usize index = 0u; index < originalArtifactPaths.size(); ++index){
        const GraphicsTestPath artifactFile(testArena.arena, ViewArenaString(originalArtifactPaths[index]));
        ASSERT_TRUE(ReadBinaryFile(artifactFile, retainedArtifactBytes).has_value());
        EXPECT_EQ(retainedArtifactBytes, originalArtifactBytes[index]);
    }

    ASSERT_TRUE(GatherBuiltToOutputHelper(testArena, publishedDirectory, prepared.outputDirectory, scratchArena));
    Array<Name, 2> virtualPaths = Array<Name, 2>();
    virtualPaths[0u] = firstPath;
    virtualPaths[1u] = secondPath;
    for(in Name virtualPath : virtualPaths){
        const Expected<SamplerAsset> asset = LoadCookedSamplerHelper(prepared.outputDirectory, virtualPath, 2u, testArena);
        ASSERT_TRUE(asset.has_value());
        EXPECT_EQ(asset.value().virtualPath(), virtualPath);
    }
    EXPECT_EQ(logger.errorCount(), 1u);
    EXPECT_TRUE(RemoveAllIfExists(root));
}

void VerifyAssetsGraphics_AssetRegistrySupportsReentrantDeserializeAndDrainsBeforeUnregister(){
    TestArena testArena = TestArena();
    native(mut testArena){
        class ProbeAsset final : public NWB::Core::Assets::IAsset{
        public:
            ProbeAsset(const Name& assetType, const Name& virtualPath)noexcept
                : IAsset(assetType, virtualPath)
            {}
        };

        class LeafProbeCodec final : public NWB::Core::Assets::IAssetCodec{
        public:
            explicit LeafProbeCodec(const Name& assetType)noexcept
                : IAssetCodec(assetType)
            {}


        public:
            virtual Expected<UniquePtr<NWB::Core::Assets::IAsset>> deserialize(const Name& virtualPath, const Span<const u8>, NWB::Core::Assets::AssetArena&)const override{
                return UniquePtr<NWB::Core::Assets::IAsset>(MakeUnique<ProbeAsset>(assetType(), virtualPath));
            }

#if defined(NWB_COOK)
            virtual b8 serialize(const NWB::Core::Assets::IAsset&, NWB::Core::Assets::AssetBytes&)const override{
                return true;
            }
#endif
        };

        class ReentrantBlockingCodec final : public NWB::Core::Assets::IAssetCodec{
        public:
            ReentrantBlockingCodec(const Name& assetType, const NWB::Core::Assets::AssetRegistry& registry, const Name& leafType, Atomic<b8>& entered, Atomic<b8>& release, Atomic<b8>& destroyedWhileActive)noexcept
                : IAssetCodec(assetType)
                , m_registry(registry)
                , m_leafType(leafType)
                , m_entered(entered)
                , m_release(release)
                , m_destroyedWhileActive(destroyedWhileActive)
            {}

            virtual ~ReentrantBlockingCodec()noexcept override{
                if(m_inFlight.load())
                    m_destroyedWhileActive.store(true);
            }


        public:
            virtual Expected<UniquePtr<NWB::Core::Assets::IAsset>> deserialize(const Name& virtualPath, const Span<const u8> binary, NWB::Core::Assets::AssetArena&)const override{
                m_inFlight.store(true);
                auto nested = m_registry.deserializeAsset(m_leafType, Name(s_AssetCaseProjectProbeLeaf), binary);
                if(!nested){
                    m_inFlight.store(false);
                    return MakeUnexpected(Failure{});
                }
                m_entered.store(true);
                while(!m_release.load())
                    YieldThread();
                m_inFlight.store(false);
                return UniquePtr<NWB::Core::Assets::IAsset>(MakeUnique<ProbeAsset>(assetType(), virtualPath));
            }

#if defined(NWB_COOK)
            virtual b8 serialize(const NWB::Core::Assets::IAsset&, NWB::Core::Assets::AssetBytes&)const override{
                return true;
            }
#endif


        private:
            const NWB::Core::Assets::AssetRegistry& m_registry;
            Name m_leafType;
            Atomic<b8>& m_entered;
            Atomic<b8>& m_release;
            Atomic<b8>& m_destroyedWhileActive;
            mutable Atomic<b8> m_inFlight{false};
        };

        NWB::Core::Assets::AssetRegistry registry(testArena.arena);
        const Name parentType = s_ProbeParentAsset;
        const Name leafType = s_ProbeLeafAsset;
        Atomic<b8> entered{false};
        Atomic<b8> release{false};
        Atomic<b8> destroyedWhileActive{false};
        Atomic<b8> unregisterFinished{false};

        ASSERT_TRUE(registry.registerCodec(MakeUnique<LeafProbeCodec>(leafType)));
        ASSERT_TRUE(registry.registerCodec(MakeUnique<ReentrantBlockingCodec>(parentType, registry, leafType, entered, release, destroyedWhileActive)));

        Expected<UniquePtr<NWB::Core::Assets::IAsset>> parentResult = MakeUnexpected(Failure{});
        Thread deserializeThread([&](){
            parentResult = registry.deserializeAsset(parentType, Name(s_AssetCaseProjectProbeParent), Span<const u8>{});
        });

        while(!entered.load())
            YieldThread();

        b8 unregistered = false;
        Thread unregisterThread([&](){
            unregistered = registry.unregisterCodec(parentType);
            unregisterFinished.store(true);
        });

        for(u32 spin = 0u; spin < 64u; ++spin)
            YieldThread();
        EXPECT_FALSE(unregisterFinished.load());

        release.store(true);
        deserializeThread.join();
        unregisterThread.join();

        ASSERT_TRUE(parentResult);
        ASSERT_NE(parentResult->get(), nullptr);
        EXPECT_EQ((*parentResult)->assetType(), parentType);
        EXPECT_TRUE(unregistered);
        EXPECT_TRUE(unregisterFinished.load());
        EXPECT_FALSE(destroyedWhileActive.load());
    }
}


