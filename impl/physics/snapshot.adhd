#include <impl/physics/world.adhd>
#include <impl/physics/buoyancy.adhd>
#include <impl/physics/soft_body.adhd>
#include <impl/physics/vehicle.adhd>
#include <impl/physics/ragdoll.adhd>
#include <impl/physics/character_controller.adhd>
#include <impl/physics/articulation.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_SnapshotMagic = 0x50534E57u;
const u32 s_SnapshotVersion = 2u;
const u32 s_SubsystemsSnapshotMagic = 0x50535353u;
const u32 s_SubsystemsSnapshotVersion = 1u;
const u32 s_FullSnapshotMagic = 0x50534657u;
const u32 s_FullSnapshotVersion = 1u;
const u32 s_SnapshotMaxElements = 16777216u;
const u64 s_Fnv64OffsetBasis = 14695981039346656037u;
const u64 s_Fnv64Prime = 1099511628211u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u64 SnapshotFnv1a64(in Span<u8> data){
    u64 h = s_Fnv64OffsetBasis;
    for(usize i = 0u; i < data.size(); ++i){
        h ^= cast<u64>(data[i]);
        h *= s_Fnv64Prime;
    }
    return h;
}

interface ISnapshotSink{
    void writeU8(in u8 v);
    void writeB8(in b8 v);
    void writeU16(in u16 v);
    void writeI16(in i16 v);
    void writeU32(in u32 v);
    void writeI32(in i32 v);
    void writeU64(in u64 v);
    void writeF32(in f32 v);
    b8 writeCount(in usize n);
    void writeBytes(in Span<u8> data);
    void writeU16Span(in Span<u16> data);
    void writeU32Span(in Span<u32> data);
    void writeF32Span(in Span<f32> data);
}

class SnapshotFnv1a64Sink : ISnapshotSink{
    public u64 hash = s_Fnv64OffsetBasis;

    public void writeU8(in u8 v)override{
        this.hash ^= cast<u64>(v);
        this.hash *= s_Fnv64Prime;
    }

    public void writeB8(in b8 v)override{
        if(v)
            this.writeU8(1u);
        else
            this.writeU8(0u);
    }

    public void writeU16(in u16 v)override{
        u64 h = this.hash;
        h ^= cast<u64>(v & 0xffu);
        h *= s_Fnv64Prime;
        h ^= cast<u64>((v >> 8u) & 0xffu);
        h *= s_Fnv64Prime;
        this.hash = h;
    }

    public void writeI16(in i16 v)override{
        this.writeU16(bit_cast<u16>(v));
    }

    public void writeU32(in u32 v)override{
        u64 h = this.hash;
        h ^= cast<u64>(v & 0xffu);
        h *= s_Fnv64Prime;
        h ^= cast<u64>((v >> 8u) & 0xffu);
        h *= s_Fnv64Prime;
        h ^= cast<u64>((v >> 16u) & 0xffu);
        h *= s_Fnv64Prime;
        h ^= cast<u64>((v >> 24u) & 0xffu);
        h *= s_Fnv64Prime;
        this.hash = h;
    }

    public void writeI32(in i32 v)override{
        this.writeU32(bit_cast<u32>(v));
    }

    public void writeU64(in u64 v)override{
        u64 h = this.hash;
        const u32 lo = cast<u32>(v & 0xffffffffu);
        const u32 hi = cast<u32>((v >> 32u) & 0xffffffffu);
        h ^= cast<u64>(lo & 0xffu); h *= s_Fnv64Prime;
        h ^= cast<u64>((lo >> 8u) & 0xffu); h *= s_Fnv64Prime;
        h ^= cast<u64>((lo >> 16u) & 0xffu); h *= s_Fnv64Prime;
        h ^= cast<u64>((lo >> 24u) & 0xffu); h *= s_Fnv64Prime;
        h ^= cast<u64>(hi & 0xffu); h *= s_Fnv64Prime;
        h ^= cast<u64>((hi >> 8u) & 0xffu); h *= s_Fnv64Prime;
        h ^= cast<u64>((hi >> 16u) & 0xffu); h *= s_Fnv64Prime;
        h ^= cast<u64>((hi >> 24u) & 0xffu); h *= s_Fnv64Prime;
        this.hash = h;
    }

    public void writeF32(in f32 v)override{
        this.writeU32(bit_cast<u32>(v));
    }

    public b8 writeCount(in usize n)override{
        if(n > s_SnapshotMaxElements)
            return false;
        this.writeU32(cast<u32>(n));
        return true;
    }

    public void writeBytes(in Span<u8> data)override{
        u64 h = this.hash;
        for(usize i = 0u; i < data.size(); ++i){
            h ^= cast<u64>(data[i]);
            h *= s_Fnv64Prime;
        }
        this.hash = h;
    }

    public void writeU16Span(in Span<u16> data)override{
        u64 h = this.hash;
        for(usize i = 0u; i < data.size(); ++i){
            const u16 v = data[i];
            h ^= cast<u64>(v & 0xffu); h *= s_Fnv64Prime;
            h ^= cast<u64>((v >> 8u) & 0xffu); h *= s_Fnv64Prime;
        }
        this.hash = h;
    }

    public void writeU32Span(in Span<u32> data)override{
        u64 h = this.hash;
        for(usize i = 0u; i < data.size(); ++i){
            const u32 v = data[i];
            h ^= cast<u64>(v & 0xffu); h *= s_Fnv64Prime;
            h ^= cast<u64>((v >> 8u) & 0xffu); h *= s_Fnv64Prime;
            h ^= cast<u64>((v >> 16u) & 0xffu); h *= s_Fnv64Prime;
            h ^= cast<u64>((v >> 24u) & 0xffu); h *= s_Fnv64Prime;
        }
        this.hash = h;
    }

    public void writeF32Span(in Span<f32> data)override{
        u64 h = this.hash;
        for(usize i = 0u; i < data.size(); ++i){
            const u32 v = bit_cast<u32>(data[i]);
            h ^= cast<u64>(v & 0xffu); h *= s_Fnv64Prime;
            h ^= cast<u64>((v >> 8u) & 0xffu); h *= s_Fnv64Prime;
            h ^= cast<u64>((v >> 16u) & 0xffu); h *= s_Fnv64Prime;
            h ^= cast<u64>((v >> 24u) & 0xffu); h *= s_Fnv64Prime;
        }
        this.hash = h;
    }
}

void SnapWriteVec4<TSink : ISnapshotSink>(mut TSink w, in VectorSingle v){
    w.writeF32(v.x);
    w.writeF32(v.y);
    w.writeF32(v.z);
    w.writeF32(v.w);
}

void SnapWriteVec3<TSink : ISnapshotSink>(mut TSink w, in VectorSingle v){
    w.writeF32(v.x);
    w.writeF32(v.y);
    w.writeF32(v.z);
}

void SnapWriteVec2F<TSink : ISnapshotSink>(mut TSink w, in f32 x, in f32 y){
    w.writeF32(x);
    w.writeF32(y);
}

void SnapWriteVec3U32F<TSink : ISnapshotSink>(mut TSink w, in f32 x, in f32 y, in f32 z, in u32 u){
    w.writeF32(x);
    w.writeF32(y);
    w.writeF32(z);
    w.writeU32(u);
}

void SnapWriteU32x4F<TSink : ISnapshotSink>(mut TSink w, in u32 x, in u32 y, in u32 z, in u32 u){
    w.writeU32(x);
    w.writeU32(y);
    w.writeU32(z);
    w.writeU32(u);
}

void SnapWriteTransform3D<TSink : ISnapshotSink>(mut TSink w, in Transform3D xf){
    SnapWriteVec4(w, VectorSingle(xf.position));
    SnapWriteVec4(w, VectorSingle(xf.rotation));
}

void SnapWriteAabb3D<TSink : ISnapshotSink>(mut TSink w, in Aabb3D box){
    SnapWriteVec4(w, VectorSingle(box.lowerBound));
    SnapWriteVec4(w, VectorSingle(box.upperBound));
}

void SnapWriteSymMat3<TSink : ISnapshotSink>(mut TSink w, in SymMat3 m){
    w.writeF32(m.m00);
    w.writeF32(m.m01);
    w.writeF32(m.m02);
    w.writeF32(m.m11);
    w.writeF32(m.m12);
    w.writeF32(m.m22);
}

void SnapWriteFilter<TSink : ISnapshotSink>(mut TSink w, in Filter f){
    w.writeU32(f.categoryBits);
    w.writeU32(f.maskBits);
    w.writeI32(f.groupIndex);
}

void SnapWriteSurfaceMaterial<TSink : ISnapshotSink>(mut TSink w, in SurfaceMaterial m){
    SnapWriteVec4(w, VectorSingle(m.surfaceVelocity));
    SnapWriteVec4(w, VectorSingle(m.anisotropicFriction));
    SnapWriteVec4(w, VectorSingle(m.frictionDirection));
    w.writeF32(m.friction);
    w.writeF32(m.staticFriction);
    w.writeF32(m.restitution);
    w.writeF32(m.rollingResistance);
    w.writeF32(m.tangentSpeed);
    w.writeU8(cast<u8>(m.frictionCombineMode));
    w.writeU8(cast<u8>(m.restitutionCombineMode));
}

class SnapshotByteReader{
    public usize cursor = 0u;
    public usize limit = 0u;

    public b8 hasRemaining(in usize needed)const{
        if(this.cursor > this.limit)
            return false;
        return needed <= (this.limit - this.cursor);
    }

    public b8 readU8(in Span<u8> data, mut u8 outVal){
        if(!this.hasRemaining(1u))
            return false;
        outVal = data[this.cursor];
        ++this.cursor;
        return true;
    }

    public b8 readB8(in Span<u8> data, mut b8 outVal){
        u8 b = 0u;
        if(!this.readU8(data, b))
            return false;
        outVal = (b != 0u);
        return true;
    }

    public b8 readU16(in Span<u8> data, mut u16 outVal){
        if(!this.hasRemaining(2u))
            return false;
        const u16 b0 = cast<u16>(data[this.cursor]);
        const u16 b1 = cast<u16>(data[this.cursor + 1u]);
        outVal = b0 | (b1 << 8u);
        this.cursor += 2u;
        return true;
    }

    public b8 readI16(in Span<u8> data, mut i16 outVal){
        u16 bits = 0u;
        if(!this.readU16(data, bits))
            return false;
        outVal = bit_cast<i16>(bits);
        return true;
    }

    public b8 readU32(in Span<u8> data, mut u32 outVal){
        if(!this.hasRemaining(4u))
            return false;
        const u32 b0 = cast<u32>(data[this.cursor]);
        const u32 b1 = cast<u32>(data[this.cursor + 1u]);
        const u32 b2 = cast<u32>(data[this.cursor + 2u]);
        const u32 b3 = cast<u32>(data[this.cursor + 3u]);
        outVal = b0 | (b1 << 8u) | (b2 << 16u) | (b3 << 24u);
        this.cursor += 4u;
        return true;
    }

    public u8 readU8Unchecked(in Span<u8> data){
        const u8 v = data[this.cursor];
        ++this.cursor;
        return v;
    }

    public u16 readU16Unchecked(in Span<u8> data){
        const u16 b0 = cast<u16>(data[this.cursor]);
        const u16 b1 = cast<u16>(data[this.cursor + 1u]);
        this.cursor += 2u;
        return b0 | (b1 << 8u);
    }

    public u32 readU32Unchecked(in Span<u8> data){
        const u32 b0 = cast<u32>(data[this.cursor]);
        const u32 b1 = cast<u32>(data[this.cursor + 1u]);
        const u32 b2 = cast<u32>(data[this.cursor + 2u]);
        const u32 b3 = cast<u32>(data[this.cursor + 3u]);
        this.cursor += 4u;
        return b0 | (b1 << 8u) | (b2 << 16u) | (b3 << 24u);
    }

    public b8 readI32(in Span<u8> data, mut i32 outVal){
        u32 bits = 0u;
        if(!this.readU32(data, bits))
            return false;
        outVal = bit_cast<i32>(bits);
        return true;
    }

    public b8 readU64(in Span<u8> data, mut u64 outVal){
        u32 lo = 0u;
        u32 hi = 0u;
        if(!this.readU32(data, lo) || !this.readU32(data, hi))
            return false;
        outVal = cast<u64>(lo) | (cast<u64>(hi) << 32u);
        return true;
    }

    public b8 readF32(in Span<u8> data, mut f32 outVal){
        u32 bits = 0u;
        if(!this.readU32(data, bits))
            return false;
        outVal = bit_cast<f32>(bits);
        return true;
    }

    public b8 readVec4F(in Span<u8> data, mut f32 ox, mut f32 oy, mut f32 oz, mut f32 ow){
        return this.readF32(data, ox) && this.readF32(data, oy) && this.readF32(data, oz) && this.readF32(data, ow);
    }

    public b8 readVec3F(in Span<u8> data, mut f32 ox, mut f32 oy, mut f32 oz){
        return this.readF32(data, ox) && this.readF32(data, oy) && this.readF32(data, oz);
    }

    public b8 readVec2F(in Span<u8> data, mut f32 ox, mut f32 oy){
        return this.readF32(data, ox) && this.readF32(data, oy);
    }

    public b8 readVec3U32F(in Span<u8> data, mut f32 ox, mut f32 oy, mut f32 oz, mut u32 ow){
        return this.readF32(data, ox) && this.readF32(data, oy) && this.readF32(data, oz) && this.readU32(data, ow);
    }

    public b8 readU32x4F(in Span<u8> data, mut u32 ox, mut u32 oy, mut u32 oz, mut u32 ow){
        return this.readU32(data, ox) && this.readU32(data, oy) && this.readU32(data, oz) && this.readU32(data, ow);
    }

    public b8 readTransform3D(in Span<u8> data, mut Transform3D outXf){
        return
            this.readVec4F(data, outXf.position.x, outXf.position.y, outXf.position.z, outXf.position.w)
            && this.readVec4F(data, outXf.rotation.x, outXf.rotation.y, outXf.rotation.z, outXf.rotation.w)
        ;
    }

    public b8 readAabb3D(in Span<u8> data, mut Aabb3D outBox){
        return
            this.readVec4F(data, outBox.lowerBound.x, outBox.lowerBound.y, outBox.lowerBound.z, outBox.lowerBound.w)
            && this.readVec4F(data, outBox.upperBound.x, outBox.upperBound.y, outBox.upperBound.z, outBox.upperBound.w)
        ;
    }

    public b8 readSymMat3(in Span<u8> data, mut SymMat3 outM){
        return
            this.readF32(data, outM.m00)
            && this.readF32(data, outM.m01)
            && this.readF32(data, outM.m02)
            && this.readF32(data, outM.m11)
            && this.readF32(data, outM.m12)
            && this.readF32(data, outM.m22)
        ;
    }

    public b8 readFilter(in Span<u8> data, mut Filter outF){
        return this.readU32(data, outF.categoryBits) && this.readU32(data, outF.maskBits) && this.readI32(data, outF.groupIndex);
    }

    public b8 readBodyId(in Span<u8> data, mut BodyId outId){
        return this.readU32(data, outId.index) && this.readU16(data, outId.generation) && this.readU16(data, outId.worldIndex);
    }

    public b8 readShapeId(in Span<u8> data, mut ShapeId outId){
        return this.readU32(data, outId.index) && this.readU16(data, outId.generation) && this.readU16(data, outId.worldIndex);
    }

    public b8 readJointId(in Span<u8> data, mut JointId outId){
        return this.readU32(data, outId.index) && this.readU16(data, outId.generation) && this.readU16(data, outId.worldIndex);
    }

    public b8 readSurfaceMaterial(in Span<u8> data, mut SurfaceMaterial outM){
        u8 fMode = 0u;
        u8 rMode = 0u;
        if(
            !this.readVec4F(data, outM.surfaceVelocity.x, outM.surfaceVelocity.y, outM.surfaceVelocity.z, outM.surfaceVelocity.w)
            || !this.readVec4F(data, outM.anisotropicFriction.x, outM.anisotropicFriction.y, outM.anisotropicFriction.z, outM.anisotropicFriction.w)
            || !this.readVec4F(data, outM.frictionDirection.x, outM.frictionDirection.y, outM.frictionDirection.z, outM.frictionDirection.w)
            || !this.readF32(data, outM.friction)
            || !this.readF32(data, outM.staticFriction)
            || !this.readF32(data, outM.restitution)
            || !this.readF32(data, outM.rollingResistance)
            || !this.readF32(data, outM.tangentSpeed)
            || !this.readU8(data, fMode)
            || !this.readU8(data, rMode)
        )
            return false;
        if(fMode >= cast<u8>(MaterialCombineMode::kCount) || rMode >= cast<u8>(MaterialCombineMode::kCount))
            return false;
        outM.frictionCombineMode = cast<MaterialCombineMode>(fMode);
        outM.restitutionCombineMode = cast<MaterialCombineMode>(rMode);
        return true;
    }

    public b8 readCount(in Span<u8> data, in usize minBytesPerItem, mut u32 outCount){
        if(!this.readU32(data, outCount))
            return false;
        if(outCount > s_SnapshotMaxElements)
            return false;
        if(minBytesPerItem > 0u && !this.hasRemaining(cast<usize>(outCount) * minBytesPerItem))
            return false;
        return true;
    }
}

void SnapWriteBodyId<TSink : ISnapshotSink>(mut TSink w, in BodyId id){
    w.writeU32(id.index);
    w.writeU16(id.generation);
    w.writeU16(id.worldIndex);
}

void SnapWriteShapeId<TSink : ISnapshotSink>(mut TSink w, in ShapeId id){
    w.writeU32(id.index);
    w.writeU16(id.generation);
    w.writeU16(id.worldIndex);
}

b8 SnapshotWriteU32Vec<TSink : ISnapshotSink>(mut TSink w, in Vector<u32> v){
    if(!w.writeCount(v.size()))
        return false;
    w.writeU32Span(Span<u32>(v));
    return true;
}

b8 SnapshotWriteU16Vec<TSink : ISnapshotSink>(mut TSink w, in Vector<u16> v){
    if(!w.writeCount(v.size()))
        return false;
    w.writeU16Span(Span<u16>(v));
    return true;
}

b8 SnapshotWriteU8Vec<TSink : ISnapshotSink>(mut TSink w, in Vector<u8> v){
    if(!w.writeCount(v.size()))
        return false;
    w.writeBytes(Span<u8>(v));
    return true;
}

b8 SnapshotReadU32Vec(in Span<u8> data, mut SnapshotByteReader r, mut Vector<u32> outV){
    u32 cnt = 0u;
    if(!r.readCount(data, 4u, cnt))
        return false;
    outV.resize(cnt);
    usize c = r.cursor;
    for(u32 i = 0u; i < cnt; ++i){
        const u32 b0 = cast<u32>(data[c]);
        const u32 b1 = cast<u32>(data[c + 1u]);
        const u32 b2 = cast<u32>(data[c + 2u]);
        const u32 b3 = cast<u32>(data[c + 3u]);
        outV[i] = b0 | (b1 << 8u) | (b2 << 16u) | (b3 << 24u);
        c += 4u;
    }
    r.cursor = c;
    return true;
}

b8 SnapshotReadU16Vec(in Span<u8> data, mut SnapshotByteReader r, mut Vector<u16> outV){
    u32 cnt = 0u;
    if(!r.readCount(data, 2u, cnt))
        return false;
    outV.resize(cnt);
    usize c = r.cursor;
    for(u32 i = 0u; i < cnt; ++i){
        const u16 b0 = cast<u16>(data[c]);
        const u16 b1 = cast<u16>(data[c + 1u]);
        outV[i] = b0 | (b1 << 8u);
        c += 2u;
    }
    r.cursor = c;
    return true;
}

b8 SnapshotReadU8Vec(in Span<u8> data, mut SnapshotByteReader r, mut Vector<u8> outV){
    u32 cnt = 0u;
    if(!r.readCount(data, 1u, cnt))
        return false;
    outV.resize(cnt);
    usize c = r.cursor;
    for(u32 i = 0u; i < cnt; ++i){
        outV[i] = data[c];
        ++c;
    }
    r.cursor = c;
    return true;
}

void SnapWriteJointId<TSink : ISnapshotSink>(in JointId id, mut TSink w){
    w.writeU32(id.index);
    w.writeU16(id.generation);
    w.writeU16(id.worldIndex);
}

void SnapWriteSpatialVec<TSink : ISnapshotSink>(in SpatialVec v, mut TSink w){
    SnapWriteVec4(w, VectorSingle(v.ang));
    SnapWriteVec4(w, VectorSingle(v.lin));
}

b8 SnapReadSpatialVec(in Span<u8> bytes, mut SnapshotByteReader r, mut SpatialVec outV){
    return
        r.readVec4F(bytes, outV.ang.x, outV.ang.y, outV.ang.z, outV.ang.w)
        && r.readVec4F(bytes, outV.lin.x, outV.lin.y, outV.lin.z, outV.lin.w)
    ;
}

b8 SnapshotWriteF32Vec<TSink : ISnapshotSink>(in Vector<f32> v, mut TSink w){
    if(!w.writeCount(v.size()))
        return false;
    w.writeF32Span(Span<f32>(v));
    return true;
}

b8 SnapshotReadF32Vec(in Span<u8> data, mut SnapshotByteReader r, mut Vector<f32> outV){
    u32 cnt = 0u;
    if(!r.readCount(data, 4u, cnt))
        return false;
    outV.resize(cnt);
    for(u32 i = 0u; i < cnt; ++i){
        if(!r.readF32(data, outV[i]))
            return false;
    }
    return true;
}

b8 SnapshotWriteVec4Vec<TSink : ISnapshotSink>(in Vector<f32x4> v, mut TSink w){
    if(!w.writeCount(v.size()))
        return false;
    for(usize i = 0u; i < v.size(); ++i)
        SnapWriteVec4(w, VectorSingle(v[i]));
    return true;
}

b8 SnapshotReadVec4Vec(in Span<u8> data, mut SnapshotByteReader r, mut Vector<f32x4> outV){
    u32 cnt = 0u;
    if(!r.readCount(data, 16u, cnt))
        return false;
    outV.resize(cnt);
    for(u32 i = 0u; i < cnt; ++i){
        if(!r.readVec4F(data, outV[i].x, outV[i].y, outV[i].z, outV[i].w))
            return false;
    }
    return true;
}

usize EstimatePhysicsWorldSnapshotSize(in PhysicsWorld world){
    usize est = 512u;
    est += world.m_bodies.size() * 100u + world.m_freeBodyIds.size() * 4u;
    est += world.m_shapes.size() * 196u + world.m_freeShapeIds.size() * 4u;
    for(usize i = 0u; i < world.m_hullShapes.size(); ++i){
        in HullShape h = world.m_hullShapes[i];
        est += 64u + h.vertices.size() * 12u + h.facePlanes.size() * 16u + h.faceTopologies.size() * 2u + h.halfEdges.size() * 4u;
    }
    est += world.m_hullLocalAabbs.size() * 32u + world.m_hullRefCounts.size() * 4u + world.m_hullGenerations.size() * 2u + world.m_hullOwnedByUser.size() + world.m_freeHullShapeIds.size() * 4u;
    for(usize i = 0u; i < world.m_meshShapes.size(); ++i){
        in MeshShape m = world.m_meshShapes[i];
        est += 64u + m.triangles.size() * 48u + m.nodes.size() * 32u + m.materials.size() * 70u + m.triangleMaterialIndices.size() * 2u + m.triangleUserData.size() * 4u;
    }
    est += world.m_meshRefCounts.size() * 4u + world.m_meshGenerations.size() * 2u + world.m_meshOwnedByUser.size() + world.m_freeMeshShapeIds.size() * 4u;
    for(usize i = 0u; i < world.m_heightfieldShapes.size(); ++i){
        in HeightfieldShape hf = world.m_heightfieldShapes[i];
        est += 65u + hf.heights.size() * 4u + hf.cellMaterialIndices.size() * 2u + hf.materials.size() * 70u + hf.cellHoles.size();
    }
    est += world.m_heightfieldRefCounts.size() * 4u + world.m_heightfieldGenerations.size() * 2u + world.m_heightfieldOwnedByUser.size() + world.m_freeHeightfieldShapeIds.size() * 4u;
    est += world.m_contacts.size() * 384u + world.m_freeContactIds.size() * 4u;
    est += world.m_joints.size() * 329u + world.m_freeJointIds.size() * 4u;
    for(usize i = 0u; i < world.m_jointExtraData.size(); ++i)
        est += 324u + world.m_jointExtraData[i].pathPoints.size() * 16u;
    est += world.m_freeJointExtraData.size() * 4u;
    for(usize i = 0u; i < world.m_solverSets.size(); ++i){
        in SolverSet ss = world.m_solverSets[i];
        est += 24u + ss.sims.size() * 204u + ss.states.size() * 64u + ss.islands.size() * 4u;
    }
    est += world.m_freeSolverSetIds.size() * 4u;
    for(usize i = 0u; i < world.m_islands.size(); ++i){
        in Island isl = world.m_islands[i];
        est += 32u + isl.bodies.size() * 4u + isl.contacts.size() * 12u + isl.joints.size() * 12u;
    }
    est += world.m_freeIslandIds.size() * 4u;
    for(usize c = 0u; c < s_GraphColorCount; ++c)
        est += 4u + world.m_graph.colors[c].contactIds.size() * 4u;
    est += world.m_graph.bodyColorMasks.size() * 4u;
    for(usize t = 0u; t < s_TreeCount; ++t){
        in DynamicTree tree = world.m_broadPhase.trees[t];
        est += 20u + tree.nodes().size() * 46u + tree.moveIndices().size() * 4u;
    }
    est += world.m_broadPhase.moveArray.size() * 4u;
    est += 12u + world.m_pendingContactEndEvents.size() * 16u + world.m_pendingSensorEndEvents.size() * 16u + world.m_pendingBodyWakeEvents.size() * 17u;
    est += 8u + world.m_ignoredBodyPairs.size() * 16u + world.m_secondaryContactManifolds.size() * 260u;
    return est;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void SnapWriteManifold<TSink : ISnapshotSink>(in Manifold m, mut TSink w){
    for(usize pi = 0u; pi < s_MaxManifoldPoints; ++pi){
        SnapWriteVec4(w, VectorSingle(m.points[pi].pointSeparation));
        SnapWriteVec4(w, VectorSingle(m.points[pi].anchorANormalImpulse));
        SnapWriteVec4(w, VectorSingle(m.points[pi].anchorBTotalImpulse));
    }
    SnapWriteVec4(w, VectorSingle(m.normalTwist));
    SnapWriteVec3U32F(w, m.rollingImpulseMeta.x, m.rollingImpulseMeta.y, m.rollingImpulseMeta.z, m.rollingImpulseMeta.w);
    SnapWriteU32x4F(w, m.pointIds.x, m.pointIds.y, m.pointIds.z, m.pointIds.w);
    SnapWriteVec2F(w, m.frictionImpulse.x, m.frictionImpulse.y);
    w.writeU32(m.materialTriangleA);
    w.writeU32(m.materialTriangleB);
}

b8 SnapReadManifold(in Span<u8> bytes, mut SnapshotByteReader r, mut Manifold outM){
    for(usize pi = 0u; pi < s_MaxManifoldPoints; ++pi){
        if(
            !r.readVec4F(bytes, outM.points[pi].pointSeparation.x, outM.points[pi].pointSeparation.y, outM.points[pi].pointSeparation.z, outM.points[pi].pointSeparation.w)
            || !r.readVec4F(bytes, outM.points[pi].anchorANormalImpulse.x, outM.points[pi].anchorANormalImpulse.y, outM.points[pi].anchorANormalImpulse.z, outM.points[pi].anchorANormalImpulse.w)
            || !r.readVec4F(bytes, outM.points[pi].anchorBTotalImpulse.x, outM.points[pi].anchorBTotalImpulse.y, outM.points[pi].anchorBTotalImpulse.z, outM.points[pi].anchorBTotalImpulse.w)
        )
            return false;
    }
    if(
        !r.readVec4F(bytes, outM.normalTwist.x, outM.normalTwist.y, outM.normalTwist.z, outM.normalTwist.w)
        || !r.readVec3U32F(bytes, outM.rollingImpulseMeta.x, outM.rollingImpulseMeta.y, outM.rollingImpulseMeta.z, outM.rollingImpulseMeta.w)
        || !r.readU32x4F(bytes, outM.pointIds.x, outM.pointIds.y, outM.pointIds.z, outM.pointIds.w)
        || !r.readVec2F(bytes, outM.frictionImpulse.x, outM.frictionImpulse.y)
        || !r.readU32(bytes, outM.materialTriangleA)
        || !r.readU32(bytes, outM.materialTriangleB)
    )
        return false;
    return true;
}

b8 SerializePhysicsWorldSnapshotPayload<TSink : ISnapshotSink>(in PhysicsWorld world, mut TSink w){
    w.writeU32(s_SnapshotMagic);
    w.writeU32(s_SnapshotVersion);

    SnapWriteVec4(w, VectorSingle(world.m_def.gravity));
    w.writeF32(world.m_def.restitutionThreshold);
    w.writeF32(world.m_def.hitEventThreshold);
    w.writeF32(world.m_def.contactHertz);
    w.writeF32(world.m_def.contactDampingRatio);
    w.writeF32(world.m_def.maxLinearVelocity);
    w.writeF32(world.m_def.timeToSleep);
    w.writeB8(world.m_def.enableSleep);
    w.writeB8(world.m_def.enableContinuous);
    w.writeB8(world.m_def.enableContactSoftening);
    w.writeB8(world.m_def.enableGpuCollision);
    w.writeB8(world.m_def.forceGpuCollision);
    w.writeB8(world.m_def.gpuResidentMode);
    w.writeB8(world.m_def.useGpuLbvhBroadphase);

    w.writeU16(world.m_worldIndex);
    w.writeU8(cast<u8>(world.m_backendMode));
    w.writeU32(world.m_gpuDispatchThreshold);
    w.writeF32(world.m_gpuWorkloadFraction);
    w.writeB8(world.m_enableWarmStarting);
    w.writeB8(world.m_hasDirtyBodyMass);
    w.writeB8(world.m_cpuBroadphaseDirty);
    w.writeU32(world.m_sensorEventShapeCount);
    w.writeU32(world.m_hitEventShapeCount);
    w.writeU32(world.m_breakableJointCount);
    w.writeU32(world.m_bulletBodyCount);

    if(!w.writeCount(world.m_bodies.size()))
        return false;
    for(usize i = 0u; i < world.m_bodies.size(); ++i){
        in Body b = world.m_bodies[i];
        w.writeU64(b.userData);
        w.writeU32(b.setIndex);
        w.writeU32(b.localIndex);
        w.writeU32(b.headContactKey);
        w.writeU32(b.contactCount);
        w.writeU32(b.headJointKey);
        w.writeU32(b.jointCount);
        w.writeU32(b.headShapeId);
        w.writeU32(b.shapeCount);
        w.writeU32(b.islandId);
        w.writeU32(b.islandIndex);
        w.writeF32(b.sleepThreshold);
        w.writeF32(b.sleepTime);
        w.writeF32(b.mass);
        SnapWriteSymMat3(w, b.inertiaLocal);
        w.writeF32(b.maxAngularVelocity);
        w.writeU32(b.bodyMoveIndex);
        w.writeU32(b.id);
        w.writeU32(b.flags);
        w.writeU8(cast<u8>(b.type));
        w.writeU16(b.generation);
        w.writeB8(b.alive);
    }
    if(!SnapshotWriteU32Vec(w, world.m_freeBodyIds))
        return false;

    if(!w.writeCount(world.m_shapes.size()))
        return false;
    for(usize i = 0u; i < world.m_shapes.size(); ++i){
        in Shape s = world.m_shapes[i];
        SnapWriteVec4(w, VectorSingle(s.geom0));
        SnapWriteVec4(w, VectorSingle(s.geom1));
        SnapWriteAabb3D(w, s.aabb);
        SnapWriteTransform3D(w, s.localTransform);
        w.writeU64(s.userData);
        SnapWriteSurfaceMaterial(w, s.material);
        SnapWriteFilter(w, s.filter);
        w.writeU32(s.bodyId);
        w.writeU32(s.id);
        w.writeU32(s.nextShapeId);
        w.writeU32(s.proxyKey);
        w.writeU32(s.geometryIndex);
        w.writeF32(s.density);
        w.writeU16(s.generation);
        w.writeU8(cast<u8>(s.type));
        w.writeU8(s.flags);
    }
    if(!SnapshotWriteU32Vec(w, world.m_freeShapeIds))
        return false;

    if(!w.writeCount(world.m_hullShapes.size()))
        return false;
    for(usize i = 0u; i < world.m_hullShapes.size(); ++i){
        in HullShape h = world.m_hullShapes[i];
        SnapWriteVec4(w, VectorSingle(h.centroidRadius));
        SnapWriteVec3U32F(w, h.halfExtentsFlags.x, h.halfExtentsFlags.y, h.halfExtentsFlags.z, h.halfExtentsFlags.w);
        SnapWriteVec4(w, VectorSingle(h.boxRotation));
        if(!w.writeCount(h.vertices.size()))
            return false;
        for(usize k = 0u; k < h.vertices.size(); ++k)
            SnapWriteVec3(w, VectorSingle(h.vertices[k], 0.0f));
        if(!w.writeCount(h.facePlanes.size()))
            return false;
        for(usize k = 0u; k < h.facePlanes.size(); ++k)
            SnapWriteVec4(w, VectorSingle(h.facePlanes[k].normalOffset));
        if(!w.writeCount(h.faceTopologies.size()))
            return false;
        for(usize k = 0u; k < h.faceTopologies.size(); ++k){
            w.writeU8(h.faceTopologies[k].edge);
            w.writeU8(h.faceTopologies[k].vertexCount);
        }
        if(!w.writeCount(h.halfEdges.size()))
            return false;
        for(usize k = 0u; k < h.halfEdges.size(); ++k){
            w.writeU8(h.halfEdges[k].tail);
            w.writeU8(h.halfEdges[k].face);
            w.writeU8(h.halfEdges[k].next);
            w.writeU8(h.halfEdges[k].twin);
        }
    }
    if(!w.writeCount(world.m_hullLocalAabbs.size()))
        return false;
    for(usize i = 0u; i < world.m_hullLocalAabbs.size(); ++i)
        SnapWriteAabb3D(w, world.m_hullLocalAabbs[i]);
    if(
        !SnapshotWriteU32Vec(w, world.m_hullRefCounts)
        || !SnapshotWriteU16Vec(w, world.m_hullGenerations)
        || !SnapshotWriteU8Vec(w, world.m_hullOwnedByUser)
        || !SnapshotWriteU32Vec(w, world.m_freeHullShapeIds)
    )
        return false;

    if(!w.writeCount(world.m_meshShapes.size()))
        return false;
    for(usize i = 0u; i < world.m_meshShapes.size(); ++i){
        in MeshShape m = world.m_meshShapes[i];
        SnapWriteVec4(w, VectorSingle(m.localAabbMinRadius));
        SnapWriteVec3U32F(w, m.localAabbMaxMeta.x, m.localAabbMaxMeta.y, m.localAabbMaxMeta.z, m.localAabbMaxMeta.w);
        if(!w.writeCount(m.triangles.size()))
            return false;
        for(usize k = 0u; k < m.triangles.size(); ++k){
            SnapWriteVec3(w, VectorSingle(m.triangles[k].v0, 0.0f));
            SnapWriteVec3(w, VectorSingle(m.triangles[k].v1, 0.0f));
            SnapWriteVec3(w, VectorSingle(m.triangles[k].v2, 0.0f));
            SnapWriteVec3(w, VectorSingle(m.triangles[k].normal, 0.0f));
        }
        if(!w.writeCount(m.nodes.size()))
            return false;
        for(usize k = 0u; k < m.nodes.size(); ++k){
            SnapWriteVec3U32F(w, m.nodes[k].aabbMinLeft.x, m.nodes[k].aabbMinLeft.y, m.nodes[k].aabbMinLeft.z, m.nodes[k].aabbMinLeft.w);
            SnapWriteVec3U32F(w, m.nodes[k].aabbMaxRight.x, m.nodes[k].aabbMaxRight.y, m.nodes[k].aabbMaxRight.z, m.nodes[k].aabbMaxRight.w);
        }
        if(!w.writeCount(m.materials.size()))
            return false;
        for(usize k = 0u; k < m.materials.size(); ++k)
            SnapWriteSurfaceMaterial(w, m.materials[k]);
        if(!SnapshotWriteU16Vec(w, m.triangleMaterialIndices) || !SnapshotWriteU32Vec(w, m.triangleUserData))
            return false;
    }
    if(
        !SnapshotWriteU32Vec(w, world.m_meshRefCounts)
        || !SnapshotWriteU16Vec(w, world.m_meshGenerations)
        || !SnapshotWriteU8Vec(w, world.m_meshOwnedByUser)
        || !SnapshotWriteU32Vec(w, world.m_freeMeshShapeIds)
    )
        return false;

    if(!w.writeCount(world.m_heightfieldShapes.size()))
        return false;
    for(usize i = 0u; i < world.m_heightfieldShapes.size(); ++i){
        in HeightfieldShape hf = world.m_heightfieldShapes[i];
        w.writeU32(hf.rows);
        w.writeU32(hf.cols);
        SnapWriteVec4(w, VectorSingle(hf.scaleMinMaxY));
        SnapWriteVec4(w, VectorSingle(hf.originMaxY));
        w.writeF32(hf.thickness);
        if(!w.writeCount(hf.heights.size()))
            return false;
        w.writeF32Span(Span<f32>(hf.heights));
        if(!SnapshotWriteU16Vec(w, hf.cellMaterialIndices))
            return false;
        if(!SnapshotWriteU8Vec(w, hf.cellHoles))
            return false;
        w.writeB8(hf.flipDiagonal);
        if(!w.writeCount(hf.materials.size()))
            return false;
        for(usize k = 0u; k < hf.materials.size(); ++k)
            SnapWriteSurfaceMaterial(w, hf.materials[k]);
    }
    if(
        !SnapshotWriteU32Vec(w, world.m_heightfieldRefCounts)
        || !SnapshotWriteU16Vec(w, world.m_heightfieldGenerations)
        || !SnapshotWriteU8Vec(w, world.m_heightfieldOwnedByUser)
        || !SnapshotWriteU32Vec(w, world.m_freeHeightfieldShapeIds)
    )
        return false;

    if(!w.writeCount(world.m_contacts.size()))
        return false;
    for(usize i = 0u; i < world.m_contacts.size(); ++i){
        in Contact c = world.m_contacts[i];
        w.writeU64(c.pairKey);
        w.writeU32(c.edges[0u].bodyId); w.writeU32(c.edges[0u].prevKey); w.writeU32(c.edges[0u].nextKey);
        w.writeU32(c.edges[1u].bodyId); w.writeU32(c.edges[1u].prevKey); w.writeU32(c.edges[1u].nextKey);
        SnapWriteVec4(w, VectorSingle(c.surfaceVelocity));
        SnapWriteVec4(w, VectorSingle(c.anisotropicFriction));
        SnapWriteVec4(w, VectorSingle(c.frictionDirection));
        w.writeU32(c.contactId);
        w.writeU32(c.shapeIdA);
        w.writeU32(c.shapeIdB);
        w.writeU32(c.colorIndex);
        w.writeU32(c.localIndex);
        w.writeU32(c.islandId);
        w.writeU32(c.islandIndex);
        w.writeF32(c.friction);
        w.writeF32(c.staticFriction);
        w.writeF32(c.restitution);
        w.writeF32(c.rollingResistance);
        w.writeF32(c.tangentSpeed);
        w.writeF32(c.invMassScaleA);
        w.writeF32(c.invMassScaleB);
        w.writeF32(c.invInertiaScaleA);
        w.writeF32(c.invInertiaScaleB);
        w.writeF32(c.maxNormalImpulse);
        w.writeU32(c.flags);
        SnapWriteManifold(c.manifold, w);
    }
    if(!SnapshotWriteU32Vec(w, world.m_freeContactIds))
        return false;

    if(!w.writeCount(world.m_joints.size()))
        return false;
    for(usize i = 0u; i < world.m_joints.size(); ++i){
        in Joint j = world.m_joints[i];
        SnapWriteVec4(w, VectorSingle(j.localAnchorALength));
        SnapWriteVec4(w, VectorSingle(j.localAnchorBMinLength));
        SnapWriteVec4(w, VectorSingle(j.localAxisAMaxLength));
        SnapWriteVec4(w, VectorSingle(j.localAxisBLowerLimit));
        SnapWriteVec4(w, VectorSingle(j.referenceRotation));
        SnapWriteVec4(w, VectorSingle(j.linearOffsetUpperLimit));
        SnapWriteVec4(w, VectorSingle(j.linearImpulseLimit));
        SnapWriteVec4(w, VectorSingle(j.angularImpulseMotor));
        SnapWriteVec4(w, VectorSingle(j.lastForceConeSusp));
        SnapWriteVec4(w, VectorSingle(j.lastTorqueMotorSpeed));
        w.writeU64(j.userData);
        w.writeU32(j.edges[0u].bodyId); w.writeU32(j.edges[0u].prevKey); w.writeU32(j.edges[0u].nextKey);
        w.writeU32(j.edges[1u].bodyId); w.writeU32(j.edges[1u].prevKey); w.writeU32(j.edges[1u].nextKey);
        w.writeU32(j.jointId);
        w.writeU32(j.islandId);
        w.writeU32(j.islandIndex);
        w.writeU32(j.extraDataIndex);
        w.writeF32(j.maxMotorForce);
        w.writeF32(j.hertz);
        w.writeF32(j.dampingRatio);
        w.writeF32(j.correctionFactor);
        w.writeF32(j.maxTorque);
        w.writeF32(j.swingLimit);
        w.writeF32(j.swingLimitY);
        w.writeF32(j.springTarget);
        w.writeF32(j.suspensionHertz);
        w.writeF32(j.suspensionDampingRatio);
        w.writeF32(j.steeringAngle);
        w.writeF32(j.suspensionRestLength);
        w.writeF32(j.invMassScaleA);
        w.writeF32(j.invMassScaleB);
        w.writeF32(j.invInertiaScaleA);
        w.writeF32(j.invInertiaScaleB);
        w.writeF32(j.limitRestitution);
        w.writeF32(j.limitHertz);
        w.writeF32(j.limitDampingRatio);
        w.writeF32(j.projectionLinearTolerance);
        w.writeF32(j.projectionAngularTolerance);
        w.writeF32(j.ratio);
        w.writeF32(j.breakForce);
        w.writeF32(j.breakTorque);
        w.writeF32(j.continuousAngle);
        w.writeF32(j.accumulatedPhaseError);
        w.writeB8(j.hasContinuousAngle);
        w.writeU16(j.generation);
        w.writeU8(cast<u8>(j.type));
        w.writeU8(j.flags);
    }
    if(!SnapshotWriteU32Vec(w, world.m_freeJointIds))
        return false;

    if(!w.writeCount(world.m_jointExtraData.size()))
        return false;
    for(usize i = 0u; i < world.m_jointExtraData.size(); ++i){
        in JointExtraData e = world.m_jointExtraData[i];
        for(usize k = 0u; k < 6u; ++k){
            in SixDofAxisConfig cfg = e.sixDofAxes[k];
            w.writeU8(cast<u8>(cfg.motion));
            w.writeF32(cfg.lowerLimit);
            w.writeF32(cfg.upperLimit);
            w.writeF32(cfg.motorTargetVelocity);
            w.writeF32(cfg.motorTargetPosition);
            w.writeF32(cfg.maxMotorForce);
            w.writeF32(cfg.springHertz);
            w.writeF32(cfg.springDampingRatio);
            w.writeB8(cfg.enableMotor);
            w.writeB8(cfg.enableSpring);
            w.writeF32(e.sixDofLowerImpulses[k]);
            w.writeF32(e.sixDofUpperImpulses[k]);
            w.writeF32(e.sixDofMotorImpulses[k]);
            w.writeF32(e.sixDofSpringImpulses[k]);
        }
        SnapWriteVec4(w, VectorSingle(e.groundAnchorA));
        SnapWriteVec4(w, VectorSingle(e.groundAnchorB));
        w.writeF32(e.pulleyConstant);
        if(!w.writeCount(e.pathPoints.size()))
            return false;
        for(usize k = 0u; k < e.pathPoints.size(); ++k)
            SnapWriteVec4(w, VectorSingle(e.pathPoints[k]));
        w.writeB8(e.pathClosed);
        w.writeB8(e.pathLockRotation);
        w.writeB8(e.alive);
        SnapWriteVec4(w, VectorSingle(e.targetOrientation));
        SnapWriteVec4(w, VectorSingle(e.slerpImpulse));
        w.writeF32(e.slerpHertz);
        w.writeF32(e.slerpDampingRatio);
        w.writeF32(e.slerpMaxTorque);
        w.writeF32(e.sixDofSwingLimitY);
        w.writeF32(e.sixDofSwingLimitZ);
        w.writeF32(e.sixDofSwingImpulse);
        w.writeU8(cast<u8>(e.sixDofSwingLimitMode));
        w.writeB8(e.enableSlerpDrive);
    }
    if(!SnapshotWriteU32Vec(w, world.m_freeJointExtraData))
        return false;

    if(!w.writeCount(world.m_solverSets.size()))
        return false;
    for(usize i = 0u; i < world.m_solverSets.size(); ++i){
        in SolverSet ss = world.m_solverSets[i];
        w.writeU32(ss.setIndex);
        w.writeU64(ss.membershipVersion);
        if(!w.writeCount(ss.sims.size()))
            return false;
        for(usize k = 0u; k < ss.sims.size(); ++k){
            in BodySim sim = ss.sims[k];
            SnapWriteTransform3D(w, sim.transform);
            SnapWriteVec4(w, VectorSingle(sim.centerInvMass));
            SnapWriteVec4(w, VectorSingle(sim.localCenterMinExtent));
            SnapWriteVec4(w, VectorSingle(sim.rotation0));
            SnapWriteVec4(w, VectorSingle(sim.center0MaxExtent));
            SnapWriteVec4(w, VectorSingle(sim.forceLinearDamping));
            SnapWriteVec4(w, VectorSingle(sim.torqueAngularDamping));
            SnapWriteSymMat3(w, sim.invInertiaLocal);
            SnapWriteSymMat3(w, sim.invInertiaWorld);
            w.writeF32(sim.gravityScale);
            w.writeU32(sim.flags);
            w.writeU32(sim.bodyId);
            w.writeF32(sim.maxAngularVelocity);
        }
        if(!w.writeCount(ss.states.size()))
            return false;
        for(usize k = 0u; k < ss.states.size(); ++k){
            in BodyState st = ss.states[k];
            SnapWriteVec4(w, VectorSingle(st.linearVelocity));
            SnapWriteVec4(w, VectorSingle(st.angularVelocity));
            SnapWriteVec3U32F(w, st.deltaPositionFlags.x, st.deltaPositionFlags.y, st.deltaPositionFlags.z, st.deltaPositionFlags.w);
            SnapWriteVec4(w, VectorSingle(st.deltaRotation));
        }
        if(!SnapshotWriteU32Vec(w, ss.islands))
            return false;
    }
    if(!SnapshotWriteU32Vec(w, world.m_freeSolverSetIds))
        return false;

    if(!w.writeCount(world.m_islands.size()))
        return false;
    for(usize i = 0u; i < world.m_islands.size(); ++i){
        in Island isl = world.m_islands[i];
        w.writeU32(isl.setIndex);
        w.writeU32(isl.localIndex);
        w.writeU32(isl.islandId);
        w.writeU32(isl.constraintRemoveCount);
        w.writeB8(isl.alive);
        if(!SnapshotWriteU32Vec(w, isl.bodies))
            return false;
        if(!w.writeCount(isl.contacts.size()))
            return false;
        for(usize k = 0u; k < isl.contacts.size(); ++k){
            w.writeU32(isl.contacts[k].contactId);
            w.writeU32(isl.contacts[k].bodyIdA);
            w.writeU32(isl.contacts[k].bodyIdB);
        }
        if(!w.writeCount(isl.joints.size()))
            return false;
        for(usize k = 0u; k < isl.joints.size(); ++k){
            w.writeU32(isl.joints[k].jointId);
            w.writeU32(isl.joints[k].bodyIdA);
            w.writeU32(isl.joints[k].bodyIdB);
        }
    }
    if(!SnapshotWriteU32Vec(w, world.m_freeIslandIds))
        return false;

    for(usize c = 0u; c < s_GraphColorCount; ++c){
        if(!SnapshotWriteU32Vec(w, world.m_graph.colors[c].contactIds))
            return false;
    }
    if(!SnapshotWriteU32Vec(w, world.m_graph.bodyColorMasks))
        return false;

    for(usize t = 0u; t < s_TreeCount; ++t){
        in DynamicTree tree = world.m_broadPhase.trees[t];
        in Vector<TreeNode> nodes = tree.nodes();
        w.writeU32(tree.root());
        w.writeU32(tree.freeList());
        w.writeU32(tree.nodeCount());
        if(!w.writeCount(nodes.size()))
            return false;
        for(usize k = 0u; k < nodes.size(); ++k){
            in TreeNode n = nodes[k];
            SnapWriteVec3U32F(w, n.aabbMinUser.x, n.aabbMinUser.y, n.aabbMinUser.z, n.aabbMinUser.w);
            SnapWriteVec3U32F(w, n.aabbMaxCategory.x, n.aabbMaxCategory.y, n.aabbMaxCategory.z, n.aabbMaxCategory.w);
            w.writeU32(n.parentOrNext);
            w.writeU32(n.child1);
            w.writeU32(n.child2);
            w.writeI16(n.height);
            w.writeB8(n.moved);
            w.writeU8(n.nodeFlags);
        }
        if(!SnapshotWriteU32Vec(w, tree.moveIndices()))
            return false;
    }
    if(!SnapshotWriteU32Vec(w, world.m_broadPhase.moveArray))
        return false;

    if(!w.writeCount(world.m_pendingContactEndEvents.size()))
        return false;
    for(usize i = 0u; i < world.m_pendingContactEndEvents.size(); ++i){
        SnapWriteShapeId(w, world.m_pendingContactEndEvents[i].shapeIdA);
        SnapWriteShapeId(w, world.m_pendingContactEndEvents[i].shapeIdB);
    }
    if(!w.writeCount(world.m_pendingSensorEndEvents.size()))
        return false;
    for(usize i = 0u; i < world.m_pendingSensorEndEvents.size(); ++i){
        SnapWriteShapeId(w, world.m_pendingSensorEndEvents[i].sensorShapeId);
        SnapWriteShapeId(w, world.m_pendingSensorEndEvents[i].visitorShapeId);
    }
    if(!w.writeCount(world.m_pendingBodyWakeEvents.size()))
        return false;
    for(usize i = 0u; i < world.m_pendingBodyWakeEvents.size(); ++i){
        SnapWriteBodyId(w, world.m_pendingBodyWakeEvents[i].bodyId);
        w.writeU64(world.m_pendingBodyWakeEvents[i].userData);
        w.writeB8(world.m_pendingBodyWakeEvents[i].awake);
    }

    Vector<u64> ignKeys;
    ignKeys.reserve(world.m_ignoredBodyPairs.size());
    for(in u64 key : world.m_ignoredBodyPairs)
        ignKeys.push_back(key);
    if(ignKeys.size() > 1u){
        SortSequence<u64>(ignKeys, lambda[](in u64 lhs, in u64 rhs) -> b8{
            return lhs < rhs;
        });
    }
    if(!w.writeCount(ignKeys.size()))
        return false;
    for(usize i = 0u; i < ignKeys.size(); ++i)
        w.writeU64(ignKeys[i]);

    Vector<u32> secKeys;
    secKeys.reserve(world.m_secondaryContactManifolds.size());
    for(in auto entry : world.m_secondaryContactManifolds)
        secKeys.push_back(entry.first);
    if(secKeys.size() > 1u){
        SortSequence<u32>(secKeys, lambda[](in u32 lhs, in u32 rhs) -> b8{
            return lhs < rhs;
        });
    }
    if(!w.writeCount(secKeys.size()))
        return false;
    for(usize i = 0u; i < secKeys.size(); ++i){
        const u32 cId = secKeys[i];
        w.writeU32(cId);
        const auto itSec = world.m_secondaryContactManifolds.find(cId);
        SnapWriteManifold(itSec.value(), w);
    }
    return true;
}

class SnapshotDirectByteWriter : ISnapshotSink{
    private mut Vector<u8> m_outBytes;
    public u64 m_hash = s_Fnv64OffsetBasis;

    public SnapshotDirectByteWriter(mut Vector<u8> outBytes){
        this.m_outBytes = outBytes;
    }

    public void writeU8(in u8 v)override{
        this.m_hash ^= cast<u64>(v);
        this.m_hash *= s_Fnv64Prime;
        this.m_outBytes.push_back(v);
    }

    public void writeB8(in b8 v)override{
        if(v)
            this.writeU8(1u);
        else
            this.writeU8(0u);
    }

    public void writeU16(in u16 v)override{
        const u8 b0 = cast<u8>(v & 0xffu);
        const u8 b1 = cast<u8>((v >> 8u) & 0xffu);
        u64 h = this.m_hash;
        h ^= cast<u64>(b0); h *= s_Fnv64Prime;
        h ^= cast<u64>(b1); h *= s_Fnv64Prime;
        this.m_hash = h;
        const usize pos = this.m_outBytes.size();
        this.m_outBytes.resize(pos + 2u);
        this.m_outBytes[pos] = b0;
        this.m_outBytes[pos + 1u] = b1;
    }

    public void writeI16(in i16 v)override{
        this.writeU16(bit_cast<u16>(v));
    }

    public void writeU32(in u32 v)override{
        const u8 b0 = cast<u8>(v & 0xffu);
        const u8 b1 = cast<u8>((v >> 8u) & 0xffu);
        const u8 b2 = cast<u8>((v >> 16u) & 0xffu);
        const u8 b3 = cast<u8>((v >> 24u) & 0xffu);
        u64 h = this.m_hash;
        h ^= cast<u64>(b0); h *= s_Fnv64Prime;
        h ^= cast<u64>(b1); h *= s_Fnv64Prime;
        h ^= cast<u64>(b2); h *= s_Fnv64Prime;
        h ^= cast<u64>(b3); h *= s_Fnv64Prime;
        this.m_hash = h;
        const usize pos = this.m_outBytes.size();
        this.m_outBytes.resize(pos + 4u);
        this.m_outBytes[pos] = b0;
        this.m_outBytes[pos + 1u] = b1;
        this.m_outBytes[pos + 2u] = b2;
        this.m_outBytes[pos + 3u] = b3;
    }

    public void writeI32(in i32 v)override{
        this.writeU32(bit_cast<u32>(v));
    }

    public void writeU64(in u64 v)override{
        const u32 lo = cast<u32>(v & 0xffffffffu);
        const u32 hi = cast<u32>((v >> 32u) & 0xffffffffu);
        const u8 b0 = cast<u8>(lo & 0xffu);
        const u8 b1 = cast<u8>((lo >> 8u) & 0xffu);
        const u8 b2 = cast<u8>((lo >> 16u) & 0xffu);
        const u8 b3 = cast<u8>((lo >> 24u) & 0xffu);
        const u8 b4 = cast<u8>(hi & 0xffu);
        const u8 b5 = cast<u8>((hi >> 8u) & 0xffu);
        const u8 b6 = cast<u8>((hi >> 16u) & 0xffu);
        const u8 b7 = cast<u8>((hi >> 24u) & 0xffu);
        u64 h = this.m_hash;
        h ^= cast<u64>(b0); h *= s_Fnv64Prime;
        h ^= cast<u64>(b1); h *= s_Fnv64Prime;
        h ^= cast<u64>(b2); h *= s_Fnv64Prime;
        h ^= cast<u64>(b3); h *= s_Fnv64Prime;
        h ^= cast<u64>(b4); h *= s_Fnv64Prime;
        h ^= cast<u64>(b5); h *= s_Fnv64Prime;
        h ^= cast<u64>(b6); h *= s_Fnv64Prime;
        h ^= cast<u64>(b7); h *= s_Fnv64Prime;
        this.m_hash = h;
        const usize pos = this.m_outBytes.size();
        this.m_outBytes.resize(pos + 8u);
        this.m_outBytes[pos] = b0;
        this.m_outBytes[pos + 1u] = b1;
        this.m_outBytes[pos + 2u] = b2;
        this.m_outBytes[pos + 3u] = b3;
        this.m_outBytes[pos + 4u] = b4;
        this.m_outBytes[pos + 5u] = b5;
        this.m_outBytes[pos + 6u] = b6;
        this.m_outBytes[pos + 7u] = b7;
    }

    public void writeF32(in f32 v)override{
        this.writeU32(bit_cast<u32>(v));
    }

    public b8 writeCount(in usize n)override{
        if(n > s_SnapshotMaxElements)
            return false;
        this.writeU32(cast<u32>(n));
        return true;
    }

    public void writeBytes(in Span<u8> data)override{
        const usize n = data.size();
        if(n == 0u)
            return;
        const usize pos = this.m_outBytes.size();
        this.m_outBytes.resize(pos + n);
        u64 h = this.m_hash;
        for(usize i = 0u; i < n; ++i){
            const u8 b = data[i];
            h ^= cast<u64>(b);
            h *= s_Fnv64Prime;
            this.m_outBytes[pos + i] = b;
        }
        this.m_hash = h;
    }

    public void writeU16Span(in Span<u16> data)override{
        const usize n = data.size();
        if(n == 0u)
            return;
        const usize pos = this.m_outBytes.size();
        this.m_outBytes.resize(pos + n * 2u);
        u64 h = this.m_hash;
        usize dst = pos;
        for(usize i = 0u; i < n; ++i){
            const u16 v = data[i];
            const u8 b0 = cast<u8>(v & 0xffu);
            const u8 b1 = cast<u8>((v >> 8u) & 0xffu);
            h ^= cast<u64>(b0); h *= s_Fnv64Prime;
            h ^= cast<u64>(b1); h *= s_Fnv64Prime;
            this.m_outBytes[dst] = b0;
            this.m_outBytes[dst + 1u] = b1;
            dst += 2u;
        }
        this.m_hash = h;
    }

    public void writeU32Span(in Span<u32> data)override{
        const usize n = data.size();
        if(n == 0u)
            return;
        const usize pos = this.m_outBytes.size();
        this.m_outBytes.resize(pos + n * 4u);
        u64 h = this.m_hash;
        usize dst = pos;
        for(usize i = 0u; i < n; ++i){
            const u32 v = data[i];
            const u8 b0 = cast<u8>(v & 0xffu);
            const u8 b1 = cast<u8>((v >> 8u) & 0xffu);
            const u8 b2 = cast<u8>((v >> 16u) & 0xffu);
            const u8 b3 = cast<u8>((v >> 24u) & 0xffu);
            h ^= cast<u64>(b0); h *= s_Fnv64Prime;
            h ^= cast<u64>(b1); h *= s_Fnv64Prime;
            h ^= cast<u64>(b2); h *= s_Fnv64Prime;
            h ^= cast<u64>(b3); h *= s_Fnv64Prime;
            this.m_outBytes[dst] = b0;
            this.m_outBytes[dst + 1u] = b1;
            this.m_outBytes[dst + 2u] = b2;
            this.m_outBytes[dst + 3u] = b3;
            dst += 4u;
        }
        this.m_hash = h;
    }

    public void writeF32Span(in Span<f32> data)override{
        const usize n = data.size();
        if(n == 0u)
            return;
        const usize pos = this.m_outBytes.size();
        this.m_outBytes.resize(pos + n * 4u);
        u64 h = this.m_hash;
        usize dst = pos;
        for(usize i = 0u; i < n; ++i){
            const u32 v = bit_cast<u32>(data[i]);
            const u8 b0 = cast<u8>(v & 0xffu);
            const u8 b1 = cast<u8>((v >> 8u) & 0xffu);
            const u8 b2 = cast<u8>((v >> 16u) & 0xffu);
            const u8 b3 = cast<u8>((v >> 24u) & 0xffu);
            h ^= cast<u64>(b0); h *= s_Fnv64Prime;
            h ^= cast<u64>(b1); h *= s_Fnv64Prime;
            h ^= cast<u64>(b2); h *= s_Fnv64Prime;
            h ^= cast<u64>(b3); h *= s_Fnv64Prime;
            this.m_outBytes[dst] = b0;
            this.m_outBytes[dst + 1u] = b1;
            this.m_outBytes[dst + 2u] = b2;
            this.m_outBytes[dst + 3u] = b3;
            dst += 4u;
        }
        this.m_hash = h;
    }
}

b8 SerializePhysicsWorldSnapshot(in PhysicsWorld world, mut Vector<u8> outBytes){
    outBytes.clear();
    outBytes.reserve(EstimatePhysicsWorldSnapshotSize(world));
    SnapshotDirectByteWriter w(outBytes);
    if(!SerializePhysicsWorldSnapshotPayload(world, w))
        return false;
    w.writeU64(w.m_hash);
    return true;
}

b8 ReadPhysicsWorldSnapshotPayload(in Span<u8> bytes, mut SnapshotByteReader r, mut PhysicsWorld tmp){
    u32 magic = 0u;
    u32 version = 0u;
    if(!r.readU32(bytes, magic) || !r.readU32(bytes, version))
        return false;
    if(magic != s_SnapshotMagic || version != s_SnapshotVersion)
        return false;

    tmp.clear();
    tmp.m_solverSets.clear();

    if(
        !r.readVec4F(bytes, tmp.m_def.gravity.x, tmp.m_def.gravity.y, tmp.m_def.gravity.z, tmp.m_def.gravity.w)
        || !r.readF32(bytes, tmp.m_def.restitutionThreshold)
        || !r.readF32(bytes, tmp.m_def.hitEventThreshold)
        || !r.readF32(bytes, tmp.m_def.contactHertz)
        || !r.readF32(bytes, tmp.m_def.contactDampingRatio)
        || !r.readF32(bytes, tmp.m_def.maxLinearVelocity)
        || !r.readF32(bytes, tmp.m_def.timeToSleep)
        || !r.readB8(bytes, tmp.m_def.enableSleep)
        || !r.readB8(bytes, tmp.m_def.enableContinuous)
        || !r.readB8(bytes, tmp.m_def.enableContactSoftening)
        || !r.readB8(bytes, tmp.m_def.enableGpuCollision)
        || !r.readB8(bytes, tmp.m_def.forceGpuCollision)
        || !r.readB8(bytes, tmp.m_def.gpuResidentMode)
        || !r.readB8(bytes, tmp.m_def.useGpuLbvhBroadphase)
    )
        return false;

    u8 backendByte = 0u;
    if(
        !r.readU16(bytes, tmp.m_worldIndex)
        || !r.readU8(bytes, backendByte)
        || !r.readU32(bytes, tmp.m_gpuDispatchThreshold)
        || !r.readF32(bytes, tmp.m_gpuWorkloadFraction)
        || !r.readB8(bytes, tmp.m_enableWarmStarting)
        || !r.readB8(bytes, tmp.m_hasDirtyBodyMass)
        || !r.readB8(bytes, tmp.m_cpuBroadphaseDirty)
        || !r.readU32(bytes, tmp.m_sensorEventShapeCount)
        || !r.readU32(bytes, tmp.m_hitEventShapeCount)
        || !r.readU32(bytes, tmp.m_breakableJointCount)
        || !r.readU32(bytes, tmp.m_bulletBodyCount)
    )
        return false;
    if(backendByte >= cast<u8>(PhysicsBackendMode::kCount))
        return false;
    tmp.m_backendMode = cast<PhysicsBackendMode>(backendByte);

    u32 bodyCount = 0u;
    if(!r.readCount(bytes, 32u, bodyCount))
        return false;
    tmp.m_bodies.resize(bodyCount);
    for(u32 i = 0u; i < bodyCount; ++i){
        mut Body b = tmp.m_bodies[i];
        u8 bType = 0u;
        if(
            !r.readU64(bytes, b.userData)
            || !r.readU32(bytes, b.setIndex)
            || !r.readU32(bytes, b.localIndex)
            || !r.readU32(bytes, b.headContactKey)
            || !r.readU32(bytes, b.contactCount)
            || !r.readU32(bytes, b.headJointKey)
            || !r.readU32(bytes, b.jointCount)
            || !r.readU32(bytes, b.headShapeId)
            || !r.readU32(bytes, b.shapeCount)
            || !r.readU32(bytes, b.islandId)
            || !r.readU32(bytes, b.islandIndex)
            || !r.readF32(bytes, b.sleepThreshold)
            || !r.readF32(bytes, b.sleepTime)
            || !r.readF32(bytes, b.mass)
            || !r.readSymMat3(bytes, b.inertiaLocal)
            || !r.readF32(bytes, b.maxAngularVelocity)
            || !r.readU32(bytes, b.bodyMoveIndex)
            || !r.readU32(bytes, b.id)
            || !r.readU32(bytes, b.flags)
            || !r.readU8(bytes, bType)
            || !r.readU16(bytes, b.generation)
            || !r.readB8(bytes, b.alive)
        )
            return false;
        if(bType >= cast<u8>(BodyType::kCount))
            return false;
        b.type = cast<BodyType>(bType);
        if(tmp.m_hasDirtyBodyMass && b.alive && (b.flags & cast<u32>(BodyFlags::DirtyMass)) != 0u)
            tmp.m_dirtyMassBodyIds.push_back(i);
    }
    if(!SnapshotReadU32Vec(bytes, r, tmp.m_freeBodyIds))
        return false;

    u32 shapeCount = 0u;
    if(!r.readCount(bytes, 64u, shapeCount))
        return false;
    tmp.m_shapes.resize(shapeCount);

    for(u32 i = 0u; i < shapeCount; ++i){
        mut Shape s = tmp.m_shapes[i];
        u8 sType = 0u;
        if(
            !r.readVec4F(bytes, s.geom0.x, s.geom0.y, s.geom0.z, s.geom0.w)
            || !r.readVec4F(bytes, s.geom1.x, s.geom1.y, s.geom1.z, s.geom1.w)
            || !r.readAabb3D(bytes, s.aabb)
            || !r.readTransform3D(bytes, s.localTransform)
            || !r.readU64(bytes, s.userData)
            || !r.readSurfaceMaterial(bytes, s.material)
            || !r.readFilter(bytes, s.filter)
            || !r.readU32(bytes, s.bodyId)
            || !r.readU32(bytes, s.id)
            || !r.readU32(bytes, s.nextShapeId)
            || !r.readU32(bytes, s.proxyKey)
            || !r.readU32(bytes, s.geometryIndex)
            || !r.readF32(bytes, s.density)
            || !r.readU16(bytes, s.generation)
            || !r.readU8(bytes, sType)
            || !r.readU8(bytes, s.flags)
        )
            return false;
        if(sType >= cast<u8>(ShapeType::kCount))
            return false;
        s.type = cast<ShapeType>(sType);
    }
    if(!SnapshotReadU32Vec(bytes, r, tmp.m_freeShapeIds))
        return false;

    u32 hullCount = 0u;
    if(!r.readCount(bytes, 32u, hullCount))
        return false;
    tmp.m_hullShapes.resize(hullCount);
    for(u32 i = 0u; i < hullCount; ++i){
        mut HullShape h = tmp.m_hullShapes[i];
        if(
            !r.readVec4F(bytes, h.centroidRadius.x, h.centroidRadius.y, h.centroidRadius.z, h.centroidRadius.w)
            || !r.readVec3U32F(bytes, h.halfExtentsFlags.x, h.halfExtentsFlags.y, h.halfExtentsFlags.z, h.halfExtentsFlags.w)
            || !r.readVec4F(bytes, h.boxRotation.x, h.boxRotation.y, h.boxRotation.z, h.boxRotation.w)
        )
            return false;
        u32 vc = 0u;
        if(!r.readCount(bytes, 12u, vc))
            return false;
        h.vertices.resize(vc);
        for(u32 k = 0u; k < vc; ++k){
            if(!r.readVec3F(bytes, h.vertices[k].x, h.vertices[k].y, h.vertices[k].z))
                return false;
        }
        u32 fpc = 0u;
        if(!r.readCount(bytes, 16u, fpc))
            return false;
        h.facePlanes.resize(fpc);
        for(u32 k = 0u; k < fpc; ++k){
            if(!r.readVec4F(bytes, h.facePlanes[k].normalOffset.x, h.facePlanes[k].normalOffset.y, h.facePlanes[k].normalOffset.z, h.facePlanes[k].normalOffset.w))
                return false;
        }
        u32 ftc = 0u;
        if(!r.readCount(bytes, 2u, ftc))
            return false;
        h.faceTopologies.resize(ftc);
        for(u32 k = 0u; k < ftc; ++k){
            if(!r.readU8(bytes, h.faceTopologies[k].edge) || !r.readU8(bytes, h.faceTopologies[k].vertexCount))
                return false;
        }
        u32 hec = 0u;
        if(!r.readCount(bytes, 4u, hec))
            return false;
        h.halfEdges.resize(hec);
        for(u32 k = 0u; k < hec; ++k){
            if(
                !r.readU8(bytes, h.halfEdges[k].tail)
                || !r.readU8(bytes, h.halfEdges[k].face)
                || !r.readU8(bytes, h.halfEdges[k].next)
                || !r.readU8(bytes, h.halfEdges[k].twin)
            )
                return false;
        }
        h.cachedBuoyancyVolume = ComputeHullBuoyancyVolume(h);
    }
    u32 hullAabbCount = 0u;
    if(!r.readCount(bytes, 32u, hullAabbCount))
        return false;
    tmp.m_hullLocalAabbs.resize(hullAabbCount);
    for(u32 i = 0u; i < hullAabbCount; ++i){
        if(!r.readAabb3D(bytes, tmp.m_hullLocalAabbs[i]))
            return false;
    }
    if(
        !SnapshotReadU32Vec(bytes, r, tmp.m_hullRefCounts)
        || !SnapshotReadU16Vec(bytes, r, tmp.m_hullGenerations)
        || !SnapshotReadU8Vec(bytes, r, tmp.m_hullOwnedByUser)
        || !SnapshotReadU32Vec(bytes, r, tmp.m_freeHullShapeIds)
    )
        return false;

    u32 meshCount = 0u;
    if(!r.readCount(bytes, 32u, meshCount))
        return false;
    tmp.m_meshShapes.resize(meshCount);
    for(u32 i = 0u; i < meshCount; ++i){
        mut MeshShape m = tmp.m_meshShapes[i];
        if(!r.readVec4F(bytes, m.localAabbMinRadius.x, m.localAabbMinRadius.y, m.localAabbMinRadius.z, m.localAabbMinRadius.w) || !r.readVec3U32F(bytes, m.localAabbMaxMeta.x, m.localAabbMaxMeta.y, m.localAabbMaxMeta.z, m.localAabbMaxMeta.w))
            return false;
        u32 tc = 0u;
        if(!r.readCount(bytes, 48u, tc))
            return false;
        m.triangles.resize(tc);
        for(u32 k = 0u; k < tc; ++k){
            if(
                !r.readVec3F(bytes, m.triangles[k].v0.x, m.triangles[k].v0.y, m.triangles[k].v0.z)
                || !r.readVec3F(bytes, m.triangles[k].v1.x, m.triangles[k].v1.y, m.triangles[k].v1.z)
                || !r.readVec3F(bytes, m.triangles[k].v2.x, m.triangles[k].v2.y, m.triangles[k].v2.z)
                || !r.readVec3F(bytes, m.triangles[k].normal.x, m.triangles[k].normal.y, m.triangles[k].normal.z)
            )
                return false;
        }
        u32 nc = 0u;
        if(!r.readCount(bytes, 32u, nc))
            return false;
        m.nodes.resize(nc);
        for(u32 k = 0u; k < nc; ++k){
            if(
                !r.readVec3U32F(bytes, m.nodes[k].aabbMinLeft.x, m.nodes[k].aabbMinLeft.y, m.nodes[k].aabbMinLeft.z, m.nodes[k].aabbMinLeft.w)
                || !r.readVec3U32F(bytes, m.nodes[k].aabbMaxRight.x, m.nodes[k].aabbMaxRight.y, m.nodes[k].aabbMaxRight.z, m.nodes[k].aabbMaxRight.w)
            )
                return false;
        }
        u32 mc = 0u;
        if(!r.readCount(bytes, 16u, mc))
            return false;
        m.materials.resize(mc);
        for(u32 k = 0u; k < mc; ++k){
            if(!r.readSurfaceMaterial(bytes, m.materials[k]))
                return false;
        }
        if(!SnapshotReadU16Vec(bytes, r, m.triangleMaterialIndices) || !SnapshotReadU32Vec(bytes, r, m.triangleUserData))
            return false;
        m.cachedBuoyancyVolume = ComputeMeshBuoyancyVolume(m);
    }
    if(
        !SnapshotReadU32Vec(bytes, r, tmp.m_meshRefCounts)
        || !SnapshotReadU16Vec(bytes, r, tmp.m_meshGenerations)
        || !SnapshotReadU8Vec(bytes, r, tmp.m_meshOwnedByUser)
        || !SnapshotReadU32Vec(bytes, r, tmp.m_freeMeshShapeIds)
    )
        return false;

    u32 hfCount = 0u;
    if(!r.readCount(bytes, 32u, hfCount))
        return false;
    tmp.m_heightfieldShapes.resize(hfCount);
    for(u32 i = 0u; i < hfCount; ++i){
        mut HeightfieldShape hf = tmp.m_heightfieldShapes[i];
        if(
            !r.readU32(bytes, hf.rows)
            || !r.readU32(bytes, hf.cols)
            || !r.readVec4F(bytes, hf.scaleMinMaxY.x, hf.scaleMinMaxY.y, hf.scaleMinMaxY.z, hf.scaleMinMaxY.w)
            || !r.readVec4F(bytes, hf.originMaxY.x, hf.originMaxY.y, hf.originMaxY.z, hf.originMaxY.w)
            || !r.readF32(bytes, hf.thickness)
        )
            return false;
        u32 hc = 0u;
        if(!r.readCount(bytes, 4u, hc))
            return false;
        hf.heights.resize(hc);
        for(u32 k = 0u; k < hc; ++k){
            if(!r.readF32(bytes, hf.heights[k]))
                return false;
        }
        if(!SnapshotReadU16Vec(bytes, r, hf.cellMaterialIndices))
            return false;
        if(!SnapshotReadU8Vec(bytes, r, hf.cellHoles))
            return false;
        if(!r.readB8(bytes, hf.flipDiagonal))
            return false;
        u32 mc = 0u;
        if(!r.readCount(bytes, 16u, mc))
            return false;
        hf.materials.resize(mc);
        for(u32 k = 0u; k < mc; ++k){
            if(!r.readSurfaceMaterial(bytes, hf.materials[k]))
                return false;
        }
        hf.buildHierarchy();
    }
    if(
        !SnapshotReadU32Vec(bytes, r, tmp.m_heightfieldRefCounts)
        || !SnapshotReadU16Vec(bytes, r, tmp.m_heightfieldGenerations)
        || !SnapshotReadU8Vec(bytes, r, tmp.m_heightfieldOwnedByUser)
        || !SnapshotReadU32Vec(bytes, r, tmp.m_freeHeightfieldShapeIds)
    )
        return false;

    u32 contactCount = 0u;
    if(!r.readCount(bytes, 64u, contactCount))
        return false;
    tmp.m_contacts.resize(contactCount);
    for(u32 i = 0u; i < contactCount; ++i){
        mut Contact c = tmp.m_contacts[i];
        if(
            !r.readU64(bytes, c.pairKey)
            || !r.readU32(bytes, c.edges[0u].bodyId) || !r.readU32(bytes, c.edges[0u].prevKey) || !r.readU32(bytes, c.edges[0u].nextKey)
            || !r.readU32(bytes, c.edges[1u].bodyId) || !r.readU32(bytes, c.edges[1u].prevKey) || !r.readU32(bytes, c.edges[1u].nextKey)
            || !r.readVec4F(bytes, c.surfaceVelocity.x, c.surfaceVelocity.y, c.surfaceVelocity.z, c.surfaceVelocity.w)
            || !r.readVec4F(bytes, c.anisotropicFriction.x, c.anisotropicFriction.y, c.anisotropicFriction.z, c.anisotropicFriction.w)
            || !r.readVec4F(bytes, c.frictionDirection.x, c.frictionDirection.y, c.frictionDirection.z, c.frictionDirection.w)
            || !r.readU32(bytes, c.contactId)
            || !r.readU32(bytes, c.shapeIdA)
            || !r.readU32(bytes, c.shapeIdB)
            || !r.readU32(bytes, c.colorIndex)
            || !r.readU32(bytes, c.localIndex)
            || !r.readU32(bytes, c.islandId)
            || !r.readU32(bytes, c.islandIndex)
            || !r.readF32(bytes, c.friction)
            || !r.readF32(bytes, c.staticFriction)
            || !r.readF32(bytes, c.restitution)
            || !r.readF32(bytes, c.rollingResistance)
            || !r.readF32(bytes, c.tangentSpeed)
            || !r.readF32(bytes, c.invMassScaleA)
            || !r.readF32(bytes, c.invMassScaleB)
            || !r.readF32(bytes, c.invInertiaScaleA)
            || !r.readF32(bytes, c.invInertiaScaleB)
            || !r.readF32(bytes, c.maxNormalImpulse)
            || !r.readU32(bytes, c.flags)
        )
            return false;
        if(!SnapReadManifold(bytes, r, c.manifold))
            return false;
    }
    if(!SnapshotReadU32Vec(bytes, r, tmp.m_freeContactIds))
        return false;

    u32 jointCount = 0u;
    if(!r.readCount(bytes, 64u, jointCount))
        return false;
    tmp.m_joints.resize(jointCount);
    for(u32 i = 0u; i < jointCount; ++i){
        mut Joint j = tmp.m_joints[i];
        u8 jType = 0u;
        if(
            !r.readVec4F(bytes, j.localAnchorALength.x, j.localAnchorALength.y, j.localAnchorALength.z, j.localAnchorALength.w)
            || !r.readVec4F(bytes, j.localAnchorBMinLength.x, j.localAnchorBMinLength.y, j.localAnchorBMinLength.z, j.localAnchorBMinLength.w)
            || !r.readVec4F(bytes, j.localAxisAMaxLength.x, j.localAxisAMaxLength.y, j.localAxisAMaxLength.z, j.localAxisAMaxLength.w)
            || !r.readVec4F(bytes, j.localAxisBLowerLimit.x, j.localAxisBLowerLimit.y, j.localAxisBLowerLimit.z, j.localAxisBLowerLimit.w)
            || !r.readVec4F(bytes, j.referenceRotation.x, j.referenceRotation.y, j.referenceRotation.z, j.referenceRotation.w)
            || !r.readVec4F(bytes, j.linearOffsetUpperLimit.x, j.linearOffsetUpperLimit.y, j.linearOffsetUpperLimit.z, j.linearOffsetUpperLimit.w)
            || !r.readVec4F(bytes, j.linearImpulseLimit.x, j.linearImpulseLimit.y, j.linearImpulseLimit.z, j.linearImpulseLimit.w)
            || !r.readVec4F(bytes, j.angularImpulseMotor.x, j.angularImpulseMotor.y, j.angularImpulseMotor.z, j.angularImpulseMotor.w)
            || !r.readVec4F(bytes, j.lastForceConeSusp.x, j.lastForceConeSusp.y, j.lastForceConeSusp.z, j.lastForceConeSusp.w)
            || !r.readVec4F(bytes, j.lastTorqueMotorSpeed.x, j.lastTorqueMotorSpeed.y, j.lastTorqueMotorSpeed.z, j.lastTorqueMotorSpeed.w)
            || !r.readU64(bytes, j.userData)
            || !r.readU32(bytes, j.edges[0u].bodyId) || !r.readU32(bytes, j.edges[0u].prevKey) || !r.readU32(bytes, j.edges[0u].nextKey)
            || !r.readU32(bytes, j.edges[1u].bodyId) || !r.readU32(bytes, j.edges[1u].prevKey) || !r.readU32(bytes, j.edges[1u].nextKey)
            || !r.readU32(bytes, j.jointId)
            || !r.readU32(bytes, j.islandId)
            || !r.readU32(bytes, j.islandIndex)
            || !r.readU32(bytes, j.extraDataIndex)
            || !r.readF32(bytes, j.maxMotorForce)
            || !r.readF32(bytes, j.hertz)
            || !r.readF32(bytes, j.dampingRatio)
            || !r.readF32(bytes, j.correctionFactor)
            || !r.readF32(bytes, j.maxTorque)
            || !r.readF32(bytes, j.swingLimit)
            || !r.readF32(bytes, j.swingLimitY)
            || !r.readF32(bytes, j.springTarget)
            || !r.readF32(bytes, j.suspensionHertz)
            || !r.readF32(bytes, j.suspensionDampingRatio)
            || !r.readF32(bytes, j.steeringAngle)
            || !r.readF32(bytes, j.suspensionRestLength)
            || !r.readF32(bytes, j.invMassScaleA)
            || !r.readF32(bytes, j.invMassScaleB)
            || !r.readF32(bytes, j.invInertiaScaleA)
            || !r.readF32(bytes, j.invInertiaScaleB)
            || !r.readF32(bytes, j.limitRestitution)
            || !r.readF32(bytes, j.limitHertz)
            || !r.readF32(bytes, j.limitDampingRatio)
            || !r.readF32(bytes, j.projectionLinearTolerance)
            || !r.readF32(bytes, j.projectionAngularTolerance)
            || !r.readF32(bytes, j.ratio)
            || !r.readF32(bytes, j.breakForce)
            || !r.readF32(bytes, j.breakTorque)
            || !r.readF32(bytes, j.continuousAngle)
            || !r.readF32(bytes, j.accumulatedPhaseError)
            || !r.readB8(bytes, j.hasContinuousAngle)
            || !r.readU16(bytes, j.generation)
            || !r.readU8(bytes, jType)
            || !r.readU8(bytes, j.flags)
        )
            return false;
        if(jType >= cast<u8>(JointType::kCount))
            return false;
        j.type = cast<JointType>(jType);
    }
    if(!SnapshotReadU32Vec(bytes, r, tmp.m_freeJointIds))
        return false;

    u32 extraCount = 0u;
    if(!r.readCount(bytes, 32u, extraCount))
        return false;
    tmp.m_jointExtraData.resize(extraCount);
    for(u32 i = 0u; i < extraCount; ++i){
        mut JointExtraData e = tmp.m_jointExtraData[i];
        for(usize k = 0u; k < 6u; ++k){
            mut SixDofAxisConfig cfg = e.sixDofAxes[k];
            u8 mot = 0u;
            if(
                !r.readU8(bytes, mot)
                || !r.readF32(bytes, cfg.lowerLimit)
                || !r.readF32(bytes, cfg.upperLimit)
                || !r.readF32(bytes, cfg.motorTargetVelocity)
                || !r.readF32(bytes, cfg.motorTargetPosition)
                || !r.readF32(bytes, cfg.maxMotorForce)
                || !r.readF32(bytes, cfg.springHertz)
                || !r.readF32(bytes, cfg.springDampingRatio)
                || !r.readB8(bytes, cfg.enableMotor)
                || !r.readB8(bytes, cfg.enableSpring)
                || !r.readF32(bytes, e.sixDofLowerImpulses[k])
                || !r.readF32(bytes, e.sixDofUpperImpulses[k])
                || !r.readF32(bytes, e.sixDofMotorImpulses[k])
                || !r.readF32(bytes, e.sixDofSpringImpulses[k])
            )
                return false;
            if(mot >= cast<u8>(JointMotion::kCount))
                return false;
            cfg.motion = cast<JointMotion>(mot);
        }
        if(
            !r.readVec4F(bytes, e.groundAnchorA.x, e.groundAnchorA.y, e.groundAnchorA.z, e.groundAnchorA.w)
            || !r.readVec4F(bytes, e.groundAnchorB.x, e.groundAnchorB.y, e.groundAnchorB.z, e.groundAnchorB.w)
            || !r.readF32(bytes, e.pulleyConstant)
        )
            return false;
        u32 pc = 0u;
        if(!r.readCount(bytes, 16u, pc))
            return false;
        e.pathPoints.resize(pc);
        for(u32 k = 0u; k < pc; ++k){
            if(!r.readVec4F(bytes, e.pathPoints[k].x, e.pathPoints[k].y, e.pathPoints[k].z, e.pathPoints[k].w))
                return false;
        }
        if(!r.readB8(bytes, e.pathClosed) || !r.readB8(bytes, e.pathLockRotation) || !r.readB8(bytes, e.alive))
            return false;
        u8 swingModeByte = 0u;
        if(
            !r.readVec4F(bytes, e.targetOrientation.x, e.targetOrientation.y, e.targetOrientation.z, e.targetOrientation.w)
            || !r.readVec4F(bytes, e.slerpImpulse.x, e.slerpImpulse.y, e.slerpImpulse.z, e.slerpImpulse.w)
            || !r.readF32(bytes, e.slerpHertz)
            || !r.readF32(bytes, e.slerpDampingRatio)
            || !r.readF32(bytes, e.slerpMaxTorque)
            || !r.readF32(bytes, e.sixDofSwingLimitY)
            || !r.readF32(bytes, e.sixDofSwingLimitZ)
            || !r.readF32(bytes, e.sixDofSwingImpulse)
            || !r.readU8(bytes, swingModeByte)
            || !r.readB8(bytes, e.enableSlerpDrive)
        )
            return false;
        if(swingModeByte >= cast<u8>(SixDofSwingLimitMode::kCount))
            return false;
        e.sixDofSwingLimitMode = cast<SixDofSwingLimitMode>(swingModeByte);
        e.rebuildPathCache();
    }
    if(!SnapshotReadU32Vec(bytes, r, tmp.m_freeJointExtraData))
        return false;

    u32 setCount = 0u;
    if(!r.readCount(bytes, 12u, setCount) || setCount < 3u)
        return false;
    tmp.m_solverSets.resize(setCount);
    for(u32 i = 0u; i < setCount; ++i){
        mut SolverSet ss = tmp.m_solverSets[i];
        if(!r.readU32(bytes, ss.setIndex) || !r.readU64(bytes, ss.membershipVersion))
            return false;
        u32 simC = 0u;
        if(!r.readCount(bytes, 64u, simC))
            return false;
        ss.sims.resize(simC);
        for(u32 k = 0u; k < simC; ++k){
            mut BodySim sim = ss.sims[k];
            if(
                !r.readTransform3D(bytes, sim.transform)
                || !r.readVec4F(bytes, sim.centerInvMass.x, sim.centerInvMass.y, sim.centerInvMass.z, sim.centerInvMass.w)
                || !r.readVec4F(bytes, sim.localCenterMinExtent.x, sim.localCenterMinExtent.y, sim.localCenterMinExtent.z, sim.localCenterMinExtent.w)
                || !r.readVec4F(bytes, sim.rotation0.x, sim.rotation0.y, sim.rotation0.z, sim.rotation0.w)
                || !r.readVec4F(bytes, sim.center0MaxExtent.x, sim.center0MaxExtent.y, sim.center0MaxExtent.z, sim.center0MaxExtent.w)
                || !r.readVec4F(bytes, sim.forceLinearDamping.x, sim.forceLinearDamping.y, sim.forceLinearDamping.z, sim.forceLinearDamping.w)
                || !r.readVec4F(bytes, sim.torqueAngularDamping.x, sim.torqueAngularDamping.y, sim.torqueAngularDamping.z, sim.torqueAngularDamping.w)
                || !r.readSymMat3(bytes, sim.invInertiaLocal)
                || !r.readSymMat3(bytes, sim.invInertiaWorld)
                || !r.readF32(bytes, sim.gravityScale)
                || !r.readU32(bytes, sim.flags)
                || !r.readU32(bytes, sim.bodyId)
                || !r.readF32(bytes, sim.maxAngularVelocity)
            )
                return false;
        }
        u32 stC = 0u;
        if(!r.readCount(bytes, 48u, stC))
            return false;
        ss.states.resize(stC);
        for(u32 k = 0u; k < stC; ++k){
            mut BodyState st = ss.states[k];
            if(
                !r.readVec4F(bytes, st.linearVelocity.x, st.linearVelocity.y, st.linearVelocity.z, st.linearVelocity.w)
                || !r.readVec4F(bytes, st.angularVelocity.x, st.angularVelocity.y, st.angularVelocity.z, st.angularVelocity.w)
                || !r.readVec3U32F(bytes, st.deltaPositionFlags.x, st.deltaPositionFlags.y, st.deltaPositionFlags.z, st.deltaPositionFlags.w)
                || !r.readVec4F(bytes, st.deltaRotation.x, st.deltaRotation.y, st.deltaRotation.z, st.deltaRotation.w)
            )
                return false;
        }
        if(!SnapshotReadU32Vec(bytes, r, ss.islands))
            return false;
    }
    if(!SnapshotReadU32Vec(bytes, r, tmp.m_freeSolverSetIds))
        return false;

    u32 islandCount = 0u;
    if(!r.readCount(bytes, 16u, islandCount))
        return false;
    tmp.m_islands.resize(islandCount);
    for(u32 i = 0u; i < islandCount; ++i){
        mut Island isl = tmp.m_islands[i];
        if(
            !r.readU32(bytes, isl.setIndex)
            || !r.readU32(bytes, isl.localIndex)
            || !r.readU32(bytes, isl.islandId)
            || !r.readU32(bytes, isl.constraintRemoveCount)
            || !r.readB8(bytes, isl.alive)
            || !SnapshotReadU32Vec(bytes, r, isl.bodies)
        )
            return false;
        u32 cc = 0u;
        if(!r.readCount(bytes, 12u, cc))
            return false;
        isl.contacts.resize(cc);
        for(u32 k = 0u; k < cc; ++k){
            if(!r.readU32(bytes, isl.contacts[k].contactId) || !r.readU32(bytes, isl.contacts[k].bodyIdA) || !r.readU32(bytes, isl.contacts[k].bodyIdB))
                return false;
        }
        u32 jc = 0u;
        if(!r.readCount(bytes, 12u, jc))
            return false;
        isl.joints.resize(jc);
        for(u32 k = 0u; k < jc; ++k){
            if(!r.readU32(bytes, isl.joints[k].jointId) || !r.readU32(bytes, isl.joints[k].bodyIdA) || !r.readU32(bytes, isl.joints[k].bodyIdB))
                return false;
        }
    }
    if(!SnapshotReadU32Vec(bytes, r, tmp.m_freeIslandIds))
        return false;

    for(usize c = 0u; c < s_GraphColorCount; ++c){
        if(!SnapshotReadU32Vec(bytes, r, tmp.m_graph.colors[c].contactIds))
            return false;
    }
    if(!SnapshotReadU32Vec(bytes, r, tmp.m_graph.bodyColorMasks))
        return false;

    for(usize t = 0u; t < s_TreeCount; ++t){
        u32 tRoot = s_NullIndex;
        u32 tFreeList = s_NullIndex;
        u32 tNodeCount = 0u;
        if(!r.readU32(bytes, tRoot) || !r.readU32(bytes, tFreeList) || !r.readU32(bytes, tNodeCount))
            return false;
        u32 nCount = 0u;
        if(!r.readCount(bytes, 44u, nCount))
            return false;
        if(tRoot != s_NullIndex && tRoot >= nCount)
            return false;
        if(tFreeList != s_NullIndex && tFreeList >= nCount)
            return false;
        mut DynamicTree dstTree = tmp.m_broadPhase.trees[t];
        dstTree.beginRestore(cast<usize>(nCount), cast<usize>(nCount), tRoot, tFreeList, tNodeCount);
        for(u32 k = 0u; k < nCount; ++k){
            TreeNode n;
            if(
                !r.readVec3U32F(bytes, n.aabbMinUser.x, n.aabbMinUser.y, n.aabbMinUser.z, n.aabbMinUser.w)
                || !r.readVec3U32F(bytes, n.aabbMaxCategory.x, n.aabbMaxCategory.y, n.aabbMaxCategory.z, n.aabbMaxCategory.w)
                || !r.readU32(bytes, n.parentOrNext)
                || !r.readU32(bytes, n.child1)
                || !r.readU32(bytes, n.child2)
                || !r.readI16(bytes, n.height)
                || !r.readB8(bytes, n.moved)
                || !r.readU8(bytes, n.nodeFlags)
            )
                return false;
            dstTree.setRestoredNode(cast<usize>(k), n);
        }
        u32 mvCount = 0u;
        if(!r.readCount(bytes, 4u, mvCount) || mvCount != nCount)
            return false;
        for(u32 k = 0u; k < mvCount; ++k){
            u32 mv = s_NullIndex;
            if(!r.readU32(bytes, mv))
                return false;
            dstTree.setRestoredMoveIndex(cast<usize>(k), mv);
        }
    }
    if(!SnapshotReadU32Vec(bytes, r, tmp.m_broadPhase.moveArray))
        return false;

    u32 pendContactEndCount = 0u;
    if(!r.readCount(bytes, 16u, pendContactEndCount))
        return false;
    tmp.m_pendingContactEndEvents.resize(pendContactEndCount);
    for(u32 i = 0u; i < pendContactEndCount; ++i){
        mut ContactEndTouchEvent ev = tmp.m_pendingContactEndEvents[i];
        if(!r.readShapeId(bytes, ev.shapeIdA) || !r.readShapeId(bytes, ev.shapeIdB))
            return false;
    }

    u32 pendSensorEndCount = 0u;
    if(!r.readCount(bytes, 16u, pendSensorEndCount))
        return false;
    tmp.m_pendingSensorEndEvents.resize(pendSensorEndCount);
    for(u32 i = 0u; i < pendSensorEndCount; ++i){
        mut SensorEndTouchEvent ev = tmp.m_pendingSensorEndEvents[i];
        if(!r.readShapeId(bytes, ev.sensorShapeId) || !r.readShapeId(bytes, ev.visitorShapeId))
            return false;
    }

    u32 pendWakeCount = 0u;
    if(!r.readCount(bytes, 17u, pendWakeCount))
        return false;
    tmp.m_pendingBodyWakeEvents.resize(pendWakeCount);
    for(u32 i = 0u; i < pendWakeCount; ++i){
        mut BodyWakeEvent ev = tmp.m_pendingBodyWakeEvents[i];
        if(!r.readBodyId(bytes, ev.bodyId) || !r.readU64(bytes, ev.userData) || !r.readB8(bytes, ev.awake))
            return false;
    }

    u32 ignCount = 0u;
    if(!r.readCount(bytes, 8u, ignCount))
        return false;
    tmp.m_ignoredBodyPairs.clear();
    if(ignCount > 0u)
        tmp.m_ignoredBodyPairs.reserve(ignCount);
    for(u32 i = 0u; i < ignCount; ++i){
        u64 ignKey = 0u;
        if(!r.readU64(bytes, ignKey))
            return false;
        tmp.m_ignoredBodyPairs.emplace(ignKey);
    }

    u32 secCount = 0u;
    if(!r.readCount(bytes, 64u, secCount))
        return false;
    tmp.m_secondaryContactManifolds.clear();
    if(secCount > 0u)
        tmp.m_secondaryContactManifolds.reserve(secCount);
    for(u32 i = 0u; i < secCount; ++i){
        u32 cId = 0u;
        Manifold secM;
        if(!r.readU32(bytes, cId) || cId >= contactCount || !SnapReadManifold(bytes, r, secM))
            return false;
        tmp.m_secondaryContactManifolds.insert_or_assign(cId, secM);
    }
    return true;
}

void CommitRestoredPhysicsWorld(mut PhysicsWorld tmp, mut PhysicsWorld world){
    world.m_def = tmp.m_def;
    world.m_worldIndex = tmp.m_worldIndex;
    world.m_backendMode = tmp.m_backendMode;
    world.m_gpuDispatchThreshold = tmp.m_gpuDispatchThreshold;
    world.m_gpuWorkloadFraction = tmp.m_gpuWorkloadFraction;
    world.m_enableWarmStarting = tmp.m_enableWarmStarting;
    world.m_hasDirtyBodyMass = tmp.m_hasDirtyBodyMass;
    world.m_cpuBroadphaseDirty = tmp.m_cpuBroadphaseDirty;
    world.m_sensorEventShapeCount = tmp.m_sensorEventShapeCount;
    world.m_hitEventShapeCount = tmp.m_hitEventShapeCount;
    world.m_breakableJointCount = tmp.m_breakableJointCount;
    world.m_bulletBodyCount = tmp.m_bulletBodyCount;

    world.m_bodies.swap(tmp.m_bodies);
    world.m_freeBodyIds.swap(tmp.m_freeBodyIds);
    world.m_shapes.swap(tmp.m_shapes);
    world.m_freeShapeIds.swap(tmp.m_freeShapeIds);
    world.m_hullShapes.swap(tmp.m_hullShapes);
    world.m_hullLocalAabbs.swap(tmp.m_hullLocalAabbs);
    world.m_hullRefCounts.swap(tmp.m_hullRefCounts);
    world.m_hullGenerations.swap(tmp.m_hullGenerations);
    world.m_hullOwnedByUser.swap(tmp.m_hullOwnedByUser);
    world.m_freeHullShapeIds.swap(tmp.m_freeHullShapeIds);
    world.m_meshShapes.swap(tmp.m_meshShapes);
    world.m_meshRefCounts.swap(tmp.m_meshRefCounts);
    world.m_meshGenerations.swap(tmp.m_meshGenerations);
    world.m_meshOwnedByUser.swap(tmp.m_meshOwnedByUser);
    world.m_freeMeshShapeIds.swap(tmp.m_freeMeshShapeIds);
    world.m_heightfieldShapes.swap(tmp.m_heightfieldShapes);
    world.m_heightfieldRefCounts.swap(tmp.m_heightfieldRefCounts);
    world.m_heightfieldGenerations.swap(tmp.m_heightfieldGenerations);
    world.m_heightfieldOwnedByUser.swap(tmp.m_heightfieldOwnedByUser);
    world.m_freeHeightfieldShapeIds.swap(tmp.m_freeHeightfieldShapeIds);
    world.m_contacts.swap(tmp.m_contacts);
    world.m_freeContactIds.swap(tmp.m_freeContactIds);
    world.m_joints.swap(tmp.m_joints);
    world.m_freeJointIds.swap(tmp.m_freeJointIds);
    world.m_jointExtraData.swap(tmp.m_jointExtraData);
    world.m_freeJointExtraData.swap(tmp.m_freeJointExtraData);
    world.m_solverSets.swap(tmp.m_solverSets);
    world.m_freeSolverSetIds.swap(tmp.m_freeSolverSetIds);
    world.m_islands.swap(tmp.m_islands);
    world.m_freeIslandIds.swap(tmp.m_freeIslandIds);
    world.m_dirtyMassBodyIds.swap(tmp.m_dirtyMassBodyIds);
    for(usize c = 0u; c < s_GraphColorCount; ++c)
        world.m_graph.colors[c].contactIds.swap(tmp.m_graph.colors[c].contactIds);
    world.m_graph.bodyColorMasks.swap(tmp.m_graph.bodyColorMasks);
    for(usize t = 0u; t < s_TreeCount; ++t)
        world.m_broadPhase.trees[t].swapState(tmp.m_broadPhase.trees[t]);
    world.m_broadPhase.moveArray.swap(tmp.m_broadPhase.moveArray);
    world.m_broadPhase.workerBuckets.clear();
    world.m_broadPhase.workerQueryStacks.clear();

    world.m_pairContactMap.clear();
    world.m_pairContactMap.reserve(world.m_contacts.size());
    for(usize i = 0u; i < world.m_contacts.size(); ++i){
        in Contact c = world.m_contacts[i];
        if((c.flags & cast<u32>(ContactFlags::Alive)) != 0u)
            world.m_pairContactMap.emplace(c.pairKey, c.contactId);
    }

    world.m_ignoredBodyPairs.clear();
    if(!tmp.m_ignoredBodyPairs.empty()){
        world.m_ignoredBodyPairs.reserve(tmp.m_ignoredBodyPairs.size());
        for(in u64 key : tmp.m_ignoredBodyPairs)
            world.m_ignoredBodyPairs.emplace(key);
    }
    ++world.m_nonCollideJointVersion;

    world.m_secondaryContactManifolds.clear();
    if(!tmp.m_secondaryContactManifolds.empty()){
        world.m_secondaryContactManifolds.reserve(tmp.m_secondaryContactManifolds.size());
        for(in auto entry : tmp.m_secondaryContactManifolds)
            world.m_secondaryContactManifolds.emplace(entry.first, entry.second);
    }

    world.m_bodyMoveEvents.clear();
    world.m_contactBeginEvents.clear();
    world.m_contactEndEvents.clear();
    world.m_contactPersistEvents.clear();
    world.m_contactHitEvents.clear();
    world.m_sensorBeginEvents.clear();
    world.m_sensorEndEvents.clear();
    world.m_sensorStayEvents.clear();
    world.m_bodyWakeEvents.clear();
    world.m_jointBreakEvents.clear();
    world.m_pendingContactEndEvents.swap(tmp.m_pendingContactEndEvents);
    world.m_pendingSensorEndEvents.swap(tmp.m_pendingSensorEndEvents);
    world.m_pendingBodyWakeEvents.swap(tmp.m_pendingBodyWakeEvents);
    world.m_lastStats = WorldStepStats();
    world.m_cpuScratch.clear();

    if(cast<usize>(s_AwakeSetIndex) < world.m_solverSets.size()){
        mut Vector<u32> dirtyList = world.m_solverSets[s_AwakeSetIndex].dirtySplitIslands;
        dirtyList.clear();
        for(usize i = 0u; i < world.m_islands.size(); ++i){
            in Island isl = world.m_islands[i];
            if(isl.alive && isl.setIndex == s_AwakeSetIndex && isl.constraintRemoveCount > 0u)
                dirtyList.push_back(isl.islandId);
        }
    }

    world.m_worldGeneration = AllocateWrappingIdentity<PhysicsWorld>();
    world.markAllSetsTopologyDirty();
    ++world.m_poseMutationVersion;
    ++world.m_stepPoseVersion;
    ++world.m_nonCollideJointVersion;
    world.m_inStep = false;
}

b8 VerifySnapshotChecksumAndInitReader(
    in Span<u8> bytes,
    in usize minBytes,
    mut SnapshotByteReader outReader,
    mut usize outPayloadEnd
){
    if(bytes.size() < minBytes)
        return false;
    outPayloadEnd = bytes.size() - 8u;
    const u64 computedHash = SnapshotFnv1a64(Span<u8>(bytes.data(), outPayloadEnd));
    SnapshotByteReader hashReader;
    hashReader.cursor = outPayloadEnd;
    hashReader.limit = bytes.size();
    u64 storedHash = 0u;
    if(!hashReader.readU64(bytes, storedHash) || storedHash != computedHash)
        return false;
    outReader.cursor = 0u;
    outReader.limit = outPayloadEnd;
    return true;
}

b8 RestorePhysicsWorldSnapshot(in Span<u8> bytes, mut PhysicsWorld world){
    if(world.m_inStep)
        return false;
    SnapshotByteReader r;
    usize payloadEnd = 0u;
    if(!VerifySnapshotChecksumAndInitReader(bytes, 24u, r, payloadEnd))
        return false;
    PhysicsWorld tmp;
    if(!ReadPhysicsWorldSnapshotPayload(bytes, r, tmp))
        return false;
    if(r.cursor != payloadEnd)
        return false;
    CommitRestoredPhysicsWorld(tmp, world);
    return true;
}

u64 ComputePhysicsWorldStateHash(in PhysicsWorld world){
    SnapshotFnv1a64Sink hashSink;
    if(!SerializePhysicsWorldSnapshotPayload(world, hashSink))
        return 0u;
    return hashSink.hash;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class PhysicsSubsystemsBundle{
    public PhysicsEnvironment environment;
    public Vector<SoftBody> softBodies;
    public Vector<VehicleController> vehicles;
    public Vector<RagdollInstance> ragdolls;
    public Vector<CharacterController> characters;
    public Vector<Articulation> articulations;

    public void clear(){
        this.environment.fluids.clear();
        this.environment.forceFields.clear();
        this.environment.elapsedTimeSec = 0.0f;
        this.softBodies.clear();
        this.vehicles.clear();
        this.ragdolls.clear();
        this.characters.clear();
        this.articulations.clear();
    }
}

b8 SnapWritePhysicsEnvironment<TSink : ISnapshotSink>(in PhysicsEnvironment env, mut TSink w){
    if(!w.writeCount(env.fluids.size()))
        return false;
    for(usize i = 0u; i < env.fluids.size(); ++i){
        in FluidVolume fv = env.fluids[i];
        w.writeU8(cast<u8>(fv.shape));
        SnapWriteVec4(w, VectorSingle(fv.surfaceNormalOffset));
        SnapWriteAabb3D(w, fv.bounds);
        SnapWriteVec4(w, VectorSingle(fv.flowVelocity));
        w.writeF32(fv.density);
        w.writeF32(fv.linearDrag);
        w.writeF32(fv.angularDrag);
        w.writeF32(fv.quadraticDrag);
        w.writeF32(fv.liftCoeff);
        w.writeF32(fv.waveAmplitude);
        w.writeF32(fv.waveFrequency);
        w.writeF32(fv.waveSpeed);
        SnapWriteFilter(w, fv.filter);
        w.writeB8(fv.enabled);
    }
    if(!w.writeCount(env.forceFields.size()))
        return false;
    for(usize i = 0u; i < env.forceFields.size(); ++i){
        in ForceField ff = env.forceFields[i];
        w.writeU8(cast<u8>(ff.type));
        SnapWriteAabb3D(w, ff.bounds);
        w.writeB8(ff.useBounds);
        SnapWriteVec4(w, VectorSingle(ff.originOrDirection));
        SnapWriteVec4(w, VectorSingle(ff.axis));
        w.writeF32(ff.strength);
        w.writeF32(ff.minDistance);
        w.writeF32(ff.radius);
        w.writeF32(ff.falloffPower);
        w.writeF32(ff.inwardSuction);
        w.writeF32(ff.turbulenceAmplitude);
        w.writeF32(ff.turbulenceFrequency);
        SnapWriteFilter(w, ff.filter);
        w.writeB8(ff.enabled);
    }
    w.writeF32(env.elapsedTimeSec);
    return true;
}

b8 SnapReadPhysicsEnvironment(in Span<u8> bytes, mut SnapshotByteReader r, mut PhysicsEnvironment outEnv){
    u32 fluidCount = 0u;
    if(!r.readCount(bytes, 32u, fluidCount))
        return false;
    outEnv.fluids.resize(fluidCount);
    for(u32 i = 0u; i < fluidCount; ++i){
        mut FluidVolume fv = outEnv.fluids[i];
        u8 shapeByte = 0u;
        if(
            !r.readU8(bytes, shapeByte)
            || !r.readVec4F(bytes, fv.surfaceNormalOffset.x, fv.surfaceNormalOffset.y, fv.surfaceNormalOffset.z, fv.surfaceNormalOffset.w)
            || !r.readAabb3D(bytes, fv.bounds)
            || !r.readVec4F(bytes, fv.flowVelocity.x, fv.flowVelocity.y, fv.flowVelocity.z, fv.flowVelocity.w)
            || !r.readF32(bytes, fv.density)
            || !r.readF32(bytes, fv.linearDrag)
            || !r.readF32(bytes, fv.angularDrag)
            || !r.readF32(bytes, fv.quadraticDrag)
            || !r.readF32(bytes, fv.liftCoeff)
            || !r.readF32(bytes, fv.waveAmplitude)
            || !r.readF32(bytes, fv.waveFrequency)
            || !r.readF32(bytes, fv.waveSpeed)
            || !r.readFilter(bytes, fv.filter)
            || !r.readB8(bytes, fv.enabled)
        )
            return false;
        if(shapeByte > cast<u8>(FluidVolumeShape::Sphere))
            return false;
        fv.shape = cast<FluidVolumeShape>(shapeByte);
    }

    u32 fieldCount = 0u;
    if(!r.readCount(bytes, 32u, fieldCount))
        return false;
    outEnv.forceFields.resize(fieldCount);
    for(u32 i = 0u; i < fieldCount; ++i){
        mut ForceField ff = outEnv.forceFields[i];
        u8 typeByte = 0u;
        if(
            !r.readU8(bytes, typeByte)
            || !r.readAabb3D(bytes, ff.bounds)
            || !r.readB8(bytes, ff.useBounds)
            || !r.readVec4F(bytes, ff.originOrDirection.x, ff.originOrDirection.y, ff.originOrDirection.z, ff.originOrDirection.w)
            || !r.readVec4F(bytes, ff.axis.x, ff.axis.y, ff.axis.z, ff.axis.w)
            || !r.readF32(bytes, ff.strength)
            || !r.readF32(bytes, ff.minDistance)
            || !r.readF32(bytes, ff.radius)
            || !r.readF32(bytes, ff.falloffPower)
            || !r.readF32(bytes, ff.inwardSuction)
            || !r.readF32(bytes, ff.turbulenceAmplitude)
            || !r.readF32(bytes, ff.turbulenceFrequency)
            || !r.readFilter(bytes, ff.filter)
            || !r.readB8(bytes, ff.enabled)
        )
            return false;
        if(typeByte > cast<u8>(ForceFieldType::LocalGravityOverride))
            return false;
        ff.type = cast<ForceFieldType>(typeByte);
    }

    if(!r.readF32(bytes, outEnv.elapsedTimeSec))
        return false;
    outEnv.resetTracking();
    return true;
}

b8 SnapWriteSoftBody<TSink : ISnapshotSink>(in SoftBody sb, mut TSink w){
    if(!w.writeCount(sb.particles.size()))
        return false;
    for(usize i = 0u; i < sb.particles.size(); ++i){
        in SoftBodyParticle pt = sb.particles[i];
        SnapWriteVec4(w, VectorSingle(pt.position));
        SnapWriteVec4(w, VectorSingle(pt.prevPosition));
        SnapWriteVec4(w, VectorSingle(pt.velocity));
        SnapWriteVec4(w, VectorSingle(pt.externalForce));
        w.writeF32(pt.invMass);
        w.writeB8(pt.isFixed);
    }
    if(!w.writeCount(sb.distanceConstraints.size()))
        return false;
    for(usize i = 0u; i < sb.distanceConstraints.size(); ++i){
        in SoftBodyDistanceConstraint c = sb.distanceConstraints[i];
        w.writeU32(c.p0);
        w.writeU32(c.p1);
        w.writeF32(c.restLength);
        w.writeF32(c.compliance);
        w.writeF32(c.lambda);
    }
    if(!w.writeCount(sb.bendingConstraints.size()))
        return false;
    for(usize i = 0u; i < sb.bendingConstraints.size(); ++i){
        in SoftBodyBendingConstraint c = sb.bendingConstraints[i];
        w.writeU32(c.p0);
        w.writeU32(c.p1);
        w.writeF32(c.restLength);
        w.writeF32(c.compliance);
        w.writeF32(c.lambda);
    }
    if(!w.writeCount(sb.dihedralBendingConstraints.size()))
        return false;
    for(usize i = 0u; i < sb.dihedralBendingConstraints.size(); ++i){
        in SoftBodyDihedralBendingConstraint c = sb.dihedralBendingConstraints[i];
        w.writeU32(c.p0);
        w.writeU32(c.p1);
        w.writeU32(c.p2);
        w.writeU32(c.p3);
        w.writeF32(c.restAngle);
        w.writeF32(c.compliance);
        w.writeF32(c.lambda);
    }
    if(!w.writeCount(sb.volumeConstraints.size()))
        return false;
    for(usize i = 0u; i < sb.volumeConstraints.size(); ++i){
        in SoftBodyVolumeConstraint c = sb.volumeConstraints[i];
        w.writeU32(c.p0);
        w.writeU32(c.p1);
        w.writeU32(c.p2);
        w.writeU32(c.p3);
        w.writeF32(c.restVolume);
        w.writeF32(c.compliance);
        w.writeF32(c.lambda);
        w.writeF32(c.youngsModulus);
        w.writeF32(c.poissonsRatio);
        w.writeF32(c.plasticYield);
        w.writeF32(c.plasticCreep);
        w.writeF32(c.plasticMaxStrain);
        w.writeF32(c.devLambda);
        SnapWriteVec4(w, VectorSingle(c.restCol0));
        SnapWriteVec4(w, VectorSingle(c.restCol1));
        SnapWriteVec4(w, VectorSingle(c.restCol2));
    }
    if(!w.writeCount(sb.surfaceTriangles.size()))
        return false;
    for(usize i = 0u; i < sb.surfaceTriangles.size(); ++i){
        in SoftBodyTriangle t = sb.surfaceTriangles[i];
        w.writeU32(t.p0);
        w.writeU32(t.p1);
        w.writeU32(t.p2);
    }
    if(!w.writeCount(sb.attachments.size()))
        return false;
    for(usize i = 0u; i < sb.attachments.size(); ++i){
        in SoftBodyAttachment a = sb.attachments[i];
        w.writeU32(a.particleIndex);
        SnapWriteBodyId(w, a.bodyId);
        SnapWriteVec4(w, VectorSingle(a.localAnchor));
        w.writeF32(a.compliance);
    }
    if(!w.writeCount(sb.backstopConstraints.size()))
        return false;
    for(usize i = 0u; i < sb.backstopConstraints.size(); ++i){
        in SoftBodyBackstopConstraint c = sb.backstopConstraints[i];
        w.writeU32(c.particleIndex);
        SnapWriteVec4(w, VectorSingle(c.center));
        SnapWriteVec4(w, VectorSingle(c.normal));
        w.writeF32(c.maxDistance);
        w.writeF32(c.backstopRadius);
    }
    if(!w.writeCount(sb.goalConstraints.size()))
        return false;
    for(usize i = 0u; i < sb.goalConstraints.size(); ++i){
        in SoftBodyGoalConstraint c = sb.goalConstraints[i];
        w.writeU32(c.particleIndex);
        SnapWriteVec4(w, VectorSingle(c.targetPosition));
        w.writeF32(c.stiffness);
        w.writeF32(c.damping);
    }
    if(!SnapshotWriteVec4Vec(sb.restLocalPositions, w))
        return false;
    if(!SnapshotWriteU32Vec(w, sb.particleSourceIndices))
        return false;
    w.writeU64(sb.topologyVersion);
    w.writeB8(sb.isWorldSpaceBaked());
    SnapWriteVec4(w, VectorSingle(sb.windVelocity));
    w.writeF32(sb.particleRadius);
    w.writeF32(sb.damping);
    w.writeF32(sb.aerodynamicDrag);
    w.writeF32(sb.liftCoeff);
    w.writeF32(sb.friction);
    w.writeF32(sb.restitution);
    w.writeF32(sb.tearStrainThreshold);
    w.writeB8(sb.enableSelfCollision);
    w.writeF32(sb.selfCollisionRadius);
    w.writeF32(sb.selfCollisionStiffness);
    w.writeF32(sb.selfCollisionFriction);
    w.writeB8(sb.enableTriangleEdgeSelfCollision);
    w.writeB8(sb.enableVertexSplitTearing);
    w.writeF32(sb.pressureCoeff);
    w.writeF32(sb.restSurfaceVolume);
    w.writeF32(sb.pressureCompliance);
    w.writeB8(sb.enableShapeMatching);
    w.writeF32(sb.shapeMatchingStiffness);
    w.writeU32(sb.subSteps);
    w.writeU32(sb.solverIterations);
    SnapWriteFilter(w, sb.collisionFilter);
    w.writeB8(sb.collideWithWorld);
    SnapWriteVec4(w, sb.snapshotShapeMatchQuat());
    return true;
}

b8 SnapReadSoftBody(in Span<u8> bytes, mut SnapshotByteReader r, mut SoftBody outSb){
    u32 ptCount = 0u;
    if(!r.readCount(bytes, 32u, ptCount))
        return false;
    outSb.particles.resize(ptCount);
    for(u32 i = 0u; i < ptCount; ++i){
        mut SoftBodyParticle pt = outSb.particles[i];
        if(
            !r.readVec4F(bytes, pt.position.x, pt.position.y, pt.position.z, pt.position.w)
            || !r.readVec4F(bytes, pt.prevPosition.x, pt.prevPosition.y, pt.prevPosition.z, pt.prevPosition.w)
            || !r.readVec4F(bytes, pt.velocity.x, pt.velocity.y, pt.velocity.z, pt.velocity.w)
            || !r.readVec4F(bytes, pt.externalForce.x, pt.externalForce.y, pt.externalForce.z, pt.externalForce.w)
            || !r.readF32(bytes, pt.invMass)
            || !r.readB8(bytes, pt.isFixed)
        )
            return false;
    }

    u32 distCount = 0u;
    if(!r.readCount(bytes, 20u, distCount))
        return false;
    outSb.distanceConstraints.resize(distCount);
    for(u32 i = 0u; i < distCount; ++i){
        mut SoftBodyDistanceConstraint c = outSb.distanceConstraints[i];
        if(!r.readU32(bytes, c.p0) || !r.readU32(bytes, c.p1) || !r.readF32(bytes, c.restLength) || !r.readF32(bytes, c.compliance) || !r.readF32(bytes, c.lambda))
            return false;
    }

    u32 bendCount = 0u;
    if(!r.readCount(bytes, 20u, bendCount))
        return false;
    outSb.bendingConstraints.resize(bendCount);
    for(u32 i = 0u; i < bendCount; ++i){
        mut SoftBodyBendingConstraint c = outSb.bendingConstraints[i];
        if(!r.readU32(bytes, c.p0) || !r.readU32(bytes, c.p1) || !r.readF32(bytes, c.restLength) || !r.readF32(bytes, c.compliance) || !r.readF32(bytes, c.lambda))
            return false;
    }

    u32 dihCount = 0u;
    if(!r.readCount(bytes, 28u, dihCount))
        return false;
    outSb.dihedralBendingConstraints.resize(dihCount);
    for(u32 i = 0u; i < dihCount; ++i){
        mut SoftBodyDihedralBendingConstraint c = outSb.dihedralBendingConstraints[i];
        if(!r.readU32(bytes, c.p0) || !r.readU32(bytes, c.p1) || !r.readU32(bytes, c.p2) || !r.readU32(bytes, c.p3) || !r.readF32(bytes, c.restAngle) || !r.readF32(bytes, c.compliance) || !r.readF32(bytes, c.lambda))
            return false;
    }

    u32 volCount = 0u;
    if(!r.readCount(bytes, 32u, volCount))
        return false;
    outSb.volumeConstraints.resize(volCount);
    for(u32 i = 0u; i < volCount; ++i){
        mut SoftBodyVolumeConstraint c = outSb.volumeConstraints[i];
        if(
            !r.readU32(bytes, c.p0)
            || !r.readU32(bytes, c.p1)
            || !r.readU32(bytes, c.p2)
            || !r.readU32(bytes, c.p3)
            || !r.readF32(bytes, c.restVolume)
            || !r.readF32(bytes, c.compliance)
            || !r.readF32(bytes, c.lambda)
            || !r.readF32(bytes, c.youngsModulus)
            || !r.readF32(bytes, c.poissonsRatio)
            || !r.readF32(bytes, c.plasticYield)
            || !r.readF32(bytes, c.plasticCreep)
            || !r.readF32(bytes, c.plasticMaxStrain)
            || !r.readF32(bytes, c.devLambda)
            || !r.readVec4F(bytes, c.restCol0.x, c.restCol0.y, c.restCol0.z, c.restCol0.w)
            || !r.readVec4F(bytes, c.restCol1.x, c.restCol1.y, c.restCol1.z, c.restCol1.w)
            || !r.readVec4F(bytes, c.restCol2.x, c.restCol2.y, c.restCol2.z, c.restCol2.w)
        )
            return false;
    }

    u32 triCount = 0u;
    if(!r.readCount(bytes, 12u, triCount))
        return false;
    outSb.surfaceTriangles.resize(triCount);
    for(u32 i = 0u; i < triCount; ++i){
        mut SoftBodyTriangle t = outSb.surfaceTriangles[i];
        if(!r.readU32(bytes, t.p0) || !r.readU32(bytes, t.p1) || !r.readU32(bytes, t.p2))
            return false;
    }

    u32 attCount = 0u;
    if(!r.readCount(bytes, 16u, attCount))
        return false;
    outSb.attachments.resize(attCount);
    for(u32 i = 0u; i < attCount; ++i){
        mut SoftBodyAttachment a = outSb.attachments[i];
        if(
            !r.readU32(bytes, a.particleIndex)
            || !r.readBodyId(bytes, a.bodyId)
            || !r.readVec4F(bytes, a.localAnchor.x, a.localAnchor.y, a.localAnchor.z, a.localAnchor.w)
            || !r.readF32(bytes, a.compliance)
        )
            return false;
    }

    u32 bsCount = 0u;
    if(!r.readCount(bytes, 16u, bsCount))
        return false;
    outSb.backstopConstraints.resize(bsCount);
    for(u32 i = 0u; i < bsCount; ++i){
        mut SoftBodyBackstopConstraint c = outSb.backstopConstraints[i];
        if(
            !r.readU32(bytes, c.particleIndex)
            || !r.readVec4F(bytes, c.center.x, c.center.y, c.center.z, c.center.w)
            || !r.readVec4F(bytes, c.normal.x, c.normal.y, c.normal.z, c.normal.w)
            || !r.readF32(bytes, c.maxDistance)
            || !r.readF32(bytes, c.backstopRadius)
        )
            return false;
    }

    u32 goalCount = 0u;
    if(!r.readCount(bytes, 16u, goalCount))
        return false;
    outSb.goalConstraints.resize(goalCount);
    for(u32 i = 0u; i < goalCount; ++i){
        mut SoftBodyGoalConstraint c = outSb.goalConstraints[i];
        if(
            !r.readU32(bytes, c.particleIndex)
            || !r.readVec4F(bytes, c.targetPosition.x, c.targetPosition.y, c.targetPosition.z, c.targetPosition.w)
            || !r.readF32(bytes, c.stiffness)
            || !r.readF32(bytes, c.damping)
        )
            return false;
    }

    if(!SnapshotReadVec4Vec(bytes, r, outSb.restLocalPositions))
        return false;
    if(!SnapshotReadU32Vec(bytes, r, outSb.particleSourceIndices))
        return false;
    b8 worldSpaceBaked = false;
    if(!r.readU64(bytes, outSb.topologyVersion) || !r.readB8(bytes, worldSpaceBaked))
        return false;
    outSb.setWorldSpaceBaked(worldSpaceBaked);

    f32 qx = 0.0f;
    f32 qy = 0.0f;
    f32 qz = 0.0f;
    f32 qw = 1.0f;
    if(
        !r.readVec4F(bytes, outSb.windVelocity.x, outSb.windVelocity.y, outSb.windVelocity.z, outSb.windVelocity.w)
        || !r.readF32(bytes, outSb.particleRadius)
        || !r.readF32(bytes, outSb.damping)
        || !r.readF32(bytes, outSb.aerodynamicDrag)
        || !r.readF32(bytes, outSb.liftCoeff)
        || !r.readF32(bytes, outSb.friction)
        || !r.readF32(bytes, outSb.restitution)
        || !r.readF32(bytes, outSb.tearStrainThreshold)
        || !r.readB8(bytes, outSb.enableSelfCollision)
        || !r.readF32(bytes, outSb.selfCollisionRadius)
        || !r.readF32(bytes, outSb.selfCollisionStiffness)
        || !r.readF32(bytes, outSb.selfCollisionFriction)
        || !r.readB8(bytes, outSb.enableTriangleEdgeSelfCollision)
        || !r.readB8(bytes, outSb.enableVertexSplitTearing)
        || !r.readF32(bytes, outSb.pressureCoeff)
        || !r.readF32(bytes, outSb.restSurfaceVolume)
        || !r.readF32(bytes, outSb.pressureCompliance)
        || !r.readB8(bytes, outSb.enableShapeMatching)
        || !r.readF32(bytes, outSb.shapeMatchingStiffness)
        || !r.readU32(bytes, outSb.subSteps)
        || !r.readU32(bytes, outSb.solverIterations)
        || !r.readFilter(bytes, outSb.collisionFilter)
        || !r.readB8(bytes, outSb.collideWithWorld)
        || !r.readVec4F(bytes, qx, qy, qz, qw)
    )
        return false;

    outSb.finalizeSnapshotRestore(VectorSingle(qx, qy, qz, qw));
    return true;
}

b8 SnapWriteVehicleController<TSink : ISnapshotSink>(in VehicleController veh, mut TSink w){
    SnapWriteBodyId(w, veh.chassisBodyId);

    in VehicleEngineDef eng = veh.engine;
    w.writeF32(eng.maxTorque);
    w.writeF32(eng.idleRpm);
    w.writeF32(eng.maxRpm);
    w.writeF32(eng.shiftUpRpm);
    w.writeF32(eng.shiftDownRpm);
    w.writeF32(eng.finalDriveRatio);
    w.writeF32(eng.reverseRatio);
    for(usize i = 0u; i < 6u; ++i)
        w.writeF32(eng.forwardGearRatios[i]);
    if(!w.writeCount(eng.torqueCurvePoints.size()))
        return false;
    for(usize i = 0u; i < eng.torqueCurvePoints.size(); ++i){
        in f32x2u pt = eng.torqueCurvePoints[i];
        SnapWriteVec2F(w, pt.x, pt.y);
    }
    w.writeU32(eng.gearCount);
    w.writeU8(cast<u8>(eng.centerDifferentialMode));
    w.writeU8(cast<u8>(eng.axleDifferentialMode));
    w.writeF32(eng.differentialBias);
    w.writeF32(eng.centerDiffFrontSplit);
    w.writeF32(eng.differentialLockTorque);
    w.writeF32(eng.clutchStrength);
    w.writeF32(eng.torqueConverterStallRpm);
    w.writeF32(eng.torqueConverterMaxTorqueRatio);
    w.writeF32(eng.engineInertia);
    w.writeF32(eng.dragCoeff);
    w.writeF32(eng.downforceCoeff);
    w.writeF32(eng.trackWidth);
    w.writeF32(eng.wheelbase);
    w.writeF32(eng.espStrength);
    w.writeF32(eng.espMaxBrakeTorque);
    w.writeB8(eng.useAckermanSteering);
    w.writeB8(eng.automaticTransmission);
    w.writeB8(eng.useTorqueConverter);
    w.writeB8(eng.useSolverImpulses);
    w.writeB8(eng.enableAbs);
    w.writeB8(eng.enableTcs);
    w.writeB8(eng.enableEsp);

    if(!w.writeCount(veh.wheelDefs.size()))
        return false;
    for(usize i = 0u; i < veh.wheelDefs.size(); ++i){
        in VehicleWheelDef wd = veh.wheelDefs[i];
        SnapWriteVec4(w, VectorSingle(wd.attachmentPoint));
        SnapWriteVec4(w, VectorSingle(wd.suspensionDirection));
        SnapWriteVec4(w, VectorSingle(wd.axleAxis));
        SnapWriteVec4(w, VectorSingle(wd.forwardAxis));
        w.writeF32(wd.suspensionRestLength);
        w.writeF32(wd.suspensionMaxTravel);
        w.writeF32(wd.suspensionStiffness);
        w.writeF32(wd.suspensionDamping);
        w.writeF32(wd.suspensionReboundDamping);
        w.writeF32(wd.bumpStopStiffness);
        w.writeF32(wd.bumpStopRestitution);
        w.writeF32(wd.wheelRadius);
        w.writeF32(wd.wheelWidth);
        w.writeF32(wd.wheelInertia);
        w.writeF32(wd.maxSteerAngleRad);
        w.writeF32(wd.driveFraction);
        w.writeF32(wd.maxBrakeTorque);
        w.writeF32(wd.maxHandbrakeTorque);
        w.writeF32(wd.frictionMultiplier);
        w.writeF32(wd.loadSensitivity);
        w.writeF32(wd.nominalWheelLoad);
        w.writeF32(wd.rollingResistanceCoeff);
        w.writeF32(wd.longitudinalStiffness);
        w.writeF32(wd.lateralStiffness);
        w.writeF32(wd.pacejkaShapeC);
        w.writeF32(wd.pacejkaCurvatureE);
        w.writeI32(wd.axleIndex);
        w.writeI32(wd.antiRollPairIndex);
        w.writeF32(wd.antiRollStiffness);
        w.writeB8(wd.isSteerable);
        w.writeB8(wd.isDriven);
        w.writeB8(wd.handbrakeAffected);
        w.writeB8(wd.useSweptCast);
    }

    if(!w.writeCount(veh.wheelStates.size()))
        return false;
    for(usize i = 0u; i < veh.wheelStates.size(); ++i){
        in VehicleWheelState ws = veh.wheelStates[i];
        w.writeF32(ws.suspensionLength);
        w.writeF32(ws.prevSuspensionLength);
        w.writeF32(ws.steerAngle);
        w.writeF32(ws.rotationAngle);
        w.writeF32(ws.angularVelocity);
        w.writeF32(ws.longitudinalSlip);
        w.writeF32(ws.lateralSlip);
        w.writeF32(ws.suspensionForce);
        w.writeF32(ws.longitudinalForce);
        w.writeF32(ws.lateralForce);
        SnapWriteVec4(w, VectorSingle(ws.contactPoint));
        SnapWriteVec4(w, VectorSingle(ws.contactNormal));
        SnapWriteVec4(w, VectorSingle(ws.groundVelocity));
        SnapWriteBodyId(w, ws.groundBodyId);
        SnapWriteShapeId(w, ws.groundShapeId);
        SnapWriteSurfaceMaterial(w, ws.groundMaterial);
        w.writeB8(ws.isGrounded);
        SnapWriteTransform3D(w, ws.worldTransform);
    }

    SnapWriteFilter(w, veh.queryFilter);
    w.writeF32(veh.engineRpm);
    w.writeF32(veh.clutchSlip);
    w.writeI32(veh.currentGear);
    w.writeF32(veh.shiftCooldown);
    w.writeF32(veh.currentSpeedMps);
    return true;
}

b8 SnapReadVehicleController(in Span<u8> bytes, mut SnapshotByteReader r, mut VehicleController outVeh){
    if(!r.readBodyId(bytes, outVeh.chassisBodyId))
        return false;

    mut VehicleEngineDef eng = outVeh.engine;
    if(
        !r.readF32(bytes, eng.maxTorque)
        || !r.readF32(bytes, eng.idleRpm)
        || !r.readF32(bytes, eng.maxRpm)
        || !r.readF32(bytes, eng.shiftUpRpm)
        || !r.readF32(bytes, eng.shiftDownRpm)
        || !r.readF32(bytes, eng.finalDriveRatio)
        || !r.readF32(bytes, eng.reverseRatio)
    )
        return false;
    for(usize i = 0u; i < 6u; ++i){
        if(!r.readF32(bytes, eng.forwardGearRatios[i]))
            return false;
    }
    u32 curveCnt = 0u;
    if(!r.readCount(bytes, 8u, curveCnt) || curveCnt > 16u)
        return false;
    eng.torqueCurvePoints.resize(curveCnt);
    for(u32 i = 0u; i < curveCnt; ++i){
        f32 px = 0.0f;
        f32 py = 0.0f;
        if(!r.readVec2F(bytes, px, py))
            return false;
        eng.torqueCurvePoints[i] = f32x2u(px, py);
    }
    u8 centerDiffByte = 0u;
    u8 axleDiffByte = 0u;
    if(
        !r.readU32(bytes, eng.gearCount)
        || !r.readU8(bytes, centerDiffByte)
        || !r.readU8(bytes, axleDiffByte)
        || !r.readF32(bytes, eng.differentialBias)
        || !r.readF32(bytes, eng.centerDiffFrontSplit)
        || !r.readF32(bytes, eng.differentialLockTorque)
        || !r.readF32(bytes, eng.clutchStrength)
        || !r.readF32(bytes, eng.torqueConverterStallRpm)
        || !r.readF32(bytes, eng.torqueConverterMaxTorqueRatio)
        || !r.readF32(bytes, eng.engineInertia)
        || !r.readF32(bytes, eng.dragCoeff)
        || !r.readF32(bytes, eng.downforceCoeff)
        || !r.readF32(bytes, eng.trackWidth)
        || !r.readF32(bytes, eng.wheelbase)
        || !r.readF32(bytes, eng.espStrength)
        || !r.readF32(bytes, eng.espMaxBrakeTorque)
        || !r.readB8(bytes, eng.useAckermanSteering)
        || !r.readB8(bytes, eng.automaticTransmission)
        || !r.readB8(bytes, eng.useTorqueConverter)
        || !r.readB8(bytes, eng.useSolverImpulses)
        || !r.readB8(bytes, eng.enableAbs)
        || !r.readB8(bytes, eng.enableTcs)
        || !r.readB8(bytes, eng.enableEsp)
    )
        return false;
    if(centerDiffByte >= cast<u8>(VehicleDifferentialMode::kCount) || axleDiffByte >= cast<u8>(VehicleDifferentialMode::kCount))
        return false;
    eng.centerDifferentialMode = cast<VehicleDifferentialMode>(centerDiffByte);
    eng.axleDifferentialMode = cast<VehicleDifferentialMode>(axleDiffByte);

    u32 wheelDefCnt = 0u;
    if(!r.readCount(bytes, 32u, wheelDefCnt))
        return false;
    outVeh.wheelDefs.resize(wheelDefCnt);
    for(u32 i = 0u; i < wheelDefCnt; ++i){
        mut VehicleWheelDef wd = outVeh.wheelDefs[i];
        if(
            !r.readVec4F(bytes, wd.attachmentPoint.x, wd.attachmentPoint.y, wd.attachmentPoint.z, wd.attachmentPoint.w)
            || !r.readVec4F(bytes, wd.suspensionDirection.x, wd.suspensionDirection.y, wd.suspensionDirection.z, wd.suspensionDirection.w)
            || !r.readVec4F(bytes, wd.axleAxis.x, wd.axleAxis.y, wd.axleAxis.z, wd.axleAxis.w)
            || !r.readVec4F(bytes, wd.forwardAxis.x, wd.forwardAxis.y, wd.forwardAxis.z, wd.forwardAxis.w)
            || !r.readF32(bytes, wd.suspensionRestLength)
            || !r.readF32(bytes, wd.suspensionMaxTravel)
            || !r.readF32(bytes, wd.suspensionStiffness)
            || !r.readF32(bytes, wd.suspensionDamping)
            || !r.readF32(bytes, wd.suspensionReboundDamping)
            || !r.readF32(bytes, wd.bumpStopStiffness)
            || !r.readF32(bytes, wd.bumpStopRestitution)
            || !r.readF32(bytes, wd.wheelRadius)
            || !r.readF32(bytes, wd.wheelWidth)
            || !r.readF32(bytes, wd.wheelInertia)
            || !r.readF32(bytes, wd.maxSteerAngleRad)
            || !r.readF32(bytes, wd.driveFraction)
            || !r.readF32(bytes, wd.maxBrakeTorque)
            || !r.readF32(bytes, wd.maxHandbrakeTorque)
            || !r.readF32(bytes, wd.frictionMultiplier)
            || !r.readF32(bytes, wd.loadSensitivity)
            || !r.readF32(bytes, wd.nominalWheelLoad)
            || !r.readF32(bytes, wd.rollingResistanceCoeff)
            || !r.readF32(bytes, wd.longitudinalStiffness)
            || !r.readF32(bytes, wd.lateralStiffness)
            || !r.readF32(bytes, wd.pacejkaShapeC)
            || !r.readF32(bytes, wd.pacejkaCurvatureE)
            || !r.readI32(bytes, wd.axleIndex)
            || !r.readI32(bytes, wd.antiRollPairIndex)
            || !r.readF32(bytes, wd.antiRollStiffness)
            || !r.readB8(bytes, wd.isSteerable)
            || !r.readB8(bytes, wd.isDriven)
            || !r.readB8(bytes, wd.handbrakeAffected)
            || !r.readB8(bytes, wd.useSweptCast)
        )
            return false;
    }

    u32 wheelStateCnt = 0u;
    if(!r.readCount(bytes, 32u, wheelStateCnt) || wheelStateCnt != wheelDefCnt)
        return false;
    outVeh.wheelStates.resize(wheelStateCnt);
    for(u32 i = 0u; i < wheelStateCnt; ++i){
        mut VehicleWheelState ws = outVeh.wheelStates[i];
        if(
            !r.readF32(bytes, ws.suspensionLength)
            || !r.readF32(bytes, ws.prevSuspensionLength)
            || !r.readF32(bytes, ws.steerAngle)
            || !r.readF32(bytes, ws.rotationAngle)
            || !r.readF32(bytes, ws.angularVelocity)
            || !r.readF32(bytes, ws.longitudinalSlip)
            || !r.readF32(bytes, ws.lateralSlip)
            || !r.readF32(bytes, ws.suspensionForce)
            || !r.readF32(bytes, ws.longitudinalForce)
            || !r.readF32(bytes, ws.lateralForce)
            || !r.readVec4F(bytes, ws.contactPoint.x, ws.contactPoint.y, ws.contactPoint.z, ws.contactPoint.w)
            || !r.readVec4F(bytes, ws.contactNormal.x, ws.contactNormal.y, ws.contactNormal.z, ws.contactNormal.w)
            || !r.readVec4F(bytes, ws.groundVelocity.x, ws.groundVelocity.y, ws.groundVelocity.z, ws.groundVelocity.w)
            || !r.readBodyId(bytes, ws.groundBodyId)
            || !r.readShapeId(bytes, ws.groundShapeId)
            || !r.readSurfaceMaterial(bytes, ws.groundMaterial)
            || !r.readB8(bytes, ws.isGrounded)
            || !r.readTransform3D(bytes, ws.worldTransform)
        )
            return false;
    }

    if(
        !r.readFilter(bytes, outVeh.queryFilter)
        || !r.readF32(bytes, outVeh.engineRpm)
        || !r.readF32(bytes, outVeh.clutchSlip)
        || !r.readI32(bytes, outVeh.currentGear)
        || !r.readF32(bytes, outVeh.shiftCooldown)
        || !r.readF32(bytes, outVeh.currentSpeedMps)
    )
        return false;

    outVeh.finalizeSnapshotRestore();
    return true;
}

b8 SnapWriteRagdollInstance<TSink : ISnapshotSink>(in RagdollInstance rag, mut TSink w){
    if(!w.writeCount(rag.boneBodies.size()))
        return false;
    for(usize i = 0u; i < rag.boneBodies.size(); ++i)
        SnapWriteBodyId(w, rag.boneBodies[i]);
    if(!w.writeCount(rag.joints.size()))
        return false;
    for(usize i = 0u; i < rag.joints.size(); ++i)
        SnapWriteJointId(rag.joints[i], w);
    if(!w.writeCount(rag.boneJointIds.size()))
        return false;
    for(usize i = 0u; i < rag.boneJointIds.size(); ++i)
        SnapWriteJointId(rag.boneJointIds[i], w);
    if(
        !SnapshotWriteU32Vec(w, rag.parentIndices)
        || !SnapshotWriteF32Vec(rag.maxMotorTorques, w)
        || !SnapshotWriteF32Vec(rag.motorHertzes, w)
        || !SnapshotWriteF32Vec(rag.motorDampings, w)
    )
        return false;
    w.writeB8(rag.enableSelfCollision);
    if(!w.writeCount(rag.disabledSelfCollisionPairs.size()))
        return false;
    for(usize i = 0u; i < rag.disabledSelfCollisionPairs.size(); ++i){
        in RagdollSelfCollisionPair pair = rag.disabledSelfCollisionPairs[i];
        w.writeU32(pair.boneA);
        w.writeU32(pair.boneB);
    }

    const Span<f32> inertias = rag.snapshotBoneMaxInertias();
    if(!w.writeCount(inertias.size()))
        return false;
    w.writeF32Span(inertias);

    const Span<f32x4> refQuats = rag.snapshotJointRestRefQuats();
    if(!w.writeCount(refQuats.size()))
        return false;
    for(usize i = 0u; i < refQuats.size(); ++i)
        SnapWriteVec4(w, VectorSingle(refQuats[i]));

    const Span<u8> solverFlags = rag.snapshotBoneUseSolverMotor();
    if(!w.writeCount(solverFlags.size()))
        return false;
    w.writeBytes(solverFlags);
    return true;
}

b8 SnapReadRagdollInstance(in Span<u8> bytes, mut SnapshotByteReader r, mut RagdollInstance outRag){
    u32 bodyCnt = 0u;
    if(!r.readCount(bytes, 8u, bodyCnt))
        return false;
    outRag.boneBodies.resize(bodyCnt);
    for(u32 i = 0u; i < bodyCnt; ++i){
        if(!r.readBodyId(bytes, outRag.boneBodies[i]))
            return false;
    }

    u32 jointCnt = 0u;
    if(!r.readCount(bytes, 8u, jointCnt))
        return false;
    outRag.joints.resize(jointCnt);
    for(u32 i = 0u; i < jointCnt; ++i){
        if(!r.readJointId(bytes, outRag.joints[i]))
            return false;
    }

    u32 boneJointCnt = 0u;
    if(!r.readCount(bytes, 8u, boneJointCnt))
        return false;
    outRag.boneJointIds.resize(boneJointCnt);
    for(u32 i = 0u; i < boneJointCnt; ++i){
        if(!r.readJointId(bytes, outRag.boneJointIds[i]))
            return false;
    }

    if(
        !SnapshotReadU32Vec(bytes, r, outRag.parentIndices)
        || !SnapshotReadF32Vec(bytes, r, outRag.maxMotorTorques)
        || !SnapshotReadF32Vec(bytes, r, outRag.motorHertzes)
        || !SnapshotReadF32Vec(bytes, r, outRag.motorDampings)
        || !r.readB8(bytes, outRag.enableSelfCollision)
    )
        return false;

    u32 pairCnt = 0u;
    if(!r.readCount(bytes, 8u, pairCnt))
        return false;
    outRag.disabledSelfCollisionPairs.resize(pairCnt);
    for(u32 i = 0u; i < pairCnt; ++i){
        mut RagdollSelfCollisionPair pair = outRag.disabledSelfCollisionPairs[i];
        if(!r.readU32(bytes, pair.boneA) || !r.readU32(bytes, pair.boneB))
            return false;
    }

    Vector<f32> tmpInertias;
    Vector<f32x4> tmpRestQ;
    Vector<u8> tmpSolverFlags;
    if(
        !SnapshotReadF32Vec(bytes, r, tmpInertias)
        || !SnapshotReadVec4Vec(bytes, r, tmpRestQ)
        || !SnapshotReadU8Vec(bytes, r, tmpSolverFlags)
    )
        return false;

    outRag.finalizeSnapshotRestore(Span<f32>(tmpInertias), Span<f32x4>(tmpRestQ), Span<u8>(tmpSolverFlags));
    return true;
}

b8 SnapWriteCharacterController<TSink : ISnapshotSink>(in CharacterController ch, mut TSink w){
    in CharacterControllerDef def = ch.def;
    w.writeF32(def.radius);
    w.writeF32(def.halfHeight);
    w.writeF32(def.skinWidth);
    w.writeF32(def.maxSlopeAngleRad);
    w.writeF32(def.stepUpHeight);
    w.writeF32(def.stepDownHeight);
    w.writeF32(def.maxStrength);
    w.writeF32(def.mass);
    w.writeF32(def.predictiveContactDistance);
    w.writeU32(def.maxCollisionIterations);
    w.writeU32(def.maxConstraintIterations);
    w.writeU8(cast<u8>(def.shapeType));
    SnapWriteVec4(w, VectorSingle(def.boxHalfExtents));
    SnapWriteFilter(w, def.filter);
    SnapWriteBodyId(w, def.ignoreBodyId);
    SnapWriteShapeId(w, def.ignoreShapeId);
    w.writeB8(def.hitSensors);
    w.writeB8(def.stickToFloor);
    w.writeB8(def.pushDynamicBodies);
    w.writeB8(def.applyStandingWeight);
    w.writeB8(def.followPlatformPitchRoll);
    SnapWriteVec4(w, VectorSingle(def.up));

    SnapWriteVec4(w, VectorSingle(ch.position));
    SnapWriteVec4(w, VectorSingle(ch.rotation));
    SnapWriteVec4(w, VectorSingle(ch.linearVelocity));
    SnapWriteVec4(w, VectorSingle(ch.groundNormal));
    SnapWriteVec4(w, VectorSingle(ch.groundVelocity));
    SnapWriteVec4(w, VectorSingle(ch.groundPoint));
    w.writeU8(cast<u8>(ch.groundState));
    SnapWriteBodyId(w, ch.groundBodyId);
    SnapWriteShapeId(w, ch.groundShapeId);
    w.writeU32(ch.groundTriangleIndex);
    SnapWriteSurfaceMaterial(w, ch.groundMaterial);
    w.writeB8(ch.hitCeiling);
    SnapWriteTransform3D(w, ch.prevGroundTransform);
    w.writeB8(ch.hasPrevGroundTransform);

    if(!w.writeCount(ch.activeContacts.size()))
        return false;
    for(usize i = 0u; i < ch.activeContacts.size(); ++i){
        in CharacterContactInfo ci = ch.activeContacts[i];
        SnapWriteShapeId(w, ci.shapeId);
        w.writeU32(ci.triangleIndex);
        SnapWriteBodyId(w, ci.bodyId);
        SnapWriteVec4(w, VectorSingle(ci.point));
        SnapWriteVec4(w, VectorSingle(ci.normal));
        w.writeF32(ci.penetrationDepth);
        w.writeB8(ci.isWalkable);
    }

    SnapWriteVec4(w, ch.snapshotGroundConveyorVelocity());
    return true;
}

b8 SnapReadCharacterController(in Span<u8> bytes, mut SnapshotByteReader r, mut CharacterController outCh){
    mut CharacterControllerDef def = outCh.def;
    u8 shapeTypeByte = 0u;
    if(
        !r.readF32(bytes, def.radius)
        || !r.readF32(bytes, def.halfHeight)
        || !r.readF32(bytes, def.skinWidth)
        || !r.readF32(bytes, def.maxSlopeAngleRad)
        || !r.readF32(bytes, def.stepUpHeight)
        || !r.readF32(bytes, def.stepDownHeight)
        || !r.readF32(bytes, def.maxStrength)
        || !r.readF32(bytes, def.mass)
        || !r.readF32(bytes, def.predictiveContactDistance)
        || !r.readU32(bytes, def.maxCollisionIterations)
        || !r.readU32(bytes, def.maxConstraintIterations)
        || !r.readU8(bytes, shapeTypeByte)
        || !r.readVec4F(bytes, def.boxHalfExtents.x, def.boxHalfExtents.y, def.boxHalfExtents.z, def.boxHalfExtents.w)
        || !r.readFilter(bytes, def.filter)
        || !r.readBodyId(bytes, def.ignoreBodyId)
        || !r.readShapeId(bytes, def.ignoreShapeId)
        || !r.readB8(bytes, def.hitSensors)
        || !r.readB8(bytes, def.stickToFloor)
        || !r.readB8(bytes, def.pushDynamicBodies)
        || !r.readB8(bytes, def.applyStandingWeight)
        || !r.readB8(bytes, def.followPlatformPitchRoll)
        || !r.readVec4F(bytes, def.up.x, def.up.y, def.up.z, def.up.w)
    )
        return false;
    if(shapeTypeByte >= cast<u8>(CharacterShapeType::kCount))
        return false;
    def.shapeType = cast<CharacterShapeType>(shapeTypeByte);

    u8 groundStateByte = 0u;
    if(
        !r.readVec4F(bytes, outCh.position.x, outCh.position.y, outCh.position.z, outCh.position.w)
        || !r.readVec4F(bytes, outCh.rotation.x, outCh.rotation.y, outCh.rotation.z, outCh.rotation.w)
        || !r.readVec4F(bytes, outCh.linearVelocity.x, outCh.linearVelocity.y, outCh.linearVelocity.z, outCh.linearVelocity.w)
        || !r.readVec4F(bytes, outCh.groundNormal.x, outCh.groundNormal.y, outCh.groundNormal.z, outCh.groundNormal.w)
        || !r.readVec4F(bytes, outCh.groundVelocity.x, outCh.groundVelocity.y, outCh.groundVelocity.z, outCh.groundVelocity.w)
        || !r.readVec4F(bytes, outCh.groundPoint.x, outCh.groundPoint.y, outCh.groundPoint.z, outCh.groundPoint.w)
        || !r.readU8(bytes, groundStateByte)
        || !r.readBodyId(bytes, outCh.groundBodyId)
        || !r.readShapeId(bytes, outCh.groundShapeId)
        || !r.readU32(bytes, outCh.groundTriangleIndex)
        || !r.readSurfaceMaterial(bytes, outCh.groundMaterial)
        || !r.readB8(bytes, outCh.hitCeiling)
        || !r.readTransform3D(bytes, outCh.prevGroundTransform)
        || !r.readB8(bytes, outCh.hasPrevGroundTransform)
    )
        return false;
    if(groundStateByte > cast<u8>(CharacterGroundState::InAir))
        return false;
    outCh.groundState = cast<CharacterGroundState>(groundStateByte);

    u32 contactCnt = 0u;
    if(!r.readCount(bytes, 32u, contactCnt))
        return false;
    outCh.activeContacts.resize(contactCnt);
    for(u32 i = 0u; i < contactCnt; ++i){
        mut CharacterContactInfo ci = outCh.activeContacts[i];
        if(
            !r.readShapeId(bytes, ci.shapeId)
            || !r.readU32(bytes, ci.triangleIndex)
            || !r.readBodyId(bytes, ci.bodyId)
            || !r.readVec4F(bytes, ci.point.x, ci.point.y, ci.point.z, ci.point.w)
            || !r.readVec4F(bytes, ci.normal.x, ci.normal.y, ci.normal.z, ci.normal.w)
            || !r.readF32(bytes, ci.penetrationDepth)
            || !r.readB8(bytes, ci.isWalkable)
        )
            return false;
    }

    f32 gcx = 0.0f;
    f32 gcy = 0.0f;
    f32 gcz = 0.0f;
    f32 gcw = 0.0f;
    if(!r.readVec4F(bytes, gcx, gcy, gcz, gcw))
        return false;
    outCh.finalizeSnapshotRestore(VectorSingle(gcx, gcy, gcz, gcw));
    return true;
}

b8 SnapWriteArticulation<TSink : ISnapshotSink>(in Articulation art, mut TSink w){
    if(!w.writeCount(art.linkDefs.size()))
        return false;
    for(usize i = 0u; i < art.linkDefs.size(); ++i){
        in ArticulationLinkDef d = art.linkDefs[i];
        w.writeU32(d.parentIndex);
        w.writeU8(cast<u8>(d.jointType));
        SnapWriteTransform3D(w, d.parentToJoint);
        SnapWriteTransform3D(w, d.jointToChild);
        SnapWriteVec4(w, VectorSingle(d.jointAxisLocal));
        SnapWriteVec4(w, VectorSingle(d.jointAxisSecondaryLocal));
        w.writeF32(d.mass);
        SnapWriteVec4(w, VectorSingle(d.comLocal));
        SnapWriteVec4(w, VectorSingle(d.inertiaDiag));
        SnapWriteSymMat3(w, d.inertiaTensor);
        w.writeB8(d.useFullInertiaTensor);
        w.writeB8(d.enableLimit);
        w.writeF32(d.lowerLimit);
        w.writeF32(d.upperLimit);
        SnapWriteVec4(w, VectorSingle(d.lowerLimits));
        SnapWriteVec4(w, VectorSingle(d.upperLimits));
        w.writeF32(d.limitStiffness);
        w.writeF32(d.limitDamping);
        w.writeB8(d.enableDrive);
        w.writeF32(d.driveTargetPos);
        w.writeF32(d.driveTargetVel);
        SnapWriteVec4(w, VectorSingle(d.driveTargetPos3));
        SnapWriteVec4(w, VectorSingle(d.driveTargetVel3));
        w.writeF32(d.driveStiffness);
        w.writeF32(d.driveDamping);
        w.writeF32(d.driveMaxForce);
        w.writeF32(d.jointDamping);
        w.writeF32(d.jointFriction);
        w.writeF32(d.limitRestitution);
        SnapWriteBodyId(w, d.proxyBodyId);
    }

    if(!w.writeCount(art.linkStates.size()))
        return false;
    for(usize i = 0u; i < art.linkStates.size(); ++i){
        in ArticulationLinkState s = art.linkStates[i];
        w.writeF32(s.q);
        w.writeF32(s.qd);
        w.writeF32(s.qdd);
        w.writeF32(s.externalTau);
        SnapWriteVec4(w, VectorSingle(s.q3));
        SnapWriteVec4(w, VectorSingle(s.qd3));
        SnapWriteVec4(w, VectorSingle(s.qdd3));
        SnapWriteVec4(w, VectorSingle(s.externalTau3));
        SnapWriteVec4(w, VectorSingle(s.jointRotation));
        w.writeF32(s.measuredJointTorque);
        SnapWriteVec4(w, VectorSingle(s.measuredJointTorque3));
        SnapWriteSpatialVec(s.measuredReactionForce, w);
        SnapWriteTransform3D(w, s.worldTransform);
        SnapWriteSpatialVec(s.spatialVelocity, w);
        SnapWriteSpatialVec(s.externalForce, w);
    }

    SnapWriteTransform3D(w, art.baseTransform);
    SnapWriteSpatialVec(art.baseVelocity, w);
    w.writeB8(art.fixedBase);
    w.writeU32(art.subSteps);
    w.writeB8(art.enableContactCoupling);
    w.writeF32(art.contactRestitution);
    w.writeF32(art.contactFriction);
    SnapWriteFilter(w, art.contactFilter);

    if(!w.writeCount(art.mimicConstraints.size()))
        return false;
    for(usize i = 0u; i < art.mimicConstraints.size(); ++i){
        in ArticulationMimicConstraint mc = art.mimicConstraints[i];
        w.writeU32(mc.linkIndex);
        w.writeU32(mc.dofIndex);
        w.writeU32(mc.targetLinkIndex);
        w.writeU32(mc.targetDofIndex);
        w.writeF32(mc.gearRatio);
        w.writeF32(mc.offset);
        w.writeF32(mc.compliance);
        w.writeB8(mc.enabled);
    }

    if(!w.writeCount(art.tendonConstraints.size()))
        return false;
    for(usize i = 0u; i < art.tendonConstraints.size(); ++i){
        in ArticulationTendonConstraint tc = art.tendonConstraints[i];
        if(!w.writeCount(tc.linkIndices.size()))
            return false;
        for(usize k = 0u; k < tc.linkIndices.size(); ++k)
            w.writeU32(tc.linkIndices[k]);
        if(!w.writeCount(tc.dofIndices.size()))
            return false;
        for(usize k = 0u; k < tc.dofIndices.size(); ++k)
            w.writeU32(tc.dofIndices[k]);
        if(!w.writeCount(tc.coefficients.size()))
            return false;
        for(usize k = 0u; k < tc.coefficients.size(); ++k)
            w.writeF32(tc.coefficients[k]);
        w.writeF32(tc.restLength);
        w.writeF32(tc.lowerLimit);
        w.writeF32(tc.upperLimit);
        w.writeF32(tc.compliance);
        w.writeB8(tc.isEquality);
        w.writeB8(tc.enabled);
    }

    if(!w.writeCount(art.loopConstraints.size()))
        return false;
    for(usize i = 0u; i < art.loopConstraints.size(); ++i){
        in ArticulationLoopConstraint lc = art.loopConstraints[i];
        w.writeU32(lc.linkIndexA);
        w.writeU32(lc.linkIndexB);
        SnapWriteVec4(w, VectorSingle(lc.localAnchorA));
        SnapWriteVec4(w, VectorSingle(lc.localAnchorB));
        w.writeB8(lc.lockOrientation);
        SnapWriteVec4(w, VectorSingle(lc.relOrientation));
        w.writeF32(lc.compliance);
        w.writeB8(lc.enabled);
    }

    w.writeB8(art.enableSelfCollision);
    w.writeF32(art.selfCollisionMargin);
    w.writeB8(art.enableSleep);
    w.writeB8(art.isSleeping);
    w.writeF32(art.sleepTimer);
    w.writeF32(art.sleepLinearThreshold);
    w.writeF32(art.sleepAngularThreshold);
    w.writeF32(art.sleepTimeThreshold);
    return true;
}

b8 SnapReadArticulation(in Span<u8> bytes, mut SnapshotByteReader r, mut Articulation outArt){
    u32 linkDefCnt = 0u;
    if(!r.readCount(bytes, 32u, linkDefCnt))
        return false;
    outArt.linkDefs.resize(linkDefCnt);
    for(u32 i = 0u; i < linkDefCnt; ++i){
        mut ArticulationLinkDef d = outArt.linkDefs[i];
        u8 jointTypeByte = 0u;
        if(
            !r.readU32(bytes, d.parentIndex)
            || !r.readU8(bytes, jointTypeByte)
            || !r.readTransform3D(bytes, d.parentToJoint)
            || !r.readTransform3D(bytes, d.jointToChild)
            || !r.readVec4F(bytes, d.jointAxisLocal.x, d.jointAxisLocal.y, d.jointAxisLocal.z, d.jointAxisLocal.w)
            || !r.readVec4F(bytes, d.jointAxisSecondaryLocal.x, d.jointAxisSecondaryLocal.y, d.jointAxisSecondaryLocal.z, d.jointAxisSecondaryLocal.w)
            || !r.readF32(bytes, d.mass)
            || !r.readVec4F(bytes, d.comLocal.x, d.comLocal.y, d.comLocal.z, d.comLocal.w)
            || !r.readVec4F(bytes, d.inertiaDiag.x, d.inertiaDiag.y, d.inertiaDiag.z, d.inertiaDiag.w)
            || !r.readSymMat3(bytes, d.inertiaTensor)
            || !r.readB8(bytes, d.useFullInertiaTensor)
            || !r.readB8(bytes, d.enableLimit)
            || !r.readF32(bytes, d.lowerLimit)
            || !r.readF32(bytes, d.upperLimit)
            || !r.readVec4F(bytes, d.lowerLimits.x, d.lowerLimits.y, d.lowerLimits.z, d.lowerLimits.w)
            || !r.readVec4F(bytes, d.upperLimits.x, d.upperLimits.y, d.upperLimits.z, d.upperLimits.w)
            || !r.readF32(bytes, d.limitStiffness)
            || !r.readF32(bytes, d.limitDamping)
            || !r.readB8(bytes, d.enableDrive)
            || !r.readF32(bytes, d.driveTargetPos)
            || !r.readF32(bytes, d.driveTargetVel)
            || !r.readVec4F(bytes, d.driveTargetPos3.x, d.driveTargetPos3.y, d.driveTargetPos3.z, d.driveTargetPos3.w)
            || !r.readVec4F(bytes, d.driveTargetVel3.x, d.driveTargetVel3.y, d.driveTargetVel3.z, d.driveTargetVel3.w)
            || !r.readF32(bytes, d.driveStiffness)
            || !r.readF32(bytes, d.driveDamping)
            || !r.readF32(bytes, d.driveMaxForce)
            || !r.readF32(bytes, d.jointDamping)
            || !r.readF32(bytes, d.jointFriction)
            || !r.readF32(bytes, d.limitRestitution)
            || !r.readBodyId(bytes, d.proxyBodyId)
        )
            return false;
        if(jointTypeByte >= cast<u8>(ArticulationJointType::kCount))
            return false;
        if(i > 0u && d.parentIndex >= i)
            return false;
        d.jointType = cast<ArticulationJointType>(jointTypeByte);
    }

    u32 linkStateCnt = 0u;
    if(!r.readCount(bytes, 32u, linkStateCnt) || linkStateCnt != linkDefCnt)
        return false;
    outArt.linkStates.resize(linkStateCnt);
    for(u32 i = 0u; i < linkStateCnt; ++i){
        mut ArticulationLinkState s = outArt.linkStates[i];
        if(
            !r.readF32(bytes, s.q)
            || !r.readF32(bytes, s.qd)
            || !r.readF32(bytes, s.qdd)
            || !r.readF32(bytes, s.externalTau)
            || !r.readVec4F(bytes, s.q3.x, s.q3.y, s.q3.z, s.q3.w)
            || !r.readVec4F(bytes, s.qd3.x, s.qd3.y, s.qd3.z, s.qd3.w)
            || !r.readVec4F(bytes, s.qdd3.x, s.qdd3.y, s.qdd3.z, s.qdd3.w)
            || !r.readVec4F(bytes, s.externalTau3.x, s.externalTau3.y, s.externalTau3.z, s.externalTau3.w)
            || !r.readVec4F(bytes, s.jointRotation.x, s.jointRotation.y, s.jointRotation.z, s.jointRotation.w)
            || !r.readF32(bytes, s.measuredJointTorque)
            || !r.readVec4F(bytes, s.measuredJointTorque3.x, s.measuredJointTorque3.y, s.measuredJointTorque3.z, s.measuredJointTorque3.w)
            || !SnapReadSpatialVec(bytes, r, s.measuredReactionForce)
            || !r.readTransform3D(bytes, s.worldTransform)
            || !SnapReadSpatialVec(bytes, r, s.spatialVelocity)
            || !SnapReadSpatialVec(bytes, r, s.externalForce)
        )
            return false;
    }

    if(
        !r.readTransform3D(bytes, outArt.baseTransform)
        || !SnapReadSpatialVec(bytes, r, outArt.baseVelocity)
        || !r.readB8(bytes, outArt.fixedBase)
        || !r.readU32(bytes, outArt.subSteps)
        || !r.readB8(bytes, outArt.enableContactCoupling)
        || !r.readF32(bytes, outArt.contactRestitution)
        || !r.readF32(bytes, outArt.contactFriction)
        || !r.readFilter(bytes, outArt.contactFilter)
    )
        return false;

    u32 mimicCnt = 0u;
    if(!r.readCount(bytes, 16u, mimicCnt))
        return false;
    outArt.mimicConstraints.resize(mimicCnt);
    for(u32 i = 0u; i < mimicCnt; ++i){
        mut ArticulationMimicConstraint mc = outArt.mimicConstraints[i];
        if(
            !r.readU32(bytes, mc.linkIndex)
            || !r.readU32(bytes, mc.dofIndex)
            || !r.readU32(bytes, mc.targetLinkIndex)
            || !r.readU32(bytes, mc.targetDofIndex)
            || !r.readF32(bytes, mc.gearRatio)
            || !r.readF32(bytes, mc.offset)
            || !r.readF32(bytes, mc.compliance)
            || !r.readB8(bytes, mc.enabled)
        )
            return false;
    }

    u32 tendonCnt = 0u;
    if(!r.readCount(bytes, 16u, tendonCnt))
        return false;
    outArt.tendonConstraints.resize(tendonCnt);
    for(u32 i = 0u; i < tendonCnt; ++i){
        mut ArticulationTendonConstraint tc = outArt.tendonConstraints[i];
        u32 lCnt = 0u;
        if(!r.readCount(bytes, 4u, lCnt) || lCnt > 8u)
            return false;
        tc.linkIndices.resize(lCnt);
        for(u32 k = 0u; k < lCnt; ++k){
            if(!r.readU32(bytes, tc.linkIndices[k]))
                return false;
        }
        u32 dCnt = 0u;
        if(!r.readCount(bytes, 4u, dCnt) || dCnt > 8u)
            return false;
        tc.dofIndices.resize(dCnt);
        for(u32 k = 0u; k < dCnt; ++k){
            if(!r.readU32(bytes, tc.dofIndices[k]))
                return false;
        }
        u32 cCnt = 0u;
        if(!r.readCount(bytes, 4u, cCnt) || cCnt > 8u)
            return false;
        tc.coefficients.resize(cCnt);
        for(u32 k = 0u; k < cCnt; ++k){
            if(!r.readF32(bytes, tc.coefficients[k]))
                return false;
        }
        if(
            !r.readF32(bytes, tc.restLength)
            || !r.readF32(bytes, tc.lowerLimit)
            || !r.readF32(bytes, tc.upperLimit)
            || !r.readF32(bytes, tc.compliance)
            || !r.readB8(bytes, tc.isEquality)
            || !r.readB8(bytes, tc.enabled)
        )
            return false;
    }

    u32 loopCnt = 0u;
    if(!r.readCount(bytes, 32u, loopCnt))
        return false;
    outArt.loopConstraints.resize(loopCnt);
    for(u32 i = 0u; i < loopCnt; ++i){
        mut ArticulationLoopConstraint lc = outArt.loopConstraints[i];
        if(
            !r.readU32(bytes, lc.linkIndexA)
            || !r.readU32(bytes, lc.linkIndexB)
            || !r.readVec4F(bytes, lc.localAnchorA.x, lc.localAnchorA.y, lc.localAnchorA.z, lc.localAnchorA.w)
            || !r.readVec4F(bytes, lc.localAnchorB.x, lc.localAnchorB.y, lc.localAnchorB.z, lc.localAnchorB.w)
            || !r.readB8(bytes, lc.lockOrientation)
            || !r.readVec4F(bytes, lc.relOrientation.x, lc.relOrientation.y, lc.relOrientation.z, lc.relOrientation.w)
            || !r.readF32(bytes, lc.compliance)
            || !r.readB8(bytes, lc.enabled)
        )
            return false;
    }

    if(
        !r.readB8(bytes, outArt.enableSelfCollision)
        || !r.readF32(bytes, outArt.selfCollisionMargin)
        || !r.readB8(bytes, outArt.enableSleep)
        || !r.readB8(bytes, outArt.isSleeping)
        || !r.readF32(bytes, outArt.sleepTimer)
        || !r.readF32(bytes, outArt.sleepLinearThreshold)
        || !r.readF32(bytes, outArt.sleepAngularThreshold)
        || !r.readF32(bytes, outArt.sleepTimeThreshold)
    )
        return false;

    outArt.finalizeSnapshotRestore();
    return true;
}

usize EstimatePhysicsSubsystemsSnapshotSize(in PhysicsSubsystemsBundle bundle){
    usize est = 64u;
    est += bundle.environment.fluids.size() * 120u + bundle.environment.forceFields.size() * 120u;
    for(usize i = 0u; i < bundle.softBodies.size(); ++i){
        in SoftBody sb = bundle.softBodies[i];
        est += 128u + sb.particles.size() * 72u + sb.distanceConstraints.size() * 20u + sb.bendingConstraints.size() * 20u;
        est += sb.dihedralBendingConstraints.size() * 28u + sb.volumeConstraints.size() * 100u + sb.surfaceTriangles.size() * 12u;
        est += sb.attachments.size() * 32u + sb.backstopConstraints.size() * 44u + sb.goalConstraints.size() * 28u + sb.restLocalPositions.size() * 16u + sb.particleSourceIndices.size() * 4u;
    }
    for(usize i = 0u; i < bundle.vehicles.size(); ++i){
        in VehicleController veh = bundle.vehicles[i];
        est += 256u + veh.wheelDefs.size() * 180u + veh.wheelStates.size() * 220u;
    }
    for(usize i = 0u; i < bundle.ragdolls.size(); ++i){
        in RagdollInstance rag = bundle.ragdolls[i];
        est += 64u + rag.boneBodies.size() * 48u + rag.joints.size() * 8u + rag.boneJointIds.size() * 8u + rag.disabledSelfCollisionPairs.size() * 8u;
    }
    for(usize i = 0u; i < bundle.characters.size(); ++i){
        in CharacterController ch = bundle.characters[i];
        est += 420u + ch.activeContacts.size() * 64u;
    }
    for(usize i = 0u; i < bundle.articulations.size(); ++i){
        in Articulation art = bundle.articulations[i];
        est += 256u + art.linkDefs.size() * 280u + art.linkStates.size() * 260u;
        est += art.mimicConstraints.size() * 32u + art.tendonConstraints.size() * 128u + art.loopConstraints.size() * 64u;
    }
    return est;
}

b8 SerializePhysicsSubsystemsPayload<TSink : ISnapshotSink>(in PhysicsSubsystemsBundle bundle, mut TSink w){
    w.writeU32(s_SubsystemsSnapshotMagic);
    w.writeU32(s_SubsystemsSnapshotVersion);

    if(!SnapWritePhysicsEnvironment(bundle.environment, w))
        return false;

    if(!w.writeCount(bundle.softBodies.size()))
        return false;
    for(usize i = 0u; i < bundle.softBodies.size(); ++i){
        if(!SnapWriteSoftBody(bundle.softBodies[i], w))
            return false;
    }

    if(!w.writeCount(bundle.vehicles.size()))
        return false;
    for(usize i = 0u; i < bundle.vehicles.size(); ++i){
        if(!SnapWriteVehicleController(bundle.vehicles[i], w))
            return false;
    }

    if(!w.writeCount(bundle.ragdolls.size()))
        return false;
    for(usize i = 0u; i < bundle.ragdolls.size(); ++i){
        if(!SnapWriteRagdollInstance(bundle.ragdolls[i], w))
            return false;
    }

    if(!w.writeCount(bundle.characters.size()))
        return false;
    for(usize i = 0u; i < bundle.characters.size(); ++i){
        if(!SnapWriteCharacterController(bundle.characters[i], w))
            return false;
    }

    if(!w.writeCount(bundle.articulations.size()))
        return false;
    for(usize i = 0u; i < bundle.articulations.size(); ++i){
        if(!SnapWriteArticulation(bundle.articulations[i], w))
            return false;
    }
    return true;
}

b8 ReadPhysicsSubsystemsPayload(in Span<u8> bytes, mut SnapshotByteReader r, mut PhysicsSubsystemsBundle outTmp){
    u32 magic = 0u;
    u32 version = 0u;
    if(!r.readU32(bytes, magic) || !r.readU32(bytes, version))
        return false;
    if(magic != s_SubsystemsSnapshotMagic || version != s_SubsystemsSnapshotVersion)
        return false;

    outTmp.clear();
    if(!SnapReadPhysicsEnvironment(bytes, r, outTmp.environment))
        return false;

    u32 sbCount = 0u;
    if(!r.readCount(bytes, 32u, sbCount))
        return false;
    outTmp.softBodies.resize(sbCount);
    for(u32 i = 0u; i < sbCount; ++i){
        if(!SnapReadSoftBody(bytes, r, outTmp.softBodies[i]))
            return false;
    }

    u32 vehCount = 0u;
    if(!r.readCount(bytes, 32u, vehCount))
        return false;
    outTmp.vehicles.resize(vehCount);
    for(u32 i = 0u; i < vehCount; ++i){
        if(!SnapReadVehicleController(bytes, r, outTmp.vehicles[i]))
            return false;
    }

    u32 ragCount = 0u;
    if(!r.readCount(bytes, 16u, ragCount))
        return false;
    outTmp.ragdolls.resize(ragCount);
    for(u32 i = 0u; i < ragCount; ++i){
        if(!SnapReadRagdollInstance(bytes, r, outTmp.ragdolls[i]))
            return false;
    }

    u32 chCount = 0u;
    if(!r.readCount(bytes, 64u, chCount))
        return false;
    outTmp.characters.resize(chCount);
    for(u32 i = 0u; i < chCount; ++i){
        if(!SnapReadCharacterController(bytes, r, outTmp.characters[i]))
            return false;
    }

    u32 artCount = 0u;
    if(!r.readCount(bytes, 32u, artCount))
        return false;
    outTmp.articulations.resize(artCount);
    for(u32 i = 0u; i < artCount; ++i){
        if(!SnapReadArticulation(bytes, r, outTmp.articulations[i]))
            return false;
    }
    return true;
}

void CommitRestoredPhysicsSubsystems(in PhysicsSubsystemsBundle tmp, mut PhysicsSubsystemsBundle bundle){
    bundle = tmp;
}

b8 SerializePhysicsSubsystemsSnapshot(in PhysicsSubsystemsBundle bundle, mut Vector<u8> outBytes){
    outBytes.clear();
    outBytes.reserve(EstimatePhysicsSubsystemsSnapshotSize(bundle));
    SnapshotDirectByteWriter w(outBytes);
    if(!SerializePhysicsSubsystemsPayload(bundle, w))
        return false;
    w.writeU64(w.m_hash);
    return true;
}

b8 RestorePhysicsSubsystemsSnapshot(in Span<u8> bytes, mut PhysicsSubsystemsBundle bundle){
    SnapshotByteReader r;
    usize payloadEnd = 0u;
    if(!VerifySnapshotChecksumAndInitReader(bytes, 24u, r, payloadEnd))
        return false;
    PhysicsSubsystemsBundle tmp;
    if(!ReadPhysicsSubsystemsPayload(bytes, r, tmp))
        return false;
    if(r.cursor != payloadEnd)
        return false;
    CommitRestoredPhysicsSubsystems(tmp, bundle);
    return true;
}

u64 ComputePhysicsSubsystemsStateHash(in PhysicsSubsystemsBundle bundle){
    SnapshotFnv1a64Sink hashSink;
    if(!SerializePhysicsSubsystemsPayload(bundle, hashSink))
        return 0u;
    return hashSink.hash;
}

b8 SerializeFullPhysicsSnapshot(in PhysicsWorld world, in PhysicsSubsystemsBundle bundle, mut Vector<u8> outBytes){
    outBytes.clear();
    outBytes.reserve(EstimatePhysicsWorldSnapshotSize(world) + EstimatePhysicsSubsystemsSnapshotSize(bundle) + 24u);
    SnapshotDirectByteWriter w(outBytes);
    w.writeU32(s_FullSnapshotMagic);
    w.writeU32(s_FullSnapshotVersion);
    if(!SerializePhysicsWorldSnapshotPayload(world, w))
        return false;
    if(!SerializePhysicsSubsystemsPayload(bundle, w))
        return false;
    w.writeU64(w.m_hash);
    return true;
}

b8 RestoreFullPhysicsSnapshot(in Span<u8> bytes, mut PhysicsWorld world, mut PhysicsSubsystemsBundle bundle){
    if(world.m_inStep)
        return false;
    SnapshotByteReader r;
    usize payloadEnd = 0u;
    if(!VerifySnapshotChecksumAndInitReader(bytes, 32u, r, payloadEnd))
        return false;
    u32 magic = 0u;
    u32 version = 0u;
    if(!r.readU32(bytes, magic) || !r.readU32(bytes, version))
        return false;
    if(magic != s_FullSnapshotMagic || version != s_FullSnapshotVersion)
        return false;

    PhysicsWorld tmpWorld;
    if(!ReadPhysicsWorldSnapshotPayload(bytes, r, tmpWorld))
        return false;
    PhysicsSubsystemsBundle tmpBundle;
    if(!ReadPhysicsSubsystemsPayload(bytes, r, tmpBundle))
        return false;
    if(r.cursor != payloadEnd)
        return false;

    CommitRestoredPhysicsWorld(tmpWorld, world);
    CommitRestoredPhysicsSubsystems(tmpBundle, bundle);
    return true;
}

u64 ComputeFullPhysicsStateHash(in PhysicsWorld world, in PhysicsSubsystemsBundle bundle){
    SnapshotFnv1a64Sink hashSink;
    hashSink.writeU32(s_FullSnapshotMagic);
    hashSink.writeU32(s_FullSnapshotVersion);
    if(!SerializePhysicsWorldSnapshotPayload(world, hashSink))
        return 0u;
    if(!SerializePhysicsSubsystemsPayload(bundle, hashSink))
        return 0u;
    return hashSink.hash;
}


