const StringView s_MaterialSurfaceSourceLabel = "surface";
const StringView s_EngineGraphicsIncludeRoot = "engine/graphics";

const StringView s_GraphicsComponentAssetField = "asset";
const StringView s_RendererComponentMaterialField = "material";
