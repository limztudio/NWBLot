    ASSERT_TRUE(m_builder.beginPanel("panel", { 10.0f, 10.0f, 360.0f, 280.0f }));
    EXPECT_FALSE(m_builder.tooltip("tip", "missing", "Help", m_tooltip, m_tooltipOptions));
