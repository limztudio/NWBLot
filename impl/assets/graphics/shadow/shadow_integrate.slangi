////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_SHADOW_INTEGRATE_SLANGI
#define NWB_GRAPHICS_SHADOW_INTEGRATE_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "shadow_crossing.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Software occlusion rays finish each instance before visiting the next scene leaf. Only the summed optical depth,
// interface product, and opaque gate remain live across instances; temporary crossing lists never mix objects.
// Include after shadow_surface.slangi for the shared Fresnel and Beer-Lambert helpers.


#define NWB_SHADOW_MAX_CROSSINGS_PER_OCCLUDER 4

struct NwbShadowVisibilityAccumulator{
    half3 transmittance;
    half3 opticalDepth;
    half interfaceTransmittance;
};

// Temporary per-instance crossing state. Scoped to the single mesh traversal in nwbSwShadowInstanceOptics so its crossing list is finalized exactly once and never retained across the next instance.
struct NwbShadowInstanceOptics{
    float3 absorptionCoeff;
    // The interface product folds (0, 1) Fresnel transmission fractions only, so half math is sufficient here.
    // Ray extents (tMin/tMax/crossingT) and absorption stay on float. Widen only at the half lerp in the finalize.
    half interfaceTransmittance;
    float tMin;
    float tMax;
    uint crossingCount;
    uint crossingOverflow;
    float crossingT[NWB_SHADOW_MAX_CROSSINGS_PER_OCCLUDER];
};

// Traversal outcome for one instance: the caller combines completed optics exactly once, zeroes visibility on an opaque block, keeps the conservative all-blocked fallback on stack overflow, and adds nothing on a clean miss.
enum class NwbShadowInstanceStatus : uint{
    Completed,
    NoIntersection,
    OpaqueBlocked,
    StackOverflow,
};


// Seed the opaque gate and completed-instance optical accumulation.
NwbShadowVisibilityAccumulator nwbShadowVisibilityBegin(){
    NwbShadowVisibilityAccumulator acc;
    acc.transmittance = half3(1.0h, 1.0h, 1.0h);
    acc.opticalDepth = half3(0.0h, 0.0h, 0.0h);
    acc.interfaceTransmittance = half(1.0h);
    return acc;
}

// Seed temporary instance optics for one mesh traversal. Absorption is set on the first accepted crossing.
NwbShadowInstanceOptics nwbShadowInstanceOpticsBegin(){
    NwbShadowInstanceOptics optics;
    optics.absorptionCoeff = float3(0.0, 0.0, 0.0);
    optics.interfaceTransmittance = half(1.0h);
    optics.tMin = 0.0;
    optics.tMax = 0.0;
    optics.crossingCount = 0u;
    optics.crossingOverflow = 0u;
    return optics;
}

// Fold ONE accepted transparent crossing into temporary instance state. Order-independent: pairing happens once at finalize, so traversal must never narrow tMax for transparent occluders.
void nwbShadowInstanceIntegrateCrossing(inout NwbShadowInstanceOptics optics, inout bool hasAbsorption, const float ior, const half3 transmission, const half cosI, const float t){
    for(uint i = 0u; i < optics.crossingCount; ++i){
        if(nwbShadowCrossingMatchesEndpoint(t, optics.crossingT[i]))
            return;
    }
    if(!hasAbsorption){
        optics.absorptionCoeff = nwbShadowAbsorptionCoefficient(transmission);
        hasAbsorption = true;
    }
    optics.interfaceTransmittance *= nwbShadowFresnelTransmittedFraction(ior, cosI);
    if(optics.crossingCount == 0u){
        optics.tMin = t;
        optics.tMax = t;
    }
    else{
        optics.tMin = min(optics.tMin, t);
        optics.tMax = max(optics.tMax, t);
    }
    if(optics.crossingCount < (uint)NWB_SHADOW_MAX_CROSSINGS_PER_OCCLUDER){
        optics.crossingT[optics.crossingCount] = t;
        optics.crossingCount += 1u;
    }
    else{
        optics.crossingOverflow = 1u;
    }
}

// Pair one instance's merged boundary distances into inside intervals. Overflow or a trailing odd count beyond the first pair uses the first-to-last span; a singleton contributes no volume.
float nwbShadowInstanceChordLength(const NwbShadowInstanceOptics optics){
    float sortedT[NWB_SHADOW_MAX_CROSSINGS_PER_OCCLUDER];
    const uint crossingCount = min(optics.crossingCount, (uint)NWB_SHADOW_MAX_CROSSINGS_PER_OCCLUDER);
    for(uint j = 0u; j < crossingCount; ++j)
        sortedT[j] = optics.crossingT[j];
    for(uint j = 0u; j < crossingCount; ++j){
        uint minIndex = j;
        for(uint k = j + 1u; k < crossingCount; ++k){
            if(sortedT[k] < sortedT[minIndex])
                minIndex = k;
        }
        const float tmp = sortedT[j];
        sortedT[j] = sortedT[minIndex];
        sortedT[minIndex] = tmp;
    }
    if(optics.crossingOverflow != 0u)
        return max(optics.tMax - optics.tMin, 0.0);
    float chordLength = 0.0;
    for(uint j = 0u; (j + 1u) < crossingCount; j += 2u)
        chordLength += max(sortedT[j + 1u] - sortedT[j], 0.0);
    if(crossingCount > 1u && (crossingCount & 1u) != 0u)
        chordLength = max(chordLength, max(optics.tMax - optics.tMin, 0.0));
    return chordLength;
}

// Cosine to the ray is a saturate-bounded (0, 1) factor, so half math is sufficient here (widened at float geometry uses).
half nwbShadowCosineToRay(const float3 normal, const float3 rayDirection){
    return half(saturate(abs(dot(rayDirection, normal)) * rsqrt(max(dot(normal, normal), 1e-20)) * rsqrt(max(dot(rayDirection, rayDirection), 1e-20))));
}

// Smooth-normal blend weight is a smoothstep-bounded (0, 1) factor, so half math is sufficient here.
half nwbShadowSmoothNormalWeight(const float3 n0, const float3 n1, const float3 n2){
    const float spread = max(max(dot(n0 - n1, n0 - n1), dot(n1 - n2, n1 - n2)), dot(n2 - n0, n2 - n0));
    return half(smoothstep(1e-5, 2e-3, spread));
}

// Finish one instance once. Keep the existing endpoint reconstruction and half rounding, including sub-ULP chords.
// Scene leaves have unique instance identities, so this fold needs neither an identity table nor a retained hit list.
void nwbShadowAccumulateInstance(inout NwbShadowVisibilityAccumulator acc, const NwbShadowInstanceOptics optics){
    const float pairedChord = nwbShadowInstanceChordLength(optics);
    const float endpoint = optics.tMin + pairedChord;
    const float chordLength = max(endpoint - optics.tMin, 0.0);
    const half interfaceWeight = half(smoothstep(0.0, NWB_SHADOW_INTERFACE_FADE_DISTANCE, chordLength));
    acc.interfaceTransmittance *= lerp(half(1.0h), optics.interfaceTransmittance, interfaceWeight);
    acc.opticalDepth += half3(optics.absorptionCoeff) * half(chordLength);
}

half3 nwbShadowFinalizeVisibility(const NwbShadowVisibilityAccumulator acc){
    return half3(saturate(acc.transmittance * acc.interfaceTransmittance * exp(-max(acc.opticalDepth, half3(0.0h, 0.0h, 0.0h)))));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

