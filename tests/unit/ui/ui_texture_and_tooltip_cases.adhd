    EXPECT_FALSE(state.visible());
    EXPECT_EQ(state.revision(), waitingRevision);
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, maxF32, options));
    EXPECT_TRUE(state.visible());
    const u64 visibleRevision = state.revision();
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, maxF32, options));
    EXPECT_TRUE(state.visible());
    EXPECT_EQ(state.revision(), visibleRevision);
}

void VerifyUiTooltipBehaviorTests_LeavingAVisibleAnchorRequiresACompleteNewHoverDelay(){
    TooltipState state = TooltipState();
    const TooltipOptions options = TooltipOptions();
    const WidgetId anchor = MakeUiTooltipAnchor();
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.0f, options));
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.5f, options));
    ASSERT_TRUE(state.visible());
    const u64 visibleRevision = state.revision();
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, false, 100.0f, options));
    EXPECT_FALSE(state.visible());
    EXPECT_GT(state.revision(), visibleRevision);
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 100.0f, options));
    EXPECT_FALSE(state.visible());
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.25f, options));
    EXPECT_FALSE(state.visible());
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.25f, options));
    EXPECT_TRUE(state.visible());
}

void VerifyUiTooltipBehaviorTests_LeavingBeforeTheDelayAlsoDiscardsAccumulatedTime(){
    TooltipState state = TooltipState();
    const TooltipOptions options = TooltipOptions();
    const WidgetId anchor = MakeUiTooltipAnchor();
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.0f, options));
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.25f, options));
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, false, 0.0f, options));
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.25f, options));
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.25f, options));
    EXPECT_FALSE(state.visible());
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.25f, options));
    EXPECT_TRUE(state.visible());
}

void VerifyUiTooltipBehaviorTests_DisablingAndReenablingDoesNotCarryOldHoverTime(){
    TooltipState state = TooltipState();
    TooltipOptions options = TooltipOptions();
    const WidgetId anchor = MakeUiTooltipAnchor();
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.0f, options));
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.5f, options));
    ASSERT_TRUE(state.visible());
    options.enabled = false;
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 100.0f, options));
    EXPECT_FALSE(state.visible());
    options.enabled = true;
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 100.0f, options));
    EXPECT_FALSE(state.visible());
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.5f, options));
    EXPECT_TRUE(state.visible());
}

void VerifyUiTooltipBehaviorTests_ReplacingTheAnchorRetiresAVisibleTooltip(){
    TooltipState state = TooltipState();
    const TooltipOptions options = TooltipOptions();
    const WidgetId anchor = MakeUiTooltipAnchor();
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.0f, options));
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.5f, options));
    const u64 visibleRevision = state.revision();
    const WidgetId replacement = WidgetId(202u);
    ASSERT_TRUE(TooltipBehavior::Update(state, replacement, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 100.0f, options));
    EXPECT_FALSE(state.visible());
    EXPECT_GT(state.revision(), visibleRevision);
    ASSERT_TRUE(TooltipBehavior::Update(state, replacement, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.5f, options));
    EXPECT_TRUE(state.visible());
}

void VerifyUiTooltipBehaviorTests_RenewedDeclarationRestartsTheDelayEvenWithTheSameAnchorKey(){
    TooltipState state = TooltipState();
    const TooltipOptions options = TooltipOptions();
    const WidgetId anchor = MakeUiTooltipAnchor();
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.0f, options));
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, PopupToken(), 0u, 0u, true, 0.25f, options));
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration + 1u, PopupToken(), 0u, 0u, true, 100.0f, options));
    EXPECT_FALSE(state.visible());
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration + 1u, PopupToken(), 0u, 0u, true, 0.25f, options));
    EXPECT_FALSE(state.visible());
    ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration + 1u, PopupToken(), 0u, 0u, true, 0.25f, options));
    EXPECT_TRUE(state.visible());
}

void VerifyUiTooltipBehaviorTests_EveryPopupLifetimeFieldParticipatesInTheHoverBinding(){
    const PopupToken basePopup = MakeUiTooltipPopup();
    Array<PopupToken, 5u> replacements;
    replacements[0u] = basePopup;
    replacements[1u] = basePopup;
    replacements[2u] = basePopup;
    replacements[3u] = basePopup;
    replacements[4u] = PopupToken();
    ++replacements[0u].widget.value;
    ++replacements[1u].declarationGeneration;
    ++replacements[2u].instanceGeneration;
    ++replacements[3u].openGeneration;
    const TooltipOptions options = TooltipOptions();
    const WidgetId anchor = MakeUiTooltipAnchor();
    for(usize index = 0u; index < replacements.size(); ++index){
        const PopupToken replacement = replacements[index];
        TooltipState state = TooltipState();
        ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, basePopup, 0u, 0u, true, 0.0f, options));
        ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, basePopup, 0u, 0u, true, 0.5f, options));
        ASSERT_TRUE(state.visible());
        const u64 revision = state.revision();
        ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, replacement, 0u, 0u, true, 100.0f, options));
        EXPECT_FALSE(state.visible());
        EXPECT_GT(state.revision(), revision);
        ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, replacement, 0u, 0u, true, 0.5f, options));
        EXPECT_TRUE(state.visible());
        ASSERT_TRUE(TooltipBehavior::Update(state, anchor, s_UiTooltipDeclaration, basePopup, 0u, 0u, true, 100.0f, options));
        EXPECT_FALSE(state.visible());
    }
}

void VerifyUiTooltipBehaviorTests_FocusLossRetiresHoverEvenWhenPointerAndFocusReturnBeforeTheNextUpdate(){
    TooltipState state = TooltipState();
