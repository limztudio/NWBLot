native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <core/task/gpu/timing_feedback.h>
#include <impl/ecs_render/shared/frame_types.adhd.h>
namespace NWB::Impl{
using RendererTimingPolicy = Core::GpuTaskTimingFeedbackPolicy;
using RendererTimingAction = RendererTaskTimingFeedbackCollectionAction::Enum;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererTaskTimingFeedbackPolicyTransition{
    public RendererTimingPolicy previousPolicy;
    public RendererTimingPolicy requestedPolicy;
    public RendererTimingAction action;

    public RendererTaskTimingFeedbackPolicyTransition(){
        this.previousPolicy = RendererTimingPolicy();
        this.requestedPolicy = RendererTimingPolicy();
        this.action = cast<RendererTimingAction>(0u);
    }

    public RendererTaskTimingFeedbackPolicyTransition(in RendererTimingPolicy previousPolicy, in RendererTimingPolicy requestedPolicy, in RendererTimingAction action){
        this.previousPolicy = previousPolicy;
        this.requestedPolicy = requestedPolicy;
        this.action = action;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

