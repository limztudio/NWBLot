namespace __hidden_meshlet_score_fenv_tests{


TEST(AssetsGraphics, MeshletScoreRetainsOrderingAtFloatPrecisionBoundary){
    const f32 farther = ::NWB::Impl::EvaluateMeshletCandidateScore(1u, 1u, 0.25f, 16777216.0f, 0.0f, 0.0f, false);
    const f32 nearer = ::NWB::Impl::EvaluateMeshletCandidateScore(1u, 1u, 0.25f, 16777215.0f, 0.0f, 0.0f, false);
    EXPECT_LT(farther, nearer);
}


};


