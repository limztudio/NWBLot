#include <impl/ecs_ui/toolkit/text/layout_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<VectorDouble> TryTranslateTextInk(in Point position, in Rect ink){
    const VectorDouble origin = VectorDouble(cast<f64>(position.x), cast<f64>(position.y), 0.0, 0.0) + VectorDouble(cast<f64>(ink.x), cast<f64>(ink.y), 0.0, 0.0);
    const VectorDouble end = origin + VectorDouble(cast<f64>(ink.width), cast<f64>(ink.height), 0.0, 0.0);
    if(!FitsTextCoordinates(VectorDouble(origin.x, origin.y, end.x, end.y)))
        return MakeUnexpected(Failure());
    const VectorSingle rounded(cast<f32>(origin.x), cast<f32>(origin.y), ink.width, ink.height);
    if(!(IsFinite(rounded.x + rounded.z) && IsFinite(rounded.y + rounded.w)))
        return MakeUnexpected(Failure());
    return VectorDouble(rounded);
}

b8 TryIncludeTextInk(in VectorDouble ink, mut VectorDouble inoutBounds, mut b8 inoutHasInk){
    if(ink.z <= 0.0 || ink.w <= 0.0)
        return true;
    if(!inoutHasInk){
        inoutBounds = ink;
        inoutHasInk = true;
        return true;
    }
    const VectorDouble boundsOrigin(inoutBounds.x, inoutBounds.y, inoutBounds.x, inoutBounds.y);
    const VectorDouble inkOrigin(ink.x, ink.y, ink.x, ink.y);
    const VectorDouble origin = Min(boundsOrigin, inkOrigin);
    const VectorDouble boundsEnd = boundsOrigin + VectorDouble(inoutBounds.z, inoutBounds.w, inoutBounds.z, inoutBounds.w);
    const VectorDouble inkEnd = inkOrigin + VectorDouble(ink.z, ink.w, ink.z, ink.w);
    const VectorDouble end = Max(boundsEnd, inkEnd);
    const VectorDouble size = end - origin;
    if(!FitsTextCoordinate(size.x) || !FitsTextCoordinate(size.y))
        return false;
    const VectorSingle rounded(cast<f32>(origin.x), cast<f32>(origin.y), cast<f32>(size.x), cast<f32>(size.y));
    if(!(IsFinite(rounded.x + rounded.z) && IsFinite(rounded.y + rounded.w)))
        return false;
    inoutBounds = VectorDouble(rounded);
    return true;
}

Expected<VectorDouble> TryLoadSdfGlyphSupport(
    in VectorDouble plane,
    in FontAtlasGlyph glyph,
    in u32 pageWidth,
    in u32 pageHeight,
    in u32 channelCount,
    in u32 spreadPixels,
    in Span<u8> pixels,
    in DisplayMetrics display
){
    if(plane.z <= 0.0 || plane.w <= 0.0)
        return plane;
    const VectorDouble glyphExtent(cast<f64>(glyph.width), cast<f64>(glyph.height), cast<f64>(glyph.width), cast<f64>(glyph.height));
    const VectorDouble texelSize = VectorDouble(plane.z, plane.w, plane.z, plane.w) / glyphExtent;
    const VectorDouble pixelScale(cast<f64>(display.pixelScaleX), cast<f64>(display.pixelScaleY), cast<f64>(display.pixelScaleX), cast<f64>(display.pixelScaleY));
    const VectorDouble physicalStep = VectorDouble(1.0) / (texelSize * pixelScale);
    if(!IsFinite(physicalStep.xy))
        return MakeUnexpected(Failure());
    const VectorDouble haloCandidate = Ceil(physicalStep) + VectorDouble(1.0);
    const VectorDouble clampedHalo = Min(VectorDouble(cast<f64>(pageWidth), cast<f64>(pageHeight), cast<f64>(pageWidth), cast<f64>(pageHeight)), haloCandidate);
    const u32 haloX = cast<u32>(clampedHalo.x);
    const u32 haloY = cast<u32>(clampedHalo.y);
    u32 firstX = 0u;
    if(glyph.x > haloX)
        firstX = glyph.x - haloX;
    u32 firstY = 0u;
    if(glyph.y > haloY)
        firstY = glyph.y - haloY;
    const u32 lastX = Min(pageWidth - 1u, glyph.x + glyph.width + haloX);
    const u32 lastY = Min(pageHeight - 1u, glyph.y + glyph.height + haloY);
    const usize stride = cast<usize>(pageWidth);
    const usize channels = cast<usize>(channelCount);
    const usize ch = cast<usize>(glyph.channel);
    i32 gradientX = 0;
    i32 gradientY = 0;
    for(u32 y = firstY; y <= lastY; ++y){
        for(u32 x = firstX; x <= lastX; ++x){
            const i32 value = cast<i32>(pixels[((cast<usize>(y) * stride) + cast<usize>(x)) * channels + ch]);
            if(x != lastX){
                const i32 rightValue = cast<i32>(pixels[((cast<usize>(y) * stride) + cast<usize>(x + 1u)) * channels + ch]);
                gradientX = Max(gradientX, Abs(rightValue - value));
            }
            if(y != lastY){
                const i32 downValue = cast<i32>(pixels[((cast<usize>(y + 1u) * stride) + cast<usize>(x)) * channels + ch]);
                gradientY = Max(gradientY, Abs(downValue - value));
            }
        }
    }
    const VectorDouble weightedGradient = VectorDouble(cast<f64>(gradientX), cast<f64>(gradientY), 0.0, 0.0) * VectorDouble(physicalStep.x, physicalStep.y, 0.0, 0.0);
    const f64 derivative = weightedGradient.x + weightedGradient.y;
    const f64 minimumDerivative = (s_TextSdfMinimumFilterWidth * s_TextSdfEncodedHalfRange) / cast<f64>(spreadPixels);
    const f64 halfWidth = s_TextHalfPixel * Max(derivative, minimumDerivative);
    const VectorDouble zeroVec(0.0);
    const VectorDouble halfPixelVec(s_TextHalfPixel);
    VectorDouble supportMin = glyphExtent;
    VectorDouble supportMax(0.0);
    b8 visible = false;
    for(u32 y = 0u; y <= glyph.height; ++y){
        u32 y0 = 0u;
        if(glyph.y + y != 0u)
            y0 = glyph.y + y - 1u;
        const u32 y1 = Min(pageHeight - 1u, glyph.y + y);
        for(u32 x = 0u; x <= glyph.width; ++x){
            u32 x0 = 0u;
            if(glyph.x + x != 0u)
                x0 = glyph.x + x - 1u;
            const u32 x1 = Min(pageWidth - 1u, glyph.x + x);
            const i32 s00 = cast<i32>(pixels[((cast<usize>(y0) * stride) + cast<usize>(x0)) * channels + ch]);
            const i32 s10 = cast<i32>(pixels[((cast<usize>(y0) * stride) + cast<usize>(x1)) * channels + ch]);
            const i32 s01 = cast<i32>(pixels[((cast<usize>(y1) * stride) + cast<usize>(x0)) * channels + ch]);
            const i32 s11 = cast<i32>(pixels[((cast<usize>(y1) * stride) + cast<usize>(x1)) * channels + ch]);
            const i32 maximum = Max(Max(s00, s10), Max(s01, s11));
            if(cast<f64>(maximum) + halfWidth < s_TextSdfEncodedHalfRange)
                continue;
            const VectorDouble pos(cast<f64>(x), cast<f64>(y), cast<f64>(x), cast<f64>(y));
            const VectorDouble firstCell = Max(zeroVec, pos - halfPixelVec);
            const VectorDouble lastCell = Min(glyphExtent, pos + halfPixelVec);
            supportMin = Min(supportMin, firstCell);
            supportMax = Max(supportMax, lastCell);
            visible = true;
        }
    }
    if(!visible)
        return VectorDouble(0.0, 0.0, 0.0, 0.0);
    const VectorDouble planeOrigin(plane.x, plane.y, plane.x, plane.y);
    const VectorDouble scaledMin = supportMin * texelSize;
    const VectorDouble scaledMax = supportMax * texelSize;
    const VectorDouble minXY = scaledMin + planeOrigin;
    const VectorDouble maxXY = scaledMax + planeOrigin;
    const Expected<Rect> measured = TryMakeMeasuredTextRect(minXY.x, minXY.y, maxXY.x, maxXY.y);
    if(!measured.has_value())
        return MakeUnexpected(Failure());
    return VectorDouble(cast<f64>(measured.value().x), cast<f64>(measured.value().y), cast<f64>(measured.value().width), cast<f64>(measured.value().height));
}


