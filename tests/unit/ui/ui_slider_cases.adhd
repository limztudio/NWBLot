void VerifyUiSliderBuilderTests_DeclarationPublishesItsResultAndOwnedPartsOnlyAfterScopeValidation(mut UiSliderBuilderTests self){
    ASSERT_TRUE(self.declare(1u));
    EXPECT_FALSE(self.m_state.result().valid);
    native(in self){
        EXPECT_EQ(self.target(self.host()), nullptr);
    }
    ASSERT_TRUE(self.finishPanel());
    EXPECT_TRUE(self.m_state.result().valid);
    native(in self){
        EXPECT_EQ(self.target(self.host()), nullptr);
    }
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    native(in self){
        ASSERT_NE(self.target(self.host()), nullptr);
        ASSERT_NE(self.target(self.track()), nullptr);
        ASSERT_NE(self.target(self.thumb()), nullptr);
    }
}

void VerifyUiSliderBuilderTests_FiniteExternalValueOutsideTheRangeIsRetainedWhileItsThumbClampsVisually(mut UiSliderBuilderTests self){
    ASSERT_TRUE(self.m_state.setValue(2.0));
