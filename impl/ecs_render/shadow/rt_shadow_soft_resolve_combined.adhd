#include <impl/ecs_render/shadow/soft_shadow_resolve_dispatch_builder.adhd>
#include <impl/ecs_render/raytrace/raytracing_system.adhd>
#include <impl/ecs_render/kernel/timing_names.adhd>
#include <impl/ecs_render/shadow/slot_selection.adhd>
#include <impl/ecs_render/shadow/rt_shadow_state.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<impl/assets/graphics/shadow/shadow_resolve_binding_slots.h>"), cpp_name("NWB_SHADOW_RESOLVE_GROUP_SIZE")]
extern const u32 s_ShaderShadowResolveGroupSize;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CanRenderSoftShadowTerminalUpsample(
    in b8 pipelineReady,
    in b8 softShadowReady,
    in u32 softShadowSlotMask,
    in u32 opaquePassCount,
    in u32 transparentPassCount,
    in b8 lightingResourcesValid,
    in b8 bindlessValid,
    in b8 baseTargetsReady,
    in b8 transparentReady,
    in b8 softTransparentReady,
    in b8 shadowSoftHalfAReady
){
    if(
        !pipelineReady
        || !softShadowReady
        || softShadowSlotMask == 0u
        || opaquePassCount != 1u
        || transparentPassCount != 1u
        || !lightingResourcesValid
        || !bindlessValid
        || !baseTargetsReady
    )
        return false;
    if(transparentReady && (!softTransparentReady || !shadowSoftHalfAReady))
        return false;
    return true;
}

u32 SelectTerminalUpsampleInputColorSlot(in b8 transparentReady, in u32 halfASlot, in u32 halfBSlot){
    if(transparentReady)
        return halfASlot;
    return halfBSlot;
}

void ResolveSoftShadowCombinedHalfExtentsAndGroups(
    in u32 width,
    in u32 height,
    in u32 receiverFactor,
    in u32 groupSize,
    mut u32 outHalfWidth,
    mut u32 outHalfHeight,
    mut u32 outGroupsX,
    mut u32 outGroupsY
){
    const u32 halfWidth = DivideUp(width, receiverFactor);
    const u32 halfHeight = DivideUp(height, receiverFactor);
    outHalfWidth = halfWidth;
    outHalfHeight = halfHeight;
    outGroupsX = DivideUp(halfWidth, groupSize);
    outGroupsY = DivideUp(halfHeight, groupSize);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 RendererRayTracingSystem::renderSoftShadowCombinedTemporalMerge(mut CommandList commandList, mut DeferredFrameTargets targets){
    in SoftShadowResolveState resolve = this.m_rayTracingState.shadow.m_softShadowResolve;
    if(!CanRunSoftShadowCombinedTemporalMerge(
        resolve.m_combinedTemporal.m_pipeline.valid(),
        this.m_rayTracingState.softShadow.m_softShadowReady,
        this.m_rayTracingState.softShadow.m_softTransparentReady,
        this.m_rayTracingState.softShadow.m_softShadowTemporalReady,
        this.m_rayTracingState.softShadow.m_softTransparentTemporalReady,
        targets.bindless.valid(),
        this.m_rayTracingState.softShadow.m_softShadowSlotMask
    ))
        return false;

    const b8 frontIsA = this.m_rayTracingState.softShadow.m_softShadowHistoryFrontIsA != 0u;
    if(frontIsA){
        commandList.setEnableUavBarriersForTexture(targets.shadowHistB.deref(), true);
        commandList.setEnableUavBarriersForTexture(targets.shadowMomentsB.deref(), true);
        commandList.setEnableUavBarriersForTexture(targets.transparentHistB.deref(), true);
        commandList.setEnableUavBarriersForTexture(targets.transparentMomentsB.deref(), true);
    } else{
        commandList.setEnableUavBarriersForTexture(targets.shadowHistA.deref(), true);
        commandList.setEnableUavBarriersForTexture(targets.shadowMomentsA.deref(), true);
        commandList.setEnableUavBarriersForTexture(targets.transparentHistA.deref(), true);
        commandList.setEnableUavBarriersForTexture(targets.transparentMomentsA.deref(), true);
    }
    commandList.commitBarriers();

    in DeferredBindlessFrameResources bindless = targets.bindless;
    const ShadowCombinedTemporalPushConstants push = MakeShadowCombinedTemporalPushConstants(
        LoadFloat(this.m_rayTracingState.softShadow.m_prevWorldToClip),
        targets.shadowReceiverFactor,
        ResolveSoftShadowLightSlotRangeCount(this.m_rayTracingState.softShadow.m_softShadowSlotMask),
        this.softShadowTemporalHistoryUsable(),
        bindless.shadowSoftGeometry.slot(),
        bindless.shadowSoftGeometryPrev.slot(),
        bindless.gbufferWorldPosition.slot(),
        bindless.shadowSoftHalfA.slot(),
        SelectSoftShadowHistorySlot(frontIsA, bindless.shadowHistA.slot(), bindless.shadowHistB.slot()),
        SelectSoftShadowHistorySlot(frontIsA, bindless.shadowMomentsA.slot(), bindless.shadowMomentsB.slot()),
        SelectSoftShadowHistorySlot(frontIsA, bindless.shadowHistBStorage.slot(), bindless.shadowHistAStorage.slot()),
        SelectSoftShadowHistorySlot(frontIsA, bindless.shadowMomentsBStorage.slot(), bindless.shadowMomentsAStorage.slot()),
        bindless.transparentSoftHalf.slot(),
        SelectSoftShadowHistorySlot(frontIsA, bindless.transparentHistA.slot(), bindless.transparentHistB.slot()),
        SelectSoftShadowHistorySlot(frontIsA, bindless.transparentMomentsA.slot(), bindless.transparentMomentsB.slot()),
        SelectSoftShadowHistorySlot(frontIsA, bindless.transparentHistBStorage.slot(), bindless.transparentHistAStorage.slot()),
        SelectSoftShadowHistorySlot(frontIsA, bindless.transparentMomentsBStorage.slot(), bindless.transparentMomentsAStorage.slot())
    );
    u32 halfWidth = 0u;
    u32 halfHeight = 0u;
    u32 groupsX = 0u;
    u32 groupsY = 0u;
    ResolveSoftShadowCombinedHalfExtentsAndGroups(
        targets.width,
        targets.height,
        targets.shadowReceiverFactor,
        cast<u32>(s_ShadowReprojectMergeGroupSize),
        halfWidth,
        halfHeight,
        groupsX,
        groupsY
    );
    ComputeState state;
    state.setPipeline(resolve.m_combinedTemporal.m_pipeline.deref());
    commandList.setComputeState(state);
    this.m_graphics.getDevice().getDescriptorHeap().bindCompute(commandList, resolve.m_combinedTemporal.m_pipeline.deref());
    commandList.setPushConstants(push);
    GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeShadowCombinedTemporal, this.m_graphics.getDevice(), commandList);

    commandList.dispatch(groupsX, groupsY, 1u);
    this.m_rayTracingState.softShadow.m_transparentShadowSamplingHistory.record(this.m_rayTracingState.softShadow.m_softShadowSlotMask);
    return true;
}

b8 RendererRayTracingSystem::renderSoftShadowCombinedWavelet(mut CommandList commandList, mut DeferredFrameTargets targets){
    in SoftShadowResolveState resolve = this.m_rayTracingState.shadow.m_softShadowResolve;
    const b8 frontIsA = this.m_rayTracingState.softShadow.m_softShadowHistoryFrontIsA != 0u;
    if(
        !CanCombineSoftShadowWavelets(
            resolve.m_combinedUpsample.m_pipeline.valid(),
            resolve.m_combinedWavelet.m_pipeline.valid(),
            this.m_rayTracingState.softShadow.m_softShadowTemporalReady,
            this.m_rayTracingState.softShadow.m_softTransparentTemporalReady,
            s_ShadowWaveletResolvePassCount,
            s_ShadowWaveletTransparentResolvePassCount
        )
        || !this.m_rayTracingState.softShadow.m_softShadowReady || !this.m_rayTracingState.softShadow.m_softTransparentReady
        || !targets.bindless.valid() || this.m_rayTracingState.softShadow.m_softShadowSlotMask == 0u
    )
        return false;

    commandList.setEnableUavBarriersForTexture(targets.shadowSoftHalfB.deref(), true);
    commandList.setEnableUavBarriersForTexture(targets.shadowSoftHalfA.deref(), true);
    commandList.commitBarriers();
    u32 halfWidth = 0u;
    u32 halfHeight = 0u;
    u32 groupsX = 0u;
    u32 groupsY = 0u;
    ResolveSoftShadowCombinedHalfExtentsAndGroups(
        targets.width,
        targets.height,
        cast<u32>(targets.shadowReceiverFactor),
        cast<u32>(s_ShaderShadowResolveGroupSize),
        halfWidth,
        halfHeight,
        groupsX,
        groupsY
    );
    in DeferredBindlessFrameResources bindless = targets.bindless;
    const ShadowCombinedWaveletPushConstants push = MakeShadowCombinedWaveletPushConstants(
        targets.width,
        targets.height,
        halfWidth,
        halfHeight,
        ResolveSoftShadowLightSlotRangeCount(this.m_rayTracingState.softShadow.m_softShadowSlotMask),
        bindless.shadowSoftGeometry.slot(),
        SelectSoftShadowHistorySlot(frontIsA, bindless.transparentHistB.slot(), bindless.transparentHistA.slot()),
        SelectSoftShadowHistorySlot(frontIsA, bindless.transparentMomentsB.slot(), bindless.transparentMomentsA.slot()),
        bindless.shadowSoftHalfAStorage.slot(),
        SelectSoftShadowHistorySlot(frontIsA, bindless.shadowHistB.slot(), bindless.shadowHistA.slot()),
        SelectSoftShadowHistorySlot(frontIsA, bindless.shadowMomentsB.slot(), bindless.shadowMomentsA.slot()),
        bindless.shadowSoftHalfBStorage.slot(),
        targets.shadowReceiverFactor
    );
    ComputeState state;
    state.setPipeline(resolve.m_combinedWavelet.m_pipeline.deref());
    commandList.setComputeState(state);
    this.m_graphics.getDevice().getDescriptorHeap().bindCompute(commandList, resolve.m_combinedWavelet.m_pipeline.deref());
    commandList.setPushConstants(push);
    commandList.dispatch(groupsX, groupsY, 1u);
    return true;
}

b8 RendererRayTracingSystem::renderSoftShadowTerminalUpsample(mut CommandList commandList, mut DeferredFrameTargets targets, in DeferredLightingGraphResources deferredLightingResources, in b8 transparentReady){
    in SoftShadowResolveState resolve = this.m_rayTracingState.shadow.m_softShadowResolve;
    ComputePipelineHandle pipeline = resolve.m_scalar.m_upsample.m_pipeline;
    if(transparentReady)
        pipeline = resolve.m_combinedUpsample.m_pipeline;
    const b8 baseTargetsReady = targets.depth.valid()
        && targets.worldPosition.valid()
        && targets.normal.valid()
        && targets.shadowSoftHalfB.valid()
        && targets.shadowSoftGeometry.valid()
        && targets.shadowVisibility.valid();
    if(!CanRenderSoftShadowTerminalUpsample(
        pipeline.valid(),
        this.m_rayTracingState.softShadow.m_softShadowReady,
        this.m_rayTracingState.softShadow.m_softShadowSlotMask,
        s_ShadowWaveletResolvePassCount,
        s_ShadowWaveletTransparentResolvePassCount,
        deferredLightingResources.valid(),
        targets.bindless.valid(),
        baseTargetsReady,
        transparentReady,
        this.m_rayTracingState.softShadow.m_softTransparentReady,
        targets.shadowSoftHalfA.valid()
    ))
        return false;

    commandList.setEnableUavBarriersForTexture(targets.shadowVisibility.deref(), true);
    commandList.commitBarriers();

    in DeferredBindlessFrameResources bindless = targets.bindless;
    const ShadowResolvePushConstants push = MakeShadowTerminalUpsamplePushConstants(
        targets.width,
        targets.height,
        DivideUp(targets.width, cast<u32>(targets.shadowReceiverFactor)),
        DivideUp(targets.height, cast<u32>(targets.shadowReceiverFactor)),
        ResolveSoftShadowLightSlotRangeCount(this.m_rayTracingState.softShadow.m_softShadowSlotMask),
        bindless.shadowSoftGeometry.slot(),
        bindless.gbufferDepth.slot(),
        bindless.gbufferWorldPosition.slot(),
        bindless.gbufferNormal.slot(),
        SelectTerminalUpsampleInputColorSlot(transparentReady, bindless.shadowSoftHalfA.slot(), bindless.shadowSoftHalfB.slot()),
        bindless.shadowVisibilityStorage.slot(),
        bindless.shadowVisibilityStorage.slot(),
        bindless.sceneShading.slot(),
        bindless.shadowSoftHalfB.slot(),
        targets.shadowReceiverFactor
    );
    ComputeState state;
    state.setPipeline(pipeline.deref());
    commandList.setComputeState(state);
    this.m_graphics.getDevice().getDescriptorHeap().bindCompute(commandList, pipeline.deref());
    commandList.setPushConstants(push);
    commandList.dispatch(DivideUp(targets.width, cast<u32>(s_ShaderShadowResolveGroupSize)), DivideUp(targets.height, cast<u32>(s_ShaderShadowResolveGroupSize)), 1u);
    if(transparentReady && this.m_rayTracingState.softShadow.m_softShadowTemporalReady)
        this.m_rayTracingState.softShadow.m_softShadowTemporalHistoryAdvancePending = true;
    return true;
}


