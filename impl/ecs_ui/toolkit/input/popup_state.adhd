#include <impl/ecs_ui/toolkit/input/target_table.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class InputPopupState : NoCopy{
    public InputPopupState(){
        this.m_popups.reserve(s_InputMaxPopups);
        this.m_stagedPopups.reserve(s_InputMaxPopups);
        this.m_popupDismissals.reserve(s_InputMaxPopups);
    }

    public b8 stage(in Span<PopupScope> scopes){
        return TryStageRouterPopups(scopes, this.m_popups, this.m_stagedPopups);
    }

    public Span<PopupRecord> staged()const{
        return this.m_stagedPopups;
    }

    public Span<PopupRecord> records()const{
        return this.m_popups;
    }

    public b8 canAppendDismissal()const{
        return this.m_popupDismissals.size() != s_InputMaxPopups;
    }

    public b8 apply(in PopupDismissRequest request){
        return ApplyRouterPopupDismissRequest(request, this.m_popups, this.m_popupDismissals);
    }

    public Expected<PopupDismissReason> consumeDismissal(in PopupToken token){
        return TryConsumeRouterPopupDismissal(token, this.m_popupDismissals);
    }

    public b8 dismiss(in PopupDismissReason reason){
        return TryDismissRouterPopup(reason, this.m_popups, this.m_popupDismissals);
    }

    public void close(in PopupToken token){
        CloseRouterPopupSubtree(token, this.m_popups);
    }

    public void fence(in PopupToken token){
        FenceRouterPopup(token, this.m_popups);
    }

    public void cancelFocus(){
        CancelRouterPopupFocus(this.m_popups, this.m_popupDismissals);
    }

    public void reset(){
        ResetRouterPopupState(this.m_popups, this.m_stagedPopups, this.m_popupDismissals);
    }

    public Optional<InputPopupRetirement> retire(mut InputTargetTable targets, in WidgetId id){
        return targets.retirePopup(id, this.m_popups, this.m_popupDismissals);
    }

    public void install(
        in Span<HitTarget> targets,
        in Span<TargetLookup> lookup,
        in b8 windowFocused,
        in u64 focusLossGeneration,
        in u64 expectedFocusLossGeneration,
        mut Vector<CommandSource> commandSources,
        mut WidgetId inOutFocus,
        mut u64 inOutFocusDeclaration,
        mut ControlToken inOutFocusControl
    ){
        InstallRouterPopups(targets, lookup, windowFocused, focusLossGeneration, expectedFocusLossGeneration, this.m_popupDismissals, this.m_stagedPopups, this.m_popups, commandSources, inOutFocus, inOutFocusDeclaration, inOutFocusControl);
    }

    private Vector<PopupRecord> m_popups;
    private Vector<PopupRecord> m_stagedPopups;
    private Vector<PopupDismissal> m_popupDismissals;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

