[cpp_header("<core/perf/timing.h>"), cpp_name("::NWB::Core::Perf::TimingAccumulator")]
extern class TimingAccumulator{
    void clear(...);
    TimingStats lastStats(...)const;
    void publish(...);
    void record(...);
    void setEnabled(...);
};

[cpp_header("<core/perf/timing.h>"), cpp_name("::NWB::Core::Perf::TimingRecorder")]
extern class TimingRecorder{
    void clear(...);
    b8 enabled(...)const;
    void publishFrame(...);
    void recordSample(...);
    Expected<TimingScopeId> registerScope(...);
    TimingScopeId scopeAt(...)const;
    usize scopeCount(...)const;
    Name scopeNameAt(...)const;
    void setEnabled(...);
    TimingStats stats(...)const;
    TimingStats statsAt(...)const;
};

[cpp_header("<core/perf/timing.h>"), cpp_name("::NWB::Core::Perf::TimingScopeId")]
extern class TimingScopeId{
    u32 index;
    u32 generation;
    b8 valid(...)const;
};

[cpp_header("<core/perf/timing.h>"), cpp_name("::NWB::Core::Perf::TimingSink")]
extern class TimingSink{
    b8 enabled()const;
    void publishFrame(in u64 frameIndex);
    void recordSample(in TimingScopeId scope, in f64 seconds, in u64 frameIndex);
    Expected<TimingScopeId> registerScope(in Name scopeName);
};

[cpp_header("<core/perf/timing.h>"), cpp_name("::NWB::Core::Perf::TimingStats")]
extern class TimingStats{
    f64 seconds;
    f64 minSeconds;
    f64 maxSeconds;
    f64 lastSeconds;
    u64 publishFrameIndex;
    u64 firstSampleFrameIndex;
    u64 lastSampleFrameIndex;
    u32 sampleCount;
    b8 valid(...)const;
};

[cpp_header("<core/perf/timing.h>"), cpp_name("::NWB::Core::Perf::TimingView")]
extern class TimingView{
    TimingScopeId scopeAt(...)const;
    usize scopeCount(...)const;
    Name scopeNameAt(...)const;
    TimingStats stats(...)const;
    TimingStats statsAt(...)const;
    b8 valid(...)const;
};


