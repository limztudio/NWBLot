#include "slider_interaction.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SliderState : NoCopy{
    public u64 m_instanceGeneration = AllocateServiceIdentity();
    public u64 m_inputGeneration = AllocateServiceIdentity();
    public u64 m_revision = 1u;
    public u64 m_admissionGeneration = 1u;
    public f64 m_value = 0.0;
    public f64 m_minimum = 0.0;
    public f64 m_maximum = 1.0;
    public f64 m_keyStep = 0.0;
    public f64 m_step = 0.0;
    public SliderOrientation m_orientation = SliderOrientation::Horizontal;
    public SliderPlacement m_admission;
    public InputActionId m_press;
    public SliderResult m_result;
    public SliderPlacement m_placement;
    public b8 m_enabled = true;
    public b8 m_admitted = false;
    public b8 m_pressMoved = false;

    public u64 instanceGeneration()const{
        return this.m_instanceGeneration;
    }

    public u64 inputGeneration()const{
        return this.m_inputGeneration;
    }

    public u64 revision()const{
        return this.m_revision;
    }

    public u64 admissionGeneration()const{
        return this.m_admissionGeneration;
    }

    public f64 value()const{
        return this.m_value;
    }

    public SliderResult result()const{
        return this.m_result;
    }

    public in SliderPlacement placement()const{
        return this.m_placement;
    }

    public ControlToken controlToken()const{
        ControlToken token;
        token.instanceGeneration = this.m_inputGeneration;
        token.contentGeneration = this.m_admissionGeneration;
        token.contentRevision = this.m_instanceGeneration;
        return token;
    }

    public SliderSnapshot snapshot()const{
        SliderSnapshot value;
        value.press = this.m_press;
        value.instanceGeneration = this.m_instanceGeneration;
        value.inputGeneration = this.m_inputGeneration;
        value.revision = this.m_revision;
        value.admissionGeneration = this.m_admissionGeneration;
        value.valueBits = bit_cast<u64>(this.m_value);
        value.pressMoved = this.m_pressMoved;
        return value;
    }

    public b8 matches(in SliderSnapshot value)const{
        return this.snapshot() == value;
    }

    public b8 setValue(in f64 value){
        if(!IsFinite(VectorDouble(value)))
            return false;
        AdvanceNonWrappingRevision(this.m_revision);
        this.m_inputGeneration = AllocateServiceIdentity();
        this.m_value = value;
        this.m_press = InputActionId();
        this.m_pressMoved = false;
        return true;
    }

    public void reset(){
        AdvanceNonWrappingRevision(this.m_revision);
        AdvanceNonWrappingRevision(this.m_admissionGeneration);
        this.m_inputGeneration = AllocateServiceIdentity();
        ResetSliderStateFields(
            this.m_value,
            this.m_minimum,
            this.m_maximum,
            this.m_keyStep,
            this.m_step,
            this.m_orientation,
            this.m_admission,
            this.m_press,
            this.m_result,
            this.m_placement,
            this.m_enabled,
            this.m_admitted,
            this.m_pressMoved
        );
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<SliderGestureOutcome> TrySeekSliderPointerGesture(
    in b8 admitted,
    in f64 stateMin,
    in f64 stateMax,
    in f64 stateKeyStep,
    in f64 stateStep,
    in b8 stateEnabled,
    in SliderOrientation stateOrientation,
    in ControlToken stateToken,
    in SliderPlacement stateAdmission,
    in f64 currentValue,
    in SliderOptions options,
    in PointerGesture gesture,
    mut SliderResult inOutResult
){
    SliderGestureOutcome outcome = SliderGestureOutcome();
    outcome.value = currentValue;
    if(
        !IsValidSliderOptions(options) || !admitted || !IsValidSliderGesture(gesture) || gesture.control != stateToken
        || !SameSliderOptionsValues(stateMin, stateMax, stateKeyStep, stateStep, stateEnabled, stateOrientation, options)
        || !EqualUiRect(gesture.referenceRectangle, stateAdmission.centerTravel)
    )
        return MakeUnexpected(Failure());
    SliderResult accepted = inOutResult;
    accepted.valid = true;
    const f32 travelSpan = ResolveSliderCenterTravelSpan(options.orientation, gesture.referenceRectangle);
    if(!options.enabled || options.minimum == options.maximum || travelSpan <= 0.0f){
        accepted.dragging = false;
        inOutResult = accepted;
        return outcome;
    }
    const Expected<f64> value = TryComputeSliderSeekValue(options, gesture);
    if(!value.has_value())
        return MakeUnexpected(Failure());
    accepted.valueChanged = accepted.valueChanged || bit_cast<u64>(currentValue) != bit_cast<u64>(value.value());
    accepted.dragging = gesture.state == PointerGestureState::Active;
    outcome.value = value.value();
    if(accepted.dragging)
        outcome.press = gesture.id;
    outcome.advanceRevision = true;
    inOutResult = accepted;
    return outcome;
}

Expected<SliderGestureOutcome> TryDragSliderPointerGesture(
    in b8 admitted,
    in f64 stateMin,
    in f64 stateMax,
    in f64 stateKeyStep,
    in f64 stateStep,
    in b8 stateEnabled,
    in SliderOrientation stateOrientation,
    in ControlToken stateToken,
    in SliderPlacement stateAdmission,
    in f64 currentValue,
    in InputActionId currentPress,
    in b8 currentPressMoved,
    in SliderOptions options,
    in PointerGesture gesture,
    mut SliderResult inOutResult
){
    SliderGestureOutcome outcome = SliderGestureOutcome();
    outcome.value = currentValue;
    outcome.press = currentPress;
    outcome.pressMoved = currentPressMoved;
    const f64 baseline = bit_cast<f64>(gesture.value);
    if(
        !IsValidSliderOptions(options) || !admitted || !IsValidSliderGesture(gesture) || gesture.control != stateToken
        || !SameSliderOptionsValues(stateMin, stateMax, stateKeyStep, stateStep, stateEnabled, stateOrientation, options)
        || !EqualUiRect(gesture.referenceRectangle, stateAdmission.travelBounds)
        || gesture.targetRectangle.width != stateAdmission.thumbExtent.x
        || gesture.targetRectangle.height != stateAdmission.thumbExtent.y || !IsFinite(VectorDouble(baseline))
    )
        return MakeUnexpected(Failure());
    SliderResult accepted = inOutResult;
    accepted.valid = true;
    const f64 travel = ResolveSliderDragTravelSpan(options.orientation, gesture.referenceRectangle, gesture.targetRectangle);
    if(!options.enabled || options.minimum == options.maximum || travel <= 0.0){
        accepted.dragging = false;
        inOutResult = accepted;
        return outcome;
    }
    const b8 previouslyMoved = currentPress == gesture.id && currentPressMoved;
    const Expected<SliderDragResult> drag = TryComputeSliderDragValue(currentValue, baseline, options, gesture, previouslyMoved);
    if(!drag.has_value())
        return MakeUnexpected(Failure());
    const f64 value = drag.value().value;
    const b8 moved = drag.value().moved;
    accepted.valueChanged = accepted.valueChanged || bit_cast<u64>(currentValue) != bit_cast<u64>(value);
    accepted.dragging = gesture.state == PointerGestureState::Active;
    outcome.value = value;
    outcome.press = InputActionId();
    if(accepted.dragging)
        outcome.press = gesture.id;
    outcome.pressMoved = accepted.dragging && moved;
    outcome.advanceRevision = true;
    inOutResult = accepted;
    return outcome;
}

Expected<f32> TryResolveSliderTrackContentWidth(in SliderMetrics metrics, in f32 trackMinimumWidth){
    const f64 width = cast<f64>(metrics.padding.left) + cast<f64>(metrics.padding.right) + cast<f64>(metrics.thumbExtent.x) + cast<f64>(trackMinimumWidth);
    if(!IsFinite(VectorDouble(width)) || width > s_UiMaxFloatF64)
        return MakeUnexpected(Failure());
    return Max(metrics.contentSize.x, cast<f32>(width));
}

Expected<f32> TryResolveSliderTrackContentHeight(in SliderMetrics metrics, in f32 trackMinimumHeight){
    const f64 height = cast<f64>(metrics.padding.top) + cast<f64>(metrics.padding.bottom) + cast<f64>(metrics.thumbExtent.y) + cast<f64>(trackMinimumHeight);
    if(!IsFinite(VectorDouble(height)) || height > s_UiMaxFloatF64)
        return MakeUnexpected(Failure());
    return Max(metrics.contentSize.y, cast<f32>(height));
}

b8 IsSliderPlacementInteractive(in SliderOptions options, in SliderPlacement placement){
    return options.enabled
        && options.minimum != options.maximum
        && ResolveSliderCenterTravelSpan(placement.orientation, placement.centerTravel) > 0.0f
        && placement.thumb.width > 0.0f
        && placement.thumb.height > 0.0f
        && placement.clip.width > 0.0f
        && placement.clip.height > 0.0f;
}

Name ResolveSliderThumbPreferredName(in SliderStyle style, in b8 interactive, in b8 pressed, in b8 hover){
    if(!interactive)
        return style.disabled;
    if(pressed)
        return style.pressed;
    if(hover)
        return style.hover;
    return style.normal;
}

void ResetSliderStateFields(
    mut f64 outValue,
    mut f64 outMinimum,
    mut f64 outMaximum,
    mut f64 outKeyStep,
    mut f64 outStep,
    mut SliderOrientation outOrientation,
    mut SliderPlacement outAdmission,
    mut InputActionId outPress,
    mut SliderResult outResult,
    mut SliderPlacement outPlacement,
    mut b8 outEnabled,
    mut b8 outAdmitted,
    mut b8 outPressMoved
){
    outValue = 0.0;
    outMinimum = 0.0;
    outMaximum = 1.0;
    outKeyStep = 0.0;
    outStep = 0.0;
    outOrientation = SliderOrientation::Horizontal;
    outAdmission = SliderPlacement();
    outPress = InputActionId();
    outResult = SliderResult();
    outPlacement = SliderPlacement();
    outEnabled = true;
    outAdmitted = false;
    outPressMoved = false;
}

void CommitSliderAdmissionState(
    in SliderOptions options,
    in SliderPlacement placement,
    mut f64 outMinimum,
    mut f64 outMaximum,
    mut f64 outKeyStep,
    mut f64 outStep,
    mut b8 outEnabled,
    mut SliderOrientation outOrientation,
    mut SliderPlacement outAdmission,
    mut b8 outAdmitted,
    mut InputActionId outPress,
    mut b8 outPressMoved
){
    outMinimum = options.minimum;
    outMaximum = options.maximum;
    outKeyStep = options.keyStep;
    outStep = options.step;
    outEnabled = options.enabled;
    outOrientation = options.orientation;
    outAdmission = placement;
    outAdmitted = true;
    outPress = InputActionId();
    outPressMoved = false;
}

b8 AdmitSliderState(mut SliderState state, in SliderOptions options, in SliderPlacement placement){
    const Expected<b8> changed = TryEvaluateSliderAdmission(state.m_admitted, state.m_minimum, state.m_maximum, state.m_keyStep, state.m_step, state.m_enabled, state.m_orientation, state.m_admission, options, placement);
    if(!changed.has_value())
        return false;
    if(!changed.value())
        return true;
    AdvanceNonWrappingRevision(state.m_revision);
    AdvanceNonWrappingRevision(state.m_admissionGeneration);
    CommitSliderAdmissionState(
        options,
        placement,
        state.m_minimum,
        state.m_maximum,
        state.m_keyStep,
        state.m_step,
        state.m_enabled,
        state.m_orientation,
        state.m_admission,
        state.m_admitted,
        state.m_press,
        state.m_pressMoved
    );
    return true;
}

b8 ApplySliderControlAction(in SliderOptions options, in ControlAction action, mut SliderState state, mut SliderResult result){
    const Expected<SliderActionOutcome> outcome = TryApplySliderControlAction(state.m_admitted, state.m_minimum, state.m_maximum, state.m_keyStep, state.m_step, state.m_enabled, state.m_orientation, state.controlToken(), state.m_value, options, action, result);
    if(!outcome.has_value())
        return false;
    if(outcome.value().advanceRevision){
        AdvanceNonWrappingRevision(state.m_revision);
        state.m_value = outcome.value().value;
    }
    return true;
}

b8 SeekSliderPointerGesture(in SliderOptions options, in PointerGesture gesture, mut SliderState state, mut SliderResult result){
    const Expected<SliderGestureOutcome> outcome = TrySeekSliderPointerGesture(state.m_admitted, state.m_minimum, state.m_maximum, state.m_keyStep, state.m_step, state.m_enabled, state.m_orientation, state.controlToken(), state.m_admission, state.m_value, options, gesture, result);
    if(!outcome.has_value())
        return false;
    if(outcome.value().advanceRevision){
        AdvanceNonWrappingRevision(state.m_revision);
        state.m_value = outcome.value().value;
        state.m_press = outcome.value().press;
        state.m_pressMoved = false;
    }
    return true;
}

b8 DragSliderPointerGesture(in SliderOptions options, in PointerGesture gesture, mut SliderState state, mut SliderResult result){
    const Expected<SliderGestureOutcome> outcome = TryDragSliderPointerGesture(state.m_admitted, state.m_minimum, state.m_maximum, state.m_keyStep, state.m_step, state.m_enabled, state.m_orientation, state.controlToken(), state.m_admission, state.m_value, state.m_press, state.m_pressMoved, options, gesture, result);
    if(!outcome.has_value())
        return false;
    if(outcome.value().advanceRevision){
        AdvanceNonWrappingRevision(state.m_revision);
        state.m_value = outcome.value().value;
        state.m_press = outcome.value().press;
        state.m_pressMoved = outcome.value().pressMoved;
    }
    return true;
}


