const StringView s_ReflectionSpecularParameterPath = "runtime.specular_f0";
const StringView s_ReflectionRoughnessParameterPath = "runtime.perceptual_roughness";
const StringView s_OpticalCsgDenseCase = "optical_csg_dense";
const StringView s_OpticalReferenceCase = "optical_reference";
const StringView s_OpticalGroupEntryCase = "optical_group_entry";
const StringView s_OpticalGroupGapSubUlpCase = "optical_group_gap_sub_ulp";
const StringView s_OpticalGroupGapCase = "optical_group_gap";
const StringView s_OpticalSubUlpCase = "optical_sub_ulp";
const StringView s_OpticalSliverCase = "optical_sliver";
const StringView s_OpticalCsgCavityCase = "optical_csg_cavity";
const StringView s_OpticalCsgOpenTailCase = "optical_csg_open_tail";
const StringView s_OpticalTirCase = "optical_tir";
const StringView s_OpticalInsideCase = "optical_inside";
const StringView s_OpticalPriorityTieBCase = "optical_priority_tie_b";
const StringView s_OpticalPriorityACase = "optical_priority_a";
const StringView s_OpticalMixedCase = "optical_mixed";
const StringView s_OpticalNested3Case = "optical_nested3";
const StringView s_OpticalOverflowCase = "optical_overflow";
const StringView s_OpticalAlphaBeforeCase = "optical_alpha_before";
const StringView s_OpticalDuplicateIdenticalCase = "optical_duplicate_identical";
const StringView s_OpticalDuplicateReverseCase = "optical_duplicate_reverse";
const StringView s_OpticalClearCase = "optical_clear";
const StringView s_OpticalTiltedCase = "optical_tilted";
const StringView s_OpticalMirroredCase = "optical_mirrored";
const StringView s_OpticalUnspecifiedCase = "optical_unspecified";
const StringView s_ReflectionOpticalInterface = "project/shaders/reflection_optical";

const Name s_ReflectionSurfaceInterfaceName = "project/shaders/smoke_surface";
const Name s_ReflectionOpticalInterfaceName = "project/shaders/reflection_optical";
const Name s_ReflectionNameCsgGroupGapSubUlp = "smoke/reflection/csg_group_gap_sub_ulp";
const Name s_ReflectionNameCsgGroupGap = "smoke/reflection/csg_group_gap";
const Name s_ReflectionNameCsgSubUlp = "smoke/reflection/csg_sub_ulp";
const Name s_ReflectionNameCsgSliver = "smoke/reflection/csg_sliver";

const SmokeMeshRef s_ReflectionOpticalPlaneMesh = "project/meshes/shadow_plane";
const SmokeMeshRef s_ReflectionOpticalBoxMesh = "project/meshes/cube_hard_edges";
const SmokeMeshRef s_ReflectionOpticalCsgOpenTailMesh = "project/meshes/reflection_csg_open_tail";
const SmokeMeshRef s_ReflectionOpticalDisconnectedMesh = "project/meshes/reflection_disconnected_boxes";
const SmokeMeshRef s_ReflectionOpticalOverlappingMesh = "project/meshes/reflection_overlapping_boxes";
const SmokeMeshRef s_ReflectionOpticalDenseMesh = "project/meshes/reflection_dense_boxes";
const SmokeMeshRef s_ReflectionOpticalGroupGapMesh = "project/meshes/reflection_group_gap";
const SmokeMeshRef s_ReflectionOpticalGroupGapSubUlpMesh = "project/meshes/reflection_group_gap_sub_ulp";
const SmokeMeshRef s_ReflectionOpticalGroupEntryMesh = "project/meshes/reflection_group_entry";
const SmokeMeshRef s_ReflectionOpticalCsgGroupEntryMesh = "project/meshes/reflection_csg_group_entry";
const SmokeMeshRef s_ReflectionOpticalTorusMesh = "project/meshes/refraction_torus";
const SmokeMeshRef s_ReflectionOpticalPrismMesh = "project/meshes/reflection_tir_prism";
const SmokeMaterialRef s_ReflectionOpticalOpaqueMaterial = "project/smoke/reflection/materials/opaque";
const SmokeMaterialRef s_ReflectionOpticalVolumeMaterial = "project/smoke/reflection/materials/optical_volume";
const SmokeMaterialRef s_ReflectionOpticalPaneMaterial = "project/smoke/reflection/materials/optical_pane";
const f32x4 s_ReflectionOpticalClearTransmission = f32x4(1.0f, 1.0f, 1.0f, 0.0f);
const f32x4 s_ReflectionOpticalTintedTransmission = f32x4(0.55f, 0.8f, 1.0f, 0.0f);


