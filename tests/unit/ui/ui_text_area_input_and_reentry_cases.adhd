void VerifyUiTextAreaLoanTests_IdenticalScrollIntentRetiresAPreparedLoanWithoutChangingNavigation(mut UiTextAreaLoanTests self){
    ASSERT_TRUE(self.acceptBaseline());
    const UiTextAreaAcceptedInput16 before = self.accepted();
    ASSERT_TRUE(self.beginArea(2u));
    ASSERT_TRUE(self.m_builder.textArea(s_UiTextAreaWidgetKey, self.m_model, self.m_state, UiTextAreaLoanOptions()).valid);
    const Point scroll = self.m_state.scroll();
    const u64 revision = self.m_state.revision();
    const EditNavigationSnapshot navigation = self.m_state.navigation().snapshot();
    ASSERT_TRUE(self.m_state.scrollTo(scroll));
    EXPECT_GT(self.m_state.revision(), revision);
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, scroll.x);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, scroll.y);
    EXPECT_TRUE(self.m_state.navigation().matches(navigation));
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_EQ(self.m_host.publishes, 0u);
    self.expectRejected(before);
}

