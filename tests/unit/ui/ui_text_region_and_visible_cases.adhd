const AStringView s_UiTextRegionOrdinaryRowText = "Next";
const AStringView s_UiTextRegionStackedAccentText = "A\xCC\x81\xCC\x81 g\xCC\xA3";
const AStringView s_UiTextRegionMultilineAccentText = "Previous\nA\xCC\x81\xCC\x81 g\xCC\xA3\nNext";
const AStringView s_UiTextRegionPaddedStackedAccentSample = "A\xCC\x81\xCC\x81 g\xCC\xA3 ";
const AStringView s_UiTextRegionCheckboxNormalRegion = "checkbox.normal";
const AStringView s_UiTextRegionButtonNormalRegion = "button.normal";
const AStringView s_UiTextRegionPanelKey = "panel";
const StringView s_UiTextRegionOverflowText = "MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM\nMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM\nMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM";
const AStringView s_UiTextVisibleSampleGlyphText = "A";
const AStringView s_UiTextVisibleWideGlyphText = "W";


