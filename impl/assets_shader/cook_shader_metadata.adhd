Expected<u64> SlangShaderCompiler::ComputeCompilerFingerprint(const Path& temporaryRoot, Core::Alloc::ScratchArena& scratchArena){
    using namespace __hidden_cook_shader_metadata;
    return SlangCompilerFingerprint::Compute(temporaryRoot, scratchArena, s_CommonCompilerArguments, s_SpirvBaselineCapabilities, s_StageMappings);
}

b8 SlangShaderCompiler::CompileVariant(const ShaderCook::ShaderCompilerRequest& request, Core::Alloc::ScratchArena& scratchArena, ShaderCook::CookVector<u8>& outBytecode){
    using namespace __hidden_cook_shader_metadata;

    outBytecode.clear();

    AStringView slangStage;
    AStringView optimizationArgument;
    if(!SlangCompilerRequestValidator{}.validateInputs(
        request.shaderName,
        request.sourcePath.empty(),
        request.outputPath.empty(),
        request.entryPoint,
        request.stage,
        static_cast<u8>(request.optimizationLevel),
        s_StageMappings,
        slangStage,
        optimizationArgument
    ))
        return false;

    const ScratchPath outputParent = request.outputPath.parentPath();
    const auto compilerWorkDirectoryResult = SlangCompilerWorkspace::CreateCompilerWorkDirectory(outputParent.empty() ? ScratchPath(scratchArena, s_CurrentDirectoryPathText) : outputParent, scratchArena);
    if(!compilerWorkDirectoryResult)
        return false;
    const ScratchPath& compilerWorkDirectory = *compilerWorkDirectoryResult;
    SlangCompilerWorkspace::ScopedDirectoryCleanupGuard workDirectoryCleanup(compilerWorkDirectory);
    const ScratchPath diagnosticsPath = compilerWorkDirectory / s_CompilerDiagFileName;
    const ScratchPath compilerOutputPath = compilerWorkDirectory / s_ModuleSpvFileName;
    const ScratchPath compilerOverlayRoot = compilerWorkDirectory / s_SourcesDirName;
    const auto compilerInputs = SlangCompilerWorkspace::PrepareBomStrippedCompilerInputs(request, compilerOverlayRoot, scratchArena);
    if(!compilerInputs)
        return false;
    const ScratchVector<ScratchPath>& compilerIncludeDirectories = compilerInputs->includeDirectories;

    const usize includeDirectoryCount = compilerIncludeDirectories.size();
    const usize defineCount = request.defines.size();
    usize argumentReserve = 0u;
    usize ownedArgumentCount = 0u;
    if(!SlangCompilerRequestValidator{}.argumentCounts(request.shaderName, includeDirectoryCount, defineCount, argumentReserve, ownedArgumentCount))
        return false;

    ScratchVector<AStringView> arguments(scratchArena);
    arguments.reserve(argumentReserve);
    ScratchVector<ScratchString> ownedArguments(scratchArena);
    // Retire nested string allocations before the owner array, independently of STL destruction order.
    ScopeExit retireArguments([&ownedArguments]()noexcept{
        while(!ownedArguments.empty())
            ownedArguments.pop_back();
    });
    // Reserve owners before publishing views so inline string storage cannot move.
    ownedArguments.reserve(ownedArgumentCount);
    arguments.push_back(AStringView(NWB_SLANGC_EXECUTABLE));

    auto sourcePathText = SlangCompilerWorkspace::BuildCompilerPathText(compilerInputs->sourcePath, scratchArena);
    if(!sourcePathText)
        return false;
    ownedArguments.push_back(Move(*sourcePathText));
    arguments.push_back(AStringView(ownedArguments.back()));
    for(const AStringView argument : s_CommonCompilerArguments)
        arguments.push_back(argument);
    if(!optimizationArgument.empty())
        arguments.push_back(optimizationArgument);
    if(request.rayQuery){
        arguments.push_back(s_SlangCapabilityArgument);
        arguments.push_back(ShaderBinaryPayload::s_SpvRayQueryCapabilityText);
    }
    for(const AStringView capability : s_SpirvBaselineCapabilities){
        arguments.push_back(s_SlangCapabilityArgument);
        arguments.push_back(capability);
    }
    arguments.push_back(s_SlangEntryPointArgument);
    arguments.push_back(request.entryPoint);
    arguments.push_back(s_SlangStageArgument);
    arguments.push_back(slangStage);
    for(const ScratchPath& includeDirectory : compilerIncludeDirectories){
        arguments.push_back(s_SlangIncludeArgument);
        auto includeDirectoryText = SlangCompilerWorkspace::BuildCompilerPathText(includeDirectory, scratchArena);
        if(!includeDirectoryText)
            return false;
        ownedArguments.push_back(Move(*includeDirectoryText));
        arguments.push_back(AStringView(ownedArguments.back()));
    }

    for(const ShaderBinaryPayload::ShaderMacroDefinition& define : request.defines){
        auto defineArgument = BuildCompilerDefineArgument(define, request, compilerOverlayRoot, scratchArena);
        if(!defineArgument)
            return false;
        ownedArguments.push_back(Move(*defineArgument));
        arguments.push_back(AStringView(ownedArguments.back()));
    }

    arguments.push_back(s_SlangOutputArgument);
    auto outputPathText = SlangCompilerWorkspace::BuildCompilerPathText(compilerOutputPath, scratchArena);
    if(!outputPathText)
        return false;
    ownedArguments.push_back(Move(*outputPathText));
    arguments.push_back(AStringView(ownedArguments.back()));

    const auto diagnosticsPathText = SlangCompilerWorkspace::BuildCompilerPathText(diagnosticsPath, scratchArena);
    if(!diagnosticsPathText)
        return false;
    const auto exitCode = ::RunProcessRedirectedToFile(scratchArena, arguments, AStringView(*diagnosticsPathText));
    if(!exitCode || *exitCode != 0){
        const TStringView failureStage = exitCode ? FOUNDATION_TEXT("compiler exit code") : FOUNDATION_TEXT("process execution failure");
        const i64 failureCode = exitCode ? static_cast<i64>(*exitCode) : static_cast<i64>(exitCode.error());
        ScratchString diagnostics{scratchArena};
        const auto diagnosticsRead = ReadBinaryFile(diagnosticsPath, diagnostics);
        if(!diagnosticsRead)
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("Shader compile failed for '{}' (variant '{}'): {} {}; diagnostics read '{}' failed: {}:{}"), ConvertString(request.shaderName), ConvertString(request.variantName), failureStage, failureCode, PathToString<tchar>(diagnosticsPath), ConvertString(diagnosticsRead.error().category().name()), diagnosticsRead.error().value());
        else if(!diagnostics.empty())
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("Shader compile failed for '{}' (variant '{}'): {} {} :\n{}"), ConvertString(request.shaderName), ConvertString(request.variantName), failureStage, failureCode, ConvertString(diagnostics));
        else
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("Shader compile failed for '{}' (variant '{}'): {} {}"), ConvertString(request.shaderName), ConvertString(request.variantName), failureStage, failureCode);
        return false;
    }

    ScratchString diagnostics{scratchArena};
    const auto diagnosticsRead = ReadBinaryFile(diagnosticsPath, diagnostics);
    if(!diagnosticsRead){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("ShaderCook: failed to read compiler diagnostics '{}' for '{}' (variant '{}'): {}:{}"), PathToString<tchar>(diagnosticsPath), ConvertString(request.shaderName), ConvertString(request.variantName), ConvertString(diagnosticsRead.error().category().name()), diagnosticsRead.error().value());
        return false;
    }
    if(!ValidateUnexpectedCompilerDiagnosticsEmpty(request.shaderName, request.variantName, AStringView(diagnostics)))
        return false;

    auto readBinaryFileResult = ReadBinaryFile(compilerOutputPath, outBytecode);
    if(!readBinaryFileResult){
        if(readBinaryFileResult.error())
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("Shader compile failed for '{}' (variant '{}') : failed to read output '{}' : {}"), ConvertString(request.shaderName), ConvertString(request.variantName), PathToString<tchar>(compilerOutputPath), ConvertString(readBinaryFileResult.error().message()));
        else
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("Shader compile failed for '{}' (variant '{}') : failed to read output '{}'"), ConvertString(request.shaderName), ConvertString(request.variantName), PathToString<tchar>(compilerOutputPath));
        return false;
    }

    const auto stageName = Name::FromText(request.stage);
    if(!ValidateCompiledShaderStageName(request.shaderName, request.variantName, stageName.has_value())){
        outBytecode.clear();
        return false;
    }
    const Core::ShaderType::Enum shaderType = Core::ShaderStageNames::ShaderTypeFromArchiveStageName(*stageName);
    const auto resolvedEntryPoint = Core::ResolveSpirvEntryPointName(BinaryByteView{ outBytecode.data(), outBytecode.size() }, request.entryPoint, Core::ShaderType::ToMask(shaderType));
    if(!ValidateCompiledSpirvEntryPoint(request.shaderName, request.variantName, resolvedEntryPoint.has_value())){
        outBytecode.clear();
        return false;
    }

    auto renamePathResult = RenamePath(compilerOutputPath, request.outputPath);
    if(!renamePathResult){
        ScratchVector<u8> publishedBytecode(scratchArena);
        if(
            ReadBinaryFile(request.outputPath, publishedBytecode)
            && publishedBytecode.size() == outBytecode.size()
            && FOUNDATION_MEMCMP(publishedBytecode.data(), outBytecode.data(), outBytecode.size()) == 0
            && Core::ResolveSpirvEntryPointName(BinaryByteView{ publishedBytecode.data(), publishedBytecode.size() }, request.entryPoint, Core::ShaderType::ToMask(shaderType))
        )
            return true;
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("ShaderCook: failed to publish verified bytecode cache '{}' : {}"), PathToString<tchar>(request.outputPath), ConvertString(renamePathResult.error().message()));
        outBytecode.clear();
        return false;
    }
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_cook_shader_metadata{

template<typename WithContext>
[[nodiscard]] static b8 ValidateVariantSignature(const AStringView variantSignature, const ShaderCook::CookMap<ShaderCook::CookString, ShaderCook::DefineEntry>& defineValues, Core::Alloc::ScratchArena& scratchArena, WithContext&& withContext){
    using namespace ShaderBinaryPayload;

    if(variantSignature.empty() || (variantSignature == s_ShaderDefaultVariantText && defineValues.empty()))
        return true;
    if(variantSignature == s_ShaderDefaultVariantText || defineValues.empty()){
        b8 isComplete = false;
        return withContext([&](const AStringView contextLabel){ return ValidateVariantSignaturePreamble(contextLabel, variantSignature, defineValues.empty(), isComplete); });
    }

    using ScratchStringSet = ScratchHashSet<AStringView>;
    ScratchStringSet seenDefines{0, Hasher<AStringView>(), EqualTo<AStringView>(), scratchArena};
    seenDefines.reserve(defineValues.size());
    const b8 parsedAssignments = ShaderCook::ParseVariantSignatureAssignments(
        variantSignature,
        [&](const AStringView defineName, const AStringView defineValue) -> b8{
            const auto defineIt = defineValues.find(defineName);
            const b8 defineKnown = defineIt != defineValues.end();
            b8 valueFound = false;
            if(defineKnown){
                for(const ShaderCook::CookString& allowedValue : defineIt.value().values){
                    if(AStringView(allowedValue) == defineValue){
                        valueFound = true;
                        break;
                    }
                }
            }
            const b8 insertedUnique = defineKnown && valueFound && seenDefines.insert(defineName).second;
            if(defineKnown && valueFound && insertedUnique)
                return true;
            return withContext([&](const AStringView contextLabel){ return ValidateVariantSignatureAssignmentStatus(contextLabel, variantSignature, defineName, defineValue, defineKnown, valueFound, insertedUnique); });
        },
        [&](const VariantSignatureSegmentError::Enum error, const AStringView segment){
            withContext([&](const AStringView contextLabel){ ReportVariantSignatureSegmentError(contextLabel, variantSignature, error, segment); });
        });
    if(!parsedAssignments)
        return false;
    if(seenDefines.size() == defineValues.size())
        return true;
    return withContext([&](const AStringView contextLabel){ return ValidateVariantSignatureSeenCount(contextLabel, variantSignature, seenDefines.size(), defineValues.size()); });
}

};

b8 ShaderCook::ValidateVariantSignature(const AStringView contextLabel, const AStringView variantSignature, const CookMap<CookString, DefineEntry>& defineValues, Core::Alloc::ScratchArena& scratchArena){
    return __hidden_cook_shader_metadata::ValidateVariantSignature(variantSignature, defineValues, scratchArena, [contextLabel](auto&& report){ return report(contextLabel); });
}

b8 ShaderCook::ValidateMaterialVariantSignature(const AStringView materialPath, const Name stageName, const AStringView variantSignature, const CookMap<CookString, DefineEntry>& defineValues, Core::Alloc::ScratchArena& scratchArena){
    return __hidden_cook_shader_metadata::ValidateVariantSignature(variantSignature, defineValues, scratchArena, [&](auto&& report){
        const Core::Assets::ScratchString contextLabel = StringFormat(scratchArena, "{} [{}]", materialPath, stageName.resolvedText());
        return report(AStringView(contextLabel));
    });
}


Expected<ShaderCook::ShaderEntry> ShaderCook::parseShaderMeta(const Path& nwbFilePath, const Core::Metascript::Document& doc, Core::Alloc::ScratchArena& scratchArena){
    using namespace ShaderBinaryPayload;

    ShaderEntry entry(m_memoryArena);

    const auto* assetDeclaration = doc.findDeclaration(Core::Assets::s_MetadataAssetVariable);
    if(!assetDeclaration){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("Shader meta '{}': missing asset declaration '{}'"), PathToString<tchar>(nwbFilePath), ConvertString(Core::Assets::s_MetadataAssetVariable));
        return MakeUnexpected(Failure{});
    }
    const AStringView assetTypeText(assetDeclaration->type.data(), assetDeclaration->type.size());
    const Core::ShaderType::Enum shaderType = ShaderAssetTypes::ShaderTypeFromAssetTypeText(assetTypeText);
    if(shaderType == Core::ShaderType::Invalid){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("Shader meta '{}': unsupported shader asset type '{}'"), PathToString<tchar>(nwbFilePath), ConvertString(assetTypeText));
        return MakeUnexpected(Failure{});
    }

    const auto assetValue = Core::Assets::FindMetadataAssetMapValue<Core::Metascript::Document, Core::Metascript::Value>(nwbFilePath, doc, s_ShaderDiagnosticPrefix);
    if(!assetValue)
        return MakeUnexpected(assetValue.error());
    const Core::Metascript::Value& asset = **assetValue;

    auto pairedSource = Core::Assets::ResolvePairedSourcePathFromMetadata(nwbFilePath, m_memoryArena, scratchArena);
    if(!pairedSource)
        return MakeUnexpected(Failure{});
    entry.source = Move(*pairedSource);
    if(!Core::Assets::CheckPairedSourceExtension(nwbFilePath, entry.source, s_SlangSourceExtension, s_ShaderDiagnosticPrefix, scratchArena))
        return MakeUnexpected(Failure{});

    entry.stage = Core::ShaderStageNames::ArchiveStageTextFromShaderType(shaderType);
    if(entry.stage.empty()){
        Core::Assets::ScratchString convertedPath(scratchArena);
        if(!ValidateDerivedShaderStageText(Core::Assets::AssetPathsDetail::NativeTextView(nwbFilePath.native(), convertedPath), entry.stage))
            return MakeUnexpected(Failure{});
    }
    entry.archiveStage = entry.stage;
    if(!Core::Assets::ValidateMetadataAssetFields(nwbFilePath, asset, s_ShaderMetaDiagnosticPrefix, [isMesh = shaderType == Core::ShaderType::MeshStage](const AStringView field)noexcept{
        return IsAllowedShaderMetadataField(field, isMesh);
    }))
        return MakeUnexpected(Failure{});
    if(!Core::Assets::ReadOptionalMetadataBoolField(nwbFilePath, asset, s_ShaderOptionalBoolMetaPrefix, s_ShaderRayQueryField, entry.rayQuery))
        return MakeUnexpected(Failure{});
    const auto optimizationLevelText = Core::Assets::ReadMetadataStringField(nwbFilePath, asset, s_ShaderMetaDiagnosticPrefix, s_ShaderOptimizationLevelField, false);
    if(!optimizationLevelText)
        return MakeUnexpected(Failure{});
    if(optimizationLevelText->present){
        const auto optimizationLevel = TryParseShaderOptimizationLevelText(optimizationLevelText->text);
        if(!optimizationLevel){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("Shader meta '{}': unsupported optimization_level '{}'"), PathToString<tchar>(nwbFilePath), ConvertString(optimizationLevelText->text));
            return MakeUnexpected(Failure{});
        }
        entry.optimizationLevel = *optimizationLevel;
    }
    auto entryPointTextResult = Core::Assets::ReadMetadataStringField(nwbFilePath, asset, s_ShaderMetaDiagnosticPrefix, s_ShaderEntryPointField, false);
    if(!entryPointTextResult)
        return MakeUnexpected(Failure{});
    const AStringView entryPointText = entryPointTextResult->text;
    entry.entryPoint.assign(entryPointText.data(), entryPointText.size());
    if(entry.entryPoint.empty()){
        Core::Assets::ScratchString convertedPath(scratchArena);
        if(!ValidateNonEmptyShaderEntryPoint(Core::Assets::AssetPathsDetail::NativeTextView(nwbFilePath.native(), convertedPath), AStringView(entry.entryPoint)))
            return MakeUnexpected(Failure{});
    }
    if(!Core::Assets::ReadOptionalMetadataBoolField(nwbFilePath, asset, s_ShaderOptionalBoolMetaPrefix, s_ShaderEmitMeshComputeShadowField, entry.emitMeshComputeShadow))
        return MakeUnexpected(Failure{});

    if(const auto* includeRootsVal = asset.findField(s_ShaderIncludeRootsField)){
        if(!includeRootsVal->copyStringList(entry.includeRoots)){
            NWB_LOGGER_ERROR(FOUNDATION_TEXT("Shader meta '{}': include_roots must be a list of strings"), PathToString<tchar>(nwbFilePath));
            return MakeUnexpected(Failure{});
        }
        b8 hasEmptyIncludeRoot = false;
        for(const ShaderCook::CookString& includeRoot : entry.includeRoots){
            if(includeRoot.empty()){
                hasEmptyIncludeRoot = true;
                break;
            }
        }
        if(hasEmptyIncludeRoot){
            Vector<AStringView, Core::Alloc::ScratchArena> includeRootViews(scratchArena);
            includeRootViews.reserve(entry.includeRoots.size());
            for(const ShaderCook::CookString& includeRoot : entry.includeRoots)
                includeRootViews.emplace_back(includeRoot);
            Core::Assets::ScratchString convertedPath(scratchArena);
            if(!ValidateShaderIncludeRoots(Core::Assets::AssetPathsDetail::NativeTextView(nwbFilePath.native(), convertedPath), includeRootViews))
                return MakeUnexpected(Failure{});
        }
    }

    auto defines = __hidden_cook_shader_metadata::ParseDefines(nwbFilePath, asset, m_memoryArena);
    if(!defines)
        return MakeUnexpected(Failure{});
    entry.defineValues = Move(*defines);

    return entry;
}

Expected<ShaderCook::IncludeEntry> ShaderCook::parseIncludeMeta(const Path& nwbFilePath, const Core::Metascript::Document& doc, Core::Alloc::ScratchArena& scratchArena){
    using namespace ShaderBinaryPayload;

    IncludeEntry entry(m_memoryArena);

    const auto* assetDeclaration = doc.findDeclaration(Core::Assets::s_MetadataAssetVariable);
    if(!assetDeclaration){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("Include meta '{}': missing asset declaration '{}'"), PathToString<tchar>(nwbFilePath), ConvertString(Core::Assets::s_MetadataAssetVariable));
        return MakeUnexpected(Failure{});
    }
    const AStringView assetType(assetDeclaration->type.data(), assetDeclaration->type.size());
    if(!IsIncludeShaderAssetType(assetType, s_ShaderAssetTypeInclude))
        return entry;

    auto pairedSource = Core::Assets::ResolvePairedSourcePathFromMetadata(nwbFilePath, m_memoryArena, scratchArena);
    if(!pairedSource)
        return MakeUnexpected(Failure{});
    entry.source = Move(*pairedSource);
    if(!Core::Assets::CheckPairedSourceExtension(nwbFilePath, entry.source, s_SlangIncludeExtension, s_IncludeDiagnosticPrefix, scratchArena))
        return MakeUnexpected(Failure{});

    const auto assetValue = Core::Assets::FindMetadataAssetMapValue<Core::Metascript::Document, Core::Metascript::Value>(nwbFilePath, doc, s_IncludeDiagnosticPrefix);
    if(!assetValue)
        return MakeUnexpected(assetValue.error());
    const Core::Metascript::Value& asset = **assetValue;

    if(!Core::Assets::ValidateMetadataAssetFields(nwbFilePath, asset, s_IncludeMetaDiagnosticPrefix, &IsAllowedIncludeMetadataField))
        return MakeUnexpected(Failure{});
    auto defines = __hidden_cook_shader_metadata::ParseDefines(nwbFilePath, asset, m_memoryArena);
    if(!defines)
        return MakeUnexpected(Failure{});
    entry.defineValues = Move(*defines);

    return entry;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ShaderAssetSerialization::Serialize(const IShader& shader, Core::Assets::AssetBytes& outBinary){
    return ShaderBinaryPayload::SerializeShaderAssetPayload(AStringView(shader.entryPoint()), shader.bytecode(), outBinary);
}


