    f32 depthClearValue;
    GpuCommandIrOpcode opcode;
    GpuClearTextureTaskValueType clearTextureValueType;
    TextureUploadAspect uploadAspect;
    ResourceStates finalState;
    u8 stencilClearValue;
    b8 clearDepth;
    b8 clearStencil;
};

