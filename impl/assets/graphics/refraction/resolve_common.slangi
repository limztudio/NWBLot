#ifndef NWB_GRAPHICS_REFRACTION_RESOLVE_COMMON_SLANGI
#define NWB_GRAPHICS_REFRACTION_RESOLVE_COMMON_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "push_constants.h"
#include "ior.slangi"
#include "../deferred/binding_slots.h"
#include "../deferred/bindless_resources.slangi"
#include "../avboit/constants.h"
#include "../avboit/refraction_identity.slangi"
#include "../common/math.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct NwbRefractionPushConstants{
#define NWB_REFRACTION_SHADER_FIELD(name, defaultValue) uint name;
    NWB_REFRACTION_PUSH_CONSTANTS_FIELDS(NWB_REFRACTION_SHADER_FIELD)
#undef NWB_REFRACTION_SHADER_FIELD
};
[[vk::push_constant]] NwbRefractionPushConstants g_NwbRefractionPush;

// Prefix of the renderer's mesh view CB. The omitted frustum planes are never read by this pass.
struct NwbRefractionView{
    row_major float4x4 worldToClip;
    row_major float4x4 clipToWorld;
    float4 cameraPosition;
};
#pragma warning(push)
#pragma warning(disable: 39001)
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_UNIFORM_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] ConstantBuffer<NwbRefractionView, Std140DataLayout> g_NwbHeapRefractionViews[];
#pragma warning(pop)

#define g_NwbRefractionResources g_NwbHeapDeferredBindlessResources[g_NwbRefractionPush.deferredResourcesHeapSlot]
#define g_NwbRefractionView g_NwbHeapRefractionViews[g_NwbRefractionPush.viewHeapSlot]
#define g_NwbRefractionOutput nwbHeapStorageImage2DFloat4(g_NwbRefractionResources.refractionSlots0.w)
#define g_NwbRefractionTileList g_NwbHeapStorageBuffers[g_NwbRefractionPush.tileListSlot]
#define g_NwbRefractionTileArguments g_NwbHeapStorageBuffers[g_NwbRefractionPush.tileArgumentsSlot]

#ifndef NWB_REFRACTION_DENSE_GRID
#define NWB_REFRACTION_DENSE_GRID 0
#endif

// Separate cooked kernels keep dense mapping independent of compact queue control flow.
// One indirect workgroup resolves one 8x8 tile at full pixel resolution.
// A second dispatch dimension covers target generations with more than 65535 tiles.
bool nwbRefractionResolvePixel(const uint3 groupId, const uint3 groupThreadId, out uint2 pixel){
    pixel = uint2(0u);
#if NWB_REFRACTION_DENSE_GRID
    pixel = groupId.xy * NWB_REFRACTION_GROUP_SIZE + groupThreadId.xy;
#else
    const uint queueIndex = groupId.y * NWB_REFRACTION_MAX_GROUP_COUNT_X + groupId.x;
    if(groupId.y != 0u && queueIndex >= g_NwbRefractionTileArguments.Load(NWB_REFRACTION_TILE_COUNTER_OFFSET))
        return false;
    const uint tilesX = (g_NwbRefractionPush.width + NWB_REFRACTION_GROUP_SIZE - 1u) / NWB_REFRACTION_GROUP_SIZE;
    const uint tile = g_NwbRefractionTileList.Load(queueIndex * NWB_REFRACTION_TILE_WORD_BYTES);
    pixel = uint2(tile % tilesX, tile / tilesX) * NWB_REFRACTION_GROUP_SIZE + groupThreadId.xy;
#endif
    return pixel.x < g_NwbRefractionPush.width && pixel.y < g_NwbRefractionPush.height;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static const float NWB_REFRACTION_MAX_DISTANCE = 10000.0;
static const float NWB_REFRACTION_MIN_DISTANCE = 0.001;
static const float NWB_REFRACTION_MIN_CLIP_W = 1e-6;
static const half NWB_REFRACTION_FRONT_TRANSMITTANCE_MIN = 1e-4h;
static const half NWB_REFRACTION_TINT_MIN = 1e-4h;
static const half NWB_REFRACTION_IOR_MAX = 4.0h;
static const float NWB_REFRACTION_BIAS_DISTANCE_SCALE = 1e-5;
// Association tolerances grow with the entry bias.
static const float NWB_REFRACTION_BIAS_TOLERANCE_SCALE = 8.0;
// A refracted direction with a smaller squared length is a total-internal-reflection miss.
static const float NWB_REFRACTION_DIRECTION_LENGTH_SQUARED_MIN = 0.5;
// Screen continuation marches a fixed number of quadratically spaced steps up to the capped distance.
static const uint NWB_REFRACTION_SCREEN_STEP_COUNT = 24u;
static const float NWB_REFRACTION_SCREEN_MAX_DISTANCE_BIAS_SCALE = 32.0;
static const float NWB_REFRACTION_SCREEN_STEP_TOLERANCE_SCALE = 1.5;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


float3 nwbRefractionReconstruct(const uint2 pixel, const float depth){
    const float2 uv = (float2(pixel) + 0.5) / float2(g_NwbRefractionPush.width, g_NwbRefractionPush.height);
    const float4 world = mul(g_NwbRefractionView.clipToWorld, float4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0));
    return world.xyz / world.w;
}

bool nwbRefractionProject(const float3 world, out uint2 pixel, out float depth){
    pixel = uint2(0u, 0u);
    depth = 1.0;
    const float4 clip = mul(g_NwbRefractionView.worldToClip, float4(world, 1.0));
    if(clip.w <= NWB_REFRACTION_MIN_CLIP_W)
        return false;
    const float3 ndc = clip.xyz / clip.w;
    const float3 uvd = float3(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5, ndc.z);
    if(any(select(uvd < 0.0, bool3(true), uvd >= 1.0)))
        return false;
    pixel = uint2(uvd.xy * float2(g_NwbRefractionPush.width, g_NwbRefractionPush.height));
    depth = uvd.z;
    return true;
}

half3 nwbRefractionOpaqueBackground(const uint2 pixel){
    const int3 texel = int3(pixel, 0);
    const half3 opaque = half3(nwbHeapSampledImage2D(g_NwbRefractionResources.compositeSlots.x).Load(texel).rgb);
    return g_NwbRefractionPush.opaqueReflectionSlot != NWB_DEFERRED_INVALID_HEAP_SLOT ? opaque + half3(nwbHeapSampledImage2D(g_NwbRefractionPush.opaqueReflectionSlot).Load(texel).rgb) : opaque;
}

half3 nwbRefractionCompositeBehindBackground(const int3 texel, const half3 opaque, const half behindExtinction){
    const half3 behind = half3(nwbHeapSampledImage2D(g_NwbRefractionResources.compositeSlots.y).Load(texel).rgb);
    const half frontExtinction = half(nwbHeapSampledImage2D(g_NwbRefractionResources.refractionSlots1.z).Load(texel).r);
    // Transmittances are (0, 1) bounded factors, so half arithmetic is sufficient here.
    const half frontTransmittance = exp(-min(frontExtinction, half(NWB_AVBOIT_EXTINCTION_SATURATION)));
    const half backTransmittance = exp(-min(behindExtinction, half(NWB_AVBOIT_EXTINCTION_SATURATION)));
    // Weights hold prefix transmittance ahead of the primary. Undo it here; compositor applies it once.
    return behind / max(frontTransmittance, half(NWB_REFRACTION_FRONT_TRANSMITTANCE_MIN)) + opaque * backTransmittance;
}

half nwbRefractionFresnelTransmissionFromR0(const half r0, const half cosine){
    const half oneMinusCosine = half(1.0h) - saturate(cosine);
    const half oneMinusCosine2 = oneMinusCosine * oneMinusCosine;
    const half oneMinusCosine5 = oneMinusCosine2 * oneMinusCosine2 * oneMinusCosine;
    return half(1.0h) - (r0 + (half(1.0h) - r0) * oneMinusCosine5);
}

half nwbRefractionFresnelTransmission(const half ior, const half cosine){
    // Schlick reflectance is a (0, 1) bounded factor, so half arithmetic is sufficient here.
    const half ratio = (ior - half(1.0h)) / (ior + half(1.0h));
    return nwbRefractionFresnelTransmissionFromR0(ratio * ratio, cosine);
}

half3 nwbRefractionAttenuation(const half3 tint, const float thickness, const half ior, const half entryCosine, const half exitCosine){
    // Tint/Beer attenuation plus two bounded Fresnel transmissions stay in (0, 1]; half color math is sufficient.
    const half ratio = (ior - half(1.0h)) / (ior + half(1.0h));
    const half r0 = ratio * ratio;
    const half fresnel = nwbRefractionFresnelTransmissionFromR0(r0, entryCosine) * nwbRefractionFresnelTransmissionFromR0(r0, exitCosine);
    return half3(exp(float3(log(clamp(tint, half3(NWB_REFRACTION_TINT_MIN), half3(1.0h)))) * max(thickness, 0.0))) * fresnel;
}

half3 nwbRefractionFallbackAttenuation(const half3 tint, const half ior, const half cosine){
    // Unit-thickness fallback attenuation simplifies exp(log(tint) * 1.0) to clamped tint and squares one Fresnel evaluation.
    const half fresnel = nwbRefractionFresnelTransmission(ior, cosine);
    return clamp(tint, half3(NWB_REFRACTION_TINT_MIN), half3(1.0h)) * (fresnel * fresnel);
}

struct NwbRefractionEntry{
    uint primaryEntityId;
    bool frontBoundary;
    float cameraDistance;
    float3 position;
    float3 incident;
    float3 normal;
    half3 tint;
    // IOR (clamped 1..4) and entry cosine (saturate-bounded (0,1)) feed only the bounded Fresnel/attenuation factors.
    half ior;
    half cosine;
    float bias;
};

bool nwbRefractionLoadEntry(const uint2 pixel, out NwbRefractionEntry entry){
    entry = (NwbRefractionEntry)0;
    const int3 texel = int3(pixel, 0);
    const float depth = nwbHeapSampledImage2D(g_NwbRefractionResources.refractionSlots0.x).Load(texel).r;
    if(depth >= 1.0)
        return false;
    const float4 normalIor = nwbHeapSampledImage2D(g_NwbRefractionResources.refractionSlots0.y).Load(texel);
    if(!nwbRefractionIorEligible(normalIor.w))
        return false;
    const float2 packedIdentity = nwbHeapSampledImage2D(g_NwbRefractionResources.refractionSlots1.w).Load(texel).rg;
    entry.primaryEntityId = nwbAvboitUnpackRefractionEntityId(packedIdentity);
    entry.frontBoundary = nwbAvboitUnpackRefractionFrontBoundary(packedIdentity);
    const half3 tint = half3(nwbHeapSampledImage2D(g_NwbRefractionResources.refractionSlots0.z).Load(texel).rgb);
    entry.position = nwbRefractionReconstruct(pixel, depth);
    const float3 cameraRay = entry.position - g_NwbRefractionView.cameraPosition.xyz;
    entry.cameraDistance = length(cameraRay);
    entry.incident = nwbSafeNormalize(cameraRay, float3(0.0, 0.0, 1.0));
    const float3 rawNormal = nwbSafeNormalize(normalIor.xyz, -entry.incident);
    const float incidentDotNormal = dot(entry.incident, rawNormal);
    entry.normal = select(bool3(incidentDotNormal > 0.0), -rawNormal, rawNormal);
    entry.ior = clamp(half(normalIor.w), half(1.0h), NWB_REFRACTION_IOR_MAX);
    entry.tint = saturate(tint);
    entry.cosine = half(saturate(abs(incidentDotNormal)));
    entry.bias = max(NWB_REFRACTION_MIN_DISTANCE, entry.cameraDistance * NWB_REFRACTION_BIAS_DISTANCE_SCALE);
    // Coverage is intentionally not an optical mask: perfectly clear glass may author zero AVBOIT opacity.
    return true;
}

half3 nwbRefractionBackgroundForEntry(const uint2 pixel, const NwbRefractionEntry entry, const bool includeTransparency = true, const bool requireMatchingPrimary = true){
    const int3 texel = int3(pixel, 0);
    const half3 opaque = nwbRefractionOpaqueBackground(pixel);
    if(!includeTransparency)
        return opaque;
    const half behindExtinction = half(nwbHeapSampledImage2D(g_NwbRefractionResources.compositeSlots.z).Load(texel).r);
    if(behindExtinction <= half(0.0h))
        return opaque;
    // Displaced pixels outside this primary silhouette reuse only the opaque cache so foreground transparent layers are not pulled behind glass.
    if(requireMatchingPrimary){
        if(nwbHeapSampledImage2D(g_NwbRefractionResources.refractionSlots0.x).Load(texel).r >= 1.0)
            return opaque;
        if(nwbAvboitUnpackRefractionEntityId(nwbHeapSampledImage2D(g_NwbRefractionResources.refractionSlots1.w).Load(texel).rg) != entry.primaryEntityId)
            return opaque;
    }
    return nwbRefractionCompositeBehindBackground(texel, opaque, behindExtinction);
}

// Single-boundary screen-space continuation; falls back to straight-through when the depth crossing is far from the ray or offscreen.
bool nwbRefractionScreenBackgroundPixel(const NwbRefractionEntry entry, const float3 direction, out uint2 outSamplePixel){
    outSamplePixel = uint2(0u, 0u);
    uint2 sourcePixel;
    float unusedDepth;
    if(!nwbRefractionProject(entry.position, sourcePixel, unusedDepth))
        return false;
    const float sourceOpaqueDepth = nwbHeapSampledImage2D(g_NwbRefractionResources.gbufferSlots.w).Load(int3(sourcePixel, 0)).r;
    if(sourceOpaqueDepth >= 1.0)
        return false;
    const float3 sourceOpaque = nwbRefractionReconstruct(sourcePixel, sourceOpaqueDepth);
    const float stepScale = min(max(length(sourceOpaque - entry.position) * 2.0, entry.bias * NWB_REFRACTION_SCREEN_MAX_DISTANCE_BIAS_SCALE), NWB_REFRACTION_MAX_DISTANCE) * (1.0 / (float(NWB_REFRACTION_SCREEN_STEP_COUNT) * float(NWB_REFRACTION_SCREEN_STEP_COUNT)));
    const float entryCameraDistance = entry.cameraDistance;
    float previousT = entry.bias;
    for(uint step = 1u; step <= NWB_REFRACTION_SCREEN_STEP_COUNT; ++step){
        const float t = stepScale * float(step * step);
        const float3 sampleWorld = entry.position + direction * t;
        uint2 samplePixel;
        float rayDepth;
        if(!nwbRefractionProject(sampleWorld, samplePixel, rayDepth))
            return false;
        const float sceneDepth = nwbHeapSampledImage2D(g_NwbRefractionResources.gbufferSlots.w).Load(int3(samplePixel, 0)).r;
        if(sceneDepth < 1.0 && rayDepth >= sceneDepth){
            const float3 sceneWorld = nwbRefractionReconstruct(samplePixel, sceneDepth);
            const float3 delta = sceneWorld - entry.position;
            const float alongRay = dot(delta, direction);
            if(alongRay <= entry.bias)
                return false;
            const float tolerance = max(entry.bias * NWB_REFRACTION_BIAS_TOLERANCE_SCALE, (t - previousT) * NWB_REFRACTION_SCREEN_STEP_TOLERANCE_SCALE);
            const float3 perpendicular = delta - direction * alongRay;
            if(dot(perpendicular, perpendicular) >= tolerance * tolerance)
                return false;
            const float3 sceneCameraDelta = sceneWorld - g_NwbRefractionView.cameraPosition.xyz;
            if(dot(sceneCameraDelta, sceneCameraDelta) > entryCameraDistance * entryCameraDistance){
                outSamplePixel = samplePixel;
                return true;
            }
            return false;
        }
        previousT = t;
    }
    return false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


