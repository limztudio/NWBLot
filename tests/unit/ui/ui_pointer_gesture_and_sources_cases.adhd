NWB_ADHD_GTEST_F(UiPointerGestureTests, ActiveUpdateConsumesOnceAndPreservesProgressAcrossCoalescedMoves, VerifyUiPointerGestureTests_ActiveUpdateConsumesOnceAndPreservesProgressAcrossCoalescedMoves)
