////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_AvboitDepthWarpDispatchGroupCountX = 1u;
const u32 s_AvboitIntegrateGroupSizeX = 64u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class AvboitReuseDrawScalarComparisonPolicy{
    public b8 matchesScalarDrawFields(
        in Name leftMeshKey,
        in Name rightMeshKey,
        in u32 leftInstanceIndex,
        in u32 rightInstanceIndex,
        in Name leftMaterial,
        in Name rightMaterial,
        in b8 leftTwoSided,
        in b8 rightTwoSided,
        in Name leftCsgVariant,
        in Name rightCsgVariant,
        in u32 leftMaterialConstantOffset,
        in u32 rightMaterialConstantOffset,
        in u32 leftShadingModelId,
        in u32 rightShadingModelId,
        in b8 leftConeCullScaleSafe,
        in b8 rightConeCullScaleSafe,
        in u32 leftMeshletCount,
        in u32 rightMeshletCount,
        in u32 leftPrimitiveIndexCount,
        in u32 rightPrimitiveIndexCount,
        in b8 leftRuntimeMesh,
        in b8 rightRuntimeMesh,
        in b8 leftDynamicBoundsFresh,
        in b8 rightDynamicBoundsFresh,
        in b8 leftDynamicConesFresh,
        in b8 rightDynamicConesFresh,
        in usize leftEmulationIndexByteOffset,
        in usize rightEmulationIndexByteOffset,
        in b8 leftIndexedOutput,
        in b8 rightIndexedOutput
    )const{
        return leftMeshKey == rightMeshKey
            && leftInstanceIndex == rightInstanceIndex
            && leftMaterial == rightMaterial
            && leftTwoSided == rightTwoSided
            && leftCsgVariant == rightCsgVariant
            && leftMaterialConstantOffset == rightMaterialConstantOffset
            && leftShadingModelId == rightShadingModelId
            && leftConeCullScaleSafe == rightConeCullScaleSafe
            && leftMeshletCount == rightMeshletCount
            && leftPrimitiveIndexCount == rightPrimitiveIndexCount
            && leftRuntimeMesh == rightRuntimeMesh
            && leftDynamicBoundsFresh == rightDynamicBoundsFresh
            && leftDynamicConesFresh == rightDynamicConesFresh
            && leftEmulationIndexByteOffset == rightEmulationIndexByteOffset
            && leftIndexedOutput == rightIndexedOutput;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CanRenderAvboitTransparentCsgIntervals(in b8 hasFramebuffer, in b8 receiverDrawsEmpty, in b8 csgHasWork, in b8 csgResourcesReady, in b8 frameBindingsValid){
    return hasFramebuffer && !receiverDrawsEmpty && csgHasWork && csgResourcesReady && frameBindingsValid;
}

b8 IsEligibleAvboitReuseGroupHeader(
    in b8 passUsesAvboit,
    in b8 regularComputeDrawsEmpty,
    in b8 regularMeshDrawsEmpty,
    in b8 csgDrawsEmpty,
    in b8 csgReceiverSurfaceEmpty,
    in b8 frameBindingsValid,
    in usize instanceBufferCapacity,
    in usize instanceCount
){
    return passUsesAvboit
        && !regularComputeDrawsEmpty
        && regularMeshDrawsEmpty
        && csgDrawsEmpty
        && csgReceiverSurfaceEmpty
        && frameBindingsValid
        && instanceBufferCapacity >= instanceCount;
}

b8 CanMatchAvboitReusableGeometry(in b8 captured, in b8 producerValid, in b8 eligibleGroup, in usize cachedDrawCount, in usize currentDrawCount){
    return captured && producerValid && eligibleGroup && cachedDrawCount == currentDrawCount;
}

void DispatchAvboitCompute(
    in AvboitFrameTargets targets,
    in u32 groupCountX,
    in b8 hdr10OutputActive,
    mut CommandList commandList,
    mut ComputePipeline pipeline,
    mut GpuDescriptorHeap heap
){
    assert(heap.isInitialized());

    ComputeState computeState;
    computeState.setPipeline(pipeline);
    // Low set is push-only; work resources use heap slots.
    commandList.setComputeState(computeState);
    heap.bindCompute(commandList, pipeline);

    const RendererAvboitPushConstants pushConstants = BuildRendererAvboitPushConstants(targets, hdr10OutputActive);
    commandList.setPushConstants(pushConstants);
    commandList.dispatch(groupCountX, 1u, 1u);
}

b8 RendererAvboitSystem::prepareAvboitPassResources(in CsgFrameState csgFrameState, mut DeferredFrameTargets targets){
    mut AvboitFrameTargets avboitTargets = targets.avboit;
    if(!avboitTargets.valid())
        return false;

    const b8 hasTransparentCsgWork = HasTransparentCsgWork(csgFrameState.hasTransparentStaticWork, csgFrameState.hasTransparentSkinnedWork);
    if(hasTransparentCsgWork && !this.m_materialSystem.prepareMaterialPassResources(targets.framebuffer, MaterialPipelinePass::CsgReceiverSurface, true, csgFrameState))
        return false;

    return
        this.m_materialSystem.prepareMaterialPassResources(avboitTargets.lowFramebuffer, MaterialPipelinePass::AvboitOccupancy, true, csgFrameState, avboitTargets)
        && this.m_materialSystem.prepareMaterialPassResources(avboitTargets.lowFramebuffer, MaterialPipelinePass::AvboitExtinction, true, csgFrameState, avboitTargets)
        && this.m_materialSystem.prepareMaterialPassResources(avboitTargets.accumulationFramebuffer, MaterialPipelinePass::AvboitAccumulate, true, csgFrameState, avboitTargets)
        && (!avboitTargets.refractionFramebuffer.valid() || this.m_materialSystem.prepareMaterialPassResources(avboitTargets.refractionFramebuffer, MaterialPipelinePass::AvboitRefractionCapture, true, csgFrameState, avboitTargets))
    ;
}

void RendererAvboitSystem::renderAvboitTransparentCsgIntervals(
    mut CommandList commandList,
    mut DeferredFrameTargets targets,
    in MaterialPassDrawItemsView receiverSurfaceDrawItems,
    in CsgFrameGpuDataView csgFrameData,
    in CsgGraphResourceSnapshot csgResources,
    in MeshFrameBindingSnapshot frameBindings,
    in usize instanceCount,
    in usize materialTypedByteCount,
    in b8 materialGeometryStatesGraphOwned,
    mut Optional<GpuTimingMeasure> intervalTiming
){
    if(!CanRenderAvboitTransparentCsgIntervals(
        targets.framebuffer.valid(),
        receiverSurfaceDrawItems.empty(),
        csgFrameData.hasWork(),
        csgResources.frameReady(csgFrameData),
        frameBindings.bindingValid()
    ))
        return;

    if(intervalTiming.has_value()){
        intervalTiming.value().discardTiming();
        intervalTiming.reset();
    }
    intervalTiming.emplace(this.m_graphics.gpuTiming(), s_TimingScopeTransparentCsgIntervals, this.m_graphics.getDevice(), commandList);

    // The native step only consumes graph-owned data; never rebuild it.
    const b8 drawBuffersReady = frameBindings.frameReady(instanceCount, materialTypedByteCount);
    const b8 receiverSurfaceDrawResourcesReady = this.m_materialSystem.drawRecorder().materialPassDrawResourcesReady(receiverSurfaceDrawItems, frameBindings);
    if(!drawBuffersReady || !receiverSurfaceDrawResourcesReady){
        // Preserve the short interval; drop the unfinished reservation.
        if(!FinishSplitGpuTimingMarker(intervalTiming))
            return;
        intervalTiming.value().finishTiming(commandList);
        intervalTiming.reset();
        return;
    }

    ViewportState viewportState;
    viewportState.addViewport(targets.framebuffer.deref().getFramebufferInfo().getViewport()).addScissorRect(ToCoreRect(csgFrameData.workRegion.resolveRect(targets.width, targets.height)));

    this.m_csgSystem.dispatchCsgIntervalPeels(commandList, targets, csgFrameData, csgResources, frameBindings);

    MaterialPassDrawContext csgReceiverSurfaceDrawContext(
        commandList,
        viewportState,
        frameBindings,
        MaterialPipelinePass::CsgReceiverSurface,
        true,
        materialGeometryStatesGraphOwned,
        false
    );
    csgReceiverSurfaceDrawContext.setFramebuffer(targets.framebuffer).setCsgResources(csgResources);
    this.m_materialSystem.drawRecorder().renderMaterialPassDrawItems(csgReceiverSurfaceDrawContext, receiverSurfaceDrawItems);

    // Span and Combine are separate graph tasks; the aggregate endpoint remains open.
    if(!FinishSplitGpuTimingMarker(intervalTiming))
        return;
    // Close the raster pass even when the span dispatch moved out.
    commandList.endRenderPass();
}

void RendererAvboitSystem::dispatchAvboitDepthWarp(mut CommandList commandList, mut AvboitFrameTargets targets){
    b8 timingRecorded = false;
    this.dispatchAvboitDepthWarp(commandList, targets, s_NoGpuTimingSampleAttribution, timingRecorded);
}

void RendererAvboitSystem::dispatchAvboitDepthWarp(mut CommandList commandList, mut AvboitFrameTargets targets, in GpuTimingSampleAttribution timingAttribution, mut b8 timingRecorded){
    GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeAvboitDepthWarp, this.m_graphics.getDevice(), commandList, timingAttribution);

    timingRecorded = timing.valid();

    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();

    DispatchAvboitCompute(targets, s_AvboitDepthWarpDispatchGroupCountX, this.m_graphics.isHDR10OutputActive(), commandList, this.m_avboitState.m_depthWarpPipeline.deref(), heap);
}

void RendererAvboitSystem::dispatchAvboitIntegration(mut CommandList commandList, mut AvboitFrameTargets targets){
    b8 timingRecorded = false;
    this.dispatchAvboitIntegration(commandList, targets, s_NoGpuTimingSampleAttribution, timingRecorded);
}

void RendererAvboitSystem::dispatchAvboitIntegration(mut CommandList commandList, mut AvboitFrameTargets targets, in GpuTimingSampleAttribution timingAttribution, mut b8 timingRecorded){
    const u32 groupCountX = ComputeAvboitIntegrationDispatchGroups(targets.lowWidth, targets.lowHeight, s_AvboitIntegrateGroupSizeX);
    GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeAvboitIntegration, this.m_graphics.getDevice(), commandList, timingAttribution);

    timingRecorded = timing.valid();

    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();

    DispatchAvboitCompute(targets, groupCountX, this.m_graphics.isHDR10OutputActive(), commandList, this.m_avboitState.m_integratePipeline.deref(), heap);
}

void RendererAvboitSystem::renderAvboitMaterialPass(
    mut CommandList commandList,
    in FramebufferHandle framebuffer,
    in MaterialPipelinePass pass,
    mut AvboitFrameTargets avboitTargets,
    in MaterialPassDrawItemPartitionsView preparedDrawItems,
    in CsgFrameGpuDataView preparedCsgFrameData,
    in CsgGraphResourceSnapshot preparedCsgResources,
    in MeshFrameBindingSnapshot preparedFrameBindings,
    in usize preparedInstanceCount,
    in usize preparedMaterialTypedByteCount,
    in b8 materialFrameStatesGraphOwned,
    in b8 materialGeometryStatesGraphOwned,
    in b8 computeEmulationOutputStatesGraphOwned,
    in b8 csgComputeEmulationOutputStatesGraphOwned,
    in b8 generatedGeometryReused,
    in Optional<mut Optional<GpuTimingMeasure>> computeEmulationTiming
){
    assert(avboitTargets.valid());

    this.m_materialSystem.renderPreparedAvboitMaterialPass(
        commandList,
        framebuffer,
        pass,
        avboitTargets,
        preparedDrawItems,
        preparedCsgFrameData,
        preparedCsgResources,
        preparedFrameBindings,
        preparedInstanceCount,
        preparedMaterialTypedByteCount,
        materialFrameStatesGraphOwned,
        materialGeometryStatesGraphOwned,
        computeEmulationOutputStatesGraphOwned,
        csgComputeEmulationOutputStatesGraphOwned,
        generatedGeometryReused,
        computeEmulationTiming
    );
    commandList.endRenderPass();
}

b8 DrawInputsMatch(in MaterialPassDrawItem left, in MaterialPassDrawItem right){
    const MaterialPassMeshResourceSnapshot leftMesh = left.meshResources;
    const MaterialPassMeshResourceSnapshot rightMesh = right.meshResources;
    if(
        !AvboitReuseDrawScalarComparisonPolicy().matchesScalarDrawFields(
            left.meshKey,
            right.meshKey,
            left.instanceIndex,
            right.instanceIndex,
            left.pipelineKey.material,
            right.pipelineKey.material,
            left.pipelineKey.twoSided,
            right.pipelineKey.twoSided,
            left.pipelineKey.csgEvaluatorVariant,
            right.pipelineKey.csgEvaluatorVariant,
            left.materialConstantByteOffset,
            right.materialConstantByteOffset,
            left.shadingModelId,
            right.shadingModelId,
            left.meshletConeCullScaleSafe,
            right.meshletConeCullScaleSafe,
            leftMesh.meshletCount,
            rightMesh.meshletCount,
            leftMesh.meshletPrimitiveIndexCount,
            rightMesh.meshletPrimitiveIndexCount,
            leftMesh.runtimeMesh,
            rightMesh.runtimeMesh,
            leftMesh.dynamicMeshletBoundsFresh,
            rightMesh.dynamicMeshletBoundsFresh,
            leftMesh.dynamicMeshletConesFresh,
            rightMesh.dynamicMeshletConesFresh,
            leftMesh.emulationIndexByteOffset,
            rightMesh.emulationIndexByteOffset,
            left.pipelineResources.indexedGeometryOutput,
            right.pipelineResources.indexedGeometryOutput
        )
        || leftMesh.emulationVertexBuffer != rightMesh.emulationVertexBuffer
        || leftMesh.emulationVertexHeapHandle != rightMesh.emulationVertexHeapHandle
        || !leftMesh.sourceBuffers.sameBuffers(rightMesh.sourceBuffers)
    )
        return false;
    // The four eligible AVBOIT passes derive equal generation flags from the retained freshness/two-sided/cull inputs.
    for(usize index = 0u; index < leftMesh.geometryHeapHandles.size(); ++index){
        if(leftMesh.geometryHeapHandles[index] != rightMesh.geometryHeapHandles[index])
            return false;
    }
    return true;
}

b8 FrameBindingsMatch(in MeshFrameBindingSnapshot left, in MeshFrameBindingSnapshot right){
    return
        left.instanceBuffer == right.instanceBuffer && left.materialTypedBuffer == right.materialTypedBuffer
        && left.meshView.buffer == right.meshView.buffer && left.meshView.heapHandle == right.meshView.heapHandle
        && left.instanceHeapHandle == right.instanceHeapHandle && left.materialTypedHeapHandle == right.materialTypedHeapHandle
        && left.instanceBufferCapacity == right.instanceBufferCapacity
        && left.materialTypedBufferCapacity == right.materialTypedBufferCapacity
    ;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
b8 EligibleAvboitReuseGroup(in MaterialPassDrawItemPartitionsView draws, in Span<InstanceGpuData> instances, in MeshFrameBindingSnapshot bindings, in MaterialPipelinePass pass){
    if(!IsEligibleAvboitReuseGroupHeader(MaterialPipelinePassUsesRendererAvboit(pass), draws.regular.computeDrawItems.empty(),
        draws.regular.meshDrawItems.empty(), draws.csg.empty(), draws.csgReceiverSurface.empty(), bindings.bindingValid(), bindings.instanceBufferCapacity, instances.size()))
        return false;
    MaterialPassEmulationOutputIndex<MaterialEmulationBufferIdentity> outputs;
    MaterialPassEmulationOutputIndex<u32> slots;
    for(in MaterialPassDrawItem draw : draws.regular.computeDrawItems){
        in MaterialPassMeshResourceSnapshot mesh = draw.meshResources;
        if(draw.pipelineKey.pass != pass || draw.pipelineKey.csgMode != MaterialPipelineCsgMode::None
            || !draw.pipelineResources.sharedGeometryComputeProgram || draw.instanceIndex >= instances.size()
            || !mesh.valid() || !mesh.emulationVertexBuffer.valid() || !mesh.emulationVertexHeapHandle.valid()
            || mesh.emulationVertexHeapHandle.descriptorClass() != GpuDescriptorClass::StorageBuffer
            || !outputs.insert(MaterialEmulationBufferIdentity(mesh.emulationVertexBuffer)) || !slots.insert(mesh.emulationVertexHeapHandle.slot()))
            return false;
    }
    return true;
}

void AvboitGeneratedGeometryReuse::reset(){
    this.m_draws.clear();
    this.m_instances.clear();
    this.m_frameBindings = MeshFrameBindingSnapshot();
    this.m_producer = GpuTaskId();
    this.m_captured = false;
}

b8 AvboitGeneratedGeometryReuse::capture(in MaterialPassDrawItemPartitionsView draws, in Span<InstanceGpuData> instances, in MeshFrameBindingSnapshot frameBindings, in MeshViewGpuData view, in MaterialPipelinePass pass){
    this.reset();
    if(!EligibleAvboitReuseGroup(draws, instances, frameBindings, pass))
        return false;
    this.m_draws.reserve(draws.regular.computeDrawItems.size());
    this.m_instances.reserve(draws.regular.computeDrawItems.size());
    for(in MaterialPassDrawItem draw : draws.regular.computeDrawItems){
        this.m_draws.push_back(draw);
        this.m_instances.push_back(instances[draw.instanceIndex]);
    }
    this.m_frameBindings = frameBindings;
    this.m_viewBytes = bit_cast<Array<u8, s_MeshViewGpuDataBytes>>(view);
    this.m_captured = true;
    return true;
}

b8 AvboitGeneratedGeometryReuse::matches(in MaterialPassDrawItemPartitionsView draws, in Span<InstanceGpuData> instances, in MeshFrameBindingSnapshot frameBindings, in MeshViewGpuData view, in MaterialPipelinePass pass){
    const b8 eligible = this.m_captured && this.m_producer.valid() && EligibleAvboitReuseGroup(draws, instances, frameBindings, pass);
    if(!CanMatchAvboitReusableGeometry(this.m_captured, this.m_producer.valid(), eligible, this.m_draws.size(), draws.regular.computeDrawItems.size())
        || !FrameBindingsMatch(this.m_frameBindings, frameBindings) || this.m_viewBytes != bit_cast<Array<u8, s_MeshViewGpuDataBytes>>(view)){
        this.reset();
        return false;
    }
    for(usize index = 0u; index < this.m_draws.size(); ++index){
        in MaterialPassDrawItem current = draws.regular.computeDrawItems[index];
        if(!DrawInputsMatch(this.m_draws[index], current)
            || bit_cast<Array<u8, s_InstanceGpuDataByteSize>>(this.m_instances[index]) != bit_cast<Array<u8, s_InstanceGpuDataByteSize>>(instances[current.instanceIndex])){
            this.reset();
            return false;
        }
    }
    return true;
}

b8 AvboitGeneratedGeometryReuse::publishProducer(in GpuTaskId task){
    if(!CanPublishAvboitReusableGeometryProducer(this.m_captured, task.valid())){
        this.reset();
        return false;
    }
    this.m_producer = task;
    return true;
}


