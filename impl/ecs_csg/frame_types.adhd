////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_csg/components.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[reflect]
enum<u8> CsgReceiverKind{
    enum Static,
    enum Skinned
}

[reflect]
enum<u8> CsgReceiverPass{
    enum Opaque,
    enum Transparent
}

[reflect]
class CsgReceiverDrawState{
    public u32 firstCutter = 0u;
    public u32 cutterCount = 0u;
    public CsgReceiverKind receiverKind = CsgReceiverKind::Enum::Static;
    public b8 active = false;
    // cutterCount lets render CSG iterate the lookup range directly, skipping receiver/group resolve.
}

[reflect]
class CsgFrameState{
    public u32 receiverCount = 0u;
    public u32 cutterCount = 0u;
    public b8 hasAnyWork = false;
    public b8 hasOpaqueStaticWork = false;
    public b8 hasOpaqueSkinnedWork = false;
    public b8 hasTransparentStaticWork = false;
    public b8 hasTransparentSkinnedWork = false;

    public b8 empty()const{
        return !this.hasAnyWork;
    }
}

[reflect]
class CsgFrameCutterRange{
    public u32 firstCutter = 0u;
    public u32 cutterCount = 0u;
}

[reflect]
class CsgResolvedReceiver{
    public CsgReceiverComponent receiver;
    public CsgReceiverKind receiverKind = CsgReceiverKind::Enum::Static;
}

void AddCsgFrameReceiverWork(
    mut CsgFrameState inOutState,
    in CsgReceiverKind receiverKind,
    in b8 opaqueWork,
    in b8 transparentWork,
    in u32 cutterCount
){
    inOutState.receiverCount = AddSaturating<u32>(inOutState.receiverCount, 1u);
    inOutState.cutterCount = AddSaturating<u32>(inOutState.cutterCount, cutterCount);

    if(receiverKind == CsgReceiverKind::Enum::Static){
        inOutState.hasOpaqueStaticWork = inOutState.hasOpaqueStaticWork || opaqueWork;
        inOutState.hasTransparentStaticWork = inOutState.hasTransparentStaticWork || transparentWork;
    }
    else{
        inOutState.hasOpaqueSkinnedWork = inOutState.hasOpaqueSkinnedWork || opaqueWork;
        inOutState.hasTransparentSkinnedWork = inOutState.hasTransparentSkinnedWork || transparentWork;
    }
}

void FinalizeCsgFrameState(mut CsgFrameState inOutState){
    inOutState.hasAnyWork =
        inOutState.hasOpaqueStaticWork
        || inOutState.hasOpaqueSkinnedWork
        || inOutState.hasTransparentStaticWork
        || inOutState.hasTransparentSkinnedWork;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
