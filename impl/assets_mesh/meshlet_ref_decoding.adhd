#include <core/alloc/scratch.h>

namespace NWB::Impl{
using ScratchMeshletU32Vector = Vector<u32, Core::Alloc::ScratchArena>;
using ScratchMeshletAttribGpuVector = Vector<AttribGpu, Core::Alloc::ScratchArena>;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<usize> TryComputeMeshletRefDeltaByteCount(in u32 refCount, in MeshletRefDeltaWidth width){
    if(!MeshletRefDeltaWidthValid(width))
        return MakeUnexpected(Failure());

    const usize byteWidth = cast<usize>(MeshletRefDeltaByteWidth(width));
    if(cast<usize>(refCount) > 0xffffffffffffffffu / byteWidth)
        return MakeUnexpected(Failure());

    return cast<usize>(refCount) * byteWidth;
}

b8 AddMeshletRefDeltaByteCount(in u32 refCount, in MeshletRefDeltaWidth width, mut usize inOutByteCount){
    const Expected<usize> channelBytes = TryComputeMeshletRefDeltaByteCount(refCount, width);
    if(!channelBytes.has_value())
        return false;
    if(channelBytes.value() > 0xffffffffffffffffu - inOutByteCount)
        return false;

    inOutByteCount += channelBytes.value();
    return true;
}

Expected<usize> TryAddMeshletRefLayoutChannel(in usize baseOffset, in u32 refCount, in MeshletRefDeltaWidth width, mut usize inOutRelativeOffset){
    if(baseOffset > 0xffffffffffffffffu - inOutRelativeOffset)
        return MakeUnexpected(Failure());

    const usize channelByteOffset = baseOffset + inOutRelativeOffset;
    if(!AddMeshletRefDeltaByteCount(refCount, width, inOutRelativeOffset))
        return MakeUnexpected(Failure());
    return channelByteOffset;
}

Expected<MeshletPositionRefEncodingLayout> TryBuildMeshletPositionRefEncodingLayout(in MeshletDesc meshlet, in b8 skinRequired){
    MeshletPositionRefEncodingLayout layout;
    const u32 positionCount = MeshletPositionCount(meshlet);
    layout.positionWidth = MeshletRefEncodingWidth(meshlet.encoding, s_MeshletRefEncodingPositionShift);
    layout.skinWidth = MeshletRefEncodingWidth(meshlet.encoding, s_MeshletRefEncodingSkinShift);
    const Expected<usize> positionOffset = TryAddMeshletRefLayoutChannel(cast<usize>(meshlet.positionRefOffset), positionCount, layout.positionWidth, layout.byteCount);
    if(!positionOffset.has_value())
        return MakeUnexpected(Failure());
    layout.positionByteOffset = positionOffset.value();
    if(!skinRequired)
        return layout;
    const Expected<usize> skinOffset = TryAddMeshletRefLayoutChannel(cast<usize>(meshlet.positionRefOffset), positionCount, layout.skinWidth, layout.byteCount);
    if(!skinOffset.has_value())
        return MakeUnexpected(Failure());
    layout.skinByteOffset = skinOffset.value();
    return layout;
}

Expected<MeshletAttributeRefEncodingLayout> TryBuildMeshletAttributeRefEncodingLayout(in MeshletDesc meshlet){
    MeshletAttributeRefEncodingLayout layout;
    const u32 attributeCount = MeshletAttributeCount(meshlet);
    layout.normalWidth = MeshletRefEncodingWidth(meshlet.encoding, s_MeshletRefEncodingNormalShift);
    layout.tangentWidth = MeshletRefEncodingWidth(meshlet.encoding, s_MeshletRefEncodingTangentShift);
    layout.uv0Width = MeshletRefEncodingWidth(meshlet.encoding, s_MeshletRefEncodingUv0Shift);
    layout.colorWidth = MeshletRefEncodingWidth(meshlet.encoding, s_MeshletRefEncodingColorShift);
    const Expected<usize> normalOffset = TryAddMeshletRefLayoutChannel(cast<usize>(meshlet.attributeRefOffset), attributeCount, layout.normalWidth, layout.byteCount);
    if(!normalOffset.has_value())
        return MakeUnexpected(Failure());
    layout.normalByteOffset = normalOffset.value();
    const Expected<usize> tangentOffset = TryAddMeshletRefLayoutChannel(cast<usize>(meshlet.attributeRefOffset), attributeCount, layout.tangentWidth, layout.byteCount);
    if(!tangentOffset.has_value())
        return MakeUnexpected(Failure());
    layout.tangentByteOffset = tangentOffset.value();
    const Expected<usize> uv0Offset = TryAddMeshletRefLayoutChannel(cast<usize>(meshlet.attributeRefOffset), attributeCount, layout.uv0Width, layout.byteCount);
    if(!uv0Offset.has_value())
        return MakeUnexpected(Failure());
    layout.uv0ByteOffset = uv0Offset.value();
    const Expected<usize> colorOffset = TryAddMeshletRefLayoutChannel(cast<usize>(meshlet.attributeRefOffset), attributeCount, layout.colorWidth, layout.byteCount);
    if(!colorOffset.has_value())
        return MakeUnexpected(Failure());
    layout.colorByteOffset = colorOffset.value();
    return layout;
}

Expected<usize> TryComputeMeshletEncodedPositionRefByteCount(in MeshletDesc meshlet, in b8 skinRequired){
    const Expected<MeshletPositionRefEncodingLayout> layout = TryBuildMeshletPositionRefEncodingLayout(meshlet, skinRequired);
    if(!layout.has_value())
        return MakeUnexpected(Failure());

    return layout.value().byteCount;
}

Expected<usize> TryComputeMeshletEncodedAttributeRefByteCount(in MeshletDesc meshlet){
    const Expected<MeshletAttributeRefEncodingLayout> layout = TryBuildMeshletAttributeRefEncodingLayout(meshlet);
    if(!layout.has_value())
        return MakeUnexpected(Failure());

    return layout.value().byteCount;
}

Expected<u32> TryDecodeMeshletRefDelta(in Span<u8> bytes, in usize byteOffset, in MeshletRefDeltaWidth width){
    if(!MeshletRefDeltaWidthValid(width))
        return MakeUnexpected(Failure());

    const usize byteCount = bytes.size();
    const usize byteWidth = cast<usize>(MeshletRefDeltaByteWidth(width));
    if(byteOffset > byteCount || byteWidth > byteCount - byteOffset)
        return MakeUnexpected(Failure());

    u32 delta = cast<u32>(bytes[byteOffset]);
    if(width == MeshletRefDeltaWidth::U8)
        return delta;

    delta |= cast<u32>(bytes[byteOffset + 1u]) << s_MeshletPackedByteBits;
    if(width == MeshletRefDeltaWidth::U16)
        return delta;

    delta |= cast<u32>(bytes[byteOffset + 2u]) << s_MeshletPackedByte2Shift;
    delta |= cast<u32>(bytes[byteOffset + 3u]) << s_MeshletPackedByte3Shift;
    return delta;
}

Expected<u32> TryDecodeMeshletRefDeltaAtIndex(in Span<u8> bytes, in usize channelByteOffset, in u32 localIndex, in MeshletRefDeltaWidth width){
    return TryDecodeMeshletRefDelta(bytes, channelByteOffset + cast<usize>(localIndex) * cast<usize>(MeshletRefDeltaByteWidth(width)), width);
}

Expected<u32> TryDecodeMeshletRefChannelValue(in Span<u8> bytes, in usize channelByteOffset, in MeshletRefDeltaWidth width, in u32 base, in u32 localIndex){
    const Expected<u32> delta = TryDecodeMeshletRefDeltaAtIndex(bytes, channelByteOffset, localIndex, width);
    if(!delta.has_value() || delta.value() > 0xffffffffu - base)
        return MakeUnexpected(Failure());

    return base + delta.value();
}

Expected<MeshletPositionStreamRef> TryDecodeMeshletPositionRef(in Span<u8> bytes, in MeshletDesc meshlet, in u32 localPositionIndex, in b8 skinRequired){
    MeshletPositionStreamRef refValue;
    const u32 positionCount = MeshletPositionCount(meshlet);
    if(localPositionIndex >= positionCount)
        return MakeUnexpected(Failure());

    const Expected<MeshletPositionRefEncodingLayout> layout = TryBuildMeshletPositionRefEncodingLayout(meshlet, skinRequired);
    if(!layout.has_value())
        return MakeUnexpected(Failure());

    const Expected<u32> position = TryDecodeMeshletRefChannelValue(bytes, layout.value().positionByteOffset, layout.value().positionWidth, meshlet.positionBase, localPositionIndex);
    if(!position.has_value())
        return MakeUnexpected(Failure());
    refValue.position = position.value();

    if(!skinRequired){
        if(meshlet.skinBase != s_MeshMissingStreamIndex)
            return MakeUnexpected(Failure());
        return refValue;
    }

    const Expected<u32> skin = TryDecodeMeshletRefChannelValue(bytes, layout.value().skinByteOffset, layout.value().skinWidth, meshlet.skinBase, localPositionIndex);
    if(!skin.has_value())
        return MakeUnexpected(Failure());
    refValue.skin = skin.value();
    return refValue;
}

Expected<MeshletAttributeStreamRef> TryDecodeMeshletAttributeRef(in Span<u8> bytes, in MeshletDesc meshlet, in u32 localAttributeIndex){
    MeshletAttributeStreamRef refValue;
    const u32 attributeCount = MeshletAttributeCount(meshlet);
    if(localAttributeIndex >= attributeCount)
        return MakeUnexpected(Failure());

    const Expected<MeshletAttributeRefEncodingLayout> layout = TryBuildMeshletAttributeRefEncodingLayout(meshlet);
    if(!layout.has_value())
        return MakeUnexpected(Failure());

    const Expected<u32> normal = TryDecodeMeshletRefChannelValue(bytes, layout.value().normalByteOffset, layout.value().normalWidth, meshlet.normalBase, localAttributeIndex);
    if(!normal.has_value())
        return MakeUnexpected(Failure());
    refValue.normal = normal.value();
    const Expected<u32> tangent = TryDecodeMeshletRefChannelValue(bytes, layout.value().tangentByteOffset, layout.value().tangentWidth, meshlet.tangentBase, localAttributeIndex);
    if(!tangent.has_value())
        return MakeUnexpected(Failure());
    refValue.tangent = tangent.value();
    const Expected<u32> uv0 = TryDecodeMeshletRefChannelValue(bytes, layout.value().uv0ByteOffset, layout.value().uv0Width, meshlet.uv0Base, localAttributeIndex);
    if(!uv0.has_value())
        return MakeUnexpected(Failure());
    refValue.uv0 = uv0.value();
    const Expected<u32> color = TryDecodeMeshletRefChannelValue(bytes, layout.value().colorByteOffset, layout.value().colorWidth, meshlet.colorBase, localAttributeIndex);
    if(!color.has_value())
        return MakeUnexpected(Failure());
    refValue.color = color.value();

    return refValue;
}

b8 TryDecodeMeshletTriangleCornerPosition(
    in Span<u8> positionRefDeltas,
    in MeshletDesc meshlet,
    in MeshletLocalVertexRef localRef,
    in usize positionCount,
    mut u32 outValue
){
    const b8 skinRequired = meshlet.skinBase != s_MeshMissingStreamIndex;
    const Expected<MeshletPositionStreamRef> positionRef = TryDecodeMeshletPositionRef(positionRefDeltas, meshlet, cast<u32>(localRef.localDeformedPosition), skinRequired);
    if(!positionRef.has_value() || cast<usize>(positionRef.value().position) >= positionCount)
        return false;
    outValue = positionRef.value().position;
    return true;
}

b8 TryDecodeMeshletTriangleCornerAttribute(
    in Span<u8> attributeRefDeltas,
    in MeshletDesc meshlet,
    in MeshletLocalVertexRef localRef,
    in Span<f16x4u> normalStream,
    in Span<f32x2u> uv0Stream,
    mut AttribGpu outAttribute
){
    const Expected<MeshletAttributeStreamRef> attributeRef = TryDecodeMeshletAttributeRef(attributeRefDeltas, meshlet, cast<u32>(localRef.localAttribute));
    if(!attributeRef.has_value() || cast<usize>(attributeRef.value().normal) >= normalStream.size() || cast<usize>(attributeRef.value().uv0) >= uv0Stream.size())
        return false;
    outAttribute.normal = normalStream[cast<usize>(attributeRef.value().normal)];
    outAttribute.uv0 = uv0Stream[cast<usize>(attributeRef.value().uv0)];
    return true;
}

b8 DecodeMeshletTriangleIndicesInto(
    in Span<MeshletDesc> meshlets,
    in Span<MeshletLocalVertexRef> localVertexRefs,
    in Span<u8> positionRefDeltas,
    in Span<u8> primitiveIndices,
    in usize positionCount,
    mut ScratchMeshletU32Vector outIndices
){
    const usize localVertexRefCount = localVertexRefs.size();
    const usize primitiveIndexCount = primitiveIndices.size();

    for(usize meshletIndex = 0u; meshletIndex < meshlets.size(); ++meshletIndex){
        const MeshletDesc meshlet = meshlets[meshletIndex];
        const u32 primitiveCount = MeshletPrimitiveCount(meshlet);

        for(u32 primitive = 0u; primitive < primitiveCount; ++primitive){
            const usize primitiveBase = cast<usize>(meshlet.primitiveOffset) + cast<usize>(primitive) * cast<usize>(s_MeshletTriangleIndexCount);

            for(u32 corner = 0u; corner < s_MeshletTriangleIndexCount; ++corner){
                const usize primitiveByte = primitiveBase + cast<usize>(corner);
                if(primitiveByte >= primitiveIndexCount)
                    return false;

                const u32 localVertexIndex = cast<u32>(primitiveIndices[primitiveByte]);
                const usize localVertexRefIndex = cast<usize>(meshlet.localVertexOffset) + cast<usize>(localVertexIndex);
                if(localVertexRefIndex >= localVertexRefCount)
                    return false;

                u32 decodedIndex = 0u;
                if(!TryDecodeMeshletTriangleCornerPosition(positionRefDeltas, meshlet, localVertexRefs[localVertexRefIndex], positionCount, decodedIndex))
                    return false;
                outIndices[primitiveByte] = decodedIndex;
            }
        }
    }

    return true;
}

b8 DecodeMeshletTriangleAttributesInto(
    in Span<MeshletDesc> meshlets,
    in Span<MeshletLocalVertexRef> localVertexRefs,
    in Span<u8> attributeRefDeltas,
    in Span<u8> primitiveIndices,
    in Span<f16x4u> normalStream,
    in Span<f32x2u> uv0Stream,
    mut ScratchMeshletAttribGpuVector outAttributes
){
    const usize localVertexRefCount = localVertexRefs.size();
    const usize primitiveIndexCount = primitiveIndices.size();

    for(usize meshletIndex = 0u; meshletIndex < meshlets.size(); ++meshletIndex){
        const MeshletDesc meshlet = meshlets[meshletIndex];
        const u32 primitiveCount = MeshletPrimitiveCount(meshlet);

        for(u32 primitive = 0u; primitive < primitiveCount; ++primitive){
            const usize primitiveBase = cast<usize>(meshlet.primitiveOffset) + cast<usize>(primitive) * cast<usize>(s_MeshletTriangleIndexCount);

            for(u32 corner = 0u; corner < s_MeshletTriangleIndexCount; ++corner){
                const usize primitiveByte = primitiveBase + cast<usize>(corner);
                if(primitiveByte >= primitiveIndexCount)
                    return false;

                const u32 localVertexIndex = cast<u32>(primitiveIndices[primitiveByte]);
                const usize localVertexRefIndex = cast<usize>(meshlet.localVertexOffset) + cast<usize>(localVertexIndex);
                if(localVertexRefIndex >= localVertexRefCount)
                    return false;

                AttribGpu decodedAttribute;
                if(!TryDecodeMeshletTriangleCornerAttribute(attributeRefDeltas, meshlet, localVertexRefs[localVertexRefIndex], normalStream, uv0Stream, decodedAttribute))
                    return false;
                outAttributes[primitiveByte] = decodedAttribute;
            }
        }
    }

    return true;
}


