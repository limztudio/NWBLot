void VerifyMultilineCompositionTests_PreeditKeepsOriginalByteOffsetsAcrossLinesAndCombiningScalars(mut MultilineCompositionTests self){
    ASSERT_TRUE(self.m_model.setText("ab\ncd\nef"));
    ASSERT_TRUE(self.m_model.setSelection(5u, 1u));
    const u64 revision = self.m_model.revision();
    const u64 selection = self.m_model.selectionGeneration();
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("a\xCC\x81\n\xE1\x84\x80\xE1\x85\xA1", 1u, 7u));
    const EditCompositionView composition = self.m_model.composition();
    EXPECT_EQ(composition.text, "a\xCC\x81\n\xE1\x84\x80\xE1\x85\xA1");
    EXPECT_EQ(composition.anchor, 1u);
    EXPECT_EQ(composition.caret, 7u);
    EXPECT_EQ(composition.replacementStart, 1u);
    EXPECT_EQ(composition.replacementEnd, 5u);
    EXPECT_EQ(self.m_model.text(), "ab\ncd\nef");
    EXPECT_EQ(self.m_model.anchor(), 5u);
    EXPECT_EQ(self.m_model.caret(), 1u);
    EXPECT_EQ(self.m_model.revision(), revision);
    EXPECT_EQ(self.m_model.selectionGeneration(), selection);
    EXPECT_FALSE(self.m_model.canUndo());
}

void VerifyMultilineCompositionTests_PreeditAndCommitRejectNoncanonicalBytesWithoutNormalizingOffsets(mut MultilineCompositionTests self){
    ASSERT_TRUE(self.m_model.setText("a\nb"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 2u));
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("x\ny", 2u, 3u));
    const MultilineSnapshot before = MultilineSnapshot(self.m_arena, self.m_model);
    Array<StringView, 7u> invalid = Array<StringView, 7u>();
    invalid[0u] = "x\r\ny";
    invalid[1u] = "x\ty";
    invalid[2u] = "\xC2\x85";
    invalid[3u] = "\xE2\x80\xA8";
    invalid[4u] = "\xE2\x80\xA9";
    invalid[5u] = "\xED\xA0\x80";
    invalid[6u] = MakeUiMultilineEmbeddedNulXY();
    for(in StringView text : invalid){
        EXPECT_FALSE(self.m_model.updateComposition(text, 0u, text.size()));
        EXPECT_FALSE(self.m_model.commitComposition(text));
        before.expectUnchanged(self.m_model);
    }
    EXPECT_FALSE(self.m_model.updateComposition("a\xCC\x81\nz", 2u, 5u));
    before.expectUnchanged(self.m_model);
}

void VerifyMultilineCompositionTests_OverCapacityPreeditAndCommitPreserveEveryModelField(mut MultilineCompositionTests self){
    EditModel limited = EditModel(self.m_arena, MakeUiMultilineLimits(6u, 8u, 128u), EditTextMode::Multiline);
    ASSERT_TRUE(limited.setText("a\nb"));
    ASSERT_TRUE(limited.setSelection(1u, 2u));
    ASSERT_TRUE(limited.beginComposition());
    ASSERT_TRUE(limited.updateComposition("x", 0u, 1u));
    const MultilineSnapshot before = MultilineSnapshot(self.m_arena, limited);
    EXPECT_FALSE(limited.updateComposition("12\n34", 0u, 5u));
    EXPECT_FALSE(limited.commitComposition("12\n34"));
    before.expectUnchanged(limited);
}

void VerifyMultilineCompositionTests_CancellationPreservesCommittedSelectionEpochTextAndHistory(mut MultilineCompositionTests self){
    ASSERT_TRUE(self.m_model.setText("a\nb"));
    ASSERT_TRUE(self.m_model.replaceSelection("c"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 3u));
    const u64 selection = self.m_model.selectionGeneration();
    const u64 revision = self.m_model.revision();
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("x\ny", 0u, 3u));
    const u64 composition = self.m_model.compositionGeneration();
    self.m_model.cancelComposition();
    EXPECT_GT(self.m_model.compositionGeneration(), composition);
    EXPECT_EQ(self.m_model.selectionGeneration(), selection);
    EXPECT_EQ(self.m_model.revision(), revision);
    EXPECT_EQ(self.m_model.text(), "a\nbc");
    EXPECT_EQ(self.m_model.anchor(), 1u);
    EXPECT_EQ(self.m_model.caret(), 3u);
    EXPECT_FALSE(self.m_model.composition().active);
    EXPECT_TRUE(self.m_model.canUndo());
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "a\nb");
}

void VerifyMultilineCompositionTests_AliasedCompositionCommitOwnsBytesBeforeRetiringPreedit(mut MultilineCompositionTests self){
    ASSERT_TRUE(self.m_model.setText("a\nb"));
    ASSERT_TRUE(self.m_model.selectAll());
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("a\xCC\x81\nz", 1u, 5u));
    ASSERT_TRUE(self.m_model.commitComposition(self.m_model.composition().text));
    EXPECT_EQ(self.m_model.text(), "a\xCC\x81\nz");
    EXPECT_EQ(self.m_model.caret(), 5u);
    EXPECT_FALSE(self.m_model.setSelection(1u, 1u));
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "a\nb");
    EXPECT_EQ(self.m_model.anchor(), 0u);
    EXPECT_EQ(self.m_model.caret(), 3u);
}

void VerifyMultilineCompositionTests_EmptyPreeditRetainsTheOriginalCrossLineReplacementRange(mut MultilineCompositionTests self){
    ASSERT_TRUE(self.m_model.setText("ab\ncd"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 4u));
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("x\ny", 0u, 3u));
    ASSERT_TRUE(self.m_model.updateComposition("", 0u, 0u));
    EXPECT_TRUE(self.m_model.composition().active);
    EXPECT_EQ(self.m_model.composition().replacementStart, 1u);
    EXPECT_EQ(self.m_model.composition().replacementEnd, 4u);
    ASSERT_TRUE(self.m_model.commitComposition("\n"));
    EXPECT_EQ(self.m_model.text(), "a\nd");
}


