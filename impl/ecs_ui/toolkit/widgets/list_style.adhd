#include "style.adhd"
#include <impl/ecs_ui/toolkit/input/input.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const f32 s_ListDefaultHeight = 240.0f;
const usize s_ListRowMetricCount = 6u;
const usize s_ListLanguageBufferBytes = 64u;
const u32 s_ListMaxPreparedRows = 1024u;
const Name s_ListRowNormalRegionName = "list.row.normal";
const Name s_ListRowHoverRegionName = "list.row.hover";
const Name s_ListRowSelectedRegionName = "list.row.selected";
const Name s_ListRowDisabledRegionName = "list.row.disabled";
const Name s_ListBackgroundRegionName = "list.background";
const Name s_ScrollTrackRegionName = "scroll.track";
const Name s_ScrollThumbRegionName = "scroll.thumb";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> ListActionOutcome{
    Continue,
    Stop,
    Failed,
}

enum<u8> ListSelectionMode{
    Single,
    Multiple,
    Extended,
    kCount,
}

class SelectableStyle{
    public Name normal = s_ListRowNormalRegionName;
    public Name hover = s_ListRowHoverRegionName;
    public Name selected = s_ListRowSelectedRegionName;
    public Name disabled = s_ListRowDisabledRegionName;
    public Name fallback = s_StyleButtonNormalRegionName;
    public Name hoverFallback = s_StyleButtonHoverRegionName;
    public Name selectedFallback = s_StyleButtonPressedRegionName;
    public Name disabledFallback = s_StyleButtonDisabledRegionName;
    public Name focus = s_StyleFocusOverlayRegionName;
    public Insets padding = Insets(s_StyleSpacingMedium, s_StyleSpacingSmall, s_StyleSpacingMedium, s_StyleSpacingSmall);
}

class ListStyle{
    public SelectableStyle row;
    public Name background = s_ListBackgroundRegionName;
    public Name backgroundFallback = s_StylePanelNormalRegionName;
    public Name track = s_ScrollTrackRegionName;
    public Name trackFallback = s_StylePanelNormalRegionName;
    public Name thumb = s_ScrollThumbRegionName;
    public Name thumbFallback = s_StyleButtonNormalRegionName;
    public Name thumbHover = s_StyleButtonHoverRegionName;
    public Name thumbPressed = s_StyleButtonPressedRegionName;
    public Name thumbDisabled = s_StyleButtonDisabledRegionName;
    public Insets padding = Insets(s_StyleSpacingSmall, s_StyleSpacingSmall, s_StyleSpacingSmall, s_StyleSpacingSmall);
    public f32 scrollbarWidth = s_StyleScrollbarThickness;
    public f32 minimumThumb = s_StyleScrollbarMinimumThumb;
}

class ListOptions{
    public LayoutSize width = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
    public LayoutSize height = LayoutSize(LayoutSizePolicy::Fixed, s_ListDefaultHeight);
    public f32 wheelRows = s_StyleScrollWheelStep;
    public b8 enabled = true;
    public b8 selectOnNavigate = true;
    public LayoutItemOptions layout;
    public ListSelectionMode selectionMode = ListSelectionMode::Single;
    public ScrollbarPolicy horizontalScrollbar = ScrollbarPolicy::Never;
    public ScrollbarPolicy verticalScrollbar = ScrollbarPolicy::Auto;
    public f32 contentWidth = 0.0f;
    public f32 wheelColumns = 32.0f;
}

class ListResult{
    public b8 valid = false;
    public b8 selectionChanged = false;
    public b8 activated = false;
    public b8 focused = false;
}

class SelectableMetrics{
    public Insets padding;
    public Point minimum;
}

class SelectablePaintFlags{
    public b8 enabled = true;
    public b8 selected = false;
    public b8 hover = false;
    public b8 focused = false;
}

class ListKeyResolution{
    public ListKeyResolution(){
        this.index = 0u;
        this.present = false;
    }

    public ListKeyResolution(in u64 inIndex, in b8 inPresent){
        this.index = inIndex;
        this.present = inPresent;
    }

    public u64 index;
    public b8 present;
}

class ListMeasureKey{
    private b8 equals(in ListMeasureKey rhs)const{
        if(
            this.sourceGeneration != rhs.sourceGeneration
            || this.sourceRevision != rhs.sourceRevision
            || this.rowCount != rhs.rowCount
            || this.textIdentity != rhs.textIdentity
            || this.textGeneration != rhs.textGeneration
            || this.fontSize != rhs.fontSize
            || this.pixelScaleX != rhs.pixelScaleX
            || this.pixelScaleY != rhs.pixelScaleY
            || this.scriptTag != rhs.scriptTag
            || this.direction != rhs.direction
            || this.languageLength != rhs.languageLength
            || this.rowHeightRevision != rhs.rowHeightRevision
            || this.variableRowHeights != rhs.variableRowHeights
        )
            return false;
        for(usize i = 0u; i < s_ListRowMetricCount; ++i){
            if(this.rowMetrics[i] != rhs.rowMetrics[i])
                return false;
        }
        for(usize i = 0u; i < s_ListLanguageBufferBytes; ++i){
            if(this.language[i] != rhs.language[i])
                return false;
        }
        return true;
    }

    public b8 operator==(in ListMeasureKey rhs)const{
        return this.equals(rhs);
    }

    public b8 operator!=(in ListMeasureKey rhs)const{
        return !this.equals(rhs);
    }

    public u64 sourceGeneration = 0u;
    public u64 sourceRevision = 0u;
    public u64 rowCount = 0u;
    public u64 textIdentity = 0u;
    public u64 textGeneration = 0u;
    public u64 rowHeightRevision = 0u;
    public f32 fontSize = 0.0f;
    public f32 pixelScaleX = 0.0f;
    public f32 pixelScaleY = 0.0f;
    public Array<f32, s_ListRowMetricCount> rowMetrics;
    public Array<u8, s_ListLanguageBufferBytes> language;
    public u32 scriptTag = 0u;
    public TextDirection direction = TextDirection::LeftToRight;
    public u8 languageLength = 0u;
    public b8 variableRowHeights = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsValidVirtualListDeclarationOptions(in ListOptions options){
    return IsFinite(VectorSingle(options.wheelRows, options.wheelColumns, options.contentWidth, 0.0f))
        && options.wheelRows > 0.0f
        && options.wheelColumns > 0.0f
        && options.contentWidth >= 0.0f
        && options.selectionMode < ListSelectionMode::kCount
        && options.horizontalScrollbar <= ScrollbarPolicy::Never
        && options.verticalScrollbar <= ScrollbarPolicy::Never;
}

b8 IsValidListOptions(in ListOptions options){
    return options.enabled && IsValidVirtualListDeclarationOptions(options);
}

b8 IsReverseListControlAction(in ControlActionKind kind){
    return kind == ControlActionKind::Up || kind == ControlActionKind::PageUp || kind == ControlActionKind::End;
}

Expected<f64> TryComputeListWheelOffset(in f64 current, in f64 delta, in f64 step, in f64 maximum){
    if(!IsFinite(VectorDouble(delta, step, maximum, 0.0)) || step <= 0.0 || maximum < 0.0)
        return MakeUnexpected(Failure());
    f64 candidateValue = UiSimdMinF64(current, maximum);
    if(delta > 0.0){
        const f64 distanceInSteps = candidateValue / step;
        if(delta >= distanceInSteps)
            candidateValue = 0.0;
        else
            candidateValue = candidateValue - delta * step;
    }
    else if(delta < 0.0){
        const f64 reverseDelta = -delta;
        const f64 distanceInSteps = (maximum - candidateValue) / step;
        if(reverseDelta >= distanceInSteps)
            candidateValue = maximum;
        else
            candidateValue = candidateValue + reverseDelta * step;
    }
    f64 candidate = 0.0;
    if(candidateValue > 0.0)
        candidate = UiSimdMinF64(maximum, candidateValue);
    if(!IsFinite(VectorDouble(candidate)))
        return MakeUnexpected(Failure());
    return candidate;
}


