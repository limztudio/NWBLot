// limztudio@gmail.com
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Global descriptor heap - shader accessor surface.
//
// At least one unbounded array per resource class, declared at the exact set/binding the host binds the heap's two
// descriptor tables to (see binding_slots.h). A class may expose several aliased views over its single descriptor:
// the StorageBuffer class carries the RW raw array plus a read-only raw alias here, and a read-only structured node
// alias in bindless_heap_bvh.slangi - all three at the same binding, differing only by SPIR-V access/stride decoration.
// A resource registered through GpuDescriptorHeap::write() lands at its class's
// array, at its GpuDescriptorHandle::slot(). A shader fetches it by indexing that array with the slot; a slot that
// varies across a wave must be wrapped in NonUniformResourceIndex() at the subscript (the round-trip test runs a
// single invocation, so it does not need to). Backend C's optional TLAS surface is intentionally a dedicated fixed
// descriptor set: each command records the current handle's descriptor-buffer block offset, keeping retired TLAS
// descriptors immutable until in-flight work has drained. Backend A compiles this declaration out.


#ifndef NWB_GRAPHICS_BINDLESS_HEAP_SLANGI
#define NWB_GRAPHICS_BINDLESS_HEAP_SLANGI


#include "binding_slots.h"

// Most shaders include the heap for buffer/sampler access but do not participate in the optional TLAS migration.
// Give those variants an explicit disabled value: Slang evaluates the right side of `defined(...) && ...` and emits
// a warning for an undefined identifier, even though the expression ultimately evaluates to false.
#ifndef NWB_BINDLESS_TLAS
#define NWB_BINDLESS_TLAS 0
#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Element type of the uniform-buffer (CBV) heap array. A CBV is at least a 16-byte float4 lane; the payload is the
// leading uint, the rest pads the constant-buffer row.
struct NwbBindlessHeapUint{
    uint value;
    uint3 _pad;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[vk::binding(NWB_BINDLESS_HEAP_BINDING_SAMPLED_IMAGE, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
Texture2D<float4> g_NwbHeapSampledImages[];

// Texture2DArray requires a distinct shader declaration from Texture2D even though both are Vulkan sampled-image
// descriptors. It therefore owns a separate binding/class while sharing the resource-slot namespace.
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_SAMPLED_IMAGE_2D_ARRAY, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
Texture2DArray<float4> g_NwbHeapSampledImage2DArrays[];

// Texture3D needs another sampled-image binding because Slang's resource type determines the SPIR-V image view
// dimension. It shares the global resource-slot namespace with the other non-sampler classes.
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_SAMPLED_IMAGE_3D, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
Texture3D<float4> g_NwbHeapSampledImage3Ds[];

[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_IMAGE, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
RWTexture2D<float4> g_NwbHeapStorageImages[];

// Storage-image descriptors carry their view dimension and format with the descriptor, so the same global
// StorageImage table can expose typed Texture2DArray aliases. CSG uses these unformatted views for its transient
// interval/peel images (RGBA16F/RGBA32F/R32_UINT/RGBA32_UINT/RG32_UINT); device creation already requires the
// Vulkan storage-image read/write-without-format features. Keeping the aliases on binding 1 avoids proliferating
// heap ABI classes for one descriptor type.
#pragma warning(push)
#pragma warning(disable: 39001) // Deliberate typed aliases of the StorageImage descriptor table.
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_IMAGE, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
RWTexture2DArray<float4> g_NwbHeapStorageImage2DArrayFloat4s[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_IMAGE, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
RWTexture2DArray<uint> g_NwbHeapStorageImage2DArrayUints[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_IMAGE, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
RWTexture2DArray<uint2> g_NwbHeapStorageImage2DArrayUint2s[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_IMAGE, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
RWTexture2DArray<uint4> g_NwbHeapStorageImage2DArrayUint4s[];
#pragma warning(pop)

[[vk::binding(NWB_BINDLESS_HEAP_BINDING_SAMPLED_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
Buffer<uint> g_NwbHeapSampledBuffers[];

[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
RWByteAddressBuffer g_NwbHeapStorageBuffers[];

// Read-only raw alias of the StorageBuffer class. Declared at the SAME set/binding as the RW array
// above: ByteAddressBuffer and RWByteAddressBuffer both resolve to a Vulkan STORAGE_BUFFER descriptor, so the two
// arrays alias one descriptor table - the SRV/UAV distinction is a per-view SPIR-V access decoration, not a separate
// descriptor. Read-only consumers use this view so write capability does not leak into geometry fetches.
// bindless_heap_bvh.slangi adds a structured node view over the same binding for software traversal.
#pragma warning(push)
#pragma warning(disable: 39001) // Deliberate read-only view of the storage-buffer descriptor table above.
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
ByteAddressBuffer g_NwbHeapRawBuffers[];
#pragma warning(pop)

[[vk::binding(NWB_BINDLESS_HEAP_BINDING_UNIFORM_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
ConstantBuffer<NwbBindlessHeapUint> g_NwbHeapUniformBuffers[];

[[vk::binding(NWB_BINDLESS_HEAP_BINDING_SAMPLER, NWB_BINDLESS_HEAP_SAMPLER_SET)]]
SamplerState g_NwbHeapSamplers[];

#if NWB_BINDLESS_TLAS
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_ACCEL_STRUCT, NWB_BINDLESS_HEAP_ACCEL_STRUCT_SET)]]
RaytracingAccelerationStructure g_NwbHeapAccelStruct;
#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Slot accessor for the read-only raw view. A per-mesh geometry slot varies across a wave (neighbouring invocations
// touch different meshes), so the descriptor-array subscript must be wrapped in NonUniformResourceIndex(); centralizing
// that here keeps every heap consumer consistent and prevents call sites from omitting the decoration. Returns the
// buffer by value (an opaque handle) so the caller loads from its own offset.
ByteAddressBuffer NwbHeapRawBuffer(const uint slot){
    return g_NwbHeapRawBuffers[NonUniformResourceIndex(slot)];
}

// Deferred/compositor resource-slot buffers are constant across their fullscreen draw. Keep these indices uniform:
// unlike per-mesh fetches they do not require sampler/image non-uniform-indexing capability on the portability path.
Texture2D<float4> NwbHeapSampledImage2D(const uint slot){
    return g_NwbHeapSampledImages[slot];
}

Texture2DArray<float4> NwbHeapSampledImage2DArray(const uint slot){
    return g_NwbHeapSampledImage2DArrays[slot];
}

Texture3D<float4> NwbHeapSampledImage3D(const uint slot){
    return g_NwbHeapSampledImage3Ds[slot];
}

// CSG's slot cbuffer is uniform per draw/dispatch, so these array lookups remain uniform like the fullscreen image
// helpers above. A future per-invocation storage-image user must wrap its table subscript in NonUniformResourceIndex.
RWTexture2DArray<float4> NwbHeapStorageImage2DArrayFloat4(const uint slot){
    return g_NwbHeapStorageImage2DArrayFloat4s[slot];
}

RWTexture2DArray<uint> NwbHeapStorageImage2DArrayUint(const uint slot){
    return g_NwbHeapStorageImage2DArrayUints[slot];
}

RWTexture2DArray<uint2> NwbHeapStorageImage2DArrayUint2(const uint slot){
    return g_NwbHeapStorageImage2DArrayUint2s[slot];
}

RWTexture2DArray<uint4> NwbHeapStorageImage2DArrayUint4(const uint slot){
    return g_NwbHeapStorageImage2DArrayUint4s[slot];
}

SamplerState NwbHeapSampler(const uint slot){
    return g_NwbHeapSamplers[slot];
}


#if NWB_BINDLESS_TLAS
// The active TLAS descriptor is selected by the host when it binds the heap's set-10 descriptor-buffer block. It is
// not an array subscript in shader code: a freshly allocated block per TLAS generation keeps older command buffers
// pointing at their original AS descriptor until the heap's deferred-free quarantine retires it.
RaytracingAccelerationStructure NwbHeapAccelStruct(){
    return g_NwbHeapAccelStruct;
}
#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

