void VerifyMinidumpBoundaryTests_ShortExceptionContextCannotBorrowSurroundingFileBytes(mut MinidumpBoundaryTests self){
    if(!IsWindowsLoggerCrashPlatform())
        return;

    String actualReport = String();
    native(mut self, mut actualReport){
#if defined(FOUNDATION_PLATFORM_WINDOWS)
        auto bytes = ExceptionDump(self.m_testArena.arena, UnusedStream, 0u);
        constexpr usize s_ExceptionOffset = sizeof(MINIDUMP_HEADER) + 2u * sizeof(MINIDUMP_DIRECTORY);
        MINIDUMP_EXCEPTION_STREAM exception{};
        exception.ThreadId = 1u;
        exception.ThreadContext.DataSize = sizeof(CONTEXT) - 1u;
        exception.ThreadContext.Rva = s_ExceptionOffset + sizeof(MINIDUMP_EXCEPTION_STREAM);
        StoreDumpRecord(s_ExceptionOffset, exception, bytes);
        const auto actual = self.report(bytes);
        ASSERT_TRUE(actual);
        actualReport.assign(actual->data(), actual->size());
#endif
    }
    EXPECT_TRUE(Contains(StringView(actualReport), "status=not_decoded"));
    EXPECT_TRUE(Contains(StringView(actualReport), "no usable thread context"));
}

void VerifyMinidumpBoundaryTests_Memory64OffsetsAndLengthsCannotTruncateIntoASmallFile(mut MinidumpBoundaryTests self){
    if(!IsWindowsLoggerCrashPlatform())
        return;

    u32 notDecodedReports = 0u;
    u32 invalidRangeReports = 0u;
    native(mut self, mut notDecodedReports, mut invalidRangeReports){
#if defined(FOUNDATION_PLATFORM_WINDOWS)
        for(const b8 oversizedOffset : Array<b8, 2u>{ false, true }){
            constexpr usize s_StreamSize = offsetof(MINIDUMP_MEMORY64_LIST, MemoryRanges) + sizeof(MINIDUMP_MEMORY_DESCRIPTOR64);
            auto bytes = ExceptionDump(self.m_testArena.arena, Memory64ListStream, s_StreamSize);
            const usize streamOffset = bytes.size() - s_StreamSize;
            const ULONG64 count = 1u;
            const RVA64 baseRva = oversizedOffset ? (u64(1u) << 32u) + bytes.size() - 1u : bytes.size() - 1u;
            MINIDUMP_MEMORY_DESCRIPTOR64 memory{};
            memory.StartOfMemoryRange = 0x1000u;
            memory.DataSize = oversizedOffset ? 1u : (u64(1u) << 32u) + 1u;
            StoreDumpRecord(streamOffset + offsetof(MINIDUMP_MEMORY64_LIST, NumberOfMemoryRanges), count, bytes);
            StoreDumpRecord(streamOffset + offsetof(MINIDUMP_MEMORY64_LIST, BaseRva), baseRva, bytes);
            StoreDumpRecord(streamOffset + offsetof(MINIDUMP_MEMORY64_LIST, MemoryRanges), memory, bytes);
            const auto actual = self.report(bytes);
            ASSERT_TRUE(actual);
            if(actual->find("status=not_decoded") != Log::CrashReportText::npos)
                ++notDecodedReports;
            if(actual->find("minidump contains invalid memory ranges") != Log::CrashReportText::npos)
                ++invalidRangeReports;
        }
#endif
    }
    EXPECT_EQ(notDecodedReports, 2u);
    EXPECT_EQ(invalidRangeReports, 2u);
}

