    ASSERT_TRUE(context.build(inputs));
    ASSERT_TRUE(context.snapshot.hasCsg);
    context.testWorld.world.entity(inputs[0u].entity).getComponent<StaticCsgMeshComponent>().enabled = false;
    ASSERT_TRUE(context.build(inputs));
    EXPECT_FALSE(context.snapshot.hasCsg);
    EXPECT_TRUE(context.snapshot.receiverRanges.empty());
    EXPECT_TRUE(context.snapshot.cutters.empty());

    context.testWorld.world.entity(inputs[0u].entity).getComponent<StaticCsgMeshComponent>().enabled = true;
    context.testWorld.world.entity(cutterEntity).getComponent<CsgCutterComponent>().active = false;
    ASSERT_TRUE(SuiteBuildCsgSnapshot(context, inputs));
    EXPECT_FALSE(context.snapshot.hasCsg);
    EXPECT_TRUE(context.snapshot.receiverRanges.empty());
    EXPECT_TRUE(SuiteBuildEmptyCsgSnapshot(context));
}

