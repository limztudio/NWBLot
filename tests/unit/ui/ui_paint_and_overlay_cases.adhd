void VerifyUiPaintSdfTests_ClipTrimsSdfGeometryAndUv(mut UiPaintSdfTests self){
    auto pageCreationResult = self.makeSdfPage();
    ASSERT_TRUE(pageCreationResult.has_value());
    SharedSdfAtlasPage page = SharedSdfAtlasPage();
    TakeUiPaintOverlaySdfPage(page, pageCreationResult);
    ASSERT_TRUE(UiPaintOverlayHasSdfPage(page));
    self.m_builder.pushClip(MakeUiPaintOverlayRect(10.0f, 5.0f, 20.0f, 10.0f));
    ASSERT_TRUE(self.m_builder.drawSdfGlyph(
        page,
        3u,
        MakeUiPaintOverlayRect(0.0f, 0.0f, 40.0f, 20.0f),
        MakeUiPaintOverlayRect(0.125f, 0.25f, 0.5f, 0.5f),
        MakeUiPaintOverlayColor(0.8f, 0.4f, 0.2f, 0.5f)
    ));
    ASSERT_TRUE(self.m_builder.popClip());
    ExpectClippedPaintTextQuad(self.m_builder.freeze());
}

void VerifyUiPaintSdfTests_BatchesOnlyAdjacentMatchingGroupChannelMaterialAndClip(mut UiPaintSdfTests self){
    auto firstCreationResult = self.makeSdfPage();
    ASSERT_TRUE(firstCreationResult.has_value());
    SharedSdfAtlasPage first = SharedSdfAtlasPage();
    TakeUiPaintOverlaySdfPage(first, firstCreationResult);
    auto secondCreationResult = self.makeSdfPage(s_UiPaintOverlayDefaultAtlasIdentity, 1u, 1u);
    ASSERT_TRUE(secondCreationResult.has_value());
    SharedSdfAtlasPage second = SharedSdfAtlasPage();
    TakeUiPaintOverlaySdfPage(second, secondCreationResult);
    auto coverageCreationResult = self.makeCoverage(22u);
    ASSERT_TRUE(coverageCreationResult.has_value());
    SharedGlyphPage coverage = SharedGlyphPage();
    TakeUiPaintOverlayGlyphPage(coverage, coverageCreationResult);
    ASSERT_TRUE(UiPaintOverlayHasSdfPage(first) && UiPaintOverlayHasSdfPage(second) && UiPaintOverlayHasGlyphPage(coverage));
    const Rect rectangle = MakeUiPaintOverlayRect(1.0f, 1.0f, 4.0f, 4.0f);
    const Rect uv = MakeUiPaintOverlayRect(0.0f, 0.0f, 0.5f, 0.5f);
    ASSERT_TRUE(self.m_builder.drawSdfGlyph(first, 0u, rectangle, uv));
    ASSERT_TRUE(self.m_builder.drawSdfGlyph(first, 0u, rectangle, uv, MakeUiPaintOverlayColor(0.5f, 0.25f, 1.0f, 0.5f)));
    ASSERT_TRUE(self.m_builder.drawSdfGlyph(first, 1u, rectangle, uv));
    ASSERT_TRUE(self.m_builder.drawSdfGlyph(second, 1u, rectangle, uv));
    ASSERT_TRUE(self.m_builder.drawGlyph(coverage, rectangle, uv));
    ASSERT_TRUE(self.m_builder.drawSdfGlyph(first, 0u, rectangle, uv));
    self.m_builder.fillRect(rectangle);
    ASSERT_TRUE(self.m_builder.drawRegion(s_UiInputNameSprite, rectangle));
    self.m_builder.pushClip(MakeUiPaintOverlayRect(0.0f, 0.0f, 20.0f, 20.0f));
    ASSERT_TRUE(self.m_builder.drawSdfGlyph(first, 0u, rectangle, uv));
    ASSERT_TRUE(self.m_builder.popClip());
    ASSERT_TRUE(self.m_builder.drawSdfGlyph(first, 0u, rectangle, uv));
    const DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.sdfPages().size(), 2u);
    ASSERT_EQ(snapshot.glyphPages().size(), 1u);
    ASSERT_EQ(snapshot.commands().size(), 9u);
    EXPECT_EQ(snapshot.commands()[0u].indexCount, 12u);
    EXPECT_EQ(snapshot.commands()[1u].sdfChannel, 1u);
    EXPECT_EQ(snapshot.commands()[2u].sdfPageIndex, 1u);
    EXPECT_EQ(snapshot.commands()[3u].material, PaintMaterial::Glyph);
    EXPECT_EQ(snapshot.commands()[4u].material, PaintMaterial::SdfGlyph);
    EXPECT_EQ(snapshot.commands()[5u].material, PaintMaterial::Solid);
    EXPECT_EQ(snapshot.commands()[6u].material, PaintMaterial::Skin);
    EXPECT_FLOAT_EQ(snapshot.commands()[7u].clip.width, 20.0f);
    EXPECT_FLOAT_EQ(snapshot.commands()[8u].clip.width, 100.0f);
}

void VerifyUiPaintSdfTests_FrozenSnapshotKeepsExactPixelsAndFontHashAcrossRepackAndRelease(mut UiPaintSdfTests self){
    auto originalCreationResult = self.makeSdfPage();
    ASSERT_TRUE(originalCreationResult.has_value());
    SharedSdfAtlasPage original = SharedSdfAtlasPage();
    TakeUiPaintOverlaySdfPage(original, originalCreationResult);
    ASSERT_TRUE(UiPaintOverlayHasSdfPage(original));
    const Sha256Digest oldPixelsHash = UiPaintOverlaySdfPagePixelsHash(original);
    ASSERT_TRUE(self.m_builder.drawSdfGlyph(original, 2u, MakeUiPaintOverlayRect(1.0f, 1.0f, 4.0f, 4.0f), MakeUiPaintOverlayRect(0.0f, 0.0f, 0.25f, 0.25f)));
    const DrawSnapshot first = self.m_builder.freeze();
    original.reset();
    self.begin(8u);
    auto replacementCreationResult = self.makeSdfPage(12u, 1u, 0u, 64u);
    ASSERT_TRUE(replacementCreationResult.has_value());
    SharedSdfAtlasPage replacement = SharedSdfAtlasPage();
    TakeUiPaintOverlaySdfPage(replacement, replacementCreationResult);
    ASSERT_TRUE(UiPaintOverlayHasSdfPage(replacement));
    ASSERT_TRUE(self.m_builder.drawSdfGlyph(replacement, 2u, MakeUiPaintOverlayRect(6.0f, 1.0f, 4.0f, 4.0f), MakeUiPaintOverlayRect(0.5f, 0.5f, 0.25f, 0.25f)));
    const DrawSnapshot second = self.m_builder.freeze();
    replacement.reset();
    self.begin(9u);
    ASSERT_EQ(first.sdfPages().size(), 1u);
    ASSERT_EQ(second.sdfPages().size(), 1u);
    EXPECT_EQ(UiPaintOverlaySdfPagePixel(first.sdfPages()[0u], 2u), 255u);
    EXPECT_EQ(UiPaintOverlaySdfPagePixel(second.sdfPages()[0u], 2u), 64u);
    EXPECT_TRUE(UiPaintOverlaySdfPagePixelsHash(first.sdfPages()[0u]) == oldPixelsHash);
    EXPECT_FALSE(UiPaintOverlaySdfPagePixelsHash(first.sdfPages()[0u]) == UiPaintOverlaySdfPagePixelsHash(second.sdfPages()[0u]));
    EXPECT_FLOAT_EQ(first.vertices()[0u].texCoord.x, 0.0f);
    EXPECT_FLOAT_EQ(second.vertices()[0u].texCoord.x, 0.5f);
}

void VerifyUiPaintSdfTests_RejectedMixedAdmissionAtCapacityPreservesEarlierCoverageUpgradeAndGeometry(mut UiPaintSdfTests self){
    ASSERT_EQ(s_PaintMaxImages, 64u);
    FixedVector<SharedGlyphPage, 63u> coverage = FixedVector<SharedGlyphPage, 63u>();
    for(usize index = 0u; index < 63u; ++index){
        auto pageCreationResult = self.makeCoverage(100u + index);
        ASSERT_TRUE(pageCreationResult.has_value());
        SharedGlyphPage page = SharedGlyphPage();
        TakeUiPaintOverlayGlyphPage(page, pageCreationResult);
        ASSERT_TRUE(UiPaintOverlayHasGlyphPage(page));
        coverage.push_back(page);
    }
    auto sdfCreationResult = self.makeSdfPage();
    ASSERT_TRUE(sdfCreationResult.has_value());
    SharedSdfAtlasPage sdf = SharedSdfAtlasPage();
    TakeUiPaintOverlaySdfPage(sdf, sdfCreationResult);
    ASSERT_TRUE(UiPaintOverlayHasSdfPage(sdf));
    ASSERT_TRUE(self.prepareGlyphSpanAndSingleSdf(coverage, sdf));
    ASSERT_TRUE(self.m_builder.drawSdfGlyph(sdf, 3u, MakeUiPaintOverlayRect(1.0f, 1.0f, 4.0f, 4.0f), MakeUiPaintOverlayRect(0.0f, 0.0f, 0.5f, 0.5f)));
    auto upgradeCreationResult = self.makeCoverage(100u, 2u);
    ASSERT_TRUE(upgradeCreationResult.has_value());
    SharedGlyphPage upgrade = SharedGlyphPage();
    TakeUiPaintOverlayGlyphPage(upgrade, upgradeCreationResult);
    auto overflowCreationResult = self.makeSdfPage(99u);
    ASSERT_TRUE(overflowCreationResult.has_value());
    SharedSdfAtlasPage overflow = SharedSdfAtlasPage();
    TakeUiPaintOverlaySdfPage(overflow, overflowCreationResult);
    EXPECT_FALSE(self.prepareSingleGlyphAndSingleSdf(upgrade, overflow));
    EXPECT_FALSE(self.m_builder.drawSdfGlyph(overflow, 0u, MakeUiPaintOverlayRect(10.0f, 10.0f, 4.0f, 4.0f), MakeUiPaintOverlayRect(0.0f, 0.0f, 0.5f, 0.5f)));
    const DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.glyphPages().size(), s_PaintMaxImages - 1u);
    ASSERT_EQ(snapshot.sdfPages().size(), 1u);
    EXPECT_EQ(UiPaintOverlayGlyphPageAddress(snapshot.glyphPages()[0u]), UiPaintOverlayGlyphPageAddress(coverage[0u]));
    EXPECT_EQ(UiPaintOverlayGlyphPageGeneration(snapshot.glyphPages()[0u]), 1u);
    EXPECT_EQ(UiPaintOverlaySdfPageAddress(snapshot.sdfPages()[0u]), UiPaintOverlaySdfPageAddress(sdf));
    EXPECT_EQ(snapshot.vertices().size(), 4u);
    EXPECT_EQ(snapshot.indices().size(), 6u);
    EXPECT_EQ(snapshot.commands().size(), 1u);
}

void VerifyUiPaintSdfTests_EqualIdentityCannotAliasDifferentDistanceBytes(mut UiPaintSdfTests self){
    auto originalCreationResult = self.makeSdfPage();
    ASSERT_TRUE(originalCreationResult.has_value());
    SharedSdfAtlasPage original = SharedSdfAtlasPage();
    TakeUiPaintOverlaySdfPage(original, originalCreationResult);
    auto conflictingCreationResult = self.makeSdfPage(s_UiPaintOverlayDefaultAtlasIdentity, 1u, 0u, 64u);
    ASSERT_TRUE(conflictingCreationResult.has_value());
    SharedSdfAtlasPage conflicting = SharedSdfAtlasPage();
    TakeUiPaintOverlaySdfPage(conflicting, conflictingCreationResult);
    ASSERT_TRUE(UiPaintOverlayHasSdfPage(original) && UiPaintOverlayHasSdfPage(conflicting));
    ASSERT_TRUE(self.prepareSingleSdfPage(original));
    EXPECT_FALSE(self.prepareSingleSdfPage(conflicting));
    const DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.sdfPages().size(), 1u);
    EXPECT_EQ(UiPaintOverlaySdfPageAddress(snapshot.sdfPages()[0u]), UiPaintOverlaySdfPageAddress(original));
    EXPECT_TRUE(snapshot.vertices().empty());
}

void VerifyUiPaintSdfTests_InvalidChannelAndUvFailBeforeImageOrGeometryAdmission(mut UiPaintSdfTests self){
    auto pageCreationResult = self.makeSdfPage();
    ASSERT_TRUE(pageCreationResult.has_value());
    SharedSdfAtlasPage page = SharedSdfAtlasPage();
    TakeUiPaintOverlaySdfPage(page, pageCreationResult);
    ASSERT_TRUE(UiPaintOverlayHasSdfPage(page));
    EXPECT_FALSE(self.m_builder.drawSdfGlyph(page, 4u, MakeUiPaintOverlayRect(1.0f, 1.0f, 4.0f, 4.0f), MakeUiPaintOverlayRect(0.0f, 0.0f, 0.5f, 0.5f)));
    EXPECT_FALSE(self.m_builder.drawSdfGlyph(page, 0u, MakeUiPaintOverlayRect(1.0f, 1.0f, 4.0f, 4.0f), MakeUiPaintOverlayRect(0.75f, 0.0f, 0.5f, 0.5f)));
    const DrawSnapshot snapshot = self.m_builder.freeze();
    EXPECT_TRUE(snapshot.sdfPages().empty());
    EXPECT_TRUE(snapshot.vertices().empty());
    EXPECT_TRUE(snapshot.commands().empty());
}

void VerifyUiPaintSdfTests_DuplicateCandidatesConsumeOneImageSlot(mut UiPaintSdfTests self){
    auto pageCreationResult = self.makeSdfPage();
    ASSERT_TRUE(pageCreationResult.has_value());
    SharedSdfAtlasPage page = SharedSdfAtlasPage();
    TakeUiPaintOverlaySdfPage(page, pageCreationResult);
    auto reconstructedCreationResult = self.makeSdfPage();
    ASSERT_TRUE(reconstructedCreationResult.has_value());
    SharedSdfAtlasPage reconstructed = SharedSdfAtlasPage();
    TakeUiPaintOverlaySdfPage(reconstructed, reconstructedCreationResult);
    ASSERT_TRUE(UiPaintOverlayHasSdfPage(page) && UiPaintOverlayHasSdfPage(reconstructed));
    Array<SharedSdfAtlasPage, 3u> candidates = Array<SharedSdfAtlasPage, 3u>();
    candidates[0u] = page;
    candidates[1u] = reconstructed;
    candidates[2u] = page;
    ASSERT_TRUE(self.m_builder.prepareSdfPages(candidates));
    const DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.sdfPages().size(), 1u);
    EXPECT_EQ(UiPaintOverlaySdfPageAddress(snapshot.sdfPages()[0u]), UiPaintOverlaySdfPageAddress(page));
}

void VerifyUiPaintSdfTests_PageFactoryRejectsUnsupportedEncodingSpreadAndIncompleteRgba(mut UiPaintSdfTests self){
    auto bindingPageResult = self.makeSdfPage();
    ASSERT_TRUE(bindingPageResult.has_value());
    SharedSdfAtlasPage bindingPage = SharedSdfAtlasPage();
    TakeUiPaintOverlaySdfPage(bindingPage, bindingPageResult);
    SdfAtlasPageBinding binding = UiPaintOverlaySdfPageBinding(bindingPage);
    UiPaintSdfPixels pixels = UiPaintSdfPixels(self.m_arena);
    pixels.resize(256u, 0u);
    binding.distanceEncoding = 2u;
    EXPECT_FALSE(self.createMovedSdfPage(binding, pixels).has_value());
    EXPECT_EQ(pixels.size(), 256u);
    binding.distanceEncoding = s_FontAtlasDistanceEncoding;
    binding.spreadPixels = s_FontAtlasMaxSpreadPixels + 1u;
    EXPECT_FALSE(self.createMovedSdfPage(binding, pixels).has_value());
    binding.spreadPixels = 8u;
    pixels.pop_back();
    EXPECT_FALSE(self.createMovedSdfPage(binding, pixels).has_value());
    EXPECT_EQ(pixels.size(), 255u);
}

void VerifyUiPaintSdfTests_CompactPageRejectsMissingChannelsWithoutPublishingGeometry(mut UiPaintSdfTests self){
    auto bindingPageResult = self.makeSdfPage();
    ASSERT_TRUE(bindingPageResult.has_value());
    SharedSdfAtlasPage bindingPage = SharedSdfAtlasPage();
    TakeUiPaintOverlaySdfPage(bindingPage, bindingPageResult);
    SdfAtlasPageBinding binding = UiPaintOverlaySdfPageBinding(bindingPage);
    binding.width = 7u;
    binding.height = 5u;
    binding.channelCount = 2u;
    UiPaintSdfPixels pixels = UiPaintSdfPixels(self.m_arena);
    pixels.resize(7u * 5u * 2u, 128u);
    auto pageCreationResult = self.createMovedSdfPage(binding, pixels);
    ASSERT_TRUE(pageCreationResult.has_value());
    SharedSdfAtlasPage page = SharedSdfAtlasPage();
    TakeUiPaintOverlaySdfPage(page, pageCreationResult);
    ASSERT_TRUE(UiPaintOverlayHasSdfPage(page));
    EXPECT_FALSE(self.m_builder.drawSdfGlyph(page, 2u, MakeUiPaintOverlayRect(1.0f, 1.0f, 4.0f, 4.0f), MakeUiPaintOverlayRect(0.0f, 0.0f, 0.5f, 0.5f)));
    EXPECT_TRUE(self.m_builder.freeze().commands().empty());
    self.begin(8u);
    ASSERT_TRUE(self.m_builder.drawSdfGlyph(page, 1u, MakeUiPaintOverlayRect(1.0f, 1.0f, 4.0f, 4.0f), MakeUiPaintOverlayRect(0.0f, 0.0f, 0.5f, 0.5f)));
    const DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.sdfPages().size(), 1u);
    EXPECT_EQ(snapshot.commands()[0u].sdfChannel, 1u);
}

void VerifyUiPaintSdfTests_CompactFactoryRejectsInvalidChannelCountAndRgbaSizedInput(mut UiPaintSdfTests self){
    auto bindingPageResult = self.makeSdfPage();
    ASSERT_TRUE(bindingPageResult.has_value());
    SharedSdfAtlasPage bindingPage = SharedSdfAtlasPage();
    TakeUiPaintOverlaySdfPage(bindingPage, bindingPageResult);
    SdfAtlasPageBinding binding = UiPaintOverlaySdfPageBinding(bindingPage);
    UiPaintSdfPixels pixels = UiPaintSdfPixels(self.m_arena);
    pixels.resize(256u, 128u);
    binding.channelCount = 0u;
    EXPECT_FALSE(self.createMovedSdfPage(binding, pixels).has_value());
    binding.channelCount = 5u;
    EXPECT_FALSE(self.createMovedSdfPage(binding, pixels).has_value());
    binding.channelCount = 1u;
    EXPECT_FALSE(self.createMovedSdfPage(binding, pixels).has_value());
    EXPECT_EQ(pixels.size(), 256u);
    pixels.resize(64u);
    auto pageResult = self.createMovedSdfPage(binding, pixels);
    ASSERT_TRUE(pageResult.has_value());
    SharedSdfAtlasPage page = SharedSdfAtlasPage();
    TakeUiPaintOverlaySdfPage(page, pageResult);
    ASSERT_TRUE(UiPaintOverlayHasSdfPage(page));
}

void VerifyUiPaintSdfTests_AssetFactoryCopiesExactGroupBytesBeforeSourceAssetIsReleased(mut UiPaintSdfTests self){
    UiPaintSdfAssetFactorySample sample = self.createPageFromTemporaryAtlas();
    ASSERT_TRUE(sample.valid);
    ASSERT_TRUE(self.m_builder.drawSdfGlyph(sample.page, 3u, MakeUiPaintOverlayRect(1.0f, 1.0f, 4.0f, 4.0f), MakeUiPaintOverlayRect(0.0f, 0.0f, 0.5f, 0.5f)));
    const DrawSnapshot snapshot = self.m_builder.freeze();
    sample.page.reset();
    ASSERT_EQ(snapshot.sdfPages().size(), 1u);
    EXPECT_EQ(UiPaintOverlaySdfPagePixel(snapshot.sdfPages()[0u], 3u), 192u);
    EXPECT_EQ(UiPaintOverlaySdfPageFontHashByte(snapshot.sdfPages()[0u], 0u), 99u);
    EXPECT_TRUE(UiPaintOverlaySdfPagePixelsHash(snapshot.sdfPages()[0u]) == sample.sourceHash);
}


