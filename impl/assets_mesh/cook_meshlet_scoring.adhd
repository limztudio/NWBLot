#include <impl/assets_mesh/cook_meshlet_score_state.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void UpdateBestMeshletCandidateFromResult(in MeshletCandidateSearchResult candidate, mut b8 found, mut MeshletFrontierCandidate outCandidate){
    if(!candidate.found)
        return;

    if(found && (candidate.candidate.score < outCandidate.score || (candidate.candidate.score == outCandidate.score && candidate.candidate.triangleIndex > outCandidate.triangleIndex)))
        return;

    found = true;
    outCandidate = candidate.candidate;
}

Expected<MeshletFrontierCandidate> SelectBestMeshletCandidateFromResults(in Span<MeshletCandidateSearchResult> results){
    b8 found = false;
    MeshletFrontierCandidate bestCandidate;
    for(in MeshletCandidateSearchResult result : results)
        UpdateBestMeshletCandidateFromResult(result, found, bestCandidate);
    if(!found)
        return makeUnexpected(Failure());
    return bestCandidate;
}

b8 IsBetterMeshletCandidate(in f32 score, in u32 triangleIndex, in b8 hasExisting, in MeshletFrontierCandidate existing){
    if(!hasExisting)
        return true;
    if(score > existing.score)
        return true;
    return score == existing.score && triangleIndex < existing.triangleIndex;
}

usize ResolveMeshletDisconnectedCandidateChunkCount(in usize searchCount, in u32 workerThreadCount){
    const usize workerCount = cast<usize>(workerThreadCount) + 1u;
    const usize maxChunkCount = workerCount * s_MeshletDisconnectedCandidateParallelOversubscription;
    return min(searchCount, maxChunkCount);
}

void ResolveMeshletDisconnectedCandidateChunkRange(
    in usize searchOffset,
    in usize searchCount,
    in usize chunkCount,
    in usize chunkIndex,
    mut usize outChunkBegin,
    mut usize outChunkEnd
){
    const usize chunkSize = searchCount / chunkCount;
    const usize remainder = searchCount % chunkCount;
    usize extraOffset = remainder;
    usize extraCount = 0u;
    if(chunkIndex < remainder){
        extraOffset = chunkIndex;
        extraCount = 1u;
    }
    outChunkBegin = searchOffset + chunkIndex * chunkSize + extraOffset;
    outChunkEnd = outChunkBegin + chunkSize + extraCount;
}

void UpdateBestMeshletCandidateFromPrecompute(
    in Span<MeshletTriangleData> triangles,
    in Span<MeshletTriangleCalculation> triangleCalculations,
    in Span<u32> triangleIndices,
    in MeshletScoreState scoreState,
    in MeshletDesc meshlet,
    in Span<u32> localVertexRefs,
    in usize frontierOffset,
    in u32 triangleIndex,
    in b8 disconnected,
    mut b8 found,
    mut MeshletFrontierCandidate outCandidate
){
    const MeshletTriangleData triangle = triangles[cast<usize>(triangleIndex)];
    const Expected<MeshletVertexCounts> vertexCounts = TryMeshletCanFitTriangle(meshlet, localVertexRefs, triangle);
    if(!vertexCounts.has_value())
        return;

    const f32 score = ScoreMeshletCandidateFromCalculations(
        triangleCalculations,
        triangleIndices,
        scoreState,
        triangleIndex,
        vertexCounts.value().shared,
        vertexCounts.value().missing,
        disconnected
    );
    if(!IsBetterMeshletCandidate(score, triangleIndex, found, outCandidate))
        return;

    found = true;
    outCandidate.frontierOffset = frontierOffset;
    outCandidate.triangleIndex = triangleIndex;
    outCandidate.score = score;
}

Expected<MeshletFrontierCandidate> FindBestMeshletFrontierCandidateFromPrecompute(
    in Span<MeshletTriangleData> triangles,
    in Span<MeshletTriangleCalculation> triangleCalculations,
    in Span<u32> frontier,
    in Span<u32> triangleIndices,
    in MeshletScoreState scoreState,
    in MeshletDesc meshlet,
    in Span<u32> localVertexRefs
){
    b8 found = false;
    MeshletFrontierCandidate candidate;
    for(usize frontierOffset = 0u; frontierOffset < frontier.size(); ++frontierOffset){
        const u32 triangleIndex = frontier[frontierOffset];
        UpdateBestMeshletCandidateFromPrecompute(
            triangles,
            triangleCalculations,
            triangleIndices,
            scoreState,
            meshlet,
            localVertexRefs,
            frontierOffset,
            triangleIndex,
            false,
            found,
            candidate
        );
    }

    if(!found)
        return makeUnexpected(Failure());
    return candidate;
}

Expected<MeshletFrontierCandidate> FindBestDisconnectedMeshletCandidateRangeFromPrecompute(
    in Span<MeshletTriangleData> triangles,
    in Span<MeshletTriangleCalculation> triangleCalculations,
    in Span<u8> visitedTriangles,
    in usize searchBegin,
    in usize searchEnd,
    in Span<u32> triangleIndices,
    in MeshletScoreState scoreState,
    in MeshletDesc meshlet,
    in Span<u32> localVertexRefs
){
    b8 found = false;
    MeshletFrontierCandidate candidate;
    for(usize triangleIndex = searchBegin; triangleIndex < searchEnd; ++triangleIndex){
        if(visitedTriangles[triangleIndex] != 0u)
            continue;

        UpdateBestMeshletCandidateFromPrecompute(
            triangles,
            triangleCalculations,
            triangleIndices,
            scoreState,
            meshlet,
            localVertexRefs,
            0u,
            cast<u32>(triangleIndex),
            true,
            found,
            candidate
        );
    }

    if(!found)
        return makeUnexpected(Failure());
    return candidate;
}


