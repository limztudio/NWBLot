    return options;
}

b8 TryBuildResourceVersionDependencyEdges(in GpuTaskGraphDeclarationReadView declarations, mut ScratchStorage scratch, mut ScratchDependencyEdges outEdges){
    ScratchDependencyEdges rawEdges(scratch);
    if(!BuildResourceVersionDependencyEdges(declarations, scratch, rawEdges).has_value())
        return false;
    for(usize index = 0u; index < rawEdges.size(); ++index)
        outEdges.push_back(rawEdges[index]);
    return true;
}

