#include <utilities/cli/tool_cli.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


i32 RunBenchmarkCli<const usize Capacity>(in ConsoleArguments arguments, in Func<0u, i32(in Span<StringView>)> run){
    if(arguments.count <= 0)
        return 2;
    Array<StringView, Capacity> args;
    const usize count = Min(cast<usize>(arguments.count), args.size());
    for(usize index = 0u; index < count; ++index)
        args[index] = arguments.text(cast<i32>(index));
    return run(Span<StringView>(args).first(count));
}


