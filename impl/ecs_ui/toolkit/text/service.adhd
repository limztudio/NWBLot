#include <impl/ecs_ui/toolkit/paint.adhd>
#include <impl/ecs_ui/toolkit/text/glyph_visibility.adhd>
#include <impl/ecs_ui/toolkit/text/layout.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Rect MakeCachedCoverageGlyphBounds(in i32 bearingX, in i32 bearingY, in Rect pixels){
    return Rect(cast<f32>(bearingX), -cast<f32>(bearingY), pixels.width, pixels.height);
}

b8 IsValidTextPaintOriginAndColor(in Point topLeft, in Color color){
    return IsFinite(topLeft.x) && IsFinite(topLeft.y) && IsValidPaintColor(color);
}

Point MakeDisplayPixelScalePoint(in DisplayMetrics metrics){
    return Point(metrics.pixelScaleX, metrics.pixelScaleY);
}

b8 HasPositivePreparedGlyphExtent(in Rect rectangle){
    return rectangle.width > 0.0f && rectangle.height > 0.0f;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<VectorDouble> LoadSdfSupport(in PlacedGlyph placed, in BakedFontAtlas atlas, in f32 fontSize, in DisplayMetrics display){
    const Expected<VectorDouble> plane = LoadAtlasRectangle(placed, atlas, fontSize, Point());
    if(!plane.has_value())
        return MakeUnexpected(Failure());
    const VectorDouble rectangle = plane.value();
    if(rectangle.z <= 0.0 || rectangle.w <= 0.0)
        return plane;
    in FontAtlasGlyph glyph = atlas.glyph(placed.glyphId);
    in SdfAtlasPage page = atlas.page(glyph.group).deref();
    in SdfAtlasPageBindingRecord<Font> binding = page.binding();
    return TryLoadSdfGlyphSupport(rectangle, glyph, binding.width, binding.height, binding.channelCount, binding.spreadPixels, Span<u8>(page.pixels()), display);
}

u32 InternPreparedPage<TPage>(mut Vector<Shared<TPage>> pages, in Shared<TPage> page){
    for(usize index = 0u; index < pages.size(); ++index){
        if(pages[index] == page)
            return cast<u32>(index);
    }
    const u32 index = cast<u32>(pages.size());
    pages.push_back(page);
    return index;
}

class PreparedGlyph{
    public Rect rectangle = Rect();
    public Rect uv = Rect();
    public SharedSdfAtlasPage sdfPage = SharedSdfAtlasPage();
    public u32 pageIndex = 0u;
    public u32 channel = 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TextService : NoCopy{
    private TextShaper m_shaper = TextShaper();
    private GlyphAtlas m_atlas = GlyphAtlas();
    private Vector<SharedGlyphPage> m_pages;
    private Vector<SharedSdfAtlasPage> m_sdfPages;
    private u64 m_identity = AllocateServiceIdentity();
    private u64 m_generation = 0u;

    public TextService(){
        this.m_pages.reserve(s_GlyphAtlasMaxPages);
        this.m_sdfPages.reserve(s_PaintMaxImages);
    }

    public u64 identity()const{ return this.m_identity; }
    public u64 generation()const{ return this.m_generation; }

    [cpp_unwind]
    public b8 setFonts(in Span<FontSource> sources){
        if(this.m_generation == u64.max || !this.m_shaper.setFonts(sources))
            return false;
        this.m_pages.clear();
        this.m_sdfPages.clear();
        this.m_atlas.reset();
        ++this.m_generation;
        return true;
    }

    [cpp_unwind, owner_result]
    public Expected<TextLayout, TextLayoutStatus> layout(in ShapeRequest request){
        TextLayout target;
        return target.shape(request, this.m_shaper);
    }

    [cpp_unwind]
    public Expected<Rect> measure(in TextLayout layout, in DisplayMetrics display){
        if(layout.lines().empty())
            return MakeUnexpected(Failure());
        const Expected<TextRasterMetrics> rasterMetrics = TryResolveTextRasterMetrics(layout.fontSize(), display);
        if(!rasterMetrics.has_value())
            return MakeUnexpected(Failure());
        const TextRasterMetrics raster = rasterMetrics.value();
        VectorDouble bounds = ComputeInitialMeasuredTextBounds(layout.measure(), layout.inkBounds());
        for(in PlacedGlyph glyph : layout.glyphs()){
            const SharedBakedFontAtlas atlas = SelectAtlas(glyph, raster.physicalSize);
            if(atlas.valid()){
                const Expected<VectorDouble> support = LoadSdfSupport(glyph, atlas.deref(), layout.fontSize(), display);
                if(!support.has_value())
                    return MakeUnexpected(Failure());
                ExpandMeasuredTextBoundsWithSdfSupport(support.value(), bounds);
                continue;
            }
            if(!glyph.face.valid() || !glyph.face.deref().valid())
                return MakeUnexpected(Failure());
            const Optional<in AtlasGlyph> cached = this.m_atlas.find(glyph.face, glyph.glyphId, raster.pixelSize);
            Rect rectangle = Rect();
            if(cached.has_value())
                rectangle = MakeCachedCoverageGlyphBounds(cached.value().bearingX, cached.value().bearingY, cached.value().pixels);
            else{
                const Expected<Rect> measured = glyph.face.deref().rasterBounds(glyph.glyphId, raster.pixelSize);
                if(!measured.has_value())
                    return MakeUnexpected(Failure());
                rectangle = measured.value();
            }
            ExpandMeasuredTextBoundsWithRaster(glyph.position, rectangle, raster.rasterScale, display, bounds);
        }
        return TryMakeMeasuredTextRect(bounds.x, bounds.y, bounds.z, bounds.w);
    }

    [cpp_unwind]
    public b8 paint(mut PaintBuilder paint, in TextLayout layout, in Point topLeft){
        return this.paint(paint, layout, topLeft, Color());
    }

    [cpp_unwind]
    public b8 paint(mut PaintBuilder paint, in TextLayout layout, in Point topLeft, in Color color){
        const DisplayMetrics display = paint.displayMetrics();
        const Expected<TextRasterMetrics> rasterMetrics = TryResolveTextRasterMetrics(layout.fontSize(), display);
        if(layout.lines().empty() || !rasterMetrics.has_value() || !IsValidTextPaintOriginAndColor(topLeft, color))
            return false;
        const Rect clip = paint.currentClip();
        const TextGlyphIntersection clipStatus = TryIntersectTextRects(clip, clip);
        if(clipStatus == TextGlyphIntersection::Invalid)
            return false;
        if(clipStatus == TextGlyphIntersection::Invisible || color.a == 0.0f)
            return true;
        const TextRasterMetrics raster = rasterMetrics.value();
        const Point deviceScale = MakeDisplayPixelScalePoint(display);
        Vector<usize> candidates;
        candidates.reserve(layout.glyphs().size());
        for(usize index = 0u; index < layout.glyphs().size(); ++index){
            in PlacedGlyph glyph = layout.glyphs()[index];
            const SharedBakedFontAtlas atlas = SelectAtlas(glyph, raster.physicalSize);
            const TextGlyphIntersection status = Candidate(glyph, atlas, layout.fontSize(), raster.rasterPpem, topLeft, clip, deviceScale);
            if(status == TextGlyphIntersection::Invalid)
                return false;
            if(status == TextGlyphIntersection::Visible)
                candidates.push_back(index);
        }
        if(candidates.empty())
            return true;
        for(in usize index : candidates){
            in PlacedGlyph glyph = layout.glyphs()[index];
            if(!SelectAtlas(glyph, raster.physicalSize).valid() && !this.m_atlas.prepare(glyph.face, glyph.glyphId, raster.pixelSize))
                return false;
        }
        Vector<PreparedGlyph> prepared;
        prepared.reserve(candidates.size());
        for(in usize index : candidates){
            in PlacedGlyph glyph = layout.glyphs()[index];
            PreparedGlyph item;
            const SharedBakedFontAtlas atlas = SelectAtlas(glyph, raster.physicalSize);
            if(atlas.valid()){
                const Expected<Rect> rectangle = AtlasRectangle(glyph, atlas.deref(), layout.fontSize(), topLeft);
                if(!rectangle.has_value())
                    return false;
                item.rectangle = rectangle.value();
                if(HasPositivePreparedGlyphExtent(item.rectangle)){
                    in FontAtlasGlyph record = atlas.deref().glyph(glyph.glyphId);
                    item.sdfPage = atlas.deref().page(record.group);
                    item.channel = record.channel;
                    in SdfAtlasPageBindingRecord<Font> binding = item.sdfPage.deref().binding();
                    item.uv = ResolveSdfGlyphUv(record, binding.width, binding.height);
                }
            }
            else{
                const Optional<in AtlasGlyph> slot = this.m_atlas.find(glyph.face, glyph.glyphId, raster.pixelSize);
                if(!slot.has_value()){
                    [essential] assert(false, "Prepared UI glyph must be present");
                    return false;
                }
                in AtlasGlyph record = slot.value();
                const Expected<Rect> rectangle = CoverageRectangle(glyph, record, raster.rasterScale, topLeft, deviceScale);
                if(!rectangle.has_value())
                    return false;
                item.rectangle = rectangle.value();
                item.pageIndex = record.pageIndex;
                item.uv = ResolveCoverageGlyphUv(record.pixels);
            }
            const TextGlyphIntersection status = TryIntersectTextRects(item.rectangle, clip);
            if(status == TextGlyphIntersection::Invalid)
                return false;
            if(status == TextGlyphIntersection::Visible)
                prepared.push_back(item);
        }
        if(prepared.empty())
            return true;
        this.m_pages.clear();
        this.m_sdfPages.clear();
        for(mut PreparedGlyph glyph : prepared){
            if(glyph.sdfPage.valid())
                glyph.pageIndex = InternPreparedPage<SdfAtlasPage>(this.m_sdfPages, glyph.sdfPage);
            else{
                const Expected<SharedGlyphPage> page = this.m_atlas.page(glyph.pageIndex);
                if(!page.has_value())
                    return false;
                glyph.pageIndex = InternPreparedPage<GlyphPage>(this.m_pages, page.value());
            }
        }
        if(!paint.prepareImages(Span<SharedGlyphPage>(this.m_pages), Span<SharedSdfAtlasPage>(this.m_sdfPages)))
            return false;
        for(in PreparedGlyph glyph : prepared){
            b8 drawn = false;
            if(glyph.sdfPage.valid())
                drawn = paint.drawSdfGlyph(this.m_sdfPages[glyph.pageIndex], glyph.channel, glyph.rectangle, glyph.uv, color);
            else
                drawn = paint.drawGlyph(this.m_pages[glyph.pageIndex], glyph.rectangle, glyph.uv, color);
            if(!drawn){
                [essential] assert(false, "Admitted UI glyph draw must succeed");
                return false;
            }
        }
        return true;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

