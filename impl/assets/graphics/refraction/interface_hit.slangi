////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_REFRACTION_INTERFACE_HIT_SLANGI
#define NWB_GRAPHICS_REFRACTION_INTERFACE_HIT_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "../raytrace/surface_hit.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Refraction admits the nearest retained boundary. Rejected faces/instances do not need a material.
NwbRayTraceSurfaceHit nwbRefractionClosestEntryInterface(const uint instanceMaterialHeapSlot, const float3 origin, const float3 direction, const float minDistance, const float maxDistance){
    const NwbRayTraceGeometryHit geometry = nwbRayTraceClosestGeometryHit(origin, direction, minDistance, maxDistance);
#if NWB_RT_CSG_ENABLED
    if(geometry.failure != 0u)
        return nwbRayTraceReconstructSurfaceHit(instanceMaterialHeapSlot, origin, direction, geometry);
#endif
    if(!geometry.hit || !geometry.frontFace){
        NwbRayTraceSurfaceHit rejected = (NwbRayTraceSurfaceHit)0;
#if NWB_RT_CSG_ENABLED && NWB_REFRACTION_DIAGNOSTICS
        rejected.queryBudgetUnits = geometry.queryBudgetUnits;
        rejected.physicalQueries = geometry.physicalQueries;
#endif
        return rejected;
    }
    return nwbRayTraceReconstructValidatedSurfaceHit(instanceMaterialHeapSlot, origin, direction, geometry);
}

NwbRayTraceSurfaceHit nwbRefractionClosestExitInterface(const uint instanceMaterialHeapSlot, const float3 origin, const float3 direction, const float minDistance, const float maxDistance, const uint primaryInstance, out NwbRayTraceGeometryHit outGeometry){
    outGeometry = nwbRayTraceClosestGeometryHit(origin, direction, minDistance, maxDistance);
#if NWB_RT_CSG_ENABLED
    if(outGeometry.failure != 0u)
        return nwbRayTraceReconstructSurfaceHit(instanceMaterialHeapSlot, origin, direction, outGeometry);
#endif
    if(!outGeometry.hit || outGeometry.instance != primaryInstance || outGeometry.frontFace){
        NwbRayTraceSurfaceHit rejected = (NwbRayTraceSurfaceHit)0;
#if NWB_RT_CSG_ENABLED && NWB_REFRACTION_DIAGNOSTICS
        rejected.queryBudgetUnits = outGeometry.queryBudgetUnits;
        rejected.physicalQueries = outGeometry.physicalQueries;
#endif
        return rejected;
    }
    return nwbRayTraceReconstructValidatedSurfaceHit(instanceMaterialHeapSlot, origin, direction, outGeometry);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

