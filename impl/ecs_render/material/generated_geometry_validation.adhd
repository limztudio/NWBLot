#include <impl/ecs_render/material/renderer_draw_types.adhd>
#include <impl/ecs_render/material/compute_emulation_output_index.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsAliasFreeCaptureCountConsistent(in usize drawCount, in usize outputBufferCount, in usize outputHeapSlotCount){
    return drawCount != 0u && drawCount == outputBufferCount && outputBufferCount == outputHeapSlotCount;
}

class AliasFreeComputeEmulationGraphPlan{
    public Vector<MaterialPassDrawItem> drawItems;
    public Vector<BufferHandle> outputBuffers;
    public Vector<GeneratedGeometryOutputLayout> outputLayouts;
    public Vector<u32> outputHeapSlots;
    public b8 captured = false;

    public void reset(){
        this.drawItems.clear();
        this.outputBuffers.clear();
        this.outputLayouts.clear();
        this.outputHeapSlots.clear();
        this.captured = false;
    }

    [cpp_unwind]
    public b8 capture(in MaterialPassDrawItemsView source, in b8 requireCsg){
        this.reset();
        const usize count = source.computeDrawItems.size();
        if(count == 0u)
            return false;
        this.drawItems.reserve(count);
        this.outputBuffers.reserve(count);
        this.outputLayouts.reserve(count);
        this.outputHeapSlots.reserve(count);
        MaterialPassEmulationOutputIndex<MaterialEmulationBufferIdentity> buffers;
        MaterialPassEmulationOutputIndex<u32> slots;
        for(in MaterialPassDrawItem item : source.computeDrawItems){
            in MaterialPassMeshResourceSnapshot mesh = item.mesh();
            if((item.pipelineKey.csgMode != MaterialPipelineCsgMode::None) != requireCsg
                || !mesh.emulationVertexBuffer.valid() || !mesh.emulationVertexHeapHandle.valid()
                || !buffers.insert(MaterialEmulationBufferIdentity(mesh.emulationVertexBuffer)) || !slots.insert(mesh.emulationVertexHeapHandle.slot())){
                this.reset();
                return false;
            }
            this.drawItems.push_back(item);
            this.outputBuffers.push_back(mesh.emulationVertexBuffer);
            this.outputLayouts.push_back(MakeGeneratedGeometryOutputLayout(mesh.emulationIndexByteOffset, item.pipeline().indexedGeometryOutput));
            this.outputHeapSlots.push_back(mesh.emulationVertexHeapHandle.slot());
        }
        this.captured = IsAliasFreeCaptureCountConsistent(this.drawItems.size(), this.outputBuffers.size(), this.outputHeapSlots.size());
        return this.captured;
    }

    public b8 matches()const{
        return MatchesRetainedGeneratedGeometryOutputs(this.captured, this.drawItems, this.outputBuffers, this.outputLayouts, this.outputHeapSlots);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

