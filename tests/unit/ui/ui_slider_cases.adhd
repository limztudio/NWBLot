    const u64 token = self.m_state.inputGeneration();
    ASSERT_TRUE(self.declare(2u));
    ASSERT_TRUE(self.m_state.setValue(0.9));
    ASSERT_TRUE(self.m_state.setValue(0.25));
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_NE(self.m_state.inputGeneration(), token);
    EXPECT_DOUBLE_EQ(self.m_state.value(), 0.25);
    EXPECT_FALSE(self.m_state.result().valid);
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    self.expectAccepted(displayed);
}

void VerifyUiSliderLifetimeTests_ChangingKeyStepRetiresAHeldKeyBeforeApplyingItsCopiedRepeat(mut UiSliderLifetimeTests self){
    ASSERT_TRUE(self.accept(1u));
    self.press(UiSliderKey::Tab);
    InputEvent held = InputEvent();
    held.type = InputEventType::KeyDown;
    held.key = UiSliderKey::Right;
    EXPECT_TRUE(self.send(held).commandConsumed);
    ASSERT_TRUE(self.accept(2u));
    EXPECT_DOUBLE_EQ(self.m_state.value(), 0.375);
    held.repeat = true;
    EXPECT_TRUE(self.send(held).commandConsumed);
    SliderOptions coarse = MakeSliderFixtureOptions();
    coarse.keyStep = 0.25;
    ASSERT_TRUE(self.accept(3u, coarse));
    EXPECT_DOUBLE_EQ(self.m_state.value(), 0.375);
    EXPECT_FALSE(self.m_state.result().valueChanged);
    EXPECT_TRUE(self.send(held).commandConsumed);
    ASSERT_TRUE(self.accept(4u, coarse));
    EXPECT_DOUBLE_EQ(self.m_state.value(), 0.375);
    held.type = InputEventType::KeyUp;
    EXPECT_TRUE(self.send(held).commandConsumed);
    self.press(UiSliderKey::Right);
    ASSERT_TRUE(self.accept(5u, coarse));
    EXPECT_DOUBLE_EQ(self.m_state.value(), 0.625);
}

