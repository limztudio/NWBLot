////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_ui/toolkit/id.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class WidgetStateIndexPolicy{
    private b8 validTouchRequest(in WidgetId id, in WidgetRoot root, in WidgetKind kind, in u64 frameGeneration)const{
        return id.valid() && root.generation != 0u && frameGeneration != 0u && cast<u8>(kind) <= cast<u8>(WidgetKind::Image);
    }

    private b8 canTouchExisting(in WidgetState entry, in WidgetRoot root, in u64 frameGeneration)const{
        return entry.root == root && entry.lastSeenFrame != frameGeneration;
    }

    public b8 matchesDeclaration(
        in b8 rootActive,
        in WidgetRoot activeRoot,
        in u64 frameGeneration,
        in WidgetState state,
        in WidgetState current
    )const{
        return
            rootActive
            && state.root == activeRoot
            && state.lastSeenFrame == frameGeneration
            && current.root == state.root
            && current.declarationGeneration == state.declarationGeneration
            && current.lastSeenFrame == state.lastSeenFrame
            && current.kind == state.kind
        ;
    }

    private b8 rebuildIndex(in Span<WidgetState> entries, mut HashMap<u64, usize> outIndex)const{
        outIndex.clear();
        for(usize index = 0u; index < entries.size(); ++index){
            if(!outIndex.try_emplace(entries[index].id.value, index).second)
                return false;
        }
        return true;
    }

    public b8 refreshIndex(in Span<WidgetState> entries, mut HashMap<u64, usize> indexById, mut b8 dirty)const{
        if(!dirty)
            return true;
        if(!this.rebuildIndex(entries, indexById))
            return false;
        dirty = false;
        return true;
    }

    public Expected<usize> lookup(in Span<WidgetState> entries, in WidgetId id, in HashMap<u64, usize> indexById)const{
        const auto found = indexById.find(id.value);
        if(found == indexById.end())
            return MakeUnexpected(Failure());
        const usize index = found.value();
        [essential] assert(index < entries.size() && entries[index].id == id);
        return index;
    }

    public Expected<usize> findIndex(
        in Span<WidgetState> entries,
        in WidgetId id,
        mut HashMap<u64, usize> inOutIndex,
        mut b8 inOutIndexDirty,
        mut b8 outInvariantFailed
    )const{
        outInvariantFailed = !this.refreshIndex(entries, inOutIndex, inOutIndexDirty);
        if(outInvariantFailed)
            return MakeUnexpected(Failure());
        return this.lookup(entries, id, inOutIndex);
    }

    public void eraseAt(
        in usize index,
        mut Vector<WidgetState> inOutEntries,
        mut b8 outIndexDirty
    )const{
        if(index >= inOutEntries.size())
            return;
        for(usize i = index; i + 1u < inOutEntries.size(); ++i)
            inOutEntries[i] = inOutEntries[i + 1u];
        inOutEntries.pop_back();
        outIndexDirty = true;
    }

    public void compactRetireUnseen(
        in u64 frameGeneration,
        mut Vector<WidgetState> inOutEntries,
        mut b8 outIndexDirty,
        mut Vector<WidgetId> outRetiredIds
    )const{
        outRetiredIds.clear();
        usize kept = 0u;
        for(usize index = 0u; index < inOutEntries.size(); ++index){
            in WidgetState entry = inOutEntries[index];
            if(entry.lastSeenFrame != frameGeneration){
                outRetiredIds.push_back(entry.id);
                continue;
            }
            if(kept != index)
                inOutEntries[kept] = entry;
            ++kept;
        }
        if(!outRetiredIds.empty()){
            inOutEntries.resize(kept);
            outIndexDirty = true;
        }
    }

    public void compactRetainRoots(
        in HashSet<WidgetRoot> retainedRoots,
        mut Vector<WidgetState> inOutEntries,
        mut b8 outIndexDirty,
        mut Vector<WidgetId> outRetiredIds
    )const{
        outRetiredIds.clear();
        usize kept = 0u;
        for(usize index = 0u; index < inOutEntries.size(); ++index){
            in WidgetState entry = inOutEntries[index];
            if(!retainedRoots.contains(entry.root)){
                outRetiredIds.push_back(entry.id);
                continue;
            }
            if(kept != index)
                inOutEntries[kept] = entry;
            ++kept;
        }
        if(!outRetiredIds.empty()){
            inOutEntries.resize(kept);
            outIndexDirty = true;
        }
    }

    public Expected<usize> touch(
        in WidgetId id,
        in WidgetRoot root,
        in WidgetKind kind,
        in u64 frameGeneration,
        mut Vector<WidgetState> inOutEntries,
        mut HashMap<u64, usize> inOutIndex,
        mut u64 inOutNextDeclarationGeneration,
        mut b8 inOutIndexDirty,
        mut b8 outInvariantFailed,
        mut b8 outKindChanged
    )const{
        outInvariantFailed = false;
        outKindChanged = false;
        if(!this.validTouchRequest(id, root, kind, frameGeneration))
            return MakeUnexpected(Failure());
        const Expected<usize> foundIndex = this.findIndex(inOutEntries, id, inOutIndex, inOutIndexDirty, outInvariantFailed);
        if(outInvariantFailed)
            return MakeUnexpected(Failure());
        if(foundIndex.has_value()){
            const usize index = foundIndex.value();
            WidgetState entry = inOutEntries[index];
            outKindChanged = entry.kind != kind;
            if(!this.canTouchExisting(entry, root, frameGeneration))
                return MakeUnexpected(Failure());
            if(entry.kind != kind){
                if(inOutNextDeclarationGeneration == u64.max){
                    outInvariantFailed = true;
                    return MakeUnexpected(Failure());
                }
                entry.declarationGeneration = inOutNextDeclarationGeneration;
                ++inOutNextDeclarationGeneration;
                entry.kind = kind;
            }
            entry.lastSeenFrame = frameGeneration;
            inOutEntries[index] = entry;
            return index;
        }
        if(inOutEntries.size() >= s_WidgetStateRetainedCapacity)
            return MakeUnexpected(Failure());
        if(inOutNextDeclarationGeneration == u64.max){
            outInvariantFailed = true;
            return MakeUnexpected(Failure());
        }
        const usize newIndex = inOutEntries.size();
        inOutEntries.push_back(WidgetState(id, root, inOutNextDeclarationGeneration, frameGeneration, kind));
        if(!inOutIndex.try_emplace(id.value, newIndex).second){
            inOutEntries.pop_back();
            outInvariantFailed = true;
            return MakeUnexpected(Failure());
        }
        ++inOutNextDeclarationGeneration;
        return newIndex;
    }

    public Expected<usize> touch(
        in WidgetId id,
        in WidgetRoot root,
        in WidgetKind kind,
        in u64 frameGeneration,
        mut Vector<WidgetState> inOutEntries,
        mut HashMap<u64, usize> inOutIndex,
        mut u64 inOutNextDeclarationGeneration,
        mut b8 inOutIndexDirty,
        mut b8 outInvariantFailed
    )const{
        b8 kindChanged = false;
        return this.touch(id, root, kind, frameGeneration, inOutEntries, inOutIndex, inOutNextDeclarationGeneration, inOutIndexDirty, outInvariantFailed, kindChanged);
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

