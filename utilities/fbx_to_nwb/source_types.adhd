#include <utilities/fbx_to_nwb/types.adhd>
#include <utilities/fbx_to_nwb/ufbx_sdk.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type JointMatrix = f32x3x4u;

static_assert(size_of<MeshSkinInfluence>() == size_of<u16>() * s_SkinInfluenceJointCount + size_of<f32x4u>());
static_assert(align_of<MeshSkinInfluence>() <= align_of<f32>());
static_assert(is_trivially_copyable<MeshSkinInfluence>());
static_assert(size_of<JointMatrix>() == size_of<f32>() * s_SkeletonJointMatrixFloatCount);
static_assert(align_of<JointMatrix>() == align_of<f32>());
static_assert(is_trivially_copyable<JointMatrix>());
static_assert(is_trivially_copyable<SourceVertexRef>());
static_assert(is_trivially_copyable<SourceTriangleCorner>());

class SourceMeshStreams{
    public Vector<Vec3> positions;
    public Vector<Vec3> normals;
    public Vector<Vec4> tangents;
    public Vector<Vec2> uv0;
    public Vector<Vec4> colors;
    public Vector<MeshSkinInfluence> skin;
    public Vector<SourceVertexRef> vertexRefs;
    public Vector<u32> indices;
}

class MeshBuildResult{
    public SourceMeshStreams mesh;
    public Vector<UfbxNode> skeletonJoints;
    public Vector<JointMatrix> skeletonBindPoseMatrices;
    public Vector<JointMatrix> inverseBindMatrices;
    public b8 sawVertexColors = false;
    public b8 sawVertexUvs = false;
    public SourceTangentReport tangentReport;
}

class ImportOptions{
    public String inputPath;
    public String outputPath;
    public String assetType = String(s_DefaultOutputAssetTypeText);
    public String virtualRoot = String(s_DefaultVirtualRootText);
    public String meshSelector = String(s_DefaultMeshSelectorText);
    public String normalMode = String(s_DefaultNormalModeText);
    public String defaultColorText = String(s_DefaultColorText);
    public f64 scale = s_DefaultImportScale;
    public f64 triangleAreaLengthSquaredEpsilon = s_DefaultTriangleAreaLengthSquaredEpsilon;
    public b8 preserveSpace = false;
    public b8 includeHidden = false;
    public b8 bakeTransforms = true;
    public b8 importColors = true;
    public b8 flipWinding = false;
    public b8 separateAssets = false;
    public b8 refreshNwb = false;
    public b8 forceOverwrite = false;
    public b8 acceptDefaults = false;
    public b8 listMeshes = false;
}

class MeshInstance{
    public UfbxNode node;
    public UfbxMesh mesh;
    public usize index = 0u;
}

class FbxSkinExportContext{
    public Vector<UfbxNode> joints;
    public Vector<JointMatrix> bindPoseMatrices;
    public Vector<JointMatrix> inverseBindMatrices;
    public HashMap<usize, u16> jointLookup;
}

class SkeletonOutputData{
    public Vector<UfbxNode> joints;
    public Vector<JointMatrix> bindPoseMatrices;
    public Vector<JointMatrix> inverseBindMatrices;
    public Vector<u16> oldToNewJointIndices;
}

class PositionAlignedSkinnedMesh{
    public SourceMeshStreams mesh;
    public Vector<MeshSkinInfluence> skin;
}

SourceMeshStreamCounts CountSourceMeshStreams(in SourceMeshStreams mesh){
    return MakeSourceMeshStreamCounts(
        mesh.positions.size(),
        mesh.normals.size(),
        mesh.tangents.size(),
        mesh.uv0.size(),
        mesh.colors.size(),
        mesh.skin.size(),
        mesh.vertexRefs.size(),
        mesh.indices.size()
    );
}

void ReserveSourceMeshStreamsCapacity(in usize estimatedTriangleCorners, in b8 wantsSkinning, mut SourceMeshStreams outMesh){
    outMesh.positions.reserve(estimatedTriangleCorners);
    outMesh.normals.reserve(estimatedTriangleCorners);
    outMesh.uv0.reserve(estimatedTriangleCorners);
    outMesh.colors.reserve(estimatedTriangleCorners);
    outMesh.tangents.reserve(estimatedTriangleCorners);
    outMesh.indices.reserve(estimatedTriangleCorners);
    outMesh.vertexRefs.reserve(estimatedTriangleCorners);
    if(wantsSkinning)
        outMesh.skin.reserve(estimatedTriangleCorners);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

