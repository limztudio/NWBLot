#include <impl/ecs_render/kernel/task_graph_resource_descs.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


GpuTaskResourceSetUse MakeResourceSetUse(in GpuGraphResourceSetId resources, in ResourceStates state, in GpuTaskResourceAccess access){
    GpuTaskResourceSetUse use;
    use.resourceSet = resources;
    use.requiredState = state;
    use.access = access;
    return use;
}

GpuTaskDesc TaskDesc(in Name identity, in StringView label, in borrow GpuTaskId dependency){
    GpuTaskDesc desc = TaskDesc(identity, label);
    if(dependency.valid())
        desc.setDependency(dependency);
    return desc;
}

GpuTaskExternalStateSource ExternalStateSourceFromCache(in GpuPersistentResourceStateCache cache){
    GpuTaskExternalStateSource result;
    const auto source = cache.borrowSource();
    if(source.has_value())
        result.setState(source.value());
    return result;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

