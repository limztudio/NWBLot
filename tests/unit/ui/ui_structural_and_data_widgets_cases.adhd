class StructuralSplitterTests : WidgetFixture{
    public SplitterState m_splitter;
    public u32 m_firstClicks = 0u;
    public u32 m_secondClicks = 0u;

    public b8 renderSplitter(in u64 generation, in SplitterOptions options, in b8 includeSecond){
        if(!this.panel(generation, "panel", Rect(10.0f, 10.0f, 400.0f, 200.0f)))
            return false;
        if(!this.m_builder.beginSplitter("split", this.m_splitter, options)){
            this.m_builder.endPanel();
            return false;
        }
        if(this.m_builder.button("pane_btn", "First"))
            ++this.m_firstClicks;
        if(includeSecond){
            if(!this.m_builder.splitterSecondPane()){
                this.m_builder.endPanel();
                return false;
            }
            if(this.m_builder.button("pane_btn", "Second"))
                ++this.m_secondClicks;
        }
        if(!this.m_builder.endSplitter()){
            this.m_builder.endPanel();
            return false;
        }
        return this.finishPanel() && this.m_context.commitFrame(generation);
    }
}

class StructuralSpinBoxTests : NumericFixture{
    public ScrollAreaState m_scroll;
    public NumericEditBoxResult m_lastNumeric;

    public b8 renderIntSpin(in u64 generation, in IntegerSpinBoxOptions options){
        if(!this.beginNumeric(generation))
            return false;
        this.m_lastNumeric = this.m_builder.integerSpinBox("spin", this.m_integer, this.m_integerState, options);
        return this.acceptNumeric();
    }

    public b8 renderFloatSpin(in u64 generation, in FloatSpinBoxOptions options){
        if(!this.beginNumeric(generation))
            return false;
        this.m_lastNumeric = this.m_builder.floatSpinBox("spin", this.m_float, this.m_floatState, options);
        return this.acceptNumeric();
    }

    public b8 renderIntSpinInScroll(in u64 generation, in IntegerSpinBoxOptions options){
        if(!this.beginNumeric(generation))
            return false;
        ScrollAreaOptions saOpts;
        saOpts.width = LayoutSize(LayoutSizePolicy::Fixed, 300.0f);
        saOpts.height = LayoutSize(LayoutSizePolicy::Fixed, 120.0f);
        if(!this.m_builder.beginScrollArea("scroll", this.m_scroll, saOpts))
            return false;
        this.m_builder.label("top_pad", "Spacer 1");
        this.m_lastNumeric = this.m_builder.integerSpinBox("spin", this.m_integer, this.m_integerState, options);
        for(u32 i = 0u; i < 8u; ++i){
            String lbl;
            lbl.assign("sp_");
            AppendUnsignedU64Text(lbl, cast<u64>(i));
            this.m_builder.label(StringView(lbl), "Spacer");
        }
        if(!this.m_builder.endScrollArea())
            return false;
        return this.acceptNumeric();
    }
}

class TestTreeNodeData{
    public u64 key = 0u;
    public u64 parentKey = 0u;
    public String label;
    public b8 hasChildren = false;
    public b8 enabled = true;
}

class TestTreeDataSource : ITreeDataSource{
    public Vector<TestTreeNodeData> m_nodes;
    public u64 m_generation = 3101u;
    public u64 m_revision = 1u;
    public b8 m_duplicateChildKey = false;
    public b8 m_selfCycle = false;

    public void addNode(in u64 key, in u64 parentKey, in StringView labelText, in b8 hasChildren, in b8 enabled){
        TestTreeNodeData node;
        node.key = key;
        node.parentKey = parentKey;
        node.label.assign(labelText);
        node.hasChildren = hasChildren;
        node.enabled = enabled;
        this.m_nodes.push_back(node);
    }

    public u64 instanceGeneration()const override{ return this.m_generation; }
    public u64 revision()const override{ return this.m_revision; }

    public u64 childCount(in u64 parentKey)const override{
        if(this.m_selfCycle && parentKey == 10u)
            return 1u;
        u64 count = 0u;
        for(in TestTreeNodeData n : this.m_nodes){
            if(n.parentKey == parentKey)
                ++count;
        }
        if(this.m_duplicateChildKey && parentKey == 0u && count > 1u)
            return 2u;
        return count;
    }

    public u64 childKey(in u64 parentKey, in u64 childIndex)const override{
        if(this.m_selfCycle && parentKey == 10u && childIndex == 0u)
            return 10u;
        if(this.m_duplicateChildKey && parentKey == 0u)
            return this.m_nodes[0u].key;
        u64 seen = 0u;
        for(in TestTreeNodeData n : this.m_nodes){
            if(n.parentKey == parentKey){
                if(seen == childIndex)
                    return n.key;
                ++seen;
            }
        }
        return 0u;
    }

    public b8 hasChildren(in u64 nodeKey)const override{
        if(this.m_selfCycle && nodeKey == 10u)
            return true;
        for(in TestTreeNodeData n : this.m_nodes){
            if(n.key == nodeKey)
                return n.hasChildren;
        }
        return false;
    }

    public StringView label(in u64 nodeKey)const override{
        for(in TestTreeNodeData n : this.m_nodes){
            if(n.key == nodeKey)
                return StringView(n.label);
        }
        return "";
    }

    public b8 enabled(in u64 nodeKey)const override{
        for(in TestTreeNodeData n : this.m_nodes){
            if(n.key == nodeKey)
                return n.enabled;
        }
        return false;
    }
}

