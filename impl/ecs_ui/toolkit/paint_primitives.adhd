type PaintVector<T> = Vector<T>;

const f32 s_RectCenterFraction = 0.5f;
const f64 s_RectCenterFractionF64 = 0.5;
const f32 s_UiMaxFloat = 3.40282346638528859812e+38f;
const f64 s_UiMaxFloatF64 = cast<f64>(s_UiMaxFloat);
const usize s_PaintMaxImages = 64u;
const usize s_PaintMaxOverlayDepth = 16u;
const usize s_PaintDefaultClipDepth = 8u;
const usize s_PaintMaxTransformDepth = 32u;
const u32 s_PaintQuadVertexCount = 4u;
const u32 s_PaintQuadIndexCount = 6u;
const u32 s_PaintNineSliceAxisCells = 3u;
const usize s_PaintCallbackInlineBytes = 64u;
const u32 s_PaintZOrderSentinelLayer = 0xffffffffu;
const usize s_PaintMaxGradientStops = 16u;
const usize s_PaintMaxAnalyticClipDepth = 8u;
const usize s_PaintMaxOpacityDepth = 16u;
const usize s_PaintMaxBlendModeDepth = 16u;
const usize s_PaintMaxEffectLayers = 8u;
const usize s_PaintBlendModeCount = 6u;
const f32 s_PaintMaxBlurRadius = 64.0f;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> PaintMaterial{
    Solid,
    Skin,
    Glyph,
    SdfGlyph,
    Image,
    ColorGlyph,
    Gradient,
    DropShadow,
    Blur,
    EffectLayerComposite,
}

enum<u8> UiRectPrecision{
    RoundedEndpoints,
    BoundedEndpoints,
    PreciseExtents,
    EmptyPaint,
}

enum<u8> PaintBlendMode{
    Normal = 0u,
    Additive = 1u,
    Multiply = 2u,
    Screen = 3u,
    Erase = 4u,
    Replace = 5u,
}

enum<u8> PaintFillRule{
    NonZero = 0u,
    EvenOdd = 1u,
}

enum<u8> PaintGradientKind{
    Linear = 0u,
    Radial = 1u,
    Conic = 2u,
}

enum<u8> PaintGradientSpread{
    Clamp = 0u,
    Repeat = 1u,
    Mirror = 2u,
}

enum<u8> PaintClipShapeKind{
    None = 0u,
    RoundedRect = 1u,
    Ellipse = 2u,
}

class Point{
    public f32 x = 0.0f;
    public f32 y = 0.0f;
}

class Rect{
    public f32 x = 0.0f;
    public f32 y = 0.0f;
    public f32 width = 0.0f;
    public f32 height = 0.0f;
}

class Insets{
    public f32 left = 0.0f;
    public f32 top = 0.0f;
    public f32 right = 0.0f;
    public f32 bottom = 0.0f;
}

class Color{
    public f32 r = 1.0f;
    public f32 g = 1.0f;
    public f32 b = 1.0f;
    public f32 a = 1.0f;
}

[serialize]
class Vertex{
    public Point position;
    public Point texCoord;
    public Color color;
}

class DisplayMetrics{
    public f32 logicalWidth = 0.0f;
    public f32 logicalHeight = 0.0f;
    public f32 pixelScaleX = 1.0f;
    public f32 pixelScaleY = 1.0f;
}

class DrawCommand{
    public Rect clip;
    public u32 firstIndex = 0u;
    public u32 indexCount = 0u;
    public u32 glyphPageIndex = 0xffffffffu;
    public u32 sdfPageIndex = 0xffffffffu;
    public u32 sdfChannel = 0u;
    public u32 layer = 0u;
    public u32 zOrder = 0u;
    public u32 textureImageIndex = 0xffffffffu;
    public PaintMaterial material = PaintMaterial::Solid;
    public u32 effectOffset = 0xffffffffu;
    public u32 clipMaskOffset = 0xffffffffu;
    public PaintBlendMode blendMode = PaintBlendMode::Normal;
}

class ResolvedGlyphDraw{
    public Rect rectangle;
    public Rect uv;
    public u32 pageIndex = u32.max;
    public u32 channel = 0u;
    public b8 isSdf = false;
    public b8 isColor = false;
}

enum<u8> PaintLineCap{
    Butt = 0u,
    Square = 1u,
    Round = 2u,
}

enum<u8> PaintLineJoin{
    Miter = 0u,
    Bevel = 1u,
    Round = 2u,
}

class PaintLineStyle{
    public f32 thickness = 1.0f;
    public PaintLineCap cap = PaintLineCap::Butt;
    public PaintLineJoin join = PaintLineJoin::Miter;
    public f32 miterLimit = 4.0f;
    public f32 dashLength = 0.0f;
    public f32 gapLength = 0.0f;
    public f32 dashOffset = 0.0f;
    public b8 antiAlias = false;
}

class PaintTransform2D{
    public f32 m00 = 1.0f;
    public f32 m01 = 0.0f;
    public f32 tx = 0.0f;
    public f32 m10 = 0.0f;
    public f32 m11 = 1.0f;
    public f32 ty = 0.0f;
}

class PaintLineSegment{
    public Point start = Point(0.0f, 0.0f);
    public Point end = Point(0.0f, 0.0f);
    public Color color = Color(1.0f, 1.0f, 1.0f, 1.0f);
    public f32 thickness = 0.0f;
}

class SkinBindingRecord<TUiSkin, TTexture>{
    public AssetRef<TUiSkin> skin;
    public AssetRef<TTexture> texture;
    public u64 generation = 0u;
    public u32 atlasWidth = 0u;
    public u32 atlasHeight = 0u;
    public f32 referenceDensity = 1.0f;
}

type SkinBinding = SkinBindingRecord<UiSkin, Texture>;

class PaintOverlayFrame{
    public usize clipDepth = 0u;
    public usize transformBase = 0u;
    public usize transformDepth = 0u;
    public usize opacityDepth = 0u;
    public usize opacityBase = 0u;
    public usize blendModeDepth = 0u;
    public usize blendModeBase = 0u;
    public f32 savedOpacity = 1.0f;
    public PaintBlendMode savedBlendMode = PaintBlendMode::Normal;
    public u32 layer = 0u;
}

class PaintClipEntry{
    public Rect rect;
    public f32 right = 0.0f;
    public f32 bottom = 0.0f;
    public u32 clipMaskOffset = 0xffffffffu;
    public PaintBlendMode blendMode = PaintBlendMode::Normal;
}

class PaintGradientStop{
    public f32 offset = 0.0f;
    public Color color = Color(1.0f, 1.0f, 1.0f, 1.0f);
}

class PaintGradient{
    public PaintGradientKind kind = PaintGradientKind::Linear;
    public PaintGradientSpread spread = PaintGradientSpread::Clamp;
    public Point start = Point(0.0f, 0.0f);
    public Point end = Point(1.0f, 0.0f);
    public f32 startRadius = 0.0f;
    public f32 endRadius = 1.0f;
    public f32 startAngle = 0.0f;
    public Array<PaintGradientStop, s_PaintMaxGradientStops> stops;
    public u32 stopCount = 0u;

    public b8 addStop(in f32 offset, in Color color){
        if(cast<usize>(this.stopCount) >= s_PaintMaxGradientStops)
            return false;
        if(!IsFinite(VectorSingle(offset)) || !IsFinite(VectorSingle(color.r, color.g, color.b, color.a)) || color.a < 0.0f || color.a > 1.0f)
            return false;
        this.stops[cast<usize>(this.stopCount)].offset = UiSimdClamp(offset, 0.0f, 1.0f);
        this.stops[cast<usize>(this.stopCount)].color = color;
        ++this.stopCount;
        return true;
    }
}

class PaintShadowStyle{
    public Point offset = Point(0.0f, 4.0f);
    public f32 blurRadius = 8.0f;
    public f32 spread = 0.0f;
    public Color color = Color(0.0f, 0.0f, 0.0f, 0.35f);
    public b8 inset = false;
}

class PaintEffectLayer{
    public Rect bounds;
    public Rect expandedBounds;
    public Rect clip;
    public u32 commandBegin = 0u;
    public u32 commandEnd = 0u;
    public u32 blurFirstIndex = 0u;
    public u32 blurHorizontalOffset = 0xffffffffu;
    public u32 blurVerticalOffset = 0xffffffffu;
    public u32 clipMaskOffset = 0xffffffffu;
    public f32 opacity = 1.0f;
    public f32 blurRadius = 0.0f;
    public PaintBlendMode blendMode = PaintBlendMode::Normal;
}


