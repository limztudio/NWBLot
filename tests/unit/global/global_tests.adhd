void VerifyGlobal_DiagnosticEventHookRejectsReentryAndHonorsBoundedText(){
    const StringView unitCategory = s_GlobalDiagnosticUnit;
    native(in unitCategory){
        using namespace __hidden_diagnostic_event_tests;
        ResetDiagnosticEventCapture();

        const auto callback = MakeNotNull<DiagnosticEventCallback>([](const DiagnosticEventRecord& record)noexcept{
            RecordDiagnosticEvent(record);
            CaptureDiagnosticEvent("recursive", "ignored");
        });

        SetDiagnosticEventCallback(callback.get());
        CaptureDiagnosticEvent(AStringView("unit.trailing").substr(0u, 4u), AStringView("message.trailing").substr(0u, 7u), "diagnostics_test.cpp", 42u);
        ClearDiagnosticEventCallback(callback.get());
        CaptureDiagnosticEvent(unitCategory, "ignored");

        const DiagnosticCaptureSnapshot snapshot = ReadDiagnosticCaptureSnapshot();
        EXPECT_EQ(snapshot.captureCount, 1u);
        ASSERT_NE(snapshot.name.data(), nullptr);
        ASSERT_NE(snapshot.category.data(), nullptr);
        ASSERT_NE(snapshot.expression.data(), nullptr);
        ASSERT_NE(snapshot.message.data(), nullptr);
        ASSERT_NE(snapshot.file.data(), nullptr);
        EXPECT_EQ(snapshot.name, AStringView(""));
        EXPECT_EQ(snapshot.category, AStringView("unit"));
        EXPECT_EQ(snapshot.expression, AStringView(""));
        EXPECT_EQ(snapshot.message, AStringView("message"));
        EXPECT_EQ(DiagnosticEventNameFromCategory("unknown"), StringView{});
    }
}

void VerifyAllocationOwnerConcurrency_CapturesLiveAndRetiringArenasWithoutLosingHistory(){
    const Name owner = s_AllocationOwnerConcurrentLifetimes;
    const usize threadCount = 4u;
    const usize iterations = 256u;
    const u64 expectedAllocations = cast<u64>(threadCount * iterations * 5u);
    const ArenaMemoryStats before = OwnerStats(owner);
    ArenaMemoryStats simultaneouslyLive = ArenaMemoryStats();
    b8 failedValue = false;
    b8 snapshotsConsistent = true;
    native(in owner, in before, mut simultaneouslyLive, mut failedValue, mut snapshotsConsistent){
        using namespace NWB::Core::Alloc;
        using __hidden_allocator_owner_concurrency_tests::WaitForFlag;
        constexpr usize s_ThreadCount = 4u;
        constexpr usize s_Iterations = 256u;
        constexpr u64 s_Allocations = s_ThreadCount * s_Iterations * 5u;
        const usize poolBytes = PersistentArena::StructureAlignedSize(4096u);
        Atomic<b8> failed{ false };
        Atomic<b8> releaseFirstAllocations{ false };
        Atomic<usize> completed{ 0u };
        Latch firstAllocationsReady(s_ThreadCount);
        Array<Thread, s_ThreadCount> workers;

        for(Thread& worker : workers){
            worker = Thread([&owner, &failed, &releaseFirstAllocations, &completed, &firstAllocationsReady, poolBytes](){
                for(usize iteration = 0u; iteration < s_Iterations; ++iteration){
                    {
                        GlobalArena arena(owner);
                        auto* allocation = static_cast<u8*>(arena.allocate(1u, 128u));
                        if(allocation){
                            allocation[0u] = 73u;
                            auto* const replacement = static_cast<u8*>(arena.reallocate(allocation, 1u, 256u));
                            if(replacement)
                                allocation = replacement;
                            else
                                failed.store(true, MemoryOrder::relaxed);
                            if(allocation[0u] != 73u)
                                failed.store(true, MemoryOrder::relaxed);
                        }
                        else
                            failed.store(true, MemoryOrder::relaxed);

                        if(iteration == 0u){
                            firstAllocationsReady.count_down();
                            WaitForFlag(releaseFirstAllocations);
                        }
                        arena.deallocate(allocation, 1u, 256u);
                    }
                    {
                        ScratchArena arena(owner);
                        void* const first = arena.allocate(8u, 64u);
                        void* const second = arena.allocate(8u, 128u);
                        if(!first || !second)
                            failed.store(true, MemoryOrder::relaxed);
                        if(first)
                            arena.deallocate(first, 8u, 64u);
                        // Out-of-order free defers release until arena destruction.
                    }
                    {
                        PersistentArena arena(owner, poolBytes);
                        void* const first = arena.allocate(8u, 64u);
                        void* const second = arena.allocate(8u, 128u);
                        if(!first || !second)
                            failed.store(true, MemoryOrder::relaxed);
                        if(first)
                            arena.deallocate(first, 8u, 64u);
                        // One explicit free and one bulk free must contribute exactly two retired deallocations.
                    }
                }
                completed.fetch_add(1u, MemoryOrder::release);
            });
        }

        firstAllocationsReady.wait();
        simultaneouslyLive = NWB::Tests::OwnerStats(owner);
        releaseFirstAllocations.store(true, MemoryOrder::release);
        ArenaMemoryStats previous = simultaneouslyLive;
        do{
            const ArenaMemoryStats current = NWB::Tests::OwnerStats(owner);
            snapshotsConsistent &= current.allocationCount >= previous.allocationCount;
            snapshotsConsistent &= current.reallocationCount >= previous.reallocationCount;
            snapshotsConsistent &= current.deallocationCount >= previous.deallocationCount;
            snapshotsConsistent &= current.allocationCount - before.allocationCount <= s_Allocations;
            snapshotsConsistent &= current.deallocationCount - before.deallocationCount <= s_Allocations;
            snapshotsConsistent &= current.usedBytes <= s_ThreadCount * 256u;
            snapshotsConsistent &= current.reservedBytes <= s_ThreadCount * poolBytes;
            snapshotsConsistent &= current.peakUsedBytes <= Max<u64>(before.peakUsedBytes, 256u);
            previous = current;
            YieldThread();
        }while(completed.load(MemoryOrder::acquire) != s_ThreadCount);
        for(Thread& worker : workers)
            worker.join();
        failedValue = failed.load(MemoryOrder::relaxed);
    }

    const ArenaMemoryStats after = OwnerStats(owner);
    const u64 expectedPeak = Max(before.peakUsedBytes, cast<u64>(256u));
    EXPECT_FALSE(failedValue);
    EXPECT_TRUE(snapshotsConsistent);
    EXPECT_EQ(simultaneouslyLive.usedBytes, cast<u64>(threadCount * 256u));
    EXPECT_EQ(simultaneouslyLive.reservedBytes, simultaneouslyLive.usedBytes);
    EXPECT_EQ(simultaneouslyLive.peakUsedBytes, expectedPeak);
    EXPECT_EQ(after.usedBytes, before.usedBytes);
    EXPECT_EQ(after.reservedBytes, before.reservedBytes);
    EXPECT_EQ(after.allocationCount - before.allocationCount, expectedAllocations);
    EXPECT_EQ(after.deallocationCount - before.deallocationCount, expectedAllocations);
    EXPECT_EQ(after.reallocationCount - before.reallocationCount, cast<u64>(threadCount * iterations));
    EXPECT_EQ(after.peakUsedBytes, expectedPeak);
}

void VerifyAllocationOwnerConcurrency_CrossThreadRawReallocationAndFreeKeepSettledBackingTotals(){
    const u64 allocationCount = 64u;
    u64 allocatedBytes = 0u;
    b8 failedValue = false;
    ArenaMemoryStats before = ArenaMemoryStats();
    ArenaMemoryStats held = ArenaMemoryStats();
    ArenaMemoryStats settled = ArenaMemoryStats();
    ArenaMemoryStats retired = ArenaMemoryStats();
    native(mut allocatedBytes, mut failedValue, mut before, mut held, mut settled, mut retired){
        using namespace NWB::Core::Alloc;
        using __hidden_allocator_owner_concurrency_tests::WaitForFlag;
        constexpr usize s_AllocationCount = 64u;
        u8* allocations[s_AllocationCount] = {};
        Atomic<b8> failed{ false };
        Atomic<b8> producerReady{ false };
        Atomic<b8> consumerReady{ false };
        Atomic<b8> startProducer{ false };
        Atomic<b8> startConsumer{ false };
        Atomic<b8> produced{ false };
        Atomic<b8> consumed{ false };
        Atomic<b8> releaseWorkers{ false };

        Thread producer([&]()noexcept{
            void* const warmup = CoreAlloc(1u);
            CoreFree(warmup);
            producerReady.store(true, MemoryOrder::release);
            WaitForFlag(startProducer);
            for(usize index = 0u; index < s_AllocationCount; ++index){
                auto* const allocation = static_cast<u8*>(CoreAlloc(13u));
                allocations[index] = allocation;
                if(!allocation){
                    failed.store(true, MemoryOrder::relaxed);
                    continue;
                }
                allocatedBytes += CoreMsize(allocation);
                allocation[0u] = static_cast<u8>(index);
                allocation[12u] = static_cast<u8>(index + 1u);
            }
            produced.store(true, MemoryOrder::release);
            WaitForFlag(releaseWorkers);
        });
        Thread consumer([&]()noexcept{
            void* const warmup = CoreAlloc(1u);
            CoreFree(warmup);
            consumerReady.store(true, MemoryOrder::release);
            WaitForFlag(startConsumer);
            for(usize index = 0u; index < s_AllocationCount; ++index){
                u8* allocation = allocations[index];
                if(!allocation)
                    continue;
                auto* const replacement = static_cast<u8*>(CoreRealloc(allocation, 71u));
                if(replacement)
                    allocation = replacement;
                else
                    failed.store(true, MemoryOrder::relaxed);
                if(allocation[0u] != static_cast<u8>(index) || allocation[12u] != static_cast<u8>(index + 1u))
                    failed.store(true, MemoryOrder::relaxed);
                CoreFree(allocation);
            }
            consumed.store(true, MemoryOrder::release);
            WaitForFlag(releaseWorkers);
        });

        // Keep thread closures outside the measured allocation interval.
        WaitForFlag(producerReady);
        WaitForFlag(consumerReady);
        before = HeapBackingMemoryStats();
        startProducer.store(true, MemoryOrder::release);
        WaitForFlag(produced);
        held = HeapBackingMemoryStats();
        startConsumer.store(true, MemoryOrder::release);
        WaitForFlag(consumed);
        settled = HeapBackingMemoryStats();
        releaseWorkers.store(true, MemoryOrder::release);
        producer.join();
        consumer.join();
        retired = HeapBackingMemoryStats();
        failedValue = failed.load(MemoryOrder::relaxed);
    }

    EXPECT_FALSE(failedValue);
    EXPECT_EQ(held.usedBytes - before.usedBytes, allocatedBytes);
    EXPECT_EQ(held.reservedBytes, held.usedBytes);
    EXPECT_GE(held.peakUsedBytes, held.usedBytes);
    EXPECT_EQ(held.allocationCount - before.allocationCount, allocationCount);
    EXPECT_EQ(settled.usedBytes, before.usedBytes);
    EXPECT_EQ(settled.reservedBytes, settled.usedBytes);
    EXPECT_EQ(settled.allocationCount - before.allocationCount, allocationCount);
    EXPECT_EQ(settled.reallocationCount - before.reallocationCount, allocationCount);
    EXPECT_EQ(settled.deallocationCount - before.deallocationCount, allocationCount);
    EXPECT_GE(settled.peakUsedBytes, held.peakUsedBytes);
    EXPECT_GE(retired.allocationCount, settled.allocationCount);
    EXPECT_GE(retired.reallocationCount, settled.reallocationCount);
    EXPECT_GE(retired.deallocationCount, settled.deallocationCount);
    EXPECT_GE(retired.peakUsedBytes, settled.peakUsedBytes);
}

void VerifyAllocationOwners_OwnerIdentitySurvivesRetirementAndLaterOwnerPublication(){
    const Name owner = s_AllocationOwnerIdentityRetirement;
    const Name laterOwner = s_AllocationOwnerIdentityLater;
    b8 foundLater = false;
    native(in owner, in laterOwner, mut foundLater){
        using namespace NWB::Core::Alloc;
        const ArenaMemoryOwnerRecord* retained = nullptr;
        const ArenaMemoryOwnerRecord* successor = nullptr;
        {
            GlobalArena arena(owner);
            const ArenaMemoryOwnerRecord* record = FirstArenaMemoryOwnerRecord();
            while(record){
                ArenaMemoryOwnerIdentity identity;
                const ArenaMemoryOwnerRecord* const next = ReadArenaMemoryOwnerIdentity(*record, identity);
                if(identity.ownerName == owner){
                    retained = record;
                    successor = next;
                    break;
                }
                record = next;
            }
            ASSERT_NE(retained, nullptr);
            void* const allocation = arena.allocate(1u, 37u);
            ASSERT_NE(allocation, nullptr);
            arena.deallocate(allocation, 1u, 37u);
        }

        GlobalArena later(laterOwner);
        ArenaMemoryOwnerIdentity identity;
        EXPECT_EQ(ReadArenaMemoryOwnerIdentity(*retained, identity), successor);
        EXPECT_EQ(identity.ownerName, owner);
        EXPECT_EQ(identity.source, ArenaMemorySource::Arena);
        ArenaMemoryOwnerSnapshot retired;
        EXPECT_EQ(ReadArenaMemoryOwnerRecord(*retained, retired), successor);
        EXPECT_EQ(retired.ownerName, identity.ownerName);
        EXPECT_EQ(retired.source, identity.source);
        EXPECT_EQ(retired.stats.usedBytes, 0u);
        EXPECT_EQ(retired.stats.reservedBytes, 0u);
        EXPECT_GE(retired.stats.allocationCount, 1u);
        EXPECT_GE(retired.stats.deallocationCount, 1u);

        const ArenaMemoryOwnerRecord* record = FirstArenaMemoryOwnerRecord();
        while(record){
            ArenaMemoryOwnerIdentity current;
            record = ReadArenaMemoryOwnerIdentity(*record, current);
            foundLater |= current.ownerName == laterOwner;
        }
    }
    EXPECT_TRUE(foundLater);
}

void VerifyAllocationOwners_SharedNameAggregatesBytesAndRetainsIndividualHighwater(){
    const Name owner = s_AllocationOwnerSharedName;
    const ArenaMemoryStats before = OwnerStats(owner);
    u64 combinedBytes = 0u;
    u64 largestArenaBytes = 0u;
    native(in owner, in before, mut combinedBytes, mut largestArenaBytes){
        using namespace NWB::Core::Alloc;
        GlobalArena first(owner);
        GlobalArena second("TESTS/ALLOCATION_OWNERS/SHARED_NAME");
        void* firstAllocation = first.allocate(1u, 13u);
        void* secondAllocation = second.allocate(1u, 21u);
        ASSERT_NE(firstAllocation, nullptr);
        ASSERT_NE(secondAllocation, nullptr);
        combinedBytes = CoreMsize(firstAllocation) + CoreMsize(secondAllocation);
        largestArenaBytes = Max(CoreMsize(firstAllocation), CoreMsize(secondAllocation));
        EXPECT_EQ(NWB::Tests::OwnerStats(owner).usedBytes, before.usedBytes + combinedBytes);
        EXPECT_EQ(first.memoryStats().allocationCount, 1u);
        EXPECT_EQ(second.memoryStats().allocationCount, 1u);
        first.deallocate(firstAllocation, 1u, 13u);
        EXPECT_EQ(NWB::Tests::OwnerStats(owner).usedBytes, before.usedBytes + CoreMsize(secondAllocation));
        second.deallocate(secondAllocation, 1u, 21u);
    }
    const ArenaMemoryStats after = OwnerStats(owner);
    EXPECT_EQ(after.usedBytes, before.usedBytes);
    EXPECT_EQ(after.reservedBytes, before.reservedBytes);
    EXPECT_EQ(after.allocationCount - before.allocationCount, 2u);
    EXPECT_EQ(after.deallocationCount - before.deallocationCount, 2u);
    EXPECT_EQ(after.peakUsedBytes, Max(before.peakUsedBytes, largestArenaBytes));
}

void VerifyAllocationOwners_TransientScratchBulkReleaseRetainsChurnWithoutAccumulatingPeak(){
    const Name owner = s_AllocationOwnerTransientScratch;
    const ArenaMemoryStats before = OwnerStats(owner);
    for(usize pass = 0u; pass < 3u; ++pass){
        native(in owner, in before){
            using namespace NWB::Core::Alloc;
            ScratchArena arena(owner);
            void* first = arena.allocate(16u, 208u);
            void* second = arena.allocate(16u, 64u);
            ASSERT_NE(first, nullptr);
            ASSERT_NE(second, nullptr);
            arena.deallocate(first, 16u, 208u);
            EXPECT_EQ(arena.memoryStats().usedBytes, 272u);
            EXPECT_EQ(NWB::Tests::OwnerStats(owner).usedBytes, before.usedBytes + 272u);
        }
    }
    const ArenaMemoryStats after = OwnerStats(owner);
    EXPECT_EQ(after.usedBytes, before.usedBytes);
    EXPECT_EQ(after.reservedBytes, before.reservedBytes);
    EXPECT_EQ(after.allocationCount - before.allocationCount, 6u);
    EXPECT_EQ(after.deallocationCount - before.deallocationCount, 6u);
    EXPECT_EQ(after.peakUsedBytes, Max(before.peakUsedBytes, cast<u64>(272u)));
}

void VerifyAllocationOwners_PersistentPoolBulkReleaseRetainsReallocationHistory(){
    const Name owner = s_AllocationOwnerTransientPersistent;
    const ArenaMemoryStats before = OwnerStats(owner);
    native(in owner, in before){
        using namespace NWB::Core::Alloc;
        PersistentArena arena(owner, 65536u);
        void* allocation = arena.allocate(1u, 13u);
        ASSERT_NE(allocation, nullptr);
        allocation = arena.reallocate(allocation, 1u, 67u);
        ASSERT_NE(allocation, nullptr);
        EXPECT_EQ(NWB::Tests::OwnerStats(owner).reservedBytes, before.reservedBytes + 65536u);
        EXPECT_EQ(NWB::Tests::OwnerStats(owner).usedBytes, before.usedBytes + arena.memoryStats().usedBytes);
    }
    const ArenaMemoryStats after = OwnerStats(owner);
    EXPECT_EQ(after.usedBytes, before.usedBytes);
    EXPECT_EQ(after.reservedBytes, before.reservedBytes);
    EXPECT_EQ(after.allocationCount - before.allocationCount, 1u);
    EXPECT_EQ(after.reallocationCount - before.reallocationCount, 1u);
    EXPECT_EQ(after.deallocationCount - before.deallocationCount, 1u);
}

void VerifyAllocationOwners_SharedNamePreservesPoolReservationAlongsideDirectHeapUsage(){
    const Name owner = s_AllocationOwnerMixedReservation;
    const ArenaMemoryStats before = OwnerStats(owner);
    native(in owner, in before){
        using namespace NWB::Core::Alloc;
        PersistentArena pool(owner, 65536u);
        GlobalArena direct(owner);
        void* allocation = direct.allocate(1u, 13u);
        ASSERT_NE(allocation, nullptr);
        EXPECT_EQ(NWB::Tests::OwnerStats(owner).usedBytes, before.usedBytes + CoreMsize(allocation));
        EXPECT_EQ(NWB::Tests::OwnerStats(owner).reservedBytes, before.reservedBytes + 65536u + CoreMsize(allocation));
        void* replacement = direct.reallocate(allocation, 1u, 21u);
        ASSERT_NE(replacement, nullptr);
        allocation = replacement;
        EXPECT_EQ(direct.memoryStats().reservedBytes, CoreMsize(allocation));
        EXPECT_EQ(NWB::Tests::OwnerStats(owner).reservedBytes, before.reservedBytes + 65536u + CoreMsize(allocation));
        direct.deallocate(allocation, 1u, 21u);
        EXPECT_EQ(NWB::Tests::OwnerStats(owner).usedBytes, before.usedBytes);
        EXPECT_EQ(NWB::Tests::OwnerStats(owner).reservedBytes, before.reservedBytes + 65536u);
    }
    EXPECT_EQ(OwnerStats(owner).usedBytes, before.usedBytes);
    EXPECT_EQ(OwnerStats(owner).reservedBytes, before.reservedBytes);
}

void VerifyAllocationOwners_ResetPreservesRetiredCountersAndIndividualPeakExactlyOnce(){
    const Name owner = s_AllocationOwnerResetHistory;
    const ArenaMemoryStats before = OwnerStats(owner);
    native(in owner, in before){
        ArenaMemoryTracker tracker(owner);
        tracker.reset(512u);
        tracker.recordAllocation(64u);
        tracker.recordAllocation(128u);
        tracker.reset(256u);
        const ArenaMemoryStats resetOwner = NWB::Tests::OwnerStats(owner);
        EXPECT_EQ(tracker.snapshot().allocationCount, 0u);
        EXPECT_EQ(tracker.snapshot().peakUsedBytes, 0u);
        EXPECT_EQ(resetOwner.reservedBytes, before.reservedBytes + 256u);
        EXPECT_EQ(resetOwner.usedBytes, before.usedBytes);
        EXPECT_EQ(resetOwner.allocationCount - before.allocationCount, 2u);
        EXPECT_EQ(resetOwner.deallocationCount - before.deallocationCount, 2u);
        EXPECT_EQ(resetOwner.peakUsedBytes, Max(before.peakUsedBytes, u64{ 192u }));
        tracker.recordAllocation(16u);
        tracker.reset();
        tracker.reset();
    }
    const ArenaMemoryStats after = OwnerStats(owner);
    EXPECT_EQ(after.reservedBytes, before.reservedBytes);
    EXPECT_EQ(after.usedBytes, before.usedBytes);
    EXPECT_EQ(after.allocationCount - before.allocationCount, 3u);
    EXPECT_EQ(after.deallocationCount - before.deallocationCount, 3u);
    EXPECT_EQ(after.peakUsedBytes, Max(before.peakUsedBytes, cast<u64>(192u)));
}

void VerifyAllocationOwners_RetiredGlobalArenaPreservesUnreleasedOwnership(){
    const Name owner = s_AllocationOwnerRetiredOutstanding;
    const ArenaMemoryStats before = OwnerStats(owner);
    u64 bytes = 0u;
    ArenaMemoryStats retired = ArenaMemoryStats();
    native(in owner, mut bytes, mut retired){
        using namespace NWB::Core::Alloc;
        void* allocation = nullptr;
        {
            GlobalArena arena(owner);
            allocation = arena.allocate(1u, 13u);
            ASSERT_NE(allocation, nullptr);
        }
        bytes = CoreMsize(allocation);
        retired = NWB::Tests::OwnerStats(owner);
        CoreFree(allocation);
    }
    EXPECT_EQ(retired.usedBytes, before.usedBytes + bytes);
    EXPECT_EQ(retired.reservedBytes, before.reservedBytes + bytes);
    EXPECT_EQ(retired.allocationCount - before.allocationCount, 1u);
    EXPECT_EQ(retired.deallocationCount, before.deallocationCount);
    EXPECT_EQ(retired.peakUsedBytes, Max(before.peakUsedBytes, bytes));
}

void VerifyAllocationOwners_BackingCountsRawAlignedAllocationsAndPreservesFailedReallocation(){
    const ArenaMemoryStats before = HeapBackingMemoryStats();
    u64 bytes = 0u;
    ArenaMemoryStats allocated = ArenaMemoryStats();
    ArenaMemoryStats failed = ArenaMemoryStats();
    ArenaMemoryStats beforeFree = ArenaMemoryStats();
    ArenaMemoryStats freed = ArenaMemoryStats();
    native(mut bytes, mut allocated, mut failed, mut beforeFree, mut freed){
        using namespace NWB::Core::Alloc;
        auto* allocation = static_cast<u8*>(CoreAllocAligned(13u, 64u));
        bytes = allocation ? CoreMsize(allocation) : 0u;
        allocated = HeapBackingMemoryStats();
        ASSERT_NE(allocation, nullptr);
        allocation[0u] = 37u;
        errno = ERANGE;
        void* backendInvalidZero = scalable_aligned_realloc(allocation, 0u, 3u);
        const i32 backendInvalidZeroError = errno;
        errno = ERANGE;
        void* backendInvalidAlignment = scalable_aligned_realloc(allocation, 21u, 0u);
        const i32 backendInvalidAlignmentError = errno;
        errno = ERANGE;
        void* invalidZero = CoreReallocAligned(allocation, 0u, 3u);
        const i32 invalidZeroError = errno;
        errno = ERANGE;
        void* invalidAlignment = CoreReallocAligned(allocation, 21u, 0u);
        const i32 invalidAlignmentError = errno;
        failed = HeapBackingMemoryStats();
        EXPECT_EQ(invalidZero, nullptr);
        EXPECT_EQ(invalidZero, backendInvalidZero);
        EXPECT_EQ(invalidZeroError, backendInvalidZeroError);
        EXPECT_EQ(invalidAlignment, nullptr);
        EXPECT_EQ(invalidAlignment, backendInvalidAlignment);
        EXPECT_EQ(invalidAlignmentError, backendInvalidAlignmentError);
        EXPECT_EQ(allocation[0u], 37u);
        beforeFree = HeapBackingMemoryStats();
        CoreFreeSizeAligned(allocation, 13u);
        freed = HeapBackingMemoryStats();
    }
    EXPECT_EQ(allocated.usedBytes - before.usedBytes, bytes);
    EXPECT_EQ(allocated.reservedBytes, allocated.usedBytes);
    EXPECT_EQ(failed.reservedBytes, failed.usedBytes);
    EXPECT_EQ(allocated.allocationCount - before.allocationCount, 1u);
    EXPECT_EQ(failed.usedBytes, allocated.usedBytes);
    EXPECT_EQ(failed.reallocationCount, allocated.reallocationCount);
    EXPECT_EQ(failed.deallocationCount, allocated.deallocationCount);
    EXPECT_EQ(beforeFree.usedBytes - freed.usedBytes, bytes);
    EXPECT_EQ(freed.reservedBytes, freed.usedBytes);
    EXPECT_EQ(freed.deallocationCount - beforeFree.deallocationCount, 1u);
}

void VerifyAllocationOwners_RawReallocationMaintainsBackingReservationAndCounts(){
    const ArenaMemoryStats before = HeapBackingMemoryStats();
    u64 originalBytes = 0u;
    u64 grownBytes = 0u;
    ArenaMemoryStats allocated = ArenaMemoryStats();
    ArenaMemoryStats grown = ArenaMemoryStats();
    ArenaMemoryStats beforeRelease = ArenaMemoryStats();
    ArenaMemoryStats afterRelease = ArenaMemoryStats();
    native(mut originalBytes, mut grownBytes, mut allocated, mut grown, mut beforeRelease, mut afterRelease){
        using namespace NWB::Core::Alloc;
        auto* allocation = static_cast<u8*>(CoreRealloc(nullptr, 13u));
        ASSERT_NE(allocation, nullptr);
        allocation[0u] = 29u;
        originalBytes = CoreMsize(allocation);
        allocated = HeapBackingMemoryStats();
        auto* replacement = static_cast<u8*>(CoreRealloc(allocation, 71u));
        ASSERT_NE(replacement, nullptr);
        allocation = replacement;
        grownBytes = CoreMsize(allocation);
        grown = HeapBackingMemoryStats();
        EXPECT_EQ(allocation[0u], 29u);
        beforeRelease = HeapBackingMemoryStats();
        void* released = CoreRealloc(allocation, 0u);
        afterRelease = HeapBackingMemoryStats();
        EXPECT_EQ(released, nullptr);
    }
    EXPECT_EQ(allocated.usedBytes - before.usedBytes, originalBytes);
    EXPECT_EQ(allocated.allocationCount - before.allocationCount, 1u);
    EXPECT_EQ(grown.usedBytes - allocated.usedBytes, grownBytes - originalBytes);
    EXPECT_EQ(grown.reallocationCount - allocated.reallocationCount, 1u);
    EXPECT_EQ(beforeRelease.usedBytes - afterRelease.usedBytes, grownBytes);
    EXPECT_EQ(afterRelease.deallocationCount - beforeRelease.deallocationCount, 1u);
    EXPECT_EQ(allocated.reservedBytes, allocated.usedBytes);
    EXPECT_EQ(grown.reservedBytes, grown.usedBytes);
    EXPECT_EQ(afterRelease.reservedBytes, afterRelease.usedBytes);
}

void VerifyAllocationOwners_BackingDomainCannotCollideWithAnArenaName(){
    const Name owner = s_AllocationOwnerHeapBacking;
    u64 allocationBytes = 0u;
    ArenaMemoryStats arenaStats = ArenaMemoryStats();
    ArenaMemoryStats backingStats = ArenaMemoryStats();
    native(in owner, mut allocationBytes, mut arenaStats, mut backingStats){
        using namespace NWB::Core::Alloc;
        GlobalArena arena(owner);
        void* allocation = arena.allocate(1u, 13u);
        ASSERT_NE(allocation, nullptr);
        allocationBytes = CoreMsize(allocation);
        arenaStats = NWB::Tests::OwnerStats(owner, ArenaMemorySource::Arena);
        backingStats = NWB::Tests::OwnerStats(owner, ArenaMemorySource::HeapBacking);
        arena.deallocate(allocation, 1u, 13u);
    }
    EXPECT_EQ(arenaStats.usedBytes, allocationBytes);
    EXPECT_GE(backingStats.usedBytes, arenaStats.usedBytes);
    EXPECT_GT(backingStats.allocationCount, arenaStats.allocationCount);
}

void VerifyAllocationOwners_ConcurrentSharedOwnerChurnPreservesTotals(){
    const Name owner = s_AllocationOwnerConcurrent;
    const u32 threadCount = 4u;
    const u32 allocationCount = 8192u;
    const ArenaMemoryStats before = OwnerStats(owner);
    b8 failedValue = false;
    u64 elapsed = 0u;
    native(in owner, mut failedValue, mut elapsed){
        using namespace NWB::Core::Alloc;
        constexpr u32 s_ThreadCount = 4u;
        constexpr u32 s_AllocationCount = 8192u;
        Latch startGate(s_ThreadCount + 1u);
        Atomic<b8> failed{ false };
        Array<Thread, s_ThreadCount> workers;
        for(Thread& worker : workers){
            worker = Thread([&owner, &startGate, &failed](){
                GlobalArena arena(owner);
                startGate.arrive_and_wait();
                for(u32 index = 0u; index < s_AllocationCount; ++index){
                    void* allocation = arena.allocate(1u, 128u);
                    if(!allocation){
                        failed.store(true, MemoryOrder::relaxed);
                        return;
                    }
                    arena.deallocate(allocation, 1u, 128u);
                }
            });
        }
        const Timer begin = TimerNow();
        startGate.arrive_and_wait();
        for(Thread& worker : workers)
            worker.join();
        elapsed = DurationInNS<u64>(TimerNow(), begin);
        failedValue = failed.load(MemoryOrder::relaxed);
    }
    const ArenaMemoryStats after = OwnerStats(owner);
    EXPECT_FALSE(failedValue);
    EXPECT_EQ(after.usedBytes, before.usedBytes);
    EXPECT_EQ(after.reservedBytes, before.reservedBytes);
    EXPECT_EQ(after.allocationCount - before.allocationCount, cast<u64>(threadCount * allocationCount));
    EXPECT_EQ(after.deallocationCount - before.deallocationCount, cast<u64>(threadCount * allocationCount));
    EXPECT_EQ(after.peakUsedBytes, Max(before.peakUsedBytes, cast<u64>(128u)));
    RecordUnsignedTestProperty("shared_owner_churn_ns", elapsed);
}


