enum<u8> BuilderScopeKind{
    Root,
    Container,
    ScrollArea,
    VirtualList,
    VirtualListRow,
    SplitterFirst,
    SplitterSecond,
    SpinBox,
    DockSpace,
    DockPanel,
}

