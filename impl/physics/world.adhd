    public b8 setJointSpring(in JointId jointId, in b8 enableSpring, in f32 hertz, in f32 dampingRatio){
        if(!this.isValidJoint(jointId) || !IsFinite(hertz) || !IsFinite(dampingRatio) || hertz < 0.0f || dampingRatio < 0.0f)
            return false;
        this.m_joints[jointId.index].setFlag(JointFlags::EnableSpring, enableSpring);
        this.m_joints[jointId.index].hertz = hertz;
        this.m_joints[jointId.index].dampingRatio = dampingRatio;
        this.wakeBody(this.makeBodyId(this.m_joints[jointId.index].edges[0u].bodyId));
        this.wakeBody(this.makeBodyId(this.m_joints[jointId.index].edges[1u].bodyId));
        return true;
    }

    private void wakeJointBodies(in u32 jointIdx){
        this.wakeBody(this.makeBodyId(this.m_joints[jointIdx].edges[0u].bodyId));
        this.wakeBody(this.makeBodyId(this.m_joints[jointIdx].edges[1u].bodyId));
    }

