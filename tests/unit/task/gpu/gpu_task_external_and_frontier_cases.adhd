    ASSERT_TRUE(finalizingTask.has_value());
    EXPECT_EQ(finalizingTask.value().epilogueBarrierCount, 1u);
}

void VerifyGpuExtFrontier_OrdersExternalFinalTransitionsForWholeAllocationResources(){
    Vector<WholeAllocationCase> testCases = Vector<WholeAllocationCase>();
    testCases.push_back(WholeAllocationCase(GpuGraphResourceType::Buffer, ResourceStates::ShaderResource, ResourceStates::CopySource));
    testCases.push_back(WholeAllocationCase(GpuGraphResourceType::AccelStruct, ResourceStates::AccelStructRead, ResourceStates::Common));

    for(in WholeAllocationCase testCase : testCases){
        TestArena testArena = TestArena();
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        const auto pairResult = AddExternalFinalReadPair(
            graph,
            testCase.resourceType,
            GpuTaskResourceRange(),
            GpuTaskResourceRange(),
            testCase.readState,
            testCase.finalState,
            ResourceQueueSharing::GraphicsAndAsyncCompute,
            false,
            false,
            GpuPhysicalQueueId()
        );
        ASSERT_TRUE(pairResult.has_value());
        const ExternalFinalReadPair pair = pairResult.value();
        ASSERT_TRUE(pair.resource.valid());
        ASSERT_TRUE(pair.earlierReader.valid());
        ASSERT_TRUE(pair.finalizingReader.valid());

        TwoQueueCompile twoQueueCompile = GpuExtFrontier_MakeTwoQueueCompile(testArena);
        ASSERT_TRUE(twoQueueCompile.compile(graph));
        const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(twoQueueCompile.compiledGraph);
        EXPECT_FALSE(GpuExtFrontier_HasEdge(twoQueueCompile.analysis, pair.earlierReader, pair.finalizingReader));

        const GpuSubmissionPacketId earlierPacket = compiledPlan.packetForTask(pair.earlierReader);
        const GpuSubmissionPacketId finalizingPacket = compiledPlan.packetForTask(pair.finalizingReader);
        ASSERT_TRUE(earlierPacket.valid());
        ASSERT_TRUE(finalizingPacket.valid());
        ASSERT_NE(earlierPacket, finalizingPacket);
        const Span<GpuPacketDependency> dependencies = GpuExtFrontier_PacketDependencies(compiledPlan.packet(finalizingPacket));
        ASSERT_EQ(dependencies.size(), 1u);
        EXPECT_EQ(dependencies[0u].producer, earlierPacket);
        EXPECT_EQ(dependencies[0u].consumer, finalizingPacket);

        const Span<GpuCompiledBarrier> barriers = GpuExtFrontier_EpilogueBarriers(compiledPlan.findTask(pair.finalizingReader));
        ASSERT_EQ(barriers.size(), 1u);
        EXPECT_EQ(barriers[0u].before, testCase.readState);
        EXPECT_EQ(barriers[0u].after, testCase.finalState);
    }
}

void VerifyGpuExtFrontier_ElidesSamePacketReleaseOnlyExternalFinalizationSelfDependency(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    GpuTaskResourceRange range = GpuTaskResourceRange();
    range.textureSubresources = TextureSubresourceSet(0u, 1u, 0u, 1u);
    const auto pairResult = AddExternalFinalReadPair(
        graph,
        GpuGraphResourceType::Texture,
        range,
        range,
        ResourceStates::ShaderResource,
        ResourceStates::ShaderResource,
        ResourceQueueSharing::Exclusive,
        true,
        false,
        queues[1u].id
    );
    ASSERT_TRUE(pairResult.has_value());
    const ExternalFinalReadPair pair = pairResult.value();
    ASSERT_TRUE(pair.resource.valid());
    ASSERT_TRUE(pair.earlierReader.valid());
    ASSERT_TRUE(pair.finalizingReader.valid());

    const GpuPhysicalQueueTopology topology = GpuExtFrontier_MakeTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

    const GpuSubmissionPacketId packet = compiledPlan.packetForTask(pair.earlierReader);
    ASSERT_TRUE(packet.valid());
    EXPECT_EQ(compiledPlan.packetForTask(pair.finalizingReader), packet);
    const Optional<GpuSubmissionPacket> packetPlan = GpuExtFrontier_PacketPlan(compiledPlan.packet(packet));
    ASSERT_TRUE(packetPlan.has_value());
    EXPECT_EQ(packetPlan.value().dependencyCount, 0u);
    const Span<GpuCompiledBarrier> barriers = GpuExtFrontier_EpilogueBarriers(compiledPlan.findTask(pair.finalizingReader));
    ASSERT_EQ(barriers.size(), 2u);
    EXPECT_EQ(barriers[0u].type, GpuCompiledBarrierType::TextureStateExport);
    EXPECT_EQ(barriers[0u].before, ResourceStates::ShaderResource);
    EXPECT_EQ(barriers[0u].after, ResourceStates::ShaderResource);
    EXPECT_EQ(barriers[1u].type, GpuCompiledBarrierType::TextureOwnershipRelease);
    EXPECT_EQ(barriers[1u].destinationQueue, queues[1u].id);
}

void VerifyGpuExtFrontier_AvoidsTransitiveExternalFinalizationPacketDependencies(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuTaskResourceRange range = GpuTaskResourceRange();
    range.textureSubresources = TextureSubresourceSet(0u, 1u, 0u, 1u);
    const auto pairResult = AddExternalFinalReadPair(
        graph,
        GpuGraphResourceType::Texture,
        range,
        range,
        ResourceStates::ShaderResource,
        ResourceStates::CopySource,
        ResourceQueueSharing::GraphicsAndAsyncCompute,
        false,
        true,
        GpuPhysicalQueueId()
    );
    ASSERT_TRUE(pairResult.has_value());
    const ExternalFinalReadPair pair = pairResult.value();
    ASSERT_TRUE(pair.resource.valid());
    ASSERT_TRUE(pair.earlierReader.valid());
    ASSERT_TRUE(pair.finalizingReader.valid());

    Array<GpuTaskResourceUse, 1> terminalUses = Array<GpuTaskResourceUse, 1>();
    terminalUses[0u].resource = pair.resource;
    terminalUses[0u].range = range;
    terminalUses[0u].requiredState = ResourceStates::ShaderResource;
    terminalUses[0u].access = GpuTaskResourceAccess::Read;
    terminalUses[0u].hasIndependentStateSource = true;
    GpuTaskSchedulingHint terminalScheduling = GpuTaskSchedulingHint();
    terminalScheduling.forceSubmissionBoundary = true;
    terminalScheduling.allowPacketMerge = false;
    Array<GpuTaskId, 1> finalizerDeps = Array<GpuTaskId, 1>();
    finalizerDeps[0u] = pair.finalizingReader;
    GpuTaskDesc terminalDesc = GpuTaskDesc();
    terminalDesc.setIdentity(s_GpuCaseTaskGraphExternalFinalTransitiveTerminalReader);
    terminalDesc.setMarkerLabel("External Final Transitive Terminal Reader");
    terminalDesc.setScheduling(terminalScheduling);
    terminalDesc.setDependencies(finalizerDeps);
    terminalDesc.setResourceUses(terminalUses);
    const auto terminalReaderResult = graph.addTask(terminalDesc, GraphicsCommands());
    ASSERT_TRUE(terminalReaderResult.has_value());
    const GpuTaskId terminalReader = terminalReaderResult.value();
    ASSERT_TRUE(terminalReader.valid());

    TwoQueueCompile twoQueueCompile = GpuExtFrontier_MakeTwoQueueCompile(testArena);
    ASSERT_TRUE(twoQueueCompile.compile(graph));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(twoQueueCompile.compiledGraph);
    EXPECT_TRUE(GpuExtFrontier_HasEdge(twoQueueCompile.analysis, pair.earlierReader, pair.finalizingReader));
    EXPECT_TRUE(GpuExtFrontier_HasEdge(twoQueueCompile.analysis, pair.finalizingReader, terminalReader));
    EXPECT_FALSE(GpuExtFrontier_HasEdge(twoQueueCompile.analysis, pair.earlierReader, terminalReader));

    const GpuSubmissionPacketId earlierPacket = compiledPlan.packetForTask(pair.earlierReader);
    const GpuSubmissionPacketId middlePacket = compiledPlan.packetForTask(pair.finalizingReader);
    const GpuSubmissionPacketId terminalPacket = compiledPlan.packetForTask(terminalReader);
    ASSERT_TRUE(earlierPacket.valid());
    ASSERT_TRUE(middlePacket.valid());
    ASSERT_TRUE(terminalPacket.valid());
    const Span<GpuPacketDependency> middleDependencies = GpuExtFrontier_PacketDependencies(compiledPlan.packet(middlePacket));
    const Span<GpuPacketDependency> terminalDependencies = GpuExtFrontier_PacketDependencies(compiledPlan.packet(terminalPacket));
    ASSERT_EQ(middleDependencies.size(), 1u);
    ASSERT_EQ(terminalDependencies.size(), 1u);
    EXPECT_EQ(middleDependencies[0u].producer, earlierPacket);
    EXPECT_EQ(terminalDependencies[0u].producer, middlePacket);
}

void VerifyGpuExtFrontier_FrontierSafePacketizationSplitsBeforeCrossQueueConsumer(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const GpuTaskCommandRequirements graphicsCommands = GraphicsCommands();
    const GpuTaskCommandRequirements computeCommands = ComputeCommands();

    GpuTaskSchedulingHint firstScheduling = GpuTaskSchedulingHint();
    firstScheduling.allowPacketMerge = true;
    GpuTaskDesc firstDesc = GpuTaskDesc();
    firstDesc.setIdentity(s_GpuCaseTaskGraphFrontierFirst);
    firstDesc.setMarkerLabel("Frontier First");
    firstDesc.setScheduling(firstScheduling);
    const auto firstResult = graph.addTask(firstDesc, graphicsCommands);
    ASSERT_TRUE(firstResult.has_value());
    const GpuTaskId first = firstResult.value();
    ASSERT_TRUE(first.valid());

    Array<GpuTaskId, 1> firstDeps = Array<GpuTaskId, 1>();
    firstDeps[0u] = first;
    GpuTaskSchedulingHint mergedScheduling = GpuTaskSchedulingHint();
    mergedScheduling.allowPacketMerge = true;
    mergedScheduling.mergeWithPrevious = true;
    GpuTaskDesc mergedDesc = GpuTaskDesc();
    mergedDesc.setIdentity(s_GpuCaseTaskGraphFrontierUnrelatedGraphics);
    mergedDesc.setMarkerLabel("Frontier Unrelated Graphics");
    mergedDesc.setScheduling(mergedScheduling);
    mergedDesc.setDependencies(firstDeps);
    const auto unrelatedGraphicsResult = graph.addTask(mergedDesc, graphicsCommands);
    ASSERT_TRUE(unrelatedGraphicsResult.has_value());
    const GpuTaskId unrelatedGraphics = unrelatedGraphicsResult.value();
    ASSERT_TRUE(unrelatedGraphics.valid());

    GpuTaskDesc consumerDesc = GpuTaskDesc();
    consumerDesc.setIdentity(s_GpuCaseTaskGraphFrontierComputeConsumer);
    consumerDesc.setMarkerLabel("Frontier Compute Consumer");
    consumerDesc.setDependencies(firstDeps);
    const auto computeConsumerResult = graph.addTask(consumerDesc, computeCommands);
    ASSERT_TRUE(computeConsumerResult.has_value());
    const GpuTaskId computeConsumer = computeConsumerResult.value();
    ASSERT_TRUE(computeConsumer.valid());

    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    const GpuPhysicalQueueTopology topology = GpuExtFrontier_MakeTopology(queues);

    GpuTaskGraphAnalysis explicitMergeAnalysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments explicitMergeAssignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph explicitMergeGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(explicitMergeAnalysis, explicitMergeAssignments, explicitMergeGraph, operationScratchArena, graph, topology));
    {
        const GpuCompiledGraphReadView explicitMergePlan = GpuCompiledGraphReadView(explicitMergeGraph);
        ASSERT_EQ(explicitMergePlan.packetCount(), 2u);
        const GpuSubmissionPacketId explicitFirstPacket = explicitMergePlan.packetForTask(first);
        const GpuSubmissionPacketId explicitUnrelatedPacket = explicitMergePlan.packetForTask(unrelatedGraphics);
        const GpuSubmissionPacketId explicitConsumerPacket = explicitMergePlan.packetForTask(computeConsumer);
        ASSERT_TRUE(explicitFirstPacket.valid());
        EXPECT_EQ(explicitFirstPacket, explicitUnrelatedPacket);
        EXPECT_NE(explicitFirstPacket, explicitConsumerPacket);
        const GpuCompiledPacketView explicitConsumerView = explicitMergePlan.packet(explicitConsumerPacket);
        ASSERT_TRUE(explicitConsumerView.valid());
        const Span<GpuPacketDependency> deps = GpuExtFrontier_PacketDependencies(explicitConsumerView);
        ASSERT_EQ(deps.size(), 1u);
        EXPECT_EQ(deps[0u].producer, explicitFirstPacket);
    }

    GpuTaskGraphCompileOptions frontierOptions = GpuTaskGraphCompileOptions();
    frontierOptions.packetizationPolicy = GpuTaskGraphPacketizationPolicy::FrontierSafe;
    GpuTaskGraphAnalysis frontierAnalysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments frontierAssignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph frontierGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(frontierAnalysis, frontierAssignments, frontierGraph, operationScratchArena, graph, topology, frontierOptions));
    const GpuCompiledGraphReadView frontierPlan = GpuCompiledGraphReadView(frontierGraph);

    ASSERT_EQ(frontierPlan.packetCount(), 3u);
    const GpuSubmissionPacketId frontierFirstPacket = frontierPlan.packetForTask(first);
    const GpuSubmissionPacketId frontierUnrelatedPacket = frontierPlan.packetForTask(unrelatedGraphics);
    const GpuSubmissionPacketId frontierConsumerPacket = frontierPlan.packetForTask(computeConsumer);
    ASSERT_TRUE(frontierFirstPacket.valid());
    EXPECT_NE(frontierFirstPacket, frontierUnrelatedPacket);
    EXPECT_NE(frontierUnrelatedPacket, frontierConsumerPacket);
    const Optional<GpuSubmissionPacket> firstPktPlan = GpuExtFrontier_PacketPlan(frontierPlan.packet(frontierFirstPacket));
    const Optional<GpuSubmissionPacket> unrelatedPktPlan = GpuExtFrontier_PacketPlan(frontierPlan.packet(frontierUnrelatedPacket));
    const Optional<GpuSubmissionPacket> consumerPktPlan = GpuExtFrontier_PacketPlan(frontierPlan.packet(frontierConsumerPacket));
    ASSERT_TRUE(firstPktPlan.has_value());
    ASSERT_TRUE(unrelatedPktPlan.has_value());
    ASSERT_TRUE(consumerPktPlan.has_value());
    EXPECT_NE(firstPktPlan.value().queue, consumerPktPlan.value().queue);
    EXPECT_EQ(firstPktPlan.value().taskCount, 1u);
    EXPECT_EQ(unrelatedPktPlan.value().taskCount, 1u);
    EXPECT_EQ(frontierPlan.packetizationDecisionForTask(unrelatedGraphics), GpuTaskPacketizationDecision::CrossQueueConsumerFrontier);
    const GpuCompiledPacketView frontierConsumerView = frontierPlan.packet(frontierConsumerPacket);
    ASSERT_TRUE(frontierConsumerView.valid());
    const Span<GpuPacketDependency> frontierDeps = GpuExtFrontier_PacketDependencies(frontierConsumerView);
    ASSERT_EQ(frontierDeps.size(), 1u);
    EXPECT_EQ(frontierDeps[0u].producer, frontierFirstPacket);
}

void VerifyGpuExtFrontier_FrontierScoredPacketizationRejectsPrecedingBoundaryTask(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const GpuTaskCommandRequirements graphicsCommands = GraphicsCommands();
    const Name mergeDomain = s_TaskGraphFrontierScoredPrecedingBoundary;

    GpuTaskSchedulingHint firstScheduling = GpuTaskSchedulingHint();
    firstScheduling.cost = GpuTaskCostHint::Medium;
    firstScheduling.forceSubmissionBoundary = true;
    firstScheduling.frontierScoredMergeDomain = mergeDomain;
    GpuTaskDesc firstDesc = GpuTaskDesc();
    firstDesc.setIdentity(s_GpuCaseTaskGraphFrontierScoredPrecedingBoundaryFirst);
    firstDesc.setMarkerLabel("Frontier Scored Preceding Boundary First");
    firstDesc.setScheduling(firstScheduling);
    const auto firstResult = graph.addTask(firstDesc, graphicsCommands);
    ASSERT_TRUE(firstResult.has_value());
    const GpuTaskId first = firstResult.value();
    ASSERT_TRUE(first.valid());

    Array<GpuTaskId, 1> firstDeps = Array<GpuTaskId, 1>();
    firstDeps[0u] = first;
    GpuTaskSchedulingHint successorScheduling = GpuTaskSchedulingHint();
    successorScheduling.cost = GpuTaskCostHint::Tiny;
    successorScheduling.frontierScoredMergeDomain = mergeDomain;
    GpuTaskDesc successorDesc = GpuTaskDesc();
    successorDesc.setIdentity(s_GpuCaseTaskGraphFrontierScoredPrecedingBoundarySuccessor);
    successorDesc.setMarkerLabel("Frontier Scored Preceding Boundary Successor");
    successorDesc.setScheduling(successorScheduling);
    successorDesc.setDependencies(firstDeps);
    const auto successorResult = graph.addTask(successorDesc, graphicsCommands);
    ASSERT_TRUE(successorResult.has_value());
    const GpuTaskId successor = successorResult.value();
    ASSERT_TRUE(successor.valid());

    GpuTaskGraphCompileOptions options = GpuTaskGraphCompileOptions();
    options.packetizationPolicy = GpuTaskGraphPacketizationPolicy::FrontierScored;
    SingleQueueCompile singleQueueCompile = GpuExtFrontier_MakeSingleQueueCompile(testArena);
    ASSERT_TRUE(singleQueueCompile.compile(graph, options));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(singleQueueCompile.compiledGraph);

    ASSERT_EQ(compiledPlan.packetCount(), 2u);
    EXPECT_NE(compiledPlan.packetForTask(first), compiledPlan.packetForTask(successor));
    EXPECT_EQ(compiledPlan.packetizationDecisionForTask(successor), GpuTaskPacketizationDecision::PrecedingTaskForcesBoundary);
}

void VerifyGpuExtFrontier_FrontierScoredPacketizationRequiresNonemptyMergeDomain(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const GpuTaskCommandRequirements graphicsCommands = GraphicsCommands();

    GpuTaskSchedulingHint firstScheduling = GpuTaskSchedulingHint();
    firstScheduling.cost = GpuTaskCostHint::Medium;
    GpuTaskDesc firstDesc = GpuTaskDesc();
    firstDesc.setIdentity(s_GpuCaseTaskGraphFrontierScoredMissingDomainFirst);
    firstDesc.setMarkerLabel("Frontier Scored Missing Domain First");
    firstDesc.setScheduling(firstScheduling);
    const auto firstResult = graph.addTask(firstDesc, graphicsCommands);
    ASSERT_TRUE(firstResult.has_value());
    const GpuTaskId first = firstResult.value();
    ASSERT_TRUE(first.valid());

    Array<GpuTaskId, 1> firstDeps = Array<GpuTaskId, 1>();
    firstDeps[0u] = first;
    GpuTaskSchedulingHint namedDomainScheduling = GpuTaskSchedulingHint();
    namedDomainScheduling.cost = GpuTaskCostHint::Tiny;
    namedDomainScheduling.frontierScoredMergeDomain = s_GpuCaseTaskGraphFrontierScoredMissingDomain;
    GpuTaskDesc namedDomainDesc = GpuTaskDesc();
    namedDomainDesc.setIdentity(s_GpuCaseTaskGraphFrontierScoredMissingDomainNamedSuccessor);
    namedDomainDesc.setMarkerLabel("Frontier Scored Missing Domain Named Successor");
    namedDomainDesc.setScheduling(namedDomainScheduling);
    namedDomainDesc.setDependencies(firstDeps);
    const auto namedDomainSuccessorResult = graph.addTask(namedDomainDesc, graphicsCommands);
    ASSERT_TRUE(namedDomainSuccessorResult.has_value());
    const GpuTaskId namedDomainSuccessor = namedDomainSuccessorResult.value();
    ASSERT_TRUE(namedDomainSuccessor.valid());

    Array<GpuTaskId, 1> namedDeps = Array<GpuTaskId, 1>();
    namedDeps[0u] = namedDomainSuccessor;
    GpuTaskSchedulingHint emptyDomainScheduling = GpuTaskSchedulingHint();
    emptyDomainScheduling.cost = GpuTaskCostHint::Tiny;
    GpuTaskDesc emptyDomainDesc = GpuTaskDesc();
    emptyDomainDesc.setIdentity(s_GpuFrontierMissingEmpty);
    emptyDomainDesc.setMarkerLabel("Frontier Scored Missing Domain Empty Successor");
    emptyDomainDesc.setScheduling(emptyDomainScheduling);
    emptyDomainDesc.setDependencies(namedDeps);
    const auto emptyDomainSuccessorResult = graph.addTask(emptyDomainDesc, graphicsCommands);
    ASSERT_TRUE(emptyDomainSuccessorResult.has_value());
    const GpuTaskId emptyDomainSuccessor = emptyDomainSuccessorResult.value();
    ASSERT_TRUE(emptyDomainSuccessor.valid());

    GpuTaskGraphCompileOptions options = GpuTaskGraphCompileOptions();
    options.packetizationPolicy = GpuTaskGraphPacketizationPolicy::FrontierScored;
    SingleQueueCompile singleQueueCompile = GpuExtFrontier_MakeSingleQueueCompile(testArena);
    ASSERT_TRUE(singleQueueCompile.compile(graph, options));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(singleQueueCompile.compiledGraph);

    ASSERT_EQ(compiledPlan.packetCount(), 3u);
    const GpuSubmissionPacketId firstPacket = compiledPlan.packetForTask(first);
    const GpuSubmissionPacketId namedDomainSuccessorPacket = compiledPlan.packetForTask(namedDomainSuccessor);
    const GpuSubmissionPacketId emptyDomainSuccessorPacket = compiledPlan.packetForTask(emptyDomainSuccessor);
    ASSERT_TRUE(firstPacket.valid());
    EXPECT_NE(firstPacket, namedDomainSuccessorPacket);
    EXPECT_NE(namedDomainSuccessorPacket, emptyDomainSuccessorPacket);
    EXPECT_EQ(compiledPlan.packetizationDecisionForTask(namedDomainSuccessor), GpuTaskPacketizationDecision::ScoredMergeDomainMismatch);
    EXPECT_EQ(compiledPlan.packetizationDecisionForTask(emptyDomainSuccessor), GpuTaskPacketizationDecision::ScoredMergeDomainMismatch);
}

void VerifyGpuExtFrontier_FrontierScoredPacketizationRequiresOneDomainAcrossPrecedingPacket(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const GpuTaskCommandRequirements graphicsCommands = GraphicsCommands();

    GpuTaskSchedulingHint firstScheduling = GpuTaskSchedulingHint();
    firstScheduling.cost = GpuTaskCostHint::Medium;
    firstScheduling.frontierScoredMergeDomain = s_GpuCaseTaskGraphFrontierScoredFirstDomain;
    GpuTaskDesc firstDesc = GpuTaskDesc();
    firstDesc.setIdentity(s_GpuCaseTaskGraphFrontierScoredMismatchedDomainFirst);
    firstDesc.setMarkerLabel("Frontier Scored Mismatched Domain First");
    firstDesc.setScheduling(firstScheduling);
    const auto firstResult = graph.addTask(firstDesc, graphicsCommands);
    ASSERT_TRUE(firstResult.has_value());
    const GpuTaskId first = firstResult.value();
    ASSERT_TRUE(first.valid());

    Array<GpuTaskId, 1> firstDeps = Array<GpuTaskId, 1>();
    firstDeps[0u] = first;
    GpuTaskSchedulingHint explicitScheduling = GpuTaskSchedulingHint();
    explicitScheduling.cost = GpuTaskCostHint::Tiny;
    explicitScheduling.mergeWithPrevious = true;
    explicitScheduling.frontierScoredMergeDomain = s_GpuExtFrontierSecondMergeDomain;
    GpuTaskDesc explicitDesc = GpuTaskDesc();
    explicitDesc.setIdentity(s_GpuCaseTaskGraphFrontierScoredMismatchedDomainExplicit);
    explicitDesc.setMarkerLabel("Frontier Scored Mismatched Domain Explicit");
    explicitDesc.setScheduling(explicitScheduling);
    explicitDesc.setDependencies(firstDeps);
    const auto explicitTaskResult = graph.addTask(explicitDesc, graphicsCommands);
    ASSERT_TRUE(explicitTaskResult.has_value());
    const GpuTaskId explicitTask = explicitTaskResult.value();
    ASSERT_TRUE(explicitTask.valid());

    Array<GpuTaskId, 1> explicitDeps = Array<GpuTaskId, 1>();
    explicitDeps[0u] = explicitTask;
    GpuTaskSchedulingHint successorScheduling = GpuTaskSchedulingHint();
    successorScheduling.cost = GpuTaskCostHint::Tiny;
    successorScheduling.frontierScoredMergeDomain = s_GpuExtFrontierSecondMergeDomain;
    GpuTaskDesc successorDesc = GpuTaskDesc();
    successorDesc.setIdentity(s_GpuCaseTaskGraphFrontierScoredMismatchedDomainSuccessor);
    successorDesc.setMarkerLabel("Frontier Scored Mismatched Domain Successor");
    successorDesc.setScheduling(successorScheduling);
    successorDesc.setDependencies(explicitDeps);
    const auto successorResult = graph.addTask(successorDesc, graphicsCommands);
    ASSERT_TRUE(successorResult.has_value());
    const GpuTaskId successor = successorResult.value();
    ASSERT_TRUE(successor.valid());

    GpuTaskGraphCompileOptions options = GpuTaskGraphCompileOptions();
    options.packetizationPolicy = GpuTaskGraphPacketizationPolicy::FrontierScored;
    SingleQueueCompile singleQueueCompile = GpuExtFrontier_MakeSingleQueueCompile(testArena);
    ASSERT_TRUE(singleQueueCompile.compile(graph, options));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(singleQueueCompile.compiledGraph);

    ASSERT_EQ(compiledPlan.packetCount(), 2u);
    const GpuSubmissionPacketId firstPacket = compiledPlan.packetForTask(first);
    const GpuSubmissionPacketId explicitPacket = compiledPlan.packetForTask(explicitTask);
    const GpuSubmissionPacketId successorPacket = compiledPlan.packetForTask(successor);
    ASSERT_TRUE(firstPacket.valid());
    EXPECT_EQ(firstPacket, explicitPacket);
    EXPECT_NE(explicitPacket, successorPacket);
    EXPECT_EQ(compiledPlan.packetizationDecisionForTask(explicitTask), GpuTaskPacketizationDecision::MergedExplicit);
    EXPECT_EQ(compiledPlan.packetizationDecisionForTask(successor), GpuTaskPacketizationDecision::ScoredMergeDomainMismatch);
}

void VerifyGpuExtFrontier_FrontierScoredPacketizationPreservesCrossQueueConsumerFrontier(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const GpuTaskCommandRequirements graphicsCommands = GraphicsCommands();
    const GpuTaskCommandRequirements computeCommands = ComputeCommands();

    GpuTaskSchedulingHint producerScheduling = GpuTaskSchedulingHint();
    producerScheduling.cost = GpuTaskCostHint::Medium;
    producerScheduling.frontierScoredMergeDomain = s_GpuExtFrontierCrossQueueMergeDomain;
    GpuTaskDesc producerDesc = GpuTaskDesc();
    producerDesc.setIdentity(s_GpuCaseTaskGraphFrontierScoredFrontierProducer);
    producerDesc.setMarkerLabel("Frontier Scored Frontier Producer");
    producerDesc.setScheduling(producerScheduling);
    const auto producerResult = graph.addTask(producerDesc, graphicsCommands);
    ASSERT_TRUE(producerResult.has_value());
    const GpuTaskId producer = producerResult.value();
    ASSERT_TRUE(producer.valid());

    Array<GpuTaskId, 1> producerDeps = Array<GpuTaskId, 1>();
    producerDeps[0u] = producer;
    GpuTaskSchedulingHint successorScheduling = GpuTaskSchedulingHint();
    successorScheduling.cost = GpuTaskCostHint::Tiny;
    successorScheduling.frontierScoredMergeDomain = s_GpuExtFrontierCrossQueueMergeDomain;
    GpuTaskDesc successorDesc = GpuTaskDesc();
    successorDesc.setIdentity(s_GpuCaseTaskGraphFrontierScoredFrontierSuccessor);
    successorDesc.setMarkerLabel("Frontier Scored Frontier Successor");
    successorDesc.setScheduling(successorScheduling);
    successorDesc.setDependencies(producerDeps);
    const auto successorResult = graph.addTask(successorDesc, graphicsCommands);
    ASSERT_TRUE(successorResult.has_value());
    const GpuTaskId successor = successorResult.value();
    ASSERT_TRUE(successor.valid());

    GpuTaskDesc consumerDesc = GpuTaskDesc();
    consumerDesc.setIdentity(s_GpuCaseTaskGraphFrontierScoredComputeConsumer);
    consumerDesc.setMarkerLabel("Frontier Scored Compute Consumer");
    consumerDesc.setDependencies(producerDeps);
    const auto consumerResult = graph.addTask(consumerDesc, computeCommands);
    ASSERT_TRUE(consumerResult.has_value());
    const GpuTaskId consumer = consumerResult.value();
    ASSERT_TRUE(consumer.valid());

    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    const GpuPhysicalQueueTopology topology = GpuExtFrontier_MakeTopology(queues);
    GpuTaskGraphCompileOptions options = GpuTaskGraphCompileOptions();
    options.packetizationPolicy = GpuTaskGraphPacketizationPolicy::FrontierScored;
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology, options));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

    ASSERT_EQ(compiledPlan.packetCount(), 3u);
    const GpuSubmissionPacketId producerPacket = compiledPlan.packetForTask(producer);
    const GpuSubmissionPacketId successorPacket = compiledPlan.packetForTask(successor);
    const GpuSubmissionPacketId consumerPacket = compiledPlan.packetForTask(consumer);
    ASSERT_TRUE(producerPacket.valid());
    EXPECT_NE(producerPacket, successorPacket);
    EXPECT_NE(producerPacket, consumerPacket);
    EXPECT_EQ(compiledPlan.packetizationDecisionForTask(successor), GpuTaskPacketizationDecision::CrossQueueConsumerFrontier);
    const Span<GpuPacketDependency> consumerDeps = GpuExtFrontier_PacketDependencies(compiledPlan.packet(consumerPacket));
    ASSERT_EQ(consumerDeps.size(), 1u);
    EXPECT_EQ(consumerDeps[0u].producer, producerPacket);
}

void VerifyGpuExtFrontier_FrontierScoredPacketizationCarriesTailPhysicalQueueFrontierForward(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const GpuTaskCommandRequirements graphicsCommands = GraphicsCommands();
    const Name mergeDomain = s_TaskGraphFrontierScoredTailFrontier;

    GpuTaskSchedulingHint firstScheduling = GpuTaskSchedulingHint();
    firstScheduling.cost = GpuTaskCostHint::Medium;
    firstScheduling.frontierScoredMergeDomain = mergeDomain;
    GpuTaskDesc firstDesc = GpuTaskDesc();
    firstDesc.setIdentity(s_GpuCaseTaskGraphFrontierScoredTailFrontierFirst);
    firstDesc.setMarkerLabel("Frontier Scored Tail Frontier First");
    firstDesc.setScheduling(firstScheduling);
    const auto firstResult = graph.addTask(firstDesc, graphicsCommands);
    ASSERT_TRUE(firstResult.has_value());
    const GpuTaskId first = firstResult.value();
    ASSERT_TRUE(first.valid());

    Array<GpuTaskId, 1> firstDeps = Array<GpuTaskId, 1>();
    firstDeps[0u] = first;
    GpuTaskSchedulingHint mergedScheduling = GpuTaskSchedulingHint();
    mergedScheduling.cost = GpuTaskCostHint::Tiny;
    mergedScheduling.frontierScoredMergeDomain = mergeDomain;
    GpuTaskDesc mergedDesc = GpuTaskDesc();
    mergedDesc.setIdentity(s_GpuCaseTaskGraphFrontierScoredTailFrontierMerged);
    mergedDesc.setMarkerLabel("Frontier Scored Tail Frontier Merged");
    mergedDesc.setScheduling(mergedScheduling);
    mergedDesc.setDependencies(firstDeps);
    const auto mergedResult = graph.addTask(mergedDesc, graphicsCommands);
    ASSERT_TRUE(mergedResult.has_value());
    const GpuTaskId merged = mergedResult.value();
    ASSERT_TRUE(merged.valid());

    Array<GpuTaskId, 1> mergedDeps = Array<GpuTaskId, 1>();
    mergedDeps[0u] = merged;
    GpuTaskSchedulingHint blockedScheduling = GpuTaskSchedulingHint();
    blockedScheduling.cost = GpuTaskCostHint::Tiny;
    blockedScheduling.frontierScoredMergeDomain = mergeDomain;
    GpuTaskDesc blockedDesc = GpuTaskDesc();
    blockedDesc.setIdentity(s_GpuCaseTaskGraphFrontierScoredTailFrontierBlocked);
    blockedDesc.setMarkerLabel("Frontier Scored Tail Frontier Blocked");
    blockedDesc.setScheduling(blockedScheduling);
    blockedDesc.setDependencies(mergedDeps);
    const auto blockedResult = graph.addTask(blockedDesc, graphicsCommands);
    ASSERT_TRUE(blockedResult.has_value());
    const GpuTaskId blocked = blockedResult.value();
    ASSERT_TRUE(blocked.valid());

    GpuTaskSchedulingHint consumerScheduling = GpuTaskSchedulingHint();
    consumerScheduling.allowSameClassQueueRouting = true;
    GpuTaskDesc consumerDesc = GpuTaskDesc();
    consumerDesc.setIdentity(s_TaskGraphFrontierScoredTailFrontierConsumer);
    consumerDesc.setMarkerLabel("Frontier Scored Tail Frontier Consumer");
    consumerDesc.setScheduling(consumerScheduling);
    consumerDesc.setDependencies(mergedDeps);
    const auto consumerResult = graph.addTask(consumerDesc, graphicsCommands);
    ASSERT_TRUE(consumerResult.has_value());
    const GpuTaskId consumer = consumerResult.value();
    ASSERT_TRUE(consumer.valid());

    GpuPhysicalQueueInfo auxiliaryGraphicsQueue = GraphicsQueue(1u);
    auxiliaryGraphicsQueue.queueIndex = 1u;
    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = auxiliaryGraphicsQueue;
    const GpuPhysicalQueueTopology topology = GpuExtFrontier_MakeTopology(queues);
    GpuTaskGraphCompileOptions options = GpuTaskGraphCompileOptions();
    options.packetizationPolicy = GpuTaskGraphPacketizationPolicy::FrontierScored;
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(Compile(analysis, assignments, compiledGraph, operationScratchArena, graph, topology, options));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

    ASSERT_EQ(compiledPlan.packetCount(), 3u);

    const Optional<GpuTaskQueueAssignment> firstAssignment = GpuExtFrontier_FindAssignment(assignments, first);
    const Optional<GpuTaskQueueAssignment> mergedAssignment = GpuExtFrontier_FindAssignment(assignments, merged);
    const Optional<GpuTaskQueueAssignment> blockedAssignment = GpuExtFrontier_FindAssignment(assignments, blocked);
    const Optional<GpuTaskQueueAssignment> consumerAssignment = GpuExtFrontier_FindAssignment(assignments, consumer);
    ASSERT_TRUE(firstAssignment.has_value());
    ASSERT_TRUE(mergedAssignment.has_value());
    ASSERT_TRUE(blockedAssignment.has_value());
    ASSERT_TRUE(consumerAssignment.has_value());
    EXPECT_EQ(firstAssignment.value().queue, queues[0u].id);
    EXPECT_EQ(mergedAssignment.value().queue, queues[0u].id);
    EXPECT_EQ(blockedAssignment.value().queue, queues[0u].id);
    // Same-class balancing moves the consumer to the idle graphics queue in the same family.
    EXPECT_EQ(consumerAssignment.value().queue, queues[1u].id);
    EXPECT_NE(cast<u8>(consumerAssignment.value().modifiers) & cast<u8>(GpuTaskQueueAssignmentModifier::SameClassLoadBalance), 0u);

    const GpuSubmissionPacketId firstPacket = compiledPlan.packetForTask(first);
    const GpuSubmissionPacketId mergedPacket = compiledPlan.packetForTask(merged);
    const GpuSubmissionPacketId blockedPacket = compiledPlan.packetForTask(blocked);
    const GpuSubmissionPacketId consumerPacket = compiledPlan.packetForTask(consumer);
    ASSERT_TRUE(firstPacket.valid());
    EXPECT_EQ(firstPacket, mergedPacket);
    EXPECT_NE(firstPacket, blockedPacket);
    EXPECT_NE(blockedPacket, consumerPacket);
    EXPECT_EQ(compiledPlan.packetizationDecisionForTask(merged), GpuTaskPacketizationDecision::MergedFrontierScored);
    EXPECT_EQ(compiledPlan.packetizationDecisionForTask(blocked), GpuTaskPacketizationDecision::CrossQueueConsumerFrontier);
}

void VerifyGpuExtFrontier_FrontierSafePacketizationKeepsFrontierAfterExplicitOverride(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const GpuTaskCommandRequirements graphicsCommands = GraphicsCommands();
    const GpuTaskCommandRequirements computeCommands = ComputeCommands();

    GpuTaskSchedulingHint firstScheduling = GpuTaskSchedulingHint();
    firstScheduling.allowPacketMerge = true;
    GpuTaskDesc firstDesc = GpuTaskDesc();
    firstDesc.setIdentity(s_GpuCaseTaskGraphFrontierOverridePersistenceFirst);
    firstDesc.setMarkerLabel("Frontier Override Persistence First");
    firstDesc.setScheduling(firstScheduling);
    const auto firstResult = graph.addTask(firstDesc, graphicsCommands);
    ASSERT_TRUE(firstResult.has_value());
    const GpuTaskId first = firstResult.value();
    ASSERT_TRUE(first.valid());

    Array<GpuTaskId, 1> firstDeps = Array<GpuTaskId, 1>();
    firstDeps[0u] = first;
    GpuTaskSchedulingHint overrideScheduling = GpuTaskSchedulingHint();
    overrideScheduling.allowPacketMerge = true;
    overrideScheduling.mergeWithPrevious = true;
    overrideScheduling.allowMergeAcrossConsumerFrontier = true;
    GpuTaskDesc overrideDesc = GpuTaskDesc();
    overrideDesc.setIdentity(s_GpuCaseTaskGraphFrontierOverridePersistenceMerged);
    overrideDesc.setMarkerLabel("Frontier Override Persistence Merged");
    overrideDesc.setScheduling(overrideScheduling);
    overrideDesc.setDependencies(firstDeps);
    const auto overrideTaskResult = graph.addTask(overrideDesc, graphicsCommands);
    ASSERT_TRUE(overrideTaskResult.has_value());
    const GpuTaskId overrideTask = overrideTaskResult.value();
    ASSERT_TRUE(overrideTask.valid());

    Array<GpuTaskId, 1> overrideDeps = Array<GpuTaskId, 1>();
    overrideDeps[0u] = overrideTask;
    GpuTaskSchedulingHint blockedScheduling = GpuTaskSchedulingHint();
    blockedScheduling.allowPacketMerge = true;
    blockedScheduling.mergeWithPrevious = true;
    GpuTaskDesc blockedDesc = GpuTaskDesc();
    blockedDesc.setIdentity(s_GpuCaseTaskGraphFrontierOverridePersistenceBlocked);
    blockedDesc.setMarkerLabel("Frontier Override Persistence Blocked");
    blockedDesc.setScheduling(blockedScheduling);
    blockedDesc.setDependencies(overrideDeps);
    const auto blockedResult = graph.addTask(blockedDesc, graphicsCommands);
    ASSERT_TRUE(blockedResult.has_value());
    const GpuTaskId blocked = blockedResult.value();
    ASSERT_TRUE(blocked.valid());

    GpuTaskDesc consumerDesc = GpuTaskDesc();
    consumerDesc.setIdentity(s_GpuCaseTaskGraphFrontierOverridePersistenceConsumer);
    consumerDesc.setMarkerLabel("Frontier Override Persistence Consumer");
    consumerDesc.setDependencies(firstDeps);
    const auto consumerResult = graph.addTask(consumerDesc, computeCommands);
    ASSERT_TRUE(consumerResult.has_value());
    const GpuTaskId consumer = consumerResult.value();
    ASSERT_TRUE(consumer.valid());

    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    const GpuPhysicalQueueTopology topology = GpuExtFrontier_MakeTopology(queues);
    GpuTaskGraphCompileOptions options = GpuTaskGraphCompileOptions();
    options.packetizationPolicy = GpuTaskGraphPacketizationPolicy::FrontierSafe;
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology, options));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

    ASSERT_EQ(compiledPlan.packetCount(), 3u);
    const GpuSubmissionPacketId firstPacket = compiledPlan.packetForTask(first);
    const GpuSubmissionPacketId overridePacket = compiledPlan.packetForTask(overrideTask);
    const GpuSubmissionPacketId blockedPacket = compiledPlan.packetForTask(blocked);
    const GpuSubmissionPacketId consumerPacket = compiledPlan.packetForTask(consumer);
    ASSERT_TRUE(firstPacket.valid());
    EXPECT_EQ(firstPacket, overridePacket);
    EXPECT_NE(firstPacket, blockedPacket);
    EXPECT_NE(blockedPacket, consumerPacket);
    EXPECT_EQ(compiledPlan.packetizationDecisionForTask(overrideTask), GpuTaskPacketizationDecision::MergedExplicit);
    EXPECT_EQ(compiledPlan.packetizationDecisionForTask(blocked), GpuTaskPacketizationDecision::CrossQueueConsumerFrontier);
}

void VerifyGpuExtFrontier_FrontierSafeConsumerFrontierOverrideRequiresExplicitImmediateDependency(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const GpuTaskCommandRequirements graphicsCommands = GraphicsCommands();
    const GpuTaskCommandRequirements computeCommands = ComputeCommands();
    const auto orderedHandoffResult = AddHazardDomain(graph, s_GpuCaseTaskGraphFrontierOverrideOrderedHandoff, "Frontier Override Ordered Handoff");
    ASSERT_TRUE(orderedHandoffResult.has_value());
    const GpuGraphResourceId orderedHandoff = orderedHandoffResult.value();
    ASSERT_TRUE(orderedHandoff.valid());

    GpuTaskSchedulingHint firstScheduling = GpuTaskSchedulingHint();
    firstScheduling.allowPacketMerge = true;
    GpuTaskDesc firstDesc = GpuTaskDesc();
    firstDesc.setIdentity(s_GpuCaseTaskGraphFrontierOverrideFirst);
    firstDesc.setMarkerLabel("Frontier Override First");
    firstDesc.setScheduling(firstScheduling);
    const auto firstResult = graph.addTask(firstDesc, graphicsCommands);
    ASSERT_TRUE(firstResult.has_value());
    const GpuTaskId first = firstResult.value();
    ASSERT_TRUE(first.valid());

    Array<GpuTaskId, 1> firstDeps = Array<GpuTaskId, 1>();
    firstDeps[0u] = first;
    GpuTaskSchedulingHint immediateFinalizeScheduling = GpuTaskSchedulingHint();
    immediateFinalizeScheduling.allowPacketMerge = true;
    immediateFinalizeScheduling.mergeWithPrevious = true;
    immediateFinalizeScheduling.allowMergeAcrossConsumerFrontier = true;
    Array<GpuTaskResourceUse, 1> immediateFinalizeUses = Array<GpuTaskResourceUse, 1>();
    immediateFinalizeUses[0u].resource = orderedHandoff;
    immediateFinalizeUses[0u].requiredState = ResourceStates::UnorderedAccess;
    immediateFinalizeUses[0u].access = GpuTaskResourceAccess::Write;
    GpuTaskDesc immediateFinalizeDesc = GpuTaskDesc();
    immediateFinalizeDesc.setIdentity(s_GpuCaseTaskGraphFrontierOverrideImmediateFinalize);
    immediateFinalizeDesc.setMarkerLabel("Frontier Override Immediate Finalize");
    immediateFinalizeDesc.setScheduling(immediateFinalizeScheduling);
    immediateFinalizeDesc.setDependencies(firstDeps);
    immediateFinalizeDesc.setResourceUses(immediateFinalizeUses);
    const auto immediateFinalizeResult = graph.addTask(immediateFinalizeDesc, graphicsCommands);
    ASSERT_TRUE(immediateFinalizeResult.has_value());
    const GpuTaskId immediateFinalize = immediateFinalizeResult.value();
    ASSERT_TRUE(immediateFinalize.valid());

    // Inferred ordering after the finalizer must not inherit the finalizer frontier override.
    GpuTaskSchedulingHint unrelatedScheduling = GpuTaskSchedulingHint();
    unrelatedScheduling.allowPacketMerge = true;
    unrelatedScheduling.mergeWithPrevious = true;
    unrelatedScheduling.allowMergeAcrossConsumerFrontier = true;
    Array<GpuTaskResourceUse, 1> unrelatedUses = Array<GpuTaskResourceUse, 1>();
    unrelatedUses[0u].resource = orderedHandoff;
    unrelatedUses[0u].requiredState = ResourceStates::ShaderResource;
    unrelatedUses[0u].access = GpuTaskResourceAccess::Read;
    GpuTaskDesc unrelatedDesc = GpuTaskDesc();
    unrelatedDesc.setIdentity(s_GpuCaseTaskGraphFrontierOverrideUnrelatedSuccessor);
    unrelatedDesc.setMarkerLabel("Frontier Override Unrelated Successor");
    unrelatedDesc.setScheduling(unrelatedScheduling);
    unrelatedDesc.setDependencies(firstDeps);
    unrelatedDesc.setResourceUses(unrelatedUses);
    const auto unrelatedSuccessorResult = graph.addTask(unrelatedDesc, graphicsCommands);
    ASSERT_TRUE(unrelatedSuccessorResult.has_value());
    const GpuTaskId unrelatedSuccessor = unrelatedSuccessorResult.value();
    ASSERT_TRUE(unrelatedSuccessor.valid());

    // Keep the cross-queue edge while sequencing the consumer after the merge, so packet order cannot fake a pass.
    Array<GpuTaskId, 2> consumerDependencies = Array<GpuTaskId, 2>();
    consumerDependencies[0u] = first;
    consumerDependencies[1u] = unrelatedSuccessor;
    GpuTaskDesc consumerDesc = GpuTaskDesc();
    consumerDesc.setIdentity(s_GpuCaseTaskGraphFrontierOverrideComputeConsumer);
    consumerDesc.setMarkerLabel("Frontier Override Compute Consumer");
    consumerDesc.setDependencies(consumerDependencies);
    const auto computeConsumerResult = graph.addTask(consumerDesc, computeCommands);
    ASSERT_TRUE(computeConsumerResult.has_value());
    const GpuTaskId computeConsumer = computeConsumerResult.value();
    ASSERT_TRUE(computeConsumer.valid());

    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    const GpuPhysicalQueueTopology topology = GpuExtFrontier_MakeTopology(queues);
    GpuTaskGraphCompileOptions frontierOptions = GpuTaskGraphCompileOptions();
    frontierOptions.packetizationPolicy = GpuTaskGraphPacketizationPolicy::FrontierSafe;
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology, frontierOptions));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

    ASSERT_EQ(compiledPlan.packetCount(), 3u);
    const GpuSubmissionPacketId firstPacket = compiledPlan.packetForTask(first);
    const GpuSubmissionPacketId immediateFinalizePacket = compiledPlan.packetForTask(immediateFinalize);
    const GpuSubmissionPacketId unrelatedPacket = compiledPlan.packetForTask(unrelatedSuccessor);
    const GpuSubmissionPacketId consumerPacket = compiledPlan.packetForTask(computeConsumer);
    ASSERT_TRUE(firstPacket.valid());
    EXPECT_EQ(firstPacket, immediateFinalizePacket);
    EXPECT_NE(firstPacket, unrelatedPacket);
    EXPECT_NE(unrelatedPacket, consumerPacket);
    const Optional<GpuSubmissionPacket> firstPktPlan = GpuExtFrontier_PacketPlan(compiledPlan.packet(firstPacket));
    const Optional<GpuSubmissionPacket> unrelatedPktPlan = GpuExtFrontier_PacketPlan(compiledPlan.packet(unrelatedPacket));
    ASSERT_TRUE(firstPktPlan.has_value());
    ASSERT_TRUE(unrelatedPktPlan.has_value());
    EXPECT_EQ(firstPktPlan.value().taskCount, 2u);
    EXPECT_EQ(unrelatedPktPlan.value().taskCount, 1u);
    EXPECT_TRUE(analysis.hasExplicitEdge(first, computeConsumer));
    const GpuCompiledPacketView consumerPktView = compiledPlan.packet(consumerPacket);
    ASSERT_TRUE(GpuExtFrontier_HasPacketDepsPtr(consumerPktView));
    const Span<GpuPacketDependency> consumerDeps = GpuExtFrontier_PacketDependencies(consumerPktView);
    ASSERT_EQ(consumerDeps.size(), 1u);
    EXPECT_EQ(consumerDeps[0u].producer, unrelatedPacket);
    EXPECT_TRUE(HasInferredHazard(analysis, immediateFinalize, unrelatedSuccessor, orderedHandoff, GpuTaskHazardType::ReadAfterWrite));
}

void VerifyGpuExtFrontier_FrontierSafePacketizationKeepsMergeWhenLaterTaskOwnsCrossQueueConsumer(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const GpuTaskCommandRequirements graphicsCommands = GraphicsCommands();
    const GpuTaskCommandRequirements computeCommands = ComputeCommands();

    GpuTaskSchedulingHint firstScheduling = GpuTaskSchedulingHint();
    firstScheduling.allowPacketMerge = true;
    GpuTaskDesc firstDesc = GpuTaskDesc();
    firstDesc.setIdentity(s_GpuCaseTaskGraphFrontierMergeFirst);
    firstDesc.setMarkerLabel("Frontier Merge First");
    firstDesc.setScheduling(firstScheduling);
    const auto firstResult = graph.addTask(firstDesc, graphicsCommands);
    ASSERT_TRUE(firstResult.has_value());
    const GpuTaskId first = firstResult.value();
    ASSERT_TRUE(first.valid());

    Array<GpuTaskId, 1> firstDeps = Array<GpuTaskId, 1>();
    firstDeps[0u] = first;
    GpuTaskSchedulingHint mergedScheduling = GpuTaskSchedulingHint();
    mergedScheduling.allowPacketMerge = true;
    mergedScheduling.mergeWithPrevious = true;
    GpuTaskDesc mergedDesc = GpuTaskDesc();
    mergedDesc.setIdentity(s_GpuCaseTaskGraphFrontierMergeProducer);
    mergedDesc.setMarkerLabel("Frontier Merge Producer");
    mergedDesc.setScheduling(mergedScheduling);
    mergedDesc.setDependencies(firstDeps);
    const auto producerResult = graph.addTask(mergedDesc, graphicsCommands);
    ASSERT_TRUE(producerResult.has_value());
    const GpuTaskId producer = producerResult.value();
    ASSERT_TRUE(producer.valid());

    Array<GpuTaskId, 1> producerDeps = Array<GpuTaskId, 1>();
    producerDeps[0u] = producer;
    GpuTaskDesc consumerDesc = GpuTaskDesc();
    consumerDesc.setIdentity(s_GpuCaseTaskGraphFrontierMergeComputeConsumer);
    consumerDesc.setMarkerLabel("Frontier Merge Compute Consumer");
    consumerDesc.setDependencies(producerDeps);
    const auto computeConsumerResult = graph.addTask(consumerDesc, computeCommands);
    ASSERT_TRUE(computeConsumerResult.has_value());
    const GpuTaskId computeConsumer = computeConsumerResult.value();
    ASSERT_TRUE(computeConsumer.valid());

    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    const GpuPhysicalQueueTopology topology = GpuExtFrontier_MakeTopology(queues);
    GpuTaskGraphCompileOptions frontierOptions = GpuTaskGraphCompileOptions();
    frontierOptions.packetizationPolicy = GpuTaskGraphPacketizationPolicy::FrontierSafe;
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology, frontierOptions));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

    ASSERT_EQ(compiledPlan.packetCount(), 2u);
    const GpuSubmissionPacketId firstPacket = compiledPlan.packetForTask(first);
    const GpuSubmissionPacketId producerPacket = compiledPlan.packetForTask(producer);
    const GpuSubmissionPacketId consumerPacket = compiledPlan.packetForTask(computeConsumer);
    ASSERT_TRUE(firstPacket.valid());
    EXPECT_EQ(firstPacket, producerPacket);
    EXPECT_NE(producerPacket, consumerPacket);
    const Optional<GpuSubmissionPacket> firstPktPlan = GpuExtFrontier_PacketPlan(compiledPlan.packet(firstPacket));
    const Optional<GpuSubmissionPacket> consumerPktPlan = GpuExtFrontier_PacketPlan(compiledPlan.packet(consumerPacket));
    ASSERT_TRUE(firstPktPlan.has_value());
    ASSERT_TRUE(consumerPktPlan.has_value());
    EXPECT_EQ(firstPktPlan.value().taskCount, 2u);
    EXPECT_NE(firstPktPlan.value().queue, consumerPktPlan.value().queue);
    const Span<GpuPacketDependency> consumerDeps = GpuExtFrontier_PacketDependencies(compiledPlan.packet(consumerPacket));
    ASSERT_EQ(consumerDeps.size(), 1u);
    EXPECT_EQ(consumerDeps[0u].producer, producerPacket);
}


