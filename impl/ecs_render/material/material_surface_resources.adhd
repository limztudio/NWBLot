#include <impl/ecs_render/material/material_system.adhd>
#include <impl/ecs_render/material/material_instance_override_applier.adhd>
#include <impl/ecs_render/material/material_surface_builder.adhd>
#include <impl/assets_texture/loader.adhd>
#include <impl/assets_sampler/loader.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_Texture2dAssetKindLabel = "Texture2D";
const StringView s_SamplerAssetKindLabel = "sampler";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void LogMaterialResourceLoadFailed(in Name materialName, in StringView resourceKindLabel, in Name assetName){
    error(
        "RendererSystem: material '{}' failed to load {} asset '{}'"
        , materialName.resolvedText()
        , resourceKindLabel
        , assetName.resolvedText()
    );
}

void LogEmptyRendererMaterial(){
    error("RendererSystem: renderer material is empty");
}

void LogMaterialResourceDescriptorHeapMissing(){
    error("RendererSystem: cannot resolve material resources without an initialized descriptor heap");
}

void LogIncompatibleTexture2dDimension(in Name assetPath){
    error("RendererSystem: Texture2D asset '{}' has an incompatible texture dimension", assetPath.resolvedText());
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
Expected<u32> ResolveTextureAssetSlot(mut RendererMaterialResourceState resources, in AssetRef<Texture> asset, mut GraphicsRuntime graphics, in AssetManager assetManager){
    assert(asset.valid());
    const Name path = asset.name();
    const auto existing = resources.textureAssetCache.find(path);
    if(existing != resources.textureAssetCache.end()){
        assert(existing.value().deref().valid() && existing.value().deref().sampledImageHeapHandle.descriptorClass() == GpuDescriptorClass::SampledImage);
        return existing.value().deref().sampledImageHeapHandle.slot();
    }
    UniquePtr<TextureGpuResource> candidate = MakeUnique<TextureGpuResource>();
    mut GpuDescriptorHeap heap = graphics.getDevice().getDescriptorHeap();
    GpuDescriptorRetirementGuard loading(heap, candidate.deref().sampledImageHeapHandle);
    if(!LoadTextureGpuResource(asset, path, s_RendererAssetOwnerName, graphics, assetManager, candidate.deref()))
        return MakeUnexpected(Failure());
    if(candidate.deref().sampledImageHeapHandle.descriptorClass() != GpuDescriptorClass::SampledImage){
        LogIncompatibleTexture2dDimension(path);
        return MakeUnexpected(Failure());
    }
    const GpuDescriptorHandle pending = candidate.deref().sampledImageHeapHandle;
    GpuDescriptorRetirementGuard unpublished(heap, pending);
    loading.release();
    if(TryEmplaceOwned<UniquePtr<TextureGpuResource>>(resources.textureAssetCache, path, candidate))
        unpublished.release();
    in TextureGpuResource resource = resources.textureAssetCache.at(path).deref();
    assert(resource.valid() && resource.sampledImageHeapHandle.descriptorClass() == GpuDescriptorClass::SampledImage);
    return resource.sampledImageHeapHandle.slot();
}

[cpp_unwind]
Expected<u32> ResolveSamplerAssetSlot(mut RendererMaterialResourceState resources, in AssetRef<Sampler> asset, mut GraphicsRuntime graphics, in AssetManager assetManager){
    assert(asset.valid());
    const Name path = asset.name();
    const auto existing = resources.samplerAssetCache.find(path);
    if(existing != resources.samplerAssetCache.end()){
        assert(existing.value().deref().valid() && existing.value().deref().samplerHeapHandle.descriptorClass() == GpuDescriptorClass::Sampler);
        return existing.value().deref().samplerHeapHandle.slot();
    }
    UniquePtr<SamplerGpuResource> candidate = MakeUnique<SamplerGpuResource>();
    mut GpuDescriptorHeap heap = graphics.getDevice().getDescriptorHeap();
    GpuDescriptorRetirementGuard loading(heap, candidate.deref().samplerHeapHandle);
    if(!LoadSamplerGpuResource(asset, path, s_RendererAssetOwnerName, graphics, assetManager, candidate.deref()))
        return MakeUnexpected(Failure());
    const GpuDescriptorHandle pending = candidate.deref().samplerHeapHandle;
    GpuDescriptorRetirementGuard unpublished(heap, pending);
    loading.release();
    if(TryEmplaceOwned<UniquePtr<SamplerGpuResource>>(resources.samplerAssetCache, path, candidate))
        unpublished.release();
    in SamplerGpuResource resource = resources.samplerAssetCache.at(path).deref();
    assert(resource.valid() && resource.samplerHeapHandle.descriptorClass() == GpuDescriptorClass::Sampler);
    return resource.samplerHeapHandle.slot();
}

[cpp_unwind]
b8 ResolveMaterialResourceReferences(mut MaterialSurfaceInfo materialInfo, mut RendererMaterialResourceState resources, mut GraphicsRuntime graphicsModule, in AssetManager assetManager){
    if(materialInfo.resourceReferencesResolved)
        return true;

    materialInfo.constantTypedBytes = materialInfo.unpatchedConstantTypedBytes;
    if(materialInfo.resourceReferences.empty()){
        materialInfo.resourceReferencesResolved = true;
        return true;
    }

    mut GpuDescriptorHeap heap = graphicsModule.getDevice().getDescriptorHeap();
    if(!heap.isInitialized()){
        LogMaterialResourceDescriptorHeapMissing();
        return false;
    }

    for(in MaterialResourceReference resourceReference : materialInfo.resourceReferences){
        Expected<u32> heapSlot = MakeUnexpected(Failure());
        switch(resourceReference.resourceKind){
        case MaterialResourceKind::SampledImage2D:
            heapSlot = ResolveTextureAssetSlot(resources, resourceReference.textureAsset, graphicsModule, assetManager);
            if(!heapSlot.has_value()){
                LogMaterialResourceLoadFailed(materialInfo.materialName, s_Texture2dAssetKindLabel, resourceReference.textureAsset.name());
                return false;
            }
            break;
        case MaterialResourceKind::Sampler:
            heapSlot = ResolveSamplerAssetSlot(resources, resourceReference.samplerAsset, graphicsModule, assetManager);
            if(!heapSlot.has_value()){
                LogMaterialResourceLoadFailed(materialInfo.materialName, s_SamplerAssetKindLabel, resourceReference.samplerAsset.name());
                return false;
            }
            break;
        default:
            assert(false);
            return false;
        }

        MaterialInstanceOverrideApplier().patchConstantResourceSlot(resourceReference.constantByteOffset, heapSlot.value(), materialInfo.constantTypedBytes);
    }

    materialInfo.resourceReferencesResolved = true;
    return true;
}

[cpp_unwind]
Expected<mut MaterialSurfaceInfo> RendererMaterialSystem::createMaterialSurfaceInfo(in AssetRef<Material> materialAsset){
    const Name materialPath = materialAsset.name();
    if(materialPath == s_NameNone){
        LogEmptyRendererMaterial();
        return MakeUnexpected(Failure());
    }

    const auto foundInfo = this.m_materialState.m_surfaceInfos.find(materialPath);
    if(foundInfo != this.m_materialState.m_surfaceInfos.end()){
        mut MaterialSurfaceInfo surfaceInfo = this.m_materialState.m_surfaceInfos.at(materialPath);
        if(!ResolveMaterialResourceReferences(surfaceInfo, this.m_materialState.m_resourceState, this.m_graphics, this.m_assetManager))
            return MakeUnexpected(Failure());
        return Expected<mut MaterialSurfaceInfo>(surfaceInfo);
    }

    auto loadedAsset = LoadTypedAssetSync<Material>(this.m_assetManager, materialPath, s_RendererAssetOwnerName);
    if(!loadedAsset.has_value())
        return MakeUnexpected(Failure());

    in Material material = loadedAsset.value().deref();

    MaterialSurfaceInfo createdInfo = this.m_materialState.emptySurface();
    assert(!material.shaderVariant().empty());
    assert(material.materialInterface() != s_NameNone);

    const auto pixelShader = material.findPixelShader();
    const auto meshShader = material.findMeshShader();
    const b8 hasPixelShader = pixelShader.has_value();
    const b8 hasMeshShader = meshShader.has_value();
    if(hasPixelShader)
        createdInfo.pixelShader = pixelShader.value();
    if(hasMeshShader)
        createdInfo.meshShader = meshShader.value();
    createdInfo.avboitAccumulatePixelShader = material.avboitAccumulatePixelShader();
    createdInfo.avboitOccupancyPixelShader = material.avboitOccupancyPixelShader();
    createdInfo.avboitExtinctionPixelShader = material.avboitExtinctionPixelShader();

    assert(material.typedLayoutHash() != 0u && !material.typedBlockBytes().empty());
    assert(material.typedLayoutBlocks().size() <= cast<usize>(u32.max));
    assert(material.typedLayoutFields().size() <= cast<usize>(u32.max));
    assert(material.typedBlockBytes().size() <= cast<usize>(u32.max));
    if(!MaterialSurfaceBuilder().populate(
        materialPath,
        material.shaderVariant(),
        hasMeshShader,
        hasPixelShader,
        material.transparent(),
        material.materialInterface(),
        material.typedLayoutHash(),
        material.typedLayoutBlocks(),
        material.typedLayoutFields(),
        material.typedBlockBytes(),
        material.resourceReferences(),
        material.shadingModelId(),
        material.surfaceDispatchId(),
        material.twoSided(),
        material.refractive(),
        createdInfo.materialName,
        createdInfo.shaderVariant,
        createdInfo.materialInterface,
        createdInfo.typedLayoutHash,
        createdInfo.typedLayoutBlocks,
        createdInfo.typedLayoutFields,
        createdInfo.resourceReferences,
        createdInfo.constantTypedBytes,
        createdInfo.mutableDefaultTypedBytes,
        createdInfo.unpatchedConstantTypedBytes,
        createdInfo.shadingModelId,
        createdInfo.surfaceDispatchId,
        createdInfo.csgCapSurfaceDispatchAvailable,
        createdInfo.transparent,
        createdInfo.twoSided,
        createdInfo.refractive
    ))
        return MakeUnexpected(Failure());
    BuildMaterialOverrideFieldLookup(createdInfo.typedLayoutBlocks, createdInfo.typedLayoutFields, createdInfo.overrideFieldLookup);
    if(!ResolveMaterialResourceReferences(createdInfo, this.m_materialState.m_resourceState, this.m_graphics, this.m_assetManager))
        return MakeUnexpected(Failure());

    const b8 inserted = TryEmplaceOwned<MaterialSurfaceInfo>(this.m_materialState.m_surfaceInfos, materialPath, createdInfo);
    mut MaterialSurfaceInfo stored = this.m_materialState.m_surfaceInfos.at(materialPath);
    if(inserted)
        assert(stored.resourceReferencesResolved);
    return Expected<mut MaterialSurfaceInfo>(stored);
}

Expected<mut MaterialSurfaceInfo> RendererMaterialSystem::findMaterialSurfaceInfo(in AssetRef<Material> materialAsset){
    const Name path = materialAsset.name();
    if(path == s_NameNone || this.m_materialState.m_surfaceInfos.find(path) == this.m_materialState.m_surfaceInfos.end())
        return MakeUnexpected(Failure());
    mut MaterialSurfaceInfo surface = this.m_materialState.m_surfaceInfos.at(path);
    if(!surface.resourceReferencesResolved)
        return MakeUnexpected(Failure());
    return Expected<mut MaterialSurfaceInfo>(surface);
}

[cpp_unwind]
void PrepareVisibleMaterialInstanceMutableCacheRow(
    mut RendererMaterialSystem system,
    in EntityID entity,
    in RendererComponent renderer,
    in MaterialInstanceComponent instance
){
    if(!renderer.visible || instance.overrides.empty())
        return;
    const auto surfaceInfo = system.findMaterialSurfaceInfo(renderer.material);
    if(!surfaceInfo.has_value())
        return;
    if(!system.prepareMaterialInstanceMutableTypedBytes(entity, surfaceInfo.value(), Optional<in MaterialInstanceComponent>(instance)).has_value())
        return;
}

[cpp_unwind]
b8 RendererMaterialSystem::prepareVisibleMaterialSurfaceInfos(){
    b8 transparent = false;
    b8 refractive = false;
    for(in auto row : this.m_world.view<RendererComponent>()){
        if(!Get<1>(row).visible)
            continue;
        const auto surfaceInfo = this.createMaterialSurfaceInfo(Get<1>(row).material);
        if(surfaceInfo.has_value()){
            if(surfaceInfo.value().transparent)
                transparent = true;
            if(surfaceInfo.value().refractive)
                refractive = true;
        }
    }
    this.m_materialState.m_hasVisibleRefractiveRenderers = refractive;
    this.m_materialState.m_visibleRefractiveRenderersVersion = this.m_world.componentMutationVersion<RendererComponent>();
    this.m_materialState.m_visibleRefractiveSurfaceCount = this.m_materialState.m_surfaceInfos.size();
    this.m_materialState.m_visibleRefractiveRenderersValid = true;
    return transparent;
}

b8 RendererMaterialSystem::hasNoVisibleRefractiveRenderers()const{
    return this.m_materialState.m_visibleRefractiveRenderersValid
        && !this.m_materialState.m_hasVisibleRefractiveRenderers
        && this.m_materialState.m_visibleRefractiveRenderersVersion == this.m_world.componentMutationVersion<RendererComponent>()
        && this.m_materialState.m_visibleRefractiveSurfaceCount == this.m_materialState.m_surfaceInfos.size();
}

[cpp_unwind]
void RendererMaterialSystem::prepareVisibleMaterialInstanceMutableCache(){
    this.m_materialState.m_instanceMutableCache.prune(this.m_world);
    for(in auto row : this.m_world.view<RendererComponent, MaterialInstanceComponent>())
        PrepareVisibleMaterialInstanceMutableCacheRow(this, Get<0>(row), Get<1>(row), Get<2>(row));
}

[cpp_unwind]
b8 RendererMaterialSystem::hasTransparentRenderers(in RendererResourceLookupMode lookupMode){
    for(in auto row : this.m_world.view<RendererComponent>()){
        if(!Get<1>(row).visible)
            continue;
        Expected<mut MaterialSurfaceInfo> surfaceInfo = MakeUnexpected(Failure());
        if(lookupMode == RendererResourceLookupMode::CreateMissing)
            surfaceInfo = this.createMaterialSurfaceInfo(Get<1>(row).material);
        else
            surfaceInfo = this.findMaterialSurfaceInfo(Get<1>(row).material);
        if(surfaceInfo.has_value() && surfaceInfo.value().transparent)
            return true;
    }
    return false;
}

[cpp_unwind]
Expected<Span<u8>> RendererMaterialSystem::prepareMaterialInstanceMutableTypedBytes(in EntityID entity, in MaterialSurfaceInfo materialInfo, in Optional<in MaterialInstanceComponent> materialInstance){
    return this.m_materialState.m_instanceMutableCache.prepare(this.m_world, entity, materialInfo, materialInstance);
}

Expected<Span<u8>> RendererMaterialSystem::findPreparedMaterialInstanceMutableTypedBytes(in EntityID entity, in MaterialSurfaceInfo materialInfo, in Optional<in MaterialInstanceComponent> materialInstance)const{
    return this.m_materialState.m_instanceMutableCache.find(entity, materialInfo, materialInstance);
}

[cpp_unwind]
void RendererMaterialSystem::releaseMaterialResourceReferences(){
    mut RendererMaterialResourceState resources = this.m_materialState.m_resourceState;
    for(auto it = resources.textureAssetCache.begin(); it != resources.textureAssetCache.end(); ++it){
        mut TextureGpuResource gpu = it.value().deref();
        ReleaseTextureGpuResource(this.m_graphics, gpu);
    }
    resources.textureAssetCache.clear();
    for(auto it = resources.samplerAssetCache.begin(); it != resources.samplerAssetCache.end(); ++it){
        mut SamplerGpuResource gpu = it.value().deref();
        ReleaseSamplerGpuResource(this.m_graphics, gpu);
    }
    resources.samplerAssetCache.clear();
    for(auto it = this.m_materialState.m_surfaceInfos.begin(); it != this.m_materialState.m_surfaceInfos.end(); ++it){
        mut MaterialSurfaceInfo surfaceInfo = it.value();
        surfaceInfo.constantTypedBytes = surfaceInfo.unpatchedConstantTypedBytes;
        surfaceInfo.resourceReferencesResolved = false;
    }
    this.m_materialState.m_visibleRefractiveRenderersValid = false;
}


