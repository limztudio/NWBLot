////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Name s_CsgClipContextSlotsBufferName = "engine/csg/clip_context_slots";
const Name s_CsgIntervalSampleStateBufferName = "engine/csg/interval_sample_state";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class CsgReceiverPassWorkSummary{
    public u32 maxCutterCount = 0u;
    public b8 opaqueWork = false;
    public b8 transparentWork = false;

    public b8 anyWork()const{
        return this.opaqueWork || this.transparentWork;
    }
}

b8 HasValidCsgGraphResourceCapacities(
    in usize receiverRangeCapacity,
    in usize cutterCapacity,
    in usize receiverRangeCount,
    in usize cutterCount
){
    return receiverRangeCapacity >= receiverRangeCount && cutterCapacity >= cutterCount;
}

b8 ShouldEvaluateCsgPassCutters(
    in b8 materialTransparent,
    in b8 affectOpaquePass,
    in b8 affectTransparentPass,
    in CsgReceiverPass pass
){
    switch(pass){
    case CsgReceiverPass::Opaque:
        return !materialTransparent && affectOpaquePass;
    case CsgReceiverPass::Transparent:
        return materialTransparent && affectTransparentPass;
    default:
        return false;
    }
}

CsgReceiverPassWorkSummary SummarizeCsgReceiverPassWork(in u32 opaqueCutterCount, in u32 transparentCutterCount){
    CsgReceiverPassWorkSummary summary;
    summary.maxCutterCount = Max(opaqueCutterCount, transparentCutterCount);
    summary.opaqueWork = opaqueCutterCount > 0u;
    summary.transparentWork = transparentCutterCount > 0u;
    return summary;
}

b8 ReserveCsgStructuredBuffer(
    in usize requiredCount,
    in usize elementByteSize,
    in Name debugName,
    mut GraphicsRuntime graphics,
    mut BufferHandle buffer,
    mut usize inOutCapacity
){
    if(requiredCount == 0u)
        return true;
    if(buffer.valid() && inOutCapacity >= requiredCount)
        return true;
    const Expected<CsgStructuredBufferCapacity> resolvedCapacity = ResolveCsgStructuredBufferCapacity(inOutCapacity, requiredCount, elementByteSize);
    if(!resolvedCapacity.has_value())
        return false;
    const usize capacity = resolvedCapacity.value().capacity;
    const u64 byteSize = resolvedCapacity.value().byteSize;

    BufferDesc bufferDesc;
    bufferDesc
        .setByteSize(byteSize)
        .setStructStride(cast<u32>(elementByteSize))
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
        .setDebugName(debugName)
        .enableAutomaticStateTracking(ResourceStates::Common)
    ;

    const Expected<BufferHandle> createdBufferResult = graphics.createBuffer(bufferDesc);
    if(!createdBufferResult.has_value())
        return false;

    buffer = createdBufferResult.value();
    inOutCapacity = capacity;
    return true;
}

b8 ReplaceCsgStorageBufferHeapHandle(mut Device device, mut Buffer buffer, mut GpuDescriptorHandle inOutHandle){
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized() || !ReplaceHeapBuffer(GpuDescriptorClass::StorageBuffer, false, heap, buffer, inOutHandle)){
        RetireDescriptor(heap, inOutHandle);
        return false;
    }
    return true;
}

b8 CsgGraphResourceSnapshot::bindingValid()const{
    return
        this.receiverRanges.valid()
        && this.cutters.valid()
        && this.clipContextSlots.valid()
        && this.intervalSampleState.valid()
        && IsDescriptorClass(this.receiverRangeHeapHandle, GpuDescriptorClass::StorageBuffer)
        && IsDescriptorClass(this.cutterHeapHandle, GpuDescriptorClass::StorageBuffer)
        && IsDescriptorClass(this.clipContextSlotsHeapHandle, GpuDescriptorClass::UniformBuffer)
        && IsDescriptorClass(this.intervalSampleStateHeapHandle, GpuDescriptorClass::UniformBuffer)
    ;
}

b8 CsgGraphResourceSnapshot::frameReady(in CsgFrameGpuDataView csgFrameData)const{
    if(!csgFrameData.hasWork())
        return true;

    return this.bindingValid() && HasValidCsgGraphResourceCapacities(this.receiverRangeCapacity, this.cutterCapacity, csgFrameData.receiverRanges.size(), csgFrameData.cutters.size());
}

Expected<u32> CsgGraphResourceSnapshot::findClipContextHeapSlot()const{
    if(!this.clipContextSlotsHeapHandle.valid())
        return MakeUnexpected(Failure());

    return this.clipContextSlotsHeapHandle.slot();
}

b8 RendererCsgSystem::createCsgClipResources(){
    mut Device device = this.m_graphics.getDevice();
    if(!EnsurePushConstantBindingLayout(device, sizeof(ShaderDrivenPushConstants), ShaderTypeMask::Mesh | ShaderTypeMask::Compute | ShaderTypeMask::Pixel, this.m_csgState.m_clipBindingLayout)){
        error("RendererSystem: failed to create CSG clip binding layout");
        return false;
    }

    if(!this.createCsgIntervalSampleStateBuffer())
        return false;
    if(!this.m_csgState.m_clipContextSlotsBuffer.valid()){
        BufferDesc bufferDesc;
        bufferDesc.setByteSize(sizeof(CsgClipContextSlots)).setIsConstantBuffer(true).setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute).setDebugName(s_CsgClipContextSlotsBufferName).enableAutomaticStateTracking(ResourceStates::Common);
        const Expected<BufferHandle> clipContextSlotsBufferResult = this.m_graphics.createBuffer(bufferDesc);
        if(clipContextSlotsBufferResult.has_value()){
            this.m_csgState.m_clipContextSlotsBuffer = clipContextSlotsBufferResult.value();
        }
        else{
            this.m_csgState.m_clipContextSlotsBuffer.reset();
            error("RendererSystem: failed to create CSG clip-context slot buffer");
            return false;
        }
    }
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(
        !heap.isInitialized()
        || !EnsureHeapBuffer(GpuDescriptorClass::UniformBuffer, false, heap, this.m_csgState.m_clipContextSlotsBuffer.deref(), this.m_csgState.m_clipContextSlotsHeapHandle)
        || !EnsureHeapBuffer(GpuDescriptorClass::UniformBuffer, false, heap, this.m_csgState.m_intervalSampleStateBuffer.deref(), this.m_csgState.m_intervalSampleStateHeapHandle)
    )
        return false;

    return true;
}

b8 RendererCsgSystem::createCsgIntervalSampleStateBuffer(){
    if(this.m_csgState.m_intervalSampleStateBuffer.valid())
        return true;

    BufferDesc bufferDesc;
    bufferDesc
        .setByteSize(sizeof(CsgIntervalSampleStateGpuData))
        .setIsConstantBuffer(true)
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
        .setDebugName(s_CsgIntervalSampleStateBufferName)
        .enableAutomaticStateTracking(ResourceStates::Common)
    ;

    const Expected<BufferHandle> intervalSampleStateBufferResult = this.m_graphics.createBuffer(bufferDesc);
    if(intervalSampleStateBufferResult.has_value()){
        this.m_csgState.m_intervalSampleStateBuffer = intervalSampleStateBufferResult.value();
        return true;
    }
    this.m_csgState.m_intervalSampleStateBuffer.reset();
    error("RendererSystem: failed to create CSG interval sample state buffer");
    return false;
}

b8 RendererCsgSystem::reserveCsgReceiverRangeBufferCapacity(in usize rangeCount){
    const usize oldCapacity = this.m_csgState.m_receiverRangeBufferCapacity;
    if(!ReserveCsgStructuredBuffer(rangeCount, sizeof(CsgReceiverRangeGpuData), s_CsgReceiverRangeBufferName, this.m_graphics, this.m_csgState.m_receiverRangeBuffer, this.m_csgState.m_receiverRangeBufferCapacity)){
        error("RendererSystem: failed to create CSG receiver range buffer");
        return false;
    }

    if(this.m_csgState.m_receiverRangeBufferCapacity != oldCapacity && !ReplaceCsgStorageBufferHeapHandle(this.m_graphics.getDevice(), this.m_csgState.m_receiverRangeBuffer.deref(), this.m_csgState.m_receiverRangeBufferHeapHandle)){
        error("RendererSystem: failed to register replacement CSG receiver range buffer in the descriptor heap");
        return false;
    }
    return true;
}

b8 RendererCsgSystem::reserveCsgCutterBufferCapacity(in usize cutterCount){
    const usize oldCapacity = this.m_csgState.m_cutterBufferCapacity;
    if(!ReserveCsgStructuredBuffer(cutterCount, sizeof(CsgCutterGpuData), s_CsgCutterBufferName, this.m_graphics, this.m_csgState.m_cutterBuffer, this.m_csgState.m_cutterBufferCapacity)){
        error("RendererSystem: failed to create CSG cutter buffer");
        return false;
    }

    if(this.m_csgState.m_cutterBufferCapacity != oldCapacity && !ReplaceCsgStorageBufferHeapHandle(this.m_graphics.getDevice(), this.m_csgState.m_cutterBuffer.deref(), this.m_csgState.m_cutterBufferHeapHandle)){
        error("RendererSystem: failed to register replacement CSG cutter buffer in the descriptor heap");
        return false;
    }
    return true;
}

b8 RendererCsgSystem::prepareCsgFrameResources(in usize receiverRangeCount, in usize cutterCount){
    if(receiverRangeCount == 0u || cutterCount == 0u)
        return true;
    assert(receiverRangeCount <= cast<usize>(u32.max));
    assert(cutterCount <= cast<usize>(u32.max));
    if(!this.reserveCsgReceiverRangeBufferCapacity(receiverRangeCount) || !this.reserveCsgCutterBufferCapacity(cutterCount))
        return false;
    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
    if(
        !heap.isInitialized()
        || !EnsureHeapBuffer(GpuDescriptorClass::StorageBuffer, false, heap, this.m_csgState.m_receiverRangeBuffer.deref(), this.m_csgState.m_receiverRangeBufferHeapHandle)
        || !EnsureHeapBuffer(GpuDescriptorClass::StorageBuffer, false, heap, this.m_csgState.m_cutterBuffer.deref(), this.m_csgState.m_cutterBufferHeapHandle)
        || !this.m_csgState.m_clipContextSlotsBuffer.valid() || !this.m_csgState.m_clipContextSlotsHeapHandle.valid()
        || !this.m_csgState.m_intervalSampleStateBuffer.valid() || !this.m_csgState.m_intervalSampleStateHeapHandle.valid()
    ){
        error("RendererSystem: CSG clip context heap registration is incomplete");
        return false;
    }
    if(!this.m_csgState.m_clipBindingLayout.valid())
        return false;

    assert(this.m_csgState.m_receiverRangeBufferCapacity >= receiverRangeCount);
    assert(this.m_csgState.m_cutterBufferCapacity >= cutterCount);
    assert(this.m_csgState.m_receiverRangeBufferHeapHandle.valid());
    assert(this.m_csgState.m_cutterBufferHeapHandle.valid());
    assert(this.m_csgState.m_clipContextSlotsHeapHandle.valid());
    assert(this.m_csgState.m_intervalSampleStateHeapHandle.valid());
    return true;
}

CsgGraphResourceSnapshot RendererCsgSystem::csgGraphResourceSnapshot(in b8 retainRefractionCapPipeline)const{
    CsgGraphResourceSnapshot snapshot;
    snapshot.receiverRanges = this.m_csgState.m_receiverRangeBuffer;
    snapshot.cutters = this.m_csgState.m_cutterBuffer;
    snapshot.clipContextSlots = this.m_csgState.m_clipContextSlotsBuffer;
    snapshot.intervalSampleState = this.m_csgState.m_intervalSampleStateBuffer;
    if(retainRefractionCapPipeline)
        snapshot.refractionCapFillPipeline = this.m_csgState.m_refractionCapFillPipeline;
    snapshot.receiverRangeCapacity = this.m_csgState.m_receiverRangeBufferCapacity;
    snapshot.cutterCapacity = this.m_csgState.m_cutterBufferCapacity;
    snapshot.receiverRangeHeapHandle = this.m_csgState.m_receiverRangeBufferHeapHandle;
    snapshot.cutterHeapHandle = this.m_csgState.m_cutterBufferHeapHandle;
    snapshot.clipContextSlotsHeapHandle = this.m_csgState.m_clipContextSlotsHeapHandle;
    snapshot.intervalSampleStateHeapHandle = this.m_csgState.m_intervalSampleStateHeapHandle;
    return snapshot;
}

Expected<CsgClipContextSlots> RendererCsgSystem::prepareCsgClipContextSlotData(
    in DeferredFrameTargets targets,
    in CsgFrameGpuDataView csgFrameData,
    in CsgGraphResourceSnapshot csgResources,
    in MeshFrameBindingSnapshot frameBindings
)const{
    CsgClipContextSlots contextSlots;
    if(!csgFrameData.hasWork())
        return contextSlots;
    if(!csgResources.frameReady(csgFrameData) || !frameBindings.bindingValid() || !targets.bindless.slotsBufferDescriptor.valid())
        return MakeUnexpected(Failure());

    return ResolveCsgClipContextSlots(
        csgResources.receiverRangeHeapHandle.slot(),
        csgResources.cutterHeapHandle.slot(),
        frameBindings.materialTypedHeapHandle.slot(),
        frameBindings.instanceHeapHandle.slot(),
        targets.bindless.slotsBufferDescriptor.slot(),
        csgResources.intervalSampleStateHeapHandle.slot()
    );
}

Expected<CsgIntervalSampleStateGpuData> RendererCsgSystem::prepareCsgIntervalSampleStateData(
    in DeferredFrameTargets targets,
    in CsgFrameGpuDataView csgFrameData,
    in CsgGraphResourceSnapshot csgResources,
    in MeshFrameBindingSnapshot frameBindings
)const{
    CsgIntervalSampleStateGpuData state;
    if(!csgFrameData.hasWork())
        return state;
    if(!csgResources.frameReady(csgFrameData) || !frameBindings.bindingValid())
        return MakeUnexpected(Failure());

    return ResolveCsgIntervalSampleState(csgFrameData.workRegion, targets.width, targets.height, frameBindings.meshView.heapHandle.slot());
}

void RendererCsgSystem::releaseCsgClipContextHeapHandles(){
    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
    RetireDescriptor(heap, this.m_csgState.m_receiverRangeBufferHeapHandle);
    RetireDescriptor(heap, this.m_csgState.m_cutterBufferHeapHandle);
    RetireDescriptor(heap, this.m_csgState.m_clipContextSlotsHeapHandle);
    RetireDescriptor(heap, this.m_csgState.m_intervalSampleStateHeapHandle);
}


