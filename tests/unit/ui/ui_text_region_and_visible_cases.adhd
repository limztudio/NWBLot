class UiTextRegionIntrinsicRowSource : ComboSource{
    public StringView ordinaryText = s_UiTextRegionOrdinaryRowText;
    public StringView specialText = s_UiTextRegionStackedAccentText;
    public u64 specialIndex = 1u;

    public StringView text(in u64 index)const override{
        ++this.textCalls.value();
        if(index == this.specialIndex)
            return this.specialText;
        return this.ordinaryText;
    }
}

class UiTextRegionTests : WidgetFixture{


    public void setup(){
        this.setUpWidgetBase();
        if(HasFatalTestFailure())
            return;
        RegionVector regions;
        for(in UiSkinRegion existing : this.m_skin.regions())
            regions.push_back(existing);
        const Array<StringView, 4u> names(s_UiTextRegionCheckboxNormalRegion, "checkbox.hover", "checkbox.checked", "checkbox.disabled");
        for(u32 index = 0u; index < names.size(); ++index){
            const auto regionName = ParseName(names[index]);
            ASSERT_TRUE(regionName.has_value());
            UiSkinRegion region;
            region.name = regionName.value();
            region.rectangle.x = 88u + index * 8u;
            region.rectangle.width = 8u;
            region.rectangle.height = 8u;
            region.minimumWidth = 24.0f;
            region.minimumHeight = 24.0f;
            regions.push_back(region);
        }
        this.m_skin.setAtlas(this.m_skin.texture(), this.m_skin.atlasWidth(), this.m_skin.atlasHeight(), this.m_skin.referenceDensity(), regions);
        ASSERT_TRUE(this.m_skin.validatePayload());
        this.m_builder.setSkin(this.m_skin);
    }
    public void useDefaultButtonPadding(){
        RegionVector regions;
        for(in UiSkinRegion existing : this.m_skin.regions())
            regions.push_back(existing);
        for(mut UiSkinRegion region : regions){
            if(region.name == Name("button.normal") || region.name == Name("button.hover") || region.name == Name("button.pressed") || region.name == Name("button.disabled")){
                region.padding = MakeFixtureSkinInsets(8.0f, 8.0f, 8.0f, 8.0f);
                region.minimumHeight = 32.0f;
            }
        }
        this.m_skin.setAtlas(this.m_skin.texture(), this.m_skin.atlasWidth(), this.m_skin.atlasHeight(), this.m_skin.referenceDensity(), regions);
        ASSERT_TRUE(this.m_skin.validatePayload());
        this.m_builder.setSkin(this.m_skin);
    }
    public void useAsymmetricSelectableButtons(){
        RegionVector regions;
        for(in UiSkinRegion existing : this.m_skin.regions())
            regions.push_back(existing);
        for(mut UiSkinRegion region : regions){
            if(region.name == Name("button.normal"))
                region.padding = MakeFixtureSkinInsets(9.0f, 1.0f, 2.0f, 3.0f);
            else if(region.name == Name("button.hover"))
                region.padding = MakeFixtureSkinInsets(1.0f, 11.0f, 2.0f, 3.0f);
            else if(region.name == Name("button.pressed")){
                region.padding = MakeFixtureSkinInsets(1.0f, 2.0f, 13.0f, 3.0f);
                region.minimumHeight = 55.0f;
            }
            else if(region.name == Name("button.disabled")){
                region.padding = MakeFixtureSkinInsets(1.0f, 2.0f, 3.0f, 15.0f);
                region.minimumWidth = 100.0f;
            }
        }
        this.m_skin.setAtlas(this.m_skin.texture(), this.m_skin.atlasWidth(), this.m_skin.atlasHeight(), this.m_skin.referenceDensity(), regions);
        ASSERT_TRUE(this.m_skin.validatePayload());
        this.m_builder.setSkin(this.m_skin);
    }
    public void checkIntrinsicRowCoverage(in b8 popup, in f32 fontSize, in DisplayMetrics display, in u64 generation, mut UiTextRegionIntrinsicRowSource source, mut ListState list, mut ComboState combo){
        const ScopedTestTrace popupTrace(popup);
        const ScopedTestTrace sizeTrace(fontSize);
        const ScopedTestTrace scaleXTrace(display.pixelScaleX);
        const ScopedTestTrace scaleYTrace(display.pixelScaleY);
        this.m_builder.style().fontSize = fontSize;
        const auto rowMetrics = MeasureSelectable(this.m_skin, this.m_builder.listStyle().row);
        ASSERT_TRUE(rowMetrics.has_value());
        ASSERT_TRUE(this.begin(generation, display));
        ASSERT_TRUE(this.m_builder.beginPanel("rows_panel", Rect(10.0f, 20.0f, 600.0f, 540.0f)));
        StringView ownerKey = "list";
        if(popup)
            ownerKey = "combo";
        const WidgetId owner = this.id(ownerKey, "rows_panel");
        if(popup){
            ASSERT_TRUE(ReconcileComboState(combo, source));
            if(!combo.isOpen())
                combo.open();
            ComboOptions options;
            options.width = LayoutSize(LayoutSizePolicy::Fixed, 400.0f);
            options.popupHeight = 320.0f;
            options.placeholder = "";
            ASSERT_TRUE(this.m_builder.comboBox("combo", source, combo, options).valid);
        }
        else{
            ListOptions options;
            options.width = LayoutSize(LayoutSizePolicy::Fixed, 400.0f);
            options.height = LayoutSize(LayoutSizePolicy::Fixed, 320.0f);
            ASSERT_TRUE(this.m_builder.virtualList("list", source, list, options).valid);
        }
        ASSERT_TRUE(this.finishPanel());
        const DrawSnapshot actual = this.m_paint.freeze();
        ASSERT_TRUE(this.m_context.commitFrame(generation));
        ScrollPlacement placement = list.placement();
        if(popup)
            placement = combo.listState().placement();
        ASSERT_GT(placement.endRow, placement.firstRow);
        WidgetId listOwner = owner;
        if(popup)
            listOwner = RequireUiWidgetId(owner, "rows");
        const WidgetId rows = RequireUiWidgetId(listOwner, "rows");
        const Optional<in HitTarget> first = this.target(RequireUiWidgetPartId(rows, placement.firstRow + 1u));
        ASSERT_TRUE(first.has_value());
        const f32 rowHeight = first.value().rectangle.height;
        f32 expectedHeight = rowMetrics.value().minimum.y;
        const Array<StringView, 3u> labels(StringView(), source.ordinaryText, source.specialText);
        for(in StringView label : labels){
            const auto layout = this.m_text.layout(MakeUiShapeRequest(label, fontSize));
            ASSERT_TRUE(layout.has_value());
            const auto visual = this.m_text.measure(layout.value(), display);
            ASSERT_TRUE(visual.has_value());
            const VectorSingle candidateRowHeight(visual.value().height + rowMetrics.value().padding.top + rowMetrics.value().padding.bottom);
            const VectorSingle prevHeight(expectedHeight);
            expectedHeight = VectorSelect(candidateRowHeight, prevHeight, VectorGreater(prevHeight, candidateRowHeight)).x;
        }
        EXPECT_FLOAT_EQ(rowHeight, expectedHeight);
        const f64 rowHeight64 = cast<f64>(rowHeight);
        EXPECT_DOUBLE_EQ(placement.contentHeight, rowHeight64 * cast<f64>(source.count));
        const Optional<in HitTarget> host = this.target(listOwner);
        ASSERT_TRUE(host.has_value());
        EXPECT_DOUBLE_EQ(host.value().scrollStep, rowHeight64 * 3.0);
        PaintBuilder reference;
        reference.begin(display, generation, this.m_skinGeneration, AssetRef<UiSkin>(s_TestSkinPath), this.m_skin);
        reference.pushClip(placement.contentClip);
        for(u64 index = placement.firstRow; index < placement.endRow; ++index){
            const Optional<in HitTarget> row = this.target(RequireUiWidgetPartId(rows, index + 1u));
            ASSERT_TRUE(row.has_value());
            EXPECT_FLOAT_EQ(row.value().rectangle.height, rowHeight);
            StringView label = source.ordinaryText;
            if(index == source.specialIndex)
                label = source.specialText;
            const auto layout = this.m_text.layout(MakeUiShapeRequest(label, fontSize));
            ASSERT_TRUE(layout.has_value());
            const auto visual = this.m_text.measure(layout.value(), display);
            ASSERT_TRUE(visual.has_value());
            in Insets padding = rowMetrics.value().padding;
            const f32 paddedHeight = visual.value().height + padding.top + padding.bottom;
            EXPECT_GE(rowHeight + 0.0001f, paddedHeight);
            const f32 contentHeight = rowHeight - padding.top - padding.bottom;
            const VectorSingle rawCentering((contentHeight - visual.value().height) * 0.5f);
            const VectorSingle zero(0.0f);
            const f32 centering = VectorSelect(rawCentering, zero, VectorGreater(zero, rawCentering)).x;
            const Point origin(row.value().rectangle.x + padding.left - visual.value().x, row.value().rectangle.y + padding.top + centering - visual.value().y);
            ASSERT_TRUE(this.m_text.paint(reference, layout.value(), origin, this.m_builder.style().text));
        }
        ASSERT_TRUE(reference.popClip());
        const auto expectedCoverage = UiTextRegionGlyphCoverageArea(reference.freeze());
        const auto actualCoverage = UiTextRegionGlyphCoverageArea(actual);
        ASSERT_TRUE(expectedCoverage.has_value());
        ASSERT_TRUE(actualCoverage.has_value());
        ASSERT_GT(expectedCoverage.value(), 0.0);
        const VectorDouble minTol(0.00001);
        const VectorDouble relTol(expectedCoverage.value() * 0.000002);
        EXPECT_NEAR(actualCoverage.value(), expectedCoverage.value(), VectorDoubleSelect(relTol, minTol, VectorDoubleGreater(minTol, relTol)).x);
    }
    public void checkContentButtonRow(in StringView firstText, in StringView secondText, in f32 fontSize, in f32 scale, in u64 generation){ this.checkContentButtonRow(firstText, secondText, fontSize, scale, generation, false); }
    public void checkContentButtonRow(in StringView firstText, in StringView secondText, in f32 fontSize, in f32 scale, in u64 generation, in b8 fixedHeight){
        const ScopedTestTrace sizeTrace(fontSize);
        const ScopedTestTrace scaleTrace(scale);
        const ScopedTestTrace heightTrace(fixedHeight);
        this.m_builder.style().fontSize = fontSize;
        const DisplayMetrics display(800.0f, 600.0f, scale, scale);
        auto firstLayout = this.m_text.layout(MakeUiShapeRequest(firstText, fontSize));
        auto secondLayout = this.m_text.layout(MakeUiShapeRequest(secondText, fontSize));
        ASSERT_TRUE(firstLayout.has_value());
        ASSERT_TRUE(secondLayout.has_value());
        const Point firstLogical = firstLayout.value().measure();
        const Point secondLogical = secondLayout.value().measure();
        const auto firstMeasured = this.m_text.measure(firstLayout.value(), display);
        const auto secondMeasured = this.m_text.measure(secondLayout.value(), display);
        ASSERT_TRUE(firstMeasured.has_value());
        ASSERT_TRUE(secondMeasured.has_value());
        EXPECT_FLOAT_EQ(firstLayout.value().measure().y, firstLogical.y);
        EXPECT_FLOAT_EQ(secondLayout.value().measure().y, secondLogical.y);
        EXPECT_GE(firstMeasured.value().height, firstLogical.y);
        EXPECT_GE(secondMeasured.value().height, secondLogical.y);
        f32 firstHeight = 32.0f;
        f32 secondHeight = 32.0f;
        if(!fixedHeight){
            const VectorSingle minHeight(32.0f);
            const VectorSingle measuredHeights = (VectorSingle(firstMeasured.value().height, secondMeasured.value().height, 0.0f, 0.0f) + VectorSingle(8.0f)) + VectorSingle(8.0f);
            const VectorSingle rowHeights = VectorSelect(measuredHeights, minHeight, VectorGreater(minHeight, measuredHeights));
            firstHeight = rowHeights.x;
            secondHeight = rowHeights.y;
        }
        ASSERT_TRUE(this.begin(generation, display));
        ASSERT_TRUE(this.m_builder.beginPanel(s_UiTextRegionPanelKey, Rect(10.0f, 20.0f, 740.0f, 480.0f)));
        ContainerOptions row;
        if(fixedHeight)
            row.height = LayoutSize(LayoutSizePolicy::Fixed, 32.0f);
        ASSERT_TRUE(this.m_builder.beginRow("navigation", row));
        WidgetOptions navigation;
        const VectorSingle firstWidth(firstMeasured.value().width);
        const VectorSingle secondWidth(secondMeasured.value().width);
        const f32 maxMeasuredWidth = VectorSelect(secondWidth, firstWidth, VectorGreater(firstWidth, secondWidth)).x;
        const VectorSingle minNav(100.0f);
        const VectorSingle calcNav(maxMeasuredWidth + 16.0f);
        navigation.width = LayoutSize(LayoutSizePolicy::Fixed, VectorSelect(calcNav, minNav, VectorGreater(minNav, calcNav)).x);
        if(fixedHeight)
            navigation.height = LayoutSize(LayoutSizePolicy::Fixed, 32.0f);
        EXPECT_FALSE(this.m_builder.button("previous", firstText, navigation));
        EXPECT_FALSE(this.m_builder.button("next", secondText, navigation));
        ASSERT_TRUE(this.m_builder.endContainer());
        WidgetOptions marker;
        marker.width = LayoutSize(LayoutSizePolicy::Fixed, 40.0f);
        marker.height = LayoutSize(LayoutSizePolicy::Fixed, 24.0f);
        EXPECT_FALSE(this.m_builder.button("after", "", marker));
        ASSERT_TRUE(this.finishPanel());
        const DrawSnapshot actual = this.m_paint.freeze();
        ASSERT_TRUE(this.m_context.commitFrame(generation));
        const WidgetId rowId = this.id("navigation", s_UiTextRegionPanelKey);
        const Optional<in HitTarget> first = this.target(RequireUiWidgetId(rowId, "previous"));
        const Optional<in HitTarget> second = this.target(RequireUiWidgetId(rowId, "next"));
        const Optional<in HitTarget> after = this.target(this.id("after", s_UiTextRegionPanelKey));
        ASSERT_TRUE(first.has_value());
        ASSERT_TRUE(second.has_value());
        ASSERT_TRUE(after.has_value());
        EXPECT_FLOAT_EQ(first.value().rectangle.height, firstHeight);
        EXPECT_FLOAT_EQ(second.value().rectangle.height, secondHeight);
        EXPECT_FLOAT_EQ(second.value().rectangle.y, first.value().rectangle.y);
        const VectorSingle firstHVec(firstHeight);
        const VectorSingle secondHVec(secondHeight);
        EXPECT_FLOAT_EQ(after.value().rectangle.y, first.value().rectangle.y + VectorSelect(secondHVec, firstHVec, VectorGreater(firstHVec, secondHVec)).x + this.m_builder.style().gap);
        ExpectUiRect(first.value().clip, first.value().rectangle);
        ExpectUiRect(second.value().clip, second.value().rectangle);
        PaintBuilder reference;
        reference.begin(display, generation, 1u, AssetRef<UiSkin>(s_TestSkinPath), this.m_skin);
        const Array<Rect, 2u> controls(first.value().rectangle, second.value().rectangle);
        const Array<Rect, 2u> measured(firstMeasured.value(), secondMeasured.value());
        for(u32 index = 0u; index < 2u; ++index){
            in Rect bounds = controls[index];
            in Rect visual = measured[index];
            const VectorSingle zero(0.0f);
            const VectorSingle rawSlack = ((VectorSingle(bounds.width, bounds.height, 0.0f, 0.0f) - VectorSingle(16.0f)) - VectorSingle(visual.width, visual.height, 0.0f, 0.0f)) * VectorSingle(0.5f);
            const VectorSingle clampedSlack = VectorSelect(rawSlack, zero, VectorGreater(zero, rawSlack));
            const VectorSingle centered = VectorSingle(bounds.x, bounds.y, 0.0f, 0.0f) + VectorSingle(8.0f) + clampedSlack;
            const f32 centeredX = centered.x;
            const f32 centeredY = centered.y;
            const Point origin(centeredX - visual.x, centeredY - visual.y);
            if(index == 0u)
                ASSERT_TRUE(this.m_text.paint(reference, firstLayout.value(), origin, this.m_builder.style().text));
            else
                ASSERT_TRUE(this.m_text.paint(reference, secondLayout.value(), origin, this.m_builder.style().text));
        }
        const DrawSnapshot expected = reference.freeze();
        const auto actualCoverage = UiTextRegionGlyphCoverageArea(actual);
        const auto expectedCoverage = UiTextRegionGlyphCoverageArea(expected);
        ASSERT_TRUE(actualCoverage.has_value());
        ASSERT_TRUE(expectedCoverage.has_value());
        ASSERT_GT(expectedCoverage.value(), 0.0);
        if(fixedHeight)
            EXPECT_LT(actualCoverage.value(), expectedCoverage.value() * 0.999);
        else{
            const VectorDouble minTol(0.00001);
            const VectorDouble relTol(expectedCoverage.value() * 0.000002);
            EXPECT_NEAR(actualCoverage.value(), expectedCoverage.value(), VectorDoubleSelect(relTol, minTol, VectorDoubleGreater(minTol, relTol)).x);
        }
    }
}

class TextVisibleBakedTests : TextVisibleFixture{
    public FontAtlas m_baked = FontAtlas(Name(s_UiCaseTestsUiFontsVisibleAtlas));

    public b8 installBaked(in StringView text){
        if(!this.installCoverageFonts())
            return false;
        auto layout = this.m_text.layout(MakeUiShapeRequest(text, 32.0f));
        if(!layout.has_value())
            return false;
        TestMoveAssign<TextLayout>(this.m_layout, layout.value());
        FontAtlasPayload payload;
        payload.font = AssetRef<Font>(s_TestLatinFontPath);
        in Vector<u8> bytes = this.m_latin.fontBytes();
        payload.fontSha256 = ComputeSha256(bytes);
        PopulateBakedFontTables(bytes, payload);
        payload.bakePpem = 32u;
        payload.ascenderUnits = 1000.0f;
        payload.descenderUnits = -250.0f;
        payload.glyphs.resize(payload.sourceGlyphCount);
        for(u32 glyphIndex = 0u; glyphIndex < payload.sourceGlyphCount; ++glyphIndex)
            payload.glyphs[glyphIndex].glyphId = glyphIndex;
        const f32 unitsPerPixel = cast<f32>(payload.unitsPerEm) / 32.0f;
        for(in PlacedGlyph placed : this.m_layout.glyphs()){
            if(placed.face.deref().identity() != payload.font || placed.glyphId >= payload.glyphs.size())
                return false;
            mut FontAtlasGlyph glyph = payload.glyphs[placed.glyphId];
            if(glyph.drawable != 0u || placed.ink.width <= 0.0f || placed.ink.height <= 0.0f)
                continue;
            if(payload.groups.size() == s_FontAtlasMaxGroupCount)
                return false;
            const VectorSingle inkOrigin = VectorFloor(VectorSingle(placed.ink.x, placed.ink.y, 0.0f, 0.0f)) - VectorSingle(8.0f);
            const VectorSingle inkEnd = VectorCeiling(VectorSingle(placed.ink.x + placed.ink.width, placed.ink.y + placed.ink.height, 0.0f, 0.0f));
            const f32 startX = inkOrigin.x;
            const f32 startY = inkOrigin.y;
            const VectorSingle inkExtent = (inkEnd - inkOrigin) + VectorSingle(8.0f);
            const f32 extentX = inkExtent.x;
            const f32 extentY = inkExtent.y;
            const u32 width = cast<u32>(extentX);
            const u32 height = cast<u32>(extentY);
            if(width > 62u || height > 62u)
                return false;
            glyph.group = cast<u32>(payload.groups.size());
            glyph.drawable = 1u;
            glyph.x = 1u;
            glyph.y = 1u;
            glyph.width = width;
            glyph.height = height;
            const VectorSingle planeOrigin = VectorSingle(startX, startY, 0.0f, 0.0f) * VectorSingle(unitsPerPixel);
            const VectorSingle planeEnd = planeOrigin + VectorSingle(extentX, extentY, 0.0f, 0.0f) * VectorSingle(unitsPerPixel);
            glyph.planeLeft = planeOrigin.x;
            glyph.planeTop = planeOrigin.y;
            glyph.planeRight = planeEnd.x;
            glyph.planeBottom = planeEnd.y;
            AppendArenaElement<FontAtlasGroup>(payload.groups);
            mut FontAtlasGroup group = payload.groups.back();
            group.width = 64u;
            group.height = 64u;
            group.pixels.resize(64u * 64u * 4u, 192u);
            group.sha256 = ComputeSha256(group.pixels);
        }
        this.m_baked.setPayload(payload);
        if(!this.m_baked.validatePayload())
            return false;
        const Array<FontSource, 2u> sources(FontSource(AssetRef<Font>(s_TestLatinFontPath), this.m_latin, 1u, this.m_baked), FontSource(AssetRef<Font>(s_TestKoreanFontPath), this.m_korean, 1u));
        if(!this.m_text.setFonts(sources))
            return false;
        layout = this.m_text.layout(MakeUiShapeRequest(text, 32.0f));
        if(!layout.has_value())
            return false;
        TestMoveAssign<TextLayout>(this.m_layout, layout.value());
        return true;
    }
}

class TextVisibleCoverageTests : TextVisibleFixture{
    public GlyphBitmap m_bitmap;
    public FontAtlas m_measuredBaked = FontAtlas(Name(s_UiCaseTestsUiFontsMeasuredSdf));

    public b8 paintClipped(in TextLayout layout, in Rect clip){ return this.paintClipped(layout, clip, Point(20.0f, 20.0f)); }
    public b8 paintClipped(in TextLayout layout, in Rect clip, in Point origin){
        return PaintUiTextVisibleClipped(this, layout, clip, origin);
    }
    public Expected<Rect> rasterRectangle(in PlacedGlyph glyph, in f32 fontSize, in DisplayMetrics display, in Point origin){
        return ComputeUiTextVisibleRasterRect(this, glyph, fontSize, display, origin);
    }
    public b8 installMeasuredSdfAtlas(in u32 targetGlyphId){
        FontAtlasPayload payload;
        payload.font = AssetRef<Font>(s_TestLatinFontPath);
        in Vector<u8> bytes = this.m_latin.fontBytes();
        payload.fontSha256 = ComputeSha256(bytes);
        PopulateBakedFontTables(bytes, payload);
        payload.bakePpem = 32u;
        payload.ascenderUnits = 1069.0f;
        payload.descenderUnits = -293.0f;
        payload.glyphs.resize(payload.sourceGlyphCount);
        for(u32 index = 0u; index < payload.sourceGlyphCount; ++index)
            payload.glyphs[index].glyphId = index;
        mut FontAtlasGlyph glyph = payload.glyphs[targetGlyphId];
        glyph.drawable = 1u;
        glyph.channel = 3u;
        glyph.x = 1u;
        glyph.y = 1u;
        glyph.width = 48u;
        glyph.height = 48u;
        glyph.planeLeft = -1000.0f;
        glyph.planeTop = -2000.0f;
        const f32 bakeScale = cast<f32>(payload.unitsPerEm) / cast<f32>(payload.bakePpem);
        const VectorSingle planeEnd = VectorSingle(glyph.planeLeft, glyph.planeTop, 0.0f, 0.0f) + VectorSingle(cast<f32>(glyph.width), cast<f32>(glyph.height), 0.0f, 0.0f) * VectorSingle(bakeScale);
        glyph.planeRight = planeEnd.x;
        glyph.planeBottom = planeEnd.y;
        AppendArenaElement<FontAtlasGroup>(payload.groups);
        mut FontAtlasGroup group = payload.groups.back();
        group.width = 64u;
        group.height = 64u;
        group.pixels.resize(64u * 64u * 4u, 255u);
        for(u32 y = 0u; y < group.height; ++y){
            for(u32 x = 0u; x < group.width; ++x){
                const i32 localX = cast<i32>(x) - cast<i32>(glyph.x);
                const i32 localY = cast<i32>(y) - cast<i32>(glyph.y);
                const i32 distance = Min(Min(localX - 15, 25 - localX), Min(localY - 13, 23 - localY));
                group.pixels[(cast<usize>(y) * group.width + x) * 4u + glyph.channel] = cast<u8>(Clamp(128 + 16 * distance, 0, 255));
            }
        }
        group.sha256 = ComputeSha256(group.pixels);
        this.m_measuredBaked.setPayload(payload);
        if(!this.m_measuredBaked.validatePayload())
            return false;
        const Array<FontSource, 1u> sources(FontSource(AssetRef<Font>(s_TestLatinFontPath), this.m_latin, 1u, this.m_measuredBaked));
        return this.m_text.setFonts(sources);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<f64> UiTextRegionGlyphCoverageArea(in DrawSnapshot snapshot){
    f64 area = 0.0;
    for(in DrawCommand command : snapshot.commands()){
        if(command.material == PaintMaterial::SdfGlyph)
            return MakeUnexpected(Failure());
        if(command.material != PaintMaterial::Glyph)
            continue;
        if(command.glyphPageIndex >= snapshot.glyphPages().size() || command.indexCount % 6u != 0u || cast<usize>(command.firstIndex) + command.indexCount > snapshot.indices().size())
            return MakeUnexpected(Failure());
        in GlyphPage page = snapshot.glyphPages()[command.glyphPageIndex].deref();
        in GlyphPageBinding binding = page.binding();
        if(page.pixels().size() != cast<usize>(binding.width) * binding.height)
            return MakeUnexpected(Failure());
        const VectorDouble textureSize = VectorDouble(cast<f64>(binding.width), cast<f64>(binding.height), cast<f64>(binding.width), cast<f64>(binding.height));
        for(u32 index = command.firstIndex; index < command.firstIndex + command.indexCount; index += 6u){
            if(snapshot.indices()[index] >= snapshot.vertices().size() || snapshot.indices()[index + 2u] >= snapshot.vertices().size())
                return MakeUnexpected(Failure());
            in Vertex first = snapshot.vertices()[snapshot.indices()[index]];
            in Vertex last = snapshot.vertices()[snapshot.indices()[index + 2u]];
            const VectorDouble texel = VectorDouble(first.texCoord.x, first.texCoord.y, last.texCoord.x, last.texCoord.y) * textureSize;
            const f64 left = texel.x;
            const f64 top = texel.y;
            const f64 right = texel.z;
            const f64 bottom = texel.w;
            if(!IsFinite(texel) || left < 0.0 || top < 0.0 || right > binding.width || bottom > binding.height || right <= left || bottom <= top)
                return MakeUnexpected(Failure());
            const VectorDouble extent = VectorDouble(cast<f64>(last.position.x), cast<f64>(last.position.y), 0.0, 0.0) - VectorDouble(cast<f64>(first.position.x), cast<f64>(first.position.y), 0.0, 0.0);
            const f64 width = extent.x;
            const f64 height = extent.y;
            if(!IsFinite(extent.xy) || width <= 0.0 || height <= 0.0)
                return MakeUnexpected(Failure());
            const f64 texelArea = (width / (right - left)) * (height / (bottom - top));
            const VectorDouble snappedEnd = VectorDoubleCeiling(texel);
            const VectorDouble snappedBegin = VectorDoubleFloor(texel);
            const u32 endX = cast<u32>(snappedEnd.z);
            const u32 endY = cast<u32>(snappedEnd.w);
            for(u32 y = cast<u32>(snappedBegin.y); y < endY; ++y){
                const f64 row = cast<f64>(y);
                const VectorDouble topRow(top);
                const VectorDouble bottomVec(bottom);
                const VectorDouble rowPlusOne(row + 1.0);
                const VectorDouble rowVec(row);
                const f64 visibleHeight = VectorDoubleSelect(rowPlusOne, bottomVec, VectorDoubleLess(bottomVec, rowPlusOne)).x - VectorDoubleSelect(rowVec, topRow, VectorDoubleGreater(topRow, rowVec)).x;
                for(u32 x = cast<u32>(snappedBegin.x); x < endX; ++x){
                    const u8 coverage = page.pixels()[cast<usize>(y) * binding.width + x];
                    if(coverage == 0u)
                        continue;
                    const f64 column = cast<f64>(x);
                    const VectorDouble colPlusOne(column + 1.0);
                    const VectorDouble colVec(column);
                    const VectorDouble leftVec(left);
                    const VectorDouble rightVec(right);
                    const f64 visibleWidth = VectorDoubleSelect(colPlusOne, rightVec, VectorDoubleLess(rightVec, colPlusOne)).x - VectorDoubleSelect(colVec, leftVec, VectorDoubleGreater(leftVec, colVec)).x;
                    area += (cast<f64>(coverage) / 255.0) * visibleWidth * visibleHeight * texelArea;
                }
            }
        }
    }
    return area;
}

f32 SampleUiSdfChannel(in SdfAtlasPage page, in u32 channel, in i32 column, in i32 row){
    in SdfAtlasPageBinding binding = page.binding();
    const u32 x = cast<u32>(Clamp(column, 0, cast<i32>(binding.width) - 1));
    const u32 y = cast<u32>(Clamp(row, 0, cast<i32>(binding.height) - 1));
    return cast<f32>(page.pixels()[(cast<usize>(y) * binding.width + x) * binding.channelCount + channel]);
}

f32 SampleUiMeasuredSdfDistance(in SharedSdfAtlasPage handle, in u32 channel, in VectorSingle texel){
    in SdfAtlasPage page = handle.deref();
    const VectorSingle position = texel - VectorSingle(0.5f);
    const VectorSingle cell = VectorFloor(position);
    const i32 x = cast<i32>(cell.x);
    const i32 y = cast<i32>(cell.y);
    const VectorSingle fraction = position - VectorSingle(cast<f32>(x), cast<f32>(y), 0.0f, 0.0f);
    const VectorSingle remainder = VectorSingle(1.0f) - fraction;
    const VectorSingle samples = VectorSingle(SampleUiSdfChannel(page, channel, x, y), SampleUiSdfChannel(page, channel, x, y + 1),
        SampleUiSdfChannel(page, channel, x + 1, y), SampleUiSdfChannel(page, channel, x + 1, y + 1)) / VectorSingle(255.0f);
    const VectorSingle rows = samples * VectorSingle(remainder.x) + samples.zwzw * VectorSingle(fraction.x);
    const f32 encoded = rows.x * remainder.y + rows.y * fraction.y;
    return ((encoded * 255.0f - 128.0f) * cast<f32>(page.binding().spreadPixels)) / 128.0f;
}

void SortUiGlyphIds(mut Vector<u32> ids){
    for(usize i = 1u; i < ids.size(); ++i){
        const u32 id = ids[i];
        usize pos = i;
        while(pos > 0u && ids[pos - 1u] > id){
            ids[pos] = ids[pos - 1u];
            --pos;
        }
        ids[pos] = id;
    }
}

usize CountUiTextRegionGlyphIndices(in DrawSnapshot snapshot){
    usize count = 0u;
    const usize commandCount = snapshot.commands().size();
    for(usize cmdIndex = 0u; cmdIndex < commandCount; ++cmdIndex){
        const DrawCommand command = snapshot.commands()[cmdIndex];
        if(command.material == PaintMaterial::Glyph || command.material == PaintMaterial::SdfGlyph)
            count += command.indexCount;
    }
    return count;
}

void ExpectUiTextGlyphRegion(in DrawSnapshot snapshot, in Rect expected){
    const VectorSingle expectedEnd = VectorSingle(expected.x, expected.y, 0.0f, 0.0f) + VectorSingle(expected.width, expected.height, 0.0f, 0.0f);
    usize count = 0u;
    const usize commandCount = snapshot.commands().size();
    for(usize cmdIndex = 0u; cmdIndex < commandCount; ++cmdIndex){
        const DrawCommand command = snapshot.commands()[cmdIndex];
        if(command.material != PaintMaterial::Glyph && command.material != PaintMaterial::SdfGlyph)
            continue;
        ExpectUiRect(command.clip, expected);
        ASSERT_LE(cast<usize>(command.firstIndex) + command.indexCount, snapshot.indices().size());
        for(u32 index = command.firstIndex; index < command.firstIndex + command.indexCount; ++index){
            ASSERT_LT(snapshot.indices()[index], snapshot.vertices().size());
            const Point position = snapshot.vertices()[snapshot.indices()[index]].position;
            EXPECT_GE(position.x, expected.x);
            EXPECT_LE(position.x, expectedEnd.x);
            EXPECT_GE(position.y, expected.y);
            EXPECT_LE(position.y, expectedEnd.y);
        }
        count += command.indexCount;
    }
    EXPECT_GT(count, 0u);
}

Rect UiTextVisibleBakedRect(in PlacedGlyph glyph, in Point origin){
    const FontAtlasGlyph record = FontFaceBakedGlyph(glyph.face, glyph.glyphId);
    const f32 scale = 32.0f / cast<f32>(FontFaceBakedUnitsPerEm(glyph.face));
    const VectorSingle originPos = VectorSingle(origin.x, origin.y, 0.0f, 0.0f) + VectorSingle(glyph.position.x, glyph.position.y, 0.0f, 0.0f);
    const VectorSingle plane = originPos + VectorSingle(record.planeLeft, record.planeTop, record.planeRight - record.planeLeft, record.planeBottom - record.planeTop) * VectorSingle(scale);
    return Rect(plane.x, plane.y, plane.z, plane.w);
}

b8 PaintUiTextVisibleClipped(mut TextVisibleCoverageTests self, in TextLayout layout, in Rect clip, in Point origin){
    self.m_paint.pushClip(clip);
    const b8 painted = self.m_text.paint(self.m_paint, layout, origin, Color());
    const b8 popped = self.m_paint.popClip();
    return painted && popped;
}

Expected<Rect> ComputeUiTextVisibleRasterRect(mut TextVisibleCoverageTests self, in PlacedGlyph glyph, in f32 fontSize, in DisplayMetrics display, in Point origin){
    const VectorSingle scaleX(display.pixelScaleX);
    const VectorSingle scaleY(display.pixelScaleY);
    const f32 physicalSize = VectorCeiling(VectorSingle(fontSize * VectorSelect(scaleY, scaleX, VectorGreater(scaleX, scaleY)).x)).x;
    if(!FontFaceRasterize(glyph.face, glyph.glyphId, cast<u32>(physicalSize), self.m_bitmap))
        return MakeUnexpected(Failure());
    const f32 scale = physicalSize / fontSize;
    const f64 scaleDouble = cast<f64>(scale);
    const VectorDouble bearingOffset = VectorDouble(cast<f64>(self.m_bitmap.bearingX), -cast<f64>(self.m_bitmap.bearingY), 0.0, 0.0) / VectorDouble(scaleDouble);
    const VectorDouble unsnapped = (VectorDouble(cast<f64>(origin.x), cast<f64>(origin.y), 0.0, 0.0) + VectorDouble(cast<f64>(glyph.position.x), cast<f64>(glyph.position.y), 0.0, 0.0)) + bearingOffset;
    const VectorDouble pixelScale(cast<f64>(display.pixelScaleX), cast<f64>(display.pixelScaleY), 1.0, 1.0);
    const VectorDouble snapped = VectorDoubleFloor(unsnapped * pixelScale + VectorDouble(0.5)) / pixelScale;
    const f64 snappedX = snapped.x;
    const f64 snappedY = snapped.y;
    const Rect rectangle = Rect(cast<f32>(snappedX), cast<f32>(snappedY), cast<f32>(self.m_bitmap.width) / scale, cast<f32>(self.m_bitmap.height) / scale);
    if(!(rectangle.width > 0.0f && rectangle.height > 0.0f))
        return MakeUnexpected(Failure());
    return rectangle;
}

SelectablePaintFlags MakeUiSelectablePaintFlags(in b8 enabled, in b8 selected, in b8 hovered, in b8 focused){
    SelectablePaintFlags flags = SelectablePaintFlags();
    flags.enabled = enabled;
    flags.selected = selected;
    flags.hover = hovered;
    flags.focused = focused;
    return flags;
}

Rect UiTextVisibleBakedOutlineCenterClip(in PlacedGlyph glyph, in Point origin){
    const Rect outline = ComputePlacedGlyphOutlineRect(glyph, origin);
    return Rect(outline.x + (outline.width * 0.5f), outline.y + (outline.height * 0.5f), 1.0f, 1.0f);
}

Rect ComputeUiTextVisibleRasterFringe(in Rect raster, in Rect outline){
    const VectorSingle fringeCap(0.05f);
    if(raster.x + 0.001f < outline.x){
        const VectorSingle diff((outline.x - raster.x) * 0.5f);
        return Rect(raster.x, raster.y, VectorSelect(diff, fringeCap, VectorLess(fringeCap, diff)).x, raster.height);
    }
    if(raster.y + 0.001f < outline.y){
        const VectorSingle diff((outline.y - raster.y) * 0.5f);
        return Rect(raster.x, raster.y, raster.width, VectorSelect(diff, fringeCap, VectorLess(fringeCap, diff)).x);
    }
    const VectorSingle ends = VectorSingle(raster.x, raster.y, outline.x, outline.y) + VectorSingle(raster.width, raster.height, outline.width, outline.height);
    if(ends.x > ends.z + 0.001f){
        const VectorSingle diff((ends.x - ends.z) * 0.5f);
        const f32 fringe = VectorSelect(diff, fringeCap, VectorLess(fringeCap, diff)).x;
        return Rect(ends.x - fringe, raster.y, fringe, raster.height);
    }
    if(ends.y > ends.w + 0.001f){
        const VectorSingle diff((ends.y - ends.w) * 0.5f);
        const f32 fringe = VectorSelect(diff, fringeCap, VectorLess(fringeCap, diff)).x;
        return Rect(raster.x, ends.y - fringe, raster.width, fringe);
    }
    return Rect();
}

void VerifyUiTextRegionTests_StandaloneMultilineLabelClipsNestedBoundsAfterResizeAcrossDisplayScales(mut UiTextRegionTests self){
    Label label = Label();
    ASSERT_EQ(label.setText(MakeUiShapeRequest(s_UiTextRegionOverflowText, 16.0f)), TextLayoutStatus::Success);
    u64 generation = 1u;
    Array<f32, 3u> scales;
    scales[0u] = 1.0f;
    scales[1u] = 1.5f;
    scales[2u] = 2.0f;
    Array<Rect, 2u> boundsList;
    boundsList[0u] = Rect(20.0f, 20.0f, 80.0f, 34.0f);
    boundsList[1u] = Rect(20.0f, 20.0f, 41.0f, 19.0f);
    for(usize scaleIndex = 0u; scaleIndex < scales.size(); ++scaleIndex){
        const f32 scale = scales[scaleIndex];
        usize previousIndices = 0u;
        for(usize boundsIndex = 0u; boundsIndex < boundsList.size(); ++boundsIndex){
            const Rect bounds = boundsList[boundsIndex];
            self.m_paint.begin(DisplayMetrics(300.0f, 200.0f, scale, scale), generation, 1u, MakeUiFixtureAssetRef<UiSkin>(s_TestSkinPath), self.m_skin);
            ++generation;
            self.m_paint.pushClip(Rect(12.0f, 10.0f, 210.0f, 140.0f));
            const Rect inherited = Rect(25.0f, 24.0f, 110.0f, 70.0f);
            self.m_paint.pushClip(inherited);
            ASSERT_TRUE(label.paint(self.m_text, self.m_paint, bounds));
            EXPECT_GT(label.layout().measure().x, bounds.width);
            EXPECT_GT(label.layout().measure().y, bounds.height);
            ExpectUiRect(self.m_paint.currentClip(), inherited);
            ASSERT_TRUE(self.m_paint.popClip());
            ASSERT_TRUE(self.m_paint.popClip());
            EXPECT_FALSE(self.m_paint.popClip());
            const DrawSnapshot snapshot = self.m_paint.freeze();
            ExpectUiTextGlyphRegion(snapshot, Rect(25.0f, 24.0f, bounds.width - 5.0f, bounds.height - 4.0f));
            const usize indices = CountUiTextRegionGlyphIndices(snapshot);
            if(previousIndices != 0u)
                EXPECT_LT(indices, previousIndices);
            previousIndices = indices;
        }
    }
}

void VerifyUiTextRegionTests_EmptyAndFailedStandaloneLabelRegionsRestoreClipBeforePaintingASibling(mut UiTextRegionTests self){
    Label label = Label();
    ASSERT_EQ(label.setText(MakeUiDefaultShapeRequest(s_UiTextRegionOverflowText)), TextLayoutStatus::Success);
    const Rect inherited = Rect(10.0f, 10.0f, 180.0f, 120.0f);
    u64 generation = 1u;
    Array<Rect, 4u> emptyRegions;
    emptyRegions[0u] = Rect(20.0f, 20.0f, 0.0f, 40.0f);
    emptyRegions[1u] = Rect(20.0f, 20.0f, 40.0f, 0.0f);
    emptyRegions[2u] = Rect(20.0f, 20.0f, 0.0f, 0.0f);
    emptyRegions[3u] = Rect(220.0f, 20.0f, 40.0f, 40.0f);
    for(usize regionIndex = 0u; regionIndex < emptyRegions.size(); ++regionIndex){
        const Rect bounds = emptyRegions[regionIndex];
        self.m_paint.begin(DisplayMetrics(300.0f, 200.0f, 1.0f, 1.0f), generation, 1u, MakeUiFixtureAssetRef<UiSkin>(s_TestSkinPath), self.m_skin);
        ++generation;
        self.m_paint.pushClip(inherited);
        ASSERT_TRUE(label.paint(self.m_text, self.m_paint, bounds));
        ExpectUiRect(self.m_paint.currentClip(), inherited);
        ASSERT_TRUE(self.m_paint.popClip());
        EXPECT_FALSE(self.m_paint.popClip());
        const DrawSnapshot snapshot = self.m_paint.freeze();
        EXPECT_TRUE(snapshot.commands().empty());
        EXPECT_TRUE(snapshot.vertices().empty());
        EXPECT_TRUE(snapshot.indices().empty());
    }
    ASSERT_EQ(label.setText(MakeUiDefaultShapeRequest("MMMMMMMMMMMM")), TextLayoutStatus::Success);
    self.m_paint.begin(DisplayMetrics(300.0f, 200.0f, 1.0f, 1.0f), generation, 1u, MakeUiFixtureAssetRef<UiSkin>(s_TestSkinPath), self.m_skin);
    self.m_paint.pushClip(inherited);
    EXPECT_FALSE(label.paint(self.m_text, self.m_paint, Rect(20.0f, 20.0f, 30.0f, 20.0f), Color(1.0f, 1.0f, 1.0f, 2.0f)));
    ExpectUiRect(self.m_paint.currentClip(), inherited);
    const Rect sibling = Rect(110.0f, 70.0f, 60.0f, 22.0f);
    ASSERT_TRUE(label.paint(self.m_text, self.m_paint, sibling));
    ExpectUiRect(self.m_paint.currentClip(), inherited);
    ASSERT_TRUE(self.m_paint.popClip());
    EXPECT_FALSE(self.m_paint.popClip());
    const DrawSnapshot snapshot = self.m_paint.freeze();
    ExpectUiTextGlyphRegion(snapshot, sibling);
}

void VerifyUiTextRegionTests_OversizedButtonTextKeepsAsymmetricPaddingWithoutShrinkingItsSkinOrHitTarget(mut UiTextRegionTests self){
    u64 generation = 1u;
    Array<f32, 3u> scales;
    scales[0u] = 1.0f;
    scales[1u] = 1.5f;
    scales[2u] = 2.0f;
    for(usize scaleIndex = 0u; scaleIndex < scales.size(); ++scaleIndex){
        const f32 scale = scales[scaleIndex];
        ASSERT_TRUE(self.begin(generation, DisplayMetrics(800.0f, 600.0f, scale, scale)));
        ASSERT_TRUE(self.m_builder.beginPanel(s_UiTextRegionPanelKey, Rect(10.0f, 20.0f, 220.0f, 130.0f)));
        WidgetOptions options = WidgetOptions();
        options.width = LayoutSize(LayoutSizePolicy::Fixed, 80.0f);
        options.height = LayoutSize(LayoutSizePolicy::Fixed, 28.0f);
        EXPECT_FALSE(self.m_builder.button("button", s_UiTextRegionOverflowText, options));
        ASSERT_TRUE(self.finishPanel());
        EXPECT_FALSE(self.m_paint.popClip());
        const DrawSnapshot snapshot = self.m_paint.freeze();
        ASSERT_TRUE(self.m_context.commitFrame(generation));
        ++generation;
        const auto foundButton = self.tryTarget(self.id("button", s_UiTextRegionPanelKey));
        ASSERT_TRUE(foundButton.has_value());
        const HitTarget button = foundButton.value();
        ExpectUiRect(button.rectangle, Rect(13.0f, 24.0f, 80.0f, 28.0f));
        ExpectUiRect(button.clip, button.rectangle);
        const auto skin = self.sampleSkinPaint(snapshot, Name(s_UiTextRegionButtonNormalRegion));
        ASSERT_TRUE(skin.has_value());
        ExpectUiRect(skin.value().bounds, button.rectangle);
        ExpectUiTextGlyphRegion(snapshot, Rect(15.0f, 27.0f, 74.0f, 20.0f));
    }
}

void VerifyUiTextRegionTests_EmptyControlTextRegionsDoNotLeakIntoPaddingOrClipTheFollowingSibling(mut UiTextRegionTests self){
    self.m_builder.listStyle().row.padding = Insets(7.0f, 11.0f, 13.0f, 3.0f);
