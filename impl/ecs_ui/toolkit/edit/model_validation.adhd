#include <impl/ecs_ui/toolkit/edit/text_normalization.adhd>
#include <impl/ecs_ui/toolkit/edit/edit_history.adhd>
#include <impl/ecs_ui/toolkit/edit/edit_composition_rules.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CanEraseAroundEditSelection(
    in usize beforeBytes,
    in usize afterBytes,
    in usize start,
    in usize end,
    in usize textSize,
    in Span<usize> boundaries
){
    if(beforeBytes > start || afterBytes > textSize - end)
        return false;
    return IsEditBoundary(boundaries, start - beforeBytes) && IsEditBoundary(boundaries, end + afterBytes);
}



b8 CanReplaceEditRange(
    in usize begin,
    in usize end,
    in usize replacementSize,
    in usize textSize,
    in usize maxBytes,
    in Span<usize> boundaries
){
    if(begin > end || !IsEditBoundary(boundaries, begin) || !IsEditBoundary(boundaries, end) || replacementSize > maxBytes)
        return false;
    const usize retainedBytes = textSize - (end - begin);
    return retainedBytes <= maxBytes - replacementSize;
}

usize ResolveReplacedEditCaret(in Span<usize> boundaries, in usize begin, in usize replacementSize){
    usize caret = begin + replacementSize;
    for(usize index = 0u; index < boundaries.size(); ++index){
        if(boundaries[index] >= caret){
            caret = boundaries[index];
            break;
        }
    }
    return caret;
}





void CommitEditModelSetText(
    in StringView value,
    in Span<usize> newBoundaries,
    mut String inOutText,
    mut Vector<usize> inOutBoundaries,
    mut usize outAnchor,
    mut usize outCaret,
    mut u64 inOutSelectionGeneration,
    mut Vector<EditHistoryRecord> inOutHistory,
    mut usize outHistoryCursor,
    mut usize outHistoryBytes,
    mut String inOutPreedit,
    mut usize outPreeditAnchor,
    mut usize outPreeditCaret,
    mut usize outCompositionAnchor,
    mut usize outCompositionCaret,
    mut b8 inOutCompositionActive,
    mut u64 inOutCompositionGeneration,
    mut u64 inOutRevision,
    mut u64 inOutExternalRevision
){
    String candidate;
    if(!value.empty())
        candidate.assign(value);
    const b8 changed = StringView(candidate) != StringView(inOutText);
    inOutText.assign(candidate);
    inOutBoundaries.clear();
    for(usize i = 0u; i < newBoundaries.size(); ++i)
        inOutBoundaries.push_back(newBoundaries[i]);
    outAnchor = inOutText.size();
    outCaret = outAnchor;
    ++inOutSelectionGeneration;
    EditHistoryRules historyRules;
    historyRules.clear(inOutHistory, outHistoryCursor, outHistoryBytes);
    EditCompositionRules compositionRules;
    compositionRules.cancel(
        inOutPreedit,
        outPreeditAnchor,
        outPreeditCaret,
        outCompositionAnchor,
        outCompositionCaret,
        inOutCompositionActive,
        inOutCompositionGeneration
    );
    if(changed)
        ++inOutRevision;
    ++inOutExternalRevision;
}






b8 CommitEditModelEraseAroundSelection(
    in StringView candidate,
    in Span<usize> newBoundaries,
    in usize beforeBytes,
    in usize maxHistoryRecords,
    in usize maxHistoryBytes,
    mut String inOutText,
    mut Vector<usize> inOutBoundaries,
    mut usize inOutAnchor,
    mut usize inOutCaret,
    mut u64 inOutSelectionGeneration,
    mut Vector<EditHistoryRecord> inOutHistory,
    mut usize inOutHistoryCursor,
    mut usize inOutHistoryBytes,
    mut String inOutPreedit,
    mut usize outPreeditAnchor,
    mut usize outPreeditCaret,
    mut usize outCompositionAnchor,
    mut usize outCompositionCaret,
    mut b8 inOutCompositionActive,
    mut u64 inOutCompositionGeneration,
    mut u64 inOutRevision
){
    const usize anchor = inOutAnchor - beforeBytes;
    const usize caret = inOutCaret - beforeBytes;
    if(!IsEditBoundary(newBoundaries, anchor) || !IsEditBoundary(newBoundaries, caret))
        return false;
    EditHistoryRules historyRules;
    historyRules.record(
        StringView(inOutText),
        inOutAnchor,
        inOutCaret,
        candidate,
        anchor,
        caret,
        maxHistoryRecords,
        maxHistoryBytes,
        inOutHistory,
        inOutHistoryCursor,
        inOutHistoryBytes
    );
    inOutText.assign(candidate);
    inOutBoundaries.clear();
    for(usize i = 0u; i < newBoundaries.size(); ++i)
        inOutBoundaries.push_back(newBoundaries[i]);
    inOutAnchor = anchor;
    inOutCaret = caret;
    ++inOutSelectionGeneration;
    EditCompositionRules compositionRules;
    compositionRules.cancel(
        inOutPreedit,
        outPreeditAnchor,
        outPreeditCaret,
        outCompositionAnchor,
        outCompositionCaret,
        inOutCompositionActive,
        inOutCompositionGeneration
    );
    ++inOutRevision;
    return true;
}

void CommitEditModelReplaceRange(
    in StringView candidate,
    in Span<usize> newBoundaries,
    in usize begin,
    in usize replacementSize,
    in usize maxHistoryRecords,
    in usize maxHistoryBytes,
    mut String inOutText,
    mut Vector<usize> inOutBoundaries,
    mut usize inOutAnchor,
    mut usize inOutCaret,
    mut u64 inOutSelectionGeneration,
    mut Vector<EditHistoryRecord> inOutHistory,
    mut usize inOutHistoryCursor,
    mut usize inOutHistoryBytes,
    mut String inOutPreedit,
    mut usize outPreeditAnchor,
    mut usize outPreeditCaret,
    mut usize outCompositionAnchor,
    mut usize outCompositionCaret,
    mut b8 inOutCompositionActive,
    mut u64 inOutCompositionGeneration,
    mut u64 inOutRevision
){
    const usize caret = ResolveReplacedEditCaret(newBoundaries, begin, replacementSize);
    const b8 changed = candidate != StringView(inOutText);
    if(changed){
        EditHistoryRules historyRules;
        historyRules.record(
            StringView(inOutText),
            inOutAnchor,
            inOutCaret,
            candidate,
            caret,
            caret,
            maxHistoryRecords,
            maxHistoryBytes,
            inOutHistory,
            inOutHistoryCursor,
            inOutHistoryBytes
        );
    }
    inOutText.assign(candidate);
    inOutBoundaries.clear();
    for(usize i = 0u; i < newBoundaries.size(); ++i)
        inOutBoundaries.push_back(newBoundaries[i]);
    inOutAnchor = caret;
    inOutCaret = caret;
    ++inOutSelectionGeneration;
    EditCompositionRules compositionRules;
    compositionRules.cancel(
        inOutPreedit,
        outPreeditAnchor,
        outPreeditCaret,
        outCompositionAnchor,
        outCompositionCaret,
        inOutCompositionActive,
        inOutCompositionGeneration
    );
    if(changed)
        ++inOutRevision;
}



b8 TryBuildEditModelBoundaries(in StringView value, in EditTextMode textMode, mut Vector<usize> outBoundaries){
    if(textMode == EditTextMode::Multiline && !ValidateMultilineText(value))
        return false;
    return TryBuildGraphemeBoundariesInto(value, textMode == EditTextMode::SingleLine, outBoundaries);
}

b8 ApplyEditModelSetText(
    in StringView value,
    in usize maxBytes,
    in EditTextMode textMode,
    mut String inOutText,
    mut Vector<usize> inOutBoundaries,
    mut usize outAnchor,
    mut usize outCaret,
    mut u64 inOutSelectionGeneration,
    mut Vector<EditHistoryRecord> inOutHistory,
    mut usize outHistoryCursor,
    mut usize outHistoryBytes,
    mut String inOutPreedit,
    mut usize outPreeditAnchor,
    mut usize outPreeditCaret,
    mut usize outCompositionAnchor,
    mut usize outCompositionCaret,
    mut b8 inOutCompositionActive,
    mut u64 inOutCompositionGeneration,
    mut u64 inOutRevision,
    mut u64 inOutExternalRevision
){
    if(value.size() > maxBytes)
        return false;
    Vector<usize> boundaries;
    if(!TryBuildEditModelBoundaries(value, textMode, boundaries))
        return false;
    CommitEditModelSetText(
        value,
        boundaries,
        inOutText,
        inOutBoundaries,
        outAnchor,
        outCaret,
        inOutSelectionGeneration,
        inOutHistory,
        outHistoryCursor,
        outHistoryBytes,
        inOutPreedit,
        outPreeditAnchor,
        outPreeditCaret,
        outCompositionAnchor,
        outCompositionCaret,
        inOutCompositionActive,
        inOutCompositionGeneration,
        inOutRevision,
        inOutExternalRevision
    );
    return true;
}

b8 ApplyEditModelEraseAroundSelection(
    in usize beforeBytes,
    in usize afterBytes,
    in EditTextMode textMode,
    in usize maxHistoryRecords,
    in usize maxHistoryBytes,
    mut String inOutText,
    mut Vector<usize> inOutBoundaries,
    mut usize inOutAnchor,
    mut usize inOutCaret,
    mut u64 inOutSelectionGeneration,
    mut Vector<EditHistoryRecord> inOutHistory,
    mut usize inOutHistoryCursor,
    mut usize inOutHistoryBytes,
    mut String inOutPreedit,
    mut usize outPreeditAnchor,
    mut usize outPreeditCaret,
    mut usize outCompositionAnchor,
    mut usize outCompositionCaret,
    mut b8 inOutCompositionActive,
    mut u64 inOutCompositionGeneration,
    mut u64 inOutRevision
){
    const usize start = min(inOutAnchor, inOutCaret);
    const usize end = max(inOutAnchor, inOutCaret);
    if(beforeBytes == 0u && afterBytes == 0u)
        return beforeBytes <= start && afterBytes <= inOutText.size() - end;
    if(!CanEraseAroundEditSelection(beforeBytes, afterBytes, start, end, inOutText.size(), inOutBoundaries))
        return false;

    String candidate;
    BuildErasedAroundSelectionEditString(inOutText, beforeBytes, afterBytes, start, end, candidate);
    Vector<usize> boundaries;
    if(!TryBuildEditModelBoundaries(candidate, textMode, boundaries))
        return false;
    return CommitEditModelEraseAroundSelection(
        candidate,
        boundaries,
        beforeBytes,
        maxHistoryRecords,
        maxHistoryBytes,
        inOutText,
        inOutBoundaries,
        inOutAnchor,
        inOutCaret,
        inOutSelectionGeneration,
        inOutHistory,
        inOutHistoryCursor,
        inOutHistoryBytes,
        inOutPreedit,
        outPreeditAnchor,
        outPreeditCaret,
        outCompositionAnchor,
        outCompositionCaret,
        inOutCompositionActive,
        inOutCompositionGeneration,
        inOutRevision
    );
}

b8 ApplyEditModelReplaceRange(
    in usize begin,
    in usize end,
    in StringView replacement,
    in usize maxBytes,
    in EditTextMode textMode,
    in usize maxHistoryRecords,
    in usize maxHistoryBytes,
    mut String inOutText,
    mut Vector<usize> inOutBoundaries,
    mut usize inOutAnchor,
    mut usize inOutCaret,
    mut u64 inOutSelectionGeneration,
    mut Vector<EditHistoryRecord> inOutHistory,
    mut usize inOutHistoryCursor,
    mut usize inOutHistoryBytes,
    mut String inOutPreedit,
    mut usize outPreeditAnchor,
    mut usize outPreeditCaret,
    mut usize outCompositionAnchor,
    mut usize outCompositionCaret,
    mut b8 inOutCompositionActive,
    mut u64 inOutCompositionGeneration,
    mut u64 inOutRevision
){
    if(!CanReplaceEditRange(begin, end, replacement.size(), inOutText.size(), maxBytes, inOutBoundaries) || !ValidateEditTextForMode(replacement, textMode))
        return false;
    String candidate;
    BuildReplacedEditString(inOutText, begin, end, replacement, candidate);
    Vector<usize> boundaries;
    if(!TryBuildEditModelBoundaries(candidate, textMode, boundaries))
        return false;
    CommitEditModelReplaceRange(
        candidate,
        boundaries,
        begin,
        replacement.size(),
        maxHistoryRecords,
        maxHistoryBytes,
        inOutText,
        inOutBoundaries,
        inOutAnchor,
        inOutCaret,
        inOutSelectionGeneration,
        inOutHistory,
        inOutHistoryCursor,
        inOutHistoryBytes,
        inOutPreedit,
        outPreeditAnchor,
        outPreeditCaret,
        outCompositionAnchor,
        outCompositionCaret,
        inOutCompositionActive,
        inOutCompositionGeneration,
        inOutRevision
    );
    return true;
}






