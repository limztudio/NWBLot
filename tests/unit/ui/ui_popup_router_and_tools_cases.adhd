    ASSERT_TRUE(acceptTools(3u, true, false));
    EXPECT_FALSE(m_tooltip.visible());
    m_tooltipOptions.enabled = true;
    m_anchorOptions.enabled = false;
    ASSERT_TRUE(acceptTools(4u, true, false));
    EXPECT_FALSE(m_tooltip.visible());
    EXPECT_FALSE(m_context.input().hasPopup());
}

