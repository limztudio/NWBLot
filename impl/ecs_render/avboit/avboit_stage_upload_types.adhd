#include <impl/ecs_render/avboit/avboit_stage_raster_record_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/avboit/phase_identities.adhd>
#include <impl/ecs_render/deferred/import_types.adhd>
#include <impl/ecs_render/material/material_typed_private.adhd>

class FrameGraphAvboitStageInputs{
    public mut DeferredFrameTargets targets;
    public in DeferredGraphResourceImportResult resources;
    public in CsgFrameState csgFrameState;
    public in MeshFrameBindingSnapshot frameBindings;
    public in CsgGraphResourceSnapshot csgResources;
    public in MeshViewGpuData meshViewState;

    public GpuTaskId prefixTask;
    public b8 hasTransparentRenderers = false;
    public b8 clearTargets = false;
    public b8 refractionCaptureEnabled = false;
    public Optional<mut IGpuTaskGraphInstanceTransformPatchContributor> instanceTransformPatchContributor;

    public FrameGraphAvboitStageInputs(
        mut DeferredFrameTargets targets,
        in DeferredGraphResourceImportResult resources,
        in CsgFrameState csgFrameState,
        in MeshFrameBindingSnapshot frameBindings,
        in CsgGraphResourceSnapshot csgResources,
        in MeshViewGpuData meshViewState
    ){
        this.targets = targets;
        this.resources = resources;
        this.csgFrameState = csgFrameState;
        this.frameBindings = frameBindings;
        this.csgResources = csgResources;
        this.meshViewState = meshViewState;
    }
}

class FrameGraphAvboitPassUploadChain : NoCopy{
    private mut GpuTaskGraph m_graph;
    private mut RendererMaterialSystem m_materialSystem;
    private mut RendererCsgSystem m_csgSystem;

    public FrameGraphAvboitPassUploadChain(mut GpuTaskGraph graph, mut RendererMaterialSystem materials, mut RendererCsgSystem csg){
        this.m_graph = graph;
        this.m_materialSystem = materials;
        this.m_csgSystem = csg;
    }
    public Expected<FrameGraphAvboitMaterialUploadResult> declare(
        in FrameGraphAvboitStageInputs inputs,
        in FramebufferHandle framebuffer,
        in MaterialPipelinePass pass,
        in AvboitGeometryPhase phase,
        in GpuTaskId uploadTask,
        in b8 intervalOutputsGraphOwned,
        in b8 hasTransparentRenderers,
        mut AvboitRasterPassTaskPayload rasterPayload,
        mut AvboitComputeEmulationTaskPayload computeEmulationPayload,
        mut AvboitGeneratedGeometryReuse generatedGeometry,
        mut AvboitUploadedStreamState uploadedStreams
    );
}

class AvboitStageRecordDependencyPolicy{
    public b8 canDeclareRasterRecordPhase(in b8 predecessorTaskValid, in b8 uploadTaskValid)const{
        return predecessorTaskValid && uploadTaskValid;
    }
}


