////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_SHADOW_SW_SHADOW_EDGE_RECORD_SLANGI
#define NWB_GRAPHICS_SHADOW_SW_SHADOW_EDGE_RECORD_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#define NWB_SW_SHADOW_EDGE_PIXEL_BITS 16
#define NWB_SW_SHADOW_EDGE_PIXEL_MASK 0xFFFFu


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Stage-3 compacted-edge record packing: word0 packs 16-bit (x, y) pixel coordinates and word1 stores the light-loop index.


uint nwbSwShadowPackPixel(const uint2 pixel){
    return (pixel.x << NWB_SW_SHADOW_EDGE_PIXEL_BITS) | (pixel.y & NWB_SW_SHADOW_EDGE_PIXEL_MASK);
}

uint2 nwbSwShadowUnpackPixel(const uint word){
    return uint2(word >> NWB_SW_SHADOW_EDGE_PIXEL_BITS, word & NWB_SW_SHADOW_EDGE_PIXEL_MASK);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

