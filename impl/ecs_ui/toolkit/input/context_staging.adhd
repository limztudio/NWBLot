#include "context_popup_staging.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ContextScrollOwnerEntry{
    public WidgetId id;
    public u64 declarationGeneration = 0u;
    public PopupToken popup;
}

class ContextFocusGroupEntry{
    public u32 id = 0u;
    public b8 trapDirectional = false;
    public PopupToken popup;
}

b8 LessWindowPressSequence(in WindowPressRecord lhs, in WindowPressRecord rhs){
    return lhs.sequence < rhs.sequence;
}

b8 TryAppendContextTarget(
    in WidgetState state,
    in PopupToken currentPopup,
    in u32 popupLayer,
    in u32 windowZOrder,
    in WidgetId windowId,
    in u64 windowDeclarationGeneration,
    in WidgetId scrollOwnerId,
    in u64 scrollOwnerDeclarationGeneration,
    in HitTarget target,
    mut Vector<HitTarget> targets,
    mut Vector<WidgetRoot> targetRoots
){
    if(targets.size() >= s_InputMaxTargets)
        return false;
    HitTarget admitted = target;
    admitted.id = state.id;
    admitted.declarationGeneration = state.declarationGeneration;
    admitted.paintOrder = cast<u32>(targets.size());
    admitted.popup = currentPopup;
    admitted.layer = popupLayer;
    if(!currentPopup.valid()){
        admitted.zOrder = windowZOrder;
        admitted.windowId = windowId;
        admitted.windowDeclarationGeneration = windowDeclarationGeneration;
    }
    else{
        admitted.zOrder = 0u;
        admitted.windowId = WidgetId();
        admitted.windowDeclarationGeneration = 0u;
    }
    if(scrollOwnerId.valid() && scrollOwnerId != admitted.id && scrollOwnerId != admitted.owner){
        admitted.scrollOwner = scrollOwnerId;
        admitted.scrollOwnerDeclarationGeneration = scrollOwnerDeclarationGeneration;
    }
    else{
        admitted.scrollOwner = WidgetId();
        admitted.scrollOwnerDeclarationGeneration = 0u;
    }
    targets.push_back(admitted);
    targetRoots.push_back(state.root);
    return true;
}

b8 TryAppendContextPartTarget(
    in WidgetState owner,
    in WidgetId part,
    in PopupToken currentPopup,
    in u32 popupLayer,
    in u32 windowZOrder,
    in WidgetId windowId,
    in u64 windowDeclarationGeneration,
    in WidgetId scrollOwnerId,
    in u64 scrollOwnerDeclarationGeneration,
    in HitTarget target,
    mut Vector<HitTarget> targets,
    mut Vector<WidgetRoot> targetRoots
){
    if(!part.valid() || part == owner.id || targets.size() >= s_InputMaxTargets)
        return false;
    HitTarget admitted = target;
    admitted.id = part;
    admitted.declarationGeneration = owner.declarationGeneration;
    admitted.owner = owner.id;
    admitted.ownerDeclarationGeneration = owner.declarationGeneration;
    admitted.paintOrder = cast<u32>(targets.size());
    admitted.popup = currentPopup;
    admitted.layer = popupLayer;
    if(!currentPopup.valid()){
        admitted.zOrder = windowZOrder;
        admitted.windowId = windowId;
        admitted.windowDeclarationGeneration = windowDeclarationGeneration;
    }
    else{
        admitted.zOrder = 0u;
        admitted.windowId = WidgetId();
        admitted.windowDeclarationGeneration = 0u;
    }
    if(scrollOwnerId.valid() && scrollOwnerId != admitted.id && scrollOwnerId != admitted.owner){
        admitted.scrollOwner = scrollOwnerId;
        admitted.scrollOwnerDeclarationGeneration = scrollOwnerDeclarationGeneration;
    }
    else{
        admitted.scrollOwner = WidgetId();
        admitted.scrollOwnerDeclarationGeneration = 0u;
    }
    targets.push_back(admitted);
    targetRoots.push_back(owner.root);
    return true;
}

void ExtractContextCommitPopups(
    in Span<ContextOwnedPopup> popups,
    mut Vector<PopupScope> commitPopups
){
    commitPopups.clear();
    for(in ContextOwnedPopup owned : popups)
        commitPopups.push_back(owned.scope);
}

b8 TryBeginContextFrame(
    in u64 generation,
    in u64 focusLossGeneration,
    in u64 readyGeneration,
    mut u64 inOutLastFrameGeneration,
    mut u64 inOutFrameGeneration,
    mut u64 outFocusLossGeneration,
    mut b8 outFailed,
    mut usize outDeclarationCount,
    mut usize outStateClaimCount,
    mut Vector<HitTarget> targets,
    mut Vector<WidgetRoot> targetRoots,
    mut Vector<ContextOwnedPopup> popups,
    mut usize outPopupDepth,
    mut PopupToken outCurrentPopup,
    mut u32 outPopupLayer
){
    if(generation <= inOutLastFrameGeneration || inOutFrameGeneration != 0u || readyGeneration != 0u)
        return false;
    inOutLastFrameGeneration = generation;
    inOutFrameGeneration = generation;
    outFocusLossGeneration = focusLossGeneration;
    outFailed = false;
    outDeclarationCount = 0u;
    outStateClaimCount = 0u;
    targets.clear();
    targetRoots.clear();
    popups.clear();
    outPopupDepth = 0u;
    outCurrentPopup = PopupToken();
    outPopupLayer = 0u;
    return true;
}

[cpp_unwind]
b8 TryBeginContextRoot(
    in b8 failed,
    in u64 frameGeneration,
    in b8 rootActive,
    in WidgetRoot root,
    mut WidgetRoot outRoot,
    mut b8 outRootActive,
    mut Vector<WidgetId> scopes
){
    if(failed || frameGeneration == 0u || rootActive || root.generation == 0u)
        return false;
    const Expected<WidgetId> rootId = TryMakeRootId(root);
    if(!rootId.has_value())
        return false;
    scopes.reserve(1u);
    scopes.clear();
    scopes.push_back(rootId.value());
    outRoot = root;
    outRootActive = true;
    return true;
}

b8 TryEndContextRoot(
    in b8 failed,
    in usize popupDepth,
    in PopupToken currentPopup,
    mut b8 inOutRootActive,
    mut Vector<WidgetId> scopes
){
    const b8 valid = inOutRootActive && scopes.size() == 1u && popupDepth == 0u && !currentPopup.valid();
    inOutRootActive = false;
    scopes.clear();
    return valid && !failed;
}

b8 TryPushContextScope(
    in b8 failed,
    in b8 rootActive,
    in StringView stableKey,
    mut Vector<WidgetId> scopes
){
    if(failed || !rootActive || scopes.size() >= s_ContextMaxScopeDepth || scopes.size() == 0u)
        return false;
    const Expected<WidgetId> id = TryMakeWidgetId(scopes[scopes.size() - 1u], stableKey);
    if(!id.has_value())
        return false;
    scopes.push_back(id.value());
    return true;
}

b8 TryPopContextScope(
    in b8 failed,
    in b8 rootActive,
    mut Vector<WidgetId> scopes
){
    if(!rootActive || scopes.size() <= 1u)
        return false;
    scopes.pop_back();
    return !failed;
}

b8 CanFinishContextFrame(
    in b8 failed,
    in u64 frameGeneration,
    in b8 rootActive,
    in usize popupDepth,
    in PopupToken currentPopup
){
    return !failed && frameGeneration != 0u && !rootActive && popupDepth == 0u && !currentPopup.valid();
}

void ResetContextPopupAndTargetState(
    mut Vector<HitTarget> targets,
    mut Vector<WidgetRoot> targetRoots,
    mut Vector<ContextOwnedPopup> popups,
    mut PopupToken outCurrentPopup,
    mut usize outPopupDepth,
    mut Array<PopupToken, s_InputMaxPopups> outPopupStack,
    mut u32 outPopupLayer,
    mut u64 outReadyGeneration
){
    targets.clear();
    targetRoots.clear();
    popups.clear();
    outCurrentPopup = PopupToken();
    outPopupDepth = 0u;
    for(usize index = 0u; index < s_InputMaxPopups; ++index)
        outPopupStack[index] = PopupToken();
    outPopupLayer = 0u;
    outReadyGeneration = 0u;
}

b8 TryClaimSmallContextState(
    in ContextStateClaim claim,
    mut Array<ContextStateClaim, s_SmallStateClaims> inOutSmallStateClaims,
    mut usize inOutStateClaimCount
){
    for(usize index = 0u; index < inOutStateClaimCount; ++index){
        if(inOutSmallStateClaims[index] == claim)
            return false;
    }
    inOutSmallStateClaims[inOutStateClaimCount] = claim;
    ++inOutStateClaimCount;
    return true;
}

b8 TryClaimContextState(
    in WidgetKind kind,
    in u64 instanceGeneration,
    mut Array<ContextStateClaim, s_SmallStateClaims> inOutSmallStateClaims,
    mut HashSet<ContextStateClaim> inOutStateClaims,
    mut usize inOutStateClaimCount
){
    if(instanceGeneration == 0u || inOutStateClaimCount == s_InputMaxTargets)
        return false;
    ContextStateClaim claim;
    claim.instanceGeneration = instanceGeneration;
    claim.kind = kind;
    if(inOutStateClaimCount < s_SmallStateClaims)
        return TryClaimSmallContextState(claim, inOutSmallStateClaims, inOutStateClaimCount);
    if(inOutStateClaimCount == s_SmallStateClaims){
        inOutStateClaims.clear();
        if(inOutStateClaims.bucket_count() == 0u)
            inOutStateClaims.reserve(s_SmallStateClaims * 2u);
        for(usize index = 0u; index < s_SmallStateClaims; ++index)
            inOutStateClaims.insert(inOutSmallStateClaims[index]);
    }
    if(inOutStateClaims.contains(claim))
        return false;
    inOutStateClaims.insert(claim);
    ++inOutStateClaimCount;
    return true;
}

void PrepareRetainedContextRoots(
    in Span<WidgetRoot> roots,
    mut HashSet<WidgetRoot> inOutRetainedRoots,
    mut usize inOutRetainedRootCapacity
){
    inOutRetainedRoots.clear();
    if(roots.size() > inOutRetainedRootCapacity){
        inOutRetainedRoots.reserve(roots.size());
        inOutRetainedRootCapacity = roots.size();
    }
    for(in WidgetRoot root : roots)
        inOutRetainedRoots.insert(root);
}

void PruneUnretainedContextTargetsAndPopups(
    in HashSet<WidgetRoot> retainedRoots,
    mut Vector<HitTarget> inOutTargets,
    mut Vector<WidgetRoot> inOutTargetRoots,
    mut Vector<ContextOwnedPopup> inOutPopups
){
    usize keptTargets = 0u;
    for(usize index = 0u; index < inOutTargets.size(); ++index){
        if(retainedRoots.contains(inOutTargetRoots[index])){
            if(keptTargets != index){
                inOutTargets[keptTargets] = inOutTargets[index];
                inOutTargetRoots[keptTargets] = inOutTargetRoots[index];
            }
            ++keptTargets;
        }
    }
    inOutTargets.resize(keptTargets);
    inOutTargetRoots.resize(keptTargets);
    usize keptPopups = 0u;
    for(usize index = 0u; index < inOutPopups.size(); ++index){
        if(retainedRoots.contains(inOutPopups[index].root)){
            if(keptPopups != index)
                inOutPopups[keptPopups] = inOutPopups[index];
            ++keptPopups;
        }
    }
    inOutPopups.resize(keptPopups);
}


