////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_SkinPath = "tests/performance/ui_input/skin";
const StringView s_TexturePath = "tests/performance/ui_input/texture";
const usize s_BenchmarkSamples = 11u;
const usize s_BenchmarkMaxIterations = 16777216u;
const f64 s_BenchmarkMinSampleNS = 20000000.0;
const usize s_BenchmarkWarmupIterations = 32u;
const u64 s_UiChecksumSeed = 1469598103934665603u;
const u64 s_PointerChecksumSeed = 0xcbf29ce484222325ull;
const u64 s_FirstPointerDevice = 97u;

enum<u8> PointerWorkloadKind{
    CursorHover = 0u,
    TouchGesture = 1u,
    CursorGesture = 2u,
    PressedSweep = 3u,
    CompetingContacts = 4u,
    CommitTargets = 5u
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


interface IUiBenchmarkCase{
    b8 operation();
    Expected<u64> checksum()const;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u64 MixChecksum(in u64 hash, in u64 value){
    return (hash ^ value) * 1099511628211u;
}

u64 BoolToU64(in b8 value){
    if(value)
        return 1u;
    return 0u;
}

EditLimits MakeBenchmarkEditLimits(in usize maxBytes){
    EditLimits limits = EditLimits();
    limits.maxBytes = maxBytes;
    limits.maxHistoryRecords = 0u;
    limits.maxHistoryBytes = 0u;
    return limits;
}

WidgetId MakeWidgetId(in u64 idValue){
    WidgetId id = WidgetId();
    id.value = idValue;
    return id;
}

InputSource MakeInputSource(in u64 deviceId, in u64 sourceId){
    InputSource source = InputSource();
    source.device = deviceId;
    source.control = sourceId;
    return source;
}

DisplayMetrics MakeDisplayMetrics(in f32 width, in f32 height){
    DisplayMetrics metrics = DisplayMetrics();
    metrics.logicalWidth = width;
    metrics.logicalHeight = height;
    return metrics;
}

void ConfigureBenchmarkSkinAtlas(mut GlobalArena arena, mut UiSkin skin){
    ConfigureEmptySkinAtlas(arena, skin, Name(s_TexturePath));
}

StringView ResolvePointerWorkloadName(in PointerWorkloadKind kind){
    switch(kind){
    case PointerWorkloadKind::CursorHover: return "cursor_hover";
    case PointerWorkloadKind::TouchGesture: return "touch_gesture";
    case PointerWorkloadKind::CursorGesture: return "cursor_gesture";
    case PointerWorkloadKind::PressedSweep: return "pressed_sweep";
    case PointerWorkloadKind::CompetingContacts: return "competing_contacts";
    case PointerWorkloadKind::CommitTargets: return "commit_targets";
    }
    return "";
}

void SortBenchmarkSamples(mut Array<f64, s_BenchmarkSamples> values){
    for(usize index = 1u; index < s_BenchmarkSamples; ++index){
        const f64 current = values[index];
        usize cursor = index;
        while(cursor > 0u && values[cursor - 1u] > current){
            values[cursor] = values[cursor - 1u];
            --cursor;
        }
        values[cursor] = current;
    }
}

Expected<f64> MeasureBatch<CaseT : IUiBenchmarkCase>(mut CaseT benchmark, in usize iterations, in u64 expectedChecksum){
    const Timer begin = TimerNow();
    for(usize iteration = 0u; iteration < iterations; ++iteration){
        if(!benchmark.operation())
            return MakeUnexpected(Failure());
    }
    const f64 elapsed = DurationInNS<f64>(TimerNow(), begin);
    const Expected<u64> batchChecksum = benchmark.checksum();
    if(!batchChecksum.has_value() || batchChecksum.value() != expectedChecksum)
        return MakeUnexpected(Failure());
    return elapsed;
}

b8 Measure<CaseT : IUiBenchmarkCase>(in StringView name, in u64 setupChecksum, mut CaseT benchmark){
    for(usize warmup = 0u; warmup < s_BenchmarkWarmupIterations; ++warmup){
        if(!benchmark.operation())
            return false;
    }
    const Expected<u64> behaviorChecksum = benchmark.checksum();
    if(!behaviorChecksum.has_value())
        return false;
    const u64 expectedChecksum = behaviorChecksum.value();

    usize iterations = 1u;
    while(true){
        const Expected<f64> elapsed = MeasureBatch(benchmark, iterations, expectedChecksum);
        if(!elapsed.has_value())
            return false;
        if(elapsed.value() >= s_BenchmarkMinSampleNS)
            break;
        if(iterations == s_BenchmarkMaxIterations)
            return false;
        iterations *= 2u;
    }

    Array<f64, s_BenchmarkSamples> samples;
    for(usize sampleIndex = 0u; sampleIndex < s_BenchmarkSamples; ++sampleIndex){
        const Expected<f64> elapsed = MeasureBatch(benchmark, iterations, expectedChecksum);
        if(!elapsed.has_value())
            return false;
        samples[sampleIndex] = elapsed.value() / cast<f64>(iterations);
    }

    Array<f64, s_BenchmarkSamples> sorted = samples;
    SortBenchmarkSamples(sorted);
    const f64 medianSample = sorted[s_BenchmarkSamples / 2u];
    String output = StringFormat(
        "{{\"type\":\"ui_input_benchmark\",\"name\":\"{}\",\"iterationsPerSample\":{},\"setupChecksum\":{},\"behaviorChecksum\":{},\"medianNsPerOperation\":{:.17g},\"samplesNsPerOperation\":[",
        name,
        iterations,
        setupChecksum,
        expectedChecksum,
        medianSample
    );
    for(usize index = 0u; index < samples.size(); ++index){
        if(index != 0u)
            output.push_back(',');
        StringAppendFormat(output, "{:.17g}", samples[index]);
    }
    output.append("]}\n");
    WriteUiBenchmarkStdout(output);
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class BenchmarkShaper : ITextShaper{
    private mut GlobalArena m_arena;

    public BenchmarkShaper(mut GlobalArena arena){
        this.m_arena = arena;
    }

    public Expected<ShapedRun, TextLayoutStatusEnum> shape(in ShapeRequest request)override{
        ShapedRun run = ShapedRun(this.m_arena);
        run.metrics.ascender = 8.0f;
        run.metrics.descender = 2.0f;
        run.metrics.lineGap = 2.0f;
        run.glyphs.reserve(request.text.size());
        for(usize byte = 0u; byte < request.text.size(); ++byte)
            run.glyphs.push_back(ShapedGlyph(SharedFontFace(), 1u, cast<u32>(byte), cast<u32>(byte + 1u), Point(), Point(10.0f, 0.0f), Rect()));
        return run;
    }
}

class PublicationCase : IUiBenchmarkCase{
    private mut GlobalArena m_arena;
    private mut Context m_context;
    private UiEditBoxHost m_host;
    private EditModel m_model;
    private TextLayoutBuilder m_layoutBuilder;
    private EditBoxView m_view;
    private EditBoxPlacement m_placement = EditBoxPlacement();
    private WidgetState m_widget = WidgetState();
    private usize m_stops;
    private u64 m_generation = 0u;

    public PublicationCase(
        mut GlobalArena arena,
        mut Context context,
        mut BenchmarkTextInput textInput,
        mut BenchmarkClipboard clipboard,
        mut BenchmarkShaper shaper,
        in usize stops
    ){
        this.m_arena = arena;
        this.m_context = context;
        this.m_host = UiEditBoxHost(arena, context, textInput, clipboard);
        this.m_model = EditModel(arena, MakeBenchmarkEditLimits(stops));
        this.m_layoutBuilder = TextLayoutBuilder(arena, shaper);
        this.m_view = EditBoxView(arena);
        this.m_stops = stops;
    }

    public b8 setup(){
        String text = "";
        text.reserve(this.m_stops - 1u);
        for(usize index = 0u; index + 1u < this.m_stops; ++index)
            text.push_back('a');
        if(!this.m_model.setText(text) || !this.m_model.setSelection(0u, 0u) || !this.m_view.snapshot(this.m_model))
            return false;
        ShapeRequest request = ShapeRequest();
        request.text = this.m_view.displayText();
        if(!AdoptBuiltTextLayout(this.m_layoutBuilder, request, this.m_view))
            return false;
        const Expected<EditBoxPlacement> placement = this.m_view.arrange(Rect(10.0f, 20.0f, 320.0f, 30.0f), Insets(), Rect(0.0f, 0.0f, 500.0f, 200.0f), Point(), 1.0f, false);
        if(!placement.has_value() || this.m_view.caretStops().size() != this.m_stops)
            return false;
        this.m_placement = placement.value();
        return true;
    }

    public b8 operation()override{
        ++this.m_generation;
        if(!this.m_context.beginFrame(this.m_generation))
            return false;
        this.m_host.beginFrame(this.m_generation, MakeDisplayMetrics(500.0f, 200.0f));

        WidgetRoot root = WidgetRoot();
        root.value = 17u;
        root.generation = 1u;
        if(!this.m_context.beginRoot(root) || !TryDeclareEditBoxWidget(this.m_context, "edit", this.m_widget))
            return false;

        EditBoxOptions options = EditBoxOptions();
        options.readOnly = true;
        if(!this.m_host.edit(this.m_widget, options, this.m_model).valid || !this.m_host.publish(this.m_widget, this.m_view, this.m_placement, options))
            return false;

        HitTarget target = HitTarget();
        target.rectangle = this.m_placement.bounds;
        target.clip = this.m_placement.frameClip;
        target.focusable = true;
        target.textEditable = true;
        if(!this.m_context.addTarget(this.m_widget, target) || !this.m_context.endRoot() || !this.m_context.finishFrame())
            return false;
        this.m_host.finishFrame();
        if(!this.m_context.commitFrame(this.m_generation))
            return false;
        this.m_host.commitFrame(this.m_generation);
        return true;
    }

    public Expected<u64> checksum()const override{
        const b8 targetValid = HasCommittedTargetWithWidth(this.m_context, this.m_widget.id, this.m_widget.declarationGeneration, 320.0f);
        if(this.m_context.input().layoutGeneration() != this.m_generation || !targetValid || this.m_host.hasTextFocus() || !this.m_view.ready())
            return MakeUnexpected(Failure());

        u64 hash = MixChecksum(s_UiChecksumSeed, cast<u64>(this.m_view.committedBytes()));
        const usize stopCount = this.m_view.caretStops().size();
        for(usize index = 0u; index < stopCount; ++index){
            const EditBoxCaretStop stop = this.m_view.caretStops()[index];
            hash = MixChecksum(hash, cast<u64>(stop.committedByte));
            hash = MixChecksum(hash, cast<u64>(stop.x));
        }
        return hash;
    }
}

class EmptySelectionCase : IUiBenchmarkCase{
    private mut GlobalArena m_arena;
    private UiSkin m_skin;
    private EditModel m_model;
    private TextLayoutBuilder m_layoutBuilder;
    private EditBoxView m_view;
    private EditBoxPlacement m_placement = EditBoxPlacement();
    private TextService m_text;
    private PaintBuilder m_paint;
    private DrawSnapshot m_snapshot;
    private usize m_lines;

    public EmptySelectionCase(mut GlobalArena arena, mut BenchmarkShaper shaper, in usize lines){
        this.m_arena = arena;
        this.m_skin = UiSkin(arena, Name(s_SkinPath));
        this.m_model = EditModel(arena, MakeBenchmarkEditLimits(lines), EditTextMode::Multiline);
        this.m_layoutBuilder = TextLayoutBuilder(arena, shaper);
        this.m_view = EditBoxView(arena);
        this.m_text = TextService(arena);
        this.m_paint = PaintBuilder(arena);
        this.m_snapshot = DrawSnapshot(arena);
        this.m_lines = lines;
    }

    public b8 setup(){
        ConfigureBenchmarkSkinAtlas(this.m_arena, this.m_skin);
        String text = "";
        text.reserve(this.m_lines - 1u);
        for(usize index = 0u; index + 1u < this.m_lines; ++index)
            text.push_back('\n');
        if(!this.m_model.setText(text) || !this.m_model.setSelection(0u, 0u) || !this.m_view.snapshot(this.m_model))
            return false;
        ShapeRequest request = ShapeRequest();
        request.text = this.m_view.displayText();
        if(!AdoptBuiltTextLayout(this.m_layoutBuilder, request, this.m_view))
            return false;
        const Expected<EditBoxPlacement> placement = this.m_view.arrange(Rect(10.0f, 10.0f, 300.0f, 100.0f), Insets(), Rect(0.0f, 0.0f, 500.0f, 200.0f), Point(), 1.0f, false);
        if(!placement.has_value() || this.m_view.layout().lines().size() != this.m_lines || !this.m_view.layout().glyphs().empty())
            return false;
        this.m_placement = placement.value();
        return true;
    }

    public b8 operation()override{
        this.m_paint.begin(MakeDisplayMetrics(500.0f, 200.0f), 1u, 1u, AssetRef<UiSkin>(s_SkinPath), this.m_skin);
        if(!this.m_view.paint(this.m_text, this.m_paint, this.m_skin, this.m_placement))
            return false;
        this.m_snapshot = this.m_paint.freeze();
        return this.m_snapshot.commands().size() == 1u && this.m_snapshot.indices().size() == 6u;
    }

    public Expected<u64> checksum()const override{
        if(this.m_view.selectionRange().begin != this.m_view.selectionRange().end || this.m_snapshot.vertices().size() != 4u || this.m_snapshot.commands().size() != 1u)
            return MakeUnexpected(Failure());
        u64 hash = MixChecksum(s_UiChecksumSeed, cast<u64>(this.m_lines));
        const usize vertexCount = this.m_snapshot.vertices().size();
        for(usize index = 0u; index < vertexCount; ++index){
            const Vertex vertex = this.m_snapshot.vertices()[index];
            hash = MixChecksum(hash, cast<u64>(vertex.position.x));
            hash = MixChecksum(hash, cast<u64>(vertex.position.y));
        }
        return hash;
    }
}

class PaintCase : IUiBenchmarkCase{
    private UiSkin m_skin;
    private PaintBuilder m_builder;
    private DrawSnapshot m_snapshot;
    private u32 m_commands;
    private b8 m_descending;

    public PaintCase(mut GlobalArena arena, in u32 commands, in b8 descending){
        this.m_skin = UiSkin(arena, Name(s_SkinPath));
        this.m_builder = PaintBuilder(arena);
        this.m_snapshot = DrawSnapshot(arena);
        this.m_commands = commands;
        this.m_descending = descending;
        ConfigureBenchmarkSkinAtlas(arena, this.m_skin);
    }

    public b8 operation()override{
        this.m_builder.begin(MakeDisplayMetrics(128.0f, 128.0f), 1u, 1u, AssetRef<UiSkin>(s_SkinPath), this.m_skin);
        this.m_builder.reserve(this.m_commands);
        for(u32 command = 0u; command < this.m_commands; ++command){
            if(this.m_descending && !this.m_builder.beginOverlay(this.m_commands - command))
                return false;
            this.m_builder.pushClip(Rect(cast<f32>(command & 1u), 0.0f, 64.0f, 64.0f));
            this.m_builder.fillRect(Rect(0.0f, 0.0f, 100.0f, 100.0f));
            if(!this.m_builder.popClip() || (this.m_descending && !this.m_builder.endOverlay()))
                return false;
        }
        this.m_snapshot = this.m_builder.freeze();
        const usize expectedCommands = cast<usize>(this.m_commands);
        return this.m_snapshot.commands().size() == expectedCommands
            && this.m_snapshot.indices().size() == expectedCommands * 6u
            && this.m_snapshot.vertices().size() == expectedCommands * 4u;
    }

    public Expected<u64> checksum()const override{
        const usize expectedCommands = cast<usize>(this.m_commands);
        if(this.m_snapshot.commands().size() != expectedCommands || this.m_snapshot.indices().size() != expectedCommands * 6u || this.m_snapshot.vertices().size() != expectedCommands * 4u)
            return MakeUnexpected(Failure());

        u64 hash = MixChecksum(s_UiChecksumSeed, cast<u64>(this.m_commands));
        for(u32 index = 0u; index < this.m_commands; ++index){
            const DrawCommand command = this.m_snapshot.commands()[cast<usize>(index)];
            u32 expectedLayer = 0u;
            u32 expectedFirst = index * 6u;
            if(this.m_descending){
                expectedLayer = index + 1u;
                expectedFirst = (this.m_commands - index - 1u) * 6u;
            }
            if(command.layer != expectedLayer || command.firstIndex != expectedFirst || command.indexCount != 6u || command.material != PaintMaterial::Solid)
                return MakeUnexpected(Failure());
            hash = MixChecksum(hash, cast<u64>(command.layer));
            hash = MixChecksum(hash, cast<u64>(command.firstIndex));
            hash = MixChecksum(hash, cast<u64>(command.indexCount));
            hash = MixChecksum(hash, cast<u64>(command.clip.x));
        }
        const usize vertexCount = this.m_snapshot.vertices().size();
        for(usize index = 0u; index < vertexCount; ++index){
            const Vertex vertex = this.m_snapshot.vertices()[index];
            hash = MixChecksum(hash, cast<u64>(vertex.position.x));
            hash = MixChecksum(hash, cast<u64>(vertex.position.y));
        }
        const usize indexCount = this.m_snapshot.indices().size();
        for(usize index = 0u; index < indexCount; ++index)
            hash = MixChecksum(hash, cast<u64>(this.m_snapshot.indices()[index]));
        return hash;
    }
}

class PointerWorkload : IUiBenchmarkCase{
    private InputRouter m_router;
    private HitTargetVector m_targets;
    private usize m_contactCount;
    private u64 m_setupChecksum;
    private u64 m_generation = 0u;
    private usize m_pressedCount = 0u;
    private PointerWorkloadKind m_kind;
    private b8 m_hoverCapable;

    public PointerWorkload(mut GlobalArena arena, in usize targetCount, in PointerWorkloadKind kind, in usize contactCount){
        this.m_router = InputRouter(arena);
        this.m_targets = HitTargetVector(arena);
        this.m_contactCount = contactCount;
        this.m_kind = kind;
        this.m_hoverCapable = kind == PointerWorkloadKind::CursorHover || kind == PointerWorkloadKind::CursorGesture || kind == PointerWorkloadKind::PressedSweep;

        this.m_targets.reserve(targetCount);
        u64 setupChecksum = MixChecksum(s_PointerChecksumSeed, cast<u64>(targetCount));
        setupChecksum = MixChecksum(setupChecksum, cast<u64>(kind));
        setupChecksum = MixChecksum(setupChecksum, cast<u64>(contactCount));
        for(usize index = 0u; index < targetCount; ++index){
            HitTarget target = HitTarget();
            target.id = MakeWidgetId(cast<u64>(index + 1u));
            target.declarationGeneration = 1u;
            target.rectangle = Rect(cast<f32>((index % 64u) * 24u), cast<f32>((index / 64u) * 24u), 20.0f, 20.0f);
            target.clip = Rect(0.0f, 0.0f, 1536.0f, 1536.0f);
            target.paintOrder = cast<u32>(index);
            target.focusable = true;
            target.activatable = true;
            target.pointerGesture = true;
            this.m_targets.push_back(target);
            setupChecksum = MixChecksum(setupChecksum, target.id.value);
            setupChecksum = MixChecksum(setupChecksum, cast<u64>(target.rectangle.x));
            setupChecksum = MixChecksum(setupChecksum, cast<u64>(target.rectangle.y));
            setupChecksum = MixChecksum(setupChecksum, cast<u64>(target.paintOrder));
        }
        this.m_setupChecksum = setupChecksum;
    }

    public u64 setupChecksum()const{
        return this.m_setupChecksum;
    }

    public usize targetCount()const{
        return this.m_targets.size();
    }

    public usize contactCount()const{
        return this.m_contactCount;
    }

    public PointerWorkloadKind kind()const{
        return this.m_kind;
    }

    public b8 initialize(){
        ++this.m_generation;
        if(!this.m_router.commitTargets(this.m_targets, this.m_generation))
            return false;
        if(this.m_kind == PointerWorkloadKind::CursorHover || this.m_kind == PointerWorkloadKind::CommitTargets)
            return true;

        const Point firstPosition = Point(8.0f, 8.0f);
        const Point lastPosition = Point(9.0f, 8.0f);
        const WidgetId firstWidget = MakeWidgetId(1u);
        for(usize contact = 1u; contact <= this.m_contactCount; ++contact){
            PointerInput input = PointerInput();
            input.phase = PointerPhase::Press;
            input.source = MakeInputSource(s_FirstPointerDevice, cast<u64>(contact));
            input.position = firstPosition;
            input.hoverCapable = this.m_hoverCapable;
            if(!this.m_router.queuePointer(input))
                return false;
            const InputRoutingResult result = this.m_router.process();
            if(!result.pointerConsumed || result.pointerRouted != (contact == 1u) || result.capture != firstWidget)
                return false;
        }
        const InputSource firstSource = MakeInputSource(s_FirstPointerDevice, 1u);
        const Expected<PointerGesture> gesture = this.m_router.consumePointerGesture(firstWidget, 1u);
        return gesture.has_value() && gesture.value().inputSource == firstSource && this.movePointer(lastPosition);
    }

    public b8 operation()override{
        if(this.m_kind == PointerWorkloadKind::CommitTargets){
            ++this.m_generation;
            return this.m_router.commitTargets(this.m_targets, this.m_generation);
        }
        if(this.m_kind == PointerWorkloadKind::PressedSweep){
            usize pressed = 0u;
            const usize count = this.m_targets.size();
            for(usize index = 0u; index < count; ++index){
                if(this.m_router.pressed(this.m_targets[index].id))
                    ++pressed;
            }
            this.m_pressedCount = pressed;
            return pressed == 1u;
        }
        if(!this.movePointer(Point(8.0f, 8.0f)) || !this.movePointer(Point(9.0f, 8.0f)))
            return false;
        if(this.m_kind == PointerWorkloadKind::CompetingContacts){
            PointerInput input = PointerInput();
            input.source = MakeInputSource(s_FirstPointerDevice, cast<u64>(this.m_contactCount));
            input.position = Point(32.0f, 8.0f);
            if(!this.m_router.queuePointer(input))
                return false;
            const InputRoutingResult result = this.m_router.process();
            if(!result.pointerConsumed || result.pointerRouted || result.capture != MakeWidgetId(1u) || result.hover.valid())
                return false;
        }
        return true;
    }

    public Expected<u64> checksum()const override{
        u64 hash = MixChecksum(this.m_setupChecksum, cast<u64>(this.m_router.targets().size()));
        hash = MixChecksum(hash, this.m_router.hover().value);
        hash = MixChecksum(hash, this.m_router.focus().value);
        hash = MixChecksum(hash, this.m_router.capture().value);
        hash = MixChecksum(hash, BoolToU64(this.m_router.primaryDown()));
        hash = MixChecksum(hash, cast<u64>(this.m_router.actions().size()));
        hash = MixChecksum(hash, cast<u64>(this.m_pressedCount));
        if(this.m_kind != PointerWorkloadKind::CommitTargets && this.m_kind != PointerWorkloadKind::CursorHover){
            for(usize contact = 1u; contact <= this.m_contactCount; ++contact){
                const InputSource source = MakeInputSource(s_FirstPointerDevice, cast<u64>(contact));
                hash = MixChecksum(hash, BoolToU64(this.m_router.ownsPointerSource(source)));
            }
        }
        return hash;
    }

    private b8 movePointer(in Point position){
        const InputSource firstSource = MakeInputSource(s_FirstPointerDevice, 1u);
        PointerInput input = PointerInput();
        input.source = firstSource;
        input.position = position;
        input.hoverCapable = this.m_hoverCapable;
        if(!this.m_router.queuePointer(input))
            return false;
        const InputRoutingResult result = this.m_router.process();
        const b8 active = this.m_kind != PointerWorkloadKind::CursorHover;
        WidgetId expectedCapture = WidgetId();
        if(active)
            expectedCapture = MakeWidgetId(1u);
        WidgetId expectedHover = WidgetId();
        if(this.m_hoverCapable)
            expectedHover = MakeWidgetId(1u);
        if(!result.pointerConsumed || !result.pointerRouted || result.capture != expectedCapture || result.hover != expectedHover)
            return false;
        if(active){
            const WidgetId firstWidget = MakeWidgetId(1u);
            const Expected<PointerGesture> gesture = this.m_router.consumePointerGesture(firstWidget, 1u);
            if(
                !gesture.has_value()
                || gesture.value().state != PointerGestureState::Active
                || gesture.value().inputSource != firstSource
                || gesture.value().position.x != position.x
                || gesture.value().position.y != position.y
            )
                return false;
        }
        return !result.activationOverflow && !result.gestureOverflow;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 MeasurePointerWorkload(mut PointerWorkload workload){
    if(!workload.initialize())
        return false;
    const String name = StringFormat(
        "{}_targets_{}_sources_{}",
        ResolvePointerWorkloadName(workload.kind()),
        workload.targetCount(),
        workload.contactCount()
    );
    return Measure(name, workload.setupChecksum(), workload);
}

b8 RunPointerCase(in usize targetCount, in PointerWorkloadKind kind, in usize contactCount){
    GlobalArena arena = GlobalArena(s_UiBenchmarkNameTestsPerformanceUiInputPointer);
    PointerWorkload workload = PointerWorkload(arena, targetCount, kind, contactCount);
    return MeasurePointerWorkload(workload);
}

b8 RunPointerBenchmarks(){
    Array<usize, 3> counts;
    counts[0] = 128u;
    counts[1] = 1024u;
    counts[2] = 4096u;
    Array<PointerWorkloadKind, 4> kinds;
    kinds[0] = PointerWorkloadKind::CursorHover;
    kinds[1] = PointerWorkloadKind::TouchGesture;
    kinds[2] = PointerWorkloadKind::CursorGesture;
    kinds[3] = PointerWorkloadKind::PressedSweep;
    for(usize countIndex = 0u; countIndex < counts.size(); ++countIndex){
        for(usize kindIndex = 0u; kindIndex < kinds.size(); ++kindIndex){
            if(!RunPointerCase(counts[countIndex], kinds[kindIndex], 1u))
                return false;
        }
    }

    Array<usize, 2> contactCounts;
    contactCounts[0] = 16u;
    contactCounts[1] = 256u;
    for(usize index = 0u; index < contactCounts.size(); ++index){
        if(!RunPointerCase(1024u, PointerWorkloadKind::CompetingContacts, contactCounts[index]))
            return false;
    }

    return RunPointerCase(1024u, PointerWorkloadKind::CommitTargets, 1u);
}

StringView ResolvePaintBenchmarkName(in usize index, in b8 descending){
    if(descending){
        switch(index){
        case 0u: return "paint.descending.64";
        case 1u: return "paint.descending.256";
        default: return "paint.descending.1024";
        }
    }
    switch(index){
    case 0u: return "paint.monotonic.64";
    case 1u: return "paint.monotonic.256";
    default: return "paint.monotonic.1024";
    }
}

b8 RunPaintCase(in u32 commandCount, in b8 descending, in StringView benchmarkName){
    GlobalArena arena = GlobalArena(s_UiBenchmarkNameTestsPerformanceUiInputPaint);
    PaintCase benchmark = PaintCase(arena, commandCount, descending);
    if(!benchmark.operation() || !benchmark.checksum().has_value())
        return false;
    const u64 setup = MixChecksum(MixChecksum(s_UiChecksumSeed, cast<u64>(commandCount)), BoolToU64(descending));
    return Measure(benchmarkName, setup, benchmark);
}

b8 RunPaintBenchmarks(){
    Array<u32, 3> counts;
    counts[0] = 64u;
    counts[1] = 256u;
    counts[2] = 1024u;
    for(usize index = 0u; index < counts.size(); ++index){
        if(!RunPaintCase(counts[index], false, ResolvePaintBenchmarkName(index, false)))
            return false;
        if(!RunPaintCase(counts[index], true, ResolvePaintBenchmarkName(index, true)))
            return false;
    }
    return true;
}

StringView ResolvePublicationBenchmarkName(in usize index){
    switch(index){
    case 0u: return "editor.publish.256";
    case 1u: return "editor.publish.4096";
    default: return "editor.publish.16384";
    }
}

StringView ResolveSelectionBenchmarkName(in usize index){
    switch(index){
    case 0u: return "editor.empty_selection.100";
    case 1u: return "editor.empty_selection.1000";
    default: return "editor.empty_selection.10000";
    }
}

b8 RunPublicationCase(in usize stops, in StringView benchmarkName){
    GlobalArena arena = GlobalArena(s_UiBenchmarkNameTestsPerformanceUiInputPublication);
    Context context = Context(arena);
    BenchmarkTextInput textInput = BenchmarkTextInput(arena);
    BenchmarkClipboard clipboard = BenchmarkClipboard(arena);
    BenchmarkShaper shaper = BenchmarkShaper(arena);
    PublicationCase publication = PublicationCase(arena, context, textInput, clipboard, shaper, stops);
    if(!publication.setup() || !publication.operation() || !publication.checksum().has_value())
        return false;
    return Measure(benchmarkName, cast<u64>(stops), publication);
}

b8 RunEmptySelectionCase(in usize lines, in StringView benchmarkName){
    GlobalArena arena = GlobalArena(s_UiBenchmarkNameTestsPerformanceUiInputEmptySelection);
    BenchmarkShaper shaper = BenchmarkShaper(arena);
    EmptySelectionCase selection = EmptySelectionCase(arena, shaper, lines);
    if(!selection.setup() || !selection.operation() || !selection.checksum().has_value())
        return false;
    return Measure(benchmarkName, cast<u64>(lines), selection);
}

b8 RunEditBenchmarks(){
    Array<usize, 3> stopCounts;
    stopCounts[0] = 256u;
    stopCounts[1] = 4096u;
    stopCounts[2] = 16384u;
    Array<usize, 3> lineCounts;
    lineCounts[0] = 100u;
    lineCounts[1] = 1000u;
    lineCounts[2] = 10000u;
    for(usize index = 0u; index < stopCounts.size(); ++index){
        if(!RunPublicationCase(stopCounts[index], ResolvePublicationBenchmarkName(index)))
            return false;
        if(!RunEmptySelectionCase(lineCounts[index], ResolveSelectionBenchmarkName(index)))
            return false;
    }
    return true;
}

b8 RunAllUiInputBenchmarks(){
    return RunPointerBenchmarks()
        && RunPaintBenchmarks()
        && RunEditBenchmarks();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace UiInputBenchmark{
static int EntryPoint(const isize, tchar**, void*){
    NWB::Core::Common::InitializerGuard initializer;
    if(!initializer.initialize()){
        FOUNDATION_CERR << "UI input benchmark common initialization failed\n";
        return 1;
    }
    if(!NWB::Tests::UiInputBenchmarkCases::RunAllUiInputBenchmarks()){
        FOUNDATION_CERR << "UI input benchmark workload validation failed\n";
        return 1;
    }
    return 0;
}
}

NWB_DEFINE_APPLICATION_ENTRY_POINT(::UiInputBenchmark::EntryPoint)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


