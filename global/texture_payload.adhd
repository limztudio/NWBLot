[cpp_header("<global/texture_payload.h>"), cpp_name("::TextureFormat::MipChainLayoutError")]
extern class TextureMipChainLayoutError{
    MipChainLayoutFailure failure;
    u32 mipIndex;
};

[cpp_header("<global/texture_payload.h>"), cpp_name("::TextureFormat::MipLevelLayout")]
extern class TextureMipLevelLayout{
    u32 blockCountX;
    u32 blockCountY;
    u32 height;
    u64 offsetBytes;
    u64 sizeBytes;
    u32 sliceCount;
    u32 width;
};

[cpp_header("<global/texture_payload.h>"), cpp_name("::TextureFormat::TextureMipPlaneBlockLayout")]
extern class TextureMipPlaneBlockLayout{
    u32 blocksX;
    u32 blocksY;
    u64 planeByteCount;
};

[cpp_header("<global/texture_payload.h>"), cpp_name("::TextureBinaryPayload::HeaderBinary")]
extern class TexturePayloadHeaderBinary{
    u32 alphaInfo;
    u32 depth;
    u32 dimension;
    u32 height;
    u32 magic;
    u32 mipCount;
    u64 payloadByteCount;
    u32 payloadFormat;
    u32 version;
    u32 width;
};

[cpp_header("<global/texture_payload.h>"), cpp_name("::TextureBinaryPayload::MipLevelBinary")]
extern class TexturePayloadMipLevelBinary{
    u32 blockCountX;
    u32 blockCountY;
    u32 height;
    u64 offsetBytes;
    u32 reserved;
    u64 sizeBytes;
    u32 sliceCount;
    u32 width;
};


