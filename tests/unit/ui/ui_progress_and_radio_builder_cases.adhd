void VerifyUiProgressBuilderTests_CallerMutationCannotChangeDeferredProgressGeometryStyleOrResolvedNames(mut UiProgressBuilderTests self){
    ASSERT_TRUE(self.panel(1u));
    f64 fraction = 0.25;
    ProgressOptions options = MakeUiProgressDefaultOptions();
    self.m_builder.progressStyle().fillTint = MakeUiProgressColor(0.8f, 0.6f, 0.4f, 0.5f);
    ASSERT_TRUE(self.m_builder.progress("amount", fraction, options));
    fraction = 0.75;
    options.width.value = 100.0f;
    options.height = 80.0f;
    self.m_builder.progressStyle().padding = MakeUiProgressInsets(12.0f, 12.0f, 12.0f, 12.0f);
    self.setMissingStyleRegions();
    self.m_builder.progressStyle().fillTint = Color();
    ASSERT_TRUE(self.finishPanel());
    const DrawSnapshot snapshot = self.m_paint.freeze();
    const auto trackResult = self.sampleTrackRegion(snapshot);
    ASSERT_TRUE(trackResult.has_value());
    const SkinPaintSample track = trackResult.value();
    const auto fillResult = self.sampleFillRegion(snapshot);
    ASSERT_TRUE(fillResult.has_value());
    const SkinPaintSample fill = fillResult.value();
    EXPECT_FLOAT_EQ(track.bounds.width, 240.0f);
    EXPECT_FLOAT_EQ(track.bounds.height, 32.0f);
    EXPECT_FLOAT_EQ(fill.bounds.x - track.bounds.x, 4.0f);
    EXPECT_FLOAT_EQ(fill.bounds.width, 58.0f);
    EXPECT_FLOAT_EQ(fill.bounds.height, 24.0f);
    EXPECT_FLOAT_EQ(fill.color.r, 0.4f);
    EXPECT_FLOAT_EQ(fill.color.a, 0.5f);
}

void VerifyUiProgressBuilderTests_ExplicitFallbackRegionsResolveBeforeDeferredPaint(mut UiProgressBuilderTests self){
    self.configureProgress(false, true);
    ASSERT_TRUE(self.panel(1u));
    ASSERT_TRUE(self.m_builder.progress("amount", 0.5, MakeUiProgressDefaultOptions()));
    self.setMissingFallbackRegions();
    ASSERT_TRUE(self.finishPanel());
    const DrawSnapshot snapshot = self.m_paint.freeze();
    EXPECT_TRUE(self.sampleScrollbarTrackRegion(snapshot).has_value());
    EXPECT_TRUE(self.sampleScrollbarThumbRegion(snapshot).has_value());
}

void VerifyUiProgressBuilderTests_FiniteFractionsClampAtExactEmptyAndFullGeometry(mut UiProgressBuilderTests self){
    Array<f64, 4u> fractions = Array<f64, 4u>();
    fractions[0u] = -4.0;
    fractions[1u] = 0.0;
    fractions[2u] = 1.0;
    fractions[3u] = 4.0;
    for(u64 index = 0u; index < 4u; ++index){
        ASSERT_TRUE(self.panel(index + 1u));
        ASSERT_TRUE(self.m_builder.progress("amount", fractions[cast<usize>(index)], MakeUiProgressDefaultOptions()));
        ASSERT_TRUE(self.finishPanel());
        const DrawSnapshot snapshot = self.m_paint.freeze();
        const auto trackResult = self.sampleTrackRegion(snapshot);
        ASSERT_TRUE(trackResult.has_value());
        const SkinPaintSample track = trackResult.value();
        const auto fillResult = self.sampleFillRegion(snapshot);
        EXPECT_EQ(fillResult.has_value(), index >= 2u);
        if(index >= 2u){
            ASSERT_TRUE(fillResult.has_value());
            const SkinPaintSample fill = fillResult.value();
            EXPECT_FLOAT_EQ(fill.bounds.x, track.bounds.x + 4.0f);
            EXPECT_FLOAT_EQ(fill.bounds.width, track.bounds.width - 8.0f);
            EXPECT_FLOAT_EQ(fill.bounds.height, track.bounds.height - 8.0f);
        }
        self.m_context.abandonFrame();
    }
}

void VerifyUiProgressBuilderTests_TinyFillClipsNaturalBorderTexelsWithoutCompressingBothCaps(mut UiProgressBuilderTests self){
    ASSERT_TRUE(self.panel(1u));
    ASSERT_TRUE(self.m_builder.progress("amount", 0.01, MakeUiProgressDefaultOptions()));
    ASSERT_TRUE(self.finishPanel());
    const DrawSnapshot snapshot = self.m_paint.freeze();
    const auto trackResult = self.sampleTrackRegion(snapshot);
    ASSERT_TRUE(trackResult.has_value());
    const SkinPaintSample track = trackResult.value();
    const auto fillResult = self.sampleFillRegion(snapshot);
    ASSERT_TRUE(fillResult.has_value());
    const SkinPaintSample fill = fillResult.value();
    EXPECT_NEAR(fill.bounds.width, (track.bounds.width - 8.0f) * 0.01f, 0.000001f);
    EXPECT_LT(fill.maximumU, 134.0f / 256.0f);
    EXPECT_NEAR(fill.maximumU, (128.0f + fill.bounds.width) / 256.0f, 0.000001f);
    EXPECT_EQ(fill.quads, 3u);
}

void VerifyUiProgressBuilderTests_SubresolutionPositiveFractionRemainsAValidEmptyFill(mut UiProgressBuilderTests self){
    ASSERT_TRUE(self.panel(1u));
    ASSERT_TRUE(self.m_builder.progress("amount", bit_cast<f64>(cast<u64>(1u)), MakeUiProgressDefaultOptions()));
    ASSERT_TRUE(self.finishPanel());
    const DrawSnapshot snapshot = self.m_paint.freeze();
    EXPECT_TRUE(self.sampleTrackRegion(snapshot).has_value());
    EXPECT_FALSE(self.sampleFillRegion(snapshot).has_value());
}

void VerifyUiProgressBuilderTests_ExternalClipConstrainsPaintAndBothNestedClipsAreRestored(mut UiProgressBuilderTests self){
    ASSERT_TRUE(self.panel(1u));
    ASSERT_TRUE(self.m_builder.progress("amount", 0.25, MakeUiProgressDefaultOptions()));
    self.m_paint.pushClip(MakeUiProgressRect(20.0f, 0.0f, 20.0f, 600.0f));
    ASSERT_TRUE(self.finishPanel());
    ASSERT_TRUE(self.m_paint.popClip());
    self.m_paint.fillRect(MakeUiProgressRect(60.0f, 80.0f, 8.0f, 8.0f), MakeUiProgressColor(1.0f, 0.0f, 0.0f, 1.0f));
    const DrawSnapshot snapshot = self.m_paint.freeze();
    const auto fillResult = self.sampleFillRegion(snapshot);
    ASSERT_TRUE(fillResult.has_value());
    const SkinPaintSample fill = fillResult.value();
    EXPECT_FLOAT_EQ(fill.bounds.x, 20.0f);
    EXPECT_FLOAT_EQ(fill.bounds.width, 20.0f);
    b8 sentinel = false;
    for(in DrawCommand command : snapshot.commands()){
        if(command.material != PaintMaterial::Solid)
            continue;
        const Vertex vertex = snapshot.vertices()[snapshot.indices()[command.firstIndex]];
        sentinel = sentinel || (vertex.position.x == 60.0f && vertex.position.y == 80.0f);
    }
    EXPECT_TRUE(sentinel);
}

void VerifyUiProgressBuilderTests_InvalidFractionLeavesTheAcceptedTargetsAvailable(mut UiProgressBuilderTests self){
    ASSERT_TRUE(self.panel(1u));
    EXPECT_FALSE(self.m_builder.button("before", "Before"));
    ASSERT_TRUE(self.m_builder.progress("amount", 0.5, MakeUiProgressDefaultOptions()));
    ASSERT_TRUE(self.finishPanel());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const WidgetId before = self.id("before", s_UiProgressCasePanelKey);
    const auto acceptedResult = self.findTarget(before);
    ASSERT_TRUE(acceptedResult.has_value());
    const HitTarget accepted = acceptedResult.value();
    const usize count = self.m_context.input().targets().size();
    ASSERT_TRUE(self.panel(2u));
    EXPECT_FALSE(self.m_builder.progress("amount", bit_cast<f64>(cast<u64>(0x7ff8000000000001u)), MakeUiProgressDefaultOptions()));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    const auto currentResult = self.findTarget(before);
    ASSERT_TRUE(currentResult.has_value());
    const HitTarget current = currentResult.value();
    EXPECT_EQ(current.declarationGeneration, accepted.declarationGeneration);
    EXPECT_FLOAT_EQ(current.rectangle.x, accepted.rectangle.x);
    EXPECT_FLOAT_EQ(current.rectangle.width, accepted.rectangle.width);
    EXPECT_EQ(self.m_context.input().targets().size(), count);
}

void VerifyUiProgressBuilderTests_MissingPreferredAndFallbackRegionsRejectTheCandidate(mut UiProgressBuilderTests self){
    self.configureProgress(false, false);
    ASSERT_TRUE(self.panel(1u));
    EXPECT_FALSE(self.m_builder.progress("amount", 0.5, MakeUiProgressDefaultOptions()));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_FALSE(self.m_context.commitFrame(1u));
}


