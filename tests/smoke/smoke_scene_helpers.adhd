const u64 s_SmokeMaxU32Setting = 4294967295u;
const u64 s_SmokeBytesPerMiB = 1048576u;
const u64 s_SmokeMaxSoftwareShadowBudgetMiB = s_SmokeMaxU32Setting / s_SmokeBytesPerMiB;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Scene defaults are applied before explicit smoke environment overrides.
class SmokeRenderQualitySettings{
    public CausticQualitySettings caustic = CausticQualitySettings();
    public SurfelGiQualitySettings surfelGi = SurfelGiQualitySettings();
    public ShadowQualitySettings shadow = ShadowQualitySettings();
    public SoftwareShadowSettings softwareShadow = SoftwareShadowSettings();
}

class SmokeTintedEntitySetup{
    public Name materialInterface = s_NameNone;
    public EntityID entity = s_InvalidEntityId;
}

b8 ApplyCausticQualitySmokeSettings(mut RendererSystem renderer, in CausticQualitySettings baseSettings){
    CausticQualitySettings settings = baseSettings;
    const Expected<String> value = ReadSmokeEnvironmentString("NWB_CAUSTIC_PHOTON_GRID_DIVISOR");
    if(value.has_value()){
        const Expected<u64> parsed = ParseU64(StringView(value.value()));
        if(!parsed.has_value() || parsed.value() > s_SmokeMaxU32Setting)
            return false;
        settings.photonGridDivisor = cast<u32>(parsed.value());
    }
    if(!renderer.setCausticQualitySettings(settings))
        return false;
    [essential] info("CausticQualitySmoke: requested photon_grid_divisor={}", settings.photonGridDivisor);
    return true;
}

b8 ApplyCausticQualitySmokeSettings(mut RendererSystem renderer){
    return ApplyCausticQualitySmokeSettings(renderer, CausticQualitySettings());
}

b8 ApplySurfelGiQualitySmokeSettings(mut RendererSystem renderer, in SurfelGiQualitySettings baseSettings){
    SurfelGiQualitySettings settings = baseSettings;
    const Expected<String> value = ReadSmokeEnvironmentString("NWB_SURFEL_GI_RESOLVE_RESOLUTION");
    if(value.has_value()){
        const StringView resolution = StringView(value.value());
        if(resolution == "half")
            settings.resolveResolution = SurfelGiResolveResolution::Half;
        else if(resolution == "quarter")
            settings.resolveResolution = SurfelGiResolveResolution::Quarter;
        else
            return false;
    }
    if(!renderer.setSurfelGiQualitySettings(settings))
        return false;
    [essential] info("SurfelGiQualitySmoke: requested resolve_factor={}", cast<u32>(settings.resolveResolution));
    return true;
}

b8 ApplySurfelGiQualitySmokeSettings(mut RendererSystem renderer){
    return ApplySurfelGiQualitySmokeSettings(renderer, SurfelGiQualitySettings());
}

b8 ApplyShadowQualitySmokeSettings(mut RendererSystem renderer, in ShadowQualitySettings baseSettings){
    ShadowQualitySettings settings = baseSettings;
    const Expected<String> samplingValue = ReadSmokeEnvironmentString("NWB_SHADOW_TRANSPARENT_SAMPLING");
    if(samplingValue.has_value()){
        const StringView sampling = StringView(samplingValue.value());
        if(sampling == "reference_three")
            settings.transparentSampling = TransparentShadowSampling::ReferenceThree;
        else if(sampling == "temporal_one")
            settings.transparentSampling = TransparentShadowSampling::TemporalOne;
        else
            return false;
    }
    const Expected<String> resolutionValue = ReadSmokeEnvironmentString("NWB_SHADOW_RECEIVER_RESOLUTION");
    if(resolutionValue.has_value()){
        const StringView resolution = StringView(resolutionValue.value());
        if(resolution == "half")
            settings.receiverResolution = ShadowReceiverResolution::Half;
        else if(resolution == "quarter")
            settings.receiverResolution = ShadowReceiverResolution::Quarter;
        else
            return false;
    }
    if(!renderer.setShadowQualitySettings(settings))
        return false;
    [essential] info(
        "ShadowQualitySmoke: requested transparent_sampling={} receiver_factor={}"
        , cast<u32>(settings.transparentSampling)
        , cast<u32>(settings.receiverResolution)
    );
    return true;
}

b8 ApplyShadowQualitySmokeSettings(mut RendererSystem renderer){
    return ApplyShadowQualitySmokeSettings(renderer, ShadowQualitySettings());
}

b8 ApplySoftwareShadowSmokeSettings(mut RendererSystem renderer, in SoftwareShadowSettings baseSettings){
    SoftwareShadowSettings settings = baseSettings;
    const Expected<String> backendValue = ReadSmokeEnvironmentString("NWB_SOFTWARE_SHADOW_BACKEND");
    if(backendValue.has_value()){
        const StringView mode = StringView(backendValue.value());
        if(mode == "automatic")
            settings.backend = SoftwareShadowBackend::Automatic;
        else if(mode == "trace")
            settings.backend = SoftwareShadowBackend::SoftwareTrace;
        else if(mode == "light_space")
            settings.backend = SoftwareShadowBackend::LightSpace;
        else
            return false;
    }
    const Expected<String> coverageValue = ReadSmokeEnvironmentString("NWB_SOFTWARE_SHADOW_COVERAGE");
    if(coverageValue.has_value()){
        const StringView coverage = StringView(coverageValue.value());
        if(coverage == "reference")
            settings.coverage = SoftwareShadowCoverage::Reference;
        else if(coverage == "fitted_volume")
            settings.coverage = SoftwareShadowCoverage::FittedVolume;
        else
            return false;
    }
    const Expected<String> searchValue = ReadSmokeEnvironmentString("NWB_SOFTWARE_SHADOW_BLOCKER_SEARCH");
    if(searchValue.has_value()){
        const StringView search = StringView(searchValue.value());
        if(search == "reference_grid9")
            settings.blockerSearch = SoftwareShadowBlockerSearch::ReferenceGrid9;
        else if(search == "compact_cross5")
            settings.blockerSearch = SoftwareShadowBlockerSearch::CompactCross5;
        else if(search == "center1")
            settings.blockerSearch = SoftwareShadowBlockerSearch::Center1;
        else
            return false;
    }
    const Expected<String> cadenceValue = ReadSmokeEnvironmentString("NWB_SOFTWARE_SHADOW_CAPTURE_CADENCE");
    if(cadenceValue.has_value()){
        const StringView cadence = StringView(cadenceValue.value());
        if(cadence == "every_frame")
            settings.captureCadence = SoftwareShadowCaptureCadence::EveryFrame;
        else if(cadence == "reuse_one_frame")
            settings.captureCadence = SoftwareShadowCaptureCadence::ReuseOneFrame;
        else if(cadence == "reuse_two_frames")
            settings.captureCadence = SoftwareShadowCaptureCadence::ReuseTwoFrames;
        else
            return false;
    }
    const Expected<String> directionalValue = ReadSmokeEnvironmentString("NWB_SOFTWARE_SHADOW_DIRECTIONAL_RESOLUTION");
    if(directionalValue.has_value()){
        const Expected<u64> parsed = ParseU64(StringView(directionalValue.value()));
        if(!parsed.has_value() || parsed.value() > s_SmokeMaxU32Setting)
            return false;
        settings.directionalResolution = cast<u32>(parsed.value());
    }
    const Expected<String> pointValue = ReadSmokeEnvironmentString("NWB_SOFTWARE_SHADOW_POINT_RESOLUTION");
    if(pointValue.has_value()){
        const Expected<u64> parsed = ParseU64(StringView(pointValue.value()));
        if(!parsed.has_value() || parsed.value() > s_SmokeMaxU32Setting)
            return false;
        settings.pointResolution = cast<u32>(parsed.value());
    }
    const Expected<String> budgetValue = ReadSmokeEnvironmentString("NWB_SOFTWARE_SHADOW_BUDGET_MIB");
    if(budgetValue.has_value()){
        const Expected<u64> parsed = ParseU64(StringView(budgetValue.value()));
        if(!parsed.has_value() || parsed.value() > s_SmokeMaxSoftwareShadowBudgetMiB)
            return false;
        settings.memoryBudgetBytes = parsed.value() * s_SmokeBytesPerMiB;
    }
    if(!renderer.setSoftwareShadowSettings(settings))
        return false;
    [essential] info(
        "SoftwareShadowSmoke: requested backend={} directional_resolution={} point_resolution={} budget_bytes={} coverage={} blocker_search={} capture_cadence={}"
        , cast<u32>(settings.backend)
        , settings.directionalResolution
        , settings.pointResolution
        , settings.memoryBudgetBytes
        , cast<u32>(settings.coverage)
        , cast<u32>(settings.blockerSearch)
        , cast<u32>(settings.captureCadence)
    );
    return true;
}

b8 ApplySoftwareShadowSmokeSettings(mut RendererSystem renderer){
    return ApplySoftwareShadowSmokeSettings(renderer, SoftwareShadowSettings());
}

b8 ApplyReflectionQualitySmokeSettings(in ReflectionSettings baseSettings, mut RendererSystem renderer){
    ReflectionSettings settings = baseSettings;
    const Expected<String> value = ReadSmokeEnvironmentString("NWB_REFLECTION_SCREEN_STEPS");
    if(value.has_value()){
        const Expected<u64> parsed = ParseU64(StringView(value.value()));
        if(!parsed.has_value() || parsed.value() > s_SmokeMaxU32Setting)
            return false;
        settings.screenMaxSteps = cast<u32>(parsed.value());
    }
    if(!renderer.setReflectionSettings(settings))
        return false;
    [essential] info("ReflectionQualitySmoke: requested screen_max_steps={}", settings.screenMaxSteps);
    return true;
}

b8 ApplyReflectionQualitySmokeSettings(in ReflectionSettings baseSettings, mut RendererSystem renderer, mut ScratchArena arena){
    return ApplyReflectionQualitySmokeSettings(baseSettings, renderer);
}

SmokeTintedEntitySetup CreateSmokeTintedEntity(
    in SmokeMaterialRef material,
    in NameTextAscii materialInterfacePath,
    in VectorSingle position,
    in VectorSingle scale,
    mut World world
){
    SmokeTintedEntitySetup setup = SmokeTintedEntitySetup();
    setup.materialInterface = Name(materialInterfacePath);
    const Name materialInterface = setup.materialInterface;
    const f32x4 storedPosition = f32x4(position);
    const f32x4 storedScale = f32x4(scale);
    EntityID entityId = s_InvalidEntityId;
    native(in material, in materialInterface, in storedPosition, in storedScale, mut world, mut entityId){
        auto entity = world.createEntity();
        auto& transform = entity.addComponent<Impl::Scene::TransformComponent>();
        transform.position = storedPosition;
        transform.scale = storedScale;

        auto& renderer = entity.addComponent<Impl::RendererComponent>();
        renderer.material = material;

        entity.addComponent<Impl::MaterialInstanceComponent>(materialInterface);
        entityId = entity.id();
    }
    setup.entity = entityId;
    return setup;
}

b8 ApplySmokeMaterialTint(
    in SmokeTintedEntitySetup setup,
    in VectorSingle colorTint,
    in StringView tintParameterPath,
    mut World world
){
    const f32x4 storedTint = f32x4(colorTint);
    b8 applied = false;
    native(in setup, in storedTint, in tintParameterPath, mut world, mut applied){
        applied = Impl::SetMaterialMutableHalf4(world, setup.entity, setup.materialInterface, tintParameterPath, storedTint);
    }
    return applied;
}

EntityID CreateTintedStaticMeshEntityWithPath(
    in SmokeMeshRef mesh,
    in SmokeMaterialRef material,
    in NameTextAscii materialInterfacePath,
    in VectorSingle colorTint,
    in VectorSingle position,
    in VectorSingle scale,
    in StringView tintParameterPath,
    mut World world
){
    const SmokeTintedEntitySetup setup = CreateSmokeTintedEntity(material, materialInterfacePath, position, scale, world);
    native(in setup, in mesh, mut world){
        auto& meshComponent = world.entity(setup.entity).addComponent<Impl::MeshComponent>();
        meshComponent.mesh = mesh;
    }
    if(!ApplySmokeMaterialTint(setup, colorTint, tintParameterPath, world))
        return s_InvalidEntityId;

    return setup.entity;
}

EntityID CreateTintedStaticMeshEntity(
    in SmokeMeshRef mesh,
    in SmokeMaterialRef material,
    in NameTextAscii materialInterfacePath,
    in VectorSingle colorTint,
    in VectorSingle position,
    in VectorSingle scale,
    in StringView tintParameterPath,
    mut World world
){
    return CreateTintedStaticMeshEntityWithPath(mesh, material, materialInterfacePath, colorTint, position, scale, tintParameterPath, world);
}

EntityID CreateTintedStaticMeshEntity(
    in SmokeMeshRef mesh,
    in SmokeMaterialRef material,
    in NameTextAscii materialInterfacePath,
    in VectorSingle colorTint,
    in VectorSingle position,
    in VectorSingle scale,
    mut World world
){
    return CreateTintedStaticMeshEntityWithPath(mesh, material, materialInterfacePath, colorTint, position, scale, "runtime.color_tint", world);
}

SmokeRenderSystems CreateSmokeRenderSystems(mut World world, mut ProjectRuntimeContext context, in SmokeRenderQualitySettings baseSettings){
    native(mut world, mut context, in baseSettings){
        auto& meshSystem = world.addSystem<Impl::MeshSystem>(world);
        auto& rendererSystem = world.addSystem<Impl::RendererSystem>(world, context.graphics, context.assetManager, context.shaderPathResolver);
        FOUNDATION_FATAL_ASSERT_MSG(ApplyCausticQualitySmokeSettings(rendererSystem, baseSettings.caustic), FOUNDATION_TEXT("Invalid caustic quality smoke settings"));
        FOUNDATION_FATAL_ASSERT_MSG(ApplySurfelGiQualitySmokeSettings(rendererSystem, baseSettings.surfelGi), FOUNDATION_TEXT("Invalid surfel GI quality smoke settings"));
        FOUNDATION_FATAL_ASSERT_MSG(ApplySoftwareShadowSmokeSettings(rendererSystem, baseSettings.softwareShadow), FOUNDATION_TEXT("Invalid software shadow smoke settings"));
        FOUNDATION_FATAL_ASSERT_MSG(ApplyShadowQualitySmokeSettings(rendererSystem, baseSettings.shadow), FOUNDATION_TEXT("Invalid shadow quality smoke settings"));
        return SmokeRenderSystems{ meshSystem, rendererSystem };
    }
}

SmokeRenderSystems CreateSmokeRenderSystems(mut World world, mut ProjectRuntimeContext context){
    return CreateSmokeRenderSystems(world, context, SmokeRenderQualitySettings());
}

void SetupSmokeRenderSystems(mut World world, mut ProjectRuntimeContext context, in SmokeRenderQualitySettings baseSettings){
    const SmokeRenderSystems systems = CreateSmokeRenderSystems(world, context, baseSettings);
    native(in systems, mut context){
        context.graphics.addRenderPassToBack(systems.renderer);
        context.frameGraphRegistry.registerContributor(systems.renderer);
    }
}

void SetupSmokeRenderSystems(mut World world, mut ProjectRuntimeContext context){
    SetupSmokeRenderSystems(world, context, SmokeRenderQualitySettings());
}

void FinishDestroyingSmokeWorld(mut ProjectRuntimeContext context, mut NotNullUniquePtr<World> world){
    const b8 deviceIdle = context.graphics.waitForIdle();
    [essential] assert(deviceIdle || context.graphics.isDeviceLost(), "Smoke-world destruction requires either a completed device join or terminal device loss");

    native(mut world){
        world->clear();
        world.owner().reset();
    }
}

void RemoveSmokeRendererSystem(mut ProjectRuntimeContext context, mut World world){
    native(mut context, mut world){
        Impl::RendererSystem& rendererSystem = *MakeNotNull(world.getSystem<Impl::RendererSystem>());
        context.frameGraphRegistry.unregisterContributor(rendererSystem);
        context.graphics.removeRenderPass(rendererSystem);
    }
}

void DestroySmokeRenderWorld(mut ProjectRuntimeContext context, mut NotNullUniquePtr<World> world){
    if(!world.owner())
        return;

    RemoveSmokeRendererSystem(context, SmokeWorldRef(world));
    FinishDestroyingSmokeWorld(context, world);
}

void DestroyCapturedSmokeRenderWorld(mut ProjectRuntimeContext context, mut NotNullUniquePtr<World> world, mut UniquePtr<FramebufferCapture> capture){
    DestroySmokeRenderWorld(context, world);
    StopAndResetSmokeFramebufferCapture(capture);
}


