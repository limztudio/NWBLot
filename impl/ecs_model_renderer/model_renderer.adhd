#include "types.adhd"
#include <impl/ecs_model/system.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Optional<RendererComponent> TryGetOwnerRendererComponent(in World world, in EntityID owner){
    if(world.hasComponent<RendererComponent>(owner))
        return world.getComponent<RendererComponent>(owner);
    return Optional<RendererComponent>();
}

void CopyOwnerMaterialInstanceIfPresent(in World world, in EntityID owner, mut MaterialInstanceComponent outMaterialInstance){
    if(world.hasComponent<MaterialInstanceComponent>(owner))
        CopyModelObjectMaterialInstance(world.getComponent<MaterialInstanceComponent>(owner), outMaterialInstance);
}

void ApplyModelObjectRenderer(in EntityID owner, in AssetRef<Material> material, mut World world, mut Entity entity){
    const Optional<RendererComponent> ownerRenderer = TryGetOwnerRendererComponent(world, owner);
    RendererComponent fallbackRenderer = RendererComponent();
    if(ownerRenderer.has_value())
        fallbackRenderer = ownerRenderer.value();
    const Expected<RendererComponent> resolvedRenderer = TryResolveModelObjectRendererComponent(
        material,
        ownerRenderer.has_value(),
        fallbackRenderer
    );
    if(!resolvedRenderer.has_value())
        return;

    mut RendererComponent renderer = entity.addComponent<RendererComponent>();
    renderer = resolvedRenderer.value();

    mut MaterialInstanceComponent materialInstance = entity.addComponent<MaterialInstanceComponent>();
    CopyOwnerMaterialInstanceIfPresent(world, owner, materialInstance);
}

ComponentAccess MakeWriteComponentAccess(in usize typeId){
    ComponentAccess access = ComponentAccess();
    access.typeId = typeId;
    access.mode = AccessMode::Write;
    return access;
}

ModelObjectRendererHooks CreateModelObjectRendererHooks(){
    Array<ComponentAccess, 2u> accesses = Array<ComponentAccess, 2u>();
    accesses[0u] = MakeWriteComponentAccess(ComponentType<RendererComponent>());
    accesses[1u] = MakeWriteComponentAccess(ComponentType<MaterialInstanceComponent>());
    const ModelObjectRendererApplyFn applyFn = ApplyModelObjectRenderer;
    return ModelObjectRendererHooks(ModelObjectRendererCallback(applyFn), accesses);
}


