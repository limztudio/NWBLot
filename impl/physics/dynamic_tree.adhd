////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/physics/math.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u8 s_TreeNodeHasSensor = 0x01u;
const u8 s_TreeNodeHasSensorEvents = 0x02u;
const u8 s_TreeNodeHasNonSensor = 0x04u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TreeNode{
    public f32x3_u32 aabbMinUser(0.0f, 0.0f, 0.0f, s_NullIndex);
    public f32x3_u32 aabbMaxCategory(0.0f, 0.0f, 0.0f, 0u);
    public u32 parentOrNext = s_NullIndex;
    public u32 child1 = s_NullIndex;
    public u32 child2 = s_NullIndex;
    public i16 height = -1;
    public b8 moved = false;
    public u8 nodeFlags = 0u;

    public b8 isLeaf()const{
        return this.child1 == s_NullIndex;
    }

    public Aabb3D aabb()const{
        return Aabb3D(VectorSingle(this.aabbMinUser, 0.0f), VectorSingle(this.aabbMaxCategory, 0.0f));
    }

    public void setAabbValues(in VectorSingle lower, in VectorSingle upper){
        this.aabbMinUser = f32x3_u32(lower, this.aabbMinUser.w);
        this.aabbMaxCategory = f32x3_u32(upper, this.aabbMaxCategory.w);
    }

    public void setAabb(in Aabb3D box){
        this.setAabbValues(VectorSingle(box.lowerBound), VectorSingle(box.upperBound));
    }

    public u32 userData()const{
        return this.aabbMinUser.w;
    }

    public u32 categoryBits()const{
        return this.aabbMaxCategory.w;
    }
}

class DynamicTree{
    private Vector<TreeNode> m_nodes;
    private Vector<u32> m_moveIndices;
    private u32 m_root = s_NullIndex;
    private u32 m_freeList = s_NullIndex;
    private u32 m_nodeCount = 0u;

    public void clear(){
        this.m_nodes.clear();
        this.m_moveIndices.clear();
        this.m_root = s_NullIndex;
        this.m_freeList = s_NullIndex;
        this.m_nodeCount = 0u;
    }

    public u32 createProxyWithFlags(in Aabb3D aabb, in u32 categoryBits, in u8 nodeFlags, in u32 userData){
        const u32 proxyId = this.allocateNode();
        const VectorSingle lower(aabb.lowerBound);
        const VectorSingle upper(aabb.upperBound);
        const f32 margin = ComputeAabbMarginValues(lower, upper);
        const VectorSingle mVec(margin, margin, margin, 0.0f);
        this.m_nodes[proxyId].aabbMinUser = f32x3_u32(lower - mVec, userData);
        this.m_nodes[proxyId].aabbMaxCategory = f32x3_u32(upper + mVec, categoryBits);
        this.m_nodes[proxyId].height = 0;
        this.m_nodes[proxyId].moved = false;
        this.m_nodes[proxyId].nodeFlags = nodeFlags;
        this.m_moveIndices[proxyId] = s_NullIndex;
        this.insertLeaf(proxyId);
        return proxyId;
    }

    public void setNodeFlags(in u32 proxyId, in u8 nodeFlags){
        if(proxyId >= this.m_nodes.size() || !this.m_nodes[proxyId].isLeaf())
            return;
        if(this.m_nodes[proxyId].nodeFlags == nodeFlags)
            return;
        this.m_nodes[proxyId].nodeFlags = nodeFlags;
        u32 parent = this.m_nodes[proxyId].parentOrNext;
        while(parent != s_NullIndex){
            const u32 c1 = this.m_nodes[parent].child1;
            const u32 c2 = this.m_nodes[parent].child2;
            const u8 mergedFlags = this.m_nodes[c1].nodeFlags | this.m_nodes[c2].nodeFlags;
            if(this.m_nodes[parent].nodeFlags == mergedFlags)
                break;
            this.m_nodes[parent].nodeFlags = mergedFlags;
            parent = this.m_nodes[parent].parentOrNext;
        }
    }

    public void destroyProxy(in u32 proxyId){
        if(proxyId >= this.m_nodes.size() || !this.m_nodes[proxyId].isLeaf())
            return;
        this.removeLeaf(proxyId);
        this.freeNode(proxyId);
    }

    public b8 needsMove(in u32 proxyId, in Aabb3D aabb, in b8 keepEnlarged)const{
        if(proxyId >= this.m_nodes.size() || !this.m_nodes[proxyId].isLeaf())
            return false;
        in TreeNode node = this.m_nodes[proxyId];
        const VectorSingle curMin(node.aabbMinUser, 0.0f);
        const VectorSingle curMax(node.aabbMaxCategory, 0.0f);
        const VectorSingle lower(aabb.lowerBound);
        const VectorSingle upper(aabb.upperBound);
        if(!AabbContainsValues(curMin, curMax, lower, upper))
            return true;
        if(keepEnlarged)
            return false;
        const f32 hugeMargin = 5.0f * ComputeAabbMarginValues(lower, upper);
        const VectorSingle hVec(hugeMargin, hugeMargin, hugeMargin, 0.0f);
        return !AabbContainsValues(lower - hVec, upper + hVec, curMin, curMax);
    }

    public void moveProxyUnchecked(in u32 proxyId, in Aabb3D aabb, in VectorSingle displacement){
        if(proxyId >= this.m_nodes.size() || !this.m_nodes[proxyId].isLeaf())
            return;

        const VectorSingle lower0(aabb.lowerBound);
        const VectorSingle upper0(aabb.upperBound);
        const f32 margin = ComputeAabbMarginValues(lower0, upper0);
        const VectorSingle mVec(margin, margin, margin, 0.0f);
        const VectorSingle fattenedLower = lower0 - mVec;
        const VectorSingle fattenedUpper = upper0 + mVec;
        const VectorSingle d = VectorSingle(displacement, 0.0f) * 2.0f;
        const VectorSingle dNeg = VectorLess(d, VectorSingle(0.0f));
        const VectorSingle lower = VectorSelect(fattenedLower, fattenedLower + d, dNeg);
        const VectorSingle upper = VectorSelect(fattenedUpper + d, fattenedUpper, dNeg);

        this.removeLeaf(proxyId);
        this.m_nodes[proxyId].setAabbValues(lower, upper);
        this.insertLeaf(proxyId);
    }

    public b8 moveProxy(in u32 proxyId, in Aabb3D aabb, in VectorSingle displacement){
        if(proxyId >= this.m_nodes.size() || !this.m_nodes[proxyId].isLeaf())
            return false;

        const VectorSingle lower0(aabb.lowerBound);
        const VectorSingle upper0(aabb.upperBound);
        const f32 margin = ComputeAabbMarginValues(lower0, upper0);
        const VectorSingle mVec(margin, margin, margin, 0.0f);
        const VectorSingle fattenedLower = lower0 - mVec;
        const VectorSingle fattenedUpper = upper0 + mVec;
        const VectorSingle hugeVec(4.0f * margin, 4.0f * margin, 4.0f * margin, 0.0f);
        in TreeNode curNode = this.m_nodes[proxyId];
        const VectorSingle curMin(curNode.aabbMinUser, 0.0f);
        const VectorSingle curMax(curNode.aabbMaxCategory, 0.0f);
        if(AabbContainsValues(curMin, curMax, lower0, upper0) && AabbContainsValues(fattenedLower - hugeVec, fattenedUpper + hugeVec, curMin, curMax))
            return false;

        const VectorSingle d = VectorSingle(displacement, 0.0f) * 2.0f;
        const VectorSingle dNeg = VectorLess(d, VectorSingle(0.0f));
        const VectorSingle lower = VectorSelect(fattenedLower, fattenedLower + d, dNeg);
        const VectorSingle upper = VectorSelect(fattenedUpper + d, fattenedUpper, dNeg);

        this.removeLeaf(proxyId);
        this.m_nodes[proxyId].setAabbValues(lower, upper);
        this.insertLeaf(proxyId);
        return true;
    }

    public b8 isMoved(in u32 proxyId)const{
        if(proxyId >= this.m_nodes.size())
            return false;
        return this.m_nodes[proxyId].moved;
    }

    public void setMoved(in u32 proxyId, in b8 moved){
        if(proxyId < this.m_nodes.size())
            this.m_nodes[proxyId].moved = moved;
    }

    public u32 moveIndex(in u32 proxyId)const{
        if(proxyId >= this.m_moveIndices.size())
            return s_NullIndex;
        return this.m_moveIndices[proxyId];
    }

    public void setMoveIndex(in u32 proxyId, in u32 idx){
        if(proxyId < this.m_moveIndices.size())
            this.m_moveIndices[proxyId] = idx;
    }

    public Aabb3D fatAabb(in u32 proxyId)const{
        return this.m_nodes[proxyId].aabb();
    }

    public u32 root()const{
        return this.m_root;
    }

    public b8 isValidNode(in u32 nodeId)const{
        return nodeId != s_NullIndex && cast<usize>(nodeId) < this.m_nodes.size() && this.m_nodes[nodeId].height >= 0;
    }

    public in TreeNode node(in u32 nodeId)const{
        return this.m_nodes[nodeId];
    }

    public u32 userData(in u32 proxyId)const{
        return this.m_nodes[proxyId].userData();
    }

    public b8 isValidLeaf(in u32 proxyId)const{
        if(proxyId >= this.m_nodes.size())
            return false;
        in TreeNode n = this.m_nodes[proxyId];
        return n.height == 0 && n.isLeaf() && n.userData() != s_NullIndex;
    }

    public in Vector<TreeNode> nodes()const{
        return this.m_nodes;
    }

    public in Vector<u32> moveIndices()const{
        return this.m_moveIndices;
    }

    public u32 freeList()const{
        return this.m_freeList;
    }

    public u32 nodeCount()const{
        return this.m_nodeCount;
    }

    public void beginRestore(in usize nodeCount, in usize moveIndexCount, in u32 inRoot, in u32 inFreeList, in u32 inNodeCount){
        this.m_nodes.resize(nodeCount);
        this.m_moveIndices.resize(moveIndexCount);
        this.m_root = inRoot;
        this.m_freeList = inFreeList;
        this.m_nodeCount = inNodeCount;
    }

    public void setRestoredNode(in usize idx, in TreeNode node){
        this.m_nodes[idx] = node;
    }

    public void setRestoredMoveIndex(in usize idx, in u32 moveIdx){
        this.m_moveIndices[idx] = moveIdx;
    }

    public void swapState(mut DynamicTree other){
        this.m_nodes.swap(other.m_nodes);
        this.m_moveIndices.swap(other.m_moveIndices);
        const u32 tmpRoot = this.m_root;
        this.m_root = other.m_root;
        other.m_root = tmpRoot;
        const u32 tmpFree = this.m_freeList;
        this.m_freeList = other.m_freeList;
        other.m_freeList = tmpFree;
        const u32 tmpCount = this.m_nodeCount;
        this.m_nodeCount = other.m_nodeCount;
        other.m_nodeCount = tmpCount;
    }

    public void queryAabbFiltered<Callback>(in Aabb3D queryBox, in u32 maskBits, in u8 requiredNodeFlags, in Callback callback)const{
        if(this.m_root == s_NullIndex || maskBits == 0u)
            return;

        in TreeNode rootNode = this.m_nodes[this.m_root];
        if(maskBits != u32.max && (rootNode.categoryBits() & maskBits) == 0u)
            return;
        if(requiredNodeFlags != 0u && (rootNode.nodeFlags & requiredNodeFlags) == 0u)
            return;
        const VectorSingle queryMin(queryBox.lowerBound);
        const VectorSingle queryMax(queryBox.upperBound);
        if(!AabbOverlapsValues(VectorSingle(rootNode.aabbMinUser, 0.0f), VectorSingle(rootNode.aabbMaxCategory, 0.0f), queryMin, queryMax))
            return;
        if(rootNode.isLeaf()){
            callback(this.m_root, rootNode.userData());
            return;
        }

        BvhSpillStack<u32, 64u> stack;
        stack.push(this.m_root);
        u32 nodeId = 0u;
        while(stack.pop(nodeId)){
            in TreeNode node = this.m_nodes[nodeId];
            Array<u32, 2u> children;
            children[0u] = node.child1;
            children[1u] = node.child2;
            for(usize ci = 0u; ci < 2u; ++ci){
                const u32 childIdx = children[ci];
                if(childIdx == s_NullIndex)
                    continue;
                in TreeNode child = this.m_nodes[childIdx];
                if(
                    (maskBits == u32.max || (child.categoryBits() & maskBits) != 0u)
                    && (requiredNodeFlags == 0u || (child.nodeFlags & requiredNodeFlags) != 0u)
                    && AabbOverlapsValues(VectorSingle(child.aabbMinUser, 0.0f), VectorSingle(child.aabbMaxCategory, 0.0f), queryMin, queryMax)
                ){
                    if(child.isLeaf()){
                        if(!callback(childIdx, child.userData()))
                            return;
                    }
                    else{
                        stack.push(childIdx);
                    }
                }
            }
        }
    }

    public void queryAabbFilteredScratch<Callback>(
        in Aabb3D queryBox,
        in u32 maskBits,
        in u8 requiredNodeFlags,
        in Callback callback,
        mut Vector<u32> stackScratch
    )const{
        this.queryAabbFilteredMovedScratch(
            queryBox,
            maskBits,
            requiredNodeFlags,
            lambda[in callback](in u32 proxyId, in u32 userData, in b8 moved) -> b8{
                return callback(proxyId, userData);
            },
            stackScratch
        );
    }

    public void queryAabbFilteredMovedScratch<Callback>(
        in Aabb3D queryBox,
        in u32 maskBits,
        in u8 requiredNodeFlags,
        in Callback callback,
        mut Vector<u32> stackScratch
    )const{
        if(this.m_root == s_NullIndex || maskBits == 0u)
            return;

        in TreeNode rootNode = this.m_nodes[this.m_root];
        if(maskBits != u32.max && (rootNode.categoryBits() & maskBits) == 0u)
            return;
        if(requiredNodeFlags != 0u && (rootNode.nodeFlags & requiredNodeFlags) == 0u)
            return;
        const VectorSingle queryMin(queryBox.lowerBound);
        const VectorSingle queryMax(queryBox.upperBound);
        if(!AabbOverlapsValues(VectorSingle(rootNode.aabbMinUser, 0.0f), VectorSingle(rootNode.aabbMaxCategory, 0.0f), queryMin, queryMax))
            return;
        if(rootNode.isLeaf()){
            callback(this.m_root, rootNode.userData(), rootNode.moved);
            return;
        }

        Array<u32, 64u> localStack;
        localStack[0u] = this.m_root;
        u32 localCount = 1u;
        b8 useHeap = false;
        while(localCount > 0u || (useHeap && !stackScratch.empty())){
            u32 nodeId = 0u;
            if(useHeap){
                nodeId = stackScratch.back();
                stackScratch.pop_back();
            }
            else{
                --localCount;
                nodeId = localStack[localCount];
            }
            in TreeNode node = this.m_nodes[nodeId];
            Array<u32, 2u> children;
            children[0u] = node.child1;
            children[1u] = node.child2;
            for(usize ci = 0u; ci < 2u; ++ci){
                const u32 childIdx = children[ci];
                if(childIdx == s_NullIndex)
                    continue;
                in TreeNode child = this.m_nodes[childIdx];
                if(
                    (maskBits == u32.max || (child.categoryBits() & maskBits) != 0u)
                    && (requiredNodeFlags == 0u || (child.nodeFlags & requiredNodeFlags) != 0u)
                    && AabbOverlapsValues(VectorSingle(child.aabbMinUser, 0.0f), VectorSingle(child.aabbMaxCategory, 0.0f), queryMin, queryMax)
                ){
                    if(child.isLeaf()){
                        if(!callback(childIdx, child.userData(), child.moved))
                            return;
                    }
                    else if(localCount < 64u && !useHeap){
                        localStack[localCount] = childIdx;
                        ++localCount;
                    }
                    else{
                        if(!useHeap){
                            useHeap = true;
                            stackScratch.clear();
                            for(u32 si = 0u; si < localCount; ++si)
                                stackScratch.push_back(localStack[si]);
                            localCount = 0u;
                        }
                        stackScratch.push_back(childIdx);
                    }
                }
            }
        }
    }

    public void queryAabb<Callback>(in Aabb3D queryBox, in u32 maskBits, in Callback callback)const{
        this.queryAabbFiltered(queryBox, maskBits, 0u, callback);
    }

    public void rayCastFiltered<Callback>(
        in VectorSingle origin,
        in VectorSingle translation,
        in u32 maskBits,
        in f32 initialMaxFraction,
        in u8 requiredNodeFlags,
        in Callback callback
    )const{
        if(this.m_root == s_NullIndex || maskBits == 0u || initialMaxFraction <= 0.0f)
            return;

        in TreeNode rootNode = this.m_nodes[this.m_root];
        if(maskBits != u32.max && (rootNode.categoryBits() & maskBits) == 0u)
            return;
        if(requiredNodeFlags != 0u && (rootNode.nodeFlags & requiredNodeFlags) == 0u)
            return;

        f32 maxFraction = initialMaxFraction;
        VectorSingle invDir(0.0f);
        u32 parallelMask = 0u;
        ComputeRayCastSlabValues(translation, invDir, parallelMask);
        f32 rootTMin = 0.0f;
        if(!AabbRayCastValues(VectorSingle(rootNode.aabbMinUser, 0.0f), VectorSingle(rootNode.aabbMaxCategory, 0.0f), origin, invDir, parallelMask, maxFraction, rootTMin))
            return;
        if(rootNode.isLeaf()){
            callback(this.m_root, rootNode.userData(), maxFraction);
            return;
        }

        BvhMetricSpillStack<256u> stack;
        stack.push(this.m_root, rootTMin);
        u32 nodeId = 0u;
        f32 poppedTMin = 0.0f;
        while(stack.pop(nodeId, poppedTMin)){
            if(poppedTMin > maxFraction)
                continue;

            in TreeNode node = this.m_nodes[nodeId];
            if(node.isLeaf()){
                maxFraction = callback(nodeId, node.userData(), maxFraction);
                if(maxFraction <= 0.0f)
                    return;
            }
            else{
                Array<u32, 2u> children;
                children[0u] = node.child1;
                children[1u] = node.child2;
                Array<b8, 2u> hits;
                Array<f32, 2u> tMins;
                for(usize ci = 0u; ci < 2u; ++ci){
                    hits[ci] = false;
                    tMins[ci] = 0.0f;
                    const u32 childIdx = children[ci];
                    if(childIdx != s_NullIndex){
                        in TreeNode child = this.m_nodes[childIdx];
                        if(
                            (maskBits == u32.max || (child.categoryBits() & maskBits) != 0u)
                            && (requiredNodeFlags == 0u || (child.nodeFlags & requiredNodeFlags) != 0u)
                        )
                            hits[ci] = AabbRayCastValues(VectorSingle(child.aabbMinUser, 0.0f), VectorSingle(child.aabbMaxCategory, 0.0f), origin, invDir, parallelMask, maxFraction, tMins[ci]);
                    }
                }
                stack.pushOrderedPair(node.child1, hits[0u], tMins[0u], node.child2, hits[1u], tMins[1u]);
            }
        }
    }

    private u32 allocateNode(){
        if(this.m_freeList == s_NullIndex){
            const usize prevCap = this.m_nodes.size();
            usize newCap = 64u;
            if(prevCap != 0u)
                newCap = prevCap * 2u;
            this.m_nodes.resize(newCap);
            this.m_moveIndices.resize(newCap, s_NullIndex);
            for(usize i = prevCap; i < newCap - 1u; ++i){
                this.m_nodes[i].parentOrNext = cast<u32>(i + 1u);
                this.m_nodes[i].height = -1;
            }
            this.m_nodes[newCap - 1u].parentOrNext = s_NullIndex;
            this.m_nodes[newCap - 1u].height = -1;
            this.m_freeList = cast<u32>(prevCap);
        }

        const u32 nodeId = this.m_freeList;
        this.m_freeList = this.m_nodes[nodeId].parentOrNext;
        this.m_nodes[nodeId].parentOrNext = s_NullIndex;
        this.m_nodes[nodeId].child1 = s_NullIndex;
        this.m_nodes[nodeId].child2 = s_NullIndex;
        this.m_nodes[nodeId].height = 0;
        this.m_nodes[nodeId].aabbMinUser.w = s_NullIndex;
        this.m_nodes[nodeId].moved = false;
        this.m_nodes[nodeId].nodeFlags = 0u;
        this.m_moveIndices[nodeId] = s_NullIndex;
        ++this.m_nodeCount;
        return nodeId;
    }

    private void freeNode(in u32 nodeId){
        this.m_nodes[nodeId].parentOrNext = this.m_freeList;
        this.m_nodes[nodeId].height = -1;
        this.m_nodes[nodeId].child1 = s_NullIndex;
        this.m_nodes[nodeId].child2 = s_NullIndex;
        this.m_nodes[nodeId].aabbMinUser.w = s_NullIndex;
        this.m_nodes[nodeId].aabbMaxCategory.w = 0u;
        this.m_nodes[nodeId].moved = false;
        this.m_nodes[nodeId].nodeFlags = 0u;
        this.m_moveIndices[nodeId] = s_NullIndex;
        this.m_freeList = nodeId;
        if(this.m_nodeCount > 0u)
            --this.m_nodeCount;
    }

    private void insertLeaf(in u32 leaf){
        if(this.m_root == s_NullIndex){
            this.m_root = leaf;
            this.m_nodes[leaf].parentOrNext = s_NullIndex;
            return;
        }

        const VectorSingle leafMin(this.m_nodes[leaf].aabbMinUser, 0.0f);
        const VectorSingle leafMax(this.m_nodes[leaf].aabbMaxCategory, 0.0f);
        u32 index = this.m_root;
        while(!this.m_nodes[index].isLeaf()){
            const u32 c1 = this.m_nodes[index].child1;
            const u32 c2 = this.m_nodes[index].child2;
            const VectorSingle idxMin(this.m_nodes[index].aabbMinUser, 0.0f);
            const VectorSingle idxMax(this.m_nodes[index].aabbMaxCategory, 0.0f);
            const VectorSingle c1Min(this.m_nodes[c1].aabbMinUser, 0.0f);
            const VectorSingle c1Max(this.m_nodes[c1].aabbMaxCategory, 0.0f);
            const VectorSingle c2Min(this.m_nodes[c2].aabbMinUser, 0.0f);
            const VectorSingle c2Max(this.m_nodes[c2].aabbMaxCategory, 0.0f);
            const f32 area = AabbPerimeterValues(idxMin, idxMax);

            const f32 combinedArea = AabbPerimeterValues(Min(idxMin, leafMin), Max(idxMax, leafMax));
            const f32 cost = 2.0f * combinedArea;
            const f32 inheritanceCost = 2.0f * (combinedArea - area);

            f32 cost1 = AabbPerimeterValues(Min(leafMin, c1Min), Max(leafMax, c1Max)) + inheritanceCost;
            if(!this.m_nodes[c1].isLeaf())
                cost1 -= AabbPerimeterValues(c1Min, c1Max);

            f32 cost2 = AabbPerimeterValues(Min(leafMin, c2Min), Max(leafMax, c2Max)) + inheritanceCost;
            if(!this.m_nodes[c2].isLeaf())
                cost2 -= AabbPerimeterValues(c2Min, c2Max);

            if(cost < cost1 && cost < cost2)
                break;

            if(cost1 < cost2)
                index = c1;
            else
                index = c2;
        }

        const u32 sibling = index;
        const u32 oldParent = this.m_nodes[sibling].parentOrNext;
        const u32 newParent = this.allocateNode();
        this.m_nodes[newParent].parentOrNext = oldParent;
        this.m_nodes[newParent].setAabbValues(
            Min(leafMin, VectorSingle(this.m_nodes[sibling].aabbMinUser, 0.0f)),
            Max(leafMax, VectorSingle(this.m_nodes[sibling].aabbMaxCategory, 0.0f))
        );
        this.m_nodes[newParent].height = cast<i16>(cast<i32>(this.m_nodes[sibling].height) + 1);

        if(oldParent != s_NullIndex){
            if(this.m_nodes[oldParent].child1 == sibling)
                this.m_nodes[oldParent].child1 = newParent;
            else
                this.m_nodes[oldParent].child2 = newParent;
        }
        else{
            this.m_root = newParent;
        }

        this.m_nodes[newParent].child1 = sibling;
        this.m_nodes[newParent].child2 = leaf;
        this.m_nodes[newParent].aabbMaxCategory.w = this.m_nodes[sibling].categoryBits() | this.m_nodes[leaf].categoryBits();
        this.m_nodes[newParent].nodeFlags = this.m_nodes[sibling].nodeFlags | this.m_nodes[leaf].nodeFlags;
        this.m_nodes[sibling].parentOrNext = newParent;
        this.m_nodes[leaf].parentOrNext = newParent;

        this.syncHierarchy(newParent);
    }

    private void removeLeaf(in u32 leaf){
        if(leaf == this.m_root){
            this.m_root = s_NullIndex;
            return;
        }

        const u32 parent = this.m_nodes[leaf].parentOrNext;
        const u32 grandParent = this.m_nodes[parent].parentOrNext;
        u32 sibling = this.m_nodes[parent].child1;
        if(sibling == leaf)
            sibling = this.m_nodes[parent].child2;

        if(grandParent != s_NullIndex){
            if(this.m_nodes[grandParent].child1 == parent)
                this.m_nodes[grandParent].child1 = sibling;
            else
                this.m_nodes[grandParent].child2 = sibling;
            this.m_nodes[sibling].parentOrNext = grandParent;
            this.freeNode(parent);
            this.syncHierarchy(grandParent);
        }
        else{
            this.m_root = sibling;
            this.m_nodes[sibling].parentOrNext = s_NullIndex;
            this.freeNode(parent);
        }
    }

    private void syncHierarchy(in u32 startNode){
        u32 index = startNode;
        while(index != s_NullIndex){
            index = this.balance(index);
            const u32 c1 = this.m_nodes[index].child1;
            const u32 c2 = this.m_nodes[index].child2;
            this.syncNodePairBounds(index, c1, c2);
            index = this.m_nodes[index].parentOrNext;
        }
    }

    private void syncNodePairBounds(in u32 parent, in u32 leftChild, in u32 rightChild){
        const VectorSingle lower = Min(VectorSingle(this.m_nodes[leftChild].aabbMinUser, 0.0f), VectorSingle(this.m_nodes[rightChild].aabbMinUser, 0.0f));
        const VectorSingle upper = Max(VectorSingle(this.m_nodes[leftChild].aabbMaxCategory, 0.0f), VectorSingle(this.m_nodes[rightChild].aabbMaxCategory, 0.0f));
        this.m_nodes[parent].setAabbValues(lower, upper);
        this.m_nodes[parent].aabbMaxCategory.w = this.m_nodes[leftChild].categoryBits() | this.m_nodes[rightChild].categoryBits();
        this.m_nodes[parent].nodeFlags = this.m_nodes[leftChild].nodeFlags | this.m_nodes[rightChild].nodeFlags;
        this.m_nodes[parent].height = cast<i16>(1 + Max(cast<i32>(this.m_nodes[leftChild].height), cast<i32>(this.m_nodes[rightChild].height)));
    }

    private u32 balance(in u32 iA){
        if(this.m_nodes[iA].isLeaf() || this.m_nodes[iA].height < 2)
            return iA;

        const u32 iB = this.m_nodes[iA].child1;
        const u32 iC = this.m_nodes[iA].child2;
        const i32 heightDiff = cast<i32>(this.m_nodes[iC].height) - cast<i32>(this.m_nodes[iB].height);

        if(heightDiff > 1){
            const u32 iF = this.m_nodes[iC].child1;
            const u32 iG = this.m_nodes[iC].child2;
            this.m_nodes[iC].child1 = iA;
            this.m_nodes[iC].parentOrNext = this.m_nodes[iA].parentOrNext;
            this.m_nodes[iA].parentOrNext = iC;
            if(this.m_nodes[iC].parentOrNext != s_NullIndex){
                if(this.m_nodes[this.m_nodes[iC].parentOrNext].child1 == iA)
                    this.m_nodes[this.m_nodes[iC].parentOrNext].child1 = iC;
                else
                    this.m_nodes[this.m_nodes[iC].parentOrNext].child2 = iC;
            }
            else{
                this.m_root = iC;
            }
            if(this.m_nodes[iF].height > this.m_nodes[iG].height){
                this.m_nodes[iC].child2 = iF;
                this.m_nodes[iA].child2 = iG;
                this.m_nodes[iG].parentOrNext = iA;
                this.syncNodePairBounds(iA, iB, iG);
                this.syncNodePairBounds(iC, iA, iF);
            }
            else{
                this.m_nodes[iC].child2 = iG;
                this.m_nodes[iA].child2 = iF;
                this.m_nodes[iF].parentOrNext = iA;
                this.syncNodePairBounds(iA, iB, iF);
                this.syncNodePairBounds(iC, iA, iG);
            }
            return iC;
        }

        if(heightDiff < -1){
            const u32 iD = this.m_nodes[iB].child1;
            const u32 iE = this.m_nodes[iB].child2;
            this.m_nodes[iB].child1 = iA;
            this.m_nodes[iB].parentOrNext = this.m_nodes[iA].parentOrNext;
            this.m_nodes[iA].parentOrNext = iB;
            if(this.m_nodes[iB].parentOrNext != s_NullIndex){
                if(this.m_nodes[this.m_nodes[iB].parentOrNext].child1 == iA)
                    this.m_nodes[this.m_nodes[iB].parentOrNext].child1 = iB;
                else
                    this.m_nodes[this.m_nodes[iB].parentOrNext].child2 = iB;
            }
            else{
                this.m_root = iB;
            }
            if(this.m_nodes[iD].height > this.m_nodes[iE].height){
                this.m_nodes[iB].child2 = iD;
                this.m_nodes[iA].child1 = iE;
                this.m_nodes[iE].parentOrNext = iA;
                this.syncNodePairBounds(iA, iC, iE);
                this.syncNodePairBounds(iB, iA, iD);
            }
            else{
                this.m_nodes[iB].child2 = iE;
                this.m_nodes[iA].child1 = iD;
                this.m_nodes[iD].parentOrNext = iA;
                this.syncNodePairBounds(iA, iC, iD);
                this.syncNodePairBounds(iB, iA, iE);
            }
            return iB;
        }

        return iA;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

