////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<tests/common/gtest_runtime.h>"), cpp_name("::NWB::Tests::GoogleTestArguments")]
extern class GoogleTestArguments{
    void writeError(in StringView text)const;
    void initialize()const;
    void setDeathTestStyle(in StringView style)const;
    i32 run()const;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_ThreadsafeDeathTestStyle = "threadsafe";
const i32 s_GoogleTestInitFailureExitCode = -1;

i32 GoogleTestEntryPoint(in GoogleTestArguments arguments){
    InitializerGuard guard;
    if(!guard.initialize()){
        arguments.writeError("test common initialization failed\n");
        return s_GoogleTestInitFailureExitCode;
    }
    arguments.initialize();
    arguments.setDeathTestStyle(s_ThreadsafeDeathTestStyle);
    return arguments.run();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

