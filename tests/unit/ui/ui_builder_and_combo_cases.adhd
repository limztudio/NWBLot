void VerifyUiBuilderTextShapingTests_InvalidPolicyPreservesPreviousShapingAndOpenScopeMutationFails(mut UiBuilderTextShapingTests self){
    ASSERT_TRUE(self.installKoreanFallback());
    self.addEditRegion();
    ASSERT_TRUE(self.m_skin.validatePayload());
    ASSERT_TRUE(self.m_builder.setTextShaping(MakeUiBuilderHangScriptTag(), "ko"));
    EXPECT_FALSE(self.m_builder.setTextShaping(0u, "ko"));
    EXPECT_FALSE(self.m_builder.setTextShaping(MakeUiBuilderLatnScriptTag(), "ko!"));
    ASSERT_FALSE(self.m_builder.failed());
    EditModel model = EditModel(self.m_arena);
    ASSERT_TRUE(model.setText(s_UiBuilderTextShapingJamo));
    EditBoxState state = EditBoxState();

    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginPanel("panel", MakeUiBuilderRect(0.0f, 0.0f, 400.0f, 180.0f)));
    ASSERT_TRUE(self.m_builder.label("label", s_UiBuilderTextShapingJamo));
    ASSERT_TRUE(self.m_builder.editBox("edit", model, state).valid);
    ASSERT_TRUE(self.finishPanel());
    const DrawSnapshot snapshot = self.m_paint.freeze();
    EXPECT_EQ(CountUiBuilderTextShapingGlyphQuads(snapshot), 2u);
    ASSERT_TRUE(self.m_context.commitFrame(1u));

    ASSERT_TRUE(self.begin(2u));
    ASSERT_TRUE(self.m_builder.beginPanel("panel", MakeUiBuilderRect(0.0f, 0.0f, 400.0f, 100.0f)));
    EXPECT_FALSE(self.m_builder.setTextShaping(MakeUiBuilderLatnScriptTag(), "en"));
    EXPECT_TRUE(self.m_builder.failed());
    EXPECT_FALSE(self.m_builder.endPanel());
}


