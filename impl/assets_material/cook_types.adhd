b8 IsAllowedMaterialAssetField(in StringView fieldName){
    return fieldName == s_MaterialMetaInterfaceField
        || fieldName == s_MaterialMetaSurfaceField
        || fieldName == s_MaterialMetaShadersField
        || fieldName == s_MaterialMetaShaderVariantField
        || fieldName == s_MaterialMetaParametersField
        || fieldName == s_MaterialMetaTransparentField
        || fieldName == s_MaterialMetaTwoSidedField
        || fieldName == s_MaterialMetaRefractiveField
        || fieldName == s_MaterialMetaBxdfField;
}

class MaterialParameterType{
    public MaterialParameterValueType valueType = MaterialParameterValueType::None;
    public u32 componentCount = 0u;
}

b8 TryParseMaterialParameterBaseTypeText(in StringView baseTypeText, mut MaterialParameterValueType outValueType){
    switch(baseTypeText){
        case "bool":
            outValueType = MaterialParameterValueType::b8;
            return true;
        case "char":
            outValueType = MaterialParameterValueType::i8;
            return true;
        case "uchar":
            outValueType = MaterialParameterValueType::u8;
            return true;
        case "short":
            outValueType = MaterialParameterValueType::i16;
            return true;
        case "ushort":
            outValueType = MaterialParameterValueType::u16;
            return true;
        case "int":
            outValueType = MaterialParameterValueType::i32;
            return true;
        case "uint":
            outValueType = MaterialParameterValueType::u32;
            return true;
        case "half":
            outValueType = MaterialParameterValueType::f16;
            return true;
        case "float":
            outValueType = MaterialParameterValueType::f32;
            return true;
        default:
            outValueType = MaterialParameterValueType::None;
            return false;
    }
}

b8 TryParseMaterialParameterTypeText(in StringView typeText, mut MaterialParameterType outType){
    outType = MaterialParameterType();
    if(typeText.empty())
        return false;

    MaterialParameterValueType valueType = MaterialParameterValueType::None;
    if(TryParseMaterialParameterBaseTypeText(typeText, valueType)){
        outType.valueType = valueType;
        outType.componentCount = 1u;
        return true;
    }

    if(typeText.size() > 1u){
        const u8 suffix = cast<u8>(typeText[typeText.size() - 1u]);
        if(suffix >= 50u && suffix <= 52u){
            if(TryParseMaterialParameterBaseTypeText(typeText.substr(0u, typeText.size() - 1u), valueType)){
                outType.valueType = valueType;
                outType.componentCount = cast<u32>(suffix - 48u);
                return true;
            }
        }
    }

    return false;
}

b8 TryParseMaterialBindResourceFieldTypeText(in StringView typeText, mut MaterialLayoutFieldType outFieldType){
    if(typeText == s_MaterialBindFieldTypeTexture2D){
        outFieldType = MaterialLayoutFieldType::SampledImage2D;
        return true;
    }
    if(typeText == s_MaterialBindFieldTypeSampler){
        outFieldType = MaterialLayoutFieldType::Sampler;
        return true;
    }
    outFieldType = MaterialLayoutFieldType::None;
    return false;
}

b8 TryParseMaterialLayoutFieldTypeText(in StringView typeText, mut MaterialLayoutFieldType outFieldType){
    if(TryParseMaterialBindResourceFieldTypeText(typeText, outFieldType))
        return true;

    MaterialParameterType paramType;
    if(!TryParseMaterialParameterTypeText(typeText, paramType)){
        outFieldType = MaterialLayoutFieldType::None;
        return false;
    }

    const MaterialLayoutFieldType fieldType = MaterialLayoutFieldTypeFromParameterType(paramType.valueType, paramType.componentCount);
    if(!IsValidMaterialLayoutFieldType(fieldType)){
        outFieldType = MaterialLayoutFieldType::None;
        return false;
    }

    outFieldType = fieldType;
    return true;
}

StringView MaterialBindFieldLookupFunctionStorageName(in MaterialBlockClass blockClass){
    switch(blockClass){
        case MaterialBlockClass::MaterialConstant:
            return "Constant";
        case MaterialBlockClass::MaterialMutable:
            return "Mutable";
        default:
            return "";
    }
}

StringView MaterialBindFieldLookupFunctionTypeName(in MaterialLayoutFieldType fieldType){
    switch(fieldType){
        case MaterialLayoutFieldType::b8: return "Bool";
        case MaterialLayoutFieldType::b8x2: return "Bool2";
        case MaterialLayoutFieldType::b8x3: return "Bool3";
        case MaterialLayoutFieldType::b8x4: return "Bool4";
        case MaterialLayoutFieldType::i8: return "Char";
        case MaterialLayoutFieldType::i8x2: return "Char2";
        case MaterialLayoutFieldType::i8x3: return "Char3";
        case MaterialLayoutFieldType::i8x4: return "Char4";
        case MaterialLayoutFieldType::u8: return "UChar";
        case MaterialLayoutFieldType::u8x2: return "UChar2";
        case MaterialLayoutFieldType::u8x3: return "UChar3";
        case MaterialLayoutFieldType::u8x4: return "UChar4";
        case MaterialLayoutFieldType::i16: return "Short";
        case MaterialLayoutFieldType::i16x2: return "Short2";
        case MaterialLayoutFieldType::i16x3: return "Short3";
        case MaterialLayoutFieldType::i16x4: return "Short4";
        case MaterialLayoutFieldType::u16: return "UShort";
        case MaterialLayoutFieldType::u16x2: return "UShort2";
        case MaterialLayoutFieldType::u16x3: return "UShort3";
        case MaterialLayoutFieldType::u16x4: return "UShort4";
        case MaterialLayoutFieldType::i32: return "Int";
        case MaterialLayoutFieldType::i32x2: return "Int2";
        case MaterialLayoutFieldType::i32x3: return "Int3";
        case MaterialLayoutFieldType::i32x4: return "Int4";
        case MaterialLayoutFieldType::u32: return "UInt";
        case MaterialLayoutFieldType::u32x2: return "UInt2";
        case MaterialLayoutFieldType::u32x3: return "UInt3";
        case MaterialLayoutFieldType::u32x4: return "UInt4";
        case MaterialLayoutFieldType::f16: return "Half";
        case MaterialLayoutFieldType::f16x2: return "Half2";
        case MaterialLayoutFieldType::f16x3: return "Half3";
        case MaterialLayoutFieldType::f16x4: return "Half4";
        case MaterialLayoutFieldType::f32: return "Float";
        case MaterialLayoutFieldType::f32x2: return "Float2";
        case MaterialLayoutFieldType::f32x3: return "Float3";
        case MaterialLayoutFieldType::f32x4: return "Float4";
        default: return "";
    }
}

StringView MaterialBindResourceSlangTypeName(in MaterialLayoutFieldType fieldType){
    switch(fieldType){
        case MaterialLayoutFieldType::SampledImage2D:
            return "Texture2D<float4>";
        case MaterialLayoutFieldType::Sampler:
            return "SamplerState";
        default:
            return "";
    }
}

StringView MaterialBindResourceHeapAccessorName(in MaterialLayoutFieldType fieldType){
    switch(fieldType){
        case MaterialLayoutFieldType::SampledImage2D:
            return "nwbHeapSampledImage2DNonUniform";
        case MaterialLayoutFieldType::Sampler:
            return "nwbHeapSamplerNonUniform";
        default:
            return "";
    }
}


