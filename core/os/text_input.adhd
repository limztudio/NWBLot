[cpp_header("<core/os/text_input.h>"), cpp_name("::NWB::Core::s_TextInputMaxEventTextBytes")]
extern const usize s_TextInputMaxEventTextBytes;
[cpp_header("<core/os/text_input.h>"), cpp_name("::NWB::Core::s_TextInputMaxEvents")]
extern const usize s_TextInputMaxEvents;
[cpp_header("<core/os/text_input.h>"), cpp_name("::NWB::Core::s_TextInputMaxQueuedTextBytes")]
extern const usize s_TextInputMaxQueuedTextBytes;
[cpp_header("<core/os/text_input.h>"), cpp_name("::NWB::Core::s_TextInputMaxSurroundingBytes")]
extern const usize s_TextInputMaxSurroundingBytes;


