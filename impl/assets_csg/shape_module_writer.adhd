////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_csg/cook.adhd>
#include <impl/assets_csg/shape_module_source.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateUniqueCsgShapeName(in b8 inserted, in Name shapeName){
    if(inserted)
        return true;

    error("CSG shape include generation: duplicate shape '{}'", shapeName.resolvedText());
    return false;
}

b8 ValidateSharedCsgGeneratedIncludeOwner(
    in b8 inserted,
    in Name existingModule,
    in Name currentModule,
    in StringView moduleInclude
){
    if(!IsSharedCsgGeneratedIncludeConflict(inserted, existingModule, currentModule))
        return true;

    error(
        "CSG shape include generation: generated include '{}' is shared by modules '{}' and '{}'"
        , moduleInclude
        , existingModule.resolvedText()
        , currentModule.resolvedText()
    );
    return false;
}

Path ResolveCsgModuleOutputPath(in Path includeRoot, in StringView moduleInclude){
    return includeRoot / moduleInclude;
}

Path ResolveDefaultCsgModuleOutputPath(in Path includeRoot){
    return includeRoot / s_DefaultGeneratedIncludeDirectory / s_CsgBuiltInModuleIncludeFileName;
}

b8 WriteCsgGeneratedIncludeFile(in Path outputPath, in StringView source){
    const Path parentPath = outputPath.parentPath();
    const auto ensureResult = EnsureDirectories(parentPath);
    if(!ensureResult.has_value()){
        error("CSG shape include generation: failed to create generated include parent '{}' (error {})", parentPath, ensureResult.error().value());
        return false;
    }
    if(!WriteTextFile(outputPath, source)){
        error("CSG shape include generation: failed to write generated include '{}'", outputPath);
        return false;
    }
    return true;
}

b8 WriteEmptyDefaultCsgModuleInclude(in Path includeRoot){
    return WriteCsgGeneratedIncludeFile(ResolveDefaultCsgModuleOutputPath(includeRoot), s_CsgEmptyGeneratedModule);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class CsgShapeModuleWriter{
    public Expected<Path> emit(in Path cacheDirectory, in StringView configuration, in Span<CsgShapeCookEntry> entries)const{
        Path root = cacheDirectory / configuration / s_GeneratedIncludeCacheDirectory;
        if(entries.empty()){
            if(!PrepareGeneratedIncludeRoot(root, s_CsgShapeIncludeGenerationLabel) || !WriteEmptyDefaultCsgModuleInclude(root))
                return MakeUnexpected(Failure());
            return root;
        }

        HashSet<NameHash> shapes;
        shapes.reserve(entries.size());
        for(in CsgShapeCookEntry entry : entries){
            if(!ValidateUniqueCsgShapeName(shapes.insert(entry.shapeName.hash()).second, entry.shapeName))
                return MakeUnexpected(Failure());
        }

        HashSet<NameHash> modules;
        HashMap<String, Name> owners;
        modules.reserve(entries.size());
        owners.reserve(entries.size());
        usize capacity = 0u;
        for(in CsgShapeCookEntry module : entries){
            if(!modules.insert(module.shaderModule.hash()).second)
                continue;
            usize bytes = s_CsgModuleSourceHeader.size();
            for(in CsgShapeCookEntry entry : entries){
                if(entry.shaderModule != module.shaderModule)
                    continue;
                bytes = AddSize(bytes, AddSize(s_FixedShapeSourceBytes, entry.evalInclude.size()));
                if(!ValidateCsgModuleIncludeConsistency(module.shaderModule, module.moduleInclude, entry.moduleInclude))
                    return MakeUnexpected(Failure());
            }
            capacity = Max(capacity, bytes);
            String path = module.moduleInclude;
            CanonicalizeTextInPlace(path);
            const auto owner = owners.try_emplace(path, module.shaderModule);
            if(!ValidateSharedCsgGeneratedIncludeOwner(owner.second, owner.first.value(), module.shaderModule, module.moduleInclude))
                return MakeUnexpected(Failure());
        }
        if(!PrepareGeneratedIncludeRoot(root, s_CsgShapeIncludeGenerationLabel))
            return MakeUnexpected(Failure());
        modules.clear();
        String source;
        source.reserve(capacity);
        for(in CsgShapeCookEntry module : entries){
            if(!modules.insert(module.shaderModule.hash()).second)
                continue;
            CsgShapeModuleSource().begin(source);
            for(in CsgShapeCookEntry entry : entries){
                if(entry.shaderModule == module.shaderModule)
                    CsgShapeModuleSource().appendEval(entry.shapeTypeId, entry.evalInclude, source);
            }
            if(!WriteCsgGeneratedIncludeFile(ResolveCsgModuleOutputPath(root, module.moduleInclude), source))
                return MakeUnexpected(Failure());
        }
        return root;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

