Expected<MaterialBinaryTypedLayoutOffsets> FindTestMaterialBinaryTypedLayoutOffsets(in AssetBytes binary){
    const Span<u8> bytes(binary);
    usize cursor = 0u;
    const auto magic = ReadPOD<u32>(bytes, cursor);
    if(!magic.has_value() || magic.value() != s_MaterialBinaryMagic)
        return MakeUnexpected(Failure());
    const auto variant = ReadString(bytes, cursor);
    if(!variant.has_value() || variant.value().empty())
        return MakeUnexpected(Failure());
    const auto material = ReadPOD<NameHash>(bytes, cursor);
    if(!material.has_value() || !Name(material.value()))
        return MakeUnexpected(Failure());
    const usize start = cursor;
    const auto hash = ReadPOD<u64>(bytes, cursor);
    if(!hash.has_value() || hash.value() == 0u)
        return MakeUnexpected(Failure());
    const auto blocks = ReadPOD<u32>(bytes, cursor);
    if(!blocks.has_value())
        return MakeUnexpected(Failure());
    const auto fields = ReadPOD<u32>(bytes, cursor);
    if(!fields.has_value() || blocks.value() > (bytes.size() - cursor) / s_MaterialTypedLayoutBlockBytes)
        return MakeUnexpected(Failure());
    cursor += cast<usize>(blocks.value()) * s_MaterialTypedLayoutBlockBytes;
    if(fields.value() > (bytes.size() - cursor) / s_MaterialTypedLayoutFieldBytes)
        return MakeUnexpected(Failure());
    if(!SkipBytes(bytes, cast<usize>(fields.value()) * s_MaterialTypedLayoutFieldBytes, cursor))
        return MakeUnexpected(Failure());
    MaterialBinaryTypedLayoutOffsets result;
    result.layoutHashOffset = start;
    result.blockByteCountOffset = cursor;
    return result;
}

