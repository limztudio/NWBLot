// Ray-tracing domain owns live scene/material tables; effects retain this snapshot post-preflight plus frozen geometry/texture bundles.
// Schedulable != dispatchable: scene prep must also succeed.
class RayTracingSceneGraphResources{
    public RayTracingSceneContentStamp contentStamp;
    public RayTracingAccelStructHandle sceneTlas;
    public GpuDescriptorHandle tlasHeapHandle;
    public BufferHandle materialContextSlotsBuffer;
    public BufferHandle instanceMaterialBuffer;
    public BufferHandle materialTypedBuffer;
    public BufferHandle instanceBuffer;
    public BufferHandle csgTraceContextBuffer;
    public Span<BufferHandle> csgTraceBoundsBuffers;
    public RayTracingOpticalSceneSnapshot opticalScene;
    public u32 materialContextSlotsHeapSlot = 0u;
    public b8 hardwareAvailable = false;

    public b8 valid()const{
        return this.hardwareAvailable
            && this.sceneTlas.valid()
            && this.tlasHeapHandle.valid()
            && this.materialContextSlotsBuffer.valid()
            && this.instanceMaterialBuffer.valid()
            && this.materialTypedBuffer.valid()
            && this.instanceBuffer.valid()
            && this.opticalScene.valid();
    }
}

class RayTracingSceneGraphReads{
    // Ordinary scene reads remain inline; only admitted CSG work allocates the variable posed-bounds list.
    public Array<GpuTaskResourceUse, s_FixedSceneResourceUseCount> uses;
    public Vector<GpuTaskResourceUse> csgUses;

    public b8 valid()const{
        for(usize index = 0u; index < this.uses.size(); ++index){
            if(!this.uses[index].resource.valid())
                return false;
        }
        for(usize index = 0u; index < this.csgUses.size(); ++index){
            if(!this.csgUses[index].resource.valid())
                return false;
        }
        return true;
    }
}

class TraceResourceSetUses{
    // Trace geometry set and trace material sampled-texture set.
    public Array<GpuTaskResourceSetUse, s_TraceResourceSetUseCapacity> uses;
    public usize useCount = 0u;
}

TraceResourceSetUses MakeTraceResourceSetUses(in GpuGraphResourceSetId traceGeometrySet, in GpuGraphResourceSetId traceMaterialSampledTextureSet){
    TraceResourceSetUses result;
    if(traceGeometrySet.valid()){
        GpuTaskResourceSetUse use;
        use.resourceSet = traceGeometrySet;
        use.requiredState = ResourceStates::ShaderResource;
        use.access = GpuTaskResourceAccess::Read;
        result.uses[result.useCount++] = use;
    }
    if(traceMaterialSampledTextureSet.valid()){
        GpuTaskResourceSetUse use;
        use.resourceSet = traceMaterialSampledTextureSet;
        use.requiredState = ResourceStates::ShaderResource;
        use.access = GpuTaskResourceAccess::Read;
        result.uses[result.useCount++] = use;
    }
    return result;
}


