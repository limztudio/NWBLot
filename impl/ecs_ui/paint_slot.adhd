#include <impl/ecs_ui/paint_context.adhd>
#include <impl/ecs_ui/toolkit/paint_primitives.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static_assert(s_PaintCallbackInlineBytes == 64u);
type UiPaintCallback = Func<64u, void(mut UiPaintContext)>;

class UiPaintLease : NoCopy{
    private LinkedSlot<UiPaintCallback> m_running = LinkedSlot<UiPaintCallback>();

    public UiPaintLease(mut LinkedSlot<UiPaintCallback> owner){
        this.m_running.takeFrom(owner);
        this.m_running.connect(owner);
    }

    public ~UiPaintLease(){
        if(this.m_running.linked())
            this.m_running.peer().takeFrom(this.m_running);
    }

    [cpp_unwind]
    public void invoke(mut UiPaintContext context){
        this.m_running.value()(context);
    }
}

class UiPaintSlot{
    private LinkedSlot<UiPaintCallback> m_slot = LinkedSlot<UiPaintCallback>();

    [cpp_take_assignment]
    public void setCallback(mut UiPaintCallback callback){
        this.m_slot.disconnect();
        if(cast<b8>(callback))
            TakeLinkedSlotValue<UiPaintCallback>(this.m_slot, callback);
        else
            this.m_slot.resetValue();
    }

    [cpp_explicit_bool]
    public b8 callable()const{ return this.m_slot.hasValue(); }

    public b8 present()const{ return this.callable() || this.m_slot.linked(); }

    public void reset(){
        this.m_slot.disconnect();
        this.m_slot.resetValue();
    }

    [cpp_unwind]
    public void invoke(mut UiPaintContext context){
        if(!this.callable() || this.m_slot.linked())
            TerminateInvariant();
        UiPaintLease lease(this.m_slot);
        lease.invoke(context);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

