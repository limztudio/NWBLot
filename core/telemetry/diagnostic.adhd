[cpp_header("<core/telemetry/diagnostic.h>"), cpp_name("::NWB::Core::Telemetry::DiagnosticPayloadFlag::Mask")]
extern enum DiagnosticPayloadFlag : u16{
    None,
    TerminatesProcess
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<core/telemetry/diagnostic.h>"), cpp_name("::NWB::Core::Telemetry::DiagnosticCaptureGuard"), cpp_layout(48, 8), cpp_flags(no_copy, no_assign)]
extern class DiagnosticCaptureGuard{
    void capture(...);
    u64 frameIndex(...)const;
    b8 installed(...)const;
    void setFrameIndex(...);
    void setStreamId(...);
    u32 streamId(...)const;
};

[cpp_header("<core/telemetry/diagnostic.h>"), cpp_name("::NWB::Core::Telemetry::DiagnosticPayload"), cpp_layout(96, 8), cpp_flags(self_defaulted, binary_serializable, brace_init)]
extern class DiagnosticPayload{
    StringView event;
    StringView category;
    StringView expression;
    StringView message;
    StringView file;
    u64 instructionPointer;
    u32 line;
    b8 terminatesProcess;
};

[cpp_header("<core/telemetry/diagnostic.h>"), cpp_name("::NWB::Core::Telemetry::EncodedDiagnosticPayloadHeader"), cpp_layout(40, 1), cpp_flags(self_defaulted, binary_serializable, brace_init)]
extern class EncodedDiagnosticPayloadHeader{
    u32 magic;
    u16 version;
    u16 flags;
    u64 instructionPointer;
    u32 line;
    u32 eventBytes;
    u32 categoryBytes;
    u32 expressionBytes;
    u32 messageBytes;
    u32 fileBytes;
};


