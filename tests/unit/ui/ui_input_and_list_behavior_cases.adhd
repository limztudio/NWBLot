void VerifyUiListBuilderScrollbarTests_PopupListsAutofocusAndRestoreEachCoveredListHost(mut UiListBuilderTests self){
    self.m_state.select(1u);
    ASSERT_TRUE(self.accept(1u));
    self.press(CoreKey::Tab);
    EXPECT_EQ(self.m_context.input().focus(), self.id(s_UiListScrollbarListKey, s_UiListScrollbarPanelKey));
    PopupState lowerPopup = PopupState();
    PopupState upperPopup = PopupState();
    ListState lowerState = ListState();
    ListState upperState = ListState();
    lowerState.select(2u);
    upperState.select(3u);
    lowerPopup.open();
    ASSERT_TRUE(UiListScrollbarPrepareSinglePopup(self, 2u, lowerPopup, lowerState));
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    const WidgetId lowerHost = self.id(s_UiListScrollbarListKey, s_UiListScrollbarPopupKey);
    EXPECT_EQ(self.m_context.input().focus(), lowerHost);
    upperPopup.open();
    ASSERT_TRUE(UiListScrollbarPrepareTwoPopups(self, 3u, lowerPopup, lowerState, upperPopup, upperState));
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    EXPECT_EQ(self.m_context.input().focus(), self.id(s_UiListScrollbarListKey, s_UiListScrollbarUpperPopupKey));
    self.press(CoreKey::Down);
    ASSERT_TRUE(UiListScrollbarPrepareTwoPopups(self, 4u, lowerPopup, lowerState, upperPopup, upperState));
    EXPECT_EQ(upperState.selectedKey(), 4u);
    EXPECT_EQ(lowerState.selectedKey(), 2u);
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    ASSERT_TRUE(self.m_context.commitFrame(4u));
    upperPopup.close();
    ASSERT_TRUE(UiListScrollbarPrepareTwoPopups(self, 5u, lowerPopup, lowerState, upperPopup, upperState));
    ASSERT_TRUE(self.m_context.commitFrame(5u));
    EXPECT_EQ(self.m_context.input().focus(), lowerHost);
    self.press(CoreKey::Down);
    ASSERT_TRUE(UiListScrollbarPrepareTwoPopups(self, 6u, lowerPopup, lowerState, upperPopup, upperState));
    EXPECT_EQ(lowerState.selectedKey(), 3u);
    ASSERT_TRUE(self.m_context.commitFrame(6u));
    lowerPopup.close();
    ASSERT_TRUE(UiListScrollbarPrepareSinglePopup(self, 7u, lowerPopup, lowerState));
    ASSERT_TRUE(self.m_context.commitFrame(7u));
    EXPECT_EQ(self.m_context.input().focus(), self.id(s_UiListScrollbarListKey, s_UiListScrollbarPanelKey));
    self.press(CoreKey::Down);
    ASSERT_TRUE(self.prepare(8u));
    EXPECT_EQ(self.m_state.selectedKey(), 2u);
}

void VerifyUiListBuilderScrollbarTests_TwoCompletedThumbDragsAreConsumedInOneDeclarationUsingTheirOwnBaseline(mut UiListBuilderTests self){
    ASSERT_TRUE(self.accept(1u));
    const WidgetId thumb = UiListScrollbarRequireWidgetId(self.id(s_UiListScrollbarListKey, s_UiListScrollbarPanelKey), s_UiListScrollbarKey);
    const Optional<HitTarget> acceptedOpt = FindUiListScrollbarTarget(self, thumb);
    ASSERT_TRUE(acceptedOpt.has_value());
    const HitTarget accepted = acceptedOpt.value();
    const Point origin = UiListScrollbarCenter(accepted.rectangle);
    self.drag(origin, Point(origin.x, origin.y + 10.0f));
    self.drag(origin, Point(origin.x, origin.y + 20.0f));
    ASSERT_TRUE(self.prepare(2u));
    const f64 travel = cast<f64>(accepted.gestureReference.height) - cast<f64>(accepted.rectangle.height);
    EXPECT_DOUBLE_EQ(self.m_state.scrollOffset(), (20.0 / travel) * accepted.gestureMaximum);
    EXPECT_FALSE(self.m_context.input().consumePointerGesture(thumb, accepted.declarationGeneration).has_value());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_context.input().focus(), self.id(s_UiListScrollbarListKey, s_UiListScrollbarPanelKey));
}

void VerifyUiListBuilderScrollbarTests_FullHeightMinimumThumbFocusesItsHostWithoutStartingAnUnusableGesture(mut UiListBuilderTests self){
    ListOptions options = MakeUiListScrollbarDefaultOptions();
    options.height.value = 20.0f;
    ASSERT_TRUE(self.accept(1u, options));
    const WidgetId thumb = UiListScrollbarRequireWidgetId(self.id(s_UiListScrollbarListKey, s_UiListScrollbarPanelKey), s_UiListScrollbarKey);
    const Optional<HitTarget> acceptedOpt = FindUiListScrollbarTarget(self, thumb);
    ASSERT_TRUE(acceptedOpt.has_value());
    const HitTarget accepted = acceptedOpt.value();
    EXPECT_FLOAT_EQ(self.m_state.placement().track.height, self.m_state.placement().thumb.height);
    EXPECT_FALSE(accepted.pointerGesture);
    self.click(UiListScrollbarCenter(accepted.rectangle));
    EXPECT_EQ(self.m_context.input().focus(), self.id(s_UiListScrollbarListKey, s_UiListScrollbarPanelKey));
    EXPECT_FALSE(self.m_context.input().consumePointerGesture(thumb, accepted.declarationGeneration).has_value());
    ASSERT_TRUE(self.prepare(2u, options));
    EXPECT_TRUE(self.m_result.valid);
    EXPECT_TRUE(self.m_result.focused);
    EXPECT_FALSE(self.m_result.activated);
    EXPECT_DOUBLE_EQ(self.m_state.scrollOffset(), 0.0);
    EXPECT_FALSE(self.m_context.failed());
}


