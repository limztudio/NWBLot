void ReadTelemetryPod<T>(in TelemetryBytes payload, in usize byteOffset, mut T outValue){
    usize offset = byteOffset;
    outValue = ReadPOD<T>(ByteOutputView(payload), offset).value();
}
void WriteTelemetryPod<T>(mut Span<u8> payload, in usize offset, in T value){
    if(!OverwritePOD<T>(offset, value, payload))
        assert(false, "Telemetry value exceeds the test buffer");
}
b8 RecordBinarySpan(mut TelemetryRecorder recorder, in EventKind kind, in u64 frameIndex, in Span<u8> payload, in usize byteCount, in u32 streamId){
    return recorder.recordBinary(kind, frameIndex, TestArrayData<u8>(payload), byteCount, streamId);
}
Optional<EventHeader> EventHeaderAtOpt(in EventView events, in usize index){
    const auto record = events.borrowEventAt(index);
    if(record.has_value())
        return record.value().header;
    return Optional<EventHeader>();
}
usize EventRecordAddressAtValue(in EventView events, in usize index){
    const auto record = events.borrowEventAt(index);
    if(record.has_value())
        return ObjectAddressKey(record.value());
    return 0u;
}
Optional<usize> EventPayloadCapacityAtOpt(in EventView events, in usize index){
    const auto record = events.borrowEventAt(index);
    if(record.has_value())
        return record.value().payload.capacity();
    return Optional<usize>();
}
Optional<Span<u8>> EventPayloadSpanAtOpt(in EventView events, in usize index){
    const auto record = events.borrowEventAt(index);
    if(record.has_value())
        return Optional<Span<u8>>(ByteOutputView(record.value().payload));
    return Optional<Span<u8>>();
}
