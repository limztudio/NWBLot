////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void LogDeferredBindlessHeapMissing(){
    error("RendererSystem: deferred lighting/compositor requires the global descriptor heap");
}

void LogDeferredBindlessRegistrationFailed(){
    error("RendererSystem: failed to register deferred frame resources in the descriptor heap");
}

void LogDeferredBindlessSlotBufferCreateFailed(){
    error("RendererSystem: failed to create deferred bindless slot buffer");
}

void LogDeferredBindlessSlotBufferRegisterFailed(){
    error("RendererSystem: failed to register deferred bindless slot buffer in the descriptor heap");
}


