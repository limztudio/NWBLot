////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/global.adhd>
#include <impl/assets_font/prepared_source.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Stores one static, scalable SFNT face from a prepared font source; shaping and glyph atlases stay outside this asset.
[arena, asset("font")]
class Font{
    private Vector<u8> m_fontBytes;
    private u32 m_faceIndex = 0u;

    public b8 loadBinary(in Span<u8> binary);
    public b8 validatePayload()const;

    public void setFontBytes(in Vector<u8> bytes, in u32 faceIndex){
        this.m_fontBytes = bytes;
        this.m_faceIndex = faceIndex;
    }

    public void setFontBytes(in Vector<u8> bytes){
        this.m_fontBytes = bytes;
        this.m_faceIndex = 0u;
    }

    public in Vector<u8> fontBytes()const{ return this.m_fontBytes; }

    public u32 faceIndex()const{ return this.m_faceIndex; }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateFontSource(in Vector<u8> bytes, in u32 faceIndex){
    if(!ValidateFontSourceDirectory(bytes, faceIndex))
        return false;

    FreeTypeFace validator(bytes);
    const i32 libraryError = validator.createLibrary();
    if(libraryError != 0){
        ReportNativeFontFailure(MakeNativeFontFailure(s_FontOpFtNewLibrary, libraryError));
        return false;
    }
    validator.addDefaultModules();

    Expected<void, NativeFontFailure> validation = Expected<void, NativeFontFailure>();
    Func<64u, void(mut FreeTypeFaceView)> inspect = lambda[mut validation](mut FreeTypeFaceView face) -> void{
        if(!IsAdmittedStaticScalableFontFace(face.faceCount(), face.glyphCount(), face.unitsPerEm(), face.isSfnt(), face.isScalable(), face.hasMultipleMasters())){
            validation = MakeUnexpected(MakeNativeFontPolicyFailure(s_FontOpAdmitStaticScalableFace));
            return;
        }
        const i32 charmapError = face.selectUnicodeCharmap();
        if(charmapError != 0)
            validation = MakeUnexpected(MakeNativeFontFailure(s_FontOpFtSelectCharmap, charmapError));
    };
    const FreeTypeFaceVisitResult visit = validator.visitMemoryFace(bytes, 0, inspect);
    if(visit.openError != 0)
        validation = MakeUnexpected(MakeNativeFontFailure(s_FontOpFtNewMemoryFace, visit.openError));

    const i32 cleanupError = validator.closeLibrary();
    ReportFontCleanupFailure(s_FontOpFtDoneFace, visit.closeError);
    ReportFontCleanupFailure(s_FontOpFtDoneLibrary, cleanupError);
    if(!validation.has_value()){
        ReportNativeFontFailure(validation.error());
        return false;
    }
    return true;
}

b8 ValidateFontSource(in Vector<u8> bytes){
    return ValidateFontSource(bytes, 0u);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

