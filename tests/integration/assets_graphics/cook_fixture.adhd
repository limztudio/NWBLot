struct PathFixture{
    Core::Assets::AssetArena arena{ Name(s_AssetCaseTestsAssetPathInputs) };
    const NWB::Path assetRoot{ arena, "tests/asset_path/assets" };
    AString<Core::Assets::AssetArena> relativeText{ arena };
    AString<Core::Assets::AssetArena> expectedRelative{ arena };
    NWB::Path relativePath{ arena };
    NWB::Path sourcePath{ arena };
    AString<Core::Assets::AssetArena> expectedDerived{ arena };
};

struct RelativeCase{
    AStringView input;
    AStringView expected;
    b8 accepted;
};

FOUNDATION_INLINE void PrepareAssetPathWorkload(const usize directoryCount, const AStringView directoryToken, const usize tokenRepeats, PathFixture& fixture){
    const usize directoryBytes = directoryToken.size() * tokenRepeats;
    fixture.relativeText.reserve(directoryCount * (directoryBytes + 1u) + 32u);
    for(usize directory = 0u; directory < directoryCount; ++directory){
        for(usize token = 0u; token < tokenRepeats; ++token)
            fixture.relativeText.append(directoryToken.data(), directoryToken.size());
        fixture.relativeText += '/';
    }
    fixture.relativeText += "Model.LOD0.NWB";
    fixture.relativePath = NWB::Path(fixture.arena, AStringView(fixture.relativeText));
    fixture.sourcePath = fixture.assetRoot / fixture.relativePath;
    fixture.expectedRelative = fixture.relativeText;
    CanonicalizeTextInPlace(fixture.expectedRelative);
    fixture.expectedDerived.reserve(8u + fixture.expectedRelative.size());
    fixture.expectedDerived = "project/";
    fixture.expectedDerived.append(fixture.expectedRelative.data(), fixture.expectedRelative.size() - 4u);
}

[[nodiscard]] FOUNDATION_INLINE b8 BuildAndVerifyDerivedAssetPath(const PathFixture& fixture, Core::Alloc::ScratchArena& scratchArena){
    const auto output = Core::Assets::AssetPathsDetail::BuildDerivedAssetVirtualPathText(fixture.assetRoot, AStringView("project"), fixture.sourcePath, scratchArena, scratchArena);
    return output && AStringView(*output) == AStringView(fixture.expectedDerived);
}

template<typename StringT>
[[nodiscard]] inline constexpr AStringView ViewArenaString(const StringT& text)noexcept{
    return AStringView(text.data(), text.size());
}

template<typename StringT>
[[nodiscard]] FOUNDATION_INLINE b8 HasTrailingNullTerminator(const StringT& text)noexcept{
    return text.c_str()[text.size()] == '\0';
}

template<typename StringT>
FOUNDATION_INLINE void AppendRepeatedAsciiByte(StringT& text, const usize count, const u8 byte){
    text.append(count, static_cast<char>(byte));
}

struct ScratchArenaSentinel final : NoCopy{
    Core::Alloc::ScratchArena& arena;
    u8* bytes = nullptr;


public:
    explicit ScratchArenaSentinel(Core::Alloc::ScratchArena& owner)noexcept
        : arena(owner)
        , bytes(static_cast<u8*>(owner.allocate(1u, 64u)))
    {
        if(bytes != nullptr){
            for(usize index = 0u; index < 64u; ++index)
                bytes[index] = static_cast<u8>(index + 91u);
        }
    }
    ~ScratchArenaSentinel()noexcept{
        release();
    }


public:
    [[nodiscard]] b8 valid()const noexcept{ return bytes != nullptr; }

    [[nodiscard]] b8 intact()const noexcept{
        if(bytes == nullptr)
            return false;
        for(usize index = 0u; index < 64u; ++index){
            if(bytes[index] != static_cast<u8>(index + 91u))
                return false;
        }
        return true;
    }

    void release()noexcept{
        if(bytes != nullptr){
            arena.deallocate(bytes, 1u, 64u);
            bytes = nullptr;
        }
    }
};


inline constexpr AStringView s_GatherOutputDirectory = "out";
inline usize s_GatherMergeCalls = 0u;

class BuildInputSelection : public testing::Test{
public:
    virtual ~BuildInputSelection()noexcept override{
        m_cpuScheduler.drain();
    }


public:
    virtual void SetUp()override{
        m_root = AssetsGraphicsTestRepoRoot(m_testArena.arena) / "__build_obj" / "build_input_tests";
        ASSERT_TRUE(EnsureDirectories(m_root / s_AssetsDirectory / "empty"));
        m_paths.repoRoot = m_root;
        m_paths.assetRoots.emplace_back(m_root / s_AssetsDirectory, s_ProjectVirtualRoot);
    }

    virtual void TearDown()override{
        m_cpuScheduler.wait();
    }

    void addFile(const AStringView relativePath){
        const NWB::Path path = m_root / relativePath;
        ASSERT_TRUE(EnsureDirectories(path.parentPath()));
        OutputFileStream stream(path, OutputFileStream::binary);
        ASSERT_TRUE(stream);
        stream.close();
        ASSERT_TRUE(stream);
        Core::Assets::AssetString normalized = PathToString(m_testArena.arena, path.lexicallyNormal());
        CanonicalizeTextInPlace(normalized);
        m_files.emplace_back(m_testArena.arena, m_root / s_AssetsDirectory, path, normalized, s_ProjectVirtualRoot);
    }

    void addInput(const AStringView relativePath){
        m_options.inputs.emplace_back(relativePath, m_testArena.arena);
    }

    void clearInputs()noexcept{
        m_options.inputs.clear();
    }

    [[nodiscard]] usize fileCount()const noexcept{
        return m_files.size();
    }

    [[nodiscard]] Core::Assets::AssetString filenameAt(const usize index){
        return PathToString(m_testArena.arena, m_files[index].filePath.filenameView());
    }

    [[nodiscard]] Core::Assets::CookVector<Core::Assets::CookString> makeCookSources(){
        return Core::Assets::CookVector<Core::Assets::CookString>(m_testArena.arena);
    }

    void appendCookSource(const AStringView source, Core::Assets::CookVector<Core::Assets::CookString>& sources){
        sources.emplace_back(source, m_testArena.arena);
    }

    void appendCookPathSource(const NWB::Path& path, Core::Assets::CookVector<Core::Assets::CookString>& sources){
        sources.push_back(PathToString(m_testArena.arena, path));
    }

    b8 select(){
        return Pipeline::AssetBuilder::SelectBuildInputs(m_options, m_paths, m_scratchArena, m_files);
    }


public:
    NWB::Core::Alloc::ScratchArena m_scratchArena{ Name(s_AssetCaseTestsAssetsBuildInputs) };
    NWB::Tests::TestArena<> m_testArena;
    NWB::Core::CpuTaskScheduler m_cpuScheduler{ 1u };
    NWB::Tests::CapturingLogger m_logger;
    NWB::Core::Common::LoggerRegistrationGuard m_loggerGuard{ m_logger, NWB::Core::Common::LoggerBreakPolicy::BreakOnFatal };
    NWB::Path m_root{ m_testArena.arena };
    Core::Assets::ResolvedCookPaths m_paths{ m_testArena.arena };
    Core::Assets::DiscoveredNwbFileVector m_files{ m_testArena.arena };
    Pipeline::AssetBuilder::AssetBuildOptions m_options{ m_testArena.arena, m_cpuScheduler };
};

FOUNDATION_INLINE void AppendCsgShapeCookEntry(const Name shapeName, const Name shaderModule, const AStringView moduleInclude, NWB::Impl::AssetsCsgCook::CookArena& arena, NWB::Impl::AssetsCsgCook::CsgShapeCookEntryVector& outEntries){
    NWB::Impl::AssetsCsgCook::CsgShapeCookEntry entry(arena);
    entry.shapeName = shapeName;
    entry.shaderModule = shaderModule;
    entry.evalInclude.assign("project/csg/tests/eval.slangi");
    entry.moduleInclude.assign(moduleInclude.data(), moduleInclude.size());
    outEntries.push_back(Move(entry));
}

[[nodiscard]] FOUNDATION_INLINE NWB::Impl::CsgShapeTypeId FindCookedCsgShapeTypeId(const NWB::Impl::AssetsCsgCook::CsgShapeCookEntryVector& entries, const Name shapeName)noexcept{
    for(const NWB::Impl::AssetsCsgCook::CsgShapeCookEntry& entry : entries){
        if(entry.shapeName == shapeName)
            return entry.shapeTypeId;
    }
    return NWB::Impl::s_InvalidCsgShapeTypeId;
}

FOUNDATION_INLINE Expected<NWB::Impl::CsgShapeBounds> CsgCookTestBounds(const SIMDMatrix&, const Span<const u8>)noexcept{
    return NWB::Impl::CsgShapeBounds{ VectorSet(-1.0f, -1.0f, -1.0f, 0.0f), VectorSet(1.0f, 1.0f, 1.0f, 0.0f), true };
}

[[nodiscard]] FOUNDATION_INLINE NWB::Impl::CsgShapeTypeDesc CsgCookTestShapeDesc(const Name shapeName, const Name shaderModule, const AStringView moduleInclude, Core::Alloc::GlobalArena& arena){
    NWB::Impl::CsgShapeTypeDesc desc(arena);
    desc.name = shapeName;
    desc.shaderModule = shaderModule;
    desc.shaderModuleInclude = moduleInclude;
    desc.boundsCallback = &CsgCookTestBounds;
    return desc;
}

[[nodiscard]] FOUNDATION_INLINE b8 MergeGatheredTestBytes(const Name&, const Span<const u8> incoming, NWB::Core::Alloc::ScratchArena&, Core::Assets::AssetBytes& existing){
    ++s_GatherMergeCalls;
    existing.insert(existing.end(), incoming.begin(), incoming.end());
    return true;
}

[[nodiscard]] FOUNDATION_INLINE Expected<Name> GatherInputAssetName(const usize index){
    Array<char, 32u> text = {};
    return DeriveName(Name(s_AssetCaseProjectGather), FormatDecimal(index, text));
}

class GatherInputs : public testing::Test{
public:
    virtual void SetUp()override{
        Core::Assets::AssetString caseKey(m_testArena.arena);
        AppendHexU32(static_cast<u32>(ComputeFnv64Text(AStringView(testing::UnitTest::GetInstance()->current_test_info()->name()))), caseKey);
        m_root = AssetsGraphicsTestRepoRoot(m_testArena.arena) / "__build_obj" / "g" / caseKey;
        m_options.outputDirectory = PathToString(m_testArena.arena, m_root / s_GatherOutputDirectory);
        m_options.configuration = "tests";
        s_GatherMergeCalls = 0u;
    }

    void writeInputs(const AStringView directory, const usize count, const usize payloadSize, const u8 seed){
        NWB::Core::Alloc::ScratchArena scratchArena{Name(s_AssetCaseTestsAssetsGraphicsBuiltInputs)};
        Core::Assets::AssetsVolumeCookDetail::AssetVolumePackManifest manifest(m_testArena.arena);
        ASSERT_TRUE(Core::Assets::AssetsVolumeCookDetail::ReserveAssetVolumePackManifest(count, manifest));
        Core::Assets::AssetBytes bytes(payloadSize, seed, m_testArena.arena);
        for(usize i = 0u; i < count; ++i){
            if(!bytes.empty())
                bytes.front() = static_cast<u8>(seed + i);
            const auto derivedNameResult = GatherInputAssetName(i);
            ASSERT_TRUE(derivedNameResult);
            ASSERT_TRUE(Core::Assets::AssetsVolumeCookDetail::AppendPayloadBytesToManifest(*derivedNameResult, bytes, manifest));
        }
        ASSERT_TRUE(Core::Assets::BuiltAssetDetail::WriteBuiltAssets(m_root / directory, manifest, scratchArena));
        m_options.inputs.emplace_back(PathToString(m_testArena.arena, m_root / directory));
    }

    void verifyPayloads(const usize count, const usize payloadSize, const u8 seed){
        Core::Filesystem::VolumeMountDesc desc(m_testArena.arena);
        desc.volumeName = "graphics";
        desc.mountDirectory = m_root / s_GatherOutputDirectory;
        auto filesystemResult = Core::Filesystem::CreateFilesystem(m_testArena.arena, desc);
        ASSERT_TRUE(filesystemResult);
        auto filesystem = Move(*filesystemResult);
        ASSERT_TRUE(filesystem->mounted());
        EXPECT_EQ(filesystem->fileCount(), count);
        Core::Assets::AssetBytes bytes(m_testArena.arena);
        for(usize i = 0u; i < count; ++i){
            const auto secondDerivedNameResult = GatherInputAssetName(i);
            ASSERT_TRUE(secondDerivedNameResult);
            ASSERT_TRUE(filesystem->readFile(*secondDerivedNameResult, bytes));
            ASSERT_EQ(bytes.size(), payloadSize);
            if(!bytes.empty())
                EXPECT_EQ(bytes.front(), static_cast<u8>(seed + i));
            if(bytes.size() > 1u)
                EXPECT_EQ(bytes.back(), seed);
        }
        EXPECT_TRUE(filesystem->unmount());
    }

    void addRawInput(const AStringView input){
        m_options.inputs.emplace_back(input, m_testArena.arena);
    }

    void duplicateFirstInput(){
        m_options.inputs.push_back(m_options.inputs.front());
    }

    void enableTestMerge()noexcept{
        m_options.mergePayloads = &MergeGatheredTestBytes;
    }

    [[nodiscard]] usize mergeCallCount()const noexcept{
        return s_GatherMergeCalls;
    }

    void resetMergeCallCount()noexcept{
        s_GatherMergeCalls = 0u;
    }

    [[nodiscard]] b8 hasFatalFailure()const noexcept{
        return HasFatalFailure();
    }

    [[nodiscard]] Core::Assets::AssetVector<Core::Assets::AssetString> makeInputStrings(){
        return Core::Assets::AssetVector<Core::Assets::AssetString>(m_testArena.arena);
    }

    void appendInputString(const AStringView text, Core::Assets::AssetVector<Core::Assets::AssetString>& list){
        list.emplace_back(text, m_testArena.arena);
    }

    [[nodiscard]] b8 writeDuplicateEntryManifestVolume(const Name& duplicateName){
        namespace Pack = Core::Assets::AssetsVolumeCookDetail;
        Pack::AssetVolumePackManifest manifest(m_testArena.arena);
        if(!Pack::ReserveAssetVolumePackManifest(2u, manifest))
            return false;
        const Array<u8, 1u> first{ 7u };
        const Array<u8, 1u> second{ 8u };
        if(!Pack::AppendPayloadBytesToManifest(duplicateName, first, manifest, 1u))
            return false;
        if(!Pack::AppendPayloadBytesToManifest(duplicateName, second, manifest, 1u))
            return false;
        Core::Assets::ResolvedCookPaths paths(m_testArena.arena);
        paths.outputDirectory = m_root / s_GatherOutputDirectory;
        return Pack::WriteAssetVolume(paths, "tests", manifest, m_testArena.arena, m_scratchArena).has_value();
    }


public:
    NWB::Core::Alloc::ScratchArena m_scratchArena{ Name(s_AssetCaseTestsAssetsGraphicsGatherInputs) };
    NWB::Tests::TestArena<> m_testArena;
    NWB::Tests::CapturingLogger m_logger;
    NWB::Core::Common::LoggerRegistrationGuard m_loggerGuard{ m_logger, NWB::Core::Common::LoggerBreakPolicy::BreakOnFatal };
    NWB::Path m_root{ m_testArena.arena };
    Pipeline::AssetGatherer::AssetGatherOptions m_options{ m_testArena.arena };
};

