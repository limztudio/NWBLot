struct SingleQueueCompile{
    Core::Alloc::ScratchArena scratchArena;
    Core::GpuPhysicalQueueInfo singleQueue;
    Core::GpuPhysicalQueueTopology topology;
    Core::GpuTaskGraphAnalysis analysis;
    Core::GpuTaskGraphQueueAssignments assignments;
    Core::GpuCompiledGraph compiledGraph;


public:
    explicit SingleQueueCompile(TestArena& testArena)
        : scratchArena(s_TaskGraphScratchArena)
        , singleQueue{
            .familyIndex = 0u,
            .queueIndex = 0u,
            .id = Core::GpuPhysicalQueueId{ .index = 0u, .deviceGeneration = 1u },
            .queueClass = Core::CommandQueue::Graphics,
            .capabilities = CombineQueueCapabilities(Core::GpuQueueCapability::Graphics, Core::GpuQueueCapability::Compute, Core::GpuQueueCapability::Transfer),
            .dedicated = false,
        }
        , topology{ .queues = &singleQueue, .queueCount = 1u }
        , analysis(testArena.arena)
        , assignments(testArena.arena)
        , compiledGraph(testArena.arena)
    {}


public:
    [[nodiscard]] b8 compile(const Core::GpuTaskGraph& graph, const Core::GpuTaskGraphCompileOptions& options = {}){
        const Core::GpuTaskGraphCompiler compiler;
        Core::GpuTaskGraphCompileOptions metadataOptions = options;
        metadataOptions.allowMetadataOnlyTasks = true;
        const Core::GpuTaskGraph::DeclarationReadView declarations(graph);
        return compiler.compile(declarations, topology, metadataOptions, scratchArena, analysis, assignments, compiledGraph);
    }
};

struct TwoQueueCompile{
    Core::Alloc::ScratchArena scratchArena;
    Core::GpuPhysicalQueueInfo graphicsQueue;
    Core::GpuPhysicalQueueInfo computeQueue;
    Array<Core::GpuPhysicalQueueInfo, 2> queueStorage{};
    Core::GpuPhysicalQueueTopology topology;
    Core::GpuTaskGraphAnalysis analysis;
    Core::GpuTaskGraphQueueAssignments assignments;
    Core::GpuCompiledGraph compiledGraph;


public:
    explicit TwoQueueCompile(TestArena& testArena)
        : scratchArena(s_TaskGraphScratchArena)
        , graphicsQueue{
            .familyIndex = 0u,
            .queueIndex = 0u,
            .id = Core::GpuPhysicalQueueId{ .index = 0u, .deviceGeneration = 1u },
            .queueClass = Core::CommandQueue::Graphics,
            .capabilities = CombineQueueCapabilities(Core::GpuQueueCapability::Graphics, Core::GpuQueueCapability::Compute, Core::GpuQueueCapability::Transfer),
            .dedicated = false,
        }
        , computeQueue{
            .familyIndex = 1u,
            .queueIndex = 0u,
            .id = Core::GpuPhysicalQueueId{ .index = 1u, .deviceGeneration = 1u },
            .queueClass = Core::CommandQueue::Compute,
            .capabilities = CombineQueueCapabilities(Core::GpuQueueCapability::Compute, Core::GpuQueueCapability::Transfer),
            .dedicated = true,
        }
        , queueStorage{ graphicsQueue, computeQueue }
        , topology{ .queues = queueStorage.data(), .queueCount = queueStorage.size() }
        , analysis(testArena.arena)
        , assignments(testArena.arena)
        , compiledGraph(testArena.arena)
    {}


public:
    [[nodiscard]] b8 compile(const Core::GpuTaskGraph& graph, const Core::GpuTaskGraphCompileOptions& options = {}){
        Array<Core::GpuPhysicalQueueInfo, 2> separatedQueues = queueStorage;
        separatedQueues[0u].capabilities = MaskOutQueueCapability(separatedQueues[0u].capabilities, Core::GpuQueueCapability::Compute);
        const Core::GpuPhysicalQueueTopology separatedTopology{ .queues = separatedQueues.data(), .queueCount = separatedQueues.size() };
        const Core::GpuTaskGraphCompiler compiler;
        Core::GpuTaskGraphCompileOptions metadataOptions = options;
        metadataOptions.allowMetadataOnlyTasks = true;
        const Core::GpuTaskGraph::DeclarationReadView declarations(graph);
        return compiler.compile(declarations, separatedTopology, metadataOptions, scratchArena, analysis, assignments, compiledGraph);
    }
};

struct ThreeQueueCompile{
    Core::Alloc::ScratchArena scratchArena;
    Core::GpuPhysicalQueueInfo graphicsQueue;
    Core::GpuPhysicalQueueInfo computeQueue;
    Core::GpuPhysicalQueueInfo transferQueue;
    Array<Core::GpuPhysicalQueueInfo, 3> queueStorage{};
    Core::GpuPhysicalQueueTopology topology;
    Core::GpuTaskGraphAnalysis analysis;
    Core::GpuTaskGraphQueueAssignments assignments;
    Core::GpuCompiledGraph compiledGraph;


public:
    explicit ThreeQueueCompile(TestArena& testArena)
        : scratchArena(s_TaskGraphScratchArena)
        , graphicsQueue{
            .familyIndex = 0u,
            .queueIndex = 0u,
            .id = Core::GpuPhysicalQueueId{ .index = 0u, .deviceGeneration = 1u },
            .queueClass = Core::CommandQueue::Graphics,
            .capabilities = CombineQueueCapabilities(Core::GpuQueueCapability::Graphics, Core::GpuQueueCapability::Compute, Core::GpuQueueCapability::Transfer),
            .dedicated = false,
        }
        , computeQueue{
            .familyIndex = 1u,
            .queueIndex = 0u,
            .id = Core::GpuPhysicalQueueId{ .index = 1u, .deviceGeneration = 1u },
            .queueClass = Core::CommandQueue::Compute,
            .capabilities = CombineQueueCapabilities(Core::GpuQueueCapability::Compute, Core::GpuQueueCapability::Transfer),
            .dedicated = true,
        }
        , transferQueue{
            .familyIndex = 2u,
            .queueIndex = 0u,
            .id = Core::GpuPhysicalQueueId{ .index = 2u, .deviceGeneration = 1u },
            .queueClass = Core::CommandQueue::Transfer,
            .capabilities = Core::GpuQueueCapability::Transfer,
            .dedicated = true,
        }
        , queueStorage{ graphicsQueue, computeQueue, transferQueue }
        , topology{ .queues = queueStorage.data(), .queueCount = queueStorage.size() }
        , analysis(testArena.arena)
        , assignments(testArena.arena)
        , compiledGraph(testArena.arena)
    {}


public:
    [[nodiscard]] b8 compile(const Core::GpuTaskGraph& graph, const Core::GpuTaskGraphCompileOptions& options = {}){
        Array<Core::GpuPhysicalQueueInfo, 3> separatedQueues = queueStorage;
        separatedQueues[0u].capabilities = MaskOutQueueCapability(
            MaskOutQueueCapability(separatedQueues[0u].capabilities, Core::GpuQueueCapability::Compute),
            Core::GpuQueueCapability::Transfer
        );
        separatedQueues[1u].capabilities = MaskOutQueueCapability(separatedQueues[1u].capabilities, Core::GpuQueueCapability::Transfer);
        const Core::GpuPhysicalQueueTopology separatedTopology{ .queues = separatedQueues.data(), .queueCount = separatedQueues.size() };
        const Core::GpuTaskGraphCompiler compiler;
        Core::GpuTaskGraphCompileOptions metadataOptions = options;
        metadataOptions.allowMetadataOnlyTasks = true;
        const Core::GpuTaskGraph::DeclarationReadView declarations(graph);
        return compiler.compile(declarations, separatedTopology, metadataOptions, scratchArena, analysis, assignments, compiledGraph);
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_END


