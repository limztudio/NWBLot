        identity,
        "Resource Version Task",
        dependencies,
        resourceUses,
        Span<GpuTaskResourceSetUse>(),
        versionUses,
        externalDependencies,
        graph
    );
}

void GpuResVersionExpectRejectedQueueSharingWithoutMutation(
    in GpuResVersionResourceTypeEnum resourceType,
    in GpuResVersionQueueSharingMask queueSharing,
    in b8 useHazardDomainWrapper
){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuGraphResourceDesc desc = GpuGraphResourceDesc();
    desc.setIdentity(s_GpuCaseTaskGraphInvalidQueueSharingMetadata);
    desc.setMarkerLabel("Invalid Queue Sharing Metadata");
    desc.setType(resourceType);
    if(resourceType == GpuGraphResourceType::HazardDomain)
        desc.setInitialState(ResourceStates::Unknown);
    else
        desc.setInitialState(ResourceStates::Common);
    desc.setQueueSharing(queueSharing);

    usize resourceCount = 0u;
    u64 declarationRevision = 0u;
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        resourceCount = declarations.resourceCount();
        declarationRevision = declarations.declarationRevision();
    }
    const ArenaMemoryStats memoryStats = testArena.arena.memoryStats();
    b8 admitted = false;
    if(useHazardDomainWrapper){
        const Expected<GpuGraphResourceId> resource = graph.importHazardDomain(desc);
        admitted = resource.has_value();
    }
    else{
        const Expected<GpuGraphResourceId> resource = graph.importResource(desc);
        admitted = resource.has_value();
    }

    EXPECT_FALSE(admitted);
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
    EXPECT_EQ(declarations.resourceCount(), resourceCount);
    EXPECT_EQ(declarations.declarationRevision(), declarationRevision);
    ExpectMemoryStatsEqual(memoryStats, testArena.arena.memoryStats());
}

void VerifyGpuResVersion_RejectsMalformedQueueSharingWithoutDeclarationMutation(){
    Array<GpuResVersionQueueSharingMask, 2> invalidMasks = Array<GpuResVersionQueueSharingMask, 2>();
    invalidMasks[0u] = s_GpuResVersionInvalidQueueSharingA;
    invalidMasks[1u] = s_GpuResVersionInvalidQueueSharingB;

    Array<GpuResVersionResourceTypeEnum, 4> metadataResourceTypes = Array<GpuResVersionResourceTypeEnum, 4>();
    metadataResourceTypes[0u] = GpuGraphResourceType::Texture;
    metadataResourceTypes[1u] = GpuGraphResourceType::Buffer;
    metadataResourceTypes[2u] = GpuGraphResourceType::AccelStruct;
    metadataResourceTypes[3u] = GpuGraphResourceType::HazardDomain;

    for(in GpuResVersionQueueSharingMask queueSharing : invalidMasks){
        const ScopedTestTrace sharingTrace = ScopedTestTrace(cast<u32>(queueSharing));
        for(in GpuResVersionResourceTypeEnum resourceType : metadataResourceTypes){
            const ScopedTestTrace typeTrace = ScopedTestTrace(cast<u32>(resourceType));
            GpuResVersionExpectRejectedQueueSharingWithoutMutation(resourceType, queueSharing, false);
        }
        GpuResVersionExpectRejectedQueueSharingWithoutMutation(GpuGraphResourceType::HazardDomain, queueSharing, true);
    }
}

b8 GpuResVersionFillResources(mut GpuTaskGraph graph, in usize count, mut GpuResVersionResourceIds members){
    members.clear();
    members.reserve(count);
    for(usize index = 0u; index < count; ++index){
        const Expected<Name> identityNameResult = IndexedName(s_GpuCaseResourceSetMemoryResource, index);
        if(!identityNameResult.has_value())
            return false;
        const Name identity = identityNameResult.value();
        GpuGraphResourceDesc desc = GpuGraphResourceDesc();
        desc.setIdentity(identity);
        desc.setMarkerLabel("Resource Set Memory Input");
        desc.setType(GpuGraphResourceType::Buffer);
        const Expected<GpuGraphResourceId> resourceResult = graph.importResource(desc);
        if(!resourceResult.has_value())
            return false;
        const GpuGraphResourceId resource = resourceResult.value();
        if(!resource.valid())
            return false;
        members.push_back(resource);
    }
    return true;
}

void GpuResVersionExpectDeclarationState(in GpuTaskGraph graph, in u64 revision, in usize setCount){
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
    ASSERT_TRUE(declarations.valid());
    EXPECT_EQ(declarations.declarationRevision(), revision);
    EXPECT_EQ(declarations.resourceSetCount(), setCount);
}

void VerifyGpuResVersion_SmallSetsAndBlockedMutationLeaveTheScratchOwnerUnallocated(){
    const ArenaMemoryStats before = OwnerStats(s_CoreTaskGpuDeclarationScratch);
    {
        GpuResVersionGraphScope scope = GpuResVersionGraphScope(s_GpuCaseResourceSetMemorySmall);
        ASSERT_TRUE(GpuResVersionFillResources(scope.graph, 64u, scope.members));
        GpuGraphResourceSetId lastSet = GpuGraphResourceSetId();
        Array<usize, 4> counts = Array<usize, 4>();
        counts[0u] = 0u;
        counts[1u] = 1u;
        counts[2u] = 8u;
        counts[3u] = 32u;
        for(in usize count : counts){
            const Expected<Name> identityNameResult = IndexedName(s_GpuCaseResourceSetMemorySmallSet, count);
            ASSERT_TRUE(identityNameResult.has_value());
            const Name identity = identityNameResult.value();
            const Expected<GpuGraphResourceSetId> lastSetTaskAdmission = scope.graph.importResourceSet(MakeGpuResVersionSetDesc(identity, scope.members, count));
            ASSERT_TRUE(lastSetTaskAdmission.has_value());
            lastSet = lastSetTaskAdmission.value();
            ASSERT_TRUE(lastSet.valid());
        }
        {
            const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(scope.graph);
            ASSERT_TRUE(declarations.valid());
            const u64 revision = declarations.declarationRevision();
            const GpuTaskGraphResourceSetView last = declarations.resourceSetAt(lastSet.index);
            EXPECT_FALSE(scope.graph.importResourceSet(MakeGpuResVersionSetDesc(s_TaskGraphCaseTestsResourceSetMemoryBlockedLarge, scope.members, scope.members.size())).has_value());
            EXPECT_FALSE(scope.graph.importResourceSet(MakeGpuResVersionSetDesc(last.identity, scope.members, last.memberCount)).has_value());
            EXPECT_EQ(declarations.declarationRevision(), revision);
        }
        const ArenaMemoryStats after = OwnerStats(s_CoreTaskGpuDeclarationScratch);
        EXPECT_EQ(after.usedBytes, before.usedBytes);
        EXPECT_EQ(after.reservedBytes, before.reservedBytes);
        EXPECT_EQ(after.allocationCount, before.allocationCount);
        EXPECT_EQ(after.reallocationCount, before.reallocationCount);
        EXPECT_EQ(after.deallocationCount, before.deallocationCount);
    }
    EXPECT_EQ(OwnerStats(s_CoreTaskGpuDeclarationScratch).usedBytes, before.usedBytes);
    EXPECT_EQ(OwnerStats(s_CoreTaskGpuDeclarationScratch).reservedBytes, before.reservedBytes);
}

void VerifyGpuResVersion_LargeSmallLargeScopesReclaimUsageAndReuseBackingAcrossGraphReset(){
    const ArenaMemoryStats before = OwnerStats(s_CoreTaskGpuDeclarationScratch);
    ArenaMemoryStats warm = ArenaMemoryStats();
    {
        GpuResVersionGraphScope scope = GpuResVersionGraphScope(s_GpuCaseResourceSetMemoryRepeated);
        Array<usize, 3> counts = Array<usize, 3>();
        counts[0u] = 4096u;
        counts[1u] = 33u;
        counts[2u] = 4096u;
        for(usize cycle = 0u; cycle < 8u; ++cycle){
            if(cycle != 0u)
                scope.graph.reset();
            ASSERT_TRUE(GpuResVersionFillResources(scope.graph, 4096u, scope.members));
            const ArenaMemoryStats heapBefore = HeapBackingMemoryStats();
            usize phase = 0u;
            for(in usize count : counts){
                const Expected<Name> identityNameResult = IndexedName(s_GpuCaseResourceSetMemoryPhase, phase);
                ASSERT_TRUE(identityNameResult.has_value());
                const Name identity = identityNameResult.value();
                const Expected<GpuGraphResourceSetId> setResult = scope.graph.importResourceSet(MakeGpuResVersionSetDesc(identity, scope.members, count));
                ASSERT_TRUE(setResult.has_value());
                const GpuGraphResourceSetId set = setResult.value();
                ASSERT_TRUE(set.valid());
                EXPECT_EQ(OwnerStats(s_CoreTaskGpuDeclarationScratch).usedBytes, before.usedBytes);
                const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(scope.graph);
                ASSERT_TRUE(declarations.valid());
                const GpuTaskGraphResourceSetView stored = declarations.resourceSetAt(set.index);
                ASSERT_EQ(stored.memberCount, count);
                const GpuGraphResourceId expectedFirst = scope.members[0u];
                const GpuGraphResourceId expectedLast = scope.members[count - 1u];
                native(in stored, in count, in expectedFirst, in expectedLast){
                    EXPECT_EQ(stored.members[0u], expectedFirst);
                    EXPECT_EQ(stored.members[count - 1u], expectedLast);
                }
                ++phase;
            }
            const ArenaMemoryStats heapAfter = HeapBackingMemoryStats();
            const ArenaMemoryStats after = OwnerStats(s_CoreTaskGpuDeclarationScratch);
            if(cycle == 0u){
                warm = after;
                EXPECT_GT(warm.reservedBytes, before.reservedBytes);
                EXPECT_GT(warm.allocationCount, before.allocationCount);
            }
            else{
                EXPECT_EQ(after.reservedBytes, warm.reservedBytes);
                EXPECT_EQ(heapAfter.allocationCount, heapBefore.allocationCount);
                EXPECT_EQ(heapAfter.reallocationCount, heapBefore.reallocationCount);
                EXPECT_EQ(heapAfter.deallocationCount, heapBefore.deallocationCount);
            }
            EXPECT_EQ(after.usedBytes, before.usedBytes);
        }
        scope.graph.reset();
        const ArenaMemoryStats afterReset = OwnerStats(s_CoreTaskGpuDeclarationScratch);
        EXPECT_EQ(afterReset.usedBytes, before.usedBytes);
        EXPECT_EQ(afterReset.reservedBytes, warm.reservedBytes);
    }
    const ArenaMemoryStats afterDestruction = OwnerStats(s_CoreTaskGpuDeclarationScratch);
    EXPECT_EQ(afterDestruction.usedBytes, before.usedBytes);
    EXPECT_EQ(afterDestruction.reservedBytes, before.reservedBytes);
    EXPECT_GT(afterDestruction.allocationCount, before.allocationCount);
    EXPECT_EQ(afterDestruction.allocationCount - before.allocationCount, afterDestruction.deallocationCount - before.deallocationCount);
}

void VerifyGpuResVersion_LateRejectedMembersRetireTemporaryStorageBeforeTheNextDeclaration(){
    const ArenaMemoryStats before = OwnerStats(s_CoreTaskGpuDeclarationScratch);
    {
        GpuResVersionGraphScope scope = GpuResVersionGraphScope(s_GpuCaseResourceSetMemoryRejection);
        ASSERT_TRUE(GpuResVersionFillResources(scope.graph, 1024u, scope.members));
        const usize lastIndex = scope.members.size() - 1u;
        const GpuGraphResourceId saved = scope.members[lastIndex];
        const GpuGraphResourceSetDesc rejected = MakeGpuResVersionSetDesc(s_GpuCaseResourceSetMemoryRejected, scope.members, scope.members.size());
        u64 warmReserved = 0u;
        for(usize cycle = 0u; cycle < 16u; ++cycle){
            u64 revision = 0u;
            {
                const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(scope.graph);
                ASSERT_TRUE(declarations.valid());
                revision = declarations.declarationRevision();
            }
            scope.members[lastIndex] = scope.members[0u];
            EXPECT_FALSE(scope.graph.importResourceSet(rejected).has_value());
            native(in scope, in revision, in cycle){
                ASSERT_NO_FATAL_FAILURE(GpuResVersionExpectDeclarationState(scope.graph, revision, cycle));
            }
            EXPECT_EQ(OwnerStats(s_CoreTaskGpuDeclarationScratch).usedBytes, before.usedBytes);

            scope.members[lastIndex] = saved;
            ++scope.members[lastIndex].generation;
            EXPECT_FALSE(scope.graph.importResourceSet(rejected).has_value());
            native(in scope, in revision, in cycle){
                ASSERT_NO_FATAL_FAILURE(GpuResVersionExpectDeclarationState(scope.graph, revision, cycle));
            }
            EXPECT_EQ(OwnerStats(s_CoreTaskGpuDeclarationScratch).usedBytes, before.usedBytes);

            scope.members[lastIndex] = saved;
            scope.members[lastIndex].index = cast<u32>(scope.members.size());
            EXPECT_FALSE(scope.graph.importResourceSet(rejected).has_value());
            native(in scope, in revision, in cycle){
                ASSERT_NO_FATAL_FAILURE(GpuResVersionExpectDeclarationState(scope.graph, revision, cycle));
            }
            EXPECT_EQ(OwnerStats(s_CoreTaskGpuDeclarationScratch).usedBytes, before.usedBytes);

            scope.members[lastIndex] = saved;
            const Expected<Name> acceptedIdentityNameResult = IndexedName(s_GpuCaseResourceSetMemoryAccepted, cycle);
            ASSERT_TRUE(acceptedIdentityNameResult.has_value());
            const Name acceptedIdentity = acceptedIdentityNameResult.value();
            {
                const Expected<GpuGraphResourceSetId> gpuTaskAdmission = scope.graph.importResourceSet(MakeGpuResVersionSetDesc(acceptedIdentity, scope.members, scope.members.size()));
                EXPECT_TRUE(gpuTaskAdmission.has_value());
                if(gpuTaskAdmission.has_value())
                    EXPECT_TRUE(gpuTaskAdmission.value().valid());
            }
            const ArenaMemoryStats after = OwnerStats(s_CoreTaskGpuDeclarationScratch);
            EXPECT_EQ(after.usedBytes, before.usedBytes);
            if(cycle == 0u){
                warmReserved = after.reservedBytes;
                EXPECT_GT(warmReserved, before.reservedBytes);
            }
            else
                EXPECT_EQ(after.reservedBytes, warmReserved);
        }
    }
    const ArenaMemoryStats after = OwnerStats(s_CoreTaskGpuDeclarationScratch);
    EXPECT_EQ(after.usedBytes, before.usedBytes);
    EXPECT_EQ(after.reservedBytes, before.reservedBytes);
    EXPECT_GT(after.allocationCount, before.allocationCount);
    EXPECT_EQ(after.allocationCount - before.allocationCount, after.deallocationCount - before.deallocationCount);
}

void GpuResVersionExpectUnchangedDeclaration(in GpuResVersionSetContext context, in u64 revision, in usize setCount){
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(context.graph);
    ASSERT_TRUE(declarations.valid());
    EXPECT_EQ(declarations.declarationRevision(), revision);
    EXPECT_EQ(declarations.resourceSetCount(), setCount);
}

void GpuResVersionSwapEnds(mut GpuResVersionSetContext context){
    const usize lastIndex = context.members.size() - 1u;
    const GpuGraphResourceId first = context.members[0u];
    context.members[0u] = context.members[lastIndex];
    context.members[lastIndex] = first;
}

void VerifyGpuResVersion_CopiesOrderedMembersAndReusesOnlyTheSameOrderedIdentity(){
    GpuResVersionSetContext context = GpuResVersionSetContext(64u);
    ASSERT_TRUE(context.ready);
    GpuGraphResourceSetDesc desc = context.description(s_ResourceSetValidationOrdered);
    const Expected<GpuGraphResourceSetId> setResult = context.graph.importResourceSet(desc);
    ASSERT_TRUE(setResult.has_value());
    const GpuGraphResourceSetId set = setResult.value();
    ASSERT_TRUE(set.valid());
    u64 revision = 0u;
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(context.graph);
        ASSERT_TRUE(declarations.valid());
        revision = declarations.declarationRevision();
        const GpuTaskGraphResourceSetView stored = declarations.resourceSetAt(set.index);
        ASSERT_EQ(stored.memberCount, context.members.size());
        native(in stored, in context){
            for(usize index = 0u; index < stored.memberCount; ++index)
                EXPECT_EQ(stored.members[index], context.members[index]);
        }
    }
    desc.markerLabel = "Replacement Label Does Not Replace Stored Metadata";
    {
        const Expected<GpuGraphResourceSetId> gpuTaskAdmission = context.graph.importResourceSet(desc);
        EXPECT_TRUE(gpuTaskAdmission.has_value());
        if(gpuTaskAdmission.has_value())
            EXPECT_EQ(gpuTaskAdmission.value(), set);
    }
    GpuResVersionExpectUnchangedDeclaration(context, revision, 1u);

    GpuResVersionSwapEnds(context);
    EXPECT_FALSE(context.graph.importResourceSet(desc).has_value());
    GpuResVersionExpectUnchangedDeclaration(context, revision, 1u);
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(context.graph);
        const GpuTaskGraphResourceSetView stored = declarations.resourceSetAt(set.index);
        const GpuGraphResourceId currentFirst = context.members[0u];
        const GpuGraphResourceId currentLast = context.members[context.members.size() - 1u];
        native(in stored, in currentFirst, in currentLast){
            EXPECT_EQ(stored.members[0u], currentLast);
            EXPECT_EQ(stored.members[stored.memberCount - 1u], currentFirst);
            EXPECT_EQ(stored.markerLabel, AStringView("Resource Set Validation Members"));
        }
    }

    GpuResVersionSwapEnds(context);
    --desc.memberCount;
    EXPECT_FALSE(context.graph.importResourceSet(desc).has_value());
    GpuResVersionExpectUnchangedDeclaration(context, revision, 1u);

    desc = context.description(s_GpuCaseResourceSetValidationSecondOrdered);
    {
        const Expected<GpuGraphResourceSetId> secondGpuTaskAdmission = context.graph.importResourceSet(desc);
        EXPECT_TRUE(secondGpuTaskAdmission.has_value());
        if(secondGpuTaskAdmission.has_value())
            EXPECT_TRUE(secondGpuTaskAdmission.value().valid());
    }
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(context.graph);
    EXPECT_EQ(declarations.resourceSetCount(), 2u);
}

void VerifyGpuResVersion_EarlyAndLateDuplicatesOrInvalidIdsDoNotPublishPartialSets(){
    Array<usize, 5> counts = Array<usize, 5>();
    counts[0u] = 2u;
    counts[1u] = 8u;
    counts[2u] = 32u;
    counts[3u] = 33u;
    counts[4u] = 1024u;
    for(in usize count : counts){
        GpuResVersionSetContext context = GpuResVersionSetContext(count);
        ASSERT_TRUE(context.ready);
        const GpuGraphResourceSetDesc desc = context.description(s_GpuCaseResourceSetValidationRejected);
        u64 revision = 0u;
        {
            const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(context.graph);
            revision = declarations.declarationRevision();
        }
        Array<usize, 2> duplicateIndices = Array<usize, 2>();
        duplicateIndices[0u] = 1u;
        duplicateIndices[1u] = count - 1u;
        for(in usize index : duplicateIndices){
            const GpuGraphResourceId saved = context.members[index];
            context.members[index] = context.members[0u];
            EXPECT_FALSE(context.graph.importResourceSet(desc).has_value());
            GpuResVersionExpectUnchangedDeclaration(context, revision, 0u);
            context.members[index] = saved;
        }
        Array<usize, 2> invalidIndices = Array<usize, 2>();
        invalidIndices[0u] = 0u;
        invalidIndices[1u] = count - 1u;
        for(in usize index : invalidIndices){
            const GpuGraphResourceId saved = context.members[index];
            context.members[index] = GpuGraphResourceId();
            EXPECT_FALSE(context.graph.importResourceSet(desc).has_value());
            GpuResVersionExpectUnchangedDeclaration(context, revision, 0u);
            context.members[index] = saved;
            context.members[index].generation = saved.generation + 1u;
            EXPECT_FALSE(context.graph.importResourceSet(desc).has_value());
            GpuResVersionExpectUnchangedDeclaration(context, revision, 0u);
            context.members[index] = saved;
            context.members[index].index = cast<u32>(count);
            EXPECT_FALSE(context.graph.importResourceSet(desc).has_value());
            GpuResVersionExpectUnchangedDeclaration(context, revision, 0u);
            context.members[index] = saved;
        }
        {
            const Expected<GpuGraphResourceSetId> gpuTaskAdmission = context.graph.importResourceSet(desc);
            EXPECT_TRUE(gpuTaskAdmission.has_value());
            if(gpuTaskAdmission.has_value())
                EXPECT_TRUE(gpuTaskAdmission.value().valid());
        }
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(context.graph);
        EXPECT_EQ(declarations.resourceSetCount(), 1u);
    }
}

void VerifyGpuResVersion_EmptySetsRemainValidAndMalformedDescriptorsRemainUnpublished(){
    GpuResVersionSetContext context = GpuResVersionSetContext(1u);
    ASSERT_TRUE(context.ready);
    GpuGraphResourceSetDesc desc = context.description(s_GpuCaseResourceSetValidationEmpty);
    desc.setMembers(Span<GpuGraphResourceId>());
    const Expected<GpuGraphResourceSetId> emptyResult = context.graph.importResourceSet(desc);
    ASSERT_TRUE(emptyResult.has_value());
    const GpuGraphResourceSetId empty = emptyResult.value();
    ASSERT_TRUE(empty.valid());
    {
        const Expected<GpuGraphResourceSetId> gpuTaskAdmission = context.graph.importResourceSet(desc);
        EXPECT_TRUE(gpuTaskAdmission.has_value());
        if(gpuTaskAdmission.has_value())
            EXPECT_EQ(gpuTaskAdmission.value(), empty);
    }
    u64 revision = 0u;
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(context.graph);
        revision = declarations.declarationRevision();
        EXPECT_EQ(declarations.resourceSetAt(empty.index).memberCount, 0u);
    }
    desc.identity = s_GpuCaseResourceSetValidationBadShape;
    desc.memberCount = 1u;
    EXPECT_FALSE(context.graph.importResourceSet(desc).has_value());
    desc = context.description(s_NameNone);
    EXPECT_FALSE(context.graph.importResourceSet(desc).has_value());
    desc = context.description(s_GpuCaseResourceSetValidationBadLabel);
    desc.markerLabel = "";
    EXPECT_FALSE(context.graph.importResourceSet(desc).has_value());
    desc = context.description(s_GpuCaseResourceSetValidationTooMany);
    desc.memberCount = cast<usize>(u32.max) + 1u;
    EXPECT_FALSE(context.graph.importResourceSet(desc).has_value());
    GpuResVersionExpectUnchangedDeclaration(context, revision, 1u);
}

void VerifyGpuResVersion_ResetRejectsOldGenerationsAndAcceptsFreshIdsAtTheSameIndices(){
    GpuResVersionSetContext context = GpuResVersionSetContext(64u);
    ASSERT_TRUE(context.ready);
    const Expected<GpuGraphResourceSetId> previousSetResult = context.graph.importResourceSet(context.description(s_ResourceSetValidationReset));
    ASSERT_TRUE(previousSetResult.has_value());
    const GpuGraphResourceSetId previousSet = previousSetResult.value();
    ASSERT_TRUE(previousSet.valid());
    const usize lastIndex = context.members.size() - 1u;
    const GpuGraphResourceId previousMember = context.members[lastIndex];
    context.graph.reset();
    ASSERT_TRUE(context.fill(64u));
    const GpuGraphResourceId freshMember = context.members[lastIndex];
    EXPECT_EQ(freshMember.index, previousMember.index);
    EXPECT_NE(freshMember.generation, previousMember.generation);
    context.members[lastIndex] = previousMember;
    EXPECT_FALSE(context.graph.importResourceSet(context.description(s_ResourceSetValidationReset)).has_value());
    context.members[lastIndex] = freshMember;
    const Expected<GpuGraphResourceSetId> freshSetResult = context.graph.importResourceSet(context.description(s_ResourceSetValidationReset));
    ASSERT_TRUE(freshSetResult.has_value());
    const GpuGraphResourceSetId freshSet = freshSetResult.value();
    ASSERT_TRUE(freshSet.valid());
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(context.graph);
    EXPECT_FALSE(declarations.validResourceSet(previousSet));
    EXPECT_TRUE(declarations.validResourceSet(freshSet));
    EXPECT_EQ(declarations.resourceSetCount(), 1u);
}

void VerifyGpuResVersion_StoresDistinctDeclarationsAndInvalidatesThemOnReset(){
    GpuResVersionTestArena testArena = GpuResVersionTestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuGraphResourceId> resourceResult = GpuResVersionAddBuffer(graph, s_GpuCaseTaskGraphResourceVersionStorageResource);
    ASSERT_TRUE(resourceResult.has_value());
    const GpuGraphResourceId resource = resourceResult.value();
    ASSERT_TRUE(resource.valid());
    const GpuTaskResourceRange range = GpuResVersionBufferRange(16u, 32u);
    GpuGraphResourceVersionDesc desc = GpuGraphResourceVersionDesc();
    desc.setResource(resource);
    desc.setRange(range);
    desc.setOrigin(GpuGraphResourceVersionOrigin::ImportedRoot);

    const u64 initialRevision = GpuTaskGraphDeclarationReadView(graph).declarationRevision();
    const Expected<GpuGraphResourceVersionId> firstResult = graph.declareResourceVersion(desc);
    ASSERT_TRUE(firstResult.has_value());
    const GpuGraphResourceVersionId first = firstResult.value();
    const u64 firstRevision = GpuTaskGraphDeclarationReadView(graph).declarationRevision();
    const Expected<GpuGraphResourceVersionId> secondResult = graph.declareResourceVersion(desc);
    ASSERT_TRUE(secondResult.has_value());
    const GpuGraphResourceVersionId second = secondResult.value();
    ASSERT_TRUE(first.valid());
    ASSERT_TRUE(second.valid());
    EXPECT_NE(first, second);
    EXPECT_EQ(GpuTaskGraphDeclarationReadView(graph).resourceVersionCount(), 2u);
    EXPECT_NE(firstRevision, initialRevision);
    EXPECT_NE(GpuTaskGraphDeclarationReadView(graph).declarationRevision(), firstRevision);

    Array<GpuTaskResourceUse, 1> resourceUses = Array<GpuTaskResourceUse, 1>();
    resourceUses[0u] = GpuResVersionResourceUse(resource, range, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read);
    Array<GpuTaskResourceVersionUse, 1> versionUses = Array<GpuTaskResourceVersionUse, 1>();
    versionUses[0u] = GpuResVersionUse(first, GpuTaskResourceVersionRole::Consume);
    const Expected<GpuTaskId> taskResult = GpuResVersionAddTask(
        s_GpuCaseTaskGraphResourceVersionStorageTask,
        resourceUses,
        versionUses,
        Span<GpuTaskId>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(taskResult.has_value());
    const GpuTaskId task = taskResult.value();
    ASSERT_TRUE(task.valid());
    versionUses[0u].version = second;
    versionUses[0u].role = GpuTaskResourceVersionRole::Produce;
    u64 generation = 0u;
    u64 declarationRevision = 0u;
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        ASSERT_TRUE(declarations.valid());
        const GpuTaskGraphTaskView taskView = declarations.taskAt(task.index);
        ASSERT_EQ(taskView.resourceVersionUseCount, 1u);
        native(in taskView, in first){
            ASSERT_NE(taskView.resourceVersionUses, nullptr);
            EXPECT_EQ(taskView.resourceVersionUses[0].version, first);
            EXPECT_EQ(taskView.resourceVersionUses[0].role, Core::GpuTaskResourceVersionRole::Consume);
        }
        generation = declarations.generation();
        declarationRevision = declarations.declarationRevision();
    }
    graph.reset();
    const GpuTaskGraphDeclarationReadView resetDeclarations = GpuTaskGraphDeclarationReadView(graph);
    ASSERT_TRUE(resetDeclarations.valid());
    EXPECT_NE(resetDeclarations.generation(), generation);
    EXPECT_NE(resetDeclarations.declarationRevision(), declarationRevision);
    EXPECT_EQ(resetDeclarations.taskCount(), 0u);
    EXPECT_EQ(resetDeclarations.resourceCount(), 0u);
    EXPECT_EQ(resetDeclarations.resourceVersionCount(), 0u);
    EXPECT_FALSE(resetDeclarations.validTask(task));
    EXPECT_FALSE(resetDeclarations.validResourceVersion(first));
    EXPECT_FALSE(resetDeclarations.validResourceVersion(second));
}

void VerifyGpuResVersion_RejectsMissingAndDuplicateTaskProducedVersionProducers(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuResourceVersionScratch);

    {
        GpuResVersionTestArena testArena = GpuResVersionTestArena();
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        const Expected<GpuGraphResourceId> resourceResult = GpuResVersionAddBuffer(graph, s_GpuCaseTaskGraphResourceVersionMissingProducerResource);
        ASSERT_TRUE(resourceResult.has_value());
        const GpuGraphResourceId resource = resourceResult.value();
        const Expected<GpuGraphResourceVersionId> versionResult = GpuResVersionAddVersion(graph, resource, GpuGraphResourceVersionOrigin::TaskProduced);
        ASSERT_TRUE(versionResult.has_value());
        const GpuGraphResourceVersionId version = versionResult.value();
        ASSERT_TRUE(resource.valid());
        ASSERT_TRUE(version.valid());
        Array<GpuTaskResourceUse, 1> resourceUses = Array<GpuTaskResourceUse, 1>();
        resourceUses[0u] = GpuResVersionResourceUse(resource, GpuResVersionBufferRange(0u, 64u), ResourceStates::ShaderResource, GpuTaskResourceAccess::Read);
        Array<GpuTaskResourceVersionUse, 1> versionUses = Array<GpuTaskResourceVersionUse, 1>();
        versionUses[0u] = GpuResVersionUse(version, GpuTaskResourceVersionRole::Consume);
        {
            const Expected<GpuTaskId> gpuTaskAdmission = GpuResVersionAddTask(
                s_GpuCaseTaskGraphResourceVersionMissingProducerConsumer,
                resourceUses,
                versionUses,
                Span<GpuTaskId>(),
                Span<GpuExternalCompletionId>(),
                graph
            );
            ASSERT_TRUE(gpuTaskAdmission.has_value());
            ASSERT_TRUE(gpuTaskAdmission.value().valid());
        }

        GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
        EXPECT_FALSE(Analyze(graph, operationScratchArena, analysis));
        EXPECT_EQ(analysis.diagnostic().status, GpuTaskGraphAnalysisStatus::MissingResourceVersionProducer);
        EXPECT_EQ(analysis.diagnostic().resource, resource);
        EXPECT_EQ(analysis.diagnostic().resourceVersion, version);
    }

    {
        GpuResVersionTestArena testArena = GpuResVersionTestArena();
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        const Expected<GpuGraphResourceId> resourceResult = GpuResVersionAddBuffer(graph, s_GpuCaseTaskGraphResourceVersionDuplicateProducerResource);
        ASSERT_TRUE(resourceResult.has_value());
        const GpuGraphResourceId resource = resourceResult.value();
        const Expected<GpuGraphResourceVersionId> versionResult = GpuResVersionAddVersion(graph, resource, GpuGraphResourceVersionOrigin::TaskProduced);
        ASSERT_TRUE(versionResult.has_value());
        const GpuGraphResourceVersionId version = versionResult.value();
        ASSERT_TRUE(resource.valid());
        ASSERT_TRUE(version.valid());
        Array<GpuTaskResourceUse, 1> resourceUses = Array<GpuTaskResourceUse, 1>();
        resourceUses[0u] = GpuResVersionResourceUse(resource, GpuResVersionBufferRange(0u, 64u), ResourceStates::UnorderedAccess, GpuTaskResourceAccess::Write);
        Array<GpuTaskResourceVersionUse, 1> versionUses = Array<GpuTaskResourceVersionUse, 1>();
        versionUses[0u] = GpuResVersionUse(version, GpuTaskResourceVersionRole::Produce);
        const Expected<GpuTaskId> firstResult = GpuResVersionAddTask(
            s_GpuCaseTaskGraphResourceVersionDuplicateProducerFirst,
            resourceUses,
            versionUses,
            Span<GpuTaskId>(),
            Span<GpuExternalCompletionId>(),
            graph
        );
        ASSERT_TRUE(firstResult.has_value());
        const GpuTaskId first = firstResult.value();
        const Expected<GpuTaskId> secondResult = GpuResVersionAddTask(
            s_GpuCaseTaskGraphResourceVersionDuplicateProducerSecond,
            resourceUses,
            versionUses,
            Span<GpuTaskId>(),
            Span<GpuExternalCompletionId>(),
            graph
        );
        ASSERT_TRUE(secondResult.has_value());
        const GpuTaskId second = secondResult.value();
        ASSERT_TRUE(first.valid());
        ASSERT_TRUE(second.valid());

        GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
        EXPECT_FALSE(Analyze(graph, operationScratchArena, analysis));
        EXPECT_EQ(analysis.diagnostic().status, GpuTaskGraphAnalysisStatus::DuplicateResourceVersionProducer);
        EXPECT_EQ(analysis.diagnostic().task, second);
        EXPECT_EQ(analysis.diagnostic().relatedTask, first);
        EXPECT_EQ(analysis.diagnostic().resource, resource);
        EXPECT_EQ(analysis.diagnostic().resourceVersion, version);
    }
}

void VerifyGpuResVersion_RejectsInvalidVersionDeclarations(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuResourceVersionScratch);

    {
        GpuResVersionTestArena testArena = GpuResVersionTestArena();
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        const Expected<GpuGraphResourceId> resourceResult = GpuResVersionAddBuffer(graph, s_GpuCaseTaskGraphResourceVersionInvalidOriginResource);
        ASSERT_TRUE(resourceResult.has_value());
        const GpuGraphResourceId resource = resourceResult.value();
        ASSERT_TRUE(resource.valid());
        GpuGraphResourceVersionDesc versionDesc = GpuGraphResourceVersionDesc();
        versionDesc.setResource(resource);
        versionDesc.setRange(GpuResVersionBufferRange(0u, 64u));
        const Expected<GpuGraphResourceVersionId> versionResult = graph.declareResourceVersion(versionDesc);
        ASSERT_TRUE(versionResult.has_value());
        const GpuGraphResourceVersionId version = versionResult.value();
        ASSERT_TRUE(version.valid());
        GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
        EXPECT_FALSE(Analyze(graph, operationScratchArena, analysis));
        EXPECT_EQ(analysis.diagnostic().status, GpuTaskGraphAnalysisStatus::InvalidResourceVersion);
        EXPECT_EQ(analysis.diagnostic().resource, resource);
        EXPECT_EQ(analysis.diagnostic().resourceVersion, version);
    }

    {
        GpuResVersionTestArena testArena = GpuResVersionTestArena();
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        const Expected<GpuGraphResourceId> staleResourceResult = GpuResVersionAddBuffer(graph, s_GpuCaseTaskGraphResourceVersionStaleVersionResource);
        ASSERT_TRUE(staleResourceResult.has_value());
        const GpuGraphResourceId staleResource = staleResourceResult.value();
        ASSERT_TRUE(staleResource.valid());
        graph.reset();
        const Expected<GpuGraphResourceVersionId> versionResult = GpuResVersionAddVersion(graph, staleResource, GpuGraphResourceVersionOrigin::ImportedRoot);
        ASSERT_TRUE(versionResult.has_value());
        const GpuGraphResourceVersionId version = versionResult.value();
        ASSERT_TRUE(version.valid());
        GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
        EXPECT_FALSE(Analyze(graph, operationScratchArena, analysis));
        EXPECT_EQ(analysis.diagnostic().status, GpuTaskGraphAnalysisStatus::InvalidResourceVersion);
        EXPECT_EQ(analysis.diagnostic().resource, staleResource);
        EXPECT_EQ(analysis.diagnostic().resourceVersion, version);
    }

    {
        GpuResVersionTestArena testArena = GpuResVersionTestArena();
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        const Expected<GpuGraphResourceId> resourceResult = GpuResVersionAddBuffer(graph, s_GpuCaseTaskGraphResourceVersionInvalidRangeResource);
        ASSERT_TRUE(resourceResult.has_value());
        const GpuGraphResourceId resource = resourceResult.value();
        ASSERT_TRUE(resource.valid());
        const Expected<GpuGraphResourceVersionId> versionResult = GpuResVersionAddVersionRange(
            graph,
            resource,
            GpuGraphResourceVersionOrigin::ImportedRoot,
            GpuResVersionBufferRange(0u, 0u)
        );
        ASSERT_TRUE(versionResult.has_value());
        const GpuGraphResourceVersionId version = versionResult.value();
        ASSERT_TRUE(version.valid());
        GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
        EXPECT_FALSE(Analyze(graph, operationScratchArena, analysis));
        EXPECT_EQ(analysis.diagnostic().status, GpuTaskGraphAnalysisStatus::InvalidResourceVersion);
        EXPECT_EQ(analysis.diagnostic().resource, resource);
        EXPECT_EQ(analysis.diagnostic().resourceVersion, version);
    }

    {
        GpuResVersionTestArena testArena = GpuResVersionTestArena();
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        GpuGraphResourceDesc resourceDesc = GpuGraphResourceDesc();
        resourceDesc.setIdentity(s_GpuCaseTaskGraphResourceVersionInvalidMetadataTextureRange);
        resourceDesc.setMarkerLabel("Invalid Metadata Texture Version Range");
        resourceDesc.setType(GpuGraphResourceType::Texture);
        resourceDesc.setInitialState(ResourceStates::Common);
        const Expected<GpuGraphResourceId> resourceResult = graph.importResource(resourceDesc);
        ASSERT_TRUE(resourceResult.has_value());
        const GpuGraphResourceId resource = resourceResult.value();
        ASSERT_TRUE(resource.valid());
        GpuTaskResourceRange invalidRange = GpuTaskResourceRange();
        invalidRange.textureSubresources = TextureSubresourceSet(0u, 0u, 0u, 0u);
        GpuGraphResourceVersionDesc versionDesc = GpuGraphResourceVersionDesc();
        versionDesc.setResource(resource);
        versionDesc.setRange(invalidRange);
        versionDesc.setOrigin(GpuGraphResourceVersionOrigin::ImportedRoot);
        const Expected<GpuGraphResourceVersionId> versionResult = graph.declareResourceVersion(versionDesc);
        ASSERT_TRUE(versionResult.has_value());
        const GpuGraphResourceVersionId version = versionResult.value();
        ASSERT_TRUE(version.valid());
        GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
        EXPECT_FALSE(Analyze(graph, operationScratchArena, analysis));
        EXPECT_EQ(analysis.diagnostic().status, GpuTaskGraphAnalysisStatus::InvalidResourceVersion);
        EXPECT_EQ(analysis.diagnostic().resource, resource);
        EXPECT_EQ(analysis.diagnostic().resourceVersion, version);
    }
}

void VerifyGpuResVersion_RejectsStaleRoleAccessAndRangeVersionUses(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuResourceVersionScratch);

    {
        GpuResVersionTestArena testArena = GpuResVersionTestArena();
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        const Expected<GpuGraphResourceId> oldResourceResult = GpuResVersionAddBuffer(graph, s_GpuCaseTaskGraphResourceVersionStaleUseOldResource);
        ASSERT_TRUE(oldResourceResult.has_value());
        const GpuGraphResourceId oldResource = oldResourceResult.value();
        const Expected<GpuGraphResourceVersionId> staleVersionResult = GpuResVersionAddVersion(graph, oldResource, GpuGraphResourceVersionOrigin::ImportedRoot);
        ASSERT_TRUE(staleVersionResult.has_value());
        const GpuGraphResourceVersionId staleVersion = staleVersionResult.value();
        ASSERT_TRUE(oldResource.valid());
        ASSERT_TRUE(staleVersion.valid());
        graph.reset();
        const Expected<GpuGraphResourceId> resourceResult = GpuResVersionAddBuffer(graph, s_GpuCaseTaskGraphResourceVersionStaleUseResource);
        ASSERT_TRUE(resourceResult.has_value());
        const GpuGraphResourceId resource = resourceResult.value();
        Array<GpuTaskResourceUse, 1> resourceUses = Array<GpuTaskResourceUse, 1>();
        resourceUses[0u] = GpuResVersionResourceUse(resource, GpuResVersionBufferRange(0u, 64u), ResourceStates::ShaderResource, GpuTaskResourceAccess::Read);
        Array<GpuTaskResourceVersionUse, 1> versionUses = Array<GpuTaskResourceVersionUse, 1>();
        versionUses[0u] = GpuResVersionUse(staleVersion, GpuTaskResourceVersionRole::Consume);
        const Expected<GpuTaskId> taskResult = GpuResVersionAddTask(
            s_GpuCaseTaskGraphResourceVersionStaleUseTask,
            resourceUses,
            versionUses,
            Span<GpuTaskId>(),
            Span<GpuExternalCompletionId>(),
            graph
        );
        ASSERT_TRUE(taskResult.has_value());
        const GpuTaskId task = taskResult.value();
        ASSERT_TRUE(resource.valid());
        ASSERT_TRUE(task.valid());
        GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
        EXPECT_FALSE(Analyze(graph, operationScratchArena, analysis));
        EXPECT_EQ(analysis.diagnostic().status, GpuTaskGraphAnalysisStatus::InvalidResourceVersionUse);
        EXPECT_EQ(analysis.diagnostic().task, task);
        EXPECT_EQ(analysis.diagnostic().resourceVersion, staleVersion);
    }

    Array<usize, 2> duplicateBindingCounts = Array<usize, 2>();
    duplicateBindingCounts[0u] = 2u;
    duplicateBindingCounts[1u] = 10u;
    for(in usize bindingCount : duplicateBindingCounts){
        const ScopedTestTrace trace = ScopedTestTrace(bindingCount);
        GpuResVersionTestArena testArena = GpuResVersionTestArena();
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        const Expected<GpuGraphResourceId> resourceResult = GpuResVersionAddBuffer(graph, s_GpuCaseTaskGraphResourceVersionDuplicateBindingResource);
        ASSERT_TRUE(resourceResult.has_value());
        const GpuGraphResourceId resource = resourceResult.value();
        ASSERT_TRUE(resource.valid());
        Array<GpuTaskResourceVersionUse, 10> versionUses = Array<GpuTaskResourceVersionUse, 10>();
        ASSERT_LE(bindingCount, versionUses.size());
        for(usize index = 0u; index + 1u < bindingCount; ++index){
            const Expected<GpuGraphResourceVersionId> versionResult = GpuResVersionAddVersion(graph, resource, GpuGraphResourceVersionOrigin::ImportedRoot);
            ASSERT_TRUE(versionResult.has_value());
            const GpuGraphResourceVersionId version = versionResult.value();
            ASSERT_TRUE(version.valid());
            versionUses[index] = GpuResVersionUse(version, GpuTaskResourceVersionRole::Consume);
        }
        versionUses[bindingCount - 1u] = versionUses[0u];
        Array<GpuTaskResourceUse, 1> resourceUses = Array<GpuTaskResourceUse, 1>();
        resourceUses[0u] = GpuResVersionResourceUse(resource, GpuResVersionBufferRange(0u, 64u), ResourceStates::ShaderResource, GpuTaskResourceAccess::Read);
        if(bindingCount == versionUses.size()){
            const Expected<GpuTaskId> precedingTaskResult = GpuResVersionAddTask(
                s_GpuCaseTaskGraphResourceVersionValidBindingsBeforeDuplicate,
                resourceUses,
                GpuResVersionPrefixSpan(versionUses, bindingCount - 1u),
                Span<GpuTaskId>(),
                Span<GpuExternalCompletionId>(),
                graph
            );
            ASSERT_TRUE(precedingTaskResult.has_value());
            const GpuTaskId precedingTask = precedingTaskResult.value();
            ASSERT_TRUE(precedingTask.valid());
        }
        const Expected<GpuTaskId> taskResult = GpuResVersionAddTask(
            s_GpuCaseTaskGraphResourceVersionDuplicateBindingTask,
            resourceUses,
            GpuResVersionPrefixSpan(versionUses, bindingCount),
            Span<GpuTaskId>(),
            Span<GpuExternalCompletionId>(),
            graph
        );
        ASSERT_TRUE(taskResult.has_value());
        const GpuTaskId task = taskResult.value();
        ASSERT_TRUE(task.valid());

        GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
        EXPECT_FALSE(Analyze(graph, operationScratchArena, analysis));
        EXPECT_EQ(analysis.diagnostic().status, GpuTaskGraphAnalysisStatus::InvalidResourceVersionUse);
        EXPECT_EQ(analysis.diagnostic().task, task);
        EXPECT_EQ(analysis.diagnostic().resource, resource);
        EXPECT_EQ(analysis.diagnostic().resourceVersion, versionUses[0u].version);
    }

    GpuResVersionExpectInvalidBoundUse(
        s_GpuCaseTaskGraphResourceVersionInvalidRole,
        GpuGraphResourceVersionOrigin::ImportedRoot,
        GpuResVersionBufferRange(0u, 64u),
        GpuResVersionBufferRange(0u, 64u),
        GpuTaskResourceAccess::Read,
        s_GpuResVersionInvalidRole
    );
    GpuResVersionExpectInvalidBoundUse(
        s_GpuCaseTaskGraphResourceVersionImportedRootProducer,
        GpuGraphResourceVersionOrigin::ImportedRoot,
        GpuResVersionBufferRange(0u, 64u),
        GpuResVersionBufferRange(0u, 64u),
        GpuTaskResourceAccess::Write,
        GpuTaskResourceVersionRole::Produce
    );
    GpuResVersionExpectInvalidBoundUse(
        s_GpuCaseTaskGraphResourceVersionInvalidAccess,
        GpuGraphResourceVersionOrigin::TaskProduced,
        GpuResVersionBufferRange(0u, 64u),
        GpuResVersionBufferRange(0u, 64u),
        GpuTaskResourceAccess::Read,
        GpuTaskResourceVersionRole::Produce
    );
    GpuResVersionExpectInvalidBoundUse(
        s_GpuCaseTaskGraphResourceVersionUncoveredRange,
        GpuGraphResourceVersionOrigin::ImportedRoot,
        GpuResVersionBufferRange(16u, 32u),
        GpuResVersionBufferRange(0u, 16u),
        GpuTaskResourceAccess::Read,
        GpuTaskResourceVersionRole::Consume
    );
}

void VerifyGpuResVersion_OrdersConsumerBeforeProducerAndPublishesCompileStatistics(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuResourceVersionScratch);

    GpuResVersionTestArena testArena = GpuResVersionTestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuGraphResourceId> resourceResult = GpuResVersionAddBuffer(graph, s_GpuCaseTaskGraphResourceVersionOrderedResource);
    ASSERT_TRUE(resourceResult.has_value());
    const GpuGraphResourceId resource = resourceResult.value();
    ASSERT_TRUE(resource.valid());
    const GpuTaskResourceRange versionRange = GpuResVersionBufferRange(16u, 32u);
    const Expected<GpuGraphResourceVersionId> versionResult = GpuResVersionAddVersionRange(
        graph,
        resource,
        GpuGraphResourceVersionOrigin::TaskProduced,
        versionRange
    );
    ASSERT_TRUE(versionResult.has_value());
    const GpuGraphResourceVersionId version = versionResult.value();
    ASSERT_TRUE(version.valid());

    Array<GpuTaskResourceUse, 1> consumerResourceUses = Array<GpuTaskResourceUse, 1>();
    consumerResourceUses[0u] = GpuResVersionResourceUse(resource, versionRange, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read);
    Array<GpuTaskResourceVersionUse, 1> consumerVersionUses = Array<GpuTaskResourceVersionUse, 1>();
    consumerVersionUses[0u] = GpuResVersionUse(version, GpuTaskResourceVersionRole::Consume);
    const Expected<GpuTaskId> consumerResult = GpuResVersionAddTask(
        s_GpuCaseTaskGraphResourceVersionOrderedConsumer,
        consumerResourceUses,
        consumerVersionUses,
        Span<GpuTaskId>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(consumerResult.has_value());
    const GpuTaskId consumer = consumerResult.value();
    ASSERT_TRUE(consumer.valid());

    const GpuResVersionProducerUses producerUses = GpuResVersionMakeProducerUses(resource, version);
    Array<GpuTaskResourceUse, 1> producerResourceUses = Array<GpuTaskResourceUse, 1>();
    producerResourceUses[0u] = producerUses.resourceUse;
    Array<GpuTaskResourceVersionUse, 1> producerVersionUses = Array<GpuTaskResourceVersionUse, 1>();
    producerVersionUses[0u] = producerUses.versionUse;
    const Expected<GpuTaskId> producerResult = GpuResVersionAddTask(
        s_GpuCaseTaskGraphResourceVersionOrderedProducer,
        producerResourceUses,
        producerVersionUses,
        Span<GpuTaskId>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(producerResult.has_value());
    const GpuTaskId producer = producerResult.value();
    ASSERT_TRUE(producer.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(GpuResVersionCompile(analysis, assignments, compiledGraph, operationScratchArena, graph));
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        ASSERT_TRUE(declarations.valid());
        ASSERT_TRUE(analysis.validFor(declarations));
    }
    ASSERT_EQ(analysis.topologicalOrder().size(), 2u);
    EXPECT_EQ(analysis.topologicalOrder()[0u], producer);
    EXPECT_EQ(analysis.topologicalOrder()[1u], consumer);
    EXPECT_TRUE(GpuResVersionHasEdge(analysis, producer, consumer, resource, version, GpuTaskHazardType::VersionDependency));
    EXPECT_EQ(analysis.resourceVersionEdgeCount(), 1u);
    EXPECT_TRUE(analysis.hasInferredEdge(producer, consumer));
}

void VerifyGpuResVersion_ExportsDependencyAndLifetimeReasonsWithExplicitOverlap(){
    ScratchArena scratchArena = ScratchArena(s_TaskGpuResourceVersionScratch);

    GpuResVersionTestArena testArena = GpuResVersionTestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuGraphResourceId> resourceResult = GpuResVersionAddBuffer(graph, s_GpuCaseTaskGraphResourceVersionTelemetryResource);
    ASSERT_TRUE(resourceResult.has_value());
    const GpuGraphResourceId resource = resourceResult.value();
    const Expected<GpuGraphResourceVersionId> versionResult = GpuResVersionAddVersionRange(
        graph,
        resource,
        GpuGraphResourceVersionOrigin::TaskProduced,
        GpuResVersionBufferRange(0u, 64u)
    );
    ASSERT_TRUE(versionResult.has_value());
    const GpuGraphResourceVersionId version = versionResult.value();
    ASSERT_TRUE(resource.valid());
    ASSERT_TRUE(version.valid());

    const GpuResVersionProducerUses producerUses = GpuResVersionMakeProducerUses(resource, version);
    Array<GpuTaskResourceUse, 1> producerResourceUses = Array<GpuTaskResourceUse, 1>();
    producerResourceUses[0u] = producerUses.resourceUse;
    Array<GpuTaskResourceVersionUse, 1> producerVersionUses = Array<GpuTaskResourceVersionUse, 1>();
    producerVersionUses[0u] = producerUses.versionUse;
    const Expected<GpuTaskId> producerResult = GpuResVersionAddTask(
        s_GpuCaseTaskGraphResourceVersionTelemetryProducer,
        producerResourceUses,
        producerVersionUses,
        Span<GpuTaskId>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(producerResult.has_value());
    const GpuTaskId producer = producerResult.value();
    ASSERT_TRUE(producer.valid());

    const GpuResVersionConsumerUses consumerUses = GpuResVersionMakeConsumerUses(resource, version);
    Array<GpuTaskResourceUse, 1> consumerResourceUses = Array<GpuTaskResourceUse, 1>();
    consumerResourceUses[0u] = consumerUses.resourceUse;
    Array<GpuTaskResourceVersionUse, 1> consumerVersionUses = Array<GpuTaskResourceVersionUse, 1>();
    consumerVersionUses[0u] = consumerUses.versionUse;
    Array<GpuTaskId, 1> consumerDeps = Array<GpuTaskId, 1>();
    consumerDeps[0u] = producer;
    const Expected<GpuTaskId> consumerResult = GpuResVersionAddTask(
        s_GpuCaseTaskGraphResourceVersionTelemetryConsumer,
        consumerResourceUses,
        consumerVersionUses,
        consumerDeps,
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(consumerResult.has_value());
    const GpuTaskId consumer = consumerResult.value();
    ASSERT_TRUE(consumer.valid());

    Array<GpuTaskResourceUse, 1> overwriterResourceUses = Array<GpuTaskResourceUse, 1>();
    overwriterResourceUses[0u] = GpuResVersionResourceUse(resource, GpuResVersionBufferRange(0u, 64u), ResourceStates::UnorderedAccess, GpuTaskResourceAccess::Write);
    const Expected<GpuTaskId> overwriterResult = GpuResVersionAddTask(
        s_GpuCaseTaskGraphResourceVersionTelemetryOverwriter,
        overwriterResourceUses,
        Span<GpuTaskResourceVersionUse>(),
        Span<GpuTaskId>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(overwriterResult.has_value());
    const GpuTaskId overwriter = overwriterResult.value();
    ASSERT_TRUE(overwriter.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, scratchArena, analysis));
    EXPECT_TRUE(analysis.hasExplicitEdge(producer, consumer));
    EXPECT_TRUE(GpuResVersionHasEdge(analysis, producer, consumer, resource, version, GpuTaskHazardType::VersionDependency));
    EXPECT_TRUE(GpuResVersionHasEdge(analysis, consumer, overwriter, resource, version, GpuTaskHazardType::VersionLifetime));

    GpuResVersionTelemetryScope telemetry = GpuResVersionTelemetryScope(scratchArena, testArena.arena);
    u32 taskNodeOffset = 0u;
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        ASSERT_TRUE(declarations.valid());
        ASSERT_TRUE(declarations.appendFrameGraphTelemetry(analysis, scratchArena, telemetry.builder));
        taskNodeOffset = cast<u32>(declarations.resourceCount());
    }
    const u32 producerNode = taskNodeOffset + producer.index;
    const u32 consumerNode = taskNodeOffset + consumer.index;
    const u32 overwriterNode = taskNodeOffset + overwriter.index;
    b8 foundDependency = false;
    b8 foundLifetime = false;
    native(in telemetry, in producerNode, in consumerNode, in overwriterNode, mut foundDependency, mut foundLifetime){
        for(const Telemetry::FrameGraphEdgeDesc& edge : telemetry.edges){
            if(edge.kind != Telemetry::FrameGraphEdgeKind::DependsOn)
                continue;
            if(edge.fromNodeIndex == producerNode && edge.toNodeIndex == consumerNode){
                foundDependency = true;
                EXPECT_EQ(
                    edge.flags,
                    Core::GpuTaskGraphTelemetryEdgeFlag::ExplicitDependency
                        | Core::GpuTaskGraphTelemetryEdgeFlag::InferredDependency
                        | Core::GpuTaskGraphTelemetryEdgeFlag::VersionDependency
                );
            }
            if(edge.fromNodeIndex == consumerNode && edge.toNodeIndex == overwriterNode){
                foundLifetime = true;
                EXPECT_EQ(
                    edge.flags,
                    Core::GpuTaskGraphTelemetryEdgeFlag::InferredDependency | Core::GpuTaskGraphTelemetryEdgeFlag::VersionLifetime
                );
            }
        }
    }
    EXPECT_TRUE(foundDependency);
    EXPECT_TRUE(foundLifetime);
}

void VerifyGpuResVersion_DeduplicatesVersionAndPhysicalHazardsInQueueScore(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuResourceVersionScratch);

    GpuResVersionTestArena testArena = GpuResVersionTestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuGraphResourceId> resourceResult = GpuResVersionAddBuffer(graph, s_GpuCaseTaskGraphResourceVersionQueueScoreResource);
    ASSERT_TRUE(resourceResult.has_value());
    const GpuGraphResourceId resource = resourceResult.value();
    const Expected<GpuGraphResourceVersionId> versionResult = GpuResVersionAddVersionRange(
        graph,
        resource,
        GpuGraphResourceVersionOrigin::TaskProduced,
        GpuResVersionBufferRange(0u, 64u)
    );
    ASSERT_TRUE(versionResult.has_value());
    const GpuGraphResourceVersionId version = versionResult.value();
    ASSERT_TRUE(resource.valid());
    ASSERT_TRUE(version.valid());

    const GpuTaskCommandRequirements graphicsCommands = GraphicsCommands();
    const GpuResVersionProducerUses producerUses = GpuResVersionMakeProducerUses(resource, version);
    Array<GpuTaskResourceUse, 1> producerResourceUses = Array<GpuTaskResourceUse, 1>();
    producerResourceUses[0u] = producerUses.resourceUse;
    Array<GpuTaskResourceVersionUse, 1> producerVersionUses = Array<GpuTaskResourceVersionUse, 1>();
    producerVersionUses[0u] = producerUses.versionUse;
    GpuTaskDesc producerDesc = GpuTaskDesc();
    producerDesc.setIdentity(s_GpuVersionScoreProducer);
    producerDesc.setMarkerLabel("Resource Version Queue Score Producer");
    producerDesc.setResourceUses(producerResourceUses);
    producerDesc.setResourceVersionUses(producerVersionUses);
    const Expected<GpuTaskId> producerResult = graph.addTask(producerDesc, graphicsCommands);
    ASSERT_TRUE(producerResult.has_value());
    const GpuTaskId producer = producerResult.value();

    const GpuTaskCommandRequirements computeCommands = ComputeCommands();
    const GpuResVersionConsumerUses consumerUses = GpuResVersionMakeConsumerUses(resource, version);
    Array<GpuTaskResourceUse, 1> consumerResourceUses = Array<GpuTaskResourceUse, 1>();
    consumerResourceUses[0u] = consumerUses.resourceUse;
    Array<GpuTaskResourceVersionUse, 1> consumerVersionUses = Array<GpuTaskResourceVersionUse, 1>();
    consumerVersionUses[0u] = consumerUses.versionUse;
    GpuTaskDesc consumerDesc = GpuTaskDesc();
    consumerDesc.setIdentity(s_GpuVersionScoreConsumer);
    consumerDesc.setMarkerLabel("Resource Version Queue Score Consumer");
    consumerDesc.setResourceUses(consumerResourceUses);
    consumerDesc.setResourceVersionUses(consumerVersionUses);
    const Expected<GpuTaskId> consumerResult = graph.addTask(consumerDesc, computeCommands);
    ASSERT_TRUE(consumerResult.has_value());
    const GpuTaskId consumer = consumerResult.value();
    ASSERT_TRUE(producer.valid());
    ASSERT_TRUE(consumer.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    ASSERT_EQ(analysis.inferredEdges().size(), 2u);
    ASSERT_EQ(analysis.schedulingEdges().size(), 1u);
    b8 foundVersionDependency = false;
    b8 foundPhysicalRaw = false;
    const Span<GpuTaskDependencyEdge> inferredEdges = analysis.inferredEdges();
    for(usize index = 0u; index < inferredEdges.size(); ++index){
        const GpuTaskDependencyEdge edge = inferredEdges[index];
        if(edge.hazard == GpuTaskHazardType::VersionDependency)
            foundVersionDependency = true;
        if(edge.hazard == GpuTaskHazardType::ReadAfterWrite)
            foundPhysicalRaw = true;
    }
    EXPECT_TRUE(foundVersionDependency);
    EXPECT_TRUE(foundPhysicalRaw);

    // The graphics queue has no compute support, so the compute consumer must cross queues.
    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue(0u, QueueCapabilities(GpuQueueCapability::Graphics, GpuQueueCapability::Transfer));
    queues[1u] = DedicatedComputeQueue();
    const GpuPhysicalQueueTopology topology = MakeGpuResVersionTopology(queues);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    ASSERT_TRUE(Assign(assignments, operationScratchArena, graph, analysis, topology));
    native(in assignments, in producer, in consumer){
        const Core::GpuTaskQueueAssignment* const producerAssignment = assignments.find(producer);
        const Core::GpuTaskQueueAssignment* const consumerAssignment = assignments.find(consumer);
        ASSERT_NE(producerAssignment, nullptr);
        ASSERT_NE(consumerAssignment, nullptr);
        EXPECT_EQ(producerAssignment->queueClass, Core::CommandQueue::Graphics);
        EXPECT_EQ(producerAssignment->score.outgoingCrossings, 1);
        EXPECT_EQ(producerAssignment->score.ownershipTransfers, 1);
        EXPECT_EQ(consumerAssignment->queueClass, Core::CommandQueue::Compute);
        EXPECT_EQ(consumerAssignment->score.incomingCrossings, 1);
        EXPECT_EQ(consumerAssignment->score.ownershipTransfers, 1);
    }
}

void VerifyGpuResVersion_RetainsExternalCompletionForImportedRootConsumerAndInvalidatesLateAnalysis(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuResourceVersionScratch);

    GpuResVersionTestArena testArena = GpuResVersionTestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuGraphResourceId> resourceResult = GpuResVersionAddBuffer(graph, s_GpuCaseTaskGraphResourceVersionImportedRootResource);
    ASSERT_TRUE(resourceResult.has_value());
    const GpuGraphResourceId resource = resourceResult.value();
    ASSERT_TRUE(resource.valid());
    const Expected<GpuGraphResourceVersionId> versionResult = GpuResVersionAddVersion(graph, resource, GpuGraphResourceVersionOrigin::ImportedRoot);
    ASSERT_TRUE(versionResult.has_value());
    const GpuGraphResourceVersionId version = versionResult.value();
    ASSERT_TRUE(version.valid());

    GpuExternalCompletionDesc completionDesc = GpuExternalCompletionDesc();
    completionDesc.setIdentity(s_GpuCaseTaskGraphResourceVersionImportedRootCompletion);
    completionDesc.setMarkerLabel("Imported Root Completion");
    const Expected<GpuExternalCompletionId> completionResult = graph.importExternalCompletion(completionDesc);
    ASSERT_TRUE(completionResult.has_value());
    const GpuExternalCompletionId completion = completionResult.value();
    ASSERT_TRUE(completion.valid());

    Array<GpuTaskResourceUse, 1> resourceUses = Array<GpuTaskResourceUse, 1>();
    resourceUses[0u] = GpuResVersionResourceUse(resource, GpuResVersionBufferRange(0u, 64u), ResourceStates::ShaderResource, GpuTaskResourceAccess::Read);
    Array<GpuTaskResourceVersionUse, 1> versionUses = Array<GpuTaskResourceVersionUse, 1>();
    versionUses[0u] = GpuResVersionUse(version, GpuTaskResourceVersionRole::Consume);
    Array<GpuExternalCompletionId, 1> externalDeps = Array<GpuExternalCompletionId, 1>();
    externalDeps[0u] = completion;
    const Expected<GpuTaskId> consumerResult = GpuResVersionAddTask(
        s_GpuCaseTaskGraphResourceVersionImportedRootConsumer,
        resourceUses,
        versionUses,
        Span<GpuTaskId>(),
        externalDeps,
        graph
    );
    ASSERT_TRUE(consumerResult.has_value());
    const GpuTaskId consumer = consumerResult.value();
    ASSERT_TRUE(consumer.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    EXPECT_EQ(analysis.resourceVersionEdgeCount(), 0u);
    ASSERT_EQ(analysis.externalDependencies().size(), 1u);
    u64 analyzedRevision = 0u;
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        ASSERT_TRUE(declarations.valid());
        ASSERT_TRUE(analysis.validFor(declarations));
        analyzedRevision = declarations.declarationRevision();
    }
    const Expected<GpuGraphResourceVersionId> lateVersionResult = GpuResVersionAddVersion(graph, resource, GpuGraphResourceVersionOrigin::ImportedRoot);
    ASSERT_TRUE(lateVersionResult.has_value());
    const GpuGraphResourceVersionId lateVersion = lateVersionResult.value();
    ASSERT_TRUE(lateVersion.valid());
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        ASSERT_TRUE(declarations.valid());
        EXPECT_NE(declarations.declarationRevision(), analyzedRevision);
        EXPECT_FALSE(analysis.validFor(declarations));
    }
}

void VerifyGpuResVersion_ReportsClosedPureResourceVersionCycle(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuResourceVersionScratch);

    GpuResVersionTestArena testArena = GpuResVersionTestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuGraphResourceId> resourceAResult = GpuResVersionAddBuffer(graph, s_GpuCaseTaskGraphResourceVersionPureCycleResourceA);
    ASSERT_TRUE(resourceAResult.has_value());
    const GpuGraphResourceId resourceA = resourceAResult.value();
    const Expected<GpuGraphResourceId> resourceBResult = GpuResVersionAddBuffer(graph, s_GpuCaseTaskGraphResourceVersionPureCycleResourceB);
    ASSERT_TRUE(resourceBResult.has_value());
    const GpuGraphResourceId resourceB = resourceBResult.value();
    const Expected<GpuGraphResourceVersionId> versionAResult = GpuResVersionAddVersion(graph, resourceA, GpuGraphResourceVersionOrigin::TaskProduced);
    ASSERT_TRUE(versionAResult.has_value());
    const GpuGraphResourceVersionId versionA = versionAResult.value();
    const Expected<GpuGraphResourceVersionId> versionBResult = GpuResVersionAddVersion(graph, resourceB, GpuGraphResourceVersionOrigin::TaskProduced);
    ASSERT_TRUE(versionBResult.has_value());
    const GpuGraphResourceVersionId versionB = versionBResult.value();
    ASSERT_TRUE(resourceA.valid());
    ASSERT_TRUE(resourceB.valid());
    ASSERT_TRUE(versionA.valid());
    ASSERT_TRUE(versionB.valid());

    Array<GpuTaskResourceUse, 2> resourceUsesA = Array<GpuTaskResourceUse, 2>();
    resourceUsesA[0u] = GpuResVersionResourceUse(resourceA, GpuResVersionBufferRange(0u, 64u), ResourceStates::UnorderedAccess, GpuTaskResourceAccess::Write);
    resourceUsesA[1u] = GpuResVersionResourceUse(resourceB, GpuResVersionBufferRange(0u, 64u), ResourceStates::ShaderResource, GpuTaskResourceAccess::Read);
    Array<GpuTaskResourceVersionUse, 2> versionUsesA = Array<GpuTaskResourceVersionUse, 2>();
    versionUsesA[0u] = GpuResVersionUse(versionA, GpuTaskResourceVersionRole::Produce);
    versionUsesA[1u] = GpuResVersionUse(versionB, GpuTaskResourceVersionRole::Consume);
    const Expected<GpuTaskId> taskAResult = GpuResVersionAddTask(
        s_GpuCaseTaskGraphResourceVersionPureCycleTaskA,
        resourceUsesA,
        versionUsesA,
        Span<GpuTaskId>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(taskAResult.has_value());
    const GpuTaskId taskA = taskAResult.value();

    Array<GpuTaskResourceUse, 2> resourceUsesB = Array<GpuTaskResourceUse, 2>();
    resourceUsesB[0u] = GpuResVersionResourceUse(resourceB, GpuResVersionBufferRange(0u, 64u), ResourceStates::UnorderedAccess, GpuTaskResourceAccess::Write);
    resourceUsesB[1u] = GpuResVersionResourceUse(resourceA, GpuResVersionBufferRange(0u, 64u), ResourceStates::ShaderResource, GpuTaskResourceAccess::Read);
    Array<GpuTaskResourceVersionUse, 2> versionUsesB = Array<GpuTaskResourceVersionUse, 2>();
    versionUsesB[0u] = GpuResVersionUse(versionB, GpuTaskResourceVersionRole::Produce);
    versionUsesB[1u] = GpuResVersionUse(versionA, GpuTaskResourceVersionRole::Consume);
    const Expected<GpuTaskId> taskBResult = GpuResVersionAddTask(
        s_GpuCaseTaskGraphResourceVersionPureCycleTaskB,
        resourceUsesB,
        versionUsesB,
        Span<GpuTaskId>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(taskBResult.has_value());
    const GpuTaskId taskB = taskBResult.value();
    ASSERT_TRUE(taskA.valid());
    ASSERT_TRUE(taskB.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    EXPECT_FALSE(Analyze(graph, operationScratchArena, analysis));
    EXPECT_EQ(analysis.diagnostic().status, GpuTaskGraphAnalysisStatus::Cycle);
    EXPECT_EQ(analysis.resourceVersionEdgeCount(), 2u);
    GpuResVersionExpectClosedCycle(analysis);
    const Span<GpuTaskDependencyEdge> cycleEdges = analysis.cycleEdges();
    for(usize index = 0u; index < cycleEdges.size(); ++index){
        const GpuTaskDependencyEdge edge = cycleEdges[index];
        EXPECT_EQ(edge.hazard, GpuTaskHazardType::VersionDependency);
        EXPECT_TRUE(edge.resource.valid());
        EXPECT_TRUE(edge.resourceVersion.valid());
    }
    GpuResVersionExpectDiagnosticMatchesCycleEdge(analysis);
}

void VerifyGpuResVersion_ReportsClosedMixedExplicitAndResourceVersionCycle(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuResourceVersionScratch);

    GpuResVersionTestArena testArena = GpuResVersionTestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuGraphResourceId> resourceResult = GpuResVersionAddBuffer(graph, s_GpuCaseTaskGraphResourceVersionMixedCycleResource);
    ASSERT_TRUE(resourceResult.has_value());
    const GpuGraphResourceId resource = resourceResult.value();
    const Expected<GpuGraphResourceVersionId> versionResult = GpuResVersionAddVersion(graph, resource, GpuGraphResourceVersionOrigin::TaskProduced);
    ASSERT_TRUE(versionResult.has_value());
    const GpuGraphResourceVersionId version = versionResult.value();
    ASSERT_TRUE(resource.valid());
    ASSERT_TRUE(version.valid());

    const GpuResVersionConsumerUses consumerUses = GpuResVersionMakeConsumerUses(resource, version);
    Array<GpuTaskResourceUse, 1> consumerResourceUses = Array<GpuTaskResourceUse, 1>();
    consumerResourceUses[0u] = consumerUses.resourceUse;
    Array<GpuTaskResourceVersionUse, 1> consumerVersionUses = Array<GpuTaskResourceVersionUse, 1>();
    consumerVersionUses[0u] = consumerUses.versionUse;
    const Expected<GpuTaskId> consumerResult = GpuResVersionAddTask(
        s_GpuCaseTaskGraphResourceVersionMixedCycleConsumer,
        consumerResourceUses,
        consumerVersionUses,
        Span<GpuTaskId>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(consumerResult.has_value());
    const GpuTaskId consumer = consumerResult.value();
    ASSERT_TRUE(consumer.valid());

    const GpuResVersionProducerUses producerUses = GpuResVersionMakeProducerUses(resource, version);
    Array<GpuTaskResourceUse, 1> producerResourceUses = Array<GpuTaskResourceUse, 1>();
    producerResourceUses[0u] = producerUses.resourceUse;
    Array<GpuTaskResourceVersionUse, 1> producerVersionUses = Array<GpuTaskResourceVersionUse, 1>();
    producerVersionUses[0u] = producerUses.versionUse;
    Array<GpuTaskId, 1> producerDeps = Array<GpuTaskId, 1>();
    producerDeps[0u] = consumer;
    const Expected<GpuTaskId> producerResult = GpuResVersionAddTask(
        s_GpuCaseTaskGraphResourceVersionMixedCycleProducer,
        producerResourceUses,
        producerVersionUses,
        producerDeps,
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(producerResult.has_value());
    const GpuTaskId producer = producerResult.value();
    ASSERT_TRUE(producer.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    EXPECT_FALSE(Analyze(graph, operationScratchArena, analysis));
    EXPECT_EQ(analysis.diagnostic().status, GpuTaskGraphAnalysisStatus::Cycle);
    EXPECT_EQ(analysis.resourceVersionEdgeCount(), 1u);
    GpuResVersionExpectClosedCycle(analysis);
    b8 foundExplicit = false;
    b8 foundVersion = false;
    const Span<GpuTaskDependencyEdge> cycleEdges = analysis.cycleEdges();
    for(usize index = 0u; index < cycleEdges.size(); ++index){
        const GpuTaskDependencyEdge edge = cycleEdges[index];
        if(edge.hazard == GpuTaskHazardType::Explicit)
            foundExplicit = true;
        if(edge.hazard == GpuTaskHazardType::VersionDependency)
            foundVersion = true;
    }
    EXPECT_TRUE(foundExplicit);
    EXPECT_TRUE(foundVersion);
    EXPECT_EQ(analysis.diagnostic().resource, resource);
    EXPECT_EQ(analysis.diagnostic().resourceVersion, version);
    GpuResVersionExpectDiagnosticMatchesCycleEdge(analysis);
}

void VerifyGpuResVersion_PreservesProducedVersionUntilAllConsumersFinish(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuResourceVersionScratch);

    GpuResVersionTestArena testArena = GpuResVersionTestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuGraphResourceId> resourceResult = GpuResVersionAddBuffer(graph, s_GpuCaseTaskGraphResourceVersionLifetimeResource);
    ASSERT_TRUE(resourceResult.has_value());
    const GpuGraphResourceId resource = resourceResult.value();
    const Expected<GpuGraphResourceVersionId> versionResult = GpuResVersionAddVersionRange(
        graph,
        resource,
        GpuGraphResourceVersionOrigin::TaskProduced,
        GpuResVersionBufferRange(0u, 64u)
    );
    ASSERT_TRUE(versionResult.has_value());
    const GpuGraphResourceVersionId version = versionResult.value();
    ASSERT_TRUE(resource.valid());
    ASSERT_TRUE(version.valid());

    const GpuResVersionProducerUses producerUses = GpuResVersionMakeProducerUses(resource, version);
    Array<GpuTaskResourceUse, 1> producerResourceUses = Array<GpuTaskResourceUse, 1>();
    producerResourceUses[0u] = producerUses.resourceUse;
    Array<GpuTaskResourceVersionUse, 1> producerVersionUses = Array<GpuTaskResourceVersionUse, 1>();
    producerVersionUses[0u] = producerUses.versionUse;
    const Expected<GpuTaskId> producerResult = GpuResVersionAddTask(
        s_GpuCaseTaskGraphResourceVersionLifetimeProducer,
        producerResourceUses,
        producerVersionUses,
        Span<GpuTaskId>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(producerResult.has_value());
    const GpuTaskId producer = producerResult.value();

    Array<GpuTaskResourceUse, 1> clobberResourceUses = Array<GpuTaskResourceUse, 1>();
    clobberResourceUses[0u] = GpuResVersionResourceUse(resource, GpuResVersionBufferRange(16u, 16u), ResourceStates::UnorderedAccess, GpuTaskResourceAccess::Write);
    const Expected<GpuTaskId> clobberResult = GpuResVersionAddTask(
        s_GpuCaseTaskGraphResourceVersionLifetimeClobber,
        clobberResourceUses,
        Span<GpuTaskResourceVersionUse>(),
        Span<GpuTaskId>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(clobberResult.has_value());
    const GpuTaskId clobber = clobberResult.value();

    const GpuResVersionConsumerUses consumerUses = GpuResVersionMakeConsumerUses(resource, version);
    Array<GpuTaskResourceUse, 1> consumerResourceUses = Array<GpuTaskResourceUse, 1>();
    consumerResourceUses[0u] = consumerUses.resourceUse;
    Array<GpuTaskResourceVersionUse, 1> consumerVersionUses = Array<GpuTaskResourceVersionUse, 1>();
    consumerVersionUses[0u] = consumerUses.versionUse;
    const Expected<GpuTaskId> consumerResult = GpuResVersionAddTask(
        s_GpuCaseTaskGraphResourceVersionLifetimeConsumer,
        consumerResourceUses,
        consumerVersionUses,
        Span<GpuTaskId>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(consumerResult.has_value());
    const GpuTaskId consumer = consumerResult.value();
    ASSERT_TRUE(producer.valid());
    ASSERT_TRUE(clobber.valid());
    ASSERT_TRUE(consumer.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    ASSERT_EQ(analysis.topologicalOrder().size(), 3u);
    EXPECT_EQ(analysis.topologicalOrder()[0u], producer);
    EXPECT_EQ(analysis.topologicalOrder()[1u], consumer);
    EXPECT_EQ(analysis.topologicalOrder()[2u], clobber);
    EXPECT_TRUE(GpuResVersionHasEdge(analysis, producer, consumer, resource, version, GpuTaskHazardType::VersionDependency));
    EXPECT_TRUE(GpuResVersionHasEdge(analysis, consumer, clobber, resource, version, GpuTaskHazardType::VersionLifetime));
}

void VerifyGpuResVersion_ReportsExplicitClobberCycleWithVersionLifetimeProvenance(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuResourceVersionScratch);

    GpuResVersionTestArena testArena = GpuResVersionTestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuGraphResourceId> resourceResult = GpuResVersionAddBuffer(graph, s_GpuCaseTaskGraphResourceVersionLifetimeCycleResource);
    ASSERT_TRUE(resourceResult.has_value());
    const GpuGraphResourceId resource = resourceResult.value();
    const Expected<GpuGraphResourceVersionId> versionResult = GpuResVersionAddVersionRange(
        graph,
        resource,
        GpuGraphResourceVersionOrigin::TaskProduced,
        GpuResVersionBufferRange(0u, 64u)
    );
    ASSERT_TRUE(versionResult.has_value());
    const GpuGraphResourceVersionId version = versionResult.value();
    ASSERT_TRUE(resource.valid());
    ASSERT_TRUE(version.valid());

    const GpuResVersionProducerUses producerUses = GpuResVersionMakeProducerUses(resource, version);
    Array<GpuTaskResourceUse, 1> producerResourceUses = Array<GpuTaskResourceUse, 1>();
    producerResourceUses[0u] = producerUses.resourceUse;
    Array<GpuTaskResourceVersionUse, 1> producerVersionUses = Array<GpuTaskResourceVersionUse, 1>();
    producerVersionUses[0u] = producerUses.versionUse;
    const Expected<GpuTaskId> producerResult = GpuResVersionAddTask(
        s_GpuCaseTaskGraphResourceVersionLifetimeCycleProducer,
        producerResourceUses,
        producerVersionUses,
        Span<GpuTaskId>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(producerResult.has_value());
    const GpuTaskId producer = producerResult.value();

    Array<GpuTaskResourceUse, 1> clobberResourceUses = Array<GpuTaskResourceUse, 1>();
    clobberResourceUses[0u] = GpuResVersionResourceUse(resource, GpuResVersionBufferRange(0u, 64u), ResourceStates::CopyDest, GpuTaskResourceAccess::Write);
    Array<GpuTaskId, 1> clobberDeps = Array<GpuTaskId, 1>();
    clobberDeps[0u] = producer;
    const Expected<GpuTaskId> clobberResult = GpuResVersionAddTask(
        s_GpuCaseTaskGraphResourceVersionLifetimeCycleClobber,
        clobberResourceUses,
        Span<GpuTaskResourceVersionUse>(),
        clobberDeps,
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(clobberResult.has_value());
    const GpuTaskId clobber = clobberResult.value();

    const GpuResVersionConsumerUses consumerUses = GpuResVersionMakeConsumerUses(resource, version);
    Array<GpuTaskResourceUse, 1> consumerResourceUses = Array<GpuTaskResourceUse, 1>();
    consumerResourceUses[0u] = consumerUses.resourceUse;
    Array<GpuTaskResourceVersionUse, 1> consumerVersionUses = Array<GpuTaskResourceVersionUse, 1>();
    consumerVersionUses[0u] = consumerUses.versionUse;
    Array<GpuTaskId, 1> consumerDeps = Array<GpuTaskId, 1>();
    consumerDeps[0u] = clobber;
    const Expected<GpuTaskId> consumerResult = GpuResVersionAddTask(
        s_GpuCaseTaskGraphResourceVersionLifetimeCycleConsumer,
        consumerResourceUses,
        consumerVersionUses,
        consumerDeps,
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(consumerResult.has_value());
    const GpuTaskId consumer = consumerResult.value();
    ASSERT_TRUE(producer.valid());
    ASSERT_TRUE(clobber.valid());
    ASSERT_TRUE(consumer.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    EXPECT_FALSE(Analyze(graph, operationScratchArena, analysis));
    EXPECT_EQ(analysis.diagnostic().status, GpuTaskGraphAnalysisStatus::Cycle);
    EXPECT_EQ(analysis.diagnostic().resource, resource);
    EXPECT_EQ(analysis.diagnostic().resourceVersion, version);
    GpuResVersionExpectClosedCycle(analysis);
    b8 foundExplicit = false;
    b8 foundVersionLifetime = false;
    const Span<GpuTaskDependencyEdge> cycleEdges = analysis.cycleEdges();
    for(usize index = 0u; index < cycleEdges.size(); ++index){
        const GpuTaskDependencyEdge edge = cycleEdges[index];
        if(edge.hazard == GpuTaskHazardType::Explicit)
            foundExplicit = true;
        if(edge.hazard != GpuTaskHazardType::VersionLifetime)
            continue;
        foundVersionLifetime = true;
        EXPECT_EQ(edge.resource, resource);
        EXPECT_EQ(edge.resourceVersion, version);
    }
    EXPECT_TRUE(foundExplicit);
    EXPECT_TRUE(foundVersionLifetime);
    GpuResVersionExpectDiagnosticMatchesCycleEdge(analysis);
}

void VerifyGpuResVersion_HonorsExplicitClobberBeforeVersionProducer(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuResourceVersionScratch);

    GpuResVersionTestArena testArena = GpuResVersionTestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuGraphResourceId> resourceResult = GpuResVersionAddBuffer(graph, s_GpuCaseTaskGraphResourceVersionEarlyClobberResource);
    ASSERT_TRUE(resourceResult.has_value());
    const GpuGraphResourceId resource = resourceResult.value();
    const Expected<GpuGraphResourceVersionId> versionResult = GpuResVersionAddVersionRange(
        graph,
        resource,
        GpuGraphResourceVersionOrigin::TaskProduced,
        GpuResVersionBufferRange(0u, 64u)
    );
    ASSERT_TRUE(versionResult.has_value());
    const GpuGraphResourceVersionId version = versionResult.value();
    ASSERT_TRUE(resource.valid());
    ASSERT_TRUE(version.valid());

    Array<GpuTaskResourceUse, 1> clobberResourceUses = Array<GpuTaskResourceUse, 1>();
    clobberResourceUses[0u] = GpuResVersionResourceUse(resource, GpuResVersionBufferRange(0u, 64u), ResourceStates::CopyDest, GpuTaskResourceAccess::Write);
    const Expected<GpuTaskId> clobberResult = GpuResVersionAddTask(
        s_GpuCaseTaskGraphResourceVersionEarlyClobber,
        clobberResourceUses,
        Span<GpuTaskResourceVersionUse>(),
        Span<GpuTaskId>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(clobberResult.has_value());
    const GpuTaskId clobber = clobberResult.value();

    const GpuResVersionProducerUses producerUses = GpuResVersionMakeProducerUses(resource, version);
    Array<GpuTaskResourceUse, 1> producerResourceUses = Array<GpuTaskResourceUse, 1>();
    producerResourceUses[0u] = producerUses.resourceUse;
    Array<GpuTaskResourceVersionUse, 1> producerVersionUses = Array<GpuTaskResourceVersionUse, 1>();
    producerVersionUses[0u] = producerUses.versionUse;
    Array<GpuTaskId, 1> producerDeps = Array<GpuTaskId, 1>();
    producerDeps[0u] = clobber;
    const Expected<GpuTaskId> producerResult = GpuResVersionAddTask(
        s_GpuCaseTaskGraphResourceVersionEarlyClobberProducer,
        producerResourceUses,
        producerVersionUses,
        producerDeps,
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(producerResult.has_value());
    const GpuTaskId producer = producerResult.value();

    const GpuResVersionConsumerUses consumerUses = GpuResVersionMakeConsumerUses(resource, version);
    Array<GpuTaskResourceUse, 1> consumerResourceUses = Array<GpuTaskResourceUse, 1>();
    consumerResourceUses[0u] = consumerUses.resourceUse;
    Array<GpuTaskResourceVersionUse, 1> consumerVersionUses = Array<GpuTaskResourceVersionUse, 1>();
    consumerVersionUses[0u] = consumerUses.versionUse;
    const Expected<GpuTaskId> consumerResult = GpuResVersionAddTask(
        s_GpuCaseTaskGraphResourceVersionEarlyClobberConsumer,
        consumerResourceUses,
        consumerVersionUses,
        Span<GpuTaskId>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(consumerResult.has_value());
    const GpuTaskId consumer = consumerResult.value();
    ASSERT_TRUE(clobber.valid());
    ASSERT_TRUE(producer.valid());
    ASSERT_TRUE(consumer.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    ASSERT_EQ(analysis.topologicalOrder().size(), 3u);
    EXPECT_EQ(analysis.topologicalOrder()[0u], clobber);
    EXPECT_EQ(analysis.topologicalOrder()[1u], producer);
    EXPECT_EQ(analysis.topologicalOrder()[2u], consumer);
    EXPECT_FALSE(GpuResVersionHasEdge(analysis, consumer, clobber, resource, version, GpuTaskHazardType::VersionLifetime));
}

void VerifyGpuResVersion_ProtectsImportedRootConsumerFromLaterClobber(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuResourceVersionScratch);

    GpuResVersionTestArena testArena = GpuResVersionTestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuGraphResourceId> resourceResult = GpuResVersionAddBuffer(graph, s_GpuCaseTaskGraphResourceVersionImportedLifetimeResource);
    ASSERT_TRUE(resourceResult.has_value());
    const GpuGraphResourceId resource = resourceResult.value();
    const Expected<GpuGraphResourceVersionId> versionResult = GpuResVersionAddVersionRange(
        graph,
        resource,
        GpuGraphResourceVersionOrigin::ImportedRoot,
        GpuResVersionBufferRange(0u, 64u)
    );
    ASSERT_TRUE(versionResult.has_value());
    const GpuGraphResourceVersionId version = versionResult.value();
    ASSERT_TRUE(resource.valid());
    ASSERT_TRUE(version.valid());

    const GpuResVersionConsumerUses consumerUses = GpuResVersionMakeConsumerUses(resource, version);
    Array<GpuTaskResourceUse, 1> consumerResourceUses = Array<GpuTaskResourceUse, 1>();
    consumerResourceUses[0u] = consumerUses.resourceUse;
    Array<GpuTaskResourceVersionUse, 1> consumerVersionUses = Array<GpuTaskResourceVersionUse, 1>();
    consumerVersionUses[0u] = consumerUses.versionUse;
    const Expected<GpuTaskId> consumerResult = GpuResVersionAddTask(
        s_GpuCaseTaskGraphResourceVersionImportedLifetimeConsumer,
        consumerResourceUses,
        consumerVersionUses,
        Span<GpuTaskId>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(consumerResult.has_value());
    const GpuTaskId consumer = consumerResult.value();

    Array<GpuTaskResourceUse, 1> clobberResourceUses = Array<GpuTaskResourceUse, 1>();
    clobberResourceUses[0u] = GpuResVersionResourceUse(resource, GpuResVersionBufferRange(0u, 64u), ResourceStates::UnorderedAccess, GpuTaskResourceAccess::Write);
    const Expected<GpuTaskId> clobberResult = GpuResVersionAddTask(
        s_GpuCaseTaskGraphResourceVersionImportedLifetimeClobber,
        clobberResourceUses,
        Span<GpuTaskResourceVersionUse>(),
        Span<GpuTaskId>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(clobberResult.has_value());
    const GpuTaskId clobber = clobberResult.value();
    ASSERT_TRUE(consumer.valid());
    ASSERT_TRUE(clobber.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    ASSERT_EQ(analysis.topologicalOrder().size(), 2u);
    EXPECT_EQ(analysis.topologicalOrder()[0u], consumer);
    EXPECT_EQ(analysis.topologicalOrder()[1u], clobber);
    EXPECT_TRUE(GpuResVersionHasEdge(analysis, consumer, clobber, resource, version, GpuTaskHazardType::VersionLifetime));
    const Span<GpuTaskDependencyEdge> inferredEdges = analysis.inferredEdges();
    for(usize index = 0u; index < inferredEdges.size(); ++index){
        const GpuTaskDependencyEdge edge = inferredEdges[index];
        if(edge.consumer == consumer)
            EXPECT_NE(edge.hazard, GpuTaskHazardType::VersionDependency);
    }
}

void VerifyGpuResVersion_TreatsImportedRootLifetimeWriterAsPreBirthForProducedVersion(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuResourceVersionScratch);

    GpuResVersionTestArena testArena = GpuResVersionTestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const GpuTaskResourceRange versionRange = GpuResVersionBufferRange(0u, 64u);
    const Expected<GpuGraphResourceId> resourceResult = GpuResVersionAddBuffer(graph, s_GpuCaseTaskGraphResourceVersionImportedPrebirthResource);
    ASSERT_TRUE(resourceResult.has_value());
    const GpuGraphResourceId resource = resourceResult.value();
    const Expected<GpuGraphResourceVersionId> importedVersionResult = GpuResVersionAddVersionRange(
        graph,
        resource,
        GpuGraphResourceVersionOrigin::ImportedRoot,
        versionRange
    );
    ASSERT_TRUE(importedVersionResult.has_value());
    const GpuGraphResourceVersionId importedVersion = importedVersionResult.value();
    const Expected<GpuGraphResourceVersionId> producedVersionResult = GpuResVersionAddVersionRange(
        graph,
        resource,
        GpuGraphResourceVersionOrigin::TaskProduced,
        versionRange
    );
    ASSERT_TRUE(producedVersionResult.has_value());
    const GpuGraphResourceVersionId producedVersion = producedVersionResult.value();
    ASSERT_TRUE(resource.valid());
    ASSERT_TRUE(importedVersion.valid());
    ASSERT_TRUE(producedVersion.valid());

    Array<GpuTaskResourceUse, 1> importedConsumerResourceUses = Array<GpuTaskResourceUse, 1>();
    importedConsumerResourceUses[0u] = GpuResVersionResourceUse(resource, versionRange, ResourceStates::UnorderedAccess, GpuTaskResourceAccess::ReadWrite);
    Array<GpuTaskResourceVersionUse, 1> importedConsumerVersionUses = Array<GpuTaskResourceVersionUse, 1>();
    importedConsumerVersionUses[0u] = GpuResVersionUse(importedVersion, GpuTaskResourceVersionRole::Consume);
    const Expected<GpuTaskId> importedConsumerResult = GpuResVersionAddTask(
        s_GpuCaseTaskGraphResourceVersionImportedPrebirthConsumer,
        importedConsumerResourceUses,
        importedConsumerVersionUses,
        Span<GpuTaskId>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(importedConsumerResult.has_value());
    const GpuTaskId importedConsumer = importedConsumerResult.value();

    Array<GpuTaskResourceUse, 1> producerResourceUses = Array<GpuTaskResourceUse, 1>();
    producerResourceUses[0u] = GpuResVersionResourceUse(resource, versionRange, ResourceStates::UnorderedAccess, GpuTaskResourceAccess::Write);
    Array<GpuTaskResourceVersionUse, 1> producerVersionUses = Array<GpuTaskResourceVersionUse, 1>();
    producerVersionUses[0u] = GpuResVersionUse(producedVersion, GpuTaskResourceVersionRole::Produce);
    const Expected<GpuTaskId> producerResult = GpuResVersionAddTask(
        s_GpuCaseTaskGraphResourceVersionImportedPrebirthProducer,
        producerResourceUses,
        producerVersionUses,
        Span<GpuTaskId>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(producerResult.has_value());
    const GpuTaskId producer = producerResult.value();

    Array<GpuTaskResourceUse, 1> consumerResourceUses = Array<GpuTaskResourceUse, 1>();
    consumerResourceUses[0u] = GpuResVersionResourceUse(resource, versionRange, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read);
    Array<GpuTaskResourceVersionUse, 1> consumerVersionUses = Array<GpuTaskResourceVersionUse, 1>();
    consumerVersionUses[0u] = GpuResVersionUse(producedVersion, GpuTaskResourceVersionRole::Consume);
    const Expected<GpuTaskId> consumerResult = GpuResVersionAddTask(
        s_GpuCaseTaskGraphResourceVersionImportedPrebirthProducedConsumer,
        consumerResourceUses,
        consumerVersionUses,
        Span<GpuTaskId>(),
        Span<GpuExternalCompletionId>(),
        graph
    );
    ASSERT_TRUE(consumerResult.has_value());
    const GpuTaskId consumer = consumerResult.value();
    ASSERT_TRUE(importedConsumer.valid());
    ASSERT_TRUE(producer.valid());
    ASSERT_TRUE(consumer.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    ASSERT_EQ(analysis.topologicalOrder().size(), 3u);
    EXPECT_EQ(analysis.topologicalOrder()[0u], importedConsumer);
    EXPECT_EQ(analysis.topologicalOrder()[1u], producer);
    EXPECT_EQ(analysis.topologicalOrder()[2u], consumer);
    EXPECT_TRUE(GpuResVersionHasEdge(analysis, importedConsumer, producer, resource, importedVersion, GpuTaskHazardType::VersionLifetime));
    EXPECT_TRUE(GpuResVersionHasEdge(analysis, producer, consumer, resource, producedVersion, GpuTaskHazardType::VersionDependency));
    EXPECT_FALSE(GpuResVersionHasEdge(analysis, consumer, importedConsumer, resource, producedVersion, GpuTaskHazardType::VersionLifetime));
}

Expected<b8, GpuResVersionAnalysisStatusEnum> GpuResVersionAnalyzeWholeResourceRange(
    in GpuResVersionResourceTypeEnum resourceType,
    in Name identity,
    in GpuTaskResourceRange range
){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuResourceVersionScratch);

    GpuResVersionTestArena testArena = GpuResVersionTestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuGraphResourceDesc resourceDesc = GpuGraphResourceDesc();
    resourceDesc.setIdentity(identity);
    resourceDesc.setMarkerLabel("Whole Resource Version");
    resourceDesc.setType(resourceType);
    if(resourceType == GpuGraphResourceType::AccelStruct)
        resourceDesc.setInitialState(ResourceStates::Common);
    const Expected<GpuGraphResourceId> resourceResult = graph.importResource(resourceDesc);
    if(!resourceResult.has_value())
        return MakeUnexpected(GpuTaskGraphAnalysisStatus::NotAnalyzed);
    const GpuGraphResourceId resource = resourceResult.value();
    if(!resource.valid())
        return MakeUnexpected(GpuTaskGraphAnalysisStatus::NotAnalyzed);
    const Expected<GpuGraphResourceVersionId> versionResult = GpuResVersionAddVersionRange(
        graph,
        resource,
        GpuGraphResourceVersionOrigin::ImportedRoot,
        range
    );
    if(!versionResult.has_value())
        return MakeUnexpected(GpuTaskGraphAnalysisStatus::NotAnalyzed);
    const GpuGraphResourceVersionId version = versionResult.value();
    if(!version.valid())
        return MakeUnexpected(GpuTaskGraphAnalysisStatus::NotAnalyzed);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    if(!Analyze(graph, operationScratchArena, analysis))
        return MakeUnexpected(analysis.diagnostic().status);
    return true;
}

void VerifyGpuResVersion_RequiresWholeResourceRangesForAccelStructAndHazardDomain(){
    GpuTaskResourceRange partialRange = GpuTaskResourceRange();
    partialRange.bufferRange = BufferRange(16u, 32u);
    const Expected<b8, GpuResVersionAnalysisStatusEnum> partialAccelStruct = GpuResVersionAnalyzeWholeResourceRange(
        GpuGraphResourceType::AccelStruct,
        s_GpuCaseTaskGraphResourceVersionPartialAccelStruct,
        partialRange
    );
    ASSERT_FALSE(partialAccelStruct.has_value());
    EXPECT_EQ(partialAccelStruct.error(), GpuTaskGraphAnalysisStatus::InvalidResourceVersion);
    const Expected<b8, GpuResVersionAnalysisStatusEnum> partialHazardDomain = GpuResVersionAnalyzeWholeResourceRange(
        GpuGraphResourceType::HazardDomain,
        s_GpuCaseTaskGraphResourceVersionPartialHazardDomain,
        partialRange
    );
    ASSERT_FALSE(partialHazardDomain.has_value());
    EXPECT_EQ(partialHazardDomain.error(), GpuTaskGraphAnalysisStatus::InvalidResourceVersion);
    EXPECT_TRUE(
        GpuResVersionAnalyzeWholeResourceRange(
            GpuGraphResourceType::AccelStruct,
            s_TaskGraphCaseTestsTaskGraphResourceVersionWholeAccelStruct,
            GpuTaskResourceRange()
        ).has_value()
    );
    EXPECT_TRUE(
        GpuResVersionAnalyzeWholeResourceRange(
            GpuGraphResourceType::HazardDomain,
            s_TaskGraphCaseTestsTaskGraphResourceVersionWholeHazardDomain,
            GpuTaskResourceRange()
        ).has_value()
    );
}


