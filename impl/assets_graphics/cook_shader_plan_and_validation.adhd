////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u64 s_InitialShaderArchiveIndexPlannedFileCount = 1u;

b8 ValidateNonEmptyMaterialShaderVariant(in StringView materialVirtualPath, in StringView shaderVariant){
    if(!shaderVariant.empty())
        return true;

    error("Material '{}' has empty shader_variant", materialVirtualPath);
    return false;
}

b8 ValidateQuotedCsgEvaluatorModuleInclude(in StringView defineValue, in StringView unquotedIncludeName){
    if(!unquotedIncludeName.empty())
        return true;

    error("GraphicsCook: CSG evaluator module define value '{}' must be a quoted include path", defineValue);
    return false;
}

b8 ValidatePreparedMaterialStageShaderExists(in b8 foundShader, in StringView materialVirtualPath, in Name shaderName, in Name stageName){
    if(foundShader)
        return true;

    error("Material '{}' references unknown shader '{}' for stage '{}'", materialVirtualPath, shaderName.resolvedText(), stageName.resolvedText());
    return false;
}

usize CountFixedImplicitShaderIncludeRoots(
    in b8 hasMaterialBindRoot,
    in b8 hasDeferredBxdfRoot,
    in b8 hasShadowSurfaceRoot,
    in b8 hasCsgShapeRoot
){
    usize count = 0u;
    if(hasMaterialBindRoot)
        ++count;
    if(hasDeferredBxdfRoot)
        ++count;
    if(hasShadowSurfaceRoot)
        ++count;
    if(hasCsgShapeRoot)
        ++count;
    return count;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 SetShaderImplicitDefine(in StringView name, in StringView value, mut ShaderCookEntry entry){
    if(!ValidateShaderDoesNotUseImplicitDefine(entry.name, name, entry.defineValues.contains(name)))
        return false;
    GetOrCreateTextRecord<String>(entry.implicitDefines, name).assign(value);
    return true;
}

Expected<u64> CountShaderVariants(in ShaderCookEntry entry){
    u64 count = 1u;
    for(in auto define : entry.defineValues){
        if(!TryAccumulateShaderDefineVariantCount(entry.name, define.first, cast<u64>(define.second.values.size()), count))
            return MakeUnexpected(Failure());
    }
    return count;
}

Expected<Path> ResolveCsgEvaluatorInclude(in StringView name, in Vector<Path> directories){
    if(name.empty())
        return MakeUnexpected(Failure());
    const Path includePath(name);
    if(includePath.isAbsolute()){
        const Expected<b8, ErrorCode> found = IsRegularFile(includePath);
        if(found.has_value() && found.value())
            return includePath.lexicallyNormal();
        if(!found.has_value() && !IsMissingPathError(found.error())){
            error("GraphicsCook: failed to query CSG evaluator module include '{}': {}", includePath, ErrorCodeMessage(found.error()));
            return MakeUnexpected(Failure());
        }
    }
    for(in Path directory : directories){
        const Path candidate = (directory / includePath).lexicallyNormal();
        const Expected<b8, ErrorCode> found = IsRegularFile(candidate);
        if(found.has_value() && found.value())
            return candidate;
        if(!found.has_value() && !IsMissingPathError(found.error())){
            error("GraphicsCook: failed to query CSG evaluator module include '{}': {}", candidate, ErrorCodeMessage(found.error()));
            return MakeUnexpected(Failure());
        }
    }
    error("GraphicsCook: failed to resolve CSG evaluator module include '{}'", name);
    return MakeUnexpected(Failure());
}

b8 CollectCsgEvaluatorDependencies(in ShaderCookEntry entry, in Vector<Path> directories, mut Vector<Path> dependencies){
    if(!entry.defineValues.contains(s_CsgProjectEvaluatorModuleDefineName))
        return true;
    HashSet<String> seen;
    seen.reserve(dependencies.size());
    for(in Path path : dependencies)
        seen.insert(NativePathComparisonKey(path));
    Vector<Path> moduleDependencies;
    for(in String text : entry.defineValues.at(s_CsgProjectEvaluatorModuleDefineName).values){
        const StringView name = UnquoteDoubleQuotedView(text);
        if(!ValidateQuotedCsgEvaluatorModuleInclude(text, name))
            return false;
        const Expected<Path> modulePath = ResolveCsgEvaluatorInclude(name, directories);
        if(!modulePath.has_value() || !GatherShaderSourceDependencies(modulePath.value(), directories, s_ExternallyPlannedMacroIncludes, moduleDependencies))
            return false;
        for(in Path dependency : moduleDependencies){
            const Expected<Path, ErrorCode> absolute = AbsolutePath(dependency);
            if(!absolute.has_value()){
                error("GraphicsCook: failed to resolve CSG evaluator module dependency '{}': {}", dependency, ErrorCodeMessage(absolute.error()));
                return false;
            }
            const Path normalized = absolute.value().lexicallyNormal();
            if(seen.insert(NativePathComparisonKey(normalized)).second)
                AppendOwnedPath(dependencies, normalized);
        }
    }
    return true;
}

b8 ValidateMaterials(in Span<PreparedShaderEntry> prepared, in Span<MaterialCookEntry> materials){
    HashMap<ShaderStageKey, usize> lookup;
    lookup.reserve(prepared.size());
    for(usize index = 0u; index < prepared.size(); ++index){
        in ShaderCookEntry entry = prepared[index].entry;
        const Expected<Optional<Name>, NameTextError> shader = ToName(entry.name);
        const Expected<Optional<Name>, NameTextError> stage = ToName(entry.archiveStage);
        if(!shader.has_value()){
            error("GraphicsCook: prepared shader name has invalid text (failure {})", cast<u32>(shader.error()));
            return false;
        }
        if(!stage.has_value()){
            error("GraphicsCook: prepared shader stage has invalid text for entry '{}' (failure {})", entry.name, cast<u32>(stage.error()));
            return false;
        }
        const ShaderStageKey key(shader.value().value_or(s_NameNone), stage.value().value_or(s_NameNone));
        if(!lookup.try_emplace(key, index).second){
            error("GraphicsCook: duplicate prepared shader key '{}' stage '{}'", entry.name, entry.archiveStage);
            return false;
        }
    }
    for(in MaterialCookEntry material : materials){
        b8 hasInterfaceStage = false;
        for(in auto stage : material.stageShaders){
            const Name stageName = ArchiveStageNameFromShaderType(stage.first);
            const ShaderStageKey key(stage.second.name(), stageName);
            if(!ValidatePreparedMaterialStageShaderExists(lookup.contains(key), material.virtualPath, stage.second.name(), stageName))
                return false;
            in PreparedShaderEntry shader = prepared[lookup.at(key)];
            if(!ValidateNonEmptyMaterialShaderVariant(material.virtualPath, material.shaderVariant) || !CheckShaderVariantSignature(material.virtualPath, Optional<Name>(stageName), material.shaderVariant, shader.entry.defineValues))
                return false;
            if(stage.first == ShaderType::PixelStage){
                hasInterfaceStage = true;
                Name materialName = s_NameNone;
                if(shader.materialTypedBindingInterface != s_NameNone){
                    const Expected<Optional<Name>, NameTextError> parsed = ToName(material.materialInterface);
                    if(!parsed.has_value()){
                        error("Material '{}' interface has invalid text (failure {})", material.virtualPath, cast<u32>(parsed.error()));
                        return false;
                    }
                    materialName = parsed.value().value_or(s_NameNone);
                }
                if(!ValidateMaterialCookPixelShaderInterface(material.virtualPath, material.materialInterface, stage.second.name(), shader.materialTypedBindingInterface, shader.materialTypedBindingInterfacePath, materialName))
                    return false;
            }
        }
        if(!ValidateMaterialCookStagePresence(material.virtualPath, material.materialInterface, !material.stageShaders.empty(), hasInterfaceStage))
            return false;
    }
    return true;
}

b8 AppendShaderIncludeDirectory(in Path path, in ShaderCookEntry entry, mut Vector<Path> directories, mut HashSet<String> seen){
    const Expected<b8, ErrorCode> valid = IsDirectory(path);
    if(!valid.has_value()){
        error("GraphicsCook: failed to query include root '{}' for entry '{}': {}", path, entry.name, ErrorCodeMessage(valid.error()));
        return false;
    }
    if(!valid.value()){
        error("GraphicsCook: include root is not a directory for entry '{}': '{}'", entry.name, path);
        return false;
    }
    if(seen.insert(NativePathComparisonKey(path.lexicallyNormal())).second)
        AppendOwnedPath(directories, path);
    return true;
}

b8 BuildShaderIncludeDirectories(in CookResolvedPaths paths, in Vector<Path> implicitRoots, in ShaderCookEntry entry, mut Vector<Path> directories){
    const Expected<usize> capacity = TryComputeShaderIncludeRootCapacity(entry.name, entry.includeRoots.size(), implicitRoots.size());
    if(!capacity.has_value())
        return false;
    HashSet<String> seen;
    seen.reserve(capacity.value());
    directories.reserve(capacity.value());
    for(in Path root : implicitRoots){
        if(!AppendShaderIncludeDirectory(root, entry, directories, seen))
            return false;
    }
    for(in String root : entry.includeRoots){
        const Expected<Path> virtualPath = ResolveCookVirtualAssetPath(paths, root);
        if(virtualPath.has_value()){
            if(!AppendShaderIncludeDirectory(virtualPath.value(), entry, directories, seen))
                return false;
        }
        else{
            if(HasReservedAssetVirtualRoot(root)){
                error("GraphicsCook: failed to resolve virtual include root '{}' for entry '{}'", root, entry.name);
                return false;
            }
            const Expected<Path, ErrorCode> resolved = ResolveAbsolutePath(Path(paths.repoRoot), StringView(root));
            if(!resolved.has_value()){
                error("GraphicsCook: failed to resolve include root '{}' for entry '{}': {}", root, entry.name, ErrorCodeMessage(resolved.error()));
                return false;
            }
            if(!AppendShaderIncludeDirectory(resolved.value(), entry, directories, seen))
                return false;
        }
    }
    return true;
}

b8 PrepareShaderSource(in CookResolvedPaths paths, in Vector<Path> implicitRoots, in IncludeMetadataMap includes, mut PreparedShaderEntry target){
    mut ShaderCookEntry entry = target.entry;
    const Expected<Path, ErrorCode> source = ResolveAbsolutePath(Path(paths.repoRoot), StringView(entry.source));
    if(!source.has_value()){
        error("Failed to resolve source path '{}' for entry '{}': {}", entry.source, entry.name, ErrorCodeMessage(source.error()));
        return false;
    }
    target.sourcePath = source.value();
    const Expected<b8, ErrorCode> exists = FileExists(target.sourcePath);
    if(!exists.has_value()){
        error("Failed to query source path '{}' for entry '{}': {}", target.sourcePath, entry.name, ErrorCodeMessage(exists.error()));
        return false;
    }
    if(!exists.value()){
        error("Shader source does not exist for entry '{}': '{}'", entry.name, target.sourcePath);
        return false;
    }
    const Expected<b8, ErrorCode> regular = IsRegularFile(target.sourcePath);
    if(!regular.has_value()){
        error("Failed to inspect source path '{}' for entry '{}': {}", target.sourcePath, entry.name, ErrorCodeMessage(regular.error()));
        return false;
    }
    if(!regular.value()){
        error("Shader source is not a regular file for entry '{}': '{}'", entry.name, target.sourcePath);
        return false;
    }
    if(!BuildShaderIncludeDirectories(paths, implicitRoots, entry, target.includeDirectories) || !GatherShaderSourceDependencies(target.sourcePath, target.includeDirectories, s_ExternallyPlannedMacroIncludes, target.dependencies))
        return false;
    MergeInheritedShaderDefines(target.dependencies, includes, entry);
    const usize count = target.dependencies.size();
    if(!CollectCsgEvaluatorDependencies(entry, target.includeDirectories, target.dependencies))
        return false;
    if(target.dependencies.size() != count)
        MergeInheritedShaderDefines(target.dependencies, includes, entry);
    return ValidateShaderReservedImplicitDefines(entry.name, s_MaterialBindTypedBindingImplicitDefineText, entry.defineValues.contains(s_MaterialBindTypedBindingImplicitDefineText),
        entry.defineValues.contains(s_CsgClipImplicitDefineName), entry.defineValues.contains(s_CsgIntervalSampleEnabledImplicitDefineName));
}

b8 PrepareShaderMaterialDependencies(in CookResolvedPaths paths, in Path bindRoot, in Path csgRoot, in Span<MaterialBindEntry> binds, mut PreparedShaderEntry target){
    const Expected<MaterialBindDependency> material = ResolveMaterialBindDependencyInterface(target.entry.name, bindRoot, binds, target.dependencies);
    if(!material.has_value())
        return false;
    target.materialTypedBindingInterface = material.value().interfaceName;
    const StringView stage = target.entry.archiveStage;
    const b8 readsMaterial = stage == ArchiveStageTextFromShaderType(ShaderType::MeshStage) || stage == ArchiveStageTextFromShaderType(ShaderType::PixelStage)
        || stage == ArchiveStageTextFromShaderType(ShaderType::ComputeStage) || stage == ArchiveStageTextFromShaderType(ShaderType::RayGenerationStage) || stage == ArchiveStageTextFromShaderType(ShaderType::AnyHitStage)
        || stage == ArchiveStageTextFromShaderType(ShaderType::ClosestHitStage) || stage == ArchiveStageTextFromShaderType(ShaderType::MissStage);
    target.usesMaterialTypedBinding = readsMaterial && material.value().dependsOnMaterialBind;
    target.materialTypedBindingInterfacePath.assign(StringView(material.value().interfacePath));
    if(target.usesMaterialTypedBinding && !SetShaderImplicitDefine(s_MaterialBindTypedBindingImplicitDefineText, s_MaterialBindTypedBindingImplicitDefineValueText, target.entry))
        return false;
    ShaderChecksumRoots roots;
    if(!roots.append(paths.repoRoot, s_DependencyRepoRootAlias) || !roots.append(paths.cacheDirectory, s_DependencyGeneratedCacheRootAlias) || !roots.append(bindRoot, s_MaterialBindGeneratedIncludeCacheDirectoryText)
        || !roots.append(csgRoot, s_GeneratedIncludeCacheDirectory))
        return false;
    const Expected<DependencyChecksum> dependency = ComputeShaderDependencyChecksum(target.dependencies, target.includeDirectories, roots);
    if(!dependency.has_value())
        return false;
    target.dependencyChecksum = dependency.value().checksum;
    target.compilerInputsHaveBom = dependency.value().compilerInputsHaveBom;
    if(!material.value().interfaceSources.empty()){
        ShaderChecksumRoots interfaceRoots;
        if(!interfaceRoots.append(paths.repoRoot, s_DependencyRepoRootAlias) || !interfaceRoots.append(paths.cacheDirectory, s_DependencyGeneratedCacheRootAlias))
            return false;
        Vector<Path> noIncludes;
        const Expected<DependencyChecksum> schema = ComputeShaderDependencyChecksum(material.value().interfaceSources, noIncludes, interfaceRoots);
        if(!schema.has_value())
            return false;
        Fnv64AppendValue(target.dependencyChecksum, schema.value().checksum);
    }
    return true;
}

Expected<PreparedShaderPlan> PrepareShaderEntriesForCook(
    in CookResolvedPaths paths,
    in Path bindRoot,
    in Path csgRoot,
    in Path bxdfRoot,
    in Path shadowRoot,
    in IncludeMetadataMap includes,
    in Span<MaterialBindEntry> binds,
    in Span<MaterialCookEntry> materials,
    mut Vector<ShaderCookEntry> entries
){
    PreparedShaderPlan plan;
    const Expected<usize> capacity = TryComputePreparedShaderEntryCapacity(entries.size());
    if(!capacity.has_value())
        return MakeUnexpected(Failure());
    plan.preparedEntries.reserve(capacity.value());
    plan.plannedFileCount = s_InitialShaderArchiveIndexPlannedFileCount;
    const HashSet<ShaderStageKey> materialKeys = CollectMaterialClipShaderKeys(materials);
    const Expected<HashSet<ShaderStageKey>, NameTextError> avboitKeys = CollectAvboitClipShaderKeys(materials);
    if(!avboitKeys.has_value()){
        error("GraphicsCook: invalid generated AVBOIT shader identity (failure {})", cast<u32>(avboitKeys.error()));
        return MakeUnexpected(Failure());
    }
    Vector<Path> implicitRoots;
    usize count = CountFixedImplicitShaderIncludeRoots(!bindRoot.empty(), !bxdfRoot.empty(), !shadowRoot.empty(), !csgRoot.empty());
    if(!csgRoot.empty()){
        const Expected<usize> size = TryComputeImplicitShaderIncludeRootCapacity(count, paths.assetRoots.size());
        if(!size.has_value())
            return MakeUnexpected(Failure());
        count = size.value();
    }
    implicitRoots.reserve(count);
    if(!bindRoot.empty())
        AppendOwnedPath(implicitRoots, bindRoot);
    if(!bxdfRoot.empty())
        AppendOwnedPath(implicitRoots, bxdfRoot);
    if(!shadowRoot.empty())
        AppendOwnedPath(implicitRoots, shadowRoot);
    if(!csgRoot.empty()){
        AppendOwnedPath(implicitRoots, csgRoot);
        for(in ResolvedAssetRoot root : paths.assetRoots)
            AppendOwnedPath(implicitRoots, root.path);
    }
    for(mut ShaderCookEntry entry : entries){
        AppendArenaElement<PreparedShaderEntry>(plan.preparedEntries);
        mut PreparedShaderEntry target = plan.preparedEntries[plan.preparedEntries.size() - 1u];
        target.entry = entry;
        if(!PrepareShaderSource(paths, implicitRoots, includes, target) || !PrepareShaderMaterialDependencies(paths, bindRoot, csgRoot, binds, target))
            return MakeUnexpected(Failure());
        const Expected<b8, NameTextError> clip = SupportsClipVariant(materialKeys, target.entry);
        const Expected<b8, NameTextError> avboit = SupportsClipVariant(avboitKeys.value(), target.entry);
        if(!clip.has_value() || !avboit.has_value()){
            if(!clip.has_value())
                error("GraphicsCook: invalid CSG clip shader identity for entry '{}' (failure {})", target.entry.name, cast<u32>(clip.error()));
            else
                error("GraphicsCook: invalid AVBOIT clip shader identity for entry '{}' (failure {})", target.entry.name, cast<u32>(avboit.error()));
            return MakeUnexpected(Failure());
        }
        target.supportsCsgClipVariant = clip.value();
        target.supportsAvboitCsgClipVariant = avboit.value();
        const Expected<u64> variants = CountShaderVariants(target.entry);
        if(!variants.has_value())
            return MakeUnexpected(Failure());
        target.variantCount = variants.value();
        if((clip.value() || avboit.value()) && !TryAddCsgClipVariantCount(target.entry.name, variants.value(), target.variantCount))
            return MakeUnexpected(Failure());
        if(!AddPlannedFileCount(target.variantCount, plan.plannedFileCount))
            return MakeUnexpected(Failure());
        if(target.entry.archiveStage == ArchiveStageTextFromShaderType(ShaderType::MeshStage) && target.entry.emitMeshComputeShadow){
            PreparedShaderEntry shadow = target;
            shadow.entry.archiveStage = s_MeshComputeArchiveStageText;
            shadow.entry.stage = ArchiveStageTextFromShaderType(ShaderType::ComputeStage);
            if(!SetShaderImplicitDefine(s_MeshComputeImplicitDefineText, s_EnabledImplicitDefineValue, shadow.entry)){
                error("GraphicsCook: failed to build mesh-compute shadow entry for '{}'", target.entry.name);
                return MakeUnexpected(Failure());
            }
            if(!AddPlannedFileCount(shadow.variantCount, plan.plannedFileCount))
                return MakeUnexpected(Failure());
            AppendOwned<PreparedShaderEntry>(plan.preparedEntries, shadow);
        }
    }
    return plan;
}


