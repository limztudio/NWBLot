void VerifyCpuTaskCleanupTests_SchedulerDestructorPropagatesCallerFailureToTheTerminalEntry(){
    Atomic<u32> retirements(0u);
    u32 callbacks = 0u;
    u32 handled = 0u;
    u32 retiredOnCatch = 0u;
    i32 result = 0;
    result = InvokeTerminalEntry<TerminalTaskError>(lambda[mut retirements, mut callbacks]() -> i32{
        CpuTaskScheduler scheduler(0u);
        const auto cpuTaskAdmission = scheduler.submit(RetireAfterTask(LifetimeProbe(retirements, 0u), lambda[mut callbacks](mut LifetimeProbe probe, in b8 active) -> void{
            EXPECT_TRUE(active);
            ++callbacks;
            ThrowTestException<TerminalTaskError>(TerminalTaskError(17));
        }), MainThreadOptions());
        EXPECT_TRUE(cpuTaskAdmission.has_value());
        if(cpuTaskAdmission.has_value())
            EXPECT_TRUE(cpuTaskAdmission.value().valid());
        const auto secondCpuTaskAdmission = scheduler.submit(RetireAfterTask(LifetimeProbe(retirements, 0u), lambda[mut callbacks](mut LifetimeProbe probe, in b8 active) -> void{
            EXPECT_TRUE(active);
            ++callbacks;
            ThrowTestException<TerminalTaskError>(TerminalTaskError(29));
        }));
        EXPECT_TRUE(secondCpuTaskAdmission.has_value());
        if(secondCpuTaskAdmission.has_value())
            EXPECT_TRUE(secondCpuTaskAdmission.value().valid());
        return 0;
    }, lambda[mut retirements, mut handled, mut retiredOnCatch](in TerminalTaskError err) -> i32{
        ++handled;
        retiredOnCatch = retirements.load(MemoryOrder::acquire);
        return err.code;
    }, lambda[]() -> i32{ return -1; });
    EXPECT_EQ(retiredOnCatch, 2u);
    EXPECT_EQ(result, 17);
    EXPECT_EQ(handled, 1u);
    EXPECT_EQ(callbacks, 1u);
}

