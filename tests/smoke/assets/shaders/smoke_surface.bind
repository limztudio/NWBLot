[material_constant]
struct NwbSmokeSurfaceMaterial{
    [default("half4(1.0h, 1.0h, 1.0h, 1.0h)")]
    half4 base_color;
    [fixture("builtin/material_fixture/checker_rgba8")]
    texture2d base_color_map;
    [fixture("builtin/material_fixture/linear_clamp")]
    sampler base_color_sampler;
    // The shared smoke surface backs visual baselines as well as the fixture test. Keep the texture contribution
    // opt-in so ordinary opaque materials retain their authored colour while the fixture remains sampled in shader.
    [default("half(0.0h)")]
    half fixture_color_weight;
};

[material_mutable]
struct NwbSmokeRuntimeMaterial{
    [default("half4(1.0h, 1.0h, 1.0h, 1.0h)")]
    half4 color_tint;
};

NwbSmokeSurfaceMaterial surface;
NwbSmokeRuntimeMaterial runtime;


