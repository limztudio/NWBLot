    EXPECT_EQ(UiTextGlyphCandidateNoAtlas(glyph, 2049.0f, 16.0f, Point(), clip), TextGlyphIntersection::Invalid);
    EXPECT_EQ(UiTextGlyphCandidateNoAtlas(glyph, 16.0f, 0.0f, Point(), clip), TextGlyphIntersection::Invalid);
    EXPECT_EQ(UiTextGlyphCandidateNoAtlas(glyph, 16.0f, 4097.0f, Point(), clip), TextGlyphIntersection::Invalid);
    glyph.coverage.ink.width = -1.0f;
    EXPECT_EQ(UiTextGlyphCandidateNoAtlas(glyph, 16.0f, 16.0f, Point(), clip), TextGlyphIntersection::Invalid);
    glyph.coverage.ink.width = 3.0f;
    glyph.position.y = bit_cast<f32>(s_UiTextFontLayoutPosInfF32Bits);
    EXPECT_EQ(UiTextGlyphCandidateNoAtlas(glyph, 16.0f, 16.0f, Point(), clip), TextGlyphIntersection::Invalid);
    glyph.position = Point(f32.max, 0.0f);
    EXPECT_EQ(UiTextGlyphCandidateNoAtlas(glyph, 16.0f, 16.0f, Point(f32.max, 0.0f), clip), TextGlyphIntersection::Invalid);
}

