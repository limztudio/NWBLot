////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_BVH_RAY_ITERATOR_SLANGI
#define NWB_GRAPHICS_BVH_RAY_ITERATOR_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "ray_intersect.slangi"
#include "bindless_heap_bvh.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct NwbBvhRayIterator<let capacity : uint>{
    float3 origin;
    float3 direction;
    float3 inverseDirection;
    float minimum;
    float maximum;
    uint nodeSlot;
    uint stack[capacity];
    uint stackPointer;
    bool overflow;
};

void nwbBvhRayBeginWalk<let capacity : uint>(const uint nodeSlot, const float3 origin, const float3 direction, const float minimum, const float maximum, __ref NwbBvhRayIterator<capacity> iterator){
    iterator.origin = origin;
    iterator.direction = direction;
    iterator.inverseDirection = nwbBvhSafeInvDir(direction);
    iterator.minimum = minimum;
    iterator.maximum = maximum;
    iterator.nodeSlot = nodeSlot;
    iterator.stack[0u] = 0u;
    iterator.stackPointer = 1u;
    iterator.overflow = false;
}

bool nwbBvhRayNextLeaf<let capacity : uint, let conservative : bool = false>(__ref NwbBvhRayIterator<capacity> iterator, out uint primitive){
    primitive = 0u;
    [loop] while(iterator.stackPointer > 0u){
        --iterator.stackPointer;
        NwbBvhNode node = nwbHeapBvhNodes(iterator.nodeSlot)[iterator.stack[iterator.stackPointer]];
        float entry;
        const bool hit = conservative ? nwbBvhRayConservativeAabb(iterator.origin, iterator.direction, iterator.minimum, iterator.maximum, node.aabbMin, node.aabbMax, entry) : nwbBvhRayAabb(iterator.origin, iterator.inverseDirection, iterator.minimum, iterator.maximum, node.aabbMin, node.aabbMax, 0.0);
        if(!hit)
            continue;
        [loop] while(true){
            if(nwbBvhNodeIsLeaf(node)){
                primitive = nwbBvhLeafPrimitive(node);
                return true;
            }
            const NwbBvhNode leftNode = nwbHeapBvhNodes(iterator.nodeSlot)[node.leftChild];
            const uint right = nwbBvhNodeRightChildIndex(node);
            const NwbBvhNode rightNode = nwbHeapBvhNodes(iterator.nodeSlot)[right];
            NwbBvhNode descendNode;
            uint farChild;
            bool bothHit;
            if(conservative){
                float leftEntry;
                float rightEntry;
                const bool leftHit = nwbBvhRayConservativeAabb(iterator.origin, iterator.direction, iterator.minimum, iterator.maximum, leftNode.aabbMin, leftNode.aabbMax, leftEntry);
                const bool rightHit = nwbBvhRayConservativeAabb(iterator.origin, iterator.direction, iterator.minimum, iterator.maximum, rightNode.aabbMin, rightNode.aabbMax, rightEntry);
                if(!leftHit && !rightHit)
                    break;
                const bool leftFirst = leftHit && (!rightHit || leftEntry <= rightEntry);
                descendNode = leftFirst ? leftNode : rightNode;
                farChild = leftFirst ? right : node.leftChild;
                bothHit = leftHit && rightHit;
            }
            else if(!nwbBvhPickNearChild(iterator.origin, iterator.inverseDirection, iterator.minimum, iterator.maximum, node, leftNode, right, rightNode, descendNode, farChild, bothHit))
                break;
            if(bothHit){
                if(iterator.stackPointer == capacity){
                    iterator.overflow = true;
                    iterator.stackPointer = 0u;
                    return false;
                }
                iterator.stack[iterator.stackPointer] = farChild;
                ++iterator.stackPointer;
            }
            node = descendNode;
        }
    }
    return false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

