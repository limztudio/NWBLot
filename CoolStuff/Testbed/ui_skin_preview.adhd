    public StringView text(in u64 index)const override{ return ResolvePopupToolsLabel(index); }
    public b8 enabled(in u64 index)const override{ return IsImmutableListSourceRowEnabled(index, s_PopupToolsLabelCount, s_PopupToolsDisabledKey); }
}

class UiRadioGroupSource : IListDataSource{
