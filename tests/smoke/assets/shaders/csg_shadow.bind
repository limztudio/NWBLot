[material_constant]
struct NwbCsgShadowSurface{
    [default("half4(1.0h, 1.0h, 1.0h, 1.0h)")]
    half4 base_color;
};

[material_mutable]
struct NwbCsgShadowRuntime{
    [default("half4(1.0h, 1.0h, 1.0h, 1.0h)")]
    half4 color_tint;
};

NwbCsgShadowSurface surface;
NwbCsgShadowRuntime runtime;


