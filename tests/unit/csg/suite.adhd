class TestProjectSlabShape : ICsgShape{
    public Name shapeTypeName()const override{
        return Name(s_CsgInputNameProjectCsgSlab);
    }

    public u32 parameterByteSize()const override{
        return s_CsgShapeParameterRegisterBytes;
    }

    public CsgShapeInlineParameters defaultParameters()const override{
        return MakeCsgShapeInlineParameters(VectorSingle(0.5f, 1.0f, 1.0f, 0.0f), VectorSingle(s_CsgZeroShapeParameter));
    }

    public Expected<CsgShapeLocalBounds> computeLocalBounds(in CsgShapeInlineParameters parameters)const override{
        return MakeCsgSymmetricLocalBounds(VectorSingle(parameters.parameter0));
    }

    public f32 evaluateSignedDistance(in VectorSingle shapePosition, in CsgShapeInlineParameters parameters)const override{
        return shapePosition.x + parameters.parameter0.x;
    }
}

class OversizedProjectShape : ICsgShape{
    public Name shapeTypeName()const override{
        return Name(s_CsgInputNameProjectCsgOversized);
    }

    public u32 parameterByteSize()const override{
        return cast<u32>(s_CsgShapeInlineParameterMaxBytes) + 1u;
    }

    public CsgShapeInlineParameters defaultParameters()const override{
        return CsgShapeInlineParameters();
    }

    public Expected<CsgShapeLocalBounds> computeLocalBounds(in CsgShapeInlineParameters parameters)const override{
        const f32 unused = parameters.parameter0.x;
        if(unused != unused)
            return MakeUnexpected(Failure());
        return MakeUnexpected(Failure());
    }

    public f32 evaluateSignedDistance(in VectorSingle shapePosition, in CsgShapeInlineParameters parameters)const override{
        return (shapePosition.x - shapePosition.x) + (parameters.parameter0.x - parameters.parameter0.x);
    }
}


