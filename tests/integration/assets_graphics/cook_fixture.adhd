GraphicsWordVector CopyBytecodeToWords(mut TestArena testArena, in Span<u8> bytecode){
    GraphicsWordVector words(testArena.arena);
    words.reserve(bytecode.size() / size_of<u32>());
    usize cursor = 0u;
    while(bytecode.size() - cursor >= size_of<u32>())
        words.push_back(ReadPOD<u32>(bytecode, cursor).value());
    return words;
}

