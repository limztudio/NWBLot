using namespace NWB;
using namespace NWB::Impl::Ui;
using namespace NWB::UiRadioGroupTests;


class UiRadioGroupPopupTests : public RadioGroupFixture{
public:
    virtual void SetUp()override{
        RadioGroupFixture::SetUp();
        m_childSource.m_generation = 2001u;
        m_laterSource.m_generation = 2101u;
        m_childState.select(20u);
        m_parent.open();
        m_child.open();
    }

    [[nodiscard]] WidgetId parentHost()const{
        return UiTestSupport::RequireWidgetId(UiTestSupport::RequireWidgetId(UiTestSupport::RequireRootId(m_root), s_ParentPopupKey), s_RadioGroupKey);
    }

    [[nodiscard]] b8 beginParent(const u64 generation){
        if(!begin(generation) || !m_builder.beginPopup(s_ParentPopupKey, m_parent, UiWidgetTests::NestedParentOptions()))
            return false;
        m_result = m_builder.radioGroup(s_RadioGroupKey, m_source, m_state);
        return m_result.valid;
    }

    [[nodiscard]] b8 declareFamily(const u64 generation){
        if(!beginParent(generation) || !m_builder.beginPopup(s_ChildPopupKey, m_child, UiWidgetTests::NestedChildOptions()))
            return false;
        m_childResult = m_builder.radioGroup(s_RadioGroupKey, m_childSource, m_childState);
        return m_childResult.valid && m_builder.endPopup();
    }

    [[nodiscard]] b8 finishParent(){
        return m_builder.endPopup() && m_context.endRoot() && m_context.finishFrame();
    }

    [[nodiscard]] b8 acceptParent(const u64 generation){
        return beginParent(generation) && finishParent() && m_context.commitFrame(generation);
    }

    [[nodiscard]] b8 acceptFamily(const u64 generation){
        return declareFamily(generation) && finishParent() && m_context.commitFrame(generation);
    }


public:
    PopupState m_parent;
    PopupState m_child;
    RadioSource m_childSource;
    RadioSource m_laterSource;
    RadioGroupState m_childState;
    RadioGroupState m_laterState;
    RadioGroupResult m_childResult;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


