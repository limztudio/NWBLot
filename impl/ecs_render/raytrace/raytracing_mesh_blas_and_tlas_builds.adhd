////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class MeshBlasBuildPlanDecision{
    public u32 vertexStride = 0u;
    public u32 vertexCount = 0u;
    public u32 refitsBeforeBuild = 0u;
    public u32 refitsAfterBuild = 0u;
    public b8 firstBuild = false;
    public b8 performRefit = false;
}

class PreparedMeshBlasValidationPolicy{
    public b8 matchesCoreRevisionState(
        in Name meshName,
        in Name buildMeshName,
        in b8 runtimeMesh,
        in b8 buildRuntimeMesh,
        in u64 runtimeMeshVersion,
        in u64 buildRuntimeMeshVersion,
        in u64 geometryContentRevision,
        in u64 buildGeometryContentRevision,
        in u64 acceptedGeometryContentRevision,
        in u64 buildAcceptedGeometryContentRevision,
        in u32 indexCount,
        in u32 buildIndexCount,
        in b8 buildPending,
        in b8 expectedBuildPending,
        in b8 blasBuildAccepted,
        in b8 expectedFirstBuild,
        in b8 backingFresh,
        in b8 expectedBackingFresh,
        in u32 refitsSinceRebuild,
        in u32 buildRefitsBeforeBuild
    )const{
        const b8 currentFirstBuild = buildPending || !blasBuildAccepted;
        return meshName == buildMeshName
            && runtimeMesh == buildRuntimeMesh
            && runtimeMeshVersion == buildRuntimeMeshVersion
            && geometryContentRevision == buildGeometryContentRevision
            && acceptedGeometryContentRevision == buildAcceptedGeometryContentRevision
            && indexCount == buildIndexCount
            && buildPending == expectedBuildPending
            && currentFirstBuild == expectedFirstBuild
            && backingFresh == expectedBackingFresh
            && refitsSinceRebuild == buildRefitsBeforeBuild;
    }

    public b8 hasValidRecordDimensions(in u32 vertexStride, in u32 vertexCount, in u32 indexCount)const{
        return vertexStride != 0u && vertexCount != 0u && indexCount != 0u;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u32 ComputeMeshBlasVertexCount(in usize positionByteSize, in usize structStride){
    if(structStride == 0u)
        return 0u;
    return cast<u32>(positionByteSize / structStride);
}

b8 MatchesMeshBlasPositionLayout(in usize structStride, in usize byteSize, in u32 expectedStride, in usize expectedByteSize, in u32 expectedVertexCount){
    return structStride == cast<usize>(expectedStride)
        && byteSize == expectedByteSize
        && expectedStride != 0u
        && expectedVertexCount == ComputeMeshBlasVertexCount(byteSize, structStride);
}

MeshBlasBuildPlanDecision ResolveMeshBlasBuildPlanDecision(
    in usize positionByteSize,
    in usize positionStructStride,
    in u32 primitiveIndexCount,
    in b8 runtimeMesh,
    in b8 blasBuildPending,
    in b8 blasBuildAccepted,
    in u32 blasRefitsSinceRebuild
){
    MeshBlasBuildPlanDecision decision;
    decision.vertexStride = cast<u32>(positionStructStride);
    decision.vertexCount = ComputeMeshBlasVertexCount(positionByteSize, positionStructStride);
    decision.firstBuild = blasBuildPending || !blasBuildAccepted;
    decision.performRefit = ShouldRefitRuntimeMeshAcceleration(runtimeMesh, decision.firstBuild, blasRefitsSinceRebuild, ComputeMeshTrianglePrimitiveCount(primitiveIndexCount));
    decision.refitsBeforeBuild = blasRefitsSinceRebuild;
    decision.refitsAfterBuild = AdvanceAccelerationRefitCount(decision.performRefit, blasRefitsSinceRebuild);
    return decision;
}

void PreparedSceneTlasBuild::confirm(mut RendererRayTracingState state){
    if(!this.m_ready)
        return;

    RayTracingBuildPolicy().publishConfirmedSceneTlasBuild(this.storageMatches(state), this.m_static && !this.m_useInstanceBuffer, this.m_staticSceneHash, state.sceneBvh.m_tlasStaticSceneHash, state.sceneBvh.m_tlasStaticSceneHashValid, state.sceneBvh.m_tlasBackingFresh);
    this.clear();
}

b8 PreparedSceneTlasBuild::storageMatches(in RendererRayTracingState state)const{
    if(
        !state.sceneBvh.m_tlas.valid()
        || state.sceneBvh.m_tlas != this.m_tlas
        || state.sceneBvh.m_tlas.deref().getBackingBufferHandle() != this.m_backingBuffer
        || state.sceneBvh.m_tlasMaxInstances != this.m_maxInstances
        || state.sceneBvh.m_tlasHeapHandle != this.m_heapHandle
    )
        return false;
    if(this.m_useInstanceBuffer){
        return state.sceneBvh.m_tlasInstanceBuffer.valid()
            && state.sceneBvh.m_tlasInstanceBuffer == this.m_instanceBuffer
            && state.sceneBvh.m_tlasInstanceUavHeapHandle == this.m_instanceUavHeapHandle
            && state.sceneBvh.m_tlasInstanceCapacity >= cast<usize>(this.m_instanceCount);
    }
    return true;
}


Expected<PreparedMeshBlasBuild> ResolvePreparedMeshBlasBuild(in MeshRayTracingResourceSnapshot meshResources){
    PreparedMeshBlasBuild build;
    if(meshResources.meshName == s_NameNone || !meshResources.positionBuffer.valid() || !meshResources.triangleIndexBuffer.valid() || !meshResources.blas.valid() || !meshResources.blas.deref().getBackingBufferHandle().valid())
        return MakeUnexpected(Failure());

    in BufferDesc positionDesc = meshResources.positionBuffer.deref().getCreationDescription();
    if(positionDesc.structStride == 0u || meshResources.meshletPrimitiveIndexCount == 0u)
        return MakeUnexpected(Failure());

    const MeshBlasBuildPlanDecision decision = ResolveMeshBlasBuildPlanDecision(
        positionDesc.byteSize,
        positionDesc.structStride,
        meshResources.meshletPrimitiveIndexCount,
        meshResources.runtimeMesh,
        meshResources.blasBuildPending,
        meshResources.blasBuildAccepted,
        meshResources.blasRefitsSinceRebuild
    );
    build.meshName = meshResources.meshName;
    build.positionBuffer = meshResources.positionBuffer;
    build.triangleIndexBuffer = meshResources.triangleIndexBuffer;
    build.blas = meshResources.blas;
    build.blasBackingBuffer = meshResources.blas.deref().getBackingBufferHandle();
    build.runtimeMeshVersion = meshResources.runtimeMeshVersion;
    build.geometryContentRevision = meshResources.runtimeGeometryContentRevision;
    build.acceptedGeometryContentRevision = meshResources.blasGeometryContentRevision;
    build.positionByteSize = positionDesc.byteSize;
    build.vertexStride = decision.vertexStride;
    build.vertexCount = decision.vertexCount;
    build.indexCount = meshResources.meshletPrimitiveIndexCount;
    build.refitsBeforeBuild = decision.refitsBeforeBuild;
    build.refitsAfterBuild = decision.refitsAfterBuild;
    build.runtimeMesh = meshResources.runtimeMesh;
    build.buildPending = meshResources.blasBuildPending;
    build.firstBuild = decision.firstBuild;
    build.backingFresh = meshResources.blasBackingFresh;
    build.performRefit = decision.performRefit;
    return build;
}

b8 MatchesPreparedMeshBlasBuild(in MeshRayTracingResourceSnapshot meshResources, in PreparedMeshBlasBuild build){
    if(
        !PreparedMeshBlasValidationPolicy().matchesCoreRevisionState(
            meshResources.meshName,
            build.meshName,
            meshResources.runtimeMesh,
            build.runtimeMesh,
            meshResources.runtimeMeshVersion,
            build.runtimeMeshVersion,
            meshResources.runtimeGeometryContentRevision,
            build.geometryContentRevision,
            meshResources.blasGeometryContentRevision,
            build.acceptedGeometryContentRevision,
            meshResources.meshletPrimitiveIndexCount,
            build.indexCount,
            meshResources.blasBuildPending,
            build.buildPending,
            meshResources.blasBuildAccepted,
            build.firstBuild,
            meshResources.blasBackingFresh,
            build.backingFresh,
            meshResources.blasRefitsSinceRebuild,
            build.refitsBeforeBuild
        )
        || meshResources.positionBuffer != build.positionBuffer
        || meshResources.triangleIndexBuffer != build.triangleIndexBuffer
        || meshResources.blas != build.blas
        || !meshResources.blas.valid()
        || meshResources.blas.deref().getBackingBufferHandle() != build.blasBackingBuffer
    )
        return false;

    in BufferDesc positionDesc = meshResources.positionBuffer.deref().getCreationDescription();
    return MatchesMeshBlasPositionLayout(positionDesc.structStride, positionDesc.byteSize, build.vertexStride, build.positionByteSize, build.vertexCount);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 RecordPreparedMeshBlasBuild(in PreparedMeshBlasBuild build, in b8 meshBlasGeometryBuildInputStatesGraphOwned, mut CommandList commandList){
    if(
        !build.positionBuffer.valid()
        || !build.triangleIndexBuffer.valid()
        || !build.blas.valid()
        || !build.blasBackingBuffer.valid()
        || !PreparedMeshBlasValidationPolicy().hasValidRecordDimensions(build.vertexStride, build.vertexCount, build.indexCount)
        || build.blas.deref().getBackingBufferHandle() != build.blasBackingBuffer
    )
        return false;

    RayTracingGeometryTriangles triangles;
    triangles.setVertexBuffer(build.positionBuffer.deref()).setVertexFormat(Format::RGB32_FLOAT).setVertexStride(build.vertexStride).setVertexCount(build.vertexCount)
        .setIndexBuffer(build.triangleIndexBuffer.deref()).setIndexFormat(Format::R32_UINT).setIndexCount(build.indexCount);
    RayTracingGeometryDesc geometry;
    geometry.setTriangles(triangles).setFlags(RayTracingGeometryFlags::NoDuplicateAnyHitInvocation);
    RayTracingAccelStructBuildFlags buildFlags = RayTracingAccelStructBuildFlags::PreferFastTrace;
    if(build.runtimeMesh)
        buildFlags |= RayTracingAccelStructBuildFlags::AllowUpdate;
    if(build.performRefit)
        buildFlags |= RayTracingAccelStructBuildFlags::PerformUpdate;

    if(!meshBlasGeometryBuildInputStatesGraphOwned){
        commandList.setBufferState(build.positionBuffer.deref(), ResourceStates::AccelStructBuildInput);
        commandList.setBufferState(build.triangleIndexBuffer.deref(), ResourceStates::AccelStructBuildInput);
    }
    commandList.commitBarriers();
    commandList.buildBottomLevelAccelStruct(build.blas.deref(), geometry, buildFlags);
    return true;
}

[cpp_unwind]
void RendererRayTracingSystem::confirmPreparedMeshBlasBuilds(){
    if(!this.m_preparedMeshBlasBuildsReady)
        return;

    b8 allPlansCurrent = true;
    for(in PreparedMeshBlasBuild build : this.m_preparedMeshBlasBuilds){
        auto meshResourcesResult = this.m_meshSystem.findRayTracingResourceSnapshot(build.meshName);
        if(!meshResourcesResult.has_value() || !MatchesPreparedMeshBlasBuild(meshResourcesResult.value(), build)){
            allPlansCurrent = false;
            continue;
        }

        const MeshRayTracingResourceSnapshot expected = meshResourcesResult.value();
        u64 firstBuilds = this.m_blasLedgerFirstBuilds;
        u64 refits = this.m_blasLedgerRefits;
        u64 rebuilds = this.m_blasLedgerRebuilds;
        u64 uploadedBytes = this.m_blasLedgerUploadedBytes;
        RayTracingBuildPolicy().applyConfirmedMeshBlasBuild(
            build.firstBuild,
            build.performRefit,
            build.refitsAfterBuild,
            build.geometryContentRevision,
            build.positionByteSize,
            meshResourcesResult.value().blasBuildPending,
            meshResourcesResult.value().blasBackingFresh,
            meshResourcesResult.value().blasRefitsSinceRebuild,
            meshResourcesResult.value().blasBuildAccepted,
            meshResourcesResult.value().blasGeometryContentRevision,
            firstBuilds,
            refits,
            rebuilds,
            uploadedBytes
        );
        if(!this.m_meshSystem.commitRayTracingResourceSnapshot(expected, meshResourcesResult.value())){
            allPlansCurrent = false;
            continue;
        }
        this.m_blasLedgerFirstBuilds = firstBuilds;
        this.m_blasLedgerRefits = refits;
        this.m_blasLedgerRebuilds = rebuilds;
        this.m_blasLedgerUploadedBytes = uploadedBytes;
        RayTracingDiagnostics().meshBlasFirstBuild(build.firstBuild, build.meshName, build.runtimeMesh, build.vertexCount, build.indexCount);
    }
    RayTracingBuildPolicy().finalizeConfirmedMeshBlasBuilds(
        allPlansCurrent,
        this.m_blasLedgerStaticSkipped,
        this.m_blasLedgerFirstBuilds,
        this.m_blasLedgerRefits,
        this.m_blasLedgerRebuilds,
        this.m_blasLedgerUploadedBytes,
        this.m_rayTracingState.sceneBvh.m_tlasStaticSceneHashValid
    );
    this.clearPreparedMeshBlasBuilds();
}

[cpp_unwind]
b8 RendererRayTracingSystem::preparePendingMeshBlasResources(){
    if(!this.m_graphics.queryFeatureSupport(Feature::RayTracingAccelStruct))
        return false;

    b8 allResourcesReady = true;
    this.m_pendingBlasStaticSkipped = 0u;
    mut MeshRayTracingResourceSnapshotVector meshes = this.m_sceneGatherScratch.pendingMeshBuildSnapshots;
    meshes.clear();
    u64 staticSkipped = 0u;
    this.m_meshSystem.collectPendingBlasRayTracingSnapshots(meshes, staticSkipped);
    this.m_pendingBlasStaticSkipped = staticSkipped;
    for(mut MeshRayTracingResourceSnapshot meshResources : meshes){
        const MeshRayTracingResourceSnapshot expected = meshResources;
        if(!this.prepareMeshBlasResources(meshResources)){
            warning("RendererSystem: BLAS resource preflight failed for mesh '{}'", meshResources.meshName.resolvedText());
            allResourcesReady = false;
        }
        else if(!this.m_meshSystem.commitRayTracingResourceSnapshot(expected, meshResources)){
            warning("RendererSystem: BLAS resource preflight lost mesh '{}'", meshResources.meshName.resolvedText());
            allResourcesReady = false;
        }
    }
    if(!allResourcesReady)
        meshes.clear();
    return allResourcesReady;
}

[cpp_unwind]
b8 RendererRayTracingSystem::capturePreparedMeshBlasBuilds(){
    this.clearPreparedMeshBlasBuilds();
    if(!this.m_graphics.queryFeatureSupport(Feature::RayTracingAccelStruct))
        return false;

    mut MeshRayTracingResourceSnapshotVector meshes = this.m_sceneGatherScratch.pendingMeshBuildSnapshots;
    this.m_blasLedgerStaticSkipped += this.m_pendingBlasStaticSkipped;
    this.m_pendingBlasStaticSkipped = 0u;
    for(in MeshRayTracingResourceSnapshot meshResources : meshes){
        auto build = ResolvePreparedMeshBlasBuild(meshResources);
        if(!build.has_value()){
            warning("RendererSystem: could not freeze BLAS build for mesh '{}'", meshResources.meshName.resolvedText());
            meshes.clear();
            this.clearPreparedMeshBlasBuilds();
            return false;
        }
        this.m_preparedMeshBlasBuilds.push_back(build.value());
    }
    meshes.clear();
    this.m_preparedMeshBlasBuildsReady = !this.m_preparedMeshBlasBuilds.empty();
    return true;
}

[cpp_unwind]
b8 RendererRayTracingSystem::recordPreparedMeshBlasBuilds(mut CommandList commandList, in b8 meshBlasGeometryBuildInputStatesGraphOwned){
    if(!this.m_preparedMeshBlasBuildsReady || this.m_preparedMeshBlasBuilds.empty())
        return false;

    for(in PreparedMeshBlasBuild build : this.m_preparedMeshBlasBuilds){
        auto meshResourcesResult = this.m_meshSystem.findRayTracingResourceSnapshot(build.meshName);
        if(!meshResourcesResult.has_value() || !MatchesPreparedMeshBlasBuild(meshResourcesResult.value(), build)){
            warning("RendererSystem: frozen BLAS build no longer matches mesh '{}'", build.meshName.resolvedText());
            return false;
        }
    }
    for(in PreparedMeshBlasBuild build : this.m_preparedMeshBlasBuilds){
        if(!RecordPreparedMeshBlasBuild(build, meshBlasGeometryBuildInputStatesGraphOwned, commandList)){
            warning("RendererSystem: failed to record frozen BLAS build for mesh '{}'", build.meshName.resolvedText());
            return false;
        }
    }
    return true;
}

void RendererRayTracingSystem::clearPreparedMeshBlasBuilds(){
    this.m_preparedMeshBlasBuilds.clear();
    this.m_preparedMeshBlasBuildsReady = false;
}

[cpp_unwind]
b8 RendererRayTracingSystem::prepareMeshBlasResources(mut MeshRayTracingResourceSnapshot meshResources){
    if(!meshResources.positionBuffer.valid() || !meshResources.triangleIndexBuffer.valid())
        return false;

    in BufferDesc positionDesc = meshResources.positionBuffer.deref().getCreationDescription();
    if(positionDesc.structStride == 0u || meshResources.meshletPrimitiveIndexCount == 0u)
        return false;

    if(meshResources.blas.valid())
        return true;

    const u32 vertexStride = cast<u32>(positionDesc.structStride);
    const u32 vertexCount = ComputeMeshBlasVertexCount(positionDesc.byteSize, positionDesc.structStride);
    RayTracingGeometryTriangles triangles;
    triangles.setVertexBuffer(meshResources.positionBuffer.deref()).setVertexFormat(Format::RGB32_FLOAT).setVertexStride(vertexStride).setVertexCount(vertexCount)
        .setIndexBuffer(meshResources.triangleIndexBuffer.deref()).setIndexFormat(Format::R32_UINT).setIndexCount(meshResources.meshletPrimitiveIndexCount);
    RayTracingGeometryDesc geometry;
    geometry.setTriangles(triangles).setFlags(RayTracingGeometryFlags::NoDuplicateAnyHitInvocation);
    RayTracingAccelStructBuildFlags buildFlags = RayTracingAccelStructBuildFlags::PreferFastTrace;
    if(meshResources.runtimeMesh)
        buildFlags |= RayTracingAccelStructBuildFlags::AllowUpdate;
    RayTracingAccelStructDesc accelStructDesc = this.m_graphics.getDevice().makeAccelStructDesc();
    accelStructDesc.addBottomLevelGeometry(geometry);
    accelStructDesc.setBuildFlags(buildFlags);
    accelStructDesc.setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute);
    const auto blasName = DeriveName(meshResources.meshName, s_BlasNameSuffix);
    if(!blasName.has_value()){
        error("RendererSystem: failed to create BLAS for mesh '{}'", meshResources.meshName.resolvedText());
        return false;
    }
    accelStructDesc.setDebugName(blasName.value());
    auto blasResult = this.m_graphics.getDevice().createAccelStruct(accelStructDesc);
    if(!blasResult.has_value()){
        error("RendererSystem: failed to create BLAS for mesh '{}'", meshResources.meshName.resolvedText());
        return false;
    }
    RayTracingAccelStructHandle blas = blasResult.value();
    meshResources.blas = blas;
    RayTracingBuildPolicy().initializeCreatedMeshBlas(
        meshResources.blasBuildPending,
        meshResources.blasBuildAccepted,
        meshResources.blasGeometryContentRevision,
        meshResources.blasBackingFresh,
        meshResources.blasRefitsSinceRebuild
    );
    return true;
}

b8 PreparedSceneTlasBuild::capture(
    in RendererRayTracingState state,
    in b8 staticScene,
    in u64 staticSceneHash,
    in Span<RayTracingInstanceDesc> instances,
    in Span<RayTracingAccelStructHandle> instanceBlases
){
    this.clear();
    if(instances.empty() || instances.size() != instanceBlases.size() || !IsPreparedSceneTlasStorageReady(state, instances.size()))
        return false;

    this.m_instances.reserve(instances.size());
    this.m_blases.reserve(instanceBlases.size());
    for(usize index = 0u; index < instances.size(); ++index){
        in RayTracingAccelStructHandle blas = instanceBlases[index];
        if(!blas.valid() || instances[index].bottomLevelIdentity() != blas.identity()){
            this.clear();
            return false;
        }
        this.m_instances.push_back(instances[index]);
        this.m_blases.push_back(blas);
    }
    this.m_tlas = state.sceneBvh.m_tlas;
    this.m_backingBuffer = state.sceneBvh.m_tlas.deref().getBackingBufferHandle();
    this.m_heapHandle = state.sceneBvh.m_tlasHeapHandle;
    this.m_maxInstances = state.sceneBvh.m_tlasMaxInstances;
    this.m_staticSceneHash = staticSceneHash;
    this.m_static = staticScene;
    this.m_ready = true;
    return true;
}

b8 PreparedSceneTlasBuild::captureFromInstanceBuffer(
    in RendererRayTracingState state,
    in b8 staticScene,
    in u64 staticSceneHash,
    in Span<RayTracingInstanceDesc> instances,
    in Span<RayTracingAccelStructHandle> instanceBlases,
    in Span<u32> instanceEntityIds
){
    this.clear();
    if(
        instances.empty()
        || instances.size() != instanceBlases.size()
        || instances.size() != instanceEntityIds.size()
        || !IsPreparedSceneTlasStorageReady(state, instances.size())
        || !state.sceneBvh.m_tlasInstanceBuffer.valid()
        || state.sceneBvh.m_tlasInstanceCapacity < instances.size()
        || !IsDescriptorClass(state.sceneBvh.m_tlasInstanceUavHeapHandle, GpuDescriptorClass::StorageBuffer)
    )
        return false;

    this.m_gpuInstances.reserve(instances.size());
    this.m_blases.reserve(instanceBlases.size());
    this.m_instanceEntityIds.reserve(instanceEntityIds.size());
    for(usize index = 0u; index < instances.size(); ++index){
        in RayTracingAccelStructHandle blas = instanceBlases[index];
        if(!blas.valid() || instances[index].bottomLevelIdentity() != blas.identity()){
            this.clear();
            return false;
        }
        this.m_gpuInstances.push_back(PackTlasInstanceGpuData(instances[index], blas.deref()));
        this.m_blases.push_back(blas);
        this.m_instanceEntityIds.push_back(instanceEntityIds[index]);
    }
    this.m_tlas = state.sceneBvh.m_tlas;
    this.m_backingBuffer = state.sceneBvh.m_tlas.deref().getBackingBufferHandle();
    this.m_instanceBuffer = state.sceneBvh.m_tlasInstanceBuffer;
    this.m_heapHandle = state.sceneBvh.m_tlasHeapHandle;
    this.m_instanceUavHeapHandle = state.sceneBvh.m_tlasInstanceUavHeapHandle;
    this.m_maxInstances = state.sceneBvh.m_tlasMaxInstances;
    this.m_instanceCount = cast<u32>(instances.size());
    this.m_staticSceneHash = staticSceneHash;
    this.m_useInstanceBuffer = true;
    this.m_static = staticScene;
    this.m_ready = true;
    return true;
}

Expected<Optional<GpuUploadBlobId>> PreparedSceneTlasBuild::retainUpload(in RendererRayTracingState state, mut GpuTaskGraph graph)const{
    Optional<GpuUploadBlobId> emptyBlob;
    if(!this.m_ready || !this.m_useInstanceBuffer || this.m_gpuInstances.empty())
        return emptyBlob;
    if(!this.storageMatches(state) || !IsPreparedSceneTlasStorageReady(state, cast<usize>(this.m_instanceCount)))
        return MakeUnexpected(Failure());
    const auto uploadResult = graph.copyUploadElements<TlasInstanceGpuData>(Span<TlasInstanceGpuData>(this.m_gpuInstances));
    if(!uploadResult.has_value())
        return MakeUnexpected(uploadResult.error());
    return Optional<GpuUploadBlobId>(uploadResult.value());
}

b8 PreparedSceneTlasBuild::record(mut RendererRayTracingState state, mut CommandList commandList){
    if(this.m_useInstanceBuffer){
        const usize instanceCount = cast<usize>(this.m_instanceCount);
        if(!this.m_ready || instanceCount == 0u || this.m_blases.size() != instanceCount || !this.m_instanceBuffer.valid() || !this.storageMatches(state) || !IsPreparedSceneTlasStorageReady(state, instanceCount)){
            warning("RendererSystem: frozen scene TLAS instance-buffer build no longer matches preflight storage");
            return false;
        }
        for(usize index = 0u; index < instanceCount; ++index){
            if(!this.m_blases[index].valid()){
                warning("RendererSystem: frozen scene TLAS build lost a referenced BLAS");
                return false;
            }
        }
        commandList.buildTopLevelAccelStructFromBuffer(this.m_tlas.deref(), this.m_instanceBuffer.deref(), cast<u64>(0u), instanceCount, RayTracingAccelStructBuildFlags::PreferFastTrace);
        return true;
    }

    if(!this.m_ready || this.m_instances.empty() || this.m_instances.size() != this.m_blases.size() || !this.storageMatches(state) || !IsPreparedSceneTlasStorageReady(state, this.m_instances.size())){
        warning("RendererSystem: frozen scene TLAS build no longer matches preflight storage");
        return false;
    }
    for(usize index = 0u; index < this.m_instances.size(); ++index){
        if(!this.m_blases[index].valid() || this.m_instances[index].bottomLevelIdentity() != this.m_blases[index].identity()){
            warning("RendererSystem: frozen scene TLAS build lost a referenced BLAS");
            return false;
        }
    }

    commandList.buildTopLevelAccelStruct(this.m_tlas.deref(), this.m_instances, RayTracingAccelStructBuildFlags::PreferFastTrace);
    return true;
}

void AppendTlasStaticSceneIdentity(in RayTracingInstanceDesc instance, mut u64 inOutHash){
    RayTracingSceneIdentityBuilder().updateTlasStaticInput(
        MatrixSingle(instance.transform),
        cast<u32>(instance.instanceID),
        cast<u32>(instance.instanceMask),
        cast<u32>(instance.instanceContributionToHitGroupIndex),
        cast<u32>(instance.flags),
        inOutHash
    );
    Fnv64AppendValue(inOutHash, instance.bottomLevelIdentity());
}

u64 ComputeTlasStaticSceneIdentity(in Span<RayTracingInstanceDesc> instances){
    u64 hash = s_Fnv64OffsetBasis;
    Fnv64AppendValue(hash, s_SceneStaticCacheHashVersion);
    Fnv64AppendValue(hash, instances.size());
    for(in RayTracingInstanceDesc instance : instances)
        AppendTlasStaticSceneIdentity(instance, hash);
    return hash;
}

Expected<GpuDescriptorHandle> MeshHeapHandleGather::acquire(in BufferHandle bufferHandle){
    if(!bufferHandle.valid())
        return MakeUnexpected(Failure());
    mut Buffer buffer = bufferHandle.deref();
    const usize key = bufferHandle.identity();
    const auto found = this.m_cache.find(key);
    if(found != this.m_cache.end()){
        mut RtMeshHeapHandleCacheEntry entry = found.value();
        assert(entry.handle.valid());
        entry.seenThisFrame = true;
        return entry.handle;
    }
    const auto handle = RegisterHeapBuffer(this.m_heap, buffer, GpuDescriptorClass::StorageBuffer, false);
    if(!handle.has_value())
        return MakeUnexpected(Failure());
    GpuDescriptorRetirementGuard retirement(this.m_heap, handle.value());
    RtMeshHeapHandleCacheEntry entry;
    entry.keepAlive = bufferHandle;
    entry.handle = handle.value();
    entry.seenThisFrame = true;
    if(!this.m_cache.try_emplace(key, entry).second){
        assert(false);
        return MakeUnexpected(Failure());
    }
    retirement.release();
    return handle.value();
}

void MeshHeapHandleGather::begin(){
    for(auto it = this.m_cache.begin(); it != this.m_cache.end(); ++it)
        it.value().seenThisFrame = false;
}

void MeshHeapHandleGather::sweep(){
    auto it = this.m_cache.begin();
    while(it != this.m_cache.end()){
        if(it.value().seenThisFrame){
            it.value().seenThisFrame = false;
            ++it;
        }
        else{
            this.m_heap.free(it.value().handle);
            it = this.m_cache.erase(it);
        }
    }
}


