#include <impl/assets_font/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_FontAtlasMaxGlyphCount = 65535u;
const u32 s_FontAtlasMaxGroupCount = 8u;
const u32 s_FontAtlasMaxChannelCount = 4u;
const u32 s_FontAtlasMaxPositioningTableCount = 3u; // kern, GPOS and GDEF.
const u32 s_FontAtlasMinUnitsPerEm = 16u;
const u32 s_FontAtlasMaxUnitsPerEm = 16384u;
const u32 s_FontAtlasMaxExtent = 2048u;
const u32 s_FontAtlasBytesPerKilobyte = 1024u;
const u32 s_FontAtlasMaxPixelMegabytes = 128u;
const u32 s_FontAtlasMaxPixelBytes = s_FontAtlasMaxPixelMegabytes * s_FontAtlasBytesPerKilobyte * s_FontAtlasBytesPerKilobyte;
const u32 s_FontAtlasMinBakePpem = 16u;
const u32 s_FontAtlasMaxBakePpem = 256u;
const u32 s_FontAtlasMinSpreadPixels = 2u;
const u32 s_FontAtlasMaxSpreadPixels = 32u;
const u32 s_FontAtlasDistanceEncoding = 1u;
const u32 s_FontAtlasMaxPositioningMegabytes = 32u;
const u32 s_FontAtlasMaxPositioningBytes = s_FontAtlasMaxPositioningMegabytes * s_FontAtlasBytesPerKilobyte * s_FontAtlasBytesPerKilobyte;
const u32 s_FontAtlasDefaultBakePpem = 64u;
const u32 s_FontAtlasDefaultSpreadPixels = 8u;
const u32 s_FontAtlasDefaultGuardTexels = 1u;
const u32 s_FontAtlasKernTag = 0x6b65726eu;
const u32 s_FontAtlasGposTag = 0x47504f53u;
const u32 s_FontAtlasGdefTag = 0x47444546u;

const u32 s_FontAtlasBinaryMagic = 0x31415446u; // FTA1, explicitly encoded little endian.
const u32 s_FontAtlasBinaryVersion = 2u;
const u32 s_FontAtlasBinaryHeaderBytes = 164u;
const u32 s_FontAtlasBinaryGlyphBytes = 52u;
const u32 s_FontAtlasBinaryGroupHeaderBytes = 48u;
const u32 s_FontAtlasBinaryTableHeaderBytes = 40u;
const u32 s_FontAtlasQwordHighWordShift = 32u;

const usize s_FontAtlasOccupiedWordLastBit = 63u;
const usize s_FontAtlasBitsPerOccupiedWord = 64u;
const f32 s_FontAtlasGlyphPlaneSizeRelativeTolerance = 0.0001f;

const Name s_AssetsFontAtlasLoadBinaryArena = "impl/assets_font_atlas/load_binary";
const Name s_AssetsFontAtlasSerializeArena = "impl/assets_font_atlas/serialize";

const StringView s_FontAtlasMetaDiagnosticPrefix = "Font atlas meta";
const StringView s_FontAtlasMetaFontField = "font";
const StringView s_FontAtlasBakePpemField = "bake_ppem";
const StringView s_FontAtlasSpreadPixelsField = "spread_pixels";
const StringView s_FontAtlasRasterModeField = "raster_mode";
const StringView s_FontAtlasAscenderUnitsField = "ascender_units";
const StringView s_FontAtlasDescenderUnitsField = "descender_units";
const StringView s_FontAtlasLineGapUnitsField = "line_gap_units";
const StringView s_FontAtlasRasterModeBitmap = "bitmap";
const StringView s_FontAtlasRasterModeOutline = "outline";
const StringView s_FontAtlasGlyphsField = "glyphs";

const StringView s_FontAtlasGlyphMetaDiagnosticPrefix = "Font atlas glyph meta";
const StringView s_FontAtlasGlyphAdvanceUnitsField = "advance_units";
const StringView s_FontAtlasGlyphGroupField = "group";
const StringView s_FontAtlasGlyphChannelField = "channel";
const StringView s_FontAtlasGlyphXField = "x";
const StringView s_FontAtlasGlyphYField = "y";
const StringView s_FontAtlasGlyphWidthField = "width";
const StringView s_FontAtlasGlyphHeightField = "height";
const StringView s_FontAtlasGlyphPlaneLeftField = "plane_left";
const StringView s_FontAtlasGlyphPlaneTopField = "plane_top";

[reflect]
enum<u32> FontAtlasRasterMode{
    Outline = 0u,
    Bitmap = 1u
}

[reflect]
class FontAtlasGlyph{
    public u32 glyphId = 0u;
    public u32 group = 0u;
    public u32 channel = 0u;
    public u32 x = 0u;
    public u32 y = 0u;
    public u32 width = 0u;
    public u32 height = 0u;
    public f32 planeLeft = 0.0f;
    public f32 planeTop = 0.0f;
    public f32 planeRight = 0.0f;
    public f32 planeBottom = 0.0f;
    public f32 advanceUnits = 0.0f;
    public u32 drawable = 0u;
}

Expected<FontAtlasRasterMode> TryParseFontAtlasRasterMode(in StringView text){
    if(text == s_FontAtlasRasterModeBitmap)
        return FontAtlasRasterMode::Bitmap;
    if(text == s_FontAtlasRasterModeOutline)
        return FontAtlasRasterMode::Outline;
    return makeUnexpected(Failure());
}

b8 IsAllowedFontAtlasGlyphField(in StringView field, in b8 hasBitmap){
    return
        field == s_FontAtlasGlyphAdvanceUnitsField
        || (
            hasBitmap
            && (
                field == s_FontAtlasGlyphGroupField
                || field == s_FontAtlasGlyphChannelField
                || field == s_FontAtlasGlyphXField
                || field == s_FontAtlasGlyphYField
                || field == s_FontAtlasGlyphWidthField
                || field == s_FontAtlasGlyphHeightField
                || field == s_FontAtlasGlyphPlaneLeftField
                || field == s_FontAtlasGlyphPlaneTopField
            )
        )
    ;
}

b8 IsValidFontAtlasMetrics(in f32 ascenderUnits, in f32 descenderUnits, in f32 lineGapUnits){
    return isFinite(ascenderUnits) && isFinite(descenderUnits) && isFinite(lineGapUnits) && ascenderUnits > descenderUnits && lineGapUnits >= 0.0f;
}

b8 IsValidFontAtlasGlyphGroupRect(in FontAtlasGlyph glyph, in u32 groupWidth, in u32 groupHeight, in u32 groupChannelCount, in u32 guardTexels){
    return
        glyph.channel < groupChannelCount
        && glyph.x >= guardTexels
        && glyph.y >= guardTexels
        && glyph.x < groupWidth
        && glyph.y < groupHeight
        && glyph.width < groupWidth - glyph.x
        && glyph.height < groupHeight - glyph.y
    ;
}

u64 PackFontAtlasQword(in u32 low, in u32 high){
    return cast<u64>(low) | (cast<u64>(high) << s_FontAtlasQwordHighWordShift);
}

u32 UnpackFontAtlasLowWord(in u64 qword){
    return cast<u32>(qword);
}

u32 UnpackFontAtlasHighWord(in u64 qword){
    return cast<u32>(qword >> s_FontAtlasQwordHighWordShift);
}

b8 IsValidNondrawableFontAtlasGlyph(in FontAtlasGlyph glyph){
    return
        glyph.group == 0u
        && glyph.channel == 0u
        && glyph.x == 0u
        && glyph.y == 0u
        && glyph.width == 0u
        && glyph.height == 0u
        && glyph.planeLeft == 0.0f
        && glyph.planeTop == 0.0f
        && glyph.planeRight == 0.0f
        && glyph.planeBottom == 0.0f
    ;
}

f32 ComputeFontAtlasUnitsPerPixel(in u32 unitsPerEm, in u32 bakePpem){
    return cast<f32>(unitsPerEm) / cast<f32>(bakePpem);
}

void ComputeFontAtlasGlyphPlaneBounds(in f32 unitsPerPixel, mut FontAtlasGlyph inOutGlyph){
    inOutGlyph.planeRight = inOutGlyph.planeLeft + cast<f32>(inOutGlyph.width) * unitsPerPixel;
    inOutGlyph.planeBottom = inOutGlyph.planeTop + cast<f32>(inOutGlyph.height) * unitsPerPixel;
    inOutGlyph.drawable = 1u;
}

b8 IsValidFontAtlasGlyphPlaneBounds(in FontAtlasGlyph glyph, in f32 unitsPerPixel){
    const f32 expectedWidth = cast<f32>(glyph.width) * unitsPerPixel;
    const f32 expectedHeight = cast<f32>(glyph.height) * unitsPerPixel;
    const f32 planeWidth = glyph.planeRight - glyph.planeLeft;
    const f32 planeHeight = glyph.planeBottom - glyph.planeTop;
    return
        abs(planeWidth - expectedWidth) <= expectedWidth * s_FontAtlasGlyphPlaneSizeRelativeTolerance
        && abs(planeHeight - expectedHeight) <= expectedHeight * s_FontAtlasGlyphPlaneSizeRelativeTolerance
    ;
}

b8 IsValidFontAtlasGroupDimensions(in u32 width, in u32 height, in u32 channelCount){
    return
        width > 0u
        && width <= s_FontAtlasMaxExtent
        && height > 0u
        && height <= s_FontAtlasMaxExtent
        && channelCount > 0u
        && channelCount <= s_FontAtlasMaxChannelCount
    ;
}

Expected<usize> TryComputeFontAtlasOccupancyWordCount(in u32 width, in u32 height, in u32 channelCount){
    if(!IsValidFontAtlasGroupDimensions(width, height, channelCount))
        return makeUnexpected(Failure());
    const usize totalBits = cast<usize>(width) * cast<usize>(height) * cast<usize>(channelCount);
    return (totalBits + s_FontAtlasOccupiedWordLastBit) / s_FontAtlasBitsPerOccupiedWord;
}

b8 IsValidFontAtlasBakeParameters(in u32 bakePpem, in u32 spreadPixels, in u32 guardTexels, in FontAtlasRasterMode rasterMode){
    return
        bakePpem >= s_FontAtlasMinBakePpem
        && bakePpem <= s_FontAtlasMaxBakePpem
        && spreadPixels >= s_FontAtlasMinSpreadPixels
        && spreadPixels <= s_FontAtlasMaxSpreadPixels
        && guardTexels == s_FontAtlasDefaultGuardTexels
        && cast<u32>(rasterMode) <= cast<u32>(FontAtlasRasterMode::Bitmap)
    ;
}

b8 IsAllowedFontAtlasMetadataField(in StringView field){
    return
        field == s_FontAtlasMetaFontField
        || field == s_FontAtlasBakePpemField
        || field == s_FontAtlasSpreadPixelsField
        || field == s_FontAtlasRasterModeField
        || field == s_FontAtlasAscenderUnitsField
        || field == s_FontAtlasDescenderUnitsField
        || field == s_FontAtlasLineGapUnitsField
        || field == s_FontAtlasGlyphsField
    ;
}

b8 IsFontAtlasPositioningTableTag(in u32 tag){
    return tag == s_FontAtlasKernTag || tag == s_FontAtlasGposTag || tag == s_FontAtlasGdefTag;
}

class FontFaceSfntMetrics{
    public u32 unitsPerEm = 0u;
    public u32 sourceGlyphCount = 0u;
}

Expected<FontFaceSfntMetrics> TryReadFontFaceMetricsFromSfnt(in Span<u8> fontBytes){
    const Expected<FontSfntDirectory> directory = ReadFontSfntDirectory(fontBytes);
    if(!directory.has_value())
        return makeUnexpected(Failure());
    u32 unitsPerEm = 0u;
    u32 sourceGlyphCount = 0u;
    b8 hasHead = false;
    b8 hasMaxp = false;
    for(u16 index = 0u; index < directory.value().tableCount(); ++index){
        const Expected<FontSfntTable> table = directory.value().table(cast<usize>(index));
        if(!table.has_value())
            return makeUnexpected(Failure());
        if(table.value().tag == s_FontSfntHeadTag){
            if(table.value().bytes.size() < s_FontSfntHeadUnitsPerEmOffset + s_FontSfntU16Bytes)
                return makeUnexpected(Failure());
            unitsPerEm = cast<u32>(ReadFontSfntU16BigEndian(table.value().bytes, s_FontSfntHeadUnitsPerEmOffset));
            hasHead = true;
        }
        else if(table.value().tag == s_FontSfntMaxpTag){
            if(table.value().bytes.size() < s_FontSfntMaxpGlyphCountOffset + s_FontSfntU16Bytes)
                return makeUnexpected(Failure());
            sourceGlyphCount = cast<u32>(ReadFontSfntU16BigEndian(table.value().bytes, s_FontSfntMaxpGlyphCountOffset));
            hasMaxp = true;
        }
    }
    if(
        !hasHead
        || !hasMaxp
        || unitsPerEm < s_FontAtlasMinUnitsPerEm
        || unitsPerEm > s_FontAtlasMaxUnitsPerEm
        || sourceGlyphCount == 0u
    )
        return makeUnexpected(Failure());
    FontFaceSfntMetrics out;
    out.unitsPerEm = unitsPerEm;
    out.sourceGlyphCount = sourceGlyphCount;
    return out;
}

class FontAtlasGroupCompactBounds{
    public u32 firstX = 0u;
    public u32 firstY = 0u;
    public u32 width = 0u;
    public u32 height = 0u;
    public u32 channelCount = 0u;
    public b8 unchanged = false;
}

FontAtlasGroupCompactBounds ComputeFontAtlasGroupCompactBounds(
    in Span<FontAtlasGlyph> glyphs,
    in u32 groupIndex,
    in u32 groupWidth,
    in u32 groupHeight,
    in u32 groupChannelCount,
    in u32 guardTexels
){
    u32 firstX = groupWidth;
    u32 firstY = groupHeight;
    u32 endX = 0u;
    u32 endY = 0u;
    u32 channelCount = 0u;
    for(usize i = 0u; i < glyphs.size(); ++i){
        const FontAtlasGlyph glyph = glyphs[i];
        if(glyph.drawable == 0u || glyph.group != groupIndex)
            continue;
        firstX = min(firstX, glyph.x - guardTexels);
        firstY = min(firstY, glyph.y - guardTexels);
        endX = max(endX, glyph.x + glyph.width + guardTexels);
        endY = max(endY, glyph.y + glyph.height + guardTexels);
        channelCount = max(channelCount, glyph.channel + 1u);
    }
    assert(channelCount > 0u);
    FontAtlasGroupCompactBounds out;
    out.firstX = firstX;
    out.firstY = firstY;
    out.width = endX - firstX;
    out.height = endY - firstY;
    out.channelCount = channelCount;
    out.unchanged = firstX == 0u && firstY == 0u && out.width == groupWidth && out.height == groupHeight && channelCount == groupChannelCount;
    return out;
}

void OffsetFontAtlasGroupGlyph(in u32 groupIndex, in u32 firstX, in u32 firstY, mut FontAtlasGlyph inoutGlyph){
    if(inoutGlyph.drawable != 0u && inoutGlyph.group == groupIndex){
        inoutGlyph.x -= firstX;
        inoutGlyph.y -= firstY;
    }
}

b8 ValidateFontAtlasGlyphRecord(
    in FontAtlasGlyph glyph,
    in usize expectedIndex,
    in usize groupCount,
    in f32 unitsPerPixel
){
    if(
        cast<usize>(glyph.glyphId) != expectedIndex
        || glyph.drawable > 1u
        || !isFinite(glyph.advanceUnits)
        || !isFinite(glyph.planeLeft)
        || !isFinite(glyph.planeTop)
        || !isFinite(glyph.planeRight)
        || !isFinite(glyph.planeBottom)
    ){
        error("FontAtlas validation failed: invalid glyph ID, flags, or metrics at {}", expectedIndex);
        return false;
    }
    if(glyph.drawable == 0u){
        if(!IsValidNondrawableFontAtlasGlyph(glyph)){
            error("FontAtlas validation failed: nondrawable glyph {} carries a bitmap", expectedIndex);
            return false;
        }
        return true;
    }
    if(
        cast<usize>(glyph.group) >= groupCount
        || glyph.width == 0u
        || glyph.height == 0u
        || glyph.planeLeft >= glyph.planeRight
        || glyph.planeTop >= glyph.planeBottom
    ){
        error("FontAtlas validation failed: invalid glyph {} page or padded bounds", expectedIndex);
        return false;
    }
    if(!IsValidFontAtlasGlyphPlaneBounds(glyph, unitsPerPixel)){
        error("FontAtlas validation failed: glyph {} plane bounds disagree with bitmap size", expectedIndex);
        return false;
    }
    return true;
}

u64 ComputeFontAtlasGuardedWordMask(in usize begin, in usize last, in usize word){
    u64 mask = u64.max;
    if(word == begin / s_BitsPerU64)
        mask &= u64.max << (begin % s_BitsPerU64);
    if(word == last / s_BitsPerU64)
        mask &= u64.max >> (s_FontAtlasOccupiedWordLastBit - (last % s_BitsPerU64));
    return mask;
}

b8 TryMarkFontAtlasGuardedWordOccupied(in u32 glyphId, in usize begin, in usize last, in usize word, mut u64 inOutOccupiedWord){
    const u64 mask = ComputeFontAtlasGuardedWordMask(begin, last, word);
    if((inOutOccupiedWord & mask) != 0u){
        error("FontAtlas validation failed: glyph {} overlaps another guarded region", glyphId);
        return false;
    }
    inOutOccupiedWord |= mask;
    return true;
}


