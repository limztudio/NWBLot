const StringView s_UiProgressCasePanelKey = "panel";
const StringView s_UiRadioCasePanelKey = "panel";

Point MakeUiProgressPoint(in f32 x, in f32 y){
    Point point = Point();
    point.x = x;
    point.y = y;
    return point;
}

Rect MakeUiProgressRect(in f32 x, in f32 y, in f32 width, in f32 height){
    Rect rect = Rect();
    rect.x = x;
    rect.y = y;
    rect.width = width;
    rect.height = height;
    return rect;
}

Insets MakeUiProgressInsets(in f32 left, in f32 top, in f32 right, in f32 bottom){
    Insets insets = Insets();
    insets.left = left;
    insets.top = top;
    insets.right = right;
    insets.bottom = bottom;
    return insets;
}

Color MakeUiProgressColor(in f32 r, in f32 g, in f32 b, in f32 a){
    Color color = Color();
    color.r = r;
    color.g = g;
    color.b = b;
    color.a = a;
    return color;
}

UiSkinRegion MakeUiProgressNineSliceRegion(){
    UiSkinRegion region = UiSkinRegion();
    region.name = Name(s_UiCaseProgressTest);
    region.rectangle.x = 0u;
    region.rectangle.y = 0u;
    region.rectangle.width = 24u;
    region.rectangle.height = 24u;
    region.sliceInsets.left = 6u;
    region.sliceInsets.top = 6u;
    region.sliceInsets.right = 6u;
    region.sliceInsets.bottom = 6u;
    region.padding.left = 8.0f;
    region.padding.top = 8.0f;
    region.padding.right = 8.0f;
    region.padding.bottom = 8.0f;
    region.minimumWidth = 12.0f;
    region.minimumHeight = 12.0f;
    region.drawMode = UiSkinDrawMode::NineSlice;
    return region;
}

ProgressOptions MakeUiProgressDefaultOptions(){
    ProgressOptions options = ProgressOptions();
    options.width.policy = LayoutSizePolicy::Fixed;
    options.width.value = 240.0f;
    return options;
}

void ExpectUiProgressPointExact(in Point actual, in Point expected){
    EXPECT_EQ(bit_cast<u32>(actual.x), bit_cast<u32>(expected.x));
    EXPECT_EQ(bit_cast<u32>(actual.y), bit_cast<u32>(expected.y));
}

void ExpectUiProgressPaddingExact(in Insets actual, in Insets expected){
    EXPECT_EQ(bit_cast<u32>(actual.left), bit_cast<u32>(expected.left));
    EXPECT_EQ(bit_cast<u32>(actual.top), bit_cast<u32>(expected.top));
    EXPECT_EQ(bit_cast<u32>(actual.right), bit_cast<u32>(expected.right));
    EXPECT_EQ(bit_cast<u32>(actual.bottom), bit_cast<u32>(expected.bottom));
}

ControlAction MakeUiRadioGroupActionKey(in RadioGroupState state, in ControlActionKindEnum kind, in u64 keyValue){
    const RadioGroupSnapshot snapshot = state.snapshot();
    ControlAction action = ControlAction();
    action.control.instanceGeneration = snapshot.inputGeneration;
    action.control.contentGeneration = snapshot.sourceGeneration;
    action.control.contentRevision = snapshot.sourceRevision;
    action.kind = kind;
    action.value = keyValue;
    return action;
}

ControlAction MakeUiRadioGroupAction(in RadioGroupState state, in ControlActionKindEnum kind){
    return MakeUiRadioGroupActionKey(state, kind, 0u);
}

RadioGroupResult MakeUiRadioGroupResult(in b8 valid, in b8 selectionChanged, in b8 activated, in b8 focused){
    RadioGroupResult result = RadioGroupResult();
    result.valid = valid;
    result.selectionChanged = selectionChanged;
    result.activated = activated;
    result.focused = focused;
    return result;
}

void ExpectUiRadioGroupResult(in RadioGroupResult actual, in RadioGroupResult expected){
    EXPECT_EQ(actual.valid, expected.valid);
    EXPECT_EQ(actual.selectionChanged, expected.selectionChanged);
    EXPECT_EQ(actual.activated, expected.activated);
    EXPECT_EQ(actual.focused, expected.focused);
}

InputEvent MakeUiRadioPointEvent(in InputEventTypeEnum type, in Point point){
    InputEvent event = InputEvent();
    event.type = type;
    event.position = point;
    return event;
}

InputEvent MakeUiRadioKeyEvent(in InputEventTypeEnum type, in KeyEnum key){
    InputEvent event = InputEvent();
    event.type = type;
    event.key = key;
    return event;
}


