#include <utilities/tex_conv/output.adhd>
#include <utilities/tex_conv/texture_encoder.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void ReportStagedValidationFailure(in StagedFilePairPaths paths, in StagedFilePairResult result){
    LogTexConvStagedValidationFailure(cast<u8>(result.failureStage), FailedStagedFilePairPath(paths, result), ErrorCodeMessage(result.error));
}

[cpp_unwind]
b8 ValidateOutputPaths(in TexConvOutputPaths outputPaths, in b8 force){
    StagedFilePairPaths paths(outputPaths.data, outputPaths.metadata);
    const auto validation = ValidateStagedFilePairPaths(paths, force, false);
    if(!validation.succeeded()){
        ReportStagedValidationFailure(paths, validation);
        return false;
    }
    return true;
}

Expected<String> BuildMetadata(in PreparedTexture payload){
    const auto mipCount = ComputeCompleteMipCount(payload.dimension, payload.width, payload.height, payload.depth);
    if(!IsCompleteTexConvMipCount(mipCount.has_value(), mipCount.value_or(0u), payload.mipCount)
        || !IsValidTextureDescriptor(payload.format, payload.dimension, payload.width, payload.height, payload.depth, payload.alphaMode, payload.alphaConstantUnorm8))
        return MakeUnexpected(Failure());

    const StringView format = PayloadFormatText(payload.format);
    const StringView dimension = DimensionText(payload.dimension);
    const StringView alphaMode = AlphaModeText(payload.alphaMode);
    if(!IsValidTexConvDescriptorText(format, dimension, alphaMode))
        return MakeUnexpected(Failure());
    return BuildTexConvMetadataText(
        format, dimension, payload.width, payload.height, payload.depth,
        payload.dimension == TexturePayloadDimension::Texture3D, alphaMode,
        payload.alphaMode == TextureAlphaMode::ConstantUnorm8, payload.alphaConstantUnorm8
    );
}

void ReportTexConvPairEntry(in StagedFilePairResult result, in u32 index, in Path output, in Path temporary, in Path backup){
    if(result.succeeded()){
        if(result.backupCleanupErrors[index].value() != 0)
            [essential] warning("tex_conv: published output pair but could not remove previous backup '{}': {}", backup, ErrorCodeMessage(result.backupCleanupErrors[index]));
        return;
    }
    if(result.backedUp[index] && (result.removalErrors[index].value() != 0 || result.restorationErrors[index].value() != 0)){
        error(
            "tex_conv: failed to restore '{}'; previous output retained at '{}' (remove {}, restore {})",
            output, backup, result.removalErrors[index].value(), result.restorationErrors[index].value()
        );
    }
    if(!result.backedUp[index] && result.removalErrors[index].value() != 0)
        error("tex_conv: failed to remove newly published output '{}': {}", output, ErrorCodeMessage(result.removalErrors[index]));
    if(result.temporaryErrors[index].value() != 0)
        [essential] warning("tex_conv: failed to remove unpublished temporary '{}': {}", temporary, ErrorCodeMessage(result.temporaryErrors[index]));
}

[cpp_unwind]
b8 WriteOutputs(in TexConvOutputPaths outputPaths, in PreparedTexture payload, in b8 force){
    if(payload.bytes.empty()){
        error("tex_conv: cannot write an empty prepared texture.");
        return false;
    }
    const auto metadata = BuildMetadata(payload);
    if(!metadata.has_value()){
        error("tex_conv: cannot describe an invalid prepared texture.");
        return false;
    }
    StagedFilePairPaths paths(outputPaths.data, outputPaths.metadata);
    const auto published = StageAndPublishFilePair(paths, payload.bytes, metadata.value(), force, false, false, s_PublicationDiagnosticTag);
    if(!published.succeeded()){
        const auto message = ErrorCodeMessage(published.error);
        if(published.failureStage == StagedFilePairFailureStage::StagePrimary)
            error("tex_conv: failed to stage output data file '{}': {}", paths.primaryTemporary, message);
        else if(published.failureStage == StagedFilePairFailureStage::StageSecondary)
            error("tex_conv: failed to stage output metadata file '{}': {}", paths.secondaryTemporary, message);
        else if(published.failureStage == StagedFilePairFailureStage::PreserveExistingOutput)
            error("tex_conv: failed to preserve existing output '{}': {}", FailedStagedFilePairPath(paths, published), message);
        else if(published.failureStage == StagedFilePairFailureStage::FinalizeOutput)
            error("tex_conv: failed to finalize output '{}': {}", FailedStagedFilePairPath(paths, published), message);
        else
            ReportStagedValidationFailure(paths, published);
    }
    ReportTexConvPairEntry(published, 0u, paths.primary, paths.primaryTemporary, paths.primaryBackup);
    ReportTexConvPairEntry(published, 1u, paths.secondary, paths.secondaryTemporary, paths.secondaryBackup);
    return published.succeeded();
}


