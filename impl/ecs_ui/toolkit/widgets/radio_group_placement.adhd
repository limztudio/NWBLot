#include "radio_group_metrics.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


interface IRadioGroupReconcileGuard{
    b8 current()const;
}

class RadioGroupSelectionOutcome{
    public u64 selected = 0u;
    public u64 cursor = 0u;
}

class RadioGroupState : NoCopy{
    public u64 m_instanceGeneration = AllocateServiceIdentity();
    public u64 m_inputGeneration = AllocateServiceIdentity();
    public u64 m_revision = 1u;
    public u64 m_selected = 0u;
    public u64 m_cursor = 0u;
    public u64 m_sourceGeneration = 0u;
    public u64 m_sourceRevision = 0u;
    public RadioGroupPlacement m_placement;
    public b8 m_reconciling = false;
    public b8 m_reentryObserved = false;

    public u64 instanceGeneration()const{
        return this.m_instanceGeneration;
    }

    public u64 inputGeneration()const{
        return this.m_inputGeneration;
    }

    public u64 revision()const{
        return this.m_revision;
    }

    public u64 selectedKey()const{
        return this.m_selected;
    }

    public u64 cursorKey()const{
        return this.m_cursor;
    }

    public in RadioGroupPlacement placement()const{
        return this.m_placement;
    }

    public RadioGroupSnapshot snapshot()const{
        RadioGroupSnapshot value;
        value.instanceGeneration = this.m_instanceGeneration;
        value.inputGeneration = this.m_inputGeneration;
        value.revision = this.m_revision;
        value.selectedKey = this.m_selected;
        value.cursorKey = this.m_cursor;
        value.sourceGeneration = this.m_sourceGeneration;
        value.sourceRevision = this.m_sourceRevision;
        return value;
    }

    public b8 matches(in RadioGroupSnapshot value)const{
        return this.snapshot() == value;
    }

    public void select(in u64 key){
        AdvanceNonWrappingRevision(this.m_revision);
        this.m_inputGeneration = AllocateServiceIdentity();
        this.m_selected = key;
        this.m_cursor = key;
    }

    public void reset(){
        AdvanceNonWrappingRevision(this.m_revision);
        this.m_inputGeneration = AllocateServiceIdentity();
        ResetRadioGroupStateFields(this.m_selected, this.m_cursor, this.m_sourceGeneration, this.m_sourceRevision, this.m_placement);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<RadioGroupPlacement> PlaceRadioGroup(in Rect bounds, in Rect clip, in RadioGroupChoices choices, in RadioGroupMetrics metrics){
    if(!IsValidUiRect(bounds) || !IsValidUiRect(clip) || !IsValidRadioGroupMetrics(metrics) || choices.count != metrics.count || choices.rows.size() != cast<usize>(choices.count))
        return MakeUnexpected(Failure());
    RadioGroupPlacement candidate;
    candidate.bounds = bounds;
    candidate.count = choices.count;
    candidate.rows.resize(cast<usize>(candidate.count));
    const Expected<Rect> clipped = TryIntersectUiRects(bounds, clip, UiRectPrecision::PreciseExtents);
    if(!clipped.has_value())
        return MakeUnexpected(Failure());
    candidate.clip = clipped.value();
    const VectorDouble insetRect = ComputeInsetUiRectBounds(bounds, metrics.padding);
    const Expected<Rect> content = TryMakeUiRect(insetRect.x, insetRect.y, insetRect.z, insetRect.w, UiRectPrecision::PreciseExtents);
    if(!content.has_value())
        return MakeUnexpected(Failure());
    candidate.content = content.value();
    const f64 contentX = insetRect.x;
    const f64 contentY = insetRect.y;
    const f64 contentW = insetRect.z;
    const u32 cols = Max(cast<u32>(1u), metrics.columns);
    const u32 colGapCount = cols - 1u;
    const f64 totalColGap = cast<f64>(colGapCount) * cast<f64>(metrics.columnGap);
    const f64 cellW = Max(0.0, (contentW - totalColGap) / cast<f64>(cols));
    const f64 indicatorExtentScalar = Min(cast<f64>(metrics.indicatorExtent), cellW);
    const f64 labelOffset = Min(cellW, indicatorExtentScalar + cast<f64>(metrics.gap));
    const f64 markInsetScalar = indicatorExtentScalar * cast<f64>(metrics.markInset);
    const f64 rowHeightScalar = cast<f64>(metrics.rowHeight);
    HashSet<u64> seenKeys;
    if(candidate.count > 16u)
        seenKeys.reserve(cast<usize>(candidate.count));
    for(u32 index = 0u; index < candidate.count; ++index){
        const u64 key = choices.rows[index].key;
        if(candidate.count > 16u){
            if(key == 0u || seenKeys.find(key) != seenKeys.end())
                return MakeUnexpected(Failure());
            seenKeys.insert(key);
        }
        else if(!IsUniqueRadioGroupChoiceKey(choices, index, key))
            return MakeUnexpected(Failure());
        const u32 col = index % cols;
        const u32 rowIdx = index / cols;
        RadioGroupChoicePlacement row;
        row.key = key;
        row.enabled = choices.rows[index].enabled;
        const f64 cellX = contentX + cast<f64>(col) * (cellW + cast<f64>(metrics.columnGap));
        const f64 rowOffset = cast<f64>(rowIdx) * (rowHeightScalar + cast<f64>(metrics.rowGap));
        const f64 rowOriginScalar = contentY + rowOffset;
        const f64 indicatorSpace = rowHeightScalar - indicatorExtentScalar;
        const f64 indicatorYScalar = rowOriginScalar + (indicatorSpace * 0.5);
        const Expected<Rect> rowRect = TryMakeUiRect(cellX, rowOriginScalar, cellW, rowHeightScalar, UiRectPrecision::PreciseExtents);
        if(!rowRect.has_value())
            return MakeUnexpected(Failure());
        row.rectangle = rowRect.value();
        const Expected<Rect> rowClip = TryIntersectUiRects(row.rectangle, candidate.clip, UiRectPrecision::PreciseExtents);
        if(!rowClip.has_value())
            return MakeUnexpected(Failure());
        row.clip = rowClip.value();
        const Expected<Rect> indicator = TryMakeUiRect(cellX, indicatorYScalar, indicatorExtentScalar, indicatorExtentScalar, UiRectPrecision::PreciseExtents);
        if(!indicator.has_value())
            return MakeUnexpected(Failure());
        row.indicator = indicator.value();
        const VectorDouble markOrigin = VectorDouble(cellX, indicatorYScalar, cellX, indicatorYScalar) + VectorDouble(markInsetScalar);
        const f64 markX = markOrigin.x;
        const f64 markY = markOrigin.y;
        const f64 markExtent = indicatorExtentScalar - cast<f64>(s_CheckmarkInsetSides) * markInsetScalar;
        const Expected<Rect> mark = TryMakeUiRect(markX, markY, markExtent, markExtent, UiRectPrecision::PreciseExtents);
        if(!mark.has_value())
            return MakeUnexpected(Failure());
        row.mark = mark.value();
        const Expected<Rect> labelRect = TryMakeUiRect(cellX + labelOffset, rowOriginScalar, cellW - labelOffset, rowHeightScalar, UiRectPrecision::PreciseExtents);
        if(!labelRect.has_value())
            return MakeUnexpected(Failure());
        const Expected<Rect> textClip = TryIntersectUiRects(labelRect.value(), row.clip, UiRectPrecision::PreciseExtents);
        if(!textClip.has_value())
            return MakeUnexpected(Failure());
        row.textClip = textClip.value();
        candidate.rows[index] = row;
    }
    return candidate;
}

void ReconcileRadioGroupSelectionAndCursor(
    in RadioGroupSnapshot snapshot,
    in RadioGroupChoices candidate,
    mut u64 outSelected,
    mut u64 outCursor
){
    const b8 replacement = snapshot.sourceGeneration != 0u && snapshot.sourceGeneration != candidate.sourceGeneration;
    u64 selected = snapshot.selectedKey;
    u64 cursor = snapshot.cursorKey;
    if(replacement){
        selected = 0u;
        cursor = 0u;
    }
    if(!TryFindRadioGroupChoice(candidate, selected).has_value())
        selected = 0u;
    const Expected<u32> cursorIndex = TryFindRadioGroupChoice(candidate, cursor);
    if(!cursorIndex.has_value())
        cursor = FindEnabledRadioGroupChoice(candidate, 0u, false);
    else if(!candidate.rows[cursorIndex.value()].enabled){
        u32 nextStart = cursorIndex.value() + 1u;
        if(nextStart == candidate.count)
            nextStart = 0u;
        cursor = FindEnabledRadioGroupChoice(candidate, nextStart, false);
    }
    outSelected = selected;
    outCursor = cursor;
}

Expected<RadioGroupSelectionOutcome> TryApplyRadioGroupControlAction(
    in RadioGroupChoices choices,
    in RadioGroupOptions options,
    in ControlAction action,
    in ControlToken stateToken,
    in u64 currentSelected,
    in u64 currentCursor,
    mut RadioGroupResult inOutResult
){
    RadioGroupSelectionOutcome outcome = RadioGroupSelectionOutcome();
    outcome.selected = currentSelected;
    outcome.cursor = currentCursor;
    if(
        !IsValidRadioGroupOptions(options) || !IsValidRadioGroupChoices(choices)
        || !stateToken.valid() || stateToken != action.control
        || choices.sourceGeneration != stateToken.contentGeneration || choices.sourceRevision != stateToken.contentRevision
    )
        return MakeUnexpected(Failure());
    u64 candidate = 0u;
    b8 activate = false;
    switch(action.kind){
    case ControlActionKind::Up:
    case ControlActionKind::Down:
    case ControlActionKind::Left:
    case ControlActionKind::Right:
    case ControlActionKind::Home:
    case ControlActionKind::End:
        candidate = ResolveRadioGroupNavigationTarget(choices, currentCursor, action.kind, options.orientation, options.columns);
        break;
    case ControlActionKind::Submit:
    case ControlActionKind::Activate:{
        candidate = currentCursor;
        if(action.kind == ControlActionKind::Activate)
            candidate = action.value;
        const Expected<u32> index = TryFindRadioGroupChoice(choices, candidate);
        if(!index.has_value() || !choices.rows[index.value()].enabled){
            if(action.kind == ControlActionKind::Activate)
                return MakeUnexpected(Failure());
            candidate = 0u;
        }
        activate = candidate != 0u;
        break;
    }
    case ControlActionKind::Wheel:
    case ControlActionKind::PageUp:
    case ControlActionKind::PageDown:
        break;
    default:
        return MakeUnexpected(Failure());
    }
    RadioGroupResult candidateResult = inOutResult;
    candidateResult.valid = true;
    if(candidate != 0u){
        candidateResult.selectionChanged = candidateResult.selectionChanged || currentSelected != candidate;
        candidateResult.activated = candidateResult.activated || activate;
        outcome.selected = candidate;
        outcome.cursor = candidate;
    }
    inOutResult = candidateResult;
    return outcome;
}

void ResolveRadioGroupIndicatorNames(
    in RadioGroupStyle style,
    in b8 checked,
    in b8 enabled,
    in b8 pressed,
    in b8 hover,
    mut Name outPreferred,
    mut Name outFallback
){
    if(checked)
        outPreferred = style.checked;
    else if(!enabled)
        outPreferred = style.disabled;
    else if(pressed)
        outPreferred = style.pressed;
    else if(hover)
        outPreferred = style.hover;
    else
        outPreferred = style.normal;
    if(checked)
        outFallback = style.checkedFallback;
    else
        outFallback = style.normal;
}

void ResetRadioGroupStateFields(
    mut u64 outSelected,
    mut u64 outCursor,
    mut u64 outSourceGeneration,
    mut u64 outSourceRevision,
    mut RadioGroupPlacement outPlacement
){
    outSelected = 0u;
    outCursor = 0u;
    outSourceGeneration = 0u;
    outSourceRevision = 0u;
    outPlacement = RadioGroupPlacement();
}

void CommitRadioGroupReconcileState(
    in RadioGroupSnapshot snapshot,
    in RadioGroupChoices candidate,
    in u64 selected,
    in u64 cursor,
    mut u64 outSelected,
    mut u64 outCursor,
    mut u64 outSourceGeneration,
    mut u64 outSourceRevision,
    mut RadioGroupResult inOutResult
){
    RadioGroupResult candidateResult = inOutResult;
    candidateResult.valid = true;
    candidateResult.selectionChanged = candidateResult.selectionChanged || snapshot.selectedKey != selected;
    outSelected = selected;
    outCursor = cursor;
    outSourceGeneration = candidate.sourceGeneration;
    outSourceRevision = candidate.sourceRevision;
    inOutResult = candidateResult;
}

b8 ApplyRadioGroupControlAction(
    in RadioGroupChoices choices,
    in RadioGroupOptions options,
    in ControlAction action,
    mut RadioGroupState state,
    mut RadioGroupResult result
){
    if(state.m_reconciling){
        state.m_reentryObserved = true;
        return false;
    }
    ControlToken token;
    token.instanceGeneration = state.m_inputGeneration;
    token.contentGeneration = state.m_sourceGeneration;
    token.contentRevision = state.m_sourceRevision;
    const Expected<RadioGroupSelectionOutcome> outcome = TryApplyRadioGroupControlAction(choices, options, action, token, state.m_selected, state.m_cursor, result);
    if(!outcome.has_value())
        return false;
    AdvanceNonWrappingRevision(state.m_revision);
    state.m_selected = outcome.value().selected;
    state.m_cursor = outcome.value().cursor;
    return true;
}


