Expected<UniquePtr<IAsset>> DeserializeTestCodec(in AssetCodecFixtureBase codec, in Name name, in Span<u8> binary, mut TestArena storage){ return codec.deserialize(name, Span<u8>(binary), storage.arena); }

Expected<UniquePtr<IAsset>> LoadCookedAsset<Codec>(in GraphicsTestPath directory, in Name name, in usize expectedCount, mut TestArena storage){
    VolumeMountDesc desc(storage.arena);
    EXPECT_TRUE(desc.volumeName.assign("graphics"));
    desc.mountDirectory = directory;
    auto mounted = CreateVolumeFilesystem(storage.arena, desc);
    EXPECT_TRUE(mounted.has_value());
    if(!mounted.has_value())
        return MakeUnexpected(mounted.error());
    mut IFilesystem filesystem = mounted.value().deref();
    if(expectedCount != 0u)
        EXPECT_EQ(filesystem.fileCount(), expectedCount);
    Vector<u8> binary;
    const b8 loaded = filesystem.readFile(name, binary);
    EXPECT_TRUE(loaded);
    EXPECT_FALSE(binary.empty());
    if(!loaded || binary.empty())
        return MakeUnexpected(Failure());
    Codec codec = Codec();
    auto decoded = DeserializeTestCodec(codec, name, binary, storage);
    EXPECT_TRUE(decoded.has_value());
    return decoded;
}

Expected<T> LoadCookedValue<T, Codec>(in GraphicsTestPath directory, in Name name, in usize expectedCount, mut TestArena storage){
    auto loaded = LoadCookedAsset<Codec>(directory, name, expectedCount, storage);
    if(!loaded.has_value() || !loaded.value())
        return MakeUnexpected(Failure());
    return TakeTestAssetValue<T>(loaded.value().deref());
}

Expected<SamplerAsset> LoadCookedSamplerAsset(in GraphicsTestPath directory, in Name name, in usize count, mut TestArena storage){
    return LoadCookedValue<SamplerAsset, SamplerAssetCodec>(directory, name, count, storage);
}

void CheckCodecRejectsBinary(in AssetCodecFixtureBase codec, in Name path, in Span<u8> binary, mut TestArena storage){
    EXPECT_FALSE(codec.deserialize(path, Span<u8>(binary), storage.arena).has_value());
}

[ordered]
class BuildInputSelection{
    private HeapStorage storage;
    private CpuTaskScheduler scheduler(1u);
    public CapturingLogger m_logger;
    private LoggerRegistrationGuard loggerGuard(this.m_logger, LoggerBreakPolicy::BreakOnFatal);
    private Path root;
    private AssetCookWorkspace workspace(s_AssetCaseTestsAssetsBuildInputs);
    private CookFileCatalog catalog(this.workspace);
    public AssetBuildOptions m_options(this.scheduler);

    public void setup(){
        this.root = GraphicsRepoPath() / "__build_obj" / "build_input_tests";
        ASSERT_TRUE(GraphicsEnsureDirectories(this.root / s_AssetsDirectory / "empty").has_value());
        this.catalog.setRepoRoot(this.root);
        this.catalog.appendRoot(this.root / s_AssetsDirectory, s_ProjectVirtualRoot);
    }
    public void teardown(){ this.scheduler.wait(); }
    public ~BuildInputSelection(){ this.scheduler.drain(); }

    public void addFile(in StringView relativePath){
        const Path path = this.root / relativePath;
        ASSERT_TRUE(GraphicsEnsureDirectories(path.parentPath()).has_value());
        ASSERT_TRUE(GraphicsWriteBinaryFile(path, Span<u8>()));
        String normalized = PathToString(path.lexicallyNormal());
        CanonicalizeTextInPlace(normalized);
        AppendTestCatalogFile(this.catalog, this.root / s_AssetsDirectory, path, normalized, s_ProjectVirtualRoot);
    }
    public void addInput(in StringView path){ this.m_options.inputs.emplace_back(path); }
    public void clearInputs(){ this.m_options.inputs.clear(); }
    public usize fileCount()const{ return this.catalog.files.size(); }
    public String filenameTextAt(in usize index)const{ return PathToString(this.catalog.files[index].filePath.filenameView()); }

    public GraphicsOwnedPath ownedRoot(){ return OwnGraphicsPath(this.storage, this.root); }
    public CookStringVector makeCookSources(){ return this.storage.makeValue<CookStringVector>(); }
    public void appendCookSource(in StringView source, mut CookStringVector sources){ sources.emplace_back(source, this.storage); }
    public void appendCookPathSource(in GraphicsTestPath path, mut CookStringVector sources){ this.appendCookSource(PathToString(path), sources); }
    public b8 select(){ return SelectBuildInputs(this.m_options, this.catalog); }
}

[ordered]
class ScratchPattern{
    private mut GraphicsScratchArena owner;
    private usize count;
    private u8 seed;
    private RawAllocation bytes;

    public ScratchPattern(mut GraphicsScratchArena owner, in usize count, in u8 seed){
        this.owner = owner;
        this.count = count;
        this.seed = seed;
        this.bytes = AllocateBytes(owner.arena, 1u, count);
        if(this.valid()){
            for(usize i = 0u; i < count; ++i)
                this.bytes[i] = cast<u8>(i + seed);
        }
    }
    public ~ScratchPattern(){ this.release(); }
    public b8 valid()const{ return this.bytes.address() != 0u; }
    public b8 intact()const{
        if(!this.valid())
            return false;
        for(usize i = 0u; i < this.count; ++i){
            if(this.bytes[i] != cast<u8>(i + this.seed))
                return false;
        }
        return true;
    }
    public void release(){
        if(this.valid()){
            FreeBytes(this.owner.arena, this.bytes, 1u, this.count);
            this.bytes = RawAllocation();
        }
    }
}

[ordered]
class PathFixture{
    public HeapStorage storage(s_AssetCaseTestsAssetPathInputs);
    public GraphicsTestPath assetRoot(this.storage, "tests/asset_path/assets");
    public String relativeText;
    public String expectedRelative;
    public GraphicsTestPath relativePath(this.storage);
    public GraphicsTestPath sourcePath(this.storage);
    public String expectedDerived;
}

void PrepareAssetPathWorkload(in usize count, in StringView directory, in usize repeats, mut PathFixture fixture){
    fixture.relativeText.reserve(count * (directory.size() * repeats + 1u) + 32u);
    for(usize i = 0u; i < count; ++i){
        for(usize token = 0u; token < repeats; ++token)
            fixture.relativeText.append(directory);
        fixture.relativeText.append("/");
    }
    fixture.relativeText.append("Model.LOD0.NWB");
    fixture.relativePath = GraphicsTestPath(fixture.storage, StringView(fixture.relativeText));
    fixture.sourcePath = fixture.assetRoot / fixture.relativePath;
    fixture.expectedRelative = fixture.relativeText;
    CanonicalizeTextInPlace(fixture.expectedRelative);
    fixture.expectedDerived.reserve(8u + fixture.expectedRelative.size());
    fixture.expectedDerived = "project/";
    fixture.expectedDerived.append(StringView(fixture.expectedRelative).substr(0u, fixture.expectedRelative.size() - 4u));
}

b8 GatherBuiltDirectoryToOutput(mut TestArena storage, in GraphicsTestPath built, in GraphicsTestPath output){
    AssetGatherOptions options;
    options.inputs.emplace_back(PathToString(built));
    options.outputDirectory = PathToString(output);
    options.configuration = CompactString(s_TestsConfiguration);
    return GatherAssets(options);
}

b8 BuildAndGatherWithExplicitRepoRoot(mut TestArena storage, in GraphicsTestPath root, in GraphicsTestPath assetRoot, in GraphicsTestPath built, in GraphicsTestPath output){
    CpuTaskScheduler scheduler(0u);
    AssetBuildOptions options(scheduler);
    options.repoRoot = root;
    options.outputDirectory = built;
    if(!options.configuration.assign(s_TestsConfiguration) || !options.assetType.assign("graphics"))
        return false;
    options.assetRoots.emplace_back(assetRoot, s_ProjectVirtualRoot);
    return BuildAssets(options) && GatherBuiltDirectoryToOutput(storage, built, output);
}

