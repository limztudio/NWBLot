    public PhysicsGpuDispatcher(){
        this.m_graphics = Optional<mut GraphicsRuntime>();
        this.m_assetManager = Optional<mut AssetManager>();
        this.m_shaderPathResolver = ShaderArchivePathResolver();
        this.m_activeSceneSubsystems = ActiveSceneSubsystemsRef();
    }

    public PhysicsGpuDispatcher(
        mut GraphicsRuntime graphics,
        mut AssetManager assetManager,
        in ShaderArchivePathResolver shaderPathResolver
    ){
        this.m_graphics = Optional<mut GraphicsRuntime>(graphics);
        this.m_assetManager = Optional<mut AssetManager>(assetManager);
        this.m_shaderPathResolver = shaderPathResolver;
        this.m_activeSceneSubsystems = ActiveSceneSubsystemsRef();
    }

    public ~PhysicsGpuDispatcher(){
        this.invalidateResources();
    }

    public void attachRuntime(
        mut GraphicsRuntime graphics,
        mut AssetManager assetManager,
        in ShaderArchivePathResolver shaderPathResolver
    ){
        this.invalidateResources();
        this.m_graphics = Optional<mut GraphicsRuntime>(graphics);
        this.m_assetManager = Optional<mut AssetManager>(assetManager);
        this.m_shaderPathResolver = shaderPathResolver;
    }

    public void setActiveSceneSubsystems(in ActiveSceneSubsystemsRef subsystems){
        this.m_activeSceneSubsystems = subsystems;
    }

    public b8 isReady()const{
        return this.m_graphics.has_value() && this.m_assetManager.has_value() && this.m_pipelinesReady;
    }

    private Name resolveShaderAssetName(in u32 shaderIndex)const{
        if(!this.m_activeSceneSubsystems.has_value())
            return s_NameNone;
        const auto sub = this.m_activeSceneSubsystems.value().findSubsystem<PhysicsSubsystem>();
        if(!sub.has_value())
            return s_NameNone;
        in PhysicsSubsystem phys = sub.value();
        if(shaderIndex == 0u)
            return phys.broadphaseAabbCs.name();
        if(shaderIndex == 1u)
            return phys.narrowphaseCs.name();
        if(shaderIndex == 2u)
            return phys.solverIntegrateVelocitiesCs.name();
        if(shaderIndex == 3u)
            return phys.solverContactsCs.name();
        if(shaderIndex == 4u)
            return phys.solverIntegratePositionsCs.name();
        if(shaderIndex == 5u)
            return phys.solverFinalizeBodiesCs.name();
        if(shaderIndex == 6u)
            return phys.solverJointsCs.name();
        if(shaderIndex == 7u)
            return phys.solverIslandsCs.name();
        if(shaderIndex == 8u)
            return phys.solverJointIslandsCs.name();
        if(shaderIndex == 9u)
            return phys.lbvhBroadphaseCs.name();
        if(shaderIndex == 10u)
            return phys.gpuResidentStepCs.name();
        if(shaderIndex == 11u)
            return phys.spatialQueryCs.name();
        return phys.exportRenderTransformsCs.name();
    }

