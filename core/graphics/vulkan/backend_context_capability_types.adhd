class RequiredQueueFamilySelection{
    public i32 graphicsFamily = s_RequiredFamilyInvalidIndex;
    public i32 computeFamily = s_RequiredFamilyInvalidIndex;
    public i32 asyncComputeFamily = s_RequiredFamilyInvalidIndex;
    public i32 dedicatedTransferFamily = s_RequiredFamilyInvalidIndex;
}


class PhysicalDeviceFeatureQueryOptions{
    public b8 apiSupportsVulkan13 = false;
    public b8 descriptorBufferExtensionAvailable = false;
    public b8 dynamicRenderingExtensionAvailable = false;
    public b8 synchronization2ExtensionAvailable = false;
    public b8 maintenance4ExtensionAvailable = false;
}



class DescriptorBufferStartupPrerequisites{
    public b8 descriptorBufferExtensionEnabled = false;
    public b8 bufferDeviceAddressFeatureEnabled = false;
    public b8 getBufferDeviceAddressAvailable = false;
    public b8 getDescriptorAvailable = false;
    public b8 getDescriptorSetLayoutSizeAvailable = false;
    public b8 getDescriptorSetLayoutBindingOffsetAvailable = false;
    public b8 cmdBindDescriptorBuffersAvailable = false;
    public b8 cmdSetDescriptorBufferOffsetsAvailable = false;
}


