type UiEditNavigationGuardTests = UiEditNavigationHostTests;
type UiEditNavigationLifetimeTests = UiEditNavigationHostTests;
type UiEditPointerCaptureTests = UiEditNavigationHostTests;
type UiEditPointerSourceTests = UiEditBoxHostTests;
type UiEditWordSelectionTests = UiEditBoxHostTests;
type UiMultilineClipboardTests = UiEditBoxHostTests;
type UiMultilineNativeTests = UiEditBoxHostTests;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> CallbackMutation{
    IdenticalSelection,
    SelectionRoundTrip,
    CompositionRoundTrip,
    IdenticalText,
    IdenticalColumn,
    ColumnRoundTrip,
    ResetHost,
    ReenterHost,
    FailContext
}

ControlToken MakeEcsUiControlToken(in u64 instanceGeneration, in u64 contentGeneration, in u64 contentRevision){
    ControlToken token = ControlToken();
    token.instanceGeneration = instanceGeneration;
    token.contentGeneration = contentGeneration;
    token.contentRevision = contentRevision;
    return token;
}

b8 SeedPreferredNavigationColumn(mut UiEditNavigationLifetimeTests self, in EditBoxOptions options){
    if(!self.m_navigationModel.setText("abcdef\nx\nabcdef") || !self.m_navigationModel.setSelection(5u, 5u) || !self.activateNavigation(options) || !self.core.key(Key::Down) || !self.navigationFrame(options)){
        return false;
    }
    self.m_resolver.records.clear();
    self.m_actions.records.clear();
    return self.m_navigationModel.caret() == 8u && self.m_navigation.hasPreferredX() && self.m_navigation.preferredX() == 50.0f;
}

b8 SeedPreferredNavigationColumn(mut UiEditNavigationLifetimeTests self){
    return SeedPreferredNavigationColumn(self, EditBoxOptions());
}

b8 WordSelectDown(mut UiEditWordSelectionTests self, in usize byte, in u64 timestampMs, in b8 shift){
    InputEvent event = InputEvent();
    event.timestampMs = timestampMs;
    event.position = self.atByte(byte);
    event.type = InputEventType::PrimaryDown;
    event.shift = shift;
    return self.dispatch(event);
}

b8 WordSelectDown(mut UiEditWordSelectionTests self, in usize byte, in u64 timestampMs){
    return WordSelectDown(self, byte, timestampMs, false);
}

b8 WordSelectMove(mut UiEditWordSelectionTests self, in usize byte){
    InputEvent event = InputEvent();
    event.position = self.atByte(byte);
    event.type = InputEventType::PointerMove;
    return self.dispatch(event);
}

b8 WordSelectUp(mut UiEditWordSelectionTests self, in usize byte){
    InputEvent event = InputEvent();
    event.position = self.atByte(byte);
    event.type = InputEventType::PrimaryUp;
    return self.dispatch(event);
}

b8 WordSelectClick(mut UiEditWordSelectionTests self, in usize byte, in u64 timestampMs, in b8 shift){
    return WordSelectDown(self, byte, timestampMs, shift) && WordSelectUp(self, byte);
}

b8 WordSelectClick(mut UiEditWordSelectionTests self, in usize byte, in u64 timestampMs){
    return WordSelectClick(self, byte, timestampMs, false);
}

b8 WordSelectClickAt(mut UiEditWordSelectionTests self, in Point point, in u64 timestampMs){
    InputEvent down = InputEvent();
    down.timestampMs = timestampMs;
    down.position = point;
    down.type = InputEventType::PrimaryDown;
    InputEvent up = InputEvent();
    up.position = point;
    up.type = InputEventType::PrimaryUp;
    return self.dispatch(down) && self.dispatch(up);
}


void RejectEcsUiNavigationTarget(mut UiEditNavigationGuardTests self, in Expected<EditNavigationResult> target){
    ASSERT_TRUE(self.m_navigationModel.setText("e\xcc\x81\nxy"));
    ASSERT_TRUE(self.m_navigationModel.setSelection(0u, 0u));
    ASSERT_TRUE(self.activateNavigation());
    ASSERT_TRUE(self.m_navigation.setPreferredX(70.0f));
    const MultilineSnapshot model = MultilineSnapshot(self.m_navigationModel);
    const EditNavigationSnapshot navigation = self.m_navigation.snapshot();
    const u64 displayed = self.core.m_context.input().layoutGeneration();
    const usize targets = self.core.m_context.input().targets().size();
    self.m_resolver.forceResult = true;
    self.m_resolver.forcedResult = target;
    ASSERT_TRUE(self.core.key(Key::Down));
    ASSERT_TRUE(self.commitNative("!"));
    ASSERT_FALSE(self.prepareNavigation());
    EXPECT_FALSE(self.core.m_result.valid);
    ASSERT_EQ(self.m_resolver.records.size(), 1u);
    model.expectUnchanged(self.m_navigationModel);
    EXPECT_TRUE(self.m_navigation.matches(navigation));
    EXPECT_EQ(self.core.m_context.input().layoutGeneration(), displayed);
    EXPECT_EQ(self.core.m_context.input().targets().size(), targets);
}

void ApplyEcsUiNavigationCallbackMutation(mut UiEditNavigationGuardTests self, in CallbackMutation mutation, mut EditModelSnapshot callbackModel, mut EditNavigationSnapshot callbackNavigation, mut usize callbacks, mut b8 mutationAccepted, mut b8 innerRejected){
    ++callbacks;
    if(mutation == CallbackMutation::IdenticalSelection){
        mutationAccepted = self.m_navigationModel.setSelection(1u, 1u);
    }
    else if(mutation == CallbackMutation::SelectionRoundTrip){
        mutationAccepted = self.m_navigationModel.setSelection(0u, 0u) && self.m_navigationModel.setSelection(1u, 1u);
    }
    else if(mutation == CallbackMutation::CompositionRoundTrip){
        mutationAccepted = self.m_navigationModel.beginComposition() && self.m_navigationModel.updateComposition("IME", 0u, 3u);
        self.m_navigationModel.cancelComposition();
    }
    else if(mutation == CallbackMutation::IdenticalText){
        mutationAccepted = self.m_navigationModel.setText("ab\ncdef") && self.m_navigationModel.setSelection(1u, 1u);
    }
    else if(mutation == CallbackMutation::IdenticalColumn){
        mutationAccepted = self.m_navigation.setPreferredX(50.0f);
    }
    else if(mutation == CallbackMutation::ColumnRoundTrip){
        self.m_navigation.reset();
        mutationAccepted = self.m_navigation.setPreferredX(50.0f);
    }
    else if(mutation == CallbackMutation::ResetHost){
        self.core.m_host.reset();
        mutationAccepted = true;
    }
    else if(mutation == CallbackMutation::ReenterHost){
        innerRejected = !self.core.m_host.editNavigated(self.core.m_widget, EditBoxOptions(), PopupToken(), self.m_navigationModel, self.m_navigation, self.m_resolver, self.m_actions).valid;
        mutationAccepted = true;
    }
    else if(mutation == CallbackMutation::FailContext){
        self.core.m_context.fail();
        mutationAccepted = true;
    }
    callbackModel.capture(self.m_navigationModel);
    callbackNavigation = self.m_navigation.snapshot();
}

void RejectEcsUiNavigationMutation(mut UiEditNavigationGuardTests self, in CallbackMutation mutation){
    ASSERT_TRUE(self.m_navigationModel.setText("ab\ncdef"));
    ASSERT_TRUE(self.m_navigationModel.setSelection(1u, 1u));
    ASSERT_TRUE(self.activateNavigation());
    ASSERT_TRUE(self.m_navigation.setPreferredX(50.0f));
    const u64 displayed = self.core.m_context.input().layoutGeneration();
    const usize targets = self.core.m_context.input().targets().size();
    EditModelSnapshot callbackModel = EditModelSnapshot();
    EditNavigationSnapshot callbackNavigation = EditNavigationSnapshot();
    usize callbacks = 0u;
    b8 mutationAccepted = false;
    b8 innerRejected = false;
    self.m_resolver.hook = lambda[mut self, in mutation, mut callbackModel, mut callbackNavigation, mut callbacks, mut mutationAccepted, mut innerRejected]() -> void{
        ApplyEcsUiNavigationCallbackMutation(self, mutation, callbackModel, callbackNavigation, callbacks, mutationAccepted, innerRejected);
    };
    ASSERT_TRUE(self.core.key(Key::Down));
    ASSERT_TRUE(self.commitNative("!"));
    ASSERT_FALSE(self.prepareNavigation());
    EXPECT_FALSE(self.core.m_result.valid);
    EXPECT_EQ(callbacks, 1u);
    EXPECT_TRUE(mutationAccepted);
    if(mutation == CallbackMutation::ReenterHost){
        EXPECT_TRUE(innerRejected);
    }
    ASSERT_EQ(self.m_resolver.records.size(), 1u);
    EXPECT_TRUE(callbackModel.matches(self.m_navigationModel));
    EXPECT_TRUE(self.m_navigation.matches(callbackNavigation));
    EXPECT_EQ(self.m_navigationModel.text(), "ab\ncdef");
    EXPECT_EQ(self.m_navigationModel.anchor(), 1u);
    EXPECT_EQ(self.m_navigationModel.caret(), 1u);
    EXPECT_FALSE(self.m_navigationModel.canUndo());
    EXPECT_EQ(self.core.m_context.input().layoutGeneration(), displayed);
    EXPECT_EQ(self.core.m_context.input().targets().size(), targets);
}

b8 PublishEcsUiPointerCapturePart(mut UiEditPointerCaptureTests self, in b8 gesture){
    Array<HitTarget, 2> targets = Array<HitTarget, 2>();
    const Expected<HitTarget> foundTarget = self.core.m_context.input().tryFindTarget(self.core.m_widget.id);
    if(!foundTarget.has_value()){
        return false;
    }
    targets[0u] = foundTarget.value();
    targets[0u].control = MakeEcsUiControlToken(91u, 1u, 1u);
    targets[1u].id = self.core.m_otherWidget.id;
    targets[1u].declarationGeneration = self.core.m_otherWidget.declarationGeneration;
    targets[1u].rectangle = MakeEcsUiRect(180.0f, 20.0f, 10.0f, 48.0f);
    targets[1u].clip = targets[0u].clip;
    targets[1u].paintOrder = 1u;
    targets[1u].owner = targets[0u].id;
    targets[1u].ownerDeclarationGeneration = targets[0u].declarationGeneration;
    targets[1u].control = targets[0u].control;
    targets[1u].pointerGesture = gesture;
    targets[1u].activatable = !gesture;
    if(gesture){
        targets[1u].gestureReference = targets[1u].rectangle;
    }
    // The copied router publication leaves the already accepted text geometry owned by the host.
    ++self.core.m_generation;
    if(!self.core.m_context.input().commitTargets(targets, self.core.m_generation)){
        return false;
    }
    self.core.m_host.synchronizeFocus();
    return true;
}


EditNavigationResult MakeNavigationResult(in usize committedByte, in f32 preferredX){
    EditNavigationResult result = EditNavigationResult();
    result.committedByte = committedByte;
    result.preferredX = preferredX;
    return result;
}

void VerifyUiEditNavigationHostTests_CandidateGeometryCannotReplacePublishedYHitsBeforeAcceptance(mut UiEditNavigationHostTests self){
    ASSERT_TRUE(self.m_navigationModel.setText("ab\ncd\nxy"));
    ASSERT_TRUE(self.m_navigationModel.setSelection(0u, 0u));
    ASSERT_TRUE(self.activateNavigation());
    const u64 displayed = self.core.m_context.input().layoutGeneration();
    const TextInputRect nativeRect = self.core.m_textInput.currentCaret();
    const Rect shiftedBounds = MakeEcsUiRect(10.0f, 80.0f, 180.0f, 48.0f);
    ASSERT_TRUE(self.prepareNavigation(EditBoxOptions(), shiftedBounds));
    EXPECT_EQ(self.core.m_context.input().layoutGeneration(), displayed);
    self.core.m_host.commitFrame(self.core.m_generation);
    EXPECT_EQ(self.core.m_textInput.currentCaret().y, nativeRect.y);
    ASSERT_TRUE(self.click(MakeEcsUiPoint(20.0f, 38.0f)));
    ASSERT_TRUE(self.core.commit());
    ASSERT_TRUE(self.navigationFrame(EditBoxOptions(), shiftedBounds));
    EXPECT_EQ(self.m_navigationModel.caret(), 4u);
    EXPECT_EQ(self.m_navigationModel.anchor(), 4u);
    EXPECT_FLOAT_EQ(self.core.m_placement.caret.y, 92.0f);
    EXPECT_EQ(self.core.m_textInput.currentCaret().y, 92);
    EXPECT_TRUE(self.m_resolver.records.empty());
}

void VerifyUiEditNavigationHostTests_EmptyAndTrailingHardLinesPublishDistinctEndpoints(mut UiEditNavigationHostTests self){
    ASSERT_TRUE(self.m_navigationModel.setText("a\n\n"));
    ASSERT_TRUE(self.m_navigationModel.setSelection(0u, 0u));
    ASSERT_TRUE(self.activateNavigation());
    ASSERT_TRUE(self.click(MakeEcsUiPoint(20.0f, 38.0f)));
    ASSERT_TRUE(self.navigationFrame());
    EXPECT_EQ(self.m_navigationModel.caret(), 2u);
    ASSERT_TRUE(self.click(MakeEcsUiPoint(20.0f, 50.0f)));
    ASSERT_TRUE(self.navigationFrame());
    EXPECT_EQ(self.m_navigationModel.caret(), 3u);
    EXPECT_EQ(self.m_navigationModel.anchor(), 3u);
    EXPECT_EQ(self.m_navigationModel.text(), "a\n\n");
    EXPECT_FALSE(self.m_navigationModel.canUndo());
}

void VerifyUiEditNavigationHostTests_EarlierCommittedTextRetiresQueuedPublishedPointerPositions(mut UiEditNavigationHostTests self){
    ASSERT_TRUE(self.m_navigationModel.setText("ab\ncd\nxy"));
    ASSERT_TRUE(self.m_navigationModel.setSelection(0u, 0u));
    ASSERT_TRUE(self.activateNavigation());
    ASSERT_TRUE(self.commitNative("Q"));
    ASSERT_TRUE(self.click(MakeEcsUiPoint(20.0f, 38.0f)));
    ASSERT_TRUE(self.navigationFrame());
    EXPECT_EQ(self.m_navigationModel.text(), "Qab\ncd\nxy");
    EXPECT_EQ(self.m_navigationModel.anchor(), 1u);
    EXPECT_EQ(self.m_navigationModel.caret(), 1u);
    EXPECT_TRUE(self.m_resolver.records.empty());
    ASSERT_TRUE(self.m_navigationModel.undo());
    EXPECT_EQ(self.m_navigationModel.text(), "ab\ncd\nxy");
    EXPECT_FALSE(self.m_navigationModel.canUndo());
}

