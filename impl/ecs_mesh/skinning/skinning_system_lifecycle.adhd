////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_mesh/runtime/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 AreMeshSkinningRuntimePipelinesReady(
    in b8 skinningReady,
    in b8 boundsReady,
    in b8 hasAttributeBuffer,
    in b8 repackReady
){
    if(!skinningReady || !boundsReady)
        return false;
    if(hasAttributeBuffer && !repackReady)
        return false;
    return true;
}

b8 CanRetainPreparedRuntimeResources(in b8 hasValidInstance, in u32 instanceEditRevision, in u32 resourceEditRevision){
    return hasValidInstance && instanceEditRevision == resourceEditRevision;
}

void MarkRebuiltRuntimeMeshDirtyFlags(mut RuntimeMeshDirtyFlag inOutDirtyFlags){
    inOutDirtyFlags |= RuntimeMeshDirtyFlag::SkinningInputDirty | RuntimeMeshDirtyFlag::MeshletBoundsDirty;
}

void LogSkinningDescriptorHeapRequired(in StringView requirementLabel){
    error("MeshSkinningSystem: {} compute requires the initialized global descriptor heap", requirementLabel);
}

void LogSkinningBindingLayoutCreateFailed(in StringView layoutLabel){
    error("MeshSkinningSystem: failed to create {} binding layout", layoutLabel);
}

void LogSkinningComputePipelineCreateFailed(in StringView pipelineLabel){
    error("MeshSkinningSystem: failed to create {} compute pipeline", pipelineLabel);
}

b8 EnsurePushConstantBindingLayout(
    in u32 pushConstantBytes,
    in StringView layoutLabel,
    mut Device device,
    mut BindingLayoutHandle inOutBindingLayout
){
    if(inOutBindingLayout.valid())
        return true;

    BindingLayoutDesc bindingLayoutDesc = BindingLayoutDesc();
    bindingLayoutDesc.setVisibility(ShaderTypeMask::Compute);
    bindingLayoutDesc.addItem(BindingLayoutItemPushConstants(0, pushConstantBytes));

    const Expected<BindingLayoutHandle> bindingLayoutResult = device.createBindingLayout(bindingLayoutDesc);
    if(bindingLayoutResult.has_value()){
        inOutBindingLayout = bindingLayoutResult.value();
        return true;
    }

    inOutBindingLayout.reset();
    LogSkinningBindingLayoutCreateFailed(layoutLabel);
    return false;
}

b8 EnsureLoadedComputePipeline(
    in ShaderHandle shader,
    in BindingLayoutHandle bindingLayout,
    in StringView pipelineLabel,
    mut GraphicsRuntime graphics,
    mut ComputePipelineHandle inOutPipeline
){
    if(inOutPipeline.valid())
        return true;

    mut Device device = graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    ComputePipelineDesc pipelineDesc = ComputePipelineDesc();
    pipelineDesc.setComputeShader(shader).addBindingLayout(bindingLayout).addBindingLayout(heap.getResourceLayout()).addBindingLayout(heap.getSamplerLayout());
    const Expected<ComputePipelineHandle> computePipelineResult = device.createComputePipeline(pipelineDesc);
    if(computePipelineResult.has_value()){
        inOutPipeline = computePipelineResult.value();
        return true;
    }

    inOutPipeline.reset();
    LogSkinningComputePipelineCreateFailed(pipelineLabel);
    return false;
}


