CrashTestPath MakeTelemetryPublicationTestDirectory(mut LoggerTestArena testArena){
    CrashTestPath root = CrashTestPath(testArena.arena);
    native(mut testArena, mut root){
        const auto executableDirectory = ExecutablePaths(testArena.arena).directory();
        if(executableDirectory){
            for(u32 attempt = 0u; attempt < 128u; ++attempt){
                const auto name = StringFormat(testArena.arena, "telemetry_publication_test_{}_{}", CurrentProcessId(), attempt);
                const CrashTestPath candidate = *executableDirectory / name;
                const auto created = CreateDirectories(candidate);
                if(!created)
                    break;
                if(*created){
                    root = candidate;
                    break;
                }
            }
        }
    }
    return root;
}


