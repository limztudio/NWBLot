b8 IsDescriptorClass(in GpuDescriptorHandle handle, in GpuDescriptorClass descriptorClass){
    return handle.valid() && handle.descriptorClass() == descriptorClass;
}

void RetireDescriptor(mut GpuDescriptorHeap heap, mut GpuDescriptorHandle inOutHandle){
    if(inOutHandle.valid() && heap.isInitialized())
        heap.free(inOutHandle);
    inOutHandle = GpuDescriptorHandleInvalid();
}

Expected<GpuDescriptorHandle> RegisterDescriptor(mut GpuDescriptorHeap heap, in GpuDescriptorClass descriptorClass, in DescriptorWriteItem item){
    const Expected<GpuDescriptorHandle> allocated = heap.allocate(descriptorClass);
    if(!allocated.has_value())
        return MakeUnexpected(allocated.error());
    const GpuDescriptorHandle handle = allocated.value();
    GpuDescriptorRetirementGuard retireUnpublished(heap, handle);

    if(heap.write(handle, item)){
        retireUnpublished.release();
        return handle;
    }
    return MakeUnexpected(Failure());
}

b8 ReplaceDescriptor(mut GpuDescriptorHeap heap, in GpuDescriptorClass descriptorClass, in DescriptorWriteItem item, mut GpuDescriptorHandle inOutHandle){
    const Expected<GpuDescriptorHandle> descriptor = RegisterDescriptor(heap, descriptorClass, item);
    if(!descriptor.has_value())
        return false;
    GpuDescriptorRetirementGuard retireUnpublished(heap, descriptor.value());
    if(inOutHandle.valid())
        heap.free(inOutHandle);
    inOutHandle = descriptor.value();
    retireUnpublished.release();
    return true;
}

Expected<GpuDescriptorHandle> RegisterSampledTexture(
    mut GpuDescriptorHeap heap,
    in GpuDescriptorClass descriptorClass,
    in TextureHandle texture,
    in Format format,
    in TextureSubresourceSet subresources,
    in TextureDimension dimension
){
    if(!texture.valid())
        return MakeUnexpected(Failure());
    TextureHandle localTexture = texture;
    return RegisterDescriptor(heap, descriptorClass, DescriptorWriteItemTextureSrv(0u, localTexture.deref(), format, subresources, dimension));
}

Expected<GpuDescriptorHandle> RegisterSampledTexture(mut GpuDescriptorHeap heap, in GpuDescriptorClass descriptorClass, in TextureHandle texture){
    return RegisterSampledTexture(heap, descriptorClass, texture, Format::UNKNOWN, s_AllSubresources, TextureDimension::Unknown);
}



Expected<GpuDescriptorHandle> RegisterStorageTexture(
    mut GpuDescriptorHeap heap,
    in TextureHandle texture,
    in Format format,
    in TextureDimension dimension
){
    if(!texture.valid())
        return MakeUnexpected(Failure());
    TextureHandle localTexture = texture;
    return RegisterDescriptor(heap, GpuDescriptorClass::StorageImage, DescriptorWriteItemTextureUav(0u, localTexture.deref(), format, s_AllSubresources, dimension));
}

Expected<GpuDescriptorHandle> RegisterStorageTexture(mut GpuDescriptorHeap heap, in TextureHandle texture){
    return RegisterStorageTexture(heap, texture, Format::UNKNOWN, TextureDimension::Unknown);
}



Expected<GpuDescriptorHandle> RegisterSampler(mut GpuDescriptorHeap heap, mut RhiSampler sampler){
    return RegisterDescriptor(heap, GpuDescriptorClass::Sampler, DescriptorWriteItemSampler(0u, sampler));
}



Expected<GpuDescriptorHandle> RegisterStructuredBuffer(mut GpuDescriptorHeap heap, mut Buffer buffer){
    return RegisterDescriptor(heap, GpuDescriptorClass::StorageBuffer, DescriptorWriteItemStructuredBufferSrv(0u, buffer));
}

Expected<GpuDescriptorHandle> RegisterConstantBuffer(mut GpuDescriptorHeap heap, mut Buffer buffer){
    return RegisterDescriptor(heap, GpuDescriptorClass::UniformBuffer, DescriptorWriteItemConstantBuffer(0u, buffer));
}

Expected<GpuDescriptorHandle> RegisterConstantBuffer(mut GpuDescriptorHeap heap, in BufferHandle buffer){
    if(!buffer.valid())
        return MakeUnexpected(Failure());
    BufferHandle localBuffer = buffer;
    return RegisterDescriptor(heap, GpuDescriptorClass::UniformBuffer, DescriptorWriteItemConstantBuffer(0u, localBuffer.deref()));
}

DescriptorWriteItem MakeHeapBufferDescriptorWriteItem(mut Buffer buffer, in GpuDescriptorClass descriptorClass, in b8 writable){
    if(descriptorClass == GpuDescriptorClass::UniformBuffer)
        return DescriptorWriteItemConstantBuffer(0u, buffer);
    if(writable)
        return DescriptorWriteItemStructuredBufferUav(0u, buffer);
    return DescriptorWriteItemStructuredBufferSrv(0u, buffer);
}

Expected<GpuDescriptorHandle> RegisterHeapBuffer(mut GpuDescriptorHeap heap, mut Buffer buffer, in GpuDescriptorClass descriptorClass, in b8 writable){
    return RegisterDescriptor(heap, descriptorClass, MakeHeapBufferDescriptorWriteItem(buffer, descriptorClass, writable));
}

b8 EnsureHeapBuffer(in GpuDescriptorClass descriptorClass, in b8 writable, mut GpuDescriptorHeap heap, mut Buffer buffer, mut GpuDescriptorHandle inOutHandle){
    if(inOutHandle.valid())
        return IsDescriptorClass(inOutHandle, descriptorClass);
    const Expected<GpuDescriptorHandle> descriptor = RegisterHeapBuffer(heap, buffer, descriptorClass, writable);
    if(!descriptor.has_value())
        return false;
    inOutHandle = descriptor.value();
    return true;
}

b8 ReplaceHeapBuffer(in GpuDescriptorClass descriptorClass, in b8 writable, mut GpuDescriptorHeap heap, mut Buffer buffer, mut GpuDescriptorHandle inOutHandle){
    return ReplaceDescriptor(heap, descriptorClass, MakeHeapBufferDescriptorWriteItem(buffer, descriptorClass, writable), inOutHandle);
}


