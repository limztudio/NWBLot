[cpp_header("<core/task/gpu/instance_transform_patch_contributor.h>"), cpp_name("::NWB::Core::GpuTaskGraphInstanceTransformPatchLayout")]
extern enum GpuTaskGraphInstanceTransformPatchLayout : u32{
    InstanceTrs,
    Affine3x4ObjectToWorld,
    Affine3x4WorldToObject
};

[cpp_header("<core/task/gpu/instance_transform_patch_contributor.h>"), cpp_name("::NWB::Core::GpuTaskGraphInstanceTransformPatchRequest"), cpp_flags(self_defaulted, binary_serializable, brace_init)]
extern class GpuTaskGraphInstanceTransformPatchRequest{
    GpuGraphResourceId instanceBufferResource;
    u32 instanceBufferUavSlot;
    u32 instanceStrideFloat4;
    u32 baseFloat4Offset;
    GpuTaskGraphInstanceTransformPatchLayout layout;
};

[cpp_header("<core/task/gpu/instance_transform_patch_contributor.h>"), cpp_name("::NWB::Core::IGpuTaskGraphInstanceTransformPatchContributor"), cpp_flags(no_copy, no_assign, abstract, polymorphic_base)]
extern class IGpuTaskGraphInstanceTransformPatchContributor{
    [cpp_flags(unwind)]
    b8 prepareInstanceTransformPatches();
    [cpp_flags(unwind)]
    b8 hasActiveInstanceTransformPatches()const;
    [cpp_flags(unwind)]
    u64 instanceTransformPatchMembershipSignature()const;
    [cpp_flags(unwind)]
    Expected<GpuTaskId> declareBatchInstanceTransformPatches(
        in Span<GpuTaskGraphInstanceTransformPatchRequest> requests,
        in Span<u32> packedEntityIds,
        in Span<u32> entityIdOffsets,
        in Span<u32> entityIdCounts,
        in Name batchIdentityPrefix,
        in GpuTaskId dependency,
        in b8 mergeWithPrevious,
        in b8 allowMergeAcrossConsumerFrontier,
        mut GpuTaskGraph graph
    );
};


