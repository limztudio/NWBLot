////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_SHADOW_HW_TRANSMISSION_EXPERIMENT_SLANGI
#define NWB_GRAPHICS_SHADOW_HW_TRANSMISSION_EXPERIMENT_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// P5 hardware-assisted transparent-transmission experiment. Same optical oracle as the software path (shadow_integrate.slangi): per-occluder paired-chord Beer-Lambert plus interface product, order-independent. Route under test: hardware candidate collection with bounded fast storage, then the shared finalize.

// Query contract (experimental, internal only):
// - World-space ray segment [tMin, tMax] toward the light; same bias/segment rules as the software path.
// - Transparent-classified instances participate; opaque hits zero the gate immediately (distinct operation).
// - No face culling: both entry and exit boundaries stay candidates.
// - Candidates are NOT distance-ordered by the API: collect per-occluder events, then pair at finalize.
// - Bounded storage NWB_HW_TRANSMISSION_MAX_CANDIDATES: overflow falls back to the software traversal result.
// - CSG/unsupported volumes fall back to software; this experiment never silently approximates them.
// - Disabled by default (NWB_HW_TRANSMISSION_EXPERIMENT_ENABLED == 0): zero shipping behavior change.


#ifndef NWB_HW_TRANSMISSION_EXPERIMENT_ENABLED
#define NWB_HW_TRANSMISSION_EXPERIMENT_ENABLED 0
#endif

#define NWB_HW_TRANSMISSION_MAX_CANDIDATES 8
#define NWB_HW_TRANSMISSION_MAX_OCCLUDERS 3


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#if NWB_HW_TRANSMISSION_EXPERIMENT_ENABLED


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct NwbHwTransmissionCandidate{
    uint instanceId;
    float t;
    float ior;
    half3 transmission;
    float cosI;
};

struct NwbHwTransmissionExperimentState{
    NwbShadowRayOptics optics;
    NwbHwTransmissionCandidate candidates[NWB_HW_TRANSMISSION_MAX_CANDIDATES];
    uint candidateCount;
    uint overflow;
    bool opaqueBlocked;
};

NwbHwTransmissionExperimentState nwbHwTransmissionExperimentBegin(){
    NwbHwTransmissionExperimentState state;
    state.optics = nwbShadowRayOpticsBegin();
    state.candidateCount = 0u;
    state.overflow = 0u;
    state.opaqueBlocked = false;
    return state;
}

void nwbHwTransmissionExperimentRecordCandidate(inout NwbHwTransmissionExperimentState state, const uint instanceId, const float t, const float ior, const half3 transmission, const float cosI){
    if(state.candidateCount >= (uint)NWB_HW_TRANSMISSION_MAX_CANDIDATES){
        state.overflow = 1u;
        return;
    }
    state.candidates[state.candidateCount].instanceId = instanceId;
    state.candidates[state.candidateCount].t = t;
    state.candidates[state.candidateCount].ior = ior;
    state.candidates[state.candidateCount].transmission = transmission;
    state.candidates[state.candidateCount].cosI = cosI;
    state.candidateCount += 1u;
}

void nwbHwTransmissionExperimentCombineOccluder(inout NwbHwTransmissionExperimentState state, const uint instanceId){
    NwbShadowInstanceOptics optics = nwbShadowInstanceOpticsBegin();
    bool hasAbsorption = false;
    for(uint i = 0u; i < state.candidateCount; ++i){
        if(state.candidates[i].instanceId != instanceId)
            continue;
        nwbShadowInstanceIntegrateCrossing(
            optics,
            hasAbsorption,
            state.candidates[i].ior,
            state.candidates[i].transmission,
            state.candidates[i].cosI,
            state.candidates[i].t
        );
    }
    nwbShadowCombineCompletedInstance(state.optics, optics);
}

half3 nwbHwTransmissionExperimentFinalize(const NwbHwTransmissionExperimentState state){
    if(state.opaqueBlocked)
        return half3(0.0h, 0.0h, 0.0h);
    return nwbShadowFinalizeRayOptics(state.optics);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

