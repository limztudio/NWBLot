#include <impl/ecs_ui/toolkit/widgets/popup_style.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> ContextMenuReconcileSourceAction{
    KeepSelectionAndScroll = 0,
    CloseOnNewGeneration = 1,
    ResetSelectionAndScroll = 2,
    kCount
}

ContextMenuReconcileSourceAction ClassifyContextMenuSourceChange(
    in u64 previousGeneration,
    in u64 currentGeneration,
    in u64 previousRevision,
    in u64 currentRevision
){
    if(previousGeneration != 0u && previousGeneration != currentGeneration)
        return ContextMenuReconcileSourceAction::CloseOnNewGeneration;
    if(previousRevision != 0u && previousRevision != currentRevision)
        return ContextMenuReconcileSourceAction::ResetSelectionAndScroll;
    return ContextMenuReconcileSourceAction::KeepSelectionAndScroll;
}

Rect BuildContextMenuTriggerAnchorRect(in Point position){
    return Rect(position.x, position.y, 0.0f, 0.0f);
}

PopupOptions BuildContextMenuPopupOptions(in Rect anchor, in Point size){
    PopupOptions options;
    options.anchor = anchor;
    options.size = size;
    options.gap = 0.0f;
    return options;
}

f32 ResolveSinglePixelCaretWidth(in DisplayMetrics display){
    return 1.0f / display.pixelScaleX;
}

b8 IsValidVirtualListWheelRows(in f32 wheelRows){
    return IsFinite(wheelRows) && wheelRows > 0.0f;
}


