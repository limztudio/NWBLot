#include "benchmark_support.adhd"
#include "binary_kernel_call.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<global/simdmath.h>"), cpp_name("::SIMDQuaternionDoubleDetail::s_DoubleQuaternionInterpolationEpsilon")]
extern const f64 s_ReplicatedQuaternionEpsilon;
[cpp_header("<global/simdmath.h>"), cpp_name("::SIMDVectorDoubleDetail::SinCosReplicated")]
extern void ComputeReplicatedSinCos(mut VectorDouble sine, mut VectorDouble cosine, in VectorDouble value);
[cpp_header("<tests/performance/simd_optimization/benchmark_abi.h>"), cpp_name("::SimdBenchmarkAbi::s_HasSse2")]
extern const b8 s_BenchmarkHasSse2;
[cpp_header("<tests/performance/simd_optimization/benchmark_abi.h>"), cpp_name("::SimdBenchmarkAbi::SseReplicatedReciprocalSqrt")]
extern VectorDouble BenchmarkReplicatedReciprocalSqrt(in VectorDouble value);

enum<u32> ReplicatedOperation{
    Ln = 0u,
    Exp = 1u,
    Normals2 = 2u,
    Normals3 = 3u,
    Normals4 = 4u,
    Vectors2 = 5u,
    Vectors3 = 6u,
    Vectors4 = 7u,
    Slerp = 8u,
    Length2 = 9u,
    Length3 = 10u,
    Length4 = 11u,
    Reciprocal2 = 12u,
    Reciprocal3 = 13u,
    Reciprocal4 = 14u,
    Normalize2 = 15u,
    Normalize3 = 16u,
    Normalize4 = 17u,
    Clamp2 = 18u,
    Clamp3 = 19u,
    Clamp4 = 20u,
    kCount = 21u
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ReplicatedKernelReducer<const u32 KindIndex, const b8 Candidate> : IDoubleBinaryEvaluator{
    public VectorDouble evaluate(in VectorDouble lhs, in VectorDouble rhs)const override{ return ReplicatedKernelReduce<KindIndex, Candidate>(lhs, rhs); }
}

class ReplicatedEvaluator<const u32 KindIndex, const b8 Candidate> : IDoubleBinaryEvaluator{
    public VectorDouble evaluate(in VectorDouble lhs, in VectorDouble rhs)const override{
        return ReplicatedKernelEvaluate<KindIndex, Candidate>(lhs, rhs);
    }
}

class ReplicatedProductionEvaluator<const u32 KindIndex, const b8 Estimate> : IDoubleBinaryEvaluator{
    public VectorDouble evaluate(in VectorDouble lhs, in VectorDouble rhs)const override{
        return ReplicatedKernelProduction<KindIndex, Estimate>(lhs, rhs);
    }
}

class ReplicatedAdditionalCheck<const u32 KindIndex> : IAdditionalReductionCheck{
    public b8 check(
        in VectorDouble lhs,
        in VectorDouble rhs,
        in Observation expected,
        in Observation actual,
        in usize index,
        mut u32 failures
    )const override{
        const Expected<Observation> production = ObserveBinary(ReplicatedProductionEvaluator<KindIndex, false>(), lhs, rhs);
        if(!production.has_value())
            return false;

        b8 matches = false;
        if(IsReplicatedProductionCandidate(KindIndex))
            matches = EqualObservation(actual, production.value());
        else
            matches = EqualObservation(expected, production.value());

        if(!matches){
            ++failures;
            if(failures <= 3u)
                WriteBenchmarkStdout(StringFormat("production mismatch operation={} case={}\n", ReplicatedOperationName(KindIndex), index));
        }

        if(KindIndex >= 2u && KindIndex <= 4u){
            const Expected<Observation> estimate = ObserveBinary(ReplicatedProductionEvaluator<KindIndex, true>(), lhs, rhs);
            if(!estimate.has_value())
                return false;
            b8 estimateMatches = false;
            if(IsReplicatedProductionCandidate(KindIndex))
                estimateMatches = EqualObservation(actual, estimate.value());
            else
                estimateMatches = EqualObservation(expected, estimate.value());
            if(!estimateMatches)
                ++failures;
        }
        return true;
    }
}

class ReplicatedWorkloadRunner<const u32 KindIndex, const b8 Candidate> : IDoubleWorkloadRunner{
    private in Dataset m_data;
    private usize m_iterations;

    public ReplicatedWorkloadRunner(in Dataset data, in usize iterations){
        this.m_data = data;
        this.m_iterations = iterations;
    }

    public VectorDouble run()const override{
        return ReplicatedKernelRunWorkload<KindIndex, Candidate>(this.m_data, s_DataCount, this.m_iterations);
    }
}

class ReplicatedRoundingVerifier : IRoundingModeVerifier{
    public u32 verify(mut u64 seed)const override{
        u32 failures = 0u;
        failures += VerifyReplicatedReduction<0u>(seed);
        failures += VerifyReplicatedReduction<1u>(seed);
        failures += VerifyReplicatedReduction<2u>(seed);
        failures += VerifyReplicatedReduction<3u>(seed);
        failures += VerifyReplicatedReduction<4u>(seed);
        failures += VerifyReplicatedReduction<5u>(seed);
        failures += VerifyReplicatedReduction<6u>(seed);
        failures += VerifyReplicatedReduction<7u>(seed);
        failures += VerifyReplicatedReduction<8u>(seed);
        failures += VerifyReplicatedReduction<9u>(seed);
        failures += VerifyReplicatedReduction<10u>(seed);
        failures += VerifyReplicatedReduction<11u>(seed);
        failures += VerifyReplicatedReduction<12u>(seed);
        failures += VerifyReplicatedReduction<13u>(seed);
        failures += VerifyReplicatedReduction<14u>(seed);
        failures += VerifyReplicatedReduction<15u>(seed);
        failures += VerifyReplicatedReduction<16u>(seed);
        failures += VerifyReplicatedReduction<17u>(seed);
        failures += VerifyReplicatedReduction<18u>(seed);
        failures += VerifyReplicatedReduction<19u>(seed);
        failures += VerifyReplicatedReduction<20u>(seed);
        return failures;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


VectorDouble ReplicatedKernelReplicatedACos(in VectorDouble value){
    return VectorDoubleReplicate(ACos(VectorDoubleGetX(value)));
}

VectorDouble ReplicatedKernelReplicatedSin(in VectorDouble value){
    return VectorDoubleReplicate(Sin(VectorDoubleGetX(value)));
}

VectorDouble ReplicatedKernelReplicatedATan2(in VectorDouble y, in VectorDouble x){
    return VectorDoubleReplicate(ATan2(VectorDoubleGetX(y), VectorDoubleGetX(x)));
}

VectorDouble ReplicatedKernelDot<const u32 Dimension>(in VectorDouble lhs, in VectorDouble rhs){
    if(Dimension == 2u)
        return VectorDouble2Dot(lhs, rhs);
    else if(Dimension == 3u)
        return VectorDouble3Dot(lhs, rhs);
    else
        return VectorDouble4Dot(lhs, rhs);
}

VectorDouble ReplicatedKernelReciprocalLength<const u32 Dimension>(in VectorDouble value){
    return VectorDoubleReciprocalSqrt(ReplicatedKernelDot<Dimension>(value, value));
}

VectorDouble ReplicatedKernelAngle<const u32 Dimension, const b8 Vectors, const b8 Candidate>(in VectorDouble lhs, in VectorDouble rhs){
    VectorDouble cosine = ReplicatedKernelDot<Dimension>(lhs, rhs);
    if(Vectors)
        cosine = VectorDoubleMultiply(cosine, VectorDoubleMultiply(ReplicatedKernelReciprocalLength<Dimension>(lhs), ReplicatedKernelReciprocalLength<Dimension>(rhs)));
    cosine = VectorDoubleClamp(cosine, VectorDouble(-1.0), VectorDouble(1.0));
    if(Candidate)
        return ReplicatedKernelReplicatedACos(cosine);
    else
        return VectorDoubleACos(cosine);
}

VectorDouble ReplicatedKernelQuaternionLn<const b8 Candidate>(in VectorDouble value){
    const VectorDouble bound = VectorDoubleReplicate(1.0 - s_ReplicatedQuaternionEpsilon);
    const VectorDouble w = VectorDoubleSplatW(value);
    const VectorDouble xyz = VectorDoubleAndInt(value, VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u)));
    const VectorDouble control = VectorDoubleInBounds(w, bound);
    VectorDouble theta = VectorDoubleZero();
    if(Candidate)
        theta = ReplicatedKernelReplicatedACos(w);
    else
        theta = VectorDoubleACos(w);
    VectorDouble sine = VectorDoubleZero();
    if(Candidate)
        sine = ReplicatedKernelReplicatedSin(theta);
    else
        sine = VectorDoubleSin(theta);
    return VectorDoubleSelect(xyz, VectorDoubleMultiply(xyz, VectorDoubleDivide(theta, sine)), control);
}

VectorDouble ReplicatedKernelQuaternionExp<const b8 Candidate>(in VectorDouble value){
    const VectorDouble theta = VectorDouble3Length(value);
    VectorDouble sine = VectorDoubleZero();
    VectorDouble cosine = VectorDoubleZero();
    if(Candidate)
        ComputeReplicatedSinCos(sine, cosine, theta);
    else
        VectorDoubleSinCos(sine, cosine, theta);
    const VectorDouble scale = VectorDoubleDivide(sine, theta);
    VectorDouble result = VectorDoubleMultiply(value, scale);
    result = VectorDoubleSelect(result, value, VectorDoubleNearEqual(theta, VectorDoubleZero(), VectorDouble(s_F64Epsilon)));
    return VectorDoubleSelect(cosine, result, VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u)));
}

VectorDouble ReplicatedKernelQuaternionSlerp<const b8 Candidate>(in VectorDouble lhs, in VectorDouble rhs){
    const VectorDouble t = VectorDoubleReplicate(0.375);
    const VectorDouble bound = VectorDoubleReplicate(1.0 - s_ReplicatedQuaternionEpsilon);
    VectorDouble cosine = QuaternionDoubleDot(lhs, rhs);
    VectorDouble control = VectorDoubleLess(cosine, VectorDoubleZero());
    const VectorDouble sign = VectorDoubleSelect(VectorDouble(1.0), VectorDouble(-1.0), control);
    cosine = VectorDoubleMultiply(cosine, sign);
    control = VectorDoubleLess(cosine, bound);
    const VectorDouble sine = VectorDoubleSqrt(VectorDoubleNegativeMultiplySubtract(cosine, cosine, VectorDouble(1.0)));
    VectorDouble omega = VectorDoubleZero();
    if(Candidate)
        omega = ReplicatedKernelReplicatedATan2(sine, cosine);
    else
        omega = VectorDoubleATan2(sine, cosine);
    VectorDouble signMask = VectorDoubleSplatSignMask();
    VectorDouble weights = VectorDoubleShiftLeft(t, VectorDoubleZero(), 2u);
    signMask = VectorDoubleShiftLeft(signMask, VectorDoubleZero(), 3u);
    weights = VectorDoubleXorInt(weights, signMask);
    weights = VectorDoubleAdd(VectorDouble(1.0, 0.0, 0.0, 0.0), weights);
    VectorDouble firstWeight = VectorDoubleMultiply(weights, omega);
    firstWeight = VectorDoubleSin(firstWeight);
    firstWeight = VectorDoubleMultiply(firstWeight, VectorDoubleReciprocal(sine));
    firstWeight = VectorDoubleSelect(weights, firstWeight, control);
    const VectorDouble secondWeight = VectorDoubleMultiply(VectorDoubleSplatY(firstWeight), sign);
    firstWeight = VectorDoubleSplatX(firstWeight);
    return VectorDoubleMultiplyAdd(rhs, secondWeight, VectorDoubleMultiply(lhs, firstWeight));
}

VectorDouble ReplicatedKernelLength<const u32 Dimension, const b8 Reciprocal, const b8 Candidate>(in VectorDouble value){
    if(Candidate && s_BenchmarkHasSse2){
        f64 root = Sqrt(VectorDoubleGetX(ReplicatedKernelDot<Dimension>(value, value)));
        if(Reciprocal)
            root = 1.0 / root;
        return VectorDoubleReplicate(root);
    }

    if(Reciprocal)
        return ReplicatedKernelReciprocalLength<Dimension>(value);
    else{
        if(Dimension == 2u)
            return VectorDouble2Length(value);
        else if(Dimension == 3u)
            return VectorDouble3Length(value);
        else
            return VectorDouble4Length(value);
    }
}

VectorDouble ReplicatedKernelControlledLength<const u32 Dimension, const b8 Clamp, const b8 Candidate>(in VectorDouble value, in VectorDouble fallback){
    const VectorDouble lengthSquared = ReplicatedKernelDot<Dimension>(value, value);

    VectorDouble mask = VectorDoubleTrueInt();
    if(Dimension == 2u)
        mask = VectorDouble(u64x4(u64.max, u64.max, 0u, 0u));
    else if(Dimension == 3u)
        mask = VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u));
    if(Clamp){
        VectorDouble reciprocal = VectorDoubleZero();
        if(Candidate && s_BenchmarkUsesSsePairs)
            reciprocal = BenchmarkReplicatedReciprocalSqrt(lengthSquared);
        else
            reciprocal = VectorDoubleReciprocalSqrt(lengthSquared);
        const VectorDouble minimum = VectorDoubleReplicate(0.5);
        const VectorDouble maximum = VectorDoubleReplicate(2.0);
        const VectorDouble infinite = VectorDoubleEqualInt(lengthSquared, VectorDouble(bit_cast<f64>(0x7ff0000000000000ull)));
        const VectorDouble zero = VectorDoubleEqual(lengthSquared, VectorDoubleZero());
        const VectorDouble select = VectorDoubleEqualInt(infinite, zero);
        VectorDouble normal = VectorDoubleMultiply(value, reciprocal);
        VectorDouble length = VectorDoubleMultiply(lengthSquared, reciprocal);
        length = VectorDoubleSelect(lengthSquared, length, select);
        normal = VectorDoubleSelect(lengthSquared, normal, select);
        const VectorDouble above = VectorDoubleGreater(length, maximum);
        const VectorDouble below = VectorDoubleLess(length, minimum);
        VectorDouble clamped = VectorDoubleSelect(length, maximum, above);
        clamped = VectorDoubleSelect(clamped, minimum, below);
        const VectorDouble result = VectorDoubleMultiply(normal, clamped);
        return VectorDoubleAndInt(VectorDoubleSelect(result, value, VectorDoubleEqualInt(above, below)), mask);
    }
    else{
        const VectorDouble finiteLength = VectorDoubleEqualInt(VectorDoubleOrInt(VectorDoubleIsNaN(lengthSquared), VectorDoubleIsInfinite(lengthSquared)), VectorDoubleFalseInt());
        const VectorDouble validLength = VectorDoubleAndInt(VectorDoubleGreater(lengthSquared, VectorDoubleZero()), finiteLength);
        VectorDouble reciprocal = VectorDoubleZero();
        if(Candidate && s_BenchmarkUsesSsePairs)
            reciprocal = BenchmarkReplicatedReciprocalSqrt(lengthSquared);
        else
            reciprocal = VectorDoubleReciprocalSqrt(lengthSquared);
        const VectorDouble normalized = VectorDoubleAndInt(VectorDoubleMultiply(value, reciprocal), mask);
        const VectorDouble validNormalized = VectorDoubleEqualInt(VectorDoubleOrInt(VectorDoubleIsNaN(normalized), VectorDoubleIsInfinite(normalized)), VectorDoubleFalseInt());
        return VectorDoubleSelect(VectorDoubleAndInt(fallback, mask), normalized, VectorDoubleAndInt(validLength, validNormalized));
    }
}

VectorDouble ReplicatedKernelProductionValue<const u32 KindIndex, const b8 Estimate>(in VectorDouble lhs, in VectorDouble rhs){
    if(KindIndex == 0u)
        return QuaternionDoubleLn(lhs);
    else if(KindIndex == 1u)
        return QuaternionDoubleExp(lhs);
    else if(KindIndex == 2u){
        if(Estimate)
            return VectorDouble2AngleBetweenNormalsEst(lhs, rhs);
        else
            return VectorDouble2AngleBetweenNormals(lhs, rhs);
    }
    else if(KindIndex == 3u){
        if(Estimate)
            return VectorDouble3AngleBetweenNormalsEst(lhs, rhs);
        else
            return VectorDouble3AngleBetweenNormals(lhs, rhs);
    }
    else if(KindIndex == 4u){
        if(Estimate)
            return VectorDouble4AngleBetweenNormalsEst(lhs, rhs);
        else
            return VectorDouble4AngleBetweenNormals(lhs, rhs);
    }
    else if(KindIndex == 5u)
        return VectorDouble2AngleBetweenVectors(lhs, rhs);
    else if(KindIndex == 6u)
        return VectorDouble3AngleBetweenVectors(lhs, rhs);
    else if(KindIndex == 7u)
        return VectorDouble4AngleBetweenVectors(lhs, rhs);
    else if(KindIndex == 8u)
        return QuaternionDoubleSlerp(lhs, rhs, 0.375);
    else if(KindIndex == 9u)
        return VectorDouble2Length(lhs);
    else if(KindIndex == 10u)
        return VectorDouble3Length(lhs);
    else if(KindIndex == 11u)
        return VectorDouble4Length(lhs);
    else if(KindIndex == 12u)
        return VectorDouble2ReciprocalLength(lhs);
    else if(KindIndex == 13u)
        return VectorDouble3ReciprocalLength(lhs);
    else if(KindIndex == 14u)
        return VectorDouble4ReciprocalLength(lhs);
    else if(KindIndex == 15u)
        return VectorDouble2NormalizeOr(lhs, rhs, 0.0);
    else if(KindIndex == 16u)
        return VectorDouble3NormalizeOr(lhs, rhs, 0.0);
    else if(KindIndex == 17u)
        return VectorDouble4NormalizeOr(lhs, rhs, 0.0);
    else if(KindIndex == 18u)
        return VectorDouble2ClampLength(lhs, 0.5, 2.0);
    else if(KindIndex == 19u)
        return VectorDouble3ClampLength(lhs, 0.5, 2.0);
    else
        return VectorDouble4ClampLength(lhs, 0.5, 2.0);
}

VectorDouble ReplicatedKernelProduction<const u32 KindIndex, const b8 Estimate>(in VectorDouble lhs, in VectorDouble rhs){
    return EvaluateBinaryKernel(lambda[](in VectorDouble left, in VectorDouble right) -> VectorDouble{
        return ReplicatedKernelProductionValue<KindIndex, Estimate>(left, right);
    }, lhs, rhs);
}

VectorDouble ReplicatedKernelReduce<const u32 KindIndex, const b8 Candidate>(in VectorDouble lhs, in VectorDouble rhs){
    if(Candidate && (KindIndex <= 8u || (KindIndex >= 12u && KindIndex <= 14u)))
        return ReplicatedKernelProductionValue<KindIndex, false>(lhs, rhs);
    else if(KindIndex == 0u)
        return ReplicatedKernelQuaternionLn<Candidate>(lhs);
    else if(KindIndex == 1u)
        return ReplicatedKernelQuaternionExp<Candidate>(lhs);
    else if(KindIndex == 2u)
        return ReplicatedKernelAngle<2u, false, Candidate>(lhs, rhs);
    else if(KindIndex == 3u)
        return ReplicatedKernelAngle<3u, false, Candidate>(lhs, rhs);
    else if(KindIndex == 4u)
        return ReplicatedKernelAngle<4u, false, Candidate>(lhs, rhs);
    else if(KindIndex == 5u)
        return ReplicatedKernelAngle<2u, true, Candidate>(lhs, rhs);
    else if(KindIndex == 6u)
        return ReplicatedKernelAngle<3u, true, Candidate>(lhs, rhs);
    else if(KindIndex == 7u)
        return ReplicatedKernelAngle<4u, true, Candidate>(lhs, rhs);
    else if(KindIndex == 8u)
        return ReplicatedKernelQuaternionSlerp<Candidate>(lhs, rhs);
    else if(KindIndex == 9u)
        return ReplicatedKernelLength<2u, false, Candidate>(lhs);
    else if(KindIndex == 10u)
        return ReplicatedKernelLength<3u, false, Candidate>(lhs);
    else if(KindIndex == 11u)
        return ReplicatedKernelLength<4u, false, Candidate>(lhs);
    else if(KindIndex == 12u)
        return ReplicatedKernelLength<2u, true, Candidate>(lhs);
    else if(KindIndex == 13u)
        return ReplicatedKernelLength<3u, true, Candidate>(lhs);
    else if(KindIndex == 14u)
        return ReplicatedKernelLength<4u, true, Candidate>(lhs);
    else if(KindIndex == 15u)
        return ReplicatedKernelControlledLength<2u, false, Candidate>(lhs, rhs);
    else if(KindIndex == 16u)
        return ReplicatedKernelControlledLength<3u, false, Candidate>(lhs, rhs);
    else if(KindIndex == 17u)
        return ReplicatedKernelControlledLength<4u, false, Candidate>(lhs, rhs);
    else if(KindIndex == 18u)
        return ReplicatedKernelControlledLength<2u, true, Candidate>(lhs, rhs);
    else if(KindIndex == 19u)
        return ReplicatedKernelControlledLength<3u, true, Candidate>(lhs, rhs);
    else
        return ReplicatedKernelControlledLength<4u, true, Candidate>(lhs, rhs);
}

VectorDouble ReplicatedKernelEvaluate<const u32 KindIndex, const b8 Candidate>(in VectorDouble lhs, in VectorDouble rhs){
    return EvaluateBinaryKernel(lambda[](in VectorDouble left, in VectorDouble right) -> VectorDouble{
        if(Candidate && (KindIndex <= 8u || (KindIndex >= 12u && KindIndex <= 14u)))
            return ReplicatedKernelProduction<KindIndex, false>(left, right);
        return ReplicatedKernelReduce<KindIndex, Candidate>(left, right);
    }, lhs, rhs);
}

VectorDouble ReplicatedKernelRunWorkload<const u32 KindIndex, const b8 Candidate>(in Dataset data, in usize dataCount, in usize iterations){
    return ThroughputWorkload<4u, ReplicatedKernelReducer<KindIndex, Candidate>>(data, dataCount, iterations, ReplicatedKernelReducer<KindIndex, Candidate>());
}

StringView ReplicatedOperationName(in u32 kindIndex){
    switch(kindIndex){
    case 0u: return "ln";
    case 1u: return "exp";
    case 2u: return "normals2";
    case 3u: return "normals3";
    case 4u: return "normals4";
    case 5u: return "vectors2";
    case 6u: return "vectors3";
    case 7u: return "vectors4";
    case 8u: return "slerp";
    case 9u: return "length2";
    case 10u: return "length3";
    case 11u: return "length4";
    case 12u: return "reciprocal2";
    case 13u: return "reciprocal3";
    case 14u: return "reciprocal4";
    case 15u: return "normalize2";
    case 16u: return "normalize3";
    case 17u: return "normalize4";
    case 18u: return "clamp2";
    case 19u: return "clamp3";
    case 20u: return "clamp4";
    default: return "";
    }
}

b8 IsReplicatedProductionCandidate(in u32 kindIndex){
    return kindIndex <= 8u || (kindIndex >= 12u && kindIndex <= 14u);
}

u32 VerifyReplicatedReduction<const u32 KindIndex>(mut u64 seed){
    return VerifyReductionCases(
        ReplicatedOperationName(KindIndex),
        ReplicatedEvaluator<KindIndex, false>(),
        ReplicatedEvaluator<KindIndex, true>(),
        ReplicatedAdditionalCheck<KindIndex>(),
        seed
    );
}

u32 VerifyReplicatedBenchmark(){
    const VerificationSweep verification = VerifyRoundingModes(ReplicatedRoundingVerifier());
    if(!verification.environmentAvailable)
        return verification.failures;
    const u32 failures = verification.failures;
    WriteBenchmarkStdout(StringFormat("verification failures={} vector_cases=1376256\n", failures));
    return failures;
}

void NormalizeReplicatedDataset(in StringView opName, mut Dataset data){
    for(usize index = 0u; index < s_DataCount; ++index){
        const VectorDouble leftValue = VectorDouble(data.left[index]);
        const VectorDouble rightValue = VectorDouble(data.right[index]);
        if(opName == "normals2"){
            data.left[index] = f64x4(Normalize(leftValue.xy));
            data.right[index] = f64x4(Normalize(rightValue.xy));
        }
        else if(opName == "normals3"){
            data.left[index] = f64x4(Normalize(leftValue.xyz));
            data.right[index] = f64x4(Normalize(rightValue.xyz));
        }
        else if(opName == "normals4" || opName == "ln" || opName == "slerp"){
            data.left[index] = f64x4(Normalize(leftValue));
            data.right[index] = f64x4(Normalize(rightValue));
        }
    }
}

void RunReplicatedVariant<const u32 KindIndex>(in Dataset data, in b8 candidate, in usize iterations, in b8 latency){
    const usize operations = iterations * 4u;
    SelectVariant(
        ReplicatedOperationName(KindIndex),
        candidate,
        latency,
        operations,
        ReplicatedWorkloadRunner<KindIndex, true>(data, iterations),
        ReplicatedWorkloadRunner<KindIndex, false>(data, iterations)
    );
}

i32 RunReplicatedBenchmarkCli(in Span<StringView> args){
    if(args.size() == 2u && args[1] == "--verify"){
        if(VerifyReplicatedBenchmark() == 0u)
            return 0;
        return 1;
    }
    if(args.size() != 6u || args[1] != "--measure"){
        WriteBenchmarkStderr("usage: replicated_benchmark --verify | --measure operation baseline|candidate iterations throughput\n");
        return 2;
    }
    const Expected<MeasureOptions> options = ParseMeasureOptions(args[3], args[4], args[5], usize.max / 4u, false);
    if(!options.has_value())
        return 2;
    const b8 candidate = options.value().candidate;
    const b8 latency = options.value().latency;
    const usize iterations = options.value().iterations;

    Dataset data = Dataset();
    InitializeDataset(s_InitialSeed, data);
    NormalizeReplicatedDataset(args[2], data);

    const u32 count = cast<u32>(ReplicatedOperation::kCount);
    for(u32 index = 0u; index < count; ++index){
        if(args[2] != ReplicatedOperationName(index))
            continue;
        switch(index){
        case 0u: RunReplicatedVariant<0u>(data, candidate, iterations, latency); break;
        case 1u: RunReplicatedVariant<1u>(data, candidate, iterations, latency); break;
        case 2u: RunReplicatedVariant<2u>(data, candidate, iterations, latency); break;
        case 3u: RunReplicatedVariant<3u>(data, candidate, iterations, latency); break;
        case 4u: RunReplicatedVariant<4u>(data, candidate, iterations, latency); break;
        case 5u: RunReplicatedVariant<5u>(data, candidate, iterations, latency); break;
        case 6u: RunReplicatedVariant<6u>(data, candidate, iterations, latency); break;
        case 7u: RunReplicatedVariant<7u>(data, candidate, iterations, latency); break;
        case 8u: RunReplicatedVariant<8u>(data, candidate, iterations, latency); break;
        case 9u: RunReplicatedVariant<9u>(data, candidate, iterations, latency); break;
        case 10u: RunReplicatedVariant<10u>(data, candidate, iterations, latency); break;
        case 11u: RunReplicatedVariant<11u>(data, candidate, iterations, latency); break;
        case 12u: RunReplicatedVariant<12u>(data, candidate, iterations, latency); break;
        case 13u: RunReplicatedVariant<13u>(data, candidate, iterations, latency); break;
        case 14u: RunReplicatedVariant<14u>(data, candidate, iterations, latency); break;
        case 15u: RunReplicatedVariant<15u>(data, candidate, iterations, latency); break;
        case 16u: RunReplicatedVariant<16u>(data, candidate, iterations, latency); break;
        case 17u: RunReplicatedVariant<17u>(data, candidate, iterations, latency); break;
        case 18u: RunReplicatedVariant<18u>(data, candidate, iterations, latency); break;
        case 19u: RunReplicatedVariant<19u>(data, candidate, iterations, latency); break;
        case 20u: RunReplicatedVariant<20u>(data, candidate, iterations, latency); break;
        default: return 2;
        }
        return 0;
    }
    return 2;
}


