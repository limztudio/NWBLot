#ifndef NWB_GRAPHICS_BVH_RAY_VERTEX_ATTRIB_SLANGI
#define NWB_GRAPHICS_BVH_RAY_VERTEX_ATTRIB_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "constants.h"
#include "../common/math.slangi"


// Per-triangle-corner attribute ABI shared by software and hardware ray traces: packed Half4 normal at byte
// NWB_RAYTRACE_VERTEX_ATTRIBUTE_NORMAL_BYTE_OFFSET and Float2 uv0 at byte
// NWB_RAYTRACE_VERTEX_ATTRIBUTE_UV0_BYTE_OFFSET. Callers keep their own heap-load strategy, then decode the identical
// NWB_RAYTRACE_VERTEX_ATTRIBUTE_STRIDE_BYTES-byte record here.
struct NwbRayTraceVertexAttrib{
    half3 normal;
    float2 uv0;
};

NwbRayTraceVertexAttrib nwbRayTraceDecodeVertexAttrib(const uint4 packed){
    NwbRayTraceVertexAttrib attrib;
    attrib.normal = half3(float3(
        nwbUnpackHalf2x16(packed.x),
        nwbUnpackHalf2x16(packed.y).x
    ));
    attrib.uv0 = asfloat(packed.zw);
    return attrib;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

