using namespace NWB;
using namespace NWB::Impl::Ui;

struct FormattedNumericBuffer{
    Array<char, s_NumericEditMaxBytes> storage{};
    Expected<AStringView, ErrorCode> result = MakeUnexpected(ErrorCode{});

    [[nodiscard]] b8 hasValue()const noexcept{
        return result.has_value();
    }

    [[nodiscard]] AStringView text()const noexcept{
        return result ? *result : AStringView{};
    }

    [[nodiscard]] ErrorCode error()const noexcept{
        return result ? ErrorCode{} : result.error();
    }
};

[[nodiscard]] inline FormattedNumericBuffer FormatIntegerBuffer(const i64 value)noexcept{
    FormattedNumericBuffer out;
    out.result = FormatI64(value, out.storage);
    return out;
}

[[nodiscard]] inline FormattedNumericBuffer FormatFloatBuffer(const f64 value)noexcept{
    FormattedNumericBuffer out;
    out.result = FormatF64(value, out.storage);
    return out;
}

struct GuardedOneByteBuffer{
    char first = 'a';
    Array<char, 1u> buffer{ 'x' };
    char last = 'z';

    [[nodiscard]] Expected<AStringView, ErrorCode> formatInteger(const i64 value)noexcept{
        return FormatI64(value, buffer);
    }

    [[nodiscard]] Expected<AStringView, ErrorCode> formatFloat(const f64 value)noexcept{
        return FormatF64(value, buffer);
    }

    [[nodiscard]] b8 firstIntact()const noexcept{
        return first == 'a';
    }

    [[nodiscard]] b8 lastIntact()const noexcept{
        return last == 'z';
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


