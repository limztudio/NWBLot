    "    public ForeignMode sentinel = ForeignMode::kCount;\r\n"
    "    public AssetRef<ForeignAsset> asset;\r\n"
    "}\r\n"
    "u32 UseForeign(in u32 x) {\r\n"
    "    u32 kForeignConst = 100u;\r\n"
    "    ForeignMode m = ForeignMode::Alpha;\r\n"
    "    ForeignItem it = ForeignItem();\r\n"
    "    if(ForeignAsset::s_AssetTypeName.empty())\r\n"
    "        return kForeignConst;\r\n"
    "    return ForeignFn(x) + kForeignConst + kForeignOther + kSameBridgeConst;\r\n"
    "}\r\n";

inline constexpr MStringView s_SuiteNestedTemplateAndDocumentVisitorSource =
    "[arena, asset(\"mock_nested\")]\r\n"
    "class MockNestedAsset {\r\n"
    "    public u32 dummy = 0u;\r\n"
    "}\r\n"
    "b8 ExerciseNestedTemplatesAndVisitors(\r\n"
    "    mut AssetDocumentMetadataParseContext docCtx,\r\n"
    "    in Path nwbPath,\r\n"
    "    mut GpuDescriptorRetirementGuard guard,\r\n"
    "    in AssetManager assetMgr,\r\n"
    "    in Name vp\r\n"
    ") {\r\n"
    "    if(!docCtx.doc.parse(\"asset = { items = [1, 2], ref = \\\"mock/a\\\" };\")) {\r\n"
    "        for(in MetascriptParseError err : docCtx.doc.errors()) {\r\n"
    "            if(err.line > 0u)\r\n"
    "                return false;\r\n"
    "        }\r\n"
    "    }\r\n"
    "    if(!docCtx.doc.hasVariable(\"asset\"))\r\n"
    "        return false;\r\n"
    "    const b8 visited = docCtx.doc.visitVariable(\"asset\", lambda[in nwbPath](in MetascriptValue assetVal) -> b8 {\r\n"
    "        if(!ValidateMetadataAssetFields(nwbPath, assetVal, \"test\"))\r\n"
    "            return false;\r\n"
    "        if(!ValidateMetadataAssetFields(nwbPath, assetVal, \"test\", lambda[](in StringView key) -> b8 { return key == \"items\" || key == \"ref\"; }))\r\n"
    "            return false;\r\n"
    "        if(!assetVal.forEachMapEntry(lambda[](in StringView k, in MetascriptValue v) -> b8 { return !k.empty() && !v.isNull(); }))\r\n"
    "            return false;\r\n"
    "        assetVal.visitField(\"items\", lambda[](in MetascriptValue listVal) -> void {\r\n"
    "            for(in MetascriptValue item : listVal.listView()) {\r\n"
    "                if(!item.isNumeric())\r\n"
    "                    return;\r\n"
    "            }\r\n"
    "        });\r\n"
    "        Expected<AssetRef<MockNestedAsset>> refRes = ReadMetadataAssetRefField<MockNestedAsset>(nwbPath, assetVal, \"test\", \"ref\", false);\r\n"
    "        if(!refRes.hasValue())\r\n"
    "            return false;\r\n"
    "        AssetRef<MockNestedAsset> refVal = refRes.value();\r\n"
    "        refVal.reset();\r\n"
    "        return !refVal.valid();\r\n"
    "    });\r\n"
    "    guard.release();\r\n"
    "    Expected<UniquePtr<MockNestedAsset>> loaded = LoadTypedAssetSync<MockNestedAsset>(assetMgr, vp, \"test\");\r\n"
    "    return visited && loaded.hasValue() && loaded.value().valid();\r\n"
    "}\r\n";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


