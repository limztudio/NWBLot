NWB_ADHD_GTEST_F(LoggerTelemetryPublication, TelemetryPublicationDoesNotReplaceExistingFinalFile, VerifyLoggerTelemetryPublication_TelemetryPublicationDoesNotReplaceExistingFinalFile)
NWB_ADHD_GTEST_F(LoggerTelemetryPublication, TelemetryPublicationDoesNotReplaceExistingStagingFile, VerifyLoggerTelemetryPublication_TelemetryPublicationDoesNotReplaceExistingStagingFile)
NWB_ADHD_GTEST_F(LoggerTelemetryPublication, ConcurrentTelemetryPublishersCannotReplaceEachOther, VerifyLoggerTelemetryPublication_ConcurrentTelemetryPublishersCannotReplaceEachOther)
NWB_ADHD_GTEST_F(LoggerTelemetryPublication, TelemetryPublicationMovesCompletedBytesToNewFinalFile, VerifyLoggerTelemetryPublication_TelemetryPublicationMovesCompletedBytesToNewFinalFile)

NWB_ADHD_GTEST_F(LoggerProducerContracts, MessagePayloadRejectsInvalidTypeWithoutPublishingStaleBytes, VerifyLoggerProducerContracts_MessagePayloadRejectsInvalidTypeWithoutPublishingStaleBytes)
NWB_ADHD_GTEST_F(LoggerProducerContracts, SimultaneousProcessedFilesKeepIndependentRecords, VerifyLoggerProducerContracts_SimultaneousProcessedFilesKeepIndependentRecords)
NWB_ADHD_GTEST_F(LoggerProducerContracts, MissingArchiveRetainsNativeReadFailureInOwningRejection, VerifyLoggerProducerContracts_MissingArchiveRetainsNativeReadFailureInOwningRejection)


