class AvboitTargetFactory final{
public:
    [[nodiscard]] static Expected<Core::TextureHandle> CreateRenderTarget(Core::GraphicsRuntime& graphics, u32 width, u32 height, Core::Format::Enum format, NameText<char> debugName, const Core::Color& clearValue, b8 shareWithAsyncCompute = false);
    [[nodiscard]] static Expected<Core::TextureHandle> CreateTransmittanceVolume(Core::GraphicsRuntime& graphics, u32 width, u32 height, u32 depth, Core::Format::Enum format);
    [[nodiscard]] static Expected<Core::BufferHandle> CreateU32Buffer(Core::GraphicsRuntime& graphics, u64 byteSize, NameText<char> debugName);
};


