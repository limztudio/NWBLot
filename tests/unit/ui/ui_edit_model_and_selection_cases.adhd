void VerifyUiEditCompositionTests_InvalidSelectionPreservesActiveCompositionAndNoSessionCommitIsRejected(mut UiEditCompositionTests self){
    EXPECT_FALSE(self.m_model.commitComposition("x"));
    EXPECT_FALSE(self.m_model.updateComposition("x", 0u, 1u));
    ASSERT_TRUE(self.m_model.setText("a\xCC\x81"));
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("x", 0u, 1u));
    EXPECT_FALSE(self.m_model.setSelection(1u, 1u));
    EXPECT_TRUE(self.m_model.composition().active);
    EXPECT_EQ(self.m_model.composition().text, "x");
    ASSERT_TRUE(self.m_model.beginComposition());
