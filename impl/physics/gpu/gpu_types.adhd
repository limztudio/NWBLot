static_assert(cast<u32>(BodyFlags::LockAngularY) == s_ShaderPhysicsBodyFlagLockAngularY, "BodyFlags::LockAngularY mismatch");
static_assert(cast<u32>(BodyFlags::LockAngularZ) == s_ShaderPhysicsBodyFlagLockAngularZ, "BodyFlags::LockAngularZ mismatch");
static_assert(cast<u32>(BodyFlags::IsSpeedCapped) == s_ShaderPhysicsBodyFlagIsSpeedCapped, "BodyFlags::IsSpeedCapped mismatch");
static_assert(cast<u32>(BodyFlags::AllowFastRotation) == s_ShaderPhysicsBodyFlagAllowFastRotation, "BodyFlags::AllowFastRotation mismatch");
static_assert(cast<u32>(BodyFlags::Dynamic) == s_ShaderPhysicsBodyFlagDynamic, "BodyFlags::Dynamic mismatch");
static_assert(cast<u32>(BodyFlags::EnableGyroscopicTorque) == s_ShaderPhysicsBodyFlagGyroscopic, "BodyFlags::EnableGyroscopicTorque mismatch");
static_assert(cast<u32>(BodyFlags::HasCustomMaxAngularVelocity) == s_ShaderPhysicsBodyFlagHasCustomMaxAngularVel, "BodyFlags::HasCustomMaxAngularVelocity mismatch");
static_assert(s_GpuShapeFlagEnlargeAabb != 0u && s_GpuShapeFlagEnlargeAabb != s_GpuShapeFlagFastOrBullet && (s_GpuShapeFlagEnlargeAabb & s_GpuShapeFlagHasNonCollideJoint) == 0u, "ShapeFlag EnlargeAabb distinct bit");
static_assert(s_GpuSolverFlagHasHitEvents != 0u && (s_GpuSolverFlagHasHitEvents & (s_GpuSolverFlagWarmStart | s_GpuSolverFlagSerialLoop | s_GpuSolverFlagFirstSubstep)) == 0u, "SolverFlag HasHitEvents distinct bit");


