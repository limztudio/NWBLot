#include <impl/assets_mesh/asset.adhd>
#include <impl/assets_physics/components.adhd>
#include <impl/assets_physics/physics_component_binary_codec.adhd>
#include <impl/assets_scene/cook.adhd>
#include <impl/assets_scene/cook_component_metadata.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_RigidBodyComponentDiagnosticPrefix = "RigidBody component meta";
const StringView s_ColliderComponentDiagnosticPrefix = "Collider component meta";
const StringView s_JointComponentDiagnosticPrefix = "Joint component meta";
const StringView s_PhysicsWorldConfigComponentDiagnosticPrefix = "PhysicsWorldConfig component meta";
const StringView s_PhysicsParentComponentDiagnosticPrefix = "PhysicsParent component meta";

type RigidBodyComponentCookEntry = TypedComponentCookEntry<RigidBodyComponent>;
type ColliderComponentCookEntry = TypedComponentCookEntry<ColliderComponent>;
type JointComponentCookEntry = TypedComponentCookEntry<JointComponent>;
type PhysicsWorldConfigComponentCookEntry = TypedComponentCookEntry<PhysicsWorldConfigComponent>;
type PhysicsParentComponentCookEntry = TypedComponentCookEntry<PhysicsParentComponent>;

type RigidBodyComponentCodec = TypedComponentAssetCodec<RigidBodyComponentAsset>;
type ColliderComponentCodec = TypedComponentAssetCodec<ColliderComponentAsset>;
type JointComponentCodec = TypedComponentAssetCodec<JointComponentAsset>;
type PhysicsWorldConfigComponentCodec = TypedComponentAssetCodec<PhysicsWorldConfigComponentAsset>;
type PhysicsParentComponentCodec = TypedComponentAssetCodec<PhysicsParentComponentAsset>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ReadPhysicsOptionalU32Field(
    in Path file,
    in MetascriptValue value,
    in StringView prefix,
    in StringView field,
    mut u32 inOutVal
){
    b8 ok = true;
    u32 parsed = inOutVal;
    const b8 found = value.visitField(
        field,
        lambda[in file, in prefix, in field, mut ok, mut parsed](in MetascriptValue fieldVal) -> void{
            if(!fieldVal.isNumeric()){
                error("{} '{}': field '{}' must be a non-negative integer", prefix, PathToString(file), field);
                ok = false;
                return;
            }
            const f64 num = fieldVal.toDouble();
            if(!IsFinite(num) || num < 0.0 || num > 4294967295.0 || Floor(num) != num){
                error("{} '{}': field '{}' must be a u32 integer", prefix, PathToString(file), field);
                ok = false;
                return;
            }
            parsed = cast<u32>(num);
        }
    );
    if(!ok)
        return false;
    if(found)
        inOutVal = parsed;
    return true;
}


b8 ReadPhysicsOptionalRotationField(
    in Path file,
    in MetascriptValue value,
    in StringView prefix,
    in StringView quatField,
    in StringView eulerField,
    in StringView eulerDegField,
    mut VectorSingle inOutQuat
){
    const b8 hasQuat = value.hasField(quatField);
    const b8 hasEuler = value.hasField(eulerField);
    const b8 hasEulerDeg = value.hasField(eulerDegField);
    usize count = 0u;
    if(hasQuat) ++count;
    if(hasEuler) ++count;
    if(hasEulerDeg) ++count;
    if(count > 1u){
        error("{} '{}': only one of '{}', '{}', or '{}' may be set", prefix, PathToString(file), quatField, eulerField, eulerDegField);
        return false;
    }
    if(hasQuat){
        b8 ok = true;
        VectorSingle parsed = inOutQuat;
        value.visitField(
            quatField,
            lambda[in file, in prefix, in quatField, mut ok, mut parsed](in MetascriptValue fv) -> void{
                const Expected<VectorSingle> q = ParseSceneQuaternionValue(file, fv, prefix, quatField);
                if(!q.has_value()){
                    ok = false;
                    return;
                }
                parsed = q.value();
            }
        );
        if(!ok)
            return false;
        inOutQuat = parsed;
        return true;
    }
    if(hasEuler){
        VectorSingle euler(0.0f);
        if(!ReadOptionalSceneFloat3Field(file, value, prefix, eulerField, euler))
            return false;
        inOutQuat = VectorSingle(BuildTransformEulerQuaternion(euler, false));
        return true;
    }
    if(hasEulerDeg){
        VectorSingle euler(0.0f);
        if(!ReadOptionalSceneFloat3Field(file, value, prefix, eulerDegField, euler))
            return false;
        inOutQuat = VectorSingle(BuildTransformEulerQuaternion(euler, true));
        return true;
    }
    return true;
}

b8 ReadPhysicsFloat3ArrayField(
    in Path file,
    in MetascriptValue value,
    in StringView prefix,
    in StringView field,
    mut Vector<f32x4> outPoints
){
    if(!value.hasField(field))
        return true;
    b8 ok = true;
    value.visitField(
        field,
        lambda[in file, in prefix, in field, mut ok, mut outPoints](in MetascriptValue listVal) -> void{
            if(!listVal.isList()){
                error("{} '{}': field '{}' must be a list of 3-element float lists", prefix, PathToString(file), field);
                ok = false;
                return;
            }
            const Span<MetascriptValue> items = listVal.listView();
            outPoints.clear();
            outPoints.reserve(items.size());
            for(usize i = 0u; i < items.size(); ++i){
                const Expected<VectorSingle> pt = ReadSceneFloatListValue(file, items[i], prefix, field, s_SceneFloat3ComponentCount);
                if(!pt.has_value()){
                    ok = false;
                    return;
                }
                outPoints.push_back(f32x4(pt.value(), 0.0f));
            }
        }
    );
    return ok;
}

b8 ReadPhysicsU32ArrayField(
    in Path file,
    in MetascriptValue value,
    in StringView prefix,
    in StringView field,
    mut Vector<u32> outIndices
){
    if(!value.hasField(field))
        return true;
    b8 ok = true;
    value.visitField(
        field,
        lambda[in file, in prefix, in field, mut ok, mut outIndices](in MetascriptValue listVal) -> void{
            if(!listVal.isList()){
                error("{} '{}': field '{}' must be a list of u32 integers", prefix, PathToString(file), field);
                ok = false;
                return;
            }
            const Span<MetascriptValue> items = listVal.listView();
            outIndices.clear();
            outIndices.reserve(items.size());
            for(usize i = 0u; i < items.size(); ++i){
                in MetascriptValue item = items[i];
                if(!item.isNumeric()){
                    error("{} '{}': field '{}' entries must be numeric integers", prefix, PathToString(file), field);
                    ok = false;
                    return;
                }
                const f64 num = item.toDouble();
                if(!IsFinite(num) || num < 0.0 || num > 4294967295.0 || Floor(num) != num){
                    error("{} '{}': field '{}' entries must be u32 integers", prefix, PathToString(file), field);
                    ok = false;
                    return;
                }
                outIndices.push_back(cast<u32>(num));
            }
        }
    );
    return ok;
}

b8 ReadPhysicsOptionalU64Field(
    in Path file,
    in MetascriptValue value,
    in StringView prefix,
    in StringView field,
    mut u64 inOutVal
){
    b8 ok = true;
    u64 parsed = inOutVal;
    const b8 found = value.visitField(
        field,
        lambda[in file, in prefix, in field, mut ok, mut parsed](in MetascriptValue fieldVal) -> void{
            if(!fieldVal.isNumeric()){
                error("{} '{}': field '{}' must be a non-negative integer", prefix, PathToString(file), field);
                ok = false;
                return;
            }
            const f64 num = fieldVal.toDouble();
            if(!IsFinite(num) || num < 0.0 || num > 9007199254740991.0 || Floor(num) != num){
                error("{} '{}': field '{}' must be a u64 integer", prefix, PathToString(file), field);
                ok = false;
                return;
            }
            parsed = cast<u64>(num);
        }
    );
    if(!ok)
        return false;
    if(found)
        inOutVal = parsed;
    return true;
}

b8 ReadPhysicsOptionalNameField(
    in Path file,
    in MetascriptValue value,
    in StringView prefix,
    in StringView field,
    mut Name inOutName
){
    if(!value.hasField(field))
        return true;
    const Expected<MetadataStringField> f = ReadMetadataStringField(file, value, prefix, field, true);
    if(!f.has_value())
        return false;
    const Expected<Name> parsed = ParseName(f.value().text);
    if(!parsed.has_value() || parsed.value() == s_NameNone){
        error("{} '{}': field '{}' must be a non-empty name", prefix, PathToString(file), field);
        return false;
    }
    inOutName = parsed.value();
    return true;
}

b8 IsAllowedRigidBodyMetadataField(in StringView key){
    return
        key == "type" || key == "linear_velocity" || key == "angular_velocity"
        || key == "linear_damping" || key == "angular_damping" || key == "gravity_scale"
        || key == "sleep_threshold" || key == "motion_locks" || key == "enable_sleep"
        || key == "is_awake" || key == "is_bullet" || key == "is_enabled"
        || key == "allow_fast_rotation" || key == "enable_gyroscopic_torque"
        || key == "drive_kinematic_from_transform"
        || key == "user_data" || key == "entity_tag"
        || key == "use_custom_mass" || key == "custom_mass"
        || key == "custom_center_of_mass" || key == "custom_inertia_diag"
        || key == "custom_inertia_off_diag"
    ;
}

Expected<RigidBodyComponentCookEntry> ParseRigidBodyComponentCookMetadata(in Name virtualPath, in Path file, in MetascriptValue value){
    RigidBodyComponentCookEntry entry;
    if(!CheckMetadataAssetMap(file, value, s_RigidBodyComponentDiagnosticPrefix)
        || !AssignCookEntryVirtualPath(virtualPath, file, s_RigidBodyComponentDiagnosticPrefix, entry)
        || !ValidateMetadataAssetFields(file, value, s_RigidBodyComponentDiagnosticPrefix, IsAllowedRigidBodyMetadataField))
        return MakeUnexpected(Failure());

    RigidBodyComponent c = entry.component;
    if(value.hasField("type")){
        const Expected<MetadataStringField> f = ReadMetadataStringField(file, value, s_RigidBodyComponentDiagnosticPrefix, "type", true);
        if(!f.has_value())
            return MakeUnexpected(Failure());
        if(f.value().text == "static") c.type = BodyType::Static;
        else if(f.value().text == "kinematic") c.type = BodyType::Kinematic;
        else if(f.value().text == "dynamic") c.type = BodyType::Dynamic;
        else{
            error("{} '{}': field 'type' must be 'static', 'kinematic', or 'dynamic'", s_RigidBodyComponentDiagnosticPrefix, file);
            return MakeUnexpected(Failure());
        }
    }

    VectorSingle linVel = VectorSingle(c.linearVelocity);
    VectorSingle angVel = VectorSingle(c.angularVelocity);
    VectorSingle customCom = VectorSingle(c.customCenterOfMass);
    VectorSingle customInertiaD = VectorSingle(c.customInertiaDiag);
    VectorSingle customInertiaO = VectorSingle(c.customInertiaOffDiag);
    if(!ReadOptionalSceneFloat3Field(file, value, s_RigidBodyComponentDiagnosticPrefix, "linear_velocity", linVel)
        || !ReadOptionalSceneFloat3Field(file, value, s_RigidBodyComponentDiagnosticPrefix, "angular_velocity", angVel)
        || !ReadOptionalFiniteF32Field(file, value, s_RigidBodyComponentDiagnosticPrefix, "linear_damping", c.linearDamping)
        || !ReadOptionalFiniteF32Field(file, value, s_RigidBodyComponentDiagnosticPrefix, "angular_damping", c.angularDamping)
        || !ReadOptionalFiniteF32Field(file, value, s_RigidBodyComponentDiagnosticPrefix, "gravity_scale", c.gravityScale)
        || !ReadOptionalFiniteF32Field(file, value, s_RigidBodyComponentDiagnosticPrefix, "sleep_threshold", c.sleepThreshold)
        || !ReadPhysicsOptionalU32Field(file, value, s_RigidBodyComponentDiagnosticPrefix, "motion_locks", c.motionLocks)
        || !ReadPhysicsOptionalU64Field(file, value, s_RigidBodyComponentDiagnosticPrefix, "user_data", c.userData)
        || !ReadPhysicsOptionalNameField(file, value, s_RigidBodyComponentDiagnosticPrefix, "entity_tag", c.entityTag)
        || !ReadOptionalMetadataBoolField(file, value, s_RigidBodyComponentDiagnosticPrefix, "use_custom_mass", c.useCustomMass)
        || !ReadOptionalFiniteF32Field(file, value, s_RigidBodyComponentDiagnosticPrefix, "custom_mass", c.customMass)
        || !ReadOptionalSceneFloat3Field(file, value, s_RigidBodyComponentDiagnosticPrefix, "custom_center_of_mass", customCom)
        || !ReadOptionalSceneFloat3Field(file, value, s_RigidBodyComponentDiagnosticPrefix, "custom_inertia_diag", customInertiaD)
        || !ReadOptionalSceneFloat3Field(file, value, s_RigidBodyComponentDiagnosticPrefix, "custom_inertia_off_diag", customInertiaO)
        || !ReadOptionalMetadataBoolField(file, value, s_RigidBodyComponentDiagnosticPrefix, "enable_sleep", c.enableSleep)
        || !ReadOptionalMetadataBoolField(file, value, s_RigidBodyComponentDiagnosticPrefix, "is_awake", c.isAwake)
        || !ReadOptionalMetadataBoolField(file, value, s_RigidBodyComponentDiagnosticPrefix, "is_bullet", c.isBullet)
        || !ReadOptionalMetadataBoolField(file, value, s_RigidBodyComponentDiagnosticPrefix, "is_enabled", c.isEnabled)
        || !ReadOptionalMetadataBoolField(file, value, s_RigidBodyComponentDiagnosticPrefix, "allow_fast_rotation", c.allowFastRotation)
        || !ReadOptionalMetadataBoolField(file, value, s_RigidBodyComponentDiagnosticPrefix, "enable_gyroscopic_torque", c.enableGyroscopicTorque)
        || !ReadOptionalMetadataBoolField(file, value, s_RigidBodyComponentDiagnosticPrefix, "drive_kinematic_from_transform", c.driveKinematicFromTransform))
        return MakeUnexpected(Failure());
    c.linearVelocity = f32x4(linVel, 0.0f);
    c.angularVelocity = f32x4(angVel, 0.0f);
    c.customCenterOfMass = f32x4(customCom, 0.0f);
    c.customInertiaDiag = f32x4(customInertiaD, 0.0f);
    c.customInertiaOffDiag = f32x4(customInertiaO, 0.0f);

    entry.component = c;
    if(!BuildComponentAssetFromEntry<RigidBodyComponentAsset, RigidBodyComponentCookEntry>(entry).has_value())
        return MakeUnexpected(Failure());
    return entry;
}

b8 IsAllowedColliderShapeMetadataField(in StringView key, in b8 allowExtraShapes){
    if(allowExtraShapes && (key == "extra_shapes" || key == "entity_tag"))
        return true;
    return
        key == "shape_type" || key == "center" || key == "center2" || key == "half_extents"
        || key == "local_rotation" || key == "local_rotation_euler" || key == "local_rotation_euler_degrees"
        || key == "radius" || key == "skin_radius" || key == "density" || key == "friction"
        || key == "restitution" || key == "rolling_resistance" || key == "tangent_speed"
        || key == "category_bits" || key == "mask_bits" || key == "group_index" || key == "user_data"
        || key == "is_box" || key == "is_sensor"
        || key == "enable_contact_events" || key == "enable_hit_events" || key == "enable_sensor_events"
        || key == "enable_pre_solve_events" || key == "invoke_contact_creation"
        || key == "hull_points" || key == "mesh_vertices" || key == "mesh_indices" || key == "mesh_asset"
    ;
}

Expected<ColliderShapeEntry> ParseColliderShapeEntryMap(in Path file, in MetascriptValue mapVal, in b8 allowExtraShapes){
    ColliderShapeEntry outEntry;
    if(!ValidateMetadataAssetFields(file, mapVal, s_ColliderComponentDiagnosticPrefix, lambda[in allowExtraShapes](in StringView k) -> b8{
        return IsAllowedColliderShapeMetadataField(k, allowExtraShapes);
    }))
        return MakeUnexpected(Failure());

    if(mapVal.hasField("shape_type")){
        const Expected<MetadataStringField> f = ReadMetadataStringField(file, mapVal, s_ColliderComponentDiagnosticPrefix, "shape_type", true);
        if(!f.has_value())
            return MakeUnexpected(Failure());
        if(f.value().text == "sphere") outEntry.shapeType = ShapeType::Sphere;
        else if(f.value().text == "capsule") outEntry.shapeType = ShapeType::Capsule;
        else if(f.value().text == "hull") outEntry.shapeType = ShapeType::Hull;
        else if(f.value().text == "mesh") outEntry.shapeType = ShapeType::Mesh;
        else{
            error("{} '{}': field 'shape_type' must be 'sphere', 'capsule', 'hull', or 'mesh'", s_ColliderComponentDiagnosticPrefix, file);
            return MakeUnexpected(Failure());
        }
    }

    VectorSingle center = VectorSingle(outEntry.center);
    VectorSingle center2 = VectorSingle(outEntry.center2);
    VectorSingle halfExtents = VectorSingle(outEntry.halfExtents);
    VectorSingle localRotation = VectorSingle(outEntry.localRotation);
    if(!ReadOptionalSceneFloat3Field(file, mapVal, s_ColliderComponentDiagnosticPrefix, "center", center)
        || !ReadOptionalSceneFloat3Field(file, mapVal, s_ColliderComponentDiagnosticPrefix, "center2", center2)
        || !ReadOptionalSceneFloat3Field(file, mapVal, s_ColliderComponentDiagnosticPrefix, "half_extents", halfExtents)
        || !ReadPhysicsOptionalRotationField(file, mapVal, s_ColliderComponentDiagnosticPrefix, "local_rotation", "local_rotation_euler", "local_rotation_euler_degrees", localRotation)
        || !ReadOptionalFiniteF32Field(file, mapVal, s_ColliderComponentDiagnosticPrefix, "radius", outEntry.radius)
        || !ReadOptionalFiniteF32Field(file, mapVal, s_ColliderComponentDiagnosticPrefix, "skin_radius", outEntry.skinRadius)
        || !ReadOptionalFiniteF32Field(file, mapVal, s_ColliderComponentDiagnosticPrefix, "density", outEntry.density)
        || !ReadOptionalFiniteF32Field(file, mapVal, s_ColliderComponentDiagnosticPrefix, "friction", outEntry.friction)
        || !ReadOptionalFiniteF32Field(file, mapVal, s_ColliderComponentDiagnosticPrefix, "restitution", outEntry.restitution)
        || !ReadOptionalFiniteF32Field(file, mapVal, s_ColliderComponentDiagnosticPrefix, "rolling_resistance", outEntry.rollingResistance)
        || !ReadOptionalFiniteF32Field(file, mapVal, s_ColliderComponentDiagnosticPrefix, "tangent_speed", outEntry.tangentSpeed)
        || !ReadPhysicsOptionalU32Field(file, mapVal, s_ColliderComponentDiagnosticPrefix, "category_bits", outEntry.categoryBits)
        || !ReadPhysicsOptionalU32Field(file, mapVal, s_ColliderComponentDiagnosticPrefix, "mask_bits", outEntry.maskBits)
        || !ReadOptionalI32Field(file, mapVal, s_ColliderComponentDiagnosticPrefix, "group_index", outEntry.groupIndex)
        || !ReadPhysicsOptionalU64Field(file, mapVal, s_ColliderComponentDiagnosticPrefix, "user_data", outEntry.userData)
        || !ReadOptionalMetadataBoolField(file, mapVal, s_ColliderComponentDiagnosticPrefix, "is_box", outEntry.isBox)
        || !ReadOptionalMetadataBoolField(file, mapVal, s_ColliderComponentDiagnosticPrefix, "is_sensor", outEntry.isSensor)
        || !ReadOptionalMetadataBoolField(file, mapVal, s_ColliderComponentDiagnosticPrefix, "enable_contact_events", outEntry.enableContactEvents)
        || !ReadOptionalMetadataBoolField(file, mapVal, s_ColliderComponentDiagnosticPrefix, "enable_hit_events", outEntry.enableHitEvents)
        || !ReadOptionalMetadataBoolField(file, mapVal, s_ColliderComponentDiagnosticPrefix, "enable_sensor_events", outEntry.enableSensorEvents)
        || !ReadOptionalMetadataBoolField(file, mapVal, s_ColliderComponentDiagnosticPrefix, "enable_pre_solve_events", outEntry.enablePreSolveEvents)
        || !ReadOptionalMetadataBoolField(file, mapVal, s_ColliderComponentDiagnosticPrefix, "invoke_contact_creation", outEntry.invokeContactCreation)
        || !ReadPhysicsFloat3ArrayField(file, mapVal, s_ColliderComponentDiagnosticPrefix, "hull_points", outEntry.hullPoints)
        || !ReadPhysicsFloat3ArrayField(file, mapVal, s_ColliderComponentDiagnosticPrefix, "mesh_vertices", outEntry.meshVertices)
        || !ReadPhysicsU32ArrayField(file, mapVal, s_ColliderComponentDiagnosticPrefix, "mesh_indices", outEntry.meshIndices))
        return MakeUnexpected(Failure());
    outEntry.center = f32x4(center, 0.0f);
    outEntry.center2 = f32x4(center2, 0.0f);
    outEntry.halfExtents = f32x4(halfExtents, 0.0f);
    outEntry.localRotation = f32x4(localRotation);

    if(mapVal.hasField("mesh_asset")){
        const Expected<MetadataStringField> meshText = ReadMetadataStringField(file, mapVal, s_ColliderComponentDiagnosticPrefix, "mesh_asset", true);
        if(!meshText.has_value())
            return MakeUnexpected(Failure());
        const Expected<AssetRef<Mesh>> meshRef = ParseReservedAssetRefText<Mesh>(file, s_ColliderComponentDiagnosticPrefix, "mesh_asset", meshText.value().text);
        if(!meshRef.has_value())
            return MakeUnexpected(Failure());
        outEntry.meshAsset = meshRef.value();
    }
    return outEntry;
}

Expected<ColliderComponentCookEntry> ParseColliderComponentCookMetadata(in Name virtualPath, in Path file, in MetascriptValue value){
    ColliderComponentCookEntry entry;
    if(!CheckMetadataAssetMap(file, value, s_ColliderComponentDiagnosticPrefix)
        || !AssignCookEntryVirtualPath(virtualPath, file, s_ColliderComponentDiagnosticPrefix, entry))
        return MakeUnexpected(Failure());

    const Expected<ColliderShapeEntry> primaryResult = ParseColliderShapeEntryMap(file, value, true);
    if(!primaryResult.has_value())
        return MakeUnexpected(Failure());
    in ColliderShapeEntry primary = primaryResult.value();

    ColliderComponent c;
    c.shapeType = primary.shapeType;
    c.center = primary.center;
    c.center2 = primary.center2;
    c.halfExtents = primary.halfExtents;
    c.localRotation = primary.localRotation;
    c.radius = primary.radius;
    c.skinRadius = primary.skinRadius;
    c.density = primary.density;
    c.friction = primary.friction;
    c.restitution = primary.restitution;
    c.rollingResistance = primary.rollingResistance;
    c.tangentSpeed = primary.tangentSpeed;
    c.categoryBits = primary.categoryBits;
    c.maskBits = primary.maskBits;
    c.groupIndex = primary.groupIndex;
    c.userData = primary.userData;
    c.isBox = primary.isBox;
    c.isSensor = primary.isSensor;
    c.enableContactEvents = primary.enableContactEvents;
    c.enableHitEvents = primary.enableHitEvents;
    c.enableSensorEvents = primary.enableSensorEvents;
    c.enablePreSolveEvents = primary.enablePreSolveEvents;
    c.invokeContactCreation = primary.invokeContactCreation;
    c.hullPoints = primary.hullPoints;
    c.meshVertices = primary.meshVertices;
    c.meshIndices = primary.meshIndices;
    c.meshAsset = primary.meshAsset;

    if(!ReadPhysicsOptionalNameField(file, value, s_ColliderComponentDiagnosticPrefix, "entity_tag", c.entityTag))
        return MakeUnexpected(Failure());

    if(value.hasField("extra_shapes")){
        b8 extrasOk = true;
        value.visitField(
            "extra_shapes",
            lambda[in file, mut extrasOk, mut c](in MetascriptValue listVal) -> void{
                if(!listVal.isList()){
                    error("{} '{}': field 'extra_shapes' must be a list of collider maps", s_ColliderComponentDiagnosticPrefix, PathToString(file));
                    extrasOk = false;
                    return;
                }
                const Span<MetascriptValue> items = listVal.listView();
                c.extraShapes.clear();
                c.extraShapes.reserve(items.size());
                for(usize i = 0u; i < items.size(); ++i){
                    in MetascriptValue item = items[i];
                    if(!item.isMap()){
                        error("{} '{}': 'extra_shapes[{}]' must be a map", s_ColliderComponentDiagnosticPrefix, PathToString(file), i);
                        extrasOk = false;
                        return;
                    }
                    const Expected<ColliderShapeEntry> extra = ParseColliderShapeEntryMap(file, item, false);
                    if(!extra.has_value()){
                        extrasOk = false;
                        return;
                    }
                    c.extraShapes.push_back(extra.value());
                }
            }
        );
        if(!extrasOk)
            return MakeUnexpected(Failure());
    }

    entry.component = c;
    if(!BuildComponentAssetFromEntry<ColliderComponentAsset, ColliderComponentCookEntry>(entry).has_value())
        return MakeUnexpected(Failure());
    return entry;
}

b8 IsAllowedJointMetadataField(in StringView key){
    return
        key == "type" || key == "local_anchor_a" || key == "local_anchor_b"
        || key == "local_axis_a" || key == "local_axis_b"
        || key == "reference_rotation" || key == "reference_rotation_euler" || key == "reference_rotation_euler_degrees"
        || key == "use_reference_rotation" || key == "linear_offset"
        || key == "length" || key == "min_length" || key == "max_length"
        || key == "enable_limit" || key == "lower_limit" || key == "upper_limit"
        || key == "enable_motor" || key == "motor_speed" || key == "max_motor_force"
        || key == "enable_spring" || key == "hertz" || key == "damping_ratio"
        || key == "correction_factor" || key == "max_torque" || key == "swing_limit"
        || key == "suspension_hertz" || key == "suspension_damping_ratio"
        || key == "break_force" || key == "break_torque" || key == "collide_connected"
        || key == "body_entity_a" || key == "body_entity_b" || key == "user_data"
    ;
}

Expected<JointComponentCookEntry> ParseJointComponentCookMetadata(in Name virtualPath, in Path file, in MetascriptValue value){
    JointComponentCookEntry entry;
    if(!CheckMetadataAssetMap(file, value, s_JointComponentDiagnosticPrefix)
        || !AssignCookEntryVirtualPath(virtualPath, file, s_JointComponentDiagnosticPrefix, entry)
        || !ValidateMetadataAssetFields(file, value, s_JointComponentDiagnosticPrefix, IsAllowedJointMetadataField))
        return MakeUnexpected(Failure());

    JointComponent j = entry.component;
    if(value.hasField("type")){
        const Expected<MetadataStringField> f = ReadMetadataStringField(file, value, s_JointComponentDiagnosticPrefix, "type", true);
        if(!f.has_value())
            return MakeUnexpected(Failure());
        if(f.value().text == "distance") j.type = JointType::Distance;
        else if(f.value().text == "spherical") j.type = JointType::Spherical;
        else if(f.value().text == "revolute") j.type = JointType::Revolute;
        else if(f.value().text == "prismatic") j.type = JointType::Prismatic;
        else if(f.value().text == "fixed") j.type = JointType::Fixed;
        else if(f.value().text == "motor") j.type = JointType::Motor;
        else if(f.value().text == "wheel") j.type = JointType::Wheel;
        else{
            error("{} '{}': field 'type' must be 'distance', 'spherical', 'revolute', 'prismatic', 'fixed', 'motor', or 'wheel'", s_JointComponentDiagnosticPrefix, file);
            return MakeUnexpected(Failure());
        }
    }

    VectorSingle anchorA = VectorSingle(j.localAnchorA);
    VectorSingle anchorB = VectorSingle(j.localAnchorB);
    VectorSingle axisA = VectorSingle(j.localAxisA);
    VectorSingle axisB = VectorSingle(j.localAxisB);
    VectorSingle refRot = VectorSingle(j.referenceRotation);
    VectorSingle linOff = VectorSingle(j.linearOffset);
    if(!ReadOptionalSceneFloat3Field(file, value, s_JointComponentDiagnosticPrefix, "local_anchor_a", anchorA)
        || !ReadOptionalSceneFloat3Field(file, value, s_JointComponentDiagnosticPrefix, "local_anchor_b", anchorB)
        || !ReadOptionalSceneFloat3Field(file, value, s_JointComponentDiagnosticPrefix, "local_axis_a", axisA)
        || !ReadOptionalSceneFloat3Field(file, value, s_JointComponentDiagnosticPrefix, "local_axis_b", axisB)
        || !ReadPhysicsOptionalRotationField(file, value, s_JointComponentDiagnosticPrefix, "reference_rotation", "reference_rotation_euler", "reference_rotation_euler_degrees", refRot)
        || !ReadOptionalMetadataBoolField(file, value, s_JointComponentDiagnosticPrefix, "use_reference_rotation", j.useReferenceRotation)
        || !ReadOptionalSceneFloat3Field(file, value, s_JointComponentDiagnosticPrefix, "linear_offset", linOff)
        || !ReadOptionalFiniteF32Field(file, value, s_JointComponentDiagnosticPrefix, "length", j.length)
        || !ReadOptionalFiniteF32Field(file, value, s_JointComponentDiagnosticPrefix, "min_length", j.minLength)
        || !ReadOptionalFiniteF32Field(file, value, s_JointComponentDiagnosticPrefix, "max_length", j.maxLength)
        || !ReadOptionalMetadataBoolField(file, value, s_JointComponentDiagnosticPrefix, "enable_limit", j.enableLimit)
        || !ReadOptionalFiniteF32Field(file, value, s_JointComponentDiagnosticPrefix, "lower_limit", j.lowerLimit)
        || !ReadOptionalFiniteF32Field(file, value, s_JointComponentDiagnosticPrefix, "upper_limit", j.upperLimit)
        || !ReadOptionalMetadataBoolField(file, value, s_JointComponentDiagnosticPrefix, "enable_motor", j.enableMotor)
        || !ReadOptionalFiniteF32Field(file, value, s_JointComponentDiagnosticPrefix, "motor_speed", j.motorSpeed)
        || !ReadOptionalFiniteF32Field(file, value, s_JointComponentDiagnosticPrefix, "max_motor_force", j.maxMotorForce)
        || !ReadOptionalMetadataBoolField(file, value, s_JointComponentDiagnosticPrefix, "enable_spring", j.enableSpring)
        || !ReadOptionalFiniteF32Field(file, value, s_JointComponentDiagnosticPrefix, "hertz", j.hertz)
        || !ReadOptionalFiniteF32Field(file, value, s_JointComponentDiagnosticPrefix, "damping_ratio", j.dampingRatio)
        || !ReadOptionalFiniteF32Field(file, value, s_JointComponentDiagnosticPrefix, "correction_factor", j.correctionFactor)
        || !ReadOptionalFiniteF32Field(file, value, s_JointComponentDiagnosticPrefix, "max_torque", j.maxTorque)
        || !ReadOptionalFiniteF32Field(file, value, s_JointComponentDiagnosticPrefix, "swing_limit", j.swingLimit)
        || !ReadOptionalFiniteF32Field(file, value, s_JointComponentDiagnosticPrefix, "suspension_hertz", j.suspensionHertz)
        || !ReadOptionalFiniteF32Field(file, value, s_JointComponentDiagnosticPrefix, "suspension_damping_ratio", j.suspensionDampingRatio)
        || !ReadOptionalFiniteF32Field(file, value, s_JointComponentDiagnosticPrefix, "break_force", j.breakForce)
        || !ReadOptionalFiniteF32Field(file, value, s_JointComponentDiagnosticPrefix, "break_torque", j.breakTorque)
        || !ReadOptionalMetadataBoolField(file, value, s_JointComponentDiagnosticPrefix, "collide_connected", j.collideConnected)
        || !ReadPhysicsOptionalNameField(file, value, s_JointComponentDiagnosticPrefix, "body_entity_a", j.bodyEntityNameA)
        || !ReadPhysicsOptionalNameField(file, value, s_JointComponentDiagnosticPrefix, "body_entity_b", j.bodyEntityNameB)
        || !ReadPhysicsOptionalU64Field(file, value, s_JointComponentDiagnosticPrefix, "user_data", j.userData))
        return MakeUnexpected(Failure());
    j.localAnchorA = f32x4(anchorA, 0.0f);
    j.localAnchorB = f32x4(anchorB, 0.0f);
    j.localAxisA = f32x4(axisA, 0.0f);
    j.localAxisB = f32x4(axisB, 0.0f);
    j.referenceRotation = f32x4(refRot);
    j.linearOffset = f32x4(linOff, 0.0f);

    entry.component = j;
    if(!BuildComponentAssetFromEntry<JointComponentAsset, JointComponentCookEntry>(entry).has_value())
        return MakeUnexpected(Failure());
    return entry;
}

b8 IsAllowedPhysicsWorldConfigMetadataField(in StringView key){
    return
        key == "gravity" || key == "restitution_threshold" || key == "hit_event_threshold"
        || key == "contact_hertz" || key == "contact_damping_ratio" || key == "max_linear_velocity"
        || key == "fixed_delta_time" || key == "sub_step_count" || key == "max_sub_steps_per_frame"
        || key == "backend_mode" || key == "gpu_dispatch_threshold" || key == "gpu_workload_fraction"
        || key == "enable_sleep" || key == "enable_continuous" || key == "enable_contact_softening"
        || key == "enable_warm_starting" || key == "paused"
    ;
}

Expected<PhysicsWorldConfigComponentCookEntry> ParsePhysicsWorldConfigComponentCookMetadata(in Name virtualPath, in Path file, in MetascriptValue value){
    PhysicsWorldConfigComponentCookEntry entry;
    if(!CheckMetadataAssetMap(file, value, s_PhysicsWorldConfigComponentDiagnosticPrefix)
        || !AssignCookEntryVirtualPath(virtualPath, file, s_PhysicsWorldConfigComponentDiagnosticPrefix, entry)
        || !ValidateMetadataAssetFields(file, value, s_PhysicsWorldConfigComponentDiagnosticPrefix, IsAllowedPhysicsWorldConfigMetadataField))
        return MakeUnexpected(Failure());

    PhysicsWorldConfigComponent w = entry.component;
    if(value.hasField("backend_mode")){
        const Expected<MetadataStringField> f = ReadMetadataStringField(file, value, s_PhysicsWorldConfigComponentDiagnosticPrefix, "backend_mode", true);
        if(!f.has_value())
            return MakeUnexpected(Failure());
        if(f.value().text == "auto") w.backendMode = PhysicsBackendMode::Auto;
        else if(f.value().text == "cpu_only") w.backendMode = PhysicsBackendMode::CpuOnly;
        else if(f.value().text == "gpu_preferred") w.backendMode = PhysicsBackendMode::GpuPreferred;
        else{
            error("{} '{}': field 'backend_mode' must be 'auto', 'cpu_only', or 'gpu_preferred'", s_PhysicsWorldConfigComponentDiagnosticPrefix, file);
            return MakeUnexpected(Failure());
        }
    }

    VectorSingle grav = VectorSingle(w.gravity);
    if(!ReadOptionalSceneFloat3Field(file, value, s_PhysicsWorldConfigComponentDiagnosticPrefix, "gravity", grav)
        || !ReadOptionalFiniteF32Field(file, value, s_PhysicsWorldConfigComponentDiagnosticPrefix, "restitution_threshold", w.restitutionThreshold)
        || !ReadOptionalFiniteF32Field(file, value, s_PhysicsWorldConfigComponentDiagnosticPrefix, "hit_event_threshold", w.hitEventThreshold)
        || !ReadOptionalFiniteF32Field(file, value, s_PhysicsWorldConfigComponentDiagnosticPrefix, "contact_hertz", w.contactHertz)
        || !ReadOptionalFiniteF32Field(file, value, s_PhysicsWorldConfigComponentDiagnosticPrefix, "contact_damping_ratio", w.contactDampingRatio)
        || !ReadOptionalFiniteF32Field(file, value, s_PhysicsWorldConfigComponentDiagnosticPrefix, "max_linear_velocity", w.maxLinearVelocity)
        || !ReadOptionalFiniteF32Field(file, value, s_PhysicsWorldConfigComponentDiagnosticPrefix, "fixed_delta_time", w.fixedDeltaTime)
        || !ReadPhysicsOptionalU32Field(file, value, s_PhysicsWorldConfigComponentDiagnosticPrefix, "sub_step_count", w.subStepCount)
        || !ReadPhysicsOptionalU32Field(file, value, s_PhysicsWorldConfigComponentDiagnosticPrefix, "max_sub_steps_per_frame", w.maxSubStepsPerFrame)
        || !ReadPhysicsOptionalU32Field(file, value, s_PhysicsWorldConfigComponentDiagnosticPrefix, "gpu_dispatch_threshold", w.gpuDispatchThreshold)
        || !ReadOptionalFiniteF32Field(file, value, s_PhysicsWorldConfigComponentDiagnosticPrefix, "gpu_workload_fraction", w.gpuWorkloadFraction)
        || !ReadOptionalMetadataBoolField(file, value, s_PhysicsWorldConfigComponentDiagnosticPrefix, "enable_sleep", w.enableSleep)
        || !ReadOptionalMetadataBoolField(file, value, s_PhysicsWorldConfigComponentDiagnosticPrefix, "enable_continuous", w.enableContinuous)
        || !ReadOptionalMetadataBoolField(file, value, s_PhysicsWorldConfigComponentDiagnosticPrefix, "enable_contact_softening", w.enableContactSoftening)
        || !ReadOptionalMetadataBoolField(file, value, s_PhysicsWorldConfigComponentDiagnosticPrefix, "enable_warm_starting", w.enableWarmStarting)
        || !ReadOptionalMetadataBoolField(file, value, s_PhysicsWorldConfigComponentDiagnosticPrefix, "paused", w.paused))
        return MakeUnexpected(Failure());
    w.gravity = f32x4(grav, 0.0f);

    entry.component = w;
    if(!BuildComponentAssetFromEntry<PhysicsWorldConfigComponentAsset, PhysicsWorldConfigComponentCookEntry>(entry).has_value())
        return MakeUnexpected(Failure());
    return entry;
}

b8 IsAllowedPhysicsParentMetadataField(in StringView key){
    return key == "parent_entity" || key == "inherit_scale";
}

Expected<PhysicsParentComponentCookEntry> ParsePhysicsParentComponentCookMetadata(in Name virtualPath, in Path file, in MetascriptValue value){
    PhysicsParentComponentCookEntry entry;
    if(!CheckMetadataAssetMap(file, value, s_PhysicsParentComponentDiagnosticPrefix)
        || !AssignCookEntryVirtualPath(virtualPath, file, s_PhysicsParentComponentDiagnosticPrefix, entry)
        || !ValidateMetadataAssetFields(file, value, s_PhysicsParentComponentDiagnosticPrefix, IsAllowedPhysicsParentMetadataField))
        return MakeUnexpected(Failure());

    PhysicsParentComponent p = entry.component;
    if(!ReadPhysicsOptionalNameField(file, value, s_PhysicsParentComponentDiagnosticPrefix, "parent_entity", p.parentEntityName)
        || !ReadOptionalMetadataBoolField(file, value, s_PhysicsParentComponentDiagnosticPrefix, "inherit_scale", p.inheritScale))
        return MakeUnexpected(Failure());

    entry.component = p;
    if(!BuildComponentAssetFromEntry<PhysicsParentComponentAsset, PhysicsParentComponentCookEntry>(entry).has_value())
        return MakeUnexpected(Failure());
    return entry;
}


