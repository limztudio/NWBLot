        request.text = text;
        request.direction = direction;
        return this.m_layoutBuilder.layout(request);
    }
    public b8 adoptBuiltLayout(mut Expected<TextLayout, TextLayoutStatus> layout){ return this.m_view.adoptLayout(layout.value()); }
}

class UiNestedPopupBuilderTests : WidgetFixture{
    public PopupState m_parent;
    public PopupState m_child;
    public b8 m_beforeActivated = false;
    public b8 m_afterActivated = false;
    public b8 m_childActivated = false;

    public void setup(){
        this.setUpWidgetBase();
        this.m_parent.open();
        this.m_child.open();
    }
    public WidgetOptions controlOptions()const{ return this.controlOptions(120.0f); }
    public WidgetOptions controlOptions(in f32 width)const{ return MakeUiNestedPopupControlOptions(width); }
    public b8 beginParent(in u64 generation){
        return BeginUiNestedPopupBuilderParent(this, generation);
    }
    public b8 prepareButtons(in u64 generation){
        return PrepareUiNestedPopupBuilderButtons(this, generation);
    }
    public b8 acceptButtons(in u64 generation){
        return AcceptUiNestedPopupBuilderButtons(this, generation);
    }
}

class UiNestedPopupContextPopupDeclaration{
    public WidgetState owner;
    public WidgetState action;
    public PopupScope scope;


}

class UiNestedPopupContextTests : ContextTestFixture{


    public b8 begin(in u64 generation){
        return this.m_context.beginFrame(generation) && this.m_context.beginRoot(WidgetRoot(1401u, 1u));
    }
    public Expected<WidgetState> declareState(in StringView key, in WidgetKind kind){
        const auto declared = this.m_context.declare(key, kind);
        EXPECT_TRUE(declared.has_value());
        if(!declared.has_value())
            return MakeUnexpected(Failure());
        return declared.value();
    }
    public Expected<UiNestedPopupContextPopupDeclaration> reserve(in StringView key){ return this.reserve(key, Rect(60.0f, 40.0f, 120.0f, 80.0f)); }
    public Expected<UiNestedPopupContextPopupDeclaration> reserve(in StringView key, in Rect bounds){
        UiNestedPopupContextPopupDeclaration result;
        const auto owner = this.m_context.declare(key, WidgetKind::Popup);
        EXPECT_TRUE(owner.has_value());
        if(!owner.has_value())
            return MakeUnexpected(owner.error());
        result.owner = owner.value();
        result.scope.token = PopupToken(owner.value().id, owner.value().declarationGeneration, 900u, 1u);
        result.scope.bounds = bounds;
        result.scope.viewport = Rect(0.0f, 0.0f, 400.0f, 300.0f);
        result.scope.parent = this.m_context.popupToken();
        EXPECT_TRUE(this.m_context.registerPopupScope(result.owner, result.scope));
        const auto action = this.m_context.declarePart(result.owner, "action", WidgetKind::Button);
        EXPECT_TRUE(action.has_value());
        if(!action.has_value())
            return MakeUnexpected(action.error());
        result.action = action.value();
        return result;
    }
    public b8 publish(in UiNestedPopupContextPopupDeclaration popup){
        return PublishUiNestedPopupDeclaration(this, popup);
    }
    public b8 finish(){
        return this.m_context.endRoot() && this.m_context.finishFrame();
    }
}

class UiNestedPopupLifetimeTests : SearchFixture{
    public PopupState m_parent;
    public PopupState m_child;
    public Array<PopupState, 4u> m_deeper;
    public ComboState m_childCombo;
    public ContextMenuState m_menu;
    public PopupToolsSource m_menuSource;
    public ContextMenuResult m_menuResult;
    public b8 m_childVisible = false;

    public void setup(){
        SetUpSearchFixture(this);
        this.m_source.count = 5u;
        this.m_searchSource.full.count = 5u;
        this.m_parent.open();
        this.m_child.open();
        for(mut PopupState state : this.m_deeper)
            state.open();
    }
    public WidgetId fieldId()const{ return RequireUiWidgetId(this.parentId(), s_ComboKey); }
    public WidgetId menuRows()const{ return RequireUiWidgetId(RequireUiWidgetId(this.parentId(), s_MenuKey), "rows"); }
    public b8 beginParent(in u64 generation){
        return BeginUiNestedPopupLifetimeParent(this, generation);
    }
    public b8 finishParent(in u64 generation){
        return FinishUiNestedPopupLifetimeParent(this, generation);
    }
    public b8 acceptPlain(in u64 generation){
        return AcceptUiNestedPopupLifetimePlain(this, generation);
    }
    public b8 acceptCombo(in u64 generation){
        return AcceptUiNestedPopupLifetimeCombo(this, generation);
    }
    public b8 acceptSearch(in u64 generation){
        return AcceptUiNestedPopupLifetimeSearch(this, generation);
    }
    public b8 acceptMenu(in u64 generation){
        return AcceptUiNestedPopupLifetimeMenu(this, generation);
    }
    public b8 declareReserved(in u64 generation, in b8 overflow){
        return DeclareUiNestedPopupLifetimeReserved(this, generation, overflow);
    }
    public void reopenParent(){ this.m_parent.close(); this.m_parent.open(); }
    public void expectParentControls()const{
        ExpectUiNestedPopupLifetimeParentControls(this);
    }
}

class UiMultilineTextExpectationCase{
    public StringView source;
    public StringView expected;

    public UiMultilineTextExpectationCase(){
        this.source = "";
        this.expected = "";
    }

    public UiMultilineTextExpectationCase(in StringView inSource, in StringView inExpected){
        this.source = inSource;
        this.expected = inExpected;
    }
}


