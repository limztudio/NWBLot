void VerifyListMeasureKey_PreservesEffectiveLanguageLength(){
    const auto embedded = TryBuildListMeasureKey(0u, 0u, 0u, 0u, 0u, 1.0f, DisplayMetrics(), SelectableMetrics(), 0u, StringView("en\0zz", 5u), TextDirection::LeftToRight);
    ASSERT_TRUE(embedded.has_value());
    EXPECT_EQ(embedded.value().languageLength, 2u);
    EXPECT_EQ(embedded.value().language[3u], 'z');
    EXPECT_EQ(MakeUiMultilineByteView(Span<u8>(embedded.value().language).subspan(0u, embedded.value().languageLength)), "en");
    const auto zero = TryBuildListMeasureKey(0u, 0u, 0u, 0u, 0u, 1.0f, DisplayMetrics(), SelectableMetrics(), 0u, StringView("\0x", 2u), TextDirection::LeftToRight);
    ASSERT_TRUE(zero.has_value());
    EXPECT_EQ(zero.value().languageLength, 0u);
    String longLanguage;
    for(usize index = 0u; index < 64u; ++index)
        longLanguage.push_back('a');
    const auto longest = TryBuildListMeasureKey(0u, 0u, 0u, 0u, 0u, 1.0f, DisplayMetrics(), SelectableMetrics(), 0u, StringView(longLanguage).substr(0u, 63u), TextDirection::LeftToRight);
    ASSERT_TRUE(longest.has_value());
    EXPECT_EQ(longest.value().languageLength, 63u);
    EXPECT_FALSE(TryBuildListMeasureKey(0u, 0u, 0u, 0u, 0u, 1.0f, DisplayMetrics(), SelectableMetrics(), 0u, StringView(longLanguage), TextDirection::LeftToRight).has_value());
}

NWB_ADHD_GTEST(ListMeasureKey, PreservesEffectiveLanguageLength, VerifyListMeasureKey_PreservesEffectiveLanguageLength)
