[[nodiscard]] FOUNDATION_INLINE b8 KernelTokenMatchesTimingKeyQueue(const KernelQueueSubmissionToken& token, const KernelGpuTaskTimingKey& key)noexcept{
    return token.queue == key.queue;
}

[[nodiscard]] FOUNDATION_INLINE b8 InspectCompiledPacketForQueue(
    const KernelGpuCompiledGraphReadView& plan,
    const KernelGpuRecordedGraph& recordedGraph,
    const usize packetIndex,
    const KernelGpuPhysicalQueueId& queueId,
    b8& outMatchesQueue,
    b8& outHasRecordedWorker,
    u32& outWorkerDomain,
    u32& outWorkerIndex
)noexcept{
    outMatchesQueue = false;
    outHasRecordedWorker = false;
    outWorkerDomain = 0u;
    outWorkerIndex = 0u;
    const Core::GpuSubmissionPacketId packet = plan.packetIdAt(packetIndex);
    const Core::GpuCompiledPacketView packetView = plan.packet(packet);
    if(!packetView.valid())
        return false;
    if(packetView.plan->queue != queueId)
        return true;
    outMatchesQueue = true;
    const Optional<Core::GpuRecordedPacket> recordedPacket = recordedGraph.packetSnapshot(packet);
    if(!recordedPacket.has_value())
        return true;
    outHasRecordedWorker = true;
    outWorkerDomain = recordedPacket->recordingWorkerDomain;
    outWorkerIndex = recordedPacket->recordingWorkerIndex;
    return true;
}


