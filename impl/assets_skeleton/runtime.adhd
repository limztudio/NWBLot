#include <impl/assets_skeleton/asset.adhd>
#include <impl/assets_skeleton/joint_validation.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateSkeletonRuntimePayload(
    in b8 hasValidVirtualPath,
    in Span<SkeletonJoint> joints,
    in HashMap<Name, u32> jointIndices,
    mut Vector<u8> scratchNamedJoints
){
    if(!hasValidVirtualPath)
        return false;
    return ValidateSkeletonPayloadData(joints, jointIndices, scratchNamedJoints);
}

b8 Skeleton::validatePayload(mut ScratchArena scratchArena)const{
    Vector<u8> namedJoints(this.m_joints.size(), 0u);
    return ValidateSkeletonRuntimePayload(
        this.checkVirtualPath("Skeleton::validatePayload"),
        Span<SkeletonJoint>(this.m_joints),
        this.m_jointIndices,
        namedJoints
    );
}

b8 Skeleton::loadBinary(in Span<u8> binary){
    ScratchArena scratchArena(s_AssetsSkeletonLoadBinaryArena);
    Skeleton candidate(this.virtualPath());
    if(!DeserializeSkeletonBinaryPayload(binary, candidate.m_joints, candidate.m_jointIndices))
        return false;
    if(!candidate.validatePayload(scratchArena))
        return false;
    this = candidate;
    return true;
}


