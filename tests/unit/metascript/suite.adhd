void VerifyAdhdCompiler_EnforcesArenaAttributeConflictsAndPropagatesMotherArenaAcrossNestedAndGenericClasses(){
    AdhdTestArena arena = AdhdTestArena();

    CompileResult res = CompileResult(arena.arena);
    ASSERT_TRUE(Compile(s_SuiteMotherArenaHierarchyAndGenericSpecSource, "impl/sim/mother_arena_edge.adhd", arena.arena, res));
    const StringView hdrView = GeneratedHeaderView(res);

    const usize leafPos = hdrView.find("class LeafChild final{");
    const usize midPos = hdrView.find("class MidChild final{");
    const usize podSpecPos = hdrView.find("template<>\r\nclass Holder<u32> final{");
    const usize strSpecPos = hdrView.find("template<>\r\nclass Holder<AString<::ArenaBase>> final{");
    const usize rootPos = hdrView.find("class RootOwner final{");
    const usize moveOnlyPos = hdrView.find("class MoveOnlyChild final{");
    ASSERT_NE(leafPos, usize.max);
    ASSERT_NE(midPos, usize.max);
    ASSERT_NE(podSpecPos, usize.max);
    ASSERT_NE(strSpecPos, usize.max);
    ASSERT_NE(rootPos, usize.max);
    ASSERT_NE(moveOnlyPos, usize.max);

    const StringView leafSlice = hdrView.substr(leafPos, midPos - leafPos);
    const StringView midSlice = hdrView.substr(midPos, podSpecPos - midPos);
    const StringView podSpecSlice = hdrView.substr(podSpecPos, strSpecPos - podSpecPos);
    const StringView strSpecSlice = hdrView.substr(strSpecPos, rootPos - strSpecPos);
    const StringView rootSlice = hdrView.substr(rootPos, moveOnlyPos - rootPos);
    const StringView moveOnlySlice = hdrView.substr(moveOnlyPos);

    EXPECT_NE(leafSlice.find("using uses_leading_arena_t = ::ArenaBase;"), usize.max);
    EXPECT_EQ(leafSlice.find("s_ClassArena"), usize.max);
    EXPECT_NE(midSlice.find("using uses_leading_arena_t = ::ArenaBase;"), usize.max);
    EXPECT_EQ(midSlice.find("s_ClassArena"), usize.max);
    EXPECT_EQ(podSpecSlice.find("__adhd_arena"), usize.max);
    EXPECT_NE(strSpecSlice.find("using uses_leading_arena_t = ::ArenaBase;"), usize.max);
    EXPECT_NE(rootSlice.find("s_ClassArena"), usize.max);
    EXPECT_EQ(rootSlice.find("uses_leading_arena_t"), usize.max);
    EXPECT_NE(moveOnlySlice.find("MoveOnlyChild(const MoveOnlyChild&) = delete;"), usize.max);
    EXPECT_NE(moveOnlySlice.find("MoveOnlyChild(MoveOnlyChild&&)noexcept = default;"), usize.max);

    ExpectCompileFails(arena, "[arena, serialize]\r\nclass BadArenaSer {\r\n    public u32 x = 0u;\r\n}\r\n", "impl/sim/bad_arena_ser.adhd");
    ExpectCompileFails(arena, "[arena, asset(\"tex\")]\r\nclass TexAsset {\r\n    public u32 w = 0u;\r\n}\r\n[subsystem(\"bad_sub\")]\r\nclass BadNoArenaSub {\r\n    public AssetRef<TexAsset> tex;\r\n}\r\n", "impl/sim/bad_no_arena_sub.adhd");
    ExpectCompileFails(arena, "[component(\"bad_comp\")]\r\nclass BadNoArenaComp {\r\n    public String tag = \"bad\";\r\n}\r\n", "impl/sim/bad_no_arena_comp.adhd");
    ExpectCompileFails(arena, "[arena, component_asset(\"retired_comp\")]\r\nclass BadRetiredCompAsset {\r\n    public u32 x = 0u;\r\n}\r\n", "impl/sim/bad_retired_comp_asset.adhd");
}

void VerifyAdhdCompiler_ResolvesCoreAndGlobalExportsShadowingAbstractInterfacesMatrixPackingAndHeaderOrder(){
    AdhdTestArena arena = AdhdTestArena();

    CompileResult res = CompileResult(arena.arena);
    ASSERT_TRUE(Compile(s_SuiteCoreGlobalExportsShadowAndLayoutSource, "impl/sim/core_global_exports.adhd", arena.arena, res));

    const StringView hdrView = GeneratedHeaderView(res);

    const usize sha1HdrPos = hdrView.find("#include <global/sha1.h>");
    const usize allocGlobalPos = hdrView.find("#include <core/alloc/global.h>");
    const usize entityIdPos = hdrView.find("#include <core/ecs/entity_id.h>");
    const usize fsHdrPos = hdrView.find("#include <core/filesystem/filesystem.h>");
    const usize resHdrPos = hdrView.find("#include <core/graphics/rhi/resource.h>");
    const usize implGlobalPos = hdrView.find("#include <impl/global.adhd.h>");
    ASSERT_NE(sha1HdrPos, usize.max);
    ASSERT_NE(allocGlobalPos, usize.max);
    ASSERT_NE(entityIdPos, usize.max);
    ASSERT_NE(fsHdrPos, usize.max);
    ASSERT_NE(resHdrPos, usize.max);
    ASSERT_NE(implGlobalPos, usize.max);
    EXPECT_LT(sha1HdrPos, allocGlobalPos);
    EXPECT_LT(entityIdPos, fsHdrPos);
    EXPECT_LT(entityIdPos, resHdrPos);
    EXPECT_LT(fsHdrPos, implGlobalPos);
    EXPECT_LT(resHdrPos, implGlobalPos);
    EXPECT_EQ(hdrView.find("#include <core/graphics/rhi/primitives.h>"), usize.max);
    EXPECT_EQ(hdrView.find("#include <core/graphics/rhi/format.h>"), usize.max);

    ASSERT_EQ(UnitClassCount(res), 4u);
    EXPECT_EQ(UnitClassName(res, 1u), "PackedUnalignedMat");
    EXPECT_EQ(UnitClassTotalAlign(res, 1u), 1u);
    EXPECT_EQ(UnitClassTotalSize(res, 1u), 65u);

    const usize packedMatPos = hdrView.find("class PackedUnalignedMat final{");
    const usize alignedBoundsPos = hdrView.find("class AlignedBoundsPacket final{");
    const usize handlerPos = hdrView.find("class CustomInputHandler final : public ::NWB::Core::IInputEventHandler{");
    ASSERT_NE(packedMatPos, usize.max);
    ASSERT_NE(alignedBoundsPos, usize.max);
    ASSERT_NE(handlerPos, usize.max);
    EXPECT_NE(hdrView.find("#include <core/input/input_event.h>"), usize.max);
    EXPECT_NE(hdrView.substr(0u, alignedBoundsPos).find("#pragma pack(push, 1)"), usize.max);
    EXPECT_EQ(hdrView.substr(alignedBoundsPos).find("#pragma pack(push, 1)"), usize.max);

    EXPECT_NE(hdrView.find("::DirectoryEntry<::ArenaBase> entry = ::DirectoryEntry<::ArenaBase>(entryPath);"), usize.max);
    EXPECT_NE(hdrView.find("::LoadFloat(srcMat)"), usize.max);
    EXPECT_NE(hdrView.find("::StoreFloat(reg, dstMat);"), usize.max);
    EXPECT_NE(hdrView.find("::ComputeSha1(([](const auto& __adhd_bytes)"), usize.max);
    EXPECT_NE(hdrView.find("::NWB::Core::Alloc::PersistentArena::StructureAlignedSize(64u)"), usize.max);
    EXPECT_NE(hdrView.find("::NWB::Core::DescriptorWriteItem::None()"), usize.max);
    EXPECT_NE(hdrView.find("::Sha1Digest::s_HexTextLength"), usize.max);
    EXPECT_NE(hdrView.find("::NWB::Core::BufferRange::s_AllBytes"), usize.max);
    EXPECT_NE(hdrView.find("::MatrixIdentity<Float34>()"), usize.max);
    EXPECT_NE(hdrView.find("::MatrixIdentity()"), usize.max);
    EXPECT_NE(hdrView.find("::VectorIsFinite(decomp.scale, ::VectorComponentMask::s_XYZ)"), usize.max);

    ExpectCompileFails(arena, "void BadAbstractLocal() {\r\n    IFilesystem fs = IFilesystem();\r\n}\r\n", "impl/sim/bad_abs_local.adhd");
    ExpectCompileFails(arena, "class BadAbstractField {\r\n    public IFilesystem fs;\r\n}\r\n", "impl/sim/bad_abs_field.adhd");
    ExpectCompileFails(arena, "IFilesystem BadAbstractRet(in IFilesystem fs) {\r\n    return fs;\r\n}\r\n", "impl/sim/bad_abs_ret.adhd");
    ExpectCompileFails(arena, "void BadAbstractMut(in IFilesystem fs) {\r\n    fs.flush();\r\n}\r\n", "impl/sim/bad_abs_mut.adhd");
    ExpectCompileFails(arena, "void BadEnumBitwise() {\r\n    auto m = TelemetryCaptureFlag::None | TelemetryCaptureFlag::TextLog;\r\n}\r\n", "impl/sim/bad_enum_bit.adhd");
    ExpectCompileFails(arena, "class BadSimdStructField {\r\n    public MatrixDecomposition decomp = MatrixDecomposition();\r\n}\r\n", "impl/sim/bad_simd_fld.adhd");
    ExpectCompileFails(arena, "void BadSimdStructVec() {\r\n    Vector<MatrixDecomposition> list;\r\n}\r\n", "impl/sim/bad_simd_vec.adhd");
    ExpectCompileFails(arena, "class BadBorrowWriterField {\r\n    public StagedFileWriter writer;\r\n}\r\n", "impl/sim/bad_borrow_writer.adhd");
    ExpectCompileFails(arena, "class BadPodBase : BoundingBox {\r\n    public u32 x = 0u;\r\n}\r\n", "impl/sim/bad_pod_base.adhd");
    ExpectCompileFails(arena, "b8 BadMissingTypeArg() {\r\n    return CanRepresentU64(7u);\r\n}\r\n", "impl/sim/bad_no_targ.adhd");
    ExpectCompileFails(arena, "u32 BadScopedMember() {\r\n    return Sha1Digest::s_NoSuchConstant;\r\n}\r\n", "impl/sim/bad_scoped_const.adhd");
}

void VerifyAdhdCompiler_ResolvesHandleDerefRhiAndAssetExports(){
    AdhdTestArena arena = AdhdTestArena();

    CompileResult res = CompileResult(arena.arena);
    ASSERT_TRUE(Compile(s_SuiteHandleDerefRhiAndAssetExportsSource, "impl/sim/handle_deref_rhi_assets.adhd", arena.arena, res));

    const StringView srcView = GeneratedSourceView(res);
    const StringView hdrView = GeneratedHeaderView(res);
    EXPECT_NE(hdrView.find("#include <core/graphics/shader_archive.h>"), usize.max);
    EXPECT_NE(hdrView.find("#include <core/assets/bunch/cook.h>"), usize.max);
    EXPECT_NE(srcView.find("buf.deref()"), usize.max);
    EXPECT_NE(srcView.find("assetPtr.deref()"), usize.max);
    EXPECT_NE(srcView.find("rcAsset.deref()"), usize.max);
    EXPECT_NE(srcView.find("::NWB::Core::DerefFramebufferPtr((rt.getFramebuffer(0u)))"), usize.max);
    EXPECT_NE(srcView.find("::NWB::Core::DescriptorWriteItem::TextureSrv(0u, tex.deref())"), usize.max);
    EXPECT_NE(srcView.find("srv.setDimension(::NWB::Core::TextureDimension::Texture2D)"), usize.max);
    EXPECT_NE(srcView.find("::NWB::Core::ShaderArchive::DeserializeIndex(devArena, ([](const auto& __adhd_bytes)"), usize.max);
    EXPECT_NE(srcView.find("::NWB::Core::Assets::AssetsBunchCook::ExpandAssetBunchForAssetCook(bunchCtx)"), usize.max);

    ExpectCompileFails(arena, "void MutAsset(mut IAsset a) {}\r\nUniquePtr<IAsset> MakePtr() { return UniquePtr<IAsset>(); }\r\nvoid BadTempUniqueDeref() {\r\n    MutAsset(MakePtr().deref());\r\n}\r\n", "impl/sim/bad_tmp_unique_deref.adhd");
    ExpectCompileFails(arena, "void MutAsset(mut IAsset a) {}\r\nRefCountPtr<IAsset> MakeRc() { return RefCountPtr<IAsset>(); }\r\nvoid BadTempRcDeref() {\r\n    MutAsset(MakeRc().deref());\r\n}\r\n", "impl/sim/bad_tmp_rc_deref.adhd");
    ExpectCompileFails(arena, "void MutBuf(mut Buffer b) {}\r\nBufferHandle MakeBuf() { return BufferHandle(); }\r\nvoid BadTempHandleDeref() {\r\n    MutBuf(MakeBuf().deref());\r\n}\r\n", "impl/sim/bad_tmp_handle_deref.adhd");
    ExpectCompileFails(arena, "BufferHandle MakeBuf() { return BufferHandle(); }\r\nvoid BadTempWriteDeref() {\r\n    auto w = DescriptorWriteItem::StructuredBufferSrv(0u, MakeBuf().deref());\r\n}\r\n", "impl/sim/bad_tmp_write_deref.adhd");
    ExpectCompileFails(arena, "void BadTempWriteSetDim(mut TextureHandle tex) {\r\n    auto w = DescriptorWriteItem::TextureSrv(0u, tex.deref()).setDimension(TextureDimension::Texture2D);\r\n}\r\n", "impl/sim/bad_tmp_write_set_dim.adhd");
}

void VerifyAdhdCompiler_QualifiesCrossNamespaceImportsRespectingShadowing(){
    AdhdTestArena arena = AdhdTestArena();
    MockIncludeResolver resolver = MockIncludeResolver();

    CompileResult res = CompileResult(arena.arena);
    const b8 compiled = CompileWithResolver(s_SuiteCrossNamespaceImportSource, "impl/scene/cross_ns.adhd", resolver, arena.arena, res);
    EXPECT_GE(resolver.resolveCallCount, 2u);
    if(!compiled && !res.errors.empty())
        EXPECT_EQ(FirstErrorMessage(res), "");
    ASSERT_TRUE(compiled);

    const StringView hdrView = GeneratedHeaderView(res);
    const StringView srcView = GeneratedSourceView(res);
    EXPECT_NE(hdrView.find("::NWB::MockForeign::ForeignMode::Enum mode"), usize.max);
    EXPECT_NE(hdrView.find("::NWB::MockForeign::ForeignMode::Beta"), usize.max);
    EXPECT_NE(hdrView.find("::NWB::MockForeign::ForeignItem item{};"), usize.max);
    EXPECT_NE(hdrView.find("::NWB::MockForeign::kForeignCap"), usize.max);
    EXPECT_NE(hdrView.find("::NWB::MockForeign::ForeignMode::kCount"), usize.max);
    EXPECT_NE(hdrView.find("::NWB::MockForeign::ForeignAsset"), usize.max);
    EXPECT_NE(hdrView.find("::NWB::MockForeign::ForeignMode::parseNamedEnum"), usize.max);

    EXPECT_NE(srcView.find("::NWB::MockForeign::ForeignMode::Alpha"), usize.max);
    EXPECT_NE(srcView.find("::NWB::MockForeign::ForeignItem it = ::NWB::MockForeign::ForeignItem();"), usize.max);
    EXPECT_NE(srcView.find("::NWB::MockForeign::ForeignAsset::s_AssetTypeName"), usize.max);
    EXPECT_NE(srcView.find("((::NWB::MockForeign::ForeignFn(x) + kForeignConst) + ::NWB::MockForeign::kForeignOther) + kSameBridgeConst"), usize.max);
    EXPECT_EQ(srcView.find("::NWB::MockForeign::kForeignConst"), usize.max);
    EXPECT_EQ(srcView.find("::NWB::MockForeign::kSameBridgeConst"), usize.max);
}

void VerifyAdhdCompiler_ResolvesNestedTemplateReturnAssetFieldsAndDocumentVisitors(){
    AdhdTestArena arena = AdhdTestArena();

    CompileResult res = CompileResult(arena.arena);
    const b8 compiled = Compile(s_SuiteNestedTemplateAndDocumentVisitorSource, "impl/assets_test/nested_tpl.adhd", arena.arena, res);
    if(!compiled && !res.errors.empty())
        EXPECT_EQ(FirstErrorMessage(res), "");
    ASSERT_TRUE(compiled);

    const StringView hdrView = GeneratedHeaderView(res);
    EXPECT_NE(hdrView.find("#include <core/assets/metadata_fields.h>"), usize.max);
    EXPECT_NE(hdrView.find("#include <core/assets/manager.h>"), usize.max);
    EXPECT_NE(hdrView.find("Expected<::NWB::Core::Assets::AssetRef<MockNestedAsset>>"), usize.max);
    EXPECT_NE(hdrView.find("Expected<::UniquePtr<MockNestedAsset>>"), usize.max);
    EXPECT_NE(hdrView.find("::NWB::Core::Assets::ReadMetadataAssetRefField<MockNestedAsset>"), usize.max);
    EXPECT_NE(hdrView.find("::NWB::Core::Assets::LoadTypedAssetSync<MockNestedAsset>"), usize.max);
    EXPECT_NE(hdrView.find("docCtx.doc.visitVariable("), usize.max);
    EXPECT_NE(hdrView.find("assetVal.forEachMapEntry("), usize.max);
    EXPECT_NE(hdrView.find("assetVal.visitField("), usize.max);
    EXPECT_NE(hdrView.find("listVal.listView()"), usize.max);
    EXPECT_NE(hdrView.find("guard.release();"), usize.max);
}


