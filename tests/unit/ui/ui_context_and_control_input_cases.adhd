    ASSERT_TRUE(actionResult.has_value());
    EXPECT_EQ(actionResult.value().popup, scope.token);
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryDown, MakeUiContextPoint(55.0f, 55.0f))).pointerConsumed);
    self.m_router.closePopup(scope.token);
