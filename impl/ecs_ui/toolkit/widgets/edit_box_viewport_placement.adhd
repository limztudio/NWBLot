#include "edit_box_style.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<EditBoxPlacement> TryComputeEditBoxViewportPlacement(
    in Rect bounds,
    in Rect viewport,
    in Rect clip,
    in Point previousScroll,
    in f32 caretWidth,
    in b8 revealCaret,
    in EditTextMode textMode,
    in Rect visualBounds,
    in Point logicalSize,
    in Rect caretRect
){
    EditBoxPlacement placement;
    placement.bounds = bounds;
    placement.frameClip = IntersectUiRectsBounds(bounds, clip);
    placement.content = viewport;
    placement.clip = IntersectUiRectsBounds(viewport, clip);
    const f32 left = viewport.x;
    const f32 top = viewport.y;
    const VectorSingle zeroVec(0.0f);
    const VectorSingle scrollInputs(
        (visualBounds.x + visualBounds.width) - logicalSize.x,
        (visualBounds.width + caretWidth) - placement.content.width,
        0.0f,
        0.0f
    );
    const VectorSingle scrollMaxVec = VectorSelect(scrollInputs, zeroVec, VectorGreater(zeroVec, scrollInputs));
    const f32 overhangX = scrollMaxVec.x;
    const f32 maximumScroll = scrollMaxVec.y;
    const f32 caretEndX = ((caretRect.x - visualBounds.x) + caretWidth) + overhangX;
    if(!IsFinite(VectorSingle(maximumScroll, caretEndX, 0.0f, 0.0f)))
        return MakeUnexpected(Failure());
    f32 scrollX = 0.0f;
    if(previousScroll.x > 0.0f)
        scrollX = UiSimdMin(maximumScroll, previousScroll.x);
    if(revealCaret && caretRect.x < scrollX)
        scrollX = caretRect.x;
    if(revealCaret && caretEndX > scrollX + placement.content.width)
        scrollX = caretEndX - placement.content.width;
    if(scrollX > 0.0f)
        scrollX = UiSimdMin(maximumScroll, scrollX);
    else
        scrollX = 0.0f;
    placement.scroll = scrollX;
    if(textMode == EditTextMode::Multiline){
        const VectorSingle verticalInputs(
            (visualBounds.y + visualBounds.height) - logicalSize.y,
            visualBounds.height - placement.content.height,
            0.0f,
            0.0f
        );
        const VectorSingle verticalMaxVec = VectorSelect(verticalInputs, zeroVec, VectorGreater(zeroVec, verticalInputs));
        const f32 overhangY = verticalMaxVec.x;
        const f32 maximumScrollY = verticalMaxVec.y;
        const f32 caretEndY = ((caretRect.y - visualBounds.y) + caretRect.height) + overhangY;
        if(!IsFinite(VectorSingle(maximumScrollY, caretEndY, 0.0f, 0.0f)))
            return MakeUnexpected(Failure());
        f32 scrollY = 0.0f;
        if(previousScroll.y > 0.0f)
            scrollY = UiSimdMin(maximumScrollY, previousScroll.y);
        if(revealCaret && caretRect.y < scrollY)
            scrollY = caretRect.y;
        if(revealCaret && caretEndY > scrollY + placement.content.height)
            scrollY = caretEndY - placement.content.height;
        if(scrollY > 0.0f)
            scrollY = UiSimdMin(maximumScrollY, scrollY);
        else
            scrollY = 0.0f;
        placement.scrollY = scrollY;
        const VectorSingle origin = (VectorSingle(left, top, left, top) - VectorSingle(visualBounds.x, visualBounds.y, visualBounds.x, visualBounds.y)) - VectorSingle(scrollX, scrollY, scrollX, scrollY);
        placement.textOrigin = Point(origin.x, origin.y);
    }
    else{
        const f32 verticalOffset = UiSimdMax(0.0f, (placement.content.height - visualBounds.height) * s_RectCenterFraction);
        const VectorSingle base = VectorSingle(left, top, left, top) - VectorSingle(visualBounds.x, visualBounds.y, visualBounds.x, visualBounds.y);
        const VectorSingle origin(base.x - placement.scroll, base.y + verticalOffset, base.z - placement.scroll, base.w + verticalOffset);
        placement.textOrigin = Point(origin.x, origin.y);
    }
    const VectorSingle caretOrigin = VectorSingle(placement.textOrigin.x, placement.textOrigin.y, placement.textOrigin.x, placement.textOrigin.y) + VectorSingle(caretRect.x, caretRect.y, caretRect.x, caretRect.y);
    placement.caret = Rect(caretOrigin.x, caretOrigin.y, caretWidth, caretRect.height);
    return placement;
}

b8 ValidateEditBoxArrangedSegments(in EditBoxPlacement placement, in f32 caretWidth, in Rect selectionIn, in Rect preeditUnderlineIn, in b8 composing){
    Rect selection = selectionIn;
    Rect preeditUnderline = preeditUnderlineIn;
    if(selection.width > 0.0f){
        const VectorSingle selectionOrigin = VectorSingle(selection.x, selection.y, selection.x, selection.y) + VectorSingle(placement.textOrigin.x, placement.textOrigin.y, placement.textOrigin.x, placement.textOrigin.y);
        selection.x = selectionOrigin.x;
        selection.y = selectionOrigin.y;
    }
    if(composing)
        PlaceEditPreeditUnderline(placement.textOrigin, caretWidth, preeditUnderline);
    return IsValidUiRect(placement.caret) && IsValidUiRect(selection) && IsValidUiRect(preeditUnderline) && IsFinite(VectorSingle(placement.textOrigin.x, placement.textOrigin.y, 0.0f, 0.0f));
}

b8 IsValidEditBoxPaintStyle(in EditBoxStyle style){
    return IsValidPaintColor(style.background)
        && IsValidPaintColor(style.text)
        && IsValidPaintColor(style.disabledText)
        && IsValidPaintColor(style.placeholderText)
        && IsValidPaintColor(style.selection)
        && IsValidPaintColor(style.inactiveSelection)
        && IsValidPaintColor(style.caret)
        && IsValidPaintColor(style.preedit)
        && IsValidPaintColor(style.preeditTarget)
        && IsValidPaintColor(style.preeditConverted);
}

Name ResolvePreferredEditBoxBackgroundName(in EditBoxStyle style, in EditBoxPaintFlags flags){
    if(!flags.enabled)
        return style.disabled;
    if(flags.focused)
        return style.focused;
    if(flags.hovered)
        return style.hover;
    return style.normal;
}

Expected<b8> ValidateTextAreaNavigationInputs(
    in EditTextMode textMode,
    in b8 compositionActive,
    in EditNavigationDirection direction,
    in f32 fontSize,
    in f32 viewportHeight,
    in EditNavigationSnapshot preferred
){
    const b8 page = direction == EditNavigationDirection::PageUp || direction == EditNavigationDirection::PageDown;
    if(
        textMode != EditTextMode::Multiline
        || compositionActive
        || cast<u8>(direction) > cast<u8>(EditNavigationDirection::PageDown)
        || !IsFinite(VectorSingle(fontSize))
        || fontSize <= 0.0f
        || !IsFinite(VectorSingle(viewportHeight))
        || viewportHeight < 0.0f
        || (page && viewportHeight == 0.0f)
        || !IsFinite(VectorDouble(cast<f64>(preferred.preferredX)))
    )
        return MakeUnexpected(Failure());
    return page;
}

Expected<f32> TryResolveTextAreaPreferredX(in EditNavigationSnapshot preferred, in Rect caret){
    f32 outPreferredX = caret.x;
    if(preferred.valid)
        outPreferredX = preferred.preferredX;
    if(!IsFinite(VectorDouble(cast<f64>(outPreferredX))))
        return MakeUnexpected(Failure());
    return outPreferredX;
}

b8 ShouldPaintEditBoxCaret(in EditBoxPaintFlags flags, in b8 composing){
    if(!flags.focused || !flags.enabled || flags.readOnly)
        return false;
    if(composing)
        return flags.preeditCaretVisible;
    return flags.caretVisible;
}

void OffsetEditBoxSegmentOrigin(in Point textOrigin, mut Rect inOutSegment){
    const VectorSingle origin = VectorSingle(inOutSegment.x, inOutSegment.y, inOutSegment.x, inOutSegment.y) + VectorSingle(textOrigin.x, textOrigin.y, textOrigin.x, textOrigin.y);
    inOutSegment.x = origin.x;
    inOutSegment.y = origin.y;
}


