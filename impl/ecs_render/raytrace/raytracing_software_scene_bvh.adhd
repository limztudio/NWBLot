// limztudio@gmail.com
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/raytrace/raytrace_internal.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const usize s_SoftwareSceneRefitInstanceGpuByteSize = 64u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SoftwareSceneBvhValidationPolicy{
    public b8 validateSceneRefitCounts(in usize instanceCount, in usize meshNodeCount, in u32 nodeCount)const{
        return instanceCount != 0u
            && meshNodeCount == instanceCount
            && instanceCount <= cast<usize>(u32.max) / s_SoftwareSceneRefitInstanceGpuByteSize
            && ComputeBinaryBvhNodeCount(instanceCount) == cast<usize>(nodeCount);
    }

    public b8 validateSceneNodeBufferBytes(in u32 nodeCount, in u64 sceneByteSize)const{
        return sceneByteSize >= cast<u64>(nodeCount) * cast<u64>(s_NwbBvhNodeGpuByteSize);
    }

    public b8 validateTraversalCaptureCounts(in usize meshCount, in u32 instanceCount)const{
        return meshCount != 0u && meshCount <= cast<usize>(u32.max) && instanceCount != 0u;
    }

    public b8 validateTraversalMeshMetadata(in Name meshName, in u32 primitiveCount, in usize nodeByteSize, in usize positionByteSize, in usize triangleIndexByteSize, in usize attributeByteSize)const{
        return meshName != Name() && primitiveCount != 0u && nodeByteSize != 0u && positionByteSize != 0u && triangleIndexByteSize != 0u && attributeByteSize != 0u;
    }

    public b8 matchesTraversalTableSizes(
        in u32 swShadowMeshCount,
        in usize preparedMeshCount,
        in u32 sceneBvhInstanceCount,
        in u32 preparedInstanceCount,
        in usize nodeBufferCount,
        in usize positionBufferCount,
        in usize indexBufferCount,
        in usize attributeBufferCount,
        in usize nodeHandleCount,
        in usize positionHandleCount,
        in usize indexHandleCount,
        in usize attributeHandleCount
    )const{
        return swShadowMeshCount == cast<u32>(preparedMeshCount) && sceneBvhInstanceCount == preparedInstanceCount
            && nodeBufferCount == preparedMeshCount && positionBufferCount == preparedMeshCount && indexBufferCount == preparedMeshCount && attributeBufferCount == preparedMeshCount
            && nodeHandleCount == preparedMeshCount && positionHandleCount == preparedMeshCount && indexHandleCount == preparedMeshCount && attributeHandleCount == preparedMeshCount;
    }
}


