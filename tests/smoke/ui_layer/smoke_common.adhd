class UiRadioGroupSmokeSource final : public Impl::Ui::IListDataSource, NoCopy{
public:
    [[nodiscard]] virtual u64 instanceGeneration()const noexcept override{ invalidateText(); return m_state.instanceGeneration(); }
    [[nodiscard]] virtual u64 revision()const noexcept override{ invalidateText(); return m_state.revision(); }
    [[nodiscard]] virtual u64 rowCount()const noexcept override{ invalidateText(); return m_state.rowCount(); }
    [[nodiscard]] virtual u64 key(const u64 index)const noexcept override{ invalidateText(); return m_state.key(index); }
    [[nodiscard]] virtual Expected<u64> indexOf(const u64 keyValue)const noexcept override{ invalidateText(); return m_state.indexOf(keyValue); }
    [[nodiscard]] virtual Expected<u64> findEnabled(const u64 start, const b8 reverseValue)const noexcept override{ invalidateText(); return m_state.findEnabled(start, reverseValue); }

    [[nodiscard]] virtual StringView text(const u64 index)const noexcept override{
        invalidateText();
        const StringView label = m_state.readText(index);
        if(label.empty())
            return {};
        NWB_MEMCPY(m_label.data(), m_label.size(), label.data(), label.size());
        return { m_label.data(), label.size() };
    }

    [[nodiscard]] virtual b8 enabled(const u64 index)const noexcept override{ invalidateText(); return m_state.enabled(index); }


public:
    void reverse()noexcept{ m_state.reverse(); }
    void remove(const u64 keyValue)noexcept{ m_state.remove(keyValue); }
    void replace()noexcept{ m_state.replace(); }
    void beginFrame()noexcept{ m_state.beginFrame(); }
    [[nodiscard]] b8 reversed()const noexcept{ return m_state.reversed(); }
    [[nodiscard]] u64 removedKey()const noexcept{ return m_state.removedKey(); }
    [[nodiscard]] u32 labelReads()const noexcept{ return m_state.labelReads(); }


private:
    void invalidateText()const noexcept{ m_label.fill('?'); }


private:
    mutable UiRadioGroupSmokeSourceState m_state;
    mutable Array<char, 32u> m_label{};
};


