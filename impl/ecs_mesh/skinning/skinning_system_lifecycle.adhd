////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static_assert(SkeletonSkinningMode::LinearBlend == NWB_SKINNED_MESH_SKINNING_MODE_LINEAR_BLEND && SkeletonSkinningMode::DualQuaternion == NWB_SKINNED_MESH_SKINNING_MODE_DUAL_QUATERNION, "Skeleton skinning mode values must match the shader ABI");
static_assert(s_RuntimeRequiredStorageDescriptorCount == static_cast<usize>(RuntimeStorageDescriptorSlot::SkinInfluences), "Runtime required storage descriptor count must match slot enum");
static_assert(s_RuntimeStorageDescriptorCount == static_cast<usize>(RuntimeStorageDescriptorSlot::kCount), "Runtime storage descriptor count must match slot enum");
static_assert(sizeof(MeshSkinningBindlessResourceSlots) == sizeof(u32) * 20u, "MeshSkinning bindless resource slots must stay five uint4 lanes");
static_assert(sizeof(MeshSkinningGraphDispatchPlan) == s_MeshSkinningGraphDispatchPlanByteSize, "Graph-owned skinning plans should stay compact");

static_assert(sizeof(MeshSkinningPushConstants) == NWB_SKINNED_MESH_PUSH_CONSTANT_BYTE_SIZE, "MeshSkinning push constants layout must match the shader ABI");
static_assert(offsetof(MeshSkinningPushConstants, meshletCount) == sizeof(u32) * NWB_SKINNED_MESH_PUSH_MESHLET_COUNT, "MeshSkinning meshlet-count push offset drifted");
static_assert(offsetof(MeshSkinningPushConstants, skinCount) == sizeof(u32) * NWB_SKINNED_MESH_PUSH_SKIN_COUNT, "MeshSkinning skin-count push offset drifted");
static_assert(offsetof(MeshSkinningPushConstants, jointCount) == sizeof(u32) * NWB_SKINNED_MESH_PUSH_JOINT_COUNT, "MeshSkinning joint-count push offset drifted");
static_assert(offsetof(MeshSkinningPushConstants, skinningMode) == sizeof(u32) * NWB_SKINNED_MESH_PUSH_SKINNING_MODE, "MeshSkinning skinning-mode push offset drifted");
static_assert(offsetof(MeshSkinningPushConstants, bindlessResourceSlots) == sizeof(u32) * NWB_SKINNED_MESH_PUSH_BINDLESS_RESOURCES_SLOT, "MeshSkinning bindless-resource slot push offset drifted");

static_assert(sizeof(MeshletBoundsPushConstants) == NWB_SKINNED_MESH_BOUNDS_PUSH_CONSTANT_BYTE_SIZE, "MeshSkinning bounds push constants layout must match the shader ABI");
static_assert(offsetof(MeshletBoundsPushConstants, meshletCount) == sizeof(u32) * NWB_SKINNED_MESH_BOUNDS_PUSH_MESHLET_COUNT, "MeshSkinning bounds meshlet-count push offset drifted");
static_assert(offsetof(MeshletBoundsPushConstants, bindlessResourceSlots) == sizeof(u32) * NWB_SKINNED_MESH_BOUNDS_PUSH_BINDLESS_RESOURCES_SLOT, "MeshSkinning bounds bindless-resource slot push offset drifted");

static_assert(sizeof(MeshletBoundsPushConstants) == NWB_SKINNED_MESH_REPACK_PUSH_CONSTANT_BYTE_SIZE, "MeshSkinning repack push constants layout must match the shader ABI");
static_assert(offsetof(MeshletBoundsPushConstants, meshletCount) == sizeof(u32) * NWB_SKINNED_MESH_REPACK_PUSH_MESHLET_COUNT, "MeshSkinning repack meshlet-count push offset drifted");
static_assert(offsetof(MeshletBoundsPushConstants, bindlessResourceSlots) == sizeof(u32) * NWB_SKINNED_MESH_REPACK_PUSH_BINDLESS_RESOURCES_SLOT, "MeshSkinning repack bindless-resource slot push offset drifted");


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_skinning_system_lifecycle{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] static b8 LoadComputeShader(
    Core::GraphicsRuntime& graphics,
    Core::Assets::AssetManager& assetManager,
    MeshSkinningShaderPathResolveCallback& shaderPathResolver,
    const ActiveSceneSubsystems* const activeSceneSubsystems,
    const Core::Assets::AssetRef<ComputeShader> SkinningSubsystem::* const member,
    const Name& debugName,
    Core::ShaderHandle& shader
){
    if(!activeSceneSubsystems)
        return false;
    const SkinningSubsystem* const skinningSubsystem = activeSceneSubsystems->findSubsystem<SkinningSubsystem>();
    if(!skinningSubsystem)
        return false;
    const Core::Assets::AssetRef<ComputeShader>& resolved = skinningSubsystem->*member;
    if(!resolved.valid())
        return false;
    return ShaderAssetLoader::Load<ComputeShader>(resolved.name(), Core::ShaderArchive::s_DefaultVariant, debugName, FOUNDATION_TEXT("MeshSkinningSystem"), graphics, assetManager, shaderPathResolver, nullptr, shader);
}

[[nodiscard]] static b8 EnsureComputePipeline(
    Core::GraphicsRuntime& graphics,
    Core::Assets::AssetManager& assetManager,
    MeshSkinningShaderPathResolveCallback& shaderPathResolver,
    const ActiveSceneSubsystems* const activeSceneSubsystems,
    const Core::Assets::AssetRef<ComputeShader> SkinningSubsystem::* const member,
    const Name& debugName,
    const Core::BindingLayoutHandle& bindingLayout,
    const AStringView pipelineLabel,
    Core::ShaderHandle& inOutShader,
    Core::ComputePipelineHandle& inOutPipeline
){
    if(!LoadComputeShader(graphics, assetManager, shaderPathResolver, activeSceneSubsystems, member, debugName, inOutShader))
        return false;
    return EnsureLoadedComputePipeline(inOutShader, bindingLayout, pipelineLabel, graphics, inOutPipeline);
}

template<typename PushConstantsT>
[[nodiscard]] static b8 EnsurePushConstantComputePipeline(
    Core::GraphicsRuntime& graphics,
    Core::Assets::AssetManager& assetManager,
    MeshSkinningShaderPathResolveCallback& shaderPathResolver,
    const ActiveSceneSubsystems* const activeSceneSubsystems,
    const Core::Assets::AssetRef<ComputeShader> SkinningSubsystem::* const member,
    const Name& debugName,
    const AStringView heapRequirementLabel,
    const AStringView pipelineLabel,
    Core::BindingLayoutHandle& inOutBindingLayout,
    Core::ShaderHandle& inOutShader,
    Core::ComputePipelineHandle& inOutPipeline
){
    auto& device = graphics.getDevice();
    Core::GpuDescriptorHeap& heap = device.getDescriptorHeap();
    if(!heap.isInitialized()){
        LogSkinningDescriptorHeapRequired(heapRequirementLabel);
        return false;
    }
    if(!EnsurePushConstantBindingLayout(sizeof(PushConstantsT), pipelineLabel, device, inOutBindingLayout))
        return false;
    return EnsureComputePipeline(graphics, assetManager, shaderPathResolver, activeSceneSubsystems, member, debugName, inOutBindingLayout, pipelineLabel, inOutShader, inOutPipeline);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


MeshSkinningSystem::MeshSkinningSystem(
    ::ArenaBase& __adhd_mother_arena,
    Core::ECS::World& world,
    Core::GraphicsRuntime& graphics,
    Core::Assets::AssetManager& assetManager,
    IRuntimeMeshRegistry& runtimeMeshRegistry,
    const MeshSkinningShaderPathResolveCallback& shaderPathResolver
)noexcept
    : Core::ECS::ISystem(__adhd_mother_arena)
    , Core::IRenderPass(graphics)
    , __adhd_arena(::MakeNotNull(&__adhd_mother_arena))
    , m_frameTaskGraph(static_cast<Core::Alloc::GlobalArena&>(__adhd_mother_arena))
    , m_frameCompiledGraph(static_cast<Core::Alloc::GlobalArena&>(__adhd_mother_arena))
    , m_frameTaskGraphAnalysis(static_cast<Core::Alloc::GlobalArena&>(__adhd_mother_arena))
    , m_frameSubmissionTransaction(static_cast<Core::Alloc::GlobalArena&>(__adhd_mother_arena))
    , m_acceptedSkinningState(static_cast<Core::Alloc::GlobalArena&>(__adhd_mother_arena))
    , m_frameTaskGraphQueueAssignments(static_cast<Core::Alloc::GlobalArena&>(__adhd_mother_arena))
    , m_frameRecordedGraph(static_cast<Core::Alloc::GlobalArena&>(__adhd_mother_arena))
    , m_world(::MakeNotNull(&world))
    , m_graphics(::MakeNotNull(&graphics))
    , m_assetManager(::MakeNotNull(&assetManager))
    , m_runtimeMeshRegistry(::MakeNotNull(&runtimeMeshRegistry))
    , m_shaderPathResolver(shaderPathResolver)
    , m_runtimeMeshCache(static_cast<Core::Alloc::GlobalArena&>(__adhd_mother_arena), graphics, assetManager)
    , m_defaultSceneSubsystems(static_cast<Core::Alloc::GlobalArena&>(__adhd_mother_arena))
    , m_activeSceneSubsystems(nullptr)
    , m_runtimeResources(0, Hasher<u64>(), EqualTo<u64>(), static_cast<Core::Alloc::GlobalArena&>(__adhd_mother_arena))
    , m_frameDispatchPlans(static_cast<Core::Alloc::GlobalArena&>(__adhd_mother_arena))
    , m_frameDeformationPlans(static_cast<Core::Alloc::GlobalArena&>(__adhd_mother_arena))
    , m_frameLocalBoundsDispatches(static_cast<Core::Alloc::GlobalArena&>(__adhd_mother_arena))
    , m_frameLiveBuffers(static_cast<Core::Alloc::GlobalArena&>(__adhd_mother_arena))
{
    writeAccess<SkinnedMeshBindingComponent>();
    readAccess<SkeletonJointPaletteComponent>();
    readAccess<SkeletonPoseComponent>();

    m_runtimeMeshRegistry->registerRuntimeMeshProvider(*this);
}

MeshSkinningSystem::~MeshSkinningSystem()noexcept{
    // Retire payloads while their transaction, plan, and timing owners still exist; destruction does not initialize another frame.
    {
        const Core::GpuCompiledGraph::ReadView planAccess(m_frameCompiledGraph);
        resolveFrameTaskGraphAttempt(planAccess);
    }
    m_frameTaskGraph.reset();
    m_runtimeMeshRegistry->unregisterRuntimeMeshProvider(*this);
}

void MeshSkinningSystem::prepare([[maybe_unused]] Core::ECS::World& world)noexcept{
    m_runtimeSetupReady = false;
    if(!ensureActiveSceneSubsystems())
        return;
    if(!isSkinningFeatureEnabled()){
        m_runtimeSetupReady = true;
        return;
    }
    if(!m_skinningComputePipeline || !m_boundsComputePipeline || !m_localBoundsComputePipeline || !m_repackComputePipeline)
        return;
    Core::Alloc::ScratchArena scratchArena(s_PrepareRuntimeArena);
    m_runtimeMeshCache.prepareResources(*m_world, scratchArena);
    pruneRuntimeResources();
    b8 ready = true;
    m_world->view<SkinnedMeshBindingComponent>().each([&](Core::ECS::EntityID, SkinnedMeshBindingComponent& binding){
        if(!ready)
            return;
        if(!binding.runtimeMesh.valid())
            return;

        MeshSkinningRuntimeInstance* instance = m_runtimeMeshCache.findInstance(binding.runtimeMesh);
        if(!instance)
            return;
        FOUNDATION_ASSERT(instance->valid());

        ready = prepareRuntimeMeshResources(*instance);
    });

    m_runtimeSetupReady = ready;
}

b8 MeshSkinningSystem::prepareResources([[maybe_unused]] Core::Framebuffer* framebuffer)noexcept{
    // Frames may lack native submissions; filter retired buffers so handles pin nothing.
    if(m_acceptedSkinningState.valid() && !replaceAcceptedSkinningState(*m_acceptedSkinningState.source())){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("MeshSkinningSystem: failed to prune the accepted skinning state handoff"));
        return false;
    }

    return m_runtimeSetupReady;
}

void MeshSkinningSystem::invalidateResources()noexcept{
    m_runtimeSetupReady = false;
    resetFrameTaskGraph();
    FOUNDATION_FATAL_ASSERT_MSG(m_frameRecordedGraph.releaseCommandListCache(), "skinning invalidation requires joined graph recording before device-bound cache release");
    m_acceptedSkinningState.reset();
    for(auto it = m_runtimeResources.begin(); it != m_runtimeResources.end(); ++it)
        releaseRuntimeResourceBindlessHeapHandles(it.value());
    m_runtimeResources.clear();
    m_runtimeMeshCache.clear();
    resetPipelineResources();
}

Expected<RuntimeMeshDesc> MeshSkinningSystem::resolveRuntimeMesh(const Core::ECS::EntityID entity)noexcept{
    RuntimeMeshHandle runtimeMesh;
    if(const SkinnedMeshBindingComponent* binding = m_world->tryGetComponent<SkinnedMeshBindingComponent>(entity))
        runtimeMesh = binding->runtimeMesh;
    const MeshSkinningRuntimeInstance* const instance = runtimeMesh.valid() ? m_runtimeMeshCache.findInstance(runtimeMesh) : nullptr;
    return BuildSkinnedRuntimeMeshDesc(entity, runtimeMesh, instance, s_RuntimeSkinningMeshletFrustumCullingEnabled, s_RuntimeSkinningMeshletConeCullingEnabled);
}

void MeshSkinningSystem::markLiveRuntimeMeshes(RuntimeMeshRequestSet& requests)noexcept{
    if(requests.complete())
        return;
    for(auto&& [entity, binding] : m_world->view<SkinnedMeshBindingComponent>()){
        const MeshSkinningRuntimeInstance* const instance = binding.runtimeMesh.valid() ? m_runtimeMeshCache.findInstance(binding.runtimeMesh) : nullptr;
        if(const auto identity = ResolveSkinnedRuntimeMeshIdentity(entity, binding.runtimeMesh, instance))
            requests.markLive(identity->meshKey, identity->version);
        if(requests.complete())
            return;
    }
}

void MeshSkinningSystem::setActiveSceneSubsystems(const ActiveSceneSubsystems* const subsystems)noexcept{
    m_activeSceneSubsystems = subsystems;
}

b8 MeshSkinningSystem::isSkinningFeatureEnabled()const noexcept{
    return m_activeSceneSubsystems && m_activeSceneSubsystems->hasSubsystem<SkinningSubsystem>();
}

b8 MeshSkinningSystem::ensureActiveSceneSubsystems()noexcept{
    if(m_activeSceneSubsystems)
        return true;
    if(!m_defaultSceneSubsystems.loadProjectStartScene(*m_assetManager))
        return false;
    m_activeSceneSubsystems = &m_defaultSceneSubsystems;
    return true;
}

b8 MeshSkinningSystem::ensureSkinningPipeline()noexcept{
    return __hidden_skinning_system_lifecycle::EnsurePushConstantComputePipeline<MeshSkinningPushConstants>(
        *m_graphics,
        *m_assetManager,
        m_shaderPathResolver,
        m_activeSceneSubsystems,
        &SkinningSubsystem::skinningCs,
        s_SkinningComputeShaderName,
        "skinning",
        "skinning",
        m_skinningBindingLayout,
        m_skinningComputeShader,
        m_skinningComputePipeline
    );
}

b8 MeshSkinningSystem::ensureBoundsPipeline()noexcept{
    return __hidden_skinning_system_lifecycle::EnsurePushConstantComputePipeline<MeshletBoundsPushConstants>(
        *m_graphics,
        *m_assetManager,
        m_shaderPathResolver,
        m_activeSceneSubsystems,
        &SkinningSubsystem::meshletBoundsCs,
        s_MeshletBoundsComputeShaderName,
        "meshlet-bounds",
        "bounds",
        m_boundsBindingLayout,
        m_boundsComputeShader,
        m_boundsComputePipeline
    );
}

b8 MeshSkinningSystem::ensureLocalBoundsPipeline()noexcept{
    if(m_localBoundsComputePipeline)
        return true;
    if(!ensureBoundsPipeline())
        return false;
    return __hidden_skinning_system_lifecycle::EnsureComputePipeline(
        *m_graphics,
        *m_assetManager,
        m_shaderPathResolver,
        m_activeSceneSubsystems,
        &SkinningSubsystem::localBoundsCs,
        s_LocalBoundsComputeShaderName,
        m_boundsBindingLayout,
        "local bounds",
        m_localBoundsComputeShader,
        m_localBoundsComputePipeline
    );
}

b8 MeshSkinningSystem::ensureRepackPipeline()noexcept{
    return __hidden_skinning_system_lifecycle::EnsurePushConstantComputePipeline<MeshletBoundsPushConstants>(
        *m_graphics,
        *m_assetManager,
        m_shaderPathResolver,
        m_activeSceneSubsystems,
        &SkinningSubsystem::repackNormalsCs,
        s_RepackNormalsComputeShaderName,
        "normal-repack",
        "repack",
        m_repackBindingLayout,
        m_repackComputeShader,
        m_repackComputePipeline
    );
}

void MeshSkinningSystem::collectLiveSkinningStateBuffers(Vector<Core::BufferHandle, Core::Alloc::GlobalArena>& outBuffers)const noexcept{
    Core::Alloc::ScratchArena scratchArena(s_PrepareRuntimeArena);
    MeshSkinningStateBufferCollector collector(scratchArena, outBuffers);
    m_world->view<SkinnedMeshBindingComponent>().each([&](Core::ECS::EntityID, const SkinnedMeshBindingComponent& binding){
        if(!binding.runtimeMesh.valid())
            return;

        const MeshSkinningRuntimeInstance* const instance = m_runtimeMeshCache.findInstance(binding.runtimeMesh);
        if(!instance)
            return;

        MeshSkinningStateBufferResources resources;
        const auto foundResources = m_runtimeResources.find(instance->handle.value);
        if(foundResources != m_runtimeResources.end()){
            resources = {
                .editRevision = foundResources.value().editRevision,
                .skinBuffer = &foundResources.value().skinBuffer,
                .jointPaletteBuffer = &foundResources.value().jointPaletteBuffer,
                .bindlessResourceSlotsBuffer = &foundResources.value().bindlessResourceSlotsBuffer,
            };
        }
        collector.collect(*instance, resources);
    });
}

b8 MeshSkinningSystem::replaceAcceptedSkinningState(const Core::CommandListResourceStateHandoff& state)noexcept{
    Vector<Core::BufferHandle, Core::Alloc::GlobalArena>& liveBuffers = m_frameLiveBuffers;
    ScopeExit releaseLiveBuffers([&]()noexcept{ liveBuffers.clear(); });

    Core::Alloc::ScratchArena scratchArena(s_PrepareRuntimeArena);
    collectLiveSkinningStateBuffers(liveBuffers);
    return m_acceptedSkinningState.replaceBufferSubset(state, Span<const Core::BufferHandle>(liveBuffers), scratchArena);
}

void MeshSkinningSystem::pruneRuntimeResources()noexcept{
    if(m_runtimeResources.empty())
        return;

    for(auto it = m_runtimeResources.begin(); it != m_runtimeResources.end();){
        MeshSkinningRuntimeResources& resources = it.value();
        const MeshSkinningRuntimeInstance* instance = m_runtimeMeshCache.findInstance(resources.handle);
        if(CanRetainPreparedRuntimeResources(instance != nullptr && instance->valid(), instance ? instance->editRevision : 0u, resources.editRevision)){
            ++it;
            continue;
        }

        // Heap descriptors retain backing buffers; retire before erasing for quarantine.
        releaseRuntimeResourceBindlessHeapHandles(resources);
        it = m_runtimeResources.erase(it);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


