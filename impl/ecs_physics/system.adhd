    }

    public b8 updateMeshGeometryVertices(in MeshGeometryId id, in Span<f32x4> newVertices){
        return this.m_physicsWorld.updateMeshGeometryVertices(id, newVertices);
    }

    public b8 updateEntityMeshColliderVertices(in EntityID entity, in Span<f32x4> localVertices){
        if(!entity.valid() || !this.m_world.alive(entity) || localVertices.empty())
            return false;
        const auto recIt = this.m_entityRecords.find(entity);
        if(recIt == this.m_entityRecords.end())
            return false;
        const ShapeId shapeId = recIt.value().primaryShapeId;
        if(!shapeId.valid() || !this.m_physicsWorld.isValidShape(shapeId))
            return false;
        if(shapeId.index >= cast<u32>(this.m_physicsWorld.m_shapes.size()) || this.m_physicsWorld.m_shapes[shapeId.index].type != ShapeType::Mesh)
            return false;
        const Optional<mut ColliderComponent> colOpt = this.m_world.borrowComponent<ColliderComponent>(entity);
        const Optional<mut TransformComponent> xfOpt = this.m_world.borrowComponent<TransformComponent>(entity);
        if(!colOpt.has_value() || !xfOpt.has_value())
            return false;
        in ColliderShapeEntry primary = colOpt.value().primaryShape;
        if(primary.shapeType != ShapeType::Mesh)
            return false;
        VectorSingle worldScale = VectorSingle(xfOpt.value().scale);
        if(this.m_hasAnyPhysicsParents && EntityUsesLocalHierarchyTransform(this.m_world, entity))
            worldScale = ResolveEntityWorldScale(entity, this.m_world);
        const VectorSingle signedScale = ResolveSignedColliderScale(worldScale);
        const VectorSingle localRot = SafeNormalizeQuat(VectorSingle(primary.localRotation));
        const b8 hasRot = !Vector3LessOrEqual(Abs(localRot), VectorSingle(1.0e-5f));
        const VectorSingle scaledOffset = VectorSetW(VectorSingle(primary.center) * signedScale, 0.0f);
        Vector<f32x4> transformedVerts;
        TransformEcsPointArray(localVertices, signedScale, localRot, hasRot, scaledOffset, transformedVerts);
        if(this.m_physicsWorld.updateShapeMeshVertices(shapeId, Span<f32x4>(transformedVerts.data(), transformedVerts.size())))
            return true;
        in Shape curShape = this.m_physicsWorld.m_shapes[shapeId.index];
        if(curShape.geometryIndex >= this.m_physicsWorld.m_meshShapes.size())
            return false;
        in MeshShape curMesh = this.m_physicsWorld.m_meshShapes[curShape.geometryIndex];
        const usize triCount = curMesh.triangles.size();
        if(triCount == 0u)
            return false;
        Vector<u32> indices;
        indices.resize(triCount * 3u);
        const usize vCount = transformedVerts.size();
        for(usize ti = 0u; ti < triCount; ++ti){
            const usize wBase = ti * 3u;
            const u32 i0 = curMesh.triangleMetaWordAt(wBase);
            const u32 i1 = curMesh.triangleMetaWordAt(wBase + 1u);
            const u32 i2 = curMesh.triangleMetaWordAt(wBase + 2u);
            if(cast<usize>(i0) >= vCount || cast<usize>(i1) >= vCount || cast<usize>(i2) >= vCount)
                return false;
            indices[wBase] = i0;
            indices[wBase + 1u] = i1;
            indices[wBase + 2u] = i2;
        }
        const Expected<MeshShape> built = MakeMeshShapeWithMaterials(
            Span<f32x4>(transformedVerts.data(), transformedVerts.size()),
            Span<u32>(indices.data(), indices.size()),
            curMesh.radius(),
            curMesh.sidedness(),
            Span<SurfaceMaterial>(curMesh.materials.data(), curMesh.materials.size()),
            Span<u16>(curMesh.triangleMaterialIndices.data(), curMesh.triangleMaterialIndices.size()),
            Span<u32>(curMesh.triangleUserData.data(), curMesh.triangleUserData.size())
        );
        if(!built.has_value())
            return false;
        return this.m_physicsWorld.setMeshShape(shapeId, built.value());
    }

