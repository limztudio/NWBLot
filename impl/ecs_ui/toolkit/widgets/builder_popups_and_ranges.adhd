////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_ui/toolkit/widgets/popup_style.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Point s_CompoundPopupPlaceholderSize = Point(1.0f, 1.0f);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RadioChoiceVisualFlags{
    public b8 enabled = false;
    public b8 checked = false;
    public b8 hover = false;
    public b8 pressed = false;
    public b8 focused = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsPopupLoanCurrent(in b8 isOpen, in u64 stateInstanceGeneration, in u64 stateOpenGeneration, in PopupToken token){
    return isOpen && stateInstanceGeneration == token.instanceGeneration && stateOpenGeneration == token.openGeneration;
}

RadioChoiceVisualFlags BuildRadioChoiceVisualFlags(
    in b8 groupEnabled,
    in b8 rowEnabled,
    in u64 selectedKey,
    in u64 cursorKey,
    in u64 rowKey,
    in WidgetId hoverId,
    in WidgetId partId,
    in b8 partPressed,
    in b8 groupPressed,
    in WidgetId focusId,
    in WidgetId groupId
){
    RadioChoiceVisualFlags flags;
    flags.enabled = groupEnabled && rowEnabled;
    flags.checked = selectedKey == rowKey;
    flags.hover = hoverId == partId;
    flags.pressed = partPressed || (cursorKey == rowKey && groupPressed);
    flags.focused = flags.enabled && focusId == groupId && cursorKey == rowKey;
    return flags;
}

b8 ResolveSliderThumbPressedState(in b8 interactive, in b8 primaryDown, in WidgetId captureId, in WidgetId trackId, in WidgetId thumbId){
    return interactive && primaryDown && (captureId == trackId || captureId == thumbId);
}

LayoutNodeDesc BuildPopupRangeWidthNodeDesc(in LayoutSize width, in Point intrinsicSize){
    LayoutNodeDesc description;
    description.width = width;
    description.intrinsicSize = intrinsicSize;
    return description;
}

PopupOptions BuildCompoundPopupReservationOptions(){
    PopupOptions options;
    options.size = s_CompoundPopupPlaceholderSize;
    return options;
}


