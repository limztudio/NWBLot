void VerifyUiListBuilderScrollbarTests_PopupListsAutofocusAndRestoreEachCoveredListHost(mut UiListBuilderTests self){
    self.m_state.select(1u);
    ASSERT_TRUE(self.accept(1u));
    self.press(Key::Tab);
    EXPECT_EQ(self.m_context.input().focus(), self.id(s_UiListScrollbarListKey, s_UiListScrollbarPanelKey));
    PopupState lowerPopup = PopupState();
    PopupState upperPopup = PopupState();
    ListState lowerState = ListState();
    ListState upperState = ListState();
    lowerState.select(2u);
    upperState.select(3u);
    lowerPopup.open();
    ASSERT_TRUE(self.preparePopups(2u, lowerPopup, lowerState));
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    const WidgetId lowerHost = self.id(s_UiListScrollbarListKey, s_UiListScrollbarPopupKey);
    EXPECT_EQ(self.m_context.input().focus(), lowerHost);
    upperPopup.open();
    ASSERT_TRUE(self.preparePopups(3u, lowerPopup, lowerState, upperPopup, upperState));
    ASSERT_TRUE(self.m_context.commitFrame(3u));
    EXPECT_EQ(self.m_context.input().focus(), self.id(s_UiListScrollbarListKey, s_UiListScrollbarUpperPopupKey));
    self.press(Key::Down);
    ASSERT_TRUE(self.preparePopups(4u, lowerPopup, lowerState, upperPopup, upperState));
    EXPECT_EQ(upperState.selectedKey(), 4u);
    EXPECT_EQ(lowerState.selectedKey(), 2u);
    EXPECT_EQ(self.m_state.selectedKey(), 1u);
    ASSERT_TRUE(self.m_context.commitFrame(4u));
    upperPopup.close();
    ASSERT_TRUE(self.preparePopups(5u, lowerPopup, lowerState, upperPopup, upperState));
    ASSERT_TRUE(self.m_context.commitFrame(5u));
    EXPECT_EQ(self.m_context.input().focus(), lowerHost);
    self.press(Key::Down);
    ASSERT_TRUE(self.preparePopups(6u, lowerPopup, lowerState, upperPopup, upperState));
    EXPECT_EQ(lowerState.selectedKey(), 3u);
    ASSERT_TRUE(self.m_context.commitFrame(6u));
    lowerPopup.close();
    ASSERT_TRUE(self.preparePopups(7u, lowerPopup, lowerState));
    ASSERT_TRUE(self.m_context.commitFrame(7u));
    EXPECT_EQ(self.m_context.input().focus(), self.id(s_UiListScrollbarListKey, s_UiListScrollbarPanelKey));
    self.press(Key::Down);
    ASSERT_TRUE(self.prepare(8u));
    EXPECT_EQ(self.m_state.selectedKey(), 2u);
}

void VerifyUiListBuilderScrollbarTests_TwoCompletedThumbDragsAreConsumedInOneDeclarationUsingTheirOwnBaseline(mut UiListBuilderTests self){
    ASSERT_TRUE(self.accept(1u));
    const WidgetId thumb = RequireUiWidgetId(self.id(s_UiListScrollbarListKey, s_UiListScrollbarPanelKey), s_UiListScrollbarKey);
    const Expected<HitTarget> acceptedOpt = self.tryTarget(thumb);
    ASSERT_TRUE(acceptedOpt.has_value());
    const HitTarget accepted = acceptedOpt.value();
    const Point origin = CenterUiRect(accepted.rectangle);
    self.drag(origin, Point(origin.x, origin.y + 10.0f));
    self.drag(origin, Point(origin.x, origin.y + 20.0f));
    ASSERT_TRUE(self.prepare(2u));
    const f64 travel = cast<f64>(accepted.gestureReference.height) - cast<f64>(accepted.rectangle.height);
    EXPECT_DOUBLE_EQ(self.m_state.scrollOffset(), (20.0 / travel) * accepted.gestureMaximum);
    EXPECT_FALSE(self.m_context.input().consumePointerGesture(thumb, accepted.declarationGeneration).has_value());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_context.input().focus(), self.id(s_UiListScrollbarListKey, s_UiListScrollbarPanelKey));
}

void VerifyUiListBuilderScrollbarTests_FullHeightMinimumThumbFocusesItsHostWithoutStartingAnUnusableGesture(mut UiListBuilderTests self){
    ListOptions options = MakeListFixtureOptions();
    options.height.value = 20.0f;
    ASSERT_TRUE(self.accept(1u, options));
    const WidgetId thumb = RequireUiWidgetId(self.id(s_UiListScrollbarListKey, s_UiListScrollbarPanelKey), s_UiListScrollbarKey);
    const Expected<HitTarget> acceptedOpt = self.tryTarget(thumb);
    ASSERT_TRUE(acceptedOpt.has_value());
    const HitTarget accepted = acceptedOpt.value();
    EXPECT_FLOAT_EQ(self.m_state.placement().track.height, self.m_state.placement().thumb.height);
    EXPECT_FALSE(accepted.pointerGesture);
    self.click(CenterUiRect(accepted.rectangle));
    EXPECT_EQ(self.m_context.input().focus(), self.id(s_UiListScrollbarListKey, s_UiListScrollbarPanelKey));
    EXPECT_FALSE(self.m_context.input().consumePointerGesture(thumb, accepted.declarationGeneration).has_value());
    ASSERT_TRUE(self.prepare(2u, options));
    EXPECT_TRUE(self.m_result.valid);
    EXPECT_TRUE(self.m_result.focused);
    EXPECT_FALSE(self.m_result.activated);
    EXPECT_DOUBLE_EQ(self.m_state.scrollOffset(), 0.0);
    EXPECT_FALSE(self.m_context.failed());
}

void VerifyUiListBuilderScrollbarTests_TrackPageTargetsScrollWithoutRowCollisionAndThumbUsesPressedDisabledSkins(mut UiListBuilderTests self){
    self.m_builder.listStyle().thumbPressed = s_UiCaseButtonPressed;
    self.m_builder.listStyle().thumbDisabled = s_UiCaseButtonDisabled;
    ASSERT_TRUE(self.accept(1u));
    const WidgetId host = self.id(s_UiListScrollbarListKey, s_UiListScrollbarPanelKey);
    const WidgetId beforeTrack = RequireUiWidgetId(host, s_WidgetPartScrollVerticalBefore);
    const WidgetId afterTrack = RequireUiWidgetId(host, s_WidgetPartScrollVerticalAfter);
    const WidgetId thumb = RequireUiWidgetId(host, s_UiListScrollbarKey);

    const Expected<HitTarget> initialBefore = self.tryTarget(beforeTrack);
    const Expected<HitTarget> initialAfter = self.tryTarget(afterTrack);
    ASSERT_TRUE(initialBefore.has_value());
    ASSERT_TRUE(initialAfter.has_value());
    EXPECT_FLOAT_EQ(initialBefore.value().rectangle.height, 0.0f);
    EXPECT_GT(initialAfter.value().rectangle.height, 0.0f);

    self.click(CenterUiRect(initialAfter.value().rectangle));
    ASSERT_TRUE(self.accept(2u));
    EXPECT_DOUBLE_EQ(self.m_state.scrollOffset(), cast<f64>(self.m_state.placement().viewport.height));
    EXPECT_FALSE(self.m_result.activated);
    EXPECT_EQ(self.m_state.selectedKey(), 0u);

    const Expected<HitTarget> movedBefore = self.tryTarget(beforeTrack);
    ASSERT_TRUE(movedBefore.has_value());
    EXPECT_GT(movedBefore.value().rectangle.height, 0.0f);
    self.click(CenterUiRect(movedBefore.value().rectangle));
    ASSERT_TRUE(self.accept(3u));
    EXPECT_DOUBLE_EQ(self.m_state.scrollOffset(), 0.0);

    const Expected<HitTarget> thumbTarget = self.tryTarget(thumb);
    ASSERT_TRUE(thumbTarget.has_value());
    EXPECT_TRUE(self.send(MakeUiPointerEvent(InputEventType::PrimaryDown, CenterUiRect(thumbTarget.value().rectangle))).pointerConsumed);
    ASSERT_TRUE(self.accept(4u));
    const Expected<UiFixtureSkinPaintSample> pressedSample = self.sampleSkinPaint(self.m_paint.freeze(), s_UiCaseButtonPressed);
    ASSERT_TRUE(pressedSample.has_value());
    EXPECT_GE(pressedSample.value().quads, 1u);

    EXPECT_TRUE(self.send(MakeUiPointerEvent(InputEventType::PrimaryUp, CenterUiRect(thumbTarget.value().rectangle))).pointerConsumed);
    ListOptions disabledOpts = MakeListFixtureOptions();
    disabledOpts.enabled = false;
    ASSERT_TRUE(self.accept(5u, disabledOpts));
    const Expected<UiFixtureSkinPaintSample> disabledSample = self.sampleSkinPaint(self.m_paint.freeze(), s_UiCaseButtonDisabled);
    ASSERT_TRUE(disabledSample.has_value());
    EXPECT_GE(disabledSample.value().quads, 1u);
}


