#include <logger/server/crash_symbolicate.adhd>
#include <logger/server/crash_values.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_LOG_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


template<typename ArenaT>
void BuildOrderedCrashReportText(AStringView triggerExpression, AStringView triggerMessage, AStringView triggerFile, u64 triggerLine, AStringView detailReport, AString<ArenaT>& report)noexcept;

namespace LoggerCrashSymbolicateDetail{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class CrashReportComposer final{
public:
    template<typename ArenaT>
    [[nodiscard]] static AString<ArenaT> BuildOrderedCrashReport(const CrashPackageSummary& summary, AString<ArenaT>&& detailReport){
        ArenaT& outArena = detailReport.get_allocator().arena();
        const AString<ArenaT> sourceReport(Move(detailReport));
        AString<ArenaT> ordered(outArena);
        BuildOrderedCrashReportText(summary.triggerExpression, summary.triggerMessage, summary.triggerFile, summary.triggerLine, AStringView(sourceReport), ordered);
        return ordered;
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_LOG_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_ComposerCallstackBareHeader = "[callstack]\n";
const StringView s_ComposerTombstoneBareHeader = "[tombstone_callstack]\n";
const StringView s_ComposerCallstackHeading = "callstack:\n";
const StringView s_ComposerCallstackUnavailableLine = "<unavailable>\n";
const StringView s_ComposerDetailsHeading = "\ndetails:\n";
const StringView s_ComposerLocationPrefix = "at ";
const StringView s_ComposerBareLinePrefix = "line ";
const StringView s_ComposerLineColon = ":";

class CrashReportSectionRange{
    public usize removeBegin = usize.max;
    public usize removeEnd = usize.max;
    public usize contentBegin = usize.max;
    public usize contentEnd = usize.max;

    public b8 found()const{
        return this.removeBegin != usize.max;
    }
}

Expected<CrashReportSectionRange> FindCrashReportSectionRange(in StringView report, in StringView header, in StringView headerWithLeadingNewline){
    CrashReportSectionRange outRange;

    if(report.starts_with(header)){
        outRange.removeBegin = 0u;
        outRange.contentBegin = header.size();
    }
    else{
        const usize headerBegin = report.find(headerWithLeadingNewline);
        if(headerBegin >= report.size())
            return MakeUnexpected(Failure());

        outRange.removeBegin = headerBegin;
        outRange.contentBegin = headerBegin + headerWithLeadingNewline.size();
    }

    const usize nextSection = report.find(s_CrashSymbolicateReportSectionOpen, outRange.contentBegin);
    if(nextSection >= report.size())
        outRange.contentEnd = report.size();
    else
        outRange.contentEnd = nextSection;
    outRange.removeEnd = outRange.contentEnd;
    return outRange;
}

CrashReportSectionRange FindCrashCallstackSectionRange(in StringView report){
    const Expected<CrashReportSectionRange> callstack = FindCrashReportSectionRange(report, s_ComposerCallstackBareHeader, s_CrashSymbolicateInternalCallstackSectionHeader);
    if(callstack.has_value())
        return callstack.value();
    const Expected<CrashReportSectionRange> tombstone = FindCrashReportSectionRange(report, s_ComposerTombstoneBareHeader, s_CrashSymbolicateAndroidTombstoneCallstackSectionHeader);
    if(tombstone.has_value())
        return tombstone.value();
    CrashReportSectionRange emptyRange;
    return emptyRange;
}

StringView ExtractCrashReportSectionContent(in StringView report, in CrashReportSectionRange range){
    if(!range.found())
        return "";
    return TrimView(report.substr(range.contentBegin, range.contentEnd - range.contentBegin));
}

b8 AppendCrashHeadlineFields(
    in StringView triggerExpression,
    in StringView triggerMessage,
    in StringView triggerFile,
    in u64 triggerLine,
    mut String outReport
){
    b8 wrote = false;
    if(!triggerExpression.empty()){
        outReport.append(triggerExpression);
        outReport.append(s_CrashSymbolicateReportLineEnd);
        wrote = true;
    }
    if(!triggerMessage.empty()){
        outReport.append(triggerMessage);
        outReport.append(s_CrashSymbolicateReportLineEnd);
        wrote = true;
    }
    if(!triggerFile.empty() || triggerLine != 0u){
        outReport.append(s_ComposerLocationPrefix);
        if(!triggerFile.empty())
            outReport.append(triggerFile);
        else
            outReport.append(s_ComposerBareLinePrefix);
        if(triggerLine != 0u){
            if(!triggerFile.empty())
                outReport.append(s_ComposerLineColon);
            AppendUnsignedU64Text(outReport, triggerLine);
        }
        outReport.append(s_CrashSymbolicateReportLineEnd);
        wrote = true;
    }
    return wrote;
}

void AppendVisibleCallstack(in StringView callstack, mut String outReport){
    outReport.append(s_ComposerCallstackHeading);
    if(callstack.empty()){
        outReport.append(s_ComposerCallstackUnavailableLine);
        return;
    }

    outReport.append(callstack);
    if(outReport.back() != 10u)
        outReport.append(s_CrashSymbolicateReportLineEnd);
}

void BuildOrderedCrashReportText(
    in StringView triggerExpression,
    in StringView triggerMessage,
    in StringView triggerFile,
    in u64 triggerLine,
    in StringView detailReport,
    mut String report
){
    const CrashReportSectionRange callstackSection = FindCrashCallstackSectionRange(detailReport);
    const StringView callstack = ExtractCrashReportSectionContent(detailReport, callstackSection);

    StringView left = detailReport;
    StringView right = "";
    if(callstackSection.found()){
        left = detailReport.substr(0u, callstackSection.removeBegin);
        right = detailReport.substr(callstackSection.removeEnd);
    }
    left = TrimLeftView(left);
    if(left.empty())
        right = TrimLeftView(right);
    while(!right.empty() && IsAsciiSpace(right.back()))
        right = right.substr(0u, right.size() - 1u);
    if(right.empty()){
        while(!left.empty() && IsAsciiSpace(left.back()))
            left = left.substr(0u, left.size() - 1u);
    }

    report.reserve(AddSaturating<usize>(AddSaturating<usize>(AddSaturating<usize>(left.size(), right.size()), callstack.size()), s_CrashSymbolicateInternalCrashReportReserveBytes));
    if(AppendCrashHeadlineFields(triggerExpression, triggerMessage, triggerFile, triggerLine, report))
        report.append(s_CrashSymbolicateReportLineEnd);
    AppendVisibleCallstack(callstack, report);
    report.append(s_ComposerDetailsHeading);
    if(!left.empty() || !right.empty()){
        report.append(left);
        report.append(right);
        if(report.back() != 10u)
            report.append(s_CrashSymbolicateReportLineEnd);
    }
}


