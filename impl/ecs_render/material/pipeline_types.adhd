////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> MaterialPipelinePass{
    enum Opaque,
    enum CsgReceiverSurface,
    enum AvboitOccupancy,
    enum AvboitExtinction,
    enum AvboitAccumulate,
    enum AvboitRefractionCapture
}

enum<u8> RenderPath{
    enum MeshShader,
    enum VertexIndexed,
    enum ComputeEmulation
}

enum<u8> MaterialPipelineCsgMode{
    enum None,
    enum ClipOnly
}

class MaterialPipelineCsgBindingUse{
    public b8 clip = false;
    public b8 avboitClip = false;
}

b8 MaterialPipelinePassUsesRendererAvboit(in MaterialPipelinePass pass){
    return pass == MaterialPipelinePass::Enum::AvboitOccupancy
        || pass == MaterialPipelinePass::Enum::AvboitExtinction
        || pass == MaterialPipelinePass::Enum::AvboitAccumulate
        || pass == MaterialPipelinePass::Enum::AvboitRefractionCapture;
}

b8 MaterialPipelinePassUsesRendererCsgShaderVariant(in MaterialPipelinePass pass){
    if(pass == MaterialPipelinePass::Enum::Opaque || pass == MaterialPipelinePass::Enum::CsgReceiverSurface){
        return true;
    }
    return MaterialPipelinePassUsesRendererAvboit(pass);
}

b8 MaterialPipelinePassUsesRendererCsgClip(in MaterialPipelinePass pass, in b8 transparent){
    if(pass == MaterialPipelinePass::Enum::Opaque){
        return !transparent;
    }
    if(pass == MaterialPipelinePass::Enum::CsgReceiverSurface){
        return true;
    }
    return transparent && MaterialPipelinePassUsesRendererAvboit(pass);
}


