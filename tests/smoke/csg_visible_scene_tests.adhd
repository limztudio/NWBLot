#include <tests/common/gtest_macros.adhd>
#include <tests/common/ecs_test_world.adhd>
#include "csg_visible_scene.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_csg/module.adhd.h>
#include <impl/ecs_scene/module.adhd.h>

namespace NWB::Tests::Smoke{
    using EcsTestWorld = NWB::Tests::EcsTestWorld;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const SmokeMaterialRef s_CsgVisibleTestMaterial = "project/smoke/csg_visible/materials/solid";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyCsgVisibleSceneMissingReceiverPoseUpdates(){
    EcsTestWorld testWorld = EcsTestWorld();
    CsgVisibleScene scene = CsgVisibleScene();
    EntityID missingReceiver = EntityID();
    EntityID remainingReceiver = EntityID();
    EntityID remainingCutter = EntityID();
    native(mut testWorld, mut scene, mut missingReceiver, mut remainingReceiver, mut remainingCutter){
        auto& world = testWorld.world;
        const EntityID camera = world.createEntity().id();
        const EntityID light = world.createEntity().id();
        scene.create(s_CsgVisibleTestMaterial, false, camera, light, world);

        world.view<NWB::Impl::StaticCsgMeshComponent>().each([&](const EntityID entity, NWB::Impl::StaticCsgMeshComponent& receiver){
            if(receiver.receiverGroup == s_SmokeSceneNameProjectSmokeCsgVisiblePlaneReceiver)
                missingReceiver = entity;
            if(receiver.receiverGroup == s_SmokeSceneNameProjectSmokeCsgVisibleSphereReceiver)
                remainingReceiver = entity;
        });
        world.view<NWB::Impl::CsgCutterComponent>().each([&](const EntityID entity, NWB::Impl::CsgCutterComponent& cutter){
            if(cutter.receiverGroup == s_SmokeSceneNameProjectSmokeCsgVisibleSphereReceiver)
                remainingCutter = entity;
        });
    }
    ASSERT_TRUE(missingReceiver.valid());
    ASSERT_TRUE(remainingReceiver.valid());
    ASSERT_TRUE(remainingCutter.valid());

    b8 hadBeforeComponents = false;
    f32x4 oldRotation = f32x4();
    f32x3x4 oldCutterTransform = f32x3x4();
    native(mut testWorld, in missingReceiver, in remainingReceiver, in remainingCutter, mut hadBeforeComponents, mut oldRotation, mut oldCutterTransform){
        auto& world = testWorld.world;
        world.destroyEntity(missingReceiver);
        const auto* transform = world.tryGetComponent<NWB::Impl::Scene::TransformComponent>(remainingReceiver);
        const auto* cutter = world.tryGetComponent<NWB::Impl::CsgCutterComponent>(remainingCutter);
        if(transform && cutter){
            hadBeforeComponents = true;
            oldRotation = transform->rotation;
            oldCutterTransform = cutter->shapeToWorld;
        }
    }
    ASSERT_TRUE(hadBeforeComponents);

    b8 hadAfterComponents = false;
    f32x4 newRotation = f32x4();
    b8 cutterChanged = false;
    native(mut testWorld, mut scene, in remainingReceiver, in remainingCutter, in oldCutterTransform, mut hadAfterComponents, mut newRotation, mut cutterChanged){
        auto& world = testWorld.world;
        scene.update(1.0f, world);
        const auto* transform = world.tryGetComponent<NWB::Impl::Scene::TransformComponent>(remainingReceiver);
        const auto* cutter = world.tryGetComponent<NWB::Impl::CsgCutterComponent>(remainingCutter);
        if(transform && cutter){
            hadAfterComponents = true;
            newRotation = transform->rotation;
            for(usize index = 0u; index < 12u; ++index)
                cutterChanged = cutterChanged || cutter->shapeToWorld.raw[index] != oldCutterTransform.raw[index];
        }
    }
    ASSERT_TRUE(hadAfterComponents);
    EXPECT_NE(newRotation.y, oldRotation.y);
    EXPECT_TRUE(cutterChanged);
}

NWB_ADHD_GTEST(CsgVisibleScene, MissingReceiverDoesNotStopOtherPoseUpdates, VerifyCsgVisibleSceneMissingReceiverPoseUpdates)


