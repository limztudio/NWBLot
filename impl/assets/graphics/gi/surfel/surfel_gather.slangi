////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_GI_SURFEL_GATHER_SLANGI
#define NWB_GRAPHICS_GI_SURFEL_GATHER_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Per-pixel surfel gather for the deferred-lighting consumer. Biases the shaded point outward along the normal, hashes it,
// walks the (2*extent+1)^3 neighbour cells' surfel lists (extent covers the falloff radius; capped), and weights each surfel by normal alignment * distance falloff *
// confidence (samples integrated). Returns false when no surfel covers the point, so the caller falls back to hemiAmbient.
// The pool + cell-head + params are bound via the NWB_SCENE_GI_SURFEL_* slot macros.


#include "surfel_heap_resources.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Resolve reads the immutable live field through its dispatch-uniform heap slots.
#define g_NwbSceneSurfelParams g_NwbHeapSurfelConstantBuffers[g_NwbSurfelHeapPushConstants.constantsHeapSlot]
#define NWB_SURFEL_GATHER_FIELD_POOL g_NwbHeapSurfelReadOnlyPools[g_NwbSurfelHeapPushConstants.poolHeapSlot]
#define NWB_SURFEL_GATHER_FIELD_CELL_HEAD g_NwbHeapSurfelReadOnlyUintBuffers[g_NwbSurfelHeapPushConstants.cellHeadHeapSlot]
#define NWB_SURFEL_GATHER_FIELD_CONSTANTS g_NwbSceneSurfelParams
#define NWB_SURFEL_GATHER_FIELD_INDEX_VALID(id, poolCapacity) ((id) != NWB_SURFEL_CELL_INVALID)

#include "surfel_gather_field.slangi"

#undef NWB_SURFEL_GATHER_FIELD_INDEX_VALID
#undef NWB_SURFEL_GATHER_FIELD_CONSTANTS
#undef NWB_SURFEL_GATHER_FIELD_CELL_HEAD
#undef NWB_SURFEL_GATHER_FIELD_POOL


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Gathers the surfel irradiance at a shaded point. Returns false if no surfel covers it (caller -> hemiAmbient).
bool nwbSurfelGather(const float3 worldPosition, const float3 normal, out float3 outIrradiance){
    return nwbSurfelGatherField(worldPosition, normal, 0u, outIrradiance);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

