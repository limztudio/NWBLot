#include <impl/ecs_render/renderer_frame_pipeline.adhd>
#include <impl/ecs_render/kernel/renderer_device_diagnostics_label.adhd>
#include <impl/ecs_render/kernel/renderer_graph_runtime_label.adhd>
#include <impl/ecs_render/kernel/timing_names.adhd>
#include <impl/ecs_render/shared/frame_types.adhd>
#include <impl/ecs_render/kernel/frame_graph_runtime_statistics.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 HasActiveRuntimeQueueTopology(in b8 runtimeStatisticsPresent, in b8 hasQueues, in usize queueCount){
    return runtimeStatisticsPresent && hasQueues && queueCount != 0u;
}

b8 MatchesSubmittedPacketTelemetryCount(in usize collectedPacketCount, in u32 nativeSubmissionCount){
    return collectedPacketCount == cast<usize>(nativeSubmissionCount);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


FrameGraphNodeHandle AppendRendererTelemetryPass(mut FrameGraphBuilder builder, mut FrameGraphNodeHandle lastPass, in GpuTimingScopeDefinition scope, in StringView label){
    const FrameGraphNodeHandle pass = builder.addPass(scope.identity, label);
    builder.addEdge(lastPass, pass, FrameGraphEdgeKind::DependsOn);
    lastPass = pass;
    return pass;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
b8 RendererFramePipeline::appendFrameGraph(mut FrameGraphBuilder builder){
    if(!this.m_frameTargets.valid())
        return false;

    const GpuTaskGraphDeclarationReadView deferredTaskGraphView(this.m_deferredLightingTaskGraph);
    const GpuCompiledGraphReadView deferredCompiledPlan(this.m_deferredLightingCompiledGraph);


    in CsgFrameState csgFrameState = this.m_preparedCsgFrameState;
    const b8 hasCsgFrameWork = this.m_preparedCsgFrameStateValid && !csgFrameState.empty();
    const b8 hasOpaqueCsgFrameWork = hasCsgFrameWork && (csgFrameState.hasOpaqueStaticWork || csgFrameState.hasOpaqueSkinnedWork);
    const b8 hasTransparentCsgFrameWork = hasCsgFrameWork && (csgFrameState.hasTransparentStaticWork || csgFrameState.hasTransparentSkinnedWork);
    const b8 hasTransparentRenderers = this.m_materialSystem.hasTransparentRenderers(RendererResourceLookupMode::PreparedOnly);
    const b8 hasAvboitWork = this.m_avboitSystem.shouldClearTargets(hasTransparentRenderers);

    GpuTaskGraphRuntimeStatistics deferredRuntimeStatistics;
    if(builder.frameIndex() == this.m_frameGraphSourceFrameIndex)
        deferredRuntimeStatistics = this.deferredTaskGraphRuntimeStatistics();
    FrameGraphPassMetadata rendererFrameMetadata;
    rendererFrameMetadata.runtimeStatistics = BuildFrameGraphRuntimeStatistics(deferredRuntimeStatistics, builder.frameIndex(), this.m_frameGraphSourceFrameIndex);
    const GpuPhysicalQueueTopology runtimeQueueTopology = deferredCompiledPlan.queueTopology();
    Vector<FrameGraphPhysicalQueueRuntimeStatistics> physicalQueueRuntimeStatistics;
    Vector<GpuTaskGraphPacketSubmissionStatistics> packetSubmissionStatistics;
    if(rendererFrameMetadata.runtimeStatistics.present && !HasActiveRuntimeQueueTopology(rendererFrameMetadata.runtimeStatistics.present, !runtimeQueueTopology.queueSpan().empty(), runtimeQueueTopology.queueCount))
        rendererFrameMetadata.runtimeStatistics = FrameGraphRuntimeStatistics();
    if(rendererFrameMetadata.runtimeStatistics.present){
        physicalQueueRuntimeStatistics.reserve(runtimeQueueTopology.queueCount);
        for(usize queueIndex = 0u; queueIndex < runtimeQueueTopology.queueCount; ++queueIndex){
            const GpuPhysicalQueueId queue = runtimeQueueTopology.queueSpan()[queueIndex].id;
            const FrameGraphPhysicalQueueRuntimeStatistics queueStatistics = BuildFrameGraphPhysicalQueueRuntimeStatistics(
                deferredCompiledPlan.physicalQueueCompileStatistics(queue),
                this.m_deferredLightingRecordedGraph.physicalQueueRecordingStatistics(this.m_deferredLightingCompiledGraph, deferredCompiledPlan, queue),
                this.m_deferredLightingSubmissionTransaction.physicalQueueSubmissionStatistics(deferredCompiledPlan, queue)
            );
            if(!IsValidFrameGraphPhysicalQueueRuntimeStatisticsForOwner(queueStatistics, rendererFrameMetadata.runtimeStatistics)){
                rendererFrameMetadata.runtimeStatistics = FrameGraphRuntimeStatistics();
                physicalQueueRuntimeStatistics.clear();
                break;
            }
            physicalQueueRuntimeStatistics.push_back(queueStatistics);
        }
    }
    if(rendererFrameMetadata.runtimeStatistics.present){
        packetSubmissionStatistics.reserve(deferredCompiledPlan.packetCount());
        for(usize packetIndex = 0u; packetIndex < deferredCompiledPlan.packetCount(); ++packetIndex){
            const GpuSubmissionPacketId packet = deferredCompiledPlan.packetIdAt(packetIndex);
            if(!packet.valid()){
                rendererFrameMetadata.runtimeStatistics = FrameGraphRuntimeStatistics();
                physicalQueueRuntimeStatistics.clear();
                packetSubmissionStatistics.clear();
                break;
            }

            const GpuTaskGraphPacketSubmissionStatistics packetStatistics = this.m_deferredLightingSubmissionTransaction.packetSubmissionStatistics(deferredCompiledPlan, packet);
            if(packetStatistics.valid())
                packetSubmissionStatistics.push_back(packetStatistics);
        }
        if(rendererFrameMetadata.runtimeStatistics.present && !MatchesSubmittedPacketTelemetryCount(packetSubmissionStatistics.size(), deferredRuntimeStatistics.submission.nativeSubmissionCount)){
            rendererFrameMetadata.runtimeStatistics = FrameGraphRuntimeStatistics();
            physicalQueueRuntimeStatistics.clear();
            packetSubmissionStatistics.clear();
        }
    }
    this.m_frameGraphRendererLabel.clear();
    RendererGraphRuntimeLabel runtimeLabel;
    if(!runtimeLabel.append(deferredRuntimeStatistics, runtimeQueueTopology, physicalQueueRuntimeStatistics, deferredCompiledPlan, this.m_deferredLightingRecordedGraph, this.m_graphics.getDevice(), this.m_frameGraphRendererLabel))
        return false;

    RendererDeviceDiagnosticsLabel diagnosticsLabel;
    diagnosticsLabel.append(this.m_graphics, this.m_frameGraphRendererLabel);

    const FrameGraphNodeHandle rendererFrame = builder.addPass(Name(s_FrameGraphNameEcsRenderFrame), StringView(this.m_frameGraphRendererLabel), rendererFrameMetadata);
    for(in FrameGraphPhysicalQueueRuntimeStatistics queueStatistics : physicalQueueRuntimeStatistics){
        if(!builder.addPhysicalQueueRuntimeStatistics(rendererFrame, queueStatistics)){
            assert(false);
            return false;
        }
    }
    for(in GpuTaskGraphPacketSubmissionStatistics packetStatistics : packetSubmissionStatistics){
        const FrameGraphPacketSubmissionStatisticsRecord telemetryStatistics = BuildFrameGraphPacketSubmissionStatistics(packetStatistics, rendererFrame.index);
        if(!builder.addPacketSubmissionStatistics(rendererFrame, telemetryStatistics)){
            assert(false);
            return false;
        }
    }
    const FrameGraphNodeHandle frameSetup = builder.addPass(Name(s_FrameGraphNameEcsRenderFrameSetup), "Frame Setup");
    const FrameGraphNodeHandle deferredTargets = builder.addResource(Name(s_FrameGraphNameEcsRenderDeferredTargets), "Deferred Targets");
    const FrameGraphNodeHandle meshViewBuffer = builder.addResource(Name(s_FrameGraphNameEcsRenderMeshViewBuffer), "Mesh View Buffer");
    const FrameGraphNodeHandle sceneShadingBuffer = builder.addResource(Name(s_FrameGraphNameEcsRenderSceneShadingBuffer), "Scene Shading Buffer");
    const FrameGraphNodeHandle materialBuffers = builder.addResource(Name(s_FrameGraphNameEcsRenderMaterialDrawBuffers), "Material Draw Buffers");
    const FrameGraphNodeHandle backBuffer = builder.addExternal(s_Backbuffer, "Back Buffer");

    FrameGraphNodeHandle lastPass = frameSetup;

    builder.addEdge(rendererFrame, frameSetup, FrameGraphEdgeKind::DependsOn);
    builder.addEdge(frameSetup, meshViewBuffer, FrameGraphEdgeKind::Writes);
    builder.addEdge(frameSetup, sceneShadingBuffer, FrameGraphEdgeKind::Writes);

    const FrameGraphNodeHandle deferredClear = AppendRendererTelemetryPass(builder, lastPass, s_TimingScopeDeferredClear, "Deferred Clear");
    builder.addEdge(deferredClear, deferredTargets, FrameGraphEdgeKind::Writes);

    const FrameGraphNodeHandle materialUpload = AppendRendererTelemetryPass(builder, lastPass, s_TimingScopeMaterialUpload, "Material Upload");
    builder.addEdge(materialUpload, materialBuffers, FrameGraphEdgeKind::Writes);

    FrameGraphNodeHandle csgIntervalTargets;
    if(hasOpaqueCsgFrameWork){
        csgIntervalTargets = builder.addResource(Name(s_FrameGraphNameEcsRenderCsgIntervalTargets), "CSG Interval Targets");

        const FrameGraphNodeHandle csgUpload = AppendRendererTelemetryPass(builder, lastPass, s_TimingScopeCsgUpload, "CSG Upload");
        builder.addEdge(csgUpload, csgIntervalTargets, FrameGraphEdgeKind::Writes);

        const FrameGraphNodeHandle csgSampleStateUpload = AppendRendererTelemetryPass(builder, lastPass, s_TimingScopeCsgSampleStateUpload, "CSG Sample State Upload");
        builder.addEdge(csgSampleStateUpload, csgIntervalTargets, FrameGraphEdgeKind::Writes);

        const FrameGraphNodeHandle csgIntervalPeel = AppendRendererTelemetryPass(builder, lastPass, s_TimingScopeCsgIntervalPeel, "CSG Interval Peel");
        builder.addEdge(csgIntervalPeel, csgIntervalTargets, FrameGraphEdgeKind::Writes);

        const FrameGraphNodeHandle csgReceiverSurface = AppendRendererTelemetryPass(builder, lastPass, s_TimingScopeOpaqueCsgReceiverSurface, "Opaque CSG Receiver Surface");
        builder.addEdge(meshViewBuffer, csgReceiverSurface, FrameGraphEdgeKind::Reads);
        builder.addEdge(csgReceiverSurface, csgIntervalTargets, FrameGraphEdgeKind::Writes);

        const FrameGraphNodeHandle csgReceiverSpanBuild = AppendRendererTelemetryPass(builder, lastPass, s_TimingScopeCsgReceiverSpanBuild, "CSG Receiver Span Build");
        builder.addEdge(csgIntervalTargets, csgReceiverSpanBuild, FrameGraphEdgeKind::Reads);
        builder.addEdge(csgReceiverSpanBuild, csgIntervalTargets, FrameGraphEdgeKind::Writes);

        const FrameGraphNodeHandle csgIntervalCombine = AppendRendererTelemetryPass(builder, lastPass, s_TimingScopeCsgIntervalCombine, "CSG Interval Combine");
        builder.addEdge(csgIntervalTargets, csgIntervalCombine, FrameGraphEdgeKind::Reads);
        builder.addEdge(csgIntervalCombine, csgIntervalTargets, FrameGraphEdgeKind::Writes);
    }

    const FrameGraphNodeHandle opaqueRegular = AppendRendererTelemetryPass(builder, lastPass, s_TimingScopeOpaqueRegular, "Opaque Regular");
    builder.addEdge(meshViewBuffer, opaqueRegular, FrameGraphEdgeKind::Reads);
    builder.addEdge(sceneShadingBuffer, opaqueRegular, FrameGraphEdgeKind::Reads);
    builder.addEdge(materialBuffers, opaqueRegular, FrameGraphEdgeKind::Reads);
    builder.addEdge(opaqueRegular, deferredTargets, FrameGraphEdgeKind::Writes);

    if(hasOpaqueCsgFrameWork){
        const FrameGraphNodeHandle opaqueCsg = AppendRendererTelemetryPass(builder, lastPass, s_TimingScopeOpaqueCsg, "Opaque CSG");
        builder.addEdge(meshViewBuffer, opaqueCsg, FrameGraphEdgeKind::Reads);
        builder.addEdge(materialBuffers, opaqueCsg, FrameGraphEdgeKind::Reads);
        builder.addEdge(csgIntervalTargets, opaqueCsg, FrameGraphEdgeKind::Reads);
        builder.addEdge(opaqueCsg, deferredTargets, FrameGraphEdgeKind::Writes);

        const FrameGraphNodeHandle csgCapFill = AppendRendererTelemetryPass(builder, lastPass, s_TimingScopeCsgCapFill, "CSG Cap Fill");
        builder.addEdge(csgIntervalTargets, csgCapFill, FrameGraphEdgeKind::Reads);
        builder.addEdge(csgCapFill, deferredTargets, FrameGraphEdgeKind::Writes);
    }

    FrameGraphNodeHandle avboitTargets;
    if(hasAvboitWork){
        avboitTargets = builder.addResource(Name(s_FrameGraphNameEcsRenderAvboitTargets), "AVBOIT Targets");

        const FrameGraphNodeHandle avboitClear = AppendRendererTelemetryPass(builder, lastPass, s_TimingScopeAvboitClear, "AVBOIT Clear");
        builder.addEdge(avboitClear, avboitTargets, FrameGraphEdgeKind::Writes);
    }
    if(hasTransparentRenderers){
        if(hasTransparentCsgFrameWork){
            const FrameGraphNodeHandle transparentCsgIntervals = AppendRendererTelemetryPass(builder, lastPass, s_TimingScopeTransparentCsgIntervals, s_TransparentCsgIntervalsLabel);
            builder.addEdge(deferredTargets, transparentCsgIntervals, FrameGraphEdgeKind::Reads);
            builder.addEdge(transparentCsgIntervals, avboitTargets, FrameGraphEdgeKind::Writes);
        }

        const FrameGraphNodeHandle avboitOccupancy = AppendRendererTelemetryPass(builder, lastPass, s_TimingScopeAvboitOccupancy, "AVBOIT Occupancy");
        builder.addEdge(meshViewBuffer, avboitOccupancy, FrameGraphEdgeKind::Reads);
        builder.addEdge(materialBuffers, avboitOccupancy, FrameGraphEdgeKind::Reads);
        builder.addEdge(avboitOccupancy, avboitTargets, FrameGraphEdgeKind::Writes);

        const FrameGraphNodeHandle avboitDepthWarp = AppendRendererTelemetryPass(builder, lastPass, s_TimingScopeAvboitDepthWarp, s_AvboitDepthWarpLabel);
        builder.addEdge(avboitTargets, avboitDepthWarp, FrameGraphEdgeKind::Reads);
        builder.addEdge(avboitDepthWarp, avboitTargets, FrameGraphEdgeKind::Writes);

        const FrameGraphNodeHandle avboitExtinction = AppendRendererTelemetryPass(builder, lastPass, s_TimingScopeAvboitExtinction, s_AvboitExtinctionLabel);
        builder.addEdge(avboitTargets, avboitExtinction, FrameGraphEdgeKind::Reads);
        builder.addEdge(avboitExtinction, avboitTargets, FrameGraphEdgeKind::Writes);

        const FrameGraphNodeHandle avboitIntegration = AppendRendererTelemetryPass(builder, lastPass, s_TimingScopeAvboitIntegration, s_AvboitIntegrationLabel);
        builder.addEdge(avboitTargets, avboitIntegration, FrameGraphEdgeKind::Reads);
        builder.addEdge(avboitIntegration, avboitTargets, FrameGraphEdgeKind::Writes);

        const FrameGraphNodeHandle avboitAccumulate = AppendRendererTelemetryPass(builder, lastPass, s_TimingScopeAvboitAccumulate, "AVBOIT Accumulate");
        builder.addEdge(avboitTargets, avboitAccumulate, FrameGraphEdgeKind::Reads);
        builder.addEdge(avboitAccumulate, deferredTargets, FrameGraphEdgeKind::Writes);
    }

    const FrameGraphNodeHandle deferredLighting = AppendRendererTelemetryPass(builder, lastPass, s_TimingScopeDeferredLighting, s_DeferredLightingLabel);
    builder.addEdge(deferredTargets, deferredLighting, FrameGraphEdgeKind::Reads);
    builder.addEdge(deferredLighting, deferredTargets, FrameGraphEdgeKind::Writes);

    const FrameGraphNodeHandle deferredComposite = AppendRendererTelemetryPass(builder, lastPass, s_TimingScopeDeferredComposite, s_DeferredCompositeLabel);
    builder.addEdge(deferredTargets, deferredComposite, FrameGraphEdgeKind::Reads);

    const FrameGraphNodeHandle deferredPresent = AppendRendererTelemetryPass(builder, lastPass, s_TimingScopeDeferredPresent, s_DeferredPresentLabel);
    builder.addEdge(deferredComposite, deferredPresent, FrameGraphEdgeKind::DependsOn);
    builder.addEdge(deferredPresent, backBuffer, FrameGraphEdgeKind::Writes);

    if(this.m_deferredLightingTaskGraphScheduled){
        if(!this.m_deferredLightingTaskGraphQueueAssignmentTelemetry.updateForFrameGraph(deferredTaskGraphView, this.m_deferredLightingTaskGraphQueueAssignments, deferredCompiledPlan, this.m_deferredLightingSubmissionTransaction, builder))
            warning("RendererSystem: accepted queue-assignment telemetry refresh failed; skipping detailed task graph export");
        else{
            if(!deferredTaskGraphView.appendAcceptedFrameGraphTelemetry(this.m_deferredLightingTaskGraphAnalysis, builder, this.m_deferredLightingTaskGraphQueueAssignments, deferredCompiledPlan, this.m_deferredLightingTaskGraphQueueAssignmentTelemetry))
                warning("RendererSystem: deferred-effects/lighting/composite/present graph telemetry export failed");
        }
    }

    return true;
}

GpuTaskGraphRuntimeStatistics RendererFramePipeline::deferredTaskGraphRuntimeStatistics()const{
    const GpuCompiledGraphReadView deferredCompiledPlan(this.m_deferredLightingCompiledGraph);

    return CollectGpuTaskGraphRuntimeStatistics(this.m_deferredLightingCompiledGraph, deferredCompiledPlan, this.m_deferredLightingRecordedGraph, this.m_deferredLightingSubmissionTransaction);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

