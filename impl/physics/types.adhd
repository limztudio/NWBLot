////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/physics/constants.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[reflect]
enum<u8> BodyType{
    Static = 0u,
    Kinematic = 1u,
    Dynamic = 2u,
    kCount
}

[reflect]
enum<u8> ShapeType{
    Sphere = 0u,
    Capsule = 1u,
    Hull = 2u,
    Mesh = 3u,
    Cylinder = 4u,
    Cone = 5u,
    TaperedCapsule = 6u,
    Heightfield = 7u,
    Plane = 8u,
    Segment = 9u,
    kCount
}

[reflect]
enum<u8> MeshSidedness{
    DoubleSided = 0u,
    SingleSided = 1u,
    kCount
}

[reflect]
enum<u8> JointType{
    Distance = 0u,
    Spherical = 1u,
    Revolute = 2u,
    Prismatic = 3u,
    Fixed = 4u,
    Motor = 5u,
    Wheel = 6u,
    SixDof = 7u,
    Gear = 8u,
    Pulley = 9u,
    RackAndPinion = 10u,
    Path = 11u,
    Rope = 12u,
    kCount
}

[reflect]
enum<u8> JointMotion{
    Free = 0u,
    Limited = 1u,
    Locked = 2u,
    kCount
}

[reflect]
enum<u8> SixDofSwingLimitMode{
    None = 0u,
    Cone = 1u,
    Pyramid = 2u,
    kCount
}

[reflect]
enum<u8> PhysicsBackendMode{
    Auto = 0u,
    CpuOnly = 1u,
    GpuPreferred = 2u,
    kCount
}

[reflect]
enum<u8> ExecutionBackendUsed{
    None = 0u,
    Cpu = 1u,
    Gpu = 2u,
    Hybrid = 3u,
    kCount
}

[reflect]
enum<u8> MaterialCombineMode{
    Average = 0u,
    Min = 1u,
    Multiply = 2u,
    Max = 3u,
    GeometricMean = 4u,
    kCount
}

flag<u32> BodyFlags{
    None = 0u,
    LockLinearX = 0x00000001u,
    LockLinearY = 0x00000002u,
    LockLinearZ = 0x00000004u,
    LockAngularX = 0x00000008u,
    LockAngularY = 0x00000010u,
    LockAngularZ = 0x00000020u,
    IsFast = 0x00000040u,
    IsBullet = 0x00000080u,
    IsSpeedCapped = 0x00000100u,
    HadTimeOfImpact = 0x00000200u,
    AllowFastRotation = 0x00000400u,
    Dynamic = 0x00001000u,
    EnableSleep = 0x00002000u,
    HasEnlargedShapeAabb = 0x00004000u,
    DirtyMass = 0x00008000u,
    EnableGyroscopicTorque = 0x00010000u,
    HasCustomMaxAngularVelocity = 0x00020000u,
    JustWoke = 0x00040000u,
    LastStepGpuSolved = 0x00080000u,
}

const u32 s_BodyFixedRotationFlags =
    cast<u32>(BodyFlags::LockAngularX)
    | cast<u32>(BodyFlags::LockAngularY)
    | cast<u32>(BodyFlags::LockAngularZ)
;

class BodyId{
    public u32 index = s_NullIndex;
    public u16 generation = 0u;
    public u16 worldIndex = 0u;

    public b8 valid()const{
        return this.index != s_NullIndex && this.generation != 0u && this.worldIndex != 0u;
    }

    public b8 operator==(in BodyId rhs)const{
        return this.index == rhs.index && this.generation == rhs.generation && this.worldIndex == rhs.worldIndex;
    }
}

class ShapeId{
    public u32 index = s_NullIndex;
    public u16 generation = 0u;
    public u16 worldIndex = 0u;

    public b8 valid()const{
        return this.index != s_NullIndex && this.generation != 0u && this.worldIndex != 0u;
    }

    public b8 operator==(in ShapeId rhs)const{
        return this.index == rhs.index && this.generation == rhs.generation && this.worldIndex == rhs.worldIndex;
    }
}

class JointId{
    public u32 index = s_NullIndex;
    public u16 generation = 0u;
    public u16 worldIndex = 0u;

