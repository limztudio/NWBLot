#include <impl/ecs_ui/toolkit/widgets/control_style_metrics.adhd>
#include <impl/ecs_ui/toolkit/widgets/hit_target_factory.adhd>
#include <impl/ecs_ui/toolkit/widgets/text_area_navigation.adhd>
#include <impl/ecs_ui/toolkit/edit/text_normalization.adhd>
#include <impl/ecs_ui/toolkit/edit/types.adhd>
#include <impl/ecs_ui/toolkit/builder.adhd>
#include <impl/ecs_ui/toolkit/widgets/control_visual_painter.adhd>
#include <impl/ecs_ui/toolkit/widgets/text_area.adhd>
#include <impl/ecs_ui/toolkit/widgets/style.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsValidTextAreaWheelLines(in f32 wheelLines){
    return IsFinite(wheelLines) && wheelLines > 0.0f;
}

f32 ResolveTextAreaBaseLineHeight(in b8 linesEmpty, in f32 fontSize, in f32 firstLineHeight){
    if(linesEmpty)
        return fontSize;
    return firstLineHeight;
}

b8 ShouldRestoreInitialTextAreaScroll(in b8 firstBinding, in b8 revealCaret){
    return firstBinding && !revealCaret;
}

u8 SelectNextTextAreaScrollStream(
    in b8 haveHorizontal,
    in u64 horizontalSequence,
    in b8 haveVertical,
    in u64 verticalSequence,
    in b8 haveAction,
    in u64 actionSequence
){
    if(haveHorizontal && (!haveVertical || horizontalSequence <= verticalSequence) && (!haveAction || horizontalSequence <= actionSequence))
        return 0u;
    if(haveVertical && (!haveAction || verticalSequence <= actionSequence))
        return 1u;
    return 2u;
}

b8 IsTooltipHoverEligible(
    in b8 optionsEnabled,
    in b8 anchorEnabled,
    in b8 windowFocused,
    in b8 pointerKnown,
    in b8 pointerBusy,
    in b8 primaryDown,
    in b8 secondaryDown,
    in b8 captureValid,
    in b8 acceptedEnabled,
    in PopupToken acceptedPopup,
    in PopupToken currentPopup,
    in b8 overAnchor
){
    return optionsEnabled && anchorEnabled && windowFocused && pointerKnown
        && !pointerBusy && !primaryDown && !secondaryDown && !captureValid
        && acceptedEnabled && acceptedPopup == currentPopup && overAnchor;
}

b8 ShouldDismissPaintedTooltip(
    in b8 anchorEnabled,
    in b8 pointerKnown,
    in b8 windowFocused,
    in b8 pointerBusy,
    in b8 primaryDown,
    in b8 secondaryDown,
    in PopupToken topPopup,
    in PopupToken statePopup,
    in Rect anchorRect,
    in Rect clip,
    in Point pointer
){
    return !anchorEnabled || !pointerKnown || !windowFocused || pointerBusy
        || primaryDown || secondaryDown
        || (topPopup.valid() && topPopup != statePopup)
        || !UiRectIntersectionContainsPoint(anchorRect, clip, pointer);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TextAreaEditActions : IEditActionSink{
    private in EditModel m_model;
    private in TextAreaState m_state;
    private in Context m_context;
    private u64 m_instanceGeneration;
    private u64 m_revision;

    public TextAreaEditActions(in EditModel model, in TextAreaState state, in Context context){
        this.m_model = model;
        this.m_state = state;
        this.m_context = context;
        this.m_instanceGeneration = model.instanceGeneration();
        this.m_revision = state.revision();
    }

    public b8 apply(mut EditModel model, in EditAction action, in b8 readOnly)override{
        return !this.m_context.failed() && SameAddress(model, this.m_model)
            && model.instanceGeneration() == this.m_instanceGeneration && this.m_state.revision() == this.m_revision
            && action <= EditAction::Abandon;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 Builder::tooltip(in StringView stableKey, in StringView anchorKey, in StringView text, mut TooltipState state, in TooltipOptions options){
    const auto anchorIndex = this.annotationAnchorIndex(anchorKey);
    if(this.panelDeclarationBlocked() || !anchorIndex.has_value() || this.m_scope.value().m_tooltips.size() >= s_LayoutMaxNodes){
        this.m_context.fail();
        return false;
    }
    mut BuilderItem anchor = this.m_scope.value().m_items[anchorIndex.value()];
    const auto widget = this.m_context.declare(stableKey, WidgetKind::Tooltip);
    if(!widget.has_value() || !this.m_context.claimState(widget.value(), state.instanceGeneration()))
        return false;
    if(BindTooltipOwner(widget.value().id, widget.value().declarationGeneration, state.m_owner, state.m_ownerDeclaration)){
        state.reset();
        state.m_owner = widget.value().id;
        state.m_ownerDeclaration = widget.value().declarationGeneration;
    }
    in InputRouter input = this.m_context.input();
    const auto accepted = input.findTarget(anchor.state.id, anchor.state.declarationGeneration);
    const auto hovered = input.findTarget(input.hover());
    const b8 overAnchor = hovered.has_value() && (hovered.value().id == anchor.state.id || hovered.value().owner == anchor.state.id);
    const b8 eligible = accepted.has_value() && IsTooltipHoverEligible(
        options.enabled,
        anchor.enabled,
        input.windowFocused(),
        input.pointerKnown(),
        this.m_pointerBusy,
        input.primaryDown(),
        input.secondaryDown(),
        input.capture().valid(),
        accepted.value().enabled,
        accepted.value().popup,
        this.m_context.popupToken(),
        overAnchor
    );
    if(!UpdateTooltipState(state, anchor.state.id, anchor.state.declarationGeneration, this.m_context.popupToken(), input.focusLossGeneration(), input.hoverActivityGeneration(), eligible, this.m_deltaSeconds, options)){
        this.m_context.fail();
        return false;
    }
    auto frame = this.makeTooltipFrame();
    frame.widget = widget.value();
    frame.anchor = anchor.state;
    frame.state = Optional<mut TooltipState>(state);
    frame.style = this.m_tooltipStyle;
    frame.options = options;
    frame.revision = state.revision();
    frame.anchorIndex = cast<u32>(anchorIndex.value());
    frame.layer = this.m_context.popupLayer() + 1u;
    const ShapeRequest request = this.textShapeRequest(text, this.m_style.fontSize);
    auto layout = this.m_text.layout(request);
    if(!layout.has_value()){
        this.m_context.fail();
        return false;
    }
    MoveInto<TextLayout>(frame.text, layout.value());
    anchor.annotated = true;
    mut Vector<BuilderTooltipFrame> tooltips = this.m_scope.value().m_tooltips;
    tooltips.emplace_back();
    MoveInto<BuilderTooltipFrame>(tooltips[tooltips.size() - 1u], frame);
    return true;
}

b8 Builder::paintTooltips(){
    ControlVisualPainter painter;
    for(mut BuilderTooltipFrame frame : this.m_scope.value().m_tooltips){
        if(!frame.state.has_value() || frame.state.value().revision() != frame.revision || frame.anchorIndex >= this.m_scope.value().m_items.size())
            return false;
        in BuilderItem anchor = this.m_scope.value().m_items[frame.anchorIndex];
        const Optional<LayoutBox> box = this.m_scope.value().m_layout.box(anchor.node);
        if(!box.has_value() || anchor.state.id != frame.anchor.id || anchor.state.declarationGeneration != frame.anchor.declarationGeneration)
            return false;
        if(!frame.state.value().visible())
            continue;
        const Rect clip = this.visibleClip(box.value().clip);
        in Point pointer = this.m_context.input().pointerPosition();
        in InputRouter input = this.m_context.input();
        if(ShouldDismissPaintedTooltip(
            anchor.enabled,
            input.pointerKnown(),
            input.windowFocused(),
            this.m_pointerBusy,
            input.primaryDown(),
            input.secondaryDown(),
            this.m_context.topPopupToken(),
            frame.state.value().m_popup,
            box.value().rectangle,
            clip,
            pointer
        )){
            if(!UpdateTooltipState(frame.state.value(), frame.anchor.id, frame.anchor.declarationGeneration, frame.state.value().m_popup, input.focusLossGeneration(), input.hoverActivityGeneration(), false, 0.0f, frame.options))
                return false;
            frame.revision = frame.state.value().revision();
            continue;
        }
        const auto background = this.region(frame.style.background, frame.style.fallback);
        if(!background.has_value())
            return false;
        const Insets padding = MaxUiPadding(frame.style.padding, background.value().padding);
        const auto textBounds = this.m_text.measure(frame.text, this.m_paint.displayMetrics());
        if(!textBounds.has_value())
            return false;
        const Point measured = Point(textBounds.value().width, textBounds.value().height);
        const PopupOptions options = BuildTooltipPopupOptions(box.value().rectangle, measured, padding, background.value(), frame.options);
        const auto placement = PlacePopup(options, this.m_paint.displayMetrics());
        if(!placement.has_value())
            return false;
        if(!painter.paintTooltipOverlay(this.m_paint, this.m_text, frame.layer, background.value().name, placement.value().bounds, padding, frame.text, textBounds.value(), frame.style.text) || frame.state.value().revision() != frame.revision)
            return false;
        frame.state.value().m_placement = placement.value();
    }
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


EditBoxResult Builder::textArea(in StringView stableKey, mut EditModel model, mut TextAreaState state, in TextAreaOptions options){
    if(this.itemDeclarationBlocked() || !IsValidTextAreaWheelLines(options.wheelLines) || model.textMode() != EditTextMode::Multiline){
        this.m_context.fail();
        return EditBoxResult();
    }
    if(!this.synchronizePopup()){
        EditBoxResult result;
        result.valid = true;
        return result;
    }
    this.m_declaring = true;
    BuilderOperationEnd finish(this.m_declaring);
    const auto widget = this.m_context.declare(stableKey, WidgetKind::TextArea);
    if(!widget.has_value())
        return EditBoxResult();
    if(!this.textAreaAvailable(model, state) || !this.m_context.claimState(widget.value(), model.instanceGeneration())){
        this.m_context.fail();
        return EditBoxResult();
    }
    if(!options.enabled)
        this.m_context.input().invalidateTarget(widget.value().id);
    const u64 stateRevision = state.revision();
    const u64 modelGeneration = model.instanceGeneration();
    EditBoxOptions editOptions;
    editOptions.width = options.width;
    editOptions.height = options.height;
    editOptions.enabled = options.enabled;
    editOptions.readOnly = options.readOnly;
    EditBoxResult result;
    result.valid = true;
    result.focused = options.enabled && this.m_context.input().focus() == widget.value().id;
    if(this.m_editHost.has_value()){
        TextAreaNavigationResolver navigation(this.m_text, this.m_context, state, this.m_style.fontSize, this.m_textScriptTag, StringView(this.m_textLanguage));
        TextAreaEditActions actions(model, state, this.m_context);
        result = this.m_editHost.value().editNavigated(widget.value(), editOptions, this.m_context.popupToken(), model, state.m_navigation, navigation, actions);
    }
    if(!result.valid || this.m_context.failed() || state.revision() != stateRevision || model.instanceGeneration() != modelGeneration){
        result.valid = false;
        this.m_context.fail();
        return result;
    }
    const Point requestedScroll = state.scroll();
    b8 firstBinding = false;
    ReconcileTextAreaVisualScrollState(
        modelGeneration,
        model.revision(),
        model.selectionGeneration(),
        model.compositionGeneration(),
        model.anchor(),
        model.caret(),
        result.focused,
        this.m_context.input().capture(),
        widget.value().id,
        state.m_compositionGeneration,
        state.m_visual.modelGeneration,
        state.m_visual.revision,
        state.m_visual.selectionGeneration,
        state.m_visual.anchor,
        state.m_visual.caret,
        state.m_visual.focused,
        state.m_visual.scroll,
        state.m_scrollY,
        state.m_revealCaret,
        state.m_visual.caretElapsed,
        firstBinding
    );
    BuilderTextAreaFrame frame;
    frame.wheelLines = options.wheelLines;
    frame.model = Optional<mut EditModel>(model);
    frame.state = Optional<mut TextAreaState>(state);
    frame.focused = result.focused;
    this.snapshotTextArea(frame);
    auto item = this.makeItem();
    item.style = this.m_style;
    item.editStyle = this.m_editStyle;
    item.scrollbarStyle = this.m_scrollbarStyle;
    item.state = widget.value();
    item.editOptions = editOptions;
    if(!this.prepareEditBox(result, model, state.m_visual, item) || !this.textAreaMatches(frame)){
        result.valid = false;
        this.m_context.fail();
        return result;
    }
    if(ShouldRestoreInitialTextAreaScroll(firstBinding, state.m_revealCaret)){
        state.m_visual.scroll = requestedScroll.x;
        state.m_scrollY = requestedScroll.y;
    }
    state.m_compositionGeneration = model.compositionGeneration();
    item.textArea = cast<u32>(this.m_scope.value().m_textAreas.size());
    LayoutNodeDesc description;
    description.width = options.width;
    description.height = options.height;
    description.intrinsicSize = ResolveEditIntrinsicSize(this.loadEditMinimumSize(), item.editView.visualBounds().height, item.padding);
    if(!this.addItemNode(description, item)){
        result.valid = false;
        return result;
    }
    frame.item = cast<u32>(this.m_scope.value().m_items.size());
    AppendOwned<BuilderItem>(this.m_scope.value().m_items, item);
    this.m_scope.value().m_textAreas.push_back(frame);
    return result;
}

b8 Builder::textAreaAvailable(in EditModel model, in TextAreaState state){
    for(usize index = 0u; index <= this.m_popupFrameCount; ++index){
        in BuilderScopeFrame scope = this.popupFrameAt(index);
        for(in auto frame : scope.m_textAreas){
            if((frame.model.has_value() && SameAddress(frame.model.value(), model)) || (frame.state.has_value() && SameAddress(frame.state.value(), state)))
                return false;
        }
    }
    return true;
}

void Builder::snapshotTextArea(mut BuilderTextAreaFrame frame){
    frame.stateRevision = frame.state.value().revision();
    frame.navigation = frame.state.value().navigation().snapshot();
    frame.modelStamp = frame.model.value().stamp();
}

b8 Builder::textAreaMatches(in BuilderTextAreaFrame frame)const{
    return
        this.popupAncestorsVisible() && frame.model.has_value() && frame.state.has_value()
        && frame.state.value().revision() == frame.stateRevision && frame.state.value().navigation().matches(frame.navigation)
        && frame.model.value().matchesStamp(frame.modelStamp)
        && frame.state.value().m_visual.matchesStamp(frame.modelStamp, frame.focused)
    ;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 Builder::paintTextArea(in BuilderItem item, in LayoutBox box){
    if(item.textArea >= this.m_scope.value().m_textAreas.size())
        return false;
    in BuilderTextAreaFrame frame = this.m_scope.value().m_textAreas[item.textArea];
    if(!this.textAreaMatches(frame))
        return false;
    mut TextAreaState state = frame.state.value();
    const Rect clip = this.visibleClip(box.clip);
    const f32 caretWidth = 1.0f / this.m_paint.displayMetrics().pixelScaleX;
    in Rect visualBounds = item.editView.visualBounds();
    const auto viewport = CalculateScrollViewportPlacement(box.rectangle, clip, item.padding, Point(visualBounds.width, visualBounds.height), caretWidth, state.scroll(), item.scrollbarStyle.thickness, item.scrollbarStyle.minimumThumb);
    if(!viewport.has_value())
        return false;
    in Vector<TextLine> lines = item.editView.layout().lines();
    f32 firstLineHeight = 0.0f;
    if(!lines.empty())
        firstLineHeight = lines[0u].height;
    const f32 lineHeight = ResolveTextAreaBaseLineHeight(lines.empty(), item.editView.layout().fontSize(), firstLineHeight);
    const auto stepResult = TryResolveTextAreaScrollStep(item.editView.layout().fontSize(), lineHeight, frame.wheelLines);
    if(!stepResult.has_value())
        return false;
    const Point step = stepResult.value();
    const ControlToken token = state.m_scrollInput.prepare(item.state, this.m_context.popupToken(), state.instanceGeneration(), state.revision(), frame.model.value().stamp(), item.editOptions.enabled, item.editOptions.readOnly, viewport.value(), step);
    this.m_context.input().fenceControl(item.state.id, item.state.declarationGeneration, token);
    if(!this.applyTextAreaScrollInput(item, frame, token))
        return false;
    const auto arranged = item.editView.arrangeViewport(box.rectangle, viewport.value().viewport, clip, state.scroll(), caretWidth, state.m_revealCaret);
    if(!arranged.has_value())
        return false;
    in EditBoxPlacement placement = arranged.value();
    if(!TryUpdateScrollViewportOffsets(Point(placement.scroll, placement.scrollY), state.m_scrollInput.placement))
        return false;
    if(!item.editView.paint(this.m_text, this.m_paint, this.m_skin.value(), placement, item.editStyle, item.editFlags) || !this.textAreaMatches(frame))
        return false;
    state.m_visual.placement = placement;
    state.m_visual.scroll = placement.scroll;
    state.m_scrollY = placement.scrollY;
    HitTargetFactory targets;
    const HitTarget target = targets.makeTextAreaHitTarget(
        box.rectangle,
        this.visibleClip(box.clip),
        item.editOptions.enabled,
        item.contextMenu,
        token,
        step,
        state.scrollbars()
    );
    if(!this.m_context.addTarget(item.state, target) || !this.paintTextAreaScrollbars(item, state.scrollbars(), clip, token))
        return false;
    const b8 published = !this.m_editHost.has_value() || this.m_editHost.value().publish(item.state, item.editView, placement, item.editOptions);
    if(!published || !this.textAreaMatches(frame))
        return false;
    return true;
}

b8 Builder::applyTextAreaScrollInput(in BuilderItem item, in BuilderTextAreaFrame frame, in ControlToken token){
    mut TextAreaState state = frame.state.value();
    const b8 enabled = item.editOptions.enabled;
    const auto horizontalId = TryMakeWidgetId(item.state.id, s_WidgetPartScrollHorizontalThumb);
    if(!horizontalId.has_value())
        return false;
    const auto verticalId = TryMakeWidgetId(item.state.id, s_WidgetPartScrollVerticalThumb);
    if(!verticalId.has_value())
        return false;
    auto horizontal = this.m_context.takePartPointerGesture(item.state, horizontalId.value(), enabled);
    b8 haveHorizontal = horizontal.has_value() && horizontal.value().control == token;
    auto vertical = this.m_context.takePartPointerGesture(item.state, verticalId.value(), enabled);
    b8 haveVertical = vertical.has_value() && vertical.value().control == token;
    auto action = this.m_context.takeControlAction(item.state, enabled, token);
    b8 haveAction = action.has_value();
    Point scroll = state.scroll();
    b8 manual = false;
    while(haveHorizontal || haveVertical || haveAction){
        u64 horizontalSequence = 0u;
        u64 verticalSequence = 0u;
        u64 actionSequence = 0u;
        if(haveHorizontal)
            horizontalSequence = horizontal.value().updateSequence;
        if(haveVertical)
            verticalSequence = vertical.value().updateSequence;
        if(haveAction)
            actionSequence = action.value().id.sequence;
        const u8 stream = SelectNextTextAreaScrollStream(
            haveHorizontal,
            horizontalSequence,
            haveVertical,
            verticalSequence,
            haveAction,
            actionSequence
        );
        if(stream == 0u){
            const auto dragged = TryDragScrollbarOffset(horizontal.value(), true);
            if(!dragged.has_value())
                return false;
            scroll.x = dragged.value();
            manual = true;
            horizontal = this.m_context.takePartPointerGesture(item.state, horizontalId.value(), enabled);
            haveHorizontal = horizontal.has_value() && horizontal.value().control == token;
        }
        else if(stream == 1u){
            const auto dragged = TryDragScrollbarOffset(vertical.value(), false);
            if(!dragged.has_value())
                return false;
            scroll.y = dragged.value();
            manual = true;
            vertical = this.m_context.takePartPointerGesture(item.state, verticalId.value(), enabled);
            haveVertical = vertical.has_value() && vertical.value().control == token;
        }
        else{
            if(!TryApplyTextAreaScrollControlAction(action.value(), state.scrollbars(), scroll, manual))
                return false;
            action = this.m_context.takeControlAction(item.state, enabled, token);
            haveAction = action.has_value();
        }
    }
    if(manual){
        state.m_visual.scroll = scroll.x;
        state.m_scrollY = scroll.y;
        state.m_revealCaret = false;
    }
    return true;
}

b8 Builder::paintTextAreaScrollbars(in BuilderItem item, in ScrollViewportPlacement placement, in Rect clip, in ControlToken token){
    const b8 enabled = item.editOptions.enabled;
    b8 horizontalHovered = false;
    b8 horizontalPressed = false;
    if(placement.horizontal.visible){
        const auto thumbId = TryMakeWidgetId(item.state.id, s_WidgetPartScrollHorizontalThumb);
        if(!thumbId.has_value())
            return false;
        horizontalHovered = this.m_context.input().hover() == thumbId.value();
        horizontalPressed = this.m_context.input().capture() == thumbId.value();
    }
    b8 verticalHovered = false;
    b8 verticalPressed = false;
    if(placement.vertical.visible){
        const auto thumbId = TryMakeWidgetId(item.state.id, s_WidgetPartScrollVerticalThumb);
        if(!thumbId.has_value())
            return false;
        verticalHovered = this.m_context.input().hover() == thumbId.value();
        verticalPressed = this.m_context.input().capture() == thumbId.value();
    }
    ControlVisualPainter painter;
    if(!painter.paintTextAreaScrollbarsVisual(
        this.m_paint,
        this.m_skin.value(),
        item.scrollbarStyle,
        placement,
        clip,
        enabled,
        horizontalHovered,
        horizontalPressed,
        verticalHovered,
        verticalPressed
    ))
        return false;
    if(!enabled)
        return true;
    if(!this.paintTextAreaScrollbarAxis(item, placement.horizontal, clip, token, true, s_TextAreaScrollHorizontalBefore, s_TextAreaScrollHorizontalAfter, s_WidgetPartScrollHorizontalBefore, s_WidgetPartScrollHorizontalAfter, s_WidgetPartScrollHorizontalThumb)
        || !this.paintTextAreaScrollbarAxis(item, placement.vertical, clip, token, false, s_TextAreaScrollVerticalBefore, s_TextAreaScrollVerticalAfter, s_WidgetPartScrollVerticalBefore, s_WidgetPartScrollVerticalAfter, s_WidgetPartScrollVerticalThumb))
        return false;
    HitTargetFactory targets;
    if(placement.corner.width > 0.0f && placement.corner.height > 0.0f){
        const HitTarget target = targets.makeScrollbarCornerHitTarget(placement.corner, clip, token);
        const auto cornerId = TryMakeWidgetId(item.state.id, s_WidgetPartScrollCorner);
        if(!cornerId.has_value() || !this.m_context.addPartTarget(item.state, cornerId.value(), target))
            return false;
    }
    return true;
}

b8 Builder::paintTextAreaScrollbarAxis(in BuilderItem item, in ScrollbarPlacement bar, in Rect clip, in ControlToken token, in b8 horizontal, in u32 beforeAction, in u32 afterAction, in StringView beforeKey, in StringView afterKey, in StringView thumbKey){
    if(!bar.visible)
        return true;
    HitTargetFactory targets;
    Rect beforeRect;
    Rect afterRect;
    ResolveScrollbarBeforeAfterRects(bar, horizontal, beforeRect, afterRect);
    const HitTarget beforeTarget = targets.makeScrollbarTrackActionHitTarget(
        beforeRect,
        clip,
        token,
        beforeAction
    );
    const auto beforeId = TryMakeWidgetId(item.state.id, beforeKey);
    if(!beforeId.has_value() || !this.m_context.addPartTarget(item.state, beforeId.value(), beforeTarget))
        return false;
    const HitTarget afterTarget = targets.makeScrollbarTrackActionHitTarget(
        afterRect,
        clip,
        token,
        afterAction
    );
    const auto afterId = TryMakeWidgetId(item.state.id, afterKey);
    if(!afterId.has_value() || !this.m_context.addPartTarget(item.state, afterId.value(), afterTarget))
        return false;
    const HitTarget thumbTarget = targets.makeScrollbarThumbHitTarget(bar, clip, token, horizontal);
    const auto thumbId = TryMakeWidgetId(item.state.id, thumbKey);
    if(!thumbId.has_value() || !this.m_context.addPartTarget(item.state, thumbId.value(), thumbTarget))
        return false;
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

