////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_ui/toolkit/images/image_source.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<SharedImageSource> LoadImageSource(in SharedPool pool, in AssetManager assets, in AssetRef<Texture> identity){
    if(!ValidateImageSourceLoadIdentity(identity.valid(), Name(), Name()))
        return MakeUnexpected(Failure());
    const Expected<UniquePtr<Texture>> loaded = LoadTypedAssetSync<Texture>(assets, identity.name(), "LoadImageSource");
    if(!loaded.has_value())
        return MakeUnexpected(loaded.error());
    if(!loaded.value().valid())
        return MakeUnexpected(Failure());
    in Texture texture = loaded.value().deref();
    if(!ValidateImageSourceLoadIdentity(true, texture.virtualPath(), identity.name()))
        return MakeUnexpected(Failure());
    return MakeImageSource(pool, texture);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

