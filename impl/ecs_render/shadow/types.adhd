u32 ResolveSoftShadowLightSlotRangeCount(in u32 softShadowSlotMask){
    u32 slotRangeCount = 0u;
    for(u32 slot = 0u; slot < s_SceneShadowSlotCount; ++slot){
        if((softShadowSlotMask & (1u << slot)) != 0u)
            slotRangeCount = slot + 1u;
    }
    return slotRangeCount;
}


