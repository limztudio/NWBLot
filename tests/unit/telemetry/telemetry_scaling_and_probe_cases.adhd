void VerifyTelemetry_PacketStatisticsDuplicateRejectionPreservesSeededTables(){
    TelemetryTestArena testArena = TelemetryTestArena();
    StatisticsFixture fixture = StatisticsFixture(testArena.arena);
    PrepareFixture(64u, 2u, fixture);
    ASSERT_TRUE(AppendFixtureStatistics(64u, 2u, testArena.scratchArena, fixture));
    FrameGraphBuilder builder = FrameGraphBuilder(testArena.scratchArena, fixture.nodes, fixture.edges, fixture.pendingEdges, fixture.queues, fixture.packets);
    const FrameGraphPacketSubmissionStatisticsRecord packet = fixture.packets[17u];
    const FrameGraphNodeHandle owner = MakeNodeHandle(packet.ownerNodeIndex);
    EXPECT_FALSE(builder.addPacketSubmissionStatistics(owner, packet));
    FrameGraphPacketSubmissionStatisticsRecord changedDuplicate = packet;
    if(packet.queue.index == 1u)
        changedDuplicate.queue.index = 3u;
    else
        changedDuplicate.queue.index = 1u;
    if(packet.queueClass == FrameGraphQueueClass::Graphics)
        changedDuplicate.queueClass = FrameGraphQueueClass::Compute;
    else
        changedDuplicate.queueClass = FrameGraphQueueClass::Graphics;
    EXPECT_FALSE(builder.addPacketSubmissionStatistics(owner, changedDuplicate));
    EXPECT_FALSE(builder.addPhysicalQueueRuntimeStatistics(MakeNodeHandle(0u), fixture.queues[0u].statistics));
    EXPECT_EQ(fixture.packets.size(), 64u);
    EXPECT_EQ(fixture.queues.size(), 4u);
}

void VerifyTelemetry_PacketStatisticsPreserveOptionalQueueCoverageAndRejectMismatchedTotals(){
    TelemetryTestArena testArena = TelemetryTestArena();
    StatisticsFixture fixture = StatisticsFixture(testArena.arena);
    PrepareFixture(64u, 2u, fixture);
    ASSERT_TRUE(AppendFixtureStatistics(64u, 2u, testArena.scratchArena, fixture));
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    fixture.queues.erase(fixture.queues.begin());
    ASSERT_TRUE(BuildFrameGraphPayload(918u, fixture.nodes, fixture.edges, fixture.queues, fixture.packets, testArena.scratchArena, payload));
    native(mut testArena, in payload){
        const auto decoded = Core::Telemetry::ParseFrameGraphPayload(testArena.arena, testArena.scratchArena, payload.data(), payload.size());
        ASSERT_TRUE(decoded.has_value());
        ASSERT_EQ(decoded.value().physicalQueueRuntimeStatistics.size(), 3u);
    }
    const FrameGraphPacketSubmissionStatisticsRecord original = fixture.packets[0u];
    if(original.queue.index == 1u)
        fixture.packets[0u].queue.index = 3u;
    else
        fixture.packets[0u].queue.index = 1u;
    if(original.queueClass == FrameGraphQueueClass::Graphics)
        fixture.packets[0u].queueClass = FrameGraphQueueClass::Compute;
    else
        fixture.packets[0u].queueClass = FrameGraphQueueClass::Graphics;
    EXPECT_FALSE(BuildFrameGraphPayload(918u, fixture.nodes, fixture.edges, fixture.queues, fixture.packets, testArena.scratchArena, payload));
    EXPECT_TRUE(payload.empty());
}

