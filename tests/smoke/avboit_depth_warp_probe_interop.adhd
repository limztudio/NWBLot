////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_AvboitDepthWarpGuardWords = 4u;
const u32 s_AvboitDepthWarpBatchSize = 64u;
const u32 s_AvboitDepthWarpSentinel = 0xa5f07c39u;
const u32 s_AvboitDepthWarpWarpWords = s_AvboitMaxVirtualCount + s_AvboitDepthWarpGuardWords;
const u32 s_AvboitDepthWarpControlWords = s_AvboitProbeControlWordCount + s_AvboitDepthWarpGuardWords;
const u32 s_AvboitDepthWarpResultWords = s_AvboitDepthWarpWarpWords + s_AvboitDepthWarpControlWords;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Array<u32, 4u> BuildAvboitDepthWarpFrameDims(in u32 ordinal){
    Array<u32, 4u> dims;
    dims[0u] = 1000u + ordinal % 997u;
    dims[1u] = 300u + ordinal % 251u;
    dims[2u] = (dims[0u] + 2u) / 3u;
    dims[3u] = (dims[1u] + 3u) / 4u;
    return dims;
}

b8 VerifyDepthWarpProbeCaseWords(in AvboitDepthWarpCase probe, in u32 ordinal, in Span<u32> resultWords){
    const Array<u32, 4u> frameDims = BuildAvboitDepthWarpFrameDims(ordinal);
    const AvboitDepthWarpResult oracle = BuildAvboitDepthWarpOracle(probe, frameDims);
    for(u32 word = 0u; word < s_AvboitDepthWarpResultWords; ++word){
        u32 expected = s_AvboitDepthWarpSentinel;
        if(word < probe.virtualCount)
            expected = oracle.warp[word];
        else if(word >= s_AvboitDepthWarpWarpWords && word < s_AvboitDepthWarpWarpWords + s_AvboitProbeControlWordCount)
            expected = oracle.control[word - s_AvboitDepthWarpWarpWords];
        if(resultWords[word] != expected){
            error(
                "AvboitDepthWarpProbe: mismatch case {} scenario {} virtual {} physical {} word {} expected {} observed {}"
                , ordinal
                , probe.scenario
                , probe.virtualCount
                , probe.physicalCount
                , word
                , expected
                , resultWords[word]
            );
            return false;
        }
    }
    return true;
}

RendererAvboitPushConstants BuildAvboitDepthWarpPush(in AvboitDepthWarpCase probe, in u32 ordinal, in u32 slots){
    RendererAvboitPushConstants push;
    push.frame = BuildAvboitDepthWarpFrameDims(ordinal);
    push.volume[0u] = probe.virtualCount;
    push.volume[1u] = probe.physicalCount;
    push.volume[3u] = (probe.virtualCount + 31u) / 32u;
    push.heapSlots[0u] = slots;
    return push;
}

class DepthWarpProbeBatchTask{
    public BufferHandle coverage = BufferHandle();
    public BufferHandle warp = BufferHandle();
    public BufferHandle control = BufferHandle();
    public BufferHandle slots = BufferHandle();
    public BufferHandle readback = BufferHandle();
    public ComputePipelineHandle pipeline = ComputePipelineHandle();
    public mut GpuDescriptorHeap heap;
    public Span<AvboitDepthWarpCase> cases;
    public u32 firstCase = 0u;
    public u32 slotsIndex = 0u;

    public DepthWarpProbeBatchTask(mut GpuDescriptorHeap heap, in Span<AvboitDepthWarpCase> cases){
        this.heap = heap;
        this.cases = cases;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return ComputeTransferProbeCommands(); }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        for(u32 index = 0u; index < this.cases.size(); ++index){
            in AvboitDepthWarpCase probe = this.cases[index];
            commandList.setBufferState(this.coverage.deref(), ResourceStates::CopyDest);
            commandList.setBufferState(this.warp.deref(), ResourceStates::CopyDest);
            commandList.setBufferState(this.control.deref(), ResourceStates::CopyDest);
            commandList.commitBarriers();
            if(!commandList.tryWriteBuffer(this.coverage.deref(), probe.coverage)){
                error("AvboitDepthWarpProbe: coverage upload failed at case {}", this.firstCase + index);
                return false;
            }
            commandList.clearBufferUInt(this.warp.deref(), s_AvboitDepthWarpSentinel);
            commandList.clearBufferUInt(this.control.deref(), s_AvboitDepthWarpSentinel);
            commandList.setBufferState(this.coverage.deref(), ResourceStates::UnorderedAccess);
            commandList.setBufferState(this.warp.deref(), ResourceStates::UnorderedAccess);
            commandList.setBufferState(this.control.deref(), ResourceStates::UnorderedAccess);
            commandList.commitBarriers();

            ComputeState state;
            state.setPipeline(this.pipeline.deref());
            commandList.setComputeState(state);
            this.heap.bindCompute(commandList, this.pipeline.deref());
            const auto push = BuildAvboitDepthWarpPush(probe, this.firstCase + index, this.slotsIndex);
            commandList.setPushConstants(push);
            commandList.dispatch(s_AvboitDepthWarpDispatchGroupCountX, 1u, 1u);

            commandList.setBufferState(this.warp.deref(), ResourceStates::CopySource);
            commandList.setBufferState(this.control.deref(), ResourceStates::CopySource);
            commandList.commitBarriers();
            const u64 offset = cast<u64>(index) * s_AvboitDepthWarpResultWords * size_of<u32>();
            commandList.copyBuffer(this.readback.deref(), offset, this.warp.deref(), 0u, s_AvboitDepthWarpWarpWords * size_of<u32>());
            commandList.copyBuffer(this.readback.deref(), offset + s_AvboitDepthWarpWarpWords * size_of<u32>(), this.control.deref(), 0u, s_AvboitDepthWarpControlWords * size_of<u32>());
            if(commandList.commandRecordingFailed()){
                error("AvboitDepthWarpProbe: command recording failed at case {}", this.firstCase + index);
                return false;
            }
        }
        commandList.setBufferState(this.coverage.deref(), ResourceStates::CopyDest);
        commandList.setBufferState(this.warp.deref(), ResourceStates::CopyDest);
        commandList.setBufferState(this.control.deref(), ResourceStates::CopyDest);
        commandList.commitBarriers();
        return !commandList.commandRecordingFailed();
    }
}

[cpp_unwind]
Expected<GpuTaskId> DeclareDepthWarpBatch(in DepthWarpProbeBatchTask payload, mut GpuTaskGraph graph){
    const Array<BufferHandle, 5u> buffers(payload.coverage, payload.warp, payload.control, payload.slots, payload.readback);
    const Array<StringView, 5u> labels("Depth warp probe coverage", "Depth warp probe LUT", "Depth warp probe control", "Depth warp probe heap slots", "Depth warp probe readback");
    Array<GpuTaskResourceUse, 5u> uses;
    for(u32 index = 0u; index < buffers.size(); ++index){
        ResourceStates state = ResourceStates::CopyDest;
        GpuTaskResourceAccess access = GpuTaskResourceAccess::ReadWrite;
        if(index == 3u){
            state = ResourceStates::ConstantBuffer;
            access = GpuTaskResourceAccess::Read;
        }
        if(index == 4u)
            access = GpuTaskResourceAccess::Write;
        GpuGraphResourceDesc desc;
        desc.setIdentity(buffers[index].deref().getCreationDescription().debugName).setMarkerLabel(labels[index]).setType(GpuGraphResourceType::Buffer)
            .setInitialState(state).setExternalFinalState(state);
        const auto imported = graph.importBuffer(buffers[index], desc);
        if(!imported.has_value()){
            error("AvboitDepthWarpProbe: graph buffer import failed at index {}", index);
            return MakeUnexpected(Failure());
        }
        if(!imported.value().valid()){
            error("AvboitDepthWarpProbe: invalid graph resource at index {}", index);
            return MakeUnexpected(Failure());
        }
        uses[index].resource = imported.value();
        uses[index].requiredState = state;
        uses[index].access = access;
    }
    GpuTaskDesc desc;
    desc.setIdentity(s_SmokeNameAvboitDepthWarpProbe).setMarkerLabel("AVBOIT depth warp boundary probe").setResourceUses(uses);
    DepthWarpProbeBatchTask recorded = payload;
    const auto task = graph.addPayloadTask(desc, recorded);
    if(!task.has_value() || !task.value().valid()){
        error("AvboitDepthWarpProbe: graph task declaration failed at case {}", payload.firstCase);
        return MakeUnexpected(Failure());
    }
    return task;
}

class DepthWarpUnfocusedPass : IRenderPass{
    public DepthWarpUnfocusedPass(mut GraphicsRuntime graphics){}
    public b8 shouldRenderUnfocused()override{ return true; }
}

Expected<BufferHandle> CreateDepthWarpProbeBuffer(in Name name, in u32 words, in b8 readback, mut GraphicsRuntime graphics){
    BufferDesc desc;
    desc.setDebugName(name).setByteSize(words * size_of<u32>()).setStructStride(size_of<u32>()).setCanHaveUAVs(!readback).enableAutomaticStateTracking(ResourceStates::CopyDest);
    if(readback)
        desc.setCpuAccess(CpuAccessMode::Read);
    return graphics.createBuffer(desc);
}

b8 InitializeDepthWarpProbeProject(
    mut ProjectRuntimeContext context,
    mut ActiveSceneSubsystems sceneSubsystems,
    mut Vector<AvboitDepthWarpCase> cases,
    mut ShaderHandle outShader,
    mut BindingLayoutHandle outPushLayout,
    mut ComputePipelineHandle outPipeline,
    mut BufferHandle outCoverage,
    mut BufferHandle outWarp,
    mut BufferHandle outControl,
    mut BufferHandle outSlots,
    mut BufferHandle outReadback,
    mut Array<GpuDescriptorHandle, 4u> outDescriptors,
    mut DepthWarpUnfocusedPass unfocusedPass,
    mut b8 outUnfocusedPassRegistered
){
    BuildAvboitDepthWarpCases(cases);
    if(cases.size() != cast<usize>(s_AvboitTotalCaseCount)){
        error("AvboitDepthWarpProbe: case manifest count mismatch {}", cases.size());
        return false;
    }
    mut GraphicsRuntime graphics = context.graphics;
    mut Device device = graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized()){
        error("AvboitDepthWarpProbe: bindless heap is unavailable");
        return false;
    }
    if(!sceneSubsystems.loadProjectStartScene(context.assetManager))
        return false;
    const auto transparent = sceneSubsystems.findSubsystem<TransparentSubsystem>();
    if(!transparent.has_value() || !transparent.value().avboitDepthWarpCs.valid())
        return false;
    if(!Load<ComputeShader, ShaderArchivePathResolver>(transparent.value().avboitDepthWarpCs.name(), s_DefaultVariant,
        s_SmokeNameAvboitDepthWarpProbe, "AvboitDepthWarpProbe", graphics, context.assetManager, context.shaderPathResolver, Optional<Name>(), outShader))
        return false;
    if(!EnsurePushConstantBindingLayout(device, size_of<RendererAvboitPushConstants>(), ShaderTypeMask::Compute, outPushLayout)){
        error("AvboitDepthWarpProbe: push layout creation failed");
        return false;
    }
    const b8 pipelineReady = CreateHeapComputePipeline(device, outShader, outPushLayout, false, outPipeline);
    const auto coverage = CreateDepthWarpProbeBuffer(s_SmokeNameDepthWarpProbeCoverage, s_AvboitCoverageWords, false, graphics);
    const auto warp = CreateDepthWarpProbeBuffer(s_SmokeNameDepthWarpProbeWarp, s_AvboitDepthWarpWarpWords, false, graphics);
    const auto control = CreateDepthWarpProbeBuffer(s_SmokeNameDepthWarpProbeControl, s_AvboitDepthWarpControlWords, false, graphics);
    const auto readback = CreateDepthWarpProbeBuffer(s_SmokeNameDepthWarpProbeReadback, s_AvboitDepthWarpBatchSize * s_AvboitDepthWarpResultWords, true, graphics);
    if(!pipelineReady || !coverage.has_value() || !warp.has_value() || !control.has_value() || !readback.has_value()){
        error("AvboitDepthWarpProbe: pipeline or buffer creation failed");
        return false;
    }
    outCoverage = coverage.value();
    outWarp = warp.value();
    outControl = control.value();
    outReadback = readback.value();
    const Array<BufferHandle, 3u> buffers(outCoverage, outWarp, outControl);
    for(u32 index = 0u; index < buffers.size(); ++index){
        const auto descriptor = heap.allocate(GpuDescriptorClass::StorageBuffer);
        if(descriptor.has_value())
            outDescriptors[index] = descriptor.value();
        if(!descriptor.has_value() || !heap.write(outDescriptors[index], DescriptorWriteItemStructuredBufferUav(0u, buffers[index].deref()))){
            error("AvboitDepthWarpProbe: storage descriptor setup failed at index {}", index);
            return false;
        }
    }
    Array<DeferredBindlessResourceSlots, 1u> slots;
    slots[0u].avboitCoverage = outDescriptors[0u].slot();
    slots[0u].avboitDepthWarp = outDescriptors[1u].slot();
    slots[0u].avboitControl = outDescriptors[2u].slot();
    StandaloneBufferSetupDesc setup;
    setup.bufferDesc.setDebugName(s_SmokeNameDepthWarpProbeSlots).setByteSize(size_of<DeferredBindlessResourceSlots>()).setIsConstantBuffer(true)
        .enableAutomaticStateTracking(ResourceStates::ConstantBuffer);
    setup.queue = CommandQueue::Graphics;
    setup.setData<DeferredBindlessResourceSlots>(Span<DeferredBindlessResourceSlots>(slots));
    const auto slotsBuffer = graphics.standaloneGraph().setupBuffer(setup);
    if(slotsBuffer.has_value())
        outSlots = slotsBuffer.value();
    const auto uniform = heap.allocate(GpuDescriptorClass::UniformBuffer);
    if(uniform.has_value())
        outDescriptors[3u] = uniform.value();
    if(!slotsBuffer.has_value() || !uniform.has_value() || !heap.write(outDescriptors[3u], DescriptorWriteItemConstantBuffer(0u, outSlots.deref()))){
        error("AvboitDepthWarpProbe: slot payload setup failed");
        return false;
    }
    graphics.addRenderPassToBack(unfocusedPass);
    [essential] info(
        "AvboitDepthWarpProbe: manifest boundary={} exhaustive={} randomized={} total={} seed=0x6b47c2d1"
        , s_AvboitBoundaryCaseCount
        , s_AvboitExhaustiveCaseCount
        , s_AvboitRandomCaseCount
        , s_AvboitTotalCaseCount
    );
    outUnfocusedPassRegistered = true;
    return true;
}

b8 CompareDepthWarpProbeBatch(mut Device device, in DepthWarpProbeBatchTask payload){
    Vector<u32> words;
    words.resize(payload.cases.size() * s_AvboitDepthWarpResultWords);
    if(!device.readMappedBuffer(payload.readback.deref(), words)){
        error("AvboitDepthWarpProbe: readback map failed at case {}", payload.firstCase);
        return false;
    }
    const Span<u32> result = Span<u32>(words);
    for(u32 index = 0u; index < payload.cases.size(); ++index){
        if(!VerifyDepthWarpProbeCaseWords(payload.cases[index], payload.firstCase + index,
            result.subspan(index * s_AvboitDepthWarpResultWords, s_AvboitDepthWarpResultWords)))
            return false;
    }
    return true;
}

b8 RunDepthWarpProbeProjectUpdate(
    mut ProjectRuntimeContext context,
    in ActiveSceneSubsystems sceneSubsystems,
    in Vector<AvboitDepthWarpCase> cases,
    in BufferHandle coverage,
    in BufferHandle warp,
    in BufferHandle control,
    in BufferHandle slots,
    in BufferHandle readback,
    in ComputePipelineHandle pipeline,
    in Array<GpuDescriptorHandle, 4u> descriptors,
    mut b8 outCompleted
){
    mut GraphicsRuntime graphics = context.graphics;
    mut Device device = graphics.getDevice();
    const Span<AvboitDepthWarpCase> allCases = Span<AvboitDepthWarpCase>(cases);
    for(u32 firstCase = 0u; firstCase < cases.size(); firstCase += s_AvboitDepthWarpBatchSize){
        const u32 count = Min(s_AvboitDepthWarpBatchSize, cast<u32>(cases.size()) - firstCase);
        DepthWarpProbeBatchTask payload(device.getDescriptorHeap(), allCases.subspan(firstCase, count));
        payload.coverage = coverage;
        payload.warp = warp;
        payload.control = control;
        payload.slots = slots;
        payload.readback = readback;
        payload.pipeline = pipeline;
        payload.firstCase = firstCase;
        payload.slotsIndex = descriptors[3u].slot();
        const auto token = graphics.standaloneGraph().submitStandaloneTaskGraph(
            lambda[in payload](mut GpuTaskGraph graph) -> Expected<GpuTaskId>{ return DeclareDepthWarpBatch(payload, graph); }, GpuPhysicalQueueId());
        if(!token.has_value()){
            error("AvboitDepthWarpProbe: batch submission failed at case {}", firstCase);
            return false;
        }
        if(!device.waitForSubmissionToken(token.value())){
            error("AvboitDepthWarpProbe: batch completion wait failed at case {}", firstCase);
            return false;
        }
        if(!CompareDepthWarpProbeBatch(device, payload))
            return false;
    }
    if(!RunAvboitIntegrationProbe(sceneSubsystems, context) || !RunRefractionTileProbe(sceneSubsystems, context) || !RunOpticalBoundsProbe(sceneSubsystems, context))
        return false;
    outCompleted = true;
    [essential] info("AvboitDepthWarpProbe: passed {} cases with full LUT/control comparison and sentinel tails", s_AvboitTotalCaseCount);
    context.requestQuit();
    return true;
}

void FreeDepthWarpProbeDescriptors(mut ProjectRuntimeContext context, mut Array<GpuDescriptorHandle, 4u> descriptors){
    for(usize i = 0u; i < descriptors.size(); ++i){
        if(descriptors[i].valid()){
            context.graphics.getDevice().getDescriptorHeap().free(descriptors[i]);
            descriptors[i] = GpuDescriptorHandleInvalid();
        }
    }
}


