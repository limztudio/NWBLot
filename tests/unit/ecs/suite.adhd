extern thread_local b8 s_EcsCallerThread;

FOUNDATION_INLINE void SetCallerThreadFlag(const b8 value)noexcept{
    s_EcsCallerThread = value;
}

[[nodiscard]] FOUNDATION_INLINE b8 IsCallerThreadFlagSet()noexcept{
    return s_EcsCallerThread;
}

[[nodiscard]] FOUNDATION_INLINE CpuTaskOptions MainThreadTaskOptions()noexcept{
    return CpuTaskOptions{ .target = ::NWB::Core::CpuTaskTarget::MainThread };
}

[[nodiscard]] FOUNDATION_INLINE CpuTaskOptions InvalidTargetTaskOptions()noexcept{
    return CpuTaskOptions{ .target = static_cast<::NWB::Core::CpuTaskTarget::Enum>(::NWB::Core::CpuTaskTarget::MainThread + 1u) };
}

template<typename T>
[[nodiscard]] FOUNDATION_INLINE usize ComponentAddress(const T& component)noexcept{
    return reinterpret_cast<usize>(AddressOf(component));
}

template<typename T>
[[nodiscard]] FOUNDATION_INLINE b8 HasTryComponent(World& world, const ::NWB::Core::ECS::EntityID entityId)noexcept{
    return world.tryGetComponent<T>(entityId) != nullptr;
}

template<typename T>
[[nodiscard]] FOUNDATION_INLINE b8 HasConstTryComponent(const World& world, const ::NWB::Core::ECS::EntityID entityId)noexcept{
    return world.tryGetComponent<T>(entityId) != nullptr;
}

template<typename T>
[[nodiscard]] FOUNDATION_INLINE b8 TryComponentMatches(World& world, const ::NWB::Core::ECS::EntityID entityId, const T& expected)noexcept{
    return world.tryGetComponent<T>(entityId) == AddressOf(expected);
}

template<typename T>
[[nodiscard]] FOUNDATION_INLINE b8 ConstTryComponentMatches(const World& world, const ::NWB::Core::ECS::EntityID entityId, const T& expected)noexcept{
    return world.tryGetComponent<T>(entityId) == AddressOf(expected);
}

struct AddressTrapComponent{
public:
    mutable u32 addressCalls = 0u;


public:
    [[nodiscard]] AddressTrapComponent* operator&(){ ++addressCalls; throw 37u; }

    [[nodiscard]] const AddressTrapComponent* operator&()const{ ++addressCalls; throw 41u; }
};

struct alignas(32) OverAlignedComponent{
    Array<u8, 32> value{};
};
inline constexpr usize s_OverAlignedComponentAlignment = alignof(OverAlignedComponent);

template<usize... Is>
FOUNDATION_INLINE Array<usize, sizeof...(Is)> RegisterPoolSlotTypes(IndexSequence<Is...>)noexcept{
    return { NWB::Core::ECS::ComponentType<PoolSlotComponent<Is>>()... };
}

[[nodiscard]] FOUNDATION_INLINE Array<usize, 64> RegisterPoolSlotTypes64()noexcept{
    return RegisterPoolSlotTypes(IndexSequence<
        0u, 1u, 2u, 3u, 4u, 5u, 6u, 7u, 8u, 9u, 10u, 11u, 12u, 13u, 14u, 15u,
        16u, 17u, 18u, 19u, 20u, 21u, 22u, 23u, 24u, 25u, 26u, 27u, 28u, 29u, 30u, 31u,
        32u, 33u, 34u, 35u, 36u, 37u, 38u, 39u, 40u, 41u, 42u, 43u, 44u, 45u, 46u, 47u,
        48u, 49u, 50u, 51u, 52u, 53u, 54u, 55u, 56u, 57u, 58u, 59u, 60u, 61u, 62u, 63u
    >{});
}

struct MoveOnlyMessage{
    u32 value = 0u;


public:
    explicit MoveOnlyMessage(u32 v)noexcept
        : value(v)
    {}
    MoveOnlyMessage(const MoveOnlyMessage&) = delete;
    MoveOnlyMessage(MoveOnlyMessage&& rhs)noexcept
        : value(rhs.value)
    {
        rhs.value = 0u;
    }


public:
    MoveOnlyMessage& operator=(const MoveOnlyMessage&) = delete;

    MoveOnlyMessage& operator=(MoveOnlyMessage&& rhs)noexcept{
        if(this != &rhs){
            value = rhs.value;
            rhs.value = 0u;
        }
        return *this;
    }
};

struct ThrowingConstructionComponent{
    u32 value;


public:
    ThrowingConstructionComponent(b8 reject, u32 valueArg)
        : value(valueArg)
    {
        if(reject)
            throw 61u;
    }
};

struct ThrowingMoveAssignmentComponent{
    b8& rejectMove;
    u32 value;


public:
    ThrowingMoveAssignmentComponent(b8& rejectMoveArg, u32 valueArg)noexcept
        : rejectMove(rejectMoveArg)
        , value(valueArg)
    {}
    ThrowingMoveAssignmentComponent(const ThrowingMoveAssignmentComponent&) = delete;
    ThrowingMoveAssignmentComponent(ThrowingMoveAssignmentComponent&&)noexcept = default;


public:
    ThrowingMoveAssignmentComponent& operator=(const ThrowingMoveAssignmentComponent&) = delete;

    ThrowingMoveAssignmentComponent& operator=(ThrowingMoveAssignmentComponent&& rhs){
        if(rejectMove)
            throw 67u;
        value = rhs.value;
        return *this;
    }
};

struct ThrowingMoveMessage{
    b8& rejectMove;
    u32& moveAttempts;
    u32& destructions;


public:
    ThrowingMoveMessage(b8& rejectMoveArg, u32& moveAttemptsArg, u32& destructionsArg)noexcept
        : rejectMove(rejectMoveArg)
        , moveAttempts(moveAttemptsArg)
        , destructions(destructionsArg)
    {}
    ThrowingMoveMessage(const ThrowingMoveMessage&) = delete;
    ThrowingMoveMessage(ThrowingMoveMessage&& rhs)
        : rejectMove(rhs.rejectMove)
        , moveAttempts(rhs.moveAttempts)
        , destructions(rhs.destructions)
    {
        ++moveAttempts;
        if(rejectMove)
            throw 73u;
    }
    ~ThrowingMoveMessage()noexcept{ ++destructions; }


public:
    ThrowingMoveMessage& operator=(const ThrowingMoveMessage&) = delete;

    ThrowingMoveMessage& operator=(ThrowingMoveMessage&&) = delete;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


