////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const SmokeMeshRef s_GiGroundMesh = "project/meshes/shadow_plane";
const SmokeMaterialRef s_GiGroundOpaqueMaterial = "project/smoke/transparent_multi/materials/ground";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class GiTestSmokeProjectImpl : IProjectEntryCallbacks{
    public GiTestSmokeProjectImpl(mut ProjectRuntimeContext context){
        this.m_context = context;
        this.m_world = CreateSmokeRenderWorldOrDie(GiTestProjectName(), context);
        this.m_csgGiScene = CsgGiScene(context);
        this.m_gpuPassTimingProbe = GpuPassTimingProbe(GiTestProjectName());
    }

    public ~GiTestSmokeProjectImpl(){
        this.destroyWorld();
    }

    public b8 shouldCaptureComplex()const{
        return this.m_complexLiveWarmupComplete;
    }

    public b8 onStartup()override{
        Expected<b8> csgGi = false;
        native(mut csgScene = this.m_csgGiScene, mut world = this.m_world, mut csgGi){
            csgGi = csgScene.start(*world);
        }
        if(!csgGi.has_value())
            return false;
        if(csgGi.value())
            return true;

        this.m_resolveSwitchEnabled = ReadSmokeEnvironmentFlag("NWB_GI_SMOKE_RESOLVE_SWITCH");
        this.m_coverageViewEnabled = ReadSmokeEnvironmentFlag("NWB_GI_SMOKE_COVERAGE_VIEW");
        this.m_complexSceneEnabled = this.m_coverageViewEnabled || ReadSmokeEnvironmentFlag("NWB_GI_SMOKE_COMPLEX_SCENE");
        if(this.m_complexSceneEnabled){
            this.m_complexMinLiveWarmupSeconds = s_GiComplexMinLiveWarmupSeconds;
            const Expected<String> settleValue = ReadSmokeEnvironmentString("NWB_GI_SMOKE_MIN_SETTLE_SECONDS");
            if(settleValue.has_value()){
                const Expected<f32> requestedSettleSeconds = ParseF32(StringView(settleValue.value()));
                if(!requestedSettleSeconds.has_value() || !IsFinite(requestedSettleSeconds.value()) || requestedSettleSeconds.value() < s_GiComplexMinLiveWarmupSeconds){
                    error("GiTestSmokeProjectImpl: NWB_GI_SMOKE_MIN_SETTLE_SECONDS requires at least 30 live seconds after the presentation warmup");
                    return false;
                }
                this.m_complexMinLiveWarmupSeconds = requestedSettleSeconds.value();
            }
        }
        if(this.m_resolveSwitchEnabled){
            native(mut world = this.m_world){
                Impl::RendererSystem& renderer = *MakeNotNull(world->getSystem<Impl::RendererSystem>());
                renderer.setFrameLaggedAsyncLightingEnabled(true);
            }
            [essential] info("GiTestSmokeProjectImpl: surfel GI resolve switch probe enabled (lagged_lighting=1)");
        }

        f32 camHeight = s_GiCameraHeight;
        f32 camDistance = s_GiCameraDistance;
        f32 camPitch = s_GiCameraPitch;
        f32 lightPitch = s_GiDirectionalLightPitch;
        f32 lightYaw = s_GiDirectionalLightYaw;
        f32 enclosureScale = s_GiBoxScale;
        f32 wallHeightScale = s_GiBoxHeight;
        SmokeMaterialRef enclosureMaterial = s_GiGroundOpaqueMaterial;
        VectorSingle floorTint = VectorSingle(0.90f, 0.90f, 0.90f, 1.0f);
        VectorSingle redWallTint = VectorSingle(0.80f, 0.08f, 0.08f, 1.0f);
        VectorSingle blueWallTint = VectorSingle(0.08f, 0.08f, 0.80f, 1.0f);
        VectorSingle whiteWallTint = VectorSingle(0.88f, 0.88f, 0.88f, 1.0f);
        if(this.m_complexSceneEnabled){
            camHeight = s_GiComplexCameraHeight;
            camDistance = s_GiComplexCameraDistance;
            camPitch = s_GiComplexCameraPitch;
            lightPitch = s_GiComplexLightPitch;
            lightYaw = 0.0f;
            enclosureScale = s_GiBoxHalfExtent;
            wallHeightScale = s_GiBoxHeight * 0.5f;
            enclosureMaterial = s_GiDiffuseMaterial;
            floorTint = VectorSingle(s_GiBlackEnclosureTint);
            redWallTint = VectorSingle(s_GiBlackEnclosureTint);
            blueWallTint = VectorSingle(s_GiBlackEnclosureTint);
            whiteWallTint = VectorSingle(s_GiBlackEnclosureTint);
        }

        EntityID activeCamera = s_InvalidEntityId;
        EntityID directionalLight = s_InvalidEntityId;
        native(
            in camHeight,
            in camDistance,
            in camPitch,
            in lightPitch,
            in lightYaw,
            in enclosureMaterial,
            in floorTint,
            in enclosureScale,
            mut ctx = this.m_context,
            mut world = this.m_world,
            mut floorEntity = this.m_floorEntity,
            mut activeCamera,
            mut directionalLight
        ){
            ctx.setPerfCapture(Core::Perf::CaptureOptions::GpuTimingOnly());
            activeCamera = CreateSmokeCamera(camHeight, camDistance, camPitch, *world);
            directionalLight = Impl::Scene::CreateDirectionalLightEntity(
                *world,
                lightPitch,
                lightYaw,
                0.0f,
                Float4(1.00f, 0.96f, 0.88f, 1.0f),
                s_GiDirectionalLightIntensity
            );
            floorEntity = CreateTintedStaticMeshEntity(
                s_GiGroundMesh,
                enclosureMaterial,
                NameTextAscii(s_SmokeSurfaceMaterialInterface),
                floorTint,
                VectorZero(),
                VectorSet(enclosureScale, 1.0f, enclosureScale, 0.0f),
                *world
            );
        }

        this.m_redWallEntity = this.createWall(VectorSingle(s_GiBoxHalfExtent, s_GiBoxHeight * 0.5f, 0.0f, 0.0f), redWallTint, -90.0f, enclosureScale, wallHeightScale);
        this.m_blueWallNegX = this.createWall(VectorSingle(-s_GiBoxHalfExtent, s_GiBoxHeight * 0.5f, 0.0f, 0.0f), blueWallTint, 90.0f, enclosureScale, wallHeightScale);
        this.m_whiteWallPosZ = this.createWall(VectorSingle(0.0f, s_GiBoxHeight * 0.5f, s_GiBoxHalfExtent, 0.0f), whiteWallTint, 180.0f, enclosureScale, wallHeightScale);

        if(this.m_complexSceneEnabled){
            b8 complexOk = false;
            native(in covView = this.m_coverageViewEnabled, mut world = this.m_world, mut complexOk){
                complexOk = CreateComplexGiScene(*world, covView);
            }
            if(!complexOk)
                return false;
        }

        [essential] assert(
            activeCamera.valid() && directionalLight.valid() && this.m_floorEntity.valid() && this.m_redWallEntity.valid() && this.m_blueWallNegX.valid() && this.m_whiteWallPosZ.valid(),
            "GiTestSmokeProjectImpl failed to create all scene entities"
        );

        if(this.m_complexSceneEnabled)
            [essential] info("GiTestSmokeProjectImpl: closed black enclosure around camera and maze, small skylight, one vertical sun, red/blue bounce patches");
        else
            [essential] info("GiTestSmokeProjectImpl: open-top box + red/blue opposite walls, directional light -> indirect red+blue bleed on shadowed floor");

        u32 complexFlag = 0u;
        if(this.m_complexSceneEnabled)
            complexFlag = 1u;
        [essential] info("GiTestSmokeProjectImpl: complex_scene={}", complexFlag);

        if(this.m_complexSceneEnabled){
            [essential] info("GiTestSmokeProjectImpl: min_post_presentation_live_warmup_seconds={}", this.m_complexMinLiveWarmupSeconds);
            const u32 captureFreezeFrame = RendererBaselineCaptureFreezeFrame();
            if(captureFreezeFrame != 0u){
                FramebufferCaptureOptions options = FramebufferCaptureOptions();
                native(mut options){
                    options.shouldCapture = +[](void* const ctx, const u64)noexcept -> b8{
                        return MakeNotNull(static_cast<GiTestSmokeProjectImpl*>(ctx))->shouldCaptureComplex();
                    };
                    options.predicateContext = this;
                    options.requiredWidth = 1280u;
                    options.requiredHeight = 900u;
                }
                SmokeCaptureFactory captureFactory = SmokeCaptureFactory(this.m_context);
                Expected<UniquePtr<FramebufferCapture>> capture = captureFactory.configure(GiTestProjectName(), captureFreezeFrame, options);
                b8 validCapture = false;
                if(capture.has_value()){
                    native(in cap = capture.value(), mut validCapture){
                        validCapture = static_cast<b8>(cap);
                    }
                }
                if(!validCapture){
                    error("GiTestSmokeProjectImpl: complex GI baseline requires application framebuffer capture");
                    return false;
                }
                native(mut dstCapture = this.m_complexCapture, mut capture){
                    dstCapture = Move(*capture);
                }
            }
        }
        return true;
    }

    public void onShutdown()override{
        this.m_context.graphics.setFrameSubmissionSuspended(false);
        this.destroyWorld();
        [essential] info("GiTestSmokeProjectImpl: shutdown");
    }

    public b8 onUpdate(in f32 delta)override{
        if(this.m_csgGiScene.active()){
            this.m_csgGiScene.update();
            b8 tickedCsg = false;
            native(mut world = this.m_world, mut tickedCsg){
                tickedCsg = TickSmokeWorld(1.0f / 60.0f, *world);
            }
            return tickedCsg;
        }
        const u32 captureFreezeFrame = RendererBaselineCaptureFreezeFrame();
        const u64 successfulPresentations = this.m_context.graphics.getSuccessfulPresentationCount();
        u64 captureProgress = cast<u64>(this.m_rendererBaselineRenderedFrameCount);
        u64 captureWarmup = cast<u64>(captureFreezeFrame);
        if(this.m_complexSceneEnabled){
            captureProgress = successfulPresentations;
            captureWarmup = Max(cast<u64>(captureFreezeFrame), s_GiComplexCaptureWarmupPresentations);
        }
        f64 elapsedLiveSeconds = 0.0;
        b8 liveWarmupComplete = !this.m_complexSceneEnabled;
        if(this.m_complexSceneEnabled && !this.m_complexLiveWarmupComplete && captureFreezeFrame != 0u && successfulPresentations >= captureWarmup){
            Timer now = Timer();
            native(mut now){
                now = TimerNow();
            }
            if(!this.m_complexLiveWarmupStarted){
                this.m_complexLiveWarmupStartTime = now;
                this.m_complexLiveWarmupStartPresentations = successfulPresentations;
                this.m_complexLiveWarmupStarted = true;
                [essential] info(
                    "GiTestSmokeProjectImpl: complex GI live warmup start graphics_frame={} presentations={} required_presentations={} required_seconds={}"
                    , this.m_context.graphics.getFrameIndex()
                    , successfulPresentations
                    , captureWarmup
                    , cast<f64>(this.m_complexMinLiveWarmupSeconds)
                );
            }
            else{
                native(in now, in startTime = this.m_complexLiveWarmupStartTime, mut elapsedLiveSeconds){
                    elapsedLiveSeconds = DurationInSeconds<f64>(now, startTime);
                }
                liveWarmupComplete = elapsedLiveSeconds >= cast<f64>(this.m_complexMinLiveWarmupSeconds) && successfulPresentations > this.m_complexLiveWarmupStartPresentations;
            }
        }
        if(this.m_complexSceneEnabled && liveWarmupComplete && !this.m_complexLiveWarmupComplete){
            this.m_complexLiveWarmupComplete = true;
            [essential] info(
                "GiTestSmokeProjectImpl: complex GI live warmup end graphics_frame={} presentations={} elapsed_seconds={}"
                , this.m_context.graphics.getFrameIndex()
                , successfulPresentations
                , elapsedLiveSeconds
            );
        }

        b8 complexReady = false;
        u64 complexFrame = 0u;
        native(mut cap = this.m_complexCapture, mut complexReady, mut complexFrame){
            if(cap){
                cap->update();
                if(cap->captureReady()){
                    complexReady = true;
                    complexFrame = cap->capturedGraphicsFrameIndex();
                }
            }
        }
        if(complexReady && !this.m_complexCaptureReceiptLogged){
            this.m_complexCaptureReceiptLogged = true;
            [essential] info("GiTestSmokeProjectImpl: complex GI capture source_frame={}", complexFrame);
        }

        if(!this.m_complexSceneEnabled && captureFreezeFrame != 0u && captureProgress >= cast<u64>(captureFreezeFrame)){
            if(!this.m_rendererBaselineCapturePaused){
                this.m_context.graphics.setFrameSubmissionSuspended(true);
                this.m_rendererBaselineCapturePaused = true;
                [essential] info("GiTestSmokeProjectImpl: renderer baseline capture ready after {} rendered frames; render submission suspended", this.m_rendererBaselineRenderedFrameCount);
            }
            return true;
        }

        if(!this.samplePresentationFps())
            return false;

        if(this.m_resolveSwitchEnabled && (this.m_rendererBaselineRenderedFrameCount == 30u || this.m_rendererBaselineRenderedFrameCount == 90u)){
            b8 switchedGi = false;
            u32 factor = 0u;
            native(in frameCount = this.m_rendererBaselineRenderedFrameCount, mut world = this.m_world, mut switchedGi, mut factor){
                Impl::RendererSystem& renderer = *MakeNotNull(world->getSystem<Impl::RendererSystem>());
                Impl::SurfelGiQualitySettings settings;
                settings.resolveResolution = frameCount == 30u ? Impl::SurfelGiResolveResolution::Quarter : Impl::SurfelGiResolveResolution::Half;
                switchedGi = renderer.setSurfelGiQualitySettings(settings);
                factor = static_cast<u32>(settings.resolveResolution);
            }
            if(!switchedGi)
                return false;
            [essential] info("GiTestSmokeProjectImpl: requested surfel GI resolve switch factor={}", factor);
        }

        if(this.m_resolveSwitchEnabled && (this.m_rendererBaselineRenderedFrameCount == 150u || this.m_rendererBaselineRenderedFrameCount == 210u)){
            b8 switchedShadow = false;
            u32 factor = 0u;
            native(in frameCount = this.m_rendererBaselineRenderedFrameCount, mut world = this.m_world, mut switchedShadow, mut factor){
                Impl::RendererSystem& renderer = *MakeNotNull(world->getSystem<Impl::RendererSystem>());
                Impl::ShadowQualitySettings settings;
                settings.receiverResolution = frameCount == 150u ? Impl::ShadowReceiverResolution::Quarter : Impl::ShadowReceiverResolution::Half;
                switchedShadow = renderer.setShadowQualitySettings(settings);
                factor = static_cast<u32>(settings.receiverResolution);
            }
            if(!switchedShadow)
                return false;
            [essential] info("GiTestSmokeProjectImpl: requested shadow receiver switch factor={}", factor);
        }

        const f32 fixedDelta = RendererBaselineFixedDelta();
        f32 safeDelta = 0.0f;
        if(fixedDelta > 0.0f)
            safeDelta = fixedDelta;
        else if(IsFinite(delta))
            safeDelta = Max(delta, 0.0f);
        this.m_gpuPassTimingProbe.recordFrame(safeDelta, this.m_context.gpuTimingView());
        b8 ticked = false;
        native(in safeDelta, mut world = this.m_world, mut ticked){
            ticked = TickSmokeWorld(safeDelta, *world);
        }
        if(!ticked)
            return false;
        ++this.m_rendererBaselineRenderedFrameCount;
        return true;
    }

    private void destroyWorld(){
        native(mut cap = this.m_complexCapture){
            if(cap){
                cap->stop();
                cap.reset();
            }
        }
        this.m_csgGiScene.stop();
        DestroySmokeRenderWorld(this.m_context, this.m_world);
    }

    private b8 samplePresentationFps(){
        const u64 successfulPresentations = this.m_context.graphics.getSuccessfulPresentationCount();
        Timer now = Timer();
        native(mut now){
            now = TimerNow();
        }
        const PresentationFpsStatus status = this.m_presentationFpsProbe.observe(successfulPresentations, now);
        if(status == PresentationFpsStatus::Invalid){
            error("GiTestSmokeProjectImpl: presentation measurement invalid counter or clock");
            return false;
        }
        if(status == PresentationFpsStatus::Waiting)
            return true;

        const PresentationFpsSample interval = this.m_presentationFpsProbe.interval();
        [essential] info(
            "GiTestSmokeProjectImpl: presentation fps avg={} presentations={} seconds={} first={} last={}"
            , interval.averageFps()
            , interval.presentations()
            , interval.wallSeconds
            , interval.firstPresentationCount
            , interval.lastPresentationCount
        );
        return true;
    }

    private EntityID createWall(in VectorSingle position, in VectorSingle colorTint, in f32 yawDeg, in f32 width, in f32 height){
        SmokeMaterialRef material = s_GiGroundOpaqueMaterial;
        if(this.m_complexSceneEnabled)
            material = s_GiDiffuseMaterial;
        EntityID entity = s_InvalidEntityId;
        native(in position, in colorTint, in yawDeg, in width, in height, in material, mut world = this.m_world, mut entity){
            const SIMDVectorSingle pitchQuat = QuaternionRotationRollPitchYaw(s_PIDIV2, 0.0f, 0.0f);
            const SIMDVectorSingle yawQuat = QuaternionRotationRollPitchYawFromVector(VectorScale(VectorSet(0.0f, yawDeg, 0.0f, 0.0f), s_PI / 180.0f));
            const SIMDVectorSingle wallRotation = QuaternionMultiply(pitchQuat, yawQuat);

            entity = CreateTintedStaticMeshEntity(
                s_GiGroundMesh,
                material,
                NameTextAscii(s_SmokeSurfaceMaterialInterface),
                colorTint,
                position,
                VectorSet(width, 1.0f, height, 0.0f),
                *world
            );
            if(entity.valid()){
                if(auto* transform = world->tryGetComponent<Impl::Scene::TransformComponent>(entity))
                    StoreFloat(wallRotation, transform->rotation);
            }
        }
        return entity;
    }

    private mut ProjectRuntimeContext m_context;
    private NotNullUniquePtr<World> m_world;
    private CsgGiScene m_csgGiScene;
    private UniquePtr<FramebufferCapture> m_complexCapture = UniquePtr<FramebufferCapture>();
    private PresentationFpsProbe m_presentationFpsProbe = PresentationFpsProbe();
    private GpuPassTimingProbe m_gpuPassTimingProbe;
    private Timer m_complexLiveWarmupStartTime = Timer();
    private u64 m_complexLiveWarmupStartPresentations = 0u;
    private EntityID m_floorEntity = s_InvalidEntityId;
    private EntityID m_redWallEntity = s_InvalidEntityId;
    private EntityID m_blueWallNegX = s_InvalidEntityId;
    private EntityID m_whiteWallPosZ = s_InvalidEntityId;
    private u32 m_rendererBaselineRenderedFrameCount = 0u;
    private f32 m_complexMinLiveWarmupSeconds = s_GiComplexMinLiveWarmupSeconds;
    private b8 m_rendererBaselineCapturePaused = false;
    private b8 m_resolveSwitchEnabled = false;
    private b8 m_complexSceneEnabled = false;
    private b8 m_coverageViewEnabled = false;
    private b8 m_complexLiveWarmupStarted = false;
    private b8 m_complexLiveWarmupComplete = false;
    private b8 m_complexCaptureReceiptLogged = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB::ProjectFrameClientSize NWB::QueryProjectFrameClientSize(){
    return { 1280, 900 };
}

TStringView NWB::QueryProjectWindowTitle()noexcept{
    return NWB_TEXT("NWB GI Test");
}

UniquePtr<NWB::IProjectEntryCallbacks> NWB::CreateProjectEntryCallbacks(NWB::ProjectRuntimeContext& context){
    return MakeUnique<NWB::Tests::Smoke::GiTestSmokeProjectImpl>(context);
}


