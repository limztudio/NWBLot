using namespace NWB;
using namespace NWB::Impl::Ui;
using namespace NWB::UiPopupToolsTests;

class UiPopupToolsLoanTests : public __hidden_ui_popup_tools_case_support::PopupToolsCaseFixture{};

class RevisionArmingComboSource final : public IListDataSource{
public:
    RevisionArmingComboSource(PopupToolsSource& menuSource, ComboState& combo)noexcept
        : m_menuSource(menuSource)
        , m_combo(combo)
    {
        m_rows.generation = 1501u;
    }


public:
    [[nodiscard]] virtual u64 instanceGeneration()const noexcept override{ return m_rows.instanceGeneration(); }

    [[nodiscard]] virtual u64 revision()const noexcept override{ return m_rows.revision(); }

    [[nodiscard]] virtual u64 rowCount()const noexcept override{ return m_rows.rowCount(); }

    [[nodiscard]] virtual u64 key(const u64 index)const noexcept override{ return m_rows.key(index); }

    [[nodiscard]] virtual Expected<u64> indexOf(const u64 key)const noexcept override{ return m_rows.indexOf(key); }

    [[nodiscard]] virtual Expected<u64> findEnabled(const u64 start, const b8 reverse)const noexcept override{
        return m_rows.findEnabled(start, reverse);
    }

    [[nodiscard]] virtual StringView text(const u64 index)const noexcept override{
        ++textCalls;
        if(!armed){
            m_menuSource.closeComboOnRevision = &m_combo;
            armed = true;
        }
        return m_rows.text(index);
    }

    [[nodiscard]] virtual b8 enabled(const u64 index)const noexcept override{ return m_rows.enabled(index); }


public:
    mutable u64 textCalls = 0u;
    mutable b8 armed = false;


private:
    PopupToolsSource& m_menuSource;
    ComboState& m_combo;
    PopupToolsSource m_rows;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


