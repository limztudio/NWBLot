void VerifyUiControlInputTests_RetiredHeldKeyOwnerCannotReviveWhenItsOriginalTokenReturns(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    self.focus();
    EXPECT_TRUE(self.send(MakeUiControlInputKey(InputEventType::KeyDown, CoreKey::Down)).commandConsumed);
    const ControlToken original = self.m_targets[0u].control;
    self.revise();
    self.m_targets[0u].focusOnCommit = true;
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u));
    for(mut HitTarget target : self.m_targets)
        target.control = original;
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 3u));
    EXPECT_EQ(self.m_router.focus(), self.m_targets[0u].id);
    EXPECT_TRUE(self.send(MakeUiControlInputKey(InputEventType::KeyDown, CoreKey::Down, true)).commandConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.send(MakeUiControlInputKey(InputEventType::KeyUp, CoreKey::Down)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiControlInputKey(InputEventType::KeyDown, CoreKey::Down)).commandConsumed);
    ASSERT_TRUE(self.take().has_value());
}

void VerifyUiControlInputTests_GestureUpdateSequenceOrdersLatestMotionAfterAnInterveningWheel(mut UiControlInputTests self){
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    EXPECT_TRUE(self.send(MakeUiControlInputPointer(InputEventType::PrimaryDown, MakeUiControlCaretPoint(95.0f, 25.0f))).pointerConsumed);
    const Expected<PointerGesture> initialResult = self.m_router.consumePointerGesture(self.m_targets[2u].id, 7u);
    ASSERT_TRUE(initialResult.has_value());
    const PointerGesture initial = initialResult.value();
    EXPECT_EQ(initial.updateSequence, initial.id.sequence);
    EXPECT_TRUE(self.wheel(1.0, MakeUiControlCaretPoint(95.0f, 25.0f)).pointerConsumed);
    const Expected<ControlAction> actionResult = self.take();
    ASSERT_TRUE(actionResult.has_value());
    const ControlAction action = actionResult.value();
    EXPECT_GT(action.id.sequence, initial.updateSequence);
    EXPECT_TRUE(self.send(MakeUiControlInputPointer(InputEventType::PointerMove, MakeUiControlCaretPoint(95.0f, 70.0f))).pointerConsumed);
    const Expected<PointerGesture> movedResult = self.m_router.consumePointerGesture(self.m_targets[2u].id, 7u);
    ASSERT_TRUE(movedResult.has_value());
    const PointerGesture moved = movedResult.value();
    EXPECT_EQ(moved.id.sequence, initial.id.sequence);
    EXPECT_GT(moved.updateSequence, action.id.sequence);
    EXPECT_TRUE(self.send(MakeUiControlInputPointer(InputEventType::PrimaryUp, MakeUiControlCaretPoint(95.0f, 70.0f))).pointerConsumed);
    const Expected<PointerGesture> completedResult = self.m_router.consumePointerGesture(self.m_targets[2u].id, 7u);
    ASSERT_TRUE(completedResult.has_value());
    const PointerGesture completed = completedResult.value();
    EXPECT_GT(completed.updateSequence, moved.updateSequence);
    EXPECT_EQ(completed.id.sequence, initial.id.sequence);
    EXPECT_EQ(completed.state, PointerGestureState::Completed);
}

void VerifyUiControlInputTests_EscapeAndControlRebindingCancelHeldSubmitWithoutReleaseLeakage(mut UiControlInputTests self){
    self.m_targets[0u].focusOnCommit = true;
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 1u));
    EXPECT_TRUE(self.send(MakeUiControlInputKey(InputEventType::KeyDown, CoreKey::Enter)).commandConsumed);
    EXPECT_TRUE(self.m_router.controlActions().empty());
    EXPECT_TRUE(self.send(MakeUiControlInputKey(InputEventType::KeyDown, CoreKey::Escape)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiControlInputKey(InputEventType::KeyUp, CoreKey::Escape)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiControlInputKey(InputEventType::KeyUp, CoreKey::Enter)).commandConsumed);
    EXPECT_FALSE(self.take().has_value());
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u));
    EXPECT_TRUE(self.send(MakeUiControlInputKey(InputEventType::KeyDown, CoreKey::Enter)).commandConsumed);
    const ControlToken original = self.m_targets[0u].control;
    self.revise();
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 3u));
    for(mut HitTarget target : self.m_targets)
        target.control = original;
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 4u));
    EXPECT_TRUE(self.send(MakeUiControlInputKey(InputEventType::KeyUp, CoreKey::Enter)).commandConsumed);
    EXPECT_FALSE(self.take().has_value());
    EXPECT_TRUE(self.send(MakeUiControlInputKey(InputEventType::KeyDown, CoreKey::Enter)).commandConsumed);
    EXPECT_FALSE(self.take().has_value());
    EXPECT_TRUE(self.send(MakeUiControlInputKey(InputEventType::KeyUp, CoreKey::Enter)).commandConsumed);
    const Expected<ControlAction> action = self.take();
    ASSERT_TRUE(action.has_value());
    EXPECT_EQ(action.value().kind, ControlActionKind::Submit);
}


