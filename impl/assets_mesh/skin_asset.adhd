////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_mesh/asset.adhd>
#include <impl/assets_mesh/skin_types.adhd>
#include <impl/assets_skeleton/asset.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_SkinAssetKindLabel = "skin";
const StringView s_SkinLoadBinaryContext = "Skin::loadBinary";
const StringView s_SkinSerializeContext = "SkinAssetCodec::serialize";
const StringView s_SkinInfluencesPayloadLabel = "influences";
const StringView s_SkinInverseBindMatricesPayloadLabel = "inverse bind matrices";

type InfluenceVector = Vector<SkinInfluence4>;
type InverseBindMatrixVector = Vector<SkeletonJointMatrix>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[asset("skin")]
class Skin{
    private AssetRef<Mesh> m_mesh;
    private AssetRef<Skeleton> m_skeleton;
    private InfluenceVector m_influences;
    private InverseBindMatrixVector m_inverseBindMatrices;

    public b8 loadBinary(in Span<u8> binary);
    public b8 validatePayload()const;

    public void setMesh(in AssetRef<Mesh> mesh){ this.m_mesh = mesh; }
    public void setSkeleton(in AssetRef<Skeleton> skeleton){ this.m_skeleton = skeleton; }
    public void setPayload(in InfluenceVector influences, in InverseBindMatrixVector inverseBindMatrices){
        this.m_influences = influences;
        this.m_inverseBindMatrices = inverseBindMatrices;
    }

    public in AssetRef<Mesh> mesh()const{ return this.m_mesh; }
    public in AssetRef<Skeleton> skeleton()const{ return this.m_skeleton; }
    public in InfluenceVector influences()const{ return this.m_influences; }
    public in InverseBindMatrixVector inverseBindMatrices()const{ return this.m_inverseBindMatrices; }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
