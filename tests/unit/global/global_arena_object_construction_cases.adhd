void VerifyArenaObjectConstruction_RawObjectFailureReleasesAlignedStorageAndConstructedMembers(){
    const Name owner = s_GlobalArenaCaseArenaObjectRawConstructorFailure;
    u64 usedAfter = 1u;
    native(in owner, mut usedAfter){
        using namespace __hidden_arena_object_construction_tests;
        GlobalArena arena{ owner };
        using Probe = ConstructionProbe<GlobalArena>;
        VerifyConstructionFailure(arena, 1u, [&](ConstructionState& state){
            return ArenaUniquePtr<Probe, GlobalArena>(NewArenaObject<Probe>(arena, arena, state), ArenaDeleter<Probe, GlobalArena>(arena));
        });
        usedAfter = arena.memoryStats().usedBytes;
    }
    EXPECT_EQ(usedAfter, 0u);
}

