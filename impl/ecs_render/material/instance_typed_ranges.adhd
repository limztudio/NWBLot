#include <impl/ecs_render/material/instance_override_fields.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> MaterialTypedByteAppendStatus{
    Success = 0u,
    AppendCountExceedsU32 = 1u,
    BeginAlignmentOverflow = 2u,
    TotalCountOverflow = 3u,
    EndAlignmentOverflow = 4u,
    TotalCountExceedsU32 = 5u
}

class ShadowOccluderMaterialContext{
    public InstanceGpuData instance;
    public u32 constantByteOffset = 0u;
}

class MaterialTypedByteRange{
    public u32 byteOffset = 0u;
    public u32 byteCount = 0u;
}

class MaterialTypedInstanceRanges{
    public MaterialTypedByteRange constantRange;
    public MaterialTypedByteRange mutableRange;
}

class MaterialInstanceAppend{
    public MaterialInstanceAppend(){
        this.instanceIndex = 0u;
    }

    public MaterialInstanceAppend(in u32 instanceIndexIn, in MaterialTypedInstanceRanges typedRangesIn){
        this.instanceIndex = instanceIndexIn;
        this.typedRanges = typedRangesIn;
    }

    public u32 instanceIndex;
    public MaterialTypedInstanceRanges typedRanges;
}

class MaterialTypedByteRangeCache{
    public MaterialTypedByteRange constantRange;
    public MaterialTypedByteRange defaultMutableRange;
    public b8 constantRangeCached = false;
    public b8 defaultMutableRangeCached = false;
}

class MaterialTypedByteRangeKey{
    public b8 operator==(in MaterialTypedByteRangeKey rhs)const{
        return this.materialName == rhs.materialName && this.typedLayoutHash == rhs.typedLayoutHash;
    }

    public usize hash()const{
        usize seed = hashValue(this.materialName);
        seed = hashCombineValue(seed, this.typedLayoutHash);
        return seed;
    }

    public Name materialName;
    public u64 typedLayoutHash = 0u;
}

class MaterialTypedByteAppendRange{
    public MaterialTypedByteRange byteRange;
    public usize alignedByteEnd = 0u;
}

class MaterialTypedByteContentLookup{
    public MaterialTypedByteContentLookup(){
        this.byteHash = 0u;
    }

    public MaterialTypedByteContentLookup(in u64 inByteHash, in Span<u8> inBytes){
        this.byteHash = inByteHash;
        this.bytes = inBytes;
    }

    public u64 byteHash;
    public Span<u8> bytes;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void SplitMaterialTypedBlockBytesByClass(
    in Span<MaterialTypedLayoutBlock> blocks,
    in Span<u8> packedTypedBytes,
    mut Vector<u8> outConstantTypedBytes,
    mut Vector<u8> outMutableDefaultTypedBytes
){
    outConstantTypedBytes.clear();
    outMutableDefaultTypedBytes.clear();

    usize constantByteSize = 0u;
    usize mutableByteSize = 0u;
    for(in MaterialTypedLayoutBlock block : blocks){
        if(block.blockClass == MaterialBlockClass::MaterialConstant)
            constantByteSize += cast<usize>(block.byteSize);
        else
            mutableByteSize += cast<usize>(block.byteSize);
    }
    outConstantTypedBytes.reserve(constantByteSize);
    outMutableDefaultTypedBytes.reserve(mutableByteSize);
    usize sourceByteOffset = 0u;
    for(in MaterialTypedLayoutBlock block : blocks){
        assert(IsValidMaterialBlockClass(block.blockClass));
        assert((block.byteSize & 3u) == 0u);
        const usize blockByteCount = cast<usize>(block.byteSize);
        assert(sourceByteOffset <= packedTypedBytes.size() && blockByteCount <= packedTypedBytes.size() - sourceByteOffset);
        if(block.blockClass == MaterialBlockClass::MaterialConstant){
            for(usize i = 0u; i < blockByteCount; ++i)
                outConstantTypedBytes.push_back(packedTypedBytes[sourceByteOffset + i]);
        }
        else{
            for(usize i = 0u; i < blockByteCount; ++i)
                outMutableDefaultTypedBytes.push_back(packedTypedBytes[sourceByteOffset + i]);
        }
        sourceByteOffset += blockByteCount;
    }
    assert(sourceByteOffset == packedTypedBytes.size());
}

b8 MaterialInstanceMutableCacheEntryMatches(
    in Name cacheMaterialName,
    in Name cacheMaterialInterface,
    in u64 cacheTypedLayoutHash,
    in u32 cacheRevision,
    in Name materialName,
    in Name materialInterface,
    in u64 typedLayoutHash,
    in MaterialInstanceComponent materialInstance
){
    return
        cacheMaterialName == materialName
        && cacheMaterialInterface == materialInterface
        && materialInstance.materialInterface == materialInterface
        && cacheTypedLayoutHash == typedLayoutHash
        && cacheRevision == materialInstance.revision
    ;
}

Expected<MaterialTypedByteAppendRange, MaterialTypedByteAppendStatus> ResolveMaterialTypedByteAppendRange(
    in usize currentByteCount,
    in usize appendByteCount
){
    MaterialTypedByteAppendRange outRange;
    if(appendByteCount == 0u)
        return outRange;

    if(appendByteCount > cast<usize>(u32.max))
        return makeUnexpected(MaterialTypedByteAppendStatus::AppendCountExceedsU32);

    const usize wordBytes = cast<usize>(s_MaterialTypedWordBytes);
    const usize wordMask = wordBytes - 1u;
    if(currentByteCount > usize.max - wordMask)
        return makeUnexpected(MaterialTypedByteAppendStatus::BeginAlignmentOverflow);
    const usize alignedByteBegin = (currentByteCount + wordMask) & ~wordMask;
    if(appendByteCount > usize.max - alignedByteBegin)
        return makeUnexpected(MaterialTypedByteAppendStatus::TotalCountOverflow);

    const usize byteEnd = alignedByteBegin + appendByteCount;
    if(byteEnd > usize.max - wordMask)
        return makeUnexpected(MaterialTypedByteAppendStatus::EndAlignmentOverflow);
    const usize alignedByteEnd = (byteEnd + wordMask) & ~wordMask;
    if(alignedByteBegin > cast<usize>(u32.max) || alignedByteEnd > cast<usize>(u32.max))
        return makeUnexpected(MaterialTypedByteAppendStatus::TotalCountExceedsU32);

    outRange.byteRange.byteOffset = cast<u32>(alignedByteBegin);
    outRange.byteRange.byteCount = cast<u32>(appendByteCount);
    outRange.alignedByteEnd = alignedByteEnd;
    return outRange;
}

b8 MaterialTypedByteRangeEmptyOffsetValid(in MaterialTypedByteRange range){
    return range.byteCount != 0u || range.byteOffset == 0u;
}

Expected<MaterialTypedByteAppendRange> TryBuildMaterialTypedByteAppendRange(
    in usize currentByteCount,
    in usize appendByteCount
){
    const Expected<MaterialTypedByteAppendRange, MaterialTypedByteAppendStatus> appendRange = ResolveMaterialTypedByteAppendRange(currentByteCount, appendByteCount);
    if(appendRange.has_value())
        return appendRange.value();
    switch(appendRange.error()){
    case MaterialTypedByteAppendStatus::AppendCountExceedsU32:
        error("RendererSystem: material typed byte count exceeds u32 limits");
        return makeUnexpected(Failure());
    case MaterialTypedByteAppendStatus::BeginAlignmentOverflow:
        error("RendererSystem: material typed byte offset overflows alignment");
        return makeUnexpected(Failure());
    case MaterialTypedByteAppendStatus::TotalCountOverflow:
        error("RendererSystem: gathered material typed byte count overflows");
        return makeUnexpected(Failure());
    case MaterialTypedByteAppendStatus::EndAlignmentOverflow:
        error("RendererSystem: material typed byte end overflows alignment");
        return makeUnexpected(Failure());
    case MaterialTypedByteAppendStatus::TotalCountExceedsU32:
    case MaterialTypedByteAppendStatus::Success:
    default:
        error("RendererSystem: gathered material typed byte count exceeds u32 limits");
        return makeUnexpected(Failure());
    }
}

usize HashMaterialTypedByteContent(in u64 byteHash, in usize byteCount){
    usize seed = hashValue(byteHash);
    return hashCombineValue(seed, byteCount);
}

b8 EqualMaterialTypedByteContent(in u64 lhsByteHash, in Span<u8> lhsBytes, in u64 rhsByteHash, in Span<u8> rhsBytes){
    if(lhsByteHash != rhsByteHash || lhsBytes.size() != rhsBytes.size())
        return false;
    for(usize i = 0u; i < lhsBytes.size(); ++i){
        if(lhsBytes[i] != rhsBytes[i])
            return false;
    }
    return true;
}

usize ResolveMaterialTypedUploadByteCount(in Span<u8> materialTypedBytes){
    const usize uploadByteCount = materialTypedBytes.size();
    assert(uploadByteCount != 0u, "RendererSystem: material typed data upload is empty");
    assert((uploadByteCount & (cast<usize>(s_MaterialTypedWordBytes) - 1u)) == 0u, "RendererSystem: material typed data upload is not word-aligned");
    return uploadByteCount;
}

void ValidateMaterialTypedUploadRange(in MaterialTypedByteRange range, in usize uploadByteCount, in StringView rangeName){
    if(range.byteCount == 0u){
        assert(MaterialTypedByteRangeEmptyOffsetValid(range), "RendererSystem: {} material typed byte range has zero count with nonzero offset", rangeName);
        return;
    }

    assert(((range.byteOffset | range.byteCount) & (s_MaterialTypedWordBytes - 1u)) == 0u, "RendererSystem: {} material typed byte range is not word-aligned", rangeName);

    const usize byteOffset = cast<usize>(range.byteOffset);
    assert(byteOffset <= uploadByteCount, "RendererSystem: {} material typed byte range offset exceeds upload data", rangeName);
    assert(byteOffset <= uploadByteCount && cast<usize>(range.byteCount) <= uploadByteCount - byteOffset, "RendererSystem: {} material typed byte range exceeds upload data", rangeName);
}

void ValidateMaterialTypedInstanceRange(in MaterialTypedInstanceRanges ranges, in usize uploadByteCount){
    ValidateMaterialTypedUploadRange(ranges.constantRange, uploadByteCount, "constant");
    ValidateMaterialTypedUploadRange(ranges.mutableRange, uploadByteCount, "mutable");
}

void ValidateMaterialTypedUploadRanges(in Span<MaterialTypedInstanceRanges> instanceRanges, in Span<u8> materialTypedBytes){
    if(instanceRanges.empty())
        return;

    const usize uploadByteCount = ResolveMaterialTypedUploadByteCount(materialTypedBytes);
    for(in MaterialTypedInstanceRanges ranges : instanceRanges)
        ValidateMaterialTypedInstanceRange(ranges, uploadByteCount);
}

void CopyMaterialTypedByteSpan(in Span<u8> sourceBytes, mut Vector<u8> outBytes){
    outBytes.clear();
    outBytes.reserve(sourceBytes.size());
    for(in u8 b : sourceBytes)
        outBytes.push_back(b);
}

b8 PopulateMaterialSurfaceInfoFromAsset(
    in Name materialPath,
    in StringView shaderVariant,
    in b8 hasMeshShader,
    in b8 hasPixelShader,
    in b8 transparent,
    in Name materialInterface,
    in u64 typedLayoutHash,
    in Span<MaterialTypedLayoutBlock> typedLayoutBlocks,
    in Span<MaterialTypedLayoutField> typedLayoutFields,
    in Span<u8> typedBlockBytes,
    in Span<MaterialResourceReference> resourceReferences,
    in u32 shadingModelId,
    in u32 surfaceDispatchId,
    in b8 twoSided,
    in b8 refractive,
    mut Name outMaterialName,
    mut String outShaderVariant,
    mut Name outMaterialInterface,
    mut u64 outTypedLayoutHash,
    mut Vector<MaterialTypedLayoutBlock> outTypedLayoutBlocks,
    mut Vector<MaterialTypedLayoutField> outTypedLayoutFields,
    mut Vector<MaterialResourceReference> outResourceReferences,
    mut Vector<u8> outConstantTypedBytes,
    mut Vector<u8> outMutableDefaultTypedBytes,
    mut Vector<u8> outUnpatchedConstantTypedBytes,
    mut u32 outShadingModelId,
    mut u32 outSurfaceDispatchId,
    mut b8 outCsgCapSurfaceDispatchAvailable,
    mut b8 outTransparent,
    mut b8 outTwoSided,
    mut b8 outRefractive
){
    if(!hasMeshShader){
        error("RendererSystem: material '{}' is missing required mesh shader", materialPath.resolvedText());
        return false;
    }
    if(!hasPixelShader && !transparent){
        error("RendererSystem: opaque material '{}' is missing required pixel shader", materialPath.resolvedText());
        return false;
    }

    outMaterialName = materialPath;
    outShaderVariant = shaderVariant;
    outMaterialInterface = materialInterface;
    outTypedLayoutHash = typedLayoutHash;

    outTypedLayoutBlocks.clear();
    outTypedLayoutBlocks.reserve(typedLayoutBlocks.size());
    for(in MaterialTypedLayoutBlock block : typedLayoutBlocks)
        outTypedLayoutBlocks.push_back(block);

    outTypedLayoutFields.clear();
    outTypedLayoutFields.reserve(typedLayoutFields.size());
    for(in MaterialTypedLayoutField field : typedLayoutFields)
        outTypedLayoutFields.push_back(field);

    outResourceReferences.clear();
    outResourceReferences.reserve(resourceReferences.size());
    for(in MaterialResourceReference ref : resourceReferences)
        outResourceReferences.push_back(ref);

    SplitMaterialTypedBlockBytesByClass(typedLayoutBlocks, typedBlockBytes, outConstantTypedBytes, outMutableDefaultTypedBytes);
    CopyMaterialTypedByteSpan(outConstantTypedBytes, outUnpatchedConstantTypedBytes);

    outShadingModelId = shadingModelId;
    outSurfaceDispatchId = surfaceDispatchId;
    outCsgCapSurfaceDispatchAvailable = surfaceDispatchId != u32.max;
    outTransparent = transparent;
    outTwoSided = twoSided;
    outRefractive = refractive;
    return true;
}

b8 IsMaterialPassDrawBuffersReady(
    in usize instanceCount,
    in usize materialTypedByteCount,
    in b8 hasInstanceBuffer,
    in usize instanceBufferCapacity,
    in b8 hasMaterialTypedBuffer,
    in usize materialTypedBufferCapacity
){
    if(materialTypedByteCount == 0u || (materialTypedByteCount & (cast<usize>(s_MaterialTypedWordBytes) - 1u)) != 0u)
        return false;

    return (instanceCount == 0u || (hasInstanceBuffer && instanceBufferCapacity >= instanceCount))
        && hasMaterialTypedBuffer
        && materialTypedBufferCapacity >= materialTypedByteCount;
}


