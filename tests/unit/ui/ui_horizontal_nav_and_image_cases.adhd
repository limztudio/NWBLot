void VerifyGpuTextureImageValidationFixture_SameIdentityDistinctGenerationsRemainValidImageBindings(mut GpuTextureImageValidationFixture self){
    const Expected<SharedImageSource> firstResult = self.makeImage(s_UiGpuVersionedImagePath, 37u);
    ASSERT_TRUE(firstResult.has_value());
    const SharedImageSource first = firstResult.value();
    const Expected<SharedImageSource> secondResult = self.makeImage(s_UiGpuVersionedImagePath, 73u);
    ASSERT_TRUE(secondResult.has_value());
    const SharedImageSource second = secondResult.value();
    ASSERT_TRUE(UiImageHandlePresent(first) && UiImageHandlePresent(second));
    ASSERT_EQ(UiReadImageIdentity(first), UiReadImageIdentity(second));
    ASSERT_NE(UiReadImageGeneration(first), UiReadImageGeneration(second));
    const Rect rectangle = MakeUiHorizImageRect(2.0f, 3.0f, 16.0f, 8.0f);
    ASSERT_TRUE(self.m_builder.drawImage(first, rectangle));
    ASSERT_TRUE(self.m_builder.drawImage(second, rectangle));
    const DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.textureImages().size(), 2u);
    ASSERT_EQ(snapshot.commands().size(), 2u);
    EXPECT_TRUE(UiGpuValGlyphPages(snapshot));
    EXPECT_TRUE(UiGpuValSdfPages(snapshot));
    EXPECT_TRUE(UiGpuValTextureImages(snapshot));
}

void VerifyGpuTextureImageValidationFixture_ImageIndexMustAddressAnOwnedTextureSource(mut GpuTextureImageValidationFixture self){
    const Expected<SharedImageSource> imageResult = self.makeImage();
    ASSERT_TRUE(imageResult.has_value());
    const SharedImageSource image = imageResult.value();
    ASSERT_TRUE(UiImageHandlePresent(image));
    ASSERT_TRUE(self.m_builder.drawImage(image, MakeUiHorizImageRect(2.0f, 3.0f, 16.0f, 8.0f)));
    DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.commands().size(), 1u);
    Array<u32, 2u> invalidIndices = Array<u32, 2u>();
    invalidIndices[0u] = 1u;
    invalidIndices[1u] = u32.max;
    for(in u32 index : invalidIndices){
        UiGpuValSetCommandTextureIndex(snapshot, 0u, index);
        EXPECT_FALSE(UiGpuValTextureImages(snapshot));
        EXPECT_FALSE(UiGpuValAllImageBindings(snapshot));
    }
    UiGpuValSetCommandTextureIndex(snapshot, 0u, 0u);
    EXPECT_TRUE(UiGpuValAllImageBindings(snapshot));
}

void VerifyGpuTextureImageValidationFixture_NullTextureSourceRejectsTheSnapshot(mut GpuTextureImageValidationFixture self){
    const Expected<SharedImageSource> imageResult = self.makeImage();
    ASSERT_TRUE(imageResult.has_value());
    const SharedImageSource image = imageResult.value();
    ASSERT_TRUE(UiImageHandlePresent(image));
    ASSERT_TRUE(self.m_builder.drawImage(image, MakeUiHorizImageRect(2.0f, 3.0f, 16.0f, 8.0f)));
    DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.textureImages().size(), 1u);
    UiGpuValResetFirstTexture(snapshot);
    EXPECT_FALSE(UiGpuValTextureImages(snapshot));
    EXPECT_FALSE(UiGpuValAllImageBindings(snapshot));
}

void VerifyGpuTextureImageValidationFixture_DuplicateSourceGenerationRejectsTheSnapshot(mut GpuTextureImageValidationFixture self){
    const Expected<SharedImageSource> imageResult = self.makeImage();
    ASSERT_TRUE(imageResult.has_value());
    const SharedImageSource image = imageResult.value();
    ASSERT_TRUE(UiImageHandlePresent(image));
    ASSERT_TRUE(self.m_builder.drawImage(image, MakeUiHorizImageRect(2.0f, 3.0f, 16.0f, 8.0f)));
    DrawSnapshot snapshot = self.m_builder.freeze();
    UiGpuValAppendTexture(snapshot, image);
    ASSERT_EQ(snapshot.textureImages().size(), 2u);
    ASSERT_EQ(UiReadImageGeneration(snapshot.textureImages()[0u]), UiReadImageGeneration(snapshot.textureImages()[1u]));
    EXPECT_FALSE(UiGpuValTextureImages(snapshot));
    EXPECT_FALSE(UiGpuValAllImageBindings(snapshot));
}

void VerifyGpuTextureImageValidationFixture_TextureBindingCountOverflowRejectsEveryValidator(mut GpuTextureImageValidationFixture self){
    const Expected<SharedImageSource> firstResult = self.makeImage();
    ASSERT_TRUE(firstResult.has_value());
    const SharedImageSource first = firstResult.value();
    ASSERT_TRUE(UiImageHandlePresent(first));
    ASSERT_TRUE(self.m_builder.drawImage(first, MakeUiHorizImageRect(2.0f, 3.0f, 16.0f, 8.0f)));
    DrawSnapshot snapshot = self.m_builder.freeze();
    for(usize index = 1u; index <= s_PaintMaxImages; ++index){
        const Expected<SharedImageSource> additionResult = self.makeImage(s_UiGpuOverflowImagePath, cast<u8>(index));
        ASSERT_TRUE(additionResult.has_value());
        ASSERT_TRUE(UiImageHandlePresent(additionResult.value()));
        UiGpuValAppendTexture(snapshot, additionResult.value());
    }
    ASSERT_EQ(snapshot.textureImages().size(), s_PaintMaxImages + 1u);
    EXPECT_TRUE(snapshot.glyphPages().empty());
    EXPECT_TRUE(snapshot.sdfPages().empty());
    EXPECT_FALSE(UiGpuValGlyphPages(snapshot));
    EXPECT_FALSE(UiGpuValSdfPages(snapshot));
    EXPECT_FALSE(UiGpuValTextureImages(snapshot));
}

void VerifyGpuTextureImageValidationFixture_SharedImageBudgetAcceptsMixedSourcesAtCapacity(mut GpuTextureImageValidationFixture self){
    DrawSnapshot snapshot = DrawSnapshot(self.m_arena);
    ASSERT_TRUE(UiGpuValBuildMaxBudgetSnapshot(self, false, snapshot));
    ASSERT_EQ(snapshot.glyphPages().size() + snapshot.sdfPages().size() + snapshot.textureImages().size(), s_PaintMaxImages);
    EXPECT_TRUE(UiGpuValGlyphPages(snapshot));
    EXPECT_TRUE(UiGpuValSdfPages(snapshot));
    EXPECT_TRUE(UiGpuValTextureImages(snapshot));
}

void VerifyGpuTextureImageValidationFixture_SharedImageBudgetOverflowIncludesEveryImageKind(mut GpuTextureImageValidationFixture self){
    DrawSnapshot snapshot = DrawSnapshot(self.m_arena);
    ASSERT_TRUE(UiGpuValBuildMaxBudgetSnapshot(self, true, snapshot));
    ASSERT_EQ(snapshot.glyphPages().size(), s_PaintMaxImages - 2u);
    ASSERT_EQ(snapshot.sdfPages().size(), 1u);
    ASSERT_EQ(snapshot.textureImages().size(), 2u);
    EXPECT_FALSE(UiGpuValGlyphPages(snapshot));
    EXPECT_FALSE(UiGpuValSdfPages(snapshot));
    EXPECT_FALSE(UiGpuValTextureImages(snapshot));
}

void VerifyGpuTextureImageValidationFixture_NonImageCommandsCannotReferenceTextureBindings(mut GpuTextureImageValidationFixture self){
    const Expected<SharedImageSource> imageResult = self.makeImage();
    const Expected<SharedGlyphPage> glyphResult = self.makeGlyph();
    const Expected<SharedSdfAtlasPage> sdfResult = self.makeSdf();
    ASSERT_TRUE(imageResult.has_value());
    ASSERT_TRUE(glyphResult.has_value());
    ASSERT_TRUE(sdfResult.has_value());
    const SharedImageSource image = imageResult.value();
    const SharedGlyphPage glyph = glyphResult.value();
    const SharedSdfAtlasPage sdf = sdfResult.value();
    ASSERT_TRUE(UiImageHandlePresent(image) && UiGlyphHandlePresent(glyph) && UiSdfHandlePresent(sdf));
    const Rect rectangle = MakeUiHorizImageRect(2.0f, 3.0f, 16.0f, 8.0f);
    const Rect uv = MakeUiHorizImageRect(0.0f, 0.0f, 1.0f, 1.0f);
    self.m_builder.fillRect(rectangle);
    ASSERT_TRUE(self.m_builder.drawRegion(s_UiInputNameSprite, rectangle));
    ASSERT_TRUE(self.m_builder.drawGlyph(glyph, rectangle, uv));
    ASSERT_TRUE(self.m_builder.drawSdfGlyph(sdf, 3u, rectangle, uv));
    ASSERT_TRUE(self.m_builder.drawImage(image, rectangle));
    DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.commands().size(), 5u);
    ASSERT_TRUE(UiGpuValAllImageBindings(snapshot));
    usize nonImageCount = 0u;
    for(usize index = 0u; index < snapshot.commands().size(); ++index){
        if(snapshot.commands()[index].material == PaintMaterial::Image)
            continue;
        ++nonImageCount;
        UiGpuValSetCommandTextureIndex(snapshot, index, 0u);
        EXPECT_FALSE(UiGpuValTextureImages(snapshot));
        EXPECT_FALSE(UiGpuValAllImageBindings(snapshot));
        UiGpuValSetCommandTextureIndex(snapshot, index, u32.max);
    }
    EXPECT_EQ(nonImageCount, 4u);
    EXPECT_TRUE(UiGpuValAllImageBindings(snapshot));
}

void VerifyGpuTextureImageValidationFixture_ImageCommandRejectsGlyphAndSdfMetadata(mut GpuTextureImageValidationFixture self){
    SharedImageSource image = SharedImageSource();
    ASSERT_TRUE(UiGpuValPrepareSingleGlyphSdfAndImage(self, image));
    ASSERT_TRUE(self.m_builder.drawImage(image, MakeUiHorizImageRect(2.0f, 3.0f, 16.0f, 8.0f)));
    DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.commands().size(), 1u);
    const DrawCommand original = snapshot.commands()[0u];
    for(u32 contamination = 0u; contamination < 3u; ++contamination){
        DrawCommand mutated = original;
        if(contamination == 0u)
            mutated.glyphPageIndex = 0u;
        else if(contamination == 1u)
            mutated.sdfPageIndex = 0u;
        else
            mutated.sdfChannel = 1u;
        UiGpuValSetCommand(snapshot, 0u, mutated);
        EXPECT_FALSE(UiGpuValTextureImages(snapshot));
        EXPECT_FALSE(UiGpuValGlyphPages(snapshot));
        EXPECT_FALSE(UiGpuValAllImageBindings(snapshot));
    }
    UiGpuValSetCommand(snapshot, 0u, original);
    EXPECT_TRUE(UiGpuValAllImageBindings(snapshot));
}

void VerifyGpuTextureImageValidationFixture_UnknownMaterialRejectsCombinedImageValidation(mut GpuTextureImageValidationFixture self){
    const Expected<SharedImageSource> imageResult = self.makeImage();
    ASSERT_TRUE(imageResult.has_value());
    ASSERT_TRUE(UiImageHandlePresent(imageResult.value()));
    ASSERT_TRUE(self.m_builder.drawImage(imageResult.value(), MakeUiHorizImageRect(2.0f, 3.0f, 16.0f, 8.0f)));
    DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.commands().size(), 1u);
    UiGpuValSetFirstCommandUnknownMaterial(snapshot);
    EXPECT_FALSE(UiGpuValGlyphPages(snapshot));
    EXPECT_FALSE(UiGpuValAllImageBindings(snapshot));
}


