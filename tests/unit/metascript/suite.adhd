NWB_ADHD_GTEST(AdhdCompiler, RejectsGlobalConstMutationMissingReturnsParallelIndexMutationAndNonEnumScopeAccess, VerifyAdhdCompiler_RejectsGlobalConstMutationMissingReturnsParallelIndexMutationAndNonEnumScopeAccess)
