const StringView s_SurfelIrradianceClearMarkerLabel = "Surfel Irradiance Clear";
const StringView s_SurfelAgeFreeMarkerLabel = "Surfel GI Age Free";
const StringView s_SurfelCellHeadClearMarkerLabel = "Surfel GI Cell Head Clear";
const StringView s_SurfelHashBuildMarkerLabel = "Surfel GI Hash Build";
const StringView s_SurfelSpawnMarkerLabel = "Surfel GI Spawn";
const StringView s_SurfelTraceBuildArgsMarkerLabel = "Surfel GI Trace Build Args";
const StringView s_SurfelTraceMarkerLabel = "Surfel GI Trace";
const StringView s_SurfelResolveMarkerLabel = "Surfel GI Resolve";
const StringView s_SurfelPassMarkerLabel = "Surfel GI";
const StringView s_SurfelInitPoolClearMarkerLabel = "Surfel GI Initialize Pool Clear";
const StringView s_SurfelInitCellHeadClearMarkerLabel = "Surfel GI Initialize Cell-Head Clear";
const StringView s_SurfelInitCounterClearMarkerLabel = "Surfel GI Initialize Counter Clear";
const StringView s_SurfelInitFreeListClearMarkerLabel = "Surfel GI Initialize Free-List Clear";
const StringView s_SurfelInitLifecycleMarkerLabel = "Surfel GI Initialize Lifecycle";
const StringView s_SurfelSnapshotCopyMarkerLabel = "Surfel GI Snapshot Copy";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u64 ComputeSurfelWordBufferByteSize(in u32 wordCount){
    return ComputeSurfelBufferByteSize(4u, wordCount);
}

b8 HasCompleteSurfelGiLifecycleGraphResources(
    in b8 hasPool,
    in b8 hasCellHead,
    in b8 hasCounter,
    in b8 hasFreeList,
    in b8 hasPoolSnapshot,
    in b8 hasCellHeadSnapshot
){
    return hasPool
        && hasCellHead
        && hasCounter
        && hasFreeList
        && hasPoolSnapshot
        && hasCellHeadSnapshot
    ;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<impl/assets/graphics/gi/surfel/surfel_binding_slots.h>"), cpp_name("NWB_SURFEL_CELL_INVALID")]
extern const u32 s_SurfelInvalidCell;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SurfelGiTaskStateSourceSet{
    public Array<GpuTaskExternalStateSource, s_SurfelGiStateSourceCapacity> values;
    public usize count = 0u;

    public void append(in GpuTaskExternalStateSource source, in b8 enabled){
        if(enabled && source.hasState()){
            this.values[this.count] = source;
            ++this.count;
        }
    }
}

SurfelGiTaskStateSourceSet MakeSurfelTaskStateSources(in GpuTaskExternalStateSource compute, in GpuTaskExternalStateSource counter, in GpuTaskExternalStateSource irradiance, in b8 includeCounter, in b8 includeIrradiance){
    SurfelGiTaskStateSourceSet result;
    result.append(compute, true);
    result.append(counter, includeCounter);
    result.append(irradiance, includeIrradiance);
    return result;
}

GpuClearBufferTaskDesc SurfelBufferClear(in GpuGraphResourceId destination, in u32 value){
    GpuClearBufferTaskDesc clear;
    clear.destination = destination;
    clear.clearValue = value;
    return clear;
}

GpuCopyBufferTaskRegion SurfelBufferCopy(in GpuGraphResourceId source, in GpuGraphResourceId destination, in u64 bytes){
    GpuCopyBufferTaskRegion region;
    region.source = source;
    region.destination = destination;
    region.dataSizeBytes = bytes;
    return region;
}

Expected<GpuTaskId> AddSurfelInitializationClear(mut GpuTaskGraph graph, in GpuTaskSchedulingHint scheduling, mut GpuTaskId dependency, in Name identity, in StringView label, in GpuGraphResourceId destination,
    in u32 value, in GpuTaskExternalStateSource state){
    GpuTaskDesc desc;
    const Array<GpuTaskExternalStateSource, 1u> states(state);
    desc.setIdentity(identity).setMarkerLabel(label).setScheduling(scheduling).setDependency(dependency)
        .setExternalStateSources(Span<GpuTaskExternalStateSource>(states).first(cast<usize>(state.hasState())));
    const auto task = graph.addClearBufferTask(desc, SurfelBufferClear(destination, value));
    if(task.has_value())
        dependency = task.value();
    return task;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 SurfelGiGraphCoordinator::declareDeferredSurfelGiTask(
        in SurfelGiGraphContext context,
        in DeferredLightingGraphResources deferredLightingResources,
        in RayTracingDeferredGraphResourceSnapshot rayTracingResources,
        in RayTracingSurfelPersistentResourceSnapshot rayTracingSurfelResources,
        in GpuGraphResourceId worldPosition,
        in GpuGraphResourceId normal,
        in GpuGraphResourceId surfelIrradiance,
        in GpuGraphResourceId currentBindlessSlots,
        in GpuGraphResourceId sceneShading,
        in GpuGraphResourceId lights,
        in GpuGraphResourceId materialContextSlots,
        in Span<GpuGraphResourceId> traceGeometryResources,
        in GpuGraphResourceSetId traceGeometrySet,
        in GpuGraphResourceSetId traceMaterialSampledTextureSet,
        in GpuTaskId effectsTask,
        in b8 useLaggedLightingHistory,
        in GpuExternalCompletionId surfelCounterReadbackCompletion,
        mut DeferredFrameTargets deferredTargets,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> asyncTiming
    ){

    SurfelGiTaskBuilder surfelGiTasks(context.rayTracing, context.graph);
    this.m_deferredSurfelGiPreparationTask = GpuTaskId();
    this.m_deferredSurfelGiInitializationLifecycleTask = GpuTaskId();
    this.m_deferredSurfelGiSnapshotCopyTask = GpuTaskId();
    this.m_deferredSurfelGiIrradianceClearTask = GpuTaskId();
    this.m_deferredSurfelGiAgeFreeTask = GpuTaskId();
    this.m_deferredSurfelGiCellHeadClearTask = GpuTaskId();
    this.m_deferredSurfelGiHashBuildTask = GpuTaskId();
    this.m_deferredSurfelGiSpawnTask = GpuTaskId();
    this.m_deferredSurfelGiTraceBuildArgsTask = GpuTaskId();
    this.m_deferredSurfelGiTraceTask = GpuTaskId();
    this.m_deferredSurfelGiResolveTask = GpuTaskId();
    asyncTiming.reset();
    this.m_deferredSurfelGiTask = GpuTaskId();
    this.m_deferredSurfelGiCounterReadbackTask = GpuTaskId();
    if(!deferredTargets.valid() || !deferredTargets.bindless.valid() || !worldPosition.valid() || !normal.valid() || !surfelIrradiance.valid() || !currentBindlessSlots.valid() || !sceneShading.valid() || !lights.valid() || !effectsTask.valid())
        return false;

    const b8 useHwTrace = rayTracingResources.surfelUsesHardwareTrace;
    const b8 hasSurfelWork = context.rayTracing.hasSurfelWork();
    const b8 traceGeometryStatesGraphOwned = traceGeometrySet.valid();
    const TraceResourceSetUses traceResourceSets = MakeTraceResourceSetUses(traceGeometrySet, traceMaterialSampledTextureSet);

    const GpuTaskExternalStateSource surfelGiComputeStateSource = ExternalStateSourceFromCache(context.computeState);
    const GpuTaskExternalStateSource surfelGiCounterStateSource = ExternalStateSourceFromCache(context.counterState);
    GpuTaskExternalStateSource surfelIrradianceReturnStateSource = ExternalStateSourceFromCache(context.irradianceReturnState);
    surfelIrradianceReturnStateSource.applicableConsumerQueueClass = CommandQueue::Compute;
    const Array<GpuTaskExternalStateSource, 1u> computeStates(surfelGiComputeStateSource);
    const SurfelGiTaskStateSourceSet surfelGiComputeCounterStateSources = MakeSurfelTaskStateSources(surfelGiComputeStateSource, surfelGiCounterStateSource, surfelIrradianceReturnStateSource, true, false);
    const SurfelGiTaskStateSourceSet surfelGiComputeReturnStateSources = MakeSurfelTaskStateSources(surfelGiComputeStateSource, surfelGiCounterStateSource, surfelIrradianceReturnStateSource, false, true);
    const SurfelGiTaskStateSourceSet surfelGiAllStateSources = MakeSurfelTaskStateSources(surfelGiComputeStateSource, surfelGiCounterStateSource, surfelIrradianceReturnStateSource, true, true);

    SurfelGiResourcePlan surfelGiResourcePlan;
    const SurfelGiResourceInputs surfelGiResourceInputs(
        deferredTargets, rayTracingResources, rayTracingSurfelResources,
        worldPosition, normal, surfelIrradiance, currentBindlessSlots, sceneShading, lights, materialContextSlots,
        traceGeometryResources, traceGeometryStatesGraphOwned, useHwTrace, hasSurfelWork
    );
    SurfelGiResourceBuilder surfelGiResourceBuilder(context.graph, context.rayTracing);
    if(!surfelGiResourceBuilder.prepare(surfelGiResourceInputs, surfelGiResourcePlan))
        return false;

    GpuTaskSchedulingHint scheduling;
    scheduling.cost = GpuTaskCostHint::Large;
    // Live Lighting joins both effects; lagged Lighting retains their independent publication boundaries.
    scheduling.forceSubmissionBoundary = useLaggedLightingHistory;
    scheduling.allowPacketMerge = !useLaggedLightingHistory;
    scheduling.mergeWithPrevious = !useLaggedLightingHistory;
    scheduling.allowMergeAcrossConsumerFrontier = !useLaggedLightingHistory;
    const Array<GpuExternalCompletionId, 1u> externalValues(surfelCounterReadbackCompletion);
    const Span<GpuExternalCompletionId> externalDependencies = Span<GpuExternalCompletionId>(externalValues).first(cast<usize>(surfelCounterReadbackCompletion.valid()));

    SurfelGiLifecycleBuilder surfelGiLifecycleBuilder(context.graph, context.rayTracing);
    SurfelGiLifecycleInputs surfelGiLifecycleInputs;
    surfelGiLifecycleInputs.targets.emplace(deferredTargets);
    surfelGiLifecycleInputs.dependency = effectsTask;
    surfelGiLifecycleInputs.surfelPool = surfelGiResourcePlan.surfelPool;
    surfelGiLifecycleInputs.surfelCellHead = surfelGiResourcePlan.surfelCellHead;
    surfelGiLifecycleInputs.surfelCounter = surfelGiResourcePlan.surfelCounter;
    surfelGiLifecycleInputs.surfelFreeList = surfelGiResourcePlan.surfelFreeList;
    surfelGiLifecycleInputs.surfelPoolSnapshot = surfelGiResourcePlan.surfelPoolSnapshot;
    surfelGiLifecycleInputs.surfelCellHeadSnapshot = surfelGiResourcePlan.surfelCellHeadSnapshot;
    if(rayTracingSurfelResources.poolBuffer.valid())
        surfelGiLifecycleInputs.poolSnapshotByteSize = rayTracingSurfelResources.poolBuffer.deref().getCreationDescription().byteSize;
    if(rayTracingSurfelResources.cellHeadBuffer.valid())
        surfelGiLifecycleInputs.cellHeadSnapshotByteSize = rayTracingSurfelResources.cellHeadBuffer.deref().getCreationDescription().byteSize;
    surfelGiLifecycleInputs.scheduling = scheduling;
    surfelGiLifecycleInputs.externalDependencies = externalDependencies;
    surfelGiLifecycleInputs.computeStateSource = surfelGiComputeStateSource;
    surfelGiLifecycleInputs.counterStateSource = surfelGiCounterStateSource;
    surfelGiLifecycleInputs.hasWork = hasSurfelWork;
    auto surfelGiLifecycleResult = surfelGiLifecycleBuilder.declare(surfelGiLifecycleInputs);
    if(!surfelGiLifecycleResult.has_value()){
        warning("RendererSystem: could not declare deferred surfel-GI lifecycle");
        return false;
    }
    this.m_deferredSurfelGiPreparationTask = surfelGiLifecycleResult.value().preparationTask;
    this.m_deferredSurfelGiInitializationLifecycleTask = surfelGiLifecycleResult.value().initializationLifecycleTask;
    this.m_deferredSurfelGiSnapshotCopyTask = surfelGiLifecycleResult.value().snapshotCopyTask;
    GpuTaskId surfelGiDependency = surfelGiLifecycleResult.value().dependency;

    // Zero coverage is the no-op; keep its clear at the front of the GI packet.
    GpuTaskSchedulingHint surfelIrradianceClearScheduling;
    surfelIrradianceClearScheduling.cost = GpuTaskCostHint::Tiny;
    surfelIrradianceClearScheduling.allowPacketMerge = true;
    surfelIrradianceClearScheduling.mergeWithPrevious = !useLaggedLightingHistory;
    surfelIrradianceClearScheduling.allowMergeAcrossConsumerFrontier = !useLaggedLightingHistory;
    // Compatible live effects share the snapshot packet; the GI chain retains its selected queue.
    ConfigureComputeEffectRoutingHint(false, surfelIrradianceClearScheduling);
    const Array<GpuTaskResourceUse, 1u> surfelIrradianceClearResourceUse(WriteTextureUse(surfelIrradiance, s_FramebufferSubresources, ResourceStates::CopyDest));
    GpuTaskDesc surfelIrradianceClearDesc;
    surfelIrradianceClearDesc
        .setIdentity(Name(s_SurfelGraphIrradianceClear))
        .setMarkerLabel(s_SurfelIrradianceClearMarkerLabel)
        .setScheduling(surfelIrradianceClearScheduling)
        .setDependency(surfelGiDependency)
        .setResourceUses(surfelIrradianceClearResourceUse)
    ;
    const auto surfelIrradianceClearTaskResult = AddFloatTextureClearTask(context.graph, surfelIrradianceClearDesc, surfelIrradiance, s_FramebufferSubresources, s_SurfelIrradianceClearColor);
    if(!surfelIrradianceClearTaskResult.has_value()){
        warning("RendererSystem: could not declare graph-owned deferred surfel-irradiance clear");
        return false;
    }
    const GpuTaskId surfelIrradianceClearTask = surfelIrradianceClearTaskResult.value();
    this.m_deferredSurfelGiIrradianceClearTask = surfelIrradianceClearTask;
    surfelGiDependency = surfelIrradianceClearTask;

    GpuTaskSchedulingHint surfelGiScheduling = scheduling;
    surfelGiScheduling.forceSubmissionBoundary = false;
    surfelGiScheduling.allowPacketMerge = true;
    surfelGiScheduling.mergeWithPrevious = true;
    // GI stages share one accepted timing packet; cross-queue consumers wait for it.
    surfelGiScheduling.allowMergeAcrossConsumerFrontier = true;
    ConfigureComputeEffectRoutingHint(true, surfelGiScheduling);
    if(surfelGiResourcePlan.graphOwnsSurfelGiResolve){
        const Array<GpuTaskResourceUse, 4u> ageFreeResourceUses(
            ReadUse(surfelGiResourcePlan.surfelConstants, ResourceStates::ConstantBuffer),
            WriteUse(surfelGiResourcePlan.surfelPool, ResourceStates::UnorderedAccess),
            WriteUse(surfelGiResourcePlan.surfelCounter, ResourceStates::UnorderedAccess),
            WriteUse(surfelGiResourcePlan.surfelFreeList, ResourceStates::UnorderedAccess)
        );

        GpuTaskDesc ageFreeDesc;
        ageFreeDesc
            .setIdentity(Name(s_SurfelGraphAgeFree))
            .setMarkerLabel(s_SurfelAgeFreeMarkerLabel)
            .setScheduling(surfelGiScheduling)
            .setDependency(surfelGiDependency)
            .setExternalDependencies(externalDependencies)
            .setExternalStateSources(Span<GpuTaskExternalStateSource>(surfelGiComputeCounterStateSources.values).first(surfelGiComputeCounterStateSources.count))
            .setResourceUses(ageFreeResourceUses)
        ;
        const auto deferredSurfelGiAgeFreeTaskResult = surfelGiTasks.declareAgeFreeTask(ageFreeDesc, deferredLightingResources, deferredTargets, timingTicket, asyncTiming);
        if(!deferredSurfelGiAgeFreeTaskResult.has_value()){
            this.m_deferredSurfelGiAgeFreeTask = GpuTaskId();
            warning("RendererSystem: could not declare deferred surfel-GI age/free graph task");
            return false;
        }
        this.m_deferredSurfelGiAgeFreeTask = deferredSurfelGiAgeFreeTaskResult.value();

        GpuTaskDesc cellHeadClearDesc;
        cellHeadClearDesc
            .setIdentity(Name(s_SurfelGraphCellHeadClear))
            .setMarkerLabel(s_SurfelCellHeadClearMarkerLabel)
            .setScheduling(surfelGiScheduling)
            .setDependency(this.m_deferredSurfelGiAgeFreeTask)
            .setExternalStateSources(Span<GpuTaskExternalStateSource>(computeStates).first(cast<usize>(surfelGiComputeStateSource.hasState())))
        ;
        const auto deferredSurfelGiCellHeadClearTaskResult = context.graph.addClearBufferTask(cellHeadClearDesc, SurfelBufferClear(surfelGiResourcePlan.surfelCellHead, s_SurfelInvalidCell));
        if(!deferredSurfelGiCellHeadClearTaskResult.has_value()){
            this.m_deferredSurfelGiCellHeadClearTask = GpuTaskId();
            warning("RendererSystem: could not declare graph-owned deferred surfel cell-head clear");
            return false;
        }
        this.m_deferredSurfelGiCellHeadClearTask = deferredSurfelGiCellHeadClearTaskResult.value();

        const Array<GpuTaskResourceUse, 3u> hashBuildResourceUses(
            ReadUse(surfelGiResourcePlan.surfelConstants, ResourceStates::ConstantBuffer),
            ReadWriteUse(surfelGiResourcePlan.surfelPool, ResourceStates::UnorderedAccess),
            ReadWriteUse(surfelGiResourcePlan.surfelCellHead, ResourceStates::UnorderedAccess)
        );
        GpuTaskDesc hashBuildDesc;
        hashBuildDesc
            .setIdentity(Name(s_SurfelGraphHashBuild))
            .setMarkerLabel(s_SurfelHashBuildMarkerLabel)
            .setScheduling(surfelGiScheduling)
            .setDependency(this.m_deferredSurfelGiCellHeadClearTask)
            .setResourceUses(hashBuildResourceUses)
        ;
        const auto deferredSurfelGiHashBuildTaskResult = surfelGiTasks.declareHashBuildTask(hashBuildDesc, deferredLightingResources, deferredTargets, timingTicket, asyncTiming);
        if(!deferredSurfelGiHashBuildTaskResult.has_value()){
            this.m_deferredSurfelGiHashBuildTask = GpuTaskId();
            warning("RendererSystem: could not declare deferred surfel-GI hash-build graph task");
            return false;
        }
        this.m_deferredSurfelGiHashBuildTask = deferredSurfelGiHashBuildTaskResult.value();

        const Array<GpuTaskResourceUse, 10u> spawnResourceUses(
            ReadUse(worldPosition),
            ReadUse(normal),
            ReadUse(surfelGiResourcePlan.surfelConstants, ResourceStates::ConstantBuffer),
            ReadWriteUse(surfelGiResourcePlan.surfelPool, ResourceStates::UnorderedAccess),
            ReadWriteUse(surfelGiResourcePlan.surfelGuidePool, ResourceStates::UnorderedAccess),
            ReadWriteUse(surfelGiResourcePlan.surfelCellHead, ResourceStates::UnorderedAccess),
            ReadWriteUse(surfelGiResourcePlan.surfelCounter, ResourceStates::UnorderedAccess),
            ReadWriteUse(surfelGiResourcePlan.surfelFreeList, ResourceStates::UnorderedAccess),
            ReadUse(surfelGiResourcePlan.surfelPoolSnapshot, ResourceStates::ShaderResource),
            ReadUse(surfelGiResourcePlan.surfelCellHeadSnapshot, ResourceStates::ShaderResource)
        );
        GpuTaskDesc spawnDesc;
        spawnDesc.setIdentity(Name(s_SurfelGraphSpawn)).setMarkerLabel(s_SurfelSpawnMarkerLabel).setScheduling(surfelGiScheduling).setDependency(this.m_deferredSurfelGiHashBuildTask).setResourceUses(spawnResourceUses);
        const auto deferredSurfelGiSpawnTaskResult = surfelGiTasks.declareSpawnTask(spawnDesc, deferredLightingResources, deferredTargets, timingTicket, asyncTiming);
        if(!deferredSurfelGiSpawnTaskResult.has_value()){
            this.m_deferredSurfelGiSpawnTask = GpuTaskId();
            warning("RendererSystem: could not declare deferred surfel-GI spawn graph task");
            return false;
        }
        this.m_deferredSurfelGiSpawnTask = deferredSurfelGiSpawnTaskResult.value();

        const Array<GpuTaskResourceUse, 3u> traceBuildArgsResourceUses(
            ReadUse(surfelGiResourcePlan.surfelConstants, ResourceStates::ConstantBuffer),
            ReadUse(surfelGiResourcePlan.surfelCounter, ResourceStates::UnorderedAccess),
            WriteUse(surfelGiResourcePlan.surfelTraceIndirectArgs, ResourceStates::UnorderedAccess)
        );
        GpuTaskDesc traceBuildArgsDesc;
        traceBuildArgsDesc
            .setIdentity(Name(s_SurfelGraphTraceBuildArgs))
            .setMarkerLabel(s_SurfelTraceBuildArgsMarkerLabel)
            .setScheduling(surfelGiScheduling)
            .setDependency(this.m_deferredSurfelGiSpawnTask)
            .setExternalStateSources(Span<GpuTaskExternalStateSource>(surfelGiComputeCounterStateSources.values).first(surfelGiComputeCounterStateSources.count))
            .setResourceUses(traceBuildArgsResourceUses)
        ;
        const auto deferredSurfelGiTraceBuildArgsTaskResult = surfelGiTasks.declareTraceBuildArgsTask(traceBuildArgsDesc, deferredLightingResources, deferredTargets, timingTicket, asyncTiming);
        if(!deferredSurfelGiTraceBuildArgsTaskResult.has_value()){
            this.m_deferredSurfelGiTraceBuildArgsTask = GpuTaskId();
            warning("RendererSystem: could not declare deferred surfel-GI trace-build-args graph task");
            return false;
        }
        this.m_deferredSurfelGiTraceBuildArgsTask = deferredSurfelGiTraceBuildArgsTaskResult.value();

        GpuTaskDesc traceDesc;
        const SurfelGiTaskStateSourceSet traceStateSources = MakeSurfelTaskStateSources(surfelGiComputeStateSource, surfelGiCounterStateSource, surfelIrradianceReturnStateSource, surfelGiResourcePlan.csgTraceContext.valid(), false);
        traceDesc
            .setIdentity(Name(s_SurfelGraphTrace))
            .setMarkerLabel(s_SurfelTraceMarkerLabel)
            .setScheduling(surfelGiScheduling)
            .setDependency(this.m_deferredSurfelGiTraceBuildArgsTask)
            .setExternalStateSources(Span<GpuTaskExternalStateSource>(traceStateSources.values).first(traceStateSources.count))
            .setResourceUses(surfelGiResourcePlan.traceResourceUses)
            .setResourceSetUses(Span<GpuTaskResourceSetUse>(traceResourceSets.uses).first(traceResourceSets.useCount))
        ;
        const auto deferredSurfelGiTraceTaskResult = surfelGiTasks.declareTraceTask(traceDesc, deferredLightingResources, deferredTargets, timingTicket, asyncTiming);
        if(!deferredSurfelGiTraceTaskResult.has_value()){
            this.m_deferredSurfelGiTraceTask = GpuTaskId();
            warning("RendererSystem: could not declare deferred surfel-GI trace graph task");
            return false;
        }
        this.m_deferredSurfelGiTraceTask = deferredSurfelGiTraceTaskResult.value();

        const Array<GpuTaskResourceUse, 6u> resolveResourceUses(
            ReadUse(worldPosition),
            ReadUse(normal),
            ReadUse(surfelGiResourcePlan.surfelConstants, ResourceStates::ConstantBuffer),
            ReadUse(surfelGiResourcePlan.surfelPool, ResourceStates::ShaderResource),
            ReadUse(surfelGiResourcePlan.surfelCellHead, ResourceStates::ShaderResource),
            WriteUse(surfelGiResourcePlan.surfelIrradianceHalf, ResourceStates::UnorderedAccess)
        );
        GpuTaskDesc resolveDesc;
        resolveDesc
            .setIdentity(Name(s_SurfelGraphResolve))
            .setMarkerLabel(s_SurfelResolveMarkerLabel)
            .setScheduling(surfelGiScheduling)
            .setDependency(this.m_deferredSurfelGiTraceTask)
            .setExternalStateSources(Span<GpuTaskExternalStateSource>(computeStates).first(cast<usize>(surfelGiComputeStateSource.hasState())))
            .setResourceUses(resolveResourceUses)
        ;
        const auto deferredSurfelGiResolveTaskResult = surfelGiTasks.declareResolveTask(resolveDesc, deferredLightingResources, deferredTargets, timingTicket, asyncTiming);
        if(!deferredSurfelGiResolveTaskResult.has_value()){
            this.m_deferredSurfelGiResolveTask = GpuTaskId();
            warning("RendererSystem: could not declare deferred surfel-GI resolve graph task");
            return false;
        }
        this.m_deferredSurfelGiResolveTask = deferredSurfelGiResolveTaskResult.value();
        surfelGiDependency = this.m_deferredSurfelGiResolveTask;
    }

    SurfelGiTaskStateSourceSet terminalStateSources = surfelGiAllStateSources;
    if(surfelGiResourcePlan.graphOwnsSurfelGiResolve)
        terminalStateSources = surfelGiComputeReturnStateSources;
    GpuTaskDesc desc;
    desc
        .setIdentity(Name(s_SurfelGraphPass))
        .setMarkerLabel(s_SurfelPassMarkerLabel)
        .setScheduling(surfelGiScheduling)
        .setDependency(surfelGiDependency)
        .setExternalStateSources(Span<GpuTaskExternalStateSource>(terminalStateSources.values).first(terminalStateSources.count))
        .setResourceUses(surfelGiResourcePlan.resourceUses)
    ;
    Expected<GpuTaskId> deferredSurfelGiTaskResult = MakeUnexpected(Failure());
    if(surfelGiResourcePlan.graphOwnsSurfelGiResolve)
        deferredSurfelGiTaskResult = surfelGiTasks.declareTerminalTask(desc, deferredLightingResources, deferredTargets, timingTicket, asyncTiming);
    else{
        desc.setExternalDependencies(externalDependencies).setResourceSetUses(Span<GpuTaskResourceSetUse>(traceResourceSets.uses).first(traceResourceSets.useCount));
        deferredSurfelGiTaskResult = surfelGiTasks.declareTerminalTask(desc, deferredLightingResources, deferredTargets, timingTicket);
    }
    if(!deferredSurfelGiTaskResult.has_value()){
        this.m_deferredSurfelGiTask = GpuTaskId();
        warning("RendererSystem: could not declare deferred surfel-GI graph task");
        return false;
    }
    this.m_deferredSurfelGiTask = deferredSurfelGiTaskResult.value();
    return true;
}

void SurfelGiGraphCoordinator::declareDeferredSurfelCountReadbackTask(in SurfelGiGraphContext context, in RayTracingSurfelPersistentResourceSnapshot rayTracingSurfelResources){
    SurfelGiCounterReadbackBuilder builder(context.graph, context.rayTracing);
    builder.declare(rayTracingSurfelResources, this.m_deferredSurfelGiTask, context.frameTimingEndTask, this.m_deferredSurfelGiCounterReadbackTask);
}

void SurfelGiCounterReadbackBuilder::declare(in RayTracingSurfelPersistentResourceSnapshot rayTracingSurfelResources, in GpuTaskId surfelTask, in GpuTaskId timingEndTask, mut GpuTaskId outTask){
    outTask = GpuTaskId();
    if(!surfelTask.valid() || !timingEndTask.valid() || !this.m_raytracingSystem.shouldCaptureSurfelCountReadback())
        return;

    const auto counterResult = this.m_graph.importBuffer(rayTracingSurfelResources.counterBuffer, BufferResourceDesc(Name(s_SurfelCounterName), s_SurfelCounterLabel));
    const auto readbackResult = this.m_graph.importBuffer(rayTracingSurfelResources.counterReadbackBuffer, BufferResourceDesc(Name(s_SurfelCounterReadbackName), s_SurfelCounterReadbackLabel));
    if(!counterResult.has_value() || !readbackResult.has_value()){
        warning("RendererSystem: could not import surfel counter-readback graph resources");
        return;
    }
    const GpuGraphResourceId counter = counterResult.value();
    const GpuGraphResourceId readback = readbackResult.value();

    const Array<GpuCopyBufferTaskRegion, 1u> regions(SurfelBufferCopy(counter, readback, ComputeSurfelWordBufferByteSize(cast<u32>(s_SurfelReadbackCounterCount))));
    GpuTaskSchedulingHint scheduling;
    // Infrequent diagnostic after presentation; small copy so Transfer absorbs it.
    scheduling.cost = GpuTaskCostHint::Small;
    scheduling.forceSubmissionBoundary = true;
    scheduling.allowPacketMerge = false;
    const Array<GpuTaskId, 2u> dependencies(surfelTask, timingEndTask);
    GpuTaskDesc desc;
    desc.setIdentity(Name(s_SurfelCounterReadbackName)).setMarkerLabel(s_SurfelCounterReadbackLabel).setScheduling(scheduling).setDependencies(dependencies);
    const auto deferredSurfelGiCounterReadbackTaskResult = this.m_graph.addCopyBufferRegions(desc, Span<GpuCopyBufferTaskRegion>(regions));
    if(!deferredSurfelGiCounterReadbackTaskResult.has_value()){
        outTask = GpuTaskId();
        warning("RendererSystem: could not declare deferred surfel counter-readback task");
        return;
    }
    outTask = deferredSurfelGiCounterReadbackTaskResult.value();
    // The token stays invalid until native submission accepts; this timestamp is only read when it publishes.
    this.m_raytracingSystem.markSurfelCountReadbackScheduled();
}

Expected<SurfelGiLifecycleResult> SurfelGiLifecycleBuilder::declare(in SurfelGiLifecycleInputs inputs){
    SurfelGiLifecycleResult result;
    if(!inputs.targets.has_value())
        return MakeUnexpected(Failure());
    const Array<GpuTaskExternalStateSource, 1u> computeStates(inputs.computeStateSource);
    GpuTaskId dependency = inputs.dependency;
    result.dependency = inputs.dependency;
    if(!inputs.hasWork)
        return result;

    if(!HasCompleteSurfelGiLifecycleGraphResources(
        inputs.surfelPool.valid(),
        inputs.surfelCellHead.valid(),
        inputs.surfelCounter.valid(),
        inputs.surfelFreeList.valid(),
        inputs.surfelPoolSnapshot.valid(),
        inputs.surfelCellHeadSnapshot.valid()
    )){
        warning("RendererSystem: surfel-GI snapshot resources were unavailable during graph declaration");
        return MakeUnexpected(Failure());
    }

    if(this.m_raytracingSystem.needsSurfelResourceInitialization()){
        GpuTaskSchedulingHint initializationScheduling;
        initializationScheduling.cost = GpuTaskCostHint::Medium;
        // Merge serial successors into the first clear's packet; never force a boundary here.
        initializationScheduling.allowPacketMerge = true;
        GpuTaskDesc poolClearDesc;
        poolClearDesc
            .setIdentity(Name(s_SurfelGraphInitializePoolClear))
            .setMarkerLabel(s_SurfelInitPoolClearMarkerLabel)
            .setScheduling(initializationScheduling)
            .setDependency(dependency)
            .setExternalDependencies(inputs.externalDependencies)
            .setExternalStateSources(Span<GpuTaskExternalStateSource>(computeStates).first(cast<usize>(inputs.computeStateSource.hasState())))
        ;
        const auto preparationTaskResult = this.m_graph.addClearBufferTask(poolClearDesc, SurfelBufferClear(inputs.surfelPool, 0u));
        if(!preparationTaskResult.has_value()){
            warning("RendererSystem: could not declare deferred surfel-GI pool initialization clear");
            return MakeUnexpected(Failure());
        }
        result.preparationTask = preparationTaskResult.value();

        GpuTaskSchedulingHint chainedInitializationScheduling = initializationScheduling;
        chainedInitializationScheduling.cost = GpuTaskCostHint::Tiny;
        chainedInitializationScheduling.mergeWithPrevious = true;
        // Snapshot may route to Transfer; retain the full init chain in one accepted packet.
        chainedInitializationScheduling.allowMergeAcrossConsumerFrontier = true;
        GpuTaskId initializationDependency = result.preparationTask;
        if(
            !AddSurfelInitializationClear(this.m_graph, chainedInitializationScheduling, initializationDependency,
                Name(s_SurfelGraphInitializeCellHeadClear),
                s_SurfelInitCellHeadClearMarkerLabel,
                inputs.surfelCellHead,
                s_SurfelInvalidCell,
                inputs.computeStateSource
            ).has_value()
            || !AddSurfelInitializationClear(this.m_graph, chainedInitializationScheduling, initializationDependency,
                Name(s_SurfelGraphInitializeCounterClear),
                s_SurfelInitCounterClearMarkerLabel,
                inputs.surfelCounter,
                0u,
                inputs.counterStateSource
            ).has_value()
            || !AddSurfelInitializationClear(this.m_graph, chainedInitializationScheduling, initializationDependency,
                Name(s_SurfelGraphInitializeFreeListClear),
                s_SurfelInitFreeListClearMarkerLabel,
                inputs.surfelFreeList,
                0u,
                inputs.computeStateSource
            ).has_value()
        ){
            warning("RendererSystem: could not declare deferred surfel-GI initialization clears");
            return MakeUnexpected(Failure());
        }

        GpuTaskDesc initializationLifecycleDesc;
        initializationLifecycleDesc.setIdentity(Name(s_SurfelGraphInitializeLifecycle)).setMarkerLabel(s_SurfelInitLifecycleMarkerLabel).setScheduling(chainedInitializationScheduling).setDependency(initializationDependency);
        const auto initializationLifecycleTaskResult = DeclareSurfelInitializationTask(this.m_raytracingSystem, this.m_graph, initializationLifecycleDesc);
        if(!initializationLifecycleTaskResult.has_value()){
            warning("RendererSystem: could not declare deferred surfel-GI initialization lifecycle");
            return MakeUnexpected(Failure());
        }
        result.initializationLifecycleTask = initializationLifecycleTaskResult.value();
        dependency = result.initializationLifecycleTask;
    }

    const Array<GpuCopyBufferTaskRegion, 2u> snapshotRegions(
            SurfelBufferCopy(inputs.surfelPool, inputs.surfelPoolSnapshot, inputs.poolSnapshotByteSize),
        SurfelBufferCopy(inputs.surfelCellHead, inputs.surfelCellHeadSnapshot, inputs.cellHeadSnapshotByteSize)
        );
    GpuTaskDesc snapshotDesc;
    snapshotDesc
        .setIdentity(Name(s_SurfelGraphSnapshotCopy))
        .setMarkerLabel(s_SurfelSnapshotCopyMarkerLabel)
        .setScheduling(inputs.scheduling)
        .setDependency(dependency)
        .setExternalStateSources(Span<GpuTaskExternalStateSource>(computeStates).first(cast<usize>(inputs.computeStateSource.hasState())))
    ;
    const auto snapshotCopyTaskResult = this.m_graph.addCopyBufferRegions(snapshotDesc, Span<GpuCopyBufferTaskRegion>(snapshotRegions));
    if(!snapshotCopyTaskResult.has_value()){
        warning("RendererSystem: could not declare deferred surfel-GI snapshot-copy task");
        return MakeUnexpected(Failure());
    }
    result.snapshotCopyTask = snapshotCopyTaskResult.value();
    if(!result.preparationTask.valid())
        result.preparationTask = result.snapshotCopyTask;
    result.dependency = result.snapshotCopyTask;
    return result;
}


