////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ShouldMergeOpaqueGbufferAcrossConsumerFrontier(in b8 regularOwned, in b8 sharedOwned, in b8 csgReceiverOwned){
    return regularOwned || sharedOwned || csgReceiverOwned;
}

u64 ComputeOpaqueBufferByteRangeLength(in usize elementCount, in usize elementStrideBytes){
    return cast<u64>(elementCount * elementStrideBytes);
}

b8 HasRequiredGraphicsPrefixTimingSlots(in usize timingSlotCount){
    return timingSlotCount >= cast<usize>(DeferredGraphicsPrefixTimingSlot::kCount);
}

b8 IsGraphicsPrefixCoreResourcesValid(
    in b8 targetsValid,
    in b8 shadowPrepareTaskValid,
    in b8 lightingResourcesValid,
    in b8 albedoValid,
    in b8 normalValid,
    in b8 worldPositionValid,
    in b8 specularRoughnessValid,
    in b8 depthValid,
    in b8 opaqueColorValid,
    in b8 sceneShadingValid,
    in b8 lightsValid,
    in b8 meshViewValid,
    in b8 currentBindlessSlotsValid,
    in b8 materialContextSlotsValid
){
    return
        targetsValid
        && shadowPrepareTaskValid
        && lightingResourcesValid
        && albedoValid
        && normalValid
        && worldPositionValid
        && specularRoughnessValid
        && depthValid
        && opaqueColorValid
        && sceneShadingValid
        && lightsValid
        && meshViewValid
        && currentBindlessSlotsValid
        && materialContextSlotsValid
    ;
}

b8 IsGraphicsPrefixOpaqueCsgResourcesValid(
    in b8 hasOpaqueCsgFrameWork,
    in b8 csgCapBackNormalValid,
    in b8 csgIntervalDepthValid,
    in b8 csgIntervalIdValid,
    in b8 csgReceiverEventDataValid,
    in b8 csgReceiverEventCountValid,
    in b8 csgReceiverSpanDataValid,
    in b8 csgReceiverSpanCountValid,
    in b8 csgRemovedIntervalDepthValid,
    in b8 csgRemovedIntervalCapNormalValid,
    in b8 csgRemovedIntervalDataValid,
    in b8 csgRemovedIntervalCountValid
){
    if(!hasOpaqueCsgFrameWork)
        return true;
    return
        csgCapBackNormalValid
        && csgIntervalDepthValid
        && csgIntervalIdValid
        && csgReceiverEventDataValid
        && csgReceiverEventCountValid
        && csgReceiverSpanDataValid
        && csgReceiverSpanCountValid
        && csgRemovedIntervalDepthValid
        && csgRemovedIntervalCapNormalValid
        && csgRemovedIntervalDataValid
        && csgRemovedIntervalCountValid
    ;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
Expected<u64> GraphicsPrefixGraphCoordinator::declareDeferredGraphicsPrefixTasks(
    in GraphicsPrefixGraphContext context,
    in GpuTaskId shadowPrepareTask,
    in CsgFrameState csgFrameState,
    in MeshFrameBindingSnapshot frameBindings,
    in CsgGraphResourceSnapshot csgResources,
    in b8 hasOpaqueCsgFrameWork,
    in f32 meshViewAspectRatio,
    in MeshViewGpuData meshViewState,
    in b8 meshViewUploadRequired,
    in DeferredGraphResourceImportResult resources,
    in Span<GpuGraphResourceId> shadowTraceGeometryResources,
    in GpuGraphResourceSetId shadowTraceGeometrySet,
    in borrow b8 asyncPrefixTimingSpansOnePacket,
    mut DeferredFrameTargets deferredTargets,
    mut ObjectGeometryCacheGraph objectGeometry,
    mut Optional<GpuTimingMeasure> asyncPrefixTiming,
    mut Optional<GpuTimingMeasure> deferredClearTiming,
    mut GraphClearTimingRecordState deferredClearTimingState,
    mut GraphClearTimingRecordState csgIntervalClearTimingState,
    mut Optional<GpuTimingMeasure> opaqueRegularSharedComputeEmulationTiming,
    mut Optional<GpuTimingMeasure> opaqueCsgIntervalSampleComputeEmulationTiming,
    in Span<GraphicsPrefixTimingTicket> timingTickets
){

    this.m_graphicsPrefixMeshViewSetupTask = GpuTaskId();
    this.m_graphicsPrefixSceneShadingSetupTask = GpuTaskId();
    this.m_graphicsPrefixDeferredClearTask = GpuTaskId();
    this.m_graphicsPrefixCsgIntervalClearFirstTask = GpuTaskId();
    this.m_graphicsPrefixCsgIntervalClearTask = GpuTaskId();
    this.resetGraphicsPrefixTaskState();
    this.m_graphicsPrefixMeshViewSetupReady = false;
    this.m_graphicsPrefixSceneShadingSetupReady = false;

    const DeferredLightingGraphResources deferredLightingResources = context.deferred.lightingGraphResources();

    if(
        !IsGraphicsPrefixCoreResourcesValid(
            deferredTargets.valid(),
            shadowPrepareTask.valid(),
            deferredLightingResources.valid(),
            resources.albedo.valid(),
            resources.normal.valid(),
            resources.worldPosition.valid(),
            resources.specularRoughness.valid(),
            resources.depth.valid(),
            resources.opaqueColor.valid(),
            resources.sceneShading.valid(),
            resources.lights.valid(),
            resources.meshView.valid(),
            resources.currentBindlessSlots.valid(),
            resources.materialContextSlots.valid()
        )
        || !IsGraphicsPrefixOpaqueCsgResourcesValid(
            hasOpaqueCsgFrameWork,
            resources.csgCapBackNormal.valid(),
            resources.csgIntervalDepth.valid(),
            resources.csgIntervalId.valid(),
            resources.csgReceiverEventData.valid(),
            resources.csgReceiverEventCount.valid(),
            resources.csgReceiverSpanData.valid(),
            resources.csgReceiverSpanCount.valid(),
            resources.csgRemovedIntervalDepth.valid(),
            resources.csgRemovedIntervalCapNormal.valid(),
            resources.csgRemovedIntervalData.valid(),
            resources.csgRemovedIntervalCount.valid()
        )
        || !HasRequiredGraphicsPrefixTimingSlots(timingTickets.size())
        || !deferredClearTimingState.usesRebindableTiming(deferredClearTiming)
    )
        return MakeUnexpected(Failure());
    for(usize timingSlot = 0u; timingSlot < cast<usize>(DeferredGraphicsPrefixTimingSlot::kCount); ++timingSlot){
        if(!timingTickets[timingSlot].has_value())
            return MakeUnexpected(Failure());
    }
    const TextureSubresourceSet csgPeelSubresources(0u, 1u, 0u, deferredTargets.csgPeelLayerCount);
    const TextureSubresourceSet csgReceiverEventDataSubresources(0u, 1u, 0u, deferredTargets.csgReceiverEventLayerCount);
    const TextureSubresourceSet csgReceiverEventCountSubresources(0u, 1u, 0u, 1u);

    const RayTracingLightingClassificationInput rayTracingLightingInput = context.rayTracing.snapshotLightingClassificationInput();
    PrefixSceneUploadBuilder prefixSceneUploadBuilder(context.graph, context.deferred, context.mesh, context.graphics);
    PrefixSceneUploadInputs prefixInputs(meshViewState, asyncPrefixTiming,
        timingTickets[cast<usize>(DeferredGraphicsPrefixTimingSlot::MeshViewSetup)], timingTickets[cast<usize>(DeferredGraphicsPrefixTimingSlot::SceneShadingSetup)],
        asyncPrefixTimingSpansOnePacket, context.shadowVisibilityTask, this.m_graphicsPrefixMeshViewSetupReady, this.m_graphicsPrefixSceneShadingSetupReady);
    prefixInputs.rayTracingLightingInput = rayTracingLightingInput;
    prefixInputs.meshView = resources.meshView;
    prefixInputs.lights = resources.lights;
    prefixInputs.sceneShading = resources.sceneShading;
    prefixInputs.shadowPrepareTask = shadowPrepareTask;
    prefixInputs.meshViewAspectRatio = meshViewAspectRatio;
    prefixInputs.meshViewUploadRequired = meshViewUploadRequired;
    auto prefixSceneUploadResult = prefixSceneUploadBuilder.declare(prefixInputs);
    if(!prefixSceneUploadResult.has_value()){
        warning("RendererSystem: could not declare graphics-prefix scene uploads");
        return MakeUnexpected(Failure());
    }
    this.m_graphicsPrefixMeshViewSetupTask = prefixSceneUploadResult.value().meshViewSetupTask;
    this.m_graphicsPrefixSceneShadingSetupTask = prefixSceneUploadResult.value().sceneShadingSetupTask;
    const RayTracingLightingClassification rayTracingLightingClassification = prefixSceneUploadResult.value().lightingClassification;
    const u32 sceneLightCount = prefixSceneUploadResult.value().lightCount;
    GpuTaskSchedulingHint clearScheduling;
    clearScheduling.cost = GpuTaskCostHint::Tiny;
    clearScheduling.forceSubmissionBoundary = false;
    clearScheduling.allowPacketMerge = true;
    clearScheduling.mergeWithPrevious = true;
    const GpuClearTextureTaskRecordHooks deferredClearHooks = deferredClearTimingState.hooks(true, true);
    GpuTaskDesc deferredClearDesc;
    deferredClearDesc.setIdentity(Name(s_FrameGraphNameRenderGraphicsPrefixDeferredClearOpaqueColor)).setMarkerLabel("Deferred Clear Opaque Color").setScheduling(clearScheduling).setDependency(this.m_graphicsPrefixSceneShadingSetupTask);
    GpuClearTextureTaskDesc opaqueColorClearDesc;
    opaqueColorClearDesc.destination = resources.opaqueColor;
    opaqueColorClearDesc.subresources = s_FramebufferSubresources;
    opaqueColorClearDesc.valueType = GpuClearTextureTaskValueType::Float;
    opaqueColorClearDesc.floatValue = s_ClearColor;
    opaqueColorClearDesc.recordHooks = deferredClearHooks;
    const auto graphicsPrefixDeferredClearTaskResult = context.graph.addClearTextureTask(deferredClearDesc, opaqueColorClearDesc);
    if(!graphicsPrefixDeferredClearTaskResult.has_value()){
        this.m_graphicsPrefixDeferredClearTask = GpuTaskId();
        warning("RendererSystem: could not declare deferred-clear task");
        return MakeUnexpected(Failure());
    }
    this.m_graphicsPrefixDeferredClearTask = graphicsPrefixDeferredClearTaskResult.value();

    MaterialPassDrawItemPartitions opaqueDrawItems;
    InstanceGpuDataVector instanceData;
    CsgFrameGpuData csgFrameData;
    MaterialTypedInstanceRangeVector materialTypedRanges;
    MaterialTypedByteDataVector materialTypedBytes;
    context.material.gatherMaterialPassDrawItems(
        deferredTargets.framebuffer,
        MaterialPipelinePass::Opaque,
        false,
        csgFrameState,
        RendererResourceLookupMode::PreparedOnly,
        Optional<in MeshViewGpuData>(meshViewState),
        opaqueDrawItems,
        instanceData,
        csgFrameData,
        materialTypedRanges,
        materialTypedBytes
    );

    GbufferGraphTask gbufferPayload(
        context.graphics,
        context.material,
        context.csg,
        deferredTargets,
        timingTickets[cast<usize>(DeferredGraphicsPrefixTimingSlot::Gbuffer)],
        this.m_graphicsPrefixMeshViewSetupReady,
        this.m_graphicsPrefixSceneShadingSetupReady
    );
    gbufferPayload.frameBindings = frameBindings;
    gbufferPayload.csgResources = csgResources;

    const b8 hasOpaqueDrawItems = !opaqueDrawItems.empty();
    gbufferPayload.materialFrameStatesGraphOwned = hasOpaqueDrawItems;
    OpaqueUploadChainBuilder opaqueUploadChainBuilder(context.graph, context.material, context.csg);
    OpaqueUploadChainInputs uploadInputs(deferredTargets, frameBindings, csgResources, csgFrameData);
    uploadInputs.hasOpaqueDrawItems = !opaqueDrawItems.empty();
    if(s_RuntimeAssertionsEnabled)
        uploadInputs.materialTypedRanges = materialTypedRanges;
    uploadInputs.materialTypedBytes = materialTypedBytes;
    uploadInputs.materialInstances = resources.materialInstances;
    uploadInputs.materialTyped = resources.materialTyped;
    uploadInputs.csgReceiverRanges = resources.csgReceiverRanges;
    uploadInputs.csgCutters = resources.csgCutters;
    uploadInputs.csgClipContextSlots = resources.csgClipContextSlots;
    uploadInputs.csgIntervalSampleState = resources.csgIntervalSampleState;
    uploadInputs.dependencyTask = this.m_graphicsPrefixDeferredClearTask;
    auto opaqueUploadChainResult = opaqueUploadChainBuilder.declare(uploadInputs, instanceData);
    if(!opaqueUploadChainResult.has_value()){
        warning("RendererSystem: could not declare opaque upload chain");
        return MakeUnexpected(Failure());
    }
    const GpuTaskId csgFrameUploadTask = opaqueUploadChainResult.value().csgUploadTask;
    const b8 hasCsgFrameGpuWork = opaqueUploadChainResult.value().hasCsgFrameGpuWork;
    gbufferPayload.materialDrawBuffersUploaded = opaqueUploadChainResult.value().materialDrawBuffersUploaded;
    gbufferPayload.csgFrameBuffersUploaded = opaqueUploadChainResult.value().csgFrameBuffersUploaded;

    gbufferPayload.opaqueDrawSnapshot.capture(opaqueDrawItems, csgFrameData, instanceData.size(), materialTypedBytes.size());
    OpaqueCsgIntervalStage opaqueCsgIntervalStage(
        context.graph,
        context.graphics,
        context.material,
        context.csg,
        deferredTargets,
        timingTickets[cast<usize>(DeferredGraphicsPrefixTimingSlot::CsgReceiverSpanBuild)],
        timingTickets[cast<usize>(DeferredGraphicsPrefixTimingSlot::CsgIntervalCombine)],
        timingTickets[cast<usize>(DeferredGraphicsPrefixTimingSlot::CsgIntervalSample)],
        this.m_graphicsPrefixMeshViewSetupReady,
        this.m_graphicsPrefixSceneShadingSetupReady,
        opaqueCsgIntervalSampleComputeEmulationTiming
    );
    opaqueCsgIntervalStage.capturePayloads(
        frameBindings,
        csgResources,
        opaqueDrawItems,
        csgFrameData,
        instanceData.size(),
        materialTypedBytes.size(),
        gbufferPayload.materialDrawBuffersUploaded,
        gbufferPayload.csgFrameBuffersUploaded,
        hasOpaqueDrawItems,
        hasOpaqueCsgFrameWork
    );

    OpaqueCsgIntervalClearBuilder opaqueCsgIntervalClearBuilder(context.graph);
    OpaqueCsgIntervalClearInputs clearInputs;
    clearInputs.workRegion = csgFrameData.workRegion;
    clearInputs.width = deferredTargets.width;
    clearInputs.height = deferredTargets.height;
    clearInputs.csgIntervalId = resources.csgIntervalId;
    clearInputs.csgReceiverEventCount = resources.csgReceiverEventCount;
    clearInputs.csgPeelSubresources = csgPeelSubresources;
    clearInputs.csgReceiverEventCountSubresources = csgReceiverEventCountSubresources;
    clearInputs.dependencyTask = csgFrameUploadTask;
    clearInputs.hasOpaqueCsgFrameWork = hasOpaqueCsgFrameWork;
    auto opaqueCsgIntervalClearResult = opaqueCsgIntervalClearBuilder.declare(clearInputs, csgIntervalClearTimingState);
    if(!opaqueCsgIntervalClearResult.has_value()){
        warning("RendererSystem: could not declare opaque CSG interval clears");
        return MakeUnexpected(Failure());
    }
    this.m_graphicsPrefixCsgIntervalClearFirstTask = opaqueCsgIntervalClearResult.value().clearFirstTask;
    this.m_graphicsPrefixCsgIntervalClearTask = opaqueCsgIntervalClearResult.value().clearTask;
    GpuTaskId csgIntervalClearTask = csgFrameUploadTask;
    if(hasOpaqueCsgFrameWork)
        csgIntervalClearTask = opaqueCsgIntervalClearResult.value().clearTask;

    const BufferRange materialInstanceRange(0u, ComputeOpaqueBufferByteRangeLength(instanceData.size(), sizeof(InstanceGpuData)));
    const BufferRange materialTypedRange(0u, ComputeOpaqueBufferByteRangeLength(materialTypedBytes.size(), 1u));
    const BufferRange csgReceiverRange(0u, ComputeOpaqueBufferByteRangeLength(csgFrameData.receiverRanges.size(), sizeof(CsgReceiverRangeGpuData)));
    const BufferRange csgCutterRange(0u, ComputeOpaqueBufferByteRangeLength(csgFrameData.cutters.size(), sizeof(CsgCutterGpuData)));

    Vector<GpuTaskResourceUse> gbufferResourceUses;
    const auto gbufferMaterialResources = GatherOpaqueGbufferMaterialResources(opaqueDrawItems, context.material, context.graph);
    if(!gbufferMaterialResources.has_value())
        return MakeUnexpected(Failure());
    gbufferPayload.materialGeometryStatesGraphOwned = gbufferMaterialResources.value().geometryStatesGraphOwned;
    const GpuGraphResourceSetId gbufferMaterialGeometrySet = gbufferMaterialResources.value().geometrySet;
    const GpuGraphResourceSetId gbufferMaterialSampledTextureSet = gbufferMaterialResources.value().sampledTextureSet;
    const b8 gbufferMaterialSampledTexturesCollected = gbufferMaterialResources.value().sampledTexturesCollected;

    OpaqueComputeEmulationPlanner opaqueComputeEmulationPlanner(
        context.material,
        deferredTargets,
        timingTickets[cast<usize>(DeferredGraphicsPrefixTimingSlot::Gbuffer)],
        this.m_graphicsPrefixMeshViewSetupReady,
        this.m_graphicsPrefixSceneShadingSetupReady
    );
    opaqueComputeEmulationPlanner.capture(
        context.graph,
        opaqueDrawItems,
        csgFrameData,
        frameBindings,
        hasOpaqueCsgFrameWork,
        hasCsgFrameGpuWork,
        gbufferMaterialSampledTexturesCollected,
        gbufferPayload,
        opaqueRegularSharedComputeEmulationTiming
    );
    mut OpaqueRegularComputeEmulationGraphTaskPayload opaqueComputeEmulationPayload = opaqueComputeEmulationPlanner.regularPayload();
    mut OpaqueCsgReceiverComputeEmulationGraphTaskPayload opaqueCsgReceiverComputeEmulationPayload = opaqueComputeEmulationPlanner.csgPayload();
    in RegularSharedComputeEmulationGraphPlan opaqueSharedComputeEmulationPlan = opaqueComputeEmulationPlanner.sharedPlan();
    const GpuGraphResourceSetId opaqueComputeEmulationOutputSet = opaqueComputeEmulationPlanner.regularOutputSet();
    const GpuGraphResourceSetId opaqueCsgReceiverComputeEmulationOutputSet = opaqueComputeEmulationPlanner.csgOutputSet();
    const GpuGraphResourceId opaqueSharedComputeEmulationOutput = opaqueComputeEmulationPlanner.sharedOutput();
    const b8 opaqueComputeEmulationOutputStatesGraphOwned = opaqueComputeEmulationPlanner.regularOutputOwned();
    const b8 opaqueSharedComputeEmulationOutputStatesGraphOwned = opaqueComputeEmulationPlanner.sharedOutputOwned();
    const b8 opaqueCsgReceiverComputeEmulationOutputStatesGraphOwned = opaqueComputeEmulationPlanner.csgOutputOwned();

    OpaqueGbufferResourceUseInputs gbufferUses;
    gbufferUses.materialInstanceRange = materialInstanceRange;
    gbufferUses.materialTypedRange = materialTypedRange;
    gbufferUses.csgReceiverRange = csgReceiverRange;
    gbufferUses.csgCutterRange = csgCutterRange;
    gbufferUses.csgPeelSubresources = csgPeelSubresources;
    gbufferUses.csgReceiverEventDataSubresources = csgReceiverEventDataSubresources;
    gbufferUses.csgReceiverEventCountSubresources = csgReceiverEventCountSubresources;
    gbufferUses.hasOpaqueDrawItems = hasOpaqueDrawItems;
    gbufferUses.hasCsgFrameGpuWork = hasCsgFrameGpuWork;
    gbufferUses.hasOpaqueCsgFrameWork = hasOpaqueCsgFrameWork;
    AppendOpaqueGbufferResourceUses(resources, gbufferUses, gbufferResourceUses);
    const GpuTaskResourceSetUse gbufferMaterialGeometrySetUse = MakeResourceSetUse(gbufferMaterialGeometrySet, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read);
    const GpuTaskResourceSetUse gbufferMaterialSampledTextureSetUse = MakeResourceSetUse(gbufferMaterialSampledTextureSet, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read);
    const GpuTaskResourceSetUse opaqueComputeEmulationOutputUavSetUse = MakeResourceSetUse(opaqueComputeEmulationOutputSet, ResourceStates::UnorderedAccess, GpuTaskResourceAccess::Write);
    const GpuTaskResourceSetUse opaqueComputeEmulationOutputVertexBufferSetUse = MakeResourceSetUse(opaqueComputeEmulationOutputSet, s_ObjectGeometryRasterState, GpuTaskResourceAccess::Read);
    const GpuTaskResourceSetUse opaqueCsgReceiverComputeEmulationOutputUavSetUse = MakeResourceSetUse(opaqueCsgReceiverComputeEmulationOutputSet, ResourceStates::UnorderedAccess, GpuTaskResourceAccess::Write);
    const GpuTaskResourceSetUse opaqueCsgReceiverComputeEmulationOutputVertexBufferSetUse = MakeResourceSetUse(opaqueCsgReceiverComputeEmulationOutputSet, s_ObjectGeometryRasterState, GpuTaskResourceAccess::Read);
    FixedVector<GpuTaskResourceSetUse, s_GbufferMaterialResourceSetUseCapacity> gbufferMaterialResourceSetUses;
    if(gbufferPayload.materialGeometryStatesGraphOwned)
        gbufferMaterialResourceSetUses.push_back(gbufferMaterialGeometrySetUse);
    if(gbufferMaterialSampledTextureSet.valid())
        gbufferMaterialResourceSetUses.push_back(gbufferMaterialSampledTextureSetUse);
    if(opaqueComputeEmulationOutputStatesGraphOwned)
        gbufferMaterialResourceSetUses.push_back(opaqueComputeEmulationOutputVertexBufferSetUse);
    if(opaqueCsgReceiverComputeEmulationOutputStatesGraphOwned)
        gbufferMaterialResourceSetUses.push_back(opaqueCsgReceiverComputeEmulationOutputVertexBufferSetUse);

    GpuTaskId gbufferDependency = csgIntervalClearTask;
    Vector<GpuTaskResourceUse> objectGeometryReads;
    if(
        gbufferPayload.materialDrawBuffersUploaded
        && !objectGeometry.prepare(opaqueDrawItems.regular.indexedDrawItems, frameBindings, gbufferDependency, objectGeometryReads, GraphicsPrefixTimingTicket(),
            Optional<in GraphicsPrefixTimingTicket>(timingTickets[cast<usize>(DeferredGraphicsPrefixTimingSlot::Gbuffer)]))
    )
        return MakeUnexpected(Failure());
    if(
        gbufferPayload.materialDrawBuffersUploaded
        && !objectGeometry.prepare(opaqueDrawItems.csgReceiverSurface.indexedDrawItems, frameBindings, gbufferDependency, objectGeometryReads, GraphicsPrefixTimingTicket(),
            Optional<in GraphicsPrefixTimingTicket>(timingTickets[cast<usize>(DeferredGraphicsPrefixTimingSlot::Gbuffer)]))
    )
        return MakeUnexpected(Failure());
    for(in GpuTaskResourceUse use : objectGeometryReads)
        gbufferResourceUses.push_back(use);

    OpaqueComputeEmulationProducerInputs computeEmulationProducerInputs(resources);
    computeEmulationProducerInputs.materialGeometrySetUse = gbufferMaterialGeometrySetUse;
    computeEmulationProducerInputs.materialSampledTextureSetUse = gbufferMaterialSampledTextureSetUse;
    computeEmulationProducerInputs.materialInstanceRange = materialInstanceRange;
    computeEmulationProducerInputs.materialTypedRange = materialTypedRange;
    computeEmulationProducerInputs.csgReceiverRange = csgReceiverRange;
    computeEmulationProducerInputs.csgCutterRange = csgCutterRange;
    computeEmulationProducerInputs.instanceCount = instanceData.size();
    computeEmulationProducerInputs.materialTypedByteCount = materialTypedBytes.size();
    computeEmulationProducerInputs.materialDrawBuffersUploaded = gbufferPayload.materialDrawBuffersUploaded;
    computeEmulationProducerInputs.csgFrameBuffersUploaded = gbufferPayload.csgFrameBuffersUploaded;
    computeEmulationProducerInputs.materialFrameStatesGraphOwned = gbufferPayload.materialFrameStatesGraphOwned;
    computeEmulationProducerInputs.materialGeometryStatesGraphOwned = gbufferPayload.materialGeometryStatesGraphOwned;
    OpaqueComputeEmulationProducerBuilder computeEmulationProducerBuilder(context.graph);
    if(opaqueComputeEmulationOutputStatesGraphOwned){
        const auto producerTask = computeEmulationProducerBuilder.declareRegular(computeEmulationProducerInputs, opaqueComputeEmulationOutputUavSetUse, gbufferDependency, opaqueComputeEmulationPayload);
        if(!producerTask.has_value())
            return MakeUnexpected(Failure());
        this.m_graphicsPrefixOpaqueComputeEmulationTask = producerTask.value();
        gbufferDependency = this.m_graphicsPrefixOpaqueComputeEmulationTask;
    }
    if(opaqueCsgReceiverComputeEmulationOutputStatesGraphOwned){
        const auto producerTask = computeEmulationProducerBuilder.declareCsgReceiver(computeEmulationProducerInputs, csgResources, opaqueCsgReceiverComputeEmulationOutputUavSetUse, gbufferDependency, opaqueCsgReceiverComputeEmulationPayload);
        if(!producerTask.has_value())
            return MakeUnexpected(Failure());
        this.m_graphicsPrefixOpaqueCsgReceiverComputeEmulationTask = producerTask.value();
        gbufferDependency = this.m_graphicsPrefixOpaqueCsgReceiverComputeEmulationTask;
    }
    GpuTaskSchedulingHint gbufferScheduling;
    gbufferScheduling.cost = GpuTaskCostHint::Medium;
    gbufferScheduling.forceSubmissionBoundary = false;
    gbufferScheduling.allowPacketMerge = true;
    gbufferScheduling.mergeWithPrevious = true;

    gbufferScheduling.allowMergeAcrossConsumerFrontier = ShouldMergeOpaqueGbufferAcrossConsumerFrontier(opaqueComputeEmulationOutputStatesGraphOwned, opaqueSharedComputeEmulationOutputStatesGraphOwned, opaqueCsgReceiverComputeEmulationOutputStatesGraphOwned);
    GpuTaskDesc gbufferDesc;
    gbufferDesc
        .setIdentity(Name(s_FrameGraphNameRenderGraphicsPrefixGbuffer))
        .setMarkerLabel("Opaque G-Buffer")
        .setScheduling(gbufferScheduling)
        .setDependency(gbufferDependency)
        .setResourceUses(gbufferResourceUses)
        .setResourceSetUses(gbufferMaterialResourceSetUses)
    ;
    const b8 opaqueSharedMaterialDrawBuffersUploaded = gbufferPayload.materialDrawBuffersUploaded;
    const b8 opaqueSharedMaterialFrameStatesGraphOwned = gbufferPayload.materialFrameStatesGraphOwned;
    const b8 opaqueSharedMaterialGeometryStatesGraphOwned = gbufferPayload.materialGeometryStatesGraphOwned;
    const auto graphicsPrefixGbufferTaskResult = context.graph.addPreparedPayloadTask(gbufferDesc, gbufferPayload);
    if(!graphicsPrefixGbufferTaskResult.has_value()){
        this.m_graphicsPrefixGbufferTask = GpuTaskId();
        warning("RendererSystem: could not declare opaque G-buffer task");
        return MakeUnexpected(Failure());
    }
    this.m_graphicsPrefixGbufferTask = graphicsPrefixGbufferTaskResult.value();

    GpuTaskId gbufferCompletionTask = this.m_graphicsPrefixGbufferTask;
    if(opaqueSharedComputeEmulationOutputStatesGraphOwned){
        OpaqueSharedComputeEmulationChainBuilder sharedComputeEmulationChainBuilder(context.graph, context.material);
        OpaqueSharedComputeEmulationChainInputs sharedInputs(deferredTargets, resources, frameBindings, opaqueSharedComputeEmulationPlan,
            timingTickets[cast<usize>(DeferredGraphicsPrefixTimingSlot::Gbuffer)], this.m_graphicsPrefixMeshViewSetupReady, this.m_graphicsPrefixSceneShadingSetupReady, opaqueRegularSharedComputeEmulationTiming);
        sharedInputs.objectGeometryReads = objectGeometryReads;
        sharedInputs.materialGeometrySetUse = gbufferMaterialGeometrySetUse;
        sharedInputs.materialSampledTextureSetUse = gbufferMaterialSampledTextureSetUse;
        sharedInputs.materialInstanceRange = materialInstanceRange;
        sharedInputs.materialTypedRange = materialTypedRange;
        sharedInputs.sharedOutput = opaqueSharedComputeEmulationOutput;
        sharedInputs.gbufferTask = this.m_graphicsPrefixGbufferTask;
        sharedInputs.instanceCount = instanceData.size();
        sharedInputs.materialTypedByteCount = materialTypedBytes.size();
        sharedInputs.materialDrawBuffersUploaded = opaqueSharedMaterialDrawBuffersUploaded;
        sharedInputs.materialFrameStatesGraphOwned = opaqueSharedMaterialFrameStatesGraphOwned;
        sharedInputs.materialGeometryStatesGraphOwned = opaqueSharedMaterialGeometryStatesGraphOwned;
        const auto sharedComputeEmulationChain = sharedComputeEmulationChainBuilder.declare(sharedInputs, this.m_graphicsPrefixOpaqueSharedComputeEmulationTasks);
        if(!sharedComputeEmulationChain.has_value())
            return MakeUnexpected(Failure());
        this.m_graphicsPrefixOpaqueSharedComputeEmulationTaskCount = sharedComputeEmulationChain.value().taskCount;
        gbufferCompletionTask = sharedComputeEmulationChain.value().completionTask;
    }
    if(hasOpaqueCsgFrameWork){
        OpaqueCsgIntervalStageInputs intervalInputs(resources, frameBindings, csgResources, opaqueDrawItems, csgFrameData);
        intervalInputs.intervalSampleTimingTicket = Optional<in GraphicsPrefixTimingTicket>(timingTickets[cast<usize>(DeferredGraphicsPrefixTimingSlot::CsgIntervalSample)]);
        intervalInputs.materialInstanceRange = materialInstanceRange;
        intervalInputs.materialTypedRange = materialTypedRange;
        intervalInputs.csgReceiverRange = csgReceiverRange;
        intervalInputs.csgCutterRange = csgCutterRange;
        intervalInputs.dependencyTask = gbufferCompletionTask;
        intervalInputs.instanceCount = instanceData.size();
        intervalInputs.materialTypedByteCount = materialTypedBytes.size();
        intervalInputs.hasOpaqueDrawItems = hasOpaqueDrawItems;
        intervalInputs.hasCsgFrameGpuWork = hasCsgFrameGpuWork;
        const auto opaqueCsgTasks = opaqueCsgIntervalStage.declare(intervalInputs, objectGeometry);
        if(!opaqueCsgTasks.has_value())
            return MakeUnexpected(Failure());
        this.m_graphicsPrefixCsgReceiverSpanTask = opaqueCsgTasks.value().receiverSpanTask;
        this.m_graphicsPrefixCsgIntervalCombineTask = opaqueCsgTasks.value().intervalCombineTask;
        this.m_graphicsPrefixOpaqueCsgIntervalSampleComputeEmulationTask = opaqueCsgTasks.value().intervalSampleComputeEmulationTask;
        this.m_graphicsPrefixCsgIntervalSampleTask = opaqueCsgTasks.value().intervalSampleTask;
        gbufferCompletionTask = this.m_graphicsPrefixCsgIntervalSampleTask;
    }

    PostGbufferNormalizeBuilder normalizeBuilder(context.graph, context.rayTracing);
    PostGbufferNormalizeInputs normalizeInputs(resources, context.shadowVisibilityTask, asyncPrefixTiming, timingTickets[cast<usize>(DeferredGraphicsPrefixTimingSlot::Normalize)]);
    normalizeInputs.shadowTraceGeometryResources = shadowTraceGeometryResources;
    normalizeInputs.shadowTraceGeometrySet = shadowTraceGeometrySet;
    normalizeInputs.gbufferCompletionTask = gbufferCompletionTask;
    const auto graphicsPrefixTaskResult = normalizeBuilder.declare(normalizeInputs);
    if(!graphicsPrefixTaskResult.has_value()){
        this.m_graphicsPrefixTask = GpuTaskId();
        return MakeUnexpected(Failure());
    }
    this.m_graphicsPrefixTask = graphicsPrefixTaskResult.value();
    context.rayTracing.publishPreparedLightingClassification(rayTracingLightingClassification, Span<SceneLightGpuData>(prefixSceneUploadResult.value().lightData).first(sceneLightCount));
    return prefixSceneUploadResult.value().sceneLightingContentHash;
}

void GraphicsPrefixGraphCoordinator::resetGraphicsPrefixTaskState(){
    this.m_graphicsPrefixOpaqueComputeEmulationTask = GpuTaskId();
    for(usize i = 0u; i < s_SharedComputeEmulationMaximumPhaseCount; ++i)
        this.m_graphicsPrefixOpaqueSharedComputeEmulationTasks[i] = GpuTaskId();
    this.m_graphicsPrefixOpaqueSharedComputeEmulationTaskCount = 0u;
    this.m_graphicsPrefixOpaqueCsgReceiverComputeEmulationTask = GpuTaskId();
    this.m_graphicsPrefixOpaqueCsgIntervalSampleComputeEmulationTask = GpuTaskId();
    this.m_graphicsPrefixGbufferTask = GpuTaskId();
    this.m_graphicsPrefixCsgReceiverSpanTask = GpuTaskId();
    this.m_graphicsPrefixCsgIntervalCombineTask = GpuTaskId();
    this.m_graphicsPrefixCsgIntervalSampleTask = GpuTaskId();
    this.m_graphicsPrefixTask = GpuTaskId();
}


