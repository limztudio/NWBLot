const StringView s_CharacterControllerComponentDiagnosticPrefix = "CharacterController component meta";
const StringView s_VehicleComponentDiagnosticPrefix = "Vehicle component meta";
const StringView s_RagdollComponentDiagnosticPrefix = "Ragdoll component meta";
const StringView s_FluidVolumeComponentDiagnosticPrefix = "FluidVolume component meta";
const StringView s_ForceFieldComponentDiagnosticPrefix = "ForceField component meta";
const StringView s_ArticulationComponentDiagnosticPrefix = "Articulation component meta";
const StringView s_SoftBodyComponentDiagnosticPrefix = "SoftBody component meta";
const StringView s_GpuRenderTransformExportComponentDiagnosticPrefix = "GpuRenderTransformExport component meta";

type CharacterControllerComponentCookEntry = TypedComponentCookEntry<CharacterControllerComponent>;
type VehicleComponentCookEntry = TypedComponentCookEntry<VehicleComponent>;
type RagdollComponentCookEntry = TypedComponentCookEntry<RagdollComponent>;
type FluidVolumeComponentCookEntry = TypedComponentCookEntry<FluidVolumeComponent>;
type ForceFieldComponentCookEntry = TypedComponentCookEntry<ForceFieldComponent>;
type ArticulationComponentCookEntry = TypedComponentCookEntry<ArticulationComponent>;
type SoftBodyComponentCookEntry = TypedComponentCookEntry<SoftBodyComponent>;
type GpuRenderTransformExportComponentCookEntry = TypedComponentCookEntry<GpuRenderTransformExportComponent>;

type CharacterControllerComponentCodec = TypedComponentAssetCodec<CharacterControllerComponentAsset>;
type VehicleComponentCodec = TypedComponentAssetCodec<VehicleComponentAsset>;
type RagdollComponentCodec = TypedComponentAssetCodec<RagdollComponentAsset>;
type FluidVolumeComponentCodec = TypedComponentAssetCodec<FluidVolumeComponentAsset>;
type ForceFieldComponentCodec = TypedComponentAssetCodec<ForceFieldComponentAsset>;
type ArticulationComponentCodec = TypedComponentAssetCodec<ArticulationComponentAsset>;
type SoftBodyComponentCodec = TypedComponentAssetCodec<SoftBodyComponentAsset>;
type GpuRenderTransformExportComponentCodec = TypedComponentAssetCodec<GpuRenderTransformExportComponentAsset>;


