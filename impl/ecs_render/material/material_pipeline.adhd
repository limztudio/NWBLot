#include <impl/assets_graphics/mesh_subsystem.adhd>
#include <impl/assets_graphics/csg_subsystem.adhd>
#include <impl/ecs_render/material/material_internal.adhd>
#include <impl/ecs_render/material/renderer_render_state_private.adhd>
#include <impl/ecs_render/kernel/compute_pipeline_utils.adhd>
#include <impl/ecs_render/avboit/avboit_raster_configuration.adhd>
#include <impl/ecs_render/material/csg_shader_variant_builder.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


StringView SelectMaterialPassPixelShaderVariant(
    in b8 csgClipPipeline,
    in b8 avboitCsgClipPipeline,
    in StringView csgShaderVariant,
    in StringView materialShaderVariant
){
    if(csgClipPipeline && !avboitCsgClipPipeline)
        return csgShaderVariant;
    return materialShaderVariant;
}

StringView SelectMaterialPassMeshShaderVariant(
    in b8 csgClipPipeline,
    in StringView csgShaderVariant,
    in StringView materialShaderVariant
){
    if(csgClipPipeline)
        return csgShaderVariant;
    return materialShaderVariant;
}

b8 IsSharedComputeEmulationProgram(
    in MaterialPipelineCsgMode csgMode,
    in Name sharedMeshShaderAssetName,
    in AssetRef<MeshShader> materialMeshShader,
    in StringView meshShaderVariant,
    in StringView defaultVariant
){
    return csgMode == MaterialPipelineCsgMode::None && UsesSharedMaterialMeshShader(sharedMeshShaderAssetName, materialMeshShader, meshShaderVariant, defaultVariant);
}

b8 CanBuildIndexedObjectGeometryPipeline(
    in b8 sharedObjectGeometry,
    in Name objectVertexShaderAssetName,
    in b8 hasVertexArchiveStage
){
    return sharedObjectGeometry && objectVertexShaderAssetName != s_NameNone && hasVertexArchiveStage;
}

b8 ValidateMaterialEvaluatorModuleMatch(in StringView existingAssignment, in StringView expectedAssignment, in Name materialKey){
    if(existingAssignment == expectedAssignment)
        return true;

    error(
        "RendererSystem: material '{}' uses a different CSG evaluator module than its active cutters"
        , materialKey.resolvedText()
    );
    return false;
}

void LogCsgEvaluatorModuleResolveFailed(in Name materialKey){
    error("RendererSystem: failed to resolve CSG evaluator module for material '{}'", materialKey.resolvedText());
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<String> ResolveCsgProjectEvaluatorModuleInclude(in CsgShapeRegistry registry, in Name variant){
    if(variant == s_NameNone)
        return String();
    auto module = registry.findShaderModuleInclude(variant);
    if(!module.has_value() || module.value().empty())
        return MakeUnexpected(Failure());
    return module;
}

Expected<mut MaterialPipelineResources> RendererMaterialSystem::createRendererPipeline(in MaterialSurfaceInfo materialInfo, in MaterialPipelineKey pipelineKey, mut Framebuffer framebuffer){
    const Name materialKey = materialInfo.materialName;
    const MaterialPipelinePass pass = pipelineKey.pass;
    assert(materialKey != s_NameNone);

    const auto entry = this.m_materialState.m_pipelines.try_emplace(pipelineKey);
    mut MaterialPipelineResources resources = this.m_materialState.m_pipelines.at(pipelineKey);
    if(resources.ready())
        return Expected<mut MaterialPipelineResources>(resources);
    const b8 inserted = entry.second;
    in MaterialPipelineKey pipelineKeyRef = pipelineKey;
    auto failMaterialPipeline = lambda[mut this, in inserted, in pipelineKeyRef]() -> Expected<mut MaterialPipelineResources>{
        if(inserted)
            this.m_materialState.m_pipelines.erase(pipelineKeyRef);
        return MakeUnexpected(Failure());
    };

    assert(!materialInfo.shaderVariant.empty());
    const StringView shaderVariant(materialInfo.shaderVariant);
    String csgShaderVariant;
    String avboitCsgShaderVariant;
    const MaterialPipelineCsgBindingUse csgBindingUse = MaterialPipelineResolveCsgBindingUse(pipelineKey.csgMode, pass);
    const b8 csgClipPipeline = csgBindingUse.clip;
    const b8 avboitCsgClipPipeline = csgBindingUse.avboitClip;
    String csgProjectEvaluatorModuleAssignment;
    StringView materialProjectEvaluatorModuleAssignmentToAdd = "";
    StringView avboitProjectEvaluatorModuleAssignmentToAdd = "";
    if(csgClipPipeline){
        const auto csgProjectEvaluatorModuleInclude = ResolveCsgProjectEvaluatorModuleInclude(this.m_csgShapeRegistry, pipelineKey.csgEvaluatorVariant);
        if(!csgProjectEvaluatorModuleInclude.has_value()){
            LogCsgEvaluatorModuleResolveFailed(materialKey);
            return failMaterialPipeline();
        }
        csgProjectEvaluatorModuleAssignment.assign(StringView(CsgShaderVariantBuilder().buildEvaluatorAssignment(StringView(csgProjectEvaluatorModuleInclude.value()))));
        if(!csgProjectEvaluatorModuleAssignment.empty()){
            const Expected<StringView> existingEvaluatorModuleAssignment = CsgShaderVariantBuilder().findDefineAssignment(shaderVariant, s_CsgProjectEvaluatorModuleDefineName, s_ShaderArchiveDefaultVariant);
            if(existingEvaluatorModuleAssignment.has_value() && !ValidateMaterialEvaluatorModuleMatch(existingEvaluatorModuleAssignment.value(), StringView(csgProjectEvaluatorModuleAssignment), materialKey))
                return failMaterialPipeline();
            if(!existingEvaluatorModuleAssignment.has_value())
                materialProjectEvaluatorModuleAssignmentToAdd = StringView(csgProjectEvaluatorModuleAssignment);
            avboitProjectEvaluatorModuleAssignmentToAdd = StringView(csgProjectEvaluatorModuleAssignment);
        }
    }
    if(csgClipPipeline && !avboitCsgClipPipeline){
        auto variant = CsgShaderVariantBuilder().buildVariant(shaderVariant, s_ShaderArchiveDefaultVariant, materialProjectEvaluatorModuleAssignmentToAdd);
        if(!variant.has_value()){
            error("RendererSystem: failed to build CSG shader variant for material '{}'", materialKey.resolvedText());
            return failMaterialPipeline();
        }
        csgShaderVariant.assign(StringView(variant.value()));
    }

    if(avboitCsgClipPipeline){
        auto variant = CsgShaderVariantBuilder().buildVariant(shaderVariant, s_ShaderArchiveDefaultVariant, materialProjectEvaluatorModuleAssignmentToAdd);
        if(!variant.has_value()){
            error("RendererSystem: failed to build AVBOIT CSG mesh shader variant for material '{}'", materialKey.resolvedText());
            return failMaterialPipeline();
        }
        csgShaderVariant.assign(StringView(variant.value()));
    }

    if(avboitCsgClipPipeline){
        auto variant = CsgShaderVariantBuilder().buildVariant(s_ShaderArchiveDefaultVariant, s_ShaderArchiveDefaultVariant, avboitProjectEvaluatorModuleAssignmentToAdd);
        if(!variant.has_value()){
            error("RendererSystem: failed to build AVBOIT CSG pixel shader variant for material '{}'", materialKey.resolvedText());
            return failMaterialPipeline();
        }
        avboitCsgShaderVariant.assign(StringView(variant.value()));
    }
    const StringView pixelShaderVariant = SelectMaterialPassPixelShaderVariant(csgClipPipeline, avboitCsgClipPipeline, StringView(csgShaderVariant), shaderVariant);
    const StringView meshShaderVariant = SelectMaterialPassMeshShaderVariant(csgClipPipeline, StringView(csgShaderVariant), shaderVariant);

    const Name sharedMeshShaderAssetName = this.m_shaderSystem.resolveSubsystemAsset<MeshSubsystem, MeshShader>(lambda[](in MeshSubsystem s) -> AssetRef<MeshShader>{ return s.sharedMs; });
    const Name objectVertexShaderAssetName = this.m_shaderSystem.resolveSubsystemAsset<MeshSubsystem, VertexShader>(lambda[](in MeshSubsystem s) -> AssetRef<VertexShader>{ return s.objectVs; });
    const b8 sharedObjectGeometry = UsesSharedMaterialMeshShader(sharedMeshShaderAssetName, materialInfo.meshShader, shaderVariant, s_ShaderArchiveDefaultVariant);

    Name passPixelShaderName = s_NameNone;
    Name passPixelShaderDebugName = s_InvalidPassPixelShaderDebugName;
    MaterialPipelineAvboitPixelShaderSelection avboitPixelShaderSelection;
    if(MaterialPipelinePassUsesRendererAvboit(pass)){
        avboitPixelShaderSelection = SelectAvboitPixelShader(
            pass,
            materialInfo.avboitOccupancyPixelShader,
            materialInfo.avboitExtinctionPixelShader,
            materialInfo.avboitAccumulatePixelShader
        );
        assert(!materialInfo.transparent || avboitPixelShaderSelection.materialDriven());
    }
    switch(pass){
    case MaterialPipelinePass::Opaque:
    case MaterialPipelinePass::CsgReceiverSurface:
        break;
    case MaterialPipelinePass::AvboitOccupancy:
    case MaterialPipelinePass::AvboitExtinction:
    case MaterialPipelinePass::AvboitAccumulate:
    case MaterialPipelinePass::AvboitRefractionCapture:
        passPixelShaderName = avboitPixelShaderSelection.shaderName();
        passPixelShaderDebugName = avboitPixelShaderSelection.debugName;
        break;
    default:
        break;
    }

    mut Device device = this.m_graphics.getDevice();
    const RenderState renderState = BuildRenderStateForPass(pass, pipelineKey.twoSided);
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized()){
        error("RendererSystem: material geometry pipeline requires the global descriptor heap");
        return failMaterialPipeline();
    }
    const auto materialPassBindingLayout = this.prepareMaterialPassBindingLayout();
    if(!materialPassBindingLayout.has_value())
        return failMaterialPipeline();

    const MaterialPipelineBuildInputs buildInputs(
        this,
        this.m_shaderSystem,
        this.m_materialState,
        resources,
        materialInfo,
        pipelineKey,
        framebuffer,
        device,
        heap,
        renderState,
        materialPassBindingLayout.value(),
        materialKey,
        sharedMeshShaderAssetName,
        passPixelShaderName,
        passPixelShaderDebugName,
        pixelShaderVariant,
        meshShaderVariant,
        StringView(avboitCsgShaderVariant),
        pass,
        avboitCsgClipPipeline
    );
    MaterialPipelineBuilder pipelineBuilder(buildInputs);

    const b8 meshSupported = this.m_graphics.queryFeatureSupport(Feature::Meshlets);
    assert(pass != MaterialPipelinePass::Opaque || materialInfo.pixelShader.valid());
    assert(materialInfo.meshShader.valid());

    if(meshSupported){
        if(!pipelineBuilder.buildMesh()){
            error("RendererSystem: failed to create the required mesh rendering path for material '{}' on a mesh-capable device", materialKey.resolvedText());
            return failMaterialPipeline();
        }

        this.logMaterialRenderPathDecision(materialKey, resources.renderPath, meshSupported);
        return Expected<mut MaterialPipelineResources>(resources);
    }

    const b8 hasVertexArchiveStage = objectVertexShaderAssetName != s_NameNone
        && this.m_shaderSystem.hasShaderArchiveStage(objectVertexShaderAssetName, s_ShaderArchiveDefaultVariant, ArchiveStageNameFromShaderType(ShaderType::VertexStage))
    ;
    if(CanBuildIndexedObjectGeometryPipeline(sharedObjectGeometry, objectVertexShaderAssetName, hasVertexArchiveStage)){
        if(!pipelineBuilder.buildIndexed())
            return failMaterialPipeline();
    }
    else if(!pipelineBuilder.buildCompute()){
        error("RendererSystem: failed to create compute-emulation rendering path for material '{}' from its mesh shader", materialKey.resolvedText());
        return failMaterialPipeline();
    }

    this.logMaterialRenderPathDecision(materialKey, resources.renderPath, meshSupported);
    return Expected<mut MaterialPipelineResources>(resources);
}

Expected<mut MaterialPipelineResources> RendererMaterialSystem::findRendererPipeline(in MaterialPipelineKey pipelineKey){
    const auto foundPipeline = this.m_materialState.m_pipelines.find(pipelineKey);
    if(foundPipeline == this.m_materialState.m_pipelines.end())
        return MakeUnexpected(Failure());

    mut MaterialPipelineResources resources = this.m_materialState.m_pipelines.at(pipelineKey);
    if(!resources.ready())
        return MakeUnexpected(Failure());

    return Expected<mut MaterialPipelineResources>(resources);
}

void RendererMaterialSystem::invalidateRendererPipelines(){
    this.m_materialState.clearPreparedFrameCache();
    this.m_materialState.m_pipelines.clear();
    this.m_materialState.m_objectGeometryDecodeShader.reset();
    this.m_materialState.m_objectGeometryDecodePipeline.reset();
    this.m_materialState.m_objectGeometryInputLayout.reset();
}

void RendererMaterialSystem::logMaterialRenderPathDecision(in Name materialKey, in RenderPath renderPath, in b8 meshSupported){
    const auto entry = this.m_materialState.m_loggedMaterialPaths.try_emplace(materialKey, renderPath);
    if(!entry.second){
        if(entry.first.value() == renderPath)
            return;
        entry.first.value() = renderPath;
    }

    LogMaterialRenderPathDecision(materialKey, renderPath, meshSupported);
}


b8 MaterialPipelineBuilder::loadPassPixelShader(){
    in MaterialPipelineBuildInputs inputs = this.m_inputs;
    if(inputs.pass == MaterialPipelinePass::Opaque)
        return inputs.shaderSystem.loadShader<PixelShader>(inputs.materialInfo.pixelShader.name(), inputs.pixelShaderVariant, s_RendererPsDebugName, inputs.resources.pixelShader);
    if(inputs.pass == MaterialPipelinePass::CsgReceiverSurface)
        return inputs.shaderSystem.loadShader<PixelShader, CsgSubsystem>(lambda[](in CsgSubsystem s) -> AssetRef<PixelShader>{ return s.receiverSurfacePs; }, s_ShaderArchiveDefaultVariant, s_CsgReceiverSurfacePsDebugName, inputs.resources.pixelShader);
    if(inputs.avboitCsgClipPipeline)
        return inputs.shaderSystem.loadShader<PixelShader>(inputs.passPixelShaderName, StringView(inputs.avboitCsgShaderVariant), inputs.passPixelShaderDebugName, inputs.resources.pixelShader);
    return inputs.shaderSystem.loadShader<PixelShader>(inputs.passPixelShaderName, s_ShaderArchiveDefaultVariant, inputs.passPixelShaderDebugName, inputs.resources.pixelShader);
}

b8 MaterialPipelineBuilder::buildMesh(){
    in MaterialPipelineBuildInputs inputs = this.m_inputs;
    if(!inputs.shaderSystem.loadShader<MeshShader>(inputs.materialInfo.meshShader.name(), inputs.meshShaderVariant, s_RendererMeshDebugName, inputs.resources.meshShader))
        return false;
    if(!this.loadPassPixelShader())
        return false;

    MeshletPipelineDesc pipelineDesc;
    pipelineDesc.setMeshShader(inputs.resources.meshShader);
    pipelineDesc.setPixelShader(inputs.resources.pixelShader);
    pipelineDesc.setRenderState(inputs.renderState);
    pipelineDesc.addBindingLayout(inputs.materialPassBindingLayout);
    pipelineDesc.addBindingLayout(inputs.heap.getResourceLayout()).addBindingLayout(inputs.heap.getSamplerLayout());

    auto meshletPipelineResult = inputs.device.createMeshletPipeline(pipelineDesc, inputs.framebuffer.getFramebufferInfo());
    if(meshletPipelineResult.has_value())
        inputs.resources.meshletPipeline = meshletPipelineResult.value();
    else
        inputs.resources.meshletPipeline.reset();
    if(!meshletPipelineResult.has_value()){
        error("RendererSystem: failed to create meshlet pipeline for material '{}'", inputs.materialKey.resolvedText());
        return false;
    }

    inputs.resources.renderPath = RenderPath::MeshShader;
    return true;
}

b8 MaterialPipelineBuilder::buildIndexed(){
    in MaterialPipelineBuildInputs inputs = this.m_inputs;
    if(!inputs.system.createObjectGeometryPipelineResources(inputs.resources))
        return false;
    if(!this.loadPassPixelShader())
        return false;
    GraphicsPipelineDesc desc;
    desc
        .setInputLayout(inputs.materialState.m_objectGeometryInputLayout)
        .setVertexShader(inputs.resources.objectGeometryVertexShader)
        .setPixelShader(inputs.resources.pixelShader)
        .setRenderState(inputs.renderState)
        .addBindingLayout(inputs.materialPassBindingLayout)
        .addBindingLayout(inputs.heap.getResourceLayout())
        .addBindingLayout(inputs.heap.getSamplerLayout())
    ;
    auto indexedPipelineResult = inputs.device.createGraphicsPipeline(desc, inputs.framebuffer.getFramebufferInfo());
    if(indexedPipelineResult.has_value())
        inputs.resources.indexedPipeline = indexedPipelineResult.value();
    else
        inputs.resources.indexedPipeline.reset();
    if(!indexedPipelineResult.has_value()){
        error("RendererSystem: failed to create indexed object geometry pipeline for material '{}'", inputs.materialKey.resolvedText());
        return false;
    }
    inputs.resources.renderPath = RenderPath::VertexIndexed;
    return true;
}

b8 MaterialPipelineBuilder::buildCompute(){
    in MaterialPipelineBuildInputs inputs = this.m_inputs;
    if(!inputs.system.createComputeEmulationResources())
        return false;
    assert(inputs.materialState.m_computeBindingLayout.valid());
    assert(inputs.materialState.m_emulationVertexShader.valid());
    assert(inputs.materialState.m_emulationInputLayout.valid());
    const Name meshComputeArchiveStageName = s_MeshComputeArchiveStageName;
    if(!inputs.shaderSystem.loadShader<ComputeShader>(inputs.materialInfo.meshShader.name(), inputs.meshShaderVariant, s_RendererCsDebugName, meshComputeArchiveStageName, inputs.resources.computeShader))
        return false;
    if(!this.loadPassPixelShader())
        return false;
    const Expected<ComputePipelineHandle> computePipeline = CreateHeapComputePipeline(inputs.device, inputs.resources.computeShader, inputs.materialState.m_computeBindingLayout, false);
    if(!computePipeline.has_value()){
        inputs.resources.computePipeline.reset();
        error("RendererSystem: failed to create compute pipeline for material '{}'", inputs.materialKey.resolvedText());
        return false;
    }
    inputs.resources.computePipeline = computePipeline.value();

    GraphicsPipelineDesc emulationDesc;
    emulationDesc.setInputLayout(inputs.materialState.m_emulationInputLayout);
    emulationDesc.setVertexShader(inputs.materialState.m_emulationVertexShader);
    emulationDesc.setPixelShader(inputs.resources.pixelShader);
    emulationDesc.setRenderState(inputs.renderState);
    emulationDesc.addBindingLayout(inputs.materialPassBindingLayout);
    emulationDesc.addBindingLayout(inputs.heap.getResourceLayout()).addBindingLayout(inputs.heap.getSamplerLayout());
    auto emulationPipelineResult = inputs.device.createGraphicsPipeline(emulationDesc, inputs.framebuffer.getFramebufferInfo());
    if(emulationPipelineResult.has_value())
        inputs.resources.emulationPipeline = emulationPipelineResult.value();
    else
        inputs.resources.emulationPipeline.reset();
    if(!emulationPipelineResult.has_value()){
        error("RendererSystem: failed to create emulation graphics pipeline for material '{}'", inputs.materialKey.resolvedText());
        inputs.resources.computePipeline.reset();
        return false;
    }

    inputs.resources.renderPath = RenderPath::ComputeEmulation;
    inputs.resources.sharedGeometryComputeProgram = IsSharedComputeEmulationProgram(
        inputs.pipelineKey.csgMode,
        inputs.sharedMeshShaderAssetName,
        inputs.materialInfo.meshShader,
        inputs.meshShaderVariant,
        s_ShaderArchiveDefaultVariant
    );
    inputs.resources.indexedGeometryOutput = inputs.resources.sharedGeometryComputeProgram;
    return true;
}


