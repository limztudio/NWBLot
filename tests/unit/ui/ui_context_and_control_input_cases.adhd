void VerifyUiContextMenuInputTests_NativeFocusTerminationCancelsPendingMenuAndPointerReleases(mut UiContextMenuInputTests self){
    const HitTarget target = MakeUiContextMenuTarget(1u);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiContextSingleTarget(target), 1u));
    self.focus();
    EXPECT_TRUE(self.send(MakeUiContextMenuKey(CoreKey::Menu)).commandConsumed);
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryDown)).pointerConsumed);
    EXPECT_TRUE(self.send(MakeUiContextMenuPointer(InputEventType::FocusLost)).pointerConsumed);
    EXPECT_FALSE(self.m_router.windowFocused());
    EXPECT_TRUE(self.m_router.secondaryDown());
    EXPECT_FALSE(self.m_router.pointerKnown());
    EXPECT_TRUE(self.m_router.ownsKey(CoreKey::Menu));
    self.m_router.cancelDeviceInput(0u);
    EXPECT_FALSE(self.m_router.secondaryDown());
    EXPECT_FALSE(self.m_router.ownsKey(CoreKey::Menu));
    EXPECT_FALSE(self.take().has_value());
    EXPECT_FALSE(self.release(CoreKey::Menu).commandConsumed);
    EXPECT_FALSE(self.send(MakeUiContextMenuPointer(InputEventType::SecondaryUp, MakeUiContextPoint(180.0f, 180.0f))).pointerConsumed);
    EXPECT_FALSE(self.send(MakeUiContextMenuPointer(InputEventType::FocusGained)).pointerConsumed);
    EXPECT_TRUE(self.m_router.windowFocused());
    self.focus();
    EXPECT_FALSE(self.take().has_value());
    EXPECT_TRUE(self.send(MakeUiContextMenuKey(CoreKey::Menu)).commandConsumed);
    EXPECT_TRUE(self.release(CoreKey::Menu).commandConsumed);
    ASSERT_TRUE(self.take().has_value());
}

