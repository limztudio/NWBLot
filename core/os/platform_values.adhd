class WaylandTextInputSerialRecord{
    public u64 revision;
    public u32 serial;

    public WaylandTextInputSerialRecord(){
        this.revision = 0u;
        this.serial = 0u;
    }

    public WaylandTextInputSerialRecord(in u32 serial, in u64 revision){
        this.serial = serial;
        this.revision = revision;
    }
}


class X11PropertyFailure{
    public i32 nativeStatus = 0;
    public u8 errorCode = 0u;
}


