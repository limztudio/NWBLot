const StringView s_SurfelIrradianceHalfGraphLabel = "Surfel Irradiance Half";
const StringView s_SurfelPoolGraphLabel = "Surfel Pool";
const StringView s_SurfelGuidePoolGraphLabel = "Surfel Guide Pool";
const StringView s_SurfelCellHeadsGraphLabel = "Surfel Cell Heads";
const StringView s_SurfelFreeListGraphLabel = "Surfel Free List";
const StringView s_SurfelPoolSnapshotGraphLabel = "Surfel Pool Snapshot";
const StringView s_SurfelCellHeadSnapshotGraphLabel = "Surfel Cell Head Snapshot";
const StringView s_SurfelTraceArgsGraphLabel = "Surfel Trace Arguments";
const Name s_SurfelIrradianceTargetName = "engine/gi/surfel_irradiance";
const Name s_SurfelIrradianceHalfTargetName = "engine/gi/surfel_irradiance_half";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


usize ComputeSurfelResourceUseReserve(in b8 hasCsgTraceContext, in b8 traceGeometryStatesGraphOwned, in usize traceGeometryResourceCount){
    usize capacity = s_SurfelResourceUseCapacity;
    if(hasCsgTraceContext)
        capacity += 1u;
    if(!traceGeometryStatesGraphOwned)
        capacity += traceGeometryResourceCount;
    return capacity;
}

usize ComputeSurfelTraceResourceUseReserve(
    in b8 hasCsgTraceContext,
    in usize csgTraceBoundsCount,
    in b8 traceGeometryStatesGraphOwned,
    in usize traceGeometryResourceCount
){
    usize capacity = s_SurfelTraceResourceUseCapacity + csgTraceBoundsCount;
    if(hasCsgTraceContext)
        capacity += s_SurfelCsgTraceContextUseCapacity;
    if(!traceGeometryStatesGraphOwned)
        capacity += traceGeometryResourceCount;
    return capacity;
}

b8 HasCompletePersistentSurfelGraphResources(
    in b8 hasConstants,
    in b8 hasPool,
    in b8 hasGuidePool,
    in b8 hasCellHead,
    in b8 hasCounter,
    in b8 hasTraceIndirectArgs,
    in b8 hasFreeList,
    in b8 hasPoolSnapshot,
    in b8 hasCellHeadSnapshot
){
    return hasConstants
        && hasPool
        && hasGuidePool
        && hasCellHead
        && hasCounter
        && hasTraceIndirectArgs
        && hasFreeList
        && hasPoolSnapshot
        && hasCellHeadSnapshot
    ;
}

b8 CanGraphOwnSurfelGiResolve(
    in b8 hasSurfelWork,
    in b8 hasShadowMaterialsAndInstances,
    in b8 hasMaterialContextSlots,
    in b8 hasPersistentSurfelResources,
    in b8 useHwTrace,
    in b8 hasTlas,
    in b8 hasSceneBvhAndInstances,
    in b8 surfelSplitGraphPipelinesReady
){
    if(!hasSurfelWork || !hasShadowMaterialsAndInstances || !hasMaterialContextSlots || !hasPersistentSurfelResources || !surfelSplitGraphPipelinesReady)
        return false;
    if(useHwTrace)
        return hasTlas;
    return hasSceneBvhAndInstances;
}

void ApplyFreshSurfelBufferFlags(
    in b8 markNeedsClear,
    in b8 resetSeeded,
    mut b8 inOutSurfelSeeded,
    mut b8 inOutSurfelResourcesNeedClear
){
    if(resetSeeded)
        inOutSurfelSeeded = false;
    if(markNeedsClear)
        inOutSurfelResourcesNeedClear = true;
}

b8 ShouldCaptureSurfelCountReadbackState(
    in b8 hasSurfelWork,
    in b8 hasCounterBuffer,
    in b8 hasCounterReadbackBuffer,
    in b8 hasPendingReadbackToken,
    in u32 frameIndex
){
    return hasSurfelWork && hasCounterBuffer && hasCounterReadbackBuffer && !hasPendingReadbackToken && IsSurfelCountReadbackDue(frameIndex);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<GpuGraphResourceId> ImportSurfelBuffer(mut GpuTaskGraph graph, mut Vector<GpuTaskResourceUse> uses, in BufferHandle buffer, in Name identity, in StringView label, in ResourceStates state, in b8 writable, in b8 appendUse){
    if(!buffer.valid())
        return GpuGraphResourceId();
    const auto imported = ImportExternalBuffer(graph, buffer, identity, label);
    if(!imported.has_value())
        return MakeUnexpected(Failure());
    if(appendUse){
        if(writable)
            uses.push_back(WriteUse(imported.value(), state));
        else
            uses.push_back(ReadUse(imported.value(), state));
    }
    return imported.value();
}

b8 ImportOptionalSurfelBuffers(in SurfelGiResourceInputs inputs, mut GpuTaskGraph graph, mut SurfelGiResourcePlan result, in b8 appendUse){
    const auto shadowInstanceMaterialsResult = ImportSurfelBuffer(graph, result.resourceUses, inputs.rayTracingResources.shadowInstanceMaterialBuffer, Name(s_SceneShadowInstanceMaterialName),
        s_SceneShadowInstanceMaterialLabel, ResourceStates::ShaderResource, false, appendUse);
    if(!shadowInstanceMaterialsResult.has_value())
        return false;
    result.shadowInstanceMaterials = shadowInstanceMaterialsResult.value();
    const auto shadowMaterialTypedResult = ImportSurfelBuffer(graph, result.resourceUses, inputs.rayTracingResources.shadowMaterialTypedBuffer, Name(s_SceneShadowMaterialTypedName), s_SceneShadowMaterialTypedLabel, ResourceStates::ShaderResource, false, appendUse);
    if(!shadowMaterialTypedResult.has_value())
        return false;
    result.shadowMaterialTyped = shadowMaterialTypedResult.value();
    const auto shadowInstancesResult = ImportSurfelBuffer(graph, result.resourceUses, inputs.rayTracingResources.shadowInstanceBuffer, Name(s_SceneShadowInstancesName), s_SceneShadowInstancesLabel, ResourceStates::ShaderResource, false, appendUse);
    if(!shadowInstancesResult.has_value())
        return false;
    result.shadowInstances = shadowInstancesResult.value();
    const auto surfelConstantsResult = ImportSurfelBuffer(graph, result.resourceUses, inputs.rayTracingSurfelResources.constantsBuffer, Name(s_SurfelConstantsName), s_SurfelConstantsLabel, ResourceStates::ConstantBuffer, false, appendUse);
    if(!surfelConstantsResult.has_value())
        return false;
    result.surfelConstants = surfelConstantsResult.value();
    const auto surfelPoolResult = ImportSurfelBuffer(graph, result.resourceUses, inputs.rayTracingSurfelResources.poolBuffer, Name(s_SurfelGraphPool), s_SurfelPoolGraphLabel, ResourceStates::UnorderedAccess, true, appendUse);
    if(!surfelPoolResult.has_value())
        return false;
    result.surfelPool = surfelPoolResult.value();
    const auto surfelGuidePoolResult = ImportSurfelBuffer(graph, result.resourceUses, inputs.rayTracingSurfelResources.guidePoolBuffer, Name(s_SurfelGraphGuidePool), s_SurfelGuidePoolGraphLabel, ResourceStates::UnorderedAccess, true, appendUse);
    if(!surfelGuidePoolResult.has_value())
        return false;
    result.surfelGuidePool = surfelGuidePoolResult.value();
    const auto surfelCellHeadResult = ImportSurfelBuffer(graph, result.resourceUses, inputs.rayTracingSurfelResources.cellHeadBuffer, Name(s_SurfelGraphCellHeads), s_SurfelCellHeadsGraphLabel, ResourceStates::UnorderedAccess, true, appendUse);
    if(!surfelCellHeadResult.has_value())
        return false;
    result.surfelCellHead = surfelCellHeadResult.value();
    const auto surfelCounterResult = ImportSurfelBuffer(graph, result.resourceUses, inputs.rayTracingSurfelResources.counterBuffer, Name(s_SurfelCounterName), s_SurfelCounterLabel, ResourceStates::UnorderedAccess, true, appendUse);
    if(!surfelCounterResult.has_value())
        return false;
    result.surfelCounter = surfelCounterResult.value();
    const auto surfelFreeListResult = ImportSurfelBuffer(graph, result.resourceUses, inputs.rayTracingSurfelResources.freeListBuffer, Name(s_SurfelGraphFreeList), s_SurfelFreeListGraphLabel, ResourceStates::UnorderedAccess, true, appendUse);
    if(!surfelFreeListResult.has_value())
        return false;
    result.surfelFreeList = surfelFreeListResult.value();
    const auto surfelPoolSnapshotResult = ImportSurfelBuffer(graph, result.resourceUses, inputs.rayTracingSurfelResources.poolSnapshotBuffer, Name(s_SurfelGraphPoolSnapshot), s_SurfelPoolSnapshotGraphLabel, ResourceStates::ShaderResource, false, appendUse);
    if(!surfelPoolSnapshotResult.has_value())
        return false;
    result.surfelPoolSnapshot = surfelPoolSnapshotResult.value();
    const auto surfelCellHeadSnapshotResult = ImportSurfelBuffer(graph, result.resourceUses, inputs.rayTracingSurfelResources.cellHeadSnapshotBuffer, Name(s_SurfelGraphCellHeadSnapshot),
        s_SurfelCellHeadSnapshotGraphLabel, ResourceStates::ShaderResource, false, appendUse);
    if(!surfelCellHeadSnapshotResult.has_value())
        return false;
    result.surfelCellHeadSnapshot = surfelCellHeadSnapshotResult.value();
    return true;
}

b8 SurfelGiResourceBuilder::prepare(in SurfelGiResourceInputs inputs, mut SurfelGiResourcePlan result){
    const auto surfelIrradianceHalfResult = ImportExternalTexture(this.m_graph, inputs.deferredTargets.surfelIrradianceHalf, Name(s_SurfelGraphIrradianceHalf), s_SurfelIrradianceHalfGraphLabel);
    const auto sceneGeometryDomainResult = this.m_graph.importHazardDomain(HazardDomainDesc(Name(s_SurfelGraphSceneGeometry), s_SceneGeometryDomainLabel));
    if(!surfelIrradianceHalfResult.has_value() || !sceneGeometryDomainResult.has_value()){
        warning("RendererSystem: could not import deferred surfel-GI graph resources");
        return false;
    }
    result.surfelIrradianceHalf = surfelIrradianceHalfResult.value();
    result.sceneGeometryDomain = sceneGeometryDomainResult.value();

    const b8 hasCsgTraceContext = inputs.rayTracingResources.csgTraceContextBuffer.valid();
    const b8 appendFallbackUses = !inputs.hasSurfelWork;
    if(appendFallbackUses){
        result.resourceUses.reserve(ComputeSurfelResourceUseReserve(hasCsgTraceContext, inputs.traceGeometryStatesGraphOwned, inputs.traceGeometryResources.size()));
        result.resourceUses.push_back(ReadUse(inputs.worldPosition));
        result.resourceUses.push_back(ReadUse(inputs.normal));
        result.resourceUses.push_back(ReadUse(inputs.currentBindlessSlots, ResourceStates::ConstantBuffer));
        result.resourceUses.push_back(WriteUse(result.surfelIrradianceHalf, ResourceStates::UnorderedAccess));
        result.resourceUses.push_back(WriteUse(inputs.surfelIrradiance, ResourceStates::UnorderedAccess));
        result.resourceUses.push_back(ReadUse(inputs.sceneShading, ResourceStates::ConstantBuffer));
        result.resourceUses.push_back(ReadUse(inputs.lights, ResourceStates::ShaderResource));
        result.resourceUses.push_back(ReadUse(result.sceneGeometryDomain));
        if(inputs.materialContextSlots.valid())
            result.resourceUses.push_back(ReadUse(inputs.materialContextSlots, ResourceStates::ConstantBuffer));
        for(in GpuGraphResourceId resource : inputs.traceGeometryResources){
            if(!resource.valid())
                return false;
            if(!inputs.traceGeometryStatesGraphOwned)
                result.resourceUses.push_back(ReadUse(resource, ResourceStates::ShaderResource));
        }
    }
    else{
        result.resourceUses.reserve(4u);
        result.traceResourceUses.reserve(ComputeSurfelTraceResourceUseReserve(hasCsgTraceContext, inputs.rayTracingResources.csgTraceBoundsBuffers.size(), inputs.traceGeometryStatesGraphOwned, inputs.traceGeometryResources.size()));
        for(in GpuGraphResourceId resource : inputs.traceGeometryResources){
            if(!resource.valid())
                return false;
        }
    }

    b8 optionalResourcesImported = ImportOptionalSurfelBuffers(inputs, this.m_graph, result, appendFallbackUses);
    if(optionalResourcesImported && inputs.rayTracingResources.csgTraceContextBuffer.valid()){
        {
            const GpuTaskGraphDeclarationReadView declarations(this.m_graph);
            result.csgTraceContext = declarations.findImportedBuffer(inputs.rayTracingResources.csgTraceContextBuffer);
        }
        optionalResourcesImported = result.csgTraceContext.valid();
        if(optionalResourcesImported && appendFallbackUses)
            result.resourceUses.push_back(ReadUse(result.csgTraceContext, ResourceStates::ShaderResource));
    }
    if(optionalResourcesImported && inputs.rayTracingSurfelResources.traceIndirectArgsBuffer.valid()){
        const auto surfelTraceIndirectArgsResult = ImportExternalBuffer(this.m_graph, inputs.rayTracingSurfelResources.traceIndirectArgsBuffer, Name(s_SurfelGraphTraceArgs), s_SurfelTraceArgsGraphLabel);
        if(surfelTraceIndirectArgsResult.has_value())
            result.surfelTraceIndirectArgs = surfelTraceIndirectArgsResult.value();
        optionalResourcesImported = surfelTraceIndirectArgsResult.has_value();
    }
    if(optionalResourcesImported && !inputs.useHwTrace){
        const auto sceneBvhNodesResult = ImportSurfelBuffer(this.m_graph, result.resourceUses, inputs.rayTracingResources.sceneBvhNodeBuffer, Name(s_SceneBvhNodesName), s_SceneBvhNodesLabel, ResourceStates::ShaderResource, false, appendFallbackUses);
        if(sceneBvhNodesResult.has_value())
            result.sceneBvhNodes = sceneBvhNodesResult.value();
        optionalResourcesImported = sceneBvhNodesResult.has_value();
    }
    if(optionalResourcesImported && !inputs.useHwTrace){
        const auto sceneInstancesResult = ImportSurfelBuffer(this.m_graph, result.resourceUses, inputs.rayTracingResources.sceneInstanceBuffer, Name(s_SceneInstancesName), s_SceneInstancesLabel, ResourceStates::ShaderResource, false, appendFallbackUses);
        if(sceneInstancesResult.has_value())
            result.sceneInstances = sceneInstancesResult.value();
        optionalResourcesImported = sceneInstancesResult.has_value();
    }
    if(optionalResourcesImported && inputs.useHwTrace){
        if(!inputs.rayTracingResources.sceneTlas.valid())
            optionalResourcesImported = false;
        else{
            auto desc = AccelStructResourceDesc(Name(s_SceneTlasResourceName), s_SceneTlasResourceLabel);
            desc.setInitialState(this.m_raytracingSystem.sceneTlasBackingInitialState());
            const auto tlasResult = this.m_graph.importAccelStruct(inputs.rayTracingResources.sceneTlas, desc);
            if(tlasResult.has_value())
                result.tlas = tlasResult.value();
            optionalResourcesImported = tlasResult.has_value();
            if(optionalResourcesImported && appendFallbackUses)
                result.resourceUses.push_back(ReadUse(result.tlas, ResourceStates::AccelStructRead));
        }
    }
    if(!optionalResourcesImported){
        warning("RendererSystem: could not import a deferred surfel-GI dynamic resource domain");
        return false;
    }

    const b8 hasShadowMaterialsAndInstances = result.shadowInstanceMaterials.valid() && result.shadowMaterialTyped.valid() && result.shadowInstances.valid();
    const b8 hasPersistentSurfelResources = HasCompletePersistentSurfelGraphResources(
        result.surfelConstants.valid(),
        result.surfelPool.valid(),
        result.surfelGuidePool.valid(),
        result.surfelCellHead.valid(),
        result.surfelCounter.valid(),
        result.surfelTraceIndirectArgs.valid(),
        result.surfelFreeList.valid(),
        result.surfelPoolSnapshot.valid(),
        result.surfelCellHeadSnapshot.valid()
    );
    result.graphOwnsSurfelGiResolve = CanGraphOwnSurfelGiResolve(
        inputs.hasSurfelWork,
        hasShadowMaterialsAndInstances,
        inputs.materialContextSlots.valid(),
        hasPersistentSurfelResources,
        inputs.useHwTrace,
        result.tlas.valid(),
        result.sceneBvhNodes.valid() && result.sceneInstances.valid(),
        inputs.rayTracingResources.surfelSplitGraphPipelinesReady
    );
    if(inputs.hasSurfelWork && !result.graphOwnsSurfelGiResolve){
        warning("RendererSystem: active surfel GI has no complete prepared graph resources");
        return false;
    }
    if(result.graphOwnsSurfelGiResolve){
        result.resourceUses.clear();
        result.resourceUses.push_back(ReadUse(inputs.worldPosition));
        result.resourceUses.push_back(ReadUse(inputs.normal));
        result.resourceUses.push_back(ReadUse(result.surfelIrradianceHalf, ResourceStates::ShaderResource));
        result.resourceUses.push_back(WriteUse(inputs.surfelIrradiance, ResourceStates::UnorderedAccess));

        result.traceResourceUses.push_back(ReadUse(inputs.currentBindlessSlots, ResourceStates::ConstantBuffer));
        result.traceResourceUses.push_back(ReadUse(inputs.sceneShading, ResourceStates::ConstantBuffer));
        result.traceResourceUses.push_back(ReadUse(inputs.lights, ResourceStates::ShaderResource));
        result.traceResourceUses.push_back(ReadUse(result.sceneGeometryDomain));
        result.traceResourceUses.push_back(ReadUse(inputs.materialContextSlots, ResourceStates::ConstantBuffer));
        result.traceResourceUses.push_back(ReadUse(result.shadowInstanceMaterials, ResourceStates::ShaderResource));
        result.traceResourceUses.push_back(ReadUse(result.shadowMaterialTyped, ResourceStates::ShaderResource));
        result.traceResourceUses.push_back(ReadUse(result.shadowInstances, ResourceStates::ShaderResource));
        if(result.csgTraceContext.valid()){
            if(!AppendCurrentCsgRayGeometry(inputs.rayTracingResources.csgTraceContextBuffer, inputs.rayTracingResources.csgTraceBoundsBuffers, this.m_graph, result.traceResourceUses))
                return false;
            result.traceResourceUses.push_back(ReadWriteUse(result.surfelCounter, ResourceStates::UnorderedAccess));
        }
        result.traceResourceUses.push_back(ReadUse(result.surfelConstants, ResourceStates::ConstantBuffer));
        result.traceResourceUses.push_back(ReadWriteUse(result.surfelPool, ResourceStates::UnorderedAccess));
        result.traceResourceUses.push_back(ReadWriteUse(result.surfelGuidePool, ResourceStates::UnorderedAccess));
        result.traceResourceUses.push_back(ReadUse(result.surfelPoolSnapshot, ResourceStates::ShaderResource));
        result.traceResourceUses.push_back(ReadUse(result.surfelCellHeadSnapshot, ResourceStates::ShaderResource));
        result.traceResourceUses.push_back(ReadUse(result.surfelTraceIndirectArgs, ResourceStates::IndirectArgument));
        if(!inputs.traceGeometryStatesGraphOwned){
            for(in GpuGraphResourceId resource : inputs.traceGeometryResources)
                result.traceResourceUses.push_back(ReadUse(resource, ResourceStates::ShaderResource));
        }
        if(inputs.useHwTrace)
            result.traceResourceUses.push_back(ReadUse(result.tlas, ResourceStates::AccelStructRead));
        else{
            result.traceResourceUses.push_back(ReadUse(result.sceneBvhNodes, ResourceStates::ShaderResource));
            result.traceResourceUses.push_back(ReadUse(result.sceneInstances, ResourceStates::ShaderResource));
        }
    }
    else if(result.surfelTraceIndirectArgs.valid())
        result.resourceUses.push_back(WriteUse(result.surfelTraceIndirectArgs, ResourceStates::UnorderedAccess));

    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 EnsureSurfelBuffer(mut GraphicsRuntime graphics, mut RtSurfelGiState state, in BufferDesc desc, in StringView errorMessage, in b8 markNeedsClear, in b8 resetSeeded, mut BufferHandle buffer){
    if(buffer.valid())
        return true;
    const auto created = graphics.createBuffer(desc);
    if(!created.has_value()){
        buffer.reset();
        error("{}", errorMessage);
        return false;
    }
    buffer = created.value();
    ApplyFreshSurfelBufferFlags(markNeedsClear, resetSeeded, state.m_surfelSeeded, state.m_surfelResourcesNeedClear);
    return true;
}

BufferDesc MakeSurfelStructuredDesc(in u64 byteSize, in u32 stride, in b8 canHaveUavs, in b8 indirectArgs, in ResourceQueueSharing queueSharing, in Name debugName){
    BufferDesc desc;
    desc.setByteSize(byteSize).setStructStride(stride).setCanHaveUAVs(canHaveUavs).setIsDrawIndirectArgs(indirectArgs).setQueueSharing(queueSharing).setDebugName(debugName).enableAutomaticStateTracking(ResourceStates::Common);
    return desc;
}

RayTracingSurfelPersistentResourceSnapshot RendererRayTracingSystem::snapshotSurfelPersistentResources()const{
    RayTracingSurfelPersistentResourceSnapshot snapshot;
    snapshot.constantsBuffer = this.m_rayTracingState.surfelGi.m_surfelConstants;
    snapshot.poolBuffer = this.m_rayTracingState.surfelGi.m_surfelPoolBuffer;
    snapshot.guidePoolBuffer = this.m_rayTracingState.surfelGi.m_surfelGuidePoolBuffer;
    snapshot.cellHeadBuffer = this.m_rayTracingState.surfelGi.m_surfelCellHeadBuffer;
    snapshot.counterBuffer = this.m_rayTracingState.surfelGi.m_surfelCounterBuffer;
    snapshot.traceIndirectArgsBuffer = this.m_rayTracingState.surfelGi.m_surfelTraceIndirectArgsBuffer;
    snapshot.freeListBuffer = this.m_rayTracingState.surfelGi.m_surfelFreeListBuffer;
    snapshot.poolSnapshotBuffer = this.m_rayTracingState.surfelGi.m_surfelPoolSnapshotBuffer;
    snapshot.cellHeadSnapshotBuffer = this.m_rayTracingState.surfelGi.m_surfelCellHeadSnapshotBuffer;
    snapshot.counterReadbackBuffer = this.m_rayTracingState.surfelGi.m_surfelCounterReadback;
    snapshot.countReadbackSubmissionToken = this.m_rayTracingState.surfelGi.m_surfelCountReadbackSubmissionToken;
    return snapshot;
}

b8 RendererRayTracingSystem::surfelCountReadbackSubmissionMatches(in QueueSubmissionToken submissionToken)const{
    return SurfelReadbackSubmissionMatches(this.m_rayTracingState.surfelGi.m_surfelCountReadbackSubmissionToken, submissionToken);
}

void RendererRayTracingSystem::confirmSurfelCountReadbackSubmission(in QueueSubmissionToken submissionToken){
    assert(submissionToken.valid());
    this.m_rayTracingState.surfelGi.m_surfelCountReadbackSubmissionToken = submissionToken;
}

[cpp_unwind]
b8 RendererRayTracingSystem::createSurfelTargets(mut DeferredFrameTargets targets){
    const u32 factor = targets.surfelResolveFactor;
    const SurfelGiResolveSize resolveSize = MakeSurfelGiResolveSize(targets.width, targets.height, factor);
    if(!IsValidSurfelGiResolveSize(resolveSize))
        return false;

    targets.surfelIrradianceFormat = Format::RGBA16_FLOAT;
    TextureDesc surfelIrradianceDesc;
    surfelIrradianceDesc.setWidth(targets.width).setHeight(targets.height).setFormat(targets.surfelIrradianceFormat).setIsUAV(true).setQueueSharing(ResourceQueueSharing::GraphicsAsyncComputeAndTransfer).setName(s_SurfelIrradianceTargetName);
    auto surfelIrradianceResult = this.m_graphics.createTexture(surfelIrradianceDesc);
    if(surfelIrradianceResult.has_value())
        targets.surfelIrradiance = surfelIrradianceResult.value();
    else
        targets.surfelIrradiance.reset();
    if(!surfelIrradianceResult.has_value()){
        error("RendererSystem: failed to create surfel irradiance target");
        return false;
    }

    TextureDesc surfelIrradianceHalfDesc;
    surfelIrradianceHalfDesc.setWidth(resolveSize.width).setHeight(resolveSize.height).setFormat(targets.surfelIrradianceFormat).setIsUAV(true).setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute).setName(s_SurfelIrradianceHalfTargetName);
    auto surfelIrradianceHalfResult = this.m_graphics.createTexture(surfelIrradianceHalfDesc);
    if(surfelIrradianceHalfResult.has_value())
        targets.surfelIrradianceHalf = surfelIrradianceHalfResult.value();
    else
        targets.surfelIrradianceHalf.reset();
    if(!surfelIrradianceHalfResult.has_value()){
        error("RendererSystem: failed to create surfel reduced-resolution irradiance target");
        return false;
    }

    this.m_rayTracingState.surfelGi.m_surfelResolveDispatchLogged = false;
    return true;
}

[cpp_unwind]
Expected<Optional<GpuUploadBlobId>> RendererRayTracingSystem::retainPreparedSurfelFrameConstantsUpload(mut GpuTaskGraph graph, in DeferredFrameTargets targets)const{
    if(!this.hasSurfelWork())
        return Optional<GpuUploadBlobId>();
    if(!this.m_rayTracingState.surfelGi.m_surfelConstants.valid()){
        error("RendererSystem: active surfel GI has no preflighted constant buffer");
        return MakeUnexpected(Failure());
    }

    const NwbSurfelConstantsGpu params = BuildSurfelFrameConstants(
        this.m_rayTracingState.surfelGi.m_surfelSeeded,
        this.m_rayTracingState.surfelGi.m_surfelHashCellCount,
        this.m_rayTracingState.surfelGi.m_surfelPoolCapacity,
        this.m_rayTracingState.surfelGi.m_surfelFrameIndex,
        targets.width,
        targets.height,
        targets.surfelResolveFactor
    );
    const auto blob = graph.copyUploadValue(params);
    if(!blob.has_value())
        return MakeUnexpected(Failure());
    return Optional<GpuUploadBlobId>(blob.value());
}

[cpp_unwind]
void RendererRayTracingSystem::releaseSurfelGiHeapHandles(){
    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
    RetireDescriptor(heap, this.m_rayTracingState.surfelGi.m_surfelConstantsHeapHandle);
    RetireDescriptor(heap, this.m_rayTracingState.surfelGi.m_surfelPoolHeapHandle);
    RetireDescriptor(heap, this.m_rayTracingState.surfelGi.m_surfelGuidePoolHeapHandle);
    RetireDescriptor(heap, this.m_rayTracingState.surfelGi.m_surfelCellHeadHeapHandle);
    RetireDescriptor(heap, this.m_rayTracingState.surfelGi.m_surfelCounterHeapHandle);
    RetireDescriptor(heap, this.m_rayTracingState.surfelGi.m_surfelTraceIndirectArgsHeapHandle);
    RetireDescriptor(heap, this.m_rayTracingState.surfelGi.m_surfelFreeListHeapHandle);
    RetireDescriptor(heap, this.m_rayTracingState.surfelGi.m_surfelPoolSnapshotHeapHandle);
    RetireDescriptor(heap, this.m_rayTracingState.surfelGi.m_surfelCellHeadSnapshotHeapHandle);
}

b8 RendererRayTracingSystem::recordSurfelResourceInitializationLifecycle(){
    if(!BeginSurfelResourceInitializationLifecycle(this.m_rayTracingState.surfelGi.m_surfelResourcesNeedClear))
        return false;
    this.m_rayTracingState.surfelGi.m_surfelResourcesClearPending = true;
    return true;
}

void RendererRayTracingSystem::finalizeSurfelResourceInitialization(){
    FinalizeSurfelResourceInitializationLifecycle(this.m_rayTracingState.surfelGi.m_surfelResourcesClearPending, this.m_rayTracingState.surfelGi.m_surfelResourcesNeedClear);
}

[cpp_unwind]
b8 RendererRayTracingSystem::ensureSurfelResources(){
    if(!this.hasSurfelWork())
        return true;

    const u32 poolCapacity = this.m_rayTracingState.surfelGi.m_surfelPoolCapacity;
    const u32 cellCount = this.m_rayTracingState.surfelGi.m_surfelHashCellCount;
    if(!IsValidSurfelGiStorageCounts(poolCapacity, cellCount))
        return false;

    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized()){
        error("RendererSystem: surfel GI requires the initialized global descriptor heap");
        return false;
    }

    BufferDesc readbackDesc;
    readbackDesc.setByteSize(ComputeSurfelWordBufferByteSize(cast<u32>(s_SurfelReadbackCounterCount))).setCpuAccess(CpuAccessMode::Read).setQueueSharing(ResourceQueueSharing::GraphicsAsyncComputeAndTransfer).setDebugName(Name(s_SurfelResourceCounterReadback)).enableAutomaticStateTracking(ResourceStates::CopyDest);
    BufferDesc constantsDesc;
    constantsDesc.setByteSize(size_of<NwbSurfelConstantsGpu>()).setIsConstantBuffer(true).setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute).setDebugName(Name(s_SurfelResourceConstants)).enableAutomaticStateTracking(ResourceStates::Common);

    const u64 guidePoolStride = cast<u64>(s_ShaderSurfelGuideFloat4Stride) * s_ShaderSurfelGuideFloat4SPerSurfel;
    if(
        !EnsureSurfelBuffer(this.m_graphics, this.m_rayTracingState.surfelGi, MakeSurfelStructuredDesc(ComputeSurfelBufferByteSize(s_ShaderSurfelRecordSize, poolCapacity), s_ShaderSurfelRecordSize, true, false,
            ResourceQueueSharing::GraphicsAsyncComputeAndTransfer, Name(s_SurfelResourcePool)), "RendererSystem: failed to create surfel pool buffer", true, true, this.m_rayTracingState.surfelGi.m_surfelPoolBuffer)
        || !EnsureSurfelBuffer(this.m_graphics, this.m_rayTracingState.surfelGi, MakeSurfelStructuredDesc(ComputeSurfelBufferByteSize(guidePoolStride, poolCapacity), s_ShaderSurfelGuideFloat4Stride, true, false,
            ResourceQueueSharing::GraphicsAsyncComputeAndTransfer, Name(s_SurfelResourceGuidePool)), "RendererSystem: failed to create surfel guide pool buffer", true, false, this.m_rayTracingState.surfelGi.m_surfelGuidePoolBuffer)
        || !EnsureSurfelBuffer(this.m_graphics, this.m_rayTracingState.surfelGi, MakeSurfelStructuredDesc(ComputeSurfelBufferByteSize(size_of<u32>(), cellCount), size_of<u32>(), true, false,
            ResourceQueueSharing::GraphicsAsyncComputeAndTransfer, Name(s_SurfelResourceCellHead)), "RendererSystem: failed to create surfel cell-head buffer", true, false, this.m_rayTracingState.surfelGi.m_surfelCellHeadBuffer)
        || !EnsureSurfelBuffer(this.m_graphics, this.m_rayTracingState.surfelGi, MakeSurfelStructuredDesc(ComputeSurfelWordBufferByteSize(cast<u32>(s_SurfelReadbackCounterCount)), size_of<u32>(), true, false,
            ResourceQueueSharing::GraphicsAsyncComputeAndTransfer, Name(s_SurfelResourceCounter)), "RendererSystem: failed to create surfel counter buffer", true, false, this.m_rayTracingState.surfelGi.m_surfelCounterBuffer)
        || !EnsureSurfelBuffer(this.m_graphics, this.m_rayTracingState.surfelGi, MakeSurfelStructuredDesc(ComputeSurfelWordBufferByteSize(s_ShaderSurfelTraceIndirectArgsWordCount), size_of<u32>(), true, true,
            ResourceQueueSharing::GraphicsAndAsyncCompute, Name(s_SurfelResourceTraceIndirectArgs)), "RendererSystem: failed to create surfel trace indirect-args buffer", false, false, this.m_rayTracingState.surfelGi.m_surfelTraceIndirectArgsBuffer)
        || !EnsureSurfelBuffer(this.m_graphics, this.m_rayTracingState.surfelGi, MakeSurfelStructuredDesc(ComputeSurfelBufferByteSize(size_of<u32>(), poolCapacity), size_of<u32>(), true, false,
            ResourceQueueSharing::GraphicsAndAsyncCompute, Name(s_SurfelResourceFreeList)), "RendererSystem: failed to create surfel free-list buffer", true, false, this.m_rayTracingState.surfelGi.m_surfelFreeListBuffer)
        || !EnsureSurfelBuffer(this.m_graphics, this.m_rayTracingState.surfelGi, MakeSurfelStructuredDesc(ComputeSurfelBufferByteSize(s_ShaderSurfelRecordSize, poolCapacity), s_ShaderSurfelRecordSize, false, false,
            ResourceQueueSharing::GraphicsAsyncComputeAndTransfer, Name(s_SurfelResourcePoolSnapshot)), "RendererSystem: failed to create surfel pool snapshot buffer", false, false, this.m_rayTracingState.surfelGi.m_surfelPoolSnapshotBuffer)
        || !EnsureSurfelBuffer(this.m_graphics, this.m_rayTracingState.surfelGi, MakeSurfelStructuredDesc(ComputeSurfelBufferByteSize(size_of<u32>(), cellCount), size_of<u32>(), false, false,
            ResourceQueueSharing::GraphicsAsyncComputeAndTransfer, Name(s_SurfelResourceCellHeadSnapshot)), "RendererSystem: failed to create surfel cell-head snapshot buffer", false, false, this.m_rayTracingState.surfelGi.m_surfelCellHeadSnapshotBuffer)
        || !EnsureSurfelBuffer(this.m_graphics, this.m_rayTracingState.surfelGi, readbackDesc, "RendererSystem: failed to create surfel counter readback buffer", false, false, this.m_rayTracingState.surfelGi.m_surfelCounterReadback)
        || !EnsureSurfelBuffer(this.m_graphics, this.m_rayTracingState.surfelGi, constantsDesc, "RendererSystem: failed to create surfel constant buffer", false, false, this.m_rayTracingState.surfelGi.m_surfelConstants)
    )
        return false;

    if(
        !EnsureHeapBuffer(GpuDescriptorClass::UniformBuffer, false, heap, this.m_rayTracingState.surfelGi.m_surfelConstants.deref(), this.m_rayTracingState.surfelGi.m_surfelConstantsHeapHandle)
        || !EnsureHeapBuffer(GpuDescriptorClass::StorageBuffer, true, heap, this.m_rayTracingState.surfelGi.m_surfelPoolBuffer.deref(), this.m_rayTracingState.surfelGi.m_surfelPoolHeapHandle)
        || !EnsureHeapBuffer(GpuDescriptorClass::StorageBuffer, true, heap, this.m_rayTracingState.surfelGi.m_surfelGuidePoolBuffer.deref(), this.m_rayTracingState.surfelGi.m_surfelGuidePoolHeapHandle)
        || !EnsureHeapBuffer(GpuDescriptorClass::StorageBuffer, true, heap, this.m_rayTracingState.surfelGi.m_surfelCellHeadBuffer.deref(), this.m_rayTracingState.surfelGi.m_surfelCellHeadHeapHandle)
        || !EnsureHeapBuffer(GpuDescriptorClass::StorageBuffer, true, heap, this.m_rayTracingState.surfelGi.m_surfelCounterBuffer.deref(), this.m_rayTracingState.surfelGi.m_surfelCounterHeapHandle)
        || !EnsureHeapBuffer(GpuDescriptorClass::StorageBuffer, true, heap, this.m_rayTracingState.surfelGi.m_surfelTraceIndirectArgsBuffer.deref(), this.m_rayTracingState.surfelGi.m_surfelTraceIndirectArgsHeapHandle)
        || !EnsureHeapBuffer(GpuDescriptorClass::StorageBuffer, true, heap, this.m_rayTracingState.surfelGi.m_surfelFreeListBuffer.deref(), this.m_rayTracingState.surfelGi.m_surfelFreeListHeapHandle)
        || !EnsureHeapBuffer(GpuDescriptorClass::StorageBuffer, false, heap, this.m_rayTracingState.surfelGi.m_surfelPoolSnapshotBuffer.deref(), this.m_rayTracingState.surfelGi.m_surfelPoolSnapshotHeapHandle)
        || !EnsureHeapBuffer(GpuDescriptorClass::StorageBuffer, false, heap, this.m_rayTracingState.surfelGi.m_surfelCellHeadSnapshotBuffer.deref(), this.m_rayTracingState.surfelGi.m_surfelCellHeadSnapshotHeapHandle)
    ){
        error("RendererSystem: failed to register persistent surfel resources in the descriptor heap");
        return false;
    }

    SurfelGiPipelineSet pipelines(this.m_graphics, this.m_shaderSystem, this.m_rayTracingState.surfelGi);
    b8 traceReady = false;
    if(this.m_rayTracingState.surfelGi.m_surfelUseHwTrace)
        traceReady = pipelines.ensureSurfelTraceHwPipeline();
    else
        traceReady = pipelines.ensureSurfelTracePipeline();
    if(!pipelines.ensureSurfelSpawnPipeline() || !pipelines.ensureSurfelAgeFreePipeline() || !pipelines.ensureSurfelHashBuildPipeline() || !traceReady || !pipelines.ensureSurfelResolvePipeline() || !pipelines.ensureSurfelUpsamplePipeline() || !pipelines.ensureSurfelTraceBuildArgsPipeline())
        return false;
    return true;
}

b8 RendererRayTracingSystem::shouldCaptureSurfelCountReadback()const{
    return ShouldCaptureSurfelCountReadbackState(this.hasSurfelWork(), this.m_rayTracingState.surfelGi.m_surfelCounterBuffer.valid(), this.m_rayTracingState.surfelGi.m_surfelCounterReadback.valid(),
        this.m_rayTracingState.surfelGi.m_surfelCountReadbackSubmissionToken.valid(), this.m_rayTracingState.surfelGi.m_surfelFrameIndex);
}

[cpp_unwind]
b8 RendererRayTracingSystem::prepareSurfelResources(mut DeferredFrameTargets targets){
    if(!this.hasSurfelWork())
        return true;

    this.m_rayTracingState.surfelGi.m_surfelUseCsgTrace = this.m_lightSpaceShadow.m_csg.snapshot.hasCsg;
    if(!this.ensureSurfelResources())
        return false;

    RayTraceMaterialResources materialResources(this.m_graphics, this.m_rayTracingState.sceneBvh, this.m_rayTracingState.shadow);
    if(!targets.bindless.valid() || !IsDescriptorClass(targets.bindless.slotsBufferDescriptor, GpuDescriptorClass::UniformBuffer) || !materialResources.ensureRayTraceMaterialContextSlotsHeapHandle()){
        error("RendererSystem: surfel GI trace heap context is incomplete");
        return false;
    }

    return true;
}


