void VerifyWin32TextInputFixture_SceneFallbackSurrogateStateIsPerServiceAndValidatesUnits(mut Win32TextInputFixture self){
    native(mut self){
#if defined(NWB_PLATFORM_WINDOWS)
        ASSERT_TRUE(self.m_service->end(self.m_token));
        auto secondResult = CreateTextInputService(self.m_arena.arena, self.m_window);
        ASSERT_TRUE(secondResult);
        const GlobalUniquePtr<ITextInputService> second = Move(*secondResult);
        ASSERT_NE(second.get(), nullptr);
        ASSERT_TRUE(second->setFocused(true));
        EXPECT_FALSE(DecodeWin32FallbackCharInput(*self.m_service, 0xd83du));
        EXPECT_FALSE(DecodeWin32FallbackCharInput(*second, 0xde00u));
        Expected<u32> codePoint = DecodeWin32FallbackCharInput(*self.m_service, 0xde00u);
        ASSERT_TRUE(codePoint);
        EXPECT_EQ(*codePoint, 0x1f600u);
        EXPECT_FALSE(DecodeWin32FallbackCharInput(*self.m_service, 0x110000u));

        EXPECT_FALSE(DecodeWin32FallbackCharInput(*self.m_service, 0u));
        EXPECT_FALSE(DecodeWin32FallbackCharInput(*self.m_service, 0xd83du));
        ASSERT_TRUE((codePoint = DecodeWin32FallbackCharInput(*self.m_service, 'B')));
        EXPECT_EQ(*codePoint, static_cast<u32>('B'));
        EXPECT_FALSE(DecodeWin32FallbackCharInput(*self.m_service, 0xde00u));
#else
        (void)self;
#endif
    }
}

void VerifyWin32TextInputFixture_SceneFallbackBridgeRejectsForeignServiceAndWrongThread(mut Win32TextInputFixture self){
    native(mut self){
#if defined(NWB_PLATFORM_WINDOWS)
        ASSERT_TRUE(self.m_service->end(self.m_token));
        auto unsupportedResult = CreateTextInputService(self.m_arena.arena, nullptr);
        ASSERT_TRUE(unsupportedResult);
        const GlobalUniquePtr<ITextInputService> unsupported = Move(*unsupportedResult);
        EXPECT_FALSE(DecodeWin32FallbackCharInput(*unsupported, 'A'));

        EXPECT_FALSE(ResetWin32FallbackCharInput(*unsupported));
        Thread worker([&]() {
            EXPECT_FALSE(DecodeWin32FallbackCharInput(*self.m_service, 'A'));
            EXPECT_FALSE(ResetWin32FallbackCharInput(*self.m_service));
        });
        worker.join();
        Expected<u32> codePoint = DecodeWin32FallbackCharInput(*self.m_service, 'C');
        ASSERT_TRUE(codePoint);
        EXPECT_EQ(*codePoint, static_cast<u32>('C'));
#else
        (void)self;
#endif
    }
}

void VerifyWin32TextInputFixture_InsertCharCreatesProvisionalPreeditWithoutCommitAndHonorsNoMoveCaret(mut Win32TextInputFixture self){
    native(mut self){
