const u32 s_UiMultilineTextUtf8OneByteMaxExclusive = 0x80u;
const u32 s_UiMultilineTextUnicodeTab = 0x09u;
const u32 s_UiMultilineTextUnicodeLineFeed = 0x0Au;
const u32 s_UiMultilineTextUnicodeCarriageReturn = 0x0Du;
const u32 s_UiMultilineTextUnicodeSpace = 0x20u;
const u32 s_UiMultilineTextAsciiTilde = 0x7Eu;
const u32 s_UiMultilineTextUnicodeDelete = 0x7Fu;
const u32 s_UiMultilineTextUnicodeNextLine = 0x85u;
const u32 s_UiMultilineTextUnicodeC1Last = 0x9Fu;
const u32 s_UiMultilineTextUtf8C1LeadByte = 0xC2u;

const StringView s_UiMultilineTextNextLine = "\xC2\x85";
const StringView s_UiMultilineTextLineSeparator = "\xE2\x80\xA8";
const StringView s_UiMultilineTextParagraphSeparator = "\xE2\x80\xA9";
const StringView s_UiMultilineTextThreeByteScalar = "\xED\x95\x9C";
const StringView s_UiMultilineTextFourByteScalar = "\xF0\x9F\x92\xBB";
const StringView s_UiMultilineTextBorrowedSourceText = "prefix a\r\nb\tz suffix";

const StringView s_UiNestedPopupBuilderBeforeKey = "before";
const StringView s_UiNestedPopupBuilderApplyKey = "apply";
const StringView s_UiNestedPopupBuilderAfterKey = "after";

const StringView s_UiNestedPopupContextParentKey = "parent";
const StringView s_UiNestedPopupContextChildKey = "child";

const StringView s_UiNestedPopupLifetimeComboKey = "combo";
const StringView s_UiNestedPopupLifetimeComboRowsKey = "rows";


WidgetOptions MakeUiNestedPopupControlOptions(in f32 width){
    WidgetOptions options = WidgetOptions();
    options.width.policy = LayoutSizePolicy::Fixed;
    options.width.value = width;
    options.height.policy = LayoutSizePolicy::Fixed;
    options.height.value = 30.0f;
    return options;
}

b8 BeginUiNestedPopupBuilderParent(mut UiNestedPopupBuilderTests self, in u64 generation){
    return self.begin(generation) && self.m_builder.beginPopup(s_UiFixtureParentPopupKey, self.m_parent, MakeNestedParentPopupOptions());
}

b8 PrepareUiNestedPopupBuilderButtons(mut UiNestedPopupBuilderTests self, in u64 generation){
    if(!BeginUiNestedPopupBuilderParent(self, generation))
        return false;
    self.m_beforeActivated = self.m_builder.button("before", "Before", MakeUiNestedPopupControlOptions(120.0f));
    if(self.m_builder.beginPopup(s_UiFixtureChildPopupKey, self.m_child, MakeNestedChildPopupOptions())){
        self.m_childActivated = self.m_builder.button("apply", "Child", MakeUiNestedPopupControlOptions(120.0f));
        if(!self.m_builder.endPopup())
            return false;
    }
    else if(self.m_context.failed())
        return false;
    self.m_afterActivated = self.m_builder.button("after", "After", MakeUiNestedPopupControlOptions(120.0f));
    return self.m_builder.endPopup() && self.finishRoot();
}

b8 AcceptUiNestedPopupBuilderButtons(mut UiNestedPopupBuilderTests self, in u64 generation){
    return PrepareUiNestedPopupBuilderButtons(self, generation) && self.m_context.commitFrame(generation);
}

b8 PublishUiNestedPopupDeclaration(mut UiNestedPopupContextTests self, in UiNestedPopupContextPopupDeclaration popup){
    HitTarget barrier = HitTarget();
    barrier.rectangle = popup.scope.bounds;
    barrier.clip = popup.scope.viewport;
    if(!self.m_context.addTarget(popup.owner, barrier))
        return false;
    HitTarget action = HitTarget();
    action.rectangle.x = popup.scope.bounds.x + 4.0f;
    action.rectangle.y = popup.scope.bounds.y + 4.0f;
    action.rectangle.width = 24.0f;
    action.rectangle.height = 18.0f;
    action.clip = popup.scope.bounds;
    action.focusable = true;
    action.activatable = true;
    return self.m_context.addTarget(popup.action, action);
}

b8 BeginUiNestedPopupLifetimeParent(mut UiNestedPopupLifetimeTests self, in u64 generation){
    if(!self.begin(generation) || !self.m_builder.beginPopup(s_UiFixtureParentPopupKey, self.m_parent, MakeNestedParentPopupOptions()))
        return false;
    const b8 activated = self.m_builder.button("before", "Before");
    return !activated;
}

b8 FinishUiNestedPopupLifetimeParent(mut UiNestedPopupLifetimeTests self, in u64 generation){
    const b8 activated = self.m_builder.button("after", "After");
    return !activated && self.m_builder.endPopup() && self.m_context.endRoot() && self.m_context.finishFrame() && self.m_context.commitFrame(generation);
}

b8 AcceptUiNestedPopupLifetimePlain(mut UiNestedPopupLifetimeTests self, in u64 generation){
    if(!BeginUiNestedPopupLifetimeParent(self, generation))
        return false;
    self.m_childVisible = self.m_builder.beginPopup(s_UiFixtureChildPopupKey, self.m_child, MakeNestedChildPopupOptions());
    if(self.m_childVisible){
        const b8 activated = self.m_builder.button("apply", "Child");
        if(activated || !self.m_builder.endPopup())
            return false;
    }
    else if(self.m_context.failed())
        return false;
    return FinishUiNestedPopupLifetimeParent(self, generation);
}

b8 AcceptUiNestedPopupLifetimeCombo(mut UiNestedPopupLifetimeTests self, in u64 generation){
    if(!BeginUiNestedPopupLifetimeParent(self, generation))
        return false;
    self.m_result = self.m_builder.comboBox(s_ComboKey, self.m_source, self.m_state, MakeComboFixtureOptions());
    return self.m_result.valid && FinishUiNestedPopupLifetimeParent(self, generation);
}

b8 AcceptUiNestedPopupLifetimeSearch(mut UiNestedPopupLifetimeTests self, in u64 generation){
    if(!BeginUiNestedPopupLifetimeParent(self, generation))
        return false;
    self.m_searchResult = self.m_builder.searchComboBox(s_ComboKey, self.m_searchSource, self.m_search, MakeSearchComboFixtureOptions());
    return self.m_searchResult.combo.valid && FinishUiNestedPopupLifetimeParent(self, generation);
}

b8 AcceptUiNestedPopupLifetimeMenu(mut UiNestedPopupLifetimeTests self, in u64 generation){
    if(!BeginUiNestedPopupLifetimeParent(self, generation))
        return false;
    const b8 activated = self.m_builder.button(s_AnchorKey, "Commands");
    if(activated)
        return false;
    self.m_menuResult = self.m_builder.contextMenu(s_MenuKey, s_AnchorKey, self.m_menuSource, self.m_menu);
    return self.m_menuResult.valid && FinishUiNestedPopupLifetimeParent(self, generation);
}

b8 DeclareUiNestedPopupLifetimeReserved(mut UiNestedPopupLifetimeTests self, in u64 generation, in b8 overflow){
    if(!BeginUiNestedPopupLifetimeParent(self, generation) || !self.m_builder.comboBox(s_ComboKey, self.m_source, self.m_state, MakeComboFixtureOptions()).valid)
        return false;
    const b8 activated = self.m_builder.button(s_AnchorKey, "Commands");
    if(activated || !self.m_builder.contextMenu(s_MenuKey, s_AnchorKey, self.m_menuSource, self.m_menu).valid)
        return false;
    if(!self.m_builder.beginPopup(s_UiFixtureChildPopupKey, self.m_child, MakeNestedChildPopupOptions()) || !self.m_builder.comboBox(s_ComboKey, self.m_source, self.m_childCombo, MakeComboFixtureOptions()).valid)
        return false;
    for(usize index = 0u; index < 3u; ++index){
        if(!self.m_builder.beginPopup("deep", self.m_deeper[index], MakeNestedChildPopupOptions()))
            return false;
    }
    if(overflow)
        return self.m_builder.beginPopup("deep", self.m_deeper[3u], MakeNestedChildPopupOptions());
    const b8 leafActivated = self.m_builder.button("leaf", "Deepest");
    if(leafActivated)
        return false;
    for(usize index = 0u; index < 4u; ++index){
        if(!self.m_builder.endPopup())
            return false;
    }
    const b8 afterActivated = self.m_builder.button("after", "Parent after");
    return !afterActivated && self.m_builder.endPopup() && self.m_context.endRoot() && self.m_context.finishFrame();
}

void ExpectUiNestedPopupLifetimeParentControls(in UiNestedPopupLifetimeTests self){
    const auto before = self.tryTarget(RequireUiWidgetId(self.parentId(), "before"));
    const auto after = self.tryTarget(RequireUiWidgetId(self.parentId(), "after"));
    ASSERT_TRUE(before.has_value());
    ASSERT_TRUE(after.has_value());
    EXPECT_EQ(before.value().popup, after.value().popup);
    EXPECT_EQ(before.value().popup.openGeneration, self.m_parent.openGeneration());
    EXPECT_TRUE(self.m_parent.isOpen());
}
const StringView s_UiNestedPopupLifetimeAnchorKey = "anchor";
const StringView s_UiNestedPopupLifetimeSecondHalfQuery = "Second";
const StringView s_UiNestedPopupLifetimeDeepKey = "deep";
const StringView s_UiNestedPopupLifetimeLeafKey = "leaf";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class UiMultilineTextExpectationCase{
    public StringView source;
    public StringView expected;

    public UiMultilineTextExpectationCase(){
        this.source = "";
        this.expected = "";
    }

    public UiMultilineTextExpectationCase(in StringView inSource, in StringView inExpected){
        this.source = inSource;
        this.expected = inExpected;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void ExpectUiMultilineTextNormalizedError(mut UiMultilineTextGlobalArena arena, in StringView text, in usize maxBytes, in EditTextStatusEnum status){
    const auto normalized = NormalizeMultilineText(arena, text, maxBytes);
    EXPECT_FALSE(normalized.has_value());
    if(!normalized.has_value())
        EXPECT_EQ(normalized.error(), status);
}

Rect MakeUiMultilinePopupRect(in f32 x, in f32 y, in f32 width, in f32 height){
    Rect rect = Rect();
    rect.x = x;
    rect.y = y;
    rect.width = width;
    rect.height = height;
    return rect;
}

Point MakeUiMultilinePopupPoint(in f32 x, in f32 y){
    Point point = Point();
    point.x = x;
    point.y = y;
    return point;
}

Insets MakeUiMultilineViewInsets(in f32 left, in f32 top, in f32 right, in f32 bottom){
    Insets insets = Insets();
    insets.left = left;
    insets.top = top;
    insets.right = right;
    insets.bottom = bottom;
    return insets;
}

Color MakeUiMultilineViewColor(in f32 r, in f32 g, in f32 b, in f32 a){
    Color color = Color();
    color.r = r;
    color.g = g;
    color.b = b;
    color.a = a;
    return color;
}

PopupToken MakeUiNestedPopupContextToken(in WidgetId widget, in u64 declarationGeneration, in u64 instanceGeneration, in u64 openGeneration){
    PopupToken token = PopupToken();
    token.widget = widget;
    token.declarationGeneration = declarationGeneration;
    token.instanceGeneration = instanceGeneration;
    token.openGeneration = openGeneration;
    return token;
}

InputEvent MakeUiNestedPopupContextPointerEvent(in InputEventTypeEnum eventType, in f32 x, in f32 y){
    InputEvent event = InputEvent();
    event.type = eventType;
    event.position.x = x;
    event.position.y = y;
    return event;
}


