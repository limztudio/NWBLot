#include <impl/ecs_render/kernel/graphics_prefix_timing_ticket.adhd>

#include <impl/ecs_render/mesh/instance_gpu_data.adhd>
#include <impl/ecs_render/mesh/mesh_system.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class MeshViewSetupGraphTask{
    private mut GraphicsRuntime m_graphics;
    private mut Optional<GpuTimingMeasure> m_asyncPrefixTiming;
    private in GraphicsPrefixTimingTicket m_timingTicket;
    private in b8 m_asyncPrefixTimingSpansOnePacket;
    private in GpuTaskId m_shadowVisibilityTask;

    public MeshViewSetupGraphTask(mut GraphicsRuntime graphics, mut Optional<GpuTimingMeasure> asyncPrefixTiming, in GraphicsPrefixTimingTicket timingTicket, in b8 asyncPrefixTimingSpansOnePacket, in GpuTaskId shadowVisibilityTask){
        this.m_graphics = graphics;
        this.m_asyncPrefixTiming = asyncPrefixTiming;
        this.m_timingTicket = timingTicket;
        this.m_asyncPrefixTimingSpansOnePacket = asyncPrefixTimingSpansOnePacket;
        this.m_shadowVisibilityTask = shadowVisibilityTask;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(); }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const;
}

class MeshViewUploadCommitGraphTask{
    private mut RendererMeshSystem m_meshSystem;
    private MeshViewGpuData m_viewState;
    private b8 m_uploadRequired;
    private mut b8 m_ready;

    public MeshViewUploadCommitGraphTask(mut RendererMeshSystem meshSystem, in MeshViewGpuData viewState, in b8 uploadRequired, mut b8 ready){
        this.m_meshSystem = meshSystem;
        this.m_viewState = viewState;
        this.m_uploadRequired = uploadRequired;
        this.m_ready = ready;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(); }
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        this.m_ready = true;
        return true;
    }
    public void accepted(in QueueSubmissionToken token){
        if(this.m_uploadRequired)
            this.m_meshSystem.confirmMeshViewBufferUpload(this.m_viewState);
    }
    public void discarded(){ this.m_ready = false; }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

