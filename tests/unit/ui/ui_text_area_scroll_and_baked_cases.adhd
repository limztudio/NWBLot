void VerifyUiTextAreaStateTests_NavigationRejectsAnotherOwnersSnapshotBeforeAnyEdits(){
    TextAreaState first = TextAreaState();
    TextAreaState second = TextAreaState();
    EXPECT_FALSE(second.navigation().matches(first.navigation().snapshot()));
}

void VerifyUiTextAreaStateTests_ViewportIntentAwayAndBackRetiresAnEarlierLoan(){
    TextAreaState state = TextAreaState();
    ASSERT_TRUE(state.scrollTo(Point(20.0f, 30.0f)));
    const u64 accepted = state.revision();
    ASSERT_TRUE(state.scrollTo(Point(40.0f, 60.0f)));
    ASSERT_TRUE(state.scrollTo(Point(20.0f, 30.0f)));
    EXPECT_GT(state.revision(), accepted);
    EXPECT_FLOAT_EQ(state.scroll().x, 20.0f);
    EXPECT_FLOAT_EQ(state.scroll().y, 30.0f);
    const u64 identical = state.revision();
    ASSERT_TRUE(state.scrollTo(state.scroll()));
    EXPECT_GT(state.revision(), identical);
}

void VerifyUiTextAreaStateTests_InvalidViewportPreservesBothAxesAndBorrowEpoch(){
    TextAreaState state = TextAreaState();
    ASSERT_TRUE(state.scrollTo(Point(20.0f, 30.0f)));
    const u64 accepted = state.revision();
    const f32 infinity = bit_cast<f32>(s_UiTextScrollPosInfF32Bits);
    const f32 nan = bit_cast<f32>(s_UiTextScrollQuietNaNF32Bits);
    Array<Point, 5u> invalid;
    invalid[0u] = Point(-1.0f, 0.0f);
    invalid[1u] = Point(0.0f, -1.0f);
    invalid[2u] = Point(infinity, 0.0f);
    invalid[3u] = Point(0.0f, infinity);
    invalid[4u] = Point(nan, nan);
    for(in Point point : invalid){
        EXPECT_FALSE(state.scrollTo(point));
        EXPECT_EQ(state.revision(), accepted);
        EXPECT_FLOAT_EQ(state.scroll().x, 20.0f);
        EXPECT_FLOAT_EQ(state.scroll().y, 30.0f);
    }
}

void VerifyUiTextAreaStateTests_ResetRetiresExternalAndNavigationEpochsWithoutChangingIdentity(){
    TextAreaState state = TextAreaState();
    const u64 identity = state.instanceGeneration();
    ASSERT_TRUE(state.scrollTo(Point(20.0f, 30.0f)));
    const u64 accepted = state.revision();
    const EditNavigationSnapshot navigation = state.navigation().snapshot();
    state.reset();
    EXPECT_EQ(state.instanceGeneration(), identity);
    EXPECT_GT(state.revision(), accepted);
    EXPECT_FALSE(state.navigation().matches(navigation));
    EXPECT_FLOAT_EQ(state.scroll().x, 0.0f);
    EXPECT_FLOAT_EQ(state.scroll().y, 0.0f);
    const u64 empty = state.revision();
    state.reset();
    EXPECT_GT(state.revision(), empty);
}


