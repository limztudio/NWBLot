////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class UnfocusedLoopRenderPass : IRenderPass{
    [cpp_base(IRenderPass, graphics)]
    public UnfocusedLoopRenderPass(mut GraphicsRuntime graphics){}
    public b8 shouldRenderUnfocused() override{ return true; }
}

class CollectionTestPass : IRenderPass{
    public u32 validationCount = 0u;
    public u32 invalidationCount = 0u;
    public b8 valid = true;

    [cpp_base(IRenderPass, graphics)]
    public CollectionTestPass(mut GraphicsRuntime graphics){}

    public b8 validateResources(in u32 width, in u32 height, in u32 samples) override{
        ++this.validationCount;
        return this.valid;
    }

    public void invalidateResources() override{ ++this.invalidationCount; }
}

class ClampObserverFailure{}

class ThrowingClampLogger : Utf8LogSink{
    public u32 clampCount = 0u;

    [cpp_unwind]
    public void receive(in StringView text, in LogType kind) override{
        if(text.find("Frame Win32 client size clamped") == usize.max)
            return;
        ++this.clampCount;
        ThrowTestException<ClampObserverFailure>(ClampObserverFailure());
    }
}

class LoopLogger : Utf8LogSink{
    public void receive(in StringView text, in LogType kind) override{
        if(kind >= LogType::Warning)
            PrintFrameLog(text);
    }
}

class FrameUpdateObserver{
    public mut Frame frame;
    public u32 callbacks = 0u;

    public FrameUpdateObserver(mut Frame target){ this.frame = target; }
    public b8 update(in f32 delta){
        ++this.callbacks;
        this.frame.requestQuit();
        return true;
    }
}

void DrainQuitMessages(){
    while(RemoveQuitMessage()){}
}

class QuitMessageGuard : NoCopy{
    public QuitMessageGuard(){ DrainQuitMessages(); }
    public ~QuitMessageGuard(){ DrainQuitMessages(); }
}

class ScopedUnfocusedPass : NoCopy{
    private mut GraphicsRuntime m_graphics;
    private mut IRenderPass m_pass;
    private b8 m_registered;

    public ScopedUnfocusedPass(mut GraphicsRuntime graphics, mut IRenderPass pass, in b8 enabled){
        this.m_graphics = graphics;
        this.m_pass = pass;
        this.m_registered = enabled;
        if(enabled)
            graphics.addRenderPassToBack(pass);
    }
    public ~ScopedUnfocusedPass(){
        if(this.m_registered)
            this.m_graphics.removeRenderPass(this.m_pass);
    }
}

String NativeFailure(in StringView message, in u32 code){
    String reason;
    StringAppendFormat(reason, "{}; native_code={}", message, code);
    return reason;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


GpuDescriptorHeapAbi MakeShaderlessHeapAbi(){
    GpuDescriptorHeapAbi heapAbi = GpuDescriptorHeapAbi();
    heapAbi.resourceSetIndex = 0u;
    heapAbi.samplerSetIndex = 1u;
    heapAbi.accelStructSetIndex = 2u;
    heapAbi.sampledImageBinding = 0u;
    heapAbi.storageImageBinding = 1u;
    heapAbi.sampledBufferBinding = 2u;
    heapAbi.storageBufferBinding = 3u;
    heapAbi.uniformBufferBinding = 4u;
    heapAbi.sampledImage2DArrayBinding = 5u;
    heapAbi.sampledImage3DBinding = 6u;
    heapAbi.sampledImage2DArrayUintBinding = 7u;
    heapAbi.sampledImageCubeBinding = 8u;
    heapAbi.samplerBinding = 0u;
    heapAbi.accelStructBinding = 0u;
    return heapAbi;
}

void CheckRenderPassCollection(mut GraphicsRuntime graphics){
    HeapStorage storage(s_OneOffNameTestsFrameRenderPassCollection);
    RenderPassCollection passes(storage);
    CollectionTestPass first(graphics);
    CollectionTestPass second(graphics);
    passes.addToBack(first, 64u, 64u, 1u);
    passes.addToBack(second, 64u, 64u, 1u);
    first.validationCount = 0u;
    second.validationCount = 0u;
    first.valid = false;
    EXPECT_FALSE(passes.validateResources(64u, 64u, 1u));
    EXPECT_EQ(first.validationCount, 1u);
    EXPECT_EQ(second.validationCount, 1u);

    first.valid = true;
    passes.addToBack(first, 64u, 64u, 1u);
    ASSERT_EQ(RenderPassCount(passes), 2u);
    EXPECT_TRUE(TestValueAddress(FirstRenderPass(passes)) == TestValueAddress(second));
    EXPECT_TRUE(TestValueAddress(LastRenderPass(passes)) == TestValueAddress(first));
    passes.remove(first);
    EXPECT_EQ(first.invalidationCount, 1u);
    EXPECT_EQ(RenderPassCount(passes), 1u);
}

void CheckInactiveLoop(in b8 renderUnfocused){
    const GpuDescriptorHeapAbi heapAbi = MakeShaderlessHeapAbi();
    CpuTaskSchedulerConfig cpuTasks = CpuTaskSchedulerConfig();
    cpuTasks.workerCount = 1u;

    QuitMessageGuard quitMessages = QuitMessageGuard();
    const i32 screenWidth = ScreenMetric(s_ScreenWidthMetric);
    const i32 screenHeight = ScreenMetric(s_ScreenHeightMetric);
    if(screenWidth <= 0 || screenHeight <= 0)
        SkipTest("Native desktop unavailable for the inactive-window loop");
    if(!PerMonitorDpiEnabled() && !EnablePerMonitorDpi())
        SkipTest(NativeFailure("Native DPI admission unavailable for the inactive-window loop", NativeError()));

    const WinInstance instance = CurrentInstance();
    ASSERT_TRUE(HasInstance(instance));
    LoopLogger logger = LoopLogger();
    LoggerRegistrationGuard loggerGuard(logger, LoggerBreakPolicy::ReportOnly);
    Frame frame(instance, 64u, 64u, cpuTasks);
    mut GraphicsRuntime graphics = frame.graphics();
    ASSERT_TRUE(graphics.setBindlessHeapAbi(heapAbi));
    if(!frame.init())
        SkipTest(NativeFailure("Hidden Win32 frame or selected graphics startup unsupported", NativeError()));
    const WinWindow window = FrameWindow(frame);
    ASSERT_TRUE(HasWindow(window));
    ASSERT_FALSE(WindowVisible(window));
    DeactivateFrame(frame);
    if(renderUnfocused)
        CheckRenderPassCollection(graphics);
    UnfocusedLoopRenderPass pass(graphics);
    ScopedUnfocusedPass registered(graphics, pass, renderUnfocused);
    ASSERT_EQ(graphics.shouldRenderUnfocused(), renderUnfocused);
    FrameUpdateObserver callback(frame);
    SetFrameUpdateObserver(frame, callback);
    const u32 mainThread = NativeThreadId();
    TestAtomic<b8> watchdogFired(false);
    TestAtomic<u32> watchdogPostError(0u);
    JoiningThread watchdog(lambda[in mainThread, in window, mut watchdogFired, mut watchdogPostError](in StopToken stop) -> void{
        const u64 deadline = TickMilliseconds() + s_FrameTestInactiveLoopWatchdogMS;
        while(!stop.stop_requested() && TickMilliseconds() < deadline)
            SleepMS(s_FrameTestWatchdogPollMS);
        if(stop.stop_requested())
            return;
        watchdogFired.store(true, MemoryOrder::relaxed);
        if(!PostQuitToThread(mainThread)){
            watchdogPostError.store(NativeError(), MemoryOrder::relaxed);
            if(!PostCloseToWindow(window))
                TerminateInvariant();
        }
    });
    const b8 loopSucceeded = frame.mainLoop();
    watchdog.request_stop();
    watchdog.join();
    EXPECT_TRUE(loopSucceeded);
    EXPECT_EQ(watchdogPostError.load(MemoryOrder::relaxed), 0u);
    EXPECT_EQ(callback.callbacks, cast<u32>(renderUnfocused));
    EXPECT_EQ(watchdogFired.load(MemoryOrder::relaxed), !renderUnfocused);
    EXPECT_EQ(graphics.getFrameIndex(), 0u);
}

void VerifyFrameWindowDimensions_LogicalDimensionsRemainPositiveAtLargestNativeScale(){
    EXPECT_EQ(LogicalDimensionForPixels(2u, i32.max), 1);
    EXPECT_EQ(LogicalDimensionForPixels(u16.max, i32.max), 1);
    EXPECT_EQ(LogicalDimensionForPixels(u16.max, 1), cast<i32>(u16.max));
    EXPECT_EQ(LogicalDimensionForPixels(5u, 2), 3);
    EXPECT_EQ(LogicalDimensionForPixels(0u, i32.max), 1);
    EXPECT_EQ(LogicalDimensionForPixels(5u, 0), 5);
}

[cpp_unwind]
void VerifyFrameWin32Lifecycle_ThrowingClampObserverReleasesNativeClassBeforeLaterInitialization(){
    CpuTaskSchedulerConfig cpuTasks = CpuTaskSchedulerConfig();
    cpuTasks.workerCount = 1u;

    const i32 screenWidth = ScreenMetric(s_ScreenWidthMetric);
    const i32 screenHeight = ScreenMetric(s_ScreenHeightMetric);
    if(screenWidth <= 0 || screenHeight <= 0 || screenWidth >= cast<i32>(u16.max) || screenHeight >= cast<i32>(u16.max)){
        String reason;
        StringAppendFormat(reason, "No bounded oversize client clamp on {}x{} desktop", screenWidth, screenHeight);
        SkipTest(reason);
    }
    if(!PerMonitorDpiEnabled() && !EnablePerMonitorDpi())
        SkipTest(NativeFailure("Native desktop DPI admission unavailable for class unwind", NativeError()));
    const WinInstance instance = CurrentInstance();
    ASSERT_TRUE(HasInstance(instance));
    ThrowingClampLogger logger = ThrowingClampLogger();
    LoggerRegistrationGuard loggerGuard(logger);
    for(u32 attempt = 0u; attempt < s_FrameTestInitializationAttempts; ++attempt){
        const WindowClassResult before = QueryFrameClass(instance);
        ASSERT_FALSE(before.registered);
        ASSERT_EQ(before.error, s_ClassDoesNotExist);
        const i32 result = InvokeTerminalEntry<ClampObserverFailure>(
            lambda[in instance, in cpuTasks]() -> i32{
                Frame frame(instance, u16.max, u16.max, cpuTasks);
                if(frame.init())
                    return 0;
                return 1;
            },
            lambda[](in ClampObserverFailure failure) -> i32{ return s_FrameTestClampObserverFailure; },
            lambda[]() -> i32{ return s_FrameTestUnexpectedFailure; }
        );
        ASSERT_EQ(result, s_FrameTestClampObserverFailure);
        ASSERT_EQ(logger.clampCount, attempt + 1u);
        const WindowClassResult after = QueryFrameClass(instance);
        EXPECT_FALSE(after.registered);
        EXPECT_EQ(after.error, s_ClassDoesNotExist);
    }
}

void VerifyFrameWin32Lifecycle_InactiveWindowRunsAnUpdateForAnUnfocusedRenderPass(){
    CheckInactiveLoop(true);
}

void VerifyFrameWin32Lifecycle_InactiveWindowWithoutUnfocusedRenderPassWaitsForQuit(){
    CheckInactiveLoop(false);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_ADHD_GTEST(FrameWin32Lifecycle, ThrowingClampObserverReleasesNativeClassBeforeLaterInitialization, VerifyFrameWin32Lifecycle_ThrowingClampObserverReleasesNativeClassBeforeLaterInitialization)
NWB_ADHD_GTEST(FrameWin32Lifecycle, InactiveWindowRunsAnUpdateForAnUnfocusedRenderPass, VerifyFrameWin32Lifecycle_InactiveWindowRunsAnUpdateForAnUnfocusedRenderPass)
NWB_ADHD_GTEST(FrameWin32Lifecycle, InactiveWindowWithoutUnfocusedRenderPassWaitsForQuit, VerifyFrameWin32Lifecycle_InactiveWindowWithoutUnfocusedRenderPassWaitsForQuit)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_ADHD_GTEST(FrameWindowDimensions, LogicalDimensionsRemainPositiveAtLargestNativeScale, VerifyFrameWindowDimensions_LogicalDimensionsRemainPositiveAtLargestNativeScale)


