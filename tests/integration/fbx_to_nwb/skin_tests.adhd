using DefaultTestArena = Tests::TestArena<>;
using ScratchArena = Core::Alloc::ScratchArena;
using LoggerRegistrationGuard = Core::Common::LoggerRegistrationGuard;
using FbxToNwb::FbxMeshSkinningSummary;
using FbxToNwb::ImportOptions;
using FbxToNwb::MeshInstance;
using FbxToNwb::HasUsableSourceTriangleArea;
using FbxToNwb::HasSourceMeshStreamValueCapacity;
using FbxToNwb::TryComputeMeshRefreshReplacementCapacity;
using FbxToNwb::TryComputeTriangleIndexScratchCapacity;
using FbxToNwb::ValidateFbxSkinPositionCount;
using FbxToNwb::TryAccumulateFbxSelectedTriangleCorners;
using FbxToNwb::ValidateFbxMeshAttributes;
using FbxToNwb::ValidateFbxSkinDeformerCount;
using FbxToNwb::ValidateFbxOutputMode;
using FbxToNwb::ValidateFbxNewSkeletonJointCapacity;
using FbxToNwb::AccumulateFbxJointCapacity;
using FbxToNwb::ValidateFbxSkinLogicalVertex;
using FbxToNwb::IsValidFbxImportScale;
using FbxToNwb::IsValidFbxTriangleAreaEpsilon;
using FbxToNwb::s_MaxMeshReplacementCount;
using FbxToNwb::s_MaxSkeletonJointCount;
using ExportContext = FbxToNwb::FbxSkinDetail::ExportContext;
using Impl::s_MeshMissingStreamIndex;
using Impl::s_MeshletTriangleIndexCount;
inline constexpr auto s_ReportOnly = Core::Common::LoggerBreakPolicy::ReportOnly;
inline constexpr auto s_OutputAssetSkeleton = FbxToNwb::OutputAssetType::Skeleton;
inline constexpr auto s_OutputAssetMesh = FbxToNwb::OutputAssetType::Mesh;
inline constexpr b8 s_OccurWarning = FOUNDATION_OCCUR_WARNING != 0;
inline constexpr f64 s_QuietNaNF64 = Limit<f64>::s_QuietNaN;
inline constexpr f64 s_InfinityF64 = Limit<f64>::s_Infinity;
inline constexpr f64 s_UnitPlusUlpF64 = 1.0 + 0x1p-52;
inline constexpr f64 s_MinNormalF64 = 0x1p-1022;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_ErrMissingPositions = "mesh is missing positions";
const StringView s_ErrImportedNormalMode = "imported normal mode";
const StringView s_ErrSeparateAssetsOnlyValid = "--separate-assets is only valid";
const StringView s_ErrSplitSkeletonSkinPayload = "mesh output cannot write split skeleton/skin payload";
const StringView s_ErrRequiresSkinnedSourceMesh = "requires a skinned source mesh";
const StringView s_WarnMixedSkinning = "mixed static and skinned source meshes";

void VerifyFbxMesh_RejectsNonFiniteAndThresholdTriangleAreas(){
    EXPECT_FALSE(HasUsableSourceTriangleArea(s_QuietNaNF64, 1.0));
    EXPECT_FALSE(HasUsableSourceTriangleArea(s_InfinityF64, 1.0));
    EXPECT_FALSE(HasUsableSourceTriangleArea(-s_InfinityF64, 1.0));
    EXPECT_FALSE(HasUsableSourceTriangleArea(1.0, 1.0));
    EXPECT_TRUE(HasUsableSourceTriangleArea(1.0, s_QuietNaNF64));
    EXPECT_TRUE(HasUsableSourceTriangleArea(s_UnitPlusUlpF64, 1.0));
}

void VerifyFbxMesh_RejectsSourceStreamAndReplacementCapacityOverflow(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_ReportOnly);
    const usize missingIndex = cast<usize>(s_MeshMissingStreamIndex);
    const usize maxValue = usize.max;
    const usize factor = s_MaxMeshReplacementCount;
    EXPECT_TRUE(HasSourceMeshStreamValueCapacity(missingIndex - 1u));
    EXPECT_FALSE(HasSourceMeshStreamValueCapacity(missingIndex));
    const Expected<usize> capacity = TryComputeMeshRefreshReplacementCapacity(maxValue / factor);
    ASSERT_TRUE(capacity.has_value());
    EXPECT_EQ(capacity.value(), (maxValue / factor) * factor);
    EXPECT_FALSE(TryComputeMeshRefreshReplacementCapacity(maxValue / factor + 1u).has_value());
    const usize triangleFactor = s_MeshletTriangleIndexCount;
    const Expected<usize> triangleCapacity = TryComputeTriangleIndexScratchCapacity(maxValue / triangleFactor);
    ASSERT_TRUE(triangleCapacity.has_value());
    EXPECT_EQ(triangleCapacity.value(), (maxValue / triangleFactor) * triangleFactor);
    EXPECT_FALSE(TryComputeTriangleIndexScratchCapacity(maxValue / triangleFactor + 1u).has_value());
    EXPECT_EQ(logger.errorCount(), 2u);
}

void VerifyFbxMesh_RejectsMismatchedSkinPositionCounts(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_ReportOnly);
    EXPECT_FALSE(ValidateFbxSkinPositionCount(1u, 0u));
    EXPECT_FALSE(ValidateFbxSkinPositionCount(0u, 1u));
    EXPECT_TRUE(ValidateFbxSkinPositionCount(0u, 0u));
    EXPECT_EQ(logger.errorCount(), 2u);
}

void VerifyFbxMesh_TriangleCornerAccumulationPreservesCountOnOverflow(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_ReportOnly);
    usize corners = usize.max - 2u;
    EXPECT_FALSE(TryAccumulateFbxSelectedTriangleCorners(1u, corners));
    EXPECT_EQ(corners, usize.max - 2u);
    corners = usize.max - 3u;
    EXPECT_TRUE(TryAccumulateFbxSelectedTriangleCorners(1u, corners));
    EXPECT_EQ(corners, usize.max);
    EXPECT_EQ(logger.errorCount(), 1u);
}

void VerifyFbxMesh_MissingAttributesAndDeformerCountsPreserveFailureOrder(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_ReportOnly);
    EXPECT_FALSE(ValidateFbxMeshAttributes(false, true, false));
    EXPECT_TRUE(SawCapturedError(logger, s_ErrMissingPositions));
    EXPECT_FALSE(SawCapturedError(logger, s_ErrImportedNormalMode));
    EXPECT_FALSE(ValidateFbxMeshAttributes(true, true, false));
    EXPECT_TRUE(SawCapturedError(logger, s_ErrImportedNormalMode));
    EXPECT_TRUE(ValidateFbxMeshAttributes(true, false, false));
    EXPECT_FALSE(ValidateFbxSkinDeformerCount(0u));
    EXPECT_FALSE(ValidateFbxSkinDeformerCount(2u));
    EXPECT_EQ(logger.errorCount(), 4u);
}

void VerifyFbxMesh_OutputModeValidationPreservesFailureOrder(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_ReportOnly);
    EXPECT_FALSE(ValidateFbxOutputMode(s_OutputAssetSkeleton, true, false, false, false, false));
    EXPECT_TRUE(SawCapturedError(logger, s_ErrSeparateAssetsOnlyValid));
    EXPECT_FALSE(SawCapturedError(logger, s_ErrRequiresSkinnedSourceMesh));
    EXPECT_FALSE(ValidateFbxOutputMode(s_OutputAssetMesh, false, false, false, true, false));
    EXPECT_TRUE(SawCapturedError(logger, s_ErrSplitSkeletonSkinPayload));
    EXPECT_FALSE(ValidateFbxOutputMode(s_OutputAssetSkeleton, false, false, false, false, false));
    EXPECT_TRUE(SawCapturedError(logger, s_ErrRequiresSkinnedSourceMesh));
    EXPECT_EQ(logger.errorCount(), 3u);
}

void VerifyFbxSkin_JointCapacityRejectsOverflowAndSaturatesReservations(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_ReportOnly);
    EXPECT_TRUE(ValidateFbxNewSkeletonJointCapacity(s_MaxSkeletonJointCount - 1u));
    EXPECT_FALSE(ValidateFbxNewSkeletonJointCapacity(s_MaxSkeletonJointCount));
    EXPECT_EQ(AccumulateFbxJointCapacity(s_MaxSkeletonJointCount - 1u, 0u), s_MaxSkeletonJointCount - 1u);
    EXPECT_EQ(AccumulateFbxJointCapacity(s_MaxSkeletonJointCount - 1u, usize.max), s_MaxSkeletonJointCount);
    EXPECT_EQ(AccumulateFbxJointCapacity(s_MaxSkeletonJointCount, 1u), s_MaxSkeletonJointCount);
    EXPECT_EQ(logger.errorCount(), 1u);
}

void VerifyFbxSkin_RejectsLogicalVertexAtAndBeyondWeightList(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_ReportOnly);
    EXPECT_FALSE(ValidateFbxSkinLogicalVertex(0u, 0u));
    EXPECT_TRUE(ValidateFbxSkinLogicalVertex(4u, 5u));
    EXPECT_FALSE(ValidateFbxSkinLogicalVertex(5u, 5u));
    EXPECT_EQ(logger.errorCount(), 2u);
}

void VerifyFbxOptions_RejectsNonFiniteAndBoundaryScaleOrEpsilon(){
    EXPECT_FALSE(IsValidFbxImportScale(0.0));
    EXPECT_FALSE(IsValidFbxImportScale(-0.0));
    EXPECT_FALSE(IsValidFbxImportScale(s_QuietNaNF64));
    EXPECT_FALSE(IsValidFbxImportScale(s_InfinityF64));
    EXPECT_TRUE(IsValidFbxImportScale(s_MinNormalF64));
    EXPECT_TRUE(IsValidFbxTriangleAreaEpsilon(0.0));
    EXPECT_TRUE(IsValidFbxTriangleAreaEpsilon(-0.0));
    EXPECT_FALSE(IsValidFbxTriangleAreaEpsilon(-s_MinNormalF64));
    EXPECT_FALSE(IsValidFbxTriangleAreaEpsilon(s_QuietNaNF64));
    EXPECT_FALSE(IsValidFbxTriangleAreaEpsilon(s_InfinityF64));
}

void VerifyFbxOptions_MixedSkinningSelectionIsRejected(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_ReportOnly);
    FbxMeshSkinningSummary summary = FbxMeshSkinningSummary();
    const Expected<b8> empty = summary.resolve();
    ASSERT_TRUE(empty.has_value());
    EXPECT_FALSE(empty.value());
    summary.observe(false);
    const Expected<b8> staticOnly = summary.resolve();
    ASSERT_TRUE(staticOnly.has_value());
    EXPECT_FALSE(staticOnly.value());
    summary.observe(true);
    EXPECT_FALSE(summary.resolve().has_value());
    if(s_OccurWarning)
        EXPECT_TRUE(SawCapturedMessage(logger, s_WarnMixedSkinning));
    EXPECT_EQ(logger.errorCount(), 0u);
}

void VerifyFbxSkin_RejectsFiniteDoubleMatricesThatCannotBeStoredAsFloats(){
    DefaultTestArena arena = DefaultTestArena();
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_ReportOnly);
    ScratchArena scratchArena(Name(s_FbxSkinFixtureNameTestsFbxSkin));
    ImportOptions options = ImportOptions();
    options.bakeTransforms = false;
    options.scale = 1.0;
    MeshInstance instance = MeshInstance();
    for(u32 testCase = 0u; testCase < 3u; ++testCase){
        ExportContext context(scratchArena);
        b8 built = true;
        native(in instance, in options, in testCase, mut scratchArena, mut context, mut built){
            static_assert(sizeof(ufbx_real) == sizeof(f64));
            ufbx_node bone{};
            ufbx_skin_cluster cluster{};
            cluster.bone_node = &bone;
            cluster.geometry_to_bone.m00 = 1.0;
            cluster.geometry_to_bone.m11 = 1.0;
            cluster.geometry_to_bone.m22 = 1.0;
            if(testCase == 0u)
                cluster.geometry_to_bone.m03 = 1e40;
            else if(testCase == 1u){
                cluster.geometry_to_bone.m00 = 1e-40;
                cluster.geometry_to_bone.m11 = 1e20;
                cluster.geometry_to_bone.m22 = 1e20;
            }
            else{
                cluster.geometry_to_bone.m00 = 1e200;
                cluster.geometry_to_bone.m11 = 1e200;
                cluster.geometry_to_bone.m22 = 1e200;
            }
            ufbx_skin_cluster* clusters[] = { &cluster };
            ufbx_skin_deformer skin{};
            skin.clusters.data = clusters;
            skin.clusters.count = 1u;
            built = NWB::FbxToNwb::FbxSkinDetail::BuildClusterJointMap(instance, options, skin, scratchArena, context).has_value();
        }
        EXPECT_FALSE(built);
        EXPECT_TRUE(context.joints.empty());
        EXPECT_TRUE(context.bindPoseMatrices.empty());
        EXPECT_TRUE(context.inverseBindMatrices.empty());
        EXPECT_TRUE(context.jointLookup.empty());
    }
    EXPECT_GE(logger.errorCount(), 3u);
}

void VerifyFbxSkin_RejectsMismatchedOrNonFiniteSkeletonMatrices(){
    DefaultTestArena arena = DefaultTestArena();
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_ReportOnly);
    ScratchArena scratchArena(Name(s_FbxSkinFixtureNameTestsFbxSkeleton));
    Array<b8, 4u> accepted = Array<b8, 4u>();
    native(mut scratchArena, mut accepted){
        ufbx_node root{};
        ufbx_node* joints[] = { &root };
        NWB::FbxToNwb::JointMatrix bind = MatrixIdentity<NWB::FbxToNwb::JointMatrix>();
        NWB::FbxToNwb::JointMatrix inverse = bind;
        using NWB::FbxToNwb::AssetWriterSkeletonDetail::BuildSkeletonOutputData;

        accepted[0u] = BuildSkeletonOutputData(joints, {}, { &inverse, 1u }, scratchArena).has_value();
        accepted[1u] = BuildSkeletonOutputData(joints, { &bind, 1u }, {}, scratchArena).has_value();
        bind._11 = Limit<f32>::s_Infinity;
        accepted[2u] = BuildSkeletonOutputData(joints, { &bind, 1u }, { &inverse, 1u }, scratchArena).has_value();
        bind = MatrixIdentity<NWB::FbxToNwb::JointMatrix>();
        inverse._11 = Limit<f32>::s_QuietNaN;
        accepted[3u] = BuildSkeletonOutputData(joints, { &bind, 1u }, { &inverse, 1u }, scratchArena).has_value();
    }
    for(usize index = 0u; index < accepted.size(); ++index)
        EXPECT_FALSE(accepted[index]);
    EXPECT_GE(logger.errorCount(), 4u);
}

NWB_ADHD_GTEST(FbxMesh, RejectsNonFiniteAndThresholdTriangleAreas, VerifyFbxMesh_RejectsNonFiniteAndThresholdTriangleAreas)
NWB_ADHD_GTEST(FbxMesh, RejectsSourceStreamAndReplacementCapacityOverflow, VerifyFbxMesh_RejectsSourceStreamAndReplacementCapacityOverflow)
NWB_ADHD_GTEST(FbxMesh, RejectsMismatchedSkinPositionCounts, VerifyFbxMesh_RejectsMismatchedSkinPositionCounts)
NWB_ADHD_GTEST(FbxMesh, TriangleCornerAccumulationPreservesCountOnOverflow, VerifyFbxMesh_TriangleCornerAccumulationPreservesCountOnOverflow)
NWB_ADHD_GTEST(FbxMesh, MissingAttributesAndDeformerCountsPreserveFailureOrder, VerifyFbxMesh_MissingAttributesAndDeformerCountsPreserveFailureOrder)
NWB_ADHD_GTEST(FbxMesh, OutputModeValidationPreservesFailureOrder, VerifyFbxMesh_OutputModeValidationPreservesFailureOrder)
NWB_ADHD_GTEST(FbxSkin, JointCapacityRejectsOverflowAndSaturatesReservations, VerifyFbxSkin_JointCapacityRejectsOverflowAndSaturatesReservations)
NWB_ADHD_GTEST(FbxSkin, RejectsLogicalVertexAtAndBeyondWeightList, VerifyFbxSkin_RejectsLogicalVertexAtAndBeyondWeightList)
NWB_ADHD_GTEST(FbxOptions, RejectsNonFiniteAndBoundaryScaleOrEpsilon, VerifyFbxOptions_RejectsNonFiniteAndBoundaryScaleOrEpsilon)
NWB_ADHD_GTEST(FbxOptions, MixedSkinningSelectionIsRejected, VerifyFbxOptions_MixedSkinningSelectionIsRejected)
NWB_ADHD_GTEST(FbxSkin, RejectsFiniteDoubleMatricesThatCannotBeStoredAsFloats, VerifyFbxSkin_RejectsFiniteDoubleMatricesThatCannotBeStoredAsFloats)
NWB_ADHD_GTEST(FbxSkin, RejectsMismatchedOrNonFiniteSkeletonMatrices, VerifyFbxSkin_RejectsMismatchedOrNonFiniteSkeletonMatrices)


