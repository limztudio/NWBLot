#include "router_target_staging.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void RetireRouterQueuedReleases(
    in Span<InputEvent> events,
    in InputSource hoverPointerSource,
    mut Vector<CommandSource> commandSources,
    mut Vector<PointerSource> pointerSources,
    mut Vector<PointerGestureRecord> pointerGestures,
    mut u64 inOutActiveGestureSequence,
    mut b8 inOutPointerSubmitArmed,
    mut TargetOwner inOutSecondaryOwner,
    mut WidgetId inOutCapture,
    mut PopupToken inOutCapturePopup,
    mut u64 inOutCaptureDeclaration,
    mut ControlToken inOutCaptureControl,
    mut b8 inOutPrimaryDown,
    mut b8 inOutPointerSequenceConsumed,
    mut b8 inOutSecondaryDown,
    mut b8 inOutSecondarySequenceConsumed,
    mut InputSource inOutActivePointerSource,
    mut b8 outUnfinishedHoverSource
){
    outUnfinishedHoverSource = false;
    for(in InputEvent event : events){
        if(event.type == InputEventType::CommandUp){
            const Expected<usize> sourceIndex = FindRouterCommandSourceIndex(commandSources, event.source);
            if(sourceIndex.has_value()){
                for(usize moveIndex = sourceIndex.value() + 1u; moveIndex < commandSources.size(); ++moveIndex)
                    commandSources[moveIndex - 1u] = commandSources[moveIndex];
                commandSources.pop_back();
            }
        }
        else if(event.type == InputEventType::PointerCaptureLost){
            b8 unfinishedHover = false;
            TerminateRouterPointerSource(
                event.source,
                hoverPointerSource,
                pointerSources,
                pointerGestures,
                inOutActiveGestureSequence,
                inOutPointerSubmitArmed,
                inOutSecondaryOwner,
                inOutCapture,
                inOutCapturePopup,
                inOutCaptureDeclaration,
                inOutCaptureControl,
                inOutPrimaryDown,
                inOutPointerSequenceConsumed,
                inOutSecondaryDown,
                inOutSecondarySequenceConsumed,
                inOutActivePointerSource,
                unfinishedHover
            );
            outUnfinishedHoverSource = outUnfinishedHoverSource || unfinishedHover;
        }
        else if(event.type == InputEventType::PrimaryUp || event.type == InputEventType::SecondaryUp){
            PointerIntent intent = PointerIntent::Activate;
            if(event.type == InputEventType::SecondaryUp)
                intent = PointerIntent::ContextMenu;
            const Expected<usize> sourceIndex = FindRouterPointerSourceIndex(pointerSources, event.source, intent);
            if(!sourceIndex.has_value())
                continue;
            for(usize moveIndex = sourceIndex.value() + 1u; moveIndex < pointerSources.size(); ++moveIndex)
                pointerSources[moveIndex - 1u] = pointerSources[moveIndex];
            pointerSources.pop_back();
            if(inOutActivePointerSource != event.source)
                continue;
            if(intent == PointerIntent::Activate){
                inOutPrimaryDown = false;
                inOutPointerSequenceConsumed = false;
            }
            else{
                inOutSecondaryDown = false;
                inOutSecondarySequenceConsumed = false;
            }
            if(!inOutPrimaryDown && !inOutSecondaryDown)
                inOutActivePointerSource = InputSource();
        }
    }
}

void ReconcileRouterFocusCaptureAndActions(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    mut Vector<CommandSource> commandSources,
    mut Vector<InputAction> actions,
    mut WidgetId inOutFocus,
    mut u64 inOutFocusDeclaration,
    mut ControlToken inOutFocusControl,
    mut WidgetId inOutCapture,
    mut PopupToken inOutCapturePopup,
    mut u64 inOutCaptureDeclaration,
    mut ControlToken inOutCaptureControl,
    mut b8 inOutPointerSubmitArmed
){
    const Expected<usize> focusedIndex = FindTargetIndexInTable(targets, lookup, inOutFocus, inOutFocusDeclaration);
    b8 validFocus = false;
    if(focusedIndex.has_value()){
        const HitTarget focused = targets[focusedIndex.value()];
        const b8 focusedText = focused.textEditable && !focused.owner.valid();
        if(IsRouterTargetInteractive(targets, lookup, popups, focused) && focused.focusable && (focusedText || focused.control == inOutFocusControl)){
            validFocus = true;
            inOutFocusControl = focused.control;
        }
    }
    if(!validFocus){
        RetireRouterCommandFocus(commandSources);
        inOutFocus = WidgetId();
        inOutFocusDeclaration = 0u;
        inOutFocusControl = ControlToken();
    }
    const Expected<usize> capturedIndex = FindTargetIndexInTable(targets, lookup, inOutCapture, inOutCaptureDeclaration);
    b8 validCapture = false;
    if(capturedIndex.has_value()){
        const HitTarget captured = targets[capturedIndex.value()];
        const b8 capturedText = captured.textEditable && !captured.owner.valid();
        if(IsRouterTargetInteractive(targets, lookup, popups, captured) && captured.popup == inOutCapturePopup && (capturedText || captured.control == inOutCaptureControl)){
            validCapture = true;
            if(captured.control != inOutCaptureControl || !captured.activatable)
                inOutPointerSubmitArmed = false;
            inOutCaptureControl = captured.control;
        }
    }
    if(!validCapture){
        inOutCapture = WidgetId();
        inOutCapturePopup = PopupToken();
        inOutCaptureDeclaration = 0u;
        inOutCaptureControl = ControlToken();
        inOutPointerSubmitArmed = false;
    }
    usize keptActions = 0u;
    for(usize index = 0u; index < actions.size(); ++index){
        const InputAction action = actions[index];
        const Expected<usize> targetIndex = FindTargetIndexInTable(targets, lookup, action.id.target, action.id.declarationGeneration);
        b8 validAction = false;
        if(targetIndex.has_value()){
            const HitTarget target = targets[targetIndex.value()];
            validAction = IsRouterTargetInteractive(targets, lookup, popups, target)
                && target.activatable
                && action.popup == target.popup
                && action.control == target.control;
        }
        if(validAction){
            if(keptActions != index)
                actions[keptActions] = action;
            ++keptActions;
        }
    }
    actions.resize(keptActions);
}

void CancelRouterInteraction(
    mut Vector<InputAction> actions,
    mut Vector<ControlAction> controlActions,
    mut Vector<ContextMenuAction> contextMenuActions,
    mut Vector<PointerGestureRecord> pointerGestures,
    mut Vector<CommandSource> commandSources,
    mut u64 outActiveGestureSequence,
    mut WidgetId outHover,
    mut HoverIdentity outHoverIdentity,
    mut WidgetId outFocus,
    mut WidgetId outCapture,
    mut PopupToken outCapturePopup,
    mut ControlToken outCaptureControl,
    mut ControlToken outFocusControl,
    mut u64 outFocusDeclaration,
    mut u64 outCaptureDeclaration,
    mut b8 outPointerKnown,
    mut TargetOwner outSecondaryOwner,
    mut b8 outPointerSubmitArmed
){
    actions.clear();
    controlActions.clear();
    contextMenuActions.clear();
    pointerGestures.clear();
    outActiveGestureSequence = 0u;
    outHover = WidgetId();
    outHoverIdentity = HoverIdentity();
    outFocus = WidgetId();
    outCapture = WidgetId();
    outCapturePopup = PopupToken();
    outCaptureControl = ControlToken();
    outFocusControl = ControlToken();
    outFocusDeclaration = 0u;
    outCaptureDeclaration = 0u;
    outPointerKnown = false;
    outSecondaryOwner = TargetOwner();
    outPointerSubmitArmed = false;
    RetireRouterCommandFocus(commandSources);
}

void EraseRouterPointerSourceAt(in usize index, mut Vector<PointerSource> pointerSources){
    for(usize moveIndex = index + 1u; moveIndex < pointerSources.size(); ++moveIndex)
        pointerSources[moveIndex - 1u] = pointerSources[moveIndex];
    pointerSources.pop_back();
}

void FinishRouterPointerRelease(
    in usize heldIndex,
    in b8 primaryDown,
    in b8 secondaryDown,
    mut Vector<PointerSource> pointerSources,
    mut InputSource inOutActivePointerSource
){
    EraseRouterPointerSourceAt(heldIndex, pointerSources);
    if(!primaryDown && !secondaryDown)
        inOutActivePointerSource = InputSource();
}

b8 AdmitRouterPointerSourceEvent(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in InputEvent event,
    in b8 primaryDown,
    in b8 pointerSequenceConsumed,
    in b8 secondarySequenceConsumed,
    mut Point inOutPointer,
    mut b8 inOutPointerKnown,
    mut InputSource inOutHoverPointerSource,
    mut HoverIdentity inOutHoverIdentity,
    mut WidgetId inOutHover,
    mut Vector<PointerSource> inOutPointerSources,
    mut InputSource inOutActivePointerSource,
    mut Point outInteractionPosition,
    mut InputRoutingResult inOutResult,
    mut b8 outHasHit,
    mut HitTarget outHit,
    mut usize outHeldIndex,
    mut b8 outAdvanceHoverActivity
){
    outHasHit = false;
    outHit = HitTarget();
    outHeldIndex = inOutPointerSources.size();
    outAdvanceHoverActivity = false;
    const b8 press = event.type == InputEventType::PrimaryDown || event.type == InputEventType::SecondaryDown;
    const b8 release = event.type == InputEventType::PrimaryUp || event.type == InputEventType::SecondaryUp;
    b8 hitResolved = false;
    if(event.hoverCapable){
        const Expected<usize> hitIndex = FindRouterHitTargetIndex(targets, lookup, popups, event.position);
        outHasHit = hitIndex.has_value();
        if(outHasHit)
            outHit = targets[hitIndex.value()];
        hitResolved = true;
    }
    ObserveRouterPointer(
        targets,
        lookup,
        popups,
        event,
        outHasHit,
        outHit,
        inOutPointer,
        inOutPointerKnown,
        inOutHoverPointerSource,
        inOutHoverIdentity,
        inOutHover,
        outAdvanceHoverActivity
    );
    PointerIntent intent = PointerIntent::Activate;
    if(event.type == InputEventType::SecondaryDown || event.type == InputEventType::SecondaryUp)
        intent = PointerIntent::ContextMenu;
    const Expected<usize> heldFound = FindRouterPointerSourceIndex(inOutPointerSources, event.source, intent);
    if(press){
        if(heldFound.has_value()){
            inOutResult.pointerConsumed = inOutResult.pointerConsumed || inOutPointerSources[heldFound.value()].consumed;
            return false;
        }
        if(inOutPointerSources.size() == s_InputMaxSources)
            return false;
        const b8 accepted = !event.repeat && AcceptsRouterPointerSource(inOutActivePointerSource, inOutPointerSources, event.source);
        b8 consumed = false;
        if(!event.repeat){
            if(inOutActivePointerSource == event.source){
                if(primaryDown)
                    consumed = pointerSequenceConsumed;
                else
                    consumed = secondarySequenceConsumed;
            }
            else{
                if(!hitResolved){
                    const Expected<usize> hitIndex = FindRouterHitTargetIndex(targets, lookup, popups, event.position);
                    outHasHit = hitIndex.has_value();
                    if(outHasHit)
                        outHit = targets[hitIndex.value()];
                    hitResolved = true;
                }
                consumed = !popups.empty() || outHasHit;
            }
        }
        PointerSource added;
        added.source = event.source;
        added.intent = intent;
        added.consumed = consumed;
        added.inert = !accepted;
        inOutPointerSources.push_back(added);
        inOutResult.pointerConsumed = inOutResult.pointerConsumed || consumed;
        if(!accepted)
            return false;
        inOutActivePointerSource = event.source;
        outHeldIndex = inOutPointerSources.size() - 1u;
    }
    else if(release){
        if(!heldFound.has_value()){
            if(!hitResolved){
                const Expected<usize> hitIndex = FindRouterHitTargetIndex(targets, lookup, popups, event.position);
                outHasHit = hitIndex.has_value();
                if(outHasHit)
                    outHit = targets[hitIndex.value()];
                hitResolved = true;
            }
            inOutResult.pointerConsumed = inOutResult.pointerConsumed || !popups.empty() || outHasHit;
            return false;
        }
        const usize heldIndex = heldFound.value();
        const PointerSource held = inOutPointerSources[heldIndex];
        inOutResult.pointerConsumed = inOutResult.pointerConsumed || held.consumed;
        if(held.inert || inOutActivePointerSource != event.source){
            EraseRouterPointerSourceAt(heldIndex, inOutPointerSources);
            return false;
        }
        outHeldIndex = heldIndex;
    }
    else{
        const Expected<usize> activationIndex = FindRouterPointerSourceIndex(inOutPointerSources, event.source, PointerIntent::Activate);
        const Expected<usize> contextIndex = FindRouterPointerSourceIndex(inOutPointerSources, event.source, PointerIntent::ContextMenu);
        const b8 activationInert = activationIndex.has_value() && inOutPointerSources[activationIndex.value()].inert;
        const b8 contextInert = contextIndex.has_value() && inOutPointerSources[contextIndex.value()].inert;
        const b8 blocked = activationInert || contextInert || !AcceptsRouterPointerSource(inOutActivePointerSource, inOutPointerSources, event.source);
        if(blocked){
            const b8 activationConsumed = activationIndex.has_value() && inOutPointerSources[activationIndex.value()].consumed;
            const b8 contextConsumed = contextIndex.has_value() && inOutPointerSources[contextIndex.value()].consumed;
            inOutResult.pointerConsumed = inOutResult.pointerConsumed || activationConsumed || contextConsumed;
            return false;
        }
        if(!inOutActivePointerSource.valid() && !event.hoverCapable && event.type == InputEventType::PointerMove)
            return false;
    }
    if((press || release || event.type == InputEventType::PointerWheel) && !hitResolved){
        const Expected<usize> hitIndex = FindRouterHitTargetIndex(targets, lookup, popups, event.position);
        outHasHit = hitIndex.has_value();
        if(outHasHit)
            outHit = targets[hitIndex.value()];
        hitResolved = true;
    }
    inOutResult.pointerRouted = true;
    outInteractionPosition = event.position;
    return true;
}

b8 RetireRouterPopupAndRestoreFocus(
    in WidgetId id,
    in b8 windowFocused,
    mut Vector<PopupRecord> popups,
    mut Vector<HitTarget> targets,
    mut Vector<TargetLookup> lookup,
    mut Vector<PopupDismissal> popupDismissals,
    mut Vector<CommandSource> commandSources,
    mut WidgetId inOutFocus,
    mut u64 inOutFocusDeclaration,
    mut ControlToken inOutFocusControl
){
    b8 top = false;
    PopupRecord restore;
    if(!TryRetireRouterPopupSubtree(id, popups, targets, popupDismissals, top, restore))
        return false;
    RebuildRouterTargetLookup(targets, lookup);
    if(top){
        RetireRouterCommandFocus(commandSources);
        const Expected<usize> targetIndex = FindTargetIndexInTable(targets, lookup, restore.restoreFocus, restore.restoreDeclaration);
        b8 restored = false;
        if(windowFocused && targetIndex.has_value()){
            const HitTarget target = targets[targetIndex.value()];
            if(target.popup == restore.restorePopup && target.focusable && IsRouterTargetInteractive(targets, lookup, popups, target)){
                inOutFocus = target.id;
                inOutFocusDeclaration = target.declarationGeneration;
                inOutFocusControl = target.control;
                restored = true;
            }
        }
        if(!restored){
            inOutFocus = WidgetId();
            inOutFocusDeclaration = 0u;
            inOutFocusControl = ControlToken();
        }
    }
    return true;
}

void ReconcileRouterAllTargets(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in b8 windowFocused,
    in b8 pointerKnown,
    in Point pointer,
    mut Vector<CommandSource> commandSources,
    mut Vector<InputAction> actions,
    mut Vector<ControlAction> controlActions,
    mut Vector<ContextMenuAction> contextMenuActions,
    mut Vector<PointerGestureRecord> pointerGestures,
    mut u64 inOutActiveGestureSequence,
    mut WidgetId inOutFocus,
    mut u64 inOutFocusDeclaration,
    mut ControlToken inOutFocusControl,
    mut WidgetId inOutCapture,
    mut PopupToken inOutCapturePopup,
    mut u64 inOutCaptureDeclaration,
    mut ControlToken inOutCaptureControl,
    mut b8 inOutPointerSubmitArmed,
    mut TargetOwner inOutSecondaryOwner,
    mut HoverIdentity inOutHoverIdentity,
    mut WidgetId outHover,
    mut b8 outChangedHoverOwner
){
    ReconcileRouterFocusCaptureAndActions(
        targets,
        lookup,
        popups,
        commandSources,
        actions,
        inOutFocus,
        inOutFocusDeclaration,
        inOutFocusControl,
        inOutCapture,
        inOutCapturePopup,
        inOutCaptureDeclaration,
        inOutCaptureControl,
        inOutPointerSubmitArmed
    );
    ReconcileRouterPointerGestures(targets, lookup, popups, pointerGestures, inOutActiveGestureSequence);
    ReconcileRouterControlActions(targets, lookup, popups, controlActions, commandSources);
    ReconcileRouterContextMenus(targets, lookup, popups, windowFocused, contextMenuActions, inOutSecondaryOwner, commandSources);
    ReconcileRouterCommandPresses(targets, lookup, popups, windowFocused, inOutFocus, inOutFocusDeclaration, commandSources);
    b8 hasHovered = false;
    HitTarget hovered;
    if(pointerKnown){
        const Expected<usize> hoveredIndex = FindRouterHitTargetIndex(targets, lookup, popups, pointer);
        hasHovered = hoveredIndex.has_value();
        if(hasHovered)
            hovered = targets[hoveredIndex.value()];
    }
    UpdateRouterHoverTarget(
        targets,
        lookup,
        popups,
        hasHovered,
        hovered,
        inOutHoverIdentity,
        outHover,
        outChangedHoverOwner
    );
}


