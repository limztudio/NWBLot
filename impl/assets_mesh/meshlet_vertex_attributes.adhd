#include <impl/assets_mesh/asset.adhd>
#include <impl/assets_mesh/meshlet_ref_decoding.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Flat per-corner attribute buffer from meshlet streams.
Expected<Vector<AttribGpu>> BuildMeshletTriangleAttributes(
    in Span<MeshletDesc> meshlets,
    in Span<MeshletLocalVertexRef> localVertexRefs,
    in Span<u8> attributeRefDeltas,
    in Span<u8> primitiveIndices,
    in Span<f16x4u> normalStream,
    in Span<f32x2u> uv0Stream
){
    Vector<AttribGpu> outAttributes;
    outAttributes.resize(primitiveIndices.size());
    if(!DecodeMeshletTriangleAttributesInto(meshlets, localVertexRefs, attributeRefDeltas, primitiveIndices, normalStream, uv0Stream, outAttributes))
        return MakeUnexpected(Failure());
    return outAttributes;
}

Expected<Vector<AttribGpu>> BuildMeshletTriangleAttributes(in Mesh payload){
    return BuildMeshletTriangleAttributes(
        payload.meshlets(),
        payload.meshletLocalVertexRefs(),
        payload.meshletAttributeRefDeltas(),
        payload.meshletPrimitiveIndices(),
        payload.normalStream(),
        payload.uv0Stream()
    );
}


