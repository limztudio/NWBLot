#ifndef NWB_GRAPHICS_CAUSTIC_PHOTON_PUSH_CONSTANTS_SLANGI
#define NWB_GRAPHICS_CAUSTIC_PHOTON_PUSH_CONSTANTS_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Shared CPU/GPU photon-producer ABI.
#define NWB_CAUSTIC_TEMPORAL_DISABLED_PHASE_COUNT 1u
#define NWB_CAUSTIC_TEMPORAL_PHASE_COUNT 2u


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Mirrors the C++ field list as u32. Slang needs the same 15 words; defaults stay CPU-side.
struct NwbCausticPhotonPushConstants{
    uint width;
    uint height;
    uint instanceCount;
    uint photonCount;
    uint emissionTargetCount;
    uint gridSide;
    uint frameIndex;
    uint depthSlot;
    uint worldPositionSlot;
    uint emissionTargetSlot;
    uint viewSlot;
    uint deferredResourcesHeapSlot;
    uint materialContextSlotsHeapSlot;
    uint accumulatorStorageSlot;
    uint temporalPhaseCount;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

