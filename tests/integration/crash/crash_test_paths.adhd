#include <tests/common/gtest_macros.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_DefaultRootDirectoryName = "crashes";
const StringView s_TestStorageDirectoryName = "test_storage";
const StringView s_SpoolDirectoryName = "spool";

Path CrashRootDirectory(){
    const ExecutablePaths executablePaths = ExecutablePaths();
    const Expected<Path, ErrorCode> executableDirectory = executablePaths.directory();
    if(executableDirectory.has_value())
        return executableDirectory.value() / s_DefaultRootDirectoryName;
    return Path(s_DefaultRootDirectoryName);
}

Path TestRootDirectory(){
    return CrashRootDirectory() / s_TestStorageDirectoryName;
}

Path TestCaseDirectory(in StringView testGroup){
    return TestRootDirectory() / testGroup;
}

Path SpoolDirectory(in StringView testGroup){
    return TestCaseDirectory(testGroup) / s_SpoolDirectoryName;
}

void RemoveTestArtifacts(in StringView testGroup){
    EXPECT_TRUE(RemoveAllIfExists(TestCaseDirectory(testGroup)).has_value());
}


