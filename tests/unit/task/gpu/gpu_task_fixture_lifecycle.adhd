inline constexpr Core::GpuTaskId s_CommandIrTask{ .generation = 17u, .index = 4u };
inline constexpr Core::GpuSubmissionPacketId s_CommandIrPacket{ .generation = 19u, .index = 2u };
inline constexpr Core::GpuPhysicalQueueId s_CommandIrQueue{ .index = 1u, .deviceGeneration = 3u };
inline constexpr Core::GpuGraphResourceId s_CommandIrSource{ .generation = 17u, .index = 5u };
inline constexpr Core::GpuGraphResourceId s_CommandIrDestination{ .generation = 17u, .index = 6u };

inline constexpr usize s_CommandIrCopyBufferOffset = sizeof(Core::GpuCommandIrStreamHeader);
inline constexpr usize s_CommandIrCopyTextureOffset = s_CommandIrCopyBufferOffset + sizeof(Core::GpuCommandIrCopyBufferRecord);
inline constexpr usize s_CommandIrClearBufferOffset = s_CommandIrCopyTextureOffset + sizeof(Core::GpuCommandIrCopyTextureRecord);
inline constexpr usize s_CommandIrClearTextureOffset = s_CommandIrClearBufferOffset + sizeof(Core::GpuCommandIrClearBufferRecord);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] NWB_INLINE BinaryByteView MakeBinaryByteView(const Span<const u8> bytes)noexcept{
    return BinaryByteView{ bytes.data(), bytes.size() };
}

[[nodiscard]] NWB_INLINE BinaryByteView MakeGraphicsByteView(const Core::GraphicsBytes& bytes)noexcept{
    return BinaryByteView{ bytes.data(), bytes.size() };
}

[[nodiscard]] NWB_INLINE BinaryByteView MakeNullBinaryByteView(const usize size)noexcept{
    return BinaryByteView{ nullptr, size };
}

[[nodiscard]] NWB_INLINE BinaryByteView SubBinaryByteView(const BinaryByteView source, const usize offset, const usize count)noexcept{
    return BinaryByteView{ source.data() + offset, count };
}

[[nodiscard]] NWB_INLINE Span<const u8> ByteViewSpan(const BinaryByteView source)noexcept{
    return source.data() ? Span<const u8>(source.data(), source.size()) : Span<const u8>{};
}

template<typename PodT>
[[nodiscard]] NWB_INLINE Optional<PodT> ReadCommandIrPodAt(const BinaryByteView bytes, const usize offset = 0u)noexcept{
    usize cursor = offset;
    if(const auto parsed = ReadPOD<PodT>(bytes, cursor))
        return *parsed;
    return {};
}

template<typename PodT>
NWB_INLINE void WriteCommandIrPod(const usize byteOffset, const PodT& value, const Span<u8> bytes)noexcept(noexcept(NWB_MEMCPY(bytes.data() + byteOffset, bytes.size() - byteOffset, &value, sizeof(value)))){
    NWB_ASSERT(byteOffset <= bytes.size());
    NWB_ASSERT(bytes.size() - byteOffset >= sizeof(PodT));
    NWB_MEMCPY(bytes.data() + byteOffset, bytes.size() - byteOffset, &value, sizeof(value));
}

NWB_INLINE void WriteCommandIrU8(const usize offset, const u8 value, Core::GraphicsBytes& bytes)noexcept{
    WriteCommandIrPod(offset, value, bytes);
}

NWB_INLINE void WriteCommandIrU16(const usize offset, const u16 value, Core::GraphicsBytes& bytes)noexcept{
    WriteCommandIrPod(offset, value, bytes);
}

NWB_INLINE void WriteCommandIrU32(const usize offset, const u32 value, Core::GraphicsBytes& bytes)noexcept{
    WriteCommandIrPod(offset, value, bytes);
}

NWB_INLINE void WriteCommandIrU64(const usize offset, const u64 value, Core::GraphicsBytes& bytes)noexcept{
    WriteCommandIrPod(offset, value, bytes);
}

NWB_INLINE void WriteCommandIrF32(const usize offset, const f32 value, Core::GraphicsBytes& bytes)noexcept{
    WriteCommandIrPod(offset, value, bytes);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct PayloadDestroyTask{
    struct Payload{
        u32* destructionCount = nullptr;


    public:
        explicit Payload(u32* const value)noexcept
            : destructionCount(value)
        {}
        Payload(Payload&& other)noexcept
            : destructionCount(other.destructionCount)
        {
            other.destructionCount = nullptr;
        }
        Payload(const Payload&) = delete;
        ~Payload()noexcept{
            if(destructionCount)
                ++*destructionCount;
        }
    };
};

struct PacketLifecycleTask{
    struct Payload{
        u32* acceptedCount = nullptr;
        u32* discardedCount = nullptr;
        Core::GpuQueueCapability::Mask requiredCapabilities = Core::GpuQueueCapability::None;
    };


public:
    static Core::GpuTaskCommandRequirements CommandRequirements(const Payload& payload)noexcept{
        return Core::GpuTaskCommandRequirements{ payload.requiredCapabilities };
    }

    static void Accepted(Payload& payload, const Core::QueueSubmissionToken&)noexcept{
        if(payload.acceptedCount)
            ++*payload.acceptedCount;
    }

    static void Discarded(Payload& payload)noexcept{
        if(payload.discardedCount)
            ++*payload.discardedCount;
    }
};

struct ReentrantCompileDuringDeclarationTask{
    struct Payload{
        const Core::GpuTaskGraph* graph = nullptr;
        Core::GpuTaskGraphAnalysis* analysis = nullptr;
        Core::Alloc::ScratchArena* scratchArena = nullptr;
        b8* compileAttempted = nullptr;
        b8* compileSucceeded = nullptr;


    public:
        Payload()noexcept = default;
        Payload(const Payload&) = delete;
        Payload(Payload&& other)
            : graph(other.graph)
            , analysis(other.analysis)
            , scratchArena(other.scratchArena)
            , compileAttempted(other.compileAttempted)
            , compileSucceeded(other.compileSucceeded)
        {
            other.graph = nullptr;
            other.analysis = nullptr;
            other.scratchArena = nullptr;
            other.compileAttempted = nullptr;
            other.compileSucceeded = nullptr;
            if(!graph || !analysis || !scratchArena)
                return;

            if(compileAttempted)
                *compileAttempted = true;
            const Core::GpuTaskGraphCompiler compiler;
            const Core::GpuTaskGraph::DeclarationReadView declarations = Core::GpuTaskGraph::DeclarationReadView::TryAcquire(*graph);
            b8 succeeded = false;
            if(declarations.valid())
                succeeded = compiler.analyze(declarations, *scratchArena, *analysis);
            if(compileSucceeded)
                *compileSucceeded = succeeded;
        }
    };
};

struct ReentrantTelemetryDuringDeclarationState{
    const Core::GpuTaskGraph* graph = nullptr;
    const Core::GpuTaskGraphAnalysis* analysis = nullptr;
    const Core::GpuTaskGraphQueueAssignments* assignments = nullptr;
    const Core::GpuCompiledGraph* compiledGraph = nullptr;
    const Core::GpuGraphSubmissionTransaction* transaction = nullptr;
    Core::GpuTaskGraphQueueAssignmentTelemetryTracker* tracker = nullptr;
    Telemetry::FrameGraphBuilder* builder = nullptr;
    Core::Alloc::ScratchArena* scratchArena = nullptr;
    b8 trackerValidationAttempted = false;
    b8 trackerValidationSucceeded = true;
    b8 trackerUpdateAttempted = false;
    b8 trackerUpdateSucceeded = true;
    b8 appendAttempted = false;
    b8 appendSucceeded = true;
};

struct ReentrantTelemetryDuringDeclarationTask{
    struct Payload{
        ReentrantTelemetryDuringDeclarationState* state = nullptr;


    public:
        explicit Payload(ReentrantTelemetryDuringDeclarationState& value)noexcept
            : state(&value)
        {}
        Payload(const Payload&) = delete;
        Payload(Payload&& other)
            : state(other.state)
        {
            other.state = nullptr;
            if(!state || !state->graph || !state->analysis || !state->assignments || !state->compiledGraph || !state->transaction || !state->tracker || !state->builder || !state->scratchArena)
                return;

            const Core::GpuTaskGraph::DeclarationReadView declarations = Core::GpuTaskGraph::DeclarationReadView::TryAcquire(*state->graph);
            const Core::GpuCompiledGraph::ReadView compiledPlan(*state->compiledGraph);
            state->trackerValidationAttempted = true;
            state->trackerValidationSucceeded = state->tracker->validFor(declarations, *state->assignments, compiledPlan);
            state->trackerUpdateAttempted = true;
            state->trackerUpdateSucceeded = state->tracker->update(declarations, *state->assignments, compiledPlan, *state->transaction, *state->scratchArena);
            const Core::GpuTaskGraphTelemetryOptions options{ .queueAssignments = state->assignments, .compiledPlan = &compiledPlan, .queueAssignmentTelemetry = state->tracker };
            state->appendAttempted = true;
            state->appendSucceeded = declarations.appendFrameGraphTelemetry(*state->analysis, *state->scratchArena, *state->builder, options);
        }
    };
};

struct NativeRecordProbeTask{
    static constexpr Core::GpuTaskCommandRequirements s_CommandRequirements{ Core::GpuQueueCapability::Graphics };


public:
    struct Payload{
        u32* recordCount = nullptr;
    };


public:
    static b8 Record(const Payload& payload, Core::CommandList&, const Core::GpuTaskRecordContext&)noexcept{
        if(payload.recordCount)
            ++*payload.recordCount;
        return true;
    }
};

struct MalformedLifecycleTask{
    struct Payload{
        u32* recordCount = nullptr;
        u32* acceptedCount = nullptr;
        u32* discardedCount = nullptr;
    };


public:
    static b8 Record(const Payload& payload, Core::CommandList&, const Core::GpuTaskRecordContext&, [[maybe_unused]] const u32 lookalike = 0u)noexcept{
        if(payload.recordCount)
            ++*payload.recordCount;
        return true;
    }

    static b8 Accepted(Payload& payload, const Core::QueueSubmissionToken&)noexcept{
        if(payload.acceptedCount)
            ++*payload.acceptedCount;
        return true;
    }

    static void Discarded(const Payload& payload)noexcept{
        if(payload.discardedCount)
            ++*payload.discardedCount;
    }
};


