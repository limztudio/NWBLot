#include <impl/ecs_render/optics/types.adhd>
#include <impl/ecs_render/optics/graph_types.adhd>
#include <impl/ecs_render/kernel/task_graph_resource_utils.adhd>
#include <impl/ecs_render/kernel/timing_names.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<impl/assets/graphics/raytrace/optical_scene_constants.h>"), cpp_name("NWB_RT_OPTICAL_BOUNDARY_UNSPECIFIED")]
extern const u32 s_ShaderRtOpticalBoundaryUnspecified;


[cpp_header("<impl/assets/graphics/raytrace/optical_scene_constants.h>"), cpp_name("NWB_RT_OPTICAL_BOUNDARY_CLOSED_PRIORITY")]
extern const u32 s_ShaderRtOpticalBoundaryClosedPriority;
static_assert(OpticalBoundaryMode::Unspecified == s_ShaderRtOpticalBoundaryUnspecified);
static_assert(OpticalBoundaryMode::ClosedNested == s_ShaderRtOpticalBoundaryClosedNested);
static_assert(OpticalBoundaryMode::ClosedPriority == s_ShaderRtOpticalBoundaryClosedPriority);

[cpp_header("<impl/assets/graphics/raytrace/optical_bounds_finalize_constants.h>"), cpp_name("NWB_OPTICAL_BOUNDS_FINALIZE_PUSH_BYTES")]
extern const u32 s_ShaderOpticalBoundsFinalizePushBytes;
static_assert(size_of<OpticalBoundsFinalizePushConstants>() == s_ShaderOpticalBoundsFinalizePushBytes);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class OpticalBoundsFinalizeTask{
    private BufferHandle m_source;
    private RayTracingOpticalBoundsFinalizeHandle m_finalize;
    private GpuUploadBlobId m_inputUpload;

    public OpticalBoundsFinalizeTask(in BufferHandle source, in RayTracingOpticalBoundsFinalizeHandle finalize, in GpuUploadBlobId inputUpload){
        this.m_source = source;
        this.m_finalize = finalize;
        this.m_inputUpload = inputUpload;
    }

    public GpuTaskCommandRequirements commandRequirements()const{
        GpuTaskCommandRequirements commands;
        commands.requiredCapabilities = GpuQueueCapability::Compute | GpuQueueCapability::Transfer;
        commands.requiresPrimaryGraphicsQueue = true;
        return commands;
    }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        const auto inputs = context.declarations.uploadBlobData(this.m_inputUpload);
        if(!this.m_finalize.valid() || !inputs.has_value())
            return false;
        in RayTracingOpticalBoundsFinalizeSnapshot resources = this.m_finalize.deref();
        const usize expectedBytes = ComputeOpticalRuntimeInputsByteSize(resources.inputs.size(), size_of<RayTracingOpticalRuntimeInputGpu>());
        if(!ValidOpticalBoundsFinalizeRecordState(
            this.m_source.valid(),
            true,
            inputs.has_value(),
            context.commandIrCapture,
            context.queue == resources.queue,
            resources.pipeline.valid(),
            resources.inputBuffer.valid(),
            resources.outputBuffer.valid(),
            inputs.value().size(),
            expectedBytes
        ))
            return false;
        commandList.endRenderPass();
        commandList.setBufferState(this.m_source.deref(), ResourceStates::ShaderResource);
        commandList.setBufferState(resources.inputBuffer.deref(), ResourceStates::CopyDest);
        commandList.setBufferState(resources.outputBuffer.deref(), ResourceStates::UnorderedAccess);
        for(in BufferHandle bounds : resources.boundsBuffers)
            commandList.setBufferState(bounds.deref(), ResourceStates::ShaderResource);
        commandList.commitBarriers();
        if(!commandList.tryWriteBuffer(resources.inputBuffer.deref(), inputs.value().span(), 0u))
            return false;
        commandList.setBufferState(resources.inputBuffer.deref(), ResourceStates::ShaderResource);
        commandList.commitBarriers();
        ComputeState state;
        state.setPipeline(resources.pipeline.deref());
        commandList.setComputeState(state);
        resources.graphics.getDevice().getDescriptorHeap().bindCompute(commandList, resources.pipeline.deref());
        const OpticalBoundsFinalizePushConstants push = ResolveOpticalBoundsFinalizePushConstants(
            resources.sourceDescriptor.slot(),
            resources.inputDescriptor.slot(),
            resources.outputDescriptor.slot(),
            resources.instanceCount,
            cast<u32>(resources.inputs.size()),
            resources.staticBoundsComplete
        );
        commandList.setPushConstants(push);
        {
            GpuTimingMeasure timing(resources.graphics.gpuTiming(), s_TimingScopeOpticalBoundsFinalize, resources.graphics.getDevice(), commandList);

            commandList.dispatch(1u, 1u, 1u);
        }
        commandList.setBufferState(resources.inputBuffer.deref(), ResourceStates::Common);
        commandList.setBufferState(resources.outputBuffer.deref(), ResourceStates::Common);
        commandList.setBufferState(this.m_source.deref(), ResourceStates::Common);
        commandList.commitBarriers();
        return true;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<GpuGraphResourceId> ImportCommonOpticalBuffer(mut GpuTaskGraph graph, in BufferHandle buffer, in StringView label){
    if(!buffer.valid() || !buffer.deref().getCreationDescription().keepInitialState || buffer.deref().getCreationDescription().initialState != ResourceStates::Common)
        return MakeUnexpected(Failure());
    GpuGraphResourceDesc desc = BufferResourceDesc(buffer.deref().getCreationDescription().debugName, label);
    desc.setInitialState(ResourceStates::Common).setExternalFinalState(ResourceStates::Common);
    return graph.importBuffer(buffer, desc);
}

Expected<RayTracingOpticalSceneGraphBuffer> DeclareOpticalBoundsFinalize(in RayTracingOpticalSceneSnapshot resources, in GpuGraphResourceId source, in borrow GpuTaskId priorReadersDrained, mut GpuTaskGraph graph){
    if(!resources.finalize.valid())
        return MakeUnexpected(Failure());
    if(!ValidOpticalBoundsFinalizeDeclareInputs(
        true,
        resources.uploadBuffer.valid(),
        source.valid(),
        resources.finalize.deref().inputs.size(),
        resources.finalize.deref().boundsBuffers.size()
    ))
        return MakeUnexpected(Failure());
    in RayTracingOpticalBoundsFinalizeSnapshot finalize = resources.finalize.deref();
    const auto inputsResult = ImportCommonOpticalBuffer(graph, finalize.inputBuffer, "Ray Optical Runtime Inputs");
    RayTracingOpticalSceneGraphBuffer result;
    const auto resourceResult = ImportCommonOpticalBuffer(graph, finalize.outputBuffer, "Ray Optical Resolved Scene");
    if(!inputsResult.has_value() || !resourceResult.has_value())
        return MakeUnexpected(Failure());
    result.resource = resourceResult.value();
    const GpuGraphResourceId inputs = inputsResult.value();

    Vector<GpuTaskResourceUse> uses;
    uses.reserve(finalize.boundsBuffers.size() + s_OpticalBoundsUseCapacity);
    uses.push_back(ReadUse(source, ResourceStates::ShaderResource));
    uses.push_back(ReadUse(source, ResourceStates::Common));
    uses.push_back(WriteUse(inputs, ResourceStates::CopyDest));
    uses.push_back(ReadUse(inputs, ResourceStates::ShaderResource));
    uses.push_back(WriteUse(inputs, ResourceStates::Common));
    uses.push_back(WriteUse(result.resource, ResourceStates::UnorderedAccess));
    uses.push_back(WriteUse(result.resource, ResourceStates::Common));
    for(in BufferHandle bounds : finalize.boundsBuffers){
        GpuGraphResourceId resource;
        {
            const GpuTaskGraphDeclarationReadView declarations(graph);
            if(!declarations.valid())
                return MakeUnexpected(Failure());
            resource = declarations.findImportedBuffer(bounds);
        }
        if(!resource.valid()){
            GpuGraphResourceDesc desc = BufferResourceDesc(bounds.deref().getCreationDescription().debugName, "Ray Optical Runtime Bounds");
            desc.setInitialState(ResourceStates::ShaderResource).setExternalFinalState(ResourceStates::ShaderResource);
            const auto importedResource = graph.importBuffer(bounds, desc);
            if(!importedResource.has_value())
                return MakeUnexpected(Failure());
            resource = importedResource.value();
        }
        if(!resource.valid())
            return MakeUnexpected(Failure());
        b8 found = false;
        for(in GpuTaskResourceUse use : uses){
            if(use.resource == resource){
                found = true;
                break;
            }
        }
        if(!found)
            uses.push_back(ReadUse(resource, ResourceStates::ShaderResource));
    }
    const auto uploadResult = graph.copyUploadBytes<u32>(PodArrayBytes<RayTracingOpticalRuntimeInputGpu>(Span<RayTracingOpticalRuntimeInputGpu>(finalize.inputs)));
    if(!uploadResult.has_value())
        return MakeUnexpected(Failure());
    const GpuUploadBlobId upload = uploadResult.value();
    GpuTaskSchedulingHint scheduling;
    scheduling.cost = GpuTaskCostHint::Tiny;
    scheduling.forceSubmissionBoundary = false;
    scheduling.allowPacketMerge = true;
    scheduling.mergeWithPrevious = true;
    scheduling.allowMergeAcrossConsumerFrontier = true;
    GpuTaskDesc desc;
    desc
        .setIdentity(Name(s_RenderNameRenderRaytraceOpticalBoundsFinalize))
        .setMarkerLabel("Ray Optical Bounds Finalize")
        .setScheduling(scheduling)
        .setResourceUses(Span<GpuTaskResourceUse>(uses))
    ;
    if(priorReadersDrained.valid())
        desc.setDependency(priorReadersDrained);
    const auto uploadTaskResult = graph.addPayloadTask(desc, OpticalBoundsFinalizeTask(resources.uploadBuffer, resources.finalize, upload));
    if(!uploadTaskResult.has_value())
        return MakeUnexpected(uploadTaskResult.error());
    result.uploadTask = uploadTaskResult.value();
    if(!result.valid())
        return MakeUnexpected(Failure());
    return result;
}


