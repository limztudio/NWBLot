////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/deferred/deferred_frame_targets.adhd.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_CORE_BEGIN
class GraphicsRuntime;
NWB_CORE_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererAvboitSystem;
class RendererCsgSystem;
class RendererDeferredSystem;
class RendererRayTracingState;
class RendererRayTracingSystem;


class DeferredFrameTargetBuilder final : NoCopy{
public:
    DeferredFrameTargetBuilder(
        Core::GraphicsRuntime& graphics,
        RendererRayTracingState& rayTracingState,
        RendererDeferredSystem& deferred,
        RendererAvboitSystem& avboit,
        RendererCsgSystem& csg,
        RendererRayTracingSystem& rayTracing
    )noexcept
        : m_graphics(graphics)
        , m_rayTracingState(rayTracingState)
        , m_deferred(deferred)
        , m_avboit(avboit)
        , m_csg(csg)
        , m_rayTracing(rayTracing)
    {}


public:
    [[nodiscard]] Expected<DeferredFrameTargets> build(u32 width, u32 height, u32 shadowReceiverFactor, u32 surfelResolveFactor);


private:
    Core::GraphicsRuntime& m_graphics;
    RendererRayTracingState& m_rayTracingState;
    RendererDeferredSystem& m_deferred;
    RendererAvboitSystem& m_avboit;
    RendererCsgSystem& m_csg;
    RendererRayTracingSystem& m_rayTracing;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

