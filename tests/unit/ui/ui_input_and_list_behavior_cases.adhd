using namespace NWB;
using namespace NWB::Impl::Ui;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class UiInputBindingsTests : public testing::Test{
public:
    UiInputBindingsTests()
        : m_arena(Name(NWB::Tests::UiCases::s_UiCaseTestsUiInputBindings))
        , m_bindings(m_arena)
    {}


public:
    [[nodiscard]] usize bindingsDataAddress()const noexcept{
        return reinterpret_cast<usize>(m_bindings.bindings().data());
    }

    [[nodiscard]] b8 setSingle(const InputKeyBinding& binding){
        return m_bindings.set(Span<const InputKeyBinding>(&binding, 1u));
    }

    [[nodiscard]] b8 setSpan(const Span<const InputKeyBinding> bindings){
        return m_bindings.set(bindings);
    }

    [[nodiscard]] b8 setCount(const Span<const InputKeyBinding> bindings, const usize count){
        return m_bindings.set(bindings.subspan(0u, count));
    }

    [[nodiscard]] b8 setEmpty(){
        return m_bindings.set({});
    }

    [[nodiscard]] b8 setAliasedSlice(const usize offset, const usize count){
        return m_bindings.set(Span<const InputKeyBinding>(m_bindings.bindings().data() + offset, count));
    }


public:
    Core::Alloc::GlobalArena m_arena;
    InputBindings m_bindings;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_ui_input_tests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace NWB;
using namespace NWB::Impl::Ui;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class UiInputTests : public UiTestSupport::RouterTestFixture{
public:
    UiInputTests()
        : RouterTestFixture(Name(NWB::Tests::UiCases::s_UiCaseTestsUiInput))
    {}


public:
    void tab(const b8 reverse = false){
        key(Core::Key::Tab, reverse);
    }

    [[nodiscard]] b8 commitSingle(const HitTarget& target, const u64 generation){
        return m_router.commitTargets(Span<const HitTarget>(&target, 1u), generation);
    }

    [[nodiscard]] b8 commitSpan(const Span<const HitTarget> targets, const u64 generation){
        return m_router.commitTargets(targets, generation);
    }

    [[nodiscard]] b8 commitEmpty(const u64 generation){
        return m_router.commitTargets({}, generation);
    }

    [[nodiscard]] b8 commitOverflowSingle(const HitTarget& target, const usize overflowCount, const u64 generation){
        return m_router.commitTargets(Span<const HitTarget>(&target, overflowCount), generation);
    }

    [[nodiscard]] b8 commitOverflowSpan(const Span<const HitTarget> targets, const u64 generation){
        return m_router.commitTargets(Span<const HitTarget>(targets.data(), targets.size() + 1u), generation);
    }

    [[nodiscard]] usize findTargetAddress(const WidgetId id, const u64 declarationGeneration = 0u)const noexcept{
        return reinterpret_cast<usize>(m_router.findTarget(id, declarationGeneration));
    }

    [[nodiscard]] usize targetEntryAddress(const usize index)const noexcept{
        return reinterpret_cast<usize>(&m_router.targets()[index]);
    }

    [[nodiscard]] Optional<HitTarget> findTargetCopy(const WidgetId id, const u64 declarationGeneration = 0u)const noexcept{
        if(const HitTarget* found = m_router.findTarget(id, declarationGeneration))
            return *found;
        return {};
    }

    [[nodiscard]] b8 queueNative(const InputEvent& event){
        return m_router.queue(UiTestSupport::NativeInput(event)).has_value();
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


