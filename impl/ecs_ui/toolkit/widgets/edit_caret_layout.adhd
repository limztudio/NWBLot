f32 ComputeEditScalarFraction(in StringView text, in usize begin, in usize end, in usize position){
    usize total = 0u;
    usize before = 0u;
    for(usize index = begin; index < end; ++index){
        if(!IsUtf8Continuation(cast<u8>(text[index]))){
            ++total;
            if(index < position)
                ++before;
        }
    }
    if(total == 0u)
        return 0.0f;
    return cast<f32>(before) / cast<f32>(total);
}

Expected<usize> TryFindNearestEditCaretStop(in Span<EditCaretLine> lines, in Span<EditBoxCaretStop> stops, in u32 lineIndex, in Point point){
    if(stops.empty() || cast<usize>(lineIndex) >= lines.size() || !isFinite(point.x) || !isFinite(point.y))
        return makeUnexpected(Failure());
    const EditCaretLine line = lines[lineIndex];
    if(cast<usize>(line.firstStop) > stops.size() || cast<usize>(line.stopCount) > stops.size() - cast<usize>(line.firstStop))
        return makeUnexpected(Failure());
    if(line.stopCount == 0u && (line.firstStop == 0u || cast<usize>(line.firstStop) >= stops.size()))
        return makeUnexpected(Failure());
    usize first = cast<usize>(line.firstStop);
    usize end = first + cast<usize>(line.stopCount);
    if(line.stopCount == 0u){
        first = cast<usize>(line.firstStop) - 1u;
        end = cast<usize>(line.firstStop) + 1u;
    }
    f32 minimumX = stops[first].x;
    if(!isFinite(minimumX) || minimumX < 0.0f)
        return makeUnexpected(Failure());
    f32 maximumX = minimumX;
    for(usize index = first + 1u; index < end; ++index){
        if(!isFinite(stops[index].x) || stops[index].x < 0.0f)
            return makeUnexpected(Failure());
        minimumX = min(minimumX, stops[index].x);
        maximumX = max(maximumX, stops[index].x);
    }
    const f32 queryX = clamp(point.x, minimumX, maximumX);
    f64 nearestY = 0.0;
    f32 nearestX = 0.0f;
    b8 haveBest = false;
    usize result = 0u;
    for(usize index = first; index < end; ++index){
        const EditBoxCaretStop stop = stops[index];
        if(cast<usize>(stop.lineIndex) >= lines.size() || (line.stopCount != 0u && stop.lineIndex != lineIndex))
            return makeUnexpected(Failure());
        const EditCaretLine stopLine = lines[stop.lineIndex];
        if(!isFinite(stopLine.top) || !isFinite(stopLine.height) || stopLine.height <= 0.0f || !isFinite(stopLine.top + stopLine.height))
            return makeUnexpected(Failure());
        const f64 lineCenter = cast<f64>(stopLine.top) + (cast<f64>(stopLine.height) * 0.5);
        f64 distanceY = 0.0;
        if(line.stopCount == 0u)
            distanceY = abs(cast<f64>(point.y) - lineCenter);
        const f32 distanceX = abs(queryX - stop.x);
        if(!haveBest || distanceY < nearestY || (distanceY == nearestY && distanceX < nearestX)){
            nearestY = distanceY;
            nearestX = distanceX;
            result = stop.committedByte;
            haveBest = true;
        }
    }
    if(!haveBest)
        return makeUnexpected(Failure());
    return result;
}

b8 TryHitEditCaretLineAndStop(in Span<EditCaretLine> lines, in Span<EditBoxCaretStop> stops, in Point localPoint, mut u32 outLineIndex, mut usize outCommittedByte){
    outLineIndex = 0u;
    outCommittedByte = 0u;
    if(lines.empty() || lines.size() > cast<usize>(0xffffffffu) || stops.empty() || !isFinite(localPoint.x) || !isFinite(localPoint.y))
        return false;
    u32 lineIndex = cast<u32>(lines.size() - 1u);
    for(u32 index = 0u; cast<usize>(index) < lines.size(); ++index){
        const EditCaretLine line = lines[index];
        if(!isFinite(line.top) || !isFinite(line.height) || line.height <= 0.0f)
            return false;
        const f32 bottom = line.top + line.height;
        if(!isFinite(bottom))
            return false;
        if(localPoint.y < bottom){
            lineIndex = index;
            break;
        }
    }
    const Expected<usize> committedByte = TryFindNearestEditCaretStop(lines, stops, lineIndex, localPoint);
    if(!committedByte.has_value())
        return false;
    outCommittedByte = committedByte.value();
    outLineIndex = lineIndex;
    return true;
}

// Queries owned projections of validated caret geometry; copied hosts share line, midpoint and preedit endpoint behavior.
Expected<usize> HitEditCaretGeometry(in Span<EditCaretLine> lines, in Span<EditBoxCaretStop> stops, in Point localPoint){
    u32 lineIndex = 0u;
    usize committedByte = 0u;
    if(!TryHitEditCaretLineAndStop(lines, stops, localPoint, lineIndex, committedByte))
        return makeUnexpected(Failure());
    return committedByte;
}

Expected<usize> TryHitEditWordCaretGeometry(in Span<EditCaretLine> lines, in Span<EditBoxCaretStop> stops, in Point localPoint){
    u32 lineIndex = 0u;
    usize byte = 0u;
    if(!TryHitEditCaretLineAndStop(lines, stops, localPoint, lineIndex, byte))
        return makeUnexpected(Failure());
    const EditCaretLine line = lines[lineIndex];
    if(line.stopCount < s_UiEditMinInterpolatedStops)
        return byte;
    const usize first = cast<usize>(line.firstStop);
    const usize end = first + cast<usize>(line.stopCount);
    usize selected = first;
    for(usize index = first + 1u; index < end; ++index){
        if(stops[index].lineIndex != lineIndex || stops[index].x < stops[index - 1u].x)
            return makeUnexpected(Failure());
        if(localPoint.x < stops[index].x)
            break;
        selected = index;
    }
    if(selected + 1u == end)
        --selected;
    return stops[selected].committedByte;
}

Expected<EditBoxCaretStop> TryFindEditCaretStopByCommittedByte(in Span<EditBoxCaretStop> stops, in usize committedByte){
    for(usize i = 0u; i < stops.size(); ++i){
        if(stops[i].committedByte == committedByte)
            return stops[i];
    }
    return makeUnexpected(Failure());
}

Expected<usize> ResolveEditCaretPageTarget(
    in Span<EditCaretLine> lines,
    in Span<EditBoxCaretStop> stops,
    in usize activeCaret,
    in Rect caret,
    in b8 down,
    in f32 preferredX,
    in f32 viewportHeight
){
    const Expected<EditBoxCaretStop> current = TryFindEditCaretStopByCommittedByte(stops, activeCaret);
    if(lines.empty() || !current.has_value() || cast<usize>(current.value().lineIndex) >= lines.size())
        return makeUnexpected(Failure());
    const f64 center = cast<f64>(caret.y) + (cast<f64>(caret.height) * s_RectCenterFractionF64);
    const f64 pageStep = cast<f64>(viewportHeight);
    f64 target = center - pageStep;
    if(down)
        target = center + pageStep;
    const EditCaretLine first = lines[0u];
    const EditCaretLine last = lines[lines.size() - 1u];
    const f64 minimum = cast<f64>(first.top) + (cast<f64>(first.height) * s_RectCenterFractionF64);
    const f64 maximum = cast<f64>(last.top) + (cast<f64>(last.height) * s_RectCenterFractionF64);
    if(!isFinite(target) || !isFinite(minimum) || !isFinite(maximum) || minimum > maximum)
        return makeUnexpected(Failure());
    const Point point(preferredX, cast<f32>(clamp(target, minimum, maximum)));
    if(!isFinite(point.y))
        return makeUnexpected(Failure());
    const Expected<usize> result = HitEditCaretGeometry(lines, stops, point);
    if(!result.has_value())
        return makeUnexpected(Failure());
    const Expected<EditBoxCaretStop> resolved = TryFindEditCaretStopByCommittedByte(stops, result.value());
    if(!resolved.has_value() || cast<usize>(resolved.value().lineIndex) >= lines.size())
        return makeUnexpected(Failure());
    // A page that cannot reach another row preserves the active caret, including a short document boundary.
    if(resolved.value().lineIndex == current.value().lineIndex)
        return activeCaret;
    return result.value();
}

usize LowerBoundEditClusterByEnd(in Span<TextCluster> clusters, in usize beginIndex, in usize endIndex, in usize byte){
    usize first = beginIndex;
    usize count = endIndex - beginIndex;
    while(count > 0u){
        const usize step = count / 2u;
        const usize mid = first + step;
        if(cast<usize>(clusters[mid].byteEnd) < byte){
            first = mid + 1u;
            count -= step + 1u;
        }
        else{
            count = step;
        }
    }
    return first;
}

u32 LineForEditCaretByte(in Span<TextLine> lines, in usize byte){
    usize first = 0u;
    usize count = lines.size();
    while(count > 0u){
        const usize step = count / 2u;
        const usize mid = first + step;
        if(cast<usize>(lines[mid].byteBegin) <= byte){
            first = mid + 1u;
            count -= step + 1u;
        }
        else{
            count = step;
        }
    }
    return cast<u32>(first - 1u);
}

b8 ValidateEditCaretLayout(
    in StringView text,
    in Span<TextLine> lines,
    in Span<TextCluster> clusters,
    in usize glyphCount,
    in Point measure,
    in Rect ink,
    in EditTextMode mode
){
    if(
        lines.empty() || lines.size() > s_TextMaxBytes + 1u || clusters.size() > s_TextMaxBytes
        || glyphCount > s_TextMaxBytes || (mode == EditTextMode::SingleLine && lines.size() != 1u)
        || !isFinite(measure.x) || !isFinite(measure.y) || measure.x < 0.0f || measure.y <= 0.0f
        || !isFinite(ink.x) || !isFinite(ink.y) || !isFinite(ink.width) || !isFinite(ink.height)
        || ink.width < 0.0f || ink.height < 0.0f
    )
        return false;
    usize previousBreak = 0u;
    usize nextCluster = 0u;
    usize nextGlyph = 0u;
    f32 previousBottom = 0.0f;
    f32 maximumAdvance = 0.0f;
    for(usize lineIndex = 0u; lineIndex < lines.size(); ++lineIndex){
        const TextLine line = lines[lineIndex];
        const usize lineByteBegin = cast<usize>(line.byteBegin);
        const usize lineByteEnd = cast<usize>(line.byteEnd);
        const usize lineBreakEnd = cast<usize>(line.breakEnd);
        const usize lineFirstCluster = cast<usize>(line.firstCluster);
        const usize lineFirstGlyph = cast<usize>(line.firstGlyph);
        const usize lineClusterCount = cast<usize>(line.clusterCount);
        const usize lineGlyphCount = cast<usize>(line.glyphCount);
        if(
            lineByteBegin != previousBreak || lineByteEnd < lineByteBegin || lineBreakEnd < lineByteEnd
            || lineBreakEnd > text.size() || lineFirstCluster != nextCluster || lineFirstGlyph != nextGlyph
            || lineClusterCount > clusters.size() - nextCluster || lineGlyphCount > glyphCount - nextGlyph
            || !isFinite(line.top) || !isFinite(line.height) || !isFinite(line.advance) || !isFinite(line.baseline)
            || line.top != previousBottom || line.height <= 0.0f || line.advance < 0.0f
        )
            return false;
        const f32 bottom = line.top + line.height;
        if(!isFinite(bottom) || line.baseline < line.top || line.baseline > bottom)
            return false;
        for(usize byte = lineByteBegin; byte < lineByteEnd; ++byte){
            if(text[byte] == '\n')
                return false;
        }
        const b8 lastLine = lineIndex + 1u == lines.size();
        if(lastLine){
            if(lineByteEnd != text.size() || lineBreakEnd != lineByteEnd)
                return false;
        }
        else if(lineByteEnd == text.size() || text[lineByteEnd] != '\n' || lineBreakEnd != lineByteEnd + 1u)
            return false;
        usize coveredByte = lineByteBegin;
        const usize glyphEnd = nextGlyph + lineGlyphCount;
        const usize clusterEnd = nextCluster + lineClusterCount;
        f32 previousX = 0.0f;
        while(nextCluster < clusterEnd){
            const TextCluster cluster = clusters[nextCluster];
            const usize clusterByteBegin = cast<usize>(cluster.byteBegin);
            const usize clusterByteEnd = cast<usize>(cluster.byteEnd);
            const usize clusterFirstGlyph = cast<usize>(cluster.firstGlyph);
            const usize clusterGlyphCount = cast<usize>(cluster.glyphCount);
            if(
                cast<usize>(cluster.lineIndex) != lineIndex || clusterByteBegin != coveredByte
                || clusterByteEnd <= clusterByteBegin || clusterByteEnd > lineByteEnd
                || !IsUtf8ScalarBoundary(text, clusterByteBegin)
                || !IsUtf8ScalarBoundary(text, clusterByteEnd)
                || clusterFirstGlyph != nextGlyph || clusterGlyphCount == 0u || clusterGlyphCount > glyphEnd - nextGlyph
                || !isFinite(cluster.leadingX) || !isFinite(cluster.trailingX)
                || cluster.leadingX != previousX || cluster.trailingX < cluster.leadingX || cluster.trailingX > line.advance
            )
                return false;
            nextGlyph += clusterGlyphCount;
            coveredByte = clusterByteEnd;
            previousX = cluster.trailingX;
            ++nextCluster;
        }
        if(coveredByte != lineByteEnd || nextGlyph != glyphEnd || previousX != line.advance)
            return false;
        previousBreak = lineBreakEnd;
        previousBottom = bottom;
        maximumAdvance = max(maximumAdvance, line.advance);
    }
    return nextCluster == clusters.size() && nextGlyph == glyphCount && measure.x == maximumAdvance && measure.y == previousBottom;
}

b8 IsValidEditCaretClusterGlyph(in u32 glyphByteBegin, in u32 glyphByteEnd, in Point glyphPosition, in TextCluster cluster){
    return glyphByteBegin == cluster.byteBegin && glyphByteEnd == cluster.byteEnd && isFinite(glyphPosition.x) && isFinite(glyphPosition.y);
}

b8 ValidateEditCaretAdoptionRequest(
    in StringView layoutText,
    in f32 layoutFontSize,
    in Span<TextLine> lines,
    in Span<TextCluster> clusters,
    in usize glyphCount,
    in Point measure,
    in Rect ink,
    in StringView expectedText,
    in Span<EditCaretMapping> mapping,
    in usize committedBytes,
    in EditTextMode mode
){
    if(
        layoutText != expectedText || (mode != EditTextMode::SingleLine && mode != EditTextMode::Multiline)
        || expectedText.size() > s_TextMaxBytes || committedBytes > s_TextMaxBytes
        || mapping.empty() || mapping.size() > committedBytes + s_EditCaretMaxExtraMappingStops
        || mapping[0u].committedByte != 0u || mapping[0u].displayByte != 0u
        || mapping[mapping.size() - 1u].committedByte != committedBytes || mapping[mapping.size() - 1u].displayByte != expectedText.size()
    )
        return false;
    if(mode == EditTextMode::Multiline && !ValidateMultilineText(expectedText))
        return false;
    ShapeRequest request;
    request.text = expectedText;
    request.fontSize = layoutFontSize;
    return ValidateTextRequest(request, mode == EditTextMode::Multiline) == TextLayoutStatus::Success
        && ValidateEditCaretLayout(layoutText, lines, clusters, glyphCount, measure, ink, mode);
}


