native{
#include <impl/global.adhd.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_CORE_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class GraphicsRuntime;
namespace Alloc{
    class GlobalArena;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_CORE_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererShaderSystem;
struct LightSpaceShadowState;
class LightSpacePlan;


class LightSpaceResourceSet final : NoCopy{
public:
    LightSpaceResourceSet(Core::Alloc::GlobalArena& arena, Core::GraphicsRuntime& graphics, RendererShaderSystem& shaderSystem, LightSpaceShadowState& state, const b8& hardwareSupported)noexcept
        : m_arena(arena)
        , m_graphics(graphics)
        , m_shaderSystem(shaderSystem)
        , m_state(state)
        , m_hardwareSupported(hardwareSupported)
    {}


public:
    [[nodiscard]] b8 ensureLightSpaceShadowPipelines();
    [[nodiscard]] b8 ensureLightSpaceShadowStorage(const LightSpacePlan& plan);
    void releaseLightSpaceShadowResources();


private:
    Core::Alloc::GlobalArena& m_arena;
    Core::GraphicsRuntime& m_graphics;
    RendererShaderSystem& m_shaderSystem;
    LightSpaceShadowState& m_state;
    const b8& m_hardwareSupported;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ImplEcsRenderShadowLightSpaceResourceSetAdhdModule(in u64 value){
    return value != 0u;
}


