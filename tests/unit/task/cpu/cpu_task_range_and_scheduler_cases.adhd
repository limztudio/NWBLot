void VerifyCpuTaskWaitTests_RecycledPositivePrerequisiteSlotsDoNotAdmitUnrelatedWork(){
    DeadlineGuard deadline(false, s_WaitWatchdogTimeoutMS);
    CpuTaskScheduler scheduler(0u);
    CpuTaskScope scope(scheduler);
    u32 joined = 0u;
    u32 unrelated = 0u;
    const auto rootTaskAdmission = scheduler.submit(lambda[]() -> void{});
    ASSERT_TRUE(rootTaskAdmission.has_value());
    const CpuTaskHandle root = rootTaskAdmission.value();
    ASSERT_TRUE(root.valid());
    const auto positiveTaskAdmission = scheduler.submit(lambda[]() -> void{}, root);
    ASSERT_TRUE(positiveTaskAdmission.has_value());
    const CpuTaskHandle positive = positiveTaskAdmission.value();
    ASSERT_TRUE(positive.valid());
    const auto cpuTaskAdmission = scope.submit(lambda[mut scheduler, mut scope, mut unrelated, mut joined, in positive]() -> void{
        CpuTaskHandle recycled = CpuTaskHandle();
        JoiningThread producer(lambda[mut scheduler, mut unrelated, mut recycled]() -> void{
            const auto recycledTaskAdmission = scheduler.submit(lambda[mut unrelated]() -> void{
                ++unrelated;
            });
            ASSERT_TRUE(recycledTaskAdmission.has_value());
            recycled = recycledTaskAdmission.value();
        });
        producer.join();
        EXPECT_TRUE(recycled.valid());
        EXPECT_EQ(recycled.index, positive.index);
        EXPECT_NE(recycled.generation, positive.generation);
        ++joined;
        const auto secondCpuTaskAdmission = scope.submit(lambda[mut joined]() -> void{
            ++joined;
        });
        EXPECT_TRUE(secondCpuTaskAdmission.has_value());
        if(secondCpuTaskAdmission.has_value()){
            EXPECT_TRUE(secondCpuTaskAdmission.value().valid());
        }
    }, positive);
    ASSERT_TRUE(cpuTaskAdmission.has_value());
    ASSERT_TRUE(cpuTaskAdmission.value().valid());
    scope.wait();
    const u32 unrelatedAfterScope = unrelated;
    scheduler.wait();
    const u32 unrelatedAfterAll = unrelated;
    EXPECT_EQ(joined, 2u);
    EXPECT_EQ(unrelatedAfterScope, 0u);
    EXPECT_EQ(unrelatedAfterAll, 1u);
}

void VerifyCpuTaskWaitTests_StructuredParentCompletionStaysScopedUntilEveryChildRetires(){
    u32 childTarget = 64u;
    DeadlineGuard deadline(false, s_WaitWatchdogTimeoutMS);
    CpuTaskScheduler scheduler(0u);
    CpuTaskScope scope(scheduler);
    u32 children = 0u;
    u32 unrelated = 0u;
    const auto cpuTaskAdmission = scheduler.submit(lambda[mut unrelated]() -> void{
        ++unrelated;
    });
    ASSERT_TRUE(cpuTaskAdmission.has_value());
    ASSERT_TRUE(cpuTaskAdmission.value().valid());
    const auto secondCpuTaskAdmission = scope.submit(lambda[mut scheduler, mut children, in childTarget]() -> void{
        for(u32 child = 0u; child < childTarget; ++child){
            const auto thirdCpuTaskAdmission = scheduler.submit(lambda[mut children]() -> void{
                ++children;
            });
            EXPECT_TRUE(thirdCpuTaskAdmission.has_value());
            if(thirdCpuTaskAdmission.has_value()){
                EXPECT_TRUE(thirdCpuTaskAdmission.value().valid());
            }
        }
    });
    ASSERT_TRUE(secondCpuTaskAdmission.has_value());
    ASSERT_TRUE(secondCpuTaskAdmission.value().valid());
    scope.wait();
    const u32 unrelatedAfterScope = unrelated;
    scheduler.wait();
    const u32 unrelatedAfterAll = unrelated;
    EXPECT_EQ(children, childTarget);
    EXPECT_EQ(unrelatedAfterScope, 0u);
    EXPECT_EQ(unrelatedAfterAll, 1u);
}


