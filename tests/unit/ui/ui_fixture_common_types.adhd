    Key,
    Action,
    Selection,
}

class UiFixtureSkinPaintSample{
    public usize quads = 0u;
    public Rect bounds = Rect();
    public Color color = Color();
    public f32 maximumU = 0.0f;
}

class UiFixtureAcceptedInputState<const usize Capacity>{
    public Array<HitTarget, Capacity> targets;
    public usize count = 0u;
    public usize popupCount = 0u;
    public u64 layoutGeneration = 0u;
    public WidgetId focus = WidgetId();
    public WidgetId capture = WidgetId();
}

Point CenterUiRect(in Rect bounds){
    Point center = Point();
    center.x = bounds.x + bounds.width * 0.5f;
    center.y = bounds.y + bounds.height * 0.5f;
    return center;
}

void ExpectUiRect(in Rect actual, in Rect expected){
    EXPECT_FLOAT_EQ(actual.x, expected.x);
    EXPECT_FLOAT_EQ(actual.y, expected.y);
    EXPECT_FLOAT_EQ(actual.width, expected.width);
    EXPECT_FLOAT_EQ(actual.height, expected.height);
}

void ExpectUiRectExact(in Rect actual, in Rect expected){
    EXPECT_EQ(bit_cast<u32>(actual.x), bit_cast<u32>(expected.x));
    EXPECT_EQ(bit_cast<u32>(actual.y), bit_cast<u32>(expected.y));
    EXPECT_EQ(bit_cast<u32>(actual.width), bit_cast<u32>(expected.width));
    EXPECT_EQ(bit_cast<u32>(actual.height), bit_cast<u32>(expected.height));
}

void ExpectUiHitTargetIdentity(in HitTarget actual, in HitTarget expected){
    EXPECT_EQ(actual.id, expected.id);
    EXPECT_EQ(actual.declarationGeneration, expected.declarationGeneration);
    EXPECT_EQ(actual.control, expected.control);
    EXPECT_EQ(actual.owner, expected.owner);
    EXPECT_EQ(actual.enabled, expected.enabled);
}

void ExpectUiAcceptedTarget(in HitTarget after, in HitTarget before, in b8 checkOwnerDeclaration){
    ExpectUiHitTargetIdentity(after, before);
    if(checkOwnerDeclaration)
        EXPECT_EQ(after.ownerDeclarationGeneration, before.ownerDeclarationGeneration);
    EXPECT_EQ(after.popup, before.popup);
    ExpectUiRect(after.rectangle, before.rectangle);
    ExpectUiRect(after.clip, before.clip);
}

void ExpectUiDrawCommandFields(in DrawCommand actual, in DrawCommand expected){
    EXPECT_EQ(actual.firstIndex, expected.firstIndex);
    EXPECT_EQ(actual.indexCount, expected.indexCount);
    EXPECT_EQ(actual.material, expected.material);
    EXPECT_EQ(actual.glyphPageIndex, expected.glyphPageIndex);
    EXPECT_EQ(actual.sdfPageIndex, expected.sdfPageIndex);
    EXPECT_EQ(actual.textureImageIndex, expected.textureImageIndex);
    EXPECT_EQ(actual.sdfChannel, expected.sdfChannel);
    EXPECT_EQ(actual.layer, expected.layer);
}

void ExpectUiSameVertices(in DrawSnapshot actual, in DrawSnapshot expected){
    for(usize index = 0u; index < actual.vertices().size(); ++index){
        const Vertex a = actual.vertices()[index];
        const Vertex e = expected.vertices()[index];
        EXPECT_FLOAT_EQ(a.position.x, e.position.x);
        EXPECT_FLOAT_EQ(a.position.y, e.position.y);
        EXPECT_FLOAT_EQ(a.texCoord.x, e.texCoord.x);
        EXPECT_FLOAT_EQ(a.texCoord.y, e.texCoord.y);
        EXPECT_FLOAT_EQ(a.color.r, e.color.r);
        EXPECT_FLOAT_EQ(a.color.g, e.color.g);
        EXPECT_FLOAT_EQ(a.color.b, e.color.b);
        EXPECT_FLOAT_EQ(a.color.a, e.color.a);
    }
}

void ExpectUiSameDrawCommands(in DrawSnapshot actual, in DrawSnapshot expected){
    for(usize index = 0u; index < actual.commands().size(); ++index){
        const DrawCommand a = actual.commands()[index];
        const DrawCommand e = expected.commands()[index];
        ExpectUiDrawCommandFields(a, e);
        ExpectUiRect(a.clip, e.clip);
    }
}

void ExpectUiSameSnapshotHeader(in DrawSnapshot actual, in DrawSnapshot expected){
    EXPECT_FLOAT_EQ(actual.displayMetrics().logicalWidth, expected.displayMetrics().logicalWidth);
    EXPECT_FLOAT_EQ(actual.displayMetrics().logicalHeight, expected.displayMetrics().logicalHeight);
    EXPECT_FLOAT_EQ(actual.displayMetrics().pixelScaleX, expected.displayMetrics().pixelScaleX);
    EXPECT_FLOAT_EQ(actual.displayMetrics().pixelScaleY, expected.displayMetrics().pixelScaleY);
    EXPECT_EQ(actual.skinBinding().skin, expected.skinBinding().skin);
    EXPECT_EQ(actual.skinBinding().texture, expected.skinBinding().texture);
    EXPECT_EQ(actual.skinBinding().generation, expected.skinBinding().generation);
    EXPECT_EQ(actual.skinBinding().atlasWidth, expected.skinBinding().atlasWidth);
    EXPECT_EQ(actual.skinBinding().atlasHeight, expected.skinBinding().atlasHeight);
    EXPECT_FLOAT_EQ(actual.skinBinding().referenceDensity, expected.skinBinding().referenceDensity);
}

WidgetId RequireUiRootId(in WidgetRoot root){
    const auto id = TryMakeRootId(root);
    EXPECT_TRUE(id.has_value());
    if(id.has_value())
        return id.value();
    return WidgetId();
}

WidgetId RequireUiWidgetId(in WidgetId parent, in AStringView stableKey){
    const auto id = TryMakeWidgetId(parent, stableKey);
    EXPECT_TRUE(id.has_value());
    if(id.has_value())
        return id.value();
    return WidgetId();
}

WidgetId RequireUiWidgetPartId(in WidgetId parent, in u64 partKey){
    const auto id = TryMakeWidgetPartId(parent, partKey);
    EXPECT_TRUE(id.has_value());
    if(id.has_value())
        return id.value();
    return WidgetId();
}

