inline constexpr usize s_PreparedGroupSize = sizeof(PreparedFontImageGroup);
inline constexpr TStringView s_ErrSourceSizeRange = NWB_TEXT("source size must be 1..33554432 bytes");
inline constexpr TStringView s_ErrFtNewMemoryFace = NWB_TEXT("native_operation=FT_New_Memory_Face native_domain=FreeType");
inline constexpr TStringView s_ErrImageHashDiffers = NWB_TEXT("image content hash differs");
inline constexpr TStringView s_ErrSfntHashDiffers = NWB_TEXT("SFNT content hash differs");

inline constexpr Array<AStringView, 2u> s_BundledFontFilenames = { "latin.font", "korean.font" };
inline constexpr Array<u32, 4u> s_UnsupportedSignatures = { 0x74746366u, 0x774f4646u, 0x774f4632u, 0x74727565u };
inline constexpr Array<u32, 2u> s_VariableTags = { 0x66766172u, 0x43464632u };
inline constexpr Array<AStringView, 5u> s_CorruptImageFilenames = {
    "image_r.font",
    "image_rg.font",
    "image_rgb.font",
    "image_rgba.font",
    "image_hash.font",
};
inline constexpr Array<AStringView, 2u> s_CorruptSfntFilenames = { "font_corrupt_bytes.font", "font_corrupt_hash.font" };

