Path MakeTelemetryPublicationTestDirectory(){
    Path root = Path();
    const Expected<Path, ErrorCode> executableDirectory = ExecutablePaths().directory();
    if(executableDirectory.has_value()){
        for(u32 attempt = 0u; attempt < 128u; ++attempt){
            const String name = StringFormat("telemetry_publication_test_{}_{}", CurrentProcessId(), attempt);
            const Path candidate = executableDirectory.value() / StringView(name);
            const Expected<b8, ErrorCode> created = CreateDirectories(candidate);
            if(!created.has_value())
                break;
            if(created.value()){
                root = candidate;
                break;
            }
        }
    }
    return root;
}


