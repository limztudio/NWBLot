#include <impl/assets_shader/variant_planner.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type ShaderEntryVector = Vector<ShaderCookEntry>;
type IncludeMetadataMap = ShaderIncludeMap;

class PreparedShaderEntry{
    public ShaderCookEntry entry;
    public Path sourcePath;
    public Vector<Path> includeDirectories;
    public Vector<Path> dependencies;
    public u64 dependencyChecksum = 0u;
    public u64 variantCount = 0u;
    public String materialTypedBindingInterfacePath;
    public Name materialTypedBindingInterface = s_NameNone;
    public b8 compilerInputsHaveBom = false;
    public b8 usesMaterialTypedBinding = false;
    public b8 supportsCsgClipVariant = false;
    public b8 supportsAvboitCsgClipVariant = false;
}

class PreparedShaderPlan{
    public Vector<PreparedShaderEntry> preparedEntries;
    public u64 plannedFileCount = 0u;
}


