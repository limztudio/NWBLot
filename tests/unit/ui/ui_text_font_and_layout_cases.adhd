void VerifyTextGlyphVisibilityTests_TouchingEdgesAndEmptyAreasAreInvisible(){
    const Rect clip = Rect(10.0f, 20.0f, 30.0f, 40.0f);
    Array<Rect, 6u> rectangles;
    rectangles[0u] = Rect(0.0f, 20.0f, 10.0f, 1.0f);
    rectangles[1u] = Rect(40.0f, 20.0f, 1.0f, 1.0f);
    rectangles[2u] = Rect(10.0f, 10.0f, 1.0f, 10.0f);
    rectangles[3u] = Rect(10.0f, 60.0f, 1.0f, 1.0f);
    rectangles[4u] = Rect(10.0f, 20.0f, 0.0f, 1.0f);
    rectangles[5u] = Rect(10.0f, 20.0f, 1.0f, 0.0f);
    for(in Rect rectangle : rectangles)
        EXPECT_EQ(TryIntersectTextRects(rectangle, clip), TextGlyphIntersection::Invisible);
    EXPECT_EQ(TryIntersectTextRects(clip, Rect(10.0f, 20.0f, 0.0f, 40.0f)), TextGlyphIntersection::Invisible);
}

void VerifyTextGlyphVisibilityTests_InvalidRectanglesAndOverflowingEndpointsAreRejected(){
    const Rect clip = Rect(0.0f, 0.0f, 100.0f, 100.0f);
    Array<Rect, 5u> invalid;
    invalid[0u] = Rect(bit_cast<f32>(s_UiTextFontLayoutQuietNaNF32Bits), 0.0f, 1.0f, 1.0f);
    invalid[1u] = Rect(0.0f, bit_cast<f32>(s_UiTextFontLayoutPosInfF32Bits), 1.0f, 1.0f);
    invalid[2u] = Rect(0.0f, 0.0f, -1.0f, 1.0f);
    invalid[3u] = Rect(0.0f, 0.0f, 1.0f, -1.0f);
    invalid[4u] = Rect(f32.max, 0.0f, f32.max, 1.0f);
    for(in Rect rectangle : invalid){
        EXPECT_EQ(TryIntersectTextRects(rectangle, clip), TextGlyphIntersection::Invalid);
        EXPECT_EQ(TryIntersectTextRects(clip, rectangle), TextGlyphIntersection::Invalid);
    }
}

void VerifyTextGlyphVisibilityTests_NativeCoverageOriginSnapsToWholePhysicalPixelsAtOneToOneScale(){
    PlacedGlyph glyph = PlacedGlyph();
    glyph.position = Point(0.25f, 0.25f);
    AtlasGlyph record = AtlasGlyph();
    record.pageIndex = 0u;
    record.pixels = Rect(0.0f, 0.0f, 5.0f, 7.0f);
    record.bearingX = -2;
    record.bearingY = 3;
    auto rectangle = UiTextGlyphCoverageRect(glyph, record, 1.0f, Point(10.0f, 20.0f), Point(1.0f, 1.0f));
    ASSERT_TRUE(rectangle.has_value());
    ExpectUiRect(rectangle.value(), Rect(8.0f, 17.0f, 5.0f, 7.0f));
    rectangle = UiTextGlyphCoverageRect(glyph, record, 1.0f, Point(10.5f, 20.5f), Point(1.0f, 1.0f));
    ASSERT_TRUE(rectangle.has_value());
    ExpectUiRect(rectangle.value(), Rect(9.0f, 18.0f, 5.0f, 7.0f));
}

void VerifyTextGlyphVisibilityTests_NativeCoverageOriginSnapsUsingEachPhysicalPixelScale(){
    PlacedGlyph glyph = PlacedGlyph();
    glyph.position = Point(0.25f, 0.25f);
    AtlasGlyph record = AtlasGlyph();
    record.pageIndex = 0u;
    record.pixels = Rect(0.0f, 0.0f, 6.0f, 9.0f);
    record.bearingX = -3;
    record.bearingY = 6;
    auto rectangle = UiTextGlyphCoverageRect(glyph, record, 1.5f, Point(4.25f, 8.25f), Point(1.5f, 1.5f));
    ASSERT_TRUE(rectangle.has_value());
    ExpectUiRect(rectangle.value(), Rect(4.0f / 1.5f, 7.0f / 1.5f, 4.0f, 6.0f));
    rectangle = UiTextGlyphCoverageRect(glyph, record, 1.5f, Point(4.25f, 8.25f), Point(1.0f, 1.5f));
    ASSERT_TRUE(rectangle.has_value());
    ExpectUiRect(rectangle.value(), Rect(3.0f, 7.0f / 1.5f, 4.0f, 6.0f));
}

void VerifyTextGlyphVisibilityTests_InvalidCoverageGeometryRejectsTheResult(){
    PlacedGlyph glyph = PlacedGlyph();
    AtlasGlyph record = AtlasGlyph();
    record.pageIndex = 0u;
    record.pixels = Rect(0.0f, 0.0f, 1.0f, 1.0f);
    Array<f32, 4u> invalidScales;
    invalidScales[0u] = 0.0f;
    invalidScales[1u] = -1.0f;
    invalidScales[2u] = bit_cast<f32>(s_UiTextFontLayoutPosInfF32Bits);
    invalidScales[3u] = bit_cast<f32>(s_UiTextFontLayoutQuietNaNF32Bits);
    for(in f32 scale : invalidScales)
        EXPECT_FALSE(UiTextGlyphCoverageRect(glyph, record, scale, Point()).has_value());
    record.pixels.width = -1.0f;
    EXPECT_FALSE(UiTextGlyphCoverageRect(glyph, record, 1.0f, Point()).has_value());
    record.pixels.width = 1.0f;
    glyph.position.x = bit_cast<f32>(s_UiTextFontLayoutQuietNaNF32Bits);
    EXPECT_FALSE(UiTextGlyphCoverageRect(glyph, record, 1.0f, Point()).has_value());
}

void VerifyTextGlyphVisibilityTests_InvalidPhysicalPixelScalesRejectNativeCoverage(){
    PlacedGlyph glyph = PlacedGlyph();
    glyph.coverage = MakeUiTextFontLayoutCoverage(Rect(1.0f, 2.0f, 3.0f, 4.0f), true);
    AtlasGlyph record = AtlasGlyph();
    record.pageIndex = 0u;
    record.pixels = Rect(0.0f, 0.0f, 3.0f, 4.0f);
    Array<Point, 6u> invalidScales;
    invalidScales[0u] = Point(0.0f, 1.0f);
    invalidScales[1u] = Point(-1.0f, 1.0f);
    invalidScales[2u] = Point(bit_cast<f32>(s_UiTextFontLayoutPosInfF32Bits), 1.0f);
    invalidScales[3u] = Point(1.0f, 0.0f);
    invalidScales[4u] = Point(1.0f, -1.0f);
    invalidScales[5u] = Point(1.0f, bit_cast<f32>(s_UiTextFontLayoutQuietNaNF32Bits));
    for(in Point pixelScale : invalidScales){
        EXPECT_FALSE(UiTextGlyphCoverageRect(glyph, record, 1.0f, Point(), pixelScale).has_value());
        EXPECT_EQ(UiTextGlyphCandidateNoAtlas(glyph, 16.0f, 16.0f, Point(), Rect(0.0f, 0.0f, 10.0f, 10.0f), pixelScale), TextGlyphIntersection::Invalid);
    }
}

void VerifyTextGlyphVisibilityTests_UnrepresentableCoverageGeometryRejectsTheResult(){
    PlacedGlyph glyph = PlacedGlyph();
    glyph.position = Point(f32.max, 0.0f);
    AtlasGlyph record = AtlasGlyph();
    record.pageIndex = 0u;
    record.pixels = Rect(0.0f, 0.0f, 2.0f, 2.0f);
    EXPECT_FALSE(UiTextGlyphCoverageRect(glyph, record, 1.0f, Point(f32.max, 0.0f)).has_value());
    glyph.position = Point();
    EXPECT_FALSE(UiTextGlyphCoverageRect(glyph, record, 1.0e-39f, Point()).has_value());
}

void VerifyTextGlyphVisibilityTests_MissingNativeFaceAndCoverageBoundsRejectsUnknownInk(){
    PlacedGlyph glyph = PlacedGlyph();
    glyph.position = Point(10000.0f, 10000.0f);
    const Rect clip = Rect(0.0f, 0.0f, 100.0f, 100.0f);
    EXPECT_EQ(UiTextGlyphCandidateNoAtlas(glyph, 16.0f, 16.0f, Point(), clip), TextGlyphIntersection::Invalid);
    glyph.ink = Rect(-1.0f, -2.0f, 3.0f, 4.0f);
    EXPECT_EQ(UiTextGlyphCandidateNoAtlas(glyph, 16.0f, 16.0f, Point(), clip), TextGlyphIntersection::Invalid);
    glyph.coverage = MakeUiTextFontLayoutCoverage(glyph.ink, true);
    EXPECT_EQ(UiTextGlyphCandidateNoAtlas(glyph, 16.0f, 16.0f, Point(), clip), TextGlyphIntersection::Invisible);
}

void VerifyTextGlyphVisibilityTests_KnownEmptyNativeOutlinesDoNotRequirePreparation(){
    PlacedGlyph glyph = PlacedGlyph();
    glyph.coverage.known = true;
    const Rect clip = Rect(0.0f, 0.0f, 100.0f, 100.0f);
    EXPECT_EQ(UiTextGlyphCandidateNoAtlas(glyph, 16.0f, 16.0f, Point(), clip), TextGlyphIntersection::Invisible);
    glyph.coverage.ink = Rect(20.0f, 30.0f, 0.0f, 10.0f);
    EXPECT_EQ(UiTextGlyphCandidateNoAtlas(glyph, 16.0f, 16.0f, Point(), clip), TextGlyphIntersection::Invisible);
    glyph.coverage.ink = Rect(20.0f, 30.0f, 10.0f, 0.0f);
    EXPECT_EQ(UiTextGlyphCandidateNoAtlas(glyph, 16.0f, 16.0f, Point(), clip), TextGlyphIntersection::Invisible);
}

void VerifyTextGlyphVisibilityTests_NativeBoundsTakePriorityOverCompetingShapingInk(){
    PlacedGlyph glyph = PlacedGlyph();
    glyph.ink = Rect(10000.0f, 10000.0f, 1.0f, 1.0f);
    glyph.coverage = MakeUiTextFontLayoutCoverage(Rect(10.0f, 10.0f, 1.0f, 1.0f), true);
    const Rect clip = Rect(0.0f, 0.0f, 20.0f, 20.0f);
    EXPECT_EQ(UiTextGlyphCandidateNoAtlas(glyph, 16.0f, 16.0f, Point(), clip), TextGlyphIntersection::Visible);
    glyph.ink = Rect(10.0f, 10.0f, 1.0f, 1.0f);
    glyph.coverage.ink = Rect(10000.0f, 10000.0f, 1.0f, 1.0f);
    EXPECT_EQ(UiTextGlyphCandidateNoAtlas(glyph, 16.0f, 16.0f, Point(), clip), TextGlyphIntersection::Invisible);
}

void VerifyTextGlyphVisibilityTests_NativeRasterAllowanceTracksPhysicalScale(){
    PlacedGlyph glyph = PlacedGlyph();
