void VerifyTextVisibleCoverageTests_MoreThan4096DistinctHiddenHangulDoNotExhaustTheVisiblePrefixCache(mut TextVisibleCoverageTests self){
    const usize hiddenCount = s_GlyphAtlasMaxGlyphs + 1u;
    String text = "A\n";
    text.reserve(2u + hiddenCount * 3u);
    const u32 s_HangulSyllableBase = 0xac00u;
    for(u32 index = 0u; index < cast<u32>(hiddenCount); ++index)
        ASSERT_TRUE(AppendUiUtf8CodePoint(text, s_HangulSyllableBase + index));
    ASSERT_TRUE(self.applyLayout(MakeUiTextRegionDefaultShapeRequest(StringView(text.data(), text.size()))));
    ASSERT_EQ(self.m_layout.lines().size(), 2u);
    ASSERT_EQ(self.m_layout.glyphs().size(), hiddenCount + 1u);
    ASSERT_TRUE(self.m_text.measure(self.m_layout, DisplayMetrics(800.0f, 600.0f, 1.0f, 1.0f)).has_value());
    const Rect clip = Rect(0.0f, 0.0f, 100.0f, 20.0f + self.m_layout.lines()[1u].top);
    Vector<u32> ids = Vector<u32>();
    ids.reserve(hiddenCount);
    for(usize glyphIndex = 0u; glyphIndex < self.m_layout.glyphs().size(); ++glyphIndex){
        const PlacedGlyph glyph = self.m_layout.glyphs()[glyphIndex];
        if(glyph.byteBegin < 2u)
            continue;
        EXPECT_EQ(FontFaceIdentityName(glyph.face), Name(s_TestKoreanFontPath));
        EXPECT_TRUE(glyph.coverage.known);
        EXPECT_GT(glyph.coverage.ink.width, 0.0f);
        EXPECT_GT(glyph.coverage.ink.height, 0.0f);
        EXPECT_GE(ComputePlacedGlyphOutlineRect(glyph, Point(20.0f, 20.0f)).y, clip.height);
        ids.push_back(glyph.glyphId);
    }
    SortUiGlyphIds(ids);
    ASSERT_EQ(ids.size(), hiddenCount);
    for(usize index = 1u; index < ids.size(); ++index)
        ASSERT_NE(ids[index], ids[index - 1u]);
    self.beginPaint(1u);
    ASSERT_TRUE(self.paintClipped(self.m_layout, clip));
    const DrawSnapshot prefix = self.m_paint.freeze();
    ASSERT_EQ(prefix.glyphPages().size(), 1u);
    EXPECT_EQ(GlyphPageBindingOf(prefix.glyphPages()[0u]).font.name(), Name(s_TestLatinFontPath));
    EXPECT_EQ(prefix.vertices().size(), 4u);
    EXPECT_EQ(prefix.indices().size(), 6u);
    const PlacedGlyph reveal = self.m_layout.glyphs()[hiddenCount / 2u];
    const Point origin = Point(20.0f - reveal.position.x - reveal.ink.x, 20.0f - reveal.position.y - reveal.ink.y);
    self.beginPaint(2u);
    ASSERT_TRUE(self.paintClipped(self.m_layout, Rect(20.0f, 20.0f, 80.0f, 40.0f), origin));
    const DrawSnapshot revealed = self.m_paint.freeze();
    ASSERT_EQ(revealed.glyphPages().size(), 1u);
    EXPECT_EQ(GlyphPageBindingOf(revealed.glyphPages()[0u]).font.name(), Name(s_TestKoreanFontPath));
    EXPECT_FALSE(revealed.vertices().empty());
    self.beginPaint(3u);
    ASSERT_TRUE(self.paintClipped(self.m_layout, clip));
    const DrawSnapshot warm = self.m_paint.freeze();
    ASSERT_EQ(warm.glyphPages().size(), 1u);
    EXPECT_EQ(warm.glyphPages()[0u], prefix.glyphPages()[0u]);
}

void VerifyTextVisibleCoverageTests_HiddenGlyphKeepsTheWarmPageExactUntilItIsRevealed(mut TextVisibleCoverageTests self){
    ASSERT_TRUE(self.applyLayout(MakeUiTextRegionDefaultShapeRequest("A\nB")));
    ASSERT_EQ(self.m_layout.lines().size(), 2u);
    const Rect clip = Rect(0.0f, 0.0f, 100.0f, 20.0f + self.m_layout.lines()[1u].top);
    self.beginPaint(1u);
    ASSERT_TRUE(self.paintClipped(self.m_layout, clip));
    const DrawSnapshot first = self.m_paint.freeze();
    ASSERT_EQ(first.glyphPages().size(), 1u);
    ASSERT_EQ(first.vertices().size(), 4u);
    const SharedGlyphPage original = first.glyphPages()[0u];
    const Span<u8> initialPixels = GlyphPagePixelsOf(original);
    Vector<u8> pixels = Vector<u8>();
    pixels.reserve(initialPixels.size());
    for(usize index = 0u; index < initialPixels.size(); ++index)
        pixels.push_back(initialPixels[index]);
    self.beginPaint(2u);
    ASSERT_TRUE(self.paintClipped(self.m_layout, clip));
    const DrawSnapshot hidden = self.m_paint.freeze();
    ExpectUiTextVisibleSamePaint(hidden, first);
    self.beginPaint(3u);
    ASSERT_TRUE(self.m_text.paint(self.m_paint, self.m_layout, Point(20.0f, 20.0f)));
    const DrawSnapshot revealed = self.m_paint.freeze();
    ASSERT_EQ(revealed.glyphPages().size(), 1u);
    EXPECT_NE(revealed.glyphPages()[0u], original);
    EXPECT_GT(GlyphPageBindingOf(revealed.glyphPages()[0u]).generation, GlyphPageBindingOf(original).generation);
    EXPECT_EQ(revealed.vertices().size(), 8u);
    const Span<u8> retainedPixels = GlyphPagePixelsOf(original);
    ASSERT_EQ(retainedPixels.size(), pixels.size());
    for(usize index = 0u; index < retainedPixels.size(); ++index)
        EXPECT_EQ(retainedPixels[index], pixels[index]);
}

void VerifyTextVisibleCoverageTests_HiddenOversizedGlyphCannotRejectOrUpgradePriorVisibleCoverage(mut TextVisibleCoverageTests self){
    ASSERT_TRUE(self.applyLayout(MakeUiTextRegionDefaultShapeRequest(s_UiTextVisibleSampleGlyphText)));
    TextLayout oversized = TextLayout(self.m_arena);
    auto oversizedLayoutResult = self.m_text.layout(MakeUiTextRegionShapeRequest(s_UiTextVisibleWideGlyphText, 1024.0f));
    ASSERT_TRUE(TextVisibleFixture::AdoptLayoutInto(oversizedLayoutResult, oversized));
    self.beginPaint(1u);
    ASSERT_TRUE(self.m_text.paint(self.m_paint, self.m_layout, Point(20.0f, 20.0f)));
    const DrawSnapshot before = self.m_paint.freeze();
    self.beginPaint(2u);
    ASSERT_TRUE(self.m_text.paint(self.m_paint, self.m_layout, Point(20.0f, 20.0f)));
    ASSERT_TRUE(self.m_text.paint(self.m_paint, oversized, Point(10000.0f, 10000.0f)));
    const DrawSnapshot hidden = self.m_paint.freeze();
    ExpectUiTextVisibleSamePaint(hidden, before);
    ASSERT_TRUE(self.applyLayout(MakeUiTextRegionDefaultShapeRequest(s_UiTextVisibleWideGlyphText)));
    self.beginPaint(3u);
    ASSERT_TRUE(self.m_text.paint(self.m_paint, self.m_layout, Point(20.0f, 20.0f)));
    const DrawSnapshot ordinary = self.m_paint.freeze();
    ASSERT_EQ(ordinary.glyphPages().size(), 1u);
    EXPECT_GT(GlyphPageBindingOf(ordinary.glyphPages()[0u]).generation, GlyphPageBindingOf(before.glyphPages()[0u]).generation);
    EXPECT_EQ(ordinary.vertices().size(), 4u);
}

void VerifyTextVisibleCoverageTests_EmptyIntersectedClipAndZeroAlphaNeverPrepareOversizedCoverage(mut TextVisibleCoverageTests self){
    ASSERT_TRUE(self.applyLayout(MakeUiTextRegionShapeRequest(s_UiTextVisibleWideGlyphText, 1024.0f)));
    self.beginPaint(1u);
    self.m_paint.fillRect(Rect(1.0f, 1.0f, 4.0f, 4.0f));
    self.m_paint.pushClip(Rect(10.0f, 10.0f, 20.0f, 20.0f));
    self.m_paint.pushClip(Rect(40.0f, 40.0f, 20.0f, 20.0f));
    EXPECT_TRUE(self.m_text.paint(self.m_paint, self.m_layout, Point(20.0f, 20.0f)));
    ASSERT_TRUE(self.m_paint.popClip());
    ASSERT_TRUE(self.m_paint.popClip());
    EXPECT_TRUE(self.m_text.paint(self.m_paint, self.m_layout, Point(20.0f, 20.0f), Color(1.0f, 1.0f, 1.0f, 0.0f)));
    const DrawSnapshot snapshot = self.m_paint.freeze();
    EXPECT_TRUE(snapshot.glyphPages().empty());
    EXPECT_TRUE(snapshot.sdfPages().empty());
    EXPECT_EQ(snapshot.vertices().size(), 4u);
    EXPECT_EQ(snapshot.indices().size(), 6u);
    ASSERT_TRUE(self.applyLayout(MakeUiTextRegionDefaultShapeRequest(s_UiTextVisibleWideGlyphText)));
    self.beginPaint(2u);
    ASSERT_TRUE(self.m_text.paint(self.m_paint, self.m_layout, Point(20.0f, 20.0f)));
    EXPECT_FALSE(self.m_paint.freeze().glyphPages().empty());
}

void VerifyTextVisibleCoverageTests_FractionalUnequalDpiKeepsAHintedRasterSliverOutsideTheShapedOutline(mut TextVisibleCoverageTests self){
    const DisplayMetrics display = DisplayMetrics(200.0f, 100.0f, 1.25f, 1.5f);
    const Point origin = Point(40.375f, 20.125f);
    ASSERT_TRUE(self.applyLayout(MakeUiTextRegionShapeRequest(s_UiTextVisibleWideGlyphText, 17.25f)));
    ASSERT_EQ(self.m_layout.glyphs().size(), 1u);
    const auto raster = self.rasterRectangle(self.m_layout.glyphs()[0u], self.m_layout.fontSize(), display, origin);
    ASSERT_TRUE(raster.has_value());
    const Rect clip = ComputeUiTextVisibleRasterFringe(raster.value(), ComputePlacedGlyphOutlineRect(self.m_layout.glyphs()[0u], origin));
    ASSERT_GT(clip.width, 0.0f);
    ASSERT_GT(clip.height, 0.0f);
    self.beginPaint(1u, display);
    ASSERT_TRUE(self.paintClipped(self.m_layout, clip, origin));
    const DrawSnapshot snapshot = self.m_paint.freeze();
    ASSERT_EQ(snapshot.glyphPages().size(), 1u);
    ASSERT_EQ(snapshot.vertices().size(), 4u);
    EXPECT_FLOAT_EQ(snapshot.vertices()[0u].position.x, clip.x);
    EXPECT_FLOAT_EQ(snapshot.vertices()[0u].position.y, clip.y);
    EXPECT_NEAR(snapshot.vertices()[2u].position.x, clip.x + clip.width, 0.0001f);
    EXPECT_NEAR(snapshot.vertices()[2u].position.y, clip.y + clip.height, 0.0001f);
}

void VerifyTextVisibleCoverageTests_FractionalOriginPlacesNativeCoverageOnThePhysicalPixelGrid(mut TextVisibleCoverageTests self){
    const DisplayMetrics display = DisplayMetrics(200.0f, 100.0f, 1.25f, 1.5f);
    const Point origin = Point(40.375f, 20.125f);
    ASSERT_TRUE(self.applyLayout(MakeUiTextRegionShapeRequest("g", 17.25f)));
    ASSERT_EQ(self.m_layout.glyphs().size(), 1u);
    const auto raster = self.rasterRectangle(self.m_layout.glyphs()[0u], self.m_layout.fontSize(), display, origin);
    ASSERT_TRUE(raster.has_value());
    self.beginPaint(1u, display);
    ASSERT_TRUE(self.m_text.paint(self.m_paint, self.m_layout, origin));
    const DrawSnapshot snapshot = self.m_paint.freeze();
    ASSERT_EQ(snapshot.glyphPages().size(), 1u);
    ASSERT_EQ(snapshot.vertices().size(), 4u);
    EXPECT_NEAR(snapshot.vertices()[0u].position.x, raster.value().x, 0.0001f);
    EXPECT_NEAR(snapshot.vertices()[0u].position.y, raster.value().y, 0.0001f);
}

void VerifyTextVisibleCoverageTests_NegativeBearingRemainsVisibleToTheLeftOfTheGlyphOrigin(mut TextVisibleCoverageTests self){
    const Point origin = Point(50.0f, 20.0f);
    const DisplayMetrics display = DisplayMetrics(200.0f, 100.0f, 1.25f, 1.25f);
    ASSERT_TRUE(self.applyLayout(MakeUiTextRegionShapeRequest("j", 32.0f)));
    ASSERT_EQ(self.m_layout.glyphs().size(), 1u);
    const auto raster = self.rasterRectangle(self.m_layout.glyphs()[0u], self.m_layout.fontSize(), display, origin);
    ASSERT_TRUE(raster.has_value());
    const f32 glyphOrigin = origin.x + self.m_layout.glyphs()[0u].position.x;
    ASSERT_LT(raster.value().x, glyphOrigin);
    const Rect clip = Rect(raster.value().x, raster.value().y, (glyphOrigin - raster.value().x) * 0.5f, raster.value().height);
    self.beginPaint(1u, display);
    ASSERT_TRUE(self.paintClipped(self.m_layout, clip, origin));
    const DrawSnapshot snapshot = self.m_paint.freeze();
    ASSERT_EQ(snapshot.vertices().size(), 4u);
    EXPECT_LT(snapshot.vertices()[2u].position.x, glyphOrigin);
    EXPECT_EQ(snapshot.glyphPages().size(), 1u);
}

void VerifyTextVisibleCoverageTests_CombiningMarkOnlyClipKeepsItsOffsetGlyphAndExcludesTheBaseQuad(mut TextVisibleCoverageTests self){
    const Point origin = Point(50.0f, 20.0f);
    const DisplayMetrics display = DisplayMetrics(200.0f, 100.0f, 1.5f, 1.5f);
    ASSERT_TRUE(self.applyLayout(MakeUiTextRegionShapeRequest("x\xcc\x81", 32.0f)));
    ASSERT_EQ(self.m_layout.glyphs().size(), 2u);
    ASSERT_EQ(self.m_layout.clusters().size(), 1u);
    const auto base = self.rasterRectangle(self.m_layout.glyphs()[0u], self.m_layout.fontSize(), display, origin);
    ASSERT_TRUE(base.has_value());
    const auto mark = self.rasterRectangle(self.m_layout.glyphs()[1u], self.m_layout.fontSize(), display, origin);
    ASSERT_TRUE(mark.has_value());
    ASSERT_LT(mark.value().y, base.value().y);
    const Rect clip = Rect(mark.value().x, mark.value().y, mark.value().width, Min(mark.value().height, base.value().y - mark.value().y) * 0.5f);
    self.beginPaint(1u, display);
    ASSERT_TRUE(self.paintClipped(self.m_layout, clip, origin));
    const DrawSnapshot snapshot = self.m_paint.freeze();
    ASSERT_EQ(snapshot.vertices().size(), 4u);
    ASSERT_EQ(snapshot.indices().size(), 6u);
    EXPECT_LT(snapshot.vertices()[2u].position.y, base.value().y);
    EXPECT_EQ(snapshot.glyphPages().size(), 1u);
}

void VerifyTextVisibleCoverageTests_SixtyThreePriorImagesLeaveRoomForOnlyTheVisibleCoverageFace(mut TextVisibleCoverageTests self){
    ASSERT_TRUE(self.applyLayout(MakeUiTextRegionDefaultShapeRequest("A\n\xed\x95\x9c")));
    ASSERT_EQ(self.m_layout.lines().size(), 2u);
    const Rect clip = Rect(0.0f, 0.0f, 100.0f, 20.0f + self.m_layout.lines()[1u].top);
    Vector<SharedGlyphPage> prior = Vector<SharedGlyphPage>();
    prior.reserve(s_PaintMaxImages - 1u);
    for(usize index = 0u; index < s_PaintMaxImages - 1u; ++index){
        const auto pageResult = self.makePage(u64.max - index);
        ASSERT_TRUE(pageResult.has_value());
        const SharedGlyphPage page = pageResult.value();
        ASSERT_TRUE(cast<b8>(page));
        prior.push_back(page);
    }
    self.beginPaint(1u);
    ASSERT_TRUE(self.m_paint.prepareGlyphPages(prior));
    ASSERT_TRUE(self.paintClipped(self.m_layout, clip));
    const DrawSnapshot snapshot = self.m_paint.freeze();
    ASSERT_EQ(snapshot.glyphPages().size(), s_PaintMaxImages);
    EXPECT_EQ(snapshot.vertices().size(), 4u);
    EXPECT_TRUE(snapshot.sdfPages().empty());
    for(usize index = 0u; index < prior.size(); ++index)
        EXPECT_EQ(snapshot.glyphPages()[index], prior[index]);
    EXPECT_EQ(GlyphPageBindingOf(snapshot.glyphPages()[snapshot.glyphPages().size() - 1u]).font.name(), Name(s_TestLatinFontPath));
    self.beginPaint(2u);
    ASSERT_TRUE(self.m_text.paint(self.m_paint, self.m_layout, Point(20.0f, 20.0f)));
    const DrawSnapshot revealed = self.m_paint.freeze();
    EXPECT_EQ(revealed.glyphPages().size(), 2u);
    EXPECT_EQ(revealed.vertices().size(), 8u);
}

void VerifyTextVisibleCoverageTests_OversizedMeasurementDoesNotAdmitAtlasCoverage(mut TextVisibleCoverageTests self){
    const auto layout = self.m_text.layout(MakeUiTextRegionDefaultShapeRequest("Previous gyjpq A\xcc\x81\xcc\x81 g\xcc\xa3 \xed\x95\x9c\xea\xb8\x80"));
    ASSERT_TRUE(layout.has_value());
    const auto large = self.m_text.layout(MakeUiTextRegionShapeRequest(s_UiTextVisibleWideGlyphText, 1024.0f));
    ASSERT_TRUE(large.has_value());
    ASSERT_TRUE(self.m_text.measure(large.value(), DisplayMetrics(800.0f, 600.0f, 1.0f, 1.0f)).has_value());
    self.beginPaint(1u);
    ASSERT_TRUE(self.m_text.paint(self.m_paint, layout.value(), Point(20.0f, 20.0f)));
    const DrawSnapshot snapshot = self.m_paint.freeze();
    ASSERT_FALSE(snapshot.glyphPages().empty());
    EXPECT_EQ(GlyphPageBindingOf(snapshot.glyphPages()[0u]).generation, 1u);
}

void VerifyTextVisibleCoverageTests_NaturalMeasurementContainsNativeMarksFallbackAndEveryTestedPixelPhase(mut TextVisibleCoverageTests self){
    Array<StringView, 8u> samples;
    samples[0u] = "Previous";
    samples[1u] = "Next";
    samples[2u] = "gyjpq";
    samples[3u] = "\xc3\x81\xc3\x89\xc3\x8d\xc3\x93\xc3\x9a \xc3\x87";
    samples[4u] = "A\xcc\x81\xcc\x81";
    samples[5u] = "g\xcc\xa3";
    samples[6u] = "\xed\x95\x9c\xea\xb8\x80";
    samples[7u] = "Edit me: \xed\x95\x9c\xea\xb8\x80";
    Array<f32, 3u> sizes;
    sizes[0u] = 12.0f;
    sizes[1u] = 14.0f;
    sizes[2u] = 16.0f;
    Array<Point, 5u> scales;
    scales[0u] = Point(1.0f, 1.0f);
    scales[1u] = Point(1.25f, 1.25f);
    scales[2u] = Point(1.5f, 1.5f);
    scales[3u] = Point(2.0f, 2.0f);
    scales[4u] = Point(1.25f, 1.5f);
    Array<f32, 4u> phases;
    phases[0u] = 0.0f;
    phases[1u] = 0.25f;
    phases[2u] = 0.53125f;
    phases[3u] = 0.9375f;
    for(usize sizeIndex = 0u; sizeIndex < sizes.size(); ++sizeIndex){
        const f32 size = sizes[sizeIndex];
        for(usize sampleIndex = 0u; sampleIndex < samples.size(); ++sampleIndex){
            const StringView sample = samples[sampleIndex];
            const auto layout = self.m_text.layout(MakeUiTextRegionShapeRequest(sample, size));
            ASSERT_TRUE(layout.has_value());
            for(usize scaleIndex = 0u; scaleIndex < scales.size(); ++scaleIndex){
                const Point scale = scales[scaleIndex];
                const DisplayMetrics display = DisplayMetrics(800.0f, 600.0f, scale.x, scale.y);
                const auto measured = self.m_text.measure(layout.value(), display);
                ASSERT_TRUE(measured.has_value());
                const u32 presetSize = cast<u32>(Ceil(size * Max(scale.x, scale.y)));
                for(usize phaseIndex = 0u; phaseIndex < phases.size(); ++phaseIndex){
                    const f32 phase = phases[phaseIndex];
                    const Rect content = Rect(32.0f + phase, 24.0f + phase, measured.value().width, measured.value().height);
                    const Point origin = Point(content.x - measured.value().x, content.y - measured.value().y);
                    const f32 contentLimitX = content.x + content.width + 0.0001f;
                    const f32 contentLimitY = content.y + content.height + 0.0001f;
                    const usize glyphCount = layout.value().glyphs().size();
                    for(usize glyphIndex = 0u; glyphIndex < glyphCount; ++glyphIndex){
                        const PlacedGlyph glyph = layout.value().glyphs()[glyphIndex];
                        const auto preset = FontFaceRasterBounds(glyph.face, glyph.glyphId, presetSize);
                        ASSERT_TRUE(preset.has_value());
                        const b8 emptyPreset = preset.value().width == 0.0f || preset.value().height == 0.0f;
                        if(emptyPreset)
                            continue;
                        const auto raster = self.rasterRectangle(glyph, size, display, origin);
                        ASSERT_TRUE(raster.has_value());
                        EXPECT_GE(raster.value().x + 0.0001f, content.x);
                        EXPECT_GE(raster.value().y + 0.0001f, content.y);
                        EXPECT_LE(raster.value().x + raster.value().width, contentLimitX);
                        EXPECT_LE(raster.value().y + raster.value().height, contentLimitY);
                    }
                }
            }
        }
    }
}

void VerifyTextVisibleCoverageTests_NaturalSdfMeasurementExcludesTransparentSpreadAndContainsShaderCoverage(mut TextVisibleCoverageTests self){
    const auto initial = self.m_text.layout(MakeUiTextRegionShapeRequest(s_UiTextVisibleSampleGlyphText, 32.0f));
    ASSERT_TRUE(initial.has_value());
    ASSERT_EQ(initial.value().glyphs().size(), 1u);
    ASSERT_TRUE(self.installMeasuredSdfAtlas(initial.value().glyphs()[0u].glyphId));
    Array<f32, 3u> fontSizes;
    fontSizes[0u] = 16.0f;
    fontSizes[1u] = 24.0f;
    fontSizes[2u] = 32.0f;
    Array<Point, 5u> scales;
    scales[0u] = Point(1.0f, 1.0f);
    scales[1u] = Point(1.5f, 1.5f);
    scales[2u] = Point(2.0f, 2.0f);
    scales[3u] = Point(1.25f, 2.0f);
    scales[4u] = Point(2.0f, 0.75f);
    Array<f32, 4u> phases;
    phases[0u] = 0.0f;
    phases[1u] = 0.25f;
    phases[2u] = 0.53125f;
    phases[3u] = 0.9375f;
    usize visibleSamples = 0u;
    for(usize fontSizeIndex = 0u; fontSizeIndex < fontSizes.size(); ++fontSizeIndex){
        const f32 fontSize = fontSizes[fontSizeIndex];
        const auto layout = self.m_text.layout(MakeUiTextRegionShapeRequest(s_UiTextVisibleSampleGlyphText, fontSize));
        ASSERT_TRUE(layout.has_value());
        const PlacedGlyph placed = layout.value().glyphs()[0u];
        ASSERT_TRUE(FontFaceHasBakedAtlas(placed.face));
        const SharedBakedFontAtlas atlas = FontFaceBakedAtlas(placed.face);
        const FontAtlasGlyph record = FontFaceBakedGlyph(placed.face, placed.glyphId);
        const SharedSdfAtlasPage page = FontFaceBakedPage(placed.face, record.group);
        for(usize scaleIndex = 0u; scaleIndex < scales.size(); ++scaleIndex){
            const Point scale = scales[scaleIndex];
            const f32 physicalSize = fontSize * Max(scale.x, scale.y);
            if(physicalSize < 24.0f || physicalSize > 48.0f)
                continue;
            const DisplayMetrics display = DisplayMetrics(800.0f, 600.0f, scale.x, scale.y);
            const auto measured = self.m_text.measure(layout.value(), display);
            ASSERT_TRUE(measured.has_value());
            const auto relativePlane = UiTextVisibleAtlasRect(placed, atlas, fontSize, Point());
            ASSERT_TRUE(relativePlane.has_value());
            EXPECT_GT(measured.value().x, relativePlane.value().x);
            EXPECT_GT(measured.value().y, relativePlane.value().y);
            for(usize phaseIndex = 0u; phaseIndex < phases.size(); ++phaseIndex){
                const f32 phase = phases[phaseIndex];
                const Rect content = Rect(100.0f + phase, 100.0f + phase * 0.5f, measured.value().width, measured.value().height);
                const Point origin = Point(content.x - measured.value().x, content.y - measured.value().y);
                const f32 contentLimitX = content.x + content.width + 0.0001f;
                const f32 contentLimitY = content.y + content.height + 0.0001f;
                const auto plane = UiTextVisibleAtlasRect(placed, atlas, fontSize, origin);
                ASSERT_TRUE(plane.has_value());
                const f32 planeRight = plane.value().x + plane.value().width;
                const f32 planeBottom = plane.value().y + plane.value().height;
                const i32 firstX = cast<i32>(Floor(plane.value().x * scale.x));
                const i32 firstY = cast<i32>(Floor(plane.value().y * scale.y));
                const i32 lastX = cast<i32>(Ceil(planeRight * scale.x));
                const i32 lastY = cast<i32>(Ceil(planeBottom * scale.y));
                const VectorSingle planeStart = VectorSingle(plane.value().x, plane.value().y, 0.0f, 0.0f);
                const VectorSingle pixelScale = VectorSingle(scale.x, scale.y, 1.0f, 1.0f);
                const VectorSingle recordStart = VectorSingle(cast<f32>(record.x), cast<f32>(record.y), 0.0f, 0.0f);
                const VectorSingle recordSize = VectorSingle(cast<f32>(record.width), cast<f32>(record.height), 0.0f, 0.0f);
                const VectorSingle planeSize = VectorSingle(plane.value().width, plane.value().height, 1.0f, 1.0f);
                const VectorSingle halfPixel = VectorSingle(0.5f, 0.5f, 0.5f, 0.5f);
                for(i32 y = firstY; y < lastY; ++y){
                    for(i32 x = firstX; x < lastX; ++x){
                        const f32 pointX = (cast<f32>(x) + 0.5f) / scale.x;
                        const f32 pointY = (cast<f32>(y) + 0.5f) / scale.y;
                        if(pointX < plane.value().x || pointY < plane.value().y || pointX >= planeRight || pointY >= planeBottom)
                            continue;
                        const VectorSingle centerCur = (VectorSingle(cast<f32>(x), cast<f32>(y), 0.0f, 0.0f) + halfPixel) / pixelScale;
                        const VectorSingle centerPartnerX = (VectorSingle(cast<f32>(x ^ 1), cast<f32>(y), 0.0f, 0.0f) + halfPixel) / pixelScale;
                        const VectorSingle centerPartnerY = (VectorSingle(cast<f32>(x), cast<f32>(y ^ 1), 0.0f, 0.0f) + halfPixel) / pixelScale;
                        const f32 current = SampleUiMeasuredSdfDistance(page, record.channel, recordStart + ((centerCur - planeStart) * recordSize) / planeSize);
                        const f32 partnerX = SampleUiMeasuredSdfDistance(page, record.channel, recordStart + ((centerPartnerX - planeStart) * recordSize) / planeSize);
                        const f32 partnerY = SampleUiMeasuredSdfDistance(page, record.channel, recordStart + ((centerPartnerY - planeStart) * recordSize) / planeSize);
                        // Quad lanes share a finite difference with their horizontal and vertical partners, including helpers outside the plane.
                        const f32 derivative = Abs(partnerX - current) + Abs(partnerY - current);
                        if(0.5f + current / Max(derivative, 0.001f) <= 0.0f)
                            continue;
                        ++visibleSamples;
                        EXPECT_GE(pointX + 0.0001f, content.x);
                        EXPECT_GE(pointY + 0.0001f, content.y);
                        EXPECT_LE(pointX, contentLimitX);
                        EXPECT_LE(pointY, contentLimitY);
                    }
                }
            }
        }
    }
    EXPECT_GT(visibleSamples, 100u);
}


