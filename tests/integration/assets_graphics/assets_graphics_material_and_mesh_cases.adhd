void VerifyAssetsGraphics_MaterialBindDependencyInvalidation(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    native(in logger, mut testArena){
        auto cookCase = PrepareAssetsGraphicsCookCase(testArena, "material_bind_dependency_invalidation");
        ASSERT_TRUE(cookCase);
        Path& root = cookCase->root;
        Path& outputDirectory = cookCase->outputDirectory;

        const Path assetRoot = root / s_AssetsDirectory;
        ASSERT_TRUE(MaterialBindFixture::WriteMaterialBindMaterialIntegrationAssetsWithPixelSource(
            testArena, assetRoot, s_MinimalMaterialBindSource, s_BlockScopedMaterialMeta, s_MaterialBindShaderProbeSource
        ));

        EXPECT_TRUE(CookPreparedGraphicsAssetRoots(testArena, root, outputDirectory, { assetRoot }));

        UniquePtr<NWB::Core::Assets::IAsset> loadedAsset;
        auto loadedAssetLoadResult = LoadCookedMaterial(testArena, outputDirectory, Name(s_ProjectMaterialsTestMaterial));
        ASSERT_TRUE(loadedAssetLoadResult);
        loadedAsset = Move(*loadedAssetLoadResult);
        if(!loadedAsset)
            return;

        const NWB::Impl::Material& material = static_cast<const NWB::Impl::Material&>(*loadedAsset);
        const u64 initialLayoutHash = material.typedLayoutHash();

        NWB::Core::GraphicsVector<NWB::Core::ShaderArchive::Record> records(testArena.arena);
        auto recordsLoadResult = ShaderArchiveFixture::LoadCookedShaderArchiveRecords(testArena, outputDirectory);
        ASSERT_TRUE(recordsLoadResult);
        records = Move(*recordsLoadResult);
        u64 initialPixelSourceChecksum = 0u;
        auto initialPixelSourceChecksumLoadResult = ShaderArchiveFixture::FindShaderArchiveSourceChecksum(records, Name(s_MaterialPixelShaderPath), Name(s_ShaderStagePs));
        ASSERT_TRUE(initialPixelSourceChecksumLoadResult);
        initialPixelSourceChecksum = *initialPixelSourceChecksumLoadResult;

        EXPECT_TRUE(WriteTextFile(assetRoot / s_MaterialInterfacesDirectory / s_SurfaceBindFilename, s_UpdatedDefaultMaterialBindSource));
        EXPECT_TRUE(CookPreparedGraphicsAssetRoots(testArena, root, outputDirectory, { assetRoot }));

        loadedAsset.reset();
        auto loadedAssetLoadResult2 = LoadCookedMaterial(testArena, outputDirectory, Name(s_ProjectMaterialsTestMaterial));
        ASSERT_TRUE(loadedAssetLoadResult2);
        loadedAsset = Move(*loadedAssetLoadResult2);
        if(loadedAsset){
            const NWB::Impl::Material& updatedMaterial = static_cast<const NWB::Impl::Material&>(*loadedAsset);
            EXPECT_NE(updatedMaterial.typedLayoutHash(), initialLayoutHash);
        }

        records.clear();
        auto recordsLoadResult2 = ShaderArchiveFixture::LoadCookedShaderArchiveRecords(testArena, outputDirectory);
        ASSERT_TRUE(recordsLoadResult2);
        records = Move(*recordsLoadResult2);
        u64 updatedPixelSourceChecksum = 0u;
        auto updatedPixelSourceChecksumLoadResult = ShaderArchiveFixture::FindShaderArchiveSourceChecksum(records, Name(s_MaterialPixelShaderPath), Name(s_ShaderStagePs));
        ASSERT_TRUE(updatedPixelSourceChecksumLoadResult);
        updatedPixelSourceChecksum = *updatedPixelSourceChecksumLoadResult;
        EXPECT_NE(updatedPixelSourceChecksum, initialPixelSourceChecksum);
        EXPECT_EQ(logger.errorCount(), 0u);

        EXPECT_TRUE(RemoveAllIfExists(root));
    }
}

void VerifyAssetsGraphics_MaterialBindDiscoveryValidation(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    native(in logger, mut testArena){
        auto cookCase = PrepareAssetsGraphicsCookCase(testArena, "material_bind_valid");
        ASSERT_TRUE(cookCase);
        Path& root = cookCase->root;
        Path& outputDirectory = cookCase->outputDirectory;
        EXPECT_TRUE(MaterialBindFixture::CookMinimalMeshWithMaterialBind(s_MinimalMaterialBindSource, *cookCase, testArena));

        const Path generatedIncludePath = root / s_CacheDirectory / s_TestsConfiguration / s_MaterialBindIncludesDirectory / s_ProjectVirtualRoot / s_MaterialInterfacesDirectory / s_SurfaceBindFilename;
        // Removing the last bind source must clear its generated include on a recook with the same cache.
        const Path assetRoot = root / s_AssetsDirectory;
        const auto removedBind = RemoveFile(assetRoot / s_MaterialInterfacesDirectory / s_SurfaceBindFilename);
        ASSERT_TRUE(removedBind);
        ASSERT_TRUE(*removedBind);
        ASSERT_TRUE(CookPreparedGraphicsAssetRoots(testArena, root, outputDirectory, { assetRoot }));
        const auto generatedIncludeExists = FileExists(generatedIncludePath);
        ASSERT_TRUE(generatedIncludeExists);
        EXPECT_FALSE(*generatedIncludeExists);
        EXPECT_EQ(logger.errorCount(), 0u);
        EXPECT_TRUE(RemoveAllIfExists(root));
#if defined(NWB_FINAL)
        auto duplicateIncludeCookCase = PrepareAssetsGraphicsCookCase(testArena, "material_bind_duplicate_include_path");
        ASSERT_TRUE(duplicateIncludeCookCase);
        Path& duplicateIncludeRoot = duplicateIncludeCookCase->root;
        EXPECT_FALSE(MaterialBindFixture::EmitDuplicateGeneratedMaterialBindIncludePath(testArena, *duplicateIncludeCookCase));
        EXPECT_TRUE(logger.sawErrorContaining(NWB_TEXT("duplicate material bind include path 'project/material_interfaces/test_surface.bind'")));

        EXPECT_TRUE(RemoveAllIfExists(duplicateIncludeRoot));

        auto invalidCookCase = PrepareAssetsGraphicsCookCase(testArena, "material_bind_duplicate_field");
        ASSERT_TRUE(invalidCookCase);
        Path& invalidRoot = invalidCookCase->root;
        EXPECT_FALSE(MaterialBindFixture::CookMinimalMeshWithMaterialBind(s_DuplicateFieldMaterialBindSource, *invalidCookCase, testArena));
        EXPECT_TRUE(logger.sawErrorContaining(NWB_TEXT("duplicate struct field declaration")));

        EXPECT_TRUE(RemoveAllIfExists(invalidRoot));
#endif
    }
}

