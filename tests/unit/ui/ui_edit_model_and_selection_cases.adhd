void VerifyUiEditHistoryTests_BranchingAfterUndoDiscardsOnlyFutureHistory(mut UiEditHistoryTests self){
    ASSERT_TRUE(self.m_model.replaceSelection("a"));
    ASSERT_TRUE(self.m_model.replaceSelection("b"));
    ASSERT_TRUE(self.m_model.undo());
    ASSERT_TRUE(self.m_model.replaceSelection("c"));
    EXPECT_EQ(self.m_model.text(), "ac");
    EXPECT_FALSE(self.m_model.canRedo());
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "a");
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_TRUE(self.m_model.text().empty());
}

void VerifyUiEditHistoryTests_SelectionNavigationAndValidNoopPreserveRedo(mut UiEditHistoryTests self){
    ASSERT_TRUE(self.m_model.replaceSelection("a"));
    ASSERT_TRUE(self.m_model.replaceSelection("b"));
    ASSERT_TRUE(self.m_model.undo());
    ASSERT_TRUE(self.m_model.move(EditMove::Home));
    ASSERT_TRUE(self.m_model.replaceSelection(""));
    EXPECT_TRUE(self.m_model.canRedo());
    ASSERT_TRUE(self.m_model.redo());
    EXPECT_EQ(self.m_model.text(), "ab");
}

void VerifyUiEditHistoryTests_RecordBoundEvictsOldestCompleteRecords(mut UiEditHistoryTests self){
    EditModel limited = EditModel(MakeUiEditLimits(16u, 2u, 128u));
    ASSERT_TRUE(limited.replaceSelection("a"));
    ASSERT_TRUE(limited.replaceSelection("b"));
    ASSERT_TRUE(limited.replaceSelection("c"));
    ASSERT_TRUE(limited.undo());
    EXPECT_EQ(limited.text(), "ab");
    ASSERT_TRUE(limited.undo());
    EXPECT_EQ(limited.text(), "a");
    EXPECT_FALSE(limited.undo());
    ASSERT_TRUE(limited.redo());
    ASSERT_TRUE(limited.redo());
    EXPECT_EQ(limited.text(), "abc");
}

void VerifyUiEditHistoryTests_ByteBoundAdmitsCompleteNewestRecord(mut UiEditHistoryTests self){
    EditModel limited = EditModel(MakeUiEditLimits(16u, 8u, 6u));
    ASSERT_TRUE(limited.replaceSelection("a"));
    ASSERT_TRUE(limited.replaceSelection("b"));
    ASSERT_TRUE(limited.replaceSelection("c"));
    ASSERT_TRUE(limited.undo());
    EXPECT_EQ(limited.text(), "ab");
    EXPECT_FALSE(limited.undo());
    ASSERT_TRUE(limited.redo());
    EXPECT_EQ(limited.text(), "abc");
}

void VerifyUiEditHistoryTests_OversizedHistoryRecordClearsEarlierUndoToPreventSkippingLatestEdit(mut UiEditHistoryTests self){
    EditModel limited = EditModel(MakeUiEditLimits(32u, 8u, 4u));
    ASSERT_TRUE(limited.replaceSelection("a"));
    ASSERT_TRUE(limited.replaceSelection("b"));
    EXPECT_TRUE(limited.canUndo());
    ASSERT_TRUE(limited.replaceSelection("c"));
    EXPECT_EQ(limited.text(), "abc");
    EXPECT_FALSE(limited.canUndo());
    EXPECT_FALSE(limited.canRedo());
}

void VerifyUiEditHistoryTests_DisabledHistoryAndCopiedReplacementHaveBoundedOwnership(mut UiEditHistoryTests self){
    EditModel limited = EditModel(MakeUiEditLimits(32u, 0u, 0u));
    String replacement = "owned";
    ASSERT_TRUE(limited.replaceSelection(replacement));
    replacement.assign("other");
    EXPECT_EQ(limited.text(), "owned");
    EXPECT_FALSE(limited.undo());
    EXPECT_FALSE(limited.redo());
}

void VerifyUiEditHistoryTests_NormalizedMultilinePasteUndoRestoresPriorDocument(mut UiEditHistoryTests self){
    EditModel multiline = EditModel(EditLimits(), EditTextMode::Multiline);
    ASSERT_TRUE(multiline.setText("abcdef\nx\nabcdef\n???"));
    ASSERT_TRUE(multiline.selectAll());
    ASSERT_TRUE(self.replaceSelectionWithNormalizedMultiline(multiline, "ab\r\ncdef\r\nxy"));
    EXPECT_EQ(multiline.text(), "ab\ncdef\nxy");
    ASSERT_TRUE(multiline.undo());
    EXPECT_EQ(multiline.text(), "abcdef\nx\nabcdef\n???");
}


