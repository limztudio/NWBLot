    ASSERT_TRUE(self.m_builder.drawImage(first, rectangle));
    ASSERT_TRUE(self.m_builder.drawImage(first, rectangle, MakeUiPaintOverlayRect(0.0f, 0.0f, 1.0f, 1.0f), MakeUiPaintOverlayColor(1.0f, 0.0f, 0.0f, 0.5f)));
    ASSERT_TRUE(self.m_builder.drawImage(second, rectangle));
