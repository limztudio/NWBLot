    const ::Span<const SharedGlyphPage> glyphs,
    const SharedSdfAtlasPage& sdf,
    const SharedImageSource& image
){
    return builder.prepareImages(glyphs, ::Span(&sdf, 1u), ::Span(&image, 1u));
}
