enum<u8> HardwareRayTracingPolicy{
    Disabled = 0,
    Automatic,
    kCount
}

b8 IsValidHardwareRayTracingPolicy(in HardwareRayTracingPolicy policy){
    return policy == HardwareRayTracingPolicy::Disabled || policy == HardwareRayTracingPolicy::Automatic;
}

class SinglePassStereoState{
    public u8 renderTargetIndexOffset = 0u;
    public b8 enabled = false;
    public b8 independentViewportMask = false;
}

class TimerQueryRecordingEndpoints{
    public b8 recordsBegin = false;
    public b8 recordsEnd = false;
}

class DispatchIndirectArguments{
    public u32 groupsX = 1u;
    public u32 groupsY = 1u;
    public u32 groupsZ = 1u;
}

class WaveLaneCountRange{
    public u32 maxWaveLaneCount = 0u;
}

class PresentationFailure{
    public b8 presentationAccepted = false;
}

