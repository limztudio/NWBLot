type EcsPhysicsPreStepCallback = Func<64u, void(mut World, mut PhysicsWorld, in f32)>;
type EcsContactBeginCallback = Func<64u, void(in EcsContactBeginEvent)>;
type EcsContactEndCallback = Func<64u, void(in EcsContactEndEvent)>;
type EcsContactPersistCallback = Func<64u, void(in EcsContactPersistEvent)>;
type EcsContactHitCallback = Func<64u, void(in EcsContactHitEvent)>;
type EcsSensorBeginCallback = Func<64u, void(in EcsSensorBeginEvent)>;
type EcsSensorEndCallback = Func<64u, void(in EcsSensorEndEvent)>;
type EcsSensorStayCallback = Func<64u, void(in EcsSensorStayEvent)>;
type EcsBodyMoveCallback = Func<64u, void(in EcsBodyMoveEvent)>;
type EcsBodyWakeCallback = Func<64u, void(in EcsBodyWakeEvent)>;
type EcsJointBreakCallback = Func<64u, void(in EcsJointBreakEvent)>;
type EcsCharacterEventCallback = Func<64u, void(in EcsCharacterControllerEvent)>;
type EcsCharacterGroundChangedCallback = Func<64u, void(in EcsCharacterGroundChangedEvent)>;
type EcsVehicleEventCallback = Func<64u, void(in EcsVehicleTelemetryEvent)>;
type EcsVehicleStateCallback = Func<64u, void(in EcsVehicleStateEvent)>;
type EcsFluidSplashCallback = Func<64u, void(in EcsFluidSplashEvent)>;
type EcsFluidVolumeCallback = Func<64u, void(in EcsFluidVolumeEvent)>;
type EcsSoftBodyTearCallback = Func<64u, void(in EcsSoftBodyTearEvent)>;
type EcsSoftBodyConstraintTearCallback = Func<64u, void(in EcsSoftBodyConstraintTearEvent)>;
type EcsSoftBodyImpactCallback = Func<64u, void(in EcsSoftBodyImpactEvent)>;
type EcsFractureEventCallback = Func<64u, void(in EcsFractureEvent)>;


void AppendEventSpan<T>(in Span<T> src, mut Vector<T> dst){
    if(src.empty())
        return;
    dst.reserve(dst.size() + src.size());
    for(usize i = 0u; i < src.size(); ++i)
        dst.push_back(src[i]);
}

void PublishEventSpan<T>(in Vector<T> src, mut World world){
    for(usize i = 0u; i < src.size(); ++i)
        world.postMessage(src[i]);
}


void CollectSortedEntities<T>(mut World world, mut Vector<EntityID> outEntities){
    outEntities.clear();
    const auto view = world.view<T>();
    outEntities.reserve(view.candidateCount());
    for(in auto row : view)
        outEntities.push_back(Get<0>(row));
    SortSequence<EntityID>(outEntities, lambda[](in EntityID lhs, in EntityID rhs) -> b8{
        return lhs.id < rhs.id;
    });
}

