const u32 s_UiSkinMaxRegionCount = 4096u;
const f32 s_UiSkinPaletteRgbMax = 16.0f;
const f32 s_UiSkinDefaultFontSize = 16.0f;
const f32 s_UiSkinMinDefaultFontSizeScale = 64.0f;
const f32 s_UiSkinMinDefaultFontSize = 1.0f / s_UiSkinMinDefaultFontSizeScale;
const f32 s_UiSkinMaxDefaultFontSize = 2048.0f;
const u32 s_UiSkinBinaryMagic = 0x55495331u; // UIS1
const u32 s_UiSkinBinaryVersion = 3u;
const u32 s_UiSkinPaletteColorCount = 17u;

const Name s_WindowResizeRegionName = "window.resize";
const Name s_WhiteRegionName = "white";
const StringView s_UiSkinDrawModeSprite = "sprite";
const StringView s_UiSkinDrawModeNineSlice = "nine_slice";

[reflect]
enum<u8> UiSkinDrawMode{
    Sprite = 0u,
    NineSlice
}

// Atlas rectangles and slice borders use top-left-origin pixels; padding and minimum sizes use logical units.
[reflect]
class UiSkinRect{
    public u32 x = 0u;
    public u32 y = 0u;
    public u32 width = 0u;
    public u32 height = 0u;
}

[reflect]
class UiSkinSliceInsets{
    public u32 left = 0u;
    public u32 top = 0u;
    public u32 right = 0u;
    public u32 bottom = 0u;
}

[reflect]
class UiSkinInsets{
    public f32 left = 0.0f;
    public f32 top = 0.0f;
    public f32 right = 0.0f;
    public f32 bottom = 0.0f;
}

[reflect]
class UiSkinRegion{
    public Name name = s_NameNone;
    public UiSkinRect rectangle;
    public UiSkinSliceInsets sliceInsets;
    public UiSkinInsets padding;
    public f32 minimumWidth = 0.0f;
    public f32 minimumHeight = 0.0f;
    public UiSkinDrawMode drawMode = UiSkinDrawMode::Sprite;
}

[reflect]
enum<u8> UiSkinColorRole{
    TextNormal,
    TextDisabled,
    TextTooltip,
    EditBackground,
    EditSelection,
    EditInactiveSelection,
    EditCaret,
    EditPreedit,
    ScrollbarTrack,
    ScrollbarThumb,
    ScrollbarDisabled,
    PopupBackdrop,
    ControlHoverTint,
    ControlPressedTint,
    ControlDisabledTint,
    ProgressTrackTint,
    ProgressFillTint,
    kCount
}

[serialize, reflect]
class UiSkinColor{
    public f32 r = 0.0f;
    public f32 g = 0.0f;
    public f32 b = 0.0f;
    public f32 a = 0.0f;
}

[serialize, reflect]
class UiSkinTypography{
    public f32 defaultFontSize = s_UiSkinDefaultFontSize;
}

[serialize]
class UiSkinHeaderBinary{
    public u32 magic = s_UiSkinBinaryMagic;
    public u32 version = s_UiSkinBinaryVersion;
    public NameHash textureNameHash;
    public u32 atlasWidth = 0u;
    public u32 atlasHeight = 0u;
    public f32 referenceDensity = 1.0f;
    public u32 regionCount = 0u;
    public u32 reserved0 = 0u;
    public u32 reserved1 = 0u;
}

[serialize]
class UiSkinRegionBinary{
    public NameHash nameHash;
    public u32 x = 0u;
    public u32 y = 0u;
    public u32 width = 0u;
    public u32 height = 0u;
    public u32 sliceLeft = 0u;
    public u32 sliceTop = 0u;
    public u32 sliceRight = 0u;
    public u32 sliceBottom = 0u;
    public f32 paddingLeft = 0.0f;
    public f32 paddingTop = 0.0f;
    public f32 paddingRight = 0.0f;
    public f32 paddingBottom = 0.0f;
    public f32 minimumWidth = 0.0f;
    public f32 minimumHeight = 0.0f;
    public u32 drawMode = 0u;
    public u32 reserved = 0u;
}

const UiSkinColor s_DefaultTextNormalColor(0.92f, 0.94f, 0.98f, 1.0f);
const UiSkinColor s_DefaultTextDisabledColor(0.48f, 0.5f, 0.55f, 1.0f);
const UiSkinColor s_DefaultTextTooltipColor(1.0f, 1.0f, 1.0f, 1.0f);
const UiSkinColor s_DefaultEditBackgroundColor(0.08f, 0.1f, 0.14f, 1.0f);
const UiSkinColor s_DefaultEditSelectionColor(0.2f, 0.4f, 0.78f, 0.75f);
const UiSkinColor s_DefaultEditInactiveSelectionColor(0.28f, 0.31f, 0.38f, 0.55f);
const UiSkinColor s_DefaultEditCaretColor(0.95f, 0.97f, 1.0f, 1.0f);
const UiSkinColor s_DefaultEditPreeditColor(0.5f, 0.72f, 1.0f, 1.0f);
const UiSkinColor s_DefaultScrollbarTrackColor(0.08f, 0.1f, 0.14f, 1.0f);
const UiSkinColor s_DefaultScrollbarThumbColor(0.35f, 0.4f, 0.48f, 1.0f);
const UiSkinColor s_DefaultScrollbarDisabledColor(0.25f, 0.28f, 0.32f, 1.0f);
const UiSkinColor s_DefaultPopupBackdropColor(0.0f, 0.0f, 0.0f, 0.4f);
const UiSkinColor s_DefaultControlHoverTintColor(1.08f, 1.08f, 1.08f, 1.0f);
const UiSkinColor s_DefaultControlPressedTintColor(0.85f, 0.85f, 0.85f, 1.0f);
const UiSkinColor s_DefaultControlDisabledTintColor(0.55f, 0.55f, 0.55f, 0.6f);
const UiSkinColor s_DefaultProgressTrackTintColor(1.0f, 1.0f, 1.0f, 1.0f);
const UiSkinColor s_DefaultProgressFillTintColor(1.0f, 1.0f, 1.0f, 1.0f);

[reflect]
class UiSkinPalette{
    public UiSkinPalette(){
        this.colors[0u] = s_DefaultTextNormalColor;
        this.colors[1u] = s_DefaultTextDisabledColor;
        this.colors[2u] = s_DefaultTextTooltipColor;
        this.colors[3u] = s_DefaultEditBackgroundColor;
        this.colors[4u] = s_DefaultEditSelectionColor;
        this.colors[5u] = s_DefaultEditInactiveSelectionColor;
        this.colors[6u] = s_DefaultEditCaretColor;
        this.colors[7u] = s_DefaultEditPreeditColor;
        this.colors[8u] = s_DefaultScrollbarTrackColor;
        this.colors[9u] = s_DefaultScrollbarThumbColor;
        this.colors[10u] = s_DefaultScrollbarDisabledColor;
        this.colors[11u] = s_DefaultPopupBackdropColor;
        this.colors[12u] = s_DefaultControlHoverTintColor;
        this.colors[13u] = s_DefaultControlPressedTintColor;
        this.colors[14u] = s_DefaultControlDisabledTintColor;
        this.colors[15u] = s_DefaultProgressTrackTintColor;
        this.colors[16u] = s_DefaultProgressFillTintColor;
    }

    public Array<UiSkinColor, s_UiSkinPaletteColorCount> colors;
}

const u64 s_UiSkinLinearLookupRegionLimit = 128u;

const StringView s_UiSkinDiagnosticPrefix = "UI skin meta";
const StringView s_UiSkinNameField = "name";
const StringView s_UiSkinRectField = "rect";
const StringView s_UiSkinDrawModeField = "draw_mode";
const StringView s_UiSkinSliceField = "slice";
const StringView s_UiSkinPaddingField = "padding";
const StringView s_UiSkinMinimumSizeField = "minimum_size";
const StringView s_UiSkinColorsField = "colors";
const StringView s_UiSkinRgbaField = "rgba";
const StringView s_UiSkinTypographyField = "typography";
const StringView s_UiSkinDefaultFontSizeField = "default_font_size";
const StringView s_UiSkinTextureField = "texture";
const StringView s_UiSkinAtlasExtentField = "atlas_extent";
const StringView s_UiSkinReferenceDensityField = "reference_density";
const StringView s_UiSkinToolkitContractField = "toolkit_contract";
const StringView s_UiSkinRegionsField = "regions";
const StringView s_UiSkinWidgetsContract = "widgets";
const StringView s_UiSkinDrawModeHint = "must be 'sprite' or 'nine_slice'";

const u64 s_UiSkinRectComponentCount = 4u;
const u64 s_UiSkinSliceComponentCount = 4u;
const u64 s_UiSkinPaddingComponentCount = 4u;
const u64 s_UiSkinMinimumSizeComponentCount = 2u;
const u64 s_UiSkinAtlasExtentComponentCount = 2u;
const u64 s_UiSkinRgbaComponentCount = 4u;
const u64 s_UiSkinAlphaComponentIndex = 3u;
const f32 s_UiSkinPaletteChannelMin = 0.0f;
const f32 s_UiSkinPaletteAlphaMax = 1.0f;

class UiSkinRequiredRegion{
    public UiSkinRequiredRegion(){
        this.name = s_NameNone;
        this.text = "";
    }

    public UiSkinRequiredRegion(in Name _name, in StringView _text){
        this.name = _name;
        this.text = _text;
    }

    public Name name;
    public StringView text;
}

const usize s_UiSkinRequiredRegionCount = 30u;

UiSkinRequiredRegion ResolveUiSkinRequiredRegion(in usize index){
    switch(index){
    case 0u:
        return UiSkinRequiredRegion(Name("panel.normal"), "panel.normal");
    case 1u:
        return UiSkinRequiredRegion(Name("window.normal"), "window.normal");
    case 2u:
        return UiSkinRequiredRegion(Name("window.title"), "window.title");
    case 3u:
        return UiSkinRequiredRegion(Name("window.collapse"), "window.collapse");
    case 4u:
        return UiSkinRequiredRegion(Name("separator"), "separator");
    case 5u:
        return UiSkinRequiredRegion(Name("button.normal"), "button.normal");
    case 6u:
        return UiSkinRequiredRegion(Name("checkbox.normal"), "checkbox.normal");
    case 7u:
        return UiSkinRequiredRegion(Name("checkbox.mark"), "checkbox.mark");
    case 8u:
        return UiSkinRequiredRegion(Name("edit.normal"), "edit.normal");
    case 9u:
        return UiSkinRequiredRegion(Name("list.background"), "list.background");
    case 10u:
        return UiSkinRequiredRegion(Name("list.row.normal"), "list.row.normal");
    case 11u:
        return UiSkinRequiredRegion(Name("list.row.hover"), "list.row.hover");
    case 12u:
        return UiSkinRequiredRegion(Name("list.row.selected"), "list.row.selected");
    case 13u:
        return UiSkinRequiredRegion(Name("list.row.disabled"), "list.row.disabled");
    case 14u:
        return UiSkinRequiredRegion(Name("scroll.track"), "scroll.track");
    case 15u:
        return UiSkinRequiredRegion(Name("scroll.thumb"), "scroll.thumb");
    case 16u:
        return UiSkinRequiredRegion(Name("scrollbar.track"), "scrollbar.track");
    case 17u:
        return UiSkinRequiredRegion(Name("scrollbar.thumb.normal"), "scrollbar.thumb.normal");
    case 18u:
        return UiSkinRequiredRegion(Name("popup.normal"), "popup.normal");
    case 19u:
        return UiSkinRequiredRegion(Name("tooltip.normal"), "tooltip.normal");
    case 20u:
        return UiSkinRequiredRegion(Name("combo.normal"), "combo.normal");
    case 21u:
        return UiSkinRequiredRegion(Name("combo.arrow"), "combo.arrow");
    case 22u:
        return UiSkinRequiredRegion(Name("radio.normal"), "radio.normal");
    case 23u:
        return UiSkinRequiredRegion(Name("radio.checked"), "radio.checked");
    case 24u:
        return UiSkinRequiredRegion(Name("radio.mark"), "radio.mark");
    case 25u:
        return UiSkinRequiredRegion(Name("slider.track"), "slider.track");
    case 26u:
        return UiSkinRequiredRegion(Name("slider.thumb.normal"), "slider.thumb.normal");
    case 27u:
        return UiSkinRequiredRegion(Name("progress.track"), "progress.track");
    case 28u:
        return UiSkinRequiredRegion(Name("progress.fill"), "progress.fill");
    case 29u:
        return UiSkinRequiredRegion(Name("focus.overlay"), "focus.overlay");
    default:
        return UiSkinRequiredRegion();
    }
}

b8 IsAllowedUiSkinMetadataField(in StringView field){
    return
        field == s_UiSkinTextureField
        || field == s_UiSkinAtlasExtentField
        || field == s_UiSkinReferenceDensityField
        || field == s_UiSkinToolkitContractField
        || field == s_UiSkinRegionsField
        || field == s_UiSkinColorsField
        || field == s_UiSkinTypographyField
    ;
}

b8 IsAllowedUiSkinRegionField(in StringView field, in b8 hasSlice){
    return
        field == s_UiSkinNameField
        || field == s_UiSkinRectField
        || field == s_UiSkinDrawModeField
        || field == s_UiSkinPaddingField
        || field == s_UiSkinMinimumSizeField
        || (hasSlice && field == s_UiSkinSliceField)
    ;
}

b8 IsAllowedUiSkinPaletteRoleField(in StringView field){
    return field == s_UiSkinNameField || field == s_UiSkinRgbaField;
}

b8 IsAllowedUiSkinTypographyField(in StringView field){
    return field == s_UiSkinDefaultFontSizeField;
}

u64 ResolveUiSkinColorRole(in StringView name){
    if(name == "text.normal")
        return cast<u64>(UiSkinColorRole::TextNormal);
    if(name == "text.disabled")
        return cast<u64>(UiSkinColorRole::TextDisabled);
    if(name == "text.tooltip")
        return cast<u64>(UiSkinColorRole::TextTooltip);
    if(name == "edit.background")
        return cast<u64>(UiSkinColorRole::EditBackground);
    if(name == "edit.selection")
        return cast<u64>(UiSkinColorRole::EditSelection);
    if(name == "edit.inactive_selection")
        return cast<u64>(UiSkinColorRole::EditInactiveSelection);
    if(name == "edit.caret")
        return cast<u64>(UiSkinColorRole::EditCaret);
    if(name == "edit.preedit")
        return cast<u64>(UiSkinColorRole::EditPreedit);
    if(name == "scrollbar.track")
        return cast<u64>(UiSkinColorRole::ScrollbarTrack);
    if(name == "scrollbar.thumb")
        return cast<u64>(UiSkinColorRole::ScrollbarThumb);
    if(name == "scrollbar.disabled")
        return cast<u64>(UiSkinColorRole::ScrollbarDisabled);
    if(name == "popup.backdrop")
        return cast<u64>(UiSkinColorRole::PopupBackdrop);
    if(name == "control.hover_tint")
        return cast<u64>(UiSkinColorRole::ControlHoverTint);
    if(name == "control.pressed_tint")
        return cast<u64>(UiSkinColorRole::ControlPressedTint);
    if(name == "control.disabled_tint")
        return cast<u64>(UiSkinColorRole::ControlDisabledTint);
    if(name == "progress.track_tint")
        return cast<u64>(UiSkinColorRole::ProgressTrackTint);
    if(name == "progress.fill_tint")
        return cast<u64>(UiSkinColorRole::ProgressFillTint);
    return cast<u64>(UiSkinColorRole::kCount);
}

b8 IsValidUiSkinPaletteChannelValue(in f32 value, in u64 componentIndex){
    if(value < s_UiSkinPaletteChannelMin)
        return false;
    if(componentIndex == s_UiSkinAlphaComponentIndex)
        return value <= s_UiSkinPaletteAlphaMax;
    return value <= s_UiSkinPaletteRgbMax;
}

b8 IsValidUiSkinDefaultFontSize(in f32 defaultFontSize){
    return defaultFontSize >= s_UiSkinMinDefaultFontSize && defaultFontSize <= s_UiSkinMaxDefaultFontSize;
}

Expected<f64x4> TryLoadUiSkinSliceExtents(in UiSkinRegion region){
    if(region.rectangle.width == 0u || region.rectangle.height == 0u)
        return makeUnexpected(Failure());
    const u64 horizontal = cast<u64>(region.sliceInsets.left) + cast<u64>(region.sliceInsets.right);
    const u64 vertical = cast<u64>(region.sliceInsets.top) + cast<u64>(region.sliceInsets.bottom);
    if(region.drawMode == UiSkinDrawMode::Sprite){
        if(horizontal != 0u || vertical != 0u)
            return makeUnexpected(Failure());
    }
    else if(region.drawMode == UiSkinDrawMode::NineSlice){
        if(horizontal > cast<u64>(region.rectangle.width) || vertical > cast<u64>(region.rectangle.height))
            return makeUnexpected(Failure());
    }
    else
        return makeUnexpected(Failure());
    return f64x4(cast<f64>(horizontal), cast<f64>(vertical), 0.0, 0.0);
}

b8 IsValidUiSkinRegionRectAndSlices(in UiSkinRegion region, in u32 atlasWidth, in u32 atlasHeight){
    const UiSkinRect rectangle = region.rectangle;
    if(rectangle.x > atlasWidth || rectangle.y > atlasHeight || rectangle.width > atlasWidth - rectangle.x || rectangle.height > atlasHeight - rectangle.y)
        return false;

    return TryLoadUiSkinSliceExtents(region).has_value();
}

b8 IsValidUiSkinPaletteColor(in UiSkinColor color){
    return isFinite(color.r) && IsValidUiSkinPaletteChannelValue(color.r, 0u)
        && isFinite(color.g) && IsValidUiSkinPaletteChannelValue(color.g, 1u)
        && isFinite(color.b) && IsValidUiSkinPaletteChannelValue(color.b, 2u)
        && isFinite(color.a) && IsValidUiSkinPaletteChannelValue(color.a, s_UiSkinAlphaComponentIndex)
    ;
}

b8 IsValidUiSkinHeaderFlags(in UiSkinHeaderBinary header){
    return header.reserved0 == 0u && header.reserved1 == 0u;
}

b8 IsValidUiSkinRegionBinaryFlags(in UiSkinRegionBinary packed){
    return packed.reserved == 0u && packed.drawMode <= cast<u32>(UiSkinDrawMode::NineSlice);
}

b8 IsValidUiSkinRegion(in UiSkinRegion region, in u32 atlasWidth, in u32 atlasHeight){
    if(region.name == s_NameNone || region.name == Name(""))
        return false;
    if(!IsValidUiSkinRegionRectAndSlices(region, atlasWidth, atlasHeight))
        return false;

    const UiSkinInsets padding = region.padding;
    if(
        !isFinite(padding.left) || padding.left < 0.0f
        || !isFinite(padding.top) || padding.top < 0.0f
        || !isFinite(padding.right) || padding.right < 0.0f
        || !isFinite(padding.bottom) || padding.bottom < 0.0f
    )
        return false;

    const f32 paddingHorizontal = padding.left + padding.right;
    const f32 paddingVertical = padding.top + padding.bottom;
    return isFinite(paddingHorizontal)
        && isFinite(paddingVertical)
        && isFinite(region.minimumWidth) && region.minimumWidth >= 0.0f
        && isFinite(region.minimumHeight) && region.minimumHeight >= 0.0f
    ;
}

Expected<usize> TryFindUiSkinRegionIndex(
    in Span<UiSkinRegion> regions,
    in Span<u32> regionIndex,
    in Name name
){
    if(regions.size() <= s_UiSkinLinearLookupRegionLimit || regions.size() > s_UiSkinMaxRegionCount){
        for(usize i = 0u; i < regions.size(); ++i){
            if(regions[i].name == name)
                return i;
        }
        return makeUnexpected(Failure());
    }
    usize first = 0u;
    usize count = regionIndex.size();
    while(count > 0u){
        const usize step = count / 2u;
        const usize middle = first + step;
        const usize regionPosition = cast<usize>(regionIndex[middle]);
        if(regions[regionPosition].name < name){
            first = middle + 1u;
            count -= step + 1u;
        }
        else
            count = step;
    }
    if(first == regionIndex.size())
        return makeUnexpected(Failure());
    const usize matchedPosition = cast<usize>(regionIndex[first]);
    if(regions[matchedPosition].name != name)
        return makeUnexpected(Failure());
    return matchedPosition;
}

UiSkinHeaderBinary MakeUiSkinHeaderBinary(
    in NameHash textureNameHash,
    in u32 atlasWidth,
    in u32 atlasHeight,
    in f32 referenceDensity,
    in u32 regionCount
){
    UiSkinHeaderBinary header;
    header.textureNameHash = textureNameHash;
    header.atlasWidth = atlasWidth;
    header.atlasHeight = atlasHeight;
    header.referenceDensity = referenceDensity;
    header.regionCount = regionCount;
    return header;
}

UiSkinRegionBinary PackUiSkinRegionBinary(in UiSkinRegion region){
    UiSkinRegionBinary packed;
    packed.nameHash = region.name.hash();
    packed.x = region.rectangle.x;
    packed.y = region.rectangle.y;
    packed.width = region.rectangle.width;
    packed.height = region.rectangle.height;
    packed.sliceLeft = region.sliceInsets.left;
    packed.sliceTop = region.sliceInsets.top;
    packed.sliceRight = region.sliceInsets.right;
    packed.sliceBottom = region.sliceInsets.bottom;
    packed.paddingLeft = region.padding.left;
    packed.paddingTop = region.padding.top;
    packed.paddingRight = region.padding.right;
    packed.paddingBottom = region.padding.bottom;
    packed.minimumWidth = region.minimumWidth;
    packed.minimumHeight = region.minimumHeight;
    packed.drawMode = cast<u32>(region.drawMode);
    return packed;
}

UiSkinRegion UnpackUiSkinRegionBinary(in UiSkinRegionBinary packed){
    UiSkinRegion region;
    region.name = Name(packed.nameHash);
    region.rectangle.x = packed.x;
    region.rectangle.y = packed.y;
    region.rectangle.width = packed.width;
    region.rectangle.height = packed.height;
    region.sliceInsets.left = packed.sliceLeft;
    region.sliceInsets.top = packed.sliceTop;
    region.sliceInsets.right = packed.sliceRight;
    region.sliceInsets.bottom = packed.sliceBottom;
    region.padding.left = packed.paddingLeft;
    region.padding.top = packed.paddingTop;
    region.padding.right = packed.paddingRight;
    region.padding.bottom = packed.paddingBottom;
    region.minimumWidth = packed.minimumWidth;
    region.minimumHeight = packed.minimumHeight;
    if(packed.drawMode == cast<u32>(UiSkinDrawMode::NineSlice))
        region.drawMode = UiSkinDrawMode::NineSlice;
    else
        region.drawMode = UiSkinDrawMode::Sprite;
    return region;
}

f32 ResolveUiSkinSquareExtent(in f32 minimumExtent, in UiSkinRegion region){
    return max(minimumExtent, max(region.minimumWidth, region.minimumHeight));
}

f32 ResolveUiSkinSquareExtent(in f32 minimumExtent, in UiSkinRegion region, in f32 density){
    const f32 sourceExtent = cast<f32>(max(region.rectangle.width, region.rectangle.height)) / density;
    return max(ResolveUiSkinSquareExtent(minimumExtent, region), sourceExtent);
}

Expected<f32x4> TryLoadUiSkinMinimumSize(in UiSkinRegion region, in f64x4 sliceExtents, in f64x4 density){
    if(!isFinite(region.minimumWidth) || region.minimumWidth < 0.0f || !isFinite(region.minimumHeight) || region.minimumHeight < 0.0f)
        return makeUnexpected(Failure());
    const f64 maxFloatF64 = cast<f64>(f32.max);
    const f64x2 minimumSize(cast<f64>(region.minimumWidth), cast<f64>(region.minimumHeight));
    const f64x2 scaledSlices = f64x2(sliceExtents.x, sliceExtents.y) / f64x2(density.x, density.y);
    const f64x2 widthHeight = max(minimumSize, scaledSlices);
    if(!isFinite(widthHeight.x) || widthHeight.x > maxFloatF64 || !isFinite(widthHeight.y) || widthHeight.y > maxFloatF64)
        return makeUnexpected(Failure());
    return f32x4(cast<f32>(widthHeight.x), cast<f32>(widthHeight.y), 0.0f, 0.0f);
}

Expected<f32x4> TryLoadUiSkinMinimumSize(in UiSkinRegion region, in f64 density){
    const Expected<f64x4> sliceExtents = TryLoadUiSkinSliceExtents(region);
    if(!sliceExtents.has_value())
        return makeUnexpected(Failure());
    return TryLoadUiSkinMinimumSize(region, sliceExtents.value(), f64x4(density, density, 0.0, 0.0));
}

b8 ValidateUiSkinPayloadData(
    in AssetRef<Texture> texture,
    in u32 atlasWidth,
    in u32 atlasHeight,
    in f32 referenceDensity,
    in Span<UiSkinRegion> regions,
    in Span<u32> regionIndex,
    in UiSkinPalette palette,
    in UiSkinTypography typography
){
    if(regions.size() > cast<usize>(s_UiSkinMaxRegionCount)){
        error("UiSkin::validatePayload failed: region count {} exceeds schema limit {}", regions.size(), s_UiSkinMaxRegionCount);
        return false;
    }
    if(
        !texture.valid() || texture.name() == Name("")
        || atlasWidth == 0u || atlasHeight == 0u
        || !isFinite(referenceDensity) || referenceDensity <= 0.0f
        || !(isFinite(cast<f32>(atlasWidth) / referenceDensity) && isFinite(cast<f32>(atlasHeight) / referenceDensity))
        || regions.empty()
    ){
        error("UiSkin::validatePayload failed: texture reference, atlas extent, reference density, or region count is invalid");
        return false;
    }
    for(usize index = 0u; index < regions.size(); ++index){
        const UiSkinRegion region = regions[index];
        if(!IsValidUiSkinRegion(region, atlasWidth, atlasHeight)){
            error(
                "UiSkin::validatePayload failed: region {} '{}' has invalid bounds, slice borders, draw mode, or logical metrics"
                , index
                , region.name.resolvedText()
            );
            return false;
        }
    }
    for(usize index = 1u; index < regionIndex.size(); ++index){
        const Name name = regions[cast<usize>(regionIndex[index])].name;
        if(name == regions[cast<usize>(regionIndex[index - 1u])].name){
            error("UiSkin::validatePayload failed: duplicate region '{}'", name.resolvedText());
            return false;
        }
    }
    for(usize index = 0u; index < palette.colors.size(); ++index){
        const UiSkinColor color = palette.colors[index];
        if(!IsValidUiSkinPaletteColor(color)){
            error("UiSkin::validatePayload failed: palette color {} needs finite RGB in [0, 16] and alpha in [0, 1]", index);
            return false;
        }
    }
    if(!isFinite(typography.defaultFontSize) || !IsValidUiSkinDefaultFontSize(typography.defaultFontSize)){
        error("UiSkin::validatePayload failed: typography needs a default font size in [1/64, 2048]");
        return false;
    }
    return true;
}

b8 ValidateUiSkinToolkitRegions(in Span<UiSkinRegion> regions, in Span<u32> regionIndex){
    for(usize index = 0u; index < s_UiSkinRequiredRegionCount; ++index){
        const UiSkinRequiredRegion required = ResolveUiSkinRequiredRegion(index);
        if(!TryFindUiSkinRegionIndex(regions, regionIndex, required.name).has_value()){
            error("UI skin toolkit contract 'widgets' failed: missing required region '{}'", required.text);
            return false;
        }
    }
    if(
        !TryFindUiSkinRegionIndex(regions, regionIndex, s_WindowResizeRegionName).has_value()
        && !TryFindUiSkinRegionIndex(regions, regionIndex, s_WhiteRegionName).has_value()
    ){
        error("UI skin toolkit contract 'widgets' failed: window resizing requires 'window.resize' or 'white'");
        return false;
    }
    return true;
}

[subsystem("ui_subsystem")]
class UiSubsystem{
    public Vector<AssetRef<FontAtlas>> basicFonts;
    public AssetRef<UiSkin> basicSkin;
    public AssetRef<PixelShader> outputPs;
    public AssetRef<VertexShader> outputVs;
    public AssetRef<PixelShader> ps;
    public AssetRef<VertexShader> vs;
}


