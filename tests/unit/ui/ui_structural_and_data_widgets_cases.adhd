NWB_ADHD_GTEST_F(StructuralSpinBoxTests, IntegerFloatButtonsKeysWheelWrapDirtyCommitAndDisabled, VerifySpinBox_IntegerFloatButtonsKeysWheelWrapDirtyCommitAndDisabled)
