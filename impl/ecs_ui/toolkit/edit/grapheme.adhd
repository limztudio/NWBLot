#include <impl/ecs_ui/toolkit/edit/text_normalization.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type EditBoundaryVector = Vector<usize>;

[cpp_unwind] Expected<EditBoundaryVector> BuildEditGraphemeBoundaries(in StringView text, in b8 singleLine){
    if(!ValidateGraphemeText(text, singleLine) || text.size() == usize.max)
        return MakeUnexpected(Failure());
    EditBoundaryVector boundaries;
    if(!TryBuildGraphemeBoundariesInto(text, singleLine, boundaries))
        return MakeUnexpected(Failure());
    return boundaries;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

