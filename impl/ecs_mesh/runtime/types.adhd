////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_mesh/runtime/buffer_names.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RuntimeMeshRequestKey{
    public RuntimeMeshRequestKey(){
        this.version = 0u;
    }

    public RuntimeMeshRequestKey(in NameHash inName, in u64 inVersion){
        this.name = inName;
        this.version = inVersion;
    }

    public b8 operator==(in RuntimeMeshRequestKey rhs)const{
        return this.version == rhs.version && this.name == rhs.name;
    }

    public usize hash()const{
        return HashRuntimeMeshRequestKey(this.name, this.version);
    }

    public NameHash name;
    public u64 version;
}

class RuntimeMeshRequestEntry{
    public RuntimeMeshRequestEntry(){
        this.found = false;
    }

    public RuntimeMeshRequestEntry(in RuntimeMeshRequestKey inKey, in b8 inFound){
        this.key = inKey;
        this.found = inFound;
    }

    public RuntimeMeshRequestKey key;
    public b8 found;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


usize HashRuntimeMeshRequestKey(in NameHash name, in u64 version){
    usize seed = HashValue(name);
    return HashCombineValue(seed, version);
}

usize FindInlineRuntimeMeshRequest(in Span<RuntimeMeshRequestEntry> entries, in usize inlineCount, in NameHash name, in u64 version){
    for(usize index = 0u; index < inlineCount; ++index){
        const RuntimeMeshRequestKey key = entries[index].key;
        if(key.version == version && key.name == name)
            return index;
    }
    return inlineCount;
}

b8 TryAddInlineRuntimeMeshRequest(
    mut Array<RuntimeMeshRequestEntry, s_RuntimeMeshRequestInlineCapacity> entries,
    mut usize inoutInlineCount,
    mut usize inoutRemainingCount,
    in NameHash name,
    in u64 version
){
    if(FindInlineRuntimeMeshRequest(entries, inoutInlineCount, name, version) < inoutInlineCount)
        return true;
    if(inoutInlineCount < s_RuntimeMeshRequestInlineCapacity){
        entries[inoutInlineCount] = RuntimeMeshRequestEntry(RuntimeMeshRequestKey(name, version), false);
        ++inoutInlineCount;
        ++inoutRemainingCount;
        return true;
    }
    return false;
}

void MarkInlineRuntimeMeshRequestLive(
    mut Array<RuntimeMeshRequestEntry, s_RuntimeMeshRequestInlineCapacity> entries,
    mut usize inoutRemainingCount,
    in usize inlineCount,
    in NameHash name,
    in u64 version
){
    const usize index = FindInlineRuntimeMeshRequest(entries, inlineCount, name, version);
    if(index < inlineCount && !entries[index].found){
        entries[index].found = true;
        --inoutRemainingCount;
    }
}

b8 ContainsInlineRuntimeMeshRequestLive(in Span<RuntimeMeshRequestEntry> entries, in usize inlineCount, in NameHash name, in u64 version){
    const usize index = FindInlineRuntimeMeshRequest(entries, inlineCount, name, version);
    return index < inlineCount && entries[index].found;
}

Expected<usize> TryComputeRuntimeMeshBufferByteCount(in usize elementCount, in usize elementBytes){
    if(elementBytes != 0u && elementCount > usize.max / elementBytes)
        return MakeUnexpected(Failure());
    return elementCount * elementBytes;
}

Expected<usize> TryComputePaddedRawByteCount(in usize logicalByteCount){
    if(logicalByteCount == 0u)
        return MakeUnexpected(Failure());
    return AlignUpChecked(logicalByteCount, s_RawByteLoadAlignmentBytes);
}

usize ExpectedMeshletSolidTriangleWordCount(in u32 meshletPrimitiveIndexCount){
    return (cast<usize>(meshletPrimitiveIndexCount) / cast<usize>(s_MeshletTriangleIndexCount) + cast<usize>(s_MeshletSolidTriangleWordRoundUp)) / cast<usize>(s_MeshletSolidTriangleWordBits);
}

Name DeriveRuntimeResourceName(in Name sourceName, in u64 ownerId, in u32 editRevision, in StringView label){
    if(sourceName == s_NameNone || label.empty())
        return s_NameNone;
    const Expected<NameHash> derivedHashResult = BeginDerivedNameHash(sourceName);
    if(!derivedHashResult.has_value())
        return s_NameNone;
    NameHash derivedHash = derivedHashResult.value();
    if(
        !UpdateDerivedNameHashText(derivedHash, s_RuntimePrefix)
        || !UpdateDerivedNameHashDecimal(derivedHash, ownerId)
        || !UpdateDerivedNameHashText(derivedHash, s_RevisionSeparator)
        || !UpdateDerivedNameHashDecimal(derivedHash, editRevision)
        || !UpdateDerivedNameHashText(derivedHash, s_OwnerSeparator)
        || !UpdateDerivedNameHashText(derivedHash, label)
    )
        return s_NameNone;
    const Expected<Name> finished = FinishDerivedNameHash(derivedHash);
    if(!finished.has_value())
        return s_NameNone;
    return finished.value();
}

Name DeriveNamedRuntimeBufferName(
    in Name sourceName,
    in u64 handleValue,
    in u32 editRevision,
    in StringView suffix,
    in StringView label
){
    const Name bufferName = DeriveRuntimeResourceName(sourceName, handleValue, editRevision, suffix);
    if(bufferName == s_NameNone)
        error("MeshSkinningRuntimeCache: failed to derive {} buffer name for runtime mesh '{}'", label, handleValue);
    return bufferName;
}

void ReportRuntimeBufferUploadFailure(in BufferSetupFailure failure, in StringView label, in u64 handleValue){
    switch(failure){
    case BufferSetupFailure::EmptyPayload:
        error("MeshSkinningRuntimeCache: {} payload is empty", label);
        break;
    case BufferSetupFailure::ByteSizeOverflow:
        error("MeshSkinningRuntimeCache: {} payload byte size overflows", label);
        break;
    case BufferSetupFailure::CreateFailed:
        error("MeshSkinningRuntimeCache: failed to create {} buffer for runtime mesh '{}'", label, handleValue);
        break;
    }
}

b8 ValidateReconstructedRuntimeTriangleIndexCount(in usize reconstructedCount, in usize expectedCount, in u64 handleValue){
    if(reconstructedCount == expectedCount)
        return true;

    error(
        "MeshSkinningRuntimeCache: reconstructed ray tracing index count {} does not match expected {} for runtime mesh '{}'"
        , cast<u64>(reconstructedCount)
        , cast<u64>(expectedCount)
        , handleValue
    );
    return false;
}

void ReportMeshBufferSetupFailure(in BufferSetupFailure failure, in Name meshName, in StringView label){
    switch(failure){
    case BufferSetupFailure::EmptyPayload:
        error("RendererSystem: mesh '{}' has empty {} payload", meshName.resolvedText(), label);
        return;
    case BufferSetupFailure::ByteSizeOverflow:
        error("RendererSystem: mesh '{}' {} payload byte size overflows", meshName.resolvedText(), label);
        return;
    case BufferSetupFailure::CreateFailed:
        break;
    }
    error("RendererSystem: failed to create {} buffer for mesh '{}'", label, meshName.resolvedText());
}

Expected<Name> DeriveMeshBufferName(in Name meshName, in StringView suffix, in StringView label){
    const Expected<Name> derived = DeriveName(meshName, suffix);
    if(!derived.has_value()){
        error("RendererSystem: failed to derive {} buffer name for mesh '{}'", label, meshName.resolvedText());
        return MakeUnexpected(Failure());
    }
    return derived.value();
}

b8 ValidateMeshRawBufferLogicalByteCount(
    in b8 hasBuffer,
    in u32 structStride,
    in u64 byteSize,
    in u32 logicalByteCount,
    in Name meshName,
    in StringView label
){
    if(!hasBuffer){
        error("RendererSystem: mesh '{}' has no {} buffer", meshName.resolvedText(), label);
        return false;
    }
    if(structStride != 1u || byteSize < cast<u64>(logicalByteCount)){
        error("RendererSystem: mesh '{}' {} buffer cannot cover {} logical bytes", meshName.resolvedText(), label, logicalByteCount);
        return false;
    }
    return true;
}

RenderableMeshResolution ClassifyRenderableMeshFailure(in b8 hasMeshComponent, in b8 hasRuntimeBinding){
    if(hasMeshComponent || hasRuntimeBinding)
        return RenderableMeshResolution::Unavailable;
    return RenderableMeshResolution::Absent;
}


