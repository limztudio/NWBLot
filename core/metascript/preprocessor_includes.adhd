[cpp_header("<core/metascript/preprocessor_includes.h>"), cpp_name("::NWB::Core::Metascript::IIncludeResolver"), cpp_flags(no_copy, no_assign, polymorphic_base, abstract)]
extern class MetascriptIIncludeResolver{
    [cpp_flags(unwind)] b8 resolveInclude(in StringView path, in b8 system, mut GlobalAllocator storage, mut GlobalString key, mut GlobalString source);
    StringView resolveIncludeNamespace(in StringView key)const;
    void popIncludeScope();
};

[cpp_header("<core/metascript/preprocessor_includes.h>"), cpp_name("::NWB::Core::Metascript::PreprocessorIncludes"), cpp_flags(no_assign)]
extern class MetascriptPreprocessorIncludes{
    void clearRanges(...);
    b8 containsOffset(...)const;
    Span<String> includedFiles(...)const;
    b8 process(...);
    Span<String> resolvedIncludedFiles(...)const;
};


