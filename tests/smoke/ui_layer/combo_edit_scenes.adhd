class UiComboSmokeScene{
    private UiComboSmokeSource m_source = UiComboSmokeSource();
    private ComboState m_state = ComboState();
    private ScrollPlacement m_lastPlacement = ScrollPlacement();
    private Array<u64, 16u> m_lastValues;
    private PopupPlacement m_lastPopup = PopupPlacement();
    private Rect m_lastBounds = Rect();
    private DisplayMetrics m_lastDisplay = DisplayMetrics();
    private u32 m_sequence = 0u;
    private u32 m_commits = 0u;
    private u32 m_underlying = 0u;
    private b8 m_focused = false;
    private b8 m_visible = true;
    private b8 m_enabled = true;
    private b8 m_bottom = false;
    private b8 m_displayChanged = false;

    public b8 paint(mut UiPaintContext context);
    public b8 keyboardUpdate(in i32 key, in i32 scancode, in i32 action, in i32 mods);

    private Array<u64, 16u> values()const;
    private Rect cursorRow()const;
    private void observeState();
}


