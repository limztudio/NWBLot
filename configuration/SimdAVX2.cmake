include_guard(GLOBAL)

function(nwb_apply_simd_avx2 target)
    if(NWB_TARGET_ARCH STREQUAL "x64")
        if(NWB_COMPILER_FRONTEND_MSVC)
            target_compile_options(${target} PRIVATE /arch:AVX2)
        else()
            target_compile_options(${target} PRIVATE -mavx2 -mfma -mf16c -msse4.2)
        endif()
    elseif(NWB_TARGET_ARCH STREQUAL "arm64")
        if(NWB_COMPILER_FRONTEND_MSVC)
            target_compile_options(${target} PRIVATE $<$<COMPILE_LANGUAGE:C,CXX>:/clang:-march=armv8.1-a>)
        else()
            target_compile_options(${target} PRIVATE $<$<COMPILE_LANGUAGE:C,CXX>:-march=armv8.1-a>)
        endif()
    endif()
endfunction()
