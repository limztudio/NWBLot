// limztudio@gmail.com
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/raytrace/raytrace_internal.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class MeshBlasBuildPlanDecision{
    public u32 vertexStride = 0u;
    public u32 vertexCount = 0u;
    public u32 refitsBeforeBuild = 0u;
    public u32 refitsAfterBuild = 0u;
    public b8 firstBuild = false;
    public b8 performRefit = false;
}

class PreparedMeshBlasValidationPolicy{
    public b8 matchesCoreRevisionState(
        in Name meshName,
        in Name buildMeshName,
        in b8 runtimeMesh,
        in b8 buildRuntimeMesh,
        in u64 runtimeMeshVersion,
        in u64 buildRuntimeMeshVersion,
        in u64 geometryContentRevision,
        in u64 buildGeometryContentRevision,
        in u64 acceptedGeometryContentRevision,
        in u64 buildAcceptedGeometryContentRevision,
        in u32 indexCount,
        in u32 buildIndexCount,
        in b8 buildPending,
        in b8 expectedBuildPending,
        in b8 blasBuildAccepted,
        in b8 expectedFirstBuild,
        in b8 backingFresh,
        in b8 expectedBackingFresh,
        in u32 refitsSinceRebuild,
        in u32 buildRefitsBeforeBuild
    )const{
        const b8 currentFirstBuild = buildPending || !blasBuildAccepted;
        return meshName == buildMeshName
            && runtimeMesh == buildRuntimeMesh
            && runtimeMeshVersion == buildRuntimeMeshVersion
            && geometryContentRevision == buildGeometryContentRevision
            && acceptedGeometryContentRevision == buildAcceptedGeometryContentRevision
            && indexCount == buildIndexCount
            && buildPending == expectedBuildPending
            && currentFirstBuild == expectedFirstBuild
            && backingFresh == expectedBackingFresh
            && refitsSinceRebuild == buildRefitsBeforeBuild;
    }

    public b8 hasValidRecordDimensions(in u32 vertexStride, in u32 vertexCount, in u32 indexCount)const{
        return vertexStride != 0u && vertexCount != 0u && indexCount != 0u;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u32 ComputeMeshBlasVertexCount(in usize positionByteSize, in usize structStride){
    if(structStride == 0u)
        return 0u;
    return cast<u32>(positionByteSize / structStride);
}

b8 MatchesMeshBlasPositionLayout(in usize structStride, in usize byteSize, in u32 expectedStride, in usize expectedByteSize, in u32 expectedVertexCount){
    return structStride == cast<usize>(expectedStride)
        && byteSize == expectedByteSize
        && expectedStride != 0u
        && expectedVertexCount == ComputeMeshBlasVertexCount(byteSize, structStride);
}

MeshBlasBuildPlanDecision ResolveMeshBlasBuildPlanDecision(
    in usize positionByteSize,
    in usize positionStructStride,
    in u32 primitiveIndexCount,
    in b8 runtimeMesh,
    in b8 blasBuildPending,
    in b8 blasBuildAccepted,
    in u32 blasRefitsSinceRebuild
){
    MeshBlasBuildPlanDecision decision;
    decision.vertexStride = cast<u32>(positionStructStride);
    decision.vertexCount = ComputeMeshBlasVertexCount(positionByteSize, positionStructStride);
    decision.firstBuild = blasBuildPending || !blasBuildAccepted;
    decision.performRefit = ShouldRefitRuntimeMeshAcceleration(runtimeMesh, decision.firstBuild, blasRefitsSinceRebuild, ComputeMeshTrianglePrimitiveCount(primitiveIndexCount));
    decision.refitsBeforeBuild = blasRefitsSinceRebuild;
    decision.refitsAfterBuild = AdvanceAccelerationRefitCount(decision.performRefit, blasRefitsSinceRebuild);
    return decision;
}


