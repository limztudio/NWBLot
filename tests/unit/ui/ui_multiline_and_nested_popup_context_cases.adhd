UiMultilineTextBytes<3u> MakeUiMultilineTextAsciiSandwich(in u32 scalar){
    UiMultilineTextBytes<3u> result;
    result.bytes = Array<u8, 3u>('a', cast<u8>(scalar), 'b');
    return result;
}

UiMultilineTextBytes<4u> MakeUiMultilineTextC1Sandwich(in u32 leadByte, in u32 scalar){
    UiMultilineTextBytes<4u> result;
    result.bytes = Array<u8, 4u>('a', cast<u8>(leadByte), cast<u8>(scalar), 'b');
    return result;
}

WidgetOptions MakeUiNestedPopupControlOptions(in f32 width){
    WidgetOptions options = WidgetOptions();
    options.width.policy = LayoutSizePolicy::Fixed;
    options.width.value = width;
    options.height.policy = LayoutSizePolicy::Fixed;
    options.height.value = 30.0f;
    return options;
}

b8 BeginUiNestedPopupBuilderParent(mut UiNestedPopupBuilderTests self, in u64 generation){
    return self.begin(generation) && self.m_builder.beginPopup(s_UiFixtureParentPopupKey, self.m_parent, MakeNestedParentPopupOptions());
}

b8 PrepareUiNestedPopupBuilderButtons(mut UiNestedPopupBuilderTests self, in u64 generation){
    if(!BeginUiNestedPopupBuilderParent(self, generation))
        return false;
    self.m_beforeActivated = self.m_builder.button("before", "Before", MakeUiNestedPopupControlOptions(120.0f));
    if(self.m_builder.beginPopup(s_UiFixtureChildPopupKey, self.m_child, MakeNestedChildPopupOptions())){
        self.m_childActivated = self.m_builder.button("apply", "Child", MakeUiNestedPopupControlOptions(120.0f));
        if(!self.m_builder.endPopup())
            return false;
    }
    else if(self.m_context.failed())
        return false;
    self.m_afterActivated = self.m_builder.button("after", "After", MakeUiNestedPopupControlOptions(120.0f));
    return self.m_builder.endPopup() && self.finishRoot();
}

b8 AcceptUiNestedPopupBuilderButtons(mut UiNestedPopupBuilderTests self, in u64 generation){
    return PrepareUiNestedPopupBuilderButtons(self, generation) && self.m_context.commitFrame(generation);
}

b8 PublishUiNestedPopupDeclaration(mut UiNestedPopupContextTests self, in UiNestedPopupContextPopupDeclaration popup){
    HitTarget barrier = HitTarget();
    barrier.rectangle = popup.scope.bounds;
    barrier.clip = popup.scope.viewport;
    if(!self.m_context.addTarget(popup.owner, barrier))
        return false;
    HitTarget action = HitTarget();
    action.rectangle.x = popup.scope.bounds.x + 4.0f;
    action.rectangle.y = popup.scope.bounds.y + 4.0f;
    action.rectangle.width = 24.0f;
    action.rectangle.height = 18.0f;
    action.clip = popup.scope.bounds;
    action.focusable = true;
    action.activatable = true;
    return self.m_context.addTarget(popup.action, action);
}

b8 BeginUiNestedPopupLifetimeParent(mut UiNestedPopupLifetimeTests self, in u64 generation){
    if(!self.begin(generation) || !self.m_builder.beginPopup(s_UiFixtureParentPopupKey, self.m_parent, MakeNestedParentPopupOptions()))
        return false;
    const b8 activated = self.m_builder.button("before", "Before");
    return !activated;
}

b8 FinishUiNestedPopupLifetimeParent(mut UiNestedPopupLifetimeTests self, in u64 generation){
    const b8 activated = self.m_builder.button("after", "After");
    return !activated && self.m_builder.endPopup() && self.m_context.endRoot() && self.m_context.finishFrame() && self.m_context.commitFrame(generation);
}

b8 AcceptUiNestedPopupLifetimePlain(mut UiNestedPopupLifetimeTests self, in u64 generation){
    if(!BeginUiNestedPopupLifetimeParent(self, generation))
        return false;
    self.m_childVisible = self.m_builder.beginPopup(s_UiFixtureChildPopupKey, self.m_child, MakeNestedChildPopupOptions());
    if(self.m_childVisible){
        const b8 activated = self.m_builder.button("apply", "Child");
        if(activated || !self.m_builder.endPopup())
            return false;
    }
    else if(self.m_context.failed())
        return false;
    return FinishUiNestedPopupLifetimeParent(self, generation);
}

b8 AcceptUiNestedPopupLifetimeCombo(mut UiNestedPopupLifetimeTests self, in u64 generation){
    if(!BeginUiNestedPopupLifetimeParent(self, generation))
        return false;
    self.m_result = self.m_builder.comboBox(s_ComboKey, self.m_source, self.m_state, MakeComboFixtureOptions());
    return self.m_result.valid && FinishUiNestedPopupLifetimeParent(self, generation);
}

b8 AcceptUiNestedPopupLifetimeSearch(mut UiNestedPopupLifetimeTests self, in u64 generation){
    if(!BeginUiNestedPopupLifetimeParent(self, generation))
        return false;
    self.m_searchResult = self.m_builder.searchComboBox(s_ComboKey, self.m_searchSource, self.m_search, MakeSearchComboFixtureOptions());
    return self.m_searchResult.combo.valid && FinishUiNestedPopupLifetimeParent(self, generation);
}

b8 AcceptUiNestedPopupLifetimeMenu(mut UiNestedPopupLifetimeTests self, in u64 generation){
    if(!BeginUiNestedPopupLifetimeParent(self, generation))
        return false;
    const b8 activated = self.m_builder.button(s_AnchorKey, "Commands");
    if(activated)
        return false;
    self.m_menuResult = self.m_builder.contextMenu(s_MenuKey, s_AnchorKey, self.m_menuSource, self.m_menu);
    return self.m_menuResult.valid && FinishUiNestedPopupLifetimeParent(self, generation);
}

b8 DeclareUiNestedPopupLifetimeReserved(mut UiNestedPopupLifetimeTests self, in u64 generation, in b8 overflow){
    if(!BeginUiNestedPopupLifetimeParent(self, generation) || !self.m_builder.comboBox(s_ComboKey, self.m_source, self.m_state, MakeComboFixtureOptions()).valid)
        return false;
    const b8 activated = self.m_builder.button(s_AnchorKey, "Commands");
    if(activated || !self.m_builder.contextMenu(s_MenuKey, s_AnchorKey, self.m_menuSource, self.m_menu).valid)
        return false;
    if(!self.m_builder.beginPopup(s_UiFixtureChildPopupKey, self.m_child, MakeNestedChildPopupOptions()) || !self.m_builder.comboBox(s_ComboKey, self.m_source, self.m_childCombo, MakeComboFixtureOptions()).valid)
        return false;
    for(usize index = 0u; index < 3u; ++index){
        if(!self.m_builder.beginPopup("deep", self.m_deeper[index], MakeNestedChildPopupOptions()))
            return false;
    }
    if(overflow)
        return self.m_builder.beginPopup("deep", self.m_deeper[3u], MakeNestedChildPopupOptions());
    const b8 leafActivated = self.m_builder.button("leaf", "Deepest");
    if(leafActivated)
        return false;
    for(usize index = 0u; index < 4u; ++index){
        if(!self.m_builder.endPopup())
            return false;
    }
    const b8 afterActivated = self.m_builder.button("after", "Parent after");
    return !afterActivated && self.m_builder.endPopup() && self.m_context.endRoot() && self.m_context.finishFrame();
}

void ExpectUiNestedPopupLifetimeParentControls(in UiNestedPopupLifetimeTests self){
    const auto before = self.tryTarget(RequireUiWidgetId(self.parentId(), "before"));
    const auto after = self.tryTarget(RequireUiWidgetId(self.parentId(), "after"));
    ASSERT_TRUE(before.has_value());
    ASSERT_TRUE(after.has_value());
    EXPECT_EQ(before.value().popup, after.value().popup);
    EXPECT_EQ(before.value().popup.openGeneration, self.m_parent.openGeneration());
    EXPECT_TRUE(self.m_parent.isOpen());
}

void ExpectUiMultilineTextNormalizedError(in StringView text, in usize maxBytes, in EditTextStatus status){
    const auto normalized = NormalizeMultilineText(text, maxBytes);
    EXPECT_FALSE(normalized.has_value());
    if(!normalized.has_value())
        EXPECT_EQ(normalized.error(), status);
}

void VerifyUiMultilineText_AcceptsEmptyAndCanonicalLfLinesWithoutChangingBytes(){
    Array<StringView, 5u> cases = Array<StringView, 5u>();
    cases[0u] = "";
    cases[1u] = "\n";
    cases[2u] = "\n\n";
    cases[3u] = "\nfirst\n";
    cases[4u] = "first\n\nlast\n";
    for(in StringView text : cases){
        const ScopedTestTrace trace = ScopedTestTrace(text);
        EXPECT_TRUE(ValidateMultilineText(text));
        const auto normalized = NormalizeMultilineText(text, text.size());
        ASSERT_TRUE(normalized.has_value());
        const StringView outputView = StringView(normalized.value().data(), normalized.value().size());
        EXPECT_EQ(outputView, text);
        EXPECT_TRUE(ValidateMultilineText(outputView));
    }
}

void VerifyUiMultilineText_ControlsAndPrintableAsciiBoundariesRespectCanonicalLfAndNormalization(){
    for(u32 scalar = 0u; scalar < s_UiMultilineTextUtf8OneByteMaxExclusive; ++scalar){
        if(scalar > s_UiMultilineTextUnicodeSpace && scalar < s_UiMultilineTextAsciiTilde)
            continue;
        const ScopedTestTrace trace = ScopedTestTrace(scalar);
        const UiMultilineTextBytes<3u> bytes = MakeUiMultilineTextAsciiSandwich(scalar);
        const StringView text = bytes.view();
        const b8 canonical = scalar == s_UiMultilineTextUnicodeLineFeed || (scalar >= s_UiMultilineTextUnicodeSpace && scalar < s_UiMultilineTextUnicodeDelete);
        EXPECT_EQ(ValidateMultilineText(text), canonical);
        const b8 normalizable = canonical || scalar == s_UiMultilineTextUnicodeTab || scalar == s_UiMultilineTextUnicodeCarriageReturn;
        auto normalized = NormalizeMultilineText(text, 3u);
        EXPECT_EQ(normalized.has_value(), normalizable);
        if(normalizable){
            ASSERT_TRUE(normalized.has_value());
            String output = String();
            TestMoveAssign<String>(output, normalized.value());
            u32 replacement = scalar;
            if(scalar == s_UiMultilineTextUnicodeTab)
                replacement = s_UiMultilineTextUnicodeSpace;
            else if(scalar == s_UiMultilineTextUnicodeCarriageReturn)
                replacement = s_UiMultilineTextUnicodeLineFeed;
            const UiMultilineTextBytes<3u> expected = MakeUiMultilineTextAsciiSandwich(replacement);
            const StringView outputView = StringView(output.data(), output.size());
            EXPECT_EQ(outputView, expected.view());
            EXPECT_TRUE(ValidateMultilineText(outputView));
        }
        else{
            ASSERT_FALSE(normalized.has_value());
            EXPECT_EQ(normalized.error(), EditTextStatus::InvalidText);
        }
    }
}

void VerifyUiMultilineText_RejectsEveryC1ControlExceptNelDuringNormalization(){
    for(u32 scalar = s_UiMultilineTextUtf8OneByteMaxExclusive; scalar <= s_UiMultilineTextUnicodeC1Last; ++scalar){
        const ScopedTestTrace trace = ScopedTestTrace(scalar);
        const UiMultilineTextBytes<4u> bytes = MakeUiMultilineTextC1Sandwich(s_UiMultilineTextUtf8C1LeadByte, scalar);
        const StringView text = bytes.view();
        EXPECT_FALSE(ValidateMultilineText(text));
        if(scalar == s_UiMultilineTextUnicodeNextLine){
            const auto normalized = NormalizeMultilineText(text, 4u);
            ASSERT_TRUE(normalized.has_value());
            EXPECT_EQ(normalized.value(), "a\nb");
        }
        else{
            ExpectUiMultilineTextNormalizedError(text, 4u, EditTextStatus::InvalidText);
        }
    }
}

void VerifyUiMultilineText_RequiresNormalizationForTabsAndEveryNoncanonicalLineSeparator(){
    Array<UiMultilineTextExpectationCase, 6u> cases = Array<UiMultilineTextExpectationCase, 6u>();
    cases[0u] = UiMultilineTextExpectationCase("\t", " ");
    cases[1u] = UiMultilineTextExpectationCase("\r", "\n");
    cases[2u] = UiMultilineTextExpectationCase("\r\n", "\n");
    cases[3u] = UiMultilineTextExpectationCase(s_UiMultilineTextNextLine, "\n");
    cases[4u] = UiMultilineTextExpectationCase(s_UiMultilineTextLineSeparator, "\n");
    cases[5u] = UiMultilineTextExpectationCase(s_UiMultilineTextParagraphSeparator, "\n");
    for(in UiMultilineTextExpectationCase test : cases){
        const ScopedTestTrace trace = ScopedTestTrace(test.source);
        EXPECT_FALSE(ValidateMultilineText(test.source));
        const auto normalized = NormalizeMultilineText(test.source, 1u);
        ASSERT_TRUE(normalized.has_value());
        const StringView outputView = StringView(normalized.value().data(), normalized.value().size());
        EXPECT_EQ(outputView, test.expected);
        EXPECT_TRUE(ValidateMultilineText(outputView));
    }
}

void VerifyUiMultilineText_PreservesConsecutiveLeadingAndTrailingLinesWhileNormalizingBreaks(){
    Array<UiMultilineTextExpectationCase, 7u> cases = Array<UiMultilineTextExpectationCase, 7u>();
    cases[0u] = UiMultilineTextExpectationCase("\r\r\n", "\n\n");
    cases[1u] = UiMultilineTextExpectationCase("\r\n\r", "\n\n");
    cases[2u] = UiMultilineTextExpectationCase("\n\r\n", "\n\n");
    cases[3u] = UiMultilineTextExpectationCase("\r\n\r\n", "\n\n");
    cases[4u] = UiMultilineTextExpectationCase("\r\nfirst\r\n\r\nlast\r", "\nfirst\n\nlast\n");
    cases[5u] = UiMultilineTextExpectationCase("\xC2\x85\xE2\x80\xA8\xE2\x80\xA9", "\n\n\n");
    cases[6u] = UiMultilineTextExpectationCase("last\r\n", "last\n");
    String output = String();
    for(in UiMultilineTextExpectationCase test : cases){
        const ScopedTestTrace trace = ScopedTestTrace(test.source);
        auto normalized = NormalizeMultilineText(test.source, test.expected.size());
        ASSERT_TRUE(normalized.has_value());
        TestMoveAssign<String>(output, normalized.value());
        const StringView outputView = StringView(output.data(), output.size());
        EXPECT_EQ(outputView, test.expected);
        EXPECT_TRUE(ValidateMultilineText(outputView));
    }
}

void VerifyUiMultilineText_UnicodeScalarAndSeparatorAdjacentBoundariesPreserveExactBytes(){
    Array<StringView, 12u> cases = Array<StringView, 12u>();
    cases[0u] = "\xC2\xA0";
    cases[1u] = "\xDF\xBF";
    cases[2u] = "\xE0\xA0\x80";
    cases[3u] = "\xED\x9F\xBF";
    cases[4u] = "\xEE\x80\x80";
    cases[5u] = "\xEF\xBF\xBF";
    cases[6u] = "\xF0\x90\x80\x80";
    cases[7u] = "\xF4\x8F\xBF\xBF";
    cases[8u] = "\xE2\x80\xA7";
    cases[9u] = "\xE2\x80\xAA";
    cases[10u] = "\xE2\x80\x8B";
    cases[11u] = "\xE2\x80\x8D";
    String output = String();
    for(in StringView text : cases){
        const ScopedTestTrace trace = ScopedTestTrace(text);
        EXPECT_TRUE(ValidateMultilineText(text));
        auto normalized = NormalizeMultilineText(text, text.size());
        ASSERT_TRUE(normalized.has_value());
        TestMoveAssign<String>(output, normalized.value());
        EXPECT_EQ(StringView(output.data(), output.size()), text);
    }
}

void VerifyUiMultilineText_RejectsMalformedUtf8AndNonScalarSequences(){
    Array<StringView, 26u> cases = Array<StringView, 26u>();
    cases[0u] = "\x80";
    cases[1u] = "\xBF";
    cases[2u] = "\xC0\x80";
    cases[3u] = "\xC0\xAF";
    cases[4u] = "\xC1\xBF";
    cases[5u] = "\xE0\x80\x80";
    cases[6u] = "\xF0\x80\x80\x80";
    cases[7u] = "\xED\xA0\x80";
    cases[8u] = "\xED\xBF\xBF";
    cases[9u] = "\xF4\x90\x80\x80";
    cases[10u] = "\xF5\x80\x80\x80";
    cases[11u] = "\xFE";
    cases[12u] = "\xFF";
    cases[13u] = "\xC2";
    cases[14u] = "\xE2";
    cases[15u] = "\xE2\x82";
    cases[16u] = "\xF0";
    cases[17u] = "\xF0\x9F";
    cases[18u] = "\xF0\x9F\x92";
    cases[19u] = "\xC2 ";
    cases[20u] = "\xE2\x28\xA1";
    cases[21u] = "\xF0\x28\x8C\xBC";
    cases[22u] = "\xE2\x82x";
    cases[23u] = "\xF8\x88\x80\x80\x80";
    cases[24u] = "valid\r\n\xED\xA0\x80";
    cases[25u] = StringView("a\0b", 3u);
    for(in StringView text : cases){
        const ScopedTestTrace trace = ScopedTestTrace(text);
        EXPECT_FALSE(ValidateMultilineText(text));
        ExpectUiMultilineTextNormalizedError(text, 128u, EditTextStatus::InvalidText);
    }
}

void VerifyUiMultilineText_RejectedControlsAfterNormalizedPrefixesFailWithInvalidText(){
    Array<StringView, 7u> cases = Array<StringView, 7u>();
    cases[0u] = "prefix\r\n\t\x01";
    cases[1u] = "prefix\r\n\v";
    cases[2u] = "prefix\r\n\f";
    cases[3u] = "prefix\xC2\x85\x7F";
    cases[4u] = "prefix\xE2\x80\xA8\xC2\x80";
    cases[5u] = "prefix\xE2\x80\xA9\xC2\x9F";
    cases[6u] = StringView("prefix\r\n\0tail", 13u);
    for(in StringView text : cases){
        const ScopedTestTrace trace = ScopedTestTrace(text);
        ExpectUiMultilineTextNormalizedError(text, 64u, EditTextStatus::InvalidText);
    }
}

void VerifyUiMultilineText_LimitsNormalizedBytesAndNeverTruncatesUtf8Scalars(){
    Array<UiMultilineTextExpectationCase, 7u> cases = Array<UiMultilineTextExpectationCase, 7u>();
    cases[0u] = UiMultilineTextExpectationCase("a\r\nb", "a\nb");
    cases[1u] = UiMultilineTextExpectationCase("\r\n\r\n", "\n\n");
    cases[2u] = UiMultilineTextExpectationCase("\xE2\x80\xA8\xE2\x80\xA9", "\n\n");
    cases[3u] = UiMultilineTextExpectationCase("\xC2\x85\t", "\n ");
    cases[4u] = UiMultilineTextExpectationCase(s_UiMultilineTextThreeByteScalar, s_UiMultilineTextThreeByteScalar);
    cases[5u] = UiMultilineTextExpectationCase(s_UiMultilineTextFourByteScalar, s_UiMultilineTextFourByteScalar);
    cases[6u] = UiMultilineTextExpectationCase("\xED\x95\x9C\r\n\xE2\x80\xA8\t", "\xED\x95\x9C\n\n ");
    for(in UiMultilineTextExpectationCase test : cases){
        const ScopedTestTrace trace = ScopedTestTrace(test.source);
        const auto normalized = NormalizeMultilineText(test.source, test.expected.size());
        ASSERT_TRUE(normalized.has_value());
        const StringView outputView = StringView(normalized.value().data(), normalized.value().size());
        EXPECT_EQ(outputView, test.expected);
        ExpectUiMultilineTextNormalizedError(test.source, test.expected.size() - 1u, EditTextStatus::TooLarge);
        EXPECT_TRUE(ValidateMultilineText(outputView));
    }
}

void VerifyUiMultilineText_ZeroBudgetAcceptsEmptyInputAndRejectsEveryNonemptyNormalizedOutput(){
    Array<StringView, 7u> cases = Array<StringView, 7u>();
    cases[0u] = "a";
    cases[1u] = "\n";
    cases[2u] = "\r\n";
    cases[3u] = "\t";
    cases[4u] = s_UiMultilineTextNextLine;
    cases[5u] = s_UiMultilineTextLineSeparator;
    cases[6u] = s_UiMultilineTextParagraphSeparator;
    for(in StringView text : cases){
        const ScopedTestTrace trace = ScopedTestTrace(text);
        ExpectUiMultilineTextNormalizedError(text, 0u, EditTextStatus::TooLarge);
    }
    const auto nullText = NormalizeMultilineText(StringView(), 0u);
    ASSERT_TRUE(nullText.has_value());
    EXPECT_TRUE(nullText.value().empty());
    EXPECT_TRUE(ValidateMultilineText(StringView()));
    const auto emptyText = NormalizeMultilineText("", 0u);
    ASSERT_TRUE(emptyText.has_value());
    EXPECT_TRUE(emptyText.value().empty());
}

void VerifyUiMultilineText_SupportsBorrowedWholeAndSubviewSourcesAtExactBudgets(){
    String output = String("a\r\nb\t\xED\x95\x9C\xE2\x80\xA9");
    const StringView whole = StringView(output.data(), output.size());
    auto normalizedWhole = NormalizeMultilineText(whole, 8u);
    ASSERT_TRUE(normalizedWhole.has_value());
    TestMoveAssign<String>(output, normalizedWhole.value());
    EXPECT_EQ(output, "a\nb \xED\x95\x9C\n");

    output.assign(s_UiMultilineTextBorrowedSourceText);
    const StringView middle = StringView(output.data(), output.size()).substr(7u, 6u);
    auto normalizedMiddle = NormalizeMultilineText(middle, 5u);
    ASSERT_TRUE(normalizedMiddle.has_value());
    TestMoveAssign<String>(output, normalizedMiddle.value());
    EXPECT_EQ(output, "a\nb z");

    output.assign("prefix\xE2\x80\xA8");
    const StringView trailing = StringView(output.data(), output.size()).substr(6u, 3u);
    auto normalizedTrailing = NormalizeMultilineText(trailing, 1u);
    ASSERT_TRUE(normalizedTrailing.has_value());
    TestMoveAssign<String>(output, normalizedTrailing.value());
    EXPECT_EQ(output, "\n");

    const StringView empty = StringView(output.data(), output.size()).substr(output.size(), 0u);
    auto normalizedEmpty = NormalizeMultilineText(empty, 0u);
    ASSERT_TRUE(normalizedEmpty.has_value());
    TestMoveAssign<String>(output, normalizedEmpty.value());
    EXPECT_TRUE(output.empty());
}

void VerifyUiMultilineText_RejectedBorrowedViewsPreserveSourceBytesAndStorage(){
    String output = String(s_UiMultilineTextBorrowedSourceText);
    output.reserve(128u);
    const String savedAlias = String(output);
    const usize storage = TestDataAddress(output);
    const usize aliasCapacity = output.capacity();
    const StringView whole = StringView(output.data(), output.size());
    ExpectUiMultilineTextNormalizedError(whole, 1u, EditTextStatus::TooLarge);
    EXPECT_EQ(output, savedAlias);
    EXPECT_EQ(TestDataAddress(output), storage);
    EXPECT_EQ(output.capacity(), aliasCapacity);
    const StringView middle = StringView(output.data(), output.size()).substr(7u, 6u);
    ExpectUiMultilineTextNormalizedError(middle, 4u, EditTextStatus::TooLarge);
    EXPECT_EQ(output, savedAlias);
    EXPECT_EQ(TestDataAddress(output), storage);
    EXPECT_EQ(output.capacity(), aliasCapacity);

    Array<StringView, 3u> invalidAlias = Array<StringView, 3u>();
    invalidAlias[0u] = "prefix a\r\nb\x01";
    invalidAlias[1u] = "prefix a\r\nb\xE2\x82";
    invalidAlias[2u] = StringView("prefix a\r\nb\0tail", 16u);
    for(in StringView text : invalidAlias){
        output.assign(text);
        const String savedInvalid = String(output);
        const usize invalidStorage = TestDataAddress(output);
        const usize invalidCapacity = output.capacity();
        const StringView source = StringView(output.data(), output.size()).substr(7u, output.size() - 7u);
        ExpectUiMultilineTextNormalizedError(source, 64u, EditTextStatus::InvalidText);
        EXPECT_EQ(output, savedInvalid);
        EXPECT_EQ(TestDataAddress(output), invalidStorage);
        EXPECT_EQ(output.capacity(), invalidCapacity);
    }
}

void VerifyUiMultilineViewTests_SnapshotOwnsMultilineModeTextAndCrossLineSelection(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.m_model.setText("ab\ncd"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 4u));
    ASSERT_TRUE(self.shapeView());
    EXPECT_EQ(self.m_view.displayText(), "ab\ncd");
    EXPECT_EQ(self.m_view.selectionRange().begin, 1u);
    EXPECT_EQ(self.m_view.selectionRange().end, 4u);
    EXPECT_EQ(self.m_view.displayCaret(), 4u);
    const u64 revision = self.m_view.revision();
    ASSERT_TRUE(self.m_model.setText("replacement\ntext"));
    EXPECT_EQ(self.m_view.displayText(), "ab\ncd");
    EXPECT_EQ(self.m_view.layout().utf8(), "ab\ncd");
    EXPECT_EQ(self.m_view.revision(), revision);
    EXPECT_EQ(self.m_view.selectionRange().begin, 1u);
    EXPECT_EQ(self.m_view.selectionRange().end, 4u);
    ASSERT_TRUE(self.place());
    ExpectUiRect(self.m_placement.caret, Rect(20.0f, 32.0f, 1.0f, 12.0f));
}

void VerifyUiMultilineViewTests_NewSnapshotRequiresMatchingLayoutBeforePlacementOrHits(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.m_model.setText("old\nview"));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place());
    const EditBoxPlacement previous = self.m_placement;
    ASSERT_TRUE(self.m_model.setText("new\ncontent\n"));
    ASSERT_TRUE(self.m_view.snapshot(self.m_model));
    EXPECT_FALSE(self.m_view.ready());
    EXPECT_FALSE(self.place());
    ExpectUiEditBoxPlacement(self.m_placement, previous);
    EXPECT_FALSE(self.m_view.hitTest(Point(10.0f, 20.0f), previous).has_value());
    auto layout = self.buildLayout(self.m_view.displayText());
    ASSERT_TRUE(layout.has_value());
    ASSERT_TRUE(self.adoptBuiltLayout(layout));
    EXPECT_TRUE(self.m_view.ready());
    ASSERT_TRUE(self.place());
    EXPECT_EQ(self.m_view.layout().lines().size(), 3u);
}

void VerifyUiMultilineViewTests_EmptyAndTrailingHardLinesKeepDistinctCaretRows(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.m_model.setText("ab\n\ncd\n"));
    ASSERT_TRUE(self.shapeView());
    ASSERT_EQ(self.m_view.layout().lines().size(), 4u);
    ASSERT_EQ(self.m_view.caretGeometry().lines().size(), 4u);
    EXPECT_EQ(self.m_view.caretStops().size(), 8u);
    EXPECT_EQ(self.m_view.caretGeometry().lines()[1u].byteBegin, 3u);
    EXPECT_EQ(self.m_view.caretGeometry().lines()[1u].byteEnd, 3u);
    EXPECT_EQ(self.m_view.caretGeometry().lines()[3u].byteBegin, 7u);
    EXPECT_FLOAT_EQ(self.m_view.layout().measure().y, 48.0f);
    ASSERT_TRUE(self.place());
    ExpectUiRect(self.m_placement.caret, Rect(10.0f, 56.0f, 1.0f, 12.0f));
    EXPECT_FLOAT_EQ(self.m_placement.textOrigin.y, 20.0f);
    ASSERT_TRUE(self.m_model.setText(""));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place());
    ASSERT_EQ(self.m_view.caretStops().size(), 1u);
    ASSERT_EQ(self.m_view.caretGeometry().lines().size(), 1u);
    ExpectUiRect(self.m_placement.caret, Rect(10.0f, 20.0f, 1.0f, 12.0f));
}

void VerifyUiMultilineViewTests_HitTestingUsesYAndClampsOutsideTheFirstAndLastLine(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.m_model.setText("ab\ncd\n"));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place());
    Expected<usize> hit = self.m_view.hitTest(Point(21.0f, 26.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), 1u);
    hit = self.m_view.hitTest(Point(21.0f, 50.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), 6u);
    hit = self.m_view.hitTest(Point(21.0f, -100.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), 1u);
    hit = self.m_view.hitTest(Point(100.0f, 400.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), 6u);
}

void VerifyUiMultilineViewTests_LigatureStopsRetainTheirHardLineAndCommittedOffsets(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.m_model.setText("ffi\nffi"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 6u));
    ASSERT_TRUE(self.shapeView());
    ASSERT_EQ(self.m_view.layout().clusters().size(), 2u);
    ASSERT_EQ(self.m_view.caretStops().size(), 8u);
    EXPECT_EQ(self.m_view.caretStops()[1u].lineIndex, 0u);
    EXPECT_FLOAT_EQ(self.m_view.caretStops()[1u].x, 10.0f);
    EXPECT_EQ(self.m_view.caretStops()[5u].lineIndex, 1u);
    EXPECT_EQ(self.m_view.caretStops()[5u].committedByte, 5u);
    EXPECT_FLOAT_EQ(self.m_view.caretStops()[5u].x, 10.0f);
    ASSERT_TRUE(self.place());
    ExpectUiRect(self.m_placement.caret, Rect(30.0f, 32.0f, 1.0f, 12.0f));
    const Expected<usize> hit = self.m_view.hitTest(Point(21.0f, 38.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), 5u);
}

void VerifyUiMultilineViewTests_CrossLinePreeditKeepsNativeScalarCaretInsideItsGrapheme(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.m_model.setText("A\nB\nC"));
    ASSERT_TRUE(self.m_model.setSelection(2u, 3u));
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("x\n\xe1\x84\x92\xe1\x85\xa1\xe1\x86\xab", 0u, 5u));
    ASSERT_TRUE(self.shapeView());
    EXPECT_EQ(self.m_model.text(), "A\nB\nC");
    EXPECT_EQ(self.m_view.displayText(), "A\nx\n\xe1\x84\x92\xe1\x85\xa1\xe1\x86\xab\nC");
    EXPECT_EQ(self.m_view.replacementRange().begin, 2u);
    EXPECT_EQ(self.m_view.replacementRange().end, 3u);
    EXPECT_EQ(self.m_view.preeditRange().begin, 2u);
    EXPECT_EQ(self.m_view.preeditRange().end, 13u);
    EXPECT_EQ(self.m_view.selectionRange().begin, 2u);
    EXPECT_EQ(self.m_view.selectionRange().end, 7u);
    EXPECT_EQ(self.m_view.displayCaret(), 7u);
    ASSERT_TRUE(self.place());
    ExpectUiRect(self.m_placement.caret, Rect(14.0f, 44.0f, 1.0f, 12.0f));
    const Expected<usize> hit = self.m_view.hitTest(Point(20.0f, 62.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), 5u);
    self.m_model.cancelComposition();
    ASSERT_TRUE(self.m_model.setText("changed"));
    EXPECT_TRUE(self.m_view.composing());
    EXPECT_EQ(self.m_view.displayCaret(), 7u);
    ASSERT_TRUE(self.place());
    ExpectUiRect(self.m_placement.caret, Rect(14.0f, 44.0f, 1.0f, 12.0f));
}

void VerifyUiMultilineViewTests_BothScrollAxesRevealCaretAndClampAfterDocumentHomeOrShrink(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.m_model.setText("abcde\nabcdef\nabcdefg"));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place(20.0f, 12.0f));
    EXPECT_FLOAT_EQ(self.m_placement.scroll, 51.0f);
    EXPECT_FLOAT_EQ(self.m_placement.scrollY, 24.0f);
    ExpectUiRect(self.m_placement.caret, Rect(29.0f, 20.0f, 1.0f, 12.0f));
    const Expected<usize> hit = self.m_view.hitTest(Point(self.m_placement.caret.x, self.m_placement.caret.y + 6.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), self.m_model.caret());
    const Point previous = Point(self.m_placement.scroll, self.m_placement.scrollY);
    ASSERT_TRUE(self.m_model.move(EditMove::DocumentHome));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place(20.0f, 12.0f, previous));
    EXPECT_FLOAT_EQ(self.m_placement.scroll, 0.0f);
    EXPECT_FLOAT_EQ(self.m_placement.scrollY, 0.0f);
    ASSERT_TRUE(self.m_model.setText("A"));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place(20.0f, 12.0f, previous));
    EXPECT_FLOAT_EQ(self.m_placement.scroll, 0.0f);
    EXPECT_FLOAT_EQ(self.m_placement.scrollY, 0.0f);
}

void VerifyUiMultilineViewTests_PaddingAndOuterClipIntersectWithoutChangingLogicalLineGeometry(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.m_model.setText("ab\ncd"));
    ASSERT_TRUE(self.shapeView());
    const auto arranged = self.m_view.arrange(
        Rect(10.0f, 20.0f, 100.0f, 40.0f),
        Insets(8.0f, 4.0f, 8.0f, 4.0f),
        Rect(30.0f, 22.0f, 20.0f, 40.0f),
        Point()
   );
    ASSERT_TRUE(arranged.has_value());
    self.m_placement = arranged.value();
    ExpectUiRect(self.m_placement.frameClip, Rect(30.0f, 22.0f, 20.0f, 38.0f));
    ExpectUiRect(self.m_placement.clip, Rect(30.0f, 24.0f, 20.0f, 32.0f));
    ExpectUiRect(self.m_placement.caret, Rect(38.0f, 36.0f, 1.0f, 12.0f));
    EXPECT_FLOAT_EQ(self.m_view.caretGeometry().lines()[1u].top, 12.0f);
}

void VerifyUiMultilineViewTests_ZeroViewportKeepsFiniteCaretAndScrollAndProducesAnEmptyClip(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.m_model.setText("abcde\nabcdef\nabcdefg"));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place(0.0f, 0.0f, Point(500.0f, 500.0f)));
    EXPECT_FLOAT_EQ(self.m_placement.clip.width, 0.0f);
    EXPECT_FLOAT_EQ(self.m_placement.clip.height, 0.0f);
    EXPECT_FLOAT_EQ(self.m_placement.scroll, 71.0f);
    EXPECT_FLOAT_EQ(self.m_placement.scrollY, 36.0f);
    const VectorSingle caretEnd = VectorSingle(self.m_placement.caret.x, self.m_placement.caret.y, 0.0f, 0.0f) + VectorSingle(self.m_placement.caret.width, self.m_placement.caret.height, 0.0f, 0.0f);
    EXPECT_FLOAT_EQ(caretEnd.x, self.m_placement.content.x);
    EXPECT_FLOAT_EQ(caretEnd.y, self.m_placement.content.y);
}

void VerifyUiMultilineViewTests_FailedPlacementPreservesStateAndInvalidHitsAreRejected(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.m_model.setText("abc\ndef"));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place(20.0f, 12.0f));
    const EditBoxPlacement previous = self.m_placement;
    const f32 nan = bit_cast<f32>(0x7fc00000u);
    EXPECT_FALSE(self.place(20.0f, 12.0f, Point(0.0f, nan)));
    ExpectUiEditBoxPlacement(self.m_placement, previous);
    EXPECT_FALSE(self.place(20.0f, 12.0f, Point(0.0f, -1.0f)));
    ExpectUiEditBoxPlacement(self.m_placement, previous);
    EXPECT_FALSE(self.m_view.arrange(Rect(10.0f, 20.0f, -1.0f, 20.0f), Insets(), Rect(), Point()).has_value());
    ExpectUiEditBoxPlacement(self.m_placement, previous);
    EXPECT_FALSE(self.m_view.arrange(previous.bounds, Insets(0.0f, -1.0f, 0.0f, 0.0f), previous.clip, Point()).has_value());
    ExpectUiEditBoxPlacement(self.m_placement, previous);
    EXPECT_FALSE(self.m_view.arrange(previous.bounds, Insets(), previous.clip, Point(), 0.0f).has_value());
    ExpectUiEditBoxPlacement(self.m_placement, previous);
    EXPECT_FALSE(self.m_view.hitTest(Point(10.0f, nan), previous).has_value());
    EditBoxPlacement malformed = previous;
    malformed.textOrigin.y = nan;
    EXPECT_FALSE(self.m_view.hitTest(Point(10.0f, 20.0f), malformed).has_value());
}

void VerifyUiMultilineViewTests_FailedLayoutAdoptionRetainsMultilineGeometryAndPlacement(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.m_model.setText("ab\ncd"));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place());
    const EditBoxPlacement previous = self.m_placement;
    auto wrong = self.buildLayout("other\ntext");
    ASSERT_TRUE(wrong.has_value());
    EXPECT_FALSE(self.adoptBuiltLayout(wrong));
    auto rtl = self.buildDirectionalLayout(self.m_view.displayText(), TextDirection::RightToLeft);
    ASSERT_TRUE(rtl.has_value());
    EXPECT_FALSE(self.adoptBuiltLayout(rtl));
    EXPECT_EQ(self.m_view.layout().utf8(), "ab\ncd");
    EXPECT_EQ(self.m_view.caretGeometry().lines().size(), 2u);
    EXPECT_TRUE(self.m_view.ready());
    ASSERT_TRUE(self.place());
    ExpectUiEditBoxPlacement(self.m_placement, previous);
    EXPECT_NE(self.m_view.shape(self.m_text), TextLayoutStatus::Success);
    ASSERT_TRUE(self.place());
    ExpectUiEditBoxPlacement(self.m_placement, previous);
}

void VerifyUiMultilineViewTests_MovingTheViewRetainsOwnedPreeditLineMappingsAndReadyGeometry(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.m_model.setText("ab\ncd"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 4u));
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("x\ny", 0u, 3u));
    ASSERT_TRUE(self.shapeView());
    ASSERT_TRUE(self.place());
    const EditBoxPlacement previous = self.m_placement;
    EditBoxView assigned = EditBoxView();
    {
        TestValueSlot<EditBoxView> slot;
        mut EditBoxView moved = slot.take(self.m_view);
        TestMoveAssign<EditBoxView>(assigned, moved);
    }
    self.m_model.cancelComposition();
    ASSERT_TRUE(self.m_model.setText("replacement"));
    EXPECT_EQ(assigned.displayText(), "ax\nyd");
    EXPECT_EQ(assigned.layout().utf8(), "ax\nyd");
    EXPECT_TRUE(assigned.composing());
    EXPECT_TRUE(assigned.ready());
    const auto arranged = assigned.arrange(previous.bounds, Insets(), previous.clip, Point());
    ASSERT_TRUE(arranged.has_value());
    self.m_placement = arranged.value();
    ExpectUiEditBoxPlacement(self.m_placement, previous);
    const Expected<usize> hit = assigned.hitTest(Point(30.0f, 38.0f), self.m_placement);
    ASSERT_TRUE(hit.has_value());
    EXPECT_EQ(hit.value(), 5u);
}

void VerifyUiMultilineViewTests_PaintOwnsSelectionSegmentsIncludingAnEmptySelectedHardLine(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.loadFont());
    ASSERT_TRUE(self.m_model.setText("ab\n\ncd\n"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 6u));
    ASSERT_TRUE(self.m_view.snapshot(self.m_model));
    ASSERT_EQ(self.m_view.shape(self.m_text), TextLayoutStatus::Success);
    ASSERT_TRUE(self.place(300.0f, 200.0f));
    ASSERT_TRUE(self.m_model.setText("changed"));
    EditBoxStyle style = EditBoxStyle();
    style.selection = Color(1.0f, 0.0f, 0.0f, 1.0f);
    EditBoxPaintFlags flags = EditBoxPaintFlags();
    flags.focused = true;
    flags.caretVisible = false;
    const auto snapshot = self.paintView(style, flags);
    ASSERT_TRUE(snapshot.has_value());
    PaintVector<Rect> selected = PaintVector<Rect>();
    CollectUiSolidRects(snapshot.value(), style.selection, selected);
    ASSERT_EQ(selected.size(), 3u);
    for(u32 line = 0u; line < 3u; ++line){
        EXPECT_FLOAT_EQ(selected[line].y, self.m_placement.textOrigin.y + self.m_view.caretGeometry().lines()[line].top);
        EXPECT_FLOAT_EQ(selected[line].height, self.m_view.caretGeometry().lines()[line].height);
    }
    EXPECT_FLOAT_EQ(selected[1u].x, self.m_placement.textOrigin.x);
    EXPECT_FLOAT_EQ(selected[1u].width, 1.0f);
    EXPECT_FLOAT_EQ(selected[2u].width, self.m_view.caretGeometry().lines()[2u].advance);
    EXPECT_FALSE(snapshot.value().glyphPages().empty());
    EXPECT_EQ(self.m_view.layout().utf8(), "ab\n\ncd\n");
}

void VerifyUiMultilineViewTests_PaintOwnsPreeditUnderlinesIncludingAnEmptyHardLine(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.loadFont());
    ASSERT_TRUE(self.m_model.setText("A\nB\nC"));
    ASSERT_TRUE(self.m_model.setSelection(2u, 3u));
    ASSERT_TRUE(self.m_model.beginComposition());
    ASSERT_TRUE(self.m_model.updateComposition("x\n\nz", 0u, 4u));
    ASSERT_TRUE(self.m_view.snapshot(self.m_model));
    ASSERT_EQ(self.m_view.shape(self.m_text), TextLayoutStatus::Success);
    ASSERT_TRUE(self.place(300.0f, 200.0f));
    self.m_model.cancelComposition();
    ASSERT_TRUE(self.m_model.setText("changed"));
    EditBoxStyle style = EditBoxStyle();
    style.preedit = Color(0.0f, 1.0f, 0.0f, 1.0f);
    EditBoxPaintFlags flags = EditBoxPaintFlags();
    flags.focused = true;
    flags.caretVisible = false;
    flags.preeditCaretVisible = false;
    const auto snapshot = self.paintView(style, flags);
    ASSERT_TRUE(snapshot.has_value());
    PaintVector<Rect> underlines = PaintVector<Rect>();
    CollectUiSolidRects(snapshot.value(), style.preedit, underlines);
    ASSERT_EQ(underlines.size(), 3u);
    for(u32 index = 0u; index < 3u; ++index){
        const EditCaretLine line = self.m_view.caretGeometry().lines()[index + 1u];
        EXPECT_FLOAT_EQ(underlines[index].y, self.m_placement.textOrigin.y + line.top + line.height - 1.0f);
        EXPECT_FLOAT_EQ(underlines[index].height, 1.0f);
    }
    EXPECT_FLOAT_EQ(underlines[1u].width, 1.0f);
}

void VerifyUiMultilineViewTests_SingleLineCenteringRejectsVerticalScrollInfluence(mut UiMultilineViewTests self){
    ASSERT_TRUE(self.m_model.setText("abc\ndef"));
    ASSERT_TRUE(self.shapeView());
    EditModel single = EditModel();
    ASSERT_TRUE(single.setText("abc"));
    ASSERT_TRUE(self.m_view.snapshot(single));
    auto layout = self.buildLayout(self.m_view.displayText());
    ASSERT_TRUE(layout.has_value());
    ASSERT_TRUE(self.adoptBuiltLayout(layout));
    ASSERT_TRUE(self.place(100.0f, 40.0f, Point(0.0f, 20.0f)));
    EXPECT_FLOAT_EQ(self.m_placement.scrollY, 0.0f);
    EXPECT_FLOAT_EQ(self.m_placement.textOrigin.y, 34.0f);
    EXPECT_FLOAT_EQ(self.m_placement.caret.y, 34.0f);
}

void VerifyUiNestedPopupBuilderTests_ChildLayoutDoesNotConsumeParentSpaceAndRestoresItsPopupToken(mut UiNestedPopupBuilderTests self){
    ASSERT_TRUE(self.beginParent(1u));
    const PopupToken parent = self.m_context.popupToken();
    EXPECT_FALSE(self.m_builder.button(s_UiNestedPopupBuilderBeforeKey, "Before", self.controlOptions()));
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiNestedPopupContextChildKey, self.m_child, MakeNestedChildPopupOptions()));
    const PopupToken child = self.m_context.popupToken();
    EXPECT_NE(child, parent);
    EXPECT_FALSE(self.m_builder.button(s_UiNestedPopupBuilderApplyKey, "Child", self.controlOptions()));
    ASSERT_TRUE(self.m_builder.endPopup());
    EXPECT_EQ(self.m_context.popupToken(), parent);
    EXPECT_FALSE(self.m_builder.balanced());
    EXPECT_FALSE(self.m_builder.button(s_UiNestedPopupBuilderAfterKey, "After", self.controlOptions()));
    ASSERT_TRUE(self.m_builder.endPopup());
    EXPECT_TRUE(self.m_builder.balanced());
    EXPECT_FALSE(self.m_context.popupToken().valid());
    ASSERT_TRUE(self.finishRoot());
    ASSERT_TRUE(self.m_context.commitFrame(1u));

    const Expected<HitTarget> before = self.tryTarget(RequireUiWidgetId(self.parentId(), s_UiNestedPopupBuilderBeforeKey));
    const Expected<HitTarget> after = self.tryTarget(RequireUiWidgetId(self.parentId(), s_UiNestedPopupBuilderAfterKey));
    const Expected<HitTarget> apply = self.tryTarget(RequireUiWidgetId(self.childId(), s_UiNestedPopupBuilderApplyKey));
    ASSERT_TRUE(before.has_value());
    ASSERT_TRUE(after.has_value());
    ASSERT_TRUE(apply.has_value());
    EXPECT_EQ(before.value().popup, parent);
    EXPECT_EQ(after.value().popup, parent);
    EXPECT_EQ(apply.value().popup, child);
    EXPECT_FLOAT_EQ(after.value().rectangle.x, before.value().rectangle.x);
    EXPECT_FLOAT_EQ(after.value().rectangle.y, before.value().rectangle.y + before.value().rectangle.height + self.m_builder.style().gap);
    EXPECT_GT(apply.value().rectangle.x, self.m_parent.placement().bounds.x + self.m_parent.placement().bounds.width);
    EXPECT_EQ(self.m_context.input().focus(), apply.value().id);
}

void VerifyUiNestedPopupBuilderTests_ChildOpenedInsideARowRestoresTheSameParentContainer(mut UiNestedPopupBuilderTests self){
    ASSERT_TRUE(self.beginParent(1u));
    ContainerOptions rowOptions = ContainerOptions();
    rowOptions.width.policy = LayoutSizePolicy::Fixed;
    rowOptions.width.value = 240.0f;
    rowOptions.height.policy = LayoutSizePolicy::Fixed;
    rowOptions.height.value = 30.0f;
    rowOptions.gap = 5.0f;
    ASSERT_TRUE(self.m_builder.beginRow("row", rowOptions));
    const WidgetId row = RequireUiWidgetId(self.parentId(), "row");
    EXPECT_FALSE(self.m_builder.button(s_UiNestedPopupBuilderBeforeKey, "Before", self.controlOptions(100.0f)));
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiNestedPopupContextChildKey, self.m_child, MakeNestedChildPopupOptions()));
    EXPECT_FALSE(self.m_builder.button(s_UiNestedPopupBuilderApplyKey, "Child", self.controlOptions()));
    ASSERT_TRUE(self.m_builder.endPopup());
    EXPECT_EQ(self.m_context.scopeId(), row);
    EXPECT_FALSE(self.m_builder.button(s_UiNestedPopupBuilderAfterKey, "After", self.controlOptions(100.0f)));
    ASSERT_TRUE(self.m_builder.endContainer());
    ASSERT_TRUE(self.m_builder.endPopup());
    ASSERT_TRUE(self.finishRoot());
    ASSERT_TRUE(self.m_context.commitFrame(1u));

    const Expected<HitTarget> before = self.tryTarget(RequireUiWidgetId(row, s_UiNestedPopupBuilderBeforeKey));
    const Expected<HitTarget> after = self.tryTarget(RequireUiWidgetId(row, s_UiNestedPopupBuilderAfterKey));
    const Expected<HitTarget> apply = self.tryTarget(RequireUiWidgetId(RequireUiWidgetId(row, s_UiNestedPopupContextChildKey), s_UiNestedPopupBuilderApplyKey));
    ASSERT_TRUE(before.has_value());
    ASSERT_TRUE(after.has_value());
    ASSERT_TRUE(apply.has_value());
    EXPECT_FLOAT_EQ(after.value().rectangle.x, before.value().rectangle.x + before.value().rectangle.width + rowOptions.gap);
    EXPECT_FLOAT_EQ(after.value().rectangle.y, before.value().rectangle.y);
    EXPECT_EQ(before.value().popup, after.value().popup);
    EXPECT_NE(apply.value().popup, before.value().popup);
}

void VerifyUiNestedPopupBuilderTests_ClosedChildBeginLeavesParentScopeAndFollowingControlsIntact(mut UiNestedPopupBuilderTests self){
    self.m_child.close();
    ASSERT_TRUE(self.beginParent(1u));
    const PopupToken parent = self.m_context.popupToken();
    EXPECT_FALSE(self.m_builder.button(s_UiNestedPopupBuilderBeforeKey, "Before", self.controlOptions()));
    EXPECT_FALSE(self.m_builder.beginPopup(s_UiNestedPopupContextChildKey, self.m_child, MakeNestedChildPopupOptions()));
    EXPECT_FALSE(self.m_context.failed());
    EXPECT_EQ(self.m_context.popupToken(), parent);
    EXPECT_EQ(self.m_context.scopeId(), self.parentId());
    EXPECT_FALSE(self.m_builder.button(s_UiNestedPopupBuilderAfterKey, "After", self.controlOptions()));
    ASSERT_TRUE(self.m_builder.endPopup());
    ASSERT_TRUE(self.finishRoot());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const Expected<HitTarget> after = self.tryTarget(RequireUiWidgetId(self.parentId(), s_UiNestedPopupBuilderAfterKey));
    ASSERT_TRUE(after.has_value());
    EXPECT_FALSE(self.hasTarget(self.childId()));
    EXPECT_EQ(after.value().popup, parent);
}

void VerifyUiNestedPopupBuilderTests_ChildPaintEscapesParentClipAndLayersRemainOrdered(mut UiNestedPopupBuilderTests self){
    ASSERT_TRUE(self.prepareButtons(1u));
    const DrawSnapshot snapshot = self.m_paint.freeze();
    ASSERT_FALSE(snapshot.commands().empty());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    const Expected<HitTarget> apply = self.tryTarget(RequireUiWidgetId(self.childId(), s_UiNestedPopupBuilderApplyKey));
    ASSERT_TRUE(apply.has_value());
    EXPECT_GT(apply.value().clip.x, self.m_parent.placement().bounds.x + self.m_parent.placement().bounds.width);
    EXPECT_LE(apply.value().clip.x, apply.value().rectangle.x);
    EXPECT_LE(apply.value().clip.y, apply.value().rectangle.y);
    const VectorSingle edges = VectorSingle(apply.value().clip.x, apply.value().clip.y, apply.value().rectangle.x, apply.value().rectangle.y) + VectorSingle(apply.value().clip.width, apply.value().clip.height, apply.value().rectangle.width, apply.value().rectangle.height);
    EXPECT_GE(edges.x, edges.z);
    EXPECT_GE(edges.y, edges.w);
    const Expected<HitTarget> after = self.tryTarget(RequireUiWidgetId(self.parentId(), s_UiNestedPopupBuilderAfterKey));
    ASSERT_TRUE(after.has_value());
    EXPECT_GT(apply.value().layer, after.value().layer);
    const Point applyCenter = CenterUiRect(apply.value().rectangle);
    EXPECT_EQ(self.m_context.input().hitTest(applyCenter), apply.value().id);
    u32 previousLayer = 0u;
    b8 childPainted = false;
    for(in DrawCommand command : snapshot.commands()){
        EXPECT_GE(command.layer, previousLayer);
        previousLayer = command.layer;
        childPainted = childPainted || (command.layer == apply.value().layer);
    }
    EXPECT_TRUE(childPainted);
}

void VerifyUiNestedPopupBuilderTests_ChildActionLeavesBothParentControlsAvailableOnLaterDeclarations(mut UiNestedPopupBuilderTests self){
    ASSERT_TRUE(self.acceptButtons(1u));
    const Expected<HitTarget> apply = self.tryTarget(RequireUiWidgetId(self.childId(), s_UiNestedPopupBuilderApplyKey));
    ASSERT_TRUE(apply.has_value());
    const Point applyCenter = CenterUiRect(apply.value().rectangle);
    self.click(applyCenter);
    ASSERT_TRUE(self.acceptButtons(2u));
    EXPECT_TRUE(self.m_childActivated);
    EXPECT_FALSE(self.m_beforeActivated);
    EXPECT_FALSE(self.m_afterActivated);
    self.m_child.close();
    ASSERT_TRUE(self.acceptButtons(3u));
    const Expected<HitTarget> after = self.tryTarget(RequireUiWidgetId(self.parentId(), s_UiNestedPopupBuilderAfterKey));
    ASSERT_TRUE(after.has_value());
    EXPECT_FALSE(self.hasTarget(RequireUiWidgetId(self.childId(), s_UiNestedPopupBuilderApplyKey)));
    const Point afterCenter = CenterUiRect(after.value().rectangle);
    self.click(afterCenter);
    ASSERT_TRUE(self.acceptButtons(4u));
    EXPECT_TRUE(self.m_afterActivated);
    EXPECT_FALSE(self.m_beforeActivated);
    EXPECT_TRUE(self.m_parent.isOpen());
}

void VerifyUiNestedPopupBuilderTests_NestedScopeCapacityRejectsTheNextChildWithoutPublishingTheCandidate(mut UiNestedPopupBuilderTests self){
    ASSERT_EQ(s_InputMaxPopups, 8u);
    Array<PopupState, 9u> states = Array<PopupState, 9u>();
    ASSERT_TRUE(self.begin(1u));
    for(usize index = 0u; index < s_InputMaxPopups; ++index){
        states[index].open();
        ASSERT_TRUE(self.m_builder.beginPopup("level", states[index], MakeNestedParentPopupOptions()));
    }
    states[s_InputMaxPopups].open();
    EXPECT_FALSE(self.m_builder.beginPopup("level", states[s_InputMaxPopups], MakeNestedChildPopupOptions()));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.finishFrame());
    EXPECT_FALSE(self.m_context.commitFrame(1u));
    EXPECT_TRUE(self.m_context.input().targets().empty());
}

