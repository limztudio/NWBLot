#include <impl/assets_mesh/payload_types.adhd>
#include <impl/assets_mesh/skin_types.adhd>
#include <impl/ecs_mesh/runtime/mesh.adhd>
#include <impl/ecs_mesh/skinning/deformation_state.adhd>
#include <impl/ecs_mesh/skinning/joint_palette_validation.adhd>
#include <impl/ecs_mesh/skinning/runtime_cache_types.adhd>
#include <impl/ecs_skeleton/components.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class MeshSkinningRuntimeInstance{
    public RuntimeMeshHandle handle;
    public EntityID entity = s_InvalidEntityId;
    public Name sourceName = s_NameNone;
    public RuntimeMeshLocalBounds localBounds;
    public Vector<f32x3u> restPositions;
    public Vector<f16x4u> restNormals;
    public Vector<f16x4u> restTangents;
    public Vector<f32x2u> uv0;
    public Vector<f16x4u> colors;
    public Vector<MeshletDesc> meshlets;
    public Vector<MeshletBounds> meshletBounds;
    public Vector<u8> meshletPositionRefDeltas;
    public Vector<u8> meshletAttributeRefDeltas;
    public Vector<MeshletLocalVertexRef> meshletLocalVertexRefs;
    public Vector<u8> meshletPrimitiveIndices;
    public Vector<u32> attributeSkins;
    public Span<u32> solidTriangleWords;
    public Vector<SkinInfluence4> skin;
    public Vector<SkeletonJointMatrix> inverseBindMatrices;
    public MeshSkinningDeformationState deformationState;
    public BufferHandle restPositionBuffer;
    public BufferHandle restNormalBuffer;
    public BufferHandle restTangentBuffer;
    public BufferHandle skinnedPositionBuffer;
    public BufferHandle skinnedNormalBuffer;
    public BufferHandle skinnedTangentBuffer;
    public BufferHandle uv0Buffer;
    public BufferHandle colorBuffer;
    public BufferHandle meshletDescBuffer;
    public BufferHandle meshletBoundsBuffer;
    public BufferHandle meshletPositionRefDeltaBuffer;
    public BufferHandle meshletAttributeRefDeltaBuffer;
    public BufferHandle meshletLocalVertexRefBuffer;
    public BufferHandle meshletPrimitiveIndexBuffer;
    public BufferHandle attributeSkinBuffer;
    public BufferHandle triangleIndexBuffer;
    public BufferHandle attributeBuffer;
    public BufferHandle meshletLocalBoundsBuffer;
    public BufferHandle localBoundsBuffer;
    public u32 skeletonJointCount = 0u;
    public u32 meshletPositionRefCount = 0u;
    public u32 meshletAttributeRefCount = 0u;
    public u32 editRevision = 0u;
    public RuntimeMeshDirtyFlag dirtyFlags = RuntimeMeshDirtyFlag::All;

    public b8 hasCompleteSplitMeshPayload()const{
        return HasCompleteSplitMeshSkinningPayload(
            this.restPositions.size(),
            this.restNormals.size(),
            this.restTangents.size(),
            this.uv0.size(),
            this.colors.size(),
            this.skin.size(),
            this.meshlets.size(),
            this.meshletBounds.size(),
            this.meshletPositionRefDeltas.size(),
            this.meshletAttributeRefDeltas.size(),
            this.meshletLocalVertexRefs.size(),
            this.meshletPrimitiveIndices.size(),
            this.meshletPositionRefCount,
            this.meshletAttributeRefCount,
            this.attributeSkins.size()
        );
    }

    public RuntimeMeshBuffers runtimeMeshBuffers()const{
        RuntimeMeshBuffers out = RuntimeMeshBuffers();
        out.positionBuffer = this.skinnedPositionBuffer;
        out.normalBuffer = this.skinnedNormalBuffer;
        out.tangentBuffer = this.skinnedTangentBuffer;
        out.uv0Buffer = this.uv0Buffer;
        out.colorBuffer = this.colorBuffer;
        out.meshletDescBuffer = this.meshletDescBuffer;
        out.meshletBoundsBuffer = this.meshletBoundsBuffer;
        out.meshletPositionRefDeltaBuffer = this.meshletPositionRefDeltaBuffer;
        out.meshletAttributeRefDeltaBuffer = this.meshletAttributeRefDeltaBuffer;
        out.meshletLocalVertexRefBuffer = this.meshletLocalVertexRefBuffer;
        out.meshletPrimitiveIndexBuffer = this.meshletPrimitiveIndexBuffer;
        return out;
    }

    public b8 hasPersistentComputeBuffers()const{
        return
            this.restPositionBuffer.valid()
            && this.restNormalBuffer.valid()
            && this.restTangentBuffer.valid()
            && this.skinnedPositionBuffer.valid()
            && this.skinnedNormalBuffer.valid()
            && this.skinnedTangentBuffer.valid()
            && this.meshletDescBuffer.valid()
            && this.meshletBoundsBuffer.valid()
            && this.meshletPositionRefDeltaBuffer.valid()
            && this.meshletAttributeRefDeltaBuffer.valid()
            && this.meshletLocalVertexRefBuffer.valid()
            && this.meshletPrimitiveIndexBuffer.valid()
            && this.attributeSkinBuffer.valid()
            && this.meshletLocalBoundsBuffer.valid()
            && this.localBoundsBuffer.valid()
        ;
    }

    public b8 valid()const{
        return
            this.entity.valid()
            && this.handle.valid()
            && this.sourceName != s_NameNone
            && this.hasCompleteSplitMeshPayload()
            && this.solidTriangleWords.size() == ExpectedMeshletSolidTriangleWordCount(cast<u32>(this.meshletPrimitiveIndices.size()))
            && this.localBounds.valid()
            && (this.dirtyFlags & RuntimeMeshDirtyFlag::GpuUploadDirty) == RuntimeMeshDirtyFlag::None
            && this.hasPersistentComputeBuffers()
            && this.runtimeMeshBuffers().buffersValid()
        ;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<SkinnedRuntimeMeshIdentity> ResolveSkinnedRuntimeMeshIdentity(in EntityID entity, in RuntimeMeshHandle runtimeMesh, in MeshSkinningRuntimeInstance instance){
    const Expected<SkinnedRuntimeMeshIdentity> identity = TryResolveSkinnedRuntimeMeshIdentity(
        entity, runtimeMesh, instance.entity, instance.dirtyFlags, instance.sourceName, instance.handle.value, instance.editRevision
    );
    if(!identity.has_value())
        return MakeUnexpected(Failure());
    assert(instance.valid(), "runtime mesh instance must be ready");
    assert(instance.meshlets.size() <= cast<usize>(u32.max), "meshlet count must fit in the runtime descriptor");
    assert(instance.meshletPrimitiveIndices.size() <= cast<usize>(u32.max), "primitive index count must fit in the runtime descriptor");
    assert(identity.value().meshKey != s_NameNone, "runtime mesh identity must have a key");
    return identity.value();
}

Expected<RuntimeMeshDesc> BuildSkinnedRuntimeMeshDesc(
    in EntityID entity,
    in RuntimeMeshHandle runtimeMesh,
    in MeshSkinningRuntimeInstance instance,
    in b8 boundsFresh,
    in b8 conesFresh
){
    const Expected<SkinnedRuntimeMeshIdentity> identity = ResolveSkinnedRuntimeMeshIdentity(entity, runtimeMesh, instance);
    if(!identity.has_value())
        return MakeUnexpected(Failure());

    RuntimeMeshDesc mesh;
    mesh.meshKey = identity.value().meshKey;
    mesh.version = identity.value().version;
    mesh.entity = entity;
    mesh.geometryContentRevision = instance.deformationState.contentRevision();
    if(mesh.geometryContentRevision != 0u){
        mesh.localBoundsBuffer = instance.localBoundsBuffer;
        mesh.meshletLocalBoundsBuffer = instance.meshletLocalBoundsBuffer;
    }
    mesh.buffers = instance.runtimeMeshBuffers();
    mesh.triangleIndexBuffer = instance.triangleIndexBuffer;
    mesh.attributeBuffer = instance.attributeBuffer;
    mesh.solidTriangleWords = instance.solidTriangleWords;
    mesh.localBounds = instance.localBounds;
    mesh.meshletCount = cast<u32>(instance.meshlets.size());
    mesh.meshletPrimitiveIndexCount = cast<u32>(instance.meshletPrimitiveIndices.size());
    mesh.dynamicMeshletBoundsFresh = boundsFresh;
    mesh.dynamicMeshletConesFresh = conesFresh;
    assert(mesh.valid(), "published runtime mesh must be valid");
    return mesh;
}

MeshSkinningResourceBuffers CaptureMeshSkinningResourceBuffers(in MeshSkinningRuntimeInstance instance){
    MeshSkinningResourceBuffers buffers = MeshSkinningResourceBuffers();
    buffers[0u] = instance.restPositionBuffer;
    buffers[1u] = instance.restNormalBuffer;
    buffers[2u] = instance.restTangentBuffer;
    buffers[3u] = instance.skinnedPositionBuffer;
    buffers[4u] = instance.skinnedNormalBuffer;
    buffers[5u] = instance.skinnedTangentBuffer;
    buffers[6u] = instance.uv0Buffer;
    buffers[7u] = instance.colorBuffer;
    buffers[8u] = instance.meshletDescBuffer;
    buffers[9u] = instance.meshletBoundsBuffer;
    buffers[10u] = instance.meshletPositionRefDeltaBuffer;
    buffers[11u] = instance.meshletAttributeRefDeltaBuffer;
    buffers[12u] = instance.meshletLocalVertexRefBuffer;
    buffers[13u] = instance.meshletPrimitiveIndexBuffer;
    buffers[14u] = instance.attributeSkinBuffer;
    buffers[15u] = instance.triangleIndexBuffer;
    buffers[16u] = instance.attributeBuffer;
    buffers[17u] = instance.meshletLocalBoundsBuffer;
    buffers[18u] = instance.localBoundsBuffer;
    return buffers;
}

class RuntimeSkinPayloadScratch{
    public Vector<SkeletonJointMatrix> poseJoints;
    public Vector<SkeletonJointMatrix> jointMatrices;
    public usize skinInfluenceCount = 0u;
    public u32 resolvedSkinningMode = cast<u32>(SkeletonSkinningMode::LinearBlend);

    public void reset(in u32 skinningMode){
        this.skinInfluenceCount = 0u;
        this.jointMatrices.clear();
        this.poseJoints.clear();
        this.resolvedSkinningMode = skinningMode;
    }

    public b8 hasActiveSkin()const{
        return this.skinInfluenceCount != 0u && !this.jointMatrices.empty();
    }
}

Expected<Span<SkeletonJointMatrix>> ResolveMeshSkinningGpuJointPalette(
    in MeshSkinningRuntimeInstance instance,
    in RuntimeSkinPayloadScratch payload
){
    const usize jointCount = cast<usize>(instance.skeletonJointCount);
    if(!CanResolveGpuJointPalette(payload.hasActiveSkin(), payload.skinInfluenceCount, instance.skin.size(), jointCount, payload.jointMatrices.size()))
        return MakeUnexpected(Failure());
    return Span<SkeletonJointMatrix>(payload.jointMatrices).subspan(0u, jointCount);
}

b8 BuildMeshSkinningJointPaletteValidated(
    in MeshSkinningRuntimeInstance instance,
    in Span<SkeletonJointMatrix> sourceJoints,
    in u32 skinningMode,
    in b8 sourceJointsValidated,
    mut Vector<SkeletonJointMatrix> outJointPalette
){
    return BuildSkinJointPaletteToGlobalVectorValidated(
        instance.handle.value,
        instance.skeletonJointCount,
        instance.skin.size(),
        sourceJoints,
        sourceJointsValidated,
        instance.inverseBindMatrices,
        true,
        skinningMode,
        outJointPalette
    );
}

b8 BuildMeshSkinningJointPalette(
    in MeshSkinningRuntimeInstance instance,
    in Span<SkeletonJointMatrix> sourceJoints,
    in u32 skinningMode,
    mut Vector<SkeletonJointMatrix> outJointPalette
){
    return BuildMeshSkinningJointPaletteValidated(
        instance,
        sourceJoints,
        skinningMode,
        false,
        outJointPalette
    );
}

b8 PopulateRuntimeSkinPayloadFromCachedPose(
    in MeshSkinningRuntimeInstance instance,
    in Span<SkeletonJointMatrix> cachedPoseJoints,
    in u32 cachedSkinningMode,
    mut RuntimeSkinPayloadScratch payload
){
    payload.skinInfluenceCount = 0u;
    payload.jointMatrices.clear();
    payload.resolvedSkinningMode = cachedSkinningMode;
    if(!BuildMeshSkinningJointPaletteValidated(instance, cachedPoseJoints, cachedSkinningMode, true, payload.jointMatrices))
        return false;
    if(!payload.jointMatrices.empty())
        payload.skinInfluenceCount = instance.skin.size();
    return true;
}

b8 PopulateRuntimeSkinPayloadFromPose(
    in MeshSkinningRuntimeInstance instance,
    in SkeletonPoseComponent skeletonPose,
    mut RuntimeSkinPayloadScratch payload
){
    payload.reset(cast<u32>(SkeletonSkinningMode::LinearBlend));

    const Expected<u32> skinningMode = TryBuildStoredJointPaletteVectorFromSkeletonPose(skeletonPose, payload.poseJoints);
    if(!skinningMode.has_value()){
        payload.poseJoints.clear();
        LogInvalidMeshSkinningSkeletonPose(instance.handle.value);
        return false;
    }
    payload.resolvedSkinningMode = skinningMode.value();
    if(!BuildMeshSkinningJointPaletteValidated(instance, payload.poseJoints, payload.resolvedSkinningMode, true, payload.jointMatrices)){
        payload.poseJoints.clear();
        return false;
    }
    if(!payload.jointMatrices.empty())
        payload.skinInfluenceCount = instance.skin.size();
    return true;
}

b8 PopulateRuntimeSkinPayloadFromPalette(
    in MeshSkinningRuntimeInstance instance,
    in SkeletonJointPaletteComponent jointPalette,
    mut RuntimeSkinPayloadScratch payload
){
    payload.reset(jointPalette.skinningMode);

    if(!BuildMeshSkinningJointPaletteValidated(instance, jointPalette.joints, payload.resolvedSkinningMode, false, payload.jointMatrices))
        return false;
    if(!payload.jointMatrices.empty())
        payload.skinInfluenceCount = instance.skin.size();
    return true;
}


