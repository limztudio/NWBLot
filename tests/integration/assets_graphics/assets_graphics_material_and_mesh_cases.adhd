}

void VerifyAssetsGraphics_MaterialBindDependencyInvalidation(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    const Expected<CookCase> cookCase = PrepareCookCase(testArena, "material_bind_dependency_invalidation");
    ASSERT_TRUE(cookCase.has_value());
    const CookCase prepared = cookCase.value();

    const GraphicsTestPath assetRoot = JoinGraphicsPath(prepared.root, s_AssetsDirectory);
    ASSERT_TRUE(WriteMaterialBindIntegrationAssetsWithPixel(
        testArena,
        assetRoot,
        s_MinimalMaterialBindSource,
        s_BlockScopedMaterialMeta,
        s_MaterialBindShaderProbeSource
    ));

    EXPECT_TRUE(CookSingleAssetRoot(testArena, prepared.root, prepared.outputDirectory, assetRoot));

    MaterialAsset initialMaterial(testArena.arena);
    {
        Expected<MaterialAsset> loadedMaterial = LoadCookedMaterialAsset(testArena, prepared.outputDirectory, Name(s_ProjectMaterialsTestMaterial));
        ASSERT_TRUE(loadedMaterial.has_value());
        initialMaterial = loadedMaterial.value();
    }
    const u64 initialLayoutHash = initialMaterial.typedLayoutHash();

    ShaderArchiveRecordVector records(testArena.arena);
    {
        Expected<ShaderArchiveRecordVector> loadedRecords = LoadShaderArchiveRecords(testArena, prepared.outputDirectory);
        ASSERT_TRUE(loadedRecords.has_value());
        records = loadedRecords.value();
    }
    const Expected<u64> initialChecksumResult = FindTestShaderSourceChecksum(records, Name(s_MaterialPixelShaderPath), Name(s_ShaderStagePs));
    ASSERT_TRUE(initialChecksumResult.has_value());
    const u64 initialPixelSourceChecksum = initialChecksumResult.value();

    EXPECT_TRUE(WriteTextFile(JoinGraphicsPath2(assetRoot, s_MaterialInterfacesDirectory, s_SurfaceBindFilename), s_UpdatedDefaultMaterialBindSource));
    EXPECT_TRUE(CookSingleAssetRoot(testArena, prepared.root, prepared.outputDirectory, assetRoot));

    MaterialAsset updatedMaterial(testArena.arena);
    {
        Expected<MaterialAsset> loadedMaterial2 = LoadCookedMaterialAsset(testArena, prepared.outputDirectory, Name(s_ProjectMaterialsTestMaterial));
        ASSERT_TRUE(loadedMaterial2.has_value());
        updatedMaterial = loadedMaterial2.value();
    }
    EXPECT_NE(updatedMaterial.typedLayoutHash(), initialLayoutHash);

    ShaderArchiveRecordVector updatedRecords(testArena.arena);
    {
        Expected<ShaderArchiveRecordVector> loadedRecords2 = LoadShaderArchiveRecords(testArena, prepared.outputDirectory);
        ASSERT_TRUE(loadedRecords2.has_value());
        updatedRecords = loadedRecords2.value();
    }
    const Expected<u64> updatedChecksumResult = FindTestShaderSourceChecksum(updatedRecords, Name(s_MaterialPixelShaderPath), Name(s_ShaderStagePs));
    ASSERT_TRUE(updatedChecksumResult.has_value());
    EXPECT_NE(updatedChecksumResult.value(), initialPixelSourceChecksum);
    EXPECT_EQ(logger.errorCount(), 0u);

    EXPECT_TRUE(RemoveAllIfExists(prepared.root));
}

void VerifyAssetsGraphics_MaterialBindDiscoveryValidation(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    const Expected<CookCase> cookCase = PrepareCookCase(testArena, "material_bind_valid");
    ASSERT_TRUE(cookCase.has_value());
    const CookCase prepared = cookCase.value();
    EXPECT_TRUE(CookMinimalMeshWithMaterialBind(s_MinimalMaterialBindSource, prepared, testArena));

    const GraphicsTestPath cacheSubdir = JoinGraphicsPath3(prepared.root, s_CacheDirectory, s_TestsConfiguration, s_MaterialBindIncludesDirectory);
    const GraphicsTestPath generatedIncludePath = JoinGraphicsPath3(cacheSubdir, s_ProjectVirtualRoot, s_MaterialInterfacesDirectory, s_SurfaceBindFilename);

    // Removing the last bind source clears its generated include on recook.
    const GraphicsTestPath assetRoot = JoinGraphicsPath(prepared.root, s_AssetsDirectory);
    const Expected<b8, ErrorCode> removedBind = RemoveFile(JoinGraphicsPath2(assetRoot, s_MaterialInterfacesDirectory, s_SurfaceBindFilename));
    ASSERT_TRUE(removedBind.has_value());
    ASSERT_TRUE(removedBind.value());
    ASSERT_TRUE(CookSingleAssetRoot(testArena, prepared.root, prepared.outputDirectory, assetRoot));
    const Expected<b8, ErrorCode> generatedIncludeExists = FileExists(generatedIncludePath);
    ASSERT_TRUE(generatedIncludeExists.has_value());
    EXPECT_FALSE(generatedIncludeExists.value());
    EXPECT_EQ(logger.errorCount(), 0u);
    EXPECT_TRUE(RemoveAllIfExists(prepared.root));

    if(AssetsGraphicsTestConfigurationName() == "fin"){
        const Expected<CookCase> duplicateIncludeCookCase = PrepareCookCase(testArena, "material_bind_duplicate_include_path");
        ASSERT_TRUE(duplicateIncludeCookCase.has_value());
        const CookCase duplicateCase = duplicateIncludeCookCase.value();
        EXPECT_FALSE(CanEmitDuplicateMaterialBindIncludePath(testArena, duplicateCase));
        EXPECT_TRUE(SawCapturedError(logger, "duplicate material bind include path 'project/material_interfaces/test_surface.bind'"));
        EXPECT_TRUE(RemoveAllIfExists(duplicateCase.root));

        const Expected<CookCase> invalidCookCase = PrepareCookCase(testArena, "material_bind_duplicate_field");
        ASSERT_TRUE(invalidCookCase.has_value());
        const CookCase invalidCase = invalidCookCase.value();
        EXPECT_FALSE(CookMinimalMeshWithMaterialBind(s_DuplicateFieldMaterialBindSource, invalidCase, testArena));
        EXPECT_TRUE(SawCapturedError(logger, "duplicate struct field declaration"));
        EXPECT_TRUE(RemoveAllIfExists(invalidCase.root));
    }
}

