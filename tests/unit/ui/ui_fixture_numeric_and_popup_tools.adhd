}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void ExpectNumericEditRejected(in NumericEditResult result, in b8 restored){
    EXPECT_TRUE(result.valid);
    EXPECT_TRUE(result.rejected);
    EXPECT_FALSE(result.committed);
    EXPECT_FALSE(result.valueChanged);
    EXPECT_FALSE(result.cancelled);
    EXPECT_FALSE(result.clamped);
    EXPECT_EQ(result.restored, restored);
}

PopupOptions MakePopupTooltipFixtureOptions(){
    PopupOptions options = PopupOptions();
    options.anchor.x = 40.0f;
    options.anchor.y = 40.0f;
    options.anchor.width = 40.0f;
    options.anchor.height = 24.0f;
    options.size.x = 320.0f;
    options.size.y = 220.0f;
    return options;
}

b8 ApplyNumericHostEvent(in NumericEvent event, in EditBoxOptions options, mut EditModel draft, mut IEditActionSink sink, mut EditBoxResult result){
    if(event.kind == UiFixtureNumericEventKind::Action){
        if(!sink.apply(draft, event.action, options.readOnly)){
            result.valid = false;
            return false;
        }
        result.blurred = result.blurred || (event.action == EditAction::Blur);
        result.abandoned = result.abandoned || (event.action == EditAction::Abandon);
        if(event.action == EditAction::Blur)
            result.focused = false;
        return true;
    }
    if(options.enabled && event.kind == UiFixtureNumericEventKind::Text && !options.readOnly){
        if(!draft.replaceSelection(StringView(event.text.data(), event.text.size()))){
            result.valid = false;
            return false;
        }
        return true;
    }
    if(options.enabled && event.kind == UiFixtureNumericEventKind::Preedit && !options.readOnly){
        const StringView textView = StringView(event.text.data(), event.text.size());
        if(!draft.beginComposition() || !draft.updateComposition(textView, textView.size(), textView.size())){
            result.valid = false;
            return false;
        }
        return true;
    }
    if(options.enabled && event.kind == UiFixtureNumericEventKind::Key){
        const EditCommandResult command = ApplyEditCommand(draft, TranslateEditCommand(event.intent, false, EditTextMode::SingleLine), options.readOnly);
        result.submitted = result.submitted || command.submitted;
        result.cancelled = result.cancelled || command.cancelled;
        if(command.submitted || command.cancelled){
            auto action = EditAction::Cancel;
            if(command.submitted)
                action = EditAction::Submit;
            if(!sink.apply(draft, action, options.readOnly)){
                result.valid = false;
                return false;
            }
            if(command.cancelled){
                result.focused = false;
                return false;
            }
        }
    }
    return true;
}

StringView FormatPopupToolsRowLabel(in u64 count, in u64 index){
    if(index >= count)
        return "";
    switch(index){
    case 0u: return "One";
    case 1u: return "Two";
    case 2u: return "Three";
    case 3u: return "Four";
    case 4u: return "Five";
    default: return "";
    }
}

void SetUpPopupToolsFixture(mut PopupToolsFixture self){
    self.setUpWidgetBase();
    self.m_anchorOptions.width.policy = LayoutSizePolicy::Fixed;
    self.m_anchorOptions.width.value = 220.0f;
    self.m_anchorOptions.height.policy = LayoutSizePolicy::Fixed;
    self.m_anchorOptions.height.value = 32.0f;
    self.m_tooltipOptions.delaySeconds = 0.0f;
    self.m_menuOptions.size = Point(240.0f, 220.0f);
}

b8 DeclarePopupToolsFixture(mut PopupToolsFixture self, in u64 generation, in b8 tooltip, in b8 menu, in Rect bounds){
    if(!self.begin(generation) || !self.m_builder.beginPanel(s_PopupToolsPanelKey, bounds))
        return false;
    self.m_builder.setDeltaSeconds(self.m_deltaSeconds);
    self.m_anchorActivated = self.m_builder.button(s_AnchorKey, "Anchor", self.m_anchorOptions);
    self.m_menuResult = ContextMenuResult();
    if(tooltip && !self.m_builder.tooltip(s_TooltipKey, s_AnchorKey, "Helpful text", self.m_tooltip, self.m_tooltipOptions))
        return false;
    if(menu){
        self.m_menuResult = self.m_builder.contextMenu(s_MenuKey, s_AnchorKey, self.m_source, self.m_menu, self.m_menuOptions);
        if(!self.m_menuResult.valid)
            return false;
    }
    return true;
}

b8 AcceptPopupTooltipFixture(mut PopupToolsFixture self, in u64 generation){
    if(!self.begin(generation))
        return false;
    const PopupOptions options = MakePopupTooltipFixtureOptions();
    self.m_builder.setDeltaSeconds(self.m_deltaSeconds);
    if(!self.m_builder.beginPopup("plain", self.m_plainPopup, options))
        return false;
    self.m_anchorActivated = self.m_builder.button(s_AnchorKey, "Popup anchor", self.m_anchorOptions);
    return self.m_builder.tooltip(s_TooltipKey, s_AnchorKey, "Overlay help", self.m_tooltip, self.m_tooltipOptions)
        && self.m_builder.endPopup()
        && self.m_context.endRoot()
        && self.m_context.finishFrame()
        && self.m_context.commitFrame(generation);
}

b8 MovePopupToolsToAnchor(mut PopupToolsFixture self, in StringView parent){
    const WidgetId anchorId = self.id(s_AnchorKey, parent);
    const Expected<HitTarget> accepted = self.tryTarget(anchorId);
    if(!accepted.has_value())
        return false;
    InputEvent move = InputEvent();
    move.position = CenterUiRect(accepted.value().rectangle);
    move.type = InputEventType::PointerMove;
    return self.send(move).hover == anchorId;
}

void SecondaryClickPopupTools(mut PopupToolsFixture self, in Point point){
    InputEvent down = InputEvent();
    down.position = point;
    down.type = InputEventType::SecondaryDown;
    EXPECT_TRUE(self.send(down).pointerConsumed);
    InputEvent up = InputEvent();
    up.position = point;
    up.type = InputEventType::SecondaryUp;
    EXPECT_TRUE(self.send(up).pointerConsumed);
}

b8 OpenPopupToolsBySecondary(mut PopupToolsFixture self, in u64 generation){
    const Expected<HitTarget> accepted = self.tryTarget(self.id(s_AnchorKey, s_PopupToolsPanelKey));
    if(!accepted.has_value())
        return false;
    self.secondaryClick(CenterUiRect(accepted.value().rectangle));
    return self.acceptTools(generation, false) && self.m_menu.isOpen();
}


