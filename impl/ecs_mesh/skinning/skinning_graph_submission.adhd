////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class UnpublishedSkinningDescriptors : NoCopy{
    private mut MeshSkinningSystem m_system;
    private mut MeshSkinningRuntimeResources m_resources;
    public b8 published = false;

    public UnpublishedSkinningDescriptors(mut MeshSkinningSystem system, mut MeshSkinningRuntimeResources resources){
        this.m_system = system;
        this.m_resources = resources;
    }

    public ~UnpublishedSkinningDescriptors(){
        if(!this.published)
            this.m_system.releaseRuntimeResourceBindlessHeapHandles(this.m_resources);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u32 ResolveRuntimeSkinningJointCount(in b8 hasSkinPayload, in u32 skeletonJointCount){
    if(hasSkinPayload)
        return skeletonJointCount;
    return 0u;
}

u64 ComputeJointPaletteBufferByteSize(in u32 jointCount, in usize jointMatrixByteSize){
    return cast<u64>(jointCount) * cast<u64>(jointMatrixByteSize);
}

b8 ValidateCompiledSkinningGraphPlan(
    in b8 planValidForDeclarations,
    in usize packetCount,
    in b8 terminalMatchesGraphicsQueue
){
    if(!planValidForDeclarations){
        error("MeshSkinningSystem: failed to retain graph-owned skinning compiler inputs");
        return false;
    }
    if(packetCount != 1u){
        error("MeshSkinningSystem: graph-owned skinning work did not merge into one primary Graphics packet");
        return false;
    }
    if(!terminalMatchesGraphicsQueue){
        error("MeshSkinningSystem: graph-owned skinning work did not retain the primary Graphics queue");
        return false;
    }
    return true;
}

void ReportUnacceptedSkinningGraphExecution(in b8 preparationInvoked, in b8 statePrepared){
    if(!preparationInvoked)
        error("MeshSkinningSystem: failed to record graph-owned skinning work");
    else if(!statePrepared)
        error("MeshSkinningSystem: failed to prepare graph-owned skinning frame state");
    else
        error("MeshSkinningSystem: graph-owned skinning submission was rejected");
}

b8 ValidateAcceptedSkinningGraphExecution(
    in b8 graphAccepted,
    in b8 stateAccepted,
    in b8 matchesGraphicsQueue
){
    if(!graphAccepted || !stateAccepted){
        error("MeshSkinningSystem: accepted graph-owned skinning submission lost its retained state");
        return false;
    }
    if(!matchesGraphicsQueue){
        error("MeshSkinningSystem: graph-owned skinning submission lost its Graphics queue identity");
        return false;
    }
    return true;
}

Expected<GpuDescriptorHandle> RegisterSkinningDescriptor(mut GpuDescriptorHeap heap, in GpuDescriptorClass descriptorClass, in DescriptorWriteItem item){
    const Expected<GpuDescriptorHandle> handle = heap.allocate(descriptorClass);
    if(!handle.has_value())
        return MakeUnexpected(Failure());
    GpuDescriptorRetirementGuard retireHandle(heap, handle.value());
    if(!heap.write(handle.value(), item))
        return MakeUnexpected(Failure());
    retireHandle.release();
    return handle.value();
}

b8 RegisterSkinningStorageSlot(
    mut GpuDescriptorHeap heap,
    in RuntimeStorageDescriptorSlot slot,
    in DescriptorWriteItem item,
    mut MeshSkinningRuntimeResources resources
){
    const Expected<GpuDescriptorHandle> handle = RegisterSkinningDescriptor(heap, GpuDescriptorClass::StorageBuffer, item);
    if(!handle.has_value())
        return false;
    resources.bindlessHeapHandles.storageBuffers[cast<usize>(slot)] = handle.value();
    const u32 slotIndex = handle.value().slot();
    switch(slot){
    case RuntimeStorageDescriptorSlot::RestPosition: resources.bindlessResourceSlots.restPosition = slotIndex; break;
    case RuntimeStorageDescriptorSlot::SkinnedPosition: resources.bindlessResourceSlots.skinnedPosition = slotIndex; break;
    case RuntimeStorageDescriptorSlot::RestNormal: resources.bindlessResourceSlots.restNormal = slotIndex; break;
    case RuntimeStorageDescriptorSlot::SkinnedNormal: resources.bindlessResourceSlots.skinnedNormal = slotIndex; break;
    case RuntimeStorageDescriptorSlot::RestTangent: resources.bindlessResourceSlots.restTangent = slotIndex; break;
    case RuntimeStorageDescriptorSlot::SkinnedTangent: resources.bindlessResourceSlots.skinnedTangent = slotIndex; break;
    case RuntimeStorageDescriptorSlot::MeshletDesc: resources.bindlessResourceSlots.meshletDesc = slotIndex; break;
    case RuntimeStorageDescriptorSlot::PositionRefDeltas: resources.bindlessResourceSlots.positionRefDeltas = slotIndex; break;
    case RuntimeStorageDescriptorSlot::AttributeRefDeltas: resources.bindlessResourceSlots.attributeRefDeltas = slotIndex; break;
    case RuntimeStorageDescriptorSlot::AttributeSkins: resources.bindlessResourceSlots.attributeSkins = slotIndex; break;
    case RuntimeStorageDescriptorSlot::LocalVertexRefs: resources.bindlessResourceSlots.localVertexRefs = slotIndex; break;
    case RuntimeStorageDescriptorSlot::PrimitiveIndices: resources.bindlessResourceSlots.primitiveIndices = slotIndex; break;
    case RuntimeStorageDescriptorSlot::MeshletBounds: resources.bindlessResourceSlots.meshletBounds = slotIndex; break;
    case RuntimeStorageDescriptorSlot::MeshletLocalBounds: resources.bindlessResourceSlots.meshletLocalBounds = slotIndex; break;
    case RuntimeStorageDescriptorSlot::LocalBounds: resources.bindlessResourceSlots.localBounds = slotIndex; break;
    case RuntimeStorageDescriptorSlot::SkinInfluences: resources.bindlessResourceSlots.skinInfluences = slotIndex; break;
    case RuntimeStorageDescriptorSlot::JointPalette: resources.bindlessResourceSlots.jointPalette = slotIndex; break;
    case RuntimeStorageDescriptorSlot::AttributeBuffer: resources.bindlessResourceSlots.attributeBuffer = slotIndex; break;
    default:
        assert(false);
        return false;
    }
    return true;
}

Expected<BufferHandle> CreateSkinningJointPaletteBuffer(
    mut GraphicsRuntime graphics,
    in Name debugName,
    in u32 jointCount,
    in usize jointMatrixByteSize,
    in u64 handleValue
){
    BufferDesc jointPaletteBufferDesc = BufferDesc();
    jointPaletteBufferDesc
        .setByteSize(ComputeJointPaletteBufferByteSize(jointCount, jointMatrixByteSize))
        .setStructStride(cast<u32>(jointMatrixByteSize))
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
        .setDebugName(debugName)
        .setInitialState(ResourceStates::Common)
    ;
    const Expected<BufferHandle> jointPaletteBufferResult = graphics.createBuffer(jointPaletteBufferDesc);
    if(!jointPaletteBufferResult.has_value()){
        error("MeshSkinningSystem: failed to create joint palette buffer for runtime mesh '{}'", handleValue);
        return MakeUnexpected(Failure());
    }
    return jointPaletteBufferResult.value();
}

Expected<BufferHandle> CreateSkinningBindlessSlotsBuffer(
    mut GraphicsRuntime graphics,
    in Name debugName,
    in usize slotsByteSize,
    in u64 handleValue
){
    BufferDesc bindlessSlotsBufferDesc = BufferDesc();
    bindlessSlotsBufferDesc
        .setByteSize(cast<u64>(slotsByteSize))
        .setIsConstantBuffer(true)
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
        .setDebugName(debugName)
        .enableAutomaticStateTracking(ResourceStates::Common)
    ;
    const Expected<BufferHandle> bindlessResourceSlotsBufferResult = graphics.createBuffer(bindlessSlotsBufferDesc);
    if(!bindlessResourceSlotsBufferResult.has_value()){
        error("MeshSkinningSystem: failed to create bindless slot buffer for runtime mesh '{}'", handleValue);
        return MakeUnexpected(Failure());
    }
    return bindlessResourceSlotsBufferResult.value();
}

b8 MeshSkinningSystem::createRuntimeResourceBindlessHeapHandles(
    mut MeshSkinningRuntimeInstance instance,
    mut MeshSkinningRuntimeResources resources
){
    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized()){
        error("MeshSkinningSystem: runtime mesh '{}' requires the initialized global descriptor heap", instance.handle.value);
        return false;
    }
    if(!resources.bindlessResourceSlotsBuffer.valid() || !instance.hasPersistentComputeBuffers()){
        error("MeshSkinningSystem: runtime mesh '{}' has incomplete persistent compute buffers", instance.handle.value);
        return false;
    }

    const b8 requiredRegistered =
        RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::RestPosition, DescriptorWriteItemStructuredBufferSrv(0, instance.restPositionBuffer.deref()), resources)
        && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::SkinnedPosition, DescriptorWriteItemStructuredBufferUav(0, instance.skinnedPositionBuffer.deref()), resources)
        && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::RestNormal, DescriptorWriteItemStructuredBufferSrv(0, instance.restNormalBuffer.deref()), resources)
        && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::SkinnedNormal, DescriptorWriteItemStructuredBufferUav(0, instance.skinnedNormalBuffer.deref()), resources)
        && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::RestTangent, DescriptorWriteItemStructuredBufferSrv(0, instance.restTangentBuffer.deref()), resources)
        && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::SkinnedTangent, DescriptorWriteItemStructuredBufferUav(0, instance.skinnedTangentBuffer.deref()), resources)
        && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::MeshletDesc, DescriptorWriteItemStructuredBufferSrv(0, instance.meshletDescBuffer.deref()), resources)
        && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::PositionRefDeltas, DescriptorWriteItemRawBufferSrv(0, instance.meshletPositionRefDeltaBuffer.deref()), resources)
        && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::AttributeRefDeltas, DescriptorWriteItemRawBufferSrv(0, instance.meshletAttributeRefDeltaBuffer.deref()), resources)
        && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::AttributeSkins, DescriptorWriteItemStructuredBufferSrv(0, instance.attributeSkinBuffer.deref()), resources)
        && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::LocalVertexRefs, DescriptorWriteItemStructuredBufferSrv(0, instance.meshletLocalVertexRefBuffer.deref()), resources)
        && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::PrimitiveIndices, DescriptorWriteItemRawBufferSrv(0, instance.meshletPrimitiveIndexBuffer.deref()), resources)
        && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::MeshletBounds, DescriptorWriteItemRawBufferUav(0, instance.meshletBoundsBuffer.deref()), resources)
        && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::MeshletLocalBounds, DescriptorWriteItemRawBufferUav(0, instance.meshletLocalBoundsBuffer.deref()), resources)
        && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::LocalBounds, DescriptorWriteItemRawBufferUav(0, instance.localBoundsBuffer.deref()), resources)
    ;
    b8 ok = requiredRegistered;
    if(ok && resources.skinCount != 0u){
        if(!resources.skinBuffer.valid() || !resources.jointPaletteBuffer.valid()){
            this.releaseRuntimeResourceBindlessHeapHandles(resources);
            error("MeshSkinningSystem: runtime mesh '{}' has incomplete persistent skinning payload buffers", instance.handle.value);
            return false;
        }
        ok =
            RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::SkinInfluences, DescriptorWriteItemStructuredBufferSrv(0, resources.skinBuffer.deref()), resources)
            && RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::JointPalette, DescriptorWriteItemStructuredBufferSrv(0, resources.jointPaletteBuffer.deref()), resources)
        ;
    }

    if(ok && instance.attributeBuffer.valid())
        ok = RegisterSkinningStorageSlot(heap, RuntimeStorageDescriptorSlot::AttributeBuffer, DescriptorWriteItemRawBufferUav(0, instance.attributeBuffer.deref()), resources);

    if(ok){
        const Expected<GpuDescriptorHandle> resourceSlots = RegisterSkinningDescriptor(heap, GpuDescriptorClass::UniformBuffer, DescriptorWriteItemConstantBuffer(0, resources.bindlessResourceSlotsBuffer.deref()));
        if(resourceSlots.has_value()){
            resources.bindlessHeapHandles.resourceSlots = resourceSlots.value();
            return true;
        }
    }

    this.releaseRuntimeResourceBindlessHeapHandles(resources);
    error("MeshSkinningSystem: failed to register persistent compute buffers for runtime mesh '{}' in the descriptor heap", instance.handle.value);
    return false;
}

b8 MeshSkinningSystem::submitFrameSkinningGraph(){
    mut Device device = this.m_graphics.getDevice();
    const GpuPhysicalQueueTopology topology = device.getPhysicalQueueTopology();
    if(topology.queueSpan().empty()){
        error("MeshSkinningSystem: cannot declare graph-owned skinning without a physical queue topology");
        return false;
    }

    this.resetFrameTaskGraph();
    this.m_frameCachedPoseJoints.clear();
    this.m_frameCachedPoses.clear();
    this.m_frameSceneNameIndexBuilt = false;
    const u64 curNameVer = this.m_world.componentMutationVersion<SceneEntityNameComponent>();
    if(curNameVer != this.m_lastSceneNamePoolVersion){
        this.m_unresolvedSkeletonQueries.clear();
        this.m_lastSceneNamePoolVersion = curNameVer;
    }
    mut GpuTaskGraph graph = this.m_frameTaskGraph;
    mut Vector<MeshSkinningGraphDispatchPlan> dispatchPlans = this.m_frameDispatchPlans;
    dispatchPlans.clear();
    auto skinningBindings = this.m_world.view<SkinnedMeshBindingComponent>();
    dispatchPlans.reserve(skinningBindings.candidateCount());

    mut Vector<GpuTaskId> uploadTasks = this.m_frameUploadTasks;
    uploadTasks.clear();
    MeshSkinningFramePlanBuilder planBuilder(this, graph, dispatchPlans, uploadTasks);
    for(in auto row : skinningBindings){
        if(!planBuilder.declare(Get<0>(row), Get<1>(row)))
            return false;
    }

    if(dispatchPlans.empty())
        return true;

    if(!BuildMeshSkinningGraphResourceUsesInto(Span<MeshSkinningGraphDispatchPlan>(dispatchPlans), this.m_frameResourceUsesScratch))
        return false;
    in MeshSkinningGraphResourceUses resourceUses = this.m_frameResourceUsesScratch.uses;

    Array<GpuTaskExternalStateSource, 1u> previousFrameStateSources;
    const auto source = this.m_acceptedSkinningState.borrowSource();
    if(source.has_value())
        previousFrameStateSources[0].setState(source.value());

    GpuTimingSubmissionTicket timingTicket(this.m_graphics.gpuTiming());
    mut Vector<MeshSkinningLocalBoundsDispatch> localBoundsDispatches = this.m_frameLocalBoundsDispatches;
    localBoundsDispatches.clear();
    localBoundsDispatches.reserve(dispatchPlans.size());
    for(in MeshSkinningGraphDispatchPlan plan : dispatchPlans){
        if(plan.updatesMeshletBounds){
            localBoundsDispatches.push_back(MeshSkinningLocalBoundsDispatch(
                plan.bindlessResourceSlotsResource,
                plan.meshletLocalBoundsResource,
                plan.localBoundsResource,
                plan.localBoundsPipeline,
                plan.meshletCount,
                plan.bindlessResourceSlots
            ));
        }
    }
    const Span<MeshSkinningGraphDispatchPlan> allDispatchPlans(dispatchPlans);
    SkinningFinalizerTask finalizerPayload(this, allDispatchPlans);
    MeshSkinningLocalBoundsTask localBoundsPayload(this.m_graphics, timingTicket, localBoundsDispatches);
    GpuTaskId postDispatchDependency;
    b8 hasDeformationTask = false;
    if(!resourceUses.deformation.empty()){
        mut Vector<MeshSkinningGraphDispatchPlan> deformationPlans = this.m_frameDeformationPlans;
        deformationPlans.clear();
        deformationPlans.reserve(dispatchPlans.size());
        for(in MeshSkinningGraphDispatchPlan plan : dispatchPlans){
            if(plan.hasActiveSkin)
                deformationPlans.push_back(plan);
        }
        SkinningPlansTask deformationPayload(this, timingTicket, deformationPlans, true);

        GpuTaskDesc deformationDesc;
        deformationDesc
            .setIdentity(s_FrameDeformationTaskName)
            .setMarkerLabel(s_FrameDeformationTaskLabel)
            .setScheduling(MakeSkinningDispatchScheduling())
            .setResourceUses(resourceUses.deformation)
        ;
        if(source.has_value())
            deformationDesc.setExternalStateSources(Span<GpuTaskExternalStateSource>(previousFrameStateSources));
        if(!uploadTasks.empty())
            deformationDesc.setDependencies(Span<GpuTaskId>(uploadTasks));
        const auto deformationTaskResult = graph.addPreparedPayloadTask(deformationDesc, deformationPayload);
        if(!deformationTaskResult.has_value()){
            error("MeshSkinningSystem: failed to declare graph-owned skinning deformation");
            return false;
        }
        const GpuTaskId deformationTask = deformationTaskResult.value();
        postDispatchDependency = deformationTask;
        hasDeformationTask = true;
    }

    SkinningPlansTask postDispatchPayload(this, timingTicket, allDispatchPlans, false);
    GpuTaskDesc postDispatchDesc;
    postDispatchDesc
        .setIdentity(s_FrameBoundsRepackTaskName)
        .setMarkerLabel(s_FrameBoundsRepackTaskLabel)
        .setScheduling(MakeSkinningDispatchScheduling())
        .setResourceUses(resourceUses.postDispatch)
    ;
    if(source.has_value())
        postDispatchDesc.setExternalStateSources(Span<GpuTaskExternalStateSource>(previousFrameStateSources));
    if(hasDeformationTask)
        postDispatchDesc.setDependency(postDispatchDependency);
    else if(!uploadTasks.empty())
        postDispatchDesc.setDependencies(Span<GpuTaskId>(uploadTasks));
    const auto postDispatchTaskResult = graph.addPreparedPayloadTask(postDispatchDesc, postDispatchPayload);
    if(!postDispatchTaskResult.has_value()){
        error("MeshSkinningSystem: failed to declare graph-owned skinning bounds/repack");
        return false;
    }
    const GpuTaskId postDispatchTask = postDispatchTaskResult.value();

    GpuTaskDesc localBoundsDesc;
    localBoundsDesc
        .setIdentity(s_FrameLocalBoundsTaskName)
        .setMarkerLabel(s_FrameLocalBoundsTaskLabel)
        .setScheduling(MakeSkinningDispatchScheduling())
        .setDependency(postDispatchTask)
        .setResourceUses(resourceUses.localBounds)
    ;
    if(source.has_value())
        localBoundsDesc.setExternalStateSources(Span<GpuTaskExternalStateSource>(previousFrameStateSources));
    const auto localBoundsTaskResult = graph.addPreparedPayloadTask(localBoundsDesc, localBoundsPayload);
    if(!localBoundsTaskResult.has_value()){
        error("MeshSkinningSystem: failed to declare graph-owned local bounds reduction");
        return false;
    }
    const GpuTaskId localBoundsTask = localBoundsTaskResult.value();

    GpuTaskDesc finalizerDesc;
    finalizerDesc
        .setIdentity(s_FrameFinalizeStatesTaskName)
        .setMarkerLabel(s_FrameFinalizeStatesTaskLabel)
        .setScheduling(MakeSkinningDispatchScheduling())
        .setDependency(localBoundsTask)
        .setResourceUses(resourceUses.finalizer)
    ;
    const auto finalizerTaskResult = graph.addPreparedPayloadTask(finalizerDesc, finalizerPayload);
    if(!finalizerTaskResult.has_value()){
        error("MeshSkinningSystem: failed to declare graph-owned skinning final-state handoff");
        return false;
    }
    const GpuTaskId finalizerTask = finalizerTaskResult.value();
    const GpuTaskId terminalTask = finalizerTask;

    mut GpuTaskGraphAnalysis analysis = this.m_frameTaskGraphAnalysis;
    mut GpuTaskGraphQueueAssignments assignments = this.m_frameTaskGraphQueueAssignments;
    mut GpuCompiledGraph compiledGraph = this.m_frameCompiledGraph;
    mut GpuRecordedGraph recordedGraph = this.m_frameRecordedGraph;
    mut GpuGraphSubmissionTransaction transaction = this.m_frameSubmissionTransaction;
    GpuTaskGraphCompileOptions compileOptions;
    compileOptions.packetizationPolicy = GpuTaskGraphPacketizationPolicy::FrontierScored;
    in GpuTaskScheduler scheduler = this.m_graphics.gpuTasks();
    if(!scheduler.scheduleGraph(graph, compileOptions, analysis, assignments, compiledGraph, recordedGraph, transaction)){
        error("MeshSkinningSystem: failed to prepare graph-owned skinning work");
        return false;
    }

    const GpuTaskGraphDeclarationReadView declarations(graph);
    const GpuCompiledGraphReadView compiledPlan(compiledGraph);
    const b8 planValid = compiledPlan.validFor(declarations);
    usize packetCount = 0u;
    if(planValid)
        packetCount = compiledPlan.packetCount();
    const GpuPhysicalQueueId graphicsQueue = device.getPrimaryPhysicalQueue(CommandQueue::Graphics);
    Optional<GpuPhysicalQueueInfo> terminalQueue;
    if(planValid && packetCount == 1u)
        terminalQueue = compiledPlan.findQueueInfoForTask(terminalTask);
    if(!ValidateCompiledSkinningGraphPlan(planValid, packetCount, terminalQueue.has_value() && terminalQueue.value().id == graphicsQueue))
        return false;

    this.collectLiveSkinningStateBuffers();
    GpuPersistentStateCandidate candidate(this.m_acceptedSkinningState);
    SkinningStateHandoff skinningState(this.m_acceptedSkinningState, candidate, Span<BufferHandle>(this.m_frameLiveBuffers));
    Array<GpuTaskGraphTaskRecordedCallback, 1u> recordedCallbacks;
    recordedCallbacks[0] = MakeGpuTaskRecordedCallback(terminalTask, skinningState);
    Array<GpuTaskGraphTaskAcceptedCallback, 1u> acceptedCallbacks;
    acceptedCallbacks[0] = MakeGpuTaskAcceptedCallback(terminalTask, skinningState);
    Array<GpuTaskGraphTaskTimingTicket, 1u> timingTickets;
    timingTickets[0].bind(terminalTask, timingTicket);
    GpuTaskGraphNormalExecutionDesc normalExecution;
    normalExecution.setRecordedCallbacks(Span<GpuTaskGraphTaskRecordedCallback>(recordedCallbacks));
    normalExecution.setAcceptedCallbacks(Span<GpuTaskGraphTaskAcceptedCallback>(acceptedCallbacks));
    normalExecution.setTimingTickets(Span<GpuTaskGraphTaskTimingTicket>(timingTickets));
    const b8 skinningGraphAccepted = scheduler.executeGraph(normalExecution, graph, compiledGraph, recordedGraph, transaction);
    const QueueSubmissionToken skinningToken = transaction.taskToken(compiledPlan, terminalTask);
    if(!skinningToken.valid()){
        if(!transaction.discardUnaccepted(graph, compiledGraph, recordedGraph.recordingAttemptGeneration()))
            this.m_graphics.requestDeviceRecreation();
        ReportUnacceptedSkinningGraphExecution(skinningState.preparationInvoked(), skinningState.statePrepared());
        return false;
    }
    if(!ValidateAcceptedSkinningGraphExecution(
        skinningGraphAccepted,
        skinningState.stateAccepted(),
        skinningToken.matchesPhysicalQueue(graphicsQueue.index, graphicsQueue.deviceGeneration)
    )){
        this.m_graphics.requestDeviceRecreation();
        return false;
    }
    return true;
}

Expected<b8> MeshSkinningSystem::ensureRuntimeResources(mut MeshSkinningRuntimeInstance instance){
    const b8 hasSkinPayload = !instance.skin.empty();
    if(!ValidateMeshSkinningRuntimeResourceCounts(instance.handle.value, instance.skin.size(), instance.skeletonJointCount))
        return MakeUnexpected(Failure());

    MeshSkinningResourceBuffers buffers = CaptureMeshSkinningResourceBuffers(instance);
    const auto entry = this.m_runtimeResources.try_emplace(instance.handle.value);
    mut MeshSkinningRuntimeResources resources = entry.first.value();
    const u32 positionCount = instance.meshletPositionRefCount;
    const u32 attributeCount = instance.meshletAttributeRefCount;
    const u32 meshletCount = cast<u32>(instance.meshlets.size());
    const u32 skinCount = cast<u32>(instance.skin.size());
    const u32 jointCount = ResolveRuntimeSkinningJointCount(hasSkinPayload, instance.skeletonJointCount);
    const b8 rebuild = NeedsMeshSkinningRuntimeResourcesRebuild(
        entry.second,
        resources.buffers == buffers,
        resources.editRevision,
        instance.editRevision,
        resources.positionCount,
        positionCount,
        resources.attributeCount,
        attributeCount,
        resources.meshletCount,
        meshletCount,
        resources.skinCount,
        skinCount,
        resources.jointCount,
        jointCount,
        resources.hasPersistentHeapDescriptors(hasSkinPayload, instance.attributeBuffer.valid()),
        hasSkinPayload,
        resources.skinBuffer.valid() && resources.jointPaletteBuffer.valid()
    );
    if(!rebuild)
        return false;

    MeshSkinningRuntimeResources rebuilt;
    UnpublishedSkinningDescriptors retireRebuilt(this, rebuilt);
    rebuilt.handle = instance.handle;
    rebuilt.buffers = buffers;
    rebuilt.editRevision = instance.editRevision;
    rebuilt.positionCount = positionCount;
    rebuilt.attributeCount = attributeCount;
    rebuilt.meshletCount = meshletCount;
    rebuilt.skinCount = skinCount;
    rebuilt.jointCount = jointCount;

    if(hasSkinPayload){
        const auto skinInfluences = BuildSkinInfluences(instance);
        if(!skinInfluences.has_value())
            return MakeUnexpected(Failure());

        const auto skinBufferName = DeriveRuntimeResourceName(instance.sourceName, instance.handle.value, instance.editRevision, s_SkinBufferSuffix);
        const auto jointPaletteBufferName = DeriveRuntimeResourceName(instance.sourceName, instance.handle.value, instance.editRevision, s_JointPaletteBufferSuffix);
        if(skinBufferName == s_NameNone || jointPaletteBufferName == s_NameNone){
            error("MeshSkinningSystem: failed to derive skinning buffer names for runtime mesh '{}'", instance.handle.value);
            return MakeUnexpected(Failure());
        }

        auto skinBufferResult = SetupBuffer<MeshSkinningInfluenceGpu>(
            this.m_graphics,
            skinBufferName,
            Span<MeshSkinningInfluenceGpu>(skinInfluences.value()),
            BufferFlags(false, false, false, ResourceQueueSharing::GraphicsAndAsyncCompute, false)
        );
        if(!skinBufferResult.has_value()){
            if(skinBufferResult.error() == BufferSetupFailure::ByteSizeOverflow)
                error("MeshSkinningSystem: skin influence payload byte size overflows");
            error("MeshSkinningSystem: failed to create skin buffer for runtime mesh '{}'", instance.handle.value);
            return MakeUnexpected(Failure());
        }
        rebuilt.skinBuffer = skinBufferResult.value();

        auto jointPaletteBufferResult = CreateSkinningJointPaletteBuffer(this.m_graphics, jointPaletteBufferName, jointCount, sizeof(SkeletonJointMatrix), instance.handle.value);
        if(!jointPaletteBufferResult.has_value())
            return MakeUnexpected(Failure());
        rebuilt.jointPaletteBuffer = jointPaletteBufferResult.value();
    }

    const auto bindlessSlotsBufferName = DeriveRuntimeResourceName(instance.sourceName, instance.handle.value, instance.editRevision, s_BindlessSlotsBufferSuffix);
    if(bindlessSlotsBufferName == s_NameNone){
        error("MeshSkinningSystem: failed to derive bindless slot buffer name for runtime mesh '{}'", instance.handle.value);
        return MakeUnexpected(Failure());
    }
    auto bindlessResourceSlotsBufferResult = CreateSkinningBindlessSlotsBuffer(this.m_graphics, bindlessSlotsBufferName, sizeof(MeshSkinningBindlessResourceSlots), instance.handle.value);
    if(!bindlessResourceSlotsBufferResult.has_value()){
        rebuilt.bindlessResourceSlotsBuffer.reset();
        return MakeUnexpected(Failure());
    }
    rebuilt.bindlessResourceSlotsBuffer = bindlessResourceSlotsBufferResult.value();

    if(!this.createRuntimeResourceBindlessHeapHandles(instance, rebuilt))
        return MakeUnexpected(Failure());

    this.releaseRuntimeResourceBindlessHeapHandles(resources);
    resources = rebuilt;
    retireRebuilt.published = true;
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

