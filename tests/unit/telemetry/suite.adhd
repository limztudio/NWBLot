MemorySnapshot Suite_MakeOwnerSnapshot(in Name name, in MemorySourceEnum source){
    MemorySnapshot snapshot = MemorySnapshot();
    snapshot.scopeName = name;
    snapshot.source = source;
    snapshot.frameIndex = 88u;
    snapshot.reservedBytes = 4096u;
    snapshot.usedBytes = 1536u;
    snapshot.peakUsedBytes = 2048u;
    snapshot.allocationCount = 7u;
    snapshot.reallocationCount = 2u;
    snapshot.deallocationCount = 1u;
    return snapshot;
}

OwnedAllocation Suite_MakeOwnedAllocation(mut GlobalArena owner, in usize size){
    OwnedAllocation result = OwnedAllocation();
    native(mut owner, in size, mut result){
        result = OwnedAllocation(owner, size);
    }
    return result;
}

void Suite_ExpectJsonNumber<Number>(mut ScratchArena scratchArena, in StringView record, in StringView field, in Number value){
    native(mut scratchArena, in record, in field, in value){
        ExpectJsonNumberField(scratchArena, record, field, value);
    }
}

void Suite_ExpectMemorySnapshot(in MemorySnapshot actual, in MemorySnapshot expected){
    EXPECT_EQ(actual.scopeName, expected.scopeName);
    EXPECT_EQ(actual.source, expected.source);
    EXPECT_EQ(actual.frameIndex, expected.frameIndex);
    EXPECT_EQ(actual.reservedBytes, expected.reservedBytes);
    EXPECT_EQ(actual.usedBytes, expected.usedBytes);
    EXPECT_EQ(actual.peakUsedBytes, expected.peakUsedBytes);
    EXPECT_EQ(actual.allocationCount, expected.allocationCount);
    EXPECT_EQ(actual.reallocationCount, expected.reallocationCount);
    EXPECT_EQ(actual.deallocationCount, expected.deallocationCount);
}

void Suite_ExpectMemoryDelta(in MemoryDelta actual, in MemoryDelta expected){
    EXPECT_EQ(actual.hasSamples, expected.hasSamples);
    EXPECT_EQ(actual.previousFrameIndex, expected.previousFrameIndex);
    EXPECT_EQ(actual.currentFrameIndex, expected.currentFrameIndex);
    EXPECT_EQ(actual.reservedBytes, expected.reservedBytes);
    EXPECT_EQ(actual.usedBytes, expected.usedBytes);
    EXPECT_EQ(actual.peakUsedBytes, expected.peakUsedBytes);
    EXPECT_EQ(actual.allocationCount, expected.allocationCount);
    EXPECT_EQ(actual.reallocationCount, expected.reallocationCount);
    EXPECT_EQ(actual.deallocationCount, expected.deallocationCount);
}

void VerifyAllocationOwnerTelemetry_RejectsMalformedMemoryPayloadsWithoutInvalidatingPriorValue(){
    TelemetryTestArena testArena = TelemetryTestArena();
    const Name owner = s_TelemetryPayloadValidationOwner;
    const MemorySnapshot snapshot = Suite_MakeOwnerSnapshot(owner, MemorySource::Arena);
    const MemoryDelta delta = MakeTestMemoryDelta(-1);
    TelemetryBytes bytes = TelemetryBytes(testArena.arena);
    ASSERT_TRUE(BuildPerfMemoryPayload(owner, "Payload Validation Owner", snapshot, delta, bytes));

    native(in owner, in snapshot, mut bytes){
        Core::Telemetry::EncodedPerfMemoryPayloadHeader validHeader;
        NWB_MEMCPY(&validHeader, sizeof(validHeader), bytes.data(), sizeof(validHeader));
        auto parsed = Core::Telemetry::ParsePerfMemoryPayload(bytes.data(), bytes.size());
        ASSERT_TRUE(parsed.has_value());
        for(u32 invalidCase = 0u; invalidCase < 9u; ++invalidCase){
            NWB_MEMCPY(bytes.data(), bytes.size(), &validHeader, sizeof(validHeader));
            parsed = Core::Telemetry::ParsePerfMemoryPayload(bytes.data(), bytes.size());
            ASSERT_TRUE(parsed.has_value());
            Core::Telemetry::EncodedPerfMemoryPayloadHeader malformed = validHeader;
            switch(invalidCase){
            case 0u: malformed.version = 0u; break;
            case 1u: malformed.version = 2u; break;
            case 2u: malformed.version = Limit<u16>::s_Max; break;
            case 3u: malformed.source = 3u; break;
            case 4u: malformed.source = Limit<u32>::s_Max; break;
            case 5u: malformed.flags = 0x8000u; break;
            case 6u: malformed.magic = 0u; break;
            case 7u: malformed.scopeHash = {}; break;
            case 8u: ++malformed.scopeNameBytes; break;
            }
            NWB_MEMCPY(bytes.data(), bytes.size(), &malformed, sizeof(malformed));
            EXPECT_FALSE(Core::Telemetry::ParsePerfMemoryPayload(bytes.data(), bytes.size()).has_value());
            Suite_ExpectMemorySnapshot(parsed.value().snapshot, snapshot);
            EXPECT_EQ(parsed.value().scopeName, owner);
        }
        for(const usize truncatedSize : { sizeof(validHeader) - 1u, bytes.size() - 1u }){
            NWB_MEMCPY(bytes.data(), bytes.size(), &validHeader, sizeof(validHeader));
            parsed = Core::Telemetry::ParsePerfMemoryPayload(bytes.data(), bytes.size());
            ASSERT_TRUE(parsed.has_value());
            EXPECT_FALSE(Core::Telemetry::ParsePerfMemoryPayload(bytes.data(), truncatedSize).has_value());
            Suite_ExpectMemorySnapshot(parsed.value().snapshot, snapshot);
            EXPECT_EQ(parsed.value().scopeName, owner);
        }
    }

    MemorySnapshot invalidSnapshot = snapshot;
    native(mut invalidSnapshot){
        invalidSnapshot.source = static_cast<MemorySourceEnum>(255u);
    }
    EXPECT_FALSE(BuildPerfMemoryPayload(owner, "Invalid Source", invalidSnapshot, delta, bytes));
    EXPECT_TRUE(bytes.empty());
}

void VerifyAllocationOwnerTelemetry_SeparatesRecorderSourcesAndKeepsPreviousFrameDuringReplacement(){
    TelemetryTestArena testArena = TelemetryTestArena();
    MemoryRecorder recorder = MemoryRecorder(testArena.arena);
    recorder.setEnabled(true);
    const MemoryView view = MemoryView(recorder);
    const Name owner = s_TelemetryRecorderSourceCollision;
    Array<MemoryScopeId, 3> scopes = Array<MemoryScopeId, 3>();
    Array<MemorySnapshot, 3> previous = Array<MemorySnapshot, 3>();
    for(usize sourceIndex = 0u; sourceIndex < s_SuiteAllMemorySources.size(); ++sourceIndex){
        const MemorySourceEnum source = s_SuiteAllMemorySources[sourceIndex];
        const Expected<MemoryScopeId> scopeResult = recorder.registerScope(owner, source);
        ASSERT_TRUE(scopeResult.has_value());
        scopes[sourceIndex] = scopeResult.value();
        ASSERT_TRUE(scopes[sourceIndex].valid());
        for(usize earlier = 0u; earlier < sourceIndex; ++earlier)
            EXPECT_NE(scopes[earlier].index, scopes[sourceIndex].index);
        ArenaMemoryStats stats = ArenaMemoryStats();
        stats.reservedBytes = 1000u * (sourceIndex + 1u);
        stats.usedBytes = 100u * (sourceIndex + 1u);
        stats.peakUsedBytes = stats.usedBytes;
        stats.allocationCount = sourceIndex + 1u;
        recorder.recordSnapshot(owner, stats, 10u, source);
        previous[sourceIndex] = view.snapshot(owner, source);
        EXPECT_EQ(previous[sourceIndex].source, source);
        EXPECT_EQ(previous[sourceIndex].usedBytes, stats.usedBytes);
        EXPECT_FALSE(view.delta(owner, source).hasSamples);
        stats.usedBytes += 25u;
        stats.peakUsedBytes = stats.usedBytes;
        recorder.recordSnapshot(scopes[sourceIndex], stats, 11u);
        stats.usedBytes += 75u;
        stats.peakUsedBytes = stats.usedBytes;
        ++stats.reallocationCount;
        recorder.recordSnapshot(owner, stats, 11u, source);
        const MemorySnapshot replacement = view.snapshot(scopes[sourceIndex]);
        EXPECT_EQ(replacement.usedBytes, stats.usedBytes);
        EXPECT_EQ(replacement.source, source);
        Suite_ExpectMemorySnapshot(view.snapshot(owner, source), replacement);
        const MemoryDelta expectedDelta = Difference(replacement, previous[sourceIndex]);
        Suite_ExpectMemoryDelta(view.delta(scopes[sourceIndex]), expectedDelta);
        Suite_ExpectMemoryDelta(view.delta(owner, source), expectedDelta);
        EXPECT_EQ(expectedDelta.previousFrameIndex, 10u);
        EXPECT_EQ(expectedDelta.currentFrameIndex, 11u);
        EXPECT_EQ(expectedDelta.usedBytes, 100);
    }
    for(usize sourceIndex = 0u; sourceIndex < s_SuiteAllMemorySources.size(); ++sourceIndex){
        const MemorySourceEnum source = s_SuiteAllMemorySources[sourceIndex];
        const MemorySnapshot snapshot = view.snapshot(owner, source);
        EXPECT_EQ(snapshot.source, source);
        EXPECT_EQ(snapshot.usedBytes, previous[sourceIndex].usedBytes + 100u);
    }
    Suite_ExpectMemorySnapshot(view.snapshot(owner), view.snapshot(scopes[0u]));
    Suite_ExpectMemoryDelta(view.delta(owner), view.delta(scopes[0u]));
}

void VerifyAllocationOwnerTelemetry_CapturesAutomaticAllocationOwnersAcrossEnableReallocationAndDestruction(){
    TelemetryTestArena testArena = TelemetryTestArena();
    const u64 seq = NextAllocationOwnerSequence();
    const Expected<Name> ownerNameResult = DeriveSequenceName(s_TelemetryCaseAutomaticOwner, seq);
    ASSERT_TRUE(ownerNameResult.has_value());
    const Name ownerName = ownerNameResult.value();
    const Expected<Name> scratchNameResult = DeriveSequenceName(s_TelemetryCaseRetiredScratch, seq);
    ASSERT_TRUE(scratchNameResult.has_value());
    const Name scratchName = scratchNameResult.value();

    GlobalArena owner = GlobalArena(ownerName);
    OwnedAllocation allocation = Suite_MakeOwnedAllocation(owner, 53u);
    ASSERT_TRUE(allocation.valid());
    const u64 firstBytes = allocation.usableBytes();
    EXPECT_GE(firstBytes, allocation.requestedBytes);

    b8 scratchAllocated = false;
    const ArenaMemoryStats scratchLiveStats = SampleTemporaryScratchStats(scratchName, scratchAllocated);
    ASSERT_TRUE(scratchAllocated);
    EXPECT_GT(scratchLiveStats.usedBytes, 0u);

    PerfSession perfSession = PerfSession(testArena.arena);
    TelemetryCaptureSession capture = TelemetryCaptureSession(testArena.arena);
    capture.setCaptureOptions(CapturePerfOnly());
    perfSession.beginFrame(40u);
    perfSession.publishFrame();
    const PerfSessionRecordResult disabled = capture.recordPerfReport(perfSession.report(), 23u);
    EXPECT_TRUE(disabled.ok());
    EXPECT_EQ(disabled.memoryEvents, 0u);
    EXPECT_EQ(capture.eventCount(), 0u);
    EXPECT_FALSE(perfSession.memoryView().snapshot(ownerName, MemorySource::Arena).valid());

    perfSession.setCaptureOptions(MakePerfMemoryCaptureOptions());
    perfSession.beginFrame(41u);
    ASSERT_TRUE(perfSession.recordMemorySnapshot(ownerName, owner));
    perfSession.publishFrame();
    const MemorySnapshot first = perfSession.memoryView().snapshot(ownerName, MemorySource::Arena);
    ASSERT_TRUE(first.valid());
    EXPECT_EQ(first.source, MemorySource::Arena);
    EXPECT_EQ(first.frameIndex, 41u);
    EXPECT_EQ(first.usedBytes, firstBytes);
    EXPECT_EQ(first.reservedBytes, firstBytes);
    EXPECT_EQ(first.peakUsedBytes, firstBytes);
    EXPECT_EQ(first.allocationCount, 1u);
    EXPECT_EQ(first.reallocationCount, 0u);
    EXPECT_EQ(first.deallocationCount, 0u);
    EXPECT_FALSE(perfSession.memoryView().delta(ownerName, MemorySource::Arena).hasSamples);
    const MemorySnapshot explicitAlias = perfSession.memoryView().snapshot(ownerName);
    ASSERT_TRUE(explicitAlias.valid());
    EXPECT_EQ(explicitAlias.source, MemorySource::ExplicitScope);
    EXPECT_EQ(explicitAlias.usedBytes, first.usedBytes);
    EXPECT_EQ(explicitAlias.frameIndex, first.frameIndex);
    const MemorySnapshot scratch = perfSession.memoryView().snapshot(scratchName, MemorySource::Arena);
    ASSERT_TRUE(scratch.valid());
    EXPECT_EQ(scratch.reservedBytes, 0u);
    EXPECT_EQ(scratch.usedBytes, 0u);
    EXPECT_EQ(scratch.peakUsedBytes, scratchLiveStats.peakUsedBytes);
    EXPECT_EQ(scratch.allocationCount, scratchLiveStats.allocationCount);
    EXPECT_EQ(scratch.reallocationCount, scratchLiveStats.reallocationCount);
    EXPECT_EQ(scratch.deallocationCount, scratchLiveStats.allocationCount);

    capture.setCaptureOptions(CaptureDisabled());
    const PerfSessionRecordResult filtered = capture.recordPerfReport(perfSession.report(), 23u);
    EXPECT_FALSE(filtered.ok());
    EXPECT_EQ(filtered.memoryEvents, 0u);
    EXPECT_EQ(capture.eventCount(), 0u);
    capture.setCaptureOptions(CapturePerfOnly());
    const PerfSessionRecordResult firstRecorded = capture.recordPerfReport(perfSession.report(), 23u);
    ASSERT_TRUE(firstRecorded.ok());
    EXPECT_GT(firstRecorded.memoryEvents, 0u);
    ASSERT_TRUE(HasOwnerMemoryEvent(capture.view(), ownerName, MemorySource::Arena));
    EXPECT_TRUE(HasOwnerMemoryEvent(capture.view(), ownerName, MemorySource::ExplicitScope));
    EXPECT_EQ(OwnerMemoryEventFrameIndex(capture.view(), ownerName, MemorySource::Arena), 41u);
    const auto parsedFirst = ParseOwnerMemoryEvent(capture.view(), ownerName, MemorySource::Arena);
    ASSERT_TRUE(parsedFirst.has_value());
    Suite_ExpectMemorySnapshot(parsedFirst.value().snapshot, first);
    EXPECT_FALSE(parsedFirst.value().delta.hasSamples);

    ASSERT_TRUE(allocation.resizeTo(101u));
    const u64 resizedBytes = allocation.usableBytes();
    perfSession.beginFrame(42u);
    perfSession.publishFrame();
    const MemorySnapshot second = perfSession.memoryView().snapshot(ownerName, MemorySource::Arena);
    EXPECT_EQ(second.usedBytes, resizedBytes);
    EXPECT_EQ(second.reservedBytes, resizedBytes);
    EXPECT_EQ(second.peakUsedBytes, Max(firstBytes, resizedBytes));
    EXPECT_EQ(second.allocationCount, 1u);
    EXPECT_EQ(second.reallocationCount, 1u);
    EXPECT_EQ(second.deallocationCount, 0u);
    Suite_ExpectMemoryDelta(perfSession.memoryView().delta(ownerName, MemorySource::Arena), Difference(second, first));

    allocation.releaseNow();
    perfSession.beginFrame(43u);
    perfSession.publishFrame();
    const MemorySnapshot retired = perfSession.memoryView().snapshot(ownerName, MemorySource::Arena);
    const MemoryDelta retiredDelta = perfSession.memoryView().delta(ownerName, MemorySource::Arena);
    EXPECT_EQ(retired.usedBytes, 0u);
    EXPECT_EQ(retired.reservedBytes, 0u);
    EXPECT_EQ(retired.peakUsedBytes, second.peakUsedBytes);
    EXPECT_EQ(retired.allocationCount, 1u);
    EXPECT_EQ(retired.reallocationCount, 1u);
    EXPECT_EQ(retired.deallocationCount, 1u);
    Suite_ExpectMemoryDelta(retiredDelta, Difference(retired, second));
    EXPECT_EQ(retiredDelta.usedBytes, -cast<i64>(resizedBytes));
    capture.clear();
    const PerfSessionRecordResult retiredRecorded = capture.recordPerfReport(perfSession.report(), 23u);
    ASSERT_TRUE(retiredRecorded.ok());
    ASSERT_TRUE(HasOwnerMemoryEvent(capture.view(), ownerName, MemorySource::Arena));
    const auto parsedRetired = ParseOwnerMemoryEvent(capture.view(), ownerName, MemorySource::Arena);
    ASSERT_TRUE(parsedRetired.has_value());
    Suite_ExpectMemorySnapshot(parsedRetired.value().snapshot, retired);
    Suite_ExpectMemoryDelta(parsedRetired.value().delta, retiredDelta);
    EXPECT_TRUE(HasOwnerMemoryEvent(capture.view(), scratchName, MemorySource::Arena));
    const Name heapName = s_GlobalArenaMemoryHeapBacking;
    EXPECT_TRUE(HasOwnerMemoryEvent(capture.view(), heapName, MemorySource::HeapBacking));

    ScratchArena scratchArena = ScratchArena(s_TelemetryCaseJsonChecks);
    auto reportResult = BuildTelemetryReport(capture.view(), testArena.arena, scratchArena);
    ASSERT_TRUE(reportResult.has_value());
    const TelemetryReport report = reportResult.value();
    EXPECT_EQ(report.summary.parseFailureCount, 0u);
    const StringView json = ReportJsonView(report);
    const StringView ownerRecord = FindOwnerJsonRecord(json, ownerName, s_SuiteArenaSourceRecord);
    ASSERT_FALSE(ownerRecord.empty());
    EXPECT_NE(ownerRecord.find(ownerName.resolvedText()), usize.max);
    const usize deltaBegin = ownerRecord.find("\"delta\": {");
    ASSERT_NE(deltaBegin, usize.max);
    const StringView ownerFields = ownerRecord.substr(0u, deltaBegin);
    const StringView deltaFields = ownerRecord.substr(deltaBegin);
    Suite_ExpectJsonNumber(scratchArena, ownerFields, "frameIndex", 43u);
    Suite_ExpectJsonNumber(scratchArena, ownerFields, s_SuiteReservedBytesField, retired.reservedBytes);
    Suite_ExpectJsonNumber(scratchArena, ownerFields, s_SuiteUsedBytesField, retired.usedBytes);
    Suite_ExpectJsonNumber(scratchArena, ownerFields, s_SuitePeakUsedBytesField, retired.peakUsedBytes);
    Suite_ExpectJsonNumber(scratchArena, ownerFields, s_SuiteAllocationCountField, retired.allocationCount);
    Suite_ExpectJsonNumber(scratchArena, ownerFields, s_SuiteReallocationCountField, retired.reallocationCount);
    Suite_ExpectJsonNumber(scratchArena, ownerFields, s_SuiteDeallocationCountField, retired.deallocationCount);
    Suite_ExpectJsonNumber(scratchArena, deltaFields, "previousFrameIndex", 42u);
    Suite_ExpectJsonNumber(scratchArena, deltaFields, s_SuiteReservedBytesField, retiredDelta.reservedBytes);
    Suite_ExpectJsonNumber(scratchArena, deltaFields, s_SuiteUsedBytesField, retiredDelta.usedBytes);
    Suite_ExpectJsonNumber(scratchArena, deltaFields, s_SuitePeakUsedBytesField, retiredDelta.peakUsedBytes);
    Suite_ExpectJsonNumber(scratchArena, deltaFields, s_SuiteAllocationCountField, retiredDelta.allocationCount);
    Suite_ExpectJsonNumber(scratchArena, deltaFields, s_SuiteReallocationCountField, retiredDelta.reallocationCount);
    Suite_ExpectJsonNumber(scratchArena, deltaFields, s_SuiteDeallocationCountField, retiredDelta.deallocationCount);
    EXPECT_FALSE(FindOwnerJsonRecord(json, scratchName, "\"source\": \"arena\"").empty());
    EXPECT_FALSE(FindOwnerJsonRecord(json, heapName, "\"source\": \"heapBacking\"").empty());
}

void VerifyAllocationOwnerTelemetry_SharedNameSumsLiveUsageAndPreservesLargestIndividualArenaPeak(){
    TelemetryTestArena testArena = TelemetryTestArena();
    const Expected<Name> ownerNameResult = DeriveSequenceName(s_TelemetryCaseTestsTelemetrySharedArenaPeak, NextAllocationOwnerSequence());
    ASSERT_TRUE(ownerNameResult.has_value());
    const Name ownerName = ownerNameResult.value();

    PerfSession perfSession = PerfSession(testArena.arena);
    perfSession.setCaptureOptions(MakePerfMemoryCaptureOptions());
    GlobalArena firstArena = GlobalArena(ownerName);
    OwnedAllocation firstAllocation = Suite_MakeOwnedAllocation(firstArena, 53u);
    ASSERT_TRUE(firstAllocation.valid());
    const u64 firstBytes = firstAllocation.usableBytes();
    u64 secondBytes = 0u;
    {
        GlobalArena secondArena = GlobalArena(ownerName);
        OwnedAllocation secondAllocation = Suite_MakeOwnedAllocation(secondArena, 101u);
        ASSERT_TRUE(secondAllocation.valid());
        secondBytes = secondAllocation.usableBytes();
        perfSession.beginFrame(71u);
        perfSession.publishFrame();
        const MemorySnapshot both = perfSession.memoryView().snapshot(ownerName, MemorySource::Arena);
        ASSERT_TRUE(both.valid());
        EXPECT_EQ(both.usedBytes, firstBytes + secondBytes);
        EXPECT_EQ(both.reservedBytes, firstBytes + secondBytes);
        EXPECT_EQ(both.peakUsedBytes, Max(firstBytes, secondBytes));
        EXPECT_LT(both.peakUsedBytes, both.usedBytes);
        EXPECT_EQ(both.allocationCount, 2u);
        EXPECT_EQ(both.deallocationCount, 0u);
    }

    perfSession.beginFrame(72u);
    perfSession.publishFrame();
    const MemorySnapshot surviving = perfSession.memoryView().snapshot(ownerName, MemorySource::Arena);
    ASSERT_TRUE(surviving.valid());
    EXPECT_EQ(surviving.usedBytes, firstBytes);
    EXPECT_EQ(surviving.reservedBytes, firstBytes);
    EXPECT_EQ(surviving.peakUsedBytes, Max(firstBytes, secondBytes));
    EXPECT_EQ(surviving.allocationCount, 2u);
    EXPECT_EQ(surviving.deallocationCount, 1u);
    const MemoryDelta delta = perfSession.memoryView().delta(ownerName, MemorySource::Arena);
    EXPECT_TRUE(delta.hasSamples);
    EXPECT_EQ(delta.usedBytes, -cast<i64>(secondBytes));
    EXPECT_EQ(delta.peakUsedBytes, 0);

    TelemetryCaptureSession capture = TelemetryCaptureSession(testArena.arena);
    capture.setCaptureOptions(CapturePerfOnly());
    const PerfSessionRecordResult recorded = capture.recordPerfReport(perfSession.report(), 17u);
    ASSERT_TRUE(recorded.ok());
    ScratchArena scratchArena = ScratchArena(s_TelemetryCaseTestsTelemetrySharedArenaPeakJsonChecks);
    auto reportResult = BuildTelemetryReport(capture.view(), testArena.arena, scratchArena);
    ASSERT_TRUE(reportResult.has_value());
    const TelemetryReport report = reportResult.value();
    EXPECT_EQ(report.summary.parseFailureCount, 0u);
    const StringView json = ReportJsonView(report);
    const StringView record = FindOwnerJsonRecord(json, ownerName, s_SuiteArenaSourceRecord);
    ASSERT_FALSE(record.empty());
    EXPECT_NE(record.find("\"peakBasis\": \"largestArena\""), usize.max);
    Suite_ExpectJsonNumber(scratchArena, record, s_SuiteUsedBytesField, firstBytes);
    Suite_ExpectJsonNumber(scratchArena, record, s_SuitePeakUsedBytesField, Max(firstBytes, secondBytes));
}

void VerifyAllocationOwnerTelemetry_KeepsHeapBackingRecordsWithoutCountingTheirUsageAgain(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CapturePerfOnly());
    const Name owner = s_TelemetrySharedSourceIdentity;
    for(usize sourceIndex = 0u; sourceIndex < s_SuiteAllMemorySources.size(); ++sourceIndex){
        const MemorySourceEnum source = s_SuiteAllMemorySources[sourceIndex];
        MemorySnapshot snapshot = Suite_MakeOwnerSnapshot(owner, source);
        // Keep explicit scope counters separate from the aliased arena summary.
        if(source == MemorySource::HeapBacking){
            snapshot.usedBytes = 300u;
            snapshot.peakUsedBytes = 3000u;
        }
        else{
            snapshot.usedBytes = 100u;
            snapshot.peakUsedBytes = 1000u;
        }
        MemoryDelta delta = MakeTestMemoryDelta(-1);
        if(source == MemorySource::HeapBacking)
            delta.usedBytes = 30;
        else
            delta.usedBytes = 10;
        ASSERT_TRUE(RecordPerfMemory(recorder, owner, "Shared Owner", snapshot, delta, 7u));
    }
    ScratchArena scratchArena = ScratchArena(s_TelemetryCaseHeapJsonChecks);
    auto reportResult = BuildTelemetryReport(recorder.view(), testArena.arena, scratchArena);
    ASSERT_TRUE(reportResult.has_value());
    const TelemetryReport report = reportResult.value();
    EXPECT_EQ(report.summary.parseFailureCount, 0u);
    EXPECT_EQ(report.summary.memoryEventCount, 3u);
    for(in MemorySourceEnum source : s_SuiteAllMemorySources){
        const TelemetryMemorySummary summary = report.summary.memorySources[source];
        EXPECT_EQ(summary.eventCount, 1u);
        u64 expectedUsed = 100u;
        u64 expectedPeak = 1000u;
        i64 expectedDelta = 10;
        if(source == MemorySource::HeapBacking){
            expectedUsed = 300u;
            expectedPeak = 3000u;
            expectedDelta = 30;
        }
        EXPECT_EQ(summary.maxUsedBytes, expectedUsed);
        EXPECT_EQ(summary.maxPeakUsedBytes, expectedPeak);
        EXPECT_EQ(summary.totalUsedDeltaBytes, expectedDelta);
    }
    const StringView json = ReportJsonView(report);
    EXPECT_NE(json.find("\"memorySources\": {"), usize.max);
    EXPECT_EQ(json.find("\"maxMemoryUsedBytes\":"), usize.max);
    EXPECT_EQ(json.find("\"maxMemoryPeakUsedBytes\":"), usize.max);
    EXPECT_EQ(json.find("\"totalMemoryUsedDeltaBytes\":"), usize.max);
    EXPECT_FALSE(FindOwnerJsonRecord(json, owner, "\"source\": \"explicitScope\"").empty());
    EXPECT_FALSE(FindOwnerJsonRecord(json, owner, "\"source\": \"arena\"").empty());
    const StringView heapRecord = FindOwnerJsonRecord(json, owner, s_SuiteHeapBackingSourceRecord);
    ASSERT_FALSE(heapRecord.empty());
    Suite_ExpectJsonNumber(scratchArena, heapRecord, s_SuiteUsedBytesField, 300u);
    Suite_ExpectJsonNumber(scratchArena, heapRecord, s_SuitePeakUsedBytesField, 3000u);
}

void VerifyAllocationOwnerTelemetry_ResolvesLoadedOwnerSymbolsByFullIdentityAndPreservesExplicitText(){
    TelemetryTestArena testArena = TelemetryTestArena();
    native(mut testArena){
        namespace NameSymbols = Core::Common::NameSymbols;
        NameSymbols::InstallRuntimeRegistry();
        NameSymbols::ClearRuntimeSymbols();
        NameHash firstHash{};
        for(u32 lane = 0u; lane < s_NameHashLaneCount; ++lane)
            firstHash.qwords[lane] = 0xBD876543210ACDEFuLL + lane;
        NameHash secondHash = firstHash;
        ++secondHash.qwords[s_NameHashLaneCount - 1u];
        NameHash unknownHash = secondHash;
        ++unknownHash.qwords[s_NameHashLaneCount - 1u];
        const Name firstOwner(firstHash);
        const Name secondOwner(secondHash);
        const Name unknownOwner(unknownHash);
        Array<char, NameHashTextCodec::s_TextLength + 1u> firstHashText = {};
        Array<char, NameHashTextCodec::s_TextLength + 1u> secondHashText = {};
        Array<char, NameHashTextCodec::s_TextLength + 1u> unknownHashText = {};
        NameHashTextCodec::Format(firstHashText.data(), sizeof(firstHashText), firstHash);
        NameHashTextCodec::Format(secondHashText.data(), sizeof(secondHashText), secondHash);
        NameHashTextCodec::Format(unknownHashText.data(), sizeof(unknownHashText), unknownHash);

        TelemetryRecorder recorder(testArena.arena);
        recorder.setCaptureOptions(CapturePerfOnly());
        // Exact hash fallback text reproduces an opt/fin producer that has no local symbol sidecar loaded.
        ASSERT_TRUE(RecordPerfMemory(recorder, firstOwner, firstHashText.data(), Suite_MakeOwnerSnapshot(firstOwner, MemorySource::Arena), MakeTestMemoryDelta(-1), 91u));
        ASSERT_TRUE(RecordPerfMemory(recorder, secondOwner, secondHashText.data(), Suite_MakeOwnerSnapshot(secondOwner, MemorySource::Arena), MakeTestMemoryDelta(-1), 92u));
        ASSERT_TRUE(RecordPerfMemory(recorder, firstOwner, "Producer Display Name", Suite_MakeOwnerSnapshot(firstOwner, MemorySource::ExplicitScope), MakeTestMemoryDelta(-1), 93u));
        ASSERT_TRUE(RecordPerfMemory(recorder, unknownOwner, unknownHashText.data(), Suite_MakeOwnerSnapshot(unknownOwner, MemorySource::HeapBacking), MakeTestMemoryDelta(-1), 94u));
        ScratchArena scratchArena(s_TelemetryCaseTestsTelemetryReportWork);
        auto reportResult4 = BuildTelemetryReport(recorder.view(), testArena.arena, scratchArena);
        ASSERT_TRUE(reportResult4.has_value());
        TelemetryReport report = Move(reportResult4.value());
        const AStringView beforeJson = ReportJsonView(report);
        const AStringView beforeRecord = FindOwnerJsonRecord(beforeJson, firstOwner, s_SuiteArenaSourceRecord);
        ASSERT_FALSE(beforeRecord.empty());
        EXPECT_EQ(CountText(beforeRecord, firstHashText.data()), 2u);

        AString<GlobalArena> namesymText(testArena.arena);
        StringAppendFormat(namesymText, "{}\tproducer=runtime\n{}\truntime\tOwners/Loaded First\n{}\truntime\tOwners/Loaded Second\n", NameSymbols::s_FileHeader, firstHashText.data(), secondHashText.data());
        ASSERT_TRUE(NameSymbols::LoadFromMemory(AStringView(namesymText.data(), namesymText.size()), scratchArena));
        auto reportResult5 = BuildTelemetryReport(recorder.view(), testArena.arena, scratchArena);
        ASSERT_TRUE(reportResult5.has_value());
        report = Move(reportResult5.value());
        EXPECT_EQ(report.summary.parseFailureCount, 0u);
        const AStringView json = ReportJsonView(report);
        const AStringView firstRecord = FindOwnerJsonRecord(json, firstOwner, s_SuiteArenaSourceRecord);
        const AStringView secondRecord = FindOwnerJsonRecord(json, secondOwner, s_SuiteArenaSourceRecord);
        const AStringView explicitRecord = FindOwnerJsonRecord(json, firstOwner, "\"source\": \"explicitScope\"");
        const AStringView unknownRecord = FindOwnerJsonRecord(json, unknownOwner, s_SuiteHeapBackingSourceRecord);
        ASSERT_FALSE(firstRecord.empty());
        ASSERT_FALSE(secondRecord.empty());
        ASSERT_FALSE(explicitRecord.empty());
        ASSERT_FALSE(unknownRecord.empty());
        EXPECT_NE(firstRecord.find("\"scope\": \"owners/loaded first\""), AStringView::npos);
        EXPECT_NE(secondRecord.find("\"scope\": \"owners/loaded second\""), AStringView::npos);
        EXPECT_EQ(CountText(firstRecord, firstHashText.data()), 1u);
        EXPECT_EQ(CountText(secondRecord, secondHashText.data()), 1u);
        EXPECT_NE(explicitRecord.find("\"scope\": \"Producer Display Name\""), AStringView::npos);
        EXPECT_EQ(CountText(unknownRecord, unknownHashText.data()), 2u);
    }
}

native{
namespace TelemetryTestDetail{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace TestCases = NWB::Tests::TelemetryCases;

namespace{
Atomic<u64> g_AllocationOwnerSequence{ 0u };
}

u64 NextAllocationOwnerSequence()noexcept{
    return g_AllocationOwnerSequence.fetch_add(1u, MemoryOrder::relaxed);
}

const Telemetry::EventRecord* FindOwnerEvent(const Telemetry::EventView& events, const Name& owner, const Core::Perf::MemorySource::Enum source)noexcept{
    for(usize eventIndex = 0u; eventIndex < events.eventCount(); ++eventIndex){
        const Telemetry::EventRecord* const event = events.eventAt(eventIndex);
        if(!event || event->header.kind != Telemetry::EventKind::MemoryFrame)
            continue;
        const auto parsed = Telemetry::ParsePerfMemoryPayload(event->payload.data(), event->payload.size());
        if(parsed && parsed->scopeName == owner && parsed->snapshot.source == source)
            return event;
    }
    return nullptr;
}

AStringView FindOwnerJsonRecord(const AStringView json, const Name& owner, const AStringView sourceField){
    Array<char, NameHashTextCodec::s_TextLength + 1u> identityText = {};
    NameHashTextCodec::Format(identityText.data(), sizeof(identityText), owner.hash());
    usize cursor = json.find("\"memoryRecords\": [");
    while(cursor != AStringView::npos && cursor < json.size()){
        const usize nextLine = json.find('\n', cursor);
        const AStringView line = json.substr(cursor, nextLine == AStringView::npos ? json.size() - cursor : nextLine - cursor);
        if(line.find(identityText.data()) != AStringView::npos && line.find(sourceField) != AStringView::npos)
            return line;
        if(line.find("    ]") != AStringView::npos || nextLine == AStringView::npos)
            break;
        cursor = nextLine + 1u;
    }
    return {};
}

void BuildTestFrameGraph(Telemetry::TelemetryArena& arena, Telemetry::FrameGraphNodeDescs& nodes, Telemetry::FrameGraphEdgeDescs& edges){
    nodes = Telemetry::FrameGraphNodeDescs(arena);
    edges = Telemetry::FrameGraphEdgeDescs(arena);

    nodes.push_back(Telemetry::FrameGraphNodeDesc{ .name = Name(TestCases::s_Gbuffer), .label = AStringView("GBuffer Pass"), .kind = Telemetry::FrameGraphNodeKind::Pass, .flags = 1u, .queueAssignment = {}, .compiledTask = {}, .runtimeStatistics = {}, });
    nodes.push_back(Telemetry::FrameGraphNodeDesc{ .name = Name(TestCases::s_Albedo), .label = AStringView("Albedo Texture"), .kind = Telemetry::FrameGraphNodeKind::Resource, .flags = 0u, .queueAssignment = {}, .compiledTask = {}, .runtimeStatistics = {}, });
    nodes.push_back(Telemetry::FrameGraphNodeDesc{ .name = Name(TestCases::s_Lighting), .label = AStringView("Lighting Pass"), .kind = Telemetry::FrameGraphNodeKind::Pass, .flags = 0u, .queueAssignment = {}, .compiledTask = {}, .runtimeStatistics = {}, });

    edges.push_back(Telemetry::FrameGraphEdgeDesc{ .fromNodeIndex = 0u, .toNodeIndex = 1u, .kind = Telemetry::FrameGraphEdgeKind::Writes, });
    edges.push_back(Telemetry::FrameGraphEdgeDesc{ .fromNodeIndex = 1u, .toNodeIndex = 2u, .kind = Telemetry::FrameGraphEdgeKind::Reads, .flags = 2u, });
}

Telemetry::FrameGraphQueueAssignment MakeChangedFrameGraphQueueAssignment()noexcept{
    Telemetry::FrameGraphQueueAssignment assignment;
    assignment.initialQueue = { .index = 1u, .deviceGeneration = 17u };
    assignment.plannedQueue = { .index = 3u, .deviceGeneration = 17u };
    assignment.acceptedQueue = assignment.plannedQueue;
    assignment.previousAcceptedQueue = { .index = 2u, .deviceGeneration = 17u };
    assignment.score = { .overlap = 7, .queueLoad = 3, .incomingCrossings = 2, .outgoingCrossings = 1, .ownershipTransfers = 4, .total = -3, };
    assignment.queueClass = Telemetry::FrameGraphQueueClass::Compute;
    assignment.reason = Telemetry::FrameGraphQueueAssignmentReason::Scored;
    assignment.modifiers = Telemetry::FrameGraphQueueAssignmentModifier::All;
    assignment.acceptance = Telemetry::FrameGraphQueueAssignmentAcceptance::Changed;
    assignment.dedicated = true;
    assignment.present = true;
    return assignment;
}

Telemetry::FrameGraphQueueAssignment MakeNotAcceptedFrameGraphQueueAssignment()noexcept{
    Telemetry::FrameGraphQueueAssignment assignment;
    assignment.initialQueue = { .index = 4u, .deviceGeneration = 17u };
    assignment.plannedQueue = { .index = 5u, .deviceGeneration = 17u };
    assignment.previousAcceptedQueue = { .index = 2u, .deviceGeneration = 17u };
    assignment.score = { .overlap = 6, .queueLoad = 1, .incomingCrossings = 2, .outgoingCrossings = 3, .ownershipTransfers = 4, .total = -4, };
    assignment.queueClass = Telemetry::FrameGraphQueueClass::Transfer;
    assignment.reason = Telemetry::FrameGraphQueueAssignmentReason::Scored;
    assignment.modifiers = Telemetry::FrameGraphQueueAssignmentModifier::TimingFeedback;
    assignment.acceptance = Telemetry::FrameGraphQueueAssignmentAcceptance::NotAccepted;
    assignment.present = true;
    return assignment;
}

