class UiListSource : IListDataSource{
    public u64 instanceGeneration()const override{ return 1u; }
    public u64 revision()const override{ return 1u; }
    public u64 rowCount()const override{ return s_VirtualListRowCount; }
    public u64 key(in u64 index)const override{ return ResolveImmutableListSourceKey(index, cast<usize>(s_VirtualListRowCount)); }
    public Expected<u64> indexOf(in u64 keyValue)const override{ return TryResolveImmutableListSourceIndex(keyValue, cast<usize>(s_VirtualListRowCount)); }
    public Expected<u64> findEnabled(in u64 start, in b8 reverse)const override{ return FindEnabledImmutableListSourceRow(start, reverse, cast<usize>(s_VirtualListRowCount), 0u); }
    public StringView text(in u64 index)const override{ return FormatVirtualListRowLabel(this.key(index), this.m_label); }
    public b8 enabled(in u64 index)const override{ return IsImmutableListSourceRowEnabled(index, cast<usize>(s_VirtualListRowCount), 0u); }

    private Array<u8, s_VirtualListLabelCapacity> m_label;
}

