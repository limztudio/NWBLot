[reflect]
enum<u8> ReflectionTraceMode{
    enum Disabled,
    enum ScreenSpace,
    enum Hardware,
    enum Hybrid
}

[reflect]
enum<u8> ReflectionDebugView{
    enum None,
    enum TraceSource,
    enum Confidence
}

const u32 s_ReflectionDefaultTemporalMaxSamples = 16u;
const u32 s_ReflectionDefaultSpatialRadius = 2u;
const f32 s_ReflectionDefaultMaxRayDistance = 100.0f;
const f32 s_ReflectionDefaultDistanceFadeStart = 80.0f;
const f32 s_ReflectionDefaultRoughnessCutoff = 0.8f;
const u32 s_ReflectionDefaultMaxHardwareRaysPerFrame = 262144u;
const u32 s_ReflectionDefaultMaxOpticalQueries = 16u;
const u32 s_ReflectionDefaultScreenMaxSteps = 96u;
const f32 s_ReflectionDefaultScreenThickness = 0.03f;
const f32 s_ReflectionDefaultScreenConfidenceThreshold = 0.8f;
const f32 s_ReflectionDefaultScreenEdgeFade = 0.05f;
const f32 s_ReflectionDefaultEnvTopR = 0.15f;
const f32 s_ReflectionDefaultEnvTopG = 0.2f;
const f32 s_ReflectionDefaultEnvTopB = 0.3f;
const f32 s_ReflectionDefaultEnvBottomRgb = 0.04f;
const f32x3u s_ReflectionDefaultEnvironmentTop(s_ReflectionDefaultEnvTopR, s_ReflectionDefaultEnvTopG, s_ReflectionDefaultEnvTopB);
const f32x3u s_ReflectionDefaultEnvironmentBottom(s_ReflectionDefaultEnvBottomRgb, s_ReflectionDefaultEnvBottomRgb, s_ReflectionDefaultEnvBottomRgb);

// One timed range owns a begin and an end timestamp query.
const u32 s_ReflectionGpuTimingQueriesPerRange = 2u;

[reflect]
class ReflectionSettings{
    public u32 temporalMaxSamples = s_ReflectionDefaultTemporalMaxSamples;
    public u32 samplingSeed = 0u;
    public u32 spatialRadius = s_ReflectionDefaultSpatialRadius;
    // Reflected-path distance in world units, not camera-to-receiver distance.
    public f32 maxRayDistance = s_ReflectionDefaultMaxRayDistance;
    public f32 distanceFadeStart = s_ReflectionDefaultDistanceFadeStart;
    public f32 roughnessCutoff = s_ReflectionDefaultRoughnessCutoff;
    public u32 maxHardwareRaysPerFrame = s_ReflectionDefaultMaxHardwareRaysPerFrame;
    // Scene queries per admitted path, including optional initial-medium discovery.
    public u32 maxOpticalQueries = s_ReflectionDefaultMaxOpticalQueries;
    public u32 screenMaxSteps = s_ReflectionDefaultScreenMaxSteps;
    // Surface uncertainty, confidence, and edge-fade width.
    public f32 screenThickness = s_ReflectionDefaultScreenThickness;
    public f32 screenConfidenceThreshold = s_ReflectionDefaultScreenConfidenceThreshold;
    public f32 screenEdgeFade = s_ReflectionDefaultScreenEdgeFade;
    // Linear HDR radiance for ordinary exterior misses.
    public f32x3u environmentTop = s_ReflectionDefaultEnvironmentTop;
    public f32x3u environmentBottom = s_ReflectionDefaultEnvironmentBottom;
    public ReflectionTraceMode traceMode = ReflectionTraceMode::Enum::Hybrid;
    public ReflectionDebugView debugView = ReflectionDebugView::Enum::None;
    public b8 diagnosticsEnabled = false;
    // Lets stable smooth Hybrid tiles bypass proven screen misses. Off until measured.
    public b8 screenFeedbackEnabled = false;
    public b8 temporalEnabled = true;
    public b8 spatialFilterEnabled = true;
}

b8 SameReflectionTraceSettings(in ReflectionSettings first, in ReflectionSettings second){
    return
        first.traceMode == second.traceMode && first.samplingSeed == second.samplingSeed
        && first.maxHardwareRaysPerFrame == second.maxHardwareRaysPerFrame && first.maxOpticalQueries == second.maxOpticalQueries
        && first.maxRayDistance == second.maxRayDistance && first.distanceFadeStart == second.distanceFadeStart
        && first.roughnessCutoff == second.roughnessCutoff && first.screenMaxSteps == second.screenMaxSteps
        && first.screenThickness == second.screenThickness && first.screenConfidenceThreshold == second.screenConfidenceThreshold
        && first.screenEdgeFade == second.screenEdgeFade
        && first.environmentTop.x == second.environmentTop.x && first.environmentTop.y == second.environmentTop.y
        && first.environmentTop.z == second.environmentTop.z && first.environmentBottom.x == second.environmentBottom.x
        && first.environmentBottom.y == second.environmentBottom.y && first.environmentBottom.z == second.environmentBottom.z;
}

// Settings are an external boundary; reject invalid values early.
b8 ValidateReflectionSettings(in ReflectionSettings settings){
    const u32 s_MaxTemporalSamples = 256u;
    const u32 s_MaxSpatialRadius = 3u;
    if(settings.temporalMaxSamples == 0u || settings.temporalMaxSamples > s_MaxTemporalSamples || settings.spatialRadius > s_MaxSpatialRadius){
        return false;
    }
    if(settings.maxOpticalQueries == 0u || settings.maxOpticalQueries > s_ReflectionDefaultMaxOpticalQueries){
        return false;
    }
    if(cast<u8>(settings.traceMode) > cast<u8>(ReflectionTraceMode::Enum::Hybrid) || cast<u8>(settings.debugView) > cast<u8>(ReflectionDebugView::Enum::Confidence)){
        return false;
    }
    if(
        !isFinite(settings.maxRayDistance) || settings.maxRayDistance <= 0.0f
        || !isFinite(settings.distanceFadeStart) || settings.distanceFadeStart < 0.0f
        || settings.distanceFadeStart >= settings.maxRayDistance
        || !isFinite(settings.roughnessCutoff) || settings.roughnessCutoff < 0.0f || settings.roughnessCutoff > 1.0f
    ){
        return false;
    }
    const u32 s_MinScreenSteps = 8u;
    const u32 s_MaxScreenSteps = 256u;
    const f32 s_MaxScreenEdgeFade = 0.25f;
    if(
        settings.screenMaxSteps < s_MinScreenSteps || settings.screenMaxSteps > s_MaxScreenSteps
        || !isFinite(settings.screenThickness) || settings.screenThickness <= 0.0f
        || !isFinite(settings.screenConfidenceThreshold)
        || settings.screenConfidenceThreshold <= 0.0f || settings.screenConfidenceThreshold > 1.0f
        || !isFinite(settings.screenEdgeFade) || settings.screenEdgeFade < 0.0f || settings.screenEdgeFade > s_MaxScreenEdgeFade
    ){
        return false;
    }
    return isFinite(settings.environmentTop.x) && isFinite(settings.environmentTop.y) && isFinite(settings.environmentTop.z)
        && isFinite(settings.environmentBottom.x) && isFinite(settings.environmentBottom.y) && isFinite(settings.environmentBottom.z)
        && settings.environmentTop.x >= 0.0f && settings.environmentTop.y >= 0.0f && settings.environmentTop.z >= 0.0f
        && settings.environmentBottom.x >= 0.0f && settings.environmentBottom.y >= 0.0f && settings.environmentBottom.z >= 0.0f;
}

b8 SameReflectionEstimatorSettings(in ReflectionSettings first, in ReflectionSettings second){
    // Diagnostics/filter leave the temporal estimator unchanged.
    return first.temporalEnabled == second.temporalEnabled && first.temporalMaxSamples == second.temporalMaxSamples && SameReflectionTraceSettings(first, second);
}

// Unavailable or unstamped inputs disable temporal reuse; versions alone prove nothing.
class ReflectionSceneContentStamp{
    public u64 geometry;
    public u64 material;
    public u64 lighting;
    public u64 view;
    public b8 trusted;

    public ReflectionSceneContentStamp(){
        this.geometry = 0u;
        this.material = 0u;
        this.lighting = 0u;
        this.view = 0u;
        this.trusted = false;
    }

    public ReflectionSceneContentStamp(in u64 inGeometry, in u64 inMaterial, in u64 inLighting, in u64 inView, in b8 inTrusted){
        this.geometry = inGeometry;
        this.material = inMaterial;
        this.lighting = inLighting;
        this.view = inView;
        this.trusted = inTrusted;
    }

    public b8 matchesScene(in ReflectionSceneContentStamp other)const{
        return this.geometry == other.geometry && this.material == other.material && this.lighting == other.lighting && this.trusted == other.trusted;
    }
}

enum<u8> ReflectionFeedbackResetReason{
    enum None,
    enum FirstObservation,
    enum ResourcesChanged,
    enum SettingsChanged,
    enum SceneChanged,
    enum ViewChanged,
    enum Disabled,
    enum UntrustedScene,
    enum HardwareChanged,
    enum InvalidAcceptance
}

class ReflectionFeedbackPlan{
    public ReflectionSceneContentStamp stamp;
    public ReflectionSettings settings;
    public u64 generation = 0u;
    public u64 sequence = 0u;
    public u64 acceptedSequence = 0u;
    public u64 epoch = 0u;
    public u64 graphicsFrameIndex = 0u;
    public u64 startGraphicsFrame = 0u;
    public u32 probeIndex = 0u;
    public u32 currentBank = 0u;
    public u32 previousBank = 0u;
    public b8 enabled = false;
    public b8 eligible = false;
    public b8 reused = false;
    public b8 reset = false;
    public b8 previousHardwareReady = false;
    public b8 quarantined = false;
    public ReflectionFeedbackResetReason resetReason = ReflectionFeedbackResetReason::Enum::None;
}

class ReflectionFeedbackOutcome{
    public u64 epoch = 0u;
    public u64 startGraphicsFrame = 0u;
    public u32 probeIndex = 0u;
    public b8 eligible = false;
    public b8 reused = false;
    public b8 reset = false;
    public ReflectionFeedbackResetReason resetReason = ReflectionFeedbackResetReason::Enum::None;
}

ReflectionFeedbackOutcome ResolveReflectionFeedbackOutcome(in ReflectionFeedbackPlan plan, in b8 hardwareReady){
    const b8 hardwareChanged = !plan.reset && plan.acceptedSequence != 0u && plan.previousHardwareReady != hardwareReady;
    ReflectionFeedbackOutcome result;
    if(hardwareChanged){
        result.epoch = plan.epoch + 1u;
        result.startGraphicsFrame = plan.graphicsFrameIndex;
        result.probeIndex = 0u;
    }
    else{
        result.epoch = plan.epoch;
        result.startGraphicsFrame = plan.startGraphicsFrame;
        result.probeIndex = plan.probeIndex;
    }
    result.eligible = plan.eligible && hardwareReady;
    result.reused = result.eligible && plan.reused && !hardwareChanged;
    result.reset = plan.reset || hardwareChanged;
    if(hardwareChanged){
        result.resetReason = ReflectionFeedbackResetReason::Enum::HardwareChanged;
    }
    else{
        result.resetReason = plan.resetReason;
    }
    return result;
}

enum<u8> ReflectionHistoryResetReason{
    enum None,
    enum FirstSample,
    enum SceneChanged,
    enum ViewChanged,
    enum SettingsChanged,
    enum HardwareChanged,
    enum UntrustedScene,
    enum Disabled,
    enum ResourcesChanged
}

class ReflectionHistoryPlan{
    public ReflectionSceneContentStamp stamp;
    public ReflectionSettings settings;
    public u64 generation = 0u;
    public u64 sequence = 0u;
    public u64 acceptedSequence = 0u;
    public u64 epoch = 0u;
    public u64 graphicsFrameIndex = 0u;
    public u64 historyStartGraphicsFrame = 0u;
    public u32 sampleIndex = 0u;
    public u32 previousSampleCount = 0u;
    public u32 currentBank = 0u;
    public u32 previousBank = 0u;
    public b8 eligible = false;
    public b8 reused = false;
    public b8 reset = false;
    public b8 previousHardwareReady = false;
    public ReflectionHistoryResetReason resetReason = ReflectionHistoryResetReason::Enum::None;
}

class ReflectionHistoryOutcome{
    public u64 epoch = 0u;
    public u64 historyStartGraphicsFrame = 0u;
    public u32 sampleIndex = 0u;
    public u32 sampleCount = 0u;
    public b8 eligible = false;
    public b8 reused = false;
    public b8 reset = false;
    public ReflectionHistoryResetReason resetReason = ReflectionHistoryResetReason::Enum::None;
}

ReflectionHistoryOutcome ResolveReflectionHistoryOutcome(in ReflectionHistoryPlan plan, in b8 hardwareReady){
    const b8 hardwareChanged = !plan.reset && plan.acceptedSequence != 0u && plan.previousHardwareReady != hardwareReady;
    ReflectionHistoryOutcome result;
    if(hardwareChanged){
        result.epoch = plan.epoch + 1u;
        result.sampleIndex = 0u;
    }
    else{
        result.epoch = plan.epoch;
        result.sampleIndex = plan.sampleIndex;
    }
    result.eligible = plan.eligible;
    result.reused = plan.reused && !hardwareChanged;
    if(result.eligible){
        if(result.reused){
            result.historyStartGraphicsFrame = plan.historyStartGraphicsFrame;
        }
        else{
            result.historyStartGraphicsFrame = plan.graphicsFrameIndex;
        }
    }
    else{
        result.historyStartGraphicsFrame = 0u;
    }
    result.reset = plan.reset || hardwareChanged;
    if(hardwareChanged){
        result.resetReason = ReflectionHistoryResetReason::Enum::HardwareChanged;
    }
    else{
        result.resetReason = plan.resetReason;
    }
    if(result.eligible){
        u32 nextSampleCount = 1u;
        if(result.reused){
            nextSampleCount = plan.previousSampleCount + 1u;
        }
        if(nextSampleCount < plan.settings.temporalMaxSamples){
            result.sampleCount = nextSampleCount;
        }
        else{
            result.sampleCount = plan.settings.temporalMaxSamples;
        }
    }
    else{
        result.sampleCount = 0u;
    }
    return result;
}

class ReflectionFeedbackExtent{
    public u32 width;
    public u32 height;
    public u32 tilesX;
    public u32 tilesY;
    public u32 entryCount;
    public u32 byteCount;

    public ReflectionFeedbackExtent(){
        this.width = 0u;
        this.height = 0u;
        this.tilesX = 0u;
        this.tilesY = 0u;
        this.entryCount = 0u;
        this.byteCount = 0u;
    }

    public ReflectionFeedbackExtent(in u32 inWidth, in u32 inHeight, in u32 inTilesX, in u32 inTilesY, in u32 inEntryCount, in u32 inByteCount){
        this.width = inWidth;
        this.height = inHeight;
        this.tilesX = inTilesX;
        this.tilesY = inTilesY;
        this.entryCount = inEntryCount;
        this.byteCount = inByteCount;
    }

    public b8 valid()const{
        return this.byteCount != 0u;
    }
}

const u32 s_ReflectionFeedbackGroupSize = 8u;
const u64 s_ReflectionFeedbackSurfaceCount = 2u;
const u64 s_ReflectionFeedbackHeaderBytes = 16u;
const u64 s_ReflectionFeedbackEntryBytes = 4u;
const u64 s_ReflectionFeedbackMaxCount = 0xffffffffull;

b8 TryComputeReflectionFeedbackExtent(in u32 width, in u32 height, mut ReflectionFeedbackExtent outExtent){
    if(width == 0u || height == 0u){
        return false;
    }
    const u32 tilesX = (width - 1u) / s_ReflectionFeedbackGroupSize + 1u;
    const u32 tilesY = (height - 1u) / s_ReflectionFeedbackGroupSize + 1u;
    const u64 entryCount = cast<u64>(tilesX) * cast<u64>(tilesY) * s_ReflectionFeedbackSurfaceCount;
    const u64 byteCount = s_ReflectionFeedbackHeaderBytes + entryCount * s_ReflectionFeedbackEntryBytes;
    if(entryCount > s_ReflectionFeedbackMaxCount || byteCount > s_ReflectionFeedbackMaxCount){
        return false;
    }
    outExtent = ReflectionFeedbackExtent(width, height, tilesX, tilesY, cast<u32>(entryCount), cast<u32>(byteCount));
    return true;
}

class ReflectionDepthPyramidMip{
    public Name taskIdentity = s_NameNone;
    public u32 sampledSlot = 0u;
    public u32 storageSlot = 0u;
    public u32 width = 0u;
    public u32 height = 0u;
}

[serialize]
class ReflectionFrameParameters{
    public u32 width = 0u;
    public u32 height = 0u;
    public u32 traceMode = 0u;
    public u32 hardwareEnabled = 0u;
    public u32 opaqueSpecularSlot = 0u;
    public u32 glassSpecularSlot = 0u;
    public u32 opaqueOutputSlot = 0u;
    public u32 glassOutputSlot = 0u;
    public u32 opaqueRadianceSlot = 0u;
    public u32 glassRadianceSlot = 0u;
    public u32 queueSlot = 0u;
    public u32 counterSlot = 0u;
    public u32 argsSlot = 0u;
    public u32 queueCapacity = 0u;
    public u32 maxHardwareRays = 0u;
    public u32 sampleIndex = 0u;
    public u32 deferredResourcesSlot = 0u;
    public u32 viewSlot = 0u;
    public u32 materialContextSlot = 0u;
    public u32 debugView = 0u;
    public u32 depthPyramidSlot = 0u;
    public u32 depthMipCount = 0u;
    public u32 screenMaxSteps = s_ReflectionDefaultScreenMaxSteps;
    public u32 diagnosticsEnabled = 0u;
    public u32 samplingSeed = 0u;
    public u32 sampleBaseX = 0u;
    public u32 sampleBaseY = 0u;
    public u32 maxOpticalQueries = s_ReflectionDefaultMaxOpticalQueries;
    public u32 feedbackReadSlot = 0u;
    public u32 feedbackWriteSlot = 0u;
    public u32 feedbackFlags = 0u;
    public u32 feedbackProbeIndex = 0u;
    public f32 maxRayDistance = s_ReflectionDefaultMaxRayDistance;
    public f32 distanceFadeStart = s_ReflectionDefaultDistanceFadeStart;
    public f32 roughnessCutoff = s_ReflectionDefaultRoughnessCutoff;
    public f32 environmentTopR = s_ReflectionDefaultEnvTopR;
    public f32 environmentTopG = s_ReflectionDefaultEnvTopG;
    public f32 environmentTopB = s_ReflectionDefaultEnvTopB;
    public f32 environmentBottomR = s_ReflectionDefaultEnvBottomRgb;
    public f32 environmentBottomG = s_ReflectionDefaultEnvBottomRgb;
    public f32 environmentBottomB = s_ReflectionDefaultEnvBottomRgb;
    public f32 screenThickness = s_ReflectionDefaultScreenThickness;
    public f32 screenConfidenceThreshold = s_ReflectionDefaultScreenConfidenceThreshold;
    public f32 screenEdgeFade = s_ReflectionDefaultScreenEdgeFade;
}

const StringView s_ReflectionHwOpticalVariant = "NWB_REFLECTION_OPTICAL_TRANSPORT=1;NWB_RT_CSG_ENABLED=0";
const StringView s_ReflectionHwPlainVariant = "NWB_REFLECTION_OPTICAL_TRANSPORT=0;NWB_RT_CSG_ENABLED=0";
const StringView s_ReflectionHwUnspecifiedVariant = "NWB_REFLECTION_OPTICAL_TRANSPORT=2;NWB_RT_CSG_ENABLED=0";
const StringView s_ReflectionBuildArgsVariant = "NWB_RT_CSG_ENABLED=0";
const StringView s_ReflectionCsgBuildArgsVariant = "NWB_RT_CSG_ENABLED=1";
