    throw Tests::FilesystemCases::s_FilesystemPublishLogFailure;
}

void ThrowingPublishLogger::enqueue(const Core::Common::LogString&, Core::Common::LogType::Enum){
    throw Tests::FilesystemCases::s_FilesystemPublishLogFailure;
