[cpp_header("<global/range_partition.h>"), cpp_name("::BalancedPartitionRange"), cpp_layout(16, 8), cpp_flags(self_defaulted, small_value, binary_serializable, brace_init)]
extern class BalancedPartitionRange{
    usize first;
    usize last;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<global/range_partition.h>"), cpp_name("::ComputeBalancedPartitionRange")]
extern BalancedPartitionRange ComputeBalancedPartitionRange(in isize a0, in isize a1, in isize a2, in isize a3);


