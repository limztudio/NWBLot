////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_CSG_BINDLESS_RESOURCES_SLANGI
#define NWB_GRAPHICS_CSG_BINDLESS_RESOURCES_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "runtime.slangi"
#include "../deferred/bindless_resources.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Interval/peel resources are generation heap entries. The CSG context selects the deferred-slot payload.
#ifndef NWB_GRAPHICS_CSG_RUNTIME_SLANGI
#error "CSG bindless resources require the CSG runtime context selector"
#endif

#define g_NwbCsgBindlessResources nwbHeapDeferredBindlessResources(g_NwbCsgClipContextSlots.deferredBindlessResources)

uint nwbCsgReceiverEventLayerCount(){
    uint width = 1u;
    uint height = 1u;
    uint layerCount = 1u;
    nwbHeapStorageImage2DArrayUint4(g_NwbCsgBindlessResources.csgPeelSlots.w).GetDimensions(width, height, layerCount);
    return min(layerCount, NWB_CSG_RECEIVER_EVENT_LAYER_COUNT);
}

uint nwbCsgReceiverSpanLayerCount(){
    uint width = 1u;
    uint height = 1u;
    uint layerCount = 1u;
    nwbHeapStorageImage2DArrayUint4(g_NwbCsgBindlessResources.csgSpanSlots.y).GetDimensions(width, height, layerCount);
    return min(layerCount, NWB_CSG_RECEIVER_SPAN_LAYER_COUNT);
}

uint nwbCsgRemovedIntervalLayerCount(){
    uint width = 1u;
    uint height = 1u;
    uint layerCount = 1u;
    nwbHeapStorageImage2DArrayFloat4(g_NwbCsgBindlessResources.csgSpanSlots.w).GetDimensions(width, height, layerCount);
    return min(layerCount, NWB_CSG_REMOVED_INTERVAL_LAYER_COUNT);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

