native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/shader/shader_system.adhd.h>

#include <core/graphics/backend_selection/backend.h>
#include <core/graphics/rhi/gpu_descriptor_heap.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace RendererComputePipelineDetail{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] inline b8 EnsurePushConstantBindingLayout(
    Core::Alloc::GlobalArena& arena,
    Core::GraphicsBackend::Device& device,
    const u32 pushConstantBytes,
    const Core::ShaderType::Mask visibility,
    Core::BindingLayoutHandle& inOutLayout
){
    if(inOutLayout)
        return true;

    Core::BindingLayoutDesc desc(arena);
    desc.setVisibility(visibility);
    desc.addItem(Core::BindingLayoutItem::PushConstants(0u, pushConstantBytes));
    auto layoutResult = device.createBindingLayout(desc);
    if(layoutResult)
        inOutLayout = Move(*layoutResult);
    else
        inOutLayout.reset();
    return static_cast<b8>(layoutResult);
}

[[nodiscard]] inline b8 CreateHeapComputePipeline(
    Core::GraphicsBackend::Device& device,
    const Core::ShaderHandle& shader,
    const Core::BindingLayoutHandle& bindingLayout,
    const b8 includeAccelStruct,
    Core::ComputePipelineHandle& outPipeline
){
    Core::GpuDescriptorHeap& heap = device.getDescriptorHeap();
    if(!heap.isInitialized() || (includeAccelStruct && !heap.hasAccelStructLayout()))
        return false;

    Core::ComputePipelineDesc desc;
    desc.setComputeShader(shader).addBindingLayout(bindingLayout).addBindingLayout(heap.getResourceLayout()).addBindingLayout(heap.getSamplerLayout());
    if(includeAccelStruct)
        desc.addBindingLayout(heap.getAccelStructLayout());
    auto pipelineResult = device.createComputePipeline(desc);
    if(pipelineResult)
        outPipeline = Move(*pipelineResult);
    else
        outPipeline.reset();
    return static_cast<b8>(pipelineResult);
}

template<typename SubsystemT>
[[nodiscard]] inline b8 EnsurePushConstantComputePipeline(
    Core::Alloc::GlobalArena& arena,
    Core::GraphicsBackend::Device& device,
    RendererShaderSystem& shaderSystem,
    const Core::Assets::AssetRef<ComputeShader> SubsystemT::* member,
    const AStringView variantName,
    const Name& debugName,
    const u32 pushConstantBytes,
    const b8 includeAccelStruct,
    Core::BindingLayoutHandle& inOutLayout,
    Core::ShaderHandle& inOutShader,
    Core::ComputePipelineHandle& inOutPipeline
){
    if(inOutPipeline)
        return true;

    const Core::GpuDescriptorHeap& heap = device.getDescriptorHeap();
    if(!heap.isInitialized() || (includeAccelStruct && !heap.hasAccelStructLayout()))
        return false;
    if(!EnsurePushConstantBindingLayout(arena, device, pushConstantBytes, Core::ShaderType::Compute, inOutLayout))
        return false;
    if(!shaderSystem.loadShader<ComputeShader>(member, variantName, debugName, inOutShader))
        return false;
    return CreateHeapComputePipeline(device, inOutShader, inOutLayout, includeAccelStruct, inOutPipeline);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


