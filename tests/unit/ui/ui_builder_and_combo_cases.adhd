class UiComboBehaviorSource : IListDataSource{
    public TestObserved<u64> generation = TestObserved<u64>(51u);
    public TestObserved<u64> revisionValue = TestObserved<u64>(1u);
    public TestObserved<u64> count = TestObserved<u64>(10u);
    public u64 disabledKey = 0u;
    public b8 reversed = false;
    public b8 badLookup = false;
    public b8 wrongLookup = false;
    public Optional<mut ComboState> m_state;
    public u64 m_selected = 8u;
    public TestObserved<UiComboBehaviorCallbackStage> m_stage = TestObserved<UiComboBehaviorCallbackStage>(UiComboBehaviorCallbackStage::None);
    public UiComboBehaviorCallbackMutation m_mutation = UiComboBehaviorCallbackMutation::Select;

    public UiComboBehaviorSource(){ }
    public UiComboBehaviorSource(mut ComboState state){ this.m_state = Optional<mut ComboState>(state); }
    public u64 instanceGeneration()const override{
        this.mutate(UiComboBehaviorCallbackStage::Generation);
        return this.generation.value();
    }
    public u64 revision()const override{
        this.mutate(UiComboBehaviorCallbackStage::Revision);
        return this.revisionValue.value();
    }
    public u64 rowCount()const override{
        this.mutate(UiComboBehaviorCallbackStage::RowCount);
        return this.count.value();
    }
    public u64 key(in u64 index)const override{
        this.mutate(UiComboBehaviorCallbackStage::Key);
        if(index >= this.count.value())
            return 0u;
        return ArithmeticFixtureRowKey(this.count.value(), 0u, this.reversed, index);
    }
    public Expected<u64> indexOf(in u64 keyValue)const override{
        this.mutate(UiComboBehaviorCallbackStage::Lookup);
        const auto index = FindArithmeticFixtureRowIndex(this.count.value(), 0u, this.reversed, keyValue);
        if(!index.has_value())
            return index;
        if(this.badLookup)
            return this.count.value();
        if(this.wrongLookup)
            return 0u;
        return index.value();
    }
    public Expected<u64> findEnabled(in u64 start, in b8 reverse)const override{
        return FindSingleDisabledFixtureRow(this.count.value(), 0u, false, start, reverse, this.disabledKey);
    }
    public StringView text(in u64 arg0)const override{ return "row"; }
    public b8 enabled(in u64 index)const override{
        this.mutate(UiComboBehaviorCallbackStage::Enabled);
        u64 keyValue = index + 1u;
        if(this.reversed)
            keyValue = this.count.value() - index;
        return index < this.count.value() && keyValue != this.disabledKey;
    }
    public void arm(in UiComboBehaviorCallbackStage stage, in UiComboBehaviorCallbackMutation mutation){ this.arm(stage, mutation, 8u); }
    public void arm(in UiComboBehaviorCallbackStage stage, in UiComboBehaviorCallbackMutation mutation, in u64 selected){
        this.m_stage.value() = stage;
        this.m_mutation = mutation;
        this.m_selected = selected;
    }
    public void mutate(in UiComboBehaviorCallbackStage stage)const{
        if(this.m_stage.value() != stage)
            return;
        this.m_stage.value() = UiComboBehaviorCallbackStage::None;
        switch(this.m_mutation){
        case UiComboBehaviorCallbackMutation::Select:
            if(this.m_state.has_value())
                this.m_state.value().select(this.m_selected);
            break;
        case UiComboBehaviorCallbackMutation::Open:
            if(this.m_state.has_value())
                this.m_state.value().open();
            break;
        case UiComboBehaviorCallbackMutation::Close:
            if(this.m_state.has_value())
                this.m_state.value().close();
            break;
        case UiComboBehaviorCallbackMutation::Generation:
            ++this.generation.value();
            break;
        case UiComboBehaviorCallbackMutation::Revision:
            ++this.revisionValue.value();
            break;
        case UiComboBehaviorCallbackMutation::RowCount:
            if(this.count.value() != 0u)
                --this.count.value();
            break;
        }
    }
}


class UiComboBuilderLabelLookupSource : ComboSource{


    public Expected<u64> indexOf(in u64 key)const override{
        auto found = this.baseIndexOf(key);
        if(found.has_value() && this.lookupCalls.value() >= 3u)
            found.value() = (found.value() + 1u) % this.count;
        return found;
    }
}


b8 UiComboBehaviorNavigate(in UiComboBehaviorSource source, in ControlActionKind kind, mut ComboState state){
    mut ListState preview = state.listState();
    if(!ReconcileListState(preview, source))
        return false;
    ListOptions options;
    options.selectOnNavigate = false;
    ControlAction action;
    action.kind = kind;
    action.control = ControlToken(preview.inputGeneration(), source.instanceGeneration(), source.revision());
    ListResult result;
    return ApplyListControlAction(source, options, action, preview, result);
}

b8 UiComboBehaviorReconcilePreview(mut ComboState state, in IListDataSource source){ return ReconcileListState(state.listState(), source); }
b8 UiComboBehaviorScrollPreviewTo(mut ComboState state, in f64 offset){ return state.listState().scrollTo(offset); }

Sha256Digest ComputeUiBuilderFirstGlyphPageHash(in DrawSnapshot snapshot){ return ComputeSha256(snapshot.glyphPages().front().deref().pixels()); }
u64 ReadUiBuilderFirstGlyphPageFontGeneration(in DrawSnapshot snapshot){ return snapshot.glyphPages().front().deref().binding().fontGeneration; }
b8 EqualUiBuilderVertexBytes(in Span<Vertex> lhs, in Span<Vertex> rhs){
    if(lhs.size() != rhs.size())
        return false;
    const Span<u8> left = PodArrayBytes<Vertex>(lhs);
    const Span<u8> right = PodArrayBytes<Vertex>(rhs);
    for(usize index = 0u; index < left.size(); ++index){
        if(left[index] != right[index])
            return false;
    }
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


UiSkinPalette MakeUiBuilderSkinPalette(in f32 offset){
    UiSkinPalette palette = UiSkinPalette();
    for(u32 index = 0u; index < UiSkinColorRole::kCount; ++index){
        const VectorSingle steps = VectorSingle(cast<f32>(index)) * VectorSingle(0.02f, 0.01f, 0.0f, 0.0f) + VectorSingle(offset, 0.5f, 0.0f, 0.0f);
        const VectorSingle channels = VectorSingle(steps.x) + VectorSingle(0.0f, 0.01f, 0.02f, 0.0f);
        UiSkinColor color = UiSkinColor();
        color.r = steps.x;
        color.g = channels.y;
        color.b = channels.z;
        color.a = steps.y;
        palette.colors[index] = color;
    }
    return palette;
}

void ExpectUiBuilderSkinPaletteColor(in Color actual, in UiSkinColor expected){
    EXPECT_FLOAT_EQ(actual.r, expected.r);
    EXPECT_FLOAT_EQ(actual.g, expected.g);
    EXPECT_FLOAT_EQ(actual.b, expected.b);
    EXPECT_FLOAT_EQ(actual.a, expected.a);
}

u32 CountUiBuilderTextShapingGlyphQuads(in DrawSnapshot snapshot){
    u32 count = 0u;
    for(usize index = 0u; index < snapshot.commands().size(); ++index){
        const DrawCommand command = snapshot.commands()[index];
        if(command.material == PaintMaterial::Glyph || command.material == PaintMaterial::SdfGlyph)
            count += command.indexCount / 6u;
    }
    return count;
}

b8 AcceptUiComboBuilderNeighbors(mut UiComboBuilderTests self, in u64 generation){
    if(!self.begin(generation) || !self.m_builder.beginPanel(s_UiComboBuilderPanelKey, Rect(10.0f, 10.0f, 320.0f, 240.0f)))
        return false;
    if(self.m_builder.button("before", "Before"))
        return false;
    self.m_result = self.m_builder.comboBox(s_UiComboBuilderKey, self.m_source, self.m_state, MakeComboFixtureOptions());
    if(self.m_builder.button("after", "After"))
        return false;
    return self.m_result.valid && self.finishPanel() && self.m_context.commitFrame(generation);
}


