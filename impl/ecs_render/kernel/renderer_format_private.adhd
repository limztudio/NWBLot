[[nodiscard]] FOUNDATION_INLINE usize KernelLogicalOwnershipTransferCount(const KernelGpuCompiledGraphReadView& plan)noexcept{
    return plan.logicalOwnershipTransfers() ? plan.logicalOwnershipTransferCount() : 0u;
}

[[nodiscard]] FOUNDATION_INLINE const KernelGpuCompiledOwnershipTransfer& KernelLogicalOwnershipTransferAt(const KernelGpuCompiledGraphReadView& plan, const usize transferIndex)noexcept{
    return plan.logicalOwnershipTransfers()[transferIndex];
