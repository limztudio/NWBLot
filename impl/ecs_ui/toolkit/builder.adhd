    private b8 declarationBlocked()const{ return this.m_finalizing || this.m_declaring; }

    private b8 panelDeclarationBlocked()const{ return this.declarationBlocked() || !this.m_scope.value().m_panelActive || (this.m_scope.value().m_windowActive && this.m_scope.value().m_window.state.value().collapsed) || this.m_context.failed(); }

    private b8 itemDeclarationBlocked()const{ return this.panelDeclarationBlocked() || this.m_scope.value().m_items.size() >= s_LayoutMaxNodes; }

    private ShapeRequest textShapeRequest(in StringView text, in f32 fontSize)const{
        ShapeRequest request;
        request.text = text;
        request.language = StringView(this.m_textLanguage);
        request.fontSize = fontSize;
        request.scriptTag = this.m_textScriptTag;
        return request;
    }

