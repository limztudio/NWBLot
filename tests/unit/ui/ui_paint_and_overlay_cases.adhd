type UiPaintOverlayTests = PaintTextFixture;
const StringView s_UiPaintOverlayDefaultImagePath = "tests/ui/image";
const StringView s_UiPaintOverlayVersionedImagePath = "tests/ui/versioned_image";
const StringView s_UiPaintOverlaySameImagePath = "tests/ui/same_image";
const StringView s_UiPaintOverlayReplacementImagePath = "tests/ui/replacement";
const u64 s_UiPaintOverlayDefaultAtlasIdentity = 11u;
const Name s_UiPaintOverlayTextureName = "tests/ui/texture";
const Name s_UiPaintOverlayPanelRegionName = "panel";

class UiPaintScopedHeldFenv : NoCopy{
    private Expected<FloatingPointEnvironment> m_held = HoldFloatingPointExceptions();
    public b8 valid()const{ return this.m_held.has_value(); }
    public ~UiPaintScopedHeldFenv(){
        if(this.m_held.has_value() && !SetFloatingPointEnvironment(this.m_held.value()).has_value()){
            assert(false, "Failed to restore floating-point environment");
            TerminateInvariant();
        }
    }
}

class UiPaintSdfAssetFactorySample{
    public SharedSdfAtlasPage page;
    public Sha256Digest sourceHash;
    public b8 valid = false;


}


class UiPaintSdfTests : PaintTextFixture{


    public b8 prepareSingleSdfPage(in SharedSdfAtlasPage page){
        return this.m_builder.prepareSdfPages(Array<SharedSdfAtlasPage, 1u>(page));
    }
    public b8 prepareGlyphSpanAndSingleSdf(in Span<SharedGlyphPage> glyphs, in SharedSdfAtlasPage sdf){
        return this.m_builder.prepareImages(glyphs, Array<SharedSdfAtlasPage, 1u>(sdf));
    }
    public b8 prepareSingleGlyphAndSingleSdf(in SharedGlyphPage glyph, in SharedSdfAtlasPage sdf){
        return this.m_builder.prepareImages(Array<SharedGlyphPage, 1u>(glyph), Array<SharedSdfAtlasPage, 1u>(sdf));
    }
    public UiPaintSdfAssetFactorySample createPageFromTemporaryAtlas(){
        UiPaintSdfAssetFactorySample sample;
        FontAtlas atlas = FontAtlas(Name(s_UiCaseTestsUiFontAtlas));
        FontAtlasPayload payload;
        payload.font = AssetRef<Font>("tests/ui/font");
        payload.fontSha256.bytes[0u] = 99u;
        payload.unitsPerEm = 1000u;
        payload.sourceGlyphCount = 1u;
        payload.ascenderUnits = 800.0f;
        payload.descenderUnits = -200.0f;
        payload.glyphs.push_back(FontAtlasGlyph());
        FontAtlasGroup group;
        group.width = 8u;
        group.height = 8u;
        group.pixels.resize(256u, 0u);
        group.pixels[3u] = 192u;
        group.sha256 = ComputeSha256(group.pixels);
        sample.sourceHash = group.sha256;
        payload.groups.push_back(group);
        atlas.setPayload(payload);
        if(!atlas.validatePayload())
            return sample;
        auto pageResult = CreateSdfAtlasPage(this.pool, atlas, 7u, 123u, 0u);
        if(!pageResult.has_value())
            return sample;
        TestMoveAssign<SharedSdfAtlasPage>(sample.page, pageResult.value());
        sample.valid = sample.page.valid();
        return sample;
    }
    public Expected<SharedSdfAtlasPage> createMovedSdfPage(in SdfAtlasPageBinding binding, mut SdfAtlasPixels pixels){ return CreateSdfAtlasPage(this.pool, binding, pixels); }
}


class UiPaintDrawRegionFenvSample{
    public i32 exceptions = 0;
    public b8 cleared = false;
    public b8 drawn = false;


}


class UiPaintTests{
    public UiSkin m_skin = UiSkin(Name(s_TestSkinPath));
    public PaintBuilder m_builder;

    public UiPaintTests(){
        Vector<UiSkinRegion> regions;
        regions.push_back(UiSkinRegion(Name("sprite"), UiSkinRect(16u, 32u, 32u, 24u), UiSkinSliceInsets(), UiSkinInsets(), 0.0f, 0.0f, UiSkinDrawMode::Sprite));
        regions.push_back(UiSkinRegion(Name("panel"), UiSkinRect(0u, 0u, 32u, 24u), UiSkinSliceInsets(4u, 6u, 8u, 2u), UiSkinInsets(), 0.0f, 0.0f, UiSkinDrawMode::NineSlice));
        this.m_skin.setAtlas(AssetRef<Texture>("tests/ui/texture"), 128u, 64u, 2.0f, regions);
        this.m_builder.begin(DisplayMetrics(200.0f, 100.0f, 1.5f, 2.0f), 7u, 3u, AssetRef<UiSkin>(s_TestSkinPath), this.m_skin);
        this.m_builder.reserve(32u);
    }
    public void configurePanelBorderCase(in UiSkinSliceInsets borders){
        Vector<UiSkinRegion> regions;
        regions.push_back(UiSkinRegion(Name("panel"), UiSkinRect(0u, 0u, 32u, 24u), borders, UiSkinInsets(), 0.0f, 0.0f, UiSkinDrawMode::NineSlice));
        this.m_skin.setAtlas(AssetRef<Texture>("tests/ui/texture"), 128u, 64u, 2.0f, regions);
        this.m_builder.begin(DisplayMetrics(200.0f, 100.0f), 7u, 3u, AssetRef<UiSkin>(s_TestSkinPath), this.m_skin);
    }
    public UiPaintDrawRegionFenvSample drawPanelWithFenvCheck(in Name region, in Rect bounds){
        UiPaintDrawRegionFenvSample sample;
        sample.cleared = ClearFloatingPointExceptions(FE_ALL_EXCEPT).has_value();
        if(!sample.cleared)
            return sample;
        sample.drawn = this.m_builder.drawRegion(region, bounds);
        sample.exceptions = TestFloatingPointExceptions(FE_INVALID | FE_DIVBYZERO | FE_OVERFLOW);
        return sample;
    }
    public void configureReplacementSpriteSkin(){
        Vector<UiSkinRegion> regions;
        regions.push_back(UiSkinRegion(Name("sprite"), UiSkinRect(0u, 0u, 4u, 4u), UiSkinSliceInsets(), UiSkinInsets(), 0.0f, 0.0f, UiSkinDrawMode::Sprite));
        this.m_skin.setAtlas(AssetRef<Texture>("tests/ui/replacement"), 16u, 16u, 1.0f, regions);
        this.m_builder.begin(DisplayMetrics(20.0f, 20.0f), 8u, 4u, AssetRef<UiSkin>(s_TestSkinPath), this.m_skin);
    }
}

b8 UiPaintOverlayPrepareGlyphsAndSingleSdfAndImage(mut PaintBuilder builder, in Span<SharedGlyphPage> glyphs, in SharedSdfAtlasPage sdf, in SharedImageSource image){ return builder.prepareImages(glyphs, Array<SharedSdfAtlasPage, 1u>(sdf), Array<SharedImageSource, 1u>(image)); }
b8 UiPaintOverlayPrepareOneEach(mut PaintBuilder builder, in SharedGlyphPage glyph, in SharedSdfAtlasPage sdf, in SharedImageSource image){ return builder.prepareImages(Array<SharedGlyphPage, 1u>(glyph), Array<SharedSdfAtlasPage, 1u>(sdf), Array<SharedImageSource, 1u>(image)); }
b8 UiPaintOverlayPrepareOneGlyphAndOneImage(mut PaintBuilder builder, in SharedGlyphPage glyph, in SharedImageSource image){ return builder.prepareImages(Array<SharedGlyphPage, 1u>(glyph), Span<SharedSdfAtlasPage>(), Array<SharedImageSource, 1u>(image)); }
b8 UiPaintOverlayPrepareOneGlyphOneSdfAndImageSpan(mut PaintBuilder builder, in SharedGlyphPage glyph, in SharedSdfAtlasPage sdf, in Span<SharedImageSource> images){ return builder.prepareImages(Array<SharedGlyphPage, 1u>(glyph), Array<SharedSdfAtlasPage, 1u>(sdf), images); }
b8 UiPaintOverlayPrepareSingleTextureImage(mut PaintBuilder builder, in SharedImageSource image){ return builder.prepareTextureImages(Array<SharedImageSource, 1u>(image)); }
b8 UiPaintOverlayHasGlyphPage(in SharedGlyphPage page){ return page.valid(); }
usize UiPaintOverlayGlyphPageAddress(in SharedGlyphPage page){
    if(page.valid())
        return TestValueAddress<GlyphPage>(page.deref());
    return 0u;
}
u64 UiPaintOverlayGlyphPageGeneration(in SharedGlyphPage page){ return page.deref().binding().generation; }
u8 UiPaintOverlayGlyphPagePixel(in SharedGlyphPage page, in usize index){ return page.deref().pixels()[index]; }
b8 UiPaintOverlayHasSdfPage(in SharedSdfAtlasPage page){ return page.valid(); }
usize UiPaintOverlaySdfPageAddress(in SharedSdfAtlasPage page){
    if(page.valid())
        return TestValueAddress<SdfAtlasPage>(page.deref());
    return 0u;
}
u8 UiPaintOverlaySdfPagePixel(in SharedSdfAtlasPage page, in usize index){ return page.deref().pixels()[index]; }
Sha256Digest UiPaintOverlaySdfPagePixelsHash(in SharedSdfAtlasPage page){ return page.deref().binding().pixelsSha256; }
u8 UiPaintOverlaySdfPageFontHashByte(in SharedSdfAtlasPage page, in usize index){ return page.deref().binding().fontSha256.bytes[index]; }
SdfAtlasPageBinding UiPaintOverlaySdfPageBinding(in SharedSdfAtlasPage page){ return page.deref().binding(); }
b8 UiPaintOverlayHasImage(in SharedImageSource image){ return image.valid(); }
usize UiPaintOverlayImageAddress(in SharedImageSource image){
    if(image.valid())
        return TestValueAddress<ImageSource>(image.deref());
    return 0u;
}
u64 UiPaintOverlayImageGeneration(in SharedImageSource image){ return image.deref().generation(); }
AssetRef<Texture> UiPaintOverlayImageIdentity(in SharedImageSource image){ return image.deref().identity(); }
u8 UiPaintOverlayImagePayloadByte(in SharedImageSource image, in usize index){ return image.deref().texture().payloadBytes()[index]; }
u32 UiPaintOverlayImageWidth(in SharedImageSource image){ return image.deref().texture().width(); }
u32 UiPaintOverlayImageHeight(in SharedImageSource image){ return image.deref().texture().height(); }
usize UiPaintOverlayImageMipCount(in SharedImageSource image){ return image.deref().texture().mipLevels().size(); }
usize UiPaintOverlayVerticesAddress(in DrawSnapshot snapshot){ return TestDataAddress(snapshot.vertices()); }


