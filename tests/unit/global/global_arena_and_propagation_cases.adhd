void VerifyAllocatorPropagation_OrderedMapSwapsTransferNodesAndTheirArena(){
    Array<b8, 2> flags = Array<b8, 2>();
    flags[0u] = false;
    flags[1u] = true;
    for(in b8 foreignArena : flags){
        const Name firstOwner = s_GlobalArenaCaseAllocatorPropagationOrderedSwapFirst;
        const Name secondOwner = s_GlobalArenaCaseAllocatorPropagationOrderedSwapSecond;
        ArenaMemoryStats firstStats = ArenaMemoryStats();
        ArenaMemoryStats secondStats = ArenaMemoryStats();
        {
            HeapStorage firstArena(firstOwner);
            HeapStorage secondArena(secondOwner);
            mut HeapStorage secondOwnerRef = SelectStorage(foreignArena, firstArena, secondArena);
            {
                OwnerMap first = MakeContainer<OwnerMap>(firstArena);
                OwnerMap second = MakeContainer<OwnerMap>(secondOwnerRef);
                for(u32 key = 0u; key < 16u; ++key)
                    ASSERT_TRUE(InsertEntry(first, key, key * 3u));
                for(u32 key = 100u; key < 132u; ++key)
                    ASSERT_TRUE(InsertEntry(second, key, key * 5u));
                const usize firstNode = TestValueAddress<u32>(MappedValue(first, 0u));
                const usize secondNode = TestValueAddress<u32>(MappedValue(second, 100u));
                first.swap(second);
                EXPECT_TRUE(TestUsesStorage(first, secondOwnerRef));
                EXPECT_TRUE(TestUsesStorage(second, firstArena));
                ASSERT_EQ(first.size(), 32u);
                ASSERT_EQ(second.size(), 16u);
                EXPECT_EQ(TestValueAddress<u32>(MappedValue(first, 100u)), secondNode);
                EXPECT_EQ(TestValueAddress<u32>(MappedValue(second, 0u)), firstNode);
                for(u32 key = 100u; key < 132u; ++key)
                    EXPECT_EQ(first.at(key), key * 5u);
                for(u32 key = 0u; key < 16u; ++key)
                    EXPECT_EQ(second.at(key), key * 3u);
                ASSERT_TRUE(InsertEntry(first, 999u, 7u));
                ASSERT_TRUE(InsertEntry(second, 888u, 9u));
            }
            firstStats = firstArena.memoryStats();
            secondStats = secondArena.memoryStats();
        }
        EXPECT_EQ(firstStats.usedBytes, 0u);
        EXPECT_EQ(secondStats.usedBytes, 0u);
        EXPECT_EQ(firstStats.allocationCount, firstStats.deallocationCount);
        EXPECT_EQ(secondStats.allocationCount, secondStats.deallocationCount);
    }
}

void VerifyAllocatorPropagation_HashMapSwapsAndMovesPreserveArenaAndSourceReuse(){
    Array<b8, 2> flags = Array<b8, 2>();
    flags[0u] = false;
    flags[1u] = true;
    for(in b8 foreignArena : flags){
        const Name firstOwner = s_GlobalArenaCaseAllocatorPropagationHashMapFirst;
        const Name secondOwner = s_GlobalArenaCaseAllocatorPropagationHashMapSecond;
        ArenaMemoryStats firstStats = ArenaMemoryStats();
        ArenaMemoryStats secondStats = ArenaMemoryStats();
        {
            HeapStorage firstArena(firstOwner);
            HeapStorage secondArena(secondOwner);
            mut HeapStorage secondOwnerRef = SelectStorage(foreignArena, firstArena, secondArena);
            {
                OwnerHashMap first = MakeContainer<OwnerHashMap>(firstArena);
                OwnerHashMap second = MakeContainer<OwnerHashMap>(secondOwnerRef);
                for(u32 key = 0u; key < 64u; ++key)
                    ASSERT_TRUE(InsertEntry(first, key, key * 3u));
                for(u32 key = 100u; key < 132u; ++key)
                    ASSERT_TRUE(InsertEntry(second, key, key * 5u));
                const usize firstStorage = TestValueAddress<u32>(first.at(0u));
                const usize secondStorage = TestValueAddress<u32>(second.at(100u));
                first.swap(second);
                EXPECT_TRUE(TestUsesStorage(first, secondOwnerRef));
                EXPECT_TRUE(TestUsesStorage(second, firstArena));
                ASSERT_EQ(first.size(), 32u);
                ASSERT_EQ(second.size(), 64u);
                EXPECT_EQ(TestValueAddress<u32>(first.at(100u)), secondStorage);
                EXPECT_EQ(TestValueAddress<u32>(second.at(0u)), firstStorage);
                TestMoveAssign(first, second);
                EXPECT_TRUE(TestUsesStorage(first, firstArena));
                ASSERT_EQ(first.size(), 64u);
                EXPECT_EQ(TestValueAddress<u32>(first.at(0u)), firstStorage);
                EXPECT_TRUE(second.empty());
                for(u32 key = 0u; key < 64u; ++key)
                    EXPECT_EQ(first.at(key), key * 3u);
                first.reserve(256u);
                ASSERT_TRUE(InsertEntry(first, 999u, 7u));
                second.reserve(64u);
                ASSERT_TRUE(InsertEntry(second, 888u, 9u));
                EXPECT_EQ(second.at(888u), 9u);
                EXPECT_EQ(first.at(999u), 7u);
            }
            firstStats = firstArena.memoryStats();
            secondStats = secondArena.memoryStats();
        }
        EXPECT_EQ(firstStats.usedBytes, 0u);
        EXPECT_EQ(secondStats.usedBytes, 0u);
        EXPECT_EQ(firstStats.allocationCount, firstStats.deallocationCount);
        EXPECT_EQ(secondStats.allocationCount, secondStats.deallocationCount);
    }
}

void VerifyAllocatorPropagation_HashSetSwapsAndMovesPreserveArenaAndSourceReuse(){
    Array<b8, 2> flags = Array<b8, 2>();
    flags[0u] = false;
    flags[1u] = true;
    for(in b8 foreignArena : flags){
        const Name firstOwner = s_GlobalArenaCaseAllocatorPropagationHashSetFirst;
        const Name secondOwner = s_GlobalArenaCaseAllocatorPropagationHashSetSecond;
        ArenaMemoryStats firstStats = ArenaMemoryStats();
        ArenaMemoryStats secondStats = ArenaMemoryStats();
        {
            HeapStorage firstArena(firstOwner);
            HeapStorage secondArena(secondOwner);
            mut HeapStorage secondOwnerRef = SelectStorage(foreignArena, firstArena, secondArena);
            {
                OwnerHashSet first = MakeContainer<OwnerHashSet>(firstArena);
                OwnerHashSet second = MakeContainer<OwnerHashSet>(secondOwnerRef);
                for(u32 key = 0u; key < 64u; ++key)
                    ASSERT_TRUE(InsertKey(first, key));
                for(u32 key = 100u; key < 132u; ++key)
                    ASSERT_TRUE(InsertKey(second, key));
                const usize firstStorage = TestValueAddress<u32>(FoundKey(first, 0u));
                const usize secondStorage = TestValueAddress<u32>(FoundKey(second, 100u));
                first.swap(second);
                EXPECT_TRUE(TestUsesStorage(first, secondOwnerRef));
                EXPECT_TRUE(TestUsesStorage(second, firstArena));
                ASSERT_EQ(first.size(), 32u);
                ASSERT_EQ(second.size(), 64u);
                EXPECT_EQ(TestValueAddress<u32>(FoundKey(first, 100u)), secondStorage);
                EXPECT_EQ(TestValueAddress<u32>(FoundKey(second, 0u)), firstStorage);
                TestMoveAssign(first, second);
                EXPECT_TRUE(TestUsesStorage(first, firstArena));
                ASSERT_EQ(first.size(), 64u);
                EXPECT_EQ(TestValueAddress<u32>(FoundKey(first, 0u)), firstStorage);
                EXPECT_TRUE(second.empty());
                for(u32 key = 0u; key < 64u; ++key)
                    EXPECT_EQ(first.count(key), 1u);
                first.reserve(256u);
                ASSERT_TRUE(InsertKey(first, 999u));
                second.reserve(64u);
                ASSERT_TRUE(InsertKey(second, 888u));
                EXPECT_EQ(second.count(888u), 1u);
                EXPECT_EQ(first.count(999u), 1u);
            }
            firstStats = firstArena.memoryStats();
            secondStats = secondArena.memoryStats();
        }
        EXPECT_EQ(firstStats.usedBytes, 0u);
        EXPECT_EQ(secondStats.usedBytes, 0u);
        EXPECT_EQ(firstStats.allocationCount, firstStats.deallocationCount);
        EXPECT_EQ(secondStats.allocationCount, secondStats.deallocationCount);
    }
}

void VerifyAllocatorPropagation_DefaultProviderAllocatorMovesAwayFromItsInitialOwner(){
    const Name sourceOwner = s_GlobalArenaCaseAllocatorPropagationDefaultSource;
    b8 initialBoundToDefault = false;
    b8 movedBoundToSource = false;
    usize movedSize = 0u;
    u32 movedBack = 0u;
    u64 sourceUsedAfter = 1u;
    u64 defaultBeforeUsed = 0u;
    u64 defaultAfterUsed = 1u;
    {
        HeapStorage sourceArena(sourceOwner);
        const ArenaMemoryStats defaultBefore = PropagationDefault().memoryStats();
        defaultBeforeUsed = defaultBefore.usedBytes;
        {
            DefaultVector target;
            initialBoundToDefault = TestUsesStorage(target, PropagationDefault());
            target.assign(32u, 9u);
            DefaultVector source = MakeContainer<DefaultVector>(sourceArena);
            source.assign(64u, 8u);
            TestMoveAssign(target, source);
            movedBoundToSource = TestUsesStorage(target, sourceArena);
            movedSize = target.size();
            movedBack = target.back();
        }
        sourceUsedAfter = sourceArena.memoryStats().usedBytes;
        defaultAfterUsed = PropagationDefault().memoryStats().usedBytes;
    }
    EXPECT_TRUE(initialBoundToDefault);
    EXPECT_TRUE(movedBoundToSource);
    EXPECT_EQ(movedSize, 64u);
    EXPECT_EQ(movedBack, 8u);
    EXPECT_EQ(sourceUsedAfter, 0u);
    EXPECT_EQ(defaultAfterUsed, defaultBeforeUsed);
}

void VerifyGlobal_AutoRegistrationQueueDeduplicatesAndSnapshots(){
    Vector<u32> values = Vector<u32>();
    values.reserve(6u);
    {
        RegistrationQueue queue(s_TestArena);
        const auto equal = lambda[](in u32 lhs, in u32 rhs) -> b8{ return lhs == rhs; };

        queue.appendUnique(7u, equal);
        queue.appendUnique(7u, equal);
        queue.appendUnique(19u, equal);

        queue.copyTo(values);
        ASSERT_EQ(values.size(), 2u);
        EXPECT_EQ(values[0u], 7u);
        EXPECT_EQ(values[1u], 19u);

        queue.appendUnique(23u, equal);
        EXPECT_EQ(values.size(), 2u);

        queue.copyTo(values);
    }
    ASSERT_EQ(values.size(), 3u);
    EXPECT_EQ(values[2u], 23u);
}

void VerifyGlobal_GenericPathKeepsNativeFilenameCharacters(){
    b8 windowsPlatform = false;
    {
        windowsPlatform = s_IsWindowsPlatform;
    }
    const Path path = Path("one\\two");
    const String rendered = PathToGenericString(path);
    const StringView renderedView = rendered;
    if(windowsPlatform)
        EXPECT_EQ(renderedView, "one/two");
    else
        EXPECT_EQ(renderedView, "one\\two");
}

void VerifyGlobal_BoundedRuntimeWrappersTerminateTruncatedText(){
    i32 strcpyStatus = 0;
    String truncatedCopy = "";
    i32 strcatStatus = 0;
    u8 finalByte = 1u;
    {
        Array<NarrowChar, 4u> truncatedText;
        strcpyStatus = CopyBounded(truncatedText, "abcdef");
        truncatedCopy.assign(FixedBufferView(truncatedText));
        Array<NarrowChar, 4u> unterminated = Array<NarrowChar, 4u>('a', 'b', 'c', 'd');
        strcatStatus = AppendBounded(unterminated, "e");
        finalByte = cast<u8>(unterminated[3u]);
    }

    EXPECT_NE(strcpyStatus, 0);
    const StringView truncatedView = truncatedCopy;
    EXPECT_EQ(truncatedView, "abc");
    EXPECT_NE(strcatStatus, 0);
    EXPECT_EQ(finalByte, 0u);
}

void VerifyGlobal_UnicodeAndAsciiHelpersRejectSurrogatesOverlongsAndInvalidIdentifiers(){
    EXPECT_FALSE(IsUtf16HighSurrogate(0xD7FFu));
    EXPECT_TRUE(IsUtf16HighSurrogate(0xD800u));
    EXPECT_TRUE(IsUtf16HighSurrogate(0xDBFFu));
    EXPECT_FALSE(IsUtf16HighSurrogate(0xDC00u));
    EXPECT_FALSE(IsUtf16LowSurrogate(0xDBFFu));
    EXPECT_TRUE(IsUtf16LowSurrogate(0xDC00u));
    EXPECT_TRUE(IsUtf16LowSurrogate(0xDFFFu));
    EXPECT_FALSE(IsUtf16LowSurrogate(0xE000u));
    EXPECT_TRUE(IsUnicodeScalarValue(0xD7FFu));
    EXPECT_FALSE(IsUnicodeScalarValue(0xD800u));
    EXPECT_FALSE(IsUnicodeScalarValue(0xDFFFu));
    EXPECT_TRUE(IsUnicodeScalarValue(0xE000u));
    EXPECT_TRUE(IsUnicodeScalarValue(s_UnicodeMaxCodePoint));
    EXPECT_FALSE(IsUnicodeScalarValue(s_UnicodeMaxCodePoint + 1u));
    EXPECT_EQ(DecodeUtf16SurrogatePair(0xD800u, 0xDC00u), 0x10000u);
    EXPECT_EQ(DecodeUtf16SurrogatePair(0xDBFFu, 0xDFFFu), s_UnicodeMaxCodePoint);

    const StringView bomPrefixed = StringView("\357\273\277a", 4u);
    EXPECT_TRUE(HasUtf8Bom(bomPrefixed));
    EXPECT_FALSE(HasUtf8Bom(bomPrefixed.substr(0u, 2u)));

    Array<NarrowChar, 4u> encoded;
    EXPECT_FALSE(EncodeFixedUtf8(0xD800u, encoded).has_value());
    EXPECT_FALSE(EncodeFixedUtf8(s_UnicodeMaxCodePoint + 1u, encoded).has_value());
    const Expected<usize> encodedBytes = EncodeFixedUtf8(s_UnicodeMaxCodePoint, encoded);
    ASSERT_TRUE(encodedBytes.has_value());
    ASSERT_EQ(encodedBytes.value(), 4u);

    const StringView maxScalarView = StringView("\xF4\x8F\xBF\xBF", 4u);
    for(usize i = 0u; i < 4u; ++i)
        EXPECT_EQ(cast<u8>(encoded[i]), maxScalarView[i]);
    EXPECT_TRUE(IsUtf8ScalarBoundary(maxScalarView, 0u));
    EXPECT_FALSE(IsUtf8ScalarBoundary(maxScalarView, 1u));
    EXPECT_TRUE(IsUtf8ScalarBoundary(maxScalarView, 4u));
    EXPECT_FALSE(IsUtf8ScalarBoundary(maxScalarView, 5u));

    const Expected<DecodedUtf8CodePoint> decoded = DecodeUtf8Scalar(maxScalarView);
    ASSERT_TRUE(decoded.has_value());
    EXPECT_EQ(decoded.value().codePoint, s_UnicodeMaxCodePoint);
    EXPECT_EQ(decoded.value().byteCount, 4);
    EXPECT_FALSE(DecodeUtf8Scalar(maxScalarView.substr(0u, 3u)).has_value());
    EXPECT_FALSE(DecodeUtf8Scalar(StringView("\xED\xA0\x80", 3u)).has_value());

    EXPECT_TRUE(IsUnicodeWhitespace(0x2000u));
    EXPECT_TRUE(IsUnicodeWhitespace(0x200au));
    EXPECT_FALSE(IsUnicodeWhitespace(0x1fffu));
    EXPECT_FALSE(IsUnicodeWhitespace(0x200bu));
    EXPECT_TRUE(IsUnicodeWhitespace(0xa0u));
    EXPECT_FALSE(IsUnicodeWhitespace(0x180eu));
    EXPECT_TRUE(IsAsciiPunctuation(0x21u));
    EXPECT_TRUE(IsAsciiPunctuation(0x7eu));
    EXPECT_FALSE(IsAsciiPunctuation(0x20u));
    EXPECT_FALSE(IsAsciiPunctuation(0x7fu));
    EXPECT_EQ(StripMatchingTrailingByte("f", 102u, 70u), "f");
    EXPECT_EQ(StripMatchingTrailingByte("4F", 102u, 70u), "4");

    usize tokenCursor = 0u;
    const Expected<StringView> token = ReadCommaOrSpaceDelimitedToken(" , x,,", tokenCursor);
    ASSERT_TRUE(token.has_value());
    EXPECT_EQ(token.value(), "x");
    EXPECT_EQ(tokenCursor, 4u);
    const Expected<StringView> exhaustedToken = ReadCommaOrSpaceDelimitedToken(" , x,,", tokenCursor);
    EXPECT_FALSE(exhaustedToken.has_value());
    EXPECT_EQ(tokenCursor, 6u);

    const Expected<u32> alignedMax = AlignU32PowerOfTwoChecked(u32.max - 3u, 4u);
    ASSERT_TRUE(alignedMax.has_value());
    EXPECT_EQ(alignedMax.value(), u32.max - 3u);
    EXPECT_FALSE(AlignU32PowerOfTwoChecked(u32.max, 4u).has_value());
    EXPECT_FALSE(AlignU32PowerOfTwoChecked(1u, 3u).has_value());

    const Expected<u64> zeroStrideRange = ComputeStridedRangeByteSize(0u, u64.max, u64.max);
    const Expected<u64> twoZeroStrideRange = ComputeStridedRangeByteSize(2u, 0u, u64.max);
    ASSERT_TRUE(zeroStrideRange.has_value());
    ASSERT_TRUE(twoZeroStrideRange.has_value());
    EXPECT_EQ(zeroStrideRange.value(), 0u);
    EXPECT_EQ(twoZeroStrideRange.value(), u64.max);
    EXPECT_FALSE(ComputeStridedRangeByteSize(2u, 1u, u64.max).has_value());
    EXPECT_EQ(MultiplySaturatingU64(u64.max, 0u), 0u);
    EXPECT_EQ(MultiplySaturatingU64(u64.max, 2u), u64.max);
    EXPECT_EQ(SaturateI64ToI32(i64.min), i32.min);
    EXPECT_EQ(SaturateI64ToI32(i64.max), i32.max);
    EXPECT_TRUE(IsRelativeSlashPathWithoutDotSegments("c:segment/file"));
    EXPECT_FALSE(IsRelativeSlashPathWithoutDotSegments("a/../b"));
    EXPECT_FALSE(IsRelativeSlashPathWithoutDotSegments("a//b"));
    EXPECT_FALSE(IsRelativeSlashPathWithoutDotSegments("a\\b"));
    EXPECT_FALSE(FitsFixedText(StringView(), 0u));
    EXPECT_TRUE(FitsFixedText(StringView(), 1u));
    EXPECT_FALSE(FitsFixedText(StringView("a\0b", 3u), 4u));
    EXPECT_FALSE(TryFiniteF32FromF64(bit_cast<f64>(cast<u64>(0x7ff0000000000000u))).has_value());
    EXPECT_FALSE(TryFiniteF32FromF64(cast<f64>(f32.max) * 2.0).has_value());
    const Expected<f32> negZero = ParseFiniteF32ViaF64("-0.0");
    ASSERT_TRUE(negZero.has_value());
    EXPECT_EQ(bit_cast<u32>(negZero.value()), 0x80000000u);
    EXPECT_FALSE(IsAsciiIdentifier(StringView()));
    EXPECT_FALSE(IsAsciiIdentifier(StringView("9abc")));
    EXPECT_FALSE(IsAsciiIdentifier(StringView("a-b")));
    EXPECT_TRUE(IsAsciiIdentifier(StringView("_a9")));
    EXPECT_EQ(ToAsciiLowerByte(0xC3u), 0xC3u);
    EXPECT_NE(ToAsciiLowerByte(cast<u8>(92u)), ToAsciiLowerByte(cast<u8>(47u)));
}

void VerifyGlobal_OwnershipInvariantTerminationIsAlwaysActive(){
    EXPECT_DEATH(TerminateInvariant(), "");
}


