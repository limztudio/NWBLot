void VerifyCpuTaskMpmcTests_OwnerExternalAndWorkerProducersShareQueuesWithoutLosingOrRepeatingTasks(){
    const u32 workerCount = s_MpmcWorkerCount;
    const u32 externalProducerCount = s_MpmcExternalProducerCount;
    const u32 producerCount = s_MpmcProducerCount;
    const u32 tasksPerProducer = s_MpmcTasksPerProducer;
    const u32 expectedWorkerMask = (1u << workerCount) - 1u;
    const usize expectedVisitSlots = cast<usize>(producerCount * tasksPerProducer * 4u);
    const TestSchedulerConfig config = HomogeneousWorkers(workerCount);
    DeadlineGuard deadline(false, s_MpmcWatchdogTimeoutMS);
    ProducerState state = ProducerState();
    CpuTaskScheduler scheduler(config);
    CpuTaskScope scope(scheduler);
    Array<JoiningThread, 4> producers = Array<JoiningThread, 4>();
    ScopeExit stopProducers(lambda[mut state, mut producers, mut scheduler]() -> void{
        state.start.store(true, MemoryOrder::release);
        for(usize index = 0u; index < producers.size(); ++index){
            if(producers[index].joinable()){
                producers[index].join();
            }
        }
        scheduler.drain();
    });

    CpuTaskOptions anyCostOptions = CpuTaskOptions();
    anyCostOptions.cost = CpuTaskCost::Any;
    for(u32 producer = 0u; producer < workerCount; ++producer){
        const auto cpuTaskAdmission = scope.submit(lambda[mut scheduler, mut scope, mut state, in producer]() -> void{
            const usize worker = scheduler.currentWorkerIndex();
            if(worker >= 1u && worker <= cast<usize>(s_MpmcWorkerCount)){
                state.workerMask.fetch_or(1u << cast<u32>(worker - 1u), MemoryOrder::release);
            }
            state.ready.fetch_add(1u, MemoryOrder::release);
            Produce(scheduler, scope, state, 1u + s_MpmcExternalProducerCount + producer);
        }, anyCostOptions);
        EXPECT_TRUE(cpuTaskAdmission.has_value());
        if(cpuTaskAdmission.has_value()){
            EXPECT_TRUE(cpuTaskAdmission.value().valid());
        }
    }
    for(u32 producer = 0u; producer < externalProducerCount; ++producer){
        producers[producer] = JoiningThread(lambda[mut scheduler, mut scope, mut state, in producer]() -> void{
            state.ready.fetch_add(1u, MemoryOrder::release);
            Produce(scheduler, scope, state, 1u + producer);
        });
    }
    const b8 readyReached = WaitUntilCount(state.ready, producerCount - 1u, s_MpmcGateTimeoutMS);
    const u32 observedWorkerMask = state.workerMask.load(MemoryOrder::acquire);
    state.start.store(true, MemoryOrder::release);
    Produce(scheduler, scope, state, 0u);
    for(usize index = 0u; index < producers.size(); ++index){
        producers[index].join();
    }
    scope.wait();
    scheduler.wait();
    stopProducers.release();

    EXPECT_TRUE(readyReached);
    EXPECT_EQ(observedWorkerMask, expectedWorkerMask);
    EXPECT_FALSE(state.expired.load(MemoryOrder::acquire));
    EXPECT_FALSE(state.rejected.load(MemoryOrder::acquire));
    EXPECT_FALSE(state.invalidOrder.load(MemoryOrder::acquire));
    EXPECT_EQ(state.consumedPrefixMask.load(MemoryOrder::acquire), expectedWorkerMask);
    ASSERT_EQ(state.visits.size(), expectedVisitSlots);
    for(usize index = 0u; index < expectedVisitSlots; ++index){
        EXPECT_EQ(state.visits[index].load(MemoryOrder::acquire), 1u);
    }
    const auto stats = scheduler.statistics();
    EXPECT_EQ(stats.completedTasks, cast<u64>(workerCount + producerCount * tasksPerProducer * 4u));
    EXPECT_EQ(stats.outstandingTasks, 0u);
}

void VerifyCpuTaskMpmcTests_ExternalProducersCanWaitForMainThreadTasksWhileTheOwnerPumps(){
    const u32 workerCount = s_MpmcWorkerCount;
    const u32 externalProducerCount = s_MpmcExternalProducerCount;
    const u32 tasksPerProducer = s_MpmcTasksPerProducer;
    u32 joinKinds = 3u;
    const usize expectedVisitSlots = cast<usize>(externalProducerCount * tasksPerProducer);
    const TestSchedulerConfig config = HomogeneousWorkers(workerCount);
    DeadlineGuard deadline(false, s_MpmcWatchdogTimeoutMS);
    const ThreadId owner = QueryCurrentThreadId();
    Atomic<u32> ready(0u);
    Atomic<u32> firstPublished(0u);
    Atomic<u32> finished(0u);
    Atomic<u32> invoked(0u);
    Atomic<b8> start(false);
    Atomic<b8> localExpired(false);
    Atomic<b8> localRejected(false);
    Atomic<b8> localWrongThread(false);
    Array<Atomic<u32>, 512> visits = Array<Atomic<u32>, 512>();
    CpuTaskScheduler scheduler(config);
    CpuTaskScope scope(scheduler);
    Array<JoiningThread, 4> producers = Array<JoiningThread, 4>();
    ScopeExit stopProducers(lambda[mut start, mut scheduler, mut producers]() -> void{
        start.store(true, MemoryOrder::release);
        scheduler.drain();
        for(usize index = 0u; index < producers.size(); ++index){
            if(producers[index].joinable()){
                producers[index].join();
            }
        }
    });

    for(u32 producer = 0u; producer < externalProducerCount; ++producer){
        producers[producer] = JoiningThread(lambda[
            mut finished,
            mut ready,
            mut start,
            mut localExpired,
            mut localRejected,
            mut localWrongThread,
            mut visits,
            mut invoked,
            mut firstPublished,
            mut scheduler,
            mut scope,
            in owner,
            in joinKinds,
            in producer
        ]() -> void{
            ScopeExit finish(lambda[mut finished]() -> void{
                finished.fetch_add(1u, MemoryOrder::release);
            });
            ready.fetch_add(1u, MemoryOrder::release);
            if(!WaitUntil(start, s_MpmcGateTimeoutMS)){
                localExpired.store(true, MemoryOrder::release);
                return;
            }
            CpuTaskOptions options = CpuTaskOptions();
            options.cost = CpuTaskCost::Light;
            options.target = CpuTaskTarget::MainThread;
            for(u32 task = 0u; task < s_MpmcTasksPerProducer; ++task){
                const u32 slot = producer * s_MpmcTasksPerProducer + task;
                auto callback = lambda[in owner, mut scheduler, mut localWrongThread, mut visits, mut invoked, in slot]() -> void{
                    if(QueryCurrentThreadId() != owner || scheduler.currentWorkerIndex() != 0u){
                        localWrongThread.store(true, MemoryOrder::release);
                    }
                    visits[slot].fetch_add(1u, MemoryOrder::relaxed);
                    invoked.fetch_add(1u, MemoryOrder::release);
                };
                const u32 joinKind = task % joinKinds;
                Expected<CpuTaskHandle, CpuTaskAdmissionErrorEnum> cpuTaskAdmission = MakeUnexpected(CpuTaskAdmissionError::Aborting);
                if(task % 2u == 0u || joinKind == 1u){
                    cpuTaskAdmission = scope.submit(callback, options);
                }
                else{
                    cpuTaskAdmission = scheduler.submit(callback, options);
                }
                if(!cpuTaskAdmission.has_value()){
                    localRejected.store(true, MemoryOrder::release);
                    return;
                }
                const CpuTaskHandle handle = cpuTaskAdmission.value();
                if(!handle.valid()){
                    localRejected.store(true, MemoryOrder::release);
                    return;
                }
                if(task == 0u){
                    firstPublished.fetch_add(1u, MemoryOrder::release);
                }
                if(joinKind == 0u){
                    scheduler.wait(handle);
                }
                else if(joinKind == 1u){
                    scope.wait();
                }
                else{
                    scheduler.wait();
                }
            }
        });
    }
    const b8 readyReached = WaitUntilCount(ready, externalProducerCount, s_MpmcGateTimeoutMS);
    start.store(true, MemoryOrder::release);
    const b8 firstPublishedReached = WaitUntilCount(firstPublished, externalProducerCount, s_MpmcGateTimeoutMS);
    const u32 invokedBeforePump = invoked.load(MemoryOrder::acquire);
    const Timer begin = TimerNow();
    while(finished.load(MemoryOrder::acquire) != externalProducerCount){
        if(DurationInMS<u64>(TimerNow(), begin) >= cast<u64>(s_MpmcGateTimeoutMS)){
            localExpired.store(true, MemoryOrder::release);
            scheduler.drain();
            break;
        }
        scheduler.pumpMainThread();
        // Yield lets dependent producers publish the next batch without pacing every handoff to a timer tick.
        YieldThread();
    }
    for(usize index = 0u; index < producers.size(); ++index){
        producers[index].join();
    }
    scope.wait();
    scheduler.wait();
    stopProducers.release();

    EXPECT_TRUE(readyReached);
    EXPECT_TRUE(firstPublishedReached);
    EXPECT_EQ(invokedBeforePump, 0u);
    EXPECT_FALSE(localExpired.load(MemoryOrder::acquire));
    EXPECT_FALSE(localRejected.load(MemoryOrder::acquire));
    EXPECT_FALSE(localWrongThread.load(MemoryOrder::acquire));
    EXPECT_EQ(invoked.load(MemoryOrder::acquire), externalProducerCount * tasksPerProducer);
    ASSERT_EQ(visits.size(), expectedVisitSlots);
    for(usize index = 0u; index < expectedVisitSlots; ++index){
        EXPECT_EQ(visits[index].load(MemoryOrder::acquire), 1u);
    }
    EXPECT_EQ(scheduler.statistics().outstandingTasks, 0u);
}

void VerifyCpuTaskMpmcTests_CanceledCompletionCannotLoseConcurrentHandleScopeOrSchedulerJoins(){
    DeadlineGuard deadline(false, s_MpmcWatchdogTimeoutMS);
    const u32 joinKinds = 3u;
    const u32 rounds = 32u;
    u32 callbacks = 0u;
    CpuTaskOptions mainOptions = CpuTaskOptions();
    mainOptions.target = CpuTaskTarget::MainThread;
    CpuTaskScheduler scheduler(0u);
    for(u32 round = 0u; round < rounds; ++round){
        CpuTaskScope scope(scheduler);
        const auto handleTaskAdmission = scope.submit(lambda[mut callbacks]() -> void{
            ++callbacks;
        }, mainOptions);
        ASSERT_TRUE(handleTaskAdmission.has_value());
        const CpuTaskHandle handle = handleTaskAdmission.value();
        ASSERT_TRUE(handle.valid());
        Atomic<b8> start(false);
        Atomic<b8> expired(false);
        Atomic<u32> entered(0u);
        Atomic<u32> finished(0u);
        Array<JoiningThread, 3> waiters = Array<JoiningThread, 3>();
        ScopeExit finishWaiters(lambda[mut start, mut scope, mut scheduler, mut waiters]() -> void{
            start.store(true, MemoryOrder::release);
            scope.cancel();
            scheduler.pumpMainThread();
            for(usize index = 0u; index < waiters.size(); ++index){
                if(waiters[index].joinable()){
                    waiters[index].join();
                }
            }
        });
        for(u32 kind = 0u; kind < joinKinds; ++kind){
            waiters[kind] = JoiningThread(lambda[mut start, mut expired, mut entered, mut finished, mut scheduler, mut scope, in handle, in kind]() -> void{
                if(!WaitUntil(start, s_MpmcGateTimeoutMS)){
                    expired.store(true, MemoryOrder::release);
                    return;
                }
                entered.fetch_add(1u, MemoryOrder::release);
                if(kind == 0u){
                    scheduler.wait(handle);
                }
                else if(kind == 1u){
                    scope.wait();
                }
                else{
                    scheduler.wait();
                }
                finished.fetch_add(1u, MemoryOrder::release);
            });
        }
        if(round % 2u == 0u){
            start.store(true, MemoryOrder::release);
            ASSERT_TRUE(WaitUntilCount(entered, joinKinds, s_MpmcGateTimeoutMS));
        }
        // Alternate retirement racing wait registration with retirement completed before any join starts.
        scope.cancel();
        scheduler.pumpMainThread();
        start.store(true, MemoryOrder::release);
        for(usize index = 0u; index < waiters.size(); ++index){
            waiters[index].join();
        }
        finishWaiters.release();
        EXPECT_FALSE(expired.load(MemoryOrder::acquire));
        EXPECT_EQ(finished.load(MemoryOrder::acquire), joinKinds);
    }
    EXPECT_EQ(callbacks, 0u);
    EXPECT_EQ(scheduler.statistics().outstandingTasks, 0u);
}


