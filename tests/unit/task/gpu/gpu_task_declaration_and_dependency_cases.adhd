Expected<GpuTaskId> GpuDecl_AddStateTaskFull(
    mut GpuTaskGraph graph,
    in Name identity,
    in GpuTaskResourceUse use,
    in GpuTaskCommandRequirements commands,
    in Span<GpuTaskId> dependencies,
    in b8 mergeWithPrevious,
    in b8 allowPacketMerge
){
    GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
    scheduling.forceSubmissionBoundary = !allowPacketMerge;
    scheduling.allowPacketMerge = allowPacketMerge;
    scheduling.mergeWithPrevious = mergeWithPrevious;
    Array<GpuTaskResourceUse, 1> uses = Array<GpuTaskResourceUse, 1>();
    uses[0u] = use;
    GpuTaskDesc description = GpuTaskDesc();
    description.setIdentity(identity);
    description.setMarkerLabel("Read State Task");
    description.setScheduling(scheduling);
    description.setDependencies(dependencies);
    description.setResourceUses(uses);
    return graph.addTask(description, commands);
}

Expected<GpuTaskId> GpuDecl_AddStateTask(
    mut GpuTaskGraph graph,
    in Name identity,
    in GpuTaskResourceUse use,
    in GpuTaskCommandRequirements commands
){
    const Span<GpuTaskId> emptyDeps = Span<GpuTaskId>();
    return GpuDecl_AddStateTaskFull(graph, identity, use, commands, emptyDeps, false, false);
}

b8 GpuDecl_HasPacketDependency(in GpuDeclCompiledGraphReadView plan, in GpuTaskId consumer, in GpuTaskId producer){
    const GpuSubmissionPacketId producerPacket = plan.packetForTask(producer);
    const GpuCompiledPacketView consumerPacket = plan.packet(plan.packetForTask(consumer));
    if(!producerPacket.valid() || !consumerPacket.valid())
        return false;
    for(in GpuPacketDependency dep : GpuDecl_PacketDependencies(consumerPacket)){
        if(dep.producer == producerPacket)
            return true;
    }
    return false;
}

b8 GpuDecl_HasStateSeed(in GpuDeclCompiledGraphReadView plan, in GpuTaskId consumer, in GpuTaskId producer){
    const GpuSubmissionPacketId producerPacket = plan.packetForTask(producer);
    const GpuCompiledTaskView consumerTask = plan.findTask(consumer);
    if(!producerPacket.valid() || !consumerTask.valid())
        return false;
    for(in GpuPacketStateSeed seed : GpuDecl_PrologueSeeds(consumerTask)){
        if(seed.sourcePacket == producerPacket)
            return true;
    }
    return false;
}

void GpuDecl_CheckSingleLaneStateChangeScratch(mut usize scratchPeak, in usize taskCount, in b8 concurrentSharing){
    const GpuDeclScopedTrace traceCount = GpuDeclScopedTrace(taskCount);
    const GpuDeclScopedTrace traceSharing = GpuDeclScopedTrace(concurrentSharing);
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuDeclResourceSharingMask sharing = ResourceQueueSharing::Exclusive;
    if(concurrentSharing)
        sharing = ResourceQueueSharing::GraphicsAndAsyncCompute;
    const auto resourceResult = AddBufferMetadata(
        graph,
        s_ConcurrentReadStateSingleLaneReadStateResource,
        "Single Lane Read State Resource",
        ResourceStates::Common,
        sharing
    );
    ASSERT_TRUE(resourceResult.has_value());
    const GpuGraphResourceId resource = resourceResult.value();
    ASSERT_TRUE(resource.valid());

    for(usize index = 0u; index < taskCount; ++index){
        const auto identityNameResult = IndexedName(s_ConcurrentReadStateSingleLaneReadState, index);
        ASSERT_TRUE(identityNameResult.has_value());
        GpuTaskResourceUse use = GpuTaskResourceUse();
        use.resource = resource;
        if(index % 2u == 0u)
            use.requiredState = ResourceStates::ShaderResource;
        else
            use.requiredState = ResourceStates::CopySource;
        use.access = GpuTaskResourceAccess::Read;
        const auto gpuTaskAdmission = GpuDecl_AddStateTask(graph, identityNameResult.value(), use, GraphicsCommands());
        ASSERT_TRUE(gpuTaskAdmission.has_value());
        ASSERT_TRUE(gpuTaskAdmission.value().valid());
    }

    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    usize queueCount = 1u;
    if(concurrentSharing)
        queueCount = queues.size();
    const GpuPhysicalQueueTopology topology = GpuDecl_MakeTopology(queues, queueCount);

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ScratchArena scratchArena = ScratchArena(s_TaskGpuScratch);
    const GpuTaskGraphCompiler compiler = GpuTaskGraphCompiler();
    GpuTaskGraphCompileOptions options = GpuTaskGraphCompileOptions();
    options.allowMetadataOnlyTasks = true;
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
    ASSERT_TRUE(compiler.compile(declarations, topology, options, scratchArena, analysis, assignments, compiledGraph));
    scratchPeak = scratchArena.memoryStats().peakUsedBytes;

    const GpuDeclCompiledGraphReadView plan = GpuDeclCompiledGraphReadView(compiledGraph);
    ASSERT_EQ(plan.packetCount(), taskCount);
    for(usize index = 0u; index < taskCount; ++index){
        const GpuCompiledPacketView packet = plan.packet(plan.packetIdAt(index));
        ASSERT_TRUE(packet.valid());
        const Span<GpuPacketDependency> deps = GpuDecl_PacketDependencies(packet);
        usize expectedDeps = 1u;
        if(index == 0u)
            expectedDeps = 0u;
        ASSERT_EQ(deps.size(), expectedDeps);
        if(index != 0u)
            EXPECT_EQ(deps[0u].producer, plan.packetIdAt(index - 1u));
    }
}

void VerifyGpuDecl_KeepsConcurrentReadersIndependentAfterStateEstablishingProducer(){
    Array<GpuDeclResourceTypeEnum, 3> resourceTypes = Array<GpuDeclResourceTypeEnum, 3>();
    resourceTypes[0u] = GpuGraphResourceType::Texture;
    resourceTypes[1u] = GpuGraphResourceType::Buffer;
    resourceTypes[2u] = GpuGraphResourceType::AccelStruct;
    for(in GpuDeclResourceTypeEnum resourceType : resourceTypes){
        TestArena testArena = TestArena();
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        GpuGraphResourceDesc resDesc = GpuGraphResourceDesc();
        resDesc.setIdentity(s_ConcurrentReadStateReadFanoutResource);
        resDesc.setMarkerLabel("Read Fanout Resource");
        resDesc.setType(resourceType);
        resDesc.setInitialState(ResourceStates::Common);
        resDesc.setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute);
        const auto resourceResult = graph.importResource(resDesc);
        ASSERT_TRUE(resourceResult.has_value());
        const GpuGraphResourceId resource = resourceResult.value();
        ASSERT_TRUE(resource.valid());

        const b8 isAccelStruct = resourceType == GpuGraphResourceType::AccelStruct;
        GpuTaskResourceUse use = GpuTaskResourceUse();
        use.resource = resource;
        if(isAccelStruct)
            use.requiredState = ResourceStates::AccelStructWrite;
        else
            use.requiredState = ResourceStates::CopyDest;
        use.access = GpuTaskResourceAccess::Write;
        const auto writerResult = GpuDecl_AddStateTask(graph, s_ConcurrentReadStateReadFanoutWriter, use, GraphicsCommands());
        ASSERT_TRUE(writerResult.has_value());
        const GpuTaskId writer = writerResult.value();

        if(isAccelStruct)
            use.requiredState = ResourceStates::AccelStructRead;
        else
            use.requiredState = ResourceStates::ShaderResource;
        use.access = GpuTaskResourceAccess::Read;
        const auto firstReaderResult = GpuDecl_AddStateTask(graph, s_ConcurrentReadStateReadFanoutFirst, use, GraphicsCommands());
        ASSERT_TRUE(firstReaderResult.has_value());
        const GpuTaskId firstReader = firstReaderResult.value();
        const auto computeReaderResult = GpuDecl_AddStateTask(graph, s_ConcurrentReadStateReadFanoutCompute, use, ComputeCommands());
        ASSERT_TRUE(computeReaderResult.has_value());
        const GpuTaskId computeReader = computeReaderResult.value();
        const auto graphicsReaderResult = GpuDecl_AddStateTask(graph, s_ConcurrentReadStateReadFanoutGraphics, use, GraphicsCommands());
        ASSERT_TRUE(graphicsReaderResult.has_value());
        const GpuTaskId graphicsReader = graphicsReaderResult.value();
        ASSERT_TRUE(writer.valid());
        ASSERT_TRUE(firstReader.valid());
        ASSERT_TRUE(computeReader.valid());
        ASSERT_TRUE(graphicsReader.valid());

        TwoQueueCompile compilation = GpuDecl_MakeTwoQueueCompile(testArena);
        ASSERT_TRUE(compilation.compile(graph));
        const GpuDeclCompiledGraphReadView plan = GpuDeclCompiledGraphReadView(compilation.compiledGraph);
        EXPECT_TRUE(GpuDecl_HasStateSeed(plan, computeReader, firstReader));
        EXPECT_TRUE(GpuDecl_HasStateSeed(plan, graphicsReader, firstReader));
        EXPECT_FALSE(GpuDecl_HasStateSeed(plan, graphicsReader, computeReader));
        EXPECT_FALSE(GpuDecl_HasPacketDependency(plan, graphicsReader, computeReader));
        EXPECT_TRUE(GpuDecl_HasPacketDependency(plan, firstReader, writer));
        EXPECT_TRUE(GpuDecl_HasPacketDependency(plan, computeReader, firstReader));
        EXPECT_TRUE(GpuDecl_HasPacketDependency(plan, graphicsReader, firstReader));
        EXPECT_EQ(plan.logicalOwnershipTransferCount(), 0u);
    }
}

void VerifyGpuDecl_KeepsCompatibleTextureReadMasksIndependentWithoutChangingSemanticStates(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const auto resourceResult = AddTextureMetadata(
        graph,
        s_ConcurrentReadStateCompatibleReadResource,
        "Compatible Read Resource",
        ResourceStates::Common,
        ResourceQueueSharing::GraphicsAndAsyncCompute
    );
    ASSERT_TRUE(resourceResult.has_value());
    const GpuGraphResourceId resource = resourceResult.value();
    ASSERT_TRUE(resource.valid());

    GpuTaskResourceUse use = GpuTaskResourceUse();
    use.resource = resource;
    use.requiredState = ResourceStates::ShaderResource;
    use.access = GpuTaskResourceAccess::Read;
    const auto firstReaderResult = GpuDecl_AddStateTask(graph, s_ConcurrentReadStateCompatibleReadFirst, use, GraphicsCommands());
    ASSERT_TRUE(firstReaderResult.has_value());
    const GpuTaskId firstReader = firstReaderResult.value();
    const auto computeReaderResult = GpuDecl_AddStateTask(graph, s_ConcurrentReadStateCompatibleReadCompute, use, ComputeCommands());
    ASSERT_TRUE(computeReaderResult.has_value());
    const GpuTaskId computeReader = computeReaderResult.value();
    use.requiredState = ResourceStates::DepthRead;
    const auto depthReaderResult = GpuDecl_AddStateTask(graph, s_ConcurrentReadStateCompatibleReadDepth, use, GraphicsCommands());
    ASSERT_TRUE(depthReaderResult.has_value());
    const GpuTaskId depthReader = depthReaderResult.value();
    ASSERT_TRUE(firstReader.valid());
    ASSERT_TRUE(computeReader.valid());
    ASSERT_TRUE(depthReader.valid());

    TwoQueueCompile compilation = GpuDecl_MakeTwoQueueCompile(testArena);
    ASSERT_TRUE(compilation.compile(graph));
    const GpuDeclCompiledGraphReadView plan = GpuDeclCompiledGraphReadView(compilation.compiledGraph);
    EXPECT_TRUE(GpuDecl_HasStateSeed(plan, depthReader, firstReader));
    EXPECT_FALSE(GpuDecl_HasPacketDependency(plan, depthReader, computeReader));
    const GpuCompiledTaskView depthTask = plan.findTask(depthReader);
    ASSERT_TRUE(depthTask.valid());
    b8 hasSemanticTransition = false;
    for(in GpuCompiledBarrier barrier : GpuDecl_PrologueBarriers(depthTask)){
        if(
            barrier.resource == resource
            && barrier.type == GpuCompiledBarrierType::TextureTransition
            && barrier.before == ResourceStates::ShaderResource
            && barrier.after == ResourceStates::DepthRead
        )
            hasSemanticTransition = true;
    }
    EXPECT_TRUE(hasSemanticTransition);
}

void VerifyGpuDecl_JoinsEveryConcurrentReaderBeforeIncompatibleReadStateChange(){
    Array<GpuDeclResourceTypeEnum, 2> resourceTypes = Array<GpuDeclResourceTypeEnum, 2>();
    resourceTypes[0u] = GpuGraphResourceType::Texture;
    resourceTypes[1u] = GpuGraphResourceType::Buffer;
    for(in GpuDeclResourceTypeEnum resourceType : resourceTypes){
        TestArena testArena = TestArena();
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        GpuGraphResourceDesc resDesc = GpuGraphResourceDesc();
        resDesc.setIdentity(s_ConcurrentReadStateReadStateJoinResource);
        resDesc.setMarkerLabel("Read State Join Resource");
        resDesc.setType(resourceType);
        resDesc.setInitialState(ResourceStates::Common);
        resDesc.setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute);
        const auto resourceResult = graph.importResource(resDesc);
        ASSERT_TRUE(resourceResult.has_value());
        const GpuGraphResourceId resource = resourceResult.value();
        ASSERT_TRUE(resource.valid());

        GpuTaskResourceUse use = GpuTaskResourceUse();
        use.resource = resource;
        use.requiredState = ResourceStates::ShaderResource;
        use.access = GpuTaskResourceAccess::Read;
        const auto firstReaderResult = GpuDecl_AddStateTask(graph, s_ConcurrentReadStateReadStateJoinFirst, use, GraphicsCommands());
        ASSERT_TRUE(firstReaderResult.has_value());
        const GpuTaskId firstReader = firstReaderResult.value();
        const auto computeReaderResult = GpuDecl_AddStateTask(graph, s_ConcurrentReadStateReadStateJoinCompute, use, ComputeCommands());
        ASSERT_TRUE(computeReaderResult.has_value());
        const GpuTaskId computeReader = computeReaderResult.value();
        if(resourceType == GpuGraphResourceType::Texture)
            use.requiredState = ResourceStates::DepthRead;
        const auto graphicsReaderResult = GpuDecl_AddStateTask(graph, s_ConcurrentReadStateReadStateJoinGraphics, use, GraphicsCommands());
        ASSERT_TRUE(graphicsReaderResult.has_value());
        const GpuTaskId graphicsReader = graphicsReaderResult.value();
        use.requiredState = ResourceStates::CopySource;
        const auto transitionReaderResult = GpuDecl_AddStateTask(graph, s_ConcurrentReadStateReadStateJoinTransition, use, GraphicsCommands());
        ASSERT_TRUE(transitionReaderResult.has_value());
        const GpuTaskId transitionReader = transitionReaderResult.value();
        ASSERT_TRUE(firstReader.valid());
        ASSERT_TRUE(computeReader.valid());
        ASSERT_TRUE(graphicsReader.valid());
        ASSERT_TRUE(transitionReader.valid());

        TwoQueueCompile compilation = GpuDecl_MakeTwoQueueCompile(testArena);
        ASSERT_TRUE(compilation.compile(graph));
        const GpuDeclCompiledGraphReadView plan = GpuDeclCompiledGraphReadView(compilation.compiledGraph);
        EXPECT_FALSE(GpuDecl_HasPacketDependency(plan, graphicsReader, computeReader));
        EXPECT_TRUE(GpuDecl_HasPacketDependency(plan, transitionReader, computeReader));
        EXPECT_TRUE(GpuDecl_HasPacketDependency(plan, transitionReader, graphicsReader));
        EXPECT_TRUE(GpuDecl_HasStateSeed(plan, transitionReader, graphicsReader));
    }
}

void VerifyGpuDecl_JoinsConcurrentReadersBeforeTaskInternalReadStateChange(){
    Array<GpuDeclResourceTypeEnum, 2> resourceTypes = Array<GpuDeclResourceTypeEnum, 2>();
    resourceTypes[0u] = GpuGraphResourceType::Texture;
    resourceTypes[1u] = GpuGraphResourceType::Buffer;
    Array<b8, 2> overlapModes = Array<b8, 2>();
    overlapModes[0u] = false;
    overlapModes[1u] = true;
    for(in GpuDeclResourceTypeEnum resourceType : resourceTypes){
        for(in b8 overlappingLaterUse : overlapModes){
            const GpuDeclScopedTrace traceType = GpuDeclScopedTrace(resourceType);
            const GpuDeclScopedTrace traceOverlap = GpuDeclScopedTrace(overlappingLaterUse);
            TestArena testArena = TestArena();
            GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
            GpuGraphResourceDesc resDesc = GpuGraphResourceDesc();
            resDesc.setIdentity(s_ConcurrentReadStateInternalReadStateResource);
            resDesc.setMarkerLabel("Internal Read State Resource");
            resDesc.setType(resourceType);
            resDesc.setInitialState(ResourceStates::Common);
            resDesc.setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute);
            const auto resourceResult = graph.importResource(resDesc);
            ASSERT_TRUE(resourceResult.has_value());
            const GpuGraphResourceId resource = resourceResult.value();
            ASSERT_TRUE(resource.valid());

            GpuTaskResourceUse use = GpuTaskResourceUse();
            use.resource = resource;
            use.requiredState = ResourceStates::ShaderResource;
            use.access = GpuTaskResourceAccess::Read;
            if(resourceType == GpuGraphResourceType::Texture){
                u32 mips = 1u;
                if(overlappingLaterUse)
                    mips = 2u;
                use.range.textureSubresources = TextureSubresourceSet(0u, mips, 0u, 1u);
            }
            else{
                u64 byteSize = 64u;
                if(overlappingLaterUse)
                    byteSize = 128u;
                use.range.bufferRange = BufferRange(0u, byteSize);
            }
            const auto firstReaderResult = GpuDecl_AddStateTask(graph, s_ConcurrentReadStateInternalReadStateFirst, use, GraphicsCommands());
            ASSERT_TRUE(firstReaderResult.has_value());
            const GpuTaskId firstReader = firstReaderResult.value();
            const auto computeReaderResult = GpuDecl_AddStateTask(graph, s_ConcurrentReadStateInternalReadStateCompute, use, ComputeCommands());
            ASSERT_TRUE(computeReaderResult.has_value());
            const GpuTaskId computeReader = computeReaderResult.value();
            const auto graphicsReaderResult = GpuDecl_AddStateTask(graph, s_ConcurrentReadStateInternalReadStateGraphics, use, GraphicsCommands());
            ASSERT_TRUE(graphicsReaderResult.has_value());
            const GpuTaskId graphicsReader = graphicsReaderResult.value();

            Array<GpuTaskResourceUse, 2> internalUses = Array<GpuTaskResourceUse, 2>();
            internalUses[0u] = use;
            internalUses[1u] = use;
            internalUses[1u].requiredState = ResourceStates::CopySource;
            if(resourceType == GpuGraphResourceType::Texture)
                internalUses[1u].range.textureSubresources = TextureSubresourceSet(1u, 1u, 0u, 1u);
            else
                internalUses[1u].range.bufferRange = BufferRange(64u, 64u);
            GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
            scheduling.forceSubmissionBoundary = true;
            scheduling.allowPacketMerge = false;
            GpuTaskDesc description = GpuTaskDesc();
            description.setIdentity(s_ConcurrentReadStateInternalReadStateTransition);
            description.setMarkerLabel("Internal Read State Transition");
            description.setScheduling(scheduling);
            description.setResourceUses(internalUses);
            const auto transitionReaderResult = graph.addTask(description, GraphicsCommands());
            ASSERT_TRUE(transitionReaderResult.has_value());
            const GpuTaskId transitionReader = transitionReaderResult.value();
            ASSERT_TRUE(firstReader.valid());
            ASSERT_TRUE(computeReader.valid());
            ASSERT_TRUE(graphicsReader.valid());
            ASSERT_TRUE(transitionReader.valid());

            TwoQueueCompile compilation = GpuDecl_MakeTwoQueueCompile(testArena);
            ASSERT_TRUE(compilation.compile(graph));
            const GpuDeclCompiledGraphReadView plan = GpuDeclCompiledGraphReadView(compilation.compiledGraph);
            ASSERT_FALSE(GpuDecl_HasPacketDependency(plan, graphicsReader, computeReader));
            EXPECT_EQ(GpuDecl_HasPacketDependency(plan, transitionReader, computeReader), overlappingLaterUse);
            if(overlappingLaterUse){
                EXPECT_TRUE(GpuDecl_HasStateSeed(plan, transitionReader, graphicsReader));
                EXPECT_TRUE(GpuDecl_HasPacketDependency(plan, transitionReader, graphicsReader));
            }
            else{
                EXPECT_TRUE(GpuDecl_HasStateSeed(plan, transitionReader, firstReader));
            }
        }
    }
}

void VerifyGpuDecl_PreservesReaderJoinAcrossPartialTaskInternalStateEpoch(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const auto resourceResult = AddBufferMetadata(
        graph,
        s_ConcurrentReadStatePartialReadEpochResource,
        "Partial Read Epoch Resource",
        ResourceStates::Common,
        ResourceQueueSharing::GraphicsAndAsyncCompute
    );
    ASSERT_TRUE(resourceResult.has_value());
    const GpuGraphResourceId resource = resourceResult.value();
    ASSERT_TRUE(resource.valid());

    GpuTaskResourceUse use = GpuTaskResourceUse();
    use.resource = resource;
    use.range.bufferRange = BufferRange(0u, 64u);
    use.requiredState = ResourceStates::ShaderResource;
    use.access = GpuTaskResourceAccess::Read;
    const auto firstReaderResult = GpuDecl_AddStateTask(graph, s_ConcurrentReadStatePartialReadEpochFirst, use, GraphicsCommands());
    ASSERT_TRUE(firstReaderResult.has_value());
    const GpuTaskId firstReader = firstReaderResult.value();
    const auto computeReaderResult = GpuDecl_AddStateTask(graph, s_ConcurrentReadStatePartialReadEpochCompute, use, ComputeCommands());
    ASSERT_TRUE(computeReaderResult.has_value());
    const GpuTaskId computeReader = computeReaderResult.value();

    use.range.bufferRange = BufferRange(64u, 64u);
    Array<GpuTaskResourceUse, 3> internalUses = Array<GpuTaskResourceUse, 3>();
    internalUses[0u] = use;
    internalUses[1u] = use;
    internalUses[1u].requiredState = ResourceStates::CopySource;
    internalUses[2u] = use;
    GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
    scheduling.forceSubmissionBoundary = true;
    scheduling.allowPacketMerge = false;
    GpuTaskDesc description = GpuTaskDesc();
    description.setIdentity(s_ConcurrentReadStatePartialReadEpochInternal);
    description.setMarkerLabel("Partial Read Epoch Internal");
    description.setScheduling(scheduling);
    description.setResourceUses(internalUses);
    const auto internalReaderResult = graph.addTask(description, GraphicsCommands());
    ASSERT_TRUE(internalReaderResult.has_value());
    const GpuTaskId internalReader = internalReaderResult.value();

    use.range.bufferRange = BufferRange(0u, 128u);
    const auto spanningReaderResult = GpuDecl_AddStateTask(graph, s_ConcurrentReadStatePartialReadEpochSpanning, use, GraphicsCommands());
    ASSERT_TRUE(spanningReaderResult.has_value());
    const GpuTaskId spanningReader = spanningReaderResult.value();
    use.requiredState = ResourceStates::CopySource;
    const auto transitionReaderResult = GpuDecl_AddStateTask(graph, s_ConcurrentReadStatePartialReadEpochTransition, use, GraphicsCommands());
    ASSERT_TRUE(transitionReaderResult.has_value());
    const GpuTaskId transitionReader = transitionReaderResult.value();
    ASSERT_TRUE(firstReader.valid());
    ASSERT_TRUE(computeReader.valid());
    ASSERT_TRUE(internalReader.valid());
    ASSERT_TRUE(spanningReader.valid());
    ASSERT_TRUE(transitionReader.valid());

    TwoQueueCompile compilation = GpuDecl_MakeTwoQueueCompile(testArena);
    ASSERT_TRUE(compilation.compile(graph));
    const GpuDeclCompiledGraphReadView plan = GpuDeclCompiledGraphReadView(compilation.compiledGraph);
    ASSERT_FALSE(GpuDecl_HasPacketDependency(plan, internalReader, computeReader));
    ASSERT_FALSE(GpuDecl_HasPacketDependency(plan, spanningReader, computeReader));
    // The second-half task's internal transition does not dominate the independent first-half Compute reader.
    EXPECT_TRUE(GpuDecl_HasPacketDependency(plan, transitionReader, computeReader));
    EXPECT_TRUE(GpuDecl_HasPacketDependency(plan, transitionReader, spanningReader));
}

void VerifyGpuDecl_PreservesExplicitDependencyWhenConcurrentReaderUsesEarlierStateSource(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const auto resourceResult = AddBufferMetadata(
        graph,
        s_ConcurrentReadStateReadExplicitDependencyResource,
        "Read Explicit Dependency Resource",
        ResourceStates::Common,
        ResourceQueueSharing::GraphicsAndAsyncCompute
    );
    ASSERT_TRUE(resourceResult.has_value());
    const GpuGraphResourceId resource = resourceResult.value();
    ASSERT_TRUE(resource.valid());

    GpuTaskResourceUse use = GpuTaskResourceUse();
    use.resource = resource;
    use.requiredState = ResourceStates::ConstantBuffer;
    use.access = GpuTaskResourceAccess::Read;
    const auto firstReaderResult = GpuDecl_AddStateTask(graph, s_ConcurrentReadStateReadExplicitDependencyFirst, use, GraphicsCommands());
    ASSERT_TRUE(firstReaderResult.has_value());
    const GpuTaskId firstReader = firstReaderResult.value();
    const auto computeReaderResult = GpuDecl_AddStateTask(graph, s_ConcurrentReadStateReadExplicitDependencyCompute, use, ComputeCommands());
    ASSERT_TRUE(computeReaderResult.has_value());
    const GpuTaskId computeReader = computeReaderResult.value();

    Array<GpuTaskId, 1> computeDeps = Array<GpuTaskId, 1>();
    computeDeps[0u] = computeReader;
    const auto graphicsReaderResult = GpuDecl_AddStateTaskFull(
        graph,
        s_ConcurrentReadStateReadExplicitDependencyGraphics,
        use,
        GraphicsCommands(),
        computeDeps,
        false,
        false
    );
    ASSERT_TRUE(graphicsReaderResult.has_value());
    const GpuTaskId graphicsReader = graphicsReaderResult.value();
    ASSERT_TRUE(firstReader.valid());
    ASSERT_TRUE(computeReader.valid());
    ASSERT_TRUE(graphicsReader.valid());

    TwoQueueCompile compilation = GpuDecl_MakeTwoQueueCompile(testArena);
    ASSERT_TRUE(compilation.compile(graph));
    const GpuDeclCompiledGraphReadView plan = GpuDeclCompiledGraphReadView(compilation.compiledGraph);
    EXPECT_TRUE(GpuDecl_HasStateSeed(plan, graphicsReader, firstReader));
    EXPECT_FALSE(GpuDecl_HasStateSeed(plan, graphicsReader, computeReader));
    EXPECT_TRUE(GpuDecl_HasPacketDependency(plan, graphicsReader, computeReader));
}

void VerifyGpuDecl_KeepsPartialReadOrderingWhenSourcePacketChangesAdjacentRange(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const auto resourceResult = AddBufferMetadata(
        graph,
        s_ConcurrentReadStateReadPacketTailResource,
        "Read Packet Tail Resource",
        ResourceStates::Common,
        ResourceQueueSharing::GraphicsAndAsyncCompute
    );
    ASSERT_TRUE(resourceResult.has_value());
    const GpuGraphResourceId resource = resourceResult.value();
    ASSERT_TRUE(resource.valid());

    const Span<GpuTaskId> emptyDeps = Span<GpuTaskId>();
    GpuTaskResourceUse use = GpuTaskResourceUse();
    use.resource = resource;
    use.range.bufferRange = BufferRange(0u, 128u);
    use.requiredState = ResourceStates::ShaderResource;
    use.access = GpuTaskResourceAccess::Read;
    const auto firstReaderResult = GpuDecl_AddStateTaskFull(
        graph,
        s_ConcurrentReadStateReadPacketTailFirst,
        use,
        GraphicsCommands(),
        emptyDeps,
        false,
        true
    );
    ASSERT_TRUE(firstReaderResult.has_value());
    const GpuTaskId firstReader = firstReaderResult.value();

    use.range.bufferRange = BufferRange(64u, 64u);
    use.requiredState = ResourceStates::CopySource;
    Array<GpuTaskId, 1> firstDeps = Array<GpuTaskId, 1>();
    firstDeps[0u] = firstReader;
    const auto packetTailResult = GpuDecl_AddStateTaskFull(
        graph,
        s_ConcurrentReadStateReadPacketTailChangedRange,
        use,
        GraphicsCommands(),
        firstDeps,
        true,
        true
    );
    ASSERT_TRUE(packetTailResult.has_value());
    const GpuTaskId packetTail = packetTailResult.value();

    use.range.bufferRange = BufferRange(0u, 64u);
    use.requiredState = ResourceStates::ShaderResource;
    const auto computeReaderResult = GpuDecl_AddStateTask(graph, s_ConcurrentReadStateReadPacketTailCompute, use, ComputeCommands());
    ASSERT_TRUE(computeReaderResult.has_value());
    const GpuTaskId computeReader = computeReaderResult.value();
    const auto graphicsReaderResult = GpuDecl_AddStateTask(graph, s_ConcurrentReadStateReadPacketTailGraphics, use, GraphicsCommands());
    ASSERT_TRUE(graphicsReaderResult.has_value());
    const GpuTaskId graphicsReader = graphicsReaderResult.value();
    ASSERT_TRUE(firstReader.valid());
    ASSERT_TRUE(packetTail.valid());
    ASSERT_TRUE(computeReader.valid());
    ASSERT_TRUE(graphicsReader.valid());

    TwoQueueCompile compilation = GpuDecl_MakeTwoQueueCompile(testArena);
    ASSERT_TRUE(compilation.compile(graph));
    const GpuDeclCompiledGraphReadView plan = GpuDeclCompiledGraphReadView(compilation.compiledGraph);
    ASSERT_TRUE(plan.tasksSharePacket(firstReader, packetTail));
    EXPECT_TRUE(GpuDecl_HasStateSeed(plan, graphicsReader, computeReader));
    EXPECT_FALSE(GpuDecl_HasStateSeed(plan, graphicsReader, firstReader));
    EXPECT_TRUE(GpuDecl_HasPacketDependency(plan, graphicsReader, computeReader));
}

void VerifyGpuDecl_KeepsSingleLaneAlternatingReadStateScratchGrowthLinear(){
    usize smallScratchPeak = 0u;
    usize largeScratchPeak = 0u;
    GpuDecl_CheckSingleLaneStateChangeScratch(smallScratchPeak, 128u, false);
    ASSERT_FALSE(GpuDecl_HasFatalFailure());
    GpuDecl_CheckSingleLaneStateChangeScratch(largeScratchPeak, 512u, false);
    ASSERT_FALSE(GpuDecl_HasFatalFailure());
    ASSERT_NE(smallScratchPeak, 0u);
    ASSERT_NE(largeScratchPeak, 0u);
    RecordUnsignedTestProperty("small_read_state_scratch_peak_bytes", cast<u64>(smallScratchPeak));
    RecordUnsignedTestProperty("large_read_state_scratch_peak_bytes", cast<u64>(largeScratchPeak));
    // Four times as many serial readers must not produce all historical reader pairs or a dense packet closure.
    EXPECT_LE(largeScratchPeak, smallScratchPeak * 6u);
}

void VerifyGpuDecl_KeepsConcurrentSingleLaneAlternatingReadStateScratchGrowthLinear(){
    usize smallScratchPeak = 0u;
    usize largeScratchPeak = 0u;
    GpuDecl_CheckSingleLaneStateChangeScratch(smallScratchPeak, 128u, true);
    ASSERT_FALSE(GpuDecl_HasFatalFailure());
    GpuDecl_CheckSingleLaneStateChangeScratch(largeScratchPeak, 512u, true);
    ASSERT_FALSE(GpuDecl_HasFatalFailure());
    ASSERT_NE(smallScratchPeak, 0u);
    ASSERT_NE(largeScratchPeak, 0u);
    RecordUnsignedTestProperty("small_concurrent_read_state_scratch_peak_bytes", cast<u64>(smallScratchPeak));
    RecordUnsignedTestProperty("large_concurrent_read_state_scratch_peak_bytes", cast<u64>(largeScratchPeak));
    EXPECT_LE(largeScratchPeak, smallScratchPeak * 6u);
}

void VerifyGpuDecl_CopiesCallerMetadataAndDestroysTypedPayloadOnReset(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const auto resourceResult = AddHazardDomain(graph, s_DeclarationCaseResource, "Resource");
    ASSERT_TRUE(resourceResult.has_value());
    const GpuGraphResourceId resource = resourceResult.value();
    ASSERT_TRUE(resource.valid());

    const auto predecessorResult = GpuDecl_AddEmptyTask(s_DeclarationCasePredecessor, "Predecessor", graph);
    ASSERT_TRUE(predecessorResult.has_value());
    const GpuTaskId predecessor = predecessorResult.value();
    ASSERT_TRUE(predecessor.valid());

    u32 destructionCount = 0u;
    Expected<GpuTaskId> taskResult = MakeUnexpected(Failure());
    native(mut graph, in predecessor, in resource, mut destructionCount, mut taskResult){
        Array<Core::GpuTaskId, 1> dependencies = { predecessor };
        Array<Core::GpuTaskResourceUse, 1> uses = {
            Core::GpuTaskResourceUse{
                .resource = resource,
                .range = {},
                .requiredState = Core::ResourceStates::ShaderResource,
                .access = Core::GpuTaskResourceAccess::Read,
            },
        };
        Array<char, 13u> markerLabel = { 'S', 't', 'a', 'c', 'k', ' ', 'M', 'a', 'r', 'k', 'e', 'r', '\0' };
        Core::GpuTaskDesc desc;
        desc.setIdentity(s_DeclarationCasePayload).setMarkerLabel(AStringView(markerLabel.data())).setDependencies(dependencies).setResourceUses(uses);
        PayloadDestroyTask::Payload payload(&destructionCount);
        taskResult = graph.addTask<PayloadDestroyTask>(desc, Move(payload));
        dependencies[0] = {};
        uses[0].resource = {};
        markerLabel[0] = 'X';
    }
    ASSERT_TRUE(taskResult.has_value());
    const GpuTaskId task = taskResult.value();
    ASSERT_TRUE(task.valid());

    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        native(in declarations, in task, in predecessor, in resource){
            const Core::GpuTaskGraphTaskView stored = declarations.taskAt(task.index);
            ASSERT_EQ(stored.dependencyCount, 1u);
            ASSERT_EQ(stored.resourceUseCount, 1u);
            EXPECT_EQ(stored.dependencies[0], predecessor);
            EXPECT_EQ(stored.resourceUses[0].resource, resource);
            EXPECT_EQ(stored.markerLabel, AStringView("Stack Marker"));
        }
    }

    graph.reset();
    EXPECT_EQ(destructionCount, 1u);
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        EXPECT_FALSE(declarations.validTask(task));
        EXPECT_FALSE(declarations.validResource(resource));
    }
}

void VerifyGpuDecl_RejectsInvalidExternalStateSourceWithoutDeclarationMutation(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    CommandListResourceStateHandoff externalStateSource = CommandListResourceStateHandoff(testArena.arena);
    ASSERT_FALSE(externalStateSource.valid());
    b8 rejected = false;
    native(mut graph, in externalStateSource, mut rejected){
        const Array<Core::GpuTaskExternalStateSource, 1> externalStateSources = {
            Core::GpuTaskExternalStateSource{
                .states = &externalStateSource,
                .applicableConsumerQueueClass = Core::CommandQueue::Compute,
            },
        };
        Core::GpuTaskDesc desc;
        desc.setIdentity(s_DeclarationCaseInvalidExternalStateSource).setMarkerLabel("Invalid External State Source").setExternalStateSources(externalStateSources);
        rejected = !graph.addTask(desc).has_value();
    }
    EXPECT_TRUE(rejected);
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
    EXPECT_EQ(declarations.taskCount(), 0u);
}

void VerifyGpuDecl_RejectsReentrantCompilerReadDuringDeclarationMutation(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ScratchArena scratchArena = ScratchArena(s_TaskGpuScratch);
    b8 compileAttempted = false;
    b8 compileSucceeded = true;

    Expected<GpuTaskId> taskResult = MakeUnexpected(Failure());
    native(mut graph, mut analysis, mut scratchArena, mut compileAttempted, mut compileSucceeded, mut taskResult){
        ReentrantCompileDuringDeclarationTask::Payload payload;
        payload.graph = &graph;
        payload.analysis = &analysis;
        payload.scratchArena = &scratchArena;
        payload.compileAttempted = &compileAttempted;
        payload.compileSucceeded = &compileSucceeded;

        Core::GpuTaskDesc desc;
        desc.setIdentity(s_DeclarationCaseReentrantCompileDuringDeclaration).setMarkerLabel("Reentrant Compile During Declaration");
        taskResult = graph.addTask<ReentrantCompileDuringDeclarationTask>(desc, Move(payload));
    }
    ASSERT_TRUE(taskResult.has_value());
    const GpuTaskId task = taskResult.value();

    ASSERT_TRUE(task.valid());
    EXPECT_TRUE(compileAttempted);
    EXPECT_FALSE(compileSucceeded);
    EXPECT_FALSE(analysis.valid());
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        EXPECT_EQ(declarations.taskCount(), 1u);
    }
    EXPECT_TRUE(Analyze(graph, scratchArena, analysis));
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
    EXPECT_TRUE(analysis.validFor(declarations));
}

void VerifyGpuDecl_RejectsReentrantTelemetryReadsDuringDeclarationMutationWithoutChangingOutputs(){
    ScratchArena scratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const auto existingTaskResult = GpuDecl_AddEmptyTask(s_DeclarationCaseReentrantTelemetryExisting, "Reentrant Telemetry Existing", graph);
    ASSERT_TRUE(existingTaskResult.has_value());
    const GpuTaskId existingTask = existingTaskResult.value();
    ASSERT_TRUE(existingTask.valid());

    Array<GpuPhysicalQueueInfo, 1> queues = Array<GpuPhysicalQueueInfo, 1>();
    queues[0u] = GraphicsQueue();
    const GpuPhysicalQueueTopology topology = GpuDecl_MakeTopology(queues, 1u);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(Compile(analysis, assignments, compiledGraph, scratchArena, graph, topology));
    GpuGraphSubmissionTransaction transaction = GpuGraphSubmissionTransaction(testArena.arena);
    transaction.reset(compiledGraph);

    GpuTaskGraphQueueAssignmentTelemetryTracker tracker = GpuTaskGraphQueueAssignmentTelemetryTracker(testArena.arena);
    GpuTaskQueueAssignmentTelemetry savedTelemetry = GpuTaskQueueAssignmentTelemetry();

    GpuDeclNodeDescs nodes = GpuDeclNodeDescs(testArena.arena);
    GpuDeclEdgeDescs edges = GpuDeclEdgeDescs(testArena.arena);
    GpuDeclPendingEdges pendingEdges = GpuDeclPendingEdges(testArena.arena);
    GpuDeclFrameGraphBuilder builder = GpuDecl_MakeFrameGraphBuilder(scratchArena, nodes, edges, pendingEdges);
    {
        const GpuDeclReadViews reads = GpuDeclReadViews(graph, compiledGraph);
        ASSERT_TRUE(reads.valid());
        ASSERT_TRUE(tracker.update(reads.declarations, assignments, reads.compiled, transaction, scratchArena));
        ASSERT_TRUE(tracker.validFor(reads.declarations, assignments, reads.compiled));
        b8 hasInitial = false;
        b8 appendedInitial = false;
        native(in reads, in analysis, in assignments, in existingTask, mut scratchArena, mut tracker, mut builder, mut savedTelemetry, mut hasInitial, mut appendedInitial){
            if(const Core::GpuTaskQueueAssignmentTelemetry* const initialTelemetry = tracker.find(existingTask)){
                hasInitial = true;
                savedTelemetry = *initialTelemetry;
            }
            const Core::GpuTaskGraphTelemetryOptions options{
                .queueAssignments = &assignments,
                .compiledPlan = &reads.compiled,
                .queueAssignmentTelemetry = &tracker,
            };
            appendedInitial = reads.declarations.appendFrameGraphTelemetry(analysis, scratchArena, builder, options);
        }
        ASSERT_TRUE(hasInitial);
        ASSERT_TRUE(appendedInitial);
    }
    const usize nodeCount = nodes.size();
    const usize edgeCount = edges.size();
    const usize pendingEdgeCount = pendingEdges.size();

    ReentrantTelemetryDuringDeclarationState state = ReentrantTelemetryDuringDeclarationState();
    Expected<GpuTaskId> probeTaskResult = MakeUnexpected(Failure());
    native(mut graph, in analysis, in assignments, in compiledGraph, in transaction, mut tracker, mut builder, mut scratchArena, mut state, mut probeTaskResult){
        state.graph = &graph;
        state.analysis = &analysis;
        state.assignments = &assignments;
        state.compiledGraph = &compiledGraph;
        state.transaction = &transaction;
        state.tracker = &tracker;
        state.builder = &builder;
        state.scratchArena = &scratchArena;
        probeTaskResult = graph.addTask<ReentrantTelemetryDuringDeclarationTask>(
            Core::GpuTaskDesc{}
                .setIdentity(s_DeclarationCaseReentrantTelemetryDuringDeclaration)
                .setMarkerLabel("Reentrant Telemetry During Declaration"),
            ReentrantTelemetryDuringDeclarationTask::Payload(state)
        );
    }
    ASSERT_TRUE(probeTaskResult.has_value());
    const GpuTaskId probeTask = probeTaskResult.value();

    ASSERT_TRUE(probeTask.valid());
    EXPECT_TRUE(state.trackerValidationAttempted);
    EXPECT_FALSE(state.trackerValidationSucceeded);
    EXPECT_TRUE(state.trackerUpdateAttempted);
    EXPECT_FALSE(state.trackerUpdateSucceeded);
    EXPECT_TRUE(state.appendAttempted);
    EXPECT_FALSE(state.appendSucceeded);
    EXPECT_EQ(nodes.size(), nodeCount);
    EXPECT_EQ(edges.size(), edgeCount);
    EXPECT_EQ(pendingEdges.size(), pendingEdgeCount);

    Optional<GpuTaskQueueAssignmentTelemetry> retainedTelemetry = Optional<GpuTaskQueueAssignmentTelemetry>();
    native(in tracker, in existingTask, mut retainedTelemetry){
        if(const Core::GpuTaskQueueAssignmentTelemetry* const found = tracker.find(existingTask))
            retainedTelemetry = *found;
    }
    ASSERT_TRUE(retainedTelemetry.has_value());
    EXPECT_EQ(retainedTelemetry.value().assignment.task, savedTelemetry.assignment.task);
    EXPECT_EQ(retainedTelemetry.value().assignment.queue, savedTelemetry.assignment.queue);
    EXPECT_EQ(retainedTelemetry.value().assignment.reason, savedTelemetry.assignment.reason);
    EXPECT_EQ(retainedTelemetry.value().assignment.modifiers, savedTelemetry.assignment.modifiers);
    EXPECT_EQ(retainedTelemetry.value().acceptedQueue, savedTelemetry.acceptedQueue);
    EXPECT_EQ(retainedTelemetry.value().previousAcceptedQueue, savedTelemetry.previousAcceptedQueue);
    EXPECT_EQ(retainedTelemetry.value().acceptance, savedTelemetry.acceptance);

    ASSERT_TRUE(Compile(analysis, assignments, compiledGraph, scratchArena, graph, topology));
    transaction.reset(compiledGraph);
    GpuDeclNodeDescs recoveredNodes = GpuDeclNodeDescs(testArena.arena);
    GpuDeclEdgeDescs recoveredEdges = GpuDeclEdgeDescs(testArena.arena);
    GpuDeclPendingEdges recoveredPendingEdges = GpuDeclPendingEdges(testArena.arena);
    GpuDeclFrameGraphBuilder recoveredBuilder = GpuDecl_MakeFrameGraphBuilder(
        scratchArena,
        recoveredNodes,
        recoveredEdges,
        recoveredPendingEdges
    );
    const GpuDeclReadViews reads = GpuDeclReadViews(graph, compiledGraph);
    ASSERT_TRUE(reads.valid());
    ASSERT_TRUE(tracker.update(reads.declarations, assignments, reads.compiled, transaction, scratchArena));
    EXPECT_TRUE(tracker.validFor(reads.declarations, assignments, reads.compiled));
    b8 recoveredAppended = false;
    native(in reads, in analysis, in assignments, in tracker, mut scratchArena, mut recoveredBuilder, mut recoveredAppended){
        const Core::GpuTaskGraphTelemetryOptions options{
            .queueAssignments = &assignments,
            .compiledPlan = &reads.compiled,
            .queueAssignmentTelemetry = &tracker,
        };
        recoveredAppended = reads.declarations.appendFrameGraphTelemetry(analysis, scratchArena, recoveredBuilder, options);
    }
    EXPECT_TRUE(recoveredAppended);
}

void VerifyGpuDecl_OwnsUploadBlobsAndInvalidatesThemOnReset(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    Array<u8, 4> sourceBytes = Array<u8, 4>();
    sourceBytes[0u] = 0x17u;
    sourceBytes[1u] = 0x3au;
    sourceBytes[2u] = 0x5cu;
    sourceBytes[3u] = 0x8eu;

    Expected<GpuUploadBlobId> blobResult = MakeUnexpected(Failure());
    native(mut graph, in sourceBytes, mut blobResult){
        EXPECT_FALSE(graph.copyUploadData(nullptr, sizeof(sourceBytes), alignof(u8)).has_value());
        EXPECT_FALSE(graph.copyUploadData(sourceBytes.data(), 0u, alignof(u8)).has_value());
        EXPECT_FALSE(graph.copyUploadData(sourceBytes.data(), sizeof(sourceBytes), 3u).has_value());
        blobResult = graph.copyUploadData(sourceBytes.data(), sizeof(sourceBytes), alignof(u32));
    }
    ASSERT_TRUE(blobResult.has_value());
    const GpuUploadBlobId blob = blobResult.value();
    ASSERT_TRUE(blob.valid());
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        EXPECT_TRUE(declarations.validUploadBlob(blob));
        EXPECT_EQ(declarations.uploadBlobCount(), 1u);

        sourceBytes[0u] = 0u;
        const auto storedBytes = declarations.uploadBlobData(blob);
        ASSERT_TRUE(storedBytes.has_value());
        ASSERT_EQ(storedBytes.value().size(), sourceBytes.size());
        EXPECT_EQ(storedBytes.value()[0u], 0x17u);
    }

    graph.reset();
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        EXPECT_FALSE(declarations.validUploadBlob(blob));
        EXPECT_EQ(declarations.uploadBlobCount(), 0u);
        EXPECT_FALSE(declarations.uploadBlobData(blob).has_value());
    }

    Expected<GpuUploadBlobId> replacementResult = MakeUnexpected(Failure());
    native(mut graph, in sourceBytes, mut replacementResult){
        replacementResult = graph.copyUploadData(sourceBytes.data(), sizeof(sourceBytes), alignof(u32));
    }
    ASSERT_TRUE(replacementResult.has_value());
    const GpuUploadBlobId replacement = replacementResult.value();
    ASSERT_TRUE(replacement.valid());
    EXPECT_EQ(replacement.index, 0u);
    EXPECT_NE(replacement.generation, blob.generation);
}

void VerifyGpuDecl_UploadBlobPreservesRequestedAlignmentAcrossGrowth(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const usize alignment = 65536u;
    Array<u8, 3> source = Array<u8, 3>();
    source[0u] = 0x17u;
    source[1u] = 0x80u;
    source[2u] = 0xffu;

    Expected<GpuUploadBlobId> first = MakeUnexpected(Failure());
    native(mut graph, in source, in alignment, mut first){
        first = graph.copyUploadData(source.data(), source.size(), alignment);
        if(first.has_value()){
            for(usize index = 0u; index < 32u; ++index)
                ASSERT_TRUE(graph.copyUploadData(source.data(), source.size(), alignment).has_value());
        }
    }
    ASSERT_TRUE(first.has_value());
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
    const auto bytes = declarations.uploadBlobData(first.value());
    ASSERT_TRUE(bytes.has_value());
    ASSERT_EQ(bytes.value().size(), source.size());
    usize addrMod = 1u;
    native(in bytes, in alignment, mut addrMod){
        addrMod = reinterpret_cast<usize>(bytes.value().data()) % alignment;
    }
    EXPECT_EQ(addrMod, 0u);
    for(usize index = 0u; index < source.size(); ++index)
        EXPECT_EQ(bytes.value()[index], source[index]);
}

void VerifyGpuDecl_RejectsOverflowingUploadBlobAllocation(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    b8 rejected = false;
    native(mut graph, mut rejected){
        const u8 source = 0x17u;
        rejected = !graph.copyUploadData(&source, Limit<usize>::s_Max, 65536u).has_value();
    }
    EXPECT_TRUE(rejected);
}

void VerifyGpuDecl_OwnsPipelineMetadataAndInvalidatesPipelineIdsOnReset(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);

    GpuGraphPipelineDesc invalidDesc = GpuGraphPipelineDesc();
    invalidDesc.setIdentity(s_DeclarationCaseInvalidPipeline);
    invalidDesc.setMarkerLabel("Invalid Pipeline");
    EXPECT_FALSE(graph.importPipeline(invalidDesc).has_value());

    GpuGraphPipelineDesc nullComputeDesc = GpuGraphPipelineDesc();
    nullComputeDesc.setIdentity(s_DeclarationCaseNullComputePipeline);
    nullComputeDesc.setMarkerLabel("Null Compute Pipeline");
    nullComputeDesc.setType(GpuGraphPipelineType::Compute);
    EXPECT_FALSE(graph.importComputePipeline(ComputePipelineHandle(), nullComputeDesc).has_value());

    GpuGraphPipelineDesc desc = GpuGraphPipelineDesc();
    Expected<GpuGraphPipelineId> pipelineResult = MakeUnexpected(Failure());
    native(mut graph, mut desc, mut pipelineResult){
        Array<char, 27u> markerLabel = {
            'D', 'e', 'f', 'e', 'r', 'r', 'e', 'd', ' ', 'L', 'i', 'g', 'h', 't', 'i', 'n', 'g', ' ', 'P', 'i', 'p', 'e', 'l', 'i', 'n', 'e', '\0'
        };
        desc.setIdentity(s_GpuDeclDeferredLightingPipelinePath).setMarkerLabel(AStringView(markerLabel.data())).setType(Core::GpuGraphPipelineType::Compute);
        pipelineResult = graph.importPipeline(desc);
        markerLabel[0] = 'X';
    }
    ASSERT_TRUE(pipelineResult.has_value());
    const GpuGraphPipelineId pipeline = pipelineResult.value();
    ASSERT_TRUE(pipeline.valid());
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        EXPECT_TRUE(declarations.validPipeline(pipeline));
        EXPECT_EQ(declarations.pipelineCount(), 1u);
    }
    {
        const auto gpuTaskAdmission = graph.importPipeline(desc);
        EXPECT_TRUE(gpuTaskAdmission.has_value());
        if(gpuTaskAdmission.has_value())
            EXPECT_EQ(gpuTaskAdmission.value(), pipeline);
    }
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        const GpuTaskGraphPipelineView stored = declarations.pipelineAt(pipeline.index);
        EXPECT_EQ(stored.markerLabel, "Deferred Lighting Pipeline");
    }

    GpuGraphPipelineDesc mismatchedType = desc;
    mismatchedType.setType(GpuGraphPipelineType::Graphics);
    EXPECT_FALSE(graph.importPipeline(mismatchedType).has_value());

    graph.reset();
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        EXPECT_EQ(declarations.pipelineCount(), 0u);
        EXPECT_FALSE(declarations.validPipeline(pipeline));
        b8 isNullCompute = false;
        native(in declarations, in pipeline, mut isNullCompute){
            isNullCompute = declarations.computePipelineFor(pipeline) == nullptr;
        }
        EXPECT_TRUE(isNullCompute);
    }

    const auto replacementResult = AddPipelineMetadata(graph, s_GpuDeclDeferredLightingPipelinePath, "Replacement Pipeline", GpuGraphPipelineType::Compute);
    ASSERT_TRUE(replacementResult.has_value());
    const GpuGraphPipelineId replacement = replacementResult.value();
    ASSERT_TRUE(replacement.valid());
    EXPECT_EQ(replacement.index, 0u);
    EXPECT_NE(replacement.generation, pipeline.generation);
    EXPECT_NE(replacement, pipeline);
}

void VerifyGpuDecl_RejectsStaleDependencyHandlesDuringAnalysis(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const auto staleTaskResult = GpuDecl_AddEmptyTask(s_DeclarationCaseOld, "Old", graph);
    ASSERT_TRUE(staleTaskResult.has_value());
    const GpuTaskId staleTask = staleTaskResult.value();
    ASSERT_TRUE(staleTask.valid());

    graph.reset();
    Array<GpuTaskId, 1> staleDeps = Array<GpuTaskId, 1>();
    staleDeps[0u] = staleTask;
    const auto taskResult = GpuDecl_AddDepTask(s_DeclarationCaseNew, "New", staleDeps, graph);
    ASSERT_TRUE(taskResult.has_value());
    const GpuTaskId task = taskResult.value();
    ASSERT_TRUE(task.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    EXPECT_FALSE(Analyze(graph, operationScratchArena, analysis));
    EXPECT_EQ(analysis.diagnostic().status, GpuTaskGraphAnalysisStatus::InvalidTaskDependency);
    EXPECT_EQ(analysis.diagnostic().task, task);
    EXPECT_EQ(analysis.diagnostic().relatedTask, staleTask);
}

void VerifyGpuDecl_RejectsEmptyLabelsAndStaleResourceAndExternalHandles(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);

    GpuGraphResourceDesc unlabeledResource = GpuGraphResourceDesc();
    unlabeledResource.setIdentity(s_DeclarationCaseUnlabeledResource);
    unlabeledResource.setType(GpuGraphResourceType::HazardDomain);
    EXPECT_FALSE(graph.importHazardDomain(unlabeledResource).has_value());
    EXPECT_FALSE(GpuDecl_AddEmptyTask(s_DeclarationCaseUnlabeledTask, "", graph).has_value());
    GpuExternalCompletionDesc unlabeledExt = GpuExternalCompletionDesc();
    unlabeledExt.setIdentity(s_DeclarationCaseUnlabeledExternal);
    EXPECT_FALSE(graph.importExternalCompletion(unlabeledExt).has_value());

    const auto staleResourceResult = AddHazardDomain(graph, s_DeclarationCaseStaleResource, "Stale Resource");
    ASSERT_TRUE(staleResourceResult.has_value());
    const GpuGraphResourceId staleResource = staleResourceResult.value();
    GpuExternalCompletionDesc staleExtDesc = GpuExternalCompletionDesc();
    staleExtDesc.setIdentity(s_DeclarationCaseStaleExternal);
    staleExtDesc.setMarkerLabel("Stale External");
    const auto staleExternalResult = graph.importExternalCompletion(staleExtDesc);
    ASSERT_TRUE(staleExternalResult.has_value());
    const GpuExternalCompletionId staleExternal = staleExternalResult.value();
    ASSERT_TRUE(staleResource.valid());
    ASSERT_TRUE(staleExternal.valid());

    graph.reset();
    Array<GpuTaskResourceUse, 1> staleResourceUses = Array<GpuTaskResourceUse, 1>();
    staleResourceUses[0u].resource = staleResource;
    staleResourceUses[0u].requiredState = ResourceStates::ShaderResource;
    staleResourceUses[0u].access = GpuTaskResourceAccess::Read;
    const auto resourceTaskResult = GpuDecl_AddUseTask(s_DeclarationCaseStaleResourceConsumer, "Stale Resource Consumer", staleResourceUses, graph);
    ASSERT_TRUE(resourceTaskResult.has_value());
    const GpuTaskId resourceTask = resourceTaskResult.value();
    ASSERT_TRUE(resourceTask.valid());
    GpuTaskGraphAnalysis resourceAnalysis = GpuTaskGraphAnalysis(testArena.arena);
    EXPECT_FALSE(Analyze(graph, operationScratchArena, resourceAnalysis));
    EXPECT_EQ(resourceAnalysis.diagnostic().status, GpuTaskGraphAnalysisStatus::InvalidResourceUse);
    EXPECT_EQ(resourceAnalysis.diagnostic().task, resourceTask);
    EXPECT_EQ(resourceAnalysis.diagnostic().resource, staleResource);

    graph.reset();
    Array<GpuExternalCompletionId, 1> staleExtDeps = Array<GpuExternalCompletionId, 1>();
    staleExtDeps[0u] = staleExternal;
    GpuTaskDesc externalDesc = GpuTaskDesc();
    externalDesc.setIdentity(s_DeclarationCaseStaleExternalConsumer);
    externalDesc.setMarkerLabel("Stale External Consumer");
    externalDesc.setExternalDependencies(staleExtDeps);
    const auto externalTaskResult = graph.addTask(externalDesc);
    ASSERT_TRUE(externalTaskResult.has_value());
    const GpuTaskId externalTask = externalTaskResult.value();
    ASSERT_TRUE(externalTask.valid());
    GpuTaskGraphAnalysis externalAnalysis = GpuTaskGraphAnalysis(testArena.arena);
    EXPECT_FALSE(Analyze(graph, operationScratchArena, externalAnalysis));
    EXPECT_EQ(externalAnalysis.diagnostic().status, GpuTaskGraphAnalysisStatus::InvalidExternalCompletionDependency);
    EXPECT_EQ(externalAnalysis.diagnostic().task, externalTask);
}

void GpuDecl_DeclareDenseDependencies(mut GpuTaskGraph graph, in usize taskCount, in GpuDeclDenseScenario scenario){
    Vector<GpuGraphResourceId> resources = Vector<GpuGraphResourceId>();
    Vector<GpuTaskId> tasks = Vector<GpuTaskId>();
    Vector<GpuTaskResourceUse> uses = Vector<GpuTaskResourceUse>();
    if(scenario != GpuDeclDenseScenario::Explicit){
        resources.reserve(taskCount);
        uses.reserve(taskCount);
    }
    tasks.reserve(taskCount);
    if(scenario != GpuDeclDenseScenario::Explicit){
        for(usize index = 0u; index < taskCount; ++index){
            const auto resourceNameResult = IndexedName(s_GpuCaseDenseDependenciesResource, index);
            ASSERT_TRUE(resourceNameResult.has_value());
            const auto gpuTaskAdmission = AddHazardDomain(graph, resourceNameResult.value(), "Dense Hazard");
            ASSERT_TRUE(gpuTaskAdmission.has_value());
            resources.push_back(gpuTaskAdmission.value());
            ASSERT_TRUE(resources.back().valid());
        }
    }

    const Span<GpuTaskId> emptyDeps = Span<GpuTaskId>();
    const Span<GpuTaskResourceSetUse> emptySets = Span<GpuTaskResourceSetUse>();
    const Span<GpuTaskResourceVersionUse> emptyVersions = Span<GpuTaskResourceVersionUse>();
    const Span<GpuExternalCompletionId> emptyExternals = Span<GpuExternalCompletionId>();
    for(usize index = 0u; index < taskCount; ++index){
        uses.clear();
        if(scenario != GpuDeclDenseScenario::Explicit){
            for(usize resourceIndex = 0u; resourceIndex <= index; ++resourceIndex){
                GpuTaskResourceUse use = GpuTaskResourceUse();
                use.resource = resources[resourceIndex];
                use.requiredState = ResourceStates::UnorderedAccess;
                if(resourceIndex == index)
                    use.access = GpuTaskResourceAccess::Write;
                else
                    use.access = GpuTaskResourceAccess::Read;
                uses.push_back(use);
            }
        }
        const auto derivedNameResult = IndexedName(s_GpuCaseDenseDependenciesTask, index);
        ASSERT_TRUE(derivedNameResult.has_value());
        Span<GpuTaskId> depSpan = emptyDeps;
        if(scenario != GpuDeclDenseScenario::Inferred)
            depSpan = tasks;
        const auto taskResult = AddTask(
            derivedNameResult.value(),
            "Dense Dependency Task",
            depSpan,
            uses,
            emptySets,
            emptyVersions,
            emptyExternals,
            graph
        );
        ASSERT_TRUE(taskResult.has_value());
        const GpuTaskId task = taskResult.value();
        ASSERT_TRUE(task.valid());
        tasks.push_back(task);
    }
}

void GpuDecl_CheckDenseDependencies(in usize taskCount, in GpuDeclDenseScenario scenario){
    const GpuDeclScopedTrace trace = GpuDeclScopedTrace(cast<u32>(scenario));
    TestArena arena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(arena.arena);
    GpuDecl_DeclareDenseDependencies(graph, taskCount, scenario);
    ASSERT_FALSE(GpuDecl_HasFatalFailure());

    const GpuTaskGraphDeclarationReadView view = GpuTaskGraphDeclarationReadView(graph);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(arena.arena);
    const GpuTaskGraphCompiler compiler = GpuTaskGraphCompiler();
    const usize pairCount = taskCount * (taskCount - 1u) / 2u;
    ScratchArena analysisScratch = ScratchArena(s_TaskGpuScratch);
    ASSERT_TRUE(compiler.analyze(view, analysisScratch, analysis));
    const usize peakScratch = analysisScratch.memoryStats().peakUsedBytes;
    ASSERT_EQ(analysis.edges().size(), pairCount);
    ASSERT_EQ(analysis.schedulingEdges().size(), taskCount - 1u);
    usize expectedInferred = pairCount;
    if(scenario == GpuDeclDenseScenario::Explicit)
        expectedInferred = 0u;
    ASSERT_EQ(analysis.inferredEdges().size(), expectedInferred);
    for(in GpuTaskDependencyEdge edge : analysis.edges()){
        EXPECT_LT(edge.producer.index, edge.consumer.index);
        EXPECT_EQ(edge.hazard == GpuTaskHazardType::Explicit, scenario != GpuDeclDenseScenario::Inferred);
    }
    for(in GpuTaskDependencyEdge edge : analysis.schedulingEdges())
        EXPECT_EQ(edge.consumer.index, edge.producer.index + 1u);

    EXPECT_LT(peakScratch, s_GpuDeclMaxDenseScratchBytes);
    GpuDeclNodeDescs nodes = GpuDeclNodeDescs(arena.arena);
    GpuDeclEdgeDescs edges = GpuDeclEdgeDescs(arena.arena);
    GpuDeclPendingEdges pending = GpuDeclPendingEdges(arena.arena);
    usize resourceUseCount = pairCount + taskCount;
    if(scenario == GpuDeclDenseScenario::Explicit)
        resourceUseCount = 0u;
    nodes.reserve(taskCount + view.resourceCount());
    edges.reserve(pairCount + resourceUseCount);
    ScratchArena scratch = ScratchArena(s_TaskGpuScratch);
    GpuDeclFrameGraphBuilder builder = GpuDecl_MakeFrameGraphBuilder(scratch, nodes, edges, pending);
    ASSERT_TRUE(view.appendFrameGraphTelemetry(analysis, scratch, builder));
    EXPECT_LT(scratch.memoryStats().peakUsedBytes, s_GpuDeclMaxDenseScratchBytes);
    EXPECT_EQ(nodes.size(), taskCount + view.resourceCount());
    EXPECT_EQ(edges.size(), pairCount + resourceUseCount);
    usize dependencyIndex = 0u;
    for(usize edgeIdx = 0u; edgeIdx < edges.size(); ++edgeIdx){
        const auto edge = edges[edgeIdx];
        if(edge.kind != FrameGraphEdgeKind::DependsOn)
            continue;
        ASSERT_LT(dependencyIndex, analysis.edges().size());
        const GpuTaskDependencyEdge dependency = analysis.edges()[dependencyIndex];
        ++dependencyIndex;
        EXPECT_EQ(edge.fromNodeIndex, view.resourceCount() + dependency.producer.index);
        EXPECT_EQ(edge.toNodeIndex, view.resourceCount() + dependency.consumer.index);
        u8 flags = 0u;
        if(scenario != GpuDeclDenseScenario::Inferred)
            flags = cast<u8>(GpuTaskGraphTelemetryEdgeFlag::ExplicitDependency);
        if(scenario != GpuDeclDenseScenario::Explicit)
            flags = flags | cast<u8>(GpuTaskGraphTelemetryEdgeFlag::InferredDependency);
        EXPECT_EQ(edge.flags, flags);
    }
    EXPECT_EQ(dependencyIndex, pairCount);
}

void VerifyGpuDecl_DenseSequentialDependencyPairsBoundStorageAndPreserveTelemetryFlags(){
    Array<GpuDeclDenseScenario, 3> scenarios = Array<GpuDeclDenseScenario, 3>();
    scenarios[0u] = GpuDeclDenseScenario::Explicit;
    scenarios[1u] = GpuDeclDenseScenario::Inferred;
    scenarios[2u] = GpuDeclDenseScenario::Mixed;
    for(in GpuDeclDenseScenario scenario : scenarios){
        GpuDecl_CheckDenseDependencies(256u, scenario);
        ASSERT_FALSE(GpuDecl_HasFatalFailure());
    }
}

void VerifyGpuDecl_ReductionRetainsAnUnreachedMiddleTargetAfterReachingTheLastTarget(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena arena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(arena.arena);
    const auto rootResult = GpuDecl_AddEmptyTask(s_GpuCaseReductionGapRoot, "Root", graph);
    ASSERT_TRUE(rootResult.has_value());
    const GpuTaskId root = rootResult.value();
    Array<GpuTaskId, 1> rootDeps = Array<GpuTaskId, 1>();
    rootDeps[0u] = root;
    const auto leftResult = GpuDecl_AddDepTask(s_GpuCaseReductionGapLeft, "Left", rootDeps, graph);
    ASSERT_TRUE(leftResult.has_value());
    const GpuTaskId left = leftResult.value();
    const auto middleResult = GpuDecl_AddDepTask(s_GpuCaseReductionGapMiddle, "Middle", rootDeps, graph);
    ASSERT_TRUE(middleResult.has_value());
    const GpuTaskId middle = middleResult.value();
    Array<GpuTaskId, 2> lastDependencies = Array<GpuTaskId, 2>();
    lastDependencies[0u] = root;
    lastDependencies[1u] = left;
    const auto lastResult = GpuDecl_AddDepTask(s_GpuCaseReductionGapLast, "Last", lastDependencies, graph);
    ASSERT_TRUE(lastResult.has_value());
    const GpuTaskId last = lastResult.value();
    ASSERT_TRUE(root.valid());
    ASSERT_TRUE(left.valid());
    ASSERT_TRUE(middle.valid());
    ASSERT_TRUE(last.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(arena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    ASSERT_EQ(analysis.schedulingEdges().size(), 3u);
    b8 retainsMiddle = false;
    b8 retainsRedundantLast = false;
    for(in GpuTaskDependencyEdge edge : analysis.schedulingEdges()){
        if(edge.producer == root && edge.consumer == middle)
            retainsMiddle = true;
        if(edge.producer == root && edge.consumer == last)
            retainsRedundantLast = true;
    }
    EXPECT_TRUE(retainsMiddle);
    EXPECT_FALSE(retainsRedundantLast);
}

void VerifyGpuDecl_ExpandsImmutableResourceSetsIntoConcreteHazards(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const auto textureAResult = AddTextureMetadata(graph, s_GpuCaseTaskGraphResourceSetTextureA, "Resource Set Texture A");
    ASSERT_TRUE(textureAResult.has_value());
    const GpuGraphResourceId textureA = textureAResult.value();
    const auto textureBResult = AddTextureMetadata(graph, s_GpuCaseTaskGraphResourceSetTextureB, "Resource Set Texture B");
    ASSERT_TRUE(textureBResult.has_value());
    const GpuGraphResourceId textureB = textureBResult.value();
    const auto bufferResult = AddBufferMetadata(graph, s_GpuCaseTaskGraphResourceSetBuffer, "Resource Set Buffer");
    ASSERT_TRUE(bufferResult.has_value());
    const GpuGraphResourceId buffer = bufferResult.value();
    ASSERT_TRUE(textureA.valid());
    ASSERT_TRUE(textureB.valid());
    ASSERT_TRUE(buffer.valid());

    Array<GpuGraphResourceId, 3> members = Array<GpuGraphResourceId, 3>();
    members[0u] = textureA;
    members[1u] = textureB;
    members[2u] = buffer;
    GpuGraphResourceSetDesc resourceSetDesc = GpuGraphResourceSetDesc();
    resourceSetDesc.setIdentity(s_GpuCaseTaskGraphVisibleResources);
    resourceSetDesc.setMarkerLabel("Visible Resources");
    resourceSetDesc.setMembers(members);
    const auto resourceSetResult = graph.importResourceSet(resourceSetDesc);
    ASSERT_TRUE(resourceSetResult.has_value());
    const GpuGraphResourceSetId resourceSet = resourceSetResult.value();
    ASSERT_TRUE(resourceSet.valid());
    {
        const auto gpuTaskAdmission = graph.importResourceSet(resourceSetDesc);
        EXPECT_TRUE(gpuTaskAdmission.has_value());
        if(gpuTaskAdmission.has_value())
            EXPECT_EQ(gpuTaskAdmission.value(), resourceSet);
    }

    Array<GpuGraphResourceId, 2> duplicateMembers = Array<GpuGraphResourceId, 2>();
    duplicateMembers[0u] = textureA;
    duplicateMembers[1u] = textureA;
    GpuGraphResourceSetDesc dupDesc = GpuGraphResourceSetDesc();
    dupDesc.setIdentity(s_TaskGraphCaseTestsTaskGraphDuplicateResources);
    dupDesc.setMarkerLabel("Duplicate Resources");
    dupDesc.setMembers(duplicateMembers);
    EXPECT_FALSE(graph.importResourceSet(dupDesc).has_value());

    Array<GpuTaskResourceSetUse, 1> writeSetUses = Array<GpuTaskResourceSetUse, 1>();
    writeSetUses[0u].resourceSet = resourceSet;
    writeSetUses[0u].requiredState = ResourceStates::UnorderedAccess;
    writeSetUses[0u].access = GpuTaskResourceAccess::Write;
    Array<GpuTaskResourceSetUse, 1> readSetUses = Array<GpuTaskResourceSetUse, 1>();
    readSetUses[0u].resourceSet = resourceSet;
    readSetUses[0u].requiredState = ResourceStates::ShaderResource;
    readSetUses[0u].access = GpuTaskResourceAccess::Read;

    const auto writerResult = GpuDecl_AddSetTask(s_GpuCaseTaskGraphResourceSetWriter, "Resource Set Writer", writeSetUses, graph);
    ASSERT_TRUE(writerResult.has_value());
    const GpuTaskId writer = writerResult.value();
    const auto readerResult = GpuDecl_AddSetTask(s_GpuCaseTaskGraphResourceSetReader, "Resource Set Reader", readSetUses, graph);
    ASSERT_TRUE(readerResult.has_value());
    const GpuTaskId reader = readerResult.value();
    ASSERT_TRUE(writer.valid());
    ASSERT_TRUE(reader.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    ASSERT_EQ(analysis.edges().size(), 1u);
    const Optional<GpuTaskDependencyEdge> edge = GpuDecl_FindEdge(analysis, writer, reader);
    ASSERT_TRUE(edge.has_value());
    EXPECT_EQ(edge.value().hazard, GpuTaskHazardType::ReadAfterWrite);
    ASSERT_EQ(analysis.inferredEdges().size(), members.size());
    for(in GpuGraphResourceId member : members)
        EXPECT_TRUE(HasInferredHazard(analysis, writer, reader, member, GpuTaskHazardType::ReadAfterWrite));

    graph.reset();
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        EXPECT_FALSE(declarations.validResourceSet(resourceSet));
    }
    Array<GpuTaskResourceSetUse, 1> staleSetUses = Array<GpuTaskResourceSetUse, 1>();
    staleSetUses[0u].resourceSet = resourceSet;
    staleSetUses[0u].requiredState = ResourceStates::ShaderResource;
    staleSetUses[0u].access = GpuTaskResourceAccess::Read;
    EXPECT_FALSE(GpuDecl_AddSetTask(s_TaskGraphCaseTestsTaskGraphStaleResourceSet, "Stale Resource Set", staleSetUses, graph).has_value());
}

void VerifyGpuDecl_RejectsMalformedBufferRangesAndDetectsTextureOverlap(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuGraphResourceDesc bufferDesc = GpuGraphResourceDesc();
    bufferDesc.setIdentity(s_GpuCaseTaskGraphRangeBuffer);
    bufferDesc.setMarkerLabel("Range Buffer");
    bufferDesc.setType(GpuGraphResourceType::Buffer);
    const auto bufferResult = graph.importResource(bufferDesc);
    ASSERT_TRUE(bufferResult.has_value());
    const GpuGraphResourceId buffer = bufferResult.value();
    ASSERT_TRUE(buffer.valid());

    Array<GpuTaskResourceUse, 1> zeroBufferUses = Array<GpuTaskResourceUse, 1>();
    zeroBufferUses[0u].resource = buffer;
    zeroBufferUses[0u].range.bufferRange = BufferRange(0u, 0u);
    zeroBufferUses[0u].requiredState = ResourceStates::ShaderResource;
    zeroBufferUses[0u].access = GpuTaskResourceAccess::Read;
    {
        const auto gpuTaskAdmission = GpuDecl_AddUseTask(s_GpuCaseTaskGraphZeroBufferRange, "Zero Buffer Range", zeroBufferUses, graph);
        ASSERT_TRUE(gpuTaskAdmission.has_value());
        ASSERT_TRUE(gpuTaskAdmission.value().valid());
    }
    GpuTaskGraphAnalysis zeroRangeAnalysis = GpuTaskGraphAnalysis(testArena.arena);
    EXPECT_FALSE(Analyze(graph, operationScratchArena, zeroRangeAnalysis));
    EXPECT_EQ(zeroRangeAnalysis.diagnostic().status, GpuTaskGraphAnalysisStatus::InvalidResourceUse);

    graph.reset();
    const auto overflowBufferResult = graph.importResource(bufferDesc);
    ASSERT_TRUE(overflowBufferResult.has_value());
    const GpuGraphResourceId overflowBuffer = overflowBufferResult.value();
    ASSERT_TRUE(overflowBuffer.valid());
    Array<GpuTaskResourceUse, 1> overflowBufferUses = Array<GpuTaskResourceUse, 1>();
    overflowBufferUses[0u].resource = overflowBuffer;
    overflowBufferUses[0u].range.bufferRange = BufferRange(u64.max - 3u, 4u);
    overflowBufferUses[0u].requiredState = ResourceStates::ShaderResource;
    overflowBufferUses[0u].access = GpuTaskResourceAccess::Read;
    {
        const auto secondGpuTaskAdmission = GpuDecl_AddUseTask(s_GpuCaseTaskGraphOverflowBufferRange, "Overflow Buffer Range", overflowBufferUses, graph);
        ASSERT_TRUE(secondGpuTaskAdmission.has_value());
        ASSERT_TRUE(secondGpuTaskAdmission.value().valid());
    }
    GpuTaskGraphAnalysis overflowRangeAnalysis = GpuTaskGraphAnalysis(testArena.arena);
    EXPECT_FALSE(Analyze(graph, operationScratchArena, overflowRangeAnalysis));
    EXPECT_EQ(overflowRangeAnalysis.diagnostic().status, GpuTaskGraphAnalysisStatus::InvalidResourceUse);

    graph.reset();
    GpuGraphResourceDesc textureDesc = GpuGraphResourceDesc();
    textureDesc.setIdentity(s_GpuCaseTaskGraphOverlapTexture);
    textureDesc.setMarkerLabel("Overlap Texture");
    textureDesc.setType(GpuGraphResourceType::Texture);
    const auto textureResult = graph.importResource(textureDesc);
    ASSERT_TRUE(textureResult.has_value());
    const GpuGraphResourceId texture = textureResult.value();
    ASSERT_TRUE(texture.valid());

    Array<GpuTaskResourceUse, 1> firstTextureUses = Array<GpuTaskResourceUse, 1>();
    firstTextureUses[0u].resource = texture;
    firstTextureUses[0u].range.textureSubresources = TextureSubresourceSet(0u, 2u, 0u, 1u);
    firstTextureUses[0u].requiredState = ResourceStates::UnorderedAccess;
    firstTextureUses[0u].access = GpuTaskResourceAccess::Write;
    Array<GpuTaskResourceUse, 1> secondTextureUses = Array<GpuTaskResourceUse, 1>();
    secondTextureUses[0u].resource = texture;
    secondTextureUses[0u].range.textureSubresources = TextureSubresourceSet(1u, 1u, 0u, 1u);
    secondTextureUses[0u].requiredState = ResourceStates::ShaderResource;
    secondTextureUses[0u].access = GpuTaskResourceAccess::Read;

    const auto firstResult = GpuDecl_AddUseTask(s_GpuCaseTaskGraphOverlapTextureWriter, "Overlap Texture Writer", firstTextureUses, graph);
    ASSERT_TRUE(firstResult.has_value());
    const GpuTaskId first = firstResult.value();
    const auto secondResult = GpuDecl_AddUseTask(s_GpuCaseTaskGraphOverlapTextureReader, "Overlap Texture Reader", secondTextureUses, graph);
    ASSERT_TRUE(secondResult.has_value());
    const GpuTaskId second = secondResult.value();
    ASSERT_TRUE(first.valid());
    ASSERT_TRUE(second.valid());
    GpuTaskGraphAnalysis overlapAnalysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, overlapAnalysis));
    EXPECT_TRUE(GpuDecl_HasEdge(overlapAnalysis, first, second));
}

void VerifyGpuDecl_TracksOnlyTheNearestWholeResourceWriters(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const auto resourceResult = AddHazardDomain(graph, s_GpuCaseTaskGraphNearestWriterResource, "Nearest Writer Resource");
    ASSERT_TRUE(resourceResult.has_value());
    const GpuGraphResourceId resource = resourceResult.value();
    ASSERT_TRUE(resource.valid());

    Array<GpuTaskResourceUse, 1> writerUses = Array<GpuTaskResourceUse, 1>();
    writerUses[0u].resource = resource;
    writerUses[0u].requiredState = ResourceStates::UnorderedAccess;
    writerUses[0u].access = GpuTaskResourceAccess::Write;
    const auto firstResult = GpuDecl_AddUseTask(s_GpuCaseTaskGraphNearestWriterFirst, "Nearest Writer First", writerUses, graph);
    ASSERT_TRUE(firstResult.has_value());
    const GpuTaskId first = firstResult.value();
    const auto secondResult = GpuDecl_AddUseTask(s_GpuCaseTaskGraphNearestWriterSecond, "Nearest Writer Second", writerUses, graph);
    ASSERT_TRUE(secondResult.has_value());
    const GpuTaskId second = secondResult.value();
    const auto thirdResult = GpuDecl_AddUseTask(s_GpuCaseTaskGraphNearestWriterThird, "Nearest Writer Third", writerUses, graph);
    ASSERT_TRUE(thirdResult.has_value());
    const GpuTaskId third = thirdResult.value();
    ASSERT_TRUE(first.valid());
    ASSERT_TRUE(second.valid());
    ASSERT_TRUE(third.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    EXPECT_TRUE(GpuDecl_HasEdge(analysis, first, second));
    EXPECT_TRUE(GpuDecl_HasEdge(analysis, second, third));
    EXPECT_FALSE(GpuDecl_HasEdge(analysis, first, third));
    ASSERT_EQ(analysis.inferredEdges().size(), 2u);
    EXPECT_TRUE(HasInferredHazard(analysis, first, second, resource, GpuTaskHazardType::WriteAfterWrite));
    EXPECT_TRUE(HasInferredHazard(analysis, second, third, resource, GpuTaskHazardType::WriteAfterWrite));
}

void VerifyGpuDecl_UsesTheFullExplicitOrderToOrientInferredHazards(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const auto firstResourceResult = AddHazardDomain(graph, s_GpuCaseTaskGraphExplicitFirstResource, "Explicit First Resource");
    ASSERT_TRUE(firstResourceResult.has_value());
    const GpuGraphResourceId firstResource = firstResourceResult.value();
    const auto secondResourceResult = AddHazardDomain(graph, s_GpuCaseTaskGraphExplicitSecondResource, "Explicit Second Resource");
    ASSERT_TRUE(secondResourceResult.has_value());
    const GpuGraphResourceId secondResource = secondResourceResult.value();
    ASSERT_TRUE(firstResource.valid());
    ASSERT_TRUE(secondResource.valid());

    Array<GpuTaskResourceUse, 1> firstUses = Array<GpuTaskResourceUse, 1>();
    firstUses[0u].resource = firstResource;
    firstUses[0u].requiredState = ResourceStates::UnorderedAccess;
    firstUses[0u].access = GpuTaskResourceAccess::Write;
    Array<GpuTaskResourceUse, 2> secondUses = Array<GpuTaskResourceUse, 2>();
    secondUses[0u].resource = firstResource;
    secondUses[0u].requiredState = ResourceStates::ShaderResource;
    secondUses[0u].access = GpuTaskResourceAccess::Read;
    secondUses[1u].resource = secondResource;
    secondUses[1u].requiredState = ResourceStates::UnorderedAccess;
    secondUses[1u].access = GpuTaskResourceAccess::Write;
    Array<GpuTaskResourceUse, 1> thirdUses = Array<GpuTaskResourceUse, 1>();
    thirdUses[0u].resource = secondResource;
    thirdUses[0u].requiredState = ResourceStates::ShaderResource;
    thirdUses[0u].access = GpuTaskResourceAccess::Read;

    // Explicit third-to-first ordering reverses declaration order without creating a cycle.
    u64 graphGeneration = 0u;
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        graphGeneration = declarations.generation();
    }
    Array<GpuTaskId, 1> futureThirdDeps = Array<GpuTaskId, 1>();
    futureThirdDeps[0u] = GpuDecl_MakeTaskId(graphGeneration, 2u);
    const Span<GpuTaskResourceSetUse> emptySets = Span<GpuTaskResourceSetUse>();
    const Span<GpuTaskResourceVersionUse> emptyVersions = Span<GpuTaskResourceVersionUse>();
    const Span<GpuExternalCompletionId> emptyExternals = Span<GpuExternalCompletionId>();
    const auto firstResult = AddTask(
        s_GpuCaseTaskGraphExplicitFirst,
        "Explicit First",
        futureThirdDeps,
        firstUses,
        emptySets,
        emptyVersions,
        emptyExternals,
        graph
    );
    ASSERT_TRUE(firstResult.has_value());
    const GpuTaskId first = firstResult.value();
    const auto secondResult = GpuDecl_AddUseTask(s_GpuCaseTaskGraphExplicitSecond, "Explicit Second", secondUses, graph);
    ASSERT_TRUE(secondResult.has_value());
    const GpuTaskId second = secondResult.value();
    const auto thirdResult = GpuDecl_AddUseTask(s_GpuCaseTaskGraphExplicitThird, "Explicit Third", thirdUses, graph);
    ASSERT_TRUE(thirdResult.has_value());
    const GpuTaskId third = thirdResult.value();
    ASSERT_TRUE(first.valid());
    ASSERT_TRUE(second.valid());
    ASSERT_TRUE(third.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, operationScratchArena, analysis));
    EXPECT_TRUE(GpuDecl_HasEdge(analysis, third, first));
    EXPECT_TRUE(GpuDecl_HasEdge(analysis, second, first));
    EXPECT_TRUE(GpuDecl_HasEdge(analysis, second, third));
    ASSERT_EQ(analysis.topologicalOrder().size(), 3u);
    EXPECT_EQ(analysis.topologicalOrder()[0u], second);
    EXPECT_EQ(analysis.topologicalOrder()[1u], third);
    EXPECT_EQ(analysis.topologicalOrder()[2u], first);

    Array<GpuPhysicalQueueInfo, 1> queues = Array<GpuPhysicalQueueInfo, 1>();
    queues[0u] = GraphicsQueue();
    const GpuPhysicalQueueTopology topology = GpuDecl_MakeTopology(queues, 1u);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    const GpuDeclCompiledGraphReadView compiledPlan = GpuDeclCompiledGraphReadView(compiledGraph);

    ASSERT_EQ(compiledPlan.packetCount(), 3u);

    Array<GpuTaskId, 3> topologicalTasks = Array<GpuTaskId, 3>();
    topologicalTasks[0u] = second;
    topologicalTasks[1u] = third;
    topologicalTasks[2u] = first;
    for(usize taskIndex = 0u; taskIndex < topologicalTasks.size(); ++taskIndex){
        const GpuSubmissionPacketId packet = compiledPlan.packetIdAt(taskIndex);
        ASSERT_TRUE(packet.valid());
        const GpuCompiledPacketView packetView = compiledPlan.packet(packet);
        ASSERT_TRUE(GpuDecl_HasPacketTasksPtr(packetView));
        const Span<GpuTaskId> packetTasks = GpuDecl_PacketTasks(packetView);
        ASSERT_EQ(packetTasks.size(), 1u);
        EXPECT_EQ(packetTasks[0u], topologicalTasks[taskIndex]);
    }

    Array<GpuTaskId, 6> lookupOrder = Array<GpuTaskId, 6>();
    lookupOrder[0u] = first;
    lookupOrder[1u] = second;
    lookupOrder[2u] = third;
    lookupOrder[3u] = third;
    lookupOrder[4u] = second;
    lookupOrder[5u] = first;
    for(in GpuTaskId task : lookupOrder){
        const Optional<GpuTaskQueueAssignment> assignment = GpuDecl_FindAssignment(assignments, task);
        ASSERT_TRUE(assignment.has_value());
        EXPECT_EQ(assignment.value().task, task);
        const Optional<GpuCompiledTask> compiledTask = GpuDecl_TaskPlan(compiledPlan.findTask(task));
        ASSERT_TRUE(compiledTask.has_value());
        EXPECT_EQ(compiledTask.value().task, task);
        EXPECT_EQ(compiledPlan.packetForTask(task), compiledTask.value().packet);
        const GpuCompiledPacketView packetView = compiledPlan.packet(compiledTask.value().packet);
        ASSERT_TRUE(GpuDecl_HasPacketTasksPtr(packetView));
        const Span<GpuTaskId> packetTasks = GpuDecl_PacketTasks(packetView);
        ASSERT_EQ(packetTasks.size(), 1u);
        EXPECT_EQ(packetTasks[0u], task);
    }
}

void VerifyGpuDecl_RejectsExplicitCyclesAndExportsExternalMetadata(){
    ScratchArena telemetryScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    u64 graphGeneration = 0u;
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        ASSERT_TRUE(declarations.valid());
        graphGeneration = declarations.generation();
    }
    Array<GpuTaskId, 1> futureSecondDeps = Array<GpuTaskId, 1>();
    futureSecondDeps[0u] = GpuDecl_MakeTaskId(graphGeneration, 1u);
    const auto firstResult = GpuDecl_AddDepTask(s_GpuCaseTaskGraphCycleFirst, "Cycle First", futureSecondDeps, graph);
    ASSERT_TRUE(firstResult.has_value());
    const GpuTaskId first = firstResult.value();
    Array<GpuTaskId, 1> firstDeps = Array<GpuTaskId, 1>();
    firstDeps[0u] = first;
    const auto secondResult = GpuDecl_AddDepTask(s_GpuCaseTaskGraphCycleSecond, "Cycle Second", firstDeps, graph);
    ASSERT_TRUE(secondResult.has_value());
    const GpuTaskId second = secondResult.value();
    ASSERT_TRUE(first.valid());
    ASSERT_TRUE(second.valid());

    GpuTaskGraphAnalysis cycleAnalysis = GpuTaskGraphAnalysis(testArena.arena);
    EXPECT_FALSE(Analyze(graph, telemetryScratchArena, cycleAnalysis));
    EXPECT_EQ(cycleAnalysis.diagnostic().status, GpuTaskGraphAnalysisStatus::Cycle);
    ASSERT_GE(cycleAnalysis.cyclePath().size(), 3u);
    EXPECT_EQ(cycleAnalysis.cyclePath().front(), cycleAnalysis.cyclePath().back());
    ASSERT_EQ(cycleAnalysis.cycleEdges().size(), cycleAnalysis.cyclePath().size() - 1u);
    EXPECT_EQ(cycleAnalysis.cycleEdges()[0u].hazard, GpuTaskHazardType::Explicit);
    EXPECT_EQ(cycleAnalysis.diagnostic().task, cycleAnalysis.cycleEdges()[0u].consumer);
    EXPECT_EQ(cycleAnalysis.diagnostic().relatedTask, cycleAnalysis.cycleEdges()[0u].producer);

    graph.reset();
    GpuExternalCompletionDesc extDesc = GpuExternalCompletionDesc();
    extDesc.setIdentity(s_GpuCaseTaskGraphExternal);
    extDesc.setMarkerLabel("Prior Frame");
    const auto completionResult = graph.importExternalCompletion(extDesc);
    ASSERT_TRUE(completionResult.has_value());
    const GpuExternalCompletionId completion = completionResult.value();
    ASSERT_TRUE(completion.valid());

    Array<GpuExternalCompletionId, 1> extDeps = Array<GpuExternalCompletionId, 1>();
    extDeps[0u] = completion;
    GpuTaskDesc desc = GpuTaskDesc();
    desc.setIdentity(s_GpuCaseTaskGraphExternalConsumer);
    desc.setMarkerLabel("External Consumer");
    desc.setExternalDependencies(extDeps);
    const auto taskResult = graph.addTask(desc);
    ASSERT_TRUE(taskResult.has_value());
    const GpuTaskId task = taskResult.value();
    ASSERT_TRUE(task.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, telemetryScratchArena, analysis));

    GpuDeclNodeDescs nodes = GpuDeclNodeDescs(testArena.arena);
    GpuDeclEdgeDescs edges = GpuDeclEdgeDescs(testArena.arena);
    GpuDeclPendingEdges pendingEdges = GpuDeclPendingEdges(testArena.arena);
    GpuDeclFrameGraphBuilder builder = GpuDecl_MakeFrameGraphBuilder(telemetryScratchArena, nodes, edges, pendingEdges);
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        ASSERT_TRUE(declarations.valid());
        EXPECT_TRUE(declarations.appendFrameGraphTelemetry(analysis, telemetryScratchArena, builder));
    }

    {
        GpuExternalCompletionDesc lateDesc = GpuExternalCompletionDesc();
        lateDesc.setIdentity(s_GpuCaseTaskGraphLateExternal);
        lateDesc.setMarkerLabel("Late External");
        const auto gpuTaskAdmission = graph.importExternalCompletion(lateDesc);
        EXPECT_TRUE(gpuTaskAdmission.has_value());
        if(gpuTaskAdmission.has_value())
            EXPECT_TRUE(gpuTaskAdmission.value().valid());
    }
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        ASSERT_TRUE(declarations.valid());
        EXPECT_FALSE(declarations.appendFrameGraphTelemetry(analysis, telemetryScratchArena, builder));
    }
}

void VerifyGpuDecl_RejectsDeepExplicitCyclesWithoutCallStackGrowth(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);
    const usize taskCount = 8192u;

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    u64 graphGeneration = 0u;
    {
        const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
        ASSERT_TRUE(declarations.valid());
        graphGeneration = declarations.generation();
    }
    Array<GpuTaskId, 1> futureLastDeps = Array<GpuTaskId, 1>();
    futureLastDeps[0u] = GpuDecl_MakeTaskId(graphGeneration, cast<u32>(taskCount - 1u));
    const auto derivedNameResult = IndexedName(s_TaskGraphDeepCycleTask, 0u);
    ASSERT_TRUE(derivedNameResult.has_value());
    const auto firstResult = GpuDecl_AddDepTask(derivedNameResult.value(), s_GpuDeclDeepCycleTaskLabel, futureLastDeps, graph);
    ASSERT_TRUE(firstResult.has_value());
    const GpuTaskId first = firstResult.value();
    ASSERT_TRUE(first.valid());

    GpuTaskId previous = first;
    for(usize taskIndex = 1u; taskIndex < taskCount; ++taskIndex){
        const auto secondDerivedNameResult = IndexedName(s_TaskGraphDeepCycleTask, taskIndex);
        ASSERT_TRUE(secondDerivedNameResult.has_value());
        Array<GpuTaskId, 1> prevDeps = Array<GpuTaskId, 1>();
        prevDeps[0u] = previous;
        const auto currentResult = GpuDecl_AddDepTask(secondDerivedNameResult.value(), s_GpuDeclDeepCycleTaskLabel, prevDeps, graph);
        ASSERT_TRUE(currentResult.has_value());
        const GpuTaskId current = currentResult.value();
        ASSERT_TRUE(current.valid());
        previous = current;
    }

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    EXPECT_FALSE(Analyze(graph, operationScratchArena, analysis));
    EXPECT_EQ(analysis.diagnostic().status, GpuTaskGraphAnalysisStatus::Cycle);
    EXPECT_TRUE(analysis.topologicalOrder().empty());
    ASSERT_EQ(analysis.cyclePath().size(), taskCount + 1u);
    ASSERT_EQ(analysis.cycleEdges().size(), taskCount);
    for(usize taskIndex = 0u; taskIndex < taskCount; ++taskIndex){
        const GpuTaskId expectedTask = GpuDecl_MakeTaskId(graphGeneration, cast<u32>(taskIndex));
        EXPECT_EQ(analysis.cyclePath()[taskIndex], expectedTask);
        EXPECT_EQ(analysis.cycleEdges()[taskIndex].producer, analysis.cyclePath()[taskIndex]);
        EXPECT_EQ(analysis.cycleEdges()[taskIndex].consumer, analysis.cyclePath()[taskIndex + 1u]);
        EXPECT_EQ(analysis.cycleEdges()[taskIndex].hazard, GpuTaskHazardType::Explicit);
        EXPECT_FALSE(analysis.cycleEdges()[taskIndex].resource.valid());
        EXPECT_FALSE(analysis.cycleEdges()[taskIndex].resourceVersion.valid());
    }
    EXPECT_EQ(analysis.cyclePath().back(), first);
    EXPECT_EQ(analysis.diagnostic().task, analysis.cycleEdges()[0u].consumer);
    EXPECT_EQ(analysis.diagnostic().relatedTask, analysis.cycleEdges()[0u].producer);
}


