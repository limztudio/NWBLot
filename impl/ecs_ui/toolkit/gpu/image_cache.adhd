native{
#include <impl/ecs_ui/toolkit/gpu/renderer.adhd.h>

#include <global/arena_object.h>
#include <global/refcount_ptr.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_UI_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


template<typename T>
using GpuVersion = RefCountPtr<RefCounter<T>, ArenaRefDeleter<RefCounter<T>, Core::Alloc::GlobalArena>>;

template<typename TPage> class GpuPageVersion;
using GpuGlyphVersion = GpuPageVersion<SharedGlyphPage>;
using GpuSdfAtlasVersion = GpuPageVersion<SharedSdfAtlasPage>;
class GpuTextureImageVersion;


class GpuImageCache final : NoCopy{
public:
    explicit GpuImageCache(Core::Alloc::GlobalArena& arena);
    ~GpuImageCache()noexcept;


public:
    void reserve();
    void clear()noexcept;
    void trim(const DrawSnapshot& snapshot);
    void evict()noexcept;
    [[nodiscard]] auto& glyphs()noexcept{ return m_glyphCache; }
    [[nodiscard]] auto& sdfs()noexcept{ return m_sdfCache; }
    [[nodiscard]] auto& textures()noexcept{ return m_textureCache; }


private:
    Vector<GpuVersion<GpuGlyphVersion>, Core::Alloc::GlobalArena> m_glyphCache;
    Vector<GpuVersion<GpuSdfAtlasVersion>, Core::Alloc::GlobalArena> m_sdfCache;
    Vector<GpuVersion<GpuTextureImageVersion>, Core::Alloc::GlobalArena> m_textureCache;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_UI_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ImplEcsUiToolkitGpuImageCacheAdhdModule(in u64 value){
    return value != 0u;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

