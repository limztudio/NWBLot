    const Optional<HitTarget> hostTarget = FindUiListScrollbarTarget(self, self.id(s_UiListScrollbarListKey, s_UiListScrollbarPanelKey));
    ASSERT_TRUE(hostTarget.has_value());
    EXPECT_EQ(hostTarget.value().pageRows, 1u);
    EXPECT_EQ(self.m_source.textCalls, 0u);
}

