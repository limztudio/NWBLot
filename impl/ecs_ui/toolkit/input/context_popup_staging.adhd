////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "target_validation.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 TryRegisterContextPopupScope(
    in WidgetState state,
    in PopupToken currentPopup,
    in PopupScope scope,
    mut Vector<ContextOwnedPopup> popups,
    mut PopupToken outFenceToken
){
    outFenceToken = PopupToken();
    if(
        state.kind != WidgetKind::Popup
        || !scope.token.valid()
        || scope.token.widget != state.id
        || scope.token.declarationGeneration != state.declarationGeneration
        || scope.parent != currentPopup
        || popups.size() == s_InputMaxPopups
        || !HasValidPopupScopeGeometry(scope)
    )
        return false;
    for(in ContextOwnedPopup previous : popups){
        if(previous.scope.token.widget == scope.token.widget)
            return false;
    }
    PopupScope admitted = scope;
    if(popups.empty())
        admitted.layer = 1u;
    else
        admitted.layer = popups.back().scope.layer + 1u;
    ContextOwnedPopup owned;
    owned.scope = admitted;
    owned.root = state.root;
    popups.push_back(owned);
    outFenceToken = admitted.token;
    return true;
}

b8 TryActivateContextPopupScope(
    in PopupToken token,
    in WidgetRoot root,
    in PopupToken currentPopup,
    in Span<ContextOwnedPopup> popups,
    mut Array<PopupToken, s_InputMaxPopups> popupStack,
    mut usize inOutPopupDepth,
    mut PopupToken outCurrentPopup,
    mut u32 outPopupLayer
){
    if(!token.valid() || inOutPopupDepth == s_InputMaxPopups)
        return false;
    for(in ContextOwnedPopup owned : popups){
        if(owned.scope.token != token)
            continue;
        if(owned.root != root || owned.scope.parent != currentPopup)
            return false;
        popupStack[inOutPopupDepth] = token;
        ++inOutPopupDepth;
        outCurrentPopup = token;
        outPopupLayer = owned.scope.layer;
        return true;
    }
    return false;
}

b8 TryUpdateContextPopupScope(
    in PopupToken token,
    in WidgetRoot root,
    in PopupScope scope,
    mut Vector<ContextOwnedPopup> popups
){
    if(!token.valid() || scope.token != token || !HasValidPopupScopeGeometry(scope))
        return false;
    for(usize index = 0u; index < popups.size(); ++index){
        const ContextOwnedPopup owned = popups[index];
        if(owned.scope.token != token)
            continue;
        if(owned.root != root || scope.parent != owned.scope.parent || (scope.layer != 0u && scope.layer != owned.scope.layer))
            return false;
        PopupScope updated = scope;
        updated.layer = owned.scope.layer;
        popups[index].scope = updated;
        return true;
    }
    return false;
}

u32 ResolveContextPopupLayer(in Span<ContextOwnedPopup> popups, in PopupToken token){
    for(in ContextOwnedPopup owned : popups){
        if(owned.scope.token == token)
            return owned.scope.layer;
    }
    return 0u;
}

b8 TryEndContextPopupScope(
    in Span<ContextOwnedPopup> popups,
    mut Array<PopupToken, s_InputMaxPopups> popupStack,
    mut usize inOutPopupDepth,
    mut PopupToken inOutCurrentPopup,
    mut u32 outPopupLayer,
    mut PopupToken outEndedToken
){
    outEndedToken = PopupToken();
    if(inOutPopupDepth == 0u || !inOutCurrentPopup.valid())
        return false;
    outEndedToken = inOutCurrentPopup;
    --inOutPopupDepth;
    popupStack[inOutPopupDepth] = PopupToken();
    if(inOutPopupDepth == 0u)
        inOutCurrentPopup = PopupToken();
    else
        inOutCurrentPopup = popupStack[inOutPopupDepth - 1u];
    outPopupLayer = ResolveContextPopupLayer(popups, inOutCurrentPopup);
    return true;
}

b8 DiscardContextPopupScope(
    in PopupToken token,
    in Array<PopupToken, s_InputMaxPopups> popupStack,
    in usize popupDepth,
    mut Vector<ContextOwnedTarget> targets,
    mut Vector<ContextOwnedPopup> popups,
    mut b8 outRemovedAny
){
    outRemovedAny = false;
    Array<b8, s_InputMaxPopups> removed;
    b8 found = false;
    for(usize index = 0u; index < popups.size(); ++index){
        b8 isRemoved = popups[index].scope.token == token;
        for(usize ancestor = 0u; ancestor < index && !isRemoved; ++ancestor)
            isRemoved = removed[ancestor] && popups[index].scope.parent == popups[ancestor].scope.token;
        removed[index] = isRemoved;
        found = found || isRemoved;
    }
    if(!found)
        return true;
    for(usize active = 0u; active < popupDepth; ++active){
        const PopupToken activeToken = popupStack[active];
        for(usize popup = 0u; popup < popups.size(); ++popup){
            if(removed[popup] && activeToken == popups[popup].scope.token)
                return false;
        }
    }
    usize keptTargets = 0u;
    for(usize index = 0u; index < targets.size(); ++index){
        const PopupToken targetPopup = targets[index].target.popup;
        b8 removeTarget = false;
        for(usize popup = 0u; popup < popups.size(); ++popup){
            if(removed[popup] && targetPopup == popups[popup].scope.token){
                removeTarget = true;
                break;
            }
        }
        if(!removeTarget){
            if(keptTargets != index)
                targets[keptTargets] = targets[index];
            ++keptTargets;
        }
    }
    targets.resize(keptTargets);
    usize keptPopups = 0u;
    for(usize index = 0u; index < popups.size(); ++index){
        if(!removed[index]){
            if(keptPopups != index)
                popups[keptPopups] = popups[index];
            ++keptPopups;
        }
    }
    popups.resize(keptPopups);
    outRemovedAny = true;
    return true;
}


