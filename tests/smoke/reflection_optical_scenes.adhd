const f32 s_ReflectionHalfPi = s_PIDIV2;
const f32 s_ReflectionPi = s_PI;

enum<u8> ReflectionFeedbackCase{
    Boundary,
    Mutation,
    LongMiss
}

enum<u8> ReflectionRoughnessCase{
    Static,
    Furnace,
    Camera,
    Transform,
    Material,
    Light,
    Deform,
    StaticDeform
}

b8 IsReflectionFeedbackMutationCase(in ReflectionFeedbackCase mode){
    return mode == ReflectionFeedbackCase::Mutation;
}

b8 IsReflectionRoughnessMutationCase(in ReflectionRoughnessCase mode){
    return mode == ReflectionRoughnessCase::Camera
        || mode == ReflectionRoughnessCase::Transform
        || mode == ReflectionRoughnessCase::Material
        || mode == ReflectionRoughnessCase::Light
        || mode == ReflectionRoughnessCase::Deform;
}

b8 IsReflectionRoughnessDeformingCase(in ReflectionRoughnessCase mode){
    return mode == ReflectionRoughnessCase::Deform || mode == ReflectionRoughnessCase::StaticDeform;
}

class OpticalReceiverEntities{
    public EntityID receiver = s_InvalidEntityId;
    public EntityID cutter = s_InvalidEntityId;
}


