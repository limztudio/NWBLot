namespace NWB::Tests::Smoke{
inline constexpr Array<Core::GpuTimingScopeDefinition, 6> s_CausticGpuTimingScopes = {
    Impl::RendererGpuTimingScope::s_Frame,
    Impl::RendererGpuTimingScope::s_CausticPhotons,
    Impl::RendererGpuTimingScope::s_CausticResolve,
    Impl::RendererGpuTimingScope::s_OpaqueRegular,
    Impl::RendererGpuTimingScope::s_DeferredComposite,
    Impl::RendererGpuTimingScope::s_DeferredPresent,
};

#if defined(NWB_CSG_CAUSTIC_SMOKE)
inline constexpr b8 s_CsgCausticSmokeEnabled = true;
inline constexpr SmokeMaterialRef s_CsgShadowGlassMaterial{"project/smoke/csg_caustic/materials/glass"};
inline constexpr SmokeMaterialRef s_CsgShadowOpaqueMaterial{"project/smoke/csg_caustic/materials/receiver"};
#else
inline constexpr b8 s_CsgCausticSmokeEnabled = false;
inline constexpr SmokeMaterialRef s_CsgShadowGlassMaterial{"project/smoke/csg_shadow/materials/glass"};
inline constexpr SmokeMaterialRef s_CsgShadowOpaqueMaterial{"project/smoke/csg_shadow/materials/opaque"};
#endif

[[nodiscard]] inline TStringView CsgCausticProbeOwnerLabel()noexcept{
    return NWB_TEXT("csg_caustic");
}
};


