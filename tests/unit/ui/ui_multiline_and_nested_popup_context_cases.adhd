namespace __hidden_ui_nested_popup_lifetime_tests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace NWB;
using namespace NWB::Impl::Ui;
using namespace NWB::UiPopupToolsTests;
using namespace NWB::UiSearchComboTests;

inline constexpr AStringView s_MenuRowsKey = "rows";
inline constexpr AStringView s_BeforeKey = "before";
inline constexpr AStringView s_AfterKey = "after";
inline constexpr AStringView s_DeepPopupKey = "deep";
inline constexpr AStringView s_LeafKey = "leaf";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class UiNestedPopupLifetimeTests : public SearchFixture{
public:
    virtual void SetUp()override{
        SearchFixture::SetUp();
        m_source.count = 5u;
        m_searchSource.full.count = 5u;
        m_parent.open();
        m_child.open();
        for(PopupState& state : m_deeper)
            state.open();
    }

    [[nodiscard]] Optional<HitTarget> findTarget(const WidgetId widget)const noexcept{
        if(const HitTarget* found = target(widget))
            return *found;
        return {};
    }

    [[nodiscard]] b8 hasTarget(const WidgetId widget)const noexcept{
        return target(widget) != nullptr;
    }

    [[nodiscard]] WidgetId fieldId()const{ return UiTestSupport::RequireWidgetId(parentId(), s_ComboKey); }

    [[nodiscard]] WidgetId menuRows()const{ return UiTestSupport::RequireWidgetId(UiTestSupport::RequireWidgetId(parentId(), s_MenuKey), s_MenuRowsKey); }

    [[nodiscard]] b8 beginParent(u64 generation);
    [[nodiscard]] b8 finishParent(u64 generation);
    [[nodiscard]] b8 acceptPlain(u64 generation);
    [[nodiscard]] b8 acceptCombo(u64 generation);
    [[nodiscard]] b8 acceptSearch(u64 generation);
    [[nodiscard]] b8 acceptMenu(u64 generation);
    [[nodiscard]] b8 declareReserved(u64 generation, b8 overflow);

    void reopenParent()noexcept{ m_parent.close(); m_parent.open(); }

    void expectParentControls()const;


public:
    PopupState m_parent;
    PopupState m_child;
    Array<PopupState, 4u> m_deeper;
    ComboState m_childCombo;
    ContextMenuState m_menu;
    PopupToolsSource m_menuSource;
    ContextMenuResult m_menuResult;
    b8 m_childVisible = false;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


