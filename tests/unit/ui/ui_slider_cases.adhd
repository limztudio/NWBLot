void VerifyUiSliderBehaviorTests_AdmissionKeepsAnExternalOutOfRangeValueUntilAcceptedInput(mut UiSliderBehaviorTests self){
    ASSERT_TRUE(self.set(20.0));
    EXPECT_EQ(self.m_state.value(), 20.0);
    EXPECT_FLOAT_EQ(self.m_placement.thumb.x, 222.0f);
    ASSERT_TRUE(UiSliderApply(self.m_options, self.key(ControlActionKind::Left), self.m_state, self.m_result));
    EXPECT_DOUBLE_EQ(self.m_state.value(), 0.99);
    EXPECT_TRUE(self.m_result.valueChanged);
}

void VerifyUiSliderBehaviorTests_PolicyAndStableGeometryChangesRetirePreviouslyCopiedInput(mut UiSliderBehaviorTests self){
    const ControlAction stale = self.key(ControlActionKind::Right);
    const u64 input = self.m_state.inputGeneration();
    const u64 first = self.m_state.admissionGeneration();
    self.m_options.keyStep = 0.1;
    ASSERT_TRUE(self.refresh());
    EXPECT_GT(self.m_state.admissionGeneration(), first);
    EXPECT_EQ(self.m_state.inputGeneration(), input);
    const SliderSnapshot before = self.m_state.snapshot();
    const SliderResult result = self.m_result;
    EXPECT_FALSE(UiSliderApply(self.m_options, stale, self.m_state, self.m_result));
    EXPECT_TRUE(self.m_state.matches(before));
    ExpectUiSliderResult(self.m_result, result);
    const u64 policy = self.m_state.admissionGeneration();
    self.m_bounds.width = 280.0f;
    ASSERT_TRUE(self.refresh());
    EXPECT_GT(self.m_state.admissionGeneration(), policy);
    SliderPlacement clipped = self.m_placement;
    clipped.clip.width = 100.0f;
    const u64 geometry = self.m_state.admissionGeneration();
    ASSERT_TRUE(UiSliderAdmit(self.m_state, self.m_options, clipped));
    EXPECT_GT(self.m_state.admissionGeneration(), geometry);
}

void VerifyUiSliderBehaviorTests_ExactSignedZeroPolicyChangesAdvanceAdmissionWithoutChangingTheValue(mut UiSliderBehaviorTests self){
    const SliderSnapshot before = self.m_state.snapshot();
    self.m_options.minimum = bit_cast<f64>(s_UiSliderNegZeroF64Bits);
    ASSERT_TRUE(self.refresh());
    EXPECT_GT(self.m_state.admissionGeneration(), before.admissionGeneration);
    EXPECT_EQ(bit_cast<u64>(self.m_state.value()), before.valueBits);
    const u64 range = self.m_state.admissionGeneration();
    self.m_options.keyStep = bit_cast<f64>(s_UiSliderNegZeroF64Bits);
    ASSERT_TRUE(self.refresh());
    EXPECT_GT(self.m_state.admissionGeneration(), range);
}

void VerifyUiSliderBehaviorTests_PublicIdenticalAndAwayBackIntentsRejectOldCopiedActionsAtomically(mut UiSliderBehaviorTests self){
    ASSERT_TRUE(self.set(0.25));
    const ControlAction stale = self.key(ControlActionKind::Right);
    ASSERT_TRUE(self.m_state.setValue(0.25));
    SliderSnapshot before = self.m_state.snapshot();
    EXPECT_FALSE(UiSliderApply(self.m_options, stale, self.m_state, self.m_result));
    EXPECT_TRUE(self.m_state.matches(before));
    EXPECT_FALSE(self.m_result.valid);
    ASSERT_TRUE(self.m_state.setValue(0.5));
    ASSERT_TRUE(self.m_state.setValue(0.25));
    before = self.m_state.snapshot();
    EXPECT_FALSE(UiSliderApply(self.m_options, stale, self.m_state, self.m_result));
    EXPECT_TRUE(self.m_state.matches(before));
    EXPECT_FALSE(self.m_result.valid);
}

void VerifyUiSliderBehaviorTests_AutomaticStepsRemainFiniteAcrossOppositeExtremeBounds(mut UiSliderBehaviorTests self){
    self.m_options.minimum = -f64.max;
    self.m_options.maximum = f64.max;
    ASSERT_TRUE(self.set(0.0));
    ASSERT_TRUE(UiSliderApply(self.m_options, self.key(ControlActionKind::Right), self.m_state, self.m_result));
    EXPECT_TRUE(IsFinite(self.m_state.value()));
    EXPECT_GT(self.m_state.value(), 0.0);
    EXPECT_NEAR(self.m_state.value() / f64.max, 0.02, 1.0e-15);
    ASSERT_TRUE(UiSliderApply(self.m_options, self.key(ControlActionKind::PageUp), self.m_state, self.m_result));
    EXPECT_TRUE(IsFinite(self.m_state.value()));
    EXPECT_NEAR(self.m_state.value() / f64.max, 0.22, 1.0e-15);
}

void VerifyUiSliderBehaviorTests_AutomaticSubnormalStepUsesTheRepresentableSpanWhenDivisionUnderflows(mut UiSliderBehaviorTests self){
    self.m_options.maximum = bit_cast<f64>(cast<u64>(1u));
    ASSERT_TRUE(self.refresh());
    ASSERT_TRUE(UiSliderApply(self.m_options, self.key(ControlActionKind::Right), self.m_state, self.m_result));
    EXPECT_EQ(bit_cast<u64>(self.m_state.value()), 1u);
    ASSERT_TRUE(UiSliderApply(self.m_options, self.key(ControlActionKind::Left), self.m_state, self.m_result));
    EXPECT_EQ(bit_cast<u64>(self.m_state.value()), 0u);
}

void VerifyUiSliderBehaviorTests_ExplicitExtremeStepsAndPageIterationSaturateWithoutOverflow(mut UiSliderBehaviorTests self){
    self.m_options.minimum = -f64.max;
    self.m_options.maximum = f64.max;
    self.m_options.keyStep = f64.max;
    ASSERT_TRUE(self.refresh());
    ASSERT_TRUE(UiSliderApply(self.m_options, self.key(ControlActionKind::PageUp), self.m_state, self.m_result));
    EXPECT_EQ(bit_cast<u64>(self.m_state.value()), bit_cast<u64>(self.m_options.maximum));
    ASSERT_TRUE(UiSliderApply(self.m_options, self.key(ControlActionKind::PageDown), self.m_state, self.m_result));
    EXPECT_EQ(bit_cast<u64>(self.m_state.value()), bit_cast<u64>(self.m_options.minimum));
    ASSERT_TRUE(UiSliderApply(self.m_options, self.key(ControlActionKind::Right), self.m_state, self.m_result));
    EXPECT_EQ(self.m_state.value(), 0.0);
}

void VerifyUiSliderBehaviorTests_DisabledAndConstantRangesAreValidWithoutApplyingInput(mut UiSliderBehaviorTests self){
    self.m_options.enabled = false;
    ASSERT_TRUE(self.set(0.25));
    SliderSnapshot before = self.m_state.snapshot();
    ASSERT_TRUE(UiSliderApply(self.m_options, self.key(ControlActionKind::Right), self.m_state, self.m_result));
    EXPECT_TRUE(self.m_state.matches(before));
    EXPECT_TRUE(self.m_result.valid);
    EXPECT_FALSE(self.m_result.valueChanged);
    self.m_options.enabled = true;
    self.m_options.minimum = 5.0;
    self.m_options.maximum = 5.0;
    ASSERT_TRUE(self.refresh());
    before = self.m_state.snapshot();
    ASSERT_TRUE(UiSliderSeek(self.m_options, self.gesture(false), self.m_state, self.m_result));
    EXPECT_TRUE(self.m_state.matches(before));
    EXPECT_EQ(self.m_state.value(), 0.25);
    EXPECT_FALSE(self.m_result.dragging);
}

void VerifyUiSliderBehaviorTests_SubmitActivationAndWheelLeaveTheValueAndSemanticSnapshotUnchanged(mut UiSliderBehaviorTests self){
    ASSERT_TRUE(self.set(bit_cast<f64>(s_UiSliderNegZeroF64Bits)));
    const SliderSnapshot before = self.m_state.snapshot();
    Array<ControlActionKindEnum, 3u> kinds;
    kinds[0u] = ControlActionKind::Submit;
    kinds[1u] = ControlActionKind::Activate;
    kinds[2u] = ControlActionKind::Wheel;
    for(in ControlActionKindEnum kind : kinds){
        ASSERT_TRUE(UiSliderApply(self.m_options, self.key(kind), self.m_state, self.m_result));
        EXPECT_TRUE(self.m_state.matches(before));
        EXPECT_TRUE(self.m_result.valid);
        EXPECT_FALSE(self.m_result.valueChanged);
    }
}

void VerifyUiSliderBehaviorTests_InvalidPolicyTokenAndUnadmittedInputPreserveStateAndResult(mut UiSliderBehaviorTests self){
    const SliderSnapshot before = self.m_state.snapshot();
    const SliderResult result = MakeUiSliderResult(true, true, true, true);
    self.m_result = result;
    ControlAction action = self.key(ControlActionKind::Right);
    ++action.control.contentGeneration;
    EXPECT_FALSE(UiSliderApply(self.m_options, action, self.m_state, self.m_result));
    EXPECT_TRUE(self.m_state.matches(before));
    ExpectUiSliderResult(self.m_result, result);
    SliderOptions invalid = self.m_options;
    invalid.keyStep = -1.0;
    EXPECT_FALSE(UiSliderApply(invalid, self.key(ControlActionKind::Right), self.m_state, self.m_result));
    EXPECT_TRUE(self.m_state.matches(before));
    ExpectUiSliderResult(self.m_result, result);
    SliderState unadmitted = SliderState();
    action.control = unadmitted.controlToken();
    const SliderSnapshot unknown = unadmitted.snapshot();
    EXPECT_FALSE(UiSliderApply(self.m_options, action, unadmitted, self.m_result));
    EXPECT_TRUE(unadmitted.matches(unknown));
    ExpectUiSliderResult(self.m_result, result);
}

void VerifyUiSliderBehaviorTests_InvalidAdmissionGeometryOrOptionsPreserveThePreviousBinding(mut UiSliderBehaviorTests self){
    const SliderSnapshot before = self.m_state.snapshot();
    SliderPlacement invalid = self.m_placement;
    invalid.track.width = bit_cast<f32>(s_UiSliderPosInfF32Bits);
    EXPECT_FALSE(UiSliderAdmit(self.m_state, self.m_options, invalid));
    EXPECT_TRUE(self.m_state.matches(before));
    SliderOptions policy = self.m_options;
    policy.minimum = 2.0;
    EXPECT_FALSE(UiSliderAdmit(self.m_state, policy, self.m_placement));
    EXPECT_TRUE(self.m_state.matches(before));
    invalid = self.m_placement;
    invalid.thumbExtent.x = invalid.travelBounds.width + 1.0f;
    EXPECT_FALSE(UiSliderAdmit(self.m_state, self.m_options, invalid));
    EXPECT_TRUE(self.m_state.matches(before));
}

void VerifyUiSliderBehaviorTests_TrackSeekUsesAbsoluteAcceptedCenterTravelAndExactEndpoints(mut UiSliderBehaviorTests self){
    PointerGesture seek = self.gesture(false);
    seek.position.x = -f32.max;
    ASSERT_TRUE(UiSliderSeek(self.m_options, seek, self.m_state, self.m_result));
    EXPECT_EQ(bit_cast<u64>(self.m_state.value()), bit_cast<u64>(self.m_options.minimum));
    seek.position.x = f32.max;
    seek.state = PointerGestureState::Completed;
    ASSERT_TRUE(UiSliderSeek(self.m_options, seek, self.m_state, self.m_result));
    EXPECT_EQ(bit_cast<u64>(self.m_state.value()), bit_cast<u64>(self.m_options.maximum));
    EXPECT_FALSE(self.m_result.dragging);
}

void VerifyUiSliderBehaviorTests_TrackSeekRejectsAChangedCopiedReferenceWithoutPublishingResult(mut UiSliderBehaviorTests self){
    PointerGesture seek = self.gesture(false);
    seek.referenceRectangle.x = seek.referenceRectangle.x + 1.0f;
    const SliderSnapshot before = self.m_state.snapshot();
    const SliderResult result = self.m_result;
    EXPECT_FALSE(UiSliderSeek(self.m_options, seek, self.m_state, self.m_result));
    EXPECT_TRUE(self.m_state.matches(before));
    ExpectUiSliderResult(self.m_result, result);
}

void VerifyUiSliderBehaviorTests_RepeatedThumbUpdatesUseOriginalCopiedBaselineWithoutAccumulatingDelta(mut UiSliderBehaviorTests self){
    ASSERT_TRUE(self.set(0.25));
    PointerGesture drag = self.gesture();
    const f32 widthGap = drag.referenceRectangle.width - drag.targetRectangle.width;
    drag.position.x = widthGap * 0.25f + drag.position.x;
    ASSERT_TRUE(UiSliderDrag(self.m_options, drag, self.m_state, self.m_result));
    EXPECT_DOUBLE_EQ(self.m_state.value(), 0.5);
    drag.position.x = widthGap * 0.25f + drag.position.x;
    ++drag.updateSequence;
    ASSERT_TRUE(UiSliderDrag(self.m_options, drag, self.m_state, self.m_result));
    EXPECT_DOUBLE_EQ(self.m_state.value(), 0.75);
}

void VerifyUiSliderBehaviorTests_AStationaryThumbCompletionPreservesAnOrderedKeyChange(mut UiSliderBehaviorTests self){
    self.m_options.keyStep = 0.125;
    ASSERT_TRUE(self.set(0.25));
    PointerGesture drag = self.gesture();
    ASSERT_TRUE(UiSliderDrag(self.m_options, drag, self.m_state, self.m_result));
    EXPECT_FALSE(self.m_result.valueChanged);
    ASSERT_TRUE(UiSliderApply(self.m_options, self.key(ControlActionKind::Right, 13u), self.m_state, self.m_result));
    EXPECT_DOUBLE_EQ(self.m_state.value(), 0.375);
    drag.state = PointerGestureState::Completed;
    ++drag.updateSequence;
    ASSERT_TRUE(UiSliderDrag(self.m_options, drag, self.m_state, self.m_result));
    EXPECT_DOUBLE_EQ(self.m_state.value(), 0.375);
    EXPECT_FALSE(self.m_result.dragging);
    EXPECT_FALSE(self.m_state.snapshot().press.valid());
}

void VerifyUiSliderBehaviorTests_ReturningAfterAnAppliedMoveRestoresTheExactSignedZeroBaseline(mut UiSliderBehaviorTests self){
    self.m_options.minimum = -1.0;
    ASSERT_TRUE(self.set(bit_cast<f64>(s_UiSliderNegZeroF64Bits)));
    PointerGesture drag = self.gesture();
    const f32 widthGap = drag.referenceRectangle.width - drag.targetRectangle.width;
    drag.position.x = widthGap * 0.25f + drag.position.x;
    ASSERT_TRUE(UiSliderDrag(self.m_options, drag, self.m_state, self.m_result));
    EXPECT_DOUBLE_EQ(self.m_state.value(), 0.5);
    EXPECT_TRUE(self.m_state.snapshot().pressMoved);
    drag.position = drag.origin;
    drag.state = PointerGestureState::Completed;
    ++drag.updateSequence;
    ASSERT_TRUE(UiSliderDrag(self.m_options, drag, self.m_state, self.m_result));
    EXPECT_EQ(bit_cast<u64>(self.m_state.value()), s_UiSliderNegZeroF64Bits);
    EXPECT_FALSE(self.m_state.snapshot().pressMoved);
}

void VerifyUiSliderBehaviorTests_ANewStationaryPressDoesNotBorrowTheOldPressMovedFlag(mut UiSliderBehaviorTests self){
    ASSERT_TRUE(self.set(0.25));
    PointerGesture first = self.gesture();
    first.position.x = first.position.x + 52.0f;
    ASSERT_TRUE(UiSliderDrag(self.m_options, first, self.m_state, self.m_result));
    EXPECT_DOUBLE_EQ(self.m_state.value(), 0.5);
    PointerGesture second = first;
    ++second.id.sequence;
    ++second.updateSequence;
    second.position = second.origin;
    second.state = PointerGestureState::Completed;
    ASSERT_TRUE(UiSliderDrag(self.m_options, second, self.m_state, self.m_result));
    EXPECT_DOUBLE_EQ(self.m_state.value(), 0.5);
}

void VerifyUiSliderBehaviorTests_AdmissionRetirementEndsThePressAndKeepsItsLastAppliedValue(mut UiSliderBehaviorTests self){
    ASSERT_TRUE(self.set(0.25));
    PointerGesture drag = self.gesture();
    drag.position.x = drag.position.x + 52.0f;
    ASSERT_TRUE(UiSliderDrag(self.m_options, drag, self.m_state, self.m_result));
    EXPECT_DOUBLE_EQ(self.m_state.value(), 0.5);
    self.m_options.enabled = false;
    ASSERT_TRUE(self.refresh());
    EXPECT_DOUBLE_EQ(self.m_state.value(), 0.5);
    EXPECT_FALSE(self.m_state.snapshot().press.valid());
    EXPECT_FALSE(self.m_state.snapshot().pressMoved);
    const SliderSnapshot before = self.m_state.snapshot();
    EXPECT_FALSE(UiSliderDrag(self.m_options, drag, self.m_state, self.m_result));
    EXPECT_TRUE(self.m_state.matches(before));
}

void VerifyUiSliderBehaviorTests_ThumbDisplacementCastsBeforeSubtractingExtremeFloatCoordinates(mut UiSliderBehaviorTests self){
    PointerGesture drag = self.gesture();
    drag.origin.x = -f32.max;
    drag.position.x = f32.max;
    ASSERT_TRUE(UiSliderDrag(self.m_options, drag, self.m_state, self.m_result));
    EXPECT_EQ(bit_cast<u64>(self.m_state.value()), bit_cast<u64>(self.m_options.maximum));
    drag.origin.x = f32.max;
    drag.position.x = -f32.max;
    ++drag.updateSequence;
    ASSERT_TRUE(UiSliderDrag(self.m_options, drag, self.m_state, self.m_result));
    EXPECT_EQ(bit_cast<u64>(self.m_state.value()), bit_cast<u64>(self.m_options.minimum));
}

void VerifyUiSliderBehaviorTests_InvalidThumbPayloadGeometryOrTokenIsRejectedAtomically(mut UiSliderBehaviorTests self){
    ASSERT_TRUE(self.set(bit_cast<f64>(s_UiSliderNegZeroF64Bits)));
    const SliderSnapshot before = self.m_state.snapshot();
    self.m_result = MakeUiSliderResult(true, true, true, true);
    const SliderResult result = self.m_result;
    for(u32 field = 0u; field < 7u; ++field){
        PointerGesture drag = self.gesture();
        switch(field){
        case 0u:
            drag.value = s_UiSliderQuietNaNF64Bits;
            break;
        case 1u:
            ++drag.control.instanceGeneration;
            break;
        case 2u:
            drag.targetRectangle.width = drag.targetRectangle.width + 1.0f;
            break;
        case 3u:
            drag.referenceRectangle.x = drag.referenceRectangle.x + 1.0f;
            break;
        case 4u:
            drag.position.x = bit_cast<f32>(s_UiSliderPosInfF32Bits);
            break;
        case 5u:
            drag.id.sequence = 0u;
            break;
        default:
            drag.updateSequence = 0u;
            break;
        }
        EXPECT_FALSE(UiSliderDrag(self.m_options, drag, self.m_state, self.m_result));
        EXPECT_TRUE(self.m_state.matches(before));
        ExpectUiSliderResult(self.m_result, result);
    }
}

void VerifyUiSliderBehaviorTests_AClampedNonzeroMoveStillRestoresItsBaselineWhenReturningAfterAKeyChange(mut UiSliderBehaviorTests self){
    self.m_options.keyStep = 0.125;
    ASSERT_TRUE(self.set(1.0));
    PointerGesture drag = self.gesture();
    drag.position.x = drag.position.x + 20.0f;
    ASSERT_TRUE(UiSliderDrag(self.m_options, drag, self.m_state, self.m_result));
    EXPECT_FALSE(self.m_result.valueChanged);
    EXPECT_TRUE(self.m_state.snapshot().pressMoved);
    ASSERT_TRUE(UiSliderApply(self.m_options, self.key(ControlActionKind::Left), self.m_state, self.m_result));
    EXPECT_DOUBLE_EQ(self.m_state.value(), 0.875);
    drag.position = drag.origin;
    drag.state = PointerGestureState::Completed;
    ASSERT_TRUE(UiSliderDrag(self.m_options, drag, self.m_state, self.m_result));
    EXPECT_DOUBLE_EQ(self.m_state.value(), 1.0);
}


