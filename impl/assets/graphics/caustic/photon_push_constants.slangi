#ifndef NWB_GRAPHICS_CAUSTIC_PHOTON_PUSH_CONSTANTS_SLANGI
#define NWB_GRAPHICS_CAUSTIC_PHOTON_PUSH_CONSTANTS_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "photon_push_constants.h"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// The C++ producer materializes the same field list as u32 members. Slang needs the exact same 15 scalar words in its
// push block, but the default values are CPU-side construction details and intentionally do not participate here.
struct NwbCausticPhotonPushConstants{
#define NWB_CAUSTIC_PHOTON_PUSH_CONSTANT_FIELD(name, defaultValue) uint name;
    NWB_CAUSTIC_PHOTON_PUSH_CONSTANTS_FIELDS(NWB_CAUSTIC_PHOTON_PUSH_CONSTANT_FIELD)
#undef NWB_CAUSTIC_PHOTON_PUSH_CONSTANT_FIELD
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

