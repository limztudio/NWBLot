using GpuCompiledGraphReadView = Core::GpuCompiledGraph::ReadView;
using GpuCompiledBarrierTypeEnum = Core::GpuCompiledBarrierType::Enum;
using GpuResourceStatesMask = Core::ResourceStates::Mask;
using GpuResourceAccessEnum = Core::GpuTaskResourceAccess::Enum;
using GpuResourceQueueSharingMask = Core::ResourceQueueSharing::Mask;
using GpuScopedTrace = ::NWB::Tests::ScopedTestTrace;

struct GpuBarrierCallbackInvocationState{
    Vector<u32, Core::Alloc::ScratchArena>* order = nullptr;
    u64 count = 0u;
};

struct GpuBarrierCallbackContext{
    GpuBarrierCallbackInvocationState& state;
    u32 taskIndex = 0u;
};

inline constexpr u64 s_GpuBarrierAcceptedTokenValue = 7u;

FOUNDATION_INLINE void GpuBarrierRecordInvocation(GpuBarrierCallbackContext& context){
    ++context.state.count;
    if(context.state.order)
        context.state.order->push_back(context.taskIndex);
}

FOUNDATION_INLINE b8 GpuBarrierInvokeRecorded(void* const context, const Core::CommandListResourceStateHandoff*){
    GpuBarrierRecordInvocation(*MakeNotNull(static_cast<GpuBarrierCallbackContext*>(context)));
    return true;
}

FOUNDATION_INLINE b8 GpuBarrierInvokeAccepted(void* const context, const Core::QueueSubmissionToken& token){
    if(token.value != s_GpuBarrierAcceptedTokenValue)
        return false;
    GpuBarrierRecordInvocation(*MakeNotNull(static_cast<GpuBarrierCallbackContext*>(context)));
    return true;
}

template<typename Callback>
[[nodiscard]] FOUNDATION_INLINE Callback GpuBarrierMakeCallback(const Core::GpuTaskId task, GpuBarrierCallbackContext& context){
    if constexpr(IsSame_V<Callback, Core::GpuTaskGraphTaskRecordedCallback>)
        return Callback{ .task = task, .context = &context, .invoke = GpuBarrierInvokeRecorded };
    else
        return Callback{ .task = task, .context = &context, .invoke = GpuBarrierInvokeAccepted };
}

template<typename Callback>
[[nodiscard]] FOUNDATION_INLINE b8 GpuBarrierInvokeBoundCallback(const Callback& callback){
    if constexpr(IsSame_V<Callback, Core::GpuTaskGraphTaskRecordedCallback>)
        return callback.invoke(callback.context, nullptr);
    else{
        const Core::QueueSubmissionToken token{ .value = s_GpuBarrierAcceptedTokenValue, .queue = Core::CommandQueue::Graphics };
        return callback.invoke(callback.context, token);
    }
}

FOUNDATION_INLINE void CheckReorderedCallbackBindings(
    const Core::GpuTaskGraph::DeclarationReadView& declarations,
    const Core::GpuCompiledGraph::ReadView& plan,
    Span<const Core::GpuTaskId> tasks,
    const usize callbackCount,
    const b8 recordedKind,
    Core::Alloc::ScratchArena& scratch
){
    const auto runForType = [&]<typename Callback>(){
        Vector<u32, Core::Alloc::ScratchArena> order(scratch);
        order.reserve(callbackCount);
        GpuBarrierCallbackInvocationState state{ .order = &order };
        Vector<GpuBarrierCallbackContext, Core::Alloc::ScratchArena> contexts(scratch);
        Vector<Callback, Core::Alloc::ScratchArena> callbacks(scratch);
        contexts.reserve(callbackCount);
        callbacks.reserve(callbackCount);
        for(usize index = 0u; index < callbackCount; ++index){
            const Core::GpuTaskId task = tasks[callbackCount - 1u - index];
            contexts.push_back(GpuBarrierCallbackContext{ .state = state, .taskIndex = task.index });
            callbacks.push_back(GpuBarrierMakeCallback<Callback>(task, contexts.back()));
        }
        Core::GpuTaskSubmissionDetail::TaskCallbackBindings<Callback> bindings(scratch);
        ASSERT_TRUE(bindings.resolve(declarations, plan, plan.allPacketRange(), callbacks.data(), callbacks.size()));
        const ArenaMemoryStats before = scratch.memoryStats();
        for(const Core::GpuTaskId task : tasks){
            const Callback* const callback = bindings.find(task);
            ASSERT_NE(callback, nullptr);
            ASSERT_TRUE(GpuBarrierInvokeBoundCallback(*callback));
        }
        ExpectMemoryStatsEqual(before, scratch.memoryStats());
        ASSERT_EQ(order.size(), callbackCount);
        for(usize index = 0u; index < callbackCount; ++index)
            EXPECT_EQ(order[index], tasks[index].index);
        EXPECT_EQ(state.count, callbackCount);
        Core::GpuTaskId stale = tasks.front();
        ++stale.generation;
        EXPECT_EQ(bindings.find(stale), nullptr);
        EXPECT_EQ(bindings.find({}), nullptr);
    };
    if(recordedKind)
        runForType.template operator()<Core::GpuTaskGraphTaskRecordedCallback>();
    else
        runForType.template operator()<Core::GpuTaskGraphTaskAcceptedCallback>();
}

FOUNDATION_INLINE void CheckInvalidCallbackBindings(
    const Core::GpuTaskGraph::DeclarationReadView& declarations,
    const Core::GpuCompiledGraph::ReadView& plan,
    const Core::GpuSubmissionPacketRange& range,
    Span<const Core::GpuTaskId> tasks,
    const usize callbackCount,
    const b8 recordedKind,
    Core::Alloc::ScratchArena& scratch
){
    const auto runForType = [&]<typename Callback>(){
        GpuBarrierCallbackInvocationState state{};
        Vector<GpuBarrierCallbackContext, Core::Alloc::ScratchArena> contexts(scratch);
        Vector<Callback, Core::Alloc::ScratchArena> callbacks(scratch);
        contexts.reserve(callbackCount);
        callbacks.reserve(callbackCount);
        for(usize index = 0u; index < callbackCount; ++index){
            const Core::GpuTaskId task = tasks[index];
            contexts.push_back(GpuBarrierCallbackContext{ .state = state, .taskIndex = task.index });
            callbacks.push_back(GpuBarrierMakeCallback<Callback>(task, contexts.back()));
        }
        Core::GpuTaskSubmissionDetail::TaskCallbackBindings<Callback> bindings(scratch);
        const Callback saved = callbacks.back();
        const auto expectRejectedAndReset = [&](){
            EXPECT_FALSE(bindings.resolve(declarations, plan, range, callbacks.data(), callbacks.size()));
            EXPECT_EQ(bindings.find(callbacks.front().task), nullptr);
            callbacks.back() = saved;
            EXPECT_TRUE(bindings.resolve(declarations, plan, range, callbacks.data(), callbacks.size()));
            EXPECT_NE(bindings.find(saved.task), nullptr);
        };
        ASSERT_TRUE(bindings.resolve(declarations, plan, range, callbacks.data(), callbacks.size()));
        callbacks.back().task = callbacks.front().task;
        expectRejectedAndReset();
        ++callbacks.back().task.generation;
        expectRejectedAndReset();
        callbacks.back().invoke = nullptr;
        expectRejectedAndReset();
        callbacks.back().task = tasks.back();
        expectRejectedAndReset();
        callbacks.back().task.index = static_cast<u32>(tasks.size());
        expectRejectedAndReset();
        EXPECT_EQ(bindings.find(tasks.back()), nullptr);
        EXPECT_FALSE(bindings.resolve(declarations, plan, range, static_cast<const Callback*>(nullptr), callbackCount));
        EXPECT_EQ(bindings.find(saved.task), nullptr);
        EXPECT_TRUE(bindings.resolve(declarations, plan, range, static_cast<const Callback*>(nullptr), 0u));
        EXPECT_EQ(bindings.find(saved.task), nullptr);
        const ArenaMemoryStats beforeOversized = scratch.memoryStats();
        EXPECT_FALSE(bindings.resolve(declarations, plan, range, callbacks.data(), Limit<usize>::s_Max));
        EXPECT_FALSE(bindings.resolve(declarations, plan, range, callbacks.data(), tasks.size() + 1u));
        ExpectMemoryStatsEqual(beforeOversized, scratch.memoryStats());
        EXPECT_EQ(bindings.find(saved.task), nullptr);
        EXPECT_FALSE(bindings.resolve(declarations, plan, {}, callbacks.data(), callbacks.size()));
        EXPECT_EQ(bindings.find(saved.task), nullptr);
    };
    if(recordedKind)
        runForType.template operator()<Core::GpuTaskGraphTaskRecordedCallback>();
    else
        runForType.template operator()<Core::GpuTaskGraphTaskAcceptedCallback>();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


