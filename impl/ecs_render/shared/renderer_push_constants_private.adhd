namespace ECSRenderDetail{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static_assert(sizeof(MeshFrameHeapSlots) == sizeof(u32) * NWB_MESH_FRAME_HEAP_SLOT_COUNT, "Mesh frame heap-slot payload must stay a uint4");
static_assert(offsetof(MeshFrameHeapSlots, instance) == sizeof(u32) * NWB_MESH_FRAME_HEAP_SLOT_INSTANCE, "Instance heap slot must map to frame heap lane x");
static_assert(offsetof(MeshFrameHeapSlots, materialTyped) == sizeof(u32) * NWB_MESH_FRAME_HEAP_SLOT_MATERIAL_TYPED, "Material heap slot must map to frame heap lane y");
static_assert(offsetof(MeshFrameHeapSlots, view) == sizeof(u32) * NWB_MESH_FRAME_HEAP_SLOT_VIEW, "View heap slot must map to frame heap lane z");
static_assert(offsetof(MeshFrameHeapSlots, generatedVertex) == sizeof(u32) * NWB_MESH_FRAME_HEAP_SLOT_GENERATED_VERTEX, "Generated-vertex heap slot must map to frame heap lane w");
static_assert(sizeof(ShaderDrivenPushConstants) == NWB_MESH_PUSH_CONSTANT_BYTE_SIZE, "ShaderDrivenPushConstants layout must stay stable");
static_assert(offsetof(ShaderDrivenPushConstants, meshletCount) == sizeof(u32) * NWB_MESH_PUSH_DISPATCH_MESHLET_COUNT, "ShaderDrivenPushConstants dispatch.x must be meshlet count");
static_assert(offsetof(ShaderDrivenPushConstants, instanceIndex) == sizeof(u32) * NWB_MESH_PUSH_DISPATCH_INSTANCE_INDEX, "ShaderDrivenPushConstants dispatch.y must be instance index");
static_assert(offsetof(ShaderDrivenPushConstants, materialConstantByteOffset) == sizeof(u32) * NWB_MESH_PUSH_DISPATCH_MATERIAL_CONSTANT_BYTE_OFFSET, "ShaderDrivenPushConstants dispatch.z must be material constant byte offset");
static_assert(offsetof(ShaderDrivenPushConstants, dispatchFlags) == sizeof(u32) * NWB_MESH_PUSH_DISPATCH_FLAGS, "ShaderDrivenPushConstants dispatch.w must be dispatch flags");
static_assert(offsetof(ShaderDrivenPushConstants, frameHeapSlots) == sizeof(u32) * NWB_MESH_PUSH_FRAME_HEAP_SLOT_WORD_OFFSET, "ShaderDrivenPushConstants frame heap slots must follow the viewport lanes");
static_assert(sizeof(MeshComputePushConstants) == NWB_MESH_COMPUTE_PUSH_CONSTANT_BYTE_SIZE);
static_assert(offsetof(MeshComputePushConstants, generatedIndexByteOffset) == NWB_MESH_COMPUTE_INDEX_BYTE_OFFSET);
static_assert(sizeof(MeshComputePushConstants) <= Core::s_MaxPushConstantSize);
static_assert(sizeof(TransparentDrawPushConstants) == NWB_AVBOIT_DRAW_PUSH_CONSTANT_BYTE_SIZE, "TransparentDrawPushConstants layout must stay stable");
static_assert(sizeof(TransparentDrawPushConstants) <= Core::s_MaxPushConstantSize, "Transparent draw push constants must fit the portable push constant budget");
static_assert(sizeof(EmulatedVertex) == s_EmulatedVertexStride, "EmulatedVertex layout must match the mesh emulation shader");
static_assert(offsetof(EmulatedVertex, position) == NWB_MESH_EMULATION_VERTEX_POSITION_BYTE_OFFSET, "EmulatedVertex position offset must match the mesh emulation shader");
static_assert(offsetof(EmulatedVertex, normal) == NWB_MESH_EMULATION_VERTEX_NORMAL_BYTE_OFFSET, "EmulatedVertex normal offset must match the mesh emulation shader");
static_assert(offsetof(EmulatedVertex, tangent) == NWB_MESH_EMULATION_VERTEX_TANGENT_BYTE_OFFSET, "EmulatedVertex tangent offset must match the mesh emulation shader");
static_assert(offsetof(EmulatedVertex, uv0) == NWB_MESH_EMULATION_VERTEX_UV0_BYTE_OFFSET, "EmulatedVertex uv0 offset must match the mesh emulation shader");
static_assert(offsetof(EmulatedVertex, color) == NWB_MESH_EMULATION_VERTEX_COLOR_BYTE_OFFSET, "EmulatedVertex color offset must match the mesh emulation shader");
static_assert(offsetof(EmulatedVertex, worldPosition) == NWB_MESH_EMULATION_VERTEX_WORLD_POSITION_BYTE_OFFSET, "EmulatedVertex world-position offset must match the mesh emulation shader");
static_assert(alignof(EmulatedVertex) >= alignof(Float4), "EmulatedVertex must stay SIMD-aligned");
static_assert(sizeof(SceneShadingGpuData) == sizeof(f32) * NWB_SCENE_SHADING_BUFFER_FLOAT_COUNT, "SceneShadingGpuData layout must match the shading shaders");
static_assert(alignof(SceneShadingGpuData) >= alignof(Float4), "SceneShadingGpuData must stay SIMD-aligned");
static_assert(sizeof(SceneLightGpuData) == sizeof(f32) * NWB_SCENE_LIGHT_RECORD_FLOAT_COUNT, "SceneLightGpuData layout must match the shading shaders");
static_assert(alignof(SceneLightGpuData) >= alignof(Float4), "SceneLightGpuData must stay SIMD-aligned");
static_assert(s_EmulatedVertexBufferIndex == NWB_MESH_EMULATION_VERTEX_BUFFER_INDEX, "s_EmulatedVertexBufferIndex must match NWB_MESH_EMULATION_VERTEX_BUFFER_INDEX");


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


ShaderDrivenPushConstants BuildShaderDrivenPushConstants(
    in u32 meshletCount,
    in u32 instanceIndex,
    in u32 materialConstantByteOffset,
    in ViewportState viewportState,
    in MeshFrameHeapSlots frameHeapSlots,
    in u32 dispatchFlags
){
    const b8 hasViewport = !viewportState.viewports.empty();
    Viewport viewport = Viewport();
    Rect scissorRect = Rect();
    if(hasViewport){
        viewport = viewportState.viewports[0u];
        if(!viewportState.scissorRects.empty())
            scissorRect = viewportState.scissorRects[0u];
        else
            scissorRect = RectFromViewport(viewport);
    }
    return ResolveShaderDrivenPushConstants(
        meshletCount,
        instanceIndex,
        materialConstantByteOffset,
        hasViewport,
        VectorSingle(viewport.minX, viewport.minY, viewport.maxX, viewport.maxY),
        VectorSingle(cast<f32>(scissorRect.minX), cast<f32>(scissorRect.minY), cast<f32>(scissorRect.maxX), cast<f32>(scissorRect.maxY)),
        frameHeapSlots,
        dispatchFlags
    );
}

MeshFrameHeapSlots ResolveMeshFrameHeapSlots(in MeshFrameBindingSnapshot frameBindings, in u32 generatedVertex){
    assert(frameBindings.bindingValid());
    return MakeMeshFrameHeapSlots(
        frameBindings.instanceHeapHandle.slot(),
        frameBindings.materialTypedHeapHandle.slot(),
        frameBindings.meshView.heapHandle.slot(),
        generatedVertex
    );
}

MeshFrameHeapSlots ResolveMeshFrameHeapSlots(in MeshFrameBindingSnapshot frameBindings){
    return ResolveMeshFrameHeapSlots(frameBindings, 0u);
}

void SetShaderDrivenPushConstants(
    mut CommandList commandList,
    in u32 meshletCount,
    in u32 instanceIndex,
    in u32 materialConstantByteOffset,
    in ViewportState viewportState,
    in MeshFrameHeapSlots frameHeapSlots,
    in u32 dispatchFlags
){
    const ShaderDrivenPushConstants pushConstants = BuildShaderDrivenPushConstants(
        meshletCount,
        instanceIndex,
        materialConstantByteOffset,
        viewportState,
        frameHeapSlots,
        dispatchFlags
    );
    commandList.setPushConstants(pushConstants);
}

void SetTransparentDrawPushConstants(
    mut CommandList commandList,
    in u32 meshletCount,
    in u32 instanceIndex,
    in u32 materialConstantByteOffset,
    in ViewportState viewportState,
    in AvboitFrameTargets targets,
    in MeshFrameHeapSlots frameHeapSlots,
    in u32 dispatchFlags,
    in b8 hdr10OutputActive,
    in u32 csgContextHeapSlot,
    in b8 refractionCapture
){
    const TransparentDrawPushConstants pushConstants = ResolveTransparentDrawPushConstants(
        BuildShaderDrivenPushConstants(
            meshletCount,
            instanceIndex,
            materialConstantByteOffset,
            viewportState,
            frameHeapSlots,
            dispatchFlags
        ),
        BuildRendererAvboitPushConstants(targets, hdr10OutputActive),
        csgContextHeapSlot,
        refractionCapture
    );
    commandList.setPushConstants(pushConstants);
}

void SetTransparentDrawPushConstants(
    mut CommandList commandList,
    in u32 meshletCount,
    in u32 instanceIndex,
    in u32 materialConstantByteOffset,
    in ViewportState viewportState,
    in AvboitFrameTargets targets,
    in MeshFrameHeapSlots frameHeapSlots,
    in u32 dispatchFlags,
    in b8 hdr10OutputActive,
    in u32 csgContextHeapSlot
){
    SetTransparentDrawPushConstants(
        commandList,
        meshletCount,
        instanceIndex,
        materialConstantByteOffset,
        viewportState,
        targets,
        frameHeapSlots,
        dispatchFlags,
        hdr10OutputActive,
        csgContextHeapSlot,
        false
    );
}

void SetTransparentDrawPushConstants(
    mut CommandList commandList,
    in u32 meshletCount,
    in u32 instanceIndex,
    in u32 materialConstantByteOffset,
    in ViewportState viewportState,
    in AvboitFrameTargets targets,
    in MeshFrameHeapSlots frameHeapSlots,
    in u32 dispatchFlags,
    in b8 hdr10OutputActive
){
    SetTransparentDrawPushConstants(
        commandList,
        meshletCount,
        instanceIndex,
        materialConstantByteOffset,
        viewportState,
        targets,
        frameHeapSlots,
        dispatchFlags,
        hdr10OutputActive,
        0u,
        false
    );
}

void SetEmulatedVertexAttribute(in Format format, in u32 offsetByteCount, in Name name, mut VertexAttributeDesc attribute){
    attribute.setFormat(format).setBufferIndex(s_EmulatedVertexBufferIndex).setOffset(offsetByteCount).setElementStride(s_EmulatedVertexStride).setName(name);
}


