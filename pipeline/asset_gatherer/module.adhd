#include <utilities/cli/tool_cli.adhd>
#include <pipeline/command_line.adhd>
#include <pipeline/asset_gatherer/gather.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


i32 RunPipelineOptions(mut PipelineOptions options){
    AssetGatherOptions gather;
    gather.inputs = options.inputs;
    gather.outputDirectory = options.outputPath;
    gather.configuration = options.configuration;
    AssetCookWorkspace workspace(s_AssetGathererArena);
    gather.mergePayloads = RegisteredGatherMerge(workspace);
    if(GatherAssets(gather))
        return s_PipelineExitSuccess;
    return s_PipelineExitFailure;
}

i32 Run(in ConsoleArguments args){
    return RunPipelineTool(args, PipelineTool::AssetGatherer, RunPipelineOptions);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

