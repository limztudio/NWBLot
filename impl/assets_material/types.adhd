const u32 s_MaterialBinaryMagic = 0x4D544C41u; // MTLA
const usize s_MaterialShaderEntryBytes = 65u;
const usize s_MaterialTypedLayoutBlockBytes = 80u;
const usize s_MaterialTypedLayoutFieldBytes = 88u;
const usize s_MaterialResourceReferenceBytes = 200u;

const StringView s_MaterialAvboitAccumulatePassLabel = "accumulate";
const StringView s_MaterialAvboitOccupancyPassLabel = "occupancy";
const StringView s_MaterialAvboitExtinctionPassLabel = "extinction";

const StringView s_MeshComputeArchiveStageText = "mesh_compute";
const StringView s_MeshComputeImplicitDefineText = "NWB_MESH_SHADER_EMULATION_COMPUTE";
const Name s_MeshComputeArchiveStageName = "mesh_compute";

const StringView s_MaterialMetaInterfaceField = "interface";
const StringView s_MaterialMetaSurfaceField = "surface";
const StringView s_MaterialMetaShadersField = "shaders";
const StringView s_MaterialMetaShaderVariantField = "shader_variant";
const StringView s_MaterialMetaParametersField = "parameters";
const StringView s_MaterialMetaTransparentField = "transparent";
const StringView s_MaterialMetaTwoSidedField = "two_sided";
const StringView s_MaterialMetaRefractiveField = "refractive";
const StringView s_MaterialMetaBxdfField = "bxdf";

b8 IsAllowedMaterialAssetField(in StringView fieldName){
    switch(fieldName){
        case "interface":
        case "surface":
        case "shaders":
        case "shader_variant":
        case "parameters":
        case "transparent":
        case "two_sided":
        case "refractive":
        case "bxdf":
            return true;
        default:
            return false;
    }
}

[reflect]
enum<u32> MaterialFlag{
    enum None = 0u,
    flag Transparent,
    flag TwoSided,
    flag Refractive,
    enum All = Transparent | TwoSided | Refractive
}

[reflect]
enum<u32> MaterialParameterValueType{
    enum None = 0u,
    enum b8,
    enum i8,
    enum u8,
    enum i16,
    enum u16,
    enum i32,
    enum u32,
    enum f16,
    enum f32
}

[reflect]
enum<u32> MaterialBlockClass{
    enum None = 0u,
    enum MaterialConstant,
    enum MaterialMutable
}

b8 IsValidMaterialBlockClass(in MaterialBlockClass blockClass){
    return blockClass == MaterialBlockClass::Enum::MaterialConstant || blockClass == MaterialBlockClass::Enum::MaterialMutable;
}

[reflect]
enum<u32> MaterialResourceKind{
    enum None = 0u,
    enum SampledImage2D,
    enum Sampler
}

b8 IsValidMaterialResourceKind(in MaterialResourceKind resourceKind){
    return resourceKind == MaterialResourceKind::Enum::SampledImage2D || resourceKind == MaterialResourceKind::Enum::Sampler;
}

[reflect]
enum<u32> MaterialLayoutFieldType{
    enum None = 0u,
    enum b8,
    enum b8x2,
    enum b8x3,
    enum b8x4,
    enum i8,
    enum i8x2,
    enum i8x3,
    enum i8x4,
    enum u8,
    enum u8x2,
    enum u8x3,
    enum u8x4,
    enum i16,
    enum i16x2,
    enum i16x3,
    enum i16x4,
    enum u16,
    enum u16x2,
    enum u16x3,
    enum u16x4,
    enum i32,
    enum i32x2,
    enum i32x3,
    enum i32x4,
    enum u32,
    enum u32x2,
    enum u32x3,
    enum u32x4,
    enum f16,
    enum f16x2,
    enum f16x3,
    enum f16x4,
    enum f32,
    enum f32x2,
    enum f32x3,
    enum f32x4,
    // Resource fields occupy one patched uint heap slot in the typed-byte payload.
    // They intentionally live after the contiguous numeric range so a resource can never be mistaken for an authored uint parameter.
    enum SampledImage2D = 37u,
    enum Sampler
}

const u32 s_MaterialLayoutFieldComponentsPerValueType = 4u;
const u32 s_MaterialLayoutFieldFirstTypeId = cast<u32>(MaterialLayoutFieldType::Enum::b8);
const u32 s_MaterialParameterFirstValueTypeId = cast<u32>(MaterialParameterValueType::Enum::b8);

b8 IsValidMaterialLayoutFieldType(in MaterialLayoutFieldType fieldType){
    return cast<u32>(fieldType) >= cast<u32>(MaterialLayoutFieldType::Enum::b8) && cast<u32>(fieldType) <= cast<u32>(MaterialLayoutFieldType::Enum::Sampler);
}

b8 IsMaterialLayoutNumericFieldType(in MaterialLayoutFieldType fieldType){
    return cast<u32>(fieldType) >= cast<u32>(MaterialLayoutFieldType::Enum::b8) && cast<u32>(fieldType) <= cast<u32>(MaterialLayoutFieldType::Enum::f32x4);
}

b8 IsMaterialLayoutResourceFieldType(in MaterialLayoutFieldType fieldType){
    return fieldType == MaterialLayoutFieldType::Enum::SampledImage2D || fieldType == MaterialLayoutFieldType::Enum::Sampler;
}

MaterialResourceKind MaterialLayoutFieldResourceKind(in MaterialLayoutFieldType fieldType){
    switch(fieldType){
        case MaterialLayoutFieldType::Enum::SampledImage2D:
            return MaterialResourceKind::Enum::SampledImage2D;
        case MaterialLayoutFieldType::Enum::Sampler:
            return MaterialResourceKind::Enum::Sampler;
        default:
            return MaterialResourceKind::Enum::None;
    }
}

u32 MaterialLayoutFieldComponentCount(in MaterialLayoutFieldType fieldType){
    if(!IsMaterialLayoutNumericFieldType(fieldType)){
        return 0u;
    }

    return ((cast<u32>(fieldType) - s_MaterialLayoutFieldFirstTypeId) % s_MaterialLayoutFieldComponentsPerValueType) + 1u;
}

MaterialParameterValueType MaterialLayoutFieldValueType(in MaterialLayoutFieldType fieldType){
    if(!IsMaterialLayoutNumericFieldType(fieldType)){
        return MaterialParameterValueType::Enum::None;
    }

    const u32 valueTypeOffset = (cast<u32>(fieldType) - s_MaterialLayoutFieldFirstTypeId) / s_MaterialLayoutFieldComponentsPerValueType;
    return cast<MaterialParameterValueType>(s_MaterialParameterFirstValueTypeId + valueTypeOffset);
}

MaterialLayoutFieldType MaterialLayoutFieldTypeFromParameterType(in MaterialParameterValueType valueType, in u32 componentCount){
    if(componentCount == 0u || componentCount > s_MaterialLayoutFieldComponentsPerValueType){
        return MaterialLayoutFieldType::Enum::None;
    }

    u32 firstFieldType = 0u;
    switch(valueType){
        case MaterialParameterValueType::Enum::b8: firstFieldType = cast<u32>(MaterialLayoutFieldType::Enum::b8); break;
        case MaterialParameterValueType::Enum::i8: firstFieldType = cast<u32>(MaterialLayoutFieldType::Enum::i8); break;
        case MaterialParameterValueType::Enum::u8: firstFieldType = cast<u32>(MaterialLayoutFieldType::Enum::u8); break;
        case MaterialParameterValueType::Enum::i16: firstFieldType = cast<u32>(MaterialLayoutFieldType::Enum::i16); break;
        case MaterialParameterValueType::Enum::u16: firstFieldType = cast<u32>(MaterialLayoutFieldType::Enum::u16); break;
        case MaterialParameterValueType::Enum::i32: firstFieldType = cast<u32>(MaterialLayoutFieldType::Enum::i32); break;
        case MaterialParameterValueType::Enum::u32: firstFieldType = cast<u32>(MaterialLayoutFieldType::Enum::u32); break;
        case MaterialParameterValueType::Enum::f16: firstFieldType = cast<u32>(MaterialLayoutFieldType::Enum::f16); break;
        case MaterialParameterValueType::Enum::f32: firstFieldType = cast<u32>(MaterialLayoutFieldType::Enum::f32); break;
        default: return MaterialLayoutFieldType::Enum::None;
    }

    return cast<MaterialLayoutFieldType>(firstFieldType + componentCount - 1u);
}

u32 MaterialParameterValueTypeByteSize(in MaterialParameterValueType valueType){
    switch(valueType){
        case MaterialParameterValueType::Enum::b8:
        case MaterialParameterValueType::Enum::i8:
        case MaterialParameterValueType::Enum::u8:
            return 1u;
        case MaterialParameterValueType::Enum::i16:
        case MaterialParameterValueType::Enum::u16:
        case MaterialParameterValueType::Enum::f16:
            return 2u;
        case MaterialParameterValueType::Enum::i32:
        case MaterialParameterValueType::Enum::u32:
        case MaterialParameterValueType::Enum::f32:
            return 4u;
        default:
            return 0u;
    }
}

u32 MaterialLayoutFieldByteSize(in MaterialLayoutFieldType fieldType){
    if(IsMaterialLayoutResourceFieldType(fieldType)){
        return 4u;
    }

    return MaterialLayoutFieldComponentCount(fieldType) * MaterialParameterValueTypeByteSize(MaterialLayoutFieldValueType(fieldType));
}

u32 MaterialLayoutFieldAlignment(in MaterialLayoutFieldType fieldType){
    if(IsMaterialLayoutResourceFieldType(fieldType)){
        return 4u;
    }

    return MaterialParameterValueTypeByteSize(MaterialLayoutFieldValueType(fieldType));
}

[reflect]
class MaterialTypedLayoutBlock{
    public Name blockName = s_NameNone;
    public MaterialBlockClass blockClass = MaterialBlockClass::Enum::None;
    public u32 fieldBegin = 0u;
    public u32 fieldCount = 0u;
    public u32 byteSize = 0u;
}

[reflect]
class MaterialTypedLayoutField{
    public Name fieldName = s_NameNone;
    public MaterialLayoutFieldType fieldType = MaterialLayoutFieldType::Enum::None;
    public u32 offset = 0u;
    public u32x4u defaultValue;
}

// A cooked material separates resource identity from its numeric/default payload.
// `constantByteOffset` is the slot word the renderer patches after resolving the descriptor handle.
// Exactly one typed reference is valid.
[reflect]
class MaterialResourceReference{
    public Name blockName = s_NameNone;
    public Name fieldName = s_NameNone;
    public AssetRef<Texture> textureAsset;
    public AssetRef<Sampler> samplerAsset;
    public MaterialResourceKind resourceKind = MaterialResourceKind::Enum::None;
    public u32 constantByteOffset = 0u;
}

[serialize]
class MaterialTypedLayoutBlockBinary{
    public NameHash blockNameHash;
    public u32 blockClass = 0u;
    public u32 fieldBegin = 0u;
    public u32 fieldCount = 0u;
    public u32 byteSize = 0u;
}

[serialize]
class MaterialTypedLayoutFieldBinary{
    public NameHash fieldNameHash;
    public u32 fieldType = 0u;
    public u32 offset = 0u;
    public u32x4u defaultValue;
}

// Deserialization initializes the typed asset reference; runtime patches its resolved heap slot at constantByteOffset.
[serialize]
class MaterialResourceReferenceBinary{
    public NameHash blockNameHash;
    public NameHash fieldNameHash;
    public NameHash resourceNameHash;
    public u32 resourceKind = 0u;
    public u32 constantByteOffset = 0u;
}

b8 ComputeMaterialTypedBlockByteSize(in Span<MaterialTypedLayoutBlock> blocks, mut usize outByteSize){
    usize byteSize = 0u;
    for(usize b = 0u; b < blocks.size(); ++b){
        const usize blockBytes = cast<usize>(blocks[b].byteSize);
        if(blockBytes > 0xFFFFFFFFFFFFFFFFul - byteSize){
            outByteSize = 0u;
            return false;
        }
        byteSize += blockBytes;
    }
    outByteSize = byteSize;
    return true;
}

b8 ValidateMaterialResourceReferences(
    in Span<MaterialTypedLayoutBlock> blocks,
    in Span<MaterialTypedLayoutField> fields,
    in Span<MaterialResourceReference> resourceReferences
){
    usize resourceFieldCount = 0u;
    u32 constantByteBegin = 0u;
    for(usize b = 0u; b < blocks.size(); ++b){
        const MaterialTypedLayoutBlock block = blocks[b];
        if(!IsValidMaterialBlockClass(block.blockClass)){
            return false;
        }
        if(cast<usize>(block.fieldBegin) > fields.size() || cast<usize>(block.fieldCount) > fields.size() - cast<usize>(block.fieldBegin)){
            return false;
        }

        for(u32 fieldOffset = 0u; fieldOffset < block.fieldCount; ++fieldOffset){
            const MaterialTypedLayoutField field = fields[cast<usize>(block.fieldBegin) + cast<usize>(fieldOffset)];
            if(!IsMaterialLayoutResourceFieldType(field.fieldType)){
                continue;
            }

            // Descriptor slots are resolved during material preparation; instance overrides cannot replace them.
            if(block.blockClass != MaterialBlockClass::Enum::MaterialConstant){
                return false;
            }
            if(field.offset > 0xFFFFFFFFu - constantByteBegin){
                return false;
            }

            ++resourceFieldCount;
            const MaterialResourceKind expectedKind = MaterialLayoutFieldResourceKind(field.fieldType);
            const u32 expectedByteOffset = constantByteBegin + field.offset;
            b8 foundReference = false;
            for(usize r = 0u; r < resourceReferences.size(); ++r){
                const MaterialResourceReference resourceReference = resourceReferences[r];
                if(resourceReference.blockName != block.blockName || resourceReference.fieldName != field.fieldName){
                    continue;
                }
                if(foundReference){
                    return false;
                }
                if(resourceReference.resourceKind != expectedKind || resourceReference.constantByteOffset != expectedByteOffset){
                    return false;
                }

                switch(expectedKind){
                    case MaterialResourceKind::Enum::SampledImage2D:
                        if(!resourceReference.textureAsset.valid() || resourceReference.samplerAsset.valid()){
                            return false;
                        }
                        break;
                    case MaterialResourceKind::Enum::Sampler:
                        if(!resourceReference.samplerAsset.valid() || resourceReference.textureAsset.valid()){
                            return false;
                        }
                        break;
                    default:
                        return false;
                }

                foundReference = true;
            }
            if(!foundReference){
                return false;
            }
        }

        if(block.blockClass == MaterialBlockClass::Enum::MaterialConstant){
            if(block.byteSize > 0xFFFFFFFFu - constantByteBegin){
                return false;
            }
            constantByteBegin += block.byteSize;
        }
    }

    // Each record maps to one resource field. Dup rejects above also block stray numeric/mutable refs.
    return resourceFieldCount == resourceReferences.size();
}


