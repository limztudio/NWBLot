void VerifyUiNestedPopupLoanTests_ChildEndDefersVisibleRowCallbacksUntilTheOuterPopupEnds(mut UiNestedPopupLoanTests self){
    ASSERT_TRUE(self.beginParent(1u));
    ASSERT_TRUE(self.m_builder.beginPopup(s_UiNestedPopupRouterChildKey, self.m_child, MakeNestedChildPopupOptions()));
    ASSERT_TRUE(self.m_builder.virtualList(s_UiNestedPopupRouterListKey, self.m_childSource, self.m_childList, MakeLargeLoanListOptions()).valid);
    self.m_childSource.resetAllCounters();
    ASSERT_TRUE(self.m_builder.endPopup());
    EXPECT_EQ(self.m_childSource.metadataCalls, 0u);
    EXPECT_EQ(self.m_childSource.textCalls, 0u);
    ASSERT_TRUE(self.m_builder.endPopup());
    EXPECT_GT(self.m_childSource.textCalls, 0u);
    ASSERT_TRUE(self.finishRoot());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
}

void VerifyUiNestedPopupLoanTests_ExplicitChildListMutationAfterChildEndRejectsTheEnclosingLoan(mut UiNestedPopupLoanTests self){
    ASSERT_TRUE(self.acceptLists(1u));
    ASSERT_TRUE(self.declareLists(2u));
    const u64 inputGeneration = self.m_childList.inputGeneration();
    self.m_childList.select(4u);
    EXPECT_NE(self.m_childList.inputGeneration(), inputGeneration);
    EXPECT_FALSE(self.m_builder.endPopup());
    EXPECT_EQ(self.m_childList.selectedKey(), 4u);
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
}

void VerifyUiNestedPopupLoanTests_ChildVisibleRowCallbackCannotMutateThePaintedParentListLoan(mut UiNestedPopupLoanTests self){
    ASSERT_TRUE(self.acceptLists(1u));
    ASSERT_TRUE(self.declareLists(2u));
    const u64 inputGeneration = self.m_parentList.inputGeneration();
    self.m_childSource.armSelectListOnText(self.m_parentList);
    EXPECT_FALSE(self.m_builder.endPopup());
    EXPECT_EQ(self.m_parentList.selectedKey(), 4u);
    EXPECT_NE(self.m_parentList.inputGeneration(), inputGeneration);
    EXPECT_FALSE(self.m_childSource.hasSelectListOnText());
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
}

void VerifyUiNestedPopupLoanTests_ParentVisibleRowCallbackCannotMutateTheEndedChildListLoan(mut UiNestedPopupLoanTests self){
    ASSERT_TRUE(self.acceptLists(1u));
    ASSERT_TRUE(self.declareLists(2u));
    const u64 inputGeneration = self.m_childList.inputGeneration();
    self.m_parentSource.armSelectListOnText(self.m_childList);
    EXPECT_FALSE(self.m_builder.endPopup());
    EXPECT_EQ(self.m_childList.selectedKey(), 4u);
    EXPECT_NE(self.m_childList.inputGeneration(), inputGeneration);
    EXPECT_FALSE(self.m_parentSource.hasSelectListOnText());
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
}

void VerifyUiNestedPopupLoanTests_ParentMetadataCallbackArmedByChildPaintStillRejectsThePaintedChildMutation(mut UiNestedPopupLoanTests self){
    ASSERT_TRUE(self.acceptLists(1u));
    ASSERT_TRUE(self.declareLists(2u));
    const u64 inputGeneration = self.m_childList.inputGeneration();
    self.m_childSource.armSourceSelectList(self.m_parentSource, self.m_childList);
    self.m_childSource.textCalls = 0u;
    EXPECT_FALSE(self.m_builder.endPopup());
    EXPECT_GT(self.m_childSource.textCalls, 0u);
    EXPECT_FALSE(self.m_childSource.hasArmSourceOnText());
    EXPECT_FALSE(self.m_parentSource.hasSelectListOnRevision());
    EXPECT_EQ(self.m_childList.selectedKey(), 4u);
    EXPECT_NE(self.m_childList.inputGeneration(), inputGeneration);
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
