[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <global/scope_exit.h>
#include <global/sha256.h>

#include <hb.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace UiFixtureSupport{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace Impl;
using namespace Impl::Ui;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void PopulateBakedFontTables(const Span<const u8> bytes, Core::Alloc::GlobalArena& arena, FontAtlasPayload& payload){
    hb_blob_t* const blob = hb_blob_create(reinterpret_cast<const char*>(bytes.data()), static_cast<u32>(bytes.size()), HB_MEMORY_MODE_READONLY, nullptr, nullptr);
    ScopeExit releaseBlob([blob]()noexcept{ hb_blob_destroy(blob); });
    hb_face_t* const face = hb_face_create(blob, 0u);
    ScopeExit releaseFace([face]()noexcept{ hb_face_destroy(face); });
    payload.unitsPerEm = hb_face_get_upem(face);
    payload.sourceGlyphCount = hb_face_get_glyph_count(face);
    const Array<u32, 3u> tags = { s_FontAtlasGdefTag, s_FontAtlasGposTag, s_FontAtlasKernTag };
    for(const u32 tag : tags){
        hb_blob_t* const tableBlob = hb_face_reference_table(face, tag);
        ScopeExit releaseTable([tableBlob]()noexcept{ hb_blob_destroy(tableBlob); });
        u32 size = 0u;
        const char* data = hb_blob_get_data(tableBlob, &size);
        if(size != 0u){
            payload.positioningTables.emplace_back(arena);
            FontAtlasPositioningTable& table = payload.positioningTables.back();
            table.tag = tag;
            table.bytes.assign(reinterpret_cast<const u8*>(data), reinterpret_cast<const u8*>(data) + size);
            table.sha256 = ComputeSha256({ table.bytes.data(), table.bytes.size() });
        }
    }
}

Expected<SharedImageSource> MakeSeededImage(const StringView path, const u8 seed, const u32 width, const u32 height, Core::Alloc::GlobalArena& arena){
    const auto mipCount = TextureFormat::ComputeCompleteMipCount(TextureDimension::Texture2D, width, height, 1u);
    if(!mipCount)
        return MakeUnexpected(mipCount.error());
    Texture::MipLevelVector mips(arena);
    mips.reserve(*mipCount);
    u32 mipWidth = width;
    u32 mipHeight = height;
    u64 offset = 0u;
    for(u32 index = 0u; index < *mipCount; ++index){
        const auto plane = TextureFormat::ComputeMipPlaneBlockLayout(TexturePayloadFormat::UastcLdr4x4, mipWidth, mipHeight);
        if(!plane)
            return MakeUnexpected(plane.error());
        mips.push_back({ offset, plane->planeByteCount, mipWidth, mipHeight, plane->blocksX, plane->blocksY, 1u });
        offset += plane->planeByteCount;
        mipWidth = mipWidth > 1u ? mipWidth >> 1u : 1u;
        mipHeight = mipHeight > 1u ? mipHeight >> 1u : 1u;
    }
    if(offset > Limit<usize>::s_Max)
        return MakeUnexpected(Failure{});
    Core::Assets::AssetBytes bytes(arena);
    bytes.resize(static_cast<usize>(offset));
    for(usize index = 0u; index < bytes.size(); ++index)
        bytes[index] = static_cast<u8>(static_cast<u32>(seed) + index * 17u);
    const auto textureName = Name::FromText(path);
    if(!textureName)
        return MakeUnexpected(Failure{});
    Texture texture(arena, *textureName);
    texture.setPayload(width, height, Move(mips), Move(bytes), TextureDimension::Texture2D, 1u, TexturePayloadFormat::UastcLdr4x4, TextureAlphaMode::EmbeddedLdr, TextureFormat::s_OpaqueAlphaUnorm8);
    return MakeImageSource(arena, texture);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


