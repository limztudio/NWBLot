[cpp_header("<core/telemetry/perf.h>"), cpp_name("::NWB::Core::Telemetry::PerfMemoryPayloadFlag::Mask")]
extern enum PerfMemoryPayloadFlag : u16{
    None,
    HasDelta
};

[cpp_header("<core/telemetry/perf.h>"), cpp_name("::NWB::Core::Telemetry::PerfTimingSource::Enum")]
extern enum PerfTimingSource : u8{
    Unknown,
    Cpu,
    Gpu
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<core/telemetry/perf.h>"), cpp_name("::NWB::Core::Telemetry::EncodedPerfMemoryPayloadHeader"), cpp_flags(self_defaulted, binary_serializable, brace_init)]
extern class EncodedPerfMemoryPayloadHeader{
    u32 magic;
    u16 version;
    u16 flags;
    NameHash scopeHash;
    u64 frameIndex;
    u64 reservedBytes;
    u64 usedBytes;
    u64 peakUsedBytes;
    u64 allocationCount;
    u64 reallocationCount;
    u64 deallocationCount;
    u64 previousFrameIndex;
    i64 deltaReservedBytes;
    i64 deltaUsedBytes;
    i64 deltaPeakUsedBytes;
    i64 deltaAllocationCount;
    i64 deltaReallocationCount;
    i64 deltaDeallocationCount;
    u32 scopeNameBytes;
    u32 source;
};

[cpp_header("<core/telemetry/perf.h>"), cpp_name("::NWB::Core::Telemetry::EncodedPerfTimingPayloadHeader"), cpp_flags(self_defaulted, binary_serializable, brace_init)]
extern class EncodedPerfTimingPayloadHeader{
    u32 magic;
    u16 version;
    u8 source;
    u8 reserved;
    NameHash scopeHash;
    f64 seconds;
    f64 minSeconds;
    f64 maxSeconds;
    f64 lastSeconds;
    u64 publishFrameIndex;
    u64 firstSampleFrameIndex;
    u64 lastSampleFrameIndex;
    u32 sampleCount;
    u32 scopeNameBytes;
};

[cpp_header("<core/telemetry/perf.h>"), cpp_name("::NWB::Core::Telemetry::PerfMemoryPayload"), cpp_flags(self_defaulted, binary_serializable, brace_init)]
extern class PerfMemoryPayload{
    Name scopeName;
    StringView scopeText;
    MemorySnapshot snapshot;
    MemoryDelta delta;
};

[cpp_header("<core/telemetry/perf.h>"), cpp_name("::NWB::Core::Telemetry::PerfSessionRecordResult"), cpp_flags(self_defaulted, small_value, binary_serializable, brace_init)]
extern class PerfSessionRecordResult{
    u32 cpuTimingEvents;
    u32 gpuTimingEvents;
    u32 memoryEvents;
    b8 succeeded;
    u32 eventCount(...)const;
    b8 ok(...)const;
};

[cpp_header("<core/telemetry/perf.h>"), cpp_name("::NWB::Core::Telemetry::PerfTimingPayload"), cpp_flags(self_defaulted, binary_serializable, brace_init)]
extern class PerfTimingPayload{
    Name scopeName;
    StringView scopeText;
    TimingStats stats;
    PerfTimingSource source;
};


