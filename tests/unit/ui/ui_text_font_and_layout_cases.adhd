class TextGlyphVisibilityFontTests : public testing::Test{
public:
    TextGlyphVisibilityFontTests()
        : m_arena(Name(NWB::Tests::UiCases::s_UiCaseTestsUiTextGlyphVisibilityFonts))
        , m_latin(m_arena, Name(UiWidgetTests::s_TestLatinFontPath))
        , m_korean(m_arena, Name(UiWidgetTests::s_TestKoreanFontPath))
    {}


public:
    virtual void SetUp()override{
        Core::Alloc::ScratchArena fontScratchArena{Name(NWB::Tests::UiCases::s_UiCaseNameFontScratch)};
        ASSERT_TRUE(loadFont("latin.font", m_latin));
        ASSERT_TRUE(loadFont("korean.font", m_korean));
        auto faceResult = MakeFontFace(fontScratchArena, m_arena, { Core::Assets::AssetRef<Font>(UiWidgetTests::s_TestLatinFontPath), m_latin, 1u });
        auto koreanFaceResult = MakeFontFace(fontScratchArena, m_arena, { Core::Assets::AssetRef<Font>(UiWidgetTests::s_TestKoreanFontPath), m_korean, 1u });
        ASSERT_TRUE(faceResult);
        ASSERT_TRUE(koreanFaceResult);
        m_face = Move(*faceResult);
        m_koreanFace = Move(*koreanFaceResult);
        ASSERT_TRUE(m_face->coverageInkReliable());
        ASSERT_FALSE(m_koreanFace->coverageInkReliable());
    }

    [[nodiscard]] b8 loadFont(const StringView filename, Font& font){
        const ::Path<Core::Alloc::GlobalArena> directory(m_arena, NWB_TEST_FONT_DIRECTORY);
        const ::Path<Core::Alloc::GlobalArena> path = directory / filename;
        Core::Assets::AssetBytes bytes(m_arena);
        auto bytesResult = Tests::ReadBundledFontBytes(path, bytes.get_allocator().arena());
        if(!bytesResult)
            return false;
        bytes = Move(*bytesResult);
        font.setFontBytes(Move(bytes));
        return font.validatePayload();
    }


public:
    Core::Alloc::GlobalArena m_arena;
    Font m_latin;
    Font m_korean;
    SharedFontFace m_face;
    SharedFontFace m_koreanFace;
};


class TextGlyphVisibilityAtlasTests : public testing::Test{
public:
    TextGlyphVisibilityAtlasTests()
        : m_arena(Name(NWB::Tests::UiCases::s_UiCaseTestsUiTextGlyphVisibilityAtlas))
        , m_asset(m_arena, Name(NWB::Tests::UiCases::s_UiCaseTestsUiGlyphVisibilityAtlas))
    {}


public:
    virtual void SetUp()override{
        FontAtlasPayload payload(m_arena);
        payload.font = Core::Assets::AssetRef<Font>("tests/ui/glyph_visibility/font");
        const Array<u8, 1> source{ 1u };
        payload.fontSha256 = ComputeSha256({ source.data(), 1u });
        payload.unitsPerEm = 1000u;
        payload.sourceGlyphCount = 2u;
        payload.bakePpem = 32u;
        payload.ascenderUnits = 800.0f;
        payload.descenderUnits = -200.0f;
        payload.glyphs.resize(2u);
        payload.glyphs[0u] = { .glyphId = 0u, .x = 1u, .y = 1u, .width = 2u, .height = 4u, .planeLeft = -125.0f, .planeTop = -500.0f, .planeRight = -62.5f, .planeBottom = -375.0f, .drawable = 1u };
        payload.glyphs[1u].glyphId = 1u;
        payload.groups.emplace_back(m_arena);
        FontAtlasGroup& group = payload.groups.back();
        group.width = 8u;
        group.height = 8u;
        group.pixels.resize(8u * 8u * 4u, 128u);
        group.sha256 = ComputeSha256({ group.pixels.data(), group.pixels.size() });
        m_asset.setPayload(Move(payload));
        Core::Alloc::ScratchArena scratchArena{Name(NWB::Tests::UiCases::s_UiCaseTestsUiTextGlyphVisibilityValidationScratch)};
        ASSERT_TRUE(m_asset.validatePayload(scratchArena));
        auto atlasResult = CreateBakedFontAtlas(m_arena, m_asset, 1u);
        ASSERT_TRUE(atlasResult);
        m_atlas = Move(*atlasResult);
        ASSERT_TRUE(m_atlas);
    }


public:
    Core::Alloc::GlobalArena m_arena;
    FontAtlas m_asset;
    SharedBakedFontAtlas m_atlas;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


