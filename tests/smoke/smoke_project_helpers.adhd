class ArrowYawInputHandler : IInputEventHandler{
    public KeyboardInputResult keyboardUpdate(in i32 key, in i32 scancode, in i32 action, in i32 mods)override{
        const b8 pressed = action == InputAction::Press || action == InputAction::Repeat;
        if(key == Key::Left){
            this.m_leftHeld = pressed;
            return true;
        }
        if(key == Key::Right){
            this.m_rightHeld = pressed;
            return true;
        }
        return false;
    }

    public void clear(){
        this.m_leftHeld = false;
        this.m_rightHeld = false;
    }

    public f32 axis()const{
        f32 right = 0.0f;
        if(this.m_rightHeld)
            right = 1.0f;
        f32 left = 0.0f;
        if(this.m_leftHeld)
            left = 1.0f;
        return right - left;
    }

    private b8 m_leftHeld = false;
    private b8 m_rightHeld = false;
}

class YawSpinController{
    public void update(in f32 safeDelta, in f32 frozenYaw, in b8 frozenYawValid, in ArrowYawInputHandler arrowYawInput, in f32 manualYawSpeed, in f32 spinSpeed, in f32 maxSpinDelta){
        if(frozenYawValid){
            this.m_yaw = frozenYaw;
            return;
        }

        const f32 manualAxis = arrowYawInput.axis();
        if(manualAxis != 0.0f)
            this.m_manualControl = true;

        if(this.m_manualControl)
            this.m_yaw += manualAxis * manualYawSpeed * safeDelta;
        else
            this.m_yaw += Min(safeDelta, maxSpinDelta) * spinSpeed;
    }

    public f32 yaw()const{ return this.m_yaw; }

    public b8 manualControl()const{ return this.m_manualControl; }

    private f32 m_yaw = 0.0f;
    private b8 m_manualControl = false;
}

native{
namespace NWB::Tests::Smoke{
[[nodiscard]] inline NotNullUniquePtr<Core::ECS::World> CreateSmokeWorldOrDie(const TStringView projectName, ProjectRuntimeContext& context){
    auto world = MakeUnique<Core::ECS::World>(context.objectArena, context.cpuTasks);
    if(!world){
        NWB_LOGGER_FATAL(NWB_TEXT("{}: ECS world allocation failed"), projectName);
        throw RuntimeException("Smoke project initialization failed");
    }
    if(!context.shaderPathResolver){
        NWB_LOGGER_FATAL(NWB_TEXT("{} initialization failed: shader path resolver callback is null"), projectName);
        throw RuntimeException("Smoke project initialization failed");
    }

    return MakeNotNullUnique(Move(world));
}
};
}

EntityID CreateSmokeCamera(in f32 cameraHeight, in f32 cameraDistance, in f32 cameraPitch, mut World world){
    native{
        auto activeCameraEntity = world.createEntity();
        auto& activeCamera = activeCameraEntity.addComponent<Impl::Scene::ActiveCameraComponent>();
        activeCamera.camera = Impl::Scene::CreateSceneCameraEntity(world, Float4(0.0f, cameraHeight, -cameraDistance, 0.0f));
        auto& cameraTransform = *MakeNotNull(world.tryGetComponent<Impl::Scene::TransformComponent>(activeCamera.camera));
        StoreFloat(QuaternionRotationRollPitchYaw(cameraPitch, 0.0f, 0.0f), cameraTransform.rotation);

        return activeCamera.camera;
    }
}


