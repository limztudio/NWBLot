void VerifyUiTextAreaScrollTests_ExplicitTwoAxisScrollSurvivesTheFirstModelBinding(mut UiTextAreaScrollTests self){
    const AStringView dense = UiTextAreaScrollDenseText();
    ASSERT_TRUE(self.m_model.setText(dense));
    const auto layout = self.m_text.layout(MakeUiTextScrollShapeRequest(dense, self.m_builder.style().fontSize));
    ASSERT_TRUE(layout.has_value());
    const auto visual = self.m_text.measure(layout.value(), MakeUiTextScrollDisplayMetrics(800.0f, 600.0f, 1.0f, 1.0f));
    ASSERT_TRUE(visual.has_value());
    ASSERT_LT(visual.value().x, 0.0f);
    ASSERT_TRUE(self.m_state.scrollTo(Point(17.0f, 19.0f)));
    const u64 revision = self.m_state.revision();
    ASSERT_TRUE(self.frameArea(1u, UiTextAreaScrollSmallOptions()));
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, 17.0f);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 19.0f);
    EXPECT_EQ(self.m_state.revision(), revision);
    const EditBoxPlacement placement = self.m_state.placement();
    EXPECT_FLOAT_EQ(placement.textOrigin.x, placement.content.x - visual.value().x - 17.0f);
    EXPECT_FLOAT_EQ(placement.textOrigin.y, placement.content.y - visual.value().y - 19.0f);
    EXPECT_GT(placement.caret.x, placement.content.x + placement.content.width);
    EXPECT_GT(placement.caret.y, placement.content.y + placement.content.height);
}

void VerifyUiTextAreaScrollTests_IdleAndResizeClampExplicitViewportWithoutAdvancingItsIntentEpoch(mut UiTextAreaScrollTests self){
    self.useHost();
    const AStringView dense = UiTextAreaScrollDenseText();
    ASSERT_TRUE(self.m_model.setText(dense));
    const auto layout = self.m_text.layout(MakeUiTextScrollShapeRequest(dense, self.m_builder.style().fontSize));
    ASSERT_TRUE(layout.has_value());
    const auto visual = self.m_text.measure(layout.value(), MakeUiTextScrollDisplayMetrics(800.0f, 600.0f, 1.0f, 1.0f));
    ASSERT_TRUE(visual.has_value());
    ASSERT_LT(visual.value().x, 0.0f);
    ASSERT_TRUE(self.m_state.scrollTo(Point(17.0f, 19.0f)));
    const u64 revision = self.m_state.revision();
    ASSERT_TRUE(self.frameArea(1u, UiTextAreaScrollSmallOptions()));
    ASSERT_TRUE(self.frameArea(2u, UiTextAreaScrollSmallOptions()));
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, 17.0f);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 19.0f);
    EXPECT_EQ(self.m_state.revision(), revision);
    TextAreaOptions larger = TextAreaOptions();
    larger.width = LayoutSize(LayoutSizePolicy::Fixed, 500.0f);
    larger.height = LayoutSize(LayoutSizePolicy::Fixed, 300.0f);
    ASSERT_TRUE(self.frameArea(3u, larger));
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, 0.0f);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
    EXPECT_EQ(self.m_state.revision(), revision);
    EXPECT_FLOAT_EQ(self.m_state.placement().textOrigin.x, self.m_state.placement().content.x - visual.value().x);
    EXPECT_FLOAT_EQ(self.m_state.placement().textOrigin.y, self.m_state.placement().content.y - visual.value().y);
    ASSERT_EQ(self.m_host.publications.size(), 3u);
    EXPECT_FLOAT_EQ(self.m_host.publications[0u].placement.scroll, 17.0f);
    EXPECT_FLOAT_EQ(self.m_host.publications[0u].placement.scrollY, 19.0f);
}

void VerifyUiTextAreaScrollTests_AutomaticRevealSurvivesIdleViewportShrinkWithoutNewModelIntent(mut UiTextAreaScrollTests self){
    self.useHost();
    ASSERT_TRUE(self.m_model.setText(UiTextAreaScrollDenseText()));
    TextAreaOptions larger = TextAreaOptions();
    larger.width = LayoutSize(LayoutSizePolicy::Fixed, 500.0f);
    larger.height = LayoutSize(LayoutSizePolicy::Fixed, 300.0f);
    ASSERT_TRUE(self.frameArea(1u, larger));
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, 0.0f);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
    const u64 revision = self.m_model.revision();
    const u64 selection = self.m_model.selectionGeneration();
    const u64 stateRevision = self.m_state.revision();
    TextAreaOptions compact = UiTextAreaScrollSmallOptions();
    compact.height.value = compact.height.value + self.m_builder.scrollbarStyle().thickness;
    ASSERT_TRUE(self.frameArea(2u, compact));
    EXPECT_GT(self.m_state.scroll().x, 0.0f);
    EXPECT_GT(self.m_state.scroll().y, 0.0f);
    const EditBoxPlacement placement = self.m_state.placement();
    ASSERT_GE(placement.content.height, placement.caret.height);
    EXPECT_GE(placement.caret.x, placement.content.x);
    EXPECT_GE(placement.caret.y, placement.content.y);
    // Lanes are caret right, caret bottom, content right, content bottom.
    const VectorSingle ends = VectorSingle(placement.caret.x, placement.caret.y, placement.content.x, placement.content.y) + VectorSingle(placement.caret.width, placement.caret.height, placement.content.width, placement.content.height);
    const VectorSingle limits = ends + VectorSingle(0.001f, 0.001f, 0.001f, 0.001f);
    EXPECT_LE(ends.x, limits.z);
    EXPECT_LE(ends.y, limits.w);
    EXPECT_EQ(self.m_model.revision(), revision);
    EXPECT_EQ(self.m_model.selectionGeneration(), selection);
    EXPECT_EQ(self.m_state.revision(), stateRevision);
    EXPECT_FALSE(self.m_result.textChanged || self.m_result.selectionChanged);
}

void VerifyUiTextAreaScrollTests_ExplicitOverscrollClampsToBothContentExtents(mut UiTextAreaScrollTests self){
    ASSERT_TRUE(self.m_model.setText(UiTextAreaScrollDenseText()));
    ASSERT_TRUE(self.m_state.scrollTo(Point(10000.0f, 10000.0f)));
    const u64 revision = self.m_state.revision();
    ASSERT_TRUE(self.frameArea(1u, UiTextAreaScrollSmallOptions()));
    const EditBoxPlacement placement = self.m_state.placement();
    EXPECT_GT(self.m_state.scroll().x, 0.0f);
    EXPECT_GT(self.m_state.scroll().y, 0.0f);
    EXPECT_LT(self.m_state.scroll().x, 10000.0f);
    EXPECT_LT(self.m_state.scroll().y, 10000.0f);
    // Lanes are caret right, caret bottom, content right, content bottom.
    const VectorSingle ends = VectorSingle(placement.caret.x, placement.caret.y, placement.content.x, placement.content.y) + VectorSingle(placement.caret.width, placement.caret.height, placement.content.width, placement.content.height);
    EXPECT_NEAR(ends.x, ends.z, 0.001f);
    EXPECT_NEAR(ends.y, ends.w, 0.001f);
    EXPECT_EQ(self.m_state.revision(), revision);
}

void VerifyUiTextAreaScrollTests_AcceptedIdenticalSelectionResumesRevealAfterManualScrolling(mut UiTextAreaScrollTests self){
    ASSERT_TRUE(self.m_model.setText(UiTextAreaScrollDenseText()));
    ASSERT_TRUE(self.frameArea(1u, UiTextAreaScrollSmallOptions()));
    EXPECT_GT(self.m_state.scroll().x, 0.0f);
    EXPECT_GT(self.m_state.scroll().y, 0.0f);
    ASSERT_TRUE(self.m_state.scrollTo(Point(0.0f, 0.0f)));
    const u64 revision = self.m_state.revision();
    ASSERT_TRUE(self.frameArea(2u, UiTextAreaScrollSmallOptions()));
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, 0.0f);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
    const u64 selectionGeneration = self.m_model.selectionGeneration();
    ASSERT_TRUE(self.m_model.setSelection(self.m_model.anchor(), self.m_model.caret()));
    EXPECT_GT(self.m_model.selectionGeneration(), selectionGeneration);
    ASSERT_TRUE(self.frameArea(3u, UiTextAreaScrollSmallOptions()));
    EXPECT_GT(self.m_state.scroll().x, 0.0f);
    EXPECT_GT(self.m_state.scroll().y, 0.0f);
    EXPECT_EQ(self.m_state.revision(), revision);
}

void VerifyUiTextAreaScrollTests_CopyAndUnchangedSubmitPreserveTheExplicitViewport(mut UiTextAreaScrollTests self){
    self.useHost();
    const AStringView dense = UiTextAreaScrollDenseText();
    ASSERT_TRUE(self.m_model.setText(dense));
    ASSERT_TRUE(self.frameArea(1u, UiTextAreaScrollSmallOptions()));
    ASSERT_TRUE(self.m_state.scrollTo(Point(0.0f, 0.0f)));
    const u64 revision = self.m_state.revision();
    const u64 selectionGeneration = self.m_model.selectionGeneration();
    self.m_host.key(UiTextScrollBakedKey::C, true);
    self.m_host.key(UiTextScrollBakedKey::Enter, true);
    ASSERT_TRUE(self.frameArea(2u, UiTextAreaScrollSmallOptions()));
    EXPECT_TRUE(self.m_result.submitted);
    EXPECT_FALSE(self.m_result.textChanged || self.m_result.selectionChanged);
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, 0.0f);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, 0.0f);
    EXPECT_EQ(self.m_state.revision(), revision);
    EXPECT_EQ(self.m_model.selectionGeneration(), selectionGeneration);
    EXPECT_EQ(self.m_model.text(), dense);
    ASSERT_EQ(self.m_host.actionTexts.size(), 1u);
    EXPECT_EQ(UiTextScrollActionText(self.m_host.actionTexts[0u]), dense);
    self.m_host.selection(self.m_model.anchor(), self.m_model.caret());
    ASSERT_TRUE(self.frameArea(3u, UiTextAreaScrollSmallOptions()));
    EXPECT_FALSE(self.m_result.selectionChanged);
    EXPECT_GT(self.m_model.selectionGeneration(), selectionGeneration);
    EXPECT_GT(self.m_state.scroll().x, 0.0f);
    EXPECT_GT(self.m_state.scroll().y, 0.0f);
}

void VerifyUiTextAreaScrollTests_AcceptedTextResumesRevealAndPublicationOwnsItsBytes(mut UiTextAreaScrollTests self){
    self.useHost();
    const AStringView dense = UiTextAreaScrollDenseText();
    ASSERT_TRUE(self.m_model.setText(dense));
    ASSERT_TRUE(self.frameArea(1u, UiTextAreaScrollSmallOptions()));
    ASSERT_TRUE(self.m_state.scrollTo(Point(0.0f, 0.0f)));
    ASSERT_TRUE(self.frameArea(2u, UiTextAreaScrollSmallOptions()));
    self.m_host.text("b");
    ASSERT_TRUE(self.frameArea(3u, UiTextAreaScrollSmallOptions()));
    EXPECT_TRUE(self.m_result.textChanged);
    EXPECT_GT(self.m_state.scroll().x, 0.0f);
    EXPECT_GT(self.m_state.scroll().y, 0.0f);
    String displayed = "";
    displayed.assign(dense.data(), dense.size());
    displayed.append("b", 1u);
    ASSERT_EQ(self.m_host.publications.size(), 3u);
    EXPECT_EQ(UiTextScrollPublicationText(self.m_host.publications[2u]), StringView(displayed.data(), displayed.size()));
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), dense);
    EXPECT_EQ(UiTextScrollPublicationText(self.m_host.publications[2u]), StringView(displayed.data(), displayed.size()));
    EXPECT_FALSE(self.m_model.canUndo());
}

