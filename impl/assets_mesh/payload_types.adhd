////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_mesh/skin_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Name s_MeshValidatePayloadArena = "impl/assets_mesh/validate_payload";

const u32 s_MeshBinaryMagic = 0x4D534837u; // MSH7
const u32 s_MeshMissingStreamIndex = 0xffffffffu;
const u32 s_MeshMaxMeshletVertices = 96u;
const u32 s_MeshMaxMeshletTriangles = 126u;
const u32 s_MeshletTriangleIndexCount = 3u;
const u32 s_MeshletSolidTriangleWordBits = 32u;
const u32 s_MeshletSolidTriangleWordRoundUp = 31u;
const u32 s_MeshletConeFlagEnabled = 1u;
const u32 s_MeshletBoundsStride = 20u;
const u32 s_MeshletCountMask = 0xffu;
const u32 s_MeshletPrimitiveCountShift = 8u;
const u32 s_MeshletPositionCountShift = 16u;
const u32 s_MeshletAttributeCountShift = 24u;
const u32 s_MeshletConeAxisXShift = 0u;
const u32 s_MeshletConeAxisYShift = 8u;
const u32 s_MeshletConeCutoffShift = 16u;
const u32 s_MeshletConeFlagShift = 24u;
const u32 s_MeshletPackedByteBits = 8u;
const u32 s_MeshletPackedByte2Shift = s_MeshletPackedByteBits * 2u;
const u32 s_MeshletPackedByte3Shift = s_MeshletPackedByteBits * 3u;
const u32 s_MeshletPackedByteMask = 0xffu;
const usize s_StaticMeshletPositionChannelCount = 1u;
const usize s_SkinnedMeshletPositionChannelCount = 2u;
const u32 s_MeshletConeAxisFallback = 0x8080u;
const f32 s_MeshletOctEncodeBias = 0.5f;
const f32 s_MeshletOctDecodeScale = 2.0f;
const f32 s_MeshletOctDecodeBias = 1.0f;
const f32 s_MeshletConeAxisLengthEpsilon = 0.000001f;
const f32 s_MeshletConeAxisLengthSquaredEpsilon = 0.00000001f;
const f32 s_MeshletUnorm8Max = 255.0f;
const f32 s_MeshletUnorm8RoundingBias = 0.5f;
const u32 s_MeshletRefEncodingWidthMask = 0x3u;
const u32 s_MeshletRefEncodingPositionShift = 0u;
const u32 s_MeshletRefEncodingSkinShift = 2u;
const u32 s_MeshletRefEncodingNormalShift = 4u;
const u32 s_MeshletRefEncodingTangentShift = 6u;
const u32 s_MeshletRefEncodingUv0Shift = 8u;
const u32 s_MeshletRefEncodingColorShift = 10u;
const usize s_AttribGpuByteSize = 16u;

const f32 s_DirectionLengthTolerance = 0.01f;
const f32 s_TangentHandednessTolerance = 0.001f;

[reflect]
enum<u32> MeshletRefDeltaWidth{
    U8 = 0u,
    U16 = 1u,
    U32 = 2u
}

[serialize]
class MeshBinaryHeader{
    public u32 magic = s_MeshBinaryMagic;
    public u64 positionCount = 0u;
    public u64 normalCount = 0u;
    public u64 tangentCount = 0u;
    public u64 uv0Count = 0u;
    public u64 colorCount = 0u;
    public u64 meshletCount = 0u;
    public u64 meshletBoundCount = 0u;
    public u64 meshletPositionRefDeltaByteCount = 0u;
    public u64 meshletAttributeRefDeltaByteCount = 0u;
    public u64 meshletLocalVertexRefCount = 0u;
    public u64 meshletPrimitiveIndexCount = 0u;
}

class MeshletDesc{
    public u32 localVertexOffset = 0u;
    public u32 primitiveOffset = 0u;
    public u32 positionRefOffset = 0u;
    public u32 attributeRefOffset = 0u;
    public u32 counts = 0u;
    public u32 positionBase = 0u;
    public u32 skinBase = s_MeshMissingStreamIndex;
    public u32 normalBase = 0u;
    public u32 tangentBase = 0u;
    public u32 uv0Base = 0u;
    public u32 colorBase = 0u;
    public u32 encoding = 0u;
}

[serialize]
class MeshletBounds{
    public f32x4u sphere(0.0f);
    public u32 conePacked = 0u;
}

[serialize]
class MeshletPositionStreamRef{
    public u32 position = s_MeshMissingStreamIndex;
    public u32 skin = s_MeshMissingStreamIndex;
}

class MeshletAttributeStreamRef{
    public u32 normal = s_MeshMissingStreamIndex;
    public u32 tangent = s_MeshMissingStreamIndex;
    public u32 uv0 = s_MeshMissingStreamIndex;
    public u32 color = s_MeshMissingStreamIndex;
}

[serialize]
class MeshletLocalVertexRef{
    public u16 localDeformedPosition = 0u;
    public u16 localAttribute = 0u;
}

[serialize]
class AttribGpu{
    public f16x4u normal;
    public f32x2u uv0;
}

class MeshletPositionRefEncodingLayout{
    public usize positionByteOffset = 0u;
    public usize skinByteOffset = 0u;
    public usize byteCount = 0u;
    public MeshletRefDeltaWidth positionWidth = MeshletRefDeltaWidth::U8;
    public MeshletRefDeltaWidth skinWidth = MeshletRefDeltaWidth::U8;
}

class MeshletAttributeRefEncodingLayout{
    public usize normalByteOffset = 0u;
    public usize tangentByteOffset = 0u;
    public usize uv0ByteOffset = 0u;
    public usize colorByteOffset = 0u;
    public usize byteCount = 0u;
    public MeshletRefDeltaWidth normalWidth = MeshletRefDeltaWidth::U8;
    public MeshletRefDeltaWidth tangentWidth = MeshletRefDeltaWidth::U8;
    public MeshletRefDeltaWidth uv0Width = MeshletRefDeltaWidth::U8;
    public MeshletRefDeltaWidth colorWidth = MeshletRefDeltaWidth::U8;
}

b8 MeshBaseHeaderComplete(in MeshBinaryHeader header){
    return
        header.positionCount != 0u
        && header.normalCount != 0u
        && header.tangentCount != 0u
        && header.uv0Count != 0u
        && header.colorCount != 0u
        && header.meshletCount != 0u
        && header.meshletCount <= cast<u64>(0xffffffffu / s_MeshletBoundsStride)
        && header.meshletBoundCount == header.meshletCount
        && header.meshletPositionRefDeltaByteCount != 0u
        && header.meshletAttributeRefDeltaByteCount != 0u
        && header.meshletLocalVertexRefCount != 0u
        && header.meshletPrimitiveIndexCount != 0u
    ;
}

u32 PackMeshletCounts(in u32 vertexCount, in u32 primitiveCount, in u32 positionCount, in u32 attributeCount){
    return (vertexCount & s_MeshletCountMask)
        | ((primitiveCount & s_MeshletCountMask) << s_MeshletPrimitiveCountShift)
        | ((positionCount & s_MeshletCountMask) << s_MeshletPositionCountShift)
        | ((attributeCount & s_MeshletCountMask) << s_MeshletAttributeCountShift);
}

u32 MeshletVertexCount(in MeshletDesc meshlet){
    return meshlet.counts & s_MeshletCountMask;
}

u32 MeshletPrimitiveCount(in MeshletDesc meshlet){
    return (meshlet.counts >> s_MeshletPrimitiveCountShift) & s_MeshletCountMask;
}

u32 MeshletPositionCount(in MeshletDesc meshlet){
    return (meshlet.counts >> s_MeshletPositionCountShift) & s_MeshletCountMask;
}

u32 MeshletAttributeCount(in MeshletDesc meshlet){
    return meshlet.counts >> s_MeshletAttributeCountShift;
}

MeshletRefDeltaWidth MeshletRefEncodingWidth(in u32 encoding, in u32 shift){
    return cast<MeshletRefDeltaWidth>((encoding >> shift) & s_MeshletRefEncodingWidthMask);
}

b8 MeshletRefDeltaFitsWidth(in u32 delta, in MeshletRefDeltaWidth width){
    return width == MeshletRefDeltaWidth::U32 || (width == MeshletRefDeltaWidth::U16 && delta <= 0xffffu) || (width == MeshletRefDeltaWidth::U8 && delta <= 0xffu);
}

u32 MeshletConeFlags(in MeshletBounds bounds){
    return bounds.conePacked >> s_MeshletConeFlagShift;
}

u32 MeshletConePackedCutoff(in MeshletBounds bounds){
    return (bounds.conePacked >> s_MeshletConeCutoffShift) & s_MeshletPackedByteMask;
}

b8 MeshletConeEnabled(in MeshletBounds bounds){
    return (MeshletConeFlags(bounds) & s_MeshletConeFlagEnabled) != 0u;
}

b8 MeshletRefDeltaWidthValid(in MeshletRefDeltaWidth width){
    return width == MeshletRefDeltaWidth::U8 || width == MeshletRefDeltaWidth::U16 || width == MeshletRefDeltaWidth::U32;
}

u32 MeshletRefDeltaByteWidth(in MeshletRefDeltaWidth width){
    if(width == MeshletRefDeltaWidth::U8)
        return 1u;
    if(width == MeshletRefDeltaWidth::U16)
        return 2u;
    return 4u;
}

b8 MeshletPositionRefInRange(in MeshletPositionStreamRef streamRef, in usize positionCount, in usize skinCount, in b8 skinRequired){
    if(cast<usize>(streamRef.position) >= positionCount)
        return false;
    if(skinRequired)
        return cast<usize>(streamRef.skin) < skinCount;
    return streamRef.skin == s_MeshMissingStreamIndex;
}

b8 MeshletAttributeRefInRange(in MeshletAttributeStreamRef streamRef, in usize normalCount, in usize tangentCount, in usize uv0Count, in usize colorCount){
    return cast<usize>(streamRef.normal) < normalCount && cast<usize>(streamRef.tangent) < tangentCount && cast<usize>(streamRef.uv0) < uv0Count && cast<usize>(streamRef.color) < colorCount;
}

b8 TryComputeMeshletRefDeltaByteCount(in u32 refCount, in MeshletRefDeltaWidth width, mut usize outByteCount){
    if(!MeshletRefDeltaWidthValid(width))
        return false;

    const usize byteWidth = cast<usize>(MeshletRefDeltaByteWidth(width));
    if(cast<usize>(refCount) > 0xffffffffffffffffu / byteWidth)
        return false;

    outByteCount = cast<usize>(refCount) * byteWidth;
    return true;
}

b8 AddMeshletRefDeltaByteCount(in u32 refCount, in MeshletRefDeltaWidth width, mut usize inOutByteCount){
    usize channelBytes = 0u;
    if(!TryComputeMeshletRefDeltaByteCount(refCount, width, channelBytes))
        return false;
    if(channelBytes > 0xffffffffffffffffu - inOutByteCount)
        return false;

    inOutByteCount += channelBytes;
    return true;
}

b8 TryAddMeshletRefLayoutChannel(in usize baseOffset, in u32 refCount, in MeshletRefDeltaWidth width, mut usize inOutRelativeOffset, mut usize outChannelByteOffset){
    if(baseOffset > 0xffffffffffffffffu - inOutRelativeOffset)
        return false;

    outChannelByteOffset = baseOffset + inOutRelativeOffset;
    return AddMeshletRefDeltaByteCount(refCount, width, inOutRelativeOffset);
}

b8 TryBuildMeshletPositionRefEncodingLayout(in MeshletDesc meshlet, in b8 skinRequired, mut MeshletPositionRefEncodingLayout outLayout){
    MeshletPositionRefEncodingLayout layout;
    const u32 positionCount = MeshletPositionCount(meshlet);
    layout.positionWidth = MeshletRefEncodingWidth(meshlet.encoding, s_MeshletRefEncodingPositionShift);
    layout.skinWidth = MeshletRefEncodingWidth(meshlet.encoding, s_MeshletRefEncodingSkinShift);
    if(!TryAddMeshletRefLayoutChannel(cast<usize>(meshlet.positionRefOffset), positionCount, layout.positionWidth, layout.byteCount, layout.positionByteOffset))
        return false;
    if(!skinRequired){
        outLayout = layout;
        return true;
    }
    if(!TryAddMeshletRefLayoutChannel(cast<usize>(meshlet.positionRefOffset), positionCount, layout.skinWidth, layout.byteCount, layout.skinByteOffset))
        return false;
    outLayout = layout;
    return true;
}

b8 TryBuildMeshletAttributeRefEncodingLayout(in MeshletDesc meshlet, mut MeshletAttributeRefEncodingLayout outLayout){
    MeshletAttributeRefEncodingLayout layout;
    const u32 attributeCount = MeshletAttributeCount(meshlet);
    layout.normalWidth = MeshletRefEncodingWidth(meshlet.encoding, s_MeshletRefEncodingNormalShift);
    layout.tangentWidth = MeshletRefEncodingWidth(meshlet.encoding, s_MeshletRefEncodingTangentShift);
    layout.uv0Width = MeshletRefEncodingWidth(meshlet.encoding, s_MeshletRefEncodingUv0Shift);
    layout.colorWidth = MeshletRefEncodingWidth(meshlet.encoding, s_MeshletRefEncodingColorShift);
    if(!TryAddMeshletRefLayoutChannel(cast<usize>(meshlet.attributeRefOffset), attributeCount, layout.normalWidth, layout.byteCount, layout.normalByteOffset))
        return false;
    if(!TryAddMeshletRefLayoutChannel(cast<usize>(meshlet.attributeRefOffset), attributeCount, layout.tangentWidth, layout.byteCount, layout.tangentByteOffset))
        return false;
    if(!TryAddMeshletRefLayoutChannel(cast<usize>(meshlet.attributeRefOffset), attributeCount, layout.uv0Width, layout.byteCount, layout.uv0ByteOffset))
        return false;
    if(!TryAddMeshletRefLayoutChannel(cast<usize>(meshlet.attributeRefOffset), attributeCount, layout.colorWidth, layout.byteCount, layout.colorByteOffset))
        return false;
    outLayout = layout;
    return true;
}

b8 TryComputeMeshletEncodedPositionRefByteCount(in MeshletDesc meshlet, in b8 skinRequired, mut usize outByteCount){
    MeshletPositionRefEncodingLayout layout;
    if(!TryBuildMeshletPositionRefEncodingLayout(meshlet, skinRequired, layout))
        return false;

    outByteCount = layout.byteCount;
    return true;
}

b8 TryComputeMeshletEncodedAttributeRefByteCount(in MeshletDesc meshlet, mut usize outByteCount){
    MeshletAttributeRefEncodingLayout layout;
    if(!TryBuildMeshletAttributeRefEncodingLayout(meshlet, layout))
        return false;

    outByteCount = layout.byteCount;
    return true;
}

b8 TryDecodeMeshletRefDelta(in Span<u8> bytes, in usize byteOffset, in MeshletRefDeltaWidth width, mut u32 outDelta){
    if(!MeshletRefDeltaWidthValid(width))
        return false;

    const usize byteCount = bytes.size();
    const usize byteWidth = cast<usize>(MeshletRefDeltaByteWidth(width));
    if(byteOffset > byteCount || byteWidth > byteCount - byteOffset)
        return false;

    u32 delta = cast<u32>(bytes[byteOffset]);
    if(width == MeshletRefDeltaWidth::U8){
        outDelta = delta;
        return true;
    }

    delta |= cast<u32>(bytes[byteOffset + 1u]) << s_MeshletPackedByteBits;
    if(width == MeshletRefDeltaWidth::U16){
        outDelta = delta;
        return true;
    }

    delta |= cast<u32>(bytes[byteOffset + 2u]) << s_MeshletPackedByte2Shift;
    delta |= cast<u32>(bytes[byteOffset + 3u]) << s_MeshletPackedByte3Shift;
    outDelta = delta;
    return true;
}

b8 TryDecodeMeshletRefDeltaAtIndex(in Span<u8> bytes, in usize channelByteOffset, in u32 localIndex, in MeshletRefDeltaWidth width, mut u32 outDelta){
    return TryDecodeMeshletRefDelta(bytes, channelByteOffset + cast<usize>(localIndex) * cast<usize>(MeshletRefDeltaByteWidth(width)), width, outDelta);
}

b8 TryDecodeMeshletRefChannelValue(in Span<u8> bytes, in usize channelByteOffset, in MeshletRefDeltaWidth width, in u32 base, in u32 localIndex, mut u32 outIndex){
    u32 delta = 0u;
    if(!TryDecodeMeshletRefDeltaAtIndex(bytes, channelByteOffset, localIndex, width, delta) || delta > 0xffffffffu - base)
        return false;

    outIndex = base + delta;
    return true;
}

b8 TryDecodeMeshletPositionRef(in Span<u8> bytes, in MeshletDesc meshlet, in u32 localPositionIndex, in b8 skinRequired, mut MeshletPositionStreamRef outRef){
    MeshletPositionStreamRef refValue;
    const u32 positionCount = MeshletPositionCount(meshlet);
    if(localPositionIndex >= positionCount)
        return false;

    MeshletPositionRefEncodingLayout layout;
    if(!TryBuildMeshletPositionRefEncodingLayout(meshlet, skinRequired, layout))
        return false;

    if(!TryDecodeMeshletRefChannelValue(bytes, layout.positionByteOffset, layout.positionWidth, meshlet.positionBase, localPositionIndex, refValue.position))
        return false;

    if(!skinRequired){
        if(meshlet.skinBase != s_MeshMissingStreamIndex)
            return false;
        outRef = refValue;
        return true;
    }

    if(!TryDecodeMeshletRefChannelValue(bytes, layout.skinByteOffset, layout.skinWidth, meshlet.skinBase, localPositionIndex, refValue.skin))
        return false;
    outRef = refValue;
    return true;
}

b8 TryDecodeMeshletAttributeRef(in Span<u8> bytes, in MeshletDesc meshlet, in u32 localAttributeIndex, mut MeshletAttributeStreamRef outRef){
    MeshletAttributeStreamRef refValue;
    const u32 attributeCount = MeshletAttributeCount(meshlet);
    if(localAttributeIndex >= attributeCount)
        return false;

    MeshletAttributeRefEncodingLayout layout;
    if(!TryBuildMeshletAttributeRefEncodingLayout(meshlet, layout))
        return false;

    if(!TryDecodeMeshletRefChannelValue(bytes, layout.normalByteOffset, layout.normalWidth, meshlet.normalBase, localAttributeIndex, refValue.normal))
        return false;
    if(!TryDecodeMeshletRefChannelValue(bytes, layout.tangentByteOffset, layout.tangentWidth, meshlet.tangentBase, localAttributeIndex, refValue.tangent))
        return false;
    if(!TryDecodeMeshletRefChannelValue(bytes, layout.uv0ByteOffset, layout.uv0Width, meshlet.uv0Base, localAttributeIndex, refValue.uv0))
        return false;
    if(!TryDecodeMeshletRefChannelValue(bytes, layout.colorByteOffset, layout.colorWidth, meshlet.colorBase, localAttributeIndex, refValue.color))
        return false;

    outRef = refValue;
    return true;
}

u32 PackMeshletConeCutoffUnorm8(in f32 value){
    return cast<u32>(clamp(value, 0.0f, 1.0f) * s_MeshletUnorm8Max);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

