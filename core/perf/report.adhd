[cpp_header("<core/perf/report.h>"), cpp_name("::NWB::Core::Perf::CaptureOptions")]
extern class PerfCaptureOptions{
    b8 enabled;
    b8 cpuTiming;
    b8 gpuTiming;
    b8 memory;
    b8 cpuTimingActive(...)const;
    b8 gpuTimingActive(...)const;
    b8 memoryActive(...)const;
};

[cpp_header("<core/perf/report.h>"), cpp_name("::NWB::Core::Perf::SessionReport")]
extern class SessionReport{
    u64 frameIndex;
    TimingView cpuTiming;
    TimingView gpuTiming;
    MemoryView memory;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<core/perf/report.h>"), cpp_name("::NWB::Core::Perf::CaptureOptions::All")]
extern PerfCaptureOptions PerfCaptureOptionsAll();

[cpp_header("<core/perf/report.h>"), cpp_name("::NWB::Core::Perf::CaptureOptions::Disabled")]
extern PerfCaptureOptions PerfCaptureOptionsDisabled();

[cpp_header("<core/perf/report.h>"), cpp_name("::NWB::Core::Perf::CaptureOptions::GpuTimingOnly")]
extern PerfCaptureOptions PerfCaptureOptionsGpuTimingOnly();


