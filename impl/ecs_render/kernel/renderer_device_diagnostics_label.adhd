#include <impl/ecs_render/kernel/renderer_format_private.adhd>
#include <impl/ecs_render/shared/frame_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void AppendDevicePhysicalQueueDiagnostics(
    in KernelGraphicsRuntime graphics,
    in KernelGpuPhysicalQueueInfo queueInfo,
    mut String label
){
    StringAppendFormat(
        label,
        "\nGPU timing physical queue index={} generation={} class={} family index={} native queue index={} capability mask={} timestamp valid bits={} duration timestamps={} comparable timestamps={}",
        queueInfo.id.index,
        queueInfo.id.deviceGeneration,
        ResolveTelemetryPhysicalQueueClassLabel(KernelQueueInfoClassValue(queueInfo)),
        queueInfo.familyIndex,
        queueInfo.queueIndex,
        KernelQueueInfoCapabilitiesValue(queueInfo),
        queueInfo.timestampValidBits,
        queueInfo.timestampValidBits != 0u,
        SupportsKernelComparableGpuTimestamps(graphics, queueInfo.id)
    );
}

class RendererDeviceDiagnosticsLabel{
    public void append(mut KernelGraphicsRuntime graphics, mut String label)const{
        const KernelGpuTimingRecorderStatistics gpuTimingStatistics = QueryKernelGpuTimingStatistics(graphics);
        StringAppendFormat(
            label,
            "\nGPU timing (device-wide cumulative since query reset): generation={} query collection={} timing sink={} feedback={} active={} comparable timestamps={} prepared scopes={} requested/materialized queries={}/{} materialization failures={}\nGPU timing outcomes: attempts={} recorded={} accepted={} published={} completed unpublished={} discarded before acceptance={} quarantined={} begin failures={} skipped inactive/no timestamps/no comparable timestamps/unprepared/no capacity/recording unavailable={}/{}/{}/{}/{}/{}",
            gpuTimingStatistics.deviceGeneration,
            gpuTimingStatistics.queryCollectionEnabled,
            gpuTimingStatistics.timingSinkEnabled,
            gpuTimingStatistics.feedbackCollectionEnabled,
            gpuTimingStatistics.collectionActive,
            gpuTimingStatistics.comparableTimestampsSupported,
            gpuTimingStatistics.preparedScopeCount,
            gpuTimingStatistics.requestedQueryCount,
            gpuTimingStatistics.materializedQueryCount,
            gpuTimingStatistics.queryMaterializationFailureCount,
            gpuTimingStatistics.scopeAttemptCount,
            gpuTimingStatistics.recordedScopeCount,
            gpuTimingStatistics.acceptedScopeCount,
            gpuTimingStatistics.publishedSampleCount,
            gpuTimingStatistics.unpublishedSampleCount,
            gpuTimingStatistics.discardedScopeCount,
            gpuTimingStatistics.quarantinedScopeCount,
            gpuTimingStatistics.beginFailureCount,
            KernelSkippedScopeCount(gpuTimingStatistics, 0u),
            KernelSkippedScopeCount(gpuTimingStatistics, 1u),
            KernelSkippedScopeCount(gpuTimingStatistics, 2u),
            KernelSkippedScopeCount(gpuTimingStatistics, 3u),
            KernelSkippedScopeCount(gpuTimingStatistics, 4u),
            KernelSkippedScopeCount(gpuTimingStatistics, 5u)
        );

        const KernelGpuPhysicalQueueTopology gpuTimingQueueTopology = QueryKernelPhysicalQueueTopology(graphics);
        for(usize queueIndex = 0u; queueIndex < gpuTimingQueueTopology.queueCount; ++queueIndex)
            AppendDevicePhysicalQueueDiagnostics(graphics, KernelTopologyQueueAt(gpuTimingQueueTopology, queueIndex), label);

        const KernelGpuDescriptorHeapLifecycleStatistics descriptorHeapLifecycleStatistics = QueryKernelDescriptorHeapLifecycleStatistics(graphics);
        StringAppendFormat(
            label,
            "\nDescriptor heap lifecycle (device-wide current): initialized={} resource live/capacity={}/{} sampler live/capacity={}/{} acceleration structure live/capacity={}/{} pending retired slots={} accepted heap uses={} unsubmitted heap uses={} abandoned heap uses={}",
            descriptorHeapLifecycleStatistics.initialized,
            descriptorHeapLifecycleStatistics.resourceLiveSlotCount,
            descriptorHeapLifecycleStatistics.resourceCapacity,
            descriptorHeapLifecycleStatistics.samplerLiveSlotCount,
            descriptorHeapLifecycleStatistics.samplerCapacity,
            descriptorHeapLifecycleStatistics.accelStructLiveSlotCount,
            descriptorHeapLifecycleStatistics.accelStructCapacity,
            descriptorHeapLifecycleStatistics.pendingRetiredSlotCount,
            descriptorHeapLifecycleStatistics.acceptedHeapUseCount,
            descriptorHeapLifecycleStatistics.unsubmittedHeapUseCount,
            descriptorHeapLifecycleStatistics.abandonedHeapUseCount
        );
    }
}


