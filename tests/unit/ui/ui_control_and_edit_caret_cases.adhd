void VerifyUiControlInputTests_FocusHintCannotStealAnotherFocusOrSurviveDelayedFocusLoss(mut UiControlInputTests self){
    const HitTarget second = MakeUiControlInputHost(4u, 140.0f);
    ASSERT_TRUE(self.m_router.commitTargets(MakeUiControlSingleTarget(second), 1u));
    self.click(MakeUiControlCaretPoint(150.0f, 30.0f));
    self.m_targets[0u].focusOnCommit = true;
    Array<HitTarget, 2u> targets = Array<HitTarget, 2u>();
    targets[0u] = self.m_targets[0u];
    targets[1u] = second;
    ASSERT_TRUE(self.m_router.commitTargets(targets, 2u));
    EXPECT_EQ(self.m_router.focus(), second.id);
    const u64 preparedFocusLoss = self.m_router.focusLossGeneration();
    InputEvent focusLost = InputEvent();
    focusLost.type = InputEventType::FocusLost;
    EXPECT_TRUE(self.send(focusLost).commandConsumed);
    InputEvent focusGained = InputEvent();
    focusGained.type = InputEventType::FocusGained;
    EXPECT_FALSE(self.send(focusGained).commandConsumed);
    const Vector<PopupScope> noPopups = Vector<PopupScope>();
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 3u, noPopups, preparedFocusLoss));
    EXPECT_FALSE(self.m_router.focus().valid());
}

