#include <impl/ecs_ui/toolkit/edit/commands.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


interface IEditNavigationResolver{
    Expected<EditNavigationResult> resolve(in EditModel model, in EditNavigationDirection direction, in EditNavigationSnapshot preferred, in f32 viewportHeight);
}

class EditNavigationState : NoCopy{
    private u64 m_instanceGeneration;
    private u64 m_generation = 1u;
    private f32 m_preferredX = 0.0f;
    private b8 m_valid = false;

    public EditNavigationState(){
        this.m_instanceGeneration = AllocateServiceIdentity();
    }

    public u64 instanceGeneration()const{
        return this.m_instanceGeneration;
    }

    public u64 generation()const{
        return this.m_generation;
    }

    public f32 preferredX()const{
        return this.m_preferredX;
    }

    public b8 hasPreferredX()const{
        return this.m_valid;
    }

    public EditNavigationSnapshot snapshot()const{
        return EditNavigationSnapshot(this.m_instanceGeneration, this.m_generation, this.m_preferredX, this.m_valid);
    }

    public b8 matches(in EditNavigationSnapshot snapshot)const{
        return snapshot == this.snapshot();
    }

    public b8 setPreferredX(in f32 preferredX){
        const Expected<f32> resolved = TryResolveEditNavigationPreferredX(preferredX);
        if(!resolved.has_value())
            return false;
        this.m_preferredX = resolved.value();
        this.m_valid = true;
        AdvanceNonWrappingRevision(this.m_generation);
        return true;
    }

    public void reset(){
        AdvanceNonWrappingRevision(this.m_generation);
        ClearEditNavigationPreferredX(this.m_preferredX, this.m_valid);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

