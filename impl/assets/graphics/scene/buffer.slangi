#ifndef NWB_GRAPHICS_SCENE_BUFFER_SLANGI
#define NWB_GRAPHICS_SCENE_BUFFER_SLANGI


#include "binding_slots.h"


struct NwbSceneShadingBuffer{
    // xyz = camera world position, w = active light count.
    float4 g_NwbSceneCameraPosition;
};

// Scene shading and the light list are renderer-global heap resources. Every consumer provides the two uniform
// heap-slot expressions before including this header; local scene descriptor bindings are intentionally unsupported.
#if !defined(NWB_SCENE_SHADING_HEAP_SLOT) || !defined(NWB_SCENE_LIGHT_LIST_HEAP_SLOT)
#error "Renderer scene buffers require shading and light-list heap slots"
#endif

struct NwbSceneLight{
    // xyz = world position (point/spot), w = spot inner cone cosine.
    float4 position;
    // directional: toward-light; spot: emission axis. w = spot outer cone cosine.
    float4 direction;
    // xyz = color, w = intensity.
    float4 colorIntensity;
    // x = range, y = light type, z = shadow slot (negative = none), w = caustic slot (negative = none).
    float4 params;
    // Soft-shadow source size: x = directional angular radius (radians, cone half-angle), y = punctual source
    // radius (world units, emissive sphere). z/w reserved. The shadow trace jitters the ray over this source.
    float4 params2;
};

// Typed views of the shared heap StorageBuffer / UniformBuffer descriptor tables, exactly like the BVH-node and
// mesh-stream aliases (bindless_heap_bvh.slangi / bindless_heap_mesh.slangi): the element type/stride is a per-view
// SPIR-V decoration over the one Vulkan descriptor, so the scene-shading CB and light list are legible through the
// heap without a second registration. The selecting slot is uniform across the draw (one per frame), so no
// NonUniformResourceIndex() wrap is needed (mirrors the deferred image/sampler accessors).
#include "../bindless/bindless_heap.slangi"

#pragma warning(push)
#pragma warning(disable: 39001) // Deliberate typed views of the storage/uniform-buffer descriptor tables in bindless_heap.
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_STORAGE_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
StructuredBuffer<NwbSceneLight, Std430DataLayout> g_NwbHeapSceneLightBuffers[];
[[vk::binding(NWB_BINDLESS_HEAP_BINDING_UNIFORM_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
ConstantBuffer<NwbSceneShadingBuffer, Std140DataLayout> g_NwbHeapSceneShadingBuffers[];
#pragma warning(pop)

ConstantBuffer<NwbSceneShadingBuffer, Std140DataLayout> NwbHeapSceneShading(const uint slot){
    return g_NwbHeapSceneShadingBuffers[slot];
}

StructuredBuffer<NwbSceneLight, Std430DataLayout> NwbHeapSceneLights(const uint slot){
    return g_NwbHeapSceneLightBuffers[slot];
}

#define g_NwbSceneCameraPosition NwbHeapSceneShading(NWB_SCENE_SHADING_HEAP_SLOT).g_NwbSceneCameraPosition
#define g_NwbSceneLights NwbHeapSceneLights(NWB_SCENE_LIGHT_LIST_HEAP_SLOT)

uint nwbSceneLightCount(){
    return uint(max(g_NwbSceneCameraPosition.w, 0.0));
}


#endif


