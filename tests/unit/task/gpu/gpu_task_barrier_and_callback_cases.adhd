GpuTaskResourceUse GpuBarrier_MakeResourceUse(
    in GpuGraphResourceId resource,
    in GpuResourceStatesMask requiredState,
    in GpuResourceAccessEnum access
){
    GpuTaskResourceUse use = GpuTaskResourceUse();
    use.resource = resource;
    use.requiredState = requiredState;
    use.access = access;
    return use;
}

Expected<GpuTaskId> GpuBarrier_AddResourceTask(in Name identity, in AStringView label, in Span<GpuTaskResourceUse> resourceUses, mut GpuTaskGraph graph){
    const Span<GpuTaskId> emptyDeps = Span<GpuTaskId>();
    const Span<GpuTaskResourceSetUse> emptySets = Span<GpuTaskResourceSetUse>();
    const Span<GpuTaskResourceVersionUse> emptyVersions = Span<GpuTaskResourceVersionUse>();
    const Span<GpuExternalCompletionId> emptyExternals = Span<GpuExternalCompletionId>();
    return AddTask(identity, label, emptyDeps, resourceUses, emptySets, emptyVersions, emptyExternals, graph);
}

Optional<GpuCompiledBarrier> GpuBarrier_FindResourceBarrier(in Span<GpuCompiledBarrier> barriers, in GpuGraphResourceId resource){
    for(in GpuCompiledBarrier barrier : barriers){
        if(barrier.resource == resource)
            return Optional<GpuCompiledBarrier>(barrier);
    }
    return Optional<GpuCompiledBarrier>();
}

GpuTaskResourceUse GpuBarrier_BufferUse(
    in GpuGraphResourceId resource,
    in u64 offset,
    in u64 size,
    in GpuResourceStatesMask state,
    in GpuResourceAccessEnum access
){
    GpuTaskResourceUse use = GpuTaskResourceUse();
    use.resource = resource;
    use.range.bufferRange = BufferRange(offset, size);
    use.requiredState = state;
    use.access = access;
    return use;
}

GpuTaskResourceUse GpuBarrier_BufferWriteUse(in GpuGraphResourceId resource, in u64 offset, in u64 size, in GpuResourceStatesMask state){
    return GpuBarrier_BufferUse(resource, offset, size, state, GpuTaskResourceAccess::Write);
}

Expected<GpuTaskId> GpuBarrier_AddRangeTask(mut GpuTaskGraph graph, in Name identity, in Span<GpuTaskResourceUse> uses, in b8 compute){
    GpuTaskDesc desc = GpuTaskDesc();
    desc.setIdentity(identity);
    desc.setMarkerLabel("Buffer Range Task");
    desc.setResourceUses(uses);
    if(compute)
        return graph.addTask(desc, ComputeCommands());
    return graph.addTask(desc, GraphicsCommands());
}

Expected<GpuTaskId> GpuBarrier_AddRangeTask(mut GpuTaskGraph graph, in Name identity, in Span<GpuTaskResourceUse> uses){
    return GpuBarrier_AddRangeTask(graph, identity, uses, false);
}

Optional<GpuCompiledBarrier> GpuBarrier_FindRangeBarrier(
    in Span<GpuCompiledBarrier> barriers,
    in BufferRange range,
    in GpuCompiledBarrierTypeEnum type
){
    for(in GpuCompiledBarrier barrier : barriers){
        if(barrier.type == type && barrier.range.bufferRange == range)
            return Optional<GpuCompiledBarrier>(barrier);
    }
    return Optional<GpuCompiledBarrier>();
}

b8 GpuBarrier_HasFatalFailure(){
    return TestHasFatalFailure();
}

void VerifyGpuBarrier_ForcesMergedSameStateWriteDependenciesAcrossResourceKinds(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const auto textureCopyDestResult = AddTextureMetadata(graph, s_BarrierPlanningSameStateTextureCopyDest, "Same-state Texture Copy Destination");
    ASSERT_TRUE(textureCopyDestResult.has_value());
    const GpuGraphResourceId textureCopyDest = textureCopyDestResult.value();
    const auto bufferCopyDestResult = AddBufferMetadata(graph, s_BarrierPlanningSameStateBufferCopyDest, "Same-state Buffer Copy Destination");
    ASSERT_TRUE(bufferCopyDestResult.has_value());
    const GpuGraphResourceId bufferCopyDest = bufferCopyDestResult.value();
    const auto renderTargetResult = AddTextureMetadata(graph, s_BarrierPlanningSameStateRenderTarget, "Same-state Render Target");
    ASSERT_TRUE(renderTargetResult.has_value());
    const GpuGraphResourceId renderTarget = renderTargetResult.value();
    const auto depthWriteResult = AddTextureMetadata(graph, s_BarrierPlanningSameStateDepthWrite, "Same-state Depth Write");
    ASSERT_TRUE(depthWriteResult.has_value());
    const GpuGraphResourceId depthWrite = depthWriteResult.value();
    const auto accelStructWriteResult = AddAccelStructMetadata(graph, s_BarrierPlanningSameStateAccelStructWrite, "Same-state Acceleration Structure Write");
    ASSERT_TRUE(accelStructWriteResult.has_value());
    const GpuGraphResourceId accelStructWrite = accelStructWriteResult.value();
    const auto readOnlyResult = AddTextureMetadata(graph, s_BarrierPlanningSameStateReadOnly, "Same-state Read Only");
    ASSERT_TRUE(readOnlyResult.has_value());
    const GpuGraphResourceId readOnly = readOnlyResult.value();
    ASSERT_TRUE(textureCopyDest.valid());
    ASSERT_TRUE(bufferCopyDest.valid());
    ASSERT_TRUE(renderTarget.valid());
    ASSERT_TRUE(depthWrite.valid());
    ASSERT_TRUE(accelStructWrite.valid());
    ASSERT_TRUE(readOnly.valid());

    Array<GpuTaskResourceUse, 6> uses = Array<GpuTaskResourceUse, 6>();
    uses[0u] = GpuBarrier_MakeResourceUse(textureCopyDest, ResourceStates::CopyDest, GpuTaskResourceAccess::Write);
    uses[1u] = GpuBarrier_MakeResourceUse(bufferCopyDest, ResourceStates::CopyDest, GpuTaskResourceAccess::Write);
    uses[2u] = GpuBarrier_MakeResourceUse(renderTarget, ResourceStates::RenderTarget, GpuTaskResourceAccess::Write);
    uses[3u] = GpuBarrier_MakeResourceUse(depthWrite, ResourceStates::DepthWrite, GpuTaskResourceAccess::Write);
    uses[4u] = GpuBarrier_MakeResourceUse(accelStructWrite, ResourceStates::AccelStructWrite, GpuTaskResourceAccess::Write);
    uses[5u] = GpuBarrier_MakeResourceUse(readOnly, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read);

    GpuTaskDesc producerDesc = GpuTaskDesc();
    producerDesc.setIdentity(s_BarrierPlanningSameStateDependencyProducer);
    producerDesc.setMarkerLabel("Same-state Dependency Producer");
    producerDesc.setResourceUses(uses);
    const auto producerResult = graph.addTask(producerDesc);
    ASSERT_TRUE(producerResult.has_value());
    const GpuTaskId producer = producerResult.value();
    ASSERT_TRUE(producer.valid());

    GpuTaskSchedulingHint consumerScheduling = GpuTaskSchedulingHint();
    consumerScheduling.mergeWithPrevious = true;
    Array<GpuTaskId, 1> producerDeps = Array<GpuTaskId, 1>();
    producerDeps[0u] = producer;
    GpuTaskDesc consumerDesc = GpuTaskDesc();
    consumerDesc.setIdentity(s_BarrierPlanningSameStateDependencyConsumer);
    consumerDesc.setMarkerLabel("Same-state Dependency Consumer");
    consumerDesc.setScheduling(consumerScheduling);
    consumerDesc.setDependencies(producerDeps);
    consumerDesc.setResourceUses(uses);
    const auto consumerResult = graph.addTask(consumerDesc);
    ASSERT_TRUE(consumerResult.has_value());
    const GpuTaskId consumer = consumerResult.value();
    ASSERT_TRUE(consumer.valid());

    SingleQueueCompile singleQueueCompile = GpuBarrier_MakeSingleQueueCompile(testArena);
    ASSERT_TRUE(singleQueueCompile.compile(graph));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(singleQueueCompile.compiledGraph);

    const GpuCompiledTaskView producerView = compiledPlan.findTask(producer);
    const GpuCompiledTaskView consumerView = compiledPlan.findTask(consumer);
    const Optional<GpuCompiledTask> compiledProducer = GpuBarrier_TaskPlan(producerView);
    const Optional<GpuCompiledTask> compiledConsumer = GpuBarrier_TaskPlan(consumerView);
    ASSERT_TRUE(compiledProducer.has_value());
    ASSERT_TRUE(compiledConsumer.has_value());
    EXPECT_EQ(compiledProducer.value().packet, compiledConsumer.value().packet);
    ASSERT_EQ(compiledProducer.value().prologueBarrierCount, uses.size());
    ASSERT_EQ(compiledConsumer.value().prologueStateSeedCount, 0u);
    ASSERT_EQ(compiledConsumer.value().prologueBarrierCount, 5u);

    ASSERT_TRUE(GpuBarrier_HasPrologueBarriersPtr(producerView));
    ASSERT_TRUE(GpuBarrier_HasPrologueBarriersPtr(consumerView));
    const Span<GpuCompiledBarrier> producerBarriers = GpuBarrier_PrologueBarriers(producerView);
    const Span<GpuCompiledBarrier> consumerBarriers = GpuBarrier_PrologueBarriers(consumerView);
    for(in GpuCompiledBarrier barrier : producerBarriers)
        EXPECT_FALSE(barrier.forceMemoryDependency);

    Array<GpuGraphResourceId, 5> forcedResources = Array<GpuGraphResourceId, 5>();
    forcedResources[0u] = textureCopyDest;
    forcedResources[1u] = bufferCopyDest;
    forcedResources[2u] = renderTarget;
    forcedResources[3u] = depthWrite;
    forcedResources[4u] = accelStructWrite;
    Array<GpuResourceStatesMask, 5> forcedStates = Array<GpuResourceStatesMask, 5>();
    forcedStates[0u] = ResourceStates::CopyDest;
    forcedStates[1u] = ResourceStates::CopyDest;
    forcedStates[2u] = ResourceStates::RenderTarget;
    forcedStates[3u] = ResourceStates::DepthWrite;
    forcedStates[4u] = ResourceStates::AccelStructWrite;
    Array<GpuCompiledBarrierTypeEnum, 5> forcedTypes = Array<GpuCompiledBarrierTypeEnum, 5>();
    forcedTypes[0u] = GpuCompiledBarrierType::TextureTransition;
    forcedTypes[1u] = GpuCompiledBarrierType::BufferTransition;
    forcedTypes[2u] = GpuCompiledBarrierType::TextureTransition;
    forcedTypes[3u] = GpuCompiledBarrierType::TextureTransition;
    forcedTypes[4u] = GpuCompiledBarrierType::AccelStructTransition;

    for(usize forcedIndex = 0u; forcedIndex < forcedResources.size(); ++forcedIndex){
        const Optional<GpuCompiledBarrier> barrier = GpuBarrier_FindResourceBarrier(consumerBarriers, forcedResources[forcedIndex]);
        ASSERT_TRUE(barrier.has_value());
        EXPECT_EQ(barrier.value().type, forcedTypes[forcedIndex]);
        EXPECT_EQ(barrier.value().before, forcedStates[forcedIndex]);
        EXPECT_EQ(barrier.value().after, forcedStates[forcedIndex]);
        EXPECT_FALSE(barrier.value().isGraphInitialState);
        EXPECT_FALSE(barrier.value().isInitialOwnerHandoff);
        EXPECT_TRUE(barrier.value().forceMemoryDependency);
    }
    EXPECT_FALSE(GpuBarrier_FindResourceBarrier(consumerBarriers, readOnly).has_value());
}

void VerifyGpuBarrier_PlansPacketBoundaryTransitionsAndUavDependencies(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const auto textureResult = AddTextureMetadata(graph, s_BarrierPlanningPlannedTransitions, "Planned Transitions");
    ASSERT_TRUE(textureResult.has_value());
    const GpuGraphResourceId texture = textureResult.value();
    ASSERT_TRUE(texture.valid());

    Array<GpuTaskResourceUse, 1> writeUse = Array<GpuTaskResourceUse, 1>();
    writeUse[0u] = GpuBarrier_MakeResourceUse(texture, ResourceStates::UnorderedAccess, GpuTaskResourceAccess::Write);
    Array<GpuTaskResourceUse, 1> uavReadUse = Array<GpuTaskResourceUse, 1>();
    uavReadUse[0u] = GpuBarrier_MakeResourceUse(texture, ResourceStates::UnorderedAccess, GpuTaskResourceAccess::Read);
    Array<GpuTaskResourceUse, 1> shaderReadUse = Array<GpuTaskResourceUse, 1>();
    shaderReadUse[0u] = GpuBarrier_MakeResourceUse(texture, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read);

    const auto writerResult = GpuBarrier_AddResourceTask(s_BarrierPlanningPlannedWriter, "Writer", writeUse, graph);
    ASSERT_TRUE(writerResult.has_value());
    const GpuTaskId writer = writerResult.value();
    const auto uavReaderResult = GpuBarrier_AddResourceTask(s_BarrierPlanningPlannedUavReader, "UAV Reader", uavReadUse, graph);
    ASSERT_TRUE(uavReaderResult.has_value());
    const GpuTaskId uavReader = uavReaderResult.value();
    const auto shaderReaderResult = GpuBarrier_AddResourceTask(s_BarrierPlanningPlannedShaderReader, "Shader Reader", shaderReadUse, graph);
    ASSERT_TRUE(shaderReaderResult.has_value());
    const GpuTaskId shaderReader = shaderReaderResult.value();
    ASSERT_TRUE(writer.valid());
    ASSERT_TRUE(uavReader.valid());
    ASSERT_TRUE(shaderReader.valid());

    SingleQueueCompile singleQueueCompile = GpuBarrier_MakeSingleQueueCompile(testArena);
    ASSERT_TRUE(singleQueueCompile.compile(graph));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(singleQueueCompile.compiledGraph);

    const GpuCompiledTaskView writerView = compiledPlan.findTask(writer);
    const GpuCompiledTaskView uavView = compiledPlan.findTask(uavReader);
    const GpuCompiledTaskView shaderView = compiledPlan.findTask(shaderReader);
    const Optional<GpuCompiledTask> compiledWriter = GpuBarrier_TaskPlan(writerView);
    const Optional<GpuCompiledTask> compiledUavReader = GpuBarrier_TaskPlan(uavView);
    const Optional<GpuCompiledTask> compiledShaderReader = GpuBarrier_TaskPlan(shaderView);
    ASSERT_TRUE(compiledWriter.has_value());
    ASSERT_TRUE(compiledUavReader.has_value());
    ASSERT_TRUE(compiledShaderReader.has_value());
    ASSERT_EQ(compiledWriter.value().prologueStateSeedCount, 0u);
    ASSERT_EQ(compiledUavReader.value().prologueStateSeedCount, 1u);
    ASSERT_EQ(compiledShaderReader.value().prologueStateSeedCount, 1u);
    ASSERT_EQ(compiledWriter.value().prologueBarrierCount, 1u);
    ASSERT_EQ(compiledUavReader.value().prologueBarrierCount, 1u);
    ASSERT_EQ(compiledShaderReader.value().prologueBarrierCount, 1u);

    const Span<GpuCompiledBarrier> writerBarriers = GpuBarrier_PrologueBarriers(writerView);
    const Span<GpuCompiledBarrier> uavBarriers = GpuBarrier_PrologueBarriers(uavView);
    const Span<GpuCompiledBarrier> shaderBarriers = GpuBarrier_PrologueBarriers(shaderView);
    const Span<GpuPacketStateSeed> uavSeeds = GpuBarrier_PrologueSeeds(uavView);
    const Span<GpuPacketStateSeed> shaderSeeds = GpuBarrier_PrologueSeeds(shaderView);
    ASSERT_EQ(writerBarriers.size(), 1u);
    ASSERT_EQ(uavBarriers.size(), 1u);
    ASSERT_EQ(shaderBarriers.size(), 1u);
    ASSERT_EQ(uavSeeds.size(), 1u);
    ASSERT_EQ(shaderSeeds.size(), 1u);
    EXPECT_EQ(uavSeeds[0u].resource, texture);
    EXPECT_EQ(uavSeeds[0u].sourcePacket, compiledWriter.value().packet);
    EXPECT_EQ(shaderSeeds[0u].resource, texture);
    EXPECT_EQ(shaderSeeds[0u].sourcePacket, compiledUavReader.value().packet);
    EXPECT_EQ(writerBarriers[0u].type, GpuCompiledBarrierType::TextureTransition);
    EXPECT_EQ(writerBarriers[0u].before, ResourceStates::Common);
    EXPECT_EQ(writerBarriers[0u].after, ResourceStates::UnorderedAccess);
    EXPECT_FALSE(writerBarriers[0u].forceMemoryDependency);
    EXPECT_EQ(uavBarriers[0u].type, GpuCompiledBarrierType::TextureUav);
    EXPECT_EQ(uavBarriers[0u].before, ResourceStates::UnorderedAccess);
    EXPECT_EQ(uavBarriers[0u].after, ResourceStates::UnorderedAccess);
    EXPECT_TRUE(uavBarriers[0u].forceMemoryDependency);
    EXPECT_EQ(shaderBarriers[0u].type, GpuCompiledBarrierType::TextureTransition);
    EXPECT_EQ(shaderBarriers[0u].before, ResourceStates::UnorderedAccess);
    EXPECT_EQ(shaderBarriers[0u].after, ResourceStates::ShaderResource);
    EXPECT_FALSE(shaderBarriers[0u].forceMemoryDependency);
}

void VerifyGpuBarrier_PlansCompositeUavDependencies(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const auto textureResult = AddTextureMetadata(graph, s_BarrierPlanningCompositeUavTexture, "Composite UAV Texture");
    ASSERT_TRUE(textureResult.has_value());
    const GpuGraphResourceId texture = textureResult.value();
    const auto bufferResult = AddBufferMetadata(graph, s_BarrierPlanningCompositeUavBuffer, "Composite UAV Buffer");
    ASSERT_TRUE(bufferResult.has_value());
    const GpuGraphResourceId buffer = bufferResult.value();
    ASSERT_TRUE(texture.valid());
    ASSERT_TRUE(buffer.valid());

    const GpuResourceStatesMask compositeState = ResourceStates::UnorderedAccess | ResourceStates::ShaderResource;
    Array<GpuTaskResourceUse, 2> producerUses = Array<GpuTaskResourceUse, 2>();
    producerUses[0u] = GpuBarrier_MakeResourceUse(texture, compositeState, GpuTaskResourceAccess::Write);
    producerUses[1u] = GpuBarrier_MakeResourceUse(buffer, compositeState, GpuTaskResourceAccess::Write);
    Array<GpuTaskResourceUse, 2> consumerUses = Array<GpuTaskResourceUse, 2>();
    consumerUses[0u] = GpuBarrier_MakeResourceUse(texture, compositeState, GpuTaskResourceAccess::Read);
    consumerUses[1u] = GpuBarrier_MakeResourceUse(buffer, compositeState, GpuTaskResourceAccess::Read);

    const auto producerResult = GpuBarrier_AddResourceTask(s_BarrierPlanningCompositeUavProducer, "Composite UAV Producer", producerUses, graph);
    ASSERT_TRUE(producerResult.has_value());
    const GpuTaskId producer = producerResult.value();
    const auto consumerResult = GpuBarrier_AddResourceTask(s_BarrierPlanningCompositeUavConsumer, "Composite UAV Consumer", consumerUses, graph);
    ASSERT_TRUE(consumerResult.has_value());
    const GpuTaskId consumer = consumerResult.value();
    ASSERT_TRUE(producer.valid());
    ASSERT_TRUE(consumer.valid());

    SingleQueueCompile singleQueueCompile = GpuBarrier_MakeSingleQueueCompile(testArena);
    ASSERT_TRUE(singleQueueCompile.compile(graph));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(singleQueueCompile.compiledGraph);

    const GpuCompiledTaskView producerView = compiledPlan.findTask(producer);
    const GpuCompiledTaskView consumerView = compiledPlan.findTask(consumer);
    const Optional<GpuCompiledTask> compiledProducer = GpuBarrier_TaskPlan(producerView);
    const Optional<GpuCompiledTask> compiledConsumer = GpuBarrier_TaskPlan(consumerView);
    ASSERT_TRUE(compiledProducer.has_value());
    ASSERT_TRUE(compiledConsumer.has_value());
    ASSERT_EQ(compiledConsumer.value().prologueStateSeedCount, 2u);
    ASSERT_EQ(compiledConsumer.value().prologueBarrierCount, 2u);

    const Span<GpuCompiledBarrier> consumerBarriers = GpuBarrier_PrologueBarriers(consumerView);
    ASSERT_EQ(consumerBarriers.size(), 2u);
    b8 hasTextureUavBarrier = false;
    b8 hasBufferUavBarrier = false;
    for(in GpuCompiledBarrier barrier : consumerBarriers){
        if(barrier.resource == texture && barrier.type == GpuCompiledBarrierType::TextureUav && barrier.before == compositeState && barrier.after == compositeState)
            hasTextureUavBarrier = true;
        if(barrier.resource == buffer && barrier.type == GpuCompiledBarrierType::BufferUav && barrier.before == compositeState && barrier.after == compositeState)
            hasBufferUavBarrier = true;
    }
    EXPECT_TRUE(hasTextureUavBarrier);
    EXPECT_TRUE(hasBufferUavBarrier);
}

void VerifyGpuBarrier_TracksFinalOverlappingIntraTaskTextureStateForConsumersAndExports(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    Array<GpuPhysicalQueueInfo, 1> queues = Array<GpuPhysicalQueueInfo, 1>();
    queues[0u] = GraphicsQueue();
    const GpuPhysicalQueueTopology topology = GpuBarrier_MakeTopology(queues);

    {
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        const auto textureResult = AddTextureMetadata(graph, s_BarrierPlanningIntraTaskFinalStateConsumer, "Intra-Task Final State Consumer");
        ASSERT_TRUE(textureResult.has_value());
        const GpuGraphResourceId texture = textureResult.value();
        ASSERT_TRUE(texture.valid());

        Array<GpuTaskResourceUse, 2> producerUses = Array<GpuTaskResourceUse, 2>();
        producerUses[0u] = GpuBarrier_MakeResourceUse(texture, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read);
        producerUses[1u] = GpuBarrier_MakeResourceUse(texture, ResourceStates::RenderTarget, GpuTaskResourceAccess::Write);
        Array<GpuTaskResourceUse, 1> consumerUses = Array<GpuTaskResourceUse, 1>();
        consumerUses[0u] = GpuBarrier_MakeResourceUse(texture, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read);

        const auto producerResult = GpuBarrier_AddResourceTask(s_BarrierPlanningIntraTaskFinalStateProducer, "Intra-Task Final State Producer", producerUses, graph);
        ASSERT_TRUE(producerResult.has_value());
        const GpuTaskId producer = producerResult.value();
        const auto consumerResult = GpuBarrier_AddResourceTask(s_BarrierPlanningIntraTaskFinalStateConsumerTask, "Intra-Task Final State Consumer Task", consumerUses, graph);
        ASSERT_TRUE(consumerResult.has_value());
        const GpuTaskId consumer = consumerResult.value();
        ASSERT_TRUE(producer.valid());
        ASSERT_TRUE(consumer.valid());

        GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
        GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
        GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
        ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
        const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

        const GpuCompiledTaskView compiledProducerView = compiledPlan.findTask(producer);
        const GpuCompiledTaskView compiledConsumerView = compiledPlan.findTask(consumer);
        const Optional<GpuCompiledTask> compiledProducer = GpuBarrier_TaskPlan(compiledProducerView);
        const Optional<GpuCompiledTask> compiledConsumer = GpuBarrier_TaskPlan(compiledConsumerView);
        ASSERT_TRUE(compiledProducer.has_value());
        ASSERT_TRUE(compiledConsumer.has_value());
        EXPECT_NE(compiledProducer.value().packet, compiledConsumer.value().packet);
        ASSERT_EQ(compiledProducer.value().prologueBarrierCount, 1u);
        ASSERT_EQ(compiledConsumer.value().prologueStateSeedCount, 1u);
        ASSERT_EQ(compiledConsumer.value().prologueBarrierCount, 1u);

        const Span<GpuCompiledBarrier> producerBarriers = GpuBarrier_PrologueBarriers(compiledProducerView);
        const Span<GpuPacketStateSeed> consumerSeeds = GpuBarrier_PrologueSeeds(compiledConsumerView);
        const Span<GpuCompiledBarrier> consumerBarriers = GpuBarrier_PrologueBarriers(compiledConsumerView);
        ASSERT_EQ(producerBarriers.size(), 1u);
        ASSERT_EQ(consumerSeeds.size(), 1u);
        ASSERT_EQ(consumerBarriers.size(), 1u);
        EXPECT_EQ(producerBarriers[0u].after, ResourceStates::ShaderResource);
        EXPECT_EQ(consumerSeeds[0u].sourcePacket, compiledProducer.value().packet);
        EXPECT_EQ(consumerBarriers[0u].type, GpuCompiledBarrierType::TextureTransition);
        EXPECT_EQ(consumerBarriers[0u].before, ResourceStates::RenderTarget);
        EXPECT_EQ(consumerBarriers[0u].after, ResourceStates::ShaderResource);
    }

    {
        GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
        GpuGraphResourceDesc desc = GpuGraphResourceDesc();
        desc.setIdentity(s_BarrierPlanningIntraTaskFinalStateExport);
        desc.setMarkerLabel("Intra-Task Final State Export");
        desc.setType(GpuGraphResourceType::Texture);
        desc.setInitialState(ResourceStates::Common);
        desc.setExternalFinalState(ResourceStates::ShaderResource);
        const auto textureResult = graph.importResource(desc);
        ASSERT_TRUE(textureResult.has_value());
        const GpuGraphResourceId texture = textureResult.value();
        ASSERT_TRUE(texture.valid());

        Array<GpuTaskResourceUse, 2> uses = Array<GpuTaskResourceUse, 2>();
        uses[0u] = GpuBarrier_MakeResourceUse(texture, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read);
        uses[1u] = GpuBarrier_MakeResourceUse(texture, ResourceStates::RenderTarget, GpuTaskResourceAccess::Write);
        const auto producerResult = GpuBarrier_AddResourceTask(s_BarrierPlanningIntraTaskFinalStateExportTask, "Intra-Task Final State Export Task", uses, graph);
        ASSERT_TRUE(producerResult.has_value());
        const GpuTaskId producer = producerResult.value();
        ASSERT_TRUE(producer.valid());

        GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
        GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
        GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
        ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
        const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

        const GpuCompiledTaskView compiledProducerView = compiledPlan.findTask(producer);
        const Optional<GpuCompiledTask> compiledProducer = GpuBarrier_TaskPlan(compiledProducerView);
        ASSERT_TRUE(compiledProducer.has_value());
        ASSERT_EQ(compiledProducer.value().epilogueBarrierCount, 1u);
        const Span<GpuCompiledBarrier> exportBarriers = GpuBarrier_EpilogueBarriers(compiledProducerView);
        ASSERT_EQ(exportBarriers.size(), 1u);
        EXPECT_EQ(exportBarriers[0u].type, GpuCompiledBarrierType::TextureStateExport);
        EXPECT_EQ(exportBarriers[0u].before, ResourceStates::RenderTarget);
        EXPECT_EQ(exportBarriers[0u].after, ResourceStates::ShaderResource);
    }
}

void VerifyGpuBarrier_PlansGraphInitialStateForUncoveredLaterTextureSubresourcesWithinTask(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    Array<GpuPhysicalQueueInfo, 1> queues = Array<GpuPhysicalQueueInfo, 1>();
    queues[0u] = GraphicsQueue();
    const GpuPhysicalQueueTopology topology = GpuBarrier_MakeTopology(queues);

    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    GpuGraphResourceDesc desc = GpuGraphResourceDesc();
    desc.setIdentity(s_BarrierPlanningIntraTaskFirstUseTextureTail);
    desc.setMarkerLabel("Intra-Task First-Use Texture Tail");
    desc.setType(GpuGraphResourceType::Texture);
    desc.setInitialState(ResourceStates::CopySource);
    const auto textureResult = graph.importResource(desc);
    ASSERT_TRUE(textureResult.has_value());
    const GpuGraphResourceId texture = textureResult.value();
    ASSERT_TRUE(texture.valid());

    GpuTaskResourceRange mipZeroRange = GpuTaskResourceRange();
    mipZeroRange.textureSubresources = TextureSubresourceSet(0u, 1u, 0u, TextureSubresourceSet::s_AllArraySlices);
    GpuTaskResourceRange allMipsRange = GpuTaskResourceRange();
    allMipsRange.textureSubresources = s_AllSubresources;
    GpuTaskResourceRange unplannedTailRange = GpuTaskResourceRange();
    unplannedTailRange.textureSubresources = TextureSubresourceSet(1u, TextureSubresourceSet::s_AllMipLevels, 0u, TextureSubresourceSet::s_AllArraySlices);

    Array<GpuTaskResourceUse, 2> uses = Array<GpuTaskResourceUse, 2>();
    uses[0u] = GpuBarrier_MakeResourceUse(texture, ResourceStates::CopyDest, GpuTaskResourceAccess::Write);
    uses[0u].range = mipZeroRange;
    uses[1u] = GpuBarrier_MakeResourceUse(texture, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read);
    uses[1u].range = allMipsRange;
    const auto taskResult = GpuBarrier_AddResourceTask(s_BarrierPlanningIntraTaskFirstUseTextureTailTask, "Intra-Task First-Use Texture Tail Task", uses, graph);
    ASSERT_TRUE(taskResult.has_value());
    const GpuTaskId task = taskResult.value();
    ASSERT_TRUE(task.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

    const GpuCompiledTaskView taskView = compiledPlan.findTask(task);
    const Optional<GpuCompiledTask> compiledTask = GpuBarrier_TaskPlan(taskView);
    ASSERT_TRUE(compiledTask.has_value());
    ASSERT_EQ(compiledTask.value().prologueBarrierCount, 2u);
    const Span<GpuCompiledBarrier> barriers = GpuBarrier_PrologueBarriers(taskView);
    ASSERT_EQ(barriers.size(), 2u);

    b8 hasMipZeroInitialBarrier = false;
    b8 hasTailInitialBarrier = false;
    for(in GpuCompiledBarrier barrier : barriers){
        if(
            barrier.type == GpuCompiledBarrierType::TextureTransition
            && barrier.resource == texture
            && barrier.before == ResourceStates::CopySource
            && barrier.after == ResourceStates::CopyDest
            && barrier.isGraphInitialState
            && barrier.range.textureSubresources == mipZeroRange.textureSubresources
        )
            hasMipZeroInitialBarrier = true;
        if(
            barrier.type == GpuCompiledBarrierType::TextureTransition
            && barrier.resource == texture
            && barrier.before == ResourceStates::CopySource
            && barrier.after == ResourceStates::ShaderResource
            && barrier.isGraphInitialState
            && barrier.range.textureSubresources == unplannedTailRange.textureSubresources
        )
            hasTailInitialBarrier = true;
    }
    EXPECT_TRUE(hasMipZeroInitialBarrier);
    EXPECT_TRUE(hasTailInitialBarrier);
}

Expected<GpuTaskId> GpuBarrier_AddBoundaryReadTask(
    in Name identity,
    in AStringView label,
    in GpuGraphResourceId resource,
    in GpuTaskCommandRequirements commands,
    in b8 hasIndependentStateSource,
    mut GpuTaskGraph graph
){
    GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
    scheduling.forceSubmissionBoundary = true;
    scheduling.allowPacketMerge = false;
    Array<GpuTaskResourceUse, 1> uses = Array<GpuTaskResourceUse, 1>();
    uses[0u] = GpuBarrier_MakeResourceUse(resource, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read);
    uses[0u].hasIndependentStateSource = hasIndependentStateSource;
    GpuTaskDesc desc = GpuTaskDesc();
    desc.setIdentity(identity);
    desc.setMarkerLabel(label);
    desc.setScheduling(scheduling);
    desc.setResourceUses(uses);
    return graph.addTask(desc, commands);
}

void VerifyGpuBarrier_AllowsIndependentConcurrentReadStateSources(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);

    const auto concurrentTextureResult = AddTextureMetadata(
        graph,
        s_BarrierPlanningConcurrentReadOnly,
        "Concurrent Read Only",
        ResourceStates::ShaderResource,
        ResourceQueueSharing::GraphicsAndAsyncCompute
    );
    ASSERT_TRUE(concurrentTextureResult.has_value());
    const GpuGraphResourceId concurrentTexture = concurrentTextureResult.value();
    const auto defaultConcurrentTextureResult = AddTextureMetadata(
        graph,
        s_BarrierPlanningDefaultConcurrentReadOnly,
        "Default Concurrent Read Only",
        ResourceStates::Common,
        ResourceQueueSharing::GraphicsAndAsyncCompute
    );
    ASSERT_TRUE(defaultConcurrentTextureResult.has_value());
    const GpuGraphResourceId defaultConcurrentTexture = defaultConcurrentTextureResult.value();
    const auto exclusiveTextureResult = AddTextureMetadata(
        graph,
        s_BarrierPlanningExclusiveReadOnly,
        "Exclusive Read Only",
        ResourceStates::Common,
        ResourceQueueSharing::Exclusive
    );
    ASSERT_TRUE(exclusiveTextureResult.has_value());
    const GpuGraphResourceId exclusiveTexture = exclusiveTextureResult.value();
    ASSERT_TRUE(concurrentTexture.valid());
    ASSERT_TRUE(defaultConcurrentTexture.valid());
    ASSERT_TRUE(exclusiveTexture.valid());

    const GpuTaskCommandRequirements graphicsCommands = GraphicsCommands();
    const GpuTaskCommandRequirements computeCommands = ComputeCommands();
    const auto concurrentGraphicsResult = GpuBarrier_AddBoundaryReadTask(
        s_BarrierPlanningConcurrentReadGraphics,
        "Concurrent Graphics Read",
        concurrentTexture,
        graphicsCommands,
        false,
        graph
    );
    ASSERT_TRUE(concurrentGraphicsResult.has_value());
    const GpuTaskId concurrentGraphics = concurrentGraphicsResult.value();
    const auto concurrentComputeResult = GpuBarrier_AddBoundaryReadTask(
        s_BarrierPlanningConcurrentReadCompute,
        "Concurrent Compute Read",
        concurrentTexture,
        computeCommands,
        true,
        graph
    );
    ASSERT_TRUE(concurrentComputeResult.has_value());
    const GpuTaskId concurrentCompute = concurrentComputeResult.value();
    const auto defaultConcurrentGraphicsResult = GpuBarrier_AddBoundaryReadTask(
        s_BarrierPlanningDefaultConcurrentReadGraphics,
        "Default Concurrent Graphics Read",
        defaultConcurrentTexture,
        graphicsCommands,
        false,
        graph
    );
    ASSERT_TRUE(defaultConcurrentGraphicsResult.has_value());
    const GpuTaskId defaultConcurrentGraphics = defaultConcurrentGraphicsResult.value();
    const auto defaultConcurrentComputeResult = GpuBarrier_AddBoundaryReadTask(
        s_BarrierPlanningDefaultConcurrentReadCompute,
        "Default Concurrent Compute Read",
        defaultConcurrentTexture,
        computeCommands,
        false,
        graph
    );
    ASSERT_TRUE(defaultConcurrentComputeResult.has_value());
    const GpuTaskId defaultConcurrentCompute = defaultConcurrentComputeResult.value();
    const auto exclusiveGraphicsResult = GpuBarrier_AddBoundaryReadTask(
        s_BarrierPlanningExclusiveReadGraphics,
        "Exclusive Graphics Read",
        exclusiveTexture,
        graphicsCommands,
        false,
        graph
    );
    ASSERT_TRUE(exclusiveGraphicsResult.has_value());
    const GpuTaskId exclusiveGraphics = exclusiveGraphicsResult.value();
    const auto exclusiveComputeResult = GpuBarrier_AddBoundaryReadTask(
        s_BarrierPlanningExclusiveReadCompute,
        "Exclusive Compute Read",
        exclusiveTexture,
        computeCommands,
        true,
        graph
    );
    ASSERT_TRUE(exclusiveComputeResult.has_value());
    const GpuTaskId exclusiveCompute = exclusiveComputeResult.value();
    ASSERT_TRUE(concurrentGraphics.valid());
    ASSERT_TRUE(concurrentCompute.valid());
    ASSERT_TRUE(defaultConcurrentGraphics.valid());
    ASSERT_TRUE(defaultConcurrentCompute.valid());
    ASSERT_TRUE(exclusiveGraphics.valid());
    ASSERT_TRUE(exclusiveCompute.valid());

    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    const GpuPhysicalQueueTopology topology = GpuBarrier_MakeTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    EXPECT_FALSE(GpuBarrier_HasEdge(analysis, concurrentGraphics, concurrentCompute));
    EXPECT_FALSE(GpuBarrier_HasEdge(analysis, defaultConcurrentGraphics, defaultConcurrentCompute));
    EXPECT_FALSE(GpuBarrier_HasEdge(analysis, exclusiveGraphics, exclusiveCompute));

    {
        const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

        ASSERT_EQ(compiledPlan.packetCount(), 6u);
        const GpuSubmissionPacketId concurrentGraphicsPacket = compiledPlan.packetForTask(concurrentGraphics);
        const GpuSubmissionPacketId concurrentComputePacket = compiledPlan.packetForTask(concurrentCompute);
        const GpuSubmissionPacketId defaultConcurrentGraphicsPacket = compiledPlan.packetForTask(defaultConcurrentGraphics);
        const GpuSubmissionPacketId defaultConcurrentComputePacket = compiledPlan.packetForTask(defaultConcurrentCompute);
        const GpuSubmissionPacketId exclusiveGraphicsPacket = compiledPlan.packetForTask(exclusiveGraphics);
        const GpuSubmissionPacketId exclusiveComputePacket = compiledPlan.packetForTask(exclusiveCompute);
        ASSERT_TRUE(concurrentGraphicsPacket.valid());
        ASSERT_TRUE(concurrentComputePacket.valid());
        ASSERT_TRUE(defaultConcurrentGraphicsPacket.valid());
        ASSERT_TRUE(defaultConcurrentComputePacket.valid());
        ASSERT_TRUE(exclusiveGraphicsPacket.valid());
        ASSERT_TRUE(exclusiveComputePacket.valid());
        EXPECT_EQ(compiledPlan.packetIdAt(0u), concurrentGraphicsPacket);
        EXPECT_EQ(compiledPlan.packetIdAt(1u), concurrentComputePacket);
        EXPECT_EQ(compiledPlan.packetIdAt(2u), defaultConcurrentGraphicsPacket);
        EXPECT_EQ(compiledPlan.packetIdAt(3u), defaultConcurrentComputePacket);
        EXPECT_EQ(compiledPlan.packetIdAt(4u), exclusiveGraphicsPacket);
        EXPECT_EQ(compiledPlan.packetIdAt(5u), exclusiveComputePacket);

        const GpuCompiledTaskView concurrentComputeView = compiledPlan.findTask(concurrentCompute);
        const GpuCompiledTaskView defaultConcurrentComputeView = compiledPlan.findTask(defaultConcurrentCompute);
        const GpuCompiledTaskView exclusiveGraphicsView = compiledPlan.findTask(exclusiveGraphics);
        const GpuCompiledTaskView exclusiveComputeView = compiledPlan.findTask(exclusiveCompute);
        const Optional<GpuCompiledTask> compiledConcurrentCompute = GpuBarrier_TaskPlan(concurrentComputeView);
        const Optional<GpuCompiledTask> compiledDefaultConcurrentCompute = GpuBarrier_TaskPlan(defaultConcurrentComputeView);
        const Optional<GpuCompiledTask> compiledExclusiveGraphics = GpuBarrier_TaskPlan(exclusiveGraphicsView);
        const Optional<GpuCompiledTask> compiledExclusiveCompute = GpuBarrier_TaskPlan(exclusiveComputeView);
        ASSERT_TRUE(compiledConcurrentCompute.has_value());
        ASSERT_TRUE(compiledDefaultConcurrentCompute.has_value());
        ASSERT_TRUE(compiledExclusiveGraphics.has_value());
        ASSERT_TRUE(compiledExclusiveCompute.has_value());
        EXPECT_EQ(compiledConcurrentCompute.value().prologueStateSeedCount, 0u);
        ASSERT_EQ(compiledDefaultConcurrentCompute.value().prologueStateSeedCount, 1u);
        ASSERT_EQ(compiledExclusiveCompute.value().prologueStateSeedCount, 1u);
        EXPECT_EQ(compiledConcurrentCompute.value().prologueBarrierCount, 0u);
        EXPECT_EQ(compiledDefaultConcurrentCompute.value().prologueBarrierCount, 0u);
        ASSERT_EQ(compiledExclusiveCompute.value().prologueBarrierCount, 1u);
        ASSERT_EQ(compiledExclusiveGraphics.value().epilogueBarrierCount, 1u);

        EXPECT_FALSE(GpuBarrier_HasPrologueSeedsPtr(concurrentComputeView));
        const Span<GpuPacketStateSeed> defaultConcurrentSeeds = GpuBarrier_PrologueSeeds(defaultConcurrentComputeView);
        const Span<GpuPacketStateSeed> exclusiveSeeds = GpuBarrier_PrologueSeeds(exclusiveComputeView);
        const Span<GpuCompiledBarrier> exclusiveAcquires = GpuBarrier_PrologueBarriers(exclusiveComputeView);
        const Span<GpuCompiledBarrier> exclusiveReleases = GpuBarrier_EpilogueBarriers(exclusiveGraphicsView);
        ASSERT_EQ(defaultConcurrentSeeds.size(), 1u);
        ASSERT_EQ(exclusiveSeeds.size(), 1u);
        ASSERT_EQ(exclusiveAcquires.size(), 1u);
        ASSERT_EQ(exclusiveReleases.size(), 1u);
        EXPECT_EQ(defaultConcurrentSeeds[0u].sourcePacket, defaultConcurrentGraphicsPacket);
        EXPECT_EQ(exclusiveSeeds[0u].sourcePacket, exclusiveGraphicsPacket);
        EXPECT_EQ(exclusiveAcquires[0u].type, GpuCompiledBarrierType::TextureOwnershipAcquire);
        EXPECT_EQ(exclusiveAcquires[0u].sourceQueue, compiledExclusiveGraphics.value().queue);
        EXPECT_EQ(exclusiveAcquires[0u].destinationQueue, compiledExclusiveCompute.value().queue);
        EXPECT_FALSE(exclusiveAcquires[0u].isInitialOwnerHandoff);
        EXPECT_EQ(exclusiveReleases[0u].type, GpuCompiledBarrierType::TextureOwnershipRelease);
        EXPECT_EQ(exclusiveReleases[0u].sourceQueue, compiledExclusiveGraphics.value().queue);
        EXPECT_EQ(exclusiveReleases[0u].destinationQueue, compiledExclusiveCompute.value().queue);

        const Optional<GpuSubmissionPacket> concurrentComputePacketPlan = GpuBarrier_PacketPlan(compiledPlan.packet(concurrentComputePacket));
        ASSERT_TRUE(concurrentComputePacketPlan.has_value());
        EXPECT_EQ(concurrentComputePacketPlan.value().dependencyCount, 0u);

        const GpuCompiledPacketView defaultConcurrentComputePacketView = compiledPlan.packet(defaultConcurrentComputePacket);
        ASSERT_TRUE(defaultConcurrentComputePacketView.valid());
        const Span<GpuPacketDependency> defaultConcurrentDeps = GpuBarrier_PacketDependencies(defaultConcurrentComputePacketView);
        ASSERT_EQ(defaultConcurrentDeps.size(), 1u);
        EXPECT_EQ(defaultConcurrentDeps[0u].producer, defaultConcurrentGraphicsPacket);

        const GpuCompiledPacketView exclusiveComputePacketView = compiledPlan.packet(exclusiveComputePacket);
        ASSERT_TRUE(exclusiveComputePacketView.valid());
        const Span<GpuPacketDependency> exclusiveDeps = GpuBarrier_PacketDependencies(exclusiveComputePacketView);
        ASSERT_EQ(exclusiveDeps.size(), 1u);
        EXPECT_EQ(exclusiveDeps[0u].producer, exclusiveGraphicsPacket);
    }

    // Queues in one family retain exclusive ownership and require a handoff even with combined sharing flags.
    GpuPhysicalQueueInfo sameFamilyComputeQueue = DedicatedComputeQueue();
    sameFamilyComputeQueue.familyIndex = GraphicsQueue().familyIndex;
    sameFamilyComputeQueue.queueIndex = 1u;
    Array<GpuPhysicalQueueInfo, 2> sameFamilyQueues = Array<GpuPhysicalQueueInfo, 2>();
    sameFamilyQueues[0u] = GraphicsQueue();
    sameFamilyQueues[1u] = sameFamilyComputeQueue;
    const GpuPhysicalQueueTopology sameFamilyTopology = GpuBarrier_MakeTopology(sameFamilyQueues);
    GpuTaskGraphAnalysis sameFamilyAnalysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments sameFamilyAssignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph sameFamilyCompiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(sameFamilyAnalysis, sameFamilyAssignments, sameFamilyCompiledGraph, operationScratchArena, graph, sameFamilyTopology));
    const GpuCompiledGraphReadView sameFamilyPlan = GpuCompiledGraphReadView(sameFamilyCompiledGraph);
    const GpuSubmissionPacketId sameFamilyGraphicsPacket = sameFamilyPlan.packetForTask(concurrentGraphics);
    const GpuSubmissionPacketId sameFamilyComputePacket = sameFamilyPlan.packetForTask(concurrentCompute);
    const GpuCompiledTaskView sameFamilyCompiledComputeView = sameFamilyPlan.findTask(concurrentCompute);
    const Optional<GpuCompiledTask> sameFamilyCompiledCompute = GpuBarrier_TaskPlan(sameFamilyCompiledComputeView);
    ASSERT_TRUE(sameFamilyGraphicsPacket.valid());
    ASSERT_TRUE(sameFamilyComputePacket.valid());
    ASSERT_TRUE(sameFamilyCompiledCompute.has_value());
    ASSERT_EQ(sameFamilyCompiledCompute.value().prologueStateSeedCount, 1u);
    const Span<GpuPacketStateSeed> sameFamilySeeds = GpuBarrier_PrologueSeeds(sameFamilyCompiledComputeView);
    ASSERT_EQ(sameFamilySeeds.size(), 1u);
    EXPECT_EQ(sameFamilySeeds[0u].sourcePacket, sameFamilyGraphicsPacket);
    const GpuCompiledPacketView sameFamilyComputePacketView = sameFamilyPlan.packet(sameFamilyComputePacket);
    ASSERT_TRUE(sameFamilyComputePacketView.valid());
    const Span<GpuPacketDependency> sameFamilyDeps = GpuBarrier_PacketDependencies(sameFamilyComputePacketView);
    ASSERT_EQ(sameFamilyDeps.size(), 1u);
    EXPECT_EQ(sameFamilyDeps[0u].producer, sameFamilyGraphicsPacket);
}

void VerifyGpuBarrier_IndependentIntervalsKeepSeparateInitialStates(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const auto bufferResult = AddBufferMetadata(graph, s_GpuCaseBufferRangeIndependent, "Independent Bytes");
    ASSERT_TRUE(bufferResult.has_value());
    const GpuGraphResourceId buffer = bufferResult.value();
    Array<GpuTaskResourceUse, 1> firstUses = Array<GpuTaskResourceUse, 1>();
    firstUses[0u] = GpuBarrier_BufferWriteUse(buffer, 0u, 32u, ResourceStates::CopyDest);
    Array<GpuTaskResourceUse, 1> tailUses = Array<GpuTaskResourceUse, 1>();
    tailUses[0u] = GpuBarrier_BufferWriteUse(buffer, 32u, BufferRange::s_AllBytes, ResourceStates::UnorderedAccess);
    const auto firstResult = GpuBarrier_AddRangeTask(graph, s_GpuCaseBufferRangeFirst, firstUses);
    ASSERT_TRUE(firstResult.has_value());
    const GpuTaskId first = firstResult.value();
    const auto tailResult = GpuBarrier_AddRangeTask(graph, s_GpuCaseBufferRangeTail, tailUses);
    ASSERT_TRUE(tailResult.has_value());
    const GpuTaskId tail = tailResult.value();
    ASSERT_TRUE(first.valid());
    ASSERT_TRUE(tail.valid());

    Array<GpuPhysicalQueueInfo, 1> queues = Array<GpuPhysicalQueueInfo, 1>();
    queues[0u] = GraphicsQueue();
    const GpuPhysicalQueueTopology topology = GpuBarrier_MakeTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    EXPECT_FALSE(GpuBarrier_HasEdge(analysis, first, tail));

    const GpuCompiledGraphReadView plan = GpuCompiledGraphReadView(compiledGraph);
    const GpuCompiledTaskView tailView = plan.findTask(tail);
    ASSERT_TRUE(tailView.valid());
    const Optional<GpuCompiledTask> tailPlan = GpuBarrier_TaskPlan(tailView);
    ASSERT_TRUE(tailPlan.has_value());
    EXPECT_EQ(tailPlan.value().prologueStateSeedCount, 0u);
    const Span<GpuCompiledBarrier> tailBarriers = GpuBarrier_PrologueBarriers(tailView);
    ASSERT_EQ(tailBarriers.size(), 1u);
    EXPECT_EQ(tailBarriers[0u].range.bufferRange, tailUses[0u].range.bufferRange);
    EXPECT_EQ(tailBarriers[0u].before, ResourceStates::Common);
    EXPECT_TRUE(tailBarriers[0u].isGraphInitialState);
}

void VerifyGpuBarrier_WideConsumerCollectsOlderPrefixAndTailAfterPartialOverwrite(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const auto bufferResult = AddBufferMetadata(graph, s_GpuCaseBufferRangeFanIn, "Byte Fan In");
    ASSERT_TRUE(bufferResult.has_value());
    const GpuGraphResourceId buffer = bufferResult.value();
    Array<GpuTaskResourceUse, 1> wholeUses = Array<GpuTaskResourceUse, 1>();
    wholeUses[0u] = GpuBarrier_BufferWriteUse(buffer, 0u, 128u, ResourceStates::CopyDest);
    Array<GpuTaskResourceUse, 1> middleUses = Array<GpuTaskResourceUse, 1>();
    middleUses[0u] = GpuBarrier_BufferWriteUse(buffer, 32u, 32u, ResourceStates::UnorderedAccess);
    Array<GpuTaskResourceUse, 1> readUses = Array<GpuTaskResourceUse, 1>();
    readUses[0u] = GpuBarrier_BufferUse(buffer, 0u, 128u, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read);

    const auto wholeResult = GpuBarrier_AddRangeTask(graph, s_GpuCaseBufferRangeWhole, wholeUses);
    ASSERT_TRUE(wholeResult.has_value());
    const GpuTaskId whole = wholeResult.value();
    const auto middleResult = GpuBarrier_AddRangeTask(graph, s_GpuCaseBufferRangeMiddle, middleUses);
    ASSERT_TRUE(middleResult.has_value());
    const GpuTaskId middle = middleResult.value();
    const auto readerResult = GpuBarrier_AddRangeTask(graph, s_GpuCaseBufferRangeReader, readUses);
    ASSERT_TRUE(readerResult.has_value());
    const GpuTaskId reader = readerResult.value();
    ASSERT_TRUE(whole.valid());
    ASSERT_TRUE(middle.valid());
    ASSERT_TRUE(reader.valid());

    Array<GpuPhysicalQueueInfo, 1> queues = Array<GpuPhysicalQueueInfo, 1>();
    queues[0u] = GraphicsQueue();
    const GpuPhysicalQueueTopology topology = GpuBarrier_MakeTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    EXPECT_TRUE(GpuBarrier_HasEdge(analysis, whole, reader));
    EXPECT_TRUE(GpuBarrier_HasEdge(analysis, middle, reader));

    const GpuCompiledGraphReadView plan = GpuCompiledGraphReadView(compiledGraph);
    const GpuCompiledTaskView readerView = plan.findTask(reader);
    ASSERT_TRUE(readerView.valid());
    const Span<GpuCompiledBarrier> readerBarriers = GpuBarrier_PrologueBarriers(readerView);
    const Span<GpuPacketStateSeed> readerSeeds = GpuBarrier_PrologueSeeds(readerView);
    ASSERT_EQ(readerBarriers.size(), 3u);
    ASSERT_EQ(readerSeeds.size(), 3u);
    Array<BufferRange, 3> ranges = Array<BufferRange, 3>();
    ranges[0u] = BufferRange(0u, 32u);
    ranges[1u] = BufferRange(64u, 64u);
    ranges[2u] = BufferRange(32u, 32u);
    for(usize index = 0u; index < ranges.size(); ++index){
        const Optional<GpuCompiledBarrier> barrier = GpuBarrier_FindRangeBarrier(readerBarriers, ranges[index], GpuCompiledBarrierType::BufferTransition);
        ASSERT_TRUE(barrier.has_value());
        GpuResourceStatesMask expectedBefore = ResourceStates::CopyDest;
        GpuTaskId expectedProducer = whole;
        if(index == 2u){
            expectedBefore = ResourceStates::UnorderedAccess;
            expectedProducer = middle;
        }
        EXPECT_EQ(barrier.value().before, expectedBefore);
        EXPECT_EQ(barrier.value().after, ResourceStates::ShaderResource);
        const Optional<GpuCompiledTask> producerPlan = GpuBarrier_TaskPlan(plan.findTask(expectedProducer));
        ASSERT_TRUE(producerPlan.has_value());
        const GpuSubmissionPacketId producerPacket = producerPlan.value().packet;
        b8 foundSeed = false;
        for(in GpuPacketStateSeed seed : readerSeeds){
            if(seed.range.bufferRange == ranges[index] && seed.sourcePacket == producerPacket)
                foundSeed = true;
        }
        EXPECT_TRUE(foundSeed);
    }
}

void VerifyGpuBarrier_SameTaskOverlappingDeclarationsSeedOnlyNewBytes(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const auto bufferResult = AddBufferMetadata(graph, s_GpuCaseBufferRangeLocal, "Local Byte Ranges");
    ASSERT_TRUE(bufferResult.has_value());
    const GpuGraphResourceId buffer = bufferResult.value();
    Array<GpuTaskResourceUse, 2> uses = Array<GpuTaskResourceUse, 2>();
    uses[0u] = GpuBarrier_BufferWriteUse(buffer, 32u, 32u, ResourceStates::CopyDest);
    uses[1u] = GpuBarrier_BufferWriteUse(buffer, 0u, 128u, ResourceStates::UnorderedAccess);
    const auto taskResult = GpuBarrier_AddRangeTask(graph, s_GpuCaseBufferRangeLocalWriter, uses);
    ASSERT_TRUE(taskResult.has_value());
    const GpuTaskId task = taskResult.value();
    Array<GpuTaskResourceUse, 1> readUses = Array<GpuTaskResourceUse, 1>();
    readUses[0u] = GpuBarrier_BufferUse(buffer, 0u, 128u, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read);
    const auto readerResult = GpuBarrier_AddRangeTask(graph, s_GpuCaseBufferRangeLocalReader, readUses);
    ASSERT_TRUE(readerResult.has_value());
    const GpuTaskId reader = readerResult.value();
    ASSERT_TRUE(task.valid());
    ASSERT_TRUE(reader.valid());

    Array<GpuPhysicalQueueInfo, 1> queues = Array<GpuPhysicalQueueInfo, 1>();
    queues[0u] = GraphicsQueue();
    const GpuPhysicalQueueTopology topology = GpuBarrier_MakeTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    const GpuCompiledGraphReadView plan = GpuCompiledGraphReadView(compiledGraph);

    const GpuCompiledTaskView taskView = plan.findTask(task);
    ASSERT_TRUE(taskView.valid());
    const Optional<GpuCompiledTask> taskPlan = GpuBarrier_TaskPlan(taskView);
    ASSERT_TRUE(taskPlan.has_value());
    EXPECT_EQ(taskPlan.value().prologueStateSeedCount, 0u);
    const Span<GpuCompiledBarrier> taskBarriers = GpuBarrier_PrologueBarriers(taskView);
    ASSERT_EQ(taskBarriers.size(), 3u);
    Array<BufferRange, 3> ranges = Array<BufferRange, 3>();
    ranges[0u] = BufferRange(32u, 32u);
    ranges[1u] = BufferRange(0u, 32u);
    ranges[2u] = BufferRange(64u, 64u);
    for(usize index = 0u; index < ranges.size(); ++index){
        const Optional<GpuCompiledBarrier> barrier = GpuBarrier_FindRangeBarrier(taskBarriers, ranges[index], GpuCompiledBarrierType::BufferTransition);
        ASSERT_TRUE(barrier.has_value());
        EXPECT_EQ(barrier.value().before, ResourceStates::Common);
        GpuResourceStatesMask expectedAfter = ResourceStates::UnorderedAccess;
        if(index == 0u)
            expectedAfter = ResourceStates::CopyDest;
        EXPECT_EQ(barrier.value().after, expectedAfter);
    }

    const GpuCompiledTaskView readerView = plan.findTask(reader);
    ASSERT_TRUE(readerView.valid());
    const Span<GpuCompiledBarrier> readerBarriers = GpuBarrier_PrologueBarriers(readerView);
    ASSERT_EQ(readerBarriers.size(), 1u);
    EXPECT_EQ(readerBarriers[0u].range.bufferRange, readUses[0u].range.bufferRange);
    EXPECT_EQ(readerBarriers[0u].before, ResourceStates::UnorderedAccess);
}

void VerifyGpuBarrier_ExportsEveryTerminalIntervalIncludingSymbolicTail(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    Array<GpuPhysicalQueueInfo, 3> queues = Array<GpuPhysicalQueueInfo, 3>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    queues[2u] = DedicatedTransferQueue();
    const GpuPhysicalQueueTopology topology = GpuBarrier_MakeTopology(queues);

    GpuGraphResourceDesc desc = GpuGraphResourceDesc();
    desc.setIdentity(s_GpuCaseBufferRangeExport);
    desc.setMarkerLabel("Byte Range Exports");
    desc.setType(GpuGraphResourceType::Buffer);
    desc.setInitialState(ResourceStates::Common);
    desc.setExternalFinalState(ResourceStates::ShaderResource);
    desc.setExternalFinalReleaseDestinationQueue(queues[2u].id);
    const auto bufferResult = graph.importResource(desc);
    ASSERT_TRUE(bufferResult.has_value());
    const GpuGraphResourceId buffer = bufferResult.value();

    Array<GpuTaskResourceUse, 1> wholeUses = Array<GpuTaskResourceUse, 1>();
    wholeUses[0u] = GpuBarrier_BufferWriteUse(buffer, 0u, BufferRange::s_AllBytes, ResourceStates::CopyDest);
    Array<GpuTaskResourceUse, 1> middleUses = Array<GpuTaskResourceUse, 1>();
    middleUses[0u] = GpuBarrier_BufferWriteUse(buffer, 32u, 32u, ResourceStates::UnorderedAccess);
    const auto wholeResult = GpuBarrier_AddRangeTask(graph, s_GpuCaseBufferRangeExportWhole, wholeUses);
    ASSERT_TRUE(wholeResult.has_value());
    const GpuTaskId whole = wholeResult.value();
    const auto middleResult = GpuBarrier_AddRangeTask(graph, s_GpuCaseBufferRangeExportMiddle, middleUses, true);
    ASSERT_TRUE(middleResult.has_value());
    const GpuTaskId middle = middleResult.value();
    ASSERT_TRUE(whole.valid());
    ASSERT_TRUE(middle.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    const GpuCompiledGraphReadView plan = GpuCompiledGraphReadView(compiledGraph);
    const GpuCompiledExternalResourceExportView exportView = plan.externalResourceExport(buffer);
    ASSERT_TRUE(exportView.valid());
    const Optional<GpuCompiledExternalResourceExport> exportPlan = GpuBarrier_ExportPlan(exportView);
    ASSERT_TRUE(exportPlan.has_value());
    ASSERT_EQ(exportPlan.value().sourceCount, 3u);
    EXPECT_FALSE(exportPlan.value().producerTask.valid());
    const Span<GpuCompiledExternalResourceExportSource> exportSources = GpuBarrier_ExportSources(exportView);
    ASSERT_EQ(exportSources.size(), 3u);

    Array<BufferRange, 3> ranges = Array<BufferRange, 3>();
    ranges[0u] = BufferRange(0u, 32u);
    ranges[1u] = BufferRange(64u, BufferRange::s_AllBytes);
    ranges[2u] = BufferRange(32u, 32u);
    for(usize index = 0u; index < ranges.size(); ++index){
        GpuTaskId producer = whole;
        if(index == 2u)
            producer = middle;
        const GpuCompiledTaskView taskView = plan.findTask(producer);
        ASSERT_TRUE(taskView.valid());
        const Span<GpuCompiledBarrier> epilogueBarriers = GpuBarrier_EpilogueBarriers(taskView);
        const Optional<GpuCompiledBarrier> stateExport = GpuBarrier_FindRangeBarrier(epilogueBarriers, ranges[index], GpuCompiledBarrierType::BufferStateExport);
        ASSERT_TRUE(stateExport.has_value());
        EXPECT_EQ(stateExport.value().after, ResourceStates::ShaderResource);
        EXPECT_TRUE(GpuBarrier_FindRangeBarrier(epilogueBarriers, ranges[index], GpuCompiledBarrierType::BufferOwnershipRelease).has_value());
        b8 foundSource = false;
        for(in GpuCompiledExternalResourceExportSource source : exportSources){
            if(source.producerTask == producer && source.range.bufferRange == ranges[index])
                foundSource = true;
        }
        EXPECT_TRUE(foundSource);
    }
}

void VerifyGpuBarrier_CrossQueueFanInTransfersOnlyIntersectingBytes(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    const GpuPhysicalQueueTopology topology = GpuBarrier_MakeTopology(queues);

    const auto bufferResult = AddBufferMetadata(graph, s_GpuCaseBufferRangeCrossQueue, "Cross Queue Bytes");
    ASSERT_TRUE(bufferResult.has_value());
    const GpuGraphResourceId buffer = bufferResult.value();
    Array<GpuTaskResourceUse, 1> graphicsUses = Array<GpuTaskResourceUse, 1>();
    graphicsUses[0u] = GpuBarrier_BufferWriteUse(buffer, 0u, 64u, ResourceStates::CopyDest);
    Array<GpuTaskResourceUse, 1> computeUses = Array<GpuTaskResourceUse, 1>();
    computeUses[0u] = GpuBarrier_BufferWriteUse(buffer, 64u, 64u, ResourceStates::UnorderedAccess);
    Array<GpuTaskResourceUse, 1> readUses = Array<GpuTaskResourceUse, 1>();
    readUses[0u] = GpuBarrier_BufferUse(buffer, 32u, 64u, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read);

    const auto graphicsResult = GpuBarrier_AddRangeTask(graph, s_GpuCaseBufferRangeGraphics, graphicsUses);
    ASSERT_TRUE(graphicsResult.has_value());
    const GpuTaskId graphics = graphicsResult.value();
    const auto computeResult = GpuBarrier_AddRangeTask(graph, s_GpuCaseBufferRangeCompute, computeUses, true);
    ASSERT_TRUE(computeResult.has_value());
    const GpuTaskId compute = computeResult.value();
    const auto readerResult = GpuBarrier_AddRangeTask(graph, s_GpuCaseBufferRangeJoin, readUses);
    ASSERT_TRUE(readerResult.has_value());
    const GpuTaskId reader = readerResult.value();
    ASSERT_TRUE(graphics.valid());
    ASSERT_TRUE(compute.valid());
    ASSERT_TRUE(reader.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    EXPECT_FALSE(GpuBarrier_HasEdge(analysis, graphics, compute));

    const GpuCompiledGraphReadView plan = GpuCompiledGraphReadView(compiledGraph);
    const GpuCompiledTaskView computeView = plan.findTask(compute);
    const GpuCompiledTaskView readerView = plan.findTask(reader);
    ASSERT_TRUE(computeView.valid());
    ASSERT_TRUE(readerView.valid());
    const Optional<GpuCompiledTask> computePlan = GpuBarrier_TaskPlan(computeView);
    const Optional<GpuCompiledTask> readerPlan = GpuBarrier_TaskPlan(readerView);
    ASSERT_TRUE(computePlan.has_value());
    ASSERT_TRUE(readerPlan.has_value());
    EXPECT_EQ(computePlan.value().queue, queues[1u].id);
    EXPECT_EQ(readerPlan.value().prologueStateSeedCount, 2u);
    ASSERT_EQ(plan.logicalOwnershipTransferCount(), 1u);
    const Optional<GpuCompiledOwnershipTransfer> transfer = GpuBarrier_OwnershipTransferAt(plan, 0u);
    ASSERT_TRUE(transfer.has_value());
    EXPECT_EQ(transfer.value().range.bufferRange, BufferRange(64u, 32u));
    EXPECT_EQ(transfer.value().sourceTask, compute);
    EXPECT_EQ(transfer.value().destinationTask, reader);
    EXPECT_TRUE(GpuBarrier_FindRangeBarrier(GpuBarrier_EpilogueBarriers(computeView), BufferRange(64u, 32u), GpuCompiledBarrierType::BufferOwnershipRelease).has_value());
    EXPECT_TRUE(GpuBarrier_FindRangeBarrier(GpuBarrier_PrologueBarriers(readerView), BufferRange(64u, 32u), GpuCompiledBarrierType::BufferOwnershipAcquire).has_value());
}

void VerifyGpuBarrier_GroupsLateOwnershipAndTerminalExportsInTaskAndDiscoveryOrder(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGpuScratch);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    Array<GpuPhysicalQueueInfo, 3> queues = Array<GpuPhysicalQueueInfo, 3>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    queues[2u] = DedicatedTransferQueue();
    const GpuPhysicalQueueTopology topology = GpuBarrier_MakeTopology(queues);

    Array<Name, 2> identities = Array<Name, 2>();
    identities[0u] = s_GpuCaseBufferRangeGroupedA;
    identities[1u] = s_GpuCaseBufferRangeGroupedB;
    Array<BufferRange, 2> ranges = Array<BufferRange, 2>();
    ranges[0u] = BufferRange(16u, 32u);
    ranges[1u] = BufferRange(64u, 16u);
    Array<GpuGraphResourceId, 2> resources = Array<GpuGraphResourceId, 2>();
    Array<GpuTaskId, 2> writers = Array<GpuTaskId, 2>();
    Array<GpuTaskId, 2> consumers = Array<GpuTaskId, 2>();
    for(usize index = 0u; index < resources.size(); ++index){
        GpuGraphResourceDesc desc = GpuGraphResourceDesc();
        desc.setIdentity(identities[index]);
        desc.setMarkerLabel("Grouped Epilogue Buffer");
        desc.setType(GpuGraphResourceType::Buffer);
        desc.setInitialState(ResourceStates::Common);
        desc.setExternalFinalState(ResourceStates::ShaderResource);
        desc.setExternalFinalReleaseDestinationQueue(queues[2u].id);
        const auto gpuTaskAdmission = graph.importResource(desc);
        ASSERT_TRUE(gpuTaskAdmission.has_value());
        resources[index] = gpuTaskAdmission.value();
        ASSERT_TRUE(resources[index].valid());
    }
    for(usize offset = 0u; offset < resources.size(); ++offset){
        const usize index = resources.size() - offset - 1u;
        Array<GpuTaskResourceUse, 1> uses = Array<GpuTaskResourceUse, 1>();
        uses[0u] = GpuBarrier_BufferWriteUse(resources[index], ranges[index].byteOffset, ranges[index].byteSize, ResourceStates::CopyDest);
        const auto derivedNameResult = DeriveName(identities[index], StringView("writer"));
        ASSERT_TRUE(derivedNameResult.has_value());
        const auto writerTaskAdmission = GpuBarrier_AddRangeTask(graph, derivedNameResult.value(), uses);
        ASSERT_TRUE(writerTaskAdmission.has_value());
        writers[index] = writerTaskAdmission.value();
        ASSERT_TRUE(writers[index].valid());
    }
    for(usize index = 0u; index < resources.size(); ++index){
        Array<GpuTaskResourceUse, 1> uses = Array<GpuTaskResourceUse, 1>();
        uses[0u] = GpuBarrier_BufferUse(resources[index], ranges[index].byteOffset, ranges[index].byteSize, ResourceStates::ShaderResource, GpuTaskResourceAccess::Read);
        const auto secondDerivedNameResult = DeriveName(identities[index], StringView("consumer"));
        ASSERT_TRUE(secondDerivedNameResult.has_value());
        const auto consumerTaskAdmission = GpuBarrier_AddRangeTask(graph, secondDerivedNameResult.value(), uses, true);
        ASSERT_TRUE(consumerTaskAdmission.has_value());
        consumers[index] = consumerTaskAdmission.value();
        ASSERT_TRUE(consumers[index].valid());
    }
    GpuTaskDesc emptyDesc = GpuTaskDesc();
    emptyDesc.setIdentity(s_GpuCaseBufferRangeGroupedEmpty);
    emptyDesc.setMarkerLabel("No Epilogue Task");
    const auto emptyResult = graph.addTask(emptyDesc);
    ASSERT_TRUE(emptyResult.has_value());
    const GpuTaskId empty = emptyResult.value();
    ASSERT_TRUE(empty.valid());

    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    const GpuCompiledGraphReadView plan = GpuCompiledGraphReadView(compiledGraph);
    for(usize index = 0u; index < resources.size(); ++index){
        const GpuScopedTrace trace = GpuScopedTrace(index);
        const GpuCompiledTaskView writer = plan.findTask(writers[index]);
        ASSERT_TRUE(writer.valid());
        const Optional<GpuCompiledTask> writerPlan = GpuBarrier_TaskPlan(writer);
        ASSERT_TRUE(writerPlan.has_value());
        ASSERT_EQ(writerPlan.value().epilogueBarrierCount, 1u);
        EXPECT_EQ(writerPlan.value().epilogueBarrierOffset, resources.size() - index - 1u);
        const Span<GpuCompiledBarrier> writerBarriers = GpuBarrier_EpilogueBarriers(writer);
        ASSERT_EQ(writerBarriers.size(), 1u);
        EXPECT_EQ(writerBarriers[0u].resource, resources[index]);
        EXPECT_EQ(writerBarriers[0u].range.bufferRange, ranges[index]);
        EXPECT_EQ(writerBarriers[0u].type, GpuCompiledBarrierType::BufferOwnershipRelease);
        EXPECT_EQ(writerBarriers[0u].sourceQueue, queues[0u].id);
        EXPECT_EQ(writerBarriers[0u].destinationQueue, queues[1u].id);

        const GpuCompiledTaskView consumer = plan.findTask(consumers[index]);
        ASSERT_TRUE(consumer.valid());
        const Optional<GpuCompiledTask> consumerPlan = GpuBarrier_TaskPlan(consumer);
        ASSERT_TRUE(consumerPlan.has_value());
        ASSERT_EQ(consumerPlan.value().epilogueBarrierCount, 2u);
        EXPECT_EQ(consumerPlan.value().epilogueBarrierOffset, 2u + index * 2u);
        const Span<GpuCompiledBarrier> consumerBarriers = GpuBarrier_EpilogueBarriers(consumer);
        ASSERT_EQ(consumerBarriers.size(), 2u);
        EXPECT_EQ(consumerBarriers[0u].type, GpuCompiledBarrierType::BufferStateExport);
        EXPECT_EQ(consumerBarriers[1u].type, GpuCompiledBarrierType::BufferOwnershipRelease);
        for(usize barrierIndex = 0u; barrierIndex < 2u; ++barrierIndex){
            const GpuCompiledBarrier barrier = consumerBarriers[barrierIndex];
            EXPECT_EQ(barrier.resource, resources[index]);
            EXPECT_EQ(barrier.range.bufferRange, ranges[index]);
            EXPECT_EQ(barrier.before, ResourceStates::ShaderResource);
            EXPECT_EQ(barrier.after, ResourceStates::ShaderResource);
            EXPECT_EQ(barrier.sourceQueue, queues[1u].id);
            usize destQueueIndex = 2u;
            if(barrierIndex == 0u)
                destQueueIndex = 1u;
            EXPECT_EQ(barrier.destinationQueue, queues[destQueueIndex].id);
        }
    }
    const GpuCompiledTaskView emptyView = plan.findTask(empty);
    ASSERT_TRUE(emptyView.valid());
    const Optional<GpuCompiledTask> emptyPlan = GpuBarrier_TaskPlan(emptyView);
    ASSERT_TRUE(emptyPlan.has_value());
    EXPECT_EQ(emptyPlan.value().epilogueBarrierOffset, 6u);
    EXPECT_EQ(emptyPlan.value().epilogueBarrierCount, 0u);
    EXPECT_FALSE(GpuBarrier_HasEpilogueBarriersPtr(emptyView));
}

b8 GpuBarrier_PrepareCallbackGraph(
    mut GpuTaskGraph graph,
    mut SingleQueueCompile compilation,
    mut Vector<GpuTaskId> tasks,
    in usize taskCount
){
    tasks.reserve(taskCount);
    for(usize index = 0u; index < taskCount; ++index){
        GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
        scheduling.mergeWithPrevious = index % s_GpuBarrierMergeGroupSize != 0u;
        const auto derivedNameResult = IndexedName(s_GpuCaseCallbackBindingsTask, index);
        if(!derivedNameResult.has_value())
            return false;
        FixedVector<GpuTaskId, 1> deps = FixedVector<GpuTaskId, 1>();
        if(scheduling.mergeWithPrevious)
            deps.push_back(tasks.back());
        const auto taskResult = AddTaskWithCommands(
            derivedNameResult.value(),
            "Callback Binding Task",
            GraphicsCommands(),
            scheduling,
            GpuTaskTimingMetadata(),
            deps,
            graph
        );
        if(!taskResult.has_value())
            return false;
        const GpuTaskId task = taskResult.value();
        if(!task.valid())
            return false;
        tasks.push_back(task);
    }
    if(!compilation.compile(graph))
        return false;
    tasks.clear();
    const GpuCompiledGraphReadView plan = GpuCompiledGraphReadView(compilation.compiledGraph);
    for(usize packetIndex = 0u; packetIndex < plan.packetCount(); ++packetIndex){
        const GpuCompiledPacketView packet = plan.packet(plan.packetIdAt(packetIndex));
        if(!packet.valid())
            return false;
        const Span<GpuTaskId> packetTasks = GpuBarrier_PacketTasks(packet);
        for(in GpuTaskId packetTask : packetTasks)
            tasks.push_back(packetTask);
    }
    return tasks.size() == taskCount;
}

void GpuBarrier_CheckReorderedBindingsForKind(
    mut TestArena testArena,
    mut ScratchArena scratch,
    in usize callbackCount,
    in b8 recordedKind
){
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    SingleQueueCompile compilation = SingleQueueCompile(testArena);
    Vector<GpuTaskId> tasks = Vector<GpuTaskId>();
    ASSERT_TRUE(GpuBarrier_PrepareCallbackGraph(graph, compilation, tasks, callbackCount));
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
    const GpuCompiledGraphReadView plan = GpuCompiledGraphReadView(compilation.compiledGraph);
    ASSERT_LT(plan.packetCount(), tasks.size());

    CheckReorderedCallbackBindings(declarations, plan, tasks, callbackCount, recordedKind, scratch);
}

void GpuBarrier_CheckInvalidBindingsForKind(
    mut TestArena testArena,
    mut ScratchArena scratch,
    in usize callbackCount,
    in b8 recordedKind
){
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    SingleQueueCompile compilation = SingleQueueCompile(testArena);
    Vector<GpuTaskId> tasks = Vector<GpuTaskId>();
    ASSERT_TRUE(GpuBarrier_PrepareCallbackGraph(graph, compilation, tasks, callbackCount + s_GpuBarrierExtraRangeTasks));
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
    const GpuCompiledGraphReadView plan = GpuCompiledGraphReadView(compilation.compiledGraph);
    ASSERT_GT(plan.packetCount(), 1u);
    const GpuSubmissionPacketRange range = plan.packetRange(
        plan.packetIdAt(0u),
        plan.packetIdAt(plan.packetCount() - s_GpuBarrierExcludedPacketCount - 1u)
    );

    CheckInvalidCallbackBindings(declarations, plan, range, tasks, callbackCount, recordedKind, scratch);
}

void VerifyGpuBarrier_ReversedBindingsInvokeInMergedCompiledTaskOrderWithoutLookupAllocation(){
    TestArena testArena = TestArena();
    ScratchArena scratch = ScratchArena(s_TaskGpuScratch);
    Array<usize, 2> counts = Array<usize, 2>();
    counts[0u] = s_GpuBarrierInlineCount;
    counts[1u] = s_GpuBarrierIndexedCount;
    for(in usize count : counts){
        GpuBarrier_CheckReorderedBindingsForKind(testArena, scratch, count, true);
        ASSERT_FALSE(GpuBarrier_HasFatalFailure());
        GpuBarrier_CheckReorderedBindingsForKind(testArena, scratch, count, false);
        ASSERT_FALSE(GpuBarrier_HasFatalFailure());
    }
}

void VerifyGpuBarrier_FailedAdmissionClearsPriorBindingsForBothLookupPaths(){
    TestArena testArena = TestArena();
    ScratchArena scratch = ScratchArena(s_TaskGpuScratch);
    Array<usize, 2> counts = Array<usize, 2>();
    counts[0u] = s_GpuBarrierInlineCount;
    counts[1u] = s_GpuBarrierIndexedCount;
    for(in usize count : counts){
        GpuBarrier_CheckInvalidBindingsForKind(testArena, scratch, count, true);
        ASSERT_FALSE(GpuBarrier_HasFatalFailure());
        GpuBarrier_CheckInvalidBindingsForKind(testArena, scratch, count, false);
        ASSERT_FALSE(GpuBarrier_HasFatalFailure());
    }
}


