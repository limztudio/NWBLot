////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Joint/weight pairs per influence record. Keeps CPU and GPU forms in lockstep.
const u32 s_SkinInfluenceJointCount = 4u;
const u32 s_SkinBinaryMagic = 0x534B4E31u; // SKN1
const f32 s_SkinValidationEpsilon = 0.000001f;
const f32 s_SkinWeightSumEpsilon = 0.001f;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[serialize]
class SkinInfluence4{
    public Array<u16, s_SkinInfluenceJointCount> joint;
    public f32x4u weight(0.0f);
}

[serialize]
class SkinHeaderBinary{
    public u32 magic = s_SkinBinaryMagic;
    public u32 padding0 = 0u;
    public NameHash meshNameHash;
    public NameHash skeletonNameHash;
    public u64 influenceCount = 0u;
    public u64 inverseBindMatrixCount = 0u;
}

[subsystem("skinning_subsystem")]
class SkinningSubsystem{
    public AssetRef<ComputeShader> localBoundsCs;
    public AssetRef<ComputeShader> meshletBoundsCs;
    public AssetRef<ComputeShader> repackNormalsCs;
    public AssetRef<ComputeShader> skinningCs;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidSkinInfluenceWeights(in VectorSingle weights){
    if(
        !isFinite(weights.x) || !isFinite(weights.y) || !isFinite(weights.z) || !isFinite(weights.w)
        || weights.x < 0.0f || weights.y < 0.0f || weights.z < 0.0f || weights.w < 0.0f
    )
        return false;
    const f32 sum = dot(weights, VectorSingle(1.0f));
    return isFinite(sum) && abs(sum - 1.0f) <= s_SkinWeightSumEpsilon;
}

Expected<usize> TryFindOutOfRangeSkinInfluenceJoint(in SkinInfluence4 skin, in u32 skeletonJointCount){
    for(usize componentIndex = 0u; componentIndex < cast<usize>(s_SkinInfluenceJointCount); ++componentIndex){
        if(cast<u32>(skin.joint[componentIndex]) < skeletonJointCount)
            continue;

        return componentIndex;
    }
    return makeUnexpected(Failure());
}

b8 SkinInfluenceFitsSkeleton(in SkinInfluence4 skin, in u32 skeletonJointCount){
    if(skeletonJointCount == 0u)
        return true;
    return !TryFindOutOfRangeSkinInfluenceJoint(skin, skeletonJointCount).has_value();
}

b8 ValidInverseBindMatrixCount(in usize inverseBindMatrixCount, in u32 skeletonJointCount){
    if(inverseBindMatrixCount == 0u)
        return true;
    return skeletonJointCount != 0u && inverseBindMatrixCount == cast<usize>(skeletonJointCount);
}

SkinHeaderBinary MakeSkinHeaderBinary(
    in NameHash meshNameHash,
    in NameHash skeletonNameHash,
    in usize influenceCount,
    in usize inverseBindMatrixCount
){
    SkinHeaderBinary header;
    header.meshNameHash = meshNameHash;
    header.skeletonNameHash = skeletonNameHash;
    header.influenceCount = cast<u64>(influenceCount);
    header.inverseBindMatrixCount = cast<u64>(inverseBindMatrixCount);
    return header;
}

b8 ValidateSkinAssetHeaderAndCounts(
    in b8 meshValid,
    in b8 skeletonValid,
    in usize influenceCount,
    in usize inverseBindMatrixCount
){
    if(!meshValid){
        error("Skin::validatePayload failed: mesh reference is empty");
        return false;
    }
    if(!skeletonValid){
        error("Skin::validatePayload failed: skeleton reference is empty");
        return false;
    }
    if(influenceCount == 0u){
        error("Skin::validatePayload failed: skin influence stream is empty");
        return false;
    }
    if(inverseBindMatrixCount == 0u){
        error("Skin::validatePayload failed: inverse bind matrix stream is empty");
        return false;
    }
    if(inverseBindMatrixCount > cast<usize>(u16.max) + 1u){
        error("Skin::validatePayload failed: inverse bind matrix count exceeds u16 joint index range");
        return false;
    }
    return true;
}

b8 ValidateSkinInfluenceStream(in Span<SkinInfluence4> influences, in u32 jointCount){
    for(usize index = 0u; index < influences.size(); ++index){
        const SkinInfluence4 influence = influences[index];
        if(!ValidSkinInfluenceWeights(VectorSingle(influence.weight)) || !SkinInfluenceFitsSkeleton(influence, jointCount)){
            error("Skin::validatePayload failed: influence {} has invalid weights or joint indices", index);
            return false;
        }
    }
    return true;
}

b8 ValidateSkinHeaderBinary(in SkinHeaderBinary header){
    if(header.padding0 == 0u)
        return true;

    error("Skin::loadBinary failed: reserved header fields must be zero");
    return false;
}


