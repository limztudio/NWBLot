#include <impl/ecs_render/csg/graph_types.adhd>
#include <impl/ecs_render/csg/task_graph_opaque_compute_tasks.adhd>
#include <impl/ecs_render/csg/task_graph_opaque_interval_tasks.adhd>
#include <impl/ecs_render/deferred/import_types.adhd>
#include <impl/ecs_render/material/task_graph_object_geometry_cache.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class OpaqueCsgIntervalStageInputs{
    public in DeferredGraphResourceImportResult resources;
    public in MeshFrameBindingSnapshot frameBindings;
    public in CsgGraphResourceSnapshot csgResources;
    public MaterialPassDrawItemPartitionsView opaqueDrawItems;
    public CsgFrameGpuDataView csgFrameData;
    public Optional<in GraphicsPrefixTimingTicket> intervalSampleTimingTicket;
    public BufferRange materialInstanceRange;
    public BufferRange materialTypedRange;
    public BufferRange csgReceiverRange;
    public BufferRange csgCutterRange;
    public GpuTaskId dependencyTask;
    public usize instanceCount = 0u;
    public usize materialTypedByteCount = 0u;
    public b8 hasOpaqueDrawItems = false;
    public b8 hasCsgFrameGpuWork = false;

    public OpaqueCsgIntervalStageInputs(in DeferredGraphResourceImportResult resources, in MeshFrameBindingSnapshot frameBindings,
        in CsgGraphResourceSnapshot csgResources, in MaterialPassDrawItemPartitionsView opaqueDrawItems, in CsgFrameGpuDataView csgFrameData){
        this.resources = resources;
        this.frameBindings = frameBindings;
        this.csgResources = csgResources;
        this.opaqueDrawItems = opaqueDrawItems;
        this.csgFrameData = csgFrameData;
    }
}

// Freeze draw state before the G-buffer uploads, then move each payload into the graph.
[modular]
class OpaqueCsgIntervalStage : NoCopy{
    private mut GpuTaskGraph m_graph;
    private mut RendererMaterialSystem m_materialSystem;
    private mut Optional<GpuTimingMeasure> m_intervalSampleComputeEmulationTiming;
    private OpaqueCsgComputeIntervalGraphTask m_receiverSpanPayload;
    private OpaqueCsgComputeIntervalGraphTask m_intervalCombinePayload;
    private OpaqueCsgIntervalSampleGraphTask m_intervalSamplePayload;
    private OpaqueCsgIntervalSampleComputeEmulationGraphTask m_intervalSampleComputeEmulationPayload;

    public OpaqueCsgIntervalStage(mut GpuTaskGraph graph, mut GraphicsRuntime graphics, mut RendererMaterialSystem materials,
        mut RendererCsgSystem csg, mut DeferredFrameTargets targets, in borrow GraphicsPrefixTimingTicket receiverSpanTicket,
        in borrow GraphicsPrefixTimingTicket intervalCombineTicket, in borrow GraphicsPrefixTimingTicket intervalSampleTicket,
        in borrow b8 meshReady, in borrow b8 shadingReady, mut Optional<GpuTimingMeasure> computeTiming){
        this.m_graph = graph;
        this.m_materialSystem = materials;
        this.m_intervalSampleComputeEmulationTiming = computeTiming;
        this.m_receiverSpanPayload = OpaqueCsgComputeIntervalGraphTask(materials, csg, targets, receiverSpanTicket, meshReady, shadingReady, OpaqueCsgComputeIntervalPass::ReceiverSpan);
        this.m_intervalCombinePayload = OpaqueCsgComputeIntervalGraphTask(materials, csg, targets, intervalCombineTicket, meshReady, shadingReady, OpaqueCsgComputeIntervalPass::Combine);
        this.m_intervalSamplePayload = OpaqueCsgIntervalSampleGraphTask(graphics, materials, csg, targets, intervalSampleTicket, meshReady, shadingReady);
        this.m_intervalSampleComputeEmulationPayload = OpaqueCsgIntervalSampleComputeEmulationGraphTask(graphics, materials, targets, intervalSampleTicket, meshReady, shadingReady, computeTiming);
    }

    [cpp_unwind]
    public void capturePayloads(in MeshFrameBindingSnapshot frameBindings, in CsgGraphResourceSnapshot csgResources,
        in MaterialPassDrawItemPartitionsView opaqueDrawItems, in CsgFrameGpuDataView csgFrameData, in usize instanceCount,
        in usize materialTypedByteCount, in b8 materialDrawBuffersUploaded, in b8 csgFrameBuffersUploaded, in b8 hasOpaqueDrawItems, in b8 hasOpaqueCsgFrameWork);
    [cpp_unwind]
    public Expected<OpaqueCsgIntervalStageTasks> declare(in OpaqueCsgIntervalStageInputs inputs, mut ObjectGeometryCacheGraph objectGeometry);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

