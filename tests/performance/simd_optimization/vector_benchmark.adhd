#include "benchmark_support.adhd"
#include "binary_kernel_call.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<tests/performance/simd_optimization/benchmark_abi.h>"), cpp_name("::SimdBenchmarkAbi::DoubleRow")]
extern VectorDouble BenchmarkDoubleRow(in MatrixDouble matrix, in usize index);

enum<u32> VectorOperation{
    Dot2 = 0u,
    Dot3 = 1u,
    Dot4 = 2u,
    Sum = 3u,
    RotationX = 4u,
    PerspectiveFov = 5u,
    QuaternionNormal = 6u,
    kCount = 7u
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class VectorKernelReducer<const u32 KindIndex, const b8 Candidate> : IDoubleBinaryEvaluator{
    public VectorDouble evaluate(in VectorDouble lhs, in VectorDouble rhs)const override{ return VectorKernelReduce<KindIndex, Candidate>(lhs, rhs); }
}

class VectorEvaluator<const u32 KindIndex, const b8 Candidate> : IDoubleBinaryEvaluator{
    public VectorDouble evaluate(in VectorDouble lhs, in VectorDouble rhs)const override{
        return VectorKernelEvaluate<KindIndex, Candidate>(lhs, rhs);
    }
}

class VectorWorkloadRunner<const u32 KindIndex, const b8 Candidate> : IDoubleWorkloadRunner{
    private in Dataset m_data;
    private usize m_iterations;
    private b8 m_latency;

    public VectorWorkloadRunner(in Dataset data, in usize iterations, in b8 latency){
        this.m_data = data;
        this.m_iterations = iterations;
        this.m_latency = latency;
    }

    public VectorDouble run()const override{
        return VectorKernelRunWorkload<KindIndex, Candidate>(this.m_data, s_DataCount, this.m_iterations, this.m_latency);
    }
}

class VectorRoundingVerifier : IRoundingModeVerifier{
    public u32 verify(mut u64 seed)const override{
        u32 failures = 0u;
        failures += VerifyVectorReduction<0u>(seed);
        failures += VerifyVectorReduction<1u>(seed);
        failures += VerifyVectorReduction<2u>(seed);
        failures += VerifyVectorReduction<3u>(seed);
        failures += VerifyVectorFactory<4u>();
        failures += VerifyVectorFactory<5u>();
        failures += VerifyVectorFactory<6u>();
        failures += VerifyQuaternionAxes();
        return failures;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


MatrixDouble VectorKernelRotationX<const b8 Candidate>(in f64 angle){
    if(Candidate)
        return MatrixDoubleRotationX(angle);
    VectorDouble sine = VectorDoubleZero();
    VectorDouble cosine = VectorDoubleZero();
    VectorDoubleSinCos(sine, cosine, VectorDoubleReplicate(angle));
    return MatrixDouble(
        VectorDouble(1.0, 0.0, 0.0, 0.0),
        VectorDoubleMergeX(VectorDoubleZero(), cosine, VectorDoubleNegate(sine), VectorDoubleZero()),
        VectorDoubleMergeX(VectorDoubleZero(), sine, cosine, VectorDoubleZero()),
        VectorDouble(0.0, 0.0, 0.0, 1.0));
}

MatrixDouble VectorKernelPerspectiveFov<const b8 Candidate>(in f64 angle){
    if(Candidate)
        return MatrixDoublePerspectiveFovLH(angle, 1.75, 0.125, 100.0);
    VectorDouble sine = VectorDoubleZero();
    VectorDouble cosine = VectorDoubleZero();
    VectorDoubleSinCos(sine, cosine, VectorDoubleScale(VectorDoubleReplicate(angle), 0.5));
    const VectorDouble zero = VectorDoubleZero();
    const VectorDouble nearZ = VectorDoubleReplicate(0.125);
    const VectorDouble farZ = VectorDoubleReplicate(100.0);
    const VectorDouble height = VectorDoubleDivide(cosine, sine);
    const VectorDouble width = VectorDoubleDivide(height, VectorDoubleReplicate(1.75));
    const VectorDouble range = VectorDoubleDivide(farZ, VectorDoubleSubtract(farZ, nearZ));
    const VectorDouble rangeNear = VectorDoubleMultiply(VectorDoubleMultiply(VectorDoubleReplicate(-1.0), range), nearZ);
    return MatrixDouble(
        VectorDoubleMergeX(width, zero, zero, zero),
        VectorDoubleMergeX(zero, height, zero, zero),
        VectorDoubleMergeX(zero, zero, range, rangeNear),
        VectorDoubleMergeX(zero, zero, VectorDoubleReplicate(1.0), zero));
}

VectorDouble VectorKernelQuaternionNormal<const b8 Candidate>(in f64 angle, in VectorDouble normal){
    if(Candidate)
        return QuaternionDoubleRotationNormal(normal, angle);
    const VectorDouble n = VectorDoubleSelect(VectorDouble(0.0, 0.0, 0.0, 1.0), normal, VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u)));
    VectorDouble sine = VectorDoubleZero();
    VectorDouble cosine = VectorDoubleZero();
    VectorDoubleSinCos(sine, cosine, VectorDoubleScale(VectorDoubleReplicate(angle), 0.5));
    return VectorDoubleMultiply(n, VectorDoubleSelect(cosine, sine, VectorDouble(u64x4(u64.max, u64.max, u64.max, 0u))));
}

VectorDouble VectorKernelReduce<const u32 KindIndex, const b8 Candidate>(in VectorDouble lhs, in VectorDouble rhs){
    if(KindIndex == 0u){
        if(Candidate)
            return VectorDouble2Dot(lhs, rhs);
        else
            return BaselineDot2(lhs, rhs);
    }
    else if(KindIndex == 1u){
        if(Candidate)
            return VectorDouble3Dot(lhs, rhs);
        else
            return BaselineDot3(lhs, rhs);
    }
    else if(KindIndex == 2u){
        if(Candidate)
            return VectorDouble4Dot(lhs, rhs);
        else
            return BaselineDot4(lhs, rhs);
    }
    else{
        if(Candidate)
            return VectorDoubleSum(lhs);
        else
            return BaselineSum(lhs);
    }
}

VectorDouble VectorKernelEvaluate<const u32 KindIndex, const b8 Candidate>(in VectorDouble lhs, in VectorDouble rhs){
    return EvaluateBinaryKernel(lambda[](in VectorDouble left, in VectorDouble right) -> VectorDouble{
        return VectorKernelReduce<KindIndex, Candidate>(left, right);
    }, lhs, rhs);
}

MatrixDouble VectorKernelEvaluateFactory<const u32 KindIndex, const b8 Candidate>(in f64 angle){
    if(KindIndex == 4u)
        return VectorKernelRotationX<Candidate>(angle);
    else if(KindIndex == 5u)
        return VectorKernelPerspectiveFov<Candidate>(angle);
    else{
        return MatrixDouble(VectorKernelQuaternionNormal<Candidate>(angle, VectorDouble(0.25, -0.5, 0.75, 0.0)), VectorDoubleZero(), VectorDoubleZero(), VectorDoubleZero());
    }
}

VectorDouble VectorKernelEvaluateQuaternionAxis<const b8 Candidate>(in VectorDouble axis, in f64 angle){
    return EvaluateAxisKernel(lambda[](in VectorDouble normal, in f64 radians) -> VectorDouble{
        return VectorKernelQuaternionNormal<Candidate>(radians, normal);
    }, axis, angle);
}

VectorDouble VectorKernelRunWorkload<const u32 KindIndex, const b8 Candidate>(in Dataset data, in usize dataCount, in usize iterations, in b8 latency){
    if(KindIndex <= 3u){
        if(!latency){
            return ThroughputWorkload<8u, VectorKernelReducer<KindIndex, Candidate>>(data, dataCount, iterations, VectorKernelReducer<KindIndex, Candidate>());
        }
    }
    Array<f64x4, 8> accumulators;
    for(usize lane = 0u; lane < 8u; ++lane)
        accumulators[lane] = f64x4(0.125, 0.25, 0.5, 1.0);
    for(usize iteration = 0u; iteration < iterations; ++iteration){
        if(KindIndex <= 3u){
            VectorDouble input = VectorDouble(accumulators[0]);
            if(KindIndex == 3u)
                input = VectorDoubleScale(input, 0.125);
            accumulators[0] = f64x4(VectorDoubleAdd(VectorKernelReduce<KindIndex, Candidate>(input, VectorDouble(data.right[iteration % dataCount])), VectorDoubleReplicate(0.125)));
        }
        else{
            const f64 angle = data.angles[iteration % dataCount];
            if(KindIndex == 6u)
                accumulators[0] = f64x4(VectorDoubleAdd(VectorDouble(accumulators[0]), VectorKernelQuaternionNormal<Candidate>(angle, VectorDouble(0.25, -0.5, 0.75, 0.0))));
            else{
                MatrixDouble matrix = MatrixDouble(f64x4x4());
                if(KindIndex == 4u)
                    matrix = VectorKernelRotationX<Candidate>(angle);
                else
                    matrix = VectorKernelPerspectiveFov<Candidate>(angle);
                for(usize row = 0u; row < 4u; ++row)
                    accumulators[row] = f64x4(VectorDoubleAdd(VectorDouble(accumulators[row]), BenchmarkDoubleRow(matrix, row)));
            }
        }
    }
    VectorDouble result = VectorDouble(accumulators[0]);
    for(usize lane = 1u; lane < 8u; ++lane)
        result = VectorDoubleAdd(result, VectorDouble(accumulators[lane]));
    return result;
}

b8 CompareVectorFactoryPairImpl<const u32 KindIndex>(in u64 angleBits, mut b8 outMatch, mut i32 outExpectedFlags, mut i32 outActualFlags, mut i32 outExpectedErrno, mut i32 outActualErrno){
    const f64 angle = bit_cast<f64>(angleBits);
    if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT))
        return false;
    WritePowerError(s_SeedPowerError);
    const MatrixDouble expected = VectorKernelEvaluateFactory<KindIndex, false>(angle);
    outExpectedFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    outExpectedErrno = ReadPowerError();
    if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT))
        return false;
    WritePowerError(s_SeedPowerError);
    const MatrixDouble actual = VectorKernelEvaluateFactory<KindIndex, true>(angle);
    outActualFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    outActualErrno = ReadPowerError();
    b8 equal = true;
    for(usize row = 0u; row < 4u; ++row){
        for(usize lane = 0u; lane < 4u; ++lane)
            equal = equal && (VectorDoubleGetIntByIndex(BenchmarkDoubleRow(expected, row), lane) == VectorDoubleGetIntByIndex(BenchmarkDoubleRow(actual, row), lane));
    }
    outMatch = equal && outExpectedFlags == outActualFlags && outExpectedErrno == outActualErrno;
    return true;
}

b8 CompareVectorFactoryPair(in u32 kindIndex, in u64 angleBits, mut b8 outMatch, mut i32 outExpectedFlags, mut i32 outActualFlags, mut i32 outExpectedErrno, mut i32 outActualErrno){
    if(kindIndex == 4u)
        return CompareVectorFactoryPairImpl<4u>(angleBits, outMatch, outExpectedFlags, outActualFlags, outExpectedErrno, outActualErrno);
    if(kindIndex == 5u)
        return CompareVectorFactoryPairImpl<5u>(angleBits, outMatch, outExpectedFlags, outActualFlags, outExpectedErrno, outActualErrno);
    return CompareVectorFactoryPairImpl<6u>(angleBits, outMatch, outExpectedFlags, outActualFlags, outExpectedErrno, outActualErrno);
}

b8 CompareQuaternionAxisPair(in VectorDouble axis, in u64 angleBits, mut b8 outMatch, mut i32 outExpectedFlags, mut i32 outActualFlags, mut i32 outExpectedErrno, mut i32 outActualErrno){
    const f64 angle = bit_cast<f64>(angleBits);
    if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT))
        return false;
    WritePowerError(s_SeedPowerError);
    const VectorDouble expected = VectorKernelEvaluateQuaternionAxis<false>(axis, angle);
    outExpectedFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    outExpectedErrno = ReadPowerError();
    if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT))
        return false;
    WritePowerError(s_SeedPowerError);
    const VectorDouble actual = VectorKernelEvaluateQuaternionAxis<true>(axis, angle);
    outActualFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    outActualErrno = ReadPowerError();
    b8 equal = true;
    for(usize lane = 0u; lane < 4u; ++lane)
        equal = equal && (VectorDoubleGetIntByIndex(expected, lane) == VectorDoubleGetIntByIndex(actual, lane));
    outMatch = equal && outExpectedFlags == outActualFlags && outExpectedErrno == outActualErrno;
    return true;
}

StringView VectorOperationName(in u32 kindIndex){
    switch(kindIndex){
    case 0u: return "dot2";
    case 1u: return "dot3";
    case 2u: return "dot4";
    case 3u: return "sum";
    case 4u: return "rotation_x";
    case 5u: return "perspective_fov";
    case 6u: return "quaternion_normal";
    default: return "";
    }
}

u32 VerifyVectorReduction<const u32 KindIndex>(mut u64 seed){
    return VerifyReductionCases(
        VectorOperationName(KindIndex),
        VectorEvaluator<KindIndex, false>(),
        VectorEvaluator<KindIndex, true>(),
        NoAdditionalReductionCheck(),
        seed
    );
}

u32 VerifyVectorFactory<const u32 KindIndex>(){
    Array<u64, 15> bits;
    bits[0] = 0u;
    bits[1] = 0x8000000000000000ull;
    bits[2] = 1u;
    bits[3] = 0x8000000000000001ull;
    bits[4] = 0x0010000000000000ull;
    bits[5] = 0x3ff0000000000000ull;
    bits[6] = 0xbff0000000000000ull;
    bits[7] = 0x7fefffffffffffffull;
    bits[8] = 0x7ff0000000000000ull;
    bits[9] = 0xfff0000000000000ull;
    bits[10] = 0x7ff8000000000123ull;
    bits[11] = 0xfff8000000000124ull;
    bits[12] = 0x7ff0000000000125ull;
    bits[13] = 0xfff0000000000126ull;
    bits[14] = 0x400921fb54442d18ull;

    const StringView opName = VectorOperationName(KindIndex);
    u32 failures = 0u;
    for(usize index = 0u; index < bits.size(); ++index){
        b8 match = false;
        i32 expectedFlags = 0;
        i32 actualFlags = 0;
        i32 expectedErrno = 0;
        i32 actualErrno = 0;
        if(!CompareVectorFactoryPair(KindIndex, bits[index], match, expectedFlags, actualFlags, expectedErrno, actualErrno))
            return failures + 1u;
        if(!match){
            ++failures;
            if(failures <= 3u){
                WriteBenchmarkStdout(StringFormat(
                    "factory mismatch operation={} case={} flags={}/{} errno={}/{}\n",
                    opName,
                    index,
                    expectedFlags,
                    actualFlags,
                    expectedErrno,
                    actualErrno
                ));
            }
        }
    }
    return failures;
}

u32 VerifyQuaternionAxes(){
    Array<u64, 16> axisWords;
    axisWords[0] = 0x3ff0000000000000ull;
    axisWords[1] = 0u;
    axisWords[2] = 0x8000000000000000ull;
    axisWords[3] = 0x7ff0000000000123ull;
    axisWords[4] = 0x7ff8000000000123ull;
    axisWords[5] = 0xfff8000000000124ull;
    axisWords[6] = 0x7ff0000000000125ull;
    axisWords[7] = 0xfff0000000000126ull;
    axisWords[8] = 0x7ff0000000000000ull;
    axisWords[9] = 0xfff0000000000000ull;
    axisWords[10] = 0x7fefffffffffffffull;
    axisWords[11] = 0u;
    axisWords[12] = 1u;
    axisWords[13] = 0x8000000000000001ull;
    axisWords[14] = 0x0010000000000000ull;
    axisWords[15] = 0u;

    Array<u64, 7> angleWords;
    angleWords[0] = 0u;
    angleWords[1] = 0x8000000000000000ull;
    angleWords[2] = 1u;
    angleWords[3] = 0x3ff0000000000000ull;
    angleWords[4] = 0x7ff0000000000000ull;
    angleWords[5] = 0x7ff8000000000233ull;
    angleWords[6] = 0xfff0000000000234ull;

    u32 failures = 0u;
    for(usize axisIndex = 0u; axisIndex < 4u; ++axisIndex){
        const VectorDouble axis = VectorDouble(u64x4(
            axisWords[axisIndex * 4u],
            axisWords[axisIndex * 4u + 1u],
            axisWords[axisIndex * 4u + 2u],
            axisWords[axisIndex * 4u + 3u]
        ));
        for(usize angleIndex = 0u; angleIndex < angleWords.size(); ++angleIndex){
            const u64 bits = angleWords[angleIndex];
            b8 match = false;
            i32 expectedFlags = 0;
            i32 actualFlags = 0;
            i32 expectedErrno = 0;
            i32 actualErrno = 0;
            if(!CompareQuaternionAxisPair(axis, bits, match, expectedFlags, actualFlags, expectedErrno, actualErrno))
                return failures + 1u;
            if(!match){
                ++failures;
                if(failures <= 3u){
                    WriteBenchmarkStdout(StringFormat(
                        "axis mismatch angle_bits={} flags={}/{} errno={}/{}\n",
                        bits,
                        expectedFlags,
                        actualFlags,
                        expectedErrno,
                        actualErrno
                    ));
                }
            }
        }
    }
    return failures;
}

u32 VerifyVectorBenchmark(){
    const VerificationSweep verification = VerifyRoundingModes(VectorRoundingVerifier());
    if(!verification.environmentAvailable)
        return verification.failures;
    const u32 failures = verification.failures;
    WriteBenchmarkStdout(StringFormat("verification failures={} reduction_cases=262144 factory_cases=180 axis_cases=112\n", failures));
    return failures;
}

void RunVectorVariant<const u32 KindIndex>(in Dataset data, in b8 candidate, in usize iterations, in b8 latency){
    usize operations = iterations;
    if(KindIndex <= 3u && !latency)
        operations = iterations * 8u;
    SelectVariant(
        VectorOperationName(KindIndex),
        candidate,
        latency,
        operations,
        VectorWorkloadRunner<KindIndex, true>(data, iterations, latency),
        VectorWorkloadRunner<KindIndex, false>(data, iterations, latency)
    );
}

i32 RunVectorBenchmarkCli(in Span<StringView> args){
    if(args.size() == 2u && args[1] == "--verify"){
        if(VerifyVectorBenchmark() == 0u)
            return 0;
        return 1;
    }
    if(args.size() != 6u || args[1] != "--measure"){
        WriteBenchmarkStderr("usage: vector_benchmark --verify\n  --measure dot2|dot3|dot4|sum baseline|candidate iterations throughput|latency\n  --measure rotation_x|perspective_fov|quaternion_normal baseline|candidate iterations throughput\n");
        return 2;
    }
    const Expected<MeasureOptions> options = ParseMeasureOptions(args[3], args[4], args[5], usize.max, true);
    if(!options.has_value())
        return 2;
    const b8 candidate = options.value().candidate;
    const b8 latency = options.value().latency;
    const usize iterations = options.value().iterations;

    Dataset data = Dataset();
    InitializeDataset(s_InitialSeed, data);

    const u32 count = cast<u32>(VectorOperation::kCount);
    for(u32 index = 0u; index < count; ++index){
        if(args[2] != VectorOperationName(index))
            continue;
        if(latency && index > cast<u32>(VectorOperation::Sum))
            return 2;
        usize operationsPerIteration = 1u;
        if(index <= cast<u32>(VectorOperation::Sum) && !latency)
            operationsPerIteration = 8u;
        if(iterations > usize.max / operationsPerIteration)
            return 2;
        switch(index){
        case 0u: RunVectorVariant<0u>(data, candidate, iterations, latency); break;
        case 1u: RunVectorVariant<1u>(data, candidate, iterations, latency); break;
        case 2u: RunVectorVariant<2u>(data, candidate, iterations, latency); break;
        case 3u: RunVectorVariant<3u>(data, candidate, iterations, latency); break;
        case 4u: RunVectorVariant<4u>(data, candidate, iterations, latency); break;
        case 5u: RunVectorVariant<5u>(data, candidate, iterations, latency); break;
        case 6u: RunVectorVariant<6u>(data, candidate, iterations, latency); break;
        default: return 2;
        }
        return 0;
    }
    return 2;
}


