#include <impl/ecs_render/shadow/rt_shadow_internal_types.adhd>
#include <impl/ecs_render/shadow/soft_shadow_resolve_dispatch_builder.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_ShadowAdaptiveCounterClearLabel = "Shadow Adaptive Counter Clear";
const StringView s_ShadowVisibilityAllLitClearLabel = "Shadow Visibility All-Lit Clear";
const StringView s_ShadowCoarseTransmittanceLabel = "Shadow Coarse Transmittance";
const StringView s_ShadowEdgeListLabel = "Shadow Edge List";
const StringView s_ShadowIndirectArgsLabel = "Shadow Indirect Arguments";
const StringView s_HardwareTransparentScratchLabel = "Hardware Transparent Shadow Scratch";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> ShadowTemporalResourceUseKind{
    None = 0u,
    ShaderResourceRead,
    UnorderedAccessWrite,
    UnorderedAccessReadWrite,
    kCount
}

class ShadowVisibilityRouteSelection{
    public b8 splitSoftTransparentFold = false;
    public b8 combinedSoftUpsample = false;
    public b8 combinedSoftWavelet = false;
    public b8 combinedSoftTemporal = false;
    public b8 graphOwnsOpaqueTemporalMergeEntryStates = false;
}

ShadowVisibilityRouteSelection ResolveShadowVisibilityRouteSelection(
    in b8 preparedSoftTransparentFoldCandidate,
    in b8 planCombinedSoftUpsample,
    in b8 planCombinedSoftWaveletReady,
    in b8 planOpaqueTemporalMergeReady,
    in b8 planTransparentTemporalMergeReady,
    in b8 planCombinedSoftTemporalReady,
    in u32 opaqueResolvePassCount,
    in u32 transparentResolvePassCount
){
    ShadowVisibilityRouteSelection selection;
    selection.splitSoftTransparentFold = preparedSoftTransparentFoldCandidate;
    selection.combinedSoftUpsample = selection.splitSoftTransparentFold && planCombinedSoftUpsample;
    selection.combinedSoftWavelet = CanCombineSoftShadowWavelets(selection.combinedSoftUpsample, planCombinedSoftWaveletReady, planOpaqueTemporalMergeReady, planTransparentTemporalMergeReady, opaqueResolvePassCount, transparentResolvePassCount);
    selection.combinedSoftTemporal = selection.combinedSoftWavelet && planCombinedSoftTemporalReady;
    selection.graphOwnsOpaqueTemporalMergeEntryStates = selection.splitSoftTransparentFold && planOpaqueTemporalMergeReady;
    return selection;
}

SoftShadowSplitRoute MakeSoftShadowSplitRoute(in b8 hardwareShadowSupported, in b8 hardwareCsgShadow, in b8 csgShadow, in b8 traceGeometryStatesGraphOwned, in ShadowVisibilityRouteSelection selection){
    SoftShadowSplitRoute route;
    route.hardwareShadowSupported = hardwareShadowSupported;
    route.hardwareCsgShadow = hardwareCsgShadow;
    route.csgShadow = csgShadow;
    route.traceGeometryStatesGraphOwned = traceGeometryStatesGraphOwned;
    route.combinedSoftUpsample = selection.combinedSoftUpsample;
    route.combinedSoftWavelet = selection.combinedSoftWavelet;
    route.combinedSoftTemporal = selection.combinedSoftTemporal;
    route.graphOwnsOpaqueTemporalMergeEntryStates = selection.graphOwnsOpaqueTemporalMergeEntryStates;
    return route;
}

b8 ResolveAllLitShadowClearMerged(in b8 hasOpaqueSplitTask, in b8 hasAllLitClearTask, in b8 clearSharesTerminalPacket){
    if(hasOpaqueSplitTask)
        return !hasAllLitClearTask;
    return hasAllLitClearTask && clearSharesTerminalPacket;
}

ShadowTemporalResourceUseKind ResolveOpaqueTemporalHistoryUseKind(in b8 graphOwnsOpaqueTemporalMergeEntryStates, in b8 splitSoftTransparentFold, in b8 softShadowHistoryReadable, in b8 opaqueTemporalMergeReady, in b8 isInput){
    if(graphOwnsOpaqueTemporalMergeEntryStates){
        if(isInput)
            return ShadowTemporalResourceUseKind::ShaderResourceRead;
        return ShadowTemporalResourceUseKind::UnorderedAccessWrite;
    }
    if(!splitSoftTransparentFold){
        if(isInput){
            if(softShadowHistoryReadable)
                return ShadowTemporalResourceUseKind::ShaderResourceRead;
            return ShadowTemporalResourceUseKind::None;
        }
        if(opaqueTemporalMergeReady)
            return ShadowTemporalResourceUseKind::UnorderedAccessWrite;
        return ShadowTemporalResourceUseKind::None;
    }
    return ShadowTemporalResourceUseKind::UnorderedAccessReadWrite;
}

ShadowTemporalResourceUseKind ResolveOpaqueTemporalStaticReadUseKind(in b8 softShadowHistoryReadable, in b8 splitSoftTransparentFold, in b8 graphOwnsOpaqueTemporalMergeEntryStates){
    if(softShadowHistoryReadable)
        return ShadowTemporalResourceUseKind::ShaderResourceRead;
    if(splitSoftTransparentFold && !graphOwnsOpaqueTemporalMergeEntryStates)
        return ShadowTemporalResourceUseKind::UnorderedAccessReadWrite;
    return ShadowTemporalResourceUseKind::None;
}

ShadowTemporalResourceUseKind ResolveTransparentTemporalHistoryUseKind(in b8 transparentTemporalMergeReady, in b8 softShadowHistoryReadable, in b8 isInput){
    if(!transparentTemporalMergeReady)
        return ShadowTemporalResourceUseKind::None;
    if(isInput){
        if(softShadowHistoryReadable)
            return ShadowTemporalResourceUseKind::ShaderResourceRead;
        return ShadowTemporalResourceUseKind::None;
    }
    return ShadowTemporalResourceUseKind::UnorderedAccessWrite;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 AppendShadowTemporalTexture(mut GpuTaskGraph graph, mut Vector<GpuTaskResourceUse> uses, in TextureHandle texture, in Name identity, in StringView label, in ShadowTemporalResourceUseKind kind){
    if(!texture.valid())
        return true;
    const auto imported = ImportExternalTexture(graph, texture, identity, label);
    if(!imported.has_value())
        return false;
    const GpuGraphResourceId resource = imported.value();
    switch(kind){
    case ShadowTemporalResourceUseKind::ShaderResourceRead:
        uses.push_back(ReadUse(resource, ResourceStates::ShaderResource));
        break;
    case ShadowTemporalResourceUseKind::UnorderedAccessWrite:
        uses.push_back(WriteUse(resource, ResourceStates::UnorderedAccess));
        break;
    case ShadowTemporalResourceUseKind::UnorderedAccessReadWrite:
        uses.push_back(ReadWriteUse(resource, ResourceStates::UnorderedAccess));
        break;
    default:
        break;
    }
    return true;
}

b8 AppendShadowOptionalReadWriteBuffer(mut GpuTaskGraph graph, mut Vector<GpuTaskResourceUse> uses, in BufferHandle buffer, in Name identity, in StringView label, in ResourceStates state){
    if(!buffer.valid())
        return true;
    const auto imported = ImportExternalBuffer(graph, buffer, identity, label);
    if(!imported.has_value())
        return false;
    uses.push_back(ReadWriteUse(imported.value(), state));
    return true;
}

b8 ShadowVisibilityGraphCoordinator::declareDeferredShadowVisibilityTask(
    in ShadowVisibilityGraphContext context,
    in DeferredLightingGraphResources deferredLightingResources,
    in RayTracingShadowPreparationResourceSnapshot rayTracingShadowResources,
    in RayTracingDeferredGraphResourceSnapshot rayTracingResources,
    in RayTracingShadowVisibilityGraphPlanSnapshot rayTracingPlan,
    in RayTracingSceneGraphReads hardwareSceneReads,
    in b8 hardwareShadowSupported,
    in GpuGraphResourceId worldPosition,
    in GpuGraphResourceId normal,
    in GpuGraphResourceId depth,
    in GpuGraphResourceId shadowVisibility,
    in GpuGraphResourceId currentBindlessSlots,
    in GpuGraphResourceId sceneShading,
    in GpuGraphResourceId lights,
    in GpuGraphResourceId materialContextSlots,
    in Span<GpuGraphResourceId> traceGeometryResources,
    in GpuGraphResourceSetId traceGeometrySet,
    in GpuGraphResourceSetId traceMaterialSampledTextureSet,
    in GpuTaskId prefixTask,
    in GpuExternalCompletionId laggedLightingHistoryWriterDrainCompletion,
    mut DeferredFrameTargets deferredTargets,
    mut GpuTimingSubmissionTicket timingTicket,
    mut Optional<GpuTimingMeasure> asyncTiming,
    mut Optional<GpuTimingMeasure> shadowVisibilityTiming,
    mut Optional<GpuTimingMeasure> opaqueResolveTiming,
    mut Optional<GpuTimingMeasure> transparentResolveTiming,
    mut b8 opaqueProduced,
    mut b8 transparentTraceProduced,
    mut u32 opaqueFrameIndex
){

    const b8 hardwareTransparentTrace = rayTracingPlan.hardwareTransparentTrace;
    const b8 csgShadow = rayTracingPlan.lightSpaceReady() && (rayTracingPlan.lightSpace.deref().snapshot.push.csgFlags & s_CsgShadowFlagEnabled) != 0u;
    const b8 hardwareCsgShadow = hardwareShadowSupported && csgShadow;

    this.m_deferredShadowVisibilityOpaqueTask = GpuTaskId();
    this.m_deferredShadowVisibilityOpaqueFirstWaveletTask = GpuTaskId();
    this.m_deferredShadowVisibilityOpaqueResolveTask = GpuTaskId();
    this.m_deferredShadowCombinedUpsample = false;
    this.m_deferredShadowCombinedWavelet = false;
    this.m_deferredShadowCombinedTemporal = false;
    this.m_deferredShadowVisibilityTransparentTraceTask = GpuTaskId();
    this.m_deferredShadowVisibilityTransparentTemporalMergeTask = GpuTaskId();
    this.m_deferredShadowVisibilityTransparentFirstWaveletTask = GpuTaskId();
    this.m_deferredShadowVisibilityDiagnosticsTask = GpuTaskId();
    this.m_deferredShadowVisibilityAdaptiveCounterClearTask = GpuTaskId();
    this.m_deferredShadowVisibilityAllLitClearTask = GpuTaskId();
    this.m_deferredShadowVisibilityTask = GpuTaskId();
    if(
        !deferredTargets.valid() || !deferredTargets.bindless.valid() || !worldPosition.valid() || !normal.valid() || !depth.valid()
        || !shadowVisibility.valid() || !currentBindlessSlots.valid() || !sceneShading.valid() || !lights.valid() || !prefixTask.valid()
        || (hardwareTransparentTrace && !hardwareSceneReads.valid())
    )
        return false;

    Array<GpuTaskExternalStateSource, s_ShadowVisibilityStateSourceCapacity> shadowVisibilityStateSources;
    usize shadowVisibilityStateSourceCount = 0u;
    const auto scratchState = context.shadowComputeState.borrowSource();
    if(scratchState.has_value())
        shadowVisibilityStateSources[shadowVisibilityStateSourceCount++].setState(scratchState.value());
    const auto returnState = context.shadowReturnState.borrowSource();
    if(returnState.has_value()){
        shadowVisibilityStateSources[shadowVisibilityStateSourceCount].setState(returnState.value());
        shadowVisibilityStateSources[shadowVisibilityStateSourceCount++].applicableConsumerQueueClass = CommandQueue::Compute;
    }
    const auto stateSources = Span<GpuTaskExternalStateSource>(shadowVisibilityStateSources).first(shadowVisibilityStateSourceCount);
    const Array<GpuExternalCompletionId, 1u> historyCompletions(laggedLightingHistoryWriterDrainCompletion);
    const auto historyDependencies = Span<GpuExternalCompletionId>(historyCompletions).first(cast<usize>(laggedLightingHistoryWriterDrainCompletion.valid()));

    opaqueProduced = false;
    transparentTraceProduced = false;
    opaqueFrameIndex = 0u;
    const b8 preparedSoftTransparentFoldCandidate =
        rayTracingPlan.softTransparentFoldReady
        && deferredTargets.shadowCoarseTransmittance.valid() && deferredTargets.shadowSoftHalfA.valid() && deferredTargets.shadowSoftHalfB.valid()
        && deferredTargets.shadowSoftGeometry.valid() && deferredTargets.shadowSoftGeometryPrev.valid()
        && deferredTargets.shadowHistA.valid() && deferredTargets.shadowHistB.valid() && deferredTargets.shadowMomentsA.valid() && deferredTargets.shadowMomentsB.valid()
        && deferredTargets.transparentSoftHalf.valid() && deferredTargets.transparentHistA.valid() && deferredTargets.transparentHistB.valid()
        && deferredTargets.transparentMomentsA.valid() && deferredTargets.transparentMomentsB.valid()
        && materialContextSlots.valid() && !traceGeometryResources.empty()
    ;
    const ShadowVisibilityRouteSelection routeSelection = ResolveShadowVisibilityRouteSelection(
        preparedSoftTransparentFoldCandidate, rayTracingPlan.combinedSoftUpsample, rayTracingPlan.combinedSoftWaveletReady,
        rayTracingPlan.opaqueTemporalMergeReady, rayTracingPlan.transparentTemporalMergeReady, rayTracingPlan.combinedSoftTemporalReady,
        s_ShadowWaveletResolvePassCount, s_ShadowWaveletTransparentResolvePassCount
    );
    const b8 splitSoftTransparentFold = routeSelection.splitSoftTransparentFold;
    this.m_deferredShadowCombinedUpsample = routeSelection.combinedSoftUpsample;
    this.m_deferredShadowCombinedWavelet = routeSelection.combinedSoftWavelet;
    this.m_deferredShadowCombinedTemporal = routeSelection.combinedSoftTemporal;
    const b8 graphOwnedAdaptiveCandidate = !splitSoftTransparentFold && rayTracingPlan.adaptivePlan.enabled;
    GraphOwnedAdaptiveShadowPlan graphOwnedAdaptivePlan;
    if(graphOwnedAdaptiveCandidate)
        graphOwnedAdaptivePlan = rayTracingPlan.adaptivePlan;
    const b8 softShadowHistoryReadable = rayTracingPlan.softShadowHistoryReadable;
    const b8 graphOwnsOpaqueTemporalMergeEntryStates = routeSelection.graphOwnsOpaqueTemporalMergeEntryStates;
    const b8 opaqueHistoryFrontIsA = rayTracingPlan.historyFrontIsA;

    const b8 traceGeometryStatesGraphOwned = traceGeometrySet.valid();
    ShadowVisibilityResourcePlan shadowResourcePlan;
    const ShadowVisibilityResourceInputs shadowResourceInputs(
        deferredTargets, rayTracingShadowResources, rayTracingResources, rayTracingPlan, hardwareSceneReads,
        worldPosition, normal, depth, shadowVisibility, currentBindlessSlots, sceneShading, lights, materialContextSlots,
        traceGeometryResources, traceGeometryStatesGraphOwned, splitSoftTransparentFold, graphOwnsOpaqueTemporalMergeEntryStates,
        softShadowHistoryReadable, opaqueHistoryFrontIsA, hardwareTransparentTrace, graphOwnedAdaptivePlan.compact
    );
    ShadowVisibilityResourcePlanner shadowResourcePlanner(context.graph, context.rayTracing);
    if(!shadowResourcePlanner.prepare(shadowResourceInputs, shadowResourcePlan))
        return false;

    const TraceResourceSetUses traceResourceSets = MakeTraceResourceSetUses(traceGeometrySet, traceMaterialSampledTextureSet);
    GpuTaskResourceSetUse traceGeometrySetUse;
    if(traceResourceSets.useCount != 0u)
        traceGeometrySetUse = traceResourceSets.uses[0u];

    if(splitSoftTransparentFold){
        const SoftShadowSplitRoute splitRoute = MakeSoftShadowSplitRoute(hardwareShadowSupported, hardwareCsgShadow, csgShadow, traceGeometryStatesGraphOwned, routeSelection);
        const SoftShadowSplitResourceInputs splitResourceInputs(
            deferredTargets, rayTracingResources, rayTracingPlan,
            hardwareSceneReads, shadowResourcePlan.hardwareTransparentScratch, splitRoute,
            traceGeometryResources, worldPosition, normal, depth,
            shadowVisibility, currentBindlessSlots, sceneShading,
            lights, materialContextSlots, shadowResourcePlan.sceneGeometryDomain, shadowResourcePlan.sceneTlas
        );
        SoftShadowSplitResourceUses splitResourceUses;
        SoftShadowSplitResourceUseBuilder resourceUseBuilder(context.graph);
        if(!resourceUseBuilder.build(splitResourceInputs, splitResourceUses))
            return false;

        const SoftShadowSplitTaskChainInputs taskChainInputs(
            deferredTargets, deferredLightingResources, rayTracingResources,
            rayTracingPlan, context.shadowPrepared, timingTicket,
            asyncTiming, shadowVisibilityTiming, opaqueResolveTiming,
            transparentResolveTiming, opaqueProduced, transparentTraceProduced,
            opaqueFrameIndex, splitRoute, traceGeometryResources,
            Span<GpuTaskResourceSetUse>(traceResourceSets.uses).first(traceResourceSets.useCount),
            traceGeometrySetUse,
            stateSources,
            historyDependencies,
            currentBindlessSlots, sceneShading, lights,
            materialContextSlots, prefixTask
        );
        SoftShadowSplitTasks splitTasks;
        SoftShadowSplitTaskChainBuilder taskChainBuilder(context.graph, context.graphics, context.rayTracing);
        const b8 declared = taskChainBuilder.declare(taskChainInputs, splitResourceUses, splitTasks);
        this.m_deferredShadowVisibilityOpaqueTask = splitTasks.opaque;
        this.m_deferredShadowVisibilityOpaqueFirstWaveletTask = splitTasks.opaqueFirstWavelet;
        this.m_deferredShadowVisibilityOpaqueResolveTask = splitTasks.opaqueResolve;
        this.m_deferredShadowVisibilityTransparentTraceTask = splitTasks.transparentTrace;
        this.m_deferredShadowVisibilityTransparentTemporalMergeTask = splitTasks.transparentTemporalMerge;
        this.m_deferredShadowVisibilityTransparentFirstWaveletTask = splitTasks.transparentFirstWavelet;
        this.m_deferredShadowVisibilityTask = splitTasks.fold;
        this.m_deferredShadowVisibilityDiagnosticsTask = splitTasks.diagnostics;
        return declared;
    }

    GpuTaskId shadowVisibilityDependency = prefixTask;
    b8 adaptivePrimitivePrecedesVisibility = false;
    if(graphOwnedAdaptivePlan.enabled){
        GpuTaskSchedulingHint primitiveScheduling;
        primitiveScheduling.cost = GpuTaskCostHint::Tiny;
        primitiveScheduling.forceSubmissionBoundary = false;
        primitiveScheduling.allowPacketMerge = true;
        ConfigureComputeEffectRoutingHint(false, primitiveScheduling);

        if(graphOwnedAdaptivePlan.compact){
            GpuTaskSchedulingHint counterClearScheduling = primitiveScheduling;
            counterClearScheduling.mergeWithPrevious = adaptivePrimitivePrecedesVisibility;
            counterClearScheduling.allowParallelRecording = true;
            GpuTaskDesc counterClearDesc;
            counterClearDesc.setIdentity(Name(s_ShadowPassAdaptiveCounterClear)).setMarkerLabel(s_ShadowAdaptiveCounterClearLabel).setScheduling(counterClearScheduling).setDependency(shadowVisibilityDependency);
            GpuClearBufferTaskDesc clear;
            clear.destination = shadowResourcePlan.adaptiveEdgeCounter;
            clear.clearValue = 0u;
            const auto deferredShadowVisibilityAdaptiveCounterClearTaskResult = context.graph.addClearBufferTask(counterClearDesc, clear);
            if(!deferredShadowVisibilityAdaptiveCounterClearTaskResult.has_value()){
                this.m_deferredShadowVisibilityAdaptiveCounterClearTask = GpuTaskId();
                warning("RendererSystem: could not declare graph-owned adaptive shadow counter clear");
                return false;
            }
            this.m_deferredShadowVisibilityAdaptiveCounterClearTask = deferredShadowVisibilityAdaptiveCounterClearTaskResult.value();
            shadowVisibilityDependency = this.m_deferredShadowVisibilityAdaptiveCounterClearTask;
            adaptivePrimitivePrecedesVisibility = true;
        }
    }

    GpuTaskSchedulingHint allLitClearScheduling;
    allLitClearScheduling.cost = GpuTaskCostHint::Tiny;
    allLitClearScheduling.forceSubmissionBoundary = false;
    allLitClearScheduling.allowPacketMerge = true;
    allLitClearScheduling.mergeWithPrevious = adaptivePrimitivePrecedesVisibility;
    allLitClearScheduling.allowParallelRecording = true;
    ConfigureComputeEffectRoutingHint(adaptivePrimitivePrecedesVisibility, allLitClearScheduling);
    const Array<GpuTaskResourceUse, 1u> allLitClearUses(WriteTextureUse(shadowVisibility, s_ShadowVisibilitySubresources, ResourceStates::CopyDest));
    GpuTaskDesc allLitClearDesc;
    allLitClearDesc
        .setIdentity(Name(s_ShadowPassAllLitClear))
        .setMarkerLabel(s_ShadowVisibilityAllLitClearLabel)
        .setScheduling(allLitClearScheduling)
        .setDependency(shadowVisibilityDependency)
        .setExternalDependencies(historyDependencies)
        .setResourceUses(allLitClearUses)
    ;
    const auto deferredShadowVisibilityAllLitClearTaskResult = AddFloatTextureClearTask(context.graph, allLitClearDesc, shadowVisibility, s_ShadowVisibilitySubresources, s_ShadowVisibilityAllLitClearColor);
    if(!deferredShadowVisibilityAllLitClearTaskResult.has_value()){
        this.m_deferredShadowVisibilityAllLitClearTask = GpuTaskId();
        warning("RendererSystem: could not declare graph-owned all-lit shadow-visibility clear");
        return false;
    }
    this.m_deferredShadowVisibilityAllLitClearTask = deferredShadowVisibilityAllLitClearTaskResult.value();
    shadowVisibilityDependency = this.m_deferredShadowVisibilityAllLitClearTask;

    GpuTaskSchedulingHint scheduling;
    scheduling.cost = GpuTaskCostHint::Large;
    scheduling.forceSubmissionBoundary = false;
    scheduling.allowPacketMerge = true;
    scheduling.mergeWithPrevious = true;
    ConfigureComputeEffectRoutingHint(true, scheduling);
    GpuTaskDesc desc;
    desc
        .setIdentity(Name(s_ShadowVisibilityPass))
        .setMarkerLabel(s_ShadowVisibilityLabel)
        .setScheduling(scheduling)
        .setDependency(shadowVisibilityDependency)
        .setExternalStateSources(stateSources)
        .setResourceUses(shadowResourcePlan.resourceUses)
        .setResourceSetUses(Span<GpuTaskResourceSetUse>(traceResourceSets.uses).first(traceResourceSets.useCount))
    ;
    const auto deferredShadowVisibilityTaskResult = context.rayTracing.declareShadowVisibilityTask(context.graph, desc, deferredLightingResources, context.shadowPrepared, hardwareShadowSupported, graphOwnedAdaptivePlan, deferredTargets, timingTicket);
    if(!deferredShadowVisibilityTaskResult.has_value()){
        this.m_deferredShadowVisibilityTask = GpuTaskId();
        warning("RendererSystem: could not declare deferred shadow-visibility graph task");
        return false;
    }
    this.m_deferredShadowVisibilityTask = deferredShadowVisibilityTaskResult.value();
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void ShadowVisibilityMergeValidator::validate(in GpuCompiledGraphReadView compiledPlan, mut ShadowVisibilityMergeValidationResult outResult)const{
    in RendererFramePipeline pipeline = this.m_pipeline;
    outResult = ShadowVisibilityMergeValidationResult();
    PreparedShadowVisibilityTasks tasks;
    tasks.terminal = pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityTask;
    tasks.opaque = pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityOpaqueTask;
    tasks.opaqueFirstWavelet = pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityOpaqueFirstWaveletTask;
    tasks.opaqueResolve = pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityOpaqueResolveTask;
    tasks.transparentTrace = pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityTransparentTraceTask;
    tasks.transparentTemporalMerge = pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityTransparentTemporalMergeTask;
    tasks.transparentFirstWavelet = pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityTransparentFirstWaveletTask;
    tasks.diagnostics = pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityDiagnosticsTask;
    tasks.combinedUpsample = pipeline.m_shadowVisibilityGraph.m_deferredShadowCombinedUpsample;
    tasks.combinedWavelet = pipeline.m_shadowVisibilityGraph.m_deferredShadowCombinedWavelet;
    tasks.combinedTemporal = pipeline.m_shadowVisibilityGraph.m_deferredShadowCombinedTemporal;
    outResult.preparedTasksMerged = PreparedShadowVisibilityTasksSharePacket(compiledPlan, tasks);
    const b8 hasOpaqueSplitTask = pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityOpaqueTask.valid();
    const b8 hasAllLitClearTask = pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityAllLitClearTask.valid();
    const b8 clearSharesPacket = hasAllLitClearTask && compiledPlan.tasksSharePacket(pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityTask, pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityAllLitClearTask);
    outResult.allLitClearMerged = ResolveAllLitShadowClearMerged(hasOpaqueSplitTask, hasAllLitClearTask, clearSharesPacket);
    outResult.adaptivePrimitivesMerged = !pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityAdaptiveCounterClearTask.valid() || compiledPlan.tasksSharePacket(pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityTask, pipeline.m_shadowVisibilityGraph.m_deferredShadowVisibilityAdaptiveCounterClearTask);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ShadowVisibilityResourcePlanner::prepare(in ShadowVisibilityResourceInputs inputs, mut ShadowVisibilityResourcePlan result){
    const auto worldPosition = inputs.worldPosition;
    const auto normal = inputs.normal;
    const auto depth = inputs.depth;
    const auto shadowVisibility = inputs.shadowVisibility;
    const auto currentBindlessSlots = inputs.currentBindlessSlots;
    const auto sceneShading = inputs.sceneShading;
    const auto lights = inputs.lights;
    const auto materialContextSlots = inputs.materialContextSlots;
    const auto traceGeometryStatesGraphOwned = inputs.traceGeometryStatesGraphOwned;
    const auto splitSoftTransparentFold = inputs.splitSoftTransparentFold;
    const auto graphOwnsOpaqueTemporalMergeEntryStates = inputs.graphOwnsOpaqueTemporalMergeEntryStates;
    const auto softShadowHistoryReadable = inputs.softShadowHistoryReadable;
    const auto opaqueHistoryFrontIsA = inputs.opaqueHistoryFrontIsA;
    const auto hardwareTransparentTrace = inputs.hardwareTransparentTrace;
    const auto adaptiveCompact = inputs.adaptiveCompact;

    const auto sceneGeometryDomainResult = this.m_graph.importHazardDomain(HazardDomainDesc(Name(s_ShadowPassSceneGeometry), s_SceneGeometryDomainLabel));
    if(!sceneGeometryDomainResult.has_value()){
        warning("RendererSystem: could not import deferred shadow-visibility graph resources");
        return false;
    }
    result.sceneGeometryDomain = sceneGeometryDomainResult.value();

    if(splitSoftTransparentFold){
        if(inputs.rayTracingShadowResources.sceneTlas.valid()){
            GpuGraphResourceDesc tlasDesc = AccelStructResourceDesc(Name(s_SceneTlasResourceName), s_SceneTlasResourceLabel);
            tlasDesc.setInitialState(this.m_raytracingSystem.sceneTlasBackingInitialState());
            const auto sceneTlasResult = this.m_graph.importAccelStruct(inputs.rayTracingShadowResources.sceneTlas, tlasDesc);
            if(!sceneTlasResult.has_value()){
                warning("RendererSystem: could not import a deferred shadow-visibility dynamic resource");
                return false;
            }
            result.sceneTlas = sceneTlasResult.value();
        }
        if(hardwareTransparentTrace){
            const Array<BufferHandle, 3u> buffers(inputs.rayTracingResources.hardwareTransparentCrossingsBuffer, inputs.rayTracingResources.hardwareTransparentOverflowListBuffer, inputs.rayTracingResources.hardwareTransparentOverflowArgsBuffer);
            for(usize index = 0u; index < buffers.size(); ++index){
                in BufferHandle buffer = buffers[index];
                if(!buffer.valid())
                    return false;
                in BufferDesc bufferDesc = buffer.deref().getCreationDescription();
                if(bufferDesc.debugName == s_NameNone)
                    return false;
                GpuGraphResourceDesc scratchDesc = BufferResourceDesc(bufferDesc.debugName, s_HardwareTransparentScratchLabel);
                scratchDesc.setInitialState(bufferDesc.initialState);
                const auto hardwareTransparentScratchResult = this.m_graph.importBuffer(buffer, scratchDesc);
                if(!hardwareTransparentScratchResult.has_value()){
                    result.hardwareTransparentScratch[index] = GpuGraphResourceId();
                    return false;
                }
                result.hardwareTransparentScratch[index] = hardwareTransparentScratchResult.value();
            }
        }
        if(!traceGeometryStatesGraphOwned){
            for(in GpuGraphResourceId resource : inputs.traceGeometryResources){
                if(!resource.valid())
                    return false;
            }
        }
        return true;
    }

    result.resourceUses.reserve(ResolveShadowTraceGeometryReserveCount(s_ShadowVisibilityResourceUseCapacity, traceGeometryStatesGraphOwned, inputs.traceGeometryResources.size()));
    result.resourceUses.push_back(ReadUse(worldPosition));
    result.resourceUses.push_back(ReadUse(normal));
    result.resourceUses.push_back(ReadUse(depth, ResourceStates::ShaderResource));
    result.resourceUses.push_back(ReadUse(currentBindlessSlots, ResourceStates::ConstantBuffer));
    if(splitSoftTransparentFold)
        result.resourceUses.push_back(WriteUse(shadowVisibility, ResourceStates::UnorderedAccess));
    else
        result.resourceUses.push_back(ReadWriteUse(shadowVisibility, ResourceStates::UnorderedAccess));
    result.resourceUses.push_back(ReadUse(result.sceneGeometryDomain));

    b8 optionalResourcesImported =
        (splitSoftTransparentFold || AppendShadowTemporalTexture(this.m_graph, result.resourceUses, inputs.deferredTargets.shadowCoarseTransmittance, Name(s_ShadowPassCoarseTransmittance),
            s_ShadowCoarseTransmittanceLabel, ShadowTemporalResourceUseKind::UnorderedAccessWrite))
        && AppendShadowTemporalTexture(this.m_graph, result.resourceUses, inputs.deferredTargets.shadowSoftHalfA, Name(s_ShadowSoftHalfAName), s_ShadowSoftHalfALabel, ShadowTemporalResourceUseKind::UnorderedAccessWrite)
        && AppendShadowTemporalTexture(this.m_graph, result.resourceUses, inputs.deferredTargets.shadowSoftHalfB, Name(s_ShadowSoftHalfBName), s_ShadowSoftHalfBLabel, ShadowTemporalResourceUseKind::UnorderedAccessWrite)
        && AppendShadowTemporalTexture(this.m_graph, result.resourceUses, inputs.deferredTargets.shadowSoftGeometry, Name(s_ShadowSoftGeometryName), s_ShadowSoftGeometryLabel, ShadowTemporalResourceUseKind::UnorderedAccessWrite)
        && AppendShadowTemporalTexture(this.m_graph, result.resourceUses, inputs.deferredTargets.shadowSoftGeometryPrev, Name(s_ShadowSoftGeometryPreviousName), s_ShadowSoftGeometryPreviousLabel,
            ResolveOpaqueTemporalStaticReadUseKind(softShadowHistoryReadable, splitSoftTransparentFold, graphOwnsOpaqueTemporalMergeEntryStates))
        && AppendShadowTemporalTexture(this.m_graph, result.resourceUses, inputs.deferredTargets.shadowHistA, Name(s_ShadowHistoryAName), s_ShadowHistoryALabel,
            ResolveOpaqueTemporalHistoryUseKind(graphOwnsOpaqueTemporalMergeEntryStates, splitSoftTransparentFold, softShadowHistoryReadable, inputs.rayTracingPlan.opaqueTemporalMergeReady, opaqueHistoryFrontIsA))
        && AppendShadowTemporalTexture(this.m_graph, result.resourceUses, inputs.deferredTargets.shadowHistB, Name(s_ShadowHistoryBName), s_ShadowHistoryBLabel,
            ResolveOpaqueTemporalHistoryUseKind(graphOwnsOpaqueTemporalMergeEntryStates, splitSoftTransparentFold, softShadowHistoryReadable, inputs.rayTracingPlan.opaqueTemporalMergeReady, !opaqueHistoryFrontIsA))
        && AppendShadowTemporalTexture(this.m_graph, result.resourceUses, inputs.deferredTargets.shadowMomentsA, Name(s_ShadowMomentsAName), s_ShadowMomentsALabel,
            ResolveOpaqueTemporalHistoryUseKind(graphOwnsOpaqueTemporalMergeEntryStates, splitSoftTransparentFold, softShadowHistoryReadable, inputs.rayTracingPlan.opaqueTemporalMergeReady, opaqueHistoryFrontIsA))
        && AppendShadowTemporalTexture(this.m_graph, result.resourceUses, inputs.deferredTargets.shadowMomentsB, Name(s_ShadowMomentsBName), s_ShadowMomentsBLabel,
            ResolveOpaqueTemporalHistoryUseKind(graphOwnsOpaqueTemporalMergeEntryStates, splitSoftTransparentFold, softShadowHistoryReadable, inputs.rayTracingPlan.opaqueTemporalMergeReady, !opaqueHistoryFrontIsA))
        && AppendShadowTemporalTexture(this.m_graph, result.resourceUses, inputs.deferredTargets.transparentSoftHalf, Name(s_TransparentSoftHalfName), s_TransparentSoftHalfLabel, ShadowTemporalResourceUseKind::UnorderedAccessWrite)
        && AppendShadowTemporalTexture(this.m_graph, result.resourceUses, inputs.deferredTargets.transparentHistA, Name(s_TransparentHistoryAName), s_TransparentHistoryALabel,
            ResolveTransparentTemporalHistoryUseKind(inputs.rayTracingPlan.transparentTemporalMergeReady, softShadowHistoryReadable, opaqueHistoryFrontIsA))
        && AppendShadowTemporalTexture(this.m_graph, result.resourceUses, inputs.deferredTargets.transparentHistB, Name(s_TransparentHistoryBName), s_TransparentHistoryBLabel,
            ResolveTransparentTemporalHistoryUseKind(inputs.rayTracingPlan.transparentTemporalMergeReady, softShadowHistoryReadable, !opaqueHistoryFrontIsA))
        && AppendShadowTemporalTexture(this.m_graph, result.resourceUses, inputs.deferredTargets.transparentMomentsA, Name(s_TransparentMomentsAName), s_TransparentMomentsALabel,
            ResolveTransparentTemporalHistoryUseKind(inputs.rayTracingPlan.transparentTemporalMergeReady, softShadowHistoryReadable, opaqueHistoryFrontIsA))
        && AppendShadowTemporalTexture(this.m_graph, result.resourceUses, inputs.deferredTargets.transparentMomentsB, Name(s_TransparentMomentsBName), s_TransparentMomentsBLabel,
            ResolveTransparentTemporalHistoryUseKind(inputs.rayTracingPlan.transparentTemporalMergeReady, softShadowHistoryReadable, !opaqueHistoryFrontIsA))
        && (hardwareTransparentTrace || AppendRayTracingSceneShadowBuffers(inputs.rayTracingResources, this.m_graph, result.resourceUses))
        && AppendShadowOptionalReadWriteBuffer(this.m_graph, result.resourceUses, inputs.rayTracingShadowResources.swShadowEdgeCounterBuffer, Name(s_ShadowEdgeCounterName), s_ShadowEdgeCounterLabel, ResourceStates::UnorderedAccess)
        && AppendShadowOptionalReadWriteBuffer(this.m_graph, result.resourceUses, inputs.rayTracingShadowResources.swShadowEdgeListBuffer, Name(s_ShadowPassEdgeList), s_ShadowEdgeListLabel, ResourceStates::UnorderedAccess)
        && AppendShadowOptionalReadWriteBuffer(this.m_graph, result.resourceUses, inputs.rayTracingShadowResources.swShadowIndirectArgsBuffer, Name(s_ShadowPassIndirectArgs), s_ShadowIndirectArgsLabel, ResourceStates::UnorderedAccess)
    ;
    if(inputs.rayTracingShadowResources.sceneTlas.valid()){
        GpuGraphResourceDesc tlasDesc = AccelStructResourceDesc(Name(s_SceneTlasResourceName), s_SceneTlasResourceLabel);
        tlasDesc.setInitialState(this.m_raytracingSystem.sceneTlasBackingInitialState());
        const auto sceneTlasResult = this.m_graph.importAccelStruct(inputs.rayTracingShadowResources.sceneTlas, tlasDesc);
        if(sceneTlasResult.has_value())
            result.sceneTlas = sceneTlasResult.value();
        optionalResourcesImported = optionalResourcesImported && sceneTlasResult.has_value();
        if(result.sceneTlas.valid() && !hardwareTransparentTrace)
            result.resourceUses.push_back(ReadUse(result.sceneTlas, ResourceStates::AccelStructRead));
    }
    if(hardwareTransparentTrace){
        const Array<BufferHandle, 3u> buffers( inputs.rayTracingResources.hardwareTransparentCrossingsBuffer, inputs.rayTracingResources.hardwareTransparentOverflowListBuffer, inputs.rayTracingResources.hardwareTransparentOverflowArgsBuffer);
        for(usize index = 0u; index < buffers.size(); ++index){
            in BufferHandle buffer = buffers[index];
            if(!buffer.valid())
                return false;
            in BufferDesc bufferDesc = buffer.deref().getCreationDescription();
            if(bufferDesc.debugName == s_NameNone)
                return false;
            GpuGraphResourceDesc scratchDesc = BufferResourceDesc(bufferDesc.debugName, s_HardwareTransparentScratchLabel);
            scratchDesc.setInitialState(bufferDesc.initialState);
            const auto hardwareTransparentScratchResult = this.m_graph.importBuffer(buffer, scratchDesc);
            if(!hardwareTransparentScratchResult.has_value()){
                result.hardwareTransparentScratch[index] = GpuGraphResourceId();
                return false;
            }
            result.hardwareTransparentScratch[index] = hardwareTransparentScratchResult.value();
            result.resourceUses.push_back(ReadWriteUse(result.hardwareTransparentScratch[index], ResourceStates::UnorderedAccess));
        }
        for(in GpuTaskResourceUse use : inputs.hardwareSceneReads.uses)
            result.resourceUses.push_back(use);
    }
    if(!optionalResourcesImported){
        warning("RendererSystem: could not import a deferred shadow-visibility dynamic resource");
        return false;
    }
    if(adaptiveCompact){
        const auto adaptiveEdgeCounterResult = ImportExternalBuffer(this.m_graph, inputs.rayTracingShadowResources.swShadowEdgeCounterBuffer, Name(s_ShadowEdgeCounterName), s_ShadowEdgeCounterLabel);
        if(!adaptiveEdgeCounterResult.has_value()){
            result.adaptiveEdgeCounter = GpuGraphResourceId();
            warning("RendererSystem: could not import graph-owned adaptive shadow counter resource");
            return false;
        }
        result.adaptiveEdgeCounter = adaptiveEdgeCounterResult.value();
    }
    result.resourceUses.push_back(ReadUse(sceneShading, ResourceStates::ConstantBuffer));
    result.resourceUses.push_back(ReadUse(lights, ResourceStates::ShaderResource));
    if(materialContextSlots.valid() && !hardwareTransparentTrace)
        result.resourceUses.push_back(ReadUse(materialContextSlots, ResourceStates::ConstantBuffer));
    if(!traceGeometryStatesGraphOwned){
        for(in GpuGraphResourceId resource : inputs.traceGeometryResources){
            if(!resource.valid())
                return false;
            result.resourceUses.push_back(ReadUse(resource, ResourceStates::ShaderResource));
        }
    }
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

