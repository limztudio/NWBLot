////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/shared/frame_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 CanOrderReusedAvboitGeometry(in b8 localProducerValid, in usize sharedPhaseCount, in b8 sourceMatchesConsumer){
    return !localProducerValid && sharedPhaseCount == 0u && !sourceMatchesConsumer;
}

b8 HasValidAvboitSharedPhaseBounds(
    in usize phaseCount,
    in usize sharedTaskCapacity,
    in b8 regularComputeEmulationValid,
    in b8 streamTaskValid
){
    return phaseCount <= sharedTaskCapacity
        && IsSupportedSharedComputeEmulationPhaseCount(phaseCount)
        && !regularComputeEmulationValid
        && streamTaskValid;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 IsAvboitQueueOnClass(in Optional<GpuPhysicalQueueInfo> queue, in CommandQueue queueClass){
    return queue.has_value() && queue.value().queueClass == queueClass;
}

b8 IsAvboitCompiledTaskValid(in GpuCompiledGraphReadView compiledGraph, in GpuTaskId task){
    return compiledGraph.valid() && task.valid() && compiledGraph.findTask(task).valid();
}

b8 IsOptionalAvboitTaskPrecedingInSharedPacket(
    in GpuCompiledGraphReadView compiledGraph,
    in GpuTaskId optionalTask,
    in GpuTaskId consumerTask
){
    return !optionalTask.valid()
        || !compiledGraph.tasksSharePacket(optionalTask, consumerTask)
        || compiledGraph.taskPrecedesInSamePacket(optionalTask, consumerTask);
}

b8 IsAvboitTaskBoundaryOrdered(
    in GpuCompiledGraphReadView compiledGraph,
    in GpuTaskId producerTask,
    in GpuTaskId consumerTask
){
    if(!producerTask.valid() || !consumerTask.valid())
        return false;
    if(compiledGraph.tasksSharePacket(producerTask, consumerTask))
        return compiledGraph.taskPrecedesInSamePacket(producerTask, consumerTask);
    return compiledGraph.taskPrecedesOrSharesPacket(producerTask, consumerTask);
}

b8 IsAvboitReusedGeometryOrdered(
    in GpuCompiledGraphReadView compiledGraph,
    in GpuTaskId source,
    in GpuTaskId consumer,
    in GpuTaskId localProducer,
    in usize sharedPhaseCount
){
    return !source.valid()
        || (CanOrderReusedAvboitGeometry(localProducer.valid(), sharedPhaseCount, source == consumer)
            && IsAvboitCompiledTaskValid(compiledGraph, source)
            && IsAvboitTaskBoundaryOrdered(compiledGraph, source, consumer));
}

b8 IsAvboitComputeEmulationMerged(
    in GpuCompiledGraphReadView compiledGraph,
    in GpuTaskId computeEmulationTask,
    in GpuTaskId rasterTask,
    in GpuTaskId streamTask,
    in Optional<GpuPhysicalQueueInfo> computeEmulationQueue,
    in Optional<GpuPhysicalQueueInfo> rasterQueue
){
    if(!computeEmulationTask.valid())
        return true;
    if(
        !streamTask.valid()
        || !IsAvboitQueueOnClass(computeEmulationQueue, CommandQueue::Graphics)
        || !IsAvboitQueueOnClass(rasterQueue, CommandQueue::Graphics)
        || !compiledGraph.tasksSharePacket(computeEmulationTask, rasterTask)
        || !compiledGraph.taskPrecedesOrSharesPacket(streamTask, computeEmulationTask)
    )
        return false;
    Array<GpuTaskId, 2u> taskPair;
    taskPair[0u] = computeEmulationTask;
    taskPair[1u] = rasterTask;
    return compiledGraph.tasksFormContiguousPacketSequence(taskPair)
        && IsOptionalAvboitTaskPrecedingInSharedPacket(compiledGraph, streamTask, computeEmulationTask);
}

b8 IsAvboitSharedComputeEmulationChainValid(
    in GpuCompiledGraphReadView compiledGraph,
    in Span<GpuTaskId> sharedTasks,
    in usize phaseCount,
    in GpuTaskId regularComputeEmulationTask,
    in GpuTaskId rasterTask,
    in GpuTaskId streamTask,
    in Optional<GpuPhysicalQueueInfo> sharedQueue,
    in Optional<GpuPhysicalQueueInfo> rasterQueue
){
    if(phaseCount == 0u){
        for(in GpuTaskId task : sharedTasks){
            if(task.valid())
                return false;
        }
        return true;
    }
    if(
        !HasValidAvboitSharedPhaseBounds(phaseCount, sharedTasks.size(), regularComputeEmulationTask.valid(), streamTask.valid())
        || !IsAvboitQueueOnClass(sharedQueue, CommandQueue::Graphics)
        || !IsAvboitQueueOnClass(rasterQueue, CommandQueue::Graphics)
        || rasterTask != sharedTasks[phaseCount - 1u]
        || !compiledGraph.taskPrecedesOrSharesPacket(streamTask, sharedTasks[0u])
    )
        return false;
    for(usize phaseIndex = 0u; phaseIndex < phaseCount; ++phaseIndex){
        const GpuTaskId task = sharedTasks[phaseIndex];
        if(!task.valid())
            return false;
        if(
            !IsAvboitQueueOnClass(compiledGraph.findQueueInfoForTask(task), CommandQueue::Graphics)
            || !compiledGraph.tasksSharePacket(sharedTasks[0u], task)
        )
            return false;
    }
    for(usize phaseIndex = phaseCount; phaseIndex < sharedTasks.size(); ++phaseIndex){
        if(sharedTasks[phaseIndex].valid())
            return false;
    }
    return compiledGraph.tasksFormContiguousPacketSequence(sharedTasks.subspan(0u, phaseCount));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

