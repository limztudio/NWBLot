#include <impl/ecs_render/raytrace/raytracing_system.adhd>
#include <impl/ecs_render/kernel/timing_names.adhd>
#include <impl/ecs_render/shadow/rt_shadow_state.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


SoftShadowOpaqueResolvePhase ResolveSoftShadowOpaqueFirstWaveletPhase(in b8 deferWavelet){
    if(deferWavelet)
        return SoftShadowOpaqueResolvePhase::TemporalOnly;
    return SoftShadowOpaqueResolvePhase::TemporalAndWavelet;
}

b8 ShouldPublishDeferredOpaqueFallbackUpsample(in b8 combinedUpsample, in b8 transparentTraceProduced){
    return combinedUpsample && !transparentTraceProduced;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void RecoverOpaqueSoftShadowAllLit(
    mut RendererRayTracingSystem raytracingSystem,
    mut DeferredFrameTargets targets,
    mut b8 opaqueProduced,
    mut Optional<GpuTimingMeasure> asyncTiming,
    mut Optional<GpuTimingMeasure> shadowVisibilityTiming,
    mut Optional<GpuTimingMeasure> opaqueResolveTiming,
    mut CommandList commandList
){
    raytracingSystem.clearShadowVisibility(commandList, targets);
    commandList.setTextureState(targets.shadowVisibility.deref(), s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess);
    commandList.commitBarriers();
    opaqueProduced = false;
    if(asyncTiming.has_value()){
        asyncTiming.value().discardTiming();
        asyncTiming.reset();
    }
    if(shadowVisibilityTiming.has_value()){
        shadowVisibilityTiming.value().discardTiming();
        shadowVisibilityTiming.reset();
    }
    opaqueResolveTiming.value().discardTiming();
    opaqueResolveTiming.reset();
}


class ShadowVisibilityOpaqueGraphTask{
    private mut RendererRayTracingSystem raytracingSystem;
    private mut GraphicsRuntime graphics;
    private mut DeferredFrameTargets targets;
    private DeferredLightingGraphResources deferredLightingResources;
    private b8 hardwareShadowSupported;
    private b8 graphOwnsOpaqueTemporalMergeEntryStates;
    private FrozenLightSpaceShadowHandle lightSpace;
    private mut GpuTimingSubmissionTicket timingTicket;
    private mut Optional<GpuTimingMeasure> asyncTiming;
    private mut Optional<GpuTimingMeasure> shadowVisibilityTiming;
    private in b8 prepared;
    private mut b8 opaqueProduced;
    private mut u32 opaqueFrameIndex;

    public ShadowVisibilityOpaqueGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        mut GraphicsRuntime graphics,
        mut DeferredFrameTargets targets,
        in DeferredLightingGraphResources deferredLightingResources,
        in b8 hardwareShadowSupported,
        in b8 graphOwnsOpaqueTemporalMergeEntryStates,
        in FrozenLightSpaceShadowHandle lightSpace,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> asyncTiming,
        mut Optional<GpuTimingMeasure> shadowVisibilityTiming,
        in borrow b8 prepared,
        mut b8 opaqueProduced,
        mut u32 opaqueFrameIndex
    ){
        this.raytracingSystem = raytracingSystem;
        this.graphics = graphics;
        this.targets = targets;
        this.deferredLightingResources = deferredLightingResources;
        this.hardwareShadowSupported = hardwareShadowSupported;
        this.graphOwnsOpaqueTemporalMergeEntryStates = graphOwnsOpaqueTemporalMergeEntryStates;
        this.lightSpace = lightSpace;
        this.timingTicket = timingTicket;
        this.asyncTiming = asyncTiming;
        this.shadowVisibilityTiming = shadowVisibilityTiming;
        this.prepared = prepared;
        this.opaqueProduced = opaqueProduced;
        this.opaqueFrameIndex = opaqueFrameIndex;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.deferredLightingResources.valid())
            return false;

        const Optional<GpuPhysicalQueueInfo> queue = context.compiledPlan.findQueueInfo(context.queue);
        if(!queue.has_value())
            return false;

        this.opaqueProduced = false;
        this.opaqueFrameIndex = 0u;
        if(this.shadowVisibilityTiming.has_value()){
            this.shadowVisibilityTiming.value().discardTiming();
            this.shadowVisibilityTiming.reset();
        }
        if(this.asyncTiming.has_value()){
            this.asyncTiming.value().discardTiming();
            this.asyncTiming.reset();
        }

        GpuTimingTicketRecordingScope timingRecording(this.timingTicket);
        if(queue.value().queueClass == CommandQueue::Compute)
            this.asyncTiming.emplace(this.graphics.gpuTiming(), s_TimingScopeAsyncShadow, this.graphics.getDevice(), commandList);
        this.shadowVisibilityTiming.emplace(this.graphics.gpuTiming(), s_TimingScopeShadowVisibility, this.graphics.getDevice(), commandList);

        b8 opaqueRecorded = false;
        if(this.prepared){
            Optional<in LightSpaceShadowSnapshot> lightSpaceOpt;
            if(this.lightSpace.valid())
                lightSpaceOpt = Optional<in LightSpaceShadowSnapshot>(this.lightSpace.deref().snapshot);
            Expected<u32> opaqueFrame = MakeUnexpected(Failure());
            if(this.hardwareShadowSupported)
                opaqueFrame = this.raytracingSystem.renderShadowVisibilityOpaque(commandList, this.targets, this.deferredLightingResources, this.graphOwnsOpaqueTemporalMergeEntryStates, lightSpaceOpt);
            else
                opaqueFrame = this.raytracingSystem.renderGpuBvhShadowVisibilityOpaque(commandList, this.targets, this.deferredLightingResources, this.graphOwnsOpaqueTemporalMergeEntryStates, lightSpaceOpt);
            opaqueRecorded = opaqueFrame.has_value();
            if(opaqueFrame.has_value())
                this.opaqueFrameIndex = opaqueFrame.value();
        }
        if(!opaqueRecorded){
            warning("RendererSystem: split opaque soft-shadow producer failed; retaining all-lit visibility");
            this.raytracingSystem.clearShadowVisibility(commandList, this.targets);
            commandList.setTextureState(this.targets.shadowVisibility.deref(), s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess);
            commandList.commitBarriers();
            this.shadowVisibilityTiming.value().discardTiming();
            this.shadowVisibilityTiming.reset();
            if(this.asyncTiming.has_value()){
                this.asyncTiming.value().discardTiming();
                this.asyncTiming.reset();
            }
            return true;
        }

        this.opaqueProduced = true;
        const b8 visibilityMarkerFinished = FinishSplitGpuTimingMarker(this.shadowVisibilityTiming);
        b8 asyncMarkerFinished = true;
        if(this.asyncTiming.has_value())
            asyncMarkerFinished = FinishSplitGpuTimingMarker(this.asyncTiming);
        if(!asyncMarkerFinished || !visibilityMarkerFinished){
            DiscardGpuTimingMeasure(this.asyncTiming);
            DiscardGpuTimingMeasure(this.shadowVisibilityTiming);
            return false;
        }
        return true;
    }

    public void discarded(){
        this.opaqueProduced = false;
        DiscardGpuTimingMeasure(this.shadowVisibilityTiming);
        DiscardGpuTimingMeasure(this.asyncTiming);
    }
}


class ShadowVisibilityOpaqueFirstWaveletGraphTask{
    private mut RendererRayTracingSystem raytracingSystem;
    private mut GraphicsRuntime graphics;
    private mut DeferredFrameTargets targets;
    private DeferredLightingGraphResources deferredLightingResources;
    private mut GpuTimingSubmissionTicket timingTicket;
    private mut Optional<GpuTimingMeasure> asyncTiming;
    private mut Optional<GpuTimingMeasure> shadowVisibilityTiming;
    private mut Optional<GpuTimingMeasure> opaqueResolveTiming;
    private mut b8 opaqueProduced;
    private in u32 opaqueFrameIndex;
    private b8 hardwareShadowSupported;
    private b8 graphOwnsOpaqueTemporalMergeEntryStates;
    private b8 deferUpsample;
    private b8 deferWavelet;

    public ShadowVisibilityOpaqueFirstWaveletGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        mut GraphicsRuntime graphics,
        mut DeferredFrameTargets targets,
        in DeferredLightingGraphResources deferredLightingResources,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> asyncTiming,
        mut Optional<GpuTimingMeasure> shadowVisibilityTiming,
        mut Optional<GpuTimingMeasure> opaqueResolveTiming,
        mut b8 opaqueProduced,
        in borrow u32 opaqueFrameIndex,
        in b8 hardwareShadowSupported,
        in b8 graphOwnsOpaqueTemporalMergeEntryStates,
        in b8 deferUpsample,
        in b8 deferWavelet
    ){
        this.raytracingSystem = raytracingSystem;
        this.graphics = graphics;
        this.targets = targets;
        this.deferredLightingResources = deferredLightingResources;
        this.timingTicket = timingTicket;
        this.asyncTiming = asyncTiming;
        this.shadowVisibilityTiming = shadowVisibilityTiming;
        this.opaqueResolveTiming = opaqueResolveTiming;
        this.opaqueProduced = opaqueProduced;
        this.opaqueFrameIndex = opaqueFrameIndex;
        this.hardwareShadowSupported = hardwareShadowSupported;
        this.graphOwnsOpaqueTemporalMergeEntryStates = graphOwnsOpaqueTemporalMergeEntryStates;
        this.deferUpsample = deferUpsample;
        this.deferWavelet = deferWavelet;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.deferredLightingResources.valid())
            return false;
        if(!this.opaqueProduced)
            return true;

        GpuTimingTicketRecordingScope timingRecording(this.timingTicket);
        if(this.opaqueResolveTiming.has_value()){
            this.opaqueResolveTiming.value().discardTiming();
            this.opaqueResolveTiming.reset();
        }
        this.opaqueResolveTiming.emplace(this.graphics.gpuTiming(), s_TimingScopeShadowOpaqueResolve, this.graphics.getDevice(), commandList);
        if(this.raytracingSystem.renderSoftOpaqueShadowResolvePhase(
            commandList,
            this.targets,
            this.deferredLightingResources,
            this.opaqueFrameIndex,
            this.hardwareShadowSupported,
            this.graphOwnsOpaqueTemporalMergeEntryStates,
            ResolveSoftShadowOpaqueFirstWaveletPhase(this.deferWavelet)
        )){
            if(this.deferUpsample){
                this.opaqueResolveTiming.value().finishTiming(commandList);
                this.opaqueResolveTiming.reset();
                return true;
            }
            return FinishSplitGpuTimingMarker(this.opaqueResolveTiming);
        }

        warning("RendererSystem: split opaque soft-shadow first wavelet failed; retaining all-lit visibility");
        RecoverOpaqueSoftShadowAllLit(this.raytracingSystem, this.targets, this.opaqueProduced, this.asyncTiming, this.shadowVisibilityTiming, this.opaqueResolveTiming, commandList);
        return true;
    }

    public void discarded(){
        this.opaqueProduced = false;
        DiscardGpuTimingMeasure(this.asyncTiming);
        DiscardGpuTimingMeasure(this.shadowVisibilityTiming);
        DiscardGpuTimingMeasure(this.opaqueResolveTiming);
    }
}


class ShadowVisibilityOpaqueResolveTailGraphTask{
    private mut RendererRayTracingSystem raytracingSystem;
    private mut DeferredFrameTargets targets;
    private DeferredLightingGraphResources deferredLightingResources;
    private mut GpuTimingSubmissionTicket timingTicket;
    private mut Optional<GpuTimingMeasure> asyncTiming;
    private mut Optional<GpuTimingMeasure> shadowVisibilityTiming;
    private mut Optional<GpuTimingMeasure> opaqueResolveTiming;
    private mut b8 opaqueProduced;
    private in u32 opaqueFrameIndex;
    private b8 hardwareShadowSupported;

    public ShadowVisibilityOpaqueResolveTailGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        mut DeferredFrameTargets targets,
        in DeferredLightingGraphResources deferredLightingResources,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> asyncTiming,
        mut Optional<GpuTimingMeasure> shadowVisibilityTiming,
        mut Optional<GpuTimingMeasure> opaqueResolveTiming,
        mut b8 opaqueProduced,
        in borrow u32 opaqueFrameIndex,
        in b8 hardwareShadowSupported
    ){
        this.raytracingSystem = raytracingSystem;
        this.targets = targets;
        this.deferredLightingResources = deferredLightingResources;
        this.timingTicket = timingTicket;
        this.asyncTiming = asyncTiming;
        this.shadowVisibilityTiming = shadowVisibilityTiming;
        this.opaqueResolveTiming = opaqueResolveTiming;
        this.opaqueProduced = opaqueProduced;
        this.opaqueFrameIndex = opaqueFrameIndex;
        this.hardwareShadowSupported = hardwareShadowSupported;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.deferredLightingResources.valid())
            return false;
        if(!this.opaqueProduced)
            return true;
        if(!this.opaqueResolveTiming.has_value())
            return false;

        GpuTimingTicketRecordingScope timingRecording(this.timingTicket);
        if(this.raytracingSystem.renderSoftOpaqueShadowResolveTail(commandList, this.targets, this.deferredLightingResources, this.opaqueFrameIndex, this.hardwareShadowSupported)){
            this.opaqueResolveTiming.value().finishTiming(commandList);
            this.opaqueResolveTiming.reset();
            return true;
        }

        warning("RendererSystem: split opaque soft-shadow resolve tail failed; retaining all-lit visibility");
        RecoverOpaqueSoftShadowAllLit(this.raytracingSystem, this.targets, this.opaqueProduced, this.asyncTiming, this.shadowVisibilityTiming, this.opaqueResolveTiming, commandList);
        return true;
    }

    public void discarded(){
        this.opaqueProduced = false;
        DiscardGpuTimingMeasure(this.asyncTiming);
        DiscardGpuTimingMeasure(this.shadowVisibilityTiming);
        DiscardGpuTimingMeasure(this.opaqueResolveTiming);
    }
}


class ShadowTransparentSoftTraceGraphTask{
    private mut RendererRayTracingSystem raytracingSystem;
    private mut DeferredFrameTargets targets;
    private DeferredLightingGraphResources deferredLightingResources;
    private FrozenLightSpaceShadowHandle lightSpace;
    private mut GpuTimingSubmissionTicket timingTicket;
    private in b8 opaqueProduced;
    private in u32 opaqueFrameIndex;
    private mut b8 transparentTraceProduced;

    public ShadowTransparentSoftTraceGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        mut DeferredFrameTargets targets,
        in DeferredLightingGraphResources deferredLightingResources,
        in FrozenLightSpaceShadowHandle lightSpace,
        mut GpuTimingSubmissionTicket timingTicket,
        in borrow b8 opaqueProduced,
        in borrow u32 opaqueFrameIndex,
        mut b8 transparentTraceProduced
    ){
        this.raytracingSystem = raytracingSystem;
        this.targets = targets;
        this.deferredLightingResources = deferredLightingResources;
        this.lightSpace = lightSpace;
        this.timingTicket = timingTicket;
        this.opaqueProduced = opaqueProduced;
        this.opaqueFrameIndex = opaqueFrameIndex;
        this.transparentTraceProduced = transparentTraceProduced;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute | GpuQueueCapability::Transfer); }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.deferredLightingResources.valid())
            return false;

        this.transparentTraceProduced = false;
        if(!this.opaqueProduced)
            return true;

        GpuTimingTicketRecordingScope timingRecording(this.timingTicket);
        Optional<in LightSpaceShadowSnapshot> lightSpaceOpt;
        if(this.lightSpace.valid())
            lightSpaceOpt = Optional<in LightSpaceShadowSnapshot>(this.lightSpace.deref().snapshot);
        if(!this.raytracingSystem.renderSoftTransparentShadowTrace(commandList, this.targets, this.deferredLightingResources, this.opaqueFrameIndex, true, lightSpaceOpt)){
            warning("RendererSystem: split transparent soft-shadow trace could not record; preserving opaque visibility");
            return true;
        }
        this.transparentTraceProduced = true;
        return true;
    }

    public void discarded(){
        this.transparentTraceProduced = false;

    }
}


class ShadowTransparentSoftTemporalMergeGraphTask{
    private mut RendererRayTracingSystem raytracingSystem;
    private mut GraphicsRuntime graphics;
    private mut DeferredFrameTargets targets;
    private DeferredLightingGraphResources deferredLightingResources;
    private mut GpuTimingSubmissionTicket timingTicket;
    private mut Optional<GpuTimingMeasure> transparentResolveTiming;
    private in b8 opaqueProduced;
    private mut b8 transparentTraceProduced;
    private in u32 opaqueFrameIndex;
    private b8 graphOwnsTransparentTemporalMergeEntryStates;
    private b8 combinedTemporal;
    private b8 hardwareShadowSupported;

    public ShadowTransparentSoftTemporalMergeGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        mut GraphicsRuntime graphics,
        mut DeferredFrameTargets targets,
        in DeferredLightingGraphResources deferredLightingResources,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> transparentResolveTiming,
        in borrow b8 opaqueProduced,
        mut b8 transparentTraceProduced,
        in borrow u32 opaqueFrameIndex,
        in b8 graphOwnsTransparentTemporalMergeEntryStates,
        in b8 combinedTemporal,
        in b8 hardwareShadowSupported
    ){
        this.raytracingSystem = raytracingSystem;
        this.graphics = graphics;
        this.targets = targets;
        this.deferredLightingResources = deferredLightingResources;
        this.timingTicket = timingTicket;
        this.transparentResolveTiming = transparentResolveTiming;
        this.opaqueProduced = opaqueProduced;
        this.transparentTraceProduced = transparentTraceProduced;
        this.opaqueFrameIndex = opaqueFrameIndex;
        this.graphOwnsTransparentTemporalMergeEntryStates = graphOwnsTransparentTemporalMergeEntryStates;
        this.combinedTemporal = combinedTemporal;
        this.hardwareShadowSupported = hardwareShadowSupported;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }

    private b8 recoverOpaqueTemporal(mut CommandList commandList)const{
        if(!this.combinedTemporal)
            return true;
        return this.raytracingSystem.renderSoftOpaqueShadowResolvePhase(commandList, this.targets, this.deferredLightingResources, this.opaqueFrameIndex, this.hardwareShadowSupported, true, SoftShadowOpaqueResolvePhase::TemporalOnly);
    }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.deferredLightingResources.valid())
            return false;
        if(!this.opaqueProduced)
            return true;

        GpuTimingTicketRecordingScope timingRecording(this.timingTicket);
        if(!this.transparentTraceProduced)
            return this.recoverOpaqueTemporal(commandList);
        if(this.transparentResolveTiming.has_value()){
            this.transparentResolveTiming.value().discardTiming();
            this.transparentResolveTiming.reset();
        }
        this.transparentResolveTiming.emplace(this.graphics.gpuTiming(), s_TimingScopeShadowTransparentResolve, this.graphics.getDevice(), commandList);
        b8 merged = false;
        if(this.combinedTemporal)
            merged = this.raytracingSystem.renderSoftShadowCombinedTemporalMerge(commandList, this.targets);
        else
            merged = this.raytracingSystem.renderSoftTransparentShadowTemporalMerge(commandList, this.targets, this.deferredLightingResources, this.opaqueFrameIndex, this.graphOwnsTransparentTemporalMergeEntryStates);
        if(merged)
            return FinishSplitGpuTimingMarker(this.transparentResolveTiming);

        warning("RendererSystem: split transparent soft-shadow temporal merge failed; preserving opaque visibility");
        this.transparentTraceProduced = false;
        this.transparentResolveTiming.value().discardTiming();
        this.transparentResolveTiming.reset();
        return this.recoverOpaqueTemporal(commandList);
    }

    public void discarded(){
        this.transparentTraceProduced = false;
        DiscardGpuTimingMeasure(this.transparentResolveTiming);
    }
}


class ShadowTransparentSoftFirstWaveletGraphTask{
    private mut RendererRayTracingSystem raytracingSystem;
    private mut GraphicsRuntime graphics;
    private mut DeferredFrameTargets targets;
    private DeferredLightingGraphResources deferredLightingResources;
    private mut GpuTimingSubmissionTicket timingTicket;
    private mut Optional<GpuTimingMeasure> transparentResolveTiming;
    private in b8 opaqueProduced;
    private mut b8 transparentTraceProduced;
    private in u32 opaqueFrameIndex;
    private b8 graphOwnsTransparentWaveletInputBoundary;
    private b8 startsTransparentResolveTiming;
    private b8 combinedWavelet;

    public ShadowTransparentSoftFirstWaveletGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        mut GraphicsRuntime graphics,
        mut DeferredFrameTargets targets,
        in DeferredLightingGraphResources deferredLightingResources,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> transparentResolveTiming,
        in borrow b8 opaqueProduced,
        mut b8 transparentTraceProduced,
        in borrow u32 opaqueFrameIndex,
        in b8 graphOwnsTransparentWaveletInputBoundary,
        in b8 startsTransparentResolveTiming,
        in b8 combinedWavelet
    ){
        this.raytracingSystem = raytracingSystem;
        this.graphics = graphics;
        this.targets = targets;
        this.deferredLightingResources = deferredLightingResources;
        this.timingTicket = timingTicket;
        this.transparentResolveTiming = transparentResolveTiming;
        this.opaqueProduced = opaqueProduced;
        this.transparentTraceProduced = transparentTraceProduced;
        this.opaqueFrameIndex = opaqueFrameIndex;
        this.graphOwnsTransparentWaveletInputBoundary = graphOwnsTransparentWaveletInputBoundary;
        this.startsTransparentResolveTiming = startsTransparentResolveTiming;
        this.combinedWavelet = combinedWavelet;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.deferredLightingResources.valid())
            return false;
        if(!this.opaqueProduced)
            return true;
        if(this.combinedWavelet){
            GpuTimingTicketRecordingScope timingRecording(this.timingTicket);
            if(this.transparentTraceProduced && this.transparentResolveTiming.has_value()){
                if(this.raytracingSystem.renderSoftShadowCombinedWavelet(commandList, this.targets))
                    return true;
            }
            this.transparentTraceProduced = false;
            DiscardGpuTimingMeasure(this.transparentResolveTiming);
            return this.raytracingSystem.renderSoftOpaqueShadowResolvePhase(commandList, this.targets, this.deferredLightingResources, this.opaqueFrameIndex, true, true, SoftShadowOpaqueResolvePhase::WaveletOnly);
        }
        if(!this.transparentTraceProduced)
            return true;

        GpuTimingTicketRecordingScope timingRecording(this.timingTicket);
        if(this.startsTransparentResolveTiming){
            if(this.transparentResolveTiming.has_value()){
                this.transparentResolveTiming.value().discardTiming();
                this.transparentResolveTiming.reset();
            }
            this.transparentResolveTiming.emplace(this.graphics.gpuTiming(), s_TimingScopeShadowTransparentResolve, this.graphics.getDevice(), commandList);
        }
        else if(!this.transparentResolveTiming.has_value()){
            warning("RendererSystem: split transparent soft-shadow wavelet lost its temporal timing envelope; preserving opaque visibility");
            this.transparentTraceProduced = false;
            return true;
        }

        if(this.raytracingSystem.renderSoftTransparentShadowFirstWavelet(commandList, this.targets, this.deferredLightingResources, this.opaqueFrameIndex, this.graphOwnsTransparentWaveletInputBoundary)){
            if(this.startsTransparentResolveTiming && !FinishSplitGpuTimingMarker(this.transparentResolveTiming))
                return false;
            return true;
        }

        warning("RendererSystem: split transparent soft-shadow first wavelet failed; preserving opaque visibility");
        this.transparentTraceProduced = false;
        if(this.transparentResolveTiming.has_value()){
            this.transparentResolveTiming.value().discardTiming();
            this.transparentResolveTiming.reset();
        }
        return true;
    }

    public void discarded(){
        this.transparentTraceProduced = false;
        DiscardGpuTimingMeasure(this.transparentResolveTiming);
    }
}


class ShadowTransparentSoftFoldGraphTask{
    private mut RendererRayTracingSystem raytracingSystem;
    private mut DeferredFrameTargets targets;
    private DeferredLightingGraphResources deferredLightingResources;
    private mut GpuTimingSubmissionTicket timingTicket;
    private mut Optional<GpuTimingMeasure> asyncTiming;
    private mut Optional<GpuTimingMeasure> shadowVisibilityTiming;
    private mut Optional<GpuTimingMeasure> transparentResolveTiming;
    private in b8 opaqueProduced;
    private mut b8 transparentTraceProduced;
    private in u32 opaqueFrameIndex;
    private b8 combinedUpsample;

    public ShadowTransparentSoftFoldGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        mut DeferredFrameTargets targets,
        in DeferredLightingGraphResources deferredLightingResources,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> asyncTiming,
        mut Optional<GpuTimingMeasure> shadowVisibilityTiming,
        mut Optional<GpuTimingMeasure> transparentResolveTiming,
        in borrow b8 opaqueProduced,
        mut b8 transparentTraceProduced,
        in borrow u32 opaqueFrameIndex,
        in b8 combinedUpsample
    ){
        this.raytracingSystem = raytracingSystem;
        this.targets = targets;
        this.deferredLightingResources = deferredLightingResources;
        this.timingTicket = timingTicket;
        this.asyncTiming = asyncTiming;
        this.shadowVisibilityTiming = shadowVisibilityTiming;
        this.transparentResolveTiming = transparentResolveTiming;
        this.opaqueProduced = opaqueProduced;
        this.transparentTraceProduced = transparentTraceProduced;
        this.opaqueFrameIndex = opaqueFrameIndex;
        this.combinedUpsample = combinedUpsample;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.deferredLightingResources.valid())
            return false;

        const Optional<GpuPhysicalQueueInfo> queue = context.compiledPlan.findQueueInfo(context.queue);
        if(!queue.has_value())
            return false;
        if(!this.opaqueProduced)
            return true;
        if(!this.shadowVisibilityTiming.has_value() || (queue.value().queueClass == CommandQueue::Compute && !this.asyncTiming.has_value()))
            return false;

        GpuTimingTicketRecordingScope timingRecording(this.timingTicket);
        if(this.transparentTraceProduced){
            if(!this.transparentResolveTiming.has_value())
                return false;
            b8 resolved = false;
            if(this.combinedUpsample)
                resolved = this.raytracingSystem.renderSoftShadowTerminalUpsample(commandList, this.targets, this.deferredLightingResources, true);
            else
                resolved = this.raytracingSystem.renderSoftTransparentShadowFold(commandList, this.targets, this.deferredLightingResources, this.opaqueFrameIndex);
            if(resolved){
                this.transparentResolveTiming.value().finishTiming(commandList);
                this.transparentResolveTiming.reset();
            }
            else{
                warning("RendererSystem: split transparent soft-shadow resolve failed; preserving opaque visibility");
                this.transparentTraceProduced = false;
                this.transparentResolveTiming.value().discardTiming();
                this.transparentResolveTiming.reset();
            }
        }else{
            if(this.transparentResolveTiming.has_value()){
                this.transparentResolveTiming.value().discardTiming();
                this.transparentResolveTiming.reset();
            }
            warning("RendererSystem: split transparent soft-shadow trace or first wavelet failed; preserving opaque visibility");
        }

        if(ShouldPublishDeferredOpaqueFallbackUpsample(this.combinedUpsample, this.transparentTraceProduced)){
            if(!this.raytracingSystem.renderSoftShadowTerminalUpsample(commandList, this.targets, this.deferredLightingResources, false))
                return false;
        }

        this.shadowVisibilityTiming.value().finishTiming(commandList);
        this.shadowVisibilityTiming.reset();
        if(this.asyncTiming.has_value()){
            this.asyncTiming.value().finishTiming(commandList);
            this.asyncTiming.reset();
        }
        return true;
    }

    public void discarded(){
        this.transparentTraceProduced = false;
        DiscardGpuTimingMeasure(this.asyncTiming);
        DiscardGpuTimingMeasure(this.shadowVisibilityTiming);
        DiscardGpuTimingMeasure(this.transparentResolveTiming);
        this.raytracingSystem.discardSoftShadowTemporalHistory();
    }
}


class ShadowVisibilityGraphTask{
    private mut RendererRayTracingSystem raytracingSystem;
    private mut GraphicsRuntime graphics;
    private mut DeferredFrameTargets targets;
    private DeferredLightingGraphResources deferredLightingResources;
    private mut GpuTimingSubmissionTicket timingTicket;
    private in b8 prepared;
    private GraphOwnedAdaptiveShadowPlan graphOwnedAdaptivePlan;
    private b8 hardwareShadowSupported;

    public ShadowVisibilityGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        mut GraphicsRuntime graphics,
        mut DeferredFrameTargets targets,
        in DeferredLightingGraphResources deferredLightingResources,
        mut GpuTimingSubmissionTicket timingTicket,
        in borrow b8 prepared,
        in GraphOwnedAdaptiveShadowPlan graphOwnedAdaptivePlan,
        in b8 hardwareShadowSupported
    ){
        this.raytracingSystem = raytracingSystem;
        this.graphics = graphics;
        this.targets = targets;
        this.deferredLightingResources = deferredLightingResources;
        this.timingTicket = timingTicket;
        this.prepared = prepared;
        this.graphOwnedAdaptivePlan = graphOwnedAdaptivePlan;
        this.hardwareShadowSupported = hardwareShadowSupported;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute | GpuQueueCapability::Transfer); }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.deferredLightingResources.valid())
            return false;

        Optional<in GraphOwnedAdaptiveShadowPlan> graphOwnedAdaptivePlan;
        if(this.graphOwnedAdaptivePlan.enabled)
            graphOwnedAdaptivePlan = Optional<in GraphOwnedAdaptiveShadowPlan>(this.graphOwnedAdaptivePlan);

        const Optional<GpuPhysicalQueueInfo> queue = context.compiledPlan.findQueueInfo(context.queue);
        if(!queue.has_value())
            return false;

        GpuTimingTicketRecordingScope timingRecording(this.timingTicket);
        Optional<GpuTimingMeasure> asyncTiming;
        if(queue.value().queueClass == CommandQueue::Compute)
            asyncTiming.emplace(this.graphics.gpuTiming(), s_TimingScopeAsyncShadow, this.graphics.getDevice(), commandList);

        b8 shadowVisibilityWritten = false;
        if(this.prepared && this.hardwareShadowSupported){
            shadowVisibilityWritten = this.raytracingSystem.renderShadowVisibility(commandList, this.targets, this.deferredLightingResources).has_value();
            if(!shadowVisibilityWritten)
                warning("RendererSystem: ray-traced shadow visibility pass failed");
        }
        else if(this.prepared)
            shadowVisibilityWritten = this.raytracingSystem.renderGpuBvhShadowVisibility(commandList, this.targets, this.deferredLightingResources, false, false, false, graphOwnedAdaptivePlan).has_value();

        if(asyncTiming.has_value()){
            asyncTiming.value().finishTiming(commandList);
            asyncTiming.reset();
        }
        return true;
    }

    public void discarded(){
        this.raytracingSystem.discardSoftShadowTemporalHistory();

    }
}


Expected<GpuTaskId> RendererRayTracingSystem::declareShadowVisibilityTask(
    mut GpuTaskGraph graph,
    in GpuTaskDesc desc,
    in DeferredLightingGraphResources deferredLightingResources,
    in borrow b8 prepared,
    in b8 hardwareShadowSupported,
    in GraphOwnedAdaptiveShadowPlan graphOwnedAdaptivePlan,
    mut DeferredFrameTargets targets,
    mut GpuTimingSubmissionTicket timingTicket
){
    return graph.addPayloadTask(desc, ShadowVisibilityGraphTask(
        this,
        this.m_graphics,
        targets,
        deferredLightingResources,
        timingTicket,
        prepared,
        graphOwnedAdaptivePlan,
        hardwareShadowSupported
    ));
}


