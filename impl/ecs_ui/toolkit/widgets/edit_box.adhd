#include <impl/ecs_ui/toolkit/edit/model.adhd>
#include <impl/ecs_ui/toolkit/widgets/edit_box_snapshot_builder.adhd>
#include <impl/ecs_ui/toolkit/widgets/edit_box_visual_paint.adhd>
#include <impl/ecs_ui/toolkit/widgets/edit_caret_geometry.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
TextLayoutStatus AdoptEditBoxShapingResult<T>(mut EditBoxView view, mut forward T shaped){
    mut Expected<TextLayout, TextLayoutStatus> result = shaped;
    if(!result.has_value())
        return result.error();
    if(!view.adoptLayout(result.value()))
        return TextLayoutStatus::FontFailure;
    return TextLayoutStatus::Success;
}

[move_only]
class EditBoxView{
    private String m_display;
    private Vector<EditCaretMapping> m_mapping;
    private EditCaretGeometry m_geometry;
    private Rect m_visualBounds;
    private EditBoxRange m_selection;
    private EditBoxRange m_preedit;
    private EditBoxRange m_replacement;
    private usize m_caret = 0u;
    private usize m_committedBytes = 0u;
    private u64 m_revision = 0u;
    private EditTextMode m_textMode = EditTextMode::SingleLine;
    private b8 m_composing = false;
    private b8 m_ready = false;

    [cpp_unwind]
    public b8 snapshot(in EditModel model){
        return EditBoxSnapshotBuilder().commit(
            model.text(), model.graphemeBoundaries(), model.composition(), model.textMode(),
            model.selectionStart(), model.selectionEnd(), model.caret(), model.revision(),
            this.m_display, this.m_mapping, this.m_selection, this.m_preedit, this.m_replacement, this.m_caret,
            this.m_committedBytes, this.m_revision, this.m_textMode, this.m_composing, this.m_ready
        );
    }

    [cpp_unwind]
    public TextLayoutStatus shape(mut TextService text){ return this.shape(text, ShapeRequest()); }
    [cpp_unwind]
    public TextLayoutStatus shape(mut TextService text, in ShapeRequest options){
        ShapeRequest request = options;
        const TextLayoutStatus validation = PrepareEditBoxShapeRequest(this.m_revision, this.displayText(), this.m_textMode, request);
        if(validation != TextLayoutStatus::Success)
            return validation;
        return AdoptEditBoxShapingResult(this, text.layout(request));
    }

    [cpp_unwind]
    public b8 adoptLayout(mut TextLayout layout){
        if(this.m_revision == 0u)
            return false;
        Array<usize, 3u> carets;
        carets[0u] = this.m_caret;
        carets[1u] = this.m_selection.begin;
        carets[2u] = this.m_selection.end;
        if(!this.m_geometry.adoptLayout(layout, this.displayText(), this.m_mapping, this.m_committedBytes, this.m_textMode, carets))
            return false;
        const Point logicalSize = this.m_geometry.layout().measure();
        this.m_visualBounds = Rect(0.0f, 0.0f, logicalSize.x, logicalSize.y);
        this.m_ready = true;
        return true;
    }
    [cpp_unwind]
    public b8 measure(mut TextService text, in DisplayMetrics display){
        return MeasureEditBoxViewVisual(this.m_ready, this.layout(), display, text, this.m_visualBounds);
    }

    public Expected<EditBoxPlacement> arrange(in Rect bounds, in Insets padding, in Rect clip, in Point previousScroll)const{
        return this.arrange(bounds, padding, clip, previousScroll, 1.0f, true);
    }
    public Expected<EditBoxPlacement> arrange(in Rect bounds, in Insets padding, in Rect clip, in Point previousScroll, in f32 caretWidth)const{
        return this.arrange(bounds, padding, clip, previousScroll, caretWidth, true);
    }
    public Expected<EditBoxPlacement> arrange(in Rect bounds, in Insets padding, in Rect clip, in Point previousScroll, in f32 caretWidth, in b8 revealCaret)const{
        return TryArrangeEditBox(
            this.m_ready, bounds, padding, clip, previousScroll, caretWidth, revealCaret, this.m_textMode,
            this.m_visualBounds, this.layout().measure(), this.layout().utf8(), this.layout().lines(), this.layout().clusters(),
            this.m_geometry.boundaries(), this.m_geometry.lines(), this.m_caret, this.m_selection, this.m_preedit, this.m_composing
        );
    }

    public Expected<EditBoxPlacement> arrangeViewport(in Rect bounds, in Rect viewport, in Rect clip, in Point previousScroll)const{
        return this.arrangeViewport(bounds, viewport, clip, previousScroll, 1.0f, true);
    }
    public Expected<EditBoxPlacement> arrangeViewport(in Rect bounds, in Rect viewport, in Rect clip, in Point previousScroll, in f32 caretWidth)const{
        return this.arrangeViewport(bounds, viewport, clip, previousScroll, caretWidth, true);
    }
    public Expected<EditBoxPlacement> arrangeViewport(in Rect bounds, in Rect viewport, in Rect clip, in Point previousScroll, in f32 caretWidth, in b8 revealCaret)const{
        return TryArrangeEditBoxViewport(
            this.m_ready, bounds, viewport, clip, previousScroll, caretWidth, revealCaret, this.m_textMode,
            this.m_visualBounds, this.layout().measure(), this.layout().utf8(), this.layout().lines(), this.layout().clusters(),
            this.m_geometry.boundaries(), this.m_geometry.lines(), this.m_caret, this.m_selection, this.m_preedit, this.m_composing
        );
    }

    public Expected<usize> hitTest(in Point point, in EditBoxPlacement placement)const{
        return TryHitTestEditBoxView(this.m_ready, this.m_geometry.ready(), point, placement, this.m_geometry.lines(), this.m_geometry.caretStops());
    }

    [cpp_unwind]
    public b8 paint(mut TextService text, mut PaintBuilder paint, in UiSkin skin, in EditBoxPlacement placement)const{
        return this.paint(text, paint, skin, placement, EditBoxStyle(), EditBoxPaintFlags());
    }
    [cpp_unwind]
    public b8 paint(mut TextService text, mut PaintBuilder paint, in UiSkin skin, in EditBoxPlacement placement, in EditBoxStyle style)const{
        return this.paint(text, paint, skin, placement, style, EditBoxPaintFlags());
    }
    [cpp_unwind]
    public b8 paint(mut TextService text, mut PaintBuilder paint, in UiSkin skin, in EditBoxPlacement placement, in EditBoxStyle style, in EditBoxPaintFlags flags)const{
        if(!this.m_ready)
            return false;
        return PaintEditBoxViewVisual(
            text, paint, skin, this.layout(), this.layout().utf8(), this.layout().lines(), this.layout().clusters(),
            this.m_geometry.boundaries(), this.m_geometry.lines(), this.m_selection, this.m_preedit, this.m_composing,
            placement, style, flags
        );
    }

    public StringView displayText()const{ return StringView(this.m_display); }
    public in TextLayout layout()const{ return this.m_geometry.layout(); }
    public in Rect visualBounds()const{ return this.m_visualBounds; }
    public in Vector<EditBoxCaretStop> caretStops()const{ return this.m_geometry.caretStops(); }
    public in EditCaretGeometry caretGeometry()const{ return this.m_geometry; }
    public SharedEditCaretStopTable sharedCaretStopTable()const{ return this.m_geometry.sharedStopTable(); }
    public EditTextMode textMode()const{ return this.m_textMode; }
    public u64 revision()const{ return this.m_revision; }
    public usize committedBytes()const{ return this.m_committedBytes; }
    public usize displayCaret()const{ return this.m_caret; }
    public EditBoxRange selectionRange()const{ return this.m_selection; }
    public EditBoxRange preeditRange()const{ return this.m_preedit; }
    public EditBoxRange replacementRange()const{ return this.m_replacement; }
    public b8 composing()const{ return this.m_composing; }
    public b8 ready()const{ return this.m_ready; }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

