////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ReflectionCpuTimingProbe final{
private:
    static constexpr u64 s_PreparationPresentations = 64u;
    static constexpr u64 s_MinimumPresentations = NWB::Tests::Smoke::s_SmokeProbeMinimumPresentations;
    static constexpr u32 s_MinimumPositiveIntervals = 11u;
    static constexpr f64 s_MinimumMeasurementSeconds = NWB::Tests::Smoke::s_SmokeProbeMinimumMeasurementSeconds;


public:
    explicit ReflectionCpuTimingProbe(ProjectRuntimeContext& context)noexcept;


public:
    [[nodiscard]] b8 initialize(AStringView caseName, Core::Alloc::ScratchArena& scratchArena);
    [[nodiscard]] b8 update();
    void finish();


private:
    ProjectRuntimeContext& m_context;
    SmokeCpuGpuTimingProbe m_publications;
    PresentationFpsProbe m_presentation{ 5.0 };
    Timer m_preparationBegin = {};
    u64 m_intervalSourceFrame = 0u;
    u32 m_positiveIntervals = 0u;
    b8 m_prepared = false;
    b8 m_measuring = false;
    b8 m_complete = false;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


ReflectionCpuTimingProbe::ReflectionCpuTimingProbe(ProjectRuntimeContext& context)noexcept
    : m_context(context)
    , m_publications(FOUNDATION_TEXT("reflection"), context.objectArena)
{}

b8 ReflectionCpuTimingProbe::initialize(const AStringView caseName, Core::Alloc::ScratchArena& scratchArena){
    if((caseName != "optical_csg_cap" && caseName != "optical_csg_reference") || !m_context.requestQuit){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("ReflectionCpuTiming: requires the cap or matched slab fixture and a quit callback"));
        return false;
    }
    const auto outputPath = ReadSmokeEnvironmentText(scratchArena, "NWB_REFLECTION_CPU_GPU_TIMING_FILE");
    if(!m_publications.initialize(true, true, outputPath ? AStringView(outputPath->data(), outputPath->size()) : AStringView{}))
        return false;
    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("ReflectionCpuTiming: configured case={} preparation_presentations=64 warmup_seconds=5") FOUNDATION_TEXT(" minimum_seconds=30 minimum_presentations=100 minimum_positive_intervals=11 diagnostic_only=1"), ConvertString(caseName));
    return true;
}

b8 ReflectionCpuTimingProbe::update(){
    if(m_complete)
        return true;
    const u64 presentations = m_context.graphics.getSuccessfulPresentationCount();
    const u64 sourceFrame = m_context.perfSession.frameIndex();
    const Timer now = TimerNow();
    if(!m_prepared){
        if(presentations < s_PreparationPresentations)
            return true;
        m_prepared = true;
        m_preparationBegin = now;
        NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("ReflectionCpuTiming: preparation complete presentations={} source_frame={}"), presentations, sourceFrame);
    }
    const auto status = m_presentation.observe(presentations, now);
    if(status == PresentationFpsStatus::Invalid){
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("ReflectionCpuTiming: presentation counter or steady clock regressed"));
        return false;
    }
    if(m_presentation.measurementStarted() && !m_measuring){
        m_measuring = true;
        m_intervalSourceFrame = sourceFrame;
        NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("ReflectionCpuTiming: measurement begin presentations={} source_frame={} warmup_seconds={}"), presentations, sourceFrame, DurationInSeconds<f64>(now, m_preparationBegin));
    }
    if(!m_publications.observe(m_context.perfSession, m_presentation, presentations, false))
        return false;
    if(status != PresentationFpsStatus::Interval)
        return true;
    const auto& interval = m_presentation.interval();
    if(interval.presentations() > 0u)
        ++m_positiveIntervals;
    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("ReflectionCpuTiming: interval presentations={} seconds={} first={} last={}") FOUNDATION_TEXT(" first_source={} end_source={}")
        , interval.presentations()
        , interval.wallSeconds
        , interval.firstPresentationCount
        , interval.lastPresentationCount
        , m_intervalSourceFrame
        , sourceFrame
    );
    m_intervalSourceFrame = sourceFrame;
    const auto& total = m_presentation.total();
    if(
        total.wallSeconds < s_MinimumMeasurementSeconds || total.presentations() < s_MinimumPresentations
        || m_positiveIntervals < s_MinimumPositiveIntervals
        || !m_publications.hasCompletedGpuSamples(Impl::RendererGpuTimingScope::s_Frame.identity, s_MinimumPresentations)
        || !m_publications.hasCompletedGpuSamples(Impl::ReflectionGpuTimingScope::s_Hardware.identity, s_MinimumPresentations)
    )
        return true;
    if(!m_publications.observe(m_context.perfSession, m_presentation, presentations, true))
        return false;
    m_complete = true;
    NWB_LOGGER_ESSENTIAL_INFO(FOUNDATION_TEXT("ReflectionCpuTiming: measurement complete presentations={} seconds={} first={} last={}") FOUNDATION_TEXT(" positive_intervals={} end_source={} diagnostic_only=1")
        , total.presentations()
        , total.wallSeconds
        , total.firstPresentationCount
        , total.lastPresentationCount
        , m_positiveIntervals
        , sourceFrame
    );
    m_context.requestQuit();
    return true;
}

void ReflectionCpuTimingProbe::finish(){
    if(!m_complete)
        NWB_LOGGER_ERROR(FOUNDATION_TEXT("ReflectionCpuTiming: shutdown before the diagnostic measurement completed"));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


