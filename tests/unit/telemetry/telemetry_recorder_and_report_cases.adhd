void VerifyTelemetry_TelemetryReportKeepsCaptureOrderAndCorrelatesTimingByFrame(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureAll());

    const Name gbufferScopeName = Name(s_GBuffer);
    TimingStats firstTiming = MakeTestTimingStats();
    firstTiming.seconds = 0.041;
    firstTiming.sampleCount = 1u;
    firstTiming.publishFrameIndex = 41u;
    firstTiming.firstSampleFrameIndex = 40u;
    firstTiming.lastSampleFrameIndex = 40u;
    ASSERT_TRUE(RecordPerfTiming(recorder, PerfTimingSource::Gpu, gbufferScopeName, "gbuffer", firstTiming, 70u));

    FrameGraphNodeDescs nodes = FrameGraphNodeDescs(testArena.arena);
    FrameGraphEdgeDescs edges = FrameGraphEdgeDescs(testArena.arena);
    BuildTestFrameGraph(testArena.arena, nodes, edges);
    ASSERT_TRUE(RecordFrameGraph(recorder, testArena.scratchArena, 40u, nodes, edges, 7u));

    TimingStats secondTiming = MakeTestTimingStats();
    secondTiming.seconds = 0.042;
    secondTiming.sampleCount = 1u;
    secondTiming.publishFrameIndex = 42u;
    secondTiming.firstSampleFrameIndex = 41u;
    secondTiming.lastSampleFrameIndex = 41u;
    ASSERT_TRUE(RecordPerfTiming(recorder, PerfTimingSource::Gpu, gbufferScopeName, "gbuffer", secondTiming, 80u));

    nodes[0u].label = "Second GBuffer Pass";
    ASSERT_TRUE(RecordFrameGraph(recorder, testArena.scratchArena, 41u, nodes, edges, 8u));

    nodes[0u].label = "Unmatched GBuffer Pass";
    native(mut recorder, mut testArena, in nodes, in edges){
        ASSERT_TRUE(RecordFrameGraph(recorder, testArena.scratchArena, 42u, nodes, edges, 9u));
    }

    ScratchArena scratchArena = ScratchArena(s_TelemetryCaseTestsTelemetryReportWork);
    TelemetryReport report = TelemetryReport(testArena.arena);
    native(in recorder, mut testArena, mut scratchArena, mut report){
        auto reportResult1 = BuildTelemetryReport(recorder.view(), testArena.arena, scratchArena);
        ASSERT_TRUE(reportResult1.has_value());
        report = Move(reportResult1.value());
    }
    EXPECT_EQ(report.summary.frameGraphFrameCount, 3u);

    const StringView json = ReportJsonView(report);
    const usize firstJsonGraph = json.find("\"frameIndex\": 40");
    const usize secondJsonGraph = json.find("\"frameIndex\": 41");
    const usize thirdJsonGraph = json.find("\"frameIndex\": 42");
    ASSERT_NE(firstJsonGraph, usize.max);
    ASSERT_NE(secondJsonGraph, usize.max);
    ASSERT_NE(thirdJsonGraph, usize.max);
    EXPECT_LT(firstJsonGraph, secondJsonGraph);
    EXPECT_LT(secondJsonGraph, thirdJsonGraph);

    const StringView dot = ReportGraphView(report);
    const usize firstDotGraph = dot.find("digraph frame_graph_40_7_0");
    const usize secondDotGraph = dot.find("digraph frame_graph_41_8_1");
    const usize thirdDotGraph = dot.find("digraph frame_graph_42_9_2");
    ASSERT_NE(firstDotGraph, usize.max);
    ASSERT_NE(secondDotGraph, usize.max);
    ASSERT_NE(thirdDotGraph, usize.max);
    EXPECT_LT(firstDotGraph, secondDotGraph);
    EXPECT_LT(secondDotGraph, thirdDotGraph);
    EXPECT_EQ(dot.find("digraph frame_graph_", thirdDotGraph + 1u), usize.max);
    const StringView firstDotRecord = dot.substr(firstDotGraph, secondDotGraph - firstDotGraph);
    const StringView secondDotRecord = dot.substr(secondDotGraph, thirdDotGraph - secondDotGraph);
    const StringView thirdDotRecord = dot.substr(thirdDotGraph);
    EXPECT_TRUE(firstDotRecord.contains("GBuffer Pass\\n41.000 ms"));
    EXPECT_TRUE(secondDotRecord.contains("Second GBuffer Pass\\n42.000 ms"));
    EXPECT_TRUE(thirdDotRecord.contains("Unmatched GBuffer Pass"));
    EXPECT_FALSE(thirdDotRecord.contains(" ms"));
}

