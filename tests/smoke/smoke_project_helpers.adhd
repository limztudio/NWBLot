////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const f32 s_DegreesPerTurn = 360.0f;
const f32 s_MaxBaselineFreezeFrame = 1000000.0f;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ArrowYawInputHandler : IInputEventHandler{
    public KeyboardInputResult keyboardUpdate(in i32 key, in i32 scancode, in i32 action, in i32 mods)override{
        const b8 pressed = action == InputAction::Press || action == InputAction::Repeat;
        if(key == Key::Left){
            this.m_leftHeld = pressed;
            return true;
        }
        if(key == Key::Right){
            this.m_rightHeld = pressed;
            return true;
        }
        return false;
    }

    public void clear(){
        this.m_leftHeld = false;
        this.m_rightHeld = false;
    }

    public f32 axis()const{
        f32 right = 0.0f;
        if(this.m_rightHeld)
            right = 1.0f;
        f32 left = 0.0f;
        if(this.m_leftHeld)
            left = 1.0f;
        return right - left;
    }

    private b8 m_leftHeld = false;
    private b8 m_rightHeld = false;
}

class YawSpinController{
    public void update(in f32 safeDelta, in f32 frozenYaw, in b8 frozenYawValid, in ArrowYawInputHandler arrowYawInput, in f32 manualYawSpeed, in f32 spinSpeed, in f32 maxSpinDelta){
        if(frozenYawValid){
            this.m_yaw = frozenYaw;
            return;
        }

        const f32 manualAxis = arrowYawInput.axis();
        if(manualAxis != 0.0f)
            this.m_manualControl = true;

        if(this.m_manualControl)
            this.m_yaw += manualAxis * manualYawSpeed * safeDelta;
        else
            this.m_yaw += Min(safeDelta, maxSpinDelta) * spinSpeed;
    }

    public f32 yaw()const{ return this.m_yaw; }

    public b8 manualControl()const{ return this.m_manualControl; }

    private f32 m_yaw = 0.0f;
    private b8 m_manualControl = false;
}

f32 ReadSmokeFrozenYawFromEnvironment(in StringView variableName){
    const Expected<f32> parsed = ReadSmokeEnvironmentF32(variableName);
    if(parsed.has_value())
        return parsed.value();
    return -1.0f;
}

f32 ReadSmokeFrozenYawCached(in StringView variableName){
    f32 cachedYaw = -1.0f;
    native(in variableName, mut cachedYaw){
        static const f32 s_Yaw = ReadSmokeFrozenYawFromEnvironment(variableName);
        cachedYaw = s_Yaw;
    }
    return cachedYaw;
}

u32 ParseRendererBaselineCaptureFreezeFrame(){
    const Expected<f32> configuredFrame = ReadSmokeEnvironmentF32("NWB_RENDERER_BASELINE_CAPTURE_FREEZE_FRAME");
    if(!configuredFrame.has_value() || !IsFinite(configuredFrame.value()) || configuredFrame.value() < 1.0f)
        return 0u;
    return cast<u32>(Min(configuredFrame.value(), s_MaxBaselineFreezeFrame));
}

u32 RendererBaselineCaptureFreezeFrame(){
    u32 captureFrame = 0u;
    native(mut captureFrame){
        static const u32 s_CaptureFrame = ParseRendererBaselineCaptureFreezeFrame();
        captureFrame = s_CaptureFrame;
    }
    return captureFrame;
}

f32 ParseRendererBaselineFixedDelta(){
    const Expected<f32> configuredDelta = ReadSmokeEnvironmentF32("NWB_RENDERER_BASELINE_FIXED_DELTA_SECONDS");
    if(!configuredDelta.has_value() || !IsFinite(configuredDelta.value()) || configuredDelta.value() <= 0.0f || configuredDelta.value() > 1.0f)
        return 0.0f;
    return configuredDelta.value();
}

f32 RendererBaselineFixedDelta(){
    f32 fixedDelta = 0.0f;
    native(mut fixedDelta){
        static const f32 s_FixedDelta = ParseRendererBaselineFixedDelta();
        fixedDelta = s_FixedDelta;
    }
    return fixedDelta;
}

VectorSingle CalculateSmokeYawDisplay(in VectorSingle yaw, in VectorSingle turn){
    const f32 turnScalar = turn.x;
    f32 wrapped = yaw.x;
    native(in yawX = yaw.x, in turnScalar, mut wrapped){
        wrapped = VectorGetX(VectorMod(VectorReplicate(yawX), VectorReplicate(turnScalar)));
    }
    if(wrapped < 0.0f)
        wrapped += turnScalar;
    const f32 degrees = wrapped * (s_DegreesPerTurn / turnScalar);
    return VectorSingle(wrapped, degrees, wrapped, wrapped);
}

void SetSmokeYawWindowTitle(in f32 yaw, in b8 manualControl, in f32 twoPi, mut ProjectRuntimeContext context){
    const VectorSingle display = CalculateSmokeYawDisplay(VectorSingle(yaw), VectorSingle(twoPi));
    const f32 radians = display.x;
    const f32 degrees = display.y;
    native(in radians, in degrees, in manualControl, mut context){
        constexpr usize s_TitleCapacity = 192u;
        Array<tchar, s_TitleCapacity> title{};
        NWB_TSPRINTF(
            title.data(),
            s_TitleCapacity,
            NWB_TEXT("%.*s  |  yaw %.4f rad (%.2f deg)%s"),
            static_cast<i32>(QueryProjectWindowTitle().size()),
            QueryProjectWindowTitle().data(),
            radians,
            degrees,
            manualControl ? NWB_TEXT("  [manual: <- ->]") : NWB_TEXT("")
        );
        context.graphics.setWindowTitle(TStringView(title.data()));
    }
}

EntityID CreateSmokeCamera(in f32 cameraHeight, in f32 cameraDistance, in f32 cameraPitch, mut World world){
    const VectorSingle pitchRotation = QuaternionRotationRollPitchYawFromVector(VectorSingle(cameraPitch, 0.0f, 0.0f, 0.0f));
    const f32x4 cameraRotation = f32x4(pitchRotation);
    EntityID cameraEntity = EntityID();
    native(in cameraHeight, in cameraDistance, in cameraRotation, mut world, mut cameraEntity){
        auto activeCameraEntity = world.createEntity();
        auto& activeCamera = activeCameraEntity.addComponent<Impl::Scene::ActiveCameraComponent>();
        activeCamera.camera = Impl::Scene::CreateSceneCameraEntity(world, Float4(0.0f, cameraHeight, -cameraDistance, 0.0f));
        auto& cameraTransform = *MakeNotNull(world.tryGetComponent<Impl::Scene::TransformComponent>(activeCamera.camera));
        cameraTransform.rotation = cameraRotation;
        cameraEntity = activeCamera.camera;
    }
    return cameraEntity;
}


