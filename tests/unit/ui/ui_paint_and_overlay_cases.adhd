void VerifyUiPaintTests_CurrentClipCopiesTheActiveIntersectionAndRestoresAfterOverlay(mut UiPaintTests self){
    self.m_builder.pushClip(MakeUiPaintOverlayRect(10.0f, 10.0f, 30.0f, 30.0f));
    self.m_builder.pushClip(MakeUiPaintOverlayRect(20.0f, 5.0f, 40.0f, 20.0f));
    const Rect nested = self.m_builder.currentClip();
    EXPECT_FLOAT_EQ(nested.x, 20.0f);
    EXPECT_FLOAT_EQ(nested.y, 10.0f);
    EXPECT_FLOAT_EQ(nested.width, 20.0f);
    EXPECT_FLOAT_EQ(nested.height, 15.0f);
    ASSERT_TRUE(self.m_builder.beginOverlay(1u));
    EXPECT_FLOAT_EQ(self.m_builder.currentClip().width, 200.0f);
    self.m_builder.pushClip(MakeUiPaintOverlayRect(250.0f, 0.0f, 1.0f, 1.0f));
    EXPECT_FLOAT_EQ(self.m_builder.currentClip().width, 0.0f);
    ASSERT_TRUE(self.m_builder.popClip());
    ASSERT_TRUE(self.m_builder.endOverlay());
    EXPECT_FLOAT_EQ(self.m_builder.currentClip().x, nested.x);
    EXPECT_FLOAT_EQ(self.m_builder.currentClip().height, nested.height);
    ASSERT_TRUE(self.m_builder.popClip());
    ASSERT_TRUE(self.m_builder.popClip());
}

void VerifyUiPaintTests_BoundaryClipsKeepEmptyExtentsAndSecondOperandSignedZeroOrigins(mut UiPaintTests self){
    self.m_builder.pushClip(MakeUiPaintOverlayRect(2.0f, 3.0f, 5.0f, 7.0f));
    Array<Rect, 2u> boundaries = Array<Rect, 2u>();
    boundaries[0u] = MakeUiPaintOverlayRect(8.0f, 11.0f, 2.0f, 2.0f);
    boundaries[1u] = MakeUiPaintOverlayRect(7.0f, 10.0f, 2.0f, 2.0f);
    for(in Rect boundary : boundaries){
        self.m_builder.pushClip(boundary);
        const Rect clipped = self.m_builder.currentClip();
        EXPECT_FLOAT_EQ(clipped.x, boundary.x);
        EXPECT_FLOAT_EQ(clipped.y, boundary.y);
        EXPECT_FLOAT_EQ(clipped.width, 0.0f);
        EXPECT_FLOAT_EQ(clipped.height, 0.0f);
        ASSERT_TRUE(self.m_builder.popClip());
    }
    ASSERT_TRUE(self.m_builder.popClip());

    self.m_builder.pushClip(MakeUiPaintOverlayRect(-0.0f, -0.0f, 1.0f, 1.0f));
    self.m_builder.pushClip(MakeUiPaintOverlayRect(0.0f, 0.0f, 1.0f, 1.0f));
    EXPECT_FALSE(UiPaintOverlaySignBit(self.m_builder.currentClip().x));
    EXPECT_FALSE(UiPaintOverlaySignBit(self.m_builder.currentClip().y));
    ASSERT_TRUE(self.m_builder.popClip());
    EXPECT_TRUE(UiPaintOverlaySignBit(self.m_builder.currentClip().x));
    EXPECT_TRUE(UiPaintOverlaySignBit(self.m_builder.currentClip().y));
    ASSERT_TRUE(self.m_builder.popClip());

    self.m_builder.pushClip(MakeUiPaintOverlayRect(0.0f, 0.0f, 1.0f, 1.0f));
    self.m_builder.pushClip(MakeUiPaintOverlayRect(-0.0f, -0.0f, 1.0f, 1.0f));
    EXPECT_TRUE(UiPaintOverlaySignBit(self.m_builder.currentClip().x));
    EXPECT_TRUE(UiPaintOverlaySignBit(self.m_builder.currentClip().y));
    EXPECT_FLOAT_EQ(self.m_builder.currentClip().width, 1.0f);
    EXPECT_FLOAT_EQ(self.m_builder.currentClip().height, 1.0f);
}

void VerifyUiPaintTests_NestedClipsTrimGeometryAndUvAndRestoreTheirParent(mut UiPaintTests self){
    EXPECT_FALSE(self.m_builder.popClip());
    self.m_builder.pushClip(MakeUiPaintOverlayRect(10.0f, 10.0f, 30.0f, 30.0f));
    self.m_builder.pushClip(MakeUiPaintOverlayRect(20.0f, 5.0f, 40.0f, 20.0f));
    ASSERT_TRUE(self.m_builder.drawRegion(s_UiInputNameSprite, MakeUiPaintOverlayRect(0.0f, 0.0f, 64.0f, 48.0f)));
    self.m_builder.pushClip(MakeUiPaintOverlayRect(100.0f, 100.0f, 1.0f, 1.0f));
    self.m_builder.fillRect(MakeUiPaintOverlayRect(0.0f, 0.0f, 200.0f, 100.0f));
    ASSERT_TRUE(self.m_builder.popClip());
    ASSERT_TRUE(self.m_builder.popClip());
    self.m_builder.fillRect(MakeUiPaintOverlayRect(0.0f, 0.0f, 200.0f, 100.0f));
    ASSERT_TRUE(self.m_builder.popClip());
    const DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.vertices().size(), 8u);
    ASSERT_EQ(snapshot.commands().size(), 2u);
    EXPECT_FLOAT_EQ(snapshot.vertices()[0u].position.x, 20.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[0u].position.y, 10.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[2u].position.x, 40.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[2u].position.y, 25.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[0u].texCoord.x, 26.0f / 128.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[0u].texCoord.y, 37.0f / 64.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[4u].position.x, 10.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[6u].position.y, 40.0f);
}

void VerifyUiPaintTests_UndersizedNineSliceCollapsesCenterAndScalesOpposingBorders(mut UiPaintTests self){
    ASSERT_TRUE(self.m_builder.drawRegion(s_UiPaintOverlayPanelRegionName, MakeUiPaintOverlayRect(10.0f, 20.0f, 3.0f, 2.0f)));
    const DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.vertices().size(), 16u);
    EXPECT_FLOAT_EQ(snapshot.vertices()[2u].position.x, 11.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[2u].position.y, 21.5f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[4u].position.x, 11.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[6u].position.x, 13.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[8u].position.y, 21.5f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[14u].position.y, 22.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[2u].texCoord.x, 4.0f / 128.0f);
    EXPECT_FLOAT_EQ(snapshot.vertices()[4u].texCoord.x, 24.0f / 128.0f);
}

void VerifyUiPaintTests_NineSliceZeroBordersDoNotEvaluateInactiveShrinkRatios(mut UiPaintTests self){
    const UiPaintScopedHeldFenv heldEnvironment = UiPaintScopedHeldFenv();
    ASSERT_TRUE(heldEnvironment.valid());
    Array<UiSkinSliceInsets, 3u> borders = Array<UiSkinSliceInsets, 3u>();
    borders[0u] = UiSkinSliceInsets();
    borders[1u] = MakeUiPaintOverlaySliceInsets(4u, 0u, 8u, 0u);
    borders[2u] = MakeUiPaintOverlaySliceInsets(0u, 6u, 0u, 2u);
    for(usize index = 0u; index < borders.size(); ++index){
        const ScopedTestTrace trace = ScopedTestTrace(index);
        self.configurePanelBorderCase(borders[index]);
        const UiPaintDrawRegionFenvSample sample = self.drawPanelWithFenvCheck(s_UiPaintOverlayPanelRegionName, MakeUiPaintOverlayRect(10.0f, 20.0f, 3.0f, 2.0f));
        ASSERT_TRUE(sample.cleared);
        EXPECT_EQ(sample.exceptions, 0);
        ASSERT_TRUE(sample.drawn);
        const DrawSnapshot snapshot = self.m_builder.freeze();
        usize expectedVertices = 8u;
        if(index == 0u)
            expectedVertices = 4u;
        f32 expectedX = 13.0f;
        if(index == 1u)
            expectedX = 11.0f;
        f32 expectedY = 22.0f;
        if(index == 2u)
            expectedY = 21.5f;
        ASSERT_EQ(snapshot.vertices().size(), expectedVertices);
        EXPECT_FLOAT_EQ(snapshot.vertices()[2u].position.x, expectedX);
        EXPECT_FLOAT_EQ(snapshot.vertices()[2u].position.y, expectedY);
    }
}

void VerifyUiPaintTests_BatchesOnlyMergeAdjacentCompatiblePaintAndKeepIndexOrder(mut UiPaintTests self){
    self.m_builder.fillRect(MakeUiPaintOverlayRect(1.0f, 1.0f, 5.0f, 5.0f), MakeUiPaintOverlayColor(1.0f, 0.0f, 0.0f, 0.5f));
    self.m_builder.fillRect(MakeUiPaintOverlayRect(2.0f, 2.0f, 5.0f, 5.0f), MakeUiPaintOverlayColor(0.0f, 1.0f, 0.0f, 1.0f));
    ASSERT_TRUE(self.m_builder.drawRegion(s_UiInputNameSprite, MakeUiPaintOverlayRect(3.0f, 3.0f, 5.0f, 5.0f)));
    self.m_builder.fillRect(MakeUiPaintOverlayRect(4.0f, 4.0f, 5.0f, 5.0f));
    self.m_builder.pushClip(MakeUiPaintOverlayRect(0.0f, 0.0f, 20.0f, 20.0f));
    self.m_builder.fillRect(MakeUiPaintOverlayRect(5.0f, 5.0f, 5.0f, 5.0f));
    ASSERT_TRUE(self.m_builder.popClip());
    const DrawSnapshot snapshot = self.m_builder.freeze();
    ASSERT_EQ(snapshot.commands().size(), 4u);
    EXPECT_EQ(snapshot.commands()[0u].indexCount, 12u);
    EXPECT_EQ(snapshot.commands()[1u].material, PaintMaterial::Skin);
    EXPECT_EQ(snapshot.commands()[2u].firstIndex, 18u);
    EXPECT_EQ(snapshot.commands()[3u].firstIndex, 24u);
}

void VerifyUiPaintTests_FrozenSnapshotOwnsPaintAcrossBuilderReuseAndSourceSkinChanges(mut UiPaintTests self){
    ASSERT_TRUE(self.m_builder.drawRegion(s_UiInputNameSprite, MakeUiPaintOverlayRect(0.0f, 0.0f, 20.0f, 20.0f)));
    EXPECT_FALSE(self.m_builder.drawRegion(s_UiInputNameMissing, MakeUiPaintOverlayRect(0.0f, 0.0f, 20.0f, 20.0f)));
    const DrawSnapshot first = self.m_builder.freeze();
    self.configureReplacementSpriteSkin();
    ASSERT_TRUE(self.m_builder.drawRegion(s_UiInputNameSprite, MakeUiPaintOverlayRect(0.0f, 0.0f, 10.0f, 10.0f)));
    const DrawSnapshot second = self.m_builder.freeze();
    EXPECT_EQ(first.generation(), 7u);
    EXPECT_EQ(first.skinBinding().generation, 3u);
    EXPECT_EQ(first.skinBinding().texture.name(), s_UiPaintOverlayTextureName);
    EXPECT_EQ(first.skinBinding().atlasWidth, 128u);
    EXPECT_FLOAT_EQ(first.displayMetrics().pixelScaleX, 1.5f);
    EXPECT_FLOAT_EQ(first.vertices()[0u].texCoord.x, 16.0f / 128.0f);
    EXPECT_FLOAT_EQ(first.vertices()[2u].position.x, 20.0f);
    EXPECT_EQ(second.skinBinding().generation, 4u);
    EXPECT_FLOAT_EQ(second.vertices()[0u].texCoord.x, 0.0f);
    EXPECT_NE(UiPaintOverlayVerticesAddress(first), UiPaintOverlayVerticesAddress(second));
}


