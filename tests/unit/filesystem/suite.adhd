const StringView s_MountedDirectory = "mounted";
const StringView s_RelocatedDirectory = "relocated";
const StringView s_HeldFileSuffix = ".held";

void VerifyFilesystemVolumeTest_SegmentProbePreservesInspectionErrors(mut FilesystemVolumeTest self){
    const Expected<b8, ErrorCode> missing = VolumeSegmentExists(self.m_directory, self.m_desc.volumeName.view());
    ASSERT_TRUE(missing.has_value());
    EXPECT_FALSE(missing.value());

    DiskPath invalidPath(self.m_arena);
    native(mut self, mut invalidPath){
#if defined(NWB_PLATFORM_WINDOWS)
        invalidPath = DiskPath(self.m_arena, "invalid|volume");
#else
        TString<GlobalArena> longName(self.m_arena);
        longName.resize(40000u, static_cast<tchar>('a'));
        invalidPath = DiskPath(self.m_arena, longName);
#endif
    }
    const Expected<b8, ErrorCode> inspection = IsDirectory(invalidPath);
    ASSERT_FALSE(inspection.has_value());
    const Expected<b8, ErrorCode> failedProbe = VolumeSegmentExists(invalidPath, self.m_desc.volumeName.view());
    ASSERT_FALSE(failedProbe.has_value());
    EXPECT_EQ(failedProbe.error(), inspection.error());

    CreatedFilesystem filesystem(self.m_arena, self.m_desc);
    ASSERT_TRUE(filesystem.valid());
    const Expected<b8, ErrorCode> present = VolumeSegmentExists(self.m_directory, self.m_desc.volumeName.view());
    ASSERT_TRUE(present.has_value());
    EXPECT_TRUE(present.value());
    ASSERT_TRUE(filesystem.get().unmount());
}

void VerifyFilesystemVolumeTest_SegmentCreatedAfterMountIsNotTruncated(mut FilesystemVolumeTest self){
    VolumeFileSystem filesystem(self.m_arena);
    ASSERT_TRUE(filesystem.mount(self.m_desc));

    const auto unexpected = MakeVolumeSegmentPath(self.m_directory, self.m_desc.volumeName.view(), 1u);
    Array<u8, 4> sentinel = Array<u8, 4>();
    sentinel[0u] = 7u;
    sentinel[1u] = 8u;
    sentinel[2u] = 9u;
    sentinel[3u] = 10u;
    ASSERT_TRUE(WriteBinaryFile(unexpected, sentinel));

    Vector<u8> payload;
    payload.resize(5000u);
    for(usize i = 0u; i < payload.size(); ++i)
        payload[i] = 5u;
    EXPECT_FALSE(filesystem.writeFile(s_FilesystemNameProjectTestsPayload, payload));

    Vector<u8> loaded;
    ASSERT_TRUE(ReadBinaryFile(unexpected, loaded).has_value());
    ASSERT_EQ(loaded.size(), sentinel.size());
    for(usize i = 0u; i < sentinel.size(); ++i)
        EXPECT_EQ(loaded[i], sentinel[i]);

    EXPECT_FALSE(filesystem.fileExists(s_FilesystemNameProjectTestsPayload));
    ASSERT_TRUE(filesystem.unmount());
}

void VerifyFilesystemVolumeTest_FailedMultiSegmentGrowthKeepsTrimmedVolumeMountable(mut FilesystemVolumeTest self){
    VolumeFileSystem filesystem(self.m_arena);
    ASSERT_TRUE(filesystem.mount(self.m_desc));

    Array<u8, 3> payload = Array<u8, 3>();
    payload[0u] = 1u;
    payload[1u] = 2u;
    payload[2u] = 3u;
    ASSERT_TRUE(filesystem.writeFile(s_FilesystemNameProjectTestsPayload, payload));
    ASSERT_TRUE(filesystem.flush());

    const auto first = MakeVolumeSegmentPath(self.m_directory, self.m_desc.volumeName.view(), 0u);
    const Expected<u64, ErrorCode> trimmedSize = FileSize(first);
    ASSERT_TRUE(trimmedSize.has_value());
    ASSERT_LT(trimmedSize.value(), self.m_desc.segmentSize);

    const auto collision = MakeVolumeSegmentPath(self.m_directory, self.m_desc.volumeName.view(), 2u);
    Array<u8, 2> sentinel = Array<u8, 2>();
    sentinel[0u] = 7u;
    sentinel[1u] = 8u;
    ASSERT_TRUE(WriteBinaryFile(collision, sentinel));

    Vector<u8> large;
    large.resize(9000u);
    for(usize i = 0u; i < large.size(); ++i)
        large[i] = 5u;
    EXPECT_FALSE(filesystem.writeFile(s_FilesystemNameProjectTestsLargeGrowth, large));

    Vector<u8> loaded;
    ASSERT_TRUE(ReadBinaryFile(collision, loaded).has_value());
    ASSERT_EQ(loaded.size(), sentinel.size());
    for(usize i = 0u; i < sentinel.size(); ++i)
        EXPECT_EQ(loaded[i], sentinel[i]);

    ASSERT_TRUE(RemoveFile(collision).has_value());
    ASSERT_TRUE(filesystem.unmount());
    ASSERT_TRUE(filesystem.mount(self.m_desc));
    ASSERT_TRUE(filesystem.readFile(s_FilesystemNameProjectTestsPayload, loaded));
    ASSERT_EQ(loaded.size(), payload.size());
    for(usize i = 0u; i < payload.size(); ++i)
        EXPECT_EQ(loaded[i], payload[i]);

    EXPECT_FALSE(filesystem.fileExists(s_FilesystemNameProjectTestsLargeGrowth));
    ASSERT_TRUE(filesystem.unmount());
}

void VerifyFilesystemVolumeTest_GrowthDoesNotPadOverExternallyTruncatedLiveData(mut FilesystemVolumeTest self){
    VolumeFileSystem filesystem(self.m_arena);
    ASSERT_TRUE(filesystem.mount(self.m_desc));
    const u64 truncatedSize = self.m_desc.metadataSize + 1u;

    Array<u8, 8> payload = Array<u8, 8>();
    for(usize i = 0u; i < payload.size(); ++i)
        payload[i] = cast<u8>(i + 1u);
    ASSERT_TRUE(filesystem.writeFile(s_FilesystemNameProjectTestsPayload, payload));

    const auto first = MakeVolumeSegmentPath(self.m_directory, self.m_desc.volumeName.view(), 0u);
    ASSERT_TRUE(ResizeFile(first, truncatedSize).has_value());

    Vector<u8> large;
    large.resize(5000u);
    for(usize i = 0u; i < large.size(); ++i)
        large[i] = 5u;
    EXPECT_FALSE(filesystem.writeFile(s_FilesystemInputNameProjectTestsNewGrowth, large));

    const Expected<u64, ErrorCode> size = FileSize(first);
    ASSERT_TRUE(size.has_value());
    EXPECT_EQ(size.value(), truncatedSize);

    ASSERT_TRUE(filesystem.unmount());
}

void VerifyFilesystemVolumeTest_GrowthAtSegmentLimitDoesNotExpandTrimmedFile(mut FilesystemVolumeTest self){
    self.m_desc.maxSegments = 1u;
    VolumeFileSystem filesystem(self.m_arena);
    ASSERT_TRUE(filesystem.mount(self.m_desc));

    Array<u8, 3> payload = Array<u8, 3>();
    payload[0u] = 1u;
    payload[1u] = 2u;
    payload[2u] = 3u;
    ASSERT_TRUE(filesystem.writeFile(s_FilesystemNameProjectTestsPayload, payload));
    ASSERT_TRUE(filesystem.flush());

    const auto first = MakeVolumeSegmentPath(self.m_directory, self.m_desc.volumeName.view(), 0u);
    const Expected<u64, ErrorCode> before = FileSize(first);
    ASSERT_TRUE(before.has_value());

    Vector<u8> large;
    large.resize(5000u);
    for(usize i = 0u; i < large.size(); ++i)
        large[i] = 5u;
    EXPECT_FALSE(filesystem.writeFile(s_FilesystemInputNameProjectTestsLimitedGrowth, large));

    const Expected<u64, ErrorCode> after = FileSize(first);
    ASSERT_TRUE(after.has_value());
    EXPECT_EQ(after.value(), before.value());

    ASSERT_TRUE(filesystem.unmount());
}

void VerifyFilesystemVolumeTest_ReadsAcrossSegmentsAndSeeksAtBoundaries(mut FilesystemVolumeTest self){
    CreatedFilesystem filesystem(self.m_arena, self.m_desc);
    ASSERT_TRUE(filesystem.valid());

    Vector<u8> payload;
    payload.resize(10000u);
    for(usize i = 0u; i < payload.size(); ++i)
        payload[i] = cast<u8>(i % 251u);
    ASSERT_TRUE(filesystem.get().writeFileDeferred(s_FilesystemNameProjectTestsPayload, payload));
    ASSERT_TRUE(filesystem.get().flush());

    const Expected<FileCursor> opened = filesystem.get().openFile(s_FilesystemNameProjectTestsPayload);
    ASSERT_TRUE(opened.has_value());
    FileCursor cursor = opened.value();
    ASSERT_TRUE(filesystem.get().seekFile(cursor, 3570, FileSeekOrigin::Begin));

    Array<u8, 64> buffer = Array<u8, 64>();
    Expected<usize> bytesRead = MakeUnexpected(Failure());
    native(mut filesystem, mut cursor, mut buffer, mut bytesRead){
        bytesRead = filesystem.get().readFile(cursor, buffer.data(), buffer.size());
    }
    ASSERT_TRUE(bytesRead.has_value());
    ASSERT_EQ(bytesRead.value(), buffer.size());
    for(usize i = 0u; i < bytesRead.value(); ++i)
        EXPECT_EQ(buffer[i], payload[3570u + i]);
    EXPECT_EQ(cursor.offset, 3634u);

    ASSERT_TRUE(filesystem.get().seekFile(cursor, -10, FileSeekOrigin::End));
    native(mut filesystem, mut cursor, mut buffer, mut bytesRead){
        bytesRead = filesystem.get().readFile(cursor, buffer.data(), buffer.size());
    }
    ASSERT_TRUE(bytesRead.has_value());
    ASSERT_EQ(bytesRead.value(), 10u);
    for(usize i = 0u; i < bytesRead.value(); ++i)
        EXPECT_EQ(buffer[i], payload[9990u + i]);

    native(mut filesystem, mut cursor, mut buffer, mut bytesRead){
        bytesRead = filesystem.get().readFile(cursor, buffer.data(), buffer.size());
    }
    ASSERT_TRUE(bytesRead.has_value());
    EXPECT_EQ(bytesRead.value(), 0u);
    EXPECT_EQ(cursor.offset, 10000u);

    EXPECT_FALSE(filesystem.get().seekFile(cursor, 1, FileSeekOrigin::Current));
    EXPECT_FALSE(filesystem.get().seekFile(cursor, -10001, FileSeekOrigin::End));
    EXPECT_FALSE(filesystem.get().seekFile(cursor, i64.min, FileSeekOrigin::Current));
    EXPECT_FALSE(filesystem.get().seekFile(cursor, i64.max, FileSeekOrigin::Current));

    b8 invalidOriginSeek = true;
    native(mut filesystem, mut cursor, mut invalidOriginSeek){
        invalidOriginSeek = filesystem.get().seekFile(cursor, 0, static_cast<FileSeekOrigin::Enum>(255));
    }
    EXPECT_FALSE(invalidOriginSeek);
    EXPECT_EQ(cursor.offset, 10000u);

    filesystem.get().closeFile(cursor);
    native(mut filesystem, mut cursor, mut buffer, mut bytesRead){
        bytesRead = filesystem.get().readFile(cursor, buffer.data(), buffer.size());
    }
    EXPECT_FALSE(bytesRead.has_value());
    ASSERT_TRUE(filesystem.get().unmount());
}

void VerifyFilesystemVolumeTest_DeferredWritesSurviveUnmountAndReadOnlyMount(mut FilesystemVolumeTest self){
    CreatedFilesystem filesystem(self.m_arena, self.m_desc);
    ASSERT_TRUE(filesystem.valid());

    Array<u8, 4> payload = Array<u8, 4>();
    payload[0u] = 1u;
    payload[1u] = 3u;
    payload[2u] = 5u;
    payload[3u] = 7u;
    ASSERT_TRUE(filesystem.get().writeFileDeferred(s_FilesystemNameProjectTestsPayload, payload));
    payload[0u] = 99u;
    ASSERT_TRUE(filesystem.get().unmount());

    self.m_desc.createIfMissing = false;
    self.m_desc.usage = VolumeUsage::RuntimeReadOnly;
    ASSERT_TRUE(filesystem.get().mount(self.m_desc));

    Vector<u8> loaded;
    ASSERT_TRUE(filesystem.get().readFile(s_FilesystemNameProjectTestsPayload, loaded));
    ASSERT_EQ(loaded.size(), 4u);
    EXPECT_EQ(loaded[0u], 1u);
    EXPECT_FALSE(filesystem.get().writeFile(s_FilesystemNameProjectTestsPayload, payload));
    EXPECT_FALSE(filesystem.get().removeFile(s_FilesystemNameProjectTestsPayload));
    ASSERT_TRUE(filesystem.get().unmount());
}

void VerifyFilesystemVolumeTest_FailedUnmountRetainsPendingWritesForExplicitRetry(mut FilesystemVolumeTest self){
    const Path baseDirectory = self.m_directory;
    self.m_desc.mountDirectory = baseDirectory / s_MountedDirectory;
    const Path relocated = baseDirectory / s_RelocatedDirectory;

    CreatedFilesystem filesystem(self.m_arena, self.m_desc);
    ASSERT_TRUE(filesystem.valid());

    Array<u8, 4> payload = Array<u8, 4>();
    payload[0u] = 1u;
    payload[1u] = 3u;
    payload[2u] = 5u;
    payload[3u] = 7u;
    ASSERT_TRUE(filesystem.get().writeFileDeferred(s_FilesystemNameProjectTestsPayload, payload));
    payload[0u] = 99u;

    ASSERT_TRUE(RenamePath(self.m_desc.mountDirectory, relocated).has_value());
    EXPECT_FALSE(filesystem.get().unmount());
    EXPECT_TRUE(filesystem.get().mounted());
    EXPECT_TRUE(filesystem.get().writable());
    EXPECT_TRUE(filesystem.get().fileExists(s_FilesystemNameProjectTestsPayload));
    ASSERT_TRUE(RenamePath(relocated, self.m_desc.mountDirectory).has_value());
    ASSERT_TRUE(filesystem.get().unmount());

    self.m_desc.createIfMissing = false;
    self.m_desc.usage = VolumeUsage::RuntimeReadOnly;
    ASSERT_TRUE(filesystem.get().mount(self.m_desc));

    Vector<u8> loaded;
    ASSERT_TRUE(filesystem.get().readFile(s_FilesystemNameProjectTestsPayload, loaded));
    ASSERT_EQ(loaded.size(), payload.size());
    EXPECT_EQ(loaded[0u], 1u);
    EXPECT_EQ(loaded[1u], 3u);
    EXPECT_EQ(loaded[2u], 5u);
    EXPECT_EQ(loaded[3u], 7u);
    ASSERT_TRUE(filesystem.get().unmount());
}

void VerifyFilesystemVolumeTest_ExplicitFlushSurvivesResourceOnlyDestructionWithoutPersistenceRetry(mut FilesystemVolumeTest self){
    const Path baseDirectory = self.m_directory;
    self.m_desc.mountDirectory = baseDirectory / s_MountedDirectory;
    const Path relocated = baseDirectory / s_RelocatedDirectory;

    CreatedFilesystem filesystem(self.m_arena, self.m_desc);
    ASSERT_TRUE(filesystem.valid());

    Array<u8, 3> payload = Array<u8, 3>();
    payload[0u] = 4u;
    payload[1u] = 5u;
    payload[2u] = 6u;
    ASSERT_TRUE(filesystem.get().writeFileDeferred(s_FilesystemNameProjectTestsPayload, payload));
    ASSERT_TRUE(filesystem.get().flush());

    ASSERT_TRUE(RenamePath(self.m_desc.mountDirectory, relocated).has_value());
    const u32 messageCount = self.m_logger.messageCount();
    filesystem.reset();
    EXPECT_EQ(self.m_logger.messageCount(), messageCount);
    ASSERT_TRUE(RenamePath(relocated, self.m_desc.mountDirectory).has_value());

    self.m_desc.createIfMissing = false;
    self.m_desc.usage = VolumeUsage::RuntimeReadOnly;
    CreatedFilesystem reopened(self.m_arena, self.m_desc);
    ASSERT_TRUE(reopened.valid());

    Vector<u8> loaded;
    ASSERT_TRUE(reopened.get().readFile(s_FilesystemNameProjectTestsPayload, loaded));
    ASSERT_EQ(loaded.size(), payload.size());
    for(usize i = 0u; i < payload.size(); ++i)
        EXPECT_EQ(loaded[i], payload[i]);
    ASSERT_TRUE(reopened.get().unmount());
}

