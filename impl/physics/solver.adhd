const usize s_CpuParallelThreshold = 64u;
const usize s_CpuColorParallelThreshold = 256u;
const usize s_CpuPrepareContactThreshold = 128u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class PartitionContactRec{
    public u32 contactId = s_NullIndex;
    public u32 color = 0u;
    public u32 dynAwakeIdx = s_NullIndex;
    public u8 hasAwakeKin = 0u;
    public u8 isCpuOnly = 0u;
}

class PartitionJointRec{
    public u32 jointId = s_NullIndex;
    public u32 dynAwakeIdx = s_NullIndex;
    public u8 hasAwakeKin = 0u;
    public u8 isCpuOnly = 0u;
}

class SolverComponentInfo{
    public u32 componentRoot = s_NullIndex;
    public u32 bodyCount = 0u;
    public u32 contactCount = 0u;
    public u32 jointCount = 0u;
    public u32 maxDynamicColor = 0u;
    public u32 colorMask = 0u;
    public u32 workScore = 0u;
    public b8 hasBullet = false;
    public b8 hasOverflowContact = false;
    public b8 hasAwakeKinematic = false;
    public b8 hasCpuOnlyJoint = false;
    public b8 assignGpu = false;
    public u32 affinityTier = 0u;
    public u32 colorBitCount = 0u;
}

class GpuIslandPartitionSlice{
    public u32 bodyOffset = 0u;
    public u32 bodyCount = 0u;
    public u32 contactOffset = 0u;
    public u32 contactCount = 0u;
    public u32 jointOffset = 0u;
    public u32 jointCount = 0u;
    public Array<u16, s_GraphColorCount> contactColorCounts;
}

class SolverWorkPartition{
    public Vector<u8> awakeBodyOwner;
    public Vector<u32> cpuAwakeIndices;
    public Vector<u32> gpuAwakeIndices;
    public Vector<u8> gpuAwakeWriteBack;
    public Vector<u32> awakeToGpuSlot;
    public Array<Vector<u32>, s_GraphColorCount> cpuColorContactIds;
    public Array<Vector<u32>, s_GraphColorCount> gpuColorContactIds;
    public Vector<u32> cpuJointIds;
    public Vector<u32> gpuJointIds;
    public Vector<GpuIslandPartitionSlice> gpuIslandSlices;
    public u32 gpuFreeBodyCount = 0u;
    public u32 gpuContactIslandCount = 0u;
    public u32 gpuLargeContactIslandCount = 0u;
    public u32 gpuJointIslandCount = 0u;
    public u32 gpuColorBodyOffset = 0u;
    public Vector<u32> gpuIslandContactIds;
    public Vector<u32> gpuIslandJointIds;
    public Array<Vector<u32>, s_GraphColorCount> gpuColorOnlyContactIds;
    public Vector<u32> gpuColorOnlyJointIds;
    public Vector<u32> cpuKinAwakeIndices;
    public Vector<u32> cpuCompWorkScores;
    public Vector<u32> cpuCompBodyOffsets;
    public Vector<u32> cpuCompBodyIndices;
    public Vector<u32> cpuCompContactOffsets;
    public Vector<CpuContactSlotRef> cpuCompContactSlots;
    public Vector<u32> cpuCompJointOffsets;
    public Vector<u32> cpuCompJointIndices;
    public u32 cpuComponentCount = 0u;
    public u32 gpuComponentCount = 0u;
    public u32 cpuOwnedBodyCount = 0u;
    public u32 gpuOwnedBodyCount = 0u;
    public b8 cpuCanSolveParallel = false;
    public b8 hasSharedKinematic = false;
    public b8 allAwakeDynamic = false;

    public Vector<u32> scratchActiveJointIds;
    public Vector<u32> scratchDsuParents;
    public Vector<u8> scratchDsuRanks;
    public Vector<PartitionContactRec> scratchConRecs;
    public Vector<PartitionJointRec> scratchJointRecs;
    public Vector<SolverComponentInfo> scratchComponents;
    public Vector<u32> scratchRootToComp;
    public Vector<u32> scratchAwakeCompIdx;
    public Vector<usize> scratchCompOrder;
    public Vector<u8> scratchGpuCompKind;
    public Vector<u32> scratchCompToCpuCompIdx;
    public Vector<usize> scratchSortedFreeComps;
    public Vector<usize> scratchSortedContactIslands;
    public Vector<usize> scratchSortedLargeContactIslands;
    public Vector<usize> scratchSortedJointIslands;
    public Vector<u32> scratchCompToIslandIdx;
    public Vector<u32> scratchCompDynOffsets;
    public Vector<u32> scratchCompDynCursors;
    public Vector<u32> scratchCompDynBodies;
    public Vector<u32> scratchStagedContactIds;
    public Vector<u32> scratchStagedContactIslands;
    public Vector<CpuContactSlotRef> scratchStagedCpuContactSlots;
    public Vector<u32> scratchStagedCpuContactComps;
    public Vector<u32> scratchCursors;
    public Vector<u32> scratchIslandCursors;
    public Vector<u32> scratchBinHeads;
    public Vector<u32> scratchBinTails;
    public Vector<u32> scratchBinNexts;
    public Vector<u32> scratchBinBodies;
    public Vector<u32> scratchBinContacts;
    public Vector<u32> scratchBinJoints;
    public Vector<u8> scratchBinOverflow;
    public Vector<u32> scratchLargeBinHeads;
    public Vector<u32> scratchLargeBinTails;
    public Vector<u32> scratchLargeBinBodies;
    public Vector<u32> scratchLargeBinContacts;
    public Vector<u32> scratchLargeBinJoints;
    public Vector<u8> scratchLargeBinOverflow;
    public Vector<u32> scratchJointBinHeads;
    public Vector<u32> scratchJointBinTails;
    public Vector<u32> scratchJointBinBodies;
    public Vector<u32> scratchJointBinContacts;
    public Vector<u32> scratchJointBinJoints;
    public Vector<u8> scratchJointBinOverflow;
    public Vector<u32> scratchStagedJointIds;
    public Vector<u32> scratchStagedJointIslands;
    public Vector<u32> scratchStagedCpuJointLocalIds;
    public Vector<u32> scratchStagedCpuJointComps;
    public Vector<u32> scratchJointVisitStamps;
    public u32 scratchJointVisitStamp = 0u;
    public Vector<u32> scratchOpenBins;
    public Vector<u32> scratchIslandIdToComp;
    public Vector<u32> scratchIslandStamps;
    public u32 scratchIslandStamp = 0u;
    public Vector<u64> scratchCrossIslandEdges;

    public void resetForStep(){
        this.awakeBodyOwner.clear();
        this.cpuAwakeIndices.clear();
        this.gpuAwakeIndices.clear();
        this.gpuAwakeWriteBack.clear();
        this.awakeToGpuSlot.clear();
        for(usize c = 0u; c < s_GraphColorCount; ++c){
            this.cpuColorContactIds[c].clear();
            this.gpuColorContactIds[c].clear();
            this.gpuColorOnlyContactIds[c].clear();
        }
        this.cpuJointIds.clear();
        this.gpuJointIds.clear();
        this.gpuIslandSlices.clear();
        this.gpuFreeBodyCount = 0u;
        this.gpuContactIslandCount = 0u;
        this.gpuLargeContactIslandCount = 0u;
        this.gpuJointIslandCount = 0u;
        this.gpuColorBodyOffset = 0u;
        this.gpuIslandContactIds.clear();
        this.gpuIslandJointIds.clear();
        this.gpuColorOnlyJointIds.clear();
        this.cpuKinAwakeIndices.clear();
        this.cpuCompWorkScores.clear();
        this.cpuCompBodyOffsets.clear();
        this.cpuCompBodyIndices.clear();
        this.cpuCompContactOffsets.clear();
        this.cpuCompContactSlots.clear();
        this.cpuCompJointOffsets.clear();
        this.cpuCompJointIndices.clear();
        this.cpuComponentCount = 0u;
        this.gpuComponentCount = 0u;
        this.cpuOwnedBodyCount = 0u;
        this.gpuOwnedBodyCount = 0u;
        this.cpuCanSolveParallel = false;
        this.hasSharedKinematic = false;
        this.allAwakeDynamic = false;
    }
}


