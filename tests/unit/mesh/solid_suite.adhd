void VerifyMeshSolidCodec_MissingTruncatedOrExtraMembershipWordsAreRejected(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistration(logger, LoggerBreakPolicy::ReportOnly);
    AssetArena arena(s_SolidCaseMeshSolidCodecTruncated);

    native(mut arena){
        const auto cooked = CookMeshBinary(arena);
        ASSERT_TRUE(cooked);
        Mesh control(arena, s_OneOffNameTestsMeshSolidCodec);
        ASSERT_TRUE(control.loadBinary(*cooked));
        ASSERT_EQ(control.solidTriangleWords().size(), 1u);
        ASSERT_EQ(control.solidTriangleWords()[0], 0xfu);

        Mesh rejected(arena, s_OneOffNameTestsMeshSolidCodec);
        for(usize removedBytes = 1u; removedBytes <= sizeof(u32); ++removedBytes){
            AssetBytes malformed(*cooked);
            malformed.resize(malformed.size() - removedBytes);
            EXPECT_FALSE(rejected.loadBinary(malformed)) << "removed membership bytes: " << removedBytes;
        }
        AssetBytes extraWord(*cooked);
        AppendPOD(extraWord, u32(0u));
        EXPECT_FALSE(rejected.loadBinary(extraWord));
    }

    EXPECT_GT(logger.errorCount(), 0u);
}

void VerifyMeshSolidCodec_UnaddressableBoundsCountIsRejectedBeforeStreamReadAndPreservesLoadedMesh(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistration(logger, LoggerBreakPolicy::ReportOnly);
    AssetArena arena(s_SolidCaseMeshSolidCodecUnaddressableBounds);

    native(mut arena){
        const auto cooked = CookMeshBinary(arena);
        ASSERT_TRUE(cooked);
        Mesh loaded(arena, s_OneOffNameTestsMeshSolidCodec);
        ASSERT_TRUE(loaded.loadBinary(*cooked));
        const usize retainedMeshletCount = loaded.meshlets().size();
        const usize retainedPositionCount = loaded.positionStream().size();
        ASSERT_EQ(loaded.solidTriangleWords().size(), 1u);
        const u32 retainedSolidWord = loaded.solidTriangleWords()[0];

        AssetBytes malformed(*cooked);
        constexpr u64 s_UnaddressableBoundsCount = static_cast<u64>(Limit<u32>::s_Max / Impl::s_MeshletBoundsStride) + 1u;
        static_assert((s_UnaddressableBoundsCount - 1u) * Impl::s_MeshletBoundsStride <= Limit<u32>::s_Max);
        static_assert(s_UnaddressableBoundsCount * Impl::s_MeshletBoundsStride > Limit<u32>::s_Max);
        NWB_MEMCPY(malformed.data() + offsetof(Impl::MeshBinaryHeader, meshletCount), sizeof(s_UnaddressableBoundsCount), &s_UnaddressableBoundsCount, sizeof(s_UnaddressableBoundsCount));
        NWB_MEMCPY(malformed.data() + offsetof(Impl::MeshBinaryHeader, meshletBoundCount), sizeof(s_UnaddressableBoundsCount), &s_UnaddressableBoundsCount, sizeof(s_UnaddressableBoundsCount));
        EXPECT_FALSE(loaded.loadBinary(malformed));
        EXPECT_EQ(loaded.meshlets().size(), retainedMeshletCount);
        EXPECT_EQ(loaded.positionStream().size(), retainedPositionCount);
        ASSERT_EQ(loaded.solidTriangleWords().size(), 1u);
        EXPECT_EQ(loaded.solidTriangleWords()[0], retainedSolidWord);
    }

    EXPECT_TRUE(SawCapturedError(logger, "mesh payload is incomplete"));
}

void VerifyMeshSolidCodec_TailPaddingAndInconsistentPrimitiveCountsAreRejected(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistration(logger, LoggerBreakPolicy::ReportOnly);
    AssetArena arena(s_SolidCaseMeshSolidCodecPadding);

    native(mut arena){
        const auto cooked = CookMeshBinary(arena);
        ASSERT_TRUE(cooked);
        Mesh control(arena, s_OneOffNameTestsMeshSolidCodec);
        ASSERT_TRUE(control.loadBinary(*cooked));
        ASSERT_EQ(control.solidTriangleWords().size(), 1u);

        Mesh rejected(arena, s_OneOffNameTestsMeshSolidCodec);
        for(const u32 invalidWord : { 0x1fu, 0x8000000fu }){
            AssetBytes malformed(*cooked);
            NWB_MEMCPY(malformed.data() + malformed.size() - sizeof(u32), sizeof(invalidWord), &invalidWord, sizeof(invalidWord));
            EXPECT_FALSE(rejected.loadBinary(malformed));
        }
        AssetBytes wrongCount(*cooked);
        constexpr u64 s_InconsistentIndexCount = 99u;
        NWB_MEMCPY(wrongCount.data() + offsetof(Impl::MeshBinaryHeader, meshletPrimitiveIndexCount), sizeof(s_InconsistentIndexCount), &s_InconsistentIndexCount, sizeof(s_InconsistentIndexCount));
        EXPECT_FALSE(rejected.loadBinary(wrongCount));
    }

    EXPECT_TRUE(SawCapturedError(logger, "invalid solid triangle padding"));
}

void VerifyMeshSolidCodec_AdjacentBoundsPreserveFloatBitsAndRejectATruncatedLastCone(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistration(logger, LoggerBreakPolicy::ReportOnly);
    AssetArena arena(s_SolidCaseMeshSolidCodecCompactBounds);

    native(mut arena){
        const Array<u32, 10u> words{ 0x80000000u, 0x00000001u, 0x7f7fffffu, 0x3f800000u, 0xff000001u, 0x00000000u, 0x80000001u, 0xff7fffffu, 0x00800000u, 0x80000001u };
        Core::Assets::AssetVector<Impl::MeshletBounds> bounds(arena);
        bounds.resize(2u);
        for(usize index = 0u; index < bounds.size(); ++index){
            for(usize component = 0u; component < 4u; ++component)
                bounds[index].sphere.raw[component] = BitCast<f32>(words[index * 5u + component]);
            bounds[index].conePacked = words[index * 5u + 4u];
        }
        AssetBytes binary(arena);
        ASSERT_TRUE(Core::Assets::AppendVectorPayload(bounds, NWB_TEXT("compact bounds"), NWB_TEXT("bounds"), binary));
        ASSERT_EQ(binary.size(), sizeof(u32) * words.size());
        usize wordCursor = 0u;
        for(const u32 word : words){
            const auto stored = ReadPOD<u32>(binary, wordCursor);
            ASSERT_TRUE(stored);
            EXPECT_EQ(*stored, word);
        }
        Core::Assets::AssetVector<Impl::MeshletBounds> decoded(arena);
        usize cursor = 0u;
        ASSERT_TRUE(Core::Assets::ReadVectorPayload(binary, bounds.size(), NWB_TEXT("compact bounds"), NWB_TEXT("bounds"), cursor, decoded));
        ASSERT_EQ(decoded.size(), bounds.size());
        for(usize index = 0u; index < decoded.size(); ++index){
            for(usize component = 0u; component < 4u; ++component)
                EXPECT_EQ(BitCast<u32>(decoded[index].sphere.raw[component]), words[index * 5u + component]);
            EXPECT_EQ(decoded[index].conePacked, words[index * 5u + 4u]);
        }
        for(usize removedBytes = 1u; removedBytes <= sizeof(u32); ++removedBytes){
            AssetBytes truncated(binary);
            truncated.resize(truncated.size() - removedBytes);
            cursor = 0u;
            EXPECT_FALSE(Core::Assets::ReadVectorPayload(truncated, bounds.size(), NWB_TEXT("compact bounds"), NWB_TEXT("bounds"), cursor, decoded)) << "missing final cone bytes: " << removedBytes;
            EXPECT_EQ(cursor, 0u);
            EXPECT_TRUE(decoded.empty());
        }
    }

    EXPECT_EQ(logger.errorCount(), 4u);
}

void VerifyMeshSolidCodec_PreviousMeshMagicCannotAdmitOtherwiseValidCurrentPayload(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistration(logger, LoggerBreakPolicy::ReportOnly);
    AssetArena arena(s_SolidCaseMeshSolidCodecPreviousEncoding);

    native(mut arena){
        const auto cooked = CookMeshBinary(arena);
        ASSERT_TRUE(cooked);
        Mesh control(arena, s_OneOffNameTestsMeshSolidCodec);
        ASSERT_TRUE(control.loadBinary(*cooked));

        AssetBytes previousEncoding(*cooked);
        constexpr u32 s_PreviousMeshMagic = 0x4d534836u;
        NWB_MEMCPY(previousEncoding.data(), sizeof(s_PreviousMeshMagic), &s_PreviousMeshMagic, sizeof(s_PreviousMeshMagic));
        Mesh rejected(arena, s_OneOffNameTestsMeshSolidCodec);
        EXPECT_FALSE(rejected.loadBinary(previousEncoding));
    }

    EXPECT_GT(logger.errorCount(), 0u);
}

void VerifyMeshSolidTopology_MixedClosedOpenAndInwardComponentsKeepIndependentMembership(){
    Array<f32x3u, 11> positions = Array<f32x3u, 11>();
    positions[0u] = f32x3u(0.0f, 0.0f, 0.0f);
    positions[1u] = f32x3u(1.0f, 0.0f, 0.0f);
    positions[2u] = f32x3u(0.0f, 1.0f, 0.0f);
    positions[3u] = f32x3u(0.0f, 0.0f, 1.0f);
    positions[4u] = f32x3u(2.0f, 0.0f, 0.0f);
    positions[5u] = f32x3u(3.0f, 0.0f, 0.0f);
    positions[6u] = f32x3u(2.0f, 1.0f, 0.0f);
    positions[7u] = f32x3u(2.0f, 0.0f, 1.0f);
    positions[8u] = f32x3u(4.0f, 0.0f, 0.0f);
    positions[9u] = f32x3u(5.0f, 0.0f, 0.0f);
    positions[10u] = f32x3u(4.0f, 1.0f, 0.0f);

    Array<u32, 27> indices = Array<u32, 27>();
    indices[0u] = 0u; indices[1u] = 2u; indices[2u] = 1u;
    indices[3u] = 0u; indices[4u] = 1u; indices[5u] = 3u;
    indices[6u] = 0u; indices[7u] = 3u; indices[8u] = 2u;
    indices[9u] = 1u; indices[10u] = 2u; indices[11u] = 3u;
    indices[12u] = 4u; indices[13u] = 5u; indices[14u] = 6u;
    indices[15u] = 4u; indices[16u] = 7u; indices[17u] = 5u;
    indices[18u] = 4u; indices[19u] = 6u; indices[20u] = 7u;
    indices[21u] = 5u; indices[22u] = 7u; indices[23u] = 6u;
    indices[24u] = 8u; indices[25u] = 9u; indices[26u] = 10u;

    const Expected<Vector<u32>> words = BuildSolidTriangleWords(positions, indices);
    ASSERT_TRUE(words.has_value());
    ASSERT_EQ(words.value().size(), 1u);
    EXPECT_EQ(words.value()[0u], 0xffu);
}

void VerifySolidZeroWord(in Span<f32x3u> positions, in Span<u32> indices){
    const Expected<Vector<u32>> words = BuildSolidTriangleWords(positions, indices);
    ASSERT_TRUE(words.has_value());
    ASSERT_EQ(words.value().size(), 1u);
    EXPECT_EQ(words.value()[0u], 0u);
}

void VerifyMeshSolidTopology_BrokenWindingNonManifoldAndDegenerateFacesInvalidateTheirWholeComponent(){
    Array<f32x3u, 5> positions = Array<f32x3u, 5>();
    positions[0u] = f32x3u(0.0f, 0.0f, 0.0f);
    positions[1u] = f32x3u(1.0f, 0.0f, 0.0f);
    positions[2u] = f32x3u(0.0f, 1.0f, 0.0f);
    positions[3u] = f32x3u(0.0f, 0.0f, 1.0f);
    positions[4u] = f32x3u(0.5f, 0.0f, 0.0f);

    Array<u32, 12> brokenWinding = Array<u32, 12>();
    brokenWinding[0u] = 0u; brokenWinding[1u] = 1u; brokenWinding[2u] = 2u;
    brokenWinding[3u] = 0u; brokenWinding[4u] = 1u; brokenWinding[5u] = 3u;
    brokenWinding[6u] = 0u; brokenWinding[7u] = 3u; brokenWinding[8u] = 2u;
    brokenWinding[9u] = 1u; brokenWinding[10u] = 2u; brokenWinding[11u] = 3u;

    Array<u32, 15> nonManifold = Array<u32, 15>();
    nonManifold[0u] = 0u; nonManifold[1u] = 2u; nonManifold[2u] = 1u;
    nonManifold[3u] = 0u; nonManifold[4u] = 1u; nonManifold[5u] = 3u;
    nonManifold[6u] = 0u; nonManifold[7u] = 3u; nonManifold[8u] = 2u;
    nonManifold[9u] = 1u; nonManifold[10u] = 2u; nonManifold[11u] = 3u;
    nonManifold[12u] = 0u; nonManifold[13u] = 1u; nonManifold[14u] = 4u;

    Array<u32, 12> degenerate = Array<u32, 12>();
    degenerate[0u] = 0u; degenerate[1u] = 2u; degenerate[2u] = 1u;
    degenerate[3u] = 0u; degenerate[4u] = 1u; degenerate[5u] = 4u;
    degenerate[6u] = 0u; degenerate[7u] = 4u; degenerate[8u] = 2u;
    degenerate[9u] = 1u; degenerate[10u] = 2u; degenerate[11u] = 4u;

    VerifySolidZeroWord(positions, brokenWinding);
    VerifySolidZeroWord(positions, nonManifold);
    VerifySolidZeroWord(positions, degenerate);
}

void VerifyMeshSolidTopology_CoincidentIndependentPositionsDoNotRepairAnOpenSeam(){
    Array<f32x3u, 7> positions = Array<f32x3u, 7>();
    positions[0u] = f32x3u(0.0f, 0.0f, 0.0f);
    positions[1u] = f32x3u(1.0f, 0.0f, 0.0f);
    positions[2u] = f32x3u(0.0f, 1.0f, 0.0f);
    positions[3u] = f32x3u(0.0f, 0.0f, 1.0f);
    positions[4u] = f32x3u(0.0f, 0.0f, 0.0f);
    positions[5u] = f32x3u(1.0f, 0.0f, 0.0f);
    positions[6u] = f32x3u(0.0f, 1.0f, 0.0f);

    Array<u32, 12> indices = Array<u32, 12>();
    indices[0u] = 4u; indices[1u] = 6u; indices[2u] = 5u;
    indices[3u] = 0u; indices[4u] = 1u; indices[5u] = 3u;
    indices[6u] = 0u; indices[7u] = 3u; indices[8u] = 2u;
    indices[9u] = 1u; indices[10u] = 2u; indices[11u] = 3u;

    VerifySolidZeroWord(positions, indices);
}

void VerifyMeshSolidTopology_MembershipCrossesWordBoundariesWithoutSettingTailPadding(){
    Vector<f32x3u> positions = Vector<f32x3u>();
    Vector<u32> indices = Vector<u32>();
    Array<u32, 12> tetrahedron = Array<u32, 12>();
    tetrahedron[0u] = 0u; tetrahedron[1u] = 2u; tetrahedron[2u] = 1u;
    tetrahedron[3u] = 0u; tetrahedron[4u] = 1u; tetrahedron[5u] = 3u;
    tetrahedron[6u] = 0u; tetrahedron[7u] = 3u; tetrahedron[8u] = 2u;
    tetrahedron[9u] = 1u; tetrahedron[10u] = 2u; tetrahedron[11u] = 3u;
    for(u32 component = 0u; component < 9u; ++component){
        const f32 x = cast<f32>(component) * 2.0f;
        positions.push_back(f32x3u(x, 0.0f, 0.0f));
        positions.push_back(f32x3u(x + 1.0f, 0.0f, 0.0f));
        positions.push_back(f32x3u(x, 1.0f, 0.0f));
        positions.push_back(f32x3u(x, 0.0f, 1.0f));
        for(in u32 corner : tetrahedron)
            indices.push_back(component * 4u + corner);
    }
    const Expected<Vector<u32>> words = BuildSolidTriangleWords(positions, indices);
    ASSERT_TRUE(words.has_value());
    ASSERT_EQ(words.value().size(), 2u);
    EXPECT_EQ(words.value()[0u], 0xffffffffu);
    EXPECT_EQ(words.value()[1u], 0xfu);
}

void VerifyMeshSolidTopology_NonFinitePositionsAndInvalidCornerRangesCannotProduceMembership(){
    Array<f32x3u, 3> positions = Array<f32x3u, 3>();
    positions[0u] = f32x3u(0.0f, 0.0f, 0.0f);
    positions[1u] = f32x3u(1.0f, 0.0f, 0.0f);
    positions[2u] = f32x3u(0.0f, 1.0f, 0.0f);
    Array<u32, 3> validCorners = Array<u32, 3>();
    validCorners[0u] = 0u; validCorners[1u] = 1u; validCorners[2u] = 2u;
    Array<u32, 2> missingCorner = Array<u32, 2>();
    missingCorner[0u] = 0u; missingCorner[1u] = 1u;
    Array<u32, 3> outOfRange = Array<u32, 3>();
    outOfRange[0u] = 0u; outOfRange[1u] = 1u; outOfRange[2u] = 3u;
    EXPECT_FALSE(BuildSolidTriangleWords(positions, missingCorner).has_value());
    EXPECT_FALSE(BuildSolidTriangleWords(positions, outOfRange).has_value());
    positions[2u].x = bit_cast<f32>(0x7fc00000u);
    EXPECT_FALSE(BuildSolidTriangleWords(positions, validCorners).has_value());
}

void VerifyMeshSolidTopology_OpposedSheetsAndCoplanarClosedComponentsRemainSurfaces(){
    Array<f32x3u, 4> positions = Array<f32x3u, 4>();
    positions[0u] = f32x3u(0.0f, 0.0f, 0.0f);
    positions[1u] = f32x3u(1.0f, 0.0f, 0.0f);
    positions[2u] = f32x3u(0.0f, 1.0f, 0.0f);
    positions[3u] = f32x3u(1.0f, 1.0f, 0.0f);
    Array<u32, 6> sheet = Array<u32, 6>();
    sheet[0u] = 0u; sheet[1u] = 1u; sheet[2u] = 2u;
    sheet[3u] = 0u; sheet[4u] = 2u; sheet[5u] = 1u;
    Array<u32, 12> flatTetrahedron = Array<u32, 12>();
    flatTetrahedron[0u] = 0u; flatTetrahedron[1u] = 2u; flatTetrahedron[2u] = 1u;
    flatTetrahedron[3u] = 0u; flatTetrahedron[4u] = 1u; flatTetrahedron[5u] = 3u;
    flatTetrahedron[6u] = 0u; flatTetrahedron[7u] = 3u; flatTetrahedron[8u] = 2u;
    flatTetrahedron[9u] = 1u; flatTetrahedron[10u] = 2u; flatTetrahedron[11u] = 3u;

    VerifySolidZeroWord(positions, sheet);
    VerifySolidZeroWord(positions, flatTetrahedron);
}

void VerifyMeshSolidTopology_RelativeComponentVolumePreservesTinyAndTranslatedSolids(){
    Array<MeshSolidVolumeCase, 3> cases = Array<MeshSolidVolumeCase, 3>();
    cases[0u] = MakeMeshSolidVolumeCase(0.0f, 0.0f, 0.0f, 0.001f);
    cases[1u] = MakeMeshSolidVolumeCase(0.0f, 0.0f, 0.0f, 1.0e-30f);
    cases[2u] = MakeMeshSolidVolumeCase(1.0e20f, -1.0e20f, 1.0e20f, 1.0e14f);
    Array<u32, 12> indices = Array<u32, 12>();
    indices[0u] = 0u; indices[1u] = 2u; indices[2u] = 1u;
    indices[3u] = 0u; indices[4u] = 1u; indices[5u] = 3u;
    indices[6u] = 0u; indices[7u] = 3u; indices[8u] = 2u;
    indices[9u] = 1u; indices[10u] = 2u; indices[11u] = 3u;
    for(in MeshSolidVolumeCase volumeCase : cases){
        const f32x3u origin = volumeCase.origin;
        const VectorSingle shifted = VectorSingle(origin, 0.0f) + VectorSingle(volumeCase.size);
        Array<f32x3u, 4> positions = Array<f32x3u, 4>();
        positions[0u] = origin;
        positions[1u] = f32x3u(shifted.x, origin.y, origin.z);
        positions[2u] = f32x3u(origin.x, shifted.y, origin.z);
        positions[3u] = f32x3u(origin.x, origin.y, shifted.z);
        const Expected<Vector<u32>> words = BuildSolidTriangleWords(positions, indices);
        ASSERT_TRUE(words.has_value());
        ASSERT_EQ(words.value().size(), 1u);
        EXPECT_EQ(words.value()[0u], 0xfu);
    }
}


