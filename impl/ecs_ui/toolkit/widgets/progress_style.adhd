////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "style.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ProgressOptions{
    public LayoutSize width = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
    public f32 height = s_StyleControlHeight;
}

class ProgressStyle{
    public Name track = Name("progress.track");
    public Name fill = Name("progress.fill");
    public Name trackFallback = Name("scrollbar.track");
    public Name fillFallback = Name("scrollbar.thumb.normal");
    public Insets padding;
    public Color trackTint;
    public Color fillTint;
}

class ProgressMetrics{
    public Insets padding;
    public Point fillMinimum;
    public Point contentSize;
}

class ProgressPlacement{
    public Rect bounds;
    public Rect clip;
    public Rect content;
    public Rect fillReveal;
    public Rect fillCanvas;
}

// Each declaration owns its value, policy, resolved semantic names and skin metrics.
class ProgressFrame{
    public f64 fraction = 0.0;
    public ProgressOptions options;
    public ProgressStyle style;
    public ProgressMetrics metrics;
}

void ApplySkinPaletteToProgressStyle(in UiSkinPalette palette, mut ProgressStyle style){
    style.trackTint = ResolveUiSkinColor(palette, UiSkinColorRole::ProgressTrackTint);
    style.fillTint = ResolveUiSkinColor(palette, UiSkinColorRole::ProgressFillTint);
}

b8 IsValidProgressMetrics(in ProgressMetrics metrics){
    if(
        !IsValidUiPadding(metrics.padding)
        || !IsValidUiExtent(metrics.fillMinimum)
        || !IsValidUiExtent(metrics.contentSize)
    )
        return false;
    const VectorDouble leading(cast<f64>(metrics.padding.left), cast<f64>(metrics.padding.top), cast<f64>(metrics.padding.left), cast<f64>(metrics.padding.top));
    const VectorDouble trailing(cast<f64>(metrics.padding.right), cast<f64>(metrics.padding.bottom), cast<f64>(metrics.padding.right), cast<f64>(metrics.padding.bottom));
    const VectorDouble padding = leading + trailing;
    if(padding.x > s_UiMaxFloatF64 || padding.y > s_UiMaxFloatF64)
        return false;
    const VectorDouble fillSize(cast<f64>(metrics.fillMinimum.x), cast<f64>(metrics.fillMinimum.y), cast<f64>(metrics.fillMinimum.x), cast<f64>(metrics.fillMinimum.y));
    const VectorDouble size = padding + fillSize;
    const f64 width = size.x;
    const f64 height = size.y;
    return width <= s_UiMaxFloatF64
        && height <= s_UiMaxFloatF64
        && cast<f64>(metrics.contentSize.x) >= cast<f64>(cast<f32>(width))
        && cast<f64>(metrics.contentSize.y) >= cast<f64>(cast<f32>(height));
}

// Finite fractions clamp visually to the unit interval.
Expected<ProgressMetrics> MeasureProgress(in ProgressOptions options, in ProgressStyle style, in UiSkinRegion track, in UiSkinRegion fill, in f32 density){
    if(
        !IsValidLayoutSize(options.width)
        || !IsFinite(options.height)
        || options.height < 0.0f
        || !IsBoundedUiPadding(style.padding)
        || !IsValidUiColor(style.trackTint)
        || !IsValidUiColor(style.fillTint)
        || !IsFinite(density)
        || density <= 0.0f
    )
        return MakeUnexpected(Failure());
    if(!IsBoundedUiPadding(track.padding) || !IsBoundedUiPadding(fill.padding))
        return MakeUnexpected(Failure());
    const Expected<VectorSingle> trackMin = TryLoadUiSkinMinimumSize(track, cast<f64>(density));
    const Expected<VectorSingle> fillMin = TryLoadUiSkinMinimumSize(fill, cast<f64>(density));
    if(!trackMin.has_value() || !fillMin.has_value())
        return MakeUnexpected(Failure());
    ProgressMetrics candidate;
    candidate.padding = MaxUiPadding(style.padding, track.padding);
    candidate.fillMinimum = Point(fillMin.value().x, fillMin.value().y);
    const VectorDouble leading(cast<f64>(candidate.padding.left), cast<f64>(candidate.padding.top), cast<f64>(candidate.padding.left), cast<f64>(candidate.padding.top));
    const VectorDouble trailing(cast<f64>(candidate.padding.right), cast<f64>(candidate.padding.bottom), cast<f64>(candidate.padding.right), cast<f64>(candidate.padding.bottom));
    const VectorDouble fillSize(cast<f64>(fillMin.value().x), cast<f64>(fillMin.value().y), cast<f64>(fillMin.value().x), cast<f64>(fillMin.value().y));
    const VectorDouble inner = (leading + trailing) + fillSize;
    const VectorDouble size = Max(VectorDouble(cast<f64>(trackMin.value().x), cast<f64>(trackMin.value().y), cast<f64>(trackMin.value().x), cast<f64>(trackMin.value().y)), inner);
    const f64 width = size.x;
    const f64 height = Max(cast<f64>(options.height), size.y);
    if(!IsFinite(width) || width > s_UiMaxFloatF64 || !IsFinite(height) || height > s_UiMaxFloatF64)
        return MakeUnexpected(Failure());
    candidate.contentSize = Point(cast<f32>(width), cast<f32>(height));
    if(!IsValidProgressMetrics(candidate))
        return MakeUnexpected(Failure());
    return candidate;
}

// Paint fillCanvas under fillReveal intersected with clip to preserve small-fill skin borders.
Expected<ProgressPlacement> PlaceProgress(in Rect bounds, in Rect clip, in ProgressMetrics metrics, in f64 fraction){
    if(!IsBoundedUiRect(bounds) || !IsBoundedUiRect(clip) || !IsValidProgressMetrics(metrics) || !IsFinite(fraction))
        return MakeUnexpected(Failure());
    ProgressPlacement candidate;
    candidate.bounds = bounds;
    const Expected<Rect> clipped = TryIntersectUiRects(bounds, clip, UiRectPrecision::EmptyPaint);
    if(!clipped.has_value())
        return MakeUnexpected(Failure());
    candidate.clip = clipped.value();
    const Expected<Rect> content = TryInsetUiRect(bounds, metrics.padding, UiRectPrecision::EmptyPaint);
    if(!content.has_value())
        return MakeUnexpected(Failure());
    candidate.content = content.value();
    const f64 normalized = Clamp(fraction, 0.0, 1.0);
    candidate.fillReveal = candidate.content;
    candidate.fillCanvas = candidate.content;
    if(normalized == 0.0){
        candidate.fillReveal.width = 0.0f;
        candidate.fillCanvas.width = 0.0f;
    }
    else if(normalized != 1.0){
        const f64 contentX = cast<f64>(candidate.content.x);
        const f64 contentY = cast<f64>(candidate.content.y);
        const f64 contentW = cast<f64>(candidate.content.width);
        const f64 contentH = cast<f64>(candidate.content.height);
        const f64 revealW = contentW * normalized;
        const Expected<Rect> fillReveal = TryMakeUiRect(contentX, contentY, revealW, contentH, UiRectPrecision::EmptyPaint);
        if(!fillReveal.has_value())
            return MakeUnexpected(Failure());
        candidate.fillReveal = fillReveal.value();
        f64 canvasW = 0.0;
        if(candidate.fillReveal.width != 0.0f)
            canvasW = Min(contentW, Max(cast<f64>(candidate.fillReveal.width), cast<f64>(metrics.fillMinimum.x)));
        const Expected<Rect> fillCanvas = TryMakeUiRect(contentX, contentY, canvasW, contentH, UiRectPrecision::EmptyPaint);
        if(!fillCanvas.has_value())
            return MakeUnexpected(Failure());
        candidate.fillCanvas = fillCanvas.value();
    }
    return candidate;
}


