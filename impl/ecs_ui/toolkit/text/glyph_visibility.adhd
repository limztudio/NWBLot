#include <impl/ecs_ui/toolkit/text/atlas.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


SharedBakedFontAtlas SelectAtlas(in PlacedGlyph glyph, in f32 physicalSize){
    if(!glyph.face.valid() || !glyph.face.deref().valid())
        return SharedBakedFontAtlas();
    in SharedBakedFontAtlas atlas = glyph.face.deref().bakedAtlas();
    if(!atlas.valid() || !atlas.deref().valid() || !CanUseBakedFontAtlasAtPhysicalSize(atlas.deref().bakePpem(), physicalSize) || !atlas.deref().hasGlyph(glyph.glyphId))
        return SharedBakedFontAtlas();
    return atlas;
}

Expected<VectorDouble> LoadAtlasRectangle(in PlacedGlyph glyph, in BakedFontAtlas atlas, in f32 fontSize, in Point topLeft){
    if(!atlas.valid() || !atlas.hasGlyph(glyph.glyphId))
        return MakeUnexpected(Failure());
    return TryLoadGlyphAtlasRectangle(glyph.position, topLeft, fontSize, atlas.unitsPerEm(), atlas.glyph(glyph.glyphId));
}

Expected<Rect> AtlasRectangle(in PlacedGlyph glyph, in BakedFontAtlas atlas, in f32 fontSize, in Point topLeft){
    const Expected<VectorDouble> rectangle = LoadAtlasRectangle(glyph, atlas, fontSize, topLeft);
    if(!rectangle.has_value())
        return MakeUnexpected(rectangle.error());
    return ToTextGlyphAtlasRect(rectangle.value());
}

// Faces with untrusted coverage bounds stay eligible for raster preparation.
TextGlyphIntersection Candidate(in PlacedGlyph glyph, in SharedBakedFontAtlas selectedAtlas, in f32 fontSize, in f32 physicalSize, in Point topLeft, in Rect clip, in Point pixelScale){
    const TextGlyphIntersection input = ValidateTextGlyphCandidateInputs(glyph.position, topLeft, fontSize, physicalSize, clip, pixelScale);
    if(input != TextGlyphIntersection::Visible)
        return input;
    if(selectedAtlas.valid()){
        const Expected<VectorDouble> rectangle = LoadAtlasRectangle(glyph, selectedAtlas.deref(), fontSize, topLeft);
        if(!rectangle.has_value())
            return TextGlyphIntersection::Invalid;
        return IntersectGlyphAtlasRectangle(rectangle.value(), clip);
    }
    const b8 hasValidFace = glyph.face.valid() && glyph.face.deref().valid();
    const b8 coverageInkReliable = hasValidFace && glyph.face.deref().coverageInkReliable();
    u32 faceUnitsPerEm = 1u;
    if(hasValidFace)
        faceUnitsPerEm = glyph.face.deref().unitsPerEm();
    return EvaluateUnselectedAtlasGlyphCandidate(glyph.position, topLeft, glyph.ink, glyph.coverage, hasValidFace, coverageInkReliable, faceUnitsPerEm, fontSize, physicalSize, clip, pixelScale);
}

TextGlyphIntersection Candidate(in PlacedGlyph glyph, in SharedBakedFontAtlas selectedAtlas, in f32 fontSize, in f32 physicalSize, in Point topLeft, in Rect clip){
    return Candidate(glyph, selectedAtlas, fontSize, physicalSize, topLeft, clip, Point(1.0f, 1.0f));
}

Expected<Rect> CoverageRectangle(in PlacedGlyph glyph, in AtlasGlyph record, in f32 rasterScale, in Point topLeft, in Point pixelScale){
    return TryResolveGlyphCoverageRectangle(glyph.position, record.pageIndex, record.pixels, record.bearingX, record.bearingY, rasterScale, topLeft, pixelScale);
}

Expected<Rect> CoverageRectangle(in PlacedGlyph glyph, in AtlasGlyph record, in f32 rasterScale, in Point topLeft){
    return CoverageRectangle(glyph, record, rasterScale, topLeft, Point(1.0f, 1.0f));
}


