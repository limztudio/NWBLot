const StringView s_GpuRoutingCrossFamilyBufferLabel = "Cross Family Same Class Buffer";
const StringView s_GpuRoutingCrossFamilyProducerLabel = "Cross Family Same Class Producer";
const StringView s_GpuRoutingCrossFamilyConsumerLabel = "Cross Family Same Class Consumer";
const usize s_GpuRoutingLayerSize = 16u;

enum<u8> GpuRoutingPartialDagShape{
    OneEdge,
    DisjointPairs,
    ReversedPairs,
    ConnectedBranches,
    DenseLayers,
    FanOut,
    FanIn,
    MergedPairs,
    Independent,
    TotalOrder,
    kCount
}

class GpuRoutingStorageCase{
    public usize taskCount;
    public GpuRoutingPartialDagShape shape;

    public GpuRoutingStorageCase(){
        this.taskCount = 0u;
        this.shape = GpuRoutingPartialDagShape::OneEdge;
    }

    public GpuRoutingStorageCase(in usize taskCount, in GpuRoutingPartialDagShape shape){
        this.taskCount = taskCount;
        this.shape = shape;
    }
}

void GpuRoutingPushTaskDependency(mut Vector<GpuTaskId> dependencies, in u64 generation, in usize index){
    GpuTaskId dep = GpuTaskId();
    dep.generation = generation;
    dep.index = cast<u32>(index);
    dependencies.push_back(dep);
}

void GpuRoutingDeclarePartialDag(mut GpuTaskGraph graph, in usize taskCount, in GpuRoutingPartialDagShape shape){
    u64 generation = 0u;
    {
        const GpuTaskGraphDeclarationReadView view = GpuTaskGraphDeclarationReadView(graph);
        generation = view.generation();
    }
    Vector<GpuTaskId> dependencies = Vector<GpuTaskId>();
    dependencies.reserve(taskCount);
    for(usize taskIndex = 0u; taskIndex < taskCount; ++taskIndex){
        dependencies.clear();
        if(shape == GpuRoutingPartialDagShape::ReversedPairs && taskIndex % 2u != 0u && taskIndex + 1u < taskCount)
            GpuRoutingPushTaskDependency(dependencies, generation, taskIndex + 1u);
        else if(
            (shape == GpuRoutingPartialDagShape::OneEdge && taskIndex == 1u)
            || ((shape == GpuRoutingPartialDagShape::DisjointPairs || shape == GpuRoutingPartialDagShape::MergedPairs) && taskIndex % 2u != 0u)
            || (shape == GpuRoutingPartialDagShape::TotalOrder && taskIndex != 0u)
        )
            GpuRoutingPushTaskDependency(dependencies, generation, taskIndex - 1u);
        else if(shape == GpuRoutingPartialDagShape::ConnectedBranches && taskIndex != 0u)
            GpuRoutingPushTaskDependency(dependencies, generation, (taskIndex - 1u) / 2u);
        else if(shape == GpuRoutingPartialDagShape::FanOut && taskIndex != 0u)
            GpuRoutingPushTaskDependency(dependencies, generation, 0u);
        else if(shape == GpuRoutingPartialDagShape::FanIn && taskIndex + 1u == taskCount){
            for(usize source = 0u; source < taskIndex; ++source)
                GpuRoutingPushTaskDependency(dependencies, generation, source);
        }
        else if(shape == GpuRoutingPartialDagShape::DenseLayers && taskIndex >= s_GpuRoutingLayerSize){
            const usize previousLayer = (taskIndex / s_GpuRoutingLayerSize - 1u) * s_GpuRoutingLayerSize;
            for(usize offset = 0u; offset < s_GpuRoutingLayerSize; ++offset)
                GpuRoutingPushTaskDependency(dependencies, generation, previousLayer + offset);
        }
        GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
        scheduling.cost = cast<GpuTaskCostHintEnum>(taskIndex % cast<usize>(GpuTaskCostHint::Count));
        scheduling.mergeWithPrevious = shape == GpuRoutingPartialDagShape::MergedPairs && taskIndex % 2u != 0u;
        b8 graphicsTask = false;
        if(shape == GpuRoutingPartialDagShape::MergedPairs)
            graphicsTask = (taskIndex / 2u) % 2u == 0u;
        else
            graphicsTask = taskIndex % 2u == 0u;
        GpuTaskCommandRequirements commands = ComputeCommands();
        if(graphicsTask)
            commands = GraphicsCommands();
        const Expected<Name> derivedNameResult = IndexedName(s_GpuCaseQueuePartialDag, taskIndex);
        ASSERT_TRUE(derivedNameResult.has_value());
        const Expected<GpuTaskId> taskResult = AddTaskWithCommands(
            derivedNameResult.value(),
            "Partial DAG Task",
            commands,
            scheduling,
            GpuTaskTimingMetadata(),
            dependencies,
            graph
        );
        ASSERT_TRUE(taskResult.has_value());
        const GpuTaskId task = taskResult.value();
        ASSERT_TRUE(task.valid());
    }
}

b8 GpuRoutingExpectedPartialDagReach(in GpuRoutingPartialDagShape shape, in usize source, in usize destination){
    if(source == destination)
        return false;
    switch(shape){
    case GpuRoutingPartialDagShape::ReversedPairs:
        return source != 0u && source % 2u == 0u && destination + 1u == source;
    case GpuRoutingPartialDagShape::DenseLayers:
        return source / s_GpuRoutingLayerSize < destination / s_GpuRoutingLayerSize;
    case GpuRoutingPartialDagShape::OneEdge:
        return source == 0u && destination == 1u;
    case GpuRoutingPartialDagShape::TotalOrder:
        return source < destination;
    default:
        return false;
    }
}

void GpuRoutingCheckIndexedScores<const usize TaskCount>(in GpuRoutingPartialDagShape shape){
    const ScopedTestTrace shapeTrace = ScopedTestTrace(cast<u32>(shape));
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    ScratchArena declarationScratch = ScratchArena(s_TaskGraphScratchArena);
    ASSERT_NO_FATAL_FAILURE(GpuRoutingDeclarePartialDag(graph, TaskCount, shape));
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    ASSERT_TRUE(Analyze(graph, declarationScratch, analysis));
    GpuPhysicalQueueInfo auxiliary = GraphicsQueue(311u);
    auxiliary.queueIndex = 1u;
    Array<GpuPhysicalQueueInfo, 3> queues = Array<GpuPhysicalQueueInfo, 3>();
    queues[0u] = GraphicsQueue(17u);
    queues[1u] = DedicatedComputeQueue(29u);
    queues[2u] = auxiliary;
    const GpuPhysicalQueueTopology topology = MakeGpuRoutingTopology(queues);
    const GpuTaskGraphDeclarationReadView view = GpuTaskGraphDeclarationReadView(graph);
    ASSERT_EQ(view.taskCount(), TaskCount);

    native(in testArena, in view, in analysis, mut queues, in topology){
        Core::Alloc::ScratchArena scratch(s_TaskGraphScratchArena);
        GpuTaskSchedulingReachability reachability(scratch);
        ASSERT_TRUE(BuildGpuTaskSchedulingReachability(view, analysis, reachability));
        GpuTaskQueueScoringData scoringData(view, analysis, reachability, {}, scratch);
        Core::GraphicsVector<Core::GpuTaskQueueAssignment> assignments(testArena.arena);
        Core::GraphicsVector<u32> indices(TaskCount, Limit<u32>::s_Max, testArena.arena);
        for(const Core::GpuTaskId task : analysis.topologicalOrder()){
            indices[task.index] = static_cast<u32>(assignments.size());
            const auto queue = queues[task.index % LengthOf(queues)].id;
            assignments.push_back({ .task = task, .initialQueue = queue, .queue = queue, .score = {} });
        }
        scoringData.rebuildAssignmentLoads(assignments, topology);
        Vector<GpuTaskQueuePlacementGroup, Core::Alloc::ScratchArena> groups(scratch);
        ASSERT_TRUE(BuildQueuePlacementGroups(view, analysis, topology, scratch, groups));

        // Scalar Floyd-Warshall is independent of packed rows, word bounds, and queue-cost membership.
        Vector<Array<b8, TaskCount>, Core::Alloc::ScratchArena> reachable(TaskCount, scratch);
        for(const auto& edge : analysis.schedulingEdges())
            reachable[edge.producer.index][edge.consumer.index] = true;
        for(usize intermediate = 0u; intermediate < TaskCount; ++intermediate)
            for(usize source = 0u; source < TaskCount; ++source)
                for(usize destination = 0u; destination < TaskCount; ++destination)
                    reachable[source][destination] = reachable[source][destination] || (reachable[source][intermediate] && reachable[intermediate][destination]);
        for(usize source = 0u; source < TaskCount; ++source){
            for(usize destination = 0u; destination < TaskCount; ++destination){
                EXPECT_EQ(reachability.reaches(view.taskAt(source).id, view.taskAt(destination).id), reachable[source][destination]);
                EXPECT_EQ(
                    reachability.transitivelyIndependent(view.taskAt(source).id, view.taskAt(destination).id),
                    source != destination && !reachable[source][destination] && !reachable[destination][source]
                );
            }
        }
        const auto referenceOverlap = [&](const GpuTaskQueuePlacementGroup& group, const Core::GpuPhysicalQueueId queue)noexcept{
            u64 overlap = 0u;
            for(usize row = 0u; row < assignments.size(); ++row){
                if(row >= group.assignmentOffset && row - group.assignmentOffset < group.assignmentCount)
                    continue;
                const auto& other = assignments[row];
                if(other.queue == queue)
                    continue;
                b8 independent = true;
                for(usize offset = 0u; offset < group.assignmentCount; ++offset){
                    const usize member = assignments[group.assignmentOffset + offset].task.index;
                    independent = independent && !reachable[member][other.task.index] && !reachable[other.task.index][member];
                }
                if(independent)
                    overlap += QueueCostWeight(view.taskAt(other.task.index).scheduling.cost);
            }
            return static_cast<i32>(overlap);
        };
        const auto expectScores = [&](){
            for(const auto& candidate : queues){
                for(usize row = 0u; row < assignments.size(); ++row){
                    const auto& task = assignments[row].task;
                    const Core::GpuQueueAssignmentScore score = BuildQueueAssignmentScore(view, analysis, assignments, indices, topology, reachability, scoringData, view.taskAt(task.index), candidate);
                    GpuTaskQueuePlacementGroup singleton;
                    singleton.assignmentOffset = row;
                    singleton.assignmentCount = 1u;
                    EXPECT_EQ(score.overlap, referenceOverlap(singleton, candidate.id));
                }
                for(const auto& group : groups){
                    const Core::GpuQueueAssignmentScore score = BuildQueuePlacementGroupScore(view, analysis, assignments, indices, topology, reachability, scoringData, group, candidate);
                    EXPECT_EQ(score.overlap, referenceOverlap(group, candidate.id));
                }
            }
        };
        expectScores();
        // Change all three queue masks incrementally, including tasks across bitset words.
        for(usize row = 0u; row < assignments.size(); row += 5u){
            auto& assignment = assignments[row];
            const auto destination = queues[(row + 1u) % LengthOf(queues)].id;
            scoringData.updateAssignmentLoads(assignment.task, assignment.queue, destination);
            assignment.queue = destination;
        }
        expectScores();
        Swap(queues[0u], queues[2u]);
        scoringData.rebuildAssignmentLoads(assignments, topology);
        expectScores();
        Core::GraphicsVector<Core::GpuTaskQueueAssignment> empty(testArena.arena);
        scoringData.rebuildAssignmentLoads(empty, topology);
        EXPECT_EQ(scoringData.totalAssignedCost, 0u);
        scoringData.rebuildAssignmentLoads(assignments, topology);
        expectScores();
    }
}

void GpuRoutingRunCrossFamilySameClassCase(
    in GpuQueueCapabilityMask capabilities,
    in GpuPhysicalQueueInfo primaryQueue,
    in GpuPhysicalQueueInfo auxiliaryQueue,
    in Name resourceIdentity,
    in Name producerIdentity,
    in Name consumerIdentity
){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuGraphResourceId> bufferResult = AddBufferMetadata(graph, resourceIdentity, s_GpuRoutingCrossFamilyBufferLabel);
    ASSERT_TRUE(bufferResult.has_value());
    const GpuGraphResourceId buffer = bufferResult.value();
    ASSERT_TRUE(buffer.valid());

    GpuTaskCommandRequirements commands = GpuTaskCommandRequirements();
    commands.requiredCapabilities = capabilities;

    GpuTaskSchedulingHint producerScheduling = GpuTaskSchedulingHint();
    producerScheduling.cost = GpuTaskCostHint::Large;
    producerScheduling.allowSameClassQueueRouting = true;
    producerScheduling.allowCrossFamilySameClassQueueRouting = true;
    Array<GpuTaskResourceUse, 1> producerUses = Array<GpuTaskResourceUse, 1>();
    producerUses[0u].resource = buffer;
    producerUses[0u].requiredState = ResourceStates::CopyDest;
    producerUses[0u].access = GpuTaskResourceAccess::Write;
    GpuTaskDesc producerDesc = GpuTaskDesc();
    producerDesc.setIdentity(producerIdentity);
    producerDesc.setMarkerLabel(s_GpuRoutingCrossFamilyProducerLabel);
    producerDesc.setScheduling(producerScheduling);
    producerDesc.setResourceUses(producerUses);
    const Expected<GpuTaskId> producerResult = graph.addTask(producerDesc, commands);
    ASSERT_TRUE(producerResult.has_value());
    const GpuTaskId producer = producerResult.value();
    ASSERT_TRUE(producer.valid());

    GpuTaskSchedulingHint consumerScheduling = GpuTaskSchedulingHint();
    consumerScheduling.cost = GpuTaskCostHint::Medium;
    consumerScheduling.allowSameClassQueueRouting = true;
    consumerScheduling.allowCrossFamilySameClassQueueRouting = true;
    Array<GpuTaskId, 1> consumerDependencies = Array<GpuTaskId, 1>();
    consumerDependencies[0u] = producer;
    Array<GpuTaskResourceUse, 1> consumerUses = Array<GpuTaskResourceUse, 1>();
    consumerUses[0u].resource = buffer;
    consumerUses[0u].requiredState = ResourceStates::CopySource;
    consumerUses[0u].access = GpuTaskResourceAccess::Read;
    GpuTaskDesc consumerDesc = GpuTaskDesc();
    consumerDesc.setIdentity(consumerIdentity);
    consumerDesc.setMarkerLabel(s_GpuRoutingCrossFamilyConsumerLabel);
    consumerDesc.setScheduling(consumerScheduling);
    consumerDesc.setDependencies(consumerDependencies);
    consumerDesc.setResourceUses(consumerUses);
    const Expected<GpuTaskId> consumerResult = graph.addTask(consumerDesc, commands);
    ASSERT_TRUE(consumerResult.has_value());
    const GpuTaskId consumer = consumerResult.value();
    ASSERT_TRUE(consumer.valid());

    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = primaryQueue;
    queues[1u] = auxiliaryQueue;
    const GpuPhysicalQueueTopology topology = MakeGpuRoutingTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(Compile(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

    native(in assignments, in compiledPlan, in producer, in consumer, in primaryQueue, in auxiliaryQueue, in buffer){
        const Core::GpuTaskQueueAssignment* const producerAssignment = assignments.find(producer);
        const Core::GpuTaskQueueAssignment* const consumerAssignment = assignments.find(consumer);
        const Core::GpuCompiledTask* const compiledProducer = compiledPlan.findTask(producer).plan;
        const Core::GpuCompiledTask* const compiledConsumer = compiledPlan.findTask(consumer).plan;
        ASSERT_NE(producerAssignment, nullptr);
        ASSERT_NE(consumerAssignment, nullptr);
        ASSERT_NE(compiledProducer, nullptr);
        ASSERT_NE(compiledConsumer, nullptr);
        EXPECT_EQ(producerAssignment->queue, primaryQueue.id);
        EXPECT_EQ(consumerAssignment->queue, auxiliaryQueue.id);
        const Core::GpuSubmissionPacketId producerPacket = compiledPlan.packetForTask(producer);
        const Core::GpuSubmissionPacketId consumerPacket = compiledPlan.packetForTask(consumer);
        ASSERT_TRUE(producerPacket.valid());
        ASSERT_TRUE(consumerPacket.valid());
        EXPECT_NE(compiledPlan.packet(producerPacket).plan->queue, compiledPlan.packet(consumerPacket).plan->queue);
        ASSERT_EQ(compiledPlan.packet(consumerPacket).plan->dependencyCount, 1u);
        EXPECT_EQ(compiledPlan.packet(consumerPacket).dependencies[0u].producer, producerPacket);
        EXPECT_EQ(compiledProducer->queue, primaryQueue.id);
        EXPECT_EQ(compiledConsumer->queue, auxiliaryQueue.id);
        ASSERT_EQ(compiledProducer->epilogueBarrierCount, 1u);
        ASSERT_EQ(compiledConsumer->prologueStateSeedCount, 1u);
        ASSERT_EQ(compiledConsumer->prologueBarrierCount, 2u);

        const Core::GpuCompiledBarrier* const release = compiledPlan.findTask(producer).epilogueBarriers;
        const Core::GpuCompiledBarrier* const acquireAndTransition = compiledPlan.findTask(consumer).prologueBarriers;
        ASSERT_NE(release, nullptr);
        ASSERT_NE(acquireAndTransition, nullptr);
        EXPECT_EQ(release[0u].type, Core::GpuCompiledBarrierType::BufferOwnershipRelease);
        EXPECT_EQ(release[0u].resource, buffer);
        EXPECT_EQ(release[0u].sourceQueue, primaryQueue.id);
        EXPECT_EQ(release[0u].destinationQueue, auxiliaryQueue.id);
        EXPECT_EQ(acquireAndTransition[0u].type, Core::GpuCompiledBarrierType::BufferOwnershipAcquire);
        EXPECT_EQ(acquireAndTransition[0u].resource, buffer);
        EXPECT_EQ(acquireAndTransition[0u].sourceQueue, primaryQueue.id);
        EXPECT_EQ(acquireAndTransition[0u].destinationQueue, auxiliaryQueue.id);
        EXPECT_EQ(acquireAndTransition[1u].type, Core::GpuCompiledBarrierType::BufferTransition);
    }
}

void VerifyGpuRouting_PlansExclusiveOwnershipHandoffToDedicatedTransfer(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<TransferOwnershipPair> pairResult = AddTransferOwnershipPair(graph, ResourceQueueSharing::Exclusive);
    ASSERT_TRUE(pairResult.has_value());
    const TransferOwnershipPair pair = pairResult.value();
    ASSERT_TRUE(pair.texture.valid());
    ASSERT_TRUE(pair.producer.valid());
    ASSERT_TRUE(pair.consumer.valid());

    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedTransferQueue();
    const GpuPhysicalQueueTopology topology = MakeGpuRoutingTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    {
        const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);
        native(in compiledPlan, in pair, in queues){
            const Core::GpuCompiledTaskView compiledProducerView = compiledPlan.findTask(pair.producer);
            const Core::GpuCompiledTaskView compiledConsumerView = compiledPlan.findTask(pair.consumer);
            const Core::GpuCompiledTask* const compiledProducer = compiledProducerView.plan;
            const Core::GpuCompiledTask* const compiledConsumer = compiledConsumerView.plan;
            ASSERT_NE(compiledProducer, nullptr);
            ASSERT_NE(compiledConsumer, nullptr);
            const Core::GpuPhysicalQueueInfo* const consumerQueue = compiledPlan.queueInfo(compiledConsumer->queue);
            ASSERT_NE(consumerQueue, nullptr);
            EXPECT_EQ(consumerQueue->queueClass, Core::CommandQueue::Transfer);
            ASSERT_EQ(compiledProducer->epilogueBarrierCount, 1u);
            ASSERT_EQ(compiledConsumer->prologueBarrierCount, 2u);
            ASSERT_EQ(compiledConsumer->prologueStateSeedCount, 1u);

            const Core::GpuCompiledBarrier* const release = compiledProducerView.epilogueBarriers;
            const Core::GpuCompiledBarrier* const acquire = compiledConsumerView.prologueBarriers;
            const Core::GpuPacketStateSeed* const stateSeed = compiledConsumerView.prologueStateSeeds;
            ASSERT_NE(release, nullptr);
            ASSERT_NE(acquire, nullptr);
            ASSERT_NE(stateSeed, nullptr);
            EXPECT_EQ(release[0u].type, Core::GpuCompiledBarrierType::TextureOwnershipRelease);
            EXPECT_EQ(release[0u].resource, pair.texture);
            EXPECT_EQ(release[0u].before, Core::ResourceStates::CopySource);
            EXPECT_EQ(release[0u].after, Core::ResourceStates::CopySource);
            EXPECT_EQ(release[0u].sourceQueue, compiledProducer->queue);
            EXPECT_EQ(release[0u].destinationQueue, compiledConsumer->queue);
            EXPECT_FALSE(release[0u].forceMemoryDependency);
            EXPECT_EQ(acquire[0u].type, Core::GpuCompiledBarrierType::TextureOwnershipAcquire);
            EXPECT_EQ(acquire[0u].resource, pair.texture);
            EXPECT_EQ(acquire[0u].sourceQueue, compiledProducer->queue);
            EXPECT_EQ(acquire[0u].destinationQueue, compiledConsumer->queue);
            EXPECT_FALSE(acquire[0u].isInitialOwnerHandoff);
            EXPECT_FALSE(acquire[0u].forceMemoryDependency);
            EXPECT_EQ(acquire[1u].type, Core::GpuCompiledBarrierType::TextureTransition);
            EXPECT_EQ(acquire[1u].resource, pair.texture);
            EXPECT_EQ(acquire[1u].before, Core::ResourceStates::CopySource);
            EXPECT_EQ(acquire[1u].after, Core::ResourceStates::CopySource);
            EXPECT_EQ(acquire[1u].sourceQueue, compiledProducer->queue);
            EXPECT_EQ(acquire[1u].destinationQueue, compiledConsumer->queue);
            EXPECT_FALSE(acquire[1u].isGraphInitialState);
            EXPECT_FALSE(acquire[1u].isInitialOwnerHandoff);
            EXPECT_TRUE(acquire[1u].forceMemoryDependency);
            EXPECT_EQ(stateSeed[0u].resource, pair.texture);
            EXPECT_EQ(stateSeed[0u].sourcePacket, compiledProducer->packet);

            const Core::GpuTaskGraphPhysicalQueueCompileStatistics producerQueueCompileStatistics = compiledPlan.physicalQueueCompileStatistics(compiledProducer->queue);
            const Core::GpuTaskGraphPhysicalQueueCompileStatistics consumerQueueCompileStatistics = compiledPlan.physicalQueueCompileStatistics(compiledConsumer->queue);
            ASSERT_TRUE(producerQueueCompileStatistics.valid());
            ASSERT_TRUE(consumerQueueCompileStatistics.valid());
            EXPECT_EQ(producerQueueCompileStatistics.ownershipReleaseBarrierCount, 1u);
            EXPECT_EQ(producerQueueCompileStatistics.ownershipAcquireBarrierCount, 0u);
            EXPECT_EQ(consumerQueueCompileStatistics.ownershipReleaseBarrierCount, 0u);
            EXPECT_EQ(consumerQueueCompileStatistics.ownershipAcquireBarrierCount, 1u);

            ASSERT_EQ(compiledPlan.logicalOwnershipTransferCount(), 1u);
            const Core::GpuCompiledOwnershipTransfer* const ownershipTransfers = compiledPlan.logicalOwnershipTransfers();
            ASSERT_NE(ownershipTransfers, nullptr);
            EXPECT_EQ(compiledPlan.logicalOwnershipTransferAt(0u), ownershipTransfers);
            EXPECT_EQ(compiledPlan.logicalOwnershipTransferAt(1u), nullptr);
            const Core::GpuCompiledOwnershipTransfer& ownershipTransfer = ownershipTransfers[0u];
            EXPECT_TRUE(ownershipTransfer.valid());
            EXPECT_EQ(ownershipTransfer.resource, pair.texture);
            EXPECT_EQ(ownershipTransfer.resourceIdentity, Name("tests/task_graph/transfer_ownership_texture"));
            EXPECT_EQ(ownershipTransfer.range.textureSubresources, Core::s_AllSubresources);
            EXPECT_EQ(ownershipTransfer.sourceTask, pair.producer);
            EXPECT_EQ(ownershipTransfer.destinationTask, pair.consumer);
            EXPECT_EQ(ownershipTransfer.sourcePacket, compiledProducer->packet);
            EXPECT_EQ(ownershipTransfer.destinationPacket, compiledConsumer->packet);
            EXPECT_EQ(ownershipTransfer.sourceQueue, compiledProducer->queue);
            EXPECT_EQ(ownershipTransfer.destinationQueue, compiledConsumer->queue);
            EXPECT_EQ(ownershipTransfer.sourceQueueFamilyIndex, queues[0u].familyIndex);
            EXPECT_EQ(ownershipTransfer.destinationQueueFamilyIndex, queues[1u].familyIndex);
            EXPECT_EQ(ownershipTransfer.declaredQueueSharing, Core::ResourceQueueSharing::Exclusive);
            EXPECT_EQ(ownershipTransfer.resourceType, Core::GpuGraphResourceType::Texture);
            EXPECT_EQ(ownershipTransfer.route, Core::GpuOwnershipTransferRoute::Internal);
            EXPECT_TRUE(ownershipTransfer.concurrentSharingCouldAvoid);
            const Core::GpuTaskGraphCompileStatistics ownershipStatistics = compiledPlan.compileStatistics();
            ASSERT_TRUE(ownershipStatistics.valid());
            EXPECT_EQ(ownershipStatistics.logicalOwnershipTransferCount, 1u);
            EXPECT_EQ(ownershipStatistics.logicalOwnershipTransferSignatureCount, 1u);
            EXPECT_EQ(ownershipStatistics.repeatedOwnershipTransferSignatureCount, 0u);
            EXPECT_EQ(ownershipStatistics.concurrentSharingCouldAvoidTransferCount, 1u);
            EXPECT_EQ(ownershipStatistics.concurrentSharingAdviceResourceCount, 0u);
            EXPECT_EQ(ownershipStatistics.logicalOwnershipTransferCountByRoute[Core::GpuOwnershipTransferRoute::Internal], 1u);

            const Core::GpuCompiledPacketView consumerPacketView = compiledPlan.packet(compiledConsumer->packet);
            ASSERT_TRUE(consumerPacketView.valid());
            ASSERT_EQ(consumerPacketView.plan->dependencyCount, 1u);
            EXPECT_EQ(consumerPacketView.dependencies[0u].producer, compiledProducer->packet);
        }
    }

    compiledGraph.reset();
    {
        const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

        EXPECT_EQ(compiledPlan.logicalOwnershipTransferCount(), 0u);
        native(in compiledPlan){
            EXPECT_EQ(compiledPlan.logicalOwnershipTransfers(), nullptr);
            EXPECT_EQ(compiledPlan.logicalOwnershipTransferAt(0u), nullptr);
        }
    }

    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    {
        const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

        ASSERT_EQ(compiledPlan.logicalOwnershipTransferCount(), 1u);
    }
    const GpuPhysicalQueueTopology invalidTopology = GpuPhysicalQueueTopology();
    EXPECT_FALSE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, invalidTopology));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

    EXPECT_FALSE(compiledPlan.valid());
    EXPECT_EQ(compiledPlan.logicalOwnershipTransferCount(), 0u);
    native(in compiledPlan){
        EXPECT_EQ(compiledPlan.logicalOwnershipTransfers(), nullptr);
        EXPECT_EQ(compiledPlan.logicalOwnershipTransferAt(0u), nullptr);
    }
}

void VerifyGpuRouting_ReportsOwnershipRangesWithoutReleaseAcquireDuplicates(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<GpuGraphResourceId> textureResult = AddTextureMetadata(
        graph,
        s_GpuCaseTaskGraphMultiRangeOwnershipTexture,
        "Multi-Range Ownership Texture",
        ResourceStates::Common,
        ResourceQueueSharing::Exclusive
    );
    ASSERT_TRUE(textureResult.has_value());
    const GpuGraphResourceId texture = textureResult.value();
    ASSERT_TRUE(texture.valid());

    GpuTaskResourceRange firstRange = GpuTaskResourceRange();
    firstRange.textureSubresources = TextureSubresourceSet(0u, 1u, 0u, 1u);
    GpuTaskResourceRange secondRange = GpuTaskResourceRange();
    secondRange.textureSubresources = TextureSubresourceSet(2u, 1u, 0u, 1u);
    Array<GpuTaskResourceUse, 2> producerUses = Array<GpuTaskResourceUse, 2>();
    producerUses[0u].resource = texture;
    producerUses[0u].range = firstRange;
    producerUses[0u].requiredState = ResourceStates::CopySource;
    producerUses[0u].access = GpuTaskResourceAccess::Write;
    producerUses[1u].resource = texture;
    producerUses[1u].range = secondRange;
    producerUses[1u].requiredState = ResourceStates::CopySource;
    producerUses[1u].access = GpuTaskResourceAccess::Write;
    Array<GpuTaskResourceUse, 2> consumerUses = Array<GpuTaskResourceUse, 2>();
    consumerUses[0u].resource = texture;
    consumerUses[0u].range = firstRange;
    consumerUses[0u].requiredState = ResourceStates::CopySource;
    consumerUses[0u].access = GpuTaskResourceAccess::Read;
    consumerUses[1u].resource = texture;
    consumerUses[1u].range = secondRange;
    consumerUses[1u].requiredState = ResourceStates::CopySource;
    consumerUses[1u].access = GpuTaskResourceAccess::Read;

    GpuTaskSchedulingHint scheduling = GpuTaskSchedulingHint();
    scheduling.forceSubmissionBoundary = true;
    scheduling.allowPacketMerge = false;
    GpuTaskDesc producerDesc = GpuTaskDesc();
    producerDesc.setIdentity(s_GpuCaseTaskGraphMultiRangeOwnershipProducer);
    producerDesc.setMarkerLabel("Multi-Range Ownership Producer");
    producerDesc.setScheduling(scheduling);
    producerDesc.setResourceUses(producerUses);
    GpuTaskDesc consumerDesc = GpuTaskDesc();
    consumerDesc.setIdentity(s_GpuCaseTaskGraphMultiRangeOwnershipConsumer);
    consumerDesc.setMarkerLabel("Multi-Range Ownership Consumer");
    consumerDesc.setScheduling(scheduling);
    consumerDesc.setResourceUses(consumerUses);
    const Expected<GpuTaskId> producerResult = graph.addTask(producerDesc, GraphicsCommands());
    ASSERT_TRUE(producerResult.has_value());
    const GpuTaskId producer = producerResult.value();
    const Expected<GpuTaskId> consumerResult = graph.addTask(consumerDesc, ComputeCommands());
    ASSERT_TRUE(consumerResult.has_value());
    const GpuTaskId consumer = consumerResult.value();
    ASSERT_TRUE(producer.valid());
    ASSERT_TRUE(consumer.valid());

    Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    const GpuPhysicalQueueTopology topology = MakeGpuRoutingTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

    const GpuTaskGraphCompileStatistics statistics = compiledPlan.compileStatistics();
    ASSERT_TRUE(statistics.valid());
    EXPECT_EQ(statistics.ownershipReleaseBarrierCount, 2u);
    EXPECT_EQ(statistics.ownershipAcquireBarrierCount, 2u);
    EXPECT_EQ(statistics.logicalOwnershipTransferCount, 2u);
    EXPECT_EQ(statistics.logicalOwnershipTransferSignatureCount, 1u);
    EXPECT_EQ(statistics.repeatedOwnershipTransferSignatureCount, 0u);
    EXPECT_EQ(statistics.concurrentSharingCouldAvoidTransferCount, 2u);
    EXPECT_EQ(statistics.concurrentSharingAdviceResourceCount, 0u);

    const GpuTaskGraphPhysicalQueueCompileStatistics producerStatistics = compiledPlan.physicalQueueCompileStatistics(queues[0u].id);
    const GpuTaskGraphPhysicalQueueCompileStatistics consumerStatistics = compiledPlan.physicalQueueCompileStatistics(queues[1u].id);
    ASSERT_TRUE(producerStatistics.valid());
    ASSERT_TRUE(consumerStatistics.valid());
    EXPECT_EQ(producerStatistics.ownershipReleaseBarrierCount, 2u);
    EXPECT_EQ(producerStatistics.ownershipAcquireBarrierCount, 0u);
    EXPECT_EQ(producerStatistics.outgoingLogicalOwnershipTransferCount, 2u);
    EXPECT_EQ(producerStatistics.incomingLogicalOwnershipTransferCount, 0u);
    EXPECT_EQ(producerStatistics.outgoingLogicalOwnershipTransferSignatureCount, 1u);
    EXPECT_EQ(producerStatistics.outgoingRepeatedOwnershipTransferSignatureCount, 0u);
    EXPECT_EQ(producerStatistics.concurrentSharingAdviceResourceCount, 0u);
    EXPECT_EQ(consumerStatistics.ownershipReleaseBarrierCount, 0u);
    EXPECT_EQ(consumerStatistics.ownershipAcquireBarrierCount, 2u);
    EXPECT_EQ(consumerStatistics.outgoingLogicalOwnershipTransferCount, 0u);
    EXPECT_EQ(consumerStatistics.incomingLogicalOwnershipTransferCount, 2u);
    EXPECT_EQ(consumerStatistics.incomingLogicalOwnershipTransferSignatureCount, 1u);
    EXPECT_EQ(consumerStatistics.incomingRepeatedOwnershipTransferSignatureCount, 0u);
    EXPECT_EQ(consumerStatistics.concurrentSharingAdviceResourceCount, 0u);

    ASSERT_EQ(compiledPlan.logicalOwnershipTransferCount(), 2u);
    native(in compiledPlan, in producer, in consumer, in queues, in texture, in firstRange, in secondRange){
        const Core::GpuCompiledTask* const compiledProducer = compiledPlan.findTask(producer).plan;
        const Core::GpuCompiledTask* const compiledConsumer = compiledPlan.findTask(consumer).plan;
        ASSERT_NE(compiledProducer, nullptr);
        ASSERT_NE(compiledConsumer, nullptr);
        EXPECT_EQ(compiledProducer->queue, queues[0u].id);
        EXPECT_EQ(compiledConsumer->queue, queues[1u].id);

        const Core::GpuCompiledOwnershipTransfer* const ownershipTransfers = compiledPlan.logicalOwnershipTransfers();
        ASSERT_NE(ownershipTransfers, nullptr);
        EXPECT_EQ(compiledPlan.logicalOwnershipTransferAt(0u), ownershipTransfers);
        EXPECT_EQ(compiledPlan.logicalOwnershipTransferAt(1u), ownershipTransfers + 1u);
        EXPECT_EQ(compiledPlan.logicalOwnershipTransferAt(2u), nullptr);
        usize firstRangeCount = 0u;
        usize secondRangeCount = 0u;
        for(usize transferIndex = 0u; transferIndex < compiledPlan.logicalOwnershipTransferCount(); ++transferIndex){
            const Core::GpuCompiledOwnershipTransfer& transfer = ownershipTransfers[transferIndex];
            EXPECT_TRUE(transfer.valid());
            EXPECT_EQ(transfer.resource, texture);
            EXPECT_EQ(transfer.resourceIdentity, Name("tests/task_graph/multi_range_ownership_texture"));
            EXPECT_EQ(transfer.sourceTask, producer);
            EXPECT_EQ(transfer.destinationTask, consumer);
            EXPECT_EQ(transfer.sourcePacket, compiledProducer->packet);
            EXPECT_EQ(transfer.destinationPacket, compiledConsumer->packet);
            EXPECT_EQ(transfer.sourceQueue, queues[0u].id);
            EXPECT_EQ(transfer.destinationQueue, queues[1u].id);
            EXPECT_EQ(transfer.sourceQueueFamilyIndex, queues[0u].familyIndex);
            EXPECT_EQ(transfer.destinationQueueFamilyIndex, queues[1u].familyIndex);
            EXPECT_EQ(transfer.declaredQueueSharing, Core::ResourceQueueSharing::Exclusive);
            EXPECT_EQ(transfer.resourceType, Core::GpuGraphResourceType::Texture);
            EXPECT_EQ(transfer.route, Core::GpuOwnershipTransferRoute::Internal);
            EXPECT_TRUE(transfer.concurrentSharingCouldAvoid);
            if(transfer.range.textureSubresources == firstRange.textureSubresources)
                ++firstRangeCount;
            if(transfer.range.textureSubresources == secondRange.textureSubresources)
                ++secondRangeCount;
        }
        EXPECT_EQ(firstRangeCount, 1u);
        EXPECT_EQ(secondRangeCount, 1u);
    }
}

void VerifyGpuRouting_UsesDeclaredTripleQueueSharingForDedicatedTransfer(){
    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<TransferOwnershipPair> pairResult = AddTransferOwnershipPair(graph, ResourceQueueSharing::GraphicsAsyncComputeAndTransfer);
    ASSERT_TRUE(pairResult.has_value());
    const TransferOwnershipPair pair = pairResult.value();
    ASSERT_TRUE(pair.texture.valid());
    ASSERT_TRUE(pair.producer.valid());
    ASSERT_TRUE(pair.consumer.valid());

    native(mut testArena, in graph, in pair){
        ThreeQueueCompile threeQueueCompile(testArena);
        ASSERT_TRUE(threeQueueCompile.compile(graph));
        const Core::GpuCompiledGraph::ReadView compiledPlan(threeQueueCompile.compiledGraph);

        const Core::GpuCompiledTask* const compiledProducer = compiledPlan.findTask(pair.producer).plan;
        const Core::GpuCompiledTask* const compiledConsumer = compiledPlan.findTask(pair.consumer).plan;
        ASSERT_NE(compiledProducer, nullptr);
        ASSERT_NE(compiledConsumer, nullptr);
        EXPECT_EQ(compiledProducer->epilogueBarrierCount, 0u);
        ASSERT_EQ(compiledConsumer->prologueBarrierCount, 1u);
        ASSERT_EQ(compiledConsumer->prologueStateSeedCount, 1u);
        const Core::GpuCompiledBarrier* const dependency = compiledPlan.findTask(pair.consumer).prologueBarriers;
        const Core::GpuPacketStateSeed* const stateSeed = compiledPlan.findTask(pair.consumer).prologueStateSeeds;
        ASSERT_NE(dependency, nullptr);
        ASSERT_NE(stateSeed, nullptr);
        EXPECT_EQ(dependency[0u].type, Core::GpuCompiledBarrierType::TextureTransition);
        EXPECT_EQ(dependency[0u].resource, pair.texture);
        EXPECT_EQ(dependency[0u].before, Core::ResourceStates::CopySource);
        EXPECT_EQ(dependency[0u].after, Core::ResourceStates::CopySource);
        EXPECT_TRUE(dependency[0u].forceMemoryDependency);
        EXPECT_EQ(stateSeed[0u].resource, pair.texture);
        EXPECT_EQ(stateSeed[0u].sourcePacket, compiledProducer->packet);
        EXPECT_EQ(compiledPlan.logicalOwnershipTransferCount(), 0u);
        EXPECT_EQ(compiledPlan.logicalOwnershipTransfers(), nullptr);
        EXPECT_EQ(compiledPlan.logicalOwnershipTransferAt(0u), nullptr);
        const Core::GpuTaskGraphCompileStatistics& statistics = compiledPlan.compileStatistics();
        ASSERT_TRUE(statistics.valid());
        EXPECT_EQ(statistics.ownershipReleaseBarrierCount, 0u);
        EXPECT_EQ(statistics.ownershipAcquireBarrierCount, 0u);
        EXPECT_EQ(statistics.logicalOwnershipTransferCount, 0u);
        EXPECT_EQ(statistics.logicalOwnershipTransferSignatureCount, 0u);
        EXPECT_EQ(statistics.concurrentSharingCouldAvoidTransferCount, 0u);
        EXPECT_EQ(statistics.concurrentSharingAdviceResourceCount, 0u);
    }
}

void VerifyGpuRouting_OmitsOwnershipTelemetryForSameFamilyAndSamePhysicalRoutes(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<TransferOwnershipPair> pairResult = AddTransferOwnershipPair(graph, ResourceQueueSharing::Exclusive);
    ASSERT_TRUE(pairResult.has_value());
    const TransferOwnershipPair pair = pairResult.value();
    ASSERT_TRUE(pair.texture.valid());
    ASSERT_TRUE(pair.producer.valid());
    ASSERT_TRUE(pair.consumer.valid());

    {
        Array<GpuPhysicalQueueInfo, 1> singleQueues = Array<GpuPhysicalQueueInfo, 1>();
        singleQueues[0u] = GraphicsQueue();
        const GpuPhysicalQueueTopology topology = MakeGpuRoutingTopology(singleQueues);
        GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
        GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
        GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
        ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
        const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);
        native(in compiledPlan, in pair, in singleQueues){
            const Core::GpuCompiledTask* const compiledProducer = compiledPlan.findTask(pair.producer).plan;
            const Core::GpuCompiledTask* const compiledConsumer = compiledPlan.findTask(pair.consumer).plan;
            ASSERT_NE(compiledProducer, nullptr);
            ASSERT_NE(compiledConsumer, nullptr);
            EXPECT_EQ(compiledProducer->queue, singleQueues[0u].id);
            EXPECT_EQ(compiledConsumer->queue, singleQueues[0u].id);
            EXPECT_EQ(compiledPlan.logicalOwnershipTransfers(), nullptr);
            EXPECT_EQ(compiledPlan.logicalOwnershipTransferAt(0u), nullptr);
        }
        EXPECT_EQ(compiledPlan.logicalOwnershipTransferCount(), 0u);
        EXPECT_EQ(compiledPlan.compileStatistics().ownershipReleaseBarrierCount, 0u);
        EXPECT_EQ(compiledPlan.compileStatistics().ownershipAcquireBarrierCount, 0u);
    }

    {
        GpuPhysicalQueueInfo sameFamilyTransferQueue = DedicatedTransferQueue();
        sameFamilyTransferQueue.familyIndex = GraphicsQueue().familyIndex;
        sameFamilyTransferQueue.queueIndex = 1u;
        Array<GpuPhysicalQueueInfo, 2> queues = Array<GpuPhysicalQueueInfo, 2>();
        queues[0u] = GraphicsQueue();
        queues[1u] = sameFamilyTransferQueue;
        const GpuPhysicalQueueTopology topology = MakeGpuRoutingTopology(queues);
        GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
        GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
        GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
        ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
        const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);
        native(in compiledPlan, in pair, in queues){
            const Core::GpuCompiledTask* const compiledProducer = compiledPlan.findTask(pair.producer).plan;
            const Core::GpuCompiledTask* const compiledConsumer = compiledPlan.findTask(pair.consumer).plan;
            ASSERT_NE(compiledProducer, nullptr);
            ASSERT_NE(compiledConsumer, nullptr);
            EXPECT_EQ(compiledProducer->queue, queues[0u].id);
            EXPECT_EQ(compiledConsumer->queue, queues[1u].id);
            EXPECT_NE(compiledProducer->queue, compiledConsumer->queue);
            EXPECT_EQ(compiledPlan.logicalOwnershipTransfers(), nullptr);
            EXPECT_EQ(compiledPlan.logicalOwnershipTransferAt(0u), nullptr);
        }
        EXPECT_EQ(queues[0u].familyIndex, queues[1u].familyIndex);
        EXPECT_EQ(compiledPlan.logicalOwnershipTransferCount(), 0u);
        EXPECT_EQ(compiledPlan.compileStatistics().ownershipReleaseBarrierCount, 0u);
        EXPECT_EQ(compiledPlan.compileStatistics().ownershipAcquireBarrierCount, 0u);
    }
}

void VerifyGpuRouting_LogicalSharingRequiresTwoSelectedFamiliesAcrossEveryMaskAndTopologyOrder(){
    Array<ResourceQueueSharingMask, 8> sharingMasks = Array<ResourceQueueSharingMask, 8>();
    sharingMasks[0u] = ResourceQueueSharing::Exclusive;
    sharingMasks[1u] = ResourceQueueSharing::Graphics;
    sharingMasks[2u] = ResourceQueueSharing::AsyncCompute;
    sharingMasks[3u] = ResourceQueueSharing::Transfer;
    sharingMasks[4u] = ResourceQueueSharing::GraphicsAndAsyncCompute;
    sharingMasks[5u] = ResourceQueueSharing::GraphicsAndTransfer;
    sharingMasks[6u] = ResourceQueueSharing::AsyncComputeAndTransfer;
    sharingMasks[7u] = ResourceQueueSharing::GraphicsAsyncComputeAndTransfer;

    Array<CommandQueueEnum, 4> splitClasses = Array<CommandQueueEnum, 4>();
    splitClasses[0u] = CommandQueue::kCount;
    splitClasses[1u] = CommandQueue::Graphics;
    splitClasses[2u] = CommandQueue::Compute;
    splitClasses[3u] = CommandQueue::Transfer;

    Array<b8, 2> reversedCases = Array<b8, 2>();
    reversedCases[0u] = false;
    reversedCases[1u] = true;

    for(in ResourceQueueSharingMask sharing : sharingMasks){
        const ScopedTestTrace traceSharing = ScopedTestTrace(cast<u32>(sharing));
        for(in CommandQueueEnum splitClass : splitClasses){
            const ScopedTestTrace traceSplit = ScopedTestTrace(cast<u32>(splitClass));
            Array<GpuPhysicalQueueInfo, 6> queues = Array<GpuPhysicalQueueInfo, 6>();
            queues[0u] = GraphicsQueue(0u);
            queues[1u] = DedicatedComputeQueue(1u);
            queues[2u] = DedicatedTransferQueue(2u);
            queues[3u] = GraphicsQueue(3u);
            queues[4u] = DedicatedComputeQueue(4u);
            queues[5u] = DedicatedTransferQueue(5u);
            for(usize queueIndex = 0u; queueIndex < 6u; ++queueIndex){
                if(queueIndex >= 3u && queues[queueIndex].queueClass == splitClass)
                    queues[queueIndex].familyIndex = 1u;
                else
                    queues[queueIndex].familyIndex = 0u;
                queues[queueIndex].queueIndex = cast<u32>(queueIndex);
            }
            for(in b8 reversed : reversedCases){
                const ScopedTestTrace traceReversed = ScopedTestTrace(reversed);
                Array<GpuPhysicalQueueInfo, 6> orderedQueues = Array<GpuPhysicalQueueInfo, 6>();
                for(usize queueIndex = 0u; queueIndex < 6u; ++queueIndex){
                    if(reversed)
                        orderedQueues[queueIndex] = queues[5u - queueIndex];
                    else
                        orderedQueues[queueIndex] = queues[queueIndex];
                }
                const GpuPhysicalQueueTopology topology = MakeGpuRoutingTopology(orderedQueues);
                ASSERT_TRUE(IsValidQueueTopology(topology));
                GpuTaskGraphResourceView resource = GpuTaskGraphResourceView();
                resource.type = GpuGraphResourceType::Buffer;
                resource.queueSharing = sharing;
                const b8 expectedConcurrent = GpuRoutingSharingIncludesQueueClass(sharing, splitClass);
                EXPECT_EQ(ResourceUsesConcurrentQueueSharing(resource, topology), expectedConcurrent);
            }
        }
    }
}

void VerifyGpuRouting_AcceptsDedicatedTransferClassOnAConcurrentlySharedComputeFamily(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<TransferOwnershipPair> pairResult = AddTransferOwnershipPair(graph, ResourceQueueSharing::GraphicsAndAsyncCompute);
    ASSERT_TRUE(pairResult.has_value());
    const TransferOwnershipPair pair = pairResult.value();
    ASSERT_TRUE(pair.texture.valid());
    ASSERT_TRUE(pair.producer.valid());
    ASSERT_TRUE(pair.consumer.valid());

    GpuPhysicalQueueInfo transferOnComputeFamily = DedicatedTransferQueue();
    transferOnComputeFamily.familyIndex = DedicatedComputeQueue().familyIndex;
    transferOnComputeFamily.queueIndex = 1u;
    Array<GpuPhysicalQueueInfo, 3> queues = Array<GpuPhysicalQueueInfo, 3>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    queues[2u] = transferOnComputeFamily;
    const GpuPhysicalQueueTopology topology = MakeGpuRoutingTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    ASSERT_TRUE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

    native(in assignments, in compiledPlan, in pair, in transferOnComputeFamily){
        const Core::GpuTaskQueueAssignment* const consumerAssignment = assignments.find(pair.consumer);
        const Core::GpuCompiledTask* const compiledProducer = compiledPlan.findTask(pair.producer).plan;
        const Core::GpuCompiledTask* const compiledConsumer = compiledPlan.findTask(pair.consumer).plan;
        ASSERT_NE(consumerAssignment, nullptr);
        ASSERT_NE(compiledProducer, nullptr);
        ASSERT_NE(compiledConsumer, nullptr);
        EXPECT_EQ(consumerAssignment->queue, transferOnComputeFamily.id);
        EXPECT_EQ(compiledProducer->epilogueBarrierCount, 0u);
        ASSERT_EQ(compiledConsumer->prologueBarrierCount, 1u);
        const Core::GpuCompiledBarrier* const dependency = compiledPlan.findTask(pair.consumer).prologueBarriers;
        ASSERT_NE(dependency, nullptr);
        EXPECT_EQ(dependency[0u].type, Core::GpuCompiledBarrierType::TextureTransition);
        EXPECT_EQ(dependency[0u].resource, pair.texture);
        EXPECT_EQ(dependency[0u].before, Core::ResourceStates::CopySource);
        EXPECT_EQ(dependency[0u].after, Core::ResourceStates::CopySource);
        EXPECT_TRUE(dependency[0u].forceMemoryDependency);
    }
}

void VerifyGpuRouting_RejectsDedicatedTransferUseOutsideConcurrentSharingContract(){
    ScratchArena operationScratchArena = ScratchArena(s_TaskGraphScratchArena);

    TestArena testArena = TestArena();
    GpuTaskGraph graph = GpuTaskGraph(testArena.arena);
    const Expected<TransferOwnershipPair> pairResult = AddTransferOwnershipPair(graph, ResourceQueueSharing::GraphicsAndAsyncCompute);
    ASSERT_TRUE(pairResult.has_value());
    const TransferOwnershipPair pair = pairResult.value();
    ASSERT_TRUE(pair.texture.valid());
    ASSERT_TRUE(pair.producer.valid());
    ASSERT_TRUE(pair.consumer.valid());

    Array<GpuPhysicalQueueInfo, 3> queues = Array<GpuPhysicalQueueInfo, 3>();
    queues[0u] = GraphicsQueue();
    queues[1u] = DedicatedComputeQueue();
    queues[2u] = DedicatedTransferQueue();
    const GpuPhysicalQueueTopology topology = MakeGpuRoutingTopology(queues);
    GpuTaskGraphAnalysis analysis = GpuTaskGraphAnalysis(testArena.arena);
    GpuTaskGraphQueueAssignments assignments = GpuTaskGraphQueueAssignments(testArena.arena);
    GpuCompiledGraph compiledGraph = GpuCompiledGraph(testArena.arena);
    EXPECT_FALSE(CompileWithSeparatedCommandQueues(analysis, assignments, compiledGraph, operationScratchArena, graph, topology));
    const GpuCompiledGraphReadView compiledPlan = GpuCompiledGraphReadView(compiledGraph);

    EXPECT_EQ(assignments.diagnostic().status, GpuTaskGraphQueueAssignmentStatus::NoCompatibleQueue);
    EXPECT_EQ(assignments.diagnostic().task, pair.consumer);
    EXPECT_FALSE(compiledPlan.valid());
}

void VerifyGpuRouting_PartialDagMultiwordScoresPreserveIndependentCostsAfterMoves(){
    Array<GpuRoutingPartialDagShape, 5> shapes = Array<GpuRoutingPartialDagShape, 5>();
    shapes[0u] = GpuRoutingPartialDagShape::OneEdge;
    shapes[1u] = GpuRoutingPartialDagShape::DisjointPairs;
    shapes[2u] = GpuRoutingPartialDagShape::ConnectedBranches;
    shapes[3u] = GpuRoutingPartialDagShape::DenseLayers;
    shapes[4u] = GpuRoutingPartialDagShape::MergedPairs;
    for(in GpuRoutingPartialDagShape shape : shapes){
        native(in shape){
            ASSERT_NO_FATAL_FAILURE(GpuRoutingCheckIndexedScores<130u>(shape));
        }
    }
}

