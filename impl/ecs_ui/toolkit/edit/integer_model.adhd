#include <impl/ecs_ui/toolkit/edit/numeric_model_operations.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <global/numeric_text.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_UI_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Owns a typed value and a bounded draft; user bounds never constrain authoritative setValue().
class IntegerEditModel final : public NumericEditModelBase<i64, IntegerBounds, IntegerEditModel>{
    friend class NumericEditModelBase<i64, IntegerBounds, IntegerEditModel>;


public:
    explicit IntegerEditModel(Core::Alloc::GlobalArena& arena);


public:
    [[nodiscard]] NumericParseStatus::Enum status(const IntegerBounds& bounds = {})const noexcept;

    // External replacements fence pending native/clipboard intentions even when the supplied value is unchanged.
    [[nodiscard]] b8 setValue(i64 value);


private:
    [[nodiscard]] NumericEditResult commit(const IntegerBounds& bounds, b8 canonical);
    [[nodiscard]] Expected<b8, ErrorCode> canonicalize(i64 value);
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_UI_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const i64 s_DefaultIntegerEditValue = 0ll;

b8 HasIntegerEditValueChanged(in i64 candidate, in i64 value){
    return candidate != value;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_UI_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


IntegerEditModel::IntegerEditModel(Core::Alloc::GlobalArena& arena)
    : NumericEditModelBase(arena)
{
    initializeDefault(s_DefaultIntegerEditValue);
}

NumericParseStatus::Enum IntegerEditModel::status(const IntegerBounds& bounds)const noexcept{
    return EvaluateIntegerDraftStatus(m_draft.text(), bounds);
}

b8 IntegerEditModel::setValue(const i64 value){
    return assignAuthoritativeValue(value);
}

NumericEditResult IntegerEditModel::commit(const IntegerBounds& bounds, const b8 canonical){
    return commitDraftWith(
        bounds,
        canonical,
        ValidateIntegerBounds,
        ParseIntegerDraft,
        HasIntegerEditValueChanged
    );
}

Expected<b8, ErrorCode> IntegerEditModel::canonicalize(const i64 value){
    return canonicalizeWith(value, [](const i64 candidate, const Span<char> buffer)noexcept{ return FormatI64(candidate, buffer); });
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_UI_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

