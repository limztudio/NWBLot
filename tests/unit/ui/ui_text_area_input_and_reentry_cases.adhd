class UiTextAreaInputScrollTests : public TextAreaFixture{
public:
    [[nodiscard]] static TextAreaOptions ScrollOptions()noexcept;


public:
    UiTextAreaInputScrollTests()
        : m_document(m_arena)
    {
        m_document.reserve(24u * 65u);
        for(usize row = 0u; row < 24u; ++row){
            if(row != 0u)
                m_document.push_back('\n');
            m_document.append(64u, 'a');
        }
    }


public:
    [[nodiscard]] AStringView documentView()const noexcept{
        return AStringView(m_document.data(), m_document.size());
    }

    [[nodiscard]] b8 prepareDocument(const Point scroll = {});
    [[nodiscard]] b8 prepareScroll(const TextAreaOptions& options = ScrollOptions(), const Point scroll = {});
    [[nodiscard]] b8 wheel(f64 x, f64 y, Point position);
    [[nodiscard]] b8 wheel(f64 x, f64 y);
    [[nodiscard]] WidgetId part(AStringView key)const;
    [[nodiscard]] b8 framePopup(u64 generation, PopupState& popup);


public:
    AString<Core::Alloc::GlobalArena> m_document;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


