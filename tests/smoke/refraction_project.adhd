#include "refraction_scenes_and_runtime.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RefractionSmokeProject : IProjectEntryCallbacks{
    public RefractionSmokeProject(mut ProjectRuntimeContext context){
        this.m_impl = RefractionSmokeProjectImpl(context);
    }

    public b8 onStartup()override{
        return this.m_impl.onStartup();
    }

    public void onShutdown()override{
        this.m_impl.onShutdown();
    }

    public b8 onUpdate(in f32 delta)override{
        return this.m_impl.onUpdate(delta);
    }

    private RefractionSmokeProjectImpl m_impl;
}


