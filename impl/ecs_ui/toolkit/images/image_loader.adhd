native{
#include <impl/ecs_ui/toolkit/images/image_source.adhd.h>

#include <core/assets/manager.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_UI_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// The loaded asset is temporary; the returned version retains only texture data copied into the caller's arena.
[[nodiscard]] inline Expected<SharedImageSource> LoadImageSource(Core::Alloc::GlobalArena& arena, const Core::Assets::AssetManager& assets, const Core::Assets::AssetRef<Texture>& identity){
    if(!ValidateImageSourceLoadIdentity(identity.valid(), Name{}, Name{}))
        return MakeUnexpected(Failure{});
    auto loadedAsset = assets.loadTypedSync<Texture>(identity.name(), NWB_TEXT("LoadImageSource"));
    if(!loadedAsset)
        return MakeUnexpected(loadedAsset.error());
    const Texture* texture = loadedAsset->get();
    if(!texture)
        return MakeUnexpected(Failure{});
    if(!ValidateImageSourceLoadIdentity(true, texture->virtualPath(), identity.name()))
        return MakeUnexpected(Failure{});
    return MakeImageSource(arena, *texture);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_UI_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ImplEcsUiToolkitImagesImageLoaderAdhdModule(in u64 value){
    return value != 0u;
}


