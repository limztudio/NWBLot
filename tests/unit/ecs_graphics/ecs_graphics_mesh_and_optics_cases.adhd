// Compile the production Slang color helpers against C++ vector types.
struct ShaderFloat3{
    f64 x;
    f64 y;
    f64 z;


public:
    ShaderFloat3(const f64 scalar)noexcept
        : x(scalar)
        , y(scalar)
        , z(scalar){}
    ShaderFloat3(const f64 red, const f64 green, const f64 blue)noexcept
        : x(red)
        , y(green)
        , z(blue){}
};
using float3 = ShaderFloat3;

[[nodiscard]] inline ShaderFloat3 operator+(const ShaderFloat3 a, const ShaderFloat3 b)noexcept{
    const SIMDVectorDouble sum = VectorDoubleAdd(VectorDoubleSet(a.x, a.y, a.z, 0.0), VectorDoubleSet(b.x, b.y, b.z, 0.0));
    return { VectorDoubleGetX(sum), VectorDoubleGetY(sum), VectorDoubleGetZ(sum) };
}

[[nodiscard]] inline ShaderFloat3 operator*(const ShaderFloat3 a, const ShaderFloat3 b)noexcept{
    const SIMDVectorDouble product = VectorDoubleMultiply(VectorDoubleSet(a.x, a.y, a.z, 0.0), VectorDoubleSet(b.x, b.y, b.z, 0.0));
    return { VectorDoubleGetX(product), VectorDoubleGetY(product), VectorDoubleGetZ(product) };
}

[[nodiscard]] inline ShaderFloat3 operator/(const ShaderFloat3 a, const ShaderFloat3 b)noexcept{
    const SIMDVectorDouble quotient = VectorDoubleDivide(VectorDoubleSet(a.x, a.y, a.z, 0.0), VectorDoubleSet(b.x, b.y, b.z, 1.0));
    return { VectorDoubleGetX(quotient), VectorDoubleGetY(quotient), VectorDoubleGetZ(quotient) };
}

// Sum lanes in scalar left-to-right order.
[[nodiscard]] inline f64 dot(const ShaderFloat3 a, const ShaderFloat3 b)noexcept{
    return (a.x * b.x + a.y * b.y) + a.z * b.z;
}

[[nodiscard]] inline ShaderFloat3 max(const ShaderFloat3 a, const ShaderFloat3 b)noexcept{
    const SIMDVectorDouble larger = VectorDoubleMax(VectorDoubleSet(a.x, a.y, a.z, 0.0), VectorDoubleSet(b.x, b.y, b.z, 0.0));
    return { VectorDoubleGetX(larger), VectorDoubleGetY(larger), VectorDoubleGetZ(larger) };
}

[[nodiscard]] inline f32 saturate(const f32 a)noexcept{
    return a > 0.0f ? Min(1.0f, a) : 0.0f;
}

[[nodiscard]] inline ShaderFloat3 saturate(const ShaderFloat3 a)noexcept{
    // Max then min in this operand order maps NaN and -0 to +0.
    const SIMDVectorDouble lower = VectorDoubleMax(VectorDoubleSet(a.x, a.y, a.z, 0.0), VectorDoubleZero());
    const SIMDVectorDouble saturated = VectorDoubleMin(VectorDoubleSplatOne(), lower);
    return { VectorDoubleGetX(saturated), VectorDoubleGetY(saturated), VectorDoubleGetZ(saturated) };
}

[[nodiscard]] inline ShaderFloat3 pow(const ShaderFloat3 a, const f64 b)noexcept{
    // VectorDoublePow calls Pow per lane, so the bits match.
    const SIMDVectorDouble power = VectorDoublePow(VectorDoubleSet(a.x, a.y, a.z, 1.0), VectorDoubleReplicate(b));
    return { VectorDoubleGetX(power), VectorDoubleGetY(power), VectorDoubleGetZ(power) };
}

[[nodiscard]] ShaderFloat3 EcsGraphicsMeshOptics_nwbHdr10SceneToNits(ShaderFloat3 linearRec709);
[[nodiscard]] ShaderFloat3 EcsGraphicsMeshOptics_nwbHdr10PqEncodeNits(ShaderFloat3 luminanceNits);
[[nodiscard]] ShaderFloat3 EcsGraphicsMeshOptics_nwbHdr10EncodeScene(ShaderFloat3 linearRec709);
[[nodiscard]] ShaderFloat3 EcsGraphicsMeshOptics_nwbHdr10EncodeUiLinear(ShaderFloat3 linearRec709);
[[nodiscard]] ShaderFloat3 EcsGraphicsMeshOptics_nwbHdr10EncodeSceneWithUi(ShaderFloat3 sceneLinearRec709, ShaderFloat3 uiPremultipliedLinearRec709, float uiAlpha);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


