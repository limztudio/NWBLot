#include <impl/ecs_render/deferred/task_graph_gbuffer_task.adhd>
#include <impl/ecs_render/deferred/opaque_compute_emulation_planner.adhd>
#include <impl/ecs_render/deferred/format_private.adhd>
#include <impl/ecs_render/kernel/renderer_constants_private.adhd>
#include <impl/ecs_render/kernel/graphics_prefix_timing_ticket.adhd>
#include <impl/ecs_render/kernel/timing_names.adhd>
#include <impl/ecs_render/shared/frame_types.adhd>

#include <impl/ecs_render/kernel/task_graph_resource_descs.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 GbufferGraphTask::record(mut CommandList commands, in GpuTaskRecordContext context)const{
    if(!this.opaqueDrawSnapshot.passes.captured)
        return false;

    GpuTimingTicketRecordingScope timingRecording(this.timingTicket.value());

    ViewportState deferredViewportState;
    deferredViewportState.addViewportAndScissorRect(this.targets.framebuffer.deref().getFramebufferInfo().getViewport());

    const b8 frameSetupReady = FrameSetupReady(this.meshViewSetupReady, this.sceneShadingSetupReady);
    MaterialPassDrawItemPartitionsView opaqueDrawItems;
    CsgFrameGpuDataView csgFrameData;
    if(frameSetupReady){
        opaqueDrawItems = this.opaqueDrawSnapshot.drawItemsView();
        csgFrameData = this.opaqueDrawSnapshot.csgFrameDataView();
    }

    const b8 hasDeferredDrawItems = !opaqueDrawItems.empty();
    const b8 deferredResourcesReady = hasDeferredDrawItems && this.materialDrawBuffersUploaded && this.frameBindings.frameReady(this.opaqueDrawSnapshot.passes.instanceCount, this.opaqueDrawSnapshot.passes.materialTypedByteCount);
    const b8 regularDrawResourcesReady = deferredResourcesReady && this.materialSystem.drawRecorder().materialPassDrawResourcesReady(opaqueDrawItems.regular, this.frameBindings);
    MaterialPassDrawItemsView regularDrawItemsForGbuffer(opaqueDrawItems.regular.meshDrawItems, opaqueDrawItems.regular.indexedDrawItems, opaqueDrawItems.regular.computeDrawItems);
    if(this.regularSharedComputeEmulationDrawsGraphOwned)
        regularDrawItemsForGbuffer.computeDrawItems = Span<MaterialPassDrawItem>();
    const b8 csgResourcesReady = deferredResourcesReady && (!csgFrameData.hasWork() || (this.csgFrameBuffersUploaded && this.csgResources.frameReady(csgFrameData) && this.frameBindings.bindingValid()));
    const b8 csgReceiverSurfaceDrawResourcesReady = csgResourcesReady && (opaqueDrawItems.csgReceiverSurface.empty() || this.materialSystem.drawRecorder().materialPassDrawResourcesReady(opaqueDrawItems.csgReceiverSurface, this.frameBindings));
    if(regularDrawResourcesReady && this.regularSharedComputeEmulationDrawsGraphOwned && (!this.regularSharedComputeEmulationTiming.has_value() || this.regularSharedComputeEmulationTiming.value().has_value()))
        return false;

    const b8 csgSampleStateReady = csgResourcesReady;
    if(deferredResourcesReady && csgSampleStateReady && csgFrameData.hasWork()){
        this.csgSystem.dispatchCsgIntervalPeels(commands, this.targets, csgFrameData, this.csgResources, this.frameBindings);
    }

    // Clears begin the first segment; continuations resume with LOAD.
    RenderPassParameters renderPassParameters;
    renderPassParameters.colorClearValues[s_MeshGbufferBaseColorLocation] = s_ClearColor;
    renderPassParameters.colorClearValues[s_MeshGbufferNormalLocation] = s_GBufferNormalClearColor;
    renderPassParameters.colorClearValues[s_MeshGbufferWorldPositionLocation] = s_GBufferWorldPositionClearColor;
    renderPassParameters.colorClearValues[s_MeshGbufferSpecularRoughnessLocation] = s_GBufferSpecularRoughnessClearColor;
    for(u32 attachmentIndex = 0u; attachmentIndex < s_MeshGbufferTargetCount; ++attachmentIndex)
        renderPassParameters.colorAttachmentActions[attachmentIndex].loadAction = RenderPassLoadAction::Clear;
    renderPassParameters.depthAttachmentActions.loadAction = RenderPassLoadAction::Clear;
    commands.beginRenderPass(this.targets.framebuffer.deref(), renderPassParameters);

    if(deferredResourcesReady){
        MaterialPassDrawContext opaqueDrawContext(
            commands,
            deferredViewportState,
            this.frameBindings,
            MaterialPipelinePass::Opaque,
            this.materialFrameStatesGraphOwned,
            this.materialGeometryStatesGraphOwned,
            this.regularComputeEmulationOutputStatesGraphOwned
        );
        opaqueDrawContext.setFramebuffer(this.targets.framebuffer);
        if(regularDrawResourcesReady && (this.regularSharedComputeEmulationDrawsGraphOwned || !regularDrawItemsForGbuffer.empty())){
            if(this.regularSharedComputeEmulationDrawsGraphOwned){
                this.regularSharedComputeEmulationTiming.value().emplace(this.graphics.gpuTiming(), s_TimingScopeOpaqueRegular, this.graphics.getDevice(), commands);
                // Close the marker before finalizing this command list.
                if(!FinishSplitGpuTimingMarker(this.regularSharedComputeEmulationTiming.value()))
                    return false;
                if(!regularDrawItemsForGbuffer.empty())
                    this.materialSystem.drawRecorder().renderMaterialPassDrawItems(opaqueDrawContext, regularDrawItemsForGbuffer);
            }
            else{
                GpuTimingMeasure timing(this.graphics.gpuTiming(), s_TimingScopeOpaqueRegular, this.graphics.getDevice(), commands);

                this.materialSystem.drawRecorder().renderMaterialPassDrawItems(opaqueDrawContext, regularDrawItemsForGbuffer);
            }
        }

        ViewportState csgIntervalViewportState;
        csgIntervalViewportState.addViewport(this.targets.framebuffer.deref().getFramebufferInfo().getViewport()).addScissorRect(ToCoreRect(csgFrameData.workRegion.resolveRect(this.targets.width, this.targets.height)));
        MaterialPassDrawContext csgReceiverSurfaceDrawContext(
            commands,
            csgIntervalViewportState,
            this.frameBindings,
            MaterialPipelinePass::CsgReceiverSurface,
            this.materialFrameStatesGraphOwned,
            this.materialGeometryStatesGraphOwned,
            this.csgReceiverComputeEmulationOutputStatesGraphOwned
        );
        csgReceiverSurfaceDrawContext.setFramebuffer(this.targets.framebuffer).setCsgResources(this.csgResources);
        if(csgSampleStateReady && csgReceiverSurfaceDrawResourcesReady && !opaqueDrawItems.csgReceiverSurface.empty()){
            GpuTimingMeasure timing(this.graphics.gpuTiming(), s_TimingScopeOpaqueCsgReceiverSurface, this.graphics.getDevice(), commands);

            this.materialSystem.drawRecorder().renderMaterialPassDrawItems(csgReceiverSurfaceDrawContext, opaqueDrawItems.csgReceiverSurface);
        }
    }
    commands.endRenderPass();
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

