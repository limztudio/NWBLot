////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_SHADOW_SW_HEAP_RESOURCES_SLANGI
#define NWB_GRAPHICS_SHADOW_SW_HEAP_RESOURCES_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "shadow_heap_resources.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// One 84-byte push ABI serves every software-shadow kernel. It carries shared G-buffer/context selectors and each
// pass's width/trace-control fields, keeping sources independent of a set-0 resource block.
struct NwbSwShadowHeapPushConstants{
    uint width;
    uint height;
    uint instanceCount;
    uint frameIndex;
    uint coarseWidth;
    uint coarseHeight;
    float edgeThreshold;
    uint collectStats;
    uint edgeCapacity;
    uint traceGroupSize;
    uint deferredResourcesHeapSlot;
    uint materialContextSlotsHeapSlot;
    uint visibilityStorageSlot;
    uint coarseStorageSlot;
    uint softHalfStorageSlot;
    uint transparentSoftHalfStorageSlot;
    uint edgeStatsStorageSlot;
    uint edgeCounterStorageSlot;
    uint edgeListStorageSlot;
    uint indirectArgsStorageSlot;
    uint softSampleCount;
};

[[vk::push_constant]]
ConstantBuffer<NwbSwShadowHeapPushConstants> g_NwbSwShadowPush;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

