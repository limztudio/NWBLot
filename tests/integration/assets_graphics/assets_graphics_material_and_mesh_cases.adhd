void VerifyAssetsGraphics_MeshAcceptanceUvSeamQuad(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_ReportOnly);
    TestArena testArena = TestArena();
    const Expected<CookCase> cookCase = PrepareAssetsGraphicsCookCase(testArena, "uv_seam_quad");
    ASSERT_TRUE(cookCase.has_value());
    const CookCase prepared = cookCase.value();

    MeshAsset loadedMesh(testArena.arena);
    if(CookAndLoadSmokeMeshInto("uv_seam_quad.nwb", s_AssetCaseProjectMeshesUvSeamQuad, prepared, testArena, loadedMesh)){
        ASSERT_EQ(loadedMesh.meshlets().size(), 1u);
        ASSERT_GE(loadedMesh.meshletLocalVertexRefs().size(), 5u);
        EXPECT_EQ(loadedMesh.meshletLocalVertexRefs()[0u].localDeformedPosition, loadedMesh.meshletLocalVertexRefs()[3u].localDeformedPosition);
        EXPECT_EQ(loadedMesh.meshletLocalVertexRefs()[2u].localDeformedPosition, loadedMesh.meshletLocalVertexRefs()[4u].localDeformedPosition);
        EXPECT_NE(loadedMesh.meshletLocalVertexRefs()[0u].localAttribute, loadedMesh.meshletLocalVertexRefs()[3u].localAttribute);
        EXPECT_NE(loadedMesh.meshletLocalVertexRefs()[2u].localAttribute, loadedMesh.meshletLocalVertexRefs()[4u].localAttribute);
        native(in loadedMesh){
            const NWB::Impl::MeshletDesc& meshlet = loadedMesh.meshlets()[0u];
            const auto& localRefs = loadedMesh.meshletLocalVertexRefs();
            const auto attributeRef0 = TestDecodeMeshletAttributeRef(loadedMesh, meshlet, localRefs[0u].localAttribute);
            const auto attributeRef2 = TestDecodeMeshletAttributeRef(loadedMesh, meshlet, localRefs[2u].localAttribute);
            const auto attributeRef3 = TestDecodeMeshletAttributeRef(loadedMesh, meshlet, localRefs[3u].localAttribute);
            const auto attributeRef4 = TestDecodeMeshletAttributeRef(loadedMesh, meshlet, localRefs[4u].localAttribute);
            ASSERT_TRUE(attributeRef0);
            ASSERT_TRUE(attributeRef2);
            ASSERT_TRUE(attributeRef3);
            ASSERT_TRUE(attributeRef4);
            EXPECT_EQ(attributeRef0->uv0, 0u);
            EXPECT_EQ(attributeRef2->uv0, 2u);
            EXPECT_EQ(attributeRef3->uv0, 1u);
            EXPECT_EQ(attributeRef4->uv0, 3u);
            EXPECT_EQ(attributeRef0->tangent, 0u);
            EXPECT_EQ(attributeRef2->tangent, 0u);
            EXPECT_EQ(attributeRef3->tangent, 1u);
            EXPECT_EQ(attributeRef4->tangent, 1u);
        }
    }
    EXPECT_EQ(logger.errorCount(), 0u);
    EXPECT_TRUE(RemoveAllIfExists(prepared.root));
}

void VerifyAssetsGraphics_MeshAcceptanceMirroredUvQuad(){
