    const VectorSingle white = VectorSingle(s_GiWhiteReceiverTint);
    const VectorSingle red = VectorSingle(s_GiRedBounceTint);
    const VectorSingle blue = VectorSingle(s_GiBlueBounceTint);
    const VectorSingle black = VectorSingle(s_GiBlackEnclosureTint);

    outBoxes[0u] = ComplexSceneBox(VectorSingle(-1.20f, 0.625f, -0.35f, 0.0f), VectorSingle(1.60f, 1.25f, 0.13f, 0.0f), neutral, 0.0f);
    outBoxes[1u] = ComplexSceneBox(VectorSingle(1.25f, 0.625f, -0.35f, 0.0f), VectorSingle(1.50f, 1.25f, 0.13f, 0.0f), neutral, 0.0f);
    outBoxes[2u] = ComplexSceneBox(VectorSingle(-0.42f, 1.525f, -0.35f, 0.0f), VectorSingle(0.13f, 0.55f, 0.16f, 0.0f), neutral, 0.0f);
    outBoxes[3u] = ComplexSceneBox(VectorSingle(0.52f, 1.525f, -0.35f, 0.0f), VectorSingle(0.13f, 0.55f, 0.16f, 0.0f), neutral, 0.0f);
    outBoxes[4u] = ComplexSceneBox(VectorSingle(0.05f, 1.90f, -0.35f, 0.0f), VectorSingle(0.90f, 0.20f, 0.13f, 0.0f), neutral, 0.0f);

    outBoxes[5u] = ComplexSceneBox(VectorSingle(-0.675f, 0.85f, 0.95f, 0.0f), VectorSingle(2.65f, 1.70f, 0.13f, 0.0f), neutral, 0.0f);
    outBoxes[6u] = ComplexSceneBox(VectorSingle(1.725f, 0.85f, 0.95f, 0.0f), VectorSingle(0.55f, 1.70f, 0.13f, 0.0f), neutral, 0.0f);
    outBoxes[7u] = ComplexSceneBox(VectorSingle(1.05f, 1.85f, 0.95f, 0.0f), VectorSingle(0.80f, 0.30f, 0.13f, 0.0f), neutral, 0.0f);
    outBoxes[8u] = ComplexSceneBox(VectorSingle(-0.65f, 0.60f, 0.30f, 0.0f), VectorSingle(0.13f, 1.20f, 1.15f, 0.0f), neutral, 0.0f);

