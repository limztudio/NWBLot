////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "edit_box_style.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class EditBoxSnapshotSizes{
    public usize replaced = 0u;
    public usize preeditBytes = 0u;
    public usize displayBytes = 0u;
}

class EditBoxSnapshotBuilder{
    private Expected<EditBoxSnapshotSizes> resolveSizes(
        in usize committedBytes,
        in EditCompositionView composition
    )const{
        EditBoxSnapshotSizes sizes = EditBoxSnapshotSizes();
        if(composition.active){
            sizes.replaced = composition.replacementEnd - composition.replacementStart;
            sizes.preeditBytes = composition.text.size();
        }
        if(committedBytes > s_TextMaxBytes || sizes.preeditBytes > s_TextMaxBytes - (committedBytes - sizes.replaced))
            return MakeUnexpected(Failure());
        sizes.displayBytes = (committedBytes - sizes.replaced) + sizes.preeditBytes;
        return sizes;
    }

    private EditCaretMapping makeCaretMapping(in usize committedByte, in usize displayByte)const{
        EditCaretMapping item = EditCaretMapping();
        item.committedByte = committedByte;
        item.displayByte = displayByte;
        return item;
    }

    [cpp_unwind]
    private Expected<usize> buildInto(
        in StringView committed,
        in Span<usize> graphemeBoundaries,
        in EditCompositionView composition,
        in EditTextMode textMode,
        mut String outDisplay,
        mut Vector<EditCaretMapping> outStops
    )const{
        const Expected<EditBoxSnapshotSizes> sizes = this.resolveSizes(committed.size(), composition);
        if(!sizes.has_value())
            return MakeUnexpected(Failure());
        outDisplay.clear();
        outDisplay.reserve(sizes.value().displayBytes);
        if(composition.active){
            outDisplay.append(committed.substr(0u, composition.replacementStart));
            if(sizes.value().preeditBytes != 0u)
                outDisplay.append(composition.text.substr(0u, sizes.value().preeditBytes));
            outDisplay.append(committed.substr(composition.replacementEnd, committed.size() - composition.replacementEnd));
        }
        else if(!committed.empty())
            outDisplay.assign(committed);
        if(!ValidateEditTextForMode(outDisplay, textMode))
            return MakeUnexpected(Failure());
        outStops.clear();
        outStops.reserve(graphemeBoundaries.size() + 1u);
        for(in usize boundary : graphemeBoundaries){
            if(!composition.active || boundary <= composition.replacementStart)
                outStops.push_back(this.makeCaretMapping(boundary, boundary));
            if(composition.active && boundary >= composition.replacementEnd)
                outStops.push_back(this.makeCaretMapping(boundary, boundary - sizes.value().replaced + sizes.value().preeditBytes));
        }
        return sizes.value().preeditBytes;
    }

    private void resolveRanges(
        in EditCompositionView composition,
        in usize preeditBytes,
        in usize modelSelectionStart,
        in usize modelSelectionEnd,
        in usize modelCaret,
        mut EditBoxRange outPreedit,
        mut EditBoxRange outReplacement,
        mut EditBoxRange outSelection,
        mut usize outCaret
    )const{
        outPreedit = EditBoxRange();
        outReplacement = EditBoxRange();
        outSelection = EditBoxRange();
        outCaret = modelCaret;
        if(composition.active){
            outPreedit.begin = composition.replacementStart;
            outPreedit.end = composition.replacementStart + preeditBytes;
            outReplacement.begin = composition.replacementStart;
            outReplacement.end = composition.replacementEnd;
            outSelection.begin = outPreedit.begin + Min(composition.anchor, composition.caret);
            outSelection.end = outPreedit.begin + Max(composition.anchor, composition.caret);
            outCaret = outPreedit.begin + composition.caret;
        }
        else{
            outSelection.begin = modelSelectionStart;
            outSelection.end = modelSelectionEnd;
        }
    }

    [cpp_unwind]
    public b8 commit(
        in StringView committed,
        in Span<usize> graphemeBoundaries,
        in EditCompositionView composition,
        in EditTextMode textMode,
        in usize selectionStart,
        in usize selectionEnd,
        in usize modelCaret,
        in u64 modelRevision,
        mut String outDisplay,
        mut Vector<EditCaretMapping> outMapping,
        mut EditBoxRange outSelection,
        mut EditBoxRange outPreedit,
        mut EditBoxRange outReplacement,
        mut usize outCaret,
        mut usize outCommittedBytes,
        mut u64 outRevision,
        mut EditTextMode outTextMode,
        mut b8 outComposing,
        mut b8 outReady
    )const{
        String display = "";
        Vector<EditCaretMapping> stops = Vector<EditCaretMapping>();
        const Expected<usize> preeditBytes = this.buildInto(committed, graphemeBoundaries, composition, textMode, display, stops);
        if(!preeditBytes.has_value())
            return false;
        outMapping.reserve(stops.size());
        outDisplay.assign(display);
        AssignTriviallyCopyableVector(outMapping, Span<EditCaretMapping>(stops));
        outComposing = composition.active;
        this.resolveRanges(
            composition,
            preeditBytes.value(),
            selectionStart,
            selectionEnd,
            modelCaret,
            outPreedit,
            outReplacement,
            outSelection,
            outCaret
        );
        outCommittedBytes = committed.size();
        outRevision = modelRevision;
        outTextMode = textMode;
        outReady = false;
        return true;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

