void VerifyUiPopupRouterTests_InsertingLowerBeneathRetainedTopKeepsTopFocusAndTheOriginalBaseRestoreTarget(mut UiPopupRouterTests self){
    self.focusBase();
    const PopupScope higher = MakeUiPopupRouterScopeLayer(200u, 5u);
    ASSERT_TRUE(self.install(higher, 2u));
    self.key(Key::Tab);
    ASSERT_EQ(self.m_router.focus().value, 202u);
    const PopupScope lower = MakeUiPopupRouterScope();
    const Array<HitTarget, 5u> lowerTargets = MakeUiPopupRouterTargets(lower);
    Array<HitTarget, 8u> targets = Array<HitTarget, 8u>();
    targets[0u] = lowerTargets[0u];
    targets[1u] = lowerTargets[1u];
    targets[2u] = lowerTargets[2u];
    targets[3u] = lowerTargets[3u];
    targets[4u] = lowerTargets[4u];
    targets[5u] = MakeUiPopupRouterBarrier(higher);
    targets[6u] = MakeUiPopupRouterChild(higher, 201u, MakeUiPopupRouterRect(50.0f, 50.0f, 30.0f, 20.0f), 11u);
    targets[7u] = MakeUiPopupRouterChild(higher, 202u, MakeUiPopupRouterRect(90.0f, 50.0f, 30.0f, 20.0f), 12u);
    Array<PopupScope, 2u> scopes = Array<PopupScope, 2u>();
    scopes[0u] = lower;
    scopes[1u] = higher;
    ASSERT_TRUE(self.m_router.commitTargets(targets, 3u, scopes));
    EXPECT_EQ(self.m_router.focus().value, 202u);
    self.m_router.closePopup(higher.token);
    ASSERT_TRUE(self.install(lower, 4u));
    EXPECT_EQ(self.m_router.focus().value, 101u);
    self.m_router.closePopup(lower.token);
    const Array<HitTarget, 2u> base = MakeUiPopupRouterBaseTargets();
    ASSERT_TRUE(self.m_router.commitTargets(base, 5u));
    EXPECT_FALSE(self.m_router.hasPopup());
    EXPECT_EQ(self.m_router.focus().value, 1u);
}

void VerifyUiPopupRouterTests_FocusLossDismissesAllScopesWithoutRestoringUnderlyingFocus(mut UiPopupRouterTests self){
    self.focusBase();
    const PopupScope lower = MakeUiPopupRouterScope();
    ASSERT_TRUE(self.install(lower, 2u));
    const PopupScope higher = MakeUiPopupRouterScopeLayer(200u, 5u);
    const Array<HitTarget, 7u> targets = MakeUiPopupRouterTwoLayerTargets(lower, higher);
    Array<PopupScope, 2u> scopes = Array<PopupScope, 2u>();
    scopes[0u] = lower;
    scopes[1u] = higher;
    ASSERT_TRUE(self.m_router.commitTargets(targets, 3u, scopes));
    EXPECT_TRUE(self.send(MakeUiPopupRouterBareEvent(InputEventType::FocusLost)).commandConsumed);
    EXPECT_FALSE(self.m_router.focus().valid());
    const auto reasonResult1 = self.m_router.consumePopupDismissal(lower.token);
    ASSERT_TRUE(reasonResult1.has_value());
    EXPECT_EQ(reasonResult1.value(), PopupDismissReason::FocusLost);
    const auto reasonResult2 = self.m_router.consumePopupDismissal(higher.token);
    ASSERT_TRUE(reasonResult2.has_value());
    EXPECT_EQ(reasonResult2.value(), PopupDismissReason::FocusLost);
    const Array<HitTarget, 2u> base = MakeUiPopupRouterBaseTargets();
    ASSERT_TRUE(self.m_router.commitTargets(base, 4u));
    EXPECT_FALSE(self.m_router.focus().valid());
    EXPECT_FALSE(self.m_router.hasPopup());
}

void VerifyUiPopupRouterTests_FocusLossWhileAlreadyClosingStillSuppressesSavedFocusRestoration(mut UiPopupRouterTests self){
    self.focusBase();
