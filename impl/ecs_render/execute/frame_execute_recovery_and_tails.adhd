#include <impl/ecs_render/shared/frame_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ShouldExecuteFrameRecoveryTask(in b8 hasAcceptedPackets, in b8 timingNeedsRetirement){
    return hasAcceptedPackets || timingNeedsRetirement;
}

b8 IsDeferredTransferTailAvailable(
    in b8 finalPresentationValid,
    in b8 deferredGraphScheduled,
    in b8 tailTaskValid,
    in b8 tailTaskCompiled,
    in b8 queuePresent,
    in b8 queueSupportsTransfer
){
    return finalPresentationValid && deferredGraphScheduled && tailTaskValid && tailTaskCompiled && queuePresent && queueSupportsTransfer;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void RestorePrefixCpuState(mut RendererMeshSystem meshSystem, mut RendererDeferredSystem deferredSystem){
    // Rejected recording invalidates upload mirrors.
    meshSystem.invalidateMeshViewBufferUploadMirror();
    deferredSystem.invalidateSceneLightingUploadMirrors();
}

void RestorePostGbufferPacketCpuState(
    in FrameExecuteCpuSnapshot snapshot,
    in b8 restoreBindlessSlots,
    mut RendererMeshSystem meshSystem,
    mut RendererDeferredSystem deferredSystem,
    mut RendererRayTracingState rayTracingState,
    mut RendererAvboitSystem avboitSystem,
    mut DeferredFrameTargets targets
){
    if(restoreBindlessSlots)
        targets.bindless.slotsUploaded = snapshot.deferredBindlessSlotsUploaded;
    RestorePrefixCpuState(meshSystem, deferredSystem);
    rayTracingState.restoreShadowPacketCpuState(snapshot.rayTracing);
    rayTracingState.restoreCausticPacketCpuState(snapshot.rayTracing);
    rayTracingState.restoreSurfelGiPacketCpuState(snapshot.rayTracing);
    avboitSystem.restoreTargetClearState(snapshot.avboitTargetsNeedClear);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 FrameExecuteRecovery::discardUnacceptedGraphPackets(){
    mut RendererFramePipeline renderer = this.m_renderer;
    return renderer.m_deferredLightingSubmissionTransaction.discardUnaccepted(renderer.m_deferredLightingTaskGraph, renderer.m_deferredLightingCompiledGraph, renderer.m_deferredLightingRecordedGraph.recordingAttemptGeneration());
}

b8 FrameExecuteRecovery::executeFrameRecoveryTask(){
    mut RendererFramePipeline renderer = this.m_renderer;

    // Retire the scope after rejection; Graphics order needs no extra wait.
    if(renderer.m_graphics.getDevice().requiresRecreation()){
        [essential] warning("RendererSystem: frame recovery packet skipped because the graphics device requires recreation");
        renderer.m_deferredFrameRecoveryArmed = false;
        renderer.m_deferredFrameRecoveryRetiresTiming = false;
        this.m_frameTimingTransaction.discard();
        return false;
    }
    if(!renderer.m_deferredLightingTaskGraphScheduled || !renderer.m_deferredFrameRecoveryTask.valid() || !this.m_compiledPlan.findTask(renderer.m_deferredFrameRecoveryTask).valid()){
        [essential] warning("RendererSystem: deferred frame recovery task was unavailable");
        renderer.m_deferredFrameRecoveryArmed = false;
        renderer.m_deferredFrameRecoveryRetiresTiming = false;
        this.m_frameTimingTransaction.discard();
        return false;
    }
    b8 retireTiming = this.m_frameTimingTransaction.needsRetirement();
    if(retireTiming && !this.m_frameTimingTransaction.prepareForRecovery()){
        warning("RendererSystem: frame timing recovery preparation failed; continuing resource/frontier recovery");
        this.m_frameTimingTransaction.discard();
        retireTiming = false;
    }
    renderer.m_deferredFrameRecoveryArmed = true;
    renderer.m_deferredFrameRecoveryRetiresTiming = retireTiming;
    in GpuTaskScheduler scheduler = renderer.m_graphics.gpuTasks();
    const b8 recoveryAccepted = scheduler.executeAcceptedFrontierTask(
        renderer.m_deferredLightingCompiledGraph,
        renderer.m_deferredFrameRecoveryTask,
        renderer.m_deferredLightingTaskGraph,
        renderer.m_deferredLightingRecordedGraph,
        renderer.m_deferredLightingSubmissionTransaction,
        renderer.m_graphics.gpuTiming()
    );
    if(!recoveryAccepted){
        [essential] warning("RendererSystem: deferred frame recovery record/submission was rejected");
        return false;
    }
    return true;
}

b8 FrameExecuteRecovery::recoverPendingFrameSubmission(){
    if(ShouldExecuteFrameRecoveryTask(this.m_renderer.m_deferredLightingSubmissionTransaction.hasAcceptedPackets(), this.m_frameTimingTransaction.needsRetirement()))
        return this.executeFrameRecoveryTask();
    return true;
}

b8 FrameExecuteRecovery::recoverPendingFrameThenDiscardUnaccepted(){
    const b8 recovered = this.recoverPendingFrameSubmission();
    // Record/submit while Declared; then reject remaining normal packets.
    return this.discardUnacceptedGraphPackets() && recovered;
}

void FrameExecuteRecovery::failFrameRenderRecovery(){
    mut RendererFramePipeline renderer = this.m_renderer;
    if(renderer.m_frameRenderRecoveryFailed)
        return;
    renderer.m_frameRenderRecoveryFailed = true;
    [essential] warning("RendererSystem: cannot safely continue after an unresolved frame recovery submission; requesting device recreation");
    // Defer recreation until accepted work is safe.
    renderer.m_graphics.requestDeviceRecreation();
}

class FrameHistoryCopyAcceptance{
    public mut GpuPersistentResourceStateCache shadowVisibilityReturnState;
    public mut GpuPersistentResourceStateCache causticIrradianceReturnState;
    public mut GpuPersistentResourceStateCache surfelIrradianceReturnState;
    public mut DeferredFrameTargets targets;
    public mut GpuPersistentStateCandidate shadowStateCandidate;
    public mut GpuPersistentStateCandidate causticStateCandidate;
    public mut GpuPersistentStateCandidate surfelStateCandidate;
    public b8 finalStateReady = false;
    public b8 acceptedStateReady = false;

    public FrameHistoryCopyAcceptance(
        mut GpuPersistentResourceStateCache shadowVisibilityReturnState,
        mut GpuPersistentResourceStateCache causticIrradianceReturnState,
        mut GpuPersistentResourceStateCache surfelIrradianceReturnState,
        mut DeferredFrameTargets targets,
        mut GpuPersistentStateCandidate shadowStateCandidate,
        mut GpuPersistentStateCandidate causticStateCandidate,
        mut GpuPersistentStateCandidate surfelStateCandidate
    ){
        this.shadowVisibilityReturnState = shadowVisibilityReturnState;
        this.causticIrradianceReturnState = causticIrradianceReturnState;
        this.surfelIrradianceReturnState = surfelIrradianceReturnState;
        this.targets = targets;
        this.shadowStateCandidate = shadowStateCandidate;
        this.causticStateCandidate = causticStateCandidate;
        this.surfelStateCandidate = surfelStateCandidate;
    }

    [cpp_unwind]
    public b8 recorded(in Optional<in CommandListResourceStateHandoff> finalState){
        if(!finalState.has_value())
            return false;

        const Array<TextureHandle, 1u> shadowVisibilityTextures(this.targets.shadowVisibility);
        const Array<TextureHandle, 1u> causticIrradianceTextures(this.targets.causticIrradiance);
        const Array<TextureHandle, 1u> surfelIrradianceTextures(this.targets.surfelIrradiance);
        const b8 shadowStateReady = this.shadowVisibilityReturnState.buildFilteredResourceSubset(finalState.value(), Span<TextureHandle>(shadowVisibilityTextures), Span<BufferHandle>(), this.shadowStateCandidate);
        const b8 causticStateReady = this.causticIrradianceReturnState.buildFilteredResourceSubset(finalState.value(), Span<TextureHandle>(causticIrradianceTextures), Span<BufferHandle>(), this.causticStateCandidate);
        const b8 surfelStateReady = this.surfelIrradianceReturnState.buildFilteredResourceSubset(finalState.value(), Span<TextureHandle>(surfelIrradianceTextures), Span<BufferHandle>(), this.surfelStateCandidate);
        this.finalStateReady = shadowStateReady && causticStateReady && surfelStateReady;
        return this.finalStateReady;
    }
    public b8 accepted(in QueueSubmissionToken token){
        if(!this.finalStateReady)
            return false;

        const b8 shadowStateReady = this.shadowVisibilityReturnState.commit(this.shadowStateCandidate);
        const b8 causticStateReady = this.causticIrradianceReturnState.commit(this.causticStateCandidate);
        const b8 surfelStateReady = this.surfelIrradianceReturnState.commit(this.surfelStateCandidate);
        this.acceptedStateReady = shadowStateReady && causticStateReady && surfelStateReady;
        return this.acceptedStateReady;
    }
}

class SurfelCounterReadbackAcceptance{
    public mut GpuPersistentResourceStateCache surfelGiCounterPersistentState;
    public mut RendererRayTracingSystem raytracingSystem;
    public mut GpuPersistentStateCandidate candidate;
    public Span<BufferHandle> buffers;
    public b8 finalStateReady = false;
    public b8 acceptedStateReady = false;

    public SurfelCounterReadbackAcceptance(
        mut GpuPersistentResourceStateCache surfelGiCounterPersistentState,
        mut RendererRayTracingSystem raytracingSystem,
        mut GpuPersistentStateCandidate candidate,
        in Span<BufferHandle> buffers
    ){
        this.surfelGiCounterPersistentState = surfelGiCounterPersistentState;
        this.raytracingSystem = raytracingSystem;
        this.candidate = candidate;
        this.buffers = buffers;
    }

    [cpp_unwind]
    public b8 recorded(in Optional<in CommandListResourceStateHandoff> finalState){
        if(this.buffers.empty())
            return false;
        this.finalStateReady = finalState.has_value() && this.surfelGiCounterPersistentState.buildFilteredResourceSubset(finalState.value(), Span<TextureHandle>(), this.buffers, this.candidate);
        return this.finalStateReady;
    }
    public b8 accepted(in QueueSubmissionToken token){
        if(!this.finalStateReady)
            return false;
        this.acceptedStateReady = this.surfelGiCounterPersistentState.commit(this.candidate);
        if(this.acceptedStateReady)
            this.raytracingSystem.confirmSurfelCountReadbackSubmission(token);
        return this.acceptedStateReady;
    }
}

[cpp_unwind]
b8 FrameExecutePresentTails::executeSurfelCounterReadback(in Optional<GpuPhysicalQueueInfo> readbackQueue, in Span<BufferHandle> counterBuffers){
    mut RendererFramePipeline renderer = this.m_renderer;
    if(!renderer.m_surfelGiGraph.m_deferredSurfelGiCounterReadbackTask.valid())
        return true;

    // No normal-frame consumer; record only after Present.
    const b8 readbackTailAvailable = IsDeferredTransferTailAvailable(
        this.m_finalPresentationSubmissionToken.valid(),
        renderer.m_deferredLightingTaskGraphScheduled,
        true,
        this.m_compiledPlan.findTask(renderer.m_surfelGiGraph.m_deferredSurfelGiCounterReadbackTask).valid(),
        readbackQueue.has_value(),
        readbackQueue.has_value() && (cast<u8>(readbackQueue.value().capabilities) & cast<u8>(GpuQueueCapability::Transfer)) != 0u
    );
    if(!readbackTailAvailable){
        renderer.m_deferredLightingSubmissionTransaction.rejectTask(
            renderer.m_deferredLightingTaskGraph,
            renderer.m_deferredLightingCompiledGraph,
            renderer.m_surfelGiGraph.m_deferredSurfelGiCounterReadbackTask,
            renderer.m_deferredLightingRecordedGraph.recordingAttemptGeneration()
        );
        warning("RendererSystem: deferred surfel counter-readback tail was unavailable");
    }
    else{
        GpuPersistentStateCandidate readbackCounterStateCandidate(renderer.m_surfelGiCounterPersistentState);
        // Keep the candidate private until Transfer accepts.
        SurfelCounterReadbackAcceptance readbackContext(renderer.m_surfelGiCounterPersistentState, renderer.m_raytracingSystem, readbackCounterStateCandidate, counterBuffers);
        const GpuTaskGraphTaskRecordedCallback readbackRecordedCallback = MakeGpuTaskRecordedCallback(renderer.m_surfelGiGraph.m_deferredSurfelGiCounterReadbackTask, readbackContext);
        const GpuTaskGraphTaskAcceptedCallback readbackAcceptedCallback = MakeGpuTaskAcceptedCallback(renderer.m_surfelGiGraph.m_deferredSurfelGiCounterReadbackTask, readbackContext);
        in GpuTaskScheduler scheduler = renderer.m_graphics.gpuTasks();
        const b8 readbackAccepted = scheduler.executeTask(
            renderer.m_deferredLightingCompiledGraph,
            renderer.m_surfelGiGraph.m_deferredSurfelGiCounterReadbackTask,
            readbackRecordedCallback,
            readbackAcceptedCallback,

            renderer.m_deferredLightingTaskGraph,
            renderer.m_deferredLightingRecordedGraph,
            renderer.m_deferredLightingSubmissionTransaction,
            renderer.m_graphics.gpuTiming()
        );
        const QueueSubmissionToken readbackSubmissionToken = renderer.m_deferredLightingSubmissionTransaction.taskToken(this.m_compiledPlan, renderer.m_surfelGiGraph.m_deferredSurfelGiCounterReadbackTask);
        if(!readbackSubmissionToken.valid())
            warning("RendererSystem: deferred surfel counter-readback record/submission was rejected");
        else if(!readbackAccepted || !readbackContext.acceptedStateReady){
            error("RendererSystem: accepted surfel counter-readback tail lost its retained state");
            this.m_recovery.failFrameRenderRecovery();
            return false;
        }
        else{
            // Publish only after retained state commits.
            assert(renderer.m_raytracingSystem.surfelCountReadbackSubmissionMatches(readbackSubmissionToken));
        }
    }
    return true;
}

[cpp_unwind]
void FrameExecutePresentTails::executeLaggedLightingHistoryCapture(mut DeferredFrameTargets targets, in Optional<GpuPhysicalQueueInfo> historyQueue, in b8 requestsCapture, in b8 captureDeclared, in b8 laggedAsyncLightingSchedule){
    mut RendererFramePipeline renderer = this.m_renderer;
    if(requestsCapture && !captureDeclared){
        // Present already completed; force next frame through bootstrap.
        warning("RendererSystem: deferred lagged lighting-history tail was unavailable; reverting to current-frame lighting");
        renderer.invalidateLaggedLightingHistorySubmission();
    }
    else if(captureDeclared){
        // The history copy depends on Present; publication needs accepted presentation.
        if(!IsDeferredTransferTailAvailable(
            this.m_finalPresentationSubmissionToken.valid(),
            renderer.m_deferredLightingTaskGraphScheduled,
            renderer.m_deferredLaggedLightingHistoryTask.valid(),
            this.m_compiledPlan.findTask(renderer.m_deferredLaggedLightingHistoryTask).valid(),
            historyQueue.has_value(),
            historyQueue.has_value() && (cast<u8>(historyQueue.value().capabilities) & cast<u8>(GpuQueueCapability::Transfer)) != 0u
        )){
            if(renderer.m_deferredLightingTaskGraphScheduled){
                if(!renderer.m_deferredLightingSubmissionTransaction.discardUnaccepted(renderer.m_deferredLightingTaskGraph, renderer.m_deferredLightingCompiledGraph, renderer.m_deferredLightingRecordedGraph.recordingAttemptGeneration()))
                    renderer.m_graphics.requestDeviceRecreation();
            }
            warning("RendererSystem: deferred lagged lighting-history tail was unavailable; reverting to current-frame lighting");
            renderer.invalidateLaggedLightingHistorySubmission();
        }
        else{
            GpuPersistentStateCandidate shadowHistoryReturnStateCandidate(renderer.m_shadowVisibilityReturnState);
            GpuPersistentStateCandidate causticHistoryReturnStateCandidate(renderer.m_causticIrradianceReturnState);
            GpuPersistentStateCandidate surfelHistoryReturnStateCandidate(renderer.m_surfelIrradianceReturnState);
            FrameHistoryCopyAcceptance historyCopyAcceptance(renderer.m_shadowVisibilityReturnState, renderer.m_causticIrradianceReturnState, renderer.m_surfelIrradianceReturnState, targets,
                shadowHistoryReturnStateCandidate, causticHistoryReturnStateCandidate, surfelHistoryReturnStateCandidate);
            const GpuTaskGraphTaskRecordedCallback historyCopyRecordedCallback = MakeGpuTaskRecordedCallback(renderer.m_deferredLaggedLightingHistoryTask, historyCopyAcceptance);
            const GpuTaskGraphTaskAcceptedCallback historyCopyAcceptedCallback = MakeGpuTaskAcceptedCallback(renderer.m_deferredLaggedLightingHistoryTask, historyCopyAcceptance);
            in GpuTaskScheduler scheduler = renderer.m_graphics.gpuTasks();
            const b8 historyCopyAccepted = scheduler.executeTask(
                renderer.m_deferredLightingCompiledGraph,
                renderer.m_deferredLaggedLightingHistoryTask,
                historyCopyRecordedCallback,
                historyCopyAcceptedCallback,

                renderer.m_deferredLightingTaskGraph,
                renderer.m_deferredLightingRecordedGraph,
                renderer.m_deferredLightingSubmissionTransaction,
                renderer.m_graphics.gpuTiming()
            );
            const QueueSubmissionToken historyCopySubmissionToken = renderer.m_deferredLightingSubmissionTransaction.taskToken(this.m_compiledPlan, renderer.m_deferredLaggedLightingHistoryTask);
            if(historyCopySubmissionToken.valid() && (!historyCopyAccepted || !historyCopyAcceptance.acceptedStateReady)){
                if(!this.m_recovery.executeFrameRecoveryTask())
                    this.m_recovery.failFrameRenderRecovery();
                // The accepted copy cannot be replayed.
                this.m_recovery.failFrameRenderRecovery();
                return;
            }
            if(!historyCopyAccepted || !historyCopySubmissionToken.valid()){
                if(!renderer.m_deferredLightingSubmissionTransaction.discardUnaccepted(renderer.m_deferredLightingTaskGraph, renderer.m_deferredLightingCompiledGraph, renderer.m_deferredLightingRecordedGraph.recordingAttemptGeneration()))
                    renderer.m_graphics.requestDeviceRecreation();
                warning("RendererSystem: graph-owned lagged lighting-history capture record/submission was rejected; reverting to current-frame lighting");
                renderer.invalidateLaggedLightingHistorySubmission();
            }
            else{
                // The accepted hook publishes this token; keep the assertion here.
                assert(renderer.m_laggedLightingHistorySubmissionToken.queue == historyCopySubmissionToken.queue && renderer.m_laggedLightingHistorySubmissionToken.value == historyCopySubmissionToken.value);
                if(!laggedAsyncLightingSchedule)
                    renderer.reportLaggedLightingTransition(LaggedLightingReport::BootstrapAccepted, targets.laggedLightingHistory.generation);
            }
        }
    }
}


