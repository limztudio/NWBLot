    EXPECT_FALSE(self.m_context.commitFrame(2u));
    self.expectRejected(frame);
}

void VerifyUiNestedPopupReentryTests_ParentComboAutomaticPopupRowResetRejectsBeforeChildSourceCallbacks(mut UiNestedPopupReentryTests self){
    ASSERT_TRUE(self.acceptBase());
    const UiNestedPopupReentryAcceptedFrame frame = self.accepted();
    self.m_combo.open();
    ASSERT_TRUE(self.beginParent());
    ASSERT_TRUE(self.m_builder.comboBox("combo", self.m_comboSource, self.m_combo, MakeComboFixtureOptions()).valid);
    ASSERT_TRUE(self.declareChild());
    const u64 comboGeneration = self.m_combo.inputGeneration();
    const u64 listGeneration = self.m_combo.listState().inputGeneration();
    const u64 preview = self.m_combo.listState().cursorKey();
    const u64 childGeneration = self.m_childList.inputGeneration();
    self.m_comboSource.resetObservations();
    self.m_childSource.resetObservations();
    self.m_childSource.observeAttemptsOf(self.m_comboSource);
    self.m_comboSource.armText(UiNestedPopupReentryKind::Reset, self.m_builder);
    EXPECT_FALSE(self.m_builder.endPopup());
    EXPECT_EQ(self.m_comboSource.attempts(), 1u);
    EXPECT_EQ(self.m_comboSource.resetAttempts(), 1u);
    EXPECT_TRUE(self.m_comboSource.failedAtAttempt());
    EXPECT_EQ(self.m_comboSource.textCalls.value(), 1u);
    EXPECT_EQ(self.m_childSource.textCalls.value(), 0u);
    EXPECT_EQ(self.m_childSource.metadataCalls(), 0u);
    self.expectSourcePreserved(self.m_comboSource, 2404u);
    self.expectSourcePreserved(self.m_childSource, 2402u);
    EXPECT_TRUE(self.m_combo.isOpen());
    EXPECT_EQ(self.m_combo.selectedKey(), 0u);
    EXPECT_EQ(self.m_combo.inputGeneration(), comboGeneration);
    EXPECT_EQ(self.m_combo.listState().inputGeneration(), listGeneration);
    EXPECT_EQ(self.m_combo.listState().cursorKey(), preview);
    self.expectListPreserved(self.m_childList, childGeneration);
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    self.expectRejected(frame);
}

void VerifyUiNestedPopupReentryTests_LateParentRevisionScopeReentryRejectsAfterAllRowsWerePainted(mut UiNestedPopupReentryTests self){
    ASSERT_TRUE(self.acceptBase());
    const UiNestedPopupReentryAcceptedFrame frame = self.accepted();
    ASSERT_TRUE(self.beginParent());
    ASSERT_TRUE(self.m_builder.virtualList(s_UiNestedPopupRouterListKey, self.m_parentSource, self.m_parentList, MakeLargeLoanListOptions()).valid);
    ASSERT_TRUE(self.declareChild());
    ASSERT_TRUE(self.declareSibling());
    const u64 parentGeneration = self.m_parentList.inputGeneration();
    const u64 childGeneration = self.m_childList.inputGeneration();
    self.m_parentSource.resetObservations();
    self.m_childSource.resetObservations();
    self.m_siblingSource.resetObservations();
    self.m_childSource.observeAttemptsOf(self.m_parentSource);
    self.m_siblingSource.observeAttemptsOf(self.m_parentSource);
    self.m_childSource.armRevisionAfterText(self.m_parentSource, self.m_builder);
    EXPECT_FALSE(self.m_builder.endPopup());
    EXPECT_EQ(self.m_childSource.arms(), 1u);
    self.expectPanelRejected(self.m_parentSource);
    EXPECT_EQ(self.m_parentSource.textCalls.value(), 5u);
    EXPECT_EQ(self.m_childSource.textCalls.value(), 5u);
    EXPECT_EQ(self.m_siblingSource.textCalls.value(), 5u);
    self.expectSourcePreserved(self.m_parentSource, 2401u);
    self.expectSourcePreserved(self.m_childSource, 2402u);
    self.expectSourcePreserved(self.m_siblingSource, 2403u);
    self.expectListPreserved(self.m_parentList, parentGeneration);
    self.expectListPreserved(self.m_childList, childGeneration);
    EXPECT_TRUE(self.m_parent.isOpen());
    EXPECT_TRUE(self.m_child.isOpen());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    self.expectRejected(frame);
}

void VerifyUiNestedPopupRouterTests_ChildMayExtendOutsideParentWhileFocusAndPointerStayInAcceptedTopScope(mut UiNestedPopupRouterTests self){
    const PopupScope parent = MakeUiNestedPopupRouterScope(100u, 1u);
    const PopupScope child = MakeUiNestedPopupRouterScope(200u, 2u, parent.token);
    Array<PopupScope, 2u> scopes = Array<PopupScope, 2u>();
    scopes[0u] = parent;
    scopes[1u] = child;
    ASSERT_TRUE(self.install(scopes, 1u));
    ASSERT_EQ(self.m_router.popupCount(), 2u);
    const Optional<PopupScope> childScope = self.findPopupScope(child.token);
    ASSERT_TRUE(childScope.has_value());
    EXPECT_EQ(childScope.value().parent, parent.token);
    EXPECT_EQ(self.m_router.topPopupToken(), child.token);
    EXPECT_EQ(self.m_router.focus().value, 201u);
    EXPECT_EQ(self.m_router.hitTest(Point(175.0f, 125.0f)).value, 201u);
    EXPECT_FALSE(self.m_router.hitTest(Point(35.0f, 35.0f)).valid());
    self.key(Key::Tab);
    EXPECT_EQ(self.m_router.focus().value, 202u);
    self.key(Key::Tab);
    EXPECT_EQ(self.m_router.focus().value, 201u);
    self.key(Key::Tab, true);
    EXPECT_EQ(self.m_router.focus().value, 202u);
    self.key(Key::Enter);
    EXPECT_TRUE(self.m_router.consumeActivation(WidgetId(202u)));
    EXPECT_FALSE(self.m_router.consumeActivation(WidgetId(101u)));
}

void VerifyUiNestedPopupRouterTests_EscapeDismissesOnlyChildThenRestoresChosenParentFocusAfterAcceptance(mut UiNestedPopupRouterTests self){
    self.focusBase();
    const PopupScope parent = MakeUiNestedPopupRouterScope(100u, 1u);
    ASSERT_TRUE(self.installOne(parent, 2u));
    self.key(Key::Tab);
    ASSERT_EQ(self.m_router.focus().value, 102u);
    const PopupScope child = MakeUiNestedPopupRouterScope(200u, 2u, parent.token);
    Array<PopupScope, 2u> scopes = Array<PopupScope, 2u>();
    scopes[0u] = parent;
    scopes[1u] = child;
    ASSERT_TRUE(self.install(scopes, 3u));
    ASSERT_EQ(self.m_router.focus().value, 201u);
    EXPECT_TRUE(self.send(MakeUiRepeatedKeyEvent(InputEventType::KeyDown, Key::Escape, false)).commandConsumed);
    PopupDismissReason reason = PopupDismissReason::None;
    const auto reasonResult1 = self.m_router.consumePopupDismissal(child.token);
    ASSERT_TRUE(reasonResult1.has_value());
    reason = reasonResult1.value();
    EXPECT_EQ(reason, PopupDismissReason::Cancel);
    EXPECT_FALSE(self.m_router.consumePopupDismissal(parent.token).has_value());
    EXPECT_FALSE(self.m_router.focus().valid());
    ASSERT_TRUE(self.installOne(parent, 4u));
    EXPECT_EQ(self.m_router.focus().value, 102u);
    EXPECT_TRUE(self.send(MakeUiRepeatedKeyEvent(InputEventType::KeyDown, Key::Escape, true)).commandConsumed);
    EXPECT_FALSE(self.m_router.consumePopupDismissal(parent.token).has_value());
    EXPECT_EQ(self.m_router.focus().value, 102u);
    EXPECT_TRUE(self.send(MakeUiRepeatedKeyEvent(InputEventType::KeyUp, Key::Escape, false)).commandConsumed);
    self.key(Key::Escape);
    const auto reasonResult2 = self.m_router.consumePopupDismissal(parent.token);
    ASSERT_TRUE(reasonResult2.has_value());
    reason = reasonResult2.value();
    EXPECT_EQ(reason, PopupDismissReason::Cancel);
}

void VerifyUiNestedPopupRouterTests_OptedInChildTabLeavesItsParentOpenAndAdvancesParentFocus(mut UiNestedPopupRouterTests self){
    self.focusBase();
    const PopupScope parent = MakeUiNestedPopupRouterScope(100u, 1u);
