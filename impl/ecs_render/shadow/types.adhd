f32 ShadowSlotImportanceData(in f32x4 colorIntensity, in f32x4 params, in f32x4 lightPosition, in f32x4 cameraPosition){
    const f32 radiantImportance = CausticSlotImportanceData(colorIntensity);
    if(params.y < s_LightTypeDirectionalMax)
        return radiantImportance * s_DirectionalShadowImportanceBoost + 1.0f;

    const f32x4 delta = f32x4(lightPosition.x - cameraPosition.x, lightPosition.y - cameraPosition.y, lightPosition.z - cameraPosition.z, 0.0f);
    const f32 distanceSquared = dot(delta, delta);
    const f32 range = max(params.x, 0.0f);
    const f32 rangeSquared = range * range;
    f32 coverageSquared = 1.0f;
    if(distanceSquared > s_ShadowImportanceDistanceSquaredEpsilon)
        coverageSquared = rangeSquared / distanceSquared;
    return radiantImportance * min(coverageSquared, 1.0f);
}

u32 SelectNextShadowSlotLightIndex(in Span<SceneLightGpuData> lights, in Span<f32> shadowImportance){
    const u32 lightCount = cast<u32>(lights.size());
    f32 bestImportance = -1.0f;
    u32 bestIndex = lightCount;
    for(u32 i = 0u; i < lightCount && i < cast<u32>(shadowImportance.size()); ++i){
        if(lights[i].params.z >= 0.0f)
            continue;
        const f32 importance = shadowImportance[i];
        if(importance > bestImportance){
            bestImportance = importance;
            bestIndex = i;
        }
    }
    return bestIndex;
}

u32 ResolveSoftShadowSlotMask(in Span<SceneLightGpuData> lights){
    u32 mask = 0u;
    for(usize i = 0u; i < lights.size(); ++i){
        const f32 slot = lights[i].params.z;
        if(slot >= 0.0f){
            const u32 slotIndex = cast<u32>(slot);
            if(slotIndex < s_SceneShadowSlotCount)
                mask |= (1u << slotIndex);
        }
    }
    return mask;
}
const u64 s_RtFnv64Prime = 1099511628211ull;

void RtFnv64AppendU32(mut u64 hash, in u32 value){
    hash = (hash ^ cast<u64>(value & 0xffu)) * s_RtFnv64Prime;
    hash = (hash ^ cast<u64>((value >> 8u) & 0xffu)) * s_RtFnv64Prime;
    hash = (hash ^ cast<u64>((value >> 16u) & 0xffu)) * s_RtFnv64Prime;
    hash = (hash ^ cast<u64>((value >> 24u) & 0xffu)) * s_RtFnv64Prime;
}

void RtFnv64AppendF32x4(mut u64 hash, in f32x4 value){
    RtFnv64AppendU32(hash, bit_cast<u32>(value.x));
    RtFnv64AppendU32(hash, bit_cast<u32>(value.y));
    RtFnv64AppendU32(hash, bit_cast<u32>(value.z));
    RtFnv64AppendU32(hash, bit_cast<u32>(value.w));
}

// Only accepted static scene/light identities can authorize a reduced per-pixel sampling budget.
class SoftwareTransparentSamplingHistory{
    public void prepareScene(in RayTracingSceneContentStamp scene){
        this.m_scene = scene;
        this.m_lightingPrepared = false;
    }

    public void prepareLighting(in Span<SceneLightGpuData> lights){
        const u32 lightCount = cast<u32>(lights.size());
        u64 hash = s_RtFnv64OffsetBasis;
        RtFnv64AppendU32(hash, lightCount);
        for(usize i = 0u; i < lights.size(); ++i){
            RtFnv64AppendF32x4(hash, lights[i].position);
            RtFnv64AppendF32x4(hash, lights[i].direction);
            RtFnv64AppendF32x4(hash, lights[i].colorIntensity);
            RtFnv64AppendF32x4(hash, lights[i].params);
            RtFnv64AppendF32x4(hash, lights[i].params2);
        }
        this.m_lightHash = hash;
        this.m_lightingPrepared = true;
    }

    public void accept(){
        this.m_acceptedScene = this.m_scene;
        this.m_acceptedLightHash = this.m_lightHash;
        this.m_accepted = this.m_scene.trusted && this.m_lightingPrepared;
    }

    public void discard(){
        this.m_accepted = false;
    }

    public b8 usable()const{
        return
            this.m_accepted
            && this.m_lightingPrepared
            && this.m_scene.trusted
            && this.m_acceptedScene.trusted
            && this.m_scene.geometry == this.m_acceptedScene.geometry
            && this.m_scene.material == this.m_acceptedScene.material
            && this.m_lightHash == this.m_acceptedLightHash
        ;
    }

    private RayTracingSceneContentStamp m_scene;
    private RayTracingSceneContentStamp m_acceptedScene;
    private u64 m_lightHash = 0u;
    private u64 m_acceptedLightHash = 0u;
    private b8 m_lightingPrepared = false;
    private b8 m_accepted = false;
}


