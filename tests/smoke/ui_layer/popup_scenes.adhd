namespace __hidden_ui_nested_popup_source{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static constexpr Array<StringView, 5u> s_Labels{ "Alpha", "Beta", "Gamma (disabled)", "Delta", "Echo" };


