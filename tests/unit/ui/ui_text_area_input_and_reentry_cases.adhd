void VerifyUiTextAreaNavigationTests_EmptyDocumentResolvesEveryDirectionWithoutMoving(mut UiTextAreaNavigationTests self){
    Array<EditNavigationDirectionEnum, 4u> directions;
    directions[0u] = EditNavigationDirection::Up;
    directions[1u] = EditNavigationDirection::Down;
    directions[2u] = EditNavigationDirection::PageUp;
    directions[3u] = EditNavigationDirection::PageDown;
    for(in EditNavigationDirectionEnum direction : directions){
        const auto result = self.resolve(direction, 160.0f);
        ASSERT_TRUE(result.has_value());
        EXPECT_EQ(result.value().committedByte, 0u);
        EXPECT_FLOAT_EQ(result.value().preferredX, 0.0f);
    }
}

void VerifyUiTextAreaNavigationTests_ZeroViewportAllowsAdjacentNavigationAndRejectsPages(mut UiTextAreaNavigationTests self){
    ASSERT_TRUE(self.m_model.setText("MM\nMM"));
    ASSERT_TRUE(self.m_model.setSelection(1u, 1u));
    EXPECT_TRUE(self.resolve(EditNavigationDirection::Down, 0.0f).has_value());
    EXPECT_FALSE(self.resolve(EditNavigationDirection::PageDown, 0.0f).has_value());
    EXPECT_FALSE(self.resolve(EditNavigationDirection::PageUp, 0.0f).has_value());
    EXPECT_EQ(self.m_model.caret(), 1u);
