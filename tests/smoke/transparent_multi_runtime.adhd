namespace NWB::Tests::Smoke{
[[nodiscard]] inline TStringView TransparentMultiProjectName()noexcept{
    return NWB_TEXT("TransparentMultiSmokeProjectImpl");
}

[[nodiscard]] inline TStringView CausticSphereProjectName()noexcept{
    return NWB_TEXT("CausticSphereSmokeProject");
}

[[nodiscard]] inline TStringView TransparentMultiFpsLabel()noexcept{
#if defined(NWB_TRANSPARENT_MULTI_FRAME_LAGGED_ASYNC_LIGHTING_SMOKE)
    return NWB_TEXT("FrameLaggedAsyncLightingSmokeProject");
#elif defined(NWB_TRANSPARENT_MULTI_ENABLE_CSG)
    return NWB_TEXT("TransparentCsgSmokeProject");
#elif defined(NWB_TRANSPARENT_MULTI_CAUSTIC_SPHERE)
    return CausticSphereProjectName();
#else
    return TransparentMultiProjectName();
#endif
}

#if defined(NWB_TRANSPARENT_MULTI_CAUSTIC_SPHERE)
inline constexpr f32 s_TransparentSceneDefaultRotationSpeed = 0.0f;
#else
inline constexpr f32 s_TransparentSceneDefaultRotationSpeed = 0.55f;
#endif
inline constexpr f32 s_TransparentMultiQuietNaN = Limit<f32>::s_QuietNaN;
inline constexpr i32 s_TransparentMultiKeyF1 = Core::Key::F1;
inline constexpr u32 s_CausticSphereTemporalPhaseCount = Impl::s_CausticTemporalPhaseCount;

[[nodiscard]] inline NotNullUniquePtr<Core::ECS::World> CreateTransparentMultiWorldOrDie(ProjectRuntimeContext& context){
    auto world = CreateSmokeWorldOrDie(TransparentMultiProjectName(), context);
    ConfigureTransparentMultiRenderer(*world, context);
    return world;
}
};


