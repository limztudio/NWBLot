    EXPECT_FALSE(self.m_router.focus().valid());
    const Vector<PopupScope> noPopups = Vector<PopupScope>();
    ASSERT_TRUE(self.m_router.commitTargets(self.m_targets, 2u, noPopups, self.m_router.focusLossGeneration()));
