    [cpp_unwind]
    public b8 validateResources(){
        if(!this.m_graphics.has_value() || !this.m_assetManager.has_value())
            return false;

        mut GraphicsRuntime graphics = this.m_graphics.value();
        mut Device device = graphics.getDevice();
        in GpuDescriptorHeap heap = device.getDescriptorHeap();
        if(!heap.isInitialized())
            return false;

        const u16 generation = device.getDeviceGeneration();
        if(this.m_deviceGeneration != 0u && this.m_deviceGeneration != generation)
            this.invalidateResources();
        this.m_deviceGeneration = generation;

        if(this.m_pipelinesReady)
            return true;

        if(!this.m_activeSceneSubsystems.has_value())
            return false;

        if(!this.m_bindingLayout.valid()){
            BindingLayoutDesc desc;
            desc.setVisibility(ShaderTypeMask::Compute);
            desc.addItem(BindingLayoutItemPushConstants(0u, s_GpuPushConstantsBytes));
            const Expected<BindingLayoutHandle> layoutRes = device.createBindingLayout(desc);
            if(!layoutRes.has_value())
                return false;
            this.m_bindingLayout = layoutRes.value();
        }

        mut AssetManager assets = this.m_assetManager.value();
        if(!LoadPhysicsComputePipeline(graphics, assets, this.m_shaderPathResolver, this.m_bindingLayout, this.resolveShaderAssetName(0u), s_PhysicsShaderDefaultVariant, Name("physics/broadphase_aabb_cs"), this.m_broadphaseShader, this.m_broadphasePipeline))
            return false;
        if(!LoadPhysicsComputePipeline(graphics, assets, this.m_shaderPathResolver, this.m_bindingLayout, this.resolveShaderAssetName(1u), s_PhysicsShaderNpPrimVariant, Name("physics/narrowphase_cs_prim"), this.m_narrowphasePrimShader, this.m_narrowphasePrimPipeline))
            return false;
        if(!LoadPhysicsComputePipeline(graphics, assets, this.m_shaderPathResolver, this.m_bindingLayout, this.resolveShaderAssetName(1u), s_PhysicsShaderNpComplexVariant, Name("physics/narrowphase_cs_complex"), this.m_narrowphaseComplexShader, this.m_narrowphaseComplexPipeline))
            return false;
        if(!LoadPhysicsComputePipeline(graphics, assets, this.m_shaderPathResolver, this.m_bindingLayout, this.resolveShaderAssetName(1u), s_PhysicsShaderNpBulletToiVariant, Name("physics/narrowphase_cs_toi"), this.m_bulletToiShader, this.m_bulletToiPipeline))
            return false;
        if(!LoadPhysicsComputePipeline(graphics, assets, this.m_shaderPathResolver, this.m_bindingLayout, this.resolveShaderAssetName(2u), s_PhysicsShaderDefaultVariant, Name("physics/solver_integrate_velocities_cs"), this.m_integrateVelShader, this.m_integrateVelPipeline))
            return false;
        if(!LoadPhysicsComputePipeline(graphics, assets, this.m_shaderPathResolver, this.m_bindingLayout, this.resolveShaderAssetName(3u), s_PhysicsShaderDefaultVariant, Name("physics/solver_contacts_cs"), this.m_contactsShader, this.m_contactsPipeline))
            return false;
        if(!LoadPhysicsComputePipeline(graphics, assets, this.m_shaderPathResolver, this.m_bindingLayout, this.resolveShaderAssetName(4u), s_PhysicsShaderDefaultVariant, Name("physics/solver_integrate_positions_cs"), this.m_integratePosShader, this.m_integratePosPipeline))
            return false;
        if(!LoadPhysicsComputePipeline(graphics, assets, this.m_shaderPathResolver, this.m_bindingLayout, this.resolveShaderAssetName(5u), s_PhysicsShaderDefaultVariant, Name("physics/solver_finalize_bodies_cs"), this.m_finalizeShader, this.m_finalizePipeline))
            return false;
        if(!LoadPhysicsComputePipeline(graphics, assets, this.m_shaderPathResolver, this.m_bindingLayout, this.resolveShaderAssetName(6u), s_PhysicsShaderDefaultVariant, Name("physics/solver_joints_cs"), this.m_jointsShader, this.m_jointsPipeline))
            return false;
        if(!LoadPhysicsComputePipeline(graphics, assets, this.m_shaderPathResolver, this.m_bindingLayout, this.resolveShaderAssetName(7u), s_PhysicsShaderIslandSmallVariant, Name("physics/solver_islands_cs"), this.m_islandsShader, this.m_islandsPipeline))
            return false;
        if(!LoadPhysicsComputePipeline(graphics, assets, this.m_shaderPathResolver, this.m_bindingLayout, this.resolveShaderAssetName(7u), s_PhysicsShaderIslandLargeVariant, Name("physics/solver_large_islands_cs"), this.m_largeIslandsShader, this.m_largeIslandsPipeline))
            return false;
        if(!LoadPhysicsComputePipeline(graphics, assets, this.m_shaderPathResolver, this.m_bindingLayout, this.resolveShaderAssetName(8u), s_PhysicsShaderJointIslandMixVariant, Name("physics/solver_joint_islands_cs"), this.m_jointIslandsShader, this.m_jointIslandsPipeline))
            return false;
        if(!LoadPhysicsComputePipeline(graphics, assets, this.m_shaderPathResolver, this.m_bindingLayout, this.resolveShaderAssetName(8u), s_PhysicsShaderJointIslandOnlyVariant, Name("physics/solver_joint_only_islands_cs"), this.m_jointOnlyIslandsShader, this.m_jointOnlyIslandsPipeline))
            return false;
        if(!LoadPhysicsComputePipeline(graphics, assets, this.m_shaderPathResolver, this.m_bindingLayout, this.resolveShaderAssetName(9u), s_PhysicsShaderDefaultVariant, Name("physics/lbvh_broadphase_cs"), this.m_lbvhBroadphaseShader, this.m_lbvhBroadphasePipeline))
            return false;
        if(!LoadPhysicsComputePipeline(graphics, assets, this.m_shaderPathResolver, this.m_bindingLayout, this.resolveShaderAssetName(10u), s_PhysicsShaderDefaultVariant, Name("physics/gpu_resident_step_cs"), this.m_gpuResidentStepShader, this.m_gpuResidentStepPipeline))
            return false;
        if(!LoadPhysicsComputePipeline(graphics, assets, this.m_shaderPathResolver, this.m_bindingLayout, this.resolveShaderAssetName(11u), s_PhysicsShaderDefaultVariant, Name("physics/spatial_query_cs"), this.m_spatialQueryShader, this.m_spatialQueryPipeline))
            return false;
        if(!LoadPhysicsComputePipeline(graphics, assets, this.m_shaderPathResolver, this.m_bindingLayout, this.resolveShaderAssetName(12u), s_PhysicsShaderDefaultVariant, Name("physics/export_render_transforms_cs"), this.m_exportRenderTransformsShader, this.m_exportRenderTransformsPipeline))
            return false;

        this.m_pipelinesReady = true;
        return true;
    }

    [cpp_unwind]
    private b8 ensureComputeCommandList(mut Device device){
        if(this.m_lastComputeToken.valid()){
            if(!device.waitForSubmissionToken(this.m_lastComputeToken))
                return false;
            this.m_lastComputeToken = QueueSubmissionToken();
        }
        if(this.m_computeCommandList.valid() && this.m_computeQueue.valid())
            return true;

        GpuPhysicalQueueId q = device.getPrimaryPhysicalQueue(CommandQueue::Compute);
        CommandQueue qt = CommandQueue::Compute;
        if(!q.valid()){
            q = device.getPrimaryPhysicalQueue(CommandQueue::Graphics);
            qt = CommandQueue::Graphics;
        }
        if(!q.valid())
            return false;

        CommandListParameters params;
        params.setQueueType(qt).setPhysicalQueue(q);
        const auto clRes = device.createCommandList(params);
        if(!clRes.has_value() || !clRes.value().valid())
            return false;

        this.m_computeCommandList = clRes.value();
        this.m_computeQueue = q;
        return true;
    }

    [cpp_unwind]
    private Expected<QueueSubmissionToken> submitComputeCommandList(
        mut Device device,
        mut CommandList commands,
        in b8 recorded
    ){
        commands.setEnableAutomaticBarriers(true);
        commands.close();
        if(!recorded || commands.commandRecordingFailed())
            return MakeUnexpected(Failure());

        QueueSubmissionDesc submitDesc;
        const auto receipt = device.executeCommandLists(commands, this.m_computeQueue, submitDesc);
        if(!receipt.has_value() || !receipt.value().token.valid())
            return MakeUnexpected(Failure());

        this.m_lastComputeToken = receipt.value().token;
        return receipt.value().token;
    }

    [cpp_unwind]
    private Expected<QueueSubmissionToken> submitCollisionAsync(
        mut Device device,
        mut GpuDescriptorHeap heap,
        in PhysicsGpuBufferGroup bufGroup,
        in Span<GpuPhysicsBodyPose> staticPoses,
        in Span<GpuPhysicsBodyPose> sleepingPoses,
        in Span<GpuPhysicsBodyPose> awakePoses,
        in Span<GpuPhysicsShapeProxy> staticShapes,
        in Span<GpuPhysicsShapeProxy> sleepingShapes,
        in Span<GpuPhysicsShapeProxy> awakeShapes,
        in Span<f32x4> hullVertices,
        in Span<f32x4> meshNodes,
        in Span<f32x4> meshTris,
        in Span<u32> nonCollideTable,
        in u32 hullUploadOffset,
        in u32 meshNodeUploadOffset,
        in u32 meshTriUploadOffset,
        in u32 staticBodyCount,
        in u32 awakeBodyOffset,
        in u32 staticShapeCount,
        in u32 awakeShapeOffset,
        in u32 awakeShapeCount,
        in u32 shapeCount,
        in u32 updateAabbOffset,
        in u32 updateAabbCount,
        in u32 maxPairs,
        in u32 gridTableSize,
        in f32 invCellSize,
        in b8 useLbvhBroadphase,
        in u32 lbvhPaddedCount,
        in VectorSingle lbvhSceneMin,
        in VectorSingle lbvhInvExtent,
        in b8 uploadStaticGeom,
        in b8 hasComplexShapes,
        in b8 skipBroadphaseBuild
    ){
        if(!this.ensureComputeCommandList(device))
            return MakeUnexpected(Failure());
        PendingRecordingLease heapLease = heap.acquirePendingRecordingLease();
        if(!heapLease.valid())
            return MakeUnexpected(Failure());

        mut CommandList commands = this.m_computeCommandList.deref();
        commands.open();
        commands.setEnableAutomaticBarriers(false);
        const PhysicsCollisionTask task(
            heap,
            bufGroup,
            this.m_broadphasePipeline,
            this.m_lbvhBroadphasePipeline,
            this.m_narrowphasePrimPipeline,
            this.m_narrowphaseComplexPipeline,
            staticPoses,
            sleepingPoses,
            awakePoses,
            staticShapes,
            sleepingShapes,
            awakeShapes,
            hullVertices,
            meshNodes,
            meshTris,
            nonCollideTable,
            hullUploadOffset,
            meshNodeUploadOffset,
            meshTriUploadOffset,
            staticBodyCount,
            awakeBodyOffset,
            staticShapeCount,
            awakeShapeOffset,
            awakeShapeCount,
            shapeCount,
            updateAabbOffset,
            updateAabbCount,
            maxPairs,
            gridTableSize,
            invCellSize,
            useLbvhBroadphase,
            lbvhPaddedCount,
            lbvhSceneMin,
            lbvhInvExtent,
            uploadStaticGeom,
            hasComplexShapes,
            skipBroadphaseBuild
        );
        const b8 recorded = task.recordCommands(commands);
        return this.submitComputeCommandList(device, commands, recorded);
    }

    [cpp_unwind]
    private Expected<QueueSubmissionToken> submitBulletToiAsync(
        mut Device device,
        mut GpuDescriptorHeap heap,
