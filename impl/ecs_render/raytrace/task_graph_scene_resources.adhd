#include <impl/ecs_render/optics/task_graph_optical_scene_upload.adhd>
#include <impl/ecs_render/kernel/task_graph_resource_utils.adhd>
#include <impl/ecs_render/raytrace/graph_snapshots.adhd>
#include <impl/ecs_render/raytrace/types.adhd>
#include <impl/ecs_render/shared/frame_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RayTracingSceneGraphResources{
    public RayTracingSceneContentStamp contentStamp;
    public RayTracingAccelStructHandle sceneTlas;
    public GpuDescriptorHandle tlasHeapHandle;
    public BufferHandle materialContextSlotsBuffer;
    public BufferHandle instanceMaterialBuffer;
    public BufferHandle materialTypedBuffer;
    public BufferHandle instanceBuffer;
    public BufferHandle csgTraceContextBuffer;
    public Span<BufferHandle> csgTraceBoundsBuffers;
    public RayTracingOpticalSceneSnapshot opticalScene;
    public u32 materialContextSlotsHeapSlot = 0u;
    public b8 hardwareAvailable = false;

    public b8 valid()const{
        return this.hardwareAvailable
            && this.sceneTlas.valid()
            && this.tlasHeapHandle.valid()
            && this.materialContextSlotsBuffer.valid()
            && this.instanceMaterialBuffer.valid()
            && this.materialTypedBuffer.valid()
            && this.instanceBuffer.valid()
            && this.opticalScene.valid();
    }
}

class RayTracingSceneGraphReads{
    public Array<GpuTaskResourceUse, s_FixedSceneResourceUseCount> uses;
    public Vector<GpuTaskResourceUse> csgUses;

    public b8 valid()const{
        for(usize index = 0u; index < this.uses.size(); ++index){
            if(!this.uses[index].resource.valid())
                return false;
        }
        for(usize index = 0u; index < this.csgUses.size(); ++index){
            if(!this.csgUses[index].resource.valid())
                return false;
        }
        return true;
    }
}

class TraceResourceSetUses{
    public Array<GpuTaskResourceSetUse, s_TraceResourceSetUseCapacity> uses;
    public usize useCount = 0u;
}

TraceResourceSetUses MakeTraceResourceSetUses(in GpuGraphResourceSetId traceGeometrySet, in GpuGraphResourceSetId traceMaterialSampledTextureSet){
    TraceResourceSetUses result;
    if(traceGeometrySet.valid()){
        GpuTaskResourceSetUse use;
        use.resourceSet = traceGeometrySet;
        use.requiredState = ResourceStates::ShaderResource;
        use.access = GpuTaskResourceAccess::Read;
        result.uses[result.useCount++] = use;
    }
    if(traceMaterialSampledTextureSet.valid()){
        GpuTaskResourceSetUse use;
        use.resourceSet = traceMaterialSampledTextureSet;
        use.requiredState = ResourceStates::ShaderResource;
        use.access = GpuTaskResourceAccess::Read;
        result.uses[result.useCount++] = use;
    }
    return result;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
b8 AppendCurrentCsgBufferRead(in BufferHandle buffer, mut GpuTaskGraph graph, mut Vector<GpuTaskResourceUse> resourceUses){
    if(!buffer.valid())
        return false;
    GpuGraphResourceId resource;
    {
        const GpuTaskGraphDeclarationReadView declarations(graph);
        if(!declarations.valid())
            return false;
        resource = declarations.findImportedBuffer(buffer);
    }
    if(!resource.valid()){
        const auto imported = ImportExternalBuffer(graph, buffer, buffer.deref().getCreationDescription().debugName, "Current CSG Ray Geometry");
        if(!imported.has_value())
            return false;
        resource = imported.value();
    }
    if(!resource.valid())
        return false;
    resourceUses.push_back(ReadUse(resource));
    return true;
}

[cpp_unwind]
b8 AppendCurrentCsgRayGeometry(in BufferHandle context, in Span<BufferHandle> bounds, mut GpuTaskGraph graph, mut Vector<GpuTaskResourceUse> resourceUses){
    if(!context.valid())
        return true;
    if(!AppendCurrentCsgBufferRead(context, graph, resourceUses))
        return false;
    for(in BufferHandle buffer : bounds){
        if(!AppendCurrentCsgBufferRead(buffer, graph, resourceUses))
            return false;
    }
    return true;
}

[cpp_unwind]
b8 AppendRayTracingSceneShadowBuffers(in RayTracingDeferredGraphResourceSnapshot rayTracingResources, mut GpuTaskGraph graph, mut Vector<GpuTaskResourceUse> resourceUses){
    Array<BufferHandle, s_SceneShadowBufferCount> sceneShadowBuffers;
    sceneShadowBuffers[0u] = rayTracingResources.sceneBvhNodeBuffer;
    sceneShadowBuffers[1u] = rayTracingResources.sceneInstanceBuffer;
    sceneShadowBuffers[2u] = rayTracingResources.shadowInstanceMaterialBuffer;
    sceneShadowBuffers[3u] = rayTracingResources.shadowMaterialTypedBuffer;
    sceneShadowBuffers[4u] = rayTracingResources.shadowInstanceBuffer;
    Array<Name, s_SceneShadowBufferCount> sceneShadowIdentities;
    sceneShadowIdentities[0u] = Name(s_SceneBvhNodesName);
    sceneShadowIdentities[1u] = Name(s_SceneInstancesName);
    sceneShadowIdentities[2u] = Name(s_SceneShadowInstanceMaterialName);
    sceneShadowIdentities[3u] = Name(s_SceneShadowMaterialTypedName);
    sceneShadowIdentities[4u] = Name(s_SceneShadowInstancesName);
    Array<StringView, s_SceneShadowBufferCount> sceneShadowLabels;
    sceneShadowLabels[0u] = s_SceneBvhNodesLabel;
    sceneShadowLabels[1u] = s_SceneInstancesLabel;
    sceneShadowLabels[2u] = s_SceneShadowInstanceMaterialLabel;
    sceneShadowLabels[3u] = s_SceneShadowMaterialTypedLabel;
    sceneShadowLabels[4u] = s_SceneShadowInstancesLabel;
    for(usize bufferIndex = 0u; bufferIndex < s_SceneShadowBufferCount; ++bufferIndex){
        in BufferHandle buffer = sceneShadowBuffers[bufferIndex];
        if(!buffer.valid())
            continue;
        const auto resourceResult = ImportExternalBuffer(graph, buffer, sceneShadowIdentities[bufferIndex], sceneShadowLabels[bufferIndex]);
        if(!resourceResult.has_value())
            return false;
        const GpuGraphResourceId resource = resourceResult.value();
        resourceUses.push_back(ReadUse(resource, ResourceStates::ShaderResource));
    }
    return true;
}

[cpp_unwind]
Expected<RayTracingSceneGraphReads> ImportRayTracingSceneGraphReads(in RayTracingSceneGraphResources resources, in ResourceStates tlasInitialState, in borrow GpuTaskId priorReadersDrained, mut GpuTaskGraph graph){
    if(!resources.valid())
        return MakeUnexpected(Failure());

    Array<BufferHandle, s_SceneImportedBufferCount> buffers;
    buffers[0u] = resources.materialContextSlotsBuffer;
    buffers[1u] = resources.instanceMaterialBuffer;
    buffers[2u] = resources.materialTypedBuffer;
    buffers[3u] = resources.instanceBuffer;
    Array<GpuGraphResourceId, s_SceneImportedBufferCount> importedBuffers;
    {
        const GpuTaskGraphDeclarationReadView declarations(graph);
        if(!declarations.valid())
            return MakeUnexpected(Failure());
        for(usize index = 0u; index < s_SceneImportedBufferCount; ++index)
            importedBuffers[index] = declarations.findImportedBuffer(buffers[index]);
    }
    for(usize index = 0u; index < s_SceneImportedBufferCount; ++index){
        if(importedBuffers[index].valid())
            continue;
        in BufferHandle buffer = buffers[index];
        const Name identity = buffer.deref().getCreationDescription().debugName;
        if(identity == Name())
            return MakeUnexpected(Failure());
        const auto importedBufferResult = graph.importBuffer(buffer, BufferResourceDesc(identity, "Ray Scene Buffer"));
        if(!importedBufferResult.has_value())
            return MakeUnexpected(Failure());
        importedBuffers[index] = importedBufferResult.value();
    }

    GpuGraphResourceDesc tlasDesc = AccelStructResourceDesc(Name(s_SceneTlasResourceName), s_SceneTlasResourceLabel);
    tlasDesc.setInitialState(tlasInitialState);
    const auto tlasResult = graph.importAccelStruct(resources.sceneTlas, tlasDesc);
    if(!tlasResult.has_value())
        return MakeUnexpected(Failure());
    const GpuGraphResourceId tlas = tlasResult.value();

    auto opticalResult = ImportRayTracingOpticalSceneBuffer(resources.opticalScene, priorReadersDrained, graph);
    if(!opticalResult.has_value())
        return MakeUnexpected(Failure());
    const RayTracingOpticalSceneGraphBuffer optical = opticalResult.value();

    RayTracingSceneGraphReads result;
    result.uses[0] = ReadUse(tlas, ResourceStates::AccelStructRead);
    for(usize index = 0u; index < s_SceneImportedBufferCount; ++index){
        ResourceStates state = ResourceStates::ShaderResource;
        if(index == 0u)
            state = ResourceStates::ConstantBuffer;
        result.uses[index + 1u] = ReadUse(importedBuffers[index], state);
    }
    result.uses[result.uses.size() - 1u] = ReadUse(optical.resource);
    if(resources.csgTraceContextBuffer.valid()){
        result.csgUses.reserve(1u + resources.csgTraceBoundsBuffers.size());
        if(!AppendCurrentCsgRayGeometry(resources.csgTraceContextBuffer, resources.csgTraceBoundsBuffers, graph, result.csgUses))
            return MakeUnexpected(Failure());
    }
    return result;
}


