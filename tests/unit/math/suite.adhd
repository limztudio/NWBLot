MatrixSingle MakeIdentitySingle(){
    return MatrixIdentity();
}

MatrixSingle MakeScalingSingle(in f32 sx, in f32 sy, in f32 sz){
    return MatrixScaling(sx, sy, sz);
}

MatrixDouble MakeScalingDouble(in f64 sx, in f64 sy, in f64 sz){
    return MatrixDoubleScaling(sx, sy, sz);
}

MatrixSingle MakeTranslationSingle(in f32 tx, in f32 ty, in f32 tz){
    return MatrixTranslation(tx, ty, tz);
}

MatrixDouble MakeTranslationDouble(in f64 tx, in f64 ty, in f64 tz){
    return MatrixDoubleTranslation(tx, ty, tz);
}

MatrixSingle MakeRowsSingle(in VectorSingle r0, in VectorSingle r1, in VectorSingle r2, in VectorSingle r3){
    return MatrixSet(r0.x, r0.y, r0.z, r0.w, r1.x, r1.y, r1.z, r1.w, r2.x, r2.y, r2.z, r2.w, r3.x, r3.y, r3.z, r3.w);
}

MatrixDouble MakeRowsDouble(in VectorDouble r0, in VectorDouble r1, in VectorDouble r2, in VectorDouble r3){
    return MatrixDoubleSet(r0.x, r0.y, r0.z, r0.w, r1.x, r1.y, r1.z, r1.w, r2.x, r2.y, r2.z, r2.w, r3.x, r3.y, r3.z, r3.w);
}

