[cpp_header("<core/os/accessibility_service.h>"), cpp_name("::NWB::Core::TrackedAccessibilityService")]
extern class TrackedAccessibilityService : IAccessibilityService{
    AccessibilityCapabilities capabilities()const;
    b8 isOwnerThread()const;
    b8 publishTree(in Span<AccessibilityNodeData> nodes, in StringView textStorage, in u64 focusedId, in u64 version, in f32 scaleX, in f32 scaleY);
    b8 updateFocus(in u64 focusedId);
    b8 announce(in StringView text, in AccessibilityLiveMode politeness);
    b8 pollAction(mut AccessibilityActionEvent outEvent);
    u64 publishedVersion()const;
    usize publishedNodeCount()const;
    u64 publishedFocusedId()const;
    usize announcementCount()const;
    b8 enqueueAction(in AccessibilityActionEvent event);
    void onTreePublished(in Span<AccessibilityNodeData> nodes, in StringView textStorage, in u64 focusedId, in u64 version, in f32 scaleX, in f32 scaleY);
    void onFocusUpdated(in u64 focusedId);
    void onAnnouncement(in StringView text, in AccessibilityLiveMode politeness);
};


