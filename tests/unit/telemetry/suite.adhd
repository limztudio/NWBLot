NWB_ADHD_GTEST(AllocationOwnerTelemetry, SharedNameSumsLiveUsageAndPreservesLargestIndividualArenaPeak, VerifyAllocationOwnerTelemetry_SharedNameSumsLiveUsageAndPreservesLargestIndividualArenaPeak)
NWB_ADHD_GTEST(AllocationOwnerTelemetry, KeepsHeapBackingRecordsWithoutCountingTheirUsageAgain, VerifyAllocationOwnerTelemetry_KeepsHeapBackingRecordsWithoutCountingTheirUsageAgain)
