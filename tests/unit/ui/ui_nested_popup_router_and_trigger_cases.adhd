inline constexpr AStringView s_AfterKey = "after";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class UiNestedPopupTriggerTests : public ComboFixture{
public:
    [[nodiscard]] static WidgetOptions Control()noexcept{
        WidgetOptions options;
        options.width = { LayoutSizePolicy::Fixed, 220.0f };
        options.height = { LayoutSizePolicy::Fixed, 32.0f };
        return options;
    }


public:
    virtual void SetUp()override{
        ComboFixture::SetUp();
        m_source.count = 5u;
        m_source.disabled = 3u;
        m_parent.open();
        m_child.open();
    }

    [[nodiscard]] Optional<HitTarget> findTarget(const WidgetId widget)const noexcept{
        if(const HitTarget* found = target(widget))
            return *found;
        return {};
    }

    [[nodiscard]] b8 hasTarget(const WidgetId widget)const noexcept{
        return target(widget) != nullptr;
    }

    [[nodiscard]] WidgetId fieldId()const{ return UiTestSupport::RequireWidgetId(childId(), s_ComboKey); }

    [[nodiscard]] WidgetId rowsId()const{ return UiTestSupport::RequireWidgetId(fieldId(), s_ComboRowsKey); }

    [[nodiscard]] WidgetId anchorId()const{ return UiTestSupport::RequireWidgetId(childId(), s_AnchorKey); }

    [[nodiscard]] WidgetId menuRows()const{ return UiTestSupport::RequireWidgetId(UiTestSupport::RequireWidgetId(childId(), s_MenuKey), s_MenuRowsKey); }

    [[nodiscard]] WidgetId comboRow(const u64 key)const{
        return UiTestSupport::RequireWidgetPartId(UiTestSupport::RequireWidgetId(rowsId(), s_ListRowsKey), key);
    }

    [[nodiscard]] b8 beginChild(const u64 generation){
        if(!begin(generation) || !m_builder.beginPopup(s_ParentPopupKey, m_parent, UiWidgetTests::NestedParentOptions()))
            return false;
        if(m_builder.button("before", "Parent before", Control()))
            return false;
        return m_builder.beginPopup(s_ChildPopupKey, m_child, UiWidgetTests::NestedChildOptions());
    }

    [[nodiscard]] b8 finishChild(const u64 generation){
        if(m_builder.button(s_AfterKey, "Child after", Control()) || !m_builder.endPopup())
            return false;
        if(m_builder.button(s_AfterKey, "Parent after", Control()) || !m_builder.endPopup())
            return false;
        return m_context.endRoot() && m_context.finishFrame() && m_context.commitFrame(generation);
    }

    [[nodiscard]] b8 acceptChildCombo(const u64 generation){
        if(!beginChild(generation))
            return false;
        m_result = m_builder.comboBox(s_ComboKey, m_source, m_state, Options());
        return m_result.valid && finishChild(generation);
    }

    [[nodiscard]] b8 acceptChildMenu(const u64 generation){
        if(!beginChild(generation))
            return false;
        m_anchorActivated = m_builder.button(s_AnchorKey, "Commands", Control());
        m_menuResult = m_builder.contextMenu(s_MenuKey, s_AnchorKey, m_menuSource, m_menu);
        return m_menuResult.valid && finishChild(generation);
    }

    void expectUserParentsOpen()const{
        EXPECT_TRUE(m_parent.isOpen());
        EXPECT_TRUE(m_child.isOpen());
        ASSERT_NE(target(parentId()), nullptr);
        ASSERT_NE(target(childId()), nullptr);
        EXPECT_EQ(target(parentId())->layer, 1u);
        EXPECT_EQ(target(childId())->layer, 2u);
        EXPECT_NE(target(UiTestSupport::RequireWidgetId(parentId(), s_AfterKey)), nullptr);
        EXPECT_NE(target(UiTestSupport::RequireWidgetId(childId(), s_AfterKey)), nullptr);
    }


public:
    PopupState m_parent;
    PopupState m_child;
    ContextMenuState m_menu;
    PopupToolsSource m_menuSource;
    ContextMenuResult m_menuResult;
    b8 m_anchorActivated = false;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


