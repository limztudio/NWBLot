////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_OPTICS_DIELECTRIC_SLANGI
#define NWB_GRAPHICS_OPTICS_DIELECTRIC_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "../common/math.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


struct NwbDielectricInterface{
    float3 direction;
    float reflectedFraction;
    float radianceTransmission;
    bool totalInternalReflection;
};

// Radiance consumers store half throughput; clamp its interface factor before that storage boundary. Photon power uses the separate FP32 reflected fraction.
static const float NWB_DIELECTRIC_RADIANCE_TRANSMISSION_MAX = 65504.0;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Exact unpolarized dielectric Fresnel + Snell. The admitted half IOR range needs FP32 sums/products; photon power excludes the radiance eta-squared factor.
NwbDielectricInterface nwbDielectricTransmit(const float3 direction, const float3 opposingNormal, const float etaIncident, const float etaTransmitted){
    NwbDielectricInterface result = (NwbDielectricInterface)0;
    if(etaIncident == etaTransmitted){
        result.direction = direction;
        result.radianceTransmission = 1.0;
        return result;
    }
    const float cosineIncident = saturate(-dot(direction, opposingNormal));
    const float eta = etaIncident / etaTransmitted;
    const float sineTransmittedSquared = eta * eta * max(0.0, 1.0 - cosineIncident * cosineIncident);
    if(sineTransmittedSquared >= 1.0){
        result.direction = reflect(direction, opposingNormal);
        result.reflectedFraction = 1.0;
        result.totalInternalReflection = true;
        return result;
    }
    const float cosineTransmitted = sqrt(max(0.0, 1.0 - sineTransmittedSquared));
    const float perpendicular = (etaIncident * cosineIncident - etaTransmitted * cosineTransmitted) / (etaIncident * cosineIncident + etaTransmitted * cosineTransmitted);
    const float parallel = (etaTransmitted * cosineIncident - etaIncident * cosineTransmitted) / (etaTransmitted * cosineIncident + etaIncident * cosineTransmitted);
    result.reflectedFraction = saturate(0.5 * (perpendicular * perpendicular + parallel * parallel));
    result.direction = nwbSafeNormalize(eta * direction + (eta * cosineIncident - cosineTransmitted) * opposingNormal, direction);
    result.radianceTransmission = min((1.0 - result.reflectedFraction) * (eta * eta), NWB_DIELECTRIC_RADIANCE_TRANSMISSION_MAX);
    return result;
}

// The authored RGB tint specifies survival over one world unit, matching the existing transparent-material contract. Homogeneous closed volumes retain this coefficient from their entry boundary.
half3 nwbDielectricAbsorptionCoefficient(const half3 unitSurvival){
    return -log(clamp(unitSurvival, half3(half(NWB_ABSORPTION_SURVIVAL_MIN)), half3(1.0h)));
}

half3 nwbDielectricBeerTransmission(const half3 absorption, const float distance){
    return half3(exp(-float3(absorption) * max(distance, 0.0)));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

