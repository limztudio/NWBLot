using PhysicalQueueRegistrationPolicy = Core::GraphicsBackend::PhysicalQueueRegistrationPolicy;
using PhysicalQueueRegistrationResult = Core::GraphicsBackend::PhysicalQueueRegistrationPolicy::Result;
using PhysicalQueueSharingPolicy = Core::GraphicsBackend::PhysicalQueueSharingPolicy;
using SharedQueueFamilies = decltype(Core::GraphicsBackend::PhysicalQueueSharingPolicy::Resolve(Span<const Core::GpuPhysicalQueueInfo>{}, 0u, 0u, 0u));
