#include <impl/ecs_render/deferred/deferred_frame_targets.adhd>
#include <impl/ecs_render/shared/renderer_frame_bindings.adhd>
#include <impl/ecs_render/caustic/graph_types.adhd>
#include <impl/ecs_render/raytrace/raytracing_system.adhd>
#include <impl/ecs_render/caustic/rt_caustic_state.adhd>
#include <impl/ecs_render/caustic/caustic_resolve_state.adhd>
#include <impl/ecs_render/shader/shader_system.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type CausticsResolveStageUses = Span<GpuTaskResourceUse>;

class CausticsResolveStageNaming{
    public Name identity;
    public StringView label;
    public StringView warnText;

    public CausticsResolveStageNaming(){
        this.label = "";
        this.warnText = "";
    }
    public CausticsResolveStageNaming(in Name identity, in StringView label, in StringView warnText){
        this.identity = identity;
        this.label = label;
        this.warnText = warnText;
    }
}

class CausticsResolveChainInputs{
    public CausticsResolveStageUses prepare;
    public Array<CausticsResolveStageUses, s_CausticResolvePassCount> wavelets;
    public CausticsResolveStageUses upsample;
    public mut DeferredFrameTargets targets;
    public GpuTaskId geometryTask;
    public GpuTaskSchedulingHint baseScheduling;
    public Span<GpuTaskExternalStateSource> stateSources;
    public b8 applyStateSourcesToPrepareOnly = true;
    public mut b8 producerDispatched;
    public mut GpuTimingSubmissionTicket timingTicket;
    public mut Optional<GpuTimingMeasure> resolveTiming;

    public CausticsResolveChainInputs(
        mut DeferredFrameTargets targets,
        mut b8 producerDispatched,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> resolveTiming
    ){
        this.targets = targets;
        this.producerDispatched = producerDispatched;
        this.timingTicket = timingTicket;
        this.resolveTiming = resolveTiming;
    }
}

class CausticsResolveChainResult{
    public GpuTaskId causticResolvePrepareTask;
    public Array<GpuTaskId, s_CausticResolvePassCount> causticResolveWaveletTasks;
    public GpuTaskId causticResolveUpsampleTask;
    public GpuTaskId causticsTask;
}

class CausticsResolveChainNaming{
    public CausticsResolveStageNaming prepare;
    public Array<CausticsResolveStageNaming, s_CausticResolvePassCount> wavelets;
    public CausticsResolveStageNaming upsample;
    public CausticsResolveStageNaming timingClose;
}

class CausticsStagePrefixInputs{
    public mut DeferredFrameTargets targets;
    public in MeshViewBufferSnapshot meshViewSnapshot;
    public in b8 shadowPreparationReady;
    public mut GpuTimingSubmissionTicket timingTicket;
    public mut Optional<GpuTimingMeasure> photonTiming;
    public Span<GpuTaskId> initialDependencies;
    public Span<GpuExternalCompletionId> externalDependencies;
    public Span<GpuTaskExternalStateSource> irradianceClearStateSources;
    public Span<GpuTaskExternalStateSource> accumulatorStateSources;
    public GpuGraphResourceId causticIrradiance;
    public GpuGraphResourceId causticAccumulator;
    public b8 causticAccumulatorInitialized = false;
    public b8 hardwareCaustics = false;

    public CausticsStagePrefixInputs(
        mut DeferredFrameTargets targets,
        in MeshViewBufferSnapshot meshViewSnapshot,
        in borrow b8 shadowPreparationReady,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> photonTiming
    ){
        this.targets = targets;
        this.meshViewSnapshot = meshViewSnapshot;
        this.shadowPreparationReady = shadowPreparationReady;
        this.timingTicket = timingTicket;
        this.photonTiming = photonTiming;
    }
}

class CausticsGeometryAndResolveInputs{
    public mut DeferredFrameTargets targets;
    public mut b8 producerDispatched;
    public mut GpuTimingSubmissionTicket timingTicket;
    public mut Optional<GpuTimingMeasure> resolveTiming;
    public CausticsStageTargets stageTargets;
    public GpuGraphResourceId worldPosition;
    public GpuGraphResourceId depth;
    public GpuGraphResourceId causticIrradiance;
    public GpuTaskId photonTask;
    public GpuTaskSchedulingHint baseScheduling;
    public Span<GpuTaskExternalStateSource> geometryStateSources;
    public Span<GpuTaskExternalStateSource> resolveStateSources;
    public b8 hardwareCaustics = false;

    public CausticsGeometryAndResolveInputs(
        mut DeferredFrameTargets targets,
        mut b8 producerDispatched,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> resolveTiming
    ){
        this.targets = targets;
        this.producerDispatched = producerDispatched;
        this.timingTicket = timingTicket;
        this.resolveTiming = resolveTiming;
    }
}

class CausticsGeometryAndResolveResult{
    public GpuTaskId causticResolvePrepareTask;
    public Array<GpuTaskId, s_CausticResolvePassCount> causticResolveWaveletTasks;
    public GpuTaskId causticResolveUpsampleTask;
    public GpuTaskId causticsTask;
    public GpuTaskId causticGeometryTask;
}

[modular]
class CausticsResolveChainBuilder : NoCopy{
    private mut GpuTaskGraph m_graph;
    private mut RendererRayTracingSystem m_raytracingSystem;

    public CausticsResolveChainBuilder(mut GpuTaskGraph graph, mut RendererRayTracingSystem system){
        this.m_graph = graph;
        this.m_raytracingSystem = system;
    }
    [cpp_unwind]
    public Expected<CausticsStageTargets> importStageTargets(in DeferredFrameTargets targets, in b8 hardwareCaustics);
    [cpp_unwind]
    public Expected<CausticsStagePrefixResult> declarePrefixTasks(in CausticsStagePrefixInputs inputs);
    [cpp_unwind]
    public Expected<CausticsGeometryAndResolveResult> declareGeometryAndResolve(in CausticsGeometryAndResolveInputs inputs);
    [cpp_unwind]
    public Expected<CausticsResolveChainResult> declare(in CausticsResolveChainInputs inputs, in CausticsResolveChainNaming naming);
    [cpp_unwind]
    public Expected<CausticsResolveChainResult> declareHardware(in CausticsResolveChainInputs inputs);
    [cpp_unwind]
    public Expected<CausticsResolveChainResult> declareSoftware(in CausticsResolveChainInputs inputs);
}


[modular]
class CausticPipelineSet : NoCopy{
    private mut GraphicsRuntime m_graphics;
    private mut RendererShaderSystem m_shaderSystem;
    private mut RtCausticState m_caustic;
    private b8 m_hasCsg;

    public CausticPipelineSet(
        mut GraphicsRuntime graphics,
        mut RendererShaderSystem shaderSystem,
        mut RtCausticState caustic,
        in b8 hasCsg
    ){
        this.m_graphics = graphics;
        this.m_shaderSystem = shaderSystem;
        this.m_caustic = caustic;
        this.m_hasCsg = hasCsg;
    }

    public b8 ensureSwCausticPipeline();
    public b8 ensureCausticResolvePipeline();
    public b8 ensureCausticGeometryDownsamplePipeline();
    public b8 ensureCausticAccumulatorDecayPipeline();
    public b8 ensureCausticRtPipeline();
}


