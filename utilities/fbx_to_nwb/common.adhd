////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <utilities/fbx_to_nwb/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Array<OutputAssetType, 5u> s_OutputAssetTypes = Array<OutputAssetType, 5u>(
    OutputAssetType::Bunch, OutputAssetType::Mesh, OutputAssetType::Model, OutputAssetType::Skeleton, OutputAssetType::Skin
);
const Array<NormalMode, 3u> s_NormalModes = Array<NormalMode, 3u>(NormalMode::Imported, NormalMode::Smooth, NormalMode::Regenerate);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
void AppendFbxOptions<Option, ToText>(mut String out, in Span<Option> values, in ToText toText){
    for(usize i = 0u; i < values.size(); ++i){
        if(i > 0u){
            if(i + 1u == values.size())
                out.append(s_OptionLastSeparatorText);
            else
                out.append(s_OptionSeparatorText);
        }
        out.append(toText(values[i]));
    }
}

[cpp_unwind]
void AppendOutputAssetTypeOptionsText(mut String out){
    AppendFbxOptions(out, Span<OutputAssetType>(s_OutputAssetTypes), OutputAssetTypeText);
}

[cpp_unwind]
String OutputAssetTypeOptionsText(){
    String out;
    out.reserve(64u);
    AppendOutputAssetTypeOptionsText(out);
    return out;
}

[cpp_unwind]
String OutputAssetTypeErrorText(){
    String out;
    out.reserve(96u);
    out.append("Asset type must be ");
    AppendOutputAssetTypeOptionsText(out);
    return out;
}

Expected<OutputAssetType> ParseAssetTypeText(in StringView value){
    return ParseOptionText<OutputAssetType>(value, Span<OutputAssetType>(s_OutputAssetTypes), OutputAssetTypeText);
}

[cpp_unwind]
void AppendNormalModeOptionsText(mut String out){
    AppendFbxOptions(out, Span<NormalMode>(s_NormalModes), NormalModeText);
}

[cpp_unwind]
String NormalModeErrorText(){
    String out;
    out.reserve(80u);
    out.append("normal mode must be ");
    AppendNormalModeOptionsText(out);
    return out;
}

Expected<NormalMode> ParseNormalModeText(in StringView value){
    return ParseOptionText<NormalMode>(value, Span<NormalMode>(s_NormalModes), NormalModeText);
}

Expected<StringView> NextFbxColorComponentToken(in StringView text, mut usize inOutCursor){
    while(inOutCursor < text.size() && (IsAsciiSpace(text[inOutCursor]) || text[inOutCursor] == s_AsciiCommaByte))
        ++inOutCursor;
    if(inOutCursor >= text.size())
        return MakeUnexpected(Failure());
    const usize start = inOutCursor;
    while(inOutCursor < text.size() && !IsAsciiSpace(text[inOutCursor]) && text[inOutCursor] != s_AsciiCommaByte)
        ++inOutCursor;
    return text.substr(start, inOutCursor - start);
}

Expected<Vec4> ParseFbxColorText(in StringView text){
    usize cursor = 0u;
    Array<f32, 4u> components;
    for(usize index = 0u; index < components.size(); ++index){
        const auto token = NextFbxColorComponentToken(text, cursor);
        if(!token.has_value())
            return MakeUnexpected(Failure());
        const auto value = ParseF32(token.value());
        if(!value.has_value())
            return MakeUnexpected(Failure());
        components[index] = value.value();
    }
    if(NextFbxColorComponentToken(text, cursor).has_value())
        return MakeUnexpected(Failure());
    return TryMakeFiniteColorVec4(components[0u], components[1u], components[2u], components[3u]);
}

[cpp_unwind]
Path DefaultFbxOutputPath(in StringView inputPath){
    Path outputPath(inputPath);
    outputPath.replaceExtension(s_NwbFileExtensionText);
    return outputPath;
}


