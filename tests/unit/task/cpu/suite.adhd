        }, []()noexcept { return -1; });
    }
    EXPECT_EQ(result, 47);
    EXPECT_EQ(callbacks, 0u);
}

void VerifyCpuTaskCleanupTests_TerminalDrainJoinsAnActiveWorkerAndRetiresCanceledCaptures(){
    b8 wasFinished = false;
    b8 wasExpired = false;
    u32 retiredCount = 0u;
    u32 canceledCallbacks = 0u;
    usize outstandingTasks = 0u;
    b8 postDrainAccepted = true;
    native(mut wasFinished, mut wasExpired, mut retiredCount, mut canceledCallbacks, mut outstandingTasks, mut postDrainAccepted){
        using namespace __hidden_cpu_task_cleanup_tests;
        CpuTaskScheduler scheduler(HomogeneousWorkers(1u));
        CpuTaskScope scope(scheduler);
        Atomic<u32> retirements{ 0u };
        Atomic<b8> started{ false };
        Atomic<b8> drainStarted{ false };
        Atomic<b8> released{ false };
        Atomic<b8> finished{ false };
        Atomic<b8> expired{ false };
        const auto cpuTaskAdmission = scope.submit([&, probe = LifetimeProbe(retirements)]() {
            EXPECT_TRUE(probe.retirements != nullptr);
            started.store(true, MemoryOrder::release);
            if(!WaitUntil(released))
                expired.store(true, MemoryOrder::release);
            finished.store(true, MemoryOrder::release);
        });
        EXPECT_TRUE(cpuTaskAdmission);
        if(cpuTaskAdmission)
            EXPECT_TRUE(cpuTaskAdmission->valid());
        EXPECT_TRUE(WaitUntil(started));
        const auto secondCpuTaskAdmission = scope.submit([&, probe = LifetimeProbe(retirements)]() {
            EXPECT_TRUE(probe.retirements != nullptr);
            ++canceledCallbacks;
            throw TerminalTaskError{ .code = 61 };
        }, { .target = CpuTaskTarget::MainThread });
        EXPECT_TRUE(secondCpuTaskAdmission);
        if(secondCpuTaskAdmission)
            EXPECT_TRUE(secondCpuTaskAdmission->valid());
        JoiningThread releaseWorker([&]()noexcept {
            if(!WaitUntil(drainStarted))
                expired.store(true, MemoryOrder::release);
            SleepMS(s_CleanupWaitIntervalMS);
            released.store(true, MemoryOrder::release);
        });
        drainStarted.store(true, MemoryOrder::release);
        scheduler.drain();
        releaseWorker.join();
        wasFinished = finished.load(MemoryOrder::acquire);
        wasExpired = expired.load(MemoryOrder::acquire);
        retiredCount = retirements.load(MemoryOrder::acquire);
        outstandingTasks = scheduler.statistics().outstandingTasks;
        postDrainAccepted = scheduler.submit([]()noexcept {}).has_value();
    }
    EXPECT_TRUE(wasFinished);
    EXPECT_FALSE(wasExpired);
    EXPECT_EQ(retiredCount, 2u);
    EXPECT_EQ(canceledCallbacks, 0u);
    EXPECT_EQ(outstandingTasks, 0u);
    EXPECT_FALSE(postDrainAccepted);
}

void VerifyCpuTaskCleanupTests_NestedRangeFailureJoinsItsSubtreeBeforeUnwindingTheReceivingScope(){
    u32 callbacks = 0u;
    i32 result = 0;
    native(mut callbacks, mut result){
        using namespace __hidden_cpu_task_cleanup_tests;
        Atomic<u32> retirements{ 0u };
        CpuTaskScheduler scheduler(0u);
        result = InvokeTerminalEntry<TerminalTaskError>([&]()->int {
            CpuTaskScope scope(scheduler);
            const auto cpuTaskAdmission = scope.submit([&, probe = LifetimeProbe(retirements)]() {
                EXPECT_TRUE(probe.retirements != nullptr);
                EXPECT_TRUE((scope.parallelFor(0u, 16u, 1u, [&](usize) {
                    ++callbacks;
                    throw TerminalTaskError{ .code = 67 };
                })));
            });
            EXPECT_TRUE(cpuTaskAdmission);
            if(cpuTaskAdmission)
                EXPECT_TRUE(cpuTaskAdmission->valid());
            scope.wait();
            return 0;
        }, [&](const TerminalTaskError& err) {
            EXPECT_EQ(retirements.load(MemoryOrder::acquire), 1u);
            EXPECT_EQ(scheduler.statistics().outstandingTasks, 0u);
            return err.code;
        }, []()noexcept { return -1; });
    }
    EXPECT_EQ(result, 67);
    EXPECT_EQ(callbacks, 1u);
}

void VerifyCpuTaskCleanupTests_DescendantRetirementCanReenterSchedulerBeforeParentCompletionPublishes(){
    u32 callbacks = 0u;
    usize outstandingTasks = 0u;
    native(mut callbacks, mut outstandingTasks){
        using namespace __hidden_cpu_task_cleanup_tests;
        DeadlineGuard watchdog(false, s_TaskTimeoutMS);
        CpuTaskHandle parent;
        b8 incompleteDuringRetirement = false;
        usize outstandingDuringRetirement = 0u;
        CpuTaskScheduler scheduler(0u);
        const auto cpuTaskAdmission = scheduler.submit([&scheduler, &callbacks, probe = ReentrantRetirementProbe(scheduler, parent, incompleteDuringRetirement, outstandingDuringRetirement)]() {
            EXPECT_TRUE(probe.m_active);
            const auto secondCpuTaskAdmission = scheduler.submit([&]()noexcept { ++callbacks; });
            EXPECT_TRUE(secondCpuTaskAdmission);
            if(secondCpuTaskAdmission)
                EXPECT_TRUE(secondCpuTaskAdmission->valid());
        });
        ASSERT_TRUE(cpuTaskAdmission);
        parent = *cpuTaskAdmission;
        ASSERT_TRUE(parent.valid());
        const auto thirdCpuTaskAdmission = scheduler.submit([&]() {
            EXPECT_TRUE(incompleteDuringRetirement);
            EXPECT_EQ(outstandingDuringRetirement, 2u);
            ++callbacks;
        }, parent);
        ASSERT_TRUE(thirdCpuTaskAdmission);
        const auto dependent = *thirdCpuTaskAdmission;
        ASSERT_TRUE(dependent.valid());
        scheduler.wait(dependent);
        outstandingTasks = scheduler.statistics().outstandingTasks;
    }
    EXPECT_EQ(callbacks, 2u);
    EXPECT_EQ(outstandingTasks, 0u);
}

void VerifyCpuTaskCleanupTests_LoaderShutdownJoinsPostCallbackTasksBeforeCallbackOwnerExpires(){
    u32 callbacks = 0u;
    i32 result = 0;
    u32 finalRetirements = 0u;
    u32 finalLateRetirements = 0u;
    native(mut callbacks, mut result, mut finalRetirements, mut finalLateRetirements){
        using namespace __hidden_cpu_task_cleanup_tests;
        b8 ownerAlive = true;
        Atomic<u32> retirements{ 0u };
        Atomic<u32> lateRetirements{ 0u };
        CpuTaskScheduler scheduler(0u);
        CpuTaskScope scope(scheduler);
        result = InvokeTerminalEntry<TerminalTaskError>([&]()->int {
            ShutdownSubmittingCallbacks owner(scope, ownerAlive, retirements, lateRetirements, callbacks);
            NWB::LoaderDetail::CallbackShutdownGuard shutdown(owner, scope);
            shutdown.activate();
            return 0;
        }, [&](const TerminalTaskError& err) {
            EXPECT_FALSE(ownerAlive);
            EXPECT_EQ(retirements.load(MemoryOrder::acquire), 1u);
            EXPECT_EQ(lateRetirements.load(MemoryOrder::acquire), 0u);
            EXPECT_EQ(scheduler.statistics().outstandingTasks, 0u);
            return err.code;
        }, []()noexcept { return -1; });
        scope.drain();
        finalRetirements = retirements.load(MemoryOrder::acquire);
        finalLateRetirements = lateRetirements.load(MemoryOrder::acquire);
    }
    EXPECT_EQ(result, 73);
    EXPECT_EQ(callbacks, 1u);
    EXPECT_EQ(finalRetirements, 1u);
    EXPECT_EQ(finalLateRetirements, 0u);
}


