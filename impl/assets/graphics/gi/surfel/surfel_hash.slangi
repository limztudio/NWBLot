////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_GI_SURFEL_HASH_SLANGI
#define NWB_GRAPHICS_GI_SURFEL_HASH_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "surfel_binding_slots.h"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static const uint NWB_SURFEL_HASH_PRIME_X = 73856093u;
static const uint NWB_SURFEL_HASH_PRIME_Y = 19349663u;
static const uint NWB_SURFEL_HASH_PRIME_Z = 83492791u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


int3 nwbSurfelCellCoord(const float3 worldPosition, const float cellSize){
    return int3(floor(worldPosition / max(cellSize, NWB_SURFEL_HASH_CELL_SIZE_MIN)));
}


bool nwbSurfelSameCell(const int3 ownerCell, const int3 visitedCell){
    return all(ownerCell == visitedCell);
}

uint nwbSurfelHashCell(const int3 cell, const uint cellCount){
    const uint hash = (uint(cell.x) * NWB_SURFEL_HASH_PRIME_X) ^ (uint(cell.y) * NWB_SURFEL_HASH_PRIME_Y) ^ (uint(cell.z) * NWB_SURFEL_HASH_PRIME_Z);
    return hash & (cellCount - 1u);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

