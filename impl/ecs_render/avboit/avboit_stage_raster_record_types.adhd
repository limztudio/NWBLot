class AvboitRasterRecordInputs{
    public mut DeferredFrameTargets targets;
    public in DeferredGraphResourceImportResult resources;
    public in FrameGraphAvboitMaterialUploadResult upload;
    public mut GpuTimingSubmissionTicket timingTicket;
    public mut Optional<GpuTimingMeasure> computeEmulationTiming;
    public GpuTaskId predecessor;

    public AvboitRasterRecordInputs(
        mut DeferredFrameTargets targets,
        in DeferredGraphResourceImportResult resources,
        in FrameGraphAvboitMaterialUploadResult upload,
        mut GpuTimingSubmissionTicket ticket,
        mut Optional<GpuTimingMeasure> timing,
        in GpuTaskId predecessor
    ){
        this.targets = targets;
        this.resources = resources;
        this.upload = upload;
        this.timingTicket = ticket;
        this.computeEmulationTiming = timing;
        this.predecessor = predecessor;
    }
}

class AvboitRasterRecordStageOutputs{
    public mut GpuTaskId reusedGeometryProducer;
    public mut GpuTaskId streamTask;
    public mut GpuTaskId computeEmulationTask;
    public mut Array<GpuTaskId, s_SharedComputeEmulationMaximumPhaseCount> sharedComputeEmulationTasks;
    public mut usize sharedComputeEmulationTaskCount;
    public mut GpuTaskId rasterTask;
    public AvboitRasterRecordStageOutputs(
        mut GpuTaskId reused,
        mut GpuTaskId stream,
        mut GpuTaskId compute,
        mut Array<GpuTaskId, s_SharedComputeEmulationMaximumPhaseCount> shared,
        mut usize sharedCount,
        mut GpuTaskId raster
    ){
        this.reusedGeometryProducer = reused;
        this.streamTask = stream;
        this.computeEmulationTask = compute;
        this.sharedComputeEmulationTasks = shared;
        this.sharedComputeEmulationTaskCount = sharedCount;
        this.rasterTask = raster;
    }
}

class AvboitPassUploadReadinessPolicy{
    public b8 isCsgPassReady(
        in b8 hasCsgDrawItems,
        in b8 csgHasWork,
        in b8 receiverRangesValid,
        in b8 cuttersValid,
        in b8 clipContextSlotsValid,
        in b8 requiresIntervalSampleState,
        in b8 intervalSampleStateValid,
        in b8 csgFrameReady,
        in b8 csgDrawResourcesReady
    )const{
        if(!hasCsgDrawItems)
            return true;
        return csgHasWork
            && receiverRangesValid
            && cuttersValid
            && clipContextSlotsValid
            && (!requiresIntervalSampleState || intervalSampleStateValid)
            && csgFrameReady
            && csgDrawResourcesReady;
    }

    public b8 arePassResourcesReady(
        in b8 materialInstancesValid,
        in b8 materialTypedValid,
        in b8 frameBindingsReady,
        in b8 regularDrawResourcesReady,
        in b8 csgReady
    )const{
        return materialInstancesValid
            && materialTypedValid
            && frameBindingsReady
            && regularDrawResourcesReady
            && csgReady;
    }
}


