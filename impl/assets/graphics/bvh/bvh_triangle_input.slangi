////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////



#ifndef NWB_GRAPHICS_BVH_TRIANGLE_INPUT_SLANGI
#define NWB_GRAPHICS_BVH_TRIANGLE_INPUT_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Shared build-kernel triangle input. Morton generation and bottom-up fitting both consume the exact same sorted
// triangle stream, so keep the binding declarations and byte-address decoding together.


#include "binding_slots.h"
#include "bvh_common.slangi"
#include "../bindless/bindless_heap.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[vk::push_constant]]
ConstantBuffer<NwbBvhBuildPushConstants> g_NwbBvhBuildPushConstants;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void nwbBvhLoadTrianglePositions(
    const uint triangle,
    out float3 outP0,
    out float3 outP1,
    out float3 outP2
){
    const uint indexBase = triangle * 3u;
    const uint indexHeapSlot = g_NwbBvhBuildPushConstants.triangleIndexHeapSlot;
    const uint positionHeapSlot = g_NwbBvhBuildPushConstants.positionHeapSlot;
    const uint i0 = NwbHeapRawBuffer(indexHeapSlot).Load(indexBase * 4u);
    const uint i1 = NwbHeapRawBuffer(indexHeapSlot).Load((indexBase + 1u) * 4u);
    const uint i2 = NwbHeapRawBuffer(indexHeapSlot).Load((indexBase + 2u) * 4u);
    outP0 = asfloat(NwbHeapRawBuffer(positionHeapSlot).Load3(i0 * 12u));
    outP1 = asfloat(NwbHeapRawBuffer(positionHeapSlot).Load3(i1 * 12u));
    outP2 = asfloat(NwbHeapRawBuffer(positionHeapSlot).Load3(i2 * 12u));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

