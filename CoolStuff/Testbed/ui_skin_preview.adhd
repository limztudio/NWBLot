        declared = DeclareFormattedLabel(context.ui, scratchArena, s_SelectedKey, "Command: {} / Clicks: {}", this.m_command, this.m_anchorClicks) && result.valid && declared;
        const b8 valid = context.ui.endPanel() && declared;
        RestoreBuilderFontSize(context.ui, previousFontSize);
        if(!valid)
            error("Testbed: custom popup tools declaration failed");
    }

    private UiPopupToolsSource m_source = UiPopupToolsSource();
    private ContextMenuState m_menu = ContextMenuState();
    private TooltipState m_tooltip = TooltipState();
    private u64 m_command = 0u;
    private u32 m_anchorClicks = 0u;
}

