native{
namespace NWB::FbxToNwb{
using NWB::Impl::SkinInfluence4;
using NWB::Impl::ValidateSourceStreamIndexWithContext;
using NWB::Impl::s_MeshletTriangleIndexCount;
using NWB::Impl::s_MeshMissingStreamIndex;
using NWB::Impl::s_SkinInfluenceJointCount;
using NWB::Impl::s_VertexRefPositionName;
using NWB::Impl::s_VertexRefNormalName;
using NWB::Impl::s_VertexRefTangentName;
using NWB::Impl::s_MeshUv0FieldNameView;
using NWB::Impl::s_VertexRefColorName;
};
