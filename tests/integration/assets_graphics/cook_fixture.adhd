FOUNDATION_INLINE void RegisterMetadataPairedSidecarExtensionImpl(const AStringView extension){
    NWB::Core::Assets::RegisterAssetPairedSidecarRule(NWB::Core::Assets::AssetPairedSidecarRule{ extension });
}

[[nodiscard]] FOUNDATION_INLINE b8 HasRegisteredPairedSidecarExtensionImpl(ScratchArena& scratchArena, const AStringView extension){
    Vector<NWB::Core::Assets::AssetPairedSidecarRule, ScratchArena> rules(scratchArena);
    NWB::Core::Assets::CookMetadataDetail::CopyPairedSidecarRules(rules);
    for(const NWB::Core::Assets::AssetPairedSidecarRule& rule : rules){
        if(rule.sidecarExtension == extension)
            return true;
    }
    return false;
}

inline constexpr AStringView s_ModelMetaMeshObjectField = "mesh_0";
inline constexpr AStringView s_SharedModelPath = "tests/model_cook_metadata/shared";
inline constexpr AStringView s_UnknownModelPath = "tests/model_cook_metadata/unknown";
inline constexpr AStringView s_StaticMeshesField = "static_meshes";
inline constexpr AStringView s_PropObjectField = "prop";
inline constexpr AStringView s_ModelMetaMeshField = "mesh";
inline constexpr AStringView s_ModelMetaSkeletonField = "skeleton";
inline constexpr AStringView s_ModelMetaSkinnedMeshesField = "skinned_meshes";
inline constexpr AStringView s_ModelMetaMeshVirtualPath = "tests/model_cook_metadata/mesh";
inline constexpr TStringView s_TargetsAMissingSkeletonObject = FOUNDATION_TEXT("targets a missing skeleton object");
inline constexpr AStringView s_ModelMetaRigA = "rig_a";
inline constexpr AStringView s_ModelMetaRigB = "rig_b";
inline constexpr AStringView s_ModelPayloadProp = "prop";
inline constexpr AStringView s_ModelPayloadReplacementRig = "replacement_rig";
inline constexpr AStringView s_TestsModelPayloadMesh = "tests/model_payload/mesh";

struct ModelMetadata{
    Core::Metascript::MetaArena metadataArena{ Name(s_AssetCaseTestsModelCookMetadataMetadata) };
    Core::Assets::AssetArena outputArena{ Name(s_AssetCaseTestsModelCookMetadataOutput) };
    Core::Alloc::ScratchArena scratchArena{ Name(s_AssetCaseTestsModelCookMetadataScratch) };
    Core::Metascript::Value asset{ metadataArena };
    Impl::ModelCookEntry entry{ outputArena };
    HashMap<Name, Name, Core::Metascript::MetaArena> expectedSkeletons{ metadataArena };
    const NWB::Path path{ outputArena, "tests/model_cook_metadata/model.nwb" };


public:
    ModelMetadata(){
        asset.makeMap();
    }


public:
    void addSkeleton(const AStringView objectName, const AStringView skeletonAsset){
        Core::Metascript::Value& object = asset.field("skeletons").field(objectName);
        object.field(s_ModelMetaSkeletonField).setString(skeletonAsset);
    }

    void addSkinnedMesh(const AStringView objectName, const AStringView skeleton, const AStringView expectedObject){
        Core::Metascript::Value& object = asset.field(s_ModelMetaSkinnedMeshesField).field(objectName);
        object.field("skin").setString("tests/model_cook_metadata/skin");
        object.field(s_ModelMetaSkeletonField).setString(skeleton);
        const auto objectIdentity = Name::FromText(objectName);
        ASSERT_TRUE(objectIdentity);
        const auto expectedIdentity = Name::FromText(expectedObject);
        ASSERT_TRUE(expectedIdentity);
        expectedSkeletons.insert_or_assign(*objectIdentity, *expectedIdentity);
    }

    void setNestedFieldString(const AStringView groupField, const AStringView objectName, const AStringView fieldName, const AStringView value){
        asset.field(groupField).field(objectName).field(fieldName).setString(value);
    }

    [[nodiscard]] AStringView nestedFieldString(const AStringView groupField, const AStringView objectName, const AStringView fieldName){
        return asset.field(groupField).field(objectName).field(fieldName).asString();
    }

    [[nodiscard]] usize eraseNestedField(const AStringView groupField, const AStringView objectName, const AStringView fieldName){
        return asset.field(groupField).field(objectName).asMap().erase(fieldName);
    }

    void setExpectedSkeleton(const AStringView objectName, const AStringView expectedObject){
        expectedSkeletons.at(Name::FromText(objectName).value_or(s_NameNone)) = Name::FromText(expectedObject).value_or(s_NameNone);
    }

    void initThreeRowStaticTransform(const AStringView objectName, const AStringView meshPath, const f64 translationX){
        using Core::Metascript::Value;
        Value& object = asset.field(s_StaticMeshesField).field(objectName);
        object.field(s_ModelMetaMeshField).setString(meshPath);
        Value& transform = object.field("transform");
        transform.makeList();
        for(usize rowIndex = 0u; rowIndex < 3u; ++rowIndex){
            Value row(metadataArena);
            row.makeList();
            for(usize columnIndex = 0u; columnIndex < 4u; ++columnIndex)
                row.append(Value(static_cast<i64>(rowIndex == columnIndex ? 1 : 0), metadataArena));
            transform.append(Move(row));
        }
        transform.asList()[0u].asList()[3u].setDouble(translationX);
    }

    void appendHomogeneousStaticTransformRow(const AStringView objectName){
        using Core::Metascript::Value;
        Value& transform = asset.field(s_StaticMeshesField).field(objectName).field("transform");
        Value homogeneousRow(metadataArena);
        homogeneousRow.makeList();
        for(usize columnIndex = 0u; columnIndex < 4u; ++columnIndex)
            homogeneousRow.append(Value(static_cast<i64>(columnIndex == 3u ? 1 : 0), metadataArena));
        transform.append(Move(homogeneousRow));
    }

    void popStaticTransformRow(const AStringView objectName){
        asset.field(s_StaticMeshesField).field(objectName).field("transform").asList().pop_back();
    }

    [[nodiscard]] f32 firstStaticTransform14()const noexcept{
        return entry.staticMeshObjects[0u].transform._14;
    }

    [[nodiscard]] b8 parse(){
        auto result = Impl::ParseModelCookMetadata(Name(s_AssetCaseTestsModelCookMetadataModel), path, asset, outputArena, scratchArena);
        if(!result)
            return false;
        entry = Move(*result);
        return true;
    }

    void verifyObjectReferences()const{
        ASSERT_EQ(entry.skinnedMeshObjects.size(), expectedSkeletons.size());
        for(const Impl::ModelSkinnedMeshObject& object : entry.skinnedMeshObjects){
            const auto expected = expectedSkeletons.find(object.name);
            ASSERT_NE(expected, expectedSkeletons.end());
            EXPECT_EQ(object.skeletonObject, expected->second);
            EXPECT_EQ(object.skin.name(), Name("tests/model_cook_metadata/skin"));
        }
    }
};

FOUNDATION_INLINE void AddIndexedModelObjects(const usize skeletonCount, const usize meshCount, ModelMetadata& metadata){
    for(usize index = 0u; index < skeletonCount; ++index){
        const auto objectName = StringFormat(metadata.metadataArena, "rig_{}", index);
        const auto assetName = StringFormat(metadata.metadataArena, "tests/model_cook_metadata/skeleton_{}", index);
        metadata.addSkeleton(objectName, assetName);
    }
    for(usize index = 0u; index < meshCount; ++index){
        const usize skeletonIndex = (index * 73u) % skeletonCount;
        const auto meshName = StringFormat(metadata.metadataArena, "mesh_{}", index);
        const auto objectName = StringFormat(metadata.metadataArena, "rig_{}", skeletonIndex);
        metadata.addSkinnedMesh(meshName, objectName, objectName);
    }
}

struct ModelInputs{
    Core::Assets::AssetArena arena{ Name(s_AssetCaseTestsModelPayloadInputs) };
    Core::Alloc::ScratchArena scratchArena{ Name(s_AssetCaseTestsModelPayloadValidationScratch) };
    Impl::Model model{ arena, Name(s_AssetCaseTestsModelPayloadModel) };
    Impl::Model::SkeletonObjectVector skeletonObjects{ arena };
    Impl::Model::StaticMeshObjectVector staticMeshObjects{ arena };
    Impl::Model::SkinnedMeshObjectVector skinnedMeshObjects{ arena };


public:
    ModelInputs(){
        skeletonObjects.push_back(Impl::ModelSkeletonObject{ .name = Name(s_ModelRigSegment), .skeleton = Core::Assets::AssetRef<Impl::Skeleton>("tests/model_payload/skeleton") });
        staticMeshObjects.push_back(Impl::ModelStaticMeshObject{ .name = Name(s_ModelPayloadProp), .mesh = Core::Assets::AssetRef<Impl::Mesh>(s_TestsModelPayloadMesh.data()), .material = {}, .parentObject = Name(s_ModelRigSegment), .parentJoint = Name(s_AssetCaseHand) });
        skinnedMeshObjects.push_back(Impl::ModelSkinnedMeshObject{ .name = Name(s_ModelBodySegment), .skin = Core::Assets::AssetRef<Impl::Skin>("tests/model_payload/skin"), .material = {}, .skeletonObject = Name(s_ModelRigSegment) });
        publish();
    }


public:
    void publish(){
        model.setObjects(Impl::Model::SkeletonObjectVector(skeletonObjects), Impl::Model::StaticMeshObjectVector(staticMeshObjects), Impl::Model::SkinnedMeshObjectVector(skinnedMeshObjects));
    }

    [[nodiscard]] b8 validate(){
        return model.validatePayload(scratchArena);
    }

    [[nodiscard]] b8 validateUnnamedModel(){
        Impl::Model unnamed(arena);
        return unnamed.validatePayload(scratchArena);
    }

    [[nodiscard]] ArenaMemoryStats scratchStats()const noexcept{
        return scratchArena.memoryStats();
    }
};

[[nodiscard]] FOUNDATION_INLINE AssetBytes MakeModelInputsBytesImpl(ModelInputs& inputs){
    return AssetBytes(inputs.arena);
}

[[nodiscard]] FOUNDATION_INLINE ModelAsset MakeLoadedModelFromInputsImpl(ModelInputs& inputs){
    return ModelAsset(inputs.arena, inputs.model.virtualPath());
}

[[nodiscard]] inline constexpr usize ExpectedSingleTripleModelBinaryBytes()noexcept{
    return sizeof(NWB::Impl::ModelHeaderBinary) + sizeof(NWB::Impl::ModelSkeletonObjectBinary) + sizeof(NWB::Impl::ModelStaticMeshObjectBinary) + sizeof(NWB::Impl::ModelSkinnedMeshObjectBinary);
}

FOUNDATION_INLINE void CorruptModelBinarySkinnedNameImpl(const Name& duplicateName, AssetBytes& malformed){
    using namespace NWB::Impl;
    const usize staticOffset = sizeof(ModelHeaderBinary) + sizeof(ModelSkeletonObjectBinary);
    const usize skinnedOffset = staticOffset + sizeof(ModelStaticMeshObjectBinary);
    ModelSkinnedMeshObjectBinary skinnedObject;
    FOUNDATION_MEMCPY(&skinnedObject, sizeof(skinnedObject), malformed.data() + skinnedOffset, sizeof(skinnedObject));
    skinnedObject.nameHash = duplicateName.hash();
    FOUNDATION_MEMCPY(malformed.data() + skinnedOffset, malformed.size() - skinnedOffset, &skinnedObject, sizeof(skinnedObject));
}

FOUNDATION_INLINE void CorruptModelBinaryStaticParentImpl(const Name& wrongParentName, AssetBytes& malformed){
    using namespace NWB::Impl;
    const usize staticOffset = sizeof(ModelHeaderBinary) + sizeof(ModelSkeletonObjectBinary);
    ModelStaticMeshObjectBinary staticObject;
    FOUNDATION_MEMCPY(&staticObject, sizeof(staticObject), malformed.data() + staticOffset, sizeof(staticObject));
    staticObject.parentObjectNameHash = wrongParentName.hash();
    FOUNDATION_MEMCPY(malformed.data() + staticOffset, malformed.size() - staticOffset, &staticObject, sizeof(staticObject));
}

// Shader & Texture helpers
inline constexpr AStringView s_SkeletonJointLeft = "left";
inline constexpr AStringView s_SkeletonJointRoot = "root";
inline constexpr AStringView s_SkeletonJointRight = "right";

struct SkeletonInputs{
    Core::Assets::AssetArena arena{ Name(s_AssetCaseTestsSkeletonPayloadInputs) };
    Core::Alloc::ScratchArena scratchArena{ Name(s_AssetCaseTestsSkeletonPayloadValidationScratch) };
    Impl::SkeletonCookEntry entry{ arena };
    Impl::Skeleton skeleton{ arena, Name(s_AssetCaseTestsSkeletonPayloadSkeleton) };


public:
    SkeletonInputs(){
        entry.virtualPath = skeleton.virtualPath();
        entry.joints.reserve(4u);
        entry.joints.push_back(Impl::SkeletonCookJoint{ .name = Name(s_SkeletonJointRoot) });
        entry.joints.push_back(Impl::SkeletonCookJoint{ .name = Name(s_SkeletonJointLeft), .parent = Name(s_SkeletonJointRoot) });
        entry.joints.push_back(Impl::SkeletonCookJoint{ .name = Name(s_SkeletonJointRight), .parent = Name(s_SkeletonJointRoot) });
        entry.joints.push_back(Impl::SkeletonCookJoint{ .name = Name(s_AssetCaseHand), .parent = Name(s_SkeletonJointLeft) });
        entry.joints[1u].localBindPose._14 = 2.0f;
        entry.joints[3u].localBindPose._24 = 3.0f;
    }

    [[nodiscard]] b8 canBuild(){
        return NWB::Impl::BuildSkeletonAsset(entry, arena, scratchArena).has_value();
    }

    [[nodiscard]] b8 buildIntoSkeleton(){
        auto built = NWB::Impl::BuildSkeletonAsset(entry, arena, scratchArena);
        if(!built)
            return false;
        skeleton = Move(*built);
        return true;
    }

    [[nodiscard]] b8 validate(){
        return skeleton.validatePayload(scratchArena);
    }

    [[nodiscard]] ArenaMemoryStats scratchStats()const noexcept{
        return scratchArena.memoryStats();
    }

    void setJointIndexOverride(const Name& jointName, const u32 indexValue){
        NWB::Impl::Skeleton::JointIndexMap jointIndices(skeleton.jointIndices());
        jointIndices.at(jointName) = indexValue;
        skeleton.setJoints(NWB::Impl::Skeleton::JointVector(skeleton.joints()), Move(jointIndices));
    }
};

[[nodiscard]] FOUNDATION_INLINE AssetBytes MakeSkeletonInputsBytesImpl(SkeletonInputs& inputs){
    return AssetBytes(inputs.arena);
}

inline constexpr usize s_TextureMipCount = 3u;
inline constexpr usize s_TexturePrimaryPayloadBytes = 96u;
inline constexpr usize s_TextureMipTableBytes = sizeof(::TextureBinaryPayload::MipLevelBinary) * s_TextureMipCount;
inline constexpr usize s_TextureHeaderBinaryBytes = sizeof(::TextureBinaryPayload::HeaderBinary);
inline constexpr usize s_TextureMipRecordBinaryBytes = sizeof(::TextureBinaryPayload::MipLevelBinary);
inline constexpr usize s_TextureHeaderMipCountOffset = offsetof(::TextureBinaryPayload::HeaderBinary, mipCount);
inline constexpr usize s_TextureHeaderPayloadFormatOffset = offsetof(::TextureBinaryPayload::HeaderBinary, payloadFormat);
inline constexpr usize s_TextureHeaderAlphaInfoOffset = offsetof(::TextureBinaryPayload::HeaderBinary, alphaInfo);
inline constexpr usize s_TextureHeaderVersionOffset = offsetof(::TextureBinaryPayload::HeaderBinary, version);
inline constexpr usize s_TextureMipReservedOffset = offsetof(::TextureBinaryPayload::MipLevelBinary, reserved);
inline constexpr usize s_TextureMipWidthOffset = offsetof(::TextureBinaryPayload::MipLevelBinary, width);
inline constexpr usize s_TextureMipBlockCountXOffset = offsetof(::TextureBinaryPayload::MipLevelBinary, blockCountX);
inline constexpr usize s_TextureMipSliceCountOffset = offsetof(::TextureBinaryPayload::MipLevelBinary, sliceCount);
inline constexpr usize s_TextureMipOffsetBytesOffset = offsetof(::TextureBinaryPayload::MipLevelBinary, offsetBytes);
inline constexpr usize s_TextureMipSizeBytesOffset = offsetof(::TextureBinaryPayload::MipLevelBinary, sizeBytes);

[[nodiscard]] FOUNDATION_INLINE Core::Assets::AssetBytes BuildPartialBlockTextureBinary(TestArena& testArena){
    Core::Assets::AssetBytes binary(testArena.arena);
    binary.reserve(sizeof(::TextureBinaryPayload::HeaderBinary) + s_TextureMipTableBytes + s_TexturePrimaryPayloadBytes);
    ::TextureBinaryPayload::HeaderBinary header;
    header.dimension = TextureDimension::Texture2D;
    header.width = 7u;
    header.height = 5u;
    header.depth = 1u;
    header.mipCount = s_TextureMipCount;
    header.alphaInfo = static_cast<u32>(TextureAlphaMode::Opaque) | (static_cast<u32>(TextureFormat::s_OpaqueAlphaUnorm8) << ::TextureBinaryPayload::s_AlphaInfoConstantShift);
    header.payloadFormat = TexturePayloadFormat::UastcLdr4x4;
    header.payloadByteCount = s_TexturePrimaryPayloadBytes;
    AppendPOD(binary, header);
    const Array<::TextureBinaryPayload::MipLevelBinary, 3u> mips = {{
        { 7u, 5u, 1u, 2u, 2u, 0u, 0u, 64u },
        { 3u, 2u, 1u, 1u, 1u, 0u, 64u, 16u },
        { 1u, 1u, 1u, 1u, 1u, 0u, 80u, 16u },
    }};
    for(const auto& mip : mips)
        AppendPOD(binary, mip);
    for(usize byteIndex = 0u; byteIndex < s_TexturePrimaryPayloadBytes; ++byteIndex)
        binary.push_back(static_cast<u8>(byteIndex));
    return binary;
}

[[nodiscard]] FOUNDATION_INLINE NWB::Core::Assets::AssetBytes MakeTextureTestUastcPayload(TestArena& testArena){
    NWB::Core::Assets::AssetBytes bytes = MakeAssetBytesImpl(testArena);
    bytes.resize(96u);
    for(usize index = 0u; index < bytes.size(); ++index)
        bytes[index] = static_cast<u8>(index);
    return bytes;
}

[[nodiscard]] FOUNDATION_INLINE NWB::Impl::Texture::MipLevelVector MakeTextureTestMipLevels(TestArena& testArena){
    NWB::Impl::Texture::MipLevelVector mipLevels(testArena.arena);
    mipLevels.reserve(3u);
    mipLevels.push_back(NWB::Impl::TextureMipLevel{ .offsetBytes = 0u, .sizeBytes = 64u, .width = 7u, .height = 5u, .blockCountX = 2u, .blockCountY = 2u });
    mipLevels.push_back(NWB::Impl::TextureMipLevel{ .offsetBytes = 64u, .sizeBytes = 16u, .width = 3u, .height = 2u, .blockCountX = 1u, .blockCountY = 1u });
    mipLevels.push_back(NWB::Impl::TextureMipLevel{ .offsetBytes = 80u, .sizeBytes = 16u, .width = 1u, .height = 1u, .blockCountX = 1u, .blockCountY = 1u });
    return mipLevels;
}

[[nodiscard]] FOUNDATION_INLINE Expected<Core::Assets::AssetBytes> MakeTextureTestRuntimeBinary(TestArena& testArena){
    Impl::Texture texture(testArena.arena, Name(s_AssetCaseProjectTexturesPrepared));
    texture.setPayload(7u, 5u, MakeTextureTestMipLevels(testArena), MakeTextureTestUastcPayload(testArena), TextureDimension::Texture2D, 1u, TexturePayloadFormat::UastcLdr4x4, TextureAlphaMode::EmbeddedLdr, TextureFormat::s_OpaqueAlphaUnorm8);
    Impl::TextureAssetCodec codec;
    Core::Assets::AssetBytes bytes(testArena.arena);
    if(!codec.serialize(texture, bytes))
        return MakeUnexpected(Failure{});
    return bytes;
}

FOUNDATION_INLINE void SetStandardTestTexturePayloadImpl(TestArena& testArena, const TextureAlphaModeEnum alphaMode, const u8 alphaConstant, TextureAsset& outTexture){
    outTexture.setPayload(7u, 5u, MakeTextureTestMipLevels(testArena), MakeTextureTestUastcPayload(testArena), TextureDimension::Texture2D, 1u, TexturePayloadFormat::UastcLdr4x4, alphaMode, alphaConstant);
}

[[nodiscard]] FOUNDATION_INLINE AssetBytes CopyAssetBytesPrefixImpl(const AssetBytes& source, const usize count, TestArena& testArena){
    return AssetBytes(source.begin(), source.begin() + count, testArena.arena);
}

FOUNDATION_INLINE void AssignAssetBytesPrefixImpl(const AssetBytes& source, const usize count, AssetBytes& dest){
    dest.assign(source.begin(), source.begin() + count);
}

FOUNDATION_INLINE void AppendAssetBytesImpl(const AssetBytes& extra, AssetBytes& dest){
    dest.insert(dest.end(), extra.begin(), extra.end());
}

[[nodiscard]] FOUNDATION_INLINE b8 AssetByteRangeEqualsImpl(const AssetBytes& haystack, const usize offset, const AssetBytes& needle)noexcept{
    if(offset > haystack.size() || needle.size() > haystack.size() - offset)
        return false;
    return FOUNDATION_MEMCMP(haystack.data() + offset, needle.data(), needle.size()) == 0;
}

[[nodiscard]] FOUNDATION_INLINE b8 GatherShaderDependenciesImpl(const Path& sourcePath, const ShaderCookPathVector& includeDirectories, ScratchArena& scratchArena, ShaderCookPathVector& outDependencies){
