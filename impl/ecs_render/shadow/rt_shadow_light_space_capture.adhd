#include <impl/ecs_render/shadow/light_space_settings.adhd>
#include <impl/ecs_render/mesh/renderer_mesh_types.adhd>
#include <impl/ecs_render/shadow/light_space_shadow.adhd>
#include <impl/ecs_render/kernel/timing_names.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<impl/assets/graphics/shadow/light_space_constants.h>"), cpp_name("NWB_LIGHT_SPACE_VIEW_GROUP_SIZE")]
extern const u32 s_ShaderLightSpaceViewGroupSize;

[cpp_header("<impl/assets/graphics/shadow/light_space_constants.h>"), cpp_name("NWB_LIGHT_SPACE_CULL_GROUP_SIZE")]
extern const u32 s_ShaderLightSpaceCullGroupSize;

[cpp_header("<impl/assets/graphics/shadow/light_space_constants.h>"), cpp_name("NWB_LIGHT_SPACE_CULL_MAX_GROUPS_X")]
extern const u32 s_ShaderLightSpaceCullMaxGroupsX;

[cpp_header("<impl/assets/graphics/shadow/light_space_constants.h>"), cpp_name("NWB_LIGHT_SPACE_SHADE_GROUP_SIZE")]
extern const u32 s_ShaderLightSpaceShadeGroupSize;

[cpp_header("<impl/assets/graphics/shadow/light_space_constants.h>"), cpp_name("NWB_LIGHT_SPACE_SHADE_MAX_GROUPS_X")]
extern const u32 s_ShaderLightSpaceShadeMaxGroupsX;

[cpp_header("<impl/assets/graphics/shadow/light_space_constants.h>"), cpp_name("NWB_LIGHT_SPACE_GROUP_SIZE")]
extern const u32 s_ShaderLightSpaceGroupSize;

static_assert(size_of<DrawIndexedIndirectArguments>() == s_ShaderLightSpaceDrawArgumentBytes);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void ResolveLightSpaceCullDispatchGroups(in u32 drawCount, in u32 cullGroupSize, in u32 maxGroupsX, mut u32 outGroupsX, mut u32 outGroupsZ){
    const u32 groups = DivideUp(drawCount, cullGroupSize);
    outGroupsX = Min(groups, maxGroupsX);
    outGroupsZ = DivideUp(groups, maxGroupsX);
}

u32 ResolveLightSpaceCaptureDrawCount(in u32 viewLightFlags, in u32 casterDrawCount){
    if((viewLightFlags & cast<u32>(LightSpaceFlag::Point)) != 0u)
        return casterDrawCount;
    return 1u;
}

u32 ResolveLightSpaceCaptureBatchCount(in u32 captureCount, in u32 firstDraw){
    return Min(captureCount - firstDraw, s_LightSpaceMaxIndirectDraws);
}

void ResolveLightSpaceShadeDispatchGroups(in u32 totalPixels, in u32 shadeGroupSize, in u32 maxGroupsX, mut u32 outGroupsX, mut u32 outGroupsY){
    const u32 groups = DivideUp(totalPixels, shadeGroupSize);
    outGroupsX = Min(groups, maxGroupsX);
    outGroupsY = DivideUp(groups, maxGroupsX);
}

void ResolveLightSpaceResolveDispatchGroups(in u32 width, in u32 height, in u32 receiverFactor, in u32 groupSize, mut u32 outGroupsX, mut u32 outGroupsY){
    const u32 halfWidth = DivideUp(width, receiverFactor);
    const u32 halfHeight = DivideUp(height, receiverFactor);
    outGroupsX = DivideUp(halfWidth, groupSize);
    outGroupsY = DivideUp(halfHeight, groupSize);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void PopulateLightSpaceCullCasterPush(in LightSpaceShadowCaster caster, mut LightSpaceShadowPush outPush){
    outPush.instanceIndex = caster.instanceIndex;
    outPush.meshletDescSlot = caster.meshletDescSlot;
    outPush.meshletBoundsSlot = caster.meshletBoundsSlot;
    outPush.meshletCount = caster.meshletCount;
}

void PopulateLightSpaceResolvePush(in u32 frameIndex, in u32 sampleCount, in u32 outputSlot, mut LightSpaceShadowPush outPush){
    outPush.frameIndex = frameIndex;
    outPush.sampleCount = sampleCount;
    outPush.outputSlot = outputSlot;
}

b8 LightSpaceShadowRecorder::views(in LightSpaceShadowSnapshot snapshot, mut CommandList commandList, mut GpuDescriptorHeap heap)const{
    if(!snapshot.ready || !snapshot.viewPipeline.valid() || !snapshot.drawArguments.valid() || snapshot.plan.viewCount == 0u)
        return false;
    ComputeState computeState;
    computeState.setPipeline(snapshot.viewPipeline.deref());
    commandList.setComputeState(computeState);
    heap.bindCompute(commandList, snapshot.viewPipeline.deref());
    commandList.setPushConstants(snapshot.push);
    commandList.dispatch(DivideUp(snapshot.plan.viewCount, s_ShaderLightSpaceViewGroupSize), 1u, 1u);
    return true;
}

b8 LightSpaceShadowRecorder::cull(in LightSpaceShadowSnapshot snapshot, mut CommandList commandList, mut GpuDescriptorHeap heap)const{
    if(!snapshot.ready || !snapshot.cullPipeline.valid() || !snapshot.drawArguments.valid() || snapshot.casters.empty() || snapshot.plan.viewCount == 0u)
        return false;
    ComputeState computeState;
    computeState.setPipeline(snapshot.cullPipeline.deref());
    commandList.setComputeState(computeState);
    heap.bindCompute(commandList, snapshot.cullPipeline.deref());
    LightSpaceShadowPush push = snapshot.push;
    push.casterDrawOffset = 0u;
    for(usize i = 0u; i < snapshot.casters.size(); ++i){
        in LightSpaceShadowCaster caster = snapshot.casters[i];
        const u32 drawCount = LightSpaceCasterDrawCount(caster.meshletCount);
        PopulateLightSpaceCullCasterPush(caster, push);
        commandList.setPushConstants(push);
        u32 groupsX = 0u;
        u32 groupsZ = 0u;
        ResolveLightSpaceCullDispatchGroups(drawCount, s_ShaderLightSpaceCullGroupSize, s_ShaderLightSpaceCullMaxGroupsX, groupsX, groupsZ);
        commandList.dispatch(groupsX, snapshot.plan.viewCount, groupsZ);
        push.casterDrawOffset += drawCount;
    }
    return true;
}

b8 ValidateLightSpaceCaptureCasters(in LightSpaceShadowSnapshot snapshot, in b8 transparent){
    for(usize i = 0u; i < snapshot.casters.size(); ++i){
        in LightSpaceShadowCaster caster = snapshot.casters[i];
        if(!LightSpaceCasterEligibleForCapturePass(caster.transparent, caster.csg, transparent, caster.indexCount, snapshot.push.csgFlags))
            continue;
        if(!caster.triangleIndexBuffer.valid() || !caster.triangleIndexBuffer.deref().getCreationDescription().isIndexBuffer)
            return false;
    }
    return true;
}

void RecordLightSpaceCaptureView(
    in LightSpaceShadowSnapshot snapshot,
    in u32 viewIndex,
    in b8 transparent,
    in GraphicsPipelineHandle pipeline,
    in FramebufferHandle framebuffer,
    mut CommandList commandList,
    mut GpuDescriptorHeap heap
){
    RenderPassParameters parameters;
    parameters.depthClearValue = 1.0f;
    parameters.depthAttachmentActions.loadAction = RenderPassLoadAction::Clear;
    if(transparent)
        parameters.depthAttachmentActions.loadAction = RenderPassLoadAction::Load;
    commandList.beginRenderPass(framebuffer.deref(), parameters);
    const u32 resolution = snapshot.plan.views[viewIndex].map[0];
    ViewportState viewport;
    viewport.addViewport(Viewport(cast<f32>(resolution), cast<f32>(resolution)));
    viewport.addScissorRect(Rect(0, cast<i32>(resolution), 0, cast<i32>(resolution)));
    GraphicsState graphics;
    graphics.setPipeline(pipeline.deref()).setFramebuffer(framebuffer.deref()).setViewport(viewport).setIndirectParams(snapshot.drawArguments.deref());

    LightSpaceShadowPush push = snapshot.push;
    push.viewIndex = viewIndex;
    u32 drawOffset = viewIndex * snapshot.push.captureDrawCount;
    b8 graphicsStateBound = false;
    BufferHandle boundIndexBuffer;
    for(usize i = 0u; i < snapshot.casters.size(); ++i){
        in LightSpaceShadowCaster caster = snapshot.casters[i];
        const u32 drawCount = LightSpaceCasterDrawCount(caster.meshletCount);
        const u32 argumentOffset = drawOffset * s_ShaderLightSpaceDrawArgumentBytes;
        drawOffset += drawCount;
        if(!LightSpaceCasterEligibleForCapturePass(caster.transparent, caster.csg, transparent, caster.indexCount, snapshot.push.csgFlags))
            continue;
        if(!graphicsStateBound || caster.triangleIndexBuffer.get() != boundIndexBuffer.get()){
            IndexBufferBinding indexBuffer;
            indexBuffer.setBuffer(caster.triangleIndexBuffer.deref());
            indexBuffer.setFormat(Format::R32_UINT);
            graphics.setIndexBuffer(indexBuffer);
            commandList.setGraphicsState(graphics);
            boundIndexBuffer = caster.triangleIndexBuffer;
            if(!graphicsStateBound){
                heap.bindGraphics(commandList, pipeline.deref());
                graphicsStateBound = true;
            }
        }
        push.instanceIndex = caster.instanceIndex;
        commandList.setPushConstants(push);
        const u32 captureCount = ResolveLightSpaceCaptureDrawCount(snapshot.plan.views[viewIndex].light[3], drawCount);
        u32 firstDraw = 0u;
        while(firstDraw < captureCount){
            const u32 batchCount = ResolveLightSpaceCaptureBatchCount(captureCount, firstDraw);
            commandList.drawIndexedIndirect(argumentOffset + firstDraw * s_ShaderLightSpaceDrawArgumentBytes, batchCount);
            firstDraw += batchCount;
        }
    }
    commandList.endRenderPass();
}

b8 LightSpaceShadowRecorder::capture(in LightSpaceShadowSnapshot snapshot, in u32 viewIndex, in b8 transparent, mut CommandList commandList, mut GpuDescriptorHeap heap)const{
    if(!snapshot.ready || !snapshot.drawArguments.valid() || viewIndex >= snapshot.plan.viewCount)
        return false;
    FramebufferHandle framebuffer = snapshot.opaqueFramebuffers[viewIndex];
    if(transparent)
        framebuffer = snapshot.transparentFramebuffers[viewIndex];
    GraphicsPipelineHandle pipeline = snapshot.opaqueCapture;
    if(transparent)
        pipeline = snapshot.transparentCapture;
    if(!framebuffer.valid() || !pipeline.valid())
        return false;
    if(!ValidateLightSpaceCaptureCasters(snapshot, transparent))
        return false;
    RecordLightSpaceCaptureView(snapshot, viewIndex, transparent, pipeline, framebuffer, commandList, heap);
    return true;
}

b8 LightSpaceShadowRecorder::captureAllViews(in LightSpaceShadowSnapshot snapshot, in b8 transparent, mut CommandList commandList, mut GpuDescriptorHeap heap)const{
    if(!snapshot.ready || !snapshot.drawArguments.valid() || snapshot.plan.viewCount == 0u)
        return false;
    GraphicsPipelineHandle pipeline = snapshot.opaqueCapture;
    if(transparent)
        pipeline = snapshot.transparentCapture;
    if(!pipeline.valid())
        return false;
    for(u32 view = 0u; view < snapshot.plan.viewCount; ++view){
        FramebufferHandle framebuffer = snapshot.opaqueFramebuffers[view];
        if(transparent)
            framebuffer = snapshot.transparentFramebuffers[view];
        if(!framebuffer.valid())
            return false;
    }
    if(!ValidateLightSpaceCaptureCasters(snapshot, transparent))
        return false;
    for(u32 view = 0u; view < snapshot.plan.viewCount; ++view){
        FramebufferHandle framebuffer = snapshot.opaqueFramebuffers[view];
        if(transparent)
            framebuffer = snapshot.transparentFramebuffers[view];
        RecordLightSpaceCaptureView(snapshot, view, transparent, pipeline, framebuffer, commandList, heap);
    }
    return true;
}

b8 LightSpaceShadowRecorder::shade(in LightSpaceShadowSnapshot snapshot, mut CommandList commandList, mut GpuDescriptorHeap heap)const{
    ComputePipelineHandle pipeline = snapshot.shadePipeline;
    if((snapshot.push.csgFlags & s_CsgShadowFlagEnabled) != 0u)
        pipeline = snapshot.csgShadePipeline;
    if(!snapshot.ready || !pipeline.valid() || snapshot.plan.totalPixels == 0u)
        return false;
    LightSpaceShadowPush push = snapshot.push;
    push.width = snapshot.plan.totalPixels;
    ComputeState computeState;
    computeState.setPipeline(pipeline.deref());
    commandList.setComputeState(computeState);
    heap.bindCompute(commandList, pipeline.deref());
    commandList.setPushConstants(push);
    u32 groupsX = 0u;
    u32 groupsY = 0u;
    ResolveLightSpaceShadeDispatchGroups(push.width, s_ShaderLightSpaceShadeGroupSize, s_ShaderLightSpaceShadeMaxGroupsX, groupsX, groupsY);
    commandList.dispatch(groupsX, groupsY, 1u);
    return true;
}

GpuTimingScopeDefinition LightSpaceShadowMapTimingScope(in b8 transparent){
    if(transparent)
        return s_TimingScopeLightSpaceShadowMapTransparent;
    return s_TimingScopeLightSpaceShadowMapOpaque;
}

GpuTimingScopeDefinition LightSpaceShadowFallbackTimingScope(in b8 transparent){
    if(transparent)
        return s_TimingScopeLightSpaceShadowFallbackTransparent;
    return s_TimingScopeLightSpaceShadowFallbackOpaque;
}

b8 LightSpaceShadowRecorder::resolve(
    in LightSpaceShadowSnapshot snapshot,
    in u32 frameIndex,
    in u32 sampleCount,
    in u32 outputSlot,
    in b8 transparent,
    mut CommandList commandList,
    mut GpuDescriptorHeap heap,
    mut GpuTimingRecorder timing,
    mut RhiTexture outputTexture
)const{
    const b8 csg = (snapshot.push.csgFlags & s_CsgShadowFlagEnabled) != 0u;
    const b8 hardwareCsg = (snapshot.push.csgFlags & s_CsgShadowFlagHwCompose) != 0u;
    ComputePipelineHandle pipeline = snapshot.opaqueResolve;
    ComputePipelineHandle fallback = snapshot.opaqueFallback;
    if(csg && transparent){
        pipeline = snapshot.csgTransparentResolve;
        fallback = snapshot.csgTransparentFallback;
    } else if(csg){
        pipeline = snapshot.csgOpaqueResolve;
        fallback = snapshot.csgOpaqueFallback;
    } else if(transparent){
        pipeline = snapshot.transparentResolve;
        fallback = snapshot.transparentFallback;
    }
    usize slotIndex = 0u;
    if(transparent)
        slotIndex = 1u;
    if(
        !snapshot.ready
        || !pipeline.valid()
        || sampleCount == 0u
        || (hardwareCsg && !snapshot.csgTlasDescriptor.valid())
        || (!hardwareCsg && (
            !fallback.valid()
            || !snapshot.fallbackLists[slotIndex].valid()
            || !snapshot.fallbackArgs[slotIndex].valid()
            || !snapshot.fallbackListDescriptors[slotIndex].valid()
            || !snapshot.fallbackArgsDescriptors[slotIndex].valid()
        ))
    )
        return false;
    LightSpaceShadowPush push = snapshot.push;
    PopulateLightSpaceResolvePush(frameIndex, sampleCount, outputSlot, push);
    if(!hardwareCsg){
        push.fallbackListSlot = snapshot.fallbackListDescriptors[slotIndex].slot();
        push.fallbackArgsSlot = snapshot.fallbackArgsDescriptors[slotIndex].slot();
        Array<u32, 4u> emptyArgs;
        emptyArgs[0u] = 0u;
        emptyArgs[1u] = 1u;
        emptyArgs[2u] = 1u;
        emptyArgs[3u] = 0u;
        if(!commandList.tryWriteBuffer(snapshot.fallbackArgs[slotIndex].deref(), emptyArgs, 0u)){
            error("RendererSystem: failed to reset light-space shadow fallback arguments");
            return false;
        }
        commandList.setBufferState(snapshot.fallbackLists[slotIndex].deref(), ResourceStates::UnorderedAccess, true);
        commandList.setBufferState(snapshot.fallbackArgs[slotIndex].deref(), ResourceStates::UnorderedAccess);
        commandList.commitBarriers();
    }
    ComputeState computeState;
    computeState.setPipeline(pipeline.deref());
    commandList.setComputeState(computeState);
    if(hardwareCsg)
        heap.bindCompute(commandList, pipeline.deref(), snapshot.csgTlasDescriptor);
    else
        heap.bindCompute(commandList, pipeline.deref());
    commandList.setPushConstants(push);
    u32 groupsX = 0u;
    u32 groupsY = 0u;
    ResolveLightSpaceResolveDispatchGroups(push.width, push.height, push.receiverFactor, s_ShaderLightSpaceGroupSize, groupsX, groupsY);
    {
        const GpuTimingScopeDefinition scope = LightSpaceShadowMapTimingScope(transparent);
        GpuTimingMeasure measure(timing, scope, commandList.getDevice(), commandList);

        commandList.dispatch(groupsX, groupsY, 1u);
    }
    if(hardwareCsg)
        return true;
    commandList.setTextureState(outputTexture, TextureSubresourceSet(), ResourceStates::UnorderedAccess, true);
    commandList.setBufferState(snapshot.fallbackLists[slotIndex].deref(), ResourceStates::ShaderResource);
    commandList.setBufferState(snapshot.fallbackArgs[slotIndex].deref(), ResourceStates::IndirectArgument | ResourceStates::ShaderResource);
    commandList.commitBarriers();
    ComputeState fallbackState;
    fallbackState.setPipeline(fallback.deref());
    fallbackState.setIndirectParams(snapshot.fallbackArgs[slotIndex].deref());
    commandList.setComputeState(fallbackState);
    heap.bindCompute(commandList, fallback.deref());
    commandList.setPushConstants(push);
    {
        const GpuTimingScopeDefinition scope = LightSpaceShadowFallbackTimingScope(transparent);
        GpuTimingMeasure measure(timing, scope, commandList.getDevice(), commandList);

        commandList.dispatchIndirect(0u);
    }
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

