void VerifyUiPopupLayoutTests_BottomEdgeFlipsAboveAndClampsHorizontalOverflow(){
    PopupOptions options = PopupOptions();
    options.anchor = MakeUiPopupRect(730.0f, 560.0f, 50.0f, 24.0f);
    options.size.x = 220.0f;
    options.size.y = 160.0f;
    const auto placementResult = PlacePopup(options, MakeUiPopupDisplay(800.0f, 600.0f, 1.0f, 1.0f));
    ASSERT_TRUE(placementResult.has_value());
    const PopupPlacement placement = placementResult.value();
    ExpectUiRect(placement.bounds, MakeUiPopupRect(580.0f, 396.0f, 220.0f, 160.0f));
    EXPECT_EQ(placement.side, PopupPlacementSide::Above);
}

void VerifyUiPopupLayoutTests_AbovePreferenceFlipsBelowAtTopEdge(){
    PopupOptions options = PopupOptions();
    options.anchor = MakeUiPopupRect(40.0f, 12.0f, 60.0f, 30.0f);
