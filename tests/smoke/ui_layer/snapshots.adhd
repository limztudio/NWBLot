// Arithmetic row lookup keeps the fixture independent of total row count and allocates labels on demand.
class UiListSmokeSourceState{
    private u64 m_revision = 1u;
    private u64 m_removed = 0u;
    private u32 m_labelReads = 0u;
    private b8 m_reversed = false;

    public u64 instanceGeneration()const{
        return 1u;
    }

    public u64 revision()const{
        return this.m_revision;
    }

    public u64 rowCount()const{
        if(this.m_removed == 0u)
            return 100000u;
        return 99999u;
    }

    public u64 key(in u64 index)const{
        const u64 count = this.rowCount();
        if(index < count)
            return ArithmeticFixtureRowKey(count, this.m_removed, this.m_reversed, index);
        return 0u;
    }

    public Expected<u64> indexOf(in u64 keyValue)const{
        return FindArithmeticFixtureRowIndex(this.rowCount(), this.m_removed, this.m_reversed, keyValue);
    }

    public Expected<u64> findEnabled(in u64 start, in b8 reverse)const;

    public u64 readRowKey(in u64 index){
        ++this.m_labelReads;
        return this.key(index);
    }

    public b8 enabled(in u64 index)const{
        return index < this.rowCount() && this.key(index) != 5u;
    }

    public void reverse(){
        this.m_reversed = !this.m_reversed;
        ++this.m_revision;
    }

    public void remove(in u64 keyValue){
        if(keyValue == 0u || keyValue > 100000u || keyValue == this.m_removed)
            return;
        this.m_removed = keyValue;
        ++this.m_revision;
    }

    public void beginFrame(){
        this.m_labelReads = 0u;
    }

    public b8 reversed()const{
        return this.m_reversed;
    }

    public u64 removedKey()const{
        return this.m_removed;
    }

    public u32 labelReads()const{
        return this.m_labelReads;
    }
}


// Wrapper changing source lifetime and emptiness without storing the 100000 arithmetic rows.
class UiComboSmokeSourceState{
    private UiListSmokeSourceState m_rows = UiListSmokeSourceState();
    private u64 m_generation = 1u;
    private u64 m_revision = 1u;
    private b8 m_empty = false;

    public u64 instanceGeneration()const{
        return this.m_generation;
    }

    public u64 revision()const{
        return this.m_revision + this.m_rows.revision();
    }

    public u64 rowCount()const{
        if(this.m_empty)
            return 0u;
        return this.m_rows.rowCount();
    }

    public u64 key(in u64 index)const{
        if(this.m_empty)
            return 0u;
        return this.m_rows.key(index);
    }

    public Expected<u64> indexOf(in u64 keyValue)const{
        if(this.m_empty)
            return MakeUnexpected(Failure());
        return this.m_rows.indexOf(keyValue);
    }

    public Expected<u64> findEnabled(in u64 start, in b8 reverse)const{
        if(this.m_empty)
            return MakeUnexpected(Failure());
        return this.m_rows.findEnabled(start, reverse);
    }

    public u64 readRowKey(in u64 index){
        if(this.m_empty)
            return 0u;
        return this.m_rows.readRowKey(index);
    }

    public b8 enabled(in u64 index)const{
        return !this.m_empty && this.m_rows.enabled(index);
    }

    public void reverse(){
        this.m_rows.reverse();
    }

    public void remove(in u64 keyValue){
        this.m_rows.remove(keyValue);
    }

    public void beginFrame(){
        this.m_rows.beginFrame();
    }

    public void toggleEmpty(){
        this.m_empty = !this.m_empty;
        ++this.m_revision;
    }

    public void replace(){
        ++this.m_generation;
    }

    public b8 reversed()const{
        return this.m_rows.reversed();
    }

    public u64 removedKey()const{
        return this.m_rows.removedKey();
    }

    public u32 labelReads()const{
        return this.m_rows.labelReads();
    }
}


// Fixed five-key combo source state with a filtered view.
class UiNestedPopupSmokeSourceState{
    private String m_query = "";
    private Array<u64, 5u> m_indices;
    private u64 m_count = 0u;
    private u64 m_viewRevision = 0u;
    private u32 m_labelReads = 0u;

    public UiNestedPopupSmokeSourceState();

    public u64 instanceGeneration()const{
        return 1u;
    }

    public u64 revision()const{
        return 1u;
    }

    public u64 rowCount()const{
        return 5u;
    }

    public u64 key(in u64 index)const{
        if(index < this.rowCount())
            return index + 1u;
        return 0u;
    }

    public Expected<u64> indexOf(in u64 keyValue)const{
        if(keyValue == 0u || keyValue > this.rowCount())
            return MakeUnexpected(Failure());
        return keyValue - 1u;
    }

    public Expected<u64> findEnabled(in u64 start, in b8 reverse)const;
    public StringView readText(in u64 index);

    public b8 enabled(in u64 index)const{
        return index < this.rowCount() && this.key(index) != 3u;
    }

    public b8 filter(in StringView query);

    public u64 viewRevision()const{
        return this.m_viewRevision;
    }

    public u64 viewRowCount()const{
        return this.m_count;
    }

    public u64 viewKey(in u64 index)const{
        if(index < this.m_count)
            return this.key(this.m_indices[index]);
        return 0u;
    }

    public Expected<u64> viewIndexOf(in u64 keyValue)const{
        for(u64 candidate = 0u; candidate < this.m_count; ++candidate){
            if(this.viewKey(candidate) == keyValue)
                return candidate;
        }
        return MakeUnexpected(Failure());
    }

    public Expected<u64> viewFindEnabled(in u64 start, in b8 reverse)const{
        if(start >= this.m_count)
            return MakeUnexpected(Failure());
        u64 candidate = start;
        while(candidate < this.m_count){
            if(this.viewEnabled(candidate))
                return candidate;
            if(reverse){
                if(candidate == 0u)
                    break;
                --candidate;
            }
            else{
                ++candidate;
            }
        }
        return MakeUnexpected(Failure());
    }

    public StringView readViewText(in u64 index){
        if(index < this.m_count)
            return this.readText(this.m_indices[index]);
        return "";
    }

    public b8 viewEnabled(in u64 index)const{
        return index < this.m_count && this.enabled(this.m_indices[index]);
    }

    public void beginFrame(){
        this.m_labelReads = 0u;
    }

    public u32 labelReads()const{
        return this.m_labelReads;
    }
}


