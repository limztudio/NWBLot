const StringView s_TexturesDirectory = "textures";
const StringView s_CheckerMetadataFilename = "checker.nwb";
const StringView s_TextureTestMetadata = "texture asset;\n\nasset.format = \"uastc_ldr_4x4\";\nasset.dimension = \"2d\";\nasset.resolution = [7, 5];\nasset.alpha_mode = \"embedded_ldr\";\n";

class TextureMetadataDiagnosticCase{
    public StringView m_assignment;
    public StringView m_diagnostic;

    public TextureMetadataDiagnosticCase(in StringView assignment, in StringView diagnostic){
        this.m_assignment = assignment;
