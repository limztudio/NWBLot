        EXPECT_EQ(event.caretByte, 1u);
        EXPECT_EQ(SendMessageW(self.m_window, WM_IME_ENDCOMPOSITION, 0u, 0), 0);
        ASSERT_EQ(self.m_service->poll(self.m_token, event), TextInputPollResult::Event);
        EXPECT_EQ(event.kind, TextInputEventKind::Preedit);
        EXPECT_TRUE(event.text.empty());
        EXPECT_EQ(self.m_service->poll(self.m_token, event), TextInputPollResult::Pending);
#else
        (void)self;
#endif
    }
}

