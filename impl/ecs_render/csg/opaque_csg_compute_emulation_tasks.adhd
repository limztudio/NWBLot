#include <impl/ecs_render/csg/task_graph_opaque_compute_tasks.adhd>
#include <impl/ecs_render/kernel/timing_names.adhd>
#include <impl/ecs_render/shared/frame_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 AreOpaqueCsgComputeEmulationResourcesReady(
    in b8 materialDrawBuffersUploaded,
    in b8 frameBindingsReady,
    in b8 csgFrameBuffersUploaded,
    in b8 hasCsgFrameWork,
    in b8 csgResourcesFrameReady
){
    return materialDrawBuffersUploaded
        && frameBindingsReady
        && csgFrameBuffersUploaded
        && hasCsgFrameWork
        && csgResourcesFrameReady
    ;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 OpaqueCsgReceiverComputeEmulationGraphTaskPayload::record(mut CommandList commands, in GpuTaskRecordContext context)const{
    if(!this.plan.captured)
        return false;

    GpuTimingTicketRecordingScope timingRecording(this.timingTicket.value());
    const b8 frameSetupReady = FrameSetupReady(this.meshViewSetupReady, this.sceneShadingSetupReady);
    if(!frameSetupReady)
        return true;

    // The imported output set is immutable; reject a corrupted plan.
    if(!this.plan.matches())
        return false;

    const MaterialPassDrawItemsView drawItems = this.plan.drawItemsView();
    const CsgFrameGpuDataView csgFrameData = this.plan.csgFrameDataView();
    const b8 csgResourcesReady = AreOpaqueCsgComputeEmulationResourcesReady(
        this.materialDrawBuffersUploaded,
        this.frameBindings.frameReady(this.instanceCount, this.materialTypedByteCount),
        this.csgFrameBuffersUploaded,
        csgFrameData.hasWork(),
        this.csgResources.frameReady(csgFrameData)
    );
    if(!csgResourcesReady || !this.materialSystem.drawRecorder().materialPassDrawResourcesReady(drawItems, this.frameBindings))
        return true;

    ViewportState csgViewportState;
    csgViewportState.addViewport(this.targets.framebuffer.deref().getFramebufferInfo().getViewport()).addScissorRect(ToCoreRect(csgFrameData.workRegion.resolveRect(this.targets.width, this.targets.height)));
    MaterialPassDrawContext drawContext(
        commands,
        csgViewportState,
        this.frameBindings,
        MaterialPipelinePass::CsgReceiverSurface,
        this.materialFrameStatesGraphOwned,
        this.materialGeometryStatesGraphOwned,
        true
    );
    drawContext.setFramebuffer(this.targets.framebuffer).setCsgResources(this.csgResources);
    this.materialSystem.drawRecorder().generateComputeMaterialPassDrawItems(drawContext, drawItems.computeDrawItems);
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 OpaqueCsgIntervalSampleComputeEmulationGraphTask::record(mut CommandList commands, in GpuTaskRecordContext context)const{
    if(!this.plan.geometry.generated.captured)
        return false;

    GpuTimingTicketRecordingScope timingRecording(this.timingTicket.value());
    const b8 frameSetupReady = FrameSetupReady(this.meshViewSetupReady, this.sceneShadingSetupReady);
    if(!frameSetupReady)
        return true;

    // Reject a corrupted retained plan.
    if(!this.plan.geometry.generated.matches())
        return false;

    const MaterialPassDrawItemsView drawItems = this.plan.geometry.drawItemsView();
    const CsgFrameGpuDataView csgFrameData = this.plan.csgFrameDataView();
    const b8 csgResourcesReady = AreOpaqueCsgComputeEmulationResourcesReady(
        this.materialDrawBuffersUploaded,
        this.frameBindings.frameReady(this.instanceCount, this.materialTypedByteCount),
        this.csgFrameBuffersUploaded,
        csgFrameData.hasWork(),
        this.csgResources.frameReady(csgFrameData)
    );
    if(!csgResourcesReady || !this.materialSystem.drawRecorder().materialPassDrawResourcesReady(drawItems, this.frameBindings))
        return true;
    if(this.opaqueCsgTiming.has_value())
        return false;

    ViewportState deferredViewportState;
    deferredViewportState.addViewportAndScissorRect(this.targets.framebuffer.deref().getFramebufferInfo().getViewport());
    this.opaqueCsgTiming.emplace(this.graphics.gpuTiming(), s_TimingScopeOpaqueCsg, this.graphics.getDevice(), commands);
    // Close the marker here; the sample callback owns finishTiming/discard.
    if(!FinishSplitGpuTimingMarker(this.opaqueCsgTiming))
        return false;
    MaterialPassDrawContext drawContext(
        commands,
        deferredViewportState,
        this.frameBindings,
        MaterialPipelinePass::Opaque,
        this.materialFrameStatesGraphOwned,
        this.materialGeometryStatesGraphOwned,
        true
    );
    drawContext.setCsgResources(this.csgResources);
    this.materialSystem.drawRecorder().generateComputeMaterialPassDrawItems(drawContext, drawItems.computeDrawItems);
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

