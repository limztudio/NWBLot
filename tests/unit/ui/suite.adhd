TextAreaOptions MakeTextAreaLoanFixtureOptions(){
    TextAreaOptions options = TextAreaOptions();
    options.height.policy = LayoutSizePolicy::Fixed;
    options.height.value = 96.0f;
    return options;
}

void ClearSliderCallbackCounters(mut SliderCallbackSource self){
    self.m_calls = 0u;
    self.m_mutations = 0u;
    self.m_beginAccepted = false;
    self.m_endAccepted = false;
}

void ApplySliderCallbackStateMutation(in UiFixtureSliderCallbackMutation mutation, mut SliderState state){
    if(mutation == UiFixtureSliderCallbackMutation::SameValue){
        EXPECT_TRUE(state.setValue(state.value()));
        return;
    }
    if(mutation == UiFixtureSliderCallbackMutation::AwayAndBack){
        const f64 value = state.value();
        EXPECT_TRUE(state.setValue(0.9));
        EXPECT_TRUE(state.setValue(value));
        return;
    }
    if(mutation == UiFixtureSliderCallbackMutation::SetValue)
        EXPECT_TRUE(state.setValue(0.9));
}

void ApplySliderCallbackBuilderMutation(in UiFixtureSliderCallbackMutation mutation, mut SliderCallbackSource self, mut Builder builder){
    if(mutation == UiFixtureSliderCallbackMutation::ResetBuilder){
        builder.reset();
        return;
    }
    self.m_beginAccepted = builder.beginPanel("reentered", Rect(0.0f, 0.0f, 100.0f, 80.0f));
    self.m_endAccepted = builder.endPanel();
}

void SetUpSliderFixture(mut SliderFixture self){
    self.setUpWidgetBase();
    self.configureSliderSkin();
    ASSERT_TRUE(self.m_skin.validatePayload());
    self.m_builder.setSkin(self.m_skin);
    ASSERT_TRUE(self.m_state.setValue(0.25));
}

void ApplyTextAreaHostActionFlags(in EditActionEnum action, mut EditNavigationState navigation, mut EditBoxResult result){
    result.submitted = result.submitted || (action == EditAction::Submit);
    result.cancelled = result.cancelled || (action == EditAction::Cancel);
    result.blurred = result.blurred || (action == EditAction::Blur);
    result.abandoned = result.abandoned || (action == EditAction::Abandon);
    if(action == EditAction::Cancel || action == EditAction::Blur || action == EditAction::Abandon){
        navigation.reset();
        if(action == EditAction::Cancel || action == EditAction::Blur)
            result.focused = false;
    }
}

b8 FrameTextAreaFixture(mut TextAreaFixture self, in u64 generation, in TextAreaOptions options, in Rect bounds){
    if(!self.beginArea(generation, bounds))
        return false;
    self.m_result = self.m_builder.textArea(s_TextAreaKey, self.m_model, self.m_state, options);
    return self.m_result.valid && self.acceptArea();
}

b8 AcceptTextAreaLoanBaseline(mut TextAreaLoanFixture self){
    self.useHost();
    if(!self.m_model.setText("alpha\nbeta") || !self.frameArea(1u, MakeTextAreaLoanFixtureOptions()))
        return false;
    self.m_host.publications.clear();
    self.m_host.publishes = 0u;
    self.m_host.loans = 0u;
    return true;
}


