////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_GI_SURFEL_SH_SLANGI
#define NWB_GRAPHICS_GI_SURFEL_SH_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// 2-band SH surfel irradiance; trace weight 2*pi/N, clamped-cosine reconstruct (A_0 = pi, A_1 = 2*pi/3), clamp >= 0.
// Coefficient-only: works over SRV + UAV pools.

#include "../constants.h"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Real two-band SH basis and cosine-convolution coefficients shared by every surfel projection/reconstruction path.
#define NWB_SURFEL_SH_Y00_SCALE 0.2820947918
#define NWB_SURFEL_SH_Y1_SCALE 0.4886025119
#define NWB_SURFEL_SH_L1_COSINE_RECONSTRUCTION_SCALE (2.0 / 3.0)


// Real 2-band SH basis at a unit direction: (Y_00, Y_1-1, Y_10, Y_11).
half4 nwbSurfelShBasis(const float3 dir){
    return half4(
        half(NWB_SURFEL_SH_Y00_SCALE),         // Y_00  = 1 / (2 sqrt(pi))
        half(NWB_SURFEL_SH_Y1_SCALE) * half(dir.y),  // Y_1-1 = sqrt(3 / (4 pi)) * y
        half(NWB_SURFEL_SH_Y1_SCALE) * half(dir.z),  // Y_10  = sqrt(3 / (4 pi)) * z
        half(NWB_SURFEL_SH_Y1_SCALE) * half(dir.x)   // Y_11  = sqrt(3 / (4 pi)) * x
    );
}

// Per-ray projection weight: the upper hemisphere is sampled with pdf 1/(2*pi), so the summed radiance*basis products
// over N rays are scaled by 2*pi/N to estimate the SH projection integral. N >= 1 keeps this in (0, 2*pi];
// half math is sufficient here (widened at the float SH-coefficient scale in the trace).
half nwbSurfelShProjectionScale(const uint rayCount){
    return half(NWB_GI_FULL_TURN_RADIANS) / half(float(max(rayCount, 1u)));   // 2 * pi / N
}

// Reconstruct one colour channel's cosine-weighted mean radiance for a query normal from its 4 SH coefficients:
// (1/pi) * [A_0 c_00 Y_00 + A_1 (c_1-1 Y_1-1 + c_10 Y_10 + c_11 Y_11)] = c_00 Y_00 + (2/3)(c_1m Y_1m), clamped >= 0.
half nwbSurfelShReconstructChannel(const half4 sh, const half4 basis){
    const half value = sh.x * basis.x + half(NWB_SURFEL_SH_L1_COSINE_RECONSTRUCTION_SCALE) * (sh.y * basis.y + sh.z * basis.z + sh.w * basis.w);
    return max(value, half(0.0h));
}

// Reconstruct the RGB cosine-weighted mean radiance for a query normal.
half3 nwbSurfelShReconstruct(const half4 shR, const half4 shG, const half4 shB, const float3 normal){
    const half4 basis = nwbSurfelShBasis(normal);
    return half3(
        nwbSurfelShReconstructChannel(shR, basis),
        nwbSurfelShReconstructChannel(shG, basis),
        nwbSurfelShReconstructChannel(shB, basis)
    );
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

