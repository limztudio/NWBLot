struct GpuCrashMarkerTestsTag;
using GpuCrashMarkerTestArena = Tests::TestArena<GpuCrashMarkerTestsTag>;
using DefaultResourceTestArena = Tests::TestArena<>;

struct DescriptorBufferAllocationHarness{
    Tests::TestArena<> arena;
    Core::GraphicsBackend::DescriptorBufferAllocationState state{ arena.arena };
    Array<u8, 64u> bytes{};


public:
    [[nodiscard]] auto allocate(Core::GraphicsBackend::DescriptorBufferSegmentKind::Enum kind, u32 sizeBytes, u32 alignBytes, u32 generation){
        return state.allocate(kind, sizeBytes, alignBytes, generation, static_cast<u32>(bytes.size()), bytes.data());
    }

    void free(const Core::GraphicsBackend::DescriptorBufferSegment& segment, u32 generation)noexcept{
        state.free(segment, generation, static_cast<u32>(bytes.size()));
    }

    [[nodiscard]] b8 isLive(const Core::GraphicsBackend::DescriptorBufferSegment& segment, Core::GraphicsBackend::DescriptorBufferSegmentKind::Enum kind, u32 generation)const noexcept{
        return state.isLive(segment, kind, generation, static_cast<u32>(bytes.size()));
    }
};

[[nodiscard]] inline auto ResolveImplicitOpacityMicromapIndexFormat(){
    return Core::GraphicsBackend::VulkanDetail::BlasOpacityMicromapPolicy::ResolveOpacityMicromapIndexFormat(Core::Format::UNKNOWN, {});
}

[[nodiscard]] inline auto ValidateDefaultTextureCreateDesc(const Core::TextureDesc& desc){
    return Core::GraphicsBackend::VulkanTextureDetail::TextureImagePolicy::ValidateTextureCreateDesc(desc, {}, false);
}

[[nodiscard]] b8 RunConcurrentCrashMarkerGrowthCheck(
    Core::GpuCrashTracker& crashTracker,
    Core::Alloc::GlobalArena& arena,
    usize retainedHash,
    const Core::ResolvedMarker& retained,
    AStringView retainedLabel
);

#if defined(NWB_GRAPHICS_BACKEND_VULKAN) && NWB_GRAPHICS_BACKEND_VULKAN
struct CalibratedTimestampProbeResult{
    b8 supported = false;
    u32 countCalls = 0u;
    u32 listCalls = 0u;
    u32 timestampCalls = 0u;
};

[[nodiscard]] CalibratedTimestampProbeResult RunCalibratedTimestampProbe(b8 retryFirstCount, b8 hasDeviceDomain);
#endif


