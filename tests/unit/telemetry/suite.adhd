Array<MemorySourceEnum, 3> Suite_MakeAllMemorySources(){
    Array<MemorySourceEnum, 3> sources = Array<MemorySourceEnum, 3>();
    sources[0u] = MemorySource::ExplicitScope;
    sources[1u] = MemorySource::Arena;
    sources[2u] = MemorySource::HeapBacking;
    return sources;
}

