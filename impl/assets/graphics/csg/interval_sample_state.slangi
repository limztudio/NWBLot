[[vk::binding(NWB_BINDLESS_HEAP_BINDING_UNIFORM_BUFFER, NWB_BINDLESS_HEAP_RESOURCE_SET)]] ConstantBuffer<NwbCsgIntervalSampleState, Std140DataLayout> g_NwbHeapCsgIntervalSampleStates[];
