enum<u8> MaterialBindDependencyMergeAction{
    KeepMultiInterface = 0,
    AssignFirstInterface = 1,
    MatchExistingInterface = 2,
    PromoteToMultiInterface = 3,
    kCount
}

MaterialBindDependencyMergeAction ClassifyMaterialBindDependencyInterface(in b8 dependsOnMultipleInterfaces, in Name currentInterfaceName, in Name incomingInterfaceName){
    if(dependsOnMultipleInterfaces)
        return MaterialBindDependencyMergeAction::KeepMultiInterface;
    if(currentInterfaceName == s_NameNone)
        return MaterialBindDependencyMergeAction::AssignFirstInterface;
    if(currentInterfaceName == incomingInterfaceName)
        return MaterialBindDependencyMergeAction::MatchExistingInterface;
    return MaterialBindDependencyMergeAction::PromoteToMultiInterface;
}

usize CountVariantAssignmentReserve(in StringView rawVariantView){
    usize count = 1u;
    for(usize i = 0u; i < rawVariantView.size(); ++i){
        if(rawVariantView[i] == ';')
            ++count;
    }
    return count;
}

Expected<b8> TryConvertMaterialBoolInteger(in i64 propertyInt){
    if(propertyInt == 0)
        return false;
    if(propertyInt == 1)
        return true;
    return MakeUnexpected(Failure());
}

b8 ValidateNonEmptyMaterialCookInterface(in StringView materialVirtualPath, in StringView materialInterface){
    if(!materialInterface.empty())
        return true;

    error("Material '{}' is missing required material interface", materialVirtualPath);
    return false;
}

Expected<b8> ParseMaterialBoolProperty(in Path nwbFilePath, in MetascriptValue asset, in StringView fieldName){
    b8 isInteger = false;
    i64 integerValue = 0;
    const b8 found = asset.visitField(
        fieldName,
        lambda[mut isInteger, mut integerValue](in MetascriptValue propertyValue) -> void{
            if(propertyValue.isInteger()){
                isInteger = true;
                integerValue = propertyValue.asInteger();
            }
        }
    );
    if(!found){
        error("Material meta '{}': '{}' is required and must be 0 or 1", PathToString(nwbFilePath), fieldName);
        return MakeUnexpected(Failure());
    }
    if(isInteger){
        const Expected<b8> converted = TryConvertMaterialBoolInteger(integerValue);
        if(converted.has_value())
            return converted.value();
    }
    error("Material meta '{}': '{}' must be 0 or 1", PathToString(nwbFilePath), fieldName);
    return MakeUnexpected(Failure());
}

b8 AppendParsedMaterialParameter(
    in Path nwbFilePath,
    in StringView paramKeyText,
    in MetascriptValue paramValue,
    mut HashMap<CompactString, CompactString> outParameters
){
    if(!paramValue.isString()){
        error("Material meta '{}': parameter '{}' must be a string", nwbFilePath, paramKeyText);
        return false;
    }

    CompactString key;
    CompactString value;
    if(!key.assign(paramKeyText) || !value.assign(paramValue.asString())){
        error("Material meta '{}': parameter '{}' exceeds ACompactString capacity", nwbFilePath, paramKeyText);
        return false;
    }
    if(key.view().empty()){
        error("Material meta '{}': parameter names must not be empty", nwbFilePath);
        return false;
    }

    if(!outParameters.try_emplace(key, value).second){
        error("Material meta '{}': duplicate parameter '{}'", nwbFilePath, key.view());
        return false;
    }

    return true;
}

b8 ParseMaterialMetadataParametersInto(
    in Path nwbFilePath,
    in MetascriptValue asset,
    mut HashMap<CompactString, CompactString> outParameters
){
    outParameters.clear();

    b8 found = false;
    b8 isMap = false;
    b8 ok = true;
    in auto nwbFilePathRef = nwbFilePath;
    asset.visitField(
        s_MaterialMetaParametersField,
        lambda[in nwbFilePathRef, mut found, mut isMap, mut ok, mut outParameters](in MetascriptValue parametersValue) -> void{
            found = true;
            isMap = parametersValue.isMap();
            if(!isMap){
                ok = false;
                return;
            }
            if(!parametersValue.forEachMapEntry(
                lambda[in nwbFilePathRef, mut ok, mut outParameters](in StringView paramKeyText, in MetascriptValue paramValue) -> b8{
                    if(paramValue.isString()){
                        error("Material meta '{}': interface parameter '{}' must be declared inside a block map", nwbFilePathRef, paramKeyText);
                        ok = false;
                        return false;
                    }
                    if(!paramValue.isMap()){
                        error("Material meta '{}': parameter '{}' must be a block map", nwbFilePathRef, paramKeyText);
                        ok = false;
                        return false;
                    }
                    if(paramKeyText.empty()){
                        error("Material meta '{}': parameter block names must not be empty", nwbFilePathRef);
                        ok = false;
                        return false;
                    }

                    return paramValue.forEachMapEntry(
                        lambda[in nwbFilePathRef, in paramKeyText, mut ok, mut outParameters](in StringView blockParamKeyText, in MetascriptValue blockParamValue) -> b8{
                            if(blockParamKeyText.empty()){
                                error("Material meta '{}': parameter names in block '{}' must not be empty", nwbFilePathRef, paramKeyText);
                                ok = false;
                                return false;
                            }

                            const Expected<CompactString> flattenedKey = BuildMaterialBindParameterKey(paramKeyText, blockParamKeyText);
                            if(!flattenedKey.has_value()){
                                error("Material meta '{}': parameter '{}.{}' exceeds ACompactString capacity", nwbFilePathRef, paramKeyText, blockParamKeyText);
                                ok = false;
                                return false;
                            }
                            if(!AppendParsedMaterialParameter(nwbFilePathRef, flattenedKey.value().view(), blockParamValue, outParameters)){
                                ok = false;
                                return false;
                            }
                            return true;
                        }
                    );
                }
            ))
                ok = false;
        }
    );
    if(!found)
        return true;
    if(!isMap){
        error("Material meta '{}': parameters must be a map", nwbFilePath);
        return false;
    }
    return ok;
}

b8 HasProjectAssetVirtualRoot(in StringView path){
    const Expected<CompactString> root = ExtractAssetVirtualRoot(path);
    return root.has_value() && root.value().view() == s_ProjectVirtualRoot;
}

b8 ReadMaterialVariant(in Path file, in MetascriptValue asset, mut String result){
    const Optional<in MetascriptValue> field = asset.borrowField(s_MaterialMetaShaderVariantField);
    if(!field.has_value()){
        error("Material meta '{}': field '{}' is required", file, s_MaterialMetaShaderVariantField);
        return false;
    }
    String joined;
    StringView raw = "";
    if(field.value().isList()){
        const Span<MetascriptValue> list = field.value().listView();
        usize bytes = 0u;
        if(!list.empty())
            bytes = list.size() - 1u;
        for(in MetascriptValue item : list){
            if(!item.isString()){
                error("Material meta '{}': field '{}' list elements must be strings", file, s_MaterialMetaShaderVariantField);
                return false;
            }
            bytes += item.asString().size();
        }
        joined.reserve(bytes);
        for(usize index = 0u; index < list.size(); ++index){
            if(index > 0u)
                joined.push_back(';');
            joined.append(list[index].asString());
        }
        raw = joined;
    }
    else if(field.value().isString())
        raw = field.value().asString();
    else{
        error("Material meta '{}': field '{}' must be a string or list of strings", file, s_MaterialMetaShaderVariantField);
        return false;
    }

    const StringView signature = TrimView(raw);
    if(signature.empty()){
        error("Material meta '{}': field '{}' must not be empty", file, s_MaterialMetaShaderVariantField);
        return false;
    }
    if(signature == s_ShaderDefaultVariantText){
        result.assign(signature);
        return true;
    }
    Vector<ShaderVariantAssignment> assignments;
    assignments.reserve(CountVariantAssignmentReserve(signature));
    usize cursor = 0u;
    while(cursor < signature.size()){
        const Expected<ShaderVariantAssignment, ShaderVariantSegmentFailure> assignment = TryParseVariantSignatureSegment(signature, cursor);
        if(!assignment.has_value()){
            error("Material meta '{}': field '{}' has invalid variant signature '{}'", file, s_MaterialMetaShaderVariantField, signature);
            return false;
        }
        assignments.push_back(assignment.value());
    }
    if(!BuildSortedShaderVariantName(assignments, result)){
        error("Material meta '{}': field '{}' has invalid variant signature '{}'", file, s_MaterialMetaShaderVariantField, signature);
        return false;
    }
    return true;
}

b8 ReadMaterialStageShaders(in Path file, in MetascriptValue asset, mut MaterialStageShaderMap stages){
    const Optional<in MetascriptValue> field = asset.borrowField(s_MaterialMetaShadersField);
    if(!field.has_value())
        return true;
    if(!field.value().isMap()){
        error("Material meta '{}': shaders must be a map", file);
        return false;
    }
    in auto fileRef = file;
    if(!field.value().forEachMapEntry(lambda[in fileRef, mut stages](in StringView key, in MetascriptValue value) -> b8{
        if(!value.isString()){
            error("Material meta '{}': shader '{}' must be a string", fileRef, key);
            return false;
        }
        const StringView path = TrimView(value.asString());
        if(!HasProjectAssetVirtualRoot(path)){
            error("Material meta '{}': shader stage '{}' must use the project/ virtual root", fileRef, key);
            return false;
        }
        const Expected<Optional<Name>, NameTextError> keyName = ToName(key);
        const Expected<Optional<Name>, NameTextError> pathName = ToName(path);
        if(!keyName.has_value() || !keyName.value().has_value() || !pathName.has_value() || !pathName.value().has_value()){
            error("Material meta '{}': shader stage entries must not be empty", fileRef);
            return false;
        }
        const ShaderType stage = ShaderTypeFromArchiveStageName(keyName.value().value());
        const AssetRef<IShader> shader(pathName.value().value());
        if(stage == ShaderType::Invalid || !shader.valid()){
            error("Material meta '{}': shader stage entries must not be empty", fileRef);
            return false;
        }
        if(!IsSupportedMaterialShaderStage(stage)){
            error("Material meta '{}': shader stage '{}' is not supported by the ECS renderer material contract; only 'mesh' and 'ps' are allowed", fileRef, key);
            return false;
        }
        if(!stages.emplace(stage, shader).second){
            error("Material meta '{}': duplicate shader stage '{}'", fileRef, key);
            return false;
        }
        return true;
    }))
        return false;
    if(stages.empty()){
        error("Material meta '{}': shaders must not be empty", file);
        return false;
    }
    return true;
}

b8 ReadMaterialVirtualAssetField(in Path file, in MetascriptValue asset, in StringView field, in StringView extension, in b8 isInterface, mut String result){
    const Expected<MetadataStringField> value = ReadMetadataStringField(file, asset, s_MaterialMetaDiagnosticPrefix, field, isInterface);
    if(!value.has_value())
        return false;
    if(!value.value().present)
        return true;
    const StringView text = TrimView(value.value().text);
    if(text.empty()){
        error("Material meta '{}': field '{}' must not be empty", file, field);
        return false;
    }
    if(!HasProjectAssetVirtualRoot(text)){
        error("Material meta '{}': field '{}' must use the project/ virtual root (e.g. 'project/shaders/name{}')", file, field, extension);
        return false;
    }
    Path path(text);
    if(!AssetPathHasExtension(path, extension)){
        error("Material meta '{}': field '{}' must reference a {} file", file, field, extension);
        return false;
    }
    if(isInterface){
        path.replaceExtension();
        result.assign(StringView(PathToString(path)));
    }
    else
        result.assign(text);
    for(usize index = 0u; index < result.size(); ++index){
        if(result[index] == '\\')
            result[index] = '/';
    }
    if(isInterface){
        const Expected<Optional<Name>, NameTextError> name = ToName(result);
        if(!name.has_value() || !name.value().has_value()){
            error("Material meta '{}': interface '{}' is invalid", file, text);
            return false;
        }
    }
    return true;
}

b8 FillMaterialCookEntry(in Path root, in StringView virtualRoot, in Path file, in MetascriptValue asset, mut MaterialCookEntry entry){
    const Expected<String> path = DeriveAssetVirtualPathText(root, virtualRoot, file);
    if(!path.has_value())
        return false;
    const Expected<Optional<Name>, NameTextError> pathName = ToName(path.value());
    if(!pathName.has_value() || !pathName.value().has_value()){
        error("Material meta '{}': failed to derive a valid virtual path", file);
        return false;
    }
    entry.virtualPath = path.value();
    if(!ValidateMetadataAssetFields(file, asset, s_MaterialMetaDiagnosticPrefix, IsAllowedMaterialAssetField)
        || !ReadMaterialVariant(file, asset, entry.shaderVariant)
        || !ReadMaterialVirtualAssetField(file, asset, s_MaterialMetaInterfaceField, s_MaterialBindSourceExtensionText, true, entry.materialInterface)
        || !ReadMaterialVirtualAssetField(file, asset, s_MaterialMetaBxdfField, s_MaterialBxdfExtension, false, entry.bxdfSource)
        || !ReadMaterialVirtualAssetField(file, asset, s_MaterialMetaSurfaceField, s_MaterialSurfaceExtension, false, entry.surfaceSource))
        return false;
    const Expected<b8> transparent = ParseMaterialBoolProperty(file, asset, s_MaterialMetaTransparentField);
    if(!transparent.has_value())
        return false;
    entry.transparent = transparent.value();
    const Expected<b8> twoSided = ParseMaterialBoolProperty(file, asset, s_MaterialMetaTwoSidedField);
    if(!twoSided.has_value())
        return false;
    entry.twoSided = twoSided.value();
    const Expected<b8> refractive = ParseMaterialBoolProperty(file, asset, s_MaterialMetaRefractiveField);
    if(!refractive.has_value())
        return false;
    entry.refractive = refractive.value();
    if(!ReadMaterialStageShaders(file, asset, entry.stageShaders))
        return false;
    if(!IsMaterialOpticalStageCombinationValid(!entry.stageShaders.empty(), !entry.surfaceSource.empty(), entry.transparent, entry.refractive)){
        error("Material meta '{}': explicit 'shaders' cannot be used with transparent/refractive materials; author a project 'surface' hook so AVBOIT and shadow optical passes use the material contract", file);
        return false;
    }
    return ParseMaterialMetadataParametersInto(file, asset, entry.parameters);
}

Expected<MaterialCookEntry> ParseMaterialCookMetadata(in Path root, in StringView virtualRoot, in Path file, in MetascriptDocument doc){
    MaterialCookEntry entry;
    in auto rootRef = root;
    in auto fileRef = file;
    if(!VisitMetadataAssetMap(file, doc, s_MaterialMetaDiagnosticPrefix, lambda[in rootRef, in virtualRoot, in fileRef, mut entry](in MetascriptValue asset) -> b8{
        return FillMaterialCookEntry(rootRef, virtualRoot, fileRef, asset, entry);
    }))
        return MakeUnexpected(Failure());
    return entry;
}

[asset_writer]
b8 SerializeMaterialAsset(in Material material, mut Vector<u8> outBinary){
    if(!material.validatePayload(s_MaterialSerializeContextText, s_MaterialSerializeContextText))
        return false;
    return MaterialBinaryWriter().serialize(
        material.shaderVariant(),
        material.materialInterface(),
        material.typedLayoutHash(),
        material.typedLayoutBlocks(),
        material.typedLayoutFields(),
        material.typedBlockBytes(),
        material.resourceReferences(),
        material.stageShaders(),
        material.stageShaderCount(),
        material.transparent(),
        material.twoSided(),
        material.refractive(),
        material.shadingModelId(),
        material.surfaceDispatchId(),
        material.avboitAccumulatePixelShader(),
        material.avboitOccupancyPixelShader(),
        material.avboitExtinctionPixelShader(),
        outBinary
    );
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
Expected<Material> BuildMaterialAsset(in MaterialCookEntry entry){
    if(!ValidateMaterialCookEntryRequiredFields(entry.virtualPath, entry.materialInterface, entry.typedLayoutHash, entry.shaderVariant))
        return MakeUnexpected(Failure());
    const Expected<Optional<Name>, NameTextError> path = ToName(entry.virtualPath);
    if(!path.has_value() || !path.value().has_value()){
        error("Material cook: virtual path contains an embedded null");
        return MakeUnexpected(Failure());
    }
    Material asset(path.value().value());
    asset.setShaderVariant(entry.shaderVariant);
    const Expected<Optional<Name>, NameTextError> interfaceName = ToName(entry.materialInterface);
    if(!interfaceName.has_value() || !interfaceName.value().has_value()){
        error("Material cook: interface contains an embedded null");
        return MakeUnexpected(Failure());
    }
    asset.setMaterialInterface(interfaceName.value().value());
    asset.setShadingModelId(entry.shadingModelId);
    asset.setSurfaceDispatchId(entry.surfaceDispatchId);
    const Expected<AssetRef<PixelShader>> accumulateResult = TryResolveOptionalMaterialAvboitPixelShader(entry.virtualPath, entry.avboitAccumulatePixelShaderName, s_MaterialAvboitAccumulatePassLabel);
    if(!accumulateResult.has_value())
        return MakeUnexpected(accumulateResult.error());
    const AssetRef<PixelShader> accumulate = accumulateResult.value();
    const Expected<AssetRef<PixelShader>> occupancyResult = TryResolveOptionalMaterialAvboitPixelShader(entry.virtualPath, entry.avboitOccupancyPixelShaderName, s_MaterialAvboitOccupancyPassLabel);
    if(!occupancyResult.has_value())
        return MakeUnexpected(occupancyResult.error());
    const AssetRef<PixelShader> occupancy = occupancyResult.value();
    const Expected<AssetRef<PixelShader>> extinctionResult = TryResolveOptionalMaterialAvboitPixelShader(entry.virtualPath, entry.avboitExtinctionPixelShaderName, s_MaterialAvboitExtinctionPassLabel);
    if(!extinctionResult.has_value())
        return MakeUnexpected(extinctionResult.error());
    const AssetRef<PixelShader> extinction = extinctionResult.value();
    asset.setAvboitAccumulatePixelShader(accumulate);
    asset.setAvboitOccupancyPixelShader(occupancy);
    asset.setAvboitExtinctionPixelShader(extinction);
    asset.setTransparent(entry.transparent);
    asset.setTwoSided(entry.twoSided);
    asset.setRefractive(entry.refractive);
    if(!HasValidMaterialAvboitPixelShaderContract(entry.transparent, accumulate, occupancy, extinction)){
        error("Material cook: material '{}' AVBOIT pixel shaders must be present if and only if it is transparent", entry.virtualPath);
        return MakeUnexpected(Failure());
    }
    asset.setTypedLayout(entry.typedLayoutHash, entry.typedLayoutBlocks, entry.typedLayoutFields, entry.typedBlockBytes);
    asset.setResourceReferences(entry.resourceReferences);
    for(in auto stage : entry.stageShaders){
        if(!asset.setShaderForStage(stage.first, stage.second)){
            error("Material cook: invalid shader stage '{}' for '{}'", ArchiveStageNameFromShaderType(stage.first).resolvedText(), entry.virtualPath);
            return MakeUnexpected(Failure());
        }
    }
    return asset;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static_assert(s_MaterialBindSourceExtensionText == ".bind", "material bind files use the .bind extension");

b8 TryResolveMaterialBindDependencyInterface(in Path root, in Path dependency, mut String interfacePath){
    interfacePath.clear();
    if(root.empty())
        return true;
    const Expected<Path, ErrorCode> absolute = AbsolutePath(dependency);
    if(!absolute.has_value()){
        error("Material bind dependency: failed to normalize shader dependency '{}': {}", dependency, ErrorCodeMessage(absolute.error()));
        return false;
    }
    const Path normalized = absolute.value().lexicallyNormal();
    if(!PathHasDirectoryAncestor(normalized, root) || !AssetPathHasExtension(normalized, s_MaterialBindSourceExtensionText))
        return true;
    Path relative = normalized.lexicallyRelative(root);
    relative.replaceExtension();
    if(!WriteRelativeAssetPathText(relative, interfacePath)){
        error("Material bind dependency: failed to derive interface from generated include '{}'", normalized);
        return false;
    }
    return true;
}

Expected<MaterialBindDependency> ResolveMaterialBindDependencyInterface<PathRange>(
    in StringView shaderName,
    in Path includeRoot,
    in Span<MaterialBindEntry> entries,
    in PathRange dependencies
){
    MaterialBindDependency result;
    Path root;
    if(!includeRoot.empty()){
        const Expected<Path, ErrorCode> absolute = AbsolutePath(includeRoot);
        if(!absolute.has_value()){
            error("Material bind dependency: failed to normalize generated include root '{}': {}", includeRoot, ErrorCodeMessage(absolute.error()));
            return MakeUnexpected(Failure());
        }
        root = absolute.value().lexicallyNormal();
    }
    String path;
    b8 multiple = false;
    for(in auto dependency : dependencies){
        if(!TryResolveMaterialBindDependencyInterface(root, dependency, path))
            return MakeUnexpected(Failure());
        if(path.empty())
            continue;
        const Expected<Name> name = ReadMaterialCookName(path);
        if(!name.has_value()){
            error("Material bind dependency: shader '{}' includes invalid generated material bind interface '{}'", shaderName, path);
            return MakeUnexpected(Failure());
        }
        usize index = 0u;
        while(index < entries.size()){
            const Expected<Name> candidate = ReadMaterialCookName(entries[index].virtualPath);
            if(candidate.has_value() && candidate.value() == name.value())
                break;
            ++index;
        }
        if(index == entries.size()){
            error("Material bind dependency: shader '{}' includes generated material bind interface '{}' with no authored source", shaderName, path);
            return MakeUnexpected(Failure());
        }
        const Path source(entries[index].source);
        AppendOwnedPath(result.interfaceSources, source);
        result.dependsOnMaterialBind = true;
        const MaterialBindDependencyMergeAction action = ClassifyMaterialBindDependencyInterface(multiple, result.interfaceName, name.value());
        if(action == MaterialBindDependencyMergeAction::AssignFirstInterface){
            result.interfacePath = path;
            result.interfaceName = name.value();
        }
        else if(action == MaterialBindDependencyMergeAction::PromoteToMultiInterface){
            result.interfacePath.clear();
            result.interfaceName = s_NameNone;
            multiple = true;
        }
    }
    return result;
}

[cpp_unwind]
b8 ValidateMaterialCookInterfaces(in Span<MaterialBindEntry> entries, mut Span<MaterialCookEntry> materials){
    const Expected<MaterialBindInterfaceLookup> lookup = BuildMaterialBindInterfaceLookup(entries);
    if(!lookup.has_value())
        return false;
    MaterialBindTypedLayoutCache cache;
    cache.reserve(Min(entries.size(), materials.size()));
    for(mut MaterialCookEntry material : materials){
        material.typedLayoutHash = 0u;
        material.typedLayoutBlocks.clear();
        material.typedLayoutFields.clear();
        material.typedBlockBytes.clear();
        material.resourceReferences.clear();
        if(!ValidateNonEmptyMaterialCookInterface(material.virtualPath, material.materialInterface))
            return false;
        const Expected<Name> interfaceName = ReadMaterialCookName(material.materialInterface);
        if(!interfaceName.has_value() || !lookup.value().contains(interfaceName.value())){
            error("Material '{}' references unknown material interface '{}'", material.virtualPath, material.materialInterface);
            return false;
        }
        in MaterialBindEntry source = entries[lookup.value().at(interfaceName.value())];
        const Expected<usize> layoutIndex = FindOrBuildMaterialBindTypedLayout(interfaceName.value(), source, cache);
        if(!layoutIndex.has_value()){
            error("Material '{}' failed to resolve typed layout cache for interface '{}'", material.virtualPath, material.materialInterface);
            return false;
        }
        in MaterialBindTypedLayout layout = cache.entries[layoutIndex.value()];
        CopyMaterialBindTypedLayoutDefaults(layout, material.typedLayoutHash, material.typedLayoutBlocks, material.typedLayoutFields, material.typedBlockBytes);
        const Expected<Name> name = ReadMaterialCookName(material.virtualPath);
        if(!name.has_value() || !ApplyMaterialBindTypedLayoutParameters(layout, name.value(), material.parameters, material.typedBlockBytes, material.resourceReferences))
            return false;
        if(!ValidateMaterialResourceReferences(material.typedLayoutBlocks, material.typedLayoutFields, material.resourceReferences)){
            error("Material '{}': resource fields must be assigned engine or project asset paths in parameters", material.virtualPath);
            return false;
        }
    }
    return true;
}


