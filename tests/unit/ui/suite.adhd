    ASSERT_TRUE(m_builder.endPopup());
    EXPECT_EQ(m_childSource.metadataCalls, 0u);
    EXPECT_EQ(m_childSource.textCalls, 0u);
    EXPECT_TRUE(m_child.isOpen());
