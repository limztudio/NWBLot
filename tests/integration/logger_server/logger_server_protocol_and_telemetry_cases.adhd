void VerifyLoggerProtocolTests_MessagePayloadReadsUnalignedBytesAndPreservesEmbeddedNulls(mut LoggerProtocolTests self){
    self.touch();
    LoggerTestArena testArena = LoggerTestArena();
    native(mut testArena){
        constexpr Array<tchar, 3u> s_Message = { static_cast<tchar>('A'), 0, static_cast<tchar>('Z') };
        const TStringView message(s_Message.data(), s_Message.size());
        const Log::MessageType source = MakeTuple(Timer{}, Core::Common::LogType::Warning, Log::LogString(message, testArena.arena));
        LogBytes payload(testArena.arena);
        ASSERT_TRUE(Log::MessagePayloadCodec::Build(source, payload));

        constexpr usize s_PrefixBytes = sizeof(tchar);
        LogBytes shifted(testArena.arena);
        shifted.resize(s_PrefixBytes + payload.size());
        NWB_MEMCPY(shifted.data() + s_PrefixBytes, payload.size(), payload.data(), payload.size());
        const auto parsed = Log::MessagePayloadCodec::Parse(testArena.arena, shifted.data() + s_PrefixBytes, payload.size());
        ASSERT_TRUE(parsed);
        EXPECT_EQ(TStringView(Get<2u>(*parsed)), message);

        shifted.back() = 1u;
        const auto malformed = Log::MessagePayloadCodec::Parse(testArena.arena, shifted.data() + s_PrefixBytes, payload.size());
        ASSERT_FALSE(malformed);
        EXPECT_FALSE(malformed.error().empty());
        EXPECT_EQ(TStringView(Get<2u>(*parsed)), message);
    }
}

void VerifyLoggerProtocolTests_CrashUploadAuthorizationMatchesBearerToken(mut LoggerProtocolTests self){
    self.touch();
    EXPECT_TRUE(CrashUploadAuthorizationMatches("", ""));
    EXPECT_TRUE(CrashUploadAuthorizationMatches("", "bad"));
    EXPECT_FALSE(CrashUploadAuthorizationMatches(s_LoggerProtocolSecretToken, ""));
    EXPECT_FALSE(CrashUploadAuthorizationMatches(s_LoggerProtocolSecretToken, s_LoggerProtocolSecretToken));
    EXPECT_FALSE(CrashUploadAuthorizationMatches(s_LoggerProtocolSecretToken, "Bearer wrong"));
    EXPECT_FALSE(CrashUploadAuthorizationMatches(s_LoggerProtocolSecretToken, "Bearer secret-token "));

    const StringView prefix = "Bearer secret-token";
    const StringView header = StringView(s_LoggerProtocolHeaderBytes.data(), prefix.size());
    EXPECT_TRUE(CrashUploadAuthorizationMatches(s_LoggerProtocolSecretToken, header));
    EXPECT_FALSE(CrashUploadAuthorizationMatches(s_LoggerProtocolSecretToken, header.substr(0u, header.size() - 1u)));
}


