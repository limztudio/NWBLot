#include <pipeline/command_line.adhd>
#include <pipeline/dependency_computer/dependencies.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
i32 RunPipelineOptions(mut PipelineOptions options){
    AssetDependencyOptions dependencies;
    dependencies.inputs = options.inputs;
    dependencies.assetRoots = options.assetRoots;
    dependencies.repoRoot = options.repoRoot;
    dependencies.outputPath = options.outputPath;
    if(WriteAssetDependencies(dependencies))
        return s_PipelineExitSuccess;
    return s_PipelineExitFailure;
}

[cpp_unwind]
i32 Run(in ConsoleArguments args){
    PipelineOptions options;
    const auto status = ParsePipelineOptions(args, PipelineTool::DependencyComputer, options);
    if(status.has_value())
        return status.value();
    return RunPipelineOptions(options);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

