[[nodiscard]] FOUNDATION_INLINE i32 MakeUiEditOutOfBoundsKeyCode()noexcept{ return static_cast<i32>(::NWB::Core::Key::Menu) + 1; }
[[nodiscard]] FOUNDATION_INLINE InputCommandEnum MakeUiEditInvalidInputCommand()noexcept{ return static_cast<InputCommandEnum>(255u); }
[[nodiscard]] FOUNDATION_INLINE EditCommandEnum MakeUiEditInvalidEditCommand()noexcept{ return static_cast<EditCommandEnum>(255u); }
[[nodiscard]] FOUNDATION_INLINE EditTextModeEnum MakeUiEditInvalidTextMode()noexcept{ return static_cast<EditTextModeEnum>(255u); }
[[nodiscard]] FOUNDATION_INLINE AStringView MakeUiEditSingleNullView()noexcept{ return AStringView("\0", 1u); }
[[nodiscard]] FOUNDATION_INLINE AStringView MakeUiEditEmbeddedNullView()noexcept{ return AStringView("a\0b", 3u); }
[[nodiscard]] FOUNDATION_INLINE b8 UiEditValidateGraphemes(const AStringView text, const b8 singleLine = false)noexcept{
    return ::NWB::Impl::Ui::GraphemeSegmentation::Validate(text, singleLine);
}
[[nodiscard]] FOUNDATION_INLINE b8 UiEditIsAsciiDigit(const u8 ch)noexcept{ return ::IsAsciiDigit(static_cast<char>(ch)); }
FOUNDATION_INLINE void UiKeepEditArenaAlive(const GlobalArena&)noexcept{}
FOUNDATION_INLINE void UiKeepEditTestArenaAlive(const TestArena&)noexcept{}
[[nodiscard]] FOUNDATION_INLINE Expected<::AString<::ArenaBase>, EditTextStatusEnum> UiNormalizeSingleLineToString(TestArena& arena, const AStringView text, const usize maxBytes){
    auto result = ::NWB::Impl::Ui::NormalizeSingleLineText(arena.arena, text, maxBytes);
    if(!result)
        return MakeUnexpected(result.error());
    return ::AString<::ArenaBase>(AStringView(*result), static_cast<::ArenaBase&>(arena.arena));
}
[[nodiscard]] FOUNDATION_INLINE b8 VerifyUiSingleLineAliasedInputCopy(){
    ::NWB::Tests::TestArena<> arena;
    ::AString<::NWB::Core::Alloc::GlobalArena> output("prefix a\r\nb", arena.arena);
    const ::AStringView source(output.data() + 7u, output.size() - 7u);
    auto normalized = ::NWB::Impl::Ui::NormalizeSingleLineText(arena.arena, source, 3u);
    if(!normalized)
        return false;
    output = Move(*normalized);
    return output == "a b";
}
[[nodiscard]] FOUNDATION_INLINE f64 UiFloatModelInfinity()noexcept{ return ::Limit<f64>::s_Infinity; }
[[nodiscard]] FOUNDATION_INLINE f64 UiFloatModelQuietNaN()noexcept{ return ::Limit<f64>::s_QuietNaN; }
};


