#include <impl/assets_font/asset.adhd>
#include <impl/ecs_ui/toolkit/text/atlas_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


type GlyphPagePixels = Vector<u8>;
type SharedGlyphPage = Shared<GlyphPage>;

class GlyphPage : NoCopy{
    private GlyphPageBindingRecord<Font> m_binding;
    private GlyphPagePixels m_pixels;

    public GlyphPage(in GlyphPageBindingRecord<Font> binding, in Span<u8> pixels){
        this.m_binding = binding;
        AssignTriviallyCopyableVector(this.m_pixels, pixels);
    }

    public in GlyphPageBindingRecord<Font> binding()const{ return this.m_binding; }
    public in GlyphPagePixels pixels()const{ return this.m_pixels; }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<SharedGlyphPage> CopyGlyphPage(in SharedPool pool, in GlyphPageBindingRecord<Font> binding, in Span<u8> pixels){
    if(!ValidGlyphPageBinding<Font>(binding, pixels.size()))
        return MakeUnexpected(Failure());
    return pool.make<GlyphPage>(binding, pixels);
}

Expected<SharedGlyphPage> CreateGlyphPage(in SharedPool pool, in GlyphPageBindingRecord<Font> binding, mut Vector<u8> pixels){
    Expected<SharedGlyphPage> page = CopyGlyphPage(pool, binding, Span<u8>(pixels));
    if(page.has_value())
        pixels.clear();
    return page;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

