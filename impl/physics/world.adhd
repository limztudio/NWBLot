        if(!this.isValidShape(shapeId) || this.m_shapes[shapeId.index].type != ShapeType::Chain)
            return MakeUnexpected(Failure());
        const u32 gIdx = this.m_shapes[shapeId.index].geometryIndex;
        if(gIdx >= this.m_chainShapes.size())
            return MakeUnexpected(Failure());
        return this.m_chainShapes[gIdx];
    }

    public Expected<SdfShape> tryGetSdfShape(in ShapeId shapeId)const{
        if(!this.isValidShape(shapeId) || this.m_shapes[shapeId.index].type != ShapeType::Sdf)
            return MakeUnexpected(Failure());
        const u32 gIdx = this.m_shapes[shapeId.index].geometryIndex;
        if(gIdx >= this.m_sdfShapes.size())
            return MakeUnexpected(Failure());
        return this.m_sdfShapes[gIdx];
    }

    public Transform3D shapeLocalTransform(in ShapeId shapeId)const{
        if(!this.isValidShape(shapeId))
            return Transform3D();
        return this.m_shapes[shapeId.index].localTransform;
    }

    public u32 meshTriangleUserData(in ShapeId shapeId, in u32 triangleIndex)const{
        if(!this.isValidShape(shapeId) || this.m_shapes[shapeId.index].type != ShapeType::Mesh)
            return 0u;
        const u32 gIdx = this.m_shapes[shapeId.index].geometryIndex;
        if(gIdx >= this.m_meshShapes.size())
            return 0u;
        return this.m_meshShapes[gIdx].triangleUserDataAt(triangleIndex);
    }

    public Expected<b8> tryGetShapeEnableContactEvents(in ShapeId shapeId)const{
        if(!this.isValidShape(shapeId))
            return MakeUnexpected(Failure());
        return this.m_shapes[shapeId.index].enableContactEvents();
    }

    public Expected<b8> tryGetShapeEnableHitEvents(in ShapeId shapeId)const{
        if(!this.isValidShape(shapeId))
            return MakeUnexpected(Failure());
        return this.m_shapes[shapeId.index].enableHitEvents();
    }

    public Expected<b8> tryGetShapeEnableSensorEvents(in ShapeId shapeId)const{
        if(!this.isValidShape(shapeId))
            return MakeUnexpected(Failure());
        return this.m_shapes[shapeId.index].enableSensorEvents();
    }

    public Expected<b8> tryGetShapeEnablePreSolveEvents(in ShapeId shapeId)const{
        if(!this.isValidShape(shapeId))
            return MakeUnexpected(Failure());
        return this.m_shapes[shapeId.index].enablePreSolveEvents();
    }

    public Expected<b8> tryGetShapeEnablePostSolveEvents(in ShapeId shapeId)const{
        if(!this.isValidShape(shapeId))
            return MakeUnexpected(Failure());
        return this.m_shapes[shapeId.index].enablePostSolveEvents();
    }

    public b8 setShapeEnableContactEvents(in ShapeId shapeId, in b8 enabled){
        if(!this.isValidShape(shapeId))
            return false;
        if(this.m_shapes[shapeId.index].enableContactEvents() == enabled)
            return true;
        this.m_shapes[shapeId.index].setFlag(ShapeFlags::EnableContactEvents, enabled);
        this.refreshShapeContactEventFlags(shapeId.index);
        return true;
    }

    public b8 setShapeEnableHitEvents(in ShapeId shapeId, in b8 enabled){
        if(!this.isValidShape(shapeId))
            return false;
        if(this.m_shapes[shapeId.index].enableHitEvents() == enabled)
            return true;
        this.m_shapes[shapeId.index].setFlag(ShapeFlags::EnableHitEvents, enabled);
        if(enabled)
            ++this.m_hitEventShapeCount;
        else if(this.m_hitEventShapeCount > 0u)
            --this.m_hitEventShapeCount;
        this.refreshShapeContactEventFlags(shapeId.index);
        return true;
    }

    public b8 setShapeEnableSensorEvents(in ShapeId shapeId, in b8 enabled){
        if(!this.isValidShape(shapeId))
            return false;
        mut Shape shape = this.m_shapes[shapeId.index];
        if(shape.enableSensorEvents() == enabled)
            return true;
        const b8 wasSensorEv = shape.isSensor() && shape.enableSensorEvents();
        shape.setFlag(ShapeFlags::EnableSensorEvents, enabled);
        const b8 nowSensorEv = shape.isSensor() && shape.enableSensorEvents();
        if(!wasSensorEv && nowSensorEv)
            ++this.m_sensorEventShapeCount;
        else if(wasSensorEv && !nowSensorEv && this.m_sensorEventShapeCount > 0u)
            --this.m_sensorEventShapeCount;
        if(shape.proxyKey != s_NullIndex)
            this.m_broadPhase.setNodeFlags(shape.proxyKey, this.computeShapeTreeNodeFlags(shape));
        this.refreshShapeContactEventFlags(shapeId.index);
        return true;
    }

    public b8 setShapeEnablePreSolveEvents(in ShapeId shapeId, in b8 enabled){
        if(!this.isValidShape(shapeId))
            return false;
        const u32 shapeIdx = shapeId.index;
        if(this.m_shapes[shapeIdx].enablePreSolveEvents() == enabled)
            return true;
        this.m_shapes[shapeIdx].setFlag(ShapeFlags::EnablePreSolveEvents, enabled);
        const u32 bodyIdx = this.m_shapes[shapeIdx].bodyId;
        if(bodyIdx < this.m_bodies.size() && this.m_bodies[bodyIdx].alive)
            this.wakeBody(this.makeBodyId(bodyIdx));
        this.wakeShapeNeighbors(shapeIdx);
        if(!enabled)
            this.refreshContactMaterialsForShape(shapeIdx);
        return true;
    }

    public b8 setShapeEnablePostSolveEvents(in ShapeId shapeId, in b8 enabled){
        if(!this.isValidShape(shapeId))
            return false;
        const u32 shapeIdx = shapeId.index;
        if(this.m_shapes[shapeIdx].enablePostSolveEvents() == enabled)
            return true;
        this.m_shapes[shapeIdx].setFlag(ShapeFlags::EnablePostSolveEvents, enabled);
        const u32 bodyIdx = this.m_shapes[shapeIdx].bodyId;
        if(bodyIdx < this.m_bodies.size() && this.m_bodies[bodyIdx].alive)
            this.wakeBody(this.makeBodyId(bodyIdx));
        this.wakeShapeNeighbors(shapeIdx);
        return true;
    }

    public Expected<u64> tryGetShapeUserData(in ShapeId shapeId)const{
        if(!this.isValidShape(shapeId))
            return MakeUnexpected(Failure());
        return this.m_shapes[shapeId.index].userData;
    }

    public b8 setShapeUserData(in ShapeId shapeId, in u64 userData){
        if(!this.isValidShape(shapeId))
            return false;
        this.m_shapes[shapeId.index].userData = userData;
        return true;
    }

    public b8 setShapeMaterial(in ShapeId shapeId, in SurfaceMaterial material){
        if(!this.isValidShape(shapeId))
            return false;
        if(
            !IsFinite(VectorSingle(material.friction, material.staticFriction, material.restitution, material.rollingResistance))
            || !IsFinite(VectorSingle(material.tangentSpeed))
            || !IsFinite(VectorSingle(material.surfaceVelocity))
            || !IsFinite(VectorSingle(material.anisotropicFriction))
            || !IsFinite(VectorSingle(material.frictionDirection).xyz)
            || material.friction < 0.0f
            || material.restitution < 0.0f
            || material.rollingResistance < 0.0f
            || material.anisotropicFriction.x < 0.0f
            || material.anisotropicFriction.y < 0.0f
            || material.anisotropicFriction.z < 0.0f
        )
            return false;

        const u32 shapeIdx = shapeId.index;
        in SurfaceMaterial curMat = this.m_shapes[shapeIdx].material;
        if(
            curMat.friction == material.friction
            && curMat.staticFriction == material.staticFriction
            && curMat.restitution == material.restitution
            && curMat.rollingResistance == material.rollingResistance
            && curMat.tangentSpeed == material.tangentSpeed
            && curMat.frictionCombineMode == material.frictionCombineMode
            && curMat.restitutionCombineMode == material.restitutionCombineMode
            && curMat.surfaceVelocity.x == material.surfaceVelocity.x
            && curMat.surfaceVelocity.y == material.surfaceVelocity.y
            && curMat.surfaceVelocity.z == material.surfaceVelocity.z
            && curMat.surfaceVelocity.w == material.surfaceVelocity.w
            && curMat.anisotropicFriction.x == material.anisotropicFriction.x
            && curMat.anisotropicFriction.y == material.anisotropicFriction.y
            && curMat.anisotropicFriction.z == material.anisotropicFriction.z
            && curMat.anisotropicFriction.w == material.anisotropicFriction.w
            && curMat.frictionDirection.x == material.frictionDirection.x
            && curMat.frictionDirection.y == material.frictionDirection.y
            && curMat.frictionDirection.z == material.frictionDirection.z
        )
            return true;
        this.m_shapes[shapeIdx].material = material;
        const u32 bodyIdx = this.m_shapes[shapeIdx].bodyId;
        if(bodyIdx < this.m_bodies.size() && this.m_bodies[bodyIdx].alive){
            this.wakeBody(this.makeBodyId(bodyIdx));
            this.wakeShapeNeighbors(shapeIdx);
            this.refreshContactMaterialsForShape(shapeIdx);
        }
        return true;
    }

    public b8 setShapeFilter(in ShapeId shapeId, in Filter filter){
        if(!this.isValidShape(shapeId))
            return false;

        const u32 shapeIdx = shapeId.index;
        in Filter curFilter = this.m_shapes[shapeIdx].filter;
        if(curFilter.categoryBits == filter.categoryBits && curFilter.maskBits == filter.maskBits && curFilter.groupIndex == filter.groupIndex)
            return true;
        this.m_shapes[shapeIdx].filter = filter;
        const u32 bodyIdx = this.m_shapes[shapeIdx].bodyId;
        if(bodyIdx < this.m_bodies.size() && this.m_bodies[bodyIdx].alive){
            this.wakeBody(this.makeBodyId(bodyIdx));
            this.wakeShapeNeighbors(shapeIdx);

            u32 edgeKey = this.m_bodies[bodyIdx].headContactKey;
            while(edgeKey != s_NullIndex){
                const u32 cId = DecodeContactKeyId(edgeKey);
                const u32 edgeIdx = DecodeContactKeyEdge(edgeKey);
                const u32 nextKey = this.m_contacts[cId].edges[edgeIdx].nextKey;
                const u32 sAId = this.m_contacts[cId].shapeIdA;
                const u32 sBId = this.m_contacts[cId].shapeIdB;
                if(sAId == shapeIdx || sBId == shapeIdx){
                    b8 keep = ShouldCollideFilters(this.m_shapes[sAId].filter, this.m_shapes[sBId].filter);
                    if(keep && this.m_customFilterCallback.has_value())
                        keep = this.m_customFilterCallback.value()(this.makeShapeId(sAId), this.makeShapeId(sBId));
                    if(!keep)
                        this.destroyContactInternal(cId);
                }
                edgeKey = nextKey;
            }

            if(this.m_shapes[shapeIdx].proxyKey != s_NullIndex){
                this.m_broadPhase.destroyProxy(this.m_shapes[shapeIdx].proxyKey);
                u32 newProxyKey = s_NullIndex;
                this.m_broadPhase.createProxyWithFlags(
                    this.m_bodies[bodyIdx].type,
                    this.m_shapes[shapeIdx].aabb,
                    filter.categoryBits,
                    this.computeShapeTreeNodeFlags(this.m_shapes[shapeIdx]),
                    shapeIdx,
                    true,
                    newProxyKey
                );
                this.m_shapes[shapeIdx].proxyKey = newProxyKey;
                if(this.m_bodies[bodyIdx].type != BodyType::Dynamic)
                    this.wakeOverlappingSleepingBodies(this.m_shapes[shapeIdx].aabb, bodyIdx);
            }
            this.markSetTopologyDirty(this.m_bodies[bodyIdx].setIndex);
        }
        else{
            ++this.m_topologyVersion;
        }
        return true;
    }

    public b8 setShapeSensor(in ShapeId shapeId, in b8 isSensor){
        if(!this.isValidShape(shapeId))
            return false;
        const u32 shapeIdx = shapeId.index;
        if(this.m_shapes[shapeIdx].isSensor() == isSensor)
            return true;
        const b8 wasSensorEv = this.m_shapes[shapeIdx].isSensor() && this.m_shapes[shapeIdx].enableSensorEvents();
        this.wakeShapeNeighbors(shapeIdx);
        const u32 bodyIdx = this.m_shapes[shapeIdx].bodyId;
        if(bodyIdx < this.m_bodies.size() && this.m_bodies[bodyIdx].alive){
            this.wakeBody(this.makeBodyId(bodyIdx));
            Vector<u32> refreshContacts;
            u32 edgeKey = this.m_bodies[bodyIdx].headContactKey;
            while(edgeKey != s_NullIndex){
                const u32 cId = DecodeContactKeyId(edgeKey);
                const u32 edgeIdx = DecodeContactKeyEdge(edgeKey);
                in Contact c = this.m_contacts[cId];
                if(c.shapeIdA == shapeIdx || c.shapeIdB == shapeIdx)
                    refreshContacts.push_back(cId);
                edgeKey = c.edges[edgeIdx].nextKey;
            }
            for(usize ci = 0u; ci < refreshContacts.size(); ++ci){
                const u32 cId = refreshContacts[ci];
                this.destroyContactInternal(cId);
            }
        }
        this.m_shapes[shapeIdx].setFlag(ShapeFlags::IsSensor, isSensor);
        const b8 nowSensorEv = this.m_shapes[shapeIdx].isSensor() && this.m_shapes[shapeIdx].enableSensorEvents();
        if(!wasSensorEv && nowSensorEv)
            ++this.m_sensorEventShapeCount;
        else if(wasSensorEv && !nowSensorEv && this.m_sensorEventShapeCount > 0u)
            --this.m_sensorEventShapeCount;
        if(this.m_shapes[shapeIdx].proxyKey != s_NullIndex)
            this.m_broadPhase.setNodeFlags(this.m_shapes[shapeIdx].proxyKey, this.computeShapeTreeNodeFlags(this.m_shapes[shapeIdx]));
        if(bodyIdx < this.m_bodies.size() && this.m_bodies[bodyIdx].alive){
            if(this.m_shapes[shapeIdx].proxyKey != s_NullIndex)
                this.m_broadPhase.bufferMove(this.m_shapes[shapeIdx].proxyKey);
            if(this.m_bodies[bodyIdx].type != BodyType::Dynamic)
                this.wakeOverlappingSleepingBodies(this.m_shapes[shapeIdx].aabb, bodyIdx);
            if(this.m_bodies[bodyIdx].type == BodyType::Dynamic)
                this.updateBodyMassInternal(bodyIdx);
            this.markSetTopologyDirty(this.m_bodies[bodyIdx].setIndex);
        }
        else{
            ++this.m_topologyVersion;
        }
        return true;
    }

    public b8 setShapeDensity(in ShapeId shapeId, in f32 density, in b8 updateBodyMass){
        if(!this.isValidShape(shapeId) || !IsFinite(VectorSingle(density)) || density < 0.0f)
            return false;
        const u32 shapeIdx = shapeId.index;
        const u32 bodyIdx = this.m_shapes[shapeIdx].bodyId;
        if(this.m_shapes[shapeIdx].density == density){
            if(!updateBodyMass || bodyIdx >= this.m_bodies.size() || !this.m_bodies[bodyIdx].alive || (this.m_bodies[bodyIdx].flags & cast<u32>(BodyFlags::DirtyMass)) == 0u)
                return true;
        }
        this.m_shapes[shapeIdx].density = density;
        if(bodyIdx < this.m_bodies.size() && this.m_bodies[bodyIdx].alive){
            if(this.m_bodies[bodyIdx].type == BodyType::Dynamic){
                this.wakeBody(this.makeBodyId(bodyIdx));
                this.wakeBodyNeighbors(bodyIdx);
            }
            if(updateBodyMass){
                this.updateBodyMassInternal(bodyIdx);
            }
            else{
                this.markBodyMassDirty(bodyIdx);
            }
            if(this.m_bodies[bodyIdx].setIndex != s_AwakeSetIndex)
                this.markSetTopologyDirty(this.m_bodies[bodyIdx].setIndex);
        }
        return true;
    }

    public b8 invokeShapeContactCreation(in ShapeId shapeId){
        if(!this.isValidShape(shapeId))
            return false;
        const u32 shapeIdx = shapeId.index;
        in Shape shape = this.m_shapes[shapeIdx];
        if(shape.bodyId >= this.m_bodies.size() || !this.m_bodies[shape.bodyId].alive || this.m_bodies[shape.bodyId].setIndex == s_DisabledSetIndex)
            return true;
        this.ensureCpuBroadphaseSynced();
        const Aabb3D queryBox = shape.aabb;
        for(usize t = 0u; t < s_TreeCount; ++t){
            this.m_broadPhase.trees[t].queryAabb(
                queryBox,
                0xffffffffu,
                lambda[mut this, in shapeIdx](in u32 proxyId, in u32 otherShapeIdx) -> b8{
                    if(otherShapeIdx != shapeIdx)
                        this.createContactInternal(shapeIdx, otherShapeIdx);
                    return true;
                }
            );
        }
        return true;
    }

    private void refreshShapeGeometryAndContacts(in u32 shapeIdx, in b8 updateBodyMass){
        const u32 bodyIdx = this.m_shapes[shapeIdx].bodyId;
        if(bodyIdx >= this.m_bodies.size() || !this.m_bodies[bodyIdx].alive)
            return;

        this.wakeBody(this.makeBodyId(bodyIdx));
        this.wakeShapeNeighbors(shapeIdx);
        this.zeroShapeContactWarmStart(shapeIdx);

        in Body body = this.m_bodies[bodyIdx];
        in Transform3D xf = this.m_solverSets[body.setIndex].sims[body.localIndex].transform;
        VectorSingle aabbMin(0.0f);
        VectorSingle aabbMax(0.0f);
        ComputeShapeWorldAabbValues(this.m_shapes[shapeIdx], VectorSingle(xf.position), VectorSingle(xf.rotation), this.m_hullShapes, this.m_meshShapes, this.m_heightfieldShapes, this.m_compoundShapes, this.m_scaledShapes, this.m_chainShapes, this.m_sdfShapes, aabbMin, aabbMax);
        this.m_shapes[shapeIdx].aabb = Aabb3D(aabbMin, aabbMax);
        if(this.m_shapes[shapeIdx].proxyKey != s_NullIndex)
            this.m_broadPhase.moveProxy(this.m_shapes[shapeIdx].proxyKey, this.m_shapes[shapeIdx].aabb, VectorSingle(0.0f));
        if(body.type != BodyType::Dynamic)
            this.wakeOverlappingSleepingBodies(this.m_shapes[shapeIdx].aabb, bodyIdx);

        if(updateBodyMass){
            this.updateBodyMassInternal(bodyIdx);
        }
        else{
            this.markBodyMassDirty(bodyIdx);
        }
        if(this.m_shapes[shapeIdx].type == ShapeType::Hull || this.m_shapes[shapeIdx].type == ShapeType::Mesh || this.m_shapes[shapeIdx].type == ShapeType::Heightfield)
            ++this.m_geomDataStamp;
        this.markSetTopologyDirty(this.m_bodies[bodyIdx].setIndex);
    }

    public b8 setSphereShape(in ShapeId shapeId, in SphereShape sphere, in b8 updateBodyMass){
        if(!this.isValidShape(shapeId) || !IsValidPositionVec3(sphere.center()) || !IsFinite(VectorSingle(sphere.radius())) || sphere.radius() <= 0.0f)
            return false;
        const u32 idx = shapeId.index;
        if(!updateBodyMass && this.m_shapes[idx].type == ShapeType::Sphere){
            const SphereShape cur = this.m_shapes[idx].sphereShape();
            if(
                cur.centerRadius.x == sphere.centerRadius.x
                && cur.centerRadius.y == sphere.centerRadius.y
                && cur.centerRadius.z == sphere.centerRadius.z
                && cur.centerRadius.w == sphere.centerRadius.w
            )
                return true;
        }
        this.releaseShapeGeometry(this.m_shapes[idx]);
        this.m_shapes[idx].type = ShapeType::Sphere;
        this.m_shapes[idx].setSphere(sphere);
        this.refreshShapeGeometryAndContacts(idx, updateBodyMass);
        return true;
    }

    public b8 setCapsuleShape(in ShapeId shapeId, in CapsuleShape capsule, in b8 updateBodyMass){
        if(!this.isValidShape(shapeId))
            return false;
        const VectorSingle c1 = capsule.center1();
        const VectorSingle c2 = capsule.center2Vec();
        if(!IsValidPositionVec3(c1) || !IsValidPositionVec3(c2) || !IsFinite(VectorSingle(capsule.radius())) || capsule.radius() <= 0.0f)
            return false;
        const f32 lenSq = Vector3LengthSq(VectorSingle(c2 - c1, 0.0f)).x;
        if(!IsFinite(VectorSingle(lenSq)) || lenSq < s_MinCapsuleLength * s_MinCapsuleLength)
            return false;
        const u32 idx = shapeId.index;
        if(!updateBodyMass && this.m_shapes[idx].type == ShapeType::Capsule){
            const CapsuleShape cur = this.m_shapes[idx].capsuleShape();
            if(
                cur.center1Radius.x == capsule.center1Radius.x
                && cur.center1Radius.y == capsule.center1Radius.y
                && cur.center1Radius.z == capsule.center1Radius.z
                && cur.center1Radius.w == capsule.center1Radius.w
                && cur.center2.x == capsule.center2.x
                && cur.center2.y == capsule.center2.y
                && cur.center2.z == capsule.center2.z
            )
                return true;
        }
        this.releaseShapeGeometry(this.m_shapes[idx]);
        this.m_shapes[idx].type = ShapeType::Capsule;
        this.m_shapes[idx].setCapsule(capsule);
        this.refreshShapeGeometryAndContacts(idx, updateBodyMass);
        return true;
    }

    public b8 setHullShape(in ShapeId shapeId, in HullShape hull, in b8 updateBodyMass){
        if(!this.isValidShape(shapeId))
            return false;
        if(
            hull.vertices.empty()
            || hull.facePlanes.empty()
            || hull.faceTopologies.empty()
            || hull.halfEdges.empty()
            || hull.faceTopologies.size() != hull.facePlanes.size()
            || hull.vertices.size() > s_MaxHullVertices
            || hull.facePlanes.size() > s_MaxHullFaces
            || hull.halfEdges.size() > 256u
            || !IsFinite(VectorSingle(hull.radius()))
            || hull.radius() < 0.0f
        )
            return false;
        for(usize i = 0u; i < hull.vertices.size(); ++i){
            if(!IsValidPositionVec3(VectorSingle(hull.vertices[i], 0.0f)))
                return false;
        }
        const u32 idx = shapeId.index;
        if(!updateBodyMass && this.m_shapes[idx].type == ShapeType::Hull && this.m_shapes[idx].geometryIndex < this.m_hullShapes.size()){
            in HullShape cur = this.m_hullShapes[this.m_shapes[idx].geometryIndex];
            if(
                cur.halfExtentsFlags.w == hull.halfExtentsFlags.w
                && cur.centroidRadius.x == hull.centroidRadius.x
                && cur.centroidRadius.y == hull.centroidRadius.y
                && cur.centroidRadius.z == hull.centroidRadius.z
                && cur.centroidRadius.w == hull.centroidRadius.w
            ){
                if(hull.halfExtentsFlags.w != 0u){
                    if(
                        cur.halfExtentsFlags.x == hull.halfExtentsFlags.x
                        && cur.halfExtentsFlags.y == hull.halfExtentsFlags.y
                        && cur.halfExtentsFlags.z == hull.halfExtentsFlags.z
                        && cur.boxRotation.x == hull.boxRotation.x
                        && cur.boxRotation.y == hull.boxRotation.y
                        && cur.boxRotation.z == hull.boxRotation.z
                        && cur.boxRotation.w == hull.boxRotation.w
                    )
                        return true;
                }
                else if(
                    cur.vertices.size() == hull.vertices.size()
                    && cur.facePlanes.size() == hull.facePlanes.size()
                    && cur.faceTopologies.size() == hull.faceTopologies.size()
                    && cur.halfEdges.size() == hull.halfEdges.size()
                ){
                    b8 allEqual = true;
                    for(usize vi = 0u; vi < hull.vertices.size(); ++vi){
                        in f32x3u a = cur.vertices[vi];
                        in f32x3u b = hull.vertices[vi];
                        if(a.x != b.x || a.y != b.y || a.z != b.z){
                            allEqual = false;
                            break;
                        }
                    }
                    if(allEqual){
                        for(usize fi = 0u; fi < hull.facePlanes.size(); ++fi){
                            in f32x4 a = cur.facePlanes[fi].normalOffset;
                            in f32x4 b = hull.facePlanes[fi].normalOffset;
                            if(a.x != b.x || a.y != b.y || a.z != b.z || a.w != b.w){
                                allEqual = false;
                                break;
                            }
                        }
                    }
                    if(allEqual){
                        for(usize ti = 0u; ti < hull.faceTopologies.size(); ++ti){
                            in HullFaceTopology a = cur.faceTopologies[ti];
                            in HullFaceTopology b = hull.faceTopologies[ti];
                            if(a.edge != b.edge || a.vertexCount != b.vertexCount){
                                allEqual = false;
                                break;
                            }
                        }
                    }
                    if(allEqual){
                        for(usize ei = 0u; ei < hull.halfEdges.size(); ++ei){
                            in HalfEdge a = cur.halfEdges[ei];
                            in HalfEdge b = hull.halfEdges[ei];
                            if(a.tail != b.tail || a.face != b.face || a.next != b.next || a.twin != b.twin){
                                allEqual = false;
                                break;
                            }
                        }
                    }
                    if(allEqual)
                        return true;
                }
            }
        }
        this.releaseShapeGeometry(this.m_shapes[idx]);
        this.m_shapes[idx].type = ShapeType::Hull;
        this.m_shapes[idx].geometryIndex = this.allocateHullShape(hull);
        this.refreshShapeGeometryAndContacts(idx, updateBodyMass);
        return true;
    }

    public b8 setMeshShape(in ShapeId shapeId, in MeshShape mesh){
        if(!this.isValidShape(shapeId))
            return false;
        const u32 idx = shapeId.index;
        const u32 bodyIdx = this.m_shapes[idx].bodyId;
        if(bodyIdx >= this.m_bodies.size() || this.m_bodies[bodyIdx].type == BodyType::Dynamic)
            return false;
        if(mesh.triangles.empty() || mesh.nodes.empty() || !IsFinite(VectorSingle(mesh.radius())) || mesh.radius() < 0.0f)
            return false;
        this.releaseShapeGeometry(this.m_shapes[idx]);
        this.m_shapes[idx].type = ShapeType::Mesh;
        this.m_shapes[idx].geometryIndex = this.allocateMeshShape(mesh);
        this.refreshShapeGeometryAndContacts(idx, false);
        return true;
    }

    public b8 setShapeHullGeometry(in ShapeId shapeId, in HullGeometryId id, in b8 updateBodyMass){
        if(!this.isValidShape(shapeId) || !this.isHullGeometryValid(id))
            return false;
        const u32 idx = shapeId.index;
        if(this.m_shapes[idx].type == ShapeType::Hull && this.m_shapes[idx].geometryIndex == id.index){
            if(updateBodyMass)
                this.refreshShapeGeometryAndContacts(idx, true);
            return true;
        }
        this.releaseShapeGeometry(this.m_shapes[idx]);
        ++this.m_hullRefCounts[id.index];
        ++this.m_hullPoolVersion;
        this.m_shapes[idx].type = ShapeType::Hull;
        this.m_shapes[idx].geometryIndex = id.index;
        this.refreshShapeGeometryAndContacts(idx, updateBodyMass);
        return true;
    }

    public b8 setShapeMeshGeometry(in ShapeId shapeId, in MeshGeometryId id){
        if(!this.isValidShape(shapeId) || !this.isMeshGeometryValid(id))
            return false;
        const u32 idx = shapeId.index;
        const u32 bodyIdx = this.m_shapes[idx].bodyId;
        if(bodyIdx >= this.m_bodies.size() || this.m_bodies[bodyIdx].type == BodyType::Dynamic)
            return false;
        if(this.m_shapes[idx].type == ShapeType::Mesh && this.m_shapes[idx].geometryIndex == id.index)
            return true;
        this.releaseShapeGeometry(this.m_shapes[idx]);
        ++this.m_meshRefCounts[id.index];
        ++this.m_meshPoolVersion;
        this.m_shapes[idx].type = ShapeType::Mesh;
        this.m_shapes[idx].geometryIndex = id.index;
        this.refreshShapeGeometryAndContacts(idx, false);
        return true;
    }

    public b8 updateMeshGeometryVertices(in MeshGeometryId id, in Span<f32x4> newVertices){
        if(!this.isMeshGeometryValid(id))
            return false;
        if(this.m_meshRefitCaches.size() < this.m_meshShapes.size())
            this.m_meshRefitCaches.resize(this.m_meshShapes.size());
        if(!this.m_meshShapes[id.index].refitBvhWithCache(
            newVertices,
            cast<u32>(this.m_meshGenerations[id.index]),
            this.m_meshRefitCaches[id.index],
            this.m_cpuScratch.meshRefitEdgeFlagsScratch,
            this.m_cpuScratch.meshRefitSharpVertsScratch
        ))
            return false;
        PrepareMeshBuoyancyVolumeCache(this.m_meshShapes[id.index]);
        ++this.m_meshPoolVersion;
        for(usize si = 0u; si < this.m_shapes.size(); ++si){
            in Shape s = this.m_shapes[si];
            if(s.alive() && s.type == ShapeType::Mesh && s.geometryIndex == id.index)
                this.refreshShapeGeometryAndContacts(cast<u32>(si), false);
        }
        return true;
    }

    public b8 setShapeHeightfieldGeometry(in ShapeId shapeId, in HeightfieldGeometryId id){
        if(!this.isValidShape(shapeId) || !this.isHeightfieldGeometryValid(id))
            return false;
        const u32 idx = shapeId.index;
        const u32 bodyIdx = this.m_shapes[idx].bodyId;
        if(bodyIdx >= this.m_bodies.size() || this.m_bodies[bodyIdx].type == BodyType::Dynamic)
            return false;
        if(this.m_shapes[idx].type == ShapeType::Heightfield && this.m_shapes[idx].geometryIndex == id.index)
            return true;
        this.releaseShapeGeometry(this.m_shapes[idx]);
        ++this.m_heightfieldRefCounts[id.index];
        ++this.m_heightfieldPoolVersion;
        this.m_shapes[idx].type = ShapeType::Heightfield;
        this.m_shapes[idx].geometryIndex = id.index;
        this.refreshShapeGeometryAndContacts(idx, false);
        return true;
    }

    public b8 setShapeHeightfield(in ShapeId shapeId, in HeightfieldShape hf){
        if(!this.isValidShape(shapeId) || !hf.isValid())
            return false;
        const u32 idx = shapeId.index;
        const u32 bodyIdx = this.m_shapes[idx].bodyId;
        if(bodyIdx >= this.m_bodies.size() || this.m_bodies[bodyIdx].type == BodyType::Dynamic)
            return false;
        this.releaseShapeGeometry(this.m_shapes[idx]);
        this.m_shapes[idx].type = ShapeType::Heightfield;
        this.m_shapes[idx].geometryIndex = this.allocateHeightfieldShape(hf);
        this.refreshShapeGeometryAndContacts(idx, false);
        return true;
    }

    public b8 setCylinderShape(in ShapeId shapeId, in CylinderShape cyl, in b8 updateBodyMass){
        if(!this.isValidShape(shapeId))
            return false;
        if(!IsValidPositionVec3(cyl.center()) || !IsFinite(VectorSingle(cyl.radius(), cyl.halfHeight(), cyl.convexRadius(), 0.0f)) || cyl.radius() <= 0.0f || cyl.halfHeight() <= 0.0f || cyl.convexRadius() < 0.0f)
            return false;
        const u32 idx = shapeId.index;
        if(!updateBodyMass && this.m_shapes[idx].type == ShapeType::Cylinder){
            const CylinderShape cur = this.m_shapes[idx].cylinderShape();
            if(
                cur.centerRadius.x == cyl.centerRadius.x
                && cur.centerRadius.y == cyl.centerRadius.y
                && cur.centerRadius.z == cyl.centerRadius.z
                && cur.centerRadius.w == cyl.centerRadius.w
                && cur.halfHeightRadiusConvex.x == cyl.halfHeightRadiusConvex.x
                && cur.halfHeightRadiusConvex.y == cyl.halfHeightRadiusConvex.y
            )
                return true;
        }
        this.releaseShapeGeometry(this.m_shapes[idx]);
        this.m_shapes[idx].type = ShapeType::Cylinder;
        this.m_shapes[idx].setCylinder(cyl);
        this.refreshShapeGeometryAndContacts(idx, updateBodyMass);
        return true;
    }

    public b8 setConeShape(in ShapeId shapeId, in ConeShape cone, in b8 updateBodyMass){
        if(!this.isValidShape(shapeId))
            return false;
        if(!IsValidPositionVec3(cone.center()) || !IsFinite(VectorSingle(cone.radius(), cone.halfHeight(), cone.convexRadius(), 0.0f)) || cone.radius() <= 0.0f || cone.halfHeight() <= 0.0f || cone.convexRadius() < 0.0f)
            return false;
        const u32 idx = shapeId.index;
        if(!updateBodyMass && this.m_shapes[idx].type == ShapeType::Cone){
            const ConeShape cur = this.m_shapes[idx].coneShape();
            if(
                cur.centerRadius.x == cone.centerRadius.x
                && cur.centerRadius.y == cone.centerRadius.y
                && cur.centerRadius.z == cone.centerRadius.z
                && cur.centerRadius.w == cone.centerRadius.w
                && cur.halfHeightRadiusConvex.x == cone.halfHeightRadiusConvex.x
                && cur.halfHeightRadiusConvex.y == cone.halfHeightRadiusConvex.y
            )
                return true;
        }
        this.releaseShapeGeometry(this.m_shapes[idx]);
        this.m_shapes[idx].type = ShapeType::Cone;
        this.m_shapes[idx].setCone(cone);
        this.refreshShapeGeometryAndContacts(idx, updateBodyMass);
        return true;
    }

    public b8 setTaperedCapsuleShape(in ShapeId shapeId, in TaperedCapsuleShape tc, in b8 updateBodyMass){
        if(!this.isValidShape(shapeId))
            return false;
        const VectorSingle c1 = tc.center1();
        const VectorSingle c2 = tc.center2();
        if(!IsValidPositionVec3(c1) || !IsValidPositionVec3(c2) || !IsFinite(VectorSingle(tc.radius1(), tc.radius2(), 0.0f, 0.0f)) || tc.radius1() <= 0.0f || tc.radius2() <= 0.0f)
            return false;
        const f32 lenSq = Vector3LengthSq(VectorSingle(c2 - c1, 0.0f)).x;
        if(!IsFinite(VectorSingle(lenSq)) || lenSq < s_MinCapsuleLength * s_MinCapsuleLength)
            return false;
        const u32 idx = shapeId.index;
        if(!updateBodyMass && this.m_shapes[idx].type == ShapeType::TaperedCapsule){
            const TaperedCapsuleShape cur = this.m_shapes[idx].taperedCapsuleShape();
            if(
                cur.center1Radius1.x == tc.center1Radius1.x
                && cur.center1Radius1.y == tc.center1Radius1.y
                && cur.center1Radius1.z == tc.center1Radius1.z
                && cur.center1Radius1.w == tc.center1Radius1.w
                && cur.center2Radius2.x == tc.center2Radius2.x
                && cur.center2Radius2.y == tc.center2Radius2.y
                && cur.center2Radius2.z == tc.center2Radius2.z
                && cur.center2Radius2.w == tc.center2Radius2.w
            )
                return true;
        }
        this.releaseShapeGeometry(this.m_shapes[idx]);
        this.m_shapes[idx].type = ShapeType::TaperedCapsule;
        this.m_shapes[idx].setTaperedCapsule(tc);
        this.refreshShapeGeometryAndContacts(idx, updateBodyMass);
        return true;
    }

    public b8 setPlaneShape(in ShapeId shapeId, in PlaneShape plane, in b8 updateBodyMass){
        if(!this.isValidShape(shapeId))
            return false;
        const u32 idx = shapeId.index;
        const u32 bodyIdx = this.m_shapes[idx].bodyId;
        if(bodyIdx >= this.m_bodies.size() || (this.m_bodies[bodyIdx].type == BodyType::Dynamic && !plane.isFiniteExtent()))
            return false;
        const VectorSingle n = plane.normal();
        if(!IsFinite(n.xyz) || Vector3LengthSq(n).x <= s_NormalizeEpsilonSq || !IsFinite(VectorSingle(plane.offset(), plane.halfExtent.x, plane.halfExtent.z, 0.0f)) || Abs(VectorSingle(plane.offset())).x > s_HugeCoordinate)
            return false;
        if(plane.halfExtent.x < 0.0f || plane.halfExtent.z < 0.0f)
            return false;
        PlaneShape normPlane = plane;
        normPlane.normalOffset = f32x4(SafeNormalizeVec3(n, VectorSingle(0.0f, 1.0f, 0.0f, 0.0f)), plane.offset());
        this.releaseShapeGeometry(this.m_shapes[idx]);
        this.m_shapes[idx].type = ShapeType::Plane;
        this.m_shapes[idx].setPlane(normPlane);
        this.refreshShapeGeometryAndContacts(idx, updateBodyMass);
        return true;
    }

    public b8 setSegmentShape(in ShapeId shapeId, in SegmentShape seg, in b8 updateBodyMass){
        if(!this.isValidShape(shapeId))
            return false;
        const VectorSingle p1 = seg.point1();
        const VectorSingle p2 = seg.point2();
        if(!IsValidPositionVec3(p1) || !IsValidPositionVec3(p2) || !IsFinite(VectorSingle(seg.radius())) || seg.radius() < 0.0f)
            return false;
        const f32 lenSq = Vector3LengthSq(VectorSingle(p2 - p1, 0.0f)).x;
        if(!IsFinite(VectorSingle(lenSq)) || lenSq < s_MinCapsuleLength * s_MinCapsuleLength)
            return false;
        const u32 idx = shapeId.index;
        this.releaseShapeGeometry(this.m_shapes[idx]);
        this.m_shapes[idx].type = ShapeType::Segment;
        this.m_shapes[idx].setSegment(seg);
        this.refreshShapeGeometryAndContacts(idx, updateBodyMass);
        return true;
    }

    public b8 setShapeLocalTransform(in ShapeId shapeId, in Transform3D localXf){
        if(!this.isValidShape(shapeId))
            return false;
        if(!IsValidPositionVec3(VectorSingle(localXf.position)) || !IsFinite(VectorSingle(localXf.rotation)))
            return false;
        if(Vector4LengthSq(VectorSingle(localXf.rotation)).x <= s_NormalizeEpsilonSq)
            return false;
        const u32 idx = shapeId.index;
        const Transform3D normXf(VectorSingle(localXf.position), SafeNormalizeQuat(VectorSingle(localXf.rotation)));
        this.m_shapes[idx].localTransform = normXf;
        this.m_shapes[idx].setFlag(ShapeFlags::HasLocalTransform, !IsIdentityTransform(normXf));
        this.refreshShapeGeometryAndContacts(idx, true);
        return true;
    }

    private void syncBodyFlagsToSimAndState(in u32 bodyIdx){
        in Body body = this.m_bodies[bodyIdx];
        if(body.setIndex < this.m_solverSets.size() && body.localIndex < this.m_solverSets[body.setIndex].sims.size())
            this.m_solverSets[body.setIndex].sims[body.localIndex].flags = body.flags;
        if((body.setIndex == s_AwakeSetIndex || body.setIndex == s_DisabledSetIndex) && body.localIndex < this.m_solverSets[body.setIndex].states.size())
            this.m_solverSets[body.setIndex].states[body.localIndex].setFlags(body.flags);
    }

    private void setBodyFlagBit(in BodyId bodyId, in u32 bit, in b8 enabled){
        if(!this.isValidBody(bodyId))
            return;
        const u32 idx = bodyId.index;
        if(enabled)
            this.m_bodies[idx].flags |= bit;
        else
            this.m_bodies[idx].flags &= ~bit;
        this.syncBodyFlagsToSimAndState(idx);
    }

    private void rebuildBodyShapesBroadphase(in u32 bodyIdx, in b8 includeInBroadPhase){
        in Body body = this.m_bodies[bodyIdx];
        in Transform3D xf = this.m_solverSets[body.setIndex].sims[body.localIndex].transform;
        const VectorSingle xfPos(xf.position);
        const VectorSingle xfRot(xf.rotation);
        u32 shapeIdx = body.headShapeId;
        while(shapeIdx != s_NullIndex){
            mut Shape shape = this.m_shapes[shapeIdx];
            if(shape.proxyKey != s_NullIndex){
                this.m_broadPhase.destroyProxy(shape.proxyKey);
                shape.proxyKey = s_NullIndex;
            }
            VectorSingle aabbMin(0.0f);
            VectorSingle aabbMax(0.0f);
            ComputeShapeWorldAabbValues(shape, xfPos, xfRot, this.m_hullShapes, this.m_meshShapes, this.m_heightfieldShapes, this.m_compoundShapes, this.m_scaledShapes, this.m_chainShapes, this.m_sdfShapes, aabbMin, aabbMax);
            shape.aabb = Aabb3D(aabbMin, aabbMax);
            if(includeInBroadPhase){
                u32 proxyKey = s_NullIndex;
                this.m_broadPhase.createProxyWithFlags(body.type, shape.aabb, shape.filter.categoryBits, this.computeShapeTreeNodeFlags(shape), shapeIdx, true, proxyKey);
                shape.proxyKey = proxyKey;
            }
            shapeIdx = shape.nextShapeId;
        }
    }

    private void relinkBodyJointsToIslands(in u32 bodyIdx){
        u32 key = this.m_bodies[bodyIdx].headJointKey;
        while(key != s_NullIndex){
            const u32 jId = DecodeJointKeyId(key);
            const u32 edgeIdx = DecodeJointKeyEdge(key);
            const u32 nextKey = this.m_joints[jId].edges[edgeIdx].nextKey;
            in Joint j = this.m_joints[jId];
            if(j.alive() && j.enabled() && j.islandId == s_NullIndex){
                in Body bA = this.m_bodies[j.edges[0u].bodyId];
                in Body bB = this.m_bodies[j.edges[1u].bodyId];
                if(
                    bA.alive && bB.alive
                    && bA.setIndex != s_DisabledSetIndex && bB.setIndex != s_DisabledSetIndex
                    && (bA.type == BodyType::Dynamic || bB.type == BodyType::Dynamic)
                ){
                    LinkJointToIslandWithGraph(
                        this.m_graph,
                        this.m_bodies,
                        this.m_islands,
                        this.m_freeIslandIds,
                        this.m_solverSets,
                        this.m_freeSolverSetIds,
                        this.m_contacts,
                        this.m_joints,
                        jId
                    );
                }
            }
            key = nextKey;
        }
    }

    public b8 applyForceAtPoint(in BodyId bodyId, in VectorSingle force, in VectorSingle worldPoint, in b8 wake){
        if(!this.isValidBody(bodyId) || !IsFinite(force.xyz) || !IsValidPositionVec3(worldPoint))
            return false;
        if(this.m_bodies[bodyId.index].type != BodyType::Dynamic)
            return false;
        if((this.m_bodies[bodyId.index].flags & cast<u32>(BodyFlags::DirtyMass)) != 0u)
            this.updateBodyMassInternal(bodyId.index);
        if(wake)
            this.wakeBody(bodyId);
        in Body body = this.m_bodies[bodyId.index];
        if(body.setIndex != s_AwakeSetIndex)
            return true;
        mut BodySim sim = this.m_solverSets[s_AwakeSetIndex].sims[body.localIndex];
        const VectorSingle f(force, 0.0f);
        const VectorSingle r(worldPoint - sim.center(), 0.0f);
        sim.setForce(sim.force() + f);
        sim.setTorque(sim.torque() + Cross(r, f));
        ++this.m_poseMutationVersion;
        return true;
    }

    public b8 applyLinearImpulseAtPoint(in BodyId bodyId, in VectorSingle impulse, in VectorSingle worldPoint, in b8 wake){
        if(!this.isValidBody(bodyId) || !IsFinite(impulse.xyz) || !IsValidPositionVec3(worldPoint))
            return false;
        if(this.m_bodies[bodyId.index].type != BodyType::Dynamic)
            return false;
        if((this.m_bodies[bodyId.index].flags & cast<u32>(BodyFlags::DirtyMass)) != 0u)
            this.updateBodyMassInternal(bodyId.index);
        if(wake)
            this.wakeBody(bodyId);
        in Body body = this.m_bodies[bodyId.index];
        if(body.setIndex != s_AwakeSetIndex)
            return true;
        in BodySim sim = this.m_solverSets[s_AwakeSetIndex].sims[body.localIndex];
        mut BodyState state = this.m_solverSets[s_AwakeSetIndex].states[body.localIndex];
        const VectorSingle p(impulse, 0.0f);
        const VectorSingle r(worldPoint - sim.center(), 0.0f);
        const VectorSingle v = VectorSingle(state.linearVelocity) + p * sim.invMass();
        const VectorSingle w = VectorSingle(state.angularVelocity) + Matrix3MulVec(Matrix3FromSymMat3(sim.invInertiaWorld), Cross(r, p));
        state.linearVelocity = f32x4(ApplyLinearLocks(v, body.flags), 0.0f);
        state.angularVelocity = f32x4(ApplyAngularLocks(w, body.flags), 0.0f);
        ++this.m_poseMutationVersion;
        return true;
    }

    public b8 applyAcceleration(in BodyId bodyId, in VectorSingle acceleration, in b8 wake){
        if(!this.isValidBody(bodyId) || !IsFinite(acceleration.xyz))
            return false;
        if(this.m_bodies[bodyId.index].type != BodyType::Dynamic)
            return false;
        if((this.m_bodies[bodyId.index].flags & cast<u32>(BodyFlags::DirtyMass)) != 0u)
            this.updateBodyMassInternal(bodyId.index);
        if(wake)
            this.wakeBody(bodyId);
        in Body body = this.m_bodies[bodyId.index];
        if(body.setIndex != s_AwakeSetIndex)
            return true;
        mut BodySim sim = this.m_solverSets[s_AwakeSetIndex].sims[body.localIndex];
        const f32 invM = sim.invMass();
        if(invM > 0.0f){
            const VectorSingle acc = ApplyLinearLocks(VectorSingle(acceleration, 0.0f), body.flags);
            sim.setForce(sim.force() + acc * (1.0f / invM));
        }
        ++this.m_poseMutationVersion;
        return true;
    }

    public b8 applyAngularAcceleration(in BodyId bodyId, in VectorSingle angularAcceleration, in b8 wake){
        if(!this.isValidBody(bodyId) || !IsFinite(angularAcceleration.xyz))
            return false;
        if(this.m_bodies[bodyId.index].type != BodyType::Dynamic)
            return false;
        if((this.m_bodies[bodyId.index].flags & cast<u32>(BodyFlags::DirtyMass)) != 0u)
            this.updateBodyMassInternal(bodyId.index);
        if(wake)
            this.wakeBody(bodyId);
        in Body body = this.m_bodies[bodyId.index];
        if(body.setIndex != s_AwakeSetIndex)
            return true;
        mut BodySim sim = this.m_solverSets[s_AwakeSetIndex].sims[body.localIndex];
        in SymMat3 invI = sim.invInertiaWorld;
        f32 a00 = invI.m00;
        f32 a01 = invI.m01;
        f32 a02 = invI.m02;
        f32 a11 = invI.m11;
        f32 a12 = invI.m12;
        f32 a22 = invI.m22;
        const VectorSingle rhs = ApplyAngularLocks(VectorSingle(angularAcceleration, 0.0f), body.flags);
        f32 rx = rhs.x;
        f32 ry = rhs.y;
        f32 rz = rhs.z;
        if((body.flags & cast<u32>(BodyFlags::LockAngularX)) != 0u || a00 <= 1.0e-12f){
            rx = 0.0f;
            a00 = 1.0f;
            a01 = 0.0f;
            a02 = 0.0f;
        }
        if((body.flags & cast<u32>(BodyFlags::LockAngularY)) != 0u || a11 <= 1.0e-12f){
            ry = 0.0f;
            a01 = 0.0f;
            a11 = 1.0f;
            a12 = 0.0f;
        }
        if((body.flags & cast<u32>(BodyFlags::LockAngularZ)) != 0u || a22 <= 1.0e-12f){
            rz = 0.0f;
            a02 = 0.0f;
            a12 = 0.0f;
            a22 = 1.0f;
        }
        const f32 c00 = a11 * a22 - a12 * a12;
        const f32 c01 = a02 * a12 - a01 * a22;
        const f32 c02 = a01 * a12 - a02 * a11;
        const f32 c11 = a00 * a22 - a02 * a02;
        const f32 c12 = a01 * a02 - a00 * a12;
        const f32 c22 = a00 * a11 - a01 * a01;
        const f32 det = a00 * c00 + a01 * c01 + a02 * c02;
        if(det > 1.0e-18f){
            const VectorSingle rawTorque(
                c00 * rx + c01 * ry + c02 * rz,
                c01 * rx + c11 * ry + c12 * rz,
                c02 * rx + c12 * ry + c22 * rz,
                0.0f
            );
            const VectorSingle torque = ApplyAngularLocks(rawTorque * (1.0f / det), body.flags);
            sim.setTorque(sim.torque() + torque);
        }
        ++this.m_poseMutationVersion;
        return true;
    }

    public b8 applyVelocityChange(in BodyId bodyId, in VectorSingle deltaVelocity, in b8 wake){
        if(!this.isValidBody(bodyId) || !IsFinite(deltaVelocity.xyz))
            return false;
        if(this.m_bodies[bodyId.index].type != BodyType::Dynamic)
            return false;
        if(wake)
            this.wakeBody(bodyId);
        in Body body = this.m_bodies[bodyId.index];
        if(body.setIndex != s_AwakeSetIndex)
            return true;
        mut BodyState state = this.m_solverSets[s_AwakeSetIndex].states[body.localIndex];
        const VectorSingle v = VectorSingle(state.linearVelocity) + VectorSingle(deltaVelocity, 0.0f);
        state.linearVelocity = f32x4(ApplyLinearLocks(v, body.flags), 0.0f);
        ++this.m_poseMutationVersion;
        return true;
    }

    public b8 applyAngularVelocityChange(in BodyId bodyId, in VectorSingle deltaAngularVelocity, in b8 wake){
        if(!this.isValidBody(bodyId) || !IsFinite(deltaAngularVelocity.xyz))
            return false;
        if(this.m_bodies[bodyId.index].type != BodyType::Dynamic)
            return false;
        if(wake)
            this.wakeBody(bodyId);
        in Body body = this.m_bodies[bodyId.index];
        if(body.setIndex != s_AwakeSetIndex)
            return true;
        mut BodyState state = this.m_solverSets[s_AwakeSetIndex].states[body.localIndex];
        const VectorSingle w = VectorSingle(state.angularVelocity) + VectorSingle(deltaAngularVelocity, 0.0f);
        state.angularVelocity = f32x4(ApplyAngularLocks(w, body.flags), 0.0f);
        ++this.m_poseMutationVersion;
        return true;
    }

    public b8 applyForceAtLocalPoint(in BodyId bodyId, in VectorSingle force, in VectorSingle localPoint, in b8 wake){
        if(!this.isValidBody(bodyId) || !IsFinite(force.xyz) || !IsFinite(localPoint.xyz))
            return false;
        in Body body = this.m_bodies[bodyId.index];
        in Transform3D xf = this.m_solverSets[body.setIndex].sims[body.localIndex].transform;
        const VectorSingle worldPoint = TransformPointValues(VectorSingle(xf.position), VectorSingle(xf.rotation), VectorSingle(localPoint, 0.0f));
        return this.applyForceAtPoint(bodyId, force, worldPoint, wake);
    }

    public VectorSingle getPointVelocity(in BodyId bodyId, in VectorSingle worldPoint)const{
        if(!this.isValidBody(bodyId) || !IsValidPositionVec3(worldPoint))
            return VectorSingle(0.0f);
        in Body body = this.m_bodies[bodyId.index];
        if(
            (body.setIndex == s_AwakeSetIndex || (body.setIndex == s_DisabledSetIndex && body.type != BodyType::Static))
            && body.localIndex < this.m_solverSets[body.setIndex].states.size()
            && body.localIndex < this.m_solverSets[body.setIndex].sims.size()
        ){
            in BodySim sim = this.m_solverSets[body.setIndex].sims[body.localIndex];
            in BodyState state = this.m_solverSets[body.setIndex].states[body.localIndex];
            const VectorSingle r(worldPoint - sim.center(), 0.0f);
            return VectorSingle(VectorSingle(state.linearVelocity) + Cross(VectorSingle(state.angularVelocity), r), 0.0f);
        }
        return VectorSingle(0.0f);
    }

    public b8 setLinearDamping(in BodyId bodyId, in f32 linearDamping){
        if(!this.isValidBody(bodyId) || !IsFinite(VectorSingle(linearDamping)) || linearDamping < 0.0f)
            return false;
        in Body body = this.m_bodies[bodyId.index];
        this.m_solverSets[body.setIndex].sims[body.localIndex].setLinearDamping(linearDamping);
        ++this.m_poseMutationVersion;
        return true;
    }

    public b8 setAngularDamping(in BodyId bodyId, in f32 angularDamping){
        if(!this.isValidBody(bodyId) || !IsFinite(VectorSingle(angularDamping)) || angularDamping < 0.0f)
            return false;
        in Body body = this.m_bodies[bodyId.index];
        this.m_solverSets[body.setIndex].sims[body.localIndex].setAngularDamping(angularDamping);
        ++this.m_poseMutationVersion;
        return true;
    }

    public b8 setGravityScale(in BodyId bodyId, in f32 gravityScale){
        if(!this.isValidBody(bodyId) || !IsFinite(VectorSingle(gravityScale)))
            return false;
        const u32 idx = bodyId.index;
        if(this.m_bodies[idx].type == BodyType::Dynamic && this.m_bodies[idx].setIndex >= 3u)
            this.wakeBody(bodyId);
        in Body body = this.m_bodies[idx];
        this.m_solverSets[body.setIndex].sims[body.localIndex].gravityScale = gravityScale;
        ++this.m_poseMutationVersion;
        return true;
    }

    public b8 setSleepThreshold(in BodyId bodyId, in f32 threshold){
        if(!this.isValidBody(bodyId) || !IsFinite(VectorSingle(threshold)) || threshold < 0.0f)
            return false;
        this.m_bodies[bodyId.index].sleepThreshold = threshold;
        ++this.m_poseMutationVersion;
        return true;
    }

    public b8 setMotionLocks(in BodyId bodyId, in u32 motionLocks){
        if(!this.isValidBody(bodyId))
            return false;
        const u32 idx = bodyId.index;
        const u32 lockMask =
            cast<u32>(BodyFlags::LockLinearX)
            | cast<u32>(BodyFlags::LockLinearY)
            | cast<u32>(BodyFlags::LockLinearZ)
            | cast<u32>(BodyFlags::LockAngularX)
            | cast<u32>(BodyFlags::LockAngularY)
            | cast<u32>(BodyFlags::LockAngularZ)
        ;
        const u32 newLocks = motionLocks & lockMask;
        const u32 oldLocks = this.m_bodies[idx].flags & lockMask;
        if(oldLocks == newLocks)
            return true;
        this.m_bodies[idx].flags = (this.m_bodies[idx].flags & ~lockMask) | newLocks;
        this.syncBodyFlagsToSimAndState(idx);
        in Body body = this.m_bodies[idx];
        if((body.setIndex == s_AwakeSetIndex || body.setIndex == s_DisabledSetIndex) && body.localIndex < this.m_solverSets[body.setIndex].states.size()){
            mut BodyState st = this.m_solverSets[body.setIndex].states[body.localIndex];
            st.linearVelocity = f32x4(ApplyLinearLocks(VectorSingle(st.linearVelocity), body.flags), 0.0f);
            st.angularVelocity = f32x4(ApplyAngularLocks(VectorSingle(st.angularVelocity), body.flags), 0.0f);
        }
        if(body.setIndex != s_DisabledSetIndex){
            this.wakeBody(bodyId);
            this.wakeBodyNeighbors(idx);
        }
        if(this.m_bodies[idx].setIndex != s_AwakeSetIndex)
            this.markSetTopologyDirty(this.m_bodies[idx].setIndex);
        ++this.m_poseMutationVersion;
        return true;
    }

    public b8 setBodyEnableSleep(in BodyId bodyId, in b8 enableSleep){
        if(!this.isValidBody(bodyId))
            return false;
        if(!enableSleep)
            this.wakeBody(bodyId);
        this.setBodyFlagBit(bodyId, cast<u32>(BodyFlags::EnableSleep), enableSleep);
        this.m_bodies[bodyId.index].sleepTime = 0.0f;
        return true;
    }

    public b8 setBodyBullet(in BodyId bodyId, in b8 isBullet){
        if(!this.isValidBody(bodyId))
            return false;
        const u32 idx = bodyId.index;
        const u32 bulletBit = cast<u32>(BodyFlags::IsBullet);
        const b8 wasBullet = (this.m_bodies[idx].flags & bulletBit) != 0u;
        if(wasBullet == isBullet)
            return true;
        this.setBodyFlagBit(bodyId, bulletBit, isBullet);
        if(this.m_bodies[idx].type != BodyType::Static){
            if(isBullet)
                ++this.m_bulletBodyCount;
            else if(this.m_bulletBodyCount > 0u)
                --this.m_bulletBodyCount;
        }
        if(this.m_bodies[idx].setIndex != s_AwakeSetIndex)
            this.markSetTopologyDirty(this.m_bodies[idx].setIndex);
        ++this.m_poseMutationVersion;
        return true;
    }

    public b8 setBodyMaxAngularVelocity(in BodyId bodyId, in f32 maxAngularVelocity){
        if(!this.isValidBody(bodyId) || !IsFinite(VectorSingle(maxAngularVelocity)) || maxAngularVelocity < 0.0f)
            return false;
        const u32 idx = bodyId.index;
        this.m_bodies[idx].maxAngularVelocity = maxAngularVelocity;
        this.m_solverSets[this.m_bodies[idx].setIndex].sims[this.m_bodies[idx].localIndex].maxAngularVelocity = maxAngularVelocity;
        this.setBodyFlagBit(bodyId, cast<u32>(BodyFlags::HasCustomMaxAngularVelocity), maxAngularVelocity > 0.0f);
        ++this.m_poseMutationVersion;
        return true;
    }

    public b8 setBodyEnableContactEvents(in BodyId bodyId, in b8 enabled){
        if(!this.isValidBody(bodyId))
            return false;
        u32 sIdx = this.m_bodies[bodyId.index].headShapeId;
        while(sIdx != s_NullIndex){
            const u32 nextIdx = this.m_shapes[sIdx].nextShapeId;
            this.setShapeEnableContactEvents(this.makeShapeId(sIdx), enabled);
            sIdx = nextIdx;
        }
        return true;
    }

