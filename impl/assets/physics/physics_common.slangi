    float4 sweepDispFlags;
};

struct NwbPhysicsGpuBodySim{
    float4 positionInvMass;
    float4 rotation;
    float4 forceLinearDamping;
    float4 torqueAngularDamping;
    float4 localCenterMinExtent;
    float4 invInertiaWorld0;
    float4 invInertiaWorld1;
    float4 invInertiaLocal0;
    float4 invInertiaLocal1;
};

struct NwbPhysicsGpuShapeProxy{
    float4 localCenterRadius;
    float4 localExtentOrP1;
    float4 localRotationOrMeta;
    uint4 bodyIndexTypeShape;
    uint4 filterData;
};

struct NwbPhysicsGpuBroadphasePair{
