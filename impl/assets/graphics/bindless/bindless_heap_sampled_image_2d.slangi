////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Minimal Texture2D-only view of the global resource heap.
//
// Small compute consumers such as surfel resolve/upsample need only floating-point Texture2D Load operations. Keeping
// their shader interface to this one table avoids emitting the otherwise-unused buffer, array, 3D, and storage-image
// declarations from bindless_heap.slangi. The host still installs the unchanged set-8/9 heap layouts, so Backend A
// descriptor indexing and Backend C descriptor buffers use the exact same physical descriptor block.


#ifndef NWB_GRAPHICS_BINDLESS_HEAP_SAMPLED_IMAGE_2D_SLANGI
#define NWB_GRAPHICS_BINDLESS_HEAP_SAMPLED_IMAGE_2D_SLANGI


#include "binding_slots.h"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[vk::binding(NWB_BINDLESS_HEAP_BINDING_SAMPLED_IMAGE, NWB_BINDLESS_HEAP_RESOURCE_SET)]]
Texture2D<float4> g_NwbHeapSampledImage2DOnly[];


Texture2D<float4> NwbHeapSampledImage2DOnly(const uint slot){
    return g_NwbHeapSampledImage2DOnly[slot];
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
