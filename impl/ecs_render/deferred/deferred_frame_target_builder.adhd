#include <impl/ecs_render/avboit/avboit_system.adhd>
#include <impl/ecs_render/csg/csg_system.adhd>
#include <impl/ecs_render/deferred/deferred_frame_targets.adhd>
#include <impl/ecs_render/deferred/deferred_system.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererRayTracingState;
class RendererRayTracingSystem;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_name("::NWB::Impl::RendererRayTracingState")]
extern class RendererRayTracingState;
[cpp_name("::NWB::Impl::RendererRayTracingSystem")]
extern class RendererRayTracingSystem;

[modular]
class DeferredFrameTargetBuilder : NoCopy{
    private mut GraphicsRuntime m_graphics;
    private mut RendererRayTracingState m_rayTracingState;
    private mut RendererDeferredSystem m_deferred;
    private mut RendererAvboitSystem m_avboit;
    private mut RendererCsgSystem m_csg;
    private mut RendererRayTracingSystem m_rayTracing;

    public DeferredFrameTargetBuilder(
        mut GraphicsRuntime graphics,
        mut RendererRayTracingState rayTracingState,
        mut RendererDeferredSystem deferred,
        mut RendererAvboitSystem avboit,
        mut RendererCsgSystem csg,
        mut RendererRayTracingSystem rayTracing
    ){
        this.m_graphics = graphics;
        this.m_rayTracingState = rayTracingState;
        this.m_deferred = deferred;
        this.m_avboit = avboit;
        this.m_csg = csg;
        this.m_rayTracing = rayTracing;
    }

    public Expected<DeferredFrameTargets> build(in u32 width, in u32 height, in u32 shadowReceiverFactor, in u32 surfelResolveFactor);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

