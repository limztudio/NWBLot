void VerifyAssetsGraphics_TextureMipAdmissionRejectsEveryTruncatedPayloadPrefixAndOversizedCount(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();

    const AssetBytes validBinary = BuildPartialBlockTextureBytes(testArena);
    TextureAsset texture(testArena.arena, Name(s_AssetCaseProjectTexturesMipTableAdmission));
    ASSERT_TRUE(LoadTextureAssetBinary(texture, validBinary));
    TextureAssetCodec codec = TextureAssetCodec();

    for(usize availableBytes = 0u; availableBytes < validBinary.size(); ++availableBytes){
        const ScopedTestTrace trace(availableBytes);
        const AssetBytes truncated = CopyAssetBytesPrefix(validBinary, availableBytes, testArena);
        EXPECT_FALSE(LoadTextureAssetBinary(texture, truncated));
        AssetBytes retained = MakeAssetBytes(testArena);
        ASSERT_TRUE(SerializeTextureAsset(codec, texture, retained));
        EXPECT_EQ(retained, validBinary);
    }

    AssetBytes oversized = CopyAssetBytesPrefix(validBinary, s_TextureHeaderBinaryBytes, testArena);
    ASSERT_TRUE(OverwriteU32InAssetBytes(s_TextureHeaderMipCountOffset, u32.max, oversized));
    EXPECT_FALSE(LoadTextureAssetBinary(texture, oversized));
    AssetBytes retained = MakeAssetBytes(testArena);
    ASSERT_TRUE(SerializeTextureAsset(codec, texture, retained));
    EXPECT_EQ(retained, validBinary);
    EXPECT_TRUE(LoadTextureAssetBinary(texture, validBinary));
}

void VerifyAssetsGraphics_TextureCodecRejectsPayloadFormatNarrowingWithoutReplacingPublishedPayload(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();

    const AssetBytes original = BuildPartialBlockTextureBytes(testArena);
    TextureAsset texture(testArena.arena, Name(s_AssetCaseProjectTexturesPayloadFormatAdmission));
    ASSERT_TRUE(LoadTextureAssetBinary(texture, original));
    TextureAssetCodec codec = TextureAssetCodec();

    Vector<u32> invalidFormats = Vector<u32>();
    invalidFormats.reserve(7u);
    invalidFormats.push_back(2u);
    invalidFormats.push_back(255u);
    invalidFormats.push_back(256u);
    invalidFormats.push_back(257u);
    invalidFormats.push_back(0xffffff00u);
    invalidFormats.push_back(0xffffff01u);
    invalidFormats.push_back(u32.max);

    for(in u32 payloadFormat : invalidFormats){
        const ScopedTestTrace trace(payloadFormat);
        AssetBytes malformed = MakeAssetBytes(testArena);
        CopyAssetBytes(original, malformed);
        ASSERT_TRUE(OverwriteU32InAssetBytes(s_TextureHeaderPayloadFormatOffset, payloadFormat, malformed));
        EXPECT_FALSE(CanDeserializeTextureAsset(codec, texture.virtualPath(), malformed, testArena));
        EXPECT_FALSE(LoadTextureAssetBinary(texture, malformed));
        AssetBytes retained = MakeAssetBytes(testArena);
        ASSERT_TRUE(SerializeTextureAsset(codec, texture, retained));
        EXPECT_EQ(retained, original);
    }
    EXPECT_TRUE(LoadTextureAssetBinary(texture, original));
}

void VerifyAssetsGraphics_TextureCodecRejectsOpaqueValueInConstantAlphaModeWithoutReplacingPublishedPayload(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();

    AssetBytes original = BuildPartialBlockTextureBytes(testArena);
    const u32 hdrFormat = cast<u32>(s_UastcHdrFormat);
    const u32 alphaInfo = cast<u32>(s_TextureAlphaConstantUnorm8) | (s_MaxConstantAlphaUnorm8 << s_TextureAlphaInfoConstantShift);
    ASSERT_TRUE(OverwriteU32InAssetBytes(s_TextureHeaderPayloadFormatOffset, hdrFormat, original));
    ASSERT_TRUE(OverwriteU32InAssetBytes(s_TextureHeaderAlphaInfoOffset, alphaInfo, original));

    TextureAsset texture(testArena.arena, Name(s_AssetCaseProjectTexturesConstantAlphaAdmission));
    ASSERT_TRUE(LoadTextureAssetBinary(texture, original));
    TextureAssetCodec codec = TextureAssetCodec();

    AssetBytes malformed = MakeAssetBytes(testArena);
    CopyAssetBytes(original, malformed);
    const u32 opaqueConstantInfo = cast<u32>(s_TextureAlphaConstantUnorm8) | (cast<u32>(s_OpaqueAlphaUnorm8) << s_TextureAlphaInfoConstantShift);
    ASSERT_TRUE(OverwriteU32InAssetBytes(s_TextureHeaderAlphaInfoOffset, opaqueConstantInfo, malformed));
    EXPECT_FALSE(CanDeserializeTextureAsset(codec, texture.virtualPath(), malformed, testArena));
    EXPECT_FALSE(LoadTextureAssetBinary(texture, malformed));
    EXPECT_TRUE(SawCapturedError(logger, "constant alpha must be below opaque alpha"));

    AssetBytes retained = MakeAssetBytes(testArena);
    ASSERT_TRUE(SerializeTextureAsset(codec, texture, retained));
    EXPECT_EQ(retained, original);
    EXPECT_TRUE(LoadTextureAssetBinary(texture, original));
}

void VerifyAssetsGraphics_TextureMipAdmissionRejectsCorruptRecordsAndRetainsExactEncodingAfterRejectedLoads(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();

    const AssetBytes validBinary = BuildPartialBlockTextureBytes(testArena);
    TextureAsset texture(testArena.arena, Name(s_AssetCaseProjectTexturesMipRecordAdmission));
    ASSERT_TRUE(LoadTextureAssetBinary(texture, validBinary));
    TextureAssetCodec codec = TextureAssetCodec();

    Vector<MipRecordCorruptionCase> corruptions = Vector<MipRecordCorruptionCase>();
    corruptions.reserve(6u);
    corruptions.push_back(MipRecordCorruptionCase(s_TextureMipReservedOffset, 1u));
    corruptions.push_back(MipRecordCorruptionCase(s_TextureMipWidthOffset, 8u));
    corruptions.push_back(MipRecordCorruptionCase(s_TextureMipBlockCountXOffset, 3u));
    corruptions.push_back(MipRecordCorruptionCase(s_TextureMipSliceCountOffset, 2u));
    corruptions.push_back(MipRecordCorruptionCase(s_TextureMipOffsetBytesOffset, 1u));
    corruptions.push_back(MipRecordCorruptionCase(s_TextureMipSizeBytesOffset, 48u));

    for(in MipRecordCorruptionCase corruption : corruptions){
        const ScopedTestTrace trace(corruption.m_fieldOffset);
        AssetBytes malformed = MakeAssetBytes(testArena);
        CopyAssetBytes(validBinary, malformed);
        ASSERT_TRUE(OverwriteU32InAssetBytes(s_TextureHeaderBinaryBytes + corruption.m_fieldOffset, corruption.m_value, malformed));
        EXPECT_FALSE(LoadTextureAssetBinary(texture, malformed));
        AssetBytes retained = MakeAssetBytes(testArena);
        ASSERT_TRUE(SerializeTextureAsset(codec, texture, retained));
        EXPECT_EQ(retained, validBinary);
    }

    AssetBytes trailing = MakeAssetBytes(testArena);
    CopyAssetBytes(validBinary, trailing);
    trailing.push_back(0u);
    EXPECT_FALSE(LoadTextureAssetBinary(texture, trailing));

    AssetBytes encoded = MakeAssetBytes(testArena);
    ASSERT_TRUE(SerializeTextureAsset(codec, texture, encoded));
    ASSERT_EQ(encoded.size(), validBinary.size());
    EXPECT_TRUE(AssetByteRangeEquals(encoded, 0u, validBinary));
}

void VerifyAssetsGraphics_TextureFormatRoundsPartialBlocksAndNonPowerOfTwoMips(){
    const Expected<u32> mipCount = ComputeCompleteMipCount(s_TextureDimension2D, 7u, 5u, 1u);
    ASSERT_TRUE(mipCount.has_value());
    EXPECT_EQ(mipCount.value(), 3u);

    const Expected<TextureMipPlaneBlockLayout> ldrPlane = ComputeMipPlaneBlockLayout(s_UastcLdrFormat, 7u, 5u);
    ASSERT_TRUE(ldrPlane.has_value());
    EXPECT_EQ(ldrPlane.value().blocksX, 2u);
    EXPECT_EQ(ldrPlane.value().blocksY, 2u);
    EXPECT_EQ(ldrPlane.value().planeByteCount, 64u);

    const Expected<TextureMipPlaneBlockLayout> hdrPlane = ComputeMipPlaneBlockLayout(s_UastcHdrFormat, 4u, 2u);
    ASSERT_TRUE(hdrPlane.has_value());
    EXPECT_EQ(hdrPlane.value().blocksX, 1u);
    EXPECT_EQ(hdrPlane.value().blocksY, 1u);
    EXPECT_EQ(hdrPlane.value().planeByteCount, 16u);
}

void VerifyAssetsGraphics_TextureCodecRejectsUnsupportedBinaryVersions(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();

    TextureAsset texture(testArena.arena, Name(s_AssetCaseProjectTexturesVersionAdmission));
    SetStandardTestTexturePayload(testArena, s_TextureAlphaEmbeddedLdr, s_OpaqueAlphaUnorm8, texture);
    TextureAssetCodec codec = TextureAssetCodec();
    AssetBytes binary = MakeAssetBytes(testArena);
    ASSERT_TRUE(SerializeTextureAsset(codec, texture, binary));

    Vector<u32> versions = Vector<u32>();
    versions.reserve(5u);
    versions.push_back(0u);
    versions.push_back(1u);
    versions.push_back(2u);
    versions.push_back(3u);
    versions.push_back(s_CurrentTextureVersion + 1u);

    for(in u32 version : versions){
        const ScopedTestTrace trace(version);
        ASSERT_TRUE(OverwriteU32InAssetBytes(s_TextureHeaderVersionOffset, version, binary));
        EXPECT_FALSE(CanDeserializeTextureAsset(codec, texture.virtualPath(), binary, testArena));
    }
    EXPECT_EQ(logger.errorCount(), 5u);
    EXPECT_TRUE(SawCapturedError(logger, "unsupported texture payload version"));

    ASSERT_TRUE(OverwriteU32InAssetBytes(s_TextureHeaderVersionOffset, s_CurrentTextureVersion, binary));
    ASSERT_TRUE(CanDeserializeTextureAsset(codec, texture.virtualPath(), binary, testArena));
}

void VerifyAssetsGraphics_TexturePayloadRejectsAlphaTransportIncompatibleWithFormat(){
