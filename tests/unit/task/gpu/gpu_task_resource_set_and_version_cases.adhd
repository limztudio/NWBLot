inline constexpr Core::ResourceQueueSharing::Mask s_GpuResVersionInvalidQueueSharingA = static_cast<Core::ResourceQueueSharing::Mask>(1u << 7u);
inline constexpr Core::ResourceQueueSharing::Mask s_GpuResVersionInvalidQueueSharingB = static_cast<Core::ResourceQueueSharing::Mask>(static_cast<u8>(Core::ResourceQueueSharing::Graphics) | (1u << 7u));
inline constexpr Core::GpuTaskResourceVersionRole::Enum s_GpuResVersionInvalidRole = Core::GpuTaskResourceVersionRole::Count;

[[nodiscard]] inline Core::GpuPhysicalQueueTopology MakeGpuResVersionTopology(const Span<const Core::GpuPhysicalQueueInfo> queues)noexcept{
    return Core::GpuPhysicalQueueTopology{ .queues = queues.data(), .queueCount = queues.size() };
}

[[nodiscard]] inline Core::GpuGraphResourceSetDesc MakeGpuResVersionSetDesc(
    const Name& identity,
    const Span<const Core::GpuGraphResourceId> members,
    const usize count
)noexcept{
    return Core::GpuGraphResourceSetDesc{}
        .setIdentity(identity)
        .setMarkerLabel("Resource Set Memory Members")
        .setMembers(Span<const Core::GpuGraphResourceId>(members.data(), count))
    ;
}

struct GpuResVersionGraphScope{
public:
    Core::Alloc::GlobalArena arena;
    Core::GpuTaskGraph graph;
    GpuResVersionResourceIds members;


public:
    explicit GpuResVersionGraphScope(const Name& owner)
        : arena(owner)
        , graph(arena)
        , members(arena)
    {}
};

struct GpuResVersionTelemetryScope{
public:
    Telemetry::FrameGraphNodeDescs nodes;
    Telemetry::FrameGraphEdgeDescs edges;
    Telemetry::FrameGraphPendingNameEdges pendingEdges;
    Telemetry::FrameGraphBuilder builder;


public:
    GpuResVersionTelemetryScope(Core::Alloc::ScratchArena& scratchArena, Telemetry::TelemetryArena& arena)
        : nodes(arena)
        , edges(arena)
        , pendingEdges(arena)
        , builder(scratchArena, nodes, edges, pendingEdges)
    {}
};

struct GpuResVersionSetContext{
public:
    Core::Alloc::GlobalArena graphArena{ Name(TaskGraphTestUtils::s_GpuCaseResourceSetValidationGraph) };
    Core::GpuTaskGraph graph{ graphArena };
    Core::Alloc::GlobalArena inputArena{ Name(TaskGraphTestUtils::s_GpuCaseResourceSetValidationInput) };
    Vector<Core::GpuGraphResourceId, Core::Alloc::GlobalArena> members{ inputArena };
    b8 ready = false;


public:
    explicit GpuResVersionSetContext(const usize count){
        ready = fill(count);
    }


public:
    [[nodiscard]] b8 fill(const usize count){
        members.clear();
        members.reserve(count);
        for(usize index = 0u; index < count; ++index){
            const auto identityNameResult = TaskGraphTestUtils::IndexedName(Name(TaskGraphTestUtils::s_GpuCaseResourceSetValidationResource), index);
            if(!identityNameResult)
                return false;
            const Name identity = *identityNameResult;
            const auto resourceResult = graph.importResource(
                Core::GpuGraphResourceDesc{}
                    .setIdentity(identity)
                    .setMarkerLabel("Resource Set Validation Input")
                    .setType(Core::GpuGraphResourceType::Buffer)
            );
            if(!resourceResult)
                return false;
            const Core::GpuGraphResourceId resource = *resourceResult;
            if(!resource.valid())
                return false;
            members.push_back(resource);
        }
        for(usize index = 0u; index < count / 2u; ++index)
            Swap(members[index], members[count - index - 1u]);
        return true;
    }

    [[nodiscard]] Core::GpuGraphResourceSetDesc description(const Name& identity)const noexcept{
        return Core::GpuGraphResourceSetDesc{}
            .setIdentity(identity)
            .setMarkerLabel("Resource Set Validation Members")
            .setMembers(members)
        ;
    }
};

