#include <gtest/gtest.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_task_graph_import_index_tests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace NWB;
using Tests::TaskGraphTestUtils::IndexedName;

using GraphStamp = NWB::Tests::TaskGraphTestUtils::GraphStamp;

[[nodiscard]] static Core::GpuGraphResourceDesc ResourceDescription(const Name& identity, Core::GpuGraphResourceType::Enum type)noexcept{
    return Core::GpuGraphResourceDesc{}.setIdentity(identity).setMarkerLabel("Graph Import Index Resource").setType(type).setInitialState(Core::ResourceStates::Unknown);
}

[[nodiscard]] static GraphStamp ReadStamp(const Core::GpuTaskGraph& graph){
    const Core::GpuTaskGraph::DeclarationReadView view(graph);
    EXPECT_TRUE(view.valid());
    return GraphStamp{ .generation = view.generation(), .revision = view.declarationRevision(), .resources = view.resourceCount(), .sets = view.resourceSetCount() };
}

static void ExpectUnchanged(const Core::GpuTaskGraph& graph, const GraphStamp& before){
    const GraphStamp after = ReadStamp(graph);
    EXPECT_EQ(after.generation, before.generation);
    EXPECT_EQ(after.revision, before.revision);
    EXPECT_EQ(after.resources, before.resources);
    EXPECT_EQ(after.sets, before.sets);
}

struct ImportContext{
    Core::Alloc::GlobalArena inputArena{ Name(NWB::Tests::TaskGraphTestUtils::s_GpuCaseGraphImportIndexInputs) };
    Core::Alloc::GlobalArena graphArena{ Name(NWB::Tests::TaskGraphTestUtils::s_GpuCaseGraphImportIndexGraph) };
    Core::GpuTaskGraph graph{ graphArena };
    Vector<Core::GpuGraphResourceDesc, Core::Alloc::GlobalArena> genericDescriptions{ inputArena };
    Vector<Core::GpuGraphResourceSetDesc, Core::Alloc::GlobalArena> setDescriptions{ inputArena };
    Vector<Core::GpuGraphResourceId, Core::Alloc::GlobalArena> resources{ inputArena };
    Vector<Core::GpuGraphResourceSetId, Core::Alloc::GlobalArena> sets{ inputArena };


public:
    void prepare(const usize count){
        genericDescriptions.resize(count);
        setDescriptions.resize(count);
        resources.resize(count);
        sets.resize(count);
        for(usize index = 0u; index < count; ++index){
            const auto resourceNameResult = IndexedName(Name(NWB::Tests::TaskGraphTestUtils::s_GpuCaseGraphImportIndexGeneric), index);
            ASSERT_TRUE(resourceNameResult);
            genericDescriptions[index] = ResourceDescription(*resourceNameResult, Core::GpuGraphResourceType::HazardDomain);
            const auto secondResourceNameResult = IndexedName(Name(NWB::Tests::TaskGraphTestUtils::s_GpuCaseGraphImportIndexSet), index);
            ASSERT_TRUE(secondResourceNameResult);
            setDescriptions[index].setIdentity(*secondResourceNameResult).setMarkerLabel("Graph Import Index Set").setMembers(Span(&resources[index], 1u));
        }
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


TEST(TaskGraphImportIndex, EveryNameHashLaneParticipatesAndResourceSetIdentityHasItsOwnNamespace){
    ImportContext context;
    constexpr usize s_Count = 64u;
    context.resources.resize(s_Count);
    context.sets.resize(s_Count);
    Core::Alloc::ScratchArena scratchArena{Name(NWB::Tests::TaskGraphTestUtils::s_GpuCaseGraphImportIndexIdentities)};
    Vector<Name, Core::Alloc::ScratchArena> identities(scratchArena);
    identities.reserve(s_Count);
    for(usize index = 0u; index < s_Count; ++index){
        NameHash hash = ComputeNameHash(MakeNotNull("tests/graph_import_index/full_identity"));
        hash.qwords[index % s_NameHashLaneCount] ^= static_cast<u64>(index + 1u);
        identities.emplace_back(hash);
        const auto description = ResourceDescription(identities.back(), Core::GpuGraphResourceType::HazardDomain);
        const auto resourceTaskAdmission = context.graph.importResource(description);
        ASSERT_TRUE(resourceTaskAdmission);
        context.resources[index] = *resourceTaskAdmission;
        ASSERT_TRUE(context.resources[index].valid());
        EXPECT_EQ(context.resources[index].index, index);
        const auto setTaskAdmission = context.graph.importResourceSet(Core::GpuGraphResourceSetDesc{}.setIdentity(identities.back()).setMarkerLabel("Binary Identity Set").setMembers(Span(&context.resources[index], 1u)));
        ASSERT_TRUE(setTaskAdmission);
        context.sets[index] = *setTaskAdmission;
        ASSERT_TRUE(context.sets[index].valid());
        EXPECT_EQ(context.sets[index].index, index);
    }
    const GraphStamp before = ReadStamp(context.graph);
    for(usize remaining = s_Count; remaining != 0u; --remaining){
        const usize index = remaining - 1u;
        const Name equalIdentity(identities[index].identityHash());
        {
            const auto gpuTaskAdmission = context.graph.importResource(ResourceDescription(equalIdentity, Core::GpuGraphResourceType::HazardDomain));
            EXPECT_TRUE(gpuTaskAdmission);
            if(gpuTaskAdmission)
                EXPECT_EQ(*gpuTaskAdmission, context.resources[index]);
        }
        {
            const auto secondGpuTaskAdmission = context.graph.importResourceSet(Core::GpuGraphResourceSetDesc{}.setIdentity(equalIdentity).setMarkerLabel("Later Binary Identity Label").setMembers(Span(&context.resources[index], 1u)));
            EXPECT_TRUE(secondGpuTaskAdmission);
            if(secondGpuTaskAdmission)
                EXPECT_EQ(*secondGpuTaskAdmission, context.sets[index]);
        }
    }
    ASSERT_NO_FATAL_FAILURE(ExpectUnchanged(context.graph, before));
    EXPECT_EQ(before.resources, s_Count);
    EXPECT_EQ(before.sets, s_Count);
}


TEST(TaskGraphImportIndex, DuplicatePointerRollsBackOnlyNewIdentity){
    Core::Alloc::GlobalArena arena{ NWB::Tests::TaskGraphTestUtils::s_TaskGraphImportPartialPublication };
    Vector<Core::GpuTaskGraphDetail::GpuGraphResourceNode, Core::Alloc::GlobalArena> resources(arena);
    resources.resize(32u);
    for(usize index = 0u; index < resources.size(); ++index){
        const auto name = IndexedName(NWB::Tests::TaskGraphTestUtils::s_TaskGraphImportPrefix, index);
        ASSERT_TRUE(name);
        resources[index].identity = *name;
    }
    Core::GpuGraphResourceImportIndex index(arena);
    const Core::GpuTaskGraphDetail::ResourcePointerKey pointer{ reinterpret_cast<const void*>(1u), Core::GpuGraphResourceType::Buffer };
    index.prepareResourceIndexes(resources, pointer);
    const Name first(NWB::Tests::TaskGraphTestUtils::s_TaskGraphImportFirstPointer);
    const Name second(NWB::Tests::TaskGraphTestUtils::s_TaskGraphImportRejectedPointer);
    Core::GpuGraphResourceImportIndex::Publication accepted;
    ASSERT_TRUE(index.publishResource(first.identityHash(), pointer, 32u, accepted));
    Core::GpuGraphResourceImportIndex::Publication rejected;
    EXPECT_FALSE(index.publishResource(second.identityHash(), pointer, 33u, rejected));
    EXPECT_TRUE(rejected.identity);
    EXPECT_FALSE(rejected.pointer);
    index.rollbackResource(second.identityHash(), pointer, rejected);
    EXPECT_EQ(index.findResourceIdentity(resources, second), Limit<u32>::s_Max);
    EXPECT_EQ(index.findResourceIdentity(resources, first), 32u);
    const auto match = index.findResourceImportMatch(resources, nullptr, pointer);
    EXPECT_TRUE(match.samePointer);
    EXPECT_EQ(match.index, 32u);
}

TEST(TaskGraphImportIndex, ManySetsReuseOnlyTheirOriginalOrderedMembersAndRetainFirstLabels){
    ImportContext context;
    constexpr usize s_Count = 96u;
    ASSERT_NO_FATAL_FAILURE(context.prepare(s_Count));
    for(usize index = 0u; index < s_Count; ++index){
        const auto resourceTaskAdmission = context.graph.importResource(context.genericDescriptions[index]);
        ASSERT_TRUE(resourceTaskAdmission);
        context.resources[index] = *resourceTaskAdmission;
        ASSERT_TRUE(context.resources[index].valid());
        const auto setTaskAdmission = context.graph.importResourceSet(context.setDescriptions[index]);
        ASSERT_TRUE(setTaskAdmission);
        context.sets[index] = *setTaskAdmission;
        ASSERT_TRUE(context.sets[index].valid());
    }
    const GraphStamp before = ReadStamp(context.graph);
    for(usize index = 0u; index < s_Count; ++index){
        const usize selected = (index * 73u) % s_Count;
        auto description = context.setDescriptions[selected];
        description.markerLabel = "Different Later Set Label";
        {
            const auto gpuTaskAdmission = context.graph.importResourceSet(description);
            EXPECT_TRUE(gpuTaskAdmission);
            if(gpuTaskAdmission)
                EXPECT_EQ(*gpuTaskAdmission, context.sets[selected]);
        }
        description.setMembers(Span(&context.resources[(selected + 1u) % s_Count], 1u));
        EXPECT_FALSE(context.graph.importResourceSet(description).has_value());
    }
    ASSERT_NO_FATAL_FAILURE(ExpectUnchanged(context.graph, before));
    const Core::GpuTaskGraph::DeclarationReadView view(context.graph);
    ASSERT_TRUE(view.valid());
    for(usize index = 0u; index < s_Count; ++index){
        const auto set = view.resourceSetAt(context.sets[index].index);
        EXPECT_EQ(set.identity, context.setDescriptions[index].identity);
        EXPECT_EQ(set.markerLabel, "Graph Import Index Set");
        ASSERT_EQ(set.memberCount, 1u);
        EXPECT_EQ(set.members[0u], context.resources[index]);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


