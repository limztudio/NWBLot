#include <utilities/cli/tool_cli.adhd>
#include <tests/common/memory.adhd>
#include <impl/assets_font/asset.adhd>
#include <impl/assets_font_atlas/asset.adhd>
#include "package_name_cases.adhd"
#include <impl/assets_font/cook.adhd>
#include <impl/assets_font_atlas/cook.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Name s_PackageArena = s_OneOffNameTestsIntegrationFontBuilderPackage;
const i32 s_EntryFailure = -1;

StringView TableTag(in u32 tag){
    if(tag == s_FontAtlasKernTag)
        return "kern";
    if(tag == s_FontAtlasGposTag)
        return "GPOS";
    if(tag == s_FontAtlasGdefTag)
        return "GDEF";
    return "";
}

b8 WriteAtlasHeaderBinary(in Path directory, in FontAtlasPayload payload){
    if(!EnsureDirectories(directory).has_value())
        return false;
    const Expected<Vector<u8>> binary = SerializeFontAtlasPayload(payload);
    return binary.has_value() && WriteBinaryFile(directory / "atlas.bin", binary.value());
}

b8 WriteGroupPixelsFile(in Path directory, in usize index, in Span<u8> pixels){
    const String name = StringFormat("group_{}.pixels", index);
    return WriteBinaryFile(directory / name, pixels);
}

b8 WritePositioningTableFile(in Path directory, in StringView tag, in Span<u8> bytes){
    const String name = StringFormat("table_{}.bin", tag);
    return WriteBinaryFile(directory / name, bytes);
}

b8 ExportPayload(in Path directory, in FontAtlasPayload payload){
    if(!WriteAtlasHeaderBinary(directory, payload))
        return false;
    for(usize index = 0u; index < payload.groups.size(); ++index){
        if(!WriteGroupPixelsFile(directory, index, payload.groups[index].pixels))
            return false;
    }
    for(usize index = 0u; index < payload.positioningTables.size(); ++index){
        const StringView tag = TableTag(payload.positioningTables[index].tag);
        if(tag.empty())
            return false;
        if(!WritePositioningTableFile(directory, tag, payload.positioningTables[index].bytes))
            return false;
    }
    return true;
}

b8 DecodePackage(in StringView source, in StringView destination){
    const Path sourcePath = Path(source);
    const Path destinationPath = Path(destination);
    String metadata = "";
    if(!ReadTextFile(sourcePath, metadata).has_value())
        return false;

    StripUtf8Bom(metadata);
    MetascriptDocumentWorkspace metadataOwner(Name(s_FontPackageNameTestsIntegrationFontBuilderMetadata));
    if(!metadataOwner.document.parse(metadata))
        return false;
    ScratchStorage scratch(s_PackageArena);
    const auto expanded = ExpandAssetBunch(sourcePath.parentPath(), "probe", sourcePath, metadataOwner.document, scratch);
    if(!expanded.has_value() || expanded.value().size() != 2u)
        return false;

    Font font;
    FontAtlas atlas;
    b8 foundFont = false;
    b8 foundAtlas = false;
    for(in ExpandedAssetMetadata asset : expanded.value()){
        if(asset.assetType == Name(s_FontPackageLookupNameFont)){
            if(foundFont)
                return false;
            const auto entry = ParseFontCookMetadataValue(asset.virtualPath, sourcePath, asset.value);
            if(!entry.has_value())
                return false;
            const auto built = BuildFontAsset(entry.value());
            if(!built.has_value())
                return false;
            font = built.value();
            foundFont = true;
        }
        else if(asset.assetType == Name(s_FontPackageLookupNameFontAtlas)){
            if(foundAtlas)
                return false;
            const auto entry = ParseFontAtlasCookMetadataValue(asset.virtualPath, sourcePath, asset.value);
            if(!entry.has_value())
                return false;
            const auto built = BuildFontAtlasAsset(entry.value());
            if(!built.has_value())
                return false;
            atlas = built.value();
            foundAtlas = true;
        }
        else
            return false;
    }

    if(!foundFont || !foundAtlas)
        return false;
    if(!ValidateFontAtlasSourceMatch(atlas.payload(), font))
        return false;
    if(!ExportPayload(destinationPath, atlas.payload()))
        return false;
    return WriteBinaryFile(destinationPath / "source.sfnt", font.fontBytes());
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


i32 RunConsole(in ConsoleArguments args){
    if(args.count != 3){
        error("font_builder_package_probe: expected source .nwb and decoded output directory");
        return s_EntryFailure;
    }
    if(!DecodePackage(args.text(1), args.text(2))){
        error("font_builder_package_probe: cannot cook or export font pair");
        return s_EntryFailure;
    }
    return 0;
}


