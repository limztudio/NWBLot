FOUNDATION_INLINE b8 SearchSource::filter(const AStringView query){
    ++filterCalls;
    if(filterMutation){
        EditModel& model = *MakeNotNull(Exchange(filterMutation, nullptr));
        if(!model.setText(s_CallbackQuery))
            return false;
    }
    const AStringView previous{ m_query.data(), m_query.size() };
    if(previous != query){
        m_query.assign(query.data(), query.size());
        ++view.contentRevision;
    }
    view.mode = ::__hidden_ui_glyph_sdf_tests::ResolveSearchFilterMode(query, s_SecondHalfQuery, s_EmptyResultQuery);
    return true;
}
