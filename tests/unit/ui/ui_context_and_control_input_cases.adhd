void VerifyUiContextTests_RootRetentionMatchesLifetimeGenerationAndKeepsOtherRootsActive(mut UiContextTests self){
    const WidgetRoot firstRoot = MakeUiContextRoot(101u, 1u);
    const WidgetRoot secondRoot = MakeUiContextRoot(102u, 1u);
    ASSERT_TRUE(self.m_context.beginFrame(1u));
    ASSERT_TRUE(self.m_context.beginRoot(firstRoot));
    const Expected<WidgetState> first = self.declareState(s_UiContextActionKey, WidgetKind::Button);
    ASSERT_TRUE(first.has_value());
    const WidgetState firstState = first.value();
    ASSERT_TRUE(self.m_context.addTarget(firstState, MakeUiContextButtonTarget()));
    ASSERT_TRUE(self.m_context.endRoot());
    ASSERT_TRUE(self.m_context.beginRoot(secondRoot));
    const Expected<WidgetState> second = self.declareState(s_UiContextActionKey, WidgetKind::Button);
    ASSERT_TRUE(second.has_value());
    const WidgetState secondState = second.value();
    ASSERT_TRUE(self.m_context.addTarget(secondState, MakeUiContextButtonTargetAt(MakeUiContextRect(80.0f, 20.0f, 30.0f, 20.0f))));
    ASSERT_TRUE(self.m_context.endRoot());
    ASSERT_TRUE(self.m_context.finishFrame());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    Array<WidgetRoot, 2u> retained = Array<WidgetRoot, 2u>();
    retained[0u] = MakeUiContextRoot(firstRoot.value, firstRoot.generation + 1u);
    retained[1u] = secondRoot;
    self.m_context.retainRoots(retained);
    ASSERT_EQ(self.m_context.states().entries().size(), 1u);
    EXPECT_EQ(self.m_context.states().entries()[0u].id, secondState.id);
    EXPECT_FALSE(self.m_context.input().hitTest(MakeUiContextPoint(15.0f, 25.0f)).valid());
    EXPECT_EQ(self.m_context.input().hitTest(MakeUiContextPoint(85.0f, 25.0f)), secondState.id);
}

void VerifyUiContextTests_RootRetentionHandlesManyUnorderedRootsAndLifetimeChanges(mut UiContextTests self){
    ASSERT_TRUE(self.m_context.beginFrame(1u));
    for(u64 index = 1u; index <= s_WidgetMaxStates; ++index){
        ASSERT_TRUE(self.m_context.beginRoot(MakeUiContextRoot(index, 1u)));
        ASSERT_TRUE(self.declareState(s_UiContextActionKey, WidgetKind::Button).has_value());
        ASSERT_TRUE(self.m_context.endRoot());
    }
    ASSERT_TRUE(self.m_context.finishFrame());
    ASSERT_TRUE(self.m_context.commitFrame(1u));

    const u64 rootCount = 100000u;
    Vector<WidgetRoot> roots = Vector<WidgetRoot>();
    roots.reserve(cast<usize>(rootCount + 1u));
    for(u64 index = rootCount; index > 0u; --index)
        roots.push_back(MakeUiContextRoot(index, 1u));
    roots.push_back(MakeUiContextRoot(2u, 1u));
    self.m_context.retainRoots(roots);
    EXPECT_EQ(self.m_context.states().entries().size(), s_WidgetMaxStates);

    roots[cast<usize>(rootCount - 1u)].generation = 2u;
    self.m_context.retainRoots(roots);
    EXPECT_EQ(self.m_context.states().entries().size(), s_WidgetMaxStates - 1u);
}

void VerifyUiContextTests_DisabledDeclarationDropsOldFocusAndActionsBeforePublication(mut UiContextTests self){
    const Expected<WidgetState> originalResult = self.prepare(1u, MakeUiContextRoot(111u, 1u));
    ASSERT_TRUE(originalResult.has_value());
    const WidgetState original = originalResult.value();
