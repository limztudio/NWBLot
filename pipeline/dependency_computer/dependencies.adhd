namespace_wrapper NWB_DEPENDENCY_COMPUTER;

class AssetDependencyOptions{
    public Vector<String> inputs;
    public Vector<String> assetRoots;
    public String repoRoot;
    public String outputPath;
}

class DependencyInputSelection{
    public Vector<u8> selected;
    public Vector<usize> order;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class DependencyQueueState{
    public Vector<u8> included;
    public Vector<u8> processed;
    public Vector<usize> fileQueue;

    [cpp_unwind]
    public void initialize(in usize fileCount, in Span<u8> initialSelected, in Span<usize> initialOrder){
        this.included.clear();
        this.included.reserve(initialSelected.size());
        for(usize i = 0u; i < initialSelected.size(); ++i)
            this.included.push_back(initialSelected[i]);

        this.processed.clear();
        this.processed.resize(fileCount, 0u);

        this.fileQueue.clear();
        this.fileQueue.reserve(fileCount);
        for(usize i = 0u; i < initialOrder.size(); ++i)
            this.fileQueue.push_back(initialOrder[i]);
    }

    public b8 claimIncluded(in usize providerIndex){
        if(this.included[providerIndex] != 0u)
            return false;
        this.included[providerIndex] = 1u;
        return true;
    }

    [cpp_unwind]
    public void enqueueIfUnprocessed(in usize providerIndex){
        if(this.processed[providerIndex] == 0u)
            this.fileQueue.push_back(providerIndex);
    }

    public b8 claimProcessed(in usize fileIndex){
        if(this.processed[fileIndex] != 0u)
            return false;
        this.processed[fileIndex] = 1u;
        return true;
    }
}

class DependencyProviderCatalog : NoCopy{
    private mut AssetCookWorkspace m_workspace;
    public mut CookFileCatalog catalog;
    public mut CookDependencyAccess access;
    public Vector<Name> virtualPaths;

    public DependencyProviderCatalog(mut AssetCookWorkspace workspace, mut CookFileCatalog catalog, mut CookDependencyAccess access){
        this.m_workspace = workspace;
        this.catalog = catalog;
        this.access = access;
    }

    [cpp_unwind]
    public b8 discover(in AssetDependencyOptions options){
        const auto repo = ResolvePipelineRepoRoot(StringView(options.repoRoot), s_DiagnosticPrefix);
        if(!repo.has_value())
            return false;
        const auto roots = ResolvePipelineAssetRoots(repo.value(), options.inputs, options.assetRoots, AssetRootDuplicatePolicy::HostFilesystem, s_DiagnosticPrefix, "no asset roots available for dependency resolution");
        if(!roots.has_value())
            return false;
        CookFileCatalog discovered(this.m_workspace);
        discovered.setRepoRoot(repo.value());
        discovered.paths.assetRoots.reserve(roots.value().size());
        for(in PipelineAssetRoot root : roots.value())
            discovered.appendRoot(root.path, root.virtualRoot.view());
        if(!discovered.discover(s_NwbExtension))
            return false;
        Vector<Name> names;
        names.reserve(discovered.files.size());
        for(in DiscoveredNwbFile file : discovered.files){
            const auto path = BuildDerivedAssetVirtualPath(file.assetRoot, file.virtualRoot.view(), file.filePath);
            if(!path.has_value())
                return false;
            names.push_back(path.value());
        }
        this.catalog.replace(discovered);
        this.virtualPaths = names;
        return true;
    }

    private b8 matchesType(in Name actual, in Name expected)const{
        return expected == s_NameNone || actual == expected || this.access.registry.matchesAssetType(actual, expected);
    }

    [cpp_unwind]
    private Expected<b8> matchesFile(in DiscoveredNwbFile file, in MetascriptDocument document, in Name path, in Name type)const{
        const auto bunch = HasAssetBunchDeclaration(document);
        if(!bunch.has_value())
            return MakeUnexpected(Failure());
        if(bunch.value()){
            if(type != s_NameNone){
                LogMultipleAssetsDeclaredForPath(PathToString(file.filePath), path);
                return MakeUnexpected(Failure());
            }
            if(!this.access.expandBunch(file, document))
                return MakeUnexpected(Failure());
            return true;
        }
        const auto declared = document.declarationType(s_MetadataAssetVariable);
        if(!declared.has_value())
            return false;
        const auto parsed = ParseName(declared.value());
        if(!parsed.has_value())
            return MakeUnexpected(Failure());
        if(!this.matchesType(parsed.value(), type))
            return false;
        const auto composite = HasCompositeAssetDeclarations(document);
        if(!composite.has_value())
            return MakeUnexpected(Failure());
        if(composite.value()){
            if(!this.access.expandComposite(file, document))
                return MakeUnexpected(Failure());
        }
        else if(document.declarationCount() != 1u){
            LogMultipleAssetsDeclaredForPath(PathToString(file.filePath), path);
            return MakeUnexpected(Failure());
        }
        return true;
    }

    [cpp_unwind]
    private Expected<b8> matchesChild(in DiscoveredNwbFile file, in MetascriptDocument document, in Name path, in Name type)const{
        const auto expanded = this.access.expand(file, document);
        if(!expanded.has_value()){
            if(expanded.error() == AssetBunchExpandFailure::Unsupported)
                return false;
            return MakeUnexpected(Failure());
        }
        for(in ExpandedAssetMetadata item : expanded.value()){
            if(item.virtualPath == path && this.matchesType(item.assetType, type))
                return true;
        }
        return false;
    }

    [cpp_unwind]
    public Expected<usize> resolve(in Name path, in Name type, in StringView hint)const{
        if(path == s_NameNone)
            return MakeUnexpected(Failure());
        const StringView text = ResolveDependencyVirtualPathText(path, hint);
        const Optional<Name> parent = ExtractParentVirtualPath(text);
        usize matched = s_InvalidProviderIndex;
        for(usize index = 0u; index < this.catalog.files.size(); ++index){
            const b8 exact = this.virtualPaths[index] == path;
            if(!exact && (!parent.has_value() || this.virtualPaths[index] != parent.value()))
                continue;
            in DiscoveredNwbFile file = this.catalog.files[index];
            const auto document = this.access.read(file, s_DiagnosticPrefix);
            if(!document.has_value())
                return MakeUnexpected(Failure());
            Expected<b8> found = false;
            if(exact)
                found = this.matchesFile(file, document.value(), path, type);
            else
                found = this.matchesChild(file, document.value(), path, type);
            if(!found.has_value() || (found.value() && !RecordDependencyProviderMatch(path, index, matched)))
                return MakeUnexpected(Failure());
        }
        if(matched == s_InvalidProviderIndex){
            LogMissingDependencyProvider(path, type, text);
            return MakeUnexpected(Failure());
        }
        return matched;
    }

    [cpp_unwind]
    public Expected<DependencyInputSelection> selectInputs(in AssetDependencyOptions options)const;
}

class DependencyTraversal : NoCopy{
    private in DependencyProviderCatalog m_providers;
    private mut Vector<String> m_candidates;
    private DependencyQueueState m_queue;
    private DependencyPathHints m_hints;

    public DependencyTraversal(in DependencyProviderCatalog providers, mut Vector<String> candidates){
        this.m_providers = providers;
        this.m_candidates = candidates;
    }

    [cpp_unwind]
    private b8 enqueue(in Name path, in Name type){
        if(path == s_NameNone)
            return false;
        const auto found = this.m_providers.resolve(path, type, this.m_hints.lookup(path));
        if(!found.has_value())
            return false;
        const usize index = found.value();
        if(this.m_queue.claimIncluded(index))
            this.m_candidates.push_back(PathToString(this.m_providers.catalog.files[index].filePath.lexicallyNormal()));
        this.m_queue.enqueueIfUnprocessed(index);
        return true;
    }

    [cpp_unwind]
    private b8 extract(in DiscoveredNwbFile file, in Name type, in Name path, in MetascriptValue value, in Optional<in MetascriptDocument> document){
        return this.m_providers.access.extract(file, type, path, value, document, lambda[mut this](in Name dep, in Name expected) -> b8{ return this.enqueue(dep, expected); });
    }

    [cpp_unwind]
    private b8 process(in usize index);

    [cpp_unwind]
    public b8 traverse(in DependencyInputSelection selected){
        this.m_queue.initialize(this.m_providers.catalog.files.size(), selected.selected, selected.order);
        this.m_hints.reserve(this.m_providers.catalog.files.size());
        for(usize cursor = 0u; cursor < this.m_queue.fileQueue.size(); ++cursor){
            const usize file = this.m_queue.fileQueue[cursor];
            if(this.m_queue.claimProcessed(file) && !this.process(file))
                return false;
        }
        return true;
    }
}

b8 ValidateSingleProviderAssetDeclaration(in usize declarationCount, in StringView providerPathText){
    if(declarationCount != 1u){
        error("DependencyComputer: provider '{}' declares multiple assets without an asset_bunch", providerPathText);
        return false;
    }
    return true;
}

void LogMissingMetadataAssetDeclaration(in StringView providerPathText){
    error("DependencyComputer: meta '{}' is missing asset declaration 'asset'", providerPathText);
}

b8 WriteDependencyListOutput(in StringView outputPathText, in StringView encodedListText){
    const Expected<Path, ErrorCode> output = AbsolutePath(Path(outputPathText));
    if(!output.has_value())
        return false;
    if(!EnsureDirectories(output.value().parentPath()).has_value())
        return false;
    return WriteTextFileAtomic(output.value(), encodedListText);
}

void LogUnrepresentableDependencyList(){
    error("DependencyComputer: input paths cannot be represented in the dependency list");
}

void LogDependencyOutputWriteFailure(in StringView outputPath){
    error("DependencyComputer: failed to write output '{}'", outputPath);
}

void LogReturnedDependencyInputCount(in usize count){
    [essential] info("DependencyComputer: returned {} inputs", count);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
void CollectValuePathHints(in MetascriptValue value, mut DependencyPathHints hints){
    if(value.isString()){
        hints.record(value.asString());
        return;
    }
    if(value.isList()){
        for(in MetascriptValue item : value.listView())
            CollectValuePathHints(item, hints);
        return;
    }
    if(value.isMap())
        value.forEachMapEntry(lambda[mut hints](in StringView key, in MetascriptValue item) -> b8{
            hints.record(key);
            CollectValuePathHints(item, hints);
            return true;
        });
}

[cpp_unwind]
void CollectDocumentPathHints(in MetascriptDocument document, mut DependencyPathHints hints){
    const Optional<in MetascriptDocument> owner(document);
    document.forEachDeclaration(lambda[in owner, mut hints](in StringView typeName, in StringView variableName) -> b8{
        owner.value().visitVariable(variableName, lambda[mut hints](in MetascriptValue value) -> b8{
            CollectValuePathHints(value, hints);
            return true;
        });
        return true;
    });
}

[cpp_unwind]
Expected<DependencyInputSelection> DependencyProviderCatalog::selectInputs(in AssetDependencyOptions options)const{
    DependencyInputSelection result;
    result.selected.resize(this.catalog.files.size(), 0u);
    result.order.reserve(this.catalog.files.size());
    if(options.inputs.empty()){
        in DefaultCookEntryAssetDescriptor entry = this.access.registry.defaultEntryAsset();
        if(!ValidateDefaultDependencyEntryAsset(entry.virtualPath))
            return MakeUnexpected(Failure());
        const auto provider = this.resolve(entry.virtualPath, entry.assetType, entry.virtualPathText);
        if(!provider.has_value()){
            LogProjectRootMissing(entry.virtualPathText);
            return MakeUnexpected(Failure());
        }
        result.selected[provider.value()] = 1u;
        result.order.push_back(provider.value());
    }
    else if(!this.catalog.select(options.inputs, result.selected, result.order, lambda[](in CookInputSelectionError failure) -> void{ LogCookInputSelectionFailure(failure, s_DiagnosticPrefix); }))
        return MakeUnexpected(Failure());
    return result;
}

[cpp_unwind]
b8 DependencyTraversal::process(in usize index){
    in DiscoveredNwbFile file = this.m_providers.catalog.files[index];
    const auto doc = this.m_providers.access.read(file, s_DiagnosticPrefix);
    if(!doc.has_value())
        return false;
    in MetascriptDocument document = doc.value();
    CollectDocumentPathHints(document, this.m_hints);
    const auto expanded = this.m_providers.access.expand(file, document);
    if(expanded.has_value()){
        for(in ExpandedAssetMetadata item : expanded.value())
            CollectValuePathHints(item.value, this.m_hints);
        for(in ExpandedAssetMetadata item : expanded.value()){
            if(!this.extract(file, item.assetType, item.virtualPath, item.value, Optional<in MetascriptDocument>()))
                return false;
        }
        return true;
    }
    if(expanded.error() != AssetBunchExpandFailure::Unsupported)
        return false;
    if(document.declarationCount() != 1u && !ValidateSingleProviderAssetDeclaration(document.declarationCount(), PathToString(file.filePath)))
        return false;
    const auto declared = document.declarationType(s_MetadataAssetVariable);
    if(!declared.has_value()){
        LogMissingMetadataAssetDeclaration(PathToString(file.filePath));
        return false;
    }
    const auto type = ParseName(declared.value());
    if(!type.has_value())
        return false;
    if(!document.hasVariable(s_MetadataAssetVariable)){
        error("{} '{}': missing asset declaration '{}'", s_DiagnosticPrefix, file.filePath, s_MetadataAssetVariable);
        return false;
    }
    const Name declaredType = type.value();
    const Optional<in MetascriptDocument> owner(document);
    return document.visitVariable(s_MetadataAssetVariable, lambda[mut this, in index, in declaredType, in owner](in MetascriptValue value) -> b8{
        return this.extract(this.m_providers.catalog.files[index], declaredType, this.m_providers.virtualPaths[index], value, owner);
    });
}

[cpp_unwind]
Expected<Vector<String>> ComputeAssetDependencies(in AssetDependencyOptions options){
    AssetCookWorkspace workspace(s_DependencyComputerArena);
    CookFileCatalog catalog(workspace);
    CookDependencyAccess access(workspace);
    DependencyProviderCatalog providers(workspace, catalog, access);
    if(!providers.access.registerTypes() || !providers.discover(options))
        return MakeUnexpected(Failure());
    const auto selection = providers.selectInputs(options);
    if(!selection.has_value())
        return MakeUnexpected(Failure());
    Vector<String> paths;
    if(!options.inputs.empty())
        paths = options.inputs;
    else{
        paths.reserve(selection.value().order.size());
        for(in usize index : selection.value().order)
            paths.push_back(PathToString(providers.catalog.files[index].filePath.lexicallyNormal()));
    }
    DependencyTraversal traversal(providers, paths);
    if(!traversal.traverse(selection.value()))
        return MakeUnexpected(Failure());
    return paths;
}

[cpp_unwind]
b8 WriteAssetDependencies(in AssetDependencyOptions options){
    const auto paths = ComputeAssetDependencies(options);
    if(!paths.has_value())
        return false;
    const auto text = EncodeCookInputPaths(paths.value());
    if(!text.has_value()){
        LogUnrepresentableDependencyList();
        return false;
    }
    if(!WriteDependencyListOutput(options.outputPath, text.value())){
        LogDependencyOutputWriteFailure(options.outputPath);
        return false;
    }
    LogReturnedDependencyInputCount(paths.value().size());
    return true;
}


