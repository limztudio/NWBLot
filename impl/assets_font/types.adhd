////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_font/sfnt_directory.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NativeFontFailure MakeNativeFontFailure(in StringView operation, in i32 nativeError){
    NativeFontFailure failure;
    failure.operation = operation;
    failure.nativeError = nativeError;
    failure.hasNativeError = true;
    return failure;
}

NativeFontFailure MakeNativeFontPolicyFailure(in StringView operation){
    NativeFontFailure failure;
    failure.operation = operation;
    failure.nativeError = 0;
    failure.hasNativeError = false;
    return failure;
}

Expected<FontSfntDirectory> ReadFontSfntDirectory(in Span<u8> bytes){
    if(bytes.size() < s_FontSfntHeaderBytes)
        return MakeUnexpected(Failure());
    const u16 tableCount = ReadFontSfntU16BigEndian(bytes, s_FontSfntHeaderTableCountFieldOffset);
    if(tableCount == 0u || cast<u32>(tableCount) > s_FontMaxTableCount || cast<usize>(tableCount) * s_FontSfntTableRecordBytes > bytes.size() - s_FontSfntHeaderBytes)
        return MakeUnexpected(Failure());
    FontSfntDirectory directory;
    directory.assign(bytes, tableCount);
    return directory;
}

b8 ValidateFontSfntRequiredTables(in Span<u8> bytes){
    const Expected<FontSfntDirectory> directory = ReadFontSfntDirectory(bytes);
    if(!directory.has_value())
        return false;
    const u32 signature = directory.value().signature();
    if(signature != s_TrueTypeSignature && signature != s_CffSignature)
        return false;

    Array<u32, 256> tags;
    b8 hasHead = false;
    b8 hasCmap = false;
    b8 hasMaxp = false;
    b8 hasHhea = false;
    b8 hasHmtx = false;
    b8 hasGlyf = false;
    b8 hasLoca = false;
    b8 hasCff = false;
    for(u16 index = 0u; index < directory.value().tableCount(); ++index){
        const Expected<FontSfntTable> tableResult = directory.value().table(cast<usize>(index));
        if(!tableResult.has_value() || cast<usize>(tableResult.value().offset) < directory.value().directoryBytes())
            return false;
        const u32 tag = tableResult.value().tag;
        const usize length = tableResult.value().bytes.size();
        if(tag == s_FvarTag || tag == s_Cff2Tag)
            return false;
        for(u16 prev = 0u; prev < index; ++prev){
            if(tags[cast<usize>(prev)] == tag)
                return false;
        }
        tags[cast<usize>(index)] = tag;
        switch(tag){
        case s_FontSfntHeadTag:
            hasHead = length >= s_HeadMinBytes;
            break;
        case s_CmapTag:
            hasCmap = length >= s_CmapMinBytes;
            break;
        case s_FontSfntMaxpTag:
            hasMaxp = length >= s_MaxpMinBytes;
            break;
        case s_HheaTag:
            hasHhea = length >= s_HheaMinBytes;
            break;
        case s_HmtxTag:
            hasHmtx = length >= s_HmtxMinBytes;
            break;
        case s_GlyfTag:
            hasGlyf = length > 0u;
            break;
        case s_LocaTag:
            hasLoca = length > 0u;
            break;
        case s_CffTableTag:
            hasCff = length > 0u;
            break;
        default:
            break;
        }
    }
    if(!hasHead || !hasCmap || !hasMaxp || !hasHhea || !hasHmtx)
        return false;
    if(signature == s_TrueTypeSignature)
        return hasGlyf && hasLoca;
    return hasCff;
}

b8 ValidateFontSourceDirectory(in Span<u8> bytes, in u32 faceIndex){
    if(faceIndex != 0u || bytes.empty() || bytes.size() > cast<usize>(s_FontMaxSourceBytes)){
        error("ValidateFontSource failed: face index must be zero and source size must be 1..{} bytes", s_FontMaxSourceBytes);
        return false;
    }
    if(!ValidateFontSfntRequiredTables(bytes)){
        error("ValidateFontSource failed: unsupported or malformed static TrueType/CFF SFNT directory");
        return false;
    }
    return true;
}

void ReportNativeFontFailure(in NativeFontFailure failure){
    if(failure.hasNativeError)
        error("ValidateFontSource failed: native_operation={} native_domain=FreeType native_code={}", failure.operation, failure.nativeError);
    else
        error("ValidateFontSource failed: FreeType rejected the scalable Unicode face ({})", failure.operation);
}

