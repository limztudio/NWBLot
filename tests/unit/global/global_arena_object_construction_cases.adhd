[cpp_unwind]
void VerifyArenaObjectConstruction_RawObjectFailureReleasesAlignedStorageAndConstructedMembers(){
    HeapStorageHandle storage(s_GlobalArenaCaseArenaObjectRawConstructorFailure);
    VerifyConstructionFailure(storage, 1u, lambda[mut storage](mut ConstructionState state) -> b8{
        return ProbePresent(OwnRawScalar(storage, state));
    });
    EXPECT_EQ(storage.memoryStats().usedBytes, 0u);
}

