// limztudio@gmail.com
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u32 ResolveRuntimeSkinningJointCount(in b8 hasSkinPayload, in u32 skeletonJointCount){
    if(hasSkinPayload)
        return skeletonJointCount;
    return 0u;
}

u64 ComputeJointPaletteBufferByteSize(in u32 jointCount, in usize jointMatrixByteSize){
    return cast<u64>(jointCount) * cast<u64>(jointMatrixByteSize);
}

usize ResolvePreviousFrameStateSourceCount(in b8 hasAcceptedState, in usize sourceCapacity){
    if(hasAcceptedState)
        return sourceCapacity;
    return 0u;
}

b8 ValidateFinalizedSkinningPlanStates(
    in b8 hasActiveSkin,
    in b8 copiedRestStreams,
    in b8 skinnedStreamsReady,
    in b8 updatesMeshletBounds,
    in b8 boundsStreamsReady,
    in b8 repacksNormals,
    in b8 attributeStreamReady
){
    if((hasActiveSkin || copiedRestStreams) && !skinnedStreamsReady)
        return false;
    if(updatesMeshletBounds && !boundsStreamsReady)
        return false;
    if(repacksNormals && !attributeStreamReady)
        return false;
    return true;
}

b8 ValidateCompiledSkinningGraphPlan(
    in b8 planValidForDeclarations,
    in usize packetCount,
    in b8 terminalMatchesGraphicsQueue
){
    if(!planValidForDeclarations){
        error("MeshSkinningSystem: failed to retain graph-owned skinning compiler inputs");
        return false;
    }
    if(packetCount != 1u){
        error("MeshSkinningSystem: graph-owned skinning work did not merge into one primary Graphics packet");
        return false;
    }
    if(!terminalMatchesGraphicsQueue){
        error("MeshSkinningSystem: graph-owned skinning work did not retain the primary Graphics queue");
        return false;
    }
    return true;
}

void ReportUnacceptedSkinningGraphExecution(in b8 preparationInvoked, in b8 statePrepared){
    if(!preparationInvoked)
        error("MeshSkinningSystem: failed to record graph-owned skinning work");
    else if(!statePrepared)
        error("MeshSkinningSystem: failed to prepare graph-owned skinning frame state");
    else
        error("MeshSkinningSystem: graph-owned skinning submission was rejected");
}

b8 ValidateAcceptedSkinningGraphExecution(
    in b8 graphAccepted,
    in b8 stateAccepted,
    in b8 matchesGraphicsQueue
){
    if(!graphAccepted || !stateAccepted){
        error("MeshSkinningSystem: accepted graph-owned skinning submission lost its retained state");
        return false;
    }
    if(!matchesGraphicsQueue){
        error("MeshSkinningSystem: graph-owned skinning submission lost its Graphics queue identity");
        return false;
    }
    return true;
}


