void VerifyUiNumericEditBuilderTests_SharedTypedModelIsRejectedBeforeTheSecondHostLoan(mut UiNumericEditBuilderTests self){
    self.useHost();
    EditBoxState another = EditBoxState();
    ASSERT_TRUE(self.beginNumeric(1u));
    ASSERT_TRUE(self.m_builder.integerEdit(s_UiNumericEditIntegerKey, self.m_integer, self.m_integerState).edit.valid);
    const auto duplicate = self.m_builder.integerEdit("duplicate", self.m_integer, another);
    EXPECT_FALSE(duplicate.edit.valid || duplicate.numeric.valid);
    EXPECT_EQ(another.modelGeneration, 0u);
    EXPECT_EQ(self.m_host.loans, 1u);
    EXPECT_TRUE(self.m_context.failed());
}

