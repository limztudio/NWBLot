[[nodiscard]] FOUNDATION_INLINE Core::GpuPhysicalQueueInfo MakeSuiteGraphicsPhysicalQueueInfo()noexcept{
    Core::GpuPhysicalQueueInfo info{};
    info.queueClass = Core::CommandQueue::Graphics;
    return info;
}

[[nodiscard]] FOUNDATION_INLINE Core::GpuTaskId MakeSuiteGpuTaskId(const u32 generation, const u32 index)noexcept{
    return Core::GpuTaskId{ .generation = generation, .index = index };
}

inline constexpr Name s_CsgShadowReceiverGroup = NWB::Tests::EcsGraphicsCases::s_EcsGraphicsNameTestsCsgShadowGroup;
inline constexpr Name s_CsgShadowOtherGroup = NWB::Tests::EcsGraphicsCases::s_EcsGraphicsNameTestsCsgShadowOther;
inline constexpr Name s_CsgShadowCustomShape = NWB::Tests::EcsGraphicsCases::s_EcsGraphicsNameTestsCsgShadowCustom;
inline constexpr Array<u32, 1> s_OpenTriangleWords = { 0u };
inline constexpr i32 s_FrameCacheBindingFailure = 43;

struct FrameCacheRuntimeProvider final : IRuntimeMeshProvider{
    Core::ECS::EntityID receiver = Core::ECS::s_InvalidEntityId;
    b8 attached = false;


public:
    [[nodiscard]] virtual Expected<RuntimeMeshDesc> resolveRuntimeMesh(Core::ECS::EntityID)noexcept override{ return MakeUnexpected(Failure{}); }

    [[nodiscard]] virtual b8 hasRuntimeMeshBinding(const Core::ECS::EntityID entity)const noexcept override{
        return attached && entity == receiver;
    }

    virtual void markLiveRuntimeMeshes(RuntimeMeshRequestSet&)noexcept override{}
};

FOUNDATION_INLINE void SetCsgCutterParameters(const Float4& parameter, CsgCutterComponent& cutter){
    cutter.parameterBytes.resize(sizeof(parameter));
    FOUNDATION_MEMCPY(cutter.parameterBytes.data(), cutter.parameterBytes.size(), &parameter, sizeof(parameter));
}

struct CsgShadowSnapshotContext{
    Tests::EcsTestWorld testWorld;
    Core::Alloc::ScratchArena scratch{ Name(NWB::Tests::EcsGraphicsCases::s_EcsCaseTestsCsgShadowScratch) };
    CsgShapeRegistry registry{ testWorld.arena };
    CsgShadowSnapshot snapshot{ testWorld.arena };


public:
    [[nodiscard]] b8 build(const Span<const CsgShadowReceiverInput> receivers){
        return BuildCsgShadowSnapshot(registry, receivers, testWorld.world, scratch, snapshot);
    }

    [[nodiscard]] b8 buildEmpty(){
        return BuildCsgShadowSnapshot(registry, Span<const CsgShadowReceiverInput>{}, testWorld.world, scratch, snapshot);
    }

    [[nodiscard]] Core::ECS::EntityID addReceiver(const Name group = s_CsgShadowReceiverGroup, const b8 skinned = false){
        auto entity = testWorld.world.createEntity();
        if(skinned)
            entity.addComponent<SkinnedCsgMeshComponent>().receiverGroup = group;
        else
            entity.addComponent<StaticCsgMeshComponent>().receiverGroup = group;
        return entity.id();
    }

    [[nodiscard]] Core::ECS::EntityID addCutter(const Name shape, const Name group = s_CsgShadowReceiverGroup){
        auto entity = testWorld.world.createEntity();
        auto& cutter = entity.addComponent<CsgCutterComponent>();
        cutter.receiverGroup = group;
        cutter.shapeType = shape;
        return entity.id();
    }

    void setCutterTranslation(const Core::ECS::EntityID cutterEntity, const f32 x, const f32 y, const f32 z){
        auto& cutter = testWorld.world.entity(cutterEntity).getComponent<CsgCutterComponent>();
        StoreFloat(MatrixTranslation(x, y, z), cutter.shapeToWorld);
        StoreFloat(MatrixTranslation(-x, -y, -z), cutter.worldToShape);
    }

    void setCutterParameters(const Core::ECS::EntityID cutterEntity, const Float4& parameter){
        auto& cutter = testWorld.world.entity(cutterEntity).getComponent<CsgCutterComponent>();
        SetCsgCutterParameters(parameter, cutter);
    }
};

[[nodiscard]] FOUNDATION_INLINE CsgShadowReceiverInput MakeCsgReceiverInput(const Core::ECS::EntityID entity)noexcept{
    CsgShadowReceiverInput input;
    input.entity = entity;
    input.worldMin = Float3U(-2.0f, -2.0f, -2.0f);
    input.worldMax = Float3U(2.0f, 2.0f, 2.0f);
    input.boundsValid = true;
    return input;
}

[[nodiscard]] FOUNDATION_INLINE Expected<CsgShapeBounds> CustomCsgShapeBounds(const SIMDMatrix& shapeToWorld, const Span<const u8> parameters)noexcept{
    if(!parameters.empty())
        return MakeUnexpected(Failure{});
    const auto bounds = AabbTests::Transform(shapeToWorld, VectorReplicate(-1.0f), VectorReplicate(1.0f));
    if(!bounds)
        return MakeUnexpected(Failure{});
    return CsgShapeBounds{ bounds->minBounds, bounds->maxBounds, true };
}

[[nodiscard]] FOUNDATION_INLINE b8 RegisterCustomCsgShape(CsgShadowSnapshotContext& context, const Name name = s_CsgShadowCustomShape){
    CsgShapeTypeDesc description(context.testWorld.arena);
    description.name = name;
    description.shaderModule = NWB::Tests::EcsGraphicsCases::s_EcsCaseTestsCsgShadowEvaluator;
    description.shaderModuleInclude = "tests/csg_shadow/evaluator.slangi";
    description.boundsCallback = &CustomCsgShapeBounds;
    return context.registry.registerShapeType(description).has_value();
}

FOUNDATION_INLINE void AppendIdentityLightSpaceCsgReceiver(
    LightSpaceCsgState& state,
    const Core::ECS::EntityID receiver,
    const ECSRenderDetail::MeshRayTracingResourceSnapshot& mesh
){
    AppendLightSpaceCsgReceiver(
        state,
        receiver,
        false,
        MatrixIdentity(),
        MatrixIdentity(),
        LoadFloatInt(mesh.csgLocalBounds.minBounds),
        LoadFloatInt(mesh.csgLocalBounds.maxBounds),
        mesh
    );
}

FOUNDATION_INLINE void AppendTranslatedXLightSpaceCsgReceiver(
    LightSpaceCsgState& state,
    const Core::ECS::EntityID receiver,
    const f32 x,
    const ECSRenderDetail::MeshRayTracingResourceSnapshot& mesh
){
    const SIMDMatrix inverseShift = MatrixTranslation(-x, 0.0f, 0.0f);
    AppendLightSpaceCsgReceiver(
        state,
        receiver,
        false,
        MatrixTranslation(x, 0.0f, 0.0f),
        inverseShift,
        LoadFloatInt(mesh.csgLocalBounds.minBounds),
        LoadFloatInt(mesh.csgLocalBounds.maxBounds),
        mesh
    );
}

FOUNDATION_INLINE void SetSuiteInstancePitchAndX(const f32 x, InstanceGpuData& instance)noexcept{
    instance.translation.x = x;
    StoreFloat(QuaternionRotationRollPitchYaw(0.0f, x, 0.0f), instance.rotation);
}

[[nodiscard]] FOUNDATION_INLINE u64 BuildSuiteLightSpaceCsgCaptureIdentity(
    const LightSpaceCsgState& state,
    const Span<const NwbRtInstanceMaterialGpu> materials,
    const Span<const InstanceGpuData> instances,
    const Span<const u8> materialBytes
)noexcept{
    return BuildLightSpaceCsgCaptureIdentity(state, materials, instances, materialBytes, Span<const Core::TextureHandle>{});
}

[[nodiscard]] FOUNDATION_INLINE u64 BuildSuiteLightSpaceCsgCaptureIdentityEmptyBytes(
    const LightSpaceCsgState& state,
    const Span<const NwbRtInstanceMaterialGpu> materials,
    const Span<const InstanceGpuData> instances
)noexcept{
    return BuildLightSpaceCsgCaptureIdentity(state, materials, instances, Span<const u8>{}, Span<const Core::TextureHandle>{});
}

[[nodiscard]] FOUNDATION_INLINE Core::GpuDescriptorHandle MakeSuiteStorageBufferDescriptor(const u32 slot)noexcept{
    return Core::GpuDescriptorHandle::Make(Core::GpuDescriptorClass::StorageBuffer, slot);
}

[[nodiscard]] FOUNDATION_INLINE Span<const u32> EmptySuiteU32Span()noexcept{
    return Span<const u32>{};
}

[[nodiscard]] FOUNDATION_INLINE b8 ResolveSuiteCsgBoxWorkBounds(
    const CsgShapeRegistry& registry,
    const CsgShapeTypeInfo& shape,
    const SIMDMatrix& shapeToWorld,
    const CsgBoxShapeParameters& parameters,
    const CsgClipWorkBounds& receiver,
    CsgClipWorkBounds& outWork
){
    const BinaryByteView parameterBytes(reinterpret_cast<const u8*>(&parameters), sizeof(parameters));
    return ResolveCsgClipWorkBounds(registry, shape, shapeToWorld, parameterBytes, receiver, outWork);
}

[[nodiscard]] FOUNDATION_INLINE b8 ResolveSuiteCsgTranslatedBoxWorkBounds(
    const CsgShapeRegistry& registry,
    const CsgShapeTypeInfo& shape,
    const f32 tx,
    const f32 ty,
    const f32 tz,
    const CsgBoxShapeParameters& parameters,
    const CsgClipWorkBounds& receiver,
    CsgClipWorkBounds& outWork
){
    const BinaryByteView parameterBytes(reinterpret_cast<const u8*>(&parameters), sizeof(parameters));
    return ResolveCsgClipWorkBounds(registry, shape, MatrixTranslation(tx, ty, tz), parameterBytes, receiver, outWork);
}

FOUNDATION_INLINE void ExpandSuitePerspectiveWorldBounds(
    CsgFrameWorkRegion& region,
    const SIMDVectorSingle minBounds,
    const SIMDVectorSingle maxBounds,
    const u32 width,
    const u32 height
){
    region.expandWorldBounds(MatrixPerspectiveFovLH(s_PIDIV2, 1.0f, 0.1f, 100.0f), minBounds, maxBounds, width, height);
}

[[nodiscard]] FOUNDATION_INLINE b8 ResolveSuiteCsgEmptyWorkBounds(
    const CsgShapeRegistry& registry,
    const CsgShapeTypeInfo& shape,
    const SIMDMatrix& shapeToWorld,
    const CsgClipWorkBounds& receiver,
    CsgClipWorkBounds& outWork
){
    return ResolveCsgClipWorkBounds(registry, shape, shapeToWorld, BinaryByteView{}, receiver, outWork);
}


