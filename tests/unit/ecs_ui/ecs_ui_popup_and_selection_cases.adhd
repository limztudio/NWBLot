    EXPECT_FALSE(self.m_clipboard.complete(paste, "later"));
    ASSERT_TRUE(CommitEcsUiPopupFrame(self));
    ASSERT_EQ(self.m_context.input().popupCount(), 1u);
    EXPECT_EQ(self.m_context.input().focus(), self.m_popupWidget.id);
    ASSERT_TRUE(NestedFrameEcsUiPopup(self));
    EXPECT_EQ(self.m_textInput.surroundingText(), "popup");
}

