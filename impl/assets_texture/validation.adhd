////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_texture/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u32 NextTextureMipExtent(in u32 extent){
    if(extent > 1u)
        return extent >> 1u;
    return 1u;
}

b8 IsValidTexturePayloadFormatCode(in u8 payloadFormat){
    return payloadFormat <= 1u;
}

b8 IsValidTextureDimensionCode(in u8 dimension){
    return dimension <= 2u;
}

b8 IsValidTextureResolutionCode(in u8 dimension, in u32 width, in u32 height, in u32 depth){
    if(!IsValidTextureDimensionCode(dimension) || width == 0u || height == 0u || depth == 0u)
        return false;
    if(dimension != 2u && depth != 1u)
        return false;
    if(dimension == 1u && width != height)
        return false;
    return true;
}

Expected<u32> TryComputeCompleteTextureMipCount(in u8 dimension, in u32 width, in u32 height, in u32 depth){
    if(!IsValidTextureDimensionCode(dimension) || width == 0u || height == 0u || depth == 0u)
        return makeUnexpected(Failure());

    u32 mipCount = 0u;
    u32 mipWidth = width;
    u32 mipHeight = height;
    u32 mipDepth = depth;
    while(true){
        ++mipCount;
        if(mipWidth == 1u && mipHeight == 1u && (dimension != 2u || mipDepth == 1u))
            return mipCount;

        mipWidth = NextTextureMipExtent(mipWidth);
        mipHeight = NextTextureMipExtent(mipHeight);
        if(dimension == 2u)
            mipDepth = NextTextureMipExtent(mipDepth);
    }
}

Expected<u32> TryComputeTextureMipSliceCount(in u8 dimension, in u32 mipDepth){
    if(dimension == 0u)
        return 1u;
    if(dimension == 1u)
        return 6u;
    if(dimension == 2u && mipDepth > 0u)
        return mipDepth;
    return makeUnexpected(Failure());
}

class TextureMipPlaneBlockLayoutData{
    public u32 blocksX = 0u;
    public u32 blocksY = 0u;
    public u64 planeByteCount = 0u;
}

Expected<TextureMipPlaneBlockLayoutData> TryComputeTextureMipPlaneBlockLayout(in u8 payloadFormat, in u32 width, in u32 height){
    if(!IsValidTexturePayloadFormatCode(payloadFormat) || width == 0u || height == 0u)
        return makeUnexpected(Failure());

    const u64 blocksX64 = divideUp(cast<u64>(width), cast<u64>(4u));
    const u64 blocksY64 = divideUp(cast<u64>(height), cast<u64>(4u));
    const u64 blockCount = blocksX64 * blocksY64;
    if(blockCount > u64.max / s_TextureUastcBytesPerBlock)
        return makeUnexpected(Failure());

    TextureMipPlaneBlockLayoutData layout;
    layout.blocksX = cast<u32>(blocksX64);
    layout.blocksY = cast<u32>(blocksY64);
    layout.planeByteCount = blockCount * s_TextureUastcBytesPerBlock;
    return layout;
}

Expected<u64> ValidateTextureAssetMipLevels(
    in Span<TextureMipLevel> mipLevels,
    in u8 payloadFormat,
    in u8 dimension,
    in u32 width,
    in u32 height,
    in u32 depth,
    in StringView failureContext
){
    const Expected<u32> mipCountResult = TryComputeCompleteTextureMipCount(dimension, width, height, depth);
    if(!mipCountResult.has_value()){
        error("{} failed: base resolution is invalid", failureContext);
        return makeUnexpected(Failure());
    }
    if(mipLevels.size() != cast<usize>(mipCountResult.value())){
        error("{} failed: mip count does not describe a complete chain", failureContext);
        return makeUnexpected(Failure());
    }

    u32 expectedWidth = width;
    u32 expectedHeight = height;
    u32 expectedDepth = depth;
    u64 expectedOffsetBytes = 0u;
    for(usize mipIndex = 0u; mipIndex < mipLevels.size(); ++mipIndex){
        const u32 mipIndexU32 = cast<u32>(mipIndex);
        const TextureMipLevel mip = mipLevels[mipIndex];
        const Expected<TextureMipPlaneBlockLayoutData> planeLayoutResult = TryComputeTextureMipPlaneBlockLayout(payloadFormat, expectedWidth, expectedHeight);
        if(!planeLayoutResult.has_value()){
            error("{} failed: mip {} block layout exceeds runtime limits", failureContext, mipIndexU32);
            return makeUnexpected(Failure());
        }
        const Expected<u32> sliceCountResult = TryComputeTextureMipSliceCount(dimension, expectedDepth);
        if(!sliceCountResult.has_value()){
            error("{} failed: mip {} slice count is invalid", failureContext, mipIndexU32);
            return makeUnexpected(Failure());
        }
        if(planeLayoutResult.value().planeByteCount > u64.max / cast<u64>(sliceCountResult.value())){
            error("{} failed: mip {} byte size overflows", failureContext, mipIndexU32);
            return makeUnexpected(Failure());
        }
        const u64 expectedSizeBytes = planeLayoutResult.value().planeByteCount * cast<u64>(sliceCountResult.value());

        if(mip.width != expectedWidth || mip.height != expectedHeight){
            error("{} failed: mip {} resolution is not a complete chain", failureContext, mipIndexU32);
            return makeUnexpected(Failure());
        }
        if(mip.blockCountX != planeLayoutResult.value().blocksX || mip.blockCountY != planeLayoutResult.value().blocksY){
            error("{} failed: mip {} block grid is invalid", failureContext, mipIndexU32);
            return makeUnexpected(Failure());
        }
        if(mip.sliceCount != sliceCountResult.value()){
            error("{} failed: mip {} slice count is invalid", failureContext, mipIndexU32);
            return makeUnexpected(Failure());
        }
        if(mip.offsetBytes != expectedOffsetBytes || mip.sizeBytes != expectedSizeBytes){
            error("{} failed: mip {} is not a contiguous texture payload", failureContext, mipIndexU32);
            return makeUnexpected(Failure());
        }
        if(expectedSizeBytes > u64.max - expectedOffsetBytes){
            error("{} failed: mip {} byte range overflows", failureContext, mipIndexU32);
            return makeUnexpected(Failure());
        }

        expectedOffsetBytes += expectedSizeBytes;
        expectedWidth = NextTextureMipExtent(expectedWidth);
        expectedHeight = NextTextureMipExtent(expectedHeight);
        if(dimension == 2u)
            expectedDepth = NextTextureMipExtent(expectedDepth);
    }

    return expectedOffsetBytes;
}

b8 ValidateTextureAssetPayload(
    in Name virtualPath,
    in u8 payloadFormat,
    in u8 dimension,
    in u32 width,
    in u32 height,
    in u32 depth,
    in u8 alphaMode,
    in u8 alphaConstantUnorm8,
    in Span<TextureMipLevel> mipLevels,
    in Span<u8> payloadBytes
){
    if(payloadFormat > 1u){
        error("Texture::validatePayload failed: texture '{}' has an invalid payload format", virtualPath.resolvedText());
        return false;
    }
    if(dimension > 2u){
        error("Texture::validatePayload failed: texture '{}' has an invalid dimension", virtualPath.resolvedText());
        return false;
    }
    if(width == 0u || height == 0u || depth == 0u){
        error("Texture::validatePayload failed: texture '{}' has an empty resolution", virtualPath.resolvedText());
        return false;
    }
    if(dimension != 2u && depth != 1u){
        error("Texture::validatePayload failed: non-volume texture '{}' has an invalid depth", virtualPath.resolvedText());
        return false;
    }
    if(dimension == 1u && width != height){
        error("Texture::validatePayload failed: cubemap texture '{}' must have square faces", virtualPath.resolvedText());
        return false;
    }
    if(mipLevels.empty() || payloadBytes.empty()){
        error("Texture::validatePayload failed: texture '{}' has an incomplete payload", virtualPath.resolvedText());
        return false;
    }
    if(alphaMode > 3u){
        error("Texture::validatePayload failed: texture '{}' has an invalid alpha mode", virtualPath.resolvedText());
        return false;
    }
    if(alphaMode == 2u && alphaConstantUnorm8 >= 255u){
        error("Texture::validatePayload failed: texture '{}' constant alpha must be below opaque alpha", virtualPath.resolvedText());
        return false;
    }
    if(alphaMode != 2u && alphaConstantUnorm8 != 255u){
        error("Texture::validatePayload failed: texture '{}' has an unexpected alpha constant", virtualPath.resolvedText());
        return false;
    }
    b8 validAlphaTransport = alphaMode != 1u;
    if(payloadFormat == 0u)
        validAlphaTransport = alphaMode == 0u || alphaMode == 1u;
    if(!validAlphaTransport){
        error("Texture::validatePayload failed: texture '{}' has an invalid alpha transport for its payload format", virtualPath.resolvedText());
        return false;
    }

    const Expected<u64> primaryPayloadByteCountResult = ValidateTextureAssetMipLevels(
        mipLevels,
        payloadFormat,
        dimension,
        width,
        height,
        depth,
        "Texture::validatePayload"
    );
    if(!primaryPayloadByteCountResult.has_value())
        return false;
    const u64 primaryPayloadByteCount = primaryPayloadByteCountResult.value();

    u64 expectedPayloadByteCount = primaryPayloadByteCount;
    if(alphaMode == 3u){
        if(primaryPayloadByteCount > u64.max - primaryPayloadByteCount){
            error("Texture::validatePayload failed: texture '{}' alpha payload size overflows", virtualPath.resolvedText());
            return false;
        }
        expectedPayloadByteCount = primaryPayloadByteCount + primaryPayloadByteCount;
    }
    if(expectedPayloadByteCount != cast<u64>(payloadBytes.size())){
        error("Texture::validatePayload failed: texture '{}' byte count does not match its payload transport", virtualPath.resolvedText());
        return false;
    }
    return true;
}

b8 BuildTextureCookMipLevels(
    in u8 payloadFormat,
    in u8 dimension,
    in u32 width,
    in u32 height,
    in u32 depth,
    in u8 alphaMode,
    in usize payloadByteSize,
    mut Vector<TextureMipLevel> outLevels
){
    if(!IsValidTexturePayloadFormatCode(payloadFormat) || !IsValidTextureResolutionCode(dimension, width, height, depth)){
        error("Texture cook: invalid texture format or resolution.");
        return false;
    }

    const Expected<u32> completeMipCount = TryComputeCompleteTextureMipCount(dimension, width, height, depth);
    if(!completeMipCount.has_value()){
        error("Texture cook: resolution cannot describe a complete mip chain.");
        return false;
    }

    outLevels.clear();
    outLevels.reserve(cast<usize>(completeMipCount.value()));
    u32 mipWidth = width;
    u32 mipHeight = height;
    u32 mipDepth = depth;
    u64 offsetBytes = 0u;
    for(u32 mipIndex = 0u; mipIndex < completeMipCount.value(); ++mipIndex){
        const Expected<TextureMipPlaneBlockLayoutData> planeLayout = TryComputeTextureMipPlaneBlockLayout(payloadFormat, mipWidth, mipHeight);
        if(!planeLayout.has_value()){
            error("Texture cook: mip {} block layout exceeds supported limits.", mipIndex);
            return false;
        }
        const Expected<u32> sliceCount = TryComputeTextureMipSliceCount(dimension, mipDepth);
        if(!sliceCount.has_value()){
            error("Texture cook: mip {} block layout exceeds supported limits.", mipIndex);
            return false;
        }
        if(planeLayout.value().planeByteCount > u64.max / cast<u64>(sliceCount.value())){
            error("Texture cook: mip {} block layout exceeds supported limits.", mipIndex);
            return false;
        }
        const u64 sizeBytes = planeLayout.value().planeByteCount * cast<u64>(sliceCount.value());
        if(sizeBytes > u64.max - offsetBytes){
            error("Texture cook: mip byte offsets overflow.");
            return false;
        }

        TextureMipLevel level;
        level.offsetBytes = offsetBytes;
        level.sizeBytes = sizeBytes;
        level.width = mipWidth;
        level.height = mipHeight;
        level.blockCountX = planeLayout.value().blocksX;
        level.blockCountY = planeLayout.value().blocksY;
        level.sliceCount = sliceCount.value();
        outLevels.push_back(level);

        offsetBytes += sizeBytes;
        mipWidth = NextTextureMipExtent(mipWidth);
        mipHeight = NextTextureMipExtent(mipHeight);
        if(dimension == 2u)
            mipDepth = NextTextureMipExtent(mipDepth);
    }

    const TextureMipLevel lastMip = outLevels.back();
    const u64 primaryByteCount = lastMip.offsetBytes + lastMip.sizeBytes;
    u64 expectedBytes = primaryByteCount;
    if(alphaMode > 3u){
        error("Texture cook: separate alpha byte count overflows.");
        return false;
    }
    if(alphaMode == 3u){
        if(primaryByteCount > u64.max - primaryByteCount){
            error("Texture cook: separate alpha byte count overflows.");
            return false;
        }
        expectedBytes = primaryByteCount + primaryByteCount;
    }
    if(expectedBytes != cast<u64>(payloadByteSize)){
        error("Texture cook: raw texture byte count does not match the declared mip and alpha layout.");
        return false;
    }
    return true;
}

b8 ReadTextureMipLevelsAndPayloadBytes(
    in Span<u8> binary,
    in u32 headerVersion,
    in u32 headerDimension,
    in u32 headerDepth,
    in u32 headerMipCount,
    in u32 headerAlphaInfo,
    in u32 headerPayloadFormat,
    in u64 headerPayloadByteCount,
    mut usize inOutCursor,
    mut u8 outDimension,
    mut u8 outPayloadFormat,
    mut u8 outAlphaMode,
    mut u8 outAlphaConstantUnorm8,
    mut Vector<TextureMipLevel> outMipLevels,
    mut Vector<u8> outPayloadBytes
){
    if(headerVersion != s_TextureBinaryVersion){
        error("Texture::loadBinary failed: unsupported texture payload version; recook required");
        return false;
    }
    if((headerAlphaInfo & s_TextureAlphaInfoReservedMask) != 0u || headerPayloadFormat > cast<u32>(u8.max)){
        error("Texture::loadBinary failed: invalid texture payload flags");
        return false;
    }

    const u8 payloadFormat = cast<u8>(headerPayloadFormat);
    const u8 alphaMode = cast<u8>(headerAlphaInfo & s_TextureAlphaInfoModeMask);
    const u8 alphaConstantUnorm8 = cast<u8>((headerAlphaInfo & s_TextureAlphaInfoConstantMask) >> s_TextureAlphaInfoConstantShift);
    if(
        headerDimension > cast<u32>(u8.max)
        || !IsValidTextureDimensionCode(cast<u8>(headerDimension))
        || !IsValidTexturePayloadFormatCode(payloadFormat)
        || alphaMode > 3u
        || headerDepth == 0u
    ){
        error("Texture::loadBinary failed: invalid texture payload dimensions");
        return false;
    }
    if(headerMipCount == 0u || headerPayloadByteCount > cast<u64>(usize.max)){
        error("Texture::loadBinary failed: texture payload counts exceed runtime limits");
        return false;
    }

    if(cast<u64>(headerMipCount) > cast<u64>(usize.max / s_TextureMipLevelBinaryBytes)){
        error("Texture::loadBinary failed: mip payload byte size overflows");
        return false;
    }
    const usize mipByteCount = cast<usize>(headerMipCount) * s_TextureMipLevelBinaryBytes;
    if(!CanReadBytes(binary, inOutCursor, mipByteCount)){
        error("Texture::loadBinary failed: malformed mip levels payload");
        return false;
    }

    const usize payloadByteCount = cast<usize>(headerPayloadByteCount);
    if(!CanReadBytes(binary, inOutCursor + mipByteCount, payloadByteCount)){
        error("Texture::loadBinary failed: texture payload is truncated");
        return false;
    }

    if(!CanStoreValueCount(outMipLevels, cast<usize>(headerMipCount))){
        error("Texture::loadBinary failed: mip count exceeds runtime container limits");
        return false;
    }
    outMipLevels.clear();
    outMipLevels.reserve(cast<usize>(headerMipCount));
    for(u32 mipIndex = 0u; mipIndex < headerMipCount; ++mipIndex){
        const Expected<u32> mipWidth = ReadPOD<u32>(binary, inOutCursor);
        const Expected<u32> mipHeight = ReadPOD<u32>(binary, inOutCursor);
        const Expected<u32> mipSliceCount = ReadPOD<u32>(binary, inOutCursor);
        const Expected<u32> mipBlockCountX = ReadPOD<u32>(binary, inOutCursor);
        const Expected<u32> mipBlockCountY = ReadPOD<u32>(binary, inOutCursor);
        const Expected<u32> mipReserved = ReadPOD<u32>(binary, inOutCursor);
        const Expected<u64> mipOffsetBytes = ReadPOD<u64>(binary, inOutCursor);
        const Expected<u64> mipSizeBytes = ReadPOD<u64>(binary, inOutCursor);
        if(
            !mipWidth.has_value()
            || !mipHeight.has_value()
            || !mipSliceCount.has_value()
            || !mipBlockCountX.has_value()
            || !mipBlockCountY.has_value()
            || !mipReserved.has_value()
            || !mipOffsetBytes.has_value()
            || !mipSizeBytes.has_value()
        ){
            error("Texture::loadBinary failed: malformed mip level {}", mipIndex);
            return false;
        }
        if(mipReserved.value() != 0u){
            error("Texture::loadBinary failed: invalid texture mip payload flags");
            return false;
        }

        TextureMipLevel level;
        level.offsetBytes = mipOffsetBytes.value();
        level.sizeBytes = mipSizeBytes.value();
        level.width = mipWidth.value();
        level.height = mipHeight.value();
        level.blockCountX = mipBlockCountX.value();
        level.blockCountY = mipBlockCountY.value();
        level.sliceCount = mipSliceCount.value();
        outMipLevels.push_back(level);
    }

    outPayloadBytes.clear();
    outPayloadBytes.resize(payloadByteCount);
    for(usize i = 0u; i < payloadByteCount; ++i)
        outPayloadBytes[i] = binary[inOutCursor + i];
    inOutCursor += payloadByteCount;

    outDimension = cast<u8>(headerDimension);
    outPayloadFormat = payloadFormat;
    outAlphaMode = alphaMode;
    outAlphaConstantUnorm8 = alphaConstantUnorm8;
    return true;
}

b8 SerializeTextureBinaryPayload(
    in u8 dimension,
    in u32 width,
    in u32 height,
    in u32 depth,
    in u8 alphaMode,
    in u8 alphaConstantUnorm8,
    in u8 payloadFormat,
    in Span<TextureMipLevel> mipLevels,
    in Span<u8> payloadBytes,
    mut Vector<u8> outBinary
){
    if(mipLevels.size() > cast<usize>(u32.max)){
        error("TextureAssetCodec::serialize failed: mip count exceeds cooked payload limits");
        return false;
    }

    usize reserveBytes = s_TextureHeaderBinaryBytes;
    if(!AddBinaryRepeatedReserveBytes(reserveBytes, mipLevels.size(), s_TextureMipLevelBinaryBytes) || !AddBinaryReserveBytes(reserveBytes, payloadBytes.size())){
        error("TextureAssetCodec::serialize failed: cooked payload size overflows");
        return false;
    }

    outBinary.clear();
    outBinary.reserve(reserveBytes);

    const u32 alphaInfo = cast<u32>(alphaMode) | (cast<u32>(alphaConstantUnorm8) << s_TextureAlphaInfoConstantShift);
    AppendPOD(outBinary, s_TextureBinaryMagic);
    AppendPOD(outBinary, s_TextureBinaryVersion);
    AppendPOD(outBinary, cast<u32>(dimension));
    AppendPOD(outBinary, width);
    AppendPOD(outBinary, height);
    AppendPOD(outBinary, depth);
    AppendPOD(outBinary, cast<u32>(mipLevels.size()));
    AppendPOD(outBinary, alphaInfo);
    AppendPOD(outBinary, cast<u32>(payloadFormat));
    AppendPOD(outBinary, cast<u64>(payloadBytes.size()));

    for(in TextureMipLevel mip : mipLevels){
        AppendPOD(outBinary, mip.width);
        AppendPOD(outBinary, mip.height);
        AppendPOD(outBinary, mip.sliceCount);
        AppendPOD(outBinary, mip.blockCountX);
        AppendPOD(outBinary, mip.blockCountY);
        AppendPOD(outBinary, 0u);
        AppendPOD(outBinary, mip.offsetBytes);
        AppendPOD(outBinary, mip.sizeBytes);
    }

    for(in u8 byteValue : payloadBytes)
        outBinary.push_back(byteValue);
    return true;
}

b8 DeserializeTextureBinaryPayload(
    in Span<u8> binary,
    mut u32 outWidth,
    mut u32 outHeight,
    mut u32 outDepth,
    mut u8 outDimension,
    mut u8 outPayloadFormat,
    mut u8 outAlphaMode,
    mut u8 outAlphaConstantUnorm8,
    mut Vector<TextureMipLevel> outMipLevels,
    mut Vector<u8> outPayloadBytes
){
    usize cursor = 0u;
    if(!CanReadBytes(binary, cursor, s_TextureHeaderBinaryBytes)){
        error("Texture::loadBinary failed: malformed header");
        return false;
    }
    const Expected<u32> magic = ReadPOD<u32>(binary, cursor);
    const Expected<u32> version = ReadPOD<u32>(binary, cursor);
    const Expected<u32> dimension = ReadPOD<u32>(binary, cursor);
    const Expected<u32> width = ReadPOD<u32>(binary, cursor);
    const Expected<u32> height = ReadPOD<u32>(binary, cursor);
    const Expected<u32> depth = ReadPOD<u32>(binary, cursor);
    const Expected<u32> mipCount = ReadPOD<u32>(binary, cursor);
    const Expected<u32> alphaInfo = ReadPOD<u32>(binary, cursor);
    const Expected<u32> payloadFormat = ReadPOD<u32>(binary, cursor);
    const Expected<u64> payloadByteCount = ReadPOD<u64>(binary, cursor);
    if(
        !magic.has_value()
        || !version.has_value()
        || !dimension.has_value()
        || !width.has_value()
        || !height.has_value()
        || !depth.has_value()
        || !mipCount.has_value()
        || !alphaInfo.has_value()
        || !payloadFormat.has_value()
        || !payloadByteCount.has_value()
    ){
        error("Texture::loadBinary failed: malformed header");
        return false;
    }
    if(magic.value() != s_TextureBinaryMagic){
        error("Texture::loadBinary failed: invalid texture asset format; recook required");
        return false;
    }
    if(!ReadTextureMipLevelsAndPayloadBytes(
        binary,
        version.value(),
        dimension.value(),
        depth.value(),
        mipCount.value(),
        alphaInfo.value(),
        payloadFormat.value(),
        payloadByteCount.value(),
        cursor,
        outDimension,
        outPayloadFormat,
        outAlphaMode,
        outAlphaConstantUnorm8,
        outMipLevels,
        outPayloadBytes
    ))
        return false;
    if(cursor != binary.size()){
        error("Texture::loadBinary failed: trailing bytes detected");
        return false;
    }
    outWidth = width.value();
    outHeight = height.value();
    outDepth = depth.value();
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
