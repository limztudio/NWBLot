void VerifyUiMultilineText_AcceptsEmptyAndCanonicalLfLinesWithoutChangingBytes(){
    UiMultilineTextArena arena = UiMultilineTextArena();
    Array<StringView, 5u> cases = Array<StringView, 5u>();
    cases[0u] = "";
    cases[1u] = "\n";
    cases[2u] = "\n\n";
    cases[3u] = "\nfirst\n";
    cases[4u] = "first\n\nlast\n";
    for(in StringView text : cases){
        const ScopedTestTrace trace = ScopedTestTrace(text);
        EXPECT_TRUE(ValidateMultilineText(text));
        const auto normalized = NormalizeMultilineText(arena.arena, text, text.size());
        ASSERT_TRUE(normalized.has_value());
        const StringView outputView = StringView(normalized.value().data(), normalized.value().size());
        EXPECT_EQ(outputView, text);
        EXPECT_TRUE(ValidateMultilineText(outputView));
    }
}

void VerifyUiMultilineText_ControlsAndPrintableAsciiBoundariesRespectCanonicalLfAndNormalization(){
    UiMultilineTextArena arena = UiMultilineTextArena();
    for(u32 scalar = 0u; scalar < s_UiMultilineTextUtf8OneByteMaxExclusive; ++scalar){
        if(scalar > s_UiMultilineTextUnicodeSpace && scalar < s_UiMultilineTextAsciiTilde)
            continue;
        const ScopedTestTrace trace = ScopedTestTrace(scalar);
        const UiMultilineTextAsciiSandwich bytes = MakeUiMultilineTextAsciiSandwich(scalar);
        const StringView text = bytes.view();
        const b8 canonical = scalar == s_UiMultilineTextUnicodeLineFeed || (scalar >= s_UiMultilineTextUnicodeSpace && scalar < s_UiMultilineTextUnicodeDelete);
        EXPECT_EQ(ValidateMultilineText(text), canonical);
        const b8 normalizable = canonical || scalar == s_UiMultilineTextUnicodeTab || scalar == s_UiMultilineTextUnicodeCarriageReturn;
        auto normalized = NormalizeMultilineText(arena.arena, text, 3u);
        EXPECT_EQ(normalized.has_value(), normalizable);
        if(normalizable){
            ASSERT_TRUE(normalized.has_value());
            UiMultilineTextGlobalString output = UiMultilineTextGlobalString(arena.arena);
            UiMultilineTextTakeNormalized(output, normalized);
            u32 replacement = scalar;
            if(scalar == s_UiMultilineTextUnicodeTab)
                replacement = s_UiMultilineTextUnicodeSpace;
            else if(scalar == s_UiMultilineTextUnicodeCarriageReturn)
                replacement = s_UiMultilineTextUnicodeLineFeed;
            const UiMultilineTextAsciiSandwich expected = MakeUiMultilineTextAsciiSandwich(replacement);
            const StringView outputView = StringView(output.data(), output.size());
            EXPECT_EQ(outputView, expected.view());
            EXPECT_TRUE(ValidateMultilineText(outputView));
        }
        else{
            ASSERT_FALSE(normalized.has_value());
            EXPECT_EQ(normalized.error(), EditTextStatus::InvalidText);
        }
    }
}

void VerifyUiMultilineText_RejectsEveryC1ControlExceptNelDuringNormalization(){
    UiMultilineTextArena arena = UiMultilineTextArena();
    for(u32 scalar = s_UiMultilineTextUtf8OneByteMaxExclusive; scalar <= s_UiMultilineTextUnicodeC1Last; ++scalar){
        const ScopedTestTrace trace = ScopedTestTrace(scalar);
        const UiMultilineTextC1Sandwich bytes = MakeUiMultilineTextC1Sandwich(s_UiMultilineTextUtf8C1LeadByte, scalar);
        const StringView text = bytes.view();
        EXPECT_FALSE(ValidateMultilineText(text));
        if(scalar == s_UiMultilineTextUnicodeNextLine){
            const auto normalized = NormalizeMultilineText(arena.arena, text, 4u);
            ASSERT_TRUE(normalized.has_value());
            EXPECT_EQ(normalized.value(), "a\nb");
        }
        else{
            ExpectUiMultilineTextNormalizedError(arena.arena, text, 4u, EditTextStatus::InvalidText);
        }
    }
}

void VerifyUiMultilineText_RequiresNormalizationForTabsAndEveryNoncanonicalLineSeparator(){
    Array<UiMultilineTextExpectationCase, 6u> cases = Array<UiMultilineTextExpectationCase, 6u>();
    cases[0u] = UiMultilineTextExpectationCase("\t", " ");
    cases[1u] = UiMultilineTextExpectationCase("\r", "\n");
    cases[2u] = UiMultilineTextExpectationCase("\r\n", "\n");
    cases[3u] = UiMultilineTextExpectationCase(s_UiMultilineTextNextLine, "\n");
    cases[4u] = UiMultilineTextExpectationCase(s_UiMultilineTextLineSeparator, "\n");
    cases[5u] = UiMultilineTextExpectationCase(s_UiMultilineTextParagraphSeparator, "\n");
    UiMultilineTextArena arena = UiMultilineTextArena();
    for(in UiMultilineTextExpectationCase test : cases){
        const ScopedTestTrace trace = ScopedTestTrace(test.source);
        EXPECT_FALSE(ValidateMultilineText(test.source));
        const auto normalized = NormalizeMultilineText(arena.arena, test.source, 1u);
        ASSERT_TRUE(normalized.has_value());
        const StringView outputView = StringView(normalized.value().data(), normalized.value().size());
        EXPECT_EQ(outputView, test.expected);
        EXPECT_TRUE(ValidateMultilineText(outputView));
    }
}

void VerifyUiMultilineText_PreservesConsecutiveLeadingAndTrailingLinesWhileNormalizingBreaks(){
    Array<UiMultilineTextExpectationCase, 7u> cases = Array<UiMultilineTextExpectationCase, 7u>();
    cases[0u] = UiMultilineTextExpectationCase("\r\r\n", "\n\n");
    cases[1u] = UiMultilineTextExpectationCase("\r\n\r", "\n\n");
    cases[2u] = UiMultilineTextExpectationCase("\n\r\n", "\n\n");
    cases[3u] = UiMultilineTextExpectationCase("\r\n\r\n", "\n\n");
    cases[4u] = UiMultilineTextExpectationCase("\r\nfirst\r\n\r\nlast\r", "\nfirst\n\nlast\n");
    cases[5u] = UiMultilineTextExpectationCase("\xC2\x85\xE2\x80\xA8\xE2\x80\xA9", "\n\n\n");
    cases[6u] = UiMultilineTextExpectationCase("last\r\n", "last\n");
    UiMultilineTextArena arena = UiMultilineTextArena();
    UiMultilineTextGlobalString output = UiMultilineTextGlobalString(arena.arena);
    for(in UiMultilineTextExpectationCase test : cases){
        const ScopedTestTrace trace = ScopedTestTrace(test.source);
        auto normalized = NormalizeMultilineText(arena.arena, test.source, test.expected.size());
        ASSERT_TRUE(normalized.has_value());
        UiMultilineTextTakeNormalized(output, normalized);
        const StringView outputView = StringView(output.data(), output.size());
        EXPECT_EQ(outputView, test.expected);
        EXPECT_TRUE(ValidateMultilineText(outputView));
    }
}

void VerifyUiMultilineText_UnicodeScalarAndSeparatorAdjacentBoundariesPreserveExactBytes(){
    Array<StringView, 12u> cases = Array<StringView, 12u>();
    cases[0u] = "\xC2\xA0";
    cases[1u] = "\xDF\xBF";
    cases[2u] = "\xE0\xA0\x80";
    cases[3u] = "\xED\x9F\xBF";
    cases[4u] = "\xEE\x80\x80";
    cases[5u] = "\xEF\xBF\xBF";
    cases[6u] = "\xF0\x90\x80\x80";
    cases[7u] = "\xF4\x8F\xBF\xBF";
    cases[8u] = "\xE2\x80\xA7";
    cases[9u] = "\xE2\x80\xAA";
    cases[10u] = "\xE2\x80\x8B";
    cases[11u] = "\xE2\x80\x8D";
    UiMultilineTextArena arena = UiMultilineTextArena();
    UiMultilineTextGlobalString output = UiMultilineTextGlobalString(arena.arena);
    for(in StringView text : cases){
        const ScopedTestTrace trace = ScopedTestTrace(text);
