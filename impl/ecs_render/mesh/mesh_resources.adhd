////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererMeshSystem;
struct MeshResources;

class MeshDescriptorTransaction final : NoCopy{
public:
    MeshDescriptorTransaction(RendererMeshSystem& meshSystem, MeshResources& mesh)noexcept;
    ~MeshDescriptorTransaction()noexcept(false);


public:
    void release()noexcept{ m_active = false; }


private:
    RendererMeshSystem& m_meshSystem;
    MeshResources& m_mesh;
    b8 m_active = true;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class RendererMeshSystem;

class RuntimeMeshResourceCache final : NoCopy{
public:
    explicit RuntimeMeshResourceCache(RendererMeshSystem& system)noexcept : m_system(system){}


public:
    [[nodiscard]] Expected<NotNull<MeshResources*>> create(const RuntimeMeshDesc& desc);
    [[nodiscard]] Expected<NotNull<MeshResources*>> find(const RuntimeMeshDesc& desc)noexcept;


private:
    RendererMeshSystem& m_system;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 RendererMeshSystem::prepareComputeEmulationResources(MeshResources& mesh){
    return MeshEmulationResources{}.prepare(m_graphics, mesh);
}

b8 RendererMeshSystem::prepareMeshFrameBindings(const ECSRenderDetail::MaterialPassBufferSnapshot& materialBuffers){
    return m_meshState.m_frameBindings.prepare(m_graphics, materialBuffers, m_meshState.m_meshViewBuffer);
}

ECSRenderDetail::MeshFrameBindingSnapshot RendererMeshSystem::meshFrameBindingSnapshot()const noexcept{
    return m_meshState.m_frameBindings.snapshot(m_meshState.m_meshViewBuffer);
}

void RendererMeshSystem::populateMeshGeometryHeapSlots(const MeshResources& mesh, InstanceGpuData& outInstance)const noexcept{
    NWB_ASSERT(GeometryHeapHandlesReady(mesh.geometryHeapHandles));
    for(u32 slotIndex = 0u; slotIndex < NWB_MESH_INSTANCE_GEOMETRY_SLOT_COUNT; ++slotIndex)
        outInstance.geometryHeapSlots[slotIndex] = 0u;
    ForEachMeshSourceBindingSlot([&](const u32 bindingSlot, const b8)noexcept{
        outInstance.geometryHeapSlots[bindingSlot] = mesh.geometryHeapHandles[bindingSlot].slot();
    });
}

void RendererMeshSystem::releaseMeshGeometryHeapHandles(MeshResources& mesh){
    auto& device = m_graphics.getDevice();
    Core::GpuDescriptorHeap& heap = device.getDescriptorHeap();
    if(heap.isInitialized()){
        for(Core::GpuDescriptorHandle& handle : mesh.geometryHeapHandles){
            if(handle.valid())
                heap.free(handle);
            handle = Core::GpuDescriptorHandle::Invalid();
        }
        if(mesh.swBvhPositionHeapHandle.valid())
            heap.free(mesh.swBvhPositionHeapHandle);
        if(mesh.swBvhTriangleIndexHeapHandle.valid())
            heap.free(mesh.swBvhTriangleIndexHeapHandle);
        if(mesh.swBvhNodeHeapHandle.valid())
            heap.free(mesh.swBvhNodeHeapHandle);
        if(mesh.swBvhParentHeapHandle.valid())
            heap.free(mesh.swBvhParentHeapHandle);
        if(mesh.emulationVertexHeapHandle.valid())
            heap.free(mesh.emulationVertexHeapHandle);
        if(mesh.runtimeLocalBoundsHeapHandle.valid())
            heap.free(mesh.runtimeLocalBoundsHeapHandle);
        if(mesh.runtimeMeshletLocalBoundsHeapHandle.valid())
            heap.free(mesh.runtimeMeshletLocalBoundsHeapHandle);
        if(mesh.objectGeometryCache.heapHandle.valid())
            heap.free(mesh.objectGeometryCache.heapHandle);
        mesh.swBvhPositionHeapHandle = Core::GpuDescriptorHandle::Invalid();
        mesh.swBvhTriangleIndexHeapHandle = Core::GpuDescriptorHandle::Invalid();
        mesh.swBvhNodeHeapHandle = Core::GpuDescriptorHandle::Invalid();
        mesh.swBvhParentHeapHandle = Core::GpuDescriptorHandle::Invalid();
        mesh.emulationVertexHeapHandle = Core::GpuDescriptorHandle::Invalid();
        mesh.runtimeLocalBoundsHeapHandle = Core::GpuDescriptorHandle::Invalid();
        mesh.runtimeMeshletLocalBoundsHeapHandle = Core::GpuDescriptorHandle::Invalid();
        mesh.objectGeometryCache.heapHandle = Core::GpuDescriptorHandle::Invalid();
        mesh.objectGeometryCache.acceptedContent = false;
        return;
    }

    for(Core::GpuDescriptorHandle& handle : mesh.geometryHeapHandles)
        handle = Core::GpuDescriptorHandle::Invalid();
    mesh.swBvhPositionHeapHandle = Core::GpuDescriptorHandle::Invalid();
    mesh.swBvhTriangleIndexHeapHandle = Core::GpuDescriptorHandle::Invalid();
    mesh.swBvhNodeHeapHandle = Core::GpuDescriptorHandle::Invalid();
    mesh.swBvhParentHeapHandle = Core::GpuDescriptorHandle::Invalid();
    mesh.emulationVertexHeapHandle = Core::GpuDescriptorHandle::Invalid();
    mesh.runtimeLocalBoundsHeapHandle = Core::GpuDescriptorHandle::Invalid();
    mesh.runtimeMeshletLocalBoundsHeapHandle = Core::GpuDescriptorHandle::Invalid();
    mesh.objectGeometryCache.heapHandle = Core::GpuDescriptorHandle::Invalid();
    mesh.objectGeometryCache.acceptedContent = false;
}

void RendererMeshSystem::releaseMeshFrameHeapHandles(){
    m_meshState.m_frameBindings.release(m_graphics);
}

b8 RendererMeshSystem::createMeshRenderBindings(MeshResources& mesh){
    if(!createMeshGeometryHeapHandles(mesh))
        return false;

    if(mesh.runtimeLocalBoundsBuffer && !mesh.runtimeLocalBoundsHeapHandle.valid()){
        auto& device = m_graphics.getDevice();
        Core::GpuDescriptorHeap& heap = device.getDescriptorHeap();
        const Core::BufferDesc& desc = mesh.runtimeLocalBoundsBuffer->getCreationDescription();
        if(!heap.isInitialized() || desc.byteSize < NWB_RUNTIME_MESH_BOUNDS_BYTE_SIZE || !desc.canHaveRawViews){
            releaseMeshGeometryHeapHandles(mesh);
            NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: runtime local bounds require a complete raw GPU buffer"));
            return false;
        }
        if(!RendererDescriptorRegisterDetail::AssignDescriptor(heap, Core::GpuDescriptorClass::StorageBuffer, Core::DescriptorWriteItem::RawBufferSrv(0u, mesh.runtimeLocalBoundsBuffer.get()), mesh.runtimeLocalBoundsHeapHandle)){
            releaseMeshGeometryHeapHandles(mesh);
            NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: failed to register runtime local bounds"));
            return false;
        }
    }

    if(mesh.runtimeMesh && mesh.runtimeGeometryContentRevision != 0u && mesh.runtimeMeshletLocalBoundsBuffer && !mesh.runtimeMeshletLocalBoundsHeapHandle.valid()){
        Core::GpuDescriptorHeap& heap = m_graphics.getDevice().getDescriptorHeap();
        const Core::BufferDesc& desc = mesh.runtimeMeshletLocalBoundsBuffer->getCreationDescription();
        const u64 requiredBytes = static_cast<u64>(mesh.meshletCount) * NWB_RUNTIME_MESH_BOUNDS_BYTE_SIZE;
        if(!(heap.isInitialized() && requiredBytes != 0u && desc.byteSize >= requiredBytes && desc.canHaveRawViews
            && RendererDescriptorRegisterDetail::AssignDescriptor(heap, Core::GpuDescriptorClass::StorageBuffer, Core::DescriptorWriteItem::RawBufferSrv(0u, mesh.runtimeMeshletLocalBoundsBuffer.get()), mesh.runtimeMeshletLocalBoundsHeapHandle)))
            NWB_LOGGER_WARNING(NWB_TEXT("RendererSystem: mesh '{}' could not register optional meshlet bounds; retaining whole-caster shadows"), ConvertString(mesh.meshName.resolvedText()));
    }

    NWB_ASSERT(meshRenderBindingsReady(mesh));
    return true;
}

b8 RendererMeshSystem::meshRenderBindingsReady(const MeshResources& mesh)const noexcept{
    if(!mesh.valid() || !GeometryHeapHandlesReady(mesh.geometryHeapHandles))
        return false;

    if(mesh.runtimeLocalBoundsBuffer && (!mesh.runtimeLocalBoundsHeapHandle.valid() || mesh.runtimeLocalBoundsHeapHandle.descriptorClass() != Core::GpuDescriptorClass::StorageBuffer))
        return false;

    return true;
}

b8 RendererMeshSystem::createMeshGeometryHeapHandles(MeshResources& mesh){
    if(GeometryHeapHandlesReady(mesh.geometryHeapHandles))
        return true;

    auto& device = m_graphics.getDevice();
    Core::GpuDescriptorHeap& heap = device.getDescriptorHeap();
    if(!heap.isInitialized()){
        NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: mesh '{}' requires the initialized global descriptor heap"), ConvertString(mesh.meshName.resolvedText()));
        return false;
    }

    // A non-empty partial set signals a broken lifetime transition, never a safe merge.
#if defined(NWB_DEBUG)
    for(const Core::GpuDescriptorHandle handle : mesh.geometryHeapHandles)
        NWB_ASSERT(!handle.valid());
#endif

    Array<Core::GpuDescriptorHandle, NWB_MESH_INSTANCE_GEOMETRY_SLOT_COUNT> acquired{};
    Core::GpuDescriptorRetirementGuard retireAcquired(heap, acquired);
    b8 registered = true;
    ForEachMeshSourceBuffer(mesh, [&](const u32 bindingSlot, const Core::BufferHandle& buffer, const b8){
        if(!registered)
            return;
        if(!buffer){
            NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: mesh '{}' has no source buffer at binding {}"), ConvertString(mesh.meshName.resolvedText()), bindingSlot);
            registered = false;
            return;
        }

        if(!RendererDescriptorRegisterDetail::AssignDescriptor(heap, Core::GpuDescriptorClass::StorageBuffer, Core::DescriptorWriteItem::StructuredBufferSrv(0u, buffer.get()), acquired[bindingSlot]))
            registered = false;
    });

    if(!registered)
        return false;

    ForEachMeshSourceBindingSlot([&](const u32 bindingSlot, const b8)noexcept{
        mesh.geometryHeapHandles[bindingSlot] = acquired[bindingSlot];
    });
    retireAcquired.release();
    NWB_ASSERT(GeometryHeapHandlesReady(mesh.geometryHeapHandles));
    return true;
}

b8 RendererMeshSystem::ensureMeshSwBvhInputHeapHandles(MeshResources& mesh){
    return MeshSoftwareBvhBindings{}.ensure(m_graphics, mesh);
}

void RendererMeshSystem::releaseAllMeshGeometryHeapHandles(){
    for(auto it = m_meshState.m_meshes.begin(); it != m_meshState.m_meshes.end(); ++it)
        releaseMeshGeometryHeapHandles(it.value());
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


MeshDescriptorTransaction::MeshDescriptorTransaction(RendererMeshSystem& meshSystem, MeshResources& mesh)noexcept
    : m_meshSystem(meshSystem)
    , m_mesh(mesh)
{}

MeshDescriptorTransaction::~MeshDescriptorTransaction()noexcept(false){
    if(m_active)
        m_meshSystem.releaseMeshGeometryHeapHandles(m_mesh);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 MeshEmulationResources::prepare(Core::GraphicsRuntime& graphics, MeshResources& mesh)const{
    if(mesh.emulationVertexHeapHandle.valid())
        return true;
    if(!mesh.emulationVertexBuffer){
        const Expected<ComputeEmulationLayout> layoutResult = MeshGeometryBufferPolicy().resolveComputeEmulationLayout(mesh.meshletLocalVertexRefBuffer->getDescription().byteSize, mesh.meshletPrimitiveIndexCount);
        if(!layoutResult){
            NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: generated geometry layout exceeds the index byte-address range for mesh '{}'"), ConvertString(mesh.meshName.resolvedText()));
            return false;
        }
        const ComputeEmulationLayout& layout = *layoutResult;
        const auto emulationVertexBufferName = DeriveName(mesh.meshName, AStringView(":emulation_vb"));
        if(!emulationVertexBufferName){
            NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: failed to derive compute-emulation vertex buffer name for mesh '{}'"), ConvertString(mesh.meshName.resolvedText()));
            return false;
        }

        Core::BufferDesc emulationVertexBufferDesc;
        emulationVertexBufferDesc
            .setByteSize(layout.bufferByteSize)
            .setStructStride(s_EmulatedVertexStride)
            .setCanHaveRawViews(true)
            .setCanHaveUAVs(true)
            .setIsVertexBuffer(true)
            .setIsIndexBuffer(true)
            .setQueueSharing(Core::ResourceQueueSharing::GraphicsAndAsyncCompute)
            .setDebugName(*emulationVertexBufferName)
        ;
        auto emulationVertexBufferResult = graphics.createBuffer(emulationVertexBufferDesc);
        if(emulationVertexBufferResult)
            mesh.emulationVertexBuffer = Move(*emulationVertexBufferResult);
        else
            mesh.emulationVertexBuffer.reset();
        if(!emulationVertexBufferResult){
            NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: failed to create compute-emulation vertex buffer for mesh '{}'"), ConvertString(mesh.meshName.resolvedText()));
            return false;
        }
        mesh.emulationIndexByteOffset = layout.indexByteOffset;
    }

    auto& device = graphics.getDevice();
    Core::GpuDescriptorHeap& heap = device.getDescriptorHeap();
    if(!heap.isInitialized()){
        NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: compute-emulation vertex buffer requires the initialized global descriptor heap"));
        return false;
    }
    if(RendererDescriptorRegisterDetail::AssignDescriptor(heap, Core::GpuDescriptorClass::StorageBuffer, Core::DescriptorWriteItem::StructuredBufferUav(0u, mesh.emulationVertexBuffer.get()), mesh.emulationVertexHeapHandle))
        return true;

    NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: failed to register compute-emulation vertex buffer in the descriptor heap for mesh '{}'"), ConvertString(mesh.meshName.resolvedText()));
    return false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 MeshFrameBindings::prepare(Core::GraphicsRuntime& graphics, const ECSRenderDetail::MaterialPassBufferSnapshot& materialBuffers, const Core::BufferHandle& meshViewBuffer){
    if(m_snapshot.matches(materialBuffers, meshViewBuffer))
        return true;

    if(!materialBuffers.valid() || !meshViewBuffer){
        NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: frame heap registration requires instance, typed-material, and view buffers"));
        return false;
    }

    auto& device = graphics.getDevice();
    Core::GpuDescriptorHeap& heap = device.getDescriptorHeap();
    if(!heap.isInitialized()){
        NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: frame heap registration requires the initialized global descriptor heap"));
        return false;
    }
    const Expected<Core::GpuDescriptorHandle> instanceHandleResult = heap.allocate(Core::GpuDescriptorClass::StorageBuffer);
    if(!instanceHandleResult)
        return false;
    const Core::GpuDescriptorHandle instanceHandle = *instanceHandleResult;
    Core::GpuDescriptorRetirementGuard retireInstance(heap, instanceHandle);
    const Expected<Core::GpuDescriptorHandle> materialTypedHandleResult = heap.allocate(Core::GpuDescriptorClass::StorageBuffer);
    if(!materialTypedHandleResult)
        return false;
    const Core::GpuDescriptorHandle materialTypedHandle = *materialTypedHandleResult;
    Core::GpuDescriptorRetirementGuard retireMaterialTyped(heap, materialTypedHandle);
    const Expected<Core::GpuDescriptorHandle> viewHandleResult = heap.allocate(Core::GpuDescriptorClass::UniformBuffer);
    if(!viewHandleResult)
        return false;
    const Core::GpuDescriptorHandle viewHandle = *viewHandleResult;
    Core::GpuDescriptorRetirementGuard retireView(heap, viewHandle);
    const b8 registered =
        heap.write(instanceHandle, Core::DescriptorWriteItem::StructuredBufferSrv(0u, materialBuffers.instanceBuffer.get()))
        && heap.write(materialTypedHandle, Core::DescriptorWriteItem::StructuredBufferSrv(0u, materialBuffers.materialTypedBuffer.get()))
        && heap.write(viewHandle, Core::DescriptorWriteItem::ConstantBuffer(0u, meshViewBuffer.get()))
    ;
    if(!registered)
        return false;

    ECSRenderDetail::MeshFrameBindingSnapshot replacement = {
        .instanceBuffer = materialBuffers.instanceBuffer,
        .materialTypedBuffer = materialBuffers.materialTypedBuffer,
        .meshView = { .buffer = meshViewBuffer, .heapHandle = viewHandle, },
        .instanceHeapHandle = instanceHandle,
        .materialTypedHeapHandle = materialTypedHandle,
        .instanceBufferCapacity = materialBuffers.instanceBufferCapacity,
        .materialTypedBufferCapacity = materialBuffers.materialTypedBufferCapacity,
    };
    ECSRenderDetail::MeshFrameBindingSnapshot retired = Move(m_snapshot);
    m_snapshot = Move(replacement);
    retireInstance.release();
    retireMaterialTyped.release();
    retireView.release();

    // Keep retired buffers alive until descriptors enter deferred-reuse quarantine.
    if(retired.instanceHeapHandle.valid())
        heap.free(retired.instanceHeapHandle);
    if(retired.materialTypedHeapHandle.valid())
        heap.free(retired.materialTypedHeapHandle);
    if(retired.meshView.heapHandle.valid())
        heap.free(retired.meshView.heapHandle);

    NWB_ASSERT(m_snapshot.matches(materialBuffers, meshViewBuffer));
    return true;
}

ECSRenderDetail::MeshFrameBindingSnapshot MeshFrameBindings::snapshot(const Core::BufferHandle& meshViewBuffer)const noexcept{
    const ECSRenderDetail::MeshFrameBindingSnapshot& bindings = m_snapshot;
    return {
        .instanceBuffer = bindings.instanceBuffer,
        .materialTypedBuffer = bindings.materialTypedBuffer,
        .meshView = viewSnapshot(meshViewBuffer),
        .instanceHeapHandle = bindings.instanceHeapHandle,
        .materialTypedHeapHandle = bindings.materialTypedHeapHandle,
        .instanceBufferCapacity = bindings.instanceBufferCapacity,
        .materialTypedBufferCapacity = bindings.materialTypedBufferCapacity,
    };
}

ECSRenderDetail::MeshViewBufferSnapshot MeshFrameBindings::viewSnapshot(const Core::BufferHandle& meshViewBuffer)const noexcept{
    ECSRenderDetail::MeshViewBufferSnapshot snapshot;
    snapshot.buffer = meshViewBuffer;
    if(m_snapshot.meshView.buffer == meshViewBuffer)
        snapshot.heapHandle = m_snapshot.meshView.heapHandle;
    return snapshot;
}

void MeshFrameBindings::release(Core::GraphicsRuntime& graphics){
    auto& device = graphics.getDevice();
    Core::GpuDescriptorHeap& heap = device.getDescriptorHeap();
    if(heap.isInitialized()){
        if(m_snapshot.instanceHeapHandle.valid())
            heap.free(m_snapshot.instanceHeapHandle);
        if(m_snapshot.materialTypedHeapHandle.valid())
            heap.free(m_snapshot.materialTypedHeapHandle);
        if(m_snapshot.meshView.heapHandle.valid())
            heap.free(m_snapshot.meshView.heapHandle);
    }
    m_snapshot = {};
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 MeshSoftwareBvhBindings::ensure(Core::GraphicsRuntime& graphics, MeshResources& mesh)const{
    const auto inputsReady = [&mesh]()noexcept{
        return
            mesh.swBvhPositionHeapHandle.valid()
            && mesh.swBvhPositionHeapHandle.descriptorClass() == Core::GpuDescriptorClass::StorageBuffer
            && mesh.swBvhTriangleIndexHeapHandle.valid()
            && mesh.swBvhTriangleIndexHeapHandle.descriptorClass() == Core::GpuDescriptorClass::StorageBuffer
        ;
    };
    if(inputsReady())
        return true;

    NWB_ASSERT(!mesh.swBvhPositionHeapHandle.valid());
    NWB_ASSERT(!mesh.swBvhTriangleIndexHeapHandle.valid());
    if(!mesh.positionBuffer || !mesh.triangleIndexBuffer){
        NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: mesh '{}' has no software-BVH position or triangle-index input"), ConvertString(mesh.meshName.resolvedText()));
        return false;
    }

    auto& device = graphics.getDevice();
    Core::GpuDescriptorHeap& heap = device.getDescriptorHeap();
    if(!heap.isInitialized()){
        NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: mesh '{}' requires the initialized global descriptor heap for software-BVH inputs"), ConvertString(mesh.meshName.resolvedText()));
        return false;
    }

    const auto registrationFailed = [&mesh](){
        NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: failed to register software-BVH inputs for mesh '{}'"), ConvertString(mesh.meshName.resolvedText()));
        return false;
    };
    const Expected<Core::GpuDescriptorHandle> positionHandleResult = heap.allocate(Core::GpuDescriptorClass::StorageBuffer);
    if(!positionHandleResult)
        return registrationFailed();
    const Core::GpuDescriptorHandle positionHandle = *positionHandleResult;
    Core::GpuDescriptorRetirementGuard retirePosition(heap, positionHandle);
    const Expected<Core::GpuDescriptorHandle> triangleIndexHandleResult = heap.allocate(Core::GpuDescriptorClass::StorageBuffer);
    if(!triangleIndexHandleResult)
        return registrationFailed();
    const Core::GpuDescriptorHandle triangleIndexHandle = *triangleIndexHandleResult;
    Core::GpuDescriptorRetirementGuard retireTriangleIndex(heap, triangleIndexHandle);
    if(!heap.write(positionHandle, Core::DescriptorWriteItem::RawBufferSrv(0u, mesh.positionBuffer.get())) || !heap.write(triangleIndexHandle, Core::DescriptorWriteItem::RawBufferSrv(0u, mesh.triangleIndexBuffer.get())))
        return registrationFailed();

    mesh.swBvhPositionHeapHandle = positionHandle;
    mesh.swBvhTriangleIndexHeapHandle = triangleIndexHandle;
    retirePosition.release();
    retireTriangleIndex.release();
    NWB_ASSERT(inputsReady());
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace ECSRenderDetail{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 AcceptObjectGeometryCacheWrite(MeshResources& mesh, const RuntimeMeshBuffers& sourceBuffers, const ObjectGeometryCacheSnapshot& expected, const b8 runtimeMesh)noexcept{
    ObjectGeometryCacheState& cache = mesh.objectGeometryCache;
    if(!expected.valid() || cache.buffer != expected.buffer)
        return false;
    // Accepted writes establish the retained buffer state even if current source content already moved on.
    return MeshGeometryBufferPolicy().acceptObjectCacheContent(
        cache.decoderPipeline == expected.decoderPipeline,
        cache.heapHandle == expected.heapHandle,
        cache.indexByteOffset,
        expected.indexByteOffset,
        cache.indexCount,
        expected.indexCount,
        mesh.runtimeMesh,
        runtimeMesh,
        mesh.runtimeGeometryContentRevision,
        expected.sourceRevision,
        mesh.sameBuffers(sourceBuffers),
        cache.initialized,
        cache.acceptedContent,
        cache.acceptedContentRevision
    );
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


ECSRenderDetail::ObjectGeometryCacheSnapshot RendererMeshSystem::ObjectGeometryCacheSnapshot(const MeshResources& mesh)noexcept{
    const ECSRenderDetail::ObjectGeometryCacheState& cache = mesh.objectGeometryCache;
    return {
        .buffer = cache.buffer,
        .decoderPipeline = cache.decoderPipeline,
        .sourceRevision = mesh.runtimeGeometryContentRevision,
        .heapHandle = cache.heapHandle,
        .indexByteOffset = cache.indexByteOffset,
        .indexCount = cache.indexCount,
        .initialized = cache.initialized,
        .requiresDecode = MeshGeometryBufferPolicy().requiresObjectCacheDecode(cache.acceptedContent, mesh.runtimeMesh, mesh.runtimeGeometryContentRevision, cache.acceptedContentRevision),
    };
}

b8 RendererMeshSystem::prepareObjectGeometryCache(MeshResources& mesh, const Core::ComputePipelineHandle& decoderPipeline){
    if(!decoderPipeline)
        return false;
    ECSRenderDetail::ObjectGeometryCacheState& cache = mesh.objectGeometryCache;
    if(cache.decoderPipeline != decoderPipeline){
        cache.decoderPipeline = decoderPipeline;
        cache.acceptedContent = false;
    }
    if(cache.buffer && cache.heapHandle.valid())
        return true;
    if(!cache.buffer){
        if(!mesh.meshletLocalVertexRefBuffer)
            return false;
        const Expected<ObjectGeometryCacheLayout> layoutResult = MeshGeometryBufferPolicy().resolveObjectCacheLayout(mesh.meshletLocalVertexRefBuffer->getDescription().byteSize, mesh.meshletPrimitiveIndexCount);
        if(!layoutResult)
            return false;
        const ObjectGeometryCacheLayout& layout = *layoutResult;
        const auto bufferName = DeriveName(mesh.meshName, AStringView(":object_geometry"));
        if(!bufferName)
            return false;
        Core::BufferDesc desc;
        desc
            .setByteSize(layout.bufferByteSize)
            .setStructStride(NWB_MESH_OBJECT_VERTEX_BYTE_SIZE)
            .setCanHaveRawViews(true)
            .setCanHaveUAVs(true)
            .setIsVertexBuffer(true)
            .setIsIndexBuffer(true)
            .setQueueSharing(Core::ResourceQueueSharing::GraphicsAndAsyncCompute)
            .setDebugName(*bufferName)
        ;
        auto bufferResult = m_graphics.createBuffer(desc);
        if(bufferResult)
            cache.buffer = Move(*bufferResult);
        else
            cache.buffer.reset();
        if(!bufferResult){
            NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: failed to create object geometry cache for mesh '{}'"), ConvertString(mesh.meshName.resolvedText()));
            return false;
        }
        cache.indexByteOffset = layout.indexByteOffset;
        cache.indexCount = layout.indexCount;
        cache.acceptedContent = false;
        cache.initialized = false;
    }
    auto& heap = m_graphics.getDevice().getDescriptorHeap();
    if(!heap.isInitialized())
        return false;
    return RendererDescriptorRegisterDetail::AssignDescriptor(heap, Core::GpuDescriptorClass::StorageBuffer, Core::DescriptorWriteItem::StructuredBufferUav(0u, cache.buffer.get()), cache.heapHandle);
}

b8 RendererMeshSystem::confirmObjectGeometryCache(const Name& meshKey, const RuntimeMeshBuffers& sourceBuffers, const ECSRenderDetail::ObjectGeometryCacheSnapshot& expected, const b8 runtimeMesh)noexcept{
    const auto mesh = findMeshResources(meshKey);
    if(!mesh)
        return false;
    return ECSRenderDetail::AcceptObjectGeometryCacheWrite(**mesh, sourceBuffers, expected, runtimeMesh);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace ECSRenderDetail{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


MeshViewGpuData ResolveMeshViewState(const f32 fallbackAspectRatio, Core::ECS::World& world)noexcept{
    SIMDMatrix viewBasis = NWB::Impl::Scene::BuildDefaultSceneViewBasis();
    NWB::Impl::Scene::CameraProjection projection = NWB::Impl::Scene::StoreDefaultCameraProjection(fallbackAspectRatio);

    const NWB::Impl::Scene::SceneCameraView cameraView = NWB::Impl::Scene::ResolveSceneCameraView(world, fallbackAspectRatio);
    if(cameraView.valid()){
        viewBasis = NWB::Impl::Scene::BuildSceneViewBasis(LoadFloat(cameraView.transform->position), LoadFloat(cameraView.transform->rotation));
        projection = cameraView.projection;
    }

    return MeshViewStatePolicy().build(
        viewBasis.v[0u],
        viewBasis.v[1u],
        viewBasis.v[2u],
        viewBasis.v[3u],
        LoadFloat(projection.projectionParams),
        projection.tanHalfVerticalFov,
        projection.aspectRatio,
        projection.nearPlane,
        projection.farPlane
    );
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void RendererMeshState::invalidateResources()noexcept{
    m_meshes.clear();
    m_meshViewBuffer.reset();
    m_frameBindings.reset();
    m_meshViewGpuDataValid = false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Core::BufferHandle& RendererMeshSystem::MeshSourceBuffer(const MeshResources& mesh, const u32 bindingSlot)noexcept{
    switch(bindingSlot){
    case NWB_MESH_BINDING_POSITION: return mesh.positionBuffer;
    case NWB_MESH_BINDING_NORMAL: return mesh.normalBuffer;
    case NWB_MESH_BINDING_TANGENT: return mesh.tangentBuffer;
    case NWB_MESH_BINDING_UV0: return mesh.uv0Buffer;
    case NWB_MESH_BINDING_COLOR: return mesh.colorBuffer;
    case NWB_MESH_BINDING_MESHLET_DESC: return mesh.meshletDescBuffer;
    case NWB_MESH_BINDING_MESHLET_BOUNDS: return mesh.meshletBoundsBuffer;
    case NWB_MESH_BINDING_MESHLET_POSITION_REFS: return mesh.meshletPositionRefDeltaBuffer;
    case NWB_MESH_BINDING_MESHLET_ATTRIBUTE_REFS: return mesh.meshletAttributeRefDeltaBuffer;
    case NWB_MESH_BINDING_MESHLET_LOCAL_VERTEX_REFS: return mesh.meshletLocalVertexRefBuffer;
    case NWB_MESH_BINDING_MESHLET_PRIMITIVE_INDICES: return mesh.meshletPrimitiveIndexBuffer;
    default:
        NWB_ASSERT(false);
        return mesh.positionBuffer;
    }
}

void RendererMeshSystem::invalidateResources(){
    releaseAllMeshGeometryHeapHandles();
    releaseMeshFrameHeapHandles();
    m_meshState.invalidateResources();
}

b8 RendererMeshSystem::createMeshViewBuffer(){
    if(m_meshState.m_meshViewBuffer)
        return true;

    Core::BufferDesc meshViewBufferDesc;
    meshViewBufferDesc
        .setByteSize(sizeof(MeshViewGpuData))
        .setIsConstantBuffer(true)
        .setDebugName(s_MeshViewBufferName)
        // Either caustic producer can consume the view; keep concurrent to avoid serializing lanes.
        .setQueueSharing(Core::ResourceQueueSharing::GraphicsAndAsyncCompute).enableAutomaticStateTracking(Core::ResourceStates::Common)
    ;
    auto meshViewBufferResult = m_graphics.createBuffer(meshViewBufferDesc);
    if(!meshViewBufferResult){
        NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: failed to create mesh view buffer"));
        return false;
    }
    Core::BufferHandle meshViewBuffer = Move(*meshViewBufferResult);

    releaseMeshFrameHeapHandles();
    m_meshState.m_meshViewBuffer = Move(meshViewBuffer);
    return true;
}

ECSRenderDetail::MeshViewBufferSnapshot RendererMeshSystem::meshViewBufferSnapshot()const noexcept{
    return m_meshState.m_frameBindings.viewSnapshot(m_meshState.m_meshViewBuffer);
}

Expected<Float44> RendererMeshSystem::snapshotAcceptedMeshViewWorldToClip()const noexcept{
    const Expected<MeshViewGpuData> acceptedView = MeshViewStatePolicy().readAccepted(m_meshState.m_meshViewGpuDataValid, m_meshState.m_meshViewGpuData);
    if(!acceptedView)
        return MakeUnexpected(Failure{});
    return acceptedView->worldToClip;
}

MeshViewBufferUpload RendererMeshSystem::prepareMeshViewBufferUpload(const f32 fallbackAspectRatio)const noexcept{
    NWB_ASSERT(m_meshState.m_meshViewBuffer);

    MeshViewBufferUpload upload;
    upload.viewState = ECSRenderDetail::ResolveMeshViewState(fallbackAspectRatio, m_world);
    upload.uploadRequired = MeshViewStatePolicy().uploadRequired(m_meshState.m_meshViewGpuDataValid, m_meshState.m_meshViewGpuData, upload.viewState);
    return upload;
}

void RendererMeshSystem::confirmMeshViewBufferUpload(const MeshViewGpuData& viewState)noexcept{
    MeshViewStatePolicy().storeConfirmed(viewState, m_meshState.m_meshViewGpuData, m_meshState.m_meshViewGpuDataValid);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace ECSRenderDetail{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 MeshViewSetupGraphTask::Record(const Payload& payload, Core::CommandList& commandList, const Core::GpuTaskRecordContext& context){
    const Core::GpuPhysicalQueueInfo* const shadowVisibilityQueue = ECSRenderDetail::QueueForTask(context, payload.shadowVisibilityTask);
    if(!shadowVisibilityQueue)
        return false;

    const b8 shadowVisibilityRunsOnCompute = shadowVisibilityQueue->queueClass == Core::CommandQueue::Compute;
    Core::GpuTimingSubmissionTicket::RecordingScope timingRecording(*payload.timingTicket);
    const b8 recordsGraphicsFrameMarker = !shadowVisibilityRunsOnCompute && RendererGpuTimingScope::s_Frame.valid();
    if(recordsGraphicsFrameMarker)
        commandList.beginMarker(RendererGpuTimingScope::s_Frame.markerLabel);

    if(shadowVisibilityRunsOnCompute && payload.asyncPrefixTimingSpansOnePacket){
        payload.asyncPrefixTiming.emplace(payload.graphics.gpuTiming(), RendererGpuTimingScope::s_AsyncPrefix, payload.graphics.getDevice(), commandList);
        if(!Core::FinishSplitGpuTimingMarker(&payload.asyncPrefixTiming))
            return false;
    }

    if(recordsGraphicsFrameMarker)
        commandList.endMarker();
    return true;
}

b8 MeshViewUploadCommitGraphTask::Record(const Payload& payload, [[maybe_unused]] Core::CommandList& commandList, [[maybe_unused]] const Core::GpuTaskRecordContext& context)noexcept{
    payload.ready = true;
    return true;
}

void MeshViewUploadCommitGraphTask::Accepted(Payload& payload, [[maybe_unused]] const Core::QueueSubmissionToken& token)noexcept{
    if(payload.uploadRequired)
        payload.meshSystem.confirmMeshViewBufferUpload(payload.viewState);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_mesh_resources{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


template<typename PayloadT>
[[nodiscard]] static Expected<Core::BufferHandle, BufferSetupFailure::Enum> SetupMeshBuffer(
    Core::GraphicsRuntime& graphics,
    const Name& meshName,
    const AStringView suffix,
    const Span<const PayloadT> payload,
    const AStringView label,
    const b8 canHaveRawViews = false,
    const b8 accelStructBuildInput = false
){
    const auto bufferName = DeriveMeshBufferName(meshName, suffix, label);
    if(!bufferName)
        return MakeUnexpected(BufferSetupFailure::CreateFailed);

    auto buffer = RuntimeMeshBufferUpload::SetupRequiredBuffer<PayloadT>(graphics, *bufferName, payload, { false, canHaveRawViews, accelStructBuildInput, Core::ResourceQueueSharing::GraphicsAndAsyncCompute });
    if(!buffer){
        ReportMeshBufferSetupFailure(buffer.error(), meshName, label);
        return MakeUnexpected(buffer.error());
    }
    return Move(*buffer);
}

[[nodiscard]] static Expected<Core::BufferHandle, BufferSetupFailure::Enum> SetupPaddedRawMeshBuffer(
    Core::GraphicsRuntime& graphics,
    Core::Alloc::ScratchArena& scratchArena,
    const Name& meshName,
    const AStringView suffix,
    const Span<const u8> payload,
    const AStringView label
){
    const auto bufferName = DeriveMeshBufferName(meshName, suffix, label);
    if(!bufferName)
        return MakeUnexpected(BufferSetupFailure::CreateFailed);

    auto buffer = RuntimeMeshBufferUpload::SetupRequiredPaddedRawByteBuffer(graphics, scratchArena, *bufferName, payload, { false, true, false, Core::ResourceQueueSharing::GraphicsAndAsyncCompute });
    if(!buffer){
        ReportMeshBufferSetupFailure(buffer.error(), meshName, label);
        return MakeUnexpected(buffer.error());
    }
    return Move(*buffer);
}



////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<NotNull<MeshResources*>> RendererMeshSystem::createMeshResources(const Core::Assets::AssetRef<Mesh>& meshAsset, Core::Alloc::ScratchArena& scratchArena){
    const Name meshPath = meshAsset.name();
    if(!meshPath){
        NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: renderer mesh is empty"));
        return MakeUnexpected(Failure{});
    }

    const auto foundMesh = m_meshState.m_meshes.find(meshPath);
    if(foundMesh != m_meshState.m_meshes.end()){
        NWB_ASSERT(meshRenderBindingsReady(foundMesh.value()));
        NWB_ASSERT(foundMesh.value().valid());
        return MakeNotNull(&foundMesh.value());
    }

    auto loadedAsset = m_assetManager.loadTypedSync<Mesh>(meshPath, s_RendererAssetOwnerName);
    if(!loadedAsset)
        return MakeUnexpected(Failure{});

    const Mesh& mesh = **loadedAsset;
    // Mesh::loadBinary already ran the full payload validation (including u32 stream limits).
    NWB_ASSERT(mesh.validatePayload(scratchArena));
    NWB_ASSERT(mesh.meshlets().size() <= static_cast<usize>(Limit<u32>::s_Max));
    NWB_ASSERT(mesh.meshletPrimitiveIndices().size() <= static_cast<usize>(Limit<u32>::s_Max));

    MeshResources createdMesh;
    createdMesh.meshName = meshPath;
    createdMesh.meshletCount = static_cast<u32>(mesh.meshlets().size());
    createdMesh.meshletPrimitiveIndexCount = static_cast<u32>(mesh.meshletPrimitiveIndices().size());
    createdMesh.solidTriangleWords = Core::MakeGlobalUnique<u32[]>(m_arena, mesh.solidTriangleWords().size());
    if(!createdMesh.solidTriangleWords)
        return MakeUnexpected(Failure{});
    const usize solidByteCount = mesh.solidTriangleWords().size() * sizeof(u32);
    NWB_MEMCPY(createdMesh.solidTriangleWords.get(), solidByteCount, mesh.solidTriangleWords().data(), solidByteCount);
    const Expected<CsgReceiverCpuBounds> csgLocalBounds = NWB::Impl::BuildPositionStreamBounds(mesh.positionStream());
    if(!csgLocalBounds){
        NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: mesh '{}' has invalid CSG receiver bounds"), ConvertString(meshPath.resolvedText()));
        return MakeUnexpected(Failure{});
    }
    createdMesh.csgLocalBounds = *csgLocalBounds;

    const b8 rtSupported = m_graphics.queryFeatureSupport(Core::Feature::RayTracingAccelStruct);
    // Both tracing backends read raw position/index buffers for material evaluation.
    const b8 swShadow = !rtSupported;

    b8 uploaded = true;
    auto positionBufferResult = __hidden_mesh_resources::SetupMeshBuffer<Float3U>(m_graphics, meshPath, s_PositionsBufferName, mesh.positionStream(), s_MeshPositionBufferLabel, true, rtSupported);
    if(positionBufferResult)
        createdMesh.positionBuffer = Move(*positionBufferResult);
    else
        createdMesh.positionBuffer.reset();
    uploaded = static_cast<b8>(positionBufferResult) && uploaded;
    auto normalBufferResult = __hidden_mesh_resources::SetupMeshBuffer<Half4U>(m_graphics, meshPath, s_NormalsBufferName, mesh.normalStream(), s_MeshNormalBufferLabel);
    if(normalBufferResult)
        createdMesh.normalBuffer = Move(*normalBufferResult);
    else
        createdMesh.normalBuffer.reset();
    uploaded = static_cast<b8>(normalBufferResult) && uploaded;
    auto tangentBufferResult = __hidden_mesh_resources::SetupMeshBuffer<Half4U>(m_graphics, meshPath, s_TangentsBufferName, mesh.tangentStream(), s_MeshTangentBufferLabel);
    if(tangentBufferResult)
        createdMesh.tangentBuffer = Move(*tangentBufferResult);
    else
        createdMesh.tangentBuffer.reset();
    uploaded = static_cast<b8>(tangentBufferResult) && uploaded;
    auto uv0BufferResult = __hidden_mesh_resources::SetupMeshBuffer<Float2U>(m_graphics, meshPath, s_Uv0BufferName, mesh.uv0Stream(), s_MeshUv0BufferLabel);
    if(uv0BufferResult)
        createdMesh.uv0Buffer = Move(*uv0BufferResult);
    else
        createdMesh.uv0Buffer.reset();
    uploaded = static_cast<b8>(uv0BufferResult) && uploaded;
    auto colorBufferResult = __hidden_mesh_resources::SetupMeshBuffer<Half4U>(m_graphics, meshPath, s_ColorsBufferName, mesh.colorStream(), s_MeshColorBufferLabel);
    if(colorBufferResult)
        createdMesh.colorBuffer = Move(*colorBufferResult);
    else
        createdMesh.colorBuffer.reset();
    uploaded = static_cast<b8>(colorBufferResult) && uploaded;
    auto meshletDescBufferResult = __hidden_mesh_resources::SetupMeshBuffer<MeshletDesc>(m_graphics, meshPath, s_MeshletsBufferName, mesh.meshlets(), s_MeshletDescriptorBufferLabel);
    if(meshletDescBufferResult)
        createdMesh.meshletDescBuffer = Move(*meshletDescBufferResult);
    else
        createdMesh.meshletDescBuffer.reset();
    uploaded = static_cast<b8>(meshletDescBufferResult) && uploaded;
    auto meshletBoundsBufferResult = __hidden_mesh_resources::SetupMeshBuffer<MeshletBounds>(m_graphics, meshPath, s_MeshletBoundsBufferName, mesh.meshletBounds(), s_MeshletBoundsBufferLabel, true);
    if(meshletBoundsBufferResult)
        createdMesh.meshletBoundsBuffer = Move(*meshletBoundsBufferResult);
    else
        createdMesh.meshletBoundsBuffer.reset();
    uploaded = static_cast<b8>(meshletBoundsBufferResult) && uploaded;
    auto meshletPositionRefDeltaBufferResult = __hidden_mesh_resources::SetupPaddedRawMeshBuffer(
        m_graphics, scratchArena, meshPath, s_MeshletPositionRefDeltasBufferName, mesh.meshletPositionRefDeltas(), s_MeshletPositionRefDeltaBufferLabel
    );
    if(meshletPositionRefDeltaBufferResult)
        createdMesh.meshletPositionRefDeltaBuffer = Move(*meshletPositionRefDeltaBufferResult);
    else
        createdMesh.meshletPositionRefDeltaBuffer.reset();
    uploaded = static_cast<b8>(meshletPositionRefDeltaBufferResult) && uploaded;
    auto meshletAttributeRefDeltaBufferResult = __hidden_mesh_resources::SetupPaddedRawMeshBuffer(
        m_graphics, scratchArena, meshPath, s_MeshletAttributeRefDeltasBufferName, mesh.meshletAttributeRefDeltas(), s_MeshletAttributeRefDeltaBufferLabel
    );
    if(meshletAttributeRefDeltaBufferResult)
        createdMesh.meshletAttributeRefDeltaBuffer = Move(*meshletAttributeRefDeltaBufferResult);
    else
        createdMesh.meshletAttributeRefDeltaBuffer.reset();
    uploaded = static_cast<b8>(meshletAttributeRefDeltaBufferResult) && uploaded;
    auto meshletLocalVertexRefBufferResult = __hidden_mesh_resources::SetupMeshBuffer<MeshletLocalVertexRef>(
        m_graphics, meshPath, s_MeshletLocalVertexRefsBufferName, mesh.meshletLocalVertexRefs(), s_MeshletLocalVertexRefBufferLabel
    );
    if(meshletLocalVertexRefBufferResult)
        createdMesh.meshletLocalVertexRefBuffer = Move(*meshletLocalVertexRefBufferResult);
    else
        createdMesh.meshletLocalVertexRefBuffer.reset();
    uploaded = static_cast<b8>(meshletLocalVertexRefBufferResult) && uploaded;
    auto meshletPrimitiveIndexBufferResult = __hidden_mesh_resources::SetupPaddedRawMeshBuffer(
        m_graphics, scratchArena, meshPath, s_MeshletPrimitiveIndicesBufferName, mesh.meshletPrimitiveIndices(), s_MeshletPrimitiveIndexBufferLabel
    );
    if(meshletPrimitiveIndexBufferResult)
        createdMesh.meshletPrimitiveIndexBuffer = Move(*meshletPrimitiveIndexBufferResult);
    else
        createdMesh.meshletPrimitiveIndexBuffer.reset();
    uploaded = static_cast<b8>(meshletPrimitiveIndexBufferResult) && uploaded;
    if(!uploaded)
        return MakeUnexpected(Failure{});

    // Both shadow backends trace triangles; always create the reconstructed index buffer.
    {
        const auto triangleIndices = BuildMeshletTriangleIndices(mesh, scratchArena);
        if(!triangleIndices){
            NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: failed to reconstruct shadow trace triangle indices for mesh '{}'"), ConvertString(meshPath.resolvedText()));
            return MakeUnexpected(Failure{});
        }

        const auto indexBufferName = DeriveName(meshPath, s_RtTriangleIndicesBufferName);
        if(!indexBufferName){
            NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: failed to derive shadow trace index buffer name for mesh '{}'"), ConvertString(meshPath.resolvedText()));
            return MakeUnexpected(Failure{});
        }

        RuntimeMeshBufferUpload::BufferFlags indexFlags;
        indexFlags.canHaveRawViews = true;
        indexFlags.isIndexBuffer = true;
        indexFlags.accelStructBuildInput = rtSupported;
        // Async shadow packet shares this stream; keep sharing consistent to avoid ownership transfer.
        indexFlags.queueSharing = Core::ResourceQueueSharing::GraphicsAndAsyncCompute;
        auto indexBuffer = RuntimeMeshBufferUpload::SetupRequiredBuffer<u32>(m_graphics, *indexBufferName, *triangleIndices, indexFlags);
        if(!indexBuffer){
            NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: failed to create shadow trace index buffer for mesh '{}'"), ConvertString(meshPath.resolvedText()));
            return MakeUnexpected(Failure{});
        }

        createdMesh.triangleIndexBuffer = Move(*indexBuffer);
        MeshAccelerationStatePolicy().finalizeShadowIndices(
            meshPath,
            triangleIndices->size(),
            createdMesh.meshletPrimitiveIndexCount,
            rtSupported,
            swShadow,
            createdMesh.blasBuildPending,
            createdMesh.swBvhBuildPending
        );
    }

    // Flat per-corner trace attributes in lockstep with the index buffer; always carries a raw view.
    {
        const auto triangleAttributes = BuildMeshletTriangleAttributes(mesh, scratchArena);
        if(!triangleAttributes){
            NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: failed to reconstruct shadow trace triangle attributes for mesh '{}'"), ConvertString(meshPath.resolvedText()));
            return MakeUnexpected(Failure{});
        }

        const auto attributeBufferName = DeriveName(meshPath, s_RtTriangleAttributesBufferName);
        if(!attributeBufferName){
            NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: failed to derive shadow trace attribute buffer name for mesh '{}'"), ConvertString(meshPath.resolvedText()));
            return MakeUnexpected(Failure{});
        }

        RuntimeMeshBufferUpload::BufferFlags attributeFlags;
        attributeFlags.canHaveRawViews = true;
        // Tracing shares these attributes on AsyncCompute; keep shared-read input.
        attributeFlags.queueSharing = Core::ResourceQueueSharing::GraphicsAndAsyncCompute;
        auto attributeBuffer = RuntimeMeshBufferUpload::SetupRequiredBuffer<AttribGpu>(m_graphics, *attributeBufferName, *triangleAttributes, attributeFlags);
        if(!attributeBuffer){
            NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: failed to create shadow trace triangle attribute buffer for mesh '{}'"), ConvertString(meshPath.resolvedText()));
            return MakeUnexpected(Failure{});
        }
        createdMesh.attributeBuffer = Move(*attributeBuffer);
    }

    NWB_ASSERT(createdMesh.valid());
    MeshDescriptorTransaction retireUnpublished(*this, createdMesh);
    if(!createMeshRenderBindings(createdMesh))
        return MakeUnexpected(Failure{});

    auto result = m_meshState.m_meshes.try_emplace(meshPath, Move(createdMesh));
    if(result.second)
        retireUnpublished.release();
    auto it = result.first;

    NWB_ASSERT(it.value().valid());
    return MakeNotNull(&it.value());
}

Expected<NotNull<MeshResources*>> RendererMeshSystem::findMeshResources(const Name& meshKey)noexcept{
    if(!meshKey)
        return MakeUnexpected(Failure{});

    const auto foundMesh = m_meshState.m_meshes.find(meshKey);
    if(foundMesh == m_meshState.m_meshes.end())
        return MakeUnexpected(Failure{});

    NWB_ASSERT(meshRenderBindingsReady(foundMesh.value()));
    NWB_ASSERT(foundMesh.value().valid());
    return MakeNotNull(&foundMesh.value());
}

Expected<NotNull<MeshResources*>> RendererMeshSystem::createRuntimeMeshResources(const RuntimeMeshDesc& desc){
    return RuntimeMeshResourceCache(*this).create(desc);
}

Expected<NotNull<MeshResources*>> RendererMeshSystem::findRuntimeMeshResources(const RuntimeMeshDesc& desc)noexcept{
    return RuntimeMeshResourceCache(*this).find(desc);
}

void RendererMeshSystem::pruneRuntimeMeshResources(Core::Alloc::ScratchArena& scratchArena){
    if(m_meshState.m_meshes.empty())
        return;

    const auto* meshSystemPtr = m_world.getSystem<NWB::Impl::MeshSystem>();
    ECSRenderDetail::PruneRuntimeMeshResources(m_meshState.m_meshes, meshSystemPtr, [this](MeshResources& mesh){ releaseMeshGeometryHeapHandles(mesh); }, scratchArena);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_runtime_mesh_resource_cache{


[[nodiscard]] static b8 RuntimeMeshSourceMatches(const MeshResources& mesh, const RuntimeMeshDesc& desc)noexcept{
    return
        mesh.runtimeMeshVersion == desc.version
        && mesh.sameBuffers(desc)
        && mesh.triangleIndexBuffer == desc.triangleIndexBuffer
        && mesh.attributeBuffer == desc.attributeBuffer
        && mesh.runtimeLocalBoundsBuffer == desc.localBoundsBuffer
        && mesh.runtimeMeshletLocalBoundsBuffer == desc.meshletLocalBoundsBuffer
        && mesh.meshletCount == desc.meshletCount
        && mesh.meshletPrimitiveIndexCount == desc.meshletPrimitiveIndexCount
    ;
}

static void RefreshRuntimeMeshContent(MeshResources& mesh, const RuntimeMeshDesc& desc)noexcept{
    mesh.runtimeGeometryContentRevision = desc.geometryContentRevision;
    mesh.dynamicMeshletBoundsFresh = desc.dynamicMeshletBoundsFresh;
    mesh.dynamicMeshletConesFresh = desc.dynamicMeshletConesFresh;
    RefreshRuntimeMeshCsgBounds(LoadFloatInt(desc.localBounds.minBounds), LoadFloatInt(desc.localBounds.maxBounds), desc.localBounds.finite(), mesh.csgLocalBounds);
}

[[nodiscard]] static b8 ValidateRawBufferLogicalByteCount(const Core::BufferHandle& buffer, const u32 logicalByteCount, const Name& meshName, const AStringView label){
    const Core::BufferDesc emptyDesc{};
    const Core::BufferDesc& desc = buffer ? buffer->getCreationDescription() : emptyDesc;
    return ValidateMeshRawBufferLogicalByteCount(buffer != nullptr, desc.structStride, desc.byteSize, logicalByteCount, meshName, label);
}


};


Expected<NotNull<MeshResources*>> RuntimeMeshResourceCache::create(const RuntimeMeshDesc& desc){
    NWB_ASSERT(desc.valid());

    const auto foundMesh = m_system.m_meshState.m_meshes.find(desc.meshKey);
    if(foundMesh != m_system.m_meshState.m_meshes.end()){
        if(!foundMesh.value().runtimeMesh){
            NWB_LOGGER_ERROR(NWB_TEXT("RendererSystem: runtime mesh '{}' collides with a static mesh resource"), ConvertString(desc.meshKey.resolvedText()));
            return MakeUnexpected(Failure{});
        }
        if(!__hidden_runtime_mesh_resource_cache::RuntimeMeshSourceMatches(foundMesh.value(), desc)){
            m_system.releaseMeshGeometryHeapHandles(foundMesh.value());
            m_system.m_meshState.m_meshes.erase(foundMesh);
        }
        else{
            NWB_ASSERT(m_system.meshRenderBindingsReady(foundMesh.value()));
            MeshResources& mesh = foundMesh.value();
            __hidden_runtime_mesh_resource_cache::RefreshRuntimeMeshContent(mesh, desc);
            NWB_ASSERT(mesh.valid());
            return MakeNotNull(&mesh);
        }
    }

    MeshResources createdMesh;
    createdMesh.meshName = desc.meshKey;
    createdMesh.solidTriangleWords = Core::MakeGlobalUnique<u32[]>(m_system.m_arena, desc.solidTriangleWords.size());
    if(!createdMesh.solidTriangleWords)
        return MakeUnexpected(Failure{});
    const usize solidByteCount = desc.solidTriangleWords.size_bytes();
    NWB_MEMCPY(createdMesh.solidTriangleWords.get(), solidByteCount, desc.solidTriangleWords.data(), solidByteCount);
    createdMesh.positionBuffer = desc.positionBuffer;
    createdMesh.normalBuffer = desc.normalBuffer;
    createdMesh.tangentBuffer = desc.tangentBuffer;
    createdMesh.uv0Buffer = desc.uv0Buffer;
    createdMesh.colorBuffer = desc.colorBuffer;
    createdMesh.meshletDescBuffer = desc.meshletDescBuffer;
    createdMesh.meshletBoundsBuffer = desc.meshletBoundsBuffer;
    createdMesh.meshletPositionRefDeltaBuffer = desc.meshletPositionRefDeltaBuffer;
    createdMesh.meshletAttributeRefDeltaBuffer = desc.meshletAttributeRefDeltaBuffer;
    createdMesh.meshletLocalVertexRefBuffer = desc.meshletLocalVertexRefBuffer;
    createdMesh.meshletPrimitiveIndexBuffer = desc.meshletPrimitiveIndexBuffer;
    createdMesh.triangleIndexBuffer = desc.triangleIndexBuffer;
    createdMesh.attributeBuffer = desc.attributeBuffer;
    createdMesh.runtimeLocalBoundsBuffer = desc.localBoundsBuffer;
    createdMesh.runtimeMeshletLocalBoundsBuffer = desc.meshletLocalBoundsBuffer;
    createdMesh.blasBuildPending = (desc.triangleIndexBuffer != nullptr);
    createdMesh.meshletCount = desc.meshletCount;
    createdMesh.meshletPrimitiveIndexCount = desc.meshletPrimitiveIndexCount;
    createdMesh.runtimeMesh = true;
    createdMesh.runtimeMeshVersion = desc.version;
    NWB_ASSERT(desc.localBounds.valid());
    __hidden_runtime_mesh_resource_cache::RefreshRuntimeMeshContent(createdMesh, desc);
    if(!ValidateRuntimeMeshPrimitiveIndexCount(createdMesh.meshName, createdMesh.meshletPrimitiveIndexCount, s_MeshletTriangleIndexCount))
        return MakeUnexpected(Failure{});
    if(!__hidden_runtime_mesh_resource_cache::ValidateRawBufferLogicalByteCount(createdMesh.meshletPrimitiveIndexBuffer, createdMesh.meshletPrimitiveIndexCount, createdMesh.meshName, s_MeshletPrimitiveIndexBufferLabel))
        return MakeUnexpected(Failure{});
    NWB_ASSERT(createdMesh.valid());
    MeshDescriptorTransaction retireUnpublished(m_system, createdMesh);
    if(!m_system.createMeshRenderBindings(createdMesh))
        return MakeUnexpected(Failure{});

    auto result = m_system.m_meshState.m_meshes.try_emplace(desc.meshKey, Move(createdMesh));
    if(result.second)
        retireUnpublished.release();
    auto it = result.first;

    NWB_ASSERT(it.value().valid());
    return MakeNotNull(&it.value());
}

Expected<NotNull<MeshResources*>> RuntimeMeshResourceCache::find(const RuntimeMeshDesc& desc)noexcept{
    NWB_ASSERT(desc.valid());

    const auto foundMesh = m_system.m_meshState.m_meshes.find(desc.meshKey);
    if(foundMesh == m_system.m_meshState.m_meshes.end())
        return MakeUnexpected(Failure{});

    MeshResources& mesh = foundMesh.value();
    if(!mesh.runtimeMesh || !__hidden_runtime_mesh_resource_cache::RuntimeMeshSourceMatches(mesh, desc))
        return MakeUnexpected(Failure{});

    NWB_ASSERT(m_system.meshRenderBindingsReady(mesh));
    __hidden_runtime_mesh_resource_cache::RefreshRuntimeMeshContent(mesh, desc);
    NWB_ASSERT(mesh.valid());
    return MakeNotNull(&mesh);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] b8 MeshRayTracingSnapshotPolicy::BoundsReady(const MeshResources& mesh)noexcept{
    const Core::GpuDescriptorHandle descriptor = mesh.geometryHeapHandles[NWB_MESH_BINDING_MESHLET_DESC];
    const Core::GpuDescriptorHandle bounds = mesh.runtimeMeshletLocalBoundsHeapHandle;
    if(
        !mesh.runtimeMesh || mesh.runtimeGeometryContentRevision == 0u || mesh.meshletCount == 0u
        || !mesh.meshletDescBuffer || !mesh.runtimeMeshletLocalBoundsBuffer
        || !descriptor.valid() || descriptor.descriptorClass() != Core::GpuDescriptorClass::StorageBuffer
        || !bounds.valid() || bounds.descriptorClass() != Core::GpuDescriptorClass::StorageBuffer
    )
        return false;
    return true;
}

[[nodiscard]] b8 MeshRayTracingSnapshotPolicy::MeshletMatches(const MeshResources& mesh, const ECSRenderDetail::MeshRayTracingResourceSnapshot& snapshot)noexcept{
    if(!BoundsReady(mesh))
        return snapshot.meshletCount == 0u && !snapshot.meshletDescBuffer && !snapshot.meshletLocalBoundsBuffer && !snapshot.meshletDescHeapHandle.valid() && !snapshot.meshletLocalBoundsHeapHandle.valid();
    return
        snapshot.meshletCount == mesh.meshletCount
        && snapshot.meshletDescBuffer == mesh.meshletDescBuffer
        && snapshot.meshletLocalBoundsBuffer == mesh.runtimeMeshletLocalBoundsBuffer
        && snapshot.meshletDescHeapHandle == mesh.geometryHeapHandles[NWB_MESH_BINDING_MESHLET_DESC]
        && snapshot.meshletLocalBoundsHeapHandle == mesh.runtimeMeshletLocalBoundsHeapHandle
    ;
}

ECSRenderDetail::MeshRayTracingResourceSnapshot MeshRayTracingSnapshotPolicy::Capture(const MeshResources& mesh)noexcept{
    ECSRenderDetail::MeshRayTracingResourceSnapshot snapshot = {
        .meshName = mesh.meshName,
        .runtimeMeshVersion = mesh.runtimeMeshVersion,
        .runtimeGeometryContentRevision = mesh.runtimeGeometryContentRevision,
        .blasGeometryContentRevision = mesh.blasGeometryContentRevision,
        .swBvhGeometryContentRevision = mesh.swBvhGeometryContentRevision,
        .positionBuffer = mesh.positionBuffer,
        .triangleIndexBuffer = mesh.triangleIndexBuffer,
        .attributeBuffer = mesh.attributeBuffer,
        .solidTriangleWords = Span<const u32>(mesh.solidTriangleWords.get(), ExpectedMeshletSolidTriangleWordCount(mesh.meshletPrimitiveIndexCount)),
        .runtimeLocalBoundsBuffer = mesh.runtimeLocalBoundsBuffer,
        .meshletDescBuffer = {},
        .meshletLocalBoundsBuffer = {},
        .blas = mesh.blas,
        .swBvhNodeBuffer = mesh.swBvhNodeBuffer,
        .swBvhParentBuffer = mesh.swBvhParentBuffer,
        .csgLocalBounds = mesh.csgLocalBounds,
        .runtimeLocalBoundsHeapHandle = mesh.runtimeLocalBoundsHeapHandle,
        .meshletDescHeapHandle = Core::GpuDescriptorHandle::Invalid(),
        .meshletLocalBoundsHeapHandle = Core::GpuDescriptorHandle::Invalid(),
        .swBvhPositionHeapHandle = mesh.swBvhPositionHeapHandle,
        .swBvhTriangleIndexHeapHandle = mesh.swBvhTriangleIndexHeapHandle,
        .swBvhNodeHeapHandle = mesh.swBvhNodeHeapHandle,
        .swBvhParentHeapHandle = mesh.swBvhParentHeapHandle,
        .meshletCount = 0u,
        .meshletPrimitiveIndexCount = mesh.meshletPrimitiveIndexCount,
        .blasRefitsSinceRebuild = mesh.blasRefitsSinceRebuild,
        .swBvhRefitsSinceRebuild = mesh.swBvhRefitsSinceRebuild,
        .runtimeMesh = mesh.runtimeMesh,
        .blasBuildPending = mesh.blasBuildPending,
        .blasBackingFresh = mesh.blasBackingFresh,
        .swBvhBuildPending = mesh.swBvhBuildPending,
        .swBvhTopologyBuilt = mesh.swBvhTopologyBuilt,
        .blasBuildAccepted = mesh.blasBuildAccepted,
        .swBvhBuildAccepted = mesh.swBvhBuildAccepted,
    };
    if(BoundsReady(mesh)){
        snapshot.meshletCount = mesh.meshletCount;
        snapshot.meshletDescBuffer = mesh.meshletDescBuffer;
        snapshot.meshletLocalBoundsBuffer = mesh.runtimeMeshletLocalBoundsBuffer;
        snapshot.meshletDescHeapHandle = mesh.geometryHeapHandles[NWB_MESH_BINDING_MESHLET_DESC];
        snapshot.meshletLocalBoundsHeapHandle = mesh.runtimeMeshletLocalBoundsHeapHandle;
    }
    return snapshot;
}

[[nodiscard]] b8 MeshRayTracingSnapshotPolicy::Matches(const MeshResources& mesh, const ECSRenderDetail::MeshRayTracingResourceSnapshot& snapshot)noexcept{
    return
        mesh.meshName == snapshot.meshName
        && mesh.positionBuffer.get() == snapshot.positionBuffer.get()
        && mesh.triangleIndexBuffer.get() == snapshot.triangleIndexBuffer.get()
        && mesh.attributeBuffer.get() == snapshot.attributeBuffer.get()
        && mesh.solidTriangleWords.get() == snapshot.solidTriangleWords.data()
        && mesh.runtimeLocalBoundsBuffer == snapshot.runtimeLocalBoundsBuffer
        && mesh.runtimeLocalBoundsHeapHandle == snapshot.runtimeLocalBoundsHeapHandle
        && MeshletMatches(mesh, snapshot)
        && mesh.blas.get() == snapshot.blas.get()
        && mesh.swBvhPositionHeapHandle == snapshot.swBvhPositionHeapHandle
        && mesh.swBvhTriangleIndexHeapHandle == snapshot.swBvhTriangleIndexHeapHandle
        && mesh.swBvhNodeBuffer.get() == snapshot.swBvhNodeBuffer.get()
        && mesh.swBvhParentBuffer.get() == snapshot.swBvhParentBuffer.get()
        && mesh.swBvhNodeHeapHandle == snapshot.swBvhNodeHeapHandle
        && mesh.swBvhParentHeapHandle == snapshot.swBvhParentHeapHandle
        && mesh.meshletPrimitiveIndexCount == snapshot.meshletPrimitiveIndexCount
        && mesh.blasRefitsSinceRebuild == snapshot.blasRefitsSinceRebuild
        && mesh.swBvhRefitsSinceRebuild == snapshot.swBvhRefitsSinceRebuild
        && mesh.runtimeMesh == snapshot.runtimeMesh
        && mesh.blasBuildPending == snapshot.blasBuildPending
        && mesh.blasBackingFresh == snapshot.blasBackingFresh
        && mesh.swBvhBuildPending == snapshot.swBvhBuildPending
        && mesh.swBvhTopologyBuilt == snapshot.swBvhTopologyBuilt
        && mesh.runtimeMeshVersion == snapshot.runtimeMeshVersion
        && mesh.runtimeGeometryContentRevision == snapshot.runtimeGeometryContentRevision
        && mesh.blasGeometryContentRevision == snapshot.blasGeometryContentRevision
        && mesh.swBvhGeometryContentRevision == snapshot.swBvhGeometryContentRevision
        && mesh.blasBuildAccepted == snapshot.blasBuildAccepted
        && mesh.swBvhBuildAccepted == snapshot.swBvhBuildAccepted
        && mesh.csgLocalBounds.minBounds == snapshot.csgLocalBounds.minBounds
        && mesh.csgLocalBounds.maxBounds == snapshot.csgLocalBounds.maxBounds
    ;
}

[[nodiscard]] b8 MeshRayTracingSnapshotPolicy::SameIdentity(const ECSRenderDetail::MeshRayTracingResourceSnapshot& lhs, const ECSRenderDetail::MeshRayTracingResourceSnapshot& rhs)noexcept{
    return
        lhs.meshName == rhs.meshName
        && lhs.positionBuffer.get() == rhs.positionBuffer.get()
        && lhs.triangleIndexBuffer.get() == rhs.triangleIndexBuffer.get()
        && lhs.attributeBuffer.get() == rhs.attributeBuffer.get()
        && lhs.solidTriangleWords.data() == rhs.solidTriangleWords.data()
        && lhs.solidTriangleWords.size() == rhs.solidTriangleWords.size()
        && lhs.runtimeLocalBoundsBuffer == rhs.runtimeLocalBoundsBuffer
        && lhs.runtimeLocalBoundsHeapHandle == rhs.runtimeLocalBoundsHeapHandle
        && lhs.meshletCount == rhs.meshletCount
        && lhs.meshletDescBuffer == rhs.meshletDescBuffer
        && lhs.meshletLocalBoundsBuffer == rhs.meshletLocalBoundsBuffer
        && lhs.meshletDescHeapHandle == rhs.meshletDescHeapHandle
        && lhs.meshletLocalBoundsHeapHandle == rhs.meshletLocalBoundsHeapHandle
        && lhs.swBvhPositionHeapHandle == rhs.swBvhPositionHeapHandle
        && lhs.swBvhTriangleIndexHeapHandle == rhs.swBvhTriangleIndexHeapHandle
        && lhs.meshletPrimitiveIndexCount == rhs.meshletPrimitiveIndexCount
        && lhs.runtimeMesh == rhs.runtimeMesh
        && lhs.runtimeMeshVersion == rhs.runtimeMeshVersion
        && lhs.runtimeGeometryContentRevision == rhs.runtimeGeometryContentRevision
        && lhs.csgLocalBounds.minBounds == rhs.csgLocalBounds.minBounds
        && lhs.csgLocalBounds.maxBounds == rhs.csgLocalBounds.maxBounds
    ;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void RendererMeshSystem::collectRayTracingResourceSnapshots(ECSRenderDetail::MeshRayTracingResourceSnapshotVector& outSnapshots)const{
    outSnapshots.clear();
    outSnapshots.reserve(m_meshState.m_meshes.size());
    for(auto meshIt = m_meshState.m_meshes.begin(); meshIt != m_meshState.m_meshes.end(); ++meshIt){
        auto snapshot = MeshRayTracingSnapshotPolicy::Capture(meshIt.value());
        outSnapshots.push_back(Move(snapshot));
    }
}

Expected<ECSRenderDetail::MeshRayTracingResourceSnapshot> RendererMeshSystem::findRayTracingResourceSnapshot(const Name& meshName)const noexcept{
    const auto found = m_meshState.m_meshes.find(meshName);
    if(found == m_meshState.m_meshes.end())
        return MakeUnexpected(Failure{});

    return MeshRayTracingSnapshotPolicy::Capture(found.value());
}

Expected<ECSRenderDetail::MeshRayTracingResourceSnapshot> RendererMeshSystem::findRenderableRayTracingResourceSnapshot(const RenderableMeshDesc& desc)const noexcept{
    if(!desc.valid())
        return MakeUnexpected(Failure{});

    const Name meshName = desc.runtime ? desc.runtimeMesh.meshKey : desc.mesh.name();
    const auto found = m_meshState.m_meshes.find(meshName);
    if(found == m_meshState.m_meshes.end())
        return MakeUnexpected(Failure{});

    const MeshResources& mesh = found.value();
    if(
        (desc.runtime && (
            !mesh.runtimeMesh || mesh.runtimeMeshVersion != desc.runtimeMesh.version
            || mesh.runtimeGeometryContentRevision != desc.runtimeMesh.geometryContentRevision
            || mesh.positionBuffer != desc.runtimeMesh.positionBuffer
            || mesh.triangleIndexBuffer != desc.runtimeMesh.triangleIndexBuffer
            || mesh.attributeBuffer != desc.runtimeMesh.attributeBuffer
            || mesh.runtimeLocalBoundsBuffer != desc.runtimeMesh.localBoundsBuffer
            || mesh.runtimeMeshletLocalBoundsBuffer != desc.runtimeMesh.meshletLocalBoundsBuffer
            || mesh.meshletPrimitiveIndexCount != desc.runtimeMesh.meshletPrimitiveIndexCount
        ))
        || !meshRenderBindingsReady(mesh)
    )
        return MakeUnexpected(Failure{});

    return MeshRayTracingSnapshotPolicy::Capture(mesh);
}

b8 RendererMeshSystem::commitRayTracingResourceSnapshot(const ECSRenderDetail::MeshRayTracingResourceSnapshot& expected, ECSRenderDetail::MeshRayTracingResourceSnapshot& desired){
    const auto found = m_meshState.m_meshes.find(expected.meshName);
    const b8 currentMatches = found != m_meshState.m_meshes.end() && MeshRayTracingSnapshotPolicy::Matches(found.value(), expected);
    if(!currentMatches || !MeshRayTracingSnapshotPolicy::SameIdentity(expected, desired)){
        Core::GpuDescriptorHeap& heap = m_graphics.getDevice().getDescriptorHeap();
        const Core::GpuDescriptorHandle currentNodeHandle = found != m_meshState.m_meshes.end() ? found.value().swBvhNodeHeapHandle : Core::GpuDescriptorHandle::Invalid();
        const Core::GpuDescriptorHandle currentParentHandle = found != m_meshState.m_meshes.end() ? found.value().swBvhParentHeapHandle : Core::GpuDescriptorHandle::Invalid();
        const Core::GpuDescriptorHandle candidateNodeHandle = desired.swBvhNodeHeapHandle;
        if(
            heap.isInitialized()
            && candidateNodeHandle.valid()
            && candidateNodeHandle != expected.swBvhNodeHeapHandle
            && candidateNodeHandle != expected.swBvhParentHeapHandle
            && candidateNodeHandle != currentNodeHandle
            && candidateNodeHandle != currentParentHandle
        ){
            heap.free(candidateNodeHandle);
            desired.swBvhNodeHeapHandle = Core::GpuDescriptorHandle::Invalid();
            if(desired.swBvhParentHeapHandle == candidateNodeHandle)
                desired.swBvhParentHeapHandle = Core::GpuDescriptorHandle::Invalid();
        }
        const Core::GpuDescriptorHandle candidateParentHandle = desired.swBvhParentHeapHandle;
        if(
            heap.isInitialized()
            && candidateParentHandle.valid()
            && candidateParentHandle != expected.swBvhNodeHeapHandle
            && candidateParentHandle != expected.swBvhParentHeapHandle
            && candidateParentHandle != currentNodeHandle
            && candidateParentHandle != currentParentHandle
        ){
            heap.free(candidateParentHandle);
            desired.swBvhParentHeapHandle = Core::GpuDescriptorHandle::Invalid();
        }
        return false;
    }

    Core::GpuDescriptorHeap& heap = m_graphics.getDevice().getDescriptorHeap();
    if(heap.isInitialized() && expected.swBvhNodeHeapHandle.valid() && expected.swBvhNodeHeapHandle != desired.swBvhNodeHeapHandle && expected.swBvhNodeHeapHandle != desired.swBvhParentHeapHandle)
        heap.free(expected.swBvhNodeHeapHandle);
    if(
        heap.isInitialized()
        && expected.swBvhParentHeapHandle.valid()
        && expected.swBvhParentHeapHandle != expected.swBvhNodeHeapHandle
        && expected.swBvhParentHeapHandle != desired.swBvhNodeHeapHandle
        && expected.swBvhParentHeapHandle != desired.swBvhParentHeapHandle
    )
        heap.free(expected.swBvhParentHeapHandle);

    MeshResources& mesh = found.value();
    const b8 blasReplaced = mesh.blas.get() != desired.blas.get();
    const b8 swBvhReplaced = mesh.swBvhNodeBuffer.get() != desired.swBvhNodeBuffer.get() || mesh.swBvhParentBuffer.get() != desired.swBvhParentBuffer.get();
    mesh.blas = desired.blas;
    mesh.swBvhNodeBuffer = desired.swBvhNodeBuffer;
    mesh.swBvhParentBuffer = desired.swBvhParentBuffer;
    mesh.swBvhNodeHeapHandle = desired.swBvhNodeHeapHandle;
    mesh.swBvhParentHeapHandle = desired.swBvhParentHeapHandle;
    MeshAccelerationStatePolicy().commitSnapshot(
        blasReplaced,
        swBvhReplaced,
        desired.blasRefitsSinceRebuild,
        desired.swBvhRefitsSinceRebuild,
        desired.blasBuildPending,
        desired.blasBackingFresh,
        desired.swBvhBuildPending,
        desired.swBvhTopologyBuilt,
        desired.blasBuildAccepted,
        desired.swBvhBuildAccepted,
        desired.blasGeometryContentRevision,
        desired.swBvhGeometryContentRevision,
        mesh.blasRefitsSinceRebuild,
        mesh.swBvhRefitsSinceRebuild,
        mesh.blasBuildPending,
        mesh.blasBackingFresh,
        mesh.swBvhBuildPending,
        mesh.swBvhTopologyBuilt,
        mesh.blasBuildAccepted,
        mesh.swBvhBuildAccepted,
        mesh.blasGeometryContentRevision,
        mesh.swBvhGeometryContentRevision
    );
    return true;
}

Expected<ECSRenderDetail::MeshRayTracingResourceSnapshot> RendererMeshSystem::ensureRayTracingInputHeapHandles(const ECSRenderDetail::MeshRayTracingResourceSnapshot& expected){
    const auto found = m_meshState.m_meshes.find(expected.meshName);
    if(found == m_meshState.m_meshes.end() || !MeshRayTracingSnapshotPolicy::Matches(found.value(), expected) || !ensureMeshSwBvhInputHeapHandles(found.value()))
        return MakeUnexpected(Failure{});

    return MeshRayTracingSnapshotPolicy::Capture(found.value());
}

void RendererMeshSystem::discardRayTracingBuildState()noexcept{
    for(auto meshIt = m_meshState.m_meshes.begin(); meshIt != m_meshState.m_meshes.end(); ++meshIt){
        MeshResources& mesh = meshIt.value();
        MeshAccelerationStatePolicy().resetBuild(
            mesh.blas != nullptr,
            mesh.swBvhNodeBuffer != nullptr || mesh.swBvhParentBuffer != nullptr,
            mesh.blasBuildPending,
            mesh.blasBuildAccepted,
            mesh.blasGeometryContentRevision,
            mesh.blasRefitsSinceRebuild,
            mesh.swBvhBuildPending,
            mesh.swBvhTopologyBuilt,
            mesh.swBvhBuildAccepted,
            mesh.swBvhGeometryContentRevision,
            mesh.swBvhRefitsSinceRebuild
        );
    }
}

Expected<ECSRenderDetail::MeshSoftwareBvhParentBuildStateVector> RendererMeshSystem::collectSoftwareBvhParentBuildStates(Core::Alloc::ScratchArena& arena)const{
    ECSRenderDetail::MeshSoftwareBvhParentBuildStateVector states(arena);
    states.reserve(m_meshState.m_meshes.size());
    for(auto meshIt = m_meshState.m_meshes.begin(); meshIt != m_meshState.m_meshes.end(); ++meshIt){
        const MeshResources& mesh = meshIt.value();
        if(!mesh.swBvhNodeBuffer && !mesh.swBvhParentBuffer)
            continue;
        if(!mesh.swBvhNodeBuffer || !mesh.swBvhParentBuffer){
            NWB_LOGGER_WARNING(NWB_TEXT("RendererMeshSystem: incomplete software BVH state for a live mesh"));
            return MakeUnexpected(Failure{});
        }
        const auto identity = DeriveName(mesh.meshName, AStringView(":shadow_trace_sw_parent"));
        if(!identity)
            return MakeUnexpected(Failure{});
        states.push_back({ .buffer = mesh.swBvhParentBuffer, .identity = *identity, });
    }
    return states;
}

void RendererMeshSystem::collectRetainedAccelerationStateBuffers(ECSRenderDetail::MeshRetainedAccelerationStateBufferVector& outBuffers)const{
    outBuffers.clear();
    outBuffers.reserve(m_meshState.m_meshes.size() * s_RetainedAccelerationBuffersPerMesh);
    for(auto meshIt = m_meshState.m_meshes.begin(); meshIt != m_meshState.m_meshes.end(); ++meshIt){
        const MeshResources& mesh = meshIt.value();
        // Retain every live BLAS source and backing buffer across preparation packets.
        if(mesh.blas){
            outBuffers.push_back(mesh.positionBuffer);
            outBuffers.push_back(mesh.triangleIndexBuffer);
            outBuffers.push_back(mesh.blas->getBackingBufferHandle());
        }
        // Preserve mesh-local software buffers across tracing-backend changes.
        outBuffers.push_back(mesh.swBvhNodeBuffer);
        outBuffers.push_back(mesh.swBvhParentBuffer);
    }
}

void RendererMeshSystem::collectBlasGraphStates(ECSRenderDetail::MeshBlasGraphStateVector& outStates)const{
    outStates.clear();
    outStates.reserve(m_meshState.m_meshes.size());
    for(auto meshIt = m_meshState.m_meshes.begin(); meshIt != m_meshState.m_meshes.end(); ++meshIt){
        const MeshResources& mesh = meshIt.value();
        if(!mesh.blas)
            continue;
        // This predicate consumes only build/revision state; the graph output below retains the BLAS.
        const b8 nativeBuildsBlas = MeshAccelerationStatePolicy().requiresBlasUpdate(mesh.blasBuildPending, mesh.blasBuildAccepted, mesh.runtimeMesh, mesh.runtimeGeometryContentRevision, mesh.blasGeometryContentRevision);
        outStates.push_back({ .meshName = mesh.meshName, .blas = mesh.blas, .backingFresh = mesh.blasBackingFresh, .nativeBuildsBlas = nativeBuildsBlas, });
    }
}


