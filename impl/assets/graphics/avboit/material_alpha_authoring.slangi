////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_AVBOIT_MATERIAL_ALPHA_AUTHORING_SLANGI
#define NWB_GRAPHICS_AVBOIT_MATERIAL_ALPHA_AUTHORING_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Shared alpha path for AVBOIT material occupancy/extinction authoring. Include after the material surface hook is in
// scope and after the pass declares its regular bindless or CSG-local opaque-depth contract.


bool nwbAvboitLoadAcceptedMaterialAlpha(
    const float4 position,
    const half4 color,
    const half3 normal,
    const half4 tangent,
    const float2 uv0,
    const float4 worldPosition,
    out half outAlpha
){
    // Initialize alpha so the CSG early return satisfies the out-parameter contract.
    outAlpha = half(0.0);

    NwbMeshSurfaceInputs surfaceInputs;
    surfaceInputs.color = color;
    // Match the G-buffer/accumulate boundary: expand half directions before the material hook evaluates them.
    surfaceInputs.normal = float3(normal);
    surfaceInputs.tangent = float4(tangent);
    surfaceInputs.uv0 = uv0;
    surfaceInputs.worldPosition = worldPosition.xyz;
    surfaceInputs.incidentDirection = nwbMeshCameraToSurfaceDirection(worldPosition.xyz);
    nwbLoadMeshSurfaceInputs(surfaceInputs);

#if NWB_CSG_ENABLED
    if(nwbAvboitCsgPixelDiscard(
        nwbAvboitFullRasterPositionFromLowFragCoord(position),
        worldPosition
    ))
        return false;
#endif

    const NwbMeshSurface surface = nwbMaterialSurface();

    outAlpha = half(clamp(surface.renderCoverage, 0.0, 1.0));
    uint virtualSlice;
    return nwbAvboitAcceptLowDepthFragment(
        NwbHeapSampledImage2D(g_NwbDeferredBindlessResources.gbufferSlots.w),
        NwbHeapSampler(g_NwbDeferredBindlessResources.lightingSlots.w),
        position,
        outAlpha,
        virtualSlice
    );
}

// Occupancy and extinction consume the same raster payload. Keep their conversion at this authoring boundary so a new
// field in NwbAvboitMaterialAlphaPixelInput cannot quietly reach only one of the two target-generation passes.
bool nwbAvboitLoadAcceptedMaterialAlpha(const NwbAvboitMaterialAlphaPixelInput input, out half outAlpha){
    return nwbAvboitLoadAcceptedMaterialAlpha(
        input.position,
        input.color,
        input.normal,
        input.tangent,
        input.uv0,
        input.worldPosition,
        outAlpha
    );
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


