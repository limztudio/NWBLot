// Hash semantic scene inputs, not padded object representations.
const u32 s_SceneStaticCacheHashVersion = 2u;
const StringView s_SceneShadowInstanceMaterialName = "render.deferred_effects.instance_material";
const StringView s_SceneShadowMaterialTypedName = "render.deferred_effects.material_typed";
const StringView s_SceneShadowInstancesName = "render.deferred_effects.shadow_instances";
const StringView s_SceneShadowInstanceMaterialLabel = "Shadow Instance Materials";
const StringView s_SceneShadowMaterialTypedLabel = "Shadow Typed Materials";
const StringView s_SceneShadowInstancesLabel = "Shadow Instances";
const StringView s_SceneTlasResourceName = "render.deferred_effects.tlas";
const StringView s_SceneTlasResourceLabel = "Scene TLAS";
const StringView s_SceneBvhNodesName = "render.shadow_visibility.scene_bvh_nodes";
const StringView s_SceneBvhNodesLabel = "Scene BVH Nodes";
const StringView s_SceneInstancesName = "render.shadow_visibility.scene_instances";
const StringView s_SceneInstancesLabel = "Scene Instances";
const StringView s_SceneGeometryDomainLabel = "Scene Acceleration and Geometry";
const StringView s_BlasNameSuffix = ":blas";
const StringView s_SoftwareSceneRefitInputsName = "software_scene_refit_inputs";
const usize s_TraceResourceSetUseCapacity = 2u;
// Finite infinity for CPU BVH bounds.
const f32 s_RayTracingFiniteInfinity = 1e30f;
const u32 s_RayTracingTriangleIndexCount = 3u;
const u32 s_RayTracingAllInstanceMask = 0xFFu;
// Heap geometry buffers per mesh.
const u32 s_HardwareRayTracingMeshBufferCount = 3u;
const u32 s_SoftwareRayTracingMeshBufferCount = 4u;
const usize s_TlasInitialInstanceCapacity = 128u;
const usize s_SceneBvhInitialInstanceCapacity = 64u;
// Fixed-grid binned SAH; leaf cost weights instance intersection cost.
const u32 s_SceneBvhAxisCount = 3u;
const u32 s_SceneBvhSahBinCount = 12u;
const f32 s_SceneBvhSahTraversalCost = 1.0f;
const usize s_SoftwareSceneRefitFixedUseCapacity = 2u;
const u32 s_RtOpticalBaseInstanceMask = 0x1u;
const u32 s_RtOpticalTransparentInstanceMask = 0x2u;
const u32 s_RtShadowBaseInstanceMask = 0x4u;
const u32 s_RtShadowTransparentInstanceMask = 0x8u;
const u32 s_RtCsgInstanceMask = 0x10u;
const u32 s_RtRefractiveInstanceMask = 0x20u;
const Name s_SceneTlasDebugName = "scene_tlas";
// Conservative top-level bounds for transparent-shadow rays.
const f32 s_SwShadowSceneBoundsMinPadding = 0.25f;
const f32 s_SwShadowSceneBoundsRelativePadding = 0.10f;
const usize s_FixedSceneResourceUseCount = 6u;
const usize s_SortBuildStateCapacity = 3u;
const u32 s_SceneBuffersPerCandidate = 5u;
const u32 s_SceneBuffersPerCsgCandidate = 7u;
const usize s_SceneImportedBufferCount = 4u;
const usize s_SceneShadowBufferCount = 5u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Semantic identities selected by the current scene preflight, including direct transform and material edits.
// Runtime deformation is unstamped.
// Static mesh, texture and shader resources remain immutable until invalidation.
class RayTracingSceneContentStamp{
    public RayTracingSceneContentStamp(){
        this.geometry = 0u;
        this.material = 0u;
        this.trusted = false;
    }

    public RayTracingSceneContentStamp(in u64 inGeometry, in u64 inMaterial, in b8 inTrusted){
        this.geometry = inGeometry;
        this.material = inMaterial;
        this.trusted = inTrusted;
    }

    public u64 geometry;
    public u64 material;
    public b8 trusted;
}

class RayTracingDispatchGroups{
    public u32 width = 0u;
    public u32 height = 0u;
    public u32 x = 0u;
    public u32 y = 0u;
}

class RayTracingInstanceWorldBounds{
    public f32x3u minimum(0.0f, 0.0f, 0.0f);
    public f32x3u maximum(0.0f, 0.0f, 0.0f);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


RayTracingDispatchGroups ResolveRayTracingDispatchGroups(in u32 width, in u32 height, in u32 receiverFactor, in u32 groupSize){
    const u32 receiverWidth = divideUp(width, receiverFactor);
    const u32 receiverHeight = divideUp(height, receiverFactor);
    RayTracingDispatchGroups groups;
    groups.width = receiverWidth;
    groups.height = receiverHeight;
    groups.x = divideUp(receiverWidth, groupSize);
    groups.y = divideUp(receiverHeight, groupSize);
    return groups;
}

NwbRtInstanceMaterialGpu ResolveInstanceShadowMaterialData(in u32 surfaceDispatchId, in u32 shadingModelId, in b8 transparent, in b8 refractive, in u32 materialConstantByteOffset, in u32 meshInstanceIndex){
    NwbRtInstanceMaterialGpu material;
    material.surfaceDispatchId = surfaceDispatchId;
    material.shadingModelId = shadingModelId;
    u32 flags = cast<u32>(RtInstanceMaterialFlag::None);
    if(transparent)
        flags |= cast<u32>(RtInstanceMaterialFlag::Transparent);
    if(refractive)
        flags |= cast<u32>(RtInstanceMaterialFlag::Refractive);
    material.flags = flags;
    material.materialConstantByteOffset = materialConstantByteOffset;
    material.meshInstanceIndex = meshInstanceIndex;
    return material;
}

u32 ResolveRayTracingInstanceMask(in b8 transparent, in b8 refractive){
    u32 mask = s_RtOpticalBaseInstanceMask | s_RtShadowBaseInstanceMask;
    if(transparent)
        mask |= s_RtOpticalTransparentInstanceMask | s_RtShadowTransparentInstanceMask;
    if(refractive)
        mask |= s_RtRefractiveInstanceMask;
    return mask;
}

u32 ResolveRayTracingCsgInstanceMask(in b8 transparent){
    u32 mask = s_RtOpticalBaseInstanceMask | s_RtCsgInstanceMask;
    if(transparent)
        mask |= s_RtOpticalTransparentInstanceMask;
    return mask;
}

b8 IsRefractiveInstanceBoundsIsolated(in Span<RayTracingInstanceWorldBounds> instanceWorldBounds, in usize targetIndex){
    if(targetIndex >= instanceWorldBounds.size())
        return false;

    const RayTracingInstanceWorldBounds targetBounds = instanceWorldBounds[targetIndex];
    const f32 expandedMinX = targetBounds.minimum.x - s_RefractionCertifiedBoundsMargin;
    const f32 expandedMinY = targetBounds.minimum.y - s_RefractionCertifiedBoundsMargin;
    const f32 expandedMinZ = targetBounds.minimum.z - s_RefractionCertifiedBoundsMargin;
    const f32 expandedMaxX = targetBounds.maximum.x + s_RefractionCertifiedBoundsMargin;
    const f32 expandedMaxY = targetBounds.maximum.y + s_RefractionCertifiedBoundsMargin;
    const f32 expandedMaxZ = targetBounds.maximum.z + s_RefractionCertifiedBoundsMargin;
    for(usize index = 0u; index < instanceWorldBounds.size(); ++index){
        if(index == targetIndex)
            continue;
        const RayTracingInstanceWorldBounds otherBounds = instanceWorldBounds[index];
        const b8 separated =
            expandedMaxX < otherBounds.minimum.x || otherBounds.maximum.x < expandedMinX
            || expandedMaxY < otherBounds.minimum.y || otherBounds.maximum.y < expandedMinY
            || expandedMaxZ < otherBounds.minimum.z || otherBounds.maximum.z < expandedMinZ
        ;
        if(!separated)
            return false;
    }
    return true;
}

void InflateSwShadowSceneBounds(mut VectorSingle inOutBoundsMin, mut VectorSingle inOutBoundsMax){
    const VectorSingle extent = inOutBoundsMax - inOutBoundsMin;
    const f32 maxExtent = max(extent.x, max(extent.y, extent.z));
    const f32 padding = max(s_SwShadowSceneBoundsMinPadding, maxExtent * s_SwShadowSceneBoundsRelativePadding);
    const VectorSingle paddingVector(padding, padding, padding, 0.0f);
    inOutBoundsMin = inOutBoundsMin - paddingVector;
    inOutBoundsMax = inOutBoundsMax + paddingVector;
}

const usize s_SceneSwBvhInstanceGpuByteSize = 64u;

void CaptureSceneBvhUploadBytes(
    in Span<NwbBvhNodeGpu> nodes,
    in Span<SceneSwBvhInstanceGpu> instances,
    mut Vector<u8> outNodeBytes,
    mut Vector<u8> outInstanceBytes
){
    outNodeBytes.clear();
    outNodeBytes.reserve(nodes.size() * s_NwbBvhNodeGpuByteSize);
    for(in NwbBvhNodeGpu node : nodes)
        AppendPOD(outNodeBytes, node);

    outInstanceBytes.clear();
    outInstanceBytes.reserve(instances.size() * s_SceneSwBvhInstanceGpuByteSize);
    for(in SceneSwBvhInstanceGpu instance : instances)
        AppendPOD(outInstanceBytes, instance);
}

b8 PublishAcceptedSceneBvhUpload(
    in b8 ready,
    in b8 uploadRequired,
    in b8 staticScene,
    in u64 staticSceneHash,
    mut u64 inOutStaticSceneHash,
    mut b8 inOutStaticSceneHashValid
){
    if(!ready || !uploadRequired)
        return false;

    if(staticScene){
        inOutStaticSceneHash = staticSceneHash;
        inOutStaticSceneHashValid = true;
    }
    else
        inOutStaticSceneHashValid = false;
    return true;
}

b8 IsPreparedSceneBvhSnapshotAccepted(
    in b8 uploadRequired,
    in b8 staticScene,
    in b8 staticSceneHashValid,
    in u64 currentStaticSceneHash,
    in u64 expectedStaticSceneHash,
    in usize currentInstanceCount,
    in usize expectedInstanceCount
){
    return uploadRequired
        || (staticScene && staticSceneHashValid && currentStaticSceneHash == expectedStaticSceneHash && currentInstanceCount == expectedInstanceCount);
}

b8 ValidatePreparedSceneBvhRetainState(
    in b8 storageMatches,
    in b8 storageReady,
    in b8 uploadRequired,
    in b8 staticScene,
    in b8 staticSceneHashValid,
    in u64 currentStaticSceneHash,
    in u64 expectedStaticSceneHash,
    in usize currentInstanceCount,
    in usize expectedInstanceCount,
    in usize nodeByteCount,
    in usize expectedNodeCount,
    in usize instanceByteCount
){
    if(!storageMatches || !storageReady){
        error("RendererSystem: frozen software scene-BVH identity no longer matches preflight storage");
        return false;
    }
    if(!uploadRequired){
        if(!staticScene || !staticSceneHashValid || currentStaticSceneHash != expectedStaticSceneHash || currentInstanceCount != expectedInstanceCount){
            error("RendererSystem: frozen software scene-BVH cache identity is no longer accepted");
            return false;
        }
        return true;
    }
    if(
        nodeByteCount == 0u
        || instanceByteCount == 0u
        || nodeByteCount != expectedNodeCount * s_NwbBvhNodeGpuByteSize
        || instanceByteCount != expectedInstanceCount * s_SceneSwBvhInstanceGpuByteSize
    ){
        error("RendererSystem: frozen software scene-BVH payload is incomplete");
        return false;
    }
    return true;
}

void ApplyConfirmedMeshBlasBuildState(
    in b8 firstBuild,
    in b8 performRefit,
    in u32 refitsAfterBuild,
    in u64 geometryContentRevision,
    in u64 positionByteSize,
    mut b8 outBlasBuildPending,
    mut b8 outBlasBackingFresh,
    mut u32 outBlasRefitsSinceRebuild,
    mut b8 outBlasBuildAccepted,
    mut u64 outBlasGeometryContentRevision,
    mut u64 inOutFirstBuilds,
    mut u64 inOutRefits,
    mut u64 inOutRebuilds,
    mut u64 inOutUploadedBytes
){
    outBlasBuildPending = false;
    outBlasBackingFresh = false;
    outBlasRefitsSinceRebuild = refitsAfterBuild;
    outBlasBuildAccepted = true;
    outBlasGeometryContentRevision = geometryContentRevision;
    if(firstBuild)
        inOutFirstBuilds += 1u;
    else if(performRefit)
        inOutRefits += 1u;
    else
        inOutRebuilds += 1u;
    inOutUploadedBytes += positionByteSize;
}

void ApplyConfirmedMeshSwBvhBuildState(
    in b8 performRefit,
    in u32 refitsAfterBuild,
    in u64 geometryContentRevision,
    mut b8 outSwBvhBuildPending,
    mut b8 outSwBvhBuildAccepted,
    mut u64 outSwBvhGeometryContentRevision,
    mut b8 inOutSwBvhTopologyBuilt,
    mut u32 outSwBvhRefitsSinceRebuild
){
    outSwBvhBuildPending = false;
    outSwBvhBuildAccepted = true;
    outSwBvhGeometryContentRevision = geometryContentRevision;
    if(!performRefit)
        inOutSwBvhTopologyBuilt = true;
    outSwBvhRefitsSinceRebuild = refitsAfterBuild;
}

void InitializeCreatedMeshBlasState(
    mut b8 outBlasBuildPending,
    mut b8 outBlasBuildAccepted,
    mut u64 outBlasGeometryContentRevision,
    mut b8 outBlasBackingFresh,
    mut u32 outBlasRefitsSinceRebuild
){
    outBlasBuildPending = true;
    outBlasBuildAccepted = false;
    outBlasGeometryContentRevision = 0u;
    outBlasBackingFresh = true;
    outBlasRefitsSinceRebuild = 0u;
}

void PublishConfirmedSceneTlasBuild(
    in b8 preparedTlasMatchesCurrent,
    in b8 staticScene,
    in u64 staticSceneHash,
    mut u64 inOutTlasStaticSceneHash,
    mut b8 outTlasStaticSceneHashValid,
    mut b8 inOutTlasBackingFresh
){
    if(preparedTlasMatchesCurrent && staticScene){
        inOutTlasStaticSceneHash = staticSceneHash;
        outTlasStaticSceneHashValid = true;
    }
    else
        outTlasStaticSceneHashValid = false;
    if(preparedTlasMatchesCurrent)
        inOutTlasBackingFresh = false;
}

void LogShadowMeshHeapHighWaterIfNeeded(
    in b8 hardware,
    in u32 meshCount,
    mut u32 inOutHighWater
){
    if(meshCount <= inOutHighWater)
        return;
    inOutHighWater = meshCount;
    StringView routeLabel = "SW";
    u64 bufferCountPerMesh = s_SoftwareRayTracingMeshBufferCount;
    if(hardware){
        routeLabel = "HW";
        bufferCountPerMesh = s_HardwareRayTracingMeshBufferCount;
    }
    info(
        "RendererSystem: {}-shadow heap registration high-water: {} distinct meshes -> {} handles"
        , routeLabel
        , cast<u64>(meshCount)
        , cast<u64>(meshCount) * bufferCountPerMesh
    );
}

void LogUnsupportedCausticVolumesIfNeeded(
    in b8 traceResourcesPreflighted,
    in u32 causticLightCount,
    in u32 unsupportedCausticVolumeCount,
    in u64 unsupportedCausticVolumeHash,
    in u32 firstUnsupportedCausticVolumeEntity,
    mut b8 inOutUnsupportedCausticVolumeReported,
    mut u64 inOutReportedUnsupportedCausticVolumeHash
){
    if(
        !traceResourcesPreflighted
        || causticLightCount == 0u
        || unsupportedCausticVolumeCount == 0u
        || (inOutUnsupportedCausticVolumeReported && inOutReportedUnsupportedCausticVolumeHash == unsupportedCausticVolumeHash)
    )
        return;
    inOutReportedUnsupportedCausticVolumeHash = unsupportedCausticVolumeHash;
    inOutUnsupportedCausticVolumeReported = true;
    warning(
        "RendererSystem: caustic photons unavailable: {} refractive volume(s) need an explicit closed homogeneous optical boundary mode (first entity {})"
        , unsupportedCausticVolumeCount
        , firstUnsupportedCausticVolumeEntity
    );
}

void LogCausticEmissionGateIfNeeded(
    in u32 causticLightCount,
    in u32 causticRefractiveInstanceCount,
    in VectorSingle boundsMin,
    in VectorSingle boundsMax,
    in Span<SceneLightGpuData> lights,
    mut b8 inOutCausticEmissionGateLogged
){
    if(inOutCausticEmissionGateLogged)
        return;
    inOutCausticEmissionGateLogged = true;

    [essential]
    info(
        "RendererSystem: caustic P1 -- {} caustic light(s); {} refractive emission target(s), combined extent min ({}, {}, {}) max ({}, {}, {})"
        , causticLightCount
        , causticRefractiveInstanceCount
        , boundsMin.x
        , boundsMin.y
        , boundsMin.z
        , boundsMax.x
        , boundsMax.y
        , boundsMax.z
    );

    const u32 lightCount = cast<u32>(lights.size());
    for(u32 i = 0u; i < lightCount; ++i){
        const SceneLightGpuData light = lights[cast<usize>(i)];
        if(light.params.w < 0.0f)
            continue;
        StringView lightKind = "spot";
        if(light.params.y < s_LightTypeDirectionalMax)
            lightKind = "directional";
        [essential]
        info(
            "RendererSystem: caustic P1 -- caustic slot {} -> light index {} ({})"
            , cast<u32>(light.params.w)
            , i
            , lightKind
        );
    }
}

void LogRayTracingCapabilityIfNeeded(
    in b8 accelStructSupported,
    in b8 pipelineSupported,
    in b8 rayQuerySupported,
    mut b8 inOutCapabilityLogged
){
    if(inOutCapabilityLogged)
        return;
    inOutCapabilityLogged = true;
    info(
        "RendererSystem: ray tracing capability - accel struct {}, pipeline {}, ray query {}"
        , accelStructSupported
        , pipelineSupported
        , rayQuerySupported
    );
}


