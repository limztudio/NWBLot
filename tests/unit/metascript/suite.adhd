void VerifyAdhdCompiler_RejectsConstReferenceReturnViolationsAndInvalidContainerTemplateArity(){
    AdhdTestArena arena = AdhdTestArena();
    ExpectCompileFails(arena, "mut i32 BadMutReturn(in i32 x) {\r\n    return x;\r\n}\r\n", "impl/sim/bad_mut_ret.adhd");
