Expected<PhysicsDepCheckEntry> ParsePhysicsDepEntryWithPrefix(
    in Name virtualPath,
    in Path file,
    in MetascriptValue value,
    in StringView diagnosticPrefix,
    in b8 requireMap
){
    PhysicsDepCheckEntry entry;
    b8 validMap = false;
    if(requireMap)
        validMap = CheckMetadataAssetMap(file, value, diagnosticPrefix);
    else
        validMap = ValidateOptionalSceneMetadataMap(file, value, diagnosticPrefix);
    if(!validMap || !AssignCookEntryVirtualPath(virtualPath, file, diagnosticPrefix, entry))
        return MakeUnexpected(Failure());
    return entry;
}

[cpp_header("<core/assets/cook_metadata.h>"), cpp_name("::NWB::Core::Assets::ReadCookDependencyWith")]
extern Expected<T> ReadPhysicsCookDependencyWith<T>(in CookDependencyItemContext context, in StringView prefix, in auto reader);

b8 ExtractSimplePhysicsDepEntry(
    in CookDependencyItemContext context,
    in StringView diagnosticPrefix,
    in b8 requireMap
){
    return ReadPhysicsCookDependencyWith<PhysicsDepCheckEntry>(
        context,
        diagnosticPrefix,
        lambda[in diagnosticPrefix, in requireMap](in Name virtualPath, in auto file, in MetascriptValue value) -> Expected<PhysicsDepCheckEntry>{
            return ParsePhysicsDepEntryWithPrefix(virtualPath, file, value, diagnosticPrefix, requireMap);
        }
    ).has_value();
}

b8 IsPhysicsExternalSourceFieldKey(in StringView key){
    return key == "source_mesh"
        || key == "source_heightmap"
        || key == "hole_mask_image"
        || key == "source_material"
        || key == "source_tet_mesh"
        || key == "urdf_file"
        || key == "mjcf_file"
        || key == "source_skeleton"
    ;
}

b8 CollectSourceFileDepsFromValue(
    in Path nwbFile,
    in StringView diagnosticPrefix,
    in MetascriptValue value,
    mut ICookDependencyCollector collector
){
    if(value.isMap()){
        return value.forEachMapEntry(lambda[in nwbFile, in diagnosticPrefix, mut collector](in StringView key, in MetascriptValue fieldVal) -> b8{
            if(IsPhysicsExternalSourceFieldKey(key)){
                const Expected<StringView> srcRes = ReadPhysicsStringValue(nwbFile, fieldVal, diagnosticPrefix, key);
                if(!srcRes.has_value())
                    return false;
                Path resolved;
                ResolvePhysicsSourcePath(nwbFile, srcRes.value(), resolved);
                if(!collector.addSourceFileDependency(resolved))
                    return false;
                if(key == "source_mesh" && (HasCaseInsensitiveExtensionSuffix(srcRes.value(), ".gltf") || HasCaseInsensitiveExtensionSuffix(srcRes.value(), ".glb"))){
                    b8 collectorOk = true;
                    const b8 gltfOk = CollectGltfExternalBufferPaths(
                        resolved,
                        lambda[mut collector, mut collectorOk](in StringView bufPathText) -> b8{
                            const Path bufPath(bufPathText);
                            if(!collector.addSourceFileDependency(bufPath)){
                                collectorOk = false;
                                return false;
                            }
                            return true;
                        }
                    );
                    if(!collectorOk)
                        return false;
                    if(!gltfOk)
                        return true;
                }
                if(key == "source_tet_mesh" && HasCaseInsensitiveExtensionSuffix(srcRes.value(), ".node") && srcRes.value().size() >= 5u){
                    String eleRef;
                    eleRef.assign(srcRes.value().substr(0u, srcRes.value().size() - 5u));
                    eleRef.append(".ele");
                    Path eleResolved;
                    ResolvePhysicsSourcePath(nwbFile, StringView(eleRef), eleResolved);
                    if(!collector.addSourceFileDependency(eleResolved))
                        return false;
                }
                return true;
            }
            return CollectSourceFileDepsFromValue(nwbFile, diagnosticPrefix, fieldVal, collector);
        });
    }
    if(value.isList()){
        const Span<MetascriptValue> items = value.listView();
        for(usize i = 0u; i < items.size(); ++i){
            if(!CollectSourceFileDepsFromValue(nwbFile, diagnosticPrefix, items[i], collector))
                return false;
        }
    }
    return true;
}

b8 ReadOptionalPhysicsDepRef<T>(
    in Path file,
    in MetascriptValue mapVal,
    in StringView diagnosticPrefix,
    in StringView key,
    mut AssetRef<T> outRef
){
    const Optional<in MetascriptValue> fieldOpt = mapVal.borrowField(key);
    if(!fieldOpt.has_value())
        return true;
    return ReadPhysicsAssetRefValue<T>(file, fieldOpt.value(), diagnosticPrefix, key, outRef);
}

b8 ReadOptionalPhysicsDepRefList<T>(
    in Path file,
    in MetascriptValue mapVal,
    in StringView diagnosticPrefix,
    in StringView key,
    mut Vector<AssetRef<T>> outRefs
){
    const Optional<in MetascriptValue> fieldOpt = mapVal.borrowField(key);
    if(!fieldOpt.has_value())
        return true;
    Vector<AssetRef<T>> parsed;
    if(!ReadPhysicsAssetRefListValue<T>(file, fieldOpt.value(), diagnosticPrefix, key, parsed))
        return false;
    for(usize i = 0u; i < parsed.size(); ++i){
        if(parsed[i].valid())
            outRefs.push_back(parsed[i]);
    }
    return true;
}

b8 CollectCompoundSubShapeDeps(
    in Path file,
    in MetascriptValue mapVal,
    mut PhysicsColliderDepEntry entry
){
    const Optional<in MetascriptValue> subsOpt = mapVal.borrowField("compound_sub_shapes");
    if(!subsOpt.has_value())
        return true;
    if(!subsOpt.value().isList()){
        error("{} '{}': field 'compound_sub_shapes' must be a list of sub-shape maps", s_ColliderComponentDiagnosticPrefix, PathToString(file));
        return false;
    }
    const Span<MetascriptValue> items = subsOpt.value().listView();
    for(usize i = 0u; i < items.size(); ++i){
        in MetascriptValue item = items[i];
        if(!item.isMap()){
            error("{} '{}': 'compound_sub_shapes[{}]' must be a map", s_ColliderComponentDiagnosticPrefix, PathToString(file), i);
            return false;
        }
        AssetRef<PhysicsMaterialAsset> subMat;
        AssetRef<ConvexHullAsset> subHull;
        AssetRef<Mesh> subMesh;
        AssetRef<CollisionMeshAsset> subCollisionMesh;
        AssetRef<ChainShapeAsset> subChain;
        AssetRef<SdfAsset> subSdf;
        if(
            !ReadOptionalPhysicsDepRef<PhysicsMaterialAsset>(file, item, s_ColliderComponentDiagnosticPrefix, "material_asset", subMat)
            || !ReadOptionalPhysicsDepRef<ConvexHullAsset>(file, item, s_ColliderComponentDiagnosticPrefix, "convex_hull_asset", subHull)
            || !ReadOptionalPhysicsDepRef<Mesh>(file, item, s_ColliderComponentDiagnosticPrefix, "mesh_asset", subMesh)
            || !ReadOptionalPhysicsDepRef<CollisionMeshAsset>(file, item, s_ColliderComponentDiagnosticPrefix, "collision_mesh_asset", subCollisionMesh)
            || !ReadOptionalPhysicsDepRef<ChainShapeAsset>(file, item, s_ColliderComponentDiagnosticPrefix, "chain_asset", subChain)
            || !ReadOptionalPhysicsDepRef<SdfAsset>(file, item, s_ColliderComponentDiagnosticPrefix, "sdf_asset", subSdf)
        )
            return false;
        if(subMat.valid())
            entry.extraMaterialAssets.push_back(subMat);
        if(subHull.valid())
            entry.extraConvexHullAssets.push_back(subHull);
        if(subMesh.valid())
            entry.extraMeshAssets.push_back(subMesh);
        if(subCollisionMesh.valid())
            entry.extraCollisionMeshAssets.push_back(subCollisionMesh);
        if(subChain.valid())
            entry.extraChainAssets.push_back(subChain);
        if(subSdf.valid())
            entry.extraSdfAssets.push_back(subSdf);
    }
    return true;
}

Expected<PhysicsColliderDepEntry> ParseColliderDepEntry(in Name virtualPath, in Path file, in MetascriptValue value){
    PhysicsColliderDepEntry entry;
    if(!ValidateOptionalSceneMetadataMap(file, value, s_ColliderComponentDiagnosticPrefix)
        || !AssignCookEntryVirtualPath(virtualPath, file, s_ColliderComponentDiagnosticPrefix, entry))
        return MakeUnexpected(Failure());
    if(!value.isMap())
        return entry;
    if(
        !ReadOptionalPhysicsDepRef<Mesh>(file, value, s_ColliderComponentDiagnosticPrefix, "mesh_asset", entry.meshAsset)
        || !ReadOptionalPhysicsDepRef<PhysicsMaterialAsset>(file, value, s_ColliderComponentDiagnosticPrefix, "material_asset", entry.materialAsset)
        || !ReadOptionalPhysicsDepRef<ConvexHullAsset>(file, value, s_ColliderComponentDiagnosticPrefix, "convex_hull_asset", entry.convexHullAsset)
        || !ReadOptionalPhysicsDepRef<CompoundHullAsset>(file, value, s_ColliderComponentDiagnosticPrefix, "compound_hull_asset", entry.compoundHullAsset)
        || !ReadOptionalPhysicsDepRef<CollisionMeshAsset>(file, value, s_ColliderComponentDiagnosticPrefix, "collision_mesh_asset", entry.collisionMeshAsset)
        || !ReadOptionalPhysicsDepRef<HeightfieldAsset>(file, value, s_ColliderComponentDiagnosticPrefix, "heightfield_asset", entry.heightfieldAsset)
        || !ReadOptionalPhysicsDepRef<SdfAsset>(file, value, s_ColliderComponentDiagnosticPrefix, "sdf_asset", entry.sdfAsset)
        || !ReadOptionalPhysicsDepRef<ChainShapeAsset>(file, value, s_ColliderComponentDiagnosticPrefix, "chain_asset", entry.chainAsset)
        || !ReadOptionalPhysicsDepRef<CompoundShapeAsset>(file, value, s_ColliderComponentDiagnosticPrefix, "compound_shape_asset", entry.compoundShapeAsset)
        || !ReadOptionalPhysicsDepRefList<PhysicsMaterialAsset>(file, value, s_ColliderComponentDiagnosticPrefix, "heightfield_material_assets", entry.extraMaterialAssets)
        || !ReadOptionalPhysicsDepRefList<PhysicsMaterialAsset>(file, value, s_ColliderComponentDiagnosticPrefix, "chain_material_assets", entry.extraMaterialAssets)
        || !CollectCompoundSubShapeDeps(file, value, entry)
    )
        return MakeUnexpected(Failure());
    const Optional<in MetascriptValue> extraOpt = value.borrowField("extra_shapes");
    if(extraOpt.has_value()){
        if(!extraOpt.value().isList()){
            error("{} '{}': field 'extra_shapes' must be a list of collider maps", s_ColliderComponentDiagnosticPrefix, PathToString(file));
            return MakeUnexpected(Failure());
        }
        const Span<MetascriptValue> items = extraOpt.value().listView();
        for(usize i = 0u; i < items.size(); ++i){
            in MetascriptValue item = items[i];
            if(!item.isMap()){
                error("{} '{}': 'extra_shapes[{}]' must be a map", s_ColliderComponentDiagnosticPrefix, PathToString(file), i);
                return MakeUnexpected(Failure());
            }
            AssetRef<Mesh> extraMesh;
            AssetRef<PhysicsMaterialAsset> extraMat;
            AssetRef<ConvexHullAsset> extraHull;
            AssetRef<CompoundHullAsset> extraCompoundHull;
            AssetRef<CollisionMeshAsset> extraCollisionMesh;
            AssetRef<HeightfieldAsset> extraHeightfield;
            AssetRef<SdfAsset> extraSdf;
            AssetRef<ChainShapeAsset> extraChain;
            AssetRef<CompoundShapeAsset> extraCompoundShape;
            if(
                !ReadOptionalPhysicsDepRef<Mesh>(file, item, s_ColliderComponentDiagnosticPrefix, "mesh_asset", extraMesh)
                || !ReadOptionalPhysicsDepRef<PhysicsMaterialAsset>(file, item, s_ColliderComponentDiagnosticPrefix, "material_asset", extraMat)
                || !ReadOptionalPhysicsDepRef<ConvexHullAsset>(file, item, s_ColliderComponentDiagnosticPrefix, "convex_hull_asset", extraHull)
                || !ReadOptionalPhysicsDepRef<CompoundHullAsset>(file, item, s_ColliderComponentDiagnosticPrefix, "compound_hull_asset", extraCompoundHull)
                || !ReadOptionalPhysicsDepRef<CollisionMeshAsset>(file, item, s_ColliderComponentDiagnosticPrefix, "collision_mesh_asset", extraCollisionMesh)
                || !ReadOptionalPhysicsDepRef<HeightfieldAsset>(file, item, s_ColliderComponentDiagnosticPrefix, "heightfield_asset", extraHeightfield)
                || !ReadOptionalPhysicsDepRef<SdfAsset>(file, item, s_ColliderComponentDiagnosticPrefix, "sdf_asset", extraSdf)
                || !ReadOptionalPhysicsDepRef<ChainShapeAsset>(file, item, s_ColliderComponentDiagnosticPrefix, "chain_asset", extraChain)
                || !ReadOptionalPhysicsDepRef<CompoundShapeAsset>(file, item, s_ColliderComponentDiagnosticPrefix, "compound_shape_asset", extraCompoundShape)
                || !ReadOptionalPhysicsDepRefList<PhysicsMaterialAsset>(file, item, s_ColliderComponentDiagnosticPrefix, "heightfield_material_assets", entry.extraMaterialAssets)
                || !ReadOptionalPhysicsDepRefList<PhysicsMaterialAsset>(file, item, s_ColliderComponentDiagnosticPrefix, "chain_material_assets", entry.extraMaterialAssets)
                || !CollectCompoundSubShapeDeps(file, item, entry)
            )
                return MakeUnexpected(Failure());
            if(extraMesh.valid())
                entry.extraMeshAssets.push_back(extraMesh);
            if(extraMat.valid())
                entry.extraMaterialAssets.push_back(extraMat);
            if(extraHull.valid())
                entry.extraConvexHullAssets.push_back(extraHull);
            if(extraCompoundHull.valid())
                entry.extraCompoundHullAssets.push_back(extraCompoundHull);
            if(extraCollisionMesh.valid())
                entry.extraCollisionMeshAssets.push_back(extraCollisionMesh);
            if(extraHeightfield.valid())
                entry.extraHeightfieldAssets.push_back(extraHeightfield);
            if(extraSdf.valid())
                entry.extraSdfAssets.push_back(extraSdf);
            if(extraChain.valid())
                entry.extraChainAssets.push_back(extraChain);
            if(extraCompoundShape.valid())
                entry.extraCompoundShapeAssets.push_back(extraCompoundShape);
        }
    }
    return entry;
}

Expected<PhysicsWorldConfigDepEntry> ParsePhysicsWorldConfigDepEntry(in Name virtualPath, in Path file, in MetascriptValue value){
    PhysicsWorldConfigDepEntry entry;
    if(!ValidateOptionalSceneMetadataMap(file, value, s_PhysicsWorldConfigComponentDiagnosticPrefix)
        || !AssignCookEntryVirtualPath(virtualPath, file, s_PhysicsWorldConfigComponentDiagnosticPrefix, entry))
        return MakeUnexpected(Failure());
    if(!value.isMap())
        return entry;
    if(!ReadOptionalPhysicsDepRef<CollisionLayerMatrixAsset>(file, value, s_PhysicsWorldConfigComponentDiagnosticPrefix, "collision_layer_matrix_asset", entry.collisionLayerMatrixAsset))
        return MakeUnexpected(Failure());
    return entry;
}

