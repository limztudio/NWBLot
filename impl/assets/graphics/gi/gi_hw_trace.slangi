////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_GI_HW_TRACE_SLANGI
#define NWB_GRAPHICS_GI_HW_TRACE_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "constants.h"
#include "../bvh/constants.h"
#include "../bvh/ray_vertex_attrib.slangi"
#include "../raytrace/constants.h"
#include "../deferred/bindless_resources.slangi"
#include "../raytrace/material_context_slots.slangi"
#include "../bvh/bindless_heap_rt.slangi"
#include "surfel/surfel_heap_resources.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "gi_trace_bindless.slangi"

#if NWB_GI_CSG_ENABLED
#define NWB_CSG_RAY_HARDWARE 1
#endif
#include "gi_geometry.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#if NWB_GI_CSG_ENABLED
bool nwbGiHwWalkCsgReceivers<let OcclusionOnly : bool>(const float3 origin, const float3 direction, const float minimum, const float maximum, inout NwbGiGeometryHit closest){
    const uint contextSlot = g_NwbGiMaterialContextSlots.materialSlots.w;
    const uint materialSlot = g_NwbGiMaterialContextSlots.sceneSlots.z;
    const uint activeOffset = nwbHeapRawBufferUniform(contextSlot).Load(NWB_CSG_RAY_CONTEXT_ACTIVE_BASE_OFFSET);
    const uint activeCount = nwbHeapRawBufferUniform(contextSlot).Load(NWB_CSG_RAY_CONTEXT_ACTIVE_COUNT_OFFSET);
    for(uint index = 0u; index < activeCount; ++index){
        const uint instanceIndex = nwbHeapRawBufferUniform(contextSlot).Load(activeOffset + index * NWB_CSG_RAY_ACTIVE_INDEX_BYTES);
        const NwbSwBvhInstance instance = nwbCsgRayLoadInstance(contextSlot, instanceIndex);
        const NwbBvhNode root = nwbCsgRayReceiverRoot(contextSlot, instanceIndex, instance);
        const float maxDistance = OcclusionOnly ? maximum : closest.distance;
        if(!nwbCsgRayBoundsIntersect(instance, root, origin, direction, minimum, maxDistance))
            continue;
        if(OcclusionOnly){
            if(nwbGiCsgOccluded(contextSlot, materialSlot, instanceIndex, origin, direction, minimum, maximum))
                return true;
        }
        else{
            const NwbGiGeometryHit geometry = nwbGiCsgGeometryHit(contextSlot, materialSlot, instanceIndex, origin, direction, minimum, closest.distance);
            if(geometry.hit)
                closest = geometry;
            if(closest.failure != 0u)
                return false;
        }
    }
    return false;
}
#endif

NwbGiTraceHit nwbGiTraceClosest(float3 origin, float3 direction, float tMin, float tMax){
    NwbGiGeometryHit geometry = nwbGiEmptyGeometryHit(tMax);
    RayDesc ray;
    ray.Origin = origin;
    ray.Direction = direction;
    ray.TMin = tMin;
    ray.TMax = tMax;
    RayQuery<RAY_FLAG_FORCE_OPAQUE> query;
#if NWB_GI_CSG_ENABLED
    query.TraceRayInline(nwbHeapAccelStruct(), RAY_FLAG_FORCE_OPAQUE, NWB_RT_SHADOW_BASE_INSTANCE_MASK, ray);
#else
    query.TraceRayInline(nwbHeapAccelStruct(), RAY_FLAG_FORCE_OPAQUE, NWB_RAY_TRACING_ALL_INSTANCE_MASK, ray);
#endif
    while(query.Proceed()){}
    float3x4 worldToObject = float3x4(0.0);
    if(query.CommittedStatus() == COMMITTED_TRIANGLE_HIT){
        geometry.hit = true;
        geometry.instance = query.CommittedInstanceID();
        geometry.primitive = query.CommittedPrimitiveIndex();
        geometry.distance = query.CommittedRayT();
        geometry.barycentrics = query.CommittedTriangleBarycentrics();
        worldToObject = query.CommittedWorldToObject3x4();
#if NWB_GI_CSG_ENABLED
        geometry.cutter = NWB_CSG_RAY_INVALID_INDEX;
#endif
    }
#if NWB_GI_CSG_ENABLED
    nwbGiHwWalkCsgReceivers<false>(origin, direction, tMin, tMax, geometry);
    if(geometry.hit && geometry.failure == 0u){
        const NwbRtInstanceMaterial material = nwbHeapRtInstanceMaterials(g_NwbGiMaterialContextSlots.sceneSlots.z)[geometry.instance];
        if((material.flags & NWB_RT_INSTANCE_MATERIAL_FLAG_CSG_SHADOW) != 0u)
            worldToObject = nwbCsgRayWorldToObject(nwbCsgRayLoadInstance(g_NwbGiMaterialContextSlots.materialSlots.w, geometry.instance));
    }
#endif
    if(
        geometry.hit && geometry.failure == 0u
#if NWB_GI_CSG_ENABLED
        && geometry.cutter == NWB_CSG_RAY_INVALID_INDEX
#endif
    ){
        const NwbRtInstanceMaterial material = nwbHeapRtInstanceMaterials(g_NwbGiMaterialContextSlots.sceneSlots.z)[geometry.instance];
#if NWB_GI_CSG_ENABLED
        if((material.flags & NWB_RT_INSTANCE_MATERIAL_FLAG_CSG_SHADOW) == 0u)
#endif
        {
            const uint3 indices = nwbHeapRawBuffer(material.indexSlot).Load3(geometry.primitive * NWB_RAYTRACE_TRIANGLE_CORNER_COUNT * NWB_RAYTRACE_INDEX_STRIDE_BYTES);
            const float3 v0 = asfloat(nwbHeapRawBuffer(material.positionSlot).Load3(indices.x * NWB_RAYTRACE_POSITION_STRIDE_BYTES));
            const float3 v1 = asfloat(nwbHeapRawBuffer(material.positionSlot).Load3(indices.y * NWB_RAYTRACE_POSITION_STRIDE_BYTES));
            const float3 v2 = asfloat(nwbHeapRawBuffer(material.positionSlot).Load3(indices.z * NWB_RAYTRACE_POSITION_STRIDE_BYTES));
            const float3 objectNormal = normalize(cross(v1 - v0, v2 - v0));
            geometry.normal = nwbSafeNormalize(nwbGiTransformNormal(worldToObject, objectNormal), float3(0.0, 0.0, 1.0));
        }
    }
    return nwbGiReconstructHit(geometry, g_NwbGiMaterialContextSlots.sceneSlots.z, worldToObject, origin, direction);
}

bool nwbGiTraceOccluded(float3 origin, float3 direction, float tMin, float tMax){
    RayDesc ray;
    ray.Origin = origin;
    ray.Direction = direction;
    ray.TMin = tMin;
    ray.TMax = tMax;
    RayQuery<RAY_FLAG_FORCE_OPAQUE | RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH> query;
#if NWB_GI_CSG_ENABLED
    query.TraceRayInline(nwbHeapAccelStruct(), RAY_FLAG_FORCE_OPAQUE | RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH, NWB_RT_SHADOW_BASE_INSTANCE_MASK, ray);
#else
    query.TraceRayInline(nwbHeapAccelStruct(), RAY_FLAG_FORCE_OPAQUE | RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH, NWB_RAY_TRACING_ALL_INSTANCE_MASK, ray);
#endif
    while(query.Proceed()){}
    if(query.CommittedStatus() == COMMITTED_TRIANGLE_HIT)
        return true;
#if NWB_GI_CSG_ENABLED
    NwbGiGeometryHit unusedHit = nwbGiEmptyGeometryHit(tMax);
    return nwbGiHwWalkCsgReceivers<true>(origin, direction, tMin, tMax, unusedHit);
#else
    return false;
#endif
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


