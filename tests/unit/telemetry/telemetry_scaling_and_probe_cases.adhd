const StringView s_ScalingTargetText = "target";

class ContributionFailure{}

class PendingNameFrameGraphContributor : IFrameGraphContributor{
    public b8 appendFrameGraph(mut FrameGraphBuilder builder)override{
        const auto source = builder.addPass(s_TelemetryCaseSource, "Source");
        const auto target = builder.addResource(Name(s_ScalingTargetText), "Target");
        const auto duplicateTarget = builder.addResource(Name(s_ScalingTargetText), "Duplicate Target");
        if(!target.valid() || !duplicateTarget.valid())
            return false;
        builder.dependsOnByName(source, Name(s_ScalingTargetText), 7u);
        builder.dependsOnByName(source, s_TelemetryCaseMissing, 9u);
        return true;
    }
}

class LocalLabelContributor : IFrameGraphContributor{
    public b8 appendFrameGraph(mut FrameGraphBuilder builder)override{
        String label = String("local label");
        const auto node = builder.addPass(s_TelemetryCaseLocalLabel, StringView(label));
        label[0u] = 88u;
        return node.valid();
    }
}

class MutatingContributor : IFrameGraphContributor{
    private mut FrameGraphRegistry m_registry;
    private Optional<mut IFrameGraphContributor> m_removeOther;
    private Optional<mut IFrameGraphContributor> m_addOther;
    public usize calls = 0u;
    public b8 removeSelf = false;
    public b8 clearRegistry = false;
    public b8 throwAfterMutation = false;
    public MutatingContributor(mut FrameGraphRegistry registry){ this.m_registry = registry; }
    [cpp_unwind]
    public b8 appendFrameGraph(mut FrameGraphBuilder builder)override{
        ++this.calls;
        const auto node = builder.addPass(s_TelemetryCaseMutation, "mutation");
        if(this.clearRegistry)
            this.m_registry.clear();
        if(this.removeSelf)
            this.m_registry.unregisterContributor(this);
        if(this.m_removeOther.has_value())
            this.m_registry.unregisterContributor(this.m_removeOther.value());
        if(this.m_addOther.has_value())
            this.m_registry.registerContributor(this.m_addOther.value());
        if(this.throwAfterMutation)
            ThrowTestException<ContributionFailure>(ContributionFailure());
        return node.valid();
    }
    public void setRemoveOther(mut IFrameGraphContributor other){ this.m_removeOther = Optional<mut IFrameGraphContributor>(other); }
    public void setAddOther(mut IFrameGraphContributor other){ this.m_addOther = Optional<mut IFrameGraphContributor>(other); }
}

class OwnedLabelContributor : IFrameGraphContributor{
    private mut FrameGraphRegistry m_registry;
    private TelemetryLabelString m_label;
    public OwnedLabelContributor(mut FrameGraphRegistry registry, mut HeapStorage arena){
        this.m_registry = registry;
        this.m_label = TelemetryLabelString("label retained after contributor destruction", arena);
    }
    public b8 appendFrameGraph(mut FrameGraphBuilder builder)override{
        const auto node = builder.addPass(s_TelemetryCaseOwnedLabel, StringView(this.m_label));
        this.m_registry.unregisterContributor(this);
        return node.valid();
    }
}

class DestroyContributor : IFrameGraphContributor{
    private mut Optional<OwnedLabelContributor> m_target;
    public DestroyContributor(mut Optional<OwnedLabelContributor> target){ this.m_target = target; }
    public b8 appendFrameGraph(mut FrameGraphBuilder builder)override{
        this.m_target.reset();
        return builder.addPass(s_TelemetryCaseDestroyer, "destroyer").valid();
    }
}

class CacheLifetimeContributor : IFrameGraphContributor{
    private mut FrameGraphRegistry m_registry;
    private mut CaptureSession m_session;
    private in TelemetryLabelString m_label;
    public b8 m_throwNext = true;
    public b8 m_reentryRejected = false;
    public CacheLifetimeContributor(mut FrameGraphRegistry registry, mut CaptureSession session, in TelemetryLabelString label){
        this.m_registry = registry;
        this.m_session = session;
        this.m_label = label;
    }
    [cpp_unwind]
    public b8 appendFrameGraph(mut FrameGraphBuilder builder)override{
        if(!builder.addPass(s_TelemetryCaseCacheLifetime, StringView(this.m_label)).valid())
            return false;
        if(this.m_throwNext){
            this.m_throwNext = false;
            ThrowTestException<ContributionFailure>(ContributionFailure());
        }
        this.m_reentryRejected = !this.m_registry.record(this.m_session);
        return true;
    }
}

