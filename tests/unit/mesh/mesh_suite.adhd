Impl::MeshSkinningGraphDispatchPlan MakePlan(const u32 offset, const u64 generation)noexcept{
    Impl::MeshSkinningGraphDispatchPlan plan;
    plan.bindlessResourceSlotsResource = { .generation = generation, .index = static_cast<u32>(offset + 1u) };
    plan.restPositionResource = { .generation = generation, .index = static_cast<u32>(offset + 2u) };
    plan.restNormalResource = { .generation = generation, .index = static_cast<u32>(offset + 3u) };
    plan.restTangentResource = { .generation = generation, .index = static_cast<u32>(offset + 4u) };
    plan.skinnedPositionResource = { .generation = generation, .index = static_cast<u32>(offset + 5u) };
    plan.skinnedNormalResource = { .generation = generation, .index = static_cast<u32>(offset + 6u) };
    plan.skinnedTangentResource = { .generation = generation, .index = static_cast<u32>(offset + 7u) };
    plan.meshletDescResource = { .generation = generation, .index = static_cast<u32>(offset + 8u) };
    plan.meshletBoundsResource = { .generation = generation, .index = static_cast<u32>(offset + 9u) };
    plan.meshletPositionRefDeltaResource = { .generation = generation, .index = static_cast<u32>(offset + 10u) };
    plan.meshletAttributeRefDeltaResource = { .generation = generation, .index = static_cast<u32>(offset + 11u) };
    plan.meshletLocalVertexRefResource = { .generation = generation, .index = static_cast<u32>(offset + 12u) };
    plan.meshletPrimitiveIndexResource = { .generation = generation, .index = static_cast<u32>(offset + 13u) };
    plan.attributeSkinResource = { .generation = generation, .index = static_cast<u32>(offset + 14u) };
    plan.skinResource = { .generation = generation, .index = static_cast<u32>(offset + 15u) };
    plan.jointPaletteResource = { .generation = generation, .index = static_cast<u32>(offset + 16u) };
    plan.attributeResource = { .generation = generation, .index = static_cast<u32>(offset + 17u) };
    plan.meshletLocalBoundsResource = { .generation = generation, .index = static_cast<u32>(offset + 18u) };
    plan.localBoundsResource = { .generation = generation, .index = static_cast<u32>(offset + 19u) };
    plan.hasActiveSkin = true;
    plan.copiedRestStreams = true;
    plan.updatesMeshletBounds = true;
    plan.repacksNormals = true;
    return plan;
}


