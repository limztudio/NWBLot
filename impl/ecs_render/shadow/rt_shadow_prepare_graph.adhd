#include <impl/ecs_render/kernel/task_graph_barrier_task.adhd>
#include <impl/ecs_render/shadow/rt_shadow_internal_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_ShadowPrepareSwBvhKeysClearSuffix = ":shadow_prepare_sw_bvh_keys_clear";
const StringView s_ShadowPrepareSwBvhParentClearSuffix = ":shadow_prepare_sw_bvh_parent_clear";
const StringView s_ShadowPrepareSwBvhCounterClearSuffix = ":shadow_prepare_sw_bvh_counter_clear";
const StringView s_ShadowPrepareSwBvhBuildSuffix = ":shadow_prepare_sw_bvh_build";
const usize s_ShadowPrepareSwBvhBuildResourceUseCount = 7u;

Expected<Name> DeriveShadowPrepareSwBvhKeysClearIdentity(in Name meshName){
    return DeriveName(meshName, s_ShadowPrepareSwBvhKeysClearSuffix);
}

Expected<Name> DeriveShadowPrepareSwBvhParentClearIdentity(in Name meshName){
    return DeriveName(meshName, s_ShadowPrepareSwBvhParentClearSuffix);
}

Expected<Name> DeriveShadowPrepareSwBvhCounterClearIdentity(in Name meshName){
    return DeriveName(meshName, s_ShadowPrepareSwBvhCounterClearSuffix);
}

Expected<Name> DeriveShadowPrepareSwBvhBuildIdentity(in Name meshName){
    return DeriveName(meshName, s_ShadowPrepareSwBvhBuildSuffix);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateShadowPreparePlanOwnership(
    in b8 sceneTlasBuildGraphOwned,
    in b8 hasSceneTlas,
    in b8 meshBlasBuildsGraphOwned,
    in usize preparedMeshBlasBuildCount,
    in b8 meshSwBvhBuildsGraphOwned,
    in usize preparedMeshSwBvhBuildCount
){
    if(sceneTlasBuildGraphOwned && !hasSceneTlas){
        warning("RendererSystem: frozen scene TLAS build has no imported acceleration structure");
        return false;
    }
    if(meshBlasBuildsGraphOwned && preparedMeshBlasBuildCount == 0u){
        warning("RendererSystem: frozen BLAS build plan has no operations");
        return false;
    }
    if(meshBlasBuildsGraphOwned && !hasSceneTlas){
        warning("RendererSystem: frozen BLAS build plan has no scene TLAS");
        return false;
    }
    if(meshSwBvhBuildsGraphOwned && preparedMeshSwBvhBuildCount == 0u){
        warning("RendererSystem: frozen software BVH build plan has no operations");
        return false;
    }
    return true;
}

b8 ResolveMeshBlasGeometryBuildInputStatesGraphOwned(in b8 meshBlasBuildsGraphOwned, in b8 softwareTraceResourcesPrepared, in b8 meshSwBvhBuildsGraphOwned){
    return meshBlasBuildsGraphOwned && !softwareTraceResourcesPrepared && !meshSwBvhBuildsGraphOwned;
}

b8 CanDeclareShadowPrepareSceneSwBvhRefit(in b8 buildPlanFrozen, in usize preparedMeshSwBvhBuildCount, in b8 pureSoftwareMeshSwBvhBuildsGraphOwned){
    return buildPlanFrozen && (preparedMeshSwBvhBuildCount == 0u || pureSoftwareMeshSwBvhBuildsGraphOwned);
}

b8 ShouldMergeShadowPrepareAcrossConsumerFrontier(in b8 pureSoftwareMeshSwBvhBuildsGraphOwned, in b8 hasSceneRefitTask){
    return pureSoftwareMeshSwBvhBuildsGraphOwned || hasSceneRefitTask;
}

b8 HasAccelStructBuildStatesGraphOwned(in b8 sceneTlasBuildGraphOwned, in b8 meshBlasBuildsGraphOwned){
    return sceneTlasBuildGraphOwned || meshBlasBuildsGraphOwned;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ShadowPrepareGraphTask{
    private mut RendererRayTracingSystem raytracingSystem;
    private mut ShadowPreparationOutcome outcome;
    private mut DeferredFrameTargets targets;
    private mut GpuTimingSubmissionTicket timingTicket;
    private b8 deferredBindlessSlotsWereUploaded;
    private b8 currentBindlessSlotsGraphOwned;
    private b8 shadowMaterialContextBatchGraphOwned;
    private b8 sceneBvhBatchGraphOwned;
    private b8 sceneTlasBuildGraphOwned;
    private b8 meshBlasBuildsGraphOwned;
    private b8 meshBlasGeometryBuildInputStatesGraphOwned;
    private b8 meshSwBvhBuildsGraphOwned;
    private b8 preparedMeshSwBvhBuildsRecordedByGraph;

    public ShadowPrepareGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        mut ShadowPreparationOutcome outcome,
        mut DeferredFrameTargets targets,
        mut GpuTimingSubmissionTicket timingTicket,
        in b8 deferredBindlessSlotsWereUploaded,
        in b8 currentBindlessSlotsGraphOwned,
        in b8 shadowMaterialContextBatchGraphOwned,
        in b8 sceneBvhBatchGraphOwned,
        in b8 sceneTlasBuildGraphOwned,
        in b8 meshBlasBuildsGraphOwned,
        in b8 meshBlasGeometryBuildInputStatesGraphOwned,
        in b8 meshSwBvhBuildsGraphOwned,
        in b8 preparedMeshSwBvhBuildsRecordedByGraph
    ){
        this.raytracingSystem = raytracingSystem;
        this.outcome = outcome;
        this.targets = targets;
        this.timingTicket = timingTicket;
        this.deferredBindlessSlotsWereUploaded = deferredBindlessSlotsWereUploaded;
        this.currentBindlessSlotsGraphOwned = currentBindlessSlotsGraphOwned;
        this.shadowMaterialContextBatchGraphOwned = shadowMaterialContextBatchGraphOwned;
        this.sceneBvhBatchGraphOwned = sceneBvhBatchGraphOwned;
        this.sceneTlasBuildGraphOwned = sceneTlasBuildGraphOwned;
        this.meshBlasBuildsGraphOwned = meshBlasBuildsGraphOwned;
        this.meshBlasGeometryBuildInputStatesGraphOwned = meshBlasGeometryBuildInputStatesGraphOwned;
        this.meshSwBvhBuildsGraphOwned = meshSwBvhBuildsGraphOwned;
        this.preparedMeshSwBvhBuildsRecordedByGraph = preparedMeshSwBvhBuildsRecordedByGraph;
    }

    public GpuTaskCommandRequirements commandRequirements()const{
        GpuTaskCommandRequirements commands;
        commands.requiredCapabilities = GpuQueueCapability::Compute | GpuQueueCapability::Transfer;
        commands.requiresPrimaryGraphicsQueue = true;
        return commands;
    }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        GpuTimingTicketRecordingScope timingRecording(this.timingTicket);
        this.outcome.ready = false;
        // The graph establishes the selector ConstantBuffer state before recording.
        if(!this.targets.bindless.valid())
            return false;
        const auto shadowResourcesPrepared = this.raytracingSystem.recordPreflightShadowVisibilityResources(
            commandList,
            this.targets,
            this.sceneTlasBuildGraphOwned,
            this.meshBlasBuildsGraphOwned,
            this.meshBlasGeometryBuildInputStatesGraphOwned,
            this.meshSwBvhBuildsGraphOwned,
            this.preparedMeshSwBvhBuildsRecordedByGraph
        );

        // Selector upload precedes this task; compiler establishes ConstantBuffer state first.
        if(!shadowResourcesPrepared.has_value())
            return false;
        this.outcome.ready = shadowResourcesPrepared.value();

        // These declarations export BLAS/SW-BVH boundary states before the Prefix packet seeds.
        return true;
    }

    public void accepted(in QueueSubmissionToken token){
        if(this.currentBindlessSlotsGraphOwned)
            this.targets.bindless.slotsUploaded = true;
        this.raytracingSystem.confirmPreparedShadowTraceGeometryNormalization();
        if(this.shadowMaterialContextBatchGraphOwned)
            this.raytracingSystem.confirmPreparedShadowMaterialContextUploads();
        if(this.sceneBvhBatchGraphOwned)
            this.raytracingSystem.confirmPreparedSceneBvhUploads();
    }

    public void discarded(){
        this.timingTicket.discard();

        // Failed preparation keeps storage but invalidates the frame plan and caches.
        this.outcome.ready = false;
        this.outcome.resourcesValid = false;
        this.targets.bindless.slotsUploaded = this.deferredBindlessSlotsWereUploaded;
        this.raytracingSystem.discardPreflightShadowVisibilityResources();
    }
}


class ShadowPrepareSoftwareBvhBuildGraphTask{
    private mut RendererRayTracingSystem raytracingSystem;
    private mut GpuTimingSubmissionTicket timingTicket;
    private PreparedMeshSwBvhBuild build;

    public ShadowPrepareSoftwareBvhBuildGraphTask(
        mut RendererRayTracingSystem raytracingSystem,
        mut GpuTimingSubmissionTicket timingTicket,
        in PreparedMeshSwBvhBuild build
    ){
        this.raytracingSystem = raytracingSystem;
        this.timingTicket = timingTicket;
        this.build = build;
    }

    public GpuTaskCommandRequirements commandRequirements()const{
        GpuTaskCommandRequirements commands;
        commands.requiredCapabilities = GpuQueueCapability::Compute;
        return commands;
    }

    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        GpuTimingTicketRecordingScope timingRecording(this.timingTicket);
        return this.raytracingSystem.recordPreparedMeshSwBvhBuildAfterGraphClears(commandList, this.build);
    }
}


[cpp_unwind]
b8 AppendShadowSoftwareBvhClear(mut GpuTaskGraph graph, in GpuTaskSchedulingHint scheduling, mut GpuTaskId firstTask, mut GpuTaskId dependency, in Expected<Name> identity, in StringView label, in GpuGraphResourceId destination, in u32 clearValue){
    if(!identity.has_value())
        return false;
    GpuTaskDesc desc;
    desc.setIdentity(identity.value()).setMarkerLabel(label).setScheduling(scheduling).setDependency(dependency);
    GpuClearBufferTaskDesc clear;
    clear.destination = destination;
    clear.clearValue = clearValue;
    const auto task = graph.addClearBufferTask(desc, clear);
    if(!task.has_value())
        return false;
    if(!firstTask.valid())
        firstTask = task.value();
    dependency = task.value();
    return true;
}


[cpp_unwind]
b8 ShadowPrepareGraphCoordinator::declareDeferredShadowPrepareTask(
    in ShadowPrepareGraphContext context,
    in RayTracingShadowPreparationResourceSnapshot rayTracingShadowResources,
    in RayTracingDeferredGraphResourceSnapshot rayTracingResources,
    in GpuGraphResourceId currentBindlessSlots,
    in GpuGraphResourceId materialContextSlots,
    in Span<GpuGraphResourceId> shadowTraceGeometryResources,
    in Span<GpuGraphResourceId> softwareBvhBuildStateResources,
    in b8 softwareTraceResourcesPrepared,
    mut DeferredFrameTargets deferredTargets,
    mut GpuTimingSubmissionTicket timingTicket
){

    this.m_deferredShadowPrepareSceneRefitTask = GpuTaskId();
    this.m_sceneBvhRefitInputsUploadTask = GpuTaskId();
    this.resetShadowPrepareTaskState();
    if(
        !deferredTargets.valid()
        || !deferredTargets.bindless.valid()
        || !context.rayTracing.shadowVisibilityResourcesPreflighted()
        || !currentBindlessSlots.valid()
        || !materialContextSlots.valid()
    )
        return false;

    ShadowPrepareUploadChain uploads;
    ShadowPrepareUploadChainBuilder uploadChainBuilder(context.graph, context.graphics, context.rayTracing);
    const b8 uploadsDeclared = uploadChainBuilder.declare(
        ShadowPrepareUploadInputs(
            deferredTargets,
            rayTracingResources,
            currentBindlessSlots,
            materialContextSlots
        ),
        uploads
    );
    this.m_deferredBindlessSlotsUploadTask = uploads.tasks.bindlessSlots;
    this.m_rayTraceMaterialContextSlotsUploadTask = uploads.tasks.rayTraceMaterialContextSlots;
    this.m_csgTraceContextUploadTask = uploads.tasks.csgTraceContext;
    this.m_causticEmissionTargetsUploadTask = uploads.tasks.causticEmissionTargets;
    this.m_surfelFrameConstantsUploadTask = uploads.tasks.surfelFrameConstants;
    this.m_shadowInstanceMaterialUploadTask = uploads.tasks.shadowInstanceMaterial;
    this.m_shadowInstanceUploadTask = uploads.tasks.shadowInstance;
    this.m_shadowMaterialTypedUploadTask = uploads.tasks.shadowMaterialTyped;
    this.m_sceneBvhNodesUploadTask = uploads.tasks.sceneBvhNodes;
    this.m_sceneBvhInstancesUploadTask = uploads.tasks.sceneBvhInstances;
    if(!uploadsDeclared)
        return false;
    GpuTaskId shadowPrepareDependency = uploads.completionTask;

    // Hardware TLAS builds retain their preflight instance stream; the first Graphics packet owns the native build.
    const b8 sceneTlasBuildGraphOwned = context.rayTracing.preparedSceneTlasBuildReady();
    const b8 meshBlasBuildsGraphOwned = context.rayTracing.preparedMeshBlasBuildsReady();
    const Span<PreparedMeshBlasBuild> preparedMeshBlasBuilds = context.rayTracing.preparedMeshBlasBuilds();
    const b8 meshSwBvhBuildsGraphOwned = context.rayTracing.preparedMeshSwBvhBuildsReady();
    const Span<PreparedMeshSwBvhBuild> preparedMeshSwBvhBuilds = context.rayTracing.preparedMeshSwBvhBuilds();
    if(!ValidateShadowPreparePlanOwnership(
        sceneTlasBuildGraphOwned,
        rayTracingShadowResources.sceneTlas.valid(),
        meshBlasBuildsGraphOwned,
        preparedMeshBlasBuilds.size(),
        meshSwBvhBuildsGraphOwned,
        preparedMeshSwBvhBuilds.size()
    ))
        return false;
    const b8 meshBlasGeometryBuildInputStatesGraphOwned = ResolveMeshBlasGeometryBuildInputStatesGraphOwned(meshBlasBuildsGraphOwned, softwareTraceResourcesPrepared, meshSwBvhBuildsGraphOwned);
    // Software preparation uses typed sentinel clears before each mesh build.
    const b8 pureSoftwareMeshSwBvhBuildsGraphOwnedCandidate = meshSwBvhBuildsGraphOwned && !context.rayTracing.shadowVisibilityHardwareSupported();

    PreparedMeshSwBvhGraphResourceVector pureSoftwareMeshSwBvhGraphResources;
    ShadowPrepareResourcePlan shadowResourcePlan;
    const ShadowPrepareResourceInputs shadowResourceInputs(
        rayTracingShadowResources, uploads, currentBindlessSlots, materialContextSlots,
        shadowTraceGeometryResources, softwareBvhBuildStateResources, preparedMeshBlasBuilds,
        sceneTlasBuildGraphOwned, meshBlasBuildsGraphOwned, meshBlasGeometryBuildInputStatesGraphOwned
    );
    ShadowPrepareResourcePlanner shadowResourcePlanner(context.graph, context.rayTracing, context.mesh);
    if(!shadowResourcePlanner.prepare(shadowResourceInputs, shadowResourcePlan))
        return false;
    const b8 pureSoftwareMeshSwBvhBuildsGraphOwned = pureSoftwareMeshSwBvhBuildsGraphOwnedCandidate;
    if(pureSoftwareMeshSwBvhBuildsGraphOwned){
        auto resources = ResolvePreparedSoftwareBvhGraphResources(context.graph, preparedMeshSwBvhBuilds);
        if(!resources.has_value()){
            warning("RendererSystem: frozen software BVH build is missing graph resources");
            return false;
        }
        pureSoftwareMeshSwBvhGraphResources = resources.value();
    }

    if(pureSoftwareMeshSwBvhBuildsGraphOwned){
        ShadowSoftwareBvhBuildChain buildChain(context.graph, context.rayTracing);
        if(!buildChain.declare(pureSoftwareMeshSwBvhGraphResources, timingTicket, shadowPrepareDependency, this.m_deferredShadowPrepareSoftwareBvhBuildFirstTask, this.m_deferredShadowPrepareSoftwareBvhBuildLastTask))
            return false;
    }

    if(context.rayTracing.preparedSceneSwBvhRefit().valid()){
        // A scene refit requires every frozen mesh build to be declared before it.
        if(!CanDeclareShadowPrepareSceneSwBvhRefit(context.rayTracing.preparedMeshSwBvhBuildPlanFrozen(), preparedMeshSwBvhBuilds.size(), pureSoftwareMeshSwBvhBuildsGraphOwned))
            return false;
        const auto refitTasks = DeclareSoftwareSceneRefit(context.rayTracing.preparedSceneSwBvhRefit(), uploads.sceneBvhNodes, shadowPrepareDependency, context.graph);
        if(!refitTasks.has_value()){
            this.m_deferredShadowPrepareSceneRefitTask = GpuTaskId();
            this.m_sceneBvhRefitInputsUploadTask = GpuTaskId();
            return false;
        }
        this.m_deferredShadowPrepareSceneRefitTask = refitTasks.value().refit;
        this.m_sceneBvhRefitInputsUploadTask = refitTasks.value().inputUpload;
        if(!this.m_deferredShadowPrepareSceneRefitTask.valid() || !this.m_sceneBvhRefitInputsUploadTask.valid())
            return false;
        shadowPrepareDependency = this.m_deferredShadowPrepareSceneRefitTask;
    }

    GpuTaskSchedulingHint scheduling;
    scheduling.cost = GpuTaskCostHint::Large;
    scheduling.forceSubmissionBoundary = false;
    scheduling.allowPacketMerge = true;
    scheduling.mergeWithPrevious = true;
    // Software per-mesh chains precede this endpoint. Keep the whole packet even when later consumers form a frontier.
    scheduling.allowMergeAcrossConsumerFrontier = ShouldMergeShadowPrepareAcrossConsumerFrontier(pureSoftwareMeshSwBvhBuildsGraphOwned, this.m_deferredShadowPrepareSceneRefitTask.valid());
    GpuTaskExternalStateSource shadowPrepareStateSource;
    const auto persistent = context.persistentState.borrowSource();
    if(persistent.has_value())
        shadowPrepareStateSource.setState(persistent.value());
    const Array<GpuTaskExternalStateSource, 1u> stateSources(shadowPrepareStateSource);
    GpuTaskDesc desc;
    desc
        .setIdentity(Name(s_ShadowPreparePass))
        .setMarkerLabel("Shadow Preparation")
        .setScheduling(scheduling)
        .setDependency(shadowPrepareDependency)
        .setExternalStateSources(Span<GpuTaskExternalStateSource>(stateSources).first(cast<usize>(shadowPrepareStateSource.hasState())))
        .setResourceUses(shadowResourcePlan.resourceUses)
        .setResourceSetUses(Span<GpuTaskResourceSetUse>(shadowResourcePlan.resourceSetUses).first(shadowResourcePlan.resourceSetUseCount))
    ;
    const auto deferredShadowPrepareTaskResult = context.graph.addPayloadTask(desc, ShadowPrepareGraphTask(
        context.rayTracing,
        this.m_shadowPreparationOutcome,
        deferredTargets,
        timingTicket,
        deferredTargets.bindless.slotsUploaded,
        uploads.currentBindlessSlotsGraphOwned,
        uploads.shadowMaterialContextBatchGraphOwned,
        uploads.sceneBvhBatchGraphOwned,
        sceneTlasBuildGraphOwned,
        meshBlasBuildsGraphOwned,
        meshBlasGeometryBuildInputStatesGraphOwned,
        meshSwBvhBuildsGraphOwned,
        pureSoftwareMeshSwBvhBuildsGraphOwned
    ));
    if(!deferredShadowPrepareTaskResult.has_value()){
        this.m_deferredShadowPrepareTask = GpuTaskId();
        warning("RendererSystem: could not declare shared shadow-preparation task");
        return false;
    }
    this.m_deferredShadowPrepareTask = deferredShadowPrepareTaskResult.value();
    if(HasAccelStructBuildStatesGraphOwned(sceneTlasBuildGraphOwned, meshBlasBuildsGraphOwned)){
        ShadowAccelerationFinalizeBuilder finalizeBuilder(context.graph);
        if(!finalizeBuilder.declare(sceneTlasBuildGraphOwned, shadowResourcePlan.sceneTlas, preparedMeshBlasBuilds.size(), shadowResourcePlan.accelStructFinalizeResourceUses, this.m_deferredShadowPrepareTask,
            this.m_deferredShadowPrepareAccelStructFinalizeTask))
            return false;
    }
    return true;
}

void ShadowPrepareGraphCoordinator::resetShadowPrepareUploadTaskState(){
    this.m_deferredBindlessSlotsUploadTask = GpuTaskId();
    this.m_rayTraceMaterialContextSlotsUploadTask = GpuTaskId();
    this.m_csgTraceContextUploadTask = GpuTaskId();
    this.m_causticEmissionTargetsUploadTask = GpuTaskId();
    this.m_surfelFrameConstantsUploadTask = GpuTaskId();
    this.m_shadowInstanceMaterialUploadTask = GpuTaskId();
    this.m_shadowInstanceUploadTask = GpuTaskId();
    this.m_shadowMaterialTypedUploadTask = GpuTaskId();
    this.m_sceneBvhNodesUploadTask = GpuTaskId();
    this.m_sceneBvhInstancesUploadTask = GpuTaskId();
}

void ShadowPrepareGraphCoordinator::resetShadowPrepareTaskState(){
    this.m_deferredShadowPrepareTask = GpuTaskId();
    this.m_deferredShadowPrepareSoftwareBvhBuildFirstTask = GpuTaskId();
    this.m_deferredShadowPrepareSoftwareBvhBuildLastTask = GpuTaskId();
    this.m_deferredShadowPrepareAccelStructFinalizeTask = GpuTaskId();
    this.resetShadowPrepareUploadTaskState();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
b8 ShadowAccelerationFinalizeBuilder::declare(
    in b8 sceneTlasBuildGraphOwned,
    in GpuGraphResourceId sceneTlas,
    in usize preparedMeshBlasBuildCount,
    in Span<GpuTaskResourceUse> accelStructFinalizeResourceUses,
    in borrow GpuTaskId prepareTask,
    mut GpuTaskId outTask
){
    if(!ValidateAccelStructFinalizeResourceUses(sceneTlasBuildGraphOwned, sceneTlas.valid(), preparedMeshBlasBuildCount, accelStructFinalizeResourceUses.size()))
        return false;
    GpuGraphResourceSetId accelStructFinalizeSet;
    if(!accelStructFinalizeResourceUses.empty()){
        Vector<GpuGraphResourceId> accelStructFinalizeResources;
        accelStructFinalizeResources.reserve(accelStructFinalizeResourceUses.size());
        for(in GpuTaskResourceUse use : accelStructFinalizeResourceUses)
            accelStructFinalizeResources.push_back(use.resource);
        GpuGraphResourceSetDesc setDesc;
        setDesc.setIdentity(Name(s_ShadowPrepareAccelStructFinalizeResources))
                .setMarkerLabel("Shadow Prepare Accel-Struct Finalize Resources")
                .setMembers(accelStructFinalizeResources);
        const auto accelStructFinalizeSetResult = this.m_graph.importResourceSet(setDesc);
        if(accelStructFinalizeSetResult.has_value())
            accelStructFinalizeSet = accelStructFinalizeSetResult.value();
    }
    const b8 accelStructFinalizeSetGraphOwned = accelStructFinalizeSet.valid();
    GpuTaskResourceSetUse accelStructFinalizeSetUse;
    accelStructFinalizeSetUse.resourceSet = accelStructFinalizeSet;
    accelStructFinalizeSetUse.requiredState = ResourceStates::AccelStructRead;
    accelStructFinalizeSetUse.access = GpuTaskResourceAccess::Read;
    GpuTaskSchedulingHint accelStructFinalizeScheduling;
    accelStructFinalizeScheduling.cost = GpuTaskCostHint::Tiny;
    accelStructFinalizeScheduling.forceSubmissionBoundary = false;
    accelStructFinalizeScheduling.allowPacketMerge = true;
    accelStructFinalizeScheduling.mergeWithPrevious = true;
    // Compute consumers follow Shadow Preparation. Keep Read finalizers in the same packet so they wait on every build.
    accelStructFinalizeScheduling.allowMergeAcrossConsumerFrontier = true;
    GpuTaskDesc accelStructFinalizeDesc;
    accelStructFinalizeDesc
        .setIdentity(Name(s_ShadowPrepareAccelStructFinalize))
        .setMarkerLabel("Shadow Preparation Accel-Struct Finalize")
        .setScheduling(accelStructFinalizeScheduling)
        .setDependency(prepareTask)
        // The typed final-state collection expands to the same inputs. Keep individuals when members form no unique set.
    ;
    const Array<GpuTaskResourceSetUse, 1u> finalizeSets(accelStructFinalizeSetUse);
    if(accelStructFinalizeSetGraphOwned)
        accelStructFinalizeDesc.setResourceSetUses(finalizeSets);
    else
        accelStructFinalizeDesc.setResourceUses(accelStructFinalizeResourceUses);
    const auto deferredShadowPrepareAccelStructFinalizeTaskResult = this.m_graph.addPayloadTask(accelStructFinalizeDesc, BarrierOnlyGraphTask());
    if(!deferredShadowPrepareAccelStructFinalizeTaskResult.has_value()){
        outTask = GpuTaskId();
        warning("RendererSystem: could not declare acceleration-structure final-state task");
        return false;
    }
    outTask = deferredShadowPrepareAccelStructFinalizeTaskResult.value();
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void ShadowPreparePacketValidator::validate(in GpuCompiledGraphReadView compiledPlan, mut ShadowPreparePacketValidationResult outResult)const{
    in RendererFramePipeline pipeline = this.m_pipeline;
    // Software clears belong to the Shadow Preparation packet; a split would omit them.
    if(!pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareSoftwareBvhBuildFirstTask.valid())
        outResult.softwareBvhBuildsMerged = !pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareSoftwareBvhBuildLastTask.valid();
    else
        outResult.softwareBvhBuildsMerged = pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareSoftwareBvhBuildLastTask.valid()
            && compiledPlan.tasksSharePacket(pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareTask, pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareSoftwareBvhBuildFirstTask)
            && compiledPlan.tasksSharePacket(pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareTask, pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareSoftwareBvhBuildLastTask);
    // The endpoint must never accept uploaded scene topology without its current-pose refit.
    outResult.softwareSceneRefitMerged =
        pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareSceneRefitTask.valid() == pipeline.m_shadowPrepareGraph.m_sceneBvhRefitInputsUploadTask.valid()
        && (!pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareSceneRefitTask.valid()
            || (compiledPlan.tasksSharePacket(pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareTask, pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareSceneRefitTask) && compiledPlan.tasksSharePacket(pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareTask, pipeline.m_shadowPrepareGraph.m_sceneBvhRefitInputsUploadTask)))
    ;
    // Frozen transitions must share the build's submission for an atomic handoff.
    outResult.accelStructFinalizeMerged = !pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareAccelStructFinalizeTask.valid() || compiledPlan.tasksSharePacket(pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareTask, pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareAccelStructFinalizeTask);
    // Selector uploads must stay in the Shadow Preparation packet.
    outResult.bindlessSlotsUploadMerged = !pipeline.m_shadowPrepareGraph.m_deferredBindlessSlotsUploadTask.valid() || compiledPlan.tasksSharePacket(pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareTask, pipeline.m_shadowPrepareGraph.m_deferredBindlessSlotsUploadTask);
    // Keep the upload in the first packet so it becomes the handoff.
    outResult.rayTraceMaterialContextSlotsUploadMerged =
        (!pipeline.m_shadowPrepareGraph.m_rayTraceMaterialContextSlotsUploadTask.valid() || compiledPlan.tasksSharePacket(pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareTask, pipeline.m_shadowPrepareGraph.m_rayTraceMaterialContextSlotsUploadTask))
        && (!pipeline.m_shadowPrepareGraph.m_csgTraceContextUploadTask.valid() || compiledPlan.tasksSharePacket(pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareTask, pipeline.m_shadowPrepareGraph.m_csgTraceContextUploadTask))
    ;
    // Nonempty caustic payloads must live in the Shadow Preparation packet.
    outResult.causticEmissionTargetsUploadMerged = !pipeline.m_shadowPrepareGraph.m_causticEmissionTargetsUploadTask.valid() || compiledPlan.tasksSharePacket(pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareTask, pipeline.m_shadowPrepareGraph.m_causticEmissionTargetsUploadTask);
    // Surfel constants must share the Shadow Preparation packet.
    outResult.surfelFrameConstantsUploadMerged = !pipeline.m_shadowPrepareGraph.m_surfelFrameConstantsUploadTask.valid() || compiledPlan.tasksSharePacket(pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareTask, pipeline.m_shadowPrepareGraph.m_surfelFrameConstantsUploadTask);
    // This triple must stay in the first accepted packet.
    outResult.shadowMaterialContextUploadsMerged =
        (!pipeline.m_shadowPrepareGraph.m_shadowInstanceMaterialUploadTask.valid() || compiledPlan.tasksSharePacket(pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareTask, pipeline.m_shadowPrepareGraph.m_shadowInstanceMaterialUploadTask))
        && (!pipeline.m_shadowPrepareGraph.m_shadowInstanceUploadTask.valid() || compiledPlan.tasksSharePacket(pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareTask, pipeline.m_shadowPrepareGraph.m_shadowInstanceUploadTask))
        && (!pipeline.m_shadowPrepareGraph.m_shadowMaterialTypedUploadTask.valid() || compiledPlan.tasksSharePacket(pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareTask, pipeline.m_shadowPrepareGraph.m_shadowMaterialTypedUploadTask))
    ;
    // Keep the pair in Shadow Preparation as the only producer.
    outResult.sceneBvhUploadsMerged =
        pipeline.m_shadowPrepareGraph.m_sceneBvhNodesUploadTask.valid() == pipeline.m_shadowPrepareGraph.m_sceneBvhInstancesUploadTask.valid()
        && (!pipeline.m_shadowPrepareGraph.m_sceneBvhNodesUploadTask.valid()
            || (compiledPlan.tasksSharePacket(pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareTask, pipeline.m_shadowPrepareGraph.m_sceneBvhNodesUploadTask) && compiledPlan.tasksSharePacket(pipeline.m_shadowPrepareGraph.m_deferredShadowPrepareTask, pipeline.m_shadowPrepareGraph.m_sceneBvhInstancesUploadTask)))
    ;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
b8 ShadowSoftwareBvhBuildChain::declare(
    in Span<PreparedMeshSwBvhGraphResources> pureSoftwareMeshSwBvhGraphResources,
    mut GpuTimingSubmissionTicket timingTicket,
    mut GpuTaskId shadowPrepareDependency,
    mut GpuTaskId firstTask,
    mut GpuTaskId lastTask
){

    // Operations share scratch; keep clears adjacent in the accepting packet.
    GpuTaskSchedulingHint clearScheduling;
    clearScheduling.cost = GpuTaskCostHint::Tiny;
    clearScheduling.forceSubmissionBoundary = false;
    clearScheduling.allowPacketMerge = true;
    clearScheduling.mergeWithPrevious = true;
    clearScheduling.allowMergeAcrossConsumerFrontier = true;
    GpuTaskSchedulingHint buildScheduling = clearScheduling;
    buildScheduling.cost = GpuTaskCostHint::Large;

    GpuTaskId buildDependency = shadowPrepareDependency;
    for(in PreparedMeshSwBvhGraphResources resources : pureSoftwareMeshSwBvhGraphResources){
        in PreparedMeshSwBvhBuild build = resources.build;
        if(!build.performRefit){
            if(!AppendShadowSoftwareBvhClear(this.m_graph, clearScheduling, firstTask, buildDependency, DeriveShadowPrepareSwBvhKeysClearIdentity(build.meshName), "Shadow Prepare SW-BVH Sort-Key Clear", resources.sortKeys, BvhNodeIndex::Invalid)
                || !AppendShadowSoftwareBvhClear(this.m_graph, clearScheduling, firstTask, buildDependency, DeriveShadowPrepareSwBvhParentClearIdentity(build.meshName), "Shadow Prepare SW-BVH Parent Clear", resources.parent, BvhNodeIndex::Invalid)
            ){
                warning("RendererSystem: could not declare pure software BVH sentinel clears");
                return false;
            }
        }
        if(!AppendShadowSoftwareBvhClear(this.m_graph, clearScheduling, firstTask, buildDependency, DeriveShadowPrepareSwBvhCounterClearIdentity(build.meshName), "Shadow Prepare SW-BVH Counter Clear", resources.visitCounter, 0u)){
            warning("RendererSystem: could not declare pure software BVH counter clear");
            return false;
        }

        const Array<GpuTaskResourceUse, s_ShadowPrepareSwBvhBuildResourceUseCount> buildResourceUses(ReadUse(resources.position, ResourceStates::ShaderResource),
            ReadUse(resources.triangleIndex, ResourceStates::ShaderResource),
            ReadWriteUse(resources.node, ResourceStates::UnorderedAccess),
            ReadWriteUse(resources.parent, ResourceStates::UnorderedAccess),
            ReadWriteUse(resources.sortKeys, ResourceStates::UnorderedAccess),
            ReadWriteUse(resources.sortPayload, ResourceStates::UnorderedAccess),
            ReadWriteUse(resources.visitCounter, ResourceStates::UnorderedAccess));
        const auto buildIdentity = DeriveShadowPrepareSwBvhBuildIdentity(build.meshName);
        if(!buildIdentity.has_value()){
            warning("RendererSystem: could not declare pure software BVH build callback");
            return false;
        }
        GpuTaskDesc buildDesc;
        buildDesc.setIdentity(buildIdentity.value()).setMarkerLabel("Shadow Prepare SW-BVH Build").setScheduling(buildScheduling).setDependency(buildDependency).setResourceUses(buildResourceUses);
        const auto buildTaskResult = this.m_graph.addPayloadTask(buildDesc, ShadowPrepareSoftwareBvhBuildGraphTask(this.m_raytracingSystem, timingTicket, build));
        if(!buildTaskResult.has_value()){
            warning("RendererSystem: could not declare pure software BVH build callback");
            return false;
        }
        const GpuTaskId buildTask = buildTaskResult.value();
        buildDependency = buildTask;
        lastTask = buildTask;
    }
    if(!firstTask.valid() || !lastTask.valid()){
        warning("RendererSystem: pure software BVH graph chain has no task bounds");
        return false;
    }
    shadowPrepareDependency = buildDependency;

    return true;
}


