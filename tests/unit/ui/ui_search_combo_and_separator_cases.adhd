void VerifyUiSearchComboBuilderTests_ChangedQueryFiltersRowsAndDiscardsNavigationFromThePreviousView(mut UiSearchComboBuilderTests self){
    self.m_search.combo().select(1u);
    ASSERT_TRUE(self.acceptSearch(1u));
    ASSERT_TRUE(self.openSearch(2u));
    ControlToken previous = ControlToken();
    native(in self, mut previous){
        ASSERT_NE(self.target(self.list()), nullptr);
        previous = self.target(self.list())->control;
    }
    self.press(UiSearchComboKey::Down);
    self.m_host.text(s_UiSearchComboSecondHalfQuery);
    ASSERT_TRUE(self.acceptSearch(3u));
    EXPECT_TRUE(self.m_searchResult.queryChanged);
    EXPECT_EQ(self.m_search.query().text(), s_UiSearchComboSecondHalfQuery);
    EXPECT_EQ(self.m_search.combo().selectedKey(), 1u);
    EXPECT_EQ(self.m_search.combo().listState().cursorKey(), 0u);
    native(in self, in previous){
        ASSERT_NE(self.target(self.list()), nullptr);
        EXPECT_NE(self.target(self.list())->control, previous);
        EXPECT_EQ(self.target(self.row(1u)), nullptr);
        EXPECT_NE(self.target(self.row(2u)), nullptr);
    }
    EXPECT_FALSE(self.m_searchResult.combo.committed);
    EXPECT_EQ(self.m_context.input().focus(), self.query());
    self.press(UiSearchComboKey::Down);
    ASSERT_TRUE(self.acceptSearch(4u));
    EXPECT_EQ(self.m_search.combo().listState().cursorKey(), 2u);
    self.press(UiSearchComboKey::Enter);
    self.m_host.submitted = true;
    ASSERT_TRUE(self.acceptSearch(5u));
    EXPECT_TRUE(self.m_searchResult.combo.committed);
    EXPECT_EQ(self.m_search.combo().selectedKey(), 2u);
}

