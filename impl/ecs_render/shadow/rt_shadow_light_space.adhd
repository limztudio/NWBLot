////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/raytrace/raytracing_system.adhd>
#include <impl/ecs_render/shadow/light_space_resource_set.adhd>
#include <impl/ecs_render/shadow/light_space_capture_identity_builder.adhd>
#include <impl/ecs_render/shared/renderer_scene_private.adhd>
#include <impl/ecs_render/kernel/compute_pipeline_utils.adhd>
#include <impl/ecs_render/kernel/descriptor_register_utils.adhd>
#include <impl/assets_graphics/shadow_subsystem.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const usize s_LightSpaceComputePipelineTableCount = 12u;
const usize s_LightSpaceCsgStorageBufferCount = 2u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ShouldPreflightLightSpaceShadows(in b8 hasCsg, in b8 hardwareSupported, in SoftwareShadowBackend backend, in b8 sceneEligible){
    if(hasCsg)
        return true;
    if(hardwareSupported || backend == SoftwareShadowBackend::SoftwareTrace || !sceneEligible)
        return false;
    return true;
}

b8 CanBuildLightSpaceShadowPlan(
    in b8 hasCsg,
    in b8 hardwareSupported,
    in SoftwareShadowBackend backend,
    in b8 sceneEligible,
    in b8 hasPreparedTargets,
    in b8 swBvhTraversalReady,
    in b8 softShadowReady,
    in b8 softTransparentReady,
    in usize casterCount,
    in usize lightCount
){
    if(!hasCsg && (hardwareSupported || backend == SoftwareShadowBackend::SoftwareTrace))
        return false;
    if(!sceneEligible || !hasPreparedTargets || (!hardwareSupported && !swBvhTraversalReady))
        return false;
    if(!softShadowReady || !softTransparentReady || casterCount == 0u || lightCount > cast<usize>(s_SceneMaxLights))
        return false;
    return true;
}

b8 IsLightSpaceCsgResolvePipelineIndex(in u32 index, in b8 hardwareCsg){
    return hardwareCsg && index >= s_LightSpaceFirstCsgResolvePipelineIndex && index <= s_LightSpaceLastCsgResolvePipelineIndex;
}

b8 IsValidLightSpaceStorageByteSize(in u64 byteSize, in u64 maximumRange){
    return byteSize != 0u && byteSize <= maximumRange && byteSize <= cast<u64>(u32.max);
}

b8 LightSpaceExactStorageMatches(
    in LightSpacePlan plan,
    in u64 countByteSize,
    in u64 eventByteSize,
    in u64 viewByteSize,
    in u64 drawArgumentByteSize,
    in u32 depthWidth,
    in u32 depthArraySize
){
    return countByteSize == plan.countByteSize
        && eventByteSize == plan.eventByteSize
        && viewByteSize == plan.viewByteSize
        && drawArgumentByteSize == plan.drawArgumentByteSize
        && depthWidth == plan.textureResolution
        && depthArraySize == plan.viewCount;
}

b8 NeedsLightSpaceCsgStorageReallocation(
    in b8 hasCsgContext,
    in u64 currentContextBytes,
    in u64 requiredContextBytes,
    in b8 hasCsgOpaqueDepth,
    in u64 currentOpaqueDepthBytes,
    in u64 requiredOpaqueDepthBytes
){
    return !hasCsgContext || currentContextBytes < requiredContextBytes || !hasCsgOpaqueDepth || currentOpaqueDepthBytes < requiredOpaqueDepthBytes;
}

b8 HasAnyOrdinaryTransparentLightSpaceCaster(in b8 hasCsg, in Span<LightSpaceShadowCaster> casters){
    if(!hasCsg)
        return false;
    for(in LightSpaceShadowCaster caster : casters){
        if(caster.transparent && !caster.csg)
            return true;
    }
    return false;
}

b8 CanScheduleLightSpaceDiagnosticReadback(in b8 hasCsg, in b8 hasReadbackBuffer, in b8 submissionValid, in u32 frameIndex, in u32 acceptedFrame){
    return hasCsg && hasReadbackBuffer && !submissionValid && IsLightSpaceDiagnosticIntervalDue(frameIndex, acceptedFrame);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


AssetRef<ComputeShader> SelectLightSpaceComputeShader(in ShadowSubsystem subsystem, in u32 stage, in b8 hardwareCsg){
    switch(stage){
        case 0u:
            return subsystem.lightSpaceViewCs;
        case 1u:
            return subsystem.lightSpaceResolveCs;
        case 2u:
            return subsystem.lightSpaceResolveCs;
        case 3u:
            return subsystem.lightSpaceFallbackCs;
        case 4u:
            return subsystem.lightSpaceFallbackCs;
        case 5u:
            return subsystem.lightSpaceShadeCs;
        case 6u:
            return subsystem.lightSpaceShadeCs;
        case 7u:
            if(hardwareCsg)
                return subsystem.lightSpaceResolveHwCs;
            return subsystem.lightSpaceResolveCs;
        case 8u:
            if(hardwareCsg)
                return subsystem.lightSpaceResolveHwCs;
            return subsystem.lightSpaceResolveCs;
        case 9u:
            return subsystem.lightSpaceFallbackCs;
        case 10u:
            return subsystem.lightSpaceFallbackCs;
        case 11u:
            return subsystem.lightSpaceCullCs;
        default:
            return AssetRef<ComputeShader>();
    }
}

mut ComputePipelineHandle SelectLightSpaceOutput(mut LightSpaceShadowSnapshot snapshot, in u32 stage){
    switch(stage){
        case 0u:
            return snapshot.viewPipeline;
        case 1u:
            return snapshot.opaqueResolve;
        case 2u:
            return snapshot.transparentResolve;
        case 3u:
            return snapshot.opaqueFallback;
        case 4u:
            return snapshot.transparentFallback;
        case 5u:
            return snapshot.shadePipeline;
        case 6u:
            return snapshot.csgShadePipeline;
        case 7u:
            return snapshot.csgOpaqueResolve;
        case 8u:
            return snapshot.csgTransparentResolve;
        case 9u:
            return snapshot.csgOpaqueFallback;
        case 10u:
            return snapshot.csgTransparentFallback;
        default:
            assert(stage == 11u);
            return snapshot.cullPipeline;
    }
}

u64 LightSpaceBufferCapacity(in BufferHandle buffer){
    if(buffer.valid())
        return buffer.deref().getCreationDescription().byteSize;
    return 0u;
}

b8 RendererRayTracingSystem::setSoftwareShadowSettings(in SoftwareShadowSettings settings){
    if(!ValidateSoftwareShadowSettings(settings))
        return false;
    mut LightSpaceShadowState state = this.m_lightSpaceShadow;
    if(SameSoftwareShadowSettings(state.m_settings, settings))
        return true;
    ApplySoftwareShadowSettingsChange(
        settings,
        state.m_settings,
        state.m_captureHistory,
        state.m_captureReuseLogged,
        state.m_snapshot.ready,
        state.m_resourcesPrepared,
        state.m_dispatchLogged,
        this.m_rayTracingState.softShadow.m_softShadowTemporalSeeded
    );
    this.m_rayTracingState.shadow.m_softwareTransparentSampling.m_history.discard();
    return true;
}

LightSpaceShadowSnapshot RendererRayTracingSystem::lightSpaceShadowSnapshot()const{
    LightSpaceShadowSnapshot result = this.m_lightSpaceShadow.m_snapshot;
    result.casters = this.m_lightSpaceShadow.m_casters;
    result.csgContextBytes = this.m_lightSpaceShadow.m_csg.bytes;
    result.csgDynamicBounds = this.m_lightSpaceShadow.m_csg.dynamicBounds;
    return result;
}

void RendererRayTracingSystem::acceptLightSpaceShadowCapture(in LightSpaceCaptureTicket ticket, in b8 prepared){
    mut LightSpaceShadowState state = this.m_lightSpaceShadow;
    if(!prepared || !state.m_captureHistory.accept(ticket))
        return;
    LogAcceptedLightSpaceCaptureReuseIfNeeded(
        ticket.reuse,
        state.m_captureHistory.acceptedReuseAge(),
        state.m_settings.captureCadence,
        state.m_captureReuseLogged
    );
}

void RendererRayTracingSystem::preflightLightSpaceShadowResources(){
    mut LightSpaceShadowState state = this.m_lightSpaceShadow;
    mut LightSpaceShadowDiagnostics diagnostics = state.m_diagnostics;
    if(state.m_csg.snapshot.hasCsg || diagnostics.submission.valid()){
        ++diagnostics.frameIndex;
        const QueueSubmissionToken submission = diagnostics.submission;
        if(submission.valid() && submission.hasPhysicalQueueIdentity()){
            mut Device device = this.m_graphics.getDevice();
            const GpuPhysicalQueueId queue(submission.physicalQueueIndex, submission.deviceGeneration);
            const Expected<u64> completedValue = device.queueGetCompletedInstance(queue);
            if(completedValue.has_value() && completedValue.value() >= submission.value){
                u32 failureFlags = 0u;
                if(device.readMappedBuffer(diagnostics.readback.deref(), failureFlags)){
                    LightSpaceShadowLogReporter().reportRayFailures(failureFlags, diagnostics.reportedFailures);
                    diagnostics.submission = QueueSubmissionToken();
                }
            }
        }
    }
    state.m_resourcesPrepared = false;
    state.m_csgRequired = false;
    if(!ShouldPreflightLightSpaceShadows(state.m_csg.snapshot.hasCsg, this.m_shadowVisibilityHardwareSupported, state.m_settings.backend, state.m_sceneEligible))
        return;
    Array<SceneLightGpuData, s_SceneMaxLights> lights;
    Array<f32, s_SceneMaxLights> causticImportance;
    const u32 lightCount = ResolveSceneLights(this.m_world, lights, causticImportance);
    const Span<SceneLightGpuData> activeLights = Span<SceneLightGpuData>(lights).first(lightCount);
    state.m_csgRequired = HasAnyLightSpaceCsgActiveLight(state.m_csg.snapshot.hasCsg, activeLights);
    const auto planResult = this.buildLightSpaceShadowPlan(activeLights);
    if(!planResult.has_value())
        return;
    in LightSpacePlan plan = planResult.value();
    LightSpaceResourceSet resources(this.m_graphics, this.m_shaderSystem, this.m_lightSpaceShadow, this.m_shadowVisibilityHardwareSupported);
    state.m_resourcesPrepared = resources.ensureLightSpaceShadowPipelines() && resources.ensureLightSpaceShadowStorage(plan);
}

Expected<LightSpacePlan> RendererRayTracingSystem::buildLightSpaceShadowPlan(in Span<SceneLightGpuData> lights)const{
    in LightSpaceShadowState state = this.m_lightSpaceShadow;
    const usize lightCount = lights.size();
    if(!CanBuildLightSpaceShadowPlan(
        state.m_csg.snapshot.hasCsg,
        this.m_shadowVisibilityHardwareSupported,
        state.m_settings.backend,
        state.m_sceneEligible,
        this.m_shadowVisibilityPreparedTargets.has_value(),
        this.m_preparedSceneSwBvhTraversal.ready(),
        this.m_rayTracingState.softShadow.m_softShadowReady,
        this.m_rayTracingState.softShadow.m_softTransparentReady,
        state.m_casters.size(),
        lightCount
    ))
        return MakeUnexpected(Failure());
    const auto drawCount = LightSpaceShadowDrawCount(state.m_casters);
    if(!drawCount.has_value())
        return MakeUnexpected(drawCount.error());
    return TryBuildLightSpacePlanForSceneLights(
        state.m_settings,
        lights,
        this.m_graphics.getDevice().getMaxStorageBufferRange(),
        drawCount.value(),
        state.m_csg.snapshot.hasCsg,
        state.m_csg.bytes.size()
    );
}

void RendererRayTracingSystem::prepareLightSpaceShadows(in Span<SceneLightGpuData> lights){
    mut LightSpaceShadowState state = this.m_lightSpaceShadow;
    mut LightSpaceShadowSnapshot snapshot = state.m_snapshot;
    snapshot.ready = false;
    snapshot.diagnostics.reset();
    snapshot.diagnosticReadback.reset();
    if(
        !state.m_resourcesPrepared || !snapshot.layout.valid() || !snapshot.viewPipeline.valid() || !snapshot.cullPipeline.valid() || !snapshot.opaqueResolve.valid()
        || !snapshot.transparentResolve.valid() || !snapshot.opaqueFallback.valid() || !snapshot.transparentFallback.valid() || !snapshot.shadePipeline.valid()
        || !snapshot.opaqueCapture.valid() || !snapshot.transparentCapture.valid()
        || !snapshot.counts.valid() || !snapshot.events.valid() || !snapshot.views.valid() || !snapshot.drawArguments.valid() || !snapshot.depth
    )
        return;
    const auto planResult = this.buildLightSpaceShadowPlan(lights);
    if(!planResult.has_value())
        return;
    in LightSpacePlan plan = planResult.value();
    const auto drawCount = LightSpaceShadowDrawCount(state.m_casters);
    assert(drawCount.has_value());
    LightSpaceShadowStorageCapacity capacity;
    capacity.countBytes = snapshot.counts.deref().getCreationDescription().byteSize;
    capacity.eventBytes = snapshot.events.deref().getCreationDescription().byteSize;
    capacity.viewBytes = snapshot.views.deref().getCreationDescription().byteSize;
    capacity.drawArgumentBytes = snapshot.drawArguments.deref().getCreationDescription().byteSize;
    capacity.textureResolution = snapshot.depth.deref().getCreationDescription().width;
    capacity.arrayLayers = snapshot.depth.deref().getCreationDescription().arraySize;
    if(!LightSpaceShadowStorageFits(plan, capacity))
        return;
    for(u32 view = 0u; view < plan.viewCount; ++view){
        if(!snapshot.opaqueFramebuffers[view].valid() || !snapshot.transparentFramebuffers[view].valid())
            return;
    }
    mut DeferredFrameTargets targets = this.m_shadowVisibilityPreparedTargets.value();
    const LightSpaceCaptureIdentity identity = LightSpaceCaptureIdentityBuilder().buildCaptureIdentity(
        state.m_captureSceneIdentity,
        state.m_captureSceneTrusted,
        lights,
        targets.width,
        targets.height,
        plan
    );
    snapshot.captureTicket = state.m_captureHistory.prepare(identity, state.m_settings.captureCadence);
    snapshot.captureHistory = Optional<mut LightSpaceCaptureHistory>(state.m_captureHistory);
    if(!snapshot.captureTicket.reuse){
        snapshot.plan = plan;
        state.m_captureBuffers.assign(state.m_sceneBuffers.begin(), state.m_sceneBuffers.end());
        state.m_captureTextures.assign(state.m_sceneTextures.begin(), state.m_sceneTextures.end());
    }
    const b8 hasOrdinaryTransparent = HasAnyOrdinaryTransparentLightSpaceCaster(state.m_csg.snapshot.hasCsg, state.m_casters);
    snapshot.csgTlasDescriptor = GpuDescriptorHandleInvalid();
    u32 nodeSlot = 0u;
    if(this.m_shadowVisibilityHardwareSupported)
        snapshot.csgTlasDescriptor = this.m_rayTracingState.sceneBvh.m_tlasHeapHandle;
    else
        nodeSlot = this.m_preparedSceneBvh.nodeHeapHandle().slot();
    PopulatePreparedLightSpaceShadowPush(
        snapshot.viewsDescriptor.slot(),
        this.m_rayTracingState.sceneBvh.m_rayTraceMaterialContextSlotsHeapHandle.slot(),
        snapshot.countsDescriptor.slot(),
        snapshot.eventsDescriptor.slot(),
        snapshot.depthDescriptor.slot(),
        cast<u32>(state.m_casters.size()),
        drawCount.value(),
        targets.width,
        targets.shadowReceiverFactor,
        targets.height,
        targets.bindless.slotsBufferDescriptor.slot(),
        nodeSlot,
        state.m_csg.snapshot.hasCsg,
        this.m_shadowVisibilityHardwareSupported,
        hasOrdinaryTransparent,
        snapshot.csgContextDescriptor.slot(),
        snapshot.csgOpaqueDepthDescriptor.slot(),
        plan.viewCount,
        snapshot.drawArgumentsDescriptor.slot(),
        snapshot.push
    );
    mut LightSpaceShadowDiagnostics diagnostics = state.m_diagnostics;
    if(state.m_csg.snapshot.hasCsg)
        snapshot.diagnostics = Optional<mut LightSpaceShadowDiagnostics>(diagnostics);
    if(CanScheduleLightSpaceDiagnosticReadback(state.m_csg.snapshot.hasCsg, diagnostics.readback.valid(), diagnostics.submission.valid(), diagnostics.frameIndex, diagnostics.acceptedFrame)){
        snapshot.diagnosticReadback = diagnostics.readback;
        snapshot.diagnosticFrame = diagnostics.frameIndex;
    }
    snapshot.casters = state.m_casters;
    snapshot.ready = true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 LightSpaceResourceSet::ensureLightSpaceShadowPipelines(){
    mut LightSpaceShadowState state = this.m_state;
    mut LightSpaceShadowSnapshot snapshot = state.m_snapshot;
    const b8 csg = state.m_csg.snapshot.hasCsg;
    const b8 hardwareCsg = csg && this.m_hardwareSupported;
    if(state.m_pipelineFailed)
        return false;
    if(
        snapshot.viewPipeline.valid() && snapshot.cullPipeline.valid() && snapshot.opaqueResolve.valid() && snapshot.transparentResolve.valid()
        && snapshot.opaqueFallback.valid() && snapshot.transparentFallback.valid() && snapshot.shadePipeline.valid()
        && snapshot.opaqueCapture.valid() && snapshot.transparentCapture.valid()
        && (!csg || (snapshot.csgShadePipeline.valid() && snapshot.csgOpaqueResolve.valid() && snapshot.csgTransparentResolve.valid() && (hardwareCsg || (snapshot.csgOpaqueFallback.valid() && snapshot.csgTransparentFallback.valid()))))
    )
        return true;
    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    const FormatSupport depthSupport = FormatSupport::Texture | FormatSupport::DepthStencil | FormatSupport::ShaderLoad;
    if(!heap.isInitialized() || (hardwareCsg && !heap.hasAccelStructLayout()) || (device.queryFormatSupport(Format::D32) & depthSupport) != depthSupport)
        return false;
    if(!EnsurePushConstantBindingLayout(device, sizeof(LightSpaceShadowPush), ShaderTypeMask::All, snapshot.layout))
        return false;
    const Array<StringView, s_LightSpaceComputePipelineTableCount> computeVariants(
        s_ShaderArchiveDefaultVariant,
        s_LightSpaceNoCsgOccluder0,
        s_LightSpaceNoCsgOccluder1,
        s_LightSpaceNoCsgOccluder0,
        s_LightSpaceNoCsgOccluder1,
        s_LightSpaceCsgShade0,
        s_LightSpaceCsgShade1,
        s_LightSpaceCsgOccluder0,
        s_LightSpaceCsgOccluder1,
        s_LightSpaceCsgOccluder0,
        s_LightSpaceCsgOccluder1,
        s_ShaderArchiveDefaultVariant
    );
    for(u32 index = 0u; index < computeVariants.size(); ++index){
        if(ShouldSkipLightSpacePipeline(index, csg, hardwareCsg))
            continue;
        if(!state.m_shaders[index].valid() && !this.m_shaderSystem.loadShader<ComputeShader, ShadowSubsystem>(lambda[in index,
            in hardwareCsg](in ShadowSubsystem subsystem) -> AssetRef<ComputeShader>{ return SelectLightSpaceComputeShader(subsystem, index, hardwareCsg); }, computeVariants[index], (s_LightSpaceShaderScope), state.m_shaders[index])){
            state.m_pipelineFailed = true;
            return false;
        }
    }
    mut ShaderHandle captureVs = state.m_shaders[s_LightSpaceCaptureVertexShaderIndex];
    mut ShaderHandle capturePs = state.m_shaders[s_LightSpaceCapturePixelShaderIndex];
    if(
        (!captureVs.valid() && !this.m_shaderSystem.loadShader<VertexShader, ShadowSubsystem>(lambda[](in ShadowSubsystem s) -> AssetRef<VertexShader>{ return s.lightSpaceCaptureVs; }, s_ShaderArchiveDefaultVariant, (s_LightSpaceShaderScope), captureVs))
        || (!capturePs.valid() && !this.m_shaderSystem.loadShader<PixelShader, ShadowSubsystem>(lambda[](in ShadowSubsystem s) -> AssetRef<PixelShader>{ return s.lightSpaceCapturePs; }, s_ShaderArchiveDefaultVariant, (s_LightSpaceShaderScope), capturePs))
    ){
        state.m_pipelineFailed = true;
        return false;
    }
    for(u32 index = 0u; index < computeVariants.size(); ++index){
        if(ShouldSkipLightSpacePipeline(index, csg, hardwareCsg))
            continue;
        mut ComputePipelineHandle output = SelectLightSpaceOutput(snapshot, index);
        if(output.valid())
            continue;
        const b8 includeAccelStruct = IsLightSpaceCsgResolvePipelineIndex(index, hardwareCsg);
        if(!CreateHeapComputePipeline(device, state.m_shaders[index], snapshot.layout, includeAccelStruct, output))
            return false;
    }
    for(u32 transparent = 0u; transparent < s_LightSpaceCapturePipelineKindCount; ++transparent){
        GraphicsPipelineHandle output = snapshot.opaqueCapture;
        if(transparent != 0u)
            output = snapshot.transparentCapture;
        if(output.valid())
            continue;
        RasterState raster;
        raster.setCullMode(RasterCullMode::None).enableDepthClip();
        DepthStencilState depth;
        depth.setDepthTestEnable(transparent == 0u).setDepthWriteEnable(transparent == 0u).setDepthFunc(ComparisonFunc::Less);
        RenderState render;
        render.setRasterState(raster).setDepthStencilState(depth);
        GraphicsPipelineDesc desc;
        desc.setVertexShader(state.m_shaders[s_LightSpaceCaptureVertexShaderIndex]).setRenderState(render).addBindingLayout(snapshot.layout).addBindingLayout(heap.getResourceLayout()).addBindingLayout(heap.getSamplerLayout());
        if(transparent != 0u)
            desc.setPixelShader(state.m_shaders[s_LightSpaceCapturePixelShaderIndex]);
        FramebufferInfo layout;
        layout.setDepthFormat(Format::D32);
        const Expected<GraphicsPipelineHandle> outputResult = device.createGraphicsPipeline(desc, layout);
        if(outputResult.has_value())
            output = outputResult.value();
        else
            output.reset();
        if(transparent != 0u)
            snapshot.transparentCapture = output;
        else
            snapshot.opaqueCapture = output;
        if(!outputResult.has_value())
            return false;
    }
    return true;
}

b8 LightSpaceResourceSet::ensureLightSpaceShadowStorage(in LightSpacePlan plan){
    mut LightSpaceShadowSnapshot snapshot = this.m_state.m_snapshot;
    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    const Array<u64, 4u> sizes(plan.countByteSize, plan.eventByteSize, plan.viewByteSize, plan.drawArgumentByteSize);
    const u64 maximumRange = device.getMaxStorageBufferRange();
    assert(
        IsValidLightSpaceStorageByteSize(sizes[0], maximumRange)
        && IsValidLightSpaceStorageByteSize(sizes[1], maximumRange)
        && IsValidLightSpaceStorageByteSize(sizes[2], maximumRange)
        && IsValidLightSpaceStorageByteSize(sizes[3], maximumRange)
    );
    if(this.m_state.m_csg.snapshot.hasCsg){
        mut LightSpaceShadowDiagnostics diagnostics = this.m_state.m_diagnostics;
        if(!diagnostics.readback.valid()){
            BufferDesc desc;
            desc
                .setByteSize(sizeof(u32)).setCpuAccess(CpuAccessMode::Read)
                .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
                .setDebugName((s_LightSpaceResourceCsgDiagnosticReadback))
                .enableAutomaticStateTracking(ResourceStates::CopyDest)
            ;
            const Expected<BufferHandle> readbackResult = this.m_graphics.createBuffer(desc);
            if(readbackResult.has_value())
                diagnostics.readback = readbackResult.value();
            else
                diagnostics.readback.reset();
            if(!readbackResult.has_value())
                return false;
        }
        const u64 contextSize = this.m_state.m_csg.bytes.size();
        if(!IsValidLightSpaceStorageByteSize(contextSize, maximumRange))
            return false;
        if(NeedsLightSpaceCsgStorageReallocation(
            snapshot.csgContext.valid(),
            LightSpaceBufferCapacity(snapshot.csgContext),
            contextSize,
            snapshot.csgOpaqueDepth.valid(),
            LightSpaceBufferCapacity(snapshot.csgOpaqueDepth),
            plan.countByteSize
        )){
            Array<BufferHandle, s_LightSpaceCsgStorageBufferCount> csgBuffers;
            Array<GpuDescriptorHandle, s_LightSpaceCsgStorageBufferCount> csgDescriptors;
            GpuDescriptorRetirementGuard retireCsg(heap, Span<GpuDescriptorHandle>(csgDescriptors));
            const Array<u64, s_LightSpaceCsgStorageBufferCount> csgSizes(contextSize, plan.countByteSize);
            const Array<Name, s_LightSpaceCsgStorageBufferCount> csgNames((s_LightSpaceResourceCsgContext), (s_LightSpaceResourceCsgOpaqueDepth));
            for(u32 index = 0u; index < csgBuffers.size(); ++index){
                BufferDesc desc;
                desc
                    .setByteSize(csgSizes[index]).setStructStride(sizeof(u32)).setCanHaveRawViews(true).setCanHaveUAVs(true)
                    .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute).setDebugName(csgNames[index])
                    .enableAutomaticStateTracking(ResourceStates::Common)
                ;
                const Expected<BufferHandle> csgBuffersResult = this.m_graphics.createBuffer(desc);
                if(csgBuffersResult.has_value())
                    csgBuffers[index] = csgBuffersResult.value();
                else
                    csgBuffers[index].reset();
                if(!csgBuffersResult.has_value())
                    return false;
                const auto descriptor = RegisterHeapBuffer(heap, csgBuffers[index].deref(), GpuDescriptorClass::StorageBuffer, true);
                if(!descriptor.has_value())
                    return false;
                csgDescriptors[index] = descriptor.value();
            }
            RetireDescriptor(heap, snapshot.csgContextDescriptor);
            RetireDescriptor(heap, snapshot.csgOpaqueDepthDescriptor);
            snapshot.csgContext = csgBuffers[0];
            diagnostics.contextInitialized = QueueSubmissionToken();
            snapshot.csgOpaqueDepth = csgBuffers[1];
            snapshot.csgContextDescriptor = csgDescriptors[0];
            snapshot.csgOpaqueDepthDescriptor = csgDescriptors[1];
            for(usize i = 0u; i < csgDescriptors.size(); ++i)
                csgDescriptors[i] = GpuDescriptorHandleInvalid();
            this.m_state.m_captureHistory.invalidate();
        }
    }
    if(
        snapshot.counts.valid() && snapshot.events.valid() && snapshot.views.valid() && snapshot.drawArguments.valid() && snapshot.depth.valid()
        && LightSpaceExactStorageMatches(
            plan,
            snapshot.counts.deref().getCreationDescription().byteSize,
            snapshot.events.deref().getCreationDescription().byteSize,
            snapshot.views.deref().getCreationDescription().byteSize,
            snapshot.drawArguments.deref().getCreationDescription().byteSize,
            snapshot.depth.deref().getCreationDescription().width,
            snapshot.depth.deref().getCreationDescription().arraySize
        )
    )
        return true;
    Array<BufferHandle, s_LightSpaceBufferCount> buffers;
    Array<GpuDescriptorHandle, s_LightSpaceDescriptorCount> descriptors;
    GpuDescriptorRetirementGuard retireUnpublished(heap, Span<GpuDescriptorHandle>(descriptors));
    const Array<Name, 4u> names((s_LightSpaceResourceCounts), (s_LightSpaceResourceEvents), (s_LightSpaceResourceViews), (s_LightSpaceResourceDrawArguments));
    for(u32 index = 0u; index < buffers.size(); ++index){
        BufferDesc desc;
        desc
            .setByteSize(sizes[index]).setStructStride(sizeof(u32)).setCanHaveRawViews(true).setCanHaveUAVs(true)
            .setIsDrawIndirectArgs(index == s_LightSpaceDrawArgumentsBufferIndex)
            .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute).setDebugName(names[index])
            .enableAutomaticStateTracking(ResourceStates::Common)
        ;
        const Expected<BufferHandle> buffersResult = this.m_graphics.createBuffer(desc);
        if(buffersResult.has_value())
            buffers[index] = buffersResult.value();
        else
            buffers[index].reset();
        if(!buffersResult.has_value())
            return false;
        const auto descriptor = RegisterHeapBuffer(heap, buffers[index].deref(), GpuDescriptorClass::StorageBuffer, true);
        if(!descriptor.has_value())
            return false;
        descriptors[index] = descriptor.value();
    }
    TextureDesc depthDesc;
    depthDesc
        .setWidth(plan.textureResolution).setHeight(plan.textureResolution).setArraySize(plan.viewCount)
        .setDimension(TextureDimension::Texture2DArray).setFormat(Format::D32).setIsRenderTarget(true)
        .setInitialState(ResourceStates::Common).setKeepInitialState(true)
        .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute).setName((s_LightSpaceResourceDepth))
    ;
    auto depthResult = device.createTexture(depthDesc);
    if(!depthResult.has_value())
        return false;
    TextureHandle depth = depthResult.value();
    if(!AssignSampledTexture(
        heap,
        GpuDescriptorClass::SampledImage2DArray,
        depth.get(),
        Format::D32,
        TextureSubresourceSet(0u, 1u, 0u, plan.viewCount),
        TextureDimension::Texture2DArray,
        descriptors[s_LightSpaceDepthDescriptorIndex]
    ))
        return false;
    Array<FramebufferHandle, s_LightSpaceFramebufferCount> opaque;
    Array<FramebufferHandle, s_LightSpaceFramebufferCount> transparent;
    for(u32 view = 0u; view < plan.viewCount; ++view){
        FramebufferAttachment attachment;
        attachment.setTexture(depth.get()).setArraySlice(view);
        FramebufferDesc frameDesc;
        frameDesc.setDepthAttachment(attachment);
        const Expected<FramebufferHandle> opaqueResult = device.createFramebuffer(frameDesc);
        if(opaqueResult.has_value())
            opaque[view] = opaqueResult.value();
        else
            opaque[view].reset();
        attachment.setIsReadOnly(true);
        frameDesc.setDepthAttachment(attachment);
        const Expected<FramebufferHandle> transparentResult = device.createFramebuffer(frameDesc);
        if(transparentResult.has_value())
            transparent[view] = transparentResult.value();
        else
            transparent[view].reset();
        if(!opaqueResult.has_value() || !transparentResult.has_value())
            return false;
    }
    RetireDescriptor(heap, snapshot.countsDescriptor);
    RetireDescriptor(heap, snapshot.eventsDescriptor);
    RetireDescriptor(heap, snapshot.viewsDescriptor);
    RetireDescriptor(heap, snapshot.drawArgumentsDescriptor);
    RetireDescriptor(heap, snapshot.depthDescriptor);
    this.m_state.m_captureHistory.invalidate();
    snapshot.counts = buffers[s_LightSpaceCountsBufferIndex];
    snapshot.events = buffers[s_LightSpaceEventsBufferIndex];
    snapshot.views = buffers[s_LightSpaceViewsBufferIndex];
    snapshot.drawArguments = buffers[s_LightSpaceDrawArgumentsBufferIndex];
    snapshot.depth = depth;
    snapshot.countsDescriptor = descriptors[s_LightSpaceCountsBufferIndex];
    snapshot.eventsDescriptor = descriptors[s_LightSpaceEventsBufferIndex];
    snapshot.viewsDescriptor = descriptors[s_LightSpaceViewsBufferIndex];
    snapshot.drawArgumentsDescriptor = descriptors[s_LightSpaceDrawArgumentsBufferIndex];
    snapshot.depthDescriptor = descriptors[s_LightSpaceDepthDescriptorIndex];
    snapshot.opaqueFramebuffers = opaque;
    snapshot.transparentFramebuffers = transparent;
    for(usize i = 0u; i < descriptors.size(); ++i)
        descriptors[i] = GpuDescriptorHandleInvalid();
    return true;
}

void LightSpaceResourceSet::releaseLightSpaceShadowResources(){
    mut LightSpaceShadowState state = this.m_state;
    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
    RetireDescriptor(heap, state.m_snapshot.countsDescriptor);
    RetireDescriptor(heap, state.m_snapshot.eventsDescriptor);
    RetireDescriptor(heap, state.m_snapshot.viewsDescriptor);
    RetireDescriptor(heap, state.m_snapshot.drawArgumentsDescriptor);
    RetireDescriptor(heap, state.m_snapshot.depthDescriptor);
    RetireDescriptor(heap, state.m_snapshot.csgContextDescriptor);
    RetireDescriptor(heap, state.m_snapshot.csgOpaqueDepthDescriptor);
    state.m_captureHistory.invalidate();
    state.m_diagnostics = LightSpaceShadowDiagnostics();
    state.m_captureSceneTrusted = false;
    state.m_captureReuseLogged = false;
    state.m_sceneBuffers.clear();
    state.m_captureBuffers.clear();
    state.m_sceneTextures.clear();
    state.m_captureTextures.clear();
    state.m_snapshot = LightSpaceShadowSnapshot();
    state.m_casters.clear();
    for(usize i = 0u; i < state.m_shaders.size(); ++i)
        state.m_shaders[i].reset();
    state.m_sceneEligible = false;
    state.m_resourcesPrepared = false;
    state.m_pipelineFailed = false;
    state.m_dispatchLogged = false;
    state.m_csgDispatchLogged = false;
    state.m_csg.snapshot.hasCsg = false;
    state.m_csg.bytes.clear();
}


