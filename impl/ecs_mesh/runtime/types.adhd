#include <impl/assets_mesh/payload_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[reflect]
class RuntimeMeshHandle{
    public b8 operator==(in RuntimeMeshHandle rhs)const{
        return this.value == rhs.value;
    }

    public b8 operator!=(in RuntimeMeshHandle rhs)const{
        return this.value != rhs.value;
    }

    public b8 valid()const{
        return this.value != 0u;
    }

    public void reset(){
        this.value = 0u;
    }

    public u64 value = 0u;
}

const RuntimeMeshHandle s_InvalidRuntimeMeshHandle();


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


flag<u8> RuntimeMeshDirtyFlag{
    None = 0u,
    SkinningInputDirty,
    GpuUploadDirty,
    MeshletBoundsDirty,
    All = SkinningInputDirty | GpuUploadDirty | MeshletBoundsDirty
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const i32 s_RuntimeMeshBoundsValidFlag = 1 << 0;
const i32 s_RuntimeMeshBoundsFiniteFlag = 1 << 1;

class RuntimeMeshLocalBounds{
    public b8 valid()const{
        return (this.minBounds.w & s_RuntimeMeshBoundsValidFlag) != 0;
    }

    public b8 finite()const{
        return (this.minBounds.w & s_RuntimeMeshBoundsFiniteFlag) != 0;
    }

    public f32x3_i32 minBounds(0.0f, 0.0f, 0.0f, 0);
    public f32x3_i32 maxBounds(0.0f, 0.0f, 0.0f, 0);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> RenderableMeshResolution{
    Absent,
    Unavailable
}

enum<u8> BufferSetupFailure{
    EmptyPayload,
    ByteSizeOverflow,
    CreateFailed
}

// ByteAddress loads whole words; zero-fill tails so terminal u8 decodes stay in range.
const usize s_RawByteLoadAlignmentBytes = 4u;

const StringView s_RtTriangleIndicesBufferName = ":rt_triangle_indices";
const StringView s_RtTriangleAttributesBufferName = ":rt_triangle_attributes";

const StringView s_RuntimePrefix = ":runtime_";
const StringView s_RevisionSeparator = "_revision_";
const StringView s_OwnerSeparator = "_";

const StringView s_RestPositionsSuffix = "rest_positions";
const StringView s_RestNormalsSuffix = "rest_normals";
const StringView s_RestTangentsSuffix = "rest_tangents";
const StringView s_SkinnedPositionsSuffix = "skinned_positions";
const StringView s_SkinnedNormalsSuffix = "skinned_normals";
const StringView s_SkinnedTangentsSuffix = "skinned_tangents";
const StringView s_Uv0Suffix = "uv0";
const StringView s_ColorsSuffix = "colors";
const StringView s_MeshletsSuffix = "meshlets";
const StringView s_MeshletBoundsSuffix = "meshlet_bounds";
const StringView s_MeshletLocalBoundsSuffix = "meshlet_local_bounds";
const StringView s_LocalBoundsSuffix = "local_bounds";
const StringView s_MeshletPositionRefDeltasSuffix = "meshlet_position_ref_deltas";
const StringView s_MeshletAttributeRefDeltasSuffix = "meshlet_attribute_ref_deltas";
const StringView s_MeshletLocalVertexRefsSuffix = "meshlet_local_vertex_refs";
const StringView s_MeshletPrimitiveIndicesSuffix = "meshlet_primitive_indices";
const StringView s_AttributeSkinsSuffix = "attribute_skins";

const usize s_RuntimeMeshRequestInlineCapacity = 32u;
const usize s_RuntimeMeshIndexBucketsPerRequest = 2u;

usize HashRuntimeMeshRequestKey(in NameHash name, in u64 version){
    usize seed = hashValue(name);
    return hashCombineValue(seed, version);
}

class RuntimeMeshRequestKey{
    public RuntimeMeshRequestKey(){
        this.version = 0u;
    }

    public RuntimeMeshRequestKey(in NameHash inName, in u64 inVersion){
        this.name = inName;
        this.version = inVersion;
    }

    public b8 operator==(in RuntimeMeshRequestKey rhs)const{
        return this.version == rhs.version && this.name == rhs.name;
    }

    public usize hash()const{
        return HashRuntimeMeshRequestKey(this.name, this.version);
    }

    public NameHash name;
    public u64 version;
}

class RuntimeMeshRequestEntry{
    public RuntimeMeshRequestEntry(){
        this.found = false;
    }

    public RuntimeMeshRequestEntry(in RuntimeMeshRequestKey inKey, in b8 inFound){
        this.key = inKey;
        this.found = inFound;
    }

    public RuntimeMeshRequestKey key;
    public b8 found;
}

usize FindInlineRuntimeMeshRequest(in Span<RuntimeMeshRequestEntry> entries, in usize inlineCount, in NameHash name, in u64 version){
    for(usize index = 0u; index < inlineCount; ++index){
        const RuntimeMeshRequestKey key = entries[index].key;
        if(key.version == version && key.name == name)
            return index;
    }
    return inlineCount;
}

b8 TryAddInlineRuntimeMeshRequest(
    mut Array<RuntimeMeshRequestEntry, s_RuntimeMeshRequestInlineCapacity> entries,
    mut usize inoutInlineCount,
    mut usize inoutRemainingCount,
    in NameHash name,
    in u64 version
){
    if(FindInlineRuntimeMeshRequest(entries, inoutInlineCount, name, version) < inoutInlineCount)
        return true;
    if(inoutInlineCount < s_RuntimeMeshRequestInlineCapacity){
        entries[inoutInlineCount] = RuntimeMeshRequestEntry(RuntimeMeshRequestKey(name, version), false);
        ++inoutInlineCount;
        ++inoutRemainingCount;
        return true;
    }
    return false;
}

void MarkInlineRuntimeMeshRequestLive(
    mut Array<RuntimeMeshRequestEntry, s_RuntimeMeshRequestInlineCapacity> entries,
    in usize inlineCount,
    mut usize inoutRemainingCount,
    in NameHash name,
    in u64 version
){
    const usize index = FindInlineRuntimeMeshRequest(entries, inlineCount, name, version);
    if(index < inlineCount && !entries[index].found){
        entries[index].found = true;
        --inoutRemainingCount;
    }
}

b8 ContainsInlineRuntimeMeshRequestLive(in Span<RuntimeMeshRequestEntry> entries, in usize inlineCount, in NameHash name, in u64 version){
    const usize index = FindInlineRuntimeMeshRequest(entries, inlineCount, name, version);
    return index < inlineCount && entries[index].found;
}

Expected<usize> TryComputePaddedRawByteCount(in usize logicalByteCount){
    if(logicalByteCount == 0u)
        return makeUnexpected(Failure());
    const usize trailingByteCount = (s_RawByteLoadAlignmentBytes - (logicalByteCount % s_RawByteLoadAlignmentBytes)) % s_RawByteLoadAlignmentBytes;
    const usize paddedByteCount = logicalByteCount + trailingByteCount;
    if(paddedByteCount < logicalByteCount)
        return makeUnexpected(Failure());
    return paddedByteCount;
}

usize ExpectedMeshletSolidTriangleWordCount(in u32 meshletPrimitiveIndexCount){
    return (cast<usize>(meshletPrimitiveIndexCount) / cast<usize>(s_MeshletTriangleIndexCount) + cast<usize>(s_MeshletSolidTriangleWordRoundUp)) / cast<usize>(s_MeshletSolidTriangleWordBits);
}

Name DeriveRuntimeResourceName(in Name sourceName, in u64 ownerId, in u32 editRevision, in StringView label){
    Name outName = s_NameNone;
    if(sourceName == s_NameNone || label.empty())
        return outName;
    native(in sourceName, in ownerId, in editRevision, in label, mut outName){
        Array<char, s_DecimalTextBufferBytes> ownerBuffer;
        Array<char, s_DecimalTextBufferBytes> revisionBuffer;
        const AStringView ownerText = FormatDecimal(static_cast<usize>(ownerId), ownerBuffer);
        const AStringView revisionText = FormatDecimal(static_cast<usize>(editRevision), revisionBuffer);
        if(!ownerText.empty() && !revisionText.empty()){
            if(auto derivedHash = BeginDerivedNameHash(sourceName)){
                if(
                    UpdateDerivedNameHashText(*derivedHash, s_RuntimePrefix)
                    && UpdateDerivedNameHashText(*derivedHash, ownerText)
                    && UpdateDerivedNameHashText(*derivedHash, s_RevisionSeparator)
                    && UpdateDerivedNameHashText(*derivedHash, revisionText)
                    && UpdateDerivedNameHashText(*derivedHash, s_OwnerSeparator)
                    && UpdateDerivedNameHashText(*derivedHash, label)
                ){
                    if(const auto finished = FinishDerivedNameHash(*derivedHash))
                        outName = *finished;
                }
            }
        }
    }
    return outName;
}


