class ShadowPrepareStateLifecycleContext{
    public mut RendererFramePipeline renderer;
    private GpuPersistentStateCandidate m_stateCandidate;
    public Span<BufferHandle> buffers;
    public b8 stateCandidateRequired = false;
    public b8 statePrepared = false;
    public b8 stateReady = true;

    public ShadowPrepareStateLifecycleContext(mut RendererFramePipeline renderer){
        this.renderer = renderer;
        this.m_stateCandidate = GpuPersistentStateCandidate(renderer.m_shadowPreparePersistentState);
    }

    public b8 recorded(in Optional<in CommandListResourceStateHandoff> finalState){
        if(!finalState.has_value())
            return false;
        const b8 candidateBuilt = this.renderer.m_shadowPreparePersistentState.buildMergedBufferSubset(finalState.value(), this.buffers, this.m_stateCandidate);
        this.statePrepared = IsShadowPrepareStateCandidatePrepared(candidateBuilt, this.m_stateCandidate.valid(), this.m_stateCandidate.empty(), this.stateCandidateRequired);
        return this.statePrepared;
    }
    public b8 accepted(in QueueSubmissionToken token){
        if(!this.statePrepared)
            return false;

        mut RendererFramePipeline renderer = this.renderer;
        if(!CanCommitShadowPrepareStateCandidate(this.m_stateCandidate.valid(), this.m_stateCandidate.empty(), this.stateCandidateRequired)){
            this.stateReady = false;
            renderer.m_raytracingSystem.discardPreflightShadowVisibilityResources();
            return false;
        }

        this.stateReady = renderer.m_shadowPreparePersistentState.commit(this.m_stateCandidate);
        if(!this.stateReady){
            renderer.m_raytracingSystem.discardPreflightShadowVisibilityResources();
            return false;
        }
        renderer.m_raytracingSystem.confirmPreparedSceneTlasBuild();
        renderer.m_raytracingSystem.confirmPreparedMeshBlasBuilds();
        renderer.m_raytracingSystem.confirmPreparedMeshSwBvhBuilds();
        return true;
    }
}

class PersistentStateSubsetBinding{
    private mut GpuPersistentResourceStateCache m_state;
    private GpuPersistentStateCandidate m_candidate;
    private b8 m_merged;

    public PersistentStateSubsetBinding(mut GpuPersistentResourceStateCache state, in b8 merged){
        this.m_state = state;
        this.m_candidate = GpuPersistentStateCandidate(state);
        this.m_merged = merged;
    }

    public b8 record(in CommandListResourceStateHandoff finalState, in Span<TextureHandle> textures, in Span<BufferHandle> buffers){
        if(this.m_merged)
            return this.m_state.buildMergedResourceSubset(finalState, textures, buffers, this.m_candidate);
        return this.m_state.buildFilteredResourceSubset(finalState, textures, buffers, this.m_candidate);
    }

    public b8 commit(){
        return this.m_state.commit(this.m_candidate);
    }
}

class ShadowVisibilityStateLifecycleContext{
    public mut RendererFramePipeline renderer;
    public mut DeferredFrameTargets targets;
    private PersistentStateSubsetBinding m_returnState;
    private PersistentStateSubsetBinding m_scratchState;
    public Span<TextureHandle> returnTextures;
    public Span<TextureHandle> scratchTextures;
    public Span<BufferHandle> scratchBuffers;
    public Optional<in b8> lightSpacePrepared;
    public LightSpaceCaptureTicket lightSpaceCaptureTicket;
    public b8 statePrepared = false;
    public b8 stateReady = false;

    public ShadowVisibilityStateLifecycleContext(mut RendererFramePipeline renderer, mut DeferredFrameTargets targets){
        this.renderer = renderer;
        this.targets = targets;
        this.m_returnState = PersistentStateSubsetBinding(renderer.m_shadowVisibilityReturnState, false);
        this.m_scratchState = PersistentStateSubsetBinding(renderer.m_shadowComputePersistentState, true);
    }

    public b8 recorded(in Optional<in CommandListResourceStateHandoff> finalState){
        if(this.returnTextures.empty() || this.scratchTextures.empty() || this.scratchBuffers.empty() || !finalState.has_value())
            return false;

        const b8 scratchStateReady = this.m_scratchState.record(finalState.value(), this.scratchTextures, this.scratchBuffers);
        const b8 returnStateReady = this.m_returnState.record(finalState.value(), this.returnTextures, Span<BufferHandle>());
        this.statePrepared = AreDualPersistentStateSubsetsReady(returnStateReady, scratchStateReady);
        return this.statePrepared;
    }
    public b8 accepted(in QueueSubmissionToken token){
        if(!this.statePrepared)
            return false;

        const b8 returnStateReady = this.m_returnState.commit();
        const b8 scratchStateReady = this.m_scratchState.commit();
        this.stateReady = AreDualPersistentStateSubsetsReady(returnStateReady, scratchStateReady);
        this.renderer.m_raytracingSystem.finalizeSoftShadowTemporalHistory(this.targets);
        if(ShouldAcceptLightSpaceShadowCaptureOnVisibility(this.stateReady, this.lightSpacePrepared.has_value()))
            this.renderer.m_raytracingSystem.acceptLightSpaceShadowCapture(this.lightSpaceCaptureTicket, this.lightSpacePrepared.value());
        return this.stateReady;
    }
}

