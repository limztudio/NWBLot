template<typename Storage, usize LogicalCount, typename Source>
void CheckDoubleStoresIgnoreInactiveLanesAndPreserveObjectPadding(const Source& source, const Array<f64, LogicalCount>& expected){
    struct StorageRecord{
        Storage value;
        Array<u64, 4> neighbor{};
    };
    StorageRecord record{};
    NWB_MEMSET(&record, 0xa5, sizeof(record));
    const Array<u64, 3> poison = { 0x7ff0000000000000u, 0x7ff8000000001234u, 0xfff0000000000000u };
    const usize logicalBytes = LogicalCount * sizeof(f64);
    NWB_MEMCPY(reinterpret_cast<u8*>(&record.value) + logicalBytes, sizeof(Storage) - logicalBytes, poison.data(), sizeof(Storage) - logicalBytes);
    Array<u8, sizeof(StorageRecord)> original{};
    NWB_MEMCPY(original.data(), original.size(), &record, sizeof(record));
    for(const b8 stream : { false, true }){
        NWB_MEMCPY(&record, sizeof(record), original.data(), original.size());
        if(stream){
            StreamDouble(source, record.value);
            StreamDoubleFence();
        }
        else
            StoreDouble(source, record.value);
        const auto bytes = MakeNotNull(reinterpret_cast<const u8*>(&record));
        for(usize index = logicalBytes; index < sizeof(record); ++index)
            EXPECT_EQ(bytes.get()[index], original[index]) << stream << ':' << index;
        for(usize lane = 0u; lane < LogicalCount; ++lane)
            EXPECT_EQ(BitCast<u64>(record.value.raw[lane]), BitCast<u64>(expected[lane])) << stream << ':' << lane;

        const auto loaded = LoadDouble(record.value);
        if constexpr(LogicalCount < 4u){
            for(usize lane = LogicalCount; lane < 4u; ++lane)
                EXPECT_EQ(BitCast<u64>(loaded[lane]), 0u) << stream << ':' << lane;
            const SIMDVectorDouble transformed = VectorDouble4Transform(loaded, MatrixDoubleIdentity());
            for(usize lane = 0u; lane < LogicalCount; ++lane)
                EXPECT_EQ(transformed[lane], expected[lane]) << stream << ':' << lane;
        }
        else{
            for(usize row = 0u; row < 3u; ++row){
                EXPECT_EQ(BitCast<u64>(loaded.v[row].w), 0u) << stream << ':' << row;
                for(usize lane = 0u; lane < 3u; ++lane)
                    EXPECT_EQ(BitCast<u64>(loaded.v[row][lane]), BitCast<u64>(expected[row * 3u + lane])) << stream << ':' << row << ':' << lane;
            }
            EXPECT_TRUE(VectorDouble4Equal(loaded.v[3], SIMDVectorDouble{ 0.0, 0.0, 0.0, 1.0 }));
        }
    }
}

template<typename Storage, usize LogicalCount>
void CheckDoubleStorageHashIgnoresPaddingAndCanonicalizesSignedZero(){
    Storage lhs{};
    Storage rhs{};
    for(usize lane = 0u; lane < LogicalCount; ++lane){
        lhs.raw[lane] = lane == 0u ? -0.0 : 1.0 + 0x1p-52;
        rhs.raw[lane] = lane == 0u ? 0.0 : 1.0 + 0x1p-52;
    }
    const usize logicalBytes = LogicalCount * sizeof(f64);
    NWB_MEMSET(reinterpret_cast<u8*>(&lhs) + logicalBytes, 0x7f, sizeof(Storage) - logicalBytes);
    NWB_MEMSET(reinterpret_cast<u8*>(&rhs) + logicalBytes, 0xff, sizeof(Storage) - logicalBytes);
    EXPECT_EQ(lhs, rhs);
    EXPECT_EQ(Hasher<Storage>{}(lhs), Hasher<Storage>{}(rhs));
    rhs.raw[LogicalCount - 1u] = 1.0;
    EXPECT_NE(lhs, rhs);
}

template<typename Element, usize Count>
struct RawEqualityStorage{
    Array<Element, Count> raw{};


public:
    friend b8 operator==(const RawEqualityStorage& lhs, const RawEqualityStorage& rhs)noexcept{
        return MathTypeDetail::EqualElements<Element, Count>(MakeNotNull<const Element*>(lhs.raw.data()), MakeNotNull<const Element*>(rhs.raw.data()));
    }
    friend b8 operator!=(const RawEqualityStorage& lhs, const RawEqualityStorage& rhs)noexcept{ return !(lhs == rhs); }
};

template<typename Value, usize Count>
NWB_NOINLINE b8 LegacyEqual(const Value& lhs, const Value& rhs)noexcept{
#pragma STDC FENV_ACCESS ON
    for(usize lane = 0u; lane < Count; ++lane){
        if(lhs.raw[lane] != rhs.raw[lane])
            return false;
    }
    return true;
}

#pragma STDC FENV_ACCESS OFF
template<typename Value, usize Count>
NWB_NOINLINE b8 DefaultContextLegacyEqual(const Value& lhs, const Value& rhs)noexcept{
    for(usize i = 0u; i < Count; ++i){
        if(lhs.raw[i] != rhs.raw[i])
            return false;
    }
    return true;
}

template<typename Value>
NWB_NOINLINE b8 StorageEqual(const Value& lhs, const Value& rhs)noexcept{
#pragma STDC FENV_ACCESS ON
    return lhs == rhs;
}

template<typename Result>
struct ExpectedVectorStorage{
    u64 prefix = 0u;
    Array<Expected<Result>, 2> values;
};

template<typename Result>
NWB_NOINLINE auto ReadExpectedVector(const Expected<Result>& result)noexcept{ return result->value; }

template<typename Result, typename Lane, usize Count>
void CheckExpectedVectorAlignment(const Array<Lane, Count>& bits){
    using VectorType = decltype(Result{}.value);
    ExpectedVectorStorage<Result> storage{};
    for(usize index = 0u; index < 2u; ++index){
        storage.values[index] = Result{ BitCast<VectorType>(bits) };
        ASSERT_TRUE(storage.values[index]);
        EXPECT_EQ(reinterpret_cast<usize>(&storage.values[index]) % alignof(VectorType), 0u);
        EXPECT_EQ(reinterpret_cast<usize>(&storage.values[index]->value) % alignof(VectorType), 0u);
        EXPECT_EQ((BitCast<Array<Lane, Count>>(ReadExpectedVector(storage.values[index]))), bits);
    }
}

template<typename Value, usize Count>
void CheckNaNComparisonFlags(){
#pragma STDC FENV_ACCESS ON
    const auto original = GetFloatingPointEnvironment();
    ASSERT_TRUE(original);
    ScopeExit restore([&]()noexcept{
        if(!SetFloatingPointEnvironment(*original))
            NWB_ASSERT(false);
    });
    for(const u32 nanBits : { 0x7FC12345u, 0x7F812345u }){
        for(usize nanLane = 0u; nanLane < Count; ++nanLane){
            for(usize mismatch = 0u; mismatch <= Count; ++mismatch){
                Value lhs{}, rhs{};
                for(usize lane = 0u; lane < Count; ++lane)
                    lhs.raw[lane] = rhs.raw[lane] = static_cast<f32>(lane + 1u);
                lhs.raw[nanLane] = rhs.raw[nanLane] = BitCast<f32>(nanBits);
                if(mismatch < Count && mismatch != nanLane)
                    rhs.raw[mismatch] = rhs.raw[mismatch] + 1.0f;
                ASSERT_TRUE(ClearFloatingPointExceptions(FE_ALL_EXCEPT));
                const b8 expected = LegacyEqual<Value, Count>(lhs, rhs);
                const i32 expectedFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
                ASSERT_TRUE(ClearFloatingPointExceptions(FE_ALL_EXCEPT));
                const b8 actual = StorageEqual(lhs, rhs);
                const i32 actualFlags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
                EXPECT_EQ(actual, expected) << nanLane << ", " << mismatch;
                EXPECT_EQ(actualFlags, expectedFlags) << nanLane << ", " << mismatch;
            }
        }
    }
}

#if defined(NWB_HAS_SSE2)
struct EqualityEnvironmentGuard{
    Expected<FloatingPointEnvironment> original = GetFloatingPointEnvironment();
    u32 originalMxcsr = _mm_getcsr();


public:
    ~EqualityEnvironmentGuard()noexcept{
        if(original){
            EXPECT_TRUE(SetFloatingPointEnvironment(*original));
            _mm_setcsr(originalMxcsr);
        }
    }
};

template<typename Value, typename Compare>
Expected<NWB::Tests::MathCases::EqualityObservation> ObserveEquality(const Value& lhs, const Value& rhs, Compare compare)noexcept(noexcept(DeclVal<void(*)(b8)noexcept>()(compare(lhs, rhs))) && IsNothrowDestructible_V<Compare>){
#pragma STDC FENV_ACCESS ON
    if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT))
        return MakeUnexpected(Failure{});
    _mm_setcsr(_mm_getcsr() & ~0x3Fu);
    const b8 equal = compare(lhs, rhs);
    NWB::Tests::MathCases::EqualityObservation obs{};
    obs.flags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    obs.rawFlags = _mm_getcsr() & 0x3Fu;
    obs.equal = equal;
    return obs;
}

template<typename Value, usize Count>
void CheckRawEqualityComparisonFlags(){
#pragma STDC FENV_ACCESS ON
    EqualityEnvironmentGuard restore;
    ASSERT_TRUE(restore.original);
    const auto held = HoldFloatingPointExceptions();
    ASSERT_TRUE(held);
    const u32 heldMxcsr = _mm_getcsr();
    for(const u32 mode : { 0u, 0x40u, 0x8000u, 0x8040u }){
        _mm_setcsr((heldMxcsr & ~(0x8040u | 0x3Fu)) | mode);
        for(const u32 bits : { 0x00000001u, 0x80000001u, 0x007FFFFFu, 0x807FFFFFu, 0x7FC12345u, 0x7F812345u }){
            for(usize exceptionalLane = 0u; exceptionalLane < Count; ++exceptionalLane){
                for(usize mismatch = 0u; mismatch <= Count; ++mismatch){
                    for(const b8 compareWithZero : { false, true }){
                        Value lhs{}, rhs{};
                        for(usize lane = 0u; lane < Count; ++lane)
                            lhs.raw[lane] = rhs.raw[lane] = static_cast<f32>(lane + 1u);
                        lhs.raw[exceptionalLane] = BitCast<f32>(bits);
                        rhs.raw[exceptionalLane] = compareWithZero ? 0.0f : BitCast<f32>(bits);
                        if(mismatch < Count && mismatch != exceptionalLane)
                            rhs.raw[mismatch] = rhs.raw[mismatch] + 1.0f;
                        const auto strict = ObserveEquality(lhs, rhs, LegacyEqual<Value, Count>);
                        ASSERT_TRUE(strict);
                        const auto actual = ObserveEquality(lhs, rhs, StorageEqual<Value>);
                        ASSERT_TRUE(actual);
                        EXPECT_EQ(actual->equal, strict->equal) << mode << ", " << exceptionalLane << ", " << mismatch;
                        EXPECT_EQ(actual->flags, strict->flags) << mode << ", " << exceptionalLane << ", " << mismatch;
                        EXPECT_EQ(actual->rawFlags, strict->rawFlags) << mode << ", " << exceptionalLane << ", " << mismatch;
                        const auto defaultContext = ObserveEquality(lhs, rhs, DefaultContextLegacyEqual<Value, Count>);
                        ASSERT_TRUE(defaultContext);
                        const auto actualDefault = ObserveEquality(lhs, rhs, StorageEqual<Value>);
                        ASSERT_TRUE(actualDefault);
                        EXPECT_EQ(actualDefault->equal, defaultContext->equal) << mode << ", " << exceptionalLane << ", " << mismatch;
                        EXPECT_EQ(actualDefault->flags, defaultContext->flags) << mode << ", " << exceptionalLane << ", " << mismatch;
                        EXPECT_EQ(actualDefault->rawFlags, defaultContext->rawFlags) << mode << ", " << exceptionalLane << ", " << mismatch;
                    }
                }
            }
        }
    }
}
#endif

#if defined(__linux__)
template<typename Value, usize Count>
void CheckPageBoundary(){
    const isize pageSize = static_cast<isize>(sysconf(_SC_PAGESIZE));
    ASSERT_GT(pageSize, 0);
    void* const mapping = mmap(nullptr, static_cast<usize>(pageSize) * 2u, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
    ASSERT_NE(mapping, MAP_FAILED);
    const i32 protection = static_cast<i32>(mprotect(static_cast<char*>(mapping) + pageSize, static_cast<usize>(pageSize), PROT_NONE));
    if(protection != 0){
        munmap(mapping, static_cast<usize>(pageSize) * 2u);
        FAIL() << "Unable to protect equality boundary page";
    }
    Value* const lhs = ::new(static_cast<char*>(mapping) + pageSize - sizeof(Value)) Value{};
    Value rhs{};
    for(usize lane = 0u; lane < Count; ++lane)
        lhs->raw[lane] = rhs.raw[lane] = static_cast<RemoveCVRef_T<decltype(rhs.raw[0])>>(lane + 1u);
    EXPECT_TRUE(StorageEqual(*lhs, rhs));
    if constexpr(IsSame_V<RemoveCVRef_T<decltype(rhs.raw[0])>, b8>)
        rhs.raw[Count - 1u] = !rhs.raw[Count - 1u];
    else
        rhs.raw[Count - 1u] += 1;
    EXPECT_FALSE(StorageEqual(*lhs, rhs));
    lhs->~Value();
    EXPECT_EQ(munmap(mapping, static_cast<usize>(pageSize) * 2u), 0);
}
#endif

template<typename VectorT>
struct ThrowingStreamLoadResult{
    operator VectorT()const{ throw u32{ 0xE208u }; }
};

struct SingleStreamLoadInput{};
struct DoubleStreamLoadInput{};

[[nodiscard]] ThrowingStreamLoadResult<SIMDVectorSingle> LoadFloat(const SingleStreamLoadInput&)noexcept;
