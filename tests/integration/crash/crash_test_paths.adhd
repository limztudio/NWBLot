#include <tests/common/gtest_macros.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <core/alloc/general.h>
#include <core/crash/package_names.h>
#include <core/global.h>

#include <global/filesystem/executable_paths.h>
#include <global/filesystem/operations.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace NWB::Tests::CrashTestPaths{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using GlobalArena = Core::Alloc::GlobalArena;
using CrashTestPath = ::Path<Core::Alloc::GlobalArena>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_TestStorageDirectoryName = "test_storage";
const StringView s_SpoolDirectoryName = "spool";

CrashTestPath CrashRootDirectory(mut GlobalArena arena){
    CrashTestPath result = CrashTestPath(arena);
    native(mut arena, mut result){
        const auto executableDirectory = ExecutablePaths(arena).directory();
        if(executableDirectory)
            result = *executableDirectory / Core::Crash::PackageNames::s_DefaultRootDirectoryName;
        else
            result = CrashTestPath(arena, Core::Crash::PackageNames::s_DefaultRootDirectoryName);
    }
    return result;
}

CrashTestPath TestRootDirectory(mut GlobalArena arena){
    return CrashRootDirectory(arena) / s_TestStorageDirectoryName;
}

CrashTestPath TestCaseDirectory(mut GlobalArena arena, in StringView testGroup){
    return TestRootDirectory(arena) / testGroup;
}

CrashTestPath SpoolDirectory(mut GlobalArena arena, in StringView testGroup){
    return TestCaseDirectory(arena, testGroup) / s_SpoolDirectoryName;
}

void RemoveTestArtifacts(mut GlobalArena arena, in StringView testGroup){
    EXPECT_TRUE(RemoveAllIfExists(TestCaseDirectory(arena, testGroup)));
}


