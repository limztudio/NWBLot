////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/global.adhd>

#include <impl/assets_material/asset.adhd>
#include <impl/assets_mesh/asset.adhd>
#include <impl/assets_mesh/skin_asset.adhd>
#include <impl/assets_model/types.adhd>
#include <impl/assets_skeleton/asset.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_ModelAssetKindLabel = "model";
const StringView s_ModelLoadBinaryContext = "Model::loadBinary";
const StringView s_ModelSerializeContext = "ModelAssetCodec::serialize";
const StringView s_ModelSkeletonObjectsPayloadLabel = "skeleton objects";
const StringView s_ModelStaticMeshObjectsPayloadLabel = "static mesh objects";
const StringView s_ModelSkinnedMeshObjectsPayloadLabel = "skinned mesh objects";

type SkeletonObjectVector = Vector<ModelSkeletonObject>;
type StaticMeshObjectVector = Vector<ModelStaticMeshObject>;
type SkinnedMeshObjectVector = Vector<ModelSkinnedMeshObject>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[asset("model")]
class Model{
    private SkeletonObjectVector m_skeletonObjects;
    private StaticMeshObjectVector m_staticMeshObjects;
    private SkinnedMeshObjectVector m_skinnedMeshObjects;

    public b8 validatePayload()const;
    public b8 validatePayload(mut ScratchArena scratchArena)const;
    public b8 loadBinary(in Span<u8> binary);

    public void setObjects(
        in SkeletonObjectVector skeletonObjects,
        in StaticMeshObjectVector staticMeshObjects,
        in SkinnedMeshObjectVector skinnedMeshObjects
    ){
        this.m_skeletonObjects = skeletonObjects;
        this.m_staticMeshObjects = staticMeshObjects;
        this.m_skinnedMeshObjects = skinnedMeshObjects;
    }

    public void takeObjects(
        mut SkeletonObjectVector outSkeletonObjects,
        mut StaticMeshObjectVector outStaticMeshObjects,
        mut SkinnedMeshObjectVector outSkinnedMeshObjects
    ){
        outSkeletonObjects = this.m_skeletonObjects;
        this.m_skeletonObjects.clear();
        outStaticMeshObjects = this.m_staticMeshObjects;
        this.m_staticMeshObjects.clear();
        outSkinnedMeshObjects = this.m_skinnedMeshObjects;
        this.m_skinnedMeshObjects.clear();
    }

    public in SkeletonObjectVector skeletonObjects()const{ return this.m_skeletonObjects; }
    public in StaticMeshObjectVector staticMeshObjects()const{ return this.m_staticMeshObjects; }
    public in SkinnedMeshObjectVector skinnedMeshObjects()const{ return this.m_skinnedMeshObjects; }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
