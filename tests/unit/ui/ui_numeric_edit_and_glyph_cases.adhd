class UiNumericSelectionEpochSource : ComboSource{
    public TestObserved<Optional<mut EditModel>> onText;
    public TestObserved<Optional<mut EditModel>> onRevision;
    public TestObserved<Optional<mut UiNumericSelectionEpochSource>> armSource;
    public Optional<mut EditModel> armDraft;
    public UiNumericSelectionEpochMutation mutation = UiNumericSelectionEpochMutation::SelectionRoundTrip;
    public TestObserved<b8> mutationApplied;

    public UiNumericSelectionEpochSource(){ this.count = 5u; }
    public u64 revision()const override{
        if(this.onRevision.value().has_value()){
            mut EditModel draft = this.onRevision.value().value();
            this.onRevision.value().reset();
            this.mutationApplied.value() = MutateUiNumericSelectionEpochDraft(this.mutation, draft);
        }
        return this.contentRevision;
    }
    public StringView text(in u64 index)const override{
        const StringView result = this.baseText(index);
        if(this.onText.value().has_value()){
            mut EditModel draft = this.onText.value().value();
            this.onText.value().reset();
            this.mutationApplied.value() = MutateUiNumericSelectionEpochDraft(this.mutation, draft);
        }
        if(this.armSource.value().has_value()){
            this.armSource.value().value().onRevision.value() = this.armDraft;
            this.armSource.value().reset();
        }
        return result;
    }
    public void armTextDraft(mut EditModel draft){
        this.onText.value() = Optional<mut EditModel>(draft);
    }
    public void armRevisionOnSource(mut UiNumericSelectionEpochSource source, mut EditModel draft){
        this.armSource.value() = Optional<mut UiNumericSelectionEpochSource>(source);
        this.armDraft = Optional<mut EditModel>(draft);
    }
}

