void VerifyUiPopupLayoutTests_OversizedPopupShrinksToTheViewportOnBothAxes(){
    PopupOptions options = PopupOptions();
    options.anchor = MakeUiPopupRect(40.0f, 40.0f, 20.0f, 20.0f);
    options.size.x = 1000.0f;
    options.size.y = 900.0f;
