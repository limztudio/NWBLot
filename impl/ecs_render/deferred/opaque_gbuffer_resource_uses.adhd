#include <impl/ecs_render/csg/types.adhd>
#include <impl/ecs_render/deferred/import_types.adhd>
#include <impl/ecs_render/kernel/task_graph_resource_descs.adhd>
#include <impl/ecs_render/shared/frame_push_constants.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class OpaqueGbufferResourceUseInputs{
    public BufferRange materialInstanceRange;
    public BufferRange materialTypedRange;
    public BufferRange csgReceiverRange;
    public BufferRange csgCutterRange;
    public TextureSubresourceSet csgPeelSubresources;
    public TextureSubresourceSet csgReceiverEventDataSubresources;
    public TextureSubresourceSet csgReceiverEventCountSubresources;
    public b8 hasOpaqueDrawItems = false;
    public b8 hasCsgFrameGpuWork = false;
    public b8 hasOpaqueCsgFrameWork = false;
}


usize ComputeOpaqueGbufferResourceUseCapacity(
    in b8 hasOpaqueDrawItems,
    in b8 hasCsgFrameGpuWork,
    in b8 hasOpaqueCsgFrameWork,
    in usize opaqueDrawUseCount,
    in usize noOpaqueDrawUseCount,
    in usize csgFrameUseCount
){
    usize count = noOpaqueDrawUseCount;
    if(hasOpaqueDrawItems)
        count = opaqueDrawUseCount;
    if(hasCsgFrameGpuWork)
        count += csgFrameUseCount;
    if(hasOpaqueCsgFrameWork)
        count += csgFrameUseCount;
    return count;
}

void AppendOpaqueGbufferResourceUses(in DeferredGraphResourceImportResult resources, in OpaqueGbufferResourceUseInputs inputs, mut Vector<GpuTaskResourceUse> uses){
    uses.reserve(ComputeOpaqueGbufferResourceUseCapacity(
        inputs.hasOpaqueDrawItems,
        inputs.hasCsgFrameGpuWork,
        inputs.hasOpaqueCsgFrameWork,
        s_OpaqueDrawResourceUseCount,
        s_NoOpaqueDrawResourceUseCount,
        s_OpaqueCsgFrameResourceUseCount
    ));
    uses.push_back(ReadUse(resources.meshView, ResourceStates::ConstantBuffer));
    if(inputs.hasOpaqueDrawItems){
        uses.push_back(ReadBufferUse(resources.materialInstances, inputs.materialInstanceRange));
        uses.push_back(ReadBufferUse(resources.materialTyped, inputs.materialTypedRange));
    }
    if(inputs.hasCsgFrameGpuWork){
        uses.push_back(ReadBufferUse(resources.csgReceiverRanges, inputs.csgReceiverRange));
        uses.push_back(ReadBufferUse(resources.csgCutters, inputs.csgCutterRange));
        uses.push_back(ReadUse(resources.csgClipContextSlots, ResourceStates::ConstantBuffer));
        uses.push_back(ReadUse(resources.csgIntervalSampleState, ResourceStates::ConstantBuffer));
        uses.push_back(ReadUse(resources.currentBindlessSlots, ResourceStates::ConstantBuffer));
    }
    if(inputs.hasOpaqueCsgFrameWork){
        uses.push_back(WriteTextureUse(resources.csgCapBackNormal, inputs.csgPeelSubresources, ResourceStates::UnorderedAccess));
        uses.push_back(WriteTextureUse(resources.csgIntervalDepth, inputs.csgPeelSubresources, ResourceStates::UnorderedAccess));
        uses.push_back(ReadWriteTextureUse(resources.csgIntervalId, inputs.csgPeelSubresources, ResourceStates::UnorderedAccess));
        uses.push_back(WriteTextureUse(resources.csgReceiverEventData, inputs.csgReceiverEventDataSubresources, ResourceStates::UnorderedAccess));
        uses.push_back(ReadWriteTextureUse(resources.csgReceiverEventCount, inputs.csgReceiverEventCountSubresources, ResourceStates::UnorderedAccess));
    }
    uses.push_back(WriteUse(resources.albedo, ResourceStates::RenderTarget));
    uses.push_back(WriteUse(resources.normal, ResourceStates::RenderTarget));
    uses.push_back(WriteUse(resources.worldPosition, ResourceStates::RenderTarget));
    uses.push_back(WriteUse(resources.specularRoughness, ResourceStates::RenderTarget));
    uses.push_back(WriteUse(resources.depth, ResourceStates::DepthWrite));
}


