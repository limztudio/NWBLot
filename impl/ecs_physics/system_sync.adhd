#include <impl/assets_mesh/asset.adhd>
#include <impl/assets_mesh/meshlet_triangle_indices.adhd>
#include <impl/ecs_physics/components.adhd>
#include <impl/physics/gpu/gpu_dispatcher.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class EcsWorldPose{
    public Transform3D transform;
    public f32x4 scale(1.0f, 1.0f, 1.0f, 0.0f);
}

b8 EcsVec4NearlyEqual(in VectorSingle a, in VectorSingle b, in f32 eps){
    return Abs(a.x - b.x) <= eps && Abs(a.y - b.y) <= eps && Abs(a.z - b.z) <= eps && Abs(a.w - b.w) <= eps;
}

b8 EcsTransformsNearlyEqual(in Transform3D a, in Transform3D b){
    const b8 posEq = EcsVec4NearlyEqual(VectorSingle(a.position), VectorSingle(b.position), 1.0e-5f);
    const f32 qDot = Abs(a.rotation.x * b.rotation.x + a.rotation.y * b.rotation.y + a.rotation.z * b.rotation.z + a.rotation.w * b.rotation.w);
    return posEq && qDot >= 0.99999f;
}

EcsWorldPose ResolveEntityWorldPose(in World world, in EntityID entity){
    EcsWorldPose pose;
    if(!entity.valid() || !world.alive(entity) || !world.hasComponent<TransformComponent>(entity))
        return pose;

    if(!world.hasComponent<PhysicsParentComponent>(entity)){
        in TransformComponent rootXf = world.getComponent<TransformComponent>(entity);
        pose.transform = Transform3D(VectorSingle(rootXf.position), SafeNormalizeQuat(VectorSingle(rootXf.rotation)));
        pose.scale = rootXf.scale;
        return pose;
    }

    FixedVector<EntityID, 33u> chain;
    chain.push_back(entity);
    EntityID cur = entity;
    for(u32 depth = 0u; depth < 32u; ++depth){
        if(!world.hasComponent<PhysicsParentComponent>(cur))
            break;
        in PhysicsParentComponent pp = world.getComponent<PhysicsParentComponent>(cur);
        if(!pp.parent.valid() || !world.alive(pp.parent) || !world.hasComponent<TransformComponent>(pp.parent))
            break;
        b8 seen = false;
        for(usize k = 0u; k < chain.size(); ++k){
            if(chain[k] == pp.parent){
                seen = true;
                break;
            }
        }
        if(seen)
            break;
        chain.push_back(pp.parent);
        cur = pp.parent;
    }

    const usize rootIdx = chain.size() - 1u;
    in TransformComponent rootXf = world.getComponent<TransformComponent>(chain[rootIdx]);
    pose.transform = Transform3D(VectorSingle(rootXf.position), SafeNormalizeQuat(VectorSingle(rootXf.rotation)));
    pose.scale = rootXf.scale;

    for(isize ci = cast<isize>(rootIdx) - 1; ci >= 0; --ci){
        const EntityID childId = chain[cast<usize>(ci)];
        in TransformComponent childXf = world.getComponent<TransformComponent>(childId);
        in PhysicsParentComponent childParent = world.getComponent<PhysicsParentComponent>(childId);

        VectorSingle pScale = VectorSingle(pose.scale);
        if(!childParent.inheritScale)
            pScale = VectorSingle(1.0f, 1.0f, 1.0f, 0.0f);

        const VectorSingle scaledLocalPos(childXf.position.x * pScale.x, childXf.position.y * pScale.y, childXf.position.z * pScale.z, 0.0f);
        const VectorSingle pRot = SafeNormalizeQuat(VectorSingle(pose.transform.rotation));
        const VectorSingle cRot = SafeNormalizeQuat(VectorSingle(childXf.rotation));
        pose.transform.position = f32x4(VectorSingle(pose.transform.position) + Vector3Rotate(scaledLocalPos, pRot), 0.0f);
        pose.transform.rotation = f32x4(SafeNormalizeQuat(QuaternionMultiply(pRot, cRot)));
        pose.scale = f32x4(pScale.x * childXf.scale.x, pScale.y * childXf.scale.y, pScale.z * childXf.scale.z, 0.0f);
    }
    return pose;
}

MassData BuildCustomMassData(in RigidBodyComponent rb){
    MassData md;
    md.setCenterMass(VectorSingle(rb.customCenterOfMass), Max(rb.customMass, 1.0e-5f));
    const f32 ixx = Max(rb.customInertiaDiag.x, 0.0f);
    const f32 iyy = Max(rb.customInertiaDiag.y, 0.0f);
    const f32 izz = Max(rb.customInertiaDiag.z, 0.0f);
    const f32 ixy = rb.customInertiaOffDiag.x;
    const f32 ixz = rb.customInertiaOffDiag.y;
    const f32 iyz = rb.customInertiaOffDiag.z;
    md.inertia = Mat3(
        VectorSingle(ixx, ixy, ixz, 0.0f),
        VectorSingle(ixy, iyy, iyz, 0.0f),
        VectorSingle(ixz, iyz, izz, 0.0f)
    );
    return md;
}

void SnapshotEcsBodyTransforms(
    in PhysicsWorld physicsWorld,
    in HashMap<EntityID, BodyId> entityBodies,
    mut HashMap<EntityID, Transform3D> outTransforms
){
    outTransforms.clear();
    for(in auto kv : entityBodies){
        const EntityID entity = kv.first;
        const BodyId bodyId = kv.second;
        const Expected<BodyType> bt = physicsWorld.tryGetBodyType(bodyId);
        if(!bt.has_value() || bt.value() == BodyType::Static)
            continue;
        const Expected<Transform3D> xfRes = physicsWorld.tryGetBodyTransform(bodyId);
        if(xfRes.has_value())
            outTransforms.insert_or_assign(entity, xfRes.value());
    }
}

void ResolvePhysicsConfigSettings(
    mut World world,
    mut PhysicsWorld physicsWorld,
    mut f32 outFixedDt,
    mut u32 outSubSteps,
    mut u32 outMaxSubSteps,
    mut b8 outPaused
){
    outFixedDt = 1.0f / 60.0f;
    outSubSteps = 4u;
    outMaxSubSteps = 4u;
    outPaused = false;

    b8 found = false;
    world.view<PhysicsWorldConfigComponent>().each(
        lambda[mut physicsWorld, mut outFixedDt, mut outSubSteps, mut outMaxSubSteps, mut outPaused, mut found](
            in EntityID entity,
            mut PhysicsWorldConfigComponent cfg
        ) -> void{
            if(found)
                return;
            found = true;

            if(IsFinite(cfg.fixedDeltaTime) && cfg.fixedDeltaTime > 0.0f)
                outFixedDt = Max(cfg.fixedDeltaTime, 1.0f / 240.0f);
            outSubSteps = Max(cfg.subStepCount, 1u);
            outMaxSubSteps = Max(cfg.maxSubStepsPerFrame, 1u);
            outPaused = cfg.paused;

            if(cfg.dirty){
                WorldDef wd = physicsWorld.worldDef();
                wd.gravity = cfg.gravity;
                wd.restitutionThreshold = cfg.restitutionThreshold;
                wd.hitEventThreshold = cfg.hitEventThreshold;
                wd.contactHertz = cfg.contactHertz;
                wd.contactDampingRatio = cfg.contactDampingRatio;
                wd.maxLinearVelocity = cfg.maxLinearVelocity;
                wd.enableSleep = cfg.enableSleep;
                wd.enableContinuous = cfg.enableContinuous;
                wd.enableContactSoftening = cfg.enableContactSoftening;
                physicsWorld.setWorldDef(wd);
                physicsWorld.setBackendMode(cfg.backendMode);
                physicsWorld.setGpuDispatchThreshold(cfg.gpuDispatchThreshold);
                physicsWorld.setGpuWorkloadFraction(cfg.gpuWorkloadFraction);
                physicsWorld.setWarmStarting(cfg.enableWarmStarting);
                cfg.dirty = false;
            }
        }
    );
}

ColliderShapeEntry BuildPrimaryColliderEntry(in ColliderComponent col){
    ColliderShapeEntry entry;
    entry.shapeType = col.shapeType;
    entry.center = col.center;
    entry.center2 = col.center2;
    entry.halfExtents = col.halfExtents;
    entry.localRotation = col.localRotation;
    entry.radius = col.radius;
    entry.skinRadius = col.skinRadius;
    entry.density = col.density;
    entry.friction = col.friction;
    entry.restitution = col.restitution;
    entry.rollingResistance = col.rollingResistance;
    entry.tangentSpeed = col.tangentSpeed;
    entry.categoryBits = col.categoryBits;
    entry.maskBits = col.maskBits;
    entry.groupIndex = col.groupIndex;
    entry.userData = col.userData;
    entry.isBox = col.isBox;
    entry.isSensor = col.isSensor;
    entry.enableContactEvents = col.enableContactEvents;
    entry.enableHitEvents = col.enableHitEvents;
    entry.enableSensorEvents = col.enableSensorEvents;
    entry.enablePreSolveEvents = col.enablePreSolveEvents;
    entry.invokeContactCreation = col.invokeContactCreation;
    entry.hullPoints = col.hullPoints;
    entry.meshVertices = col.meshVertices;
    entry.meshIndices = col.meshIndices;
    entry.meshAsset = col.meshAsset;
    return entry;
}

Expected<ShapeId> AttachEcsColliderEntry(
    in ColliderShapeEntry entry,
    in BodyId bodyId,
    in VectorSingle scale,
    in b8 updateBodyMass,
    in Optional<mut AssetManager> assetManager,
    mut PhysicsWorld physicsWorld
){
    ShapeDef sd;
    sd.density = Max(entry.density, 0.0f);
    sd.material.friction = Max(entry.friction, 0.0f);
    sd.material.restitution = Max(entry.restitution, 0.0f);
    sd.material.rollingResistance = Max(entry.rollingResistance, 0.0f);
    sd.material.tangentSpeed = entry.tangentSpeed;
    sd.filter.categoryBits = entry.categoryBits;
    sd.filter.maskBits = entry.maskBits;
    sd.filter.groupIndex = entry.groupIndex;
    sd.userData = entry.userData;
    sd.isSensor = entry.isSensor;
    sd.enableContactEvents = entry.enableContactEvents;
    sd.enableHitEvents = entry.enableHitEvents;
    sd.enableSensorEvents = entry.enableSensorEvents;
    sd.enablePreSolveEvents = entry.enablePreSolveEvents;
    sd.invokeContactCreation = entry.invokeContactCreation;
    sd.updateBodyMass = updateBodyMass;

    const f32 sx = Max(Abs(scale.x), 1.0e-4f);
    const f32 sy = Max(Abs(scale.y), 1.0e-4f);
    const f32 sz = Max(Abs(scale.z), 1.0e-4f);
    const f32 maxS = Max(sx, Max(sy, sz));
    const VectorSingle localRot = SafeNormalizeQuat(VectorSingle(entry.localRotation));
    const VectorSingle scaledOffset(entry.center.x * sx, entry.center.y * sy, entry.center.z * sz, 0.0f);
    const b8 hasRot = (Abs(localRot.x) > 1.0e-5f || Abs(localRot.y) > 1.0e-5f || Abs(localRot.z) > 1.0e-5f);

    if(entry.shapeType == ShapeType::Sphere){
        SphereShape sp;
        sp.centerRadius = f32x4(scaledOffset, Max(entry.radius * maxS, 1.0e-3f));
        return physicsWorld.createSphereShape(bodyId, sd, sp);
    }

    if(entry.shapeType == ShapeType::Capsule){
        CapsuleShape cap;
        VectorSingle p1(entry.center.x * sx, entry.center.y * sy, entry.center.z * sz, 0.0f);
        VectorSingle p2(entry.center2.x * sx, entry.center2.y * sy, entry.center2.z * sz, 0.0f);
        if(hasRot){
            const VectorSingle mid = (p1 + p2) * 0.5f;
            p1 = mid + Vector3Rotate(VectorSingle(p1 - mid, 0.0f), localRot);
            p2 = mid + Vector3Rotate(VectorSingle(p2 - mid, 0.0f), localRot);
        }
        cap.center1Radius = f32x4(p1, Max(entry.radius * maxS, 1.0e-3f));
        cap.center2 = f32x4(p2, 0.0f);
        return physicsWorld.createCapsuleShape(bodyId, sd, cap);
    }

    if(entry.shapeType == ShapeType::Mesh){
        Vector<f32x4> transformedVerts;
        Vector<u32> decodedIndices;
        Span<u32> indexSpan;

        if(entry.meshAsset.valid() && assetManager.has_value()){
            const auto meshRes = LoadTypedAssetSync<Mesh>(assetManager.value(), entry.meshAsset.name(), "PhysicsCollider");
            if(!meshRes.has_value())
                return MakeUnexpected(Failure());
            in Mesh loadedMesh = meshRes.value().deref();
            const Expected<Vector<u32>> indicesRes = BuildMeshletTriangleIndices(loadedMesh);
            if(!indicesRes.has_value())
                return MakeUnexpected(Failure());
            decodedIndices = indicesRes.value();
            in Vector<f32x3u> posStream = loadedMesh.positionStream();
            transformedVerts.resize(posStream.size());
            for(usize vi = 0u; vi < posStream.size(); ++vi){
                in f32x3u p = posStream[vi];
                VectorSingle rPt(p.x * sx, p.y * sy, p.z * sz, 0.0f);
                if(hasRot)
                    rPt = Vector3Rotate(rPt, localRot);
                transformedVerts[vi] = f32x4(rPt + scaledOffset, 0.0f);
            }
            indexSpan = Span<u32>(decodedIndices.data(), decodedIndices.size());
        }
        else{
            transformedVerts.resize(entry.meshVertices.size());
            for(usize vi = 0u; vi < entry.meshVertices.size(); ++vi){
                const f32x4 v = entry.meshVertices[vi];
                VectorSingle rPt(v.x * sx, v.y * sy, v.z * sz, 0.0f);
                if(hasRot)
                    rPt = Vector3Rotate(rPt, localRot);
                transformedVerts[vi] = f32x4(rPt + scaledOffset, 0.0f);
            }
            indexSpan = Span<u32>(entry.meshIndices.data(), entry.meshIndices.size());
        }

        const Expected<MeshShape> meshRes = MakeMeshShape(
            Span<f32x4>(transformedVerts.data(), transformedVerts.size()),
            indexSpan,
            Max(entry.skinRadius * maxS, 0.0f)
        );
        if(!meshRes.has_value())
            return MakeUnexpected(Failure());
        return physicsWorld.createMeshShape(bodyId, sd, meshRes.value());
    }

    if(!entry.isBox){
        Vector<f32x4> scaledPts;
        scaledPts.resize(entry.hullPoints.size());
        for(usize vi = 0u; vi < entry.hullPoints.size(); ++vi){
            const f32x4 p = entry.hullPoints[vi];
            VectorSingle rPt = VectorSingle(p);
            if(hasRot)
                rPt = Vector3Rotate(rPt, localRot);
            scaledPts[vi] = f32x4((rPt.x + entry.center.x) * sx, (rPt.y + entry.center.y) * sy, (rPt.z + entry.center.z) * sz, 0.0f);
        }
        const Expected<HullShape> hullRes = BuildConvexHull(
            Span<f32x4>(scaledPts.data(), scaledPts.size()),
            Max(entry.skinRadius * maxS, 0.0f)
        );
        if(!hullRes.has_value())
            return MakeUnexpected(Failure());
        return physicsWorld.createHullShape(bodyId, sd, hullRes.value());
    }

    const f32 hx = Max(entry.halfExtents.x * sx, 1.0e-3f);
    const f32 hy = Max(entry.halfExtents.y * sy, 1.0e-3f);
    const f32 hz = Max(entry.halfExtents.z * sz, 1.0e-3f);
    Expected<HullShape> boxHull = MakeBoxHull(hx, hy, hz, Max(entry.skinRadius * maxS, 0.0f));
    if(!boxHull.has_value())
        return MakeUnexpected(Failure());

    const b8 hasOffset = (Vector3LengthSq(scaledOffset).x > 1.0e-10f);
    if(hasRot || hasOffset){
        mut HullShape h = boxHull.value();
        if(hasRot){
            h.boxRotation = f32x4(localRot);
            for(usize vi = 0u; vi < h.vertices.size(); ++vi)
                h.vertices[vi] = PackVec3U(Vector3Rotate(Vec3FromU(h.vertices[vi]), localRot) + scaledOffset);
            for(usize fi = 0u; fi < h.facePlanes.size(); ++fi){
                const VectorSingle rotN = SafeNormalizeVec3(Vector3Rotate(VectorSingle(h.facePlanes[fi].normalOffset), localRot), VectorSingle(0.0f, 1.0f, 0.0f, 0.0f));
                const f32 d = h.facePlanes[fi].normalOffset.w + Vector3Dot(rotN, scaledOffset).x;
                h.facePlanes[fi] = Plane3D(rotN, d);
            }
        }
        else{
            for(usize vi = 0u; vi < h.vertices.size(); ++vi)
                h.vertices[vi] = PackVec3U(Vec3FromU(h.vertices[vi]) + scaledOffset);
            for(usize fi = 0u; fi < h.facePlanes.size(); ++fi){
                const VectorSingle n = VectorSingle(h.facePlanes[fi].normalOffset);
                const f32 d = h.facePlanes[fi].normalOffset.w + Vector3Dot(n, scaledOffset).x;
                h.facePlanes[fi] = Plane3D(n, d);
            }
        }
        h.centroidRadius = f32x4(scaledOffset, h.radius());
        return physicsWorld.createHullShape(bodyId, sd, h);
    }

    return physicsWorld.createHullShape(bodyId, sd, boxHull.value());
}

void PruneRemovedPhysicsEntities(
    in World world,
    mut PhysicsWorld physicsWorld,
    mut HashMap<EntityID, BodyId> entityBodies,
    mut HashMap<EntityID, Vector<ShapeId>> entityShapes,
    mut HashMap<EntityID, JointId> entityJoints,
    mut HashMap<u32, EntityID> bodyIndexToEntity,
    mut HashMap<u32, EntityID> shapeIndexToEntity,
    mut HashMap<u32, EntityID> jointIndexToEntity,
    mut HashMap<Name, EntityID> namedEntities,
    mut HashMap<EntityID, EcsWorldPose> syncedBodyPoses,
    mut HashMap<EntityID, f32x4> syncedColliderScales,
    mut HashMap<EntityID, Transform3D> prevBodyTransforms,
    mut HashMap<EntityID, Transform3D> currBodyTransforms
){
    Vector<EntityID> deadJoints;
    for(in auto kv : entityJoints){
        const EntityID e = kv.first;
        const b8 keepJoint = world.alive(e) && world.hasComponent<JointComponent>(e);
        if(!keepJoint)
            deadJoints.push_back(e);
    }
    for(usize i = 0u; i < deadJoints.size(); ++i){
        const EntityID e = deadJoints[i];
        const JointId jId = entityJoints.at(e);
        jointIndexToEntity.erase(jId.index);
        if(physicsWorld.isValidJoint(jId))
            physicsWorld.destroyJoint(jId);
        entityJoints.erase(e);
    }

    Vector<EntityID> deadShapes;
    for(in auto kv : entityShapes){
        const EntityID e = kv.first;
        const b8 keepShape = world.alive(e) && world.hasComponent<ColliderComponent>(e);
        if(!keepShape)
            deadShapes.push_back(e);
    }
    for(usize i = 0u; i < deadShapes.size(); ++i){
        const EntityID e = deadShapes[i];
        in Vector<ShapeId> shapeList = entityShapes.at(e);
        for(usize si = 0u; si < shapeList.size(); ++si){
            shapeIndexToEntity.erase(shapeList[si].index);
            if(physicsWorld.isValidShape(shapeList[si]))
                physicsWorld.destroyShape(shapeList[si], true);
        }
        entityShapes.erase(e);
        syncedColliderScales.erase(e);
    }

    Vector<EntityID> deadBodies;
    for(in auto kv : entityBodies){
        const EntityID e = kv.first;
        const b8 hasBody = world.alive(e) && (world.hasComponent<RigidBodyComponent>(e) || world.hasComponent<ColliderComponent>(e));
        if(!hasBody)
            deadBodies.push_back(e);
    }
    for(usize i = 0u; i < deadBodies.size(); ++i){
        const EntityID e = deadBodies[i];
        const BodyId bId = entityBodies.at(e);
        bodyIndexToEntity.erase(bId.index);
        if(physicsWorld.isValidBody(bId))
            physicsWorld.destroyBody(bId);
        entityBodies.erase(e);
        syncedBodyPoses.erase(e);
        prevBodyTransforms.erase(e);
        currBodyTransforms.erase(e);
    }

    if(!deadBodies.empty()){
        Vector<Name> deadTags;
        for(in auto kv : namedEntities){
            for(usize i = 0u; i < deadBodies.size(); ++i){
                if(kv.second == deadBodies[i]){
                    deadTags.push_back(kv.first);
                    break;
                }
            }
        }
        for(usize i = 0u; i < deadTags.size(); ++i)
            namedEntities.erase(deadTags[i]);
    }
}

void SyncEcsEntitiesToPhysicsWorld(
    in Optional<mut AssetManager> assetManager,
    mut World world,
    mut PhysicsWorld physicsWorld,
    mut HashMap<EntityID, BodyId> entityBodies,
    mut HashMap<EntityID, Vector<ShapeId>> entityShapes,
    mut HashMap<EntityID, JointId> entityJoints,
    mut HashMap<u32, EntityID> bodyIndexToEntity,
    mut HashMap<u32, EntityID> shapeIndexToEntity,
    mut HashMap<u32, EntityID> jointIndexToEntity,
    mut HashMap<Name, EntityID> namedEntities,
    mut HashMap<EntityID, EcsWorldPose> syncedBodyPoses,
    mut HashMap<EntityID, f32x4> syncedColliderScales,
    mut HashMap<EntityID, Transform3D> prevBodyTransforms,
    mut HashMap<EntityID, Transform3D> currBodyTransforms
){
    PruneRemovedPhysicsEntities(
        world,
        physicsWorld,
        entityBodies,
        entityShapes,
        entityJoints,
        bodyIndexToEntity,
        shapeIndexToEntity,
        jointIndexToEntity,
        namedEntities,
        syncedBodyPoses,
        syncedColliderScales,
        prevBodyTransforms,
        currBodyTransforms
    );

    in World worldForBodyView = world;
    world.view<RigidBodyComponent, TransformComponent>().each(
        lambda[in worldForBodyView, mut physicsWorld, mut entityBodies, mut bodyIndexToEntity, mut namedEntities, mut syncedBodyPoses, mut prevBodyTransforms, mut currBodyTransforms](
            in EntityID entity,
            mut RigidBodyComponent rb,
            in TransformComponent xf
        ) -> void{
            if(rb.entityTag != s_NameNone)
                namedEntities.insert_or_assign(rb.entityTag, entity);

            const EcsWorldPose worldPose = ResolveEntityWorldPose(worldForBodyView, entity);
            const auto found = entityBodies.find(entity);
            const b8 hasValidBody = found != entityBodies.end() && physicsWorld.isValidBody(found.value());
            if(!hasValidBody || !rb.runtimeBodyId.valid()){
                if(found != entityBodies.end()){
                    bodyIndexToEntity.erase(found.value().index);
                    if(physicsWorld.isValidBody(found.value()))
                        physicsWorld.destroyBody(found.value());
                }

                BodyDef bd;
                bd.type = rb.type;
                bd.position = worldPose.transform.position;
                bd.rotation = worldPose.transform.rotation;
                bd.linearVelocity = rb.linearVelocity;
                bd.angularVelocity = rb.angularVelocity;
                bd.linearDamping = rb.linearDamping;
                bd.angularDamping = rb.angularDamping;
                bd.gravityScale = rb.gravityScale;
                bd.sleepThreshold = rb.sleepThreshold;
                bd.motionLocks = rb.motionLocks;
                bd.userData = rb.userData;
                bd.enableSleep = rb.enableSleep;
                bd.isAwake = rb.isAwake;
                bd.isBullet = rb.isBullet;
                bd.isEnabled = rb.isEnabled;
                bd.allowFastRotation = rb.allowFastRotation;
                bd.enableGyroscopicTorque = rb.enableGyroscopicTorque;
                const Expected<BodyId> created = physicsWorld.createBody(bd);
                if(created.has_value()){
                    if(rb.useCustomMass && rb.type == BodyType::Dynamic)
                        physicsWorld.setBodyMassData(created.value(), BuildCustomMassData(rb));
                    rb.runtimeBodyId = created.value();
                    rb.dirty = false;
                    entityBodies.insert_or_assign(entity, created.value());
                    bodyIndexToEntity.insert_or_assign(created.value().index, entity);
                    syncedBodyPoses.insert_or_assign(entity, worldPose);
                    prevBodyTransforms.insert_or_assign(entity, worldPose.transform);
                    currBodyTransforms.insert_or_assign(entity, worldPose.transform);
                }
                return;
            }

            const BodyId bodyId = found.value();
            if(rb.dirty){
                physicsWorld.setBodyType(bodyId, rb.type);
                physicsWorld.setBodyEnabled(bodyId, rb.isEnabled);
                physicsWorld.setLinearDamping(bodyId, rb.linearDamping);
                physicsWorld.setAngularDamping(bodyId, rb.angularDamping);
                physicsWorld.setGravityScale(bodyId, rb.gravityScale);
                physicsWorld.setSleepThreshold(bodyId, rb.sleepThreshold);
                physicsWorld.setMotionLocks(bodyId, rb.motionLocks);
                physicsWorld.setBodyUserData(bodyId, rb.userData);
                physicsWorld.setBodyEnableSleep(bodyId, rb.enableSleep);
                physicsWorld.setBodyBullet(bodyId, rb.isBullet);
                physicsWorld.setBodyAllowFastRotation(bodyId, rb.allowFastRotation);
                physicsWorld.setBodyGyroscopicTorque(bodyId, rb.enableGyroscopicTorque);
                physicsWorld.setBodyTransform(bodyId, VectorSingle(worldPose.transform.position), VectorSingle(worldPose.transform.rotation));
                if(rb.useCustomMass && rb.type == BodyType::Dynamic)
                    physicsWorld.setBodyMassData(bodyId, BuildCustomMassData(rb));
                if(rb.type != BodyType::Static){
                    physicsWorld.setLinearVelocity(bodyId, VectorSingle(rb.linearVelocity));
                    physicsWorld.setAngularVelocity(bodyId, VectorSingle(rb.angularVelocity));
                    if(rb.type == BodyType::Dynamic && rb.isEnabled)
                        physicsWorld.setBodyAwake(bodyId, rb.isAwake);
                }
                rb.runtimeBodyId = bodyId;
                rb.dirty = false;
                syncedBodyPoses.insert_or_assign(entity, worldPose);
                prevBodyTransforms.insert_or_assign(entity, worldPose.transform);
                currBodyTransforms.insert_or_assign(entity, worldPose.transform);
            }
            else if(rb.type == BodyType::Static){
                const auto syncedPose = syncedBodyPoses.find(entity);
                if(syncedPose == syncedBodyPoses.end() || !EcsTransformsNearlyEqual(syncedPose.value().transform, worldPose.transform)){
                    physicsWorld.setBodyTransform(bodyId, VectorSingle(worldPose.transform.position), VectorSingle(worldPose.transform.rotation));
                    syncedBodyPoses.insert_or_assign(entity, worldPose);
                    prevBodyTransforms.insert_or_assign(entity, worldPose.transform);
                    currBodyTransforms.insert_or_assign(entity, worldPose.transform);
                }
            }
        }
    );

    in Optional<mut AssetManager> assetsRef = assetManager;
    world.view<ColliderComponent, TransformComponent>().each(
        lambda[mut world, mut physicsWorld, in assetsRef, mut entityBodies, mut entityShapes, mut bodyIndexToEntity, mut shapeIndexToEntity, mut namedEntities, mut syncedBodyPoses, mut syncedColliderScales, mut prevBodyTransforms, mut currBodyTransforms](
            in EntityID entity,
            mut ColliderComponent col,
            in TransformComponent xf
        ) -> void{
            if(col.entityTag != s_NameNone)
                namedEntities.insert_or_assign(col.entityTag, entity);

            const EcsWorldPose worldPose = ResolveEntityWorldPose(world, entity);
            BodyId targetBodyId;
            b8 useCustomMass = false;
            BodyType targetBodyType = BodyType::Static;
            if(world.hasComponent<RigidBodyComponent>(entity)){
                in RigidBodyComponent rb = world.getComponent<RigidBodyComponent>(entity);
                targetBodyId = rb.runtimeBodyId;
                useCustomMass = rb.useCustomMass;
                targetBodyType = rb.type;
            }
            else{
                const auto foundBody = entityBodies.find(entity);
                if(foundBody != entityBodies.end() && physicsWorld.isValidBody(foundBody.value())){
                    targetBodyId = foundBody.value();
                    const auto syncedPose = syncedBodyPoses.find(entity);
                    const b8 poseMoved = syncedPose == syncedBodyPoses.end() || !EcsTransformsNearlyEqual(syncedPose.value().transform, worldPose.transform);
                    if(col.dirty || poseMoved){
                        physicsWorld.setBodyTransform(targetBodyId, VectorSingle(worldPose.transform.position), VectorSingle(worldPose.transform.rotation));
                        syncedBodyPoses.insert_or_assign(entity, worldPose);
                        prevBodyTransforms.insert_or_assign(entity, worldPose.transform);
                        currBodyTransforms.insert_or_assign(entity, worldPose.transform);
                    }
                }
                else{
                    if(foundBody != entityBodies.end())
                        bodyIndexToEntity.erase(foundBody.value().index);
                    BodyDef bd;
                    bd.type = BodyType::Static;
                    bd.position = worldPose.transform.position;
                    bd.rotation = worldPose.transform.rotation;
                    const Expected<BodyId> created = physicsWorld.createBody(bd);
                    if(!created.has_value())
                        return;
                    targetBodyId = created.value();
                    entityBodies.insert_or_assign(entity, targetBodyId);
                    bodyIndexToEntity.insert_or_assign(targetBodyId.index, entity);
                    syncedBodyPoses.insert_or_assign(entity, worldPose);
                    prevBodyTransforms.insert_or_assign(entity, worldPose.transform);
                    currBodyTransforms.insert_or_assign(entity, worldPose.transform);
                }
            }

            if(!physicsWorld.isValidBody(targetBodyId))
                return;

            const b8 bodyChanged = !(col.boundBodyId == targetBodyId);
            const auto foundScale = syncedColliderScales.find(entity);
            b8 scaleChanged = foundScale == syncedColliderScales.end();
            if(!scaleChanged){
                const f32x4 prevScale = foundScale.value();
                scaleChanged = !EcsVec4NearlyEqual(VectorSingle(prevScale), VectorSingle(worldPose.scale), 1.0e-5f);
            }
            const auto foundShapes = entityShapes.find(entity);
            b8 hasAllValidShapes = foundShapes != entityShapes.end() && !foundShapes.value().empty();
            if(hasAllValidShapes){
                const Vector<ShapeId> curShapes = foundShapes.value();
                if(curShapes.size() != 1u + col.extraShapes.size()){
                    hasAllValidShapes = false;
                }
                else{
                    for(usize si = 0u; si < curShapes.size(); ++si){
                        if(!physicsWorld.isValidShape(curShapes[si])){
                            hasAllValidShapes = false;
                            break;
                        }
                    }
                }
            }

            if(!hasAllValidShapes || col.dirty || bodyChanged || scaleChanged){
                if(foundShapes != entityShapes.end()){
                    const Vector<ShapeId> oldShapes = foundShapes.value();
                    for(usize si = 0u; si < oldShapes.size(); ++si){
                        shapeIndexToEntity.erase(oldShapes[si].index);
                        if(physicsWorld.isValidShape(oldShapes[si]))
                            physicsWorld.destroyShape(oldShapes[si], true);
                    }
                }
                col.runtimeExtraShapeIds.clear();

                const b8 updateBodyMass = !useCustomMass;
                Vector<ShapeId> createdList;
                const ColliderShapeEntry primaryEntry = BuildPrimaryColliderEntry(col);
                const Expected<ShapeId> primaryShape = AttachEcsColliderEntry(primaryEntry, targetBodyId, VectorSingle(worldPose.scale), updateBodyMass, assetsRef, physicsWorld);
                if(primaryShape.has_value()){
                    createdList.push_back(primaryShape.value());
                    shapeIndexToEntity.insert_or_assign(primaryShape.value().index, entity);
                }

                for(usize ei = 0u; ei < col.extraShapes.size(); ++ei){
                    const Expected<ShapeId> extraShape = AttachEcsColliderEntry(col.extraShapes[ei], targetBodyId, VectorSingle(worldPose.scale), updateBodyMass, assetsRef, physicsWorld);
                    if(extraShape.has_value()){
                        createdList.push_back(extraShape.value());
                        shapeIndexToEntity.insert_or_assign(extraShape.value().index, entity);
                        col.runtimeExtraShapeIds.push_back(extraShape.value());
                    }
                }

                if(useCustomMass && targetBodyType == BodyType::Dynamic && world.hasComponent<RigidBodyComponent>(entity)){
                    in RigidBodyComponent rbRef = world.getComponent<RigidBodyComponent>(entity);
                    physicsWorld.setBodyMassData(targetBodyId, BuildCustomMassData(rbRef));
                }

                syncedColliderScales.insert_or_assign(entity, worldPose.scale);
                if(!createdList.empty()){
                    col.runtimeShapeId = createdList[0u];
                    col.boundBodyId = targetBodyId;
                    col.dirty = false;
                    entityShapes.insert_or_assign(entity, createdList);
                }
                else{
                    col.runtimeShapeId = ShapeId();
                }
            }
        }
    );

    in HashMap<EntityID, BodyId> bodiesRef = entityBodies;
    in HashMap<Name, EntityID> namedEntitiesRef = namedEntities;
    world.view<JointComponent>().each(
        lambda[in bodiesRef, in namedEntitiesRef, mut physicsWorld, mut entityJoints, mut jointIndexToEntity](
            in EntityID entity,
            mut JointComponent jc
        ) -> void{
            EntityID entA = jc.bodyEntityA;
            if(!entA.valid() && jc.bodyEntityNameA != s_NameNone){
                const auto foundNameA = namedEntitiesRef.find(jc.bodyEntityNameA);
                if(foundNameA != namedEntitiesRef.end()){
                    entA = foundNameA.value();
                    jc.bodyEntityA = entA;
                }
            }
            EntityID entB = jc.bodyEntityB;
            if(!entB.valid() && jc.bodyEntityNameB != s_NameNone){
                const auto foundNameB = namedEntitiesRef.find(jc.bodyEntityNameB);
                if(foundNameB != namedEntitiesRef.end()){
                    entB = foundNameB.value();
                    jc.bodyEntityB = entB;
                }
            }

            const auto foundA = bodiesRef.find(entA);
            const auto foundB = bodiesRef.find(entB);
            if(foundA == bodiesRef.end() || foundB == bodiesRef.end())
                return;

            const BodyId bodyIdA = foundA.value();
            const BodyId bodyIdB = foundB.value();
            if(!physicsWorld.isValidBody(bodyIdA) || !physicsWorld.isValidBody(bodyIdB))
                return;

            const auto foundJoint = entityJoints.find(entity);
            const b8 hasRecord = foundJoint != entityJoints.end();
            const b8 isAliveInWorld = hasRecord && physicsWorld.isValidJoint(foundJoint.value());
            const b8 bodiesChanged = !(jc.boundBodyIdA == bodyIdA) || !(jc.boundBodyIdB == bodyIdB);

            if(hasRecord && !isAliveInWorld && !jc.dirty && !bodiesChanged){
                jc.runtimeJointId = JointId();
                return;
            }

            if(!hasRecord || jc.dirty || bodiesChanged){
                if(hasRecord){
                    jointIndexToEntity.erase(foundJoint.value().index);
                    if(isAliveInWorld)
                        physicsWorld.destroyJoint(foundJoint.value());
                }

                JointDef jd;
                jd.bodyIdA = bodyIdA;
                jd.bodyIdB = bodyIdB;
                jd.userData = jc.userData;
                jd.type = jc.type;
                jd.localAnchorA = jc.localAnchorA;
                jd.localAnchorB = jc.localAnchorB;
                jd.localAxisA = jc.localAxisA;
                jd.localAxisB = jc.localAxisB;
                jd.referenceRotation = jc.referenceRotation;
                jd.useReferenceRotation = jc.useReferenceRotation;
                jd.length = jc.length;
                jd.minLength = jc.minLength;
                jd.maxLength = jc.maxLength;
                jd.enableLimit = jc.enableLimit;
                jd.lowerLimit = jc.lowerLimit;
                jd.upperLimit = jc.upperLimit;
                jd.enableMotor = jc.enableMotor;
                jd.motorSpeed = jc.motorSpeed;
                jd.maxMotorForce = jc.maxMotorForce;
                jd.enableSpring = jc.enableSpring;
                jd.hertz = jc.hertz;
                jd.dampingRatio = jc.dampingRatio;
                jd.linearOffset = jc.linearOffset;
                jd.correctionFactor = jc.correctionFactor;
                jd.maxTorque = jc.maxTorque;
                jd.swingLimit = jc.swingLimit;
                jd.suspensionHertz = jc.suspensionHertz;
                jd.suspensionDampingRatio = jc.suspensionDampingRatio;
                jd.breakForce = jc.breakForce;
                jd.breakTorque = jc.breakTorque;
                jd.collideConnected = jc.collideConnected;

                const Expected<JointId> createdJoint = physicsWorld.createJoint(jd);
                if(createdJoint.has_value()){
                    jc.runtimeJointId = createdJoint.value();
                    jc.boundBodyIdA = bodyIdA;
                    jc.boundBodyIdB = bodyIdB;
                    jc.dirty = false;
                    entityJoints.insert_or_assign(entity, createdJoint.value());
                    jointIndexToEntity.insert_or_assign(createdJoint.value().index, entity);
                }
            }
        }
    );
}

void ApplyKinematicTargetsFromEcs(mut World world, mut PhysicsWorld physicsWorld, in f32 fixedDt){
    if(!IsFinite(fixedDt) || fixedDt <= 0.0f)
        return;

    in World worldRef = world;
    world.view<RigidBodyComponent, TransformComponent>().each(
        lambda[in worldRef, in fixedDt, mut physicsWorld](
            in EntityID entity,
            in RigidBodyComponent rb,
            in TransformComponent xf
        ) -> void{
            if(rb.type != BodyType::Kinematic || !rb.driveKinematicFromTransform || !rb.isEnabled)
                return;
            if(!physicsWorld.isValidBody(rb.runtimeBodyId))
                return;
            const EcsWorldPose pose = ResolveEntityWorldPose(worldRef, entity);
            physicsWorld.setKinematicTarget(rb.runtimeBodyId, pose.transform, fixedDt);
        }
    );
}

void WriteBackPhysicsTransformsToEcs(mut World world, in PhysicsWorld physicsWorld){
    in World worldForRead = world;
    in PhysicsWorld worldRef = physicsWorld;
    world.view<RigidBodyComponent, TransformComponent>().each(
        lambda[in worldForRead, in worldRef](
            in EntityID entity,
            mut RigidBodyComponent rb,
            mut TransformComponent xf
        ) -> void{
            if(rb.type == BodyType::Static || !rb.isEnabled || !worldRef.isValidBody(rb.runtimeBodyId))
                return;

            if(rb.type == BodyType::Kinematic && rb.driveKinematicFromTransform){
                const Expected<f32x4> kinLinVel = worldRef.tryGetLinearVelocity(rb.runtimeBodyId);
                if(kinLinVel.has_value())
                    rb.linearVelocity = kinLinVel.value();
                const Expected<f32x4> kinAngVel = worldRef.tryGetAngularVelocity(rb.runtimeBodyId);
                if(kinAngVel.has_value())
                    rb.angularVelocity = kinAngVel.value();
                rb.isAwake = worldRef.isBodyAwake(rb.runtimeBodyId);
                return;
            }

            const Expected<Transform3D> physXf = worldRef.tryGetBodyTransform(rb.runtimeBodyId);
            if(physXf.has_value()){
                if(worldForRead.hasComponent<PhysicsParentComponent>(entity)){
                    in PhysicsParentComponent pp = worldForRead.getComponent<PhysicsParentComponent>(entity);
                    if(pp.parent.valid() && worldForRead.alive(pp.parent) && worldForRead.hasComponent<TransformComponent>(pp.parent)){
                        const EcsWorldPose parentPose = ResolveEntityWorldPose(worldForRead, pp.parent);
                        const Transform3D localXf = RelativeTransform(parentPose.transform, physXf.value());
                        f32 lx = localXf.position.x;
                        f32 ly = localXf.position.y;
                        f32 lz = localXf.position.z;
                        if(pp.inheritScale){
                            if(Abs(parentPose.scale.x) > 1.0e-5f)
                                lx /= parentPose.scale.x;
                            if(Abs(parentPose.scale.y) > 1.0e-5f)
                                ly /= parentPose.scale.y;
                            if(Abs(parentPose.scale.z) > 1.0e-5f)
                                lz /= parentPose.scale.z;
                        }
                        xf.position = f32x4(lx, ly, lz, 0.0f);
                        xf.rotation = localXf.rotation;
                    }
                    else{
                        xf.position = physXf.value().position;
                        xf.rotation = physXf.value().rotation;
                    }
                }
                else{
                    xf.position = physXf.value().position;
                    xf.rotation = physXf.value().rotation;
                }
            }

            const Expected<f32x4> linVel = worldRef.tryGetLinearVelocity(rb.runtimeBodyId);
            if(linVel.has_value())
                rb.linearVelocity = linVel.value();

            const Expected<f32x4> angVel = worldRef.tryGetAngularVelocity(rb.runtimeBodyId);
            if(angVel.has_value())
                rb.angularVelocity = angVel.value();

            rb.isAwake = worldRef.isBodyAwake(rb.runtimeBodyId);
        }
    );
}


