#include <impl/ecs_render/avboit/avboit_system.adhd>
#include <impl/ecs_render/csg/task_graph_opaque_compute_emulation_plan.adhd>
#include <impl/ecs_render/kernel/task_graph_scheduling.adhd>
#include <impl/ecs_render/kernel/timing_names.adhd>
#include <impl/ecs_render/material/task_graph_compute_emulation_plan.adhd>
#include <impl/ecs_render/shared/task_graph_draw_snapshots.adhd>
#include <impl/ecs_render/material/pipeline_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> AvboitTargetFramebufferKind{
    Low = 0,
    Accumulation = 1
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class AvboitComputeEmulationRecordTrait{
    public GpuTimingScopeDefinition timingScope;
    public AvboitTargetFramebufferKind framebufferKind;

    public AvboitComputeEmulationRecordTrait(
        in GpuTimingScopeDefinition inTimingScope,
        in AvboitTargetFramebufferKind inFramebufferKind
    ){
        this.timingScope = inTimingScope;
        this.framebufferKind = inFramebufferKind;
    }
}

class AvboitComputeEmulationTaskPayload{
    public mut GraphicsRuntime graphics;
    public mut RendererMaterialSystem materialSystem;
    public mut DeferredFrameTargets targets;
    public mut GpuTimingSubmissionTicket timingTicket;
    public mut Optional<GpuTimingMeasure> timing;
    public MaterialPipelinePass pass;
    public MeshFrameBindingSnapshot frameBindings;
    public usize instanceCount = 0u;
    public usize materialTypedByteCount = 0u;
    public b8 materialDrawBuffersUploaded = false;
    public b8 materialFrameStatesGraphOwned = false;
    public b8 materialGeometryStatesGraphOwned = false;
    public CsgGraphResourceSnapshot csgResources;
    public AliasFreeComputeEmulationGraphPlan plan;
    public OpaqueCsgIntervalSampleComputeEmulationGraphPlan csgPlan;
    public b8 csgFrameBuffersUploaded = false;
    public b8 conservativeGeometryScissor = false;

    public AvboitComputeEmulationTaskPayload(
        mut GraphicsRuntime graphics,
        mut RendererMaterialSystem materialSystem,
        mut DeferredFrameTargets targets,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> timing,
        in MaterialPipelinePass pass
    ){
        this.graphics = graphics;
        this.materialSystem = materialSystem;
        this.targets = targets;
        this.timingTicket = timingTicket;
        this.timing = timing;
        this.pass = pass;
    }
    public GpuTaskCommandRequirements commandRequirements()const{
        return SharedComputeEmulationCommandRequirements(true);
    }
    public b8 record(mut CommandList commands, in GpuTaskRecordContext context)const;
    public void discarded(){
        DiscardGpuTimingMeasure(this.timing);
    }
}

class AvboitSharedComputeEmulationTaskPayload{
    public mut GraphicsRuntime graphics;
    public mut RendererMaterialSystem materialSystem;
    public mut DeferredFrameTargets targets;
    public mut GpuTimingSubmissionTicket timingTicket;
    public mut Optional<GpuTimingMeasure> timing;
    public MaterialPipelinePass pass;
    public MeshFrameBindingSnapshot frameBindings;
    public usize instanceCount = 0u;
    public usize materialTypedByteCount = 0u;
    public b8 materialDrawBuffersUploaded = false;
    public b8 materialFrameStatesGraphOwned = false;
    public b8 materialGeometryStatesGraphOwned = false;
    public RegularSharedComputeEmulationGraphPlan plan;
    public usize drawIndex = 0u;
    public b8 beginTiming = false;
    public b8 finishTiming = false;
    public SharedComputeEmulationPhase phase = SharedComputeEmulationPhase::Generate;

    public AvboitSharedComputeEmulationTaskPayload(
        mut GraphicsRuntime graphics,
        mut RendererMaterialSystem materialSystem,
        mut DeferredFrameTargets targets,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> timing,
        in MaterialPipelinePass pass
    ){
        this.graphics = graphics;
        this.materialSystem = materialSystem;
        this.targets = targets;
        this.timingTicket = timingTicket;
        this.timing = timing;
        this.pass = pass;
    }
    public GpuTaskCommandRequirements commandRequirements()const{
        return SharedComputeEmulationCommandRequirements(this.phase == SharedComputeEmulationPhase::Generate);
    }
    public b8 record(mut CommandList commands, in GpuTaskRecordContext context)const;
    public void discarded(){
        DiscardGpuTimingMeasure(this.timing);
    }
}

class AvboitRasterPassTaskPayload{
    public mut RendererAvboitSystem avboitSystem;
    public mut DeferredFrameTargets targets;
    public mut GpuTimingSubmissionTicket timingTicket;
    public MaterialPipelinePass pass;
    public MeshFrameBindingSnapshot frameBindings;
    public TransparentMaterialPassGraphSnapshot snapshot;
    public CsgGraphResourceSnapshot csgResources;
    public Optional<mut Optional<GpuTimingMeasure>> computeEmulationTiming;
    public b8 phasePrepared = false;
    public b8 streamsUploaded = false;
    public b8 materialFrameStatesGraphOwned = false;
    public b8 materialGeometryStatesGraphOwned = false;
    public b8 computeEmulationOutputStatesGraphOwned = false;
    public b8 csgComputeEmulationOutputStatesGraphOwned = false;
    public b8 generatedGeometryReused = false;
    public b8 hasTransparentRenderers = false;

    public AvboitRasterPassTaskPayload(
        mut RendererAvboitSystem avboitSystem,
        mut DeferredFrameTargets targets,
        mut GpuTimingSubmissionTicket timingTicket,
        in MaterialPipelinePass pass
    ){
        this.avboitSystem = avboitSystem;
        this.targets = targets;
        this.timingTicket = timingTicket;
        this.pass = pass;
    }
    public GpuTaskCommandRequirements commandRequirements()const{
        return GpuTaskCommandRequirements(GpuQueueCapability::Graphics | GpuQueueCapability::Compute);
    }
    public b8 record(mut CommandList commands, in GpuTaskRecordContext context)const;
    public void discarded(){
        if(this.computeEmulationTiming.has_value())
            DiscardGpuTimingMeasure(this.computeEmulationTiming.value());
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


FramebufferHandle SelectAvboitTargetFramebuffer(in AvboitFrameTargets targets, in AvboitTargetFramebufferKind kind){
    if(kind == AvboitTargetFramebufferKind::Accumulation)
        return targets.accumulationFramebuffer;
    return targets.lowFramebuffer;
}

AvboitComputeEmulationRecordTrait GetAvboitComputeEmulationRecordTrait(in MaterialPipelinePass pass){
    if(pass == MaterialPipelinePass::AvboitAccumulate)
        return AvboitComputeEmulationRecordTrait(s_TimingScopeAvboitAccumulate, AvboitTargetFramebufferKind::Accumulation);
    if(pass == MaterialPipelinePass::AvboitExtinction)
        return AvboitComputeEmulationRecordTrait(s_TimingScopeAvboitExtinction, AvboitTargetFramebufferKind::Low);
    assert(pass == MaterialPipelinePass::AvboitOccupancy);
    return AvboitComputeEmulationRecordTrait(s_TimingScopeAvboitOccupancy, AvboitTargetFramebufferKind::Low);
}

b8 HasValidAvboitComputeEmulationRecordInputs(in b8 hasFramebufferMember, in b8 regularCaptured, in b8 csgCaptured){
    return hasFramebufferMember && regularCaptured != csgCaptured;
}

b8 HasValidAvboitSharedComputeEmulationRecordInputs(in b8 hasFramebuffer, in b8 planCaptured, in usize drawIndex, in usize drawCount){
    return hasFramebuffer && planCaptured && drawIndex < drawCount;
}


