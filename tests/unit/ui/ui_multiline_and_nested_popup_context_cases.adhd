    }
}

void VerifyUiMultilineText_RejectedControlsAfterNormalizedPrefixesFailWithInvalidText(){
    Array<StringView, 7u> cases = Array<StringView, 7u>();
    cases[0u] = "prefix\r\n\t\x01";
    cases[1u] = "prefix\r\n\v";
