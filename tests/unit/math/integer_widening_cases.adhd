#include "case_types.adhd"

#include <tests/common/floating_point_environment_guard.adhd>
#include <tests/common/gtest_macros.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyWideningProducts(){
    const auto environment = HoldFloatingPointExceptions();
    ASSERT_TRUE(environment.has_value());
    FloatingPointEnvironmentGuard restore(environment.value());
    const Array<u32, 4u> first = Array<u32, 4u>(0xffffffffu, 0x7f800123u, 0x80000000u, 0x00010001u);
    const Array<u32, 4u> second = Array<u32, 4u>(0xffffffffu, 0xffffffffu, 0x80000000u, 0x00010001u);
    const VectorSingle a = MakeVolatileSingleBits(first[0u], first[1u], first[2u], first[3u]);
    const VectorSingle b = MakeVolatileSingleBits(second[0u], second[1u], second[2u], second[3u]);
    ASSERT_TRUE(ClearFloatingPointExceptions(FE_ALL_EXCEPT).has_value());
    ASSERT_TRUE(RaiseFloatingPointExceptions(FE_DIVBYZERO).has_value());
    const i32 before = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    const VectorDouble products = VectorMultiplyUInt32Wide(a, b);
    EXPECT_EQ(TestFloatingPointExceptions(FE_ALL_EXCEPT), before);
    for(usize lane = 0u; lane < 4u; ++lane)
        EXPECT_EQ(VectorDoubleGetIntByIndex(products, lane), cast<u64>(first[lane]) * cast<u64>(second[lane]));
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_ADHD_GTEST(MathInteger, WideningProductsRetainHighBitsWithoutEvaluatingNanEncodings, VerifyWideningProducts)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

