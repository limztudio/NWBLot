void VerifyUiListLoanTests_TextCallbackSelectionRejectsDeferredPaintWithoutReplacingAcceptedTargets(mut UiListLoanTests self){
    ASSERT_TRUE(self.acceptFirst());
    const UiListLoanAcceptedState displayed = self.accepted();
    ASSERT_TRUE(self.declareList(2u));
    const u64 inputGeneration = self.m_state.inputGeneration();
    self.m_source.arm(UiListLoanMutationKind::TextSelect, 8u);
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.ready());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_source.mutations(), 1u);
    EXPECT_NE(self.m_state.inputGeneration(), inputGeneration);
    EXPECT_EQ(self.m_state.selectedKey(), 8u);
    self.expectAccepted(displayed);
}

void VerifyUiListLoanTests_SameValueKeyCallbackRejectsTheLoanWhileDisplayedCaptureStaysUnchanged(mut UiListLoanTests self){
    ASSERT_TRUE(self.acceptFirst());
    const Optional<HitTarget> rowOpt = self.findTarget(self.firstRow());
    ASSERT_TRUE(rowOpt.has_value());
    const HitTarget row = rowOpt.value();
    const VectorSingle pointValue = VectorSingle(row.rectangle.x, row.rectangle.y, 0.0f, 0.0f) + VectorSingle(10.0f, 12.0f, 0.0f, 0.0f);
    const Point point = Point(pointValue.x, pointValue.y);
    EXPECT_TRUE(self.send(MakeUiListPointerAt(InputEventType::PrimaryDown, point)).pointerConsumed);
    ASSERT_EQ(self.m_context.input().capture(), self.firstRow());
    const UiListLoanAcceptedState displayed = self.accepted();
    ASSERT_TRUE(self.declareList(2u));
    const u64 inputGeneration = self.m_state.inputGeneration();
    self.m_source.arm(UiListLoanMutationKind::KeySelect, 0u);
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_state.selectedKey(), 0u);
    EXPECT_NE(self.m_state.inputGeneration(), inputGeneration);
    self.expectAccepted(displayed);
}

void VerifyUiListLoanTests_EnabledCallbackScrollIsPreservedWhenEnsureCursorRejectsTheChangedEpoch(mut UiListLoanTests self){
    self.m_state.select(5u);
    ASSERT_TRUE(self.acceptFirst());
    // Same-value application selection requests cursor visibility and fences the previous input token before painting.
    self.m_state.select(5u);
    ASSERT_TRUE(self.declareList(2u));
    const UiListLoanAcceptedState displayed = self.accepted();
    const u64 inputGeneration = self.m_state.inputGeneration();
    self.m_source.arm(UiListLoanMutationKind::EnabledScroll);
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    EXPECT_NE(self.m_state.inputGeneration(), inputGeneration);
    EXPECT_DOUBLE_EQ(self.m_state.scrollOffset(), 64.0);
    self.expectAccepted(displayed);
}

void VerifyUiListLoanBehaviorTests_ReconcileAndApplyPreserveExplicitChangesMadeBySourceCallbacks(){
    ListState state = ListState();
    UiListLoanCallbackSource source = UiListLoanCallbackSource(state);
    state.select(2u);
    source.arm(UiListLoanMutationKind::KeySelect, 8u);
    EXPECT_FALSE(UiListReconcile(state, source));
    EXPECT_EQ(state.selectedKey(), 8u);
    EXPECT_EQ(state.cursorKey(), 8u);
    ASSERT_TRUE(UiListReconcile(state, source));
    ControlAction action = ControlAction();
    action.control = ControlToken(state.inputGeneration(), source.instanceGeneration(), source.revision());
    action.kind = ControlActionKind::Down;
    source.arm(UiListLoanMutationKind::KeySelect, 3u);
    ListResult result = ListResult();
    EXPECT_FALSE(UiListReconcileApply(source, ListOptions(), action, state, result));
    EXPECT_EQ(state.selectedKey(), 3u);
    EXPECT_EQ(state.cursorKey(), 3u);
    EXPECT_FALSE(result.valid);
    EXPECT_FALSE(result.selectionChanged);
    action.control.instanceGeneration = state.inputGeneration();
    action.kind = ControlActionKind::Wheel;
    action.delta = -1.0;
    action.step = 24.0;
    action.maximum = 300.0;
    source.arm(UiListLoanMutationKind::RevisionScroll);
    EXPECT_FALSE(UiListReconcileApply(source, ListOptions(), action, state, result));
    EXPECT_DOUBLE_EQ(state.scrollOffset(), 64.0);
    EXPECT_FALSE(result.valid);
}


