#include "router_popup_dismiss.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void AppendRouterControlAction(
    in HitTarget host,
    in HitTarget source,
    in u64 layoutGeneration,
    in ControlActionKind kind,
    in f64 delta,
    in f64 deltaX,
    mut Vector<ControlAction> controlActions,
    mut u64 inOutNextActionSequence,
    mut InputRoutingResult inOutResult
){
    if(controlActions.size() == s_InputMaxControlActions || inOutNextActionSequence == 0u){
        inOutResult.activationOverflow = true;
        return;
    }
    ControlAction action;
    action.id.target = host.id;
    action.id.declarationGeneration = host.declarationGeneration;
    action.id.layoutGeneration = layoutGeneration;
    action.id.sequence = inOutNextActionSequence;
    action.source = source.id;
    action.popup = host.popup;
    action.control = host.control;
    action.kind = kind;
    action.delta = delta;
    action.value = source.value;
    action.step = host.scrollStep;
    action.pageRows = host.pageRows;
    action.maximum = host.gestureMaximum;
    action.sourceDeclarationGeneration = source.declarationGeneration;
    action.sourceControl = source.control;
    action.deltaX = deltaX;
    action.stepX = host.scrollStepX;
    action.maximumX = host.gestureMaximumX;
    controlActions.push_back(action);
    ++inOutNextActionSequence;
}

b8 IsValidRouterControlHostTarget(in Span<PopupRecord> popups, in HitTarget target, in HitTarget host){
    return
        host.enabled && host.focusable && !host.owner.valid()
        && host.control.valid() && host.control == target.control && host.popup == target.popup
        && IsTargetAllowedByRouterPopup(popups, host)
        && HasVisibleUiRectIntersection(host.rectangle, host.clip)
    ;
}

Expected<usize> TryResolveRouterControlHostIndex(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in HitTarget target
){
    if(target.owner.valid()){
        const Expected<usize> hostIndex = FindTargetIndexInTable(targets, lookup, target.owner, target.ownerDeclarationGeneration);
        if(!hostIndex.has_value())
            return MakeUnexpected(Failure());
        const HitTarget host = targets[hostIndex.value()];
        if(!IsValidRouterControlHostTarget(popups, target, host))
            return MakeUnexpected(Failure());
        return hostIndex.value();
    }
    if(!IsValidRouterControlHostTarget(popups, target, target))
        return MakeUnexpected(Failure());
    return FindTargetIndexInTable(targets, lookup, target.id, target.declarationGeneration);
}

Expected<HitTarget> TryResolveRouterControlHost(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in HitTarget target
){
    HitTarget host = target;
    if(target.owner.valid()){
        const Expected<usize> hostIndex = FindTargetIndexInTable(targets, lookup, target.owner, target.ownerDeclarationGeneration);
        if(!hostIndex.has_value())
            return MakeUnexpected(Failure());
        host = targets[hostIndex.value()];
    }
    if(!IsValidRouterControlHostTarget(popups, target, host))
        return MakeUnexpected(Failure());
    return host;
}

b8 IsRouterTargetInteractive(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in HitTarget target
){
    return
        target.enabled
        && HasVisibleUiRectIntersection(target.rectangle, target.clip)
        && IsTargetAllowedByRouterPopup(popups, target)
        && (!target.owner.valid() || TryResolveRouterControlHost(targets, lookup, popups, target).has_value())
    ;
}

Expected<usize> TryResolveRouterCommandHostIndex(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in HitTarget source
){
    if(!source.textEditable || !source.commandOwner.valid() || !source.commandControl.valid() || !IsRouterTargetInteractive(targets, lookup, popups, source))
        return MakeUnexpected(Failure());
    const Expected<usize> hostIndex = FindTargetIndexInTable(targets, lookup, source.commandOwner, source.commandOwnerDeclarationGeneration);
    if(!hostIndex.has_value())
        return MakeUnexpected(Failure());
    const HitTarget host = targets[hostIndex.value()];
    if(
        !IsRouterTargetInteractive(targets, lookup, popups, host)
        || !host.focusable || !host.navigable || host.owner.valid()
        || host.control != source.commandControl || host.popup != source.popup || host.layer != source.layer
    )
        return MakeUnexpected(Failure());
    return hostIndex.value();
}

b8 IsCurrentRouterControlCommandOwner(
    in Span<HitTarget> targets,
    in Span<TargetLookup> lookup,
    in Span<PopupRecord> popups,
    in CommandSource held
){
    const ControlCommandOwner owner = held.controlOwner;
    const TargetOwner sourceOwner = held.focusOwner;
    const Expected<usize> hostIndex = FindTargetIndexInTable(targets, lookup, owner.host, owner.declarationGeneration);
    const Expected<usize> sourceIndex = FindTargetIndexInTable(targets, lookup, sourceOwner.target, sourceOwner.declarationGeneration);
    if(!hostIndex.has_value() || !sourceIndex.has_value())
        return false;
    const HitTarget host = targets[hostIndex.value()];
    const HitTarget source = targets[sourceIndex.value()];
    if(
        !IsRouterTargetInteractive(targets, lookup, popups, host) || !host.navigable || host.owner.valid()
        || host.control != owner.control || host.popup != owner.popup
        || !IsRouterTargetInteractive(targets, lookup, popups, source)
        || source.control != sourceOwner.control || source.popup != sourceOwner.popup
        || (owner.horizontal && !host.horizontalNavigation)
    )
        return false;
    if(sourceIndex.value() == hostIndex.value())
        return true;
    const Expected<usize> commandHostIndex = TryResolveRouterCommandHostIndex(targets, lookup, popups, source);
    return commandHostIndex.has_value() && commandHostIndex.value() == hostIndex.value();
}


