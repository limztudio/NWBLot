native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/kernel/timing_names.adhd.h>

#include <core/common/log.h>
#include <core/graphics/runtime/render_pass.h>
#include <core/graphics/runtime/runtime.h>

namespace NWB::Tests::Smoke{
using Core::GraphicsRuntime;
using Core::IRenderPass;

class TimingProbeUnfocusedPass final : public Core::IRenderPass{
public:
    explicit TimingProbeUnfocusedPass(Core::GraphicsRuntime& graphics)noexcept : Core::IRenderPass(graphics){}
    virtual b8 shouldRenderUnfocused()noexcept override{ return true; }
};
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const u32 s_TimingProbeInFlightRanges = 32u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 PrepareTimingProbeScopes(mut GraphicsRuntime graphics, in Span<Name> scopes, in TStringView probeName){
    for(usize i = 0u; i < scopes.size(); ++i){
        const Name scope = scopes[i];
        b8 prepared = false;
        native(mut graphics, in scope, mut prepared){
            prepared = graphics.gpuTiming().prepareScopeQueries(scope, graphics.getDevice(), s_TimingProbeInFlightRanges);
        }
        if(!prepared){
            error("{}: failed to prepare scope '{}'", probeName, scope.resolvedText());
            return false;
        }
    }
    return true;
}

void RegisterTimingProbeRenderPass(mut GraphicsRuntime graphics, mut TimingProbeUnfocusedPass pass, in TStringView probeName){
    native(mut graphics, mut pass){
        graphics.addRenderPassToBack(pass);
    }
    [essential] info("{}: in-flight ranges {}", probeName, s_TimingProbeInFlightRanges);
    [essential] info("{}: render unfocused 1", probeName);
}

class AvboitTimingRenderPass{
    public AvboitTimingRenderPass(mut GraphicsRuntime graphics){
        this.m_graphics = graphics;
        this.m_pass = TimingProbeUnfocusedPass(graphics);
    }

    public ~AvboitTimingRenderPass(){
        this.stop();
    }

    public b8 start(){
        return this.start(false);
    }

    public b8 start(in b8 includeCaustics){
        if(this.m_registered)
            return this.m_includeCaustics == includeCaustics;

        TStringView probeName = TStringView();
        Array<Name, 24u> scopes;
        Array<Name, 2u> causticScopes;
        native(mut probeName, mut scopes, mut causticScopes){
            probeName = NWB_TEXT("AvboitTimingProbe");
            scopes = {
                Impl::RendererGpuTimingScope::s_Frame.identity,
                Impl::RendererGpuTimingScope::s_OpaqueRegular.identity,
                Impl::RendererGpuTimingScope::s_ShadowVisibility.identity,
                Impl::RendererGpuTimingScope::s_LightSpaceShadowViews.identity,
                Impl::RendererGpuTimingScope::s_LightSpaceShadowOpaqueCapture.identity,
                Impl::RendererGpuTimingScope::s_LightSpaceShadowTransparentCapture.identity,
                Impl::RendererGpuTimingScope::s_LightSpaceShadowShade.identity,
                Impl::RendererGpuTimingScope::s_LightSpaceShadowMapOpaque.identity,
                Impl::RendererGpuTimingScope::s_LightSpaceShadowMapTransparent.identity,
                Impl::RendererGpuTimingScope::s_LightSpaceShadowFallbackOpaque.identity,
                Impl::RendererGpuTimingScope::s_LightSpaceShadowFallbackTransparent.identity,
                Impl::RendererGpuTimingScope::s_DeferredLighting.identity,
                Impl::RendererGpuTimingScope::s_DeferredComposite.identity,
                Impl::RendererGpuTimingScope::s_DeferredPresent.identity,
                Impl::RendererGpuTimingScope::s_AvboitClear.identity,
                Impl::RendererGpuTimingScope::s_AvboitOccupancy.identity,
                Impl::RendererGpuTimingScope::s_AvboitDepthWarp.identity,
                Impl::RendererGpuTimingScope::s_AvboitExtinction.identity,
                Impl::RendererGpuTimingScope::s_AvboitIntegration.identity,
                Impl::RendererGpuTimingScope::s_AvboitAccumulate.identity,
                Impl::RendererGpuTimingScope::s_RefractionResolve.identity,
                Impl::RendererGpuTimingScope::s_RefractionClassifyTiles.identity,
                Impl::RendererGpuTimingScope::s_RefractionClearTileArguments.identity,
                Impl::RendererGpuTimingScope::s_OpticalBoundsFinalize.identity,
            };
            causticScopes = {
                Impl::RendererGpuTimingScope::s_CausticPhotons.identity,
                Impl::RendererGpuTimingScope::s_CausticResolve.identity,
            };
        }
        if(!PrepareTimingProbeScopes(this.m_graphics, scopes, probeName))
            return false;
        if(includeCaustics && !PrepareTimingProbeScopes(this.m_graphics, causticScopes, probeName))
            return false;
        RegisterTimingProbeRenderPass(this.m_graphics, this.m_pass, probeName);
        this.m_registered = true;
        this.m_includeCaustics = includeCaustics;
        if(includeCaustics)
            [essential] info("AvboitTimingProbe: caustic in-flight ranges {}", s_TimingProbeInFlightRanges);
        return true;
    }

    public void stop(){
        if(!this.m_registered)
            return;
        this.m_graphics.removeRenderPass(this.m_pass);
        this.m_registered = false;
        this.m_includeCaustics = false;
    }

    private mut GraphicsRuntime m_graphics;
    private TimingProbeUnfocusedPass m_pass;
    private b8 m_registered = false;
    private b8 m_includeCaustics = false;
}

class ShadowTimingRenderPass{
    public ShadowTimingRenderPass(mut GraphicsRuntime graphics){
        this.m_graphics = graphics;
        this.m_pass = TimingProbeUnfocusedPass(graphics);
    }

    public ~ShadowTimingRenderPass(){
        this.stop();
    }

    public b8 start(){
        if(this.m_registered)
            return true;

        TStringView probeName = TStringView();
        Array<Name, 13u> scopes;
        native(mut probeName, mut scopes){
            probeName = NWB_TEXT("ShadowTimingProbe");
            scopes = {
                Impl::RendererGpuTimingScope::s_Frame.identity,
                Impl::RendererGpuTimingScope::s_OpaqueRegular.identity,
                Impl::RendererGpuTimingScope::s_DeferredLighting.identity,
                Impl::RendererGpuTimingScope::s_DeferredComposite.identity,
                Impl::RendererGpuTimingScope::s_DeferredPresent.identity,
                Impl::RendererGpuTimingScope::s_ShadowVisibility.identity,
                Impl::RendererGpuTimingScope::s_ShadowOpaqueTrace.identity,
                Impl::RendererGpuTimingScope::s_ShadowGeometryDownsample.identity,
                Impl::RendererGpuTimingScope::s_ShadowOpaqueTemporal.identity,
                Impl::RendererGpuTimingScope::s_ShadowOpaqueResolve.identity,
                Impl::RendererGpuTimingScope::s_ShadowTransparentTrace.identity,
                Impl::RendererGpuTimingScope::s_ShadowTransparentTemporal.identity,
                Impl::RendererGpuTimingScope::s_ShadowTransparentResolve.identity,
            };
        }
        if(!PrepareTimingProbeScopes(this.m_graphics, scopes, probeName))
            return false;
        RegisterTimingProbeRenderPass(this.m_graphics, this.m_pass, probeName);
        this.m_registered = true;
        return true;
    }

    public void stop(){
        if(!this.m_registered)
            return;
        this.m_graphics.removeRenderPass(this.m_pass);
        this.m_registered = false;
    }

    private mut GraphicsRuntime m_graphics;
    private TimingProbeUnfocusedPass m_pass;
    private b8 m_registered = false;
}


