#include <impl/ecs_mesh/skinning/submission_state.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SkinningStateHandoff{
    private mut GpuPersistentResourceStateCache m_cache;
    private mut GpuPersistentStateCandidate m_candidate;
    private Span<BufferHandle> m_buffers;
    private b8 m_preparationInvoked = false;
    private b8 m_statePrepared = false;
    private b8 m_stateAccepted = false;

    public SkinningStateHandoff(mut GpuPersistentResourceStateCache cache, mut GpuPersistentStateCandidate candidate, in Span<BufferHandle> buffers){
        this.m_cache = cache;
        this.m_candidate = candidate;
        this.m_buffers = buffers;
    }

    public b8 recorded(in Optional<in CommandListResourceStateHandoff> finalState){
        this.m_preparationInvoked = true;
        if(!CanPrepareSkinningStateHandoff(finalState.has_value(), this.m_buffers.empty(), HasSpanStorage<BufferHandle>(this.m_buffers)))
            return false;
        this.m_statePrepared = this.m_cache.buildMergedBufferSubset(finalState.value(), this.m_buffers, this.m_candidate);
        return this.m_statePrepared;
    }

    public b8 accepted(in QueueSubmissionToken token){
        if(!this.m_statePrepared)
            return false;
        this.m_stateAccepted = this.m_cache.commit(this.m_candidate);
        return this.m_stateAccepted;
    }

    public b8 preparationInvoked()const{ return this.m_preparationInvoked; }
    public b8 statePrepared()const{ return this.m_statePrepared; }
    public b8 stateAccepted()const{ return this.m_stateAccepted; }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

