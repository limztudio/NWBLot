#include <impl/ecs_render/raytrace/raytracing_system.adhd>
#include <impl/ecs_render/raytrace/task_graph_scene_resources.adhd>
#include <impl/ecs_render/raytrace/graph_snapshots.adhd>
#include <impl/ecs_render/shadow/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ShadowPrepareGraphContext{
    public mut GpuTaskGraph graph;
    public mut GraphicsRuntime graphics;
    public mut RendererMeshSystem mesh;
    public mut RendererRayTracingSystem rayTracing;
    public mut GpuPersistentResourceStateCache persistentState;
    public Optional<mut IGpuTaskGraphInstanceTransformPatchContributor> instanceTransformPatchContributor;

    public ShadowPrepareGraphContext(
        mut GpuTaskGraph graph,
        mut GraphicsRuntime graphics,
        mut RendererMeshSystem mesh,
        mut RendererRayTracingSystem rayTracing,
        mut GpuPersistentResourceStateCache persistentState,
        in Optional<mut IGpuTaskGraphInstanceTransformPatchContributor> instanceTransformPatchContributor
    ){
        this.graph = graph;
        this.graphics = graphics;
        this.mesh = mesh;
        this.rayTracing = rayTracing;
        this.persistentState = persistentState;
        this.instanceTransformPatchContributor = instanceTransformPatchContributor;
    }
}

[friend(RendererFramePipeline, DeferredFrameTopologyValidator, FrameExecuteStateLifecycleSet, FrameExecuteTimingState, ShadowPreparePacketValidator)]
class ShadowPrepareGraphCoordinator : NoCopy{
    private GpuTaskId m_deferredBindlessSlotsUploadTask;
    private GpuTaskId m_rayTraceMaterialContextSlotsUploadTask;
    private GpuTaskId m_csgTraceContextUploadTask;
    private GpuTaskId m_causticEmissionTargetsUploadTask;
    private GpuTaskId m_surfelFrameConstantsUploadTask;
    private GpuTaskId m_shadowInstanceMaterialUploadTask;
    private GpuTaskId m_shadowInstanceUploadTask;
    private GpuTaskId m_shadowMaterialTypedUploadTask;
    private GpuTaskId m_sceneBvhNodesUploadTask;
    private GpuTaskId m_sceneBvhInstancesUploadTask;
    private GpuTaskId m_tlasInstancesUploadTask;
    private GpuTaskId m_deferredShadowPrepareTask;
    private GpuTaskId m_deferredShadowPrepareSoftwareBvhBuildFirstTask;
    private GpuTaskId m_deferredShadowPrepareSoftwareBvhBuildLastTask;
    private GpuTaskId m_deferredShadowPrepareSceneRefitTask;
    private GpuTaskId m_sceneBvhRefitInputsUploadTask;
    private GpuTaskId m_deferredShadowPrepareAccelStructFinalizeTask;
    private ShadowPreparationOutcome m_shadowPreparationOutcome;

    public b8 declareDeferredShadowPrepareTask(
        in ShadowPrepareGraphContext context,
        in RayTracingShadowPreparationResourceSnapshot rayTracingShadowResources,
        in RayTracingDeferredGraphResourceSnapshot rayTracingResources,
        in GpuGraphResourceId currentBindlessSlots,
        in GpuGraphResourceId materialContextSlots,
        in Span<GpuGraphResourceId> shadowTraceGeometryResources,
        in Span<GpuGraphResourceId> softwareBvhBuildStateResources,
        in b8 softwareTraceResourcesPrepared,
        mut DeferredFrameTargets deferredTargets,
        mut GpuTimingSubmissionTicket timingTicket
    );

    public void resetShadowPrepareUploadTaskState();

    public void resetShadowPrepareTaskState();
}


