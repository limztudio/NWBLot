#include <impl/ecs_ui/edit_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 HasPendingUiEditOwnerTransfer(
    in UiTextEditOwner targetOwner,
    in UiTextEditOwner sessionOwner,
    in b8 clipboardPending,
    in UiTextEditOwner clipboardOwner,
    in b8 primaryPending,
    in UiTextEditOwner primaryOwner
){
    return sessionOwner == targetOwner
        || (clipboardPending && clipboardOwner == targetOwner)
        || (primaryPending && primaryOwner == targetOwner);
}

b8 ShouldCancelUnfocusedUiEditTransfers(
    in b8 focused,
    in UiTextEditOwner focusedOwner,
    in b8 sessionValid,
    in UiTextEditOwner sessionOwner,
    in b8 clipboardPending,
    in UiTextEditOwner clipboardOwner,
    in b8 primaryPending,
    in UiTextEditOwner primaryOwner
){
    return (sessionValid && (!focused || focusedOwner != sessionOwner))
        || (clipboardPending && (!focused || focusedOwner != clipboardOwner))
        || (primaryPending && (!focused || focusedOwner != primaryOwner));
}

u64 AdvanceUiEditSelectionSequence(mut u64 inOutSelectionSequence){
    AdvanceNonWrappingRevision(inOutSelectionSequence);
    return inOutSelectionSequence;
}

b8 ResolveNextUiEditCompositionState(
    in b8 currentComposing,
    in UiEditBoxEventKind eventKind,
    in u8 nativeEventKind,
    in u8 preeditEventKind,
    in u8 cancelledEventKind,
    in u8 commitEventKind,
    in b8 nativeTextEmpty,
    in b8 isCancelCommand
){
    if(eventKind == UiEditBoxEventKind::Native){
        if(nativeEventKind == preeditEventKind)
            return !nativeTextEmpty;
        if(nativeEventKind == cancelledEventKind || (nativeEventKind == commitEventKind && !nativeTextEmpty))
            return false;
        return currentComposing;
    }
    if(eventKind == UiEditBoxEventKind::Command && isCancelCommand)
        return false;
    return currentComposing;
}


