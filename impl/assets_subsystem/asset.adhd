////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_subsystem/subsystem_binary_codec.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_SubsystemAssetKindLabel = "subsystem";

[asset("subsystem")]
interface ISubsystem{
    b8 loadBinary(in Span<u8> binary);
    b8 validatePayload()const;
    in Vector<AssetRef<ISubsystem>> parentRefs()const;
    mut Vector<AssetRef<ISubsystem>> editParentRefs();
    usize fieldCount()const;
    SubsystemFieldValueDescriptor fieldDescriptor(in usize index)const;
    usize fieldValueCount(in usize index)const;
    Name fieldValue(in usize index, in usize elementIndex)const;
    void clearFieldValues(in usize index);
    void appendFieldValue(in usize index, in Name value);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ValidateSubsystemHasDeclaredFields(in usize fieldCount){
    if(fieldCount > 0u)
        return true;

    error("ISubsystem::validatePayload failed: subsystem must declare at least one asset field");
    return false;
}

b8 ValidateNonEmptySubsystemAssetRefName(in Name assetName){
    if(assetName != s_NameNone)
        return true;

    error("ISubsystem::loadBinary failed: asset reference must not be empty");
    return false;
}

b8 ValidateSubsystemPayloadStoreCapacity(in b8 canStore, in StringView payloadLabel){
    if(canStore)
        return true;

    error("ISubsystem::loadBinary failed: malformed '{}' payload", payloadLabel);
    return false;
}

b8 ValidateSubsystemPayload(in ISubsystem subsystem){
    if(!subsystem.checkVirtualPath("ISubsystem::validatePayload"))
        return false;

    for(usize i = 0u; i < subsystem.parentRefs().size(); ++i){
        in AssetRef<ISubsystem> ref = subsystem.parentRefs()[i];
        if(!ValidateSubsystemDependentRef(subsystem.virtualPath(), ref.name(), ref.valid(), i))
            return false;
    }

    const usize count = subsystem.fieldCount();
    if(!ValidateSubsystemHasDeclaredFields(count))
        return false;

    for(usize i = 0u; i < count; ++i){
        const SubsystemFieldValueDescriptor descriptor = subsystem.fieldDescriptor(i);
        const usize valueCount = subsystem.fieldValueCount(i);
        if(!ValidateSubsystemFieldValueCount(subsystem.virtualPath(), descriptor, valueCount))
            return false;

        for(usize elementIndex = 0u; elementIndex < valueCount; ++elementIndex){
            const Name value = subsystem.fieldValue(i, elementIndex);
            b8 isDuplicate = false;
            for(usize prevIndex = 0u; prevIndex < elementIndex; ++prevIndex){
                if(subsystem.fieldValue(i, prevIndex) == value){
                    isDuplicate = true;
                    break;
                }
            }
            if(!ValidateSubsystemFieldElementValue(subsystem.virtualPath(), descriptor, value, isDuplicate))
                return false;
        }
    }

    return true;
}

b8 LoadSubsystemBinary(in Span<u8> binary, mut ISubsystem outSubsystem){
    const usize expectedFieldCount = outSubsystem.fieldCount();
    Vector<NameHash> subsystemHashes;
    Vector<u64> fieldCounts;
    Vector<NameHash> assetHashes;
    usize cursor = 0u;
    usize subsystemCount = 0u;
    usize fieldCount = 0u;
    usize assetCount = 0u;
    const SubsystemBinaryCodec codec = SubsystemBinaryCodec();
    if(!codec.readCounts(binary, outSubsystem.assetType(), expectedFieldCount, cursor, subsystemCount, fieldCount, assetCount))
        return false;
    if(!ValidateSubsystemPayloadStoreCapacity(CanStoreValueCount(subsystemHashes, subsystemCount), "subsystems"))
        return false;
    if(!ValidateSubsystemPayloadStoreCapacity(CanStoreValueCount(fieldCounts, fieldCount), "field counts"))
        return false;
    if(!ValidateSubsystemPayloadStoreCapacity(CanStoreValueCount(assetHashes, assetCount), "assets"))
        return false;
    subsystemHashes.resize(subsystemCount);
    fieldCounts.resize(fieldCount);
    assetHashes.resize(assetCount);
    if(!codec.readPayloads(
        binary,
        cursor,
        cast<u64>(assetCount),
        subsystemHashes,
        fieldCounts,
        assetHashes
    ) || !UnpackSubsystemRefHashes(Span<NameHash>(subsystemHashes), outSubsystem.editParentRefs()))
        return false;

    usize hashOffset = 0u;
    for(usize i = 0u; i < expectedFieldCount; ++i){
        const SubsystemFieldValueDescriptor descriptor = outSubsystem.fieldDescriptor(i);
        const u64 elementCount = fieldCounts[i];
        if(!ValidateSubsystemBinaryScalarFieldCount(outSubsystem.assetType(), descriptor, elementCount))
            return false;
        outSubsystem.clearFieldValues(i);
        for(u64 elementIndex = 0u; elementIndex < elementCount; ++elementIndex){
            const Name assetName(assetHashes[hashOffset]);
            ++hashOffset;
            if(!ValidateNonEmptySubsystemAssetRefName(assetName))
                return false;
            outSubsystem.appendFieldValue(i, assetName);
        }
    }

    return outSubsystem.validatePayload();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class SubsystemAssetPolicy{
    public StringView deserializeContext()const{ return "SubsystemAssetCodec::deserialize"; }
    public StringView serializeContext()const{ return "SubsystemAssetCodec::serialize"; }
    public StringView memberSerializeContext()const{ return "TypedSubsystemAssetCodec::serialize"; }

    public Expected<NameHash> readType(in Span<u8> binary)const{
        usize cursor = 0u;
        const Expected<SubsystemHeaderBinary> header = ReadMagicHeaderPayload<SubsystemHeaderBinary>(
            binary, s_SubsystemMagic, "ISubsystem::loadBinary", s_SubsystemAssetKindLabel, cursor
        );
        if(!header.has_value())
            return MakeUnexpected(Failure());
        return header.value().subsystemTypeHash;
    }

    public b8 write(in ISubsystem subsystem, mut Vector<u8> outBinary)const{
        if(!subsystem.validatePayload())
            return false;

        const usize fieldCount = subsystem.fieldCount();
        Vector<NameHash> subsystemHashes;
        Vector<u64> fieldCounts;
        Vector<NameHash> assetHashes;
        subsystemHashes.reserve(subsystem.parentRefs().size());
        fieldCounts.reserve(fieldCount);

        for(in AssetRef<ISubsystem> ref : subsystem.parentRefs())
            subsystemHashes.push_back(ref.name().hash());

        usize totalAssetCount = 0u;
        for(usize i = 0u; i < fieldCount; ++i){
            const usize valueCount = subsystem.fieldValueCount(i);
            fieldCounts.push_back(cast<u64>(valueCount));
            totalAssetCount += valueCount;
        }

        assetHashes.reserve(totalAssetCount);
        for(usize i = 0u; i < fieldCount; ++i){
            const usize valueCount = subsystem.fieldValueCount(i);
            for(usize elementIndex = 0u; elementIndex < valueCount; ++elementIndex)
                assetHashes.push_back(subsystem.fieldValue(i, elementIndex).hash());
        }

        return SubsystemBinaryCodec().serialize(subsystem.assetType().hash(), subsystemHashes, fieldCounts, assetHashes, outBinary);
    }
}

type SubsystemTypeAutoRegistrar = AssetFamilyTypes<ISubsystem>;
type SubsystemAssetCodec = FamilyAssetCodec<ISubsystem, SubsystemAssetPolicy>;
type TypedSubsystemAssetCodec<T> = FamilyMemberAssetCodec<ISubsystem, T, SubsystemAssetPolicy>;
type TypedSubsystemAutoRegistrar<T> = TypedAssetRegistration<ISubsystem, T, TypedSubsystemAssetCodec<T>>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

