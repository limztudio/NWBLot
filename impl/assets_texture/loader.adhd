////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_texture/asset.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const FormatSupport s_RequiredTextureFormatSupport = FormatSupport::Texture | FormatSupport::ShaderSample;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


enum<u8> TextureUploadFailure{
    Decode,
    Submit,
}

class TextureDecodedMipUpload{
    public Vector<u8> bytes;
    public usize rowPitch = 0u;
    public usize sliceByteCount = 0u;
};

class TextureGpuResource : NoCopy{
    public TextureHandle texture;
    public GpuDescriptorHandle sampledImageHeapHandle = GpuDescriptorHandleInvalid();
    public QueueSubmissionToken readinessToken = QueueSubmissionToken();
    public Format format = Format::UNKNOWN;


    public b8 valid()const{
        return this.texture.valid() && this.sampledImageHeapHandle.valid() && this.format != Format::UNKNOWN;
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TextureMipDecoder : NoCopy{
    [cpp_unwind]
    public Expected<TextureDecodedMipUpload> decode(
        in Texture textureAsset,
        in TextureMipLevel mip,
        in u32 mipLevel,
        in Format format
    );

    [cpp_unwind]
    public Expected<QueueSubmissionToken, TextureUploadFailure> decodeAndUploadStaticTextureMips(
        in Texture textureAsset,
        in Format format,
        mut GraphicsRuntime graphics,
        in TextureHandle texture
    );

    [cpp_unwind]
    private Expected<TextureDecodedMipUpload> decodeLdr(
        in Texture textureAsset,
        in TextureMipLevel mip,
        in u32 mipLevel,
        in Format format
    );

    [cpp_unwind]
    private Expected<TextureDecodedMipUpload> decodeHdr(
        in Texture textureAsset,
        in TextureMipLevel mip,
        in u32 mipLevel,
        in Format format
    );
};

[cpp_unwind]
Expected<TextureDecodedMipUpload> TextureMipDecoder::decode(
    in Texture textureAsset,
    in TextureMipLevel mip,
    in u32 mipLevel,
    in Format format
){
    if(textureAsset.payloadFormat() == TexturePayloadFormat::UastcLdr4x4)
        return this.decodeLdr(textureAsset, mip, mipLevel, format);
    if(textureAsset.payloadFormat() == TexturePayloadFormat::UastcHdr4x4)
        return this.decodeHdr(textureAsset, mip, mipLevel, format);

    error("TextureAssetLoader: unsupported texture payload format");
    return MakeUnexpected(Failure());
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Name ResolveTextureUploadDebugName(in Name debugName, in Name virtualPath){
    if(debugName != s_NameNone)
        return debugName;
    return virtualPath;
}

b8 HasPartiallyInitializedTextureGpuResource(in b8 hasTexture, in b8 hasDescriptor, in b8 hasKnownFormat){
    return hasTexture || hasDescriptor || hasKnownFormat;
}

b8 ShouldRetryTextureCreateWithFallback(
    in b8 isLdrPayload,
    in b8 isRgba8Format,
    in b8 isHdrPayload,
    in b8 isOpaqueAlpha
){
    return (isLdrPayload && !isRgba8Format) || (isHdrPayload && isOpaqueAlpha);
}

usize ComputeTextureUploadRegionReserveCount(
    in Span<TextureMipLevel> mipLevels,
    in b8 isVolumeTexture
){
    if(isVolumeTexture)
        return mipLevels.size();
    usize totalRegions = 0u;
    for(in TextureMipLevel mip : mipLevels)
        totalRegions += cast<usize>(mip.sliceCount);
    return totalRegions;
}

b8 SupportsTextureFormat(in Format format, mut Device device){
    return (device.queryFormatSupport(format) & s_RequiredTextureFormatSupport) == s_RequiredTextureFormatSupport;
}

Format SelectTextureUploadFormat(in Texture textureAsset, mut Device device){
    if(textureAsset.payloadFormat() == TexturePayloadFormat::UastcHdr4x4){
        if(textureAsset.alphaMode() == TextureAlphaMode::Opaque){
            if(SupportsTextureFormat(Format::ASTC_4x4_FLOAT, device))
                return Format::ASTC_4x4_FLOAT;
            if(SupportsTextureFormat(Format::BC6H_UFLOAT, device))
                return Format::BC6H_UFLOAT;
        }
        if(SupportsTextureFormat(Format::RGBA16_FLOAT, device))
            return Format::RGBA16_FLOAT;
        return Format::UNKNOWN;
    }
    if(textureAsset.payloadFormat() != TexturePayloadFormat::UastcLdr4x4)
        return Format::UNKNOWN;

    if(SupportsTextureFormat(Format::ASTC_4x4_UNORM, device))
        return Format::ASTC_4x4_UNORM;

    if(SupportsTextureFormat(Format::BC7_UNORM, device))
        return Format::BC7_UNORM;

    if(SupportsTextureFormat(Format::RGBA8_UNORM, device))
        return Format::RGBA8_UNORM;
    return Format::UNKNOWN;
}

Format SelectHdrOpaqueUploadFallback(in Format failedFormat, mut Device device){
    if(failedFormat == Format::ASTC_4x4_FLOAT && SupportsTextureFormat(Format::BC6H_UFLOAT, device))
        return Format::BC6H_UFLOAT;
    if(failedFormat != Format::RGBA16_FLOAT && SupportsTextureFormat(Format::RGBA16_FLOAT, device))
        return Format::RGBA16_FLOAT;
    return Format::UNKNOWN;
}

Format SelectLdrUploadFallback(in Format failedFormat, mut Device device){
    if(failedFormat == Format::ASTC_4x4_UNORM && SupportsTextureFormat(Format::BC7_UNORM, device))
        return Format::BC7_UNORM;
    if(failedFormat != Format::RGBA8_UNORM && SupportsTextureFormat(Format::RGBA8_UNORM, device))
        return Format::RGBA8_UNORM;
    return Format::UNKNOWN;
}

Format SelectNextTextureUploadFallback(in TexturePayloadFormat payloadFormat, in Format failedFormat, mut Device device){
    if(payloadFormat == TexturePayloadFormat::UastcLdr4x4)
        return SelectLdrUploadFallback(failedFormat, device);
    return SelectHdrOpaqueUploadFallback(failedFormat, device);
}

Expected<TextureHandle> TryCreateStaticTexture(
    in Texture textureAsset,
    mut TextureDesc textureDesc,
    mut GraphicsRuntime graphics,
    mut Device device,
    mut Format inOutFormat
){
    while(true){
        Expected<TextureHandle> textureResult = graphics.createTexture(textureDesc);
        if(textureResult.has_value())
            return textureResult;
        if(
            !ShouldRetryTextureCreateWithFallback(
                textureAsset.payloadFormat() == TexturePayloadFormat::UastcLdr4x4,
                inOutFormat == Format::RGBA8_UNORM,
                textureAsset.payloadFormat() == TexturePayloadFormat::UastcHdr4x4,
                textureAsset.alphaMode() == TextureAlphaMode::Opaque
            )
        )
            return textureResult;
        const Format fallbackFormat = SelectNextTextureUploadFallback(textureAsset.payloadFormat(), inOutFormat, device);
        if(fallbackFormat == Format::UNKNOWN)
            return textureResult;
        inOutFormat = fallbackFormat;
        textureDesc.setFormat(fallbackFormat);
    }
}

TextureDimension ToCoreTextureDimension(in TexturePayloadDimension dimension){
    switch(dimension){
    case TexturePayloadDimension::Texture2D:
        return TextureDimension::Texture2D;
    case TexturePayloadDimension::TextureCube:
        return TextureDimension::TextureCube;
    case TexturePayloadDimension::Texture3D:
        return TextureDimension::Texture3D;
    default:
        return TextureDimension::Unknown;
    }
}

GpuDescriptorClass ToSampledImageDescriptorClass(in TexturePayloadDimension dimension){
    switch(dimension){
    case TexturePayloadDimension::Texture2D:
        return GpuDescriptorClass::SampledImage;
    case TexturePayloadDimension::TextureCube:
        return GpuDescriptorClass::SampledImageCube;
    case TexturePayloadDimension::Texture3D:
        return GpuDescriptorClass::SampledImage3D;
    default:
        return GpuDescriptorClass::kCount;
    }
}

[cpp_unwind]
b8 CreateTextureGpuResource(in Texture textureAsset, in Name debugName, in StringView ownerName, mut GraphicsRuntime graphics, mut TextureGpuResource outResource){
    assert(!outResource.valid());
    if(HasPartiallyInitializedTextureGpuResource(outResource.texture.valid(), outResource.sampledImageHeapHandle.valid(), outResource.format != Format::UNKNOWN)){
        error("{}: texture resource is partially initialized; release it before recreating", ownerName);
        return false;
    }
    assert(textureAsset.validatePayload());

    mut Device device = graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized()){
        error("{}: cannot load texture '{}' without an initialized descriptor heap", ownerName, textureAsset.virtualPath().resolvedText());
        return false;
    }

    Format format = SelectTextureUploadFormat(textureAsset, device);
    if(format == Format::UNKNOWN){
        error("{}: device cannot sample the required texture format for '{}'", ownerName, textureAsset.virtualPath().resolvedText());
        return false;
    }

    const Name imageName = ResolveTextureUploadDebugName(debugName, textureAsset.virtualPath());
    const TextureDimension textureDimension = ToCoreTextureDimension(textureAsset.dimension());
    const GpuDescriptorClass descriptorClass = ToSampledImageDescriptorClass(textureAsset.dimension());
    assert(textureDimension != TextureDimension::Unknown && descriptorClass != GpuDescriptorClass::kCount);

    TextureDesc textureDesc = TextureDesc();
    textureDesc.setWidth(textureAsset.width());
    textureDesc.setHeight(textureAsset.height());
    textureDesc.setMipLevels(cast<u32>(textureAsset.mipLevels().size()));
    textureDesc.setFormat(format);
    textureDesc.setDimension(textureDimension);
    textureDesc.setInitialState(ResourceStates::ShaderResource);
    textureDesc.setKeepInitialState(true);
    textureDesc.setQueueSharing(ResourceQueueSharing::GraphicsAsyncComputeAndTransfer);
    textureDesc.setName(imageName);
    if(textureAsset.dimension() == TexturePayloadDimension::TextureCube)
        textureDesc.setArraySize(s_TextureCubeFaceCount);
    else if(textureAsset.dimension() == TexturePayloadDimension::Texture3D)
        textureDesc.setDepth(textureAsset.depth());

    Expected<TextureHandle> textureResult = TryCreateStaticTexture(textureAsset, textureDesc, graphics, device, format);
    if(!textureResult.has_value()){
        error("{}: failed to create texture '{}'", ownerName, imageName.resolvedText());
        return false;
    }
    TextureHandle texture = textureResult.value();

    const Expected<GpuDescriptorHandle> sampledImageHandleResult = heap.allocate(descriptorClass);
    if(!sampledImageHandleResult.has_value()){
        error("{}: failed to allocate a bindless sampled-image slot for texture '{}'", ownerName, imageName.resolvedText());
        return false;
    }
    const GpuDescriptorHandle sampledImageHandle = sampledImageHandleResult.value();
    GpuDescriptorRetirementGuard releaseDescriptor(heap, sampledImageHandle);

    if(!heap.write(sampledImageHandle, DescriptorWriteItemTextureSrv(0u, texture.deref(), format, s_AllSubresources, textureDimension))){
        error("{}: failed to write the bindless sampled-image slot for texture '{}'", ownerName, imageName.resolvedText());
        return false;
    }

    TextureMipDecoder mipDecoder = TextureMipDecoder();
    const Expected<QueueSubmissionToken, TextureUploadFailure> uploadToken = mipDecoder.decodeAndUploadStaticTextureMips(textureAsset, format, graphics, texture);
    if(!uploadToken.has_value()){
        if(uploadToken.error() == TextureUploadFailure::Submit)
            error("{}: failed to submit graph-owned texture upload for '{}'", ownerName, imageName.resolvedText());
        return false;
    }

    outResource.texture = texture;
    outResource.sampledImageHeapHandle = sampledImageHandle;
    outResource.format = format;
    outResource.readinessToken = uploadToken.value();
    releaseDescriptor.release();
    return true;
}

[cpp_unwind]
b8 LoadTextureGpuResource(in AssetRef<Texture> textureAsset, in Name debugName, in StringView ownerName, mut GraphicsRuntime graphics, in AssetManager assetManager, mut TextureGpuResource outResource){
    if(!CheckAssetLoaderEnter(textureAsset, outResource, ownerName))
        return outResource.valid();

    const Name textureVirtualPath = textureAsset.name();

    Expected<UniquePtr<Texture>> loadedAsset = LoadTypedAssetSync<Texture>(assetManager, textureVirtualPath, ownerName);
    if(!loadedAsset.has_value() || !loadedAsset.value().valid())
        return false;

    return CreateTextureGpuResource(loadedAsset.value().deref(), debugName, ownerName, graphics, outResource);
}

void ReleaseTextureGpuResource(mut GraphicsRuntime graphics, mut TextureGpuResource inOutResource){
    if(inOutResource.sampledImageHeapHandle.valid()){
        mut GpuDescriptorHeap heap = graphics.getDevice().getDescriptorHeap();
        if(heap.isInitialized())
            heap.free(inOutResource.sampledImageHeapHandle);
        inOutResource.sampledImageHeapHandle = GpuDescriptorHandleInvalid();
    }

    inOutResource.texture.reset();
    inOutResource.format = Format::UNKNOWN;
    inOutResource.readinessToken = QueueSubmissionToken();
}


