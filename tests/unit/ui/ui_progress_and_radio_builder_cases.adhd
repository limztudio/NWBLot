////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_ui_radio_group_behavior_tests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace Impl::Ui;

namespace CallbackPhase{
    enum Enum : u8{ None, Generation, Revision, Count, Key, Lookup, Enabled };
};

namespace CallbackMutation{
    enum Enum : u8{
        SelectIdentical, SelectAba, Reset, Reconcile, Apply, SourceRevision, SourceGeneration, SourceCount, GuardFailure
    };
};

class ReconcileGate final : public IRadioGroupReconcileGuard{
public:
    [[nodiscard]] virtual b8 current()const noexcept override{
        if(mutateState && state){
            mutateState = false;
            state->select(state->selectedKey());
        }
        return allowed;
    }

    void bindState(RadioGroupState& targetState)noexcept{
        state = &targetState;
    }


public:
    RadioGroupState* state = nullptr;
    b8 allowed = true;
    mutable b8 mutateState = false;
};

class ChoiceSource final : public IListDataSource{
public:
    ChoiceSource()noexcept{
        for(u32 index = 0u; index < s_RadioGroupMaxChoices; ++index)
            rows[index] = { index + 1u, true };
    }


public:
    void bindState(RadioGroupState& targetState)noexcept{
        state = &targetState;
    }

    void bindGate(ReconcileGate& targetGate)noexcept{
        gate = &targetGate;
    }

    [[nodiscard]] virtual u64 instanceGeneration()const noexcept override{
        callback(CallbackPhase::Generation);
        return generation;
    }

    [[nodiscard]] virtual u64 revision()const noexcept override{
        callback(CallbackPhase::Revision);
        return revisionValue;
    }

    [[nodiscard]] virtual u64 rowCount()const noexcept override{
        ++countCalls;
        callback(CallbackPhase::Count);
        return count;
    }

    [[nodiscard]] virtual u64 key(const u64 index)const noexcept override{
        callback(CallbackPhase::Key);
        ++keyCalls;
        return index < s_RadioGroupMaxChoices ? rows[static_cast<usize>(index)].key : 0u;
    }

    [[nodiscard]] virtual Expected<u64> indexOf(const u64 key)const noexcept override{
        u64 index = 0u;
        callback(CallbackPhase::Lookup);
        for(u32 candidate = 0u; candidate < Min<u64>(count, s_RadioGroupMaxChoices); ++candidate){
            if(rows[candidate].key == key){
                index = badLookup ? count : candidate;
                return !missingLookup ? Expected<u64>{ index } : MakeUnexpected(Failure{});
            }
        }
        return MakeUnexpected(Failure{});
    }

    [[nodiscard]] virtual Expected<u64> findEnabled(const u64 start, const b8 reverse)const noexcept override{
        u64 index = 0u;
        ++findCalls;
        if(start >= count || count > s_RadioGroupMaxChoices)
            return MakeUnexpected(Failure{});
        index = start;
        for(u64 visited = 0u; visited < count; ++visited){
            if(rows[static_cast<usize>(index)].enabled)
                return index;
            if(reverse){
                if(index == 0u)
                    return MakeUnexpected(Failure{});
                --index;
            }
            else{
                ++index;
                if(index == count)
                    return MakeUnexpected(Failure{});
            }
        }
        return MakeUnexpected(Failure{});
    }

    [[nodiscard]] virtual StringView text(u64)const noexcept override{ return "choice"; }

    [[nodiscard]] virtual b8 enabled(const u64 index)const noexcept override{
        callback(CallbackPhase::Enabled);
        return index < s_RadioGroupMaxChoices && rows[static_cast<usize>(index)].enabled;
    }


private:
    void callback(const CallbackPhase::Enum current)const noexcept{
        ++callbackCalls;
        if(!armed || phase != current || (triggerCount != 0u && countCalls != triggerCount))
            return;
        armed = false;
        callbacksAtMutation = callbackCalls;
        if(mutation == CallbackMutation::GuardFailure){
            if(gate)
                gate->allowed = false;
            return;
        }
        if(mutation == CallbackMutation::SourceRevision){
            ++revisionValue;
            return;
        }
        if(mutation == CallbackMutation::SourceGeneration){
            ++generation;
            return;
        }
        if(mutation == CallbackMutation::SourceCount){
            ++count;
            return;
        }
        if(!state)
            return;
        switch(mutation){
        case CallbackMutation::SelectIdentical:
            state->select(state->selectedKey());
            break;
        case CallbackMutation::SelectAba:{
            const u64 original = state->selectedKey();
            state->select(original == 1u ? 2u : 1u);
            state->select(original);
            break;
        }
        case CallbackMutation::Reset:
            state->reset();
            break;
        case CallbackMutation::Reconcile:{
            RadioGroupResult nestedResult;
            nestedSucceeded = RadioGroupBehavior::Reconcile(*this, nullptr, *state, nestedResult).has_value();
            break;
        }
        case CallbackMutation::Apply:{
            ControlAction action;
            const RadioGroupSnapshot snapshot = state->snapshot();
            action.control = { snapshot.inputGeneration, snapshot.sourceGeneration, snapshot.sourceRevision };
            action.kind = ControlActionKind::Down;
            RadioGroupResult nestedResult;
            nestedSucceeded = RadioGroupBehavior::Apply(borrowedChoices, {}, action, *state, nestedResult);
            break;
        }
        default:
            break;
        }
    }


public:
    Array<RadioGroupChoice, s_RadioGroupMaxChoices> rows{};
    mutable u64 generation = 41u;
    mutable u64 revisionValue = 7u;
    mutable u64 count = 4u;
    RadioGroupState* state = nullptr;
    ReconcileGate* gate = nullptr;
    RadioGroupChoices borrowedChoices;
    mutable u32 keyCalls = 0u;
    mutable u32 findCalls = 0u;
    mutable u32 countCalls = 0u;
    mutable u32 callbackCalls = 0u;
    mutable u32 callbacksAtMutation = 0u;
    u32 triggerCount = 0u;
    CallbackPhase::Enum phase = CallbackPhase::None;
    CallbackMutation::Enum mutation = CallbackMutation::SelectIdentical;
    b8 badLookup = false;
    b8 missingLookup = false;
    mutable b8 armed = false;
    mutable b8 nestedSucceeded = true;
};

[[nodiscard]] NWB_INLINE Expected<RadioGroupChoices> ReconcileUiRadioGroupChoices(const IListDataSource& source, RadioGroupState& state, RadioGroupResult& result){
    return RadioGroupBehavior::Reconcile(source, nullptr, state, result);
}

[[nodiscard]] NWB_INLINE Expected<RadioGroupChoices> ReconcileUiRadioGroupChoicesGuarded(const IListDataSource& source, const IRadioGroupReconcileGuard& guard, RadioGroupState& state, RadioGroupResult& result){
    return RadioGroupBehavior::Reconcile(source, &guard, state, result);
}

[[nodiscard]] NWB_INLINE b8 ApplyUiRadioGroupAction(const RadioGroupChoices& choices, const RadioGroupOptions& options, const ControlAction& action, RadioGroupState& state, RadioGroupResult& result){
    return RadioGroupBehavior::Apply(choices, options, action, state, result);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_END


