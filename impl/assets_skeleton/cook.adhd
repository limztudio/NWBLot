b8 ValidateSkeletonJointEntryMap(in b8 isMap, in Path nwbFilePath, in usize jointIndex){
    if(isMap)
        return true;

    error("Skeleton meta '{}': joints[{}] must be a map", nwbFilePath, jointIndex);
    return false;
}

Expected<Array<f32, 4>> ParseSkeletonJointMatrixRow(
    in Path nwbFilePath,
    in MetascriptValue rowValue,
    in StringView metaKind,
    in StringView label,
    in usize rowIndex
){
    if(!rowValue.isList()){
        ValidateSkeletonJointMatrixColumnList(false, 0u, nwbFilePath, metaKind, label, rowIndex);
        return MakeUnexpected(Failure());
    }

    const Span<MetascriptValue> columns = rowValue.listView();
    if(!ValidateSkeletonJointMatrixColumnList(true, columns.size(), nwbFilePath, metaKind, label, rowIndex))
        return MakeUnexpected(Failure());

    Array<f32, 4> row = Array<f32, 4>();
    for(usize columnIndex = 0u; columnIndex < cast<usize>(s_SkeletonJointMatrixColumnCount); ++columnIndex){
        const MetascriptValue column = columns[columnIndex];
        if(!column.isNumeric()){
            LogSkeletonJointMatrixElementFailure(false, nwbFilePath, metaKind, label, rowIndex, columnIndex);
            return MakeUnexpected(Failure());
        }
        const Expected<f32> elem = TryFiniteF32FromF64(column.toDouble());
        if(!elem.has_value()){
            LogSkeletonJointMatrixElementFailure(true, nwbFilePath, metaKind, label, rowIndex, columnIndex);
            return MakeUnexpected(Failure());
        }
        row[columnIndex] = elem.value();
    }
    return row;
}

Expected<SkeletonJointMatrix> ParseSkeletonJointMatrix(
    in Path nwbFilePath,
    in MetascriptValue value,
    in StringView metaKind,
    in StringView label
){
    if(!value.isList()){
        ValidateSkeletonJointMatrixRowList(false, 0u, nwbFilePath, metaKind, label);
        return MakeUnexpected(Failure());
    }

    const Span<MetascriptValue> rows = value.listView();
    if(!ValidateSkeletonJointMatrixRowList(true, rows.size(), nwbFilePath, metaKind, label))
        return MakeUnexpected(Failure());

    const Expected<Array<f32, 4>> row0 = ParseSkeletonJointMatrixRow(nwbFilePath, rows[0u], metaKind, label, 0u);
    if(!row0.has_value())
        return MakeUnexpected(Failure());
    const Expected<Array<f32, 4>> row1 = ParseSkeletonJointMatrixRow(nwbFilePath, rows[1u], metaKind, label, 1u);
    if(!row1.has_value())
        return MakeUnexpected(Failure());
    const Expected<Array<f32, 4>> row2 = ParseSkeletonJointMatrixRow(nwbFilePath, rows[2u], metaKind, label, 2u);
    if(!row2.has_value())
        return MakeUnexpected(Failure());

    return BuildSkeletonJointMatrixFromRows(row0.value(), row1.value(), row2.value());
}

Expected<SkeletonCookJoint> ParseSkeletonCookJoint(in Path nwbFilePath, in MetascriptValue jointValue){
    SkeletonCookJoint joint;

    if(!ValidateMetadataAssetFields(nwbFilePath, jointValue, s_SkeletonJointDiagnosticPrefix, lambda[](in StringView fieldName) -> b8{
        return IsAllowedSkeletonJointMetadataField(fieldName);
    }))
        return MakeUnexpected(Failure());

    const Expected<Name> nameResult = ReadMetadataNameField(nwbFilePath, jointValue, s_SkeletonJointMetaKind, s_SkeletonNameField, true);
    if(!nameResult.has_value())
        return MakeUnexpected(Failure());
    joint.name = nameResult.value();

    const Expected<Name> parentResult = ReadMetadataNameField(nwbFilePath, jointValue, s_SkeletonJointMetaKind, s_SkeletonParentField, false);
    if(!parentResult.has_value())
        return MakeUnexpected(Failure());
    joint.parent = parentResult.value();

    b8 poseOk = true;
    SkeletonJointMatrix localBindPose = joint.localBindPose;
    jointValue.visitField(
        s_SkeletonLocalBindPoseField,
        lambda[in nwbFilePath, mut poseOk, mut localBindPose](in MetascriptValue fieldVal) -> void{
            const Expected<SkeletonJointMatrix> matrixResult = ParseSkeletonJointMatrix(nwbFilePath, fieldVal, s_SkeletonMetaKind, s_SkeletonLocalBindPoseField);
            if(!matrixResult.has_value()){
                poseOk = false;
                return;
            }
            localBindPose = matrixResult.value();
        }
    );
    if(!poseOk)
        return MakeUnexpected(Failure());
    joint.localBindPose = localBindPose;
    return joint;
}

Expected<Vector<SkeletonCookJoint>> ParseSkeletonCookJoints(in Path nwbFilePath, in MetascriptValue asset){
    if(!CheckMetadataAssetMap(nwbFilePath, asset, s_SkeletonMetaDiagnosticPrefix))
        return MakeUnexpected(Failure());
    if(!ValidateMetadataAssetFields(nwbFilePath, asset, s_SkeletonMetaDiagnosticPrefix, lambda[](in StringView fieldName) -> b8{
        return IsAllowedSkeletonMetadataField(fieldName);
    }))
        return MakeUnexpected(Failure());

    const Expected<Span<MetascriptValue>> joints = ReadMetadataListField(nwbFilePath, asset, s_SkeletonMetaDiagnosticPrefix, s_SkeletonJointsField);
    if(!joints.has_value())
        return MakeUnexpected(Failure());

    const Span<MetascriptValue> jointList = joints.value();
    Vector<SkeletonCookJoint> result;
    result.reserve(jointList.size());
    for(usize jointIndex = 0u; jointIndex < jointList.size(); ++jointIndex){
        const MetascriptValue jointValue = jointList[jointIndex];
        if(!ValidateSkeletonJointEntryMap(jointValue.isMap(), nwbFilePath, jointIndex))
            return MakeUnexpected(Failure());

        const Expected<SkeletonCookJoint> jointResult = ParseSkeletonCookJoint(nwbFilePath, jointValue);
        if(!jointResult.has_value())
            return MakeUnexpected(Failure());
        result.push_back(jointResult.value());
    }
    return result;
}


