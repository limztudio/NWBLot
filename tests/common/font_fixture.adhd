////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_font/asset.adhd.h>
#include <impl/assets_font/prepared_source.adhd.h>

#include <global/filesystem.h>

NWB_BEGIN

namespace Tests{

template<typename PathArenaT>
[[nodiscard]] NWB_INLINE Expected<Core::Assets::AssetBytes, AStringView> ReadBundledFontBytes(const ::Path<PathArenaT>& fontPath, Core::Assets::AssetArena& arena){
    auto source = Impl::ReadPreparedFontSource(fontPath, false, arena);
    if(!source)
        return MakeUnexpected(source.error());
    return Move(source->fontBytes);
}

[[nodiscard]] NWB_INLINE b8 LoadBundledFont(Impl::Font& font, Core::Alloc::GlobalArena& arena, const StringView directory, const StringView filename){
    const ::Path<Core::Alloc::GlobalArena> path = ::Path<Core::Alloc::GlobalArena>(arena, directory) / filename;
    auto bytes = ReadBundledFontBytes(path, arena);
    if(!bytes)
        return false;
    font.setFontBytes(Move(*bytes));
    return font.validatePayload();
}

#if defined(NWB_REPO_ROOT)
template<typename TestArenaT>
[[nodiscard]] NWB_INLINE ::Path<Core::Assets::AssetArena> DefaultBundledFontRoot(TestArenaT& testArena){
    return ::Path<Core::Assets::AssetArena>(testArena.arena, NWB_REPO_ROOT) / "impl" / "assets" / "ui" / "fonts" / "default";
}
#endif

};

NWB_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void WriteLittleU32(in usize offset, in u32 value, mut Span<u8> bytes){
    for(u32 index = 0u; index < 4u; ++index)
        bytes[offset + cast<usize>(index)] = cast<u8>(value >> (index * 8u));
}


