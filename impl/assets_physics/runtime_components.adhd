#include <impl/assets_physics/components.adhd>
#include <impl/assets_physics/physics_component_binary_codec.adhd>
#include <impl/assets_scene/component_asset_binary_codec.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 RigidBodyComponentAsset::loadBinary(in Span<u8> binary){
    return ComponentAssetBinaryCodec().loadBinary(binary, this);
}

b8 RigidBodyComponentAsset::loadComponentPayload(in Span<u8> payload){
    return PhysicsComponentBinaryCodec().deserializeRigidBody(payload, this.component);
}

b8 RigidBodyComponentAsset::validatePayload()const{
    if(!this.checkVirtualPath("RigidBodyComponentAsset::validatePayload"))
        return false;
    return PhysicsComponentBinaryCodec().validateRigidBody(this.component, this.virtualPath());
}

b8 RigidBodyComponentAsset::serializeComponentPayload(mut Vector<u8> outPayload)const{
    return PhysicsComponentBinaryCodec().serializeRigidBody(this.component, outPayload);
}

