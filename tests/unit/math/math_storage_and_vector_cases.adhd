ThrowingStreamLoadResult<SIMDVectorSingle> LoadFloat(const SingleStreamLoadInput&)noexcept{ return {}; }

ThrowingStreamLoadResult<SIMDVectorDouble> LoadDouble(const DoubleStreamLoadInput&)noexcept{ return {}; }

NWB_NOINLINE SIMDVectorSingle FrozenPower(const SIMDVectorSingle x, const SIMDVectorSingle y)noexcept{
    return VectorSet(Pow(VectorGetX(x), VectorGetX(y)), Pow(VectorGetY(x), VectorGetY(y)), Pow(VectorGetZ(x), VectorGetZ(y)), Pow(VectorGetW(x), VectorGetW(y)));
}

NWB_NOINLINE SIMDVectorSingle CurrentPower(const SIMDVectorSingle x, const SIMDVectorSingle y)noexcept{
    return VectorPow(x, y);
}

Expected<PowerObservation> ObservePower(const NotNull<PowerEvaluate> evaluate, const SIMDVectorSingle x, const SIMDVectorSingle y, const i32 initialFlags, [[maybe_unused]] const u64 initialNativeFlags)noexcept{
#pragma STDC FENV_ACCESS ON
#if defined(NWB_PLATFORM_WINDOWS) && defined(NWB_HAS_NEON64) && !defined(_M_ARM64EC)
    const u64 clearNativeStatus = 0u;
    __asm__ __volatile__("msr fpsr, %0" : : "r"(clearNativeStatus));
#endif
#if defined(NWB_PLATFORM_WINDOWS)
    _clearfp();
#endif
    if(!ClearFloatingPointExceptions(FE_ALL_EXCEPT) || !RaiseFloatingPointExceptions(initialFlags))
        return MakeUnexpected(Failure{});
#if defined(NWB_PLATFORM_WINDOWS) && defined(NWB_HAS_NEON64) && !defined(_M_ARM64EC)
    u64 seededNativeStatus{};
    __asm__ __volatile__("mrs %0, fpsr" : "=r"(seededNativeStatus));
    seededNativeStatus |= initialNativeFlags;
    __asm__ __volatile__("msr fpsr, %0" : : "r"(seededNativeStatus));
#endif
    errno = E2BIG;
    const SIMDVectorSingle value = evaluate.get()(x, y);
    const i32 errCode = errno;
    const i32 flags = TestFloatingPointExceptions(FE_ALL_EXCEPT);
    u32 nativeStatus = 0u;
#if defined(NWB_PLATFORM_WINDOWS)
    nativeStatus = _statusfp();
#endif
    u64 rawNativeStatus{};
#if defined(NWB_PLATFORM_WINDOWS) && defined(NWB_HAS_NEON64) && !defined(_M_ARM64EC)
    __asm__ __volatile__("mrs %0, fpsr" : "=r"(rawNativeStatus));
#endif
    return PowerObservation{ value, rawNativeStatus, flags, errCode, nativeStatus };
}

#pragma STDC FENV_ACCESS OFF
NWB_NOINLINE f32 LegacyMultiplyAddExpression(const f32 first, const f32 second, const f32 addend)noexcept{
    return first * second + addend;
}

NWB_NOINLINE f64 LegacyDoubleMultiplyAddExpression(const f64 first, const f64 second, const f64 addend)noexcept{
    return first * second + addend;
}

NWB_NOINLINE f32 LegacyNegativeMultiplySubtractExpression(const f32 first, const f32 second, const f32 addend)noexcept{
    return addend - first * second;
}

NWB_NOINLINE f64 LegacyDoubleMultiplyThenAdd(const f64 first, const f64 second, const f64 addend)noexcept{
    const f64 product = first * second;
    return product + addend;
}

NWB_NOINLINE SIMDVectorDouble DoubleMultiplyAddExpression(const SIMDVectorDouble first, const SIMDVectorDouble second, const SIMDVectorDouble addend)noexcept{
    return first * second + addend;
}

NWB_NOINLINE SIMDVectorDouble DoubleMultiplyThenAdd(const SIMDVectorDouble first, const SIMDVectorDouble second, const SIMDVectorDouble addend)noexcept{
    const SIMDVectorDouble product = first * second;
    return product + addend;
}


