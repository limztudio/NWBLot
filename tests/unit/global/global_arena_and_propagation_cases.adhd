void VerifyAllocatorPropagation_OrderedMapSwapsTransferNodesAndTheirArena(){
    Array<b8, 2> flags = Array<b8, 2>();
    flags[0u] = false;
    flags[1u] = true;
    for(in b8 foreignArena : flags){
        const Name firstOwner = s_GlobalArenaCaseAllocatorPropagationOrderedSwapFirst;
        const Name secondOwner = s_GlobalArenaCaseAllocatorPropagationOrderedSwapSecond;
        native(in foreignArena, in firstOwner, in secondOwner){
            using NWB::Core::Alloc::GlobalArena;
            GlobalArena firstArena{ firstOwner };
            GlobalArena secondArena{ secondOwner };
            GlobalArena& secondOwnerRef = foreignArena ? secondArena : firstArena;
            {
                ::Map<u32, u32, GlobalArena> first{ firstArena };
                ::Map<u32, u32, GlobalArena> second{ secondOwnerRef };
                for(u32 key = 0u; key < 16u; ++key)
                    ASSERT_TRUE(first.emplace(key, key * 3u).second);
                for(u32 key = 100u; key < 132u; ++key)
                    ASSERT_TRUE(second.emplace(key, key * 5u).second);
                const NotNull<const u32*> firstNode = MakeNotNull(&first.find(0u)->second);
                const NotNull<const u32*> secondNode = MakeNotNull(&second.find(100u)->second);
                first.swap(second);
                EXPECT_EQ(first.get_allocator().arenaPtr(), &secondOwnerRef);
                EXPECT_EQ(second.get_allocator().arenaPtr(), &firstArena);
                ASSERT_EQ(first.size(), 32u);
                ASSERT_EQ(second.size(), 16u);
                EXPECT_EQ(&first.find(100u)->second, secondNode.get());
                EXPECT_EQ(&second.find(0u)->second, firstNode.get());
                for(u32 key = 100u; key < 132u; ++key)
                    EXPECT_EQ(first.at(key), key * 5u);
                for(u32 key = 0u; key < 16u; ++key)
                    EXPECT_EQ(second.at(key), key * 3u);
                ASSERT_TRUE(first.emplace(999u, 7u).second);
                ASSERT_TRUE(second.emplace(888u, 9u).second);
            }
            EXPECT_EQ(firstArena.memoryStats().usedBytes, 0u);
            EXPECT_EQ(secondArena.memoryStats().usedBytes, 0u);
            EXPECT_EQ(firstArena.memoryStats().allocationCount, firstArena.memoryStats().deallocationCount);
            EXPECT_EQ(secondArena.memoryStats().allocationCount, secondArena.memoryStats().deallocationCount);
        }
    }
}

void VerifyAllocatorPropagation_HashMapSwapsAndMovesPreserveArenaAndSourceReuse(){
    Array<b8, 2> flags = Array<b8, 2>();
    flags[0u] = false;
    flags[1u] = true;
    for(in b8 foreignArena : flags){
        const Name firstOwner = s_GlobalArenaCaseAllocatorPropagationHashMapFirst;
        const Name secondOwner = s_GlobalArenaCaseAllocatorPropagationHashMapSecond;
        native(in foreignArena, in firstOwner, in secondOwner){
            using NWB::Core::Alloc::GlobalArena;
            GlobalArena firstArena{ firstOwner };
            GlobalArena secondArena{ secondOwner };
            GlobalArena& secondOwnerRef = foreignArena ? secondArena : firstArena;
            {
                ::HashMap<u32, u32, GlobalArena> first{ firstArena };
                ::HashMap<u32, u32, GlobalArena> second{ secondOwnerRef };
                for(u32 key = 0u; key < 64u; ++key)
                    ASSERT_TRUE(first.emplace(key, key * 3u).second);
                for(u32 key = 100u; key < 132u; ++key)
                    ASSERT_TRUE(second.emplace(key, key * 5u).second);
                const NotNull<const u32*> firstStorage = MakeNotNull(&first.at(0u));
                const NotNull<const u32*> secondStorage = MakeNotNull(&second.at(100u));
                first.swap(second);
                EXPECT_EQ(first.get_allocator().arenaPtr(), &secondOwnerRef);
                EXPECT_EQ(second.get_allocator().arenaPtr(), &firstArena);
                ASSERT_EQ(first.size(), 32u);
                ASSERT_EQ(second.size(), 64u);
                EXPECT_EQ(&first.at(100u), secondStorage.get());
                EXPECT_EQ(&second.at(0u), firstStorage.get());
                first = Move(second);
                EXPECT_EQ(first.get_allocator().arenaPtr(), &firstArena);
                ASSERT_EQ(first.size(), 64u);
                EXPECT_EQ(&first.at(0u), firstStorage.get());
                EXPECT_TRUE(second.empty());
                for(u32 key = 0u; key < 64u; ++key)
                    EXPECT_EQ(first.at(key), key * 3u);
                first.reserve(256u);
                ASSERT_TRUE(first.emplace(999u, 7u).second);
                second.reserve(64u);
                ASSERT_TRUE(second.emplace(888u, 9u).second);
                EXPECT_EQ(second.at(888u), 9u);
                EXPECT_EQ(first.at(999u), 7u);
            }
            EXPECT_EQ(firstArena.memoryStats().usedBytes, 0u);
            EXPECT_EQ(secondArena.memoryStats().usedBytes, 0u);
            EXPECT_EQ(firstArena.memoryStats().allocationCount, firstArena.memoryStats().deallocationCount);
            EXPECT_EQ(secondArena.memoryStats().allocationCount, secondArena.memoryStats().deallocationCount);
        }
    }
}

void VerifyAllocatorPropagation_HashSetSwapsAndMovesPreserveArenaAndSourceReuse(){
    Array<b8, 2> flags = Array<b8, 2>();
    flags[0u] = false;
    flags[1u] = true;
    for(in b8 foreignArena : flags){
        const Name firstOwner = s_GlobalArenaCaseAllocatorPropagationHashSetFirst;
        const Name secondOwner = s_GlobalArenaCaseAllocatorPropagationHashSetSecond;
        native(in foreignArena, in firstOwner, in secondOwner){
            using NWB::Core::Alloc::GlobalArena;
            GlobalArena firstArena{ firstOwner };
            GlobalArena secondArena{ secondOwner };
            GlobalArena& secondOwnerRef = foreignArena ? secondArena : firstArena;
            {
                ::HashSet<u32, GlobalArena> first{ firstArena };
                ::HashSet<u32, GlobalArena> second{ secondOwnerRef };
                for(u32 key = 0u; key < 64u; ++key)
                    ASSERT_TRUE(first.insert(key).second);
                for(u32 key = 100u; key < 132u; ++key)
                    ASSERT_TRUE(second.insert(key).second);
                const NotNull<const u32*> firstStorage = MakeNotNull(&*first.find(0u));
                const NotNull<const u32*> secondStorage = MakeNotNull(&*second.find(100u));
                first.swap(second);
                EXPECT_EQ(first.get_allocator().arenaPtr(), &secondOwnerRef);
                EXPECT_EQ(second.get_allocator().arenaPtr(), &firstArena);
                ASSERT_EQ(first.size(), 32u);
                ASSERT_EQ(second.size(), 64u);
                EXPECT_EQ(&*first.find(100u), secondStorage.get());
                EXPECT_EQ(&*second.find(0u), firstStorage.get());
                first = Move(second);
                EXPECT_EQ(first.get_allocator().arenaPtr(), &firstArena);
                ASSERT_EQ(first.size(), 64u);
                EXPECT_EQ(&*first.find(0u), firstStorage.get());
                EXPECT_TRUE(second.empty());
                for(u32 key = 0u; key < 64u; ++key)
                    EXPECT_EQ(first.count(key), 1u);
                first.reserve(256u);
                ASSERT_TRUE(first.insert(999u).second);
                second.reserve(64u);
                ASSERT_TRUE(second.insert(888u).second);
                EXPECT_EQ(second.count(888u), 1u);
                EXPECT_EQ(first.count(999u), 1u);
            }
            EXPECT_EQ(firstArena.memoryStats().usedBytes, 0u);
            EXPECT_EQ(secondArena.memoryStats().usedBytes, 0u);
            EXPECT_EQ(firstArena.memoryStats().allocationCount, firstArena.memoryStats().deallocationCount);
            EXPECT_EQ(secondArena.memoryStats().allocationCount, secondArena.memoryStats().deallocationCount);
        }
    }
}

void VerifyAllocatorPropagation_DefaultProviderAllocatorMovesAwayFromItsInitialOwner(){
    const Name sourceOwner = s_GlobalArenaCaseAllocatorPropagationDefaultSource;
    native(in sourceOwner){
        using namespace __hidden_allocator_propagation_tests;
        GlobalArena sourceArena{ sourceOwner };
        const ArenaMemoryStats defaultBefore = DefaultOwner().memoryStats();
        {
            DefaultVector<u32, GlobalArena, DefaultOwner> target;
            EXPECT_EQ(target.get_allocator().arenaPtr(), &DefaultOwner());
            target.assign(32u, 9u);
            DefaultVector<u32, GlobalArena, DefaultOwner> source{ sourceArena };
            source.assign(64u, 8u);
            target = Move(source);
            EXPECT_EQ(target.get_allocator().arenaPtr(), &sourceArena);
            EXPECT_EQ(target.size(), 64u);
            EXPECT_EQ(target.back(), 8u);
        }
        EXPECT_EQ(sourceArena.memoryStats().usedBytes, 0u);
        EXPECT_EQ(DefaultOwner().memoryStats().usedBytes, defaultBefore.usedBytes);
    }
}

void VerifyGlobal_AutoRegistrationQueueDeduplicatesAndSnapshots(){
    Vector<u32> values = Vector<u32>();
    values.reserve(6u);
    native(mut values){
        ::AutoRegistrationQueue<u32, NWB::Core::Alloc::GlobalArena> queue(NWB::Tests::s_TestArena);
        const auto equal = [](const u32 lhs, const u32 rhs)noexcept{ return lhs == rhs; };

        queue.appendUnique(7u, equal);
        queue.appendUnique(7u, equal);
        queue.appendUnique(19u, equal);

        queue.copyTo(values);
        ASSERT_EQ(values.size(), 2u);
        EXPECT_EQ(values[0u], 7u);
        EXPECT_EQ(values[1u], 19u);

        queue.appendUnique(23u, equal);
        EXPECT_EQ(values.size(), 2u);

        queue.copyTo(values);
    }
    ASSERT_EQ(values.size(), 3u);
    EXPECT_EQ(values[2u], 23u);
}

void VerifyGlobal_GenericPathKeepsNativeFilenameCharacters(){
    native{
        NWB::Core::Alloc::ScratchArena scratchArena(NWB::Tests::s_TestArena);
        const ::Path<NWB::Core::Alloc::ScratchArena> path(scratchArena, "one\\two");
        const auto text = PathToGenericString<char>(scratchArena, path);
#if defined(NWB_PLATFORM_WINDOWS)
        EXPECT_EQ(AStringView(text), "one/two");
#else
        EXPECT_EQ(AStringView(text), "one\\two");
#endif
    }
}

void VerifyGlobal_BoundedRuntimeWrappersTerminateTruncatedText(){
    native{
#if !defined(_MSC_VER)
        Array<char, 4u> truncatedText = {};
        EXPECT_NE(NWB_STRCPY(truncatedText.data(), sizeof(truncatedText), "abcdef"), 0);
        EXPECT_STREQ(truncatedText.data(), "abc");

        Array<char, 4u> nullTerminatedText = { 'a', 'b', 'c', 'd' };
        EXPECT_NE(NWB_STRCAT(nullTerminatedText.data(), sizeof(nullTerminatedText), "e"), 0);
        EXPECT_EQ(nullTerminatedText[sizeof(nullTerminatedText) - 1u], '\0');
#endif
    }
}

void VerifyGlobal_UnicodeAndAsciiHelpersRejectSurrogatesOverlongsAndInvalidIdentifiers(){
    EXPECT_FALSE(IsUtf16HighSurrogate(0xD7FFu));
    EXPECT_TRUE(IsUtf16HighSurrogate(0xD800u));
    EXPECT_TRUE(IsUtf16HighSurrogate(0xDBFFu));
    EXPECT_FALSE(IsUtf16HighSurrogate(0xDC00u));
    EXPECT_FALSE(IsUtf16LowSurrogate(0xDBFFu));
    EXPECT_TRUE(IsUtf16LowSurrogate(0xDC00u));
    EXPECT_TRUE(IsUtf16LowSurrogate(0xDFFFu));
    EXPECT_FALSE(IsUtf16LowSurrogate(0xE000u));
    EXPECT_TRUE(IsUnicodeScalarValue(0xD7FFu));
    EXPECT_FALSE(IsUnicodeScalarValue(0xD800u));
    EXPECT_FALSE(IsUnicodeScalarValue(0xDFFFu));
    EXPECT_TRUE(IsUnicodeScalarValue(0xE000u));
    EXPECT_TRUE(IsUnicodeScalarValue(s_UnicodeMaxCodePoint));
    EXPECT_FALSE(IsUnicodeScalarValue(s_UnicodeMaxCodePoint + 1u));
    EXPECT_EQ(DecodeUtf16SurrogatePair(0xD800u, 0xDC00u), 0x10000u);
    EXPECT_EQ(DecodeUtf16SurrogatePair(0xDBFFu, 0xDFFFu), s_UnicodeMaxCodePoint);

    native{
        const Array<char, 4u> bomPrefixed = { static_cast<char>(0xEF), static_cast<char>(0xBB), static_cast<char>(0xBF), 'a' };
        EXPECT_TRUE(HasUtf8Bom(AStringView(bomPrefixed.data(), bomPrefixed.size())));
        EXPECT_FALSE(HasUtf8Bom(AStringView(bomPrefixed.data(), 2u)));

        Array<char, s_Utf8MaxSequenceBytes> encoded = {};
        EXPECT_FALSE(EncodeUtf8CodePoint(0xD800u, encoded));
        EXPECT_FALSE(EncodeUtf8CodePoint(s_UnicodeMaxCodePoint + 1u, encoded));
        const auto encodedBytes = EncodeUtf8CodePoint(s_UnicodeMaxCodePoint, encoded);
        ASSERT_TRUE(encodedBytes);
        ASSERT_EQ(*encodedBytes, 4u);
        EXPECT_TRUE(IsUtf8ScalarBoundary(AStringView(encoded.data(), encoded.size()), 0u));
        EXPECT_FALSE(IsUtf8ScalarBoundary(AStringView(encoded.data(), encoded.size()), 1u));
        EXPECT_TRUE(IsUtf8ScalarBoundary(AStringView(encoded.data(), encoded.size()), 4u));
        EXPECT_FALSE(IsUtf8ScalarBoundary(AStringView(encoded.data(), encoded.size()), 5u));

        const auto decoded = DecodeUtf8Scalar(AStringView(encoded.data(), encoded.size()));
        ASSERT_TRUE(decoded);
        EXPECT_EQ(decoded->codePoint, s_UnicodeMaxCodePoint);
        EXPECT_EQ(decoded->byteCount, 4);
        EXPECT_FALSE(DecodeUtf8Scalar(AStringView(encoded.data(), 3u)));
        const Array<char, 3u> surrogateBytes = { static_cast<char>(0xED), static_cast<char>(0xA0), static_cast<char>(0x80) };
        EXPECT_FALSE(DecodeUtf8Scalar(AStringView(surrogateBytes.data(), surrogateBytes.size())));
    }

    EXPECT_TRUE(IsUnicodeWhitespace(0x2000u));
    EXPECT_TRUE(IsUnicodeWhitespace(0x200au));
    EXPECT_FALSE(IsUnicodeWhitespace(0x1fffu));
    EXPECT_FALSE(IsUnicodeWhitespace(0x200bu));
    EXPECT_TRUE(IsUnicodeWhitespace(0xa0u));
    EXPECT_FALSE(IsUnicodeWhitespace(0x180eu));
    EXPECT_TRUE(IsAsciiPunctuation(0x21u));
    EXPECT_TRUE(IsAsciiPunctuation(0x7eu));
    EXPECT_FALSE(IsAsciiPunctuation(0x20u));
    EXPECT_FALSE(IsAsciiPunctuation(0x7fu));
    EXPECT_EQ(StripMatchingTrailingByte("f", 102u, 70u), "f");
    EXPECT_EQ(StripMatchingTrailingByte("4F", 102u, 70u), "4");

    usize tokenCursor = 0u;
    const Expected<StringView> token = ReadCommaOrSpaceDelimitedToken(" , x,,", tokenCursor);
    ASSERT_TRUE(token.has_value());
    EXPECT_EQ(token.value(), "x");
    EXPECT_EQ(tokenCursor, 4u);
    const Expected<StringView> exhaustedToken = ReadCommaOrSpaceDelimitedToken(" , x,,", tokenCursor);
    EXPECT_FALSE(exhaustedToken.has_value());
    EXPECT_EQ(tokenCursor, 6u);

    const Expected<u32> alignedMax = AlignU32PowerOfTwoChecked(u32.max - 3u, 4u);
    ASSERT_TRUE(alignedMax.has_value());
    EXPECT_EQ(alignedMax.value(), u32.max - 3u);
    EXPECT_FALSE(AlignU32PowerOfTwoChecked(u32.max, 4u).has_value());
    EXPECT_FALSE(AlignU32PowerOfTwoChecked(1u, 3u).has_value());

    const Expected<u64> zeroStrideRange = ComputeStridedRangeByteSize(0u, u64.max, u64.max);
    const Expected<u64> twoZeroStrideRange = ComputeStridedRangeByteSize(2u, 0u, u64.max);
    ASSERT_TRUE(zeroStrideRange.has_value());
    ASSERT_TRUE(twoZeroStrideRange.has_value());
    EXPECT_EQ(zeroStrideRange.value(), 0u);
    EXPECT_EQ(twoZeroStrideRange.value(), u64.max);
    EXPECT_FALSE(ComputeStridedRangeByteSize(2u, 1u, u64.max).has_value());
    EXPECT_EQ(MultiplySaturatingU64(u64.max, 0u), 0u);
    EXPECT_EQ(MultiplySaturatingU64(u64.max, 2u), u64.max);
    EXPECT_EQ(SaturateI64ToI32(i64.min), i32.min);
    EXPECT_EQ(SaturateI64ToI32(i64.max), i32.max);
    EXPECT_TRUE(IsRelativeSlashPathWithoutDotSegments("c:segment/file"));
    EXPECT_FALSE(IsRelativeSlashPathWithoutDotSegments("a/../b"));
    EXPECT_FALSE(IsRelativeSlashPathWithoutDotSegments("a//b"));
    EXPECT_FALSE(IsRelativeSlashPathWithoutDotSegments("a\\b"));
    EXPECT_FALSE(FitsFixedText(StringView(), 0u));
    EXPECT_TRUE(FitsFixedText(StringView(), 1u));
    native{
        EXPECT_FALSE(FitsFixedText(AStringView("a\0b", 3u), 4u));
        EXPECT_FALSE(TryFiniteF32FromF64(Limit<f64>::s_Infinity));
        EXPECT_FALSE(TryFiniteF32FromF64(static_cast<f64>(Limit<f32>::s_Max) * 2.0));
    }
    const Expected<f32> negZero = ParseFiniteF32ViaF64("-0.0");
    ASSERT_TRUE(negZero.has_value());
    EXPECT_EQ(bit_cast<u32>(negZero.value()), 0x80000000u);
    EXPECT_FALSE(IsAsciiIdentifier(StringView()));
    EXPECT_FALSE(IsAsciiIdentifier(StringView("9abc")));
    EXPECT_FALSE(IsAsciiIdentifier(StringView("a-b")));
    EXPECT_TRUE(IsAsciiIdentifier(StringView("_a9")));
    EXPECT_EQ(ToAsciiLowerByte(0xC3u), 0xC3u);
    EXPECT_NE(ToAsciiLowerByte(cast<u8>(92u)), ToAsciiLowerByte(cast<u8>(47u)));
}

void VerifyGlobal_OwnershipInvariantTerminationIsAlwaysActive(){
    EXPECT_DEATH(TerminateInvariant(), "");
}

