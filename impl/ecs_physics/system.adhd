    public b8 stepGpuResidentBodies(in f32 dt, in u32 subStepCount, in b8 readbackToWorld){
        const b8 ok = this.m_gpuDispatcher.stepGpuResidentBodies(this.m_physicsWorld, dt, subStepCount, readbackToWorld);
        if(ok){
            this.m_lastStepStats = this.m_physicsWorld.lastStepStats();
            this.m_lastStepTopologyVersion = this.m_physicsWorld.m_topologyVersion;
        }
        return ok;
    }

    public void reset(){
        this.m_physicsWorld.clear();
        this.m_gpuDispatcher.invalidateWorldCaches();
        this.m_collisionLayerMatrix = CollisionLayerMatrix();
        this.m_preStepCallback.reset();
        this.clearEventCallbacks();
        this.m_entityRecords.clear();
        this.m_entityJoints.clear();
        for(auto fracIt = this.m_activeFractures.begin(); fracIt != this.m_activeFractures.end(); ++fracIt)
            DestroyTrackedFractureChunkEntities(this.m_world, fracIt.value());
        this.m_activeRagdolls.clear();
        this.m_activeFractures.clear();
        this.m_environmentScratch = PhysicsEnvironment();
        this.m_bodyTransformSnapshots.clear();
        this.m_bodyTransformSnapshotMeta.clear();
        this.m_bodyIndexToEntity.clear();
        this.m_shapeIndexToEntity.clear();
        this.m_jointIndexToEntity.clear();
        this.m_scopedNames = EcsScopedEntityNames();
        this.m_syncedRigidBodyTags.clear();
        this.m_syncedColliderTags.clear();
        this.m_syncScratch = EcsPhysicsSyncScratch();
        ReleaseEcsPhysicsAssetCache(this.m_assetCache, this.m_physicsWorld, false);
        this.m_syncScratch.failedRagdollAssets.clear();
        this.m_syncScratch.failedFractureAssets.clear();
        this.m_exportBindingsScratch.clear();
        this.m_exportCustomPosesScratch.clear();
        this.m_batchSingleBindingsScratch.clear();
        this.m_batchExportTargetsScratch.clear();
        this.m_gpuResidentEventsScratch.clear();
        this.m_prevGpuResidentContactPairs.clear();
        this.m_currGpuResidentContactPairs.clear();
        this.m_prevGpuResidentSensorPairs.clear();
        this.m_currGpuResidentSensorPairs.clear();
        this.m_pendingCpuWakeBodiesScratch.clear();
        this.clearFrameEvents();
        this.m_publishEventsToMessageBus = false;
        this.m_publishContinuousEventsToMessageBus = false;
        this.m_cfgPublishEventsToMessageBus = false;
        this.m_cfgPublishContinuousEventsToMessageBus = false;
        this.m_accumulator = 0.0f;
        this.m_interpolationAlpha = 1.0f;
        this.m_pendingSingleStep = false;
        this.m_hasAnyPhysicsParents = false;
        this.m_hasActiveInstanceTransformPatches = false;
        this.m_activeInstanceTransformPatchMembershipSig = 0u;
        this.m_lastStepStats = WorldStepStats();
        this.m_lastStepMs = 0.0;
        this.m_lastStepTopologyVersion = 0u;
    }

    public b8 exportRenderTransforms(mut Vector<GpuPhysicsRenderTransformOut> outTransforms){
        const b8 hasAnyPhysicsParents = RefreshPhysicsHierarchyCache(this.m_world, this.m_syncScratch);
        if(hasAnyPhysicsParents)
            this.m_syncScratch.writeBackPoseCache.clear();
        const b8 bodyHandlesTrusted = this.m_syncScratch.hasSyncedTopologyVersion && (this.m_physicsWorld.m_topologyVersion == this.m_syncScratch.lastSyncedTopologyVersion);
        this.m_exportCustomPosesScratch.clear();
        CollectEcsGpuRenderTransformBindings(
            this.m_world,
            this.m_entityRecords,
            this.m_bodyIndexToEntity,
            hasAnyPhysicsParents,
            bodyHandlesTrusted,
            this.m_syncScratch.writeBackPoseCache,
            this.m_physicsWorld,
            this.m_gpuDispatcher,
            this.m_exportBindingsScratch,
            this.m_exportCustomPosesScratch
        );
        return this.m_gpuDispatcher.exportRenderTransforms(
            this.m_physicsWorld,
            Span<GpuPhysicsRenderTransformBinding>(this.m_exportBindingsScratch.data(), this.m_exportBindingsScratch.size()),
            Span<GpuPhysicsBodyPose>(this.m_exportCustomPosesScratch.data(), this.m_exportCustomPosesScratch.size()),
            outTransforms
        );
    }

    public b8 syncGpuResidentToWorld(){
        if(!this.m_gpuDispatcher.isGpuResidentDirtyCpu())
            return true;
        this.m_gpuDispatcher.syncGpuResidentToWorld(this.m_physicsWorld);
        PreparePrevEcsBodyTransformSnapshots(
            this.m_physicsWorld,
            this.m_physicsWorld.bodyMoveEvents(),
            this.m_syncScratch.dirtyPrevSnapshotBodyIndices,
            this.m_syncScratch.snapshotBodyStamps,
            this.m_syncScratch.snapshotStamp,
            this.m_bodyTransformSnapshots,
            this.m_bodyTransformSnapshotMeta
        );
        WriteBackPhysicsTransformsToEcs(
            this.m_physicsWorld,
            this.m_physicsWorld.bodyMoveEvents(),
            this.m_bodyIndexToEntity,
            this.m_hasAnyPhysicsParents,
            true,
            false,
            1.0f,
            this.m_world,
            this.m_syncScratch,
            this.m_bodyTransformSnapshots,
            this.m_bodyTransformSnapshotMeta
        );
        return true;
    }

    public b8 prepareInstanceTransformPatches()override{
        const u32 residentCount = this.m_gpuDispatcher.liveResidentBodyCount(this.m_physicsWorld);
        const u32 exportCount = cast<u32>(this.m_world.view<GpuRenderTransformExportComponent>().candidateCount());
        const u32 activeCandidates = residentCount + exportCount;
        this.m_hasActiveInstanceTransformPatches = (activeCandidates > 0u);
        if(!this.m_hasActiveInstanceTransformPatches){
            this.m_activeInstanceTransformPatchMembershipSig = 0u;
            return true;
        }
        u64 sig = 14695981039346656037u;
        sig = UpdateFnv64U64(sig, this.m_gpuDispatcher.residentPatchMembershipSignature(this.m_physicsWorld));
        sig = UpdateFnv64U32(sig, exportCount);
        sig = UpdateFnv64U64(sig, this.m_world.componentMutationVersion<GpuRenderTransformExportComponent>());
        sig = UpdateFnv64U64(sig, this.m_world.componentMutationVersion<RigidBodyComponent>());
        sig = UpdateFnv64U64(sig, this.m_world.componentMutationVersion<PhysicsParentComponent>());
        sig = UpdateFnv64U64(sig, this.m_world.componentMutationVersion<CharacterControllerComponent>());
        sig = UpdateFnv64U64(sig, this.m_world.componentMutationVersion<VehicleComponent>());
        sig = UpdateFnv64U64(sig, this.m_world.componentMutationVersion<RagdollComponent>());
        sig = UpdateFnv64U64(sig, this.m_world.componentMutationVersion<ArticulationComponent>());
        sig = UpdateFnv64U64(sig, this.m_world.componentMutationVersion<FractureComponent>());
        sig = UpdateFnv64U64(sig, this.m_physicsWorld.m_topologyVersion);
        if(sig == 0u)
            sig = 1u;
        this.m_activeInstanceTransformPatchMembershipSig = sig;
        this.m_syncScratch.writeBackPoseCache.clear();
        return this.m_gpuDispatcher.beginRenderExportFrame(activeCandidates * 6u, activeCandidates * 3u);
    }

    public b8 hasActiveInstanceTransformPatches()const override{
        return this.m_hasActiveInstanceTransformPatches;
    }

    public u64 instanceTransformPatchMembershipSignature()const override{
        return this.m_activeInstanceTransformPatchMembershipSig;
    }

    public Expected<GpuTaskId> declareBatchInstanceTransformPatches(
        in Span<GpuTaskGraphInstanceTransformPatchRequest> requests,
        in Span<u32> packedEntityIds,
        in Span<u32> entityIdOffsets,
        in Span<u32> entityIdCounts,
        in Name batchIdentityPrefix,
        in GpuTaskId dependency,
        in b8 mergeWithPrevious,
        in b8 allowMergeAcrossConsumerFrontier,
        mut GpuTaskGraph graph
    )override{
        if(!this.m_hasActiveInstanceTransformPatches || requests.empty() || packedEntityIds.empty())
            return Expected<GpuTaskId>(dependency);
        if(entityIdOffsets.size() != requests.size() || entityIdCounts.size() != requests.size())
            return MakeUnexpected(Failure());

        const b8 hasAnyPhysicsParents = RefreshPhysicsHierarchyCache(this.m_world, this.m_syncScratch);
        const b8 bodyHandlesTrusted = this.m_syncScratch.hasSyncedTopologyVersion && (this.m_physicsWorld.m_topologyVersion == this.m_syncScratch.lastSyncedTopologyVersion);

        this.m_exportBindingsScratch.clear();
        this.m_exportCustomPosesScratch.clear();
        this.m_batchExportTargetsScratch.clear();

        Vector<u32> uniqueIdOffsets;
        Vector<u32> uniqueIdCounts;
        Vector<u32> uniqueBindOffsets;
        Vector<u32> uniqueBindCounts;
        uniqueIdOffsets.reserve(requests.size());
        uniqueIdCounts.reserve(requests.size());
        uniqueBindOffsets.reserve(requests.size());
        uniqueBindCounts.reserve(requests.size());

        for(usize ri = 0u; ri < requests.size(); ++ri){
            in GpuTaskGraphInstanceTransformPatchRequest req = requests[ri];
            const u32 idOff = entityIdOffsets[ri];
            const u32 idCnt = entityIdCounts[ri];
            if(idCnt == 0u)
                continue;
            if(idOff > cast<u32>(packedEntityIds.size()) || idCnt > cast<u32>(packedEntityIds.size()) - idOff)
                return MakeUnexpected(Failure());

            u32 exportMode = s_GpuExportModePatchInstanceBuffer;
            if(req.layout == GpuTaskGraphInstanceTransformPatchLayout::Affine3x4ObjectToWorld)
                exportMode = s_GpuExportModePatchAffine3x4ObjToWorld;
            else if(req.layout == GpuTaskGraphInstanceTransformPatchLayout::Affine3x4WorldToObject)
                exportMode = s_GpuExportModePatchAffine3x4WorldToObj;
            else if(req.layout != GpuTaskGraphInstanceTransformPatchLayout::InstanceTrs)
                return MakeUnexpected(Failure());

            usize sliceIdx = uniqueIdOffsets.size();
            for(usize ui = 0u; ui < uniqueIdOffsets.size(); ++ui){
                if(uniqueIdOffsets[ui] == idOff && uniqueIdCounts[ui] == idCnt){
                    sliceIdx = ui;
                    break;
                }
            }
            if(sliceIdx == uniqueIdOffsets.size()){
                CollectEcsPassGpuRenderTransformBindings(
                    packedEntityIds.subspan(idOff, idCnt),
                    this.m_entityRecords,
                    this.m_bodyIndexToEntity,
                    hasAnyPhysicsParents,
                    bodyHandlesTrusted,
                    this.m_physicsWorld,
                    this.m_gpuDispatcher,
                    this.m_world,
                    this.m_syncScratch.writeBackPoseCache,
                    this.m_batchSingleBindingsScratch,
                    this.m_exportCustomPosesScratch
                );
                const u32 bOff = cast<u32>(this.m_exportBindingsScratch.size());
                const u32 bCnt = cast<u32>(this.m_batchSingleBindingsScratch.size());
                for(usize bi = 0u; bi < this.m_batchSingleBindingsScratch.size(); ++bi)
                    this.m_exportBindingsScratch.push_back(this.m_batchSingleBindingsScratch[bi]);
                uniqueIdOffsets.push_back(idOff);
                uniqueIdCounts.push_back(idCnt);
                uniqueBindOffsets.push_back(bOff);
                uniqueBindCounts.push_back(bCnt);
            }

            const u32 bindCnt = uniqueBindCounts[sliceIdx];
            if(bindCnt == 0u)
                continue;

            PhysicsBatchExportTargetInput targetInput;
            targetInput.targetResource = req.instanceBufferResource;
            targetInput.targetUavSlot = req.instanceBufferUavSlot;
            targetInput.instanceStrideFloat4 = req.instanceStrideFloat4;
            targetInput.exportMode = exportMode;
            targetInput.baseFloat4Offset = req.baseFloat4Offset;
            targetInput.bindingOffset = uniqueBindOffsets[sliceIdx];
            targetInput.bindingCount = bindCnt;
            this.m_batchExportTargetsScratch.push_back(targetInput);
        }

        if(this.m_batchExportTargetsScratch.empty())
            return Expected<GpuTaskId>(dependency);

        GpuTaskId outTaskId;
        if(!this.m_gpuDispatcher.declareBatchExportRenderTransformsTasks(
            graph,
            this.m_physicsWorld,
            Span<GpuPhysicsRenderTransformBinding>(this.m_exportBindingsScratch.data(), this.m_exportBindingsScratch.size()),
            Span<GpuPhysicsBodyPose>(this.m_exportCustomPosesScratch.data(), this.m_exportCustomPosesScratch.size()),
            Span<PhysicsBatchExportTargetInput>(this.m_batchExportTargetsScratch.data(), this.m_batchExportTargetsScratch.size()),
            batchIdentityPrefix,
            mergeWithPrevious,
            allowMergeAcrossConsumerFrontier,
            dependency,
            outTaskId
        ))
            return MakeUnexpected(Failure());
        return Expected<GpuTaskId>(outTaskId);
    }

    private void resolveGpuResidentFallbackContactPair(
        in u32 shapeIdxA,
        in u32 shapeIdxB,
        mut Vector<u8> outMovedBodies
    ){
        if(shapeIdxA >= this.m_physicsWorld.m_shapes.size() || shapeIdxB >= this.m_physicsWorld.m_shapes.size() || shapeIdxA == shapeIdxB)
            return;
        in Shape sA = this.m_physicsWorld.m_shapes[shapeIdxA];
        in Shape sB = this.m_physicsWorld.m_shapes[shapeIdxB];
        if(!sA.alive() || !sB.alive() || sA.isSensor() || sB.isSensor())
            return;
        const u32 bodyIdA = sA.bodyId;
        const u32 bodyIdB = sB.bodyId;
        if(bodyIdA == bodyIdB || bodyIdA >= this.m_physicsWorld.m_bodies.size() || bodyIdB >= this.m_physicsWorld.m_bodies.size())
            return;
        if(!this.m_physicsWorld.m_bodies[bodyIdA].alive || !this.m_physicsWorld.m_bodies[bodyIdB].alive)
            return;

        if(
            this.m_physicsWorld.m_bodies[bodyIdA].type == BodyType::Dynamic
            && this.m_physicsWorld.m_bodies[bodyIdA].setIndex != s_AwakeSetIndex
            && this.m_physicsWorld.m_bodies[bodyIdA].setIndex != s_StaticSetIndex
            && this.m_physicsWorld.m_bodies[bodyIdA].setIndex != s_DisabledSetIndex
        )
            this.m_physicsWorld.wakeBody(this.m_physicsWorld.makeBodyId(bodyIdA));
        if(
            this.m_physicsWorld.m_bodies[bodyIdB].type == BodyType::Dynamic
            && this.m_physicsWorld.m_bodies[bodyIdB].setIndex != s_AwakeSetIndex
            && this.m_physicsWorld.m_bodies[bodyIdB].setIndex != s_StaticSetIndex
            && this.m_physicsWorld.m_bodies[bodyIdB].setIndex != s_DisabledSetIndex
        )
            this.m_physicsWorld.wakeBody(this.m_physicsWorld.makeBodyId(bodyIdB));

        in Body bA = this.m_physicsWorld.m_bodies[bodyIdA];
        in Body bB = this.m_physicsWorld.m_bodies[bodyIdB];
        if(bA.setIndex >= this.m_physicsWorld.m_solverSets.size() || bB.setIndex >= this.m_physicsWorld.m_solverSets.size())
            return;
        if(bA.localIndex >= this.m_physicsWorld.m_solverSets[bA.setIndex].sims.size() || bB.localIndex >= this.m_physicsWorld.m_solverSets[bB.setIndex].sims.size())
            return;

        const b8 dynA = (bA.type == BodyType::Dynamic) && (bA.setIndex == s_AwakeSetIndex);
        const b8 dynB = (bB.type == BodyType::Dynamic) && (bB.setIndex == s_AwakeSetIndex);
        if(!dynA && !dynB)
            return;

        in BodySim simA0 = this.m_physicsWorld.m_solverSets[bA.setIndex].sims[bA.localIndex];
        in BodySim simB0 = this.m_physicsWorld.m_solverSets[bB.setIndex].sims[bB.localIndex];
        const VectorSingle posA0(simA0.transform.position);
        const VectorSingle rotA0 = SafeNormalizeQuat(VectorSingle(simA0.transform.rotation));
        const VectorSingle posB0(simB0.transform.position);
        const VectorSingle rotB0 = SafeNormalizeQuat(VectorSingle(simB0.transform.rotation));

        const Manifold m = CollideShapePair(
            sA,
            posA0,
            rotA0,
            sB,
            posB0,
            rotB0,
            0.0f,
            this.m_physicsWorld.m_hullShapes,
            this.m_physicsWorld.m_meshShapes,
            this.m_physicsWorld.m_heightfieldShapes,
            this.m_physicsWorld.m_compoundShapes,
            this.m_physicsWorld.m_scaledShapes,
            this.m_physicsWorld.m_chainShapes,
            this.m_physicsWorld.m_sdfShapes
        );
        const u32 pc = m.pointCount();
        if(pc == 0u)
            return;

        f32 mu = 0.6f;
        f32 statMu = 0.6f;
        f32 rest = 0.0f;
        f32 rollRes = 0.0f;
        f32 tanSpd = 0.0f;
        VectorSingle surfVel(0.0f);
        VectorSingle anisoFric(0.0f);
        VectorSingle fDir(1.0f, 0.0f, 0.0f, 0.0f);
        u32 matFlags = 0u;
        CombineResolvedSurfaceMaterialsCore(sA.material, rotA0, sB.material, rotB0, mu, statMu, rest, rollRes, tanSpd, surfVel, anisoFric, fDir, matFlags);

        const VectorSingle n = SafeNormalizeVec3(VectorSingle(m.normalTwist, 0.0f), VectorSingle(0.0f, 1.0f, 0.0f, 0.0f));
        const u32 flagsA = bA.flags;
        const u32 flagsB = bB.flags;
        f32 invMassA = 0.0f;
        if(dynA && (flagsA & 0x07u) != 0x07u)
            invMassA = simA0.invMass();
        f32 invMassB = 0.0f;
        if(dynB && (flagsB & 0x07u) != 0x07u)
            invMassB = simB0.invMass();
        MatrixSingle invIAMat = MatrixSingle(0.0f);
        if(dynA)
            invIAMat = Matrix3MaskAngularLocks(Matrix3FromSymMat3(simA0.invInertiaWorld), flagsA);
        MatrixSingle invIBMat = MatrixSingle(0.0f);
        if(dynB)
            invIBMat = Matrix3MaskAngularLocks(Matrix3FromSymMat3(simB0.invInertiaWorld), flagsB);

        VectorSingle comA = simA0.center();
        VectorSingle rotCurA = rotA0;
        const VectorSingle locCenterA = simA0.localCenter();
        VectorSingle comB = simB0.center();
        VectorSingle rotCurB = rotB0;
        const VectorSingle locCenterB = simB0.localCenter();

        VectorSingle vA(0.0f);
        VectorSingle wA(0.0f);
        if(bA.type != BodyType::Static && bA.localIndex < this.m_physicsWorld.m_solverSets[bA.setIndex].states.size()){
            in BodyState stA = this.m_physicsWorld.m_solverSets[bA.setIndex].states[bA.localIndex];
            vA = VectorSingle(stA.linearVelocity);
            wA = VectorSingle(stA.angularVelocity);
        }
        VectorSingle vB(0.0f);
        VectorSingle wB(0.0f);
        if(bB.type != BodyType::Static && bB.localIndex < this.m_physicsWorld.m_solverSets[bB.setIndex].states.size()){
            in BodyState stB = this.m_physicsWorld.m_solverSets[bB.setIndex].states[bB.localIndex];
            vB = VectorSingle(stB.linearVelocity);
            wB = VectorSingle(stB.angularVelocity);
        }

        u32 deepPi = 0u;
        f32 minSep = s_MaxF32;
        for(u32 pi = 0u; pi < pc; ++pi){
            const f32 sep = m.points[pi].separation();
            if(sep < minSep){
                minSep = sep;
                deepPi = pi;
            }
        }
        b8 posChanged = false;
        if(minSep < -s_LinearSlop){
            const f32 corr = Min((-minSep - s_LinearSlop) * 0.4f, 0.2f);
            const VectorSingle rPosA = (posA0 + m.points[deepPi].anchorA()) - comA;
            const VectorSingle rPosB = (posB0 + m.points[deepPi].anchorB()) - comB;
            const VectorSingle rnPosA = Cross(rPosA, n);
            const VectorSingle rnPosB = Cross(rPosB, n);
            const VectorSingle iRnPosA = Matrix3MulVec(invIAMat, rnPosA);
            const VectorSingle iRnPosB = Matrix3MulVec(invIBMat, rnPosB);
            const f32 kPos = invMassA + invMassB + Vector3Dot(rnPosA, iRnPosA).x + Vector3Dot(rnPosB, iRnPosB).x;
            if(kPos > 1.0e-12f && corr > 0.0f){
                const f32 jp = corr / kPos;
                if(dynA){
                    comA -= ApplyLinearLocks(n * (invMassA * jp), flagsA);
                    rotCurA = SafeNormalizeQuat(IntegrateDeltaQuaternion(rotCurA, ApplyAngularLocks(-iRnPosA * jp, flagsA), 1.0f));
                    posChanged = true;
                }
                if(dynB){
                    comB += ApplyLinearLocks(n * (invMassB * jp), flagsB);
                    rotCurB = SafeNormalizeQuat(IntegrateDeltaQuaternion(rotCurB, ApplyAngularLocks(iRnPosB * jp, flagsB), 1.0f));
                    posChanged = true;
                }
            }
        }

        VectorSingle t1(0.0f);
        VectorSingle t2(0.0f);
        ComputeTangentBasisFromUnitNormal(n, t1, t2);
        f32 tanScale1 = 1.0f;
        f32 tanScale2 = 1.0f;
        if((matFlags & cast<u32>(ContactFlags::HasAnisotropicFriction)) != 0u){
            const VectorSingle projDir = fDir - n * Vector3Dot(fDir, n).x;
            if(Vector3LengthSq(projDir).x > 1.0e-10f){
                t1 = SafeNormalizeVec3(projDir, t1);
                t2 = SafeNormalizeVec3(Cross(n, t1), t2);
            }
            tanScale1 = Max(anisoFric.x, 0.0f);
            tanScale2 = Max(anisoFric.y, 0.0f);
        }
        VectorSingle tanTarget = t1 * tanSpd;
        if((matFlags & cast<u32>(ContactFlags::HasSurfaceVelocity)) != 0u)
            tanTarget += surfVel - n * Vector3Dot(surfVel, n).x;
        const f32 restThreshold = this.m_physicsWorld.m_def.restitutionThreshold;
        const f32 effMaxStatMu = Max(mu, statMu);
        f32 totalJn = 0.0f;

        for(u32 pi = 0u; pi < pc; ++pi){
            const VectorSingle rA = (posA0 + m.points[pi].anchorA()) - simA0.center();
            const VectorSingle rB = (posB0 + m.points[pi].anchorB()) - simB0.center();
            const VectorSingle rnA = Cross(rA, n);
            const VectorSingle rnB = Cross(rB, n);
            const VectorSingle iRnA = Matrix3MulVec(invIAMat, rnA);
            const VectorSingle iRnB = Matrix3MulVec(invIBMat, rnB);
            const f32 kN = invMassA + invMassB + Vector3Dot(rnA, iRnA).x + Vector3Dot(rnB, iRnB).x;
            if(kN <= 1.0e-12f)
                continue;

            const VectorSingle relV = (vB + Cross(wB, rB)) - (vA + Cross(wA, rA));
            const f32 vn = Vector3Dot(relV, n).x;
            if(vn < 0.0f){
                f32 restBias = 0.0f;
                if(vn < -restThreshold)
                    restBias = -rest * vn;
                const f32 jn = Max((-vn + restBias) / kN, 0.0f);
                if(jn > 0.0f){
                    totalJn += jn;
                    if(dynA){
                        vA -= ApplyLinearLocks(n * (invMassA * jn), flagsA);
                        wA -= ApplyAngularLocks(iRnA * jn, flagsA);
                    }
                    if(dynB){
                        vB += ApplyLinearLocks(n * (invMassB * jn), flagsB);
                        wB += ApplyAngularLocks(iRnB * jn, flagsB);
                    }
                    if(effMaxStatMu > 0.0f){
                        const VectorSingle relVPost = (vB + Cross(wB, rB)) - (vA + Cross(wA, rA));
                        const VectorSingle vtVec = (relVPost - n * Vector3Dot(relVPost, n).x) - tanTarget;
                        const f32 vtLen = Sqrt(Vector3LengthSq(vtVec).x);
                        if(vtLen > 1.0e-6f){
                            const VectorSingle tDir = vtVec * (1.0f / vtLen);
                            const f32 d1 = Vector3Dot(tDir, t1).x;
                            const f32 d2 = Vector3Dot(tDir, t2).x;
                            const f32 effAniso = Sqrt(tanScale1 * tanScale1 * d1 * d1 + tanScale2 * tanScale2 * d2 * d2);
                            const VectorSingle rtA = Cross(rA, tDir);
                            const VectorSingle rtB = Cross(rB, tDir);
                            const VectorSingle iRtA = Matrix3MulVec(invIAMat, rtA);
                            const VectorSingle iRtB = Matrix3MulVec(invIBMat, rtB);
                            const f32 kT = invMassA + invMassB + Vector3Dot(rtA, iRtA).x + Vector3Dot(rtB, iRtB).x;
                            if(kT > 1.0e-12f){
                                const f32 uncJt = vtLen / kT;
                                const f32 maxStat = effMaxStatMu * effAniso * jn;
                                f32 jt = uncJt;
                                if(uncJt > maxStat)
                                    jt = Max(mu, 0.0f) * effAniso * jn;
                                if(jt > 0.0f){
                                    if(dynA){
                                        vA += ApplyLinearLocks(tDir * (invMassA * jt), flagsA);
                                        wA += ApplyAngularLocks(iRtA * jt, flagsA);
                                    }
                                    if(dynB){
                                        vB -= ApplyLinearLocks(tDir * (invMassB * jt), flagsB);
                                        wB -= ApplyAngularLocks(iRtB * jt, flagsB);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if(rollRes > 0.0f && totalJn > 0.0f){
            const MatrixSingle rollMass = Matrix3InvertSymmetric(Matrix3Add(invIAMat, invIBMat));
            VectorSingle rollImpulse = -Matrix3MulVec(rollMass, wB - wA);
            const f32 maxRoll = rollRes * totalJn;
            const f32 rLenSq = Vector3LengthSq(rollImpulse).x;
            if(rLenSq > maxRoll * maxRoll && rLenSq > 1.0e-18f)
                rollImpulse = rollImpulse * (maxRoll / Sqrt(rLenSq));
            if(dynA)
                wA -= ApplyAngularLocks(Matrix3MulVec(invIAMat, rollImpulse), flagsA);
            if(dynB)
                wB += ApplyAngularLocks(Matrix3MulVec(invIBMat, rollImpulse), flagsB);
        }

        if(dynA){
            mut BodySim outSimA = this.m_physicsWorld.m_solverSets[bA.setIndex].sims[bA.localIndex];
            mut BodyState outStA = this.m_physicsWorld.m_solverSets[bA.setIndex].states[bA.localIndex];
            outStA.linearVelocity = f32x4(vA, 0.0f);
            outStA.angularVelocity = f32x4(wA, 0.0f);
            if(posChanged){
                const VectorSingle newOriginA = comA - Vector3Rotate(locCenterA, rotCurA);
                outSimA.setCenter(comA);
                outSimA.transform = Transform3D(newOriginA, rotCurA);
                outSimA.invInertiaWorld = SymMat3FromMatrix3(RotateSymMatrix3(rotCurA, Matrix3FromSymMat3(outSimA.invInertiaLocal)));
                const VectorSingle xfPos(outSimA.transform.position);
                const VectorSingle xfRot(outSimA.transform.rotation);
                u32 sId = bA.headShapeId;
                while(sId != s_NullIndex){
                    mut Shape sh = this.m_physicsWorld.m_shapes[sId];
                    if(sh.alive()){
                        VectorSingle aMin(0.0f);
                        VectorSingle aMax(0.0f);
                        ComputeShapeWorldAabbValues(sh, xfPos, xfRot, this.m_physicsWorld.m_hullShapes, this.m_physicsWorld.m_meshShapes, this.m_physicsWorld.m_heightfieldShapes, this.m_physicsWorld.m_compoundShapes, this.m_physicsWorld.m_scaledShapes, this.m_physicsWorld.m_chainShapes, this.m_physicsWorld.m_sdfShapes, aMin, aMax);
                        sh.aabb = Aabb3D(aMin, aMax);
                    }
                    sId = sh.nextShapeId;
                }
            }
            if(cast<usize>(bodyIdA) < outMovedBodies.size())
                outMovedBodies[bodyIdA] = 1u;
        }
        if(dynB){
            mut BodySim outSimB = this.m_physicsWorld.m_solverSets[bB.setIndex].sims[bB.localIndex];
            mut BodyState outStB = this.m_physicsWorld.m_solverSets[bB.setIndex].states[bB.localIndex];
            outStB.linearVelocity = f32x4(vB, 0.0f);
            outStB.angularVelocity = f32x4(wB, 0.0f);
            if(posChanged){
                const VectorSingle newOriginB = comB - Vector3Rotate(locCenterB, rotCurB);
                outSimB.setCenter(comB);
                outSimB.transform = Transform3D(newOriginB, rotCurB);
                outSimB.invInertiaWorld = SymMat3FromMatrix3(RotateSymMatrix3(rotCurB, Matrix3FromSymMat3(outSimB.invInertiaLocal)));
                const VectorSingle xfPos(outSimB.transform.position);
                const VectorSingle xfRot(outSimB.transform.rotation);
                u32 sId = bB.headShapeId;
                while(sId != s_NullIndex){
                    mut Shape sh = this.m_physicsWorld.m_shapes[sId];
                    if(sh.alive()){
                        VectorSingle aMin(0.0f);
                        VectorSingle aMax(0.0f);
                        ComputeShapeWorldAabbValues(sh, xfPos, xfRot, this.m_physicsWorld.m_hullShapes, this.m_physicsWorld.m_meshShapes, this.m_physicsWorld.m_heightfieldShapes, this.m_physicsWorld.m_compoundShapes, this.m_physicsWorld.m_scaledShapes, this.m_physicsWorld.m_chainShapes, this.m_physicsWorld.m_sdfShapes, aMin, aMax);
                        sh.aabb = Aabb3D(aMin, aMax);
                    }
                    sId = sh.nextShapeId;
                }
            }
            if(cast<usize>(bodyIdB) < outMovedBodies.size())
                outMovedBodies[bodyIdB] = 1u;
        }
    }

    private void processGpuResidentStepEvents(in b8 preserveExistingMoveEvents, in b8 processGpuEnvFluids){
        this.m_physicsWorld.m_inStep = true;
        if(!preserveExistingMoveEvents)
            this.m_physicsWorld.m_bodyMoveEvents.clear();
        this.m_physicsWorld.m_contactBeginEvents.clear();
        this.m_physicsWorld.m_contactEndEvents.clear();
        this.m_physicsWorld.m_contactPersistEvents.clear();
        this.m_physicsWorld.m_contactHitEvents.clear();
        this.m_physicsWorld.m_sensorBeginEvents.clear();
        this.m_physicsWorld.m_sensorEndEvents.clear();
        this.m_physicsWorld.m_sensorStayEvents.clear();
        this.m_physicsWorld.m_bodyWakeEvents.clear();
        this.m_physicsWorld.consumePendingEndEvents(this.m_physicsWorld.m_contactEndEvents, this.m_physicsWorld.m_sensorEndEvents);
        this.m_physicsWorld.consumePendingWakeEvents(this.m_physicsWorld.m_bodyWakeEvents);
        this.m_physicsWorld.m_jointBreakEvents.clear();

        this.m_currGpuResidentContactPairs.clear();
        this.m_currGpuResidentSensorPairs.clear();
        this.m_pendingCpuWakeBodiesScratch.clear();

        const usize gpuFluidCount = Min(this.m_environmentScratch.fluids.size(), this.m_syncScratch.envFluidEntitiesScratch.size());
        Vector<Vector<FluidCandidateSample>> gpuFluidSamplesByIdx;
        if(processGpuEnvFluids && gpuFluidCount > 0u)
            gpuFluidSamplesByIdx.resize(gpuFluidCount);

        b8 needsCpuFallbackSync = false;
        Vector<u32> fallbackShapeAs;
        Vector<u32> fallbackShapeBs;
        HashSet<u64> seenFallbackPairs;
        for(usize ei = 0u; ei < this.m_gpuResidentEventsScratch.size(); ++ei){
            in GpuPhysicsEvent ev = this.m_gpuResidentEventsScratch[ei];
            const u32 evType = ev.header.x;
            if(evType == s_GpuEventContactActive){
                const u32 sA = ev.header.y;
                const u32 sB = ev.header.z;
                u32 loS = sA;
                u32 hiS = sB;
                if(sB < sA){
                    loS = sB;
                    hiS = sA;
                }
                const u64 pairKey = (cast<u64>(loS) << 32u) | cast<u64>(hiS);
                this.m_currGpuResidentContactPairs.emplace(pairKey);
            }
            else if(evType == s_GpuEventSensorOverlap){
                const u32 sA = ev.header.y;
                const u32 sB = ev.header.z;
                u32 sensorId = sA;
                u32 visitorId = sB;
                const b8 aIsSensor = (sensorId < this.m_physicsWorld.m_shapes.size() && this.m_physicsWorld.m_shapes[sensorId].isSensor());
                const b8 bIsSensor = (visitorId < this.m_physicsWorld.m_shapes.size() && this.m_physicsWorld.m_shapes[visitorId].isSensor());
                if(!aIsSensor && bIsSensor){
                    sensorId = sB;
                    visitorId = sA;
                }
                else if(aIsSensor && bIsSensor && sB < sA){
                    sensorId = sB;
                    visitorId = sA;
                }
                const u64 pairKey = (cast<u64>(sensorId) << 32u) | cast<u64>(visitorId);
                this.m_currGpuResidentSensorPairs.emplace(pairKey);
            }
            else if(evType == s_GpuEventContactHit){
                ContactHitEvent hitEv;
                hitEv.shapeIdA = this.m_physicsWorld.makeShapeId(ev.header.y);
                hitEv.shapeIdB = this.m_physicsWorld.makeShapeId(ev.header.z);
                hitEv.point = ev.pointImpulse;
                hitEv.normalApproachSpeed = ev.normalApproach;
                this.m_physicsWorld.m_contactHitEvents.push_back(hitEv);
            }
            else if(evType == s_GpuEventJointBreak){
                const u32 jIdx = ev.header.y;
                if(jIdx < this.m_physicsWorld.m_joints.size() && this.m_physicsWorld.m_joints[jIdx].alive()){
                    in Joint jRef = this.m_physicsWorld.m_joints[jIdx];
                    JointBreakEvent jbEv;
                    jbEv.jointId = this.m_physicsWorld.makeJointId(jIdx);
                    jbEv.bodyIdA = this.m_physicsWorld.makeBodyId(jRef.edges[0u].bodyId);
                    jbEv.bodyIdB = this.m_physicsWorld.makeBodyId(jRef.edges[1u].bodyId);
                    jbEv.userData = jRef.userData;
                    jbEv.peakForce = ev.pointImpulse.w;
                    jbEv.peakTorque = ev.normalApproach.w;
                    this.m_physicsWorld.m_jointBreakEvents.push_back(jbEv);
                    this.m_physicsWorld.destroyJointInternal(jIdx);
                }
            }
            else if(evType == s_GpuEventBodySleep){
                const u32 bodyId = this.m_gpuDispatcher.residentBodyIdAtSlot(ev.header.y);
                if(bodyId < this.m_physicsWorld.m_bodies.size() && this.m_physicsWorld.m_bodies[bodyId].alive){
                    BodyWakeEvent sleepEv;
                    sleepEv.bodyId = this.m_physicsWorld.makeBodyId(bodyId);
                    sleepEv.userData = this.m_physicsWorld.m_bodies[bodyId].userData;
                    sleepEv.awake = false;
                    this.m_physicsWorld.m_bodyWakeEvents.push_back(sleepEv);
                }
            }
            else if(evType == s_GpuEventBodyWake){
                if((ev.header.w & s_GpuEventFlagCpuSleepWake) != 0u){
                    this.m_pendingCpuWakeBodiesScratch.push_back(ev.header.y);
                }
                else{
                    const u32 bodyId = this.m_gpuDispatcher.residentBodyIdAtSlot(ev.header.y);
                    if(bodyId < this.m_physicsWorld.m_bodies.size() && this.m_physicsWorld.m_bodies[bodyId].alive){
                        BodyWakeEvent wakeEv;
                        wakeEv.bodyId = this.m_physicsWorld.makeBodyId(bodyId);
                        wakeEv.userData = this.m_physicsWorld.m_bodies[bodyId].userData;
                        wakeEv.awake = true;
                        this.m_physicsWorld.m_bodyWakeEvents.push_back(wakeEv);
                    }
                }
            }
            else if(evType == s_GpuEventFluidSplash){
                const u32 bodyId = this.m_gpuDispatcher.residentBodyIdAtSlot(ev.header.y);
                const u32 fluidIdx = ev.header.z;
                if(
                    bodyId < this.m_physicsWorld.m_bodies.size()
                    && this.m_physicsWorld.m_bodies[bodyId].alive
                    && cast<usize>(fluidIdx) < gpuFluidSamplesByIdx.size()
                ){
                    FluidCandidateSample sample;
                    sample.bodyId = this.m_physicsWorld.makeBodyId(bodyId);
                    sample.submergedFraction = ev.pointImpulse.w;
                    sample.impactSpeed = ev.normalApproach.w;
                    sample.impactImpulse = bit_cast<f32>(ev.bodyIds.z);
                    sample.cob = f32x4(ev.pointImpulse.x, ev.pointImpulse.y, ev.pointImpulse.z, 0.0f);
                    sample.localSurfNorm = f32x4(ev.normalApproach.x, ev.normalApproach.y, ev.normalApproach.z, 0.0f);
                    sample.hasLocalSurfNorm = true;
                    gpuFluidSamplesByIdx[fluidIdx].push_back(sample);
                }
            }
            else if(evType == s_GpuEventCpuFallback){
                needsCpuFallbackSync = true;
                const u32 sA = ev.header.y;
                const u32 sB = ev.header.z;
                if(sA != s_NullIndex && sB != s_NullIndex && sA != sB){
                    u32 loS = sA;
                    u32 hiS = sB;
                    if(sB < sA){
                        loS = sB;
                        hiS = sA;
                    }
                    const u64 fbKey = (cast<u64>(loS) << 32u) | cast<u64>(hiS);
                    if(seenFallbackPairs.find(fbKey) == seenFallbackPairs.end()){
                        seenFallbackPairs.emplace(fbKey);
                        fallbackShapeAs.push_back(sA);
                        fallbackShapeBs.push_back(sB);
                    }
                }
            }
        }

        for(in u64 k : this.m_currGpuResidentContactPairs){
            const u32 loS = cast<u32>((k >> 32u) & 0xffffffffu);
            const u32 hiS = cast<u32>(k & 0xffffffffu);
            if(this.m_prevGpuResidentContactPairs.find(k) == this.m_prevGpuResidentContactPairs.end()){
                ContactBeginTouchEvent ev;
                ev.shapeIdA = this.m_physicsWorld.makeShapeId(loS);
                ev.shapeIdB = this.m_physicsWorld.makeShapeId(hiS);
                this.m_physicsWorld.m_contactBeginEvents.push_back(ev);
            }
            else{
                ContactPersistEvent ev;
                ev.shapeIdA = this.m_physicsWorld.makeShapeId(loS);
                ev.shapeIdB = this.m_physicsWorld.makeShapeId(hiS);
                this.m_physicsWorld.m_contactPersistEvents.push_back(ev);
            }
        }
        for(in u64 k : this.m_prevGpuResidentContactPairs){
            if(this.m_currGpuResidentContactPairs.find(k) == this.m_currGpuResidentContactPairs.end()){
                const u32 loS = cast<u32>((k >> 32u) & 0xffffffffu);
                const u32 hiS = cast<u32>(k & 0xffffffffu);
                ContactEndTouchEvent ev;
                ev.shapeIdA = this.m_physicsWorld.makeShapeId(loS);
                ev.shapeIdB = this.m_physicsWorld.makeShapeId(hiS);
                this.m_physicsWorld.m_contactEndEvents.push_back(ev);
            }
        }
        this.m_prevGpuResidentContactPairs.swap(this.m_currGpuResidentContactPairs);

        for(in u64 k : this.m_currGpuResidentSensorPairs){
            const u32 sId = cast<u32>((k >> 32u) & 0xffffffffu);
            const u32 vId = cast<u32>(k & 0xffffffffu);
            if(this.m_prevGpuResidentSensorPairs.find(k) == this.m_prevGpuResidentSensorPairs.end()){
                SensorBeginTouchEvent ev;
                ev.sensorShapeId = this.m_physicsWorld.makeShapeId(sId);
                ev.visitorShapeId = this.m_physicsWorld.makeShapeId(vId);
                this.m_physicsWorld.m_sensorBeginEvents.push_back(ev);
            }
            else{
                SensorStayEvent ev;
                ev.sensorShapeId = this.m_physicsWorld.makeShapeId(sId);
                ev.visitorShapeId = this.m_physicsWorld.makeShapeId(vId);
                this.m_physicsWorld.m_sensorStayEvents.push_back(ev);
            }
        }
        for(in u64 k : this.m_prevGpuResidentSensorPairs){
            if(this.m_currGpuResidentSensorPairs.find(k) == this.m_currGpuResidentSensorPairs.end()){
                const u32 sId = cast<u32>((k >> 32u) & 0xffffffffu);
                const u32 vId = cast<u32>(k & 0xffffffffu);
                SensorEndTouchEvent ev;
                ev.sensorShapeId = this.m_physicsWorld.makeShapeId(sId);
                ev.visitorShapeId = this.m_physicsWorld.makeShapeId(vId);
                this.m_physicsWorld.m_sensorEndEvents.push_back(ev);
            }
        }
        this.m_prevGpuResidentSensorPairs.swap(this.m_currGpuResidentSensorPairs);

        if(processGpuEnvFluids && (gpuFluidCount > 0u || !this.m_syncScratch.ecsFluidImmersionState.empty() || !this.m_syncScratch.activeFluidEntitiesById.empty())){
            this.m_syncScratch.seenFluidIdsThisStep.clear();
            this.m_syncScratch.ecsFluidSplashScratch.clear();
            for(usize fi = 0u; fi < gpuFluidCount; ++fi){
                in FluidVolume fl = this.m_environmentScratch.fluids[fi];
                const EntityID fEnt = this.m_syncScratch.envFluidEntitiesScratch[fi];
                this.m_syncScratch.seenFluidIdsThisStep.insert(fEnt.id);
                this.m_syncScratch.activeFluidEntitiesById.insert_or_assign(fEnt.id, fEnt);
                in Vector<FluidCandidateSample> samples = gpuFluidSamplesByIdx[fi];
                ReconcileFluidImmersionRecords(
                    fl,
                    fl.normalizedSurfaceNormal(),
                    fEnt.id,
                    this.m_environmentScratch.elapsedTimeSec,
                    this.m_environmentScratch.splashImpulseThreshold,
                    Span<FluidCandidateSample>(samples.data(), samples.size()),
                    this.m_syncScratch.ecsFluidImmersionState,
                    this.m_syncScratch.ecsFluidSplashScratch,
                    this.m_syncScratch.ecsFluidReconcileScratch
                );
            }
            FinalizeEcsFluidStepEvents(this.m_bodyIndexToEntity, this.m_syncScratch);
        }

        const b8 wantGpuBodyMoveEvents = !preserveExistingMoveEvents && (this.m_onBodyMove.has_value() || (this.publishEventsToMessageBus() && this.publishContinuousEventsToMessageBus()));
        this.m_physicsWorld.m_inStep = false;
        if(!this.m_pendingCpuWakeBodiesScratch.empty() || needsCpuFallbackSync || wantGpuBodyMoveEvents){
            this.syncGpuResidentToWorld();
            for(usize wi = 0u; wi < this.m_pendingCpuWakeBodiesScratch.size(); ++wi){
                const u32 wakeBodyId = this.m_pendingCpuWakeBodiesScratch[wi];
                if(wakeBodyId < this.m_physicsWorld.m_bodies.size() && this.m_physicsWorld.m_bodies[wakeBodyId].alive)
                    this.m_physicsWorld.wakeBody(this.m_physicsWorld.makeBodyId(wakeBodyId));
            }
            this.m_physicsWorld.m_pendingBodyWakeEvents.clear();

            b8 anyMoved = false;
            if(!fallbackShapeAs.empty()){
                Vector<u8> movedFallbackBodies;
                movedFallbackBodies.resize(this.m_physicsWorld.m_bodies.size(), 0u);
                for(usize fi = 0u; fi < fallbackShapeAs.size(); ++fi)
                    this.resolveGpuResidentFallbackContactPair(fallbackShapeAs[fi], fallbackShapeBs[fi], movedFallbackBodies);

                for(usize bi = 0u; bi < movedFallbackBodies.size(); ++bi){
                    if(movedFallbackBodies[bi] != 0u){
                        anyMoved = true;
                        break;
                    }
                }
            }
            if(anyMoved){
                ++this.m_physicsWorld.m_poseMutationVersion;
                this.m_physicsWorld.m_cpuBroadphaseDirty = true;
            }
            if(anyMoved || wantGpuBodyMoveEvents){
                if(!preserveExistingMoveEvents)
                    this.m_physicsWorld.m_bodyMoveEvents.clear();
                in Vector<BodySim> awakeSims = this.m_physicsWorld.m_solverSets[s_AwakeSetIndex].sims;
                this.m_physicsWorld.m_bodyMoveEvents.reserve(awakeSims.size());
                for(usize ai = 0u; ai < awakeSims.size(); ++ai){
                    in BodySim sim = awakeSims[ai];
                    if(sim.bodyId >= this.m_physicsWorld.m_bodies.size())
                        continue;
                    mut Body body = this.m_physicsWorld.m_bodies[sim.bodyId];
                    if(!body.alive || body.type != BodyType::Dynamic)
                        continue;
                    const BodyId bId = this.m_physicsWorld.makeBodyId(sim.bodyId);
                    if(
                        preserveExistingMoveEvents
                        && body.bodyMoveIndex < cast<u32>(this.m_physicsWorld.m_bodyMoveEvents.size())
                        && this.m_physicsWorld.m_bodyMoveEvents[body.bodyMoveIndex].bodyId == bId
                    ){
                        this.m_physicsWorld.m_bodyMoveEvents[body.bodyMoveIndex].positionFlags = f32x3_u32(VectorSingle(sim.transform.position), 0u);
                        this.m_physicsWorld.m_bodyMoveEvents[body.bodyMoveIndex].rotation = sim.transform.rotation;
                    }
                    else{
                        BodyMoveEvent moveEv;
                        moveEv.bodyId = bId;
                        moveEv.positionFlags = f32x3_u32(VectorSingle(sim.transform.position), 0u);
                        moveEv.rotation = sim.transform.rotation;
                        moveEv.userData = body.userData;
                        body.bodyMoveIndex = cast<u32>(this.m_physicsWorld.m_bodyMoveEvents.size());
                        this.m_physicsWorld.m_bodyMoveEvents.push_back(moveEv);
                    }
                }
                if(anyMoved && !preserveExistingMoveEvents){
                    WriteBackPhysicsTransformsToEcs(
                        this.m_physicsWorld,
                        this.m_physicsWorld.bodyMoveEvents(),
                        this.m_bodyIndexToEntity,
                        this.m_hasAnyPhysicsParents,
                        false,
                        false,
                        1.0f,
                        this.m_world,
                        this.m_syncScratch,
                        this.m_bodyTransformSnapshots,
                        this.m_bodyTransformSnapshotMeta
                    );
                }
            }
            if(needsCpuFallbackSync)
                this.m_gpuDispatcher.invalidateGpuResidentState();
        }
    }

    public b8 readbackGpuResidentEvents(mut Vector<GpuPhysicsEvent> outEvents){
        return this.m_gpuDispatcher.readbackGpuResidentEvents(this.m_physicsWorld, outEvents);
    }

    public b8 stepGpuBulletToiResident(in f32 dt){
        return this.m_gpuDispatcher.stepGpuBulletToiResident(this.m_physicsWorld, dt);
    }

    public b8 stepSoftBodyGpu(
        mut SoftBody softBody,
        in Optional<in PhysicsEnvironment> env,
        in f32 dt,
        in b8 readbackToSoftBody,
        in Optional<in SoftBodyGpuDeformTarget> deformTarget,
        mut Aabb3D outWorldAabb
    ){
        return this.m_gpuDispatcher.stepSoftBodyGpu(softBody, this.m_physicsWorld, env, dt, readbackToSoftBody, deformTarget, outWorldAabb);
    }

    public b8 applyEnvironmentGpu(in PhysicsEnvironment env, in f32 dt){
        return this.m_gpuDispatcher.applyEnvironmentGpu(this.m_physicsWorld, env, dt);
    }

    public b8 applyExplosionGpu(
        in VectorSingle origin,
        in f32 radius,
        in f32 impulse,
        in f32 upwardBias,
        in f32 falloffPower,
        in b8 readbackToWorld,
        in Filter filter
    ){
        return this.m_gpuDispatcher.applyExplosionGpu(this.m_physicsWorld, origin, radius, impulse, upwardBias, falloffPower, readbackToWorld, filter);
    }

    public b8 applyExplosion(in ExplosionDef def){
        const VectorSingle pos = VectorSingle(def.position);
        if(
            !IsValidPositionVec3(pos)
            || !IsFinite(VectorSingle(def.radius, def.falloff, def.impulsePerLength, 0.0f))
            || def.radius < 0.0f
            || def.falloff < 0.0f
            || (def.radius + def.falloff) <= 0.0f
            || def.impulsePerLength == 0.0f
        )
            return true;
        const b8 canUseGpu =
            (this.m_gpuDispatcher.isGpuResidentDirtyCpu()
                || (this.m_physicsWorld.m_def.gpuResidentMode && this.m_physicsWorld.m_backendMode != PhysicsBackendMode::CpuOnly))
            && !def.checkOcclusion
            && !(def.useCustomFilter && this.m_physicsWorld.m_customFilterCallback.has_value())
            && (def.filter.categoryBits >> 32u) == 0u
            && (def.filter.maskBits == u64.max || (def.filter.maskBits >> 32u) == 0u)
            && def.filter.broadPhaseLayer == 0u
            && this.m_gpuDispatcher.isReady()
        ;
        if(canUseGpu){
            if(this.m_gpuDispatcher.applyExplosionDefGpu(this.m_physicsWorld, def, false))
                return true;
        }
        if(this.m_gpuDispatcher.isGpuResidentDirtyCpu())
            this.syncGpuResidentToWorld();
        this.m_physicsWorld.explode(def);
        return true;
    }

    public void setActiveSceneSubsystems(in ActiveSceneSubsystemsRef subsystems){
        this.m_gpuDispatcher.setActiveSceneSubsystems(subsystems);
    }

    public b8 validateResources(){
        const b8 ok = this.m_gpuDispatcher.validateResources();
        if(!ok)
            warning("PhysicsSystem: GPU physics pipelines unavailable; falling back to CPU solver");
        return ok;
    }

    public void invalidateResources(){
        this.m_syncScratch.hierarchyCacheValid = false;
        this.m_syncScratch.mutationVersionsValid = false;
        this.m_syncScratch.hasSyncedPhysicsEntityCounts = false;
        this.m_hasActiveInstanceTransformPatches = false;
        this.m_activeInstanceTransformPatchMembershipSig = 0u;
        this.m_gpuDispatcher.invalidateResources();
    }

    public Expected<void, CpuTaskAdmissionError> update(mut World world, in f32 delta)override{
        ClearDestroyedSlotOwners(this.m_syncScratch);
        this.clearFrameEvents();

        f32 fixedDt = 1.0f / 60.0f;
        u32 subStepCount = 4u;
        u32 maxSubStepsPerFrame = 4u;
        b8 paused = false;
        b8 interpolateTransforms = false;
        b8 hasConfig = false;
        b8 cfgPublishEventsToMessageBus = false;
        b8 cfgPublishContinuousEventsToMessageBus = false;
        f32 cfgSplashImpulseThreshold = 1.5f;
        ResolvePhysicsConfigSettings(
            world,
            this.m_physicsWorld,
            this.m_assetManager,
            this.m_collisionLayerMatrix,
            this.m_syncScratch,
            fixedDt,
            subStepCount,
            maxSubStepsPerFrame,
            paused,
            interpolateTransforms,
            hasConfig,
            cfgPublishEventsToMessageBus,
            cfgPublishContinuousEventsToMessageBus,
            cfgSplashImpulseThreshold
        );
        this.m_cfgPublishEventsToMessageBus = hasConfig && cfgPublishEventsToMessageBus;
        this.m_cfgPublishContinuousEventsToMessageBus = hasConfig && cfgPublishContinuousEventsToMessageBus;
        this.m_environmentScratch.splashImpulseThreshold = cfgSplashImpulseThreshold;
        if((!this.m_physicsWorld.m_def.gpuResidentMode || this.m_physicsWorld.m_backendMode == PhysicsBackendMode::CpuOnly) && this.m_gpuDispatcher.isGpuResidentDirtyCpu())
            this.syncGpuResidentToWorld();

        const b8 collisionLayerMatrixDirty = this.m_syncScratch.collisionLayerMatrixChanged;
        b8 hasAnyPhysicsParents = false;
        b8 hasDrivenKinematic = false;
        SyncEcsCsgColliderDeforms(
            this.m_assetManager,
            this.m_scopedNames,
            RefreshPhysicsHierarchyCache(world, this.m_syncScratch),
            this.m_csgShapeRegistry,
            world,
            this.m_syncScratch
        );
        SyncEcsEntitiesToPhysicsWorld(
            this.m_assetManager,
            this.m_collisionLayerMatrix,
            this.m_assetCache,
            world,
            this.m_physicsWorld,
            this.m_entityRecords,
            this.m_entityJoints,
            this.m_bodyIndexToEntity,
            this.m_shapeIndexToEntity,
            this.m_jointIndexToEntity,
            this.m_scopedNames,
            this.m_syncedRigidBodyTags,
            this.m_syncedColliderTags,
            this.m_bodyTransformSnapshots,
            this.m_bodyTransformSnapshotMeta,
            this.m_syncScratch,
            hasAnyPhysicsParents,
            hasDrivenKinematic
        );
        SyncEcsSkinnedMeshColliders(
            this.m_assetManager,
            this.m_scopedNames,
            hasAnyPhysicsParents,
            world,
            this.m_physicsWorld,
            this.m_entityRecords,
            this.m_syncScratch
        );
        this.m_hasAnyPhysicsParents = hasAnyPhysicsParents;
        PruneRemovedEcsRagdolls(
            world,
            this.m_physicsWorld,
            this.m_activeRagdolls,
            this.m_bodyIndexToEntity,
            this.m_shapeIndexToEntity,
            this.m_jointIndexToEntity,
            this.m_syncScratch.deadRagdolls
        );
        PruneRemovedEcsFractures(
            world,
            this.m_physicsWorld,
            this.m_activeFractures,
            this.m_bodyIndexToEntity,
            this.m_shapeIndexToEntity,
            this.m_syncScratch.deadRagdolls
        );

        const b8 runSingleStep = this.m_pendingSingleStep;
        this.m_pendingSingleStep = false;

        if((paused && !runSingleStep) || (!runSingleStep && (!IsFinite(VectorSingle(delta)) || delta <= 0.0f))){
            if(this.m_physicsWorld.m_topologyVersion != this.m_lastStepTopologyVersion){
                this.m_lastStepStats = WorldStepStats();
                this.m_lastStepMs = 0.0;
                this.m_lastStepTopologyVersion = this.m_physicsWorld.m_topologyVersion;
            }
            this.m_lastStepStats.bodyCount = this.m_physicsWorld.activeBodyCount();
            this.m_lastStepStats.awakeBodyCount = this.m_physicsWorld.awakeBodyCount();
            this.m_lastStepStats.shapeCount = this.m_physicsWorld.activeShapeCount();
            this.m_lastStepStats.contactCount = cast<u32>(this.m_physicsWorld.m_pairContactMap.size());
            this.m_lastStepStats.jointCount = this.m_physicsWorld.activeJointCount();
            u32 aliveIslands = 0u;
            for(usize ii = 0u; ii < this.m_physicsWorld.m_islands.size(); ++ii){
                if(this.m_physicsWorld.m_islands[ii].alive)
                    ++aliveIslands;
            }
            this.m_lastStepStats.islandCount = aliveIslands;
            this.m_physicsWorld.consumePendingEndEvents(this.m_frameContactEndEvents, this.m_frameSensorEndEvents);
            this.m_physicsWorld.consumePendingWakeEvents(this.m_frameBodyWakeEvents);
            this.dispatchFrameEventCallbacks();
            this.publishFrameEventsToMessageBus(world);
            return Expected<void, CpuTaskAdmissionError>();
        }

        u32 maxAllowedSteps = maxSubStepsPerFrame;
        if(runSingleStep){
            this.m_accumulator = fixedDt;
            maxAllowedSteps = 1u;
        }
        else{
            const f32 clampedDelta = Min(delta, fixedDt * cast<f32>(maxSubStepsPerFrame));
            this.m_accumulator += clampedDelta;
        }

        u32 plannedSteps = 0u;
        f32 simAccum = this.m_accumulator;
        while(simAccum + 1.0e-6f >= fixedDt && plannedSteps < maxAllowedSteps){
            if(simAccum >= fixedDt)
                simAccum -= fixedDt;
            else
                simAccum = 0.0f;
            ++plannedSteps;
        }

        const b8 useCollectedEnv = plannedSteps > 1u;
        const auto fluidCheckView = world.view<FluidVolumeComponent>();
        const auto fieldCheckView = world.view<ForceFieldComponent>();
        const b8 hasAnyEnvEntities = fluidCheckView.candidateCount() > 0u || fieldCheckView.candidateCount() > 0u;
        b8 allFluidsGpuSupported = true;
        if(fluidCheckView.candidateCount() > 0u){
            fluidCheckView.each(
                lambda[mut allFluidsGpuSupported](in EntityID ent, in FluidVolumeComponent fvc) -> void{
                    if(fvc.enabled && fvc.volume.enabled && !IsGpuSupportedFluidVolume(fvc.volume))
                        allFluidsGpuSupported = false;
                }
            );
        }
        b8 allFieldsGpuSupported = true;
        if(fieldCheckView.candidateCount() > 0u){
            fieldCheckView.each(
                lambda[mut allFieldsGpuSupported](in EntityID ent, in ForceFieldComponent ffc) -> void{
                    if(ffc.enabled && ffc.field.enabled && !IsGpuSupportedForceField(ffc.field))
                        allFieldsGpuSupported = false;
                }
            );
        }

        const b8 hasAnyActiveSubsystems =
            HasAnyEnabledEcsComponent<CharacterControllerComponent>(world)
            || HasAnyEnabledEcsComponent<VehicleComponent>(world)
            || HasAnyEnabledEcsComponent<ArticulationComponent>(world)
            || HasAnyEnabledEcsComponent<RagdollComponent>(world)
            || HasAnyEnabledEcsComponent<SoftBodyComponent>(world)
            || HasAnyEnabledEcsComponent<FractureComponent>(world)
        ;
        const b8 gpuResidentBaseEligible =
            this.m_physicsWorld.m_def.gpuResidentMode
            && this.m_physicsWorld.m_backendMode != PhysicsBackendMode::CpuOnly
            && CanGpuHandleResidentWorldStep(this.m_physicsWorld)
        ;
        const b8 gpuResidentNoReadbackEligible =
            gpuResidentBaseEligible
            && allFluidsGpuSupported
            && allFieldsGpuSupported
            && !hasDrivenKinematic
            && !hasAnyPhysicsParents
            && !interpolateTransforms
            && !hasAnyActiveSubsystems
        ;
        const b8 gpuResidentHybridEligible = gpuResidentBaseEligible && !gpuResidentNoReadbackEligible;
        const b8 gpuResidentNoReadbackActive = gpuResidentNoReadbackEligible && this.m_gpuDispatcher.isReady();
        const b8 gpuResidentHybridActive = gpuResidentHybridEligible && this.m_gpuDispatcher.isReady();
        const b8 wantSoftBodyImpactEvents = this.m_onSoftBodyImpact.has_value() || this.publishEventsToMessageBus();
        if(useCollectedEnv || (gpuResidentNoReadbackEligible && hasAnyEnvEntities)){
            if(useCollectedEnv && hasDrivenKinematic)
                SnapshotDrivenKinematicTargets(this.m_physicsWorld, this.m_syncScratch.drivenKinematicEntries, hasAnyPhysicsParents, world, this.m_syncScratch.writeBackPoseCache, this.m_syncScratch.kinematicTargets);
            CollectEcsPhysicsEnvironment(hasAnyPhysicsParents, this.m_collisionLayerMatrix, world, this.m_syncScratch.writeBackPoseCache, this.m_environmentScratch, this.m_syncScratch.envFluidEntitiesScratch);
        }
        else if(gpuResidentNoReadbackEligible){
            this.m_environmentScratch.fluids.clear();
            this.m_environmentScratch.forceFields.clear();
            this.m_syncScratch.envFluidEntitiesScratch.clear();
        }
        const Optional<mut SoftBodyMeshSystem> softBodyMeshSystem = world.borrowSystem<SoftBodyMeshSystem>();
        if(!gpuResidentBaseEligible){
            this.m_prevGpuResidentContactPairs.clear();
            this.m_prevGpuResidentSensorPairs.clear();
        }
        if(!gpuResidentNoReadbackEligible && this.m_gpuDispatcher.isGpuResidentDirtyCpu())
            this.syncGpuResidentToWorld();

        mut CpuTaskScheduler scheduler = world.taskScheduler();
        b8 usedGpuResidentNoReadback = false;
        u32 stepsExecuted = 0u;
        while(this.m_accumulator + 1.0e-6f >= fixedDt && stepsExecuted < maxAllowedSteps){
            if(this.m_accumulator >= fixedDt)
                this.m_accumulator -= fixedDt;
            else
                this.m_accumulator = 0.0f;

            const b8 isFinalStep = ((stepsExecuted + 1u) == plannedSteps);
            if(isFinalStep && !gpuResidentNoReadbackEligible)
                PreparePrevEcsBodyTransformSnapshots(this.m_physicsWorld, this.bodyMoveEvents(), this.m_syncScratch.dirtyPrevSnapshotBodyIndices, this.m_syncScratch.snapshotBodyStamps, this.m_syncScratch.snapshotStamp, this.m_bodyTransformSnapshots, this.m_bodyTransformSnapshotMeta);
            if(hasDrivenKinematic){
                if(plannedSteps <= 1u)
                    ApplyKinematicTargetsFromEcs(this.m_syncScratch.drivenKinematicEntries, fixedDt, hasAnyPhysicsParents, world, this.m_syncScratch.writeBackPoseCache, this.m_physicsWorld);
                else
                    ApplyInterpolatedKinematicTargets(this.m_syncScratch.kinematicTargets, stepsExecuted, plannedSteps, fixedDt, this.m_physicsWorld);
            }
            if(this.m_preStepCallback.has_value())
                this.m_preStepCallback.value()(world, this.m_physicsWorld, fixedDt);

            const b8 writeBackCharacters = isFinalStep && !interpolateTransforms;
            StepEcsPhysicsSubsystemBridges(
                world,
                this.m_physicsWorld,
                this.m_entityRecords,
                this.m_scopedNames,
                this.m_collisionLayerMatrix,
                collisionLayerMatrixDirty,
                this.m_assetManager,
                this.m_bodyIndexToEntity,
                this.m_shapeIndexToEntity,
                this.m_jointIndexToEntity,
                fixedDt,
                useCollectedEnv,
                gpuResidentNoReadbackActive,
                writeBackCharacters,
                hasAnyPhysicsParents,
                isFinalStep,
                wantSoftBodyImpactEvents,
                this.m_environmentScratch,
                this.m_activeRagdolls,
                this.m_activeFractures,
                this.m_syncScratch,
                this.m_assetCache,
                scheduler,
                this.m_gpuDispatcher,
                softBodyMeshSystem
            );

            const Timer stepStart = TimerNow();
            b8 gpuEnvOk = true;
            b8 envSteppedOnGpu = false;
            if(gpuResidentNoReadbackActive && (!this.m_environmentScratch.fluids.empty() || !this.m_environmentScratch.forceFields.empty())){
                gpuEnvOk = this.m_gpuDispatcher.applyEnvironmentGpu(this.m_physicsWorld, this.m_environmentScratch, fixedDt);
                if(gpuEnvOk){
                    envSteppedOnGpu = true;
                    this.m_environmentScratch.elapsedTimeSec += fixedDt;
                }
            }
            if(gpuResidentNoReadbackActive && gpuEnvOk && this.m_gpuDispatcher.stepGpuResidentBodies(this.m_physicsWorld, fixedDt, subStepCount, false)){
                usedGpuResidentNoReadback = true;
                this.m_gpuDispatcher.stepGpuBulletToiResident(this.m_physicsWorld, fixedDt);
                if(this.m_gpuDispatcher.readbackGpuResidentEvents(this.m_physicsWorld, this.m_gpuResidentEventsScratch))
                    this.processGpuResidentStepEvents(false, true);
            }
            else if(gpuResidentHybridActive && this.m_gpuDispatcher.stepGpuResidentBodies(this.m_physicsWorld, fixedDt, subStepCount, false)){
                usedGpuResidentNoReadback = false;
                this.m_gpuDispatcher.clearEnvSplashPending();
                this.m_gpuDispatcher.stepGpuBulletToiResident(this.m_physicsWorld, fixedDt);
                this.m_physicsWorld.m_bodyMoveEvents.clear();
                this.m_gpuDispatcher.syncGpuResidentToWorld(this.m_physicsWorld);
                if(this.m_gpuDispatcher.readbackGpuResidentEvents(this.m_physicsWorld, this.m_gpuResidentEventsScratch))
                    this.processGpuResidentStepEvents(true, false);
            }
            else{
                usedGpuResidentNoReadback = false;
                this.m_prevGpuResidentContactPairs.clear();
                this.m_prevGpuResidentSensorPairs.clear();
                this.m_gpuDispatcher.clearEnvSplashPending();
                if(this.m_gpuDispatcher.isGpuResidentDirtyCpu())
                    this.m_gpuDispatcher.syncGpuResidentToWorld(this.m_physicsWorld);
                if(gpuResidentNoReadbackActive){
                    if(!this.m_environmentScratch.fluids.empty() || !this.m_environmentScratch.forceFields.empty()){
                        if(!envSteppedOnGpu)
                            this.m_environmentScratch.elapsedTimeSec += fixedDt;
                        this.m_syncScratch.seenFluidIdsThisStep.clear();
                        this.m_syncScratch.ecsFluidSplashScratch.clear();
                        const usize fbFluidCount = Min(this.m_environmentScratch.fluids.size(), this.m_syncScratch.envFluidEntitiesScratch.size());
                        for(usize fi = 0u; fi < fbFluidCount; ++fi){
                            const EntityID fEnt = this.m_syncScratch.envFluidEntitiesScratch[fi];
                            this.m_syncScratch.seenFluidIdsThisStep.insert(fEnt.id);
                            this.m_syncScratch.activeFluidEntitiesById.insert_or_assign(fEnt.id, fEnt);
                            StepFluidVolumeWithEventsWithScheduler(
                                this.m_physicsWorld,
                                this.m_environmentScratch.fluids[fi],
                                fEnt.id,
                                this.m_environmentScratch.elapsedTimeSec,
                                fixedDt,
                                this.m_environmentScratch.splashImpulseThreshold,
                                scheduler,
                                this.m_syncScratch.ecsFluidSamplesScratch,
                                this.m_syncScratch.ecsFluidImmersionState,
                                this.m_syncScratch.ecsFluidSplashScratch,
                                this.m_syncScratch.ecsFluidReconcileScratch
                            );
                        }
                        if(!this.m_environmentScratch.forceFields.empty()){
                            const u32 gravEpoch = ResetWorldForceFieldGravityOverrideEpoch(this.m_physicsWorld);
                            for(usize fi = 0u; fi < this.m_environmentScratch.forceFields.size(); ++fi)
                                ApplyForceFieldWithSchedulerEpoch(this.m_physicsWorld, this.m_environmentScratch.forceFields[fi], this.m_environmentScratch.elapsedTimeSec, fixedDt, scheduler, gravEpoch);
                        }
                        FinalizeEcsFluidStepEvents(this.m_bodyIndexToEntity, this.m_syncScratch);
                    }
                    else if(!this.m_syncScratch.ecsFluidImmersionState.empty() || !this.m_syncScratch.activeFluidEntitiesById.empty()){
                        this.m_syncScratch.seenFluidIdsThisStep.clear();
                        this.m_syncScratch.ecsFluidSplashScratch.clear();
                        FinalizeEcsFluidStepEvents(this.m_bodyIndexToEntity, this.m_syncScratch);
                    }
                }
                StepWorldWithGpu(this.m_physicsWorld, this.m_gpuDispatcher, fixedDt, subStepCount, scheduler);
            }
            this.m_lastStepMs = DurationInMS<f64>(TimerNow(), stepStart);

            ProcessEcsFracturePostStepHits(
                world,
                this.m_physicsWorld,
                this.m_bodyIndexToEntity,
                this.m_shapeIndexToEntity,
                this.m_activeFractures,
                this.m_syncScratch
            );

            this.recordBrokenJointOwnersFromWorld();
            if(plannedSteps == 1u)
                this.m_useDirectWorldEvents = true;
            else
                this.appendLastStepEvents();
            this.m_lastStepStats = this.m_physicsWorld.lastStepStats();
            this.m_lastStepTopologyVersion = this.m_physicsWorld.m_topologyVersion;
            ++stepsExecuted;
        }

        if(runSingleStep){
            this.m_accumulator = 0.0f;
            this.m_interpolationAlpha = 1.0f;
        }
        else{
            this.m_interpolationAlpha = Clamp(this.m_accumulator / fixedDt, 0.0f, 1.0f);
        }

        if(stepsExecuted > 0u){
            if(!usedGpuResidentNoReadback){
                if(stepsExecuted == 1u){
                    WriteBackPhysicsTransformsToEcs(
                        this.m_physicsWorld,
                        this.bodyMoveEvents(),
                        this.m_bodyIndexToEntity,
                        hasAnyPhysicsParents,
                        true,
                        interpolateTransforms,
                        this.m_interpolationAlpha,
                        world,
                        this.m_syncScratch,
                        this.m_bodyTransformSnapshots,
                        this.m_bodyTransformSnapshotMeta
                    );
                }
                else{
                    CommitCurrEcsBodyTransformSnapshots(this.m_physicsWorld, this.m_syncScratch.dirtyPrevSnapshotBodyIndices, this.m_bodyTransformSnapshots, this.m_bodyTransformSnapshotMeta);
                    WriteBackPhysicsTransformsToEcs(
                        this.m_physicsWorld,
                        this.bodyMoveEvents(),
                        this.m_bodyIndexToEntity,
                        hasAnyPhysicsParents,
                        false,
                        interpolateTransforms,
                        this.m_interpolationAlpha,
                        world,
                        this.m_syncScratch,
                        this.m_bodyTransformSnapshots,
                        this.m_bodyTransformSnapshotMeta
                    );
                }
                WriteBackEcsRagdollRootPoses(
                    this.m_physicsWorld,
                    this.m_scopedNames,
                    this.m_activeRagdolls,
                    this.m_bodyTransformSnapshots,
                    this.m_bodyTransformSnapshotMeta,
                    interpolateTransforms,
                    this.m_interpolationAlpha,
                    hasAnyPhysicsParents,
                    world,
                    this.m_syncScratch
                );
                WriteBackEcsVehicleWheelPoses(
                    this.m_physicsWorld,
                    this.m_scopedNames,
                    this.m_bodyTransformSnapshots,
                    this.m_bodyTransformSnapshotMeta,
                    interpolateTransforms,
                    this.m_interpolationAlpha,
                    true,
                    hasAnyPhysicsParents,
                    world,
                    this.m_syncScratch
                );
                WriteBackEcsArticulationPoses(
                    this.m_physicsWorld,
                    this.m_scopedNames,
                    this.m_bodyIndexToEntity,
                    interpolateTransforms,
                    this.m_interpolationAlpha,
                    true,
                    hasAnyPhysicsParents,
                    world,
                    this.m_syncScratch
                );
                WriteBackEcsFracturePoses(
                    this.m_physicsWorld,
                    this.m_activeFractures,
                    this.m_bodyTransformSnapshots,
                    this.m_bodyTransformSnapshotMeta,
                    interpolateTransforms,
                    this.m_interpolationAlpha,
                    hasAnyPhysicsParents,
                    world,
                    this.m_syncScratch
                );
                if(interpolateTransforms)
                    ApplyInterpolatedCharacterTransformsToEcs(this.m_syncScratch.characterSyncStates, this.m_interpolationAlpha, hasAnyPhysicsParents, world, this.m_syncScratch.writeBackPoseCache);
            }
        }
        else{
            this.m_physicsWorld.consumePendingEndEvents(this.m_frameContactEndEvents, this.m_frameSensorEndEvents);
            this.m_physicsWorld.consumePendingWakeEvents(this.m_frameBodyWakeEvents);
            if(interpolateTransforms && !this.m_gpuDispatcher.isGpuResidentDirtyCpu()){
                ApplyInterpolatedRenderTransformsToEcs(
                    this.m_physicsWorld,
                    this.m_bodyIndexToEntity,
                    hasAnyPhysicsParents,
                    this.m_interpolationAlpha,
                    this.m_bodyTransformSnapshots,
                    this.m_bodyTransformSnapshotMeta,
                    world,
                    this.m_syncScratch
                );
                ApplyInterpolatedCharacterTransformsToEcs(this.m_syncScratch.characterSyncStates, this.m_interpolationAlpha, hasAnyPhysicsParents, world, this.m_syncScratch.writeBackPoseCache);
                WriteBackEcsRagdollRootPoses(
                    this.m_physicsWorld,
                    this.m_scopedNames,
                    this.m_activeRagdolls,
                    this.m_bodyTransformSnapshots,
                    this.m_bodyTransformSnapshotMeta,
                    true,
                    this.m_interpolationAlpha,
                    hasAnyPhysicsParents,
                    world,
                    this.m_syncScratch
                );
                WriteBackEcsVehicleWheelPoses(
                    this.m_physicsWorld,
                    this.m_scopedNames,
                    this.m_bodyTransformSnapshots,
                    this.m_bodyTransformSnapshotMeta,
                    true,
                    this.m_interpolationAlpha,
                    false,
                    hasAnyPhysicsParents,
                    world,
                    this.m_syncScratch
                );
                WriteBackEcsArticulationPoses(
                    this.m_physicsWorld,
                    this.m_scopedNames,
                    this.m_bodyIndexToEntity,
                    true,
                    this.m_interpolationAlpha,
                    false,
                    hasAnyPhysicsParents,
                    world,
                    this.m_syncScratch
                );
                WriteBackEcsFracturePoses(
                    this.m_physicsWorld,
                    this.m_activeFractures,
                    this.m_bodyTransformSnapshots,
                    this.m_bodyTransformSnapshotMeta,
                    true,
                    this.m_interpolationAlpha,
                    hasAnyPhysicsParents,
                    world,
                    this.m_syncScratch
                );
            }
        }

        this.dispatchFrameEventCallbacks();
        this.publishFrameEventsToMessageBus(world);
        return Expected<void, CpuTaskAdmissionError>();
    }
}


