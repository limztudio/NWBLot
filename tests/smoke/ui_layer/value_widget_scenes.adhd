StringView UiProgressSmokeKey(in usize index){
    switch(index){
    case 0u:
        return "zero";
    case 1u:
        return "quarter";
    case 2u:
        return "full";
    case 3u:
        return "below";
    case 4u:
        return "above";
    case 5u:
        return "tiny";
    default:
        return "";
    }
}

f64 UiProgressSmokeFraction(in usize index){
    switch(index){
    case 0u:
        return 0.0;
    case 1u:
        return 0.25;
    case 2u:
        return 1.0;
    case 3u:
        return -2.0;
    case 4u:
        return 3.0;
    case 5u:
        return 0.01;
    default:
        return 0.0;
    }
}

