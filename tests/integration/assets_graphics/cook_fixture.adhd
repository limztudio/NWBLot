TestAString BuildTriangleMeta(in StringView assetHeader, in StringView normalField, in StringView tangentField, in StringView vertexRefsField, in StringView suffix){
    TestAString meta = TestAString();
    meta.reserve(1536u);
    AppendTestMeta(assetHeader, meta);
    AppendTestMeta(s_TrianglePositionsField, meta);
    AppendTestMeta(normalField, meta);
    AppendTestMeta(tangentField, meta);
    AppendTestMeta(s_TriangleUv0Field, meta);
    AppendTestMeta(s_TriangleColorsField, meta);
    AppendTestMeta(vertexRefsField, meta);
    AppendTestMeta(s_TriangleIndicesField, meta);
    AppendTestMeta(suffix, meta);
    return meta;
}

