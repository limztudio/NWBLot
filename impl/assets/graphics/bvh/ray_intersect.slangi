////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_BVH_RAY_INTERSECT_SLANGI
#define NWB_GRAPHICS_BVH_RAY_INTERSECT_SLANGI


#include "bvh_common.slangi"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Shared ray/AABB helpers for the software BVH consumers. Keep the reciprocal direction finite for axis-aligned rays:
// an infinite reciprocal multiplied by a zero slab offset would otherwise create a NaN and incorrectly reject a box.
float3 nwbBvhSafeInvDir(const float3 direction){
    const float epsilon = 1e-8;
    const float3 safe = float3(
        abs(direction.x) > epsilon ? direction.x : (direction.x < 0.0 ? -epsilon : epsilon),
        abs(direction.y) > epsilon ? direction.y : (direction.y < 0.0 ? -epsilon : epsilon),
        abs(direction.z) > epsilon ? direction.z : (direction.z < 0.0 ? -epsilon : epsilon)
    );
    return 1.0 / safe;
}

bool nwbBvhRayAabbInterval(
    const float3 origin,
    const float3 invDir,
    const float tMin,
    const float tMax,
    const float3 boxMin,
    const float3 boxMax,
    const float padding,
    out float outTEntry
){
    const float3 t0 = (boxMin - padding - origin) * invDir;
    const float3 t1 = (boxMax + padding - origin) * invDir;
    const float3 tSmall = min(t0, t1);
    const float3 tLarge = max(t0, t1);
    const float tNear = max(max(tSmall.x, tSmall.y), max(tSmall.z, tMin));
    const float tFar = min(min(tLarge.x, tLarge.y), min(tLarge.z, tMax));
    outTEntry = tNear;
    return tNear <= tFar;
}

bool nwbBvhRayAabb(
    const float3 origin,
    const float3 invDir,
    const float tMin,
    const float tMax,
    const float3 boxMin,
    const float3 boxMax,
    const float padding
){
    float unusedTEntry;
    return nwbBvhRayAabbInterval(origin, invDir, tMin, tMax, boxMin, boxMax, padding, unusedTEntry);
}

bool nwbBvhRayAabbT(
    const float3 origin,
    const float3 invDir,
    const float tMin,
    const float tMax,
    const float3 boxMin,
    const float3 boxMax,
    const float padding,
    out float tEntry
){
    return nwbBvhRayAabbInterval(origin, invDir, tMin, tMax, boxMin, boxMax, padding, tEntry);
}

// Shared inner-node step for the software mesh/scene traversals. Intersects both children against the current
// closest range and selects the near child to descend inline plus the far child to defer. Returns false when both
// children miss so the caller pops the next stack entry. The stack push stays caller-side because mesh and scene
// traversals use different stack capacities.
bool nwbBvhPickNearChild(
    const float3 origin,
    const float3 invDir,
    const float tMin,
    const float tMax,
    const NwbBvhNode node,
    const NwbBvhNode leftNode,
    const uint rightChildIndex,
    const NwbBvhNode rightNode,
    out NwbBvhNode descendNode,
    out uint farChildIndex,
    out bool bothHit
){
    float tLeft;
    const bool hitLeft = nwbBvhRayAabbT(origin, invDir, tMin, tMax, leftNode.aabbMin, leftNode.aabbMax, 0.0, tLeft);
    float tRight;
    const bool hitRight = nwbBvhRayAabbT(origin, invDir, tMin, tMax, rightNode.aabbMin, rightNode.aabbMax, 0.0, tRight);
    bothHit = hitLeft && hitRight;
    if(bothHit){
        if(tLeft <= tRight){
            descendNode = leftNode;
            farChildIndex = rightChildIndex;
        }
        else{
            descendNode = rightNode;
            farChildIndex = node.leftChild;
        }
        return true;
    }
    if(hitLeft){
        descendNode = leftNode;
        farChildIndex = node.leftChild;
        return true;
    }
    if(hitRight){
        descendNode = rightNode;
        farChildIndex = rightChildIndex;
        return true;
    }
    return false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

