#include "popup_style.adhd"
#include <impl/ecs_ui/toolkit/input/popup.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const f32 s_TooltipDefaultDelaySeconds = 0.5f;
const f32 s_TooltipDefaultMaximumWidth = 320.0f;

class TooltipStyle{
    public Name background = Name("tooltip.normal");
    public Name fallback = Name("panel.normal");
    public Insets padding = Insets(s_StyleSpacingMedium, s_StyleFieldPaddingY, s_StyleSpacingMedium, s_StyleFieldPaddingY);
    public Color text;
}

class TooltipOptions{
    public b8 operator==(in TooltipOptions rhs)const{
        return this.enabled == rhs.enabled
            && this.side == rhs.side
            && this.delaySeconds == rhs.delaySeconds
            && this.maximumWidth == rhs.maximumWidth
            && this.gap == rhs.gap;
    }

    public b8 operator!=(in TooltipOptions rhs)const{
        return this.enabled != rhs.enabled
            || this.side != rhs.side
            || this.delaySeconds != rhs.delaySeconds
            || this.maximumWidth != rhs.maximumWidth
            || this.gap != rhs.gap;
    }

    public b8 enabled = true;
    public PopupPlacementSide side = PopupPlacementSide::Below;
    public f32 delaySeconds = s_TooltipDefaultDelaySeconds;
    public f32 maximumWidth = s_TooltipDefaultMaximumWidth;
    public f32 gap = s_StyleSpacingSmall;
}

b8 IsValidTooltipOptions(in TooltipOptions options){
    return isFinite(options.delaySeconds)
        && options.delaySeconds >= 0.0f
        && isFinite(options.maximumWidth)
        && options.maximumWidth > 0.0f
        && isFinite(options.gap)
        && options.gap >= 0.0f
        && options.side <= PopupPlacementSide::Center;
}

void ApplySkinPaletteToTooltipStyle(in UiSkinPalette palette, mut TooltipStyle style){
    style.text = ResolveUiSkinColor(palette, UiSkinColorRole::TextTooltip);
}

Expected<b8> TryEvaluateTooltipStateUpdate(
    in WidgetId anchor,
    in u64 declarationGeneration,
    in PopupToken popup,
    in u64 focusLossGeneration,
    in u64 hoverActivityGeneration,
    in b8 hovered,
    in f32 deltaSeconds,
    in TooltipOptions options,
    mut WidgetId inOutAnchor,
    mut u64 inOutDeclarationGeneration,
    mut PopupToken inOutPopup,
    mut u64 inOutFocusLossGeneration,
    mut u64 inOutHoverActivityGeneration,
    mut TooltipOptions inOutOptions,
    mut PopupPlacement inOutPlacement,
    mut b8 inOutHovered,
    mut b8 inOutVisible,
    mut f64 inOutElapsed
){
    if(!anchor.valid() || declarationGeneration == 0u || (!popup.valid() && !popup.empty()) || !isFinite(deltaSeconds) || deltaSeconds < 0.0f || !IsValidTooltipOptions(options))
        return makeUnexpected(Failure());
    const b8 sameBinding = inOutAnchor == anchor
        && inOutDeclarationGeneration == declarationGeneration
        && inOutPopup == popup
        && inOutFocusLossGeneration == focusLossGeneration
        && inOutHoverActivityGeneration == hoverActivityGeneration;
    const b8 sameOptions = inOutOptions == options;
    const b8 activeHover = options.enabled && hovered;
    f64 elapsed = 0.0;
    if(activeHover && inOutHovered && sameBinding && sameOptions)
        elapsed = min(inOutElapsed + cast<f64>(deltaSeconds), cast<f64>(options.delaySeconds));
    const b8 visible = activeHover && elapsed >= cast<f64>(options.delaySeconds);
    b8 changed = false;
    if(!sameBinding || !sameOptions || inOutHovered != activeHover || inOutElapsed != elapsed || inOutVisible != visible){
        changed = true;
        inOutAnchor = anchor;
        inOutDeclarationGeneration = declarationGeneration;
        inOutPopup = popup;
        inOutFocusLossGeneration = focusLossGeneration;
        inOutHoverActivityGeneration = hoverActivityGeneration;
        inOutOptions = options;
        inOutElapsed = elapsed;
        inOutHovered = activeHover;
        inOutVisible = visible;
        if(!visible || !sameBinding || !sameOptions)
            inOutPlacement = PopupPlacement();
    }
    return changed;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

