void VerifyEditCaretFixture_MappingEndpointOrderAndBoundsFailuresPreservePriorGeometry(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("abc", EditTextMode::SingleLine));
    Array<usize, 28u> committed = Array<usize, 28u>();
    committed[0u] = 1u; committed[1u] = 1u; committed[2u] = 2u; committed[3u] = 3u;
    committed[4u] = 0u; committed[5u] = 1u; committed[6u] = 2u; committed[7u] = 3u;
    committed[8u] = 0u; committed[9u] = 1u; committed[10u] = 2u; committed[11u] = 2u;
    committed[12u] = 0u; committed[13u] = 1u; committed[14u] = 2u; committed[15u] = 3u;
    committed[16u] = 0u; committed[17u] = 2u; committed[18u] = 1u; committed[19u] = 3u;
    committed[20u] = 0u; committed[21u] = 1u; committed[22u] = 2u; committed[23u] = 3u;
    committed[24u] = 0u; committed[25u] = 4u; committed[26u] = 4u; committed[27u] = 3u;

    Array<usize, 28u> display = Array<usize, 28u>();
    display[0u] = 0u; display[1u] = 1u; display[2u] = 2u; display[3u] = 3u;
    display[4u] = 1u; display[5u] = 1u; display[6u] = 2u; display[7u] = 3u;
    display[8u] = 0u; display[9u] = 1u; display[10u] = 2u; display[11u] = 3u;
    display[12u] = 0u; display[13u] = 1u; display[14u] = 2u; display[15u] = 2u;
    display[16u] = 0u; display[17u] = 1u; display[18u] = 2u; display[19u] = 3u;
    display[20u] = 0u; display[21u] = 2u; display[22u] = 1u; display[23u] = 3u;
    display[24u] = 0u; display[25u] = 1u; display[26u] = 2u; display[27u] = 3u;

    for(usize caseIndex = 0u; caseIndex < 7u; ++caseIndex){
        self.m_mapping.clear();
        for(usize entryIndex = 0u; entryIndex < 4u; ++entryIndex){
            const usize flat = caseIndex * 4u + entryIndex;
            self.m_mapping.push_back(MakeUiEditCaretMapping(committed[flat], display[flat]));
        }
        EXPECT_FALSE(self.adopt("abc", 3u, EditTextMode::SingleLine));
        EXPECT_EQ(self.m_geometry.layout().utf8(), "abc");
        ASSERT_EQ(self.m_geometry.caretStops().size(), 4u);
        self.expectCaret(1u, 10.0f, 0.0f);
    }
}

void VerifyEditCaretFixture_NativeMappingAcceptsScalarEdgesButRejectsContinuationBytes(mut EditCaretFixture self){
    self.m_mapping.push_back(MakeUiEditCaretMapping(0u, 0u));
    self.m_mapping.push_back(MakeUiEditCaretMapping(1u, 1u));
    self.m_mapping.push_back(MakeUiEditCaretMapping(2u, 3u));
    ASSERT_TRUE(self.adopt("e\xcc\x81", 2u, EditTextMode::SingleLine));
    EXPECT_FLOAT_EQ(self.m_geometry.caretStops()[1u].x, 5.0f);
    self.m_mapping[1u].displayByte = 2u;
    EXPECT_FALSE(self.adopt("e\xcc\x81", 2u, EditTextMode::SingleLine));
    EXPECT_EQ(self.m_geometry.caretStops()[1u].displayByte, 1u);
}

void VerifyEditCaretFixture_MultilineRequiresCanonicalLfAndSingleLineRejectsHardBreaks(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("base", EditTextMode::SingleLine));
    EXPECT_FALSE(self.adoptText("ab\r\nc", EditTextMode::Multiline));
    EXPECT_FALSE(self.adoptText("ab\nc", EditTextMode::SingleLine));
    EXPECT_FALSE(self.adoptText("abc", MakeUiInvalidEditTextMode()));
    EXPECT_EQ(self.m_geometry.layout().utf8(), "base");
    EXPECT_EQ(self.m_geometry.textMode(), EditTextMode::SingleLine);
}

void VerifyEditCaretFixture_RtlAndMalformedClusterCoverageCannotReplaceReadyLtrGeometry(mut EditCaretFixture self){
    const StringView text = "abc";
    ASSERT_TRUE(self.adoptText("base", EditTextMode::SingleLine));
    ASSERT_TRUE(self.identityMapping(text));
    EXPECT_FALSE(UiEditCaretAdoptBuiltLayout(self, text, text, 3u, EditTextMode::SingleLine, TextDirection::RightToLeft));
    Array<UiEditCaretShaperFaultEnum, 4u> faults = Array<UiEditCaretShaperFaultEnum, 4u>();
    faults[0u] = UiEditCaretShaperFault::LeadingGap;
    faults[1u] = UiEditCaretShaperFault::TrailingGap;
    faults[2u] = UiEditCaretShaperFault::Overlap;
    faults[3u] = UiEditCaretShaperFault::InconsistentGlyphEnd;
    for(in UiEditCaretShaperFaultEnum fault : faults){
        const ScopedTestTrace trace = ScopedTestTrace(cast<u32>(fault));
        self.m_shaper.fault = fault;
        EXPECT_FALSE(UiEditCaretAdoptBuiltLayout(self, text, text, 3u, EditTextMode::SingleLine));
        EXPECT_EQ(self.m_geometry.layout().utf8(), "base");
        self.expectCaret(1u, 10.0f, 0.0f);
    }
}

void VerifyEditCaretFixture_NonfiniteDerivedGlyphPlacementCannotReplaceReadyGeometry(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("base", EditTextMode::SingleLine));
    self.m_shaper.fault = UiEditCaretShaperFault::NonfinitePlacement;
    EXPECT_FALSE(self.layout("ab").has_value());
    EXPECT_EQ(self.m_geometry.layout().utf8(), "base");
    self.expectCaret(1u, 10.0f, 0.0f);
    self.m_shaper.fault = UiEditCaretShaperFault::None;
    EXPECT_FALSE(UiEditCaretAdoptNonfinitePlacement(self));
    EXPECT_EQ(self.m_geometry.layout().utf8(), "base");
}

void VerifyEditCaretFixture_MalformedLineRecordsCannotReplaceReadyGeometry(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("base", EditTextMode::SingleLine));
    ASSERT_TRUE(self.identityMapping("a\nb"));
    for(u32 mutation = 0u; mutation < 14u; ++mutation){
        const ScopedTestTrace trace = ScopedTestTrace(mutation);
        EXPECT_FALSE(UiEditCaretAdoptMutatedLineRecord(self, mutation));
        EXPECT_EQ(self.m_geometry.layout().utf8(), "base");
        EXPECT_EQ(self.m_geometry.textMode(), EditTextMode::SingleLine);
        self.expectCaret(1u, 10.0f, 0.0f);
    }
}

void VerifyEditCaretFixture_OwnedGeometrySurvivesSourceAndMappingChangesAndMoves(mut EditCaretFixture self){
    String source = "ab\nc";
    ASSERT_TRUE(self.adoptText(source));
    source.assign("replacement");
    self.m_mapping.clear();
    EditCaretGeometry moved = EditCaretGeometry(self.m_arena);
    UiEditCaretMoveGeometry(self.m_geometry, moved);
    EXPECT_EQ(moved.layout().utf8(), "ab\nc");
    ASSERT_EQ(moved.lines().size(), 2u);
    const Expected<Rect> rectangle = moved.caretRect(4u);
    ASSERT_TRUE(rectangle.has_value());
    EXPECT_FLOAT_EQ(rectangle.value().x, 10.0f);
    EXPECT_FLOAT_EQ(rectangle.value().y, 12.0f);
    EditCaretGeometry assigned = EditCaretGeometry(self.m_arena);
    UiEditCaretMoveGeometry(moved, assigned);
    const Expected<usize> byte = assigned.hitTest(MakeUiControlCaretPoint(10.0f, 14.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 4u);
}

void VerifyEditCaretFixture_ZeroAdvanceStopsKeepTheFirstExactTieAndFiniteExtremesStayQueryable(mut EditCaretFixture self){
    self.m_shaper.zeroAdvance = true;
    ASSERT_TRUE(self.adoptText("abc", EditTextMode::SingleLine));
    Expected<usize> byte = self.m_geometry.hitTest(MakeUiControlCaretPoint(0.0f, 0.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 0u);
    byte = self.m_geometry.hitTest(MakeUiControlCaretPoint(f32.max, 0.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 0u);
    byte = self.m_geometry.hitTest(MakeUiControlCaretPoint(-f32.max, 0.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 0u);
    self.m_shaper.zeroAdvance = false;
    ASSERT_TRUE(self.adoptText("abc", EditTextMode::SingleLine));
    byte = self.m_geometry.hitTest(MakeUiControlCaretPoint(-f32.max, 0.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 0u);
    byte = self.m_geometry.hitTest(MakeUiControlCaretPoint(f32.max, 0.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 3u);
}

void VerifyEditCaretFixture_VariableLineHeightsDetermineCaretAndHitBoundaries(mut EditCaretFixture self){
    self.m_shaper.variedHeight = true;
    ASSERT_TRUE(self.adoptText("a\nTALL\nb"));
    self.expectCaret(2u, 0.0f, 12.0f, 20.0f);
    self.expectCaret(7u, 0.0f, 32.0f);
    Expected<usize> byte = self.m_geometry.hitTest(MakeUiControlCaretPoint(0.0f, 31.9f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 2u);
    byte = self.m_geometry.hitTest(MakeUiControlCaretPoint(0.0f, 32.0f));
    ASSERT_TRUE(byte.has_value());
    EXPECT_EQ(byte.value(), 7u);
}

void VerifyEditCaretFixture_InvalidCoordinatesAndCaretOffsetsRejectQueries(mut EditCaretFixture self){
    ASSERT_TRUE(self.adoptText("e\xcc\x81\nx"));
    Array<Point, 2u> invalid = Array<Point, 2u>();
    invalid[0u] = MakeUiControlCaretPoint(UiControlCaretQuietNaNF32(), 0.0f);
    invalid[1u] = MakeUiControlCaretPoint(0.0f, UiControlCaretInfinityF32());
    for(in Point point : invalid)
        EXPECT_FALSE(self.m_geometry.hitTest(point).has_value());
    EXPECT_FALSE(self.m_geometry.verticalTarget(2u, true, 10.0f).has_value());
    EXPECT_FALSE(self.m_geometry.verticalTarget(0u, true, UiControlCaretQuietNaNF32()).has_value());
    EXPECT_FALSE(self.m_geometry.verticalTarget(6u, true, 10.0f).has_value());
    EXPECT_FALSE(self.m_geometry.caretRect(6u).has_value());
}


