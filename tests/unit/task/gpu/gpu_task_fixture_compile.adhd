[[nodiscard]] constexpr Core::GpuQueueCapability::Mask CombineQueueCapabilities(
    const Core::GpuQueueCapability::Mask first,
    const Core::GpuQueueCapability::Mask second = Core::GpuQueueCapability::None,
    const Core::GpuQueueCapability::Mask third = Core::GpuQueueCapability::None
)noexcept{
    return static_cast<Core::GpuQueueCapability::Mask>(static_cast<u8>(first) | static_cast<u8>(second) | static_cast<u8>(third));
}

[[nodiscard]] constexpr Core::GpuQueueCapability::Mask MaskOutQueueCapability(
    const Core::GpuQueueCapability::Mask mask,
    const Core::GpuQueueCapability::Mask excluded
)noexcept{
    return static_cast<Core::GpuQueueCapability::Mask>(static_cast<u8>(mask) & static_cast<u8>(~static_cast<u8>(excluded)));
}

template<typename T>
[[nodiscard]] FOUNDATION_INLINE Span<const T> PrefixSpan(const Span<const T> items, const usize count)noexcept{
    return Span<const T>(items.data(), count);
}

template<typename T>
[[nodiscard]] FOUNDATION_INLINE Span<const T> SubSpan(const Span<const T> items, const usize offset, const usize count)noexcept{
    return Span<const T>(items.data() + offset, count);
}

