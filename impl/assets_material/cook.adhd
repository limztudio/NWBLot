#include <impl/assets_material/bind.adhd>
#include <impl/assets_material/cook_shader_generation.adhd>
#include <impl/assets_material/cook_shader_metadata_and_asset_emit.adhd>
#include <impl/assets_material/material_avboit_shader_generator.adhd>
#include <impl/assets_material/material_shadow_dispatch.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static_assert(size_of<MaterialTypedValueData>() == size_of<u32>() * s_MaterialTypedValueRecordWordCount, "MaterialTypedValueData layout must stay stable for typed value parsing");
static_assert(align_of<MaterialTypedValueData>() >= align_of<u32x4>(), "MaterialTypedValueData must stay SIMD-aligned");
static_assert(is_trivially_copyable<MaterialTypedValueData>(), "MaterialTypedValueData must stay cheap to copy");

b8 FillMaterialBindEntry(in Path file, in MetascriptDocument document, mut MaterialBindEntry entry){
    entry.source.assign(StringView(PathToString(file)));
    if(!CheckMetadataSourceExtension(file, entry.source, s_MaterialBindSourceExtensionText, s_MaterialBindDiagnosticPrefix))
        return false;
    if(document.structCount() == 0u){
        error("Material bind '{}': struct declarations must not be empty", file);
        return false;
    }
    entry.structs.reserve(document.structCount());
    in auto fileRef = file;
    if(!document.forEachStruct(lambda[in fileRef, mut entry](in StringView name, in MetascriptValue value) -> b8{
        return AppendParsedValue<MaterialBindStruct>(entry.structs, entry.parseStruct(fileRef, name, value));
    }))
        return false;
    SortSequence<MaterialBindStruct>(entry.structs, lambda[](in MaterialBindStruct lhs, in MaterialBindStruct rhs) -> b8{
        return IsBeforeMaterialBindStructName(lhs.name, rhs.name);
    });
    if(document.declarationCount() == 0u){
        error("Material bind '{}': instance declarations must not be empty", file);
        return false;
    }
    entry.instances.reserve(document.declarationCount());
    in MetascriptDocument documentRef = document;
    return document.forEachDeclaration(lambda[in fileRef, in documentRef, mut entry](in StringView typeName, in StringView instanceName) -> b8{
        if(!documentRef.visitVariable(instanceName, lambda[](in MetascriptValue value) -> b8{ return value.isNull(); })){
            error("Material bind '{}': instance '{}' must not have an initializer or assignments", fileRef, instanceName);
            return false;
        }
        MaterialBindSchemaValidator validator;
        return validator.validateAndAppendMaterialBindInstance(entry.source, entry.structs, typeName, instanceName, entry.instances);
    });
}

Expected<MaterialBindEntry> ParseMaterialBindSource(in Path file){
    MaterialBindEntry entry;
    in auto fileRef = file;
    if(!VisitMetadataDocumentFile(file, s_MaterialBindDiagnosticPrefix, lambda[in fileRef, mut entry](in MetascriptDocument document) -> b8{
        return FillMaterialBindEntry(fileRef, document, entry);
    }))
        return MakeUnexpected(Failure());
    return entry;
}


