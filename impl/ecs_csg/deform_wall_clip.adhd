#include <impl/ecs_csg/deform_cap_loop.adhd>
#include <impl/ecs_csg/deform_cutter_field.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<u32> SplitCsgDeformEdgeVertex(
    in u32 first,
    in u32 second,
    in f32 firstDistance,
    in f32 secondDistance,
    mut Vector<CsgDeformVertex> vertices,
    mut HashMap<u64, u32> edgeSplits
){
    if(vertices.size() + 1u > s_MaxDeformVertices)
        return MakeUnexpected(Failure());
    const u64 edge = PackUnorderedU32Pair(first, second);
    if(edgeSplits.contains(edge))
        return edgeSplits[edge];
    const CsgDeformVertex firstVertex = vertices[cast<usize>(first)];
    const CsgDeformVertex secondVertex = vertices[cast<usize>(second)];
    // A zero secondDistance selects the second endpoint.
    const Expected<CsgDeformVertex> mixed = TryBuildInterpolatedCsgDeformVertex(firstVertex, secondVertex, firstDistance, secondDistance);
    if(!mixed.has_value())
        return MakeUnexpected(Failure());
    const u32 created = cast<u32>(vertices.size());
    vertices.push_back(mixed.value());
    edgeSplits.try_emplace(edge, created);
    return created;
}

Expected<b8, CsgDeformViabilityReason> ClipCsgDeformShellWithDistances(
    in Span<f32> distances,
    mut HashMap<u64, u32> edgeSplits,
    mut Vector<CsgDeformTriangle> scratchKept,
    mut Vector<CsgDeformVertex> inOutVertices,
    mut Vector<CsgDeformTriangle> inOutTriangles
){
    edgeSplits.clear();
    edgeSplits.reserve(inOutTriangles.size() * s_EdgesPerTriangle + s_ReserveSlack);
    scratchKept.clear();
    scratchKept.reserve(inOutTriangles.size() * s_KeptReserveMultiplier + s_ReserveSlack);

    const usize triangleCount = inOutTriangles.size();
    for(usize triangleIndex = 0u; triangleIndex < triangleCount; ++triangleIndex){
        const CsgDeformTriangle triangle = inOutTriangles[triangleIndex];
        assert(cast<usize>(triangle.indices[0u]) < inOutVertices.size());
        assert(cast<usize>(triangle.indices[1u]) < inOutVertices.size());
        assert(cast<usize>(triangle.indices[2u]) < inOutVertices.size());
        const CsgDeformTriangleClipPlan plan = ClassifyCsgDeformTriangleClip(triangle, distances);
        if(plan.keepCount == s_TriangleCornerCount){
            scratchKept.push_back(MakeCsgDeformTriangle(triangle.indices[0u], triangle.indices[1u], triangle.indices[2u]));
            continue;
        }
        if(plan.keepCount == 0u)
            continue;
        const Expected<u32> splitA = SplitCsgDeformEdgeVertex(plan.firstEdgeStart, plan.firstEdgeEnd, plan.firstEdgeStartDistance, plan.firstEdgeEndDistance, inOutVertices, edgeSplits);
        if(!splitA.has_value())
            return MakeUnexpected(CsgDeformViabilityReason::NoKeptGeometry);
        const Expected<u32> splitB = SplitCsgDeformEdgeVertex(plan.secondEdgeStart, plan.secondEdgeEnd, plan.secondEdgeStartDistance, plan.secondEdgeEndDistance, inOutVertices, edgeSplits);
        if(!splitB.has_value())
            return MakeUnexpected(CsgDeformViabilityReason::NoKeptGeometry);
        scratchKept.push_back(MakeCsgDeformTriangle(plan.primaryCorner, splitA.value(), splitB.value()));
        if(plan.keepCount == 2u)
            scratchKept.push_back(MakeCsgDeformTriangle(plan.primaryCorner, splitB.value(), plan.secondKeepVertex));
        if(scratchKept.size() > s_MaxDeformTriangles)
            return MakeUnexpected(CsgDeformViabilityReason::NoKeptGeometry);
    }
    inOutTriangles = scratchKept;
    return true;
}

void PrepareCsgDeformPreviewBuffers(
    in Span<CsgDeformVertex> inputVertices,
    in Span<CsgDeformTriangle> inputTriangles,
    in usize cutCount,
    mut Vector<CsgDeformVertex> outVertices,
    mut Vector<CsgDeformTriangle> outTriangles
){
    const usize inputVertexCount = inputVertices.size();
    const usize inputTriangleCount = inputTriangles.size();
    outVertices.clear();
    outTriangles.clear();
    outVertices.reserve(inputVertexCount + cutCount * s_RebuildReservePerCut);
    outTriangles.reserve(inputTriangleCount * cast<usize>(s_KeptReserveMultiplier) + cutCount * s_RebuildReservePerCut);
    for(usize i = 0u; i < inputVertexCount; ++i)
        outVertices.push_back(inputVertices[i]);
    for(usize i = 0u; i < inputTriangleCount; ++i)
        outTriangles.push_back(inputTriangles[i]);
}


