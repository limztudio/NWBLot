#include <impl/assets_shader/cook_internal.adhd>
#include <impl/assets_shader/cook_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<b8> CheckShaderIncludeCandidate(in Path candidate){
    const Expected<b8, ErrorCode> exists = IsRegularFile(candidate);
    if(exists.has_value())
        return exists.value();
    if(IsMissingPathError(exists.error()))
        return false;
    error("Failed to query include candidate '{}': {}", candidate, ErrorCodeMessage(exists.error()));
    return MakeUnexpected(Failure());
}

Expected<Path> ResolveShaderIncludeFile<Directories>(
    in StringView includeName,
    in IncludeKind kind,
    in Path sourceDirectory,
    in Directories directories
){
    if(kind == IncludeKind::Relative){
        const Path localCandidate = (sourceDirectory / includeName).lexicallyNormal();
        const Expected<b8> local = CheckShaderIncludeCandidate(localCandidate);
        if(!local.has_value())
            return MakeUnexpected(Failure());
        if(local.value())
            return localCandidate;
    }
    for(in auto directory : directories){
        const Path base(directory);
        const Path candidate = (base / includeName).lexicallyNormal();
        const Expected<b8> found = CheckShaderIncludeCandidate(candidate);
        if(!found.has_value())
            return MakeUnexpected(Failure());
        if(found.value())
            return candidate;
    }
    return MakeUnexpected(Failure());
}

b8 GatherShaderSourceDependencies<Directories, Dependencies>(
    in Path sourcePath,
    in Directories directories,
    in Span<StringView> plannedMacroIncludes,
    mut Vector<Dependencies> dependencies
){
    dependencies.clear();
    HashSet<String> visited;
    Vector<Path> pending;
    AppendOwnedPath(pending, sourcePath);
    String sourceText;
    while(!pending.empty()){
        const Path dependency(pending.back());
        pending.pop_back();
        const Expected<Path, ErrorCode> absolute = AbsolutePath(dependency);
        if(!absolute.has_value()){
            error("Failed to resolve dependency path '{}' : {}", dependency, ErrorCodeMessage(absolute.error()));
            return false;
        }
        const Path path = absolute.value().lexicallyNormal();
        if(!visited.insert(NativePathComparisonKey(path)).second)
            continue;
        sourceText.clear();
        const Expected<void, ErrorCode> read = ReadTextFile(path, sourceText);
        if(!read.has_value()){
            error("Failed to read dependency '{}': {}:{}", path, ErrorCodeCategoryName(read.error()), read.error().value());
            return false;
        }
        StripUtf8Bom(sourceText);
        SpliceSourceLines(sourceText);
        MaskCStyleSourceComments(sourceText);
        AppendOwnedPath(dependencies, path);

        const StringView text = StringView(sourceText);
        usize start = 0u;
        while(start < text.size()){
            const Expected<StringView> lineResult = NextTextLine(text, start);
            if(!lineResult.has_value())
                return false;
            const StringView line = lineResult.value();
            const Expected<IncludeDirective> directive = TryExtractIncludeDirective(line);
            if(!directive.has_value())
                continue;
            const StringView name = directive.value().name;
            const IncludeKind kind = directive.value().kind;
            if(kind == IncludeKind::Macro || kind == IncludeKind::Unsupported){
                if(kind == IncludeKind::Macro && IsExternallyPlannedMacroInclude(plannedMacroIncludes, name))
                    continue;
                error("ShaderCook: unsupported or untracked dependency directive '{}' in '{}'", TrimView(line), path);
                return false;
            }
            const Expected<Path> include = ResolveShaderIncludeFile(name, kind, path.parentPath(), directories);
            if(!include.has_value()){
                error("Unable to resolve include '{}' from '{}'", name, path);
                return false;
            }
            pending.push_back(include.value());
        }
    }
    return true;
}


