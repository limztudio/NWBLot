////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/mesh/mesh_view_state_policy.adhd>
#include <impl/ecs_scene/camera.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<impl/assets/graphics/mesh/runtime_constants.h>"), cpp_name("NWB_MESH_VIEW_FLOAT_COUNT")]
extern const u32 s_ShaderMeshViewFloatCount;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static_assert(size_of<MeshViewGpuData>() == size_of<f32>() * s_ShaderMeshViewFloatCount, "MeshViewGpuData layout must match the mesh shaders");
static_assert(align_of<MeshViewGpuData>() >= align_of<f32x4>(), "MeshViewGpuData must stay SIMD-aligned");


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


MeshViewGpuData ResolveMeshViewState(in f32 fallbackAspectRatio, mut World world){
    MatrixSingle viewBasis = BuildDefaultSceneViewBasis();
    CameraProjection projection = StoreDefaultCameraProjection(fallbackAspectRatio);

    const SceneCameraView cameraView = ResolveSceneCameraView(world, fallbackAspectRatio);
    if(cameraView.valid()){
        viewBasis = BuildSceneViewBasis(LoadFloat(cameraView.components.value().transform.position), LoadFloat(cameraView.components.value().transform.rotation));
        projection = cameraView.projection;
    }

    return MeshViewStatePolicy().build(
        viewBasis[0u],
        viewBasis[1u],
        viewBasis[2u],
        viewBasis[3u],
        LoadFloat(projection.projectionParams),
        projection.tanHalfVerticalFov,
        projection.aspectRatio,
        projection.nearPlane,
        projection.farPlane
    );
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

