////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/physics/shapes.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class QuickhullFace{
    public FixedVector<u32, 32u> vertices;
    public Vector<u32> conflicts;
    public Plane3D plane;
    public b8 alive = true;
}

Expected<Plane3D> ComputeTrianglePlane(in VectorSingle a, in VectorSingle b, in VectorSingle c){
    const VectorSingle raw = Cross(VectorSingle(b - a, 0.0f), VectorSingle(c - a, 0.0f));
    const f32 lenSq = Vector3LengthSq(raw).x;
    if(!IsFinite(VectorSingle(lenSq)) || lenSq <= 1.0e-12f)
        return MakeUnexpected(Failure());
    const VectorSingle normal = VectorSingle(raw * Rsqrt(VectorSingle(lenSq)), 0.0f);
    const f32 offset = Vector3Dot(normal, VectorSingle(a, 0.0f)).x;
    return Plane3D(normal, offset);
}

QuickhullFace MakeTriangleFace(in VectorSingle a, in VectorSingle b, in VectorSingle c, in u32 i0, in u32 i1, in u32 i2, in VectorSingle interior){
    QuickhullFace f;
    f.vertices.push_back(i0);
    f.vertices.push_back(i1);
    f.vertices.push_back(i2);
    const Expected<Plane3D> plane = ComputeTrianglePlane(a, b, c);
    if(!plane.has_value()){
        f.alive = false;
        return f;
    }
    VectorSingle n(plane.value().normalOffset, 0.0f);
    f32 d = plane.value().normalOffset.w;
    if(Vector3Dot(n, VectorSingle(interior, 0.0f)).x - d > 0.0f){
        const u32 tmp = f.vertices[1u];
        f.vertices[1u] = f.vertices[2u];
        f.vertices[2u] = tmp;
        n = -n;
        d = -d;
    }
    f.plane = Plane3D(n, d);
    return f;
}

b8 TryMergeCoplanarHullFaces(
    in Vector<QuickhullFace> faces,
    in Vector<u32> liveFaces,
    in Span<f32x4> uniquePts,
    in VectorSingle interior,
    mut Vector<QuickhullFace> outMergedFaces
){
    outMergedFaces.clear();
    const usize faceCount = liveFaces.size();
    if(faceCount < 4u)
        return false;

    for(usize i = 0u; i < faceCount; ++i){
        if(faces[liveFaces[i]].vertices.size() != 3u)
            return false;
    }

    Vector<u32> twinTri(faceCount * 3u, s_NullIndex);
    for(usize i = 0u; i < faceCount; ++i){
        in QuickhullFace fi = faces[liveFaces[i]];
        for(usize k = 0u; k < 3u; ++k){
            if(twinTri[i * 3u + k] != s_NullIndex)
                continue;
            const u32 a = fi.vertices[k];
            const u32 b = fi.vertices[(k + 1u) % 3u];
            b8 foundTwin = false;
            for(usize j = i + 1u; j < faceCount; ++j){
                in QuickhullFace fj = faces[liveFaces[j]];
                for(usize m = 0u; m < 3u; ++m){
                    if(fj.vertices[m] == b && fj.vertices[(m + 1u) % 3u] == a){
                        twinTri[i * 3u + k] = cast<u32>(j);
                        twinTri[j * 3u + m] = cast<u32>(i);
                        foundTwin = true;
                        break;
                    }
                }
                if(foundTwin)
                    break;
            }
            if(!foundTwin)
                return false;
        }
    }

    Vector<u32> compId(faceCount, s_NullIndex);
    u32 compCount = 0u;
    Vector<u32> bfsQueue;
    bfsQueue.reserve(faceCount);

    for(usize seed = 0u; seed < faceCount; ++seed){
        if(compId[seed] != s_NullIndex)
            continue;
        const u32 cid = compCount;
        ++compCount;
        compId[seed] = cid;
        bfsQueue.clear();
        bfsQueue.push_back(cast<u32>(seed));

        const VectorSingle nSeed = VectorSingle(faces[liveFaces[seed]].plane.normalOffset, 0.0f);
        const f32 offSeed = faces[liveFaces[seed]].plane.normalOffset.w;

        usize head = 0u;
        while(head < bfsQueue.size()){
            const u32 cur = bfsQueue[head];
            ++head;
            for(usize k = 0u; k < 3u; ++k){
                const u32 nbr = twinTri[cur * 3u + k];
                if(nbr == s_NullIndex || compId[nbr] != s_NullIndex)
                    continue;
                const VectorSingle nNbr = VectorSingle(faces[liveFaces[nbr]].plane.normalOffset, 0.0f);
                const f32 offNbr = faces[liveFaces[nbr]].plane.normalOffset.w;
                if(Vector3Dot(nSeed, nNbr).x >= 0.9999f && Abs(VectorSingle(offSeed - offNbr)).x <= 1.0e-4f){
                    compId[nbr] = cid;
                    bfsQueue.push_back(nbr);
                }
            }
        }
    }

    if(compCount == cast<u32>(faceCount) || compCount < 4u || compCount > s_MaxHullFaces)
        return false;

    outMergedFaces.reserve(compCount);
    usize totalHalfEdges = 0u;
    for(u32 cid = 0u; cid < compCount; ++cid){
        Vector<u32> edgeStart;
        Vector<u32> edgeEnd;
        for(usize t = 0u; t < faceCount; ++t){
            if(compId[t] != cid)
                continue;
            in QuickhullFace qt = faces[liveFaces[t]];
            for(usize k = 0u; k < 3u; ++k){
                const u32 nbr = twinTri[t * 3u + k];
                if(compId[nbr] != cid){
                    edgeStart.push_back(qt.vertices[k]);
                    edgeEnd.push_back(qt.vertices[(k + 1u) % 3u]);
                }
            }
        }

        if(edgeStart.size() < 3u || edgeStart.size() > s_MaxHullFaceVertices){
            for(usize t = 0u; t < faceCount; ++t){
                if(compId[t] != cid)
                    continue;
                outMergedFaces.push_back(faces[liveFaces[t]]);
                totalHalfEdges += faces[liveFaces[t]].vertices.size();
            }
            continue;
        }

        FixedVector<u32, 32u> loop;
        u32 curStart = edgeStart[0u];
        u32 curNext = edgeEnd[0u];
        Vector<u8> usedEdge(edgeStart.size(), 0u);
        usedEdge[0u] = 1u;
        loop.push_back(curStart);

        b8 loopOk = true;
        for(usize step = 1u; step < edgeStart.size(); ++step){
            if(curNext == curStart){
                loopOk = false;
                break;
            }
            loop.push_back(curNext);
            b8 foundNext = false;
            for(usize e = 0u; e < edgeStart.size(); ++e){
                if(usedEdge[e] != 0u)
                    continue;
                if(edgeStart[e] == curNext){
                    usedEdge[e] = 1u;
                    curNext = edgeEnd[e];
                    foundNext = true;
                    break;
                }
            }
            if(!foundNext){
                loopOk = false;
                break;
            }
        }
        if(loopOk && curNext != curStart)
            loopOk = false;

        VectorSingle newellN(0.0f);
        if(loopOk){
            for(usize vi = 0u; vi < loop.size(); ++vi){
                const VectorSingle a = VectorSingle(uniquePts[loop[vi]]);
                const VectorSingle b = VectorSingle(uniquePts[loop[(vi + 1u) % loop.size()]]);
                const VectorSingle aYzx(a.y, a.z, a.x, 0.0f);
                const VectorSingle bYzx(b.y, b.z, b.x, 0.0f);
                const VectorSingle aZxy(a.z, a.x, a.y, 0.0f);
                const VectorSingle bZxy(b.z, b.x, b.y, 0.0f);
                newellN = newellN + VectorSingle((aYzx - bYzx) * (aZxy + bZxy), 0.0f);
            }
        }
        const f32 nLenSq = Vector3LengthSq(newellN).x;
        if(!loopOk || !IsFinite(VectorSingle(nLenSq)) || nLenSq <= 1.0e-12f){
            for(usize t = 0u; t < faceCount; ++t){
                if(compId[t] != cid)
                    continue;
                outMergedFaces.push_back(faces[liveFaces[t]]);
                totalHalfEdges += faces[liveFaces[t]].vertices.size();
            }
            continue;
        }
        const VectorSingle planeN = newellN * Rsqrt(VectorSingle(nLenSq));
        if(Vector3Dot(planeN, VectorSingle(VectorSingle(uniquePts[loop[0u]]) - interior, 0.0f)).x < 0.0f){
            for(usize t = 0u; t < faceCount; ++t){
                if(compId[t] != cid)
                    continue;
                outMergedFaces.push_back(faces[liveFaces[t]]);
                totalHalfEdges += faces[liveFaces[t]].vertices.size();
            }
            continue;
        }

        f32 maxOff = -s_MaxF32;
        for(usize vi = 0u; vi < loop.size(); ++vi){
            const f32 d = Vector3Dot(planeN, VectorSingle(uniquePts[loop[vi]], 0.0f)).x;
            if(d > maxOff)
                maxOff = d;
        }
        b8 convexOk = true;
        for(usize vi = 0u; vi < loop.size(); ++vi){
            const VectorSingle vPrev = VectorSingle(uniquePts[loop[(vi + loop.size() - 1u) % loop.size()]]);
            const VectorSingle vCur = VectorSingle(uniquePts[loop[vi]]);
            const VectorSingle vNext = VectorSingle(uniquePts[loop[(vi + 1u) % loop.size()]]);
            const VectorSingle turn = Cross(VectorSingle(vCur - vPrev, 0.0f), VectorSingle(vNext - vCur, 0.0f));
            if(Vector3Dot(turn, planeN).x < -1.0e-5f){
                convexOk = false;
                break;
            }
        }
        if(!convexOk){
            for(usize t = 0u; t < faceCount; ++t){
                if(compId[t] != cid)
                    continue;
                outMergedFaces.push_back(faces[liveFaces[t]]);
                totalHalfEdges += faces[liveFaces[t]].vertices.size();
            }
            continue;
        }

        QuickhullFace merged;
        merged.vertices = loop;
        merged.plane = Plane3D(planeN, maxOff);
        merged.alive = true;
        outMergedFaces.push_back(merged);
        totalHalfEdges += loop.size();
    }

    if(outMergedFaces.size() >= faceCount || outMergedFaces.size() > s_MaxHullFaces || totalHalfEdges > 255u || (totalHalfEdges / 2u) > s_MaxHullEdges)
        return false;

    for(usize f0 = 0u; f0 < outMergedFaces.size(); ++f0){
        in QuickhullFace mf0 = outMergedFaces[f0];
        for(usize e0 = 0u; e0 < mf0.vertices.size(); ++e0){
            const u32 a0 = mf0.vertices[e0];
            const u32 b0 = mf0.vertices[(e0 + 1u) % mf0.vertices.size()];
            b8 hasTwin = false;
            for(usize f1 = 0u; f1 < outMergedFaces.size(); ++f1){
                if(f1 == f0)
                    continue;
                in QuickhullFace mf1 = outMergedFaces[f1];
                for(usize e1 = 0u; e1 < mf1.vertices.size(); ++e1){
                    if(mf1.vertices[e1] == b0 && mf1.vertices[(e1 + 1u) % mf1.vertices.size()] == a0){
                        hasTwin = true;
                        break;
                    }
                }
                if(hasTwin)
                    break;
            }
            if(!hasTwin)
                return false;
        }
    }

    return true;
}

Vector<f32x4> DecimateHullPoints(in Span<f32x4> pts, in usize maxPoints){
    Vector<f32x4> selected;
    if(pts.size() <= maxPoints){
        selected.reserve(pts.size());
        for(usize i = 0u; i < pts.size(); ++i)
            selected.push_back(pts[i]);
        return selected;
    }

    selected.reserve(maxPoints);
    Vector<u8> used(pts.size(), 0u);
    Array<usize, 6u> extIdx;
    for(usize axis = 0u; axis < 3u; ++axis){
        usize lo = 0u;
        usize hi = 0u;
        f32 minV = VectorGetByIndex(VectorSingle(pts[0u]), cast<isize>(axis));
        f32 maxV = minV;
        for(usize i = 1u; i < pts.size(); ++i){
            const f32 v = VectorGetByIndex(VectorSingle(pts[i]), cast<isize>(axis));
            if(v < minV){
                minV = v;
                lo = i;
            }
            if(v > maxV){
                maxV = v;
                hi = i;
            }
        }
        extIdx[axis * 2u] = lo;
        extIdx[axis * 2u + 1u] = hi;
    }
    for(usize k = 0u; k < 6u; ++k){
        const usize idx = extIdx[k];
        if(used[idx] == 0u && selected.size() < maxPoints){
            used[idx] = 1u;
            selected.push_back(pts[idx]);
        }
    }

    Vector<f32> minDistSq(pts.size(), s_MaxF32);
    for(usize i = 0u; i < pts.size(); ++i){
        if(used[i] != 0u){
            minDistSq[i] = 0.0f;
            continue;
        }
        const VectorSingle p = VectorSingle(pts[i]);
        f32 best = s_MaxF32;
        for(usize s = 0u; s < selected.size(); ++s){
            const f32 dSq = Vector3LengthSq(VectorSingle(p - VectorSingle(selected[s]), 0.0f)).x;
            if(dSq < best)
                best = dSq;
        }
        minDistSq[i] = best;
    }

    while(selected.size() < maxPoints){
        usize bestIdx = s_NullIndex;
        f32 farthest = 1.0e-8f;
        for(usize i = 0u; i < pts.size(); ++i){
            if(used[i] == 0u && minDistSq[i] > farthest){
                farthest = minDistSq[i];
                bestIdx = i;
            }
        }
        if(bestIdx == s_NullIndex)
            break;
        used[bestIdx] = 1u;
        const VectorSingle added = VectorSingle(pts[bestIdx]);
        selected.push_back(pts[bestIdx]);
        for(usize i = 0u; i < pts.size(); ++i){
            if(used[i] != 0u)
                continue;
            const f32 dSq = Vector3LengthSq(VectorSingle(VectorSingle(pts[i]) - added, 0.0f)).x;
            if(dSq < minDistSq[i])
                minDistSq[i] = dSq;
        }
    }

    return selected;
}

Expected<HullShape> BuildConvexHullExact(in Span<f32x4> uniquePts, in f32 radius){
    if(uniquePts.size() < 4u || uniquePts.size() > s_MaxHullVertices)
        return MakeUnexpected(Failure());

    usize minIdx = 0u;
    usize maxIdx = 0u;
    for(usize axis = 0u; axis < 3u; ++axis){
        usize lo = 0u;
        usize hi = 0u;
        for(usize i = 1u; i < uniquePts.size(); ++i){
            const f32 v = VectorGetByIndex(VectorSingle(uniquePts[i]), cast<isize>(axis));
            if(v < VectorGetByIndex(VectorSingle(uniquePts[lo]), cast<isize>(axis)))
                lo = i;
            if(v > VectorGetByIndex(VectorSingle(uniquePts[hi]), cast<isize>(axis)))
                hi = i;
        }
        if(Vector3LengthSq(VectorSingle(VectorSingle(uniquePts[hi]) - VectorSingle(uniquePts[lo]), 0.0f)).x
            > Vector3LengthSq(VectorSingle(VectorSingle(uniquePts[maxIdx]) - VectorSingle(uniquePts[minIdx]), 0.0f)).x){
            minIdx = lo;
            maxIdx = hi;
        }
    }
    if(minIdx == maxIdx)
        return MakeUnexpected(Failure());

    const VectorSingle p0 = VectorSingle(uniquePts[minIdx]);
    const VectorSingle p1 = VectorSingle(uniquePts[maxIdx]);
    const VectorSingle lineDir = SafeNormalizeVec3(p1 - p0, VectorSingle(1.0f, 0.0f, 0.0f, 0.0f));

    usize thirdIdx = s_NullIndex;
    f32 bestLineDistSq = 1.0e-8f;
    for(usize i = 0u; i < uniquePts.size(); ++i){
        const VectorSingle rel = VectorSingle(uniquePts[i]) - p0;
        const VectorSingle perp = Cross(VectorSingle(rel, 0.0f), lineDir);
        const f32 dSq = Vector3LengthSq(perp).x;
        if(dSq > bestLineDistSq){
            bestLineDistSq = dSq;
            thirdIdx = i;
        }
    }
    if(thirdIdx == s_NullIndex)
        return MakeUnexpected(Failure());

    const VectorSingle p2 = VectorSingle(uniquePts[thirdIdx]);
    const Expected<Plane3D> triPlane = ComputeTrianglePlane(p0, p1, p2);
    if(!triPlane.has_value())
        return MakeUnexpected(Failure());
    const VectorSingle triN(triPlane.value().normalOffset, 0.0f);
    const f32 triD = triPlane.value().normalOffset.w;

    usize fourthIdx = s_NullIndex;
    f32 bestPlaneDist = 1.0e-4f;
    for(usize i = 0u; i < uniquePts.size(); ++i){
        const f32 dist = Abs(VectorSingle(Vector3Dot(triN, VectorSingle(uniquePts[i], 0.0f)).x - triD)).x;
        if(dist > bestPlaneDist){
            bestPlaneDist = dist;
            fourthIdx = i;
        }
    }
    if(fourthIdx == s_NullIndex)
        return MakeUnexpected(Failure());

    const VectorSingle p3 = VectorSingle(uniquePts[fourthIdx]);
    const VectorSingle interior = (p0 + p1 + p2 + p3) * 0.25f;

    Vector<QuickhullFace> faces;
    faces.push_back(MakeTriangleFace(p0, p1, p2, cast<u32>(minIdx), cast<u32>(maxIdx), cast<u32>(thirdIdx), interior));
    faces.push_back(MakeTriangleFace(p0, p1, p3, cast<u32>(minIdx), cast<u32>(maxIdx), cast<u32>(fourthIdx), interior));
    faces.push_back(MakeTriangleFace(p1, p2, p3, cast<u32>(maxIdx), cast<u32>(thirdIdx), cast<u32>(fourthIdx), interior));
    faces.push_back(MakeTriangleFace(p2, p0, p3, cast<u32>(thirdIdx), cast<u32>(minIdx), cast<u32>(fourthIdx), interior));

    for(usize i = 0u; i < uniquePts.size(); ++i){
        if(i == minIdx || i == maxIdx || i == thirdIdx || i == fourthIdx)
            continue;
        f32 maxDist = 1.0e-4f;
        usize bestFace = s_NullIndex;
        for(usize f = 0u; f < faces.size(); ++f){
            if(!faces[f].alive)
                continue;
            const f32 dist = Vector3Dot(VectorSingle(faces[f].plane.normalOffset, 0.0f), VectorSingle(uniquePts[i], 0.0f)).x - faces[f].plane.normalOffset.w;
            if(dist > maxDist){
                maxDist = dist;
                bestFace = f;
            }
        }
        if(bestFace != s_NullIndex)
            faces[bestFace].conflicts.push_back(cast<u32>(i));
    }

    while(true){
        usize chosenFace = s_NullIndex;
        u32 apexIdx = s_NullIndex;
        f32 maxDist = 1.0e-4f;
        for(usize f = 0u; f < faces.size(); ++f){
            if(!faces[f].alive || faces[f].conflicts.empty())
                continue;
            for(usize c = 0u; c < faces[f].conflicts.size(); ++c){
                const u32 pIdx = faces[f].conflicts[c];
                const f32 dist = Vector3Dot(VectorSingle(faces[f].plane.normalOffset, 0.0f), VectorSingle(uniquePts[pIdx], 0.0f)).x - faces[f].plane.normalOffset.w;
                if(dist > maxDist){
                    maxDist = dist;
                    chosenFace = f;
                    apexIdx = pIdx;
                }
            }
        }
        if(chosenFace == s_NullIndex || apexIdx == s_NullIndex)
            break;

        const VectorSingle apex = VectorSingle(uniquePts[apexIdx]);
        Vector<u32> visibleFaces;
        Vector<u8> isVisible;
        isVisible.resize(faces.size(), 0u);
        for(usize f = 0u; f < faces.size(); ++f){
            if(!faces[f].alive)
                continue;
            const f32 dist = Vector3Dot(VectorSingle(faces[f].plane.normalOffset, 0.0f), VectorSingle(apex, 0.0f)).x - faces[f].plane.normalOffset.w;
            if(dist > 1.0e-5f){
                isVisible[f] = 1u;
                visibleFaces.push_back(cast<u32>(f));
            }
        }
        if(visibleFaces.empty())
            break;

        Vector<u64> horizonEdges;
        for(usize v = 0u; v < visibleFaces.size(); ++v){
            const u32 fIdx = visibleFaces[v];
            in QuickhullFace face = faces[fIdx];
            const usize vc = face.vertices.size();
            for(usize e = 0u; e < vc; ++e){
                const u32 va = face.vertices[e];
                const u32 vb = face.vertices[(e + 1u) % vc];
                b8 sharedVisible = false;
                for(usize other = 0u; other < visibleFaces.size(); ++other){
                    const u32 ofIdx = visibleFaces[other];
                    if(ofIdx == fIdx)
                        continue;
                    in QuickhullFace oface = faces[ofIdx];
                    const usize ovc = oface.vertices.size();
                    for(usize oe = 0u; oe < ovc; ++oe){
                        if(oface.vertices[oe] == vb && oface.vertices[(oe + 1u) % ovc] == va){
                            sharedVisible = true;
                            break;
                        }
                    }
                    if(sharedVisible)
                        break;
                }
                if(!sharedVisible)
                    horizonEdges.push_back(PackU32Words(cast<isize>(va), cast<isize>(vb)));
            }
        }

        Vector<u32> orphanedConflicts;
        for(usize v = 0u; v < visibleFaces.size(); ++v){
            const u32 fIdx = visibleFaces[v];
            for(usize c = 0u; c < faces[fIdx].conflicts.size(); ++c){
                const u32 cp = faces[fIdx].conflicts[c];
                if(cp != apexIdx)
                    orphanedConflicts.push_back(cp);
            }
            faces[fIdx].conflicts.clear();
            faces[fIdx].alive = false;
        }

        const usize newFaceBegin = faces.size();
        const VectorSingle apexPt = VectorSingle(uniquePts[apexIdx]);
        for(usize h = 0u; h < horizonEdges.size(); ++h){
            const u32 va = LowU32Word(cast<isize>(horizonEdges[h]));
            const u32 vb = HighU32Word(cast<isize>(horizonEdges[h]));
            faces.push_back(MakeTriangleFace(VectorSingle(uniquePts[va]), VectorSingle(uniquePts[vb]), apexPt, va, vb, apexIdx, interior));
        }

        for(usize c = 0u; c < orphanedConflicts.size(); ++c){
            const u32 cp = orphanedConflicts[c];
            f32 bestD = 1.0e-4f;
            usize bestNew = s_NullIndex;
            for(usize nf = newFaceBegin; nf < faces.size(); ++nf){
                if(!faces[nf].alive)
                    continue;
                const f32 dist = Vector3Dot(VectorSingle(faces[nf].plane.normalOffset, 0.0f), VectorSingle(uniquePts[cp], 0.0f)).x - faces[nf].plane.normalOffset.w;
                if(dist > bestD){
                    bestD = dist;
                    bestNew = nf;
                }
            }
            if(bestNew != s_NullIndex)
                faces[bestNew].conflicts.push_back(cp);
        }
    }

    HullShape result;
    Vector<u32> vertRemap;
    vertRemap.resize(uniquePts.size(), s_NullIndex);

    Vector<u32> liveFaces;
    for(usize f = 0u; f < faces.size(); ++f){
        if(faces[f].alive)
            liveFaces.push_back(cast<u32>(f));
    }
    if(liveFaces.size() < 4u || liveFaces.size() > s_MaxHullFaces)
        return MakeUnexpected(Failure());

    Vector<QuickhullFace> mergedFaces;
    const b8 useMergedFaces = TryMergeCoplanarHullFaces(faces, liveFaces, Span<f32x4>(uniquePts), interior, mergedFaces);

    usize finalFaceCount = liveFaces.size();
    if(useMergedFaces)
        finalFaceCount = mergedFaces.size();

    result.facePlanes.reserve(finalFaceCount);
    result.faceTopologies.reserve(finalFaceCount);

    VectorSingle minB = VectorSingle(s_MaxF32);
    VectorSingle maxB = VectorSingle(-s_MaxF32);
    VectorSingle sumVerts = VectorSingle(0.0f);

    for(usize lf = 0u; lf < finalFaceCount; ++lf){
        QuickhullFace qf;
        if(useMergedFaces)
            qf = mergedFaces[lf];
        else
            qf = faces[liveFaces[lf]];
        if(qf.vertices.size() < 3u)
            return MakeUnexpected(Failure());

        HullFaceTopology outTopo;
        outTopo.edge = cast<u8>(result.halfEdges.size());
        outTopo.vertexCount = cast<u8>(qf.vertices.size());
        const u8 faceOutIdx = cast<u8>(result.faceTopologies.size());
        const usize edgeBase = result.halfEdges.size();

        for(usize vi = 0u; vi < qf.vertices.size(); ++vi){
            const u32 rawVert = qf.vertices[vi];
            if(vertRemap[rawVert] == s_NullIndex){
                if(result.vertices.size() >= s_MaxHullVertices)
                    return MakeUnexpected(Failure());
                const u32 newIdx = cast<u32>(result.vertices.size());
                vertRemap[rawVert] = newIdx;
                const VectorSingle vp = VectorSingle(uniquePts[rawVert]);
                result.vertices.push_back(f32x3u(vp));
                minB = Min(minB, vp);
                maxB = Max(maxB, vp);
                sumVerts = sumVerts + vp;
            }
            HalfEdge he;
            he.tail = cast<u8>(vertRemap[rawVert]);
            he.face = faceOutIdx;
            he.next = cast<u8>(edgeBase + ((vi + 1u) % qf.vertices.size()));
            he.twin = 0u;
            if(result.halfEdges.size() >= 256u)
                return MakeUnexpected(Failure());
            result.halfEdges.push_back(he);
        }
        result.facePlanes.push_back(qf.plane);
        result.faceTopologies.push_back(outTopo);
    }

    Array<u16, 256u> twinIndices;
    for(usize ti = 0u; ti < 256u; ++ti)
        twinIndices[ti] = 0xffffu;

    for(usize e0 = 0u; e0 < result.halfEdges.size(); ++e0){
        if(twinIndices[e0] != 0xffffu)
            continue;
        const u8 a0 = result.halfEdges[e0].tail;
        const u8 b0 = result.halfEdges[result.halfEdges[e0].next].tail;
        for(usize e1 = e0 + 1u; e1 < result.halfEdges.size(); ++e1){
            if(twinIndices[e1] != 0xffffu)
                continue;
            const u8 a1 = result.halfEdges[e1].tail;
            const u8 b1 = result.halfEdges[result.halfEdges[e1].next].tail;
            if(a0 == b1 && b0 == a1){
                twinIndices[e0] = cast<u16>(e1);
                twinIndices[e1] = cast<u16>(e0);
                result.halfEdges[e0].twin = cast<u8>(e1);
                result.halfEdges[e1].twin = cast<u8>(e0);
                break;
            }
        }
        if(twinIndices[e0] == 0xffffu)
            return MakeUnexpected(Failure());
    }

    if(result.halfEdges.size() / 2u > s_MaxHullEdges)
        return MakeUnexpected(Failure());

    const VectorSingle centroid = sumVerts / cast<f32>(result.vertices.size());
    const VectorSingle halfExt = (maxB - minB) * 0.5f;
    result.centroidRadius = f32x4(centroid, radius);
    result.halfExtentsFlags = f32x3_u32(halfExt, 0u);
    return result;
}

isize QuantizeDedupAxis(in f32 v){
    const f32 s = v * 1000.0f;
    isize q = cast<isize>(s);
    if(s < cast<f32>(q))
        --q;
    return q;
}

b8 DeduplicateConvexPoints(in Span<f32x4> inputPoints, mut Vector<f32x4> uniquePts){
    uniquePts.clear();
    uniquePts.reserve(inputPoints.size());
    if(inputPoints.size() <= 32u){
        for(usize i = 0u; i < inputPoints.size(); ++i){
            const VectorSingle p = VectorSingle(inputPoints[i]);
            if(!IsValidPositionVec3(p))
                return false;
            b8 dup = false;
            for(usize j = 0u; j < uniquePts.size(); ++j){
                if(Vector3LengthSq(VectorSingle(p - VectorSingle(uniquePts[j]), 0.0f)).x <= 1.0e-8f){
                    dup = true;
                    break;
                }
            }
            if(!dup)
                uniquePts.push_back(f32x4(p, 0.0f));
        }
        return true;
    }

    HashMap<u64, u32> cellHeads;
    cellHeads.reserve(inputPoints.size());
    Vector<u32> bucketNext;
    bucketNext.reserve(inputPoints.size());

    for(usize i = 0u; i < inputPoints.size(); ++i){
        const VectorSingle p = VectorSingle(inputPoints[i]);
        if(!IsValidPositionVec3(p))
            return false;
        if(!Vector3LessOrEqual(Abs(p), VectorSingle(1.0e8f))){
            b8 dupHuge = false;
            for(usize j = 0u; j < uniquePts.size(); ++j){
                if(Vector3LengthSq(VectorSingle(p - VectorSingle(uniquePts[j]), 0.0f)).x <= 1.0e-8f){
                    dupHuge = true;
                    break;
                }
            }
            if(!dupHuge){
                uniquePts.push_back(f32x4(p, 0.0f));
                bucketNext.push_back(s_NullIndex);
            }
            continue;
        }

        const isize x0 = QuantizeDedupAxis(p.x - 1.01e-4f);
        const isize x1 = QuantizeDedupAxis(p.x + 1.01e-4f);
        const isize y0 = QuantizeDedupAxis(p.y - 1.01e-4f);
        const isize y1 = QuantizeDedupAxis(p.y + 1.01e-4f);
        const isize z0 = QuantizeDedupAxis(p.z - 1.01e-4f);
        const isize z1 = QuantizeDedupAxis(p.z + 1.01e-4f);

        b8 dup = false;
        for(isize cz = z0; cz <= z1 && !dup; ++cz){
            for(isize cy = y0; cy <= y1 && !dup; ++cy){
                for(isize cx = x0; cx <= x1 && !dup; ++cx){
                    const u64 key = HashGridCellCoord3D(cast<i64>(cx), cast<i64>(cy), cast<i64>(cz));
                    const auto it = cellHeads.find(key);
                    if(it == cellHeads.end())
                        continue;
                    u32 uIdx = it.value();
                    while(uIdx != s_NullIndex){
                        if(Vector3LengthSq(VectorSingle(p - VectorSingle(uniquePts[uIdx]), 0.0f)).x <= 1.0e-8f){
                            dup = true;
                            break;
                        }
                        uIdx = bucketNext[uIdx];
                    }
                }
            }
        }
        if(!dup){
            const u32 newIdx = cast<u32>(uniquePts.size());
            uniquePts.push_back(f32x4(p, 0.0f));
            const isize qx = QuantizeDedupAxis(p.x);
            const isize qy = QuantizeDedupAxis(p.y);
            const isize qz = QuantizeDedupAxis(p.z);
            const u64 homeKey = HashGridCellCoord3D(cast<i64>(qx), cast<i64>(qy), cast<i64>(qz));
            const auto homeIt = cellHeads.find(homeKey);
            if(homeIt == cellHeads.end()){
                bucketNext.push_back(s_NullIndex);
                cellHeads.emplace(homeKey, newIdx);
            }
            else{
                bucketNext.push_back(homeIt.value());
                homeIt.value() = newIdx;
            }
        }
    }
    return true;
}

Expected<HullShape> BuildConvexHull(in Span<f32x4> inputPoints, in f32 radius){
    if(!IsFinite(VectorSingle(radius)) || radius < 0.0f || inputPoints.size() < 4u)
        return MakeUnexpected(Failure());

    Vector<f32x4> uniquePts;
    if(!DeduplicateConvexPoints(inputPoints, uniquePts))
        return MakeUnexpected(Failure());

    if(uniquePts.size() < 4u)
        return MakeUnexpected(Failure());

    if(uniquePts.size() <= s_MaxHullVertices){
        const Expected<HullShape> exact = BuildConvexHullExact(Span<f32x4>(uniquePts), radius);
        if(exact.has_value())
            return exact.value();
    }

    Array<usize, 8u> decimateTargets;
    decimateTargets[0u] = s_MaxHullVertices;
    decimateTargets[1u] = 48u;
    decimateTargets[2u] = 36u;
    decimateTargets[3u] = 28u;
    decimateTargets[4u] = 20u;
    decimateTargets[5u] = 14u;
    decimateTargets[6u] = 10u;
    decimateTargets[7u] = 8u;
    for(usize ti = 0u; ti < 8u; ++ti){
        const usize cap = decimateTargets[ti];
        if(cap > uniquePts.size() && ti > 0u)
            continue;
        const Vector<f32x4> reducedPts = DecimateHullPoints(Span<f32x4>(uniquePts), Min(cap, uniquePts.size()));
        if(reducedPts.size() < 4u)
            continue;
        const Expected<HullShape> decimated = BuildConvexHullExact(Span<f32x4>(reducedPts), radius);
        if(decimated.has_value())
            return decimated.value();
    }

    return MakeUnexpected(Failure());
}


