void VerifyDiagnosticPathsBorrowUntilFormattingAndCaptureUtf8(){
    AdhdTestArena arena;
    CapturingLogger logger;
    LoggerRegistrationGuard registration(logger, LoggerBreakPolicy::ReportOnly);
    i32 evaluations = 0;
    EmitDiagnosticPathOnce(evaluations);
    EXPECT_EQ(evaluations, 1);
    EXPECT_TRUE(logger.sawErrorContainingUtf8("한글"));
    const auto verifyCapture = lambda[mut arena](in StringView text, in b8 truncated) -> void{
        const Path path(text);
        const auto baseline = FormatOwnedDiagnosticPath(path, arena.arena);
        const auto deferred = FormatDeferredDiagnosticPath(path);
        const auto wide = FormatWideDiagnosticPath(path);
        EXPECT_EQ(deferred.view(), baseline.view());
        EXPECT_EQ(wide.view(), baseline.view());
        EXPECT_NE(deferred.view().find("한글"), usize.max);
        EXPECT_EQ(DiagnosticTerminator(deferred), 0u);
        if(truncated)
            EXPECT_EQ(deferred.view().size(), s_MaxEventTextBytes - 1u);
    };
    verifyCapture("diag/한글/leaf", false);
    String longPath("diag/한글/");
    longPath.append(s_MaxEventTextBytes * 2u, 'x');
    verifyCapture(StringView(longPath), true);
}
void VerifyOptionalAndExpectedBorrowTheOriginalValue(){
    Array<u32, 1u> data(7u);
    mut u32 original = data[0u];
    const BorrowedCount retained(original);
    const auto fromSpan = BorrowFirstCount(data);
    Optional<in u32> read;
    EXPECT_EQ(ReadOptionalCount(read), 0u);
    read = BorrowOptionalCount(original);
    Expected<mut u32> write = BorrowExpectedCount(original);
    UpdateExpectedCount(write, 23u);
    EXPECT_EQ(original, 23u);
    EXPECT_EQ(retained.current(), 23u);
    EXPECT_EQ(fromSpan.current(), 23u);
    EXPECT_EQ(ReadOptionalCount(read), 23u);
}
void VerifyCheckedMapLookupRetainsTheOriginalElement(){
    HashMap<u32, u32> counts;
    counts[42u] = 11u;
    const auto retained = BorrowMappedCount(counts, 42u);
    counts.at(42u) = 23u;
    EXPECT_EQ(retained.current(), 23u);
}
void VerifyExpectedStateChangesRetainValueAndErrorInTheirDestinationArena(){
    HeapStorage destination(Name("tests/metascript/cached_result"));
    TestValueSlot<CachedCountResult> resultSlot;
    mut CachedCountResult retained = resultSlot.constructIn(destination);
    {
        ScratchStorage source(Name("tests/metascript/transient_counts"));
        TestValueSlot<Vector<u32>> countSlot;
        mut Vector<u32> values = countSlot.constructIn(source);
        values.push_back(17u);
        Expected<Vector<u32>, u8> counts = values;
        TestValueSlot<Vector<u8>> messageSlot;
        mut Vector<u8> message = messageSlot.constructIn(source);
        message.push_back(cast<u8>(4u));
        Expected<u64, Vector<u8>> issue = MakeUnexpected(message);
        TestValueSlot<CachedCountResult> localSlot;
        mut CachedCountResult local = localSlot.constructIn(source);
        local.update(counts, issue);
        TestMoveAssign<CachedCountResult>(retained, local);
        ASSERT_TRUE(retained.counts.has_value());
        ASSERT_FALSE(retained.issue.has_value());
        EXPECT_TRUE(TestUsesStorage(retained.counts.value(), destination));
        EXPECT_TRUE(TestUsesStorage(retained.issue.error(), destination));
    }
    EXPECT_EQ(retained.counts.value().front(), 17u);
    EXPECT_EQ(retained.issue.error().front(), 4u);
}
class CountStorageObserver : ICountSnapshotObserver{
    private mut ScratchStorage m_expected;
    public CountStorageObserver(mut ScratchStorage expected){ this.m_expected = expected; }
    public b8 inspect(in OwnedCounts counts)override{ return TestUsesStorage(counts.values, this.m_expected); }
}
void VerifyBorrowOnlyPublisherKeepsMoveOnlySnapshotInOwnerArena(){
    HeapStorage destination(Name("tests/metascript/owned_counts"));
    TestValueSlot<OwnedCounts> retainedSlot;
    mut OwnedCounts retained = retainedSlot.constructIn(destination);
    {
        ScratchStorage owner(Name("tests/metascript/borrowed_publisher"));
        u32 value = 13u;
        TestValueSlot<CountPublisher> publisherSlot;
        mut CountPublisher publisher = publisherSlot.constructIn(owner, value);
        CountStorageObserver observer(owner);
        EXPECT_TRUE(publisher.inspectLocal(observer));
        TestValueSlot<CountPublication> publicationSlot;
        mut CountPublication publication = publicationSlot.constructIn(owner, value);
        EXPECT_TRUE(publication.inspect(observer));
        TestValueSlot<OwnedCounts> publishedSlot;
        mut OwnedCounts published = CaptureReturnedValue<OwnedCounts>(publishedSlot, publisher.snapshot());
        EXPECT_TRUE(TestUsesStorage(published.values, owner));
        value = 21u;
        TestMoveAssign<OwnedCounts>(retained, published);
        EXPECT_EQ(retained.values[0u], 13u);
        publisher.replace(retained);
        ASSERT_EQ(retained.values.size(), 1u);
        EXPECT_EQ(retained.values[0u], 22u);
        published.values.clear();
        published.values.push_back(5u);
        TestValueSlot<OwnedCounts> sameArenaSlot;
        mut OwnedCounts sameArena = CaptureReturnedValue<OwnedCounts>(sameArenaSlot, publisher.snapshot());
        const usize storage = TestDataAddress(published.values);
        sameArena.replaceWith(published);
        EXPECT_EQ(TestDataAddress(sameArena.values), storage);
        retained.replaceWith(sameArena);
        retained.replaceWith(retained);
    }
    EXPECT_TRUE(TestUsesStorage(retained.values, destination));
    ASSERT_EQ(retained.values.size(), 1u);
    EXPECT_EQ(retained.values[0u], 5u);
}
