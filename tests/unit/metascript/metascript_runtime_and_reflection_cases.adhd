void MetaRuntime_CheckParseFailsWithMessage(in StringView source, in StringView expectedMessage){
    DestinationArena arena = DestinationArena();
    Document document = Document(arena.arena);

    const b8 parsed = document.parse(source);
    EXPECT_FALSE(parsed);
    ASSERT_TRUE(document.hasErrors());
    ASSERT_FALSE(document.errors().empty());
    EXPECT_EQ(DocumentErrorMessage(document, 0u), expectedMessage);
}

void MetaRuntime_CheckStringListElement(in Value value, in StringView expected){
    ASSERT_TRUE(value.isString());
    EXPECT_EQ(value.asString(), expected);
}

void MetaRuntime_CheckSingleStringListValue(in Value value, in StringView text){
    ASSERT_TRUE(value.isList());
    ASSERT_EQ(value.asList().size(), 1u);
    MetaRuntime_CheckStringListElement(value.asList()[0u], text);
}

void MetaRuntime_MakeSingleStringList(mut Value list, mut MetaArena arena, in StringView text){
    list.makeList();
    list.append(Value(text, arena));
}

void VerifyMetascript_EmptyAndStructOnlyDocumentsHaveNoImplicitVariables(){
    DestinationArena arena = DestinationArena();
    Document document = Document(arena.arena);
    ASSERT_TRUE(document.parse(""));
    EXPECT_TRUE(document.declarations().empty());
    EXPECT_TRUE(document.structs().empty());
    EXPECT_FALSE(HasVariable(document, s_MetaRuntimeAssetVariable));

    ASSERT_TRUE(document.parse("[custom(\"argument\")] struct Description{ [field] float value; };"));
    EXPECT_TRUE(document.declarations().empty());
    EXPECT_FALSE(HasVariable(document, s_MetaRuntimeAssetVariable));
    EXPECT_FALSE(HasVariable(document, "Description"));
    ASSERT_EQ(document.structs().size(), 1u);
    EXPECT_TRUE(HasStruct(document, "Description"));
}

void VerifyMetascript_StructNamesAndVariablesUseSeparateNamespaces(){
    DestinationArena arena = DestinationArena();
    Document document = Document(arena.arena);
    ASSERT_TRUE(document.parse("number Parameters = 3; struct Parameters{ float value; }; Parameters runtime; runtime.value = 4;"));
    ASSERT_EQ(document.structs().size(), 1u);
    ASSERT_EQ(document.declarations().size(), 2u);
    ASSERT_TRUE(HasVariable(document, "Parameters"));
    EXPECT_EQ(RequireVariable(document, "Parameters").asInteger(), 3);
    ASSERT_TRUE(HasDeclaration(document, "runtime"));
    EXPECT_EQ(DeclarationType(document, "runtime"), "Parameters");
    EXPECT_EQ(DeclarationVariable(document, "runtime"), "runtime");
    ASSERT_TRUE(HasVariable(document, "runtime"));
    ASSERT_TRUE(RequireVariable(document, "runtime").isMap());
    ASSERT_TRUE(HasValueField(RequireVariable(document, "runtime"), "value"));
    EXPECT_EQ(RequireValueField(RequireVariable(document, "runtime"), "value").asInteger(), 4);
    EXPECT_FALSE(HasVariable(document, s_MetaRuntimeAssetVariable));
    EXPECT_FALSE(HasVariable(document, "structs"));
    EXPECT_FALSE(HasVariable(document, "instances"));
}

void VerifyMetascript_StructMetadataOwnsSourceAndSurvivesVariableStorageGrowth(){
    DestinationArena arena = DestinationArena();
    Document document = Document(arena.arena);
    {
        const auto source = BuildStructGrowthDocumentSource();
        ASSERT_TRUE(document.parse(source));
    }
    ASSERT_EQ(document.declarations().size(), 129u);
    ASSERT_TRUE(HasStruct(document, "Description"));
    ASSERT_TRUE(HasValueField(StructMetadata(document, "Description"), "fields"));
    ASSERT_TRUE(RequireValueField(StructMetadata(document, "Description"), "fields").isList());
    ASSERT_EQ(RequireValueField(StructMetadata(document, "Description"), "fields").asList().size(), 1u);
    ASSERT_TRUE(HasValueField(RequireValueField(StructMetadata(document, "Description"), "fields").asList()[0u], s_MetaRuntimeNameField));
    EXPECT_EQ(RequireValueField(RequireValueField(StructMetadata(document, "Description"), "fields").asList()[0u], s_MetaRuntimeNameField).asString(), "value");
    ASSERT_TRUE(HasDeclaration(document, "runtime"));
    EXPECT_EQ(DeclarationType(document, "runtime"), "Description");
    ASSERT_TRUE(HasVariable(document, "runtime"));
    EXPECT_TRUE(RequireVariable(document, "runtime").isNull());
}

void VerifyMetascript_StructAndVariableDuplicatesAreRejectedInTheirOwnNamespaces(){
    MetaRuntime_CheckParseFailsWithMessage("struct Duplicate{ float value; float value; };", "duplicate struct field declaration");
    MetaRuntime_CheckParseFailsWithMessage("struct Duplicate{}; struct Duplicate{};", "duplicate struct declaration");
    MetaRuntime_CheckParseFailsWithMessage("struct Description{}; Description runtime; Description runtime;", "duplicate variable declaration");
    MetaRuntime_CheckParseFailsWithMessage("number value; text value;", "duplicate variable declaration");
}

void VerifyMetascript_ReparsingClearsStructsVariablesDeclarationsAndErrors(){
    DestinationArena arena = DestinationArena();
    Document document = Document(arena.arena);
    ASSERT_TRUE(document.parse("struct Old{ float value; }; Old previous;"));
    ASSERT_FALSE(document.parse("struct Partial{}; number value; number value;"));
    ASSERT_TRUE(document.hasErrors());
    ASSERT_TRUE(document.parse("text current = \"new\";"));
    EXPECT_FALSE(document.hasErrors());
    EXPECT_TRUE(document.structs().empty());
    ASSERT_EQ(document.declarations().size(), 1u);
    EXPECT_FALSE(HasDeclaration(document, "previous"));
    EXPECT_FALSE(HasVariable(document, "previous"));
    EXPECT_FALSE(HasVariable(document, "value"));
    ASSERT_TRUE(HasVariable(document, "current"));
    EXPECT_EQ(RequireVariable(document, "current").asString(), "new");
    ASSERT_TRUE(document.parse(""));
    EXPECT_TRUE(document.declarations().empty());
    EXPECT_FALSE(HasVariable(document, "current"));
}

void VerifyMetascript_InvalidAssignmentTargetsPreserveDiagnosticsAndDeclaredValue(){
    for(in InvalidTargetCase testCase : s_InvalidAssignmentTargetCases){
        ScopedTestTrace trace = ScopedTestTrace(testCase.message);
        DestinationArena arena = DestinationArena();
        Document document = Document(arena.arena);
        EXPECT_FALSE(document.parse(testCase.source));
        ASSERT_EQ(document.errors().size(), 1u);
        EXPECT_EQ(document.errors()[0u].line, 2u);
        EXPECT_EQ(document.errors()[0u].column, 1u);
        EXPECT_EQ(DocumentErrorMessage(document, 0u), testCase.message);
        ASSERT_TRUE(HasVariable(document, s_MetaRuntimeAssetVariable));
        ASSERT_TRUE(RequireVariable(document, s_MetaRuntimeAssetVariable).isInteger());
        EXPECT_EQ(RequireVariable(document, s_MetaRuntimeAssetVariable).asInteger(), testCase.retainedValue);
        EXPECT_FALSE(HasVariable(document, "missing"));
    }
}

void VerifyMetascript_UnicodeCharLiteralRejectsWideValueBeforeNarrowing(){
    i64 value = 7;
    EXPECT_FALSE(TryDecodeCharLiteral("'\\UD800'", value));
    EXPECT_EQ(value, 7);
    EXPECT_FALSE(TryDecodeCharLiteral("'\\U110000'", value));
    EXPECT_EQ(value, 7);
    EXPECT_TRUE(TryDecodeCharLiteral("'\\U10FFFF'", value));
    EXPECT_EQ(value, 0x10FFFF);
}

void VerifyMetascript_CrossArenaMoveAssignmentCopiesIntoDestinationArena(){
    SourceArena sourceArena = SourceArena();
    DestinationArena destinationArena = DestinationArena();
    const auto text = MakeRepeatedCharString(128u, 'm');

    Value source = Value(text, sourceArena.arena);
    Value destination = Value(destinationArena.arena);

    native(mut destination, mut source){
        destination = Move(source);
    }

    EXPECT_TRUE(source.isNull());
    EXPECT_EQ(destination.asString(), text);
}

void VerifyMetascript_CrossArenaCopyAssignmentCopiesNestedValuesIntoDestinationArena(){
    SourceArena sourceArena = SourceArena();
    DestinationArena destinationArena = DestinationArena();
    const auto text = MakeRepeatedCharString(128u, 'c');

    Value source = Value(sourceArena.arena);
    source.makeMap();
    mut Value list = source.field(s_MetaRuntimeItemsField);
    MetaRuntime_MakeSingleStringList(list, sourceArena.arena, text);

    Value destination = Value(destinationArena.arena);
    destination = source;

    EXPECT_TRUE(source.isMap());
    ASSERT_TRUE(HasValueField(destination, s_MetaRuntimeItemsField));
    MetaRuntime_CheckSingleStringListValue(RequireValueField(destination, s_MetaRuntimeItemsField), text);
}

void VerifyMetascript_CrossArenaListConcatCopiesIntoResultArena(){
    SourceArena sourceArena = SourceArena();
    DestinationArena destinationArena = DestinationArena();
    const auto text = MakeRepeatedCharString(128u, 'p');

    Value source = Value(sourceArena.arena);
    MetaRuntime_MakeSingleStringList(source, sourceArena.arena, text);

    Value destination = Value(destinationArena.arena);
    destination.makeList();

    Value result = destination + source;
    MetaRuntime_CheckSingleStringListValue(result, text);
}

void VerifyMetascript_CrossArenaAppendCopiesIntoDestinationArena(){
    SourceArena sourceArena = SourceArena();
    DestinationArena destinationArena = DestinationArena();
    const auto text = MakeRepeatedCharString(128u, 'a');

    Value source = Value(text, sourceArena.arena);
    Value destination = Value(destinationArena.arena);
    destination.makeList();

    native(mut destination, mut source){
        destination.append(Move(source));
    }

    EXPECT_TRUE(source.isNull());
    MetaRuntime_CheckSingleStringListValue(destination, text);
}

void VerifyMetascript_ListSelfAppendCopiesOriginalValues(){
    DestinationArena arena = DestinationArena();
    const auto text = MakeRepeatedCharString(128u, 's');

    Value list = Value(arena.arena);
    MetaRuntime_MakeSingleStringList(list, arena.arena, text);

    list += list;

    ASSERT_EQ(list.asList().size(), 2u);
    MetaRuntime_CheckStringListElement(list.asList()[0u], text);
    MetaRuntime_CheckStringListElement(list.asList()[1u], text);
}

void VerifyMetascript_AppendSelfMoveCopiesOriginalValue(){
    DestinationArena arena = DestinationArena();
    const auto text = MakeRepeatedCharString(128u, 'v');

    Value list = Value(arena.arena);
    MetaRuntime_MakeSingleStringList(list, arena.arena, text);

    native(mut list){
        list.append(Move(list));
    }

    ASSERT_TRUE(list.isList());
    ASSERT_EQ(list.asList().size(), 2u);
    MetaRuntime_CheckStringListElement(list.asList()[0u], text);
    ASSERT_TRUE(list.asList()[1u].isList());
    ASSERT_EQ(list.asList()[1u].asList().size(), 1u);
    MetaRuntime_CheckStringListElement(list.asList()[1u].asList()[0u], text);
}

void VerifyMetascript_AppendExistingListElementMoveCopiesBeforeDestroy(){
    DestinationArena arena = DestinationArena();
    const auto text = MakeRepeatedCharString(128u, 'e');

    Value list = Value(arena.arena);
    MetaRuntime_MakeSingleStringList(list, arena.arena, text);

    native(mut list){
        list.append(Move(list.asList()[0u]));
    }

    ASSERT_TRUE(list.isList());
    ASSERT_EQ(list.asList().size(), 2u);
    EXPECT_TRUE(list.asList()[0u].isNull());
    MetaRuntime_CheckStringListElement(list.asList()[1u], text);
}

void VerifyMetascript_ListAppendExistingElementCopiesBeforeReallocation(){
    DestinationArena arena = DestinationArena();
    const auto text = MakeRepeatedCharString(128u, 'r');

    Value list = Value(arena.arena);
    MetaRuntime_MakeSingleStringList(list, arena.arena, text);

    list += list.asList()[0u];

    ASSERT_TRUE(list.isList());
    ASSERT_EQ(list.asList().size(), 2u);
    MetaRuntime_CheckStringListElement(list.asList()[0u], text);
    MetaRuntime_CheckStringListElement(list.asList()[1u], text);
}

void VerifyMetascript_AppendsFirstMiddleAndLastElementsAcrossReallocation(){
    Array<usize, 3u> sourceIndices = Array<usize, 3u>();
    sourceIndices[0u] = 0u;
    sourceIndices[1u] = 3u;
    sourceIndices[2u] = 7u;
    Array<b8, 2u> moveFlags = Array<b8, 2u>();
    moveFlags[0u] = false;
    moveFlags[1u] = true;
    for(in usize sourceIndex : sourceIndices){
        for(in b8 moveSource : moveFlags){
            DestinationArena arena = DestinationArena();
            Value list = Value(arena.arena);
            list.makeList();
            list.asList().reserve(s_MetaRuntimeInitialCount);
            const usize originalCount = list.asList().capacity();
            for(usize index = 0u; index < originalCount; ++index)
                list.append(Value(cast<i64>(index), arena.arena));

            if(moveSource){
                native(mut list, in sourceIndex){
                    list.append(Move(list.asList()[sourceIndex]));
                }
            }
            else
                list += list.asList()[sourceIndex];

            ASSERT_EQ(list.asList().size(), originalCount + 1u);
            EXPECT_EQ(list.asList().back().asInteger(), cast<i64>(sourceIndex));
            for(usize index = 0u; index < originalCount; ++index){
                if(moveSource && index == sourceIndex)
                    EXPECT_TRUE(list.asList()[index].isNull());
                else
                    EXPECT_EQ(list.asList()[index].asInteger(), cast<i64>(index));
            }
        }
    }
}

void VerifyMetascript_ConcatenatesNestedListElementsAcrossReallocation(){
    Array<usize, 3u> sourceIndices = Array<usize, 3u>();
    sourceIndices[0u] = 0u;
    sourceIndices[1u] = 3u;
    sourceIndices[2u] = 7u;
    const auto text = MakeRepeatedCharString(128u, 'n');
    for(in usize sourceIndex : sourceIndices){
        DestinationArena arena = DestinationArena();
        Value list = Value(arena.arena);
        list.makeList();
        list.asList().reserve(s_MetaRuntimeInitialCount);
        const usize originalCount = list.asList().capacity();
        for(usize index = 0u; index < originalCount; ++index)
            list.append(Value(cast<i64>(index), arena.arena));
        MetaRuntime_MakeSingleStringList(list.asList()[sourceIndex], arena.arena, text);

        list += list.asList()[sourceIndex];

        ASSERT_EQ(list.asList().size(), originalCount + 1u);
        EXPECT_GT(list.asList().capacity(), originalCount);
        MetaRuntime_CheckStringListElement(list.asList().back(), text);
        for(usize index = 0u; index < originalCount; ++index){
            if(index == sourceIndex)
                MetaRuntime_CheckSingleStringListValue(list.asList()[index], text);
            else
                EXPECT_EQ(list.asList()[index].asInteger(), cast<i64>(index));
        }
    }
}

void VerifyMetascript_UnexpectedReaderExceptionsPropagateWithoutBecomingParseErrors(){
    ReaderArena arena = ReaderArena();
    Document document = Document(arena.arena);
    ThrowingReader reader = ThrowingReader();

    native(mut document, mut reader){
        EXPECT_THROW(EXPECT_TRUE(document.parse(reader)), UnexpectedReadFailure);
    }
    EXPECT_FALSE(document.hasErrors());
}

void VerifyMetascript_ReportedReaderFailureRemainsAnExplicitParseError(){
    ReaderArena arena = ReaderArena();
    Document document = Document(arena.arena);
    RejectedReader reader = RejectedReader(false);

    EXPECT_FALSE(document.parse(reader));
    ASSERT_EQ(document.errors().size(), 1u);
    EXPECT_EQ(DocumentErrorMessage(document, 0u), "read error");
}

void VerifyMetascript_SuccessfulZeroReaderCountIsEndOfFileInsteadOfReadFailure(){
    ReaderArena arena = ReaderArena();
    Document document = Document(arena.arena);
    EndOfFileReader reader = EndOfFileReader();

    ASSERT_TRUE(document.parse("struct Previous{}; number prior;"));
    EXPECT_TRUE(document.parse(reader));
    EXPECT_FALSE(document.hasErrors());
    EXPECT_TRUE(document.declarations().empty());
    EXPECT_TRUE(document.structs().empty());
    EXPECT_FALSE(HasVariable(document, "prior"));
}

void VerifyMetascript_OversizedReaderResultIsRejectedBeforeUsingItsBuffer(){
    ReaderArena arena = ReaderArena();
    Document document = Document(arena.arena);
    RejectedReader reader = RejectedReader(true);

    EXPECT_FALSE(document.parse(reader));
    ASSERT_EQ(document.errors().size(), 1u);
    EXPECT_EQ(DocumentErrorMessage(document, 0u), "reader returned more bytes than requested");
}

void VerifyAdhdReflection_RejectsInvalidContainerEntriesWithoutPublishingEmptyNames(){
    AdhdTestArena arena = AdhdTestArena();
    const StringView invalid = StringView("b\0d", 3u);

    Value input = Value(arena.arena);
    mut Value names = input.field("names");
    names.append(Value("first", arena.arena));
    names.append(Value(invalid, arena.arena));
    names.append(Value(cast<i64>(7), arena.arena));
    names.append(Value("last", arena.arena));
    mut Value fixed = input.field("fixedNames");
    fixed.append(Value("fixed/first", arena.arena));
    fixed.append(Value(invalid, arena.arena));
    fixed.append(Value("fixed/last", arena.arena));
    mut Value bounded = input.field("boundedNames");
    bounded.append(Value(invalid, arena.arena));
    bounded.append(Value("bounded/first", arena.arena));
    bounded.append(Value("bounded/last", arena.arena));
    mut Value counts = input.field("counts");
    counts.field("valid").setInteger(9);
    counts.field(invalid).setInteger(3);
    counts.field("wrong_type").setString("not a number");
    mut Value assets = input.field("assets");
    assets.field("valid").setString("project/asset");
    assets.field(invalid).setString("project/ignored");
    assets.field("invalid_value").setString(invalid);
    assets.field("wrong_type").setInteger(3);
    mut Value enumAssets = input.field("enumAssets");
    enumAssets.field("Valid").setString("project/enum_asset");
    enumAssets.field("unknown").setString("project/ignored_enum");

    ReflectionContainerFixture value = ReflectionContainerFixture();
    value.fixedNames[1u] = Name("fixed/retained");
    ASSERT_TRUE(value.deserializeNwb(input));
    ASSERT_EQ(value.names.size(), 2u);
    EXPECT_EQ(value.names[0u], Name("first"));
    EXPECT_EQ(value.names[1u], Name("last"));
    EXPECT_EQ(value.fixedNames[0u], Name("fixed/first"));
    EXPECT_EQ(value.fixedNames[1u], Name("fixed/retained"));
    EXPECT_EQ(value.fixedNames[2u], Name("fixed/last"));
    ASSERT_EQ(value.boundedNames.size(), 2u);
    EXPECT_EQ(value.boundedNames[0u], Name("bounded/first"));
    EXPECT_EQ(value.boundedNames[1u], Name("bounded/last"));
    ASSERT_EQ(value.counts.size(), 1u);
    ASSERT_TRUE(value.counts.contains(Name("valid")));
    EXPECT_EQ(value.counts.at(Name("valid")), 9u);
    ASSERT_EQ(value.assets.size(), 1u);
    ASSERT_TRUE(value.assets.contains(Name("valid")));
    EXPECT_EQ(value.assets.at(Name("valid")).name(), Name("project/asset"));
    ASSERT_EQ(value.enumAssets.size(), 1u);

    Vector<Name> dependencies = Vector<Name>();
    const b8 extracted = value.extractNwbAssetDependencies(input, lambda[mut dependencies](in Name name) -> void{
        dependencies.push_back(name);
    });
    ASSERT_TRUE(extracted);
    ASSERT_EQ(dependencies.size(), 2u);
    b8 hasProjectAsset = false;
    b8 hasEnumAsset = false;
    for(in Name dep : dependencies){
        if(dep == Name("project/asset"))
            hasProjectAsset = true;
        if(dep == Name("project/enum_asset"))
            hasEnumAsset = true;
    }
    EXPECT_TRUE(hasProjectAsset);
    EXPECT_TRUE(hasEnumAsset);
}

void VerifyAdhdCompactString_SearchAndBoundariesUseCanonicalStoredText(){
    const CompactString value = CompactString("Find\\NEEDLE");
    EXPECT_EQ(FindCompact(value), 5u);
    EXPECT_EQ(FirstCompact(value), cast<u8>('f'));
    EXPECT_EQ(LastCompact(value), cast<u8>('e'));
    EXPECT_EQ(FindCompact(CompactString("missing")), usize.max);
}

