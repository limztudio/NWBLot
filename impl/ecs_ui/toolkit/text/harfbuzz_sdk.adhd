[cpp_header("<impl/ecs_ui/toolkit/text/harfbuzz_sdk.h>"), cpp_name("::hb_glyph_info_t"), cpp_flags(self_defaulted)]
extern class HarfBuzzGlyphInfo{
    u32 codepoint;
    u32 cluster;
};

[cpp_header("<impl/ecs_ui/toolkit/text/harfbuzz_sdk.h>"), cpp_name("::hb_glyph_position_t"), cpp_flags(self_defaulted)]
extern class HarfBuzzGlyphPosition{
    i32 x_advance;
    i32 y_advance;
    i32 x_offset;
    i32 y_offset;
};

[cpp_header("<impl/ecs_ui/toolkit/text/harfbuzz_sdk.h>"), cpp_name("::hb_font_extents_t"), cpp_flags(self_defaulted)]
extern class HarfBuzzFontExtents{
    i32 ascender;
    i32 descender;
    i32 line_gap;
};

[cpp_header("<impl/ecs_ui/toolkit/text/harfbuzz_sdk.h>"), cpp_name("::hb_glyph_extents_t"), cpp_flags(self_defaulted)]
extern class HarfBuzzGlyphExtents{
    i32 x_bearing;
    i32 y_bearing;
    i32 width;
    i32 height;
};

[cpp_header("<impl/ecs_ui/toolkit/text/harfbuzz_sdk.h>"), cpp_name("::hb_direction_t"), cpp_flags(small_value, equality_switch)]
extern class HarfBuzzDirection;

[cpp_header("<impl/ecs_ui/toolkit/text/harfbuzz_sdk.h>"), cpp_name("::hb_script_t"), cpp_flags(small_value, equality_switch)]
extern class HarfBuzzScript{
    b8 operator==(in HarfBuzzScript rhs)const;
};

[cpp_header("<impl/ecs_ui/toolkit/text/harfbuzz_sdk.h>"), cpp_name("::hb_buffer_cluster_level_t"), cpp_flags(small_value, equality_switch)]
extern class HarfBuzzClusterLevel;

