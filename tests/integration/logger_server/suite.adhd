    EXPECT_TRUE(Contains(StringView(report), "instruction_pointer_module=/tmp/overflow"));
    EXPECT_TRUE(Contains(StringView(report), "symbolication_relative_ip=unavailable"));
    RemoveTestArtifacts(group);
}

void VerifyLoggerServerCrash_AndroidCrashPackageReportsTombstoneWithoutFrames(mut LoggerServerCrash self){
