////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class Point{
    public f32 x = 0.0f;
    public f32 y = 0.0f;
}

class Rect{
    public f32 x = 0.0f;
    public f32 y = 0.0f;
    public f32 width = 0.0f;
    public f32 height = 0.0f;
}

class Insets{
    public f32 left = 0.0f;
    public f32 top = 0.0f;
    public f32 right = 0.0f;
    public f32 bottom = 0.0f;
}

// Input colors use linear RGB and straight alpha; frozen vertices use premultiplied alpha.
class Color{
    public f32 r = 1.0f;
    public f32 g = 1.0f;
    public f32 b = 1.0f;
    public f32 a = 1.0f;
}

[serialize]
class Vertex{
    public Point position;
    public Point texCoord;
    public Color color;
}

class DisplayMetrics{
    public f32 logicalWidth = 0.0f;
    public f32 logicalHeight = 0.0f;
    public f32 pixelScaleX = 1.0f;
    public f32 pixelScaleY = 1.0f;
}

enum<u8> PaintMaterial{
    enum Solid,
    enum Skin,
    enum Glyph,
    enum SdfGlyph,
    enum Image,
}

class DrawCommand{
    public Rect clip;
    public u32 firstIndex = 0u;
    public u32 indexCount = 0u;
    public u32 glyphPageIndex = 0xffffffffu;
    public u32 sdfPageIndex = 0xffffffffu;
    public u32 sdfChannel = 0u;
    // Base paint is layer zero; higher layers render later without changing owned index or image bindings.
    public u32 layer = 0u;
    public u32 textureImageIndex = 0xffffffffu;
    public PaintMaterial material = PaintMaterial::Enum::Solid;
}

// Share of free space placed before an item to center it, or the midpoint of an extent.
const f32 s_RectCenterFraction = 0.5f;
const f64 s_RectCenterFractionF64 = 0.5;

enum<u8> UiRectPrecision{
    enum RoundedEndpoints,
    enum BoundedEndpoints,
    enum PreciseExtents,
    enum EmptyPaint,
}

const u32 s_GlyphAtlasPageExtent = 512u;
const u32 s_GlyphAtlasGlyphGutter = 2u;
const usize s_GlyphAtlasMaxPages = 16u;
const usize s_PaintMaxGlyphPages = 64u;
const usize s_PaintMaxImages = s_PaintMaxGlyphPages;
const usize s_PaintMaxOverlayDepth = 16u;
const usize s_PaintDefaultClipDepth = 8u;

enum<u8> GpuCommandRecordingMode{
    enum Direct,
    enum CommandIrReplay,
}

[serialize]
class GpuPaintPushConstants{
    public Point scale;
    public Point translate;
    public u32 textureSlot = 0xffffffffu;
    public u32 samplerSlot = 0xffffffffu;
    public u32 material = 0u;
    public u32 sdfChannel = 0u;
    public f32 sdfSpreadPixels = 1.0f;
    public u32 sdfDistanceEncoding = 0u;
}

[serialize]
class GpuOutputPushConstants{
    public u32 textureSlot = 0xffffffffu;
    public u32 samplerSlot = 0xffffffffu;
    public u32 presentationMode = 0u;
}

const usize s_GpuMaxGlyphPages = s_PaintMaxImages;
const usize s_GpuMaxSdfPages = s_PaintMaxImages;
const usize s_GpuMaxTextureImages = s_PaintMaxImages;
const usize s_GpuTargetSlotCount = 3u;
const usize s_GpuFrameCount = 4u;
// Raster uses outside the page lists: color target, skin atlas, vertex buffer, and index buffer.
const usize s_GpuRasterFixedResourceUses = 4u;
const u32 s_GpuFullscreenTriangleVertexCount = 3u;
const u32 s_GpuTimingHeightShift = 16u;
const Name s_GpuLayerTextureName = "ui.layer";
const Name s_GpuAtlasTextureName = "ui.atlas";
const Name s_GpuVertexBufferName = "ui.vertices";
const Name s_GpuIndexBufferName = "ui.indices";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
