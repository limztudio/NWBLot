    public GlyphAtlasPlacement(){
        this.x = 0u;
        this.y = 0u;
        this.rowHeight = 0u;
    }

    public GlyphAtlasPlacement(in u32 inX, in u32 inY, in u32 inRowHeight){
        this.x = inX;
        this.y = inY;
        this.rowHeight = inRowHeight;
    }

    public u32 x;
    public u32 y;
    public u32 rowHeight;
}

class TextFontSpan{
    public TextFontSpan(){
        this.fontIndex = 0u;
        this.glyphBegin = 0u;
        this.glyphEnd = 0u;
        this.byteBegin = 0u;
        this.byteEnd = 0u;
    }

    public TextFontSpan(in usize inFontIndex, in usize inGlyphBegin, in usize inGlyphEnd, in u32 inByteBegin, in u32 inByteEnd){
        this.fontIndex = inFontIndex;
        this.glyphBegin = inGlyphBegin;
        this.glyphEnd = inGlyphEnd;
        this.byteBegin = inByteBegin;
        this.byteEnd = inByteEnd;
    }

    public usize fontIndex;
    public usize glyphBegin;
    public usize glyphEnd;
    public u32 byteBegin;
    public u32 byteEnd;
}

class TextCluster{
    public u32 byteBegin = 0u;
    public u32 byteEnd = 0u;
    public u32 firstGlyph = 0u;
    public u32 glyphCount = 0u;
    public u32 lineIndex = 0u;
    public f32 leadingX = 0.0f;
    public f32 trailingX = 0.0f;
}

class TextLine{
    public u32 byteBegin = 0u;
    public u32 byteEnd = 0u;
    public u32 breakEnd = 0u;
    public u32 firstGlyph = 0u;
    public u32 glyphCount = 0u;
    public u32 firstCluster = 0u;
    public u32 clusterCount = 0u;
    public f32 top = 0.0f;
    public f32 baseline = 0.0f;
    public f32 height = 0.0f;
    public f32 advance = 0.0f;
}

class TextHit{
    public u32 byteOffset = 0u;
}

Expected<GlyphAtlasPlacement> TryPlaceGlyphInAtlasPage(in u32 cursorX, in u32 cursorY, in u32 rowHeight, in u32 width, in u32 height){
    GlyphAtlasPlacement outPlacement(cursorX, cursorY, rowHeight);
    if(outPlacement.x + width > s_GlyphAtlasPageExtent){
        outPlacement.x = 0u;
        outPlacement.y += outPlacement.rowHeight;
        outPlacement.rowHeight = 0u;
    }
    if(outPlacement.y + height > s_GlyphAtlasPageExtent)
        return makeUnexpected(Failure());
    outPlacement.rowHeight = max(outPlacement.rowHeight, height);
    return outPlacement;
}

usize FindClusterEnd(in Span<RawShapedGlyph> glyphs, in usize begin){
    usize end = begin + 1u;
    while(end < glyphs.size() && glyphs[end].byteBegin == glyphs[begin].byteBegin)
        ++end;
    return end;
}

b8 ClusterHasMissingGlyph(in Span<RawShapedGlyph> glyphs, in usize begin, in usize end){
    for(usize index = begin; index < end; ++index){
        if(glyphs[index].glyphId == 0u)
            return true;
    }
    return false;
}

b8 FitsTextCoordinate(in f64 value){
    return isFinite(value) && value >= -s_TextMaxCoordinateF64 && value <= s_TextMaxCoordinateF64;
}

b8 IsValidTextFontSize(in f32 fontSize){
    return isFinite(fontSize) && fontSize >= 1.0f / s_TextFixedPointScale && fontSize <= s_TextMaxFontSize;
}

f32 RoundMeasuredTextBound(in f64 value, in b8 upper){
    const f32 rounded = cast<f32>(value);
    if(upper){
        if(cast<f64>(rounded) >= value)
            return rounded;
    }
    else{
        if(cast<f64>(rounded) <= value)
            return rounded;
    }
    if(rounded == 0.0f){
        if(upper)
            return bit_cast<f32>(s_TextSmallestPositiveSubnormalBits);
        return bit_cast<f32>(s_TextSmallestNegativeSubnormalBits);
    }
    const u32 bits = bit_cast<u32>(rounded);
    if(upper == (rounded > 0.0f))
        return bit_cast<f32>(bits + 1u);
    return bit_cast<f32>(bits - 1u);
}

class TextRasterMetrics{
    public f32 physicalSize = 0.0f;
    public f32 rasterPpem = 0.0f;
    public f32 rasterScale = 0.0f;
    public u32 pixelSize = 0u;
}

Expected<TextRasterMetrics> TryResolveTextRasterMetrics(in f32 fontSize, in DisplayMetrics display){
    TextRasterMetrics outMetrics;
    if(!IsValidTextFontSize(fontSize) || !isFinite(display.pixelScaleX) || !isFinite(display.pixelScaleY) || display.pixelScaleX <= 0.0f || display.pixelScaleY <= 0.0f)
        return makeUnexpected(Failure());
    const f32 physicalSize = fontSize * max(display.pixelScaleX, display.pixelScaleY);
    const f32 rasterPpem = ceil(physicalSize);
    if(!isFinite(rasterPpem) || rasterPpem < 1.0f || rasterPpem > s_TextMaxRasterPpemF32)
        return makeUnexpected(Failure());
    outMetrics.physicalSize = physicalSize;
    outMetrics.rasterPpem = rasterPpem;
    outMetrics.rasterScale = rasterPpem / fontSize;
    outMetrics.pixelSize = cast<u32>(rasterPpem);
    return outMetrics;
}

Expected<Rect> TryMakeMeasuredTextRect(in f64 left, in f64 top, in f64 right, in f64 bottom){
    if(
        !isFinite(left) || !isFinite(top) || !isFinite(right) || !isFinite(bottom)
        || left < -s_TextMaxCoordinateF64 || top < -s_TextMaxCoordinateF64
        || right > s_TextMaxCoordinateF64 || bottom > s_TextMaxCoordinateF64
        || right < left || bottom < top
    )
        return makeUnexpected(Failure());
    const f32 x = RoundMeasuredTextBound(left, false);
    const f32 y = RoundMeasuredTextBound(top, false);
    const f64 width = cast<f64>(RoundMeasuredTextBound(right, true)) - cast<f64>(x);
    const f64 height = cast<f64>(RoundMeasuredTextBound(bottom, true)) - cast<f64>(y);
    if(width > s_TextMaxCoordinateF64 || height > s_TextMaxCoordinateF64)
        return makeUnexpected(Failure());
    const f32 roundedWidth = RoundMeasuredTextBound(width, true);
    const f32 roundedHeight = RoundMeasuredTextBound(height, true);
    if(
        !isFinite(roundedWidth) || roundedWidth < 0.0f
        || !isFinite(roundedHeight) || roundedHeight < 0.0f
        || !isFinite(x + roundedWidth) || !isFinite(y + roundedHeight)
    )
        return makeUnexpected(Failure());
    return Rect(x, y, roundedWidth, roundedHeight);
}

TextHit HitTestTextLayout(in Span<TextLine> lines, in Span<TextCluster> clusters, in Point point){
    TextHit hit;
    if(lines.empty() || !isFinite(point.x) || !isFinite(point.y))
        return hit;
    usize lineIndex = lines.size() - 1u;
    for(usize index = 0u; index < lines.size(); ++index){
        if(point.y < lines[index].top + lines[index].height){
            lineIndex = index;
            break;
        }
    }
    const TextLine line = lines[lineIndex];
    hit.byteOffset = line.byteBegin;
    if(line.clusterCount == 0u)
        return hit;
    f32 nearest = s_TextMaxCoordinateF32;
    for(u32 index = line.firstCluster; index < line.firstCluster + line.clusterCount; ++index){
        const TextCluster cluster = clusters[cast<usize>(index)];
        const f32 leadingDistance = abs(point.x - cluster.leadingX);
        const f32 trailingDistance = abs(point.x - cluster.trailingX);
        if(leadingDistance <= nearest){
            nearest = leadingDistance;
            hit.byteOffset = cluster.byteBegin;
        }
        if(trailingDistance < nearest){
            nearest = trailingDistance;
            hit.byteOffset = cluster.byteEnd;
        }
    }
    return hit;
}

Expected<Rect> TryResolveTextCaretRect(in Span<TextLine> lines, in Span<TextCluster> clusters, in TextDirection direction, in u32 byteOffset, in TextCaretEdge edge){
    if(edge != TextCaretEdge::Leading && edge != TextCaretEdge::Trailing)
        return makeUnexpected(Failure());
    b8 hasAlternate = false;
    TextCluster alternate;
    for(usize i = 0u; i < clusters.size(); ++i){
        const TextCluster cluster = clusters[i];
        b8 matched = false;
        if(edge == TextCaretEdge::Leading)
            matched = cluster.byteBegin == byteOffset;
        else
            matched = cluster.byteEnd == byteOffset;
        if(matched){
            const TextLine line = lines[cast<usize>(cluster.lineIndex)];
            f32 x = cluster.trailingX;
            if(edge == TextCaretEdge::Leading)
                x = cluster.leadingX;
            return Rect(x, line.top, 0.0f, line.height);
        }
        if(cluster.byteBegin == byteOffset || cluster.byteEnd == byteOffset){
            alternate = cluster;
            hasAlternate = true;
        }
    }
    if(hasAlternate){
        const TextLine line = lines[cast<usize>(alternate.lineIndex)];
        f32 x = alternate.trailingX;
        if(alternate.byteBegin == byteOffset)
            x = alternate.leadingX;
        return Rect(x, line.top, 0.0f, line.height);
    }
    for(usize i = 0u; i < lines.size(); ++i){
        const TextLine line = lines[i];
        if(byteOffset == line.byteBegin || byteOffset == line.byteEnd){
            const b8 atBegin = byteOffset == line.byteBegin;
            f32 x = line.advance;
            if(atBegin == (direction == TextDirection::LeftToRight))
                x = 0.0f;
            return Rect(x, line.top, 0.0f, line.height);
        }
    }
    return makeUnexpected(Failure());
}

TextGlyphIntersection TryIntersectTextBounds(in f64 minX, in f64 minY, in f64 maxX, in f64 maxY, in Rect clip){
    if(
        !FitsTextCoordinate(minX) || !FitsTextCoordinate(minY)
        || !FitsTextCoordinate(maxX) || !FitsTextCoordinate(maxY)
        || maxX < minX || maxY < minY
    )
        return TextGlyphIntersection::Invalid;
    const f64 extentX = maxX - minX;
    const f64 extentY = maxY - minY;
    if(extentX > s_TextMaxCoordinateF64 || extentY > s_TextMaxCoordinateF64)
        return TextGlyphIntersection::Invalid;
    const f64 clipX = cast<f64>(clip.x);
    const f64 clipY = cast<f64>(clip.y);
    if(maxX <= minX || maxY <= minY || clip.width <= 0.0f || clip.height <= 0.0f || maxX <= clipX || maxY <= clipY)
        return TextGlyphIntersection::Invisible;
    const f64 clipEndX = clipX + cast<f64>(clip.width);
    const f64 clipEndY = clipY + cast<f64>(clip.height);
    if(minX >= clipEndX || minY >= clipEndY)
        return TextGlyphIntersection::Invisible;
    return TextGlyphIntersection::Visible;
}

TextGlyphIntersection TryIntersectTextRects(in Rect rectangle, in Rect clip){
    if(!IsValidUiRect(rectangle) || !IsValidUiRect(clip))
        return TextGlyphIntersection::Invalid;
    const f64 minX = cast<f64>(rectangle.x);
    const f64 minY = cast<f64>(rectangle.y);
    const f64 maxX = minX + cast<f64>(rectangle.width);
    const f64 maxY = minY + cast<f64>(rectangle.height);
    return TryIntersectTextBounds(minX, minY, maxX, maxY, clip);
}

class GlyphPageBindingRecord<TFont>{
    public b8 operator==(in GlyphPageBindingRecord<TFont> rhs)const{
        return this.font == rhs.font && this.fontGeneration == rhs.fontGeneration && this.atlasIdentity == rhs.atlasIdentity && this.generation == rhs.generation && this.index == rhs.index && this.width == rhs.width && this.height == rhs.height;
    }

    public b8 operator!=(in GlyphPageBindingRecord<TFont> rhs)const{
        return this.font != rhs.font || this.fontGeneration != rhs.fontGeneration || this.atlasIdentity != rhs.atlasIdentity || this.generation != rhs.generation || this.index != rhs.index || this.width != rhs.width || this.height != rhs.height;
    }

    public AssetRef<TFont> font;
    public u64 fontGeneration = 0u;
    public u64 atlasIdentity = 0u;
    public u64 generation = 0u;
    public u32 index = 0u;
    public u32 width = 0u;
    public u32 height = 0u;
}

class SdfAtlasPageBindingRecord<TFont>{
    public b8 operator==(in SdfAtlasPageBindingRecord<TFont> rhs)const{
        return this.font == rhs.font
            && this.fontSha256 == rhs.fontSha256
            && this.pixelsSha256 == rhs.pixelsSha256
            && this.fontGeneration == rhs.fontGeneration
            && this.atlasIdentity == rhs.atlasIdentity
            && this.generation == rhs.generation
            && this.index == rhs.index
            && this.width == rhs.width
            && this.height == rhs.height
            && this.channelCount == rhs.channelCount
            && this.spreadPixels == rhs.spreadPixels
            && this.distanceEncoding == rhs.distanceEncoding;
    }

    public b8 operator!=(in SdfAtlasPageBindingRecord<TFont> rhs)const{
        return this.font != rhs.font
            || this.fontSha256 != rhs.fontSha256
            || this.pixelsSha256 != rhs.pixelsSha256
            || this.fontGeneration != rhs.fontGeneration
            || this.atlasIdentity != rhs.atlasIdentity
            || this.generation != rhs.generation
            || this.index != rhs.index
            || this.width != rhs.width
            || this.height != rhs.height
            || this.channelCount != rhs.channelCount
            || this.spreadPixels != rhs.spreadPixels
            || this.distanceEncoding != rhs.distanceEncoding;
    }

    public AssetRef<TFont> font;
    public Sha256Digest fontSha256 = Sha256Digest();
    public Sha256Digest pixelsSha256 = Sha256Digest();
    public u64 fontGeneration = 0u;
    public u64 atlasIdentity = 0u;
    public u64 generation = 0u;
    public u32 index = 0u;
    public u32 width = 0u;
    public u32 height = 0u;
    public u32 channelCount = s_SdfMaxChannelCount;
    public u32 spreadPixels = 0u;
    public u32 distanceEncoding = s_FontAtlasDistanceEncoding;
}

b8 SameGlyphPageKey<TFont>(in GlyphPageBindingRecord<TFont> first, in GlyphPageBindingRecord<TFont> second){
    return first.font == second.font && first.fontGeneration == second.fontGeneration && first.atlasIdentity == second.atlasIdentity && first.index == second.index;
}

b8 ValidGlyphPageBinding<TFont>(in GlyphPageBindingRecord<TFont> binding, in usize pixelByteCount){
    return binding.font.valid()
        && binding.fontGeneration != 0u
        && binding.atlasIdentity != 0u
        && binding.generation != 0u
        && binding.index < s_GlyphAtlasMaxPages
        && binding.width != 0u
        && binding.height != 0u
        && binding.width <= s_GlyphAtlasPageExtent
        && binding.height <= s_GlyphAtlasPageExtent
        && pixelByteCount == cast<usize>(binding.width) * cast<usize>(binding.height);
}

b8 SameSdfAtlasPageKey<TFont>(in SdfAtlasPageBindingRecord<TFont> first, in SdfAtlasPageBindingRecord<TFont> second){
    return first.font == second.font && first.fontGeneration == second.fontGeneration && first.atlasIdentity == second.atlasIdentity && first.generation == second.generation && first.index == second.index;
}

b8 ValidSdfAtlasPageBinding<TFont>(in SdfAtlasPageBindingRecord<TFont> binding, in usize pixelByteCount){
    return binding.font.valid()
        && binding.fontGeneration != 0u
        && binding.atlasIdentity != 0u
        && binding.generation != 0u
        && binding.index < s_FontAtlasMaxGroupCount
        && binding.width != 0u
        && binding.height != 0u
        && binding.width <= s_FontAtlasMaxExtent
        && binding.height <= s_FontAtlasMaxExtent
        && binding.channelCount != 0u
        && binding.channelCount <= s_SdfMaxChannelCount
        && binding.spreadPixels >= s_FontAtlasMinSpreadPixels
        && binding.spreadPixels <= s_FontAtlasMaxSpreadPixels
        && binding.distanceEncoding == s_FontAtlasDistanceEncoding
        && pixelByteCount == cast<usize>(binding.width) * cast<usize>(binding.height) * cast<usize>(binding.channelCount);
}

b8 SameShapeRequest(in ShapeRequest lhs, in ShapeRequest rhs){
    return lhs.text == rhs.text && lhs.language == rhs.language && lhs.fontSize == rhs.fontSize && lhs.scriptTag == rhs.scriptTag && lhs.direction == rhs.direction;
}

Point ResolveLabelPaintOrigin(in Rect bounds, in Rect measured){
    return Point(bounds.x - measured.x, bounds.y - measured.y);
}

SdfAtlasPageBindingRecord<TFont> MakeSdfAtlasPageGroupBinding<TFont>(
    in AssetRef<TFont> font,
    in Sha256Digest fontSha256,
    in u64 fontGeneration,
    in u64 atlasIdentity,
    in u32 groupIndex,
    in u32 width,
    in u32 height,
    in u32 channelCount,
    in u32 spreadPixels
){
    SdfAtlasPageBindingRecord<TFont> binding;
    binding.font = font;
    binding.fontSha256 = fontSha256;
    binding.pixelsSha256 = Sha256Digest();
    binding.fontGeneration = fontGeneration;
    binding.atlasIdentity = atlasIdentity;
    binding.generation = 1u;
    binding.index = groupIndex;
    binding.width = width;
    binding.height = height;
    binding.channelCount = channelCount;
    binding.spreadPixels = spreadPixels;
    return binding;
}

b8 CanUseBakedFontAtlasAtPhysicalSize(in u32 bakePpem, in f32 physicalSize){
    if(!isFinite(physicalSize) || physicalSize <= 0.0f)
        return false;
    const f32 ppem = cast<f32>(bakePpem);
    return physicalSize >= ppem * s_BakedFontAtlasMinScale && physicalSize <= ppem * s_BakedFontAtlasMaxScale;
}

b8 IsValidTextGlyphLocation(in Point glyphPosition, in Point topLeft){
    return isFinite(glyphPosition.x) && isFinite(glyphPosition.y) && isFinite(topLeft.x) && isFinite(topLeft.y);
}

Expected<f64x4> TryLoadGlyphAtlasRectangle(
    in Point glyphPosition,
    in Point topLeft,
    in f32 fontSize,
    in u32 unitsPerEm,
    in FontAtlasGlyph record
){
    if(!IsValidTextGlyphLocation(glyphPosition, topLeft) || !IsValidTextFontSize(fontSize) || unitsPerEm == 0u)
        return makeUnexpected(Failure());
    if(record.drawable == 0u)
        return f64x4(0.0, 0.0, 0.0, 0.0);
    if(
        !isFinite(record.planeLeft) || !isFinite(record.planeTop)
        || !isFinite(record.planeRight) || !isFinite(record.planeBottom)
        || record.planeRight <= record.planeLeft || record.planeBottom <= record.planeTop
    )
        return makeUnexpected(Failure());
    const f64 scale = cast<f64>(fontSize) / cast<f64>(unitsPerEm);
    const f64 x = (cast<f64>(topLeft.x) + cast<f64>(glyphPosition.x)) + (cast<f64>(record.planeLeft) * scale);
    const f64 y = (cast<f64>(topLeft.y) + cast<f64>(glyphPosition.y)) + (cast<f64>(record.planeTop) * scale);
    const f64 width = (cast<f64>(record.planeRight) - cast<f64>(record.planeLeft)) * scale;
    const f64 height = (cast<f64>(record.planeBottom) - cast<f64>(record.planeTop)) * scale;
    if(
        !FitsTextCoordinate(x) || !FitsTextCoordinate(y)
        || !FitsTextCoordinate(width) || !FitsTextCoordinate(height)
        || width < 0.0 || height < 0.0
        || !FitsTextCoordinate(x + width) || !FitsTextCoordinate(y + height)
    )
        return makeUnexpected(Failure());
    const f32x4 rounded(cast<f32>(x), cast<f32>(y), cast<f32>(width), cast<f32>(height));
    if(!isFinite(rounded.x) || !isFinite(rounded.y) || !isFinite(rounded.z) || !isFinite(rounded.w) || !isFinite(rounded.x + rounded.z) || !isFinite(rounded.y + rounded.w))
        return makeUnexpected(Failure());
    return f64x4(cast<f64>(rounded.x), cast<f64>(rounded.y), cast<f64>(rounded.z), cast<f64>(rounded.w));
}

TextGlyphIntersection IntersectTextCoverageInk(
    in Point glyphPosition,
    in Point topLeft,
    in Rect ink,
    in b8 coverageKnown,
    in u32 unitsPerEm,
    in f32 fontSize,
    in f32 physicalSize,
    in Rect clip,
    in Point pixelScale
){
    const f64 fontSizeF64 = cast<f64>(fontSize);
    const f64 shapedSize = floor((fontSizeF64 * s_TextFixedPointScaleF64) + s_TextHalfPixel) / s_TextFixedPointScaleF64;
    f64 correctionScalar = 1.0;
    if(!coverageKnown)
        correctionScalar = fontSizeF64 / shapedSize;
    const f64 rasterScale = cast<f64>(physicalSize) / fontSizeF64;
    f64 outlineAllowance = 0.0;
    if(!coverageKnown)
        outlineAllowance = fontSizeF64 / cast<f64>(unitsPerEm);
    // Native outline bounds include their design-unit allowance; keep raster rounding and physical-pixel snapping conservative.
    const f64 rasterMarginScalar = ((max(1.0, correctionScalar) / s_TextFixedPointScaleF64) + (s_TextRasterMarginPixels / rasterScale)) + outlineAllowance;
    const f64 marginX = rasterMarginScalar + (s_TextHalfPixel / cast<f64>(pixelScale.x));
    const f64 marginY = rasterMarginScalar + (s_TextHalfPixel / cast<f64>(pixelScale.y));
    const f64 inkOriginX = cast<f64>(ink.x);
    const f64 inkOriginY = cast<f64>(ink.y);
    const f64 inkEndX = inkOriginX + cast<f64>(ink.width);
    const f64 inkEndY = inkOriginY + cast<f64>(ink.height);
    const f64 posX = cast<f64>(topLeft.x) + cast<f64>(glyphPosition.x);
    const f64 posY = cast<f64>(topLeft.y) + cast<f64>(glyphPosition.y);
    const f64 minX = (posX + min(inkOriginX, inkOriginX * correctionScalar)) - marginX;
    const f64 minY = (posY + min(inkOriginY, inkOriginY * correctionScalar)) - marginY;
    const f64 maxX = (posX + max(inkEndX, inkEndX * correctionScalar)) + marginX;
    const f64 maxY = (posY + max(inkEndY, inkEndY * correctionScalar)) + marginY;
    return TryIntersectTextBounds(minX, minY, maxX, maxY, clip);
}

Expected<Rect> TryResolveGlyphCoverageRectangle(
    in Point glyphPosition,
    in u32 pageIndex,
    in Rect recordPixels,
    in i32 bearingX,
    in i32 bearingY,
    in f32 rasterScale,
    in Point topLeft,
    in Point pixelScale
){
    if(
        !IsValidTextGlyphLocation(glyphPosition, topLeft)
        || !isFinite(rasterScale) || rasterScale <= 0.0f
        || !IsValidUiRect(recordPixels)
        || !isFinite(pixelScale.x) || !isFinite(pixelScale.y) || pixelScale.x <= 0.0f || pixelScale.y <= 0.0f
    )
        return makeUnexpected(Failure());
    if(pageIndex == s_GlyphAtlasNoPage)
        return Rect();
    const f64 scaleF64 = cast<f64>(rasterScale);
    const f64 posX = (cast<f64>(topLeft.x) + cast<f64>(glyphPosition.x)) + (cast<f64>(bearingX) / scaleF64);
    const f64 posY = (cast<f64>(topLeft.y) + cast<f64>(glyphPosition.y)) - (cast<f64>(bearingY) / scaleF64);
    const f64 scaleX = cast<f64>(pixelScale.x);
    const f64 scaleY = cast<f64>(pixelScale.y);
    const f64 alignedX = floor((posX * scaleX) + s_TextHalfPixel) / scaleX;
    const f64 alignedY = floor((posY * scaleY) + s_TextHalfPixel) / scaleY;
    const f64 width = cast<f64>(recordPixels.width) / scaleF64;
    const f64 height = cast<f64>(recordPixels.height) / scaleF64;
    return TryMakeUiRect(alignedX, alignedY, width, height, UiRectPrecision::BoundedEndpoints);
}

b8 FitsTextCoordinateXY(in f64x4 value){
    return FitsTextCoordinate(value.x) && FitsTextCoordinate(value.y);
}

Expected<f64x4> TryTranslateTextInk(in Point position, in Rect ink){
    const f64 originX = cast<f64>(position.x) + cast<f64>(ink.x);
    const f64 originY = cast<f64>(position.y) + cast<f64>(ink.y);
    const f64 endX = originX + cast<f64>(ink.width);
    const f64 endY = originY + cast<f64>(ink.height);
    if(!FitsTextCoordinate(originX) || !FitsTextCoordinate(originY) || !FitsTextCoordinate(endX) || !FitsTextCoordinate(endY))
        return makeUnexpected(Failure());
    const f32 rectX = cast<f32>(originX);
    const f32 rectY = cast<f32>(originY);
    const f32 rectW = ink.width;
    const f32 rectH = ink.height;
    if(!isFinite(rectX + rectW) || !isFinite(rectY + rectH))
        return makeUnexpected(Failure());
    return f64x4(cast<f64>(rectX), cast<f64>(rectY), cast<f64>(rectW), cast<f64>(rectH));
}

b8 ValidateShapedRunMetrics(in FontMetrics metrics, in usize glyphCount){
    return
        isFinite(metrics.ascender) && isFinite(metrics.descender) && isFinite(metrics.lineGap)
        && metrics.ascender >= 0.0f && metrics.descender >= 0.0f && metrics.lineGap >= 0.0f
        && metrics.ascender + metrics.descender > 0.0f && glyphCount <= s_TextMaxBytes
        && FitsTextCoordinate((cast<f64>(metrics.ascender) + cast<f64>(metrics.descender)) + cast<f64>(metrics.lineGap))
    ;
}

b8 ValidateShapedGlyph(
    in u32 byteBegin,
    in u32 byteEnd,
    in Point offset,
    in Point advance,
    in Rect ink,
    in GlyphCoverageBounds coverage,
    in StringView text,
    in TextDirection direction,
    mut u32 inoutPreviousByteBegin
){
    if(
        byteBegin >= byteEnd || !isUtf8ScalarBoundary(text, cast<usize>(byteBegin)) || !isUtf8ScalarBoundary(text, cast<usize>(byteEnd))
        || !isFinite(advance.x) || !isFinite(advance.y) || advance.x < 0.0f || advance.y != 0.0f
        || !isFinite(offset.x) || !isFinite(offset.y) || !HasValidUiRectDimensions(ink)
        || !FitsTextCoordinate(cast<f64>(ink.x) + cast<f64>(ink.width))
        || !FitsTextCoordinate(cast<f64>(ink.y) + cast<f64>(ink.height))
    )
        return false;
    if(coverage.known){
        const Rect cov = coverage.ink;
        if(
            !HasValidUiRectDimensions(cov)
            || !FitsTextCoordinate(cast<f64>(cov.x) + cast<f64>(cov.width))
            || !FitsTextCoordinate(cast<f64>(cov.y) + cast<f64>(cov.height))
        )
            return false;
    }
    if(direction == TextDirection::LeftToRight){
        if(byteBegin < inoutPreviousByteBegin)
            return false;
    }
    else{
        if(byteBegin > inoutPreviousByteBegin)
            return false;
    }
    inoutPreviousByteBegin = byteBegin;
    return true;
}

b8 TryIncludeTextInk(in f64x4 ink, mut f64x4 inoutBounds, mut b8 inoutHasInk){
    if(ink.z <= 0.0 || ink.w <= 0.0)
        return true;
    if(!inoutHasInk){
        inoutBounds = ink;
        inoutHasInk = true;
        return true;
    }
    f64 originX = ink.x;
    if(inoutBounds.x < ink.x)
        originX = inoutBounds.x;
    f64 originY = ink.y;
    if(inoutBounds.y < ink.y)
        originY = inoutBounds.y;
    const f64 boundsEndX = inoutBounds.x + inoutBounds.z;
    const f64 boundsEndY = inoutBounds.y + inoutBounds.w;
    const f64 inkEndX = ink.x + ink.z;
    const f64 inkEndY = ink.y + ink.w;
    f64 endX = inkEndX;
    if(boundsEndX > inkEndX)
        endX = boundsEndX;
    f64 endY = inkEndY;
    if(boundsEndY > inkEndY)
        endY = boundsEndY;
    const f64 sizeX = endX - originX;
    const f64 sizeY = endY - originY;
    if(!FitsTextCoordinate(sizeX) || !FitsTextCoordinate(sizeY))
        return false;
    const f32 rectX = cast<f32>(originX);
    const f32 rectY = cast<f32>(originY);
    const f32 rectW = cast<f32>(sizeX);
    const f32 rectH = cast<f32>(sizeY);
    if(!isFinite(rectX + rectW) || !isFinite(rectY + rectH))
        return false;
    inoutBounds = f64x4(cast<f64>(rectX), cast<f64>(rectY), cast<f64>(rectW), cast<f64>(rectH));
    return true;
}

FontMetrics MaxFontMetrics(in FontMetrics lhs, in FontMetrics rhs){
    FontMetrics out;
    out.ascender = max(lhs.ascender, rhs.ascender);
    out.descender = max(lhs.descender, rhs.descender);
    out.lineGap = max(lhs.lineGap, rhs.lineGap);
    return out;
}

i32 ComputeTextFixedPointScale(in f32 fontSize){
    return cast<i32>(fontSize * s_TextFixedPointScale + s_TextFixedPointRoundBiasF32);
}

GlyphCoverageBounds ComputeOutlineCoverageBounds(in i64 xMin, in i64 yMin, in i64 xMax, in i64 yMax, in f32 fontSize, in u32 unitsPerEm){
    const f64 scale = cast<f64>(fontSize) / cast<f64>(unitsPerEm);
    const f64 left = (cast<f64>(xMin) - s_TextOutlineBoundsMargin) * scale;
    const f64 top = (-cast<f64>(yMax) - s_TextOutlineBoundsMargin) * scale;
    const f64 width = ((cast<f64>(xMax) - cast<f64>(xMin)) + s_TextOutlineBoundsMarginBothSides) * scale;
    const f64 height = ((cast<f64>(yMax) - cast<f64>(yMin)) + s_TextOutlineBoundsMarginBothSides) * scale;
    if(
        !isFinite(left) || !isFinite(top) || !isFinite(width) || !isFinite(height)
        || abs(left) > s_TextMaxCoordinateF64 || abs(top) > s_TextMaxCoordinateF64
        || width < 0.0 || height < 0.0 || width > s_TextMaxCoordinateF64 || height > s_TextMaxCoordinateF64
        || abs(left + width) > s_TextMaxCoordinateF64 || abs(top + height) > s_TextMaxCoordinateF64
    )
        return GlyphCoverageBounds();
    const Rect ink(cast<f32>(left), cast<f32>(top), cast<f32>(width), cast<f32>(height));
    if(!isFinite(ink.x + ink.width) || !isFinite(ink.y + ink.height))
        return GlyphCoverageBounds();
    return GlyphCoverageBounds(ink, true);
}

Expected<FontMetrics> TryResolveFontExtentsMetrics(in i32 ascender, in i32 descender, in i32 lineGap){
    FontMetrics outMetrics;
    const f32 invScale = 1.0f / s_TextFixedPointScale;
    const f32 scaledAsc = cast<f32>(ascender) * invScale;
    const f32 scaledDesc = (-cast<f32>(descender)) * invScale;
    const f32 scaledGap = cast<f32>(lineGap) * invScale;
    outMetrics.ascender = max(0.0f, scaledAsc);
    outMetrics.descender = max(0.0f, scaledDesc);
    outMetrics.lineGap = max(0.0f, scaledGap);
    if(outMetrics.ascender + outMetrics.descender <= 0.0f)
        return makeUnexpected(Failure());
    return outMetrics;
}

Rect ResolveHbGlyphExtentsInk(in i32 xBearing, in i32 yBearing, in i32 width, in i32 height){
    const f32 scale = 1.0f / s_TextFixedPointScale;
    const f32 originX = cast<f32>(xBearing) * scale;
    const f32 originY = (-cast<f32>(yBearing)) * scale;
    const f32 endX = cast<f32>(width) * scale + originX;
    const f32 endY = originY - cast<f32>(height) * scale;
    const f32 minX = min(originX, endX);
    const f32 minY = min(originY, endY);
    const f32 deltaX = endX - originX;
    const f32 deltaY = endY - originY;
    return Rect(minX, minY, abs(deltaX), abs(deltaY));
}

void ResolveHbGlyphPlacement(in i32 xOffset, in i32 yOffset, in i32 xAdvance, in i32 yAdvance, mut Point outOffset, mut Point outAdvance){
    const f32 scale = 1.0f / s_TextFixedPointScale;
    outOffset = Point(cast<f32>(xOffset) * scale, (-cast<f32>(yOffset)) * scale);
    outAdvance = Point(cast<f32>(xAdvance) * scale, (-cast<f32>(yAdvance)) * scale);
}

Expected<f64x4> TryLoadSdfGlyphSupport(
    in f64x4 plane,
    in FontAtlasGlyph glyph,
    in u32 pageWidth,
    in u32 pageHeight,
    in u32 channelCount,
    in u32 spreadPixels,
    in Span<u8> pixels,
    in DisplayMetrics display
){
    if(plane.z <= 0.0 || plane.w <= 0.0)
        return plane;
    const f64 texelSizeX = plane.z / cast<f64>(glyph.width);
    const f64 texelSizeY = plane.w / cast<f64>(glyph.height);
    const f64 physicalStepX = 1.0 / (texelSizeX * cast<f64>(display.pixelScaleX));
    const f64 physicalStepY = 1.0 / (texelSizeY * cast<f64>(display.pixelScaleY));
    if(!isFinite(physicalStepX) || !isFinite(physicalStepY))
        return makeUnexpected(Failure());
    const f64 haloCandidateX = ceil(physicalStepX) + 1.0;
    const f64 haloCandidateY = ceil(physicalStepY) + 1.0;
    const u32 haloX = cast<u32>(min(cast<f64>(pageWidth), haloCandidateX));
    const u32 haloY = cast<u32>(min(cast<f64>(pageHeight), haloCandidateY));
    u32 firstX = 0u;
    if(glyph.x > haloX)
        firstX = glyph.x - haloX;
    u32 firstY = 0u;
    if(glyph.y > haloY)
        firstY = glyph.y - haloY;
    const u32 lastX = min(pageWidth - 1u, glyph.x + glyph.width + haloX);
    const u32 lastY = min(pageHeight - 1u, glyph.y + glyph.height + haloY);
    const usize stride = cast<usize>(pageWidth);
    const usize channels = cast<usize>(channelCount);
    const usize ch = cast<usize>(glyph.channel);
    i32 gradientX = 0;
    i32 gradientY = 0;
    for(u32 y = firstY; y <= lastY; ++y){
        for(u32 x = firstX; x <= lastX; ++x){
            const i32 value = cast<i32>(pixels[((cast<usize>(y) * stride) + cast<usize>(x)) * channels + ch]);
            if(x != lastX){
                const i32 rightValue = cast<i32>(pixels[((cast<usize>(y) * stride) + cast<usize>(x + 1u)) * channels + ch]);
                gradientX = max(gradientX, abs(rightValue - value));
            }
            if(y != lastY){
                const i32 downValue = cast<i32>(pixels[((cast<usize>(y + 1u) * stride) + cast<usize>(x)) * channels + ch]);
                gradientY = max(gradientY, abs(downValue - value));
            }
        }
    }
    const f64 derivative = (cast<f64>(gradientX) * physicalStepX) + (cast<f64>(gradientY) * physicalStepY);
    const f64 minimumDerivative = (s_TextSdfMinimumFilterWidth * s_TextSdfEncodedHalfRange) / cast<f64>(spreadPixels);
    const f64 halfWidth = s_TextHalfPixel * max(derivative, minimumDerivative);
    const f64 glyphWidthF64 = cast<f64>(glyph.width);
    const f64 glyphHeightF64 = cast<f64>(glyph.height);
    f64 supportMinX = glyphWidthF64;
    f64 supportMinY = glyphHeightF64;
    f64 supportMaxX = 0.0;
    f64 supportMaxY = 0.0;
    b8 visible = false;
    for(u32 y = 0u; y <= glyph.height; ++y){
        u32 y0 = 0u;
        if(glyph.y + y != 0u)
            y0 = glyph.y + y - 1u;
        const u32 y1 = min(pageHeight - 1u, glyph.y + y);
        for(u32 x = 0u; x <= glyph.width; ++x){
            u32 x0 = 0u;
            if(glyph.x + x != 0u)
                x0 = glyph.x + x - 1u;
            const u32 x1 = min(pageWidth - 1u, glyph.x + x);
            const i32 s00 = cast<i32>(pixels[((cast<usize>(y0) * stride) + cast<usize>(x0)) * channels + ch]);
            const i32 s10 = cast<i32>(pixels[((cast<usize>(y0) * stride) + cast<usize>(x1)) * channels + ch]);
            const i32 s01 = cast<i32>(pixels[((cast<usize>(y1) * stride) + cast<usize>(x0)) * channels + ch]);
            const i32 s11 = cast<i32>(pixels[((cast<usize>(y1) * stride) + cast<usize>(x1)) * channels + ch]);
            const i32 maximum = max(max(s00, s10), max(s01, s11));
            if(cast<f64>(maximum) + halfWidth < s_TextSdfEncodedHalfRange)
                continue;
            const f64 posX = cast<f64>(x);
            const f64 posY = cast<f64>(y);
            const f64 firstCellX = max(0.0, posX - s_TextHalfPixel);
            const f64 firstCellY = max(0.0, posY - s_TextHalfPixel);
            const f64 lastCellX = min(glyphWidthF64, posX + s_TextHalfPixel);
            const f64 lastCellY = min(glyphHeightF64, posY + s_TextHalfPixel);
            supportMinX = min(supportMinX, firstCellX);
            supportMinY = min(supportMinY, firstCellY);
            supportMaxX = max(supportMaxX, lastCellX);
            supportMaxY = max(supportMaxY, lastCellY);
            visible = true;
        }
    }
    if(!visible)
        return f64x4(0.0, 0.0, 0.0, 0.0);
    const f64 minX = supportMinX * texelSizeX + plane.x;
    const f64 minY = supportMinY * texelSizeY + plane.y;
    const f64 maxX = supportMaxX * texelSizeX + plane.x;
    const f64 maxY = supportMaxY * texelSizeY + plane.y;
    const Expected<Rect> measured = TryMakeMeasuredTextRect(minX, minY, maxX, maxY);
    if(!measured.has_value())
        return makeUnexpected(Failure());
    return f64x4(cast<f64>(measured.value().x), cast<f64>(measured.value().y), cast<f64>(measured.value().width), cast<f64>(measured.value().height));
}

Rect ResolveSdfGlyphUv(in FontAtlasGlyph record, in u32 atlasWidth, in u32 atlasHeight){
    const f32 width = cast<f32>(atlasWidth);
    const f32 height = cast<f32>(atlasHeight);
    return Rect(cast<f32>(record.x) / width, cast<f32>(record.y) / height, cast<f32>(record.width) / width, cast<f32>(record.height) / height);
}

Rect ResolveCoverageGlyphUv(in Rect pixels){
    const f32 extent = cast<f32>(s_GlyphAtlasPageExtent);
    return Rect(pixels.x / extent, pixels.y / extent, pixels.width / extent, pixels.height / extent);
}

void ResolveNextTextLineRange(
    in StringView text,
    in usize byteBegin,
    mut usize outByteEnd,
    mut usize outBreakEnd
){
    usize byteEnd = byteBegin;
    while(byteEnd < text.size() && text[byteEnd] != '\r' && text[byteEnd] != '\n')
        ++byteEnd;
    usize breakEnd = byteEnd;
    if(breakEnd < text.size()){
        if(text[breakEnd] == '\r')
            breakEnd += s_TextCarriageReturnLineFeedBytes;
        else
            breakEnd += 1u;
    }
    outByteEnd = byteEnd;
    outBreakEnd = breakEnd;
}

Expected<TextLine> TryBuildInitialTextLine(
    in usize byteBegin,
    in usize byteEnd,
    in usize breakEnd,
    in usize firstGlyph,
    in usize glyphCount,
    in usize firstCluster,
    in f32 top,
    in FontMetrics metrics
){
    const f64 baseline = cast<f64>(top) + cast<f64>(metrics.ascender);
    const f64 height = (cast<f64>(metrics.ascender) + cast<f64>(metrics.descender)) + cast<f64>(metrics.lineGap);
    if(!FitsTextCoordinate(baseline) || !FitsTextCoordinate(cast<f64>(top) + height))
        return makeUnexpected(Failure());
    TextLine line;
    line.byteBegin = cast<u32>(byteBegin);
    line.byteEnd = cast<u32>(byteEnd);
    line.breakEnd = cast<u32>(breakEnd);
    line.firstGlyph = cast<u32>(firstGlyph);
    line.glyphCount = cast<u32>(glyphCount);
    line.firstCluster = cast<u32>(firstCluster);
    line.top = top;
    line.baseline = cast<f32>(baseline);
    line.height = cast<f32>(height);
    return line;
}

Expected<Point> TryAdvanceTextGlyphPosition(
    in f32 baseline,
    in Point offset,
    in Point advance,
    in Rect ink,
    in GlyphCoverageBounds coverage,
    mut f32 inOutPen,
    mut f64x4 inOutInkBounds,
    mut b8 inOutHasInk
){
    const f64 x = cast<f64>(inOutPen) + cast<f64>(offset.x);
    const f64 y = cast<f64>(baseline) + cast<f64>(offset.y);
    const f64 nextPen = cast<f64>(inOutPen) + cast<f64>(advance.x);
    if(!FitsTextCoordinate(x) || !FitsTextCoordinate(y) || !FitsTextCoordinate(nextPen))
        return makeUnexpected(Failure());
    const Point position(cast<f32>(x), cast<f32>(y));
    const Expected<f64x4> translatedInk = TryTranslateTextInk(position, ink);
    if(!translatedInk.has_value() || !TryIncludeTextInk(translatedInk.value(), inOutInkBounds, inOutHasInk))
        return makeUnexpected(Failure());
    if(coverage.known && !TryTranslateTextInk(position, coverage.ink).has_value())
        return makeUnexpected(Failure());
    inOutPen = cast<f32>(nextPen);
    return position;
}

TextCluster MakeTextCluster(
    in u32 lineByteBegin,
    in u32 glyphByteBegin,
    in u32 glyphByteEnd,
    in u32 firstGlyph,
    in u32 glyphCount,
    in u32 lineIndex,
    in TextDirection direction,
    in f32 clusterLeft,
    in f32 pen
){
    TextCluster cluster;
    cluster.byteBegin = lineByteBegin + glyphByteBegin;
    cluster.byteEnd = lineByteBegin + glyphByteEnd;
    cluster.firstGlyph = firstGlyph;
    cluster.glyphCount = glyphCount;
    cluster.lineIndex = lineIndex;
    if(direction == TextDirection::LeftToRight){
        cluster.leadingX = clusterLeft;
        cluster.trailingX = pen;
    }
    else{
        cluster.leadingX = pen;
        cluster.trailingX = clusterLeft;
    }
    return cluster;
}


