static_assert(is_trivially_copyable<GpuPhysicsJointImpulseOut>(), "GpuPhysicsJointImpulseOut must stay trivially copyable");
static_assert(is_trivially_copyable<GpuPhysicsIslandSlice>(), "GpuPhysicsIslandSlice must stay trivially copyable");

static_assert(cast<u32>(ShapeType::Sphere) == s_ShaderPhysicsShapeTypeSphere, "ShapeType::Sphere mismatch");
static_assert(cast<u32>(ShapeType::Capsule) == s_ShaderPhysicsShapeTypeCapsule, "ShapeType::Capsule mismatch");
static_assert(cast<u32>(ShapeType::Hull) == s_ShaderPhysicsShapeTypeHull, "ShapeType::Hull mismatch");
static_assert(cast<u32>(ShapeType::Mesh) == s_ShaderPhysicsShapeTypeMesh, "ShapeType::Mesh mismatch");
static_assert(cast<u32>(JointType::Distance) == s_ShaderPhysicsJointTypeDistance, "JointType::Distance mismatch");
static_assert(cast<u32>(JointType::Spherical) == s_ShaderPhysicsJointTypeSpherical, "JointType::Spherical mismatch");
static_assert(cast<u32>(JointType::Revolute) == s_ShaderPhysicsJointTypeRevolute, "JointType::Revolute mismatch");
static_assert(cast<u32>(JointType::Prismatic) == s_ShaderPhysicsJointTypePrismatic, "JointType::Prismatic mismatch");
static_assert(cast<u32>(JointType::Fixed) == s_ShaderPhysicsJointTypeFixed, "JointType::Fixed mismatch");
static_assert(cast<u32>(JointType::Motor) == s_ShaderPhysicsJointTypeMotor, "JointType::Motor mismatch");
static_assert(cast<u32>(JointType::Wheel) == s_ShaderPhysicsJointTypeWheel, "JointType::Wheel mismatch");
static_assert(cast<u32>(BodyFlags::LockLinearX) == s_ShaderPhysicsBodyFlagLockLinearX, "BodyFlags::LockLinearX mismatch");
static_assert(cast<u32>(BodyFlags::LockLinearY) == s_ShaderPhysicsBodyFlagLockLinearY, "BodyFlags::LockLinearY mismatch");
static_assert(cast<u32>(BodyFlags::LockLinearZ) == s_ShaderPhysicsBodyFlagLockLinearZ, "BodyFlags::LockLinearZ mismatch");
static_assert(cast<u32>(BodyFlags::LockAngularX) == s_ShaderPhysicsBodyFlagLockAngularX, "BodyFlags::LockAngularX mismatch");
static_assert(cast<u32>(BodyFlags::LockAngularY) == s_ShaderPhysicsBodyFlagLockAngularY, "BodyFlags::LockAngularY mismatch");
static_assert(cast<u32>(BodyFlags::LockAngularZ) == s_ShaderPhysicsBodyFlagLockAngularZ, "BodyFlags::LockAngularZ mismatch");
static_assert(cast<u32>(BodyFlags::IsSpeedCapped) == s_ShaderPhysicsBodyFlagIsSpeedCapped, "BodyFlags::IsSpeedCapped mismatch");
static_assert(cast<u32>(BodyFlags::AllowFastRotation) == s_ShaderPhysicsBodyFlagAllowFastRotation, "BodyFlags::AllowFastRotation mismatch");
