void VerifyUiSliderLayoutTests_EndpointThumbPositionsMeetTheExactPaddedBounds(){
    const auto metrics = MeasureSlider(SliderOptions(), SliderStyle());
    ASSERT_TRUE(metrics.has_value());
    const Rect bounds = Rect(10.0f, 20.0f, 240.0f, 32.0f);
    const auto first = PlaceSlider(bounds, bounds, metrics.value(), 0.0);
    ASSERT_TRUE(first.has_value());
    const auto last = PlaceSlider(bounds, bounds, metrics.value(), 1.0);
    ASSERT_TRUE(last.has_value());
    EXPECT_FLOAT_EQ(first.value().thumb.x, first.value().travelBounds.x);
    // Lanes are the thumb end and the travel end.
    const VectorSingle ends = VectorSingle(last.value().thumb.x, last.value().travelBounds.x, 0.0f, 0.0f) + VectorSingle(last.value().thumb.width, last.value().travelBounds.width, 0.0f, 0.0f);
    EXPECT_FLOAT_EQ(ends.x, ends.y);
}

void VerifyUiSliderLayoutTests_ClipChangesOnlyVisibilityAndPreservesAcceptedTravelGeometry(){
    const auto metrics = MeasureSlider(SliderOptions(), SliderStyle());
    ASSERT_TRUE(metrics.has_value());
    const Rect bounds = Rect(10.0f, 20.0f, 240.0f, 32.0f);
    const auto full = PlaceSlider(bounds, bounds, metrics.value(), 0.25);
    ASSERT_TRUE(full.has_value());
    const auto clipped = PlaceSlider(bounds, Rect(50.0f, 25.0f, 100.0f, 10.0f), metrics.value(), 0.25);
    ASSERT_TRUE(clipped.has_value());
    ExpectUiRect(clipped.value().clip, Rect(50.0f, 25.0f, 100.0f, 10.0f));
    ExpectUiRect(clipped.value().travelBounds, full.value().travelBounds);
    ExpectUiRect(clipped.value().centerTravel, full.value().centerTravel);
    ExpectUiRect(clipped.value().track, full.value().track);
    ExpectUiRect(clipped.value().thumb, full.value().thumb);
}

void VerifyUiSliderLayoutTests_TinyAreasBoundThumbDimensionsAndProduceZeroTravelSafely(){
    const auto metrics = MeasureSlider(SliderOptions(), SliderStyle());
    ASSERT_TRUE(metrics.has_value());
    const Rect bounds = Rect(10.0f, 20.0f, 20.0f, 12.0f);
    const auto placement = PlaceSlider(bounds, bounds, metrics.value(), 0.5);
    ASSERT_TRUE(placement.has_value());
    ExpectUiRect(placement.value().travelBounds, Rect(14.0f, 24.0f, 12.0f, 4.0f));
    ExpectUiRect(placement.value().thumb, placement.value().travelBounds);
    EXPECT_FLOAT_EQ(placement.value().thumbExtent.x, 12.0f);
    EXPECT_FLOAT_EQ(placement.value().thumbExtent.y, 4.0f);
    EXPECT_FLOAT_EQ(placement.value().centerTravel.width, 0.0f);
    EXPECT_FLOAT_EQ(placement.value().track.width, 0.0f);
}

void VerifyUiSliderLayoutTests_PaddingLargerThanTheAreaAndEmptyAreasRemainValid(){
    const auto metrics = MeasureSlider(SliderOptions(), SliderStyle());
    ASSERT_TRUE(metrics.has_value());
    Array<Rect, 2u> boundsList;
    boundsList[0u] = Rect(10.0f, 20.0f, 4.0f, 3.0f);
    boundsList[1u] = Rect(10.0f, 20.0f, 0.0f, 0.0f);
    for(in Rect bounds : boundsList){
        const auto placement = PlaceSlider(bounds, bounds, metrics.value(), 1.0);
        ASSERT_TRUE(placement.has_value());
        EXPECT_FLOAT_EQ(placement.value().travelBounds.width, 0.0f);
        EXPECT_FLOAT_EQ(placement.value().travelBounds.height, 0.0f);
        EXPECT_FLOAT_EQ(placement.value().thumb.width, 0.0f);
        EXPECT_FLOAT_EQ(placement.value().thumb.height, 0.0f);
        EXPECT_FLOAT_EQ(placement.value().centerTravel.width, 0.0f);
    }
}

void VerifyUiSliderLayoutTests_InvalidOptionsStylesAndTintsRejectMetrics(){
    for(u32 field = 0u; field < 13u; ++field){
        SliderOptions options = SliderOptions();
        SliderStyle style = SliderStyle();
        switch(field){
        case 0u:
            options.minimum = 2.0;
            break;
        case 1u:
            options.maximum = bit_cast<f64>(s_UiSliderPosInfF64Bits);
            break;
        case 2u:
            options.keyStep = -1.0;
            break;
        case 3u:
            options.height = -1.0f;
            break;
        case 4u:
            options.width.value = 0.0f;
            break;
        case 5u:
            style.padding.left = -1.0f;
            break;
        case 6u:
            style.thumbExtent.x = 0.0f;
            break;
        case 7u:
            style.thumbExtent.y = bit_cast<f32>(s_UiSliderQuietNaNF32Bits);
            break;
        case 8u:
            style.trackHeight = 0.0f;
            break;
        case 9u:
            style.hoverTint.r = -1.0f;
            break;
        case 10u:
            style.pressedTint.a = 1.01f;
            break;
        case 11u:
            style.disabledTint.a = bit_cast<f32>(s_UiSliderQuietNaNF32Bits);
            break;
        default:
            style.padding.right = bit_cast<f32>(s_UiSliderPosInfF32Bits);
            break;
        }
        EXPECT_FALSE(MeasureSlider(options, style).has_value());
    }
}

void VerifyUiSliderLayoutTests_OverflowingIntrinsicMetricsAreRejected(){
    SliderStyle style = SliderStyle();
    style.thumbExtent.x = f32.max;
    style.padding.left = f32.max;
    EXPECT_FALSE(MeasureSlider(SliderOptions(), style).has_value());
}

void VerifyUiSliderLayoutTests_InvalidProspectivePlacementRejectsGeometry(){
    const auto metrics = MeasureSlider(SliderOptions(), SliderStyle());
    ASSERT_TRUE(metrics.has_value());
    const Rect normal = Rect(10.0f, 20.0f, 240.0f, 32.0f);
    for(u32 field = 0u; field < 10u; ++field){
        Rect bounds = normal;
        Rect clip = normal;
        SliderMetrics invalid = metrics.value();
        f64 normalized = 0.5;
        switch(field){
        case 0u:
            bounds.width = -1.0f;
            break;
        case 1u:
            bounds.x = bit_cast<f32>(s_UiSliderQuietNaNF32Bits);
            break;
        case 2u:
            bounds = Rect(f32.max, 0.0f, f32.max, 32.0f);
            break;
        case 3u:
            clip.height = -1.0f;
            break;
        case 4u:
            invalid.thumbExtent.x = -1.0f;
            break;
        case 5u:
            invalid.contentSize.y = 1.0f;
            break;
        case 6u:
            normalized = -0.01;
            break;
        case 7u:
            normalized = 1.01;
            break;
        case 8u:
            normalized = bit_cast<f64>(s_UiSliderPosInfF64Bits);
            break;
        default:
            normalized = bit_cast<f64>(s_UiSliderQuietNaNF64Bits);
            break;
        }
        EXPECT_FALSE(PlaceSlider(bounds, clip, invalid, normalized).has_value());
    }
}

void VerifyUiSliderLayoutTests_PositiveDimensionsThatCollapseAtExtremeCoordinatesAreRejected(){
    const auto metrics = MeasureSlider(SliderOptions(), SliderStyle());
    ASSERT_TRUE(metrics.has_value());
    const Rect bounds = Rect(f32.max, 0.0f, 1.0f, 32.0f);
    EXPECT_FALSE(PlaceSlider(bounds, bounds, metrics.value(), 0.5).has_value());
}


