using EditLimits = ::NWB::Impl::Ui::EditLimits;
using FloatBounds = ::NWB::Impl::Ui::FloatBounds;
using IntegerBounds = ::NWB::Impl::Ui::IntegerBounds;
using NumericBoundsPolicyEnum = ::NWB::Impl::Ui::NumericBoundsPolicy::Enum;
using InputCommandIntent = ::NWB::Impl::Ui::InputCommandIntent;
