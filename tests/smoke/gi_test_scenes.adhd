    outPatches[1u] = ComplexSceneBox(VectorSingle(0.45f, 0.025f, -0.55f, 0.0f), VectorSingle(0.85f, 0.05f, 0.80f, 0.0f), VectorSingle(s_GiBlueBounceTint), 0.0f);
