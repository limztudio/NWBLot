////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "style.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const Color s_PopupBackdropColor = Color(0.0f, 0.0f, 0.0f, 0.4f);

class PopupStyle{
    public Name background = Name("popup.normal");
    public Name fallback = Name("panel.normal");
    public Insets padding = Insets(s_StyleSpacingMedium, s_StyleSpacingMedium, s_StyleSpacingMedium, s_StyleSpacingMedium);
    public Color backdrop = s_PopupBackdropColor;
}

enum<u8> PopupPlacementSide{
    Below,
    Above,
    Right,
    Left,
    Center,
}

const Point s_PopupDefaultSize = Point(220.0f, 160.0f);

class PopupOptions{
    public Rect anchor;
    public Point size = s_PopupDefaultSize;
    public PopupPlacementSide side = PopupPlacementSide::Below;
    public f32 gap = s_StyleSpacingSmall;
    public b8 modal = false;
    public b8 dismissOutside = true;
    public b8 dismissCancel = true;
    public b8 autofocus = true;
}

class PopupPlacement{
    public Rect bounds;
    public Rect viewport;
    public PopupPlacementSide side = PopupPlacementSide::Below;
}

class ContextMenuOptions{
    public Point size = s_PopupDefaultSize;
    public f32 wheelRows = s_StyleScrollWheelStep;
    public b8 enabled = true;
}

class ContextMenuResult{
    public b8 valid = false;
    public b8 opened = false;
    public b8 closed = false;
    public b8 activated = false;
    public u64 key = 0u;
}

b8 IsValidPopupOptions(in PopupOptions options, in DisplayMetrics display){
    return IsValidUiRect(options.anchor)
        && isFinite(options.size.x)
        && isFinite(options.size.y)
        && options.size.x > 0.0f
        && options.size.y > 0.0f
        && options.side <= PopupPlacementSide::Center
        && isFinite(options.gap)
        && options.gap >= 0.0f
        && isFinite(display.logicalWidth)
        && display.logicalWidth > 0.0f
        && isFinite(display.logicalHeight)
        && display.logicalHeight > 0.0f
        && isFinite(display.pixelScaleX)
        && display.pixelScaleX > 0.0f
        && isFinite(display.pixelScaleY)
        && display.pixelScaleY > 0.0f;
}

PopupPlacementSide OppositePopupPlacementSide(in PopupPlacementSide side){
    switch(side){
    case PopupPlacementSide::Below:
        return PopupPlacementSide::Above;
    case PopupPlacementSide::Above:
        return PopupPlacementSide::Below;
    case PopupPlacementSide::Right:
        return PopupPlacementSide::Left;
    case PopupPlacementSide::Left:
        return PopupPlacementSide::Right;
    default:
        return PopupPlacementSide::Center;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

