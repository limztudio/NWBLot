[cpp_header("<tests/common/memory_sdk.h>"), cpp_name("::NWB::Tests::ScratchStorage")]
extern class ScratchStorage{
    TestScratchAllocator arena;
    T makeValue<T>(...);
    ArenaMemoryStats memoryStats()const;
    AllocationIdentity identity()const;
};


