////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_subsystem/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ReadSubsystemPodSpan<PodT>(in Span<u8> binary, mut usize cursor, mut Span<PodT> outSpan){
    for(usize i = 0u; i < outSpan.size(); ++i){
        const Expected<PodT> item = ReadPOD<PodT>(binary, cursor);
        if(!item.has_value())
            return false;
        outSpan[i] = item.value();
    }
    return true;
}

class SubsystemBinaryCounts{
    public usize cursor = 0u;
    public usize subsystemCount = 0u;
    public usize fieldCount = 0u;
    public usize assetCount = 0u;
}

class SubsystemBinaryCodec{
    private SubsystemHeaderBinary makeHeader(
        in NameHash subsystemTypeHash,
        in u64 subsystemCount,
        in u64 fieldCount,
        in u64 assetCount
    )const{
        SubsystemHeaderBinary header;
        header.subsystemTypeHash = subsystemTypeHash;
        header.subsystemCount = subsystemCount;
        header.fieldCount = fieldCount;
        header.assetCount = assetCount;
        return header;
    }

    private Expected<u64> trySumFieldElementCounts(in Span<u64> fieldCounts)const{
        u64 totalCount = 0u;
        for(usize i = 0u; i < fieldCounts.size(); ++i){
            u64 count = fieldCounts[i];
            if(count == 0u || count > 0xFFFFFFFFFFFFFFFFu - totalCount)
                return MakeUnexpected(Failure());
            totalCount += count;
        }
        return totalCount;
    }

    private b8 validateHeader(in SubsystemHeaderBinary header, in Name assetType, in usize expectedFieldCount)const{
        if(header.subsystemTypeHash != assetType.hash()){
            error("ISubsystem::loadBinary failed: subsystem binary type does not match '{}'", assetType.resolvedText());
            return false;
        }
        if(header.fieldCount != cast<u64>(expectedFieldCount)){
            error(
                "ISubsystem::loadBinary failed: expected {} asset fields for '{}', got {}"
                , expectedFieldCount
                , assetType.resolvedText()
                , header.fieldCount
            );
            return false;
        }
        return true;
    }

    private Expected<usize> validatePayloadSlice(
        in Span<u8> binary,
        mut usize inOutOffset,
        in u64 rawCount,
        in usize strideBytes,
        in StringView label
    )const{
        if(rawCount > cast<u64>(usize.max / strideBytes)){
            error("ISubsystem::loadBinary failed: '{}' payload byte size overflows", label);
            return MakeUnexpected(Failure());
        }
        const usize count = cast<usize>(rawCount);
        const usize byteCount = count * strideBytes;
        if(!CanReadBytes(binary, inOutOffset, byteCount)){
            error("ISubsystem::loadBinary failed: malformed '{}' payload", label);
            return MakeUnexpected(Failure());
        }
        inOutOffset += byteCount;
        return count;
    }

    private b8 validateFieldElementCountSum(in Span<u64> fieldCounts, in u64 expectedAssetCount)const{
        const Expected<u64> totalCount = this.trySumFieldElementCounts(fieldCounts);
        if(!totalCount.has_value()){
            error("ISubsystem::loadBinary failed: invalid field element count");
            return false;
        }
        if(totalCount.value() != expectedAssetCount){
            error("ISubsystem::loadBinary failed: field element counts do not sum to asset count");
            return false;
        }
        return true;
    }

    public b8 serialize(
        in NameHash subsystemTypeHash,
        in Span<NameHash> subsystemHashes,
        in Span<u64> fieldCounts,
        in Span<NameHash> assetHashes,
        mut Vector<u8> outBinary
    )const{
        usize reserveBytes = s_SubsystemHeaderBinaryBytes;
        const b8 canReserve =
            AddBinaryRepeatedReserveBytes(reserveBytes, subsystemHashes.size(), s_SubsystemNameHashBinaryBytes)
            && AddBinaryRepeatedReserveBytes(reserveBytes, fieldCounts.size(), s_SubsystemFieldCountBinaryBytes)
            && AddBinaryRepeatedReserveBytes(reserveBytes, assetHashes.size(), s_SubsystemNameHashBinaryBytes)
            && CanStoreValueCount(outBinary, reserveBytes)
        ;
        if(!canReserve){
            error("SubsystemAssetCodec::serialize failed: subsystem payload byte size overflows");
            return false;
        }

        outBinary.clear();
        outBinary.reserve(reserveBytes);

        const SubsystemHeaderBinary header = this.makeHeader(
            subsystemTypeHash,
            cast<u64>(subsystemHashes.size()),
            cast<u64>(fieldCounts.size()),
            cast<u64>(assetHashes.size())
        );
        AppendPOD(outBinary, header);
        for(in NameHash hash : subsystemHashes)
            AppendPOD(outBinary, hash);
        for(in u64 count : fieldCounts)
            AppendPOD(outBinary, count);
        for(in NameHash hash : assetHashes)
            AppendPOD(outBinary, hash);
        return true;
    }

    public Expected<SubsystemBinaryCounts> readCounts(
        in Span<u8> binary,
        in Name assetType,
        in usize expectedFieldCount
    )const{
        usize cursor = 0u;
        const Expected<SubsystemHeaderBinary> headerResult = ReadMagicVersionHeaderPayload<SubsystemHeaderBinary>(
            binary,
            s_SubsystemMagic,
            s_SubsystemVersion,
            "ISubsystem::loadBinary",
            "subsystem",
            cursor
        );
        if(!headerResult.has_value())
            return MakeUnexpected(Failure());
        const SubsystemHeaderBinary header = headerResult.value();
        if(!this.validateHeader(header, assetType, expectedFieldCount))
            return MakeUnexpected(Failure());

        usize payloadOffset = cursor;
        const Expected<usize> subsystemCount = this.validatePayloadSlice(
            binary,
            payloadOffset,
            header.subsystemCount,
            s_SubsystemNameHashBinaryBytes,
            "subsystems"
        );
        if(!subsystemCount.has_value())
            return MakeUnexpected(Failure());
        const Expected<usize> fieldCount = this.validatePayloadSlice(
            binary,
            payloadOffset,
            header.fieldCount,
            s_SubsystemFieldCountBinaryBytes,
            "field counts"
        );
        if(!fieldCount.has_value())
            return MakeUnexpected(Failure());
        const Expected<usize> assetCount = this.validatePayloadSlice(
            binary,
            payloadOffset,
            header.assetCount,
            s_SubsystemNameHashBinaryBytes,
            "assets"
        );
        if(!assetCount.has_value())
            return MakeUnexpected(Failure());

        SubsystemBinaryCounts counts = SubsystemBinaryCounts();
        counts.cursor = cursor;
        counts.subsystemCount = subsystemCount.value();
        counts.fieldCount = fieldCount.value();
        counts.assetCount = assetCount.value();
        return counts;
    }

    public b8 readPayloads(
        in Span<u8> binary,
        in usize initialCursor,
        in u64 expectedAssetCount,
        mut Span<NameHash> outSubsystemHashes,
        mut Span<u64> outFieldCounts,
        mut Span<NameHash> outAssetHashes
    )const{
        usize cursor = initialCursor;
        if(!ReadSubsystemPodSpan(binary, cursor, outSubsystemHashes)
            || !ReadSubsystemPodSpan(binary, cursor, outFieldCounts)
            || !ReadSubsystemPodSpan(binary, cursor, outAssetHashes)
        )
            return false;

        if(!ReadCompletePayload(binary, cursor, "ISubsystem::loadBinary"))
            return false;

        return this.validateFieldElementCountSum(outFieldCounts, expectedAssetCount);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

