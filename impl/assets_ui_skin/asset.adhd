////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/global.adhd>
#include <impl/assets_texture/asset.adhd>
#include <impl/assets_ui_skin/validation.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_UiSkinAssetKindLabel = "UI skin";
const StringView s_UiSkinLoadBinaryContext = "UiSkin::loadBinary";

type RegionVector = Vector<UiSkinRegion>;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[arena, asset("ui_skin")]
class UiSkin{
    private RegionVector m_regions;
    private Vector<u32> m_regionIndex;
    private AssetRef<Texture> m_texture = AssetRef<Texture>();
    private u32 m_atlasWidth = 0u;
    private u32 m_atlasHeight = 0u;
    private f32 m_referenceDensity = 1.0f;
    private UiSkinPalette m_palette = UiSkinPalette();
    private UiSkinTypography m_typography = UiSkinTypography();

    public b8 loadBinary(in Span<u8> binary);
    public b8 validatePayload()const;
    public b8 validateTexture(in Texture texture)const;

    public void setAtlas(in AssetRef<Texture> texture, in u32 width, in u32 height, in f32 referenceDensity, in RegionVector regions){
        this.m_regions = regions;
        ResetUiSkinAtlasFields(
            texture,
            width,
            height,
            referenceDensity,
            this.m_regions,
            this.m_regionIndex,
            this.m_texture,
            this.m_atlasWidth,
            this.m_atlasHeight,
            this.m_referenceDensity,
            this.m_palette,
            this.m_typography
        );
    }
    public void setPalette(in UiSkinPalette palette){ this.m_palette = palette; }
    public void setTypography(in UiSkinTypography typography){ this.m_typography = typography; }

    public in AssetRef<Texture> texture()const{ return this.m_texture; }
    public u32 atlasWidth()const{ return this.m_atlasWidth; }
    public u32 atlasHeight()const{ return this.m_atlasHeight; }
    public f32 referenceDensity()const{ return this.m_referenceDensity; }
    public in RegionVector regions()const{ return this.m_regions; }
    public Span<u32> regionIndex()const{ return Span<u32>(this.m_regionIndex); }
    public in UiSkinPalette palette()const{ return this.m_palette; }
    public in UiSkinTypography typography()const{ return this.m_typography; }
    public Expected<usize> findRegionIndex(in Name name)const{
        return TryFindUiSkinRegionIndex(Span<UiSkinRegion>(this.m_regions), Span<u32>(this.m_regionIndex), name);
    }
    public b8 hasRegion(in Name name)const{ return this.findRegionIndex(name).has_value(); }
    public b8 tryFindRegion(in Name name, mut UiSkinRegion outRegion)const{
        Expected<usize> regionPosition = this.findRegionIndex(name);
        if(!regionPosition.has_value())
            return false;
        outRegion = this.m_regions[regionPosition.value()];
        return true;
    }

    private void rebuildRegionIndex(){
        RebuildUiSkinRegionIndex(this.m_regions, this.m_regionIndex);
    }
}

// The stock widget styles use this fixed region contract. Generic UiSkin assets may contain fewer regions.
b8 ValidateUiSkinToolkitContract(in UiSkin skin){
    if(!skin.validatePayload())
        return false;
    return ValidateUiSkinToolkitRegions(Span<UiSkinRegion>(skin.regions()), skin.regionIndex());
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
