const usize s_GraphicsPrefixTimingTaskCount = 8u;
const usize s_DeferredTimingTicketCapacity = 15u + s_AvboitTaskGraphTimingTicketCapacity;
// Capacity, not a runtime packet-count assumption.
const usize s_FrameExecuteLifecycleCallbackCapacity = 6u;
// Scene TLAS backing and the three BVH sort buffers; the CSG trace context adds one.
const usize s_ShadowPrepareFixedStateBufferCapacity = 4u;
const usize s_ShadowPrepareCsgStateBufferCapacity = 5u;
const usize s_SinglePersistentResourceCapacity = 1u;
const usize s_ShadowComputeScratchTextureCapacity = 15u;
const usize s_ShadowComputeScratchBufferCapacity = 12u;
const usize s_CausticsComputeScratchTextureCapacity = 4u;
const usize s_SurfelGiComputeScratchBufferCapacity = 6u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[reflect]
enum<u8> DeferredGraphicsPrefixTimingSlot{
    MeshViewSetup,
    SceneShadingSetup,
    DeferredClear,
    Gbuffer,
    CsgReceiverSpanBuild,
    CsgIntervalCombine,
    CsgIntervalSample,
    Normalize,
    kCount
}

[reflect]
enum<u8> LaggedLightingReport{
    Unreported,
    NoDedicatedAsyncCompute,
    BootstrapAccepted,
    ActiveHistoryAccepted,
    CurrentFrameAccepted
}

class GraphicsPrefixTimingResolutionResult{
    public usize uniquePacketCount = 0u;
    public b8 bindingsValid = true;
}

class OpaqueEmulationMergeValidationResult{
    public b8 packetsAreGraphics = false;
    public b8 opaqueComputeEmulationMerged = false;
    public b8 opaqueSharedComputeEmulationMerged = false;
    public b8 opaqueCsgReceiverComputeEmulationMerged = false;
    public b8 opaqueCsgIntervalSampleComputeEmulationMerged = false;
    public b8 csgIntervalClearBundleMerged = false;
}

void ReportLaggedLightingTransitionIfNeeded(
    in LaggedLightingReport report,
    in u64 targetGeneration,
    mut LaggedLightingReport inOutLastReport,
    mut u64 inOutLastGeneration
){
    if(inOutLastReport == report && inOutLastGeneration == targetGeneration)
        return;

    inOutLastReport = report;
    inOutLastGeneration = targetGeneration;
    switch(report){
    case LaggedLightingReport::Unreported:
        break;
    case LaggedLightingReport::NoDedicatedAsyncCompute:
        [essential]
        info("RendererSystem: frame-lagged async lighting Graphics queue route accepted (no dedicated Compute queue, target generation {})", targetGeneration);
        break;
    case LaggedLightingReport::BootstrapAccepted:
        [essential]
        info(
            "RendererSystem: frame-lagged async lighting bootstrap accepted (target generation {})"
            , targetGeneration
        );
        break;
    case LaggedLightingReport::ActiveHistoryAccepted:
        [essential]
        info(
            "RendererSystem: frame-lagged async lighting active history accepted (target generation {})"
            , targetGeneration
        );
        break;
    case LaggedLightingReport::CurrentFrameAccepted:
        [essential]
        info(
            "RendererSystem: frame-lagged async lighting current-frame path accepted (target generation {})"
            , targetGeneration
        );
        break;
    }
}

void LogRejectedDeferredGraphTopology(
    in u32 opaquePacketIndex,
    in u32 opaqueWaveletPacketIndex,
    in u32 opaqueResolvePacketIndex,
    in u32 transparentPacketIndex,
    in u32 temporalPacketIndex,
    in u32 waveletPacketIndex,
    in u32 terminalPacketIndex,
    in b8 shadowVisibilityPreparedTasksMerged,
    in b8 shadowVisibilityAllLitClearMerged,
    in b8 shadowVisibilityAdaptivePrimitivesMerged,
    in b8 surfelGiOutputClearMergedIntoGiPacket,
    in b8 surfelGiPreparedPrefixMergedIntoGiPacket,
    in b8 surfelGiInitializationLifecycleMergedIntoPreparationPacket,
    in b8 causticPhotonMergedIntoCausticsPacket,
    in b8 causticGeometryMergedIntoCausticsPacket,
    in u32 opaqueDecision,
    in u32 transparentDecision,
    in u32 temporalDecision,
    in u32 waveletDecision,
    in u32 terminalDecision,
    in u32 diagnosticDecision,
    in u32 diagnosticPacketIndex,
    in b8 graphDeclared,
    in b8 graphScheduled
){
    info(
        "RendererSystem: rejected graph shadow packets opaque={} opaqueWavelet={} opaqueResolve={} transparent={} temporal={} wavelet={} terminal={}"
        , opaquePacketIndex
        , opaqueWaveletPacketIndex
        , opaqueResolvePacketIndex
        , transparentPacketIndex
        , temporalPacketIndex
        , waveletPacketIndex
        , terminalPacketIndex
    );
    info(
        "RendererSystem: rejected graph lighting merges shadow={} allLit={} adaptive={} surfelClear={} surfelPrefix={} surfelInit={} causticPhoton={} causticGeometry={}"
        , shadowVisibilityPreparedTasksMerged
        , shadowVisibilityAllLitClearMerged
        , shadowVisibilityAdaptivePrimitivesMerged
        , surfelGiOutputClearMergedIntoGiPacket
        , surfelGiPreparedPrefixMergedIntoGiPacket
        , surfelGiInitializationLifecycleMergedIntoPreparationPacket
        , causticPhotonMergedIntoCausticsPacket
        , causticGeometryMergedIntoCausticsPacket
    );
    info(
        "RendererSystem: rejected graph shadow merge decisions opaque={} transparent={} temporal={} wavelet={} terminal={} diagnostic={} diagnosticPacket={}"
        , opaqueDecision
        , transparentDecision
        , temporalDecision
        , waveletDecision
        , terminalDecision
        , diagnosticDecision
        , diagnosticPacketIndex
    );
    error(
        "RendererSystem: compiled deferred graph topology was unavailable (declared={} scheduled={})"
        , graphDeclared
        , graphScheduled
    );
}

void LogDeferredGraphSchedulingFailure(
    in u32 analysisStatus,
    in u32 analysisTaskIndex,
    in u32 analysisResourceIndex,
    in u32 queueStatus,
    in u32 queueTaskIndex
){
    warning(
        "RendererSystem: deferred graph scheduling failed: analysis={} task={} resource={} queue={} queueTask={}"
        , analysisStatus
        , analysisTaskIndex
        , analysisResourceIndex
        , queueStatus
        , queueTaskIndex
    );
}

void LogCommittedDeferredFrameTargets(
    in u32 width,
    in u32 height,
    in StringView albedoFormat,
    in StringView normalFormat,
    in StringView worldPositionFormat,
    in StringView opaqueColorFormat,
    in StringView compositeColorFormat,
    in StringView depthFormat,
    in StringView shadowVisibilityFormat,
    in u32 csgPeelLayerCount,
    in StringView csgCapNormalFormat,
    in StringView csgIntervalDepthFormat,
    in StringView csgIntervalIdFormat,
    in u32 csgReceiverEventLayerCount,
    in StringView csgReceiverEventDataFormat,
    in StringView csgReceiverEventCountFormat,
    in u32 csgReceiverSpanLayerCount,
    in StringView csgReceiverSpanDataFormat,
    in StringView csgReceiverSpanCountFormat,
    in u32 csgRemovedIntervalLayerCount,
    in StringView csgRemovedIntervalDepthFormat,
    in StringView csgRemovedIntervalCapNormalFormat,
    in StringView csgRemovedIntervalDataFormat,
    in StringView csgRemovedIntervalCountFormat,
    in StringView avboitAccumColorFormat,
    in StringView avboitAccumExtinctionFormat,
    in StringView avboitTransmittanceFormat
){
    [essential]
    info(
        "RendererSystem: deferred rendering targets ready ({}x{}, albedo {}, normal {}, world position {}, opaque color {}, composite color {}, depth {}, shadow visibility {}, CSG peel {} layers: cap back normal {}, interval depth {}, interval id {}, receiver events {} layers: event data {}, event count {}, receiver spans {} layers: span data {}, span count {}, removed intervals {} layers: interval depth {}, cap normal {}, interval data {}, interval count {}, AVBOIT color {}, extinction {}, transmittance {})"
        , width
        , height
        , albedoFormat
        , normalFormat
        , worldPositionFormat
        , opaqueColorFormat
        , compositeColorFormat
        , depthFormat
        , shadowVisibilityFormat
        , csgPeelLayerCount
        , csgCapNormalFormat
        , csgIntervalDepthFormat
        , csgIntervalIdFormat
        , csgReceiverEventLayerCount
        , csgReceiverEventDataFormat
        , csgReceiverEventCountFormat
        , csgReceiverSpanLayerCount
        , csgReceiverSpanDataFormat
        , csgReceiverSpanCountFormat
        , csgRemovedIntervalLayerCount
        , csgRemovedIntervalDepthFormat
        , csgRemovedIntervalCapNormalFormat
        , csgRemovedIntervalDataFormat
        , csgRemovedIntervalCountFormat
        , avboitAccumColorFormat
        , avboitAccumExtinctionFormat
        , avboitTransmittanceFormat
    );
}


