[cpp_header("<core/task/cpu/types.h>"), cpp_name("::NWB::Core::CpuTaskAdmissionError::Enum")]
extern enum CpuTaskAdmissionError : u8{
    InvalidFunction,
    InvalidDependencies,
    InvalidOptions,
    Aborting,
    ScopeCanceled,
    ForeignDependency,
    CapacityExhausted,
    DependencyCycle
};

[cpp_header("<core/task/cpu/types.h>"), cpp_name("::NWB::Core::CpuTaskCost::Enum")]
extern enum CpuTaskCost : u8{
    Any,
    Heavy,
    Light
};

[cpp_header("<core/task/cpu/types.h>"), cpp_name("::NWB::Core::CpuTaskPriority::Enum")]
extern enum CpuTaskPriority : u8{
    Critical,
    Normal,
    Background
};

[cpp_header("<core/task/cpu/types.h>"), cpp_name("::NWB::Core::CpuTaskTarget::Enum")]
extern enum CpuTaskTarget : u8{
    Worker,
    MainThread
};


