    public b8 setJointLength(in JointId jointId, in f32 length){
        if(!this.isValidJoint(jointId) || !IsFinite(VectorSingle(length)) || length < 0.0f)
            return false;
        mut Joint j = this.m_joints[jointId.index];
        j.setLength(length);
        if(j.type == JointType::Pulley && j.extraDataIndex < this.m_jointExtraData.size())
            this.m_jointExtraData[j.extraDataIndex].pulleyConstant = length;
        ++this.m_jointTopologyVersion;
        this.wakeJointBodies(jointId.index);
        return true;
    }

    public b8 setJointLengthRange(in JointId jointId, in f32 minLength, in f32 maxLength){
        if(!this.isValidJoint(jointId) || !IsFinite(VectorSingle(minLength, maxLength, 0.0f, 0.0f)) || minLength < 0.0f || maxLength < minLength)
            return false;
        this.m_joints[jointId.index].setMinLength(minLength);
        this.m_joints[jointId.index].setMaxLength(maxLength);
        ++this.m_jointTopologyVersion;
        this.wakeJointBodies(jointId.index);
        return true;
    }

    public b8 setJointMaxTorque(in JointId jointId, in f32 maxTorque){
        if(!this.isValidJoint(jointId) || !IsFinite(VectorSingle(maxTorque)) || maxTorque < 0.0f)
            return false;
        this.m_joints[jointId.index].maxTorque = maxTorque;
        if(maxTorque <= 0.0f && this.m_joints[jointId.index].type == JointType::Motor)
            this.m_joints[jointId.index].setAngularImpulse(VectorSingle(0.0f));
        ++this.m_jointTopologyVersion;
        this.wakeJointBodies(jointId.index);
        return true;
    }

    public b8 setJointCorrectionFactor(in JointId jointId, in f32 correctionFactor){
        if(!this.isValidJoint(jointId) || !IsFinite(VectorSingle(correctionFactor)) || correctionFactor < 0.0f)
            return false;
        this.m_joints[jointId.index].correctionFactor = Clamp(correctionFactor, 0.0f, 1.0f);
        ++this.m_jointTopologyVersion;
        this.wakeJointBodies(jointId.index);
        return true;
    }

    public b8 setJointTargetRotation(in JointId jointId, in VectorSingle referenceRotation){
        if(!this.isValidJoint(jointId) || !IsFinite(referenceRotation))
            return false;
        this.m_joints[jointId.index].referenceRotation = f32x4(SafeNormalizeQuat(referenceRotation));
        ++this.m_jointTopologyVersion;
        this.wakeJointBodies(jointId.index);
        return true;
    }

    public b8 setJointSuspension(in JointId jointId, in f32 hertz, in f32 dampingRatio){
        if(!this.isValidJoint(jointId) || !IsFinite(VectorSingle(hertz, dampingRatio, 0.0f, 0.0f)) || hertz < 0.0f || dampingRatio < 0.0f)
            return false;
        this.m_joints[jointId.index].suspensionHertz = hertz;
        this.m_joints[jointId.index].suspensionDampingRatio = dampingRatio;
        if(hertz <= 0.0f && this.m_joints[jointId.index].type == JointType::Wheel)
            this.m_joints[jointId.index].setConeOrSuspensionImpulse(0.0f);
        ++this.m_jointTopologyVersion;
        this.wakeJointBodies(jointId.index);
        return true;
    }

    public b8 setJointBreakThresholds(in JointId jointId, in f32 breakForce, in f32 breakTorque){
        if(!this.isValidJoint(jointId) || !IsFinite(VectorSingle(breakForce, breakTorque, 0.0f, 0.0f)) || breakForce < 0.0f || breakTorque < 0.0f)
            return false;
        mut Joint joint = this.m_joints[jointId.index];
        const b8 wasBreakable = joint.breakForce > 0.0f || joint.breakTorque > 0.0f;
        const b8 nowBreakable = breakForce > 0.0f || breakTorque > 0.0f;
        joint.breakForce = breakForce;
        joint.breakTorque = breakTorque;
        if(!wasBreakable && nowBreakable)
            ++this.m_breakableJointCount;
        else if(wasBreakable && !nowBreakable && this.m_breakableJointCount > 0u)
            --this.m_breakableJointCount;
        ++this.m_jointTopologyVersion;
        this.wakeJointBodies(jointId.index);
        return true;
    }

    public b8 setJointCollideConnected(in JointId jointId, in b8 collideConnected){
        if(!this.isValidJoint(jointId))
            return false;
        const u32 idx = jointId.index;
        if(this.m_joints[idx].collideConnected() == collideConnected)
            return true;
        this.m_joints[idx].setFlag(JointFlags::CollideConnected, collideConnected);
        ++this.m_nonCollideJointVersion;
        ++this.m_jointTopologyVersion;
        const u32 bodyIdA = this.m_joints[idx].edges[0u].bodyId;
        const u32 bodyIdB = this.m_joints[idx].edges[1u].bodyId;
        if(!collideConnected){
            u32 cKey = this.m_bodies[bodyIdA].headContactKey;
            while(cKey != s_NullIndex){
                const u32 cId = DecodeContactKeyId(cKey);
                const u32 edgeIdx = DecodeContactKeyEdge(cKey);
                const u32 nextKey = this.m_contacts[cId].edges[edgeIdx].nextKey;
                if(this.m_contacts[cId].edges[edgeIdx ^ 1u].bodyId == bodyIdB && (this.m_contacts[cId].flags & cast<u32>(ContactFlags::Sensor)) == 0u)
                    this.destroyContactInternal(cId);
                cKey = nextKey;
            }
        }
        else{
            u32 shapeIdx = this.m_bodies[bodyIdA].headShapeId;
            while(shapeIdx != s_NullIndex){
                in Shape s = this.m_shapes[shapeIdx];
                if(s.proxyKey != s_NullIndex)
                    this.m_broadPhase.bufferMove(s.proxyKey);
                shapeIdx = s.nextShapeId;
            }
            shapeIdx = this.m_bodies[bodyIdB].headShapeId;
            while(shapeIdx != s_NullIndex){
                in Shape s = this.m_shapes[shapeIdx];
                if(s.proxyKey != s_NullIndex)
                    this.m_broadPhase.bufferMove(s.proxyKey);
                shapeIdx = s.nextShapeId;
            }
        }
        this.wakeJointBodies(idx);
        return true;
    }

    public b8 setJointUserData(in JointId jointId, in u64 userData){
        if(!this.isValidJoint(jointId))
            return false;
        this.m_joints[jointId.index].userData = userData;
        return true;
    }

    public b8 setJointEnabled(in JointId jointId, in b8 enabled){
        if(!this.isValidJoint(jointId))
            return false;
        const u32 idx = jointId.index;
        if(this.m_joints[idx].enabled() == enabled)
            return true;
        this.m_joints[idx].setFlag(JointFlags::Enabled, enabled);
        const u32 bodyIdA = this.m_joints[idx].edges[0u].bodyId;
        const u32 bodyIdB = this.m_joints[idx].edges[1u].bodyId;
        if(!enabled){
            this.resetJointWarmStartAndWake(idx);
            if(this.m_joints[idx].islandId != s_NullIndex)
                UnlinkJointFromIsland(this.m_islands, this.m_solverSets, this.m_joints, idx);
        }
        else{
            if(
                this.m_joints[idx].islandId == s_NullIndex
                && this.m_bodies[bodyIdA].setIndex != s_DisabledSetIndex
                && this.m_bodies[bodyIdB].setIndex != s_DisabledSetIndex
            ){
                LinkJointToIslandWithGraph(
                    this.m_graph,
                    this.m_bodies,
                    this.m_islands,
                    this.m_freeIslandIds,
                    this.m_solverSets,
                    this.m_freeSolverSetIds,
                    this.m_contacts,
                    this.m_joints,
                    idx
                );
            }
            this.wakeJointBodies(idx);
        }
        if(!this.m_joints[idx].collideConnected()){
            ++this.m_nonCollideJointVersion;
            this.wakeJointCollisionPeersInternal(bodyIdA, bodyIdB, !enabled);
        }
        ++this.m_jointTopologyVersion;
        return true;
    }

