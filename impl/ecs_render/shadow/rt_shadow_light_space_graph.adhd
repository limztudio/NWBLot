#include <impl/ecs_render/shadow/task_graph_light_space_shadow.adhd>
#include <impl/ecs_render/kernel/task_graph_resource_descs.adhd>
#include <impl/ecs_render/kernel/task_timing_telemetry_labels.adhd>
#include <impl/ecs_render/kernel/timing_names.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const usize s_LightSpaceDiagnosticResourceUseCount = 2u;
const usize s_LightSpaceMeshletCasterBufferPairCount = 2u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class LightSpaceViewTask{
    private mut GraphicsRuntime m_graphics;
    private in b8 m_shadowPrepared;
    private FrozenLightSpaceShadowHandle m_snapshot;

    public LightSpaceViewTask(in LightSpaceShadowGraphInputs inputs){
        this.m_graphics = inputs.graphics;
        this.m_shadowPrepared = inputs.shadowPrepared;
        this.m_snapshot = inputs.snapshot;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }

    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(context.commandIrCapture)
            return false;
        if(!this.m_shadowPrepared)
            return true;
        if(!this.m_snapshot.valid())
            return false;
        GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeLightSpaceShadowViews, this.m_graphics.getDevice(), commandList);

        return LightSpaceShadowRecorder().views(this.m_snapshot.deref().snapshot, commandList, this.m_graphics.getDevice().getDescriptorHeap());
    }
}

class LightSpaceShadeTask{
    private mut GraphicsRuntime m_graphics;
    private in b8 m_shadowPrepared;
    private FrozenLightSpaceShadowHandle m_snapshot;

    public LightSpaceShadeTask(in LightSpaceShadowGraphInputs inputs){
        this.m_graphics = inputs.graphics;
        this.m_shadowPrepared = inputs.shadowPrepared;
        this.m_snapshot = inputs.snapshot;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }

    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(context.commandIrCapture)
            return false;
        if(!this.m_shadowPrepared)
            return true;
        if(!this.m_snapshot.valid())
            return false;
        GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeLightSpaceShadowShade, this.m_graphics.getDevice(), commandList);

        in LightSpaceShadowSnapshot snap = this.m_snapshot.deref().snapshot;
        if(!LightSpaceShadowRecorder().shade(snap, commandList, this.m_graphics.getDevice().getDescriptorHeap()))
            return false;
        if(snap.captureHistory.has_value())
            snap.captureHistory.value().recordCapture(snap.captureTicket);
        return true;
    }
}

class LightSpaceDiagnosticTask{
    private in b8 m_shadowPrepared;
    private BufferHandle m_sourceBuffer;
    private BufferHandle m_readback;
    private mut LightSpaceShadowDiagnostics m_diagnostics;
    private u32 m_frameIndex;

    public LightSpaceDiagnosticTask(in LightSpaceShadowGraphInputs inputs){
        this.m_shadowPrepared = inputs.shadowPrepared;
        this.m_sourceBuffer = inputs.snapshot.deref().snapshot.csgContext;
        this.m_readback = inputs.snapshot.deref().snapshot.diagnosticReadback;
        this.m_diagnostics = inputs.snapshot.deref().snapshot.diagnostics.value();
        this.m_frameIndex = inputs.snapshot.deref().snapshot.diagnosticFrame;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute | GpuQueueCapability::Transfer); }

    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(context.commandIrCapture)
            return false;
        if(!this.m_shadowPrepared)
            return true;
        commandList.setBufferState(this.m_sourceBuffer.deref(), ResourceStates::CopySource);
        commandList.commitBarriers();
        commandList.copyBuffer(this.m_readback.deref(), 0u, this.m_sourceBuffer.deref(), s_CsgShadowRayFailureOffset, sizeof(u32));
        commandList.setBufferState(this.m_sourceBuffer.deref(), ResourceStates::UnorderedAccess);
        commandList.commitBarriers();
        return true;
    }

    public void accepted(in QueueSubmissionToken token){
        if(this.m_shadowPrepared && this.m_diagnostics.readback == this.m_readback){
            this.m_diagnostics.submission = token;
            this.m_diagnostics.acceptedFrame = this.m_frameIndex;
        }
    }
}

class LightSpaceCullTask{
    private mut GraphicsRuntime m_graphics;
    private in b8 m_shadowPrepared;
    private FrozenLightSpaceShadowHandle m_snapshot;

    public LightSpaceCullTask(in LightSpaceShadowGraphInputs inputs){
        this.m_graphics = inputs.graphics;
        this.m_shadowPrepared = inputs.shadowPrepared;
        this.m_snapshot = inputs.snapshot;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }

    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(context.commandIrCapture)
            return false;
        if(!this.m_shadowPrepared)
            return true;
        if(!this.m_snapshot.valid())
            return false;
        GpuTimingMeasure timing(this.m_graphics.gpuTiming(), s_TimingScopeLightSpaceShadowCull, this.m_graphics.getDevice(), commandList);

        return LightSpaceShadowRecorder().cull(this.m_snapshot.deref().snapshot, commandList, this.m_graphics.getDevice().getDescriptorHeap());
    }
}

class LightSpaceCaptureTask{
    private mut GraphicsRuntime m_graphics;
    private in b8 m_shadowPrepared;
    private FrozenLightSpaceShadowHandle m_snapshot;
    private b8 m_transparent;

    public LightSpaceCaptureTask(in LightSpaceShadowGraphInputs inputs, in b8 transparent){
        this.m_graphics = inputs.graphics;
        this.m_shadowPrepared = inputs.shadowPrepared;
        this.m_snapshot = inputs.snapshot;
        this.m_transparent = transparent;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Graphics); }

    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(context.commandIrCapture)
            return false;
        if(!this.m_shadowPrepared)
            return true;
        if(!this.m_snapshot.valid())
            return false;
        const GpuTimingScopeDefinition scope = LightSpaceCaptureTimingScope(this.m_transparent);
        GpuTimingMeasure timing(this.m_graphics.gpuTiming(), scope, this.m_graphics.getDevice(), commandList);

        return LightSpaceShadowRecorder().captureAllViews(this.m_snapshot.deref().snapshot, this.m_transparent, commandList, this.m_graphics.getDevice().getDescriptorHeap());
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


usize ResolveLightSpaceCsgContextUploadPrefixBytes(in b8 initialize, in usize totalContextBytes, in usize rayFailureOffset){
    if(initialize)
        return totalContextBytes;
    return rayFailureOffset;
}

usize ResolveLightSpaceCaptureReadReserveCount(in usize sceneReadCount, in usize casterCount, in usize setMemberCount){
    return sceneReadCount + casterCount + setMemberCount + s_LightSpaceFixedResourceUseCount;
}

b8 CanDeclareLightSpaceShadowDiagnostics(in b8 snapshotReady, in b8 hasDiagnostics, in b8 hasDiagnosticReadback, in b8 dependencyValid, in b8 contextValid){
    return snapshotReady && hasDiagnostics && hasDiagnosticReadback && dependencyValid && contextValid;
}

b8 CanDeclareLightSpaceShadowMaps(in b8 snapshotReady, in b8 dependencyValid, in b8 castersEmpty){
    return snapshotReady && dependencyValid && !castersEmpty;
}

void AppendLightSpaceSceneReadIndexed(mut Vector<GpuTaskResourceUse> outUses, mut HashMap<u32, usize> resourceIndices, in GpuTaskResourceUse use){
    assert(use.access == GpuTaskResourceAccess::Read);
    assert(use.range.bufferRange == s_EntireBuffer && use.range.textureSubresources == s_AllSubresources);
    if(resourceIndices.contains(use.resource.index)){
        const usize existingIndex = resourceIndices.at(use.resource.index);
        assert(outUses[existingIndex].resource == use.resource);
        mut GpuTaskResourceUse previous = outUses[existingIndex];
        previous.requiredState |= use.requiredState;
        previous.hasIndependentStateSource = previous.hasIndependentStateSource && use.hasIndependentStateSource;
        return;
    }
    resourceIndices.try_emplace(use.resource.index, outUses.size());
    outUses.push_back(use);
}

b8 GatherCaptureReads(in GpuTaskGraph graph, in LightSpaceShadowGraphInputs inputs, mut Vector<GpuTaskResourceUse> outUses){
    if(!inputs.snapshot.valid())
        return false;
    in LightSpaceShadowSnapshot snapshot = inputs.snapshot.deref().snapshot;
    GpuTaskGraphDeclarationReadView declarations(graph);
    if(!declarations.valid())
        return false;
    usize setMemberCount = 0u;
    for(in GpuTaskResourceSetUse use : inputs.sceneReadSets){
        if(!declarations.validResourceSet(use.resourceSet))
            return false;
        setMemberCount += declarations.resourceSetAt(use.resourceSet.index).memberCount;
    }
    const usize capacity = ResolveLightSpaceCaptureReadReserveCount(inputs.sceneReads.size(), snapshot.casters.size(), setMemberCount);
    outUses.clear();
    outUses.reserve(capacity);
    HashMap<u32, usize> resourceIndices;
    resourceIndices.reserve(capacity);
    for(in GpuTaskResourceUse use : inputs.sceneReads)
        AppendLightSpaceSceneReadIndexed(outUses, resourceIndices, use);
    for(in GpuTaskResourceSetUse use : inputs.sceneReadSets){
        const GpuTaskGraphResourceSetView members = declarations.resourceSetAt(use.resourceSet.index);
        for(in GpuGraphResourceId member : members.memberSpan()){
            GpuTaskResourceUse read;
            read.resource = member;
            read.range = use.range;
            read.requiredState = use.requiredState;
            read.access = use.access;
            read.hasIndependentStateSource = use.hasIndependentStateSource;
            AppendLightSpaceSceneReadIndexed(outUses, resourceIndices, read);
        }
    }
    for(in LightSpaceShadowCaster caster : snapshot.casters){
        const GpuGraphResourceId resource = declarations.findImportedBuffer(caster.triangleIndexBuffer);
        if(!resource.valid())
            return false;
        AppendLightSpaceSceneReadIndexed(outUses, resourceIndices, ReadUse(resource, ResourceStates::ShaderResource | ResourceStates::IndexBuffer));
    }
    return true;
}

GpuTimingScopeDefinition LightSpaceCaptureTimingScope(in b8 transparent){
    if(transparent)
        return s_TimingScopeLightSpaceShadowTransparentCapture;
    return s_TimingScopeLightSpaceShadowOpaqueCapture;
}

Expected<GpuTaskId> DeclareLightSpaceShadowDiagnostics(in LightSpaceShadowGraphInputs inputs, in GpuGraphResourceId context, mut GpuTaskGraph graph){
    if(!inputs.snapshot.valid())
        return MakeUnexpected(Failure());
    in LightSpaceShadowSnapshot snapshot = inputs.snapshot.deref().snapshot;
    if(!CanDeclareLightSpaceShadowDiagnostics(snapshot.ready, snapshot.diagnostics.has_value(), snapshot.diagnosticReadback.valid(), inputs.dependency.valid(), context.valid()))
        return MakeUnexpected(Failure());
    GpuGraphResourceDesc readbackDesc = BufferResourceDesc(s_LightSpaceDiagnosticsIdentity, s_LightSpaceDiagnosticsLabel);
    readbackDesc.setInitialState(ResourceStates::CopyDest).setExternalFinalState(ResourceStates::CopyDest);
    const auto readbackResult = graph.importBuffer(
        snapshot.diagnosticReadback, readbackDesc
    );
    if(!readbackResult.has_value())
        return MakeUnexpected(Failure());
    const GpuGraphResourceId readback = readbackResult.value();
    const Array<GpuTaskResourceUse, s_LightSpaceDiagnosticResourceUseCount> uses( ReadWriteUse(context, ResourceStates::UnorderedAccess), WriteUse(readback, ResourceStates::CopyDest));
    GpuTaskSchedulingHint scheduling;
    scheduling.cost = GpuTaskCostHint::Tiny;
    scheduling.allowPacketMerge = true;
    scheduling.mergeWithPrevious = true;
    scheduling.allowMergeAcrossConsumerFrontier = true;
    ConfigureComputeEffectRoutingHint(true, scheduling);
    GpuTaskDesc desc;
    desc
        .setIdentity(s_LightSpaceDiagnosticsIdentity)
        .setMarkerLabel(s_LightSpaceDiagnosticsLabel)
        .setScheduling(scheduling).setDependency(inputs.dependency)
        .setExternalStateSources(inputs.stateSources)
        .setResourceUses(uses)
    ;
    return graph.addPayloadTask(desc, LightSpaceDiagnosticTask(inputs));
}

Expected<LightSpaceShadowGraph> DeclareLightSpaceShadowMaps(in LightSpaceShadowGraphInputs inputs, mut GpuTaskGraph graph){
    if(!inputs.snapshot.valid())
        return MakeUnexpected(Failure());
    in LightSpaceShadowSnapshot snapshot = inputs.snapshot.deref().snapshot;
    if(!CanDeclareLightSpaceShadowMaps(snapshot.ready, inputs.dependency.valid(), snapshot.casters.empty()))
        return MakeUnexpected(Failure());
    LightSpaceShadowGraph result;
    const auto countsResult = ImportExternalBuffer(graph, snapshot.counts, Name(s_LightSpaceGraphCounts), "Light-Space Crossing Counts", ResourceStates::Common, ResourceStates::Common);
    const auto eventsResult = ImportExternalBuffer(graph, snapshot.events, Name(s_LightSpaceGraphEvents), "Light-Space Crossings", ResourceStates::Common, ResourceStates::Common);
    const auto viewsResult = ImportExternalBuffer(graph, snapshot.views, Name(s_LightSpaceGraphViews), "Light-Space Views", ResourceStates::Common, ResourceStates::Common);
    const auto depthResult = ImportExternalTexture(graph, snapshot.depth, s_LightSpaceGraphDepth, "Light-Space Opaque Depth", ResourceStates::Unknown, ResourceStates::Common);
    if(!countsResult.has_value() || !eventsResult.has_value() || !viewsResult.has_value() || !depthResult.has_value())
        return MakeUnexpected(Failure());
    result.counts = countsResult.value();
    result.events = eventsResult.value();
    result.views = viewsResult.value();
    result.depth = depthResult.value();
    const b8 csg = (snapshot.push.csgFlags & s_CsgShadowFlagEnabled) != 0u;
    if(csg){
        const auto csgContextResult = ImportExternalBuffer(graph, snapshot.csgContext, Name(s_LightSpaceGraphCsgContext), "CSG Shadow Context", ResourceStates::Common, ResourceStates::Common);
        const auto csgOpaqueDepthResult = ImportExternalBuffer(graph, snapshot.csgOpaqueDepth, Name(s_LightSpaceGraphCsgDepth), "CSG Shadow Depth", ResourceStates::Common, ResourceStates::Common);
        if(!csgContextResult.has_value() || !csgOpaqueDepthResult.has_value())
            return MakeUnexpected(Failure());
        result.csgContext = csgContextResult.value();
        result.csgOpaqueDepth = csgOpaqueDepthResult.value();
    }
    if(snapshot.captureTicket.reuse){
        result.ready = inputs.dependency;
        return result;
    }
    const auto drawArgumentsResult = ImportExternalBuffer(graph, snapshot.drawArguments, Name(s_LightSpaceGraphDrawArguments), "Light-Space Draw Arguments", ResourceStates::Common, ResourceStates::Common);
    if(!drawArgumentsResult.has_value())
        return MakeUnexpected(Failure());
    result.drawArguments = drawArgumentsResult.value();
    const auto uploadResult = graph.copyUploadBytes<u32>(PodArrayBytes<LightSpaceViewGpu>(Span<LightSpaceViewGpu>(snapshot.plan.views).subspan(0u, snapshot.plan.viewCount)));
    if(!uploadResult.has_value())
        return MakeUnexpected(Failure());
    const GpuUploadBlobId upload = uploadResult.value();
    GpuTaskSchedulingHint scheduling;
    scheduling.cost = GpuTaskCostHint::Tiny;
    scheduling.allowPacketMerge = true;
    scheduling.mergeWithPrevious = true;
    scheduling.allowMergeAcrossConsumerFrontier = true;
    GpuTaskDesc uploadDesc;
    uploadDesc.setIdentity(s_LightSpaceViewUploadIdentity)
        .setMarkerLabel(s_LightSpaceViewUploadLabel)
        .setScheduling(scheduling)
        .setDependency(inputs.dependency)
        .setExternalStateSources(inputs.stateSources);
    GpuTaskId csgUpload;
    if(csg){
        if(!snapshot.diagnostics.has_value() || snapshot.csgContextBytes.size() < s_ShaderCsgRayContextBytes)
            return MakeUnexpected(Failure());
        const b8 initialize = !snapshot.diagnostics.value().contextInitialized.valid();
        const usize prefixBytes = ResolveLightSpaceCsgContextUploadPrefixBytes(initialize, snapshot.csgContextBytes.size(), s_CsgShadowRayFailureOffset);
        const auto csgBytesResult = graph.copyUploadBytes<u32>(snapshot.csgContextBytes.subspan(0u, prefixBytes));
        if(!csgBytesResult.has_value())
            return MakeUnexpected(Failure());
        const GpuUploadBlobId csgBytes = csgBytesResult.value();
        uploadDesc.setIdentity(Name(s_LightSpaceGraphCsgUpload)).setMarkerLabel("CSG Shadow Context Upload");
        GpuUploadBufferTaskDesc csgUploadResultDesc;
        csgUploadResultDesc.source = csgBytes;
        csgUploadResultDesc.destination = result.csgContext;
        csgUploadResultDesc.finalState = ResourceStates::Common;
        if(initialize)
            csgUploadResultDesc.publishAcceptedToken(snapshot.diagnostics.value().contextInitialized);
        const auto csgUploadResult = graph.addUploadBufferTask(uploadDesc, csgUploadResultDesc);
        if(!csgUploadResult.has_value())
            return MakeUnexpected(Failure());
        csgUpload = csgUploadResult.value();
        if(!initialize){
            const u32 payloadOffset = s_CsgShadowRayFailureOffset + sizeof(u32);
            const auto payloadResult = graph.copyUploadBytes<u32>(snapshot.csgContextBytes.subspan(payloadOffset));
            if(!payloadResult.has_value())
                return MakeUnexpected(Failure());
            const GpuUploadBlobId payload = payloadResult.value();
            uploadDesc.setIdentity(Name(s_LightSpaceGraphCsgPayloadUpload)).setMarkerLabel("CSG Shadow Payload Upload").setDependency(csgUpload);
            GpuUploadBufferTaskDesc csgUploadResult2Desc;
            csgUploadResult2Desc.source = payload;
            csgUploadResult2Desc.destination = result.csgContext;
            csgUploadResult2Desc.destinationOffsetBytes = payloadOffset;
            csgUploadResult2Desc.finalState = ResourceStates::Common;
            const auto csgUploadResult2 = graph.addUploadBufferTask(uploadDesc, csgUploadResult2Desc);
            if(!csgUploadResult2.has_value())
                return MakeUnexpected(Failure());
            csgUpload = csgUploadResult2.value();
        }
        uploadDesc.setIdentity(s_LightSpaceViewUploadIdentity).setMarkerLabel(s_LightSpaceViewUploadLabel).setDependency(csgUpload);
    }
    GpuUploadBufferTaskDesc viewUploadResultDesc;
    viewUploadResultDesc.source = upload;
    viewUploadResultDesc.destination = result.views;
    viewUploadResultDesc.finalState = ResourceStates::Common;
    const auto viewUploadResult = graph.addUploadBufferTask(uploadDesc, viewUploadResultDesc);
    if(!viewUploadResult.has_value()){
        result.viewUpload = GpuTaskId();
        return MakeUnexpected(Failure());
    }
    result.viewUpload = viewUploadResult.value();
    GpuTaskSchedulingHint clearScheduling = scheduling;
    clearScheduling.allowParallelRecording = true;
    GpuTaskDesc clearDesc;
    clearDesc.setIdentity(Name(s_LightSpaceGraphCountsClear))
        .setMarkerLabel("Light-Space Crossing Clear")
        .setScheduling(clearScheduling)
        .setDependency(result.viewUpload)
        .setExternalStateSources(inputs.stateSources);
    GpuClearBufferTaskDesc countsClearResultDesc;
    countsClearResultDesc.destination = result.counts;
    countsClearResultDesc.clearValue = 0u;
    const auto countsClearResult = graph.addClearBufferTask(clearDesc, countsClearResultDesc);
    if(!countsClearResult.has_value()){
        result.countsClear = GpuTaskId();
        return MakeUnexpected(Failure());
    }
    result.countsClear = countsClearResult.value();

    Vector<GpuTaskResourceUse> uses;
    uses.reserve(inputs.sceneReads.size() + s_LightSpaceFixedResourceUseCount);
    for(in GpuTaskResourceUse use : inputs.sceneReads)
        uses.push_back(use);
    if(csg)
        uses.push_back(ReadUse(result.csgContext, ResourceStates::ShaderResource));
    uses.push_back(ReadWriteUse(result.views, ResourceStates::UnorderedAccess));
    GpuTaskDesc viewDesc;
    viewDesc
        .setIdentity(Name(s_LightSpaceGraphViewFit))
        .setMarkerLabel("Light-Space View Fit")
        .setScheduling(scheduling)
        .setDependency(result.countsClear)
        .setExternalStateSources(inputs.stateSources)
        .setResourceUses(uses)
        .setResourceSetUses(inputs.sceneReadSets)
    ;
    const auto viewFitResult = graph.addPayloadTask(viewDesc, LightSpaceViewTask(inputs));
    if(!viewFitResult.has_value()){
        result.viewFit = GpuTaskId();
        return MakeUnexpected(Failure());
    }
    result.viewFit = viewFitResult.value();

    uses.pop_back();
    uses.reserve(uses.size() + 2u + snapshot.casters.size() * s_LightSpaceMeshletCasterBufferPairCount);
    uses.push_back(ReadUse(result.views, ResourceStates::ShaderResource));
    uses.push_back(WriteUse(result.drawArguments, ResourceStates::UnorderedAccess));
    HashSet<u32> seenResources;
    for(in GpuTaskResourceUse use : uses)
        seenResources.insert(use.resource.index);
    for(in LightSpaceShadowCaster caster : snapshot.casters){
        if(caster.meshletCount == 0u)
            continue;
        if(!caster.meshletDescBuffer.valid() || !caster.meshletBoundsBuffer.valid())
            return MakeUnexpected(Failure());
    }
    Vector<BufferHandle> missingMeshletBuffers;
    HashSet<usize> seenMissingBufferIdentities;
    {
        const GpuTaskGraphDeclarationReadView declarations(graph);
        if(!declarations.valid())
            return MakeUnexpected(Failure());
        for(in LightSpaceShadowCaster caster : snapshot.casters){
            if(caster.meshletCount == 0u)
                continue;
            const Array<BufferHandle, s_LightSpaceMeshletCasterBufferPairCount> buffers(caster.meshletDescBuffer, caster.meshletBoundsBuffer);
            for(in BufferHandle buffer : buffers){
                const GpuGraphResourceId resource = declarations.findImportedBuffer(buffer);
                if(resource.valid()){
                    if(seenResources.insert(resource.index).second)
                        uses.push_back(ReadUse(resource, ResourceStates::ShaderResource));
                }
                else if(seenMissingBufferIdentities.insert(buffer.identity()).second)
                    missingMeshletBuffers.push_back(buffer);
            }
        }
    }
    for(in BufferHandle buffer : missingMeshletBuffers){
        const auto importedResource = ImportExternalBuffer(graph, buffer, buffer.deref().getCreationDescription().debugName, "Light-Space Meshlet Bounds", ResourceStates::Common, ResourceStates::Common);
        if(!importedResource.has_value() || !importedResource.value().valid())
            return MakeUnexpected(Failure());
        if(seenResources.insert(importedResource.value().index).second)
            uses.push_back(ReadUse(importedResource.value(), ResourceStates::ShaderResource));
    }
    GpuTaskDesc cullDesc;
    cullDesc
        .setIdentity(Name(s_LightSpaceGraphDrawCull))
        .setMarkerLabel("Light-Space Meshlet Cull")
        .setScheduling(scheduling)
        .setDependency(result.viewFit)
        .setExternalStateSources(inputs.stateSources)
        .setResourceUses(uses)
        .setResourceSetUses(inputs.sceneReadSets)
    ;
    const auto drawCullResult = graph.addPayloadTask(cullDesc, LightSpaceCullTask(inputs));
    if(!drawCullResult.has_value()){
        result.drawCull = GpuTaskId();
        return MakeUnexpected(Failure());
    }
    result.drawCull = drawCullResult.value();

    const TextureSubresourceSet layers(0u, 1u, 0u, snapshot.plan.viewCount);
    if(!GatherCaptureReads(graph, inputs, uses))
        return MakeUnexpected(Failure());
    if(csg)
        uses.push_back(ReadUse(result.csgContext, ResourceStates::ShaderResource));
    uses.push_back(ReadUse(result.views, ResourceStates::ShaderResource));
    uses.push_back(ReadUse(result.drawArguments, ResourceStates::IndirectArgument));
    uses.push_back(WriteTextureUse(result.depth, layers, ResourceStates::DepthWrite));
    scheduling.cost = GpuTaskCostHint::Large;
    GpuTaskDesc opaqueDesc;
    opaqueDesc
        .setIdentity(Name(s_LightSpaceGraphOpaqueCapture))
        .setMarkerLabel("Light-Space Opaque Capture")
        .setScheduling(scheduling)
        .setDependency(result.drawCull)
        .setExternalStateSources(inputs.stateSources)
        .setResourceUses(uses)
    ;
    const auto opaqueCaptureResult = graph.addPayloadTask(opaqueDesc, LightSpaceCaptureTask(inputs, false));
    if(!opaqueCaptureResult.has_value()){
        result.opaqueCapture = GpuTaskId();
        return MakeUnexpected(Failure());
    }
    result.opaqueCapture = opaqueCaptureResult.value();

    uses.pop_back();
    uses.push_back(ReadTextureUse(result.depth, layers, ResourceStates::DepthRead));
    uses.push_back(ReadWriteUse(result.counts, ResourceStates::UnorderedAccess));
    uses.push_back(WriteUse(result.events, ResourceStates::UnorderedAccess));
    GpuTaskDesc transparentDesc;
    transparentDesc
        .setIdentity(Name(s_LightSpaceGraphTransparentCapture))
        .setMarkerLabel("Light-Space Transparent Capture")
        .setScheduling(scheduling)
        .setDependency(result.opaqueCapture)
        .setExternalStateSources(inputs.stateSources)
        .setResourceUses(uses)
    ;
    const auto transparentCaptureResult = graph.addPayloadTask(transparentDesc, LightSpaceCaptureTask(inputs, true));
    if(!transparentCaptureResult.has_value()){
        result.transparentCapture = GpuTaskId();
        return MakeUnexpected(Failure());
    }
    result.transparentCapture = transparentCaptureResult.value();

    uses.clear();
    for(in GpuTaskResourceUse use : inputs.sceneReads)
        uses.push_back(use);
    if(csg)
        uses.push_back(ReadUse(result.csgContext, ResourceStates::ShaderResource));
    uses.push_back(ReadUse(result.views, ResourceStates::ShaderResource));
    if(csg)
        uses.push_back(ReadWriteUse(result.counts, ResourceStates::UnorderedAccess));
    else
        uses.push_back(ReadUse(result.counts, ResourceStates::ShaderResource));
    if(csg)
        uses.push_back(WriteUse(result.csgOpaqueDepth, ResourceStates::UnorderedAccess));
    uses.push_back(ReadWriteUse(result.events, ResourceStates::UnorderedAccess));
    GpuTaskDesc shadeDesc;
    shadeDesc
        .setIdentity(Name(s_LightSpaceGraphShade))
        .setMarkerLabel("Light-Space Crossing Shade")
        .setScheduling(scheduling)
        .setDependency(result.transparentCapture)
        .setExternalStateSources(inputs.stateSources)
        .setResourceUses(uses)
        .setResourceSetUses(inputs.sceneReadSets)
    ;
    const auto shadeResult = graph.addPayloadTask(shadeDesc, LightSpaceShadeTask(inputs));
    if(!shadeResult.has_value())
        return MakeUnexpected(shadeResult.error());
    result.shade = shadeResult.value();
    result.ready = result.shade;
    if(!result.valid())
        return MakeUnexpected(Failure());
    return result;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

