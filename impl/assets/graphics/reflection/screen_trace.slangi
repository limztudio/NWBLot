////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_REFLECTION_SCREEN_TRACE_SLANGI
#define NWB_GRAPHICS_REFLECTION_SCREEN_TRACE_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "common.slangi"
#include "depth_constants.h"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static const uint NWB_REFLECTION_SCREEN_MAXIMUM_STEPS = 256u;
static const float NWB_REFLECTION_SCREEN_DEPTH_ROUNDOFF = 0.0000002384185791015625;
static const float NWB_REFLECTION_SCREEN_DIRECTION_EPSILON = 1e-20;
static const float NWB_REFLECTION_SCREEN_EXIT_FAR = 1e30;
static const float NWB_REFLECTION_SCREEN_NEAR_CLIP_W_MARGIN = 1e-5;
static const float NWB_REFLECTION_SCREEN_MIN_PROJECTED_LENGTH = 2.0;
static const float NWB_REFLECTION_SCREEN_PARAMETER_EPSILON_MIN = 0.0000002;
static const float NWB_REFLECTION_SCREEN_PARAMETER_EPSILON_PIXEL_FRACTION = 0.002;
static const int NWB_REFLECTION_SCREEN_SELF_PIXEL_RADIUS = 2;
static const float NWB_REFLECTION_SCREEN_INCIDENCE_MIN = 0.02;
static const float NWB_REFLECTION_SCREEN_INCIDENCE_FULL = 0.2;
static const float NWB_REFLECTION_SCREEN_POSITION_ERROR_MIN = 0.00001;
static const float NWB_REFLECTION_SCREEN_PROJECTION_SCALE_MIN = 0.00001;
static const float NWB_REFLECTION_SCREEN_CLIP_ROUNDOFF_SCALE = 0.0000002;
static const float NWB_REFLECTION_SCREEN_OBSERVER_COSINE_MIN = 0.1;
static const half NWB_REFLECTION_SCREEN_SPECULAR_STRENGTH_SCALE = 8.0h;
static const half NWB_REFLECTION_SCREEN_ALIGNMENT_SMOOTH = 0.995h;
static const half NWB_REFLECTION_SCREEN_ALIGNMENT_ROUGH = 0.5h;
static const float NWB_REFLECTION_SCREEN_ALIGNMENT_FADE_WIDTH = 0.1;
static const half NWB_REFLECTION_SCREEN_BACKFACE_CONFIDENCE_CAP = 0.5h;

struct NwbReflectionScreenRay{
    float3 worldOrigin;
    float3 screenOrigin;
    float3 screenDirection;
    float parameterEpsilon;
    float2 invScreenDirection;
    float2 negOriginInvDir;
    float2 stepEdgeOffset;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


bool nwbReflectionClipScreenHalfspace(const float origin, const float direction, inout float first, inout float last){
    if(abs(direction) < NWB_REFLECTION_SCREEN_DIRECTION_EPSILON)
        return origin >= 0.0;
    const float crossing = -origin / direction;
    if(direction > 0.0)
        first = max(first, crossing);
    else
        last = min(last, crossing);
    return first <= last;
}

bool nwbReflectionBuildScreenRay(const NwbReflectionSurface surface, out NwbReflectionScreenRay ray){
    ray = (NwbReflectionScreenRay)0;
    ray.worldOrigin = surface.position + surface.normal * surface.bias;
    const float4 firstClip = mul(g_NwbReflectionView.worldToClip, float4(ray.worldOrigin, 1.0));
    const float4 lastClip = mul(g_NwbReflectionView.worldToClip, float4(ray.worldOrigin + surface.direction * g_NwbReflectionParameters.maxRayDistance, 1.0));
    if(!all(isfinite(firstClip)) || !all(isfinite(lastClip)))
        return false;

    const float4 delta = lastClip - firstClip;
    float first = surface.bias / g_NwbReflectionParameters.maxRayDistance;
    float last = 1.0;
    if(!nwbReflectionClipScreenHalfspace(firstClip.w - NWB_REFLECTION_SCREEN_NEAR_CLIP_W_MARGIN, delta.w, first, last)
        || !nwbReflectionClipScreenHalfspace(firstClip.x + firstClip.w, delta.x + delta.w, first, last)
        || !nwbReflectionClipScreenHalfspace(firstClip.w - firstClip.x, delta.w - delta.x, first, last)
        || !nwbReflectionClipScreenHalfspace(firstClip.y + firstClip.w, delta.y + delta.w, first, last)
        || !nwbReflectionClipScreenHalfspace(firstClip.w - firstClip.y, delta.w - delta.y, first, last)
        || !nwbReflectionClipScreenHalfspace(firstClip.z, delta.z, first, last)
        || !nwbReflectionClipScreenHalfspace(firstClip.w - firstClip.z, delta.w - delta.z, first, last)
    )
        return false;
    const float4 clippedFirst = firstClip + delta * first;
    const float4 clippedLast = firstClip + delta * last;
    if(first >= last || clippedFirst.w <= 0.0 || clippedLast.w <= 0.0)
        return false;
    const float3 firstNdc = clippedFirst.xyz / clippedFirst.w;
    const float3 lastNdc = clippedLast.xyz / clippedLast.w;
    ray.screenOrigin = float3(firstNdc.x * 0.5 + 0.5, 0.5 - firstNdc.y * 0.5, firstNdc.z);
    const float3 screenEnd = float3(lastNdc.x * 0.5 + 0.5, 0.5 - lastNdc.y * 0.5, lastNdc.z);
    ray.screenDirection = screenEnd - ray.screenOrigin;
    const float2 projectedExtent = abs(ray.screenDirection.xy) * float2(g_NwbReflectionParameters.dimensionsAndRoute.x, g_NwbReflectionParameters.dimensionsAndRoute.y);
    const float projectedLength = max(projectedExtent.x, projectedExtent.y);
    if(!all(isfinite(ray.screenOrigin)) || !all(isfinite(ray.screenDirection)) || projectedLength <= NWB_REFLECTION_SCREEN_MIN_PROJECTED_LENGTH)
        return false;
    ray.parameterEpsilon = max(NWB_REFLECTION_SCREEN_PARAMETER_EPSILON_MIN, NWB_REFLECTION_SCREEN_PARAMETER_EPSILON_PIXEL_FRACTION / projectedLength);
    const bool2 hasDirection = abs(ray.screenDirection.xy) > NWB_REFLECTION_SCREEN_DIRECTION_EPSILON;
    ray.invScreenDirection = float2(
        hasDirection.x ? (1.0 / ray.screenDirection.x) : 0.0,
        hasDirection.y ? (1.0 / ray.screenDirection.y) : 0.0
    );
    ray.negOriginInvDir = float2(
        hasDirection.x ? (-ray.screenOrigin.x * ray.invScreenDirection.x) : NWB_REFLECTION_SCREEN_EXIT_FAR,
        hasDirection.y ? (-ray.screenOrigin.y * ray.invScreenDirection.y) : NWB_REFLECTION_SCREEN_EXIT_FAR
    );
    ray.stepEdgeOffset = float2(
        ray.screenDirection.x > 0.0 ? 1.0 : 0.0,
        ray.screenDirection.y > 0.0 ? 1.0 : 0.0
    );
    return true;
}

float nwbReflectionScreenMipExit(const uint2 cell, const float2 mipInvDirStep, const float2 mipEdgeBias){
    const float2 exitXY = fma(float2(cell), mipInvDirStep, mipEdgeBias);
    return min(1.0, min(exitXY.x, exitXY.y));
}

void nwbReflectionSelectScreenMip(
    const uint mip,
    const uint2 fullDimensions,
    const NwbReflectionScreenRay ray,
    out float2 mipFloatDimensions,
    out uint2 mipMaxCell,
    out float2 mipInvDirStep,
    out float2 mipEdgeBias
){
    const uint2 mipDimensions = max(uint2(1u), fullDimensions >> mip);
    mipFloatDimensions = float2(mipDimensions);
    mipMaxCell = mipDimensions - 1u;
    mipInvDirStep = rcp(mipFloatDimensions) * ray.invScreenDirection;
    mipEdgeBias = fma(ray.stepEdgeOffset, mipInvDirStep, ray.negOriginInvDir);
}

bool nwbReflectionTestScreenHitCell(
    const uint2 candidatePixel,
    const NwbReflectionSurface surface,
    const NwbReflectionScreenRay ray,
    const float intervalFirst,
    const float intervalLast,
    const float2 floatDimensions,
    out float outDepth,
    out float3 outPosition,
    out float3 outNormal,
    out float outIncidence,
    out float outDistance,
    out float3 outIntersection,
    out float2 outUv
){
    outDepth = 1.0;
    outPosition = float3(0.0);
    outNormal = float3(0.0);
    outIncidence = 0.0;
    outDistance = 0.0;
    outIntersection = float3(0.0);
    outUv = float2(0.0);
    const int3 texel = int3(candidatePixel, 0);
    outDepth = nwbHeapSampledImage2D(g_NwbReflectionResources.gbufferSlots.w).Load(texel).x;
    if(!isfinite(outDepth) || outDepth < 0.0 || outDepth >= 1.0)
        return false;
    outPosition = nwbHeapSampledImage2D(g_NwbReflectionResources.gbufferSlots.z).Load(texel).xyz;
    const float3 packedNormal = nwbHeapSampledImage2D(g_NwbReflectionResources.gbufferSlots.y).Load(texel).xyz;
    if(!all(isfinite(outPosition)) || !all(isfinite(packedNormal)))
        return false;
    outNormal = nwbSafeNormalize(packedNormal * 2.0 - 1.0, float3(0.0, 0.0, 1.0));
    outIncidence = dot(outNormal, surface.direction);
    if(abs(outIncidence) < NWB_REFLECTION_SCREEN_INCIDENCE_MIN)
        return false;

    outDistance = dot(outPosition - ray.worldOrigin, outNormal) / outIncidence;
    if(!isfinite(outDistance) || outDistance <= surface.bias || outDistance > g_NwbReflectionParameters.maxRayDistance)
        return false;
    outIntersection = ray.worldOrigin + surface.direction * outDistance;
    const float4 intersectionClip = mul(g_NwbReflectionView.worldToClip, float4(outIntersection, 1.0));
    if(!all(isfinite(intersectionClip)) || intersectionClip.w <= 0.0)
        return false;
    const float2 intersectionNdc = intersectionClip.xy / intersectionClip.w;
    outUv = float2(intersectionNdc.x * 0.5 + 0.5, 0.5 - intersectionNdc.y * 0.5);
    if(any(outUv < 0.0) || any(outUv >= 1.0))
        return false;
    if(any(uint2(outUv * floatDimensions) != candidatePixel))
        return false;
    const float parameter = abs(ray.screenDirection.x) >= abs(ray.screenDirection.y) ? (outUv.x - ray.screenOrigin.x) / ray.screenDirection.x : (outUv.y - ray.screenOrigin.y) / ray.screenDirection.y;
    if(parameter < intervalFirst - ray.parameterEpsilon || parameter > intervalLast + ray.parameterEpsilon)
        return false;
    return true;
}

bool nwbReflectionFinalizeScreenHit(
    const uint2 candidatePixel,
    const NwbReflectionSurface surface,
    const float depth,
    const float3 position,
    const float3 normal,
    const float incidence,
    const float distance,
    const float3 intersection,
    const float2 uv,
    const float2 floatDimensions,
    const float2 invDimensions,
    out half3 radiance,
    out half confidence
){
    radiance = half3(0.0h);
    confidence = half(0.0h);
    const int3 texel = int3(candidatePixel, 0);

    const float3 positionError = max(abs(position) * NWB_REFLECTION_POSITION_RELATIVE_ERROR, float3(NWB_REFLECTION_SCREEN_POSITION_ERROR_MIN));
    const float4 positionClip = mul(g_NwbReflectionView.worldToClip, float4(position, 1.0));
    const float4 clipError = float4(
        dot(abs(g_NwbReflectionView.worldToClip[0].xyz), positionError),
        dot(abs(g_NwbReflectionView.worldToClip[1].xyz), positionError),
        dot(abs(g_NwbReflectionView.worldToClip[2].xyz), positionError),
        dot(abs(g_NwbReflectionView.worldToClip[3].xyz), positionError)
    ) + abs(positionClip) * NWB_REFLECTION_SCREEN_CLIP_ROUNDOFF_SCALE;
    if(!all(isfinite(positionClip)) || positionClip.w <= clipError.w)
        return false;
    const float3 positionNdc = positionClip.xyz / positionClip.w;
    const float3 ndcError = (clipError.xyz + abs(positionNdc) * clipError.w) / (positionClip.w - clipError.w);
    const float2 positionUv = float2(positionNdc.x * 0.5 + 0.5, 0.5 - positionNdc.y * 0.5);
    const float2 sampleUv = (float2(candidatePixel) + 0.5) * invDimensions;
    if(any(abs(positionUv - sampleUv) * floatDimensions > 1.0 + ndcError.xy * floatDimensions * 0.5) || abs(positionNdc.z - depth) > ndcError.z + NWB_REFLECTION_SCREEN_DEPTH_ROUNDOFF)
        return false;

    const float3 cameraObserver = nwbSafeNormalize(g_NwbReflectionView.cameraPosition.xyz - position, normal);
    const float2 projectionScale = float2(length(g_NwbReflectionView.worldToClip[0].xyz), length(g_NwbReflectionView.worldToClip[1].xyz));
    const float pixelRadius = positionClip.w * length(invDimensions / max(projectionScale, float2(NWB_REFLECTION_SCREEN_PROJECTION_SCALE_MIN)));
    const float footprint = pixelRadius / max(abs(dot(normal, cameraObserver)), NWB_REFLECTION_SCREEN_OBSERVER_COSINE_MIN);
    const float residual = max(length(intersection - position) - footprint - length(positionError), 0.0);
    if(residual >= g_NwbReflectionParameters.screenThickness)
        return false;
    const half geometryConfidence = half(1.0h) - half(smoothstep(0.0, g_NwbReflectionParameters.screenThickness, residual));
    const float2 edgeDistance = min(uv, 1.0 - uv);
    const half2 edgeWeight = g_NwbReflectionParameters.screenEdgeFade > 0.0 ? half2(smoothstep(float2(0.0), float2(g_NwbReflectionParameters.screenEdgeFade), edgeDistance)) : half2(1.0h);
    confidence = geometryConfidence * geometryConfidence * edgeWeight.x * edgeWeight.y;
    confidence *= half(smoothstep(NWB_REFLECTION_SCREEN_INCIDENCE_MIN, NWB_REFLECTION_SCREEN_INCIDENCE_FULL, abs(incidence)));

    const half4 specular = half4(nwbHeapSampledImage2D(g_NwbReflectionParameters.opaqueSpecularSlot).Load(texel));
    if(!all(isfinite(float4(specular))))
        return false;
    const half strength = saturate(max(specular.x, max(specular.y, specular.z)) * NWB_REFLECTION_SCREEN_SPECULAR_STRENGTH_SCALE);
    const float alignment = dot(cameraObserver, -surface.direction);
    const half requiredAlignment = lerp(NWB_REFLECTION_SCREEN_ALIGNMENT_SMOOTH, NWB_REFLECTION_SCREEN_ALIGNMENT_ROUGH, saturate(specular.w) * saturate(specular.w));
    confidence *= lerp(half(1.0h), half(smoothstep(float(requiredAlignment) - NWB_REFLECTION_SCREEN_ALIGNMENT_FADE_WIDTH, float(requiredAlignment), alignment)), strength);
    if(incidence > 0.0)
        confidence = min(confidence, half(NWB_REFLECTION_SCREEN_BACKFACE_CONFIDENCE_CAP));
    confidence *= half(1.0h) - half(smoothstep(g_NwbReflectionParameters.distanceFadeStart, g_NwbReflectionParameters.maxRayDistance, distance));
    radiance = half3(nwbHeapSampledImage2D(g_NwbReflectionResources.compositeSlots.x).Load(texel).rgb);
    if(!all(isfinite(float3(radiance))) || !isfinite(float(confidence)) || confidence <= half(0.0h))
        return false;
    radiance = max(radiance, half3(0.0h));
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


bool nwbReflectionTraceScreen(const uint2 pixel, const NwbReflectionSurface surface, out half3 radiance, out half confidence, out uint iterations, out bool limited){
    radiance = half3(0.0h);
    confidence = half(0.0h);
    iterations = 0u;
    limited = false;
    if(g_NwbReflectionParameters.depthMipCount == 0u || g_NwbReflectionParameters.screenMaxSteps == 0u)
        return false;
    NwbReflectionScreenRay ray;
    if(!nwbReflectionBuildScreenRay(surface, ray))
        return false;

    const uint2 fullDimensions = uint2(g_NwbReflectionParameters.dimensionsAndRoute.x, g_NwbReflectionParameters.dimensionsAndRoute.y);
    const float2 fullFloatDimensions = float2(fullDimensions);
    const float2 invFullDimensions = rcp(fullFloatDimensions);
    const uint lastMip = min(g_NwbReflectionParameters.depthMipCount, NWB_REFLECTION_MAX_DEPTH_MIPS) - 1u;
    const uint steps = min(g_NwbReflectionParameters.screenMaxSteps, NWB_REFLECTION_SCREEN_MAXIMUM_STEPS);
    float2 mipFloatDimensions = fullFloatDimensions;
    uint2 mipMaxCell = fullDimensions - 1u;
    float2 mipInvDirStep = invFullDimensions * ray.invScreenDirection;
    float2 mipEdgeBias = fma(ray.stepEdgeOffset, mipInvDirStep, ray.negOriginInvDir);
    const uint2 firstCell = min(uint2(saturate(ray.screenOrigin.xy) * fullFloatDimensions), mipMaxCell);
    float parameter = nwbReflectionScreenMipExit(firstCell, mipInvDirStep, mipEdgeBias) + ray.parameterEpsilon;
    uint mip = 0u;

    bool crossedSurface = false;
    uint2 hitCell = uint2(0u);
    float hitDepth = 1.0;
    float3 hitPosition = float3(0.0);
    float3 hitNormal = float3(0.0);
    float hitIncidence = 0.0;
    float hitDistance = 0.0;
    float3 hitIntersection = float3(0.0);
    float2 hitUv = float2(0.0);

    for(uint stepIndex = 0u; stepIndex < steps; ++stepIndex){
        if(!isfinite(parameter) || parameter >= 1.0)
            return false;
        const float3 position = ray.screenOrigin + ray.screenDirection * parameter;
        if(any(position.xy < 0.0) || any(position.xy >= 1.0))
            return false;
        const uint2 cell = min(uint2(position.xy * mipFloatDimensions), mipMaxCell);
        const float cellExit = nwbReflectionScreenMipExit(cell, mipInvDirStep, mipEdgeBias);
        if(!isfinite(cellExit) || cellExit <= parameter)
            return false;
        iterations = stepIndex + 1u;
        if(mip == 0u && all(abs(int2(cell) - int2(pixel)) < NWB_REFLECTION_SCREEN_SELF_PIXEL_RADIUS)){
            parameter = cellExit + ray.parameterEpsilon;
            const uint nextMip = min(1u, lastMip);
            if(nextMip != mip){
                mip = nextMip;
                nwbReflectionSelectScreenMip(mip, fullDimensions, ray, mipFloatDimensions, mipMaxCell, mipInvDirStep, mipEdgeBias);
            }
            continue;
        }
        const float2 depthInterval = nwbHeapSampledImage2D(g_NwbReflectionParameters.depthPyramidSlot).Load(int3(cell, mip)).xy;
        if(!all(isfinite(depthInterval)))
            return false;
        const float exitDepth = ray.screenOrigin.z + ray.screenDirection.z * cellExit;
        const bool empty = depthInterval.x >= 1.0 || max(position.z, exitDepth) < depthInterval.x - NWB_REFLECTION_SCREEN_DEPTH_ROUNDOFF || min(position.z, exitDepth) > depthInterval.y + NWB_REFLECTION_SCREEN_DEPTH_ROUNDOFF;
        if(empty){
            parameter = cellExit + ray.parameterEpsilon;
            const uint nextMip = min(mip + 1u, lastMip);
            if(nextMip != mip){
                mip = nextMip;
                nwbReflectionSelectScreenMip(mip, fullDimensions, ray, mipFloatDimensions, mipMaxCell, mipInvDirStep, mipEdgeBias);
            }
        }
        else if(mip > 0u){
            --mip;
            nwbReflectionSelectScreenMip(mip, fullDimensions, ray, mipFloatDimensions, mipMaxCell, mipInvDirStep, mipEdgeBias);
        }
        else{
            if(nwbReflectionTestScreenHitCell(cell, surface, ray, parameter, cellExit, fullFloatDimensions, hitDepth, hitPosition, hitNormal, hitIncidence, hitDistance, hitIntersection, hitUv)){
                crossedSurface = true;
                hitCell = cell;
                break;
            }
            parameter = cellExit + ray.parameterEpsilon;
            const uint nextMip = min(1u, lastMip);
            if(nextMip != mip){
                mip = nextMip;
                nwbReflectionSelectScreenMip(mip, fullDimensions, ray, mipFloatDimensions, mipMaxCell, mipInvDirStep, mipEdgeBias);
            }
        }
    }
    if(crossedSurface)
        return nwbReflectionFinalizeScreenHit(hitCell, surface, hitDepth, hitPosition, hitNormal, hitIncidence, hitDistance, hitIntersection, hitUv, fullFloatDimensions, invFullDimensions, radiance, confidence);
    const float3 remainingPosition = ray.screenOrigin + ray.screenDirection * parameter;
    limited = isfinite(parameter) && parameter < 1.0 && all(isfinite(remainingPosition)) && all(remainingPosition.xy >= 0.0) && all(remainingPosition.xy < 1.0);
    return false;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

