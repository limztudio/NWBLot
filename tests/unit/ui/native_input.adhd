#include <tests/common/gtest_macros.adhd>
#include <impl/ecs_ui/toolkit/context.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Optional<in HitTarget> FindHitTarget(in Span<HitTarget> targets, in WidgetId widget){
    for(in HitTarget target : targets){
        if(target.id == widget)
            return Optional<in HitTarget>(target);
    }
    return Optional<in HitTarget>();
}

[extensible]
class InputTestFixtureBase{
    private Optional<mut InputRouter> m_input;

    protected void bindRouter(mut InputRouter router){ this.m_input = Optional<mut InputRouter>(router); }
    public mut InputRouter inputRouter(){ return this.m_input.value(); }
    public in InputRouter inputRouter()const{ return this.m_input.value(); }
    public Optional<in HitTarget> target(in WidgetId widget)const{ return FindHitTarget(this.inputRouter().targets(), widget); }
    public b8 hasTarget(in WidgetId widget)const{ return this.target(widget).has_value(); }
    public Expected<HitTarget> tryTarget(in WidgetId widget)const{
        const auto found = this.target(widget);
        if(found.has_value())
            return found.value();
        return MakeUnexpected(Failure());
    }
    public InputRoutingResult send(in InputEvent event){ return SendUiNativeInput(this.inputRouter(), event); }
    public InputRoutingResult send(in PointerInput input){ return SendUiPointerInput(this.inputRouter(), input); }
    public void click(){ this.click(Point(15.0f, 15.0f)); }
    public void click(in Point position){ ClickUiInputRouter(this.inputRouter(), position); }
    public void key(in Key value){ this.key(value, false); }
    public void key(in Key value, in b8 shift){ SendUiKeyTap(this.inputRouter(), value, shift); }
}

[extensible]
class RouterTestFixture : InputTestFixtureBase{
    public InputRouter m_router;
    public RouterTestFixture(){ this.bindRouter(this.m_router); }
}

[extensible]
class ContextTestFixture : InputTestFixtureBase{
    public Context m_context;
    public ContextTestFixture(){ this.bindRouter(this.m_context.input()); }
    public Optional<WidgetState> findState(in WidgetId widget)const{
        const auto state = this.m_context.states().find(widget);
        if(state.has_value())
            return Optional<WidgetState>(state.value());
        return Optional<WidgetState>();
    }
}

InputEvent Pointer(in InputEventType type){ return Pointer(type, Point(15.0f, 15.0f)); }
PointerInput Pointer(in PointerPhase phase, in InputSource source){ return Pointer(phase, source, Point(20.0f, 20.0f)); }
PointerInput Pointer(in PointerPhase phase, in InputSource source, in Point position){ return Pointer(phase, source, position, false); }
PointerInput Pointer(in PointerPhase phase, in InputSource source, in Point position, in b8 hoverCapable){ return Pointer(phase, source, position, hoverCapable, PointerIntent::Activate); }
InputEvent Key(in InputEventType type, in Key key){ return Key(type, key, false, false); }
InputEvent Key(in InputEventType type, in Key key, in b8 repeat){ return Key(type, key, repeat, false); }
InputEvent Key(in Key key){ return Key(key, false, false, false, false); }
InputEvent Key(in Key key, in b8 shift){ return Key(key, shift, false, false, false); }
InputEvent Key(in Key key, in b8 shift, in b8 control){ return Key(key, shift, control, false, false); }
InputEvent Key(in Key key, in b8 shift, in b8 control, in b8 alt){ return Key(key, shift, control, alt, false); }


InputEvent NativeInput(in InputEvent event){
    InputEvent resolved = event;
    switch(event.type){
    case InputEventType::PointerMove:
    case InputEventType::PrimaryDown:
    case InputEventType::PrimaryUp:
    case InputEventType::SecondaryDown:
    case InputEventType::SecondaryUp:
    case InputEventType::PointerWheel:
    case InputEventType::PointerLeave:
    case InputEventType::PointerCaptureLost:
        resolved.source.device = 0u;
        resolved.source.control = 1u;
        resolved.hoverCapable = true;
        resolved.extend = event.shift;
        break;
    default:
        break;
    }
    return resolved;
}

InputEvent Pointer(in InputEventType type, in Point position){
    InputEvent event = InputEvent();
    event.type = type;
    event.position = position;
    return event;
}

PointerInput Pointer(in PointerPhase phase, in InputSource source, in Point position, in b8 hoverCapable, in PointerIntent intent){
    PointerInput input = PointerInput();
    input.source = source;
    input.phase = phase;
    input.intent = intent;
    input.position = position;
    input.hoverCapable = hoverCapable;
    return input;
}

InputEvent Key(in InputEventType type, in Key key, in b8 repeat, in b8 shift){
    InputEvent event = InputEvent();
    event.type = type;
    event.key = key;
    event.shift = shift;
    event.repeat = repeat;
    return event;
}

InputEvent Key(in Key key, in b8 shift, in b8 control, in b8 alt, in b8 repeat){
    InputEvent event = InputEvent();
    event.type = InputEventType::KeyDown;
    event.key = key;
    event.shift = shift;
    event.control = control;
    event.alt = alt;
    event.repeat = repeat;
    return event;
}

InputRoutingResult SendUiNativeInput(mut InputRouter router, in InputEvent event){
    EXPECT_TRUE(router.queue(NativeInput(event)).has_value());
    return router.process();
}

InputRoutingResult SendUiPointerInput(mut InputRouter router, in PointerInput input){
    EXPECT_TRUE(router.queuePointer(input).has_value());
    return router.process();
}

void ClickUiInputRouter(mut InputRouter router, in Point position){
    EXPECT_TRUE(SendUiNativeInput(router, Pointer(InputEventType::PrimaryDown, position)).pointerConsumed);
    EXPECT_TRUE(SendUiNativeInput(router, Pointer(InputEventType::PrimaryUp, position)).pointerConsumed);
}

void SendUiKeyTap(mut InputRouter router, in Key value, in b8 shift){
    EXPECT_TRUE(SendUiNativeInput(router, Key(InputEventType::KeyDown, value, false, shift)).commandConsumed);
    EXPECT_TRUE(SendUiNativeInput(router, Key(InputEventType::KeyUp, value, false, shift)).commandConsumed);
}


