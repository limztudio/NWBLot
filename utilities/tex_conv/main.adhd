#include <utilities/tex_conv/prepare_texture.adhd>
#include <utilities/tex_conv/publication.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
i32 RunConsole(in ConsoleArguments arguments){
    String input;
    String output;
    String alphaText;
    Vector<String> cube;
    Vector<String> volume;
    b8 force = false;
    b8 linear = false;

    ToolCli app("Convert LDR or HDR images into prepared linear UASTC texture assets.");
    app.addText(s_InputOptionName, input, "2D input image (.png, .jpg, .jpeg, .jfif, .tga, .qoi, .exr, or .hdr)");
    app.addTexts(s_CubeOptionName, cube, "Six cubemap faces: +X -X +Y -Y +Z -Z").expected(cast<i32>(s_TextureCubeFaceCount));
    app.addTexts(s_VolumeOptionName, volume, "Ordered volume Z slices: z0 z1 ... zN").expectedRange(s_MinVolumeSliceCount, s_UnboundedOptionCount);
    app.addText(s_OutputOptionName, output, "Output base name or .nwb filename");
    const auto alphaOption = app.addText(s_AlphaOptionName, alphaText, "Alpha source: mask image red channel, white, or black");
    app.addFlag(s_LinearFlagName, linear, "Treat LDR input as linear data instead of sRGB color (HDR input is always linear)");
    app.addFlag(s_ForceFlagName, force, "Replace existing .nwb and .tex output files");
    const auto parsed = app.parse(arguments);
    if(!parsed.ok())
        return parsed.exitToConsole();

    if(!ValidateTexConvInputModeCount(!input.empty(), !cube.empty(), !volume.empty()))
        return s_TexConvExitFailure;
    Vector<Path> inputPaths;
    TexturePayloadDimension dimension = TexturePayloadDimension::Texture2D;
    if(!input.empty())
        inputPaths.push_back(Path(input));
    else if(!cube.empty()){
        dimension = TexturePayloadDimension::TextureCube;
        for(in String name : cube)
            inputPaths.push_back(Path(name));
    }
    else{
        dimension = TexturePayloadDimension::Texture3D;
        for(in String name : volume)
            inputPaths.push_back(Path(name));
    }

    TexConvAlphaSource alpha;
    if(IsTexConvAlphaOptionPresent(cast<i32>(alphaOption.count()))){
        if(!TryParseTexConvAlphaOption(alphaText, alpha.mode, alpha.constant))
            return s_TexConvExitFailure;
        if(alpha.mode == AlphaSourceMode::Image)
            alpha.path = Path(alphaText);
    }
    for(in Path path : inputPaths){
        if(!ValidateTexConvInputImagePath(path, false))
            return s_TexConvExitFailure;
    }
    if(alpha.mode == AlphaSourceMode::Image && !ValidateTexConvInputImagePath(alpha.path, true))
        return s_TexConvExitFailure;
    const auto paths = ResolveTexConvOutputPaths(inputPaths.front(), output);
    if(!paths.has_value() || !ValidateOutputPaths(paths.value(), force))
        return s_TexConvExitFailure;
    const auto payload = PrepareTexture(inputPaths, dimension, !linear, alpha);
    if(!payload.has_value() || !WriteOutputs(paths.value(), payload.value(), force))
        return s_TexConvExitFailure;
    const String report = FormatTexConvCompletionReport(paths.value().metadata, paths.value().data, payload.value().width, payload.value().height,
        payload.value().depth, dimension == TexturePayloadDimension::TextureCube, dimension == TexturePayloadDimension::Texture3D, payload.value().mipCount, payload.value().bytes.size());
    [essential] info("{}", report);
    return s_TexConvExitSuccess;
}


