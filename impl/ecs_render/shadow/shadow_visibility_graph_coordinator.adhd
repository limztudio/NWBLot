#include <impl/ecs_render/raytrace/raytracing_system.adhd>
#include <impl/ecs_render/raytrace/task_graph_scene_resources.adhd>
#include <impl/ecs_render/raytrace/graph_snapshots.adhd>
#include <impl/ecs_render/shadow/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ShadowVisibilityGraphContext{
    public mut GraphicsRuntime graphics;
    public mut GpuTaskGraph graph;
    public mut RendererRayTracingSystem rayTracing;
    public mut GpuPersistentResourceStateCache shadowComputeState;
    public mut GpuPersistentResourceStateCache shadowReturnState;
    public in b8 shadowPrepared;

    public ShadowVisibilityGraphContext(
        mut GraphicsRuntime graphics,
        mut GpuTaskGraph graph,
        mut RendererRayTracingSystem rayTracing,
        mut GpuPersistentResourceStateCache shadowComputeState,
        mut GpuPersistentResourceStateCache shadowReturnState,
        in borrow b8 shadowPrepared
    ){
        this.graphics = graphics;
        this.graph = graph;
        this.rayTracing = rayTracing;
        this.shadowComputeState = shadowComputeState;
        this.shadowReturnState = shadowReturnState;
        this.shadowPrepared = shadowPrepared;
    }
}

[friend(RendererFramePipeline, DeferredFrameTopologyValidator, FrameExecuteTimingState, FrameExecuteStateLifecycleSet, ShadowVisibilityMergeValidator)]
class ShadowVisibilityGraphCoordinator : NoCopy{
    private GpuTaskId m_deferredShadowVisibilityOpaqueTask;
    private GpuTaskId m_deferredShadowVisibilityOpaqueFirstWaveletTask;
    private GpuTaskId m_deferredShadowVisibilityOpaqueResolveTask;
    private GpuTaskId m_deferredShadowVisibilityTransparentTraceTask;
    private GpuTaskId m_deferredShadowVisibilityTransparentTemporalMergeTask;
    private GpuTaskId m_deferredShadowVisibilityTransparentFirstWaveletTask;
    private GpuTaskId m_deferredShadowVisibilityDiagnosticsTask;
    private GpuTaskId m_deferredShadowVisibilityAdaptiveCounterClearTask;
    private GpuTaskId m_deferredShadowVisibilityAllLitClearTask;
    private GpuTaskId m_deferredShadowVisibilityTask;
    private b8 m_deferredShadowCombinedUpsample = false;
    private b8 m_deferredShadowCombinedWavelet = false;
    private b8 m_deferredShadowCombinedTemporal = false;

    [cpp_unwind]
    public b8 declareDeferredShadowVisibilityTask(
        in ShadowVisibilityGraphContext context,
        in DeferredLightingGraphResources deferredLightingResources,
        in RayTracingShadowPreparationResourceSnapshot rayTracingShadowResources,
        in RayTracingDeferredGraphResourceSnapshot rayTracingResources,
        in RayTracingShadowVisibilityGraphPlanSnapshot rayTracingPlan,
        in RayTracingSceneGraphReads hardwareSceneReads,
        in b8 hardwareShadowSupported,
        in GpuGraphResourceId worldPosition,
        in GpuGraphResourceId normal,
        in GpuGraphResourceId depth,
        in GpuGraphResourceId shadowVisibility,
        in GpuGraphResourceId currentBindlessSlots,
        in GpuGraphResourceId sceneShading,
        in GpuGraphResourceId lights,
        in GpuGraphResourceId materialContextSlots,
        in Span<GpuGraphResourceId> traceGeometryResources,
        in GpuGraphResourceSetId traceGeometrySet,
        in GpuGraphResourceSetId traceMaterialSampledTextureSet,
        in GpuTaskId prefixTask,
        in GpuExternalCompletionId laggedLightingHistoryWriterDrainCompletion,
        mut DeferredFrameTargets deferredTargets,
        mut GpuTimingSubmissionTicket timingTicket,
        mut Optional<GpuTimingMeasure> asyncTiming,
        mut Optional<GpuTimingMeasure> shadowVisibilityTiming,
        mut Optional<GpuTimingMeasure> opaqueResolveTiming,
        mut Optional<GpuTimingMeasure> transparentResolveTiming,
        mut b8 opaqueProduced,
        mut b8 transparentTraceProduced,
        mut u32 opaqueFrameIndex
    );
}


