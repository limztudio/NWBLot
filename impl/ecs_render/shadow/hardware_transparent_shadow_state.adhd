#include <impl/ecs_render/shadow/push_constants.adhd>
#include <impl/ecs_render/shadow/types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class HardwareTransparentShadowState{
    public ShadowBindingLayoutHandle m_bindingLayout = ShadowBindingLayoutHandle();
    public Array<ShadowShaderHandle, 3u> m_shaders;
    public Array<ShadowComputePipelineHandle, 3u> m_pipelines;
    public ShadowBufferHandle m_crossingsBuffer = ShadowBufferHandle();
    public ShadowBufferHandle m_overflowListBuffer = ShadowBufferHandle();
    public ShadowBufferHandle m_overflowArgsBuffer = ShadowBufferHandle();
    public ShadowDescriptorHandle m_crossingsHeapHandle = ShadowDescriptorHandle();
    public ShadowDescriptorHandle m_overflowListHeapHandle = ShadowDescriptorHandle();
    public ShadowDescriptorHandle m_overflowArgsHeapHandle = ShadowDescriptorHandle();
    public u32 m_pixelsCapacity = 0u;
    public b8 m_ready = false;
    public b8 m_pipelineFailed = false;
    public b8 m_dispatchLogged = false;
}


