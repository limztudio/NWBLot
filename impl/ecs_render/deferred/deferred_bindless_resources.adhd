const Name s_DeferredBindlessSlotsBufferName = "ECSRender_DeferredBindlessResourceSlots";


void LogDeferredBindlessHeapMissing(){
    error("RendererSystem: deferred lighting/compositor requires the global descriptor heap");
}

void LogDeferredBindlessRegistrationFailed(){
    error("RendererSystem: failed to register deferred frame resources in the descriptor heap");
}

void LogDeferredBindlessSlotBufferCreateFailed(){
    error("RendererSystem: failed to create deferred bindless slot buffer");
}

void LogDeferredBindlessSlotBufferRegisterFailed(){
    error("RendererSystem: failed to register deferred bindless slot buffer in the descriptor heap");
}



Expected<void> DeferredBindlessDescriptorRegistrar::registerAll(){
    if(
        !this.registerLightingTargets().has_value()
        || !this.registerTransparencyTargets().has_value()
        || !this.registerSceneBuffers().has_value()
        || !this.registerCsgIntervalTargets().has_value()
        || !this.registerCausticResolveTargets().has_value()
        || !this.registerSoftShadowTargets().has_value()
    )
        return MakeUnexpected(Failure());
    return Expected<void>();
}

Expected<void> DeferredBindlessDescriptorRegistrar::registerLightingTargets(){
    Expected<GpuDescriptorHandle> descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage, this.m_targets.albedo, this.m_targets.albedoFormat, s_FramebufferSubresources, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.gbufferBaseColor = descriptor.value();
    descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage, this.m_targets.normal, this.m_targets.normalFormat, s_FramebufferSubresources, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.gbufferNormal = descriptor.value();
    descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage, this.m_targets.worldPosition, this.m_targets.worldPositionFormat, s_FramebufferSubresources, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.gbufferWorldPosition = descriptor.value();
    descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage, this.m_targets.specularRoughness, this.m_targets.specularRoughnessFormat, s_FramebufferSubresources, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.gbufferSpecularRoughness = descriptor.value();
    descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage, this.m_targets.depth, this.m_targets.depthFormat, s_FramebufferSubresources, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.gbufferDepth = descriptor.value();
    descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage2DArray, this.m_targets.shadowVisibility, this.m_targets.shadowVisibilityFormat, s_ShadowVisibilitySubresources, TextureDimension::Texture2DArray);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.shadowVisibility = descriptor.value();
    descriptor = RegisterStorageTexture(this.m_heap, this.m_targets.shadowVisibility, this.m_targets.shadowVisibilityFormat, TextureDimension::Texture2DArray);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.shadowVisibilityStorage = descriptor.value();
    descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage, this.m_targets.causticIrradiance, this.m_targets.causticIrradianceFormat, s_FramebufferSubresources, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.causticIrradiance = descriptor.value();
    descriptor = RegisterStorageTexture(this.m_heap, this.m_targets.causticIrradiance, this.m_targets.causticIrradianceFormat, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.causticIrradianceStorage = descriptor.value();
    descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage, this.m_targets.surfelIrradiance, this.m_targets.surfelIrradianceFormat, s_FramebufferSubresources, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.surfelIrradiance = descriptor.value();
    descriptor = RegisterStorageTexture(this.m_heap, this.m_targets.surfelIrradiance, this.m_targets.surfelIrradianceFormat, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.surfelIrradianceStorage = descriptor.value();
    descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage, this.m_targets.surfelIrradianceHalf, this.m_targets.surfelIrradianceFormat, s_FramebufferSubresources, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.surfelIrradianceHalf = descriptor.value();
    descriptor = RegisterStorageTexture(this.m_heap, this.m_targets.surfelIrradianceHalf, this.m_targets.surfelIrradianceFormat, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.surfelIrradianceHalfStorage = descriptor.value();
    descriptor = RegisterSampler(this.m_heap, this.m_sources.sampler);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.sampler = descriptor.value();
    descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage, this.m_targets.opaqueColor, this.m_targets.opaqueColorFormat, s_FramebufferSubresources, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.opaqueColor = descriptor.value();
    descriptor = RegisterStorageTexture(this.m_heap, this.m_targets.opaqueColor, this.m_targets.opaqueColorFormat, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.opaqueColorStorage = descriptor.value();
    descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage, this.m_targets.compositeColor, this.m_targets.compositeColorFormat, s_FramebufferSubresources, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.compositeColor = descriptor.value();
    descriptor = RegisterStorageTexture(this.m_heap, this.m_targets.compositeColor, this.m_targets.compositeColorFormat, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.compositeColorStorage = descriptor.value();
    return Expected<void>();
}


Expected<void> DeferredBindlessDescriptorRegistrar::registerTransparencyTargets(){
    Expected<GpuDescriptorHandle> descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage, this.m_targets.avboit.accumColor, this.m_targets.avboit.accumColorFormat, s_FramebufferSubresources, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.avboitAccumColor = descriptor.value();
    descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage, this.m_targets.avboit.accumExtinction, this.m_targets.avboit.accumExtinctionFormat, s_FramebufferSubresources, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.avboitAccumExtinction = descriptor.value();
    descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage, this.m_targets.avboit.refractionDepth, this.m_targets.depthFormat, s_FramebufferSubresources, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.refractionDepth = descriptor.value();
    descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage, this.m_targets.avboit.refractionNormalIor, Format::RGBA16_FLOAT, s_FramebufferSubresources, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.refractionNormalIor = descriptor.value();
    descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage, this.m_targets.avboit.refractionTintCoverage, Format::RGBA16_FLOAT, s_FramebufferSubresources, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.refractionTintCoverage = descriptor.value();
    descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage, this.m_targets.avboit.refractionInstance, Format::RG32_FLOAT, s_FramebufferSubresources, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.refractionInstance = descriptor.value();
    descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage, this.m_targets.avboit.refractionSpecularRoughness, Format::RGBA16_FLOAT, s_FramebufferSubresources, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.refractionSpecularRoughness = descriptor.value();
    descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage, this.m_targets.avboit.refractionResolve, Format::RGBA16_FLOAT, s_FramebufferSubresources, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.refractionResolve = descriptor.value();
    descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage, this.m_targets.avboit.foregroundAccumColor, this.m_targets.avboit.accumColorFormat, s_FramebufferSubresources, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.avboitForegroundColor = descriptor.value();
    descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage, this.m_targets.avboit.foregroundAccumExtinction, this.m_targets.avboit.accumExtinctionFormat, s_FramebufferSubresources, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.avboitForegroundExtinction = descriptor.value();
    descriptor = RegisterStorageTexture(this.m_heap, this.m_targets.avboit.refractionResolve, Format::RGBA16_FLOAT, TextureDimension::Texture2D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.refractionResolveStorage = descriptor.value();
    descriptor = RegisterSampledTexture(this.m_heap, GpuDescriptorClass::SampledImage3D, this.m_targets.avboit.transmittanceTexture, this.m_targets.avboit.transmittanceFormat, s_FramebufferSubresources, TextureDimension::Texture3D);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.avboitTransmittance = descriptor.value();
    descriptor = RegisterSampler(this.m_heap, this.m_sources.avboitLinearSampler);
    if(!descriptor.has_value())
        return MakeUnexpected(descriptor.error());
    this.m_targets.bindless.avboitLinearSampler = descriptor.value();
    return Expected<void>();
}


Expected<void> DeferredBindlessDescriptorRegistrar::registerSceneBuffers(){
    const Expected<GpuDescriptorHandle> sceneShading = RegisterConstantBuffer(this.m_heap, this.m_sources.sceneShadingBuffer);
    if(!sceneShading.has_value())
        return MakeUnexpected(sceneShading.error());
    this.m_targets.bindless.sceneShading = sceneShading.value();
    const Expected<GpuDescriptorHandle> lightList = RegisterStructuredBuffer(this.m_heap, this.m_sources.lightBuffer);
    if(!lightList.has_value())
        return MakeUnexpected(lightList.error());
    this.m_targets.bindless.lightList = lightList.value();
    return Expected<void>();
}

