void VerifyNoexceptFailureTests_OwnerObservationUsesImplicitCopyAndPreservesBorrowedTargetsOnFailure(){
    b8 failCopyReset = true;
    b8 uniqueTargetPreserved = false;
    b8 sharedTargetPreserved = false;
    {
        RefCountTarget target;
        ObservedUnique unique = BorrowObservedUnique(target);
        ObservedShared shared = BorrowObservedShared(target);
        const auto disarm = GuardCleanup(lambda[]() -> void{ FailObserverCopy(false); });
        RequireThrowingExpression(PointsAt(unique, target));
        RequireThrowingExpression(ArrowPointsAt(unique, target));
        RequireThrowingExpression(PointsAt(shared, target));
        RequireThrowingExpression(ArrowPointsAt(shared, target));
        FailObserverCopy(true);
        ExpectUnsignedException(PointsAt(unique, target));
        ExpectUnsignedException(ArrowPointsAt(unique, target));
        ExpectUnsignedException(PointsAt(shared, target));
        ExpectUnsignedException(ArrowPointsAt(shared, target));
        FailObserverCopy(false);
        failCopyReset = FailsObserverCopy();
        uniqueTargetPreserved = PointsAt(unique, target);
        sharedTargetPreserved = PointsAt(shared, target);
    }
    EXPECT_FALSE(failCopyReset);
    EXPECT_TRUE(uniqueTargetPreserved);
    EXPECT_TRUE(sharedTargetPreserved);
}

void VerifyNoexceptFailureTests_HexAppendCapacityAndOutputFailuresPreservePublishedCharacters(){
    CompactString fixed = CompactString();
    AppendHexU32(0u, fixed);
    EXPECT_EQ(fixed.view(), "00000000");
    fixed.clear();

    b8 capacityEmpty = false;
    CompactString hex64Prefix = CompactString();
    CompactString hex32LiteralPrefix = CompactString();
    {
        CompactString compactFixed;
        RequireNothrowExpression(AppendHexU32(0u, compactFixed));
        RequireNothrowExpression(AppendHexU64(cast<u64>(0u), compactFixed));
        RequireNothrowExpression(AppendHexU32UnsignedLiteral(0u, compactFixed));

        ThrowingHexCapacityString capacity;
        RequireThrowingExpression(AppendHexU64(cast<u64>(0u), capacity));
        ExpectUnsignedException(AppendHexU64(cast<u64>(1u), capacity));
        capacityEmpty = capacity.text.empty();

        ThrowingHexAppendString output;
        RequireThrowingExpression(AppendHexU64(cast<u64>(0u), output));
        ExpectUnsignedException(AppendHexU64(cast<u64>(0xabcdef0123456789u), output));
        hex64Prefix = output.text;
        output.text.clear();
        RequireThrowingExpression(AppendHexU32UnsignedLiteral(0u, output));
        ExpectUnsignedException(AppendHexU32UnsignedLiteral(0x89abcdefu, output));
        hex32LiteralPrefix = output.text;
    }
    EXPECT_TRUE(capacityEmpty);
    EXPECT_EQ(hex64Prefix.view(), "ab");
    EXPECT_EQ(hex32LiteralPrefix.view(), "0x");
}

void VerifyNoexceptFailureTests_FixedVectorRemovalSupportsCopyOnlyAndEmptyZeroCapacity(){
    u32 live = 0u;
    {
        FixedVector<FixedVectorCopyOnly, 2u> stored;
        FixedVectorCopyOnly value(live);
        PushTestCopy(stored, value);
        EXPECT_EQ(live, 2u);
        stored.pop_back();
        EXPECT_EQ(live, 1u);
        PushTestCopy(stored, value);
        stored.clear();
        EXPECT_TRUE(stored.empty());
        EXPECT_EQ(live, 1u);
        EmptyFixed empty;
        RequireNothrowExpression(empty.clear());
        empty.clear();
        EXPECT_TRUE(empty.empty());
        FixedVector<FixedVectorNonAssignable, 1u> nonAssignable;
        RequireNothrowExpression(nonAssignable.clear());
        nonAssignable.clear();
        EXPECT_TRUE(nonAssignable.empty());
    }
    EXPECT_EQ(live, 0u);
}

void VerifyNoexceptFailureTests_FixedVectorRemovalReleasesResourcesAndRetainsSizeOnResetFailure(){
    u32 live = 0u;
    b8 firstFails = false;
    b8 secondFails = false;
    {
        FixedVector<FixedVectorResource, 3u> stored;
        RequireThrowingExpression(stored.clear());
        stored.emplace_back(live, firstFails);
        stored.emplace_back(live, secondFails);
        ASSERT_EQ(live, 2u);
        stored.pop_back();
        EXPECT_EQ(live, 1u);
        stored.emplace_back(live, secondFails);
        secondFails = true;
        ExpectUnsignedException(stored.pop_back());
        EXPECT_EQ(stored.size(), 2u);
        EXPECT_EQ(live, 2u);
        secondFails = false;
        firstFails = true;
        ExpectUnsignedException(stored.clear());
        EXPECT_EQ(stored.size(), 1u);
        EXPECT_EQ(live, 1u);
        firstFails = false;
        stored.clear();
        EXPECT_TRUE(stored.empty());
    }
    EXPECT_EQ(live, 0u);
}

void VerifyNoexceptFailureTests_FixedVectorElementAssignmentFailurePropagatesWithoutPublishingFullSize(){
    const u32 initialValue = 17u;
    const u32 replacementValue = 29u;
    usize retainedSize = 0u;
    u32 retainedFirstValue = 0u;
    {
        FixedVector<ThrowingFixedVectorAssignment, 4u> stored;
        stored.resize(1u);
        stored[0u].value = initialValue;
        ThrowingFixedVectorAssignment replacement;
        replacement.value = replacementValue;
        RequireThrowingExpression(stored.fill(replacement));
        ExpectUnsignedException(stored.fill(replacement));
        retainedSize = stored.size();
        retainedFirstValue = stored[0u].value;
    }
    EXPECT_EQ(retainedSize, 1u);
    EXPECT_EQ(retainedFirstValue, initialValue);
}

void VerifyNoexceptFailureTests_FixedVectorElementSwapFailurePropagatesWithoutSwappingSizes(){
    const u32 expectedFirst = 17u;
    const u32 expectedSecond = 29u;
    usize firstSize = 0u;
    usize secondSize = 0u;
    u32 firstValue = 0u;
    u32 secondValue = 0u;
    {
        FixedVector<ThrowingFixedVectorSwap, 4u> first;
        FixedVector<ThrowingFixedVectorSwap, 4u> second;
        first.resize(1u);
        second.resize(2u);
        first[0u].value = expectedFirst;
        second[0u].value = expectedSecond;
        RequireThrowingExpression(first.swap(second));
        ExpectUnsignedException(first.swap(second));
        firstSize = first.size();
        secondSize = second.size();
        firstValue = first[0u].value;
        secondValue = second[0u].value;
    }
    EXPECT_EQ(firstSize, 1u);
    EXPECT_EQ(secondSize, 2u);
    EXPECT_EQ(firstValue, expectedFirst);
    EXPECT_EQ(secondValue, expectedSecond);
}


