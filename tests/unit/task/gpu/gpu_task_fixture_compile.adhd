Expected<GpuTaskId> AddTask(
    in Name identity,
    in AStringView label,
    in Span<GpuTaskId> dependencies,
    in Span<GpuTaskResourceUse> resourceUses,
    in Span<GpuTaskResourceSetUse> resourceSetUses,
    in Span<GpuTaskResourceVersionUse> resourceVersionUses,
    in Span<GpuExternalCompletionId> externalDependencies,
    mut GpuTaskGraph graph
){
    GpuTaskDesc desc = GpuTaskDesc();
    desc.setIdentity(identity);
    desc.setMarkerLabel(label);
    desc.setDependencies(dependencies);
    desc.setExternalDependencies(externalDependencies);
    desc.setResourceUses(resourceUses);
    desc.setResourceSetUses(resourceSetUses);
    desc.setResourceVersionUses(resourceVersionUses);
    return graph.addTask(desc);
}

Expected<GpuTaskId> AddTaskWithCommands(
    in Name identity,
    in AStringView label,
    in GpuTaskCommandRequirements commands,
    in GpuTaskSchedulingHint scheduling,
    in GpuTaskTimingMetadata timing,
    in Span<GpuTaskId> dependencies,
    mut GpuTaskGraph graph
){
    GpuTaskDesc desc = GpuTaskDesc();
    desc.setIdentity(identity);
    desc.setMarkerLabel(label);
    desc.setScheduling(scheduling);
    desc.setTiming(timing);
    desc.setDependencies(dependencies);
    return graph.addTask(desc, commands);
}

b8 Analyze(in GpuTaskGraph graph, mut ScratchArena scratchArena, mut GpuTaskGraphAnalysis analysis){
    const GpuTaskGraphCompiler compiler = GpuTaskGraphCompiler();
    const GpuTaskGraphDeclarationReadView declarations = GpuTaskGraphDeclarationReadView(graph);
    return compiler.analyze(declarations, scratchArena, analysis);
}

b8 HasInferredHazard(
    in GpuTaskGraphAnalysis analysis,
    in GpuTaskId producer,
    in GpuTaskId consumer,
    in GpuGraphResourceId resource,
    in GpuTaskHazardTypeEnum hazard
){
    const Span<GpuTaskDependencyEdge> edges = analysis.inferredEdges();
    for(usize i = 0u; i < edges.size(); ++i){
        const GpuTaskDependencyEdge edge = edges[i];
        if(edge.producer == producer && edge.consumer == consumer && edge.resource == resource && edge.hazard == hazard)
            return true;
    }
    return false;
}


