////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/assets_shader/shader_types.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_unwind]
b8 Load<ShaderT : IShader, Resolver>(
    in Name shaderName,
    in StringView variantName,
    in Name debugName,
    in StringView owner,
    mut GraphicsRuntime graphics,
    in AssetManager assets,
    mut Resolver resolve,
    in Optional<Name> archiveStage,
    mut ShaderHandle outShader
){
    const ShaderType stage = cast<ShaderType>(RequireAssetTypeIndex<ShaderT>(s_ShaderAssetTypes));
    const ShaderTypeMask mask = ToMask(stage);
    if(outShader.valid())
        return true;
    if(shaderName == s_NameNone){
        error("{}: shader name is empty", owner);
        return false;
    }

    Name stageName = ArchiveStageNameFromShaderType(mask);
    if(archiveStage.has_value())
        stageName = archiveStage.value();
    if(stageName == s_NameNone){
        error("{}: unsupported shader stage {}", owner, cast<u32>(mask));
        return false;
    }
    if(variantName.empty()){
        error("{}: shader variant is empty", owner);
        return false;
    }
    if(!cast<b8>(resolve)){
        error("{}: shader path resolver is null", owner);
        return false;
    }

    const Expected<Name> path = resolve(shaderName, variantName, stageName);
    if(!path.has_value()){
        error("{}: failed to resolve shader '{}' variant '{}' stage '{}'", owner, shaderName.resolvedText(), variantName, stageName.resolvedText());
        return false;
    }
    if(path.value() == s_NameNone){
        error("{}: shader resolver returned an empty path for shader '{}' variant '{}' stage '{}'", owner, shaderName.resolvedText(), variantName, stageName.resolvedText());
        return false;
    }

    const Expected<UniquePtr<ShaderT>> loaded = LoadTypedAssetSync<ShaderT>(assets, path.value(), owner);
    if(!loaded.has_value())
        return false;
    in ShaderT shader = loaded.value().deref();
    const StringView entryPoint = shader.entryPoint();
    in auto binary = shader.bytecode();
    assert(!entryPoint.empty() && !binary.empty() && (binary.size() & s_SpvWordByteMask) == 0u);
    ShaderDesc descriptor;
    descriptor.setShaderType(mask);
    descriptor.setDebugName(debugName);
    descriptor.setEntryName(entryPoint);
    Expected<ShaderHandle> result = graphics.getDevice().createShader(descriptor, binary);
    if(!result.has_value()){
        outShader.reset();
        error("{}: failed to create shader '{}' from asset '{}'", owner, debugName.resolvedText(), path.value().resolvedText());
        return false;
    }
    outShader = result.value();
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

