[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/material/material_internal.adhd.h>
#include <impl/ecs_render/material/material_pass_draw_recorder.adhd.h>
#include <impl/ecs_render/material/material_system.adhd.h>
#include <impl/ecs_render/material/renderer_material_state.adhd.h>
#include <impl/ecs_render/csg/csg_graph_resource_snapshot.adhd.h>
#include <impl/ecs_render/kernel/compute_pipeline_utils.adhd.h>
#include <impl/ecs_render/kernel/timing_names.adhd.h>
#include <impl/ecs_render/shader/shader_system.adhd.h>
#include <impl/ecs_render/shared/frame_types.adhd.h>
#include <impl/ecs_render/shared/renderer_push_constants_private.adhd.h>
#include <impl/assets/graphics/mesh/object_geometry_constants.h>
#include <impl/assets_graphics/mesh_subsystem.adhd.h>
#include <impl/assets_shader/asset.adhd.h>

#include <core/graphics/backend_selection.h>
#include <core/graphics/gpu_timing.h>
#include <core/graphics/runtime/runtime.h>
#include <core/graphics/shader_archive.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_material_pass{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


inline constexpr Core::GpuTimingScopeDefinition s_NoneGpuTimingScope;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[[nodiscard]] FOUNDATION_INLINE const Core::GpuTimingScopeDefinition& MaterialPassGpuTimingScope(const MaterialPipelinePass::Enum pass)noexcept{
    switch(pass){
    case MaterialPipelinePass::AvboitOccupancy: return RendererGpuTimingScope::s_AvboitOccupancy;
    case MaterialPipelinePass::AvboitExtinction: return RendererGpuTimingScope::s_AvboitExtinction;
    case MaterialPipelinePass::AvboitAccumulate: return RendererGpuTimingScope::s_AvboitAccumulate;
    default: return s_NoneGpuTimingScope;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void RendererMaterialSystem::renderPreparedMaterialPass(
    Core::CommandList& commandList,
    const Core::FramebufferHandle& framebuffer,
    const MaterialPipelinePass::Enum pass,
    const AvboitFrameTargets* const avboitTargets,
    const MaterialPassDrawItemPartitionsView& drawItems,
    const CsgFrameGpuDataView& csgFrameData,
    const ECSRenderDetail::CsgGraphResourceSnapshot& csgResources,
    const MeshFrameBindingSnapshot& frameBindings,
    const usize instanceCount,
    const usize materialTypedByteCount,
    const b8 materialFrameStatesGraphOwned,
    const b8 materialGeometryStatesGraphOwned,
    const b8 emulationOutputEntryStateGraphOwned,
    const b8 csgEmulationOutputEntryStateGraphOwned,
    const b8 emulationOutputReused,
    Optional<Core::GpuTimingMeasure>* const emulationOutputTiming
){
    const auto discardEmulationOutputTiming = [emulationOutputTiming](){
        if(!emulationOutputTiming || !emulationOutputTiming->has_value())
            return;
        emulationOutputTiming->value().discardTiming();
        emulationOutputTiming->reset();
    };
    const b8 avboitTargetsValid = avboitTargets && avboitTargets->valid();
    if(!CanPrepareMaterialPassTargets(framebuffer != nullptr, pass, avboitTargetsValid) || drawItems.empty()){
        discardEmulationOutputTiming();
        return;
    }

    commandList.endRenderPass();

    // Fresh producers open split timing. Reused regular output has a separate, already-validated graph producer.
    if(IsRejectedReusedEmulationOutputHandoff(emulationOutputReused, emulationOutputEntryStateGraphOwned, csgEmulationOutputEntryStateGraphOwned))
        return;
    const b8 splitEmulationTiming = UsesSplitEmulationTiming(emulationOutputEntryStateGraphOwned, csgEmulationOutputEntryStateGraphOwned, emulationOutputReused);
    if(splitEmulationTiming && (!emulationOutputTiming || !emulationOutputTiming->has_value()))
        return;

    // Declaration froze ordering and published bytes; keep this consumer side-effect free.
    if(!frameBindings.frameReady(instanceCount, materialTypedByteCount)){
        discardEmulationOutputTiming();
        return;
    }
    const b8 regularDrawResourcesReady = m_drawRecorder.materialPassDrawResourcesReady(drawItems.regular, frameBindings);
    // Active handoff covers every regular draw; reject on late resource disagreement.
    if(emulationOutputEntryStateGraphOwned && !regularDrawResourcesReady){
        discardEmulationOutputTiming();
        return;
    }
    const b8 csgResourcesReady = csgResources.frameReady(csgFrameData);
    const b8 csgDrawResourcesReady = csgResourcesReady && (drawItems.csg.empty() || m_drawRecorder.materialPassDrawResourcesReady(drawItems.csg, frameBindings));
    if(csgEmulationOutputEntryStateGraphOwned && !csgDrawResourcesReady){
        discardEmulationOutputTiming();
        return;
    }

    Core::ViewportState viewportState;
    viewportState.addViewportAndScissorRect(framebuffer->getFramebufferInfo().getViewport());
    MaterialPassDrawContext regularDrawContext(
        commandList,
        viewportState,
        frameBindings,
        pass,
        materialFrameStatesGraphOwned,
        materialGeometryStatesGraphOwned,
        emulationOutputEntryStateGraphOwned
    );
    regularDrawContext.setFramebuffer(framebuffer);
    if(avboitTargets)
        regularDrawContext.setAvboitTargets(*avboitTargets);
    // CSG opts in only via its own frozen producer; keep it separate from the regular flag.
    MaterialPassDrawContext csgDrawContext(
        commandList,
        viewportState,
        frameBindings,
        pass,
        materialFrameStatesGraphOwned,
        materialGeometryStatesGraphOwned,
        csgEmulationOutputEntryStateGraphOwned
    );
    csgDrawContext.setFramebuffer(framebuffer).setCsgResources(csgResources);
    if(avboitTargets)
        csgDrawContext.setAvboitTargets(*avboitTargets);
    const auto recordPreparedDraws = [&](){
        if(regularDrawResourcesReady)
            m_drawRecorder.renderMaterialPassDrawItems(regularDrawContext, drawItems.regular);
        if(csgDrawResourcesReady)
            m_drawRecorder.renderMaterialPassDrawItems(csgDrawContext, drawItems.csg);
    };
    if(splitEmulationTiming){
        recordPreparedDraws();
        emulationOutputTiming->value().finishTiming(commandList);
        emulationOutputTiming->reset();
    }
    else{
        Core::GpuTimingMeasure timing(m_graphics.gpuTiming(), __hidden_material_pass::MaterialPassGpuTimingScope(pass), m_graphics.getDevice(), commandList);

        recordPreparedDraws();
    }
}

void RendererMaterialSystem::renderPreparedAvboitMaterialPass(
    Core::CommandList& commandList,
    const Core::FramebufferHandle& framebuffer,
    const MaterialPipelinePass::Enum pass,
    const AvboitFrameTargets& avboitTargets,
    const MaterialPassDrawItemPartitionsView& drawItems,
    const CsgFrameGpuDataView& csgFrameData,
    const ECSRenderDetail::CsgGraphResourceSnapshot& csgResources,
    const MeshFrameBindingSnapshot& frameBindings,
    const usize instanceCount,
    const usize materialTypedByteCount,
    const b8 materialFrameStatesGraphOwned,
    const b8 materialGeometryStatesGraphOwned,
    const b8 emulationOutputEntryStateGraphOwned,
    const b8 csgEmulationOutputEntryStateGraphOwned,
    const b8 emulationOutputReused
){
    renderPreparedMaterialPass(
        commandList,
        framebuffer,
        pass,
        &avboitTargets,
        drawItems,
        csgFrameData,
        csgResources,
        frameBindings,
        instanceCount,
        materialTypedByteCount,
        materialFrameStatesGraphOwned,
        materialGeometryStatesGraphOwned,
        emulationOutputEntryStateGraphOwned,
        csgEmulationOutputEntryStateGraphOwned,
        emulationOutputReused,
        nullptr
    );
}

void RendererMaterialSystem::renderPreparedAvboitMaterialPass(
    Core::CommandList& commandList,
    const Core::FramebufferHandle& framebuffer,
    const MaterialPipelinePass::Enum pass,
    const AvboitFrameTargets& avboitTargets,
    const MaterialPassDrawItemPartitionsView& drawItems,
    const CsgFrameGpuDataView& csgFrameData,
    const ECSRenderDetail::CsgGraphResourceSnapshot& csgResources,
    const MeshFrameBindingSnapshot& frameBindings,
    const usize instanceCount,
    const usize materialTypedByteCount,
    const b8 materialFrameStatesGraphOwned,
    const b8 materialGeometryStatesGraphOwned,
    const b8 emulationOutputEntryStateGraphOwned,
    const b8 csgEmulationOutputEntryStateGraphOwned,
    const b8 emulationOutputReused,
    Optional<Core::GpuTimingMeasure>& emulationOutputTiming
){
    renderPreparedMaterialPass(
        commandList,
        framebuffer,
        pass,
        &avboitTargets,
        drawItems,
        csgFrameData,
        csgResources,
        frameBindings,
        instanceCount,
        materialTypedByteCount,
        materialFrameStatesGraphOwned,
        materialGeometryStatesGraphOwned,
        emulationOutputEntryStateGraphOwned,
        csgEmulationOutputEntryStateGraphOwned,
        emulationOutputReused,
        &emulationOutputTiming
    );
}

b8 RendererMaterialSystem::prepareMaterialPassResources(
    Core::Alloc::ScratchArena& scratchArena,
    const Core::FramebufferHandle& framebuffer,
    const MaterialPipelinePass::Enum pass,
    const b8 transparent,
    const CsgFrameState& csgFrameState
){
    return prepareMaterialPassResources(scratchArena, framebuffer, pass, transparent, csgFrameState, nullptr);
}

b8 RendererMaterialSystem::prepareMaterialPassResources(
    Core::Alloc::ScratchArena& scratchArena,
    const Core::FramebufferHandle& framebuffer,
    const MaterialPipelinePass::Enum pass,
    const b8 transparent,
    const CsgFrameState& csgFrameState,
    const AvboitFrameTargets& avboitTargets
){
    return prepareMaterialPassResources(scratchArena, framebuffer, pass, transparent, csgFrameState, &avboitTargets);
}

b8 RendererMaterialSystem::prepareMaterialPassResources(
    Core::Alloc::ScratchArena& scratchArena,
    const Core::FramebufferHandle& framebuffer,
    const MaterialPipelinePass::Enum pass,
    const b8 transparent,
    const CsgFrameState& csgFrameState,
    const AvboitFrameTargets* avboitTargets
){
    const b8 avboitTargetsValid = avboitTargets && avboitTargets->valid();
    if(!CanPrepareMaterialPassTargets(framebuffer != nullptr, pass, avboitTargetsValid))
        return false;

    MaterialPassDrawItemPartitions drawItems{scratchArena};
    InstanceGpuDataVector instanceData{scratchArena};
    CsgFrameGpuData csgFrameData{scratchArena};
#if defined(NWB_DEBUG)
    ECSRenderDetail::MaterialTypedInstanceRangeVector materialTypedRanges{scratchArena};
#endif
    MaterialTypedByteDataVector materialTypedBytes{scratchArena};

    gatherMaterialPassDrawItems(
        framebuffer.get(),
        pass,
        transparent,
        csgFrameState,
        RendererResourceLookupMode::CreateMissing,
        nullptr,
        drawItems,
        instanceData,
        csgFrameData,
#if defined(NWB_DEBUG)
        materialTypedRanges,
#endif
        materialTypedBytes
    );
    if(drawItems.empty())
        return true;

    const b8 drawBuffersReady = prepareMaterialPassDrawBuffers(instanceData, materialTypedBytes);
    const b8 regularDrawResourcesReady = m_drawRecorder.prepareMaterialPassResourceBindings(drawItems.regular);
    const b8 csgDrawResourcesReady = drawItems.csg.empty() || m_drawRecorder.prepareMaterialPassResourceBindings(drawItems.csg);
    const b8 csgReceiverSurfaceDrawResourcesReady = drawItems.csgReceiverSurface.empty() || m_drawRecorder.prepareMaterialPassResourceBindings(drawItems.csgReceiverSurface);

    return drawBuffersReady && regularDrawResourcesReady && csgDrawResourcesReady && csgReceiverSurfaceDrawResourcesReady;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void RendererMaterialSystem::prepareMaterialPassInstanceUploadData(const ECSRenderDetail::CsgGraphResourceSnapshot& csgResources, const Span<InstanceGpuData> instanceData)noexcept{
    // Slot 6 carries CSG context for every raster instance; avoids a second local descriptor.
    const auto csgContextHeapSlot = csgResources.findClipContextHeapSlot();
    for(InstanceGpuData& instance : instanceData)
        instance.geometryHeapSlots[NWB_MESH_INSTANCE_CSG_CONTEXT_HEAP_SLOT] = csgContextHeapSlot.value_or(0u);
}

void RendererMaterialSystem::invalidateResources(){
    releaseMaterialResourceReferences();
    m_materialState.invalidateResources();
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 RendererMaterialSystem::createObjectGeometryPipelineResources(MaterialPipelineResources& resources){
    if(!prepareMeshComputeBindingLayout())
        return false;
    auto& device = m_graphics.getDevice();
    // A single fixed engine decoder defines cache contents independently of the selected material or raster pass.
    if(!m_materialState.m_objectGeometryDecodePipeline){
        if(!m_shaderSystem.loadShader<ComputeShader, MeshSubsystem>(SubsystemAssetSelector<MeshSubsystem, ComputeShader>([](const MeshSubsystem& s){ return s.objectDecodeCs; }), Core::ShaderArchive::s_DefaultVariant, s_ObjectGeometryDecodeDebugName, m_materialState.m_objectGeometryDecodeShader))
            return false;
        if(!CreateHeapComputePipeline(device, m_materialState.m_objectGeometryDecodeShader, m_materialState.m_computeBindingLayout, false, m_materialState.m_objectGeometryDecodePipeline))
            return false;
    }
    if(!m_shaderSystem.loadShader<VertexShader, MeshSubsystem>(SubsystemAssetSelector<MeshSubsystem, VertexShader>([](const MeshSubsystem& s){ return s.objectVs; }), Core::ShaderArchive::s_DefaultVariant, s_ObjectGeometryVsDebugName, resources.objectGeometryVertexShader))
        return false;
    if(!m_materialState.m_objectGeometryInputLayout){
        Array<Core::VertexAttributeDesc, s_ObjectGeometryVertexAttributeCount> attributes{};
        const Array<Core::Format::Enum, 5u> formats = { Core::Format::RGBA32_FLOAT, Core::Format::RGBA16_FLOAT, Core::Format::RGBA16_FLOAT, Core::Format::RG32_FLOAT, Core::Format::RGBA16_FLOAT, };
        const Array<u32, 5u> offsets = { NWB_MESH_OBJECT_VERTEX_POSITION_BYTE_OFFSET, NWB_MESH_OBJECT_VERTEX_NORMAL_BYTE_OFFSET, NWB_MESH_OBJECT_VERTEX_TANGENT_BYTE_OFFSET, NWB_MESH_OBJECT_VERTEX_UV0_BYTE_OFFSET, NWB_MESH_OBJECT_VERTEX_COLOR_BYTE_OFFSET, };
        const Array<Name, 5u> names = { s_VertexAttributePositionName, s_VertexAttributeNormalName, s_VertexAttributeTangentName, s_VertexAttributeTexCoordName, s_VertexAttributeColorName };
        for(u32 index = 0u; index < attributes.size(); ++index)
            attributes[index].setFormat(formats[index]).setBufferIndex(NWB_MESH_EMULATION_VERTEX_BUFFER_INDEX).setOffset(offsets[index]).setElementStride(NWB_MESH_OBJECT_VERTEX_BYTE_SIZE).setName(names[index]);
        auto objectGeometryInputLayoutResult = device.createInputLayout(attributes.data(), static_cast<u32>(attributes.size()), resources.objectGeometryVertexShader.get());
        if(objectGeometryInputLayoutResult)
            m_materialState.m_objectGeometryInputLayout = Move(*objectGeometryInputLayoutResult);
        else
            m_materialState.m_objectGeometryInputLayout.reset();
        if(!objectGeometryInputLayoutResult)
            return false;
    }
    resources.objectGeometryDecodePipeline = m_materialState.m_objectGeometryDecodePipeline;
    return true;
}

b8 RendererMaterialSystem::recordObjectGeometryDecode(const MaterialPassDrawContext& context, const MaterialPassDrawItem& drawItem){
    const MaterialPassMeshResourceSnapshot& mesh = drawItem.meshResources;
    const auto& cache = mesh.objectGeometryCache;
    const Core::ComputePipelineHandle& pipeline = drawItem.pipelineResources.objectGeometryDecodePipeline;
    if(!pipeline || pipeline != cache.decoderPipeline || !cache.valid() || !m_drawRecorder.materialPassDrawResourcesReady(mesh, context.frameBindings))
        return false;
    Core::CommandList& commandList = *context.commandList;
    Core::ComputeState state;
    state.setPipeline(pipeline.get());
    commandList.setComputeState(state);
    m_graphics.getDevice().getDescriptorHeap().bindCompute(commandList, *pipeline.get());
    const MeshFrameHeapSlots slots = ECSRenderDetail::ResolveMeshFrameHeapSlots(context.frameBindings, cache.heapHandle.slot());
    const ShaderDrivenPushConstants meshPush = ECSRenderDetail::BuildShaderDrivenPushConstants(
        mesh.meshletCount,
        drawItem.instanceIndex,
        drawItem.materialConstantByteOffset,
        context.viewportState,
        slots,
        0u
    );
    const MeshComputePushConstants push{ .mesh = meshPush, .generatedIndexByteOffset = cache.indexByteOffset, };
    commandList.setPushConstants(&push, sizeof(push));
    {
        Core::GpuTimingMeasure timing(m_graphics.gpuTiming(), RendererGpuTimingScope::s_MeshDispatch, m_graphics.getDevice(), commandList);

        commandList.dispatch(ComputeObjectGeometryDecodeGroupCount(mesh.meshletCount));
    }
    return true;
}


