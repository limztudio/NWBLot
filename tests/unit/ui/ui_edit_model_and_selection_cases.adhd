void VerifyUiSingleLineText_NormalizedByteLimitsRejectWholeScalarsAndBreakPairs(){
    TestArena arena = TestArena();
    const Expected<String, EditTextStatusEnum> normalized1 = UiNormalizeSingleLineToString(arena, "a\r\nb", 3u);
    ASSERT_TRUE(normalized1.has_value());
    EXPECT_EQ(normalized1.value(), "a b");
    const Expected<String, EditTextStatusEnum> tooLarge1 = UiNormalizeSingleLineToString(arena, "\xED\x95\x9C", 2u);
    ASSERT_FALSE(tooLarge1.has_value());
    EXPECT_EQ(tooLarge1.error(), EditTextStatus::TooLarge);
    const Expected<String, EditTextStatusEnum> tooLarge2 = UiNormalizeSingleLineToString(arena, "\r\n\r\n", 1u);
    ASSERT_FALSE(tooLarge2.has_value());
    EXPECT_EQ(tooLarge2.error(), EditTextStatus::TooLarge);
    const Expected<String, EditTextStatusEnum> normalized2 = UiNormalizeSingleLineToString(arena, "", 0u);
    ASSERT_TRUE(normalized2.has_value());
    EXPECT_TRUE(normalized2.value().empty());
    UiKeepEditTestArenaAlive(arena);
}

void VerifyUiSingleLineText_RejectsMalformedUtf8NulAndUnrenderableAsciiControlsAtomically(){
    TestArena arena = TestArena();
    Array<StringView, 7u> invalid = Array<StringView, 7u>();
    invalid[0u] = "\xC0\xAF";
    invalid[1u] = "\xED\xA0\x80";
    invalid[2u] = "\xF4\x90\x80\x80";
    invalid[3u] = "\xE2\x82";
    invalid[4u] = "x\x1By";
    invalid[5u] = "\x7F";
    invalid[6u] = MakeUiEditEmbeddedNullView();
    for(in StringView value : invalid){
        const Expected<String, EditTextStatusEnum> result = UiNormalizeSingleLineToString(arena, value, 64u);
        ASSERT_FALSE(result.has_value());
        EXPECT_EQ(result.error(), EditTextStatus::InvalidText);
    }
    UiKeepEditTestArenaAlive(arena);
}

void VerifyUiSingleLineText_CopiesAliasedInputBeforePublishingOutput(){
    EXPECT_TRUE(VerifyUiSingleLineAliasedInputCopy());
}


