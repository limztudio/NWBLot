#include <tests/common/gtest_macros.adhd>
#include <tests/unit/task/cpu/suite.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyCpuTaskProfilingTests_ReadyAndExecutionEventsRetainTheirOwnFramesAndLabels(){
    const Name scopeName = s_CpuProfilingNameTestsCpuScope;
    const Name taskName = s_CpuProfilingNameTestsCpuTask;
    Vector<CpuTaskProfileEvent> events = Vector<CpuTaskProfileEvent>();
    u64 droppedEvents = 0u;
    native(in scopeName, in taskName, mut events, mut droppedEvents){
        CpuTaskScheduler scheduler(0u);
        const auto scopeLabel = scheduler.registerProfileLabel(scopeName);
        const auto taskLabel = scheduler.registerProfileLabel(taskName);
        CpuTaskScope scope(scheduler, scopeLabel);
        scheduler.setProfiling(true, 7u);
        const auto taskAdmission = scope.submit([]()noexcept { SleepMS(s_ProfilingPollIntervalMS); }, { .profileLabel = taskLabel });
        ASSERT_TRUE(taskAdmission);
        const auto task = *taskAdmission;
        ASSERT_TRUE(task.valid());
        const auto cpuTaskAdmission = scope.submit([]()noexcept { SleepMS(s_ProfilingPollIntervalMS); });
        ASSERT_TRUE(cpuTaskAdmission);
        if(cpuTaskAdmission)
            ASSERT_TRUE(cpuTaskAdmission->valid());
        SleepMS(s_ProfilingPollIntervalMS);
        scheduler.setProfiling(true, 8u);
        scheduler.wait(task);
        scope.wait();
        scheduler.wait();
        Array<CpuTaskProfileEvent, 16u> rawEvents{};
        const usize count = scheduler.readProfileEvents(rawEvents.data(), 16u);
        for(usize index = 0u; index < count; ++index)
            events.push_back(rawEvents[index]);
        droppedEvents = scheduler.statistics().profileDroppedEvents;
    }
    u32 queued = 0u;
    u32 executed = 0u;
    u32 handleJoins = 0u;
    u32 scopeJoins = 0u;
    u32 schedulerJoins = 0u;
    u64 epoch = 0u;
    for(in CpuTaskProfileEvent event : events){
        if(epoch == 0u){
            epoch = event.captureEpoch;
        }
        EXPECT_EQ(event.captureEpoch, epoch);
        EXPECT_EQ(event.workerIndex, 0u);
        // Ready and execution spans include sleeps while a completed join can finish in zero ticks.
        if(event.kind == CpuTaskProfileKind::QueueDelay){
            EXPECT_GT(event.durationNanoseconds, 0u);
            ++queued;
            EXPECT_EQ(event.frameIndex, 7u);
            EXPECT_TRUE(event.label == scopeName || event.label == taskName);
        }
        else{
            EXPECT_EQ(event.frameIndex, 8u);
            if(event.kind == CpuTaskProfileKind::Execution){
                EXPECT_GT(event.durationNanoseconds, 0u);
                ++executed;
                EXPECT_TRUE(event.label == scopeName || event.label == taskName);
            }
            else if(event.kind == CpuTaskProfileKind::HandleJoin){
                ++handleJoins;
                EXPECT_EQ(event.label, taskName);
            }
            else if(event.kind == CpuTaskProfileKind::ScopeJoin){
                ++scopeJoins;
                EXPECT_EQ(event.label, scopeName);
            }
            else if(event.kind == CpuTaskProfileKind::SchedulerJoin){
                ++schedulerJoins;
            }
        }
    }
    EXPECT_EQ(queued, 2u);
    EXPECT_EQ(executed, 2u);
    EXPECT_EQ(handleJoins, 1u);
    EXPECT_EQ(scopeJoins, 1u);
    EXPECT_EQ(schedulerJoins, 1u);
    EXPECT_EQ(droppedEvents, 0u);
}

void VerifyCpuTaskProfilingTests_RingBufferPreservesOrderAcrossPartialDrainsAndReportsOverflow(){
    CpuTaskSchedulerConfig config = CpuTaskSchedulerConfig();
    config.workerCount = 0u;
    config.profileEventCapacity = 4u;
    native(in config){
        CpuTaskScheduler scheduler(config);
        scheduler.setProfiling(true);
        const auto firstTaskAdmission = scheduler.submit([]()noexcept {});
        ASSERT_TRUE(firstTaskAdmission);
        const auto first = *firstTaskAdmission;
        ASSERT_TRUE(first.valid());
        scheduler.wait(first);
        Array<CpuTaskProfileEvent, 8u> events{};
        ASSERT_EQ(scheduler.readProfileEvents(events.data(), 2u), 2u);
        EXPECT_EQ(events[0u].kind, CpuTaskProfileKind::QueueDelay);
        EXPECT_EQ(events[1u].kind, CpuTaskProfileKind::Execution);
        const auto secondTaskAdmission = scheduler.submit([]()noexcept {});
        ASSERT_TRUE(secondTaskAdmission);
        const auto second = *secondTaskAdmission;
        ASSERT_TRUE(second.valid());
        scheduler.wait(second);
        ASSERT_EQ(scheduler.readProfileEvents(events.data(), 8u), 4u);
        EXPECT_EQ(events[0u].kind, CpuTaskProfileKind::HandleJoin);
        EXPECT_EQ(events[0u].task.generation, first.generation);
        EXPECT_EQ(events[1u].kind, CpuTaskProfileKind::QueueDelay);
        EXPECT_EQ(events[2u].kind, CpuTaskProfileKind::Execution);
        EXPECT_EQ(events[3u].kind, CpuTaskProfileKind::HandleJoin);
        EXPECT_EQ(events[3u].task.generation, second.generation);
        const auto thirdTaskAdmission = scheduler.submit([]()noexcept {});
        ASSERT_TRUE(thirdTaskAdmission);
        const auto third = *thirdTaskAdmission;
        ASSERT_TRUE(third.valid());
        scheduler.wait(third);
        scheduler.wait();
        scheduler.wait();
        EXPECT_EQ(scheduler.statistics().profilePendingEvents, 4u);
        EXPECT_EQ(scheduler.statistics().profileDroppedEvents, 1u);
        EXPECT_EQ(scheduler.readProfileEvents(nullptr, 4u), 0u);
        EXPECT_EQ(scheduler.readProfileEvents(events.data(), 0u), 0u);
        EXPECT_EQ(scheduler.readProfileEvents(events.data(), 8u), 4u);
        EXPECT_EQ(scheduler.readProfileEvents(events.data(), 8u), 0u);
    }
}

void VerifyCpuTaskProfilingTests_CaptureRestartRejectsOldReadyAndExecutingTimers(){
    CpuTaskHandle child = CpuTaskHandle();
    CpuTaskHandle parent = CpuTaskHandle();
    Vector<CpuTaskProfileEvent> events = Vector<CpuTaskProfileEvent>();
    usize afterDisableCount = 0u;
    b8 profileEnabledAfterDisable = true;
    native(mut child, mut parent, mut events, mut afterDisableCount, mut profileEnabledAfterDisable){
        CpuTaskScheduler scheduler(0u);
        scheduler.setProfiling(true, 1u);
        const auto cpuTaskAdmission = scheduler.submit([&]() {
            scheduler.setProfiling(false);
            scheduler.setProfiling(true, 2u);
            const auto childTaskAdmission = scheduler.submit([]()noexcept {});
            ASSERT_TRUE(childTaskAdmission);
            child = *childTaskAdmission;
            EXPECT_TRUE(child.valid());
        });
        ASSERT_TRUE(cpuTaskAdmission);
        parent = *cpuTaskAdmission;
        ASSERT_TRUE(parent.valid());
        const auto oldReadyTaskAdmission = scheduler.submit([]()noexcept {});
        ASSERT_TRUE(oldReadyTaskAdmission);
        const auto oldReady = *oldReadyTaskAdmission;
        ASSERT_TRUE(oldReady.valid());
        scheduler.wait(parent);
        Array<CpuTaskProfileEvent, 16u> rawEvents{};
        const usize count = scheduler.readProfileEvents(rawEvents.data(), 16u);
        for(usize index = 0u; index < count; ++index)
            events.push_back(rawEvents[index]);
        scheduler.setProfiling(false);
        afterDisableCount = scheduler.readProfileEvents(rawEvents.data(), 16u);
        profileEnabledAfterDisable = scheduler.statistics().profileEnabled;
    }
    u32 executed = 0u;
    u32 queued = 0u;
    for(in CpuTaskProfileEvent event : events){
        EXPECT_EQ(event.frameIndex, 2u);
        EXPECT_GT(event.captureEpoch, 1u);
        EXPECT_NE(event.task.index, parent.index);
        if(event.kind == CpuTaskProfileKind::Execution){
            ++executed;
        }
        if(event.kind == CpuTaskProfileKind::QueueDelay){
            ++queued;
            EXPECT_EQ(event.task.index, child.index);
        }
    }
    EXPECT_EQ(executed, 2u);
    EXPECT_EQ(queued, 1u);
    EXPECT_EQ(afterDisableCount, 0u);
    EXPECT_FALSE(profileEnabledAfterDisable);
}

void VerifyCpuTaskProfilingTests_ForeignLabelsDoNotAliasLocalNames(){
    const Name name = s_CpuProfilingNameTestsCpuLocalName;
    Vector<CpuTaskProfileEvent> events = Vector<CpuTaskProfileEvent>();
    u32 foreignValue = 0u;
    u32 localValue = 0u;
    native(in name, mut events, mut foreignValue, mut localValue){
        CpuTaskScheduler first(0u);
        CpuTaskScheduler second(0u);
        const auto foreign = first.registerProfileLabel(name);
        const auto local = second.registerProfileLabel(name);
        foreignValue = foreign.value;
        localValue = local.value;
        second.setProfiling(true);
        const auto taskAdmission = second.submit([]()noexcept {}, { .profileLabel = foreign });
        ASSERT_TRUE(taskAdmission);
        const auto task = *taskAdmission;
        ASSERT_TRUE(task.valid());
        second.wait(task);
        Array<CpuTaskProfileEvent, 8u> rawEvents{};
        const usize count = second.readProfileEvents(rawEvents.data(), 8u);
        for(usize index = 0u; index < count; ++index)
            events.push_back(rawEvents[index]);
    }
    EXPECT_NE(foreignValue, localValue);
    ASSERT_GT(events.size(), 0u);
    for(in CpuTaskProfileEvent event : events){
        EXPECT_EQ(event.label, s_NameNone);
    }
}

void VerifyCpuTaskProfilingTests_ZeroCapacityLeavesCaptureDisabled(){
    CpuTaskSchedulerConfig config = CpuTaskSchedulerConfig();
    config.workerCount = 0u;
    config.profileEventCapacity = 0u;
    b8 profileEnabled = true;
    usize pendingEvents = 1u;
    u64 droppedEvents = 1u;
    native(in config, mut profileEnabled, mut pendingEvents, mut droppedEvents){
        CpuTaskScheduler scheduler(config);
        scheduler.setProfiling(true);
        EXPECT_TRUE((scheduler.parallelFor(0u, 1u, [](usize)noexcept {})));
        const auto stats = scheduler.statistics();
        profileEnabled = stats.profileEnabled;
        pendingEvents = stats.profilePendingEvents;
        droppedEvents = stats.profileDroppedEvents;
    }
    EXPECT_FALSE(profileEnabled);
    EXPECT_EQ(pendingEvents, 0u);
    EXPECT_EQ(droppedEvents, 0u);
}

void VerifyCpuTaskProfilingTests_ConcurrentCaptureChangesDoNotAffectTaskCompletionOrMixBufferedEpochs(){
    CpuTaskSchedulerConfig config = CpuTaskSchedulerConfig();
    config.workerCount = 2u;
    config.heterogeneous = false;
    config.profileEventCapacity = 16u;
    Vector<CpuTaskProfileEvent> finalEvents = Vector<CpuTaskProfileEvent>();
    u64 completedTasks = 0u;
    usize outstandingTasks = 0u;
    native(in config, mut finalEvents, mut completedTasks, mut outstandingTasks){
        Atomic<b8> started{ false };
        Atomic<u32> callbacks{ 0u };
        CpuTaskScheduler scheduler(config);
        CpuTaskScope scope(scheduler);
        Thread capture([&]() {
            started.store(true, MemoryOrder::release);
            for(u64 frame = 1u; frame <= 64u; ++frame){
                scheduler.setProfiling(true, frame);
                SleepMS(s_ProfilingPollIntervalMS);
                scheduler.setProfiling(false);
            }
        });
        while(!started.load(MemoryOrder::acquire))
            SleepMS(s_ProfilingPollIntervalMS);
        for(u32 index = 0u; index < 256u; ++index){
            const auto cpuTaskAdmission = scope.submit([&]()noexcept {
                SleepMS(s_ProfilingPollIntervalMS);
                callbacks.fetch_add(1u, MemoryOrder::release);
            });
            EXPECT_TRUE(cpuTaskAdmission);
            if(cpuTaskAdmission)
                EXPECT_TRUE(cpuTaskAdmission->valid());
        }
        while(callbacks.load(MemoryOrder::acquire) != 256u){
            Array<CpuTaskProfileEvent, 8u> events{};
            const usize count = scheduler.readProfileEvents(events.data(), 8u);
            for(usize index = 0u; index < count; ++index){
                EXPECT_EQ(events[index].captureEpoch, events[0u].captureEpoch);
                EXPECT_GT(events[index].captureEpoch, 0u);
                if(events[index].task.valid())
                    EXPECT_EQ(events[index].task.domainIdentity, scheduler.domainIdentity());
            }
            SleepMS(s_ProfilingPollIntervalMS);
        }
        capture.join();
        scope.wait();
        completedTasks = scheduler.statistics().completedTasks;
        outstandingTasks = scheduler.statistics().outstandingTasks;
        scheduler.setProfiling(true, 1000u);
        const auto probeTaskAdmission = scheduler.submit([]()noexcept {});
        ASSERT_TRUE(probeTaskAdmission);
        const auto probe = *probeTaskAdmission;
        ASSERT_TRUE(probe.valid());
        scheduler.wait(probe);
        Array<CpuTaskProfileEvent, 16u> rawEvents{};
        const usize count = scheduler.readProfileEvents(rawEvents.data(), 16u);
        for(usize index = 0u; index < count; ++index)
            finalEvents.push_back(rawEvents[index]);
    }
    EXPECT_EQ(completedTasks, 256u);
    EXPECT_EQ(outstandingTasks, 0u);
    EXPECT_GT(finalEvents.size(), 0u);
    for(in CpuTaskProfileEvent event : finalEvents){
        EXPECT_EQ(event.frameIndex, 1000u);
    }
}

void VerifyCpuTaskProfilingTests_EmptyCompletedAndCanceledScopeJoinsRetainTheirProfileEvents(){
    const u64 frame = 19u;
    FixedVector<Name, 3> names = FixedVector<Name, 3>();
    names.push_back(s_CpuProfilingNameTestsCpuEmptyScope);
    names.push_back(s_CpuProfilingNameTestsCpuCompletedScope);
    names.push_back(s_CpuProfilingNameTestsCpuCanceledScope);
    Vector<CpuTaskProfileEvent> events = Vector<CpuTaskProfileEvent>();
    u32 canceledCallbacks = 0u;
    usize pendingEvents = 0u;
    native(in frame, in names, mut events, mut canceledCallbacks, mut pendingEvents){
        CpuTaskScheduler scheduler(0u);
        CpuTaskScope empty(scheduler, scheduler.registerProfileLabel(names[0u]));
        CpuTaskScope completed(scheduler, scheduler.registerProfileLabel(names[1u]));
        CpuTaskScope canceled(scheduler, scheduler.registerProfileLabel(names[2u]));
        const auto taskAdmission = completed.submit([]()noexcept {});
        ASSERT_TRUE(taskAdmission);
        const auto task = *taskAdmission;
        ASSERT_TRUE(task.valid());
        scheduler.wait(task);
        const auto cpuTaskAdmission = canceled.submit([&]()noexcept { ++canceledCallbacks; });
        ASSERT_TRUE(cpuTaskAdmission);
        if(cpuTaskAdmission)
            ASSERT_TRUE(cpuTaskAdmission->valid());
        canceled.cancel();
        canceled.wait();

        scheduler.setProfiling(true, frame);
        empty.wait();
        completed.wait();
        canceled.wait();
        Array<CpuTaskProfileEvent, 3u> rawEvents{};
        ASSERT_EQ(scheduler.readProfileEvents(rawEvents.data(), 3u), 3u);
        for(usize index = 0u; index < 3u; ++index)
            events.push_back(rawEvents[index]);
        pendingEvents = scheduler.statistics().profilePendingEvents;
        scheduler.setProfiling(false);
    }
    EXPECT_EQ(canceledCallbacks, 0u);
    ASSERT_EQ(events.size(), 3u);
    for(usize index = 0u; index < 3u; ++index){
        EXPECT_EQ(events[index].kind, CpuTaskProfileKind::ScopeJoin);
        EXPECT_EQ(events[index].label, names[index]);
        EXPECT_EQ(events[index].frameIndex, frame);
    }
    EXPECT_EQ(pendingEvents, 0u);
}



////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_ADHD_GTEST(CpuTaskProfilingTests, ReadyAndExecutionEventsRetainTheirOwnFramesAndLabels, VerifyCpuTaskProfilingTests_ReadyAndExecutionEventsRetainTheirOwnFramesAndLabels)
NWB_ADHD_GTEST(CpuTaskProfilingTests, RingBufferPreservesOrderAcrossPartialDrainsAndReportsOverflow, VerifyCpuTaskProfilingTests_RingBufferPreservesOrderAcrossPartialDrainsAndReportsOverflow)
NWB_ADHD_GTEST(CpuTaskProfilingTests, CaptureRestartRejectsOldReadyAndExecutingTimers, VerifyCpuTaskProfilingTests_CaptureRestartRejectsOldReadyAndExecutingTimers)
NWB_ADHD_GTEST(CpuTaskProfilingTests, ForeignLabelsDoNotAliasLocalNames, VerifyCpuTaskProfilingTests_ForeignLabelsDoNotAliasLocalNames)
NWB_ADHD_GTEST(CpuTaskProfilingTests, ZeroCapacityLeavesCaptureDisabled, VerifyCpuTaskProfilingTests_ZeroCapacityLeavesCaptureDisabled)
NWB_ADHD_GTEST(CpuTaskProfilingTests, ConcurrentCaptureChangesDoNotAffectTaskCompletionOrMixBufferedEpochs, VerifyCpuTaskProfilingTests_ConcurrentCaptureChangesDoNotAffectTaskCompletionOrMixBufferedEpochs)
NWB_ADHD_GTEST(CpuTaskProfilingTests, EmptyCompletedAndCanceledScopeJoinsRetainTheirProfileEvents, VerifyCpuTaskProfilingTests_EmptyCompletedAndCanceledScopeJoinsRetainTheirProfileEvents)


