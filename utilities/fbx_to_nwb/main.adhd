////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <utilities/fbx_to_nwb/module.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 ShouldPauseAfterPromptedRun(in b8 prompted, in i32 exitResult){
    return prompted && exitResult >= s_PromptSuccessThreshold;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <logger/client/module.h>

#include <core/common/application_entry.h>

#include <global/cpu_topology.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace __hidden_fbx_to_nwb_main{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


static i32 Run(const i32 argc, char** argv){
    const u32 coreCount = ::QueryCpuCoreCount(CpuAffinity::Any);
    const u32 workerCount = NWB::FbxToNwb::ComputeWorkerCount(coreCount);
    NWB::Core::CpuTaskScheduler cpuScheduler(workerCount);
    NWB::Core::Alloc::ScratchArena scratchArena(NWB::FbxToNwb::s_UtilityScratch);

    b8 prompted = false;
    const i32 result = NWB::FbxToNwb::Run(argc, argv, cpuScheduler, scratchArena, prompted);
    cpuScheduler.wait();
    if(NWB::FbxToNwb::ShouldPauseAfterPromptedRun(prompted, result)){
        NWB_COUT << "Press Enter to exit...";
        NWB::FbxToNwb::ScratchString line(scratchArena);
        if(!ReadTextLine(NWB_CIN, line))
            NWB_COUT << "\n";
    }
    return result;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_DEFINE_CONSOLE_TOOL_ENTRY_POINT(NWB::Log::ClientStandalone, NWB_TEXT("fbx_to_nwb"), NWB::FbxToNwb::s_FbxToNwbEntryFailure, __hidden_fbx_to_nwb_main::Run)


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

