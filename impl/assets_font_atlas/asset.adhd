#include <impl/assets_font_atlas/model.adhd>
#include <impl/assets_font_atlas/binary_glyph_reader.adhd>
#include <impl/assets_font_atlas/positioning_validation.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[asset("font_atlas")]
class FontAtlas{
    private FontAtlasPayload m_payload;

    public b8 loadBinary(in Span<u8> binary);
    public b8 validatePayload(mut ScratchArena scratchArena)const;
    public void setPayload(in FontAtlasPayload payload){
        this.m_payload = payload;
    }

    public in FontAtlasPayload payload()const{ return this.m_payload; }

    public b8 tryGlyph(in u32 glyphId, mut FontAtlasGlyph outGlyph)const{
        if(cast<usize>(glyphId) >= this.m_payload.glyphs.size())
            return false;
        outGlyph = this.m_payload.glyphs[glyphId];
        return true;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[header]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <core/alloc/scratch.h>
#include <core/assets/ref.h>

#include <global/sha256.h>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_BEGIN


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


inline constexpr TStringView s_FontAtlasValidatePayloadContext = FOUNDATION_TEXT("FontAtlas::validatePayload");

[[nodiscard]] b8 ValidateFontAtlasPayload(const FontAtlasPayload& payload, Core::Alloc::ScratchArena& scratchArena);
[[nodiscard]] b8 ValidateFontAtlasSourceMatch(const FontAtlasPayload& payload, const Font& font);
[[nodiscard]] Expected<Vector<FontAtlasPositioningTable, ::ArenaBase>> CopyFontAtlasPositioningTables(Span<const u8> fontBytes, u32 faceIndex, u32 sourceGlyphCount, ::ArenaBase& arena);
[[nodiscard]] Expected<Core::Assets::AssetBytes> SerializeFontAtlasPayload(const FontAtlasPayload& payload, Core::Assets::AssetArena& arena, Core::Alloc::ScratchArena& scratchArena);
[[nodiscard]] Expected<FontAtlasPayload> DeserializeFontAtlasPayload(Span<const u8> binary, ::ArenaBase& arena, Core::Alloc::ScratchArena& scratchArena);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


NWB_IMPL_END


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


}


