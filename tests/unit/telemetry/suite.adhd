struct OwnedAllocation{
    Core::Alloc::GlobalArena* arena = nullptr;
    void* pointer = nullptr;
    usize requestedBytes = 0u;


public:
    OwnedAllocation()noexcept = default;
    OwnedAllocation(Core::Alloc::GlobalArena& owner, const usize size)noexcept
        : arena(&owner)
        , pointer(owner.allocate(1u, size))
        , requestedBytes(size)
    {}
    OwnedAllocation(const OwnedAllocation&) = delete;
    OwnedAllocation& operator=(const OwnedAllocation&) = delete;
    OwnedAllocation(OwnedAllocation&& other)noexcept
        : arena(other.arena)
        , pointer(other.pointer)
        , requestedBytes(other.requestedBytes)
    {
        other.arena = nullptr;
        other.pointer = nullptr;
        other.requestedBytes = 0u;
    }
    OwnedAllocation& operator=(OwnedAllocation&& other)noexcept{
        if(this != &other){
            releaseNow();
            arena = other.arena;
            pointer = other.pointer;
            requestedBytes = other.requestedBytes;
            other.arena = nullptr;
            other.pointer = nullptr;
            other.requestedBytes = 0u;
        }
        return *this;
    }
    ~OwnedAllocation()noexcept{
        releaseNow();
    }

    [[nodiscard]] b8 valid()const noexcept{ return pointer != nullptr; }
    [[nodiscard]] u64 usableBytes()const noexcept{ return pointer ? static_cast<u64>(Core::Alloc::CoreMsize(pointer)) : 0u; }

    b8 resizeTo(const usize newBytes)noexcept{
        if(!arena)
            return false;
        void* const resized = arena->reallocate(pointer, 1u, newBytes);
        if(!resized)
            return false;
        pointer = resized;
        requestedBytes = newBytes;
        return true;
    }

    void releaseNow()noexcept{
        if(pointer && arena){
            arena->deallocate(pointer, 1u, requestedBytes);
            pointer = nullptr;
        }
    }
};

[[nodiscard]] u64 NextAllocationOwnerSequence()noexcept;

[[nodiscard]] const Telemetry::EventRecord* FindOwnerEvent(const Telemetry::EventView& events, const Name& owner, Core::Perf::MemorySource::Enum source)noexcept;

[[nodiscard]] AStringView FindOwnerJsonRecord(AStringView json, const Name& owner, AStringView sourceField);


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


