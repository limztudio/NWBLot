////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


native{
#include <core/graphics/rhi/command.h>
#include <core/graphics/rhi/resource.h>
namespace NWB::Core::ResourceQueueSharing{
using QueueClass = CommandQueue::Enum;
using SharingMask = ResourceQueueSharing::Mask;
constexpr QueueClass s_ClassGraphics = CommandQueue::Graphics;
constexpr QueueClass s_ClassCompute = CommandQueue::Compute;
constexpr QueueClass s_ClassTransfer = CommandQueue::Transfer;
constexpr SharingMask s_SharingExclusive = ResourceQueueSharing::Exclusive;
constexpr SharingMask s_SharingGraphics = ResourceQueueSharing::Graphics;
constexpr SharingMask s_SharingCompute = ResourceQueueSharing::AsyncCompute;
constexpr SharingMask s_SharingTransfer = ResourceQueueSharing::Transfer;
}
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


SharingMask ForQueueClass(in QueueClass queueClass){
    switch(queueClass){
    case s_ClassGraphics: return s_SharingGraphics;
    case s_ClassCompute: return s_SharingCompute;
    case s_ClassTransfer: return s_SharingTransfer;
    default: return s_SharingExclusive;
    }
}

b8 IncludesQueueClass(in SharingMask sharing, in QueueClass queueClass){
    const SharingMask queueBit = ForQueueClass(queueClass);
    if(queueBit == s_SharingExclusive)
        return false;
    return (cast<u8>(sharing) & cast<u8>(queueBit)) != cast<u8>(s_SharingExclusive);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

