    }
}

void VerifyRefractionStatistics_RingSaturationDoesNotRecycleOutstandingGpuWork(){
    RefractionStatsContext context = RefractionStatsContext();
    ASSERT_TRUE(context.valid());
    const StatisticsReservationKey first = context.reserve(MakeRefractionStatisticsMetadata());
    const StatisticsReservationKey second = context.reserve(MakeRefractionStatisticsMetadata());
    const StatisticsReservationKey third = context.reserve(MakeRefractionStatisticsMetadata());
    ASSERT_TRUE(first.valid());
    ASSERT_TRUE(second.valid());
    ASSERT_TRUE(third.valid());
    EXPECT_NE(first.slot, second.slot);
    EXPECT_NE(first.slot, third.slot);
    EXPECT_NE(second.slot, third.slot);
    context.accept(first, Token(), true);
    context.discard(first);
    EXPECT_FALSE(context.reserve(MakeRefractionStatisticsMetadata()).valid());
    context.discard(second);
    const StatisticsReservationKey reused = context.reserve(MakeRefractionStatisticsMetadataAt(10u));
    EXPECT_EQ(reused.slot, second.slot);
    EXPECT_GT(reused.sequence, second.sequence);
    EXPECT_FALSE(context.reserve(MakeRefractionStatisticsMetadata()).valid());
}

void VerifyRefractionStatistics_CompletionRequiresExactAcceptedPhysicalToken(){
    RefractionStatsContext context = RefractionStatsContext();
    ASSERT_TRUE(context.valid());
    const StatisticsReservationKey key = context.reserve(MakeRefractionStatisticsMetadata());
    context.accept(key, Token(), true);
    const RefractionCounterArray counters = RefractionCounterArray();
    QueueSubmissionToken wrong = Token();
    wrong.physicalQueueIndex = 1u;
    context.complete(key, wrong, counters);
    wrong = Token();
    wrong.deviceGeneration = 8u;
    context.complete(key, wrong, counters);
    wrong = Token();
    wrong.queue = CommandQueue::Compute;
    context.complete(key, wrong, counters);
    context.complete(key, Token(19u), counters);
    context.complete(key, QueueSubmissionToken(), counters);
    EXPECT_FALSE(context.tryGetLatestStatistics().has_value());
    EXPECT_TRUE(context.pending(key.slot).has_value());
    context.complete(key, Token(), counters);
    const Expected<RefractionStatistics> statistics = context.tryGetLatestStatistics();
    ASSERT_TRUE(statistics.has_value());
    EXPECT_EQ(statistics.value().acceptedToken.value, Token().value);
    EXPECT_EQ(statistics.value().acceptedToken.physicalQueueIndex, 0u);
    EXPECT_FALSE(context.pending(key.slot).has_value());
}

void VerifyRefractionStatistics_OlderCompletionsCannotReplaceFrozenNewerPublication(){
    RefractionStatsContext context = RefractionStatsContext();
    ASSERT_TRUE(context.valid());
    RefractionStatistics metadata = MakeRefractionStatisticsMetadataAt(10u);
    const StatisticsReservationKey older = context.reserve(metadata);
    metadata.frameIndex = 11u;
    metadata.graphicsFrameIndex = 111u;
    const StatisticsReservationKey newer = context.reserve(metadata);
    metadata.frameIndex = 999u;
    metadata.width = 1u;
    context.accept(older, Token(20u), true);
    context.accept(newer, Token(21u), false);
    const RefractionCounterArray counters = MakeSampleRefractionCounters();
    context.complete(newer, Token(21u), counters);
    const RefractionCounterArray olderCounters = RefractionCounterArray();
    context.complete(older, Token(20u), olderCounters);
    const Expected<RefractionStatistics> statistics = context.tryGetLatestStatistics();
    ASSERT_TRUE(statistics.has_value());
    EXPECT_EQ(statistics.value().sequence, newer.sequence);
    EXPECT_EQ(statistics.value().frameIndex, 11u);
    EXPECT_EQ(statistics.value().graphicsFrameIndex, 111u);
    EXPECT_EQ(statistics.value().width, 320u);
    EXPECT_EQ(statistics.value().height, 180u);
    EXPECT_FALSE(statistics.value().hardwareReady);
    EXPECT_FALSE(statistics.value().csgHardwareEnabled);
    EXPECT_EQ(statistics.value().hardwarePixels, 23u);
    EXPECT_EQ(statistics.value().entryQueries, 41u);
    EXPECT_EQ(statistics.value().exitQueries, 43u);
    EXPECT_EQ(statistics.value().backgroundQueries, 47u);
    EXPECT_EQ(statistics.value().physicalQueries, 103u);
    EXPECT_EQ(statistics.value().queryBudgetUnits, 107u);
    EXPECT_EQ(statistics.value().overflowFlags, 1u);
    ExpectRefractionDiagnosticCountersMatch(statistics.value(), counters);
    EXPECT_EQ(context.reserve(MakeRefractionStatisticsMetadata()).slot, older.slot);
}

void VerifyRefractionStatistics_DeviceResetRejectsStaleAcceptanceAndCompletion(){
    RefractionStatsContext context = RefractionStatsContext();
    ASSERT_TRUE(context.valid());
    const StatisticsReservationKey previous = context.reserve(MakeRefractionStatisticsMetadata());
    context.accept(previous, Token(), true);
    const RefractionCounterArray counters = RefractionCounterArray();
    context.complete(previous, Token(), counters);
    context.reset(0u);
    EXPECT_FALSE(context.tryGetLatestStatistics().has_value());
    EXPECT_FALSE(context.reserve(MakeRefractionStatisticsMetadata()).valid());
    context.reset(8u);
    const StatisticsReservationKey current = context.reserve(MakeRefractionStatisticsMetadataAt(12u));
    ASSERT_TRUE(current.valid());
    EXPECT_GT(current.generation, previous.generation);
    context.accept(previous, Token(), true);
    context.discard(previous);
    context.complete(previous, Token(), counters);
    EXPECT_FALSE(context.tryGetLatestStatistics().has_value());
    QueueSubmissionToken next = Token(1u);
    next.deviceGeneration = 8u;
    context.accept(current, next, true);
    context.complete(current, next, counters);
    const Expected<RefractionStatistics> statistics = context.tryGetLatestStatistics();
    ASSERT_TRUE(statistics.has_value());
    EXPECT_EQ(statistics.value().frameIndex, 12u);
    EXPECT_EQ(statistics.value().acceptedToken.deviceGeneration, 8u);
    EXPECT_TRUE(statistics.value().hardwareReady);
    EXPECT_TRUE(statistics.value().csgHardwareEnabled);
}

void VerifyRefractionStatistics_FailedMappingRetiresSlotWithoutReplacingPublication(){
    RefractionStatsContext context = RefractionStatsContext();
    ASSERT_TRUE(context.valid());
    const StatisticsReservationKey first = context.reserve(MakeRefractionStatisticsMetadata());
    context.accept(first, Token(), true);
    const RefractionCounterArray counters = RefractionCounterArray();
    context.complete(first, Token(), counters);
    const StatisticsReservationKey failed = context.reserve(MakeRefractionStatisticsMetadataAt(10u));
    context.accept(failed, Token(21u), true);
    context.completeEmpty(failed, Token(21u));
    const Expected<RefractionStatistics> statistics = context.tryGetLatestStatistics();
    ASSERT_TRUE(statistics.has_value());
    EXPECT_EQ(statistics.value().sequence, first.sequence);
    EXPECT_EQ(context.reserve(MakeRefractionStatisticsMetadata()).slot, failed.slot);
}

void VerifyRenderableMeshResolution_StaticAttachmentWithoutAssetIsUnavailable(){
    PruneContext context = PruneContext();
    native(mut context){
        auto entity = context.world.createEntity();
        auto& mesh = entity.addComponent<Impl::MeshComponent>();
        const auto unavailable = context.meshSystem.resolveRenderableMeshStatus(entity.id());
        ASSERT_FALSE(unavailable);
        EXPECT_EQ(unavailable.error(), RenderableMeshResolution::Unavailable);
        mesh.mesh = Core::Assets::AssetRef<Impl::Mesh>("tests/runtime_mesh_pruning/static_attachment");
        const auto description = context.meshSystem.resolveRenderableMeshStatus(entity.id());
        ASSERT_TRUE(description);
    }
}

