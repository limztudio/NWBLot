void VerifyTextInput_BeginRequiresFocusCapabilityAndOnlyOneActiveSession(){
    FakeTextInputContext ctx = FakeTextInputContext();
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> unavailableBegin = ctx.service.begin(MakeEmptySessionDesc());
    ASSERT_FALSE(unavailableBegin.has_value());
    EXPECT_EQ(unavailableBegin.error(), TextInputAdmission::Unavailable);
    ASSERT_TRUE(ctx.service.setFocused(true));
    ctx.service.m_supported = false;
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> unsupportedBegin = ctx.service.begin(MakeEmptySessionDesc());
    ASSERT_FALSE(unsupportedBegin.has_value());
    EXPECT_EQ(unsupportedBegin.error(), TextInputAdmission::Unsupported);
    ctx.service.m_supported = true;
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> first = ctx.service.begin(MakeEmptySessionDesc());
    ASSERT_TRUE(first.has_value());
    ASSERT_TRUE(first.value().valid());
    EXPECT_EQ(ctx.service.activeSession(), first.value());
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> busyBegin = ctx.service.begin(MakeEmptySessionDesc());
    ASSERT_FALSE(busyBegin.has_value());
    EXPECT_EQ(busyBegin.error(), TextInputAdmission::Busy);
    ASSERT_TRUE(ctx.service.end(first.value()));
    EXPECT_FALSE(ctx.service.activeSession().valid());
}

void VerifyTextInput_InputsAndPolledEventsOwnCopiedUtf8Bytes(){
    FakeTextInputContext ctx = FakeTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    AssignGlobalString(ctx.scratch, "A\xED\x95\x9C\xF0\x9F\x98\x80");
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> tokenAdmission = ctx.service.begin(MakeSessionDesc(ViewGlobalString(ctx.scratch), 1u, 4u));
    ASSERT_TRUE(tokenAdmission.has_value());
    const TextInputSessionToken token = tokenAdmission.value();
    ASSERT_TRUE(token.valid());
    AssignGlobalString(ctx.scratch, "changed caller input");
    EXPECT_EQ(ctx.service.surroundingText(), "A\xED\x95\x9C\xF0\x9F\x98\x80");
    EXPECT_EQ(ctx.service.m_nativeSurrounding, ctx.service.surroundingText());
    AssignGlobalString(ctx.secondScratch, "\xED\x95\x9C\xF0\x9F\x98\x80");
    ASSERT_EQ(ctx.service.emitCommit(token, ViewGlobalString(ctx.secondScratch)), TextInputAdmission::Accepted);
    AssignGlobalString(ctx.secondScratch, "changed event input");
    ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
    EXPECT_EQ(ctx.event.text, "\xED\x95\x9C\xF0\x9F\x98\x80");
    EXPECT_EQ(ctx.event.token, token);
    EXPECT_EQ(ctx.event.kind, TextInputEventKind::Commit);
    ASSERT_EQ(ctx.service.emitCommit(token, "next"), TextInputAdmission::Accepted);
    EXPECT_EQ(ctx.event.text, "\xED\x95\x9C\xF0\x9F\x98\x80");
}

void VerifyTextInput_EndRejectsLateEventsForeignTokensAndReusedGenerations(){
    FakeTextInputContext ctx = FakeTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    ASSERT_TRUE(ctx.foreign.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> oldAdmission = ctx.service.begin(MakeEmptySessionDesc());
    ASSERT_TRUE(oldAdmission.has_value());
    const TextInputSessionToken old = oldAdmission.value();
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> otherAdmission = ctx.foreign.begin(MakeEmptySessionDesc());
    ASSERT_TRUE(otherAdmission.has_value());
    const TextInputSessionToken other = otherAdmission.value();
    ASSERT_EQ(ctx.service.emitCommit(old, "queued"), TextInputAdmission::Accepted);
    ASSERT_TRUE(ctx.service.end(old));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> currentAdmission = ctx.service.begin(MakeEmptySessionDesc());
    ASSERT_TRUE(currentAdmission.has_value());
    const TextInputSessionToken current = currentAdmission.value();
    ASSERT_TRUE(current.valid());
    EXPECT_NE(old.generation, current.generation);
    EXPECT_NE(other.service, current.service);
    EXPECT_EQ(ctx.service.poll(old, ctx.event), TextInputPollResult::InvalidSession);
    EXPECT_EQ(ctx.service.poll(other, ctx.event), TextInputPollResult::InvalidSession);
    EXPECT_EQ(ctx.service.emitCommit(old, "late"), TextInputAdmission::InvalidSession);
    EXPECT_EQ(ctx.service.emitCommit(other, "foreign"), TextInputAdmission::InvalidSession);
    EXPECT_FALSE(ctx.service.end(old));
    EXPECT_EQ(ctx.service.poll(current, ctx.event), TextInputPollResult::Pending);
}

void VerifyTextInput_FocusLossReplacesQueuedWorkWithOneTerminalCancellation(){
    FakeTextInputContext ctx = FakeTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> tokenAdmission = ctx.service.begin(MakeEmptySessionDesc());
    ASSERT_TRUE(tokenAdmission.has_value());
    const TextInputSessionToken token = tokenAdmission.value();
    ASSERT_EQ(ctx.service.emitCommit(token, "unconsumed"), TextInputAdmission::Accepted);
    ASSERT_EQ(ctx.service.emitPreedit(token, "draft", 5u, 5u), TextInputAdmission::Accepted);
    ASSERT_TRUE(ctx.service.setFocused(false));
    EXPECT_FALSE(ctx.service.activeSession().valid());
    EXPECT_EQ(ctx.service.m_endCount, 1u);
    EXPECT_EQ(ctx.service.emitCommit(token, "stale"), TextInputAdmission::InvalidSession);
    ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
    EXPECT_EQ(ctx.event.kind, TextInputEventKind::Cancelled);
    EXPECT_EQ(ctx.event.cancelReason, TextInputCancelReason::FocusLost);
    EXPECT_TRUE(ctx.event.text.empty());
    EXPECT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::InvalidSession);
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> unavailableBegin = ctx.service.begin(MakeEmptySessionDesc());
    ASSERT_FALSE(unavailableBegin.has_value());
    EXPECT_EQ(unavailableBegin.error(), TextInputAdmission::Unavailable);
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> resumed = ctx.service.begin(MakeEmptySessionDesc());
    ASSERT_TRUE(resumed.has_value());
    EXPECT_TRUE(resumed.value().valid());
}

void VerifyTextInput_NewSessionInvalidatesUnpolledCancellation(){
    FakeTextInputContext ctx = FakeTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> oldAdmission = ctx.service.begin(MakeEmptySessionDesc());
    ASSERT_TRUE(oldAdmission.has_value());
    const TextInputSessionToken old = oldAdmission.value();
    ASSERT_TRUE(ctx.service.cancelSession(old, TextInputCancelReason::NativeCancelled));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> currentAdmission = ctx.service.begin(MakeEmptySessionDesc());
    ASSERT_TRUE(currentAdmission.has_value());
    const TextInputSessionToken current = currentAdmission.value();
    EXPECT_EQ(ctx.service.poll(old, ctx.event), TextInputPollResult::InvalidSession);
    EXPECT_EQ(ctx.service.poll(current, ctx.event), TextInputPollResult::Pending);
}

void VerifyTextInput_ConsecutivePreeditCoalescesWithoutCrossingCommitOrDeletion(){
    FakeTextInputContext ctx = FakeTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> tokenAdmission = ctx.service.begin(MakeSessionDesc("abc", 1u, 1u));
    ASSERT_TRUE(tokenAdmission.has_value());
    const TextInputSessionToken token = tokenAdmission.value();
    const u64 revision = ctx.service.surroundingRevision(token);
    ASSERT_EQ(ctx.service.emitPreedit(token, "draft", 5u, 5u), TextInputAdmission::Accepted);
    ASSERT_EQ(ctx.service.emitPreedit(token, "final draft", 11u, 11u, false), TextInputAdmission::Accepted);
    ASSERT_EQ(ctx.service.emitCommit(token, "committed"), TextInputAdmission::Accepted);
    ASSERT_EQ(ctx.service.emitPreedit(token, "new", 3u, 3u), TextInputAdmission::Accepted);
    ASSERT_EQ(ctx.service.emitDeleteSurrounding(token, 1u, 1u, revision, TextInputDeletionBasis::Caret), TextInputAdmission::Accepted);
    ASSERT_EQ(ctx.service.emitPreedit(token, "last", 4u, 4u), TextInputAdmission::Accepted);
    ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
    EXPECT_EQ(ctx.event.text, "final draft");
    EXPECT_FALSE(ctx.event.caretVisible);
    u64 lastSequence = ctx.event.sequence;
    ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
    EXPECT_EQ(ctx.event.kind, TextInputEventKind::Commit);
    EXPECT_EQ(ctx.event.text, "committed");
    EXPECT_GT(ctx.event.sequence, lastSequence);
    lastSequence = ctx.event.sequence;
    ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
    EXPECT_EQ(ctx.event.text, "new");
    EXPECT_GT(ctx.event.sequence, lastSequence);
    ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
    EXPECT_EQ(ctx.event.kind, TextInputEventKind::DeleteSurrounding);
    EXPECT_EQ(ctx.event.deleteBeforeBytes, 1u);
    EXPECT_EQ(ctx.event.deleteAfterBytes, 1u);
    ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
    EXPECT_EQ(ctx.event.text, "last");
    EXPECT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Pending);
}

void VerifyTextInput_QueueOverflowCancelsInsteadOfApplyingPartialCommittedText(){
    FakeTextInputContext ctx = FakeTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> tokenAdmission = ctx.service.begin(MakeEmptySessionDesc());
    ASSERT_TRUE(tokenAdmission.has_value());
    const TextInputSessionToken token = tokenAdmission.value();
    for(usize index = 0u; index < s_TextInputMaxEvents; ++index){
        ASSERT_EQ(ctx.service.emitCommit(token, "x"), TextInputAdmission::Accepted);
    }
    EXPECT_EQ(ctx.service.emitCommit(token, "overflow"), TextInputAdmission::QueueFull);
    EXPECT_FALSE(ctx.service.activeSession().valid());
    ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
    EXPECT_EQ(ctx.event.kind, TextInputEventKind::Cancelled);
    EXPECT_EQ(ctx.event.cancelReason, TextInputCancelReason::Overflow);
    EXPECT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::InvalidSession);
}

void VerifyTextInput_QueuedByteBudgetCancelsEvenBelowEventCountLimit(){
    FakeTextInputContext ctx = FakeTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> tokenAdmission = ctx.service.begin(MakeEmptySessionDesc());
    ASSERT_TRUE(tokenAdmission.has_value());
    const TextInputSessionToken token = tokenAdmission.value();
    FillGlobalString(ctx.scratch, s_TextInputMaxEventTextBytes, 0x78u);
    for(usize index = 0u; index < s_TextInputMaxQueuedTextBytes / ctx.scratch.size(); ++index){
        ASSERT_EQ(ctx.service.emitCommit(token, ViewGlobalString(ctx.scratch)), TextInputAdmission::Accepted);
    }
    EXPECT_EQ(ctx.service.emitCommit(token, "x"), TextInputAdmission::QueueFull);
    ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
    EXPECT_EQ(ctx.event.cancelReason, TextInputCancelReason::Overflow);
}

void VerifyTextInput_InvalidUpdatesAreAtomicAndDeleteOffsetsRequireUtf8BoundariesAndRevision(){
    FakeTextInputContext ctx = FakeTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const StringView initialText = "\x41\xED\x95\x9C\x42";
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> tokenAdmission = ctx.service.begin(MakeSessionDesc(initialText, 4u, 4u));
    ASSERT_TRUE(tokenAdmission.has_value());
    const TextInputSessionToken token = tokenAdmission.value();
    ASSERT_TRUE(token.valid());
    EXPECT_EQ(ctx.service.updateSurrounding(token, "bad\xF0\x9F", 0u, 0u), TextInputAdmission::InvalidText);
    EXPECT_EQ(ctx.service.updateSurrounding(token, "\xED\x95\x9C", 1u, 3u), TextInputAdmission::InvalidRange);
    EXPECT_EQ(ctx.service.surroundingText(), initialText);
    EXPECT_EQ(ctx.service.surroundingCaretByte(), 4u);
    EXPECT_EQ(ctx.service.surroundingRevision(token), 1u);
    const u64 revision = ctx.service.surroundingRevision(token);
    EXPECT_EQ(ctx.service.updateCaret(token, MakeTextInputRect(0, 0, 0, 1)), TextInputAdmission::InvalidRange);
    EXPECT_EQ(ctx.service.caretRect().width, 1);
    EXPECT_EQ(ctx.service.emitDeleteSurrounding(token, 1u, 0u, revision, TextInputDeletionBasis::Caret), TextInputAdmission::InvalidRange);
    EXPECT_EQ(ctx.service.emitDeleteSurrounding(token, 5u, 0u, revision, TextInputDeletionBasis::Caret), TextInputAdmission::InvalidRange);
    EXPECT_EQ(ctx.service.emitDeleteSurrounding(token, 0u, 2u, revision, TextInputDeletionBasis::Caret), TextInputAdmission::InvalidRange);
    ASSERT_EQ(ctx.service.emitDeleteSurrounding(token, 3u, 1u, revision, TextInputDeletionBasis::Caret), TextInputAdmission::Accepted);
    ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
    EXPECT_EQ(ctx.event.surroundingRevision, 1u);
    ASSERT_EQ(ctx.service.updateSurrounding(token, "updated", 0u, 0u), TextInputAdmission::Accepted);
    EXPECT_EQ(ctx.service.surroundingRevision(token), 2u);
    const u64 currentRevision = ctx.service.surroundingRevision(token);
    EXPECT_EQ(ctx.service.emitDeleteSurrounding(token, 0u, 1u, revision, TextInputDeletionBasis::Caret), TextInputAdmission::InvalidRange);
    EXPECT_EQ(ctx.service.emitDeleteSurrounding(token, 0u, 1u, currentRevision, TextInputDeletionBasis::Caret), TextInputAdmission::Accepted);
}

void VerifyTextInput_MalformedNativeTextAndPreeditSelectionsCannotEnterQueue(){
    FakeTextInputContext ctx = FakeTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> tokenAdmission = ctx.service.begin(MakeEmptySessionDesc());
    ASSERT_TRUE(tokenAdmission.has_value());
    const TextInputSessionToken token = tokenAdmission.value();
    EXPECT_EQ(ctx.service.emitCommit(token, StringView("a\0b", 3u)), TextInputAdmission::InvalidText);
    EXPECT_EQ(ctx.service.emitPreedit(token, "\xED\x95\x9C", 1u, 3u), TextInputAdmission::InvalidRange);
    FillGlobalString(ctx.scratch, s_TextInputMaxEventTextBytes + 1u, 0x78u);
    EXPECT_EQ(ctx.service.emitCommit(token, ViewGlobalString(ctx.scratch)), TextInputAdmission::TooLarge);
    EXPECT_EQ(ctx.service.activeSession(), token);
    EXPECT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Pending);
}

void VerifyTextInput_CancellationInvalidatesBeforeNativeCleanupAndRejectsReentry(){
    FakeTextInputContext ctx = FakeTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> tokenAdmission = ctx.service.begin(MakeEmptySessionDesc());
    ASSERT_TRUE(tokenAdmission.has_value());
    const TextInputSessionToken token = tokenAdmission.value();
    native(mut ctx, in token){
        ctx.service.m_onEnd = [&](const TextInputSessionToken ended) {
            EXPECT_EQ(ended, token);
            EXPECT_EQ(ctx.service.emitCommit(ended, "reentrant late"), TextInputAdmission::InvalidSession);
            const auto busyBegin = ctx.service.begin({});
            ASSERT_FALSE(busyBegin);
            EXPECT_EQ(busyBegin.error(), TextInputAdmission::Busy);
            EXPECT_FALSE(ctx.service.end(ended));
        };
        ASSERT_NO_FATAL_FAILURE(ASSERT_TRUE(ctx.service.cancelSession(token, TextInputCancelReason::NativeCancelled)));
        ctx.service.m_onEnd = {};
    }
    EXPECT_EQ(ctx.service.m_endCount, 1u);
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> resumed = ctx.service.begin(MakeEmptySessionDesc());
    ASSERT_TRUE(resumed.has_value());
    ASSERT_TRUE(resumed.value().valid());
}

void VerifyTextInput_NativeStartFailureRetiresTokenAndAnyEarlyEvent(){
    FakeTextInputContext ctx = FakeTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    TextInputSessionToken failed = TextInputSessionToken();
    native(mut ctx, mut failed){
        ctx.service.m_onStart = [&]() {
            failed = ctx.service.activeSession();
            EXPECT_EQ(ctx.service.emitCommit(failed, "early event"), TextInputAdmission::Accepted);
        };
    }
    ctx.service.m_startAdmission = TextInputAdmission::NativeFailure;
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> nativeFailureBegin = ctx.service.begin(MakeEmptySessionDesc());
    ASSERT_FALSE(nativeFailureBegin.has_value());
    EXPECT_EQ(nativeFailureBegin.error(), TextInputAdmission::NativeFailure);
    EXPECT_FALSE(ctx.service.activeSession().valid());
    EXPECT_EQ(ctx.service.poll(failed, ctx.event), TextInputPollResult::InvalidSession);
    EXPECT_EQ(ctx.service.m_endCount, 1u);
}

void VerifyTextInput_WrongThreadCannotMutateOrPollOwnerSession(){
    FakeTextInputContext ctx = FakeTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> tokenAdmission = ctx.service.begin(MakeEmptySessionDesc());
    ASSERT_TRUE(tokenAdmission.has_value());
    const TextInputSessionToken token = tokenAdmission.value();
    native(mut ctx, in token){
        Thread worker([&]() {
            TextInputEvent threadEvent(ctx.arena.arena);
            EXPECT_FALSE(ctx.service.isOwnerThread());
            EXPECT_FALSE(ctx.service.activeSession().valid());
            EXPECT_EQ(ctx.service.surroundingRevision(token), 0u);
            const auto wrongThreadBegin = ctx.service.begin({});
            ASSERT_FALSE(wrongThreadBegin);
            EXPECT_EQ(wrongThreadBegin.error(), TextInputAdmission::WrongThread);
            EXPECT_EQ(ctx.service.emitCommit(token, "wrong thread"), TextInputAdmission::WrongThread);
            EXPECT_EQ(ctx.service.poll(token, threadEvent), TextInputPollResult::WrongThread);
            EXPECT_EQ(ctx.service.updateCaret(token, {}), TextInputAdmission::WrongThread);
            EXPECT_EQ(ctx.service.updateSurrounding(token, {}, 0u, 0u), TextInputAdmission::WrongThread);
            EXPECT_FALSE(ctx.service.setFocused(false));
            EXPECT_FALSE(ctx.service.end(token));
        });
        worker.join();
        ASSERT_FALSE(::testing::Test::HasFatalFailure());
    }
    EXPECT_EQ(ctx.service.activeSession(), token);
    EXPECT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Pending);
}

void VerifyTextInput_NullNativeFactoryReportsUnsupportedWithoutClaimingTextInput(){
    UnsupportedTextInputContext ctx = UnsupportedTextInputContext();
    ASSERT_TRUE(ctx.factorySucceeded);
    ASSERT_TRUE(ctx.hasService());
    EXPECT_FALSE(ctx.capabilities().commit);
    EXPECT_FALSE(ctx.capabilities().preedit);
    EXPECT_FALSE(ctx.capabilities().surrounding);
    EXPECT_FALSE(ctx.capabilities().deleteSurrounding);
    ASSERT_TRUE(ctx.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> unsupportedBegin = ctx.beginEmpty();
    ASSERT_FALSE(unsupportedBegin.has_value());
    EXPECT_EQ(unsupportedBegin.error(), TextInputAdmission::Unsupported);
}

void VerifyTextInput_ReentrantNativeCaretCancellationReturnsFailureAndRetainsTerminalEvent(){
    FakeTextInputContext ctx = FakeTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> tokenAdmission = ctx.service.begin(MakeEmptySessionDesc());
    ASSERT_TRUE(tokenAdmission.has_value());
    const TextInputSessionToken token = tokenAdmission.value();
    native(mut ctx, in token){
        ctx.service.m_onCaret = [&]() {
            EXPECT_TRUE(ctx.service.cancelSession(token, TextInputCancelReason::NativeFailure));
        };
    }
    EXPECT_EQ(ctx.service.updateCaret(token, MakeTextInputRect(20, 30, 2, 18)), TextInputAdmission::NativeFailure);
    EXPECT_FALSE(ctx.service.activeSession().valid());
    ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
    EXPECT_EQ(ctx.event.kind, TextInputEventKind::Cancelled);
    EXPECT_EQ(ctx.event.cancelReason, TextInputCancelReason::NativeFailure);
}

void VerifyTextInput_ReentrantNativeSurroundingCancellationReturnsFailureAndRetainsTerminalEvent(){
    FakeTextInputContext ctx = FakeTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> tokenAdmission = ctx.service.begin(MakeEmptySessionDesc());
    ASSERT_TRUE(tokenAdmission.has_value());
    const TextInputSessionToken token = tokenAdmission.value();
    native(mut ctx, in token){
        ctx.service.m_onSurrounding = [&]() {
            EXPECT_TRUE(ctx.service.cancelSession(token, TextInputCancelReason::NativeFailure));
        };
    }
    EXPECT_EQ(ctx.service.updateSurrounding(token, "replacement", 2u, 4u), TextInputAdmission::NativeFailure);
    EXPECT_FALSE(ctx.service.activeSession().valid());
    EXPECT_EQ(ctx.service.surroundingRevision(token), 0u);
    ASSERT_EQ(ctx.service.poll(token, ctx.event), TextInputPollResult::Event);
    EXPECT_EQ(ctx.event.kind, TextInputEventKind::Cancelled);
    EXPECT_EQ(ctx.event.cancelReason, TextInputCancelReason::NativeFailure);
}

void VerifyTextInput_UnknownSurroundingChangeCausePreservesTextRevisionAndNativeState(){
    FakeTextInputContext ctx = FakeTextInputContext();
    ASSERT_TRUE(ctx.service.setFocused(true));
    const Expected<TextInputSessionToken, TextInputAdmissionEnum> tokenAdmission = ctx.service.begin(MakeEmptySessionDesc());
    ASSERT_TRUE(tokenAdmission.has_value());
    const TextInputSessionToken token = tokenAdmission.value();
    ASSERT_EQ(ctx.service.updateSurrounding(token, "local change", 0u, 12u), TextInputAdmission::Accepted);
    const u64 revision = ctx.service.surroundingRevision(token);
    EXPECT_EQ(ctx.service.updateSurrounding(token, "invalid", 0u, 0u, MakeInvalidChangeCause()), TextInputAdmission::InvalidRange);
    EXPECT_EQ(ctx.service.surroundingText(), "local change");
    EXPECT_EQ(ctx.service.surroundingRevision(token), revision);
    EXPECT_EQ(ctx.service.m_nativeCause, TextInputChangeCause::Other);
}


