////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_render/mesh/mesh_system.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class MeshDescriptorTransaction : NoCopy{
    private mut RendererMeshSystem m_meshSystem;
    private mut MeshResources m_mesh;
    private b8 m_active = true;

    public MeshDescriptorTransaction(mut RendererMeshSystem system, mut MeshResources mesh){
        this.m_meshSystem = system;
        this.m_mesh = mesh;
    }

    [cpp_unwind]
    public ~MeshDescriptorTransaction(){
        if(this.m_active)
            this.m_meshSystem.releaseMeshGeometryHeapHandles(this.m_mesh);
    }

    public void release(){
        this.m_active = false;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[modular]
class MeshSoftwareBvhBindings{
    public b8 ensure(mut GraphicsRuntime graphics, mut MeshResources mesh)const;
}

[modular]
class MeshEmulationResources{
    public b8 prepare(mut GraphicsRuntime graphics, mut MeshResources mesh)const;
}


