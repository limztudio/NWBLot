const StringView s_PaintTextSkinPath = "tests/ui/skin";
const StringView s_PaintTextFontPath = "tests/ui/font";
const StringView s_DefaultImagePath = "tests/ui/image";
const u64 s_DefaultAtlasIdentity = 11u;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[extensible]
class PaintTextFixture{
    public UiSkin m_skin = UiSkin(Name("tests/ui/skin"));
    public PaintBuilder m_builder;
    public SharedPool pool = SharedPool();

    public PaintTextFixture(){
        ConfigurePaintFixtureSkin(this.m_skin, AssetRef<Texture>("tests/ui/texture"));
        this.begin(7u);
    }
    public void begin(in u64 generation){ BeginPaintTextFixture(this, generation); }
    public Expected<SharedGlyphPage> makeCoverage(in u64 identity, in u64 generation){
        GlyphPagePixels pixels;
        pixels.resize(4u, 128u);
        GlyphPageBinding binding;
        binding.font = MakeUiFixtureAssetRef<Font>(s_PaintTextFontPath);
        binding.fontGeneration = 9u;
        binding.atlasIdentity = identity;
        binding.generation = generation;
        binding.width = 2u;
        binding.height = 2u;
        return CreateGlyphPage(this.pool, binding, pixels);
    }
    public Expected<SharedGlyphPage> makeGlyphPage(in u64 identity, in u64 generation, in u32 index){
        return MakeTestGlyphPage(this.pool, identity, generation, index);
    }
    public Expected<SharedSdfAtlasPage> makeDistance(){
        SdfAtlasPixels pixels;
        pixels.resize(4u * 4u * 4u, 128u);
        SdfAtlasPageBinding binding;
        binding.font = MakeUiFixtureAssetRef<Font>(s_PaintTextFontPath);
        binding.fontGeneration = 9u;
        binding.atlasIdentity = 22u;
        binding.generation = 1u;
        binding.width = 4u;
        binding.height = 4u;
        binding.spreadPixels = 2u;
        return CreateSdfAtlasPage(this.pool, binding, pixels);
    }
    public Expected<SharedSdfAtlasPage> makeSdfPage(in u64 identity, in u64 generation, in u32 index, in u8 interior){
        return MakeTestSdfAtlasPage(this.pool, identity, generation, index, interior);
    }
    public Expected<SharedGlyphPage> makeCoverage(){ return this.makeCoverage(s_DefaultAtlasIdentity); }
    public Expected<SharedGlyphPage> makeCoverage(in u64 identity){ return this.makeCoverage(identity, 1u); }
    public Expected<SharedGlyphPage> makeGlyphPage(){ return this.makeGlyphPage(s_DefaultAtlasIdentity); }
    public Expected<SharedGlyphPage> makeGlyphPage(in u64 identity){ return this.makeGlyphPage(identity, 1u); }
    public Expected<SharedGlyphPage> makeGlyphPage(in u64 identity, in u64 generation){ return this.makeGlyphPage(identity, generation, 0u); }
    public Expected<SharedSdfAtlasPage> makeSdfPage(){ return this.makeSdfPage(s_DefaultAtlasIdentity); }
    public Expected<SharedSdfAtlasPage> makeSdfPage(in u64 identity){ return this.makeSdfPage(identity, 1u); }
    public Expected<SharedSdfAtlasPage> makeSdfPage(in u64 identity, in u64 generation){ return this.makeSdfPage(identity, generation, 0u); }
    public Expected<SharedSdfAtlasPage> makeSdfPage(in u64 identity, in u64 generation, in u32 index){ return this.makeSdfPage(identity, generation, index, 255u); }
}

[extensible]
class PaintImageFixture{
    public UiSkin m_skin = UiSkin(Name("tests/ui/skin"));
    public PaintBuilder m_builder;
    public SharedPool pool = SharedPool();

    public PaintImageFixture(){
        ConfigurePaintFixtureSkin(this.m_skin, AssetRef<Texture>("tests/ui/skin_texture"));
        this.beginPaint(this.m_builder);
    }
    public void beginPaint(mut PaintBuilder builder){ this.beginPaint(builder, 1u); }
    public void beginPaint(mut PaintBuilder builder, in u64 generation){ BeginPaintImageFixture(this, builder, generation); }
    public Expected<SharedGlyphPage> makeGlyph(in u64 identity, in u64 generation){ return MakeTestGlyphPage(this.pool, identity, generation, 0u); }
    public Expected<SharedSdfAtlasPage> makeSdf(in u64 identity){ return MakeTestSdfAtlasPage(this.pool, identity, 1u, 0u, 255u); }
    public Expected<SharedImageSource> makeImage(in StringView path, in u8 seed, in u32 width, in u32 height){
        if(path.empty() || width == 0u || height == 0u)
            return MakeUnexpected(Failure());
        return MakeSeededImage(path, seed, width, height, this.pool);
    }
    public Expected<SharedGlyphPage> makeGlyph(){ return this.makeGlyph(s_DefaultAtlasIdentity); }
    public Expected<SharedGlyphPage> makeGlyph(in u64 identity){ return this.makeGlyph(identity, 1u); }
    public Expected<SharedSdfAtlasPage> makeSdf(){ return this.makeSdf(22u); }
    public Expected<SharedImageSource> makeImage(){ return this.makeImage(s_DefaultImagePath); }
    public Expected<SharedImageSource> makeImage(in StringView path){ return this.makeImage(path, 37u); }
    public Expected<SharedImageSource> makeImage(in StringView path, in u8 seed){ return this.makeImage(path, seed, 8u); }
    public Expected<SharedImageSource> makeImage(in StringView path, in u8 seed, in u32 width){ return this.makeImage(path, seed, width, 4u); }
}

[extensible]
class TextVisibleFixture{
    public Font m_latin = Font(Name("tests/ui/fonts/latin"));
    public Font m_korean = Font(Name("tests/ui/fonts/korean"));
    public TextService m_text;
    public TextLayout m_layout;
    public UiSkin m_skin = UiSkin(Name("tests/ui/skin"));
    public PaintBuilder m_paint;
    public SharedPool pool = SharedPool();

    public void setup(){
        ASSERT_TRUE(this.loadFont("latin.font", this.m_latin));
        ASSERT_TRUE(this.loadFont("korean.font", this.m_korean));
        ASSERT_TRUE(this.installCoverageFonts());
        this.m_skin.setAtlas(AssetRef<Texture>("tests/ui/texture"), 4u, 4u, 1.0f, Vector<UiSkinRegion>());
    }
    public b8 loadFont(in StringView filename, mut Font font){ return LoadBundledFixtureFont(filename, font); }
    public b8 installCoverageFonts(){
        const Array<FontSource, 2u> sources(FontSource(MakeUiFixtureAssetRef<Font>(s_TestLatinFontPath), this.m_latin, 1u), FontSource(MakeUiFixtureAssetRef<Font>(s_TestKoreanFontPath), this.m_korean, 1u));
        return this.m_text.setFonts(sources);
    }
    public b8 adoptLayout<TError>(mut Expected<TextLayout, TError> result){
        if(!result.has_value())
            return false;
        TestMoveAssign<TextLayout>(this.m_layout, result.value());
        return true;
    }
    public b8 applyLayout(in ShapeRequest request){
        auto result = this.m_text.layout(request);
        return this.adoptLayout(result);
    }
    public void beginPaint(in u64 generation){ this.beginPaint(generation, DisplayMetrics(800.0f, 600.0f, 1.0f, 1.0f)); }
    public void beginPaint(in u64 generation, in DisplayMetrics display){ BeginTextVisibleFixturePaint(this, generation, display); }
    public Expected<SharedGlyphPage> makePage(in u64 identity){
        GlyphPagePixels pixels;
        pixels.resize(64u, 128u);
        GlyphPageBinding binding;
        binding.font = AssetRef<Font>("tests/ui/independent_font");
        binding.fontGeneration = 1u;
        binding.atlasIdentity = identity;
        binding.generation = 1u;
        binding.width = 8u;
        binding.height = 8u;
        return CreateGlyphPage(this.pool, binding, pixels);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<SharedGlyphPage> MakeTestGlyphPage(in SharedPool pool, in u64 identity, in u64 generation, in u32 index){
    GlyphPagePixels pixels;
    pixels.resize(64u, 0u);
    pixels[0u] = 64u;
    if(generation > 1u)
        pixels[32u] = 192u;
    GlyphPageBinding binding;
    binding.font = MakeUiFixtureAssetRef<Font>(s_PaintTextFontPath);
    binding.fontGeneration = 9u;
    binding.atlasIdentity = identity;
    binding.generation = generation;
    binding.index = index;
    binding.width = 8u;
    binding.height = 8u;
    return CreateGlyphPage(pool, binding, pixels);
}

Expected<SharedSdfAtlasPage> MakeTestSdfAtlasPage(in SharedPool pool, in u64 identity, in u64 generation, in u32 index, in u8 interior){
    SdfAtlasPixels pixels;
    pixels.resize(8u * 8u * 4u, 0u);
    pixels[0u] = 32u;
    pixels[1u] = 128u;
    pixels[2u] = interior;
    pixels[3u] = 192u;
    SdfAtlasPageBinding binding;
    binding.font = MakeUiFixtureAssetRef<Font>(s_PaintTextFontPath);
    binding.fontGeneration = 9u;
    binding.atlasIdentity = identity;
    binding.generation = generation;
    binding.index = index;
    binding.width = 8u;
    binding.height = 8u;
    binding.spreadPixels = 8u;
    return CreateSdfAtlasPage(pool, binding, pixels);
}

void ConfigurePaintFixtureSkin(mut UiSkin skin, in AssetRef<Texture> texture){
    UiSkinRegion sprite;
    sprite.name = s_UiCaseSprite;
    sprite.rectangle.width = 8u;
    sprite.rectangle.height = 8u;
    sprite.drawMode = UiSkinDrawMode::Sprite;
    Vector<UiSkinRegion> regions;
    regions.push_back(sprite);
    skin.setAtlas(texture, 16u, 16u, 1.0f, regions);
}

void ExpectClippedPaintTextQuad(in DrawSnapshot snapshot){
    ASSERT_EQ(snapshot.vertices().size(), 4u);
    const Vertex first = snapshot.vertices()[0u];
    const Vertex opposite = snapshot.vertices()[2u];
    EXPECT_FLOAT_EQ(first.position.x, 10.0f);
    EXPECT_FLOAT_EQ(first.position.y, 5.0f);
    EXPECT_FLOAT_EQ(opposite.position.x, 30.0f);
    EXPECT_FLOAT_EQ(opposite.position.y, 15.0f);
    EXPECT_FLOAT_EQ(first.texCoord.x, 0.25f);
    EXPECT_FLOAT_EQ(first.texCoord.y, 0.375f);
    EXPECT_FLOAT_EQ(opposite.texCoord.x, 0.5f);
    EXPECT_FLOAT_EQ(opposite.texCoord.y, 0.625f);
}

Rect ComputePlacedGlyphOutlineRect(in PlacedGlyph glyph, in Point origin){
    Rect rect = Rect();
    rect.x = origin.x + glyph.position.x + glyph.ink.x;
    rect.y = origin.y + glyph.position.y + glyph.ink.y;
    rect.width = glyph.ink.width;
    rect.height = glyph.ink.height;
    return rect;
}

void ExpectUiSameImagePaintSnapshots(in DrawSnapshot actual, in DrawSnapshot expected){
    ExpectUiSameSnapshotHeader(actual, expected);
    ASSERT_EQ(actual.textureImages().size(), expected.textureImages().size());
    for(usize index = 0u; index < actual.textureImages().size(); ++index){
        const SharedImageSource actualSource = actual.textureImages()[index];
        const SharedImageSource expectedSource = expected.textureImages()[index];
        ASSERT_TRUE(cast<b8>(actualSource));
        ASSERT_TRUE(cast<b8>(expectedSource));
        EXPECT_EQ(actualSource, expectedSource);
        EXPECT_EQ(ImageSourceIdentity(actualSource), ImageSourceIdentity(expectedSource));
        EXPECT_EQ(ImageSourceGeneration(actualSource), ImageSourceGeneration(expectedSource));
        EXPECT_EQ(ImageSourceTexture(actualSource).virtualPath(), ImageSourceTexture(expectedSource).virtualPath());
        EXPECT_EQ(ImageSourceTexture(actualSource).width(), ImageSourceTexture(expectedSource).width());
        EXPECT_EQ(ImageSourceTexture(actualSource).height(), ImageSourceTexture(expectedSource).height());
        EXPECT_EQ(ImageSourceTexture(actualSource).dimension(), ImageSourceTexture(expectedSource).dimension());
        EXPECT_EQ(ImageSourceTexture(actualSource).depth(), ImageSourceTexture(expectedSource).depth());
        EXPECT_EQ(ImageSourceTexture(actualSource).payloadFormat(), ImageSourceTexture(expectedSource).payloadFormat());
        EXPECT_EQ(ImageSourceTexture(actualSource).alphaMode(), ImageSourceTexture(expectedSource).alphaMode());
        EXPECT_EQ(ImageSourceTexture(actualSource).alphaConstantUnorm8(), ImageSourceTexture(expectedSource).alphaConstantUnorm8());
        EXPECT_EQ(ImageSourceTexture(actualSource).payloadBytes(), ImageSourceTexture(expectedSource).payloadBytes());
        ASSERT_EQ(ImageSourceTexture(actualSource).mipLevels().size(), ImageSourceTexture(expectedSource).mipLevels().size());
        for(usize mipIndex = 0u; mipIndex < ImageSourceTexture(actualSource).mipLevels().size(); ++mipIndex){
            const TextureMipLevel am = ImageSourceTexture(actualSource).mipLevels()[mipIndex];
            const TextureMipLevel em = ImageSourceTexture(expectedSource).mipLevels()[mipIndex];
            EXPECT_EQ(am.width, em.width);
            EXPECT_EQ(am.height, em.height);
            EXPECT_EQ(am.blockCountX, em.blockCountX);
            EXPECT_EQ(am.blockCountY, em.blockCountY);
            EXPECT_EQ(am.offsetBytes, em.offsetBytes);
            EXPECT_EQ(am.sizeBytes, em.sizeBytes);
            EXPECT_EQ(am.sliceCount, em.sliceCount);
        }
    }
    ExpectUiSamePaintSnapshots(actual, expected);
}

void BeginPaintImageFixture(in PaintImageFixture self, mut PaintBuilder builder, in u64 generation){
    builder.begin(DisplayMetrics(200.0f, 100.0f, 1.25f, 1.5f), generation, 3u, MakeUiFixtureAssetRef<UiSkin>(s_TestSkinPath), self.m_skin);
    builder.reserve(16u);
}

void BeginPaintTextFixture(mut PaintTextFixture self, in u64 generation){
    self.m_builder.begin(DisplayMetrics(100.0f, 80.0f, 1.5f, 2.0f), generation, 3u, MakeUiFixtureAssetRef<UiSkin>(s_PaintTextSkinPath), self.m_skin);
    self.m_builder.reserve(16u);
}

void BeginTextVisibleFixturePaint(mut TextVisibleFixture self, in u64 generation, in DisplayMetrics display){
    self.m_paint.begin(display, generation, 1u, MakeUiFixtureAssetRef<UiSkin>(s_TestSkinPath), self.m_skin);
}


