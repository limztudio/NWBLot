class ReflectionDepthReduceTask{
    private mut GraphicsRuntime m_graphics;
    private ComputePipelineHandle m_pipeline;
    private ReflectionDepthReducePushConstants m_parameters;
    private u32 m_groupSize;

    public ReflectionDepthReduceTask(mut GraphicsRuntime graphics, in ComputePipelineHandle pipeline, in ReflectionDepthReducePushConstants parameters, in u32 groupSize){
        this.m_graphics = graphics;
        this.m_pipeline = pipeline;
        this.m_parameters = parameters;
        this.m_groupSize = groupSize;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }
    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.m_pipeline.valid())
            return false;
        DispatchReflectionPostprocess(commandList, this.m_graphics, this.m_pipeline.deref(), this.m_parameters, s_TimingScopeReflectionDepthPyramid, this.m_parameters.destinationWidth, this.m_parameters.destinationHeight, this.m_groupSize);
        return true;
    }
}

class ReflectionSpatialTask{
    private mut GraphicsRuntime m_graphics;
    private ComputePipelineHandle m_pipeline;
    private ReflectionSpatialPushConstants m_parameters;
    private u32 m_groupSize;

    public ReflectionSpatialTask(mut GraphicsRuntime graphics, in ComputePipelineHandle pipeline, in ReflectionSpatialPushConstants parameters, in u32 groupSize){
        this.m_graphics = graphics;
        this.m_pipeline = pipeline;
        this.m_parameters = parameters;
        this.m_groupSize = groupSize;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }
    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        DispatchReflectionPostprocess(commandList, this.m_graphics, this.m_pipeline.deref(), this.m_parameters, s_TimingScopeReflectionSpatial, this.m_parameters.width, this.m_parameters.height, this.m_groupSize);
        return !commandList.commandRecordingFailed();
    }
}

class ReflectionFinalizeTask{
    public GpuTaskCommandRequirements commandRequirements()const{
        return GpuTaskCommandRequirements();
    }
    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        commandList.endRenderPass();
        return true;
    }
}

class ReflectionTemporalTask : MoveOnly{
    private mut GraphicsRuntime m_graphics;
    private ReflectionPostprocessSnapshot m_snapshot;
    public ReflectionHistoryReservation reservation;
    private u32 m_width;
    private u32 m_height;
    private in b8 m_hardwarePreparationReady;
    private b8 m_hardwareEnabled;

    public ReflectionTemporalTask(mut GraphicsRuntime graphics, in ReflectionFrameSnapshot resources, in borrow b8 hardwarePreparationReady){
        this.m_graphics = graphics;
        this.m_snapshot = resources.postprocess;
        this.reservation = ReflectionHistoryReservation(resources.postprocess.control, resources.postprocess.history);
        this.m_width = resources.parameters.width;
        this.m_height = resources.parameters.height;
        this.m_hardwarePreparationReady = hardwarePreparationReady;
        this.m_hardwareEnabled = resources.parameters.hardwareEnabled != 0u;
    }

    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Compute); }
    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.m_snapshot.history.eligible)
            return true;
        const b8 ready = this.m_hardwareEnabled && this.m_hardwarePreparationReady;
        const ReflectionHistoryOutcome outcome = ResolveReflectionHistoryOutcome(this.m_snapshot.history, ready);
        if(ShouldSkipReflectionTemporalDispatch(outcome.reused, this.m_snapshot.history.settings.temporalMaxSamples))
            return true;
        const ReflectionTemporalPushConstants parameters = MakeReflectionTemporalPushConstants(
            this.m_width, this.m_height, this.m_snapshot.current.storageSlot, this.m_snapshot.previous.sampledSlot,
            this.m_snapshot.opaqueSpecularSlot, outcome.reused, this.m_snapshot.history.previousSampleCount,
            this.m_snapshot.history.settings.temporalMaxSamples, outcome.sampleIndex, this.m_snapshot.history.settings.samplingSeed
        );
        DispatchReflectionPostprocess(commandList, this.m_graphics, this.m_snapshot.temporalPipeline.deref(), parameters,
            s_TimingScopeReflectionTemporal, this.m_width, this.m_height, s_ReflectionShaderTemporalGroupSize);
        return !commandList.commandRecordingFailed();
    }
    public void accepted(in QueueSubmissionToken token){ this.reservation.accept(token, this.m_hardwareEnabled && this.m_hardwarePreparationReady); }
    public void discarded(){ this.reservation.discard(); }
}

class ReflectionStatisticsReadbackTask : MoveOnly{
    private BufferHandle m_source;
    public BufferHandle destination;
    public GpuGraphResourceId sourceResource;
    public GpuGraphResourceId destinationResource;
    public ReflectionStatisticsReservation reservation;
    private ReflectionHistoryPlan m_history;
    private ReflectionFeedbackPlan m_feedback;
    private in b8 m_hardwarePreparationReady;
    private b8 m_feedbackReserved;
    private b8 m_hardwareEnabled;

    public ReflectionStatisticsReadbackTask(in ReflectionFrameSnapshot resources, in ReflectionStatistics metadata, in borrow b8 hardwarePreparationReady, in b8 feedbackReserved){
        this.m_source = resources.counters;
        this.reservation = StatisticsReservation<ReflectionStatistics, ReflectionStatisticsOutcome>(resources.statistics.control, metadata);
        this.m_history = resources.postprocess.history;
        this.m_feedback = resources.feedback.plan;
        this.m_hardwarePreparationReady = hardwarePreparationReady;
        this.m_feedbackReserved = feedbackReserved;
        this.m_hardwareEnabled = resources.parameters.hardwareEnabled != 0u;
    }
    public GpuTaskCommandRequirements commandRequirements()const{ return GpuTaskCommandRequirements(GpuQueueCapability::Transfer); }
    [cpp_unwind]
    public b8 record(mut CommandList commandList, in GpuTaskRecordContext context)const{
        if(!this.m_source.valid() || !this.destination.valid() || !this.reservation.valid())
            return false;
        const GpuGraphResourceId source = this.sourceResource;
        const GpuGraphResourceId destination = this.destinationResource;
        in GpuTaskRecordContext contextRef = context;
        if(!CaptureGpuTaskCommandsIfEnabled(contextRef, lambda[in contextRef, in source, in destination](mut GpuCommandIrCapture capture) -> b8{
            return capture.captureCopyBuffer(contextRef.task, contextRef.packet, contextRef.queue, source, 0u, destination, 0u, s_ReflectionReadbackCounterBytes);
        }))
            return false;
        commandList.endRenderPass();
        commandList.copyBuffer(this.destination.deref(), 0u, this.m_source.deref(), 0u, s_ReflectionReadbackCounterBytes);
        return !commandList.commandRecordingFailed();
    }
    public void accepted(in QueueSubmissionToken token){
        const b8 hardwareReady = this.m_hardwareEnabled && this.m_hardwarePreparationReady;
        const ReflectionHistoryOutcome history = ResolveReflectionHistoryOutcome(this.m_history, hardwareReady);
        const ReflectionFeedbackOutcome feedback = ResolvePublishedReflectionFeedbackOutcome(this.m_feedback, hardwareReady, this.m_feedbackReserved);
        this.reservation.acceptReservation(token, hardwareReady, ReflectionStatisticsOutcome(history, feedback));
    }
    public void discarded(){ this.reservation.discard(); }
}

static_assert(size_of<ReflectionTemporalPushConstants>() == s_ReflectionShaderTemporalPushBytes, "Temporal push constants must match the shader");
static_assert(size_of<ReflectionSpatialPushConstants>() == s_ReflectionShaderSpatialPushBytes, "Spatial push constants must match the shader");
static_assert(size_of<ReflectionDepthReducePushConstants>() == s_ReflectionShaderDepthPushBytes, "Depth-reduce push constants must match the shader");


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


u32 ReflectionDepthPyramidSourceMipIndex(in u32 mipIndex){
    if(mipIndex == 0u)
        return 0u;
    return mipIndex - 1u;
}

u32 ResolveReflectionDepthSourceSlot(in u32 mipIndex, in u32 pyramidSourceDepthSlot, in u32 previousMipSampledSlot){
    if(mipIndex == 0u)
        return pyramidSourceDepthSlot;
    return previousMipSampledSlot;
}

b8 ShouldSkipReflectionTemporalDispatch(in b8 historyReused, in u32 temporalMaxSamples){
    return !historyReused || temporalMaxSamples <= 1u;
}

u64 ResolveReflectionStatisticsFeedbackSequence(in b8 feedbackReserved, in u64 plannedSequence){
    if(feedbackReserved)
        return plannedSequence;
    return 0u;
}

ReflectionFeedbackOutcome ResolvePublishedReflectionFeedbackOutcome(in ReflectionFeedbackPlan plan, in b8 hardwareReady, in b8 feedbackReserved){
    ReflectionFeedbackOutcome outcome = ResolveReflectionFeedbackOutcome(plan, hardwareReady);
    if(!feedbackReserved){
        outcome.eligible = false;
        outcome.reused = false;
    }
    return outcome;
}

[cpp_unwind]
void DispatchReflectionPostprocess<T>(
    mut CommandList commandList,
    mut GraphicsRuntime graphics,
    mut ComputePipeline pipeline,
    in T parameters,
    in GpuTimingScopeDefinition scope,
    in u32 width,
    in u32 height,
    in u32 groupSize
){
    commandList.endRenderPass();
    ComputeState state;
    state.setPipeline(pipeline);
    commandList.setComputeState(state);
    graphics.getDevice().getDescriptorHeap().bindCompute(commandList, pipeline);
    commandList.setPushConstants(parameters);
    GpuTimingMeasure timing(graphics.gpuTiming(), scope, graphics.getDevice(), commandList);
    commandList.dispatch(DivideUpWrapping(width, groupSize), DivideUpWrapping(height, groupSize), 1u);
}

Expected<GpuTaskId> DeclareReflectionDepthPyramidTasks(
    in ReflectionDepthPyramidSnapshot pyramid,
    in GpuGraphResourceId opaqueDepth,
    in GpuTaskId initialDependency,
    mut GpuTaskGraph graph,
    mut GraphicsRuntime graphics,
    mut GpuGraphResourceId outDepthPyramid
){
    GpuTaskId dependency = initialDependency;
    const auto depthPyramidResult = ImportReflectionTexture(graph, pyramid.texture);
    if(!depthPyramidResult.has_value()){
        outDepthPyramid = GpuGraphResourceId();
        return MakeUnexpected(Failure());
    }
    outDepthPyramid = depthPyramidResult.value();
    for(u32 mipIndex = 0u; mipIndex < pyramid.mipCount; ++mipIndex){
        const u32 sourceMipIndex = ReflectionDepthPyramidSourceMipIndex(mipIndex);
        in ReflectionDepthPyramidMip destination = pyramid.mips[mipIndex];
        in ReflectionDepthPyramidMip source = pyramid.mips[sourceMipIndex];
        const ReflectionDepthReducePushConstants parameters = MakeReflectionDepthReducePushConstants(
            ResolveReflectionDepthSourceSlot(mipIndex, pyramid.sourceDepthSlot, source.sampledSlot),
            destination.storageSlot,
            source.width,
            source.height,
            destination.width,
            destination.height
        );
        GpuGraphResourceId sourceTexture = outDepthPyramid;
        if(mipIndex == 0u)
            sourceTexture = opaqueDepth;
        const Array<GpuTaskResourceUse, 2u> depthUses(
            ReadTextureUse(sourceTexture, TextureSubresourceSet(sourceMipIndex, 1u, 0u, 1u)),
            WriteTextureUse(outDepthPyramid, TextureSubresourceSet(mipIndex, 1u, 0u, 1u), ResourceStates::UnorderedAccess)
        );
        GpuTaskDesc depthDesc = ReflectionTaskDesc(destination.taskIdentity, s_ReflectionDepthReduceTaskLabel, dependency);
        depthDesc.setResourceUses(depthUses);
        depthDesc.setTiming(ReflectionPacketTiming());
        const auto depthTask = graph.addPayloadTask(depthDesc, ReflectionDepthReduceTask(graphics, pyramid.pipeline, parameters, s_ReflectionShaderDepthGroupSize));
        if(!depthTask.has_value())
            return MakeUnexpected(Failure());
        dependency = depthTask.value();
    }
    return dependency;
}

Expected<GpuTaskId> DeclareReflectionPostprocessTasks(
    in ReflectionFrameSnapshot resources,
    in ReflectionGraphInputs inputs,
    in GpuTaskId initialDependency,
    mut GpuTaskGraph graph,
    mut GraphicsRuntime graphics,
    mut ReflectionGraphResult result
){
    GpuTaskId dependency = initialDependency;
    in ReflectionPostprocessSnapshot snapshot = resources.postprocess;
    ReflectionTemporalTask payload(graphics, resources, inputs.hardwarePreparationReady);
    if(!payload.reservation.valid() || (snapshot.history.eligible && !snapshot.temporalPipeline.valid()))
        return MakeUnexpected(Failure());
    Vector<GpuTaskResourceUse> uses;
    uses.reserve(inputs.surfaceReads.size() + s_ReflectionTemporalExtraResourceUseCount);
    if(snapshot.history.eligible){
        uses.clear();
        for(in GpuTaskResourceUse use : inputs.surfaceReads)
            uses.push_back(use);
        uses.push_back(ReadWriteUse(result.opaqueRadiance, ResourceStates::UnorderedAccess));
        if(snapshot.history.reused){
            const auto previousResult = ImportReflectionTexture(graph, snapshot.previous.texture, s_ReflectionHistoryImageLabel, false);
            if(!previousResult.has_value())
                return MakeUnexpected(Failure());
            const GpuGraphResourceId previous = previousResult.value();
            uses.push_back(ReadUse(previous));
        }
    }
    GpuTaskDesc desc = ReflectionTaskDesc(s_ReflectionTemporalTaskName, s_ReflectionTemporalTaskLabel, dependency);
    desc.setResourceUses(uses);
    if(snapshot.history.eligible)
        desc.setTiming(ReflectionPacketTiming());
    const auto temporalTask = graph.addPreparedPayloadTask(desc, payload);
    if(!temporalTask.has_value())
        return MakeUnexpected(temporalTask.error());
    dependency = temporalTask.value();
    if(!snapshot.spatialEnabled)
        return dependency;
    if(!snapshot.spatialPipeline.valid() || !snapshot.spatial.texture.valid())
        return MakeUnexpected(Failure());
    const auto spatialResult = ImportReflectionTexture(graph, snapshot.spatial.texture, s_ReflectionHistoryImageLabel, true);
    if(!spatialResult.has_value())
        return MakeUnexpected(Failure());
    const GpuGraphResourceId spatial = spatialResult.value();
    uses.clear();
    for(in GpuTaskResourceUse use : inputs.surfaceReads)
        uses.push_back(use);
    uses.push_back(ReadUse(result.opaqueRadiance));
    uses.push_back(WriteUse(spatial, ResourceStates::UnorderedAccess));
    desc = ReflectionTaskDesc(s_ReflectionSpatialTaskName, s_ReflectionSpatialTaskLabel, dependency);
    desc.setResourceUses(uses);
    desc.setTiming(ReflectionPacketTiming());
    const ReflectionSpatialPushConstants spatialParameters = MakeReflectionSpatialPushConstants(
        resources.parameters.width,
        resources.parameters.height,
        snapshot.current.sampledSlot,
        snapshot.spatial.storageSlot,
        snapshot.deferredResourcesSlot,
        snapshot.opaqueSpecularSlot,
        snapshot.viewSlot,
        snapshot.history.settings.spatialRadius
    );
    const auto spatialTask = graph.addPayloadTask(desc, ReflectionSpatialTask(graphics, snapshot.spatialPipeline, spatialParameters, s_ReflectionShaderSpatialGroupSize));
    if(!spatialTask.has_value())
        return MakeUnexpected(spatialTask.error());
    dependency = spatialTask.value();
    result.opaqueRadiance = spatial;
    return dependency;
}

Expected<GpuTaskId> DeclareReflectionStatisticsAndFinalizeTasks(
    in ReflectionFrameSnapshot resources,
    in ReflectionGraphInputs inputs,
    in b8 feedbackReserved,
    in GpuTaskId initialDependency,
    mut GpuTaskGraph graph,
    mut ReflectionGraphResult result
){
    GpuTaskId dependency = initialDependency;
    if(resources.parameters.diagnosticsEnabled != 0u && resources.statistics.control.valid()){
        ReflectionStatistics metadata = resources.statistics.metadata;
        metadata.feedbackSequence = ResolveReflectionStatisticsFeedbackSequence(feedbackReserved, resources.feedback.plan.sequence);
        ReflectionStatisticsReadbackTask payload(resources, metadata, inputs.hardwarePreparationReady, feedbackReserved);
        if(payload.reservation.valid()){
            in BufferHandle readback = resources.statistics.buffers[payload.reservation.slotIndex()];
            if(!readback.valid())
                return MakeUnexpected(Failure());
            const auto readbackResourceResult = FindOrImportBuffer(graph, readback, s_ReflectionBufferLabel);
            if(!readbackResourceResult.has_value())
                return MakeUnexpected(Failure());
            const GpuGraphResourceId readbackResource = readbackResourceResult.value();
            const BufferRange counterRange(0u, s_ReflectionReadbackCounterBytes);
            GpuTaskResourceUse destinationUse = WriteUse(readbackResource, ResourceStates::CopyDest);
            destinationUse.range.bufferRange = counterRange;
            const Array<GpuTaskResourceUse, 2u> copyUses(
                ReadBufferUse(result.counters, counterRange, ResourceStates::CopySource),
                destinationUse
            );
            GpuTaskDesc copyDesc = ReflectionTaskDesc(s_ReflectionStatisticsTaskName, s_ReflectionStatisticsTaskLabel, dependency);
            copyDesc.setResourceUses(copyUses);
            payload.sourceResource = result.counters;
            payload.destination = readback;
            payload.destinationResource = readbackResource;
            const auto copyTask = graph.addPreparedPayloadTask(copyDesc, payload);
            if(!copyTask.has_value())
                return MakeUnexpected(Failure());
            dependency = copyTask.value();
        }
    }

    const Array<GpuTaskResourceUse, 2u> finalUses(ReadUse(result.opaqueRadiance), ReadUse(result.glassRadiance));
    GpuTaskDesc desc = ReflectionTaskDesc(s_ReflectionFinalizeTaskName, s_ReflectionFinalizeTaskLabel, dependency);
    desc.setResourceUses(finalUses);
    return graph.addPayloadTask(desc, ReflectionFinalizeTask());
}


