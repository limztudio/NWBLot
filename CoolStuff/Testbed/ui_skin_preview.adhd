class UiWidgetGallery{
    public UiWidgetGallery(mut GlobalArena arena){
        this.m_edits = UiEditGallery(arena);
        this.m_searchCombos = UiSearchComboGallery(arena);
        this.m_nestedPopups = UiNestedPopupGallery(arena);
        this.m_numericEdits = UiNumericEditGallery(arena);
        this.m_textAreas = UiTextAreaGallery(arena);
    }

    public b8 loadAssets(mut GlobalArena arena, in AssetManager assets, in ActiveSceneSubsystems sceneSubsystems){
        return this.m_images.loadAssets(arena, assets, sceneSubsystems);
    }

    public void paint(mut UiPaintContext context, in Rect bounds){
        const u32 previous = this.m_selectedGallery;
        if(!context.ui.beginPanel("gallery_selector", Rect(bounds.x, bounds.y, bounds.width, s_SelectorHeight)))
            return;
        ContainerOptions row = ContainerOptions();
        b8 valid = context.ui.beginRow("navigation", row);
        WidgetOptions navigation = WidgetOptions();
        navigation.width = LayoutSize(LayoutSizePolicy::Fixed, s_NavigationButtonWidth);
        navigation.enabled = this.m_selectedGallery != 0u && !context.ui.input().hasPopup();
        if(context.ui.button("previous", "Previous", navigation))
            --this.m_selectedGallery;
        navigation.enabled = this.m_selectedGallery + 1u < cast<u32>(Section::kCount) && !context.ui.input().hasPopup();
        if(context.ui.button("next", "Next", navigation))
            ++this.m_selectedGallery;
        valid = context.ui.endContainer() && valid;
        const u32 selected = this.m_selectedGallery;
        ScratchArena scratchArena(s_SelectorArena);
        valid = DeclareFormattedLabel(context.ui, scratchArena, "section", "UI samples {}/{}: {}", selected + 1u, cast<u32>(Section::kCount), SectionName(cast<Section>(selected))) && valid;
        valid = context.ui.endPanel() && valid;
        if(!valid){
            error("Testbed: UI gallery selector declaration failed");
            return;
        }
        if(previous != selected)
            [essential] info("Testbed: UI gallery section={}", this.m_selectedGallery + 1u);

        const Point contentOrigin = ResolveWidgetGalleryContentOrigin(bounds, selected);
        const f32 x = contentOrigin.x;
        const f32 y = contentOrigin.y;
        switch(cast<Section>(selected)){
        case Section::Controls:
            this.paintControls(context, scratchArena, x, y);
            this.m_popups.paint(context, x, y);
            break;
        case Section::Edit: this.m_edits.paint(context, x, y); break;
        case Section::List: this.m_lists.paint(context, scratchArena, x, y); break;
        case Section::Combo: this.m_combos.paint(context, scratchArena, x, y); break;
        case Section::SearchCombo: this.m_searchCombos.paint(context, scratchArena, x, y); break;
        case Section::PopupTools: this.m_popupTools.paint(context, scratchArena, x, y); break;
        case Section::NestedPopup: this.m_nestedPopups.paint(context, x, y); break;
        case Section::NumericEdit: this.m_numericEdits.paint(context, scratchArena, x, y); break;
        case Section::TextArea: this.m_textAreas.paint(context, x, y); break;
        case Section::RadioGroup: this.m_radioGroups.paint(context, x, y); break;
        case Section::Slider: this.m_sliders.paint(context, x, y); break;
        case Section::Progress: this.m_progress.paint(context, scratchArena, x, y); break;
        case Section::Image: this.m_images.paint(context, x, y); break;
        case Section::kCount: break;
        }
    }

    private void paintControls(mut UiPaintContext context, mut ScratchArena scratchArena, in f32 x, in f32 y){
        if(!context.ui.beginPanel("interactive_gallery", Rect(x, y, s_OrdinaryGalleryWidth, s_ControlsPanelHeight)))
            return;
        b8 valid = context.ui.label(s_TitleKey, "Interactive custom UI");
        if(context.ui.checkbox(s_EnabledKey, "Enable counter", this.m_enabled))
            [essential] info("Testbed: custom UI counter enabled={}", this.m_enabled);
        valid = context.ui.beginRow("actions") && valid;
        WidgetOptions options = WidgetOptions();
        options.enabled = this.m_enabled;
        options.width = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
        if(context.ui.button("increase", "Increase", options)){
            this.m_count = StepWidgetGalleryCounter(this.m_count);
            [essential] info("Testbed: custom UI counter={}", this.m_count);
        }
        if(context.ui.button("reset", "Reset"))
            this.m_count = 0u;
        this.m_popups.trigger(context.ui);
        valid = context.ui.endContainer() && valid;
        valid = DeclareFormattedLabel(context.ui, scratchArena, "count", "Count: {}", this.m_count) && valid;
        valid = context.ui.label("keyboard_hint", "Tab / Shift+Tab, Enter / Space") && valid;
        valid = context.ui.endPanel() && valid;
        if(!valid)
            error("Testbed: custom UI widget declaration failed");
    }

    private UiEditGallery m_edits;
    private UiListGallery m_lists = UiListGallery();
    private UiComboGallery m_combos = UiComboGallery();
    private UiSearchComboGallery m_searchCombos;
    private UiPopupGallery m_popups = UiPopupGallery();
    private UiPopupToolsGallery m_popupTools = UiPopupToolsGallery();
    private UiNestedPopupGallery m_nestedPopups;
    private UiNumericEditGallery m_numericEdits;
    private UiTextAreaGallery m_textAreas;
    private UiRadioGroupGallery m_radioGroups = UiRadioGroupGallery();
    private UiSliderGallery m_sliders = UiSliderGallery();
    private UiProgressGallery m_progress = UiProgressGallery();
    private UiImageGallery m_images = UiImageGallery();
    private u32 m_count = 0u;
    private u32 m_selectedGallery = 0u;
    private b8 m_enabled = true;
}

class UiSkinPreview{
    public UiSkinPreview(mut GlobalArena arena){
        this.m_normal = Label(arena);
        this.m_hover = Label(arena);
        this.m_pressed = Label(arena);
        this.m_disabled = Label(arena);
        this.m_edit = Label(arena);
        this.m_caption = Label(arena);
        this.m_korean = Label(arena);
        this.m_widgets = UiWidgetGallery(arena);
        const b8 configured = ConfigureLabel("Normal", this.m_normal) && ConfigureLabel("Hover", this.m_hover)
            && ConfigureLabel("Pressed", this.m_pressed) && ConfigureLabel("Disabled", this.m_disabled)
            && ConfigureLabelWithSize("UTF-8 labels", s_GalleryFontSize, this.m_edit) && ConfigureLabelWithSize("FreeType + HarfBuzz", s_GalleryFontSize, this.m_caption)
            && ConfigureKoreanLabel(this.m_korean);
        [essential] assert(configured, "Testbed UI labels must have valid constant text");
    }

    public b8 loadAssets(mut GlobalArena arena, in AssetManager assets, in ActiveSceneSubsystems sceneSubsystems){
        return this.m_widgets.loadAssets(arena, assets, sceneSubsystems);
    }

    public Expected<Rect> galleryBounds(mut UiPaintContext context){
        const Expected<Rect> caption = this.m_caption.measure(context.text, context.display);
        const Expected<Rect> korean = this.m_korean.measure(context.text, context.display);
        if(!caption.has_value() || !korean.has_value())
            return MakeUnexpected(Failure());
        const f32 captionHeight = ResolveSkinGalleryCaptionHeight(caption.value().height, korean.value().height);
        return ResolveWidgetGalleryLayoutBounds(context.display, ResolveSkinGalleryPreferredTop(captionHeight));
    }

    public void paint(mut UiPaintContext context){
        const f32 originX = ResolveSkinGalleryOriginX(context.display.logicalWidth);
        const f32 originY = s_GalleryMargin;
        const Expected<Rect> caption = this.m_caption.measure(context.text, context.display);
        const Expected<Rect> korean = this.m_korean.measure(context.text, context.display);
        const Expected<Rect> normal = this.m_normal.measure(context.text, context.display);
        const Expected<Rect> hover = this.m_hover.measure(context.text, context.display);
        const Expected<Rect> pressed = this.m_pressed.measure(context.text, context.display);
        const Expected<Rect> disabled = this.m_disabled.measure(context.text, context.display);
        const Expected<Rect> edit = this.m_edit.measure(context.text, context.display);
        if(!caption.has_value() || !korean.has_value() || !normal.has_value() || !hover.has_value() || !pressed.has_value() || !disabled.has_value() || !edit.has_value()){
            error("Testbed: custom UI label measurement failed");
            return;
        }
        const f32 captionHeight = ResolveSkinGalleryCaptionHeight(caption.value().height, korean.value().height);
        const f32 preferredTop = ResolveSkinGalleryPreferredTop(captionHeight);
        const Rect gallery = ResolveWidgetGalleryLayoutBounds(context.display, preferredTop);
        this.m_widgets.paint(context, gallery);
        if(gallery.y < preferredTop || originX < s_MinimumGalleryX)
            return;
        if(!DrawSkinGallery(context.paint, originX, originY, captionHeight)){
            error("Testbed: default UI skin is missing a gallery region");
            return;
        }

        const f32 captionX = originX + s_CaptionX;
        const f32 captionY = originY + s_CaptionY;
        const f32 leftTextX = originX + s_LeftTextX;
        const f32 rightTextX = originX + s_RightTextX;
        const f32 normalY = ResolveSkinGalleryCenteredTextY(originY, s_ButtonTopY, s_ButtonHeight, normal.value().height);
        const f32 hoverY = ResolveSkinGalleryCenteredTextY(originY, s_ButtonTopY, s_ButtonHeight, hover.value().height);
        const f32 pressedY = ResolveSkinGalleryCenteredTextY(originY, s_ButtonBottomY, s_ButtonHeight, pressed.value().height);
        const f32 disabledY = ResolveSkinGalleryCenteredTextY(originY, s_ButtonBottomY, s_ButtonHeight, disabled.value().height);
        const f32 editY = ResolveSkinGalleryCenteredTextY(originY, s_EditFocusedY, s_EditFocusedHeight, edit.value().height);
        const b8 captionPainted = this.m_caption.paint(context.text, context.paint, Rect(captionX, captionY, s_CaptionWidth, caption.value().height))
            && this.m_korean.paint(context.text, context.paint, Rect(captionX, captionY + caption.value().height, s_CaptionWidth, korean.value().height));
        if(!captionPainted){
            error("Testbed: custom UI caption shaping or rasterization failed");
            return;
        }
        if(
            !this.m_normal.paint(context.text, context.paint, Rect(leftTextX, normalY, s_ButtonTextWidth, normal.value().height), s_LabelTextColor)
            || !this.m_hover.paint(context.text, context.paint, Rect(rightTextX, hoverY, s_ButtonTextWidth, hover.value().height), s_LabelTextColor)
            || !this.m_pressed.paint(context.text, context.paint, Rect(leftTextX, pressedY, s_ButtonTextWidth, pressed.value().height), s_LabelTextColor)
            || !this.m_disabled.paint(context.text, context.paint, Rect(rightTextX, disabledY, s_ButtonTextWidth, disabled.value().height), s_DisabledLabelTextColor)
            || !this.m_edit.paint(context.text, context.paint, Rect(leftTextX, editY, s_EditTextWidth, edit.value().height), s_LabelTextColor)
        )
            error("Testbed: custom UI label shaping or rasterization failed");
    }

    private Label m_normal;
    private Label m_hover;
    private Label m_pressed;
    private Label m_disabled;
    private Label m_edit;
    private Label m_caption;
    private Label m_korean;
    private UiWidgetGallery m_widgets;
}


