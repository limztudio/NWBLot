#include <impl/ecs_csg/built_in_shapes.adhd>
#include <impl/ecs_csg/components.adhd>
#include "scene_types.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


EntityID CreateSmokeCsgCutter<T>(in Name receiverGroup, in Name shapeType, in b8 active, in T parameters, in VectorSingle center, in VectorSingle rotation, mut World world){
    Entity entity = world.createEntity();
    mut CsgCutterComponent cutter = entity.addComponent<CsgCutterComponent>();
    cutter.receiverGroup = receiverGroup;
    cutter.shapeType = shapeType;
    cutter.active = active;
    cutter.parameterBytes.clear();
    AppendPOD(cutter.parameterBytes, parameters);
    AssignCsgCutterTransform(center, rotation, cutter);
    return entity.id();
}

EntityID CreateSmokeCsgBoxCutter(in Name receiverGroup, in Name shapeType, in b8 active, in VectorSingle halfExtents, in VectorSingle center, in VectorSingle rotation, mut World world){
    CsgBoxShapeParameters parameters = CsgBoxShapeParameters();
    parameters.halfExtents = f32x4(halfExtents);
    return CreateSmokeCsgCutter<CsgBoxShapeParameters>(receiverGroup, shapeType, active, parameters, center, rotation, world);
}

EntityID CreateSmokeCsgPlaneCutter(in Name receiverGroup, in Name shapeType, in b8 active, in VectorSingle normalDistance, in VectorSingle center, in VectorSingle rotation, mut World world){
    CsgPlaneShapeParameters parameters = CsgPlaneShapeParameters();
    parameters.normalDistance = f32x4(normalDistance);
    return CreateSmokeCsgCutter<CsgPlaneShapeParameters>(receiverGroup, shapeType, active, parameters, center, rotation, world);
}

EntityID CreateSmokeCsgPlaneCutter(in Name receiverGroup, in Name shapeType, in b8 active, in VectorSingle normalDistance, mut World world){
    return CreateSmokeCsgPlaneCutter(receiverGroup, shapeType, active, normalDistance, VectorZero(), QuaternionIdentity(), world);
}

EntityID CreateSmokeCsgSphereCutter(in Name receiverGroup, in Name shapeType, in b8 active, in VectorSingle radius, in VectorSingle center, in VectorSingle rotation, mut World world){
    CsgSphereShapeParameters parameters = CsgSphereShapeParameters();
    parameters.radius = f32x4(radius);
    return CreateSmokeCsgCutter<CsgSphereShapeParameters>(receiverGroup, shapeType, active, parameters, center, rotation, world);
}

EntityID CreateSmokeCsgSphereCutter(in Name receiverGroup, in Name shapeType, in b8 active, in VectorSingle radius, mut World world){
    return CreateSmokeCsgSphereCutter(receiverGroup, shapeType, active, radius, VectorZero(), QuaternionIdentity(), world);
}

EntityID CreateSmokeCsgCapsuleCutter(in Name receiverGroup, in Name shapeType, in b8 active, in VectorSingle radiusHalfHeight, in VectorSingle center, in VectorSingle rotation, mut World world){
    CsgCapsuleShapeParameters parameters = CsgCapsuleShapeParameters();
    parameters.radiusHalfHeight = f32x4(radiusHalfHeight);
    return CreateSmokeCsgCutter<CsgCapsuleShapeParameters>(receiverGroup, shapeType, active, parameters, center, rotation, world);
}

EntityID CreateSmokeCsgCapsuleCutter(in Name receiverGroup, in Name shapeType, in b8 active, in VectorSingle radiusHalfHeight, mut World world){
    return CreateSmokeCsgCapsuleCutter(receiverGroup, shapeType, active, radiusHalfHeight, VectorZero(), QuaternionIdentity(), world);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void AddStaticCsgMeshReceiver(in EntityID entity, in Name receiverGroup, in b8 affectOpaquePass, in b8 affectTransparentPass, mut World world){
    mut StaticCsgMeshComponent receiver = world.entity(entity).addComponent<StaticCsgMeshComponent>();
    receiver.receiverGroup = receiverGroup;
    receiver.affectOpaquePass = affectOpaquePass;
    receiver.affectTransparentPass = affectTransparentPass;
}

void AddSkinnedCsgMeshReceiver(in EntityID entity, in Name receiverGroup, in b8 affectOpaquePass, in b8 affectTransparentPass, mut World world){
    mut SkinnedCsgMeshComponent receiver = world.entity(entity).addComponent<SkinnedCsgMeshComponent>();
    receiver.receiverGroup = receiverGroup;
    receiver.affectOpaquePass = affectOpaquePass;
    receiver.affectTransparentPass = affectTransparentPass;
}

void AssignCsgCutterTransform(in VectorSingle center, in VectorSingle rotation, mut CsgCutterComponent cutter){
    MatrixSingle worldToShape = MatrixSingle();
    MatrixSingle shapeToWorld = MatrixSingle();
    ComputeCsgCutterTransforms(center, rotation, worldToShape, shapeToWorld);
    cutter.worldToShape = f32x3x4(worldToShape);
    cutter.shapeToWorld = f32x3x4(shapeToWorld);
}

void AssignCsgCutterMatrix(in MatrixSingle shapeToWorld, mut CsgCutterComponent cutter){
    cutter.worldToShape = f32x3x4(Inverse(shapeToWorld));
    cutter.shapeToWorld = f32x3x4(shapeToWorld);
}

b8 SetSmokeCsgCutterTransform(in EntityID cutterEntity, in VectorSingle center, in VectorSingle rotation, mut World world){
    if(!world.hasComponent<CsgCutterComponent>(cutterEntity))
        return false;
    mut CsgCutterComponent cutter = world.entity(cutterEntity).getComponent<CsgCutterComponent>();
    AssignCsgCutterTransform(center, rotation, cutter);
    return true;
}

b8 SetSmokeCsgCutterMatrix(in EntityID cutterEntity, in MatrixSingle shapeToWorld, mut World world){
    if(!world.hasComponent<CsgCutterComponent>(cutterEntity))
        return false;
    mut CsgCutterComponent cutter = world.entity(cutterEntity).getComponent<CsgCutterComponent>();
    AssignCsgCutterMatrix(shapeToWorld, cutter);
    return true;
}

void SetSmokeCsgCutterActive(in EntityID cutterEntity, in b8 active, mut World world){
    mut CsgCutterComponent cutter = world.entity(cutterEntity).getComponent<CsgCutterComponent>();
    cutter.active = active;
}


