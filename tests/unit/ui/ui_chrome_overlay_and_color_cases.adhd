class MenuTestSource : IListDataSource{
    public u64 m_generation = 901u;
    public u64 m_revision = 1u;
    public u64 m_baseKey = 100u;

    public u64 instanceGeneration()const override{ return this.m_generation; }
    public u64 revision()const override{ return this.m_revision; }
    public u64 rowCount()const override{ return 3u; }
    public u64 key(in u64 index)const override{ return this.m_baseKey + index; }
    public Expected<u64> indexOf(in u64 value)const override{
        if(value >= this.m_baseKey && value < this.m_baseKey + 3u)
            return value - this.m_baseKey;
        return MakeUnexpected(Failure());
    }
    public Expected<u64> findEnabled(in u64 start, in b8 backwards)const override{
        if(start < 3u)
            return start;
        if(backwards)
            return 2u;
        return 0u;
    }
    public StringView text(in u64 index)const override{
        if(index == 0u)
            return "First";
        if(index == 1u)
            return "Second";
        return "Third";
    }
    public b8 enabled(in u64 index)const override{ return index != 2u; }
}

class ChromeModalDialogTests : WidgetFixture{
    public DialogState m_dialog;
    public u32 m_bgClicks = 0u;
    public u32 m_okClicks = 0u;

    public b8 renderFrame(in u64 generation, in DialogOptions options){
        if(!this.begin(generation))
            return false;
        if(!this.m_builder.beginPanel("panel", Rect(10.0f, 10.0f, 360.0f, 240.0f))){
            this.m_builder.endPanel();
            return false;
        }
        WidgetOptions bgOpts;
        bgOpts.width = LayoutSize(LayoutSizePolicy::Fixed, 120.0f);
        bgOpts.height = LayoutSize(LayoutSizePolicy::Fixed, 32.0f);
        if(this.m_builder.button("bg_btn", "Behind", bgOpts))
            ++this.m_bgClicks;
        if(!this.m_builder.endPanel())
            return false;

        if(this.m_builder.beginModalDialog("dlg", "Confirm", this.m_dialog, options)){
            if(this.m_builder.button("ok", "OK"))
                ++this.m_okClicks;
            if(!this.m_builder.endModalDialog())
                return false;
        }
        return this.finishRoot() && this.m_context.commitFrame(generation);
    }

    public WidgetId dialogCloseId()const{
        const WidgetId rootId = RequireUiRootId(this.m_root);
        const WidgetId dlgId = RequireUiWidgetId(rootId, "dlg");
        const WidgetId hdrId = RequireUiWidgetId(dlgId, s_DialogHeaderScopeKey);
        return RequireUiWidgetId(hdrId, s_DialogCloseButtonKey);
    }

    public Point bgButtonCenter(){
        const auto tgt = this.tryTarget(this.id("bg_btn", "panel"));
        EXPECT_TRUE(tgt.has_value());
        if(!tgt.has_value())
            return Point();
        return CenterUiRect(tgt.value().rectangle);
    }

    public Point closeButtonCenter(){
        const auto tgt = this.tryTarget(this.dialogCloseId());
        EXPECT_TRUE(tgt.has_value());
        if(!tgt.has_value())
            return Point();
        return CenterUiRect(tgt.value().rectangle);
    }
}

class ChromeMenuBarTests : WidgetFixture{
    public MenuTestSource m_fileSource;
    public MenuTestSource m_editSource;
    public MenuBarState m_state;
    public MenuBarResult m_result;

    public ChromeMenuBarTests(){
        this.m_editSource.m_generation = 902u;
        this.m_editSource.m_baseKey = 200u;
    }

    public void buildDefaultMenus(mut Vector<MenuBarMenu> outMenus){
        outMenus.clear();
        MenuBarMenu fileMenu;
        fileMenu.key = 1u;
        fileMenu.label = "File";
        fileMenu.items = Optional<in IListDataSource>(this.m_fileSource);
        outMenus.push_back(fileMenu);

        MenuBarMenu editMenu;
        editMenu.key = 2u;
        editMenu.label = "Edit";
        editMenu.items = Optional<in IListDataSource>(this.m_editSource);
        outMenus.push_back(editMenu);

        MenuBarMenu helpMenu;
        helpMenu.key = 3u;
        helpMenu.label = "Help";
        outMenus.push_back(helpMenu);

        MenuBarMenu disabledMenu;
        disabledMenu.key = 4u;
        disabledMenu.label = "Off";
        disabledMenu.enabled = false;
        outMenus.push_back(disabledMenu);
    }

    public b8 renderBar(in u64 generation, in Span<MenuBarMenu> menus, in MenuBarOptions options){
        if(!this.panel(generation, "panel", Rect(10.0f, 10.0f, 460.0f, 280.0f)))
            return false;
        this.m_result = this.m_builder.menuBar("mbar", menus, this.m_state, options);
        return this.finishPanel() && this.m_context.commitFrame(generation);
    }

    public WidgetId menuBarId()const{
        return this.id("mbar", "panel");
    }

    public Point menuItemCenter(in u64 key){
        const auto root = TryMakeWidgetId(this.menuBarId(), s_WidgetPartMenuItem);
        EXPECT_TRUE(root.has_value());
        const auto part = TryMakeWidgetPartId(root.value(), key);
        EXPECT_TRUE(part.has_value());
        const auto tgt = this.tryTarget(part.value());
        EXPECT_TRUE(tgt.has_value());
        if(!tgt.has_value())
            return Point();
        return CenterUiRect(tgt.value().rectangle);
    }

    public Point dropdownRowCenter(in u64 key){
        const auto listId = TryMakeWidgetId(this.menuBarId(), s_WidgetPartRows);
        EXPECT_TRUE(listId.has_value());
        const auto rowRoot = TryMakeWidgetId(listId.value(), s_WidgetPartRows);
        EXPECT_TRUE(rowRoot.has_value());
        const auto part = TryMakeWidgetPartId(rowRoot.value(), key);
        EXPECT_TRUE(part.has_value());
        const auto tgt = this.tryTarget(part.value());
        EXPECT_TRUE(tgt.has_value());
        if(!tgt.has_value())
            return Point();
        return CenterUiRect(tgt.value().rectangle);
    }
}

class ChromeToolbarStatusTests : WidgetFixture{
    public b8 m_bold = false;
    public u32 m_saveClicks = 0u;

    public b8 renderFrame(in u64 generation){
        if(!this.panel(generation, "panel", Rect(10.0f, 10.0f, 400.0f, 260.0f)))
            return false;

        ToolbarOptions rowOpts;
        rowOpts.direction = LayoutDirection::Row;
        if(!this.m_builder.beginToolbar("row_tb", rowOpts)){
            this.m_builder.endPanel();
            return false;
        }
        if(this.m_builder.toolbarButton("save", "Save"))
            ++this.m_saveClicks;
        this.m_builder.toolbarSeparator("row_sep");
        this.m_builder.toolbarToggle("bold", "Bold", this.m_bold);
        if(!this.m_builder.endToolbar()){
            this.m_builder.endPanel();
            return false;
        }

        ToolbarOptions colOpts;
        colOpts.direction = LayoutDirection::Column;
        colOpts.width = LayoutSize(LayoutSizePolicy::Fixed, 80.0f);
        if(!this.m_builder.beginToolbar("col_tb", colOpts)){
            this.m_builder.endPanel();
            return false;
        }
        this.m_builder.toolbarButton("vbtn", "Tool");
        this.m_builder.toolbarSeparator("col_sep");
        this.m_builder.toolbarButton("vbtn2", "Tool2");
        if(!this.m_builder.endToolbar()){
            this.m_builder.endPanel();
            return false;
        }

        StatusBarOptions sbOpts;
        sbOpts.height = 24.0f;
        if(!this.m_builder.beginStatusBar("sb", sbOpts)){
            this.m_builder.endPanel();
            return false;
        }
        LabelOptions leftLabel;
        leftLabel.width = LayoutSize(LayoutSizePolicy::Stretch, 1.0f);
        leftLabel.ellipsis = true;
        this.m_builder.statusBarSection("left", "Ready", leftLabel);
        this.m_builder.statusBarSection("right", "Ln 1");
        if(!this.m_builder.endStatusBar()){
            this.m_builder.endPanel();
            return false;
        }
        return this.finishPanel() && this.m_context.commitFrame(generation);
    }

    public Point widgetCenter(in StringView key, in StringView toolbarKey){
        const WidgetId barId = this.id(toolbarKey, "panel");
        const auto tgt = this.tryTarget(RequireUiWidgetId(barId, key));
        EXPECT_TRUE(tgt.has_value());
        if(!tgt.has_value())
            return Point();
        return CenterUiRect(tgt.value().rectangle);
    }
}

