Array<SlangStageMapping, 14u> BuildSlangStageMappings(){
    const Array<SlangStageMapping, 14u> mappings(
        SlangStageMapping(ArchiveStageTextFromShaderType(ShaderType::VertexStage), s_SlangStageVertex),
        SlangStageMapping(ArchiveStageTextFromShaderType(ShaderType::HullStage), s_SlangStageHull),
        SlangStageMapping(ArchiveStageTextFromShaderType(ShaderType::DomainStage), s_SlangStageDomain),
        SlangStageMapping(ArchiveStageTextFromShaderType(ShaderType::GeometryStage), s_SlangStageGeometry),
        SlangStageMapping(ArchiveStageTextFromShaderType(ShaderType::PixelStage), s_SlangStageFragment),
        SlangStageMapping(ArchiveStageTextFromShaderType(ShaderType::ComputeStage), s_SlangStageCompute),
        SlangStageMapping(ArchiveStageTextFromShaderType(ShaderType::AmplificationStage), s_SlangStageAmplification),
        SlangStageMapping(ArchiveStageTextFromShaderType(ShaderType::MeshStage), s_SlangStageMesh),
        SlangStageMapping(ArchiveStageTextFromShaderType(ShaderType::RayGenerationStage), s_SlangStageRayGeneration),
        SlangStageMapping(ArchiveStageTextFromShaderType(ShaderType::AnyHitStage), s_SlangStageAnyHit),
        SlangStageMapping(ArchiveStageTextFromShaderType(ShaderType::ClosestHitStage), s_SlangStageClosestHit),
        SlangStageMapping(ArchiveStageTextFromShaderType(ShaderType::MissStage), s_SlangStageMiss),
        SlangStageMapping(ArchiveStageTextFromShaderType(ShaderType::IntersectionStage), s_SlangStageIntersection),
        SlangStageMapping(ArchiveStageTextFromShaderType(ShaderType::CallableStage), s_SlangStageCallable)
    );
    return mappings;
}

StringView ConfiguredSlangExecutable(){
    return NWB_SLANGC_EXECUTABLE;
}

Expected<u64> ComputeSlangCompilerFingerprint(in Path temporaryRoot){
    u64 fingerprint = s_Fnv64OffsetBasis;
    const StringView executable = ConfiguredSlangExecutable();
    const Path compiler(executable);
    BinaryInputStream stream(compiler);
    if(!stream.isOpen()){
        error("ShaderCook: failed to open configured compiler '{}' for fingerprinting", compiler);
        return MakeUnexpected(Failure());
    }
    Array<u8, s_SlangFingerprintReadBufferBytes> bytes;
    while(true){
        const Expected<usize> count = stream.readChunk(bytes);
        if(!count.has_value()){
            error("ShaderCook: failed to read configured compiler '{}' for fingerprinting", compiler);
            return MakeUnexpected(Failure());
        }
        if(count.value() > 0u){
            const Span<u8> buffer(bytes);
            fingerprint = UpdateFnv64(fingerprint, buffer.subspan(0u, count.value()));
        }
        if(count.value() < bytes.size())
            break;
    }
    const Expected<Path> directory = CreateSlangWorkDirectory(temporaryRoot);
    if(!directory.has_value())
        return MakeUnexpected(Failure());
    SlangWorkspaceCleanup cleanup(directory.value());
    const Path versionPath = directory.value() / s_SlangVersionFileName;
    const Expected<String> versionPathText = BuildSlangPathText(versionPath);
    if(!versionPathText.has_value())
        return MakeUnexpected(Failure());
    const Array<StringView, 2u> args(executable, s_SlangVersionArgument);
    const Expected<i32, ProcessExecutionFailure> code = RunProcessRedirectedToFile(args, versionPathText.value());
    if(!code.has_value()){
        error("ShaderCook: failed to execute configured compiler '{}' for version query: process execution failure {}", compiler, cast<u32>(code.error()));
        return MakeUnexpected(Failure());
    }
    if(code.value() != 0){
        error("ShaderCook: configured compiler '{}' version query failed with exit code {}", compiler, code.value());
        return MakeUnexpected(Failure());
    }
    String version;
    const Expected<void, ErrorCode> read = ReadBinaryFile(versionPath, version);
    if(!read.has_value()){
        error("ShaderCook: failed to read configured compiler version '{}': {}", versionPath, ErrorCodeMessage(read.error()));
        return MakeUnexpected(Failure());
    }
    if(!ValidateNonEmptyCompilerVersionText(executable, version))
        return MakeUnexpected(Failure());
    return ShaderSourceFingerprint().finalizeCompilerFingerprint(version, s_CommonCompilerArguments, s_SpirvBaselineCapabilities, BuildSlangStageMappings(), fingerprint);
}

Expected<String> BuildSlangDefineArgument(in ShaderMacroDefinition define, in ShaderCompilerRequest request, in Path overlay){
    usize valueCapacity = define.value.size();
    String mappedValue;
    if(IsPlannedMacroIncludeDefine(request.compilerInputsHaveBom, request.externallyPlannedMacroIncludes, define.name)){
        const StringView name = UnquoteDoubleQuotedView(define.value);
        const Path includePath(name);
        if(!name.empty() && includePath.isAbsolute()){
            const Expected<Path, ErrorCode> absolute = AbsolutePath(includePath);
            if(!absolute.has_value()){
                error("ShaderCook: failed to resolve planned macro include '{}': {}", includePath, ErrorCodeMessage(absolute.error()));
                return MakeUnexpected(Failure());
            }
            const Path normalized = absolute.value().lexicallyNormal();
            const Expected<Path> mappedPath = BuildSlangOverlayPath(overlay, normalized);
            if(!IsSlangCompilerDependencyPath(request.dependencies, normalized) || !mappedPath.has_value()){
                error("ShaderCook: planned macro include '{}' is not a mapped compiler dependency", name);
                return MakeUnexpected(Failure());
            }
            const Expected<String> mapped = BuildSlangPathText(mappedPath.value());
            if(!mapped.has_value())
                return MakeUnexpected(Failure());
            mappedValue.assign(StringView(mapped.value()));
            const Expected<usize> quoted = TryComputeQuotedCompilerPathCapacity(mappedValue.size());
            if(!quoted.has_value())
                return MakeUnexpected(Failure());
            valueCapacity = quoted.value();
        }
    }
    const usize fixed = ComputeCompilerDefineFixedArgumentBytes(s_SlangDefineArgument.size(), !define.value.empty());
    const Expected<usize> capacity = TryComputeCompilerDefineArgumentCapacity(fixed, define.name.size(), valueCapacity);
    if(!capacity.has_value())
        return MakeUnexpected(Failure());
    String argument;
    argument.reserve(capacity.value());
    argument.append(s_SlangDefineArgument);
    argument.append(define.name);
    if(!define.value.empty()){
        argument.push_back('=');
        if(!mappedValue.empty()){
            argument.push_back('"');
            argument.append(StringView(mappedValue));
            argument.push_back('"');
        }
        else
            argument.append(define.value);
    }
    return argument;
}

b8 RunSlangShaderCompiler(in ShaderCompilerRequest request, in Path overlay, in SlangCompilerInputs inputs, in Path output, in Path diagnostics, in StringView slangStage, in StringView optimization){
    const Expected<SlangCompilerArgumentCounts> counts = SlangCompilerRequestValidator().argumentCounts(request.shaderName, inputs.includeDirectories.size(), request.defines.size());
    if(!counts.has_value())
        return false;
    SlangArguments args;
    args.reserve(counts.value().argumentReserve, counts.value().ownedArgumentCount);
    args.views.push_back(ConfiguredSlangExecutable());
    if(!args.appendOwned(BuildSlangPathText(inputs.sourcePath)))
        return false;
    for(in StringView arg : s_CommonCompilerArguments)
        args.views.push_back(arg);
    if(!optimization.empty())
        args.views.push_back(optimization);
    if(request.rayQuery){
        args.views.push_back(s_SlangCapabilityArgument);
        args.views.push_back(s_SpvRayQueryCapabilityText);
    }
    for(in StringView capability : s_SpirvBaselineCapabilities){
        args.views.push_back(s_SlangCapabilityArgument);
        args.views.push_back(capability);
    }
    args.views.push_back(s_SlangEntryPointArgument);
    args.views.push_back(request.entryPoint);
    args.views.push_back(s_SlangStageArgument);
    args.views.push_back(slangStage);
    for(in Path directory : inputs.includeDirectories){
        args.views.push_back(s_SlangIncludeArgument);
        if(!args.appendOwned(BuildSlangPathText(directory)))
            return false;
    }
    for(in ShaderMacroDefinition define : request.defines){
        if(!args.appendOwned(BuildSlangDefineArgument(define, request, overlay)))
            return false;
    }
    args.views.push_back(s_SlangOutputArgument);
    if(!args.appendOwned(BuildSlangPathText(output)))
        return false;
    const Expected<String> diagnosticPath = BuildSlangPathText(diagnostics);
    if(!diagnosticPath.has_value())
        return false;
    const Expected<i32, ProcessExecutionFailure> code = RunProcessRedirectedToFile(args.views, diagnosticPath.value());
    String text;
    const Expected<void, ErrorCode> read = ReadBinaryFile(diagnostics, text);
    if(!code.has_value() || code.value() != 0){
        StringView stage = "process execution failure";
        i64 failure = 0;
        if(code.has_value()){
            stage = "compiler exit code";
            failure = code.value();
        }
        else
            failure = cast<i64>(code.error());
        if(!read.has_value())
            error("Shader compile failed for '{}' (variant '{}'): {} {}; diagnostics read '{}' failed: {}", request.shaderName, request.variantName, stage, failure, diagnostics, ErrorCodeMessage(read.error()));
        else if(!text.empty())
            error("Shader compile failed for '{}' (variant '{}'): {} {} :\n{}", request.shaderName, request.variantName, stage, failure, text);
        else
            error("Shader compile failed for '{}' (variant '{}'): {} {}", request.shaderName, request.variantName, stage, failure);
        return false;
    }
    if(!read.has_value()){
        error("ShaderCook: failed to read compiler diagnostics '{}' for '{}' (variant '{}'): {}", diagnostics, request.shaderName, request.variantName, ErrorCodeMessage(read.error()));
        return false;
    }
    return ValidateUnexpectedCompilerDiagnosticsEmpty(request.shaderName, request.variantName, text);
}

b8 CompileSlangShaderVariant(in ShaderCompilerRequest request, mut Vector<u8> bytecode){
    bytecode.clear();
    const Expected<SlangCompilerValidatedInputs> validated = SlangCompilerRequestValidator().validateInputs(request.shaderName, request.sourcePath.empty(), request.outputPath.empty(), request.entryPoint, request.stage, cast<u8>(request.optimizationLevel), BuildSlangStageMappings());
    if(!validated.has_value())
        return false;
    Path parent = request.outputPath.parentPath();
    if(parent.empty())
        parent = Path(s_CurrentDirectoryPathText);
    const Expected<Path> directory = CreateSlangWorkDirectory(parent);
    if(!directory.has_value())
        return false;
    SlangWorkspaceCleanup cleanup(directory.value());
    const Path diagnostics = directory.value() / s_CompilerDiagFileName;
    const Path output = directory.value() / s_ModuleSpvFileName;
    const Path overlay = directory.value() / s_SourcesDirName;
    const Expected<SlangCompilerInputs> inputs = PrepareSlangCompilerInputs(request, overlay);
    if(!inputs.has_value() || !RunSlangShaderCompiler(request, overlay, inputs.value(), output, diagnostics, validated.value().stage, validated.value().optimization))
        return false;
    const Expected<void, ErrorCode> read = ReadBinaryFile(output, bytecode);
    if(!read.has_value()){
        error("Shader compile failed for '{}' (variant '{}') : failed to read output '{}' : {}", request.shaderName, request.variantName, output, ErrorCodeMessage(read.error()));
        return false;
    }
    const Expected<Optional<Name>, NameTextError> stageName = ToName(request.stage);
    if(!ValidateCompiledShaderStageName(request.shaderName, request.variantName, stageName.has_value() && stageName.value().has_value())){
        bytecode.clear();
        return false;
    }
    const ShaderType shaderType = ShaderTypeFromArchiveStageName(stageName.value().value());
    if(!ValidateCompiledSpirvEntryPoint(request.shaderName, request.variantName, ResolveSpirvEntryPointName(Span<u8>(bytecode), request.entryPoint, ShaderType::ToMask(shaderType)).has_value())){
        bytecode.clear();
        return false;
    }
    const Expected<void, ErrorCode> renamed = RenamePath(output, request.outputPath);
    if(renamed.has_value())
        return true;
    Vector<u8> published;
    if(ReadBinaryFile(request.outputPath, published).has_value() && published == bytecode && ResolveSpirvEntryPointName(Span<u8>(published), request.entryPoint, ShaderType::ToMask(shaderType)).has_value())
        return true;
    error("ShaderCook: failed to publish verified bytecode cache '{}' : {}", request.outputPath, ErrorCodeMessage(renamed.error()));
    bytecode.clear();
    return false;
}


