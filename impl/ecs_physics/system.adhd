    private void collectUniqueEntitiesFromShapes(in Vector<ShapeId> rawShapes, mut Vector<EntityID> outEntities)const{
        outEntities.reserve(rawShapes.size());
        if(rawShapes.size() <= cast<usize>(16u)){
            for(usize i = 0u; i < rawShapes.size(); ++i){
                const EntityID ent = this.entityForShape(rawShapes[i]);
                if(!ent.valid())
                    continue;
                b8 seen = false;
                for(usize j = 0u; j < outEntities.size(); ++j){
                    if(outEntities[j] == ent){
                        seen = true;
                        break;
                    }
                }
                if(!seen)
                    outEntities.push_back(ent);
            }
            return;
        }
        HashSet<EntityID> seenEntities;
        seenEntities.reserve(rawShapes.size());
        for(usize i = 0u; i < rawShapes.size(); ++i){
            const EntityID ent = this.entityForShape(rawShapes[i]);
            if(!ent.valid())
                continue;
            if(seenEntities.insert(ent).second)
                outEntities.push_back(ent);
        }
    }

