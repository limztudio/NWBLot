}

void VerifyUiPopupToolsBuilderTests_OmittedTooltipAttachmentCannotReuseDelayWhileTheAnchorSurvives(mut UiPopupToolsBuilderTests self){
    self.m_tooltipOptions.delaySeconds = 0.5f;
    self.m_deltaSeconds = 0.25f;
    ASSERT_TRUE(self.acceptTools(1u, true, false));
    ASSERT_TRUE(self.moveToAnchor());
    ASSERT_TRUE(self.acceptTools(2u, true, false));
    ASSERT_TRUE(self.acceptTools(3u, true, false));
    EXPECT_FALSE(self.m_tooltip.visible());
    const auto anchorBefore = self.findTarget(self.id(s_UiPopupToolsCaseAnchorKey, s_UiPopupToolsCasePanelKey));
    ASSERT_TRUE(anchorBefore.has_value());
    const u64 anchorDeclaration = anchorBefore.value().declarationGeneration;
    ASSERT_TRUE(self.acceptTools(4u, false, false));
    const auto anchorAfter = self.findTarget(self.id(s_UiPopupToolsCaseAnchorKey, s_UiPopupToolsCasePanelKey));
    ASSERT_TRUE(anchorAfter.has_value());
    EXPECT_EQ(anchorAfter.value().declarationGeneration, anchorDeclaration);
    ASSERT_TRUE(self.acceptTools(5u, true, false));
    EXPECT_FALSE(self.m_tooltip.visible());
    ASSERT_TRUE(self.acceptTools(6u, true, false));
    EXPECT_FALSE(self.m_tooltip.visible());
    ASSERT_TRUE(self.acceptTools(7u, true, false));
    EXPECT_TRUE(self.m_tooltip.visible());
}

void VerifyUiPopupToolsBuilderTests_FullyClippedReplacementGeometrySuppressesPreviouslyVisibleHelp(mut UiPopupToolsBuilderTests self){
    ASSERT_TRUE(self.acceptTools(1u, true, false));
    ASSERT_TRUE(self.moveToAnchor());
    ASSERT_TRUE(self.acceptTools(2u, true, false));
    ASSERT_TRUE(self.m_tooltip.visible());
    ASSERT_TRUE(self.acceptTools(3u, true, false, MakeUiPopupRouterRect(900.0f, 900.0f, 360.0f, 280.0f)));
    EXPECT_FALSE(self.m_tooltip.visible());
    EXPECT_FLOAT_EQ(self.m_tooltip.placement().bounds.width, 0.0f);
    const DrawSnapshot snapshot = self.m_paint.freeze();
    for(in DrawCommand command : snapshot.commands())
        EXPECT_EQ(command.layer, 0u);
}

void VerifyUiPopupToolsBuilderTests_TooltipInsideAPlainPopupPaintsAfterItsOverlayWithoutAddingAnInputScope(mut UiPopupToolsBuilderTests self){
    self.m_plainPopup.open();
    ASSERT_TRUE(self.acceptPopupTooltip(1u));
    const usize targetCount = self.m_context.input().targets().size();
    ASSERT_TRUE(self.moveToAnchor("plain"));
    ASSERT_TRUE(self.acceptPopupTooltip(2u));
    EXPECT_TRUE(self.m_tooltip.visible());
    EXPECT_TRUE(self.m_context.input().hasPopup());
    EXPECT_EQ(self.m_context.input().targets().size(), targetCount);
    EXPECT_FALSE(self.hasTarget(self.id("tip", "plain")));
    EXPECT_EQ(self.m_context.input().focus(), self.id(s_UiPopupToolsCaseAnchorKey, "plain"));
    const DrawSnapshot snapshot = self.m_paint.freeze();
    ASSERT_FALSE(snapshot.commands().empty());
    const auto anchorTarget = self.findTarget(self.id(s_UiPopupToolsCaseAnchorKey, "plain"));
    ASSERT_TRUE(anchorTarget.has_value());
    EXPECT_GT(snapshot.commands().back().layer, anchorTarget.value().layer);
}

void VerifyUiPopupToolsBuilderTests_TooltipRequiresAPrecedingAnchorInTheSameContainer(mut UiPopupToolsBuilderTests self){
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginPanel("panel", MakeUiPopupRouterRect(10.0f, 10.0f, 360.0f, 280.0f)));
    EXPECT_FALSE(self.m_builder.button("anchor", "Anchor", self.m_anchorOptions));
    ASSERT_TRUE(self.m_builder.beginRow("inner"));
    EXPECT_FALSE(self.m_builder.tooltip("tip", "anchor", "Help", self.m_tooltip, self.m_tooltipOptions));
    EXPECT_TRUE(self.m_context.failed());
}

void VerifyUiPopupToolsBuilderTests_MissingTooltipAnchorRejectsTheCandidate(mut UiPopupToolsBuilderTests self){
    ASSERT_TRUE(self.begin(1u));
    ASSERT_TRUE(self.m_builder.beginPanel("panel", MakeUiPopupRouterRect(10.0f, 10.0f, 360.0f, 280.0f)));
