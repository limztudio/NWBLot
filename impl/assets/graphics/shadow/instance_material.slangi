////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#ifndef NWB_GRAPHICS_SHADOW_INSTANCE_MATERIAL_SLANGI
#define NWB_GRAPHICS_SHADOW_INSTANCE_MATERIAL_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include "constants.h"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Per-instance shadow-occluder material keyed by shadow instance id (HW InstanceID() == SW BVH leaf index).
// flags bit0 = isTransparent (1: evaluate transmittance hook and continue; 0: opaque stop); surface and BXDF dispatch ids are separate domains.
// materialConstantByteOffset + meshInstanceIndex reconstruct the surface hook's constants context. Mirrors NwbRtInstanceMaterialGpu.
struct NwbRtInstanceMaterial{
    uint shadowTransmittanceModelId;
    uint flags;
    uint shadingModelId;
    uint materialConstantByteOffset;
    uint meshInstanceIndex;
    // Per-buffer descriptor-heap slots for this occluder's mesh geometry. The host registers each backing buffer and
    // stores the returned slot here; shaders read through NwbHeapRawBuffer(<x>Slot). indexSlot, attributeSlot, and
    // positionSlot are set by both shadow builders; nodeSlot is SW-only and stays invalid on hardware-built records.
    uint indexSlot;
    uint attributeSlot;
    uint positionSlot;
    uint nodeSlot;
};

// flags bit1 = isRefractive for the caustic producer (shadow trace ignores it: the surface hook supplies optical
// params; visibility integrates the true volume path).


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

