NWB_ADHD_GTEST(AssetsFontMetadata, BunchRejectsInvalidAndDuplicateChildrenWithoutPublication, VerifyAssetsFontMetadata_BunchRejectsInvalidAndDuplicateChildrenWithoutPublication)
NWB_ADHD_GTEST(AssetsFontMetadata, FieldlessAndEmptyFontDeclarationsRejectNonmapValues, VerifyAssetsFontMetadata_FieldlessAndEmptyFontDeclarationsRejectNonmapValues)
NWB_ADHD_GTEST(AssetsFontMetadata, UnsupportedAndCorruptVisibleMetadataAreRejected, VerifyAssetsFontMetadata_UnsupportedAndCorruptVisibleMetadataAreRejected)
NWB_ADHD_GTEST(AssetsFontMetadata, IncompleteAndInvalidGlyphMappingsAreRejected, VerifyAssetsFontMetadata_IncompleteAndInvalidGlyphMappingsAreRejected)
NWB_ADHD_GTEST(AssetsFontMetadata, MissingTruncatedCorruptAndMismatchedFontSourcesAreRejected, VerifyAssetsFontMetadata_MissingTruncatedCorruptAndMismatchedFontSourcesAreRejected)


