void VerifyUiContextTests_ReorderedDeclarationsAndScopedKeysRetainTheirExactIdentityAndLifetime(mut UiContextTests self){
    const WidgetRoot root = MakeUiContextRoot(11u, 1u);
    ASSERT_TRUE(self.m_context.beginFrame(1u));
    ASSERT_TRUE(self.m_context.beginRoot(root));
    Expected<WidgetState> first = self.declareState(s_UiContextActionKey, WidgetKind::Button);
    ASSERT_TRUE(first.has_value());
    const WidgetState original = first.value();
    ASSERT_TRUE(self.m_context.pushScope("nested"));
    Expected<WidgetState> nested = self.declareState(s_UiContextActionKey, WidgetKind::Button);
    ASSERT_TRUE(nested.has_value());
    const WidgetState nestedOriginal = nested.value();
    EXPECT_NE(original.id, nestedOriginal.id);
    ASSERT_TRUE(self.m_context.popScope());
    ASSERT_TRUE(self.m_context.endRoot());
    ASSERT_TRUE(self.m_context.finishFrame());
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    ASSERT_TRUE(self.m_context.beginFrame(2u));
    ASSERT_TRUE(self.m_context.beginRoot(root));
    ASSERT_TRUE(self.m_context.pushScope("nested"));
    nested = self.declareState(s_UiContextActionKey, WidgetKind::Button);
    ASSERT_TRUE(nested.has_value());
    EXPECT_EQ(nested.value().id, nestedOriginal.id);
    EXPECT_EQ(nested.value().declarationGeneration, nestedOriginal.declarationGeneration);
    ASSERT_TRUE(self.m_context.popScope());
    first = self.declareState(s_UiContextActionKey, WidgetKind::Button);
    ASSERT_TRUE(first.has_value());
    EXPECT_EQ(first.value().id, original.id);
    EXPECT_EQ(first.value().declarationGeneration, original.declarationGeneration);
    ASSERT_TRUE(self.m_context.endRoot());
    ASSERT_TRUE(self.m_context.finishFrame());
    ASSERT_TRUE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_context.states().entries().size(), 2u);
}

void VerifyUiContextTests_DuplicateStableKeysPoisonTheCurrentBuildAndCannotPublishIt(mut UiContextTests self){
    const Expected<WidgetState> originalResult = self.prepare(1u, MakeUiContextRoot(21u, 1u));
    ASSERT_TRUE(originalResult.has_value());
    const WidgetState original = originalResult.value();
    ASSERT_TRUE(self.m_context.commitFrame(1u));
    ASSERT_TRUE(self.m_context.beginFrame(2u));
    ASSERT_TRUE(self.m_context.beginRoot(original.root));
    ASSERT_TRUE(self.declareState(s_UiContextActionKey, WidgetKind::Button).has_value());
    EXPECT_FALSE(self.declareState(s_UiContextActionKey, WidgetKind::Button).has_value());
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.declareState("another", WidgetKind::Label).has_value());
    EXPECT_FALSE(self.m_context.endRoot());
    EXPECT_FALSE(self.m_context.finishFrame());
    EXPECT_FALSE(self.m_context.commitFrame(2u));
    EXPECT_EQ(self.m_context.input().layoutGeneration(), 1u);
    EXPECT_EQ(self.m_context.input().hitTest(MakeUiContextPoint(15.0f, 25.0f)), original.id);
    self.m_context.abandonFrame();
    EXPECT_TRUE(self.m_context.beginFrame(3u));
}

void VerifyUiContextTests_UnbalancedOrEmptyScopesPoisonTheBuildUntilAbandonment(mut UiContextTests self){
    ASSERT_TRUE(self.m_context.beginFrame(1u));
    ASSERT_TRUE(self.m_context.beginRoot(MakeUiContextRoot(31u, 1u)));
    ASSERT_TRUE(self.m_context.pushScope("panel"));
    ASSERT_TRUE(self.declareState(s_UiContextActionKey, WidgetKind::Button).has_value());
    EXPECT_FALSE(self.m_context.endRoot());
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.finishFrame());
    EXPECT_FALSE(self.m_context.ready());
    self.m_context.abandonFrame();
    ASSERT_TRUE(self.m_context.beginFrame(2u));
    ASSERT_TRUE(self.m_context.beginRoot(MakeUiContextRoot(31u, 1u)));
    EXPECT_FALSE(self.m_context.popScope());
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.finishFrame());
    self.m_context.abandonFrame();
    ASSERT_TRUE(self.m_context.beginFrame(3u));
    ASSERT_TRUE(self.m_context.beginRoot(MakeUiContextRoot(31u, 1u)));
    EXPECT_FALSE(self.m_context.pushScope(""));
    EXPECT_TRUE(self.m_context.failed());
    EXPECT_FALSE(self.m_context.finishFrame());
}

void VerifyUiContextTests_FinishingAnOpenRootDoesNotPublishItsPartialDeclarations(mut UiContextTests self){
    ASSERT_TRUE(self.m_context.beginFrame(1u));
    ASSERT_TRUE(self.m_context.beginRoot(MakeUiContextRoot(41u, 1u)));
