#include <impl/ecs_render/csg/transparent_interval_payloads.adhd>
#include <impl/ecs_render/csg/task_graph_transparent_interval_tasks.adhd>
#include <impl/ecs_render/avboit/task_graph_occupancy_tasks.adhd>
#include <impl/ecs_render/avboit/avboit_system.adhd>
#include <impl/ecs_render/material/task_graph_object_geometry_cache.adhd>
#include <impl/ecs_render/csg/graph_types.adhd>
#include <impl/ecs_render/deferred/import_types.adhd>
#include <impl/ecs_render/kernel/graphics_prefix_timing_ticket.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class FrameGraphTransparentCsgTaskInputs{
    public in DeferredGraphResourceImportResult resources;
    public GraphicsPrefixTimingTicket timingTicket;
    public TransparentCsgIntervalProducerResult producer;

    public FrameGraphTransparentCsgTaskInputs(
        in DeferredGraphResourceImportResult resources,
        in GraphicsPrefixTimingTicket timingTicket,
        in TransparentCsgIntervalProducerResult producer
    ){
        this.resources = resources;
        this.timingTicket = timingTicket;
        this.producer = producer;
    }
}


[modular]
class FrameGraphTransparentCsgTasks : NoCopy{
    private mut GpuTaskGraph m_graph;
    private mut RendererAvboitSystem m_avboitSystem;

    public FrameGraphTransparentCsgTasks(mut GpuTaskGraph graph, mut RendererAvboitSystem avboitSystem){
        this.m_graph = graph;
        this.m_avboitSystem = avboitSystem;
    }

    public Expected<FrameGraphTransparentCsgTaskResult> declare(
        in FrameGraphTransparentCsgTaskInputs inputs,
        mut ObjectGeometryCacheGraph objectGeometry,
        mut AvboitPreGraphTaskPayload prePayload,
        mut TransparentCsgIntervalRecordInputs receiverSpanPayload,
        mut TransparentCsgIntervalRecordInputs intervalCombinePayload
    );
}


