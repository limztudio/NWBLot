namespace __hidden_ui_nested_popup_context_tests{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


using namespace NWB;
using namespace NWB::Impl::Ui;

inline constexpr AStringView s_ParentPopupKey = "parent";
inline constexpr AStringView s_ChildPopupKey = "child";

struct PopupDeclaration{
    WidgetState owner;
    WidgetState action;
    PopupScope scope;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class UiNestedPopupContextTests : public UiTestSupport::ContextTestFixture{
public:
    UiNestedPopupContextTests()
        : ContextTestFixture(Name(NWB::Tests::UiCases::s_UiCaseTestsUiNestedPopupContext))
    {}


public:
    [[nodiscard]] b8 begin(const u64 generation){
        return m_context.beginFrame(generation) && m_context.beginRoot({ 1401u, 1u });
    }

    [[nodiscard]] Expected<WidgetState> declareState(const AStringView key, const WidgetKind::Enum kind){
        const auto declared = m_context.declare(key, kind);
        EXPECT_TRUE(declared);
        if(!declared)
            return MakeUnexpected(Failure{});
        return **declared;
    }

    [[nodiscard]] Optional<HitTarget> findTarget(const WidgetId widget)const noexcept{
        if(const HitTarget* found = UiTestSupport::FindHitTarget(m_context.input().targets(), widget))
            return *found;
        return {};
    }

    [[nodiscard]] b8 hasTarget(const WidgetId widget)const noexcept{
        return UiTestSupport::FindHitTarget(m_context.input().targets(), widget) != nullptr;
    }

    [[nodiscard]] Expected<PopupDeclaration> reserve(const AStringView key, const Rect& bounds = { 60.0f, 40.0f, 120.0f, 80.0f }){
        PopupDeclaration result;
        const auto owner = m_context.declare(key, WidgetKind::Popup);
        EXPECT_TRUE(owner);
        if(!owner)
            return MakeUnexpected(owner.error());
        result.owner = **owner;
        result.scope.token = { (*owner)->id, (*owner)->declarationGeneration, 900u, 1u };
        result.scope.bounds = bounds;
        result.scope.viewport = { 0.0f, 0.0f, 400.0f, 300.0f };
        result.scope.parent = m_context.popupToken();
        EXPECT_TRUE(m_context.registerPopupScope(result.owner, result.scope));
        const auto action = m_context.declarePart(result.owner, "action", WidgetKind::Button);
        EXPECT_TRUE(action);
        if(!action)
            return MakeUnexpected(action.error());
        result.action = **action;
        return result;
    }

    [[nodiscard]] b8 publish(const PopupDeclaration& popup);

    [[nodiscard]] b8 finish(){
        return m_context.endRoot() && m_context.finishFrame();
    }
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


