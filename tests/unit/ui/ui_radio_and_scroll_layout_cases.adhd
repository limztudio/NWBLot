void VerifyUiScrollLayoutTests_RowBoundsRejectsCulledAndInvalidRows(){
    const Rect bounds = Rect(10.0f, 20.0f, 200.0f, 100.0f);
    const auto placementResult = CalculateScrollPlacement(bounds, bounds, Insets(), 12.0f, 16.0f, 20u, 20.0f, 40.0);
    ASSERT_TRUE(placementResult.has_value());
    ScrollPlacement placement = placementResult.value();
    EXPECT_FALSE(CalculateScrollRowBounds(1u, placement, 20.0f).has_value());
    EXPECT_FALSE(CalculateScrollRowBounds(7u, placement, 20.0f).has_value());
    EXPECT_FALSE(CalculateScrollRowBounds(u64.max, placement, 20.0f).has_value());
    EXPECT_FALSE(CalculateScrollRowBounds(2u, placement, bit_cast<f32>(s_UiRadioScrollQuietNaNF32Bits)).has_value());
    placement.offset = bit_cast<f64>(s_UiRadioScrollPosInfF64Bits);
    EXPECT_FALSE(CalculateScrollRowBounds(2u, placement, 20.0f).has_value());
}

void VerifyUiScrollLayoutTests_ExtentsBeyondDoubleViewportPrecisionFailInsteadOfLosingTheFinalPage(){
    const Rect bounds = Rect(0.0f, 0.0f, 200.0f, 100.0f);
    EXPECT_FALSE(CalculateScrollPlacement(bounds, bounds, Insets(), 12.0f, 16.0f, u64.max, f32.max, f64.max).has_value());
}

void VerifyUiScrollLayoutTests_InvalidLayoutInputsRejectPlacement(){
    const Rect validBounds = Rect(10.0f, 20.0f, 200.0f, 100.0f);
    const Insets validPadding = MakeUiRadioScrollInsets(4.0f, 8.0f, 12.0f, 16.0f);
    const f32 nanF32 = bit_cast<f32>(s_UiRadioScrollQuietNaNF32Bits);
    const f32 posInfF32 = bit_cast<f32>(s_UiRadioScrollPosInfF32Bits);
    const f32 negInfF32 = bit_cast<f32>(s_UiRadioScrollNegInfF32Bits);
    const f64 nanF64 = bit_cast<f64>(s_UiRadioScrollQuietNaNF64Bits);

    Rect bounds = validBounds;
    bounds.x = nanF32;
    ExpectUiScrollLayoutRejected(bounds, validBounds, validPadding, 12.0f, 16.0f, 20.0f, 40.0);
    bounds = validBounds;
    bounds.width = -1.0f;
    ExpectUiScrollLayoutRejected(bounds, validBounds, validPadding, 12.0f, 16.0f, 20.0f, 40.0);
    bounds = Rect(f32.max, 0.0f, f32.max, 100.0f);
    ExpectUiScrollLayoutRejected(bounds, validBounds, validPadding, 12.0f, 16.0f, 20.0f, 40.0);
    Rect clip = validBounds;
    clip.height = posInfF32;
    ExpectUiScrollLayoutRejected(validBounds, clip, validPadding, 12.0f, 16.0f, 20.0f, 40.0);
    clip = validBounds;
    clip.y = negInfF32;
    ExpectUiScrollLayoutRejected(validBounds, clip, validPadding, 12.0f, 16.0f, 20.0f, 40.0);
    Insets padding = validPadding;
    padding.left = -1.0f;
    ExpectUiScrollLayoutRejected(validBounds, validBounds, padding, 12.0f, 16.0f, 20.0f, 40.0);
    padding = validPadding;
    padding.bottom = nanF32;
    ExpectUiScrollLayoutRejected(validBounds, validBounds, padding, 12.0f, 16.0f, 20.0f, 40.0);
    ExpectUiScrollLayoutRejected(validBounds, validBounds, validPadding, -1.0f, 16.0f, 20.0f, 40.0);
    ExpectUiScrollLayoutRejected(validBounds, validBounds, validPadding, posInfF32, 16.0f, 20.0f, 40.0);
    ExpectUiScrollLayoutRejected(validBounds, validBounds, validPadding, 12.0f, -1.0f, 20.0f, 40.0);
    ExpectUiScrollLayoutRejected(validBounds, validBounds, validPadding, 12.0f, nanF32, 20.0f, 40.0);
    ExpectUiScrollLayoutRejected(validBounds, validBounds, validPadding, 12.0f, 16.0f, 0.0f, 40.0);
    ExpectUiScrollLayoutRejected(validBounds, validBounds, validPadding, 12.0f, 16.0f, posInfF32, 40.0);
    ExpectUiScrollLayoutRejected(validBounds, validBounds, validPadding, 12.0f, 16.0f, 20.0f, -1.0);
    ExpectUiScrollLayoutRejected(validBounds, validBounds, validPadding, 12.0f, 16.0f, 20.0f, nanF64);
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void VerifyUiScrollStateTests_IndependentAndRecreatedStatesHaveUniqueNonzeroIdentity(){
    u64 retiredIdentity = 0u;
    {
        ScrollState retired = ScrollState();
        retiredIdentity = retired.instanceGeneration();
    }
    ScrollState first = ScrollState();
    ScrollState second = ScrollState();
    EXPECT_NE(first.instanceGeneration(), retiredIdentity);
    EXPECT_NE(second.instanceGeneration(), retiredIdentity);
    EXPECT_NE(first.instanceGeneration(), second.instanceGeneration());
}

void VerifyUiScrollStateTests_OffsetAcceptsFiniteNonnegativeValuesAndRejectsInvalidAtomically(){
    ScrollState state = ScrollState();
    const u64 identity = state.instanceGeneration();
    ASSERT_TRUE(state.setOffset(45.25));
    EXPECT_DOUBLE_EQ(state.offset(), 45.25);
    EXPECT_FALSE(state.setOffset(-1.0));
    EXPECT_FALSE(state.setOffset(bit_cast<f64>(s_UiRadioScrollQuietNaNF64Bits)));
    EXPECT_FALSE(state.setOffset(bit_cast<f64>(s_UiRadioScrollPosInfF64Bits)));
    EXPECT_DOUBLE_EQ(state.offset(), 45.25);
    ASSERT_TRUE(state.setOffset(f64.max));
    EXPECT_DOUBLE_EQ(state.offset(), f64.max);
    ASSERT_TRUE(state.setOffset(bit_cast<f64>(s_UiRadioScrollNegZeroF64Bits)));
    EXPECT_DOUBLE_EQ(state.offset(), 0.0);
    EXPECT_EQ(state.instanceGeneration(), identity);
}

void VerifyUiScrollStateTests_OversizedRowsAlignTheirStartAndZeroViewportCanStoreTheirStart(){
    ScrollState state = ScrollState();
    ASSERT_TRUE(state.setOffset(100.0));
    ASSERT_TRUE(state.ensureVisible(120.0, 320.0, 80.0));
    EXPECT_DOUBLE_EQ(state.offset(), 120.0);
    ASSERT_TRUE(state.ensureVisible(300.0, 320.0, 0.0));
    EXPECT_DOUBLE_EQ(state.offset(), 300.0);
}

void VerifyUiScrollStateTests_EnsureVisibleAvoidsOffsetPlusViewportOverflow(){
    ScrollState state = ScrollState();
    const f64 large = f64.max * 0.75;
    ASSERT_TRUE(state.setOffset(large));
    ASSERT_TRUE(state.ensureVisible(large, f64.max, large));
    EXPECT_DOUBLE_EQ(state.offset(), large);
}

void VerifyUiScrollStateTests_InvalidEnsureVisibleRequestsLeaveTheOffsetUntouched(){
    ScrollState state = ScrollState();
    ASSERT_TRUE(state.setOffset(75.0));
    EXPECT_FALSE(state.ensureVisible(-1.0, 40.0, 100.0));
    EXPECT_FALSE(state.ensureVisible(60.0, 40.0, 100.0));
    EXPECT_FALSE(state.ensureVisible(0.0, bit_cast<f64>(s_UiRadioScrollPosInfF64Bits), 100.0));
    EXPECT_FALSE(state.ensureVisible(0.0, 40.0, -1.0));
    EXPECT_FALSE(state.ensureVisible(0.0, 40.0, bit_cast<f64>(s_UiRadioScrollQuietNaNF64Bits)));
    EXPECT_DOUBLE_EQ(state.offset(), 75.0);
}

void VerifyUiScrollStateTests_ScrollByClampsBothEndsAndAppliesDeltaAfterContentShrink(){
    ScrollState state = ScrollState();
    ASSERT_TRUE(state.setOffset(50.0));
    ASSERT_TRUE(state.scrollBy(-1000.0, 400.0, 100.0));
    EXPECT_DOUBLE_EQ(state.offset(), 0.0);
    ASSERT_TRUE(state.scrollBy(1000.0, 400.0, 100.0));
    EXPECT_DOUBLE_EQ(state.offset(), 300.0);
    ASSERT_TRUE(state.scrollBy(-20.0, 200.0, 100.0));
    EXPECT_DOUBLE_EQ(state.offset(), 80.0);
}

void VerifyUiScrollStateTests_ExtremeDeltaAndOffsetDoNotOverflowWhenClamping(){
    ScrollState state = ScrollState();
    ASSERT_TRUE(state.setOffset(f64.max));
    ASSERT_TRUE(state.scrollBy(f64.max, 400.0, 100.0));
    EXPECT_DOUBLE_EQ(state.offset(), 300.0);
    ASSERT_TRUE(state.scrollBy(-f64.max, 400.0, 100.0));
    EXPECT_DOUBLE_EQ(state.offset(), 0.0);
    ASSERT_TRUE(state.scrollBy(f64.max, f64.max, 0.0));
    EXPECT_DOUBLE_EQ(state.offset(), f64.max);
}

void VerifyUiScrollStateTests_ClampSupportsEmptyContentAndCollapsedViewports(){
    ScrollState state = ScrollState();
    ASSERT_TRUE(state.setOffset(350.0));
    ASSERT_TRUE(state.clamp(400.0, 100.0));
    EXPECT_DOUBLE_EQ(state.offset(), 300.0);
    ASSERT_TRUE(state.clamp(400.0, 0.0));
    EXPECT_DOUBLE_EQ(state.offset(), 300.0);
    ASSERT_TRUE(state.clamp(50.0, 100.0));
    EXPECT_DOUBLE_EQ(state.offset(), 0.0);
    ASSERT_TRUE(state.setOffset(20.0));
    ASSERT_TRUE(state.clamp(0.0, 0.0));
    EXPECT_DOUBLE_EQ(state.offset(), 0.0);
}

void VerifyUiScrollStateTests_InvalidScrollAndClampRangesLeaveTheOffsetUntouched(){
    ScrollState state = ScrollState();
    ASSERT_TRUE(state.setOffset(75.0));
    EXPECT_FALSE(state.scrollBy(bit_cast<f64>(s_UiRadioScrollQuietNaNF64Bits), 400.0, 100.0));
    EXPECT_FALSE(state.scrollBy(10.0, -1.0, 100.0));
    EXPECT_FALSE(state.scrollBy(10.0, 400.0, -1.0));
    EXPECT_FALSE(state.scrollBy(10.0, bit_cast<f64>(s_UiRadioScrollPosInfF64Bits), 100.0));
    EXPECT_FALSE(state.clamp(-1.0, 100.0));
    EXPECT_FALSE(state.clamp(400.0, bit_cast<f64>(s_UiRadioScrollQuietNaNF64Bits)));
    EXPECT_DOUBLE_EQ(state.offset(), 75.0);
}


