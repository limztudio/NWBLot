Expected<PhysicsMaterialAsset> BuildPhysicsMaterialAsset(in PhysicsMaterialCookEntry entry){
    PhysicsMaterialAsset asset(entry.virtualPath);
    asset.setMaterial(entry.material);
    if(!asset.validatePayload())
        return MakeUnexpected(Failure());
    return asset;
}

Expected<CollisionLayerMatrixAsset> BuildCollisionLayerMatrixAsset(in CollisionLayerMatrixCookEntry entry){
    CollisionLayerMatrixAsset asset(entry.virtualPath);
    asset.setMatrix(entry.matrix);
    if(!asset.validatePayload())
        return MakeUnexpected(Failure());
    return asset;
}

Expected<ConvexHullAsset> BuildConvexHullAsset(in ConvexHullCookEntry entry){
    ConvexHullAsset asset(entry.virtualPath);
    asset.setHull(entry.hull);
    if(!asset.validatePayload())
        return MakeUnexpected(Failure());
    return asset;
}

Expected<CompoundHullAsset> BuildCompoundHullAsset(in CompoundHullCookEntry entry){
    CompoundHullAsset asset(entry.virtualPath);
    asset.setHulls(entry.hulls);
    if(!asset.validatePayload())
        return MakeUnexpected(Failure());
    return asset;
}

Expected<CollisionMeshAsset> BuildCollisionMeshAsset(in CollisionMeshCookEntry entry){
    CollisionMeshAsset asset(entry.virtualPath);
    asset.setMesh(entry.mesh);
    if(!asset.validatePayload())
        return MakeUnexpected(Failure());
    return asset;
}

Expected<HeightfieldAsset> BuildHeightfieldAsset(in HeightfieldCookEntry entry){
    HeightfieldAsset asset(entry.virtualPath);
    if(entry.heightfield.hierarchy.empty()){
        HeightfieldShape hf = entry.heightfield;
        hf.buildHierarchy();
        asset.setHeightfield(hf);
    }
    else{
        asset.setHeightfield(entry.heightfield);
    }
    if(!asset.validatePayload())
        return MakeUnexpected(Failure());
    return asset;
}

Expected<SdfAsset> BuildSdfAsset(in SdfCookEntry entry){
    SdfAsset asset(entry.virtualPath);
    asset.setSdf(entry.sdf);
    if(!asset.validatePayload())
        return MakeUnexpected(Failure());
    return asset;
}

Expected<ChainShapeAsset> BuildChainShapeAsset(in ChainShapeCookEntry entry){
    ChainShapeAsset asset(entry.virtualPath);
    asset.setChain(entry.chain);
    if(!asset.validatePayload())
        return MakeUnexpected(Failure());
    return asset;
}

Expected<CompoundShapeAsset> BuildCompoundShapeAsset(in CompoundShapeCookEntry entry){
    CompoundShapeAsset asset(entry.virtualPath);
    asset.setCompound(entry.compound);
    if(!asset.validatePayload())
        return MakeUnexpected(Failure());
    return asset;
}


