void VerifyUiSliderMathTests_OutOfRangeAndConstantSpansClampNormalization(){
    auto normalized = UiSliderNormalize(10.0, 30.0, -100.0);
    ASSERT_TRUE(normalized.has_value());
    EXPECT_EQ(normalized.value(), 0.0);
    normalized = UiSliderNormalize(10.0, 30.0, 100.0);
    ASSERT_TRUE(normalized.has_value());
    EXPECT_EQ(normalized.value(), 1.0);
    normalized = UiSliderNormalize(10.0, 10.0, 100.0);
    ASSERT_TRUE(normalized.has_value());
    EXPECT_EQ(normalized.value(), 0.0);
}

void VerifyUiSliderMathTests_OppositeExtremeBoundsNormalizeAndInterpolateWithoutAnOverflowingSpan(){
    const f64 maximum = f64.max;
    const f64 minimum = -maximum;
    auto value = UiSliderNormalize(minimum, maximum, 0.0);
    ASSERT_TRUE(value.has_value());
    EXPECT_DOUBLE_EQ(value.value(), 0.5);
    value = UiSliderNormalize(minimum, maximum, maximum * 0.5);
    ASSERT_TRUE(value.has_value());
    EXPECT_DOUBLE_EQ(value.value(), 0.75);
    value = UiSliderInterpolate(minimum, maximum, 0.25);
    ASSERT_TRUE(value.has_value());
    EXPECT_TRUE(IsFinite(value.value()));
    EXPECT_DOUBLE_EQ(value.value() / maximum, -0.5);
    value = UiSliderInterpolate(minimum, maximum, 0.75);
    ASSERT_TRUE(value.has_value());
    EXPECT_DOUBLE_EQ(value.value() / maximum, 0.5);
}

void VerifyUiSliderMathTests_SameSignExtremeBoundsUseABoundedDifference(){
    const f64 maximum = f64.max;
    // Lanes are the positive and negative bounds.
    const VectorDouble bounds = VectorDouble(maximum, -maximum, 0.0, 0.0);
    const VectorDouble threeQuarters = bounds * VectorDouble(0.75, 0.75, 0.75, 0.75);
    Array<b8, 2u> signs;
    signs[0u] = false;
    signs[1u] = true;
    for(in b8 negative : signs){
        f64 minimum = threeQuarters.x;
        f64 upper = maximum;
        if(negative){
            minimum = bounds.y;
            upper = threeQuarters.y;
        }
        const auto value = UiSliderInterpolate(minimum, upper, 0.5);
        ASSERT_TRUE(value.has_value());
        EXPECT_TRUE(IsFinite(value.value()));
        EXPECT_GE(value.value(), minimum);
        EXPECT_LE(value.value(), upper);
        const auto normalized = UiSliderNormalize(minimum, upper, value.value());
        ASSERT_TRUE(normalized.has_value());
        EXPECT_NEAR(normalized.value(), 0.5, 1.0e-15);
    }
}

void VerifyUiSliderMathTests_TinyAndAdjacentSpansStayInTheOrdinaryNormalizationPath(){
    const f64 tiny = bit_cast<f64>(cast<u64>(1u));
    auto normalized = UiSliderNormalize(-tiny, tiny, 0.0);
    ASSERT_TRUE(normalized.has_value());
    EXPECT_DOUBLE_EQ(normalized.value(), 0.5);
    normalized = UiSliderNormalize(tiny, bit_cast<f64>(cast<u64>(2u)), tiny);
    ASSERT_TRUE(normalized.has_value());
    EXPECT_DOUBLE_EQ(normalized.value(), 0.0);
    const f64 lower = bit_cast<f64>(cast<u64>(0x3ff0000000000000u));
    const f64 upper = bit_cast<f64>(cast<u64>(0x3ff0000000000001u));
    normalized = UiSliderNormalize(lower, upper, upper);
    ASSERT_TRUE(normalized.has_value());
    EXPECT_DOUBLE_EQ(normalized.value(), 1.0);
    const auto value = UiSliderInterpolate(lower, upper, 1.0);
    ASSERT_TRUE(value.has_value());
    EXPECT_EQ(bit_cast<u64>(value.value()), bit_cast<u64>(upper));
}

void VerifyUiSliderMathTests_InterpolationPreservesExactEndpointAndSignedZeroBits(){
    const f64 negZero = bit_cast<f64>(s_UiSliderNegZeroF64Bits);
    auto value = UiSliderInterpolate(negZero, 1.0, 0.0);
    ASSERT_TRUE(value.has_value());
    EXPECT_EQ(bit_cast<u64>(value.value()), s_UiSliderNegZeroF64Bits);
    value = UiSliderInterpolate(-1.0, 0.0, 1.0);
    ASSERT_TRUE(value.has_value());
    EXPECT_EQ(bit_cast<u64>(value.value()), 0u);
    value = UiSliderInterpolate(negZero, 0.0, 0.0);
    ASSERT_TRUE(value.has_value());
    EXPECT_EQ(bit_cast<u64>(value.value()), s_UiSliderNegZeroF64Bits);
    value = UiSliderInterpolate(negZero, 0.0, 1.0);
    ASSERT_TRUE(value.has_value());
    EXPECT_EQ(bit_cast<u64>(value.value()), 0u);
}

void VerifyUiSliderMathTests_InvalidRangeValueOrNormalizedInputRejectsTheQuery(){
    for(u32 field = 0u; field < 7u; ++field){
        f64 minimum = 0.0;
        f64 maximum = 1.0;
        f64 query = 0.5;
        switch(field){
        case 0u:
            minimum = 2.0;
            break;
        case 1u:
            minimum = bit_cast<f64>(s_UiSliderQuietNaNF64Bits);
            break;
        case 2u:
            maximum = bit_cast<f64>(s_UiSliderPosInfF64Bits);
            break;
        case 3u:
            query = bit_cast<f64>(s_UiSliderPosInfF64Bits);
            break;
        case 4u:
            query = bit_cast<f64>(s_UiSliderQuietNaNF64Bits);
            break;
        case 5u:
            query = -0.1;
            break;
        default:
            query = 1.1;
            break;
        }
        if(field < 5u)
            EXPECT_FALSE(UiSliderNormalize(minimum, maximum, query).has_value());
        EXPECT_FALSE(UiSliderInterpolate(minimum, maximum, query).has_value());
    }
}


