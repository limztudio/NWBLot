#include <tests/common/gtest_macros.adhd>
#include "ui_fixture_widget_base.adhd"


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_ComboPanelKey = "panel";
const StringView s_ComboKey = "combo";
const StringView s_SecondComboKey = "other";


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


interface IComboCallbackObserver{
    void observeCallback()const;
}

[extensible]
class ComboSource : IListDataSource, IComboCallbackObserver{
    public u64 count = 100000u;
    public u64 generation = 701u;
    public u64 contentRevision = 1u;
    public u64 removed = 0u;
    public u64 disabled = 0u;
    public TestObserved<u64> keyCalls;
    public TestObserved<u64> lookupCalls;
    public TestObserved<u64> searchCalls;
    public TestObserved<u64> textCalls;
    public TestObserved<u64> enabledCalls;
    public b8 reverse = false;

    public u64 instanceGeneration()const override{ this.observeCallback(); return this.generation; }
    public u64 revision()const override{ return this.baseRevision(); }
    protected u64 baseRevision()const{ this.observeCallback(); return this.contentRevision; }
    public u64 rowCount()const override{ this.observeCallback(); return this.count; }
    public u64 key(in u64 index)const override{ return this.baseKey(index); }
    protected u64 baseKey(in u64 index)const{ this.observeCallback(); ++this.keyCalls.value(); return this.rawKey(index); }
    public Expected<u64> indexOf(in u64 value)const override{ return this.baseIndexOf(value); }
    protected Expected<u64> baseIndexOf(in u64 value)const{
        this.observeCallback();
        ++this.lookupCalls.value();
        return FindArithmeticFixtureRowIndex(this.count, this.removed, this.reverse, value);
    }
    public Expected<u64> findEnabled(in u64 start, in b8 backwards)const override{
        this.observeCallback();
        ++this.searchCalls.value();
        return FindSingleDisabledFixtureRow(this.count, this.removed, this.reverse, start, backwards, this.disabled);
    }
    public StringView text(in u64 index)const override{ return this.baseText(index); }
    protected StringView baseText(in u64 index)const{
        this.observeCallback();
        ++this.textCalls.value();
        if(index % 2u == 0u)
            return "First";
        return "Second";
    }
    public b8 enabled(in u64 index)const override{ return this.baseEnabled(index); }
    protected b8 baseEnabled(in u64 index)const{
        this.observeCallback();
        ++this.enabledCalls.value();
        return index < this.count && this.rawKey(index) != this.disabled;
    }
    public void resetCounters()const{ ResetComboSourceCounters(this); }
    public void observeCallback()const override{ }
    protected u64 rawKey(in u64 index)const{
        return ArithmeticFixtureRowKey(this.count, this.removed, this.reverse, index);
    }
}

[extensible]
class ComboFixture : WidgetFixture{
    public ComboSource m_source;
    public ComboState m_state;
    public ComboResult m_result;

    public b8 declareCombo(in u64 generation){ return this.declareCombo(generation, MakeComboFixtureOptions()); }
    public b8 declareCombo(in u64 generation, in ComboOptions options){ return this.declareCombo(generation, options, ComboPanelBounds()); }
    public b8 declareCombo(in u64 generation, in ComboOptions options, in Rect bounds){
        return this.declareSource(generation, this.m_source, this.m_state, options, bounds);
    }
    public b8 declareSource(in u64 generation, in IListDataSource source, mut ComboState state){ return this.declareSource(generation, source, state, MakeComboFixtureOptions()); }
    public b8 declareSource(in u64 generation, in IListDataSource source, mut ComboState state, in ComboOptions options){ return this.declareSource(generation, source, state, options, ComboPanelBounds()); }
    public b8 declareSource(in u64 generation, in IListDataSource source, mut ComboState state, in ComboOptions options, in Rect bounds){ return DeclareComboFixtureSource(this, generation, source, state, options, bounds); }
    public b8 prepare(in u64 generation){ return this.prepare(generation, MakeComboFixtureOptions()); }
    public b8 prepare(in u64 generation, in ComboOptions options){ return this.prepare(generation, options, ComboPanelBounds()); }
    public b8 prepare(in u64 generation, in ComboOptions options, in Rect bounds){
        return this.declareCombo(generation, options, bounds) && this.finishPanel();
    }
    public b8 accept(in u64 generation){ return this.accept(generation, MakeComboFixtureOptions()); }
    public b8 accept(in u64 generation, in ComboOptions options){ return this.accept(generation, options, ComboPanelBounds()); }
    public b8 accept(in u64 generation, in ComboOptions options, in Rect bounds){
        return this.prepare(generation, options, bounds) && this.m_context.commitFrame(generation);
    }
    public WidgetId popup()const{ return this.popup(s_ComboKey); }
    public WidgetId popup(in StringView key)const{ return RequireUiWidgetId(this.id(key, s_ComboPanelKey), "popup"); }
    public WidgetId list()const{ return this.list(s_ComboKey); }
    public WidgetId list(in StringView key)const{ return RequireUiWidgetId(this.id(key, s_ComboPanelKey), "rows"); }
    public WidgetId row(in u64 key)const{ return this.row(key, s_ComboKey); }
    public WidgetId row(in u64 key, in StringView combo)const{
        return RequireUiWidgetPartId(RequireUiWidgetId(this.list(combo), "rows"), key);
    }
    public b8 openByPointer(in u64 generation){ return OpenComboFixtureByPointer(this, generation); }
}

class RangeSource : IListDataSource{
    public u64 generation = 41u;
    public TestObserved<u64> revisionValue = TestObserved<u64>(1u);
    public u64 count = 10u;
    public u64 disabledBegin = 0xffffffffffffffffu;
    public u64 disabledEnd = 0xffffffffffffffffu;
    public b8 reversed = false;
    public b8 badLookup = false;
    public b8 wrongLookup = false;
    public b8 badFind = false;
    public TestObserved<b8> changeRevisionOnLookup;
    public TestObserved<u64> keyCalls;
    public TestObserved<u64> lookupCalls;
    public TestObserved<u64> findCalls;
    public TestObserved<u64> enabledCalls;

    public u64 instanceGeneration()const override{ return this.generation; }
    public u64 revision()const override{ return this.revisionValue.value(); }
    public u64 rowCount()const override{ return this.count; }
    public u64 key(in u64 index)const override{
        ++this.keyCalls.value();
        if(index >= this.count)
            return 0u;
        if(this.reversed)
            return this.count - index;
        return index + 1u;
    }
    public Expected<u64> indexOf(in u64 key)const override{
        u64 index = 0u;
        ++this.lookupCalls.value();
        if(this.changeRevisionOnLookup.value()){
            this.changeRevisionOnLookup.value() = false;
            ++this.revisionValue.value();
        }
        if(key == 0u || key > this.count)
            return MakeUnexpected(Failure());
        if(this.badLookup)
            index = this.count;
        else if(this.wrongLookup)
            index = 0u;
        else if(this.reversed)
            index = this.count - key;
        else
            index = key - 1u;
        return index;
    }
    public Expected<u64> findEnabled(in u64 start, in b8 reverse)const override{
        u64 index = 0u;
        ++this.findCalls.value();
        if(start >= this.count)
            return MakeUnexpected(Failure());
        if(this.badFind){
            index = this.count;
            return index;
        }
        index = start;
        if(index >= this.disabledBegin && index < this.disabledEnd){
            if(reverse){
                if(this.disabledBegin == 0u)
                    return MakeUnexpected(Failure());
                index = this.disabledBegin - 1u;
            }
            else{
                if(this.disabledEnd >= this.count)
                    return MakeUnexpected(Failure());
                index = this.disabledEnd;
            }
        }
        return index;
    }
    public void clearCalls(){
        this.keyCalls.value() = 0u;
        this.lookupCalls.value() = 0u;
        this.findCalls.value() = 0u;
        this.enabledCalls.value() = 0u;
    }
    public StringView text(in u64 unused)const override{ return "row"; }
    public b8 enabled(in u64 index)const override{
        ++this.enabledCalls.value();
        return index < this.count && (index < this.disabledBegin || index >= this.disabledEnd);
    }
}

class ArithmeticSource : IListDataSource{
    public u64 count = 100000u;
    public u64 generation = 301u;
    public u64 contentRevision = 1u;
    public u64 removed = 0u;
    public u64 disabled = 0u;
    public u64 specialIndex = 0xffffffffffffffffu;
    public StringView specialText = "A\xCC\x81\xCC\x81 g\xCC\xA3\nPrevious\nNext";
    public TestObserved<u64> keyCalls;
    public TestObserved<u64> lookupCalls;
    public TestObserved<u64> textCalls;
    public TestObserved<Array<u64, 32u>> textCallsByIndex;
    public b8 reverse = false;
    public b8 duplicate = false;
    public b8 malformedLookup = false;
    public TestObserved<String> temporary;

    public u64 instanceGeneration()const override{ this.invalidateText(); return this.generation; }
    public u64 revision()const override{ this.invalidateText(); return this.contentRevision; }
    public u64 rowCount()const override{ this.invalidateText(); return this.count; }
    public u64 key(in u64 index)const override{
        this.invalidateText();
        ++this.keyCalls.value();
        if(this.duplicate)
            return 1u;
        return this.rawKey(index);
    }
    public Expected<u64> indexOf(in u64 value)const override{
        this.invalidateText();
        ++this.lookupCalls.value();
        if(this.malformedLookup)
            return this.count;
        return FindArithmeticFixtureRowIndex(this.count, this.removed, this.reverse, value);
    }
    public Expected<u64> findEnabled(in u64 start, in b8 backwards)const override{
        this.invalidateText();
        return FindSingleDisabledFixtureRow(this.count, this.removed, this.reverse, start, backwards, this.disabled);
    }
    public StringView text(in u64 index)const override{ return FormatArithmeticSourceText(this, index); }
    public b8 enabled(in u64 index)const override{
        this.invalidateText();
        return this.rawKey(index) != this.disabled;
    }
    protected u64 rawKey(in u64 index)const{
        return ArithmeticFixtureRowKey(this.count, this.removed, this.reverse, index);
    }
    private void invalidateText()const{
        mut String buffer = this.temporary.value();
        buffer.resize(128u);
        for(usize index = 0u; index < buffer.size(); ++index)
            buffer[index] = '?';
    }
}

[extensible]
class UiListBuilderTests : WidgetFixture{
    public ArithmeticSource m_source;
    public ListState m_state;
    public ListResult m_result;

    public b8 prepare(in u64 generation){ return this.prepare(generation, MakeListFixtureOptions()); }
    public b8 prepare(in u64 generation, in ListOptions options){
        return this.prepareSource(generation, this.m_source, this.m_state, options);
    }
    public b8 prepareSource(in u64 generation, in IListDataSource source, mut ListState state){ return this.prepareSource(generation, source, state, MakeListFixtureOptions()); }
    public b8 prepareSource(in u64 generation, in IListDataSource source, mut ListState state, in ListOptions options){ return this.prepareSource(generation, source, state, options, UiListFixtureDisplay()); }
    public b8 prepareSource(in u64 generation, in IListDataSource source, mut ListState state, in ListOptions options, in DisplayMetrics display){ return PrepareUiListFixtureSource(this, generation, source, state, options, display); }
    public b8 accept(in u64 generation){ return this.accept(generation, MakeListFixtureOptions()); }
    public b8 accept(in u64 generation, in ListOptions options){
        return this.prepare(generation, options) && this.m_context.commitFrame(generation);
    }
    public WidgetId row(in u64 key)const{
        return RequireUiWidgetPartId(RequireUiWidgetId(this.id("list", "panel"), "rows"), key);
    }
    public b8 wheel(){ return this.wheel(-1.0); }
    public b8 wheel(in f64 delta){ return SendUiListFixtureWheel(this, delta); }
    public b8 preparePopups(in u64 generation, mut PopupState lowerPopup, mut ListState lowerState){
        return PrepareUiListFixtureLowerPopup(this, generation, lowerPopup, lowerState);
    }
    public b8 preparePopups(in u64 generation, mut PopupState lowerPopup, mut ListState lowerState, mut PopupState upperPopup, mut ListState upperState){
        return PrepareUiListFixtureTwoPopups(this, generation, lowerPopup, lowerState, upperPopup, upperState);
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Rect ComboPanelBounds(){ return Rect(10.0f, 10.0f, 320.0f, 240.0f); }

DisplayMetrics UiListFixtureDisplay(){
    DisplayMetrics display;
    display.logicalWidth = 800.0f;
    display.logicalHeight = 600.0f;
    display.pixelScaleX = 1.0f;
    display.pixelScaleY = 1.0f;
    return display;
}

ControlAction MakeRangeSourceAction(in ListState state, in RangeSource source, in ControlActionKind kind){
    return MakeUiListControlAction(state.inputGeneration(), source.instanceGeneration(), source.revision(), kind);
}

ComboOptions MakeComboFixtureOptions(){
    ComboOptions options = ComboOptions();
    options.width.policy = LayoutSizePolicy::Fixed;
    options.width.value = 220.0f;
    options.height.policy = LayoutSizePolicy::Fixed;
    options.height.value = 32.0f;
    options.popupHeight = 144.0f;
    options.placeholder = "Choose";
    return options;
}

ListOptions MakeListFixtureOptions(){
    ListOptions options = ListOptions();
    options.width.policy = LayoutSizePolicy::Fixed;
    options.width.value = 280.0f;
    options.height.policy = LayoutSizePolicy::Fixed;
    options.height.value = 120.0f;
    return options;
}

ControlAction MakeUiListControlAction(in u64 instanceGeneration, in u64 contentGeneration, in u64 contentRevision, in ControlActionKindEnum kind){
    ControlAction action = ControlAction();
    action.control.instanceGeneration = instanceGeneration;
    action.control.contentGeneration = contentGeneration;
    action.control.contentRevision = contentRevision;
    action.kind = kind;
    return action;
}

void ExpectUiListResult(in ListResult actual, in ListResult expected){
    EXPECT_EQ(actual.valid, expected.valid);
    EXPECT_EQ(actual.selectionChanged, expected.selectionChanged);
    EXPECT_EQ(actual.activated, expected.activated);
    EXPECT_EQ(actual.focused, expected.focused);
}

void ResetComboSourceCounters(in ComboSource self){
    self.keyCalls.value() = 0u;
    self.lookupCalls.value() = 0u;
    self.searchCalls.value() = 0u;
    self.textCalls.value() = 0u;
    self.enabledCalls.value() = 0u;
}

b8 DeclareComboFixtureSource(mut ComboFixture self, in u64 generation, in IListDataSource source, mut ComboState state, in ComboOptions options, in Rect bounds){
    if(!self.begin(generation) || !self.m_builder.beginPanel(s_ComboPanelKey, bounds))
        return false;
    self.m_result = self.m_builder.comboBox(s_ComboKey, source, state, options);
    return self.m_result.valid;
}

b8 OpenComboFixtureByPointer(mut ComboFixture self, in u64 generation){
    const Expected<HitTarget> field = self.tryTarget(self.id(s_ComboKey, s_ComboPanelKey));
    if(!field.has_value())
        return false;
    self.click(CenterUiRect(field.value().rectangle));
    return self.accept(generation) && self.m_state.isOpen();
}

StringView FormatArithmeticSourceText(in ArithmeticSource self, in u64 index){
    self.temporary.value().resize(128u);
    ++self.textCalls.value();
    if(index < self.textCallsByIndex.value().size())
        ++self.textCallsByIndex.value()[cast<usize>(index)];
    if(index == self.specialIndex){
        for(usize byte = 0u; byte < self.specialText.size(); ++byte)
            self.temporary.value()[byte] = self.specialText[byte];
        return StringView(self.temporary.value()).substr(0u, self.specialText.size());
    }
    const StringView letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    self.temporary.value()[0u] = letters[cast<usize>(index % 26u)];
    self.temporary.value()[1u] = 'x';
    return StringView(self.temporary.value()).substr(0u, 2u);
}

b8 PrepareUiListFixtureSource(mut UiListBuilderTests self, in u64 generation, in IListDataSource source, mut ListState state, in ListOptions options, in DisplayMetrics display){
    if(!self.begin(generation, display) || !self.m_builder.beginPanel("panel", Rect(10.0f, 10.0f, 320.0f, 260.0f)))
        return false;
    self.m_result = self.m_builder.virtualList("list", source, state, options);
    return self.m_result.valid && self.finishPanel();
}

b8 PrepareUiListFixtureLowerPopup(mut UiListBuilderTests self, in u64 generation, mut PopupState lowerPopup, mut ListState lowerState){
    const ListOptions listOptions = MakeListFixtureOptions();
    if(!self.begin(generation) || !self.m_builder.beginPanel("panel", Rect(10.0f, 10.0f, 320.0f, 260.0f)))
        return false;
    if(!self.m_builder.virtualList("list", self.m_source, self.m_state, listOptions).valid || !self.m_builder.endPanel())
        return false;
    PopupOptions popup = PopupOptions();
    popup.anchor = Rect(350.0f, 10.0f, 10.0f, 10.0f);
    popup.size = Point(320.0f, 180.0f);
    if(self.m_builder.beginPopup("popup", lowerPopup, popup)){
        if(!self.m_builder.virtualList("list", self.m_source, lowerState, listOptions).valid || !self.m_builder.endPopup())
            return false;
    }
    return self.m_context.endRoot() && self.m_context.finishFrame();
}

b8 PrepareUiListFixtureTwoPopups(mut UiListBuilderTests self, in u64 generation, mut PopupState lowerPopup, mut ListState lowerState, mut PopupState upperPopup, mut ListState upperState){
    const ListOptions listOptions = MakeListFixtureOptions();
    if(!self.begin(generation) || !self.m_builder.beginPanel("panel", Rect(10.0f, 10.0f, 320.0f, 260.0f)))
        return false;
    if(!self.m_builder.virtualList("list", self.m_source, self.m_state, listOptions).valid || !self.m_builder.endPanel())
        return false;
    PopupOptions popup = PopupOptions();
    popup.anchor = Rect(350.0f, 10.0f, 10.0f, 10.0f);
    popup.size = Point(320.0f, 180.0f);
    if(self.m_builder.beginPopup("popup", lowerPopup, popup)){
        if(!self.m_builder.virtualList("list", self.m_source, lowerState, listOptions).valid || !self.m_builder.endPopup())
            return false;
    }
    popup.anchor = Rect(400.0f, 220.0f, 10.0f, 10.0f);
    if(self.m_builder.beginPopup("upper", upperPopup, popup)){
        if(!self.m_builder.virtualList("list", self.m_source, upperState, listOptions).valid || !self.m_builder.endPopup())
            return false;
    }
    return self.m_context.endRoot() && self.m_context.finishFrame();
}

b8 SendUiListFixtureWheel(mut UiListBuilderTests self, in f64 delta){
    const Expected<HitTarget> accepted = self.tryTarget(self.id("list", "panel"));
    if(!accepted.has_value())
        return false;
    InputEvent event = InputEvent();
    event.type = InputEventType::PointerWheel;
    event.position = CenterUiRect(accepted.value().rectangle);
    event.scrollY = delta;
    return self.send(event).pointerConsumed;
}


