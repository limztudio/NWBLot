void VerifyCpuTaskRangeTests_SingleChunkJoinsAllSubmittedDescendants(){
    u32 callbacks = 0u;
    CpuTaskScheduler scheduler(0u);
    const auto rangeAdmission = scheduler.parallelFor(0u, 1u, 1u, lambda[mut scheduler, mut callbacks](in usize index) -> void{
        ++callbacks;
        const auto cpuTaskAdmission = scheduler.submit(lambda[mut scheduler, mut callbacks]() -> void{
            ++callbacks;
            const auto secondCpuTaskAdmission = scheduler.submit(lambda[mut callbacks]() -> void{
                ++callbacks;
            });
            ASSERT_TRUE(secondCpuTaskAdmission.has_value());
            ASSERT_TRUE(secondCpuTaskAdmission.value().valid());
        });
        ASSERT_TRUE(cpuTaskAdmission.has_value());
        ASSERT_TRUE(cpuTaskAdmission.value().valid());
    });
    EXPECT_TRUE(rangeAdmission.has_value());
    EXPECT_EQ(callbacks, 3u);
    EXPECT_EQ(scheduler.statistics().outstandingTasks, 0u);
}

void VerifyCpuTaskRangeTests_SingleChunkKeepsItsCallingWorkersIdentity(){
    const TestSchedulerConfig config = HomogeneousWorkers(1u);
    usize outerWorker = 0u;
    usize innerWorker = 0u;
    CpuAffinityEnum outerAffinity = CpuAffinity::Any;
    CpuAffinityEnum innerAffinity = CpuAffinity::Performance;
    b8 rangeAccepted = false;
    CpuTaskScheduler scheduler(config);
    const auto cpuTaskAdmission = scheduler.submit(lambda[mut scheduler, mut outerWorker, mut innerWorker, mut outerAffinity, mut innerAffinity, mut rangeAccepted]() -> void{
        outerWorker = scheduler.currentWorkerIndex();
        outerAffinity = scheduler.currentWorkerAffinity();
        rangeAccepted = scheduler.parallelFor(0u, 1u, 1u, lambda[mut scheduler, mut innerWorker, mut innerAffinity](in usize index) -> void{
            innerWorker = scheduler.currentWorkerIndex();
            innerAffinity = scheduler.currentWorkerAffinity();
        }).has_value();
    });
    ASSERT_TRUE(cpuTaskAdmission.has_value());
    const CpuTaskHandle task = cpuTaskAdmission.value();
    ASSERT_TRUE(task.valid());
    scheduler.wait(task);
    EXPECT_NE(outerWorker, 0u);
    EXPECT_TRUE(rangeAccepted);
    EXPECT_EQ(innerWorker, outerWorker);
    EXPECT_EQ(innerAffinity, outerAffinity);
}

void VerifyCpuTaskRangeTests_ExternalSingleChunkUsesAWorkerInsteadOfTheProducer(){
    usize worker = 0u;
    const TestSchedulerConfig config = HomogeneousWorkers(1u);
    CpuTaskScheduler scheduler(config);
    Atomic<b8> done(false);
    Thread producer(lambda[mut scheduler, mut worker, mut done]() -> void{
        const auto rangeAdmission = scheduler.parallelFor(0u, 1u, 1u, lambda[mut scheduler, mut worker](in usize index) -> void{
            worker = scheduler.currentWorkerIndex();
        });
        EXPECT_TRUE(rangeAdmission.has_value());
        done.store(true, MemoryOrder::release);
    });
    PumpUntil(scheduler, done);
    producer.join();
    EXPECT_EQ(worker, 1u);
}

void VerifyCpuTaskRangeTests_ExternalMainThreadRangeWaitsForTheOwner(){
    u32 callbacks = 0u;
    const TestSchedulerConfig config = HomogeneousWorkers(1u);
    CpuTaskScheduler scheduler(config);
    Atomic<b8> done(false);
    const ThreadId owner = QueryCurrentThreadId();
    CpuTaskOptions mainOptions = CpuTaskOptions();
    mainOptions.target = CpuTaskTarget::MainThread;
    Thread producer(lambda[mut scheduler, mut callbacks, mut done, in owner, in mainOptions]() -> void{
        const auto rangeAdmission = scheduler.parallelFor(0u, 1u, 1u, lambda[mut scheduler, mut callbacks, in owner](in usize index) -> void{
            ++callbacks;
            EXPECT_EQ(QueryCurrentThreadId(), owner);
            EXPECT_EQ(scheduler.currentWorkerIndex(), 0u);
        }, mainOptions);
        EXPECT_TRUE(rangeAdmission.has_value());
        done.store(true, MemoryOrder::release);
    });
    PumpUntil(scheduler, done);
    producer.join();
    EXPECT_EQ(callbacks, 1u);
}

void VerifyCpuTaskRangeTests_InvalidBatchOptionsPublishNoTasks(){
    u32 callbacks = 0u;
    CpuTaskScheduler scheduler(0u);
    CpuTaskOptions options = CpuTaskOptions();
    options.cost = cast<CpuTaskCostEnum>(255u);
    const auto rejected = scheduler.parallelFor(0u, 128u, 1u, lambda[mut callbacks](in usize index) -> void{
        ++callbacks;
    }, options);
    ASSERT_FALSE(rejected.has_value());
    EXPECT_EQ(rejected.error(), CpuTaskAdmissionError::InvalidOptions);
    EXPECT_EQ(callbacks, 0u);
    EXPECT_EQ(scheduler.statistics().outstandingTasks, 0u);
}

void VerifyCpuTaskRangeTests_InlineFailureRetiresSubmittedDescendantsBeforeTerminalHandling(){
    Atomic<u32> retirements(0u);
    u32 callbacks = 0u;
    u32 retiredOnCatch = 0u;
    u32 callbacksOnCatch = 1u;
    usize outstandingOnCatch = 1u;
    CpuTaskScheduler scheduler(0u);
    i32 result = 0;
    native(mut retirements, mut callbacks, mut retiredOnCatch, mut callbacksOnCatch, mut outstandingOnCatch, mut scheduler, mut result){
        using RangeFailure = CpuTaskSchedulerTestSupport::InlineRangeFailure;
        result = ::InvokeTerminalEntry<RangeFailure>([&]()->int {
            EXPECT_TRUE((scheduler.parallelFor(0u, 1u, 1u, [&](usize) {
                const auto cpuTaskAdmission = scheduler.submit([&, capture = LifetimeProbe(retirements)]() {
                    EXPECT_TRUE(capture.retirements != nullptr);
                    ++callbacks;
                });
                EXPECT_TRUE(cpuTaskAdmission);
                if(cpuTaskAdmission)
                    EXPECT_TRUE(cpuTaskAdmission->valid());
                throw RangeFailure{ .code = 73 };
            })));
            return 0;
        }, [&](const RangeFailure& failure) {
            retiredOnCatch = retirements.load(MemoryOrder::acquire);
            callbacksOnCatch = callbacks;
            outstandingOnCatch = scheduler.statistics().outstandingTasks;
            return failure.code;
        }, []()noexcept { return -1; });
    }
    EXPECT_EQ(retiredOnCatch, 1u);
    EXPECT_EQ(callbacksOnCatch, 0u);
    EXPECT_EQ(outstandingOnCatch, 0u);
    EXPECT_EQ(result, 73);
}


