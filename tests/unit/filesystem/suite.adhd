void VerifyFilesystemVolumeTest_FailedLaterSegmentPromotionRestoresPublishedBytes(mut FilesystemVolumeTest self){
    ScratchArena scratchArena(s_FilesystemNameTestsFilesystem);
    const Path baseDirectory = self.m_directory;
    StagedDirectoryPaths stagedPaths = StagedDirectoryPaths();
    stagedPaths.stageDirectory = baseDirectory / s_FilesystemStageDirectory;
    stagedPaths.backupDirectory = baseDirectory / s_FilesystemBackupDirectory;
    ASSERT_TRUE(EnsureDirectories(stagedPaths.stageDirectory).has_value());

    const auto firstOutput = MakeVolumeSegmentPath(self.m_directory, self.m_desc.volumeName.view(), 0u);
    const auto secondOutput = MakeVolumeSegmentPath(self.m_directory, self.m_desc.volumeName.view(), 1u);
    const auto absentOutput = MakeVolumeSegmentPath(self.m_directory, self.m_desc.volumeName.view(), 2u);
    const auto firstStaged = MakeVolumeSegmentPath(stagedPaths.stageDirectory, self.m_desc.volumeName.view(), 0u);

    Array<u8, 3> firstOld = Array<u8, 3>();
    firstOld[0u] = 1u;
    firstOld[1u] = 2u;
    firstOld[2u] = 3u;
    Array<u8, 4> secondOld = Array<u8, 4>();
    secondOld[0u] = 4u;
    secondOld[1u] = 5u;
    secondOld[2u] = 6u;
    secondOld[3u] = 7u;
    Array<u8, 2> replacement = Array<u8, 2>();
    replacement[0u] = 8u;
    replacement[1u] = 9u;

    ASSERT_TRUE(WriteBinaryFile(firstOutput, firstOld));
    ASSERT_TRUE(WriteBinaryFile(secondOutput, secondOld));
    ASSERT_TRUE(WriteBinaryFile(firstStaged, replacement));

    EXPECT_FALSE(PublishStagedVolume(stagedPaths, self.m_directory, self.m_desc.volumeName.view(), 3u, scratchArena));
    EXPECT_TRUE(SawCapturedError(self.m_logger, "failed to promote staged segment"));

    Vector<u8> loaded;
    ASSERT_TRUE(ReadBinaryFile(firstOutput, loaded).has_value());
    ASSERT_EQ(loaded.size(), firstOld.size());
    for(usize i = 0u; i < firstOld.size(); ++i)
        EXPECT_EQ(loaded[i], firstOld[i]);

    ASSERT_TRUE(ReadBinaryFile(secondOutput, loaded).has_value());
    ASSERT_EQ(loaded.size(), secondOld.size());
    for(usize i = 0u; i < secondOld.size(); ++i)
        EXPECT_EQ(loaded[i], secondOld[i]);

    const Expected<b8, ErrorCode> absent = FileExists(absentOutput);
    ASSERT_TRUE(absent.has_value());
    EXPECT_FALSE(absent.value());
    const Expected<b8, ErrorCode> backup = FileExists(stagedPaths.backupDirectory);
    ASSERT_TRUE(backup.has_value());
    EXPECT_FALSE(backup.value());
}

void VerifyFilesystemVolumeTest_ThrowingPromotionDiagnosticRestoresPublishedBytesDuringUnwind(mut FilesystemVolumeTest self){
    ScratchArena scratchArena(s_FilesystemNameTestsFilesystem);
    const Path baseDirectory = self.m_directory;
