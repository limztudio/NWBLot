void VerifyTextGlyphVisibilityTests_CandidateRejectsInvalidParametersAndKnownBounds(){
    PlacedGlyph glyph = PlacedGlyph();
    glyph.coverage = MakeUiTextFontLayoutCoverage(Rect(1.0f, 2.0f, 3.0f, 4.0f), true);
    const Rect clip = Rect(0.0f, 0.0f, 100.0f, 100.0f);
