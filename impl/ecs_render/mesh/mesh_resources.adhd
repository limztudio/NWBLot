#include <impl/ecs_render/mesh/mesh_resources_internal.adhd>
#include <impl/ecs_render/shared/frame_push_constants.adhd>
#include <impl/ecs_render/mesh/mesh_object_cache_and_view_resources.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const StringView s_MeshEmulationVertexBufferSuffix = ":emulation_vb";

u64 RequiredRuntimeMeshletBoundsByteSize(in u32 meshletCount, in u64 boundsByteStride){
    return cast<u64>(meshletCount) * boundsByteStride;
}

b8 HasCompleteMeshRawBoundsBuffer(in b8 heapInitialized, in u64 bufferByteSize, in u64 requiredBytes, in b8 canHaveRawViews){
    return heapInitialized && requiredBytes != 0u && bufferByteSize >= requiredBytes && canHaveRawViews;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[cpp_header("<impl/assets/graphics/mesh/runtime_bounds_constants.h>"), cpp_name("NWB_RUNTIME_MESH_BOUNDS_BYTE_SIZE")]
extern const u32 s_MeshBoundsPayloadBytes;

[cpp_unwind]
b8 RendererMeshSystem::prepareComputeEmulationResources(mut MeshResources mesh){
    return MeshEmulationResources().prepare(this.m_graphics, mesh);
}

[cpp_unwind]
b8 RendererMeshSystem::prepareMeshFrameBindings(in MaterialPassBufferSnapshot materialBuffers){
    return this.m_meshState.m_frameBindings.prepare(this.m_graphics, materialBuffers, this.m_meshState.m_meshViewBuffer);
}

MeshFrameBindingSnapshot RendererMeshSystem::meshFrameBindingSnapshot()const{
    return this.m_meshState.m_frameBindings.snapshot(this.m_meshState.m_meshViewBuffer);
}

void RendererMeshSystem::populateMeshGeometryHeapSlots(in MeshResources mesh, mut InstanceGpuData outInstance)const{
    assert(GeometryHeapHandlesReady(mesh.geometryHeapHandles));
    for(u32 slotIndex = 0u; slotIndex < s_MeshInstanceGeometrySlotCount; ++slotIndex)
        outInstance.geometryHeapSlots[slotIndex] = 0u;
    in MeshResources source = mesh;
    ForEachMeshSourceBindingSlot(lambda[in source, mut outInstance](in u32 bindingSlot, in b8 rawView) -> void{
        outInstance.geometryHeapSlots[bindingSlot] = source.geometryHeapHandles[bindingSlot].slot();
    });
}

[cpp_unwind]
void RendererMeshSystem::releaseMeshGeometryHeapHandles(mut MeshResources mesh){
    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
    const b8 initialized = heap.isInitialized();
    const auto retire = lambda[mut heap, in initialized](mut GpuDescriptorHandle handle) -> void{
        if(initialized && handle.valid())
            heap.free(handle);
        handle = GpuDescriptorHandleInvalid();
    };
    for(mut GpuDescriptorHandle handle : mesh.geometryHeapHandles)
        retire(handle);
    retire(mesh.swBvhPositionHeapHandle);
    retire(mesh.swBvhTriangleIndexHeapHandle);
    retire(mesh.swBvhNodeHeapHandle);
    retire(mesh.swBvhParentHeapHandle);
    retire(mesh.emulationVertexHeapHandle);
    retire(mesh.runtimeLocalBoundsHeapHandle);
    retire(mesh.runtimeMeshletLocalBoundsHeapHandle);
    retire(mesh.objectGeometryCache.heapHandle);
    mesh.objectGeometryCache.acceptedContent = false;
}

[cpp_unwind]
void RendererMeshSystem::releaseMeshFrameHeapHandles(){
    this.m_meshState.m_frameBindings.release(this.m_graphics);
}

[cpp_unwind]
b8 RendererMeshSystem::createMeshRenderBindings(mut MeshResources mesh){
    if(!this.createMeshGeometryHeapHandles(mesh))
        return false;

    if(mesh.runtimeLocalBoundsBuffer.valid() && !mesh.runtimeLocalBoundsHeapHandle.valid()){
        mut Device device = this.m_graphics.getDevice();
        mut GpuDescriptorHeap heap = device.getDescriptorHeap();
        in BufferDesc desc = mesh.runtimeLocalBoundsBuffer.deref().getCreationDescription();
        if(!HasCompleteMeshRawBoundsBuffer(heap.isInitialized(), desc.byteSize, s_MeshBoundsPayloadBytes, desc.canHaveRawViews)){
            this.releaseMeshGeometryHeapHandles(mesh);
            error("RendererSystem: runtime local bounds require a complete raw GPU buffer");
            return false;
        }
        if(!AssignDescriptor(heap, GpuDescriptorClass::StorageBuffer, DescriptorWriteItemRawBufferSrv(0u, mesh.runtimeLocalBoundsBuffer.deref()), mesh.runtimeLocalBoundsHeapHandle)){
            this.releaseMeshGeometryHeapHandles(mesh);
            error("RendererSystem: failed to register runtime local bounds");
            return false;
        }
    }

    if(mesh.runtimeMesh && mesh.runtimeGeometryContentRevision != 0u && mesh.runtimeMeshletLocalBoundsBuffer.valid() && !mesh.runtimeMeshletLocalBoundsHeapHandle.valid()){
        mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
        in BufferDesc desc = mesh.runtimeMeshletLocalBoundsBuffer.deref().getCreationDescription();
        const u64 requiredBytes = RequiredRuntimeMeshletBoundsByteSize(mesh.meshletCount, s_MeshBoundsPayloadBytes);
        if(!(HasCompleteMeshRawBoundsBuffer(heap.isInitialized(), desc.byteSize, requiredBytes, desc.canHaveRawViews)
            && AssignDescriptor(heap, GpuDescriptorClass::StorageBuffer, DescriptorWriteItemRawBufferSrv(0u, mesh.runtimeMeshletLocalBoundsBuffer.deref()), mesh.runtimeMeshletLocalBoundsHeapHandle)))
            warning("RendererSystem: mesh '{}' could not register optional meshlet bounds; retaining whole-caster shadows", mesh.meshName.resolvedText());
    }

    assert(this.meshRenderBindingsReady(mesh));
    return true;
}

b8 RendererMeshSystem::meshRenderBindingsReady(in MeshResources mesh)const{
    if(!mesh.valid() || !GeometryHeapHandlesReady(mesh.geometryHeapHandles))
        return false;

    if(mesh.runtimeLocalBoundsBuffer.valid() && (!mesh.runtimeLocalBoundsHeapHandle.valid() || mesh.runtimeLocalBoundsHeapHandle.descriptorClass() != GpuDescriptorClass::StorageBuffer))
        return false;

    return true;
}

[cpp_unwind]
b8 RendererMeshSystem::createMeshGeometryHeapHandles(mut MeshResources mesh){
    if(GeometryHeapHandlesReady(mesh.geometryHeapHandles))
        return true;

    mut Device device = this.m_graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized()){
        error("RendererSystem: mesh '{}' requires the initialized global descriptor heap", mesh.meshName.resolvedText());
        return false;
    }

    // A non-empty partial set signals a broken lifetime transition, never a safe merge.
    for(in GpuDescriptorHandle handle : mesh.geometryHeapHandles)
        assert(!handle.valid());

    Array<GpuDescriptorHandle, s_MeshInstanceGeometrySlotCount> acquired;
    GpuDescriptorRetirementGuard retireAcquired(heap, acquired);
    b8 registered = true;
    in MeshResources source = mesh;
    ForEachMeshSourceBindingSlot(lambda[in source, mut heap, mut acquired, mut registered](in u32 bindingSlot, in b8 rawView) -> void{
        if(!registered)
            return;
        in BufferHandle buffer = MeshSourceBuffer(source, bindingSlot);
        if(!buffer.valid()){
            error("RendererSystem: mesh '{}' has no source buffer at binding {}", source.meshName.resolvedText(), bindingSlot);
            registered = false;
            return;
        }

        if(!AssignDescriptor(heap, GpuDescriptorClass::StorageBuffer, DescriptorWriteItemStructuredBufferSrv(0u, buffer.deref()), acquired[bindingSlot]))
            registered = false;
    });

    if(!registered)
        return false;

    ForEachMeshSourceBindingSlot(lambda[mut mesh, in acquired](in u32 bindingSlot, in b8 rawView) -> void{
        mesh.geometryHeapHandles[bindingSlot] = acquired[bindingSlot];
    });
    retireAcquired.release();
    assert(GeometryHeapHandlesReady(mesh.geometryHeapHandles));
    return true;
}

[cpp_unwind]
b8 RendererMeshSystem::ensureMeshSwBvhInputHeapHandles(mut MeshResources mesh){
    return MeshSoftwareBvhBindings().ensure(this.m_graphics, mesh);
}

[cpp_unwind]
void RendererMeshSystem::releaseAllMeshGeometryHeapHandles(){
    for(auto it = this.m_meshState.m_meshes.begin(); it != this.m_meshState.m_meshes.end(); ++it)
        this.releaseMeshGeometryHeapHandles(this.m_meshState.m_meshes.at(it.key()));
}

b8 MeshEmulationResources::prepare(mut GraphicsRuntime graphics, mut MeshResources mesh)const{
    if(mesh.emulationVertexHeapHandle.valid())
        return true;
    if(!mesh.emulationVertexBuffer.valid()){
        const Expected<ComputeEmulationLayout> layoutResult = MeshGeometryBufferPolicy().resolveComputeEmulationLayout(mesh.buffers.meshletLocalVertexRefBuffer.deref().getCreationDescription().byteSize, mesh.meshletPrimitiveIndexCount);
        if(!layoutResult.has_value()){
            error("RendererSystem: generated geometry layout exceeds the index byte-address range for mesh '{}'", mesh.meshName.resolvedText());
            return false;
        }
        in ComputeEmulationLayout layout = layoutResult.value();
        const auto emulationVertexBufferName = DeriveName(mesh.meshName, s_MeshEmulationVertexBufferSuffix);
        if(!emulationVertexBufferName.has_value()){
            error("RendererSystem: failed to derive compute-emulation vertex buffer name for mesh '{}'", mesh.meshName.resolvedText());
            return false;
        }

        BufferDesc emulationVertexBufferDesc;
        emulationVertexBufferDesc
            .setByteSize(layout.bufferByteSize)
            .setStructStride(s_EmulatedVertexStride)
            .setCanHaveRawViews(true)
            .setCanHaveUAVs(true)
            .setIsVertexBuffer(true)
            .setIsIndexBuffer(true)
            .setQueueSharing(ResourceQueueSharing::GraphicsAndAsyncCompute)
            .setDebugName(emulationVertexBufferName.value())
        ;
        auto emulationVertexBufferResult = graphics.createBuffer(emulationVertexBufferDesc);
        if(emulationVertexBufferResult.has_value())
            mesh.emulationVertexBuffer = emulationVertexBufferResult.value();
        else
            mesh.emulationVertexBuffer.reset();
        if(!emulationVertexBufferResult.has_value()){
            error("RendererSystem: failed to create compute-emulation vertex buffer for mesh '{}'", mesh.meshName.resolvedText());
            return false;
        }
        mesh.emulationIndexByteOffset = layout.indexByteOffset;
    }

    mut Device device = graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized()){
        error("RendererSystem: compute-emulation vertex buffer requires the initialized global descriptor heap");
        return false;
    }
    if(AssignDescriptor(heap, GpuDescriptorClass::StorageBuffer, DescriptorWriteItemStructuredBufferUav(0u, mesh.emulationVertexBuffer.deref()), mesh.emulationVertexHeapHandle))
        return true;

    error("RendererSystem: failed to register compute-emulation vertex buffer in the descriptor heap for mesh '{}'", mesh.meshName.resolvedText());
    return false;
}

b8 MeshSoftwareBvhBindings::ensure(mut GraphicsRuntime graphics, mut MeshResources mesh)const{
    in MeshResources source = mesh;
    const auto inputsReady = lambda[in source]() -> b8{
        return
            source.swBvhPositionHeapHandle.valid()
            && source.swBvhPositionHeapHandle.descriptorClass() == GpuDescriptorClass::StorageBuffer
            && source.swBvhTriangleIndexHeapHandle.valid()
            && source.swBvhTriangleIndexHeapHandle.descriptorClass() == GpuDescriptorClass::StorageBuffer
        ;
    };
    if(inputsReady())
        return true;

    assert(!mesh.swBvhPositionHeapHandle.valid());
    assert(!mesh.swBvhTriangleIndexHeapHandle.valid());
    if(!mesh.buffers.positionBuffer.valid() || !mesh.triangleIndexBuffer.valid()){
        error("RendererSystem: mesh '{}' has no software-BVH position or triangle-index input", mesh.meshName.resolvedText());
        return false;
    }

    mut Device device = graphics.getDevice();
    mut GpuDescriptorHeap heap = device.getDescriptorHeap();
    if(!heap.isInitialized()){
        error("RendererSystem: mesh '{}' requires the initialized global descriptor heap for software-BVH inputs", mesh.meshName.resolvedText());
        return false;
    }

    const auto registrationFailed = lambda[in source]() -> b8{
        error("RendererSystem: failed to register software-BVH inputs for mesh '{}'", source.meshName.resolvedText());
        return false;
    };
    const Expected<GpuDescriptorHandle> positionHandleResult = heap.allocate(GpuDescriptorClass::StorageBuffer);
    if(!positionHandleResult.has_value())
        return registrationFailed();
    const GpuDescriptorHandle positionHandle = positionHandleResult.value();
    GpuDescriptorRetirementGuard retirePosition(heap, positionHandle);
    const Expected<GpuDescriptorHandle> triangleIndexHandleResult = heap.allocate(GpuDescriptorClass::StorageBuffer);
    if(!triangleIndexHandleResult.has_value())
        return registrationFailed();
    const GpuDescriptorHandle triangleIndexHandle = triangleIndexHandleResult.value();
    GpuDescriptorRetirementGuard retireTriangleIndex(heap, triangleIndexHandle);
    if(!heap.write(positionHandle, DescriptorWriteItemRawBufferSrv(0u, mesh.buffers.positionBuffer.deref())) || !heap.write(triangleIndexHandle, DescriptorWriteItemRawBufferSrv(0u, mesh.triangleIndexBuffer.deref())))
        return registrationFailed();

    mesh.swBvhPositionHeapHandle = positionHandle;
    mesh.swBvhTriangleIndexHeapHandle = triangleIndexHandle;
    retirePosition.release();
    retireTriangleIndex.release();
    assert(inputsReady());
    return true;
}


