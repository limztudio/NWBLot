#ifndef NWB_GRAPHICS_RAYTRACE_CSG_BOUNDARY_CERTIFICATE_SLANGI
#define NWB_GRAPHICS_RAYTRACE_CSG_BOUNDARY_CERTIFICATE_SLANGI


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// A current-ray certificate contains resolved identities and failures, never borrowed crossing storage.
struct NwbRayTraceCsgBoundaryCheck{
    bool hit;
    uint failure;
    uint primitive;
    uint cutter;
    float distance;
};

struct NwbRayTraceCsgBoundaryCertificate{
    bool reusable;
    NwbRayTraceCsgBoundaryCheck window;
    NwbRayTraceCsgBoundaryCheck next;
};


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#endif


