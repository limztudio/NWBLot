native{
#include <core/task/gpu/compiler.h>
namespace NWB::Core{
using QueueAssignmentValue = GpuTaskQueueAssignment;
using QueueTaskView = GpuTaskGraphTaskView;
};
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class GpuTaskQueueScoreExclusionsValue{
    public usize assignmentOffset = 0u;
    public usize assignmentCount = 0u;
    public u64 totalCost = 0u;
    public u64 candidateQueueCost = 0u;
}


b8 MatchesGpuTaskQueueAssignment(in QueueAssignmentValue lhs, in QueueAssignmentValue rhs){
    return lhs.task == rhs.task
        && lhs.initialQueue == rhs.initialQueue
        && lhs.queue == rhs.queue
        && lhs.score.overlap == rhs.score.overlap
        && lhs.score.queueLoad == rhs.score.queueLoad
        && lhs.score.incomingCrossings == rhs.score.incomingCrossings
        && lhs.score.outgoingCrossings == rhs.score.outgoingCrossings
        && lhs.score.ownershipTransfers == rhs.score.ownershipTransfers
        && lhs.queueClass == rhs.queueClass
        && lhs.reason == rhs.reason
        && lhs.modifiers == rhs.modifiers
        && lhs.dedicated == rhs.dedicated;
}


b8 QueueHasCapabilities(in u8 available, in u8 required){
    return (available & required) == required;
}


b8 TimingFeedbackRoutingAllowed(in QueueTaskView task){
    return task.scheduling.allowTimingFeedbackRouting && (task.scheduling.allowSameClassQueueRouting || task.scheduling.allowCrossClassTimingFeedbackRouting) && task.scheduling.overlapPreferred && !task.scheduling.avoidQueueCrossing;
}


