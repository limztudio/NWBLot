void VerifyUiTextAreaLoanTests_IdenticalScrollIntentDuringHostLoanRejectsBeforePreparation(mut UiTextAreaLoanTests self){
    ASSERT_TRUE(self.acceptBaseline());
    const UiFixtureAcceptedInputState<16u> before = self.accepted();
    const u64 revision = self.m_state.revision();
    const Point scroll = self.m_state.scroll();
    usize attempts = 0u;
    const auto loanHook = lambda[mut self, in scroll, mut attempts]() -> void{
        ++attempts;
        EXPECT_TRUE(self.m_state.scrollTo(scroll));
    };
    self.m_host.loanHook = loanHook;
    ASSERT_TRUE(self.beginArea(2u));
    EXPECT_FALSE(self.m_builder.textArea(s_UiTextAreaWidgetKey, self.m_model, self.m_state, MakeTextAreaLoanFixtureOptions()).valid);
    EXPECT_EQ(attempts, 1u);
    EXPECT_EQ(self.m_host.loans, 1u);
    EXPECT_EQ(self.m_host.ordinaryLoans, 0u);
    EXPECT_EQ(self.m_host.actionLoans, 0u);
    EXPECT_EQ(self.m_host.publishes, 0u);
    EXPECT_GT(self.m_state.revision(), revision);
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, scroll.x);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, scroll.y);
    self.expectRejected(before);
}

void VerifyUiTextAreaLoanTests_FirstPublicationScrollIntentRejectsBeforeTheSecondPublication(mut UiTextAreaLoanTests self){
    ASSERT_TRUE(self.acceptBaseline());
    const UiFixtureAcceptedInputState<16u> before = self.accepted();
    EditModel secondModel = EditModel(EditLimits(), EditTextMode::Multiline);
    TextAreaState secondState = TextAreaState();
    ASSERT_TRUE(secondModel.setText("second\narea"));
    ASSERT_TRUE(self.beginArea(2u));
    ASSERT_TRUE(self.m_builder.textArea(s_UiTextAreaWidgetKey, self.m_model, self.m_state, MakeTextAreaLoanFixtureOptions()).valid);
    ASSERT_TRUE(self.m_builder.textArea("second", secondModel, secondState, MakeTextAreaLoanFixtureOptions()).valid);
    Point scroll = Point();
    u64 revision = 0u;
    EditNavigationSnapshot navigation = EditNavigationSnapshot();
    const auto publishHook = lambda[mut self, mut scroll, mut revision, mut navigation]() -> void{
        scroll = self.m_state.scroll();
        revision = self.m_state.revision();
        navigation = self.m_state.navigation().snapshot();
        EXPECT_TRUE(self.m_state.scrollTo(scroll));
    };
    self.m_host.publishHook = publishHook;
    EXPECT_FALSE(self.m_builder.endPanel());
    EXPECT_EQ(self.m_host.publishes, 1u);
    ASSERT_EQ(self.m_host.publications.size(), 1u);
    EXPECT_EQ(StringView(self.m_host.publications[0u].text), "alpha\nbeta");
    EXPECT_GT(self.m_state.revision(), revision);
    EXPECT_TRUE(self.m_state.navigation().matches(navigation));
    EXPECT_FLOAT_EQ(self.m_state.scroll().x, scroll.x);
    EXPECT_FLOAT_EQ(self.m_state.scroll().y, scroll.y);
    EXPECT_EQ(secondModel.text(), "second\narea");
    self.expectRejected(before);
}

