void VerifyTelemetry_TelemetryReportDistinguishesExactEmptyPacketSubmissionsFromAbsentStatistics(){
    TelemetryTestArena testArena = TelemetryTestArena();
    FrameGraphNodeDescs nodes = FrameGraphNodeDescs(testArena.arena);
    FrameGraphEdgeDescs edges = FrameGraphEdgeDescs(testArena.arena);
    FrameGraphPhysicalQueueRuntimeStatisticsRecords physicalQueueRuntimeStatistics = FrameGraphPhysicalQueueRuntimeStatisticsRecords(testArena.arena);
    FrameGraphPacketSubmissionStatisticsRecords packetSubmissionStatistics = FrameGraphPacketSubmissionStatisticsRecords(testArena.arena);
    BuildTestPacketSubmissionFrameGraph(testArena.arena, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics);
    native(mut nodes){
        nodes[0u].runtimeStatistics.submission = {};
    }
    physicalQueueRuntimeStatistics.clear();
    packetSubmissionStatistics.clear();

    ScratchArena scratchArena = ScratchArena(s_TelemetryCaseTestsTelemetryReportWork);
    TelemetryReport exactReport = TelemetryReport(testArena.arena);
    TelemetryReport absentReport = TelemetryReport(testArena.arena);
    native(mut testArena, in nodes, in edges, in physicalQueueRuntimeStatistics, in packetSubmissionStatistics, mut scratchArena, mut exactReport, mut absentReport){
        TelemetryRecorder exactRecorder(testArena.arena);
        exactRecorder.setCaptureOptions(CaptureAll());
        ASSERT_TRUE(RecordFrameGraph(exactRecorder, testArena.scratchArena, 58u, nodes, edges, physicalQueueRuntimeStatistics, packetSubmissionStatistics, 18u));
        auto reportResult3 = BuildTelemetryReport(exactRecorder.view(), testArena.arena, scratchArena);
        ASSERT_TRUE(reportResult3.has_value());
        exactReport = Move(reportResult3.value());

        TelemetryRecorder absentRecorder(testArena.arena);
        absentRecorder.setCaptureOptions(CaptureAll());
        ASSERT_TRUE(RecordFrameGraph(absentRecorder, testArena.scratchArena, 59u, nodes, edges, 19u));
        auto reportResult4 = BuildTelemetryReport(absentRecorder.view(), testArena.arena, scratchArena);
        ASSERT_TRUE(reportResult4.has_value());
        absentReport = Move(reportResult4.value());
    }
    EXPECT_TRUE(ReportJsonView(exactReport).contains("\"packetSubmissions\": []"));
    EXPECT_TRUE(ReportGraphView(exactReport).contains("runtime_packet_submission_count=0"));
    EXPECT_TRUE(ReportJsonView(absentReport).contains("\"packetSubmissions\": null"));
    EXPECT_TRUE(ReportGraphView(absentReport).contains("runtime_packet_submission_count=\"unknown\""));
}

void VerifyTelemetry_TelemetryReportRejectsNonCurrentFrameGraphPayloads(){
    TelemetryTestArena testArena = TelemetryTestArena();
    FrameGraphNodeDescs nodes = FrameGraphNodeDescs(testArena.arena);
    FrameGraphEdgeDescs edges = FrameGraphEdgeDescs(testArena.arena);
    BuildTestFrameGraph(testArena.arena, nodes, edges);
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    ASSERT_TRUE(BuildFrameGraphPayload(55u, nodes, edges, testArena.scratchArena, payload));

    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureAll());
    ScratchArena scratchArena = ScratchArena(s_TelemetryCaseTestsTelemetryReportWork);
    TelemetryReport report = TelemetryReport(testArena.arena);
    usize unsupportedCount = 0u;
    native(mut testArena, in nodes, in edges, mut payload, mut recorder, mut scratchArena, mut report, mut unsupportedCount){
        ASSERT_TRUE(RecordFrameGraph(recorder, testArena.scratchArena, 55u, nodes, edges, 15u));
        const Array<u16, 12> unsupportedVersions = { 0u, 1u, 2u, 3u, 4u, 5u, 6u, 7u, 8u, 9u, static_cast<u16>(Core::Telemetry::s_FrameGraphPayloadVersion + 1u), Limit<u16>::s_Max, };
        unsupportedCount = LengthOf(unsupportedVersions);
        Core::Telemetry::EncodedFrameGraphPayloadHeader header;
        NWB_MEMCPY(&header, sizeof(header), payload.data(), sizeof(header));
        for(const u16 version : unsupportedVersions){
            ScopedTestTrace trace(version);
            header.version = version;
            NWB_MEMCPY(payload.data(), payload.size(), &header, sizeof(header));
            ASSERT_TRUE(recorder.recordBinary(EventKind::FrameGraphFrame, 55u, payload.data(), payload.size(), 15u));
        }
        auto reportResult5 = BuildTelemetryReport(recorder.view(), testArena.arena, scratchArena);
        ASSERT_TRUE(reportResult5.has_value());
        report = Move(reportResult5.value());
    }
    EXPECT_EQ(report.summary.eventCount, unsupportedCount + 1u);
    EXPECT_EQ(report.summary.parseFailureCount, unsupportedCount);
    EXPECT_EQ(report.summary.frameGraphFrameCount, 1u);
    EXPECT_TRUE(ReportGraphView(report).contains("GBuffer Pass"));
}

void VerifyTelemetry_TelemetryReportMarksAbsentRuntimeStatistics(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureAll());

    FrameGraphNodeDescs nodes = FrameGraphNodeDescs(testArena.arena);
    FrameGraphEdgeDescs edges = FrameGraphEdgeDescs(testArena.arena);
    BuildTestCompiledFrameGraph(testArena.arena, nodes, edges);
    ScratchArena scratchArena = ScratchArena(s_TelemetryCaseTestsTelemetryReportWork);
    TelemetryReport report = TelemetryReport(testArena.arena);
    native(mut recorder, mut testArena, in nodes, in edges, mut scratchArena, mut report){
        ASSERT_TRUE(RecordFrameGraph(recorder, testArena.scratchArena, 53u, nodes, edges, 13u));
        auto reportResult6 = BuildTelemetryReport(recorder.view(), testArena.arena, scratchArena);
        ASSERT_TRUE(reportResult6.has_value());
        report = Move(reportResult6.value());
    }

    const StringView json = ReportJsonView(report);
    const usize firstPassJsonOffset = json.find("\"label\": \"GBuffer Pass\"");
    const usize resourceJsonOffset = json.find("\"label\": \"Albedo Texture\"");
    const usize secondPassJsonOffset = json.find("\"label\": \"Lighting Pass\"");
    const usize jsonEdgesOffset = json.find("\"edges\": [", secondPassJsonOffset);
    ASSERT_NE(firstPassJsonOffset, usize.max);
    ASSERT_NE(resourceJsonOffset, usize.max);
    ASSERT_NE(secondPassJsonOffset, usize.max);
    ASSERT_NE(jsonEdgesOffset, usize.max);
    ASSERT_LT(firstPassJsonOffset, resourceJsonOffset);
    ASSERT_LT(resourceJsonOffset, secondPassJsonOffset);
    ASSERT_LT(secondPassJsonOffset, jsonEdgesOffset);

    const StringView firstPassJson = json.substr(firstPassJsonOffset, resourceJsonOffset - firstPassJsonOffset);
    const StringView resourceJson = json.substr(resourceJsonOffset, secondPassJsonOffset - resourceJsonOffset);
    const StringView secondPassJson = json.substr(secondPassJsonOffset, jsonEdgesOffset - secondPassJsonOffset);
    EXPECT_TRUE(firstPassJson.contains(s_RuntimeStatisticsNullJson));
    EXPECT_TRUE(resourceJson.contains(s_ResourceWithNullStatisticsJson));
    EXPECT_TRUE(secondPassJson.contains(s_RuntimeStatisticsNullJson));

    const StringView dot = ReportGraphView(report);
    const usize firstPassDotOffset = dot.find("  n0 [");
    const usize resourceDotOffset = dot.find("  n1 [");
    const usize secondPassDotOffset = dot.find("  n2 [");
    const usize dotEdgesOffset = dot.find("  n0 ->", secondPassDotOffset);
    ASSERT_NE(firstPassDotOffset, usize.max);
    ASSERT_NE(resourceDotOffset, usize.max);
    ASSERT_NE(secondPassDotOffset, usize.max);
    ASSERT_NE(dotEdgesOffset, usize.max);
    ASSERT_LT(firstPassDotOffset, resourceDotOffset);
    ASSERT_LT(resourceDotOffset, secondPassDotOffset);
    ASSERT_LT(secondPassDotOffset, dotEdgesOffset);

    const StringView firstPassDot = dot.substr(firstPassDotOffset, resourceDotOffset - firstPassDotOffset);
    const StringView resourceDot = dot.substr(resourceDotOffset, secondPassDotOffset - resourceDotOffset);
    const StringView secondPassDot = dot.substr(secondPassDotOffset, dotEdgesOffset - secondPassDotOffset);
    EXPECT_TRUE(firstPassDot.contains(s_RuntimeStatisticsNone));
    EXPECT_TRUE(resourceDot.contains(s_RuntimeStatisticsNone));
    EXPECT_TRUE(secondPassDot.contains(s_RuntimeStatisticsNone));
}

void VerifyTelemetry_TelemetryReportRetainsFiniteRecordsWhenTimingTotalsOverflow(){
    const Expected<FloatingPointEnvironment> originalEnvironment = HoldFloatingPointExceptions();
    ASSERT_TRUE(originalEnvironment.has_value());
    const FloatingPointEnvironmentGuard restoreEnvironment = FloatingPointEnvironmentGuard(originalEnvironment.value());

    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryRecorder recorder = TelemetryRecorder(testArena.arena);
    recorder.setCaptureOptions(CaptureAll());

    TimingStats timing = MakeTestTimingStats();
    timing.seconds = f64.max * 0.75;
    timing.minSeconds = timing.seconds;
    timing.maxSeconds = timing.seconds;
    timing.lastSeconds = timing.seconds;
    timing.sampleCount = 1u;
    timing.firstSampleFrameIndex = 70u;
    timing.lastSampleFrameIndex = 70u;
    Array<PerfTimingSourceEnum, 2> sources = Array<PerfTimingSourceEnum, 2>();
    sources[0u] = PerfTimingSource::Cpu;
    sources[1u] = PerfTimingSource::Gpu;
    for(in PerfTimingSourceEnum source : sources){
        ASSERT_TRUE(RecordPerfTiming(recorder, source, s_TelemetryCaseLargeFirst, "large_first", timing));
        ASSERT_TRUE(RecordPerfTiming(recorder, source, s_TelemetryCaseLargeSecond, "large_second", timing));
    }

    TelemetryReport report = TelemetryReport(testArena.arena);
    b8 roundingApplied = false;
    b8 reportBuilt = false;
    native(in recorder, mut testArena, mut report, mut roundingApplied, mut reportBuilt){
        {
#pragma STDC FENV_ACCESS ON
            roundingApplied = SetFloatingPointRoundingMode(FE_TONEAREST).has_value();
            if(roundingApplied){
                auto builtReport = BuildTelemetryReport(recorder.view(), testArena.arena, testArena.scratchArena);
                reportBuilt = builtReport.has_value();
                if(builtReport.has_value())
                    report = Move(builtReport.value());
            }
        }
    }
    ASSERT_TRUE(roundingApplied);
    ASSERT_TRUE(reportBuilt);
    EXPECT_EQ(report.summary.eventCount, 4u);
    EXPECT_EQ(report.summary.parseFailureCount, 0u);
    EXPECT_EQ(report.summary.cpuTimingEventCount, 2u);
    EXPECT_EQ(report.summary.gpuTimingEventCount, 2u);

    const StringView json = ReportJsonView(report);
    EXPECT_TRUE(json.contains("\"cpuTimingSeconds\": null"));
    EXPECT_TRUE(json.contains("\"gpuTimingSeconds\": null"));
    const StringView csv = ReportPerfCsvView(report);
    EXPECT_TRUE(csv.contains("cpu,large_first,"));
    EXPECT_TRUE(csv.contains("cpu,large_second,"));
    EXPECT_TRUE(csv.contains("gpu,large_first,"));
    EXPECT_TRUE(csv.contains("gpu,large_second,"));
}

void VerifyTelemetry_TextLogPayloadPreservesUnicodeAndEmbeddedNullBytes(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    native(mut testArena, mut payload){
        constexpr TStringView s_Message(
            NWB_TEXT("A\u00e9\ud55c\U0001f642\0Z"),
            sizeof(NWB_TEXT("A\u00e9\ud55c\U0001f642\0Z")) / sizeof(tchar) - 1u
        );
        constexpr Array<u8, 12> s_Expected = { 0x41u, 0xc3u, 0xa9u, 0xedu, 0x95u, 0x9cu, 0xf0u, 0x9fu, 0x99u, 0x82u, 0u, 0x5au };
        ASSERT_TRUE(Core::Telemetry::BuildTextLogPayload(LogType::Warning, s_Message, testArena.scratchArena, payload));
        CheckTextLogPayload(payload, s_Expected);
    }
}

void VerifyTelemetry_TextLogPayloadRetainsPlatformInvalidUnicodeConversion(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    native(mut testArena, mut payload){
#if defined(NWB_UNICODE)
#if WCHAR_MAX <= 0xffffu
        constexpr Array<tchar, 3> s_Message = { static_cast<tchar>(0xd800u), static_cast<tchar>('X'), static_cast<tchar>(0xdc00u) };
#else
        constexpr Array<tchar, 3> s_Message = { static_cast<tchar>(0x110000u), static_cast<tchar>('X'), static_cast<tchar>(0xffffffffu) };
#endif
        constexpr Array<u8, 3> s_Expected = { static_cast<u8>('?'), static_cast<u8>('X'), static_cast<u8>('?') };
#else
        // Narrow byte strings pass through without repairing invalid UTF-8.
        constexpr Array<tchar, 3> s_Message = { static_cast<tchar>(0xc0u), static_cast<tchar>(0xafu), static_cast<tchar>('X') };
        constexpr Array<u8, 3> s_Expected = { 0xc0u, 0xafu, static_cast<u8>('X') };
#endif
        ASSERT_TRUE(Core::Telemetry::BuildTextLogPayload(LogType::Info, TStringView(s_Message.data(), s_Message.size()), testArena.scratchArena, payload));
        CheckTextLogPayload(payload, s_Expected);
    }
}

void VerifyTelemetry_TextLogPayloadPreservesAliasedInputBeforeHeaderWrite(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    native(mut testArena, mut payload){
        constexpr TStringView s_Message = NWB_TEXT("captured \ud55c\U0001f642");
        constexpr Array<u8, 16> s_Expected = { 'c', 'a', 'p', 't', 'u', 'r', 'e', 'd', ' ', 0xedu, 0x95u, 0x9cu, 0xf0u, 0x9fu, 0x99u, 0x82u };
        constexpr usize s_Offset = sizeof(tchar);
        constexpr usize s_MessageBytes = s_Message.size() * sizeof(tchar);
        payload.resize(s_Offset + s_MessageBytes);
        NWB_MEMCPY(payload.data() + s_Offset, s_MessageBytes, s_Message.data(), s_MessageBytes);
        const TStringView aliased(reinterpret_cast<const tchar*>(payload.data() + s_Offset), s_Message.size());
        ASSERT_TRUE(Core::Telemetry::BuildTextLogPayload(LogType::Error, aliased, testArena.scratchArena, payload));
        CheckTextLogPayload(payload, s_Expected);
    }
}

void VerifyTelemetry_TextLogPayloadRejectsNonCurrentVersionsAndRecovers(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    native(mut testArena, mut payload){
        ASSERT_TRUE(Core::Telemetry::BuildTextLogPayload(LogType::Warning, NWB_TEXT("retained log"), testArena.scratchArena, payload));
        const TelemetryBytes current = payload;
        const Array<u16, 3> unsupportedVersions = { 0u, static_cast<u16>(Core::Telemetry::s_TextLogPayloadVersion + 1u), Limit<u16>::s_Max, };
        for(const u16 version : unsupportedVersions){
            ScopedTestTrace trace(version);
            ASSERT_TRUE(Core::Telemetry::ParseTextLogPayload(current.data(), current.size()).has_value());
            usize cursor = 0u;
            const auto readHeader = ReadPOD<Core::Telemetry::EncodedTextLogPayloadHeader>(current, cursor);
            ASSERT_TRUE(readHeader.has_value());
            Core::Telemetry::EncodedTextLogPayloadHeader header = readHeader.value();
            header.version = version;
            NWB_MEMCPY(payload.data(), payload.size(), &header, sizeof(header));
            EXPECT_FALSE(Core::Telemetry::ParseTextLogPayload(payload.data(), payload.size()).has_value());
            const auto parsed = Core::Telemetry::ParseTextLogPayload(current.data(), current.size());
            ASSERT_TRUE(parsed.has_value());
            EXPECT_EQ(AStringView(parsed.value().messageUtf8), AStringView("retained log"));
        }
    }
}

void VerifyTelemetry_TextLogPayloadEmptyAndInvalidTypeReplacePreviousBytes(){
    TelemetryTestArena testArena = TelemetryTestArena();
    TelemetryBytes payload = TelemetryBytes(testArena.arena);
    native(mut testArena, mut payload){
        ASSERT_TRUE(Core::Telemetry::BuildTextLogPayload(LogType::Info, NWB_TEXT("old payload"), testArena.scratchArena, payload));
        ASSERT_TRUE(Core::Telemetry::BuildTextLogPayload(LogType::EssentialInfo, {}, testArena.scratchArena, payload));
        CheckTextLogPayload(payload);
        EXPECT_FALSE(Core::Telemetry::BuildTextLogPayload(static_cast<LogType::Enum>(0xffu), {}, testArena.scratchArena, payload));
    }
    EXPECT_TRUE(payload.empty());
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


[source]
native{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


namespace TelemetryRecorderReportDetail{


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


void RunConcurrentReset(const b8 disableCapture){
    constexpr usize s_WorkerCount = 4u;
    TestArena testArena;
    const ArenaMemoryStats initial = testArena.arena.memoryStats();
    {
        Telemetry::Recorder recorder(testArena.arena);
        recorder.setCaptureOptions(Telemetry::CaptureOptions::PerfOnly());
        Atomic<usize> accepted{ 0u };
        Atomic<usize> damagedPayloads{ 0u };
        Latch payloadsReady(s_WorkerCount);
        Latch releasePayloads(1u);
        Array<Thread, s_WorkerCount> workers;
        for(usize index = 0u; index < s_WorkerCount; ++index){
            workers[index] = Thread([&, index](){
                b8 enteredBuilder = false;
                const b8 recorded = recorder.recordBuiltPayload(Telemetry::EventKind::PerfFrame, 42u, static_cast<u32>(index), [&](Telemetry::TelemetryArena&, Telemetry::TelemetryBytes& payload){
                    enteredBuilder = true;
                    payload.resize(256u, static_cast<u8>(index + 1u));
                    payloadsReady.count_down();
                    releasePayloads.wait();
                    for(const u8 value : payload){
                        if(value != index + 1u){
                            damagedPayloads.fetch_add(1u, MemoryOrder::relaxed);
                            break;
                        }
                    }
                    return true;
                });
                if(!enteredBuilder)
                    payloadsReady.count_down();
                if(recorded)
                    accepted.fetch_add(1u, MemoryOrder::relaxed);
            });
        }
        payloadsReady.wait();
        recorder.clear();
        const u8 marker = 99u;
        const b8 markerRecorded = recorder.recordBinary(Telemetry::EventKind::PerfFrame, 7u, &marker, sizeof(marker), 99u);
        if(disableCapture)
            recorder.setCaptureOptions(Telemetry::CaptureOptions::Disabled());
        releasePayloads.count_down();
        for(Thread& worker : workers)
            worker.join();

        EXPECT_TRUE(markerRecorded);
        EXPECT_EQ(damagedPayloads.load(MemoryOrder::relaxed), 0u);
        EXPECT_EQ(accepted.load(MemoryOrder::relaxed), disableCapture ? 0u : s_WorkerCount);
        EXPECT_EQ(recorder.eventCount(), disableCapture ? 0u : s_WorkerCount + 1u);
        if(!disableCapture){
            Array<b8, s_WorkerCount> seen = {};
            for(usize index = 1u; index < recorder.eventCount(); ++index){
                const auto* event = recorder.view().eventAt(index);
                ASSERT_NE(event, nullptr);
                ASSERT_LT(event->header.streamId, s_WorkerCount);
                EXPECT_FALSE(seen[event->header.streamId]);
                seen[event->header.streamId] = true;
                ASSERT_EQ(event->payload.size(), 256u);
                EXPECT_EQ(event->payload.front(), event->header.streamId + 1u);
                EXPECT_EQ(event->payload.back(), event->header.streamId + 1u);
            }
            for(const b8 recorded : seen)
                EXPECT_TRUE(recorded);
        }
    }
    const ArenaMemoryStats after = testArena.arena.memoryStats();
    EXPECT_EQ(after.usedBytes, initial.usedBytes);
    EXPECT_EQ(after.reservedBytes, initial.reservedBytes);
}

void CheckTextLogPayload(const Span<const u8> payload, const Span<const u8> expected){
    ASSERT_EQ(payload.size(), sizeof(Telemetry::EncodedTextLogPayloadHeader) + expected.size());
    usize cursor = 0u;
    const auto readHeader = ReadPOD<Telemetry::EncodedTextLogPayloadHeader>(payload, cursor);
    ASSERT_TRUE(readHeader.has_value());
    Telemetry::EncodedTextLogPayloadHeader header = readHeader.value();
    EXPECT_EQ(header.messageBytes, expected.size());
    for(usize index = 0u; index < expected.size(); ++index)
        EXPECT_EQ(payload[cursor + index], expected[index]) << index;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


};


