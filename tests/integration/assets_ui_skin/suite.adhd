const StringView s_SkinPath = "test/skin";
const StringView s_LastRegionName = "last";
const StringView s_EngineDirectory = "impl";
const StringView s_AssetsDirectory = "assets";
const StringView s_UiDirectory = "ui";
const StringView s_SkinsDirectory = "skins";
const StringView s_DefaultSkinDirectory = "default";
const StringView s_AtlasMetadataFilename = "atlas.nwb";
const StringView s_WhiteRegionName = "white";
const StringView s_SkinAssetRoot = "C:/ui_skin_tests/assets";
const StringView s_TexturePath = "project/ui/texture";
const StringView s_AtlasPath = "project/ui/atlas";

UiSkinRegion MakeRegion(in Name name, in u32 ordinal){
    UiSkinRegion region = UiSkinRegion();
    region.name = name;
    region.rectangle.x = ordinal;
    region.rectangle.y = 0u;
    region.rectangle.width = 1u;
    region.rectangle.height = 1u;
    return region;
}

void SetRegions(mut UiSkin skin, mut RegionVector regions){
    native(mut skin, mut regions){
        skin.setAtlas(Core::Assets::AssetRef<Texture>("test/skin/texture"), 8192u, 1u, 1.0f, Move(regions));
    }
}

Name RegionName(in u32 index){
    Name result = s_NameNone;
    native(in index, mut result){
        NameHash hash{};
        hash.qwords[0u] = 1u + (index * 271u) % s_UiSkinMaxRegionCount;
        hash.qwords[s_NameHashLaneCount - 1u] = index + 1u;
        result = Name(hash);
    }
    return result;
}

usize FindRegionAddress(in UiSkin skin, in Name name){
    usize address = 0u;
    native(in skin, in name, mut address){
        address = reinterpret_cast<usize>(skin.findRegion(name));
    }
    return address;
}

usize RegionElementAddress(in UiSkin skin, in usize index){
    usize address = 0u;
    native(in skin, in index, mut address){
        address = reinterpret_cast<usize>(&skin.regions()[index]);
    }
    return address;
}

b8 LoadAuthoredSkin(in Path assetRoot, in Path atlasPath, in StringView virtualRoot, mut ToolkitSkinArena testArena, mut UiSkin outSkin, mut b8 outComplete){
    b8 ok = false;
    native(in assetRoot, in atlasPath, in virtualRoot, mut testArena, mut outSkin, mut outComplete, mut ok){
        Core::Assets::AssetString metadata(testArena.arena);
        if(!ReadTextFile(atlasPath, metadata))
            return false;
        Core::Metascript::Document document(testArena.arena);
        if(!document.parse(metadata))
            return false;
        Core::Alloc::ScratchArena scratchArena(s_OneOffNameTestsIntegrationAssetsUiSkinToolkitContract);
        auto entryResult = ParseUiSkinCookMetadata(assetRoot, virtualRoot, atlasPath, document, testArena.arena, scratchArena);
        if(!entryResult)
            return false;
        auto skinResult = BuildUiSkinAsset(*entryResult, testArena.arena);
        if(!skinResult)
            return false;
        outSkin = Move(*skinResult);
        outComplete = entryResult->completeToolkitSkin;
        ok = true;
    }
    return ok;
}

void CopyWithoutRegion(in UiSkin source, in Name removed, mut ToolkitSkinArena testArena, mut UiSkin outSkin){
    RegionVector regions(testArena.arena);
    for(usize index = 0u; index < source.regions().size(); ++index){
        const UiSkinRegion region = source.regions()[index];
        if(region.name != removed)
            regions.push_back(region);
    }
    native(in source, mut regions, mut outSkin){
        outSkin.setAtlas(source.texture(), source.atlasWidth(), source.atlasHeight(), source.referenceDensity(), Move(regions));
    }
}

b8 CanParseMetadata(in StringView metadata, mut SkinTestArena testArena){
    b8 ok = false;
    native(in metadata, mut testArena, mut ok){
        Core::Metascript::Document document(testArena.arena);
        if(!document.parse(metadata))
            return false;
        const Path assetRoot(testArena.arena, s_SkinAssetRoot);
        const Path metadataPath = assetRoot / s_UiDirectory / s_AtlasMetadataFilename;
        Core::Alloc::ScratchArena scratchArena(s_OneOffNameTestsIntegrationAssetsUiSkinCook);
        ok = ParseUiSkinCookMetadata(assetRoot, "project", metadataPath, document, testArena.arena, scratchArena).has_value();
    }
    return ok;
}

AssetBytes MakeBinary(in UiSkinHeaderBinary header, in UiSkinRegionBinary region, mut SkinTestArena testArena){
    AssetBytes binary(testArena.arena);
    native(in header, in region, mut binary){
        binary.reserve(sizeof(header) + sizeof(region) + s_ColorRoleCount * sizeof(UiSkinColor) + sizeof(UiSkinTypography));
        AppendPOD(binary, header);
        AppendPOD(binary, region);
        for(const UiSkinColor& color : UiSkinPalette{}.colors)
            AppendPOD(binary, color);
        AppendPOD(binary, UiSkinTypography{});
    }
    return binary;
}

UiSkinHeaderBinary ValidHeader(){
    UiSkinHeaderBinary header = UiSkinHeaderBinary();
    header.textureNameHash = Name(s_TexturePath).hash();
    header.atlasWidth = 64u;
    header.atlasHeight = 32u;
    header.referenceDensity = 2.0f;
    header.regionCount = 1u;
    return header;
}

UiSkinRegionBinary ValidRegion(){
    UiSkinRegionBinary region = UiSkinRegionBinary();
    region.nameHash = s_UiTestPanelNormal.hash();
    region.x = 2u;
    region.y = 4u;
    region.width = 24u;
    region.height = 20u;
    region.sliceLeft = 3u;
    region.sliceTop = 4u;
    region.sliceRight = 5u;
    region.sliceBottom = 6u;
    region.drawMode = s_DrawModeNineSlice;
    return region;
}

TestAString PaletteMetadata(in u32 variant, in b8 includeTypography){
    TestAString metadata(s_BaseMetadata);
    if(includeTypography)
        metadata.append("asset.typography = {\"default_font_size\": 16.0};\r\n");
    if(variant == 1u)
        return metadata;
    metadata.append("asset.colors = [\r\n");
    usize count = s_ColorRoleCount;
    if(variant == 2u)
        count = s_ColorRoleCount - 1u;
    for(usize index = 0u; index < count; ++index){
        StringView name = s_PaletteRoleNames[index];
        if(variant == 3u && index == count - 1u)
            name = s_PaletteRoleNames[0u];
        else if(variant == 4u && index == count - 1u)
            name = "unknown.role";
        metadata.append("  { \"name\": \"");
        metadata.append(name);
        metadata.append("\", \"rgba\": ");
        StringView rgba = "[0.25, 0.5, 0.75, 1.0]";
        if(variant == 5u && index == 0u)
            rgba = "[16.1, 0.5, 0.75, 1.0]";
        else if(variant == 6u && index == 0u)
            rgba = "[0.25, 0.5, 0.75, 1.1]";
        else if(index == s_ColorRoleControlHoverTint)
            rgba = "[1.08, 1.08, 1.08, 1.0]";
        metadata.append(rgba);
        metadata.append(" },\r\n");
    }
    metadata.append("];\r\n");
    return metadata;
}

TestAString TypographyMetadata(in StringView typography){
    TestAString metadata = PaletteMetadata(0u, false);
    if(!typography.empty()){
        metadata.append("asset.typography = ");
        metadata.append(typography);
        metadata.append(";\r\n");
    }
    return metadata;
}

AssetBytes MakeTypographyBinary(in UiSkinColor color, in f32 defaultFontSize, mut SkinTestArena testArena){
    const UiSkinHeaderBinary header = ValidHeader();
    AssetBytes binary = MakeBinary(header, ValidRegion(), testArena);
    binary.resize(s_UiSkinHeaderBinarySize + s_UiSkinRegionBinarySize);
    native(in color, in defaultFontSize, mut binary){
        for(usize index = 0u; index < s_ColorRoleCount; ++index)
            AppendPOD(binary, color);
        UiSkinTypography typography;
        typography.defaultFontSize = defaultFontSize;
        AppendPOD(binary, typography);
    }
    return binary;
}

void VerifyAssetsUiSkinRegionIndex_MaximumCountPreservesAuthoredOrderAcrossHashOrderAndMisses(){
    DefaultTestArena owner = DefaultTestArena();
    UiSkin skin(owner.arena, Name(s_SkinPath));
    RegionVector regions(owner.arena);
    regions.reserve(s_UiSkinMaxRegionCount);
    for(u32 index = 0u; index < s_UiSkinMaxRegionCount; ++index)
        regions.push_back(MakeRegion(RegionName(index), index));
    SetRegions(skin, regions);
    ASSERT_TRUE(skin.validatePayload());
    for(u32 index = 0u; index < s_UiSkinMaxRegionCount; ++index){
        ASSERT_EQ(skin.regions()[index].rectangle.x, index);
        ASSERT_EQ(skin.regions()[index].name, RegionName(index));
        ASSERT_EQ(FindRegionAddress(skin, RegionName(index)), RegionElementAddress(skin, index));
    }
    EXPECT_EQ(FindRegionAddress(skin, s_NameNone), 0u);
    EXPECT_EQ(FindRegionAddress(skin, s_UiLookupNameMissing), 0u);
    Name afterName = s_NameNone;
    native(mut afterName){
        NameHash after{};
        after.qwords[0u] = Limit<u64>::s_Max;
        afterName = Name(after);
    }
    EXPECT_EQ(FindRegionAddress(skin, afterName), 0u);
}

void VerifyAssetsUiSkinRegionIndex_CanonicalDuplicateKeepsFirstAuthoredMatchAndFailsAdmission(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    DefaultTestArena owner = DefaultTestArena();
    UiSkin skin(owner.arena, Name(s_SkinPath));
    RegionVector regions(owner.arena);
    regions.push_back(MakeRegion(Name("Button\\Normal"), 0u));
    regions.push_back(MakeRegion(s_UiTestPanelNormal, 1u));
    regions.push_back(MakeRegion(Name("button/normal"), 2u));
    SetRegions(skin, regions);
    EXPECT_EQ(FindRegionAddress(skin, Name("BUTTON/NORMAL")), RegionElementAddress(skin, 0u));
    EXPECT_FALSE(skin.validatePayload());
    EXPECT_TRUE(logger.sawErrorContaining(s_ErrDuplicateRegion));
}

void VerifyAssetsUiSkinRegionIndex_EqualLeadingHashLanesStillResolveDistinctNames(){
    DefaultTestArena owner = DefaultTestArena();
    UiSkin skin(owner.arena, Name(s_SkinPath));
    RegionVector regions(owner.arena);
    for(u32 index = 0u; index < 129u; ++index){
        Name hashName = s_NameNone;
        native(in index, mut hashName){
            NameHash hash{};
            hash.qwords[0u] = 123u;
            hash.qwords[s_NameHashLaneCount - 1u] = 129u - index;
            hashName = Name(hash);
        }
        regions.push_back(MakeRegion(hashName, index));
    }
    SetRegions(skin, regions);
    ASSERT_TRUE(skin.validatePayload());
    for(usize index = 0u; index < skin.regions().size(); ++index)
        EXPECT_EQ(FindRegionAddress(skin, skin.regions()[index].name), RegionElementAddress(skin, index));
    Name missingName = s_NameNone;
    native(in skin, mut missingName){
        NameHash missing = skin.regions()[0u].name.hash();
        missing.qwords[s_NameHashLaneCount - 1u] = 130u;
        missingName = Name(missing);
    }
    EXPECT_EQ(FindRegionAddress(skin, missingName), 0u);
}

void VerifyAssetsUiSkinRegionIndex_ReplacementAcrossSmallSkinBoundaryDoesNotKeepStaleMatches(){
    DefaultTestArena owner = DefaultTestArena();
    UiSkin skin(owner.arena, Name(s_SkinPath));
    Name previous = s_NameNone;
    for(u32 stage = 0u; stage < s_BoundaryStageCounts.size(); ++stage){
        RegionVector regions(owner.arena);
        for(u32 index = 0u; index < s_BoundaryStageCounts[stage]; ++index)
            regions.push_back(MakeRegion(RegionName(index + stage * 256u), index));
        SetRegions(skin, regions);
        ASSERT_TRUE(skin.validatePayload());
        for(usize index = 0u; index < skin.regions().size(); ++index)
            EXPECT_EQ(FindRegionAddress(skin, skin.regions()[index].name), RegionElementAddress(skin, index));
        EXPECT_EQ(FindRegionAddress(skin, previous), 0u);
        EXPECT_EQ(FindRegionAddress(skin, s_UiLookupNameMissing), 0u);
        previous = skin.regions().back().name;
    }
}

void VerifyAssetsUiSkinRegionIndex_ReplacementMovesAndCopiesDoNotRetainStaleRegionReferences(){
    DefaultTestArena firstOwner = DefaultTestArena();
    DefaultTestArena secondOwner = DefaultTestArena();
    UiSkin source(firstOwner.arena, Name(s_SkinPath));
    RegionVector regions(firstOwner.arena);
    regions.push_back(MakeRegion(s_UiTestOld, 0u));
    SetRegions(source, regions);
    RegionVector replacement(secondOwner.arena);
    replacement.push_back(MakeRegion(s_UiTestNew, 1u));
    replacement.push_back(MakeRegion(s_UiTestOther, 2u));
    SetRegions(source, replacement);
    native(mut firstOwner, mut secondOwner, mut source){
        EXPECT_EQ(&source.regions().get_allocator().arena(), &secondOwner.arena);
        EXPECT_EQ(source.findRegion(s_UiLookupNameOld), nullptr);
        UiSkin moved(Move(source));
        EXPECT_EQ(moved.findRegion(s_UiLookupNameNew), &moved.regions()[0u]);
        UiSkin copied(moved);
        EXPECT_EQ(copied.findRegion(s_UiLookupNameOther), &copied.regions()[1u]);
        EXPECT_NE(copied.findRegion(s_UiLookupNameOther), moved.findRegion(s_UiLookupNameOther));
        UiSkin assigned(firstOwner.arena, s_UiTestDestination);
        assigned = Move(moved);
        EXPECT_EQ(assigned.findRegion(s_UiLookupNameNew), &assigned.regions()[0u]);
        EXPECT_EQ(assigned.findRegion(s_UiLookupNameOld), nullptr);
        RegionVector empty(secondOwner.arena);
        assigned.setAtlas(Core::Assets::AssetRef<Texture>("test/skin/texture"), 8192u, 1u, 1.0f, Move(empty));
        EXPECT_EQ(assigned.findRegion(s_UiLookupNameNew), nullptr);
        EXPECT_EQ(copied.findRegion(s_UiLookupNameNew), &copied.regions()[0u]);
    }
}

void VerifyAssetsUiSkinRegionIndex_FailedBinaryLoadPreservesLookupAndAuthoredOrder(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    DefaultTestArena owner = DefaultTestArena();
    UiSkin source(owner.arena, Name(s_SkinPath));
    RegionVector regions(owner.arena);
    regions.push_back(MakeRegion(Name(s_LastRegionName), 0u));
    regions.push_back(MakeRegion(s_UiTestFirst, 1u));
    SetRegions(source, regions);
    UiSkinAssetCodec codec = UiSkinAssetCodec();
    AssetBytes binary(owner.arena);
    ASSERT_TRUE(codec.serialize(source, binary));
    UiSkin loaded(owner.arena, source.virtualPath());
    ASSERT_TRUE(loaded.loadBinary(binary));
    ASSERT_EQ(FindRegionAddress(loaded, s_UiLookupNameFirst), RegionElementAddress(loaded, 1u));
    const usize retained = FindRegionAddress(loaded, Name(s_LastRegionName));
    native(mut binary){
        const usize firstHash = sizeof(UiSkinHeaderBinary);
        const usize secondHash = firstHash + sizeof(UiSkinRegionBinary);
        NWB_MEMCPY(binary.data() + secondHash, sizeof(NameHash), binary.data() + firstHash, sizeof(NameHash));
    }
    EXPECT_FALSE(loaded.loadBinary(binary));
    EXPECT_EQ(FindRegionAddress(loaded, Name(s_LastRegionName)), retained);
    EXPECT_EQ(FindRegionAddress(loaded, s_UiLookupNameFirst), RegionElementAddress(loaded, 1u));
    EXPECT_EQ(loaded.regions()[0u].name, Name(s_LastRegionName));
}

void VerifyAssetsUiSkinRegionIndex_OversizedInvalidSkinRemainsInspectableWithoutIndexedAdmission(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    DefaultTestArena owner = DefaultTestArena();
    UiSkin skin(owner.arena, Name(s_SkinPath));
    RegionVector regions(owner.arena);
    regions.reserve(s_UiSkinMaxRegionCount + 1u);
    for(u32 index = 0u; index <= s_UiSkinMaxRegionCount; ++index)
        regions.push_back(MakeRegion(RegionName(index), index));
    SetRegions(skin, regions);
    EXPECT_FALSE(skin.validatePayload());
    EXPECT_EQ(FindRegionAddress(skin, RegionName(s_UiSkinMaxRegionCount)), RegionElementAddress(skin, skin.regions().size() - 1u));
    EXPECT_EQ(FindRegionAddress(skin, s_UiLookupNameMissing), 0u);
}

void VerifyAssetsUiSkinToolkitContract_RejectsMissingBasePartsButAcceptsDeclaredStateFallbacks(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    ToolkitSkinArena testArena = ToolkitSkinArena();
    Path assetRoot(testArena.arena);
    Path atlasPath(testArena.arena);
    native(mut testArena, mut assetRoot, mut atlasPath){
        assetRoot = Path(testArena.arena, NWB_REPO_ROOT) / s_EngineDirectory / s_AssetsDirectory;
        atlasPath = assetRoot / s_UiDirectory / s_SkinsDirectory / s_DefaultSkinDirectory / s_AtlasMetadataFilename;
    }
    UiSkin source(testArena.arena);
    b8 complete = false;
    ASSERT_TRUE(LoadAuthoredSkin(assetRoot, atlasPath, "engine", testArena, source, complete));
    EXPECT_TRUE(complete);

    Vector<Name> required = Vector<Name>();
    required.push_back(s_UiTitle);
    required.push_back(s_UiCheck);
    required.push_back(s_UiSelected);
    required.push_back(s_UiArrow);
    required.push_back(s_UiFill);
    required.push_back(s_UiFocus);
    for(usize index = 0u; index < required.size(); ++index){
        const Name removed = required[index];
        const ScopedTestTrace trace(removed.resolvedText());
        UiSkin candidate(testArena.arena, source.virtualPath());
        CopyWithoutRegion(source, removed, testArena, candidate);
        EXPECT_TRUE(candidate.validatePayload());
        EXPECT_FALSE(ValidateUiSkinToolkitContract(candidate));
    }

    Vector<Name> optional = Vector<Name>();
    optional.push_back(s_UiTestButtonHover);
    optional.push_back(s_UiTestCheckboxChecked);
    optional.push_back(s_UiTestEditFocused);
    optional.push_back(s_UiTestComboOpen);
    optional.push_back(s_UiTestSliderThumbHover);
    for(usize index = 0u; index < optional.size(); ++index){
        const Name removed = optional[index];
        const ScopedTestTrace trace(removed.resolvedText());
        UiSkin candidate(testArena.arena, source.virtualPath());
        CopyWithoutRegion(source, removed, testArena, candidate);
        EXPECT_TRUE(ValidateUiSkinToolkitContract(candidate));
    }

    UiSkin noResize(testArena.arena, source.virtualPath());
    CopyWithoutRegion(source, Name(s_WhiteRegionName), testArena, noResize);
    EXPECT_FALSE(ValidateUiSkinToolkitContract(noResize));

    RegionVector regions(testArena.arena);
    for(usize index = 0u; index < noResize.regions().size(); ++index)
        regions.push_back(noResize.regions()[index]);
    UiSkin explicitResize(testArena.arena, source.virtualPath());
    native(in source, mut regions, mut explicitResize){
        UiSkinRegion resize = *source.findRegion(Name(s_WhiteRegionName));
        resize.name = s_UiTestWindowResize;
        regions.push_back(resize);
        explicitResize.setAtlas(source.texture(), source.atlasWidth(), source.atlasHeight(), source.referenceDensity(), Move(regions));
    }
    EXPECT_TRUE(ValidateUiSkinToolkitContract(explicitResize));
}

void VerifyAssetsUiSkinToolkitContract_CookOptInRejectsIncompleteMetadataWhileGenericSkinRemainsValid(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    ToolkitSkinArena testArena = ToolkitSkinArena();
    TestAString genericMetadata = TestAString();
    Path assetRoot(testArena.arena, "C:/ui_skin_contract_tests/assets");
    Path atlasPath(testArena.arena);
    b8 readDefault = false;
    native(in assetRoot, mut testArena, mut atlasPath, mut genericMetadata, mut readDefault){
        atlasPath = assetRoot / s_UiDirectory / s_AtlasMetadataFilename;
        const Path defaultAtlasPath = Path(testArena.arena, NWB_REPO_ROOT) / s_EngineDirectory / s_AssetsDirectory / s_UiDirectory / s_SkinsDirectory / s_DefaultSkinDirectory / s_AtlasMetadataFilename;
        readDefault = static_cast<b8>(ReadTextFile(defaultAtlasPath, genericMetadata));
    }
    ASSERT_TRUE(readDefault);
    const StringView contractField = "asset.toolkit_contract = \"widgets\";";
    const usize contractOffset = genericMetadata.find(contractField);
    ASSERT_LT(contractOffset, genericMetadata.size());
    genericMetadata.erase(contractOffset, contractField.size());
    genericMetadata.append("asset.regions = [{ \"name\": \"panel.normal\", \"rect\": [0, 0, 16, 16] }];\r\n");
    TestAString completeMetadata(genericMetadata);
    completeMetadata.append(contractField);

    MetascriptDocument genericDocument(testArena.arena);
    ASSERT_TRUE(genericDocument.parse(genericMetadata));
    ScratchArena scratchArena(s_OneOffNameTestsIntegrationAssetsUiSkinToolkitContract);
    UiSkin genericSkin(testArena.arena);
    b8 genericComplete = true;
    b8 builtGeneric = false;
    native(in assetRoot, in atlasPath, in genericDocument, mut testArena, mut scratchArena, mut genericSkin, mut genericComplete, mut builtGeneric){
        auto entryResult = ParseUiSkinCookMetadata(assetRoot, "project", atlasPath, genericDocument, testArena.arena, scratchArena);
        if(entryResult){
            genericComplete = entryResult->completeToolkitSkin;
            auto buildResult = BuildUiSkinAsset(*entryResult, entryResult->arena);
            if(buildResult){
                genericSkin = Move(*buildResult);
                builtGeneric = true;
            }
        }
    }
    ASSERT_TRUE(builtGeneric);
    EXPECT_FALSE(genericComplete);
    EXPECT_FALSE(ValidateUiSkinToolkitContract(genericSkin));

    MetascriptDocument completeDocument(testArena.arena);
    ASSERT_TRUE(completeDocument.parse(completeMetadata));
    b8 parsedComplete = true;
    native(in assetRoot, in atlasPath, in completeDocument, mut testArena, mut scratchArena, mut parsedComplete){
        parsedComplete = ParseUiSkinCookMetadata(assetRoot, "project", atlasPath, completeDocument, testArena.arena, scratchArena).has_value();
    }
    EXPECT_FALSE(parsedComplete);
    EXPECT_TRUE(logger.sawErrorContaining(s_ErrMissingWindowNormal));
}

void VerifyAssetsUiSkin_TypographyRejectsMalformedFooterWithoutReplacingSkin(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    SkinTestArena testArena = SkinTestArena();
    const UiSkinColor color(0.25f, 0.5f, 0.75f, 1.0f);
    UiSkin skin(testArena.arena, Name(s_AtlasPath));
    ASSERT_TRUE(skin.loadBinary(MakeTypographyBinary(color, 21.5f, testArena)));

    for(u32 variant = 0u; variant < 5u; ++variant){
        const ScopedTestTrace trace(variant);
        f32 fontSize = 21.5f;
        if(variant == 2u)
            fontSize = 0.0f;
        else if(variant == 3u)
            fontSize = 2049.0f;
        else if(variant == 4u)
            fontSize = s_QuietNaNF32;
        AssetBytes binary = MakeTypographyBinary(color, fontSize, testArena);
        if(variant == 0u)
            binary.pop_back();
        if(variant == 1u)
            binary.push_back(0u);
        EXPECT_FALSE(skin.loadBinary(binary));
        EXPECT_FLOAT_EQ(skin.typography().defaultFontSize, 21.5f);
    }
}

void VerifyAssetsUiSkin_TypographyMetadataRequiresValidFontSize(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    SkinTestArena testArena = SkinTestArena();
    ASSERT_TRUE(CanParseMetadata(TypographyMetadata("{\"default_font_size\": 21.5}"), testArena));
    for(usize index = 0u; index < s_MalformedTypographyValues.size(); ++index){
        const ScopedTestTrace trace(index);
        EXPECT_FALSE(CanParseMetadata(TypographyMetadata(s_MalformedTypographyValues[index]), testArena));
    }
}

void VerifyAssetsUiSkin_PaletteRejectsMalformedFooterWithoutReplacingSkin(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    SkinTestArena testArena = SkinTestArena();
    UiSkinColor color = UiSkinColor();
    color.r = 0.25f;
    color.g = 0.5f;
    color.b = 0.75f;
    color.a = 1.0f;
    UiSkin skin(testArena.arena, Name(s_AtlasPath));
    ASSERT_TRUE(skin.loadBinary(MakeTypographyBinary(color, 16.0f, testArena)));

    for(u32 variant = 0u; variant < 6u; ++variant){
        const ScopedTestTrace trace(variant);
        UiSkinColor candidateColor = color;
        if(variant == 2u)
            candidateColor.r = s_QuietNaNF32;
        if(variant == 3u)
            candidateColor.g = -0.1f;
        if(variant == 4u)
            candidateColor.b = 16.1f;
        if(variant == 5u)
            candidateColor.a = 1.1f;
        AssetBytes binary = MakeTypographyBinary(candidateColor, 16.0f, testArena);
        if(variant == 0u)
            binary.resize(binary.size() - s_UiSkinTypographySize - 1u);
        if(variant == 1u)
            binary.push_back(0u);
        EXPECT_FALSE(skin.loadBinary(binary));
        ASSERT_EQ(skin.regions().size(), 1u);
        EXPECT_EQ(skin.regions().front().name, s_UiTestPanelNormal);
        EXPECT_FLOAT_EQ(skin.palette().colors[s_ColorRoleTextNormal].r, 0.25f);
    }
}

