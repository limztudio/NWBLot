////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class TraceGeometryImportPolicy{
    public b8 hasHardwareRole(in u8 roles)const{
        const PreparedShadowTraceGeometryRole hardwareMask =
            PreparedShadowTraceGeometryRole::HardwarePosition
            | PreparedShadowTraceGeometryRole::HardwareIndex
            | PreparedShadowTraceGeometryRole::HardwareAttribute;
        return (roles & cast<u8>(hardwareMask)) != 0u;
    }

    public b8 hasSoftwareRole(in u8 roles)const{
        const PreparedShadowTraceGeometryRole softwareMask =
            PreparedShadowTraceGeometryRole::SoftwareNode
            | PreparedShadowTraceGeometryRole::SoftwarePosition
            | PreparedShadowTraceGeometryRole::SoftwareIndex
            | PreparedShadowTraceGeometryRole::SoftwareAttribute;
        return (roles & cast<u8>(softwareMask)) != 0u;
    }

    public usize computeBuildStateReserveCapacity(in usize parentStateCount)const{
        return parentStateCount + s_SortBuildStateCapacity;
    }

    public b8 isConstantBufferSceneSlot(in usize importedBufferIndex)const{
        return importedBufferIndex == 0u;
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


b8 AppendSoftwareBvhBuildState(in BufferHandle buffer, in Name identity, in StringView label, mut GpuTaskGraph graph, mut Vector<BufferHandle> seen, mut Vector<GpuGraphResourceId> resources){
    if(!buffer.valid() || identity == Name())
        return false;
    for(in BufferHandle existing : seen){
        if(SameAddress(existing.deref(), buffer.deref()))
            return true;
    }
    const auto imported = ImportExternalBuffer(graph, buffer, identity, label);
    if(!imported.has_value())
        return false;
    seen.push_back(buffer);
    resources.push_back(imported.value());
    return true;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Expected<FrameGraphSoftwareBvhBuildStateResult> FrameGraphSoftwareBvhBuildStateImporter::declare(in FrameGraphSoftwareBvhBuildStateInputs inputs){
    FrameGraphSoftwareBvhBuildStateResult result;
    const TraceGeometryImportPolicy importPolicy();
    in RayTracingShadowPreparationResourceSnapshot rayTracingShadowResources = inputs.rayTracingShadowResources;
    Vector<BufferHandle> softwareBvhBuildStateBuffers;
    if(inputs.softwareTraceResourcesPrepared){
        const auto meshSoftwareBvhParentBuildStates = this.m_meshSystem.collectSoftwareBvhParentBuildStates();
        if(!meshSoftwareBvhParentBuildStates.has_value())
            return MakeUnexpected(Failure());
        // Sort keys, sort payload, and visit counter follow the parent build states.
        const usize reserveCapacity = importPolicy.computeBuildStateReserveCapacity(meshSoftwareBvhParentBuildStates.value().size());
        result.buildStateResources.reserve(reserveCapacity);
        softwareBvhBuildStateBuffers.reserve(reserveCapacity);
        for(in MeshSoftwareBvhParentBuildState state : meshSoftwareBvhParentBuildStates.value()){
            if(!AppendSoftwareBvhBuildState(state.buffer, state.identity, "Software BVH Parent", this.m_graph, softwareBvhBuildStateBuffers, result.buildStateResources)){
                warning("RendererSystem: could not import software BVH parent build state");
                return MakeUnexpected(Failure());
            }
        }
        if(
            !rayTracingShadowResources.bvhSortKeysBuffer.valid()
            || !rayTracingShadowResources.bvhSortPayloadBuffer.valid()
            || !rayTracingShadowResources.bvhVisitCounterBuffer.valid()
            || !AppendSoftwareBvhBuildState(rayTracingShadowResources.bvhSortKeysBuffer, Name(s_RenderNameRenderShadowTraceSwBvhSortKeys), "Software BVH Sort Keys", this.m_graph, softwareBvhBuildStateBuffers, result.buildStateResources)
            || !AppendSoftwareBvhBuildState(rayTracingShadowResources.bvhSortPayloadBuffer, Name(s_RenderNameRenderShadowTraceSwBvhSortPayload), "Software BVH Sort Payload", this.m_graph, softwareBvhBuildStateBuffers, result.buildStateResources)
            || !AppendSoftwareBvhBuildState(rayTracingShadowResources.bvhVisitCounterBuffer, Name(s_RenderNameRenderShadowTraceSwBvhVisitCounter), "Software BVH Visit Counter", this.m_graph, softwareBvhBuildStateBuffers, result.buildStateResources)
        ){
            warning("RendererSystem: could not import shared software BVH build state");
            return MakeUnexpected(Failure());
        }
    }
    return result;
}

Expected<FrameGraphTraceGeometryResult> FrameGraphTraceGeometryImporter::declare(in RayTracingShadowPreparationResourceSnapshot rayTracingShadowResources){
    const TraceGeometryImportPolicy importPolicy();

    // Preflight froze the mesh tables; import each buffer once and fan out IDs.
    if(!this.m_raytracingSystem.freezePreparedShadowTraceGeometryBuffers()){
        warning("RendererSystem: could not retain preflighted shadow-trace geometry buffers");
        return MakeUnexpected(Failure());
    }
    const Span<PreparedShadowTraceGeometryBuffer> preparedTraceGeometry = this.m_raytracingSystem.preparedShadowTraceGeometryBuffers();
    const Span<TextureHandle> preparedTraceMaterialSampledTextures = this.m_raytracingSystem.preparedShadowTraceMaterialSampledTextures();

    FrameGraphTraceGeometryResult result;
    result.traceGeometry.reserve(preparedTraceGeometry.size());
    result.hardwareTraceGeometry.reserve(preparedTraceGeometry.size());
    result.softwareTraceGeometry.reserve(preparedTraceGeometry.size());
    for(in PreparedShadowTraceGeometryBuffer preparedBuffer : preparedTraceGeometry){
        GpuGraphResourceDesc desc = BufferResourceDesc(preparedBuffer.identity, "Prepared Shadow Trace Geometry");
        desc.setInitialState(preparedBuffer.initialState);
        const auto resourceResult = this.m_graph.importBuffer(preparedBuffer.buffer, desc);
        if(!resourceResult.has_value()){
            warning("RendererSystem: could not import preflighted shadow-trace geometry buffer");
            return MakeUnexpected(Failure());
        }
        const GpuGraphResourceId resource = resourceResult.value();
        result.traceGeometry.push_back(resource);
        if(importPolicy.hasHardwareRole(preparedBuffer.roles))
            result.hardwareTraceGeometry.push_back(resource);
        if(importPolicy.hasSoftwareRole(preparedBuffer.roles))
            result.softwareTraceGeometry.push_back(resource);
    }
    // Trace dispatchers select textures via frozen material context; reuse typed preflight import when owned.
    const auto traceMaterialSampledTextureResources = ImportMaterialSampledTextureResources(preparedTraceMaterialSampledTextures, "Prepared Trace Material Sampled Texture", this.m_graph);
    if(!traceMaterialSampledTextureResources.has_value()){
        switch(traceMaterialSampledTextureResources.error()){
        case SampledTextureImportFailure::GraphUnavailable:
            warning("RendererSystem: prepared trace material texture graph was unavailable");
            return MakeUnexpected(Failure());
        case SampledTextureImportFailure::MissingIdentity:
            warning("RendererSystem: prepared trace material texture has no stable identity");
            return MakeUnexpected(Failure());
        case SampledTextureImportFailure::ImportFailed:
            warning("RendererSystem: could not import prepared trace material sampled texture");
            return MakeUnexpected(Failure());
        }
    }
    result.shadowTraceGeometrySet = this.importSet(Span<GpuGraphResourceId>(result.traceGeometry), Name(s_RenderNameRenderPostGbufferTraceGeometry), "Post-G-Buffer Trace Geometry");
    result.softwareTraceGeometrySet = this.importSet(Span<GpuGraphResourceId>(result.softwareTraceGeometry), Name(s_RenderNameRenderSoftwareTraceGeometry), "Software Trace Geometry");
    if(!traceMaterialSampledTextureResources.value().empty()){
        GpuGraphResourceSetDesc desc;
        desc.setIdentity(Name(s_RenderNameRenderTraceMaterialSampledTextures)).setMarkerLabel("Trace Material Sampled Textures").setMembers(traceMaterialSampledTextureResources.value());
        const auto traceMaterialSampledTextureSetResult = this.m_graph.importResourceSet(desc);
        if(!traceMaterialSampledTextureSetResult.has_value()){
            warning("RendererSystem: could not declare prepared trace material sampled textures");
            return MakeUnexpected(Failure());
        }
        result.traceMaterialSampledTextureSet = traceMaterialSampledTextureSetResult.value();
    }
    result.hardwareTraceGeometrySet = this.importSet(Span<GpuGraphResourceId>(result.hardwareTraceGeometry), Name(s_RenderNameRenderHardwareTraceGeometry), "Hardware Trace Geometry");

    result.softwareTraceResourcesPrepared = !result.softwareTraceGeometry.empty();
    FrameGraphSoftwareBvhBuildStateImporter softwareBvhBuildStateImporter(this.m_graph, this.m_meshSystem);
    auto softwareBvhBuildStateResult = softwareBvhBuildStateImporter.declare(
        FrameGraphSoftwareBvhBuildStateInputs(rayTracingShadowResources, result.softwareTraceResourcesPrepared)
    );
    if(!softwareBvhBuildStateResult.has_value()){
        warning("RendererSystem: could not import shared software BVH build state");
        return MakeUnexpected(Failure());
    }
    result.softwareBvhBuildState = softwareBvhBuildStateResult.value().buildStateResources;
    return result;
}

GpuGraphResourceSetId FrameGraphTraceGeometryImporter::importSet(in Span<GpuGraphResourceId> members, in Name identity, in StringView markerLabel){
    if(members.empty())
        return GpuGraphResourceSetId();

    GpuGraphResourceSetDesc desc;
    desc.setIdentity(identity).setMarkerLabel(markerLabel).setMembers(members);
    const auto setResult = this.m_graph.importResourceSet(desc);
    if(!setResult.has_value())
        return GpuGraphResourceSetId();
    return setResult.value();
}


