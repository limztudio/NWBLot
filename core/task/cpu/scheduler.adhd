[cpp_header("<core/task/cpu/scheduler.h>"), cpp_name("::NWB::Core::CpuTaskScheduler")]
extern class CpuTaskScheduler{
    CpuAffinity currentWorkerAffinity(...)const;
    usize currentWorkerIndex(...)const;
    u64 domainIdentity(...)const;
    void drain(...);
    b8 isParallelEnabled(...)const;
    Expected<void, CpuTaskAdmissionError> parallelFor(...);
    void pumpMainThread(...);
    CpuTaskProfileLabel registerProfileLabel(...);
    void setProfiling(...);
    CpuTaskSchedulerStatistics statistics(...)const;
    void wait(...);
    u32 workerThreadCount(...)const;
};

[cpp_header("<core/task/cpu/scheduler.h>"), cpp_name("::NWB::Core::CpuTaskScope")]
extern class CpuTaskScope{
    void cancel(...);
    void drain(...);
    Expected<void, CpuTaskAdmissionError> parallelFor(...);
    mut CpuTaskScheduler scheduler(...)const;
    void wait(...);
};


