        auto rootResult = PrepareAssetsGraphicsCaseRoot(testArena, "shader_invalid_define_name_and_value");
        ASSERT_TRUE(rootResult);
        Path root = Move(*rootResult);
        const Path metadataPath = root / "shader.nwb";
        ASSERT_TRUE(WriteTextFile(root / "shader.slang", "void main(){}\n"));
        ASSERT_TRUE(WriteTextFile(metadataPath, "compute_shader asset;\nasset.entry_point = \"main\";\nasset.defines = { \"9BAD\": 1 };\n"));
        Impl::ShaderCook shaderCook(testArena.arena);
        EXPECT_FALSE(ParseShaderMetadataFile<Impl::ShaderCook::ShaderEntry>(metadataPath, testArena, scratchArena, shaderCook));
        EXPECT_TRUE(logger.sawErrorContaining(NWB_TEXT("must be an ASCII shader identifier")));
        EXPECT_FALSE(logger.sawErrorContaining(NWB_TEXT("values must be a list of strings")));
        EXPECT_TRUE(RemoveAllIfExists(root));
    }
}

void VerifyAssetsGraphics_ShaderMetadataRejectsDefinesThatCannotRoundTripVariantSignatures(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_ShaderScratchArena);
    native(mut testArena, mut scratchArena){
        auto rootResult = PrepareAssetsGraphicsCaseRoot(testArena, "shader_invalid_define_tokens");
        ASSERT_TRUE(rootResult);
        Path root = Move(*rootResult);

        ASSERT_TRUE(WriteTextFile(root / "shader.slang", "void main(){}\n"));
        ASSERT_TRUE(WriteTextFile(root / "include.slangi", "static const uint sourceValue = 1u;\n"));
        static constexpr Array<AStringView, 6u> s_InvalidDefines = { "\"\": [\"1\"]", "\"9QUALITY\": [\"1\"]", "\"PROJECT-QUALITY\": [\"1\"]", "\"PROJECT_QUALITY\": [\"1;OTHER=0\"]", "\"PROJECT_QUALITY\": [\" 1\"]", "\"PROJECT_QUALITY\": [\"1 \"]", };
        Impl::ShaderCook shaderCook(testArena.arena);
        Impl::ShaderCook::ShaderEntry shaderEntry(testArena.arena);
        Impl::ShaderCook::IncludeEntry includeEntry(testArena.arena);
        for(const b8 include : { false, true }){
            SCOPED_TRACE(include ? "include" : "shader");
            const Path metadataPath = root / (include ? "include.nwb" : "shader.nwb");
            const AStringView declaration = include ? "include asset;\n" : "compute_shader asset;\nasset.entry_point = \"main\";\n";
            const auto validMetadata = StringFormat(testArena.arena, "{}asset.defines = {{ \"PROJECT_QUALITY\": [\"1\"] }};\n", declaration);
            const auto parse = [&](){
                if(include){
                    auto metadataResult1 = ParseShaderMetadataFile<NWB::Impl::ShaderCook::IncludeEntry>(metadataPath, testArena, scratchArena, shaderCook);
                    if(metadataResult1)
                        includeEntry = Move(*metadataResult1);
                    return metadataResult1.has_value();
                }
                auto metadataResult0 = ParseShaderMetadataFile<NWB::Impl::ShaderCook::ShaderEntry>(metadataPath, testArena, scratchArena, shaderCook);
                if(metadataResult0)
                    shaderEntry = Move(*metadataResult0);
                return metadataResult0.has_value();
            };
            for(const AStringView invalidDefines : s_InvalidDefines){
                SCOPED_TRACE(invalidDefines);
                ASSERT_TRUE(WriteTextFile(metadataPath, validMetadata));
                ASSERT_TRUE(parse());
                ASSERT_FALSE(include ? includeEntry.defineValues.empty() : shaderEntry.defineValues.empty());
                const auto invalidMetadata = StringFormat(testArena.arena, "{}asset.defines = {{ {} }};\n", declaration, invalidDefines);
                ASSERT_TRUE(WriteTextFile(metadataPath, invalidMetadata));
                EXPECT_FALSE(parse());
                EXPECT_FALSE(include ? includeEntry.defineValues.empty() : shaderEntry.defineValues.empty());
                ASSERT_TRUE(WriteTextFile(metadataPath, validMetadata));
                ASSERT_TRUE(parse());
                const auto& defineValues = include ? includeEntry.defineValues : shaderEntry.defineValues;
                EXPECT_TRUE(Impl::ShaderCook::ValidateVariantSignature("project/define_probe", "PROJECT_QUALITY=1", defineValues, scratchArena));
            }
        }
        EXPECT_TRUE(RemoveAllIfExists(root));
    }
}

void VerifySkeletonPayload_RejectsLaterSelfAndMissingParentsAndRecoversWithValidParents(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistration(logger, s_BreakOnFatal);
    native(in logger){
        using namespace NWB::Impl;
        for(u32 invalidCase = 0u; invalidCase < 4u; ++invalidCase){
            SkeletonInputs inputs;
            switch(invalidCase){
            case 0u: inputs.entry.joints[0u].parent = Name(s_SkeletonJointLeft); break;
            case 1u: inputs.entry.joints[1u].parent = Name(s_SkeletonJointLeft); break;
            case 2u: inputs.entry.joints[3u].parent = Name(s_AssetCaseMissing); break;
            case 3u: inputs.entry.joints[1u].parent = Name(s_SkeletonJointRight); break;
            }
            EXPECT_FALSE(BuildSkeletonAsset(inputs.entry, inputs.arena, inputs.scratchArena)) << invalidCase;
            inputs.entry.joints[0u].parent = s_NameNone;
            inputs.entry.joints[1u].parent = Name(s_SkeletonJointRoot);
            inputs.entry.joints[3u].parent = Name(s_SkeletonJointLeft);
            EXPECT_TRUE(BuildSkeletonAsset(inputs.entry, inputs.arena, inputs.scratchArena));
        }
        EXPECT_EQ(logger.errorCount(), 4u);
        EXPECT_TRUE(logger.sawErrorContaining(NWB_TEXT("references missing or later parent")));
    }
}

void VerifySkeletonPayload_RejectsDuplicateCanonicalIdsAfterResolvingEarlierParent(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistration(logger, s_BreakOnFatal);
    native(in logger){
        using namespace NWB::Impl;
        for(const Name& duplicate : { Name(s_SkeletonJointLeft), Name("ROOT") }){
            SkeletonInputs inputs;
            inputs.entry.joints[3u].name = duplicate;
            inputs.entry.joints[3u].parent = duplicate;
            EXPECT_FALSE(BuildSkeletonAsset(inputs.entry, inputs.arena, inputs.scratchArena));
        }
        EXPECT_EQ(logger.errorCount(), 2u);
        EXPECT_TRUE(logger.sawErrorContaining(NWB_TEXT("duplicate joint name")));
    }
}

void VerifySkeletonPayload_CodecRejectsEveryTruncatedTablePrefixWithoutReplacingPriorJoints(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistration(logger, s_BreakOnFatal);
    SkeletonInputs inputs = SkeletonInputs();
    native(in logger, mut inputs){
        using namespace NWB::Impl;
        auto buildResult = BuildSkeletonAsset(inputs.entry, inputs.arena, inputs.scratchArena);
        ASSERT_TRUE(buildResult);
        inputs.skeleton = Move(*buildResult);
        SkeletonAssetCodec codec;
        Core::Assets::AssetBytes binary(inputs.arena);
        ASSERT_TRUE(codec.serialize(inputs.skeleton, binary));
        ASSERT_TRUE(inputs.skeleton.loadBinary(binary));
        for(usize prefix = 0u; prefix < binary.size(); ++prefix){
            Core::Assets::AssetBytes malformed(binary);
            malformed.resize(prefix);
            EXPECT_FALSE(inputs.skeleton.loadBinary(malformed)) << prefix;
            Core::Assets::AssetBytes retained(inputs.arena);
            ASSERT_TRUE(codec.serialize(inputs.skeleton, retained));
            EXPECT_EQ(retained, binary) << prefix;
        }
        EXPECT_EQ(logger.errorCount(), binary.size());
    }
}

void VerifySkeletonPayload_RepeatedValidationReclaimsCallerScratchAfterSuccessAndInvalidLookup(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistration(logger, s_BreakOnFatal);
    SkeletonInputs inputs = SkeletonInputs();
    native(in logger, mut inputs){
        using namespace NWB::Impl;
        auto buildResult = BuildSkeletonAsset(inputs.entry, inputs.arena, inputs.scratchArena);
        ASSERT_TRUE(buildResult);
        inputs.skeleton = Move(*buildResult);
        ASSERT_TRUE(inputs.skeleton.validatePayload(inputs.scratchArena));
        const ArenaMemoryStats warm = inputs.scratchArena.memoryStats();
        for(usize iteration = 0u; iteration < 16u; ++iteration){
            Skeleton::JointIndexMap jointIndices(inputs.skeleton.jointIndices());
            const b8 valid = iteration % 2u == 0u;
            jointIndices.at(Name(s_SkeletonJointLeft)) = valid ? 1u : 0u;
            inputs.skeleton.setJoints(Skeleton::JointVector(inputs.skeleton.joints()), Move(jointIndices));
            EXPECT_EQ(inputs.skeleton.validatePayload(inputs.scratchArena), valid);
            const ArenaMemoryStats current = inputs.scratchArena.memoryStats();
            EXPECT_EQ(current.usedBytes, warm.usedBytes);
            EXPECT_EQ(current.reservedBytes, warm.reservedBytes);
        }
        EXPECT_EQ(logger.errorCount(), 8u);
    }
}

void VerifyAssetsGraphics_Rgba8FallbackMipSizeRejectsAddressOverflow(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_ReportOnly);
    native(in logger){
        const auto zeroBytes = Impl::TryComputeRgba8FallbackMipBytes(0u, Limit<u32>::s_Max);
        ASSERT_TRUE(zeroBytes);
        EXPECT_EQ(*zeroBytes, 0u);
        EXPECT_FALSE(Impl::TryComputeRgba8FallbackMipBytes(Limit<u32>::s_Max, Limit<u32>::s_Max));
        EXPECT_TRUE(logger.sawErrorContaining(NWB_TEXT("RGBA8 fallback mip size exceeds addressable memory")));
    }
}

void VerifyAssetsGraphics_TextureMipAdmissionRejectsEveryTruncatedPayloadPrefixAndOversizedCount(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    native(mut testArena){
        const auto validBinary = BuildPartialBlockTextureBinary(testArena);
        Impl::Texture texture(testArena.arena, Name(s_AssetCaseProjectTexturesMipTableAdmission));
        ASSERT_TRUE(texture.loadBinary(validBinary));
        Impl::TextureAssetCodec codec;

        for(usize availableBytes = 0u; availableBytes < validBinary.size(); ++availableBytes){
            Core::Assets::AssetBytes truncated(validBinary.begin(), validBinary.begin() + availableBytes, testArena.arena);
            EXPECT_FALSE(texture.loadBinary(truncated)) << availableBytes;
            Core::Assets::AssetBytes retained(testArena.arena);
            ASSERT_TRUE(codec.serialize(texture, retained));
            EXPECT_EQ(retained, validBinary) << availableBytes;
        }
        Core::Assets::AssetBytes oversized(validBinary.begin(), validBinary.begin() + sizeof(::TextureBinaryPayload::HeaderBinary), testArena.arena);
        const u32 oversizedCount = Limit<u32>::s_Max;
        NWB_MEMCPY(oversized.data() + offsetof(::TextureBinaryPayload::HeaderBinary, mipCount), sizeof(oversizedCount), &oversizedCount, sizeof(oversizedCount));
        EXPECT_FALSE(texture.loadBinary(oversized));
        Core::Assets::AssetBytes retained(testArena.arena);
        ASSERT_TRUE(codec.serialize(texture, retained));
        EXPECT_EQ(retained, validBinary);
        EXPECT_TRUE(texture.loadBinary(validBinary));
    }
}

void VerifyAssetsGraphics_TextureCodecRejectsPayloadFormatNarrowingWithoutReplacingPublishedPayload(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    native(mut testArena){
        const auto original = BuildPartialBlockTextureBinary(testArena);
        Impl::Texture texture(testArena.arena, Name(s_AssetCaseProjectTexturesPayloadFormatAdmission));
        ASSERT_TRUE(texture.loadBinary(original));
        Impl::TextureAssetCodec codec;
        for(const u32 payloadFormat : { 2u, 255u, 256u, 257u, 0xffffff00u, 0xffffff01u, Limit<u32>::s_Max }){
            SCOPED_TRACE(payloadFormat);
            Core::Assets::AssetBytes malformed(original);
            NWB_MEMCPY(malformed.data() + offsetof(::TextureBinaryPayload::HeaderBinary, payloadFormat), sizeof(payloadFormat), &payloadFormat, sizeof(payloadFormat));
            EXPECT_FALSE(codec.deserialize(texture.virtualPath(), malformed, testArena.arena));
            EXPECT_FALSE(texture.loadBinary(malformed));
            Core::Assets::AssetBytes retained(testArena.arena);
            ASSERT_TRUE(codec.serialize(texture, retained));
            EXPECT_EQ(retained, original);
        }
        EXPECT_TRUE(texture.loadBinary(original));
    }
}

void VerifyAssetsGraphics_TextureCodecRejectsOpaqueValueInConstantAlphaModeWithoutReplacingPublishedPayload(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    native(in logger, mut testArena){
        Core::Assets::AssetBytes original = BuildPartialBlockTextureBinary(testArena);
        const u32 hdrFormat = TexturePayloadFormat::UastcHdr4x4;
        const u32 alphaInfo = static_cast<u32>(TextureAlphaMode::ConstantUnorm8) | (TextureFormat::s_MaxConstantAlphaUnorm8 << ::TextureBinaryPayload::s_AlphaInfoConstantShift);
        NWB_MEMCPY(original.data() + offsetof(::TextureBinaryPayload::HeaderBinary, payloadFormat), sizeof(hdrFormat), &hdrFormat, sizeof(hdrFormat));
        NWB_MEMCPY(original.data() + offsetof(::TextureBinaryPayload::HeaderBinary, alphaInfo), sizeof(alphaInfo), &alphaInfo, sizeof(alphaInfo));
        Impl::Texture texture(testArena.arena, Name(s_AssetCaseProjectTexturesConstantAlphaAdmission));
        ASSERT_TRUE(texture.loadBinary(original));
        Impl::TextureAssetCodec codec;
        Core::Assets::AssetBytes malformed(original);
        const u32 opaqueConstantInfo = static_cast<u32>(TextureAlphaMode::ConstantUnorm8) | (TextureFormat::s_OpaqueAlphaUnorm8 << ::TextureBinaryPayload::s_AlphaInfoConstantShift);
        NWB_MEMCPY(malformed.data() + offsetof(::TextureBinaryPayload::HeaderBinary, alphaInfo), sizeof(opaqueConstantInfo), &opaqueConstantInfo, sizeof(opaqueConstantInfo));
        EXPECT_FALSE(codec.deserialize(texture.virtualPath(), malformed, testArena.arena));
        EXPECT_FALSE(texture.loadBinary(malformed));
        EXPECT_TRUE(logger.sawErrorContaining(NWB_TEXT("constant alpha must be below opaque alpha")));
        Core::Assets::AssetBytes retained(testArena.arena);
        ASSERT_TRUE(codec.serialize(texture, retained));
        EXPECT_EQ(retained, original);
        EXPECT_TRUE(texture.loadBinary(original));
    }
}

void VerifyAssetsGraphics_TextureMipAdmissionRejectsCorruptRecordsAndRetainsExactEncodingAfterRejectedLoads(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    native(mut testArena){
        const auto validBinary = BuildPartialBlockTextureBinary(testArena);
        Impl::Texture texture(testArena.arena, Name(s_AssetCaseProjectTexturesMipRecordAdmission));
        ASSERT_TRUE(texture.loadBinary(validBinary));
        Impl::TextureAssetCodec codec;
        using Corruption = TextureMipCorruptionCase;
        const Array<Corruption, 6u> corruptions = {{
            { .fieldOffset = offsetof(::TextureBinaryPayload::MipLevelBinary, reserved), .value = 1u },
            { .fieldOffset = offsetof(::TextureBinaryPayload::MipLevelBinary, width), .value = 8u },
            { .fieldOffset = offsetof(::TextureBinaryPayload::MipLevelBinary, blockCountX), .value = 3u },
            { .fieldOffset = offsetof(::TextureBinaryPayload::MipLevelBinary, sliceCount), .value = 2u },
            { .fieldOffset = offsetof(::TextureBinaryPayload::MipLevelBinary, offsetBytes), .value = 1u },
            { .fieldOffset = offsetof(::TextureBinaryPayload::MipLevelBinary, sizeBytes), .value = 48u },
        }};
        for(const Corruption& corruption : corruptions){
            Core::Assets::AssetBytes malformed(validBinary.begin(), validBinary.end(), testArena.arena);
            NWB_MEMCPY(malformed.data() + sizeof(::TextureBinaryPayload::HeaderBinary) + corruption.fieldOffset, sizeof(corruption.value), &corruption.value, sizeof(corruption.value));
            EXPECT_FALSE(texture.loadBinary(malformed)) << corruption.fieldOffset;
            Core::Assets::AssetBytes retained(testArena.arena);
            ASSERT_TRUE(codec.serialize(texture, retained));
            EXPECT_EQ(retained, validBinary) << corruption.fieldOffset;
        }
        Core::Assets::AssetBytes trailing(validBinary.begin(), validBinary.end(), testArena.arena);
        trailing.push_back(0u);
        EXPECT_FALSE(texture.loadBinary(trailing));
        Core::Assets::AssetBytes encoded(testArena.arena);
        ASSERT_TRUE(codec.serialize(texture, encoded));
        ASSERT_EQ(encoded.size(), validBinary.size());
        EXPECT_EQ(NWB_MEMCMP(encoded.data(), validBinary.data(), validBinary.size()), 0);
    }
}

void VerifyAssetsGraphics_TextureFormatRoundsPartialBlocksAndNonPowerOfTwoMips(){
    const Expected<u32> mipCount = ComputeCompleteMipCount(s_TextureDimension2D, 7u, 5u, 1u);
    ASSERT_TRUE(mipCount.has_value());
    EXPECT_EQ(mipCount.value(), 3u);

    const Expected<TextureMipPlaneBlockLayout> ldrPlane = ComputeMipPlaneBlockLayout(s_UastcLdrFormat, 7u, 5u);
    ASSERT_TRUE(ldrPlane.has_value());
    EXPECT_EQ(ldrPlane.value().blocksX, 2u);
    EXPECT_EQ(ldrPlane.value().blocksY, 2u);
    EXPECT_EQ(ldrPlane.value().planeByteCount, 64u);

    const Expected<TextureMipPlaneBlockLayout> hdrPlane = ComputeMipPlaneBlockLayout(s_UastcHdrFormat, 4u, 2u);
    ASSERT_TRUE(hdrPlane.has_value());
    EXPECT_EQ(hdrPlane.value().blocksX, 1u);
    EXPECT_EQ(hdrPlane.value().blocksY, 1u);
    EXPECT_EQ(hdrPlane.value().planeByteCount, 16u);
}

void VerifyAssetsGraphics_TextureCodecRejectsUnsupportedBinaryVersions(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    native(in logger, mut testArena){
        NWB::Impl::Texture texture(testArena.arena, Name(s_AssetCaseProjectTexturesVersionAdmission));
        texture.setPayload(7u, 5u, MakeTextureTestMipLevels(testArena), MakeTextureTestUastcPayload(testArena), TextureDimension::Texture2D, 1u, TexturePayloadFormat::UastcLdr4x4, TextureAlphaMode::EmbeddedLdr, TextureFormat::s_OpaqueAlphaUnorm8);
        NWB::Impl::TextureAssetCodec codec;
        NWB::Core::Assets::AssetBytes binary = MakeAssetBytes(testArena);
        ASSERT_TRUE(codec.serialize(texture, binary));
        for(const u32 version : { 0u, 1u, 2u, 3u, ::TextureBinaryPayload::s_TextureVersion + 1u }){
            NWB_MEMCPY(binary.data() + offsetof(::TextureBinaryPayload::HeaderBinary, version), sizeof(version), &version, sizeof(version));
            EXPECT_FALSE(codec.deserialize(texture.virtualPath(), binary, testArena.arena)) << version;
        }
        EXPECT_EQ(logger.errorCount(), 5u);
        EXPECT_TRUE(logger.sawErrorContaining(NWB_TEXT("unsupported texture payload version")));

        const u32 currentVersion = ::TextureBinaryPayload::s_TextureVersion;
        NWB_MEMCPY(binary.data() + offsetof(::TextureBinaryPayload::HeaderBinary, version), sizeof(currentVersion), &currentVersion, sizeof(currentVersion));
        const auto loadedAssetResult = codec.deserialize(texture.virtualPath(), binary, testArena.arena);
        ASSERT_TRUE(loadedAssetResult);
    }
}

void VerifyAssetsGraphics_TexturePayloadRejectsAlphaTransportIncompatibleWithFormat(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerRegistrationGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    native(in logger, mut testArena){
        NWB::Impl::Texture texture(testArena.arena, Name(s_AssetCaseProjectTexturesInvalidAlphaMode));
        texture.setPayload(7u, 5u, MakeTextureTestMipLevels(testArena), MakeTextureTestUastcPayload(testArena), TextureDimension::Texture2D, 1u, TexturePayloadFormat::UastcLdr4x4, TextureAlphaMode::ConstantUnorm8, 77u);
        EXPECT_FALSE(texture.validatePayload());
        EXPECT_TRUE(logger.sawErrorContaining(NWB_TEXT("invalid alpha transport for its payload format")));
    }
}

void VerifyAssetsGraphics_TextureCookerPreservesImplicitRawSidecarWithoutEncodingItAgain(){
    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_CodecScratchArena);
    native(mut testArena, mut scratchArena){
        const auto original = MakeTextureTestUastcPayload(testArena);
        const auto rootResult = PrepareAssetsGraphicsCaseRoot(testArena, "texture_raw_pair_identity");
        ASSERT_TRUE(rootResult);
        const Path root = *rootResult;
        const Path assetRoot = root / s_AssetsDirectory;
        const Path metadataPath = assetRoot / s_TexturesDirectory / s_CheckerMetadataFilename;
        ASSERT_TRUE(WriteTextFile(metadataPath, s_TextureTestMetadata));
        ASSERT_TRUE(WriteBinaryFile(assetRoot / s_TexturesDirectory / "checker.tex", original));
        Core::Metascript::Document document(testArena.arena);
        ASSERT_TRUE(document.parse(s_TextureTestMetadata));
        const auto entry = Impl::ParseTextureCookMetadata(assetRoot, "project", metadataPath, document, testArena.arena, scratchArena);
        ASSERT_TRUE(entry);
        EXPECT_EQ(entry->payloadBytes, original);
        const auto texture = Impl::BuildTextureAsset(*entry, testArena.arena);
        ASSERT_TRUE(texture);
        EXPECT_EQ(texture->virtualPath(), Name("project/textures/checker"));
        EXPECT_EQ(texture->payloadBytes(), original);
        EXPECT_EQ(entry->payloadBytes, original);
        Impl::TextureAssetCodec codec;
        Core::Assets::AssetBytes packaged(testArena.arena);
        ASSERT_TRUE(codec.serialize(*texture, packaged));
        const usize rawOffset = sizeof(::TextureBinaryPayload::HeaderBinary) + texture->mipLevels().size() * sizeof(::TextureBinaryPayload::MipLevelBinary);
        ASSERT_EQ(packaged.size(), rawOffset + original.size());
        EXPECT_EQ(NWB_MEMCMP(packaged.data() + rawOffset, original.data(), original.size()), 0);
        EXPECT_TRUE(RemoveAllIfExists(root));
    }
}

void VerifyAssetsGraphics_TextureCookerRejectsEveryTruncatedRawPayloadAndExtraBytes(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    native(in logger, mut testArena){
        const auto original = MakeTextureTestUastcPayload(testArena);
        Impl::TextureCookEntry entry(testArena.arena);
        entry.virtualPath = Name(s_AssetCaseProjectTexturesTruncatedRaw);
        entry.width = 7u;
        entry.height = 5u;
        entry.alphaMode = TextureAlphaMode::EmbeddedLdr;
        for(usize prefix = 0u; prefix < original.size(); ++prefix){
            entry.payloadBytes.assign(original.begin(), original.begin() + prefix);
            EXPECT_FALSE(Impl::BuildTextureAsset(entry, testArena.arena)) << prefix;
        }
        entry.payloadBytes = original;
        entry.payloadBytes.push_back(0u);
        EXPECT_FALSE(Impl::BuildTextureAsset(entry, testArena.arena));
        entry.payloadBytes = original;
        entry.payloadBytes.insert(entry.payloadBytes.end(), original.begin(), original.end());
        EXPECT_FALSE(Impl::BuildTextureAsset(entry, testArena.arena));
        const auto framedRuntimeBinary = MakeTextureTestRuntimeBinary(testArena);
        ASSERT_TRUE(framedRuntimeBinary);
        entry.payloadBytes = *framedRuntimeBinary;
        EXPECT_FALSE(Impl::BuildTextureAsset(entry, testArena.arena));
        EXPECT_TRUE(logger.sawErrorContaining(NWB_TEXT("raw texture byte count does not match the declared mip and alpha layout")));
        entry.payloadBytes = original;
        EXPECT_TRUE(Impl::BuildTextureAsset(entry, testArena.arena));
    }
}

void VerifyAssetsGraphics_TextureCookerRejectsOverflowingRawLayoutWithoutRetainingAllocations(){
    TestArena testArena = TestArena();
    native(mut testArena){
        struct OverflowLayout{
            TextureDimension::Enum dimension;
            u32 width;
            u32 height;
            u32 depth;
            TStringView diagnostic;
        };
        const Array<OverflowLayout, 4u> layouts = {{
            { TextureDimension::Texture2D, Limit<u32>::s_Max, Limit<u32>::s_Max, 1u, NWB_TEXT("block layout exceeds supported limits") },
            { TextureDimension::TextureCube, 2147483648u, 2147483648u, 1u, NWB_TEXT("block layout exceeds supported limits") },
            { TextureDimension::Texture3D, 65536u, 65536u, Limit<u32>::s_Max, NWB_TEXT("mip byte offsets overflow") },
            { TextureDimension::Texture3D, 131072u, 131072u, Limit<u32>::s_Max, NWB_TEXT("block layout exceeds supported limits") },
        }};
        for(const OverflowLayout& layout : layouts){
            CapturingLogger logger;
            Core::Common::LoggerRegistrationGuard loggerGuard(logger, Core::Common::LoggerBreakPolicy::BreakOnFatal);
            Impl::TextureCookEntry entry(testArena.arena);
            entry.virtualPath = Name(s_AssetCaseProjectTexturesOverflowingRawLayout);
            entry.dimension = layout.dimension;
            entry.width = layout.width;
            entry.height = layout.height;
            entry.depth = layout.depth;
            const usize allocatedBytes = testArena.arena.memoryStats().usedBytes;
            EXPECT_FALSE(Impl::BuildTextureAsset(entry, testArena.arena)) << layout.dimension << ": " << layout.width << ", " << layout.height << ", " << layout.depth;
            EXPECT_EQ(testArena.arena.memoryStats().usedBytes, allocatedBytes);
            EXPECT_TRUE(logger.sawErrorContaining(layout.diagnostic)) << layout.dimension << ": " << layout.width << ", " << layout.height << ", " << layout.depth;
            EXPECT_FALSE(logger.sawErrorContaining(NWB_TEXT("raw texture byte count does not match"))) << layout.dimension << ": " << layout.width << ", " << layout.height << ", " << layout.depth;
        }
    }
}

void VerifyAssetsGraphics_TextureCookerRejectsMissingImplicitSidecarInsteadOfSelectingAnotherFile(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_CodecScratchArena);
    native(in logger, mut testArena, mut scratchArena){
        const auto rootResult = PrepareAssetsGraphicsCaseRoot(testArena, "texture_missing_raw_pair");
        ASSERT_TRUE(rootResult);
        const Path root = *rootResult;
        const Path assetRoot = root / s_AssetsDirectory;
        const Path metadataPath = assetRoot / s_TexturesDirectory / s_CheckerMetadataFilename;
        ASSERT_TRUE(WriteTextFile(metadataPath, s_TextureTestMetadata));
        ASSERT_TRUE(WriteBinaryFile(assetRoot / s_TexturesDirectory / "another.tex", MakeTextureTestUastcPayload(testArena)));
        Core::Metascript::Document document(testArena.arena);
        ASSERT_TRUE(document.parse(s_TextureTestMetadata));
        EXPECT_FALSE(Impl::ParseTextureCookMetadata(assetRoot, "project", metadataPath, document, testArena.arena, scratchArena));
        EXPECT_TRUE(logger.sawErrorContaining(NWB_TEXT("failed to read raw texture sidecar")));
        EXPECT_TRUE(logger.sawErrorContaining(NWB_TEXT("checker.tex")));
        EXPECT_TRUE(RemoveAllIfExists(root));
    }
}

void VerifyAssetsGraphics_TextureMipDecoderRejectsSrgbAndUnsupportedLdrUploadFormatsBeforeDecoding(){
    CapturingLogger logger = CapturingLogger();
    LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
    TestArena testArena = TestArena();
    ScratchArena scratchArena(s_CodecScratchArena);
    native(in logger, mut testArena, mut scratchArena){
        const auto prepared = MakeTextureTestRuntimeBinary(testArena);
        ASSERT_TRUE(prepared);
        Impl::Texture texture(testArena.arena, Name(s_AssetCaseProjectTexturesLinearDecode));
        ASSERT_TRUE(texture.loadBinary(*prepared));
        Impl::TextureMipDecoder decoder;
        for(const auto format : { Core::Format::ASTC_4x4_UNORM_SRGB, Core::Format::BC7_UNORM_SRGB, Core::Format::RGBA8_UNORM_SRGB, Core::Format::UNKNOWN, Core::Format::R8_UNORM, Core::Format::RGBA16_FLOAT })
            EXPECT_FALSE(decoder.decode(texture, texture.mipLevels().front(), 0u, format, scratchArena)) << format;
        EXPECT_EQ(logger.errorCount(), 6u);
    }
}

void VerifyAssetsGraphics_TextureCookerRejectsObsoleteAndDerivedMetadata(){
    Vector<TextureMetadataDiagnosticCase> obsoleteFields = Vector<TextureMetadataDiagnosticCase>();
    obsoleteFields.reserve(24u);
    obsoleteFields.push_back(TextureMetadataDiagnosticCase("asset.version = 1;\n", "unsupported asset field 'version'"));
    obsoleteFields.push_back(TextureMetadataDiagnosticCase("asset.mip_count = 3;\n", "unsupported asset field 'mip_count'"));
    obsoleteFields.push_back(TextureMetadataDiagnosticCase("asset.data = \"checker.tex\";\n", "unsupported asset field 'data'"));
    obsoleteFields.push_back(TextureMetadataDiagnosticCase("asset.file = \"checker.tex\";\n", "unsupported asset field 'file'"));
    obsoleteFields.push_back(TextureMetadataDiagnosticCase("asset.mip_filter = \"linear\";\n", "unsupported asset field 'mip_filter'"));
    obsoleteFields.push_back(TextureMetadataDiagnosticCase("asset.uastc_spec_revision = \"old\";\n", "unsupported asset field 'uastc_spec_revision'"));
    obsoleteFields.push_back(TextureMetadataDiagnosticCase("asset.uastc_hdr_spec_revision = \"old\";\n", "unsupported asset field 'uastc_hdr_spec_revision'"));
    obsoleteFields.push_back(TextureMetadataDiagnosticCase("asset.alpha_uastc_spec_revision = \"old\";\n", "unsupported asset field 'alpha_uastc_spec_revision'"));
    obsoleteFields.push_back(TextureMetadataDiagnosticCase("asset.schema_version = 1;\n", "unsupported asset field 'schema_version'"));
    obsoleteFields.push_back(TextureMetadataDiagnosticCase("asset.revision = 1;\n", "unsupported asset field 'revision'"));
    obsoleteFields.push_back(TextureMetadataDiagnosticCase("asset.block_width = 4;\n", "unsupported asset field 'block_width'"));
    obsoleteFields.push_back(TextureMetadataDiagnosticCase("asset.block_height = 4;\n", "unsupported asset field 'block_height'"));
    obsoleteFields.push_back(TextureMetadataDiagnosticCase("asset.bytes_per_block = 16;\n", "unsupported asset field 'bytes_per_block'"));
    obsoleteFields.push_back(TextureMetadataDiagnosticCase("asset.payload_layout = \"mip_major_slice_major_blocks\";\n", "unsupported asset field 'payload_layout'"));
    obsoleteFields.push_back(TextureMetadataDiagnosticCase("asset.mip_address_mode = \"clamp\";\n", "unsupported asset field 'mip_address_mode'"));
    obsoleteFields.push_back(TextureMetadataDiagnosticCase("asset.mips = [];\n", "unsupported asset field 'mips'"));
    obsoleteFields.push_back(TextureMetadataDiagnosticCase("asset.has_alpha = 1;\n", "unsupported asset field 'has_alpha'"));
    obsoleteFields.push_back(TextureMetadataDiagnosticCase("asset.alpha_constant_unorm8 = 128;\n", "unsupported asset field 'alpha_constant_unorm8'"));
    obsoleteFields.push_back(TextureMetadataDiagnosticCase("asset.alpha_payload_offset_bytes = 48;\n", "unsupported asset field 'alpha_payload_offset_bytes'"));
    obsoleteFields.push_back(TextureMetadataDiagnosticCase("asset.alpha_payload_byte_count = 48;\n", "unsupported asset field 'alpha_payload_byte_count'"));
    obsoleteFields.push_back(TextureMetadataDiagnosticCase("asset.color_space = \"srgb\";\n", "unsupported asset field 'color_space'"));
    obsoleteFields.push_back(TextureMetadataDiagnosticCase("asset.width = 7;\n", "unsupported asset field 'width'"));
    obsoleteFields.push_back(TextureMetadataDiagnosticCase("asset.height = 5;\n", "unsupported asset field 'height'"));
    obsoleteFields.push_back(TextureMetadataDiagnosticCase("asset.depth = 1;\n", "unsupported asset field 'depth'"));

    for(in TextureMetadataDiagnosticCase field : obsoleteFields){
        const ScopedTestTrace trace(field.m_assignment);
        CapturingLogger logger = CapturingLogger();
        LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
        TestArena testArena = TestArena();
        ScratchArena scratchArena(s_CodecScratchArena);
        String metadata(s_TextureTestMetadata);
        metadata.append(field.m_assignment);
        EXPECT_FALSE(TryParseTextureMetadata(metadata, "texture_obsolete_metadata", testArena, scratchArena));
        EXPECT_TRUE(SawCapturedError(logger, field.m_diagnostic));
    }
}

void VerifyAssetsGraphics_TextureCookerRejectsMissingRequiredRawLayoutDescriptors(){
    Vector<TextureMetadataDiagnosticCase> requiredFields = Vector<TextureMetadataDiagnosticCase>();
    requiredFields.reserve(4u);
    requiredFields.push_back(TextureMetadataDiagnosticCase("asset.format = \"uastc_ldr_4x4\";\n", "field 'format' is required"));
    requiredFields.push_back(TextureMetadataDiagnosticCase("asset.dimension = \"2d\";\n", "field 'dimension' is required"));
    requiredFields.push_back(TextureMetadataDiagnosticCase("asset.resolution = [7, 5];\n", "resolution must contain exactly"));
    requiredFields.push_back(TextureMetadataDiagnosticCase("asset.alpha_mode = \"embedded_ldr\";\n", "field 'alpha_mode' is required"));

    const String baseMetadata(s_TextureTestMetadata);
    for(in TextureMetadataDiagnosticCase field : requiredFields){
        const ScopedTestTrace trace(field.m_assignment);
        CapturingLogger logger = CapturingLogger();
        LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
        TestArena testArena = TestArena();
        ScratchArena scratchArena(s_CodecScratchArena);
        const usize fieldOffset = baseMetadata.find(field.m_assignment);
        ASSERT_LT(fieldOffset, baseMetadata.size());
        String metadata(baseMetadata.substr(0u, fieldOffset));
        metadata.append(baseMetadata.substr(fieldOffset + field.m_assignment.size()));
        EXPECT_FALSE(TryParseTextureMetadata(metadata, "texture_missing_layout", testArena, scratchArena));
        EXPECT_TRUE(SawCapturedError(logger, field.m_diagnostic));
    }
}

void VerifyAssetsGraphics_TextureCookerRejectsInvalidRawLayoutDescriptorsBeforeReadingSidecar(){
    Vector<TextureMetadataDiagnosticCase> invalidLayouts = Vector<TextureMetadataDiagnosticCase>();
    invalidLayouts.reserve(19u);
    invalidLayouts.push_back(TextureMetadataDiagnosticCase("asset.format = 17;", "field 'format' must be a string"));
    invalidLayouts.push_back(TextureMetadataDiagnosticCase("asset.format = \"rgba8\";", "unsupported texture format"));
    invalidLayouts.push_back(TextureMetadataDiagnosticCase("asset.dimension = \"3d\";", "unsupported texture dimension"));
    invalidLayouts.push_back(TextureMetadataDiagnosticCase("asset.dimension = \"cube\";", "cube resolution must be square"));
    invalidLayouts.push_back(TextureMetadataDiagnosticCase("asset.dimension = \"volume\";", "resolution must contain exactly"));
    invalidLayouts.push_back(TextureMetadataDiagnosticCase("asset.resolution = [7];", "resolution must contain exactly"));
    invalidLayouts.push_back(TextureMetadataDiagnosticCase("asset.resolution = [7, 5, 1];", "resolution must contain exactly"));
    invalidLayouts.push_back(TextureMetadataDiagnosticCase("asset.resolution = [0, 5];", "positive u32 integer"));
    invalidLayouts.push_back(TextureMetadataDiagnosticCase("asset.resolution = [-1, 5];", "positive u32 integer"));
    invalidLayouts.push_back(TextureMetadataDiagnosticCase("asset.resolution = [7.5, 5];", "positive u32 integer"));
    invalidLayouts.push_back(TextureMetadataDiagnosticCase("asset.resolution = [4294967296, 5];", "positive u32 integer"));
    invalidLayouts.push_back(TextureMetadataDiagnosticCase("asset.mip_count = 0;", "unsupported asset field 'mip_count'"));
    invalidLayouts.push_back(TextureMetadataDiagnosticCase("asset.mip_count = 2;", "unsupported asset field 'mip_count'"));
    invalidLayouts.push_back(TextureMetadataDiagnosticCase("asset.mip_count = 4;", "unsupported asset field 'mip_count'"));
    invalidLayouts.push_back(TextureMetadataDiagnosticCase("asset.alpha_mode = \"straight\";", "unsupported alpha_mode"));
    invalidLayouts.push_back(TextureMetadataDiagnosticCase("asset.alpha_mode = \"constant_unorm8\";", "field 'alpha_constant_unorm8' is required"));
    invalidLayouts.push_back(TextureMetadataDiagnosticCase("asset.alpha_mode = \"constant_unorm8\"; asset.alpha_constant_unorm8 = 255;", "field 'alpha_constant_unorm8' must be an integer in [0, 254]"));
    invalidLayouts.push_back(TextureMetadataDiagnosticCase("asset.alpha_mode = \"constant_unorm8\"; asset.alpha_constant_unorm8 = -1;", "field 'alpha_constant_unorm8' must be an integer in [0, 254]"));
    invalidLayouts.push_back(TextureMetadataDiagnosticCase("asset.alpha_mode = \"constant_unorm8\"; asset.alpha_constant_unorm8 = 0.5;", "field 'alpha_constant_unorm8' must be an integer in [0, 254]"));

    for(in TextureMetadataDiagnosticCase invalid : invalidLayouts){
        const ScopedTestTrace trace(invalid.m_assignment);
        CapturingLogger logger = CapturingLogger();
        LoggerRegistrationGuard loggerGuard(logger, s_BreakOnFatal);
        TestArena testArena = TestArena();
        ScratchArena scratchArena(s_CodecScratchArena);
        String metadata(s_TextureTestMetadata);
        metadata.append(invalid.m_assignment);
        EXPECT_FALSE(TryParseTextureMetadata(metadata, "texture_invalid_layout", testArena, scratchArena));
        EXPECT_TRUE(SawCapturedError(logger, invalid.m_diagnostic));
        EXPECT_FALSE(SawCapturedError(logger, "failed to read raw texture sidecar"));
    }
}


