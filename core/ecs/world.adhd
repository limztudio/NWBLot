[cpp_header("<core/ecs/world.h>"), cpp_name("::NWB::Core::ECS::World")]
extern class World{
    T addComponent<T>(...);
    T addSystem<T>(...);
    b8 alive(...)const;
    Optional<mut T> borrowComponent<T>(...);
    Optional<in T> borrowComponent<T>(...)const;
    Optional<mut T> borrowSystem<T>();
    void clear(...);
    void clearMessages(...);
    u64 componentMutationVersion(...)const;
    void consumeMessages(...)const;
    Entity createEntity(...);
    void destroyEntity(...);
    void emplaceMessage(...);
    Entity entity(...);
    usize entityCount(...)const;
    T getComponent<T>(...)const;
    b8 hasComponent(...)const;
    T makeSystemResource<T>()const;
    usize messageCount(...)const;
    void postMessage(...);
    void removeComponent(...);
    void swapMessageBuffers(...);
    mut CpuTaskScheduler taskScheduler(...);
    mut CpuTaskScope taskScope(...);
    Expected<void, CpuTaskAdmissionError> tick(...);
};


