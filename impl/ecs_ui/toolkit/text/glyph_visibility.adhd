////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


#include <impl/ecs_ui/toolkit/text/atlas.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Optional<in BakedFontAtlas> BorrowSelectedAtlas(in borrow PlacedGlyph glyph, in f32 physicalSize){
    if(!glyph.face.valid() || !glyph.face.deref().valid())
        return Optional<in BakedFontAtlas>();
    if(!glyph.face.deref().bakedAtlas().valid() || !glyph.face.deref().bakedAtlas().deref().valid() || !CanUseBakedFontAtlasAtPhysicalSize(glyph.face.deref().bakedAtlas().deref().bakePpem(), physicalSize) || !glyph.face.deref().bakedAtlas().deref().hasGlyph(glyph.glyphId))
        return Optional<in BakedFontAtlas>();
    return Optional<in BakedFontAtlas>(glyph.face.deref().bakedAtlas().deref());
}

b8 LoadAtlasRectangle(in PlacedGlyph glyph, in BakedFontAtlas atlas, in f32 fontSize, in Point topLeft, mut VectorDouble outRectangle){
    if(!atlas.valid() || !atlas.hasGlyph(glyph.glyphId))
        return false;
    return TryLoadGlyphAtlasRectangle(glyph.position, topLeft, fontSize, atlas.unitsPerEm(), atlas.glyph(glyph.glyphId), outRectangle);
}

TextGlyphIntersection CandidateBorrowed(in PlacedGlyph glyph, in Optional<in BakedFontAtlas> selectedAtlas, in f32 fontSize, in f32 physicalSize, in Point topLeft, in Rect clip, in Point pixelScale){
    const TextGlyphIntersection input = ValidateTextGlyphCandidateInputs(glyph.position, topLeft, fontSize, physicalSize, clip, pixelScale);
    if(input != TextGlyphIntersection::Visible)
        return input;
    if(selectedAtlas.has_value()){
        VectorDouble rectangle(0.0);
        if(!LoadAtlasRectangle(glyph, selectedAtlas.value(), fontSize, topLeft, rectangle))
            return TextGlyphIntersection::Invalid;
        return IntersectGlyphAtlasRectangle(rectangle, clip);
    }
    const b8 hasValidFace = glyph.face.valid() && glyph.face.deref().valid();
    const b8 coverageInkReliable = hasValidFace && glyph.face.deref().coverageInkReliable();
    u32 faceUnitsPerEm = 1u;
    if(hasValidFace)
        faceUnitsPerEm = glyph.face.deref().unitsPerEm();
    return EvaluateUnselectedAtlasGlyphCandidate(glyph.position, topLeft, glyph.ink, glyph.coverage, hasValidFace, coverageInkReliable, faceUnitsPerEm, fontSize, physicalSize, clip, pixelScale);
}


