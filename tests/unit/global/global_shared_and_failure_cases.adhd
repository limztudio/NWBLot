void VerifyGlobal_BinarySharedHelpersPreserveEdgeCases(){
    Array<u8, 2> bytes = Array<u8, 2>();
    bytes[0u] = 0u;
    bytes[1u] = 255u;
    Array<u8, 2> different = Array<u8, 2>();
    different[0u] = 0u;
    different[1u] = 254u;
    EXPECT_TRUE(BytesMatch(Span<u8>(), Span<u8>()));
    EXPECT_FALSE(BytesMatch(bytes, Span<u8>(bytes).subspan(0u, 1u)));
    EXPECT_FALSE(BytesMatch(bytes, different));

    Array<u8, 3> partialBytes = Array<u8, 3>();
    partialBytes[0u] = 0x12u;
    partialBytes[1u] = 0x34u;
    partialBytes[2u] = 0x56u;
    const Span<u8> partialSpan = partialBytes;
    EXPECT_EQ(ReadPartialU32LittleEndian(partialSpan, 0u), 0x00563412u);
    EXPECT_EQ(ReadPartialU32LittleEndian(partialSpan, 2u), 0x56u);
    EXPECT_EQ(ReadPartialU32LittleEndian(partialSpan, 3u), 0u);
    EXPECT_EQ(ReadPartialU32LittleEndian(partialSpan, usize.max), 0x56341200u);
    EXPECT_EQ(ReadAdmittedU16BigEndian(partialSpan, 1u), 0x3456u);

    FixedVector<u8, 8> floatBytes = FixedVector<u8, 8>();
    floatBytes.resize(7u);
    WriteF32LittleEndianAt(bit_cast<f32>(0x80000000u), 0u, floatBytes);
    EXPECT_EQ(floatBytes[3u], 0x80u);
    WriteF32LittleEndianAt(bit_cast<f32>(0x7fc01234u), 4u, floatBytes);
    EXPECT_EQ(floatBytes[4u], 0u);
    floatBytes.resize(8u);
    WriteF32LittleEndianAt(bit_cast<f32>(0x7fc01234u), 4u, floatBytes);
    EXPECT_EQ(floatBytes[4u], 0x34u);
    EXPECT_EQ(floatBytes[5u], 0x12u);
    EXPECT_EQ(floatBytes[6u], 0xc0u);
    EXPECT_EQ(floatBytes[7u], 0x7fu);

    const Expected<StringView> slice = ReadBinaryTextSlice(floatBytes, 4u, 2u);
    EXPECT_TRUE(slice.has_value());
    EXPECT_EQ(slice.value().size(), 2u);
    const Expected<usize> foundOffset = FindBinaryTextOffset(floatBytes, slice.value());
    EXPECT_TRUE(foundOffset.has_value());
    EXPECT_EQ(foundOffset.value(), 4u);
    EXPECT_FALSE(ReadBinaryTextSlice(floatBytes, usize.max, 1u).has_value());
    EXPECT_FALSE(ReadBinaryTextSlice(floatBytes, floatBytes.size(), 1u).has_value());
    const Expected<StringView> emptyEndSlice = ReadBinaryTextSlice(floatBytes, floatBytes.size(), 0u);
    EXPECT_TRUE(emptyEndSlice.has_value());
    EXPECT_TRUE(emptyEndSlice.value().empty());
    const Expected<StringView> emptySpanSlice = ReadBinaryTextSlice(Span<u8>(), 0u, 0u);
    EXPECT_TRUE(emptySpanSlice.has_value());
    EXPECT_TRUE(emptySpanSlice.value().empty());
    EXPECT_FALSE(ReadBinaryTextSlice(Span<u8>(), 1u, 0u).has_value());
    EXPECT_FALSE(FindBinaryTextOffset(floatBytes, "external").has_value());
    EXPECT_FALSE(FindBinaryTextOffset(Span<u8>(), "a").has_value());
    const ErrorCode invalidErr = MakeErrorCode(ErrorCondition::invalid_argument);
    EXPECT_FALSE(ErrorCodeMessage(invalidErr).empty());

    {
        const Array<u8, 3u> pattern = Array<u8, 3u>(1u, 2u, 3u);
        Array<u8, 7u> repeated;
        FillCaseBytes(repeated, repeated.size(), pattern);
        const Array<u8, 7u> expected = Array<u8, 7u>(1u, 2u, 3u, 1u, 2u, 3u, 1u);
        EXPECT_EQ(repeated, expected);
        FillNullDestination(0u, pattern);
        usize emptyCursor = 0u;
        const auto emptyText = ReadCaseBinaryText(BinaryByteView(), 0u, emptyCursor);
        ASSERT_TRUE(emptyText.has_value());
        EXPECT_TRUE(emptyText.value().empty());
        EXPECT_EQ(emptyCursor, 0u);
        usize cursor = bytes.size();
        EXPECT_FALSE(ReadCaseBinaryText(BinaryViewFromBytes(bytes), 1u, cursor).has_value());
        EXPECT_EQ(cursor, bytes.size());
        ThrowingByteContainer throwingBytes;
        ExpectRuntimeException(WriteProbeFloat(1.0f, 0u, throwingBytes));
        ThrowingLvalueByteContainer lvalueBytes;
        RequireThrowingExpression(WriteProbeFloat(1.0f, 0u, lvalueBytes));
        ExpectRuntimeException(WriteProbeFloat(1.0f, 0u, lvalueBytes));
        ThrowingSizeByteContainer sizeBytes;
        RequireThrowingExpression(WriteProbeFloat(1.0f, 0u, sizeBytes));
        ExpectRuntimeException(WriteProbeFloat(1.0f, 0u, sizeBytes));
        EXPECT_DEATH(WriteF32LittleEndianAt(0.0f, usize.max, floatBytes), "");
    }
}

VectorSingle EvalVectorQuantizeSNorm(in VectorSingle value, in VectorSingle scale){
    return VectorQuantizeSNorm(value, scale);
}

VectorSingle EvalVectorQuantizeUNorm(in VectorSingle value, in VectorSingle scale){
    return VectorQuantizeUNorm(value, scale);
}

VectorSingle EvalVectorLinearToSRGB(in VectorSingle value){
    return VectorLinearToSRGB(value);
}

void VerifyGlobal_NumericSharedHelpersPreserveEdgeCases(){
    EXPECT_EQ(PackUnorderedU32Pair(0u, u32.max), 0xffffffffu);
    EXPECT_EQ(PackUnorderedU32Pair(u32.max, 0u), 0xffffffffu);
    EXPECT_EQ(PackUnorderedU32Pair(u32.max, u32.max), u64.max);
    const u64 packedWords = PackU32Words(0xffffffffu, 0x12345678u);
    EXPECT_EQ(packedWords, 0x12345678ffffffffu);
    EXPECT_EQ(LowU32Word(packedWords), 0xffffffffu);
    EXPECT_EQ(HighU32Word(packedWords), 0x12345678u);

    EXPECT_FALSE(AlignUpChecked(usize.max, 4u).has_value());
    const Expected<usize> aligned = AlignUpChecked(usize.max - 3u, 4u);
    ASSERT_TRUE(aligned.has_value());
    EXPECT_EQ(aligned.value(), usize.max - 3u);

    EXPECT_EQ(DivideUpWrappingU32(u32.max, 8u), 0u);
    EXPECT_EQ(DivideUpWrappingU64(u64.max, cast<u64>(2u)), 0u);
    u64 wrappingRevision = u64.max;
    AdvanceWrappingNonzeroU64(wrappingRevision);
    EXPECT_EQ(wrappingRevision, 1u);

    EXPECT_EQ(BitWidthLowU32(0xffffffffu, 0u), 0u);
    EXPECT_EQ(BitWidthLowU32(0x80000100u, 8u), 0u);
    EXPECT_EQ(BitWidthLowU32(0x80000000u, 32u), 32u);
    EXPECT_TRUE(IsNewerSerialU32(0u, u32.max));
    EXPECT_FALSE(IsNewerSerialU32(0x80000000u, 0u));
    EXPECT_FALSE(IsNewerSerialU32(7u, 7u));
    EXPECT_TRUE(IsNotOlderSerialU32(7u, 7u));
    EXPECT_TRUE(IsNotOlderSerialU32(0u, u32.max));
    EXPECT_TRUE(IsNotOlderSerialU32(0x7fffffffu, 0u));
    EXPECT_FALSE(IsNotOlderSerialU32(0x80000000u, 0u));
    EXPECT_FALSE(IsNotOlderSerialU32(0x80000001u, 0u));
    EXPECT_TRUE(IsSerialU32InWindow(0u, 0xfffffffeu, 1u));
    EXPECT_TRUE(IsSerialU32InWindow(1u, 0xfffffffeu, 1u));
    EXPECT_FALSE(IsSerialU32InWindow(2u, 0xfffffffeu, 1u));
    EXPECT_FALSE(IsSerialU32InWindow(0xfffffffdu, 0xfffffffeu, 1u));
    EXPECT_TRUE(IsSerialU32InWindow(0x7fffffffu, 0u, 0x7fffffffu));
    EXPECT_FALSE(IsSerialU32InWindow(0x80000000u, 0u, 0x7fffffffu));
    EXPECT_FALSE(IsSerialU32InWindow(0x80000001u, 0u, 0x7fffffffu));
    EXPECT_FALSE(IsSerialU32InWindow(0u, 0u, 0x80000000u));
    EXPECT_EQ(ComputeSobol2U32(0u), 0u);
    EXPECT_EQ(ComputeSobol2U32(1u), 0x8000000080000000u);
    EXPECT_EQ(ComputeSobol2U32(2u), 0xc000000040000000u);
    EXPECT_EQ(ComputeSobol2U32(3u), 0x40000000c0000000u);
    EXPECT_EQ(DivideFloorI64(i64.min, 1), i64.min);
    EXPECT_EQ(DivideFloorI64(-3, 2), -2);
    EXPECT_EQ(DivideCeilI64(-3, 2), -1);
    EXPECT_EQ(DivideCeilI64(i64.max, 2), i64.max / 2 + 1);
    EXPECT_EQ(ClassifyIntegerGrammar("-"), s_NumericGrammarIncomplete);
    EXPECT_EQ(ClassifyIntegerGrammar("--1"), s_NumericGrammarInvalid);
    EXPECT_EQ(ClassifyIntegerGrammar(" 1"), s_NumericGrammarInvalid);
    EXPECT_EQ(ClassifyFloatGrammar("."), s_NumericGrammarIncomplete);
    EXPECT_EQ(ClassifyFloatGrammar("1e+"), s_NumericGrammarIncomplete);
    EXPECT_EQ(ClassifyFloatGrammar("1e+x"), s_NumericGrammarInvalid);
    EXPECT_EQ(ClassifyFloatGrammar(".e"), s_NumericGrammarInvalid);
    EXPECT_EQ(ClassifyFloatGrammar("1."), s_NumericGrammarComplete);

    Array<f64, 2> signedZeroSamples = Array<f64, 2>();
    signedZeroSamples[0u] = 0.0;
    signedZeroSamples[1u] = -0.0;
    const OnlineF64Statistics zeroStatistics = ComputeOnlineF64Statistics(signedZeroSamples);
    EXPECT_EQ(zeroStatistics.count, 2u);
    EXPECT_EQ(bit_cast<u64>(zeroStatistics.minimum), 0x8000000000000000u);
    EXPECT_EQ(bit_cast<u64>(zeroStatistics.maximum), 0x8000000000000000u);

    EXPECT_EQ(QuantizeUNormScalar(-bit_cast<f32>(0x7f800000u), 255.0f), 0.0f);
    EXPECT_EQ(QuantizeUNormScalar(bit_cast<f32>(0x7f800000u), 255.0f), 255.0f);
    EXPECT_EQ(QuantizeUNormScalar(0.5f, 255.0f), 128.0f);
    EXPECT_EQ(QuantizeSNormScalar(-0.5f, 127.0f), -64.0f);
    EXPECT_EQ(bit_cast<u32>(QuantizeSNormScalar(-0.0f, 127.0f)), 0u);
    EXPECT_EQ(QuantizeSNormScalar(bit_cast<f32>(0x7fc01234u), 127.0f), -127.0f);

    const VectorSingle signedColor = EvalVectorQuantizeSNorm(VectorSingle(-0.0f, -0.5f, 0.5f, -2.0f), VectorSingle(127.0f, 127.0f, 127.0f, 127.0f));
    EXPECT_EQ(signedColor.x, 0.0f);
    EXPECT_EQ(signedColor.y, -64.0f);
    EXPECT_EQ(signedColor.z, 64.0f);
    EXPECT_EQ(signedColor.w, -127.0f);

    const VectorSingle quantizedColor = EvalVectorQuantizeUNorm(VectorSingle(-1.0f, 0.5f, 1.0f, 2.0f), VectorSingle(255.0f, 255.0f, 255.0f, 255.0f));
    EXPECT_EQ(quantizedColor.x, 0.0f);
    EXPECT_EQ(quantizedColor.y, 128.0f);
    EXPECT_EQ(quantizedColor.z, 255.0f);
    EXPECT_EQ(quantizedColor.w, 255.0f);

    const VectorSingle encodedColor = EvalVectorLinearToSRGB(VectorSingle(-1.0f, 0.0031308f, 1.0f, 2.0f));
    EXPECT_EQ(encodedColor.x, 0.0f);
    EXPECT_NEAR(encodedColor.y, 0.0031308f * 12.92f, 0.000001f);
    EXPECT_NEAR(encodedColor.z, 1.0f, 0.000001f);
    EXPECT_NEAR(encodedColor.w, 1.0f, 0.000001f);

    Array<u32, 2> narrowSum = Array<u32, 2>();
    narrowSum[0u] = u32.max;
    narrowSum[1u] = 1u;
    const Expected<u32> wrappedNarrowSum = TrySumUnsignedWithU64Limit<u32>(narrowSum);
    ASSERT_TRUE(wrappedNarrowSum.has_value());
    EXPECT_EQ(wrappedNarrowSum.value(), 0u);

    Array<u64, 2> wideSumOverflow = Array<u64, 2>();
    wideSumOverflow[0u] = u64.max;
    wideSumOverflow[1u] = 1u;
    EXPECT_FALSE(TrySumUnsignedWithU64Limit<u64>(wideSumOverflow).has_value());
    const u64 emptyUnsignedSum = TrySumUnsignedWithU64Limit<u64>(Span<u64>()).value();
    EXPECT_EQ(emptyUnsignedSum, 0u);

    Array<u64, 2> exactMaximumSum = Array<u64, 2>();
    exactMaximumSum[0u] = u64.max - 1u;
    exactMaximumSum[1u] = 1u;
    const u64 exactUnsignedSum = TrySumUnsignedWithU64Limit<u64>(exactMaximumSum).value();
    EXPECT_EQ(exactUnsignedSum, u64.max);

    Array<u64, 2> maximumThenZero = Array<u64, 2>();
    maximumThenZero[0u] = u64.max;
    maximumThenZero[1u] = 0u;
    EXPECT_FALSE(TrySumNonzeroU64(maximumThenZero).has_value());

    Array<u64, 1> maximumCount = Array<u64, 1>();
    maximumCount[0u] = u64.max;
    Array<u64, 2> overflowingCounts = Array<u64, 2>();
    overflowingCounts[0u] = u64.max;
    overflowingCounts[1u] = 1u;
    Array<u64, 1> zeroCount = Array<u64, 1>();
    zeroCount[0u] = 0u;
    const u64 emptyNonzeroSum = TrySumNonzeroU64(Span<u64>()).value();
    EXPECT_EQ(emptyNonzeroSum, 0u);
    const u64 maximumNonzeroSum = TrySumNonzeroU64(maximumCount).value();
    EXPECT_EQ(maximumNonzeroSum, u64.max);
    EXPECT_FALSE(TrySumNonzeroU64(overflowingCounts).has_value());
    EXPECT_FALSE(TrySumNonzeroU64(zeroCount).has_value());

    u64 total = 11u;
    EXPECT_FALSE(AccumulateBoundedCount(0u, 10u, total));
    EXPECT_EQ(total, 11u);
    total = u64.max - 1u;
    EXPECT_FALSE(AccumulateBoundedCount(2u, u64.max, total));
    EXPECT_EQ(total, u64.max - 1u);

    const NarrowChar highByteChar = bit_cast<NarrowChar>(cast<u8>(0x80u));
    EXPECT_EQ(PackFourCharTag('H', 'a', 'n', 'g'), 0x48616e67u);
    EXPECT_EQ(PackFourCharTag(cast<i8>(highByteChar), 'a', 'b', 'c'), (cast<u32>(cast<i32>(highByteChar)) << 24u) | 0x00616263u);

    const Expected<i64> minSignedDiff = SignedDifference(0u, cast<u64>(i64.max) + 1u);
    ASSERT_TRUE(minSignedDiff.has_value());
    EXPECT_EQ(minSignedDiff.value(), i64.min);
    EXPECT_FALSE(SignedDifference(0u, cast<u64>(i64.max) + 2u).has_value());
    EXPECT_FALSE(SignedDifference(cast<u64>(i64.max) + 1u, 0u).has_value());
    EXPECT_FALSE(AlignUpCheckedSize(usize.max, 4u).has_value());

    EXPECT_TRUE(DifferentF64Bits(0.0, -0.0));
    EXPECT_FALSE(DifferentF64Bits(bit_cast<f64>(cast<u64>(0x7ff8000000001234u)), bit_cast<f64>(cast<u64>(0x7ff8000000001234u))));
    EXPECT_TRUE(DifferentF64Bits(bit_cast<f64>(cast<u64>(0x7ff8000000001234u)), bit_cast<f64>(cast<u64>(0x7ff8000000001235u))));
    EXPECT_EQ(SaturateU64ToI32(cast<u64>(i32.max) + 1u), i32.max);
    const u64 minimumSignedOffset = AddSignedOffset(cast<u64>(1u) << 63u, i64.min).value();
    EXPECT_EQ(minimumSignedOffset, 0u);
    EXPECT_FALSE(AddSignedOffset(0u, i64.min).has_value());
    EXPECT_FALSE(AddSignedOffset(u64.max, 1).has_value());
    EXPECT_EQ(DivideUpWrapping(cast<usize>(9u), cast<usize>(8u)), cast<usize>(2u));

    const BalancedPartitionRange firstRange = ComputeBalancedPartitionRange(10u, 0u, 2u, 1u);
    const BalancedPartitionRange lastRange = ComputeBalancedPartitionRange(10u, 2u, 2u, 1u);
    EXPECT_EQ(firstRange.first, 10u);
    EXPECT_EQ(firstRange.last, 13u);
    EXPECT_EQ(lastRange.first, 15u);
    EXPECT_EQ(lastRange.last, 17u);

    Atomic<u64> wrappingIdentity = Atomic<u64>(u64.max);
    EXPECT_EQ(NextAtomicWrappingNonzero(wrappingIdentity), 1u);
    EXPECT_FALSE(HasSingleSetBit(cast<u16>(0u)));
    EXPECT_TRUE(HasSingleSetBit(cast<u16>(0x8000u)));
    EXPECT_EQ(LowestSetBit(cast<u8>(0x90u)), cast<u8>(0x10u));
    EXPECT_EQ(AlignmentOffsetPowerOfTwo(usize.max, 8u), 1u);
    EXPECT_EQ(SubtractSaturating(cast<u64>(1u), cast<u64>(2u)), 0u);

    const f64 tinySubnormal = bit_cast<f64>(cast<u64>(0x3690000000000000u));
    const f64 aboveOneHalfUlp = 1.0 + bit_cast<f64>(cast<u64>(0x3e70000000000000u));
    EXPECT_EQ(bit_cast<u32>(RoundF64ToF32Bound(tinySubnormal, false)), 0u);
    EXPECT_EQ(bit_cast<u32>(RoundF64ToF32Bound(tinySubnormal, true)), 1u);
    EXPECT_EQ(bit_cast<u32>(RoundF64ToF32Bound(-tinySubnormal, false)), 0x80000001u);
    EXPECT_EQ(bit_cast<u32>(RoundF64ToF32Bound(-tinySubnormal, true)), 0x80000000u);
    EXPECT_EQ(bit_cast<u32>(RoundF64ToF32Bound(-0.0, false)), 0x80000000u);
    EXPECT_EQ(bit_cast<u32>(RoundF64ToF32Bound(aboveOneHalfUlp, false)), 0x3f800000u);
    EXPECT_EQ(bit_cast<u32>(RoundF64ToF32Bound(aboveOneHalfUlp, true)), 0x3f800001u);
}

[cpp_unwind]
void VerifyGlobal_CollectionSharedHelpersPreserveEdgeCases(){
    EXPECT_FALSE(UnsignedRangesOverlap(1u, 0u, u64.max, 2u));
    EXPECT_TRUE(UnsignedRangesOverlap(u64.max, 2u, 0u, 1u));

    Array<usize, 4> ordered = Array<usize, 4>();
    ordered[0u] = 1u;
    ordered[1u] = 3u;
    ordered[2u] = 3u;
    ordered[3u] = 8u;
    const Span<usize> orderedSpan = ordered;
    EXPECT_EQ(LowerBoundIndex(Span<usize>(), 3u), 0u);
    EXPECT_EQ(LowerBoundIndex(orderedSpan, 3u), 1u);
    EXPECT_EQ(LowerBoundIndex(orderedSpan, 9u), ordered.size());

    Array<u64, 64u> matrix = Array<u64, 64u>();
    matrix[1u] = cast<u64>(1u) << 63u;
    TransposeBitMatrix64(matrix);
    EXPECT_EQ(matrix[63u], 2u);
    TransposeBitMatrix64(matrix);
    EXPECT_EQ(matrix[1u], cast<u64>(1u) << 63u);

    {
        Vector<u32> cachedValues;
        cachedValues.push_back(1u);
        cachedValues.push_back(2u);
        cachedValues.push_back(4u);
        const Array<u32, 3u> requestedValues = Array<u32, 3u>(2u, 3u, 3u);
        const auto sameValue = lambda[](in u32 cached, in u32 requested) -> b8{ return cached == requested; };
        EXPECT_EQ(CountMissingCacheEntries(cachedValues, requestedValues, sameValue), 2u);
        const auto throwingKey = lambda[](in u32 lhs, in u32 rhs) -> b8{ ThrowTestRuntime("predicate failure"); return false; };
        ExpectRuntimeException(CountMissingCacheEntries(cachedValues, requestedValues, throwingKey));
        ExpectRuntimeException(RetainReferencedCacheEntries(requestedValues, throwingKey, cachedValues));
        RetainReferencedCacheEntries(requestedValues, sameValue, cachedValues);
        ASSERT_EQ(cachedValues.size(), 1u);
        EXPECT_EQ(cachedValues[0u], 2u);
        Vector<u32> rollbackValues;
        rollbackValues.push_back(7u);
        u32 underflows = 0u;
        {
            const auto rollback = WatchAppend(rollbackValues, lambda[mut underflows]() -> void{ ++underflows; });
            rollbackValues.push_back(8u);
        }
        EXPECT_EQ(rollbackValues.size(), 1u);
        EXPECT_EQ(rollbackValues[0u], 7u);
        {
            const auto rollback = WatchAppend(rollbackValues, lambda[mut underflows]() -> void{ ++underflows; });
            rollbackValues.pop_back();
        }
        EXPECT_EQ(underflows, 1u);
        Array<u32, 130u> indexFlags;
        indexFlags.fill(1u);
        indexFlags[0u] = 0u;
        indexFlags[64u] = 0u;
        indexFlags[129u] = 0u;
        ScratchStorage storage;
        CaseIndexSet ready(storage);
        ready.initializeZeros(Span<u32>(indexFlags));
        EXPECT_EQ(ready.takeLowest(), 0u);
        EXPECT_EQ(ready.takeLowest(), 64u);
        EXPECT_EQ(ready.takeLowest(), 129u);
        EXPECT_EQ(ready.takeLowest(), 130u);
        ready.add(64u);
        ready.add(64u);
        EXPECT_EQ(ready.takeLowest(), 64u);
        EXPECT_EQ(ready.takeLowest(), 130u);

        Vector<u64> denseMatrix;
        denseMatrix.resize(130u, 0u);
        denseMatrix[1u] = 1u;
        denseMatrix[2u] = 1u;
        SymmetrizeDenseBitMatrix(denseMatrix, 65u, 2u);
        EXPECT_EQ(denseMatrix[128u] & 1u, 1u);
        EXPECT_EQ(denseMatrix[0u] & 2u, 2u);

        Array<WordRangeProbe, 65u> ranges;
        Array<usize, 65u> offsets;
        usize wordCount = 0u;
        for(usize i = 0u; i < ranges.size(); ++i){
            WordRangeProbe entry;
            entry.begin = 0u;
            entry.end = 1u;
            if(i == 0u || i == 1u || i == 64u)
                entry.end = 2u;
            ranges[i] = entry;
            offsets[i] = wordCount;
            wordCount += ranges[i].end;
        }
        Vector<u64> compactMatrix;
        compactMatrix.resize(wordCount, 0u);
        compactMatrix[offsets[0u] + 1u] = 1u;
        compactMatrix[offsets[1u]] = 1u;
        compactMatrix[offsets[64u]] = 2u;
        SymmetrizeCompactBitMatrix(compactMatrix, offsets, ranges, 65u, 2u);
        EXPECT_EQ(compactMatrix[offsets[64u]] & 1u, 1u);
        EXPECT_EQ(compactMatrix[offsets[0u]] & 2u, 2u);
        EXPECT_EQ(compactMatrix[offsets[1u] + 1u] & 1u, 1u);

        Vector<IntegerRectBounds> fragments;
        AppendIntegerRectRemainder(IntegerRectBounds(0u, 4u, 0u, 4u), IntegerRectBounds(1u, 3u, 1u, 3u), fragments);
        ASSERT_EQ(fragments.size(), 4u);
        EXPECT_EQ(fragments[0u].xEnd, 1u);
        EXPECT_EQ(fragments[1u].xBegin, 3u);
        EXPECT_EQ(fragments[2u].yEnd, 1u);
        EXPECT_EQ(fragments[3u].yBegin, 3u);
    }
}

void VerifyGlobal_HashSharedHelpersPreserveEdgeCases(){
    EXPECT_EQ(MixMurmur64Finalizer(0u), 0u);
    EXPECT_EQ(MixMurmur64Finalizer(1u), 0xb456bcfc34c2cb2cu);
    EXPECT_EQ(BoolToYesNoText(true), "yes");
    EXPECT_EQ(BoolToYesNoText(false), "no");
    EXPECT_EQ(UpdateFnv64U32(s_Fnv64OffsetBasis, 0x12345678u), 0xcccfd053e47c3365u);
    EXPECT_EQ(UpdateFnv64U64(s_Fnv64OffsetBasis, 0x0123456789abcdefu), 0x37eb3f3347761c55u);
    NameHash lanes = NameHash();
    lanes.qwords[0u] = 0x0123456789abcdefu;
    lanes.qwords[1u] = 0u;
    lanes.qwords[2u] = 0xffffffffffffffffu;
    lanes.qwords[3u] = 0x0102030405060708u;
    lanes.qwords[4u] = 5u;
    lanes.qwords[5u] = 6u;
    lanes.qwords[6u] = 7u;
    lanes.qwords[7u] = 8u;
    EXPECT_EQ(UpdateFnv64NameHash(0x123456789abcdef0u, lanes), 0x08d4d531507706dcu);
    EXPECT_EQ(FoldNameHash64(lanes), 0xe33b773ee6cabb20u);

    {
        CharSink sink;
        AppendHexByte(cast<u8>(0xAFu), sink);
        EXPECT_EQ(sink.data[0u], 'a');
        EXPECT_EQ(sink.data[1u], 'f');
        sink.size = 0u;
        AppendSha1Hex(Sha1Digest(), sink);
        EXPECT_EQ(sink.size, s_Sha1DigestHexTextLength);
        EXPECT_EQ(sink.data[0u], '0');
        EXPECT_EQ(sink.data[sink.size - 1u], '0');
    }
}

void VerifyNoexceptFailureTests_HashResultConversionFailurePreservesCombinedSeed(){
    usize seed = 17u;
    {
        HashProbe value;
        RequireThrowingExpression(HashCombine(seed, value));
        ExpectUnsignedException(HashCombine(seed, value));
    }
    EXPECT_EQ(seed, 17u);
}

void VerifyNoexceptFailureTests_PlacementAllocationFailurePropagatesThroughCaptureConstructionAndReplacement(){
    u32 previousInvocations = 0u;
    {
        ThrowingPlacementCallable callable;
        RequireThrowingExpression(FunctionStorage(callable));
        ExpectUnsignedException(FunctionStorage(callable));
        FunctionStorage stored(lambda[mut previousInvocations]() -> void{ ++previousInvocations; });
        RequireThrowingExpression(AssignCaseStorage(stored, callable));
        ExpectUnsignedException(AssignCaseStorage(stored, callable));
        EXPECT_FALSE(NonemptyCallable(stored));
    }
    EXPECT_EQ(previousInvocations, 0u);
}

void VerifyNoexceptFailureTests_ThrowingByteGetterPreservesReadOffset(){
    usize offset = 0u;
    {
        ThrowingByteSource source;
        RequireThrowingExpression(ReadPOD<u32>(source, offset));
        ExpectUnsignedException(ReadPOD<u32>(source, offset));
    }
    EXPECT_EQ(offset, 0u);
}

void VerifyNoexceptFailureTests_PodAddressAndMutableBufferGetterFailuresPropagateBeforeReading(){
    usize offset = 0u;
    {
        Array<u8, 4u> bytes;
        const BinaryByteView source = BinaryViewFromBytes(bytes);
        RequireThrowingExpression(ReadPOD<ThrowingPodAddress>(source, offset));
        ExpectUnsignedException(ReadPOD<ThrowingPodAddress>(source, offset));
        ThrowingMutableByteSource mutableSource;
        RequireThrowingExpression(ProbeMutableReadBuffer(mutableSource));
        ExpectUnsignedException(ProbeMutableReadBuffer(mutableSource));
    }
    EXPECT_EQ(offset, 0u);
}

void VerifyNoexceptFailureTests_BoundedDiagnosticsNeverInvokeThrowingConversionOrCleanupAdapters(){
    u32 calls = 0u;
    {
        const ThrowingDiagnosticView conversion(calls);
        const ThrowingDiagnosticCleanup cleanup(calls);
        EXPECT_EQ(MakeDiagnosticEventText("{}", conversion).view(), "<unprintable>");
        EXPECT_EQ(MakeDiagnosticEventText("{}", cleanup).view(), "<unprintable>");
    }
    EXPECT_EQ(calls, 0u);
}

void VerifyNoexceptFailureTests_CaptureMoveTransportDoesNotReinvokeClassPlacementAllocation(){
    u32 calls = 0u;
    {
        ResetPlacements();
        StatefulPlacementCallable callable(calls);
        FunctionStorage source(callable);
        EXPECT_EQ(Placements(), 1u);
        FunctionStorage moved = MoveCaseValue<FunctionStorage>(source);
        EXPECT_FALSE(NonemptyCallable(source));
        ASSERT_TRUE(NonemptyCallable(moved));
        CallStoredFunction(moved);
        EXPECT_EQ(Placements(), 1u);
    }
    EXPECT_EQ(calls, 1u);
}

void VerifyNoexceptFailureTests_FancyPointerDereferenceAndRawConversionFailuresPreserveBorrowedTarget(){
    b8 preservedTarget = false;
    {
        RefCountTarget target;
        FancyOwner stored = BorrowFancy(target);
        RequireThrowingExpression(DereferenceOwner(stored));
        RequireThrowingExpression(AssignRaw(stored, target));
        ExpectUnsignedException(DereferenceOwner(stored));
        ExpectUnsignedException(AssignRaw(stored, target));
        preservedTarget = PointsAt(stored, target);
    }
    EXPECT_TRUE(preservedTarget);
}

void VerifyNoexceptFailureTests_UniqueOwnerComparisonResultConversionUnwindsThroughEveryBooleanWrapper(){
    u32 wrapperChecks = 0u;
    b8 firstNull = false;
    b8 secondNull = false;
    {
        VerifyPlainOwnerComparisons<PlainUnique>();
        VerifyComparisonConversions<UniqueComparisonOwner>(wrapperChecks, firstNull, secondNull);
    }
    EXPECT_EQ(wrapperChecks, 10u);
    EXPECT_TRUE(firstNull);
    EXPECT_TRUE(secondNull);
}

