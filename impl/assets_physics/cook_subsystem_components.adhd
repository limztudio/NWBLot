b8 ParsePhysicsEntityNameListValue(
    in Path file,
    in MetascriptValue fieldVal,
    in StringView prefix,
    in StringView key,
    mut Vector<Name> outNames
){
    if(!fieldVal.isList()){
        error("{} '{}': field '{}' must be a list of names", prefix, PathToString(file), key);
        return false;
    }
    const Span<MetascriptValue> items = fieldVal.listView();
    outNames.clear();
    outNames.resize(items.size(), s_NameNone);
    for(usize pi = 0u; pi < items.size(); ++pi){
        if(!items[pi].isString()){
            error("{} '{}': '{}[{}]' must be a string", prefix, PathToString(file), key, pi);
            return false;
        }
        const StringView text = items[pi].asString();
        if(!text.empty()){
            const Expected<Name> parsed = ParseName(text);
            if(!parsed.has_value()){
                error("{} '{}': invalid name at '{}[{}]'", prefix, PathToString(file), key, pi);
                return false;
            }
            outNames[pi] = parsed.value();
        }
    }
    return true;
}

b8 ParsePhysicsAabbMap(in Path file, in MetascriptValue mapVal, in StringView prefix, in StringView field, mut Aabb3D outBounds){
    if(!mapVal.isMap()){
        error("{} '{}': field '{}' must be a map", prefix, PathToString(file), field);
        return false;
    }
    return mapVal.forEachMapEntry(lambda[in file, in prefix, mut outBounds](in StringView key, in MetascriptValue fieldVal) -> b8{
        if(key == "lower"){
            VectorSingle v(0.0f);
            if(!DecodePhysicsFloat3Value(file, fieldVal, prefix, key, v))
                return false;
            outBounds.lowerBound = f32x4(v, 0.0f);
            return true;
        }
        if(key == "upper"){
            VectorSingle v(0.0f);
            if(!DecodePhysicsFloat3Value(file, fieldVal, prefix, key, v))
                return false;
            outBounds.upperBound = f32x4(v, 0.0f);
            return true;
        }
        error("{} '{}': unsupported aabb field '{}'", prefix, PathToString(file), key);
        return false;
    });
}

b8 ReadPhysicsFloat4ArrayValue(
    in Path file,
    in MetascriptValue fieldVal,
    in StringView prefix,
    in StringView key,
    in b8 allowVec3DefaultZeroW,
    mut Vector<f32x4> outValues
){
    if(!fieldVal.isList()){
        error("{} '{}': field '{}' must be a list of vectors", prefix, PathToString(file), key);
        return false;
    }
    const Span<MetascriptValue> items = fieldVal.listView();
    outValues.clear();
    outValues.reserve(items.size());
    for(usize i = 0u; i < items.size(); ++i){
        in MetascriptValue item = items[i];
        if(allowVec3DefaultZeroW && item.isList() && item.listView().size() == 3u){
            VectorSingle v(0.0f);
            if(!DecodePhysicsFloat3Value(file, item, prefix, key, v))
                return false;
            outValues.push_back(f32x4(v, 0.0f));
        }
        else{
            const Expected<f32x4> v4 = DecodePhysicsFloat4Value(file, item, prefix, key);
            if(!v4.has_value())
                return false;
            outValues.push_back(v4.value());
        }
    }
    return true;
}

void CopyVehicleRigDataToComponent(in VehicleAssetData src, mut VehicleComponent dst){
    dst.engine = src.engine;
    dst.wheels = src.wheels;
    dst.queryFilter = src.queryFilter;
    dst.wheelSlipEventThreshold = src.wheelSlipEventThreshold;
    dst.trailerLocalHitchChassis = src.trailerLocalHitchChassis;
    dst.trailerLocalHitchTrailer = src.trailerLocalHitchTrailer;
    dst.trailerSwingLimitRad = src.trailerSwingLimitRad;
}

void CopyRagdollRigDataToComponent(in RagdollAssetData src, mut RagdollComponent dst){
    dst.bones = src.bones;
    dst.mode = src.mode;
    dst.enableSelfCollision = src.enableSelfCollision;
    dst.autoExcludeInitialOverlaps = src.autoExcludeInitialOverlaps;
    dst.disabledSelfCollisionPairs = src.disabledSelfCollisionPairs;
    dst.autoGenParams = src.autoGenParams;
    dst.driveStrengthMultiplier = src.driveStrengthMultiplier;
    dst.boneKinematicMask = src.boneKinematicMask;
    dst.boneJointIndices = src.boneJointIndices;
}

void CopyArticulationRigDataToComponent(in ArticulationAssetData src, mut ArticulationComponent dst){
    dst.links = src.links;
    dst.isFixedBase = src.isFixedBase;
    dst.subSteps = src.subSteps;
    dst.solverIterations = src.solverIterations;
    dst.enableContactCoupling = src.enableContactCoupling;
    dst.overrideContactFriction = src.overrideContactFriction;
    dst.contactRestitution = src.contactRestitution;
    dst.contactFriction = src.contactFriction;
    dst.contactFilter = src.contactFilter;
    dst.mimicConstraints = src.mimicConstraints;
    dst.tendonConstraints = src.tendonConstraints;
    dst.spatialTendons = src.spatialTendons;
    dst.loopConstraints = src.loopConstraints;
    dst.enableSelfCollision = src.enableSelfCollision;
    dst.selfCollisionMargin = src.selfCollisionMargin;
    dst.enableCcd = src.enableCcd;
    dst.ccdMotionThreshold = src.ccdMotionThreshold;
    dst.enableSleep = src.enableSleep;
    dst.sleepLinearThreshold = src.sleepLinearThreshold;
    dst.sleepAngularThreshold = src.sleepAngularThreshold;
    dst.sleepTimeThreshold = src.sleepTimeThreshold;
    dst.driveStrengthMultiplier = src.driveStrengthMultiplier;
    dst.linkJointIndices = src.linkJointIndices;
}


