#include <impl/ecs_render/raytrace/raytracing_system.adhd>
#include <impl/ecs_render/shadow/slot_selection.adhd>
#include <impl/ecs_render/kernel/timing_names.adhd>
#include <impl/ecs_render/shadow/rt_shadow_visibility_targets_and_recorders.adhd>
#include <impl/ecs_render/shadow/rt_shadow_state.adhd>


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


const f32 s_ShadowVisibilityAllLitChannel = 1.0f;


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


class ShadowDispatchGrid2D{
    public u32 groupsX = 0u;
    public u32 groupsY = 0u;
}

ShadowDispatchGrid2D ResolveFullShadowDispatchGrid(in u32 width, in u32 height, in u32 groupSize){
    ShadowDispatchGrid2D grid;
    grid.groupsX = DivideUp(width, groupSize);
    grid.groupsY = DivideUp(height, groupSize);
    return grid;
}

u32 SelectShadowTraceGroupSize(in b8 hardwareShadowSupported, in u32 hardwareGroupSize, in u32 softwareGroupSize){
    if(hardwareShadowSupported)
        return hardwareGroupSize;
    return softwareGroupSize;
}

ShadowDispatchGrid2D ResolveSoftShadowDispatchGrid(in u32 width, in u32 height, in u32 receiverFactor, in u32 groupSize){
    ShadowDispatchGrid2D grid;
    grid.groupsX = ResolveWrappingRayTracingDispatchGroup(width, receiverFactor, groupSize);
    grid.groupsY = ResolveWrappingRayTracingDispatchGroup(height, receiverFactor, groupSize);
    return grid;
}

b8 IsSoftShadowActive(in b8 softShadowReady, in u32 softShadowSlotMask){
    return softShadowReady && softShadowSlotMask != 0u;
}

b8 CanRenderSplitSoftOpaqueShadow(in b8 softShadowReady, in b8 softTransparentReady, in u32 softShadowSlotMask){
    return IsSoftShadowActive(softShadowReady, softShadowSlotMask) && softTransparentReady;
}

b8 CanRenderSoftOpaqueShadowResolvePhase(
    in b8 softShadowReady,
    in b8 softTransparentReady,
    in u32 softShadowSlotMask,
    in b8 softShadowTemporalReady,
    in SoftShadowOpaqueResolvePhase phase
){
    if(!CanRenderSplitSoftOpaqueShadow(softShadowReady, softTransparentReady, softShadowSlotMask))
        return false;
    return phase == SoftShadowOpaqueResolvePhase::TemporalAndWavelet || softShadowTemporalReady;
}

b8 CanPrepareSoftTransparentShadowFold(
    in b8 softShadowReady,
    in u32 softShadowSlotMask,
    in b8 softTransparentShadowReady,
    in b8 transparentSceneReady,
    in b8 hasInstanceMaterialBuffer,
    in b8 hasMaterialTypedBuffer,
    in b8 hasInstanceBuffer
){
    return IsSoftShadowActive(softShadowReady, softShadowSlotMask)
        && softTransparentShadowReady
        && transparentSceneReady
        && hasInstanceMaterialBuffer
        && hasMaterialTypedBuffer
        && hasInstanceBuffer;
}

GraphOwnedAdaptiveShadowPlan ResolveGraphOwnedAdaptiveShadowPlan(
    in b8 softTransparentShadowReady,
    in b8 hardwareShadowSupported,
    in b8 softwareResourcesPreflighted,
    in b8 hasEdgeCounterBuffer
){
    GraphOwnedAdaptiveShadowPlan adaptivePlan;
    if(!softTransparentShadowReady && !hardwareShadowSupported && softwareResourcesPreflighted && hasEdgeCounterBuffer){
        adaptivePlan.enabled = true;
        adaptivePlan.compact = true;
    }
    return adaptivePlan;
}

b8 CanUseCombinedSoftShadowUpsample(
    in b8 softTransparentFoldReady,
    in b8 hasCombinedUpsamplePipeline,
    in u32 opaquePassCount,
    in u32 transparentPassCount
){
    return softTransparentFoldReady && hasCombinedUpsamplePipeline && opaquePassCount == 1u && transparentPassCount == 1u;
}

void PopulateSwShadowSoftOpaquePush(in u32 width, in u32 height, in u32 frameIndex, in u32 softSampleCount, mut SwShadowHeapPushConstants outPush){
    outPush.width = width;
    outPush.height = height;
    outPush.frameIndex = frameIndex;
    outPush.softSampleCount = softSampleCount;
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


RayTracingShadowVisibilityGraphPlanSnapshot RendererRayTracingSystem::snapshotShadowVisibilityGraphPlan(in b8 hardwareShadowSupported)const{
    in RendererRayTracingState state = this.m_rayTracingState;
    const b8 hardwareTransparentTrace = hardwareShadowSupported && state.softShadow.m_softTransparentReady && this.hardwareTransparentShadowReady();
    b8 transparentSceneReady = state.sceneBvh.m_sceneBvhNodeBuffer.valid() && state.sceneBvh.m_sceneInstanceBuffer.valid();
    if(hardwareTransparentTrace)
        transparentSceneReady = state.sceneBvh.m_tlas.valid() && state.sceneBvh.m_tlasHeapHandle.valid();
    const b8 softTransparentFoldReady = CanPrepareSoftTransparentShadowFold(
        state.softShadow.m_softShadowReady,
        state.softShadow.m_softShadowSlotMask,
        this.softTransparentShadowReady(),
        transparentSceneReady,
        state.shadow.m_shadowInstanceMaterialBuffer.valid(),
        state.shadow.m_shadowMaterialTypedBuffer.valid(),
        state.shadow.m_shadowInstanceBuffer.valid()
    );
    const GraphOwnedAdaptiveShadowPlan adaptivePlan = ResolveGraphOwnedAdaptiveShadowPlan(
        this.softTransparentShadowReady(),
        hardwareShadowSupported,
        this.shadowVisibilitySoftwareResourcesPreflighted(),
        state.shadow.m_swShadowEdgeCounterBuffer.valid()
    );

    RayTracingShadowVisibilityGraphPlanSnapshot snapshot;
    snapshot.lightSpace = this.lightSpaceShadowSnapshot();
    snapshot.adaptivePlan = adaptivePlan;
    snapshot.hardwareTransparentTrace = hardwareTransparentTrace;
    snapshot.softTransparentFoldReady = softTransparentFoldReady;
    snapshot.combinedSoftUpsample = CanUseCombinedSoftShadowUpsample(
        softTransparentFoldReady,
        state.shadow.m_softShadowResolve.m_combinedUpsample.m_pipeline.valid(),
        s_ShadowWaveletResolvePassCount,
        s_ShadowWaveletTransparentResolvePassCount
    );
    snapshot.combinedSoftWaveletReady = state.shadow.m_softShadowResolve.m_combinedWavelet.m_pipeline.valid()
        && state.softShadow.m_softShadowTemporalReady && state.softShadow.m_softTransparentTemporalReady;
    snapshot.combinedSoftTemporalReady = state.shadow.m_softShadowResolve.m_combinedTemporal.m_pipeline.valid();
    snapshot.softShadowHistoryReadable = SoftShadowTemporalHistoryUsable(
        state.softShadow.m_softShadowTemporalReady,
        state.softShadow.m_prevWorldToClipValid,
        state.softShadow.m_softShadowTemporalSeeded
    );
    snapshot.opaqueTemporalMergeReady = state.softShadow.m_softShadowTemporalReady;
    snapshot.transparentTemporalMergeReady = state.softShadow.m_softTransparentTemporalReady;
    snapshot.historyFrontIsA = state.softShadow.m_softShadowHistoryFrontIsA != 0u;
    return snapshot;
}

b8 RendererRayTracingSystem::setShadowQualitySettings(in ShadowQualitySettings settings){
    if(!ValidateShadowQualitySettings(settings))
        return false;
    if(SameShadowQualitySettings(this.m_shadowQualitySettings, settings))
        return true;
    ApplyShadowQualitySettingsChange(
        settings,
        this.m_shadowQualitySettings,
        this.m_temporalOneShadowSamplingLogged,
        this.m_rayTracingState.softShadow.m_transparentShadowSamplingHistory,
        this.m_rayTracingState.softShadow.m_softShadowTemporalSeeded,
        this.m_rayTracingState.softShadow.m_softShadowTemporalHistoryAdvancePending
    );
    this.m_rayTracingState.shadow.m_softwareTransparentSampling.m_history.discard();
    return true;
}

void RendererRayTracingSystem::clearShadowVisibility(mut CommandList commandList, mut DeferredFrameTargets targets){
    if(!targets.shadowVisibility.valid())
        return;

    commandList.setTextureState(targets.shadowVisibility.get(), s_ShadowVisibilitySubresources, ResourceStates::CopyDest);
    commandList.commitBarriers();
    commandList.clearTextureFloat(targets.shadowVisibility.deref(), s_ShadowVisibilitySubresources, Color(s_ShadowVisibilityAllLitChannel, s_ShadowVisibilityAllLitChannel, s_ShadowVisibilityAllLitChannel, s_ShadowVisibilityAllLitChannel));
}

Expected<u32> RendererRayTracingSystem::renderGpuBvhShadowVisibility(
    mut CommandList commandList,
    mut DeferredFrameTargets targets,
    in DeferredLightingGraphResources deferredLightingResources,
    in b8 splitSoftTransparentFold,
    in b8 graphOwnsOpaqueTemporalMergeEntryStates,
    in b8 splitOpaqueSoftResolve,
    in Optional<in GraphOwnedAdaptiveShadowPlan> graphOwnedAdaptivePlan,
    in Optional<in LightSpaceShadowSnapshot> lightSpace
){
    u32 producedFrameIndex = 0u;
    assert(!splitOpaqueSoftResolve || splitSoftTransparentFold);
    if(!targets.shadowVisibility.valid())
        return MakeUnexpected(Failure());
    assert(targets.bindless.valid());
    assert(deferredLightingResources.valid());
    if(!this.m_rayTracingState.sceneBvh.m_sceneBvhNodeBuffer.valid() || this.m_rayTracingState.sceneBvh.m_sceneBvhInstanceCount == 0u)
        return MakeUnexpected(Failure());
    if(!this.m_rayTracingState.shadow.m_swShadowOpaquePrepassPipeline.valid() || this.m_rayTracingState.shadow.m_swShadowMeshCount == 0u)
        return MakeUnexpected(Failure());

    mut GpuDescriptorHeap heap = this.m_graphics.getDevice().getDescriptorHeap();
    if(
        !heap.isInitialized()
        || !targets.bindless.valid()
        || !IsDescriptorClass(targets.bindless.slotsBufferDescriptor, GpuDescriptorClass::UniformBuffer)
        || !IsDescriptorClass(this.m_rayTracingState.sceneBvh.m_rayTraceMaterialContextSlotsHeapHandle, GpuDescriptorClass::UniformBuffer)
        || !IsDescriptorClass(targets.bindless.shadowVisibilityStorage, GpuDescriptorClass::StorageImage)
        || !IsDescriptorClass(targets.bindless.shadowCoarseTransmittanceStorage, GpuDescriptorClass::StorageImage)
        || !IsDescriptorClass(targets.bindless.shadowSoftHalfAStorage, GpuDescriptorClass::StorageImage)
        || !IsDescriptorClass(targets.bindless.transparentSoftHalfStorage, GpuDescriptorClass::StorageImage)
        || !IsDescriptorClass(this.m_rayTracingState.shadow.m_swShadowEdgeCounterHeapHandle, GpuDescriptorClass::StorageBuffer)
        || !IsDescriptorClass(this.m_rayTracingState.shadow.m_swShadowEdgeListHeapHandle, GpuDescriptorClass::StorageBuffer)
        || !IsDescriptorClass(this.m_rayTracingState.shadow.m_swShadowIndirectArgsHeapHandle, GpuDescriptorClass::StorageBuffer)
    ){
        error("RendererSystem: software-shadow heap resources are incomplete");
        return MakeUnexpected(Failure());
    }

    Optional<GpuTimingMeasure> timing;
    if(!splitSoftTransparentFold)
        timing.emplace(this.m_graphics.gpuTiming(), s_TimingScopeShadowVisibility, this.m_graphics.getDevice(), commandList);

    commandList.setEnableUavBarriersForTexture(targets.shadowVisibility.get(), true);


    const u32 groupSize = cast<u32>(s_ShaderSwShadowGroupSize);
    const ShadowDispatchGrid2D fullGrid = ResolveFullShadowDispatchGrid(targets.width, targets.height, groupSize);
    const u32 fullGroupsX = fullGrid.groupsX;
    const u32 fullGroupsY = fullGrid.groupsY;

    b8 softTransparentRan = false;

    const b8 softWillRun = IsSoftShadowActive(this.m_rayTracingState.softShadow.m_softShadowReady, this.m_rayTracingState.softShadow.m_softShadowSlotMask);
    if(!softWillRun){
        commandList.setTextureState(targets.shadowVisibility.get(), s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess);
        commandList.commitBarriers();
        SwShadowHeapPushConstants opaquePush = MakeSoftwareShadowFramePush(this.m_rayTracingState, targets);
        opaquePush.width = targets.width;
        opaquePush.height = targets.height;
        commandList.setComputeState(MakeComputePassState(this.m_rayTracingState.shadow.m_swShadowOpaquePrepassPipeline));
        heap.bindCompute(commandList, this.m_rayTracingState.shadow.m_swShadowOpaquePrepassPipeline.deref());
        commandList.setPushConstants(opaquePush);
        commandList.dispatch(fullGroupsX, fullGroupsY, 1u);
    }

    commandList.setTextureState(targets.shadowVisibility.get(), s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess);
    commandList.commitBarriers();

    if(softWillRun){
        const ShadowDispatchGrid2D softGrid = ResolveSoftShadowDispatchGrid(targets.width, targets.height, targets.shadowReceiverFactor, groupSize);
        const u32 softGroupsX = softGrid.groupsX;
        const u32 softGroupsY = softGrid.groupsY;

        const u32 frameIndex = this.m_rayTracingState.softShadow.m_softShadowFrameIndex++;
        producedFrameIndex = frameIndex;

        this.enableSoftShadowResolveBarriers(commandList, targets);

        commandList.setTextureState(targets.shadowSoftHalfA.get(), s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess);
        commandList.commitBarriers();
        {
            GpuTimingMeasure opaqueTraceTiming(this.m_graphics.gpuTiming(), s_TimingScopeShadowOpaqueTrace, this.m_graphics.getDevice(), commandList);

            SwShadowHeapPushConstants softTracePush = MakeSoftwareShadowFramePush(this.m_rayTracingState, targets);
            PopulateSwShadowSoftOpaquePush(
                targets.width,
                targets.height,
                frameIndex,
                SelectSoftShadowOpaqueSampleCount(this.softShadowTemporalHistoryUsable(), s_ShaderSwShadowSoftTemporalSpp, s_ShaderSwShadowSoftSpp),
                softTracePush
            );
            if(lightSpace.has_value() && lightSpace.value().ready){
                assert(splitSoftTransparentFold);
                if(!LightSpaceShadowRecorder().resolve(lightSpace.value(), frameIndex, softTracePush.softSampleCount, targets.bindless.shadowSoftHalfAStorage.slot(), false, commandList, heap, this.m_graphics.gpuTiming(), targets.shadowSoftHalfA.deref()))
                    return MakeUnexpected(Failure());
                LightSpaceShadowLogReporter().reportCsgDispatch(
                    (lightSpace.value().push.csgFlags & s_CsgShadowFlagEnabled) != 0u,
                    false,
                    lightSpace.value().push.instanceCount,
                    this.m_lightSpaceShadow.m_csgDispatchLogged
                );
                LightSpaceShadowLogReporter().reportShadowMapDispatch(this.m_lightSpaceShadow.m_dispatchLogged);
            }
            else{
                commandList.setComputeState(MakeComputePassState(this.m_rayTracingState.shadow.m_swShadowSoftOpaquePipeline));
                heap.bindCompute(commandList, this.m_rayTracingState.shadow.m_swShadowSoftOpaquePipeline.deref());
                commandList.setPushConstants(softTracePush);
                commandList.dispatch(softGroupsX, softGroupsY, 1u);
            }
        }

        this.dispatchPrimarySoftShadowResolve(commandList, targets, deferredLightingResources, frameIndex, softGroupsX, softGroupsY, splitOpaqueSoftResolve, splitSoftTransparentFold, graphOwnsOpaqueTemporalMergeEntryStates);
        if(splitSoftTransparentFold){
            this.reportSoftwareShadowTraversal(targets);
            return producedFrameIndex;
        }
        softTransparentRan = this.m_rayTracingState.softShadow.m_softTransparentReady;
    }

    if(!softTransparentRan)
        RecordSoftwareAdaptiveShadow(graphOwnedAdaptivePlan, this.m_rayTracingState, commandList, targets, heap);

    this.reportSoftwareShadowTraversal(targets);
    return producedFrameIndex;
}

Expected<u32> RendererRayTracingSystem::renderShadowVisibilityOpaque(
    mut CommandList commandList,
    mut DeferredFrameTargets targets,
    in DeferredLightingGraphResources deferredLightingResources,
    in b8 graphOwnsOpaqueTemporalMergeEntryStates,
    in Optional<in LightSpaceShadowSnapshot> lightSpace
){
    if(!CanRenderSplitSoftOpaqueShadow(this.m_rayTracingState.softShadow.m_softShadowReady, this.m_rayTracingState.softShadow.m_softTransparentReady, this.m_rayTracingState.softShadow.m_softShadowSlotMask))
        return MakeUnexpected(Failure());
    return this.renderShadowVisibility(commandList, targets, deferredLightingResources, true, graphOwnsOpaqueTemporalMergeEntryStates, true, lightSpace);
}

b8 RendererRayTracingSystem::renderSoftOpaqueShadowResolvePhase(
    mut CommandList commandList,
    mut DeferredFrameTargets targets,
    in DeferredLightingGraphResources deferredLightingResources,
    in u32 frameIndex,
    in b8 hardwareShadowSupported,
    in b8 graphOwnsOpaqueTemporalMergeEntryStates,
    in SoftShadowOpaqueResolvePhase phase
){
    if(!CanRenderSoftOpaqueShadowResolvePhase(this.m_rayTracingState.softShadow.m_softShadowReady, this.m_rayTracingState.softShadow.m_softTransparentReady, this.m_rayTracingState.softShadow.m_softShadowSlotMask,
        this.m_rayTracingState.softShadow.m_softShadowTemporalReady, phase))
        return false;
    const u32 groupSize = SelectShadowTraceGroupSize(hardwareShadowSupported, cast<u32>(s_ShadowRtGroupSize), cast<u32>(s_ShaderSwShadowGroupSize));
    const ShadowDispatchGrid2D softGrid = ResolveSoftShadowDispatchGrid(targets.width, targets.height, targets.shadowReceiverFactor, groupSize);
    this.dispatchSoftShadowDenoiseAndTransparentFold(
        commandList, targets, deferredLightingResources, frameIndex, softGrid.groupsX, softGrid.groupsY,
        false, true, false, false, true, false, false, graphOwnsOpaqueTemporalMergeEntryStates,
        false, false, true, false, false, false, phase
    );
    return true;
}

b8 RendererRayTracingSystem::renderSoftOpaqueShadowResolveTail(mut CommandList commandList, mut DeferredFrameTargets targets, in DeferredLightingGraphResources deferredLightingResources, in u32 frameIndex, in b8 hardwareShadowSupported){
    if(!CanRenderSplitSoftOpaqueShadow(this.m_rayTracingState.softShadow.m_softShadowReady, this.m_rayTracingState.softShadow.m_softTransparentReady, this.m_rayTracingState.softShadow.m_softShadowSlotMask))
        return false;
    const u32 groupSize = SelectShadowTraceGroupSize(hardwareShadowSupported, cast<u32>(s_ShadowRtGroupSize), cast<u32>(s_ShaderSwShadowGroupSize));
    const ShadowDispatchGrid2D softGrid = ResolveSoftShadowDispatchGrid(targets.width, targets.height, targets.shadowReceiverFactor, groupSize);
    this.dispatchSoftShadowDenoiseAndTransparentFold(commandList, targets, deferredLightingResources, frameIndex, softGrid.groupsX, softGrid.groupsY, false, false, false, false, true, false, false, false, false, true, false);
    return true;
}

Expected<u32> RendererRayTracingSystem::renderGpuBvhShadowVisibilityOpaque(
    mut CommandList commandList,
    mut DeferredFrameTargets targets,
    in DeferredLightingGraphResources deferredLightingResources,
    in b8 graphOwnsOpaqueTemporalMergeEntryStates,
    in Optional<in LightSpaceShadowSnapshot> lightSpace
){
    if(!CanRenderSplitSoftOpaqueShadow(this.m_rayTracingState.softShadow.m_softShadowReady, this.m_rayTracingState.softShadow.m_softTransparentReady, this.m_rayTracingState.softShadow.m_softShadowSlotMask))
        return MakeUnexpected(Failure());
    return this.renderGpuBvhShadowVisibility(commandList, targets, deferredLightingResources, true, graphOwnsOpaqueTemporalMergeEntryStates, true, Optional<in GraphOwnedAdaptiveShadowPlan>(), lightSpace);
}

void RendererRayTracingSystem::enableSoftShadowResolveBarriers(mut CommandList commandList, mut DeferredFrameTargets targets){
    commandList.setEnableUavBarriersForTexture(targets.shadowSoftHalfA.get(), true);
    commandList.setEnableUavBarriersForTexture(targets.shadowSoftHalfB.get(), true);
    commandList.setEnableUavBarriersForTexture(targets.shadowSoftGeometry.get(), true);
    if(this.m_rayTracingState.softShadow.m_softShadowTemporalReady){
        commandList.setEnableUavBarriersForTexture(targets.shadowHistA.get(), true);
        commandList.setEnableUavBarriersForTexture(targets.shadowHistB.get(), true);
        commandList.setEnableUavBarriersForTexture(targets.shadowMomentsA.get(), true);
        commandList.setEnableUavBarriersForTexture(targets.shadowMomentsB.get(), true);
    }
}

void RendererRayTracingSystem::dispatchPrimarySoftShadowResolve(
    mut CommandList commandList,
    mut DeferredFrameTargets targets,
    in DeferredLightingGraphResources deferredLightingResources,
    in u32 frameIndex,
    in u32 softGroupsX,
    in u32 softGroupsY,
    in b8 splitOpaqueSoftResolve,
    in b8 splitSoftTransparentFold,
    in b8 graphOwnsOpaqueTemporalMergeEntryStates
){
    if(!splitOpaqueSoftResolve){
        commandList.setTextureState(targets.shadowSoftHalfA.get(), s_ShadowVisibilitySubresources, ResourceStates::UnorderedAccess);
        commandList.commitBarriers();
    }
    this.dispatchSoftShadowDenoiseAndTransparentFold(
        commandList, targets, deferredLightingResources, frameIndex, softGroupsX, softGroupsY,
        true, !splitOpaqueSoftResolve, !splitSoftTransparentFold, !splitSoftTransparentFold,
        false, false, false, graphOwnsOpaqueTemporalMergeEntryStates, false, !splitOpaqueSoftResolve, false
    );
}

u32 RendererRayTracingSystem::transparentShadowSampleCount()const{
    const b8 historyUsable = this.m_rayTracingState.softShadow.m_softTransparentTemporalReady && this.softShadowTemporalHistoryUsable()
        && this.m_rayTracingState.softShadow.m_transparentShadowSamplingHistory.covers(this.m_rayTracingState.softShadow.m_softShadowSlotMask);
    return ResolveTransparentShadowSampleCount(this.m_shadowQualitySettings, historyUsable);
}

void RendererRayTracingSystem::reportTransparentShadowSampling(in u32 sampleCount){
    LogTransparentShadowSamplingIfNeeded(sampleCount, this.hardwareTransparentShadowReady(), this.m_temporalOneShadowSamplingLogged);
}


