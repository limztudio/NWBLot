    EXPECT_EQ(self.m_actions.committed, "42");
    EXPECT_EQ(self.actionCount(UiEditAction::Submit), 1u);
    EXPECT_EQ(self.m_context.input().layoutGeneration(), accepted);
    EXPECT_EQ(self.m_context.input().targets().size(), targets);
}

void VerifyUiEditBoxHostTests_NativeCommitLocalLeftAndNativeCommitRetainTheirEventOrder(mut UiEditBoxHostTests self){
    ASSERT_TRUE(self.activate());
    ASSERT_EQ(self.m_textInput.commit("x"), TextInputAdmission::Accepted);
    ASSERT_TRUE(self.key(Key::Left));
    ASSERT_EQ(self.m_textInput.commit("y"), TextInputAdmission::Accepted);
    self.m_host.collectNative();
    EXPECT_EQ(self.m_model.text(), "");
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.text(), "yx");
    EXPECT_EQ(self.m_model.caret(), 1u);
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_FALSE(self.m_result.textChanged);
    EXPECT_EQ(self.m_model.text(), "yx");
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "x");
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "");
}

void VerifyUiEditBoxHostTests_QueuedCommitCannotReachAReplacementModelAtTheSameWidget(mut UiEditBoxHostTests self){
    ASSERT_TRUE(self.m_model.setText("old"));
    ASSERT_TRUE(self.activate());
    const TextInputSessionToken oldSession = self.m_textInput.activeSession();
    ASSERT_EQ(self.m_textInput.commit("late"), TextInputAdmission::Accepted);
    self.m_host.collectNative();
    UiEditModel replacement = UiEditModel(self.m_arena);
    ASSERT_TRUE(replacement.setText("replacement"));
    ASSERT_TRUE(self.frame(replacement));
    EXPECT_EQ(self.m_model.text(), "old");
    EXPECT_EQ(replacement.text(), "replacement");
    EXPECT_FALSE(replacement.canUndo());
    EXPECT_EQ(self.m_textInput.emitCommit(oldSession, "later"), TextInputAdmission::InvalidSession);
}

void VerifyUiEditBoxHostTests_RemovingThenRedeclaringTheWidgetFencesItsOldNativeQueue(mut UiEditBoxHostTests self){
    ASSERT_TRUE(self.m_model.setText("base"));
    ASSERT_TRUE(self.activate());
    const UiWidgetState oldWidget = self.m_widget;
    const TextInputSessionToken oldSession = self.m_textInput.activeSession();
    ASSERT_EQ(self.m_textInput.commit("late"), TextInputAdmission::Accepted);
    self.m_host.collectNative();
    ASSERT_TRUE(self.emptyFrame());
    EXPECT_FALSE(self.m_host.hasTextFocus());
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_widget.id, oldWidget.id);
    EXPECT_NE(self.m_widget.declarationGeneration, oldWidget.declarationGeneration);
    EXPECT_EQ(self.m_model.text(), "base");
    EXPECT_FALSE(self.m_model.canUndo());
    EXPECT_EQ(self.m_textInput.emitCommit(oldSession, "later"), TextInputAdmission::InvalidSession);
}

void VerifyUiEditBoxHostTests_ExternalSameTextResetFencesAnAlreadyCollectedCommit(mut UiEditBoxHostTests self){
    ASSERT_TRUE(self.m_model.setText("base"));
    ASSERT_TRUE(self.activate());
    const u64 revision = self.m_model.revision();
    const u64 externalRevision = self.m_model.externalRevision();
    const TextInputSessionToken oldSession = self.m_textInput.activeSession();
    ASSERT_EQ(self.m_textInput.commit("late"), TextInputAdmission::Accepted);
    self.m_host.collectNative();
    ASSERT_TRUE(self.m_model.setText("base"));
    EXPECT_EQ(self.m_model.revision(), revision);
    EXPECT_GT(self.m_model.externalRevision(), externalRevision);
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.text(), "base");
    EXPECT_FALSE(self.m_model.canUndo());
    EXPECT_EQ(self.m_textInput.emitCommit(oldSession, "later"), TextInputAdmission::InvalidSession);
}

void VerifyUiEditBoxHostTests_FocusLossAndImmediateRefocusCannotReviveAnOwnedOldCommit(mut UiEditBoxHostTests self){
    ASSERT_TRUE(self.m_model.setText("base"));
    ASSERT_TRUE(self.activate());
    const TextInputSessionToken oldSession = self.m_textInput.activeSession();
    ASSERT_EQ(self.m_textInput.commit("late"), TextInputAdmission::Accepted);
    self.m_host.collectNative();
    self.m_context.input().clearFocus();
    self.m_host.synchronizeFocus();
    ASSERT_TRUE(self.key(Key::Tab));
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.text(), "base");
    EXPECT_FALSE(self.m_model.canUndo());
    EXPECT_NE(self.m_textInput.activeSession(), oldSession);
    ASSERT_EQ(self.m_textInput.commit("fresh"), TextInputAdmission::Accepted);
    self.m_host.collectNative();
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.text(), "basefresh");
}

void VerifyUiEditBoxHostTests_LosingFocusCancelsPreeditAtTheNextModelLoanAndRefocusStartsFresh(mut UiEditBoxHostTests self){
    ASSERT_TRUE(self.m_model.setText("base"));
    ASSERT_TRUE(self.activate());
    const TextInputSessionToken oldSession = self.m_textInput.activeSession();
    ASSERT_EQ(self.m_textInput.preedit("IME", 0u, 3u, false), TextInputAdmission::Accepted);
    self.m_host.collectNative();
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_TRUE(self.m_model.composition().active);
    self.m_context.input().clearFocus();
    self.m_host.synchronizeFocus();
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_FALSE(self.m_model.composition().active);
    EXPECT_EQ(self.m_model.text(), "base");
    EXPECT_FALSE(self.m_model.canUndo());
    EXPECT_FALSE(self.m_host.hasTextFocus());
    ASSERT_TRUE(self.key(Key::Tab));
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_NE(self.m_textInput.activeSession(), oldSession);
    ASSERT_EQ(self.m_textInput.commit("x"), TextInputAdmission::Accepted);
    self.m_host.collectNative();
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.text(), "basex");
}

void VerifyUiEditBoxHostTests_ReadOnlyPolicyChangeDiscardsQueuedMutationAndNativeSession(mut UiEditBoxHostTests self){
    ASSERT_TRUE(self.m_model.setText("base"));
    ASSERT_TRUE(self.activate());
    ASSERT_EQ(self.m_textInput.commit("late"), TextInputAdmission::Accepted);
    self.m_host.collectNative();
    UiEditBoxOptions options = UiEditBoxOptions();
    options.readOnly = true;
    ASSERT_TRUE(self.frame(self.m_model, options));
    EXPECT_EQ(self.m_model.text(), "base");
    EXPECT_FALSE(self.m_model.canUndo());
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    EXPECT_TRUE(self.m_host.character(120u));
    ASSERT_TRUE(self.frame(self.m_model, options));
    EXPECT_EQ(self.m_model.text(), "base");
    options.readOnly = false;
    ASSERT_TRUE(self.frame(self.m_model, options));
    ASSERT_TRUE(self.m_textInput.activeSession().valid());
    ASSERT_EQ(self.m_textInput.commit("fresh"), TextInputAdmission::Accepted);
    self.m_host.collectNative();
    ASSERT_TRUE(self.frame(self.m_model, options));
    EXPECT_EQ(self.m_model.text(), "basefresh");
}

void VerifyUiEditBoxHostTests_TextInputCaptureUsesTheCommittedEditableFrame(mut UiEditBoxHostTests self){
    ASSERT_TRUE(self.activate());
    EXPECT_TRUE(self.m_host.wantsTextInput());

    UiEditBoxOptions readOnly = UiEditBoxOptions();
    readOnly.readOnly = true;
    ASSERT_TRUE(self.prepare(self.m_model, readOnly));
    EXPECT_TRUE(self.m_host.wantsTextInput());
    ASSERT_TRUE(self.commit());
    EXPECT_TRUE(self.m_host.hasTextFocus());
    EXPECT_FALSE(self.m_host.wantsTextInput());
    EXPECT_FALSE(self.m_textInput.activeSession().valid());

    ASSERT_TRUE(self.prepare(self.m_model));
    EXPECT_FALSE(self.m_host.wantsTextInput());
    ASSERT_TRUE(self.commit());
    EXPECT_TRUE(self.m_host.wantsTextInput());

    ASSERT_TRUE(self.dispatchType(UiInputEventType::FocusLost));
    EXPECT_FALSE(self.m_host.wantsTextInput());
    ASSERT_TRUE(self.dispatchType(UiInputEventType::FocusGained));
    EXPECT_FALSE(self.m_host.wantsTextInput());
}

void VerifyUiEditBoxHostTests_TextInputCaptureRetiresWithTheWidgetAndHostReset(mut UiEditBoxHostTests self){
    ASSERT_TRUE(self.activate());
    EXPECT_TRUE(self.m_host.wantsTextInput());
    ASSERT_TRUE(self.emptyFrame());
    EXPECT_FALSE(self.m_host.wantsTextInput());

    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_FALSE(self.m_host.wantsTextInput());
    ASSERT_TRUE(self.key(Key::Tab));
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_TRUE(self.m_host.wantsTextInput());
    self.m_host.reset();
    EXPECT_FALSE(self.m_host.wantsTextInput());
}

void VerifyUiEditBoxHostTests_SurroundingDeletionCannotFollowALocalMoveAgainstOldNativeCaret(mut UiEditBoxHostTests self){
    ASSERT_TRUE(self.m_model.setText("abcd"));
    ASSERT_TRUE(self.activate());
    ASSERT_TRUE(self.key(Key::Left));
    ASSERT_EQ(self.m_textInput.erase(1u, 0u, self.m_textInput.surroundingRevision(self.m_textInput.activeSession()), TextInputDeletionBasis::Caret), TextInputAdmission::Accepted);
    self.m_host.collectNative();
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.text(), "abcd");
    EXPECT_EQ(self.m_model.caret(), 3u);
    EXPECT_FALSE(self.m_model.canUndo());
}

void VerifyUiEditBoxHostTests_CandidateGeometryCannotMoveTheNativeCaretBeforeContextAcceptance(mut UiEditBoxHostTests self){
    ASSERT_TRUE(self.m_model.setText("abc"));
    ASSERT_TRUE(self.activate());
    const TextInputRect displayed = self.m_textInput.caretRect();
    ASSERT_TRUE(self.prepare(self.m_model, UiEditBoxOptions(), MakeEcsUiRect(200.0f, 20.0f, 180.0f, 30.0f)));
    EXPECT_EQ(self.m_context.input().layoutGeneration(), self.m_generation - 1u);
    self.m_host.commitFrame(self.m_generation);
    EXPECT_EQ(self.m_textInput.caretRect().x, displayed.x);
    ASSERT_TRUE(self.dispatchPoint(MakeEcsUiPoint(20.0f, 25.0f), UiInputEventType::PrimaryDown));
    ASSERT_TRUE(self.dispatchPoint(MakeEcsUiPoint(20.0f, 25.0f), UiInputEventType::PrimaryUp));
    ASSERT_TRUE(self.commit());
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.caret(), 1u);
    EXPECT_EQ(self.m_model.anchor(), 1u);
}

void VerifyUiEditBoxHostTests_RepeatedCandidatePublicationAcceptsOnlyTheLastGeometryAndPreservesDisplayedHits(mut UiEditBoxHostTests self){
    ASSERT_TRUE(self.m_model.setText("abc"));
    ASSERT_TRUE(self.activate());
    const TextInputRect displayed = self.m_textInput.caretRect();
    const UiRect bounds = MakeEcsUiRect(200.0f, 20.0f, 180.0f, 30.0f);
    ASSERT_TRUE(self.prepare(self.m_model, UiEditBoxOptions(), bounds));
    UiEditBoxView replacement = UiEditBoxView(self.m_arena);
    ASSERT_TRUE(replacement.snapshot(self.m_model));
    UiShapeRequest layoutRequest = UiShapeRequest();
    layoutRequest.text = replacement.displayText();
    auto layout = self.m_layoutBuilder.layout(layoutRequest);
    ASSERT_TRUE(AdoptExpectedEcsUiLayout(replacement, layout));
    UiInsets pad = UiInsets();
    pad.left = 10.0f;
    const auto placement = replacement.arrange(bounds, pad, MakeEcsUiRect(0.0f, 0.0f, 500.0f, 200.0f), UiPoint());
    ASSERT_TRUE(cast<b8>(placement));
    ASSERT_TRUE(self.m_host.publish(self.m_widget, replacement, placement.value(), UiEditBoxOptions()));
    UiEditBoxView rejected = UiEditBoxView(self.m_arena);
    EXPECT_FALSE(self.m_host.publish(self.m_widget, rejected, placement.value(), UiEditBoxOptions()));
    self.m_host.commitFrame(self.m_generation);
    EXPECT_EQ(self.m_textInput.caretRect().x, displayed.x);
    ASSERT_TRUE(self.dispatchPoint(MakeEcsUiPoint(20.0f, 25.0f), UiInputEventType::PrimaryDown));
    ASSERT_TRUE(self.dispatchPoint(MakeEcsUiPoint(20.0f, 25.0f), UiInputEventType::PrimaryUp));
    ASSERT_TRUE(self.commit());
    EXPECT_EQ(self.m_textInput.caretRect().x, 240);
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.anchor(), 1u);
    EXPECT_EQ(self.m_model.caret(), 1u);
}

void VerifyUiEditBoxHostTests_GeometryPublicationShrinksAndGrowsCaretStopsWithoutRetainingOldEndPositions(mut UiEditBoxHostTests self){
    Array<StringView, 5> values = Array<StringView, 5>();
    values[0u] = "abcdefghi";
    values[1u] = "ab";
    values[2u] = "abcdefghijklmnopqrstuvwxyzabcdef";
    values[3u] = "";
    values[4u] = "abcdefghijklmnopqrstuvwxyzabcdef";
    ASSERT_TRUE(self.activate());
    for(in StringView value : values){
        ASSERT_TRUE(self.m_model.setText(value));
        ASSERT_TRUE(self.prepare(self.m_model, UiEditBoxOptions(), MakeEcsUiRect(10.0f, 20.0f, 600.0f, 30.0f)));
        ASSERT_TRUE(self.commit());
        ASSERT_TRUE(self.dispatchPoint(MakeEcsUiPoint(181.0f, 25.0f), UiInputEventType::PrimaryDown));
        ASSERT_TRUE(self.dispatchPoint(MakeEcsUiPoint(181.0f, 25.0f), UiInputEventType::PrimaryUp));
        ASSERT_TRUE(self.frame(self.m_model));
        const usize expected = Min(value.size(), cast<usize>(17u));
        EXPECT_EQ(self.m_model.anchor(), expected);
        EXPECT_EQ(self.m_model.caret(), expected);
        EXPECT_EQ(self.m_model.text(), value);
    }
}

void VerifyUiEditBoxHostTests_HostEventOverflowDiscardsTheBoundedBatchBeforeAnyModelMutation(mut UiEditBoxHostTests self){
    ASSERT_TRUE(self.m_model.setText("base"));
    ASSERT_TRUE(self.activate());
    usize accepted = 0u;
    for(usize index = 0u; index < s_EditInputMaxEvents + 2u; ++index){
        if(!self.m_textInput.activeSession().valid())
            break;
        ASSERT_EQ(self.m_textInput.commit("x"), TextInputAdmission::Accepted);
        ++accepted;
        self.m_host.collectNative();
    }
    EXPECT_LE(accepted, s_EditInputMaxEvents + 1u);
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    EXPECT_EQ(self.m_model.text(), "base");
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.text(), "base");
    EXPECT_FALSE(self.m_model.canUndo());
}

void VerifyUiEditBoxHostTests_NativeEventOverflowCancelsTheBatchAndCanRecoverOnANewDeclaration(mut UiEditBoxHostTests self){
    ASSERT_TRUE(self.m_model.setText("base"));
    ASSERT_TRUE(self.activate());
    for(usize index = 0u; index < s_TextInputMaxEvents; ++index){
        ASSERT_EQ(self.m_textInput.commit("x"), TextInputAdmission::Accepted);
    }
    EXPECT_EQ(self.m_textInput.commit("overflow"), TextInputAdmission::QueueFull);
    self.m_host.collectNative();
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.text(), "base");
    EXPECT_FALSE(self.m_model.canUndo());
    ASSERT_TRUE(self.m_textInput.activeSession().valid());
    ASSERT_EQ(self.m_textInput.commit("ok"), TextInputAdmission::Accepted);
    self.m_host.collectNative();
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.text(), "baseok");
}

void VerifyUiEditBoxHostTests_NativeCommitPathConsumesCharacterFallbackWithoutDuplicatingIt(mut UiEditBoxHostTests self){
    ASSERT_TRUE(self.activate());
    EXPECT_TRUE(self.m_host.character(120u));
    ASSERT_EQ(self.m_textInput.commit("x"), TextInputAdmission::Accepted);
    self.m_host.collectNative();
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.text(), "x");
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "");
    EXPECT_FALSE(self.m_model.canUndo());
}

void VerifyUiEditBoxHostTests_QueuedNativeEditFencesACompletedPasteBeforeModelMutation(mut UiEditBoxHostTests self){
    ASSERT_TRUE(self.m_model.setText("base"));
    ASSERT_TRUE(self.activate());
    self.m_clipboard.delayed = true;
    ASSERT_TRUE(self.key(Key::V, false, true));
    ASSERT_TRUE(self.frame(self.m_model));
    ASSERT_TRUE(self.m_clipboard.pump());
    const ClipboardRequestToken old = self.m_clipboard.startedToken;
    ASSERT_EQ(self.m_textInput.commit("x"), TextInputAdmission::Accepted);
    self.m_host.collectNative();
    ASSERT_TRUE(self.m_clipboard.deliver(old, ClipboardStatus::Success, "old"));
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.text(), "basex");
    ASSERT_TRUE(self.m_model.undo());
    EXPECT_EQ(self.m_model.text(), "base");
    EXPECT_FALSE(self.m_model.canUndo());
}

void VerifyUiEditBoxHostTests_QueuedLocalSelectionFencesCompletedCutWithoutDeletingOldSelection(mut UiEditBoxHostTests self){
    ASSERT_TRUE(self.m_model.setText("base"));
    ASSERT_TRUE(self.activate());
    ASSERT_TRUE(self.key(Key::A, false, true));
    ASSERT_TRUE(self.frame(self.m_model));
    ASSERT_EQ(self.m_model.selectedText(), "base");
    self.m_clipboard.delayed = true;
    ASSERT_TRUE(self.key(Key::X, false, true));
    ASSERT_TRUE(self.frame(self.m_model));
    ASSERT_TRUE(self.m_clipboard.pump());
    const ClipboardRequestToken old = self.m_clipboard.startedToken;
    ASSERT_TRUE(self.key(Key::Left));
    ASSERT_TRUE(self.m_clipboard.deliver(old, ClipboardStatus::Success));
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.text(), "base");
    EXPECT_EQ(self.m_model.caret(), 0u);
    EXPECT_FALSE(self.m_model.hasSelection());
    EXPECT_FALSE(self.m_model.canUndo());
    EXPECT_EQ(self.m_clipboard.document, "base");
}

void VerifyUiEditBoxHostTests_ClipboardCompletionCannotSurviveFocusLossAndImmediateRefocus(mut UiEditBoxHostTests self){
    ASSERT_TRUE(self.m_model.setText("base"));
    ASSERT_TRUE(self.activate());
    self.m_clipboard.delayed = true;
    ASSERT_TRUE(self.key(Key::V, false, true));
    ASSERT_TRUE(self.frame(self.m_model));
    ASSERT_TRUE(self.m_clipboard.pump());
    const ClipboardRequestToken old = self.m_clipboard.startedToken;
    self.m_context.input().clearFocus();
    self.m_host.synchronizeFocus();
    ASSERT_TRUE(self.key(Key::Tab));
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_FALSE(self.m_clipboard.deliver(old, ClipboardStatus::Success, "old"));
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.text(), "base");
    EXPECT_FALSE(self.m_model.canUndo());
}

void VerifyUiEditBoxHostTests_RemovingReadOnlyCopyOwnerPreservesCopiedNativePublication(mut UiEditBoxHostTests self){
    ASSERT_TRUE(self.m_model.setText("base"));
    ASSERT_TRUE(self.activate());
    UiEditBoxOptions options = UiEditBoxOptions();
    options.readOnly = true;
    ASSERT_TRUE(self.frame(self.m_model, options));
    EXPECT_FALSE(self.m_textInput.activeSession().valid());
    ASSERT_TRUE(self.key(Key::A, false, true));
    ASSERT_TRUE(self.frame(self.m_model, options));
    self.m_clipboard.delayed = true;
    ASSERT_TRUE(self.key(Key::C, false, true));
    ASSERT_TRUE(self.frame(self.m_model, options));
    ASSERT_TRUE(self.m_clipboard.pump());
    const ClipboardRequestToken old = self.m_clipboard.startedToken;
    ASSERT_TRUE(self.emptyFrame());
    EXPECT_TRUE(self.m_clipboard.deliver(old, ClipboardStatus::Success));
    EXPECT_EQ(self.m_clipboard.document, "base");
    EXPECT_EQ(self.m_model.text(), "base");
}

void VerifyUiEditBoxHostTests_ClipboardCompletionCannotReachIdenticalExternallyResetModel(mut UiEditBoxHostTests self){
    ASSERT_TRUE(self.m_model.setText("base"));
    ASSERT_TRUE(self.activate());
    self.m_clipboard.delayed = true;
    ASSERT_TRUE(self.key(Key::V, false, true));
    ASSERT_TRUE(self.frame(self.m_model));
    ASSERT_TRUE(self.m_clipboard.pump());
    const ClipboardRequestToken old = self.m_clipboard.startedToken;
    ASSERT_TRUE(self.m_model.setText("base"));
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_FALSE(self.m_clipboard.deliver(old, ClipboardStatus::Success, "old"));
    EXPECT_EQ(self.m_model.text(), "base");
    EXPECT_FALSE(self.m_model.canUndo());
}

void VerifyUiEditBoxHostTests_QueuedCopyThenPastePreservesAsynchronousNativePublicationOrder(mut UiEditBoxHostTests self){
    ASSERT_TRUE(self.m_model.setText("base"));
    ASSERT_TRUE(self.activate());
    ASSERT_TRUE(self.key(Key::A, false, true));
    ASSERT_TRUE(self.frame(self.m_model));
    self.m_clipboard.document.assign("old");
    self.m_clipboard.delayed = true;
    ASSERT_TRUE(self.key(Key::C, false, true));
    ASSERT_TRUE(self.key(Key::V, false, true));
    ASSERT_TRUE(self.frame(self.m_model));
    ASSERT_TRUE(self.m_clipboard.pump());
    ASSERT_EQ(self.m_clipboard.startedOperation, ClipboardOperation::WriteText);
    EXPECT_EQ(self.m_clipboard.startedText, "base");
    ASSERT_TRUE(self.m_clipboard.deliver(self.m_clipboard.startedToken, ClipboardStatus::Success));
    ASSERT_TRUE(self.m_clipboard.pump());
    ASSERT_EQ(self.m_clipboard.startedOperation, ClipboardOperation::ReadText);
    ASSERT_TRUE(self.m_clipboard.deliver(self.m_clipboard.startedToken, ClipboardStatus::Success, self.m_clipboard.document));
    ASSERT_TRUE(self.frame(self.m_model));
    EXPECT_EQ(self.m_model.text(), "base");
    EXPECT_FALSE(self.m_model.canUndo());
}

void VerifyUiEditClickTracker_ExactTimeAndDistanceBoundsRequireAReleasedFirstPress(){
    const UiTextEditOwner owner = MakeHostEditOwner(11u, 2u, 3u);
    const UiPopupToken popup = MakeHostPopupToken(21u, 1u, 1u, 1u);
    UiEditClickTracker tracker = UiEditClickTracker();
    EXPECT_EQ(tracker.press(owner, popup, 4u, 5u, MakeHostPoint(10.0f, 20.0f), 1000u, false), UiEditClickKind::Caret);
    EXPECT_EQ(tracker.press(owner, popup, 4u, 5u, MakeHostPoint(14.0f, 20.0f), 1500u, false), UiEditClickKind::Caret);
    tracker.release(owner);
    EXPECT_EQ(tracker.press(owner, popup, 4u, 5u, MakeHostPoint(18.0f, 20.0f), 2000u, false), UiEditClickKind::Word);
    tracker.release(owner);
    EXPECT_EQ(tracker.press(owner, popup, 4u, 5u, MakeHostPoint(18.0f, 20.0f), 2001u, false), UiEditClickKind::Caret);
}

void VerifyUiEditClickTracker_ClockReversalAndMovementCannotManufactureASecondClick(){
    const UiTextEditOwner owner = MakeHostEditOwner(11u, 2u, 3u);
    const UiPopupToken noPopup = UiPopupToken();
    const UiPoint origin = MakeHostPoint(0.0f, 0.0f);
    UiEditClickTracker tracker = UiEditClickTracker();
    EXPECT_EQ(tracker.press(owner, noPopup, 1u, 1u, origin, u64.max - 1u, false), UiEditClickKind::Caret);
    tracker.release(owner);
    EXPECT_EQ(tracker.press(owner, noPopup, 1u, 1u, origin, 2u, false), UiEditClickKind::Caret);
    tracker.move(MakeHostPoint(4.1f, 0.0f));
    tracker.release(owner);
    EXPECT_EQ(tracker.press(owner, noPopup, 1u, 1u, origin, 3u, false), UiEditClickKind::Caret);
    tracker.release(owner);
    EXPECT_EQ(tracker.press(owner, noPopup, 1u, 1u, origin, 504u, false), UiEditClickKind::Caret);
}

void VerifyUiEditClickTracker_PopupReopenModelReplacementFocusLossAndShiftFenceTheSequence(){
    const UiTextEditOwner owner = MakeHostEditOwner(11u, 2u, 3u);
    const UiTextEditOwner otherOwner = MakeHostEditOwner(12u, 2u, 3u);
    const UiPopupToken popup = MakeHostPopupToken(21u, 1u, 1u, 1u);
    const UiPopupToken reopenedPopup = MakeHostPopupToken(21u, 1u, 1u, 2u);
    const UiPoint origin = UiPoint();
    UiEditClickTracker tracker = UiEditClickTracker();
    EXPECT_EQ(tracker.press(owner, popup, 1u, 1u, origin, 100u, false), UiEditClickKind::Caret);
    tracker.release(owner);
    EXPECT_EQ(tracker.press(owner, reopenedPopup, 1u, 1u, origin, 120u, false), UiEditClickKind::Caret);
    tracker.release(owner);
    EXPECT_EQ(tracker.press(owner, reopenedPopup, 1u, 2u, origin, 140u, false), UiEditClickKind::Caret);
    tracker.release(owner);
    tracker.retainFocus(otherOwner);
    EXPECT_EQ(tracker.press(owner, reopenedPopup, 1u, 2u, origin, 160u, false), UiEditClickKind::Caret);
    tracker.release(owner);
    EXPECT_EQ(tracker.press(owner, reopenedPopup, 1u, 2u, origin, 180u, true), UiEditClickKind::Caret);
    tracker.release(owner);
    EXPECT_EQ(tracker.press(owner, reopenedPopup, 1u, 2u, origin, 200u, false), UiEditClickKind::Caret);
}

void VerifyUiEditClipboard_InvalidActionAndChannelTakePrecedenceOverModelState(){
    const UiTextEditOwner owner = MakeHostEditOwner(51u, 2u, 3u);
    DelayedClipboardRig rig = DelayedClipboardRig();
    UiEditClipboardController controller = UiEditClipboardController(rig.arena.arena, rig.service);
    UiEditModel model = UiEditModel(rig.arena.arena);
    const ClipboardChannelEnum invalidChannel = cast<ClipboardChannelEnum>(255u);
    EXPECT_EQ(controller.request(owner, model, UiEditClipboardAction::None, invalidChannel, true).status, UiEditClipboardStatus::InvalidAction);
    EXPECT_EQ(controller.request(owner, model, UiEditClipboardAction::Paste, invalidChannel, true).status, UiEditClipboardStatus::Unsupported);
    EXPECT_EQ(controller.request(owner, model, UiEditClipboardAction::Copy, invalidChannel).status, UiEditClipboardStatus::Unsupported);
}

void VerifyUiEditClipboard_CutWaitsForSuccessfulNativePublicationBeforeDeleting(){
    const UiTextEditOwner owner = MakeHostEditOwner(51u, 2u, 3u);
    DelayedClipboardRig rig = DelayedClipboardRig();
    UiEditClipboardController controller = UiEditClipboardController(rig.arena.arena, rig.service);
    UiEditModel model = UiEditModel(rig.arena.arena);
    ASSERT_TRUE(model.setText("abcd"));
    ASSERT_TRUE(model.setSelection(1u, 3u));
    ASSERT_EQ(controller.request(owner, model, UiEditClipboardAction::Cut).status, UiEditClipboardStatus::Pending);
    EXPECT_EQ(model.text(), "abcd");
    ASSERT_TRUE(rig.service.pump());
    ASSERT_TRUE(rig.service.completeNativeRequest(controller.token(), ClipboardStatus::NativeFailure));
    EXPECT_EQ(controller.drain(owner, model).status, UiEditClipboardStatus::NativeFailure);
    EXPECT_EQ(model.selectedText(), "bc");
    EXPECT_FALSE(model.canUndo());
    ASSERT_EQ(controller.request(owner, model, UiEditClipboardAction::Cut).status, UiEditClipboardStatus::Pending);
    ASSERT_TRUE(rig.service.pump());
    ASSERT_TRUE(rig.service.completeNativeRequest(controller.token(), ClipboardStatus::Success));
    EXPECT_TRUE(controller.drain(owner, model).textChanged);
    EXPECT_EQ(model.text(), "ad");
    ASSERT_TRUE(model.undo());
    EXPECT_EQ(model.text(), "abcd");
    EXPECT_EQ(model.selectedText(), "bc");
}

void VerifyUiEditClipboard_CopiedOwnerGenerationsRejectReplacedWidgetDeclarationAndModel(){
    const UiTextEditOwner baseOwner = MakeHostEditOwner(51u, 2u, 3u);
    DelayedClipboardRig rig = DelayedClipboardRig();
    UiEditClipboardController controller = UiEditClipboardController(rig.arena.arena, rig.service);
    UiEditModel model = UiEditModel(rig.arena.arena);
    ASSERT_TRUE(model.setText("base"));
    Array<UiTextEditOwner, 3> replacements = Array<UiTextEditOwner, 3>();
    replacements[0u] = MakeHostEditOwner(52u, 2u, 3u);
    replacements[1u] = MakeHostEditOwner(51u, 4u, 3u);
    replacements[2u] = MakeHostEditOwner(51u, 2u, 5u);
    for(in UiTextEditOwner owner : replacements){
        ASSERT_EQ(controller.request(baseOwner, model, UiEditClipboardAction::Paste).status, UiEditClipboardStatus::Pending);
        ASSERT_TRUE(rig.service.pump());
        const ClipboardRequestToken old = controller.token();
        ASSERT_TRUE(rig.service.completeNativeRequest(old, ClipboardStatus::Success, "old"));
        EXPECT_EQ(controller.drain(owner, model).status, UiEditClipboardStatus::StaleOwner);
        EXPECT_EQ(model.text(), "base");
        EXPECT_FALSE(controller.pending());
        EXPECT_FALSE(rig.service.completeNativeRequest(old, ClipboardStatus::Success, "late"));
    }
}

void VerifyUiEditClipboard_TextRevisionSelectionAndPreeditChangesFencePendingTransfer(){
    const UiTextEditOwner owner = MakeHostEditOwner(51u, 2u, 3u);
    DelayedClipboardRig rig = DelayedClipboardRig();
    UiEditClipboardController controller = UiEditClipboardController(rig.arena.arena, rig.service);
    UiEditModel model = UiEditModel(rig.arena.arena);
    ASSERT_TRUE(model.setText("base"));
    ASSERT_EQ(controller.request(owner, model, UiEditClipboardAction::Paste).status, UiEditClipboardStatus::Pending);
    ASSERT_TRUE(rig.service.pump());
    ASSERT_TRUE(model.setSelection(0u, 0u));
    EXPECT_EQ(controller.drain(owner, model).status, UiEditClipboardStatus::StaleModel);
    EXPECT_EQ(model.text(), "base");
    ASSERT_EQ(controller.request(owner, model, UiEditClipboardAction::Paste).status, UiEditClipboardStatus::Pending);
    ASSERT_TRUE(rig.service.pump());
    ASSERT_TRUE(model.replaceSelection("changed"));
    EXPECT_EQ(controller.drain(owner, model).status, UiEditClipboardStatus::StaleModel);
    ASSERT_EQ(controller.request(owner, model, UiEditClipboardAction::Paste).status, UiEditClipboardStatus::Pending);
    ASSERT_TRUE(rig.service.pump());
    ASSERT_TRUE(model.beginComposition());
    EXPECT_EQ(controller.drain(owner, model).status, UiEditClipboardStatus::StaleModel);
    EXPECT_TRUE(model.composition().active);
    EXPECT_EQ(controller.request(owner, model, UiEditClipboardAction::Paste).status, UiEditClipboardStatus::CompositionActive);
}

void VerifyUiEditClipboard_ExplicitCancellationInvalidatesDeliveryAndNewRequestSupersedesOld(){
    const UiTextEditOwner owner = MakeHostEditOwner(51u, 2u, 3u);
    DelayedClipboardRig rig = DelayedClipboardRig();
    UiEditClipboardController controller = UiEditClipboardController(rig.arena.arena, rig.service);
    UiEditModel model = UiEditModel(rig.arena.arena);
    ASSERT_EQ(controller.request(owner, model, UiEditClipboardAction::Paste).status, UiEditClipboardStatus::Pending);
    ASSERT_TRUE(rig.service.pump());
    const ClipboardRequestToken first = controller.token();
    ASSERT_TRUE(controller.cancel());
    EXPECT_FALSE(rig.service.completeNativeRequest(first, ClipboardStatus::Success, "old"));
    ASSERT_EQ(controller.request(owner, model, UiEditClipboardAction::Paste).status, UiEditClipboardStatus::Pending);
    ASSERT_TRUE(rig.service.pump());
    const ClipboardRequestToken second = controller.token();
    ASSERT_EQ(controller.request(owner, model, UiEditClipboardAction::Paste).status, UiEditClipboardStatus::Pending);
    EXPECT_NE(controller.token(), second);
    EXPECT_FALSE(rig.service.completeNativeRequest(second, ClipboardStatus::Success, "old"));
    ASSERT_TRUE(rig.service.pump());
    ASSERT_TRUE(rig.service.completeNativeRequest(controller.token(), ClipboardStatus::Success, "new"));
    EXPECT_TRUE(controller.drain(owner, model).textChanged);
    EXPECT_EQ(model.text(), "new");
}

void VerifyUiEditClipboard_IdenticalExternalResetInvalidatesCopiedPasteDespiteUnchangedTextRevision(){
    const UiTextEditOwner owner = MakeHostEditOwner(51u, 2u, 3u);
    DelayedClipboardRig rig = DelayedClipboardRig();
    UiEditClipboardController controller = UiEditClipboardController(rig.arena.arena, rig.service);
    UiEditModel model = UiEditModel(rig.arena.arena);
    ASSERT_TRUE(model.setText("base"));
    ASSERT_EQ(controller.request(owner, model, UiEditClipboardAction::Paste).status, UiEditClipboardStatus::Pending);
    ASSERT_TRUE(rig.service.pump());
    const ClipboardRequestToken old = controller.token();
    const u64 revision = model.revision();
    const u64 externalRevision = model.externalRevision();
    ASSERT_TRUE(model.setText("base"));
    EXPECT_EQ(model.revision(), revision);
    EXPECT_GT(model.externalRevision(), externalRevision);
    ASSERT_TRUE(rig.service.completeNativeRequest(old, ClipboardStatus::Success, "old"));
    EXPECT_EQ(controller.drain(owner, model).status, UiEditClipboardStatus::StaleModel);
    EXPECT_EQ(model.text(), "base");
    EXPECT_FALSE(controller.pending());
}

void VerifyUiEditClipboard_TextLimitAndMalformedClipboardPreserveSelectionHistoryAndCommittedText(){
    const UiTextEditOwner owner = MakeHostEditOwner(51u, 2u, 3u);
    DelayedClipboardRig rig = DelayedClipboardRig();
    UiEditClipboardController controller = UiEditClipboardController(rig.arena.arena, rig.service);
    UiEditLimits limits = UiEditLimits();
    limits.maxBytes = 4u;
    UiEditModel model = UiEditModel(rig.arena.arena, limits);
    ASSERT_TRUE(model.setText("abcd"));
    ASSERT_TRUE(model.setSelection(1u, 3u));
    ASSERT_EQ(controller.request(owner, model, UiEditClipboardAction::Paste).status, UiEditClipboardStatus::Pending);
    ASSERT_TRUE(rig.service.pump());
    ASSERT_TRUE(rig.service.completeNativeRequest(controller.token(), ClipboardStatus::Success, "xyz"));
    EXPECT_EQ(controller.drain(owner, model).status, UiEditClipboardStatus::TooLarge);
    EXPECT_EQ(model.selectedText(), "bc");
    EXPECT_FALSE(model.canUndo());
    ASSERT_EQ(controller.request(owner, model, UiEditClipboardAction::Paste).status, UiEditClipboardStatus::Pending);
    ASSERT_TRUE(rig.service.pump());
    ASSERT_TRUE(rig.service.completeNativeRequest(controller.token(), ClipboardStatus::Success, "\xC0\xAF"));
    EXPECT_EQ(controller.drain(owner, model).status, UiEditClipboardStatus::InvalidText);
    EXPECT_EQ(model.text(), "abcd");
    EXPECT_EQ(model.selectedText(), "bc");
    ASSERT_EQ(controller.request(owner, model, UiEditClipboardAction::Paste).status, UiEditClipboardStatus::Pending);
    ASSERT_TRUE(rig.service.pump());
    ASSERT_TRUE(rig.service.completeNativeRequest(controller.token(), ClipboardStatus::Success, ""));
    EXPECT_FALSE(controller.drain(owner, model).textChanged);
    EXPECT_EQ(model.selectedText(), "bc");
}

void VerifyUiEditClipboard_ReadOnlyPreventsCutPasteAndCancelsMutationIfPolicyChangesDuringTransfer(){
    const UiTextEditOwner owner = MakeHostEditOwner(51u, 2u, 3u);
    DelayedClipboardRig rig = DelayedClipboardRig();
    UiEditClipboardController controller = UiEditClipboardController(rig.arena.arena, rig.service);
    UiEditModel model = UiEditModel(rig.arena.arena);
    ASSERT_TRUE(model.setText("abcd"));
    ASSERT_TRUE(model.selectAll());
    EXPECT_EQ(controller.request(owner, model, UiEditClipboardAction::Cut, ClipboardChannel::Clipboard, true).status, UiEditClipboardStatus::ReadOnly);
    EXPECT_EQ(controller.request(owner, model, UiEditClipboardAction::Paste, ClipboardChannel::Clipboard, true).status, UiEditClipboardStatus::ReadOnly);
    ASSERT_EQ(controller.request(owner, model, UiEditClipboardAction::Copy, ClipboardChannel::Clipboard, true).status, UiEditClipboardStatus::Pending);
    ASSERT_TRUE(rig.service.pump());
    ASSERT_TRUE(rig.service.completeNativeRequest(controller.token(), ClipboardStatus::Success));
    EXPECT_EQ(controller.drain(owner, model, true).status, UiEditClipboardStatus::Published);
    ASSERT_EQ(controller.request(owner, model, UiEditClipboardAction::Paste).status, UiEditClipboardStatus::Pending);
    ASSERT_TRUE(rig.service.pump());
    ASSERT_TRUE(rig.service.completeNativeRequest(controller.token(), ClipboardStatus::Success, "new"));
    EXPECT_EQ(controller.drain(owner, model, true).status, UiEditClipboardStatus::ReadOnly);
    EXPECT_EQ(model.text(), "abcd");
    EXPECT_EQ(model.selectedText(), "abcd");
}

void VerifyUiEditClipboard_UnsupportedPrimarySelectionRejectsBeforeTransferAdmission(){
    const UiTextEditOwner owner = MakeHostEditOwner(51u, 2u, 3u);
    DelayedClipboardRig rig = DelayedClipboardRig();
    UiEditClipboardController controller = UiEditClipboardController(rig.arena.arena, rig.service);
    UiEditModel model = UiEditModel(rig.arena.arena);
    EXPECT_EQ(controller.request(owner, model, UiEditClipboardAction::Paste, ClipboardChannel::PrimarySelection).status, UiEditClipboardStatus::Unsupported);
}

void VerifyUiEditClipboard_OwnerThreadViolationCannotPollApplyOrCancelAHostRequest(){
    const UiTextEditOwner owner = MakeHostEditOwner(51u, 2u, 3u);
    DelayedClipboardRig rig = DelayedClipboardRig();
    UiEditClipboardController controller = UiEditClipboardController(rig.arena.arena, rig.service);
    UiEditModel model = UiEditModel(rig.arena.arena);
    ASSERT_EQ(controller.request(owner, model, UiEditClipboardAction::Paste).status, UiEditClipboardStatus::Pending);
    UiEditClipboardStatusEnum requestStatus = UiEditClipboardStatus::Idle;
    UiEditClipboardStatusEnum drainStatus = UiEditClipboardStatus::Idle;
    b8 cancelled = true;
    Thread other = Thread(lambda[mut controller, in owner, mut model, mut requestStatus, mut drainStatus, mut cancelled]() -> void{
        requestStatus = controller.request(owner, model, UiEditClipboardAction::Paste).status;
        drainStatus = controller.drain(owner, model).status;
        cancelled = controller.cancel();
    });
    other.join();
    EXPECT_EQ(requestStatus, UiEditClipboardStatus::WrongThread);
    EXPECT_EQ(drainStatus, UiEditClipboardStatus::WrongThread);
    EXPECT_FALSE(cancelled);
    EXPECT_TRUE(controller.pending());
    EXPECT_TRUE(controller.cancel());
}

