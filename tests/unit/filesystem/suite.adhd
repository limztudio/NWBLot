void VerifyFilesystemVolumeTest_FailedLaterSegmentPromotionRestoresPublishedBytes(mut FilesystemVolumeTest self){
    ScratchArena scratchArena(s_FilesystemNameTestsFilesystem);
    StagedDirectoryPaths stagedPaths(self.m_arena);

    native(mut self, mut scratchArena, mut stagedPaths){
        stagedPaths.stageDirectory = self.m_directory / s_FilesystemStageDirectory;
        stagedPaths.backupDirectory = self.m_directory / s_FilesystemBackupDirectory;
        ASSERT_TRUE(EnsureDirectories(stagedPaths.stageDirectory));
        const DiskPath firstOutput = MakeVolumeSegmentPath(self.m_directory, self.m_desc.volumeName.view(), 0u);
        const DiskPath secondOutput = MakeVolumeSegmentPath(self.m_directory, self.m_desc.volumeName.view(), 1u);
        const DiskPath absentOutput = MakeVolumeSegmentPath(self.m_directory, self.m_desc.volumeName.view(), 2u);
        const DiskPath firstStaged = MakeVolumeSegmentPath(stagedPaths.stageDirectory, self.m_desc.volumeName.view(), 0u);
        const Array<u8, 3u> firstOld{ 1u, 2u, 3u };
        const Array<u8, 4u> secondOld{ 4u, 5u, 6u, 7u };
        const Array<u8, 2u> replacement{ 8u, 9u };
        ASSERT_TRUE(WriteBinaryFile(firstOutput, firstOld));
        ASSERT_TRUE(WriteBinaryFile(secondOutput, secondOld));
        ASSERT_TRUE(WriteBinaryFile(firstStaged, replacement));

        EXPECT_FALSE(PublishStagedVolume(stagedPaths, self.m_directory, self.m_desc.volumeName.view(), 3u, scratchArena));
        EXPECT_TRUE(SawCapturedError(self.m_logger, "failed to promote staged segment"));
        Vector<u8, ScratchArena> loaded(scratchArena);
        ASSERT_TRUE(ReadBinaryFile(firstOutput, loaded));
        ASSERT_EQ(loaded.size(), firstOld.size());
        EXPECT_EQ(NWB_MEMCMP(loaded.data(), firstOld.data(), firstOld.size()), 0);
        ASSERT_TRUE(ReadBinaryFile(secondOutput, loaded));
        ASSERT_EQ(loaded.size(), secondOld.size());
        EXPECT_EQ(NWB_MEMCMP(loaded.data(), secondOld.data(), secondOld.size()), 0);
        const auto absent = FileExists(absentOutput);
        ASSERT_TRUE(absent);
        EXPECT_FALSE(*absent);
        const auto backup = FileExists(stagedPaths.backupDirectory);
        ASSERT_TRUE(backup);
        EXPECT_FALSE(*backup);
    }
}

void VerifyFilesystemVolumeTest_ThrowingPromotionDiagnosticRestoresPublishedBytesDuringUnwind(mut FilesystemVolumeTest self){
    ScratchArena scratchArena(s_FilesystemNameTestsFilesystem);
    StagedDirectoryPaths stagedPaths(self.m_arena);

    native(mut self, mut scratchArena, mut stagedPaths){
        stagedPaths.stageDirectory = self.m_directory / s_FilesystemStageDirectory;
        stagedPaths.backupDirectory = self.m_directory / s_FilesystemBackupDirectory;
        ASSERT_TRUE(EnsureDirectories(stagedPaths.stageDirectory));
        const DiskPath firstOutput = MakeVolumeSegmentPath(self.m_directory, self.m_desc.volumeName.view(), 0u);
        const DiskPath secondOutput = MakeVolumeSegmentPath(self.m_directory, self.m_desc.volumeName.view(), 1u);
        const DiskPath firstStaged = MakeVolumeSegmentPath(stagedPaths.stageDirectory, self.m_desc.volumeName.view(), 0u);
        const Array<u8, 3u> firstOld{ 1u, 2u, 3u };
        const Array<u8, 4u> secondOld{ 4u, 5u, 6u, 7u };
        const Array<u8, 2u> replacement{ 8u, 9u };
        ASSERT_TRUE(WriteBinaryFile(firstOutput, firstOld));
        ASSERT_TRUE(WriteBinaryFile(secondOutput, secondOld));
        ASSERT_TRUE(WriteBinaryFile(firstStaged, replacement));

        {
            ThrowingPublishLogger throwingLogger(self.m_logger.arena());
            LoggerRegistrationGuard throwingLoggerGuard(throwingLogger, LoggerBreakPolicy::ReportOnly);
            EXPECT_THROW({ const b8 published = PublishStagedVolume(stagedPaths, self.m_directory, self.m_desc.volumeName.view(), 3u, scratchArena); EXPECT_FALSE(published); }, i32);
        }
        Vector<u8, ScratchArena> loaded(scratchArena);
        ASSERT_TRUE(ReadBinaryFile(firstOutput, loaded));
        ASSERT_EQ(loaded.size(), firstOld.size());
        EXPECT_EQ(NWB_MEMCMP(loaded.data(), firstOld.data(), firstOld.size()), 0);
        ASSERT_TRUE(ReadBinaryFile(secondOutput, loaded));
        ASSERT_EQ(loaded.size(), secondOld.size());
        EXPECT_EQ(NWB_MEMCMP(loaded.data(), secondOld.data(), secondOld.size()), 0);
    }
}

